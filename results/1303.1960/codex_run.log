\title[An upper bound for nonnegative rank]{An upper bound for nonnegative rank}

%    Information for first author
\author{Yaroslav Shitov}
%    Address of record for the research reported here
\address{National Research University Higher School of Economics, 20 Myasnitskaya Ulitsa, Moscow 101000, Russia}
\email{yaroslav-shitov@yandex.ru}

%    \subjclass is required.
%\subjclass[2000]{15A03, 15A80}
