+
+    attack_names = (
+        "outlier_frobenius_norm",
+        "greedy_target_entry",
+        "random_restart_256",
+        "visible_entry_radix_ansatz",
+    )
+    attack_wins = {name: 0 for name in attack_names}
+    reference_wins = 0
+    reference_times = []
+    reference_operations = 0
+    for seed in range(8):
+        inst = cache.get((SHIPPING_DIFFICULTY, seed))
+        if inst is None:
