+        "demo_candidate_count": search_space(cache[("demo", 0)]),
+        "baseline_wall_clock_seconds": timings[len(timings) // 2],
+        "baseline_scalar_operations": operation_count,
+    }
+
+    attack_names = (
+        "outlier_frobenius_norm",
+        "greedy_target_entry",
+        "random_restart_256",
