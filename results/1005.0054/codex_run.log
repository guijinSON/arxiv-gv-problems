+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "Pair the sum of the first ten row covectors with the difference of the "
+    "first two coordinate vectors; this bilinear form is the shared invariant."
+)
+PLACEBO_HINT: str = (
