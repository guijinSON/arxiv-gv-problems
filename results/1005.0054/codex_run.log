+# Filled only from transcripts produced by scripts/harden.py.  The defaults make
+# selftest usable before the external oracle run; they are replaced after it.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 3},
+        "hinted": {"solved": 0, "attempts": 3},
