+    compact, compact_operations = _compact_solve(shipping)
+    compact_ok = compact is not None and verify(shipping, compact)[0]
+    answer_blob = json.dumps(shipping["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
