+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space > 1_000_000:
+        return None
+    count = 0
+    for candidate in itertools.permutations(range(1, inst["k"] + 1), inst["n"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
