+        "k": 2 * base_params["k"],
+        "r": max(base_params["r"] + 4, 2 * base_params["n"] + 1),
+        "radix_bits": base_params["radix_bits"] + 4,
+        "shear_steps": base_params["shear_steps"] + 24,
