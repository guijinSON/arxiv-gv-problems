+        "drop_one": planted[:-1],
+        "swap_order": [planted[1], planted[0], *planted[2:]],
+        "duplicate": [planted[0], planted[0], *planted[2:]],
+        "empty": [],
+        "out_of_range": [shipping["k"] + 1, *planted[1:]],
