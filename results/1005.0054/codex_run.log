+def _decode_code(code: int, base: int, length: int) -> list[int] | None:
+    if code < 0:
+        return None
+    digits = []
+    for _ in range(length):
+        code, digit = divmod(code, base)
+        digits.append(digit)
+    if code:
+        return None
+    return digits
