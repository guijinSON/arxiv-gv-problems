+                stopped[owners[0]].add(u)
+                stats["atom_components"] += 1
+                continue
+
+            stats["labelled_atoms"] += 1
+            W = sorted(v for v in next_terminals if v[:-1] == u)
+            per_tree = endpoints[u]
