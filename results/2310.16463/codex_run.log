+    # for alternative valid packings, including Algorithm 1's less-pruned choices.
+    edge_budget = min(
+        (alphabet ** (n + 1) - alphabet) // 2,
+        max(planted_edges, 12 * 2**n),
+    )
+    c = alphabet - (terminal_count + 1) // 2
+    return {
+        "family": "internally disjoint Steiner trees in a Sierpinski graph",
+        "depth": n,
+        "alphabet": alphabet,
+        "order": order,
+        "edge_count": (alphabet ** (n + 1) - alphabet) // 2,
+        "terminals": terminal_ids,
+        "tree_count": c,
+        "edge_budget": edge_budget,
+        "planted_edges": planted_edges,
+        "construction_operations": stats["compact_operations"],
+        "answer": answer,
+    }
+
+
+def render(inst):
+    depth = inst["depth"]
+    alphabet = inst["alphabet"]
+    width = len(str(inst["order"] - 1))
+    terminal_line = ", ".join(str(x) for x in inst["terminals"])
+    statement = f"""Construct internally disjoint Steiner trees in a Sierpinski graph.
+
+The graph S({depth},{alphabet}) has as vertices all length-{depth} words over the
+digits 0,...,{alphabet - 1}.  Vertex ID x is the base-{alphabet} value of its word,
+including leading zeroes; thus IDs are the decimal integers 0,...,{inst['order'] - 1}.
+For example, write every ID with {depth} base-{alphabet} digits when testing edges.
+
+Two distinct words u=(u_0,...,u_{depth - 1}) and v=(v_0,...,v_{depth - 1})
+are adjacent exactly when, at their first differing coordinate d, they have the
+same prefix before d and every later coordinate is swapped: u_j=v_d and
+v_j=u_d for every j>d.  The graph is undirected and has no loops.
+
+Terminals (decimal vertex IDs): {terminal_line}
+
+An S-Steiner tree is a nonempty edge set that is a connected acyclic subgraph
+containing every terminal; it may contain other vertices.  Two such trees are
+internally disjoint when they share no edge and their common vertices are
+exactly the terminals.  Find exactly {inst['tree_count']} ordered internally
+disjoint S-Steiner trees using at most {inst['edge_budget']} edges in total.
+
+Return JSON as a list of {inst['tree_count']} nonempty tree lists.  Each tree is
+a list of undirected edges [u,v] in increasing endpoint order (u<v); sort the
+edges lexicographically.  No edge may repeat within or between trees.  All IDs
+are decimal, all bounds above are inclusive, tree order matters only as output
+syntax, and no terminal or edge may be omitted.
+
+Give your final answer inside <answer></answer> tags, as the exact nested JSON list.
+Example: <answer>{json.dumps([[[0, 1], [1, 2]]] * inst['tree_count'], separators=(',', ':'))}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Extract the last tagged nested JSON edge list; never raise on garbage."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\s*>(.*?)</answer\s*>", text, re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body)
