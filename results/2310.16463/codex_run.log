+    rng = random.Random(seed ^ 0x231016463)
+    random_restarts = [random_candidate(inst, rng) for _ in range(256)]
+    flat = []
+    # The obvious but wrong ansatz that treats decimal-near edges as if the
+    # graph were a flat product of cliques.
+    for offset in range(c):
+        edges = []
+        for terminal in inst["terminals"]:
+            neighbor = (terminal - terminal % alphabet + (terminal + offset + 1) % alphabet)
+            if neighbor != terminal:
+                edges.append(sorted([terminal, neighbor]))
+        flat.append(sorted(edges))
+    # A one-atom ansatz uses only the final K_l clique of the terminal's atom.
+    one_atom = [[] for _ in range(c)]
+    for ti in range(c):
+        for terminal in inst["terminals"]:
+            base = terminal - terminal % alphabet
+            neighbor = base + ((terminal + ti + 1) % alphabet)
+            if neighbor != terminal:
+                one_atom[ti].append(sorted([terminal, neighbor]))
+        one_atom[ti] = sorted({tuple(edge) for edge in one_atom[ti]})
+        one_atom[ti] = [list(edge) for edge in one_atom[ti]]
+    return {
+        "outlier_canonical_edge_extremes": [outlier],
+        "greedy_lexicographic_edges": [greedy],
+        "random_restart_256_bounded_witnesses": random_restarts,
+        "by_hand_flat_clique_ansatz": [flat],
+        "single_last_coordinate_atom": [one_atom],
+    }
