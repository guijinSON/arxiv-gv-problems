   817	\subsection{A transitional theorem and its proof}
   818	
   819	
   820	In order to prove our main result (Theorem \ref{main}), we first prove the following transitional theorem by constructing $\ell-\left\lceil k/ 2 \right\rceil$ internally disjoint $U$-Steiner trees in $G$.
   821	
   822	\begin{theorem}\label{Theorem_lower_bond}
   823	Let $G=S(n,\ell)$ and $U\subseteq V(G)$ with $|U|=k$ ($U$ is defined before), and let $c=\ell-\left\lceil k/ 2 \right\rceil$.
   824	For $0\leq s\leq n$, $G_s$ has $c$ internally disjoint $U^s$-Steiner trees $T_1,\cdots,T_c$ such that the following statement holds.
   825	 \begin{enumerate}
   826	   \item [($\star$)]
   827	   For each $u\in U^s$ (say $u\in W^v$ and hence $v$ is a labelled vertex of $G_{s+1}$ if $s\neq n$) and $i\in [c]$, $d_{T_i}(u)\leq 2$.
   828	 \end{enumerate}
   829	\end{theorem}
   830	
   831	The rest part of this subsection is the proof of Theorem \ref{Theorem_lower_bond}.
   832	
   833	\noindent{\bf Proof of Theorem \ref{Theorem_lower_bond}} 
   834	Suppose that $s'$ is the minimum integer such that $G_{s'}$ has
   835	exactly one labelled vertex (note that $s'$ exists since $G_n$ consists of a single labelled vertex).
   836	This means that $G_{s'-1}$ has
   837	at least two labelled vertices. Let $v$ be the labelled vertex in $G_{s'}$.
   838	Then $U\subseteq A_{s',v}$. Thus, in order to find $c$ internally disjoint $U$-Steiner
   839	trees of $G$ satisfying ($\star$), we only need to find $c$ internally disjoint $U$-Steiner trees in
   840	$A_{s',v}$ satisfying ($\star$). Hence, without loss of generality,
   841	we can assume that
   842	$G$ is a graph
   843	with
   844	\begin{equation}\label{eq-root}
   845	|W^{v_{root}}|=|U^{n-1}|\geq 2.
   846	\end{equation}
   847	Therefore, $|U^i|\geq 2$ for each $i\leq n-1$.
