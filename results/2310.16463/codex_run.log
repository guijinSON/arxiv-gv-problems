+def _materialize_answer(inst, answer):
+    trees = []
+    for ports, parts in answer:
+        components = [x for port in ports for x in port] + list(parts)
+        edges = set()
+        for component in components:
+            a, b = map(int, component.split(","))
+            if a >= 0:
+                edges.add((a, b))
