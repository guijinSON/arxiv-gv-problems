+        yield from _atom_edge_iter(prefix + (digit,), remaining - 1, alphabet)
+    for digit in range(1, alphabet):
+        yield _edge(
+            prefix + (0,) + (digit,) * (remaining - 1),
+            prefix + (digit,) + (0,) * (remaining - 1),
+        )
