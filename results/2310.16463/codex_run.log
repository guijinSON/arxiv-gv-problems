   477	 $W^u$ & The set of labelled vertices in $H^u$.\\
   478	 \hline
   479	\end{tabular}
   480	\caption{Notations for and their meanings.}\label{table-1}
   481	\end{table}
   482	
   483	Note that $G_{s-1}$ is the graph obtained from $G_s$ by replacing each vertex $u$ with a complete graph $K_\ell$.
   484	We denote by $H^u$ the complete graph replacing $u$ (see Figures \ref{$G=G_1$} and  \ref{$G=G_2$} for illustrations).
   485	For an edge $e=uv$ of $G_s$, $e$ is also an edge of $G_{s-1}$. We use $u_e$ and $v_e$ to denote the ends of $e$ in $G_{s-1}$, respectively, such that $u_e\in V(H^u)$ and $v_e\in V(H^v)$. (See Figure \ref{Constractuv} for an illustration.)
   486	
   487	Fix a subset $U$ of $V(G)$ arbitrary such that $|U|=k$, where $3\leq k\leq\ell$. For the graph $G_s$, a vertex $u$ of $G_s$ is {\em labelled} if
   488	$V(A_{s,u})\cap U\neq \emptyset$, and $u$ is {\em unlabelled}
   489	otherwise. We use $U^s$ to denote the set of labelled vertices of
   490	$G_s$. For a labelled vertex $u$ of $G_s$, let $W^u=V(H^u)\cap
   491	U^{s-1}$, that is, the set of labelled vertices in $H^u$.
   492	See Figure \ref{$G=G_0$} as an example, if $U=\{u_{000},u_{001},u_{013},u_{122}\}$, then  $U^1=\{u_{00},u_{01},u_{12}\}$ and $W^{u_0}=\{u_{00},u_{01}\}$ in Figure \ref{$G=G_1$}.
   493	For ease of reading, above notations and their meanings are summarized in Table \ref{table-1}.
   494	
   495	
   496	We construct an out-branching $\overrightarrow{T}$ with vertex set $V(\overrightarrow{T})=\bigcup_{i\in \{0,1,\ldots,n\}}\{x:\ x\in V(G_i)\}$ and arc set $A(\overrightarrow{T})=\{(x,y):\ y\in V(H^x)\}$.
   497	The root of $\overrightarrow{T}$ is denoted by $v_{root}$ (it is clear that $V(G_n)=\{v_{root}\}$).
   498	For two different vertices $x,y$ of $V(\overrightarrow{T})$, if there is a direct path from $x$ to $y$, then we say that $x\prec y$, and denote the directed path by $x \overrightarrow{T} y$.
   499	The following result is straightforward.
   500	\begin{fact}\label{fact-lian}
   501	If $x_i\in V(\overrightarrow{T})$ for $i\in[p]$ and $x_1\prec x_2\prec\ldots \prec x_p$, then $\sum_{i\in[p]}|W^{x_i}|\leq k+p-1$.
   502	\end{fact}
