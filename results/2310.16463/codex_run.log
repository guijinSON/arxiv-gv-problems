+        "shipping_vertices": inst["order"],
+        "doubled_depth": doubled["depth"],
+        "doubled_vertices": doubled["order"],
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_why,
