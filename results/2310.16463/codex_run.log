+            attack_seconds[name] += time.perf_counter() - start
+            successes[name] += int(won)
+        words = [_digits(x, trial["depth"], trial["alphabet"]) for x in trial["terminals"]]
+        start = time.perf_counter()
+        full_trees, full_stats = _construct_words(words, trial["alphabet"], full_unlabelled=True)
+        reference_seconds += time.perf_counter() - start
