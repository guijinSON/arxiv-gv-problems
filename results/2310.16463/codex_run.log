+                owners = [i for i, tree in enumerate(trees) if u in _vertices(tree)]
+                if len(owners) != 1:
+                    raise AssertionError("an unlabelled atom must belong to one tree")
+                answer[owners[0]].append([-q, _number(u, alphabet)])
+                stopped[owners[0]].add(u)
