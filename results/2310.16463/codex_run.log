+        running += alphabet ** q
+    edge_exclusions = tuple(sorted(excluded_edges))
+    macro_exclusions = tuple(sorted(excluded_macros))
+    edge_rest = edge_count - len(edge_exclusions)
+    macro_rest = macro_count - len(macro_exclusions)
+    return {
+        "incident": incident,
