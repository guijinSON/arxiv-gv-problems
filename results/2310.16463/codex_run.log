+            R = [u + (digit,) for digit in range(alphabet)
+                 if u + (digit,) not in set(W) | union_endpoints]
+            eligible = []
+            for ti, ep in enumerate(per_tree):
+                inside = ep & set(W)
+                outside = ep - set(W)
+                if len(ep) == 1 and len(inside) == 1:
+                    if len(W) != 1:
