+                    if u in coarse_edge:
+                        fine = _lift_edge(coarse_edge)
+                        ep.add(fine[0] if fine[0][:-1] == u else fine[1])
+                per_tree.append(ep)
+            endpoints[u] = per_tree
+
+        for u in sorted(current_vertices):
