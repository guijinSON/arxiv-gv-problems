+                if len(ep) == 1 and len(inside) == 1:
+                    if len(W) != 1:
+                        eligible.append((ti, "type1", tuple(sorted(ep))))
+                elif len(ep) == 1 and len(outside) == 1:
+                    center = next(iter(outside))
