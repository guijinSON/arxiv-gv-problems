+def _port_count_vectors_cached(degrees, rest_universe, budget, c):
+    choices = [range(c, degree + 1) for degree in degrees]
+    weighted = []
+    for counts in itertools.product(*choices):
+        selected = sum(counts)
+        if selected > budget:
+            continue
+        port_ways = 1
+        for degree, count in zip(degrees, counts):
