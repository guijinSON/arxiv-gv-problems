+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "Contract equal-prefix atoms, route through their complete-graph portal "
+        "cliques, and prune every nonterminal branch before expanding it; without "
+        "that hierarchy one mechanically visits the exponentially large graph."
+    ),
+    "hardness_basis": (
+        "Track B: Section 2, Theorem 2.1 and Algorithm 1 construct the packing "
+        "level by level in O(c*l^(depth+1)) elementary loop/edge operations; at "
+        "the shipping preset the measured figures are reported by selftest, while "
+        "prefix-atom contraction plus early pruning uses under 300 exact local "
+        "edge operations."
+    ),
+    "max_answer_tokens": 256,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
