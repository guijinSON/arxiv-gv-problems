+def _edge_ordinal(edge, depth, alphabet):
+    a, b = (_digits(edge[0], depth, alphabet),
+            _digits(edge[1], depth, alphabet))
+    d = next(i for i, (x, y) in enumerate(zip(a, b)) if x != y)
