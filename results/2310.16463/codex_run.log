+        trees = next_trees
+
+    for tree in answer:
+        tree.sort()
+    stats["compact_operations"] = (
+        stats["labelled_atoms"] + stats["local_edges"]
+        + stats["bridge_components"] + stats["atom_components"]
+    )
+    stats["components"] = sum(len(tree) for tree in answer)
+    return answer, stats
+
