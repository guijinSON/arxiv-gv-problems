+                prefix = _digits(b, q, inst["alphabet"])
+                for u, v in _atom_edge_iter(
+                        prefix, inst["depth"] - q, inst["alphabet"]):
+                    edges.add((_number(u, inst["alphabet"]),
+                               _number(v, inst["alphabet"])))
+        trees.append(edges)
+    return trees
