                       "[num, den] and monomials as exponent lists -- see STEP 1")
    for body in [_json_body] + ([", ".join(map(str, ans))]
                 if isinstance(ans, list) and all(isinstance(x,(int,float,str)) for x in ans) else []):
        try:
