+    # Per-vertex outlier statistic: terminals nearest the numerically smallest
+    # extreme determine a fixed hub order.
+    outlier_hubs = extremes[:c]
+    reverse_hubs = list(reversed(extremes))[:c]
+    greedy = _greedy_pack(inst, list(inst["terminals"]))
+    reverse_greedy = _greedy_pack(inst, list(reversed(inst["terminals"])))
