  1138	def canonical_key(inst):
  1139	    """Exact terminal-orbit key under coordinatewise alphabet relabelling."""
  1140	    depth, alphabet = inst["depth"], inst["alphabet"]
  1141	    words = [_digits(x, depth, alphabet) for x in inst["terminals"]]
