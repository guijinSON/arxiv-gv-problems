+             "bridge_components": 0, "atom_components": 0}
+
+    for q in range(1, depth + 1):
+        if q == depth:
+            for ti, tree in enumerate(trees):
+                for a, b in sorted(tree):
+                    answer[ti].append(
+                        [_number(a, alphabet), _number(b, alphabet)])
