+    offset = pairs * sum(alphabet ** q for q in range(d))
+    prefix_index = _number(a[:d], alphabet)
+    x, y = sorted((a[d], b[d]))
+    pair_rank = sum(alphabet - 1 - z for z in range(x)) + (y - x - 1)
+    return offset + prefix_index * pairs + pair_rank
