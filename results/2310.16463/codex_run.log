+        "complexity": "O(c * alphabet^(depth+1)) elementary loop/edge operations",
+        "wall_clock_sec": round(reference_seconds / 8, 6),
+        "operations": reference_operations,
+        "edge_operations": reference_edge_operations // 8,
+        "paper_loop_iterations": reference_loop_operations // 8,
+        "solves": f"{reference_successes}/8, as expected",
+        "secondary_full_graph_greedy": {
