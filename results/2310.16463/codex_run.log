+            raise AssertionError("constructed tree omitted a terminal port")
+        ports = [[f"{a},{b}" for a, b in port] for port in ports]
+        parts = [f"{a},{b}" for a, b in parts]
+        for port in ports:
+            port.sort()
+        parts.sort()
+        packed.append([ports, parts])
+    return packed
