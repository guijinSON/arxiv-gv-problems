+    for d in range(depth - 1):
+        suffix = word[d + 1 :]
+        if suffix and len(set(suffix)) == 1:
+            other = suffix[0]
+            if other != word[d]:
+                mate = word[:d] + (other,) + (word[d],) * (depth - d - 1)
+                found.add(_number(mate, alphabet))
