+            for vertex in range(inst["alphabet"] ** (inst["depth"] - s)):
+                checksum = (checksum * 1_000_003 + vertex + 17 * tree_index + s) & 0xFFFFFFFF
+                operations += 1
+    return operations, checksum
 
 
