+            invariant_checks += 1
+            if canonical_key(transformed) != original_key:
+                invariant_failures.append({"seed": seed, "transform": label})
+            if label in ("random", "random_plus_sign", "permutation_plus_scale"):
+                carried_witness_checks += 1
