+        "rejected": true
+      },
+      "duplicate": {
+        "reason": "duplicate_position",
+        "rejected": true
+      },
+      "empty": {
+        "reason": "empty_answer",
+        "rejected": true
+      },
+      "membership_swap": {
+        "reason": "equation_nonzero",
+        "rejected": true
+      },
+      "out_of_range": {
