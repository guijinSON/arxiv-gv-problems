def inst(n,k,seed,q=.72):
 r=random.Random(seed)
 while True:
  perm=list(range(n));r.shuffle(perm)
  lens=[n//k+(i<n%k) for i in range(k)]
  paths=[]; z=0
  for L in lens: paths.append(perm[z:z+L]);z+=L
  S={p[0] for p in paths};T={p[-1] for p in paths}
  A=[set() for _ in range(n)]
  for u in range(n):
   for v in range(n):
    if u"'!=v and r.random()<q:A[u].add(v)
  for p in paths:
   for u,v in zip(p,p[1:]):A[u].add(v)
  indeg=[0]*n
  for u in range(n):
   for v in A[u]: indeg[v]+=1
  th=math.ceil((n+k)/2)
  if min(map(len,A))>=th and min(indeg)>=th:return A,S,T,paths

def solve(A,S,T,limit=2_000_000):
 n=len(A); s0=min(S); nodes=0
 # Hamilton cycle in graph with T->S links, sources receive only from T, sinks emit only to S.
 out=[]
 for u in range(n):
  if u in T: out.append(set(S))
  else: out.append({v for v in A[u] if v not in S})
 seen={s0}; path=[s0]
 def rec(u):
  nonlocal nodes
  nodes+=1
  if nodes>limit:return None
  if len(path)==n:
   return list(path) if s0 in out[u] else None
  cand=[v for v in out[u] if v not in seen]
  # endpoints can only be used if followed by an unused source; delay dead sinks.
  def score(v):
   avail=sum(w not in seen for w in out[v])
   return (avail, v in T, v)
  cand.sort(key=score)
  for v in cand:
   # forward checks: every unused vertex must retain a possible predecessor/successor in remainder.
   seen.add(v);path.append(v)
   ans=rec(v)
   if ans:return ans
   path.pop();seen.remove(v)
  return None
 t=time.perf_counter();cyc=rec(s0);dt=time.perf_counter()-t
 return cyc,nodes,dt

for n,k in [(64,4),(128,8),(256,8)]:
 vals=[]
 for seed in range(8):
  A,S,T,P=inst(n,k,seed)
