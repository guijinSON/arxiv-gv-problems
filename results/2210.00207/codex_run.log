    45	\date{}
    46	\begin{document}
    47	\begin{sloppypar}
    48		\maketitle
    49		\begin{abstract}
    50	For a digraph $D$, let $\delta^{0}(D) = \min \{\delta^{+}(D), \delta^{-}(D)\}$ be the minimum semi-degree of $D$. A set of $k$ vertex-disjoint paths, $\{P_{1}, \dots, P_{k}\}$, joining a disjoint source set $S = \{s_{1}, \dots, s_{k}\}$ and sink set $T = \{t_{1}, \dots, t_{k}\}$ is called an unpaired many-to-many $k$-disjoint directed path cover ($k$-DDPC for short) of $D$, if each $P_{j}$ joins $s_{j}$ and $t_{\sigma(j)}$ for some permutation $\sigma$ on $\{1, \dots , k\}$ and $\bigcup^{k}_{j=1} V(P_{j}) = V(D)$.
    51	
    52	In this paper, we give a new proof for the following result that every digraph $D$ with $\delta^{0}(D) \geq \lceil (n+k) / 2 \rceil$ has an unpaired many-to-many $k$-DDPC joining any disjoint source set $S$ and sink set $T$, where $S = \{s_{1}, \dots, s_{k}\}$ and $T = \{t_{1}, \dots, t_{k}\}$. Moreover, we show that the bound on the minimum semi-degree is best possible when $n \geq 3k$.
    53	\vspace{0.2cm}\\		 
    54	\textbf{Keywords:} Disjoint path cover; minimum semi-degree 
    55	\vspace{0.2cm}\\
    56	\textbf{AMS subject classification (2020):} 05C07, 05C20, 05C35, 05C38, 05C70
    57	    \end{abstract}
    58	
    59	\section{Introduction}
    60	For terminology and notation not defined here, we refer to \cite{Bang-Jensen09}. Note that all digraphs considered in this paper have no parallel arcs or loops, and a path always means a directed path.
    61	Let $D = (V, A)$ be a digraph. An {\it $x$-$y$ path} is a directed path which is from $x$ to $y$ for two vertices $x, y \in V(D)$, it can be expressed as $(v_{1}, v_{2}, \dots, v_{m})$, where $v_{1}=x$, $v_{m}=y$ and $v_{j}$ is an out-neighbour of $v_{j-1}$ for every $j \in \{2, \dots, m\}$.  For two vertices $x$ and $y$ on a path $P$ satisfying $x$ precedes $y$, let $xPy$ denote the subpath of $P$ from $x$ to $y$. A {\it Hamiltonian path} is a path containing all vertices of $D$. A digraph $D$ is said to be {\it Hamiltonian-connected} if $D$ has an $x$-$y$ Hamiltonian path for every choice of distinct vertices $x$, $y \in V(D)$. The following is the definition of an unpaired many-to-many $k$-DDPC.
    62	
    63	\begin{definition} [{\bf Unpaired many-to-many $k$-DDPC}] \label{Def:mtm} 
    64	Let $S$=$\{s_{1}, \dots, s_{k}\}$ and $T$=$\{t_{1}, \dots, t_{k}\}$ be any two disjoint subsets of $V(D)$.  
    65	A set of $k$ disjoint paths $\{P_{1}, \dots, P_{k}\}$ of $D$ is an {\it unpaired many-to-many $k$-disjoint directed path cover} ({\em unpaired many-to-many $k$-DDPC} for short) of $D$, 
    66	if $\bigcup^{k}_{i=1}V(P_{i}) = V(D)$, and each $P_{i}$ joins $s_{i}$ and $t_{\sigma(i)}$ for some permutation $\sigma$ on $\{1, \dots , k\}$.
    67	\end{definition}
    68	
    69	Bermond \cite{Ber1970} got the following minimum semi-degree sufficient condition for the existence of an unpaired many-to-many $k$-DDPC for any disjoint source set $S$ and sink set $T$ in a digraph $D$.
    70	
    71	\begin{theorem} \label{The:main}
    72		Let $D$ be a digraph of order $n \geq 2k$, where $k$ is a positive integer. If $\delta^{0}(D) \geq \lceil (n + k)/2 \rceil$, then $D$ has an unpaired many-to-many $k$-DDPC for any disjoint source set $S$ and sink set $T$, where $S = \{s_{1}, \dots, s_{k}\}$, $T = \{t_{1}, \dots, t_{k}\}$.
    73	\end{theorem}
    74	
    75	In this paper, we give a new proof for Theorem~\ref{The:main} in Section~\ref{sec:Proof} Moreover, we show that the bound ``$\lceil (n + k)/2 \rceil$" for minimum semi-degree is best possible when $n \geq 3k$ by proving the following proposition.
    76	
    77	\begin{proposition}
    78	For every $k\geq 1$ and every $n \geq 3k$, there exists a digraph $D$ on $n$ vertices with minimum semi-degree $\lceil (n+k) / 2 \rceil - 1$ which does not have an unpaired many-to-many $k$-DDPC for some pair of disjoint subsets of $V(D)$. 
    79	\end{proposition}
    80	
    81	\begin{proof}
    82	The proof is divided into the following two cases according to whether $n+k$ is even. 
    83	\begin{cas}
    84	$n+k$ is even.
    85	\end{cas}
    86	Let $D$ be a digraph of order $n \geq 3k$ with $V(D)=A\cup B$ such that $D_1=D[A]$ and $D_2=D[B]$ are two complete subdigraphs of $D$ satisfying that $A$ and $B$ have orders $(n+k) / 2$ and have precisely $k$ vertices in common. Observe that $\delta^{0}(D) =\lceil (n+k) / 2 \rceil - 1$ and can be attained by vertices in $(A\setminus B) \cup (B\setminus A)$. Let $S=\{s_{1}, \dots, s_{k}\} \subseteq A \setminus B$ and $T=A \cap B=\{t_{i} \colon 1 \leq i \leq k\}$. 
    87	It can be checked that for any permutation $\sigma$ on $\{1, \dots, k\}$, any set of disjoint paths $\{P_i \colon 1 \leq i \leq k\}$ satisfying that $P_i$ starts from $s_i$ and ends at $t_{\sigma(i)}$ does not cover vertices of $B\setminus A$. Hence, $D$ does not have an unpaired many-to-many $k$-DDPC for $S$ and $T$. 
    88	\begin{cas}
    89		$n+k$ is odd.
    90		\end{cas}
    91	Let $D_{1}$ be a complete digraph of order $(n+k-1)/2$ and $D_{2}$ be an empty digraph of order $(n-k+1)/2$. Let $D$ be a new digraph of order $n \geq 3k+1$ such that 	
    92	$V(D) = V(D_{1}) \cup V(D_{2})$ and $A(D) = A(D_{1}) \cup A(D_{2}) \cup \{xy \colon x \in V(D_{1}), \, y \in V(D_{2})\} \cup \{yx \colon x \in V(D_{1}), \, y \in V(D_{2})\}$. Hence, $\delta^{0}(D) = \lceil (n+k) / 2 \rceil - 1$. For any vertex $u \in V(D_{1})$, we have $d^{+}_{D}(u) = d^{-}_{D}(u) = (n+k-1)/2-1 + (n-k+1)/2 = n-1 > \lceil (n+k) / 2 \rceil - 1 = (n+k-1)/2$. For any vertex $v \in V(D_{2})$, we have $d^{+}_{D}(v) = d^{-}_{D}(v) = (n+k-1)/2 = \lceil (n+k) / 2 \rceil-1$. Let $S$ and $T$ be two disjoint subsets of $V(D_{1})$ with $S=\{s_{1}, \dots, s_{k}\}$, $T=\{t_{1}, \dots, t_{k}\}$. It can be checked that for any permutation $\sigma$ on $\{1, \dots, k\}$, any set of disjoint paths $\{P_i \colon 1 \leq i \leq k\}$ satisfying that $P_i$ starts from $s_i$ and ends at $t_{\sigma(i)}$ covers at most $(n-k-1)/2$ vertices of $V(D_{2})$. Hence, $D$ does not have an unpaired many-to-many $k$-DDPC for $S$ and $T$.  \qedhere
    93	\end{proof}
    94	
    95	\section{Proof of Theorem~\ref{The:main}}\label{sec:Proof}
    96	
    97	To prove Theorem~\ref{The:main}, we need the following result.
    98	
    99	\begin{theorem} \cite{MOL1976} \label{The:n+1}
   100	If $D$ is a digraph such that $d^{+}_{D}(x) + d^{-}_{D}(y) \geq \lvert D \rvert + 1$ whenever $xy\not\in A(D)$, then $D$ is Hamiltonian connected.
   101	\end{theorem}
   102	
   103	We rewrite Theorem~\ref{The:main} and give the proof now:
   104	
   105	\begin{the 1}
   106		Let $D$ be a digraph of order $n\geq 2k$, where $k$ is a positive integer. If $\delta^{0}(D)\geq \lceil (n + k)/2 \rceil$, then $D$ has an unpaired many-to-many $k$-DDPC for any disjoint source set $S$ and sink set $T$, where $S = \{s_{1}, \dots, s_{k}\}, T = \{t_{1}, \dots, t_{k}\}$.
   107	\end{the 1}
   108	
   109	\begin{proof}
   110	We prove the result by induction on $k$. The base step of $k = 1$ holds by Theorem~\ref{The:n+1}. Now we assume that $k\geq 2$ and prove the inductive step. 
   111	Let $S = \{s_{1}, \dots, s_{k}\}$ and $T = \{t_{1}, \dots, t_{k}\}$ be disjoint source set and sink set in $D$, respectively.
   112	Let $D_{1} = D \setminus \{t_{k}\}$. Observe that  $\delta^{0}(D_1) \geq \delta^{0}(D) - 1 \geq \lceil \frac{n+k}{2} \rceil - 1 = \lceil \frac{\lvert V(D_{1}) \rvert + (k - 1)}{2} \rceil$. By the induction hypothesis, $D_{1}$ has an unpaired many-to-many $(k-1)$-DDPC, say $\mathbf{P}=\{P_{1}, \dots, P_{k-1}\}$, from $S \setminus \{s_{k}\}$ to $T \setminus \{t_{k}\}$, such that $\{i_{1}, \dots, i_{k-1}\}$ = $\{1, \dots, k-1\}$ and $P_{j}=(v^{j}_{0}, \ldots, v^{j}_{\ell_{j}})$, where $s_{j} = v^{j}_{0}$ and $t_{i_{j}} = v^{j}_{\ell_{j}}$. In the following argument, we will construct an unpaired $k$-DDPC, say $\mathbf{P}'$, from $S$ to $T$ in $D$ from $\mathbf{P}$.
   113	
   114	Without loss of generality, assume that $s_{k}$ is an inner vertex of $P_{1}$, that is, $s_{k} = v^{1}_{p}$ ($1 \leq p < \ell_{1}$). Let $x = v^{1}_{p-1}$. If we remove the arc $xs_{k}$ from $P_{1}$, then $P_{1}$ is separated into two subpaths: the $s_{1}$-$x$ path $P^{'}_{1}$ and the  $s_{k}$-$t_{i_{1}}$ path $P_{k}$, where $P_{k}=(v^{k}_{0}, \ldots, v^{k}_{\ell_{k}})$ such that $v_j^k=v_{j+p}^1$ for $0\leq j\leq {\ell}_1-p={\ell}_k$. 
   115	Now we obtain a set of $k$ disjoint paths in $D_{1}$:  $\{P^{'}_{1}, P_{2}, \ldots, P_{k}\}$, where each $P_{j}$ is from $s_{j}$ to a sink for $j \geq 2$, whereas $P^{'}_{1}$ is from $s_{1}$ to $x \notin T$. 
   116	
   117	In the following argument, we will show that $P^{'}_{1}$ and $t_{k}$ can be combined into an $s_{1}$-$t_{k}$ path, or, $P^{'}_{1}$, $t_{k}$ and  $P_{q}$ ($2 \leq q \leq k$) can be combined into two paths: an $s_{1}$-$v^{q}_{\ell_{q}}$ path $P^{\ast}_{1}$ and $s_{q}$-$t_{k}$ path $P^{\ast}_{q}$, each of which connects a source and a sink. According to whether $N^{-}_{D}(t_{k}) \cap V(P_{1})=\emptyset$, we consider the following two cases. 
   118	
   119	\begin{case} \label{cas:ept}
   120		$N^{-}_{D}(t_{k}) \cap V(P_{1})\neq \emptyset$, that is, there exists a vertex $u$ on $P_{1}$ such that $ut_{k} \in A(D)$. 
   121	\end{case}
   122	
   123	If $xt_{k} \in A(D)$, then we can obtain an $s_{1}$-$t_{k}$ path $P^{\ast}_{1}$ by adding the arc $xt_{k}$ to $P'_1$. Hence, $\mathbf{P}'=\{P^{\ast}_{1}, P_{2}, \ldots, P_{k}\}$ is a desired unpaired many-to-many $k$-DDPC of $D$. 
