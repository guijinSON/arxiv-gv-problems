+def _relabel_coordinates(inst: dict, rng: random.Random) -> tuple[dict, int]:
+    transformed = copy.deepcopy(inst)
+    length = inst["length"]
+    old_to_new = list(range(length))
+    rng.shuffle(old_to_new)
+    new_to_old = [0] * length
