+def _projective_nodes(inst: dict, rng: random.Random) -> tuple[dict, int]:
+    transformed = copy.deepcopy(inst)
+    p = inst["field_prime"]
+    while True:
+        alpha, beta, gamma, delta = (rng.randrange(p) for _ in range(4))
+        if (alpha * delta - beta * gamma) % p == 0:
+            continue
+        denominators = [(gamma * value + delta) % p for value in inst["nodes"]]
+        if all(denominators):
+            break
+    transformed["nodes"] = [
+        (alpha * value + beta) * pow(denominator, -1, p) % p
+        for value, denominator in zip(inst["nodes"], denominators)
+    ]
+    # Degree-(k-1) Vandermonde columns form a rational normal curve.  A
+    # fractional-linear node change is an invertible row-basis change followed
+    # by per-column scaling; the multiset identity cancels all such scalings.
+    transformed["answer"] = inst["answer"]
+    return transformed, inst["answer"]
 
 
