+def _mat_inv(a, q):
+    d = (a[0][0] * a[1][1] - a[0][1] * a[1][0]) % q
+    if d == 0:
+        return None
+    z = pow(d, q - 2, q)
+    return [
+        [(a[1][1] * z) % q, (-a[0][1] * z) % q],
+        [(-a[1][0] * z) % q, (a[0][0] * z) % q],
+    ]
 
