+def _batch_ratios(pairs, q):
+    """Evaluate many nonzero-denominator ratios with one field inversion."""
+    prefix = [1]
+    for _, den in pairs:
+        prefix.append(prefix[-1] * den % q)
+    suffix_inv = pow(prefix[-1], q - 2, q)
