+def _affine_two_anchor_attack(inst):
+    q, n = inst["q"], inst["n"]
+    x = _normalise_points(inst["G1"], q)
+    y = _normalise_points(inst["G2"], q)
+    if any(v is None for v in x + y) or x[1] == x[0]:
+        return list(range(n))
+    a = (y[1] - y[0]) * pow((x[1] - x[0]) % q, q - 2, q) % q
+    if a == 0:
+        return list(range(n))
+    b = (y[0] - a * x[0]) % q
+    inva = pow(a, q - 2, q)
+    lookup = {v: i for i, v in enumerate(x)}
+    ans = []
+    for v in y:
+        z = ((v - b) * inva) % q
+        if z not in lookup:
+            return list(range(n))
+        ans.append(lookup[z])
+    return ans
 
