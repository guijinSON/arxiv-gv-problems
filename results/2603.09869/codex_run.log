+def canonical_key(inst: dict) -> str:
+    """Coordinate-relabeling and projective-node invariant key for this family."""
+    p = inst["field_prime"]
+    signatures = _membership_signatures(inst)
+    try:
+        a_index = signatures.index((1, 0, 1, 0))
+        b_index = signatures.index((0, 1, 0, 1))
+        x_index = signatures.index((1, 0, 0, 1))
+    except ValueError:
+        # Strongest cheap fallback for malformed/out-of-family inputs.
+        fallback = {
+            "p": p,
+            "k": inst.get("dimension"),
+            "columns": sorted(zip(inst.get("nodes", []), signatures)),
+        }
+        wire = json.dumps(fallback, sort_keys=True, separators=(",", ":"))
+        return hashlib.sha256(wire.encode()).hexdigest()
+    # The uniquely tagged a,b,x columns anchor the projective coordinate
+    # phi(t)=(t-b)(x-a)/((t-a)(x-b)), sending b,x,a to 0,1,infinity.
+    # Cross-ratios are unchanged by every fractional-linear node change.
+    a = inst["nodes"][a_index]
+    b = inst["nodes"][b_index]
+    x = inst["nodes"][x_index]
+    xb = (x - b) % p
+    xa = (x - a) % p
+    normalized = []
+    for node, signature in zip(inst["nodes"], signatures):
+        if node == a:
+            projective = [1, 0]
+        else:
+            numerator = (node - b) * xa % p
+            denominator = (node - a) * xb % p
+            projective = [numerator * pow(denominator, -1, p) % p, 1]
+        normalized.append((projective, list(signature)))
+    columns = sorted(normalized)
+    canonical = {"p": p, "k": inst["dimension"], "columns": columns}
+    wire = json.dumps(canonical, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(wire.encode()).hexdigest()
 
 
