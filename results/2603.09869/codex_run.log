+def _reference_projective_frames(inst, node_cap=None):
+    """Generic fixed-dimension LCE solver; returns answer and measurements."""
+    q, n = inst["q"], inst["n"]
+    x = _normalise_no_infinity(inst["G1"], q)
+    y = _normalise_no_infinity(inst["G2"], q)
