+def _pluecker_block_shortcut(inst):
+    """The intended compact route, kept separate from the failing attacks."""
+    q, n = inst["q"], inst["n"]
+    source, target = _columns(inst["G1"]), _columns(inst["G2"])
+    m = n // 4
+    source_labels = []
+    target_labels = []
+    for block in range(m):
