+def _phi_inverse(a, b, c, t, q):
+    u = (b - c) % q
+    v = (a - c) % q
+    tv = (t * v) % q
+    num = (a * u - tv * b) % q
+    den = (u - tv) % q
+    if den == 0:
+        return None
+    return num * pow(den, q - 2, q) % q
 
 
