+    transformed = {
+        key: value
+        for key, value in inst.items()
+        if key not in {"allowed_coordinates", "answer"}
+    }
+    mapped = [map_index(row) for row in inst["allowed_coordinates"]]
+    transformed["allowed_coordinates"] = [mapped[i] for i in reorder]
+    carried = {
+        "numerator": [map_index(row) for row in inst["answer"]["numerator"]],
+        "denominator": [map_index(row) for row in inst["answer"]["denominator"]],
+    }
+    carried = _canonical_answer(carried["numerator"], carried["denominator"])
+    transformed["answer"] = carried
+    return transformed, carried
+
