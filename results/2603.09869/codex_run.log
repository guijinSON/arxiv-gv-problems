+    answer = [4 * block_map[j // 4] + j % 4 for j in range(n)]
+    # 4 determinants (3 ops each), 2 products, one inversion, one final
+    # multiplication = 16 exact field operations per matrix per block.
+    return answer, {"operations": 32 * m}
 
