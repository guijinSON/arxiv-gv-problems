+def _normalise_no_infinity(matrix, q):
+    vals = _normalise_points(matrix, q)
+    if None not in vals:
+        return vals
+    # A fixed coordinate shear moves the one infinity point into the affine chart.
+    transformed = [
+        [(matrix[0][j] + matrix[1][j]) % q,
+         (matrix[0][j] + 2 * matrix[1][j]) % q]
