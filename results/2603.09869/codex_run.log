def _det(u, v, q):
    return (u[0] * v[1] - u[1] * v[0]) % q


def _mat_vec(a, v, q):
    return [
        (a[0][0] * v[0] + a[0][1] * v[1]) % q,
        (a[1][0] * v[0] + a[1][1] * v[1]) % q,
    ]


def _mat_mul(a, b, q):
    return [
        [sum(a[i][t] * b[t][j] for t in range(2)) % q for j in range(2)]
        for i in range(2)
    ]


def _mat_inv(a, q):
    d = (a[0][0] * a[1][1] - a[0][1] * a[1][0]) % q
    if d == 0:
        return None
    z = pow(d, q - 2, q)
    return [
        [(a[1][1] * z) % q, (-a[0][1] * z) % q],
        [(-a[1][0] * z) % q, (a[0][0] * z) % q],
    ]


