+        "named_presets_verified": named_ok,
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "doubled_coordinates": doubled["number_of_allowed_coordinates"],
+        "fixed_certificate_factors": 4,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    unrelated_keys = []
+    for seed in range(20):
+        inst = make_instance(seed=12000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(inst)
+        unrelated_keys.append(key)
+        rng = random.Random(88000 + seed)
+        relabel = list(range(inst["ground_size"]))
+        rng.shuffle(relabel)
+        reorder = list(range(inst["number_of_allowed_coordinates"]))
+        rng.shuffle(reorder)
+        transformations = [
+            (relabel, None),
+            (None, reorder),
