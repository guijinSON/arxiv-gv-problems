+                json_roundtrips += 1
+    report["G1_planted_verifies"] = {
+        "pass": g1_ok == g1_total and json_roundtrips == g1_total,
+        "verified": g1_ok,
+        "attempts": g1_total,
+        "json_native_answers": json_roundtrips,
