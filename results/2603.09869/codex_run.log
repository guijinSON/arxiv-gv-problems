+def _normalise_no_infinity(matrix, q):
+    vals = _normalise_points(matrix, q)
+    if None not in vals:
+        return vals
+    # At most n field values make t*top+bottom vanish. Since q>n, try the
+    # deterministic shears [[1,0],[t,1]] until the whole set is affine.
