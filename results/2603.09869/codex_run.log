+            for c in range(n):
+                if c == a or c == b:
+                    continue
+                nodes += 1
+                operations += 2
+                if node_cap is not None and nodes > node_cap:
+                    return None, {"nodes": nodes, "operations": operations}
+                ans = [a, b, c]
