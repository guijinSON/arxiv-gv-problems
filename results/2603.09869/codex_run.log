/bin/bash -lc "time python3 gen_2603_09869.py > /tmp/selftest_2603.json && python3 - <<'PY'
import json
r=json.load(open('/tmp/selftest_2603.json'))
print(json.dumps(r,indent=2,sort_keys=True))
