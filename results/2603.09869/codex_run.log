+NOTES = r"""
+Definition. Section 2.2 defines the Plucker coordinate p_I as the determinant
+of the generator-matrix columns indexed by the k-subset I. Proposition 2 fixes
+the diagonal action: p_I is multiplied by the product of the diagonal scalars
+whose indices lie in I. Section 3 packages those torus weights as the rows of
+the subset-incidence matrix W_{k,n}; its integer left kernel gives invariant
+Laurent monomials.
+
+Certificate theorem. Section 4, Lemma 4.1 (labelled prop:IJ in the source),
+states that p_I p_J/(p_K p_L) is invariant whenever I multiset-union J equals K
+multiset-union L. The checker executes exactly that cancellation. It does not
+need a theorem oracle, a Groebner basis, a code-equivalence solver, or the
+planted answer.
+
+Step-0 hardness decision. The paper does not prove average-case hardness for a
+new inverse-generated LCE distribution. It also gives a polynomial-time way to
+write each four-term invariant, while its full W_{k,n} has binomial(n,k) rows
+and its degree-2k LCE equations have 2(k!)^2 monomials (Theorem 4.2). Therefore
+this module does not claim Track A. In the bounded certificate language used
+here, the standard algorithm is pair-sum hashing: form the integer torus-weight
+of every pair of allowed Plucker coordinates and stop at a collision. Its
+O(m^2 k) worst-case cost and measured early-exit cost are reported as the
+Track-B reference algorithm.
+
+Construction. Every displayed 4-subset contains the same two-element core. On
+the other ground elements the generator includes all edges of a hidden K_{n,n}
+and a seed-dependent sample of within-side decoy edges. Any rectangle of the
+K_{n,n} supplies opposite edge pairs with the same incidence sum. One rectangle
+is selected before the public list is shuffled, so generation never solves the
+instance it emits. The core, both sides, ground labels, list order, and decoys
+are all randomized with a private random.Random(seed).
+
+Compact route. After recognizing the common-core/bipartite decomposition, four
+corners of any rectangle give the invariant. Writing and checking their two
+incidence sums takes 24 exact counter updates at k=4; textual lookup and symbol
+comparison do not require field arithmetic. Pair-sum hashing is still cheap on
+a computer but requires thousands of exact pair constructions at the shipping
+preset, creating the no-tool compression gap.
+
+Attacks. The panel tries a per-coordinate frequency outlier, a left-to-right
+overlap greedy rule, 256 uniform certificate restarts, and a small-window
+anchored rectangle heuristic that is feasible in context. The dense grid makes
+individual rows exchangeable enough that these fixed guesses do not identify a
+rectangle, while the exact reference collision algorithm succeeds as expected.
+
+Canonicalization. Reordering the allowed coordinates and arbitrarily relabelling
+the ground set preserve the problem. canonical_key performs deterministic color
+refinement on the complete element-coordinate incidence graph and hashes the
+multiset of stable colors. The random within-side edge graph supplies structural
+diversity. This is a strong inexpensive invariant, not a complete hypergraph
+isomorphism canonizer; exotic non-isomorphic collisions remain possible.
+""".strip()
+
+
+_ANSWER_RE = re.compile(
+    r"<answer\b[^>]*>(.*?)</answer\s*>", re.IGNORECASE | re.DOTALL
+)
+_K = 4
+_CORE_SIZE = 2
+_MEMBERSHIP_CACHE: "OrderedDict[int, tuple[object, frozenset[tuple[int, ...]]]]" = OrderedDict()
+_CACHE_LIMIT = 12
+
+
+def _sorted_index(core: list[int], x: int, y: int) -> list[int]:
+    return sorted(core + [x, y])
+
+
+def _canonical_answer(
+    numerator: list[list[int]], denominator: list[list[int]]
+) -> dict:
+    return {
+        "numerator": sorted([sorted(x) for x in numerator]),
+        "denominator": sorted([sorted(x) for x in denominator]),
+    }
+
+
+def make_instance(n: int, seed: int = 0, decoy_percent: int = 12, **params) -> dict:
+    """Construct a known four-term Plucker invariant before hiding its grid.
+
+    ``n`` is the size of each side of the hidden complete bipartite graph.  The
+    public list has n^2 plus approximately ``decoy_percent`` percent as many
+    coordinates, while the four-factor certificate stays the same size.
+    """
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(n, bool) or not isinstance(n, int) or n < 2:
+        raise ValueError("n must be an integer at least 2")
+    if (
+        isinstance(decoy_percent, bool)
+        or not isinstance(decoy_percent, int)
+        or not 0 <= decoy_percent <= 80
+    ):
+        raise ValueError("decoy_percent must be an integer from 0 through 80")
+
+    rng = random.Random(seed)
+    ground_size = _CORE_SIZE + 2 * n
+    labels = list(range(ground_size))
+    rng.shuffle(labels)
+    core = labels[:_CORE_SIZE]
+    side_a = labels[_CORE_SIZE : _CORE_SIZE + n]
+    side_b = labels[_CORE_SIZE + n :]
+
+    allowed = [
+        _sorted_index(core, a, b)
+        for a in side_a
+        for b in side_b
+    ]
+
+    internal = list(itertools.combinations(side_a, 2))
+    internal.extend(itertools.combinations(side_b, 2))
+    decoy_count = min(
+        len(internal), (n * n * decoy_percent + 50) // 100
+    )
+    for x, y in rng.sample(internal, decoy_count):
+        allowed.append(_sorted_index(core, x, y))
+
+    a0, a1 = side_a[:2]
+    b0, b1 = side_b[:2]
+    answer = _canonical_answer(
+        [_sorted_index(core, a0, b0), _sorted_index(core, a1, b1)],
+        [_sorted_index(core, a0, b1), _sorted_index(core, a1, b0)],
+    )
+
+    rng.shuffle(allowed)
+    return {
+        "family": "four-term Plucker torus invariant",
+        "n": n,
+        "k": _K,
+        "ground_size": ground_size,
+        "decoy_percent": decoy_percent,
+        "number_of_allowed_coordinates": len(allowed),
+        "allowed_coordinates": allowed,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Return the complete solver-facing symbolic invariant problem."""
+    allowed_lines = "\n".join(
+        f"{i}: " + " ".join(str(x) for x in index)
+        for i, index in enumerate(inst["allowed_coordinates"])
+    )
+    statement = f"""Four-term invariant in Plucker coordinates
+
+All definitions needed for this problem follow. Let the ground set be the
+0-based labels 0,...,{inst['ground_size'] - 1}. For every strictly increasing
+{inst['k']}-element subset I of this ground set, p_I denotes a formal Plucker
+coordinate. Under independent nonzero diagonal coordinate scalings
+(lambda_0,...,lambda_{inst['ground_size'] - 1}), it transforms as
+
+    p_I -> (product of lambda_i over i in I) p_I.
+
+A rational Laurent monomial p_I p_J / (p_K p_L) is therefore invariant under
+every such scaling exactly when every ground label occurs with the same total
+multiplicity in I and J as in K and L. Multiplicity matters: this is equality
+of multiset unions, not ordinary set unions.
+
+Below are {inst['number_of_allowed_coordinates']} allowed Plucker-coordinate
+indices. Each line has a display number, a colon, and then the four elements of
+one index. The display numbers are only line labels and are not part of the
+subsets.
+
+{allowed_lines}
+
+Find two distinct allowed indices I,J for the numerator and two other distinct
+allowed indices K,L for the denominator such that I multiset-union J equals K
+multiset-union L. All four indices must be different and must occur in the
+displayed list. The order of the two numerator factors and the order of the two
+denominator factors do not matter. Write every index as a strictly increasing
+JSON list of exactly four integers. Do not output line labels.
+
+Give your final answer inside <answer></answer> tags, as one JSON object with
+exactly the keys "numerator" and "denominator", each holding a list of two
+index lists. Example format:
+<answer>{{"numerator":[[0,1,2,3],[0,1,4,5]],"denominator":[[0,1,2,5],[0,1,3,4]]}}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text) -> object | None:
+    """Extract the tagged JSON certificate, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    if payload.startswith("```"):
+        payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.IGNORECASE)
+        payload = re.sub(r"\s*```$", "", payload).strip()
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError):
+        return None
+    return value
+
+
+def _allowed_set(inst: dict) -> frozenset[tuple[int, ...]]:
+    cache_key = id(inst)
+    cached = _MEMBERSHIP_CACHE.get(cache_key)
+    marker = inst.get("allowed_coordinates")
+    if cached is not None and cached[0] is marker:
+        _MEMBERSHIP_CACHE.move_to_end(cache_key)
+        return cached[1]
+    value = frozenset(tuple(row) for row in marker)
+    _MEMBERSHIP_CACHE[cache_key] = (marker, value)
+    _MEMBERSHIP_CACHE.move_to_end(cache_key)
+    while len(_MEMBERSHIP_CACHE) > _CACHE_LIMIT:
+        _MEMBERSHIP_CACHE.popitem(last=False)
+    return value
+
+
+def _weight(indices: list[list[int]]) -> Counter:
+    weight: Counter = Counter()
+    for index in indices:
+        weight.update(index)
+    return weight
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check a submitted Laurent monomial without consulting the plant."""
+    if not isinstance(answer, dict) or set(answer) != {"numerator", "denominator"}:
+        return False, "answer must be an object with numerator and denominator"
+    numerator = answer["numerator"]
+    denominator = answer["denominator"]
+    if (
+        not isinstance(numerator, list)
+        or not isinstance(denominator, list)
+        or len(numerator) != 2
+        or len(denominator) != 2
+    ):
+        return False, "numerator and denominator must each contain exactly two Plucker indices"
+
+    factors = numerator + denominator
+    if any(not isinstance(index, list) or len(index) != inst["k"] for index in factors):
+        return False, "each Plucker index must contain exactly k entries"
+    if any(
+        isinstance(x, bool) or not isinstance(x, int)
+        for index in factors
+        for x in index
+    ):
+        return False, "Plucker index entries must be integers"
+    if any(
+        x < 0 or x >= inst["ground_size"]
+        for index in factors
+        for x in index
+    ):
+        return False, "Plucker index entry is outside the ground-set range"
+    if any(any(a >= b for a, b in zip(index, index[1:])) for index in factors):
+        return False, "each Plucker index must be strictly increasing"
+
+    tuples = [tuple(index) for index in factors]
+    allowed = _allowed_set(inst)
+    if any(index not in allowed for index in tuples):
+        return False, "a Plucker index is not in the allowed coordinate list"
+    if len(set(tuples)) != 4:
+        return False, "the four Plucker indices must be distinct"
+    if _weight(numerator) != _weight(denominator):
+        return False, "torus weights do not cancel between numerator and denominator"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from the shape-aware four-factor language."""
+    rows = rng.sample(inst["allowed_coordinates"], 4)
+    numerator_positions = set(rng.sample(range(4), 2))
+    numerator = [list(rows[i]) for i in range(4) if i in numerator_positions]
+    denominator = [list(rows[i]) for i in range(4) if i not in numerator_positions]
+    return _canonical_answer(numerator, denominator)
+
+
+def search_space(inst: dict) -> int:
+    """Count four distinct factors and the six oriented two-two splits."""
+    m = inst["number_of_allowed_coordinates"]
+    return 6 * math.comb(m, 4)
+
+
+def _graph_from_instance(inst: dict) -> tuple[list[int], dict[int, set[int]]]:
+    rows = [set(index) for index in inst["allowed_coordinates"]]
+    common = set.intersection(*rows) if rows else set()
+    if len(common) != _CORE_SIZE:
+        raise ValueError("instance does not have the expected common core")
+    vertices = sorted(set(range(inst["ground_size"])) - common)
+    adjacency = {v: set() for v in vertices}
+    for row in rows:
+        edge = sorted(row - common)
+        if len(edge) != 2:
+            raise ValueError("coordinate is not core plus an edge")
+        u, v = edge
+        adjacency[u].add(v)
+        adjacency[v].add(u)
+    return vertices, adjacency
+
+
+def _count_four_cycles(inst: dict) -> int:
+    vertices, adjacency = _graph_from_instance(inst)
+    twice = 0
+    for i, u in enumerate(vertices):
+        for v in vertices[i + 1 :]:
+            common = len(adjacency[u].intersection(adjacency[v]))
+            twice += math.comb(common, 2)
+    if twice % 2:
+        raise AssertionError("four-cycle double count is not even")
+    return twice // 2
+
+
+def enumerate_all(inst: dict) -> int:
+    """Exactly count valid oriented ratios via the graph four-cycle identity."""
+    return 2 * _count_four_cycles(inst)
+
+
+def _stable_incidence_colors(inst: dict, rounds: int = 8) -> list[str]:
+    """Isomorphism-invariant color refinement on the incidence bipartite graph."""
+    rows = [tuple(index) for index in inst["allowed_coordinates"]]
+    ground_size = inst["ground_size"]
+    total = ground_size + len(rows)
+    adjacency: list[list[int]] = [[] for _ in range(total)]
+    for j, row in enumerate(rows):
+        row_node = ground_size + j
+        for element in row:
+            adjacency[element].append(row_node)
+            adjacency[row_node].append(element)
+
+    colors = []
+    for node in range(total):
+        kind = "element" if node < ground_size else "coordinate"
+        raw = f"{kind}:{len(adjacency[node])}".encode()
+        colors.append(hashlib.sha256(raw).hexdigest())
+    for _ in range(rounds):
+        new_colors = []
+        for node in range(total):
+            payload = colors[node] + "|" + "|".join(
+                sorted(colors[other] for other in adjacency[node])
+            )
+            new_colors.append(hashlib.sha256(payload.encode()).hexdigest())
+        if new_colors == colors:
+            break
+        colors = new_colors
+    return colors
+
+
+def canonical_key(inst: dict) -> str:
+    """Invariant under ground relabelling and coordinate-list reordering."""
+    colors = _stable_incidence_colors(inst)
+    payload = {
+        "k": inst["k"],
+        "ground_size": inst["ground_size"],
+        "coordinates": inst["number_of_allowed_coordinates"],
+        "stable_color_multiset": sorted(Counter(colors).items()),
+    }
+    return hashlib.sha256(
+        json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    ).hexdigest()
+
+
+def escalate(params: dict) -> dict:
+    """Grow the coordinate haystack while retaining a four-factor witness."""
+    out = dict(params)
+    n = int(out.get("n", 2))
+    out["n"] = max(n + 1, (5 * n + 3) // 4)
+    out.setdefault("decoy_percent", 12)
+    return out
+
+
+def _all_partitions(rows: list[list[int]]):
+    for numerator_positions in itertools.combinations(range(4), 2):
+        chosen = set(numerator_positions)
+        yield _canonical_answer(
+            [rows[i] for i in range(4) if i in chosen],
+            [rows[i] for i in range(4) if i not in chosen],
+        )
+
+
+def _first_valid_partition(inst: dict, rows: list[list[int]]) -> object | None:
+    if len({tuple(row) for row in rows}) != 4:
+        return None
+    for candidate in _all_partitions(rows):
+        if verify(inst, candidate)[0]:
+            return candidate
+    return None
+
+
+def _attack_frequency_outlier(inst: dict) -> object | None:
+    frequency = Counter(x for row in inst["allowed_coordinates"] for x in row)
+    ranked = sorted(
+        inst["allowed_coordinates"],
+        key=lambda row: (-sum(frequency[x] for x in row), tuple(row)),
+    )
+    return _first_valid_partition(inst, [list(row) for row in ranked[:4]])
+
+
+def _attack_overlap_greedy(inst: dict) -> object | None:
+    rows = inst["allowed_coordinates"]
+    # The natural nearest-neighbour greedy rule keeps comparing with its first
+    # choice.  It tends to collect a star, whereas a certificate needs a cycle.
+    anchor = set(rows[0])
+    ranked = sorted(
+        range(1, len(rows)),
+        key=lambda i: (-len(set(rows[i]).intersection(anchor)), i),
+    )
+    chosen = [rows[0]] + [rows[i] for i in ranked[:3]]
+    return _first_valid_partition(inst, [list(row) for row in chosen])
+
+
+def _attack_random_restarts(inst: dict, seed: int, restarts: int = 256) -> object | None:
+    rng = random.Random(seed ^ 0xA5A55A5A)
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate
+    return None
+
+
+def _attack_small_window(inst: dict, window: int = 16) -> object | None:
+    """A feasible in-context try: anchor at row zero inside a tiny text window."""
+    rows = inst["allowed_coordinates"][:window]
+    if len(rows) < 4:
+        return _first_valid_partition(inst, [list(row) for row in rows])
+    base = set(rows[0])
+    for i in range(1, len(rows)):
+        if len(base.intersection(rows[i])) < _K - 1:
+            continue
+        for j in range(i + 1, len(rows)):
+            if len(base.intersection(rows[j])) < _K - 1:
+                continue
+            for ell in range(j + 1, len(rows)):
+                candidate = _first_valid_partition(
+                    inst, [list(rows[0]), list(rows[i]), list(rows[j]), list(rows[ell])]
+                )
+                if candidate is not None:
+                    return candidate
+        break
+    return None
+
+
+def _pair_sum_reference(inst: dict) -> tuple[object | None, int, int]:
+    """Meet-in-the-middle collision search; return answer, pairs, additions."""
+    rows = inst["allowed_coordinates"]
+    seen: dict[tuple[int, ...], tuple[int, int]] = {}
+    pair_checks = 0
+    for i in range(len(rows)):
+        for j in range(i + 1, len(rows)):
+            pair_checks += 1
+            key = tuple(sorted(rows[i] + rows[j]))
+            old = seen.get(key)
+            if old is not None:
+                a, b = old
+                if len({a, b, i, j}) == 4:
+                    candidate = _canonical_answer(
+                        [list(rows[a]), list(rows[b])],
+                        [list(rows[i]), list(rows[j])],
+                    )
+                    if verify(inst, candidate)[0]:
+                        return candidate, pair_checks, pair_checks * (2 * inst["k"])
+            else:
+                seen[key] = (i, j)
+    return None, pair_checks, pair_checks * (2 * inst["k"])
+
+
+def _atomic_elements(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_atomic_elements(x) for x in value.values())
+    if isinstance(value, list):
+        return sum(_atomic_elements(x) for x in value)
+    return 1
+
+
+def _copy_answer(answer: dict) -> dict:
+    return json.loads(json.dumps(answer))
+
+
+def _transform_instance(
+    inst: dict, relabel: list[int] | None = None, reorder: list[int] | None = None
+) -> tuple[dict, dict]:
+    """Apply genuine problem symmetries and carry the certificate."""
+    if relabel is None:
+        relabel = list(range(inst["ground_size"]))
+    if reorder is None:
+        reorder = list(range(inst["number_of_allowed_coordinates"]))
+
+    def map_index(index: list[int]) -> list[int]:
+        return sorted(relabel[x] for x in index)
+
+    transformed = {
+        key: value
+        for key, value in inst.items()
+        if key not in {"allowed_coordinates", "answer"}
+    }
+    mapped = [map_index(row) for row in inst["allowed_coordinates"]]
+    transformed["allowed_coordinates"] = [mapped[i] for i in reorder]
+    carried = {
+        "numerator": [map_index(row) for row in inst["answer"]["numerator"]],
+        "denominator": [map_index(row) for row in inst["answer"]["denominator"]],
+    }
+    carried = _canonical_answer(carried["numerator"], carried["denominator"])
+    transformed["answer"] = carried
+    return transformed, carried
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return a fully JSON-native evidence dictionary."""
+    report: dict = {
+        "paper": "2603.09869",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
