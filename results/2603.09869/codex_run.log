+def escalate(params: dict) -> dict:
+    """Grow determinant order and field entropy with a fixed one-residue witness."""
+    harder = dict(params)
+    current = int(harder.get("n", 2))
+    harder["n"] = max(current + 1, (3 * current + 1) // 2)
+    current_prime = int(harder.get("prime", 2147483647))
+    harder["prime"] = max(current_prime, 2305843009213693951)  # 2^61-1 is prime
