+def _canonical_anharmonic(r, q):
+    """Canonical value under all 24 reorderings of an unordered quadruple."""
+    if r in (None, 0, 1):
+        return -1
+    ir = pow(r, q - 2, q)
+    one_minus = (1 - r) % q
+    iom = pow(one_minus, q - 2, q)
+    vals = {
+        r,
+        ir,
+        one_minus,
+        iom,
+        (r * pow((r - 1) % q, q - 2, q)) % q,
+        (((r - 1) % q) * ir) % q,
+    }
+    return min(vals)
 
 
