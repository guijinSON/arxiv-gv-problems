+    """Homogeneous numerator/denominator for batch evaluation of j."""
+    lam_num = (num + den) % q
+    diff = (den - lam_num) % q
+    if den == 0 or lam_num == 0 or diff == 0:
+        return 0, 1
+    core = (den * den - lam_num * den + lam_num * lam_num) % q
