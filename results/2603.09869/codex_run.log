+    iom = pow(one_minus, q - 2, q)
+    vals = {
+        s,
+        ir,
+        one_minus,
+        iom,
+        (s * pow((s - 1) % q, q - 2, q)) % q,
+        (((s - 1) % q) * ir) % q,
+    }
+    return min(vals)
 
 
