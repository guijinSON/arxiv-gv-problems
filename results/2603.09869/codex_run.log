+        g2 = _apply_basis_and_scales(g2, b, [rng.randrange(1, q) for _ in range(n)], q)
+    inv_src = [0] * n
+    for new, old in enumerate(src_order):
+        inv_src[old] = new
+    answer = [inv_src[inst["answer"][dst_order[j]]] for j in range(n)]
+    out = {
+        "n": n, "k": 2, "q": q,
+        "G1": _matrix_from_columns(g1),
