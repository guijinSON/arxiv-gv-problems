+    pair_checks = 0
+    for i in range(len(rows)):
+        for j in range(i + 1, len(rows)):
+            pair_checks += 1
+            key = tuple(sorted(rows[i] + rows[j]))
+            old = seen.get(key)
+            if old is not None:
+                a, b = old
+                if len({a, b, i, j}) == 4:
