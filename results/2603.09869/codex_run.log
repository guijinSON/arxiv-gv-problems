+            [matrix[0][j] % q, (t * matrix[0][j] + matrix[1][j]) % q]
+            for j in range(len(matrix[0]))
+        ]
+        vals = _normalise_points(_matrix_from_columns(transformed), q)
+        if None not in vals:
+            return vals
+    return vals
 
 
