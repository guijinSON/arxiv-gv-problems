+
+
+def search_space(inst: dict) -> int:
+    """Count four distinct factors and the six oriented two-two splits."""
+    m = inst["number_of_allowed_coordinates"]
+    return 6 * math.comb(m, 4)
+
+
+def _graph_from_instance(inst: dict) -> tuple[list[int], dict[int, set[int]]]:
+    rows = [set(index) for index in inst["allowed_coordinates"]]
+    common = set.intersection(*rows) if rows else set()
+    if len(common) != _CORE_SIZE:
+        raise ValueError("instance does not have the expected common core")
+    vertices = sorted(set(range(inst["ground_size"])) - common)
+    adjacency = {v: set() for v in vertices}
+    for row in rows:
+        edge = sorted(row - common)
+        if len(edge) != 2:
+            raise ValueError("coordinate is not core plus an edge")
+        u, v = edge
+        adjacency[u].add(v)
+        adjacency[v].add(u)
+    return vertices, adjacency
+
+
+def _count_four_cycles(inst: dict) -> int:
+    vertices, adjacency = _graph_from_instance(inst)
+    twice = 0
+    for i, u in enumerate(vertices):
+        for v in vertices[i + 1 :]:
+            common = len(adjacency[u].intersection(adjacency[v]))
+            twice += math.comb(common, 2)
