+def _extended_inverse(value: int, p: int) -> tuple[int, int]:
+    old_r, r = p, value % p
+    old_t, t = 0, 1
+    divisions = 0
+    while r:
+        q = old_r // r
+        old_r, r = r, old_r - q * r
+        old_t, t = t, old_t - q * t
+        divisions += 1
+    if old_r != 1:
+        raise ZeroDivisionError("noninvertible field element")
+    return old_t % p, divisions
 
