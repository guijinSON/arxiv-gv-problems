codex
The home-grown DPLL becomes inconsistent around 192 variables—some seeds solve immediately and others hit a 20-second cap—so it is not a reliable basis for either acceptance or rejection. I’m switching to the exact solver the paper benchmarked (MiniSat) and will measure conflicts, decisions, propagations, and wall time on the paper’s \(k=3,\ m=5n\) distribution through the full 256-bit answer limit.
exec
/bin/bash -lc 'diag_dir=$(mktemp -d)
cd "$diag_dir"
apt-get download minisat >/dev/null 2>&1
dpkg-deb -x minisat_*.deb unpack
"$diag_dir/unpack/usr/bin/minisat" --help 2>&1 | sed -n '"'1,20p'
python3 - \""'$diag_dir/unpack/usr/bin/minisat" <<'"'PY'
import random,time,json,subprocess,tempfile,os,re,sys
solver=sys.argv[1]

def make(n,seed,k=3,ratio=5.0):
    r=random.Random(seed); planted=[r.randrange(2) for _ in range(n)]; clauses=[]; seen=set(); m=round(ratio*n)
    while len(clauses)<m:
        vs=sorted(r.sample(range(n),k)); lits=tuple((v,r.randrange(2)) for v in vs)
        if lits in seen or not any(planted[v]==s for v,s in lits): continue
        seen.add(lits);clauses.append(lits)
    return clauses,planted

def run(n,seed):
  cs,p=make(n,seed)
  fd,path=tempfile.mkstemp(prefix='gv_sat_',suffix='.cnf');os.close(fd)
  outpath=path+'.out'
  try:
    with open(path,'w') as f:
      f.write(f'p cnf {n} {len(cs)}\\n')
      for c in cs:f.write(' '.join(str(v+1 if s else -(v+1)) for v,s in c)+' 0\\n')
    t=time.perf_counter();q=subprocess.run([solver,'-verb=1',path,outpath],capture_output=True,text=True,timeout=30); wall=time.perf_counter()-t
    txt=q.stdout+'\\n'+q.stderr
    answer=None
    if os.path.exists(outpath):
      lines=open(outpath).read().splitlines()
      if lines and lines[0].strip()=='SAT':
        vals=[int(x) for x in lines[1].split() if int(x)"'!=0];answer=[0]*n
        for z in vals:answer[abs(z)-1]=int(z>0)
    def stat(label):
      m=re.search(r'"'"'^'"'+re.escape(label)+r'\\s*:\\s*([0-9]+)',txt,re.M);return int(m.group(1)) if m else None
    cpu=re.search(r'"'^CPU time'"\\s*:\\s*([0-9.]+)',txt,re.M)
    ok=answer is not None and all(any(answer[v]==s for v,s in c) for c in cs)
    return {'n':n,'seed':seed,'verified':ok,'wall_sec':wall,'cpu_sec':float(cpu.group(1)) if cpu else None,'conflicts':stat('conflicts'),'decisions':stat('decisions'),'propagations':stat('propagations'),'hamming_from_plant':sum(x"'!=y for x,y in zip(answer,p)) if answer else None}
  finally:
    for q in (path,outpath):
      try:os.unlink(q)
      except FileNotFoundError:pass
rows=[]
for n in (128,192,256):
 for seed in range(20):
  row=run(n,seed);rows.append(row);print(json.dumps(row),flush=True)
print('"'SUMMARY')
for n in (128,192,256):
 q=[x for x in rows if x['n']==n]
 print(json.dumps({'n':n,'solved':sum(x['verified'] for x in q),'attempts':len(q),'max_wall_sec':max(x['wall_sec'] for x in q),'median_wall_sec':sorted(x['wall_sec'] for x in q)[len(q)//2],'max_conflicts':max(x['conflicts'] for x in q),'max_decisions':max(x['decisions'] for x in q),'max_propagations':max(x['propagations'] for x in q)}))
