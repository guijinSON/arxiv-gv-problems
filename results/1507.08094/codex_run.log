import random,time,json,sys
sys.setrecursionlimit(10000)

def make(n,seed,k=3,ratio=5.0):
    r=random.Random(seed); planted=[r.randrange(2) for _ in range(n)]; clauses=[]; seen=set(); m=round(ratio*n)
    while len(clauses)<m:
        vs=sorted(r.sample(range(n),k)); lits=tuple((v, r.randrange(2)) for v in vs) # sign=1 means positive, true iff x=1
        if lits in seen: continue
        if not any(planted[v]==s for v,s in lits): continue
        seen.add(lits); clauses.append(lits)
    return clauses,planted

def solve(clauses,n,node_cap=200000):
    stats={'nodes':0,'clause_scans':0,'literal_checks':0,'backtracks':0}; deadline=time.perf_counter()+20
    # initial signed occurrence bias
    bias=[0]*n
    for c in clauses:
        for v,s in c: bias[v]+=1 if s else -1
    def rec(a):
        stats['nodes']+=1
        if stats['nodes']>node_cap or time.perf_counter()>deadline: return 'cap'
        # propagation
        while True:
            unit=None; allsat=True
            for c in clauses:
                stats['clause_scans']+=1; sat=False; last=-1; cnt=0; val=0
                for v,s in c:
                    stats['literal_checks']+=1
                    av=a[v]
                    if av<0: cnt+=1; last=v; val=s
                    elif av==s: sat=True; break
                if sat: continue
                allsat=False
                if cnt==0: return None
                if cnt==1:
                    if unit is None: unit=(last,val)
                    elif unit[0]==last and unit[1]"'!=val: return None
            if allsat: return a
            if unit is None: break
            v,val=unit
            if a[v]>=0 and a[v]!=val: return None
            a[v]=val
        # Jeroslow-Wang-ish score on unresolved clauses
        score=[0.0]*n; pos=[0]*n; neg=[0]*n
        for c in clauses:
            sat=False; us=[]
            for v,s in c:
                av=a[v]
                if av==s: sat=True; break
                if av<0: us.append((v,s))
            if sat: continue
            w=2.0**(-len(us))
            for v,s in us:
                score[v]+=w
                if s: pos[v]+=1
                else: neg[v]+=1
        v=max((i for i in range(n) if a[i]<0), key=lambda i:score[i], default=-1)
        if v<0:return a
        first=1 if pos[v]>=neg[v] else 0
        for val in (first,1-first):
            b=a.copy();b[v]=val
            z=rec(b)
            if z=='"'cap': return z
            if z is not None:return z
            stats['backtracks']+=1
        return None
    t=time.perf_counter(); ans=rec([-1]*n); stats['sec']=time.perf_counter()-t; stats['solved']=isinstance(ans,list); stats['valid']=stats['solved'] and all(any(ans[v]==s for v,s in c) for c in clauses)
    return stats,ans

out=[]
for n in (64,128,192,256):
  for seed in range(8):
    cs,p=make(n,seed)
    st,a=solve(cs,n)
    hd=sum(x"'!=y for x,y in zip(a,p)) if a else None
    row={'"'n':n,'seed':seed,'hamming_from_plant':hd,**st};out.append(row);print(json.dumps(row),flush=True)
print('SUMMARY')
for n in (64,128,192,256):
