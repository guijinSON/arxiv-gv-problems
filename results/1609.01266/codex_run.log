import random

def instance(n,seed):
 r=random.Random(seed);T=n*n;lo=T//4+1;hi=T//2-1;vals=[];groups=[]
 for g in range(n):
  while 1:
   a=r.randint(lo,hi);b=r.randint(lo,hi);c=T-a-b
   if lo<=c<=hi:
    groups.append([a,b,c]);vals += [a,b,c];break
 lin=lambda i:2*(n*n+i); hi2=lambda i:lin(i)+2
 yi=hi2(n)**2
 L=[(lin(i)*T,1,yi-lin(i)*T-1,yi-2) for i in range(n)]
 H=[(1,hi2(i)*T,yi-hi2(i)*T-1,yi-2) for i in range(n)]
 Y=[]
 for i in range(n):Y += [L[i]]+[(T,s,1,1) for s in groups[i]]+[H[i]]
 ell=(10*n-1)*yi+sum(hi2(j)*T for j in range(n))+n*(T+6)
 return Y,ell

def maxcycle(Y):
 k=len(Y);C=2*k;D=C-1;neg=-10**100
 best=neg
 for sp in (0,1):
  dp=[neg]*(D+1);dp[0]=0
  for q in range(C):
   j=q//2
   # vertical closure
   for d in range(D):
    if dp[d]==neg:continue
    p=(sp+d-q)&1
    x0,x1,y0,y1=Y[j];x=(x0,x1);y=(y0,y1)
    w=(y[p]+x[p]+1) if q%2==0 else (y[1-p]+x[p]+1)
    z=dp[d]+w
    if z>dp[d+1]:dp[d+1]=z
   if q<C-1:
    nd=[neg]*(D+1)
    for d,v in enumerate(dp):
     if v==neg:continue
     p=(sp+d-q)&1
     w=(Y[j][p] if q%2==0 else 1)
     nd[d]=v+w
    dp=nd
  best=max(best,dp[D]+1)
 return best
