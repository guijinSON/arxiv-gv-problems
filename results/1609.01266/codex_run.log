+        nonlocal nodes
+        nodes += 1
+        if nodes > cap:
+            return None
+        if used == full:
+            return 1
+        pivot = min(full - used)
+        total = 0
+        for triple_id in incident[pivot]:
+            triple = triple_sets[triple_id]
+            if triple & used:
