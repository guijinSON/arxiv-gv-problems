+
+
+def _item_value(inst: dict, index: int) -> int:
+    return inst["columns"][index][1]
+
+
+def _quick_partition_valid(inst: dict, answer: object) -> bool:
+    if not isinstance(answer, list) or len(answer) != inst["n"]:
+        return False
+    flat: list[int] = []
