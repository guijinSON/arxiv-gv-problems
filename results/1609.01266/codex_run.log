+    return {
+        "paper": "arXiv:1609.01266",
+        "family": "minimum cycle weighing on the paper's pseudo-grid",
+        "n": n,
+        "target": target,
+        "y_infinity": y_infinity,
+        "cycle_bound": bound,
+        "columns": columns,
+        "answer": answer,
+    }
