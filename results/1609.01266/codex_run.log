+        "out_of_range": [[len(ship["columns"]), answer[0][1], answer[0][2]]] + [group[:] for group in answer[1:]],
+        "anchor": [[anchor, answer[0][1], answer[0][2]]] + [group[:] for group in answer[1:]],
