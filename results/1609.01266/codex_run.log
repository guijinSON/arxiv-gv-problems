+        order = list(range(len(original["columns"])))
+        rng.shuffle(order)
+        moved, carried = _reorder_instance(original, order)
+        # Compose a second independent reordering with the first.
+        order2 = list(range(len(moved["columns"])))
+        rng.shuffle(order2)
