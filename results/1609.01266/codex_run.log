+DIFFICULTY = {
+    "demo": {"n": 3, "filter_nodes": 0, "random_restarts": 0},
+    "easy": {"n": 24, "filter_nodes": 5_000, "random_restarts": 64},
+    "medium": {"n": 36, "filter_nodes": 20_000, "random_restarts": 96},
+    "hard": {"n": 48, "filter_nodes": 50_000, "random_restarts": 128},
