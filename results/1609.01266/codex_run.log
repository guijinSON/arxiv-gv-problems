+    planted_values: list[list[int]] = []
+    for _ in range(n):
+        for _attempt in range(100_000):
+            a = rng.randint(low, high)
+            b = rng.randint(low, high)
+            c = target - a - b
+            if low <= c <= high:
+                planted_values.append([a, b, c])
+                break
