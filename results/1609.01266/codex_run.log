+    invariant_checks = 0
+    witness_checks = 0
+    failures: list[str] = []
+    unrelated_keys: list[str] = []
+    symmetry_params = {"n": 12, "filter_nodes": 0, "random_restarts": 0}
+    for seed in range(20):
