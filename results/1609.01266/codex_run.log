+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    filter_nodes: int = 0,
+    random_restarts: int = 64,
+    **params: Any,
+) -> dict:
+    """Build a paper-reduction instance around a pre-sampled partition.
