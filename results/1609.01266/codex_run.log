+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 5, Theorem 20: the displayed reduction from 3-PARTITION "
+        "to Minimum Cycle Weighing (MCW)"
