+
+
+def parse_answer(text: str) -> object | None:
+    try:
+        matches = re.findall(
+            r"<answer>(.*?)</answer>", text, re.IGNORECASE | re.DOTALL
+        )
+        for raw in reversed(matches):
+            body = raw.strip()
+            body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.IGNORECASE)
