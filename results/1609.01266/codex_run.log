+    records: list[dict[str, Any]] = []
+    for group_id, triple in enumerate(planted_values):
+        li = _l_value(n, group_id)
+        hi = _h_value(n, group_id)
+        records.append(
+            {
+                "kind": "L",
+                "group": group_id,
+                "row": [li * target, 1, y_infinity - li * target - 1, y_infinity - 2],
