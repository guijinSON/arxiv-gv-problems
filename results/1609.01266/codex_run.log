+def _attack_value_bands(inst: dict) -> list[list[int]]:
+    ordered = sorted(_item_indices(inst), key=lambda i: (_item_value(inst, i), i))
+    n = inst["n"]
+    return [[ordered[i], ordered[n + i], ordered[3 * n - 1 - i]] for i in range(n)]
