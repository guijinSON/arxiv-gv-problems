+def _mix_seed(seed: int, nonce: int) -> int:
+    """Stable integer mixing; never touches module-global random state."""
+    x = (int(seed) & ((1 << 64) - 1)) ^ 0x160901266A5A5A5A
+    x = (x + (nonce + 1) * 0x9E3779B97F4A7C15) & ((1 << 128) - 1)
+    x ^= x >> 30
+    x *= 0xBF58476D1CE4E5B9
+    x ^= x >> 27
+    return x & ((1 << 128) - 1)
+
+
