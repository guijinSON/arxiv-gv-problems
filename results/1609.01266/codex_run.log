+    ),
+    "hardness_basis": (
+        "Track A: Theorem 20 proves strong NP-completeness through 3-PARTITION; "
+        "the shipping regime uses shuffled planted cores with 48 target triples, "
+        "T=n^2 and values strictly between T/4 and T/2, conditioned to defeat "
+        "the domain-standard MRV exact-cover search for 50,000 nodes on every "
+        "generated instance."
+    ),
+    "max_answer_tokens": 152,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
