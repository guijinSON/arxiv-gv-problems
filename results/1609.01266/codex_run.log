+
+    attack_names = (
+        "outlier_value_bands",
+        "greedy_largest_exact_pair",
+        "random_restart_exact_triples",
+        "algorithm_x_mrv_exact_cover",
+    )
+    attacks = {
+        name: {
+            "successes": 0,
+            "attempts": 0,
+            "operations": 0,
+            "nodes": 0,
