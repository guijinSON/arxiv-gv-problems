+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An unordered partition of the 3n item-column indices into exactly n "
+        "unordered triples; n<=85, every index is an integer in [0,5n), and "
+        "every item index occurs exactly once."
