import random, time

def gen(n,seed,fac=4):
 r=random.Random(seed); T=fac*n*n
 vals=[]; plant=[]
 lo=T//4+1; hi=T//2-1
 for g in range(n):
  while 1:
   a=r.randint(lo,hi); b=r.randint(lo,hi); c=T-a-b
   if lo<=c<=hi: break
  plant.append((len(vals),len(vals)+1,len(vals)+2)); vals += [a,b,c]
 perm=list(range(3*n)); r.shuffle(perm); nv=[vals[i] for i in perm]; pos={old:j for j,old in enumerate(perm)}
 return nv,T,[tuple(pos[x] for x in tr) for tr in plant]

def triples(vals,T):
 n=len(vals); by={}
 for i,x in enumerate(vals): by.setdefault(x,[]).append(i)
 out=set()
 for i in range(n):
  for j in range(i+1,n):
   for k in by.get(T-vals[i]-vals[j],[]):
    if k>j: out.add((i,j,k))
 return sorted(out)

def solve(vals,T,cap=200000):
 ts=triples(vals,T); inc=[[] for _ in vals]
 for z,t in enumerate(ts):
  for v in t: inc[v].append(z)
 covered=[False]*len(vals); nodes=0
 def dfs(depth):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  if depth*3==len(vals):return []
  v=min((i for i in range(len(vals)) if not covered[i]),key=lambda i:sum(not any(covered[x] for x in ts[z]) for z in inc[i]))
  opts=[z for z in inc[v] if not any(covered[x] for x in ts[z])]
  for z in opts:
