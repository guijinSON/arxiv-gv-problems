   914	
   915	\section{Further lemmas}\label{sec_4}
   916	
   917	In this section we will give the results that are needed in the classification.
   918	
   919	
   920	\subsection{The zeroes of $x^{q+1}+x+b$}
   921	
   922	Now we are going to restrict ourselves to a specific type of $q$-projective polynomials, namely
   923	\[
   924	P_b(x) = x^{q+1} + x + b,
   925	\]
   926	for $b \in \LL$. Bluher studied these polynomials \cite{Bluher} and determined 
   927	the cardinalities of the sets 
   928	\begin{align*}
   929	I_j = \{ b \in \LL \ : \ P_b \in \Pi_j \},
   930	\end{align*}
   931	where $j \in \{0,1,2,p^\delta+1\}$. In this section we are interested only in the $p=2$ 
   932	case and $\Gcd(k,l)=1$ where $\LL = \f{2^l}$ and $q = 2^k$. In the definitions of $I_j$
   933	and $P_b$ (along with previously defined sets) we suppress $q$ and $\LL$ for notational simplicity.
   934	
   935	The following is an important result on combinatorics of finite fields proved by 
   936	Dillon and Dobbertin \cite{DD}.
   937	
   938	\begin{lemma}\label{lem_dd}
   939	Let $q = 2^k$ and $\Gcd(k,l) = 1$.
   940	The set $I_1$ is a
   941	\begin{enumerate} 
   942	\item $(2^l-1,2^{l-1}-1,2^{l-2}-1)$-difference set in $\LLx$ if $l$ is odd, and
   943	\item $(2^l-1,2^{l-1},2^{l-2})$-difference set in $\LLx$ if $l$ is even.
   944	\end{enumerate}
   945	\end{lemma}
   946	\begin{proof}
   947	Let $d = 4^k - 2^k +1$ and
   948	\[
   949	\Delta = \left\{
   950	\begin{array}{ll}
   951	               \{ x^d + (x+1)^d + 1 : x \in \LL \setminus \f{2} \} & \textrm{if $l$ is odd, and}\\
   952	\LLx \setminus \{ x^d + (x+1)^d + 1 : x \in \LL \setminus \f{2} \} & \textrm{if $l$ is even}.
   953	\end{array}
   954	\right.
   955	\]
   956	Dillon and Dobbertin showed \cite[Theorem A]{DD} that $\Delta$ is a difference set with indicated
   957	(Singer) parameters.
   958	
   959	The fact that $I_1 = 1 / \Delta$ was shown in \cite[Theorem 1]{HK1} (see also \cite[Theorem 5.13]{FG22FFA}). 
   960	\end{proof}
   961	
   962	In the next lemma we show that, since $\Gcd(2^k-1.2^l-1) = 2^{\Gcd(k,l)}-1=1$,
   963	we can easily determine the sets $I_1,I_2$ and $I_3$. The map $\rho$ appears quite 
   964	frequently when one works with projective polynomials, for instance, in Serre's
   965	proof that $\PSL(2,q)$ is the Galois group of the equation $x^{q+1} - xy + 1 = 0$
   966	for arbitrary prime power $q$ (see \cite[pp. 131--132]{Abhyankar92}). 
   967	The lemma can be found for general $\Gcd(k,l)$ and $q = 2^k$ in \cite[pp. 175--176]{HK1}. 
   968	We provide a simple proof for $\Gcd(k,l) = 1$ again in characteristic $2$.
   969	
   970	\begin{lemma}\label{lem_imageset}
   971	Let $q = 2^k$, $\Gcd(k,l) = 1$ and
   972	\begin{align*}
   973		\rho : \LL \setminus \f{2} &\to \LL \setminus \f{2},\\
   974						                x  &\mapsto \frac{x^{q^2+1}}{(x^q+x)^{q+1}}.
   975	\end{align*}
   976	We have
   977	\begin{enumerate}
   978	\item $\lms \rho(x) \ : \ x \in \Hbar \setminus \f{2} \rms = I_1$,
   979	\item $\lms \rho(x) \ : \ x \in \HH   \setminus \f{2} \rms = I_3^{[3]}$,
   980	\item $I_2 = \{0\}$,
   981	\item $\lms x^{q+1} + x \ : \ x \in \LL \rms = I_1 \cup I_2^{[2]} \cup I_3^{[3]}$.
   982	\end{enumerate}
   983	\end{lemma}
   984	\begin{proof}
   985	Let $b \in I_1 \cup I_2 \cup I_3$ and $f = P_b = x^{q+1}+x+b$. Let $r \in \LL$ be
   986	a root of $f$. Then
   987	\begin{align*}
   988	f(x+r) &= (x+r)^{q+1} + x + r + b\\
   989	       &= x^{q+1} + rx^q + (r+1)^qx + r^{q+1}+r+b \\
   990	       &= x^{q+1} + rx^q + (r+1)^qx\\
   991		   &\Peq (r+1)^qx^q + rx + 1 = f''(x)
   992	\end{align*}
   993	Then $|Z_f| = 2$ if and only if $|Z_{f''}|=1$ if and only if $r \in \f{2}$. Thus $b = 0$ and Part 
   994	(iii) follows. Otherwise we have $A \in \LLx$ such that 
   995	\[
   996	A^{q-1} = \frac{r}{(r+1)^q},
   997	\]
   998	since $x \mapsto x^{q-1}$ is bijective on $\LL$ by Lemma \ref{lem_gcd}. We have 
   999	$f \in \Pi_1$ if and only if $\trace{1/Ar} = 1$ and 
  1000	$f \in \Pi_3$ if and only if $\trace{1/Ar} = 0$ by Hilbert's Theorem 90.
  1001	Now, 
  1002	let $h \in \LLx$ satisfy
  1003	\[
  1004	\frac{1}{Ar} = h^q,
  1005	\]
  1006	That is to say
  1007	\[
  1008	\frac{1}{A} = h^qr \iff \frac{1}{A^{q-1}} = h^{q(q-1)}r^{q-1} = \frac{(r+1)^q}{r}.
  1009	\]
  1010	Thus, recalling $r \not\in \f{2}$,
  1011	\[
  1012	h^{q-1} = \frac{r+1}{r} = 1 + \frac{1}{r}.
  1013	\]
  1014	Therefore for each $r \in \LL \setminus \f{2}$, there is unique $h \in \LL \setminus \f{2}$,
  1015	where $h \in \HH \setminus \f{2}$   if and only if $f \in \Pi_3$
  1016	and   $h \in \Hbar \setminus \f{2}$ if and only if $f \in \Pi_1$.
  1017	Or, equivalently
  1018	\[
  1019	r = \frac{h}{h+h^q}.
  1020	\]
  1021	The remaining  Parts (i), (ii), (iv) follow after observing
  1022	\[
  1023	b = r^{q+1} + r = \left(\frac{h}{h+h^q}\right)^{q+1} + \frac{h}{h+h^q} 
  1024	= \frac{h^{q+1}+h(h^q+h)^q}{(h^q+h)^{q+1}} = \frac{h^{q^2+1}}{(h^q+h)^{q+1}}.
  1025	\]
  1026	\end{proof}
  1027	
  1028	The following lemma is key to our classification. It will prove 
  1029	that the Kim function $\kappa$ exists as a \textit{theorem of small cases},
  1030	using the properties of Dillon-Dobbertin difference sets with Singer parameters.
  1031	
  1032	\begin{lemma}\label{lem_multiset}
  1033	Let $l > 3$, $q = 2^k$ and $\Gcd(k,l)=1$. For all 
  1034	\begin{itemize}
  1035	\item $d \in \LLx$ if $l$ is odd, and
  1036	\item $d \in \LLx \setminus (\LLx)^{q+1}$ if $l$ is even, we have
  1037	\end{itemize}
  1038	\[
  1039		d I_3 \cap (I_1 \cup I_2 \cup I_3) \ne \emptyset.
  1040	\]
  1041	\end{lemma}
  1042	\begin{proof}
  1043	By Lemma \ref{lem_imageset} (iii), $I_2 = \{0\}$ and therefore $dI_3 \cap I_2 = \emptyset$.
  1044	Also the $d = 1$ case is clear. 
  1045	Let
  1046	\[
  1047	M = \frac{I_1 \cup I_3^{[3]}}{I_3^{[3]}}.
  1048	\]
  1049	The claim of the lemma is equivalent to the claim that for all $d \in \LL \setminus \f{2}$,
  1050	\[
  1051	\mult_{M}(d) > 0.
  1052	\]
  1053	We have
  1054	\[
  1055	M = \frac{I_1}{I_3^{[3]}} \cup \frac{I_3^{[3]}}{I_3^{[3]}},
  1056	\]
  1057	and
  1058	\[
  1059	J = \frac{I_1 \cup I_3^{[3]}}{I_1 \cup I_3^{[3]}} = M \cup \frac{I_1}{I_1} \cup \frac{I_3^{[3]}}{I_1}.
  1060	\]
  1061	It is clear by Lemma \ref{lem_imageset} (iii) and (iv) that
  1062	\[
  1063	I_1 \cup I_3^{[3]} = \lms x^{q+1} + x \ : \ x \in \LL \setminus \f{2} \rms.
  1064	\]
  1065	For $x,y,d \in \LL \setminus \f{2}$, we will find the number of solutions of
  1066	\[
  1067		\frac{x^{q+1} + x}{y^{q+1} + y} = d,
  1068	\]
  1069	which is (for $y,d \in \LL \setminus \f{2}$ and $x \in \LLx \setminus \{1/y\}$) 
  1070	the same as the number of solutions of
  1071	\[
  1072		\frac{(xy)^{q+1} + xy}{y^{q+1} + y} = \frac{x^{q+1}y^q + x}{y^{q} + 1} = d.
  1073	\]
  1074	Or, equivalently
  1075	\[
  1076		y^q(x^{q+1}+d) = (x+d).
  1077	\]
  1078	For all $x \in \LL \setminus \f{2}$ such that $x^{q+1}\ne d$ or $x \ne d$,
  1079	there exists a (unique) $y \in  \LL \setminus \f{2}$. The equality holds when 
  1080	$x = 1/y$ if and only if $y^q d = d$, that is to say $x = y = 1$.
  1081	
  1082	Thus
  1083	\[
  1084	\mult_{J}(d) = \left\{
  1085	\begin{array}{ll}
  1086	2^l - 4 & \textrm{if $l$ is odd}, \\
  1087	2^l - 6 & \textrm{if $l$ is even and $d \in (\LLx)^{q+1}$},\\
  1088	2^l - 3 & \textrm{if $l$ is even and $d \in \LLx \setminus (\LLx)^{q+1}$},
  1089	\end{array}
  1090	\right.
  1091	\]
  1092	since $\Gcd(2^k+1,2^l-1) = 3$ if $l$ is even and $1$ if $l$ is odd.
  1093	Since $I_1$ is a difference set with Singer parameters, we have by Lemma \ref{lem_dd}
  1094	\[
  1095	\mult_{I_1/I_1}(d) = \left\{
  1096	\begin{array}{ll}
  1097	2^{l-2}-1 & \textrm{if $l$ is odd}, \\
  1098	2^{l-2}   & \textrm{if $l$ is even}.
  1099	\end{array}
  1100	\right.
  1101	\]
  1102	Since for all $i \in I_3$ we have at most one $j \in I_1$ since $I_1$ is a set
  1103	by Lemma \ref{lem_imageset} (i), we have the trivial bound $\mult_{I_3^{[3]}/I_1}(d) \le |I_3^{[3]}|$.
  1104	By Lemma \ref{lem_imageset} (ii), we have,
  1105	\[
  1106	\mult_{I_3^{[3]}/I_1}(d) \le \left\{
  1107	\begin{array}{ll}
  1108	2^{l-1}-1 & \textrm{if $l$ is odd}, \\
  1109	2^{l-1}-2 & \textrm{if $l$ is even}.
  1110	\end{array}
  1111	\right.
  1112	\]
  1113	
  1114	Note that by the definition of $J$, we must have,
  1115	\[
  1116	\mult_J(d) = \mult_M(d) + \mult_{I_1/I_1}(d) + \mult_{I_3^{[3]}/I_1}(d).
  1117	\]
  1118	Now assume $\mult_{M}(d) = 0$. If $l$ is odd, this means
  1119	\begin{align*}
  1120	2^l - 4 &\le 0 + 2^{l-2}-1 + 2^{l-1}-1,\\
  1121	2^{l-2} &\le 2,
  1122	\end{align*}
  1123	which means $l \le 3$. Similarly for $l$ is even and $d \in \LLx \setminus (\LLx)^{q+1}$,
  1124	\begin{align*}
  1125	2^l - 3 &\le 0 + 2^{l-2} + 2^{l-1}-2,\\
  1126	2^{l-2} &\le 1,
  1127	\end{align*}
  1128	which means $l \le 2$. 
  1129	
  1130	The claim also holds for $d \in (\LLx)^{q+1}$ similarly but skipped 
  1131	since it will not be used and requires computerized check for $l = 4$.
  1132	\end{proof}
  1133	
  1134	\subsection{Results on fractional projective permutations of $\PLL$}
  1135	
  1136	Given two $q$-projective polynomials $f(x,1),g(x,1)$ over $\LL$, 
  1137	we can define a fractional projective map $x \mapsto f(x,1)/g(x,1)$
  1138	on $\ProjectiveLine(\LL)$ whenever $f$ and $g$ do not have a common zero.
  1139	Fractional projective permutations over a finite field $\LL$ 
  1140	of order $p^l$ has been classified for every parameter $p,k,l$ \cite{FG22FFA}. 
  1141	Recall the specific Dembowski-Ostrom polynomials of type \eqref{eq_do}.
  1142	The monomial Gold maps $X \mapsto X^s$ where 
  1143	$s \in \{ q+1,(q+1)r,qr+1,q+r \}$ on $\f{p^{2l}}$ 
  1144	with $q = p^k$ and $r = p^l$ have been shown to be connected to
  1145	the fractional projective permutations. Identifying
  1146	$\f{p^{2l}} = \LL(\xi) = \LL\xi + \LL \cong \LL \times \LL$, the
  1147	above Gold maps can be written as $(q,q)$-biprojective
  1148	polynomials $G_s(x,y) = (f_s(x,y),g_s(x,y))$ using $X = x\xi+y$.
  1149	
  1150	The following lemma has been proved for general parameters in \cite{FG22FFA}.
  1151	Here we include only the results necessary for our treatment.
  1152	
  1153	\begin{lemma}\label{lem_fracproj}
  1154	Let $p = 2$, $q = p^k$, $r = p^l$ and $\Gcd(k,l) = 1$. 
  1155	\begin{itemize}
  1156	\item If $l$ is odd, then
  1157	\[
  1158		x \mapsto \frac{x^{q+1}+c}{x^q+x+d}
  1159	\]
  1160	permutes $\ProjectiveLine(\LL)$ if and only if $c \in \f{2}$ and $d = 1$.

