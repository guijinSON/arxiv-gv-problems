 succeeded in 0ms:
   360	D(X) = \sum_{0 \le i \ne j \le n-1} B_{ij} X^{2^i+2^j}.
   361	\]
   362	When $n = 2l$, a further subclass of DO polynomials is important. 
   363	The class of polynomials 
   364	\begin{equation}\label{eq_do}
   365	R(X) = A X^{q+1} + B X^{2^l(q+1)} + C X^{q + 2^l} + D X^{2^lq+1},
   366	\end{equation}
   367	where $q = 2^k$ with $0 < k < l$, satisfying the \textbf{subfield property},
   368	\[
   369		R(aX) = a^{q+1}R(X), \quad \textrm{ for all } a \in \f{2^l},
   370	\]
   371	contains (up to $\CCZ$-equivalence) the only known APN function 
   372	$\kappa$ that is $\CCZ$-equivalent to a
   373	permutation for even $n$ (we will describe various notions of 
   374	equivalences of vectorial Boolean functions further below). Let $\LL = \f{2^l}$.
   375	Identifying $\f{2^{2l}} = \LL(\xi) = \LL\xi + \LL \cong \LL \times \LL$,
   376	we can write the above class of functions 
   377	$
   378	X \mapsto R(X)
   379	$
   380	as
   381	$
   382		(x,y) \mapsto R(x,y)
   383	$
   384	with
   385	\begin{align*}
   386		R(x,y) &= ((a_0 x^{q+1} + b_0 x^qy + c_0 xy^q + d_0 y^{q+1}),
   387		          (a_1 x^{q+1} + b_1 x^qy + c_1 xy^q + d_1 y^{q+1})) \\
   388					 &= (f(x,y),g(x,y))
   389	\end{align*}
   390	where $X = (x\xi + y)$. This motivates the following definition.
   391	
   392	\begin{definition}
   393	Let $q = 2^k$ with $0 < k < l$.
   394	\begin{itemize}
   395	\item
   396	Let $f \in \LL[x,y]$ be a polynomial of the form
   397	\[
   398		f(x,y) = a_0 x^{q+1} + b_0 x^qy + c_0 xy^q + d_0 y^{q+1}.
   399	\]
   400	Then $f$ is called a \textbf{$q$-biprojective polynomial}.
   401	
   402	\item
   403	Let $R : \LL \times \LL \to \LL \times \LL$ be a function of the form
   404	\[
   405	R : (x,y) \mapsto R(x,y) = (f(x,y),g(x,y))
   406	\]
   407	where $f$ and $g$ are $q$-biprojective polynomials. Then $R$ is called a
   408	\textbf{$(q,q)$-biprojective function}.
   409	\end{itemize}
   410	\end{definition}
   411	
   412	We will use the shorthand notation 
   413	\[
   414	f =  (a_0,b_0,c_0,d_0)_q,
   415	\]
   416	and
   417	\[
   418	R = ((a_0,b_0,c_0,d_0)_q,(a_1,b_1,c_1,d_1)_q) = (f,g).
   419	\]
   420	
   421	
   422	The subfield property can be recognized in this form. For a $(q,q)$-biprojective map $F = (f,g)$, one has 
   423	\[
   424		(f(cx,cy),g(cx,cy)) = c^{q+1}(f(x),g(y)), \quad \textrm{ for all } c,x,y \in \LL. 
   425	\]
   426	
   427	\begin{remark}
   428	One can generalize the concept to 
   429	\textbf{$(q,q')$-biprojective functions}
   430	\[
   431	F : (x,y) \mapsto F(x,y) = ((a_0,b_0,c_0,d_0)_q, (a_1,b_1,c_1,d_1)_{q'}),
   432	\]
   433	where $q' = 2^{k'}$ (here one allows $0 \le k,k' < l$). 
   434	These functions satisfy a modified form of the subfield property
   435	\[
   436		(f(cx,cy),g(cx,cy)) = (c^{q+1}f(x),c^{q'+1}g(y)), \quad \textrm{ for all } c,x,y \in \LL. 
   437	\]
   438	In this paper, we are only interested in $(q,q)$-biprojective functions. See \cite{FG22IEEE,GK21} 
   439	for more on $(q,q')$-biprojective APN functions and their constructions, equivalences and enumerations.
   440	
   441	\end{remark}
   442	
   443	Define
   444	\begin{align*}
   445	 \DE{f}{0}(x,y) &= b_0 x^q + c_0 x + d_0 y^q + d_0 y,\\
   446	 \DE{f}{\infty}(x,y) &= a_0 x^q + a_0 x + c_0 y^q + b_0 y,\\
   447	 \DE{f}{u}(x,y) &= (a_0 u + b_0) x^q + (a_0 u^q + c_0) x 
   448		 			         + (c_0 u + d_0) y^q + (b_0 u^q + d_0) y, 
   449	\end{align*}
   450	for $u \in \LLx$.
   451	The following lemma was proved in \cite{FG22IEEE}.
   452	
   453	\begin{lemma}\label{lem_cond}
   454	Let $F = (f,g)$ be a $(q,q')$-biprojective function. Then $F$ is APN if and only if 
   455	$
   456	\DE{f}{u}(x,y) = 0 = \DE{g}{u}(x,y)
   457	$
   458	has exactly two solutions for each $u \in \ProjectiveLine(\LL)$.
   459	\end{lemma}
   460	
