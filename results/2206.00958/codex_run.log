   617	
   618	\section{Actions of $\GL(2,\LL)$ and $\PGL(2,\LL)$}\label{sec_3}
   619	
   620	In this section we outline the basics of several actions of $\GL(2,\LL)$ and $\PGL(2,\LL)$
   621	on biprojective functions. Most of this section can be considered standard lore. 
   622	Let 
   623	\[
   624	\Vset = \{ (a,b,c,d)_q \ : \ a,b,c,d \in \LL \}, 
   625	\]
   626	be the set of all $q$-biprojective polynomials. 
   627	Let $f, g \in \Vset$ be two $q$-biprojective polynomials and 
   628	\begin{align*}
   629	F : \LL \times \LL &\to \LL \times \LL\\
   630	            (x,y)  &\mapsto (f(x,y),g(x,y))
   631	\end{align*}
   632	be the associated $(q,q)$-biprojective function.
   633	Define $\Fset$ to be the set of all $(q,q)$-biprojective functions, i.e.,
   634	\[
   635	\Fset = \Vset \times \Vset.
   636	\]
   637	Let $\LLinear(\LL)$ be the group of all nonsingular $\LL$-linear transformations of $\LL\times \LL$, i.e.,
   638	\[
   639	\GL(2,\LL) \cong \LLinear(\LL) = \left\{ (x,y) \mapsto (tx+uy,vx+wy) \ : \ t,u,v,w \in \LL \ | \ tw - uv \ne 0 \right\}.
   640	\]
   641	We are mainly interested in the standard action of $\GL(2,\LL) \times \GL(2,\LL)$ on
   642	$(q,q)$-biprojective functions $F \in \Fset$. That is
   643	\[
   644	F'(x,y) = L_1 \circ F \circ L_2(x,y).
   645	\]
   646	This action defines an equivalence relation which we denote by
   647	$F' \GLEQ F.$
   648	Define also the action of the group $\LLx \times \GL(2,\LL)$ on $q$-biprojective polynomials $f \in \Vset$ 
   649	where $\LLx < \GL(2,\LL)$ acts on $f$ by \textbf{scaling}, and the action of $\GL(2,\LL)$ is the usual
   650	right action, i.e.,
   651	\begin{align*}
   652	f'(x,y) &= \alpha ( f \circ L(x,y) ),\\
   653	        &= \alpha \left( a (tx+uy)^{q+1} + b (tx+uy)^q (vx+wy) + c(tx+uy) (vx+wy)^q + d (vx+wy)^{q+1} \right),
   654	\end{align*}
   655	where $(\alpha,L) \in \LLx \times \GL(2,\LL)$. In this case we say that $f \Leq f'$.
   656	
   657	Set $\phi_f(x) = f(x,1)$. A polynomial $\phi_f \in \LL[x]$ for $f \in \Vset$ is
   658	called a \textbf{$q$-projective polynomial}.
   659	%and the corresponding function $\phi_f : \LL \to \LL$ a \textbf{$q$-projective function}.
   660	The projective version of the above action on the bivariate $q$-projective polynomial $f$, 
   661	on the univariate $q$-projective polynomial $\phi_f$ can be given using the 
   662	\textbf{fractional linear (M\"obius) transformations} over the finite field $\LL$, i.e.,
   663	\[
   664	\PGL(2,\LL) \cong \Mobius(\LL) = \left\{ x \mapsto \frac{tx+u}{vx+w} \ : \ t,u,v,w \in \LL \ | \ tw - uv \ne 0 \right\}.
   665	\]
   666	Now, define the action
   667	\begin{equation}\label{eq_action1}
   668	\phi_{f'}(x) = \alpha (vx+w)^{q+1} (\phi_f \circ \mu(x)),
   669	\end{equation}
   670	for $(\alpha,\mu) \in \LLx \times \PGL(2,\LL)$ and 
   671	$
   672	\mu : x \mapsto
   673	\frac{tx+u}{vx+w}.
   674	$ 
   675	One addresses the zero of the denomiator $(vx+w)$ by introducing $\infty = \beta/0$ 
   676	for all $\beta \in \LLx$. We define $\ProjectiveLine(\LL) = \LL \cup \{\infty\}$. 
   677	By defining  $\mu(\infty)=t/v$, we see that all $\mu \in \Mobius(\LL)$ permutes 
   678	$\ProjectiveLine(\LL)$. Note that we view the action as
   679	\begin{equation}\label{eq_action2}
   680	\phi_{f'}(x) = \alpha \left( a (tx+u)^{q+1} + b (tx+u)^q (vx+w) + c(tx+u) (vx+w)^q + d (vx+w)^{q+1} \right),
   681	\end{equation}
   682	so that $\phi_{f'}$ is a ($q$-projective) polynomial over $\LL[x]$ and we do not have to deal with $\infty$ (but we will do that later, since it is helpful). We write $\phi_f \Peq \phi_{f'}$. The following lemma is straightforward.
   683	
   684	\begin{lemma}\label{lem_unibi}
   685	We have 
   686	$
   687		f \Leq f' \textrm{ if and only if } \phi_f \Peq \phi_{f'}.
   688	$
   689	\end{lemma}
   690	We will not use $\phi_f$ to refer to univariate $q$-projective version of $f$ and
   691	instead use $f$ for both univariate and bivariate functions and polynomials. 
   692	We will also use $\Vset$ as the ambient space of both types of functions/polynomials.
   693	
   694	Our aim is to classify the APN functions in $\Fset$ under the equivalence $\GLEQ$. 
   695	We say that $\Sset \subseteq \Vset$ is a {\bf representative set} of $\Vset$
   696	if (denoting by $[f]_\sim$ the equivalence class of $f$ under $\sim$)
   697	\[
   698	[\Sset]_\Peq = \bigcup_{f \in \Sset} [f]_\Peq = \Vset.
   699	\]
   700	
   701	In the following we will find a representative set $\Sset$ using univariate 
   702	$q$-projective polynomials and their equivalence $\Peq$. Then it will be clear that checking
   703	\[
   704	(f,g) \in \Sset \times \Vset
   705	\]
   706	is enough for our classification under $\GLEQ$ since $f \Peq f'$ if and only if $f \Leq f'$
   707	and if $F = (f,g) \in \Vset \times \Vset$ then 
   708	$F \GLEQ F' = (f',g') \in \Sset \times \Vset$ for some $f',g'$ using the 
   709	$\LL$-linear transformation implied by the equivalence $f \Leq f'$.
   710	
   711	\subsection{Roots of projective polynomials}
   712	
   713	Let $q = p^k$, $\DD = \f{p^\delta}$, $\LL = \f{p^l}$ where $\delta = \Gcd(k,l)$ and
   714	\[
   715	f(x) = ax^{q+1} + bx^q + cx + d
   716	\]
   717	be a nonzero $q$-projective polynomial. 
   718	If $a = 0$, then $f$ is an affine polynomial and the set of zeroes of $f$ in $\LL$, i.e.,
   719	\[
   720	Z'_f = \{ x \in \LL \ : \ f(x) = 0\}
   721	\]
   722	satisfies $|Z'_f| \in \{ 0, 1, p^\delta$\}. To see that, first 
   723	observe that 
   724	\textbf{scaling}, i.e., $f \mapsto \alpha f$ for $\alpha \in \LLx$,
   725	the \textbf{translations} $f(x) \mapsto f(x + \beta)$ for $\beta \in \LL$ and 
   726	the \textbf{dilations}    $f(x) \mapsto f(\gamma x)$ for $\gamma \in \LLx$ 
   727	keep the number of zeroes of $f$ in $\LL$ invariant. Then we have only 
   728	a few options to consider:
   729	\begin{itemize}
   730	\item $f = 1$ 
   731	
   732	has no $\LL$-zeroes ---degenerate case (together with omitted $f = 0$).
   733	\item $f \in \{x,x^q\}$
   734	
   735	has one $\LL$-zero.
   736	\item $f = x^q-cx-d$ where $c \ne 0$. 
   737	
   738	We have 
   739	\begin{itemize}
   740	\item if $c = A^{q-1} \in (\LLx)^{q-1}$, then $f$ has 
   741	\begin{itemize}
   742	\item $p^\delta$ $\LL$-zeroes if $\tr{\LL/\DD}{d/A^q} = 0$, and 
   743	\item no $\LL$-zeroes if $\tr{\LL/\DD}{d/A^q} \ne 0$; or
   744	\end{itemize}
   745	\item one $\LL$-zero if $c \not\in (\LLx)^{q-1}$,
   746	\end{itemize}
   747	by Hilbert's Theorem 90.
   748	\end{itemize}
   749	Now assume $a \ne 0$. We will show that
   750	$|Z'_f| \in \{ 0, 1, 2, p^\delta + 1\}.$
   751	Assume $f$ has at least one $\LL$-zero $r \in Z'_f$. Now consider
   752	\[
   753	f'(x) = f(x+r) = ax^{q+1}+b'x^q+c'x.
   754	\]
   755	The \textbf{reciprocal} $f''(x) = x^{q+1}f'(1/x)$ is
   756	\[
   757	f''(x) = a+b'x+c'x^q,
   758	\]
   759	where $\deg f'' < q+1$. Now $f''$ has one fewer $\LL$-zeroes than $f'$ 
   760	(since we \textit{punctured} the zero of $f'$ at $0$) and thus we have

exec
/bin/bash -lc "curl -L --fail --silent --show-error https://arxiv.org/e-print/2206.00958 | tar -xzO biproj_arxiv.tex | nl -ba | sed -n '760,1160p'" in /home/gson/gvrepo/results/2206.00958
 succeeded in 0ms:
   760	(since we \textit{punctured} the zero of $f'$ at $0$) and thus we have
   761	\[
   762	|Z'_{f''}|+1 = |Z'_{f'}| = |Z'_f| \in \{ 0, 1, 2, p^\delta + 1\}.
   763	\]
   764	
   765	This observation, together with the fact that $\PGL(2,\LL)$ is generated by translations, dilations 
   766	and inversions (for which the corresponding action is reciprocation), 
   767	motivates us to ascribe $f(\infty) = 0$ if and only if $\deg f < q+1$ so that $\Peq$ 
   768	preserves the number of roots in $\ProjectiveLine(\LL)$.
   769	Now we can define 
   770	\begin{definition}
   771	The \textbf{$\PLL$-zeroes} of a $q$-projective polynomial $f$ is defined as
   772	\[
   773	Z_f = \{ x \in \ProjectiveLine(\LL) \ : \ f(x) = 0\},
   774	\]
   775	where we define $f(\infty) = 0$ if and only if $\deg f < q+1$.
   776	\end{definition}
   777	
   778	Thus we have
   779	\begin{lemma}\label{lem_zeroes}
   780	Let $f \ne 0$ be a $q$-projective polynomial. Then, 
   781	\begin{enumerate}
   782	\item $|Z_f|$ is invariant under $\Peq$, and 
   783	\item $|Z_f| \in \{ 0, 1, 2, p^\delta + 1\}$.
   784	\end{enumerate}
   785	\end{lemma}
   786	\begin{proof}
   787	Part (ii) is explained before the lemma. We will give a more detailed 
   788	proof of Part (i) which, actually, also follows from the previous discussion.
   789	
   790	Let $f' \Peq f$ via $(\alpha,\mu) \in \LLx \times \PGL(2,\LL)$ with
   791	$\mu : x \mapsto \frac{tx+u}{vx+w}.$ Suppose $v \ne 0$.
   792	Define $T = \LL \setminus \{ w/v \}$,
   793	which satisfies $\mu(T) = \LL \setminus \{t/v\}$. 
   794	We see by \eqref{eq_action1} that 
   795	\[
   796	x \in T \textrm{ is a zero of $f'$ } \iff \mu(x) \textrm{ is a zero of } f.
   797	\]
   798	By \eqref{eq_action2}, we get $a = 0$ if and only if
   799	\[
   800	w/v = \mu^{-1}(\infty) \textrm{ is a zero of $f'$ } \iff  \infty \textrm{ is a zero of } f
   801	\]
   802	if and only if $\deg f < q+1$. Also by \eqref{eq_action2}, since the coefficient of 
   803	the $x^{q+1}$ term of $f'$ is $a t^{q+1} + b t^qv + ctv^q + d v^{q+1} = v^{q+1}f(t/v)$,
   804	we have
   805	\[
   806	t/v = \mu(\infty)      \textrm{ is a zero of $f$ } \iff \infty \textrm{ is a zero of } f'
   807	\]
   808	if and only if $\deg f' < q+1$.  Combining the three cases we get $\mu(Z_{f'}) = Z_f$ and $|Z_f| = |Z_{f'}|$.
   809	These facts also trivially follow when $v = 0$.
   810	\end{proof}
   811	
   812	Define the sets (suppressing $q$ and $\LL$ from the notation for simplicity),
   813	\begin{align*}
   814	D_0 &= \left\{ (0,0,0,0)_q \right\}, \\
   815	D_1 &= \left[ (0,0,0,1)_q \right]_\Peq, \\
   816	D   &= D_0 \cup D_1,\\
   817	\Pi_j &= \left\{ f \in \Vset \setminus D \ : \ |Z_f| = j \right\}, 
   818	\end{align*}
   819	for $j \in \{ 0, 1, 2, p^\delta + 1\}$. 
   820	
   821	\begin{lemma}\label{lem_13}
   822	We have
   823	\begin{enumerate}
   824	\item $\Vset = \bigcup_{j \in \{0, 1, 2, p^\delta + 1\}} \Pi_j \cup D$ ,
   825	\item $\Pi_1 = [ (0,1,-1,-u)_q ]_\Peq$ where $u \in \LL$ satisfies $\tr{\LL/\DD}{u}=1$,
   826	\item $\Pi_{{p^\delta+1}} = [ (0,1,-1,0)_q ]_\Peq$, 
   827	\end{enumerate}
   828	\end{lemma}
   829	\begin{proof}
   830	The proof of Part (i) follows from the discussion before the lemma. For Parts (ii) and (iii), we have to 
   831	show that the action is transitive on the sets $\Pi_1$ and $\Pi_{p^\delta+1}$. If $a \ne 0$, as in the
   832	discussion before the lemma, using $f'(x) = f(x+r)$ first, where $r$ is an $\LL$-zero of $f$, 
   833	and then using the reciprocal $f''(x) = x^{q+1}f'(1/x)$, one shows that $f \Peq f''$ with 
   834	$\deg f'' < q+1$. Now in both $p^\delta+1$ and one $\PLL$-root cases, $f''$ has the form
   835	\[
   836	f''(x) = a+b'x+c'x^q,
   837	\]
   838	with $-b'/c' = A^{q-1}$ for some $A \in \LLx$. One can apply $x \mapsto xA$ and then scale 
   839	to get $f'' \Peq x^q - x - d$ for some $d \in \LL$,
   840	where $f$ has $p^\delta+1$ $\PLL$-roots if and only if $\tr{\LL/\DD}{d} = 0$ and 
   841	$f$ has one $\PLL$-root if and only if $\tr{\LL/\DD}{d} \ne 0$ by Hilbert's Theorem 90, and
   842	the action is transitive on $\Pi_{p^\delta+1}$ since any $d$ with $\tr{\LL/\DD}{d} = 0$ can be written
   843	as $z^q - z = d$ for some $z \in \LL$ and $f \Peq x^q - x$ after the application of $x \mapsto x+z$. 
   844	
   845	For the case $\tr{\LL/\DD}{d} \ne 0$,
   846	applying $x \mapsto \epsilon x$ where $\epsilon \in \DDx$, and scaling by $1/\epsilon$, one can 
   847	assume $\tr{\LL/\DD}{d} = 1$. Then the transitivity of the action follows again by translations.
   848	\end{proof}
   849	
   850	
   851	When $\Gcd(p^k-1,p^l-1) = 1$, that is to say $\Gcd(k.l)=1$ and $p = 2$ by 
   852	Lemma \ref{lem_gcd}, we can say more.
   853	
   854	\begin{lemma}\label{lem_0123}
   855	Let $p = 2, q = 2^k$, and $\delta = \Gcd(k,l) = 1$, then we have
   856	\begin{enumerate}
   857	\item $\Pi_0 = [ g ]_\Peq$, where $g \in \Pi_0$,
   858	\item $\Pi_2 = [ (0,0,1,0)_q ]_\Peq$. 
   859	\item If $l$ is odd, then
   860	\begin{enumerate}
   861	\item $\Pi_1 = [ (1,0,0,1)_q ]_\Peq$.
   862	\end{enumerate}
   863	\item If $l$ is even, then
   864	\begin{enumerate}
   865	\item $\Pi_0 = [ (1,0,0,u)_q ]_\Peq$, where $u \in \LLx \setminus (\LLx)^{q+1}$,
   866	\item $\Pi_3 = [ (1,0,0,1)_q ]_\Peq$.
   867	\end{enumerate}
   868	\end{enumerate}
   869	\end{lemma}
   870	\begin{proof}
   871	\begin{enumerate}
   872	\item This was proved in
   873	\begin{itemize}
   874	\item \cite[Theorem 2.1]{BTT} when $l$ is even, and
   875	\item \cite[Lemma 7]{GK21} for general $l$.
   876	\end{itemize}
   877	\item Since $\Gcd(2^k-1,2^l-1) = 2^{\Gcd(k,m)}-1 = 1$ by Lemma \ref{lem_gcd}, the only
   878	option (under translations and dilations) when $a=0$ is $f \in \{x,x^q\}$ by the discussion preceding the lemma. 
   879	Note that $x^{q+1}(1/x^q) = x$, hence they are reciprocals of each other. 
   880	If $a = 1$, then using a translation and reciprocation, one gets $f \Peq f''$ where
   881	$\deg f'' < q+1$. Therefore the action is transitive.
   882	\item This is basically Lemma \ref{lem_13} (ii) and the fact that 
   883	$x^{q+1} + u$ has one root for all $u \in \LLx$ by Lemma \ref{lem_gcd}.
   884	\item These follow from Lemma \ref{lem_13} (iii) and Part (i) of this lemma
   885	together with the fact that $x^{q+1}+u$ has either three or no roots
   886	for the given conditions on $u \in \LLx$ by Lemma \ref{lem_gcd}.
   887	\end{enumerate}
   888	\end{proof}
   889	
   890	We can now state the representative set $\Sset$ we will use.
   891	\begin{lemma}\label{lem_sset}
   892	Let $p = 2, q = 2^k$, $\delta = \Gcd(k,l) = 1$, and
   893	\[
   894	S = \{ (0,0,0,0)_q, (0,0,0,1)_q, (0,0,1,0)_q \} \cup  
   895	    \{ (1,0,0,a)_q \ : \  a \in \LLx \}.
   896	\]
   897	\begin{enumerate}
   898	\item If $l$ is odd then
   899	\[
   900	\Sset = S \cup \{ (0,1,1,0)_q \} \cup \Pi_0.
   901	\]
   902	\item If $l$ is even then
   903	\[
   904	\Sset = S \cup \Pi_1.
   905	\]
   906	\end{enumerate}
   907	Then $\Sset$ is a representative set for $\Vset$.
   908	\end{lemma}
