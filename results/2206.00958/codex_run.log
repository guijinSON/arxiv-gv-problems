+    # even weight also makes the unavoidable v <-> v+1 ambiguity harmless.
+    u = _sample_dense_mask(rng, n, even=True)
+    while u == canonical_rhs:
+        u = _sample_dense_mask(rng, n, even=True)
+    while True:
