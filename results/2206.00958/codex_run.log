  1179	\section{The classification}\label{sec_5}
  1180	
  1181	First we will prove a necessary $\Gcd$-condition on a $(q,q)$-biprojective
  1182	APN function $F$.
  1183	
  1184	\begin{proposition}\label{prop_gcd}
  1185	Let $q = 2^k$ and $\Gcd(k,l)>1$. Then $F \in \Fset$ is not APN.   
  1186	\end{proposition}
  1187	\begin{proof}
  1188	Let $F = (f,g) = ((a_0,b_0,c_0,d_0)_q,(a_1,b_1,c_1,d_1)_q)$.
  1189	By Lemma \ref{lem_cond}, if $F$ is APN, then 
  1190	\begin{align*}
  1191	b_1 x^q + c_1 x &= d_1(y^q + y),\\
  1192	b_0 x^q + c_0 x &= d_0(y^q + y),
  1193	\end{align*}
  1194	has two solutions in $\LL \times \LL$. Solutions to this equation pair include 
  1195	$(x,y) \in \{0\} \times \Ker(y^q+y)$. Thus $\Gcd(k,l)=1$. 
  1196	\end{proof}
  1197	
  1198	Now we can concentrate on the case $\Gcd(k,l)=1$. We can
  1199	assume $(f,g) \in \Sset \times \Vset$ where $\Sset$ is found
  1200	in Lemma \ref{lem_sset}. We will first deal with the case $f \in S$
  1201	(see Lemma \ref{lem_sset} for the definitions of $S$ and $\Sset$ we use).
  1202	
  1203	\subsection{The case $f \in S$}
  1204	
  1205	\begin{proposition}\label{prop_s}
  1206	Let $q = 2^k$, $l > 3$, $\Gcd(k,l) = 1$ and 
  1207	\begin{align*}
  1208	F : \LL \times \LL &\to \LL \times \LL,\\
  1209	            (x,y)  &\mapsto (f(x,y),g(x,y)),
  1210	\end{align*}
  1211	where $f \in S \subset \Sset$ and $g \in \Vset$. Then $F$ is not APN.
  1212	\end{proposition}
  1213	
  1214	\begin{proof}
  1215	We will analyze each function $f \in S$ case by case. 
  1216	We let $g = (a_1,b_1,c_1,d_1)_q$. 
  1217	\begin{itemize}
  1218	\item $f \in \{ (0,0,0,0)_q, (0,0,0,1)_q \}$.
  1219	
  1220	We have
  1221	$
  1222	 \DE{f}{\infty}(x,y) = 0
  1223	$
  1224	for all $(x,y)$ and $\DE{g}{\infty}(x,y) = 0$ if and only if
  1225	\[
  1226	a_1 x^q + a_1 x = c_1 y^q + b_1 y.
  1227	\]
  1228	If $a_1 = 0$ or $b_1 = c_1 = 0$, then the claim easily follows
  1229	since $(x,y) \in \LL \times \{0\}$ (or $\{0\} \times \LL$, resp.) satisfy the equality.
  1230	Otherwise $|\Image{a_1 x^q + a_1 x} \cap \Image{c_1 y^q + b_1 y}| \ge 2^{l-2}$,
  1231	since both image sets are at least $l-1$ dimensional $\f{2}$-vector spaces
  1232	which have to intersect at a vector space with dimension at least $l-2$.
  1233	
  1234	\item $f = (0,0,1,0)_q$.
  1235	
  1236	Since $(f,g) \GLEQ (f,rf+sg)$ if and only if $s\ne0$ we can assume that $c_1 = 0$.
  1237	The equalities for $\DE{f}{u}(x,y) = 0 = \DE{g}{u}(x,y) = 0$ for $u \in \{0,\infty\}$ give
  1238	\begin{align*}
  1239	 \DE{f}{0}(x,y) &= x = 0,\\
  1240	 \DE{g}{0}(x,y) &= b_1 x^q + d_1 y^q + d_1 y = 0,
  1241	\end{align*}
  1242	and
  1243	\begin{align*}
  1244	 \DE{f}{\infty}(x,y) &= y^q = 0,\\
  1245	 \DE{g}{\infty}(x,y) &= a_1 x^q + a_1 x + b_1 y.
  1246	\end{align*}
  1247	imply that $a_1 \ne 0$ and $d_1 \ne 0$. Thus, setting $a_1 = 1$ by the scaling action, 
  1248	we will check the common solutions of
  1249	\begin{align*}
  1250	 \DE{f}{u}(x,y) &=  x + u y^q = 0,\\
  1251	 \DE{g}{u}(x,y) &= (u + b_1) x^q + u^q x + d_1 y^q + (b_1 u^q + d_1) y = 0,
  1252	\end{align*} 
  1253	for $u \in \LL^\times$. Replacing $x$ by $uy^q$ in the second equation
  1254	\begin{align*}
  1255	 \DE{g}{u}(x,y) &= (u + b_1) (uy^q)^q + u^q (uy^q) + d_1 y^q + (b_1 u^q + d_1) y = 0,\\
  1256	&= (u^{q+1}  + b_1 u^q ) y^{q^2} + (u^{q+1}+d_1) y^q + (b_1 u^q + d_1) y = 0,\\
  1257	&= u^{q+1}(y^{q^2} + y^q) + b_1 u^q (y^{q^2} + y) + d_1 (y^q + y) = 0.
  1258	\end{align*}
  1259	Thus for every $u \in \LL^\times$, all $(uy^q,y)$ for $y \in \f{2}$ give a solution. 
  1260	To be APN, these should be the only solutions. 
  1261	We will use the fact that $y^q + y = h \in \HH \setminus \{0\}$, 
  1262	for $y \in \LL \setminus \f{2}$ by Hilbert's Theorem 90.
  1263	If $b_1 = 0$, then
  1264	\[
  1265	\frac{d_1}{u^{q+1}} = \frac{h^q}{h}
  1266	\]
  1267	has a solution for every $h \in \HH \setminus \{0\}$.
  1268	Now, applying $u \mapsto ub_1$ we get, by setting $d^q = d_1/b_1^{q+1}$, 
  1269	\begin{align*}
  1270	u^{q+1}h^q + u^q (h^q + h) + d^q h       &= 0,\\
  1271	hv^{q+1} + v (h^q+h) + d h^q &= 0,
  1272	\end{align*}
  1273	setting $v = d/u$ and then multiplying the equality by $v^{q+1}/d^q$. 
  1274	Now if $1 \in \HH$ (i.e., $l$ is even) then $d \not \in (\LLx)^{q+1}$
  1275	for $F$ to be APN. For $h \in \HH \setminus \f{2}$, setting 
  1276	$v = x((h^{q}+h)/h)^\qbar$, we get
  1277	\[
  1278	x^{q+1} + x + \frac{d h^{q+\qbar}}{(h^q+h)^{\qbar+1}} = 0.
  1279	\]
  1280	We have
  1281	\[
  1282	\lms h^{q+\qbar}/(h^q+h)^{\qbar+1} \ : \ h \in \HH \setminus \f{2} \rms  = 
  1283	\lms h^{q^2+1} /(h^q+h)^{q+1}      \ : \ h \in \HH \setminus \f{2} \rms  =
  1284	I_3^{[3]},
  1285	\]
  1286	by Lemma \ref{lem_imageset} (ii), since $h \in \HH$ if and only if $h^q \in \HH$.
  1287	Now $F$ is APN if and only if 
  1288	$
  1289	  d I_3 \cap (I_1 \cup I_2 \cup I_3) = \emptyset.
  1290	$
  1291	By Lemma \ref{lem_multiset} we have 
  1292	$
  1293		d I_3 \cap (I_1 \cup I_2 \cup I_3) \ne \emptyset,
  1294	$
  1295	for $l > 3$ and we are done.
  1296	
  1297	\item $f = (1,0,0,d_0)_q$ for $d_0 \in \LLx$.
  1298	
  1299	We can assume $a_1 = 0$. We have
  1300	\begin{align*}
  1301	 \DE{f}{0}(x,y) &= d_0(y^q + y) = 0,\\
  1302	 \DE{g}{0}(x,y) &= b_1 x^q + c_1 x + d_1 (y^q + y) = 0.
  1303	\end{align*}
  1304	Thus either $c_1 = 0$ or $b_1 = 0$ (but not both), and since
  1305	$(0,b_1,0,d_1)_q \Peq (0,0,c_1,d_1)_q \Peq (0,0,1,0)_q$ we are done as
  1306	we have already handled that case before.
  1307	\end{itemize}
  1308	\end{proof}
  1309	
  1310	\begin{remark}
  1311	In the proof of the case $f = (0,0,1,0)_q$ we assumed $l > 3$ 
  1312	and we used Lemma \ref{lem_multiset} to show that
  1313	$F$ is not APN. For $l = 3$, the necessary and sufficient condition
  1314	\[
  1315	d I_3 \cap (I_1 \cup I_2 \cup I_3) = \emptyset,
  1316	\]
  1317	holds for $d \in J = \{ \omega, \omega^2, \omega^4 \}$ where
  1318	$\omega \in \f{2^3}$ satisfying $\omega^3 + \omega + 1 = 0$.
  1319	In this case
  1320	\begin{align*}
  1321	I_0 &= \{ \omega, \omega^2, \omega^4 \},\\
  1322	I_1 &= \{ \omega^3, \omega^5, \omega^6 \},\\
  1323	I_2 &= \{ 0 \}, \textrm{ and}\\
  1324	I_3 &= \{1\}.
  1325	\end{align*}
  1326	It is easy to see the direct product satisfies $J I_3 = I_0$.
  1327	Thus $F : \f{2^3} \times \f{2^3} \to \f{2^3} \times \f{2^3}$,
  1328	with $F = ((0,0,1,0)_2,(1,b_1,0,d_1)_2)$ for $b_1,d_1 \in \f{2^3}$
  1329	is APN if and only  if $\omega^{2^i} = d_1/b_1^3$. These are 
  1330	precisely the Kim $\kappa$ functions (up to $\Peq$ equivalence).
  1331	\end{remark}
  1332	
  1333	\begin{remark}\label{rem_butterfly}
  1334	Note that the case $(f,g) \in \{ (1,0,0,1)_q \} \times \Pi_1$ proved as a subcase 
  1335	in Proposition \ref{prop_s}
  1336	generalizes the results in \cite{CPT,CDP} that show that the class of functions satisfying
  1337	the \textbf{(generalized) butterfly structure} are not APN when $l > 3$ is odd. These functions are
  1338	by definition \cite{CPT},
  1339	\[
  1340		\mathcal{B}_{q,\LL} = \{ ((x+ay)^{q+1}+(by)^{q+1},(y+ax)^{q+1}+(bx)^{q+1}) \ : \ a,b \in \LLx \}.
  1341	\]
  1342	It is easy to see via $x \mapsto x + ay$ and then $y \mapsto y/b$ for the left component 
  1343	(and similarly $y \mapsto y + ax$ and $x \mapsto x/b$ for the right component) 
  1344	that $(f,g) \in \mathcal{B}_{q,\LL} \subset \Pi_1 \times \Pi_1$. 
  1345	
  1346	Note that $\Pi_1 \times \Pi_1$ contains functions ($\CCZ$-equivalent to permutations)
  1347	that are not contained directly in $\mathcal{B}_{q,\LL}$ and whether the 
  1348	$\CCZ$-equivalence class (or $\GLEQ$ class) of $\mathcal{B}_{q,\LL}$ covers all
  1349	such functions is not covered in \cite{CPT,CDP} and seems to be difficult to solve.
  1350	The question is easy to answer for the right action of $\GL(2,\LL)$ together with
  1351	scaling on both components 
  1352	(the natural subgroup action $(\LLx \times \LLx) \times \GL(2,\LL)$ that 
  1353	preserves inclusion in $\Pi_1$). 
  1354	After the transformations ($x \mapsto x + ay$ and then $y \mapsto y/b$) 
  1355	on the left part and applying all $\GL(2,\LL)$ transformations stabilizing the 
  1356	left part $(1,0,0,1)_q$ (generated by $(x,y) \mapsto (y,x)$) and scaling on the 
  1357	right side, we see
  1358	\[
  1359	\mathcal{B'}_{q,\LL} = \{ (1,0,0,1)_q \} \times 
  1360	                \left( \{ h_{a,b,c}(x,y) \ : \ a,b,c \in \LLx \} 
  1361										\cup \{ h_{a,b,c}(y,x) \ : \ a,b,c \in \LLx \} \right),
  1362	\]
  1363	where
  1364	\[
  1365	h_{a,b,c}(x,y) = c ((a+1)y/b + ax)^{q+1} + (bx + ay)^{q+1}).
  1366	\]
  1367	The cardinality of this set is  $|\mathcal{B'}_{q,\LL}| \le 2^{3l+1}$ whereas
  1368	$|\Pi_1| = (2^{2l}-1)(2^{2l}-2^l)/2 \approx 2^{4l-1}$. Thus $\mathcal{B'}_{q,\LL}$ is strictly 
  1369	included in $\{ (1,0,0,1)_q \} \times \Pi_1$.
  1370	
  1371	
  1372	Note also that the butterfly structure is defined only for odd $l$ whereas 
  1373	Proposition \ref{prop_s} covers the even case as well. We also note that 
  1374	$\Pi_1 \times \Pi_1$ and, in particular, the functions from the generalized 
  1375	butterfly construction seems to be a good source for cryptographically 
  1376	interesting functions. The engineering aspects of the butterflies were explained
  1377	in \cite{PUB}.
  1378	\end{remark}
  1379	
  1380	
  1381	
  1382	
  1383	\subsection{The even $l$ case}
  1384	
  1385	By Lemma \ref{lem_sset} we can assume $f \in \Pi_1$ when $l$ is even.
  1386	
  1387	\begin{proposition}\label{prop_even}
  1388	Let $q = 2^k$, $l > 3$ even, $r = 2^l$, $\Gcd(k,l) = 1$ and 
  1389	\begin{align*}
  1390	F : \LL \times \LL &\to \LL \times \LL,\\
  1391	            (x,y)  &\mapsto (f(x,y),g(x,y)),
  1392	\end{align*}
  1393	where $f \in \Pi_1$ and $g \in \Vset$. 
  1394	Then $F$ is APN if and only if 
  1395	$ F \GLEQ G_{q+1}$ or $F \GLEQ G_{q+r}$.
  1396	\end{proposition}
  1397	
  1398	\begin{proof}
  1399	By Lemma \ref{lem_sset} and Proposition \ref{prop_s}, we must have
  1400	$g \in \Pi_1$. Assume $f(x_0,1) = 0 = g(x_0,1)$ for some 
  1401	$x_0 \in \ProjectiveLine(\LL)$, then since both $f,g$ have
  1402	only one $\PLL$-zero, there exists $x_1 \in \LL$ such that
  1403	$f(x_1,1)g(x_1,1) \ne 0$. Now $f(x,1)+rg(x,1) = 0$ has 
  1404	at least two $\PLL$-zeroes $\{x_0,x_1\}$ where the nonzero
  1405	$r$ is chosen to satisfy
  1406	$
  1407	r = \frac{f(x_1,1)}{g(x_1,1)}.
  1408	$
  1409	Thus $(f,f+rg) \GLEQ (f,g)$ is not APN by Proposition \ref{prop_s}.
  1410	
  1411	Therefore we can assume that $f$ and $g$ do not have a common zero.
  1412	We must have $rf(x,1)+sg(x,1) \in \Pi_1$ for every 
  1413	$(r,s) \in \LL \times \LL \setminus \{(0,0)\}$.
  1414	That is to say
  1415	\[
  1416	\pi(x) = \frac{f(x,1)}{g(x,1)} = \frac{s}{r}
  1417	\]
  1418	has a unique solution $x \in \PLL$ for every $s/r \in \PLL$, 
  1419	i.e., $x \mapsto \pi(x)$ is bijective.
  1420	That is to say 
  1421	\[
  1422	F \GLEQ G_{q+1} \textrm{ or } F \GLEQ G_{q+r}, 
  1423	\]
  1424	by Lemma \ref{lem_fracproj}.
  1425	
  1426	\end{proof}
  1427	
  1428	\subsection{The odd $l$ case}
  1429	
  1430	By Lemma \ref{lem_sset}, we can assume that $f \in \{(0,1,1,0)_q\} \cup \Pi_0 $ when $l$ is odd.
  1431	
  1432	\begin{proposition}\label{prop_odd}
  1433	Let $q = 2^k$, $l > 3$ odd, $r = 2^l$, $\Gcd(k,l) = 1$ and 
  1434	\begin{align*}
  1435	F : \LL \times \LL &\to \LL \times \LL,\\
  1436	            (x,y)  &\mapsto (f(x,y),g(x,y)),
  1437	\end{align*}
  1438	where $f \in \{(0,1,1,0)_q\} \cup \Pi_0$ and $g \in \Vset$. 
  1439	Then $F$ is APN if and only if 
  1440	\begin{itemize}
  1441	\item $F \GLEQ G_{q+1}$ if $k$ is odd, and
  1442	\item $F \GLEQ G_{q+r}$ if $k$ is even.
  1443	\end{itemize}
  1444	\end{proposition}
  1445	
  1446	\begin{proof}
  1447	It is clear by Proposition \ref{prop_s} that $f,g \in \Pi_3 \cup \Pi_0$.
  1448	Now, if $f,g \in \Pi_0$ then $rf+sg \in \Pi_0$ for all 
  1449	$(r,s) \in \LL \times \LL \setminus \{(0,0)\}$  is absurd.
  1450	Thus, whenever $rf+sg$ has a $\PLL$-solution it must have exactly
  1451	three $\PLL$ solutions again by Proposition \ref{prop_s}. Since, 
  1452	$(f,g) \GLEQ (rf+sg,g)$, we can assume that $f = (0,1,1,0)_q$ and $g \in  \Pi_0 \cup \Pi_3$.
  1453	Let $g = (a,b,c,d)_q$. We can assume by the left action of $\GL(2,\LL)$, $b = 0$, and 
  1454	by scaling, $a = 1$ (note that $a = 0$ is impossible since it implies $g \in \Pi_2$). 
  1455	Thus $g = (1,0,c,d)_q$. We have
  1456	\begin{align*}
  1457	 \DE{f}{\infty}(x,y) &= y^q + y = 0,\\
  1458	 \DE{g}{\infty}(x,y) &= (x^q + x) + c y^q = 0,
  1459	\end{align*}
  1460	which always have $(x,y) \in \f{2} \times \{0\}$ as solutions. Thus, 
  1461	$\trace{c} = 1$, so that $\f{2} \times \{1\}$ do not
  1462	give more solutions, in particular $c \ne 0$. Also
  1463	\begin{align*}
  1464	 \DE{f}{0}(x,y) &= x^q + x = 0,\\
  1465	 \DE{g}{0}(x,y) &= c x + d (y^q + y) = 0,
  1466	\end{align*}
  1467	implying $d \ne 0$.
  1468	
  1469	Now we will introduce the main argument: If $F = (f,g)$ is APN then 
  1470	$rf+g \in \Pi_0 \cup \Pi_3$. Let us determine the conditions on $F$ when
  1471	$rf+g \in \Pi_1$. We will show that this is always the case unless $F$
  1472	is equivalent to a Gold map.
  1473	
  1474	By Lemma \ref{lem_0123} (iii), $[(1,0,0,1)_q]_{\Peq} = \Pi_1$.
  1475	Let
  1476	\[
  1477	A_{\alpha,\beta,u,v} = \begin{pmatrix}
  1478	\alpha   & u\alpha \\
  1479	\beta    & v\beta
  1480	\end{pmatrix}
  1481	\]
  1482	where $\alpha,\beta \in \LL \setminus \f{2}$ and $u,v \in \LL$ with $u \ne v$
  1483	so that $\det (A_{\alpha,\beta,u,v}) = \alpha\beta(u+v) \ne 0$.
  1484	
  1485	Let $h = (1,0,0,1)_q$ and consider the right action of $\PGL(2,\LL)$ 
  1486	(viewing $h$ as a univariate $q$-projective polynomial), 
  1487	\[
  1488		h'(x) = \beta^{q+1}(x + v)^{q+1}h(\mu_{\alpha,\beta,u,v}(x)),
  1489	\]
  1490	where 
  1491	\[
  1492	\mu_{\alpha,\beta,u,v}(x) : x \mapsto \frac{\alpha (x + u)}{\beta (x + v)}.
  1493	\]
  1494	Equating the terms of $h'$ and $rf+g$, we get
  1495	\begin{align*}
  1496	\alpha^{q+1}         + \beta^{q+1}         &= 1,\\
  1497	\alpha^{q+1} u       + \beta^{q+1} v       &= r,\\
  1498	\alpha^{q+1} u^q     + \beta^{q+1} v^q     &= r+c,\\
  1499	\alpha^{q+1} u^{q+1} + \beta^{q+1} v^{q+1} &= d.
  1500	\end{align*}
  1501	Since $x \mapsto x^{q+1}$ is bijective and $r \in \LL$, we can rewrite these as
  1502	\begin{align*}
  1503	\gamma (u^q + u) + (\gamma+1) (v^q + v) &= c,\\
  1504	\gamma u^{q+1}   + (\gamma+1) v^{q+1}   &= d,
  1505	\end{align*}
  1506	where $\gamma = \alpha^{q+1} = 1 + \beta^{q+1}$. Since $\alpha,\beta \in \LL \setminus \f{2}$,
  1507	so is $\gamma$ and for all $\gamma \in \LL \setminus \f{2}$, we can find $\alpha$ and $\beta$
  1508	satisfying the above equalities. Equivalently,
  1509	\begin{align}
  1510	\label{eq1} \gamma (u^q + u + c) &= (\gamma+1) (v^q + v + c),\\
  1511	\label{eq2} \gamma (u^{q+1} + d) &= (\gamma+1) (v^{q+1} + d).
  1512	\end{align}
  1513	Note that $\trace{c} = 1$ and $\gamma \not\in \f{2}$, therefore neither side of
  1514	\eqref{eq1} vanishes. Thus we can divide 
  1515	\eqref{eq2} by \eqref{eq1} side by side to get
  1516	\begin{equation}
  1517	\label{eq3} \varphi_{c,d}(u) = \varphi_{c,d}(v),
  1518	\end{equation}
  1519	where
  1520	\[
  1521	\varphi_{c,d} : x \mapsto \frac{x^{q+1}+d}{x^q+x+c}. 
  1522	\]
  1523	Clearly \eqref{eq1} and \eqref{eq2} hold together if and only if 
  1524	        \eqref{eq1} and \eqref{eq3} hold together.
  1525	
  1526	Now assume $\varphi_{c,d}$ is not bijective on $\LL$. Then there exist $u,v \in \LL$ such that 
  1527	$\varphi_{c,d}(u) = \varphi_{c,d}(v)$ with $u + v \not\in \f{2}$. It is clear that
  1528	\[
  1529	\varphi_{c,d}(x) + \varphi_{c,d}(x+1) =  \frac{x^{q+1}+d+(x+1)^{q+1}+d}{x^q+x+c} = \frac{x^q+x+1}{x^q+x+c} \ne 0,
  1530	\]
  1531	since $\trace{1}=1$. For such $u,v$, \eqref{eq1} becomes
  1532	\[
  1533	\frac{u^q + u + c}{v^q + v + c} = \frac{\gamma+1}{\gamma} = 1 + \frac{1}{\gamma} \not\in \f{2}.
  1534	\]
  1535	Thus, selecting $\alpha,\beta \in \LL \setminus \f{2}$ we can produce such $\gamma$. Hence, $\varphi_{c,d}$ 
  1536	must be bijective, and by Lemma \ref{lem_fracproj}, we must have $c = d = 1$ and $g = (1,0,1,1)_q$. 
  1537	
  1538	Now let $\langle \xi \rangle =  \f{4}^\times$. Any $X \in \f{2^{2l}}$ can be written 
  1539	as $X = x+y\xi$ where $x,y \in \LL$. We have
  1540	\[
  1541	\xi^{2^k} = \left\{
  1542	\begin{array}{ll}
  1543	\xi + 1 & \textrm{if $k$ is odd,}\\
  1544	\xi     & \textrm{if $k$ is even}.
  1545	\end{array}
  1546	\right.
  1547	\]
  1548	Now if $k$ is odd, then
  1549	\begin{align*}
  1550		(x+y\xi)^{q+1} &= x^{q+1}+ xy^q +y^{q+1}+\xi (x^qy + xy^q)\\
  1551		               &\cong ((x^{q+1}+xy^q+y^{q+1}),x^qy+xy^q)\\
  1552		               &\GLEQ ((0,1,1,0)_q,(1,0,1,1)_q),
  1553	\end{align*}
  1554	and if $k$ is even,
  1555	\begin{align*}
  1556		(x+y\xi)^{q+r} &= x^{q+1}+ x^qy +y^{q+1}+\xi (x^qy + xy^q)\\
  1557		               &\cong ((x^{q+1}+x^qy+y^{q+1}),x^qy+xy^q)\\
  1558		               &\GLEQ ((x^{q+1}+xy^q+y^{q+1}),x^qy+xy^q)\\
  1559		               &\GLEQ ((0,1,1,0)_q,(1,0,1,1)_q),
  1560	\end{align*}
  1561	using $(x,y) \mapsto (y,x)$ in the penultimate line,
  1562	proving our assertion that $(f,g) \GLEQ G_{q+1}$ when $k$ is odd,
  1563	and                        $(f,g) \GLEQ G_{q+r}$ when $k$ is even.
  1564	Note that when $l$ is odd and $\Gcd(k,l) = 1$, we have 
  1565	$\Gcd(k,2l)   = 1$ if $k$ is odd and $\Gcd(l-k,2l) = 1$ if $k$ is even.
  1566	By \cite{gold}, these maps are APN since $q+r = q(1+r/q) = 2^k(1+2^{l-k})$. 
  1567	\end{proof}
  1568	
  1569	\subsection{Proof of Theorem \ref{thm_main}}
  1570	
  1571	Now, Propositions \ref{prop_gcd}, \ref{prop_s}, \ref{prop_even} and \ref{prop_odd}
  1572	together with Lemma \ref{lem_sset} proves Theorem \ref{thm_main}.
  1573	
