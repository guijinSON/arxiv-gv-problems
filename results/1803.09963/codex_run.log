+
+def _attack_literal_majority(inst: dict):
+    n = inst["n"]
+    score = [0] * n
+    for group in inst["groups"]:
+        for clause in group["clauses"]:
+            for lit in clause:
+                score[abs(lit) - 1] += 1 if lit > 0 else -1
+    return [1 if x > 0 else 0 for x in score]
