+        return None, {"rank": rank, "row_xors": row_xors, "operations": operations}
+    solution = [0] * n
+    for r, col in enumerate(pivot_cols):
+        solution[col] = rows[r][1]
+    return solution, {"rank": rank, "row_xors": row_xors, "operations": operations}
