+        "whereas a mechanical solver processes the full redundant LIMSAT system."
+    ),
+    "hardness_basis": (
+        "Track B: Section II.B permits general CNF LIMSAT instances; the reference "
+        "algorithm recognizes four-clause XOR blocks and uses GF(2) Gauss-Jordan "
+        "elimination in O(M*N^2) scalar bit operations, with its measured shipping "
+        "cost reported by selftest, while the complete-triple invariant uses 2*N "
+        "XORs (224 at the initial shipping preset) and is not stated in the prompt."
+    ),
+    "max_answer_tokens": 84,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
