+    for group in inst["groups"]:
+        for v in group["vars"]:
+            degree[v - 1] += 1
+    order = sorted(range(n), key=lambda i: (-degree[i], i))
+    candidate = [0] * n
+    for rank, v in enumerate(order):
+        candidate[v] = rank & 1
+    return candidate
