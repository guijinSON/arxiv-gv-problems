+    "hinted_minus_placebo": 0.0,
+    "hinted_verdict": "not run: OpenRouter returned HTTP 403 key-limit errors",
+    "intended_route_operations": 224,
+    "pass": true
+  },
+  "all_passed": true,
+  "external_blocker": "The required harden.py oracle loop and G9 arms could not run: every OpenRouter request returned HTTP 403, key limit exceeded. No API error was counted as an oracle failure.",
+  "shipping_difficulty": "hard",
+  "track": "B"
+}

