+    each signed literal plus N+1 bit XORs for every packed row operation.
+    """
+    n = inst["n"]
+    rows: list[list[int]] = []
+    operations = 0
+    for group in inst["groups"]:
+        mask = 0
+        for v in group["vars"]:
+            mask |= 1 << (v - 1)
+            operations += 1
+        rhs = _group_rhs(group)
+        operations += 12  # inspect four clauses with three signed literals each
+        rows.append([mask, rhs])
