+    rank = 0
+    row_xors = 0
+    pivot_cols: list[int] = []
+    for col in range(n):
+        pivot = next((r for r in range(rank, len(rows)) if (rows[r][0] >> col) & 1), None)
+        operations += max(0, len(rows) - rank)
+        if pivot is None:
+            continue
+        if pivot != rank:
+            rows[rank], rows[pivot] = rows[pivot], rows[rank]
+            operations += 1
+        pmask, prhs = rows[rank]
