+def _mul(left, right, modulus, p, alpha):
+    """Multiply (x,i)(y,j)=(x+alpha^i*y,i+j)."""
+    x, i = left
+    y, j = right
+    return ((x + pow(alpha, i, modulus) * y) % modulus, (i + j) % p)
+
