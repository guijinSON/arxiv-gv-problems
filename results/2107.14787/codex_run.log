+        # vanishingly unlikely, while seed 0 remains the small measured baseline.
+        bucket = abs(int(seed)) % 1_000_003
+        multiplier = n * (2 + 200 * prime_spread * bucket)
+        if multiplier % 2:
+            multiplier += 1
