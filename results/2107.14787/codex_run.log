+    used = set()
+    while len(factors) < 3:
+        candidate = p * multiplier + 1
+        if candidate != p and candidate not in used and _is_prime_64(candidate):
+            factors.append(candidate)
+            used.add(candidate)
+        multiplier += 2
+    return factors
