+    if set(answer) != {"repeat", "runs"}:
+        return False, "answer must contain exactly repeat and runs"
+    repeat = answer["repeat"]
+    runs = answer["runs"]
+    if isinstance(repeat, bool) or not isinstance(repeat, int):
+        return False, "repeat must be an integer"
+    if repeat != inst["N"]:
