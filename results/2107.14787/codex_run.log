+        "n": n,
+        "p": p,
+        "factors": factors,
+        "N": modulus,
+        "alpha": alpha,
+        "generators": {name: list(visible[name]) for name in ("X", "Y")},
+        "run_count": run_count,
+        "prime_spread": prime_spread,
+        "answer": answer,
+    }
+
