+        "materialized_final_position": list(final_position),
+        "materialization_checksum": checksum,
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    all_failed = all(successes[name] == 0 for name in attack_names)
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8 and final_position == (0, 0),
+        "attacks": attacks,
+        "reference_algorithm": reference,
+        "intended_compact_route": {
