+# Filled from the three isolated harden.py runs.  Zero attempts is deliberately
+# not treated as evidence; selftest requires at least three attempts per arm.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
