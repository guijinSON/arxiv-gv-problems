+    "easy": {"n": 1, "p": 13, "run_count": 8, "prime_spread": 1},
+    "medium": {"n": 2, "p": 13, "run_count": 8, "prime_spread": 2},
+    "hard": {"n": 4, "p": 13, "run_count": 8, "prime_spread": 4},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The subgroup with second coordinate zero is cyclic, and quotient periods "
