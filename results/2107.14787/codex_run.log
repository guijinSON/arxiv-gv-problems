+                len(set(primes)) == 4
+                and all(prime % 2 == 1 and _is_prime_64(prime) for prime in primes)
+                and pow(inst["alpha"], inst["p"], inst["N"]) == 1
+                and math.gcd(inst["alpha"] - 1, inst["N"]) == 1
