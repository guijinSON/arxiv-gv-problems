+    present = set(inst["connection_offsets"])
+    counts = _xor_support(present)
+    remove = sorted(present, key=lambda x: (counts[x], x))[:d]
+    missing = [x for x in counts if x not in present]
+    missing.sort(key=lambda x: (-counts[x], x))
+    if len(missing) < d:
