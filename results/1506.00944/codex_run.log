+      "compositions of these symmetries"
+    ]
+  },
+  "G9_no_tool_suitability": {
+    "answer_chars": 79,
+    "answer_elements": 12,
+    "answer_tokens": 20,
+    "arms": {
+      "bare": {
+        "attempts": 3,
+        "solved": 3
+      },
+      "hinted": {
+        "attempts": 0,
+        "solved": 0
+      },
+      "placebo": {
+        "attempts": 0,
+        "solved": 0
+      }
+    },
+    "caps": {
+      "chars": 2000,
+      "elements": 256,
+      "operations": 300
+    },
+    "hinted_minus_placebo": 0.0,
+    "hinted_verdict": "not_run_bare_budget_bound",
+    "intended_route_operations": 129,
+    "pass": true
+  },
+  "all_passed": true,
+  "shipping_difficulty": "hard",
+  "shipping_params": {
