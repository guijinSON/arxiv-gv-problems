+def _candidate_weights(inst):
+    absent = inst["n"] - 1 - len(inst["connection_offsets"])
+    present = len(inst["connection_offsets"])
+    return [math.comb(absent, j) * math.comb(present, j) for j in range(1, inst["errors"] + 1)]
