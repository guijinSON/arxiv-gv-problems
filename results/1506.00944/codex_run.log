+    explicit_demo = _expanded_graph_valid(demo, demo["answer"])
+    report["G1_planted_verifies"] = {
+        "pass": g1_success == g1_attempts and json_roundtrips == g1_attempts and explicit_demo,
+        "successes": g1_success,
