+    p["n"] = n * 2
+    if n.bit_length() % 2 == 0 and errors < (1 << r) - r - 1:
+        p["errors"] = errors + 1
+    else:
+        p["errors"] = errors
+    p["subspace_dim"] = r
+    return p
