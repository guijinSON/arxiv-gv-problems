+    j = 1
+    for weight in weights:
+        if pick < weight:
+            break
+        pick -= weight
+        j += 1
+    add = set()
+    while len(add) < j:
+        x = rng.randrange(1, inst["n"])
+        if x not in pset:
+            add.add(x)
+    return {"add": sorted(add), "remove": sorted(rng.sample(present, j))}
