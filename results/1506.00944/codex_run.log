+def _rref_basis(vectors, bits=None):
+    """Canonical descending-pivot XOR basis as a tuple, or shorter if dependent."""
+    if bits is None:
+        bits = max((int(v).bit_length() for v in vectors), default=0)
+    rows = [0] * bits
