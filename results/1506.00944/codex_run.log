+
+def _apply_linear(x, columns):
+    out = 0
+    bit = 0
+    while x:
+        if x & 1:
+            out ^= columns[bit]
+        bit += 1
+        x >>= 1
+    return out
+
+
+def _random_linear_columns(bits, rng):
+    while True:
