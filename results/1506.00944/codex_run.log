+            "bits": bits,
+            "ell": 2,
+            "subspace_dim": subspace_dim,
+            "errors": errors,
+            "connection_offsets": dset,
+            "expanded_vertices": 2 * n,
+            "expanded_edit_budget": 2 * errors * n,
