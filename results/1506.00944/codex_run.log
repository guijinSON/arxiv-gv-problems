+def _answer_from_subspace(inst, subspace):
+    dset = set(inst["connection_offsets"])
+    nz = set(subspace)
+    nz.discard(0)
+    add = sorted(nz - dset)
+    remove = sorted(dset - nz)
+    return {"add": add, "remove": remove}
+
+
+def _xor_support(dset):
+    values = sorted(dset)
+    counts = Counter()
+    for i, a in enumerate(values):
+        for b in values[i + 1 :]:
+            counts[a ^ b] += 1
+    return counts
