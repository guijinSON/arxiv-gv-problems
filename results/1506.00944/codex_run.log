+
+def random_candidate(inst, rng):
+    present = sorted(inst["connection_offsets"])
+    pset = set(present)
+    weights = _candidate_weights(inst)
+    pick = rng.randrange(sum(weights))
+    j = 1
+    for weight in weights:
+        if pick < weight:
+            break
+        pick -= weight
+        j += 1
