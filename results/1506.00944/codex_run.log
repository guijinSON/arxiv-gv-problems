\begin{center}
\includegraphics[height=9.33cm,width=13.01cm]{grafosQquoc.EPS}
\caption{\label{grafosQquoc}(a) A graph $G$ \ (b) The modular
decomposition tree $T_{G}$ \ (c) Quotient graph $G_{\mathrm Q}$}
\end{center}
\end{figure}

