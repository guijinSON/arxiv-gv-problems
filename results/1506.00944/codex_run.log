+            "name": "exhaustive displayed-basis decoding with exact span checks",
+            "complexity": "O(C(|D|,r) * (r^2 + 2^r + |D|)) exact",
+            "operations": max(ref_ops),
+            "wall_clock_sec": max(ref_times),
+            "solves": f"{ref_successes}/8, as expected",
