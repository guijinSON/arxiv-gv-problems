+def _answer_from_subspace(inst, subspace):
+    dset = set(inst["connection_offsets"])
+    nz = set(subspace)
+    nz.discard(0)
+    add = sorted(nz - dset)
+    remove = sorted(dset - nz)
+    return {"add": add, "remove": remove}
