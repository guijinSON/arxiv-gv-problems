+            if rows[pivot]:
+                x ^= rows[pivot]
+            else:
+                rows[pivot] = x
+                for low in range(pivot):
+                    if rows[low] and ((rows[pivot] >> low) & 1):
+                        rows[pivot] ^= rows[low]
+                for high in range(pivot + 1, bits):
+                    if rows[high] and ((rows[high] >> pivot) & 1):
+                        rows[high] ^= rows[pivot]
+                break
