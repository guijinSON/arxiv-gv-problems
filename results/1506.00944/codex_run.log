+        x = int(raw)
+        for pivot in range(bits - 1, -1, -1):
+            if not ((x >> pivot) & 1):
+                continue
+            if rows[pivot]:
+                x ^= rows[pivot]
+            else:
+                rows[pivot] = x
+                for low in range(pivot):
+                    if rows[low] and ((rows[pivot] >> low) & 1):
+                        rows[pivot] ^= rows[low]
