+
+
+def _attack_numeric_extremes(inst):
+    d = inst["errors"]
+    present = set(inst["connection_offsets"])
+    absent = [x for x in range(1, inst["n"]) if x not in present]
+    return {"add": absent[:d], "remove": sorted(present, reverse=True)[:d][::-1]}
+
