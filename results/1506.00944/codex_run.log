+    if len(corrected) != expected_size:
+        return False, "corrected connection set has the wrong size"
+    subspace = corrected | {0}
+    for a in subspace:
+        for b in subspace:
+            if (a ^ b) not in subspace:
+                return False, "corrected connection set is not XOR-closed"
