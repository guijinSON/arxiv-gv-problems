+            "complexity": "O(|D|^2 + 2^r) exact",
+            "operations": max(compact_ops),
+            "solves": f"{compact_successes}/8, as expected",
+        },
+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
