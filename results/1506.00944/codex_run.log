+        "invariance_attempts": 40,
+        "invariant_relabellings": invariant,
+        "carried_witness_attempts": 40,
+        "carried_witnesses_valid": carried,
+        "distinctness_attempts": 20,
+        "distinct_unrelated_keys": len(distinct_keys),
