+        for x in values:
+            neighborhood = sorted((support[x ^ y], colors[y]) for y in values if y != x)
+            blob = json.dumps([colors[x], neighborhood], separators=(",", ":"))
+            nxt[x] = hashlib.sha256(blob.encode()).hexdigest()
+        colors = nxt
