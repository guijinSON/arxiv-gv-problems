+    # cost and records all equally close witnesses rather than stopping on a lucky
+    # early basis ordering.
+    valid_count = 0
+    seen = set()
+    for combo in itertools.combinations(values, r):
+        operations += r * r
+        basis = _rref_basis(combo, inst["bits"])
+        if len(basis) != r:
+            continue
