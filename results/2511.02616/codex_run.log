+def canonical_key(inst: dict) -> str:
+    """Normalize all trace-zero quadratic bases, including conjugation."""
+    p = inst["p"]
+    u0 = _least_nonsquare(p)
+    root = _sqrt_mod(inst["u"] * pow(u0, -1, p) % p, p)
