+    # The witness exists before the public target.  Distinct coordinates make
+    # all mandated corruption tests genuine changes, not a rejection search.
+    while True:
+        answer = [rng.randrange(p), rng.randrange(p)]
+        if answer[0] != answer[1]:
+            break
