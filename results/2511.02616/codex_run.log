+        first, carried1 = _rebase_instance(trial, scale1)
+        second, carried2 = _rebase_instance(first, scale2)
+        conjugate, carried3 = _rebase_instance(trial, trial["p"] - 1)
+        for moved, carried in ((first, carried1), (second, carried2),
+                               (conjugate, carried3)):
