+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "One JSON list [r,s] encoding r+s*alpha in F_{p^2}, with exactly two "
+        "decimal integers and 0 <= r,s < p."
+    ),
