+        "hinted_minus_placebo": h_rate - p_rate,
+        "hinted_verdict": evidence["hinted_verdict"],
+        "answer_chars": chars,
+        "answer_tokens": tokens,
+        "answer_elements": elements,
+        "intended_route_operations": intended["operations"],
+    }
