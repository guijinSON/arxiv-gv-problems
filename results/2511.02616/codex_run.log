+    answer = list(current)
+    ok, reason = verify(inst, answer)
+    return {
+        "answer": answer,
+        "ok": ok,
+        "reason": reason,
+        "wall_clock_sec": elapsed,
+        "operations": counter.operations,
+        "field_operations": counter.field_operations,
+        "euclidean_divisions": counter.euclidean_divisions,
+    }
