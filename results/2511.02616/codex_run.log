+def _add(x: tuple[int, int], y: tuple[int, int], p: int) -> tuple[int, int]:
+    return ((x[0] + y[0]) % p, (x[1] + y[1]) % p)
+
+
+def _sub(x: tuple[int, int], y: tuple[int, int], p: int) -> tuple[int, int]:
+    return ((x[0] - y[0]) % p, (x[1] - y[1]) % p)
