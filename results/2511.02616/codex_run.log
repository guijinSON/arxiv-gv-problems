+DIFFICULTY: dict = {
+    "demo": {"n": 11, "layers": 1},
+    "easy": {"n": 10_007, "layers": 1},
+    "medium": {"n": 100_003, "layers": 2},
+    "hard": {"n": 500_000, "layers": 4},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "In the trace-zero basis, every layer's second output coordinate is an "
