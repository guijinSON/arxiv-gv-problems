+    }
+
+    chars, tokens, elements = _answer_metrics(inst["answer"])
+    intended = _compact_inverse(inst)
+    evidence = G9_EVIDENCE
+    hinted_pass = evidence["hinted_verdict"] == "hardened"
+    within_caps = (chars <= 2000 and tokens <= 500 and elements <= 256
