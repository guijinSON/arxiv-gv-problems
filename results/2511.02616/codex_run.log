+    attack_successes = {
+        "outlier_small_or_displayed_residues": 0,
+        "greedy_visible_linear_terms_only": 0,
+        "random_restart_512_structure_aware": 0,
+        "by_hand_ordinary_integer_cube_root_ansatz": 0,
