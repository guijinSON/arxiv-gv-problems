+def _integer_cuberoot(value: int) -> int:
+    lo, hi = 0, 1
+    while hi ** 3 <= value:
+        hi *= 2
+    while lo + 1 < hi:
+        mid = (lo + hi) // 2
+        if mid ** 3 <= value:
+            lo = mid
+        else:
+            hi = mid
+    return lo
+
