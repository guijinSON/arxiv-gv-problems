+        value = json.loads(body)
+    except (TypeError, ValueError):
+        match = re.fullmatch(r"\s*(\d+)\s*,\s*(\d+)\s*", body)
+        if not match:
+            return None
+        value = [int(match.group(1)), int(match.group(2))]
