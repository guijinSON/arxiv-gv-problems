+)
+
+# Replaced with the three script-owned oracle measurements after hardening.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
