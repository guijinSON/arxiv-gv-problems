+def _attack_random_restart(inst: dict, seed: int, restarts: int = 512) -> bool:
+    rng = random.Random(seed ^ 0x251102616)
+    for _ in range(restarts):
+        if verify(inst, random_candidate(inst, rng))[0]:
+            return True
+    return False
