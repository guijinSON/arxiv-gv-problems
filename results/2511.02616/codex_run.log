+    answer = list(current)
+    ok, reason = verify(inst, answer)
+    return {
+        "answer": answer,
+        "ok": ok,
+        "reason": reason,
+        "wall_clock_sec": elapsed,
+        "iterations": iterations,
+        "operations": operations,
+    }
