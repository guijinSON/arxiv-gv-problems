+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Recognize the matrix as a row/column-permuted permutation matrix plus "
+        "a rank-one constant-column term, so paired column backgrounds cancel "
+        "and the determinant orbit is obtained without elimination."
+    ),
+    "hardness_basis": (
+        "Track B: Lemma 8 makes the orbit label a determinant, computable by "
+        "Gaussian elimination in O(s^3) GF(2^128) operations; at shipping "
+        "s=41 it averaged 16,267 field operations, 418,229 shift/XOR steps, "
+        "and 0.056 seconds over eight seeds, while the rank-one invariant "
