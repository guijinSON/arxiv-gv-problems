+                for i in range(size)
+            ]
+            trace_guess = 0
+            diagonal_guess = 1
+            for i in range(size):
+                trace_guess ^= matrix[i][i]
+                diagonal_guess = _gf_mul(diagonal_guess, matrix[i][i])
+            if trace_guess == target or diagonal_guess == target:
