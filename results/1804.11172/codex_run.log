+    "hard": {"n": 20},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT: str = (
+    "Each column's modal value is a rank-one background, while the residual's two exceptional rows share an even-weight pattern."
+)
