+        raise AssertionError("audit seed unexpectedly has a one-term answer")
+    corruptions = {
+        "drop": base[:-1],
+        "swap": [base[1], base[0], *base[2:]],
+        "duplicate": [base[0], base[0], *base[1:]],
+        "empty": [],
+        "out_of_range": [*base, 128],
