+    answer_chars = 0
+    answer_atoms = 0
+    intended_ops = 0
+    for seed in range(40):
+        inst = make_instance(seed=3000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        answer_chars = max(answer_chars, len(json.dumps(inst["answer"],
