+    corruptions = {
+        "drop": base[:-1],
+        "swap": [base[1], base[0], *base[2:]],
+        "duplicate": [base[0], base[0], *base[1:]],
+        "empty": [],
+        "out_of_range": [*base, 128],
+    }
+    cases = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
