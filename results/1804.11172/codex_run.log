+
+def search_space(inst) -> int | None:
+    return (1 << _DEGREE) - 1
+
+
+def enumerate_all(inst) -> int | None:
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    return sum(verify(inst, random_candidate(inst, random.Random(i)))[0]
+               for i in range(search_space(inst)))
