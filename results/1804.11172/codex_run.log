+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Recognize the matrix as a row/column-permuted permutation matrix plus "
+        "a rank-one constant-column term, so paired column backgrounds cancel "
+        "and the determinant orbit is obtained without elimination."
+    ),
+    "hardness_basis": (
