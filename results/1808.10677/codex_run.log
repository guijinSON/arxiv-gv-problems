def repartition(e):
    print('calcul valeurs...')
    z=[pcmc2rs(angles(i[0][0]),angles(i[0][1])) for i in e] # 1 min
    print('approximations rationnelles...')
    z2=[(continued_fraction(i[0]).convergent(5),continued_fraction(i[1]/i[0]).convergent(5)) for i in z]
    print('diagramme de Voronoï...')
    v=VoronoiDiagram(z2)
    carre=Polyhedron([(0,0),(1,0),(1,1),(0,1)])  
    g=carre.plot(axes=false,aspect_ratio=1,fill=false,color='black',point=false)
    for d in v.regions().keys():
        w=v.regions().get(d).intersection(carre)
        g+=w.plot(point=false,fill=false,color='blue',thickness=0.1)
        g+=point(d.affine(),color='black')
        i=z2.index(d.affine())
        g+=text(i+1,w.center(),fontsize='x-small',color='black')
    return g+plot(1/r*(2/sqrt(3)-1),r,2/sqrt(3)-1,1,color='red')

