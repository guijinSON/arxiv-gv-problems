assign=t.body[0]
L=assign.value
lengths=[]
for el in L.elts:
    if isinstance(el,ast.Tuple) and len(el.elts)==2 and isinstance(el.elts[1],ast.List):
        names=[]
        pair=el.elts[0]
        if isinstance(pair,ast.Tuple):
            names=[ast.literal_eval(x) for x in pair.elts]
        lengths.append((len(el.elts[1].elts),names))
print('records',len(lengths),'min',min(x[0] for x in lengths),'max',max(x[0] for x in lengths),'max_cases',[x for x in lengths if x[0]==max(y[0] for y in lengths)])
print('record length distribution',sorted(set(x[0] for x in lengths)))
