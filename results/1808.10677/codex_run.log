# dessine c=((i,j),(rr,ss),(pc,mc,gc))
def dessine(c):
    rr=c[1][0]
    ss=c[1][1]
    d={'s':ss,'r':rr,'1':1}
    g=Graphics()
    y=0
    for i in range(3):
        x=0
        z=[ss,rr,1][i]
        for j in c[2][i]:
            g+=circle((x,y),z,fill=true,axes=false,figsize=16)
            seq=sequences(j).pop()
            a=0
            for k in range(len(seq)):
                zz=d.get(seq[k])
                g+=circle((x+(z+zz)*cos(a),y+(z+zz)*sin(a)),zz)
                a+=angle(d.get(seq[k]),z,d.get(seq[mod(k+1,len(seq))]))
            x+=7
        y-=7
    return g

def dessine1(seq,tc,rr,ss,name):
    g=100
    f=open(name,'w')
    f.write('<svg>\n')
    d={'s':ss,'r':rr,'1':1}
    col={'s':'#888888','r':'#bbbbbb','1':'#eeeeee'}
    z=[ss,rr,1][tc]
    f.write('<circle cx="0" cy="0" r="%f" fill="%s" stroke="black" />\n'%(RR(g*z),col.get(['s','r','1'][tc])))
    a=0
    for k in range(len(seq)):
        zz=d.get(seq[k])
        f.write('<circle cx="%f" cy="%f" r="%f" fill="%s" stroke="black"/>\n'%(RR(g*(z+zz)*cos(a)),RR(g*(z+zz)*sin(a)),RR(g*zz),col.get(seq[k])))
        a+=angle(d.get(seq[k]),z,d.get(seq[mod(k+1,len(seq))]))
    f.write('</svg>\n')
    f.close()


