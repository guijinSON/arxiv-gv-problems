    f.write('<circle cx="%d" cy="%d" r="%f" stroke="black" fill="red" opacity="0.5"/>\n'%(20*g,-5*g,RR(g*(rr+ss))))
    f.write('<circle cx="%d" cy="%d" r="%f" stroke="black" fill="red" opacity="0.5"/>\n'%(25*g,-5*g,RR(g*(ss+ss))))
    for i in range(3):
        x=3*g
        z=[ss,rr,1][i]
        for j in c[2][i]:
            f.write('<circle cx="%f" cy="%f" r="%f" fill="%s" stroke="black" />\n'%(x,y,RR(g*z),col.get(['s','r','1'][i])))
            seq=sequences(j).pop()
            a=0
            for k in range(len(seq)):
                zz=d.get(seq[k])
                f.write('<circle cx="%f" cy="%f" r="%f" fill="%s" stroke="black"/>\n'%(RR(x+g*(z+zz)*cos(a)),RR(y+g*(z+zz)*sin(a)),RR(g*zz),col.get(seq[k])))
                a+=angle(d.get(seq[k]),z,d.get(seq[mod(k+1,len(seq))]))
            x+=7*g
        y+=7*g
    f.write('</svg>\n')
    f.close()


# dessine toute une liste en svg dans un fichier
def dessine3(RS,name):
    g=100
    col={'s':'#888888','r':'#bbbbbb','1':'#eeeeee'}
    f=open(name,'w')
    f.write('<svg>\n')
    y=0
    for c in RS:
#        f.write('<text style="font-size:200" x="%d" y="%d" fill="black">(%d,%d)</text>\n'%(-10*g,y+50,c[0][0],c[0][1]))
        f.write('<text style="font-size:200" x="%d" y="%d" fill="black">%s</text>\n'%(-10*g,y+50,c[0][0]+'/'+c[0][1]))
        x=0
        d={'s':c[1][1],'r':c[1][0],'1':1}
        for i in range(3):
            z=[c[1][1],c[1][0],1][i]
            for j in c[2][i]:
                f.write('<g>\n')
                f.write(' <circle cx="%f" cy="%f" r="%f" fill="%s" stroke="black" />\n'%(x,y,RR(g*z),col.get(['s','r','1'][i])))
                seq=sequence(j) # on dessine la première séquence sans chercher les autres (overlap potentiel)
                a=0
                for k in range(len(seq)):
                    zz=d.get(seq[k])
                    f.write(' <circle cx="%f" cy="%f" r="%f" fill="%s" stroke="black"/>\n'%(RR(x+g*(z+zz)*cos(a)),RR(y+g*(z+zz)*sin(a)),RR(g*zz),col.get(seq[k])))
                    a+=angle(d.get(seq[k]),z,d.get(seq[mod(k+1,len(seq))]))
                f.write('</g>\n')
                x+=7*g
        y+=7*g
    f.write('</svg>\n')
    f.close()


################
# codage : liste des disques numérotés
# 2 premiers éléments : rayons des disques 0 et 1
# suivants : (x,y,r) ou (x,y,r,z) : disque rayon r collé aux disques N° x et y, éventuel doublon du N°z

# algo de Lagrange pour avoir une base réduite
def lagrange(u,v):
    if u.norm()<v.norm():
        (u,v)=(v,u)
    while u.norm()>v.norm():
        q=round(u*v/(v*v))
        r=u-q*v
        u=v
        v=r
    return (u,v)

def angle(x,y,z):
    return arccos(((y+x)^2+(y+z)^2-(x+z)^2)/2/(y+x)/(y+z))

def domaine(e,(rr,ss)):
    d={1:1,r:RR(rr),s:RR(ss)}
    pers=[]
    lc=[(0,0,e[0])]
    doublons=[]
    lc.append((d.get(e[0])+d.get(e[1]),0,e[1])) # les deux premiers disques
    for c in e[2:len(e)]: # ajoute un par un les disques suivants
        (xi,yi,ri)=lc[c[0]]
        (xj,yj,rj)=lc[c[1]]
        rk=c[2]
        a=arctan((yj-yi)/(xj-xi)) if xi<>xj else sign(yj-yi)*pi/2
        a+=pi if xj<xi else 0
        a+=angle(d.get(rj),d.get(ri),d.get(rk))
        xk=RR(xi+(d.get(ri)+d.get(rk))*cos(a))
        yk=RR(yi+(d.get(ri)+d.get(rk))*sin(a))
        if len(c)>3: # disque répété ?
            doublons.append(len(lc)) # retient que c'est un doublon
            per=(xk-lc[c[3]][0],yk-lc[c[3]][1]) # déduit une période
            if len(pers)==0 or (len(pers)==1 and abs(matrix([pers[0],per]).det())>1): # première période ou 2eme période indép ? (aire domaine fondamentale >1 car contient tjrs un grand disque d'aire pi)
                pers.append(per)
        lc.append((xk,yk,rk)) # ajoute le disque
    lc=[lc[i] for i in range(len(lc)) if i not in doublons] # vire les doublons
    pers=list(lagrange(vector(pers[0]),vector(pers[1]))) # base réduite
    # tourne le domaine pour amener le plus long vecteur de période à l'horizontale
    cosa=pers[1][0]/pers[1].norm()
    sina=-pers[1][1]/pers[1].norm()
    pers[0]=[cosa*pers[0][0]-sina*pers[0][1],sina*pers[0][0]+cosa*pers[0][1]]
    pers[1]=[cosa*pers[1][0]-sina*pers[1][1],sina*pers[1][0]+cosa*pers[1][1]]
    lc=[(cosa*c[0]-sina*c[1],sina*c[0]+cosa*c[1],c[2]) for c in lc]
    # symétrie axiale pour ramener plus court vecteur ds 1er quadrant
    if pers[0][0]<0:
        lc=[(-c[0],c[1],c[2]) for c in lc]
        pers[0][0]=-pers[0][0]
    if pers[0][1]<0:
        lc=[(c[0],-c[1],c[2]) for c in lc]
        pers[0][1]=-pers[0][1]
    print('densité : %f'%RR(sum([pi*d.get(c[2])^2 for c in lc])/abs(matrix(pers).det())))
    return (lc,pers)


# e=((pc,mc),empilement)
def dessine4(e):
    # calcule r et s à partir couronnes : pb : pas tjrs unicité, par ex 11ss/111rr
    print(e[0])
    (rr,ss)=pcmc2rs(angles(e[0][0]),angles(e[0][1]))
    (lc,pers)=domaine(e[1],(rr,ss))
    f=open('packing_'+e[0][0]+'_'+e[0][1]+'.svg','w')
    wh=(1000,900) # taille fenêtre de vue
    f.write('<svg xmlns:xlink="http://www.w3.org/1999/xlink" width="%d" height="%d">\n <defs>\n'%(wh[0],wh[1]))
    # facteur d'échelle
    g=sqrt(wh[0]*wh[1]/abs(det(matrix(pers)))/4) # le domaine fondamental occupe 1/4 du dessin
#    g=wh[0]/pers[1][0]/2 # base du domaine fondamental = moitié du dessin
    # décalage pour centrer le domaine fondamental
    x0=(wh[0]-g*pers[0][0]-g*pers[1][0])/2
    y0=(wh[1]-g*pers[0][1]-g*pers[1][1])/2
    # les disques (ds les defs)
#    version couleur
    f.write('  <g id="GD">\n   <circle cx="0" cy="0" r="%.3f" fill="#ffd42a" stroke="black"/>\n   <ellipse cx="0" cy="%d" rx="%.3f" ry="%.3f" fill="#ffffff" transform="rotate(-45)"/>\n  </g>\n'%(RR(g*1),RR(-g*7/10),RR(g/6),RR(g/10)))
    f.write('  <g id="MD">\n   <circle cx="0" cy="0" r="%.3f" fill="#5599ff" stroke="black"/>\n   <ellipse cx="0" cy="%d" rx="%.3f" ry="%.3f" fill="#ffffff" transform="rotate(-45)"/>\n  </g>\n'%(RR(g*rr),RR(-g*rr*7/10),RR(g*rr/6),RR(g*rr/10)))
