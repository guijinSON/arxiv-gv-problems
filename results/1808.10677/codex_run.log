    # version niveaux gris
#    f.write('  <g id="GD"><circle cx="0" cy="0" r="%.3f" fill="#eeeeee" stroke="black"/>\n</g>\n'%RR(g*1))
#    f.write('  <g id="MD"><circle cx="0" cy="0" r="%.3f" fill="#bbbbbb" stroke="black"/>\n</g>\n'%RR(g*rr))
#    f.write('  <g id="PD"><circle cx="0" cy="0" r="%.3f" fill="#888888" stroke="black"/>\n</g>\n'%RR(g*ss))
    # version vide
#    f.write('  <g id="GD"><circle cx="0" cy="0" r="%.3f" fill="none" stroke="black"/>\n</g>\n'%RR(g*1))
#    f.write('  <g id="MD"><circle cx="0" cy="0" r="%.3f" fill="none" stroke="black"/>\n</g>\n'%RR(g*rr))
#    f.write('  <g id="PD"><circle cx="0" cy="0" r="%.3f" fill="none" stroke="black"/>\n</g>\n'%RR(g*ss))
    # le domaine fondamental (ds les defs)
    f.write('  <g id="DF">\n')
    disque={1:'GD',r:'MD',s:'PD'}
    for c in lc:
        f.write('   <use xlink:href="#%s" x="%.3f" y="%.3f"/>\n'%(disque.get(c[2]),g*c[0],g*c[1]))
    f.write('  </g>\n </defs>\n')
