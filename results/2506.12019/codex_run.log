/bin/bash -lc "python3 - <<'PY'
import ast, contextlib, importlib.util, io, json, os, random
p='gen_2506_12019.py'; src=open(p).read(); tree=ast.parse(src)
# Verify that verify() never indexes the public instance at key 'answer'.
v=next(n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) and n.name=='verify')
reads=[]
for n in ast.walk(v):
 if isinstance(n,ast.Subscript) and isinstance(n.value,ast.Name) and n.value.id=='inst':
  sl=n.slice
  if isinstance(sl,ast.Constant): reads.append(sl.value)
assert 'answer' not in reads, reads
s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
pms=g.DIFFICULTY['hard']
a=g.make_instance(seed=123456789,**pms); b=g.make_instance(seed=123456789,**pms)
assert a==b
assert g.canonical_key(a)==g.canonical_key(b)
assert len({g.canonical_key(g.make_instance(seed=i,**pms)) for i in range(40)})==40
os.environ.pop('GV_HINT_MODE',None); bare=g.render(a)
os.environ['GV_HINT_MODE']='structural'; hinted=g.render(a)
os.environ['GV_HINT_MODE']='placebo'; placebo=g.render(a)
os.environ.pop('GV_HINT_MODE',None)
assert g.STRUCTURAL_HINT not in bare and g.PLACEBO_HINT not in bare
assert g.STRUCTURAL_HINT in hinted and g.PLACEBO_HINT in placebo
assert g.parse_answer('<answer>garbage</answer>') is None
assert g.parse_answer('none') is None
assert json.loads(json.dumps(a['answer']))==a['answer']
print('determinism/verify-independence/hints/diversity: pass')
print('hard render chars:',len(bare),'answer chars:',len(json.dumps(a['answer'],separators=(',',':'))))
