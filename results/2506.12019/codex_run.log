+        "family": "complement-symmetric exact Subset Sum",
+        "n": n,
+        "required_size": k,
+        "target": target,
+        "items": items,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render a self-contained statement and the exact output contract."""
