+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_one": sorted(planted[:-1] + [unused_id]),
+        "duplicate_one": planted[:-1] + [planted[-2]],
+        "empty": [],
+        "out_of_range": planted[:-1] + [ship["n"] + 1],
+    }
+    cases: dict[str, dict[str, Any]] = {}
+    reasons: list[str] = []
+    for name, candidate in corruptions.items():
