+        "observed_probability": density,
+        "candidate_space": candidate_space,
+        "sampler": "uniform k-subsets, with exact cardinality enforced",
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    attack_names = [
