      "wall_clock_sec_mean": 0.7429775074124336
    }
  },
  "G7_scales": {
    "answer_elements_doubled": 10,
    "answer_elements_shipping": 10,
    "doubled_n": 80,
    "doubled_space": 1646492110120,
    "doubled_verify_reason": "ok",
    "pass": true,
