+}
+
+DIFFICULTY = {
+    "demo": {"n": 8, "k": 3, "scale_bits": 2},
+    "easy": {"n": 28, "k": 10, "scale_bits": 16},
+    "medium": {"n": 34, "k": 10, "scale_bits": 18},
+    "hard": {"n": 40, "k": 10, "scale_bits": 20},
+}
