   467	def _reference_dense(inst) -> tuple[list[int], int]:
   468	    """Expand every term, then reduce exactly modulo Phi_(2M).
   469	
   470	    For odd prime M, Phi_(2M)(x)=1-x+x^2-...+x^(M-1).  Folding x^(r+M)=-x^r
   471	    leaves a length-M coefficient vector.  If it is rational, its nonconstant
   472	    part is an integer multiple of the alternating cyclotomic relation.
   473	    """
   474	    M = inst["M"]
   475	    N = 2 * M
   476	    selector = inst["selector"]
   477	    result = []
   478	    operations = 0
   479	    for a in range(N):
   480	        counts = [0] * N
   481	        for i in selector:
   482	            k = (a + i) % N
   483	            for u in range(M):
   484	                counts[((2 * u + 1) * k) % N] += 1
   485	                operations += 1
   486	        folded = [counts[r] - counts[r + M] for r in range(M)]
   487	        relation_scale = -folded[1]
   488	        value = folded[0] - relation_scale
   489	        if any(
   490	            folded[r]
   491	            != (value if r == 0 else 0) + relation_scale * (1 if r % 2 == 0 else -1)
   492	            for r in range(M)
   493	        ):
   494	            raise AssertionError("dense cyclotomic reduction did not become rational")
   495	        if value % M:
   496	            raise AssertionError("root sum was not divisible by M")
   497	        result.append(value // M)
   498	    return result, operations
