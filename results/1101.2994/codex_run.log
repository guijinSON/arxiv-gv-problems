+def _least_rotation(data: bytes) -> bytes:
+    """Booth's O(n) lexicographically least cyclic rotation."""
+    if not data:
+        return data
+    doubled = data + data
+    n = len(data)
+    i, j, k = 0, 1, 0
+    while i < n and j < n and k < n:
+        left = doubled[i + k]
+        right = doubled[j + k]
+        if left == right:
+            k += 1
+            continue
+        if left > right:
+            i = i + k + 1
+            if i <= j:
+                i = j + 1
+        else:
+            j = j + k + 1
+            if j <= i:
+                j = i + 1
+        k = 0
+    start = min(i, j)
+    return doubled[start : start + n]
