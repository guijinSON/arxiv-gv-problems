   442	    best = None
   443	    for unit in range(1, N):
   444	        if math.gcd(unit, N) != 1:
   445	            continue
   446	        bits = bytearray(N)
   447	        for i in inst["selector"]:
   448	            bits[(unit * i) % N] = 1
