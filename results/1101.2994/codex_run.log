   543	def _affine_transform_instance(inst, unit: int, shift: int, shuffle_seed: int):
   544	    """Relabel i -> unit*i+shift and transport the Fourier coefficients."""
   545	    transformed = copy.deepcopy(inst)
   546	    N = inst["N"]
   547	    unit %= N
   548	    shift %= N
   549	    if math.gcd(unit, N) != 1:
   550	        raise ValueError("unit must be invertible modulo N")
   551	    transformed["selector"] = [
   552	        (unit * i + shift) % N for i in inst["selector"]
   553	    ]
   554	    random.Random(shuffle_seed).shuffle(transformed["selector"])
   555	    inverse = pow(unit, -1, N)
   556	    transformed["answer"] = [
   557	        inst["answer"][(inverse * (a + shift)) % N] for a in range(N)
   558	    ]
   559	    return transformed
