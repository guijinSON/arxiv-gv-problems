+def _coefficient_vector(M: int, selector: list[int]) -> list[int]:
+    """Proof-produced certificate, using the unique aligned selected lift."""
+    selected = [0] * M
+    for i in selector:
+        selected[i % M] = i
+    answer = []
+    for a in range(2 * M):
+        i = selected[(-a) % M]
+        quotient = (a + i) // M
