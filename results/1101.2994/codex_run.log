   409	def _least_rotation(data: bytes) -> bytes:
   410	    """Booth's O(n) lexicographically least cyclic rotation."""
   411	    if not data:
   412	        return data
   413	    doubled = data + data
   414	    n = len(data)
   415	    i, j, k = 0, 1, 0
   416	    while i < n and j < n and k < n:
   417	        left = doubled[i + k]
   418	        right = doubled[j + k]
   419	        if left == right:
   420	            k += 1
   421	            continue
   422	        if left > right:
   423	            i = i + k + 1
   424	            if i <= j:
   425	                i = j + 1
   426	        else:
   427	            j = j + k + 1
   428	            if j <= i:
   429	                j = i + 1
   430	        k = 0
   431	    start = min(i, j)
   432	    return doubled[start : start + n]
