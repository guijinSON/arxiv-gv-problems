+    "For fixed a+i, the odd powers of a primitive 2M-th root form one complete "
+    "M-term geometric orbit."
+)
+PLACEBO_HINT: str = (
+    "For each requested coefficient, careful bookkeeping of the displayed "
+    "indices prevents sign and ordering errors."
+)
+
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "algebra",
