+    old_to_new = {old: new for new, old in enumerate(new_to_old)}
+    edges = []
+    for old_edge in inst["edges"]:
+        new_edge = [old_to_new[vertex] for vertex in old_edge]
+        rng.shuffle(new_edge)
+        edges.append(new_edge)
+    rng.shuffle(edges)
