-    n = params["n"]
-    m = params.get("m", 3 * n)
-    if m < 5 * n:
-        params["m"] = min(5 * n, m + max(1, n // 4))
-        return params
-    # The fixed-length density axis has been exhausted.  More vertices would
-    # take the 240-atom hard answer over the published 256-atom ceiling.
-    return "cap_bound"
