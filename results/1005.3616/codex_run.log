-def _wl_digest(kind, old, neighbor_colours):
-    payload = json.dumps(
-        [kind, old, sorted(neighbor_colours)],
-        separators=(",", ":"),
-    )
-    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
