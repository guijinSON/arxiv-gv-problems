-    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
-    shipping = make_instance(seed=10053616, **shipping_params)
-    planted = shipping["answer"]
-    corruptions = {
-        "drop_one": planted[:-1],
-        "swap_two": _find_bad_swap(shipping),
