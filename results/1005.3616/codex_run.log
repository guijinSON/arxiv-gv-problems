import random, math, time

def gen(n=180,m=600,seed=0):
 r=random.Random(seed); plant=[i//(n//3) for i in range(n)]; r.shuffle(plant); E=set(); tries=0
 while len(E)<m:
  e=tuple(sorted(r.sample(range(n),4))); tries+=1
  if e in E: continue
  cnt=sorted([sum(plant[v]==c for v in e) for c in range(3)],reverse=True)
  if cnt==[3,1,0]: ok=True
  elif cnt==[2,1,1]: ok=r.randrange(3)<2
  else: ok=False
  if ok:E.add(e)
 return plant,list(E)

def valid(a,E):
 for e in E:
  c=[0,0,0]
  for v in e:c[a[v]]+=1
  if 1 not in c:return False
 return True

def bads(a,E):
 out=[]
 for j,e in enumerate(E):
  c=[0,0,0]
  for v in e:c[a[v]]+=1
  if 1 not in c:out.append(j)
 return out

def local(n,E,seed,restarts=50,steps=20000):
 r=random.Random(seed); inc=[[] for _ in range(n)]
 for j,e in enumerate(E):
  for v in e:inc[v].append(j)
 for rr in range(restarts):
  a=[i//(n//3) for i in range(n)];r.shuffle(a)
  bad=set(bads(a,E))
  for st in range(steps):
   if not bad:return True,rr,st
   j=r.choice(tuple(bad)); v=r.choice(E[j]); cv=a[v]
   # swap with 20 random vertices of other colors, min bad delta + noise
   best=[];bestscore=10**9
   for w in r.sample(range(n),20):
    if a[w]==cv:continue
    affected=set(inc[v])|set(inc[w]); before=sum(x in bad for x in affected)
    a[v],a[w]=a[w],a[v]
    after=0
    for x in affected:
     e=E[x]; c=[0,0,0]
     for u in e:c[a[u]]+=1
     after+=1 not in c
    a[v],a[w]=a[w],a[v]
    score=after-before
    if score<bestscore:bestscore=score;best=[w]
    elif score==bestscore:best.append(w)
   if not best:continue
   w=r.choice(best); affected=set(inc[v])|set(inc[w]);a[v],a[w]=a[w],a[v]
   for x in affected:
    e=E[x];c=[0,0,0]
    for u in e:c[a[u]]+=1
    if 1 in c:bad.discard(x)
    else:bad.add(x)
 return False,restarts,steps

for alpha in [2.5,3.0,3.3,3.5,3.7,4.0,5.0]:
 wins=0;ts=time.time(); stats=[]
 for seed in range(4):
  p,E=gen(180,int(alpha*180),seed)
  assert valid(p,E)
  q=local(180,E,1000+seed,restarts=8,steps=3000)
  wins+=q[0];stats.append(q)
 print(alpha,wins,stats,'sec',round(time.time()-ts,2))
