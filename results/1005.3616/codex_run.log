-        "hits": guess_hits,
-        "total": _GUESS_SAMPLES,
-        "observed_fraction": guess_fraction,
-        "structure_aware_space": search_space(shipping),
-        "prior": "uniform over surjective length-n ternary strings",
-        "wall_clock_sec": round(guess_wall, 6),
