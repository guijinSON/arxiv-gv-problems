-def _greedy_candidate(inst, rng, random_order=False):
-    n = inst["n"]
-    edges = inst["edges"]
-    incident = _incidence(inst)
-    order = list(range(n))
-    if random_order:
-        rng.shuffle(order)
-    else:
-        order.sort(key=lambda v: (-len(incident[v]), v))
-    answer = [-1] * n
