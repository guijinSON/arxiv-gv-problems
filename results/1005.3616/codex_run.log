-
-    attack_names = [
-        "outlier_degree_tertiles",
-        "input_period_012",
-        "greedy_most_incident",
-        "random_greedy_restart_64",
-        "min_conflicts_restart_16x1500",
-        "pair_spectral_two_vector",
-        "binary_parity_gaussian",
-        "dpll_domain_propagation_10000",
