-            edges.add(edge)
-        elif kind == (2, 1, 1) and rng.randrange(denominator) < numerator:
-            edges.add(edge)
-    if len(edges) != m:
-        raise RuntimeError("edge rejection sampler exceeded its deterministic cap")
-    return sorted(edges), draws, [numerator, denominator]
