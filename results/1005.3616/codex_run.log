+            time.perf_counter() - start
+        )
+        attack_operations["greedy_most_incident"] += operations
+        timed_candidates["greedy_most_incident"] = greedy
+
+        start = time.perf_counter()
+        restarted, _won, operations = _attack_random_greedy(inst, rng, 64)
