-        parity = 0
-        while row:
-            bit = row & -row
-            parity ^= answer[bit.bit_length() - 1]
-            row ^= bit
-            if counts is not None:
-                counts["back_substitutions"] += 1
-        answer[pivot] = rhs_basis[pivot] ^ parity
-    return answer
