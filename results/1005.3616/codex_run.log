-        "",
-        f"Hyperedges ({inst['m']} rows, in the format edge-ID: four vertices):",
-    ]
-    for edge_id, edge in enumerate(inst["edges"]):
-        lines.append(f"{edge_id}: {' '.join(str(vertex) for vertex in edge)}")
-    lines.extend([
