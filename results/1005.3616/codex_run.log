-        "paper": "arXiv:1005.3616",
-        "family": "pair-neutral planted 3-CF-colouring",
-        "n": n,
-        "m": m,
-        "colour_count": 3,
-        "edge_size": 4,
-        "edges": [list(edge) for edge in edges],
-        "pair_neutral_weight_211": acceptance_weight,
-        "generation_attempts": attempt,
