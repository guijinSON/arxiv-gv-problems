+    for e in edges:
+        counts=[0,0,0]
+        for v in e:
+            counts[a[v]]+=1
+        if 1 not in counts:
+            return False
+    return True
+
+def is_bad(a,e):
+    counts=[0,0,0]
+    for v in e:
+        counts[a[v]]+=1
+    return 1 not in counts
