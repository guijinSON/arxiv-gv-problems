@@ -0,0 +1,180 @@
+import random, time
+
+def gen(n=180,m=600,seed=0):
+    r=random.Random(seed)
+    plant=[c for c in range(3) for _ in range(n//3)]
+    r.shuffle(plant)
+    edges=set()
+    while len(edges)<m:
+        e=tuple(sorted(r.sample(range(n),4)))
+        if e in edges:
+            continue
+        counts=sorted((sum(plant[v]==c for v in e) for c in range(3)), reverse=True)
+        if counts==[3,1,0] or (counts==[2,1,1] and r.randrange(3)<2):
+            edges.add(e)
+    return plant,list(edges)
+
+def valid(a,edges):
+    for e in edges:
+        counts=[0,0,0]
+        for v in e:
+            counts[a[v]]+=1
+        if 1 not in counts:
+            return False
+    return True
+
+def is_bad(a,e):
+    counts=[0,0,0]
+    for v in e:
+        counts[a[v]]+=1
+    return 1 not in counts
+
+def local(n,edges,seed,restarts=8,steps=5000,samples=8):
+    r=random.Random(seed)
+    inc=[[] for _ in range(n)]
+    for j,e in enumerate(edges):
+        for v in e:
+            inc[v].append(j)
+    for rr in range(restarts):
+        a=[c for c in range(3) for _ in range(n//3)]
+        r.shuffle(a)
+        bad={j for j,e in enumerate(edges) if is_bad(a,e)}
+        for st in range(steps):
+            if not bad:
+                return True,rr,st
+            j=r.choice(tuple(bad))
+            v=r.choice(edges[j])
+            pool=[w for w in range(n) if a[w]!=a[v]]
+            choices=r.sample(pool,min(samples,len(pool)))
+            best_score=999
+            best=[]
+            for w in choices:
+                affected=set(inc[v])|set(inc[w])
+                before=sum(x in bad for x in affected)
+                a[v],a[w]=a[w],a[v]
+                after=sum(is_bad(a,edges[x]) for x in affected)
+                a[v],a[w]=a[w],a[v]
+                score=after-before
+                if score<best_score:
+                    best_score=score;best=[w]
+                elif score==best_score:
+                    best.append(w)
+            w=r.choice(best)
+            affected=set(inc[v])|set(inc[w])
+            a[v],a[w]=a[w],a[v]
+            for x in affected:
+                if is_bad(a,edges[x]): bad.add(x)
+                else: bad.discard(x)
+    return False,restarts,steps
+
+def dpll(n, edges, cap=100000):
+    inc=[[] for _ in range(n)]
+    for j,e in enumerate(edges):
+        for v in e: inc[v].append(j)
+    a=[-1]*n; used=[0,0,0]; target=n//3; nodes=0
+    # Cache local feasibility by (counts tuple, open slots).
+    def edge_possible(e):
+        cnt=[0,0,0]; open_=0
+        for v in e:
+            if a[v]<0: open_+=1
+            else: cnt[a[v]]+=1
+        for x in range(open_+1):
+            for y in range(open_-x+1):
+                z=open_-x-y
+                if 1 in (cnt[0]+x,cnt[1]+y,cnt[2]+z): return True
+        return False
+    def rec(left):
+        nonlocal nodes
+        nodes+=1
+        if nodes>cap:return None
+        if left==0:return a.copy()
+        # Fail global capacities.
+        if any(used[c]>target or used[c]+left<target for c in range(3)):return None
+        # Most constrained = greatest assigned-neighbor pressure, then degree.
+        best=None;bestkey=None
+        for v in range(n):
+            if a[v]>=0:continue
+            hist=[0]*5
+            for j in inc[v]:
+                assigned=sum(a[u]>=0 for u in edges[j])
+                hist[assigned]+=1
+            key=(hist[3],hist[2],hist[1],len(inc[v]))
+            if bestkey is None or key>bestkey:bestkey=key;best=v
+        colors=sorted(range(3),key=lambda c:used[c])
+        if nodes==1:colors=[0]
+        for c in colors:
+            if used[c]>=target:continue
+            a[best]=c;used[c]+=1
+            if all(edge_possible(edges[j]) for j in inc[best]):
+                got=rec(left-1)
+                if got is not None:return got
+            used[c]-=1;a[best]=-1
+        return None
+    got=rec(n)
+    return got,nodes
+
+def dpll2(n,edges,cap=100000):
+    inc=[[] for _ in range(n)]
+    for j,e in enumerate(edges):
+        for v in e:inc[v].append(j)
+    a=[-1]*n;nodes=0;props=0
+    def assign(start,val,trail):
+        nonlocal props
+        queue=[(start,val)]
+        while queue:
+            v,c=queue.pop()
+            if a[v]>=0:
+                if a[v]!=c:return False
+                continue
+            a[v]=c;trail.append(v)
+            for j in inc[v]:
+                e=edges[j]; vals=[a[u] for u in e]; open_=[u for u in e if a[u]<0]
+                if not open_:
+                    if vals[0]==vals[1]==vals[2]:return False
+                elif len(open_)==1:
+                    fixed=[x for x in vals if x>=0]
+                    if fixed[0]==fixed[1]:
+                        props+=1;queue.append((open_[0],1-fixed[0]))
+        return True
+    def undo(trail):
+        for v in trail:a[v]=-1
+    def rec():
+        nonlocal nodes
+        nodes+=1
+        if nodes>cap:return None
+        best=-1;key=None
+        for v in range(n):
+            if a[v]>=0:continue
+            # Prefer variables in constraints with two assigned, then one.
+            h=[0,0,0]
+            for j in inc[v]:h[sum(a[u]>=0 for u in edges[j])]+=1
+            k=(h[2],h[1],len(inc[v]))
+            if key is None or k>key:key=k;best=v
+        if best<0:return a.copy()
+        for c in (0,1):
+            trail=[]
+            if assign(best,c,trail):
+                got=rec()
+                if got is not None:return got
+            undo(trail)
+        return None
+    trail=[]; assign(0,0,trail)
+    got=rec()
+    return got,nodes,props
+
+if __name__=='__main__':
+    for alpha in []:
+        wins=0; start=time.time(); stats=[]
+        for seed in range(4):
+            p,e=gen(180,int(alpha*180),seed)
+            assert valid(p,e)
+            q=local(180,e,1000+seed)
+            wins+=q[0];stats.append(q)
+        print(alpha,wins,stats,round(time.time()-start,2),flush=True)
+    for alpha in [2.5,3.0,3.3,3.5,3.7,4.0]:
+        stats=[];start=time.time()
+        for seed in range(4):
+            p,e=gen(180,int(alpha*180),seed)
+            q,nodes=dpll(180,e,100000)
+            stats.append((q is not None,nodes))
+        print('dpll',alpha,stats,round(time.time()-start,2),flush=True)

