-def random_candidate(inst, rng):
-    """Sample uniformly from the stated surjective length-n ternary strings."""
-    while True:
-        candidate = [rng.randrange(3) for _ in range(inst["n"])]
-        if set(candidate) == {0, 1, 2}:
-            return candidate
-
