+        allowed = {symbol: set(range(width)) for symbol in symbols}
+        for index in component:
+            interval = {
+                embedded[index], embedded[index] + 1, embedded[index] + 2
+            }
+            for symbol in requirements[index]:
+                allowed[symbol].intersection_update(interval)
