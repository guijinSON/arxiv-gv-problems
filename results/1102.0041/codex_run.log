+def _window_has_target(answer: list[int], p: int, extra: list[int]) -> bool:
+    target_extra = set(extra)
+    width = p + 3
+    counts = [0] * p
+    for symbol in answer[:width]:
+        counts[symbol] += 1
+    mismatches = sum(
+        counts[symbol] != (2 if symbol in target_extra else 1)
+        for symbol in range(p)
+    )
+    if mismatches == 0:
+        return True
