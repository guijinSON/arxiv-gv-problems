+    blocks: list[list[int]] = []
+    for component in components:
+        coordinates = {component[0]: 0}
+        if len(component) > 1:
+            neighbor = next(iter(adjacency[component[0]]))
+            coordinates[neighbor] = adjacency[component[0]][neighbor]
