+            attacks[name]["successes"] += int(verify(inst, candidate)[0])
+        attack_operations["greedy_cooccurrence_walk"] += co_ops
+        attack_operations["overlap_walk_no_backtracking"] += overlap_ops
+        restart_rng = random.Random(seed ^ 0xC0FFEE)
