            f"symbols therefore defines a Q of size {p}+k.  Every listed Q "
            "must occur, but occurrences may overlap and may appear in any order."
        ),
        "",
        f"There are {len(extras)} requirements:",
    ]
    for index, extra in enumerate(extras):
