+        "nontrivial_transformations": nontrivial_checks,
+        "unrelated_distinct": len(set(unrelated_keys)),
+        "unrelated_attempts": len(unrelated_keys),
+        "invariant": "12-round bipartite incidence WL plus intersection profile",
+    }
