+        others = roots[:index] + roots[index + 1:]
+        # One multiplication and one addition, both reduced modulo p.
+        operations += 2
+        if (2 * candidate) % p == (others[0] + others[1]) % p:
+            midpoint = candidate
+            endpoints = others
