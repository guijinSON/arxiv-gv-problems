+        and search_space(doubled) > search_space(shipping),
+        "shipping_requested_n": ship_params["n"],
+        "shipping_p": shipping["p"],
+        "doubled_requested_n": doubled_params["n"],
+        "doubled_p": doubled["p"],
+        "doubled_planted_verifies": doubled_ok,
