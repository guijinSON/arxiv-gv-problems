+                return dict(coordinates)
+            choices = []
+            for node in component:
+                if node in coordinates:
+                    continue
+                placed_neighbors = [
+                    neighbor for neighbor in adjacency[node]
+                    if neighbor in coordinates
+                ]
+                if not placed_neighbors:
+                    continue
