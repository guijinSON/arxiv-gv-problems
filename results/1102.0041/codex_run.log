import random,time,statistics

def graph(n,seed,extra_matchings=1):
 r=random.Random(seed)
 order=list(range(n));r.shuffle(order); w,s=order[0],order[-1]
 es={tuple(sorted((order[i],order[i+1]))) for i in range(n-1)}
 # add k random perfect matchings avoiding duplicates via retries
 for k in range(extra_matchings):
