codex
The live oracle results exposed the construction flaw the earlier attack panel missed: both vendors solved `easy`, and their witnesses are not the planted cubic cycle. They are assembling the excess triples as an ordinary set consecutive-ones instance—the linear-time easy regime identified in Section 1.2. I’m testing that construction-aware route at the shipping preset now; if it succeeds, this draft cannot honestly ship even as Track B with its current hardness claim.
exec
/bin/bash -lc "python3 - <<'PY'
import random,time
import gen_1102_0041 as g

def score(order, constraints):
 pos=[0]*len(order)
 for i,x in enumerate(order): pos[x]=i
 return sum(max(pos[x] for x in q)-min(pos[x] for x in q)-(len(q)-1) for q in constraints)

def solve(inst, seed):
 rng=random.Random(seed)
 p=inst['p']; qs=inst['constraints']
 # Frequency/cooccurrence nearest-neighbour starts, then simulated annealing swaps.
 freq=[0]*p; pair=[[0]*p for _ in range(p)]
 for q in qs:
  for x in q: freq[x]+=1
  for x in q:
   for y in q:
    if x<y: pair[x][y]+=1; pair[y][x]+=1
 best=None; bests=10**9
 for restart in range(10):
  if restart==0:
   unused=set(range(p)); cur=min(unused,key=lambda x:(freq[x],x)); order=[cur];unused.remove(cur)
   while unused:
    cur=max(unused,key=lambda x:(pair[order[-1]][x],-freq[x],-x));order.append(cur);unused.remove(cur)
  else:
   order=list(range(p));rng.shuffle(order)
  s=score(order,qs)
  T=5.0
  for it in range(30000):
   a,b=rng.sample(range(p),2)
   order[a],order[b]=order[b],order[a]
   ns=score(order,qs)
   if ns==0: return order,restart,it
   import math
   if ns<=s or rng.random()<math.exp((s-ns)/T): s=ns
   else: order[a],order[b]=order[b],order[a]
   T=max(.03,T*.9998)
   if s<bests: bests=s;best=order[:]
 return None,bests,None

for seed in range(9100,9108):
 inst=g.make_instance(seed=seed,**g.DIFFICULTY['hard'])
 t=time.perf_counter();o,a,b=solve(inst,seed"'^12345);dt=time.perf_counter()-t
 ok=g.verify(inst,o+o)[0] if o else False
 print(seed,ok,a,b,round(dt,3))
