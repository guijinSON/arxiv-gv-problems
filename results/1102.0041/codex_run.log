 for extra in inst['"'constraints']:
  target=collections.Counter(range(p)); target.update(extra); w=p+3
  if not any(collections.Counter(a[s:s+w])==target for s in range(len(a)-w+1)): return False
 return True
for preset,params in g.DIFFICULTY.items():
 for seed in range(40):
