+        best = [decoy for decoy in candidates
+                if remaining[decoy] == best_capacity]
+        decoy = rng.choice(best)
+        chosen.append(decoy)
+        remaining[decoy] -= 1
+        for special in base:
+            forbidden_with_special.setdefault(special, set()).add(decoy)
+    rights.append(list(base) + chosen)
+    return True
