+NOTES = r"""
+Definition and exact paper object.  Section 2 defines the open neighborhood
+Gamma(v).  The Twin Reduction subsection of Section 4 defines a,b to be twins
+when Gamma(a)=Gamma(b).  Theorem 4 proves that two twins can occur consecutively
+in a minimum-fill ordering, and the following exact reduction contracts one of
+them and later expands the ordering.  The generated object is the same
+undirected graph object used by that theorem.  The left/right presentation is
+only a compact edge-list format; it is not a reduction to another domain.
+
+Step-0 algorithm and Track choice.  Track A would be false.  Section 4's
+implementation computes an open-neighborhood hash, sorts hashes, and compares
+candidate neighborhoods; the paper states O(mn+n log n) worst-case time.  On
+these fixed-degree bipartite instances, sorting each five-entry row and then
+sorting the rows gives O(nd log d+n log n).  selftest measures that successful
+reference algorithm at the shipping preset.  The intended no-tool route is the
+short symmetry recognition that three displayed rows encode the same set; once
+noticed, only two five-entry set equalities and three shape checks remain.
+
+Construction.  The answer is chosen first as three provisional left vertices.
+Five edge-disjoint perfect matchings are assembled around them so that all three
+have the same five right neighbors.  In each matching they use three different
+right endpoints, cyclically shifted, and the remaining endpoints are matched by
+fresh random permutations avoiding repeated edges.  Thus every vertex on both
+sides has degree five.  Independent random permutations relabel both sides,
+shuffle every row, and shuffle the row order.  The stored witness is carried
+through those maps.  Generation never calls the reference twin detector.
+
+Easy regimes and attacks.  Section 3 notes that chordal graphs have a linear-time
+perfect-elimination algorithm, and Section 4 gives the direct twin detector just
+described.  This benchmark therefore asks only for the reduction witness and is
+explicitly Track B.  Regularity removes degree outliers.  Random relabelling
+removes position and magnitude cues.  The adversary panel tests the first three
+rows, the three smallest neighborhood sums, a first-row maximum-overlap greedy
+rule, a fixed affine-label ansatz, and random legal triples.  The full normalized
+row comparison is successful and is reported separately as the reference
+algorithm, as Track B requires.
+
+Canonicalization.  Independent permutations of left labels and right labels,
+row order, neighbor order, and their compositions preserve the task.  The key
+uses six rounds of bipartition-aware Weisfeiler-Lehman neighborhood hashing and
+an edge-color multiset.  It is a strong polynomial invariant, not a complete
+bipartite-graph isomorphism canon; this limitation is recorded in README.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def _validate_parameters(n: int, degree: int) -> tuple[int, int]:
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise ValueError("n must be an integer")
+    if isinstance(degree, bool) or not isinstance(degree, int):
+        raise ValueError("degree must be an integer")
+    if degree < 3:
+        raise ValueError("degree must be at least 3")
+    if n < degree + 3:
+        raise ValueError("n must be at least degree+3")
+    return n, degree
+
+
+def _regular_rows(n: int, degree: int, rng: random.Random) -> list[list[int]]:
+    """Build a simple d-regular bipartite graph with rows 0,1,2 equal.
+
+    Each of the d layers is a perfect matching.  The first three left vertices
+    use cyclic shifts through the same d right vertices.  Random permutations
+    complete each matching while avoiding every edge used by an earlier layer.
+    This constructs the witness; it does not search the finished graph for one.
+    """
+
+    planted = (0, 1, 2)
+    for _graph_attempt in range(200):
+        used = [set() for _ in range(n)]
+        rows = [[] for _ in range(n)]
+        failed = False
+        for layer in range(degree):
+            assignment = [-1] * n
+            occupied = set()
+            for offset, left in enumerate(planted):
+                right = (layer + offset) % degree
+                assignment[left] = right
+                occupied.add(right)
+
+            left_rest = list(range(3, n))
+            right_rest = [right for right in range(n) if right not in occupied]
+            accepted = None
+            # A random completion avoids only `layer` previous choices per row;
+            # with fixed degree the acceptance probability stays constant.
+            for _ in range(4_000):
+                rng.shuffle(right_rest)
+                if all(right not in used[left]
+                       for left, right in zip(left_rest, right_rest)):
+                    accepted = list(right_rest)
+                    break
+            if accepted is None:
+                failed = True
+                break
+            for left, right in zip(left_rest, accepted):
+                assignment[left] = right
+            if sorted(assignment) != list(range(n)):
+                raise AssertionError("matching layer is not a permutation")
+            for left, right in enumerate(assignment):
+                if right in used[left]:
+                    raise AssertionError("repeated bipartite edge")
+                used[left].add(right)
+                rows[left].append(right)
+        if failed:
+            continue
+        if any(len(set(row)) != degree for row in rows):
+            continue
+        right_degrees = [0] * n
+        for row in rows:
+            for right in row:
+                right_degrees[right] += 1
+        if any(value != degree for value in right_degrees):
+            continue
+        # The planted class must be the only class large enough to answer the
+        # three-vertex task.  This is a construction-quality check, not a call
+        # that discovers the already chosen answer.
+        groups = Counter(tuple(sorted(row)) for row in rows)
+        if groups[tuple(range(degree))] == 3 and max(groups.values()) == 3:
+            return rows
+    raise RuntimeError("could not construct a unique three-row twin block")
+
+
+def make_instance(n: int, seed: int = 0, degree: int = 5, **params) -> dict:
+    """Inverse-generate a regular bipartite graph with a known twin triple."""
+
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    n, degree = _validate_parameters(n, degree)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+    rng = random.Random(seed)
+    rows = _regular_rows(n, degree, rng)
+
+    left_map = list(range(n))
+    right_map = list(range(n))
+    rng.shuffle(left_map)
+    rng.shuffle(right_map)
+
+    displayed = []
+    normalized_rows = [None] * n
+    for old_left, old_neighbors in enumerate(rows):
+        neighbors = [right_map[right] for right in old_neighbors]
+        rng.shuffle(neighbors)
+        new_left = left_map[old_left]
+        displayed.append({"left": new_left, "neighbors": neighbors})
+        normalized_rows[new_left] = sorted(neighbors)
+    rng.shuffle(displayed)
+
+    return {
+        "paper": "arXiv:2004.11315",
+        "family": "three-vertex twin block in a regular bipartite graph",
+        "n": n,
+        "degree": degree,
+        "left_labels": list(range(n)),
+        "right_labels": list(range(n)),
+        "rows": displayed,
+        # A deterministic index of the same rendered rows lets verify() inspect a
+        # candidate in O(degree) time.  It contains no answer information.
+        "neighborhoods": normalized_rows,
+        "answer": sorted(left_map[left] for left in (0, 1, 2)),
+    }
+
+
+def render(inst: dict) -> str:
+    """Render the complete graph problem and its exact answer contract."""
+
+    n = inst["n"]
+    degree = inst["degree"]
+    lines = [
+        "Find a three-vertex twin block in the following undirected bipartite graph.",
+        "",
+        "Definitions and conventions:",
+        f"The graph has left vertices L0,...,L{n - 1} and right vertices R0,...,R{n - 1}.",
+        "Left and right labels are separate even when their integers are equal.",
+        "Every edge has one left and one right endpoint; no other edges exist.",
+        f"Every vertex has degree exactly {degree}.",
+        "The open neighborhood N(v) is the set of vertices joined to v by an edge; v itself is not included.",
+        "Two distinct vertices are twins when their open neighborhoods are exactly equal as sets.",
+        "Find exactly three distinct LEFT vertices that are pairwise twins.",
+        "Output their integer labels in strictly increasing order. Labels are zero-based and repeats are forbidden.",
+        "The order of right labels within a row and the order of the rows carry no meaning.",
+        "",
+        "Adjacency rows. Each line `Li: r1 r2 ...` lists exactly the right neighbors of Li:",
+    ]
+    for row in inst["rows"]:
+        lines.append(
+            "L{}: {}".format(row["left"], " ".join(map(str, row["neighbors"])))
+        )
+    lines.extend([
+        "",
+        "Give your final answer inside <answer></answer> tags, as exactly three comma-separated left-vertex integer labels.",
+        "Example: <answer>3, 17, 42</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract one tagged three-integer list, tolerating prose and fences."""
+
+    try:
+        if not isinstance(text, str):
+            return None
+        matches = _ANSWER_RE.findall(text)
+        if len(matches) != 1:
+            return None
+        body = matches[0].strip()
+        body = re.sub(r"^```(?:text|json|python)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body).strip()
+        if body.startswith("[") and body.endswith("]"):
+            body = body[1:-1].strip()
+        if not re.fullmatch(r"[+-]?\d+(?:\s*(?:,|\s)\s*[+-]?\d+){2}", body):
+            return None
+        pieces = [piece for piece in re.split(r"\s*,\s*|\s+", body) if piece]
+        if len(pieces) != 3:
+            return None
+        return [int(piece) for piece in pieces]
+    except (TypeError, ValueError, OverflowError):
+        return None
+
+
+def _row_map(inst: dict) -> dict[int, frozenset[int]] | None:
+    try:
+        n = inst["n"]
+        indexed = inst.get("neighborhoods")
+        if isinstance(indexed, list) and len(indexed) == n:
+            result = {}
+            for left, neighbors in enumerate(indexed):
+                if (not isinstance(neighbors, list)
+                        or any(isinstance(v, bool) or not isinstance(v, int)
+                               or not 0 <= v < n for v in neighbors)
+                        or len(set(neighbors)) != len(neighbors)):
+                    return None
+                result[left] = frozenset(neighbors)
+            return result
+        result = {}
+        for row in inst["rows"]:
+            left = row["left"]
+            neighbors = row["neighbors"]
+            if (isinstance(left, bool) or not isinstance(left, int)
+                    or not 0 <= left < n or left in result):
+                return None
+            if (not isinstance(neighbors, list)
+                    or any(isinstance(v, bool) or not isinstance(v, int)
+                           or not 0 <= v < n for v in neighbors)):
+                return None
+            if len(set(neighbors)) != len(neighbors):
+                return None
+            result[left] = frozenset(neighbors)
+        if set(result) != set(range(n)):
+            return None
+        return result
+    except (KeyError, TypeError):
+        return None
+
+
+def verify(inst: dict, answer) -> tuple[bool, str]:
+    """Accept every increasing left triple with identical open neighborhoods."""
+
+    if not isinstance(answer, list):
+        return False, "answer must be a list"
+    if len(answer) == 0:
+        return False, "answer is empty"
+    if len(answer) != 3:
+        return False, "answer must contain exactly three labels"
+    if any(isinstance(value, bool) or not isinstance(value, int) for value in answer):
+        return False, "every label must be an integer"
+    if len(set(answer)) != 3:
+        return False, "the three labels must be distinct"
+    if answer != sorted(answer):
+        return False, "labels must be in strictly increasing order"
+    n = inst.get("n")
+    if any(value < 0 or value >= n for value in answer):
+        return False, "a label is outside the left-vertex range"
+    indexed = inst.get("neighborhoods")
+    if not isinstance(indexed, list) or len(indexed) != n:
+        return False, "instance adjacency rows are malformed"
+    selected = [indexed[left] for left in answer]
+    if any(not isinstance(row, list)
+           or any(isinstance(v, bool) or not isinstance(v, int)
+                  or not 0 <= v < n for v in row)
+           or len(set(row)) != len(row) for row in selected):
+        return False, "instance adjacency rows are malformed"
+    first = frozenset(selected[0])
+    if frozenset(selected[1]) != first or frozenset(selected[2]) != first:
+        return False, "the three open neighborhoods are not equal"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from the statement-aware space of increasing triples."""
+
+    return sorted(rng.sample(range(inst["n"]), 3))
+
+
+def search_space(inst: dict) -> int | None:
+    """Number of legal increasing triples of left labels."""
+
+    return math.comb(inst["n"], 3)
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count valid answers exactly by grouping normalized adjacency rows."""
+
+    rows = _row_map(inst)
+    if rows is None:
+        return None
+    counts = Counter(rows.values())
+    return sum(math.comb(count, 3) for count in counts.values() if count >= 3)
+
+
+def _wl_key_payload(inst: dict) -> tuple | None:
+    rows = _row_map(inst)
+    if rows is None:
+        return None
+    n = inst["n"]
+    left_adj = [rows[left] for left in range(n)]
+    right_adj = [set() for _ in range(n)]
+    for left, neighbors in enumerate(left_adj):
+        for right in neighbors:
+            right_adj[right].add(left)
+
+    left_colors = [hashlib.sha256(b"left").hexdigest() for _ in range(n)]
+    right_colors = [hashlib.sha256(b"right").hexdigest() for _ in range(n)]
+    for _ in range(6):
+        new_left = []
+        for left in range(n):
+            signature = ("L", left_colors[left],
+                         tuple(sorted(right_colors[r] for r in left_adj[left])))
+            new_left.append(hashlib.sha256(repr(signature).encode()).hexdigest())
+        new_right = []
+        for right in range(n):
+            signature = ("R", right_colors[right],
+                         tuple(sorted(left_colors[l] for l in right_adj[right])))
+            new_right.append(hashlib.sha256(repr(signature).encode()).hexdigest())
+        left_colors, right_colors = new_left, new_right
+
+    # Color refinement alone cannot distinguish regular bipartite graphs when
+    # started only from the bipartition.  Add exact same-side codegree profiles
+    # (and edge-local 4-cycle counts), which vary across the random constructions
+    # while remaining invariant under independent relabelling of both sides.
+    left_pair_counts = Counter()
+    for neighbors in right_adj:
+        ordered = sorted(neighbors)
+        for i, left in enumerate(ordered):
+            for other in ordered[i + 1:]:
+                left_pair_counts[(left, other)] += 1
+    right_pair_counts = Counter()
+    for neighbors in left_adj:
+        ordered = sorted(neighbors)
+        for i, right in enumerate(ordered):
+            for other in ordered[i + 1:]:
+                right_pair_counts[(right, other)] += 1
+
+    def profiles(pair_counts):
+        values = [[] for _ in range(n)]
+        for (a, b), count in pair_counts.items():
+            values[a].append(count)
+            values[b].append(count)
+        result = []
+        for vertex_values in values:
+            signature = (n - 1 - len(vertex_values), tuple(sorted(vertex_values)))
+            result.append(hashlib.sha256(repr(signature).encode()).hexdigest())
+        return result
+
+    left_profiles = profiles(left_pair_counts)
+    right_profiles = profiles(right_pair_counts)
+
+    edge_cycle_profiles = []
+    for left, neighbors in enumerate(left_adj):
+        for right in neighbors:
+            four_cycles = 0
+            for other in neighbors:
+                if other == right:
+                    continue
+                pair = (right, other) if right < other else (other, right)
+                four_cycles += right_pair_counts[pair] - 1
+            edge_cycle_profiles.append(
+                (left_profiles[left], right_profiles[right], four_cycles)
+            )
+    edge_colors = sorted(
+        (left_colors[left], right_colors[right])
+        for left in range(n) for right in left_adj[left]
+    )
+    return (
+        n,
+        inst["degree"],
+        tuple(sorted(left_colors)),
+        tuple(sorted(right_colors)),
+        tuple(edge_colors),
+        tuple(sorted(left_profiles)),
+        tuple(sorted(right_profiles)),
+        tuple(sorted(edge_cycle_profiles)),
+    )
+
+
+def canonical_key(inst: dict) -> str:
+    """A strong label-, row-, and neighbor-order invariant of the bipartite graph."""
+
+    payload = _wl_key_payload(inst)
+    if payload is None:
+        return "malformed"
+    return hashlib.sha256(repr(payload).encode()).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow the two graph sides while keeping the three-label answer fixed."""
+
+    if not isinstance(params, dict) or "n" not in params:
+        return None
+    harder = dict(params)
+    harder["n"] = max(params["n"] + 100, (params["n"] * 3) // 2)
+    return harder
+
+
+def _reference_row_sort(inst: dict) -> tuple[list[int] | None, int]:
+    """The successful domain algorithm: normalize and sort all incidence rows."""
+
+    operations = 0
+    normalized = []
+    d = inst["degree"]
+    sort_factor = max(1, math.ceil(math.log2(max(2, d))))
+    for row in inst["rows"]:
+        neighbors = tuple(sorted(row["neighbors"]))
+        operations += len(neighbors) * sort_factor
+        normalized.append((neighbors, row["left"]))
+    normalized.sort()
+    operations += len(normalized) * math.ceil(math.log2(max(2, len(normalized))))
+    run = []
+    previous = None
+    for neighbors, left in normalized:
+        operations += 1
+        if neighbors != previous:
+            run = [left]
+            previous = neighbors
+        else:
+            run.append(left)
+            if len(run) == 3:
+                return sorted(run), operations
+    return None, operations
+
+
+def _attack_first_rows(inst: dict) -> list[int]:
+    return sorted(row["left"] for row in inst["rows"][:3])
+
+
+def _attack_smallest_neighbor_sums(inst: dict) -> list[int]:
+    rows = sorted(inst["rows"], key=lambda row: (sum(row["neighbors"]), row["left"]))
+    return sorted(row["left"] for row in rows[:3])
+
+
+def _attack_first_row_overlap(inst: dict) -> list[int]:
+    anchor = inst["rows"][0]
+    anchor_set = set(anchor["neighbors"])
+    others = sorted(
+        inst["rows"][1:],
+        key=lambda row: (-len(anchor_set.intersection(row["neighbors"])), row["left"]),
+    )
+    return sorted([anchor["left"], others[0]["left"], others[1]["left"]])
+
+
+def _attack_affine_labels(inst: dict) -> list[int]:
+    n = inst["n"]
+    return sorted({0, n // 2, n - 1})
+
+
+def _attack_random_restarts(inst: dict, seed: int, trials: int = 2_048):
+    rng = random.Random(seed)
+    last = None
+    for attempt in range(1, trials + 1):
+        last = random_candidate(inst, rng)
+        if verify(inst, last)[0]:
+            return last, attempt
+    return last, trials
+
+
+def _relabel_instance(
+    inst: dict,
+    left_permutation: list[int],
+    right_permutation: list[int],
+    shuffle_seed: int,
+) -> dict:
+    transformed = dict(inst)
+    rng = random.Random(shuffle_seed)
+    rows = []
+    for row in inst["rows"]:
+        neighbors = [right_permutation[right] for right in row["neighbors"]]
+        rng.shuffle(neighbors)
+        rows.append({
+            "left": left_permutation[row["left"]],
+            "neighbors": neighbors,
+        })
+    rng.shuffle(rows)
+    transformed["rows"] = rows
+    indexed = [None] * inst["n"]
+    for row in rows:
+        indexed[row["left"]] = sorted(row["neighbors"])
+    transformed["neighborhoods"] = indexed
+    transformed["answer"] = sorted(left_permutation[left] for left in inst["answer"])
+    return transformed
+
+
+def _answer_elements(answer) -> int:
+    if isinstance(answer, dict):
+        return sum(_answer_elements(value) for value in answer.values())
+    if isinstance(answer, list):
+        return sum(_answer_elements(value) for value in answer)
+    return 1
+
+
+def selftest() -> dict:
+    """Run all mandatory correctness, density, attack, scaling, and key gates."""
+
+    report = {
+        "paper": "2004.11315",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    failures = []
+    checked = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in range(4):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            json_native = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            checked += 1
+            if not ok or not json_native:
+                failures.append({"preset": preset, "seed": seed, "reason": reason})
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "instances": checked,
+        "failures": failures,
+    }
+
+    ship = make_instance(seed=200411315, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = ship["answer"]
+    swapped = [planted[2], planted[1], planted[0]]
+    duplicate = [planted[0], planted[0], planted[2]]
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_two": swapped,
+        "duplicate_one": duplicate,
+        "empty": [],
+        "out_of_range": [planted[0], planted[1], ship["n"]],
+    }
+    outcomes = {name: verify(ship, value) for name, value in corruptions.items()}
+    reasons = {name: outcome[1] for name, outcome in outcomes.items()}
+    report["G2_rejects_corruption"] = {
+        "pass": all(not outcome[0] for outcome in outcomes.values())
+                and len(set(reasons.values())) == len(corruptions),
+        "rejected": {name: not outcome[0] for name, outcome in outcomes.items()},
+        "reasons": reasons,
+        "distinct_reasons": len(set(reasons.values())),
+    }
+
+    body = ", ".join(map(str, planted))
+    response = (
+        "The three normalized rows agree.\n```text\n"
+        f"<answer>\n{body}\n</answer>\n```\n"
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("garbage") is None,
+        "parsed_equals_answer": parsed == planted,
+        "garbage_returns_none": parse_answer("garbage") is None,
+    }
+
+    guess_rng = random.Random(40052026)
+    guess_total = 200_000
+    guess_hits = 0
+    density_start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(ship, random_candidate(ship, guess_rng))[0])
+    density_wall = time.perf_counter() - density_start
+    guess_probability = guess_hits / guess_total
+    exact_answers = enumerate_all(ship)
+    exact_space = search_space(ship)
+    exact_density = exact_answers / exact_space
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6 and exact_density < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_probability,
+        "exact_probability": exact_density,
+        "structure_aware_search_space": exact_space,
+        "candidate_prior": "uniform over all increasing triples of distinct left labels",
+        "wall_clock_seconds": round(density_wall, 6),
+    }
+
+    attack_seeds = [6101, 6113, 6121, 6131, 6143, 6151, 6163, 6173]
+    attack_instances = [
+        make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        for seed in attack_seeds
+    ]
+    attacks = {
+        "outlier_first_input_rows": {"successes": 0, "attempts": 0},
+        "greedy_smallest_neighbor_sums": {"successes": 0, "attempts": 0},
+        "greedy_first_row_max_overlap": {"successes": 0, "attempts": 0},
+        "in_context_affine_label_ansatz": {"successes": 0, "attempts": 0},
+        "random_restart_2048": {"successes": 0, "attempts": 0},
+    }
+    random_trials = 0
+    attack_start = time.perf_counter()
+    for seed, inst in zip(attack_seeds, attack_instances):
+        random_answer, trials = _attack_random_restarts(inst, seed ^ 0x5A17)
+        random_trials += trials
+        candidates = {
+            "outlier_first_input_rows": _attack_first_rows(inst),
+            "greedy_smallest_neighbor_sums": _attack_smallest_neighbor_sums(inst),
+            "greedy_first_row_max_overlap": _attack_first_row_overlap(inst),
+            "in_context_affine_label_ansatz": _attack_affine_labels(inst),
+            "random_restart_2048": random_answer,
+        }
+        for name, candidate in candidates.items():
+            attacks[name]["attempts"] += 1
+            attacks[name]["successes"] += int(verify(inst, candidate)[0])
+    attack_wall = time.perf_counter() - attack_start
+
+    reference_successes = 0
+    reference_operations = 0
+    reference_max_operations = 0
+    reference_start = time.perf_counter()
+    for inst in attack_instances:
+        candidate, operations = _reference_row_sort(inst)
+        reference_operations += operations
+        reference_max_operations = max(reference_max_operations, operations)
+        reference_successes += int(candidate is not None and verify(inst, candidate)[0])
+    reference_wall = time.perf_counter() - reference_start
+    all_attacks_failed = all(value["successes"] == 0 for value in attacks.values())
+    reference_algorithm = {
+        "name": "canonical sorting of all open-neighborhood incidence rows",
+        "complexity": "O(nd log d + n log n) comparisons for fixed-length bipartite rows",
+        "paper_algorithm": "Section 4 hash/sort/compare twin detection, O(mn+n log n) worst case",
+        "wall_clock_sec": round(reference_wall, 6),
+        "operations": reference_operations,
+        "max_operations_one_instance": reference_max_operations,
+        "solves": f"{reference_successes}/{len(attack_instances)}",
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == len(attack_instances),
+        "attacks": attacks,
+        "reference_algorithm": reference_algorithm,
+    }
+    report["G5_density_and_baseline_cost"] = {
+        "pass": exact_answers == 1 and exact_density < 1e-6 and all_attacks_failed,
+        "shipping_exact_solution_count": exact_answers,
+        "shipping_candidate_count": exact_space,
+        "shipping_exact_valid_fraction": exact_density,
+        "shipping_sample_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "density_wall_clock_seconds": round(density_wall, 6),
+        "strongest_failing_attack": "random_restart_2048 plus maximum-overlap and magnitude probes",
+        "baseline_wall_clock_seconds": round(attack_wall, 6),
+        "baseline_candidate_trials": random_trials + 4 * len(attack_instances),
+        "successful_reference_wall_clock_seconds": round(reference_wall, 6),
+        "successful_reference_operations": reference_operations,
+    }
+
+    before = make_instance(seed=771, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    after = make_instance(seed=771, **doubled_params)
+    g7_ok = (
+        verify(before, before["answer"])[0]
+        and verify(after, after["answer"])[0]
+        and after["n"] == 2 * before["n"]
+        and search_space(after) > search_space(before)
+        and len(after["answer"]) == len(before["answer"])
+    )
+    report["G7_scales"] = {
+        "pass": g7_ok,
+        "n_before": before["n"],
+        "n_after_size_doubling": after["n"],
+        "space_before": search_space(before),
+        "space_after": search_space(after),
+        "answer_elements_before": len(before["answer"]),
+        "answer_elements_after": len(after["answer"]),
+    }
+
+    invariant_checks = 0
+    invariant_passed = 0
+    carried_checks = 0
+    carried_passed = 0
+    unrelated_keys = []
+    for seed in range(20):
+        inst = make_instance(seed=8000 + seed, **DIFFICULTY["easy"])
+        base_key = canonical_key(inst)
+        unrelated_keys.append(base_key)
+        rng = random.Random(9000 + seed)
+        left_one = list(range(inst["n"]))
+        right_one = list(range(inst["n"]))
+        left_two = list(range(inst["n"]))
+        right_two = list(range(inst["n"]))
+        rng.shuffle(left_one)
+        rng.shuffle(right_one)
+        rng.shuffle(left_two)
+        rng.shuffle(right_two)
+        once = _relabel_instance(inst, left_one, right_one, seed)
+        twice = _relabel_instance(once, left_two, right_two, 100 + seed)
+        for transformed in (once, twice):
+            invariant_checks += 1
+            invariant_passed += int(canonical_key(transformed) == base_key)
+            carried_checks += 1
+            carried_passed += int(verify(transformed, transformed["answer"])[0])
+    distinct_keys = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": (invariant_passed == invariant_checks
+                 and carried_passed == carried_checks
+                 and distinct_keys == 20),
+        "invariance_checks": invariant_checks,
+        "invariance_passed": invariant_passed,
+        "carried_witness_checks": carried_checks,
+        "carried_witness_passed": carried_passed,
+        "unrelated_instances": 20,
+        "distinct_keys": distinct_keys,
+        "symmetries": [
+            "arbitrary left-label permutation",
+            "arbitrary right-label permutation",
+            "row and within-row reordering",
+            "composition of all preceding transformations",
+        ],
+    }
+
+    answer_chars = len(json.dumps(ship["answer"]))
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _answer_elements(ship["answer"])
+    intended_operations = 2 * ship["degree"] + 3
+    arms = {name: dict(G9_ORACLE_RESULTS[name])
+            for name in ("bare", "hinted", "placebo")}
+    evidence_complete = all(arms[name]["attempts"] >= 3 for name in arms)
+    hinted_rate = (arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+                   if arms["hinted"]["attempts"] else 0.0)
+    placebo_rate = (arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+                    if arms["placebo"]["attempts"] else 0.0)
+    hinted_hardened = G9_ORACLE_RESULTS["hinted_verdict"] == "hardened"
+    within_caps = (
+        answer_chars <= 2_000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": evidence_complete and hinted_hardened and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+    }
+
+    gates = [value for key, value in report.items()
+             if key.startswith("G") and isinstance(value, dict)]
+    report["all_passed"] = all(gate.get("pass") is True for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
