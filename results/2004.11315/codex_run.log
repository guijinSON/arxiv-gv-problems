assert g.parse_answer('garbage') is None
base=g.render(a)
os.environ['GV_HINT_MODE']='structural'; hinted=g.render(a)
os.environ['GV_HINT_MODE']='placebo'; placebo=g.render(a)
assert g.STRUCTURAL_HINT not in base and hinted.endswith(g.STRUCTURAL_HINT) and placebo.endswith(g.PLACEBO_HINT)
print('determinism/json/contract: ok')
print('shipping render chars:',len(base))
print('shipping answer:',a['answer'],g.verify(a,a['answer']))
print('compact:',g._compact_route(a))
PY
