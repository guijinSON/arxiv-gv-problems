+def escalate(params) -> dict | str | None:
+    """Double succinct exponent bit length, keeping certificate length fixed."""
+    harder = dict(params)
+    current = harder.get("n")
+    if not _is_int(current) or current < 3:
+        return None
+    if current >= 240:
