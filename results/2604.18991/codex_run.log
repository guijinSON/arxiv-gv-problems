+)
+PLACEBO_HINT = (
+    "In the displayed coefficient basis, careful attention to rational signs "
+    "and exponent ordering is especially important."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "One univariate polynomial W=sum(w_j L^j), with every degree "
+        "j=0,...,E-2 present exactly once in increasing order.  Each nonzero "
+        "integer coefficient satisfies -C<=w_j<=C and is serialized in the "
+        "polynomial rational format as [w_j,1]."
