+        if value:
+            extension = _poly_mul_mod(
+                block_power, block_sum, modulus, counter
+            )
+            block_sum = _poly_add(block_sum, extension, counter)
+            block_power = _poly_mul_mod(
+                block_power, block_power, modulus, counter
+            )
