+    "demo": {"n": 4, "order": 3, "scalar_max": 1},
+    "easy": {"n": 18, "order": 11, "scalar_max": 9},
+    "medium": {"n": 26, "order": 17, "scalar_max": 9},
+    "hard": {"n": 34, "order": 23, "scalar_max": 9},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "In the quotient by A, the distinguished linear form L is an E-th root "
+    "of unity different from 1."
+)
+PLACEBO_HINT = (
+    "In the displayed coefficient basis, careful attention to rational signs "
+    "and exponent ordering is especially important."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "One univariate polynomial Q=sum(q_j L^j), with every degree "
+        "j=0,...,E-2 present exactly once in increasing order.  Each nonzero "
