def random_candidate(inst, rng) -> object:
    """Sample uniformly from the stated nonzero coefficient grid."""
    if not isinstance(rng, random.Random):
        raise TypeError("rng must be an instance of random.Random")
    height = inst["coefficient_bound"]
    answer = []
    for degree in range(inst["order"] - 1):
        raw = rng.randrange(2 * height)
        numerator = raw - height
        if numerator >= 0:
            numerator += 1
        answer.append([[numerator, 1], [degree]])
    return answer


def _scaled_random_candidate(inst, rng):
    """Construction-aware prior: coefficients are multiples of displayed g."""
    radius = inst["order"] - 1
    numerators = []
    for _ in range(radius):
        raw = rng.randrange(2 * radius)
        value = raw - radius
        if value >= 0:
            value += 1
        numerators.append(value * inst["witness_scale"])
    return _candidate_from_numerators(inst, numerators)


def search_space(inst) -> int | None:
    """Exact cardinality of the nonzero rational grid polynomial language."""
    return (2 * inst["coefficient_bound"]) ** (inst["order"] - 1)


def enumerate_all(inst) -> int | None:
    """Brute-force the bounded language when it contains at most 50,000 items."""
    space = search_space(inst)
    if space > 50_000:
        return None
    height = inst["coefficient_bound"]
    values = list(range(-height, 0)) + list(range(1, height + 1))
    valid = 0
    for numerators in itertools.product(values, repeat=inst["order"] - 1):
        candidate = [
            [[value, 1], [degree]]
            for degree, value in enumerate(numerators)
        ]
        valid += int(verify(inst, candidate)[0])
    return valid


def canonical_key(inst) -> str:
    """Canonicalize affine variable changes and additions of A multiples."""
    residue = [_q_to_json(value) for value in _f_remainder(inst)]
    record = {
        "order": inst["order"],
        "F_mod_A": residue,
        "right_hand_side": inst["height"],
        "coefficient_bound": inst["coefficient_bound"],
    }
    payload = json.dumps(record, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(payload.encode("ascii")).hexdigest()


