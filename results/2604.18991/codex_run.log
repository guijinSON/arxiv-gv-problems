+    return {
+        "n": n,
+        "order": order,
+        "count": count,
+        "shift": shift,
+        "automorphism": automorphism,
+        "scalar": scalar,
+        "m": shift + order * count,
+        "linear_form": {
+            "u": _q_to_json(affine_u),
+            "v": _q_to_json(affine_v),
+        },
+        "decoy_coefficients": decoy,
+        "height": height,
+        "answer": answer,
+    }
