+    inverse = _poly_mod(inverse, modulus, operations)
+    inverse = _poly_scale(inverse, inst["height"], operations)
+    inverse += [Fraction(0)] * (inst["order"] - 1 - len(inverse))
+    if any(value == 0 or value.denominator != 1 for value in inverse):
