+def parse_answer(text) -> object | None:
+    """Extract tagged JSON, tolerating surrounding prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    match = re.search(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    if not match:
