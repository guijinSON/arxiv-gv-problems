+    reference_record = {
+        "name": "succinct modular arithmetic plus polynomial extended Euclid",
+        "complexity": "O(E^2(log s+log N)+E^3) exact rational operations",
+        "wall_clock_sec": round(reference_seconds / 8, 6),
