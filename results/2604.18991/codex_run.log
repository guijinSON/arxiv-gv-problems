+def _candidate_from_numerators(inst, numerators):
+    height = inst["height"]
+    clean = []
+    for value in numerators:
+        value = int(value)
+        if value == 0:
+            value = 1
+        value = max(-height, min(height, value))
+        clean.append(value)
+    return [
+        [[value, 1], [degree]]
+        for degree, value in enumerate(clean)
+    ]
