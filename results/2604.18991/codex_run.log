+        dense_part, geometric_sum, modulus, operations
+    )
+    dense_part = _poly_scale(dense_part, inst["scalar"], operations)
+    decoy = _poly_mod(
+        [Fraction(value) for value in inst["decoy_coefficients"]],
+        modulus,
+        operations,
