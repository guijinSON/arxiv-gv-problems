+    current = 1
+    for degree in range(inst["order"] - 1):
+        coefficient = remainder[degree] if degree < len(remainder) else 0
+        current += -1 if coefficient > 0 else 1
+        if current == 0:
+            current = 1
+        numerators.append(current)
+    return _candidate_from_numerators(inst, numerators)
