+    "and exponent ordering is especially important."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "One univariate polynomial W=sum(w_j L^j), with every degree "
+        "j=0,...,E-2 present exactly once in increasing order.  Each nonzero "
