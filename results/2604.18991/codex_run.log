+def _compact_answer(inst):
+    """Paper-inspired roots-of-unity route, with an explicit operation count."""
+    operations = [0]
+    decoy = [Fraction(value) for value in inst["decoy_coefficients"]]
+    remainder = _poly_mod(decoy, _modulus(inst), operations)
+    if remainder:
