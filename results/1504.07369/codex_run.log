+    placebo_attempts = arms["placebo"]["attempts"]
+    hinted_rate = arms["hinted"]["solved"] / hinted_attempts if hinted_attempts else None
+    placebo_rate = arms["placebo"]["solved"] / placebo_attempts if placebo_attempts else None
+    operation_bound = 247
