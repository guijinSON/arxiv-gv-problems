+        "fixed_answer_elements": len(doubled["answer"]),
+    }
+
+    invariance_checks = 0
+    witness_checks = 0
+    failures = []
+    unrelated_keys = []
+    for seed in range(20):
+        original = make_instance(seed=7000 + seed, **shipping_params)
