+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A three-integer tuple [j,u,v]: j is a 0-based target index; u is an odd, non-involutory unit modulo 2^n; "
