+
+def random_candidate(inst, rng) -> object:
+    modulus = inst["group_order"]
+    unit = _sample_language_unit(rng, modulus)
+    return [rng.randrange(len(inst["target_signatures"])), unit, pow(unit, -1, modulus)]
