+            "in_context_single_sum_lift": _attack_one_sum_lift(attacked),
+            "greedy_small_unit_scan_4095": _attack_small_unit_scan(attacked),
+            "standard_unit_anchor_normalization": _attack_unit_anchor(attacked),
