				\node[main node] (2) [right = .8cm of 1] {$b_i^1$};
				\node[main node] (3) [above = .8cm of 1]  {$a_i^2$};
				\node[main node] (4) [above = .8cm of 2]  {$b_i^2$};
				\node[main node] (5) [above left = 1.8cm and 1cm of 1] {$T_i$};
				\node[main node] (6) [above right = 1.8cm and 1cm of 2] {$F_i$};
				\node[main node] (7) [above right = 0.2cm and 1.8cm of 5] {$d_i^1$};
				\node[main node] (8) [above = 0.5cm of 7] {$d_i^2$};
