+        raise ValueError(error)
+    n, step = inst["n"], data["step"]
+    rhs = [None] * n
+    for check in data["checks"]:
+        triple = frozenset(check["vars"])
+        start = next(s for s in check["vars"]
+                     if frozenset((s, (s + step) % n, (s + 2 * step) % n)) == triple)
