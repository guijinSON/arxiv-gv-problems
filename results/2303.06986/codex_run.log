+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 5, "copies": 1},
+    "easy": {"n": 251, "copies": 1},
+    "medium": {"n": 253, "copies": 2},
+    "hard": {"n": 254, "copies": 3},
+}
