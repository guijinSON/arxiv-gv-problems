    # and the binding constraint is ours: the answer format (cap_bound) or the
    # escalation budget (budget_bound).
    return {"hardened": 0, "cap_bound": 10, "budget_bound": 10}.get(verdict["verdict"], 9)


if __name__ == "__main__":
