+"""Verified generator for multiset resolving sets from arXiv:2303.06986.
+
+The family uses the 3-SAT reduction in Theorem 3.1.  A Boolean assignment is
+sampled first, cyclic 3-XOR equations are evaluated at it and expanded to 3-CNF,
+and the assignment is carried to the paper's canonical multiset resolving set.
+Generation never solves an emitted instance.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "connected simple graph specified by variable and clause gadgets",
+        "multiset distance representations",
+        "canonical multiset resolving set encoded by Boolean gadget choices",
+    ],
+    "verification_operations": [
+        "exact hexadecimal decoding",
+        "exact Boolean clause evaluation",
+        "symbolic check of the c_j^1/c_j^3 multiset-distance collision condition",
+        "exact validation of the paper's distinct path-length schedule",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": "Section 3, Theorem 3.1 and Claims 1-3 (3-SAT to Multiset Dimension)",
+    "reduction_source": "paper_central",
+    "intuition_type": "reduction recognition",
+    "intuition_description": (
+        "Recognize that four clauses on each variable triple encode one parity "
+        "equation and that the triples are consecutive windows of a hidden cycle; "
+        "without this structure, one must use generic SAT search or elimination."
+    ),
+    "hardness_basis": (
+        "Track B: grouping clause quartets followed by GF(2) Gauss-Jordan "
+        "elimination solves the shipping instance in O(n^3); selftest records its "
+        "measured wall-clock and scalar-operation count, while the hidden-cycle "
+        "parallel-prefix route uses at most 108 exact wide-word operations."
+    ),
+    "max_answer_tokens": 17,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 5, "copies": 1},
+    "easy": {"n": 251, "copies": 1},
+    "medium": {"n": 253, "copies": 2},
+    "hard": {"n": 254, "copies": 3},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The four clauses sharing each variable triple encode a parity equation, "
+    "and the triples are the length-three windows of a hidden cycle."
+)
+PLACEBO_HINT = (
+    "The hexadecimal convention and the gadget superscripts require consistent "
+    "bookkeeping throughout the displayed construction."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "One fixed-width lowercase hexadecimal word with ceil(n/4) digits and "
+        "value below 2^n. Bit r selects a_r^1 rather than b_r^1 in the variable "
+        "gadget having the r-th smallest pendant-path length; e_i^1 and g_j^1 "
+        "are included automatically."
+    ),
+    "bounds": {
+        "hex_digits": "ceil(n/4)",
+        "integer_min": 0,
+        "integer_max": "2^n-1",
+        "semantic_boolean_atoms": "n",
+        "candidate_count": "2^n",
+    },
+}
+
+NOTES = (
+    "Section 2 and Theorem 2.1 fix the exact object: a set W is multiset "
+    "resolving when the unordered multisets of graph distances to W are pairwise "
+    "different; this is equivalent to an ID-coloring. Section 3, Theorem 3.1 "
+    "and Claims 1-3 give the paper-central 3-SAT reduction used here. Claim 2 "
+    "constructs the canonical witness with one e vertex, one truth vertex per "
+    "variable gadget and one g vertex per clause gadget. Its displayed distance "
+    "identities show that the only assignment-dependent obstruction is equality "
+    "of the representations of c_j^1 and c_j^3, which occurs exactly when clause "
+    "j is false; verify executes this equivalence clause by clause. The explicit "
+    "king-grid sets of Proposition 4.2/Theorem 4.4 and the whole-copy witness of "
+    "Theorem 5.1 are easy construction regimes and were not used. Plants and "
+    "decoys are ordinary Boolean choices from the same variable gadgets. Random "
+    "external labels and hidden cycle order defeat positional and public-order "
+    "probes; balanced parity quartets defeat literal-frequency outliers; cyclic "
+    "coupling traps one-bit greedy descent; uniqueness defeats random restart. "
+    "Gaussian elimination and DPLL are disclosed as successful Track-B reference "
+    "algorithms, never reported as failed attacks."
+)
+
+
+# Filled from script-owned oracle runs before shipping.  The sentinel makes G9
+# fail until the required arms have genuinely been run.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "unrun",
+}
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_parameters(n, copies):
+    if not _is_int(n) or n < 5:
+        raise ValueError("n must be an integer at least 5")
+    if n % 3 == 0:
+        raise ValueError("n must not be divisible by 3")
+    if not _is_int(copies) or copies < 1:
+        raise ValueError("copies must be a positive integer")
+
+
+def _hex_width(n):
+    return (n + 3) // 4
+
+
+def _encode_int(inst, packed):
+    return format(packed, f"0{_hex_width(inst['n'])}x")
+
+
+def _encode_bits(n, bits):
+    packed = 0
+    for index, bit in enumerate(bits):
+        packed |= int(bit) << index
+    return format(packed, f"0{_hex_width(n)}x")
+
+
+def _fresh_ids(rng, count, occupied=None):
+    occupied = set() if occupied is None else set(occupied)
+    values = []
+    while len(values) < count:
+        value = rng.randrange(100000, 1000000)
+        if value not in occupied:
+            occupied.add(value)
+            values.append(value)
+    return values
+
+
+def _clauses_for_parity(triple, rhs, multiplicity, rng):
+    """Expand x+y+z=rhs over GF(2) to its four exact 3-CNF clauses."""
+    invalid = []
+    for pattern in range(8):
+        bits = [(pattern >> offset) & 1 for offset in range(3)]
+        if bits[0] ^ bits[1] ^ bits[2] != rhs:
+            invalid.append(bits)
+    result = []
+    for _copy in range(multiplicity):
+        rows = list(invalid)
+        rng.shuffle(rows)
+        for bits in rows:
+            literals = [[triple[j], 1 - bits[j]] for j in range(3)]
+            rng.shuffle(literals)
+            result.append(literals)
+    return result
+
+
+def _graph_size(variables, clauses):
+    # variable gadget: T,F,a1,a2,b1,b2 + t d-vertices + e1,e2
+    # clause gadget: c1,c2,c3 + s f-vertices + g1,g2
+    return sum(v["t"] + 8 for v in variables) + sum(c["s"] + 5 for c in clauses)
+
+
+def make_instance(n, seed=0, copies=1, **params):
+    """Inverse-generate a graph reduction instance and its canonical witness."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_parameters(n, copies)
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    answer_bits = [rng.getrandbits(1) for _ in range(n)]
+    if not any(answer_bits):
+        answer_bits[rng.randrange(n)] = 1
+    if all(answer_bits):
+        answer_bits[rng.randrange(n)] = 0
+
+    variable_ids = _fresh_ids(rng, n)
+    variables = [
+        {"id": variable_ids[index], "t": 5 * (index + 2)}
+        for index in range(n)
+    ]
+    id_to_rank = {value: rank for rank, value in enumerate(variable_ids)}
+    hidden_cycle = list(variable_ids)
+    rng.shuffle(hidden_cycle)
+
+    literal_rows = []
+    for index in range(n):
+        triple = [
+            hidden_cycle[index],
+            hidden_cycle[(index + 1) % n],
+            hidden_cycle[(index + 2) % n],
+        ]
+        rhs = 0
+        for variable_id in triple:
+            rhs ^= answer_bits[id_to_rank[variable_id]]
+        rng.shuffle(triple)
+        multiplicity = rng.randint(1, copies)
+        literal_rows.extend(_clauses_for_parity(triple, rhs, multiplicity, rng))
+
+    clause_ids = _fresh_ids(rng, len(literal_rows), occupied=variable_ids)
+    clauses = []
+    for index, literals in enumerate(literal_rows):
+        clauses.append({
+            "id": clause_ids[index],
+            "s": 5 * (n + index + 2),
+            "literals": literals,
+        })
+
+    # Input order and external labels are irrelevant graph spelling choices.
+    rng.shuffle(variables)
+    rng.shuffle(clauses)
+    instance = {
+        "paper": "arXiv:2303.06986",
+        "family": "canonical multiset resolving set in the Theorem 3.1 graph",
+        "n": n,
+        "copies_bound": copies,
+        "variables": variables,
+        "clauses": clauses,
+        "clause_count": len(clauses),
+        "required_set_size": 2 * n + len(clauses),
+        "graph_vertices": _graph_size(variables, clauses),
+    }
+    instance["answer"] = _encode_bits(n, answer_bits)
+    return instance
+
+
+def _sorted_variables(inst):
+    return sorted(inst["variables"], key=lambda item: item["t"])
+
+
+def _sorted_clauses(inst):
+    return sorted(inst["clauses"], key=lambda item: item["s"])
+
+
+def render(inst):
+    """Render the complete implicit graph construction and answer grammar."""
+    variables = _sorted_variables(inst)
+    clauses = _sorted_clauses(inst)
+    lines = [
+        "Find a multiset resolving set in the graph defined below.",
+        "",
+        "Exact definition.",
+        "The graph is simple, undirected and connected. For vertices u,v, d(u,v)",
+        "is the number of edges in a shortest u-v path. For a vertex set W, the",
+        "multiset representation of u is the unordered multiset {{d(u,w): w in W}},",
+        "including distance 0 when u is in W. The set W is multiset resolving when",
+        "these multisets are different for every two distinct graph vertices.",
+        "",
+        "Variable gadgets.",
+        f"There are n={inst['n']} gadgets. A gadget X with displayed identifier x and",
+        "path length t has vertices T_x,F_x,a_x^1,a_x^2,b_x^1,b_x^2,",
+        "d_x^1,...,d_x^t,e_x^1,e_x^2. Its edges are:",
+        "  a_x^1--b_x^1, a_x^2--b_x^2;",
+        "  T_x--a_x^1, T_x--a_x^2, F_x--b_x^1, F_x--b_x^2;",
+        "  T_x--d_x^1, F_x--d_x^1, d_x^h--d_x^(h+1) for 1<=h<t;",
+        "  d_x^t--e_x^1 and d_x^t--e_x^2.",
+        "The gadgets in increasing t order are numbered r=0,...,n-1:",
+    ]
+    for rank, variable in enumerate(variables):
+        lines.append(f"  r={rank:03d}: x={variable['id']}  t={variable['t']}")
+
+    lines.extend([
+        "",
+        "Clause gadgets.",
+        f"There are M={inst['clause_count']} clauses. Clause C with identifier q, path",
+        "length s and three distinct signed variable identifiers has vertices",
+        "c_q^1,c_q^2,c_q^3,f_q^1,...,f_q^s,g_q^1,g_q^2. Its internal edges are",
+        "  c_q^1--c_q^2--c_q^3; c_q^2--f_q^1;",
+        "  f_q^h--f_q^(h+1) for 1<=h<s; f_q^s--g_q^1 and f_q^s--g_q^2.",
+        "For every clause q, add c_q^1--T_x and c_q^1--F_x for every variable x.",
+        "Also connect c_q^3 to both T_x,F_x when x is absent from the clause; connect",
+        "it only to F_x when +x occurs; and only to T_x when -x occurs.",
+        "There are no edges other than those just specified. A token +x is true when",
+        "x's bit is 1, and -x is true when that bit is 0. All bounds are inclusive.",
+        "The clauses, sorted by their structurally distinguishing path length s, are:",
+    ])
+    for clause in clauses:
+        tokens = [
+            ("+" if positive else "-") + str(variable_id)
+            for variable_id, positive in clause["literals"]
+        ]
+        lines.append(
+            f"  q={clause['id']}  s={clause['s']}: " + " ".join(tokens)
+        )
+
+    width = _hex_width(inst["n"])
+    example = format((1 << min(3, inst["n"])) - 1, f"0{width}x")
+    lines.extend([
+        "",
+        "Required witness.",
+        f"Return one hexadecimal word w of exactly {width} digits and value below 2^{inst['n']}.",
+        "Leading zeroes are required. Bit r of w (bit 0 is the least-significant bit)",
+        "corresponds to the variable gadget on row r above. It defines the concrete set",
+        "  W(w) = {e_x^1 for every variable x} union {g_q^1 for every clause q}",
+        "         union {a_x^1 if x's bit is 1, otherwise b_x^1, for every x}.",
+        f"Thus W(w) has exactly 2n+M={inst['required_set_size']} vertices. Find any w for which",
+        "W(w) is a multiset resolving set. Hexadecimal letter case is ignored on input.",
+        "",
+        "Give your final answer inside <answer></answer> tags as exactly the required",
+        f"{width} hexadecimal digits, without a 0x prefix.",
+        f"Example format only: <answer>{example}</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    """Extract one tagged hexadecimal word, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    if len(matches) != 1:
+        return None
+    body = matches[0].strip()
+    fenced = re.fullmatch(r"```(?:text|json)?\s*(.*?)\s*```", body, flags=re.I | re.S)
+    if fenced:
+        body = fenced.group(1).strip()
+    if not re.fullmatch(r"[0-9a-fA-F]+", body):
+        return None
+    return body.lower()
+
+
+def _decode_answer(inst, answer):
+    if not isinstance(answer, str):
+        return None, "answer must be a hexadecimal string"
+    if not answer:
+        return None, "answer is empty"
+    width = _hex_width(inst["n"])
+    if len(answer) < width:
+        return None, "answer has too few hexadecimal digits"
+    if len(answer) > width:
+        return None, "answer has too many hexadecimal digits"
+    if not re.fullmatch(r"[0-9a-fA-F]+", answer):
+        return None, "answer contains a non-hexadecimal character"
+    packed = int(answer, 16)
+    if packed >= (1 << inst["n"]):
+        return None, "answer value is outside the n-bit range"
+    return packed, None
+
+
+def _validate_instance(inst):
+    cached = inst.get("_validation_cache")
+    if isinstance(cached, dict):
+        return cached, None
+    n = inst.get("n")
+    if not _is_int(n) or n < 5:
+        return None, "instance has an invalid variable count"
+    variables = inst.get("variables")
+    clauses = inst.get("clauses")
+    if not isinstance(variables, list) or len(variables) != n:
+        return None, "instance variable-gadget list is inconsistent"
+    if not isinstance(clauses, list) or inst.get("clause_count") != len(clauses):
+        return None, "instance clause-gadget list is inconsistent"
+    try:
+        ordered_variables = sorted(variables, key=lambda item: item["t"])
+        variable_ids = [item["id"] for item in ordered_variables]
+        tails = [item["t"] for item in ordered_variables]
+    except (KeyError, TypeError):
+        return None, "instance contains a malformed variable gadget"
+    if len(set(variable_ids)) != n or tails != [5 * (i + 2) for i in range(n)]:
+        return None, "instance violates the distinct variable path-length schedule"
+    id_set = set(variable_ids)
+    clause_ids = set()
+    clause_tails = []
+    for clause in clauses:
+        try:
+            clause_id = clause["id"]
+            tail = clause["s"]
+            literals = clause["literals"]
+        except (KeyError, TypeError):
+            return None, "instance contains a malformed clause gadget"
+        if clause_id in clause_ids:
+            return None, "instance repeats a clause-gadget identifier"
+        clause_ids.add(clause_id)
+        clause_tails.append(tail)
+        if not isinstance(literals, list) or len(literals) != 3:
+            return None, "instance has a clause without exactly three literals"
+        literal_ids = []
+        for literal in literals:
+            if (
+                not isinstance(literal, list)
+                or len(literal) != 2
+                or literal[0] not in id_set
+                or literal[1] not in (0, 1)
+            ):
+                return None, "instance contains a malformed literal"
+            literal_ids.append(literal[0])
+        if len(set(literal_ids)) != 3:
+            return None, "instance has a clause with repeated variables"
+    expected = [5 * (n + j + 2) for j in range(len(clauses))]
+    if sorted(clause_tails) != expected:
+        return None, "instance violates the distinct clause path-length schedule"
+    rank_by_id = {value: rank for rank, value in enumerate(variable_ids)}
+    # Instances are immutable after construction in normal use.  Caching this
+    # exact structural audit keeps the 200k-candidate density measurement about
+    # candidate checking rather than repeated parsing of the same public graph.
+    inst["_validation_cache"] = rank_by_id
+    return rank_by_id, None
+
+
+def verify(inst, answer):
+    """Verify any canonical resolving witness without reading inst['answer'].
+
+    Claims 1-3 reduce the canonical-set collision test exactly to clause
+    satisfaction.  For a false clause the two named vertices have equal complete
+    distance multisets; if every clause is true, the proof's explicit formulas and
+    the checked path-length schedule distinguish all remaining vertex pairs.
+    """
+    packed, error = _decode_answer(inst, answer)
+    if error is not None:
+        return False, error
+    rank_by_id, error = _validate_instance(inst)
+    if error is not None:
+        return False, error
+    # Clause order has no semantic force, so use the stored order.  This makes
+    # random invalid candidates reject after their first false clause on average
+    # instead of sorting all M gadgets for every trial.
+    for clause in inst["clauses"]:
+        satisfied = False
+        for variable_id, positive in clause["literals"]:
+            bit = (packed >> rank_by_id[variable_id]) & 1
+            if bit == positive:
+                satisfied = True
+                break
+        if not satisfied:
+            return (
+                False,
+                f"c_{clause['id']}^1 and c_{clause['id']}^3 have identical multiset-distance representations",
+            )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample uniformly after enforcing the canonical set shape and size."""
+    return _encode_int(inst, rng.getrandbits(inst["n"]))
+
+
+def search_space(inst):
+    return 1 << inst["n"]
+
+
+def enumerate_all(inst):
+    if inst["n"] > 16:
+        return None
+    return sum(
+        verify(inst, _encode_int(inst, packed))[0]
+        for packed in range(1 << inst["n"])
+    )
+
+
+def _extract_checks(inst):
+    """Recover parity equations from the public clauses alone."""
+    groups = {}
+    for clause in inst["clauses"]:
+        variables = tuple(sorted(literal[0] for literal in clause["literals"]))
+        if len(set(variables)) != 3:
+            raise ValueError("clause does not contain three distinct variables")
+        falsifying = {variable: 1 - positive for variable, positive in clause["literals"]}
+        parity = 0
+        for variable in variables:
+            parity ^= falsifying[variable]
+        rhs = 1 ^ parity
+        group = groups.setdefault(variables, {"rhs": rhs, "patterns": []})
+        if group["rhs"] != rhs:
+            raise ValueError("one variable triple encodes inconsistent parities")
+        group["patterns"].append(tuple(falsifying[v] for v in variables))
+
+    checks = []
+    for variables, group in groups.items():
+        patterns = group["patterns"]
+        if len(patterns) % 4:
+            raise ValueError("parity group size is not a multiple of four")
+        multiplicity = len(patterns) // 4
+        expected = {
+            tuple((pattern >> offset) & 1 for offset in range(3))
+            for pattern in range(8)
+            if (
+                ((pattern >> 0) & 1)
+                ^ ((pattern >> 1) & 1)
+                ^ ((pattern >> 2) & 1)
+            ) != group["rhs"]
+        }
+        if set(patterns) != expected:
+            raise ValueError("parity group lacks the four falsifying rows")
+        if any(patterns.count(row) != multiplicity for row in expected):
+            raise ValueError("parity group copies have inconsistent multiplicity")
+        checks.append({"vars": list(variables), "rhs": group["rhs"], "copies": multiplicity})
+    return checks
+
+
+def _cycle_order(n, checks):
+    pair_counts = {}
+    for check in checks:
+        triple = sorted(check["vars"])
+        for left in range(3):
+            for right in range(left + 1, 3):
+                pair = (triple[left], triple[right])
+                pair_counts[pair] = pair_counts.get(pair, 0) + 1
+    vertices = sorted({v for check in checks for v in check["vars"]})
+    if len(vertices) != n:
+        raise ValueError("checks do not cover every variable")
+    neighbors = {vertex: [] for vertex in vertices}
+    for (u, v), count in pair_counts.items():
+        if count == 2:
+            neighbors[u].append(v)
+            neighbors[v].append(u)
+    if any(len(values) != 2 for values in neighbors.values()):
+        raise ValueError("parity triples do not define one hidden cycle")
+    start = min(vertices)
+    previous = None
+    current = start
+    order = []
+    first_next = min(neighbors[start])
+    while len(order) < n:
+        order.append(current)
+        options = neighbors[current]
+        nxt = first_next if previous is None else (
+            options[0] if options[0] != previous else options[1]
+        )
+        previous, current = current, nxt
+    if current != start or len(set(order)) != n:
+        raise ValueError("pair-incidence graph is not one simple cycle")
+    return order
+
+
+def _cyclic_prefix_shortcut(inst):
+    """Recover the unique assignment with one parallel-prefix XOR."""
+    checks = _extract_checks(inst)
+    n = inst["n"]
+    order = _cycle_order(n, checks)
+    rhs_by_triple = {frozenset(check["vars"]): check["rhs"] for check in checks}
+    rhs = [
+        rhs_by_triple[frozenset((
+            order[index], order[(index + 1) % n], order[(index + 2) % n]
+        ))]
+        for index in range(n)
+    ]
+    differences = [rhs[i] ^ rhs[(i + 1) % n] for i in range(n)]
+    step_word = 0
+    for j in range(n):
+        step_word |= differences[(3 * j) % n] << j
+    mask = (1 << n) - 1
+    prefix = step_word
+    shift = 1
+    while shift < n:
+        prefix ^= (prefix << shift) & mask
+        shift <<= 1
+    orbit_values = (prefix << 1) & mask
+    cyclic_values = [0] * n
+    for j in range(n):
+        cyclic_values[(3 * j) % n] = (orbit_values >> j) & 1
+    correction = rhs[0] ^ cyclic_values[0] ^ cyclic_values[1] ^ cyclic_values[2]
+    if correction:
+        cyclic_values = [bit ^ 1 for bit in cyclic_values]
+
+    rank_by_id, error = _validate_instance(inst)
+    if error is not None:
+        raise ValueError(error)
+    public = [0] * n
+    for position, variable_id in enumerate(order):
+        public[rank_by_id[variable_id]] = cyclic_values[position]
+    return public
+
+
+def canonical_key(inst):
+    """Normalize all cheap graph relabellings before hashing.
+
+    Unique pendant lengths canonically rank variable and clause gadgets. External
+    identifiers, input order, literal order and independent truth-endpoint swaps
+    are graph spelling choices and are removed. Full arbitrary graph isomorphism
+    is unnecessary for this construction because all gadgets have distinct tails.
+    """
+    variables = _sorted_variables(inst)
+    rank_by_id = {item["id"]: rank for rank, item in enumerate(variables)}
+    normalized_clauses = []
+    for clause in _sorted_clauses(inst):
+        normalized_clauses.append(sorted(rank_by_id[v] for v, _sign in clause["literals"]))
+    payload = {"n": inst["n"], "unsigned_clauses_by_tail": normalized_clauses}
+    blob = json.dumps(payload, separators=(",", ":"), sort_keys=True)
+    return "multiset-dimension-reduction-v1:" + hashlib.sha256(blob.encode()).hexdigest()
+
+
+def escalate(params):
+    current = dict(params)
+    n = current.get("n")
+    copies = current.get("copies", 1)
+    if not _is_int(n) or not _is_int(copies):
+        return None
+    candidate = n + max(2, n // 8)
+    while candidate % 3 == 0:
+        candidate += 1
+    if candidate > 256:
+        if n < 256:
+            return {"n": 256, "copies": copies + 1}
+        return "cap_bound"
+    return {"n": candidate, "copies": copies + 1}
+
+
+# ---------------------------------------------------------------------------
+# Auditable attacks and successful Track-B reference algorithms.
+
+
+def _ranked_checks(inst):
+    rank_by_id, error = _validate_instance(inst)
+    if error is not None:
+        raise ValueError(error)
+    return [
+        {
+            "vars": [rank_by_id[v] for v in check["vars"]],
+            "rhs": check["rhs"],
+            "copies": check["copies"],
+        }
+        for check in _extract_checks(inst)
+    ]
+
+
+def _satisfies_checks(checks, candidate):
+    return all(
+        candidate[p] ^ candidate[q] ^ candidate[r] == check["rhs"]
+        for check in checks
+        for p, q, r in [check["vars"]]
+    )
+
+
+def _weighted_unsatisfied(checks, candidate):
+    total = 0
+    for check in checks:
+        p, q, r = check["vars"]
+        if candidate[p] ^ candidate[q] ^ candidate[r] != check["rhs"]:
+            total += check["copies"]
+    return total
+
+
+def _attack_incidence_outlier(inst):
+    checks = _ranked_checks(inst)
+    scores = [0] * inst["n"]
+    for check in checks:
+        for variable in check["vars"]:
+            scores[variable] += check["copies"]
+    median = sorted(scores)[len(scores) // 2]
+    return [int(score > median) for score in scores]
+
+
+def _attack_literal_majority(inst):
+    rank_by_id, error = _validate_instance(inst)
+    if error is not None:
+        raise ValueError(error)
+    positive = [0] * inst["n"]
+    negative = [0] * inst["n"]
+    for clause in inst["clauses"]:
+        for variable_id, sign in clause["literals"]:
+            (positive if sign else negative)[rank_by_id[variable_id]] += 1
+    return [int(positive[i] > negative[i]) for i in range(inst["n"])]
+
+
+def _attack_greedy_bit_flip(inst):
+    checks = _ranked_checks(inst)
+    candidate = [0] * inst["n"]
+    score = _weighted_unsatisfied(checks, candidate)
+    for _ in range(inst["n"]):
+        best_score = score
+        best_variable = None
+        for variable in range(inst["n"]):
+            candidate[variable] ^= 1
+            trial = _weighted_unsatisfied(checks, candidate)
+            candidate[variable] ^= 1
+            if trial < best_score:
+                best_score = trial
+                best_variable = variable
+        if best_variable is None:
+            break
+        candidate[best_variable] ^= 1
+        score = best_score
+    return candidate
+
+
+def _attack_random_restart(inst, rng, attempts=8192):
+    checks = _ranked_checks(inst)
+    candidate = [0] * inst["n"]
+    for _ in range(attempts):
+        packed = rng.getrandbits(inst["n"])
+        candidate = [(packed >> i) & 1 for i in range(inst["n"])]
+        if _satisfies_checks(checks, candidate):
+            break
+    return _encode_bits(inst["n"], candidate)
+
+
+def _attack_public_order_recurrence(inst):
+    """Tempting no-tool ansatz: assume increasing tail rank is the cycle."""
+    checks = _ranked_checks(inst)
+    rhs_by_triple = {tuple(sorted(c["vars"])): c["rhs"] for c in checks}
+    candidates = []
+    for first in (0, 1):
+        for second in (0, 1):
+            candidate = [0] * inst["n"]
+            candidate[0], candidate[1] = first, second
+            for index in range(inst["n"] - 2):
+                key = (index, index + 1, index + 2)
+                candidate[index + 2] = (
+                    rhs_by_triple.get(key, 0) ^ candidate[index] ^ candidate[index + 1]
+                )
+            candidates.append(candidate)
+    return min(candidates, key=lambda value: _weighted_unsatisfied(checks, value))
+
+
+def _gaussian_reference(inst):
+    """Generic exact GF(2) Gauss-Jordan elimination with operation counters."""
+    checks = _ranked_checks(inst)
+    n = inst["n"]
+    rows = []
+    for check in checks:
+        coefficients = 0
+        for variable in check["vars"]:
+            coefficients ^= 1 << variable
+        rows.append(coefficients | (check["rhs"] << n))
+    rank = 0
+    pivot_rows = {}
+    bit_tests = 0
+    row_xors = 0
+    for column in range(n):
+        pivot = None
+        for row_index in range(rank, len(rows)):
+            bit_tests += 1
+            if (rows[row_index] >> column) & 1:
+                pivot = row_index
+                break
+        if pivot is None:
+            continue
+        rows[rank], rows[pivot] = rows[pivot], rows[rank]
+        for row_index in range(len(rows)):
+            if row_index == rank:
+                continue
+            bit_tests += 1
+            if (rows[row_index] >> column) & 1:
+                rows[row_index] ^= rows[rank]
+                row_xors += 1
+        pivot_rows[column] = rank
+        rank += 1
+    stats = {
+        "rank": rank,
+        "row_xors": row_xors,
+        "bit_tests": bit_tests,
+        "scalar_operations": bit_tests + (n + 1) * row_xors,
+    }
+    if rank != n:
+        return None, stats
+    solution = [0] * n
+    for column, row_index in pivot_rows.items():
+        solution[column] = (rows[row_index] >> n) & 1
+    return solution, stats
+
+
+def _dpll_reference(inst):
+    """Conventional clause-level DPLL with unit propagation and counters."""
+    rank_by_id, error = _validate_instance(inst)
+    if error is not None:
+        raise ValueError(error)
+    clauses = [
+        [(rank_by_id[v], sign) for v, sign in clause["literals"]]
+        for clause in inst["clauses"]
+    ]
+    stats = {
+        "literal_evaluations": 0,
+        "propagations": 0,
+        "decisions": 0,
+        "nodes": 0,
+        "backtracks": 0,
+        "full_clause_passes": 0,
+    }
+
+    def inspect_clause(clause, assignment):
+        unassigned = []
+        for variable, positive in clause:
+            stats["literal_evaluations"] += 1
+            bit = assignment[variable]
+            if bit < 0:
+                unassigned.append((variable, positive))
+            elif bit == positive:
+                return True, unassigned
+        return False, unassigned
+
+    def recurse(assignment):
+        stats["nodes"] += 1
+        while True:
+            stats["full_clause_passes"] += 1
+            changed = False
+            for clause in clauses:
+                satisfied, unassigned = inspect_clause(clause, assignment)
+                if satisfied:
+                    continue
+                if not unassigned:
+                    stats["backtracks"] += 1
+                    return None
+                if len(unassigned) == 1:
+                    variable, required = unassigned[0]
+                    if assignment[variable] < 0:
+                        assignment[variable] = required
+                        stats["propagations"] += 1
+                        changed = True
+                    elif assignment[variable] != required:
+                        stats["backtracks"] += 1
+                        return None
+            if not changed:
+                break
+        if all(bit >= 0 for bit in assignment):
+            return assignment
+        best = None
+        for clause in clauses:
+            satisfied, unassigned = inspect_clause(clause, assignment)
+            if not satisfied and unassigned and (best is None or len(unassigned) < len(best)):
+                best = unassigned
+        variable = best[0][0] if best else next(i for i, bit in enumerate(assignment) if bit < 0)
+        for bit in (0, 1):
+            stats["decisions"] += 1
+            child = list(assignment)
+            child[variable] = bit
+            solution = recurse(child)
+            if solution is not None:
+                return solution
+        stats["backtracks"] += 1
+        return None
+
+    return recurse([-1] * inst["n"]), stats
+
+
+def _transformed_instance(inst, flips, seed):
+    """Apply real graph relabellings and carry the canonical witness through."""
+    rng = random.Random(seed)
+    variables = [dict(item) for item in inst["variables"]]
+    old_ids = [item["id"] for item in variables]
+    new_ids = _fresh_ids(rng, len(old_ids))
+    rename = dict(zip(old_ids, new_ids))
+    for item in variables:
+        item["id"] = rename[item["id"]]
+    rng.shuffle(variables)
+
+    rank_by_old = {item["id"]: rank for rank, item in enumerate(_sorted_variables(inst))}
+    clauses = []
+    new_clause_ids = _fresh_ids(rng, len(inst["clauses"]), occupied=new_ids)
+    for index, clause in enumerate(inst["clauses"]):
+        literals = []
+        for variable_id, sign in clause["literals"]:
+            literals.append([rename[variable_id], sign ^ flips[rank_by_old[variable_id]]])
+        rng.shuffle(literals)
+        clauses.append({"id": new_clause_ids[index], "s": clause["s"], "literals": literals})
+    rng.shuffle(clauses)
+
+    packed, error = _decode_answer(inst, inst["answer"])
+    if error is not None:
+        raise ValueError(error)
+    bits = [((packed >> i) & 1) ^ flips[i] for i in range(inst["n"])]
+    transformed = dict(inst)
+    transformed.pop("_validation_cache", None)
+    transformed["variables"] = variables
+    transformed["clauses"] = clauses
+    transformed["answer"] = _encode_bits(inst["n"], bits)
+    transformed["graph_vertices"] = _graph_size(variables, clauses)
+    return transformed
+
+
+def _json_answer_size(answer):
+    compact = json.dumps(answer, separators=(",", ":"))
+    return len(compact), (len(compact) + 3) // 4
+
+
+def selftest():
+    report = {
+        "paper": "arXiv:2303.06986",
