import random,time,statistics

def gen(n,p,seed,window=None):
 r=random.Random(seed); order=list(range(n));r.shuffle(order); label=[None]*n
 for rank,v in enumerate(order):label[v]=rank&1 # 0 a
 pred=[0]*n
 for i in range(n):
  lim=n if window is None else min(n,i+window+1)
  for j in range(i+1,lim):
   if r.random()<p: pred[order[j]] |= 1<<order[i]
 return label,pred,order

def dfs(label,pred,cap=100000):
 n=len(label);full=(1<<n)-1;nodes=0
 def go(used,d):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  if used==full:return ()
  need=d&1
  avail=[v for v in range(n) if not (used>>v)&1 and label[v]==need and pred[v]&~used==0]
  # strongest static heuristic: most successors approximate hidden early? choose descending outdegree
  for v in avail:
   z=go(used|(1<<v),d+1)
   if z is None:return None
   if z is not False:return (v,)+z
  return False
 st=time.perf_counter();z=go(0,0);return z,nodes,time.perf_counter()-st

def greedy(label,pred,mode):
 n=len(label);used=0;out=[]
 succ=[0]*n
 for v in range(n):
  for u in range(n):
   if pred[u]>>v&1:succ[v]+=1
 for d in range(n):
  av=[v for v in range(n) if not used>>v&1 and label[v]==(d&1) and pred[v]&~used==0]
  if not av:return None
  if mode=='min':v=min(av)
  elif mode=='maxsucc':v=max(av,key=lambda x:(succ[x],-x))
  elif mode=='minpred':v=min(av,key=lambda x:(pred[x].bit_count(),x))
  used|=1<<v;out.append(v)
 return out
for n in [40,60,80,100]:
 for p in [.02,.04,.06,.08,.1,.15,.2,.3,.5]:
  rows=[]
  for s in range(8):
   label,pred,plant=gen(n,p,100+s)
   z,nodes,t=dfs(label,pred,20000)
   gs=sum(greedy(label,pred,m) is not None for m in ['min','maxsucc','minpred'])
   rows.append((z is None,nodes,gs,t))
  caps=sum(x[0] for x in rows); succ=sum(x[2] for x in rows)
