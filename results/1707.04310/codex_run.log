+        "hits": hits,
+        "total": samples,
+        "observed_probability": fraction,
+        "candidate_space": search_space(shipping),
+        "prior": "uniform over all perfect matchings of the named paths",
+    }
+
+    # G6 and the successful Track-B reference algorithm at eight shipping seeds.
+    attack_names = (
