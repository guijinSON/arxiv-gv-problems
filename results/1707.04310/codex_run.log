   a=r.randint(lo,hi); b=r.randint(lo,hi); c=B-a-b
   if lo<=c<=hi: vals += [a,b,c]; break
 r.shuffle(vals); return vals

def exact(vals,B,lim=100_000):
 n=len(vals); pos={}
 for i,v in enumerate(vals):pos.setdefault(v,[]).append(i)
 by=[[] for _ in vals]; Ts=[]
