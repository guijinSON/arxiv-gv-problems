+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted,
+        "parsed_equals_answer": parsed == planted,
+    }
+
+    shipping = make_instance(seed=8675309, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    samples = 200_000
+    guess_rng = random.Random(170704310)
