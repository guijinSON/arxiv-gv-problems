+# Replaced after the script-owned G9 runs.  Zero attempts is explicit and cannot
+# be mistaken for oracle evidence while local gates are being developed.
+G9_MEASUREMENTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
