+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=17, **shipping)
+    answer = list(inst["answer"])
+    core_vertex = inst["core_vertices"][0]
+    corruptions = {
+        "drop_one": answer[:-1],
+        "swap_two": [answer[1], answer[0], answer[2]],
+        "duplicate": [answer[0], answer[0], answer[2]],
+        "empty": [],
+        "out_of_range": [answer[0], answer[1], inst["n_vertices"]],
