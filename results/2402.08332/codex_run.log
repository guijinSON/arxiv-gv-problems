+# n is the number of degree-two subdivision vertices: the candidate haystack.
+# The answer always contains exactly three vertex identifiers.
+DIFFICULTY = {
+    "demo": {"n": 9, "degree": 3},
+    "easy": {"n": 245, "degree": 5},
+    "medium": {"n": 273, "degree": 7},
+    "hard": {"n": 279, "degree": 9},
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON array [s1,s2,s3] of exactly three distinct degree-two vertex "
+        "identifiers in strictly increasing order.  These are the singleton "
+        "branch sets; the two other branch sets are the components after deletion."
+    ),
+    "bounds": {
+        "length": 3,
+        "entry_range": "0 <= si < number of graph vertices",
+        "structural_rule": "each si is one of the n displayed subdivision vertices",
+        "ordering": "s1 < s2 < s3",
+        "shipping_candidates": 245,
+    },
+}
+
+STRUCTURAL_HINT = (
+    "The degree-three-or-more core has an involution exchanging two equal halves across its unique three-edge cut."
+)
+PLACEBO_HINT = (
+    "The degree-two subdivision table rewards consistent bookkeeping across all its displayed edge rows."
+)
+
+# Filled from script-owned runs after hardening.  These diagnostics never gate
+# G9(c), whose caps are checked independently.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
