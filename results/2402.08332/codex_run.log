+STRUCTURAL_HINT = (
+    "The degree-three-or-more core has an involution exchanging two equal halves across its unique three-edge cut."
+)
+PLACEBO_HINT = (
+    "The degree-two subdivision table rewards consistent bookkeeping across all its displayed edge rows."
+)
