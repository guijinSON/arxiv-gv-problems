+        rng.shuffle(vertices)
+        pairs = []
+        ok = True
+        for i in range(0, order, 2):
+            a, b = vertices[i], vertices[i + 1]
+            dist = min((a - b) % order, (b - a) % order)
+            if dist <= radius:
+                ok = False
+                break
+            pairs.append((min(a, b), max(a, b)))
+        if ok:
+            return pairs
