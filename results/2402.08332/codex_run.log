+    ref_answer, ref_ops, ref_elapsed = _reference_algorithm(inst)
+    ref_ok = ref_answer is not None and verify(inst, ref_answer)[0]
+    report["G5_density_and_baseline"] = {
+        "pass": probability < 1e-6 and ref_ok and not strongest_ok,
