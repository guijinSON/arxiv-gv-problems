        %
        \begin{scope}
          \draw[dashed] circle (2) {};

          \node[label=right:{$\strut a_2$}] (x) at (0,0) {};
          \node[label=left:{$\strut a_1$}] (y) at (180:2) {};
          \node[label=right:{$\strut a_3$}] (z) at (0:2) {};
