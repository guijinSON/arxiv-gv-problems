+    if isinstance(degree, bool) or not isinstance(degree, int):
+        raise ValueError("degree must be an odd integer at least 3")
+    if degree < 3 or degree % 2 == 0:
+        raise ValueError("degree must be an odd integer at least 3")
+    if n % degree:
