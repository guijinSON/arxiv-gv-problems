+        "n_vertices": total,
+        "core_degree": inst["core_degree"],
+        "core_vertices": [mapping[v] for v in reversed(inst["core_vertices"])],
+        "subdivisions": rows,
+        "required_side_size": inst["required_side_size"],
+        "answer": large + [[v] for v in singleton_values],
