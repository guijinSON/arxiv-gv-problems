+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, _why = verify(inst, inst["answer"])
+            g1_ok &= ok
+            checked += 1
+            json_roundtrips += int(json.loads(json.dumps(inst["answer"])) == inst["answer"])
+    report["G1_planted_verifies"] = {
+        "pass": g1_ok and json_roundtrips == checked,
