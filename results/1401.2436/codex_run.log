+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = ship_params
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for name, value in report.items()
+        if name.startswith("G") and isinstance(value, dict)
+    )
+    return report
