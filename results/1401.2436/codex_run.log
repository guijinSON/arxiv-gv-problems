+        "variable_masks": variable_masks,
+        "constraints": constraints,
+        "graph_vertex_count": 2 * n + 4 * m,
+        "graph_edge_count": n + 18 * m,
+        "answer": _answer_from_key(key, key_bits),
+    }
+
+
+def _hex(value, bits):
+    return f"{value:0{(bits + 3) // 4}x}"
+
+
+def render(inst) -> str:
