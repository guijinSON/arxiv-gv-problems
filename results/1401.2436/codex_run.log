    27	\begin{notation}
    28	    Let $C$ be a \threexor constraint involving variables $x_i, x_j, x_k$.  We write $\homog{C}$ for its homogeneous version, $x_i+x_j+x_k = 0$.  Given a collection of \threexor constraints $\calC$ we write $\homog{\calC} = \{\homog{C} : C \in \calC\}$.
    29	    
    30	\paragraph{The reduction.} Given a collection of \threexor constraints $\calC$, the corresponding \giso instance i $(G_\calC, G_{\homog{\calC}})$.
    31	\end{notation}
