+# Populated only from scripts/harden.py evidence.  During construction, "pending"
+# deliberately makes G9 fail rather than manufacturing a hardness result.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
