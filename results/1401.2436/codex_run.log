+
+def _attack_random_restart(inst, rng, restarts=256):
+    for attempt in range(restarts):
+        answer = random_candidate(inst, rng)
+        if verify(inst, answer)[0]:
+            return answer, attempt + 1
+    return random_candidate(inst, rng), restarts
