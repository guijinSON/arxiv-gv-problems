+            success = verify(inst, candidate)[0]
+            stat = attack_stats[name]
+            stat["successes"] += int(success)
+            stat["attempts"] += 1
+            stat["nodes"] += nodes
+            stat["wall_clock_sec"] += elapsed
+
+        started = time.perf_counter()
