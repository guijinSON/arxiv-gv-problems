   609	def _attack_residual_greedy(inst):
   610	    """Coarse x grid plus nearest quadratic-vertex rounding."""
   611	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   612	    _, xy, yy, _, ly, _ = inst["coefficients"]
   613	    best = None
   614	    for index in range(33):
   615	        x = x_lo + (x_hi - x_lo) * index // 32
   616	        if yy:
   617	            centre = -(xy * x + ly) // (2 * yy)
   618	        else:
   619	            centre = (y_lo + y_hi) // 2
   620	        for y in (y_lo, y_hi, max(y_lo, min(y_hi, centre - 1)),
   621	                  max(y_lo, min(y_hi, centre)),
   622	                  max(y_lo, min(y_hi, centre + 1))):
   623	            score = abs(_poly_value(inst["coefficients"], x, y))
   624	            row = (score, x, y)
   625	            if best is None or row < best:
   626	                best = row
   627	    return [best[1], best[2]]
