   505	def _recover_pell_form(inst):
   506	    """Recover the two-shear affine Pell coordinates exactly."""
   507	    original = inst["coefficients"]
   508	    for orientation in ("direct", "swap"):
   509	        if orientation == "direct":
   510	            coefficients = original
   511	        else:
   512	            # Q(v,u): rename the displayed axes before matching the template.
   513	            coefficients = _substitute_polynomial(original, 0, 1, 0, 1, 0, 0)
   514	        xx, xy, yy, lx, ly, const = coefficients
   515	        discriminant = xy * xy - 4 * xx * yy
   516	        if discriminant <= 0 or discriminant % 4 or xy % 2:
   517	            continue
   518	        pell_d = discriminant // 4
   519	        m = math.isqrt(pell_d + 1)
   520	        if m * m != pell_d + 1:
   521	            continue
   522	        shear_square = yy + pell_d
   523	        if shear_square <= 0:
   524	            continue
   525	        shear_root = math.isqrt(shear_square)
   526	        if shear_root * shear_root != shear_square:
   527	            continue
   528	        for shear in (shear_root, -shear_root):
   529	            if yy == 0 or (xy // 2 - shear) % yy:
   530	                continue
   531	            second_shear = (xy // 2 - shear) // yy
   532	            a = 1 + shear * second_shear
   533	            if _expand_pell(a, shear, second_shear, 1, 0, 0, pell_d)[:3] != coefficients[:3]:
   534	                continue
   535	            if lx % 2 or ly % 2:
   536	                continue
   537	            half_x, half_y = lx // 2, ly // 2
   538	            shift_u = half_x - second_shear * half_y
   539	            numerator = shear * half_x - a * half_y
   540	            if numerator % pell_d:
   541	                continue
   542	            shift_v = numerator // pell_d
   543	            rebuilt = _expand_pell(
   544	                a, shear, second_shear, 1, shift_u, shift_v, pell_d
   545	            )
   546	            if rebuilt == coefficients:
   547	                return (orientation, shear, second_shear,
   548	                        shift_u, shift_v, pell_d)
   549	    return None
   550	
   551	
   552	def _linear_range(a, b, const, x_bounds, y_bounds):
   553	    values = [a * x + b * y + const
   554	              for x in x_bounds for y in y_bounds]
   555	    return min(values), max(values)
