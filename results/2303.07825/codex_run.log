  1264	
  1265	    \item The equation \(XY^{-1} = 1\) in the free group $F(a,b)$ with
  1266	    generators $a,b$ has solution language with
  1267	    respect to the standard normal form, that is, freely reduced words, equal to
  1268	    \[
  1269	      L = \{w \# w \mid w \textrm{\ freely reduced over\ } \{a, a^{-1}, b, b^{-1}\}\}.
  1270	    \]
  1271	   The language \(L\) is EDT0L (similar to Example 1.3 of \cite{eqns_free_grps}), but not context-free. This generalises to any free group of finite rank.
  1272	
  1273	   We construct an EDT0L system for \(L\). Our
  1274	   alphabet is \(\Sigma = \{a, \ b, \ a^{-1}, \ b^{-1}, \ \#\}\), our extended alphabet
  1275	   will be \(C = \Sigma \cup \{\perp\}\),
  1276	   and our start word will be \(\perp \# \perp\). For each
  1277	   \(x \in \{a, \ b, \ a^{-1}, \ b^{-1}\}\), define
  1278	   \(\varphi_x \in \End(C^\ast)\) by \(\perp \varphi_x =
  1279	   x \perp\). Let \(\mathcal{R} \subseteq \End(C^\ast)\) be
  1280	   the rational set obtained by replacing every \(x \in
  1281	   \{a, \ b, \ a^{-1}, \ b^{-1}\}\) labelling an edge in
  1282	   the finite-state automaton within Figure~\ref{fig:free_red}
  1283	   with \(\varphi_x\). Doing so we obtain
  1284	   \[
  1285	     \{(\perp \# \perp) \phi \mid \phi \in \mathcal{R}\}
  1286	     = \{w \perp \# w \perp \mid w \text{ freely reduced over }
  1287	     \{a, \ b, \ a^{-1}, \ b^{-1}\}\}.
  1288	   \]
  1289	   By post-concatenating the rational control with the map
  1290	   \(\psi \in \End(C^\ast)\) defined by \(\perp \psi =
  1291	   \varepsilon\), which can be done by adding a new accept
  1292	   state, making it the only accept state and adding a
  1293	   \(\psi\)-labelled edge from every former accept state to
  1294	   the new one, we obtain a new rational set \(\mathcal{R}'
  1295	   \subseteq \End(C^\ast)\) such that
  1296	      \[
  1297	     L = \{(\perp \# \perp) \phi \mid \phi \in \mathcal{R}'\}.
  1298	   \]
  1299	   \item The language
  1300	   \[
  1301	    \{w \in \{a, \ b, \ a^{-1}, \ b^{-1}\} \mid w=_{F(a, \ b)} 1\}
  1302	   \]
  1303	   is context-free, but not EDT0L \cite{appl_L_systems_GT}.
  1304	   \item
  1305	   The language
  1306	   \[
  1307	   \{w \in \{a, \ b\}^\ast \mid |w| = n^2 \text{
  1308	   for some } n \in \mathbb{Z}_{\geq 0}\}
  1309	   \]
  1310	   is not EDT0L (Corollary IV.3.4 of \cite{math_theory_L_systems}). It is not
  1311	   difficult to show that it is ET0L, but not context-free.
  1312	   \end{enumerate}
  1313	  \end{ex}
  1314	
  1315	  \begin{theorem}[\cite{EDT0L_extensions}, Lemma 2.15]
  1316	    \label{EDT0L_closure_properties_thm}
  1317	    The class of EDT0L languages is closed under the following operations:
  1318	    \begin{enumerate}
  1319	      \item Finite unions;
  1320	      \item Intersection with regular languages;
  1321	      \item Concatenation;
  1322	      \item Kleene star closure;
  1323	      \item Image under free monoid homomorphisms.
  1324	    \end{enumerate}
  1325	%    The class of ET0L languages is closed under the above operations, together
  1326	%    with:
  1327	%    \begin{enumerate}
  1328	%      \item[(6)] Pre-image under free monoid homomorphisms.
  1329	%    \end{enumerate}
  1330	    Applying any of the operations will not affect the space complexity that
  1331	    systems for the languages involved can be constructed in, assuming that the
  1332	    regular language in (2) and the homomorphism in (5) are
  1333	    constructible in constant space.
  1334	  \end{theorem}
