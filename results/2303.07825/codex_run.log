   477	def _relabel_instance(inst, swap, flip_x, flip_y, shift_x, shift_y):
   478	    """Apply new=(signed permutation)*old+shift and carry the witness."""
   479	    sx, sy = (-1 if flip_x else 1), (-1 if flip_y else 1)
   480	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   481	    old_x, old_y = inst["answer"]
   482	    if not swap:
   483	        # old x=sx*(u-shift_x), old y=sy*(v-shift_y)
   484	        substitution = (sx, 0, -sx * shift_x, 0, sy, -sy * shift_y)
   485	        new_x = sx * old_x + shift_x
   486	        new_y = sy * old_y + shift_y
   487	        bx = sorted((sx * x_lo + shift_x, sx * x_hi + shift_x))
   488	        by = sorted((sy * y_lo + shift_y, sy * y_hi + shift_y))
   489	    else:
   490	        # u=sx*old_y+shift_x, v=sy*old_x+shift_y
   491	        substitution = (0, sy, -sy * shift_y, sx, 0, -sx * shift_x)
   492	        new_x = sx * old_y + shift_x
   493	        new_y = sy * old_x + shift_y
   494	        bx = sorted((sx * y_lo + shift_x, sx * y_hi + shift_x))
   495	        by = sorted((sy * x_lo + shift_y, sy * x_hi + shift_y))
   496	    transformed = dict(inst)
   497	    transformed["coefficients"] = _substitute_polynomial(
   498	        inst["coefficients"], *substitution
   499	    )
   500	    transformed["bounds"] = [bx, by]
   501	    transformed["answer"] = [new_x, new_y]
   502	    return transformed
