+    distinct_reasons = len({row["reason"] for row in corruption_results.values()})
+    report["G2_rejects_corruption"] = {
+        "pass": (all(row["rejected"] for row in corruption_results.values())
+                 and distinct_reasons == len(corruption_results)),
