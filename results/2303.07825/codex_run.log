+        "total": guess_total,
+        "observed_probability": observed_density,
+        "structure_aware_space": search_space(shipping),
+        "sampling_rule": "uniform over both stated inclusive integer intervals",
+        "wall_clock_sec": round(guess_elapsed, 6),
