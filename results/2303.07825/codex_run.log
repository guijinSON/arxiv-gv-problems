+def _attack_small_coordinate_ansatz(inst):
+    """Try obvious landmarks and exact square roots only at those x values."""
+    x_lo, x_hi = inst["bounds"][0]
+    points = {x_lo, x_hi, (x_lo + x_hi) // 2}
+    for value in (-2, -1, 0, 1, 2):
