   558	def _compact_pell_solver(inst):
   559	    """Public-data-only compact solver used to measure intended route effort."""
   560	    recovered = _recover_pell_form(inst)
   561	    if recovered is None:
   562	        return None, {"exact_operations": 0, "recurrence_steps": 0}
   563	    orientation, shear, second_shear, shift_u, shift_v, pell_d = recovered
   564	    m = math.isqrt(pell_d + 1)
   565	    operations = 38
   566	    if m * m != pell_d + 1:
   567	        return None, {"exact_operations": operations, "recurrence_steps": 0}
   568	    if orientation == "direct":
   569	        x_bounds, y_bounds = inst["bounds"]
   570	    else:
   571	        y_bounds, x_bounds = inst["bounds"]
   572	    a = 1 + shear * second_shear
   573	    u_range = _linear_range(a, shear, shift_u, x_bounds, y_bounds)
   574	    v_range = _linear_range(second_shear, 1, shift_v, x_bounds, y_bounds)
   575	    sign_us = (1,) if u_range[0] > 0 else ((-1,) if u_range[1] < 0 else (1, -1))
   576	    sign_vs = (1,) if v_range[0] > 0 else ((-1,) if v_range[1] < 0 else (1, -1))
   577	    operations += 12
   578	    pell_u, pell_v = 1, 0
   579	    for step in range(0, 128):
   580	        for sign_u in sign_us:
   581	            for sign_v in sign_vs:
   582	                delta_u = sign_u * pell_u - shift_u
   583	                delta_v = sign_v * pell_v - shift_v
   584	                visible_x = delta_u - shear * delta_v
   585	                visible_y = (-second_shear * delta_u + a * delta_v)
   586	                operations += 6
   587	                candidate = ([visible_x, visible_y] if orientation == "direct"
   588	                             else [visible_y, visible_x])
   589	                if verify(inst, candidate)[0]:
   590	                    return candidate, {
   591	                        "exact_operations": operations,
   592	                        "recurrence_steps": step,
   593	                    }
   594	        pell_u, pell_v = (
   595	            m * pell_u + pell_d * pell_v,
   596	            pell_u + m * pell_v,
   597	        )
   598	        operations += 4
   599	    return None, {"exact_operations": operations, "recurrence_steps": 128}
   600	
