The following proposition, which is similar to Lemma 2.20(1) of \cite{VAEP}, provides the bridge between $m$-regular and EDT0L languages that appears in the statements in Theorem \ref{thm:vab} (2) and (3).
% \begin{proposition}\label{prop:forgetful}
% 	Let $L\subset(\Sigma^*)^n$ be an $n$-regular language.
% \begin{itemize}
% \item[(i)] If $\theta\colon(\Sigma^*)^n\to\Sigma^*;~(w_1,w_2,\ldots,w_n)\mapsto w_1w_2\cdots w_n$ is the map that `forgets' the tuple structure, then $\theta(L)\subset\Sigma^*$ is EDT0L.

% \item[(ii)]	Similarly, if $\theta_{\#}\colon(\Sigma^*)^n\to(\Sigma\cup {\#})^*;(w_1,w_2,\ldots,w_n)\mapsto w_1\#w_2\#\cdots \#w_n$ is the map that inserts $\#$ between the tuple coordinates, then $\theta_{\#}(L)\subset (\Sigma \cup {\#})^*$ is EDT0L.
% \end{itemize}
