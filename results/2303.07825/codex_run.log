   630	def _attack_random_restart(inst, rng, restarts=8192):
   631	    best = None
   632	    for _ in range(restarts):
   633	        x, y = random_candidate(inst, rng)
   634	        score = abs(_poly_value(inst["coefficients"], x, y))
   635	        row = (score, x, y)
   636	        if best is None or row < best:
   637	            best = row
   638	    return [best[1], best[2]]
