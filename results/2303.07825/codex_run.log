import gen_2303_07825 as g, time
for name in ('demo','easy','hard'):
 counts=[]; t=time.perf_counter()
 seeds=range(100) if name"'!='"'hard' else range(40)
 for seed in seeds:
  i=g.make_instance(seed=seed,**g.DIFFICULTY[name])
  if not g.verify(i,i['answer'])[0]: raise SystemExit(('plant',name,seed))
  a,s=g._compact_pell_solver(i)
  if a is None or not g.verify(i,a)[0]: raise SystemExit(('compact',name,seed,s))
  counts.append(g.enumerate_all(i))
 print(name,'instances',len(counts),'count_hist',{x:counts.count(x) for x in sorted(set(counts))},'sec',round(time.perf_counter()-t,3))

# Stress construction, recovery, and relabelling without exhaustive scans.
for seed in range(50000):
 n=(5,9,2003,25003,250007,500014)[seed%6]
 i=g.make_instance(n=n,seed=seed)
 if not g.verify(i,i['answer'])[0]: raise SystemExit(('plant_stress',seed,n))
 a,s=g._compact_pell_solver(i)
 if a is None or not g.verify(i,a)[0] or s['exact_operations']>300:
  raise SystemExit(('route_stress',seed,n,s))
print('stress_ok=50000')
