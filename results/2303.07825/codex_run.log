+        pell_u, pell_v = (
+            m * pell_u + pell_d * pell_v,
+            pell_u + m * pell_v,
+        )
+        pell_step += 1
+
+    # z1 and z2 are signed/permuted visible coordinates.  The transform has
+    # determinant +/-1, hence maps Z^2 bijectively to Z^2.
+    z2 = pell_v - shift_v
