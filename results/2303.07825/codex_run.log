+# Filled from the script-owned hardening runs.  These are diagnostics only;
+# since 2026-09-05, G9 gates the size and intended-route caps, not oracle success.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
