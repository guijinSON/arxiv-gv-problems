+    pieces = []
+    for coefficient, monomial in zip(coefficients, monomials):
+        if coefficient:
+            pieces.append(_signed_term(coefficient, monomial, not pieces))
+    return "".join(pieces) if pieces else "0"
+
+
+def render(inst):
