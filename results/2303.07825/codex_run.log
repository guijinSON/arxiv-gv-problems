+                delta_v = sign_v * pell_v - shift_v
+                visible_x = delta_u - shear * delta_v
+                visible_y = (-second_shear * delta_u + a * delta_v)
+                operations += 6
+                candidate = ([visible_x, visible_y] if orientation == "direct"
+                             else [visible_y, visible_x])
