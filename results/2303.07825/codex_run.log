-def enumerate_all(inst):
-    """Count all bounded answers when the exact scan is safely capped."""
-    width = inst["bounds"][0][1] - inst["bounds"][0][0] + 1
-    if width > 300_000:
-        return None
-    solutions, _ = _discriminant_scan(inst, stop_first=False)
-    return len(solutions)
