-def escalate(params):
-    """Grow both interval widths while keeping a two-integer witness."""
-    if not isinstance(params, dict) or set(params) != {"n"}:
-        return None
-    n = params["n"]
-    _validate_n(n)
-    if n > 10 ** 295:
-        return "cap_bound"
-    return {"n": 4 * n + 3}
