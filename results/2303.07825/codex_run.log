+def _compact_pell_solver(inst):
+    """Public-data-only compact solver used to measure intended route effort."""
+    recovered = _recover_pell_form(inst)
+    if recovered is None:
+        return None, {"exact_operations": 0, "recurrence_steps": 0}
+    primary, shear, shift_u, shift_v, pell_d = recovered
+    m = math.isqrt(pell_d + 1)
+    operations = 12
+    if m * m != pell_d + 1:
+        return None, {"exact_operations": operations, "recurrence_steps": 0}
+    pell_u, pell_v = 1, 0
+    for step in range(0, 128):
+        for sign_u in (1, -1):
+            for sign_v in (1, -1):
+                visible_v = sign_v * pell_v - shift_v
+                visible_primary = sign_u * pell_u - shear * visible_v - shift_u
+                operations += 4
+                candidate = ([visible_primary, visible_v] if primary == "x"
+                             else [visible_v, visible_primary])
+                if verify(inst, candidate)[0]:
+                    return candidate, {
+                        "exact_operations": operations,
+                        "recurrence_steps": step,
+                    }
+        pell_u, pell_v = (
+            m * pell_u + pell_d * pell_v,
+            pell_u + m * pell_v,
+        )
+        operations += 4
+    return None, {"exact_operations": operations, "recurrence_steps": 128}
