   660	def escalate(params: dict) -> dict | str | None:
   661	    """Grow both interval widths while keeping a two-integer witness."""
   662	    if not isinstance(params, dict) or set(params) != {"n"}:
   663	        return None
   664	    n = params["n"]
   665	    _validate_n(n)
   666	    if n > 10 ** 295:
   667	        return "cap_bound"
   668	    return {"n": 4 * n + 3}
