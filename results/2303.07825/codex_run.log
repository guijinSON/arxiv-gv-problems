-def search_space(inst):
-    """The exact cardinality of the instance's bounded certificate language."""
-    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
-    return (x_hi - x_lo + 1) * (y_hi - y_lo + 1)
