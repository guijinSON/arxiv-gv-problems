rj = os.path.join(d, "REJECTED.md")
try:
    note = open(rj, encoding="utf-8", errors="ignore").read()
except OSError:
    sys.exit(0)
# only gate rejections that actually turn on G9
if not re.search(r"G9\(b\)|G9\b", note):
    sys.exit(0)
