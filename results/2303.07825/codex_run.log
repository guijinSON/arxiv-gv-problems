+        "pass": not failures,
+        "attempts": attempts,
+        "failures": failures,
+    }
+
+    shipping = make_instance(seed=230307825, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    x, y = shipping["answer"]
+    corruptions = {
