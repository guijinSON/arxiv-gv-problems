   641	def _attack_small_coordinate_ansatz(inst):
   642	    """Try obvious landmarks and exact square roots only at those x values."""
   643	    x_lo, x_hi = inst["bounds"][0]
   644	    points = {x_lo, x_hi, (x_lo + x_hi) // 2}
   645	    for value in (-2, -1, 0, 1, 2):
   646	        if x_lo <= value <= x_hi:
   647	            points.add(value)
   648	    candidates = []
   649	    y_lo, y_hi = inst["bounds"][1]
   650	    for x in sorted(points):
   651	        roots = _roots_for_x(inst["coefficients"], x) or []
   652	        for y in roots:
   653	            if y_lo <= y <= y_hi:
   654	                candidates.append([x, y])
   655	    if candidates:
   656	        return candidates[0]
   657	    return [min(points), y_lo]
