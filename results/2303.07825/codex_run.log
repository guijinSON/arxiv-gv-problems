+def _recover_pell_form(inst):
+    """Recover the visible triangular affine Pell coordinates exactly."""
+    xx, xy, yy, lx, ly, const = inst["coefficients"]
+    if xx == 1 and xy % 2 == 0 and lx % 2 == 0:
+        shear = xy // 2
+        pell_d = shear * shear - yy
+        shift_u = lx // 2
+        numerator = 2 * shear * shift_u - ly
+        if pell_d > 0 and numerator % (2 * pell_d) == 0:
+            shift_v = numerator // (2 * pell_d)
+            form = ("x", shear, shift_u, shift_v, pell_d)
+        else:
+            form = None
+    elif yy == 1 and xy % 2 == 0 and ly % 2 == 0:
+        shear = xy // 2
+        pell_d = shear * shear - xx
+        shift_u = ly // 2
+        numerator = 2 * shear * shift_u - lx
+        if pell_d > 0 and numerator % (2 * pell_d) == 0:
+            shift_v = numerator // (2 * pell_d)
+            form = ("y", shear, shift_u, shift_v, pell_d)
+        else:
+            form = None
+    else:
+        form = None
+    if form is None:
+        return None
+    primary, shear, shift_u, shift_v, pell_d = form
+    # Confirm the constant too; this rejects coincidental partial matches.
+    if primary == "x":
+        rebuilt = _expand_pell(1, shear, 0, 1, shift_u, shift_v, pell_d)
+    else:
+        rebuilt = _expand_pell(shear, 1, 1, 0, shift_u, shift_v, pell_d)
+    return form if rebuilt == inst["coefficients"] else None
