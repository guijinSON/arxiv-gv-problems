+    "easy": {"n": 2_003},
+    "medium": {"n": 25_003},
+    "hard": {"n": 250_007},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Look for an affine unimodular coordinate system in which the quadratic "
+    "becomes a Pell conic."
+)
+PLACEBO_HINT = (
+    "Look for careful integer bookkeeping that respects both inclusive "
