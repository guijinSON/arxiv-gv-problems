-    for _ in range(restarts):
-        x, y = random_candidate(inst, rng)
-        score = abs(_poly_value(inst["coefficients"], x, y))
-        row = (score, x, y)
-        if best is None or row < best:
-            best = row
-    return [best[1], best[2]]
