   445	def canonical_key(inst: dict) -> str:
   446	    """Normalize translations, axis reflections/swaps, order, sign, and gcd."""
   447	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   448	    width_x, width_y = x_hi - x_lo, y_hi - y_lo
   449	    normalized = _substitute_polynomial(
   450	        inst["coefficients"], 1, 0, x_lo, 0, 1, y_lo
   451	    )
   452	    forms = []
   453	    for swap in (False, True):
   454	        for flip_x in (False, True):
   455	            for flip_y in (False, True):
   456	                sx, sy = (-1 if flip_x else 1), (-1 if flip_y else 1)
   457	                ex, ey = (width_x if flip_x else 0), (width_y if flip_y else 0)
   458	                if not swap:
   459	                    coeff = _substitute_polynomial(
   460	                        normalized, sx, 0, ex, 0, sy, ey
   461	                    )
   462	                    widths = [width_x, width_y]
   463	                else:
   464	                    # old p=sx*v+ex, old q=sy*u+ey
   465	                    coeff = _substitute_polynomial(
   466	                        normalized, 0, sx, ex, sy, 0, ey
   467	                    )
   468	                    widths = [width_y, width_x]
   469	                forms.append(json.dumps(
   470	                    [widths, _primitive_coefficients(coeff)],
   471	                    separators=(",", ":"),
   472	                ))
   473	    payload = min(forms).encode("ascii")
   474	    return hashlib.sha256(payload).hexdigest()
