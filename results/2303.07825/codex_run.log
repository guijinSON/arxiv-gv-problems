+def _expand_pell(a, b, c, d, e, f, pell_d):
+    """Coefficients of (a*x+b*y+e)^2-D(c*x+d*y+f)^2-1."""
+    return [
+        a * a - pell_d * c * c,
+        2 * (a * b - pell_d * c * d),
+        b * b - pell_d * d * d,
+        2 * (a * e - pell_d * c * f),
+        2 * (b * e - pell_d * d * f),
+        e * e - pell_d * f * f - 1,
