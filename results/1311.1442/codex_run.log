+    }
+
+    # G5/G6: run all attacks at the shipping preset across eight seeds.
+    attack_names = (
+        "outlier_public_bitcount",
+        "greedy_target_bit_similarity",
+        "random_restart_256_constant_weight",
+        "standard_constant_weight_mitm_capped_16384",
