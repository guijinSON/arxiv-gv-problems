+        "index_max": "n-1",
+        "order": "strictly increasing",
+        "repetitions": False,
+    },
+}
+
+# RFC 3526 groups 14 and 15.  Both are safe primes: p and (p-1)/2 are prime.
+# The tiny Mersenne primes are used only for the hand demo and G8 tests.
+_RFC3526_GROUP14_HEX = (
