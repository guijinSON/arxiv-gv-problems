+_MODULI_BY_BITS = {
+    61: (1 << 61) - 1,
+    127: (1 << 127) - 1,
+    2048: int(_RFC3526_GROUP14_HEX, 16),
+    3072: int(_RFC3526_GROUP15_HEX, 16),
