+    },
+}
+
+# The exponents below are published Mersenne-prime exponents.  The generator
+# only uses p=2^e-1 for e in this whitelist.
+_MERSENNE_EXPONENTS = (17, 31, 61, 89, 107, 127, 521, 607, 1279,
+                       2203, 2281, 3217, 4253, 4423, 9689)
+
+DIFFICULTY: dict = {
+    "demo": {
+        "n": 6, "weight": 3, "carrier_bits": 6,
+        "modulus_exp": 61, "identity_exponent": True,
+    },
+    "easy": {
+        "n": 64, "weight": 16, "carrier_bits": 18,
+        "modulus_exp": 1279, "identity_exponent": False,
+    },
+    "medium": {
+        "n": 80, "weight": 16, "carrier_bits": 20,
+        "modulus_exp": 2203, "identity_exponent": False,
