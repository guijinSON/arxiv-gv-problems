+        "shipping_sampled_density_total": samples,
+        "shipping_sampled_density": hits / samples,
+        "exact_density": 1.0 / space,
+        "baseline_wall_clock_seconds": round(mitm_wall, 6),
+        "baseline_nodes": mitm_nodes,
+        "baseline_attack": attack_names[3],
