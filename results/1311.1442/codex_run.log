+        started = time.perf_counter()
+        got, nodes = _bounded_mitm(case)
+        mitm_wall += time.perf_counter() - started
+        mitm_nodes += nodes
+        if got is not None and verify(case, got)[0]:
+            results[attack_names[3]]["successes"] += 1
+
+    results[attack_names[3]]["nodes_total"] = mitm_nodes
+    results[attack_names[3]]["wall_clock_sec"] = round(mitm_wall, 6)
+    results[attack_names[3]]["budget_exhausted"] = True
+    results[attack_names[3]]["central_split_complete_states"] = (
