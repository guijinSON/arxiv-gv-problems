+    rejection_reasons = {}
+    for name, bad in corruptions.items():
+        ok, why = verify(inst, bad)
+        rejection_reasons[name] = {"rejected": not ok, "reason": why}
+    distinct = len({x["reason"] for x in rejection_reasons.values()})
+    report["G2_rejects_corruption"] = {
