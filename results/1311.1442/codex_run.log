+DIFFICULTY: dict = {
+    "demo": {
+        "n": 6, "weight": 3, "carrier_bits": 6,
+        "modulus_bits": 61, "identity_exponent": True,
+    },
+    "easy": {
+        "n": 64, "weight": 16, "carrier_bits": 18,
+        "modulus_bits": 2048, "identity_exponent": False,
+    },
+    "medium": {
+        "n": 80, "weight": 16, "carrier_bits": 20,
+        "modulus_bits": 2048, "identity_exponent": False,
+    },
+    "hard": {
