   469	$L$ (bits) & $\deg{h}$ (bits) &  $\mathcal{I}$\\\hline
   470	131 & 1024 & 12,8 \%\\
   471	233 & 2048 & 11,4\% \\
   472	418 & 4096 & 11,2\%
   473	\end{tabular}\caption{{Information rate matching with \cite[Section 2.2]{NSK}}}\label{tab1}
   474	\end{table}
