   489	\subsubsection{Asymptotics comparison with previous works}\label{compare}
   490	We will prove in this section that our protocol has the same asymptotic information rate of \cite{NSK}. A naive explanation of this fact is given by arguing that the number of primes below a certain number of bits has the same behaviour as the number of irreducible polynomials in $\vF_q[x]$ below a certain degree.
   491	
   492	Let us fix the notation 
   493	\[
   494	a_N\sim \,b_N\ \ \Longleftrightarrow \lim_{N\rightarrow\infty} \frac{a_N}{b_N}=1.
   495	\]
   496	}
   497	{
   498	We will make use of the following
   499	\begin{lemma}\label{lemlem}
   500	\begin{equation}\label{lemma}
   501	\sum\limits_{n=1}^N D_n^q \sim  \frac{q}{q-1} D^q_N
   502	\end{equation}
   503	\end{lemma}
   504	\begin{proof}
   505	First recall that \cite[Theorem 2.2]{Poly}
   506	\[
   507	D_n^q \sim \frac{q^n}{n}
   508	\]
   509	and therefore the sums behave asymptotically as
   510	\[
   511	\sum\limits_{n=1}^N D_n^q \sim \sum\limits_{n=1}^N \frac{q^n}{n}.
   512	\]
   513	Then we have \eqref{lemma} if and only if
   514	\begin{equation}
   515	\lim_{N\rightarrow \infty} \frac{\sum\limits_{n=1}^N \frac{q^n}{n}}{\frac{q^N}{N}} = \frac{q}{q-1}.
   516	\end{equation}
   517	
   518	Now, denote by $S_N\mathrm{:=}\sum\limits_{n=1}^N \frac{N}{n}q^{n-N}$ and observe that it might be expressed in terms of the recursive sequence
   519	\begin{equation}\label{recursion}
   520	S_{N+1} = \frac{1}{q}\frac{N+1}{N} S_N +1.
   521	\end{equation}
   522	for the initial value $S_1=1$. Consider $S_-=\liminf_{N\rightarrow\infty}S_N$ and $S_+=\limsup_{N\rightarrow\infty}S_N$. Passing to the $\limsup$ and $\liminf$ in \eqref{recursion} we get the same equation for $S_\pm$:
   523	\[
   524	S_\pm=\frac{S_\pm}{q} +1
   525	\]
   526	provided that they are both finite. Assuming that they are, we conclude that 
   527	\begin{equation}
   528	\lim_{N\rightarrow\infty}S_N=S_\pm=\frac{q}{q-1}
   529	\end{equation}
   530	
   531	
   532	This assumption is legitimate since $S_N\geq 0$ for all $N\in \mathbb{N}$, thus $S_-\geq 0$, and for $S_+$ we observe that 
   533	\begin{itemize}
   534	\item When $x\in\vR^+$ we have that $\frac{q^x}{x}$ is increasing for $x\geq \frac{1}{\log{q}}\geq 2$, since $q\geq 2$, and in particular this is true for $x\in\vN^*$;
   535	\item $\limsup_{N\rightarrow \infty} \frac{N}{q^N}\sum\limits_{n=1}^N \frac{q^n}{n}=\limsup_{N\rightarrow \infty} \frac{N}{q^N}\sum\limits_{n=2}^N \frac{q^n}{n}$.
   536	\end{itemize}
   537	It follows that 
   538	
   539	\[
   540	\limsup_{N\rightarrow \infty}\frac{N}{q^N}\sum\limits_{n=1}^N \frac{q^n}{n} = \limsup_{N\rightarrow \infty} \frac{N}{q^N}\sum\limits_{n=2}^N \frac{q^n}{n} \leq \limsup_{N\rightarrow \infty}\frac{N}{q^N}\int\limits_{2}^{N+1}\frac{q^x}{x}dx
   541	\]
   542	where the last inequality comes from the fact that $\sum\limits_{n=2}^N \frac{q^n}{n}$ are the lower sums of $\int\limits_{2}^{N+1}\frac{q^x}{x}dx$, since $\frac{q^x}{x}$ is increasing for $x\geq 2$. Moreover
   543	\[
   544	\lim_{N\rightarrow \infty}\frac{\int\limits_{2}^{N+1}\frac{q^x}{x}dx}{\frac{q^N}{N}} = \lim_{t\rightarrow \infty}\frac{\int\limits_{2}^{t+1}\frac{q^x}{x}dx}{\frac{q^t}{t}}=\lim_{t\rightarrow \infty}\frac{\frac{q^{t+1}}{t+1}}{\frac{q^t}{t}(\log{q} - \frac{1}{t})}=\frac{q}{\log{q}}
   545	\]
   546	where the second equality follows from the De L'H\^{o}pital rule. This proves that
   547	\[
   548	0\leq \liminf_{N\rightarrow \infty} S_N \leq \limsup_{N\rightarrow \infty} S_N \leq \frac{q}{\log{q}}
   549	\]
   550	and yields the claim.
   551	\end{proof}
   552	}
   553	
   554	{ We are now ready  to prove
   555	
   556	\begin{prop}\label{MSKprop}
   557	\begin{equation}\label{asympt}
   558	\mathcal{I}(q,N)\sim \frac{1}{\log_2{q}}\frac{1}{N}
   559	\end{equation}
   560	\begin{proof}
   561	Observe that $nD_n^q\sim q^n$ and therefore, from \eqref{inforate}
   562	\[
   563	\mathcal{I}(q,N)\sim\frac{\sum\limits_{n=1}^N \frac{q^n}{n}}{\log_2{q}\sum\limits_{n=1}^N q^n}
   564	\]
   565	Now, it is easy to gather that 
   566	\begin{equation}\label{geoseries}
   567	\sum\limits_{n=1}^N q^n \sim \frac{q}{q-1} q^N
   568	\end{equation}
   569	then, plugging the results of \eqref{geoseries} and of Lemma \ref{lemlem} into \eqref{inforate}, we obtain
   570	\begin{equation}
   571	\mathcal{I}(q,N)\sim \frac{1}{\log_2{q}}\frac{\frac{q}{q-1}\frac{q^N}{N}}{\frac{q}{q-1}q^N} =\frac{1}{\log_2{q}} \frac{1}{N}.
   572	\end{equation} 
   573	
   574	\end{proof}
   575	\end{prop}
   576	{
   577	We would like to compare this result with the information rate of the NSK protocol. Notice that in order to make a consistent comparison we must understand the role of our parameter $N$ in the NSK.  
   578	
   579	Once $q$ is fixed,  bounding the degree of the carrier polynomials by $N$ is the same as bounding
   580	 the number of bits required to represent any of them by the quantity $M=\left\lfloor N \log_2(q)\right\rfloor$. 
   581	
   582	The analogous bound for the NSK is then given by bounding the number of bits of the prime carriers by $M$. This is the same as bounding the prime carriers themselves by $2^M\simeq q^N$.
   583	In the following proposition the comparison is made explicit.}
