+
+def _validate(n, order, root_bound, coefficient_bound):
+    values = {
+        "n": n,
+        "order": order,
+        "root_bound": root_bound,
+        "coefficient_bound": coefficient_bound,
+    }
+    for name, value in values.items():
+        if not _is_int(value):
