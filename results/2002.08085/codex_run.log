	return True

  

def listPowerReduce(l,f):

	R.<x>=PolynomialRing(QQ)

	ll=[];

	for i in range(len(l)):

		p = R(list(reversed(l[i])))

		pp=R(f)*p

		if isType2(pp(x-1)):

			ll+=[l[i]]

	return ll

  

def randomSeidel(n):

	m=matrix(n,n)

	for i in range(n):

		for j in range(i+1,n):

			r=ZZ.random_element(0,2)

			r=1-2*r

			m[i,j]=r

			m[j,i]=r

	return m

  

def SeidelCharPolysMod(n,k):

	ll=Set([])

	R.<x> = IntegerModRing(2^k)[]

	if n % 2 == 1:

		ub=2^(binomial(k-2,2)+1)

	else:

		2^(binomial(k-2,2))

	while len(ll) < ub:

		m=randomSeidel(n)

		ll+=Set([R(m.charpoly())])

	return ll

  

