+        linear, constant = row[-2], row[-1]
+        if linear:
+            candidates.extend([(-constant) // linear,
+                               -((-constant) // -linear)])
+        if leading:
+            denominator = n * leading
+            candidates.extend([(-next_coefficient) // denominator,
+                               -((-next_coefficient) // -denominator)])
