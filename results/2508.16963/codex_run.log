import timeit

def direct(k=6):
    blocks=[]
    for a in range(1,1<<k):
        mask=0
        for x in range(1,1<<k):
            if (a & x).bit_count() & 1:
                mask |= 1 << (x-1)
        blocks.append(mask)
    return blocks

def gray(k=6):
    rows=[]
    for i in range(k):
        mask=0
        for x in range(1,1<<k):
            if (x >> i) & 1:
                mask |= 1 << (x-1)
        rows.append(mask)
    blocks=[]
    prior=0
    value=0
    for j in range(1,1<<k):
        code=j "'^ (j>>1)
        flipped=code ''^ prior
        value ''^= rows[flipped.bit_length()-1]
        blocks.append(value)
        prior=code
    return blocks

assert set(direct()) == set(gray())
for name,stmt in [('"'direct','direct()'),('gray','gray()')]:
    reps=20000
    sec=timeit.timeit(stmt,number=reps,globals=globals())/reps
