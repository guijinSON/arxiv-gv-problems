# Icosahedron: north pole 0, upper pentagon 1..5, lower pentagon 6..10,
# south pole 11.  Every edge belongs to exactly two of these 20 faces.
def _u(i):
    return 1 + (i % 5)


def _l(i):
    return 6 + (i % 5)


_BASE_FACES = tuple(
    face
    for i in range(5)
    for face in (
        (0, _u(i), _u(i + 1)),
        (_u(i), _u(i + 1), _l(i)),
        (_u(i), _l(i), _l(i - 1)),
        (11, _l(i), _l(i + 1)),
    )
)

