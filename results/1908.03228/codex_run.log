+    """Class-multiset key invariant under all generated presentation changes."""
+    labels = []
+    for component in inst["components"]:
+        labels.append(_class_from_d(_extract_d(inst, component), inst["q"]))
+    payload = [inst["p"], inst["q"], sorted(labels)]
