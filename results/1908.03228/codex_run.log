-def _component_records(d, extras, rng, p, q, g, demo=False):
-    a0 = pow(g - 1, -1, p)
-    x = (a0, 0, 1, 1)       # sigma^a0 alpha
-    y = (0, d, g, 0)        # tau^d beta
-    records = [x, y]
-    seen = set(records)
-    attempts = 0
-    while len(records) < extras + 2:
-        attempts += 1
-        if attempts > 1000:
-            raise RuntimeError("could not construct distinct redundant generators")
