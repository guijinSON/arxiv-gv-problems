+
+def search_space(inst):
+    choices = inst["q"] - 1
+    count = len(inst["components"])
+    return math.prod(range(choices - count + 1, choices + 1))
+
+
+def enumerate_all(inst):
+    """Brute-force the exact count only when the declared space is small."""
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    count = 0
+    for candidate in itertools.permutations(
+        range(2, inst["q"] + 1), len(inst["components"])
+    ):
+        count += int(verify(inst, list(candidate))[0])
+    return count
