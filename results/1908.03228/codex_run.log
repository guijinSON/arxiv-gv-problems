+        transformed_components.append({"index": 0, "generators": records})
+        carried.append(label)
+    order = list(range(len(transformed_components)))
+    if permute_components:
+        rng.shuffle(order)
+    components = []
+    answer = []
+    for new_index, old_index in enumerate(order):
+        component = transformed_components[old_index]
+        component["index"] = new_index
+        components.append(component)
+        answer.append(carried[old_index])
