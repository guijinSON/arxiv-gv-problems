-def _conjugate(element, u, v, p, q, g):
-    eta = (0, 0, u, v)
-    u_inv = pow(u, -1, p)
-    eta_inv = (0, 0, u_inv, -u_inv * v % p)
-    return _holo_mul(_holo_mul(eta, element, p, q, g), eta_inv, p, q, g)
