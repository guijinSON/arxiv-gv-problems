-def _add(left, right, p, q, g):
-    n, m = left
-    s, t = right
-    return ((n + pow(g, m, p) * s) % p, (m + t) % q)
-
-
-def _auto_compose(left, right, p):
-    """phi_left after phi_right."""
-    i, j = left
-    k, ell = right
-    return (i * k % p, (i * ell + j) % p)
