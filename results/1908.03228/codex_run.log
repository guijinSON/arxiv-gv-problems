-                matches.append(mu)
-        if len(matches) != 1:
-            return None, {
-                "wall_clock_sec": time.perf_counter() - started,
-                "class_comparisons": comparisons,
-            }
-        reconstructed.append(matches[0])
-    elapsed = time.perf_counter() - started
-    return reconstructed, {
-        "wall_clock_sec": elapsed,
-        "class_comparisons": comparisons,
-    }
