\keywords{Yang-Baxter equation, set-theoretic solution, skew brace, Hopf--Galois}

\title{Skew Braces of size $pq$}

%\author{Marco Bonatto} 
%\address[Bonatto]{Department of Algebra, Faculty of Mathematics and Physics, Charles University, Prague, Czech Republic}
%\email[Stanovsk\'y]{marco.bonatto.87@gmail.com}


