-            "Example of the required syntax: <answer>"
-            + json.dumps(format_example)
-            + "</answer>",
-            "Output nothing else inside the tags.",
-        ]
-    )
-    statement = "\n".join(lines)
-    mode = os.environ.get("GV_HINT_MODE")
-    if mode == "structural":
