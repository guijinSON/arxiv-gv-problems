-        "doubled_space_bits": search_space(doubled).bit_length() - 1,
-        "answer_atoms_both": len(answer),
-    }
-
-    invariant_checks = 0
-    carried_checks = 0
-    distinct_keys = set()
-    transformations_per_seed = 4
-    for seed in range(20):
