+        for _ in range(1, p):
+            x_powers.append(_holo_mul(x_powers[-1], x, p, q, g))
+            products += 1
+        y_power = (0, 0, 1, 0)
+        translations = set()
+        for b in range(q):
+            if b:
+                y_power = _holo_mul(y_power, y, p, q, g)
+                products += 1
+            for x_power in x_powers:
+                element = _holo_mul(x_power, y_power, p, q, g)
+                products += 1
+                translations.add(element[0] * q + element[1])
+        if len(translations) != p * q:
+            continue
+        regular_components += 1
+        reconstructed.append(_class_from_d(y[1], q))
+    elapsed = time.perf_counter() - started
+    return reconstructed if regular_components == len(inst["components"]) else None, {
+        "wall_clock_sec": elapsed,
+        "holomorph_products": products,
+        "regular_components": regular_components,
