-def _auto_apply(auto, point, p, q, g):
-    """Apply phi_(i,j) to sigma^n tau^m in M."""
-    i, j = auto
-    n, m = point
-    a0 = pow(g - 1, -1, p)
-    geometric_sum = a0 * (pow(g, m, p) - 1) % p
-    return ((i * n + j * geometric_sum) % p, m)
