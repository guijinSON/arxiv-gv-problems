-@functools.lru_cache(maxsize=None)
-def _prime_pair(lower_bound):
-    """Return primes p>q>=lower_bound with q | p-1 and an order-q g."""
-    q = max(5, lower_bound)
-    if q % 2 == 0:
-        q += 1
