import gen_1908_03228 as m

def audit(seed):
    inst=m.make_instance(n=5, seed=seed, components=4, redundant_generators=0)
    p,q,g=inst['p'],inst['q'],inst['g']
    pts=[(n,k) for n in range(p) for k in range(q)]
    for comp,mu in zip(inst['components'],inst['answer']):
        x=next(tuple(z) for z in comp['generators'] if z[2]==1)
        y=next(tuple(z) for z in comp['generators'] if z[2]==g)
        elems={m._holo_mul(m._holo_pow(x,a,p,q,g),m._holo_pow(y,b,p,q,g),p,q,g)
               for a in range(p) for b in range(q)}
        assert len(elems)==p*q
        by_trans={(z[0],z[1]):z for z in elems}
        assert len(by_trans)==p*q
        def star(a,b):
            z=by_trans[a]
            return m._add(a,m._auto_apply((z[2],z[3]),b,p,q,g),p,q,g)
        def circle(a,b):
            n,k=a; s,t=b
            return ((pow(g,t,p)*n + pow(pow(g,mu,p),k,p)*s)%p,(k+t)%q)
        witnesses=[]
        for i in range(1,p):
            for j in range(p):
                auto=(i,j)
                if all(m._auto_apply(auto,star(a,b),p,q,g)==circle(m._auto_apply(auto,a,p,q,g),m._auto_apply(auto,b,p,q,g)) for a in pts for b in pts):
                    witnesses.append(auto)
        assert witnesses, (seed,mu)
        print(seed, mu, witnesses)
for seed in range(3): audit(seed)
