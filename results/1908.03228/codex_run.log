-def _holo_pow(element, exponent, p, q, g):
-    result = (0, 0, 1, 0)
-    base = tuple(element)
-    while exponent:
-        if exponent & 1:
-            result = _holo_mul(result, base, p, q, g)
-        base = _holo_mul(base, base, p, q, g)
-        exponent //= 2
-    return result
-
