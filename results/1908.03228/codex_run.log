-            return value == prime
-    odd = value - 1
-    twos = 0
-    while odd % 2 == 0:
-        odd //= 2
-        twos += 1
-    for base in (2, 325, 9375, 28178, 450775, 9780504, 1795265022):
-        if base % value == 0:
-            continue
-        x = pow(base, odd, value)
-        if x in (1, value - 1):
-            continue
-        for _ in range(twos - 1):
-            x = x * x % value
