-    }
-
-    attack_names = (
-        "outlier_translation_rank",
-        "greedy_copy_second_projection",
-        "random_restart_256_distinct_lists",
-        "obvious_inverse_without_offset_ansatz",
-    )
-    successes = {name: 0 for name in attack_names}
-    reference_solves = 0
-    reference_comparisons = 0
