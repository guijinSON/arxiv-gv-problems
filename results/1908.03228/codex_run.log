+  "G1_planted_verifies": {
+    "attempts": 12,
+    "compact_decoder_successes": 12,
+    "json_roundtrips": 12,
+    "pass": true,
+    "successes": 12
+  },
+  "G2_rejects_corruption": {
+    "distinct_reasons": 6,
+    "pass": true,
+    "reasons": {
+      "drop_one": "wrong length: expected 20, got 19",
+      "duplicate": "class labels are not pairwise distinct",
+      "empty": "answer is empty",
+      "non_integer": "non-integer class label at component 0",
+      "out_of_range": "class label outside 2..q at component 0",
+      "swap_two": "wrong A_mu class at component 0"
+    }
+  },
