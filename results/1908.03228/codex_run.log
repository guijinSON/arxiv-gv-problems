-        compact_operations += operations
-    attacks = {
-        name: {"successes": successes[name], "attempts": _ATTACK_SEEDS}
-        for name in attack_names
-    }
-    all_failed = all(result["successes"] == 0 for result in attacks.values())
-    report["G6_adversary_panel"] = {
