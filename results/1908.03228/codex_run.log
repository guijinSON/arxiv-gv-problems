-def parse_answer(text):
-    """Parse the last tagged JSON integer list; tolerate prose and fences."""
-    if not isinstance(text, str):
-        return None
-    blocks = _ANSWER_RE.findall(text)
-    if not blocks:
-        return None
-    body = blocks[-1].strip()
-    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
-    body = re.sub(r"\s*```$", "", body)
-    try:
-        answer = json.loads(body)
-    except (TypeError, ValueError):
-        return None
-    if not isinstance(answer, list):
-        return None
-    if any(isinstance(x, bool) or not isinstance(x, int) for x in answer):
-        return None
-    return answer
-
-
-def verify(inst, answer):
-    """Check any valid vector of A_mu class labels; never read inst['answer']."""
-    if not isinstance(answer, list):
-        return False, "answer must be a JSON list"
-    if not answer:
-        return False, "answer is empty"
-    expected_length = len(inst["components"])
-    if len(answer) != expected_length:
-        return False, f"wrong length: expected {expected_length}, got {len(answer)}"
-    q = inst["q"]
-    for index, mu in enumerate(answer):
-        if isinstance(mu, bool) or not isinstance(mu, int):
-            return False, f"non-integer class label at component {index}"
-        if not 2 <= mu <= q:
-            return False, f"class label outside 2..q at component {index}"
-    if len(set(answer)) != len(answer):
-        return False, "class labels are not pairwise distinct"
-    for index, (component, mu) in enumerate(zip(inst["components"], answer)):
-        try:
-            d = _extract_d(inst, component)
-        except ValueError as exc:
-            return False, f"malformed component {index}: {exc}"
-        if d * (mu - 1) % q != 1:
-            return False, f"wrong A_mu class at component {index}"
-    return True, "ok"
-
-
-def random_candidate(inst, rng):
-    """Uniformly sample the stated distinct-label language."""
-    return rng.sample(range(2, inst["q"] + 1), len(inst["components"]))
-
-
-def search_space(inst):
-    choices = inst["q"] - 1
-    count = len(inst["components"])
-    return math.prod(range(choices - count + 1, choices + 1))
-
-
-def enumerate_all(inst):
-    """Brute-force the exact count only when the declared space is small."""
-    if search_space(inst) > _ENUMERATION_CAP:
-        return None
-    count = 0
-    for candidate in itertools.permutations(
-        range(2, inst["q"] + 1), len(inst["components"])
-    ):
-        count += int(verify(inst, list(candidate))[0])
-    return count
-
-
-def canonical_key(inst):
-    """Class-multiset key invariant under all generated presentation changes."""
-    labels = []
-    for component in inst["components"]:
-        labels.append(_class_from_d(_extract_d(inst, component), inst["q"]))
-    payload = [inst["p"], inst["q"], sorted(labels)]
-    return hashlib.sha256(
-        json.dumps(payload, separators=(",", ":")).encode("ascii")
-    ).hexdigest()
-
-
-def escalate(params):
-    """Grow the class range and presentation clutter at fixed answer length."""
-    harder = dict(params)
-    current = int(harder.get("n", 5))
-    if current >= 10_000_000:
-        return None
-    harder["n"] = min(10_000_000, current * 2 + 1)
-    harder["redundant_generators"] = min(
-        24, int(harder.get("redundant_generators", 0)) + 2
-    )
-    return harder
-
-
-def _inverse_steps(value, modulus):
-    """Number of Euclidean divisions plus the final class increment."""
-    divisions = 0
-    a, b = modulus, value
-    while b:
-        a, b = b, a % b
-        divisions += 1
-    return divisions + 1
-
-
-def _compact_decode(inst):
-    answer = []
-    operations = 0
-    for component in inst["components"]:
-        d = _extract_d(inst, component)
-        answer.append(_class_from_d(d, inst["q"]))
-        operations += _inverse_steps(d, inst["q"])
-    return answer, operations
-
-
-def _reference_class_scan(inst):
-    """Compare every classified A_mu candidate, without using modular inverse."""
-    q = inst["q"]
-    reconstructed = []
-    comparisons = 0
-    started = time.perf_counter()
-    for component in inst["components"]:
-        d = _extract_d(inst, component)
-        matches = []
-        for mu in range(2, q + 1):
-            comparisons += 1
-            if d * (mu - 1) % q == 1:
-                matches.append(mu)
-        if len(matches) != 1:
-            return None, {
-                "wall_clock_sec": time.perf_counter() - started,
-                "class_comparisons": comparisons,
-            }
-        reconstructed.append(matches[0])
-    elapsed = time.perf_counter() - started
-    return reconstructed, {
-        "wall_clock_sec": elapsed,
-        "class_comparisons": comparisons,
-    }
-
-
-def _distinct_greedy(values, q):
-    used = set()
-    answer = []
-    for value in values:
