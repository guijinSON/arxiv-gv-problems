-        "carried_witnesses_valid": carried_checks,
-        "carried_witness_attempts": invariance_attempts,
-        "distinct_unrelated_keys": len(distinct_keys),
-        "distinctness_attempts": 20,
-        "symmetries_tested": [
-            "generator-list reordering",
