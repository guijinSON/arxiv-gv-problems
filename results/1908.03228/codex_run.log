-
-TRACK = "B"
-
-PROBLEM_PROFILE = {
-    "native_domain": "algebra",
-    "object_regime": "finite_discrete",
-    "computational_core": "other",
-    "certificate_form": "integer_tuple",
-    "native_objects": [
-        "semidirect-product group Z_p semidirect Z_q",
-        "automorphisms phi_(i,j)",
-        "regular subgroups of the holomorph",
-        "skew-brace isomorphism-class parameters",
-    ],
-    "verification_operations": [
-        "exact modular multiplication",
-        "exact modular inversion relation",
-        "integer range and distinctness checks",
-    ],
-    "domain_essentiality": "native",
-    "reduction_kind": "none",
-    "reduction": None,
-    "reduction_source": "paper_central",
-    "intuition_type": "invariant",
-    "intuition_description": (
-        "The second coordinates of holomorph generators survive additive-"
-        "automorphism conjugation and determine the A_mu class; without tracing "
-        "that projection, a solver must reconstruct each regular subgroup or "
-        "compare it with every classified brace."
-    ),
-    "hardness_basis": (
-        "Track B: exhaustive comparison with the q-1 classes in Theorem 3.12 "
-        "costs O(c*q) exact congruence tests; at the hard preset the executable "
-        "reference scan uses 6,000,120 tests, whereas the compact proof route "
