-def _attack_outlier_rank(inst):
-    order = sorted(
-        range(len(inst["components"])),
-        key=lambda index: sum(record[0] for record in inst["components"][index]["generators"]),
-    )
-    answer = [0] * len(order)
-    for rank, index in enumerate(order):
-        answer[index] = 2 + rank
-    return answer
-
-
-def _attack_copy_projection(inst):
-    ds = [_extract_d(inst, component) for component in inst["components"]]
-    return _distinct_greedy(ds, inst["q"])
-
-
-def _attack_inverse_only(inst):
-    q = inst["q"]
-    guesses = []
-    for component in inst["components"]:
-        inverse = pow(_extract_d(inst, component), -1, q)
-        guesses.append(inverse if inverse >= 2 else q)
-    return _distinct_greedy(guesses, q)
-
