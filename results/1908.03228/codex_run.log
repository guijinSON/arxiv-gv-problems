-    moved = _auto_apply((left[2], left[3]), (right[0], right[1]), p, q, g)
-    translation = _add((left[0], left[1]), moved, p, q, g)
-    auto = _auto_compose((left[2], left[3]), (right[2], right[3]), p)
-    return (translation[0], translation[1], auto[0], auto[1])
