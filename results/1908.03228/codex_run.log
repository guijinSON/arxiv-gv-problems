-def _distinct_greedy(values, q):
-    used = set()
-    answer = []
-    for value in values:
-        candidate = 2 + ((value - 2) % (q - 1))
-        while candidate in used:
-            candidate = 2 + ((candidate - 1) % (q - 1))
-        used.add(candidate)
-        answer.append(candidate)
-    return answer
-
