+def _inverse_steps(value, modulus):
+    """Number of Euclidean divisions plus the final class increment."""
+    divisions = 0
+    a, b = modulus, value
+    while b:
+        a, b = b, a % b
+        divisions += 1
+    return divisions + 1
+
+
+def _compact_decode(inst):
+    answer = []
+    operations = 0
+    for component in inst["components"]:
+        d = _extract_d(inst, component)
+        answer.append(_class_from_d(d, inst["q"]))
+        operations += _inverse_steps(d, inst["q"])
+    return answer, operations
+
+
+def _reference_class_scan(inst):
+    """Compare every classified A_mu candidate, without using modular inverse."""
+    q = inst["q"]
+    reconstructed = []
+    comparisons = 0
+    started = time.perf_counter()
+    for component in inst["components"]:
+        d = _extract_d(inst, component)
+        matches = []
+        for mu in range(2, q + 1):
+            comparisons += 1
+            if d * (mu - 1) % q == 1:
+                matches.append(mu)
+        if len(matches) != 1:
+            return None, {
+                "wall_clock_sec": time.perf_counter() - started,
+                "class_comparisons": comparisons,
+            }
+        reconstructed.append(matches[0])
+    elapsed = time.perf_counter() - started
+    return reconstructed, {
+        "wall_clock_sec": elapsed,
+        "class_comparisons": comparisons,
+    }
+
+
+def _distinct_greedy(values, q):
+    used = set()
+    answer = []
+    for value in values:
+        candidate = 2 + ((value - 2) % (q - 1))
+        while candidate in used:
+            candidate = 2 + ((candidate - 1) % (q - 1))
+        used.add(candidate)
+        answer.append(candidate)
+    return answer
+
+
+def _attack_outlier_rank(inst):
+    order = sorted(
+        range(len(inst["components"])),
+        key=lambda index: sum(record[0] for record in inst["components"][index]["generators"]),
+    )
+    answer = [0] * len(order)
+    for rank, index in enumerate(order):
+        answer[index] = 2 + rank
+    return answer
