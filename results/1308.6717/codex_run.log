+
+def _even_at_least_four(value):
+    value = int(value)
+    if value < 4:
+        value = 4
+    return value if value % 2 == 0 else value + 1
+
+
+def _hex(value):
+    return hex(int(value))
+
+
+def _mask_from_bits(bits):
+    value = 0
+    for i, bit in enumerate(bits):
