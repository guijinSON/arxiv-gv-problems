+def _horizontal_translate(inst, answer, amount):
+    r, s = inst["r"], inst["s"]
+    amount %= r
+    transformed = dict(inst)
+    transformed.pop("answer", None)
+    h, v, reason = _decode_answer(inst, answer)
+    if reason != "ok":
+        raise ValueError(reason)
+    if amount & 1:
