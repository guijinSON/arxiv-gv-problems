+
+def enumerate_all(inst):
+    r, s = inst["r"], inst["s"]
+    space = 1 << (r + s)
+    if space > 1_000_000:
+        return None
+    count = 0
+    for h in range(1 << s):
+        for v in range(1 << r):
+            if _base_single_cycle(inst, h, v):
+                count += 1
+    return count
