+        density_inst, h, v, with_operations=True
+    )
+    reference_wall = time.perf_counter() - t0
+    report["G5_density_and_baseline"] = {
+        "pass": reference_ok and isinstance(hits / samples, float),
+        "shipping_density": {
+            "kind": "sampled",
+            "hits": hits,
+            "total": samples,
+            "observed_fraction": hits / samples,
