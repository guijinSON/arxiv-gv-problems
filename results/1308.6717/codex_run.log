+    v_bits = [(x & 1) ^ vertical_phase for x in range(r)]
+    inst["answer"] = {
+        "horizontal": _hex(_mask_from_bits(h_bits)),
+        "vertical": _hex(_mask_from_bits(v_bits)),
+    }
+    return inst
