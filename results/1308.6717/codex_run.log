+    # G7: monotone named ladder and an actual size-doubled build.
+    named_sizes = []
+    for params in DIFFICULTY.values():
+        named_sizes.append(make_instance(seed=0, **params)["vertex_count"])
+    doubled_params = dict(shipping)
