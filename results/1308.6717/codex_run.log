+    # Trying all sixteen affine phase combinations *with verifier feedback* is a
+    # small computer search, not a by-hand one-shot attack.
+    h = _mask_from_bits([y & 1 for y in range(s)])
+    v = _mask_from_bits([x & 1 for x in range(r)])
