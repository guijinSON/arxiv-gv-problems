+    # of accumulating the coordinate gauge.
+    h = _mask_from_bits([shifts[(y - 1) % s] & 1 for y in range(s)])
+    v = _mask_from_bits([x & 1 for x in range(r)])
+    return {"horizontal": _hex(h), "vertical": _hex(v)}
