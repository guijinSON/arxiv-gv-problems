from time import perf_counter

def subset(L,rng):
 k=rng.randrange(1+L+L*(L-1)//2)
 if k==0:return ()
 if k<=L:return(k-1,)
 k-=1+L
 for i in range(L-1):
  z=L-i-1
  if k<z:return(i,i+1+k)
  k-=z

