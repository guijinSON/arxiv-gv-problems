+
+def _attack_period_two(inst):
+    r, s = inst["r"], inst["s"]
+    candidates = []
+    for ha in range(2):
+        for hb in range(2):
+            h = _mask_from_bits([((ha * y + hb) & 1) for y in range(s)])
+            for va in range(2):
