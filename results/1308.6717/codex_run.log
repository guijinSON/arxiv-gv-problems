+
+def _attack_random_restart(inst, rng, restarts=256):
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        h = int(candidate["horizontal"], 16)
+        v = int(candidate["vertical"], 16)
+        if _base_single_cycle(inst, h, v):
+            return candidate
+    return None
