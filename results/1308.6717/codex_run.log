+    ref_solved = 0
+    ref_operations = 0
+    ref_wall = 0.0
+    for seed in seeds:
+        inst = make_instance(seed=seed, **params)
+        t0 = time.perf_counter()
+        answer = _reference_construct(inst)
+        h, v, _ = _decode_answer(inst, answer)
