+            "kind": "sampled",
+            "hits": hits,
+            "total": samples,
+            "observed_fraction": hits / samples,
+            "n": density_inst["r"] + density_inst["s"],
+        },
+        "demo_exact": {
+            "valid_answers": demo_count,
+            "candidate_space": search_space(demo_inst),
+            "r": demo_inst["r"],
+            "s": demo_inst["s"],
