+def _gauge_transform(inst, answer, q):
+    """Relabel displayed row y by x -> x+q[y]; q[0] must be zero."""
+    r, s = inst["r"], inst["s"]
+    if len(q) != s or q[0] % r:
+        raise ValueError("gauge needs q[0]=0")
