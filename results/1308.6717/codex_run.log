+    # fixed heuristics fail.  This is not certificate search: every draw has the
+    # carried certificate below.  It is analogous to filtering planted instances
+    # for a detectable planting artefact.
+    inst = None
+    presentation_draws = 1 if s < 20 else 4096
+    for draw in range(presentation_draws):
+        shifts = [rng.randrange(r) for _ in range(s - 1)]
+        shifts.append((-sum(shifts)) % r)
+        candidate_inst = {
+            "family": "truncated_square_torus_4_8_8",
+            "map_type": [4, 8, 8],
+            "r": r,
+            "s": s,
+            "vertical_shifts": shifts,
+            "base_vertex_count": r * s,
+            "vertex_count": 4 * r * s,
+            "face_count": 2 * r * s,
+            "presentation_draw": draw,
