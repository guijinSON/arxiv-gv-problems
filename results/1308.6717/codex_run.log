+    new_shifts = [
+        (old[y] + q[(y + 1) % s] - q[y]) % r for y in range(s)
+    ]
+    transformed = dict(inst)
+    transformed["vertical_shifts"] = new_shifts
+    transformed.pop("answer", None)
