+    if reason != "ok":
+        raise ValueError(reason)
+    q_parity = _mask_from_bits([z & 1 for z in q])
+    carried = {"horizontal": _hex(h ^ q_parity), "vertical": _hex(v)}
+    transformed["answer"] = carried
+    return transformed
