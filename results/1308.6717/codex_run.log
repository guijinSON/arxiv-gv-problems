+
+def _fixed_cheap_attack_succeeds(inst):
+    """Predicate used to condition the distribution, never to find its answer."""
+    candidates = [_attack_outlier_seam(inst), _attack_local_seam_greedy(inst)]
+    candidates.extend(_attack_period_two(inst))
+    for candidate in candidates:
+        h = int(candidate["horizontal"], 16)
+        v = int(candidate["vertical"], 16)
+        if _base_single_cycle(inst, h, v):
