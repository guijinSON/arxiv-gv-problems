+        "map_type": list(inst["map_type"]),
+        "r": inst["s"],
+        "s": inst["r"],
+        "vertical_shifts": [0] * inst["r"],
+        "base_vertex_count": inst["base_vertex_count"],
+        "vertex_count": inst["vertex_count"],
+        "face_count": inst["face_count"],
+        "answer": {"horizontal": _hex(iv), "vertical": _hex(ih)},
+    }
+    return transformed
