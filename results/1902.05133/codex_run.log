+}
+
+# n is the odd surface degree.  Growth adds coefficient-tensor entries but the
+# answer remains a 2 x 4 matrix.
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "coeff_bound": 2, "answer_bound": 8},
+    "easy": {"n": 17, "coeff_bound": 11, "answer_bound": 512},
+    "medium": {"n": 23, "coeff_bound": 15, "answer_bound": 1024},
+    "hard": {"n": 29, "coeff_bound": 19, "answer_bound": 2048},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
