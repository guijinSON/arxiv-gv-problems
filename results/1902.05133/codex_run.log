+    ),
+    "bounds": {
+        "rows": 2,
+        "columns": 4,
+        "fixed_pivot_block": [[1, 0], [0, 1]],
+        "free_entries": 4,
+        "entry_interval": "[-answer_bound, answer_bound] inclusive",
+        "candidate_count": "(2*answer_bound+1)^4",
