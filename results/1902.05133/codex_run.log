+    "easy": {"n": 23, "coeff_bound": 15, "answer_bound": 1024},
+    "medium": {"n": 29, "coeff_bound": 19, "answer_bound": 2048},
+    "hard": {"n": 35, "coeff_bound": 23, "answer_bound": 4096},
