+        weights = (
+            [weight_a, weight_b, weight_a, weight_b]
+            if pairing == 0
+            else [weight_a, weight_b, weight_b, weight_a]
+        )
+        answer = _rref_pair_equations(forms, weights)
+        free = [answer[0][2], answer[0][3], answer[1][2], answer[1][3]]
