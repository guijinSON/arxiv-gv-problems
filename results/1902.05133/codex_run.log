+
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+
+    # G6 attacks and the Track-B reference algorithm.
+    attack_specs = {
+        "outlier_pure_coefficient": lambda obj, seed: _attack_outlier(obj),
