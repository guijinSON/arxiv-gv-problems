+
+    encoded = json.dumps(answer, separators=(",", ":"))
+    realistic = f"I used the homogeneous restriction.\n```json\nnoise\n```\n<answer>```json\n{encoded}\n```</answer>\nDone."
+    parsed = parse_answer(realistic)
