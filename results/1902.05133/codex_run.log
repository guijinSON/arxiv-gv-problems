+        "doubled_params": doubled_params,
+        "doubled_polynomial_terms": len(doubled["polynomial_terms"]),
+        "doubled_reference_terms": doubled_ref_stats["scanned_terms"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
