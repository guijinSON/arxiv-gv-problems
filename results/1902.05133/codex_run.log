+    "easy": {"n": 17, "coeff_bound": 11, "answer_bound": 512},
+    "medium": {"n": 23, "coeff_bound": 15, "answer_bound": 1024},
+    "hard": {"n": 29, "coeff_bound": 19, "answer_bound": 2048},
