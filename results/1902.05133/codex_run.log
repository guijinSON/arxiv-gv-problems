+
+def render(inst) -> str:
+    degree = inst["degree"]
+    bound = inst["answer_bound"]
+    rows = "\n".join(
+        f"  {','.join(map(str, exponent))} : {coefficient}"
+        for coefficient, exponent in inst["polynomial_terms"]
