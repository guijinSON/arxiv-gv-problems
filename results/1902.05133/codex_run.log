+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            json_ok = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            cache_ok = _cache_matches_table(inst)
+            if not (ok and json_ok and cache_ok):
+                failures.append({
+                    "preset": preset,
+                    "seed": seed,
+                    "verify": reason,
+                    "json": json_ok,
+                    "cache": cache_ok,
