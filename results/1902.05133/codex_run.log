+def _attack_small_ansatz(inst):
+    attempts = 0
+    for u, v, w, z in itertools.product(range(-2, 3), repeat=4):
+        attempts += 1
+        candidate = [[1, 0, u, v], [0, 1, w, z]]
+        if verify(inst, candidate)[0]:
+            return candidate, attempts
+    return None, attempts
