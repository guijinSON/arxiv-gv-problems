+
+def escalate(params) -> dict | str | None:
+    """Grow the coefficient tensor while retaining a fixed-size witness."""
+    degree = int(params["n"])
+    if degree >= 71:
+        return "cap_bound"
+    return {
+        "n": degree + 6,
+        "coeff_bound": int(params["coeff_bound"]) + 4,
+        "answer_bound": int(params["answer_bound"]) * 2,
