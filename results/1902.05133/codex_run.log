+def _expand_power(linear, degree: int, weight=1):
+    """Sparse coefficients of weight*(linear[0]x0+...+linear[3]x3)^degree."""
+    out = {}
+    for exponents in _compositions(degree, 4):
+        coefficient = weight * _multinomial(degree, exponents)
