+def canonical_key(inst):
+    decoded = _affine_decode(inst)
+    base = decoded["base"]
+    digits = decoded["digits"]
+    word = decoded["word_digits"]
+    complement_digits = sorted(base - 1 - digit for digit in digits)
+    complement_word = [base - 1 - digit for digit in word]
