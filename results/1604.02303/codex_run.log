+    os.path.abspath(__file__)))))
+try:
+    from gvlib import exact_matrices, rationals
+except ImportError:                 # pragma: no cover - optional helpers
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "algebra",
+    "object_regime": "integer_lattice",
+    "computational_core": "other",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "finite semigroup generators in SL(2,Z)",
+        "a target 2x2 integer matrix",
+        "a fixed-length generator word",
+    ],
+    "verification_operations": [
+        "exact 2x2 integer matrix multiplication",
+        "exact matrix equality",
+        "integer range and word-length checks",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "Every generator is a quotient transition P(a)^-1 P(b) in one "
+        "hidden one-parameter family, so compatible adjacent factors "
+        "telescope; without recognizing that decomposition one searches "
+        "the bounded matrix-product tree."
+    ),
+    "hardness_basis": (
+        "Track B: bounded bidirectional meet-in-the-middle takes "
+        "O(n^(ceil(k/2))) exact matrix operations; shipping measurements "
+        "are filled from selftest's reference_algorithm report, whereas "
+        "decoding quotient endpoints and following the chain uses at most "
+        "184 exact operations at the named hard preset."
