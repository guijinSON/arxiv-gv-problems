   657	def _attack_raw_entry_radix(inst, rng):
   658	    del rng
   659	    base = abs(_det(_mat_tuple(inst["generators"][0])))
   660	    value = abs(inst["target"][0][1])
   661	    word = []
   662	    for _ in range(inst["word_length"]):
   663	        raw, value = value % base, value // base
   664	        word.append(_label(raw % inst["n"], inst["n"]))
   665	    return word, inst["word_length"] * 2
