   163	def _mat_mul(left, right):
   164	    a, b, c, d = left
   165	    e, f, g, h = right
   166	    return (
   167	        a * e + b * g,
   168	        a * f + b * h,
   169	        c * e + d * g,
   170	        c * f + d * h,
   171	    )
