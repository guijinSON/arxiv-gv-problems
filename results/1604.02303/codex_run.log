+        "determinant-forced length-k membership has a bidirectional meet-in-the-middle "
+        "algorithm using O(n^(ceil(k/2))) exact matrix states; at shipping "
+        "n=14, k=10, digit_bits=48 it solved 8/8 instances in 12.879927 seconds "
+        "and 969,520 product nodes (about 11,634,240 scalar arithmetic "
+        "operations) per instance on average, while the affine-coordinate "
+        "route uses 181 exact arithmetic operations."
+    ),
+    "max_answer_tokens": 16,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
