+DIFFICULTY: dict = {
+    "demo": {"n": 5, "length": 3, "height": 11},
+    "easy": {"n": 20, "length": 8, "height": 97},
+    "medium": {"n": 24, "length": 8, "height": 211},
+    "hard": {"n": 28, "length": 8, "height": 503},
