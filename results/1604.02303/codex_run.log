   668	def _attack_integral_left_quotient(inst, rng):
   669	    """Try the usual prefix test G^{-1}R integral, choosing the first tie."""
   670	    del rng
   671	    generators = [_mat_tuple(matrix) for matrix in inst["generators"]]
   672	    residual = _mat_tuple(inst["target"])
   673	    word = []
   674	    nodes = 0
   675	    for _ in range(inst["word_length"]):
   676	        integral = []
   677	        for index, generator in enumerate(generators):
   678	            determinant = _det(generator)
   679	            a, b, c, d = generator
   680	            numerator = _mat_mul((d, -b, -c, a), residual)
   681	            nodes += 1
   682	            if all(value % determinant == 0 for value in numerator):
   683	                quotient = tuple(value // determinant for value in numerator)
   684	                integral.append((index, quotient))
   685	        if not integral:
   686	            return None, nodes
   687	        index, residual = integral[0]
   688	        word.append(_label(index, inst["n"]))
   689	    return word, nodes
