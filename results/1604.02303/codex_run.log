+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "One JSON list of exactly k decimal generator indices; every index "
+        "is in 1..n, order matters, and repetitions are allowed."
+    ),
+    "bounds": {
+        "word_length": "instance k",
+        "alphabet_min": 1,
+        "alphabet_max": "instance n",
+        "repetitions": True,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 5, "length": 3, "height": 11},
+    "easy": {"n": 20, "length": 8, "height": 97},
+    "medium": {"n": 24, "length": 8, "height": 211},
+    "hard": {"n": 28, "length": 8, "height": 503},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Every displayed matrix is a quotient transition between two members "
+    "of one hidden lower-times-upper unipotent family in SL(2,Z)."
+)
+PLACEBO_HINT = (
+    "Every displayed matrix should be handled with careful attention to "
+    "the order of multiplication and exact integer arithmetic."
+)
+
+# Replaced with script-owned measurements after the three oracle runs.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
