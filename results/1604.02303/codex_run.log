\[
u\in L\Big(\F(\A_1,\dots,\A_{t-3},\,\A_{t-2},\,M_1,\dots,M_{t-3},\,M_{t-2}U_iD_{t-1};\,M_t)\Big)
\]
and
\[
\phi(w_1)M_1\dots\phi(w_{t-2})M_{t-2}U_iD_{t-1}\phi(u)^{-1} =M_t.
\]
