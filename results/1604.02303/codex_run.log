   586	        states = following
   587	
   588	    right_determinant = abs(_det(generators[0])) ** right_depth
   589	    found = None
   590	
   591	    def decode(code, length):
   592	        values = [0] * length
   593	        for position in range(length - 1, -1, -1):
   594	            code, values[position] = divmod(code, n)
   595	        return values
   596	
   597	    def visit(depth, matrix, code):
   598	        nonlocal nodes, found
   599	        if found is not None:
   600	            return
   601	        if depth == right_depth:
   602	            a, b, c, d = matrix
   603	            adjugate = (d, -b, -c, a)
   604	            numerator = _mat_mul(target, adjugate)
   605	            if any(value % right_determinant for value in numerator):
   606	                return
   607	            needed = tuple(value // right_determinant for value in numerator)
   608	            left_code = states.get(needed)
   609	            if left_code is not None:
   610	                found = decode(left_code, left_depth) + decode(code, right_depth)
   611	            return
   612	        for index, generator in enumerate(generators):
   613	            nodes += 1
   614	            visit(depth + 1, _mat_mul(matrix, generator), code * n + index)
   615	            if found is not None:
   616	                return
   617	
   618	    visit(0, _IDENTITY, 0)
   619	    answer = None if found is None else [_label(index, n) for index in found]
   620	    return answer, nodes
