+        "generator-label validation",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Recognize the common rank-one affine line of the generators and use its "
+        "coordinate as a base-det(G) digit; without that change of variables, "
+        "bounded bidirectional product search enumerates exponentially many words."
+    ),
+    "hardness_basis": (
+        "Track B: Theorem 1 gives an EXPSPACE decision procedure in general, and "
+        "determinant-forced length-k membership has a bidirectional meet-in-the-middle "
+        "algorithm using O(n^(ceil(k/2))) exact matrix states; at shipping "
+        "n=14, k=10, digit_bits=48 it solved 8/8 instances in 3.248035 seconds "
