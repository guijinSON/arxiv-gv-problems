   630	def _attack_direct_greedy(inst, rng):
   631	    del rng
   632	    generators = [_mat_tuple(matrix) for matrix in inst["generators"]]
   633	    target = _mat_tuple(inst["target"])
   634	    prefix = _IDENTITY
   635	    word = []
   636	    nodes = 0
   637	    for _ in range(inst["word_length"]):
   638	        trials = [_mat_mul(prefix, generator) for generator in generators]
   639	        nodes += len(trials)
   640	        index = min(
   641	            range(inst["n"]),
   642	            key=lambda i: sum(abs(a - b) for a, b in zip(trials[i], target)),
   643	        )
   644	        word.append(_label(index, inst["n"]))
   645	        prefix = trials[index]
   646	    return word, nodes
