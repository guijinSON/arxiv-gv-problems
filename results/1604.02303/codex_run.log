   380	def parse_answer(text):
   381	    try:
   382	        if not isinstance(text, str):
   383	            return None
   384	        match = _ANSWER_RE.search(text)
   385	        if not match:
   386	            return None
   387	        body = match.group(1).strip()
   388	        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
   389	        body = re.sub(r"\s*```$", "", body).strip()
   390	        if not body:
   391	            return []
   392	        try:
   393	            value = json.loads(body)
   394	        except (TypeError, ValueError):
   395	            return None
   396	        if not isinstance(value, list) or not all(isinstance(x, str) for x in value):
   397	            return None
   398	        return value
   399	    except Exception:
   400	        return None
