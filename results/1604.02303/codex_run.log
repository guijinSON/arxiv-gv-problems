    return [[a, b], [c, d]]


def _mat_mul(left, right):
    a, b, c, d = left
    e, f, g, h = right
    return (
        a * e + b * g,
        a * f + b * h,
        c * e + d * g,
        c * f + d * h,
    )


def _mat_pow(matrix, exponent, counter=None):
