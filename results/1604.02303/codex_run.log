%H(n) = \left\{\begin{bmatrix} a_{11} & a_{12}\\ a_{21} & a_{22}\end{bmatrix}\in \GL : n \text{ divides } a_{21}\right\},\ 
%F(n) = \left\{\begin{bmatrix} a_{11} & a_{12}\\ a_{21} & a_{22}\end{bmatrix}\in \GL : n \text{ divides } a_{12}\right\}.
