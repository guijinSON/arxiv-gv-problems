   623	def _attack_outlier_norm(inst, rng):
   624	    del rng
   625	    generators = [_mat_tuple(matrix) for matrix in inst["generators"]]
   626	    index = min(range(inst["n"]), key=lambda i: sum(x * x for x in generators[i]))
   627	    return [_label(index, inst["n"])] * inst["word_length"], 1
