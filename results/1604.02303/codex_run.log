   280	
   281	    rng = random.Random(seed)
   282	    lower = 1 << (digit_bits - 1)
   283	    base = rng.randrange(lower, 1 << digit_bits)
   284	    if base <= n + 1:
   285	        base = n + 2
   286	
   287	    digits = [0, base - 1]
   288	    if base - 2 <= sys.maxsize:
   289	        interior = rng.sample(range(1, base - 1), n - 2)
   290	    else:
   291	        # random.sample(range(...)) asks len(range), which overflows Py_ssize_t
   292	        # once escalation reaches a 64-bit radix. Direct rejection sampling
   293	        # retains deterministic, uniform draws for the small n used here.
   294	        interior = []
   295	        selected = set()
   296	        while len(interior) < n - 2:
   297	            value = rng.randrange(1, base - 1)
   298	            if value not in selected:
   299	                selected.add(value)
   300	                interior.append(value)
   301	    digits.extend(interior)
   302	    rng.shuffle(digits)
   303	
   304	    # If the displayed triangular entries were the radix digits themselves, a
   305	    # solver could peel the word from the left: exactly one G^{-1}*Target would
   306	    # remain integral at each step. Put every entry in the same residue class
   307	    # modulo B^k instead. After any t <= k proposed left factors, all n
   308	    # quotients remain integral; a wrong branch is exposed only by the terminal
   309	    # equality. Affine endpoint normalisation still recovers the hidden base-B
   310	    # digits, because pairwise differences are B^k(e_i-e_j).
   311	    camouflage_modulus = base ** word_length
   312	    # A multiple of B-1 also makes digit complementation an actual integral
   313	    # unimodular conjugation, which is one of canonical_key's normalisations.
   314	    offset = (base - 1) * rng.randrange(camouflage_modulus // (base - 1))
   315	
   316	    basis = _conjugator(rng)
   317	    generators = []
   318	    for digit in digits:
   319	        triangular = (base, offset + camouflage_modulus * digit, 0, 1)
   320	        generators.append(_conjugate(triangular, basis))
   321	
   322	    word = [rng.randrange(n) for _ in range(word_length)]
   323	    target = _IDENTITY
   324	    for index in word:
