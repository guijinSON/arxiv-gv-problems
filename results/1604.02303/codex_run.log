+    "Every displayed matrix is a quotient transition between two members "
+    "of one hidden lower-times-upper unipotent family in SL(2,Z)."
+)
+PLACEBO_HINT = (
+    "Every displayed matrix should be handled with careful attention to "
+    "the order of multiplication and exact integer arithmetic."
+)
+
+# Replaced with script-owned measurements after the three oracle runs.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
