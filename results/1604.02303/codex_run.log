+NOTES = r"""
+Step-0 paper reading.  The Introduction defines membership as finding k>=1
+and generator indices i_1,...,i_k whose ordered matrix product is the target;
+Section 2 includes the identity in the generated semigroup.  Theorem 1 proves
+decidability for arbitrary finite sets of nonsingular 2x2 integer matrices.
+Its proof bounds occurrences of generators with determinant magnitude at
+least two by log_2 |det(M)|.  Proposition 7 and Corollary 8 handle the GL(2,Z)
+part by the unique canonical words of Definition 4 and the Can(A) automaton.
+Theorem 19 completes the regular-language construction.  The paper explicitly
+places its general algorithm in EXPSPACE because matrix-to-word translation
+and automaton construction cause exponential memory blow-up.
+
+What makes regimes easy.  The Introduction records polynomial time for one
+generator (the Orbit problem), for commutative generators, and for the modular
+group.  Corollary 6 also gives every GL(2,Z) matrix a unique canonical word.
+This generated distribution has a still stronger construction-specific
+shortcut, so Track A would be false.  The honest Track-B reference algorithm
+is bidirectional exhaustive product search for the stated exact word length,
+with O(n^(ceil(k/2))) time and memory; selftest measures it at shipping size.
+
+Generation is composition of identities, never solution of a completed
+instance.  Put L(t)=[[1,0],[t,1]], U(t^2)=[[1,t^2],[0,1]], and
+P(t)=L(t)U(t^2).  Draw distinct positive t values, arrange them in one random
+directed cycle, and emit every edge P(a)^-1 P(b), in random generator order.
+Choose a start vertex and multiply the next k cycle edges.  They telescope to
+P(start)^-1 P(end), which is emitted as the target; the traversed generator
+indices are the planted certificate.  All edges, including certificate edges,
+come from the same random cycle distribution.
+
+For M=P(a)^-1P(b), let q=M[1][0].  Then
+M[0][0]=1-a^2*q and M[1][1]=1+b^2*q.  Exact division and integer square roots
+recover the directed endpoints, after which the unique outgoing edge can be
+followed.  This is the compact route and the decomposition intuition.  It is
+not used by generation or verification.
+
+Attack handling.  Random vertex order and a final random generator relabelling
+remove position signals.  The adversary panel tries trace/magnitude outliers,
+residual-norm greedy multiplication, 256 uniform random restarts, and a
+bottom-left-entry ordering that is executable by hand.  The reference
+meet-in-the-middle solver is expected to succeed and is reported separately,
+as Track B requires.  canonical_key is invariant under generator relabelling
+and simultaneous integral change of basis by using conjugacy trace invariants.
+""".strip()
+
+
+Matrix = tuple[tuple[int, int], tuple[int, int]]
+IDENTITY: Matrix = ((1, 0), (0, 1))
+
+
+def _mat(raw: object) -> Matrix:
+    return (
+        (int(raw[0][0]), int(raw[0][1])),  # type: ignore[index]
+        (int(raw[1][0]), int(raw[1][1])),  # type: ignore[index]
+    )
+
+
+def _json_matrix(matrix: Matrix) -> list[list[int]]:
+    return [list(matrix[0]), list(matrix[1])]
+
+
+def _mul(left: Matrix, right: Matrix) -> Matrix:
+    a, b = left[0]
+    c, d = left[1]
+    e, f = right[0]
+    g, h = right[1]
+    return ((a * e + b * g, a * f + b * h),
+            (c * e + d * g, c * f + d * h))
+
+
+def _det(matrix: Matrix) -> int:
+    return matrix[0][0] * matrix[1][1] - matrix[0][1] * matrix[1][0]
+
+
+def _trace(matrix: Matrix) -> int:
+    return matrix[0][0] + matrix[1][1]
+
+
+def _inverse_unimodular(matrix: Matrix) -> Matrix:
+    determinant = _det(matrix)
+    if determinant not in (-1, 1):
+        raise ValueError("matrix is not unimodular")
+    a, b = matrix[0]
+    c, d = matrix[1]
+    return ((d // determinant, -b // determinant),
+            (-c // determinant, a // determinant))
+
+
+def _product(generators: list[Matrix], word: object) -> Matrix:
+    value = IDENTITY
+    for index in word:  # type: ignore[union-attr]
+        value = _mul(value, generators[index - 1])
+    return value
+
+
+def _p_matrix(value: int) -> Matrix:
+    # L(value) U(value^2), determinant one.
+    return ((1, value * value),
+            (value, value * value * value + 1))
+
+
+def _quotient(source: int, destination: int) -> Matrix:
+    return _mul(_inverse_unimodular(_p_matrix(source)),
+                _p_matrix(destination))
+
+
+def _validate_parameters(n: int, length: int, height: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4:
+        raise ValueError("n must be an integer at least 4")
+    if isinstance(length, bool) or not isinstance(length, int) or length < 2:
+        raise ValueError("length must be an integer at least 2")
+    if length >= n:
+        raise ValueError("length must be strictly smaller than n")
+    if isinstance(height, bool) or not isinstance(height, int) or height < n + 1:
+        raise ValueError("height must be an integer at least n+1")
+
+
+def make_instance(n: int, seed: int = 0, length: int = 8,
+                  height: int = 503, **params: object) -> dict:
+    """Construct a certified bounded matrix-semigroup membership instance."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_parameters(n, length, height)
+    rng = random.Random(seed)
+
+    vertices = rng.sample(range(2, height + 1), n)
+    cycle = list(vertices)
+    rng.shuffle(cycle)
+    edge_pairs = [(cycle[i], cycle[(i + 1) % n]) for i in range(n)]
+
+    edge_order = list(range(n))
+    rng.shuffle(edge_order)
+    generators = [_quotient(*edge_pairs[edge_id]) for edge_id in edge_order]
+    edge_to_generator = {edge_id: position + 1
+                         for position, edge_id in enumerate(edge_order)}
+
+    start_edge = rng.randrange(n)
+    path_edge_ids = [(start_edge + offset) % n for offset in range(length)]
+    answer = [edge_to_generator[edge_id] for edge_id in path_edge_ids]
+    target = _quotient(cycle[start_edge], cycle[(start_edge + length) % n])
+
+    return {
+        "n": n,
+        "length": length,
+        "height": height,
+        "generators": [_json_matrix(matrix) for matrix in generators],
+        "target": _json_matrix(target),
+        "answer": answer,
+    }
+
+
+def _matrix_text(matrix: object) -> str:
+    m = _mat(matrix)
+    return f"[[{m[0][0]}, {m[0][1]}], [{m[1][0]}, {m[1][1]}]]"
+
+
+def render(inst: dict) -> str:
+    """Render the full task, with no structural hint unless explicitly set."""
+    n = inst["n"]
+    length = inst["length"]
+    lines = [
+        "Find a fixed-length witness for 2 x 2 integer-matrix semigroup membership",
+        "",
+        f"You are given {n} ordered generators G1,...,G{n}, each a nonsingular",
+        "2 x 2 integer matrix, and one target matrix T.  Matrix multiplication",
+        "is ordinary ordered multiplication over the integers: for",
+        "A=[[a,b],[c,d]] and B=[[e,f],[g,h]],",
+        "",
+        "  A*B = [[a*e+b*g, a*f+b*h],",
+        "         [c*e+d*g, c*f+d*h]].",
+        "",
+        f"Find exactly {length} generator indices [i1,...,i{length}] such that",
+        f"G_i1 * G_i2 * ... * G_i{length} = T.",
+        f"Every index is an integer in the inclusive range 1,...,{n}.",
+        "Order matters and repeated indices are allowed.  All arithmetic is exact;",
+        "there is no reduction modulo any number.  A solution is guaranteed.",
+        "",
+        "Generators:",
+    ]
+    for index, matrix in enumerate(inst["generators"], 1):
+        lines.append(f"  G{index} = {_matrix_text(matrix)}")
+    lines.extend([
+        "",
+        f"Target T = {_matrix_text(inst['target'])}",
+        "",
+        "Give your final answer inside <answer></answer> tags as one JSON list",
+        f"of exactly {length} decimal integers.",
+        f"Example format: <answer>[1, 2, 2, {n}]</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: object) -> object | None:
+    """Parse the tagged JSON word from prose, whitespace, or markdown fences."""
+    if not isinstance(text, str):
+        return None
+    match = re.search(r"<answer\b[^>]*>(.*?)</answer\s*>", text,
+                      flags=re.IGNORECASE | re.DOTALL)
+    if match:
+        payload = match.group(1).strip()
+    else:
+        fenced = re.search(r"```(?:json)?\s*(\[[\s\S]*?\])\s*```", text,
+                           flags=re.IGNORECASE)
+        if fenced:
+            payload = fenced.group(1)
+        else:
+            bare = re.search(r"\[[\s\d,+-]*\]", text)
+            if not bare:
+                return None
+            payload = bare.group(0)
+    payload = re.sub(r"^```(?:json)?\s*|\s*```$", "", payload,
+                     flags=re.IGNORECASE).strip()
+    try:
+        answer = json.loads(payload)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(answer, list):
+        return None
+    return answer
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any fixed-length product witness without consulting the plant."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "word is empty"
+    required = inst["length"]
+    if len(answer) != required:
+        return False, f"wrong length: got {len(answer)}, need exactly {required}"
+    n = inst["n"]
+    for position, index in enumerate(answer, 1):
+        if isinstance(index, bool) or not isinstance(index, int):
+            return False, f"index at position {position} is not an integer"
+        if not 1 <= index <= n:
+            return False, (
+                f"index at position {position} is {index}, outside 1..{n}"
+            )
+    generators = [_mat(matrix) for matrix in inst["generators"]]
+    actual = _product(generators, answer)
+    target = _mat(inst["target"])
+    if actual != target:
+        return False, (
+            "product mismatch: got " + _matrix_text(actual)
+            + ", target is " + _matrix_text(target)
+        )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from the statement-aware space [1..n]^k."""
+    return [rng.randrange(1, inst["n"] + 1)
+            for _ in range(inst["length"])]
+
+
+def search_space(inst: dict) -> int:
+    return inst["n"] ** inst["length"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count all accepted words when at most 500,000 candidates are needed."""
+    if search_space(inst) > 500_000:
+        return None
+    generators = [_mat(matrix) for matrix in inst["generators"]]
+    target = _mat(inst["target"])
+    count = 0
+    for word in itertools.product(range(1, inst["n"] + 1),
+                                  repeat=inst["length"]):
+        if _product(generators, word) == target:
+            count += 1
+    return count
+
+
+def canonical_key(inst: dict) -> str:
+    """A generator-relabeling and simultaneous-conjugacy invariant key."""
+    generators = [_mat(matrix) for matrix in inst["generators"]]
+    target = _mat(inst["target"])
+    singles = sorted((_trace(g), _det(g), _trace(_mul(g, target)))
+                     for g in generators)
+    pairs = sorted(_trace(_mul(generators[i], generators[j]))
+                   for i in range(len(generators))
+                   for j in range(i, len(generators)))
+    payload = {
+        "n": inst["n"],
+        "length": inst["length"],
+        "target": [_trace(target), _det(target)],
+        "singles": singles,
+        "pair_product_traces": pairs,
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params: dict) -> dict:
+    """Grow the generator haystack and coefficient crowding, not the word."""
+    result = {key: value for key, value in params.items() if key != "_preset"}
+    current_n = int(result.get("n", 20))
+    result["n"] = min(44, current_n + 6)
+    result["height"] = max(int(result.get("height", 97)) * 3,
+                           int(result["n"]) + 1)
+    # The fixed answer length remains unchanged.  Once n reaches the compact
+    # route's operation cap, coefficient height remains an unlimited axis.
+    return result
+
+
+# ---------------------------------------------------------------------------
+# Reference solver and adversary panel
+
+
+def _words_of_length(generators: list[Matrix], depth: int,
+                     counter: list[int]):
+    """Yield (product, word), counting one tree edge per multiplication."""
+    n = len(generators)
+
+    def visit(level: int, product: Matrix, word: tuple[int, ...]):
+        if level == depth:
+            yield product, word
+            return
+        for index in range(n):
+            counter[0] += 1
+            yield from visit(level + 1, _mul(product, generators[index]),
+                             word + (index + 1,))
+
+    yield from visit(0, IDENTITY, ())
+
+
+def _reference_mitm(inst: dict) -> tuple[list[int] | None, dict]:
+    """Generic exact-length bidirectional product search; uses no plant."""
+    generators = [_mat(matrix) for matrix in inst["generators"]]
+    target = _mat(inst["target"])
+    left_depth = inst["length"] // 2
+    right_depth = inst["length"] - left_depth
+    counter = [0]
+    started = time.perf_counter()
+
+    prefixes: dict[Matrix, tuple[int, ...]] = {}
+    for product, word in _words_of_length(generators, left_depth, counter):
+        prefixes.setdefault(product, word)
+
+    answer = None
+    full_suffixes = 0
+    for suffix_product, suffix_word in _words_of_length(
+            generators, right_depth, counter):
+        full_suffixes += 1
+        needed = _mul(target, _inverse_unimodular(suffix_product))
+        prefix_word = prefixes.get(needed)
+        if prefix_word is not None:
+            candidate = list(prefix_word + suffix_word)
+            if verify(inst, candidate)[0]:
+                answer = candidate
+                break
+
+    elapsed = time.perf_counter() - started
+    # Each tree edge and each target*inverse product is one 2x2 multiply,
+    # counted conservatively as 8 scalar multiplications + 4 additions.
+    exact_operations = 12 * (counter[0] + full_suffixes)
+    return answer, {
+        "wall_clock_sec": elapsed,
+        "tree_nodes": counter[0],
+        "full_suffixes_tested": full_suffixes,
+        "exact_operations": exact_operations,
+        "stored_prefix_products": len(prefixes),
+    }
+
+
+def _attack_outlier(inst: dict) -> list[int]:
+    generators = [_mat(matrix) for matrix in inst["generators"]]
+    target_trace = _trace(_mat(inst["target"]))
+    ranked = sorted(range(len(generators)),
+                    key=lambda i: (abs(_trace(generators[i]) - target_trace),
+                                   sum(abs(x) for row in generators[i] for x in row),
+                                   i))
+    return [index + 1 for index in ranked[:inst["length"]]]
+
+
+def _attack_greedy(inst: dict) -> list[int]:
+    generators = [_mat(matrix) for matrix in inst["generators"]]
+    target = _mat(inst["target"])
+    current = IDENTITY
+    word = []
+    for _ in range(inst["length"]):
+        choices = []
+        for index, generator in enumerate(generators):
+            value = _mul(current, generator)
+            distance = sum(abs(value[r][c] - target[r][c])
+                           for r in range(2) for c in range(2))
+            choices.append((distance, index, value))
+        _, index, current = min(choices)
+        word.append(index + 1)
+    return word
+
+
+def _attack_random_restart(inst: dict, seed: int,
+                           restarts: int = 256) -> list[int]:
+    rng = random.Random(0x5EED5EED ^ seed)
+    latest = [1] * inst["length"]
+    for _ in range(restarts):
+        latest = random_candidate(inst, rng)  # type: ignore[assignment]
+        if verify(inst, latest)[0]:
+            return latest
+    return latest
+
+
+def _attack_bottom_left_order(inst: dict) -> list[int]:
+    generators = [_mat(matrix) for matrix in inst["generators"]]
+    target_q = _mat(inst["target"])[1][0]
+    ranked = sorted(range(len(generators)),
+                    key=lambda i: (abs(generators[i][1][0] - target_q),
+                                   abs(generators[i][1][0]), i))
+    return [index + 1 for index in ranked[:inst["length"]]]
+
+
+def _permute_instance(inst: dict, order: list[int]) -> dict:
+    """Reorder generators; order[new_position] is an old zero-based index."""
+    inverse = {old: new for new, old in enumerate(order)}
+    transformed = dict(inst)
+    transformed["generators"] = [inst["generators"][old] for old in order]
+    transformed["answer"] = [inverse[index - 1] + 1 for index in inst["answer"]]
+    return transformed
+
+
+def _conjugate_instance(inst: dict, change: Matrix) -> dict:
+    inverse = _inverse_unimodular(change)
+
+    def conjugate(raw: object) -> list[list[int]]:
+        return _json_matrix(_mul(_mul(inverse, _mat(raw)), change))
+
+    transformed = dict(inst)
+    transformed["generators"] = [conjugate(g) for g in inst["generators"]]
+    transformed["target"] = conjugate(inst["target"])
+    transformed["answer"] = list(inst["answer"])
+    return transformed
+
+
+def _answer_atoms(answer: object) -> int:
+    if isinstance(answer, dict):
+        return sum(_answer_atoms(value) for value in answer.values())
+    if isinstance(answer, (list, tuple)):
+        return sum(_answer_atoms(value) for value in answer)
+    return 1
+
+
+def _corruptions(inst: dict) -> list[object]:
+    answer = list(inst["answer"])
+    swapped = list(answer)
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    duplicated = list(answer)
+    duplicated[1] = duplicated[0]
+    if duplicated == answer:
+        duplicated[1] = (duplicated[0] % inst["n"]) + 1
+    return [answer[:-1], swapped, duplicated, [], answer[:-1] + [inst["n"] + 1]]
+
+
+def selftest() -> dict:
+    """Run correctness, density, attacks, scaling, invariance, and size gates."""
+    report: dict = {}
+
+    g1_checks = 0
+    json_checks = 0
+    g1_failure = None
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 2):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_checks += 1
+            if not ok and g1_failure is None:
+                g1_failure = f"{preset}/seed={seed}: {reason}"
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_checks += 1
+    report["G1_planted_verifies"] = {
+        "pass": g1_failure is None and json_checks == g1_checks,
+        "verified": g1_checks - (1 if g1_failure else 0),
+        "attempts": g1_checks,
+        "json_roundtrips": json_checks,
+        "failure": g1_failure,
+    }
+
+    shipping = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    reasons = []
+    corruption_accepts = 0
+    for corrupted in _corruptions(shipping):
+        ok, reason = verify(shipping, corrupted)
+        corruption_accepts += int(ok)
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": corruption_accepts == 0 and len(set(reasons)) == len(reasons),
+        "rejected": len(reasons) - corruption_accepts,
+        "attempts": len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "reasons": reasons,
+    }
+
+    model_response = (
+        "I multiplied the matrices in the stated order.\n\n```json\n"
+        f"<answer>{json.dumps(shipping['answer'])}</answer>\n```"
+    )
+    parsed = parse_answer(model_response)
+    garbage = parse_answer("No final witness was produced.")
+    report["G3_round_trip"] = {
+        "pass": parsed == shipping["answer"] and garbage is None,
+        "prose_fence_tag_roundtrip": parsed == shipping["answer"],
+        "garbage_is_none": garbage is None,
+    }
+
+    guess_rng = random.Random(0x160402303)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_started = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(shipping,
+                                 random_candidate(shipping, guess_rng))[0])
+    guess_elapsed = time.perf_counter() - guess_started
+    guess_probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_probability,
+        "structure_aware_space": search_space(shipping),
+        "sampling_wall_clock_sec": guess_elapsed,
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+
+    attack_seeds = tuple(range(8))
+    attack_successes = {
+        "outlier_trace_and_magnitude": 0,
+        "greedy_residual_norm": 0,
+        "random_restart_256": 0,
+        "by_hand_bottom_left_order": 0,
+    }
+    reference_rows = []
+    reference_solved = 0
+    for seed in attack_seeds:
+        inst = make_instance(seed=seed,
+                             **DIFFICULTY[SHIPPING_DIFFICULTY])
+        candidates = {
+            "outlier_trace_and_magnitude": _attack_outlier(inst),
+            "greedy_residual_norm": _attack_greedy(inst),
+            "random_restart_256": _attack_random_restart(inst, seed),
+            "by_hand_bottom_left_order": _attack_bottom_left_order(inst),
+        }
+        for name, candidate in candidates.items():
+            attack_successes[name] += int(verify(inst, candidate)[0])
+        reference_answer, metrics = _reference_mitm(inst)
+        solved = reference_answer is not None and verify(inst, reference_answer)[0]
+        reference_solved += int(solved)
+        metrics["solved"] = solved
+        reference_rows.append(metrics)
+
+    def mean_metric(name: str) -> float:
+        return sum(float(row[name]) for row in reference_rows) / len(reference_rows)
+
+    reference_algorithm = {
+        "name": "bidirectional meet-in-the-middle exact product search",
+        "complexity": "O(n^(ceil(k/2))) time and memory",
+        "wall_clock_sec_mean": mean_metric("wall_clock_sec"),
+        "wall_clock_sec_max": max(row["wall_clock_sec"] for row in reference_rows),
+        "tree_nodes_mean": mean_metric("tree_nodes"),
+        "exact_operations_mean": mean_metric("exact_operations"),
+        "stored_prefix_products_mean": mean_metric("stored_prefix_products"),
+        "successes": reference_solved,
+        "attempts": len(attack_seeds),
+        "solves": f"{reference_solved}/{len(attack_seeds)}, as expected",
+    }
+
+    report["G5_density_and_baseline"] = {
+        "pass": isinstance(guess_probability, float)
+        and reference_solved == len(attack_seeds),
+        "shipping_valid_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_sampled_density": guess_probability,
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_count": search_space(demo),
+        "baseline_wall_clock_sec_mean": reference_algorithm["wall_clock_sec_mean"],
+        "baseline_tree_nodes_mean": reference_algorithm["tree_nodes_mean"],
+        "baseline_exact_operations_mean": reference_algorithm["exact_operations_mean"],
+    }
+
+    attacks_report = {
+        name: {"successes": successes, "attempts": len(attack_seeds)}
+        for name, successes in attack_successes.items()
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(value == 0 for value in attack_successes.values())
+        and reference_solved == len(attack_seeds),
+        "attacks": attacks_report,
+        "reference_algorithm": reference_algorithm,
+    }
+
+    shipping_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled_params["height"] = max(doubled_params["height"] * 2,
+                                   doubled_params["n"] + 1)
+    doubled = make_instance(seed=271828, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and search_space(doubled) > search_space(shipping)
+        and len(doubled["answer"]) == len(shipping["answer"]),
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "shipping_space": search_space(shipping),
+        "doubled_space": search_space(doubled),
+        "answer_length_before": len(shipping["answer"]),
+        "answer_length_after": len(doubled["answer"]),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    witness_checks = 0
+    distinct_keys = set()
+    change: Matrix = ((0, -1), (1, 0))
+    for seed in range(20):
+        inst = make_instance(seed=1000 + seed,
+                             **DIFFICULTY[SHIPPING_DIFFICULTY])
+        original_key = canonical_key(inst)
+        distinct_keys.add(original_key)
+        order = list(range(inst["n"]))
+        random.Random(9000 + seed).shuffle(order)
+        permuted = _permute_instance(inst, order)
+        conjugated = _conjugate_instance(inst, change)
+        composed = _conjugate_instance(permuted, change)
+        for transformed in (permuted, conjugated, composed):
+            invariant_checks += int(canonical_key(transformed) == original_key)
+            witness_checks += int(verify(transformed,
+                                         transformed["answer"])[0])
+    report["G8_canonical_key"] = {
+        "pass": invariant_checks == 60 and witness_checks == 60
+        and len(distinct_keys) == 20,
+        "invariance_passes": invariant_checks,
+        "invariance_attempts": 60,
+        "carried_witness_passes": witness_checks,
+        "carried_witness_attempts": 60,
+        "distinct_unrelated_keys": len(distinct_keys),
+        "distinctness_attempts": 20,
+        "transformations": [
+            "generator permutation",
+            "simultaneous SL(2,Z) conjugation",
+            "permutation composed with conjugation",
+        ],
+    }
+
+    answer_blob = json.dumps(shipping["answer"])
+    answer_chars = len(answer_blob)
+    answer_tokens = len(re.findall(r"\d+|\[|\]|,|-", answer_blob))
+    answer_elements = _answer_atoms(shipping["answer"])
+    intended_operations = 6 * (shipping["n"] + 1) + shipping["length"]
+    arms = {name: dict(value) for name, value in G9_EVIDENCE.items()
+            if name in ("bare", "hinted", "placebo")}
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = (hinted["solved"] / hinted["attempts"]
+                   if hinted["attempts"] else 0.0)
+    placebo_rate = (placebo["solved"] / placebo["attempts"]
+                    if placebo["attempts"] else 0.0)
+    hinted_hardened = (G9_EVIDENCE["hinted_verdict"] == "hardened"
+                       and hinted["attempts"] >= 3)
+    within_caps = (answer_chars <= 2000 and answer_elements <= 256
+                   and intended_operations <= 300)
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_hardened and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_EVIDENCE["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = DIFFICULTY[SHIPPING_DIFFICULTY]
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
