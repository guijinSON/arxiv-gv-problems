+            rows.append(_make_decoy(base, rng, p, modulus))
+        ordering = list(range(candidates))
+        rng.shuffle(ordering)
+        rows = [rows[i] for i in ordering]
+        planted_index = ordering.index(0)
+        if planted_index == 0:
+            rows[0], rows[1] = rows[1], rows[0]
+            planted_index = 1
