                      rng: random.Random, forbidden: set[int],
                      prime_divisors: tuple[int, ...] = (2, 3)) -> tuple[int, int]:
    known_part = pow(a, steps)
    low = 1 << (k_bits - 1)
    mask = (1 << k_bits) - 1
