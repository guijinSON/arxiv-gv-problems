   461	    return "[" + ",".join(str(x) for x in value) + "]"
   462	
   463	
   464	def render(inst: dict) -> str:
   465	    """Render a complete finite-field equivalence-certificate problem."""
   466	    p = inst["p"]
   467	    m0, m1, m2, _ = inst["modulus"]
   468	    lines = []
   469	    for index, row in enumerate(inst["candidates"]):
   470	        lines.append(f"{index}: " + " ".join(_fmt_fe(value) for value in row))
   471	    statement = f"""Planar-polynomial equivalence certificate over GF({p}^3)
   472	
   473	Let F=GF({p})[T]/(T^3+{m2}T^2+{m1}T+{m0}).  A field element
   474	a0+a1*T+a2*T^2 is written [a0,a1,a2], with every coordinate reduced to
   475	0,...,{p - 1}.  All additions, products, powers, and divisions below are in F.
   476	
   477	Each numbered row contains five field elements c0 c1 c2 c3 c4 and represents
   478	the function
   479	
   480	  f(X)=c0*X^2+c1*X^({p}+1)+c2*X^({p*p}+1)
   481	       +c3*X^(2*{p})+c4*X^(2*{p*p})  on F.
   482	
   483	A function is planar when, for every nonzero a in F, the map
   484	X -> f(X+a)-f(X) is a permutation of F.  Exactly one displayed row has the
   485	following certificate.  Find its 0-based index, a nonzero v in F, and an
   486	integer r in GF({p}) such that r is neither 0 nor 1,
   487	
   488	  omega = 3*r^2-3*r+1  is nonzero modulo {p},
   489	
   490	and, with t=v^({p}-1) and s=t^({p}+1), its coefficients satisfy exactly
   491	
   492	  c1 = 2*c0*(1-r)*t
   493	  c2 = 2*c0*r*s
   494	  c3 = c0*(1-r)*t^2
   495	  c4 = c0*r*s^2.
   496	
   497	These equalities exhibit f(X)=u*g_r(vX), where u=c0/v^2 is nonzero and
   498	
   499	  g_r(X)=X^2+2(1-r)X^({p}+1)+2rX^({p*p}+1)
   500	         +(1-r)X^(2*{p})+rX^(2*{p*p}).
   501	
   502	For completeness, the exact certificate check uses the derivative determinant
   503	factorization 16*(z+y)*(z+x)*omega*(y+x), where
   504	(x,y,z)=(a,a^{p},a^{p*p}); after removing nonzero scalar factors, the three
   505	two-term q-linearized factors have nonzero Dickson determinants 2, 2, and
   506	2*omega^3 modulo {p}.
   507	
   508	Rows (c0 c1 c2 c3 c4):
   509	{chr(10).join(lines)}
   510	
   511	Give your final answer inside <answer></answer> tags as one JSON object with
   512	exactly the keys index, v, and r.  The field element v must be its three
   513	coordinate integers.  Example syntax:
   514	<answer>{{"index":3,"v":[1,2,4],"r":2}}</answer>
   515	Output nothing else inside the tags.
   516	"""
   517	    mode = os.environ.get("GV_HINT_MODE")
   518	    if mode == "structural":
   519	        statement += "\nHint: " + STRUCTURAL_HINT + "\n"
   520	    elif mode == "placebo":
   521	        statement += "\nHint: " + PLACEBO_HINT + "\n"
   522	    return statement
   523	
   524	
   525	def parse_answer(text: str) -> object | None:
   526	    """Parse the final tagged JSON certificate, tolerating surrounding prose."""
   527	    if not isinstance(text, str):
   528	        return None
   529	    matches = _ANSWER_RE.findall(text)
   530	    if not matches:
   531	        return None
   532	    payload = matches[-1].strip()
   533	    if payload.startswith("```"):
   534	        payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
   535	        payload = re.sub(r"\s*```$", "", payload)
   536	    try:
   537	        answer = json.loads(payload)
   538	    except (TypeError, ValueError, json.JSONDecodeError):
   539	        return None
   540	    if not isinstance(answer, dict):
   541	        return None
   542	    return answer
   543	
   544	
   545	def _base_factor_identity(r: int, p: int) -> bool:
   546	    """Execute the coefficient identity used in Theorem 3.3's proof."""
   547	    e, d = 1, r % p
   548	    a, b, c = 2 * (e - d), 2 * d, e - d
   549	    cube = (-2 * a * a * d + 2 * a * b * e - 2 * b * b * c) % p
   550	    beta = (2 * a * a * c - 2 * a * b * d - 4 * a * c * d
   551	            + 4 * a * e * e + 2 * b * b * e - 4 * b * c * e
   552	            + 4 * b * d * d) % p
   553	    gamma = (2 * a * a * e - 2 * a * b * c + 4 * a * c * c
   554	             - 4 * a * d * e + 2 * b * b * d - 4 * b * c * d
   555	             + 4 * b * e * e) % p
   556	    mixed = (2 * a ** 3 + 2 * b ** 3 + 8 * c ** 3
   557	             - 24 * c * d * e + 8 * d ** 3 + 8 * e ** 3) % p
   558	    omega = (3 * r * r - 3 * r + 1) % p
   559	    factor_determinants = (2 % p, 2 % p, 2 * pow(omega, 3, p) % p)
   560	    return (cube == 0 and beta == 16 * omega % p
   561	            and gamma == 16 * omega % p and mixed == 32 * omega % p
   562	            and all(factor_determinants))
   563	
   564	
   565	def verify(inst: dict, answer: object) -> tuple[bool, str]:
   566	    """Check any valid equivalence witness without consulting inst['answer']."""
   567	    if not isinstance(answer, dict) or not answer:
   568	        return False, "answer must be a nonempty JSON object"
   569	    if set(answer) != {"index", "v", "r"}:
   570	        return False, "answer must contain exactly the keys index, v, and r"
   571	    p = inst["p"]
   572	    modulus = tuple(inst["modulus"][:3])
   573	    index = answer["index"]
   574	    if isinstance(index, bool) or not isinstance(index, int):
   575	        return False, "index must be an integer"
   576	    if not 0 <= index < len(inst["candidates"]):
   577	        return False, "index is outside the displayed row range"
   578	    if not isinstance(answer["v"], (list, tuple)):
   579	        return False, "v must be a coordinate list"
   580	    if len(answer["v"]) < 3:
   581	        return False, "v is missing a coordinate"
   582	    if len(answer["v"]) > 3:
   583	        return False, "v has a duplicate or extra coordinate"
   584	    v = _fe(answer["v"], p)
   585	    if v is None:
   586	        return False, "v coordinates must be integers in the base-field range"
   587	    if v == _zero():
   588	        return False, "v must be nonzero"
   589	    r = answer["r"]
   590	    if isinstance(r, bool) or not isinstance(r, int) or not 0 <= r < p:
   591	        return False, "r must be a base-field integer in range"
   592	    if r in (0, 1):
   593	        return False, "r must be distinct from 0 and 1"
   594	    omega = (3 * r * r - 3 * r + 1) % p
   595	    if omega == 0:
   596	        return False, "the theorem parameter omega is zero"
   597	    coefficients = [tuple(value) for value in inst["candidates"][index]]
   598	    if _coefficient_invariant_cached(tuple(coefficients), p, modulus) != _zero():
   599	        return False, "selected row fails the multiplicative coefficient invariant"
   600	    t = _pow(v, p - 1, p, modulus)
   601	    s = _pow(t, p + 1, p, modulus)
   602	    c0, c1, c2, c3, c4 = coefficients
   603	    expected = [
   604	        _scale(_mul(c0, t, p, modulus), 2 * (1 - r), p),
   605	        _scale(_mul(c0, s, p, modulus), 2 * r, p),
   606	        _scale(_mul(c0, _mul(t, t, p, modulus), p, modulus),
   607	               1 - r, p),
   608	        _scale(_mul(c0, _mul(s, s, p, modulus), p, modulus), r, p),
   609	    ]
   610	    for offset, (actual, wanted) in enumerate(zip((c1, c2, c3, c4), expected), 1):
   611	        if actual != wanted:
   612	            return False, f"coefficient c{offset} violates its equivalence identity"
   613	    if c0 == _zero():
   614	        return False, "output scaling c0/v^2 must be nonzero"
   615	    if not _base_factor_identity(r, p):
   616	        return False, "Dickson determinant factor certificate failed"
   617	    return True, "ok"
   618	
   619	
   620	def random_candidate(inst: dict, rng: random.Random) -> object:
   621	    """Sample uniformly from all statement-compliant certificate triples."""
   622	    p = inst["p"]
   623	    while True:
   624	        v = [rng.randrange(p), rng.randrange(p), rng.randrange(p)]
   625	        if any(v):
   626	            break
   627	    return {
   628	        "index": rng.randrange(len(inst["candidates"])),
   629	        "v": v,
   630	        "r": rng.choice(_good_r_values(p)),
   631	    }
   632	
   633	
   634	def search_space(inst: dict) -> int:
   635	    p = inst["p"]
   636	    return len(inst["candidates"]) * (p ** 3 - 1) * len(_good_r_values(p))
   637	
   638	
   639	def enumerate_all(inst: dict) -> int | None:
   640	    space = search_space(inst)
   641	    if space > _ENUMERATION_CAP:
   642	        return None
   643	    count = 0
   644	    p = inst["p"]
   645	    for index in range(len(inst["candidates"])):
   646	        for coords in itertools.product(range(p), repeat=3):
   647	            if coords == _zero():
   648	                continue
   649	            for r in _good_r_values(p):
   650	                count += int(verify(inst, {
   651	                    "index": index, "v": list(coords), "r": r,
   652	                })[0])
   653	    return count
   654	
   655	
   656	def _row_scale_invariants(row: list[list[int]], p: int,
   657	                          modulus: MOD) -> list[FE]:
   658	    """Three invariants of arbitrary nonzero input/output scalings."""
   659	    c0, c1, c2, c3, c4 = (tuple(value) for value in row)
   660	    if _zero() in (c0, c1, c2, c3, c4):
   661	        raise ValueError("canonical scaling invariants require nonzero coefficients")
   662	    first = _div(_mul(c1, c1, p, modulus),
   663	                 _mul(c0, c3, p, modulus), p, modulus)
   664	    second = _div(_mul(c2, c2, p, modulus),
   665	                  _mul(c0, c4, p, modulus), p, modulus)
   666	    third = _div(_mul(_frob(c0, p, modulus), c2, p, modulus),
   667	                 _mul(_frob(c1, p, modulus), c1, p, modulus), p, modulus)
   668	    return [first, second, third]
   669	
   670	
   671	def _canonical_payload(inst: dict, frobenius_power: int) -> str:
   672	    p = inst["p"]
   673	    modulus = tuple(inst["modulus"][:3])
   674	    rows = []
   675	    for row in inst["candidates"]:
   676	        invariants = _row_scale_invariants(row, p, modulus)
   677	        rows.append([list(_frob(value, p, modulus, frobenius_power))
   678	                     for value in invariants])
   679	    rows.sort(key=lambda row: json.dumps(row, separators=(",", ":")))
   680	    return json.dumps({
   681	        "p": p,
   682	        "modulus": inst["modulus"],
   683	        "rows": rows,
   684	        "certificate": "multiplicative-Theorem-3.3-equivalence",
   685	    }, sort_keys=True, separators=(",", ":"))
   686	
   687	
   688	def canonical_key(inst: dict) -> str:
   689	    """Quotient row order, Frobenius, and global input/output scalings."""
   690	    payload = min(_canonical_payload(inst, power) for power in range(3))
   691	    return hashlib.sha256(payload.encode("ascii")).hexdigest()
   692	
   693	
   694	def _pow_multiplication_count(exponent: int) -> int:
   695	    """Exact _mul calls made by the binary powering routine."""
   696	    return exponent.bit_length() + exponent.bit_count()
   697	
   698	
   699	def _compact_route_operation_bound(p: int, candidates: int) -> int:
   700	    """Field-operation bound for full invariant scan plus planted recovery."""
   701	    inverse = _pow_multiplication_count(p ** 3 - 2)
   702	    norm = _pow_multiplication_count(p * p + p + 1)
   703	    frobenius = _pow_multiplication_count(p)
   704	    # Nine operations per cubic invariant.  Recovery uses four inversions,
   705	    # one norm power, four Frobenius powers, and twelve remaining operations.
   706	    return 9 * candidates + 4 * inverse + norm + 4 * frobenius + 12
   707	
   708	
   709	def escalate(params: dict) -> dict | str | None:
   710	    """Increase the field/haystack while the five-atom witness stays fixed."""
   711	    harder = dict(params)
   712	    current = int(harder.get("n", 101))
   713	    harder["n"] = _next_odd_prime(max(current + 2, (3 * current) // 2))
   714	    harder["candidates"] = int(harder.get("candidates", 6))
   715	    if _compact_route_operation_bound(
   716	            int(harder["n"]), int(harder["candidates"])) > 300:
   717	        return "cap_bound"
   718	    return harder
