+def _find_irreducible_cubic(p: int) -> MOD:
+    """Return m0,m1,m2 for a monic cubic with no root in GF(p)."""
+    for m2 in range(min(p, 5)):
+        for m1 in range(1, p):
+            for m0 in range(1, p):
+                if all((x * x * x + m2 * x * x + m1 * x + m0) % p
+                       for x in range(p)):
+                    return (m0, m1, m2)
