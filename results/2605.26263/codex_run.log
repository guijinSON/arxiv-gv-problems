+        "greedy_first_candidate": {"successes": 0, "attempts": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0},
+        "base_field_twist_ansatz": {"successes": 0, "attempts": 0},
+    }
+    for seed in attack_seeds:
