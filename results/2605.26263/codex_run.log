+    modulus = tuple(inst["modulus"][:3])
+    moved["candidates"] = [
+        [list(_frob(tuple(value), p, modulus, power)) for value in row]
+        for row in inst["candidates"]
+    ]
+    moved["answer"]["v"] = list(_frob(tuple(inst["answer"]["v"]),
+                                            p, modulus, power))
+    return moved
