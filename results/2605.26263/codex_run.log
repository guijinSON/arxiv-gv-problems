+        _scale(_mul(lam, s, p, modulus), 2 * r, p),
+        _scale(_mul(lam, _mul(t, t, p, modulus), p, modulus),
+               one_minus_r, p),
+        _scale(_mul(lam, _mul(s, s, p, modulus), p, modulus), r, p),
+    ]
+    return coefficients, v, r
