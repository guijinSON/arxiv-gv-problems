+def _mul(a: FE, b: FE, p: int, modulus: MOD) -> FE:
+    values = [0] * 5
+    for i in range(3):
+        for j in range(3):
+            values[i + j] = (values[i + j] + a[i] * b[j]) % p
+    for degree in (4, 3):
+        coefficient = values[degree] % p
+        if coefficient:
+            for j in range(3):
+                values[degree - 3 + j] = (
