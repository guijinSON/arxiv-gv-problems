+
+def _derivative_value(coefficients: list[FE], a: FE, h: FE,
+                      p: int, modulus: MOD) -> FE:
+    result = _zero()
+    for coefficient, term in zip(
+            coefficients, _derivative_terms(a, h, p, modulus)):
+        result = _add(result, _mul(coefficient, term, p, modulus), p)
+    return result
