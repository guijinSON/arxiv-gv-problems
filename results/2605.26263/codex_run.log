+        output_scale = _rand_fe(relabel_rng, trial["p"], nonzero=True)
+        input_scale = _rand_fe(relabel_rng, trial["p"], nonzero=True)
+        scaled = _multiplicative_instance(trial, output_scale, input_scale)
