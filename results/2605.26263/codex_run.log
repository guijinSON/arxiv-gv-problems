import gen_2605_26263 as g, random
for p in (5,7,11):
 m=g._find_irreducible_cubic(p); rng=random.Random(p)
 for r in g._good_r_values(p):
  # base coefficients E=1,D=r
  co=[g._base(1,p),g._base(2*(1-r),p),g._base(2*r,p),g._base(1-r,p),g._base(r,p)]
  row=[list(x) for x in co]; mats=g._derivative_basis_matrices(row,p,m)
  w=(3*r*r-3*r+1)%p
  for _ in range(10):
   a=g._rand_fe(rng,p,True); coords=a
   mat=[[sum(coords[k]*mats[k][i][j] for k in range(3))%p for j in range(3)] for i in range(3)]
   det=g._det3(mat,p)
   y=g._frob(a,p,m); z=g._frob(y,p,m)
   rhs=g._scale(g._mul(g._mul(g._add(z,y,p),g._add(z,a,p),p,m),g._add(y,a,p),p,m),16*w,p)
   assert rhs[1:]==(0,0) and rhs[0]==det,(p,r,a,det,rhs)
print('direct derivative determinant/factorization checks: ok')
