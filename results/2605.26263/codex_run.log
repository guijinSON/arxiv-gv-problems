+            attack_results[name]["successes"] += int(success)
+            attack_results[name]["attempts"] += 1
+    all_failed = all(row["successes"] == 0 and row["attempts"] >= 8
+                     for row in attack_results.values())
+    report["G6_adversary_panel"] = {
