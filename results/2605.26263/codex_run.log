    r_fe = _div(_mul(c2, c2, p, modulus),
                _scale(_mul(c0, c4, p, modulus), 4, p), p, modulus)
    if r_fe[1:] != (0, 0):
        return None
    r = r_fe[0]
    if r not in _good_r_values(p):
