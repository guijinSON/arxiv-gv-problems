+    "demo": {"n": 5, "candidates": 4},
+    "easy": {"n": 37, "candidates": 24},
+    "medium": {"n": 67, "candidates": 24},
+    "hard": {"n": 101, "candidates": 24},
+}
+SHIPPING_DIFFICULTY: str = "hard"
