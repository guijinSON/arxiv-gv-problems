+def _hilbert90_solution(t: FE, p: int, modulus: MOD) -> FE | None:
+    """Solve v^p=t*v with the three-term cyclic Hilbert-90 projector."""
+    if t == _zero() or _pow(t, p * p + p + 1, p, modulus) != _one():
+        return None
+    tinv = _inv(t, p, modulus)
+    tp = _frob(t, p, modulus)
+    ttp_inv = _inv(_mul(t, tp, p, modulus), p, modulus)
+    basis = ((1, 0, 0), (0, 1, 0), (0, 0, 1))
+    for w in basis:
+        wp = _frob(w, p, modulus)
+        wpp = _frob(wp, p, modulus)
+        v = _add(w, _add(_mul(tinv, wp, p, modulus),
+                         _mul(ttp_inv, wpp, p, modulus), p), p)
+        if v != _zero() and _frob(v, p, modulus) == _mul(t, v, p, modulus):
+            return v
+    return None
