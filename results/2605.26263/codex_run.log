+def _reference_algorithm(inst: dict) -> dict:
+    """Literal Proposition 2.2 derivative/Dickson enumeration."""
+    p = inst["p"]
+    modulus = tuple(inst["modulus"][:3])
+    counter = {
+        "derivative_basis_builds": 0,
+        "directions_tested": 0,
+        "scalar_operations": 0,
