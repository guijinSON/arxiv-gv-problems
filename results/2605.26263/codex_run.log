+        _scale(_mul(c0, s, p, modulus), 2 * r, p),
+        _scale(_mul(c0, _mul(t, t, p, modulus), p, modulus),
+               1 - r, p),
+        _scale(_mul(c0, _mul(s, s, p, modulus), p, modulus), r, p),
