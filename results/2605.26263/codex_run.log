def canonical_key(inst: dict) -> str:
    """Quotient row order, Frobenius, and global input/output scalings."""
    payload = min(_canonical_payload(inst, power) for power in range(3))
    return hashlib.sha256(payload.encode("ascii")).hexdigest()


def escalate(params: dict) -> dict | str | None:
    """Increase the field/haystack while the five-atom witness stays fixed."""
    harder = dict(params)
    current = int(harder.get("n", 101))
    harder["n"] = _next_odd_prime(max(current + 2, (3 * current) // 2))
    # One extra decoy grows the haystack without changing the five-atom answer;
    # 25 rows is the largest compact scan that stays under G9(c)'s 300-op cap.
    harder["candidates"] = min(25, int(harder.get("candidates", 24)) + 1)
    return harder


def _hilbert90_solution(t: FE, p: int, modulus: MOD) -> FE | None:
    """Solve v^p=t*v with the three-term cyclic Hilbert-90 projector."""
    if t == _zero() or _pow(t, p * p + p + 1, p, modulus) != _one():
        return None
    tinv = _inv(t, p, modulus)
    tp = _frob(t, p, modulus)
    ttp_inv = _inv(_mul(t, tp, p, modulus), p, modulus)

