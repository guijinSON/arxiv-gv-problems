+def escalate(params: dict) -> dict | str | None:
+    """Increase the field/haystack while the five-atom witness stays fixed."""
+    harder = dict(params)
+    current = int(harder.get("n", 101))
+    if current >= 4093:
+        return None
+    harder["n"] = _next_odd_prime(max(current + 2, (3 * current) // 2))
+    # One extra decoy grows the haystack without changing the five-atom answer;
+    # 25 rows is the largest compact scan that stays under G9(c)'s 300-op cap.
+    harder["candidates"] = min(25, int(harder.get("candidates", 24)) + 1)
+    return harder
