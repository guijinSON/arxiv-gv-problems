+        "swap_one": swapped_answer,
+        "duplicate_one": {**answer, "v": answer["v"] + [answer["v"][-1]]},
+        "empty": {},
+        "out_of_range": {**answer, "index": len(inst["candidates"])},
+    }
+    rejections = {}
+    for name, bad in corruptions.items():
+        ok, reason = verify(inst, bad)
