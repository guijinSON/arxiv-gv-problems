+
+def _base(value: int, p: int) -> FE:
+    return (value % p, 0, 0)
+
+
+def _add(a: FE, b: FE, p: int) -> FE:
+    return ((a[0] + b[0]) % p, (a[1] + b[1]) % p,
+            (a[2] + b[2]) % p)
+
+
+def _sub(a: FE, b: FE, p: int) -> FE:
+    return ((a[0] - b[0]) % p, (a[1] - b[1]) % p,
+            (a[2] - b[2]) % p)
