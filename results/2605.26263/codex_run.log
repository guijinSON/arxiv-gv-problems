-@functools.lru_cache(maxsize=4096)
-def _coefficient_invariant_cached(coefficients: tuple[FE, ...], p: int,
-                                  modulus: MOD) -> FE:
-    return _coefficient_invariant(list(coefficients), p, modulus)
