+        _scale(_mul(a, h, p, modulus), 2, p),
+        _add(_mul(a, hq, p, modulus), _mul(aq, h, p, modulus), p),
+        _add(_mul(a, hqq, p, modulus), _mul(aqq, h, p, modulus), p),
+        _scale(_mul(aq, hq, p, modulus), 2, p),
+        _scale(_mul(aqq, hqq, p, modulus), 2, p),
