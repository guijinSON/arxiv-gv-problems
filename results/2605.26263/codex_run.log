import gen_2605_26263 as g
from itertools import product
for p in (5,7,11):
    mod=g._find_irreducible_cubic(p)
    for r in g._good_r_values(p):
        assert g._base_factor_identity(r,p)
        # exhaustive base derivative kernel test at small p: every a "'!= 0, only h=0 maps to 0
        coeff=[g._one(),g._base(2*(1-r),p),g._base(2*r,p),g._base(1-r,p),g._base(r,p)]
        vals=[x for x in product(range(p),repeat=3) if x!=(0,0,0)]
        if p <= 7:
            for a in vals:
                for h in vals:
                    if g._derivative_value(coeff,a,h,p,mod)==g._zero():
                        raise AssertionError((p,r,a,h))
    print('"'base exhaustive ok',p,'r_count',len(g._good_r_values(p)))
for seed in range(20):
    inst=g.make_instance(5,seed,candidates=4)
    p=inst['p']; mod=tuple(inst['modulus'][:3]); idx=inst['answer']['index']
    assert g.verify(inst,inst['answer'])==(True,'ok')
    # brute identify planar rows via all projective derivative directions
    ref=g._reference_algorithm(inst)
    assert ref['planar_indices']==[idx], (seed,idx,ref['planar_indices'])
print('20 complete GF(5) instances independently enumerated')
# test per-row independent scaling symmetry, which canonical_key already purports to quotient
for seed in range(5):
    inst=g.make_instance(11,seed,candidates=4)
    p=inst['p']; mod=tuple(inst['modulus'][:3]); old=g.canonical_key(inst)
    import copy,random
    moved=copy.deepcopy(inst); rr=random.Random(seed+99)
    for i,row in enumerate(moved['candidates']):
        out=g._rand_fe(rr,p,True); inp=g._rand_fe(rr,p,True)
        exps=(2,p+1,p*p+1,2*p,2*p*p)
        factors=[g._mul(out,g._pow(inp,e,p,mod),p,mod) for e in exps]
        moved['candidates'][i]=[list(g._mul(tuple(x),f,p,mod)) for x,f in zip(row,factors)]
        if i==moved['answer']['index']:
            moved['answer']['v']=list(g._mul(tuple(moved['answer']['v']),inp,p,mod))
    assert g.verify(moved,moved['answer'])[0]
    assert g.canonical_key(moved)==old
print('per-row scaling canonical symmetry ok')
