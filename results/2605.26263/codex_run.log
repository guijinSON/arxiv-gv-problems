+
+def _fe(value: object, p: int) -> FE | None:
+    if not isinstance(value, (list, tuple)) or len(value) != 3:
+        return None
+    if any(isinstance(x, bool) or not isinstance(x, int) or not 0 <= x < p
+           for x in value):
+        return None
+    return (int(value[0]), int(value[1]), int(value[2]))
