+# All n are powers of two and divide prime-1.  The listed generator is a
+# primitive root of the full multiplicative group; selftest checks what the
+# construction actually needs, namely that omega has exact order n.
+DIFFICULTY = {
+    "demo": {"n": 2, "prime": 17, "generator": 3},
+    "easy": {"n": 8, "prime": 65537, "generator": 3},
+    "medium": {"n": 16, "prime": 998244353, "generator": 3},
+    "hard": {"n": 32, "prime": 2013265921, "generator": 31},
+}
+SHIPPING_DIFFICULTY = "medium"
+
+STRUCTURAL_HINT = (
+    "The coefficient rows form a radix-2 finite-field Fourier transform, so "
+    "invert them with the supplied inverse twiddles instead of eliminating variables."
+)
+PLACEBO_HINT = (
+    "The coefficient rows should be handled systematically, and the supplied "
+    "modular constants should be copied carefully throughout the calculation."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An ordered JSON list of exactly n canonical residues in GF(p), one for "
+        "each 0-indexed variable; every entry is an integer in the inclusive "
+        "range 0 through p-1, repetitions are allowed."
+    ),
+    "bounds": {
+        "elements": "n",
+        "minimum": 0,
+        "maximum": "p-1",
+        "ordered": True,
+        "repetitions": True,
+    },
+}
+
+NOTES = (
+    "Section 2 fixes the native MP problem as solving polynomial equations over "
+    "GF(q), assumes at most one solution, and states that a one-solution reduced "
+    "Groebner basis is linear. Algorithm 2.1 (GBElimLin) is the easy-case "
+    "discriminator: for this linear family it is ordinary exact row reduction, "
+    "so the family is Track B, never Track A. Section 3 says the all-wild d1=0 "
+    "case is brute-force enumeration and the hybrid cost is q^k tau; those are "
+    "not used as false hardness evidence. The system is generated by sampling "
+    "its unique assignment and composing a finite-field Fourier transform. "
+    "Random witnesses and shuffled equation order remove positional planting "
+    "signatures. The adversary panel tests an RHS outlier rule, diagonal greedy "
+    "substitution, a one-term inverse ansatz, and 256 structure-aware random "
+    "restarts; the successful O(n^3) row-reduction algorithm is reported "
+    "separately as Track B requires."
+)
+
+# Filled from the three independent harden.py runs before release.  Keeping this
+# as data makes selftest's G9 report machine-readable without touching transcripts.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
+    "hinted_verdict": "pending",
+}
