@@ -0,0 +1,801 @@
+"""Verified generator for finite-field polynomial systems from arXiv:2506.09950.
+
+The generated systems are invertible finite-field Fourier systems.  A witness is
+sampled first and the right-hand sides are obtained by exact evaluation, so the
+generator never solves an instance it has just made.  The checker independently
+substitutes any submitted vector into every displayed polynomial equation.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import functools
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "linear polynomial system over a prime finite field",
+        "finite-field Fourier coefficient matrix",
+        "assignment in GF(p)^n",
+    ],
+    "verification_operations": [
+        "exact modular exponentiation",
+        "exact finite-field multiplication and addition",
+        "substitution into every polynomial equation",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Recognize the power matrix as a finite-field Fourier transform and apply "
+        "a radix-2 inverse transform; otherwise carry out dense elimination."
+    ),
+    "hardness_basis": (
+        "Track B: Section 2's GBElimLin specializes here to exact Gaussian "
+        "elimination in O(n^3) field operations; at the hard shipping preset the "
+        "included reference implementation performs 65,568 counted field "
+        "operations (wall-clock refreshed by selftest), while the supplied-twiddle "
+        "inverse FFT takes 272 exact field operations."
+    ),
+    "max_answer_tokens": 96,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+# All n are powers of two and divide prime-1.  The listed generator is a
+# primitive root of the full multiplicative group; selftest checks what the
+# construction actually needs, namely that omega has exact order n.
+DIFFICULTY = {
+    "demo": {"n": 2, "prime": 17, "generator": 3},
+    "easy": {"n": 8, "prime": 65537, "generator": 3},
+    "medium": {"n": 16, "prime": 998244353, "generator": 3},
+    "hard": {"n": 32, "prime": 2013265921, "generator": 31},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The coefficient rows form a radix-2 finite-field Fourier transform, so "
+    "invert them with the supplied inverse twiddles instead of eliminating variables."
+)
+PLACEBO_HINT = (
+    "The coefficient rows should be handled systematically, and the supplied "
+    "modular constants should be copied carefully throughout the calculation."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An ordered JSON list of exactly n canonical residues in GF(p), one for "
+        "each 0-indexed variable; every entry is an integer in the inclusive "
+        "range 0 through p-1, repetitions are allowed."
+    ),
+    "bounds": {
+        "elements": "n",
+        "minimum": 0,
+        "maximum": "p-1",
+        "ordered": True,
+        "repetitions": True,
+    },
+}
+
+NOTES = (
+    "Section 2 fixes the native MP problem as solving polynomial equations over "
+    "GF(q), assumes at most one solution, and states that a one-solution reduced "
+    "Groebner basis is linear. Algorithm 2.1 (GBElimLin) is the easy-case "
+    "discriminator: for this linear family it is ordinary exact row reduction, "
+    "so the family is Track B, never Track A. Section 3 says the all-wild d1=0 "
+    "case is brute-force enumeration and the hybrid cost is q^k tau; those are "
+    "not used as false hardness evidence. The system is generated by sampling "
+    "its unique assignment and composing a finite-field Fourier transform. "
+    "Random witnesses and shuffled equation order remove positional planting "
+    "signatures. The adversary panel tests an RHS outlier rule, diagonal greedy "
+    "substitution, a one-term inverse ansatz, and 256 structure-aware random "
+    "restarts; the successful O(n^3) row-reduction algorithm is reported "
+    "separately as Track B requires."
+)
+
+# Filled from the three independent harden.py runs before release.  Keeping this
+# as data makes selftest's G9 report machine-readable without touching transcripts.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
+    "hinted_verdict": "pending",
+}
+
+
+@functools.lru_cache(maxsize=None)
+def _is_prime(value):
+    if not isinstance(value, int) or isinstance(value, bool) or value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+@functools.lru_cache(maxsize=None)
+def _valid_parameters(n, prime, generator):
+    if not all(isinstance(v, int) and not isinstance(v, bool) for v in (n, prime, generator)):
+        return False
+    if n < 2 or n & (n - 1):
+        return False
+    if not _is_prime(prime) or (prime - 1) % n:
+        return False
+    if not 1 < generator < prime:
+        return False
+    omega = pow(generator, (prime - 1) // n, prime)
+    return pow(omega, n, prime) == 1 and pow(omega, n // 2, prime) != 1
+
+
+def _dft(values, omega, prime):
+    """Direct exact transform, used for construction and independent checking."""
+    n = len(values)
+    powers = [pow(omega, exponent, prime) for exponent in range(n)]
+    return [
+        sum(values[j] * powers[(j * frequency) % n] for j in range(n)) % prime
+        for frequency in range(n)
+    ]
+
+
+def _fft(values, omega, prime, counter=None):
+    """Radix-2 transform used only by the compact/reference diagnostics."""
+    n = len(values)
+    if n == 1:
+        return list(values)
+    even = _fft(values[0::2], pow(omega, 2, prime), prime, counter)
+    odd = _fft(values[1::2], pow(omega, 2, prime), prime, counter)
+    out = [0] * n
+    twiddle = 1
+    for k in range(n // 2):
+        product = twiddle * odd[k] % prime
+        out[k] = (even[k] + product) % prime
+        out[k + n // 2] = (even[k] - product) % prime
+        if counter is not None:
+            counter["field_operations"] += 3
+        twiddle = twiddle * omega % prime
+    return out
+
+
+def _inverse_fft(rhs, omega_inverse, n_inverse, prime, counter=None):
+    out = _fft(rhs, omega_inverse, prime, counter)
+    scaled = []
+    for value in out:
+        scaled.append(value * n_inverse % prime)
+        if counter is not None:
+            counter["field_operations"] += 1
+    return scaled
+
+
+def _sorted_rhs(inst):
+    equations = inst.get("equations")
+    n = inst.get("n")
+    prime = inst.get("prime")
+    if not isinstance(equations, list) or not isinstance(n, int) or not isinstance(prime, int):
+        return None
+    if len(equations) != n:
+        return None
+    ordered = [None] * n
+    for equation in equations:
+        if not isinstance(equation, dict) or set(equation) != {"frequency", "rhs"}:
+            return None
+        frequency = equation["frequency"]
+        rhs = equation["rhs"]
+        if (
+            not isinstance(frequency, int)
+            or isinstance(frequency, bool)
+            or not 0 <= frequency < n
+            or ordered[frequency] is not None
+            or not isinstance(rhs, int)
+            or isinstance(rhs, bool)
+            or not 0 <= rhs < prime
+        ):
+            return None
+        ordered[frequency] = rhs
+    return ordered if all(value is not None for value in ordered) else None
+
+
+def _decode_instance(inst):
+    if not isinstance(inst, dict):
+        return None
+    n = inst.get("n")
+    prime = inst.get("prime")
+    generator = inst.get("generator")
+    omega = inst.get("omega")
+    omega_inverse = inst.get("omega_inverse")
+    n_inverse = inst.get("n_inverse")
+    twiddles = inst.get("inverse_twiddles")
+    if not _valid_parameters(n, prime, generator):
+        return None
+    expected_omega = pow(generator, (prime - 1) // n, prime)
+    if omega != expected_omega or omega_inverse != pow(omega, prime - 2, prime):
+        return None
+    if n_inverse != pow(n, prime - 2, prime):
+        return None
+    expected_twiddles = [pow(omega_inverse, exponent, prime) for exponent in range(n // 2)]
+    if twiddles != expected_twiddles:
+        return None
+    rhs = _sorted_rhs(inst)
+    if rhs is None:
+        return None
+    return n, prime, generator, omega, omega_inverse, n_inverse, rhs
+
+
+def make_instance(n, seed=0, prime=None, generator=None, **params):
+    """Inverse-generate a unique finite-field polynomial system.
+
+    The witness x is sampled first and y=DFT(x) is then evaluated exactly.  No
+    solving, search, global RNG, file access, or external dependency is involved.
+    """
+    if prime is None or generator is None or params:
+        raise ValueError("n, prime, and generator are the only supported parameters")
+    if not _valid_parameters(n, prime, generator):
+        raise ValueError("need power-of-two n dividing prime-1 and an adequate generator")
+    if not isinstance(seed, int) or isinstance(seed, bool):
+        raise ValueError("seed must be an integer")
+    rng = random.Random(seed)
+    answer = [rng.randrange(prime) for _ in range(n)]
+    omega = pow(generator, (prime - 1) // n, prime)
+    omega_inverse = pow(omega, prime - 2, prime)
+    n_inverse = pow(n, prime - 2, prime)
+    rhs = _dft(answer, omega, prime)
+    equations = [
+        {"frequency": frequency, "rhs": rhs[frequency]}
+        for frequency in range(n)
+    ]
+    rng.shuffle(equations)
+    return {
+        "n": n,
+        "prime": prime,
+        "generator": generator,
+        "omega": omega,
+        "omega_inverse": omega_inverse,
+        "n_inverse": n_inverse,
+        "inverse_twiddles": [
+            pow(omega_inverse, exponent, prime) for exponent in range(n // 2)
+        ],
+        "equations": equations,
+        "answer": answer,
+    }
+
+
+def render(inst):
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        raise ValueError("malformed instance")
+    n, prime, generator, omega, omega_inverse, n_inverse, _rhs = decoded
+    equation_lines = "\n".join(
+        f"  {equation['frequency']} {equation['rhs']}" for equation in inst["equations"]
+    )
+    twiddles = " ".join(str(value) for value in inst["inverse_twiddles"])
+    statement = f"""Solve an exact polynomial system over a finite field.
+
+Let GF({prime}) be the field of residues modulo the prime {prime}; reduce every addition and multiplication modulo {prime}. There are exactly n={n} unknown field elements x_0,...,x_{n - 1}. Indices are 0-based, and omega={omega} has exact multiplicative order {n} in this field (it is obtained from generator {generator}).
+
+For every equation row (k,b) below, the required equality is
+
+  sum from j=0 to {n - 1} of omega^(k*j) * x_j = b  (mod {prime}).
+
+Thus these are {n} explicitly defined linear polynomial equations over GF({prime}). The row order below has no significance; k identifies a row. The system is promised to have exactly one solution.
+
+Equation rows, each written as: k b
+{equation_lines}
+
+For exact arithmetic, omega^(-1) mod {prime} is {omega_inverse}, n^(-1) mod {prime} is {n_inverse}, and the supplied list omega^(-r) for r=0,...,{n // 2 - 1} is:
+  {twiddles}
+
+Return the ordered solution [x_0,...,x_{n - 1}] as a JSON list of exactly {n} base-10 integers. Each entry must be the canonical residue in the inclusive range 0 through {prime - 1}; order matters and repeated values are allowed.
+
+Give your final answer inside <answer></answer> tags, as the JSON list just specified.
+Example of the required syntax: <answer>{json.dumps([0] * n, separators=(",", ":"))}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        # Tolerate a common model response that omits the JSON brackets.
+        if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
+            return None
+        try:
+            value = [int(token.strip()) for token in body.split(",")]
+        except ValueError:
+            return None
+    if not isinstance(value, list):
+        return None
+    if any(not isinstance(v, int) or isinstance(v, bool) for v in value):
+        return None
+    return value
+
+
+def verify(inst, answer):
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        return False, "malformed instance"
+    n, prime, _generator, omega, _omega_inverse, _n_inverse, rhs = decoded
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) < n:
+        return False, f"answer has {len(answer)} entries; expected {n}"
+    if len(answer) > n:
+        return False, f"answer has {len(answer)} entries; expected exactly {n}"
+    for index, value in enumerate(answer):
+        if not isinstance(value, int) or isinstance(value, bool):
+            return False, f"entry {index} is not an integer"
+        if not 0 <= value < prime:
+            return False, f"entry {index} is outside 0..{prime - 1}"
+
+    powers = [pow(omega, exponent, prime) for exponent in range(n)]
+    for frequency in range(n):
+        lhs = 0
+        for variable, value in enumerate(answer):
+            lhs = (lhs + powers[(frequency * variable) % n] * value) % prime
+        residual = (lhs - rhs[frequency]) % prime
+        if residual:
+            return False, f"equation {frequency} has nonzero residual {residual}"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    decoded = _decode_instance(inst)
+    if decoded is None or not hasattr(rng, "randrange"):
+        return []
+    n, prime, _generator, _omega, _omega_inverse, _n_inverse, _rhs = decoded
+    return [rng.randrange(prime) for _ in range(n)]
+
+
+def search_space(inst):
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        return None
+    n, prime, _generator, _omega, _omega_inverse, _n_inverse, _rhs = decoded
+    return prime**n
+
+
+def enumerate_all(inst):
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        return None
+    n, prime, _generator, _omega, _omega_inverse, _n_inverse, _rhs = decoded
+    if prime**n > 200_000:
+        return None
+    count = 0
+    for candidate in itertools.product(range(prime), repeat=n):
+        count += int(verify(inst, list(candidate))[0])
+    return count
+
+
+def canonical_key(inst):
+    """Canonicalize equation order and all affine relabellings of Z/nZ."""
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        return "malformed"
+    n, prime, _generator, omega, _omega_inverse, _n_inverse, rhs = decoded
+    omega_powers = [pow(omega, exponent, prime) for exponent in range(n)]
+    best = None
+    # Relabelling input coordinate j as u*j+t, gcd(u,n)=1, sends
+    # y_k to omega^(t*k)*y_(u*k).  Enumerating the full affine group gives a
+    # deterministic normal form and includes rotations, reflections, and all
+    # their compositions.
+    for unit in range(n):
+        if math.gcd(unit, n) != 1:
+            continue
+        base = [rhs[(unit * frequency) % n] for frequency in range(n)]
+        for translation in range(n):
+            candidate = tuple(
+                base[frequency]
+                * omega_powers[(translation * frequency) % n]
+                % prime
+                for frequency in range(n)
+            )
+            if best is None or candidate < best:
+                best = candidate
+    payload = json.dumps([n, prime, omega, best], separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params):
+    # The hard preset is already the largest whose inverse-transform route is
+    # within G9's 300-operation cap.  Larger instances still build for G7, but
+    # cannot honestly become a shipping level.
+    return None
+
+
+def _coefficient_matrix(n, omega, prime):
+    powers = [pow(omega, exponent, prime) for exponent in range(n)]
+    return [
+        [powers[(row * column) % n] for column in range(n)]
+        for row in range(n)
+    ]
+
+
+def _gaussian_reference(inst):
+    """Exact Gauss-Jordan solve, with an auditable field-operation counter."""
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        return None, {"field_operations": 0}
+    n, prime, _generator, omega, _omega_inverse, _n_inverse, rhs = decoded
+    matrix = _coefficient_matrix(n, omega, prime)
+    augmented = [matrix[row] + [rhs[row]] for row in range(n)]
+    operations = 0
+    for column in range(n):
+        pivot = next((row for row in range(column, n) if augmented[row][column]), None)
+        if pivot is None:
+            return None, {"field_operations": operations}
+        augmented[column], augmented[pivot] = augmented[pivot], augmented[column]
+        inverse = pow(augmented[column][column], prime - 2, prime)
+        operations += 1
+        for j in range(column, n + 1):
+            augmented[column][j] = augmented[column][j] * inverse % prime
+            operations += 1
+        for row in range(n):
+            if row == column:
+                continue
+            factor = augmented[row][column]
+            if factor == 0:
+                continue
+            for j in range(column, n + 1):
+                product = factor * augmented[column][j] % prime
+                augmented[row][j] = (augmented[row][j] - product) % prime
+                operations += 2
+    return [augmented[row][n] for row in range(n)], {"field_operations": operations}
+
+
+def _attack_candidates(inst, seed):
+    decoded = _decode_instance(inst)
+    n, prime, _generator, _omega, _omega_inverse, n_inverse, rhs = decoded
+    attacks = {}
+
+    smallest_at = min(range(n), key=lambda index: (rhs[index], index))
+    attacks["outlier_smallest_rhs_rotation"] = [
+        rhs[(index + smallest_at) % n] for index in range(n)
+    ]
+
+    matrix = _coefficient_matrix(n, inst["omega"], prime)
+    attacks["greedy_diagonal_only"] = [
+        rhs[index] * pow(matrix[index][index], prime - 2, prime) % prime
+        for index in range(n)
+    ]
+
+    # An attractive but false hand shortcut: reverse the frequency list and
+    # scale, omitting the dense inverse-transform sums.
+    attacks["by_hand_reverse_and_scale"] = [
+        rhs[(-index) % n] * n_inverse % prime for index in range(n)
+    ]
+
+    rng = random.Random(seed ^ 0x250609950)
+    attacks["random_restart_256_field_vectors"] = [
+        [rng.randrange(prime) for _ in range(n)] for _ in range(256)
+    ]
+    return attacks
+
+
+def _affine_relabel(inst, unit, translation, shuffle_seed):
+    """Carry an instance and its witness through j -> unit*j+translation."""
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        raise ValueError("malformed instance")
+    n, prime, _generator, omega, _omega_inverse, _n_inverse, rhs = decoded
+    if math.gcd(unit, n) != 1 or not 0 <= translation < n:
+        raise ValueError("not an affine coordinate relabelling")
+    answer = [0] * n
+    for old_index, value in enumerate(inst["answer"]):
+        answer[(unit * old_index + translation) % n] = value
+    omega_powers = [pow(omega, exponent, prime) for exponent in range(n)]
+    transformed_rhs = [
+        omega_powers[(translation * frequency) % n]
+        * rhs[(unit * frequency) % n]
+        % prime
+        for frequency in range(n)
+    ]
+    out = dict(inst)
+    out["answer"] = answer
+    out["equations"] = [
+        {"frequency": frequency, "rhs": transformed_rhs[frequency]}
+        for frequency in range(n)
+    ]
+    random.Random(shuffle_seed).shuffle(out["equations"])
+    return out
+
+
+def _intended_route_operations(n):
+    return 3 * (n // 2) * (n.bit_length() - 1) + n
+
+
+def selftest():
+    report = {}
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+
+    failures = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                failures.append([preset, seed, why])
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append([preset, seed, "answer is not JSON-native"])
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "attempts": attempts,
+        "failures": failures,
+    }
+
+    inst = make_instance(seed=19, **shipping)
+    answer = inst["answer"]
+    swap_at = next(index for index in range(1, len(answer)) if answer[index] != answer[0])
+    swapped = list(answer)
+    swapped[0], swapped[swap_at] = swapped[swap_at], swapped[0]
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": swapped,
+        "duplicate": answer[:1] + answer,
+        "empty": [],
+        "out_of_range": [inst["prime"]] + answer[1:],
+    }
+    rejected = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        rejected[name] = {"rejected": not ok, "reason": why}
+    reasons = [entry["reason"] for entry in rejected.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(entry["rejected"] for entry in rejected.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": rejected,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    model_response = (
+        "The inverse transform gives the following residues.\n```json\n<answer>"
+        + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```\nThose entries are in x-index order."
+    )
+    parsed = parse_answer(model_response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_equals_answer": parsed == answer,
+    }
+
+    guess_rng = random.Random(0x250609950)
+    guess_total = 200_000
+    guess_hits = 0
+    start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
+    guess_seconds = time.perf_counter() - start
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_fraction,
+        "candidate_space_bits": search_space(inst).bit_length(),
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    attack_names = [
+        "outlier_smallest_rhs_rotation",
+        "greedy_diagonal_only",
+        "by_hand_reverse_and_scale",
+        "random_restart_256_field_vectors",
+    ]
+    successes = {name: 0 for name in attack_names}
+    attack_seconds = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    reference_seconds = 0.0
+    reference_operations = []
+    compact_successes = 0
+    compact_operations = []
+    for seed in range(101, 109):
+        trial = make_instance(seed=seed, **shipping)
+        candidates = _attack_candidates(trial, seed)
+        for name in attack_names:
+            candidates_for_attack = candidates[name]
+            if name != "random_restart_256_field_vectors":
+                candidates_for_attack = [candidates_for_attack]
+            started = time.perf_counter()
+            won = any(verify(trial, candidate)[0] for candidate in candidates_for_attack)
+            attack_seconds[name] += time.perf_counter() - started
+            successes[name] += int(won)
+
+        started = time.perf_counter()
+        recovered, counts = _gaussian_reference(trial)
+        reference_seconds += time.perf_counter() - started
+        reference_operations.append(counts["field_operations"])
+        reference_successes += int(verify(trial, recovered)[0])
+
+        decoded = _decode_instance(trial)
+        rhs = decoded[-1]
+        counter = {"field_operations": 0}
+        compact = _inverse_fft(
+            rhs,
+            trial["omega_inverse"],
+            trial["n_inverse"],
+            trial["prime"],
+            counter,
+        )
+        compact_successes += int(verify(trial, compact)[0])
+        compact_operations.append(counter["field_operations"])
+
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_seconds[name] / 8, 6),
+        }
+        for name in attack_names
+    }
+    reference = {
+        "name": "exact Gauss-Jordan elimination over GF(p) (GBElimLin linear case)",
+        "complexity": "O(n^3) exact field operations",
+        "wall_clock_sec": round(reference_seconds / 8, 6),
+        "operations": max(reference_operations),
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    all_failed = all(value == 0 for value in successes.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8 and compact_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": reference,
+        "compact_route": {
+            "name": "radix-2 inverse finite-field Fourier transform",
+            "operations": max(compact_operations),
+            "solves": f"{compact_successes}/8",
+        },
+    }
+
+    demo = make_instance(seed=3, **DIFFICULTY["demo"])
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_fraction < 1e-6
+        and all_failed
+        and reference_successes == 8
+        and enumerate_all(demo) == 1,
+        "shipping_sample_hits": guess_hits,
+        "shipping_sample_total": guess_total,
+        "shipping_solution_density": guess_fraction,
+        "shipping_unique_solution_count_by_invertibility": 1,
+        "demo_exact_solution_count": enumerate_all(demo),
+        "baseline_attack_wall_clock_sec": round(
+            attack_seconds["random_restart_256_field_vectors"] / 8, 6
+        ),
+        "baseline_attack_iterations": 256,
+        "reference_wall_clock_sec": reference["wall_clock_sec"],
+        "reference_operation_count": reference["operations"],
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] *= 2
+    started = time.perf_counter()
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_build = time.perf_counter() - started
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    ladder_sizes = [params["n"] for params in DIFFICULTY.values()]
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["n"] == 2 * shipping["n"]
+        and len(render(doubled)) > len(render(inst))
+        and ladder_sizes == sorted(ladder_sizes)
+        and len(set(ladder_sizes)) == len(ladder_sizes),
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_why,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    for seed in range(20):
+        original = make_instance(seed=1000 + seed, **shipping)
+        original_key = canonical_key(original)
+        n = original["n"]
+        unit_a = 3 if math.gcd(3, n) == 1 else 1
+        unit_b = n - 1
+        variants = [
+            _affine_relabel(original, unit_a, (seed + 1) % n, 3000 + seed),
+            _affine_relabel(original, unit_b, (2 * seed + 3) % n, 4000 + seed),
+            _affine_relabel(
+                _affine_relabel(original, unit_a, (seed + 1) % n, 5000 + seed),
+                unit_b,
+                (2 * seed + 3) % n,
+                6000 + seed,
+            ),
+        ]
+        for transformed in variants:
+            invariance_checks += int(canonical_key(transformed) == original_key)
+            carried_checks += int(verify(transformed, transformed["answer"])[0])
+    unrelated = [canonical_key(make_instance(seed=9000 + seed, **shipping)) for seed in range(20)]
+    report["G8_canonical_key"] = {
+        "pass": invariance_checks == 60
+        and carried_checks == 60
+        and len(set(unrelated)) == 20,
+        "invariance_checks_passed": invariance_checks,
+        "invariance_checks_total": 60,
+        "carried_certificate_checks_passed": carried_checks,
+        "carried_certificate_checks_total": 60,
+        "unrelated_distinct": len(set(unrelated)),
+        "unrelated_total": 20,
+    }
+
+    compact_answer = json.dumps(inst["answer"], separators=(",", ":"))
+    answer_chars = len(compact_answer)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = len(inst["answer"])
+    intended_operations = _intended_route_operations(inst["n"])
+    hinted = G9_ORACLE_RESULTS["hinted"]
+    placebo = G9_ORACLE_RESULTS["placebo"]
+    hinted_verdict = G9_ORACLE_RESULTS["hinted_verdict"]
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_verdict == "hardened" and within_caps,
+        "arms": {
+            "bare": dict(G9_ORACLE_RESULTS["bare"]),
+            "hinted": dict(hinted),
+            "placebo": dict(placebo),
+        },
+        "hinted_minus_placebo": (
+            hinted["solved"] / hinted["attempts"]
+            - placebo["solved"] / placebo["attempts"]
+        ),
+        "hinted_verdict": hinted_verdict,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+    }
+
+    report["all_passed"] = all(
+        value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report

