+def _greedy_matching(
+    rows: list[list[int]], rng: random.Random | None = None
+) -> list[int] | None:
+    n = len(rows)
+    order = list(range(n))
+    if rng is not None:
+        rng.shuffle(order)
+    used: set[int] = set()
+    matching = [-1] * n
+    for left in order:
+        choices = list(rows[left])
+        if rng is not None:
+            rng.shuffle(choices)
+        for right in choices:
+            if right not in used:
+                matching[left] = right
+                used.add(right)
+                break
+        if matching[left] < 0:
+            return None
+    return matching
