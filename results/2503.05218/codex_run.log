import random, statistics
from fractions import Fraction

def min_edges(n, k):
    for m in range(n*n + 1):
        q = Fraction(m, n*n)
        if q * (q - Fraction(k-1, n)) + q > 1:
            return m
    raise AssertionError

def exact_pair(n, m, required, rng):
    universe = [(i, j) for i in range(n) for j in range(n)]
    edges = set(rng.sample(universe, m))
    required = set(required)
    for edge in required - edges:
        removed = rng.choice(tuple(edges - required))
        edges.remove(removed)
        edges.add(edge)
    return edges

def trial(seed, n=82, k=16):
    rng = random.Random(seed)
    m = min_edges(n, k)
    aa = rng.sample(range(n), k)
    bb = rng.sample(range(n), k)
    cc = rng.sample(range(n), k)
    ab = exact_pair(n, m, zip(aa, bb), rng)
    ac = exact_pair(n, m, zip(aa, cc), rng)
    bc = exact_pair(n, m, zip(bb, cc), rng)
    used_b, used_c, count = set(), set(), 0
    lookups = 0
    for a in range(n):
        found = False
        for b in range(n):
            if b in used_b:
                continue
            lookups += 1
            if (a, b) not in ab:
                continue
            for c in range(n):
                if c in used_c:
                    continue
                lookups += 1
                if (a, c) not in ac:
                    continue
                lookups += 1
                if (b, c) in bc:
                    used_b.add(b)
                    used_c.add(c)
                    count += 1
                    found = True
                    break
            if found:
                break
        if count == k:
            break
    return count == k, lookups

n, k = 82, 16
m = min_edges(n, k)
q = Fraction(m, n*n)
margin = q * (q - Fraction(k-1, n)) + q - 1
rows = [trial(seed) for seed in range(128)]
print({
    'n': n,
    'k': k,
    'edges_per_pair': m,
    'density': str(q),
    'cyclic_margin': str(margin),
    'greedy_successes': sum(ok for ok, _ in rows),
    'attempts': len(rows),
    'lookup_mean': round(statistics.mean(v for _, v in rows), 3),
    'lookup_median': statistics.median(v for _, v in rows),
    'lookup_max': max(v for _, v in rows),
})
