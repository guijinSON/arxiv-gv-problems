+"""Verified triangle-factor instances grounded in arXiv:2503.05218.
+
+Section 4, Proposition 4.1 composes perfect matchings in A--C and B--C
+when A--B is complete.  This generator makes each sparse bipartite graph a
+union of parallel affine perfect matchings on Z/nZ.  Every component is a
+certificate known by construction; the displayed graph does not mark one.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import Counter, deque
+from typing import Any
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "balanced tripartite graph",
+        "two regular bipartite adjacency lists",
+        "triangle-factor",
+    ],
+    "verification_operations": [
+        "integer range and distinctness checks",
+        "exact adjacency membership",
+        "vertex-disjoint triangle-factor check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "Each sparse bipartite pair decomposes into parallel affine perfect "
+        "matchings, so one component from each pair composes into the factor; "
+        "without that decomposition one must execute bipartite matching."
+    ),
+    "hardness_basis": (
+        "Track B: Section 4, Proposition 4.1 reduces factor construction to two "
+        "bipartite perfect matchings; Hopcroft--Karp is O(E sqrt(V)) and at the "
+        "shipping preset the measured reference cost is filled by selftest, "
+        "whereas the affine row-sum route uses at most 244 exact operations."
+    ),
+    "max_answer_tokens": 250,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 7, "degree": 2},
+    "easy": {"n": 31, "degree": 5},
+    "medium": {"n": 59, "degree": 7},
+    "hard": {"n": 85, "degree": 9},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Each non-complete bipartite graph is a union of parallel affine perfect "
+    "matchings on the displayed cyclic labels."
+)
+PLACEBO_HINT = (
+    "Each adjacency row uses sorted labels so that individual edge checks can "
+    "be made consistently."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A triangle-factor: exactly n triples (a,b,c) with a,b,c in 0..n-1, "
+        "using every label exactly once in each part; order of triples is ignored."
+    ),
+    "bounds": {
+        "triples_at_shipping_preset": 85,
+        "coordinates_per_triple": 3,
+        "coordinate_min": 0,
+        "coordinate_max_at_shipping_preset": 84,
+        "atomic_elements": 255,
+    },
+}
+
+NOTES = r"""
+Definition and paper route. Section 1 defines k vertex-disjoint triangles in a
+balanced tripartite graph. Section 4 defines a triangle-factor. Proposition 4.1
+is the constructive identity used here: if A--B is complete and A--C and B--C
+have perfect matchings, pairing their edges at each C vertex gives a
+triangle-factor. The generator samples two slopes and two unmarked offset sets;
+every offset is a perfect matching, so generation composes identities and never
+solves the displayed instance.
+
+What is easy and the track decision. Theorem 1.3 is an extremal existence
+theorem for n>=5k+2, not a hardness theorem. Independently sampled graphs at its
+common-density threshold are easy: lexicographic greedy found k=16 triangles on
+128/128 audited n=82 instances in a mean 81.969 edge lookups. Section 4 also
+uses Hall matchings, ruling out a Track A claim here. This module therefore uses
+Track B honestly. The reference algorithm is Hopcroft--Karp on both sparse
+pairs followed by Proposition 4.1's composition. The compact route recognizes
+that every row is u*a+S modulo n. Row sums at a=0,1 reveal d*u; one offset then
+gives a whole perfect matching by recurrence, after which the two matchings are
+composed.
+
+Attack hardening. All sparse-pair vertices have exactly the same degree, so the
+degree-outlier probe has no signal. Slopes are selected so no constant-shift
+factor exists. Lexicographic greedy and 256 randomized greedy restarts are
+measured rather than assumed. Plants and decoys are the same objects: all
+listed offsets are full affine perfect matchings and any one may be used.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 200_000
+
+
+def _validate_params(n: int, degree: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int) or not 5 <= n <= 512:
+        raise ValueError("n must be an integer in 5..512")
+    if (
+        isinstance(degree, bool)
+        or not isinstance(degree, int)
+        or not 2 <= degree < n
+    ):
+        raise ValueError("degree must be an integer in 2..n-1")
+    if math.gcd(degree, n) != 1:
+        raise ValueError("degree must be coprime to n")
+
+
+def _allowed_slopes(n: int, degree: int) -> list[int]:
+    return [
+        u
+        for u in range(2, n)
+        if math.gcd(u, n) == 1
+        and n // math.gcd((1 - u) % n, n) > degree
+    ]
+
+
+def _affine_rows(n: int, degree: int, rng: random.Random) -> tuple[list[list[int]], int, int]:
+    slopes = _allowed_slopes(n, degree)
+    if not slopes:
+        raise ValueError("no admissible affine slope at these parameters")
+    slope = rng.choice(slopes)
+    offsets = rng.sample(range(n), degree)
+    rows = [
+        sorted((slope * left + offset) % n for offset in offsets)
+        for left in range(n)
+    ]
+    return rows, slope, min(offsets)
+
+
+def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
+    """Compose two planted affine matchings into a triangle-factor."""
+    unknown = set(params) - {"degree"}
+    if unknown:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(unknown)))
+    degree = params.get("degree", 5)
+    _validate_params(n, degree)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    ac_rows, ac_slope, ac_offset = _affine_rows(n, degree, rng)
+    bc_rows, bc_slope, bc_offset = _affine_rows(n, degree, rng)
+
+    inverse_bc = pow(bc_slope, -1, n)
+    answer = []
+    for a in range(n):
+        c = (ac_slope * a + ac_offset) % n
+        b = (inverse_bc * (c - bc_offset)) % n
+        answer.append([a, b, c])
+
+    return {
+        "family": "affine_triangle_factor",
+        "n": n,
+        "degree": degree,
+        "ab_complete": True,
+        "ac_adjacency": ac_rows,
+        "bc_adjacency": bc_rows,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    n = inst["n"]
+    ac_lines = "\n".join(
+        f"A{a}: " + " ".join(f"C{c}" for c in row)
+        for a, row in enumerate(inst["ac_adjacency"])
+    )
+    bc_lines = "\n".join(
+        f"B{b}: " + " ".join(f"C{c}" for c in row)
+        for b, row in enumerate(inst["bc_adjacency"])
+    )
+    statement = f"""Find a triangle-factor in this balanced tripartite graph.
+
+There are three disjoint vertex parts A={{A0,...,A{n-1}}},
+B={{B0,...,B{n-1}}}, and C={{C0,...,C{n-1}}}.  Edges only join different
+parts.  Every A--B pair is an edge.  The A--C and B--C edges are exactly the
+adjacency lists below; a label absent from a row is not adjacent to that row's
+vertex.
+
+A--C adjacency
+{ac_lines}
+
+B--C adjacency
+{bc_lines}
+
+A triangle is one triple (Aa,Bb,Cc) whose three cross-part edges are present.
+A triangle-factor is exactly {n} triangles that are pairwise vertex-disjoint;
+equivalently, every A, B, and C label occurs exactly once.  Labels are
+0-indexed integers in the inclusive range 0..{n-1}.  The order of the
+triangles does not matter, and repeats are forbidden.
+
+Give your final answer inside <answer></answer> tags as semicolon-separated
+integer triples a,b,c.
+Example: <answer>0,2,1; 1,0,2; 2,1,0</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def _valid_answer_object(value: object) -> list[list[int]] | None:
+    if not isinstance(value, list):
+        return None
+    out: list[list[int]] = []
+    for triple in value:
+        if not isinstance(triple, (list, tuple)) or len(triple) != 3:
+            return None
+        row = list(triple)
+        if any(isinstance(x, bool) or not isinstance(x, int) for x in row):
+            return None
+        out.append(row)
+    return out
+
+
+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    body = match.group(1).strip()
+    if not body:
+        return []
+    try:
+        parsed = json.loads(body)
+    except (json.JSONDecodeError, TypeError):
+        parsed = None
+    normalized = _valid_answer_object(parsed)
+    if normalized is not None:
+        return normalized
+    try:
+        triples = []
+        for part in body.split(";"):
+            fields = [field.strip() for field in part.strip().split(",")]
+            if len(fields) != 3 or any(not re.fullmatch(r"[+-]?\d+", x) for x in fields):
+                return None
+            triples.append([int(x) for x in fields])
+        return triples
+    except (TypeError, ValueError):
+        return None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    n = inst.get("n")
+    normalized = _valid_answer_object(answer)
+    if normalized is None:
+        return False, "answer must be a list of integer triples"
+    if not normalized:
+        return False, "answer must not be empty"
+    if len(normalized) != n:
+        return False, f"answer must contain exactly {n} triples"
+    for i, triple in enumerate(normalized):
+        for part, value in zip("ABC", triple):
+            if not 0 <= value < n:
+                return False, f"triple {i} has {part}-label outside 0..{n-1}"
+    for coordinate, part in enumerate("ABC"):
+        labels = [triple[coordinate] for triple in normalized]
+        if len(set(labels)) != n:
+            return False, f"{part}-labels are not all distinct"
+
+    ac = inst["ac_adjacency"]
+    bc = inst["bc_adjacency"]
+    for i, (a, b, c) in enumerate(normalized):
+        if c not in ac[a]:
+            return False, f"triple {i} is missing its A--C edge"
+        if c not in bc[b]:
+            return False, f"triple {i} is missing its B--C edge"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample factors by enforcing all shape/disjointness rules."""
+    n = inst["n"]
+    b_labels = list(range(n))
+    c_labels = list(range(n))
+    rng.shuffle(b_labels)
+    rng.shuffle(c_labels)
+    return [[a, b_labels[a], c_labels[a]] for a in range(n)]
+
+
+def search_space(inst: dict) -> int | None:
+    return math.factorial(inst["n"]) ** 2
+
+
+def _permanent(rows: list[list[int]], n: int) -> int:
+    masks = [sum(1 << c for c in row) for row in rows]
+    dp = {0: 1}
+    for a in range(n):
+        nxt: dict[int, int] = {}
+        for mask, count in dp.items():
+            available = masks[a] & ~mask
+            while available:
+                bit = available & -available
+                available -= bit
+                nxt[mask | bit] = nxt.get(mask | bit, 0) + count
+        dp = nxt
+    return dp.get((1 << n) - 1, 0)
+
+
+def enumerate_all(inst: dict) -> int | None:
+    n = inst["n"]
+    if 2 * n * (1 << n) > _ENUMERATION_CAP:
+        return None
+    return _permanent(inst["ac_adjacency"], n) * _permanent(
+        inst["bc_adjacency"], n
+    )
+
+
+def _intersection_histogram(rows: list[list[int]]) -> list[list[int]]:
+    sets = [set(row) for row in rows]
+    counts = Counter(
+        len(sets[i] & sets[j])
+        for i in range(len(sets))
+        for j in range(i + 1, len(sets))
+    )
+    return [[size, multiplicity] for size, multiplicity in sorted(counts.items())]
+
+
+def _cross_intersection_histogram(
+    first: list[list[int]], second: list[list[int]]
+) -> list[list[int]]:
+    aa = [set(row) for row in first]
+    bb = [set(row) for row in second]
+    counts = Counter(len(x & y) for x in aa for y in bb)
+    return [[size, multiplicity] for size, multiplicity in sorted(counts.items())]
+
+
+def canonical_key(inst: dict) -> str:
+    """Hash label-invariant intersection profiles, never the seed or rendering."""
+    pair_profiles = sorted(
+        [
+            _intersection_histogram(inst["ac_adjacency"]),
+            _intersection_histogram(inst["bc_adjacency"]),
+        ],
+        key=lambda value: json.dumps(value, separators=(",", ":")),
+    )
+    payload = [
+        inst["n"],
+        inst["degree"],
+        pair_profiles,
+        _cross_intersection_histogram(
+            inst["ac_adjacency"], inst["bc_adjacency"]
+        ),
+    ]
+    encoded = json.dumps(payload, separators=(",", ":")).encode()
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """The factor already reaches the 256-atom cap at the hard preset."""
+    n = int(params.get("n", DIFFICULTY["hard"]["n"]))
+    if 3 * (n + 1) > 256:
+        return "cap_bound"
+    degree = int(params.get("degree", DIFFICULTY["hard"]["degree"]))
+    candidate_n = n + 1
+    candidate_degree = degree
+    while math.gcd(candidate_degree, candidate_n) != 1:
+        candidate_degree -= 1
+    if candidate_degree < 2:
+        return "cap_bound"
+    return {"n": candidate_n, "degree": candidate_degree}
+
+
+def _greedy_matching(
+    rows: list[list[int]], rng: random.Random | None = None
+) -> list[int] | None:
+    n = len(rows)
+    order = list(range(n))
+    if rng is not None:
+        rng.shuffle(order)
+    used: set[int] = set()
+    matching = [-1] * n
+    for left in order:
+        choices = list(rows[left])
+        if rng is not None:
+            rng.shuffle(choices)
+        for right in choices:
+            if right not in used:
+                matching[left] = right
+                used.add(right)
+                break
+        if matching[left] < 0:
+            return None
+    return matching
+
+
+def _compose_matchings(ac: list[int], bc: list[int]) -> list[list[int]]:
+    inverse_bc = {c: b for b, c in enumerate(bc)}
+    if len(inverse_bc) != len(bc):
+        return []
+    return [[a, inverse_bc[c], c] for a, c in enumerate(ac)]
+
+
+def _diagonal_candidate(inst: dict) -> list[list[int]]:
+    return [[i, i, i] for i in range(inst["n"])]
+
+
+def _lexicographic_candidate(inst: dict) -> list[list[int]]:
+    ac = _greedy_matching(inst["ac_adjacency"])
+    bc = _greedy_matching(inst["bc_adjacency"])
+    if ac is None or bc is None:
+        return _diagonal_candidate(inst)
+    return _compose_matchings(ac, bc)
+
+
+def _constant_shift_candidate(inst: dict) -> list[list[int]]:
+    n = inst["n"]
+    matchings = []
+    for rows in (inst["ac_adjacency"], inst["bc_adjacency"]):
+        found = None
+        for shift in rows[0]:
+            candidate = [(left + shift) % n for left in range(n)]
+            if all(candidate[left] in rows[left] for left in range(n)):
+                found = candidate
+                break
+        if found is None:
+            return _diagonal_candidate(inst)
+        matchings.append(found)
+    return _compose_matchings(matchings[0], matchings[1])
+
+
+def _hopcroft_karp(rows: list[list[int]]) -> tuple[list[int] | None, int]:
+    """Return a perfect left-to-right matching and counted edge inspections."""
+    n = len(rows)
+    pair_left = [-1] * n
+    pair_right = [-1] * n
+    distance = [0] * n
+    operations = 0
+
+    def bfs() -> bool:
+        nonlocal operations
+        queue: deque[int] = deque()
+        found = False
+        for left in range(n):
+            if pair_left[left] < 0:
+                distance[left] = 0
+                queue.append(left)
+            else:
+                distance[left] = -1
+        while queue:
+            left = queue.popleft()
+            for right in rows[left]:
+                operations += 1
+                other = pair_right[right]
+                if other < 0:
+                    found = True
+                elif distance[other] < 0:
+                    distance[other] = distance[left] + 1
+                    queue.append(other)
+        return found
+
+    def dfs(left: int) -> bool:
+        nonlocal operations
+        for right in rows[left]:
+            operations += 1
+            other = pair_right[right]
+            if other < 0 or (
+                distance[other] == distance[left] + 1 and dfs(other)
+            ):
+                pair_left[left] = right
+                pair_right[right] = left
+                return True
+        distance[left] = -1
+        return False
+
+    cardinality = 0
+    while bfs():
+        for left in range(n):
+            if pair_left[left] < 0 and dfs(left):
+                cardinality += 1
+    return (pair_left if cardinality == n else None), operations
+
+
+def _reference_factor(inst: dict) -> tuple[list[list[int]] | None, int]:
+    ac, ac_ops = _hopcroft_karp(inst["ac_adjacency"])
+    bc, bc_ops = _hopcroft_karp(inst["bc_adjacency"])
+    if ac is None or bc is None:
+        return None, ac_ops + bc_ops
+    return _compose_matchings(ac, bc), ac_ops + bc_ops
+
+
+def _decode_affine_matching(rows: list[list[int]], n: int) -> list[int]:
+    degree = len(rows[0])
+    inverse_degree = pow(degree, -1, n)
+    slope = ((sum(rows[1]) - sum(rows[0])) * inverse_degree) % n
+    offset = min(rows[0])
+    out = [offset]
+    for _ in range(1, n):
+        out.append((out[-1] + slope) % n)
+    return out
+
