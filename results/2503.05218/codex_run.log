import math, random, statistics, time

def min_m(n,k):
    m=0
    while True:
        q=m/(n*n)
        if q*(q-(k-1)/n)+q>1:
            return m,q
        m+=1

def exact_pair(n,m,required,rng):
    universe=[(i,j) for i in range(n) for j in range(n)]
    edges=set(rng.sample(universe,m))
    req=set(required)
    for e in req-edges:
        removable=list(edges-req)
        dead=rng.choice(removable)
        edges.remove(dead); edges.add(e)
    return edges

def trial(n,k,seed):
    rng=random.Random(seed)
    m,q=min_m(n,k)
    A=rng.sample(range(n),k); B=rng.sample(range(n),k); C=rng.sample(range(n),k)
    AB=exact_pair(n,m,zip(A,B),rng)
    AC=exact_pair(n,m,zip(A,C),rng)
    BC=exact_pair(n,m,zip(B,C),rng)
    t=time.perf_counter(); ops=0; ans=[]; ua=set(); ub=set(); uc=set()
    for a in range(n):
      if a in ua: continue
      found=False
      for b in range(n):
        if b in ub: continue
        ops += 1
        if (a,b) not in AB: continue
        for c in range(n):
          if c in uc: continue
          ops += 1
          if (a,c) in AC and (b,c) in BC:
            ans.append((a,b,c)); ua.add(a);ub.add(b);uc.add(c);found=True;break
        if found: break
      if len(ans)==k: break
    dt=time.perf_counter()-t
    valid=len(ans)==k
    return valid,ops,dt,m,q,len(AB)+len(AC)+len(BC)

for n,k in [(12,2),(27,5),(52,10),(82,16),(132,26)]:
