import math, random, time
import gen_2503_05218 as m

def find(rows):
    n=len(rows); ss=[set(r) for r in rows]; ops=0
    for u in range(1,n):
        if math.gcd(u,n)"'!=1: continue
        for s in rows[0]:
            good=True
            for x in range(1,n):
                ops += 1
                if (u*x+s)%n not in ss[x]:
                    good=False; break
            if good: return (u,s),ops
    return None,ops
for n,d in [(61,8),(127,16),(251,32)]:
    vals=[]; lens=[]
    for seed in range(8):
        inst=m.make_instance(n=n,degree=d,seed=seed)
        t=time.perf_counter(); a,oa=find(inst['"'ac_adjacency']); b,ob=find(inst['bc_adjacency']); dt=time.perf_counter()-t
        vals.append((oa+ob,dt,a,b))
        lens.append(len(m.render(inst)))
    print(n,d,'ops',min(v[0] for v in vals),sum(v[0] for v in vals)/8,max(v[0] for v in vals),'secmax',max(v[1] for v in vals),'render',max(lens))
    print(vals[:2])
