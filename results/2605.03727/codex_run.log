+    """Increase ambiguity at fixed answer length before declaring the cap bound."""
+    harder = dict(params)
+    alphabet_size = harder.get("alphabet_size", 4)
+    if alphabet_size >= 4:
+        harder["alphabet_size"] = 3
+        return harder
+    if alphabet_size == 3:
