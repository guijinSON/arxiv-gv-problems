+        cursors[source_index] += 1
+
+    return {
+        "family": "shuffle_product_interleaving",
+        "n": n,
+        "k": k,
+        "alphabet": alphabet,
+        "sources": sources,
+        "target": "".join(target_symbols),
+        "answer": answer,
+    }
+
+
+def _display_word(word: str, width: int = 64) -> str:
+    return " ".join(word[start:start + width]
+                    for start in range(0, len(word), width))
