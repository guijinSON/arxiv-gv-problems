+def _round_block_attack(inst):
+    """Assume every consecutive k-target block consumes every source once."""
+    sources = inst["sources"]
+    target = inst["target"]
+    k = inst["k"]
+    cursors = [0] * k
+    answer = []
+    for start in range(0, len(target), k):
+        unused = set(range(k))
