+    from gvlib import exact_matrices, rationals
+except ImportError:  # This family needs only exact standard-library operations.
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+STRUCTURAL_HINT = (
+    "Viewed as an equal-width rectangle, the target has wraparound diagonal "
+    "traces equal to the source words."
+)
+PLACEBO_HINT = (
