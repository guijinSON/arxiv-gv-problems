+        for symbol in prefix:
+            remaining_counts[symbol] -= 1
+        tail = []
+        for symbol in alphabet:
+            tail.extend([symbol] * remaining_counts[symbol])
+        rng.shuffle(tail)
+        sources.append("".join(prefix) + "".join(tail))
