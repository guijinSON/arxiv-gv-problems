import random,time,sys
sys.setrecursionlimit(1000)
def schedule(n,k):
 b=(k-1).bit_length(); period=1<<(2*b);bits=[2*i for i in range(b)];return [sum(((p%period>>z)&1)<<j for j,z in enumerate(bits)) for p in range(n)]
def inst(n,k,seed,q=4,sig=2):
 r=random.Random(seed); base=schedule(n,k);perm=list(range(k));r.shuffle(perm);a=[perm[x] for x in base]
 alpha='abcd'[:q]; codes=list(range(q**sig));r.shuffle(codes);ss=[]
 for i in range(k):
  code=codes[i];pre=[]
  for _ in range(sig):pre.append(alpha[code%q]);code//=q
  counts={c:(n//k)//q for c in alpha}
  for c in pre:counts[c]-=1
  z=[]
  for c in alpha:z += [c]*counts[c]
  r.shuffle(z);ss.append(''.join(pre+z))
 pos=[0]*k;t=[]
 for i in a:t.append(ss[i][pos[i]]);pos[i]+=1
 return ss,''.join(t),a

