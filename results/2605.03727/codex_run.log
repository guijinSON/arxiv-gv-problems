+        if nodes > node_cap:
+            cap_hit = True
+            return None
+        if q == total:
+            return []
+        if positions in dead:
+            return None
+        symbol = target[q]
+        for i in range(k):
+            transition_tests += 1
+            if positions[i] < m and sources[i][positions[i]] == symbol:
+                next_positions = list(positions)
+                next_positions[i] += 1
+                suffix = search(q + 1, tuple(next_positions))
+                if suffix is not None:
+                    return [i] + suffix
+                if cap_hit:
+                    return None
