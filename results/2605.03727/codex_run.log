+    target = inst.get("target_word")
+    if not isinstance(sources, list) or not sources:
+        raise ValueError("instance has no source words")
+    if not all(isinstance(word, str) for word in sources):
+        raise ValueError("source words must be strings")
+    if not isinstance(target, str):
+        raise ValueError("target word must be a string")
+    k = len(sources)
+    m = len(sources[0])
+    if m == 0 or any(len(word) != m for word in sources):
+        raise ValueError("source words must have one common positive length")
+    if any(set(word) - {"0", "1"} for word in sources) or set(target) - {"0", "1"}:
+        raise ValueError("all words must be binary")
+    total = k * m
+    if len(target) != total:
+        raise ValueError("target length must equal the sum of source lengths")
+    return sources, target, k, m, total
+
+
+def _labels_to_rows(labels: list[int], k: int, m: int) -> list[list[int]]:
+    rows = [[] for _ in range(k)]
+    for position, source in enumerate(labels):
+        if isinstance(source, int) and not isinstance(source, bool) and 0 <= source < k:
+            rows[source].append(position)
+    if len(labels) != k * m or any(len(row) != m for row in rows):
+        return []
+    return rows
+
+
+def _greedy_labels(inst: dict[str, Any], mode: str) -> list[int]:
+    sources, target, k, m, _ = _problem_shape(inst)
+    positions = [0] * k
+    labels: list[int] = []
+    for symbol in target:
+        eligible = [
+            i for i in range(k)
+            if positions[i] < m and sources[i][positions[i]] == symbol
+        ]
+        if not eligible:
+            return labels
+        if mode == "lowest":
+            chosen = eligible[0]
+        elif mode == "rarest":
+            chosen = min(
+                eligible,
+                key=lambda i: (
+                    sources[i][positions[i]:].count(symbol),
+                    -positions[i],
+                    i,
+                ),
+            )
+        else:
+            raise ValueError("unknown greedy mode")
+        positions[chosen] += 1
+        labels.append(chosen)
+    return labels
+
+
+def _fixed_lane_frequency_candidate(inst: dict[str, Any]) -> list[list[int]]:
+    sources, target, k, m, _ = _problem_shape(inst)
+    lanes = ["".join(target[q * k + lane] for q in range(m)) for lane in range(k)]
+    source_order = sorted(range(k), key=lambda i: (sources[i].count("1"), sources[i], i))
+    lane_order = sorted(range(k), key=lambda j: (lanes[j].count("1"), lanes[j], j))
+    rows = [[] for _ in range(k)]
+    for source, lane in zip(source_order, lane_order):
+        rows[source] = [q * k + lane for q in range(m)]
+    return rows
+
+
+def _repeated_order_candidate(inst: dict[str, Any]) -> list[list[int]]:
+    sources, target, k, m, _ = _problem_shape(inst)
+    unused = set(range(k))
+    order: list[int] = []
+    for lane in range(k):
+        symbol = target[lane]
+        choices = [i for i in sorted(unused) if sources[i][0] == symbol]
+        if not choices:
+            choices = sorted(unused)
+        chosen = choices[0]
+        unused.remove(chosen)
+        order.append(chosen)
+    rows = [[] for _ in range(k)]
+    for q in range(m):
+        for lane, source in enumerate(order):
+            rows[source].append(q * k + lane)
+    return rows
+
+
+def _random_greedy_candidate(
+    inst: dict[str, Any], rng: random.Random, restarts: int = 256
+) -> list[list[int]]:
+    sources, target, k, m, _ = _problem_shape(inst)
+    for _ in range(restarts):
+        positions = [0] * k
+        labels: list[int] = []
+        for symbol in target:
+            eligible = [
+                i for i in range(k)
+                if positions[i] < m and sources[i][positions[i]] == symbol
+            ]
+            if not eligible:
+                break
+            chosen = rng.choice(eligible)
+            positions[chosen] += 1
+            labels.append(chosen)
+        if len(labels) == len(target):
+            candidate = _labels_to_rows(labels, k, m)
+            if candidate and verify(inst, candidate)[0]:
+                return candidate
+    return []
+
+
+def _attack_candidates(inst: dict[str, Any], seed: int) -> dict[str, list[list[int]]]:
+    _, _, k, m, _ = _problem_shape(inst)
+    low = _labels_to_rows(_greedy_labels(inst, "lowest"), k, m)
+    rare = _labels_to_rows(_greedy_labels(inst, "rarest"), k, m)
+    return {
+        "outlier_frequency_rank": _fixed_lane_frequency_candidate(inst),
+        "greedy_leftmost": low,
+        "greedy_rarest_remaining": rare,
+        "repeated_block_order": _repeated_order_candidate(inst),
+        "random_restart_256": _random_greedy_candidate(
+            inst, random.Random(seed ^ 0x260503727), 256
+        ),
+    }
+
+
+def _sample_distinct_words(rng: random.Random, k: int, m: int) -> list[str]:
+    words: list[str] = []
+    used: set[str] = set()
+    while len(words) < k:
+        word = "".join(rng.choice("01") for _ in range(m))
+        if word not in used:
+            used.add(word)
+            words.append(word)
+    return words
+
+
+def _build_candidate(rng: random.Random, n: int, rounds: int) -> dict[str, Any]:
+    sources = _sample_distinct_words(rng, n, rounds)
+    cyclic_order = list(range(n))
+    rng.shuffle(cyclic_order)
+    target_symbols: list[str] = []
+    answer = [[] for _ in range(n)]
+    for q in range(rounds):
+        for lane in range(n):
+            source = cyclic_order[(lane - q) % n]
+            position = len(target_symbols)
+            target_symbols.append(sources[source][q])
+            answer[source].append(position)
+    return {
+        "size_parameter": n,
+        "source_words": sources,
+        "target_word": "".join(target_symbols),
+        "answer": answer,
+    }
+
+
+def make_instance(n: int, seed: int = 0, **params: Any) -> dict[str, Any]:
+    """Inverse-generate a Binary Shuffle Product instance and its bijection."""
+    rounds = params.pop("rounds", None)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if rounds is None:
+        rounds = min(18, max(8, 240 // n)) if isinstance(n, int) and n else 8
+    _validate_parameters(n, rounds)
+
+    rng = random.Random(seed)
+    guarded = n * rounds >= 48
+    last: dict[str, Any] | None = None
+    for _ in range(4096 if guarded else 1):
+        candidate = _build_candidate(rng, n, rounds)
+        last = candidate
+        if not guarded:
+            return candidate
+        attacks = _attack_candidates(candidate, seed)
+        if all(not verify(candidate, answer)[0] for answer in attacks.values()):
+            return candidate
+    raise RuntimeError(
+        "could not draw an instance that defeats the construction-aware cheap attacks"
+    )
+
+
+def render(inst: dict[str, Any]) -> str:
+    sources, target, k, m, total = _problem_shape(inst)
+    lines = [
+        "Binary Shuffle Product: exhibit an order-preserving shuffle bijection",
+        "",
+        "A shuffle of source words interleaves all of their symbols while preserving",
+        "the left-to-right order within every individual source word.  You must",
+        "certify that the target is such a shuffle.",
+        "",
+        f"There are k={k} source words, numbered 0 through {k - 1}.  Every source",
+        f"has exactly m={m} symbols.  The target has T={total} positions, numbered",
+        f"0 through {total - 1}; all endpoint bounds here are inclusive.",
+        "",
+        "Source words:",
+    ]
+    lines.extend(f"  {i}: {word}" for i, word in enumerate(sources))
+    lines.extend(
+        [
+            "",
+            "Target word:",
+            f"  {target}",
+            "",
+            f"Return a JSON array with exactly {k} rows.  Row i corresponds to source",
+            f"word i and must contain exactly {m} distinct target-position integers in",
+            "strictly increasing order.  Across all rows, every target position must",
+            "occur exactly once.  Reading the target symbols at row i's positions",
+            "must reproduce source word i exactly.  Thus rows are labeled and may not",
+            "be reordered; positions are 0-indexed; repeats are forbidden.",
+            "",
+            "Give your final answer inside <answer></answer> tags as the JSON matrix.",
+            "Syntax example for two length-2 sources: <answer>[[0,3],[1,2]]</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def _answer_shape_is_parseable(value: Any) -> bool:
+    return (
+        isinstance(value, list)
+        and all(
+            isinstance(row, list)
+            and all(isinstance(x, int) and not isinstance(x, bool) for x in row)
+            for row in value
+        )
+    )
+
+
+def parse_answer(text: Any) -> object | None:
+    """Extract a JSON matrix from tags or surrounding prose; never raise."""
+    if not isinstance(text, str):
+        return None
+    match = re.search(r"<answer\b[^>]*>(.*?)</answer\s*>", text, re.I | re.S)
+    candidates = [match.group(1).strip()] if match else []
+    candidates.append(text)
+    decoder = json.JSONDecoder()
+    for candidate in candidates:
+        try:
+            value = json.loads(candidate)
+            if _answer_shape_is_parseable(value):
+                return value
+        except (TypeError, ValueError):
+            pass
+        for start, char in enumerate(candidate):
+            if char != "[":
+                continue
+            try:
+                value, _ = decoder.raw_decode(candidate[start:])
+            except ValueError:
+                continue
+            if _answer_shape_is_parseable(value):
+                return value
+    return None
+
+
+def verify(inst: dict[str, Any], answer: Any) -> tuple[bool, str]:
+    """Check any shuffle bijection exactly, without consulting inst['answer']."""
+    try:
+        sources, target, k, m, total = _problem_shape(inst)
+    except (TypeError, ValueError) as exc:
+        return False, "invalid_instance: " + str(exc)
+    if not isinstance(answer, list):
+        return False, "answer_type: expected a JSON array of rows"
+    if len(answer) != k:
+        return False, f"row_count: expected {k} rows"
+    for i, row in enumerate(answer):
+        if not isinstance(row, list):
+            return False, f"row_type: row {i} is not a JSON array"
+        if len(row) != m:
+            return False, f"row_length: row {i} must contain exactly {m} positions"
+        if any(isinstance(x, bool) or not isinstance(x, int) for x in row):
+            return False, f"position_type: row {i} contains a non-integer"
+        if any(x < 0 or x >= total for x in row):
+            return False, f"position_range: row {i} contains a position outside [0,{total - 1}]"
+        if any(row[j] >= row[j + 1] for j in range(m - 1)):
+            return False, f"row_not_increasing: row {i} is not strictly increasing"
+    seen: set[int] = set()
+    for i, row in enumerate(answer):
+        for position in row:
+            if position in seen:
+                return False, f"duplicate_position: target position {position} is repeated"
+            seen.add(position)
+    if len(seen) != total:
+        return False, "missing_position: the rows do not cover every target position"
+    for i, row in enumerate(answer):
+        recovered = "".join(target[position] for position in row)
+        if recovered != sources[i]:
+            return False, f"symbol_mismatch: row {i} reads {recovered}, not source {sources[i]}"
+    return True, "ok"
+
+
+def random_candidate(inst: dict[str, Any], rng: random.Random) -> object:
+    """Uniformly sample a labeled equal-size partition of all target positions."""
+    _, _, k, m, total = _problem_shape(inst)
+    positions = list(range(total))
+    rng.shuffle(positions)
+    return [sorted(positions[i * m:(i + 1) * m]) for i in range(k)]
+
+
+def search_space(inst: dict[str, Any]) -> int | None:
+    """Count labeled equal-size partitions: T!/(m!)^k."""
+    _, _, k, m, total = _problem_shape(inst)
+    return math.factorial(total) // (math.factorial(m) ** k)
+
+
+def enumerate_all(inst: dict[str, Any]) -> int | None:
+    """Count all valid witnesses exactly when the constrained space is <=100,000."""
+    _, _, k, m, total = _problem_shape(inst)
+    if search_space(inst) > 100_000:
+        return None
+    universe = tuple(range(total))
+    rows: list[list[int]] = []
+    count = 0
+
+    def visit(remaining: tuple[int, ...], source: int) -> None:
+        nonlocal count
+        if source == k - 1:
+            candidate = rows + [list(remaining)]
+            count += int(verify(inst, candidate)[0])
+            return
+        for chosen in itertools.combinations(remaining, m):
+            chosen_set = set(chosen)
+            rows.append(list(chosen))
+            visit(tuple(x for x in remaining if x not in chosen_set), source + 1)
+            rows.pop()
+
+    visit(universe, 0)
+    return count
+
+
+def _complement(word: str) -> str:
+    return word.translate(str.maketrans("01", "10"))
+
+
+def canonical_key(inst: dict[str, Any]) -> str:
+    """Canonicalize source reorder, alphabet swap, and simultaneous reversal."""
+    sources, target, k, m, _ = _problem_shape(inst)
+    forms: list[str] = []
+    for reverse in (False, True):
+        src = [word[::-1] if reverse else word for word in sources]
+        tgt = target[::-1] if reverse else target
+        for complement in (False, True):
+            use_src = [_complement(word) for word in src] if complement else src
+            use_tgt = _complement(tgt) if complement else tgt
+            payload = [k, m, sorted(use_src), use_tgt]
+            forms.append(json.dumps(payload, separators=(",", ":")))
+    canonical = min(forms)
+    return hashlib.sha256(canonical.encode("ascii")).hexdigest()
+
+
+def _compact_diagonal_solution(inst: dict[str, Any]) -> list[list[int]] | None:
+    """Undo the planted cyclic shear; used only to audit the intended short route."""
+    sources, target, k, m, _ = _problem_shape(inst)
+    by_word = {word: i for i, word in enumerate(sources)}
+    if len(by_word) != k:
+        return None
+    rows: list[list[int] | None] = [None] * k
+    for diagonal in range(k):
+        positions = [q * k + (diagonal + q) % k for q in range(m)]
+        trace = "".join(target[position] for position in positions)
+        source = by_word.get(trace)
+        if source is None or rows[source] is not None:
+            return None
+        rows[source] = positions
+    if any(row is None for row in rows):
+        return None
+    return [row for row in rows if row is not None]
+
+
+def _reference_dynamic_program(
+    inst: dict[str, Any], node_cap: int = 5_000_000
+) -> tuple[list[list[int]] | None, dict[str, int]]:
+    """The standard memoized multidimensional shuffle search."""
+    sources, target, k, m, total = _problem_shape(inst)
+    dead: set[tuple[int, ...]] = set()
+    nodes = 0
+    transition_tests = 0
+    cap_hit = False
+
+    def search(q: int, positions: tuple[int, ...]) -> list[int] | None:
+        nonlocal nodes, transition_tests, cap_hit
+        nodes += 1
+        if nodes > node_cap:
+            cap_hit = True
+            return None
+        if q == total:
+            return []
+        if positions in dead:
+            return None
+        symbol = target[q]
+        for i in range(k):
+            transition_tests += 1
+            if positions[i] < m and sources[i][positions[i]] == symbol:
+                next_positions = list(positions)
+                next_positions[i] += 1
+                suffix = search(q + 1, tuple(next_positions))
+                if suffix is not None:
+                    return [i] + suffix
+                if cap_hit:
+                    return None
+        dead.add(positions)
+        return None
+
+    labels = search(0, (0,) * k)
+    answer = _labels_to_rows(labels, k, m) if labels is not None else None
+    return answer, {
+        "nodes": nodes,
+        "transition_tests": transition_tests,
+        "memoized_dead_states": len(dead),
+        "node_cap": node_cap,
+        "cap_hit": int(cap_hit),
+    }
+
+
+def escalate(params: dict[str, Any]) -> dict[str, int] | str | None:
+    """Increase source count at essentially fixed witness length."""
+    n = params.get("n")
+    if isinstance(n, bool) or not isinstance(n, int):
+        return None
+    ladder = [(16, 15), (20, 12), (24, 10), (30, 8), (36, 7), (42, 6)]
+    for next_n, rounds in ladder:
+        if next_n > n:
+            return {"n": next_n, "rounds": rounds}
+    return "cap_bound"
+
+
+def _atomic_elements(value: Any) -> int:
+    if isinstance(value, dict):
+        return sum(_atomic_elements(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_atomic_elements(item) for item in value)
+    return 1
+
+
+def _copy_instance(inst: dict[str, Any]) -> dict[str, Any]:
+    return json.loads(json.dumps(inst))
+
+
+def _complement_instance(inst: dict[str, Any]) -> dict[str, Any]:
+    out = _copy_instance(inst)
+    out["source_words"] = [_complement(word) for word in inst["source_words"]]
+    out["target_word"] = _complement(inst["target_word"])
+    return out
+
+
+def _reverse_instance(inst: dict[str, Any]) -> dict[str, Any]:
+    out = _copy_instance(inst)
+    total = len(inst["target_word"])
+    out["source_words"] = [word[::-1] for word in inst["source_words"]]
+    out["target_word"] = inst["target_word"][::-1]
+    out["answer"] = [
+        sorted(total - 1 - position for position in row)
+        for row in inst["answer"]
+    ]
+    return out
+
+
+def _reorder_instance(inst: dict[str, Any], order: list[int]) -> dict[str, Any]:
+    out = _copy_instance(inst)
+    out["source_words"] = [inst["source_words"][i] for i in order]
+    out["answer"] = [inst["answer"][i] for i in order]
+    return out
+
+
+def selftest() -> dict[str, Any]:
+    report: dict[str, Any] = {
+        "paper": "arXiv:2605.03727",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": DIFFICULTY[SHIPPING_DIFFICULTY],
+        "certificate_language": CERTIFICATE_LANGUAGE,
+    }
+
+    # G1: every preset, several unrelated seeds, plus JSON-native answers.
+    g1_cases = []
+    g1_ok = True
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17, 99991):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            json_native = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            compact = _compact_diagonal_solution(inst)
+            compact_ok = compact is not None and verify(inst, compact)[0]
+            g1_ok = g1_ok and ok and json_native and compact_ok
+            g1_cases.append(
+                {
+                    "preset": preset,
+                    "seed": seed,
+                    "verified": ok,
+                    "reason": reason,
+                    "json_native": json_native,
+                    "compact_route_verified": compact_ok,
+                }
+            )
+    report["G1_planted_verifies"] = {"pass": g1_ok, "cases": g1_cases}
+
+    shipping = make_instance(seed=260503727, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    _, _, k, m, total = _problem_shape(shipping)
+
+    # G2: five named corruptions deliberately reach five different checks.
+    corruptions: dict[str, Any] = {}
+    dropped = _copy_instance(shipping)["answer"]
+    dropped[0] = dropped[0][:-1]
+    corruptions["drop_one"] = dropped
+
+    swapped = _copy_instance(shipping)["answer"]
+    swapped[0][0], swapped[0][1] = swapped[0][1], swapped[0][0]
+    corruptions["swap_adjacent"] = swapped
+
+    duplicate = _copy_instance(shipping)["answer"]
+    duplicate[1][0] = duplicate[0][0]
+    duplicate[1].sort()
+    corruptions["duplicate_cross_row"] = duplicate
+    corruptions["empty"] = []
+
+    out_of_range = _copy_instance(shipping)["answer"]
+    out_of_range[0][-1] = total
+    corruptions["out_of_range"] = out_of_range
+
+    corruption_results = {}
+    reasons = set()
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
+        corruption_results[name] = {"rejected": not ok, "reason": reason}
+        if not ok:
+            reasons.add(reason.split(":", 1)[0])
+    report["G2_rejects_corruption"] = {
+        "pass": all(item["rejected"] for item in corruption_results.values())
+        and len(reasons) == len(corruption_results),
+        "distinct_reason_classes": sorted(reasons),
+        "cases": corruption_results,
+    }
+
+    # G3: realistic prose and a fenced tagged block round-trip exactly.
+    model_style = (
+        "I used the order-preserving embedding.\n```json\n<answer>"
+        + json.dumps(shipping["answer"], separators=(",", ":"))
+        + "</answer>\n```\nThe rows are listed by source index."
+    )
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": parsed == shipping["answer"] and parse_answer("not an answer") is None,
+        "realistic_response_recovered": parsed == shipping["answer"],
+        "garbage_returns_none": parse_answer("not an answer") is None,
+    }
+
+    # G4 and the shipping-density part of G5 share 200k structure-aware samples.
+    guess_rng = random.Random(0x260503727)
+    sample_total = 200_000
+    sample_hits = 0
+    start = time.perf_counter()
+    for _ in range(sample_total):
+        sample_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
+    sampling_elapsed = time.perf_counter() - start
+    empirical = sample_hits / sample_total
+    report["G4_guess_resistance"] = {
+        "pass": sample_total >= 200_000 and empirical < 1e-6,
+        "hits": sample_hits,
+        "total": sample_total,
+        "empirical_probability": empirical,
+        "candidate_space": search_space(shipping),
+        "prior": "uniform over labeled equal-size partitions of all target positions",
+        "wall_clock_sec": round(sampling_elapsed, 6),
+    }
+
+    # Track B reference DP succeeds and is measured separately from failed attacks.
+    attack_names = list(_attack_candidates(shipping, 0))
+    attack_stats = {name: {"successes": 0, "attempts": 0} for name in attack_names}
+    reference_instances = []
+    reference_successes = 0
+    reference_wall = 0.0
+    reference_nodes = 0
+    reference_operations = 0
+    for seed in range(8100, 8108):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        for name, candidate in _attack_candidates(inst, seed).items():
+            attack_stats[name]["attempts"] += 1
+            attack_stats[name]["successes"] += int(verify(inst, candidate)[0])
+        ref_start = time.perf_counter()
+        answer, stats = _reference_dynamic_program(inst)
+        elapsed = time.perf_counter() - ref_start
+        solved = answer is not None and verify(inst, answer)[0]
+        reference_successes += int(solved)
+        reference_wall += elapsed
+        reference_nodes += stats["nodes"]
+        reference_operations += stats["transition_tests"]
+        reference_instances.append(
+            {
+                "seed": seed,
+                "solved": solved,
+                "wall_clock_sec": round(elapsed, 6),
+                **stats,
+            }
+        )
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": sample_total >= 200_000
+        and reference_successes == 8
+        and isinstance(demo_count, int),
+        "shipping_sampled_solution_hits": sample_hits,
+        "shipping_sampled_solution_total": sample_total,
+        "shipping_sampled_solution_fraction": empirical,
+        "sampling_wall_clock_sec": round(sampling_elapsed, 6),
+        "strongest_attack": "memoized multidimensional shuffle dynamic program",
+        "strongest_attack_wall_clock_sec": round(reference_wall, 6),
+        "strongest_attack_transition_tests": reference_operations,
+        "strongest_attack_nodes": reference_nodes,
+        "strongest_attack_solved_instances": reference_successes,
+        "demo_exact_valid_witness_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+    }
+    all_attacks_failed = all(item["successes"] == 0 for item in attack_stats.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == 8,
+        "attacks": attack_stats,
+        "reference_algorithm": {
+            "name": "memoized multidimensional Shuffle Product dynamic program",
+            "paper_basis": "Section 3, paragraph preceding Theorem 3.1",
+            "complexity": "O(T*k*(m+1)^k) time and O((m+1)^k) states",
+            "wall_clock_sec": round(reference_wall, 6),
+            "mean_wall_clock_sec": round(reference_wall / 8, 6),
+            "operations": reference_operations,
+            "mean_operations": round(reference_operations / 8, 3),
+            "nodes": reference_nodes,
+            "solves": f"{reference_successes}/8, as expected",
+            "instances": reference_instances,
+        },
+    }
+
+    # G7: double n while keeping the certificate below the same 256-atom cap.
+    base = make_instance(seed=314159, **DIFFICULTY["hard"])
+    doubled = make_instance(n=24, rounds=10, seed=314159)
+    doubled_compact = _compact_diagonal_solution(doubled)
+    report["G7_scales"] = {
+        "pass": verify(doubled, doubled["answer"])[0]
+        and doubled_compact is not None
+        and verify(doubled, doubled_compact)[0]
+        and search_space(doubled) > search_space(base)
+        and _atomic_elements(doubled["answer"]) <= 256,
+        "base_n": 12,
+        "base_rounds": 18,
+        "base_answer_elements": _atomic_elements(base["answer"]),
+        "base_search_space": search_space(base),
+        "doubled_n": 24,
+        "doubled_rounds": 10,
+        "doubled_answer_elements": _atomic_elements(doubled["answer"]),
+        "doubled_search_space": search_space(doubled),
+    }
+
+    # G8: exercise generators of the full declared relabelling group and compositions.
+    invariance_checks = 0
+    carried_checks = 0
+    keys: set[str] = set()
+    g8_ok = True
+    for seed in range(20):
+        inst = make_instance(seed=90000 + seed, **DIFFICULTY["hard"])
+        key = canonical_key(inst)
+        keys.add(key)
+        order = list(range(k))
+        random.Random(seed ^ 0xB1E).shuffle(order)
+        reordered = _reorder_instance(inst, order)
+        complemented = _complement_instance(inst)
+        reversed_inst = _reverse_instance(inst)
+        composed = _reverse_instance(_complement_instance(reordered))
+        for transformed in (reordered, complemented, reversed_inst, composed):
+            invariance_checks += 1
+            g8_ok = g8_ok and canonical_key(transformed) == key
+            carried_checks += 1
+            g8_ok = g8_ok and verify(transformed, transformed["answer"])[0]
+    report["G8_canonical_key"] = {
+        "pass": g8_ok and len(keys) == 20,
+        "invariance_checks": invariance_checks,
+        "carried_certificate_checks": carried_checks,
+        "unrelated_distinct_keys": len(keys),
+        "unrelated_instances": 20,
+        "symmetries_tested": [
+            "arbitrary source-word reorder",
+            "global binary-alphabet complement",
+            "simultaneous reversal of every word",
+            "reorder+complement+reversal composition",
+        ],
+        "key_material": "canonicalized source words and target; never seed or render text",
+    }
+
+    answer_blob = json.dumps(shipping["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_elements = _atomic_elements(shipping["answer"])
+    answer_tokens = math.ceil(answer_chars / 4)
+    intended_operations = total + k
+    hinted = _G9_ARMS["hinted"]
+    placebo = _G9_ARMS["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    report["G9_no_tool_suitability"] = {
+        "pass": answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300,
+        "arms": _G9_ARMS,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": (
+            "hardened"
+            if hinted["attempts"] and hinted["solved"] == 0
+            else "too_easy"
+            if hinted["attempts"]
+            else "diagnostic_pending"
+        ),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "operation_accounting": "T diagonal position reads plus k exact trace lookups",
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [
+        item
+        for name, item in report.items()
+        if name.startswith("G") and isinstance(item, dict) and "pass" in item
+    ]
+    report["all_passed"] = all(item["pass"] for item in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=False))

