+def _coordinate_code(position: int, k: int) -> int:
+    """Extract binary coordinates 0,2,4,... from a target position."""
+    bits = k.bit_length() - 1
+    period_mask = (1 << (2 * bits)) - 1
+    position &= period_mask
+    code = 0
+    for out_bit in range(bits):
+        code |= ((position >> (2 * out_bit)) & 1) << out_bit
+    return code
 
