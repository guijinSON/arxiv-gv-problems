+    "Viewed as an equal-width rectangle, the target has wraparound diagonal "
+    "traces equal to the source words."
+)
+PLACEBO_HINT = (
+    "Careful bookkeeping of the position conventions is useful for this "
+    "binary-word problem."
+)
+
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "matrix_certificate",
+    "native_objects": [
+        "binary source words",
+        "binary target word",
+        "order-preserving shuffle bijection",
+    ],
+    "verification_operations": [
+        "integer range comparison",
+        "strict-order comparison",
+        "exact binary-symbol comparison",
+        "bijection check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Reshape the target into one row per source-letter round and read its "
+        "wraparound diagonals; without this cyclic shear, a solver explores "
+        "the multidimensional shuffle-position state space."
+    ),
+    "hardness_basis": (
+        "Track B: Section 3 notes the fixed-k multidimensional dynamic program, "
+        "whose worst-case time is O(T*k*(m+1)^k); its measured shipping-preset "
+        "cost is recorded by selftest, whereas the cyclic-shear route takes at "
+        "most T+k=228 elementary index/lookups and is unavailable until the "
+        "rectangular change of variables is recognized."
+    ),
+    "max_answer_tokens": 200,
+}
