3560046 bash -c cd ~/gvrepo/results 2>/dev/null || exit 0 for d in */; do   id=${d%/}   n=0   for p in $(ls /proc 2>/dev/null | grep -E "^[0-9]+$"); do     [ "$(readlink /proc/$p/cwd 2>/dev/null)" = "/home/gson/gvrepo/results/$id" ] && n=$((n+1))   done   [ $n -gt 0 ] && continue   # REJECTED.md is decisive whether or not a module exists. A builder that   # constructs the family, runs the oracle, gets too_easy and then rejects leaves   # BOTH a gen_*.py and a REJECTED.md -- that matched neither branch, so those   # papers were never harvested and sat in_progress forever.   if [ -f "$id/REJECTED.md" ]; then echo "REJ $id"   elif ls $id/gen_*.py >/dev/null 2>&1 && [ -s "$id/README.md" ] && [ -s "$id/selftest_report.json" ] && [ -s "$id/llm_loop_transcript.jsonl" ]; then echo "OK $id"   else     # STALL is now a catch-all: a build that died after writing gen_*.py but before     # README/selftest matched NEITHER branch before, so 1512.08995 and 1609.05136 sat     # in_progress indefinitely holding queue slots.  Guard it on log quiet time, so a     # paper that is merely between processes is not relaunched into a duplicate     # builder on top of itself.     quiet=1     if [ -f "$id/codex_run.log" ]; then       age=$(( $(date +%s) - $(stat -c %Y "$id/codex_run.log" 2>/dev/null || echo 0) ))       [ "$age" -lt 900 ] && quiet=0     fi     [ "$quiet" -eq 1 ] && echo "STALL $id"   fi done echo DETECT_OK

