+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+DIFFICULTY = {
+    "demo": {"n": 3, "rounds": 4},
+    "easy": {"n": 6, "rounds": 14},
+    "medium": {"n": 9, "rounds": 18},
+    "hard": {"n": 12, "rounds": 18},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON matrix with exactly k rows and m integer entries per row.  "
+        "Each row is strictly increasing in [0,T-1], and together the rows "
+        "partition all T target positions.  The bounded language contains "
+        "all labeled equal-size partitions, not only symbol-compatible ones."
+    ),
+    "bounds": {
+        "shipping_rows": 12,
+        "shipping_entries_per_row": 18,
+        "shipping_total_positions": 216,
+        "minimum_position": 0,
+        "maximum_position_shipping": 215,
+    },
+}
+
+
+NOTES = """\
+Definition: Section 3, Definition 1 defines shuffle membership by a bijection
+from source-letter positions to target positions, increasing within each
+source and preserving every letter.  The verifier checks exactly this native
+object.  Theorem 3.1 proves Binary Shuffle Product XNLP-complete when the
+number k of source words is the parameter.  The paragraph immediately before
+that theorem also records the easy regime: constant k is polynomial-time
+solvable by multidimensional dynamic programming.  This rules out presenting
+the family as Track A and supplies the successful Track B reference method.
+
+Generation is inverse, not a solve: sample distinct equal-length binary source
+words and a random cyclic source order, emit letter q of each source once in
+round q after a one-column cyclic shear, and carry the emitted positions.  The
+source words are exchangeable; there is no planted source/decoy distinction.
+Candidates whose construction is accidentally solved by any of the four cheap
+attacks are discarded, but the held certificate is never obtained from an
+attack or from the reference DP.
+
+The construction defeats fixed-lane and repeated-order attacks by moving every
+source one column per round.  It defeats source-frequency ranking because the
+source words are sampled by one common rule, greedy consumption because local
+binary matches do not reveal a source's next lane, and 256 randomized greedy
+restarts by deterministic rejection sampling.  The compact route is to undo
+the cyclic shear; without recognizing that change of variables the reference
+algorithm searches tuples of k source positions.
+"""
+
+
+_G9_ARMS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+}
