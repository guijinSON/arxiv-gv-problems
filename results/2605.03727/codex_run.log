def sched(k,m):
 B=(k*m).bit_length()-1;b=k.bit_length()-1; bits=list(range(0,2*b,2)) # k=8 L=256 bits 0,2,4
 a=[]
 for p in range(k*m):
  x=0
  for j,z in enumerate(bits):x|=((p>>z)&1)<<j
  a.append(x)
 return a

def inst(k,m,seed,q=4):
 r=random.Random(seed);a=sched(k,m);perm=list(range(k));r.shuffle(perm);a=[perm[x] for x in a]
 alpha='abcd'[:q];t=''.join(r.choice(alpha) for _ in a);ss=['']*k
 for i,c in zip(a,t):ss[i]+=c
 return ss,t,a

def dfs(ss,t,limit=5000000):
 k=len(ss);lens=tuple(map(len,ss)); nodes=0;dead=set();choice=[]
 def go(pos,state):
  nonlocal nodes
  nodes+=1
  if nodes>limit:return None
  if pos==len(t):return [] if state==lens else None
  if state in dead:return None
  c=t[pos]
  # fewest remaining first, then source id
  can=[i for i in range(k) if state[i]<lens[i] and ss[i][state[i]]==c]
  can.sort(key=lambda i:(lens[i]-state[i],i))
  for i in can:
   ns=list(state);ns[i]+=1;ns=tuple(ns)
   out=go(pos+1,ns)
   if out is not None:return [i]+out
  dead.add(state);return None
 out=go(0,(0,)*k)
 return out,nodes,len(dead)
