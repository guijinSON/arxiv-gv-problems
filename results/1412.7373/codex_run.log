import random,time,statistics
N=128; MASK=(1<<N)-1; RED=(1<<7)|(1<<2)|(1<<1)|1; M=(1<<N)-1
P=(3,5,17,257,641,65537,274177,6700417,67280421310721)
def mul(a,b):
 z=0
 while b:
  if b&1:z"'^=a
  b>>=1
  c=a>>(N-1); a=(a<<1)&MASK
  if c:a''^=RED
 return z
def power(a,e):
 z=1
 while e:
  if e&1:z=mul(z,a)
  e>>=1
  if e:a=mul(a,a)
 return z
def primitive(a): return all(power(a,M//p)!=1 for p in P)
r=random.Random(14127373)
counts=[]; times=[]
for _ in range(100):
 c=0;t=time.perf_counter()
 while True:
  c+=1
  if primitive((1<<16)|r.randrange(1<<16)):break
 times.append(time.perf_counter()-t);counts.append(c)
print({'"'trials':100,'total_candidates':sum(counts),'mean_candidates':statistics.mean(counts),'median_candidates':statistics.median(counts),'mean_sec':statistics.mean(times),'median_sec':statistics.median(times),'total_sec':sum(times)})
