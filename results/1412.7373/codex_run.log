text=Path('REJECTED.md').read_text()
factors=(3,5,17,257,641,65537,274177,6700417,67280421310721)
checks={
 'factorization_2_128_minus_1': prod(factors)==2**128-1,
 'documents_G': '**G**' in text,
 'documents_H': '**H**' in text,
 'documents_V': '**V passes**' in text,
 'documents_track_A': 'Track A' in text,
 'documents_track_B': 'Track B' in text,
 'documents_mechanical_cost': 'Mechanical cost versus compact route' in text,
 'documents_paper_result': 'Theorem 5' in text and 'Section 1.2' in text,
 'no_generator': not list(Path('.').glob('gen_*.py')),
}
try:
 import sympy
 checks['mersenne_127_prime']=bool(sympy.isprime(2**127-1))
 checks['all_128_factors_prime']=all(bool(sympy.isprime(p)) for p in factors)
except Exception as exc:
 checks['sympy_check']=str(exc)
print(checks)
assert all(v is True for v in checks.values())
