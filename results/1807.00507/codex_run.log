+    # A plausible in-context shortcut notices balanced bands but assumes the
+    # bands contribute equally.  Shipping deliberately mixes 1/2 and 1/10.
+    n_bands = inst["n"] // 3
+    equal_band = []
+    for panel in inst["panels"]:
