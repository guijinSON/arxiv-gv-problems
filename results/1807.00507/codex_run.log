import itertools
import gen_1807_00507 as g

def solve(inst):
 scale=inst['scale']; opts=[]; ops=0
 for panel in inst['panels']:
  for band in panel:
   fixed={v for row in band for v in row if v}; missing=[d for d in range(1,10) if d not in fixed]
   choices=[];ops+=22
   for supplied in itertools.permutations(missing):
    subtotal=sum(g._scaled_term(row,d,scale) for row,d in zip(band,supplied));ops+=3 # 2 adds + divisibility
    if subtotal and scale%subtotal==0: choices.append((subtotal,supplied,scale//subtotal))
   opts.append(choices)
 for choice in itertools.product(*opts):
  ops+=len(choice)-1
  if sum(x[0] for x in choice)==scale:
   ans=[d for x in choice for d in x[1]]
   if g.verify(inst,ans)[0]:return ans,ops,opts
 return None,ops,opts
for prm in list(g.DIFFICULTY.values())+[{\"n\":18,\"bands_per_panel\":6},{\"n\":21,\"bands_per_panel\":1},{\"n\":24,\"bands_per_panel\":4}]:
 mx=0; counts=set();good=0
 for seed in range(100):
