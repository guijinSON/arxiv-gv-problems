    _codes({1: 1, 2: 1, 4: 1, 5: 1, 7: 1}),
    _codes({6: 1}),
    _codes({1: 1, 2: 1, 4: 1, 5: 1}),
    _codes({0: 1, 2: -1, 3: 1, 5: -1, 6: 1}),
]

_OUTPUT_ROWS = {
    0: {6: 1, 13: 1, 20: 1},
    1: {0: 1, 1: 1, 5: 1},
    2: {0: -1, 2: -1, 3: 1, 10: 1, 12: 1, 16: -1, 18: 1},
