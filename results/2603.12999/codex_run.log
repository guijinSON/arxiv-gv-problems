+    drop = [list(planted[0][:-1]), list(planted[1])]
+    swap = [list(planted[0]), list(planted[1])]
+    swap[0][0], swap[1][0] = swap[1][0], swap[0][0]
+    duplicate = [list(planted[0]), list(planted[1]) + [planted[0][0]]]
+    empty = []
+    out_of_range = [list(planted[0]), list(planted[1])]
