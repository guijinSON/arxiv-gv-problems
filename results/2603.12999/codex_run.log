+        if len(bins[0]) == limit:
+            target = 1
+        elif len(bins[1]) == limit:
+            target = 0
+        else:
+            target = 0 if loads[0] <= loads[1] else 1
+        bins[target].append(index)
+        loads[target] += inst["items"][index]
