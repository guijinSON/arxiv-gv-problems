+    """Exact centre-normalised subset-sum DP with block reconstruction."""
+    start_time = time.perf_counter()
+    _centres, differences, higher, residual = _centres_differences(inst)
+    total = sum(differences)
+    numerator = total + residual
+    if numerator % 2:
+        return None, {
