+    out = dict(inst)
+    delta = amount * (inst["block_base"] ** inst["blocks"])
+    out["items"] = [value + delta for value in inst["items"]]
+    out["capacity"] = inst["capacity"] + (inst["n"] // 2) * delta
+    out["bounded_W"] = max(out["items"])
+    return out
