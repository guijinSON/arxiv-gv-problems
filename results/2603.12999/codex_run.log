    7: {0: 1, 7: 1, 12: -1, 19: 1, 21: 1},
    8: {0: -1, 2: -1, 7: -1, 12: 1, 16: -1, 18: 1},
}

_gamma_maps = [dict() for _ in range(_RANK)]
for _coordinate, _terms in _OUTPUT_ROWS.items():
    for _term_index, _coefficient in _terms.items():
        _gamma_maps[_term_index][_coordinate] = _coefficient
_C = [_codes(mapping) for mapping in _gamma_maps]
BASE_TERMS = tuple((_A[i], _B[i], _C[i]) for i in range(_RANK))

def verify(inst, answer):
    """Check any pool-supported rank-23 decomposition, never the planted answer."""
    if not isinstance(answer, list):
        return False, "answer must be a JSON list"
    if not answer:
        return False, "answer term list is empty"
    if len(answer) != _RANK:
        return False, f"wrong term count: expected 23, got {len(answer)}"

    terms = []
    for position, term in enumerate(answer):
        converted, reason = _validate_term(term, position)
        if reason:
            return False, reason
        terms.append(converted)
    if terms != sorted(terms):
        return False, "the 23 terms are not in canonical lexicographic order"
    if len(set(terms)) != _RANK:
        return False, "the answer repeats a rank-one term"

    try:
        pool = _pool_for(inst)
    except (KeyError, TypeError):
        return False, "instance candidate pool is malformed"
    for position, term in enumerate(terms):
        if term not in pool:
            return False, f"term {position} is not present in the candidate pool"

    evaluations = [_term_evaluations(term) for term in terms]
    for evaluation_index in range(len(_EVAL_POINTS)):
        got = sum(values[evaluation_index] for values in evaluations)
        if got != _TARGET_EVALUATIONS[evaluation_index]:
            return False, f"exact evaluation checksum {evaluation_index} disagrees with A*B"

    expanded = _expand_terms(terms)
    if expanded != _TARGET:
        keys = sorted(set(expanded) | set(_TARGET))
        for key in keys:
            if expanded.get(key, 0) != _TARGET.get(key, 0):
                return False, (
                    "tensor coefficient mismatch at " + str(key)
                    + f": got {expanded.get(key, 0)}, expected {_TARGET.get(key, 0)}"
                )
        return False, "tensor coefficient mismatch"
    return True, "ok"


def random_candidate(inst, rng):
    """Uniformly sample a shape-valid 23-subset of the displayed pool."""
    if not isinstance(rng, random.Random):
        raise TypeError("rng must be an instance of random.Random")
    chosen = rng.sample(inst["candidate_terms"], _RANK)
    return sorted(chosen)


def search_space(inst):
    return math.comb(inst["n"], _RANK)


def enumerate_all(inst):
    space = search_space(inst)
    if space > _ENUMERATION_CAP:
        return None
    count = 0
    candidates = inst["candidate_terms"]
    for indices in itertools.combinations(range(inst["n"]), _RANK):
        answer = sorted(candidates[index] for index in indices)
        count += int(verify(inst, answer)[0])
    return count


def _support_canonical(factor):
    support = {abs(code) - 1 for code in factor}
    candidates = []
    for rows in itertools.permutations(range(3)):
        for cols in itertools.permutations(range(3)):
            candidates.append(tuple(
                int(3 * rows[i] + cols[j] in support)
                for i in range(3) for j in range(3)
            ))
    return min(candidates)


def _shape_signature(term):
    return tuple(_support_canonical(factor) for factor in term)


def canonical_key(inst):
    """A signed-frame and pool-order invariant multiset of orbit shapes."""
    signatures = sorted(_shape_signature(_json_to_term(term))
                        for term in inst["candidate_terms"])
    payload = json.dumps([inst["n"], signatures], separators=(",", ":"))
    return hashlib.sha256(payload.encode("ascii")).hexdigest()


def escalate(params):
    harder = dict(params)
    n = int(harder.get("n", 0))
    if n >= 4096:
        return None
    harder["n"] = min(4096, n + max(64, n // 3))
    return harder


def _reference_algorithm(inst):
    """Enumerate signed frames, using two catalogue anchors for early rejection."""
    pool = {_json_to_term(term) for term in inst["candidate_terms"]}
    anchor_a, anchor_b = 16, 11
    operations = 0
    for p_index in range(48):
        for q_index in range(48):
            for r_index in range(48):
                first = _transform_term(BASE_TERMS[anchor_a], p_index, q_index, r_index)
                operations += sum(map(len, BASE_TERMS[anchor_a])) + 1
                if first not in pool:
                    continue
                second = _transform_term(BASE_TERMS[anchor_b], p_index, q_index, r_index)
                operations += sum(map(len, BASE_TERMS[anchor_b])) + 1
                if second not in pool:
                    continue
                scheme = _scheme_for_frame((p_index, q_index, r_index))
                operations += 165 + _RANK
                if all(term in pool for term in scheme):
                    answer = [_term_to_json(term) for term in sorted(scheme)]
                    return answer, operations
    return None, operations


def _answer_from_terms(terms):
    unique = sorted(set(terms))
    if len(unique) < _RANK:
        return None
    return [_term_to_json(term) for term in unique[:_RANK]]


def _attack_outlier(inst):
    terms = [_json_to_term(term) for term in inst["candidate_terms"]]
    frequencies = {}
    for term in terms:
        signature = _shape_signature(term)
        frequencies[signature] = frequencies.get(signature, 0) + 1
    ranked = sorted(terms, key=lambda term: (frequencies[_shape_signature(term)], term))
    return [_term_to_json(term) for term in sorted(ranked[:_RANK])]


def _term_tensor(term):
    return _expand_terms([term])


def _attack_greedy(inst):
    terms = [_json_to_term(term) for term in inst["candidate_terms"]]
    tensors = [_term_tensor(term) for term in terms]
    residual = dict(_TARGET)
    chosen = []
    available = set(range(len(terms)))
    for _ in range(_RANK):
        best = None
        best_score = None
        for index in available:
            contribution = tensors[index]
            keys = set(residual) | set(contribution)
            old = sum(abs(residual.get(key, 0)) for key in keys)
            new = sum(abs(residual.get(key, 0) - contribution.get(key, 0))
                      for key in keys)
            score = old - new
            key = (score, tuple(-x for factor in terms[index] for x in factor))
            if best_score is None or key > best_score:
                best_score = key
                best = index
        chosen.append(terms[best])
        available.remove(best)
        for key, value in tensors[best].items():
            residual[key] = residual.get(key, 0) - value
            if residual[key] == 0:
                residual.pop(key)
    return [_term_to_json(term) for term in sorted(chosen)]


def _attack_unsigned_catalogue(inst):
    terms = sorted(_json_to_term(term) for term in inst["candidate_terms"])
    needed = {}
    for term in BASE_TERMS:
        sig = _shape_signature(term)
        needed[sig] = needed.get(sig, 0) + 1
    chosen = []
    for signature, amount in sorted(needed.items(), key=lambda item: str(item[0])):
        matches = [term for term in terms if _shape_signature(term) == signature]
        chosen.extend(matches[:amount])
    return _answer_from_terms(chosen)


def _attack_display_order(inst):
    terms = [_json_to_term(term) for term in inst["candidate_terms"][:_RANK]]
    return [_term_to_json(term) for term in sorted(terms)]


def _adversary_panel(params):
    names = (
        "outlier_rarest_support_shape",
        "greedy_tensor_residual",
        "unsigned_catalogue_match",
        "display_order_first_23",
        "random_restart_256",
    )
    attacks = {name: {"successes": 0, "attempts": 8} for name in names}
    reference_successes = 0
    reference_operations = []
    reference_times = []
    attack_start = time.perf_counter()
    restart_trials = 0
    for seed in range(800, 808):
        inst = make_instance(seed=seed, **params)
        candidates = {
            "outlier_rarest_support_shape": _attack_outlier(inst),
            "greedy_tensor_residual": _attack_greedy(inst),
            "unsigned_catalogue_match": _attack_unsigned_catalogue(inst),
            "display_order_first_23": _attack_display_order(inst),
        }
        for name, candidate in candidates.items():
            attacks[name]["successes"] += int(
                candidate is not None and verify(inst, candidate)[0]
            )
        rng = random.Random(seed ^ 0x260105272)
        found = False
        for _ in range(256):
            restart_trials += 1
            if verify(inst, random_candidate(inst, rng))[0]:
                found = True
                break
        attacks["random_restart_256"]["successes"] += int(found)

        start = time.perf_counter()
        recovered, operations = _reference_algorithm(inst)
        reference_times.append(time.perf_counter() - start)
        reference_operations.append(operations)
        reference_successes += int(
            recovered is not None and verify(inst, recovered)[0]
        )
    attack_elapsed = time.perf_counter() - attack_start - sum(reference_times)
    all_failed = all(value["successes"] == 0 for value in attacks.values())
    return {
        "pass": all_failed and reference_successes == 8,
        "attacks": attacks,
        "attack_wall_clock_sec": attack_elapsed,
        "attack_random_candidates": restart_trials,
        "reference_algorithm": {
            "name": "exact signed-monomial orbit-template enumeration",
            "complexity": "O(48^3 * sparse anchor size), then 23-term exact verification",
            "wall_clock_sec_total": sum(reference_times),
            "wall_clock_sec_max": max(reference_times),
            "operations_total": sum(reference_operations),
            "operations_max": max(reference_operations),
            "solves": f"{reference_successes}/8, as expected",
        },
    }


def _relabel_instance(inst, frame=None, reorder=False, rng=None):
    if rng is None:
        rng = random.Random(0)
    if frame is None:
        frame = (0, 0, 0)
    candidates = [_transform_term(_json_to_term(term), *frame)
                  for term in inst["candidate_terms"]]
    if reorder:
        rng.shuffle(candidates)
    answer = [_transform_term(_json_to_term(term), *frame)
              for term in inst["answer"]]
    return {
        "family": inst["family"],
        "n": inst["n"],
        "candidate_terms": [_term_to_json(term) for term in candidates],
        "answer": [_term_to_json(term) for term in sorted(answer)],
    }


def _corruption_tests(inst):
    original = json.loads(json.dumps(inst["answer"]))
    corruptions = {}

    dropped = json.loads(json.dumps(original))
    dropped.pop()
    corruptions["drop_one"] = dropped

    swapped = json.loads(json.dumps(original))
    swapped[0], swapped[1] = swapped[1], swapped[0]
    corruptions["swap_one"] = swapped

    duplicated = json.loads(json.dumps(original))
    duplicated[-1] = json.loads(json.dumps(duplicated[0]))
    duplicated.sort()
    return 0


