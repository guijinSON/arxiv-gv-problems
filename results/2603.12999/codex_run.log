+        "operations_max": max(reference_operations),
+        "wall_clock_sec_average": round(sum(reference_seconds) / len(reference_seconds), 6),
+        "wall_clock_sec_max": round(max(reference_seconds), 6),
+    }
+    report["G6_adversary_panel"] = {
