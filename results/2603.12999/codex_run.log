+        for d in differences[lo:hi]:
+            bits = (bits | (bits << d)) & limit
+            word_operations += words
+    if not ((bits >> target) & 1):
+        return None, {
+            "wall_clock_sec": time.perf_counter() - start_time,
+            "word_operations": word_operations,
+            "reconstruction_masks": 0,
+            "target_state": target,
