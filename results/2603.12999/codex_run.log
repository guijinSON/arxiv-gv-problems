+            "target_state": None,
+        }
+    target = numerator // 2
+    if target < 0 or target > total:
+        return None, {
+            "wall_clock_sec": time.perf_counter() - start_time,
+            "word_operations": 0,
+            "reconstruction_masks": 0,
