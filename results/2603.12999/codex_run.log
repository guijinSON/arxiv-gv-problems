+def _reorder_instance(inst, new_to_old):
+    n = inst["n"]
+    if sorted(new_to_old) != list(range(n)):
+        raise ValueError("not an item permutation")
+    old_to_new = {old: new for new, old in enumerate(new_to_old)}
