+        "integer index range and disjointness checks",
+        "exact integer addition",
+        "exact comparison with both bin capacities",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
