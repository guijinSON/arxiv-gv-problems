+            "word_operations": 0,
+            "reconstruction_masks": 0,
+            "target_state": None,
+        }
+    target = numerator // 2
+    if target < 0 or target > total:
+        return None, {
+            "wall_clock_sec": time.perf_counter() - start_time,
+            "word_operations": 0,
+            "reconstruction_masks": 0,
+            "target_state": target,
+        }
+
+    block_size = 12
+    ranges = [(i, min(i + block_size, len(differences)))
+              for i in range(0, len(differences), block_size)]
+    before = []
