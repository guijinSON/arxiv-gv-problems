#!/usr/bin/env bash
# Robust arXiv fetch (source preferred, PDF fallback). Usage: scripts/fetch_paper.sh <id> [dir]
set -uo pipefail
ID="${1:?usage: scripts/fetch_paper.sh <arxiv_id> [outdir]}"; OUT="${2:-.}"
UA="arxiv-gv-problems/1.0 (research; contact via repo issues)"
