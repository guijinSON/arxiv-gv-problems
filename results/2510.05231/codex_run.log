+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 3, "max_num": 16, "max_den": 3},
+    "easy": {"n": 31, "max_num": 512, "max_den": 5},
+    "medium": {"n": 63, "max_num": 1536, "max_den": 7},
