+# Filled from the script-owned transcripts after the three hardening runs.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 1, "attempts": 2},
+    "placebo": {"solved": 0, "attempts": 0},
