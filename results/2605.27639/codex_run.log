\subsection{A Circumcircle Approach to \texorpdfstring{$\theta$}{lg}-Congruent Numbers} Let $R$ be the circumradius of the triangle. For any triangle with sides $a,\,b,\, c$ and opposite angles $A,\, B,\, C$ then it is well known that $$\frac{a}{\sin A}=\frac{b}{\sin B}=\frac{c}{\sin C}=2R.$$ Equivalently, we have $c=2R\sin(\theta)$ if the angle  $\angle C=\theta$. Now by the law of cosines, $c^2=a^2+b^2-2ab\cos(\theta).$ Hence we have, $a^2+b^2-2ab\cos(\theta)= 4R^2\sin^2(\theta)$. Now define $$x:=\dfrac{a}{2R}, \quad y :=\dfrac{b}{2R}.$$  Hence from the law of cosines we have, $$4R^2x^2+4R^2y^2-8R^2xy\cos(\theta)= 4R^2\sin(\theta).$$
Dividing by $4R^2$ both sides, we have $x^2+y^2-2xy\cos(\theta)=\sin^2(\theta)$. So $(x,y)$ lies on the conic $$X^2+Y^2-2XY\cos(\theta)=\sin^2(\theta).$$ 

Recall that area $\mathcal{A}=\frac{1}{2}ab\sin(\theta)$ and substitute the value of $a=2Rx$, $b=2Ry$ we have, $\mathcal{A}= 2R^2xy\sin(\theta)$. Now if $\cos(\theta)=\frac{s}{r},$ where $0<|s|<r$ and $\gcd(r,s)=1$ then $$\sin(\theta)=\sqrt{1-\cos^2(\theta)}=\sqrt{1-\frac{s^2}{r^2}}=\frac{\sqrt{r^2-s^2}}{r}=\frac{\alpha_\theta}{r},$$ where $\alpha_\theta=\sqrt{r^2-s^2}.$ Hence, it follows that $\mathcal{A}=2R^2xy\frac{\alpha_\theta}{r}.$ Since $\mathcal{A}=n\alpha_\theta$
by definition of a $\theta$-congruent number, and
$\mathcal{A}=2R^2xy\frac{\alpha_\theta}{r},$
we obtain $n=\frac{2R^2xy}{r}$. Hence $n \equiv \frac{2xy}{r} \pmod {\Q^{\times 2}}$. Thus for a fixed $\theta$, the associated $\theta$-congruent number is determined, upto square factor, by the rational function $2xy$.


\begin{theorem}
    Let $\theta\in (0,\pi)$ and write $\cos(\theta)=\frac{s}{r},$ where $0<|s|<r$ and $\gcd(r,s)=1$ so that $\sin(\theta)=\frac{\alpha_\theta}{r}$, where $\alpha_\theta=\sqrt{r^2-s^2}$. Let $\triangle ABC$ be a triangle with sides $a,b,c$ such that the angle between $a$ and $b$ is $\theta$, and let $R$ be its circumradius. Define $x:=\dfrac{a}{2R}, \quad y :=\dfrac{b}{2R}$. Then $(x,y)$ lies on the conic $$X^2+Y^2-2XY\cos(\theta)=\sin^2(\theta).$$ Moreover, if $\mathcal{A}$ denotes the area of the triangle and $n$ is the associated $\theta$-congruent number defined by $\mathcal{A}=n\alpha_\theta$ then $$n \equiv \frac{2xy}{r} \pmod {\Q^{\times 2}}.$$

    In particular, for fixed $\theta$, the $\theta$-congruent number is determined up to squares by the rational function $\frac{2xy}{r}$.
\end{theorem}

\begin{corollary}
    Let $\theta=\frac{\pi}{2}$. Then $\cos(\theta
    )=0$, so $r=1$ and $\alpha_\theta=1$. The conic becomes $$X^2+Y^2=1.$$
    In this case, the $\theta$-congruent number reduces to the classical congruent number, and the area satisfies $$\mathcal{A}=\dfrac{ab}{2}.$$
    Hence,  $$n \equiv 2xy \pmod {\Q^{\times 2}},$$ 
    which is exactly the classical congruent number attached to the rational right triangle.

    Thus, the classical congruent number problem is recovered as the special case $\theta=\pi/2$ of the above construction.
\end{corollary}

\begin{corollary}
    Using the rational parametrization $\left(\dfrac{1-t^2}{1+t^2},\, \dfrac{2t}{1+t^2}  \right)$ of the unit circle for parameter $t > 0$, we obtain, $2xy=\dfrac{4t(1-t^2)}{(1+t^2)^2}$. Hence $2xy \equiv t(1-t^2) \pmod {\Q^{\times 2}}$. Consequently, the squarefree part of $t(1-t^2)$ is a classical congruent number.
\end{corollary}


