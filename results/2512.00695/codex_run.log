import random,time,statistics

def y_instance(r,seed):
    rng=random.Random(seed)
    base=[(i,j) for i in range(2*r) for j in range(3)]
    ids=list(range(6*r)); rng.shuffle(ids)
    lab=dict(zip(base,ids))
    edges=set()
    cyc=base
    for a,b in zip(cyc,cyc[1:]+cyc[:1]): edges.add(tuple(sorted((lab[a],lab[b]))))
    for i in range(2*r): edges.add(tuple(sorted((lab[(i,0)],lab[(i,2)]))))
    for i in range(r): edges.add(tuple(sorted((lab[(i,1)],lab[(i+r,1)]))))
    planted={tuple(sorted((lab[(i,1)],lab[(i+r,1)]))) for i in range(r)}
    planted|={tuple(sorted((lab[(i,2)],lab[((i+1)%(2*r),0)]))) for i in range(2*r)}
    return 6*r,edges,planted

def recover(n,edges):
    adj=[set() for _ in range(n)]
    ops=0
    for a,b in edges: adj[a].add(b); adj[b].add(a); ops+=2
    out=set()
    for a,b in edges:
        # detect whether edge lies in any triangle
        small,big=(adj[a],adj[b]) if len(adj[a])<=len(adj[b]) else (adj[b],adj[a])
        in_triangle=False
        for x in small:
            ops+=1
            if x in big:
                in_triangle=True;break
        if not in_triangle: out.add((a,b))
    return out,ops
for r in (2,4,8,16,20,32,40,42):
    times=[];ops=[];ok=0
    for seed in range(20):
        n,E,M=y_instance(r,seed)
        t=time.perf_counter(); R,c=recover(n,E); times.append(time.perf_counter()-t);ops.append(c);ok+=R==M
    print(f'r={r:2d} V={6*r:3d} E={len(E):3d} answer_atoms={6*r:3d} search=2"'^{r+1} ok={ok}/20 ops={max(ops)} wall_ms_median={1000*statistics.median(times):.4f}'"')
