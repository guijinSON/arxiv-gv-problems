from random import Random
from time import perf_counter

def fy(r):
    vs=[(i,j) for i in range(2*r) for j in range(3)]
    E=set()
    cyc=vs
    for a,b in zip(cyc,cyc[1:]+cyc[:1]): E.add(tuple(sorted((a,b))))
    for i in range(2*r): E.add(tuple(sorted(((i,0),(i,2)))))
    for i in range(r): E.add(tuple(sorted(((i,1),(i+r,1)))))
    return vs,E

def perfect_matchings(vs,E):
    adj={v:set() for v in vs}
    for a,b in E: adj[a].add(b); adj[b].add(a)
    def rec(rem):
        if not rem:
            yield (); return
        v=min(rem)
        for w in sorted(adj[v]&rem):
            for z in rec(rem-{v,w}): yield ((v,w),)+z
    yield from rec(set(vs))

def good_matching(m,E):
    # Remark 1: at most one complement edge joins each two matched classes.
    for i in range(len(m)):
      for j in range(i):
        if sum(tuple(sorted((x,y))) in E for x in m[i] for y in m[j])>1:
          return False
    return True

for r in range(2,9):
    vs,E=fy(r)
    pm=list(perfect_matchings(vs,E))
    good=sum(good_matching(m,E) for m in pm)
    print(r,len(vs),len(E),len(pm),good,2**(r+1))

costs=[]; times=[]
for seed in range(20):
    vs,E=fy(40)
    p=list(range(len(vs))); Random(seed).shuffle(p)
    ids={v:p[i] for i,v in enumerate(vs)}
    er=[tuple(sorted((ids[a],ids[b]))) for a,b in E]
    Random(seed+1000).shuffle(er)
    t0=perf_counter(); ops=0
    adj=[set() for _ in vs]
    for a,b in er:
        adj[a].add(b); adj[b].add(a); ops+=2
    out=[]
    for a,b in er:
        aa,bb=(adj[a],adj[b]) if len(adj[a])<=len(adj[b]) else (adj[b],adj[a])
        triangle=False
        for x in aa:
            ops+=1
            if x in bb:
                triangle=True; break
        if not triangle: out.append((a,b))
    elapsed=perf_counter()-t0
    assert len(out)==120 and len({x for e in out for x in e})==240
    costs.append(ops); times.append(elapsed)
print('cost min/median/max',min(costs),sorted(costs)[10],max(costs))
print('wall min/median/max',min(times),sorted(times)[10],max(times))
