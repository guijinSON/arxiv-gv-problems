+def _isqrt_with_count(value: int):
+    if value < 2:
+        return value, 1
+    x = 1 << ((value.bit_length() + 1) // 2)
+    operations = 1
+    while True:
+        y = (x + value // x) // 2
+        operations += 3
+        if y >= x:
+            return x, operations + 1
+        x = y
