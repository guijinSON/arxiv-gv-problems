+import copy
+import functools
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "The two neighboring-square gaps around k conceal an exact sixth-power relation."
+)
+PLACEBO_HINT: str = (
+    "The two signed coordinates in the answer require exact integer arithmetic throughout."
+)
+
