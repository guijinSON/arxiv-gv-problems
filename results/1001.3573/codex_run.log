+def _pow_with_count(base: int, exponent: int):
+    result = 1
+    factor = base
+    count = 0
+    e = exponent
+    while e:
+        if e & 1:
+            result *= factor
+            count += 1
+        e >>= 1
+        if e:
+            factor *= factor
+            count += 1
+    return result, count
+
