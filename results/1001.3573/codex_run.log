+    return None
+
+
+def _sign_transform(inst, sx, sy):
+    moved = copy.deepcopy(inst)
+    x, y = moved["answer"]
+    moved["answer"] = [sx * abs(x), sy * abs(y)]
+    return moved
+
+
+def _answer_atoms(value):
