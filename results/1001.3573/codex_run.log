+def _choose_parameter(n: int, rng: random.Random) -> int:
+    """Choose an even, non-round a well inside the stated X interval."""
+    lo = max(2, (58 * n + 99) // 100)
+    hi = max(lo, (92 * n) // 100)
+    even_lo = (lo + 1) // 2
