+        return value
+    lo, hi = 0, 1 << ((value.bit_length() + exponent - 1) // exponent)
+    while lo + 1 < hi:
+        mid = (lo + hi) // 2
+        if mid**exponent <= value:
+            lo = mid
+        else:
