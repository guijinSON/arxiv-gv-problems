+    operations += root_ops
+    x6, mults = _pow_with_count(x, 6)
+    operations += mults + 3
+    if x6 != sixth:
+        return None, operations
+    answer = [x, y]
+    if not verify(inst, answer)[0]:
+        return None, operations
+    return answer, operations
