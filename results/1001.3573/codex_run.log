+        mid = (lo + hi) // 2
+        power, multiplications = _pow_with_count(mid, exponent)
+        operations += 3 + multiplications  # add/divide, compare, power multiplies
+        if power <= value:
+            lo = mid
+        else:
+            hi = mid
+    return lo, operations
+
