+    "object_regime": "integer_lattice",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "genus-two curve C_k: Y^2 = X^6 + k over Q",
+        "bounded integral point on C_k",
+    ],
+    "verification_operations": [
