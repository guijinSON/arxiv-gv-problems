+
+def escalate(params):
+    """Double the height haystack while retaining a two-integer witness."""
+    if not isinstance(params, dict) or "n" not in params:
+        return None
+    n = params["n"]
+    if isinstance(n, bool) or not isinstance(n, int) or n < 6:
+        return None
