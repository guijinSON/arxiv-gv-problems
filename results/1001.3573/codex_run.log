+        "n": n,
+        "k": k,
+        "x_min_abs": 1,
+        "x_max_abs": n,
+        "y_min_abs": 1,
+        "y_max_abs": y_max,
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    """Render a self-contained exact Diophantine problem."""
+    statement = f"""Find one finite integral point on the curve
+
+    Y^2 = X^6 + k
+
+where
+
+    k = {inst['k']}
