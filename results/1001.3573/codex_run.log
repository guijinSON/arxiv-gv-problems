+
+def random_candidate(inst, rng):
+    """Sample the structure-aware finite language described above."""
+    x = rng.randint(inst["x_min_abs"], inst["x_max_abs"])
+    y = math.isqrt(inst["k"] + x**6)
+    if rng.getrandbits(1):
