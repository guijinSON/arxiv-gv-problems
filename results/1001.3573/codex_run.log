+    match = re.search(r"<answer\s*>(.*?)</answer\s*>", text, re.I | re.S)
+    if match is None:
+        return None
+    payload = match.group(1).strip()
+    fence = re.fullmatch(r"```(?:json|text)?\s*(.*?)\s*```", payload, re.I | re.S)
+    if fence is not None:
+        payload = fence.group(1).strip()
