+        plain = re.fullmatch(r"\s*([+-]?\d+)\s*,\s*([+-]?\d+)\s*", payload)
+        if plain is None:
+            return None
+        value = [int(plain.group(1)), int(plain.group(2))]
+    if not isinstance(value, list):
+        return None
+    return value
