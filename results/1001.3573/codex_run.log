+    modulus = _SIEVE_MODULUS
+    squares = {r * r % modulus for r in range(modulus)}
+    mask = bytearray(modulus)
+    for r in range(modulus):
+        mask[r] = (pow(r, 6, modulus) + k_mod) % modulus in squares
+    return bytes(mask)
