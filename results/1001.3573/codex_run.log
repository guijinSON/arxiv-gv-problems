+
+def _try_abs_x_values(inst, values):
+    for x in values:
+        if not isinstance(x, int) or not (1 <= x <= inst["x_max_abs"]):
+            continue
+        y = math.isqrt(inst["k"] + x**6)
+        if verify(inst, [x, y])[0]:
+            return [x, y]
+    return None
