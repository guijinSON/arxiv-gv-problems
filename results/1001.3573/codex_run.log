+def _integer_nth_root(value: int, exponent: int) -> int:
+    if value < 0 or exponent < 1:
+        raise ValueError("root arguments out of range")
+    if value < 2:
+        return value
+    lo, hi = 0, 1 << ((value.bit_length() + exponent - 1) // exponent)
+    while lo + 1 < hi:
+        mid = (lo + hi) // 2
+        if mid**exponent <= value:
+            lo = mid
+        else:
+            hi = mid
+    return lo
