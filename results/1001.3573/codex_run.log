+    response = (
+        "The exact substitution checks out.\n\n<answer>\n```json\n"
+        + json.dumps(inst["answer"])
+        + "\n```\n</answer>\nThat is my final point."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == inst["answer"],
+        "parsed": parsed,
+    }
