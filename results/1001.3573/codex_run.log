+        "carried_witness_checks": carried_checks,
+        "unrelated_distinct": distinct_keys,
+        "unrelated_attempts": 20,
+        "failures": g8_failures,
+        "method": "hash of k and absolute-coordinate bounds; X/Y sign involutions removed",
+    }
