def _is_prime(p: int) -> bool:
    if p < 2:
        return False
    if p % 2 == 0:
        return p == 2
    d = 3
    while d * d <= p:
        if p % d == 0:
            return False
        d += 2
    return True


def _prime_factors(x: int) -> list[int]:
    out: list[int] = []
    d = 2
    while d * d <= x:
        if x % d == 0:
            out.append(d)
            while x % d == 0:
                x //= d
        d += 1
    if x > 1:
        out.append(x)
    return out


def _primitive_roots(p: int) -> list[int]:
    factors = _prime_factors(p - 1)
    return [
        g for g in range(2, p)
        if all(pow(g, (p - 1) // q, p) != 1 for q in factors)
    ]


def _validate_params(n: int, decoy_degree: int) -> None:
    if isinstance(n, bool) or not isinstance(n, int):
        raise ValueError("n must be an integer")
    if isinstance(decoy_degree, bool) or not isinstance(decoy_degree, int):
        raise ValueError("decoy_degree must be an integer")
    if n < 6 or n % 2:
        raise ValueError("n must be an even integer at least 6")
    if not _is_prime(n + 1):
        raise ValueError("n+1 must be prime")
    if not 2 <= decoy_degree <= n // 2:
        raise ValueError("decoy_degree must lie in [2,n/2]")


def _pair_key(a: int, b: int) -> tuple[int, int]:
    return (a, b) if a < b else (b, a)


def _make_raw(n: int, seed: int, decoy_degree: int,
              redraw: int) -> dict:
    """One construction draw.  No answer search occurs here."""

    rng = random.Random((seed << 16) ^ (redraw * 0x9E3779B1) ^ n)
    p = n + 1
    roots = _primitive_roots(p)
    g = roots[rng.randrange(len(roots))]
    c = rng.randrange(1, p)
    cycle = []
    x = c
    for _ in range(n):
        cycle.append(x)
        x = (x * g) % p
    assert len(set(cycle)) == n and set(cycle) == set(range(1, p))

    m = n // 2
    left = cycle[0::2]
    right = cycle[1::2]

    # Each shift is a perfect matching.  Shift zero is the planted one, but its
    # edges have exactly the same public relation set as every decoy edge.
    shifts = [0] + rng.sample(range(1, m), decoy_degree - 1)
    eligible = {
        _pair_key(left[i], right[(i + shift) % m])
        for i in range(m) for shift in shifts
    }
    assert len(eligible) == m * decoy_degree

    precedence = (
        [(left[i], left[i + 1]) for i in range(m - 1)]
        + [(right[i], right[i + 1]) for i in range(m - 1)]
    )
    eligible_rows = [list(edge) for edge in eligible]
    eligible_masks = [0] * (n + 1)
    for a, b in eligible:
        eligible_masks[a] |= 1 << b
        eligible_masks[b] |= 1 << a
    precedence_rows = [list(edge) for edge in precedence]
    rng.shuffle(eligible_rows)
    rng.shuffle(precedence_rows)

    return {
        "family": "proper total ordering of pairs for partially ordered time",
        "n": n,
        "modulus": p,
        "decoy_degree": decoy_degree,
        "events": list(range(1, p)),
        "default_allowed": list(_DEFAULT),
        "incomparability_eligible": eligible_rows,
        # JSON-native derived index for fast exact grading.  render() presents
        # the equivalent pair list, so this adds no hidden instance data.
        "eligible_masks": eligible_masks,
        "precedence": precedence_rows,
        "answer": [sorted((left[i], right[i])) for i in range(m)],
    }


def _extract_chains(inst: dict, *, count_operations: bool = False
                    ) -> tuple[list[list[int]] | None, int]:
    """Recover the directed path components used by the Track-B reference."""

    events = set(inst["events"])
    succ: dict[int, int] = {}
    pred: dict[int, int] = {}
    touched: set[int] = set()
    ops = 0
    for row in inst["precedence"]:
        ops += 1
        if not (isinstance(row, list) and len(row) == 2):
            return None, ops
        u, v = row
        if u not in events or v not in events or u == v:
            return None, ops
        if u in succ or v in pred:
            return None, ops
        succ[u] = v
        pred[v] = u
        touched.update((u, v))

    starts = sorted(x for x in touched if x not in pred)
    ops += len(touched)
    chains: list[list[int]] = []
    seen: set[int] = set()
    for start in starts:
        chain = []
        x = start
        while x not in seen:
            chain.append(x)
            seen.add(x)
            ops += 1
            if x not in succ:
                break
            x = succ[x]
        chains.append(chain)
    if seen != events or len(chains) != 2:
        return None, ops
    chains.sort(key=lambda row: tuple(row))
    return chains, ops


def _greedy_chain_candidate(inst: dict) -> list[list[int]] | None:
    chains, _ = _extract_chains(inst)
    if chains is None or len(chains[0]) != len(chains[1]):
        return None
    eligible = {_pair_key(*edge) for edge in inst["incomparability_eligible"]}
    first, second = chains
    unused = set(second)
    answer: list[list[int]] = []
    for u in first:
        choices = sorted(v for v in unused if _pair_key(u, v) in eligible)
        if not choices:
            return None
        v = choices[0]
        unused.remove(v)
        answer.append(sorted((u, v)))
    return answer


