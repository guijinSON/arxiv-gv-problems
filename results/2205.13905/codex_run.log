def _is_int(value: object) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def _to_json_q(value: Fraction | int) -> list[int]:
    q = Fraction(value)
    return [q.numerator, q.denominator]


def _from_json_q(value: object) -> Fraction | None:
    if not isinstance(value, (list, tuple)) or len(value) != 2:
        return None
    a, b = value
    if not _is_int(a) or not _is_int(b) or b == 0:
        return None
    return Fraction(a, b)


def _degrees_for_n(n: int) -> tuple[int, int, int]:
    total = n + 4
    q, r = divmod(total, 3)
    ds = [q + (i < r) for i in range(3)]
    if min(ds) < 2:
        raise ValueError("n must be at least 2")
    if all(d % 2 for d in ds):
        # Keep the sum fixed while ensuring the product, hence each sign side,
        # is even.  For the only small case this maps (3,3,3) to (2,3,4).
        ds[0] -= 1
        ds[-1] += 1
    return tuple(sorted(ds))


def _validate_params(n: int, degrees: tuple[int, int, int] | list[int] | None,
                     root_bound: int, scale_num_bits: int,
                     scale_den_bits: int) -> tuple[int, int, int]:
    vals = (n, root_bound, scale_num_bits, scale_den_bits)
    if any(not _is_int(v) for v in vals):
        raise ValueError("n, root_bound, and scale bit bounds must be integers")
    if n < 2:
        raise ValueError("n must be at least 2")
    ds = _degrees_for_n(n) if degrees is None else tuple(degrees)
    if len(ds) != 3 or any(not _is_int(d) or d < 2 for d in ds):
        raise ValueError("degrees must contain three integers, each at least 2")
    ds = tuple(sorted(ds))
    if sum(ds) - 4 != n:
        raise ValueError("n must equal sum(degrees)-4")
    if math.prod(ds) % 2:
        raise ValueError("the grid size must be even")
    if root_bound < 1 or 2 * root_bound + 1 < max(ds):
        raise ValueError("root_bound is too small for distinct roots")
    if not 1 <= scale_num_bits <= 40 or not 1 <= scale_den_bits <= 24:
        raise ValueError("scale bit bounds are outside the supported range")
    return ds


def _derivatives(roots: list[int]) -> dict[int, int]:
    return {
        x: math.prod(x - y for y in roots if y != x)
        for x in roots
    }


def _primitive_relation(root_sets: list[list[int]]) -> list[tuple[list[int], int]]:
    derivs = [_derivatives(xs) for xs in root_sets]
    scales = []
    for table in derivs:
        scale = 1
        for value in table.values():
            scale = math.lcm(scale, abs(value))
        scales.append(scale)

    rows: list[tuple[list[int], int]] = []
    for x, y, z in itertools.product(*root_sets):
        coeff = (
            (scales[0] // derivs[0][x])
            * (scales[1] // derivs[1][y])
            * (scales[2] // derivs[2][z])
        )
        rows.append(([1, x, y, z], coeff))
    common = 0
    for _, coeff in rows:
        common = math.gcd(common, abs(coeff))
    return [(form, coeff // common) for form, coeff in rows]


def _sample_root_sets(rng: random.Random, degrees: tuple[int, int, int],
                      root_bound: int, require_distinct: bool
                      ) -> tuple[list[list[int]], list[tuple[list[int], int]]]:
    population = list(range(-root_bound, root_bound + 1))
    for _ in range(10_000):
        sets = [sorted(rng.sample(population, d)) for d in degrees]
        relation = _primitive_relation(sets)
        pos = [abs(c) for _, c in relation if c > 0]
        neg = [abs(c) for _, c in relation if c < 0]
        if len(pos) != len(neg):
            continue
        if require_distinct and (
            len(pos) != len(set(pos)) or len(neg) != len(set(neg))
        ):
            continue
        return sets, relation
    raise RuntimeError("could not sample roots satisfying certificate bounds")


