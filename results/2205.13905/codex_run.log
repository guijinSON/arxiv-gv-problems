+        "duplicate": [[base[0][0], base[0][0], base[0][2]],
+                      list(base[1]), list(base[2])],
+        "empty": [],
+        "out_of_range": [[len(inst["cards"]) + 1, base[0][1], base[0][2]],
+                         list(base[1]), list(base[2])],
