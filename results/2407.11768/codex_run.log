+            distances.append(sum(a != b for a, b in zip(output, inst["target"])))
+        bits[j] = 0 if distances[0] <= distances[1] else 1
+    return {"preimage": "".join(map(str, bits))}
+
+
+def _restart_attack(inst, rng):
