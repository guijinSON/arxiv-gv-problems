+
+def _gate_info(vertex, k):
+    if vertex[0] != "c":
+        return None
+    if vertex[2] == "g":
+        return vertex[1], vertex[3]
+    if vertex[2] == "v" and vertex[3] == k:
+        return vertex[1], 1
+    return None
+
+
+def _adjacent(inst, a, b):
