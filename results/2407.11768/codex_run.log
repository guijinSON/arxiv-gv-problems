+            distance = sum(a != b for a, b in zip(output, inst["target"]))
+            if distance == 0:
+                return {"preimage": "".join(map(str, bits))}
+            scored = []
+            for j in range(n):
+                bits[j] ^= 1
+                trial = _evaluate_circuit(inst, "".join(map(str, bits)))
+                bits[j] ^= 1
+                scored.append((sum(a != b for a, b in zip(trial, inst["target"])),
