+    pad_a, pad_b = n + 1, n + 2
+    next_wire = n + 3
+    gates = []
+    clauses = []
+    output_wires = []
+    for branch_offsets in branches:
+        state = list(range(1, n + 1))
+        for a_off, b_off, c_off in branch_offsets:
