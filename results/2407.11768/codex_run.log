# Candidate distribution, counting, and canonicalization

def random_candidate(inst, rng) -> object:
    """Uniformly sample the only free structural choice: the n-bit preimage."""
    return {"preimage": "".join(str(rng.randrange(2)) for _ in range(inst["n"]))}


def search_space(inst) -> int | None:
    return 1 << inst["n"]


def enumerate_all(inst) -> int | None:
    """Count preimages exactly with bit-parallel exhaustive evaluation."""
    n = inst["n"]
    if n > 22:
        return None
    count = 1 << n
    universe = (1 << count) - 1
    state = []
    for j in range(n):
        block = 1 << j
        period_mask = (1 << (2 * block)) - 1
        repeated = universe // period_mask
        state.append((repeated * ((1 << block) - 1)) << block)
    probe_ands = None
    probe_xors = None
    for round_number, (a_off, b_off, c_off) in enumerate(inst["offsets"], 1):
        old = state
        ands = [(old[(i + a_off) % n] & old[(i + b_off) % n])
                for i in range(n)]
        if round_number == 1:
            probe_ands = ands[:inst["probe_width"]]
        xors = [(old[i] ^ old[(i + c_off) % n]) for i in range(n)]
        if round_number == 1:
            probe_xors = xors[:inst["probe_width"]]
        state = [(xors[i] ^ ands[i]) for i in range(n)]
    survivors = universe
    for values, bit in zip(probe_ands + probe_xors + state, inst["target"]):
        survivors &= values if bit == "1" else universe ^ values
    return survivors.bit_count()


def _wl_invariant(n, clauses):
