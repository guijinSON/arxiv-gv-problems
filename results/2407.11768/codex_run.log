+def _cv(i, h):
+    return ("c", i, "v", h)
+
+
+def _gate(i, p, k):
+    return _cv(i, k) if p == 1 else ("c", i, "g", p)
+
+
+def _u(j, h):
+    return ("x", j, "u", h)
+
+
+def _s(j, b):
+    return ("x", j, "s", b)
