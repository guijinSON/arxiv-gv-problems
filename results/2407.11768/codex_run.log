+    changed = {key: value for key, value in inst.items()
+               if key not in ("answer", "clauses", "wire_to_var", "wire_flip")}
+    changed["clauses"] = records
+    changed["wire_to_var"] = [0] * (total + 1)
+    changed["wire_flip"] = [0] * (total + 1)
