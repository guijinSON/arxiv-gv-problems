new file mode 100644
index 0000000000000000000000000000000000000000..83e619fcd4fa9145cd0c22f4faed4f6d8553b3bd
--- /dev/null
+++ b/gen_2407_11768.py
@@ -0,0 +1,754 @@
+"""Verified inverse generator for arXiv:2407.11768.
+
+The generated task is the bounded-length k-Jump independent-set
+reconfiguration problem from Section 5 of the paper.  Instances are images of
+planted satisfiable E3-SAT formulae under the paper's reduction.  A submitted
+answer is a compact, canonical encoding of a complete reconfiguration sequence;
+the verifier expands it and replays every token move.
+
+Only the Python standard library is used.  Importing this module has no side
+effects.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import random
+import re
+from collections import Counter
+
+
+DIFFICULTY = {
+    # ``pair_factor`` counts complementary clause pairs per variable.  A pair
+    # (C, not-C) is exactly one NAE-3-SAT constraint and removes literal-sign
+    # marginal leakage from the planted assignment.
+    "demo": {"n": 8, "pair_factor": 2.0, "k": 3},
+    "easy": {"n": 32, "pair_factor": 3.5, "k": 3},
+    "medium": {"n": 64, "pair_factor": 4.0, "k": 3},
+    "hard": {"n": 96, "pair_factor": 4.5, "k": 3},
+}
+SHIPPING_DIFFICULTY = "medium"
+
+
+NOTES = r"""
+Definition source: Section 2, especially Definitions 1 and 2, fixes a k-Jump
+as the replacement of exactly one occupied vertex by one empty vertex at graph
+distance at most k, with both endpoints and all intermediate token sets
+independent.  Section 5.1 fixes the exact clause/variable gadgets reproduced by
+render(), and Lemma 12 in Section 5.2 proves that the constructed instance has
+a sequence of at most 2(m+n) moves iff the E3-SAT formula is satisfiable.
+
+Easy regimes avoided: Theorem 1 (Section 3) says reachability for every k >= 3
+is equivalent to unrestricted Token Jumping.  The introduction/Table 1 records
+polynomial-time reachability on even-hole-free, chordal, and split graphs; Table
+2 also records polynomial-time shortest reconfiguration for Token Jumping and
+for k-Jump on split graphs.  Consequently this generator asks for the bounded
+2(m+n)-move witness in the k >= 3, diameter 2k+1 chordal reduction class, not
+plain reachability and not an optimum.
+
+Planting hardening: a truth assignment is sampled before any clause.  Each
+random 3-variable constraint is emitted as a randomly ordered clause together
+with its complement, with the planted assignment NAE-satisfying the pair.  Thus
+positive/negative occurrence counts are exactly equal for every variable and
+the two complementary assignments are symmetric.  Clause order, literal order,
+variable names, and local polarities are randomized.  The outlier panel uses
+literal counts and mean positions, the greedy panel commits variables by local
+completed-clause score, and the restart panel uses bounded min-conflicts.  Full
+CDCL/SAT, spectral recovery, and exponential search are intentionally not
+claimed to have been defeated by the cheap panel; the required multi-vendor
+oracle loop is the separate empirical check.
+""".strip()
+
+
+def _literal_value(literal: int, bits: str | list[int]) -> int:
+    value = int(bits[abs(literal) - 1])
+    return value if literal > 0 else 1 - value
+
+
+def _choice_answer(clauses: list[list[int]], bits: str, rng=None) -> dict:
+    choices = []
+    for clause in clauses:
+        true_positions = [p for p, lit in enumerate(clause)
+                          if _literal_value(lit, bits)]
+        if true_positions:
+            choices.append(true_positions[0] if rng is None
+                           else rng.choice(true_positions))
+        else:
+            choices.append(0 if rng is None else rng.randrange(3))
+    return {"assignment": bits, "choices": choices}
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Sample a witness first, then construct a Section 5 reduction instance.
+
+    ``n`` is the number of variables.  ``pair_factor * n`` independently drawn
+    complementary clause pairs are used.  Increasing n at fixed factor grows
+    both the hidden assignment and the number of constraints linearly.
+    """
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4:
+        raise ValueError("n must be an integer at least 4")
+    k = params.pop("k", 3)
+    pair_factor = params.pop("pair_factor", 4.0)
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    if isinstance(k, bool) or not isinstance(k, int) or k < 3:
+        raise ValueError("k must be an integer at least 3")
+    if not isinstance(pair_factor, (int, float)) or pair_factor <= 0:
+        raise ValueError("pair_factor must be positive")
+
+    rng = random.Random(seed)
+
+    # G: sample the answer before constructing any problem constraint.
+    planted = [rng.randrange(2) for _ in range(n)]
+    bits = "".join(map(str, planted))
+
+    pair_count = int(math.ceil(float(pair_factor) * n))
+    capacity = 3 * math.comb(n, 3)
+    if pair_count > capacity:
+        raise ValueError("too many distinct clause pairs for n")
+
+    # A sign vector and its bitwise complement define the same NAE constraint.
+    # Of the four complement classes, exactly three are satisfied by the plant.
+    used = set()
+    pairs = []
+    attempts = 0
+    while len(pairs) < pair_count:
+        attempts += 1
+        if attempts > 1000 * pair_count + 1000:
+            raise RuntimeError("could not sample enough distinct constraints")
+        variables = tuple(sorted(rng.sample(range(n), 3)))
+        signs = tuple(rng.randrange(2) for _ in range(3))  # 1 means negated
+        values = tuple(planted[v] ^ signs[p] for p, v in enumerate(variables))
+        if values[0] == values[1] == values[2]:
+            continue
+        complement = tuple(1 - b for b in signs)
+        normalized = min(signs, complement)
+        key = (variables, normalized)
+        if key in used:
+            continue
+        used.add(key)
+        pair = []
+        for sign_vector in (signs, complement):
+            clause = [-(v + 1) if sign_vector[p] else v + 1
+                      for p, v in enumerate(variables)]
+            rng.shuffle(clause)
+            pair.append(clause)
+        pairs.append(pair)
+
+    clauses = [clause for pair in pairs for clause in pair]
+    rng.shuffle(clauses)
+    answer = _choice_answer(clauses, bits, rng)
+    m = len(clauses)
+    return {
+        "family": "bounded_k_jump_section5",
+        "n": n,
+        "m": m,
+        "k": k,
+        "pair_factor": float(pair_factor),
+        "clauses": clauses,
+        "move_limit": 2 * (m + n),
+        "logical_vertex_count": m * (2 * k + 3) + n * (k + 2),
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    """Render the complete implicit graph and the exact witness wire format."""
+    n, m, k = inst["n"], inst["m"], inst["k"]
+    clause_lines = []
+    for i, clause in enumerate(inst["clauses"]):
+        clause_lines.append(f"C{i}: " + " ".join(f"{x:+d}" for x in clause))
+    clauses = "\n".join(clause_lines)
+    return f"""Bounded-hop independent-set reconfiguration witness
+
+There are {n} Boolean variables x1,...,x{n} and {m} clauses.  A positive integer
++j is literal xj; a negative integer -j is literal NOT xj.  Every clause has
+exactly three distinct variables.  Clauses are indexed C0 through C{m - 1}; the
+three displayed positions in each clause are indexed 0, 1, 2 from left to right.
+
+The graph below is undirected, simple, and has no edges except those explicitly
+defined by these rules.  For every clause Ci create path vertices v(i,0),...,
+v(i,{2 * k}), with edges between consecutive path vertices.  Its three gate
+vertices are g(i,1)=v(i,{k}) plus new vertices g(i,0), g(i,2).  Join each of
+g(i,0) and g(i,2) to both v(i,{k - 1}) and v(i,{k + 1}).  Join every pair of
+distinct gate vertices g(i,p), g(i',p') over all clauses: all {3 * m} gates form
+one clique.
+
+For every variable xj create path vertices u(j,0),...,u(j,{k - 1}), with edges
+between consecutive path vertices, and create s(j,0), s(j,1), each adjacent to
+u(j,0).  Define t(j,0)=u(j,0) and t(j,1)=u(j,{k - 1}).  If the literal in
+position p of Ci is +j, join g(i,p) to s(j,0) and t(j,0).  If it is -j, join
+g(i,p) to s(j,1) and t(j,0).
+
+Initially tokens occupy every v(i,0) and both s(j,0),s(j,1).  The target has
+tokens on every v(i,{2 * k}) and both t(j,0),t(j,1).  A set of occupied vertices
+is independent when no two are adjacent.  One {k}-Jump move removes exactly one
+token and puts it on an empty vertex whose shortest-path distance from its old
+vertex is at most {k}; the resulting occupied set must again be independent.
+
+Your answer compactly encodes one complete sequence of exactly {inst['move_limit']}
+moves.  Give an assignment string of exactly {n} characters (character j-1 is
+xj, with 1=true and 0=false) and a list of exactly {m} gate choices in {{0,1,2}}.
+The checker expands it in this fixed order:
+
+1. For j=1,...,{n}, if xj=1 move s(j,0) to t(j,1); if xj=0 move s(j,1) to t(j,1).
+2. For i=0,...,{m - 1}, with listed choice p, move v(i,0) to g(i,p), then
+   g(i,p) to v(i,{2 * k}).
+3. For j=1,...,{n}, move the still-occupied one of s(j,0),s(j,1) to t(j,0).
+
+All indices and bounds are inclusive as displayed.  Tokens are indistinguishable;
+the order above is mandatory for this compact encoding.  The chosen literal in
+each clause must be true under the assignment, which makes the expanded moves
+legal.  The checker reconstructs the graph, expands the sequence, and replays
+every move; it does not compare against a planted answer.
+
+Clauses:
+{clauses}
+
+Give your final answer inside <answer></answer> tags, as one JSON object with
+exactly the keys "assignment" (a binary string) and "choices" (an integer list).
+Example: <answer>{{"assignment":"010","choices":[0,2]}}</answer>
+Output nothing else inside the tags."""
+
+
+def parse_answer(text) -> object | None:
+    """Extract the last well-formed JSON object found inside answer tags."""
+    if not isinstance(text, str):
+        return None
+    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text,
+                        flags=re.IGNORECASE | re.DOTALL)
+    for body in reversed(blocks):
+        cleaned = body.strip()
+        fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", cleaned,
+                             flags=re.IGNORECASE | re.DOTALL)
+        if fence:
+            cleaned = fence.group(1).strip()
+        try:
+            value = json.loads(cleaned)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continue
+        if isinstance(value, dict):
+            return value
+    return None
+
+
+# Vertices used only while checking.  Tuples make aliases exact and avoid any
+# dependence on display strings or on the planted witness.
+def _cv(i, h):
+    return ("c", i, "v", h)
+
+
+def _gate(i, p, k):
+    return _cv(i, k) if p == 1 else ("c", i, "g", p)
+
+
+def _u(j, h):
+    return ("x", j, "u", h)
+
+
+def _s(j, b):
+    return ("x", j, "s", b)
+
+
+def _gate_info(vertex, k):
+    if vertex[0] != "c":
+        return None
+    if vertex[2] == "g":
+        return vertex[1], vertex[3]
+    if vertex[2] == "v" and vertex[3] == k:
+        return vertex[1], 1
+    return None
+
+
+def _adjacent(inst, a, b) -> bool:
+    if a == b:
+        return False
+    k = inst["k"]
+    ga, gb = _gate_info(a, k), _gate_info(b, k)
+    if ga is not None and gb is not None:
+        return True
+
+    # Edges internal to one clause gadget.
+    if a[0] == b[0] == "c" and a[1] == b[1]:
+        if a[2] == b[2] == "v":
+            return abs(a[3] - b[3]) == 1
+        if ga is not None and b[2] == "v":
+            return ga[1] in (0, 2) and b[3] in (k - 1, k + 1)
+        if gb is not None and a[2] == "v":
+            return gb[1] in (0, 2) and a[3] in (k - 1, k + 1)
+
+    # Edges internal to one variable gadget.
+    if a[0] == b[0] == "x" and a[1] == b[1]:
+        if a[2] == b[2] == "u":
+            return abs(a[3] - b[3]) == 1
+        if a[2] == "s" and b[2] == "u":
+            return b[3] == 0
+        if b[2] == "s" and a[2] == "u":
+            return a[3] == 0
+
+    # Literal edges between a gate and its variable gadget.
+    if ga is not None and b[0] == "x":
+        i, p = ga
+        literal = inst["clauses"][i][p]
+        j, neg = abs(literal) - 1, literal < 0
+        return b == _u(j, 0) or b == _s(j, int(neg))
+    if gb is not None and a[0] == "x":
+        return _adjacent(inst, b, a)
+    return False
+
+
+def _initial_state(inst):
+    return ({_cv(i, 0) for i in range(inst["m"])} |
+            {_s(j, b) for j in range(inst["n"]) for b in (0, 1)})
+
+
+def _target_state(inst):
+    k = inst["k"]
+    return ({_cv(i, 2 * k) for i in range(inst["m"])} |
+            {_u(j, h) for j in range(inst["n"]) for h in (0, k - 1)})
+
+
+def _move_route(inst, source, destination):
+    """Return a concrete <=k-edge route for each canonical move."""
+    k = inst["k"]
+    if source[0] == "x" and source[2] == "s" and destination == _u(source[1], k - 1):
+        return [source] + [_u(source[1], h) for h in range(k)]
+    if source[0] == "x" and source[2] == "s" and destination == _u(source[1], 0):
+        return [source, destination]
+    if source[0] == "c" and source[2] == "v" and source[3] == 0:
+        i = source[1]
+        info = _gate_info(destination, k)
+        if info is not None and info[0] == i:
+            if info[1] == 1:
+                return [_cv(i, h) for h in range(k + 1)]
+            return [_cv(i, h) for h in range(k)] + [destination]
+    info = _gate_info(source, k)
+    if info is not None and destination == _cv(info[0], 2 * k):
+        i, p = info
+        if p == 1:
+            return [_cv(i, h) for h in range(k, 2 * k + 1)]
+        return [source] + [_cv(i, h) for h in range(k + 1, 2 * k + 1)]
+    return None
+
+
+def _is_independent(inst, state) -> bool:
+    values = list(state)
+    for i, a in enumerate(values):
+        for b in values[i + 1:]:
+            if _adjacent(inst, a, b):
+                return False
+    return True
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Expand and exactly replay any answer in the advertised canonical form."""
+    # Deliberately never inspect inst["answer"].
+    if answer is None:
+        return False, "answer is absent"
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer is an empty object"
+    if set(answer) != {"assignment", "choices"}:
+        return False, "answer must contain exactly assignment and choices"
+
+    bits = answer["assignment"]
+    choices = answer["choices"]
+    if not isinstance(bits, str):
+        return False, "assignment must be a binary string"
+    if len(bits) != inst["n"]:
+        return False, f"assignment has length {len(bits)}, expected {inst['n']}"
+    if any(bit not in "01" for bit in bits):
+        return False, "assignment contains a non-binary character"
+    if not isinstance(choices, list):
+        return False, "choices must be a JSON list"
+    if len(choices) < inst["m"]:
+        return False, f"choices has too few entries: {len(choices)} < {inst['m']}"
+    if len(choices) > inst["m"]:
+        return False, f"choices has too many entries: {len(choices)} > {inst['m']}"
+    for i, choice in enumerate(choices):
+        if isinstance(choice, bool) or not isinstance(choice, int):
+            return False, f"choices[{i}] is not an integer"
+        if choice not in (0, 1, 2):
+            return False, f"choices[{i}] is outside 0..2"
+        if not _literal_value(inst["clauses"][i][choice], bits):
+            return False, f"clause C{i}: chosen literal is false"
+
+    state = _initial_state(inst)
+    if not _is_independent(inst, state):
+        return False, "internal instance error: initial set is not independent"
+
+    moves = []
+    for j, bit in enumerate(bits):
+        moves.append((_s(j, 0 if bit == "1" else 1), _u(j, inst["k"] - 1)))
+    for i, choice in enumerate(choices):
+        g = _gate(i, choice, inst["k"])
+        moves.extend(((_cv(i, 0), g), (g, _cv(i, 2 * inst["k"]))))
+    for j, bit in enumerate(bits):
+        moves.append((_s(j, 1 if bit == "1" else 0), _u(j, 0)))
+
+    if len(moves) != inst["move_limit"]:
+        return False, "internal expansion produced the wrong move count"
+    for move_number, (source, destination) in enumerate(moves, 1):
+        if source not in state:
+            return False, f"move {move_number}: source is unoccupied"
+        if destination in state:
+            return False, f"move {move_number}: destination is occupied"
+        route = _move_route(inst, source, destination)
+        if (route is None or route[0] != source or route[-1] != destination or
+                len(route) - 1 > inst["k"] or
+                any(not _adjacent(inst, a, b) for a, b in zip(route, route[1:]))):
+            return False, f"move {move_number}: endpoints are farther than k"
+        remaining = state - {source}
+        if any(_adjacent(inst, destination, other) for other in remaining):
+            return False, f"move {move_number}: resulting set is not independent"
+        state = remaining | {destination}
+
+    if state != _target_state(inst):
+        return False, "expanded sequence does not end at the target set"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Sample a structure-aware candidate, not a uniform syntactic JSON value.
+
+    The sampler chooses a uniform assignment and then, wherever possible,
+    chooses only a literal made true by that assignment.  Thus it gives a guesser
+    clause arity, sequence shape, gate range, and locally deducible gate choices
+    for free.  It is independent of the planted answer.
+    """
+    bits = "".join(str(rng.randrange(2)) for _ in range(inst["n"]))
+    return _choice_answer(inst["clauses"], bits, rng)
+
+
+def search_space(inst) -> int | None:
+    """Number of syntactically shaped assignment/gate-choice encodings."""
+    return (1 << inst["n"]) * pow(3, inst["m"])
+
+
+def enumerate_all(inst) -> int | None:
+    """Brute-force the exact number of accepted compact witnesses when small."""
+    n, m = inst["n"], inst["m"]
+    if n > 18 or (1 << n) * m > 8_000_000:
+        return None
+    total = 0
+    for mask in range(1 << n):
+        bits = format(mask, f"0{n}b")
+        multiplicity = 1
+        for clause in inst["clauses"]:
+            count = sum(_literal_value(lit, bits) for lit in clause)
+            if count == 0:
+                multiplicity = 0
+                break
+            multiplicity *= count
+        total += multiplicity
+    return total
+
+
+def _wl_invariant(n, clauses):
+    """A label-free color-refinement invariant of signed formula incidence."""
+    # Per variable: one hub and two initially indistinguishable literal nodes.
+    # Local sign flips are therefore graph isomorphisms, as in the reduction.
+    count = 3 * n + len(clauses)
+    neighbors = [[] for _ in range(count)]
+    edges = []
+
+    def add(a, b):
+        neighbors[a].append(b)
+        neighbors[b].append(a)
+        edges.append((a, b))
+
+    for j in range(n):
+        add(j, n + 2 * j)
+        add(j, n + 2 * j + 1)
+    for i, clause in enumerate(clauses):
+        cnode = 3 * n + i
+        for literal in clause:
+            j = abs(literal) - 1
+            neg = int(literal < 0)
+            add(cnode, n + 2 * j + neg)
+
+    colors = [0] * n + [1] * (2 * n) + [2] * len(clauses)
+    for _ in range(count + 1):
+        signatures = [(colors[v], tuple(sorted(colors[w] for w in neighbors[v])))
+                      for v in range(count)]
+        palette = {sig: c for c, sig in enumerate(sorted(set(signatures)))}
+        new_colors = [palette[sig] for sig in signatures]
+        if new_colors == colors or len(set(new_colors)) == len(set(colors)):
+            colors = new_colors
+            break
+        colors = new_colors
+
+    hist = sorted(Counter(colors).items())
+    quotient = Counter()
+    for a, b in edges:
+        quotient[tuple(sorted((colors[a], colors[b])))] += 1
+    return {"hist": hist, "edges": sorted((list(k), v) for k, v in quotient.items())}
+
+
+def canonical_key(inst) -> str:
+    """Return a structural invariant under reduction-graph relabellings.
+
+    Signed-formula/reduction-graph isomorphism is graph-isomorphism-hard in
+    general.  This deliberately uses a strong cheap invariant (stable color
+    refinement of the signed incidence graph), not the seed or rendered text.
+    Collisions are possible and are documented in README.md.
+    """
+    payload = {
+        "family": "section5-reduction",
+        "k": inst["k"],
+        "move_limit": inst["move_limit"],
+        "invariant": _wl_invariant(inst["n"], inst["clauses"]),
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params) -> dict | None:
+    """Grow the hidden assignment and constraint count at fixed planted law."""
+    if "n" not in params:
+        return None
+    result = dict(params)
+    result["n"] = int(params["n"]) + max(24, int(params["n"]) // 2)
+    result["pair_factor"] = min(6.0, float(params.get("pair_factor", 4.0)) + 0.25)
+    return result
+
+
+def _transform_for_g8(inst, rng):
+    """Compose variable renaming, local flips, literal order, and clause order."""
+    n = inst["n"]
+    permutation = list(range(n))
+    rng.shuffle(permutation)  # old variable -> new variable
+    flips = [rng.randrange(2) for _ in range(n)]
+
+    old_bits = inst["answer"]["assignment"]
+    new_bits = [None] * n
+    for old, new in enumerate(permutation):
+        new_bits[new] = str(int(old_bits[old]) ^ flips[old])
+
+    records = []
+    for clause, old_choice in zip(inst["clauses"], inst["answer"]["choices"]):
+        transformed = []
+        for literal in clause:
+            old = abs(literal) - 1
+            neg = int(literal < 0) ^ flips[old]
+            transformed.append(-(permutation[old] + 1) if neg else permutation[old] + 1)
+        order = [0, 1, 2]
+        rng.shuffle(order)
+        records.append(([transformed[p] for p in order], order.index(old_choice)))
+    rng.shuffle(records)
+
+    changed = {key: value for key, value in inst.items() if key != "answer"}
+    changed["clauses"] = [record[0] for record in records]
+    changed["answer"] = {
+        "assignment": "".join(new_bits),
+        "choices": [record[1] for record in records],
+    }
+    return changed
+
+
+def _greedy_attack(inst):
+    n = inst["n"]
+    occurrences = [[] for _ in range(n)]
+    for i, clause in enumerate(inst["clauses"]):
+        for literal in clause:
+            occurrences[abs(literal) - 1].append(i)
+    order = sorted(range(n), key=lambda j: (-len(occurrences[j]), j))
+    partial = [None] * n
+    for j in order:
+        scores = []
+        for value in (0, 1):
+            partial[j] = value
+            bad = 0
+            for i in occurrences[j]:
+                clause = inst["clauses"][i]
+                variables = [abs(lit) - 1 for lit in clause]
+                if all(partial[v] is not None for v in variables):
+                    if not any((partial[abs(lit) - 1] if lit > 0
+                                else 1 - partial[abs(lit) - 1]) for lit in clause):
+                        bad += 1
+            scores.append(bad)
+            partial[j] = None
+        partial[j] = 0 if scores[0] <= scores[1] else 1
+    bits = "".join(map(str, partial))
+    return _choice_answer(inst["clauses"], bits)
+
+
+def _outlier_attack(inst):
+    n = inst["n"]
+    pos_positions = [[] for _ in range(n)]
+    neg_positions = [[] for _ in range(n)]
+    for i, clause in enumerate(inst["clauses"]):
+        for literal in clause:
+            (pos_positions if literal > 0 else neg_positions)[abs(literal) - 1].append(i)
+    # Counts tie exactly by construction.  Mean input position is the remaining
+    # cheap per-variable statistic and is independent of the hidden bit.
+    bits = []
+    for pos, neg in zip(pos_positions, neg_positions):
+        pos_mean = sum(pos) / len(pos) if pos else -1.0
+        neg_mean = sum(neg) / len(neg) if neg else -1.0
+        bits.append("1" if pos_mean > neg_mean else "0")
+    return _choice_answer(inst["clauses"], "".join(bits))
+
+
+def _restart_attack(inst, rng):
+    n = inst["n"]
+    clauses = inst["clauses"]
+    for _ in range(4):
+        bits = [rng.randrange(2) for _ in range(n)]
+        for _step in range(8 * n):
+            bad = [i for i, clause in enumerate(clauses)
+                   if not any((bits[abs(lit) - 1] if lit > 0
+                               else 1 - bits[abs(lit) - 1]) for lit in clause)]
+            if not bad:
+                return _choice_answer(clauses, "".join(map(str, bits)))
+            clause = clauses[rng.choice(bad)]
+            candidates = sorted({abs(lit) - 1 for lit in clause})
+            scored = []
+            for j in candidates:
+                bits[j] ^= 1
+                score = sum(1 for c in clauses
+                            if not any((bits[abs(lit) - 1] if lit > 0
+                                        else 1 - bits[abs(lit) - 1]) for lit in c))
+                bits[j] ^= 1
+                scored.append((score, rng.random(), j))
+            bits[min(scored)[2]] ^= 1
+        candidate = _choice_answer(clauses, "".join(map(str, bits)))
+        if verify(inst, candidate)[0]:
+            return candidate
+    return _choice_answer(clauses, "".join(map(str, bits)))
+
+
+def selftest() -> dict:
+    """Run G1--G8 and return a JSON-serializable measured report."""
+    report = {}
+
+    g1_total = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7, 101):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_total += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": why})
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures, "verified": g1_total, "failures": g1_failures}
+
+    params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=314159, **params)
+    base = inst["answer"]
+    corruptions = {}
+    dropped = {"assignment": base["assignment"], "choices": base["choices"][:-1]}
+    duplicated = {"assignment": base["assignment"],
+                  "choices": base["choices"] + [base["choices"][-1]]}
+    swapped = {"assignment": base["choices"], "choices": base["assignment"]}
+    out_range = {"assignment": base["assignment"], "choices": list(base["choices"])}
+    out_range["choices"][0] = 3
+    cases = {"drop_one": dropped, "swap_fields": swapped,
+             "duplicate_one": duplicated, "empty": {}, "out_of_range": out_range}
+    for name, candidate in cases.items():
+        ok, why = verify(inst, candidate)
+        corruptions[name] = {"rejected": not ok, "reason": why}
+    reasons = [item["reason"] for item in corruptions.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(x["rejected"] for x in corruptions.values()) and
+                len(set(reasons)) == len(reasons),
+        "cases": corruptions, "distinct_reasons": len(set(reasons))}
+
+    wire = json.dumps(base, separators=(",", ":"))
+    response = ("I used the clause gates to encode the path.\n```json\n"
+                f"<answer>{wire}</answer>\n```\nThis is my final witness.")
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == base, "parsed_equal": parsed == base,
+        "garbage_returns_none": parse_answer("not an answer") is None}
+
+    trials = 200_000
+    hits = 0
+    guess_rng = random.Random(20240711768)
+    for _ in range(trials):
+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            hits += 1
+    probability = hits / trials
+    report["G4_guess_resistance"] = {
+        "pass": probability < 1e-6, "hits": hits, "total": trials,
+        "measured_probability": probability,
+        "sampler": "uniform assignment; true gate chosen whenever available",
+        "naive_search_space": search_space(inst)}
+
+    demo = make_instance(seed=2718, **DIFFICULTY["demo"])
+    exact = enumerate_all(demo)
+    space = search_space(demo)
+    fraction = exact / space if exact is not None else None
+    report["G5_sparse"] = {
+        "pass": exact is not None and fraction < 1e-6,
+        "preset": "demo", "valid_answers": exact,
+        "syntactic_search_space": space, "fraction": fraction}
+
+    attack_rows = {"outlier": [], "greedy": [], "random_restart": []}
+    attack_hits = Counter()
+    for seed in range(800, 808):
+        attacked = make_instance(seed=seed, **params)
+        candidates = {
+            "outlier": _outlier_attack(attacked),
+            "greedy": _greedy_attack(attacked),
+            "random_restart": _restart_attack(attacked, random.Random(seed ^ 0xBAD5EED)),
+        }
+        for name, candidate in candidates.items():
+            ok, why = verify(attacked, candidate)
+            attack_hits[name] += int(ok)
+            attack_rows[name].append({"seed": seed, "solved": ok, "reason": why})
+    report["G6_adversary_panel"] = {
+        "pass": all(attack_hits[name] == 0 for name in attack_rows),
+        "seeds_per_attack": 8, "hits": dict(attack_hits), "results": attack_rows}
+
+    doubled_params = dict(params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=424242, **doubled_params)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] == 2 * inst["n"] and
+                doubled["move_limit"] > inst["move_limit"],
+        "base_n": inst["n"], "doubled_n": doubled["n"],
+        "base_moves": inst["move_limit"], "doubled_moves": doubled["move_limit"],
+        "doubled_verify_reason": doubled_why}
+
+    invariance = 0
+    real_maps = 0
+    invariant_failures = []
+    for seed in range(20):
+        original = make_instance(seed=10_000 + seed, **DIFFICULTY["easy"])
+        transformed = _transform_for_g8(original, random.Random(90_000 + seed))
+        same = canonical_key(original) == canonical_key(transformed)
+        carried_ok, carried_why = verify(transformed, transformed["answer"])
+        invariance += int(same)
+        real_maps += int(carried_ok)
+        if not same or not carried_ok:
+            invariant_failures.append({"seed": seed, "same_key": same,
+                                       "carried_answer": carried_ok,
+                                       "reason": carried_why})
+    unrelated = [canonical_key(make_instance(seed=20_000 + seed,
+                                              **DIFFICULTY["easy"]))
+                 for seed in range(20)]
+    distinct = len(set(unrelated))
+    report["G8_canonical_key"] = {
+        "pass": invariance == 20 and real_maps == 20 and distinct == 20,
+        "invariance_passed": invariance, "invariance_total": 20,
+        "real_transform_answers_verified": real_maps,
+        "real_transform_total": 20,
+        "unrelated_distinct": distinct, "unrelated_total": 20,
+        "transformations": ["variable renaming", "local polarity flips",
+                            "literal reordering", "clause/input reordering"],
+        "failures": invariant_failures}
+
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["all_passed"] = all(value.get("pass", False) for key, value in report.items()
+                                  if key.startswith("G"))
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

diff --git a/gen_2407_11768.py b/gen_2407_11768.py
new file mode 100644
index 0000000000000000000000000000000000000000..83e619fcd4fa9145cd0c22f4faed4f6d8553b3bd
--- /dev/null
+++ b/gen_2407_11768.py
@@ -0,0 +1,754 @@
+"""Verified inverse generator for arXiv:2407.11768.
+
+The generated task is the bounded-length k-Jump independent-set
+reconfiguration problem from Section 5 of the paper.  Instances are images of
+planted satisfiable E3-SAT formulae under the paper's reduction.  A submitted
+answer is a compact, canonical encoding of a complete reconfiguration sequence;
+the verifier expands it and replays every token move.
+
+Only the Python standard library is used.  Importing this module has no side
+effects.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import random
+import re
+from collections import Counter
+
+
+DIFFICULTY = {
+    # ``pair_factor`` counts complementary clause pairs per variable.  A pair
+    # (C, not-C) is exactly one NAE-3-SAT constraint and removes literal-sign
+    # marginal leakage from the planted assignment.
+    "demo": {"n": 8, "pair_factor": 2.0, "k": 3},
+    "easy": {"n": 32, "pair_factor": 3.5, "k": 3},
+    "medium": {"n": 64, "pair_factor": 4.0, "k": 3},
+    "hard": {"n": 96, "pair_factor": 4.5, "k": 3},
+}
+SHIPPING_DIFFICULTY = "medium"
+
+
+NOTES = r"""
+Definition source: Section 2, especially Definitions 1 and 2, fixes a k-Jump
+as the replacement of exactly one occupied vertex by one empty vertex at graph
+distance at most k, with both endpoints and all intermediate token sets
+independent.  Section 5.1 fixes the exact clause/variable gadgets reproduced by
+render(), and Lemma 12 in Section 5.2 proves that the constructed instance has
+a sequence of at most 2(m+n) moves iff the E3-SAT formula is satisfiable.
+
+Easy regimes avoided: Theorem 1 (Section 3) says reachability for every k >= 3
+is equivalent to unrestricted Token Jumping.  The introduction/Table 1 records
+polynomial-time reachability on even-hole-free, chordal, and split graphs; Table
+2 also records polynomial-time shortest reconfiguration for Token Jumping and
+for k-Jump on split graphs.  Consequently this generator asks for the bounded
+2(m+n)-move witness in the k >= 3, diameter 2k+1 chordal reduction class, not
+plain reachability and not an optimum.
+
+Planting hardening: a truth assignment is sampled before any clause.  Each
+random 3-variable constraint is emitted as a randomly ordered clause together
+with its complement, with the planted assignment NAE-satisfying the pair.  Thus
+positive/negative occurrence counts are exactly equal for every variable and
+the two complementary assignments are symmetric.  Clause order, literal order,
+variable names, and local polarities are randomized.  The outlier panel uses
+literal counts and mean positions, the greedy panel commits variables by local
+completed-clause score, and the restart panel uses bounded min-conflicts.  Full
+CDCL/SAT, spectral recovery, and exponential search are intentionally not
+claimed to have been defeated by the cheap panel; the required multi-vendor
+oracle loop is the separate empirical check.
+""".strip()
+
+
+def _literal_value(literal: int, bits: str | list[int]) -> int:
+    value = int(bits[abs(literal) - 1])
+    return value if literal > 0 else 1 - value
+
+
+def _choice_answer(clauses: list[list[int]], bits: str, rng=None) -> dict:
+    choices = []
+    for clause in clauses:
+        true_positions = [p for p, lit in enumerate(clause)
+                          if _literal_value(lit, bits)]
+        if true_positions:
+            choices.append(true_positions[0] if rng is None
+                           else rng.choice(true_positions))
+        else:
+            choices.append(0 if rng is None else rng.randrange(3))
+    return {"assignment": bits, "choices": choices}
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Sample a witness first, then construct a Section 5 reduction instance.
+
+    ``n`` is the number of variables.  ``pair_factor * n`` independently drawn
+    complementary clause pairs are used.  Increasing n at fixed factor grows
+    both the hidden assignment and the number of constraints linearly.
+    """
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4:
+        raise ValueError("n must be an integer at least 4")
+    k = params.pop("k", 3)
+    pair_factor = params.pop("pair_factor", 4.0)
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    if isinstance(k, bool) or not isinstance(k, int) or k < 3:
+        raise ValueError("k must be an integer at least 3")
+    if not isinstance(pair_factor, (int, float)) or pair_factor <= 0:
+        raise ValueError("pair_factor must be positive")
+
+    rng = random.Random(seed)
+
+    # G: sample the answer before constructing any problem constraint.
+    planted = [rng.randrange(2) for _ in range(n)]
+    bits = "".join(map(str, planted))
+
+    pair_count = int(math.ceil(float(pair_factor) * n))
+    capacity = 3 * math.comb(n, 3)
+    if pair_count > capacity:
+        raise ValueError("too many distinct clause pairs for n")
+
+    # A sign vector and its bitwise complement define the same NAE constraint.
+    # Of the four complement classes, exactly three are satisfied by the plant.
+    used = set()
+    pairs = []
+    attempts = 0
+    while len(pairs) < pair_count:
+        attempts += 1
+        if attempts > 1000 * pair_count + 1000:
+            raise RuntimeError("could not sample enough distinct constraints")
+        variables = tuple(sorted(rng.sample(range(n), 3)))
+        signs = tuple(rng.randrange(2) for _ in range(3))  # 1 means negated
+        values = tuple(planted[v] ^ signs[p] for p, v in enumerate(variables))
+        if values[0] == values[1] == values[2]:
+            continue
+        complement = tuple(1 - b for b in signs)
+        normalized = min(signs, complement)
+        key = (variables, normalized)
+        if key in used:
+            continue
+        used.add(key)
+        pair = []
+        for sign_vector in (signs, complement):
+            clause = [-(v + 1) if sign_vector[p] else v + 1
+                      for p, v in enumerate(variables)]
+            rng.shuffle(clause)
+            pair.append(clause)
+        pairs.append(pair)
+
+    clauses = [clause for pair in pairs for clause in pair]
+    rng.shuffle(clauses)
+    answer = _choice_answer(clauses, bits, rng)
+    m = len(clauses)
+    return {
+        "family": "bounded_k_jump_section5",
+        "n": n,
+        "m": m,
+        "k": k,
+        "pair_factor": float(pair_factor),
+        "clauses": clauses,
+        "move_limit": 2 * (m + n),
+        "logical_vertex_count": m * (2 * k + 3) + n * (k + 2),
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    """Render the complete implicit graph and the exact witness wire format."""
+    n, m, k = inst["n"], inst["m"], inst["k"]
+    clause_lines = []
+    for i, clause in enumerate(inst["clauses"]):
+        clause_lines.append(f"C{i}: " + " ".join(f"{x:+d}" for x in clause))
+    clauses = "\n".join(clause_lines)
+    return f"""Bounded-hop independent-set reconfiguration witness
+
+There are {n} Boolean variables x1,...,x{n} and {m} clauses.  A positive integer
++j is literal xj; a negative integer -j is literal NOT xj.  Every clause has
+exactly three distinct variables.  Clauses are indexed C0 through C{m - 1}; the
+three displayed positions in each clause are indexed 0, 1, 2 from left to right.
+
+The graph below is undirected, simple, and has no edges except those explicitly
+defined by these rules.  For every clause Ci create path vertices v(i,0),...,
+v(i,{2 * k}), with edges between consecutive path vertices.  Its three gate
+vertices are g(i,1)=v(i,{k}) plus new vertices g(i,0), g(i,2).  Join each of
+g(i,0) and g(i,2) to both v(i,{k - 1}) and v(i,{k + 1}).  Join every pair of
+distinct gate vertices g(i,p), g(i',p') over all clauses: all {3 * m} gates form
+one clique.
+
+For every variable xj create path vertices u(j,0),...,u(j,{k - 1}), with edges
+between consecutive path vertices, and create s(j,0), s(j,1), each adjacent to
+u(j,0).  Define t(j,0)=u(j,0) and t(j,1)=u(j,{k - 1}).  If the literal in
+position p of Ci is +j, join g(i,p) to s(j,0) and t(j,0).  If it is -j, join
+g(i,p) to s(j,1) and t(j,0).
+
+Initially tokens occupy every v(i,0) and both s(j,0),s(j,1).  The target has
+tokens on every v(i,{2 * k}) and both t(j,0),t(j,1).  A set of occupied vertices
+is independent when no two are adjacent.  One {k}-Jump move removes exactly one
+token and puts it on an empty vertex whose shortest-path distance from its old
+vertex is at most {k}; the resulting occupied set must again be independent.
+
+Your answer compactly encodes one complete sequence of exactly {inst['move_limit']}
+moves.  Give an assignment string of exactly {n} characters (character j-1 is
+xj, with 1=true and 0=false) and a list of exactly {m} gate choices in {{0,1,2}}.
+The checker expands it in this fixed order:
+
+1. For j=1,...,{n}, if xj=1 move s(j,0) to t(j,1); if xj=0 move s(j,1) to t(j,1).
+2. For i=0,...,{m - 1}, with listed choice p, move v(i,0) to g(i,p), then
+   g(i,p) to v(i,{2 * k}).
+3. For j=1,...,{n}, move the still-occupied one of s(j,0),s(j,1) to t(j,0).
+
+All indices and bounds are inclusive as displayed.  Tokens are indistinguishable;
+the order above is mandatory for this compact encoding.  The chosen literal in
+each clause must be true under the assignment, which makes the expanded moves
+legal.  The checker reconstructs the graph, expands the sequence, and replays
+every move; it does not compare against a planted answer.
+
+Clauses:
+{clauses}
+
+Give your final answer inside <answer></answer> tags, as one JSON object with
+exactly the keys "assignment" (a binary string) and "choices" (an integer list).
+Example: <answer>{{"assignment":"010","choices":[0,2]}}</answer>
+Output nothing else inside the tags."""
+
+
+def parse_answer(text) -> object | None:
+    """Extract the last well-formed JSON object found inside answer tags."""
+    if not isinstance(text, str):
+        return None
+    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text,
+                        flags=re.IGNORECASE | re.DOTALL)
+    for body in reversed(blocks):
+        cleaned = body.strip()
+        fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", cleaned,
+                             flags=re.IGNORECASE | re.DOTALL)
+        if fence:
+            cleaned = fence.group(1).strip()
+        try:
+            value = json.loads(cleaned)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continue
+        if isinstance(value, dict):
+            return value
+    return None
+
+
+# Vertices used only while checking.  Tuples make aliases exact and avoid any
+# dependence on display strings or on the planted witness.
+def _cv(i, h):
+    return ("c", i, "v", h)
+
+
+def _gate(i, p, k):
+    return _cv(i, k) if p == 1 else ("c", i, "g", p)
+
+
+def _u(j, h):
+    return ("x", j, "u", h)
+
+
+def _s(j, b):
+    return ("x", j, "s", b)
+
+
+def _gate_info(vertex, k):
+    if vertex[0] != "c":
+        return None
+    if vertex[2] == "g":
+        return vertex[1], vertex[3]
+    if vertex[2] == "v" and vertex[3] == k:
+        return vertex[1], 1
+    return None
+
+
+def _adjacent(inst, a, b) -> bool:
+    if a == b:
+        return False
+    k = inst["k"]
+    ga, gb = _gate_info(a, k), _gate_info(b, k)
+    if ga is not None and gb is not None:
+        return True
+
+    # Edges internal to one clause gadget.
+    if a[0] == b[0] == "c" and a[1] == b[1]:
+        if a[2] == b[2] == "v":
+            return abs(a[3] - b[3]) == 1
+        if ga is not None and b[2] == "v":
+            return ga[1] in (0, 2) and b[3] in (k - 1, k + 1)
+        if gb is not None and a[2] == "v":
+            return gb[1] in (0, 2) and a[3] in (k - 1, k + 1)
+
+    # Edges internal to one variable gadget.
+    if a[0] == b[0] == "x" and a[1] == b[1]:
+        if a[2] == b[2] == "u":
+            return abs(a[3] - b[3]) == 1
+        if a[2] == "s" and b[2] == "u":
+            return b[3] == 0
+        if b[2] == "s" and a[2] == "u":
+            return a[3] == 0
+
+    # Literal edges between a gate and its variable gadget.
+    if ga is not None and b[0] == "x":
+        i, p = ga
+        literal = inst["clauses"][i][p]
+        j, neg = abs(literal) - 1, literal < 0
+        return b == _u(j, 0) or b == _s(j, int(neg))
+    if gb is not None and a[0] == "x":
+        return _adjacent(inst, b, a)
+    return False
+
+
+def _initial_state(inst):
+    return ({_cv(i, 0) for i in range(inst["m"])} |
+            {_s(j, b) for j in range(inst["n"]) for b in (0, 1)})
+
+
+def _target_state(inst):
+    k = inst["k"]
+    return ({_cv(i, 2 * k) for i in range(inst["m"])} |
+            {_u(j, h) for j in range(inst["n"]) for h in (0, k - 1)})
+
+
+def _move_route(inst, source, destination):
+    """Return a concrete <=k-edge route for each canonical move."""
+    k = inst["k"]
+    if source[0] == "x" and source[2] == "s" and destination == _u(source[1], k - 1):
+        return [source] + [_u(source[1], h) for h in range(k)]
+    if source[0] == "x" and source[2] == "s" and destination == _u(source[1], 0):
+        return [source, destination]
+    if source[0] == "c" and source[2] == "v" and source[3] == 0:
+        i = source[1]
+        info = _gate_info(destination, k)
+        if info is not None and info[0] == i:
+            if info[1] == 1:
+                return [_cv(i, h) for h in range(k + 1)]
+            return [_cv(i, h) for h in range(k)] + [destination]
+    info = _gate_info(source, k)
+    if info is not None and destination == _cv(info[0], 2 * k):
+        i, p = info
+        if p == 1:
+            return [_cv(i, h) for h in range(k, 2 * k + 1)]
+        return [source] + [_cv(i, h) for h in range(k + 1, 2 * k + 1)]
+    return None
+
+
+def _is_independent(inst, state) -> bool:
+    values = list(state)
+    for i, a in enumerate(values):
+        for b in values[i + 1:]:
+            if _adjacent(inst, a, b):
+                return False
+    return True
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Expand and exactly replay any answer in the advertised canonical form."""
+    # Deliberately never inspect inst["answer"].
+    if answer is None:
+        return False, "answer is absent"
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer is an empty object"
+    if set(answer) != {"assignment", "choices"}:
+        return False, "answer must contain exactly assignment and choices"
+
+    bits = answer["assignment"]
+    choices = answer["choices"]
+    if not isinstance(bits, str):
+        return False, "assignment must be a binary string"
+    if len(bits) != inst["n"]:
+        return False, f"assignment has length {len(bits)}, expected {inst['n']}"
+    if any(bit not in "01" for bit in bits):
+        return False, "assignment contains a non-binary character"
+    if not isinstance(choices, list):
+        return False, "choices must be a JSON list"
+    if len(choices) < inst["m"]:
+        return False, f"choices has too few entries: {len(choices)} < {inst['m']}"
+    if len(choices) > inst["m"]:
+        return False, f"choices has too many entries: {len(choices)} > {inst['m']}"
+    for i, choice in enumerate(choices):
+        if isinstance(choice, bool) or not isinstance(choice, int):
+            return False, f"choices[{i}] is not an integer"
+        if choice not in (0, 1, 2):
+            return False, f"choices[{i}] is outside 0..2"
+        if not _literal_value(inst["clauses"][i][choice], bits):
+            return False, f"clause C{i}: chosen literal is false"
+
+    state = _initial_state(inst)
+    if not _is_independent(inst, state):
+        return False, "internal instance error: initial set is not independent"
+
+    moves = []
+    for j, bit in enumerate(bits):
+        moves.append((_s(j, 0 if bit == "1" else 1), _u(j, inst["k"] - 1)))
+    for i, choice in enumerate(choices):
+        g = _gate(i, choice, inst["k"])
+        moves.extend(((_cv(i, 0), g), (g, _cv(i, 2 * inst["k"]))))
+    for j, bit in enumerate(bits):
+        moves.append((_s(j, 1 if bit == "1" else 0), _u(j, 0)))
+
+    if len(moves) != inst["move_limit"]:
+        return False, "internal expansion produced the wrong move count"
+    for move_number, (source, destination) in enumerate(moves, 1):
+        if source not in state:
+            return False, f"move {move_number}: source is unoccupied"
+        if destination in state:
+            return False, f"move {move_number}: destination is occupied"
+        route = _move_route(inst, source, destination)
+        if (route is None or route[0] != source or route[-1] != destination or
+                len(route) - 1 > inst["k"] or
+                any(not _adjacent(inst, a, b) for a, b in zip(route, route[1:]))):
+            return False, f"move {move_number}: endpoints are farther than k"
+        remaining = state - {source}
+        if any(_adjacent(inst, destination, other) for other in remaining):
+            return False, f"move {move_number}: resulting set is not independent"
+        state = remaining | {destination}
+
+    if state != _target_state(inst):
+        return False, "expanded sequence does not end at the target set"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Sample a structure-aware candidate, not a uniform syntactic JSON value.
+
+    The sampler chooses a uniform assignment and then, wherever possible,
+    chooses only a literal made true by that assignment.  Thus it gives a guesser
+    clause arity, sequence shape, gate range, and locally deducible gate choices
+    for free.  It is independent of the planted answer.
+    """
+    bits = "".join(str(rng.randrange(2)) for _ in range(inst["n"]))
+    return _choice_answer(inst["clauses"], bits, rng)
+
+
+def search_space(inst) -> int | None:
+    """Number of syntactically shaped assignment/gate-choice encodings."""
+    return (1 << inst["n"]) * pow(3, inst["m"])
+
+
+def enumerate_all(inst) -> int | None:
+    """Brute-force the exact number of accepted compact witnesses when small."""
+    n, m = inst["n"], inst["m"]
+    if n > 18 or (1 << n) * m > 8_000_000:
+        return None
+    total = 0
+    for mask in range(1 << n):
+        bits = format(mask, f"0{n}b")
+        multiplicity = 1
+        for clause in inst["clauses"]:
+            count = sum(_literal_value(lit, bits) for lit in clause)
+            if count == 0:
+                multiplicity = 0
+                break
+            multiplicity *= count
+        total += multiplicity
+    return total
+
+
+def _wl_invariant(n, clauses):
+    """A label-free color-refinement invariant of signed formula incidence."""
+    # Per variable: one hub and two initially indistinguishable literal nodes.
+    # Local sign flips are therefore graph isomorphisms, as in the reduction.
+    count = 3 * n + len(clauses)
+    neighbors = [[] for _ in range(count)]
+    edges = []
+
+    def add(a, b):
+        neighbors[a].append(b)
+        neighbors[b].append(a)
+        edges.append((a, b))
+
+    for j in range(n):
+        add(j, n + 2 * j)
+        add(j, n + 2 * j + 1)
+    for i, clause in enumerate(clauses):
+        cnode = 3 * n + i
+        for literal in clause:
+            j = abs(literal) - 1
+            neg = int(literal < 0)
+            add(cnode, n + 2 * j + neg)
+
+    colors = [0] * n + [1] * (2 * n) + [2] * len(clauses)
+    for _ in range(count + 1):
+        signatures = [(colors[v], tuple(sorted(colors[w] for w in neighbors[v])))
+                      for v in range(count)]
+        palette = {sig: c for c, sig in enumerate(sorted(set(signatures)))}
+        new_colors = [palette[sig] for sig in signatures]
+        if new_colors == colors or len(set(new_colors)) == len(set(colors)):
+            colors = new_colors
+            break
+        colors = new_colors
+
+    hist = sorted(Counter(colors).items())
+    quotient = Counter()
+    for a, b in edges:
+        quotient[tuple(sorted((colors[a], colors[b])))] += 1
+    return {"hist": hist, "edges": sorted((list(k), v) for k, v in quotient.items())}
+
+
+def canonical_key(inst) -> str:
+    """Return a structural invariant under reduction-graph relabellings.
+
+    Signed-formula/reduction-graph isomorphism is graph-isomorphism-hard in
+    general.  This deliberately uses a strong cheap invariant (stable color
+    refinement of the signed incidence graph), not the seed or rendered text.
+    Collisions are possible and are documented in README.md.
+    """
+    payload = {
+        "family": "section5-reduction",
+        "k": inst["k"],
+        "move_limit": inst["move_limit"],
+        "invariant": _wl_invariant(inst["n"], inst["clauses"]),
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params) -> dict | None:
+    """Grow the hidden assignment and constraint count at fixed planted law."""
+    if "n" not in params:
+        return None
+    result = dict(params)
+    result["n"] = int(params["n"]) + max(24, int(params["n"]) // 2)
+    result["pair_factor"] = min(6.0, float(params.get("pair_factor", 4.0)) + 0.25)
+    return result
+
+
+def _transform_for_g8(inst, rng):
+    """Compose variable renaming, local flips, literal order, and clause order."""
+    n = inst["n"]
+    permutation = list(range(n))
+    rng.shuffle(permutation)  # old variable -> new variable
+    flips = [rng.randrange(2) for _ in range(n)]
+
+    old_bits = inst["answer"]["assignment"]
+    new_bits = [None] * n
+    for old, new in enumerate(permutation):
+        new_bits[new] = str(int(old_bits[old]) ^ flips[old])
+
+    records = []
+    for clause, old_choice in zip(inst["clauses"], inst["answer"]["choices"]):
+        transformed = []
+        for literal in clause:
+            old = abs(literal) - 1
+            neg = int(literal < 0) ^ flips[old]
+            transformed.append(-(permutation[old] + 1) if neg else permutation[old] + 1)
+        order = [0, 1, 2]
+        rng.shuffle(order)
+        records.append(([transformed[p] for p in order], order.index(old_choice)))
+    rng.shuffle(records)
+
+    changed = {key: value for key, value in inst.items() if key != "answer"}
+    changed["clauses"] = [record[0] for record in records]
+    changed["answer"] = {
+        "assignment": "".join(new_bits),
+        "choices": [record[1] for record in records],
+    }
+    return changed
+
+
+def _greedy_attack(inst):
+    n = inst["n"]
+    occurrences = [[] for _ in range(n)]
+    for i, clause in enumerate(inst["clauses"]):
+        for literal in clause:
+            occurrences[abs(literal) - 1].append(i)
+    order = sorted(range(n), key=lambda j: (-len(occurrences[j]), j))
+    partial = [None] * n
+    for j in order:
+        scores = []
+        for value in (0, 1):
+            partial[j] = value
+            bad = 0
+            for i in occurrences[j]:
+                clause = inst["clauses"][i]
+                variables = [abs(lit) - 1 for lit in clause]
+                if all(partial[v] is not None for v in variables):
+                    if not any((partial[abs(lit) - 1] if lit > 0
+                                else 1 - partial[abs(lit) - 1]) for lit in clause):
+                        bad += 1
+            scores.append(bad)
+            partial[j] = None
+        partial[j] = 0 if scores[0] <= scores[1] else 1
+    bits = "".join(map(str, partial))
+    return _choice_answer(inst["clauses"], bits)
+
+
+def _outlier_attack(inst):
+    n = inst["n"]
+    pos_positions = [[] for _ in range(n)]
+    neg_positions = [[] for _ in range(n)]
+    for i, clause in enumerate(inst["clauses"]):
+        for literal in clause:
+            (pos_positions if literal > 0 else neg_positions)[abs(literal) - 1].append(i)
+    # Counts tie exactly by construction.  Mean input position is the remaining
+    # cheap per-variable statistic and is independent of the hidden bit.
+    bits = []
+    for pos, neg in zip(pos_positions, neg_positions):
+        pos_mean = sum(pos) / len(pos) if pos else -1.0
+        neg_mean = sum(neg) / len(neg) if neg else -1.0
+        bits.append("1" if pos_mean > neg_mean else "0")
+    return _choice_answer(inst["clauses"], "".join(bits))
+
+
+def _restart_attack(inst, rng):
+    n = inst["n"]
+    clauses = inst["clauses"]
+    for _ in range(4):
+        bits = [rng.randrange(2) for _ in range(n)]
+        for _step in range(8 * n):
+            bad = [i for i, clause in enumerate(clauses)
+                   if not any((bits[abs(lit) - 1] if lit > 0
+                               else 1 - bits[abs(lit) - 1]) for lit in clause)]
+            if not bad:
+                return _choice_answer(clauses, "".join(map(str, bits)))
+            clause = clauses[rng.choice(bad)]
+            candidates = sorted({abs(lit) - 1 for lit in clause})
+            scored = []
+            for j in candidates:
+                bits[j] ^= 1
+                score = sum(1 for c in clauses
+                            if not any((bits[abs(lit) - 1] if lit > 0
+                                        else 1 - bits[abs(lit) - 1]) for lit in c))
+                bits[j] ^= 1
+                scored.append((score, rng.random(), j))
+            bits[min(scored)[2]] ^= 1
+        candidate = _choice_answer(clauses, "".join(map(str, bits)))
+        if verify(inst, candidate)[0]:
+            return candidate
+    return _choice_answer(clauses, "".join(map(str, bits)))
+
+
+def selftest() -> dict:
+    """Run G1--G8 and return a JSON-serializable measured report."""
+    report = {}
+
+    g1_total = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7, 101):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_total += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": why})
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures, "verified": g1_total, "failures": g1_failures}
+
+    params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=314159, **params)
+    base = inst["answer"]
+    corruptions = {}
+    dropped = {"assignment": base["assignment"], "choices": base["choices"][:-1]}
+    duplicated = {"assignment": base["assignment"],
+                  "choices": base["choices"] + [base["choices"][-1]]}
+    swapped = {"assignment": base["choices"], "choices": base["assignment"]}
+    out_range = {"assignment": base["assignment"], "choices": list(base["choices"])}
+    out_range["choices"][0] = 3
+    cases = {"drop_one": dropped, "swap_fields": swapped,
+             "duplicate_one": duplicated, "empty": {}, "out_of_range": out_range}
+    for name, candidate in cases.items():
+        ok, why = verify(inst, candidate)
+        corruptions[name] = {"rejected": not ok, "reason": why}
+    reasons = [item["reason"] for item in corruptions.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(x["rejected"] for x in corruptions.values()) and
+                len(set(reasons)) == len(reasons),
+        "cases": corruptions, "distinct_reasons": len(set(reasons))}
+
+    wire = json.dumps(base, separators=(",", ":"))
+    response = ("I used the clause gates to encode the path.\n```json\n"
+                f"<answer>{wire}</answer>\n```\nThis is my final witness.")
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == base, "parsed_equal": parsed == base,
+        "garbage_returns_none": parse_answer("not an answer") is None}
+
+    trials = 200_000
+    hits = 0
+    guess_rng = random.Random(20240711768)
+    for _ in range(trials):
+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            hits += 1
+    probability = hits / trials
+    report["G4_guess_resistance"] = {
+        "pass": probability < 1e-6, "hits": hits, "total": trials,
+        "measured_probability": probability,
+        "sampler": "uniform assignment; true gate chosen whenever available",
+        "naive_search_space": search_space(inst)}
+
+    demo = make_instance(seed=2718, **DIFFICULTY["demo"])
+    exact = enumerate_all(demo)
+    space = search_space(demo)
+    fraction = exact / space if exact is not None else None
+    report["G5_sparse"] = {
+        "pass": exact is not None and fraction < 1e-6,
+        "preset": "demo", "valid_answers": exact,
+        "syntactic_search_space": space, "fraction": fraction}
+
+    attack_rows = {"outlier": [], "greedy": [], "random_restart": []}
+    attack_hits = Counter()
+    for seed in range(800, 808):
+        attacked = make_instance(seed=seed, **params)
+        candidates = {
+            "outlier": _outlier_attack(attacked),
+            "greedy": _greedy_attack(attacked),
+            "random_restart": _restart_attack(attacked, random.Random(seed ^ 0xBAD5EED)),
+        }
+        for name, candidate in candidates.items():
+            ok, why = verify(attacked, candidate)
+            attack_hits[name] += int(ok)
+            attack_rows[name].append({"seed": seed, "solved": ok, "reason": why})
+    report["G6_adversary_panel"] = {
+        "pass": all(attack_hits[name] == 0 for name in attack_rows),
+        "seeds_per_attack": 8, "hits": dict(attack_hits), "results": attack_rows}
+
+    doubled_params = dict(params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=424242, **doubled_params)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] == 2 * inst["n"] and
+                doubled["move_limit"] > inst["move_limit"],
+        "base_n": inst["n"], "doubled_n": doubled["n"],
+        "base_moves": inst["move_limit"], "doubled_moves": doubled["move_limit"],
+        "doubled_verify_reason": doubled_why}
+
+    invariance = 0
+    real_maps = 0
+    invariant_failures = []
+    for seed in range(20):
+        original = make_instance(seed=10_000 + seed, **DIFFICULTY["easy"])
+        transformed = _transform_for_g8(original, random.Random(90_000 + seed))
+        same = canonical_key(original) == canonical_key(transformed)
+        carried_ok, carried_why = verify(transformed, transformed["answer"])
+        invariance += int(same)
+        real_maps += int(carried_ok)
+        if not same or not carried_ok:
+            invariant_failures.append({"seed": seed, "same_key": same,
+                                       "carried_answer": carried_ok,
+                                       "reason": carried_why})
+    unrelated = [canonical_key(make_instance(seed=20_000 + seed,
+                                              **DIFFICULTY["easy"]))
+                 for seed in range(20)]
+    distinct = len(set(unrelated))
+    report["G8_canonical_key"] = {
+        "pass": invariance == 20 and real_maps == 20 and distinct == 20,
+        "invariance_passed": invariance, "invariance_total": 20,
+        "real_transform_answers_verified": real_maps,
+        "real_transform_total": 20,
+        "unrelated_distinct": distinct, "unrelated_total": 20,
+        "transformations": ["variable renaming", "local polarity flips",
+                            "literal reordering", "clause/input reordering"],
+        "failures": invariant_failures}
+
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["all_passed"] = all(value.get("pass", False) for key, value in report.items()
+                                  if key.startswith("G"))
+    return report
