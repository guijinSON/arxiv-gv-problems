+# ---------------------------------------------------------------------------
+# Gate implementations
+
+def _transform_for_g8(inst, rng):
+    """Compose formula-variable renaming/polarity and all input reorderings."""
+    total = inst["formula_n"]
+    permutation = list(range(1, total + 1))
