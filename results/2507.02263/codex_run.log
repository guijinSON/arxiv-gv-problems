+    sizes, polynomial, witness_prime = _sample_sizes(n, k, rng)
+
+    classes = []
+    for cell, size in enumerate(sizes):
+        classes.extend([cell] * size)
+    rng.shuffle(classes)
+    rows = _rows_from_classes(classes)
