+def _decode_rows(inst):
+    order = inst.get("n")
+    encoded = inst.get("rows")
+    if not _is_int(order) or order < 1:
+        raise ValueError("instance order is malformed")
+    if not isinstance(encoded, list) or len(encoded) != order:
