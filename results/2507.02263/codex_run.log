+
+
+def _mod_trim(poly, prime):
+    return _trim([value % prime for value in poly])
+
+
+def _mod_divmod(a, b, prime):
+    a = _mod_trim(a, prime)
+    b = _mod_trim(b, prime)
+    if not b:
+        raise ZeroDivisionError
