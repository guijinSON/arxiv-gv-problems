+def _attack_candidates(inst, rng):
+    rows = _decode_rows(inst)
+    degrees = [row.bit_count() for row in rows]
+    degree_values = sorted(set(degrees))
+    k = inst["k"]
+    maximum_guess = 2 * max(degrees)
