+def _prime_divisors(value):
+    result = []
+    divisor = 2
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            result.append(divisor)
+            while value % divisor == 0:
+                value //= divisor
+        divisor += 1
+    if value > 1:
+        result.append(value)
