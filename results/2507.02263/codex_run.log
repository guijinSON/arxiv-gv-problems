+
+def _sample_part_sizes(total, part_count, rng):
+    if part_count < 3 or total < part_count * (part_count + 1) // 2:
+        raise ValueError(
+            "n must be large enough for at least three distinct positive part sizes"
+        )
+    minimum = max(1, total // (4 * part_count))
+    remainder = total - part_count * minimum
+    for _ in range(20_000):
+        raw = [rng.randrange(1, 1_000_001) for _ in range(part_count)]
+        raw_total = sum(raw)
+        allocated = [value * remainder // raw_total for value in raw]
+        left = remainder - sum(allocated)
+        order = sorted(
+            range(part_count),
+            key=lambda i: (raw[i] * remainder % raw_total, rng.random()),
+            reverse=True,
+        )
+        for index in order[:left]:
+            allocated[index] += 1
