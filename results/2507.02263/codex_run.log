+    "native_objects": [
+        "complete multipartite graph",
+        "signless Laplacian matrix",
+        "Perron root as a real algebraic number",
+    ],
+    "verification_operations": [
+        "exact adjacency-row comparison",
+        "integer polynomial multiplication",
+        "finite-field irreducibility test",
+        "Sturm root count over exact rationals",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "Equal adjacency rows are independent twin classes, so the dense "
+        "signless-Laplacian eigenproblem collapses to a small equitable "
+        "quotient; without recognizing those classes one must run an exact "
+        "spectral computation on the full matrix."
