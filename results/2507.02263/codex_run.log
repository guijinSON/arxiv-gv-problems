+        return value if isinstance(value, dict) else None
+    except Exception:
+        return None
+
+
+def _derive_part_sizes(inst):
+    n = inst.get("n")
+    rows = inst.get("adjacency_rows")
+    if not _is_int(n) or not isinstance(rows, list) or len(rows) != n:
+        raise ValueError("malformed graph data")
+    all_mask = (1 << n) - 1
+    masks = {}
+    for vertex, row in enumerate(rows):
+        if not _is_int(row) or row < 0 or row & ~all_mask:
+            raise ValueError("adjacency row outside the n-bit range")
+        masks[row] = masks.get(row, 0) | (1 << vertex)
+    if len(masks) != inst.get("parts"):
+        raise ValueError("wrong number of twin classes")
+    sizes = []
+    for row, group_mask in masks.items():
+        if row != (all_mask ^ group_mask):
+            raise ValueError("rows do not encode a complete multipartite graph")
+        sizes.append(group_mask.bit_count())
+    if len(set(sizes)) != len(sizes):
+        raise ValueError("part sizes are not distinct")
+    return sorted(sizes)
+
+
+def _fraction_pair(value):
+    if (
+        not isinstance(value, list)
+        or len(value) != 2
+        or not all(_is_int(item) for item in value)
+        or value[1] == 0
+    ):
+        raise ValueError("rational endpoint is not [integer, nonzero integer]")
+    return Fraction(value[0], value[1])
+
+
+def _fallback_normalize(poly):
+    return _trim([Fraction(value) for value in poly])
+
+
+def _fallback_eval(poly, point):
+    result = Fraction(0)
+    for coefficient in reversed(poly):
+        result = result * point + coefficient
+    return result
+
+
+def _fallback_divmod(a, b):
+    remainder = _fallback_normalize(a)
+    divisor = _fallback_normalize(b)
+    if not divisor:
+        raise ZeroDivisionError
+    quotient = [Fraction(0)] * max(0, len(remainder) - len(divisor) + 1)
+    while len(remainder) >= len(divisor) and remainder:
+        shift = len(remainder) - len(divisor)
+        factor = remainder[-1] / divisor[-1]
+        quotient[shift] = factor
+        for i, coefficient in enumerate(divisor):
+            remainder[i + shift] -= factor * coefficient
+        remainder = _fallback_normalize(remainder)
+    return _fallback_normalize(quotient), remainder
+
+
+def _fallback_sturm(poly):
+    p0 = _fallback_normalize(poly)
+    p1 = _fallback_normalize(
+        [index * p0[index] for index in range(1, len(p0))]
+    )
+    if len(p0) < 2:
+        raise ValueError("constant polynomial")
+    sequence = [p0, p1]
+    while len(sequence[-1]) > 1:
+        _, remainder = _fallback_divmod(sequence[-2], sequence[-1])
+        if not remainder:
+            break
+        sequence.append([-value for value in remainder])
+    return sequence
+
+
+def _fallback_changes(sequence, point):
+    previous = 0
+    changes = 0
+    for poly in sequence:
+        value = _fallback_eval(poly, point)
+        if value == 0:
+            continue
+        sign = 1 if value > 0 else -1
+        if previous and sign != previous:
+            changes += 1
+        previous = sign
+    return changes
+
+
+def _sturm_sequence(poly):
+    if gv_roots is not None:
+        return gv_roots.sturm_sequence(poly)
+    return _fallback_sturm(poly)
+
+
+def _sturm_changes(sequence, point):
+    if gv_roots is not None:
+        return gv_roots.sign_changes(sequence, point)
+    return _fallback_changes(sequence, Fraction(point))
+
+
+def _evaluate(poly, point):
+    if gv_roots is not None:
+        return gv_roots.evaluate(poly, point)
+    return _fallback_eval(_fallback_normalize(poly), Fraction(point))
+
+
+def _root_count(poly, left, right, sequence=None):
+    left, right = Fraction(left), Fraction(right)
+    if left >= right:
+        raise ValueError("root interval must increase")
+    if _evaluate(poly, left) == 0 or _evaluate(poly, right) == 0:
+        raise ValueError("root interval endpoint is a root")
+    chain = _sturm_sequence(poly) if sequence is None else sequence
+    return _sturm_changes(chain, left) - _sturm_changes(chain, right)
+
+
+def verify(inst, answer):
+    if not isinstance(answer, dict):
+        return False, "malformed witness: expected one JSON object"
+    if "minpoly" not in answer or "interval" not in answer:
+        return False, "missing witness field: need minpoly and interval"
+    polynomial = answer["minpoly"]
+    part_count = inst.get("parts")
+    if not isinstance(polynomial, list) or not all(
+        _is_int(value) for value in polynomial
+    ):
+        return False, "malformed minpoly: coefficients must be integers"
+    if len(polynomial) != part_count + 1:
+        return False, f"wrong minpoly degree: expected degree {part_count}"
+    if polynomial[-1] != 1:
+        return False, "minpoly is not monic: final coefficient must be 1"
+    height = (1 + 2 * inst["n"]) ** part_count
+    if any(abs(value) > height for value in polynomial[:-1]):
+        return False, "minpoly coefficient exceeds the declared height bound"
+    interval = answer["interval"]
+    if not isinstance(interval, list) or len(interval) != 2:
+        return False, "malformed interval: expected two rational endpoint pairs"
+    try:
+        left = _fraction_pair(interval[0])
+        right = _fraction_pair(interval[1])
+    except (TypeError, ValueError):
+        return False, "malformed interval endpoint: use [numerator,denominator]"
+    denominator = 1 << inst["interval_bits"]
+    if interval[0][1] != denominator or interval[1][1] != denominator:
+        return False, "interval denominator is outside the fixed certificate grid"
+    if not (Fraction(0) <= left < right <= Fraction(2 * inst["n"])):
+        return False, "interval endpoints are not increasing inside [0,2n]"
+    try:
+        sizes = _derive_part_sizes(inst)
+    except ValueError as exc:
+        return False, "malformed instance: " + str(exc)
+    expected = _multipartite_minpoly(sizes)
+    if polynomial != expected:
+        return False, "minimal polynomial does not match the graph's quotient"
+    prime = _irreducibility_prime(expected)
+    if prime is None:
+        return False, "instance polynomial lacks an executable irreducibility proof"
+    try:
+        chain = _sturm_sequence(expected)
+        inside = _root_count(expected, left, right, chain)
+        above = _root_count(
+            expected, right, Fraction(2 * inst["n"] + 1), chain
+        )
+    except (ArithmeticError, TypeError, ValueError, ZeroDivisionError) as exc:
+        return False, "invalid isolating interval: " + str(exc)
+    if inside != 1:
+        return False, f"interval contains {inside} real roots instead of exactly one"
+    if above != 0:
+        return False, "isolated root is not the largest real root"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    part_count = inst["parts"]
+    n = inst["n"]
+    height = (1 + 2 * n) ** part_count
+    denominator = 1 << inst["interval_bits"]
+    maximum = 2 * n * denominator
+    left = rng.randrange(maximum + 1)
+    right = rng.randrange(maximum + 1)
+    while right == left:
+        right = rng.randrange(maximum + 1)
+    if left > right:
+        left, right = right, left
+    return {
+        "minpoly": [
+            rng.randint(-height, height) for _ in range(part_count)
+        ]
+        + [1],
+        "interval": [[left, denominator], [right, denominator]],
+    }
+
+
+def search_space(inst):
+    part_count = inst["parts"]
+    n = inst["n"]
+    height = (1 + 2 * n) ** part_count
+    denominator = 1 << inst["interval_bits"]
+    maximum = 2 * n * denominator
+    intervals = maximum * (maximum + 1) // 2
+    return (2 * height + 1) ** part_count * intervals
+
+
+def enumerate_all(inst):
+    # Even the demo language is enormous; G5 reports a shipping-preset sampled
+    # density and the exact one-polynomial upper bound instead.
+    return None
+
+
+def canonical_key(inst):
+    sizes = _derive_part_sizes(inst)
+    # A complete multipartite graph is determined up to isomorphism precisely
+    # by the multiset of its part sizes.
+    return "complete-multipartite:" + ",".join(str(value) for value in sizes)
+
+
+def escalate(params):
+    n = params.get("n")
+    part_count = params.get("parts", 6)
+    if not _is_int(n) or not _is_int(part_count):
+        return None
+    # Fixed certificate degree and atom count; only the dense ambient matrix,
+    # coefficient entropy, and twin-class crowding grow.
+    return {"n": n * 2, "parts": part_count}
+
+
+def _solve_fraction_system(matrix, rhs):
+    n = len(rhs)
+    augmented = [
+        [Fraction(value) for value in row] + [Fraction(rhs[i])]
+        for i, row in enumerate(matrix)
+    ]
+    operations = 0
+    for column in range(n):
+        pivot = next(
+            (row for row in range(column, n) if augmented[row][column]), None
+        )
+        if pivot is None:
+            raise ArithmeticError("singular Krylov moment system")
+        augmented[column], augmented[pivot] = augmented[pivot], augmented[column]
+        pivot_value = augmented[column][column]
+        for j in range(column, n + 1):
+            augmented[column][j] /= pivot_value
+            operations += 1
+        for row in range(n):
+            if row == column or augmented[row][column] == 0:
+                continue
+            factor = augmented[row][column]
+            for j in range(column, n + 1):
+                augmented[row][j] -= factor * augmented[column][j]
+                operations += 2
+    return [augmented[i][-1] for i in range(n)], operations
+
+
+def _q_times_vector(rows, vector):
+    output = []
+    operations = 0
+    for vertex, row in enumerate(rows):
+        degree = row.bit_count()
+        neighbor_sum = 0
+        bits = row
+        while bits:
+            least = bits & -bits
+            neighbor = least.bit_length() - 1
+            neighbor_sum += vector[neighbor]
+            operations += 1
+            bits ^= least
+        output.append(degree * vector[vertex] + neighbor_sum)
+        operations += 2
+    return output, operations
+
+
+def _reference_krylov(inst):
+    """Domain-standard exact Krylov recurrence, without twin-class recovery."""
+    rows = inst["adjacency_rows"]
+    n = inst["n"]
+    degree = inst["parts"]
+    vector = [1] * n
+    moments = []
+    operations = 0
+    for step in range(2 * degree):
+        moments.append(sum(vector))
+        operations += max(0, n - 1)
+        if step + 1 < 2 * degree:
+            vector, used = _q_times_vector(rows, vector)
+            operations += used
+    hankel = [
+        [moments[row + column] for column in range(degree)]
+        for row in range(degree)
+    ]
+    rhs = [-moments[degree + row] for row in range(degree)]
+    coefficients, solve_operations = _solve_fraction_system(hankel, rhs)
+    operations += solve_operations
+    if any(value.denominator != 1 for value in coefficients):
+        raise ArithmeticError("Krylov recurrence was not integral")
+    polynomial = [value.numerator for value in coefficients] + [1]
+
+    denominator = 1 << inst["interval_bits"]
+    maximum = 2 * n * denominator
+    chain = _sturm_sequence(polynomial)
+    upper_point = Fraction(2 * n)
+    upper_changes = _sturm_changes(chain, upper_point)
+    root_queries = 0
+
+    def roots_above(grid_index):
+        nonlocal root_queries
+        root_queries += 1
+        point = Fraction(grid_index, denominator)
+        if _evaluate(polynomial, point) == 0:
+            raise ArithmeticError("unexpected rational root of irreducible polynomial")
+        return _sturm_changes(chain, point) - upper_changes
+
+    low, high = 0, maximum
+    while low < high:
+        middle = (low + high) // 2
+        if roots_above(middle) <= 1:
+            high = middle
+        else:
+            low = middle + 1
+    lower_grid = low
+    if roots_above(lower_grid) != 1:
+        raise ArithmeticError("certificate grid did not separate the top roots")
+    answer = {
+        "minpoly": polynomial,
+        "interval": [
+            [lower_grid, denominator],
+            [maximum, denominator],
+        ],
+    }
+    return answer, {
+        "scalar_arithmetic_operations": operations,
+        "sturm_grid_queries": root_queries,
+        "krylov_moments": 2 * degree,
+    }
+
+
+def _compact_solution(inst):
+    sizes = _derive_part_sizes(inst)
+    polynomial, operations = _multipartite_minpoly(sizes, with_operations=True)
+    n = inst["n"]
+    denominator = 1 << inst["interval_bits"]
+    lower = max(n - 2 * size for size in sizes)
+    upper = 2 * (n - min(sizes))
+    return {
+        "minpoly": polynomial,
+        "interval": [
+            [lower * denominator, denominator],
+            [upper * denominator, denominator],
+        ],
+    }, operations
+
+
+def _power_polynomial(root, degree):
+    polynomial = [1]
+    for _ in range(degree):
+        polynomial = _poly_mul(polynomial, [-root, 1])
+    return polynomial
+
+
+def _guess_certificate(inst, guess):
+    n = inst["n"]
+    guess = max(1, min(2 * n - 1, int(guess)))
+    denominator = 1 << inst["interval_bits"]
+    lower = max(0, guess - 1)
+    upper = min(2 * n, guess + 1)
+    if lower == upper:
+        upper = min(2 * n, lower + 1)
+    return {
+        "minpoly": _power_polynomial(guess, inst["parts"]),
+        "interval": [
+            [lower * denominator, denominator],
+            [upper * denominator, denominator],
+        ],
+    }
+
+
+def _attack_candidates(inst, seed):
+    rows = inst["adjacency_rows"]
+    n = inst["n"]
+    degrees = [row.bit_count() for row in rows]
+    edges = sum(degrees) // 2
+    mode_degree = Counter(degrees).most_common(1)[0][0]
+    sizes = sorted(n - degree for degree in set(degrees))
+    rng = random.Random(seed ^ 0x250702263)
+    return {
+        "outlier_max_degree_bound": [
+            _guess_certificate(inst, 2 * max(degrees))
+        ],
+        "greedy_average_row_sum": [
+            _guess_certificate(inst, (4 * edges + n // 2) // n)
+        ],
+        "regular_graph_all_ones_ansatz": [
+            _guess_certificate(inst, 2 * mode_degree)
+        ],
+        "by_hand_two_cell_collapse": [
+            _guess_certificate(inst, n + sizes[-1] - sizes[0])
+        ],
+        "random_minpoly_restart_256": [
+            random_candidate(inst, rng) for _ in range(256)
+        ],
+    }
+
+
+def _relabel(inst, permutation):
+    n = inst["n"]
+    if sorted(permutation) != list(range(n)):
+        raise ValueError("not a vertex permutation")
+    new_rows = [0] * n
+    for old_vertex, old_row in enumerate(inst["adjacency_rows"]):
+        new_vertex = permutation[old_vertex]
+        bits = old_row
+        row = 0
+        while bits:
+            least = bits & -bits
+            old_neighbor = least.bit_length() - 1
+            row |= 1 << permutation[old_neighbor]
+            bits ^= least
+        new_rows[new_vertex] = row
+    transformed = dict(inst)
+    transformed["adjacency_rows"] = new_rows
+    transformed["answer"] = json.loads(json.dumps(inst["answer"]))
+    return transformed
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def selftest():
+    report = {}
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+
+    g1_failures = []
+    g1_attempts = 0
+    irreducibility_primes = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append([preset, seed, reason])
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append([preset, seed, "answer is not JSON-native"])
+            sizes = _derive_part_sizes(inst)
+            irreducibility_primes.append(
+                _irreducibility_prime(_multipartite_minpoly(sizes))
+            )
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures and all(irreducibility_primes),
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+        "irreducibility_primes": irreducibility_primes,
+    }
+
+    inst = make_instance(seed=19, **shipping)
+    answer = inst["answer"]
+    drop = json.loads(json.dumps(answer))
+    drop["minpoly"] = drop["minpoly"][:-1]
+    swapped = json.loads(json.dumps(answer))
+    swapped["interval"] = list(reversed(swapped["interval"]))
+    duplicated = json.loads(json.dumps(answer))
+    duplicated["minpoly"][0] = duplicated["minpoly"][1]
+    out_of_range = json.loads(json.dumps(answer))
+    out_of_range["minpoly"][0] = (1 + 2 * inst["n"]) ** inst["parts"] + 1
+    corruptions = {
+        "drop": drop,
+        "swap": swapped,
+        "duplicate": duplicated,
+        "empty": {},
+        "out_of_range": out_of_range,
+    }
+    corruption_results = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        corruption_results[name] = {"rejected": not ok, "reason": reason}
+    reasons = [item["reason"] for item in corruption_results.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(item["rejected"] for item in corruption_results.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": corruption_results,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    response = (
+        "I used the equitable quotient and exact Sturm isolation.\n"
+        "```json\n<answer>"
+        + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```\nThe interval is open."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_equals_answer": parsed == answer,
+    }
+
+    guess_rng = random.Random(0x250702263)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
+    guess_seconds = time.perf_counter() - guess_start
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_fraction,
+        "search_space_bits": search_space(inst).bit_length(),
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    attack_names = list(_attack_candidates(inst, 0))
+    successes = {name: 0 for name in attack_names}
+    attack_times = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    reference_time = 0.0
+    reference_operations = 0
+    reference_queries = 0
+    compact_successes = 0
+    compact_operations = 0
+    compact_time = 0.0
+    for seed in range(101, 109):
+        trial = make_instance(seed=seed, **shipping)
+        candidates = _attack_candidates(trial, seed)
+        for name in attack_names:
+            started = time.perf_counter()
+            won = any(verify(trial, candidate)[0] for candidate in candidates[name])
+            attack_times[name] += time.perf_counter() - started
+            successes[name] += int(won)
+        started = time.perf_counter()
+        reference_answer, reference_stats = _reference_krylov(trial)
+        reference_time += time.perf_counter() - started
+        reference_operations += reference_stats["scalar_arithmetic_operations"]
+        reference_queries += reference_stats["sturm_grid_queries"]
+        reference_successes += int(verify(trial, reference_answer)[0])
+        started = time.perf_counter()
+        compact_answer, used = _compact_solution(trial)
+        compact_time += time.perf_counter() - started
+        compact_operations += used
+        compact_successes += int(verify(trial, compact_answer)[0])
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_times[name], 6),
+        }
+        for name in attack_names
+    }
+    reference = {
+        "name": "exact Krylov moments and rational recurrence recovery",
+        "complexity": "O(r*n^2+r^3) exact arithmetic on a dense Q matrix",
+        "wall_clock_sec": round(reference_time / 8, 6),
+        "operations": reference_operations // 8,
+        "sturm_grid_queries": reference_queries // 8,
+        "solves": f"{reference_successes}/8, as expected",
+        "compact_route": "twin-class quotient plus determinant lemma",
+        "compact_route_wall_clock_sec": round(compact_time / 8, 6),
+        "compact_route_operations": compact_operations // 8,
+        "compact_route_solves": f"{compact_successes}/8, as expected",
+    }
+    all_failed = all(value == 0 for value in successes.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8 and compact_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": reference,
+    }
+
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_fraction < 1e-6 and all_failed and reference_successes == 8,
+        "shipping_sample_hits": guess_hits,
+        "shipping_sample_total": guess_total,
+        "shipping_solution_density": guess_fraction,
+        "exact_valid_minpoly_count": 1,
+        "density_upper_bound_numerator": 1,
+        "density_upper_bound_denominator": (
+            2 * (1 + 2 * inst["n"]) ** inst["parts"] + 1
+        )
+        ** inst["parts"],
+        "strongest_failing_attack_wall_clock_sec": round(
+            attack_times["random_minpoly_restart_256"] / 8, 6
+        ),
+        "strongest_failing_attack_iterations": 256,
+        "reference_wall_clock_sec": reference["wall_clock_sec"],
+        "reference_operation_count": reference["operations"],
+        "reference_sturm_queries": reference["sturm_grid_queries"],
+    }
+
+    doubled_params = {"n": shipping["n"] * 2, "parts": shipping["parts"]}
+    started = time.perf_counter()
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_build = time.perf_counter() - started
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    ladder_n = [params["n"] for params in DIFFICULTY.values()]
+    ladder_parts = [params["parts"] for params in DIFFICULTY.values()]
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["n"] == 2 * inst["n"]
+        and search_space(doubled) > search_space(inst)
+        and len(render(doubled)) > len(render(inst))
+        and ladder_n == sorted(ladder_n)
+        and ladder_parts == sorted(ladder_parts),
+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "shipping_search_space_bits": search_space(inst).bit_length(),
+        "doubled_search_space_bits": search_space(doubled).bit_length(),
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariant = 0
+    real = 0
+    unrelated_keys = []
+    for seed in range(201, 221):
+        original = make_instance(seed=seed, **shipping)
+        original_key = canonical_key(original)
+        n = original["n"]
+        rng = random.Random(seed ^ 0xA55A)
+        random_permutation = list(range(n))
+        rng.shuffle(random_permutation)
+        reverse = list(reversed(range(n)))
+        rotation = [(value + 17) % n for value in range(n)]
+        composition = [reverse[random_permutation[value]] for value in range(n)]
+        for permutation in (random_permutation, reverse, rotation, composition):
+            transformed = _relabel(original, permutation)
+            invariant += int(canonical_key(transformed) == original_key)
+            real += int(verify(transformed, original["answer"])[0])
+        unrelated_keys.append(original_key)
+    distinct = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant == 80 and real == 80 and distinct == 20,
+        "invariant_relabellings": invariant,
+        "real_transformations_verified": real,
+        "unrelated_distinct_keys": distinct,
+        "unrelated_attempts": 20,
+        "transformations": [
+            "uniform random vertex permutation",
+            "label reversal",
+            "cyclic label shift",
+            "random-permutation/reversal composition",
+        ],
+    }
+
+    answer_blob = json.dumps(answer, separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(answer)
+    _, intended_operations = _compact_solution(inst)
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(
+        1, arms["placebo"]["attempts"]
+    )
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": G9_ORACLE_RESULTS["hinted_verdict"] == "hardened"
+        and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(value.get("pass") is True for value in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

