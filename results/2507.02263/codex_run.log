+def _sample_sizes(order, k, rng):
+    minimum = sum(range(2, k + 2))
+    if order < minimum:
+        raise ValueError(
+            "n must be at least %d for k distinct parts of size at least 2" % minimum
+        )
+    for _ in range(100000):
