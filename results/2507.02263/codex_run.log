+def _relabel_instance(inst, permutation):
+    order = inst["n"]
+    if sorted(permutation) != list(range(order)):
+        raise ValueError("not a permutation")
+    old_rows = _decode_rows(inst)
+    new_rows = [0] * order
+    for old_vertex, bits in enumerate(old_rows):
