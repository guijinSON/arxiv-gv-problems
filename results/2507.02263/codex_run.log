+    """Dense exact Faddeev-LeVerrier; return ascending charpoly and op count."""
+    order = len(matrix)
+    current = [[int(i == j) for j in range(order)] for i in range(order)]
+    descending = [1]
+    operations = 0
+    for step in range(1, order + 1):
+        product = [[0] * order for _ in range(order)]
