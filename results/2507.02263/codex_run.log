+def _irreducible_mod_prime(poly, prime):
+    """Rabin's exact irreducibility test for a monic polynomial over F_p."""
+    f = _mod_trim(poly, prime)
+    degree = len(f) - 1
+    if degree < 1 or f[-1] != 1:
+        return False
+    x_poly = [0, 1]
+    needed = {degree // q for q in _prime_divisors(degree)}
+    frobenius = x_poly
+    snapshots = {}
+    for step in range(1, degree + 1):
+        frobenius = _mod_pow(frobenius, prime, f, prime)
+        if step in needed:
+            snapshots[step] = frobenius
+    difference = _poly_add(
+        frobenius,
+        [(-coefficient) % prime for coefficient in x_poly],
+    )
+    if _mod_trim(difference, prime):
+        return False
+    for step in needed:
+        difference = _poly_add(
+            snapshots[step],
+            [(-coefficient) % prime for coefficient in x_poly],
+        )
+        if len(_mod_gcd(difference, f, prime)) > 1:
+            return False
+    return True
+
+
+def _irreducibility_prime(poly):
+    for prime in _SMALL_PRIMES:
+        if _irreducible_mod_prime(poly, prime):
+            return prime
+    return None
