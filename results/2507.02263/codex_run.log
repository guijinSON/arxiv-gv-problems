+def _candidate_from_mask(inst: dict, mask: int) -> list:
+    """Make the obvious low-label candidate induced by a guessed visible mask."""
+    if mask <= 0:
+        mask = 1
+    size = inst["block_size"]
+    t = inst["t"]
