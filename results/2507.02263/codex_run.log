new file mode 100644
index 0000000000000000000000000000000000000000..6c4ab540e529240d88eaf6d29fa5c402c4c40382
--- /dev/null
+++ b/gen_2507_02263.py
@@ -0,0 +1,968 @@
+"""Verified problem generator for arXiv:2507.02263.
+
+The paper proves that a sufficiently large signless-Laplacian spectral radius
+forces a logarithmic clique blowup.  This module asks for one such blowup in a
+succinct graph in the paper's k=3 regime.  A known K_4[t] is transported through
+a reversible GF(2) relabelling, so generation never searches the finished graph.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "The hidden bit-zero cut is a parity covector transported by the reversible "
+    "mixer, and every pair across that cut is adjacent."
+)
+PLACEBO_HINT: str = (
+    "The block labels and least-significant-bit convention deserve careful "
+    "attention when checking every required cross-edge."
+)
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "succinct finite simple graph",
+        "exact signless-Laplacian Rayleigh lower bound",
+        "four-part clique blowup K_4[t]",
+    ],
+    "verification_operations": [
+        "exact reversible GF(2) gate evaluation",
+        "exact parity comparison",
+        "exact graph edge membership",
+        "integer range and cardinality comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Transport the hidden cut as one dual parity mask instead of transporting "
+        "each requested vertex through the long reversible mixer."
+    ),
+    "hardness_basis": (
+        "Track B: direct witness transport through the displayed reversible circuit "
+        "takes O(t s) gate applications (4,632 at the shipping preset d=20, t=12, "
+        "s=192; measured in G6), whereas the dual-covector change of variables plus "
+        "vertex synthesis takes 240 exact bit operations; Theorem 2.4 is used in its "
+        "k=3, epsilon=1/20 signless-Laplacian regime."
+    ),
+    "max_answer_tokens": 110,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 6, "t": 2, "mixer_steps": 8, "decoy_count": 4},
+    "easy": {"n": 20, "t": 12, "mixer_steps": 192, "decoy_count": 30},
+    "medium": {"n": 24, "t": 12, "mixer_steps": 216, "decoy_count": 36},
+    "hard": {"n": 28, "t": 12, "mixer_steps": 240, "decoy_count": 42},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON list of four strictly increasing lists, each of length t. The first "
+        "two are disjoint vertex labels in block U and are lexicographically ordered; "
+        "the third lies in V and the fourth in W. All labels are integers in the "
+        "displayed graph range."
+    ),
+    "bounds": {
+        "groups": 4,
+        "entries_per_group": "t",
+        "maximum_t": 16,
+        "maximum_dimension_bits": 128,
+        "maximum_atomic_elements": 64,
+        "index_base": 0,
+    },
+}
+
+NOTES: str = (
+    "Section 1 fixes H[t] as the graph obtained by replacing every vertex of H by "
+    "an independent t-set and every edge by K_{t,t}. Section 2.1, Theorem 2.4 "
+    "(labelled lsES in the source) states that k>=2 and q(G)>=(1-1/k+epsilon)2N "
+    "force K_{k+1}[t] with t=Omega(log N). The same section says k=1 is false; "
+    "Section 2.2 says k=2 is false for its color-critical, joint, and book variants, "
+    "so this family uses k=3. Example 2.4 and the remark after Theorem 2.2 identify "
+    "the paper's native Turan-plus-internal-edges construction template. Here the "
+    "three outer blocks form T_{N,3}; U receives a complete hidden parity cut and "
+    "seed-dependent Cayley decoys. Exact edge counting gives q(G)>=4e(G)/N>" 
+    "2(2/3+1/20)N. A base K_4[t] is carried through every reversible gate, never "
+    "searched for. Track A would be false because direct circuit evaluation is a "
+    "polynomial certificate extractor. Track B records that extractor separately. "
+    "Equal graph degrees defeat the outlier probe; balanced random gates defeat "
+    "visible-parity and endpoint-frequency guesses; random masks and a truncated "
+    "dual transport fail across the G6 seeds."
+)
+
+# Filled only from isolated runs of scripts/harden.py.  Pending evidence makes G9
+# fail instead of treating an unrun oracle arm as evidence.
+G9_RESULTS: dict = {
+    "arms": {
+        "bare": {"solved": None, "attempts": 3},
+        "hinted": {"solved": None, "attempts": 3},
+        "placebo": {"solved": None, "attempts": 3},
+    },
+    "hinted_verdict": "pending",
+}
+
+
+def _require_int(name: str, value: object, low: int, high: int | None = None) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError(f"{name} must be an integer")
+    if value < low or (high is not None and value > high):
+        upper = "" if high is None else f" and at most {high}"
+        raise ValueError(f"{name} must be at least {low}{upper}")
+    return value
+
+
+def _apply_gate(value: int, gate: list | tuple) -> int:
+    kind, first, second = gate
+    if kind == "C":
+        if (value >> first) & 1:
+            value ^= 1 << second
+        return value
+    if kind == "S":
+        if ((value >> first) ^ (value >> second)) & 1:
+            value ^= (1 << first) | (1 << second)
+        return value
+    raise ValueError(f"unknown gate {kind!r}")
+
+
+def _transpose_gate(mask: int, gate: list | tuple) -> int:
+    """Carry an input covector through one self-inverse forward gate."""
+    kind, first, second = gate
+    if kind == "C":
+        if (mask >> second) & 1:
+            mask ^= 1 << first
+        return mask
+    if kind == "S":
+        return _apply_gate(mask, gate)
+    raise ValueError(f"unknown gate {kind!r}")
+
+
+def _mix(value: int, gates: list, shift: int) -> int:
+    for gate in gates:
+        value = _apply_gate(value, gate)
+    return value ^ shift
+
+
+def _unmix(value: int, gates: list, shift: int) -> int:
+    value ^= shift
+    for gate in reversed(gates):
+        value = _apply_gate(value, gate)
+    return value
+
+
+def _transport_mask(gates: list, start: int = 1) -> int:
+    mask = start
+    for gate in gates:
+        mask = _transpose_gate(mask, gate)
+    return mask
+
+
+def _sample_gates(rng: random.Random, dimension: int, steps: int) -> list:
+    gates = []
+    # A shuffled sweep prevents untouched coordinates; random gates obscure the sweep.
+    order = list(range(dimension))
+    rng.shuffle(order)
+    for i in range(min(steps, dimension - 1)):
+        gates.append(["C", order[i + 1], order[i]])
+    while len(gates) < steps:
+        a = rng.randrange(dimension)
+        b = rng.randrange(dimension - 1)
+        if b >= a:
+            b += 1
+        kind = "S" if rng.randrange(5) == 0 else "C"
+        gates.append([kind, a, b])
+    rng.shuffle(gates)
+    return gates
+
+
+def _sample_distinct(rng: random.Random, bound: int, count: int) -> list[int]:
+    if count > bound:
+        raise ValueError("sample count exceeds population")
+    if bound <= (1 << 62):
+        return rng.sample(range(bound), count)
+    bits = bound.bit_length()
+    chosen = set()
+    while len(chosen) < count:
+        value = rng.getrandbits(bits)
+        if value < bound:
+            chosen.add(value)
+    return list(chosen)
+
+
+def _frequency_mask(gates: list, dimension: int) -> int:
+    counts = [0] * dimension
+    for _, a, b in gates:
+        counts[a] += 1
+        counts[b] += 1
+    take = max(1, dimension // 2)
+    bits = sorted(range(dimension), key=lambda x: (-counts[x], x))[:take]
+    return sum(1 << bit for bit in bits)
+
+
+def _candidate_from_mask(inst: dict, mask: int) -> list:
+    """Make a full-width candidate induced by a guessed visible mask."""
+    if mask <= 0:
+        mask = 1
+    size = inst["block_size"]
+    t = inst["t"]
+    groups = [[], []]
+    rng = random.Random(mask ^ (inst["dimension"] << 40) ^ 0x250702263)
+    used = set()
+    # A nonzero affine parity has equally many labels of each kind.
+    while len(groups[0]) < t or len(groups[1]) < t:
+        x = rng.getrandbits(inst["dimension"])
+        if x in used:
+            continue
+        used.add(x)
+        bit = (mask & x).bit_count() & 1
+        if len(groups[bit]) < t:
+            groups[bit].append(x)
+    groups = [sorted(groups[0]), sorted(groups[1])]
+    if groups[1] < groups[0]:
+        groups.reverse()
+    return groups + [list(range(size, size + t)), list(range(2 * size, 2 * size + t))]
+
+
+def _attack_candidates(inst: dict, random_seed: int = 0) -> dict:
+    dimension = inst["dimension"]
+    all_parity = (1 << dimension) - 1
+    gates = inst["mixer"]
+    truncated = _transport_mask(gates[-min(32, len(gates)):])
+    candidates = {
+        "outlier_degree_bit0_tiebreak": _candidate_from_mask(inst, 1),
+        "greedy_visible_popcount_parity": _candidate_from_mask(inst, all_parity),
+        "in_context_gate_frequency_ansatz": _candidate_from_mask(
+            inst, _frequency_mask(gates, dimension)
+        ),
+        "in_context_truncated_dual_transport": _candidate_from_mask(inst, truncated),
+    }
+    rng = random.Random(random_seed)
+    last = None
+    for _ in range(64):
+        guess = rng.getrandbits(dimension) or 1
+        last = _candidate_from_mask(inst, guess)
+        if verify(inst, last)[0]:
+            break
+    candidates["random_parity_masks_64"] = last
+    return candidates
+
+
+def make_instance(n, seed=0, t=12, mixer_steps=192, decoy_count=30, **params) -> dict:
+    """Transform a known K_4[t] through a reversible relabelling.
+
+    The certificate route is a structure-preserving map: opposite bit-zero
+    classes are completely joined before relabelling, and the known vertices are
+    carried through the same circuit.  No subgraph search is performed.
+    """
+    del params
+    n = _require_int("n", n, 4, 128)
+    seed = _require_int("seed", seed, 0)
+    t = _require_int("t", t, 2, 16)
+    mixer_steps = _require_int("mixer_steps", mixer_steps, 1, 240)
+    decoy_count = _require_int("decoy_count", decoy_count, 0, 4 * n)
+    block_size = 1 << n
+    if 2 * t > block_size:
+        raise ValueError("two t-sets must fit in one block")
+    rng = random.Random(seed)
+
+    # Reject circuits on which one of the declared simple masks coincides with the
+    # true transported cut.  This is construction hardening while carrying a known
+    # covector, not solving the generated graph.
+    for _ in range(200):
+        gates = _sample_gates(rng, n, mixer_steps)
+        visible_mask = _transport_mask(gates)
+        zero_bits = n - visible_mask.bit_count()
+        obvious = {1, (1 << n) - 1, _frequency_mask(gates, n)}
+        truncated = _transport_mask(gates[-min(32, len(gates)):])
+        if visible_mask in obvious or (len(gates) > 32 and visible_mask == truncated):
+            continue
+        if zero_bits < math.ceil(math.log2(t)):
+            continue
+        shift = rng.getrandbits(n)
+        break
+    else:
+        raise RuntimeError("could not construct a sufficiently mixed relabelling")
+
+    # Seed-dependent even generators add regular same-side Cayley decoys without
+    # changing any edge of the certified opposite-parity biclique.
+    decoys = set()
+    while len(decoys) < decoy_count:
+        g = rng.getrandbits(n) & ~1
+        if g:
+            decoys.add(g)
+    decoys = sorted(decoys)
+
+    # Sample a base witness first, and carry it through the reversible map.
+    class_zero = _sample_distinct(rng, block_size // 2, t)
+    pre_zero = [2 * x for x in class_zero]
+    class_one = _sample_distinct(rng, block_size // 2, t)
+    pre_one = [2 * x + 1 for x in class_one]
+    left = sorted(_mix(x, gates, shift) for x in pre_zero)
+    right = sorted(_mix(x, gates, shift) for x in pre_one)
+    if right < left:
+        left, right = right, left
+    v_part = sorted(block_size + x for x in _sample_distinct(rng, block_size, t))
+    w_part = sorted(2 * block_size + x for x in _sample_distinct(rng, block_size, t))
+
+    # e(T_{3m,3})=3m^2 and the hidden complete cut contributes m^2/4 edges.
+    # Decoys only increase e. Thus q>=4e/N>=13m/3>43m/10, exactly.
+    return {
+        "family": "signless-Laplacian-forced clique blowup",
+        "dimension": n,
+        "block_size": block_size,
+        "vertex_count": 3 * block_size,
+        "t": t,
+        "k": 3,
+        "epsilon": [1, 20],
+        "mixer": gates,
+        "label_shift": shift,
+        "decoy_generators": decoys,
+        "q_lower_bound": [13 * block_size, 3],
+        "q_required_threshold": [43 * block_size, 10],
+        "answer": [left, right, v_part, w_part],
+    }
+
+
+def _visible_mask(inst: dict) -> int:
+    cached = inst.get("_grader_mask_cache")
+    if isinstance(cached, int) and cached > 0:
+        return cached
+    mask = _transport_mask(inst["mixer"])
+    inst["_grader_mask_cache"] = mask
+    return mask
+
+
+def _visible_decoys(inst: dict) -> set[int]:
+    cached = inst.get("_grader_decoy_cache")
+    if isinstance(cached, set):
+        return cached
+    # Translation cancels in a difference, so only the linear mixer is applied.
+    visible = {_mix(g, inst["mixer"], 0) for g in inst["decoy_generators"]}
+    inst["_grader_decoy_cache"] = visible
+    return visible
+
+
+def _edge(inst: dict, u: int, v: int) -> bool:
+    if u == v:
+        return False
+    size = inst["block_size"]
+    bu, bv = u // size, v // size
+    if bu != bv:
+        return True
+    if bu != 0:
+        return False
+    mask = _visible_mask(inst)
+    if ((mask & (u ^ v)).bit_count() & 1) == 1:
+        return True
+    return (u ^ v) in _visible_decoys(inst)
+
+
+def _gate_text(gates: list) -> str:
+    pieces = [f"{kind} {a} {b}" for kind, a, b in gates]
+    return "\n".join(
+        "; ".join(pieces[i:i + 10]) for i in range(0, len(pieces), 10)
+    )
+
+
+def render(inst) -> str:
+    """Return a complete, self-contained statement with optional controlled hint."""
+    decoys = ", ".join(str(x) for x in inst["decoy_generators"]) or "(none)"
+    statement = f"""Find a clique blowup in the following succinct finite simple graph.
+
+A t-blowup K_4[t] consists of four disjoint groups of t vertices such that every
+vertex in one group is adjacent to every vertex in each other group. Extra edges
+inside a group are irrelevant because a subgraph, not an induced subgraph, is asked
+for.
+
+Parameters and vertices:
+- Bit dimension d = {inst['dimension']}; m = 2^d = {inst['block_size']}.
+- t = {inst['t']}. Vertices are the integers 0,...,{inst['vertex_count'] - 1}.
+- U = 0,...,{inst['block_size'] - 1}; V = {inst['block_size']},...,{2 * inst['block_size'] - 1};
+  W = {2 * inst['block_size']},...,{inst['vertex_count'] - 1}.
+- Every pair in different blocks U,V,W is an edge. There are no edges inside V or W.
+
+Edges inside U are defined exactly as follows. A local label uses d bits numbered
+0,...,d-1 from least significant to most significant. To recover pre-mixer z from
+x in U, first replace x by x XOR {inst['label_shift']}, and then process the gates
+below in reverse displayed order. Gate `C a b` replaces bit b by bit b XOR bit a;
+gate `S a b` swaps bits a and b. (Both gate types are their own inverses.)
+
+Two distinct U labels x,y are adjacent exactly when either:
+1. bit 0 of their recovered pre-mixer labels differs; or
+2. the XOR of those two pre-mixer labels is in this decoy-generator list:
+   {decoys}
+
+Forward mixer gates, in their displayed order:
+{_gate_text(inst['mixer'])}
+
+For context, the signless Laplacian is Q=D+A and q(G) is its largest eigenvalue.
+This graph has N={inst['vertex_count']} vertices and the exact Rayleigh bound
+q(G) >= {inst['q_lower_bound'][0]}/{inst['q_lower_bound'][1]} exceeds the threshold
+2(1-1/3+1/20)N = {inst['q_required_threshold'][0]}/{inst['q_required_threshold'][1]}.
+
+Output four lists [L,R,B,C]. L and R must each contain exactly t distinct labels
+from U; B exactly t from V; C exactly t from W. Each list must be strictly
+increasing, all 4t labels must be distinct, and L must be lexicographically smaller
+than R. Order matters only through these conventions; repeats are forbidden and all
+ranges above are inclusive.
+
+Give your final answer inside <answer></answer> tags as one JSON list of four integer
+lists. Example: <answer>[[0,2],[1,3],[64,65],[128,129]]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text) -> object | None:
+    """Parse the final tagged JSON answer, tolerating surrounding model prose."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text, re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, list) else None
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check any normalized K_4[t] witness without consulting the planted one."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if len(answer) == 0:
+        return False, "answer is empty"
+    if len(answer) != 4:
+        return False, "expected exactly four groups"
+    t = inst["t"]
+    for index, group in enumerate(answer):
+        if not isinstance(group, list):
+            return False, f"group {index} must be a list"
+        if len(group) != t:
+            return False, f"group {index} must contain exactly {t} labels"
+        if any(isinstance(x, bool) or not isinstance(x, int) for x in group):
+            return False, f"group {index} contains a non-integer label"
+        if any(group[i] >= group[i + 1] for i in range(t - 1)):
+            return False, f"group {index} is not strictly increasing"
+    size = inst["block_size"]
+    ranges = [(0, size), (0, size), (size, 2 * size), (2 * size, 3 * size)]
+    for index, (group, (low, high)) in enumerate(zip(answer, ranges)):
+        if any(x < low or x >= high for x in group):
+            return False, f"group {index} has a label outside its required block"
+    flat = [x for group in answer for x in group]
+    if len(set(flat)) != len(flat):
+        return False, "a vertex label is repeated across groups"
+    if answer[0] >= answer[1]:
+        return False, "the two U groups are not in lexicographic order"
+    # Every other cross-group pair joins different outer blocks and is automatic.
+    mask = _visible_mask(inst)
+    decoys = _visible_decoys(inst)
+    for u in answer[0]:
+        for v in answer[1]:
+            difference = u ^ v
+            if not ((mask & difference).bit_count() & 1) and difference not in decoys:
+                return False, f"missing cross-edge between groups 0 and 1: {u}-{v}"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Sample uniformly from the normalized, shape-aware certificate language."""
+    size = inst["block_size"]
+    t = inst["t"]
+    picked = _sample_distinct(rng, size, 2 * t)
+    rng.shuffle(picked)
+    left, right = sorted(picked[:t]), sorted(picked[t:])
+    if right < left:
+        left, right = right, left
+    v_part = sorted(size + x for x in _sample_distinct(rng, size, t))
+    w_part = sorted(2 * size + x for x in _sample_distinct(rng, size, t))
+    return [left, right, v_part, w_part]
+
+
+def search_space(inst) -> int | None:
+    """Return the exact size of the finite normalized certificate language."""
+    size = inst["block_size"]
+    t = inst["t"]
+    u_pairs = math.comb(size, t) * math.comb(size - t, t) // 2
+    return u_pairs * math.comb(size, t) ** 2
+
+
+def _materialized_u_rows(inst: dict) -> list[int]:
+    size = inst["block_size"]
+    pre = [_unmix(x, inst["mixer"], inst["label_shift"]) for x in range(size)]
+    decoys = set(inst["decoy_generators"])
+    rows = [0] * size
+    for u in range(size):
+        for v in range(u + 1, size):
+            edge = ((pre[u] ^ pre[v]) & 1) == 1 or (pre[u] ^ pre[v]) in decoys
+            if edge:
+                rows[u] |= 1 << v
+                rows[v] |= 1 << u
+    return rows
+
+
+def enumerate_all(inst) -> int | None:
+    """Brute-force the demo language; refuse larger enumerations."""
+    size = inst["block_size"]
+    t = inst["t"]
+    if size > 64 or t > 2:
+        return None
+    rows = _materialized_u_rows(inst)
+    all_mask = (1 << size) - 1
+    u_valid_ordered = 0
+    for left in itertools.combinations(range(size), t):
+        common = all_mask
+        left_mask = 0
+        for u in left:
+            common &= rows[u]
+            left_mask |= 1 << u
+        common &= ~left_mask
+        count = common.bit_count()
+        if count >= t:
+            u_valid_ordered += math.comb(count, t)
+    u_valid_unordered = u_valid_ordered // 2
+    return u_valid_unordered * math.comb(size, t) ** 2
+
+
+def canonical_key(inst) -> str:
+    """A visible-affine invariant keyed on the canonical pre-mixer decoration.
+
+    Exact isomorphism of succinct Cayley graphs is code-equivalence hard in general;
+    the pre-mixer generator set is the strongest inexpensive invariant used here.
+    It deliberately ignores the mixer, shift, planted answer, and seed.
+    """
+    payload = {
+        "dimension": inst["dimension"],
+        "t": inst["t"],
+        "epsilon": inst["epsilon"],
+        "decoy_generators": sorted(inst["decoy_generators"]),
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(blob).hexdigest()
+
+
+def _post_transform(inst: dict, extra_gates: list, delta: int) -> tuple[dict, list]:
+    """Relabel U by an affine map and carry a witness through it."""
+    out = copy.deepcopy(inst)
+    shift = inst["label_shift"]
+    for gate in extra_gates:
+        shift = _apply_gate(shift, gate)
+    out["mixer"] = copy.deepcopy(inst["mixer"]) + copy.deepcopy(extra_gates)
+    out["label_shift"] = shift ^ delta
+    out.pop("_grader_mask_cache", None)
+    out.pop("_grader_decoy_cache", None)
+
+    answer = copy.deepcopy(inst["answer"])
+    for group_index in (0, 1):
+        mapped = []
+        for value in answer[group_index]:
+            for gate in extra_gates:
+                value = _apply_gate(value, gate)
+            mapped.append(value ^ delta)
+        answer[group_index] = sorted(mapped)
+    if answer[1] < answer[0]:
+        answer[0], answer[1] = answer[1], answer[0]
+    out["answer"] = answer
+    return out, answer
+
+
+def _reference_direct(inst: dict) -> tuple[list, dict]:
+    """The honest Track-B mechanical certificate extractor."""
+    t = inst["t"]
+    gates = inst["mixer"]
+    shift = inst["label_shift"]
+    left = sorted(_mix(2 * i, gates, shift) for i in range(t))
+    right = sorted(_mix(2 * i + 1, gates, shift) for i in range(t))
+    if right < left:
+        left, right = right, left
+    size = inst["block_size"]
+    answer = [
+        left,
+        right,
+        list(range(size, size + t)),
+        list(range(2 * size, 2 * size + t)),
+    ]
+    operations = 2 * t * len(gates) + 2 * t
+    return answer, {"gate_applications": operations}
+
+
+def _compact_dual(inst: dict) -> tuple[list, dict]:
+    """Use one transported covector and synthesize two opposite affine classes."""
+    mask = _transport_mask(inst["mixer"])
+    pivot_bit = (mask & -mask).bit_length() - 1
+    pivot = 1 << pivot_bit
+    below = pivot - 1
+
+    def kernel_label(payload: int) -> int:
+        # Insert a zero at the pivot coordinate, then choose that coordinate so
+        # the dot product with mask is zero.  This maps payloads injectively into
+        # the kernel of the transported covector.
+        label = (payload & below) | ((payload & ~below) << 1)
+        if (mask & label).bit_count() & 1:
+            label ^= pivot
+        return label
+
+    t = inst["t"]
+    left = sorted(kernel_label(i) for i in range(t))
+    right = sorted(value ^ pivot for value in left)
+    if right < left:
+        left, right = right, left
+    size = inst["block_size"]
+    answer = [
+        left,
+        right,
+        list(range(size, size + t)),
+        list(range(2 * size, 2 * size + t)),
+    ]
+    operations = len(inst["mixer"]) + 4 * t
+    return answer, {"bit_operations": operations}
+
+
+def escalate(params) -> dict | str | None:
+    """Grow the label haystack and decoy decoration at fixed witness length."""
+    current = {k: v for k, v in params.items() if k != "_preset"}
+    n = int(current.get("n", 20))
+    t = int(current.get("t", 12))
+    steps = int(current.get("mixer_steps", 192))
+    decoys = int(current.get("decoy_count", 30))
+    if n >= 120:
+        return "cap_bound"
+    return {
+        "n": min(120, n + 8),
+        "t": t,
+        "mixer_steps": min(240, steps + 24),
+        "decoy_count": min(4 * min(120, n + 8), decoys + 12),
+    }
+
+
+def _worst_answer_size(params: dict) -> tuple[int, int, int]:
+    size = 1 << params["n"]
+    t = params["t"]
+    answer = [
+        list(range(size - 2 * t, size - t)),
+        list(range(size - t, size)),
+        list(range(2 * size - t, 2 * size)),
+        list(range(3 * size - t, 3 * size)),
+    ]
+    # emit.sh uses the standard json.dumps separators, so measure that exact form.
+    text = json.dumps(answer)
+    return len(text), math.ceil(len(text) / 4), 4 * t
+
+
+def selftest() -> dict:
+    report = {
+        "paper": "2507.02263",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    g1_attempts = 0
+    g1_failures = []
+    json_roundtrips = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append([preset, seed, reason])
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_roundtrips += 1
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures and json_roundtrips == g1_attempts,
+        "attempts": g1_attempts,
+        "json_roundtrips": json_roundtrips,
+        "failures": g1_failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=90210, **ship_params)
+    answer = copy.deepcopy(inst["answer"])
+    drop = copy.deepcopy(answer)
+    drop[0].pop()
+    swap = copy.deepcopy(answer)
+    swap[0][0], swap[0][1] = swap[0][1], swap[0][0]
+    duplicate = copy.deepcopy(answer)
+    duplicate[1][0] = duplicate[0][0]
+    duplicate[1].sort()
+    out_of_range = copy.deepcopy(answer)
+    out_of_range[0][-1] = inst["block_size"]
+    corruptions = {
+        "drop": drop,
+        "swap": swap,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    g2_cases = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        g2_cases[name] = {"rejected": not ok, "reason": reason}
+    reasons = [case["reason"] for case in g2_cases.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(case["rejected"] for case in g2_cases.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": g2_cases,
+    }
+
+    encoded = json.dumps(answer, separators=(",", ":"))
+    realistic = (
+        "I used the transported parity cut and checked every cross-edge.\n\n"
+        "```json\n<answer>" + encoded + "</answer>\n```"
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and parse_answer("no tagged answer") is None,
+        "parsed_groups": len(parsed) if isinstance(parsed, list) else None,
+        "garbage_returns_none": parse_answer("no tagged answer") is None,
+    }
+
+    samples = 200_000
+    guess_rng = random.Random(0x250702263)
+    hits = 0
+    for _ in range(samples):
+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            hits += 1
+    observed = hits / samples
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": observed,
+        "structure_aware_space": search_space(inst),
+        "sampler": (
+            "uniform normalized disjoint t-sets in U and uniform t-sets in V,W; "
+            "all stated shape, block, sorting, and no-repeat rules enforced"
+        ),
+    }
+
+    demo = make_instance(seed=3, **DIFFICULTY["demo"])
+    start = time.perf_counter()
+    demo_count = enumerate_all(demo)
+    demo_seconds = time.perf_counter() - start
+    # G5 reuses the 200k shipping density sample and measures the strongest failing
+    # in-context attack (64 random affine masks) below.
+    baseline_start = time.perf_counter()
+    baseline_candidate = _attack_candidates(inst, random_seed=99173)[
+        "random_parity_masks_64"
+    ]
+    baseline_ok = verify(inst, baseline_candidate)[0]
+    baseline_seconds = time.perf_counter() - baseline_start
+    report["G5_density_and_baseline"] = {
+        "pass": observed < 1e-6 and demo_count is not None and not baseline_ok,
+        "shipping_valid_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_observed_solution_fraction": observed,
+        "demo_exact_solution_count": demo_count,
+        "demo_enumeration_wall_seconds": round(demo_seconds, 6),
+        "baseline_wall_seconds": round(baseline_seconds, 6),
+        "baseline_iterations": 64,
+        "baseline_attack": "random parity-mask restart",
+    }
+
+    attack_names = [
+        "outlier_degree_bit0_tiebreak",
+        "greedy_visible_popcount_parity",
+        "random_parity_masks_64",
+        "in_context_gate_frequency_ansatz",
+        "in_context_truncated_dual_transport",
+    ]
+    attack_results = {name: {"successes": 0, "attempts": 0} for name in attack_names}
+    ref_successes = 0
+    ref_times = []
+    ref_operations = []
+    compact_successes = 0
+    compact_times = []
+    compact_operations = []
+    for seed in range(3100, 3108):
+        attacked = make_instance(seed=seed, **ship_params)
+        candidates = _attack_candidates(attacked, random_seed=seed ^ 0xA5A5)
+        for name in attack_names:
+            attack_results[name]["attempts"] += 1
+            if verify(attacked, candidates[name])[0]:
+                attack_results[name]["successes"] += 1
+        start = time.perf_counter()
+        ref_answer, stats = _reference_direct(attacked)
+        ref_times.append(time.perf_counter() - start)
+        ref_operations.append(stats["gate_applications"])
+        if verify(attacked, ref_answer)[0]:
+            ref_successes += 1
+        start = time.perf_counter()
+        compact_answer, compact_stats = _compact_dual(attacked)
+        compact_times.append(time.perf_counter() - start)
+        compact_operations.append(compact_stats["bit_operations"])
+        if verify(attacked, compact_answer)[0]:
+            compact_successes += 1
+    all_failed = all(x["successes"] == 0 for x in attack_results.values())
+    sorted_times = sorted(ref_times)
+    median_time = (sorted_times[3] + sorted_times[4]) / 2
+    sorted_ops = sorted(ref_operations)
+    median_ops = (sorted_ops[3] + sorted_ops[4]) // 2
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and ref_successes == 8 and compact_successes == 8,
+        "attacks": attack_results,
+        "reference_algorithm": {
+            "name": "direct reversible-circuit transport of 2t base U vertices",
+            "complexity": "O(t * mixer_steps) exact bit-gate applications",
+            "median_wall_clock_sec": round(median_time, 6),
+            "median_operations": median_ops,
+            "operation_definition": "one CNOT/SWAP application or final XOR",
+            "solves": f"{ref_successes}/8, as expected",
+            "compact_route": (
+                "transport one dual covector and synthesize its two affine classes"
+            ),
+            "compact_route_median_wall_clock_sec": round(
+                sorted(compact_times)[len(compact_times) // 2], 6
+            ),
+            "compact_route_operations": sorted(compact_operations)[
+                len(compact_operations) // 2
+            ],
+            "compact_route_solves": f"{compact_successes}/8, as expected",
+        },
+    }
+
+    doubled = make_instance(
+        n=2 * ship_params["n"],
+        t=ship_params["t"],
+        mixer_steps=ship_params["mixer_steps"],
+        decoy_count=ship_params["decoy_count"],
+        seed=77,
+    )
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and search_space(doubled) > search_space(inst),
+        "shipping_dimension": ship_params["n"],
+        "doubled_dimension": doubled["dimension"],
+        "shipping_vertex_count": inst["vertex_count"],
+        "doubled_vertex_count": doubled["vertex_count"],
+        "shipping_space_bits": round(math.log2(search_space(inst)), 3),
+        "doubled_space_bits": round(math.log2(search_space(doubled)), 3),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    carried_checks = 0
+    distinct_keys = []
+    for seed in range(20):
+        original = make_instance(seed=7000 + seed, **ship_params)
+        key = canonical_key(original)
+        distinct_keys.append(key)
+        a, b = seed % ship_params["n"], (seed * 7 + 3) % ship_params["n"]
+        if a == b:
+            b = (b + 1) % ship_params["n"]
+        variants = [
+            _post_transform(original, [["C", a, b]], 0),
+            _post_transform(original, [["S", a, b]], 0),
+            _post_transform(original, [], 1 << ((seed + 5) % ship_params["n"])),
+            _post_transform(
+                original,
+                [["C", a, b], ["S", b, (b + 1) % ship_params["n"]]],
+                1 << ((seed + 11) % ship_params["n"]),
+            ),
+        ]
+        for variant, carried in variants:
+            invariant_checks += 1
+            if canonical_key(variant) == key and verify(variant, carried)[0]:
+                carried_checks += 1
+    report["G8_canonical_key"] = {
+        "pass": invariant_checks == 80
+        and carried_checks == 80
+        and len(set(distinct_keys)) == 20,
+        "invariance_checks": invariant_checks,
+        "carried_witness_checks": carried_checks,
+        "unrelated_distinct": len(set(distinct_keys)),
+        "unrelated_attempts": 20,
+        "symmetries": [
+            "visible CNOT relabelling",
+            "visible bit swap",
+            "visible XOR translation",
+            "composed affine relabelling",
+        ],
+        "key_scope": "canonical pre-mixer Cayley decoration; see README caveat",
+    }
+
+    chars, tokens, elements = _worst_answer_size(ship_params)
+    compact_answer, compact_stats = _compact_dual(inst)
+    intended_ops = compact_stats["bit_operations"]
+    compact_route_ok = verify(inst, compact_answer)[0]
+    arms = copy.deepcopy(G9_RESULTS["arms"])
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = (
+        hinted["solved"] / hinted["attempts"]
+        if isinstance(hinted["solved"], int) and hinted["attempts"]
+        else 0.0
+    )
+    placebo_rate = (
+        placebo["solved"] / placebo["attempts"]
+        if isinstance(placebo["solved"], int) and placebo["attempts"]
+        else 0.0
+    )
+    within_caps = (
+        chars <= 2000
+        and elements <= 256
+        and intended_ops <= 300
+        and compact_route_ok
+    )
+    hinted_hardened = G9_RESULTS["hinted_verdict"] == "hardened"
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_hardened and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": chars,
+        "answer_tokens": tokens,
+        "answer_elements": elements,
+        "intended_route_operations": intended_ops,
+        "intended_route_verified": compact_route_ok,
+    }
+
+    report["problem_profile"] = PROBLEM_PROFILE
+    report["certificate_language"] = CERTIFICATE_LANGUAGE
+    report["all_passed"] = all(
+        value.get("pass") is True
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
