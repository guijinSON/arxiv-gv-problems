+def _divide_monic_linear(poly, constant, counter=None):
+    """Return q with poly=(x+constant)q; caller guarantees exact division."""
+    degree = len(poly) - 1
+    quotient = [0] * degree
+    quotient[-1] = poly[-1]
+    for index in range(degree - 1, 0, -1):
+        quotient[index - 1] = poly[index] - constant * quotient[index]
