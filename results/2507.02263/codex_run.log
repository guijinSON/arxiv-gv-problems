+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _trim(poly):
+    out = list(poly)
+    while out and out[-1] == 0:
+        out.pop()
+    return out
+
+
+def _poly_add(a, b):
+    out = [0] * max(len(a), len(b))
+    for i, value in enumerate(a):
+        out[i] += value
+    for i, value in enumerate(b):
+        out[i] += value
+    return _trim(out)
+
+
+def _poly_mul(a, b, operation_counter=None):
+    if not a or not b:
+        return []
+    out = [0] * (len(a) + len(b) - 1)
+    for i, left in enumerate(a):
+        for j, right in enumerate(b):
+            out[i + j] += left * right
+            if operation_counter is not None:
+                operation_counter[0] += 2  # one multiplication and one addition
+    return _trim(out)
+
+
+def _divide_by_monic_linear(poly, root, operation_counter=None):
+    """Return poly/(x-root), knowing the division is exact."""
+    degree = len(poly) - 1
+    quotient = [0] * degree
+    quotient[-1] = poly[-1]
+    for k in range(degree - 1, 0, -1):
+        quotient[k - 1] = poly[k] + root * quotient[k]
+        if operation_counter is not None:
+            operation_counter[0] += 2
+    if poly[0] + root * quotient[0] != 0:
+        raise ArithmeticError("non-exact synthetic division")
+    if operation_counter is not None:
+        operation_counter[0] += 2
+    return quotient
+
+
+def _multipartite_minpoly(part_sizes, with_operations=False):
+    """Characteristic polynomial of the multipartite equitable quotient.
+
+    For sizes s_i and N=sum s_i, the quotient is
+        diag(N-2s_i) + 1*s^T.
+    Thus det(xI-B)=prod_i(x-N+2s_i)
+                    -sum_i s_i prod_{j!=i}(x-N+2s_j).
+    Coefficients are dense and ascending.
+    """
+    sizes = list(part_sizes)
+    total = sum(sizes)
+    counter = [0]
+    product = [1]
+    poles = [total - 2 * size for size in sizes]
+    for pole in poles:
+        product = _poly_mul(product, [-pole, 1], counter)
+    result = list(product)
+    for size, pole in zip(sizes, poles):
+        quotient = _divide_by_monic_linear(product, pole, counter)
+        for j, coefficient in enumerate(quotient):
+            result[j] -= size * coefficient
+            counter[0] += 2
+    result = _trim(result)
+    if result[-1] != 1:
+        raise AssertionError("quotient polynomial is not monic")
+    return (result, counter[0]) if with_operations else result
+
+
+def _mod_trim(poly, prime):
+    return _trim([value % prime for value in poly])
+
+
+def _mod_divmod(a, b, prime):
+    a = _mod_trim(a, prime)
+    b = _mod_trim(b, prime)
+    if not b:
+        raise ZeroDivisionError
+    remainder = list(a)
+    quotient = [0] * max(0, len(a) - len(b) + 1)
+    inverse = pow(b[-1], prime - 2, prime)
+    while len(remainder) >= len(b) and remainder:
+        shift = len(remainder) - len(b)
+        factor = remainder[-1] * inverse % prime
+        quotient[shift] = factor
+        for i, coefficient in enumerate(b):
+            remainder[i + shift] = (
+                remainder[i + shift] - factor * coefficient
+            ) % prime
+        remainder = _mod_trim(remainder, prime)
+    return _mod_trim(quotient, prime), remainder
+
+
+def _mod_gcd(a, b, prime):
+    left, right = _mod_trim(a, prime), _mod_trim(b, prime)
+    while right:
+        _, remainder = _mod_divmod(left, right, prime)
+        left, right = right, remainder
+    if not left:
+        return []
+    inverse = pow(left[-1], prime - 2, prime)
+    return [(coefficient * inverse) % prime for coefficient in left]
+
+
+def _mod_mul(a, b, modulus, prime):
+    product = [0] * (len(a) + len(b) - 1)
+    for i, left in enumerate(a):
+        for j, right in enumerate(b):
+            product[i + j] = (product[i + j] + left * right) % prime
+    _, remainder = _mod_divmod(product, modulus, prime)
+    return remainder
+
+
+def _mod_pow(base, exponent, modulus, prime):
+    result = [1]
+    power = _mod_trim(base, prime)
+    while exponent:
+        if exponent & 1:
+            result = _mod_mul(result, power, modulus, prime)
+        exponent >>= 1
+        if exponent:
+            power = _mod_mul(power, power, modulus, prime)
+    return result
+
+
+def _prime_divisors(value):
+    divisors = []
+    candidate = 2
+    while candidate * candidate <= value:
+        if value % candidate == 0:
+            divisors.append(candidate)
+            while value % candidate == 0:
+                value //= candidate
+        candidate += 1
+    if value > 1:
+        divisors.append(value)
+    return divisors
+
+
+def _irreducible_mod_prime(poly, prime):
+    """Rabin's exact irreducibility test for a monic polynomial over F_p."""
+    f = _mod_trim(poly, prime)
+    degree = len(f) - 1
+    if degree < 1 or f[-1] != 1:
+        return False
+    x_poly = [0, 1]
+    needed = {degree // q for q in _prime_divisors(degree)}
+    frobenius = x_poly
+    snapshots = {}
+    for step in range(1, degree + 1):
+        frobenius = _mod_pow(frobenius, prime, f, prime)
+        if step in needed:
+            snapshots[step] = frobenius
+    difference = _poly_add(
+        frobenius,
+        [(-coefficient) % prime for coefficient in x_poly],
+    )
+    if _mod_trim(difference, prime):
+        return False
+    for step in needed:
+        difference = _poly_add(
+            snapshots[step],
+            [(-coefficient) % prime for coefficient in x_poly],
+        )
+        if len(_mod_gcd(difference, f, prime)) > 1:
+            return False
+    return True
+
+
+def _irreducibility_prime(poly):
+    for prime in _SMALL_PRIMES:
+        if _irreducible_mod_prime(poly, prime):
+            return prime
+    return None
