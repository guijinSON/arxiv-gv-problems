+def _mod_pow(base, exponent, modulus, prime):
+    result = [1]
+    power = _mod_trim(base, prime)
+    while exponent:
+        if exponent & 1:
+            result = _mod_mul(result, power, modulus, prime)
+        exponent >>= 1
+        if exponent:
+            power = _mod_mul(power, power, modulus, prime)
