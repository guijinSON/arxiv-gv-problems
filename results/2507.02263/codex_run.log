+def _reference_direct(inst: dict) -> tuple[list, dict]:
+    """The honest Track-B mechanical certificate extractor."""
+    t = inst["t"]
+    gates = inst["mixer"]
+    shift = inst["label_shift"]
+    left = sorted(_mix(2 * i, gates, shift) for i in range(t))
+    right = sorted(_mix(2 * i + 1, gates, shift) for i in range(t))
+    if right < left:
+        left, right = right, left
+    size = inst["block_size"]
+    answer = [
+        left,
+        right,
+        list(range(size, size + t)),
+        list(range(2 * size, 2 * size + t)),
+    ]
+    operations = 2 * t * len(gates) + 2 * t
+    return answer, {"gate_applications": operations}
 
 
