+def _primitive_integer(poly):
+    fractions = [Fraction(value) for value in poly]
+    lcm = 1
+    for value in fractions:
+        lcm = math.lcm(lcm, value.denominator)
+    integers = [int(value * lcm) for value in fractions]
+    divisor = 0
+    for value in integers:
