+    """Check any normalized K_4[t] witness without consulting inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if len(answer) == 0:
+        return False, "answer is empty"
+    if len(answer) != 4:
+        return False, "expected exactly four groups"
+    t = inst["t"]
+    for index, group in enumerate(answer):
+        if not isinstance(group, list):
+            return False, f"group {index} must be a list"
+        if len(group) != t:
+            return False, f"group {index} must contain exactly {t} labels"
+        if any(isinstance(x, bool) or not isinstance(x, int) for x in group):
+            return False, f"group {index} contains a non-integer label"
+        if any(group[i] >= group[i + 1] for i in range(t - 1)):
+            return False, f"group {index} is not strictly increasing"
