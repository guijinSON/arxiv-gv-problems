+        "strongest_failing_attack_iterations": 256,
+        "reference_wall_clock_sec": reference["wall_clock_sec"],
+        "reference_operation_count": reference["operations"],
+        "reference_sturm_queries": reference["sturm_grid_queries"],
+    }
+
+    doubled_params = {"n": shipping["n"] * 2, "parts": shipping["parts"]}
+    started = time.perf_counter()
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_build = time.perf_counter() - started
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    ladder_n = [params["n"] for params in DIFFICULTY.values()]
+    ladder_parts = [params["parts"] for params in DIFFICULTY.values()]
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["n"] == 2 * inst["n"]
+        and search_space(doubled) > search_space(inst)
+        and len(render(doubled)) > len(render(inst))
+        and ladder_n == sorted(ladder_n)
+        and ladder_parts == sorted(ladder_parts),
+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "shipping_search_space_bits": search_space(inst).bit_length(),
+        "doubled_search_space_bits": search_space(doubled).bit_length(),
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariant = 0
+    real = 0
+    unrelated_keys = []
+    for seed in range(201, 221):
+        original = make_instance(seed=seed, **shipping)
+        original_key = canonical_key(original)
+        n = original["n"]
+        rng = random.Random(seed ^ 0xA55A)
+        random_permutation = list(range(n))
+        rng.shuffle(random_permutation)
