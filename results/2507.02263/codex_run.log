+def _rows_from_classes(classes):
+    order = len(classes)
+    rows = []
+    for left in range(order):
+        bits = 0
+        for right in range(order):
+            if classes[left] != classes[right]:
+                bits |= 1 << right
+        rows.append(bits)
+    width = (order + 3) // 4
+    return [format(bits, "0%dx" % width) for bits in rows]
