+def _irreducible_mod_prime(poly, prime):
+    """Rabin's exact irreducibility criterion over GF(prime)."""
+    modulus = _fp_trim(poly, prime)
+    degree = len(modulus) - 1
+    if degree < 1 or modulus[-1] == 0:
+        return False
+    x_poly = [0, 1]
+    for divisor in _prime_divisors(degree):
