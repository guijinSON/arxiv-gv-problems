+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 12, "parts": 3},
+    "easy": {"n": 96, "parts": 4},
+    "medium": {"n": 192, "parts": 5},
+    "hard": {"n": 384, "parts": 6},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Vertices with identical adjacency rows form the cells of a small "
+    "equitable quotient for the signless Laplacian."
+)
+PLACEBO_HINT = (
+    "Careful attention to coefficient order and rational endpoints matters "
+    "in this exact spectral calculation."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A monic integer minimal polynomial of degree equal to the stated "
+        "number r of parts, written constant coefficient first, plus an open "
+        "rational isolating interval. Lower coefficients have absolute value "
+        "at most (1+2n)^r. Endpoints are grid rationals [j,2^B], where "
