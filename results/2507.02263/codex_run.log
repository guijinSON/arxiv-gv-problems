+def _sturm_chain(poly):
+    first = _q_trim(poly)
+    second = [Fraction(index) * first[index] for index in range(1, len(first))]
+    second = _q_trim(second)
+    chain = [first, second]
+    while len(chain[-1]) > 1:
+        _, remainder = _q_divmod(chain[-2], chain[-1])
+        if not remainder:
+            break
+        chain.append([-value for value in remainder])
+    return chain
+
