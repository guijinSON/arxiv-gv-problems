+    chars, tokens, elements = _worst_answer_size(ship_params)
+    compact_answer, compact_stats = _compact_dual(inst)
+    intended_ops = compact_stats["bit_operations"]
+    compact_route_ok = verify(inst, compact_answer)[0]
+    arms = copy.deepcopy(G9_RESULTS["arms"])
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
