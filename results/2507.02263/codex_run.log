+    ),
+)
+try:
+    from gvlib import exact_matrices, rationals, roots as gv_roots
+except ImportError:  # pragma: no cover - a complete stdlib fallback is below
+    exact_matrices = rationals = gv_roots = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "real_algebraic",
+    "computational_core": "linear_algebra",
+    "certificate_form": "algebraic_number",
+    "native_objects": [
+        "complete multipartite graph",
+        "signless Laplacian matrix",
+        "Perron root as a real algebraic number",
+    ],
+    "verification_operations": [
+        "exact adjacency-row comparison",
+        "integer polynomial multiplication",
+        "finite-field irreducibility test",
+        "Sturm root count over exact rationals",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "Equal adjacency rows are independent twin classes, so the dense "
+        "signless-Laplacian eigenproblem collapses to a small equitable "
+        "quotient; without recognizing those classes one must run an exact "
+        "spectral computation on the full matrix."
+    ),
+    "hardness_basis": (
+        "Track B: exact Krylov moments plus rational recurrence recovery solve "
+        "the shipping instances in O(r*n^2+r^3) arithmetic; final measured "
+        "wall-clock and operation counts are recorded by selftest, whereas "
+        "the six-cell determinant-lemma route uses at most 186 exact "
+        "arithmetic operations after the twin-class symmetry is recognized."
+    ),
+    "max_answer_tokens": 160,
+}
+
+NATIVE = {
