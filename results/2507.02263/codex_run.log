+def _interval_bits(n, part_count):
+    # A deliberately conservative Mignotte-style separation budget.  It also
+    # fixes a finite grid for CERTIFICATE_LANGUAGE.
+    return max(
+        64,
+        (part_count - 1) * (part_count * (n.bit_length() + 1) + 4) + 32,
+    )
+
+
+def _build_rows(part_sizes, rng):
+    n = sum(part_sizes)
+    labels = list(range(n))
+    rng.shuffle(labels)
+    rows = [0] * n
+    all_mask = (1 << n) - 1
+    position = 0
+    for size in part_sizes:
+        group = labels[position : position + size]
+        position += size
+        group_mask = 0
+        for vertex in group:
+            group_mask |= 1 << vertex
+        row = all_mask ^ group_mask
+        for vertex in group:
+            rows[vertex] = row
+    return rows
+
+
+def make_instance(n, seed=0, **params):
+    """Construct a relabelled complete multipartite graph and its exact q(G).
