+def random_candidate(inst, rng) -> object:
+    """Sample uniformly from the normalized, shape-aware certificate language."""
+    size = inst["block_size"]
+    t = inst["t"]
+    picked = _sample_distinct(rng, size, 2 * t)
+    rng.shuffle(picked)
