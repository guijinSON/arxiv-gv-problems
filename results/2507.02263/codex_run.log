+        sizes = [cuts[0]]
+        sizes.extend(cuts[index] - cuts[index - 1] for index in range(1, k - 1))
+        sizes.append(order - cuts[-1])
+        if min(sizes) < 2 or len(set(sizes)) != k:
+            continue
+        poly = _spectral_polynomial(sizes)
