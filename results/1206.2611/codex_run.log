+def escalate(params) -> dict | str | None:
+    harder = dict(params)
+    n = harder.get("n")
+    if isinstance(n, bool) or not isinstance(n, int) or n < 1:
+        return None
+    # Repetition grows the expanded mutation haystack without lengthening the
+    # answer or the compact dihedral route.
+    harder["n"] = n * 10
+    return harder
