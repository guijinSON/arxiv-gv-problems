\begin{theorem}
 The LP algebras of rank two that have finite type are classified as follows:
\begin{itemize}
 \item $P=Q$, the cluster complex is a triangle;
 \item $P \not = Q$ and $Q$ does not depend on $x$, the cluster complex is a quadrilateral;
 \item $Q$ is linear in $x$, $P$ is linear in $y$, the cluster complex is a pentagon;
 \item $Q$ is linear in $x$, $P$ is quadratic in $y$, the cluster complex is a hexagon;
 \item $Q$ is linear in $x$, $P$ is cubic in $y$, the cluster complex is an octagon.
\end{itemize}
\end{theorem}




