+    report["G9_no_tool_suitability"] = {
+        "pass": evidence["hinted_verdict"] == "hardened" and within_caps,
+        "arms": {
+            "bare": dict(evidence["bare"]),
+            "hinted": dict(evidence["hinted"]),
+            "placebo": dict(evidence["placebo"]),
