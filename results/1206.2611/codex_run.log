+# ---------------------------------------------------------------------------
+# The exact order-eight coefficient action from the proof of Theorem 6.4.
+
+ROLES = ("A", "B", "C", "D", "E", "F", "G", "H", "K", "L")
+ROLE_INDEX = {name: i for i, name in enumerate(ROLES)}
+GENERATOR_PAIRS = {
+    1: (("D", "G"), ("E", "F"), ("K", "L")),
+    2: (("A", "D"), ("B", "C"), ("F", "K"), ("G", "H")),
+}
