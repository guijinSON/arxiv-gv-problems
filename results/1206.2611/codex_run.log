+        "without recognizing it, the compressed powers expand to millions of "
+        "successive exact mutations."
+    ),
+    "hardness_basis": (
+        "Track B: successive Section 6 cubic coefficient mutation is linear in "
+        "the expanded word length; at the hard preset the reference run applies "
+        "about 1.6 million mutation symbols (about 5.7 million exact role swaps), "
+        "whereas dihedral block evaluation and fingerprint assembly use at most "
+        "280 exact operations."
+    ),
+    "max_answer_tokens": 64,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 1, "components": 1, "base_len": 3},
+    "easy": {"n": 100, "components": 8, "base_len": 5},
+    "medium": {"n": 500, "components": 8, "base_len": 7},
