+            sample_hits += 1
+    sample_seconds = time.perf_counter() - sample_started
+    empirical = sample_hits / sample_total
+    report["G4_guess_resistance"] = {
+        "pass": empirical < 1e-6,
+        "hits": sample_hits,
+        "total": sample_total,
