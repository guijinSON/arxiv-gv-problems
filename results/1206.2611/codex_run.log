        "greedy_first_unused",
        "random_restart_256",
        "fixed_offsets_0_plusminus1",
    )
    attack_successes = {name: 0 for name in attack_names}
    reference_successes = 0
    reference_scans = []
    reference_times = []
    attack_seeds = list(range(800, 808))
