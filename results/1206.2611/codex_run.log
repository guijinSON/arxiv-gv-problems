+
+def _attack_last_block(inst: dict) -> list:
+    states = []
+    for component in inst["components"]:
+        block = component["blocks"][-1]
+        states.append(_power_state(_word_state(block["base"]), block["repeat"]))
+    return _candidate_for_states(inst, states)
