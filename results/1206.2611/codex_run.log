+    elapsed = time.perf_counter() - started
+    return {
+        "answer": answer,
+        "ok": verify(inst, answer)[0],
+        "wall_clock_sec": elapsed,
+        "mutation_symbols": mutation_symbols,
+        "role_swap_operations": role_swaps,
