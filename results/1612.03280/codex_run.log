+        "component_size": total_cells,
+        "target_colors": 2 * total_cells - n,
+        "interval_model": {
+            "first_clique": [0, 1],
+            "second_clique": [2, 3],
+            "closed": True,
+        },
+        "rows": rows,
+        "answer": answer,
+    }
+
