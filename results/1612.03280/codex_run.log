+
+# Updated after the required independent harden.py runs.  The values are consumed
+# by selftest so the final report cannot silently disagree with the transcripts.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 3},
+        "hinted": {"solved": 0, "attempts": 3},
