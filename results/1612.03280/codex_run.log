+    "hardness_basis": (
+        "Track B: Hopcroft--Karp solves the encoded bipartite matching problem in "
+        "O(E sqrt(V)); shipping measurements are filled from selftest, while the "
+        "compact common-displacement route uses at most n+3d=163 modular operations."
+    ),
+    "max_answer_tokens": 200,
+}
