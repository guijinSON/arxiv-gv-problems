+# The bare loop failed before G9, so these arms were deliberately not run.  Keeping
+# the non-result explicit prevents the experimental module's selftest from claiming
+# a gate that has no transcript evidence.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
