+            "name": "Hopcroft-Karp bipartite maximum matching",
+            "complexity": "O(E sqrt(V))",
+            "wall_clock_sec_median": median_wall,
+            "operations_median_edge_scans": median_scans,
+            "solves": f"{reference_successes}/{len(attack_seeds)}, as expected",
