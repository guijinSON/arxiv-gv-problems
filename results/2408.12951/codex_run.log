+    vertices = []
+    for row in inst["vertices"]:
+        vertices.append({
+            "id": mapping[row["id"]],
+            "coordinates": list(row["coordinates"]),
+            "nonneighbors": [mapping[value] for value in row["nonneighbors"]],
+        })
+    for row in vertices:
+        rng.shuffle(row["nonneighbors"])
