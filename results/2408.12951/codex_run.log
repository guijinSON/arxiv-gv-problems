+def _residual_score(inst, candidate, limit=None):
+    rows = _equation_rows(inst, first_component_only=False)
+    if limit is not None:
+        rows = rows[:limit]
+    prime = inst["prime"]
+    return sum(bool(sum(a * b for a, b in zip(row, candidate)) % prime) for row in rows)
