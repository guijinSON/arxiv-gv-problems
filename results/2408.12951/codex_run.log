+    if error is not None:
+        return "invalid:" + error
+    payload = [
+        inst["prime"],
+        inst["dimension"],
+        sorted(len(component) for component in data["components"]),
+    ]
+    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
