+def _random_gl(size, prime, rng):
+    """An invertible dense matrix, built only with invertible row operations."""
+    matrix = _identity(size)
+    rounds = max(20, 8 * size)
+    for _ in range(rounds):
+        operation = rng.randrange(3)
+        if operation == 0:
