+def make_instance(n, seed=0, dimension=6, prime=2147483647, class_spread=5, **params):
+    """Inverse-generate a graph and a normalized covector b*-certificate."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
