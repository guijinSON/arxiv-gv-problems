+    "The finite-field sum of a step set is covariant under multiplicative relabelling."
+)
+PLACEBO_HINT: str = (
+    "The displayed residue lists are sets, so their written order carries no significance."
+)
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "cyclic Cayley digraph over a prime field",
+        "arc structure with the paper's D, I, and O incidence relations",
+        "affine vertex map inducing a homomorphism of arc structures",
+    ],
+    "verification_operations": [
+        "exact prime-field multiplication and addition",
+        "finite-set equality of edge-step residues",
+        "symbolic preservation of the D, I, and O incidence equalities",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Recognize a field-valued statistic of the two Cayley step sets that scales "
+        "by the hidden affine multiplier; without it, compare candidate induced "
+        "arc-structure maps one multiplier at a time."
+    ),
+    "hardness_basis": (
+        "Track B: the domain-standard anchor-image enumeration is an O(m^2) exact "
+        "affine Cayley-isomorphism algorithm; at hard (m=140) its eight-seed median "
+        "is 14,312 field operations and 0.00097 seconds, while the covariant-sum "
+        "route uses exactly 280 field operations and must be discovered and executed "
+        "without computational tools."
+    ),
+    "max_answer_tokens": 4,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+DIFFICULTY: dict = {
+    "demo": {"n": 11, "step_count": 5},
+    "easy": {"n": 2_000_000, "step_count": 60},
+    "medium": {"n": 3_000_000, "step_count": 100},
+    "hard": {"n": 5_000_000, "step_count": 140},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "An affine map Phi(x)=u*x+b over the stated prime field, encoded as exactly "
+        "two canonical integers [u,b], with 1 <= u < p and 0 <= b < p."
