+        matches = re.findall(
+            r"(?m)^\s*(?:final(?:\s+answer)?\s*:\s*)?[\[\(]?\s*"
+            r"([+-]?\d+)\s*,\s*([+-]?\d+)\s*[\]\)]?\s*$",
+            body,
+            re.I,
+        )
+        if not matches:
+            return None
+        match_values = matches[-1]
+        return [int(match_values[0]), int(match_values[1])]
+    return [int(match.group(1)), int(match.group(2))]
