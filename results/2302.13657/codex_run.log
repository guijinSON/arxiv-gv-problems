+            compact_successes += 1
+
+    all_attacks_failed = all(
+        result["successes"] == 0 for result in attack_results.values()
+    )
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == 8 and compact_successes == 8,
