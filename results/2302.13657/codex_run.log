\title[Functors which admit both left and right adjoints]{Functors on relational structures which admit both left and right adjoints}

\author{Víctor Dalmau}
\address{Universitat Pompeu Fabra, Barcelona, Spain}
\email{victor.dalmau@upf.edu}

\author{Andrei Krokhin}
