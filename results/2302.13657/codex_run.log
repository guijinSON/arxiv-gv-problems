+    arms_complete = all(entry["attempts"] >= 3 for entry in arms.values())
+    hinted_hardened = G9_RESULTS["hinted_verdict"] == "hardened"
+    intended_operations = 2 * (inst["step_count"] - 1) + 2
+    within_caps = (
+        size["chars"] <= 2000
+        and size["elements"] <= 256
