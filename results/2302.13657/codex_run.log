+def verify(inst, answer) -> tuple[bool, str]:
+    """Check any affine induced isomorphism; never inspect inst['answer']."""
+    if answer is None:
+        return False, "answer is absent or malformed"
+    if not isinstance(answer, list):
+        return False, "answer must be a two-integer list"
+    if len(answer) == 0:
+        return False, "answer is empty"
+    if len(answer) == 1:
+        return False, "answer is missing the translation coefficient"
+    if len(answer) > 2:
+        return False, "answer has extra fields"
+    if any(type(value) is not int for value in answer):
+        return False, "both affine coefficients must be exact integers"
+    u, b = answer
+    p = inst["p"]
+    if u == 0:
+        return False, "the multiplier is zero and hence not bijective"
+    if not 1 <= u < p:
+        return False, "the multiplier is outside the canonical field range"
+    if not 0 <= b < p:
+        return False, "the translation is outside the canonical field range"
