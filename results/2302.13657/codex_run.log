+
+    size = _answer_size(answer)
+    arms = copy.deepcopy(G9_RESULTS["arms"])
+    placebo_attempts = arms["placebo"]["attempts"]
+    hinted_attempts = arms["hinted"]["attempts"]
+    placebo_rate = (
