+# These fields are replaced after the three harness runs.  Keeping the pending
+# state explicit prevents a local self-test from masquerading as oracle evidence.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
