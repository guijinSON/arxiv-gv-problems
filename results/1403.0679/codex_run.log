\caption{Examples of band graphs.}
\label{fig:finite slices}
\end{figure}

All of the connected components of $G_{4}(M)$ and
$G_{7}(M)$ are finite. The minimum $\ell \in \NN$ such that
$G_{\ell}(M)$ has an infinite connected component is $\ell = 10$
(see Figure~\ref{fig:infinite slice}).

\begin{figure}[h]
\begin{center}
\begin{tikzpicture}[thick,scale=0.8]
\draw [dotted, gray] (0,0) grid (10,4);
\draw [<->] (0,4) -- (0,0) -- (10,0);
\draw [thick] (0,0) -- (7,1);
\draw [thick] (8,2) -- (4,1);
\draw [thick] (0,0) -- (4,1);
\draw [thick] (3,0) -- (7,1);
