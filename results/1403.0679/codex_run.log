+            other_rows = sorted(
+                transformed[idx] for idx in range(len(B)) if idx not in target
+            )
+            representations.append(
+                json.dumps(
+                    {"target_rows": pair_rows, "other_rows": other_rows},
+                    separators=(",", ":"),
+                    sort_keys=True,
+                )
+            )
