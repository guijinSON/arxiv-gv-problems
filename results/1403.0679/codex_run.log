\end{minipage}%
\begin{minipage}{.4\textwidth}
\begin{tikzpicture}[thick,scale=0.8]
\draw [dotted, gray] (0,0) grid (7,3);
\draw [<->] (0,3) -- (0,0) -- (7,0);
\draw [thick] (0,0) -- (7,1);
