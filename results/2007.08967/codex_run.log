+_SUPPORTED = {
+    11: 2,
+    65_537: 3,
+    1_000_003: 2,
+    998_244_353: 3,
+}
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 2_000_000
+
+
+def _validate_params(n: int, p: int, omega: int, dimension: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 1:
+        raise ValueError("n must be a positive integer iteration count")
+    if p not in _SUPPORTED:
+        raise ValueError(f"p must be one of {sorted(_SUPPORTED)}")
+    if omega != _SUPPORTED[p]:
+        raise ValueError(f"omega must be the supported primitive element {_SUPPORTED[p]} for p={p}")
+    if isinstance(dimension, bool) or not isinstance(dimension, int):
+        raise ValueError("dimension must be an integer")
+    if dimension < 2 or dimension > 3:
+        raise ValueError("dimension must lie in 2..3")
+    # The four supported (prime, primitive-element) pairs are fixed constants;
+    # do not repeat a modular powering proof inside every verifier call.
+
+
+def _vec_add(x: list[int], y: list[int], p: int) -> list[int]:
+    return [(a + b) % p for a, b in zip(x, y)]
+
+
+def _vec_scale(c: int, x: list[int], p: int) -> list[int]:
+    return [(c * a) % p for a in x]
+
+
+def _rank_two(x: list[int], y: list[int], p: int) -> bool:
+    """Whether the d-by-2 matrix with columns x,y has rank two."""
+    for i in range(len(x)):
+        for j in range(i + 1, len(x)):
+            if (x[i] * y[j] - x[j] * y[i]) % p:
+                return True
+    return False
+
+
+def _pow_mod_count(base: int, exponent: int, p: int) -> tuple[int, int]:
+    """Binary modular powering and its exact multiplication count."""
+    if exponent < 0:
+        raise ValueError("exponent must be nonnegative")
+    base %= p
+    result = 1
+    operations = 0
+    while exponent:
+        if exponent & 1:
+            result = (result * base) % p
+            operations += 1
+        exponent >>= 1
+        if exponent:
+            base = (base * base) % p
+            operations += 1
+    return result, operations
+
+
+def _slice_scalar(p: int, omega: int, exponent: int) -> int:
+    return pow(omega, (-exponent) % (p - 1), p)
+
+
+def _powered_vectors(x: list[int], y: list[int], s: int,
+                     power: int, p: int) -> tuple[list[int], list[int]]:
+    """Apply (x,y)->(s*y,x+(1-s)*y) exactly ``power`` times."""
+    factor = pow((-s) % p, power % (p - 1), p)
+    inv_denom = pow((1 + s) % p, p - 2, p)
+    out_x: list[int] = []
+    out_y: list[int] = []
+    for xi, yi in zip(x, y):
+        c = (xi + yi) % p
+        d = (xi - s * yi) % p
+        powered_d = factor * d % p
+        out_x.append((powered_d + s * c) * inv_denom % p)
+        out_y.append((c - powered_d) * inv_denom % p)
+    return out_x, out_y
+
+
+def _inverse_reference(inst: dict) -> tuple[dict, int]:
+    """Recover the unique source by the C,D eigen-coordinate identity."""
+    p = inst["p"]
+    q = inst["q"]
+    a = inst["exponent"]
+    n = inst["n"]
+    u = inst["target"]["u"][:-1]
+    v = inst["target"]["v"][:-1]
+
+    s, op_s = _pow_mod_count(inst["omega"], (-a) % q, p)
+    inverse_factor, op_factor = _pow_mod_count(
+        (-s) % p, (-n) % (p - 1), p
+    )
+    inv_denom, op_inv = _pow_mod_count((1 + s) % p, p - 2, p)
+    operations = op_s + op_factor + op_inv
+    x: list[int] = []
+    y: list[int] = []
+    for ui, vi in zip(u, v):
+        c = (ui + vi) % p                       # 1
+        d = (ui - s * vi) % p                  # 2
+        source_d = inverse_factor * d % p      # 1
+        xi = (source_d + s * c) % p            # 2
+        xi = xi * inv_denom % p                # 1
+        yi = (c - source_d) * inv_denom % p    # 2
+        operations += 9
+        x.append(xi)
+        y.append(yi)
+    return {"g": x + [a], "h": y + [a]}, operations
+
+
+def _one_inverse_candidate(inst: dict) -> dict:
+    """The tempting hand attack: undo only one of the n iterations."""
+    p = inst["p"]
+    a = inst["exponent"]
+    s = _slice_scalar(p, inst["omega"], a)
+    u = inst["target"]["u"][:-1]
+    v = inst["target"]["v"][:-1]
+    sinv = pow(s, p - 2, p)
+    y = [sinv * z % p for z in u]
+    x = [(vi - (1 - s) * yi) % p for vi, yi in zip(v, y)]
+    return {"g": x + [a], "h": y + [a]}
+
+
+def _group_mul(p: int, omega: int, left: list[int], right: list[int]) -> list[int]:
+    """Multiplication in F_p^d semidirect C_(p-1)."""
+    q = p - 1
+    factor = pow(omega, left[-1], p)
+    vector = [(x + factor * y) % p for x, y in zip(left[:-1], right[:-1])]
+    return vector + [(left[-1] + right[-1]) % q]
+
+
+def _group_inv(p: int, omega: int, value: list[int]) -> list[int]:
+    q = p - 1
+    factor = pow(omega, (-value[-1]) % q, p)
+    return [(-factor * x) % p for x in value[:-1]] + [(-value[-1]) % q]
+
+
+def _psi(value: list[int]) -> list[int]:
+    return [0] * (len(value) - 1) + [value[-1]]
+
+
+def _mul_word(p: int, omega: int, values: list[list[int]]) -> list[int]:
+    result = [0] * (len(values[0]) - 1) + [0]
+    for value in values:
+        result = _group_mul(p, omega, result, value)
+    return result
+
+
+def _r1_group(p: int, omega: int, g: list[int], h: list[int]
+              ) -> tuple[list[int], list[int]]:
+    """Corollary 5.4's R_1, evaluated from the displayed group word."""
+    gi = _group_inv(p, omega, g)
+    hi = _group_inv(p, omega, h)
+    first = _mul_word(p, omega, [_psi(gi), h, _psi(g)])
+    second = _mul_word(p, omega, [
+        _psi(_group_mul(p, omega, h, gi)),
+        hi,
+        _psi(g),
+        g,
+        _psi(gi),
+        h,
+        _psi(_group_mul(p, omega, g, hi)),
+    ])
+    return first, second
+
+
+def _r2_group(p: int, omega: int, g: list[int], h: list[int]
+              ) -> tuple[list[int], list[int]]:
+    """Corollary 5.4's R_2, the inverse of R_1."""
+    gi = _group_inv(p, omega, g)
+    hi = _group_inv(p, omega, h)
+    first = _mul_word(p, omega, [g, _psi(gi), h, _psi(g), gi])
+    second = _mul_word(p, omega, [_psi(h), g, _psi(hi)])
+    return first, second
+
+
+def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
+    """Inverse-generate a powered Yang--Baxter preimage instance."""
+    allowed = {"p", "omega", "dimension"}
+    unknown = set(params) - allowed
+    if unknown:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(unknown)))
+    p = params.get("p", 65_537)
+    omega = params.get("omega", _SUPPORTED.get(p))
+    dimension = params.get("dimension", 3)
+    _validate_params(n, p, omega, dimension)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    q = p - 1
+    # Avoid powers for which the long iterate becomes the identity or the
+    # one-step inverse attack is accidentally exact.
+    while True:
+        a = rng.randrange(1, q)
+        s = _slice_scalar(p, omega, a)
+        if s == p - 1:
+            continue
+        factor = pow((-s) % p, n % q, p)
+        if factor not in (1, (-s) % p):
+            break
+
+    while True:
+        x = [rng.randrange(p) for _ in range(dimension)]
+        y = [rng.randrange(p) for _ in range(dimension)]
+        if x == y or not _rank_two(x, y, p):
+            continue
+        u, v = _powered_vectors(x, y, s, n, p)
+        # Exclude the two most obvious guesses by construction.  This rejection
+        # is symmetric in the uniformly sampled source coordinates and creates
+        # no planted-vs-decoy population.
+        if (x, y) in ((u, v), (v, u)):
+            continue
+        break
+
+    answer = {"g": x + [a], "h": y + [a]}
+    return {
+        "family": "iterated_abelian_map_yang_baxter_preimage",
+        "n": n,
+        "p": p,
+        "q": q,
+        "omega": omega,
+        "dimension": dimension,
+        "exponent": a,
+        "target": {"u": u + [a], "v": v + [a]},
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render the full group/Yang--Baxter problem and output contract."""
+    p = inst["p"]
+    q = inst["q"]
+    d = inst["dimension"]
+    a = inst["exponent"]
+    u = inst["target"]["u"]
+    v = inst["target"]["v"]
+    zeroes = ",".join("0" for _ in range(d))
+    example_g = ",".join(["0"] * d + [str(a)])
+    example_h = ",".join(["1"] + ["0"] * (d - 1) + [str(a)])
+    statement = f"""Iterated Yang--Baxter preimage over a finite semidirect product
+
+All integer arithmetic below is exact.  Vector coordinates are reduced modulo
+p={p}; cyclic coordinates are reduced modulo q=p-1={q}.  The number omega={inst['omega']}
+is a primitive nonzero element modulo p.
+
+Define the nonabelian group G = F_p^{d} semidirect C_q.  Write a group element
+as (z,b), where z is a length-{d} vector over F_p and b is in 0..q-1.  Its
+product and the abelian endomorphism psi are
+
+  (z,b)*(w,c) = (z + omega^b w mod p, b+c mod q),
+  psi(z,b) = (({zeroes}), b).
+
+In a product such as abc, associate from the left.  Superscript -1 means the
+inverse in G.  Define R:GxG -> GxG by
+
+  R(g,h) = ( psi(g^-1) h psi(g),
+             psi(h g^-1) h^-1 psi(g) g psi(g^-1) h psi(g h^-1) ).
+
+This is the R_1 map arising from the bi-skew brace of psi.  R^n means n-fold
+composition, with n={inst['n']}.  Both unknown source elements have the same
+cyclic coordinate a={a}.  Find the unique ordered pair (g,h) such that
+
+  R^n(g,h) = (u,v),
+  u = {json.dumps(u, separators=(',', ':'))},
+  v = {json.dumps(v, separators=(',', ':'))}.
+
+Represent g and h as JSON arrays [z_0,...,z_{d-1},a].  They must be distinct;
+every z_i must be in 0..{p - 1}; order matters.  As a necessary invariant,
+their two vector parts must sum coordinatewise modulo p to the sum of the
+vector parts of u and v.
+
+Give your final answer inside <answer></answer> tags, as one JSON object with
+exactly the keys "g" and "h".
+Syntax-only example (not instance data):
+<answer>{{"g":[{example_g}],"h":[{example_h}]}}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the last tagged JSON pair; tolerate prose and fenced bodies."""
+    if not isinstance(text, str):
+        return None
+    for body in reversed(_ANSWER_RE.findall(text)):
+        body = body.strip()
+        if body.startswith("```") and body.endswith("```"):
+            lines = body.splitlines()
+            if len(lines) >= 3:
+                body = "\n".join(lines[1:-1]).strip()
+        try:
+            value = json.loads(body)
+        except (TypeError, ValueError):
+            continue
+        if (isinstance(value, dict) and set(value) == {"g", "h"}
+                and all(isinstance(value[k], list) for k in ("g", "h"))
+                and all(isinstance(z, int) and not isinstance(z, bool)
+                        for k in ("g", "h") for z in value[k])):
+            return value
+    return None
+
+
+def _validate_instance(inst: dict) -> tuple[bool, str]:
+    try:
+        n = inst["n"]
+        p = inst["p"]
+        omega = inst["omega"]
+        d = inst["dimension"]
+        q = inst["q"]
+        a = inst["exponent"]
+        target = inst["target"]
+        _validate_params(n, p, omega, d)
+    except (KeyError, TypeError, ValueError):
+        return False, "malformed Yang--Baxter instance"
+    if q != p - 1 or not isinstance(a, int) or isinstance(a, bool) or not (0 < a < q):
+        return False, "malformed cyclic parameters"
+    if not isinstance(target, dict) or set(target) != {"u", "v"}:
+        return False, "malformed target pair"
+    for name in ("u", "v"):
+        row = target[name]
+        if (not isinstance(row, list) or len(row) != d + 1
+                or any(isinstance(z, bool) or not isinstance(z, int) for z in row)):
+            return False, f"malformed target element {name}"
+        if any(z < 0 or z >= p for z in row[:-1]) or row[-1] != a:
+            return False, f"target element {name} is outside the stated slice"
+    return True, "ok"
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any valid source by exact powered substitution; never read the plant."""
+    valid, why = _validate_instance(inst)
+    if not valid:
+        return False, why
+    if not isinstance(answer, dict) or set(answer) != {"g", "h"}:
+        return False, 'answer must be a JSON object with exactly the keys "g" and "h"'
+    d = inst["dimension"]
+    p = inst["p"]
+    a = inst["exponent"]
+    for name in ("g", "h"):
+        row = answer[name]
+        if not isinstance(row, list) or len(row) != d + 1:
+            return False, f"{name} must contain exactly {d} vector coordinates followed by one cyclic coordinate"
+        if any(isinstance(z, bool) or not isinstance(z, int) for z in row):
+            return False, f"every coordinate of {name} must be an integer"
+        if any(z < 0 or z >= p for z in row[:-1]):
+            return False, f"a vector coordinate of {name} lies outside 0..{p - 1}"
+        if row[-1] != a:
+            return False, f"the cyclic coordinate of {name} must equal a={a}"
+    if answer["g"] == answer["h"]:
+        return False, "g and h must be distinct group elements"
+
+    x = answer["g"][:-1]
+    y = answer["h"][:-1]
+    u = inst["target"]["u"][:-1]
+    v = inst["target"]["v"][:-1]
+    for i, (xi, yi, ui, vi) in enumerate(zip(x, y, u, v)):
+        if (xi + yi - ui - vi) % p:
+            return False, f"the required vector-sum invariant fails at coordinate {i}"
+
+    s = _slice_scalar(p, inst["omega"], a)
+    got_u, got_v = _powered_vectors(x, y, s, inst["n"], p)
+    for i, (got, want) in enumerate(zip(got_u, u)):
+        if got != want:
+            return False, f"forward first target differs at coordinate {i}: got {got}, expected {want}"
+    for i, (got, want) in enumerate(zip(got_v, v)):
+        if got != want:
+            return False, f"forward second target differs at coordinate {i}: got {got}, expected {want}"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the public invariant-respecting certificate language."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    p = inst["p"]
+    d = inst["dimension"]
+    a = inst["exponent"]
+    u = inst["target"]["u"][:-1]
+    v = inst["target"]["v"][:-1]
+    total = [(ui + vi) % p for ui, vi in zip(u, v)]
+    while True:
+        x = [rng.randrange(p) for _ in range(d)]
+        y = [(c - xi) % p for c, xi in zip(total, x)]
+        if x != y:
+            return {"g": x + [a], "h": y + [a]}
+
+
+def search_space(inst: dict) -> int | None:
+    """Exact size of the bounded, invariant-respecting language."""
+    return inst["p"] ** inst["dimension"] - 1
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Brute-force exact valid-answer count when the declared space is small."""
+    space = search_space(inst)
+    if space is None or space > _ENUMERATION_CAP:
+        return None
+    p = inst["p"]
+    d = inst["dimension"]
+    a = inst["exponent"]
+    u = inst["target"]["u"][:-1]
+    v = inst["target"]["v"][:-1]
+    total = [(ui + vi) % p for ui, vi in zip(u, v)]
+    count = 0
+    for row in itertools.product(range(p), repeat=d):
+        x = list(row)
+        y = [(c - xi) % p for c, xi in zip(total, x)]
+        if x == y:
+            continue
+        candidate = {"g": x + [a], "h": y + [a]}
+        if verify(inst, candidate)[0]:
+            count += 1
+    return count
+
+
+def _linear_pair_signature(u: list[int], v: list[int], p: int) -> list[Any]:
+    """Complete orbit signature for a pair under simultaneous GL(d,p)."""
+    u_zero = all(x == 0 for x in u)
+    v_zero = all(x == 0 for x in v)
+    if u_zero and v_zero:
+        return ["rank0"]
+    if u_zero:
+        return ["rank1", "u_zero"]
+    if v_zero:
+        return ["rank1", "v_zero"]
+    pivot = next(i for i, x in enumerate(u) if x)
+    ratio = v[pivot] * pow(u[pivot], p - 2, p) % p
+    if all((vi - ratio * ui) % p == 0 for ui, vi in zip(u, v)):
+        return ["rank1", "v_equals_ratio_u", ratio]
+    return ["rank2"]
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonical under every simultaneous vector-space change of basis."""
+    valid, why = _validate_instance(inst)
+    if not valid:
+        raise ValueError(why)
+    u = inst["target"]["u"][:-1]
+    v = inst["target"]["v"][:-1]
+    form = [
+        inst["family"], inst["n"], inst["p"], inst["q"], inst["omega"],
+        inst["dimension"], inst["exponent"],
+        _linear_pair_signature(u, v, inst["p"]),
+    ]
+    payload = json.dumps(form, separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow iteration work and then field entropy without lengthening the answer."""
+    if not isinstance(params, dict):
+        return None
+    try:
+        n = int(params["n"])
+        p = int(params["p"])
+    except (KeyError, TypeError, ValueError):
+        return None
+    out = dict(params)
+    out["n"] = 4 * n + 1
+    primes = [11, 65_537, 1_000_003, 998_244_353]
+    if p in primes and p != primes[-1]:
+        new_p = primes[primes.index(p) + 1]
+        out["p"] = new_p
+        out["omega"] = _SUPPORTED[new_p]
+    else:
+        # n is unbounded and changes only the haystack; the certificate remains
+        # two fixed-dimension group elements.
+        out["p"] = p
+        out["omega"] = _SUPPORTED[p]
+    return out
+
+
+def _target_as_source(inst: dict) -> dict:
+    return {"g": list(inst["target"]["u"]), "h": list(inst["target"]["v"])}
+
+
+def _coordinate_minimum_attack(inst: dict) -> dict:
+    """Per-coordinate outlier guess, while respecting the public sum invariant."""
+    p = inst["p"]
+    a = inst["exponent"]
+    u = inst["target"]["u"][:-1]
+    v = inst["target"]["v"][:-1]
+    total = [(ui + vi) % p for ui, vi in zip(u, v)]
+    x = [min(ui, vi) for ui, vi in zip(u, v)]
+    y = [(c - xi) % p for c, xi in zip(total, x)]
+    return {"g": x + [a], "h": y + [a]}
+
+
+def _zero_mode_attack(inst: dict) -> dict:
+    """Obvious invariant-only ansatz D=x-s*y=0."""
+    p = inst["p"]
+    a = inst["exponent"]
+    s = _slice_scalar(p, inst["omega"], a)
+    inv_denom = pow((1 + s) % p, p - 2, p)
+    u = inst["target"]["u"][:-1]
+    v = inst["target"]["v"][:-1]
+    total = [(ui + vi) % p for ui, vi in zip(u, v)]
+    y = [c * inv_denom % p for c in total]
+    x = [s * yi % p for yi in y]
+    return {"g": x + [a], "h": y + [a]}
+
+
+def _random_restart_attack(inst: dict, rng: random.Random,
+                           restarts: int = 512) -> tuple[dict, int, bool]:
+    last = random_candidate(inst, rng)
+    for iteration in range(1, restarts + 1):
+        last = random_candidate(inst, rng)
+        if verify(inst, last)[0]:
+            return last, iteration, True
+    return last, restarts, False
+
+
+def _mechanical_inverse_prefix(inst: dict, cap: int = 500_000
+                               ) -> tuple[int, int, float, int]:
+    """Time a real prefix of literal R_2 iteration on the public target."""
+    p = inst["p"]
+    a = inst["exponent"]
+    d = inst["dimension"]
+    s = _slice_scalar(p, inst["omega"], a)
+    sinv = pow(s, p - 2, p)
+    one_minus_s = (1 - s) % p
+    x = list(inst["target"]["u"][:-1])
+    y = list(inst["target"]["v"][:-1])
+    steps = min(inst["n"], cap)
+    t0 = time.perf_counter()
+    for _ in range(steps):
+        new_y = [sinv * value % p for value in x]
+        new_x = [(yi - one_minus_s * nyi) % p for yi, nyi in zip(y, new_y)]
+        x, y = new_x, new_y
+    elapsed = time.perf_counter() - t0
+    checksum = sum(x) + 3 * sum(y)
+    required_operations = 3 * d * inst["n"]
+    return steps, required_operations, elapsed, checksum
+
+
+def _apply_basis_ops(vector: list[int], permutation: list[int],
+                     scales: list[int], shear: tuple[int, int, int] | None,
+                     p: int) -> list[int]:
+    out = [vector[i] for i in permutation]
+    out = [c * x % p for c, x in zip(scales, out)]
+    if shear is not None:
+        dst, src, amount = shear
+        out[dst] = (out[dst] + amount * out[src]) % p
+    return out
+
+
+def _basis_transform_instance(inst: dict, permutation: list[int],
+                              scales: list[int],
+                              shear: tuple[int, int, int] | None) -> dict:
+    """Carry target and witness through a true simultaneous GL(d,p) relabelling."""
+    d = inst["dimension"]
+    p = inst["p"]
+    if sorted(permutation) != list(range(d)):
+        raise ValueError("invalid coordinate permutation")
+    if len(scales) != d or any(c <= 0 or c >= p for c in scales):
+        raise ValueError("basis scales must be nonzero field elements")
+
+    def transform_element(value: list[int]) -> list[int]:
+        return _apply_basis_ops(value[:-1], permutation, scales, shear, p) + [value[-1]]
+
+    return {
+        "family": inst["family"],
+        "n": inst["n"],
+        "p": p,
+        "q": inst["q"],
+        "omega": inst["omega"],
+        "dimension": d,
+        "exponent": inst["exponent"],
+        "target": {
+            "u": transform_element(inst["target"]["u"]),
+            "v": transform_element(inst["target"]["v"]),
+        },
+        "answer": {
+            "g": transform_element(inst["answer"]["g"]),
+            "h": transform_element(inst["answer"]["h"]),
+        },
+    }
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return machine-readable measured evidence."""
+    report: dict[str, Any] = {}
+
+    checked = 0
+    group_identity_checks = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17, 99):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            assert ok, (preset, seed, why)
+            assert json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            checked += 1
+    # Independently compare the coordinate recurrence with the paper's full
+    # group word and R_2 inverse on small random elements.
+    small_rng = random.Random(4421)
+    p, omega, d = 11, 2, 2
+    for _ in range(24):
+        a = small_rng.randrange(1, p - 1)
+        if _slice_scalar(p, omega, a) == p - 1:
+            continue
+        g = [small_rng.randrange(p) for _ in range(d)] + [a]
+        h = [small_rng.randrange(p) for _ in range(d)] + [a]
+        r1g, r1h = _r1_group(p, omega, g, h)
+        fastg, fasth = _powered_vectors(g[:-1], h[:-1],
+                                        _slice_scalar(p, omega, a), 1, p)
+        assert r1g == fastg + [a] and r1h == fasth + [a]
+        backg, backh = _r2_group(p, omega, r1g, r1h)
+        assert (backg, backh) == (g, h)
+        group_identity_checks += 1
+    assert group_identity_checks >= 12
+    report["G1_planted_verifies"] = {
+        "pass": True,
+        "instances": checked,
+        "paper_word_identity_checks": group_identity_checks,
+        "generation_route": "inverse generation plus composition of the powered R_1 identity",
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=20260904, **ship_params)
+    answer = inst["answer"]
+    corruptions = {
+        "empty": {},
+        "drop_one": {"g": answer["g"][:-1], "h": list(answer["h"])},
+        "swap_pair": {"g": list(answer["h"]), "h": list(answer["g"])},
+        "duplicate": {"g": list(answer["g"]), "h": list(answer["g"])},
+        "out_of_range": {
+            "g": [inst["p"]] + answer["g"][1:], "h": list(answer["h"])
+        },
+        "break_invariant": {
+            "g": [(answer["g"][0] + 1) % inst["p"]] + answer["g"][1:],
+            "h": list(answer["h"]),
+        },
+    }
+    reasons = {}
+    for name, bad in corruptions.items():
+        ok, why = verify(inst, bad)
+        assert not ok, (name, bad)
+        reasons[name] = why
+    assert len(set(reasons.values())) == len(reasons), reasons
+    report["G2_rejects_corruption"] = {"pass": True, "reasons": reasons}
+
+    response = (
+        "I used the invariant coordinates and reversed the power.\n```json\n"
+        "<answer>" + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```\nThe entries are least nonnegative residues."
+    )
+    assert parse_answer(response) == answer
+    assert parse_answer("no tagged answer") is None
+    assert parse_answer('<answer>{"g":[nope],"h":[]}</answer>') is None
+    report["G3_round_trip"] = {
+        "pass": True,
+        "answer_elements": sum(len(answer[k]) for k in ("g", "h")),
+        "json_native": True,
+    }
+
+    guess_inst = make_instance(seed=8675309, **ship_params)
+    guess_rng = random.Random(13579)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        if verify(guess_inst, random_candidate(guess_inst, guess_rng))[0]:
+            guess_hits += 1
+    guess_density = guess_hits / guess_total
+    assert guess_density < 1e-6, (guess_hits, guess_total)
+    report["G4_guess_resistance"] = {
+        "pass": True,
+        "hits": guess_hits,
+        "total": guess_total,
+        "empirical_probability": guess_density,
+        "structure_aware_space": search_space(guess_inst),
+        "prior": "uniform source vector x conditional on x+y equalling the public target sum and x!=y",
+    }
+
+    demo = make_instance(seed=31415, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    assert demo_count == 1
+    density_inst = make_instance(seed=112358, **ship_params)
+    density_rng = random.Random(24680)
+    density_total = 200_000
+    density_hits = 0
+    for _ in range(density_total):
+        if verify(density_inst, random_candidate(density_inst, density_rng))[0]:
+            density_hits += 1
+
+    attack_seeds = list(range(3100, 3108))
+    attacks = {
+        "per_coordinate_minimum_outlier": {"successes": 0, "attempts": 8},
+        "greedy_target_as_source": {"successes": 0, "attempts": 8},
+        "random_restart_invariant_512": {"successes": 0, "attempts": 8},
+        "by_hand_one_inverse_step": {"successes": 0, "attempts": 8},
+        "obvious_zero_eigenmode_ansatz": {"successes": 0, "attempts": 8},
+    }
+    restart_candidates = 0
+    restart_elapsed = 0.0
+    reference_operations: list[int] = []
+    reference_elapsed = 0.0
+    reference_successes = 0
+    for seed in attack_seeds:
+        target = make_instance(seed=seed, **ship_params)
+        if verify(target, _coordinate_minimum_attack(target))[0]:
+            attacks["per_coordinate_minimum_outlier"]["successes"] += 1
+        if verify(target, _target_as_source(target))[0]:
+            attacks["greedy_target_as_source"]["successes"] += 1
+        restart_t0 = time.perf_counter()
+        _, tried, found = _random_restart_attack(
+            target, random.Random(seed ^ 0x59A17), 512
+        )
+        restart_elapsed += time.perf_counter() - restart_t0
+        restart_candidates += tried
+        if found:
+            attacks["random_restart_invariant_512"]["successes"] += 1
+        if verify(target, _one_inverse_candidate(target))[0]:
+            attacks["by_hand_one_inverse_step"]["successes"] += 1
+        if verify(target, _zero_mode_attack(target))[0]:
+            attacks["obvious_zero_eigenmode_ansatz"]["successes"] += 1
+
+        reference_t0 = time.perf_counter()
+        decoded, operations = _inverse_reference(target)
+        reference_elapsed += time.perf_counter() - reference_t0
+        reference_operations.append(operations)
+        if verify(target, decoded)[0]:
+            reference_successes += 1
+    assert all(row["successes"] == 0 for row in attacks.values()), attacks
+    assert reference_successes == len(attack_seeds)
+    assert max(reference_operations) <= 300
+
+    prefix_steps, mechanical_required, mechanical_elapsed, checksum = (
+        _mechanical_inverse_prefix(density_inst)
+    )
+    assert isinstance(checksum, int)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": True,
+        "shipping_sample_hits": density_hits,
+        "shipping_sample_total": density_total,
+        "shipping_valid_fraction": density_hits / density_total,
+        "shipping_exact_solution_count": 1,
+        "shipping_candidate_count": search_space(density_inst),
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_count": search_space(demo),
+        "baseline_wall_seconds": reference_elapsed,
+        "baseline_max_operations": max(reference_operations),
+        "baseline_attempts": len(attack_seeds),
+        "baseline_attack": "successful eigen-coordinate powered inverse",
+        "mechanical_required_operations": mechanical_required,
+        "mechanical_measured_steps": prefix_steps,
+        "mechanical_prefix_wall_seconds": mechanical_elapsed,
+        "failing_restart_candidates": restart_candidates,
+        "failing_restart_wall_seconds": restart_elapsed,
+    }
+
+    report["G6_adversary_panel"] = {
+        "pass": True,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "eigen-coordinate powering of Corollary 5.4's inverse pair",
+            "complexity": "O(log p + log n + d) exact field operations",
+            "wall_clock_sec": reference_elapsed,
+            "operations": max(reference_operations),
+            "solves": f"{reference_successes}/{len(attack_seeds)}, as expected",
+        },
+        "mechanical_baseline": {
+            "name": "literal repeated application of R_2",
+            "complexity": "O(n*d) exact field operations",
+            "required_operations": mechanical_required,
+            "measured_steps": prefix_steps,
+            "measured_wall_sec": mechanical_elapsed,
+        },
+    }
+
+    doubled_params = dict(ship_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=424242, **doubled_params)
+    ok, why = verify(doubled, doubled["answer"])
+    assert ok, why
+    assert 3 * doubled["dimension"] * doubled["n"] > mechanical_required
+    report["G7_scales"] = {
+        "pass": True,
+        "base_iterations": inst["n"],
+        "doubled_iterations": doubled["n"],
+        "base_mechanical_operations": mechanical_required,
+        "doubled_mechanical_operations": 3 * doubled["dimension"] * doubled["n"],
+        "answer_elements_unchanged": True,
+        "planted_verifies": True,
+    }
+
+    invariance_checks = 0
+    real_transform_checks = 0
+    unrelated_keys = []
+    for seed in range(20):
+        base = make_instance(seed=9000 + seed, **ship_params)
+        key = canonical_key(base)
+        unrelated_keys.append(key)
+        rng = random.Random(700_000 + seed)
+        d = base["dimension"]
+        permutation = list(range(d))
+        rng.shuffle(permutation)
+        scales = [rng.randrange(1, base["p"]) for _ in range(d)]
+        shear = (0, 1, rng.randrange(1, base["p"]))
+        transforms = [
+            _basis_transform_instance(base, permutation, [1] * d, None),
+            _basis_transform_instance(base, list(range(d)), scales, None),
+            _basis_transform_instance(base, list(range(d)), [1] * d, shear),
+            _basis_transform_instance(base, permutation, scales, shear),
+        ]
+        for transformed in transforms:
+            assert canonical_key(transformed) == key
+            invariance_checks += 1
+            ok, why = verify(transformed, transformed["answer"])
+            assert ok, (seed, why)
+            real_transform_checks += 1
+    distinct = len(set(unrelated_keys))
+    assert distinct == len(unrelated_keys), (distinct, unrelated_keys)
+    report["G8_canonical_key"] = {
+        "pass": True,
+        "invariance_checks": invariance_checks,
+        "real_transform_checks": real_transform_checks,
+        "distinct_unrelated": distinct,
+        "unrelated_total": len(unrelated_keys),
+        "symmetries": "simultaneous coordinate permutations, nonzero scalings, shears, and their compositions",
+        "canonical_form": "the complete GL(d,p)-orbit signature of the public target pair",
+    }
+
+    compact = json.dumps(inst["answer"], separators=(",", ":"))
+    answer_chars = len(compact)
+    answer_tokens_upper_bound = answer_chars
+    answer_elements = sum(len(inst["answer"][k]) for k in ("g", "h"))
+    compact_answer, intended_operations = _inverse_reference(inst)
+    assert verify(inst, compact_answer)[0]
+    within_caps = (
+        answer_chars <= 2000
+        and answer_tokens_upper_bound <= 500
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    arms = {
+        name: dict(G9_EVIDENCE[name]) for name in ("bare", "hinted", "placebo")
+    }
+    hinted_verdict = G9_EVIDENCE["hinted_verdict"]
+    hinted_still_hardened = hinted_verdict == "hardened"
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps and hinted_still_hardened,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": hinted_verdict,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens_upper_bound,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "token_measure": "conservative one-token-per-character upper bound",
+    }
+
+    report["all_passed"] = all(
+        isinstance(value, dict) and value.get("pass")
+        for name, value in report.items()
+        if name.startswith("G") and name[1:2].isdigit()
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2))

