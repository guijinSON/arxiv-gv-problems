+"""Verified generator for iterated abelian-map Yang--Baxter preimages.
+
+The family uses Example 4.1, Proposition 5.1, and Corollary 5.4 of
+arXiv:2007.08967.  A source pair is sampled first and mapped forward, so the
+certificate is known by inverse generation.  All arithmetic is exact in a
+prime field; the module is deterministic in ``(n, seed, params)`` and silent
+on import.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import os
+import random
+import re
+import sys
+import time
+from typing import Any
+
+
+# Make gvlib available when harden.py imports from this result directory.  The
+# family needs only finite-field arithmetic, which gvlib does not currently
+# provide, so it remains standard-library-only if the helpers are unavailable.
