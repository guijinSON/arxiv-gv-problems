diff --git a/gen_2007_08967.py b/gen_2007_08967.py
new file mode 100644
index 0000000000000000000000000000000000000000..99fa746a0567b5525b5e1d8c9c83c05fc4e9eb7a
--- /dev/null
+++ b/gen_2007_08967.py
@@ -0,0 +1,1021 @@
+"""Verified generator for iterated abelian-map Yang--Baxter preimages.
+
+The family uses Example 4.1, Proposition 5.1, and Corollary 5.4 of
+arXiv:2007.08967.  A source pair is sampled first and mapped forward, so the
+certificate is known by inverse generation.  All arithmetic is exact in a
+prime field; the module is deterministic in ``(n, seed, params)`` and silent
+on import.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import os
+import random
+import re
+import sys
+import time
+from typing import Any
+
+
