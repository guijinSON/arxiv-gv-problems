+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON object {g:[x_0,...,x_(d-1),a], h:[y_0,...,y_(d-1),a]} "
+        "representing two distinct group elements; all vector coordinates lie "
+        "in 0..p-1, both cyclic coordinates equal the stated a, and x+y equals "
+        "the public target-vector sum coordinatewise."
