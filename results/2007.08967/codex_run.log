+    density_hits = 0
+    for _ in range(density_total):
+        if verify(density_inst, random_candidate(density_inst, density_rng))[0]:
+            density_hits += 1
+
+    attack_seeds = list(range(3100, 3108))
+    attacks = {
+        "per_coordinate_minimum_outlier": {"successes": 0, "attempts": 8},
+        "greedy_target_as_source": {"successes": 0, "attempts": 8},
+        "random_restart_invariant_512": {"successes": 0, "attempts": 8},
+        "by_hand_one_inverse_step": {"successes": 0, "attempts": 8},
+        "obvious_zero_eigenmode_ansatz": {"successes": 0, "attempts": 8},
+    }
+    restart_candidates = 0
+    restart_elapsed = 0.0
+    reference_operations: list[int] = []
+    reference_elapsed = 0.0
+    reference_successes = 0
+    for seed in attack_seeds:
+        target = make_instance(seed=seed, **ship_params)
+        if verify(target, _coordinate_minimum_attack(target))[0]:
+            attacks["per_coordinate_minimum_outlier"]["successes"] += 1
+        if verify(target, _target_as_source(target))[0]:
+            attacks["greedy_target_as_source"]["successes"] += 1
+        restart_t0 = time.perf_counter()
+        _, tried, found = _random_restart_attack(
+            target, random.Random(seed ^ 0x59A17), 512
+        )
+        restart_elapsed += time.perf_counter() - restart_t0
+        restart_candidates += tried
+        if found:
