+        "powering algorithm is O(log p+log n+d), used at most 108 field "
+        "operations and 0.00012 seconds across eight measured instances, while "
+        "literal iteration took 0.115 seconds; its modular exponentiations are "
+        "not safely executable in context without tools."
+    ),
+    "max_answer_tokens": 61,
+}
+
+NATIVE: dict = {
