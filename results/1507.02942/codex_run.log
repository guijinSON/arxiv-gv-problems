+    # Lemma 3.3, m=1, with initial leading coefficients a=1, b=lambda.
+    a = 1
+    b = lam
+    a2 = (a * a) % p
+    operations = 1
+    delta = (a2 - b) % p
+    operations += 1
+    ap1, used = _mod_pow_counted(a, p - 1, p)
+    operations += used
+    ap2, used = _mod_pow_counted(a, p - 2, p)
+    operations += used
+    first = (ap1 * delta) % p
+    operations += 1
+    delta2 = (delta * delta) % p
+    operations += 1
+    second = (-(ap2 * delta2)) % p
+    operations += 2
 
