   937	
   938	The next lemma, which describes how the $p$th power map behaves from one distinguished diamond to the next one, is crucial for the determination of Beauville structures in quotients of the Nottingham group.
   939	
   940	
   941	
   942	\begin{lem}
   943	Let $f\in\No$ be such that
   944	\[
   945	f(t)\equiv t+\lambda t^{z_{m-1}}+\mu t^{z_{m-1}+1} \pmod{t^{z_{m-1}+2}},
   946	\]
   947	where $m\ge 1$.
   948	Then
   949	\begin{equation}
   950	\label{pth power}
   951	f^p(t)
   952	\equiv
   953	\begin{cases}
   954	t + \lambda^{p-1}(\lambda^2-\mu) t^{z_1} - \lambda^{p-2} (\lambda^2-\mu)^2 t^{z_1+1}
   955	\hspace{-5pt} \pmod{t^{z_1+2}},
   956	&
   957	\text{if $m=1$,}
   958	\\
   959	t - \lambda^{p-1}\mu t^{z_m} - \lambda^{p-2}\mu^2 t^{z_m+1} \pmod{t^{z_m+2}},
   960	&
   961	\text{if $m>1$.}
   962	\end{cases}
   963	\end{equation}
   964	\end{lem}
