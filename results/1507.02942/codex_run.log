+def _equivalent_representation(inst, order, lifts):
+    """Reorder sparse terms and change integer representatives by multiples of p."""
+    p = inst["p"]
+    terms = []
+    for source_index in order:
+        coefficient, exponent = inst["series_terms"][source_index]
