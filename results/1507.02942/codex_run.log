    76	\title{Beauville structures in finite $p$-groups}
    77	
    78	\author[G.A.\ Fern\'andez-Alcober]{Gustavo A.\ Fern\'andez-Alcober}
    79	\address{Department of Mathematics\\ University of the Basque Country UPV/EHU\\
    80	48080 Bilbao, Spain}
    81	\email{gustavo.fernandez@ehu.eus}
    82	
    83	\author[\c{S}.\ G\"ul]{\c{S}\"ukran G\"ul}
    84	\address{Department of Mathematics\\ Middle East Technical University\\
    85	06800 Ankara, Turkey}
    86	\email{gsukran@metu.edu.tr}
