  1140	The following result, which gives a sufficient condition to lift a Beauville structure from a quotient group, is Lemma 4.2 in \cite{FJ}.
  1141	
  1142	
  1143	
  1144	\begin{lem}
  1145	\label{lifting structure}
  1146	Let $G$ be a finite group and let $\{x_1,y_1\}$ and $\{x_2,y_2\}$ be two sets of generators of $G$.
  1147	Assume that, for a given $N\trianglelefteq G$, the following hold:
  1148	\begin{enumerate}
  1149	\item
  1150	$\{x_1N,y_1N\}$ and $\{x_2N,y_2N\}$ is a Beauville structure for $G/N$.
  1151	\item
  1152	$o(g)=o(gN)$ for every $g\in\{x_1,y_1,x_1y_1\}$.
  1153	\end{enumerate}
  1154	Then $\{x_1,y_1\}$ and $\{x_2,y_2\}$ is a Beauville structure for $G$.
  1155	\end{lem}
