    # G2: five distinct corruption classes and five distinct rejection reasons.
    ship = make_instance(seed=3, **DIFFICULTY[SHIPPING_DIFFICULTY])
    ans = ship["answer"]
    swap = ans[:]
    pair = next(((i, j) for i in range(1, len(ans))
