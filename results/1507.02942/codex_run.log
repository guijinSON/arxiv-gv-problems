  1224	\begin{lem}
  1225	\label{intersection_2}
  1226	Let $G$ be a finite $p$-group and let $x \in G \setminus \Phi(G)$ be an element of order $p$.
  1227	If $t \in \Phi(G)\smallsetminus \{[x,g] \mid g \in G \}$ then 
  1228	\[
  1229	\Big(\bigcup_{g\in G} {\langle x\rangle}^g  \Big)
  1230	\bigcap
  1231	\Big(\bigcup_{g\in G} {\langle xt\rangle}^g \Big)= 1.
  1232	\]
