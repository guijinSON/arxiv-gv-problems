   967	
   968	\begin{proof}
   969	By Lemma \ref{all_elements}, we may assume that $f(t)=t+\lambda t^{z_{m-1}}+\mu t^{z_{m-1}+1}$.
   970	According to the definition of the matrix $M$, we have
   971	\[
   972	f(t^i) = t^i + \sum_{j\ge 1} \, M_{i,i+j} t^{i+j}.
   973	\]
   974	By expanding the $i$th power in
   975	\[
   976	f(t^i) = f(t)^i = (t+t^{z_{m-1}}(\lambda+\mu t))^i,
   977	\]
   978	one readily obtains the following values of $M_{i,i+j}$ for $1\le j\le z_{m-1}+1$: if $m>1$ then we have
   979	\begin{equation}
   980	\label{M for m>1}
   981	M_{i,i+j}
   982	=
   983	\begin{cases}
   984	\lambda i,
   985	&
   986	\text{if $j=z_{m-1}-1$,}
   987	\\
   988	\mu i,
   989	&
   990	\text{if $j=z_{m-1}$,}
   991	\\
   992	0,
   993	&
   994	\text{if $1\le j<z_{m-1}-1$ or $j=z_{m-1}+1$,}
   995	\end{cases}
   996	\end{equation}
   997	and if $m=1$ then
   998	\begin{equation}
   999	\label{M for m=1}
  1000	M_{i,i+j}
  1001	=
  1002	\begin{cases}
  1003	\lambda i,
  1004	&
  1005	\text{if $j=1$,}
  1006	\\[3pt]
  1007	\lambda^2 \binom{i}{2} + \mu i,
  1008	&
  1009	\text{if $j=2$,}
  1010	\\[3pt]
  1011	2\lambda\mu \binom{i}{2} + \lambda^3 \binom{i}{3},
  1012	&
  1013	\text{if $j=3$.}
  1014	\end{cases}
  1015	\end{equation}
  1016	
  1017	Let us first assume that $m>1$.
  1018	We start by calculating the coefficient $\alpha$ of $t^{z_m}$ in $f^p(t)$.
  1019	To this purpose, we rely on formula (\ref{coefficient fpm}), applied with $n=z_m$.
  1020	By (\ref{M for m>1}), if the sum in (\ref{coefficient fpm}) corresponding to a vector $\mathbf{i}=(i_0,\ldots,i_p)$
  1021	is non-zero, we must have $i_{j+1}\ge i_j+z_{m-1}-1$ for every $j=0,\ldots,p-1$.
  1022	Thus $i_j\ge j(z_{m-1}-1)+1$ for $j=0,\ldots,p$.
  1023	Since $i_p=p(z_{m-1}-1)+2$, for some $k\in\{1,\ldots,p\}$ we must have $i_j=j(z_{m-1}-1)+1$ for $j=0,\ldots,k-1$
  1024	and $i_j=j(z_{m-1}-1)+2$ for $j=k,\ldots,p$.
  1025	Let us write, for simplicity, $q_j=j(z_{m-1}-1)+1$.
  1026	Then
  1027	\[
  1028	\alpha = \sum_{k=1}^p \, \alpha_k,
  1029	\]
  1030	where
  1031	\[
  1032	\alpha_k
  1033	=
  1034	\Big( \prod_{i=1}^{k-1} M_{q_{i-1},q_i} \Big)
  1035	\,
  1036	M_{q_{k-1},q_k+1}
  1037	\,
  1038	\Big( \hspace{-2pt} \prod_{i=k+1}^p M_{q_{i-1}+1,q_i+1} \Big).
  1039	\]
  1040	Now, by (\ref{M for m>1}),
  1041	\begin{gather*}
  1042	M_{q_{j-1},q_j} = \lambda q_{j-1} = \lambda j,
  1043	\quad
  1044	\text{for $j=1,\ldots,k-1$,}
  1045	\\[5pt]
  1046	M_{q_{k-1},q_k+1} = \mu q_{k-1} = \mu k,
  1047	\\
  1048	\intertext{and}
  1049	M_{q_{j-1}+1,q_j+1} = \lambda (q_{j-1}+1) = \lambda (j+1),
  1050	\quad
  1051	\text{for $j=k+1,\ldots,p$.}
  1052	\end{gather*}
  1053	Consequently
  1054	\[
  1055	\alpha_k = \lambda^{p-1} \mu \, k! (k+2)\ldots (p+1),
  1056	\]
  1057	and since this product contains the factor $p$ unless $k=p-1$, we finally get
  1058	\[
  1059	\alpha = \lambda^{p-1} \mu (p-1)! = -\lambda^{p-1} \mu,
  1060	\]
  1061	as desired.
  1062	
  1063	The coefficient $\beta$ of $t^{z_m+1}$ in $f^p(t)$ can be obtained in a similar way.
  1064	Again, $\beta$ is a product of factors of the form $M_{i_{j-1},i_j}$, where $i_j-i_{j-1}=z_{m-1}-1$ except for two values
  1065	$k$ and $\ell$ for which $i_k-i_{k-1}=i_{\ell}-i_{\ell-1}=z_{m-1}$, or one value $r$ for which
  1066	$i_r-i_{r-1}=z_{m-1}+1$.
  1067	The latter case gives a zero product, since $M_{i,i+z_{m-1}+1}=0$ by (\ref{M for m>1}), and consequently
  1068	\[
  1069	\beta
  1070	=
  1071	\sum_{1\le k<\ell \le p}
  1072	\, \beta_{k,\ell},
  1073	\]
  1074	where
  1075	\begin{multline*}
  1076	\beta_{k,l}
  1077	=
  1078	\Big( \prod_{i=1}^{k-1} M_{q_{i-1},q_i} \Big)
  1079	\,
  1080	M_{q_{k-1},q_k+1}
  1081	\,
  1082	\Big( \hspace{-2pt} \prod_{i=k+1}^{\ell-1} M_{q_{i-1}+1,q_i+1} \Big)
  1083	\\
  1084	M_{q_{\ell-1}+1,q_\ell+2}
  1085	\,
  1086	\Big( \hspace{-2pt} \prod_{i=\ell+1}^p M_{q_{i-1}+2,q_i+2} \Big).
  1087	\end{multline*}
  1088	By (\ref{M for m>1}), we have
  1089	\[
  1090	\beta_{k,\ell} = \lambda^{p-2}\mu^2 \prod_{\substack{i=1\\ i\ne k+1,\,\ell+2}}^{p+2} \, i,
  1091	\]
  1092	which is $0$ unless $k=p-1$ and $\ell=p$, or $1\le k\le p-3$ and $\ell=p-2$.
  1093	Consequently
  1094	\[
  1095	\beta
  1096	=
  1097	\lambda^{p-2}\mu^2 \Big( (p-1)! (p+1) + \sum_{k=1}^{p-3} \, \frac{(p-1)! (p+1)(p+2)}{k+1} \Big)
  1098	=
  1099	-\lambda^{p-2}\mu^2,
  1100	\]
  1101	where the last equality follows from the fact that
  1102	\[
  1103	\sum_{i=1}^{p-1} \, \frac{(p-1)!}{i} \equiv 0 \pmod p
  1104	\]
  1105	for odd $p$, since it coincides with the sum of the inverses of all elements of $\F_p^{\times}$.
  1106	This completes the proof when $m>1$.
  1107	
  1108	Finally, the case $m=1$ can be dealt with in a similar way, and the details are left to the reader.
  1109	\end{proof}
