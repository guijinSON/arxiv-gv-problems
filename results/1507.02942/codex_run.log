+def _equivalent_representation(inst, order, lifts):
+    """Reorder sparse terms and change integer representatives by multiples of p."""
+    p = inst["p"]
+    terms = []
+    for source_index in order:
+        coefficient, exponent = inst["series_terms"][source_index]
+        terms.append([coefficient + lifts[source_index] * p, list(exponent)])
+    transformed = dict(inst)
+    transformed["series_terms"] = terms
+    # The original witness is intentionally retained: this is the same problem.
+    transformed["answer"] = list(inst["answer"])
+    return transformed
 
