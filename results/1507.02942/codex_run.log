/bin/bash -lc "ps -p 2914602 -o pid=,etime=,stat=,cmd= || true; ls -la | sed -n '1,80p'; stat -c '%y %s %n' gen_1507_02942.py README.md selftest_report.json 2>&1" in /home/gson/gvrepo/results/1507.02942
