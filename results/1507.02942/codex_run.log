+def _compact_route(inst):
+    p = inst["p"]
+    lam = _lambda_from_instance(inst)
+    base = (1 - lam) % p
+    operations = 1
+    first, used = _mod_pow_counted(base, inst["n"], p)
+    operations += used
+    second = (-(first * base)) % p
+    operations += 2
+    return [first, second], operations
 
