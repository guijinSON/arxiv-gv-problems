+def _mod_pow_counted(base, exponent, p):
+    """Binary modular exponentiation with an exact multiplication count."""
+    result = 1
+    factor = base % p
+    operations = 0
+    remaining = exponent
+    while remaining:
+        if remaining & 1:
+            result = (result * factor) % p
+            operations += 1
+        remaining >>= 1
+        if remaining:
+            factor = (factor * factor) % p
+            operations += 1
+    return result, operations
 
 
