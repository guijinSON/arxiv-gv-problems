  1259	\begin{lem}
  1260	\label{not covered}
  1261	Let $p=3$ and $m\ge 1$, and put $G=\No/\No_{z_m+1}$ and
  1262	$N_k=\No_k/\No_{z_m+1}$ for all $k\ge 1$.
  1263	If $u$ and $v$ are the images of $a$ and $b$ in $G$, respectively, then the sets
  1264	$\{[u,g]\mid g\in G\}$ and $\{[v,g]\mid g\in G\}$ do not cover $N_{z_m-1}$.
