from time import perf_counter

def mul(a,b,D,p,stats):
    c=[0]*(D+1)
    for i,x in enumerate(a):
        if x:
            top=min(D-i,len(b)-1)
            for j in range(1,top+1):
                y=b[j]
                if y:
                    c[i+j]=(c[i+j]+x*y)%p
                    stats[0]+=2
    return c

def run(p,m,u,v):
    z=sum(p**i for i in range(1,m+1))+2
    D=z+1
    g=[0]*(D+1); g[1]=1
    s=[0]
    t=perf_counter()
    for _ in range(p**m):
        g2=mul(g,g,D,p,s)
        g3=mul(g2,g,D,p,s)
        g=[(g[i]+u*g2[i]+v*g3[i])%p for i in range(D+1)]
        s[0]+=2*(D+1)
    return perf_counter()-t,s[0],z,g[z],g[z+1]
for p,m in [(7,2),(11,2),(13,2)]:
    print(p,m,run(p,m,2,3))
