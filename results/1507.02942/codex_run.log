\title{Beauville structures in finite $p$-groups}

\author[G.A.\ Fern\'andez-Alcober]{Gustavo A.\ Fern\'andez-Alcober}
\address{Department of Mathematics\\ University of the Basque Country UPV/EHU\\
48080 Bilbao, Spain}
