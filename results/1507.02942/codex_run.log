    "bare": {"solved": 0, "attempts": 0},
    "hinted": {"solved": 0, "attempts": 0},
    "placebo": {"solved": 0, "attempts": 0},
    "hinted_verdict": "not_run",
}


def _is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def _validate_parameters(n, field):
    if field not in _FIELDS:
        raise ValueError("field must be 'toy' or 'goldilocks'")
    if not _is_int(n) or n < 1:
        raise ValueError("n must be a positive integer")
    if field == "toy" and n > 3:
        raise ValueError("the toy field is reserved for n <= 3")


def _normalise_terms(terms, p):
    """Canonical sparse univariate polynomial as ((degree, coefficient), ...)."""
    if not isinstance(terms, list):
        raise ValueError("series_terms must be a list")
    coefficients = {}
    for term in terms:
        if not isinstance(term, list) or len(term) != 2:
            raise ValueError("each series term must be [coefficient,[exponent]]")
        coefficient, exponent_list = term
        if not _is_int(coefficient):
            raise ValueError("series coefficients must be integers")
        if (
            not isinstance(exponent_list, list)
            or len(exponent_list) != 1
            or not _is_int(exponent_list[0])
            or exponent_list[0] < 0
        ):
            raise ValueError("each monomial must have one nonnegative exponent")
        degree = exponent_list[0]
        coefficients[degree] = (coefficients.get(degree, 0) + coefficient) % p
    return tuple(
        (degree, coefficient)
        for degree, coefficient in sorted(coefficients.items())
        if coefficient
    )


def _lambda_from_instance(inst):
    p = inst.get("p")
    n = inst.get("n")
    if not _is_int(p) or p not in _FIELDS.values():
        raise ValueError("invalid field modulus in instance")
    if not _is_int(n) or n < 1:
        raise ValueError("invalid iteration level in instance")
    normal = _normalise_terms(inst.get("series_terms"), p)
    coefficient_map = dict(normal)
    if set(coefficient_map) != {1, 2, 3}:
        raise ValueError("input series must have exactly degrees 1, 2, and 3")
    if coefficient_map[1] != 1 or coefficient_map[2] != 1:
        raise ValueError("input series must begin t+t^2")
    return coefficient_map[3]


def _closed_coefficients(inst):
    """Corollary 3.4, evaluated independently of the planted answer."""
    p = inst["p"]
    n = inst["n"]
    lam = _lambda_from_instance(inst)
    base = (1 - lam) % p
    first = pow(base, n, p)
    second = (-first * base) % p

