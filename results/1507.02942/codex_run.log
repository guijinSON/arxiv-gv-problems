        "compositional p-power iterate in the Nottingham group",
        "coefficient vector on two fixed formal-series monomials",
    ],
    "verification_operations": [
        "exact finite-field subtraction",
        "exact modular exponentiation",
        "exact comparison of formal-series coefficients",
    ],
    "domain_essentiality": "native",
    "reduction_kind": "none",
    "reduction": None,
    "reduction_source": "paper_central",
    "intuition_type": "invariant",
