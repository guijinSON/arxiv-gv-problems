+    # G8: input reordering, independent variable scalings, and their composition.
+    invariance_passed = 0
+    invariance_attempted = 0
+    transformed_verified = 0
+    keys = []
+    for seed in range(40, 60):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
