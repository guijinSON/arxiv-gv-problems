+        "hits": hits,
+        "total": total,
+        "estimated_probability": hits / total,
+        "structure_aware": True,
+        "candidate_space": search_space(hard),
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    demo = make_instance(seed=23, **DIFFICULTY["demo"])
+    t0 = time.perf_counter()
