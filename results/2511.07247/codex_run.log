+def _role_records(inst):
+    """Return role -> record, rejecting malformed/duplicate role data."""
+    records = {}
+    edges = inst.get("edges")
+    if not isinstance(edges, list) or len(edges) != len(_EDGE_TEMPLATE):
+        return None
+    for rec in edges:
