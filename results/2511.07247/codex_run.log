+    "medium": {"n": 10009, "width": 8},
+    "hard": {"n": 50021, "width": 10},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A 12-by-2 matrix; row r is one of the explicitly listed allowed "
