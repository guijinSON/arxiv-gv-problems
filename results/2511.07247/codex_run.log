+            "arbitrary vertex switching",
+            "all transformations composed",
+        ],
+    }
+
+    compact_answer, compact_operations = _compact_decode(hard)
+    answer_blob = json.dumps(hard["answer"], separators=(",", ":"))
+    chars = len(answer_blob)
