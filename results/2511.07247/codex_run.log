+    t0 = time.perf_counter()
+    reference_answer, reference_operations = _reference_automorphism_scan(hard)
+    reference_seconds = time.perf_counter() - t0
+    report["G5_density_baseline"] = {
+        "pass": (
+            isinstance(demo_count, int)
