+        "shipping_lift_order": hard["lift_order"],
+        "doubled_lift_order": doubled["lift_order"],
+        "fixed_answer_rows": 12,
+        "doubled_planted_verifies": doubled_ok,
+    }
+
+    invariant = 0
+    carried = 0
+    keys = []
