   646	def _lll_reduce(
   647	    basis: list[list[int]], delta: Fraction = Fraction(3, 4), limit: int = 60_000
   648	) -> tuple[list[list[int]], dict]:
   649	    """Exact row-basis LLL, adapted to keep the attack dependency-free."""
   650	    rows = [row[:] for row in basis]
   651	    m = len(rows)
   652	    dimension = len(rows[0])
   653	    star = [[Fraction(0) for _ in range(dimension)] for _ in range(m)]
   654	    mu = [[Fraction(0) for _ in range(m)] for _ in range(m)]
   655	    norms = [Fraction(0) for _ in range(m)]
   656	
   657	    def dot(x: list, y: list) -> Fraction:
   658	        return sum(a * b for a, b in zip(x, y))
   659	
   660	    for i in range(m):
   661	        star[i] = [Fraction(value) for value in rows[i]]
   662	        for j in range(i):
   663	            if norms[j] == 0:
   664	                raise ValueError("linearly dependent LLL basis")
   665	            mu[i][j] = dot(rows[i], star[j]) / norms[j]
   666	            star[i] = [
   667	                star[i][column] - mu[i][j] * star[j][column]
   668	                for column in range(dimension)
   669	            ]
   670	        norms[i] = dot(star[i], star[i])
   671	
   672	    reductions = 0
   673	    swaps = 0
   674	    iterations = 0
   675	    k = 1
   676	
   677	    def reduce_row(i: int, j: int) -> None:
   678	        nonlocal reductions
   679	        q = _nearest_integer(mu[i][j])
   680	        rows[i] = [rows[i][z] - q * rows[j][z] for z in range(dimension)]
   681	        for z in range(j):
   682	            mu[i][z] -= q * mu[j][z]
   683	        mu[i][j] -= q
   684	        reductions += 1
   685	
   686	    while k < m and iterations < limit:
   687	        iterations += 1
   688	        if abs(mu[k][k - 1]) > Fraction(1, 2):
   689	            reduce_row(k, k - 1)
   690	        if norms[k] >= (delta - mu[k][k - 1] ** 2) * norms[k - 1]:
   691	            for j in range(k - 2, -1, -1):
   692	                if abs(mu[k][j]) > Fraction(1, 2):
   693	                    reduce_row(k, j)
   694	            k += 1
   695	            continue
   696	
   697	        nu = mu[k][k - 1]
   698	        alpha = norms[k] + nu * nu * norms[k - 1]
   699	        if alpha == 0:
   700	            raise ValueError("linearly dependent LLL basis")
   701	        beta = norms[k - 1] / alpha
   702	        mu[k][k - 1] = nu * beta
   703	        norms[k] *= beta
   704	        norms[k - 1] = alpha
   705	        rows[k], rows[k - 1] = rows[k - 1], rows[k]
   706	        mu[k][: k - 1], mu[k - 1][: k - 1] = mu[k - 1][: k - 1], mu[k][: k - 1]
   707	        for i in range(k + 1, m):
   708	            xi = mu[i][k]
   709	            mu[i][k] = mu[i][k - 1] - nu * xi
   710	            mu[i][k - 1] = mu[k][k - 1] * mu[i][k] + xi
   711	        swaps += 1
   712	        k = max(k - 1, 1)
   713	
   714	    return rows, {
   715	        "iterations": iterations,
   716	        "size_reductions": reductions,
   717	        "swaps": swaps,
   718	        "limit_reached": k < m,
   719	    }
