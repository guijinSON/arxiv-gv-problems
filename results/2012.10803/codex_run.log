+        "K=Q(i), ell=2, e_j in [-1,1], t=160 and conductor depth 256: no "
+        "polynomial recovery method is known for this distribution; generic "
+        "meet-in-the-middle costs Theta(3^(t/2)), while the post-paper "
+        "lattice/SVP attack remains exponential in t, and the shipping "
+        "self-test's measured capped LLL/CVP and meet-in-the-middle probes "
+        "solve 0/8 instances."
+    ),
+    "max_answer_tokens": 121,
+}
+
+NATIVE = {
