  if deadline and time.time()>deadline:break
  changed=False
  for j in range(k-1,-1,-1):
   q=int(round(mu[k][j]))
   if q:
    B[k]=[x-q*y for x,y in zip(B[k],B[j])];steps+=1;changed=True;mu,norm=gs()
  if norm[k]+1e-30 >= (delta-mu[k][k-1]**2)*norm[k-1]:k+=1
  else:
   B[k],B[k-1]=B[k-1],B[k];steps+=1;mu,norm=gs();k=max(1,k-1)
 return B,steps,k==n

def atan_half(s,n):
 mod=1<<(n-1);s%=1<<n;ss=s*s%mod;p=s//2%mod;z=0;k=0;sign=1
 while p:
  z=(z+sign*p*pow(2*k+1,-1,mod))%mod;p=p*ss%mod;k+=1;sign=-sign
  if k>n+2:break
