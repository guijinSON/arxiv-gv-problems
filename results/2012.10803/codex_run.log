+        return None
+    for raw in reversed(matches):
+        payload = raw.strip()
+        payload = re.sub(r"^```(?:json|text)?\s*", "", payload,
+                         flags=re.IGNORECASE)
+        payload = re.sub(r"\s*```$", "", payload)
+        try:
+            value = json.loads(payload)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continue
+        if (isinstance(value, list)
+                and all(isinstance(item, int) and not isinstance(item, bool)
+                        for item in value)):
+            return value
+    return None
+
+
+def _instance_data(inst: dict) -> tuple[int, int, int, int,
+                                            list[dict[str, int]], int]:
+    n = inst.get("n")
+    radius = inst.get("radius")
+    depth = inst.get("depth")
+    modulus = inst.get("modulus")
+    generators = inst.get("generators")
+    target = inst.get("target_slope")
+    integer_fields = (n, radius, depth, modulus, target)
+    if any(isinstance(value, bool) or not isinstance(value, int)
+           for value in integer_fields):
+        raise ValueError("noninteger instance parameter")
+    if not 3 <= n <= 512 or not 1 <= radius <= 31 or depth < 5:
+        raise ValueError("instance parameter outside supported bounds")
+    if modulus != 1 << depth:
+        raise ValueError("modulus is not 2^depth")
+    if not isinstance(generators, list) or len(generators) != n:
+        raise ValueError("generator list has the wrong length")
+    if not 0 <= target < modulus or target % 2:
+        raise ValueError("target is not a canonical even slope")
+    norms: set[int] = set()
+    for row in generators:
+        if not isinstance(row, dict):
+            raise ValueError("generator row is not an object")
+        norm, a, b = row.get("norm"), row.get("a"), row.get("b")
+        if any(isinstance(value, bool) or not isinstance(value, int)
+               for value in (norm, a, b)):
+            raise ValueError("generator row contains a noninteger")
+        if norm in norms or norm != a * a + b * b or not _is_prime(norm):
+            raise ValueError("generator norms must be distinct Gaussian primes")
+        if norm % 2 == 0:
+            raise ValueError("generator norm is not coprime to the conductor")
+        _canonical_slope((a, b), modulus)
+        norms.add(norm)
+    return n, radius, depth, modulus, generators, target
+
+
+def _valid_exponents(exponents: list[int], radius: int, modulus: int,
+                     generators: list[dict[str, int]], target: int) -> bool:
+    product = _product_for_exponents(generators, exponents, modulus)
+    return _pair_has_slope(product, target, modulus)
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Verify any bounded exponent witness without consulting the planted one."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    expected = inst.get("n")
+    if isinstance(expected, bool) or not isinstance(expected, int):
+        return False, "invalid instance: noninteger n"
+    if len(answer) < expected:
+        return False, f"too few exponents: expected {expected}"
+    if len(answer) > expected:
+        return False, f"too many exponents: expected {expected}"
+    if any(isinstance(value, bool) or not isinstance(value, int)
+           for value in answer):
+        return False, "every exponent must be an integer"
+    radius = inst.get("radius")
+    if (isinstance(radius, bool) or not isinstance(radius, int)
+            or any(value < -radius or value > radius for value in answer)):
+        return False, "an exponent is outside the inclusive bound"
+    try:
+        _, radius, _, modulus, generators, target = _instance_data(inst)
+    except (KeyError, TypeError, ValueError, ArithmeticError) as exc:
+        return False, f"invalid instance: {exc}"
+    if not _valid_exponents(answer, radius, modulus, generators, target):
+        return False, "the quotient-class product does not equal the target"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample every stated shape and bound constraint."""
+    return [rng.randint(-inst["radius"], inst["radius"])
+            for _ in range(inst["n"])]
+
+
+def search_space(inst: dict) -> int | None:
+    """Exact cardinality of the bounded exponent language."""
+    return pow(2 * inst["radius"] + 1, inst["n"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count all witnesses exactly when the bounded language is small."""
+    space = search_space(inst)
+    if space is None or space > _ENUMERATION_CAP:
+        return None
+    _, radius, _, modulus, generators, target = _instance_data(inst)
+    count = 0
+    for candidate in itertools.product(range(-radius, radius + 1),
+                                       repeat=len(generators)):
+        count += int(_valid_exponents(list(candidate), radius, modulus,
+                                     generators, target))
+    return count
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonical under row order, prime orientation, and global conjugation."""
+    _, radius, depth, modulus, generators, target = _instance_data(inst)
+    classes = []
+    for row in generators:
+        slope = _canonical_slope((row["a"], row["b"]), modulus)
+        classes.append(min(slope, (-slope) % modulus))
+    normalized = {
+        "depth": depth,
+        "radius": radius,
+        "generator_classes_up_to_orientation": sorted(classes),
+        "target_up_to_conjugation": min(target, (-target) % modulus),
+    }
+    payload = json.dumps(normalized, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow coefficient entropy at fixed answer length before growing arity."""
+    result = {key: value for key, value in params.items() if key != "_preset"}
+    radius = int(result.get("radius", 1))
+    bits = int(result.get("prime_bits", 20))
+    n = int(result.get("n", 160))
+    if radius < 7:
+        result["radius"] = radius + 1
+        return result
+    if bits < 31:
+        result["prime_bits"] = min(31, bits + 2)
+        return result
+    if n + 16 <= 256:
+        result["n"] = n + 16
+        return result
+    return "cap_bound"
+
+
+def _public_logs(inst: dict) -> tuple[list[int], int, int]:
+    """Linearize public quotient classes for adversarial probes."""
+    _, _, depth, modulus, generators, target = _instance_data(inst)
+    weights = [
+        _class_log_from_slope(
+            _canonical_slope((row["a"], row["b"]), modulus), depth)
+        for row in generators
+    ]
+    target_log = _class_log_from_slope(target, depth)
+    return weights, target_log, 1 << (depth - 1)
+
+
+def _centered(value: int, modulus: int) -> int:
+    value %= modulus
+    return value if value <= modulus // 2 else value - modulus
+
+
+def _outlier_norm_rank(inst: dict) -> list[int]:
+    radius = inst["radius"]
+    order = sorted(range(inst["n"]),
+                   key=lambda i: inst["generators"][i]["norm"])
+    candidate = [0] * inst["n"]
+    pattern = (-radius, 0, radius)
+    for rank, index in enumerate(order):
+        candidate[index] = pattern[rank % len(pattern)]
+    return candidate
+
+
+def _greedy_2adic(inst: dict, weights: list[int], target: int,
+                  group_order: int) -> list[int]:
+    radius = inst["radius"]
+    candidate = []
+    partial = 0
+    for weight in weights:
+        choice = min(
+            range(-radius, radius + 1),
+            key=lambda exponent: abs(_centered(
+                target - partial - exponent * weight, group_order)),
+        )
+        candidate.append(choice)
+        partial = (partial + choice * weight) % group_order
+    return candidate
+
+
+def _small_support_attack(inst: dict, weights: list[int], target: int,
+                          group_order: int) -> tuple[list[int], int]:
+    radius = inst["radius"]
+    n = inst["n"]
+    tested = 1
+    if target % group_order == 0:
+        return [0] * n, tested
+    for i in range(n):
+        for exponent in range(-radius, radius + 1):
+            if not exponent:
+                continue
+            tested += 1
+            if exponent * weights[i] % group_order == target:
+                answer = [0] * n
+                answer[i] = exponent
+                return answer, tested
+    # Limit the two-coordinate by-hand window to the first 16 coordinates.
+    for i in range(min(n, 16)):
+        for j in range(i + 1, min(n, 16)):
+            for ei in range(-radius, radius + 1):
+                for ej in range(-radius, radius + 1):
+                    if not ei or not ej:
+                        continue
+                    tested += 1
+                    if (ei * weights[i] + ej * weights[j]) % group_order == target:
+                        answer = [0] * n
+                        answer[i], answer[j] = ei, ej
+                        return answer, tested
+    return [0] * n, tested
+
+
+def _random_restart_attack(inst: dict, rng: random.Random,
+                           attempts: int = 256) -> tuple[list[int], int]:
+    _, radius, _, modulus, generators, target = _instance_data(inst)
+    last = [0] * len(generators)
+    for iteration in range(1, attempts + 1):
+        last = [rng.randint(-radius, radius) for _ in generators]
+        if _valid_exponents(last, radius, modulus, generators, target):
+            return last, iteration
+    return last, attempts
+
+
+def _mitm_capped(inst: dict, weights: list[int], target: int,
+                 group_order: int, rng: random.Random,
+                 per_side: int = 32_768) -> tuple[list[int] | None, int]:
+    """A memory-bounded randomized meet-in-the-middle subset-product attack."""
+    radius = inst["radius"]
+    split = inst["n"] // 2
+    left_weights = weights[:split]
+    right_weights = weights[split:]
+    table: dict[int, list[int]] = {}
+    for _ in range(per_side):
+        vector = [rng.randint(-radius, radius) for _ in left_weights]
+        residue = sum(e * w for e, w in zip(vector, left_weights)) % group_order
+        table.setdefault(residue, vector)
+    for _ in range(per_side):
+        vector = [rng.randint(-radius, radius) for _ in right_weights]
+        residue = sum(e * w for e, w in zip(vector, right_weights)) % group_order
+        needed = (target - residue) % group_order
+        if needed in table:
+            return table[needed] + vector, 2 * per_side
+    return None, 2 * per_side
+
+
+def _lll_float(basis: list[list[int]], deadline: float,
+               max_steps: int = 4_000) -> tuple[list[list[int]], int, bool]:
+    """Small rounded floating-point LLL probe with exact integer row updates."""
+    rows = [list(row) for row in basis]
+    count = len(rows)
+    width = len(rows[0])
+    steps = 0
+
+    def gram_schmidt() -> tuple[list[list[float]], list[float]]:
+        orthogonal: list[list[float]] = []
+        mu = [[0.0] * count for _ in range(count)]
+        norms = [0.0] * count
+        for i, row in enumerate(rows):
+            vector = [float(value) for value in row]
+            for j in range(i):
+                if norms[j] <= 1e-300:
+                    continue
+                coefficient = sum(float(row[k]) * orthogonal[j][k]
+                                  for k in range(width)) / norms[j]
+                mu[i][j] = coefficient
+                for k in range(width):
+                    vector[k] -= coefficient * orthogonal[j][k]
+            orthogonal.append(vector)
+            norms[i] = sum(value * value for value in vector)
+        return mu, norms
+
+    mu, norms = gram_schmidt()
+    k = 1
+    while k < count and steps < max_steps and time.perf_counter() < deadline:
+        for j in range(k - 1, -1, -1):
+            coefficient = int(round(mu[k][j]))
+            if coefficient:
+                rows[k] = [a - coefficient * b
+                           for a, b in zip(rows[k], rows[j])]
+                steps += 1
+                mu, norms = gram_schmidt()
+                if time.perf_counter() >= deadline:
+                    break
+        if time.perf_counter() >= deadline:
+            break
+        if norms[k] + 1e-200 >= (0.75 - mu[k][k - 1] ** 2) * norms[k - 1]:
+            k += 1
+        else:
+            rows[k], rows[k - 1] = rows[k - 1], rows[k]
+            steps += 1
+            mu, norms = gram_schmidt()
+            k = max(1, k - 1)
+    return rows, steps, k == count
+
+
+def _lll_cvp_projection(inst: dict, weights: list[int], target: int,
+                        group_order: int, seconds: float = 0.75
+                        ) -> tuple[list[int] | None, dict[str, Any]]:
+    """Run a rounded Kannan embedding on a 24-coordinate projection."""
+    dimension = min(24, inst["n"])
+    radius = inst["radius"]
+    coordinate_scale = 16
+    residue_scale = 1 << 36
+    embedding = max(2, round(coordinate_scale * radius * math.sqrt(dimension)))
+    width = dimension + 2
+
+    def scaled(value: int) -> int:
+        return (value * residue_scale + group_order // 2) // group_order
+
+    basis: list[list[int]] = []
+    for i, weight in enumerate(weights[:dimension]):
+        row = [0] * width
+        row[i] = coordinate_scale
+        row[dimension] = scaled(weight)
+        basis.append(row)
+    modulus_row = [0] * width
+    modulus_row[dimension] = residue_scale
+    basis.append(modulus_row)
+    target_row = [0] * width
+    target_row[dimension] = scaled(target)
+    target_row[dimension + 1] = embedding
+    basis.append(target_row)
+
+    started = time.perf_counter()
+    reduced, steps, completed = _lll_float(
+        basis, deadline=started + seconds)
+    elapsed = time.perf_counter() - started
+    for row in reduced:
+        if abs(row[-1]) != embedding:
+            continue
+        if any(value % coordinate_scale for value in row[:dimension]):
+            continue
+        short = [value // coordinate_scale for value in row[:dimension]]
+        if row[-1] == embedding:
+            short = [-value for value in short]
+        if any(abs(value) > radius for value in short):
+            continue
+        candidate = short + [0] * (inst["n"] - dimension)
+        if sum(e * w for e, w in zip(candidate, weights)) % group_order == target:
+            return candidate, {
+                "wall_clock_sec": elapsed,
+                "lll_row_operations": steps,
+                "projection_dimension": dimension,
+                "completed": completed,
+            }
+    return None, {
+        "wall_clock_sec": elapsed,
+        "lll_row_operations": steps,
+        "projection_dimension": dimension,
+        "completed": completed,
+    }
+
+
+def _choice_table(inst: dict) -> tuple[list[list[tuple[int, int]]], int,
+                                        list[dict[str, int]], int]:
+    _, radius, _, modulus, generators, target = _instance_data(inst)
+    table = []
+    for row in generators:
+        base = (row["a"] % modulus, row["b"] % modulus)
+        table.append([_gpow(base, exponent, modulus)
+                      for exponent in range(-radius, radius + 1)])
+    return table, modulus, generators, target
+
+
+def _valid_from_table(candidate: list[int], radius: int,
+                      table: list[list[tuple[int, int]]], modulus: int,
+                      target: int) -> bool:
+    product = (1, 0)
+    for exponent, choices in zip(candidate, table):
+        product = _gmul(product, choices[exponent + radius], modulus)
+    return _pair_has_slope(product, target, modulus)
+
+
+def _transformed(inst: dict, seed: int, global_conjugate: bool = True
+                 ) -> tuple[dict, list[int]]:
+    """Permute and independently reverse oriented primes, carrying a witness."""
+    rng = random.Random(seed)
+    order = list(range(inst["n"]))
+    rng.shuffle(order)
+    generators = []
+    answer = []
+    for old_index in order:
+        row = dict(inst["generators"][old_index])
+        exponent = inst["answer"][old_index]
+        if global_conjugate:
+            row["b"] = -row["b"]
+        if rng.randrange(2):
+            row["b"] = -row["b"]
+            exponent = -exponent
+        generators.append(row)
+        answer.append(exponent)
+    transformed = dict(inst)
+    transformed["generators"] = generators
+    if global_conjugate:
+        transformed["target_slope"] = (-inst["target_slope"]) % inst["modulus"]
+    # Keep the old planted answer deliberately: canonical_key must not consult it.
+    transformed["answer"] = list(inst["answer"])
+    return transformed, answer
+
+
+def _atom_count(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_atom_count(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_atom_count(item) for item in value)
+    return 1
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return measured, JSON-native evidence."""
+    report: dict[str, Any] = {
+        "paper": "2012.10803",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    g1_failures = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in range(3):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append(f"{preset}/{seed}: {reason}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append(f"{preset}/{seed}: answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=314159, **ship_params)
+    planted = list(ship["answer"])
+    positions = next(
+        (pair for pair in itertools.combinations(range(len(planted)), 2)
+         if planted[pair[0]] != planted[pair[1]]),
+        None,
+    )
+    if positions is None:
+        raise AssertionError("shipping witness unexpectedly has no unequal entries")
+    swapped = planted[:]
+    i, j = positions
+    swapped[i], swapped[j] = swapped[j], swapped[i]
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_unequal_coordinates": swapped,
+        "duplicate_one": planted + [planted[-1]],
+        "empty": [],
+        "out_of_range": [ship["radius"] + 1] + planted[1:],
+    }
+    corruption_cases = {}
+    corruption_reasons = []
+    for name, candidate in corruptions.items():
+        ok, reason = verify(ship, candidate)
+        corruption_cases[name] = {"rejected": not ok, "reason": reason}
+        corruption_reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": (all(case["rejected"] for case in corruption_cases.values())
+                 and len(set(corruption_reasons)) == len(corruption_reasons)),
+        "distinct_reasons": len(set(corruption_reasons)),
+        "cases": corruption_cases,
+    }
+
+    answer_json = json.dumps(planted, separators=(",", ":"))
+    realistic = (
+        "I normalized the Gaussian quotient classes and checked the product.\n"
+        "```json\n"
+        f"<answer>{answer_json}</answer>\n"
+        "```\nThe entries follow the displayed row order."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("no tags here") is None,
+        "parsed_equals_planted": parsed == planted,
+        "garbage_returns_none": parse_answer("<answer>not json</answer>") is None,
+    }
+
+    # G4 and the shipping part of G5 share one exact, structure-aware sample.
+    sample_total = 200_000
+    sample_rng = random.Random(8675309)
+    table, modulus, _, target = _choice_table(ship)
+    sample_hits = 0
+    crosscheck_failures = 0
+    for sample_index in range(sample_total):
+        candidate = random_candidate(ship, sample_rng)
+        valid = _valid_from_table(candidate, ship["radius"], table,
+                                  modulus, target)
+        sample_hits += int(valid)
+        if sample_index < 128 and verify(ship, candidate)[0] != valid:
+            crosscheck_failures += 1
+    density = sample_hits / sample_total
+    report["G4_guess_resistance"] = {
+        "pass": density < 1e-6 and crosscheck_failures == 0,
+        "hits": sample_hits,
+        "total": sample_total,
+        "observed_probability": density,
+        "candidate_space": search_space(ship),
+        "sampler": "uniform bounded exponent vectors in [-r,r]^t",
+        "checker_equivalence_crosschecks": 128,
+        "checker_equivalence_failures": crosscheck_failures,
+    }
+
+    attack_names = (
+        "outlier_norm_rank",
+        "greedy_2adic_residual",
+        "random_restart_256",
+        "by_hand_support_at_most_two",
+        "meet_in_the_middle_32768_per_side",
+        "lattice_lll_cvp_24_coordinate_projection",
+    )
+    attacks = {name: {"successes": 0, "attempts": 8}
+               for name in attack_names}
+    attack_times = {name: [] for name in attack_names}
+    small_support_tests = []
+    restart_counts = []
+    mitm_candidates = []
+    lll_steps = []
+    lll_completed = []
+    for seed in range(8):
+        trial = make_instance(seed=12_000 + seed, **ship_params)
+        weights, target_log, group_order = _public_logs(trial)
+
+        started = time.perf_counter()
+        candidate = _outlier_norm_rank(trial)
+        attack_times["outlier_norm_rank"].append(time.perf_counter() - started)
+        attacks["outlier_norm_rank"]["successes"] += int(verify(trial, candidate)[0])
+
+        started = time.perf_counter()
+        candidate = _greedy_2adic(trial, weights, target_log, group_order)
+        attack_times["greedy_2adic_residual"].append(time.perf_counter() - started)
+        attacks["greedy_2adic_residual"]["successes"] += int(
+            verify(trial, candidate)[0])
+
+        started = time.perf_counter()
+        candidate, restarts = _random_restart_attack(
+            trial, random.Random(90_000 + seed))
+        attack_times["random_restart_256"].append(time.perf_counter() - started)
+        restart_counts.append(restarts)
+        attacks["random_restart_256"]["successes"] += int(
+            verify(trial, candidate)[0])
+
+        started = time.perf_counter()
+        candidate, tested = _small_support_attack(
+            trial, weights, target_log, group_order)
+        attack_times["by_hand_support_at_most_two"].append(
+            time.perf_counter() - started)
+        small_support_tests.append(tested)
+        attacks["by_hand_support_at_most_two"]["successes"] += int(
+            verify(trial, candidate)[0])
+
+        started = time.perf_counter()
+        candidate, tested = _mitm_capped(
+            trial, weights, target_log, group_order,
+            random.Random(100_000 + seed))
+        attack_times["meet_in_the_middle_32768_per_side"].append(
+            time.perf_counter() - started)
+        mitm_candidates.append(tested)
+        if candidate is not None:
+            attacks["meet_in_the_middle_32768_per_side"]["successes"] += int(
+                verify(trial, candidate)[0])
+
+        started = time.perf_counter()
+        candidate, metrics = _lll_cvp_projection(
+            trial, weights, target_log, group_order)
+        attack_times["lattice_lll_cvp_24_coordinate_projection"].append(
+            time.perf_counter() - started)
+        lll_steps.append(metrics["lll_row_operations"])
+        lll_completed.append(bool(metrics["completed"]))
+        if candidate is not None:
+            attacks["lattice_lll_cvp_24_coordinate_projection"]["successes"] += int(
+                verify(trial, candidate)[0])
+
+    for name in attack_names:
+        values = attack_times[name]
+        attacks[name]["wall_clock_sec_mean"] = sum(values) / len(values)
+        attacks[name]["wall_clock_sec_max"] = max(values)
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
