   625	def escalate(params: dict) -> dict | str | None:
   626	    harder = {k: v for k, v in params.items() if k != "_preset"}
   627	    n = int(harder.get("n", 40))
   628	    r = int(harder.get("exponent_bound", 5))
   629	    slack = int(harder.get("slack_trits", 4))
   630	    if n != 40:
   631	        # Normalize ad-hoc inputs to the shipping answer length before widening.
   632	        harder.update({"n": max(40, n), "exponent_bound": max(5, r), "slack_trits": slack})
   633	        return harder
   634	    if r < 7:
   635	        harder["exponent_bound"] = 7
   636	        harder["slack_trits"] = slack
   637	        return harder
   638	    # r=8 raises worst-case exact group operations beyond the G9(c) limit.
   639	    return "cap_bound"
