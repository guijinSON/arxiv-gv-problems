   722	def _lll_attack(
   723	    weights: list[int], target: int, order: int, r: int
   724	) -> tuple[list[int] | None, dict]:
   725	    n = len(weights)
   726	    scale = 2 * r * math.isqrt(n) + 10
   727	    basis: list[list[int]] = []
   728	    for index, weight in enumerate(weights):
   729	        row = [0] * (n + 2)
   730	        row[index] = 1
   731	        row[n] = scale * weight
   732	        basis.append(row)
   733	    modulus_row = [0] * (n + 2)
   734	    modulus_row[n] = scale * order
   735	    basis.append(modulus_row)
   736	    target_row = [0] * (n + 2)
   737	    target_row[n] = scale * target
   738	    target_row[n + 1] = 1
   739	    basis.append(target_row)
   740	
   741	    reduced, stats = _lll_reduce(basis)
   742	    for row in reduced:
   743	        if abs(row[-1]) != 1 or row[n] != 0:
   744	            continue
   745	        orientation = -row[-1]
   746	        candidate = [orientation * value for value in row[:n]]
   747	        if (
   748	            all(-r <= value <= r for value in candidate)
   749	            and sum(weight * value for weight, value in zip(weights, candidate)) % order == target
   750	        ):
   751	            return candidate, stats
   752	    return None, stats
   753	
