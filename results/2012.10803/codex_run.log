+def _canonical_slope(pair: tuple[int, int], modulus: int) -> int:
+    """Return the unique even slope of a Gaussian unit quotient class."""
+    a, b = pair[0] % modulus, pair[1] % modulus
+    if a % 2:
+        slope = b * pow(a, -1, modulus) % modulus
+    elif b % 2:
+        # Multiplication by -i changes a+bi to b-ai and makes the real part odd.
+        slope = (-a) * pow(b, -1, modulus) % modulus
+    else:
+        raise ValueError("Gaussian residue is not a unit modulo 2^d")
+    if slope % 2:
+        raise ArithmeticError("quotient normalization did not yield an even slope")
+    return slope
