            status = "SOLVED" if solved else "no_short_pm1_vector"
        except TimeoutError:
            status = "TIMEOUT(%ds)" % cap
        print("  LLL n=%-3d seed %-5d %-18s %6.1fs" % (n, seed, status, time.time()-t0), flush=True)

if __name__ == "__main__":
