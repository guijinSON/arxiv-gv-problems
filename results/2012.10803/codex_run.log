+    """Pohlig-Hellman in the cyclic class group; return (log, group ops)."""
+    modulus = int(inst["modulus"])
+    depth = int(inst["depth"])
+    order = int(inst["class_group_order"])
+    generator = (-2 % modulus, 4 % modulus)
