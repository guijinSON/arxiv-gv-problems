   879	def _invert_instance(inst: dict, indices: set[int]) -> tuple[dict, list[int]]:
   880	    moved = _copy_without_answer(inst)
   881	    modulus = int(inst["modulus"])
   882	    answer = list(inst["answer"])
   883	    for index in indices:
   884	        z = tuple(inst["class_generators"][index])
   885	        inverse = _ginv(z, modulus)
   886	        moved["class_generators"][index] = [inverse[0], inverse[1]]
   887	        answer[index] = -answer[index]
   888	    moved["answer"] = answer
   889	    return moved, answer
