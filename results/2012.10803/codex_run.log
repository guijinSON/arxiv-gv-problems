   796	def _random_restart_attack(
   797	    weights: list[int], target: int, order: int, r: int, rng: random.Random
   798	) -> tuple[list[int] | None, int]:
   799	    attempts = 256
   800	    for _ in range(attempts):
   801	        candidate = [rng.randint(-r, r) for _ in weights]
   802	        if sum(w * e for w, e in zip(weights, candidate)) % order == target:
   803	            return candidate, attempts
   804	    return None, attempts
