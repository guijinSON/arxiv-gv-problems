+    The convergent 2-adic series is used only by attacks.  The checker needs
+    merely Gaussian multiplication and does not depend on this linearization.
+    """
+    modulus = 1 << (depth - 1)
+    slope %= 1 << depth
+    if slope % 2:
+        raise ValueError("2-adic arctangent requires an even slope")
