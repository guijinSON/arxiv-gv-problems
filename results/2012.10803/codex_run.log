   755	def _one_sparse_attack(
   756	    weights: list[int], target: int, order: int, r: int
   757	) -> list[int] | None:
   758	    for index, weight in enumerate(weights):
   759	        for exponent in range(-r, r + 1):
   760	            if exponent and exponent * weight % order == target:
   761	                candidate = [0] * len(weights)
   762	                candidate[index] = exponent
   763	                return candidate
   764	    return None
   765	
   766	
   767	def _greedy_attack(
   768	    weights: list[int], target: int, order: int, r: int
   769	) -> list[int] | None:
   770	    def distance(value: int) -> int:
   771	        residue = (target - value) % order
   772	        return min(residue, order - residue)
   773	
   774	    for ordering in (
   775	        list(range(len(weights))),
   776	        sorted(range(len(weights)), key=lambda j: min(weights[j], order - weights[j]), reverse=True),
   777	    ):
   778	        candidate = [0] * len(weights)
   779	        total = 0
   780	        for _ in range(3):
   781	            changed = False
   782	            for index in ordering:
   783	                without = total - candidate[index] * weights[index]
   784	                best = min(range(-r, r + 1), key=lambda e: distance(without + e * weights[index]))
   785	                if best != candidate[index]:
   786	                    total = without + best * weights[index]
   787	                    candidate[index] = best
   788	                    changed = True
   789	            if total % order == target:
   790	                return candidate
   791	            if not changed:
   792	                break
   793	    return None
