+def _gpow(base: tuple[int, int], exponent: int, modulus: int
+          ) -> tuple[int, int]:
+    """Power a Gaussian class; conjugation represents inverse modulo scalars."""
+    if exponent < 0:
+        base = (base[0], (-base[1]) % modulus)
+        exponent = -exponent
+    result = (1, 0)
+    while exponent:
+        if exponent & 1:
+            result = _gmul(result, base, modulus)
+        base = _gmul(base, base, modulus)
+        exponent //= 2
+    return result
