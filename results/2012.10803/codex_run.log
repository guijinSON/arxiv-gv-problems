+    "easy": {"n": 160, "radius": 1, "prime_bits": 20, "depth_slack": 2},
+    "medium": {"n": 180, "radius": 1, "prime_bits": 22, "depth_slack": 2},
+    "hard": {"n": 200, "radius": 1, "prime_bits": 24, "depth_slack": 2},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The Gaussian-unit/scalar quotient has a 2-adic filtration visible in "
+    "its unique even-slope representatives."
+)
