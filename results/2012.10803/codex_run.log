+    "native_domain": "number_theory",
+    "object_regime": "finite_discrete",
+    "computational_core": "subset_sum",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "nonmaximal Gaussian order O_d = Z + 2^d Z[i]",
+        "oriented split-prime ideal classes in the ring-class quotient",
+        "a target quotient class represented by its even Gaussian slope",
+    ],
+    "verification_operations": [
+        "exact Gaussian-integer multiplication modulo 2^d",
+        "exact quotient by Gaussian units and odd scalar units",
+        "exact modular congruence comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "constraint propagation",
+    "intuition_description": (
+        "The Gaussian ring-class quotient has a 2-adic filtration, so low "
+        "bits constrain bounded exponents while an unstructured search must "
