   871	def _reorder_instance(inst: dict, order_indices: list[int]) -> tuple[dict, list[int]]:
   872	    moved = _copy_without_answer(inst)
   873	    moved["class_generators"] = [inst["class_generators"][i] for i in order_indices]
   874	    answer = [inst["answer"][i] for i in order_indices]
   875	    moved["answer"] = answer
   876	    return moved, answer
