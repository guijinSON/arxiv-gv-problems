+def _axis_multiple(
+    z: tuple[int, int], scalar: int, unit: int, modulus: int
+) -> tuple[int, int]:
+    scalar %= modulus
+    if unit == 0:
+        axis = (scalar, 0)
+    elif unit == 1:
+        axis = (0, scalar)
+    elif unit == 2:
+        axis = (-scalar % modulus, 0)
+    else:
+        axis = (0, -scalar % modulus)
+    return _gmul(axis, z, modulus)
 
 
