+def _pair_has_slope(pair: tuple[int, int], slope: int, modulus: int) -> bool:
+    """Compare to an even slope without performing a modular inversion."""
+    a, b = pair[0] % modulus, pair[1] % modulus
+    if a % 2:
+        return (b - a * slope) % modulus == 0
+    if b % 2:
+        return (-a - b * slope) % modulus == 0
+    return False
