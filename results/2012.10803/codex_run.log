def lll_float(B,delta=.75,max_steps=20000,deadline=None):
 B=[r[:] for r in B];n=len(B);m=len(B[0]);steps=0
 def gs():
  Bs=[]; mu=[[0.0]*n for _ in range(n)]; norm=[0.0]*n
  for i,row in enumerate(B):
   v=[float(x) for x in row]
   for j in range(i):
    if norm[j]==0:continue
    dot=sum(float(row[k])*Bs[j][k] for k in range(m))
    q=dot/norm[j];mu[i][j]=q
    for k in range(m):v[k]-=q*Bs[j][k]
   Bs.append(v);norm[i]=sum(x*x for x in v)
  return mu,norm
 mu,norm=gs();k=1
