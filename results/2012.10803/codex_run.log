+    ax = (1, 0)
+    place = 1
+    for index in range(k):
+        c = _gmul(h, _ginv(ax, modulus), modulus)
+        ops += 2
+        d, count = _gpow_counted(c, pow(3, k - 1 - index), modulus)
+        ops += count
+        digit = None
+        for possible in range(3):
+            if _class_equal(d, gamma_powers[possible], modulus):
+                digit = possible
+                ops += 2
