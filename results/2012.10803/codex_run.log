   892	def _automorphism_instance(inst: dict, multiplier: int) -> tuple[dict, list[int]]:
   893	    moved = _copy_without_answer(inst)
   894	    modulus = int(inst["modulus"])
   895	    moved["class_generators"] = [
   896	        list(_gpow(tuple(pair), multiplier, modulus)) for pair in inst["class_generators"]
   897	    ]
   898	    moved["target_class"] = list(_gpow(tuple(inst["target_class"]), multiplier, modulus))
   899	    return moved, list(inst["answer"])
