+def _gpow_counted(
+    base: tuple[int, int], exponent: int, modulus: int
+) -> tuple[tuple[int, int], int]:
+    operations = 0
+    if exponent < 0:
+        base = _ginv(base, modulus)
+        exponent = -exponent
