   807	def _capped_mitm_attack(
   808	    weights: list[int], target: int, order: int, r: int, rng: random.Random
   809	) -> tuple[list[int] | None, int]:
   810	    midpoint = len(weights) // 2
   811	    left_weights = weights[:midpoint]
   812	    right_weights = weights[midpoint:]
   813	    per_side = 20_000
   814	    left: dict[int, list[int]] = {}
   815	    for _ in range(per_side):
   816	        vector = [rng.randint(-r, r) for _ in left_weights]
   817	        value = sum(w * e for w, e in zip(left_weights, vector)) % order
   818	        left.setdefault(value, vector)
   819	    for _ in range(per_side):
   820	        vector = [rng.randint(-r, r) for _ in right_weights]
   821	        value = sum(w * e for w, e in zip(right_weights, vector)) % order
   822	        complement = (target - value) % order
   823	        if complement in left:
   824	            return left[complement] + vector, 2 * per_side
   825	    return None, 2 * per_side
