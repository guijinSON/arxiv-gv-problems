+
+
+def _transformed_instance(inst: dict, mode: str, salt: int) -> dict:
+    rng = random.Random(0x151203127 + salt)
+    out = _copy_public(inst)
+    answer = list(inst["answer"])
+
+    if mode in ("variable_relabel", "combined"):
