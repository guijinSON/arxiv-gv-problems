+        "base_n": ship_params["n"],
+        "doubled_n": doubled_params["n"],
+        "base_witness_length": len(inst["choice_groups"]),
+        "doubled_witness_length": len(doubled["choice_groups"]),
+        "base_search_space": search_space(inst),
