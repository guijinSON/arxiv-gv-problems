+    return {
+        "family": "positive_1_in_3_line_graph",
+        "n": n,
+        "min_girth": min_girth,
+        "num_variables": variable_count,
+        "choice_groups": groups,
+        "check_clauses": checks,
+        "answer": sorted(answer),
+        "construction_attempts": attempts,
+    }
