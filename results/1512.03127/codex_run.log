+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=314159, **ship_params)
+
+    # G2: five corruptions with five distinct diagnostics.
+    answer = list(inst["answer"])
+    dropped = answer[:-1]
+    duplicate = answer[:]
