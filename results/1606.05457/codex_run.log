+    for index, item in enumerate(basis):
+        matches = sum(
+            item[i][j] % p == inst["P"][i][j] % p
+            for i in range(n)
+            for j in range(i, n)
+        )
+        scored.append((matches, -index))
+    index = -max(scored)[1]
+    anchor = basis[index][-1][-1]
