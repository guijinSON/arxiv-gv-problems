+    obtained = sum(a * b for a, b in zip(flat, anchor_coefficients)) % q
+    return obtained == inst["P"][-1][-1]
+
+
+def _attack_outlier_one_term(inst):
+    basis = _basis_orbit(inst)
+    p, q, n = inst["p"], inst["q"], inst["n"]
