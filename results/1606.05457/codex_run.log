+def _poly_matrix(coefficients, powers, p: int, n: int):
+    out = _zero(n)
+    for coefficient, power in zip(coefficients, powers):
+        if coefficient:
+            out = _mat_add(out, _scalar_mul(coefficient, power, p, n), p, n)
+    return out
