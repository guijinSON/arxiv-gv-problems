+def verify(inst, answer) -> tuple[bool, str]:
+    """Verify shape, bounds, and the exact native ring identity."""
+    n = inst.get("n")
+    p = inst.get("p")
+    q = inst.get("q")
+    if not _is_int(n) or not _is_int(p) or not _is_int(q):
+        return False, "instance parameters are malformed"
