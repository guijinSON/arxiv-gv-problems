+            continue
+        trial = copy.deepcopy(answer)
+        trial[first[0]][first[1]], trial[second[0]][second[1]] = (
+            trial[second[0]][second[1]],
+            trial[first[0]][first[1]],
+        )
+        if not verify(inst, trial)[0]:
+            swap = trial
+            swapped = True
