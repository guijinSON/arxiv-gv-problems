+        "random_restart_256": {"successes": 0, "attempts": 0},
+        "in_context_affine_factor_ansatz": {"successes": 0, "attempts": 0},
+    }
+    reference_successes = 0
+    reference_times = []
+    reference_operations = []
+    reference_pivots = []
+    compact_successes = 0
+    compact_times = []
+    compact_counts = []
