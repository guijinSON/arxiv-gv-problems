+        "parsed_equals_answer": parsed == answer,
+        "garbage_returns_none": parse_answer("no tags here") is None,
+    }
+
+    samples = 200_000
+    sample_rng = random.Random(0x160605457)
+    basis = _basis_orbit(inst)
+    anchors = _anchor_coefficients(inst, basis)
+    hits = 0
