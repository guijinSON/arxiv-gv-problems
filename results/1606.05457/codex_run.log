+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "shipping_generic_dimension": inst["n"] ** 2,
+        "doubled_generic_dimension": doubled["n"] ** 2,
+        "generic_elimination_growth_factor": 64,
