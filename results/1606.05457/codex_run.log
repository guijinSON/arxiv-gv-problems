+    diagonal = [m[i][i] % p for i in range(n)]
+    u, v = _sample_dense_factors(rng, p, diagonal, n)
+    powers = _powers(m, p, n)
+    a1 = _poly_matrix(u, powers, p, n)
+    a2 = _poly_matrix(v, powers, p, n)
