+                json_roundtrips += 1
+            compact, stats = _compact_ntt_certificate(inst)
+            compact_ok, compact_reason = verify(inst, compact)
+            compact_checks += 1
+            compact_operations.append(stats["exact_operations"])
+            if not compact_ok:
