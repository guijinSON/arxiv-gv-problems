+    candidate = start + ((1 - start) % n)
+    if candidate < 3:
+        candidate += n
+    while not _is_prime_64(candidate):
+        candidate += n
+        if candidate >= 1 << bits:
+            raise ValueError("no suitable prime in the requested bit interval")
+    return candidate
