+        [inst["special_vertex"]] + sorted(vertex for _, vertex in low),
+        [inst["special_vertex"]] + sorted(vertex for _, vertex in high),
+    ]
+    return next((answer for answer in answers if verify(inst, answer)[0]), answers[0])
