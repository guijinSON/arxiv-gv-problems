+    internal_d = degree - q
+    internal_r = degree - 1
+    if k % 2 or (n - k) % 2:
+        raise ValueError("both planted and non-planted parts must have even size")
+    if not (0 <= internal_d < k and 0 <= internal_r < n - k):
+        raise ValueError("degree is incompatible with the regular construction")
