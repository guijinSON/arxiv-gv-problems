+def escalate(params):
+    harder = dict(params)
+    decoys = int(harder.get("decoder_decoys", 0))
+    if decoys < 1536:
+        harder["decoder_decoys"] = max(64, decoys * 2)
+        return harder
+    n = int(harder["n"])
+    k = int(harder["k"])
+    if n < 180:
+        harder["n"] = n + 24
+        q = (harder["n"] - k) // k
+        harder["degree"] = q + 3
+        return harder
+    return None
