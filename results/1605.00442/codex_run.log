+        "remove_special": [shipping["extra_vertices"][0]] + answer[1:],
+    }
+    replacement = None
+    planted = set(answer[1:])
+    for old in answer[1:]:
+        for new in shipping["eligible_vertices"]:
+            if new in planted:
