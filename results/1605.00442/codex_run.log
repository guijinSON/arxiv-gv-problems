+def _answer_from_key(inst, key):
+    selected = sorted(
+        vertex
+        for vertex, mask in inst["annotations"]
+        if ((int(mask) & int(key)).bit_count() & 1) == 0
+    )
+    if len(selected) != inst["k"]:
+        return None
+    return [inst["special_vertex"]] + selected
