+
+    inst = {
+        "n": n,
+        "k": k,
+        "degree": degree,
+        "token_count": k + 1,
+        "vertex_count": total,
+        "clique": clique,
+        "independent_side": independent_side,
+        "eligible_vertices": candidates,
+        "extra_vertices": extras,
+        "special_vertex": special,
+        "cross_neighborhoods": neighborhoods,
