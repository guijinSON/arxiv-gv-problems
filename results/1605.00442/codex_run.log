+        return harder
+    n = int(harder["n"])
+    k = int(harder["k"])
+    if n < 180:
+        harder["n"] = n + 24
+        q = (harder["n"] - k) // k
+        harder["degree"] = q + 3
+        return harder
+    return None
+
