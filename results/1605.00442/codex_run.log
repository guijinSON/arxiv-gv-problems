+        return answer
+    annotations = sorted(inst["annotations"])
+    ranked = sorted(
+        annotations,
+        key=lambda item: (((int(item[1]) & key).bit_count() & 1), item[0]),
+    )[: inst["k"]]
+    return [inst["special_vertex"]] + sorted(vertex for vertex, _ in ranked)
