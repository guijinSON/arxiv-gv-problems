+# Filled only from isolated scripts/harden.py runs.  Pending values deliberately
+# make G9 fail instead of manufacturing oracle evidence.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
