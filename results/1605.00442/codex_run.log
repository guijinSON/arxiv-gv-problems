import random

def trial(n,k,seed):
 q=n//k; h=(q-1)//2
 rng=random.Random(seed); labs=list(range(n));rng.shuffle(labs)
 cands=sorted(labs); idx={v:i for i,v in enumerate(cands)}
 covers=[]
 for v in cands:
  old=labs.index(v) # inefficient okay
  mask=0
  for d in range(-h,h+1): mask|=1<<((old+d)%n)
  covers.append(mask)
 universe=(1<<n)-1; chosen=[];covered=0;remaining=set(range(n))
 while len(chosen)<k:
  best=max(remaining,key=lambda i:(((covers[i]&~covered)&universe).bit_count(),-cands[i]))
  chosen.append(best);remaining.remove(best);covered|=covers[best]
 return covered==universe
for n in (108,132,156,180):
 k=12 if n>20 else 4
 print(n,sum(trial(n,k,s) for s in range(100)))
