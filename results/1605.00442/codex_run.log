+        rename[x] for x in inst["answer"][1:]
+    )
+    for key in (
+        "clique",
+        "independent_side",
+        "eligible_vertices",
+        "extra_vertices",
+        "cross_neighborhoods",
+        "decoder_rows",
+        "annotations",
+    ):
