+def _mask(bits):
+    return (1 << bits) - 1
+
+
+def _public_offset(bits):
+    """A conspicuous, explicitly displayed dense mask."""
+    pattern = int("d6a39c5e71b428f09d3c6a57", 16)
+    width = 96
+    value = 0
+    shift = 0
+    while shift < bits:
+        value |= pattern << shift
+        shift += width
+    return value & _mask(bits)
