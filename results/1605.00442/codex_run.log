    missing = NEED - set(r)
    if missing:
        fail.append(f"line {n}: missing keys {sorted(missing)}")
if not rows:
    fail.append("transcript is empty")

models = {r.get("model") for r in rows}
if len(models) < 3:
    fail.append(f"only {len(models)} distinct oracle model(s) used: {sorted(models)} — "
