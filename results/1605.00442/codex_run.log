+        "drop": answer[:-1],
+        "duplicate": answer[:-1] + [answer[1]],
+        "out_of_range": answer[:-1] + [shipping["vertex_count"] + 7],
+        "remove_special": [shipping["extra_vertices"][0]] + answer[1:],
+    }
+    replacement = None
+    planted = set(answer[1:])
