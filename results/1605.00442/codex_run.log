+        }
+        random_answer, _ = _attack_random_restart(inst, random.Random(seed ^ 0xBAD5EED))
+        candidates["random_restart_512"] = random_answer
+        t0 = time.perf_counter()
+        dpll_answer, nodes = _attack_bounded_set_cover(inst)
