+            "cross-neighborhood, vertex-list, decoder-row, and annotation reordering",
+            "arbitrary permutation of GF(2) bit coordinates",
+            "composition of all listed transformations",
+        ],
+    }
+
+    answer_blob = json.dumps(shipping["answer"])
