+    )
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    placebo_rate = (
+        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        if arms["placebo"]["attempts"]
