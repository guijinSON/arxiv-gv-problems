 total=2*n+2*k+3;labs=list(range(total));r.shuffle(labs)
 cl={i:labs[i] for i in range(n+k+1)}; si={i:labs[n+k+1+i] for i in range(n+k+2)}
 special=si[n+k+1]; rows=[]
 for i in range(n): rows.append([cl[i],[si[(i+d)%n] for d in range(-h,h+1)]+[special]])
 for t in range(k+1): rows.append([cl[n+t],[si[n+t]]])
 return {'n':n,'k':k,'token_count':k+1,'special_vertex':special,'eligible_vertices':[si[i] for i in range(n)],'cross_neighborhoods':rows,'clique':list(cl.values()),'independent_side':list(si.values())}
for seed in range(8):
