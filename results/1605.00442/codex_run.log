+        return None
+    base_rhs = table[offset]
+    key = 0
+    for i in range(bits):
+        row = offset ^ (1 << i)
+        if row not in table:
+            return None
+        if table[row] ^ base_rhs:
+            key |= 1 << i
+    return key
