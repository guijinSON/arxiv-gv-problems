+    colors = {}
+    for vertex in clique:
+        colors[vertex] = "KB" if special in cross[vertex] else "KE"
+    for vertex in side:
+        if vertex == special:
+            colors[vertex] = "SS"
+        elif vertex in candidates:
+            colors[vertex] = f"SC:{ann[vertex].bit_count()}"
+        elif vertex in extras:
+            colors[vertex] = "SE"
+        else:
+            colors[vertex] = "SO"
