+    used_masks = {int(mask) for mask, _ in decoder_rows}
+    annotations = []
+    for i in range(n):
+        desired = 0 if i in planted else 1
+        ann = _conditioned_mask(key_bits, key, desired, used_masks, rng)
+        annotations.append([side_label[i], ann])
