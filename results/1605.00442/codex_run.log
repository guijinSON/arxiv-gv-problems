+    attacks = {
+        name: {"successes": attack_successes[name], "attempts": 8}
+        for name in attack_names
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(value == 0 for value in attack_successes.values())
+        and reference_successes == 8,
+        "attacks": attacks,
