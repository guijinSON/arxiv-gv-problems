+        if replacement is not None:
+            break
+    corruptions["swap_one"] = replacement if replacement is not None else answer[:-1]
+    reasons = {name: verify(shipping, value)[1] for name, value in corruptions.items()}
+    report["G2_rejects_corruption"] = {
