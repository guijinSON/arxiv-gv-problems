+    }
+
+    attack_names = (
+        "regular_degree_overlap_outlier",
+        "greedy_maximum_coverage",
+        "random_restart_512",
+        "decoder_rhs_order_ansatz",
+        "bounded_set_cover_dpll_200000",
+    )
