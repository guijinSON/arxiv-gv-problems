+        "k": 12,
+        "degree": 12,
+        "key_bits": 96,
+        "decoder_decoys": 48,
+    },
+    "medium": {
+        "n": 144,
+        "k": 12,
+        "degree": 14,
+        "key_bits": 104,
+        "decoder_decoys": 96,
+    },
+    "hard": {
