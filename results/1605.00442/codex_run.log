+        "k": 12,
+        "degree": 16,
+        "key_bits": 112,
+        "decoder_decoys": 192,
+    },
+}
+SHIPPING_DIFFICULTY: str = "medium"
+
+CERTIFICATE_LANGUAGE: dict = {
