   603	\section{$3$-SCHGDDs of type $(n,m^t)$ for general $n$}
   604	
   605	\begin{Lemma}
   606	\label{346pbd} {\rm \cite{abg}}
   607	\begin{enumerate}
   608	\item[$(1)$] There exists a $(v,\{3,4\},1)$-PBD for any integer $v\equiv 0,1\ ({\rm mod}\ 3)$ and $v\geq 3$ with the exception of $v=6$.
   609	\item[$(2)$] There exists a $(v,\{3,4,5\},1)$-PBD for any integer $v\geq 3$ with the exception of $v=6,8$.
   610	%\item[$(3)$] There exists a $(v,\{5,9,13\},1)$-PBD for any integer $v\geq 5$ and $v\equiv 1\ ({\rm mod}\ 4)$ with the exception of $v=17,29,33$.
   611	\end{enumerate}
   612	\end{Lemma}
   613	
   614	\begin{Lemma}\label{SCHGDD-n-0-1-no 3}
   615	Let $n\equiv 0,1\ ({\rm mod}\ 3)$ and $n\geq 3$. There exists a $3$-SCHGDD of type $(n,m^t)$ for $(t-1)m\equiv 0\ ({\rm mod}\ 2)$ and $t\geq 3$ with the exception of $(1)$ $n=t=3$ and $m\equiv 0\ ({\rm mod}\ 2)$, $(2)$ $(n,m,t)=(6,1,3)$.
   616	\end{Lemma}
   617	
   618	\proof When $n=3,4,6$, the conclusion follows from Lemmas \ref{odd main results}, \ref{4-SCHGDD} and \ref{6-SCHGDD}. When $n\equiv 0,1\ ({\rm mod}\ 3)$ and $n\geq 7$, start from a $\{3,4\}$-SCGDD of type $1^n$, which is also a $(n,\{3,4\},1)$-PBD and exists by Lemma \ref{346pbd}. Take a $3$-SCHGDD of type $(k,m^t)$ for $k\in \{3,4\}$, and then apply Construction \ref{SCHGDD-recur} to obtain a $3$-SCHGDD of type $(n,m^t)$. \qed
   619	
   620	To construct $3$-SCHGDDs of type $(n,1^4)$, we introduce the concept of quasi-skew starters. Let $n$ be an odd positive integer and $G$ be an additive abelian group of order $n$. A {\it quasi-skew starter} in $G$ is a set of unordered pairs $\{\{x_i,y_i\}: 1\leq i\leq (n-1)/2\}$, which satisfies the following two properties:
   621	\begin{enumerate}
   622	\item[$(1)$]$\{x_i:1\leq i\leq (n-1)/2\}\cup\{y_i:1\leq i\leq (n-1)/2\}=Z_n\setminus\{0\}$;
   623	\item[$(2)$] $\{\pm(x_i+y_i): 1\leq i\leq (n-1)/2\}=Z_n\setminus\{0\}$.
   624	\end{enumerate}
   625	We remark that there are many kinds of combinatorial configurations named with starter, such as strong starter, skew starter, balanced starter and partitionable starter, etc, which have been used in the construction of various combinatorial designs such as Room squares, Howell designs and Howell rotation. For more details the interested reader may refer to \cite{d}. A quasi-skew starter is said to be a {\em skew starter}, if it further satisfies $\{\pm(x_i-y_i): 1\leq i\leq (n-1)/2\}=Z_n\setminus\{0\}$. That is the reason we use the term quasi-skew starter. The existence of skew starters is far more from solved (cf. \cite{cgz}).
   626	
   627	\begin{Lemma}\label{quasi-skew}
   628	There exists a quasi-skew starter in $Z_n$ for all $n\equiv 1\ ({\rm mod}\ 2)$ and $n\geq 7$.
   629	\end{Lemma}
