   826	Now combining the results of Lemmas \ref{odd main results}, \ref{nece}, \ref{SCHGDD-n-0-1-no 3}, \ref{n-1-3,m^t-0mod4}, \ref{n-3-7-12-no}-\ref{n-5,m^t-4mod12} and \ref{n-5,m^t-0mod4}, we obtain the main theorem in this paper as follows.
   827	
   828	\begin{Theorem}\label{main theorem}
   829	There exists a $3$-SCHGDD of type $(n,m^t)$ if and only if $n,t\geq 3$, $(t-1)(n-1)m\equiv 0\ ({\rm mod}\ 2)$ and $(t-1)n(n-1)m\equiv 0\ ({\rm mod}\ 6)$ except when
   830	\begin{enumerate}
   831	\item[$(1)$] $n\equiv 3,7\ ({\rm mod}\ 12)$, $m\equiv 1\ ({\rm mod}\ 2)$ and $t\equiv 2\ ({\rm mod}\ 4)$;
   832	\item[$(2)$] $n=3$, $m\equiv 1\ ({\rm mod}\ 2)$ and $t\equiv 0\ ({\rm mod}\ 2)$;
   833	\item[$(3)$] $n=t=3$ and $m\equiv 0\ ({\rm mod}\ 2)$;
   834	\item[$(4)$] $(n,m,t)\in\{(5,1,4),(6,1,3)\}$;
   835	\end{enumerate}
   836	and possibly when
   837	\begin{enumerate}
   838	\item[$(1)$] $n=8$, $m\equiv 2,10\ ({\rm mod}\ 12)$ and $t\equiv 7,10\ ({\rm mod}\ 12)$;
   839	\item[$(2)$] $t=8$, either $m\equiv 1\ ({\rm mod}\ 2)$, $n\equiv 1,3\ ({\rm mod}\ 6)$ and $n\geq 7$, or $m\equiv 3\ ({\rm mod}\ 6)$ and $n\equiv 5\ ({\rm mod}\ 6)$;
   840	\item[$(3)$] $n\equiv 1,9\ ({\rm mod}\ 12)$, $m\equiv 1\ ({\rm mod}\ 2)$ and $t\equiv 2\ ({\rm mod}\ 4)$;
   841	\item[$(4)$] $n\equiv 5\ ({\rm mod}\ 6)$, either $m\equiv 3\ ({\rm mod}\ 6)$ and $t\equiv 2\ ({\rm mod}\ 4)$, or $m\equiv 1,5\ ({\rm mod}\ 6)$ and $t\equiv 10\ ({\rm mod}\ 12)$.
   842	\end{enumerate}
   843	\end{Theorem}
