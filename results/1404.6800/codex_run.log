   699	\begin{Lemma}\label{n-1,1^4} Let $n\equiv 1\ ({\rm mod}\ 2)$ and $n\geq 7$. There exists a $3$-SCHGDD of type $(n,1^4)$.
   700	\end{Lemma}
   701	
   702	\proof We here construct a $3$-SCHGDD of type $(n,1^4)$ on $Z_n\times Z_4$ with the group set $\{\{i\}\times Z_{4}:i\in Z_n\}$ and the hole set $\{Z_n\times \{j\}: j\in Z_4\}$.
   703	The required $n(n-1)/2$ base blocks are
   704	\begin{center}
   705	$\{(i,0),(x_r+i,1),(x_r+y_r+i,2)\}$, $1\leq r\leq (n-1)/2$, $0\leq i\leq n-1$,
   706	\end{center}
   707	where $\{\{x_r,y_r\}: 1\leq r\leq (n-1)/2\}$ is a quasi-skew starter in $Z_n$. \qed
   708	
