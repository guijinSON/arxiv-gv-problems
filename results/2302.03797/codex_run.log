+import random
+
+def lr(x):
+    a=abs(x)
+    return ((a,0),(a,1)) if x>0 else ((a,1),(a,0))
+def adjs(c): return [(lr(a)[1],lr(b)[0]) for a,b in zip(c,c[1:])]
+def keyedge(e): return tuple(sorted(e))
+def simple(c):
+    ks=[keyedge(x) for x in adjs(c)]
+    return len(ks)==len(set(ks))
+def rev(c,label):
+    p=[i for i,x in enumerate(c) if abs(x)==label]
+    if len(p)!=2 or c[p[0]]!=-c[p[1]]: return None
+    i,j=p
+    return c[:i]+[-x for x in c[i:j+1][::-1]]+c[j+1:]
+def dirs(pi,tau):
+    tm={keyedge(e):e for e in adjs(tau)}
+    d=[]
+    for e in adjs(pi):
+      if keyedge(e) not in tm: return None
+      t=tm[keyedge(e)]
+      if e==t: d.append(1)
+      elif e==(t[1],t[0]): d.append(-1)
+      else: return None
+    return d
+def mns(pi,tau):
+    d=dirs(pi,tau)
+    if d is None:return 999
+    return sum(x==-1 and (i==0 or d[i-1]==1) for i,x in enumerate(d))
+def make(R,G,k,seed):
+  rng=random.Random(seed)
+  for zz in range(100):
+    body=[]
+    for x in range(1,R+1):body += [x,-x]
+    for x in range(R+1,R+G+1):body += [x if rng.randrange(2) else -x]
+    rng.shuffle(body)
+    tau=[R+G+1]+body+[-(R+G+1)]
+    if simple(tau):break
+  else: raise Exception('nosimple')
+  cur=tau[:]; used=[]; curm=0
+  for step in range(k):
+    cand=[]
+    for x in range(1,R+1):
+      if x in used:continue
+      q=rev(cur,x)
+      if q is not None and mns(q,tau)==curm+1:cand.append(x)
+    print('step',step,'m',curm,'cand',len(cand))
+    if not cand: return None
+    x=rng.choice(cand); used.append(x); cur=rev(cur,x);curm+=1
+  return cur,tau,list(reversed(used))
+def solve(pi,tau):
+  ans=[]
+  for it in range(999):
+    if pi==tau:return ans
+    d=dirs(pi,tau)
+    bd=[False]*len(pi)
+    for i in range(1,len(pi)-1):bd[i]=d[i-1]!=d[i]
+    pos={}
+    for i,x in enumerate(pi):pos.setdefault(abs(x),[]).append(i)
+    good=[]
+    for x,p in pos.items():
+      if len(p)==2 and bd[p[0]] and bd[p[1]] and pi[p[0]]==-pi[p[1]]:good.append(x)
+    if not good:
+      print('STUCK',it,mns(pi,tau),''.join('+' if x==1 else '-' for x in d)); return None
+    x=min(good); ans.append(x); pi=rev(pi,x)
+
+def compact(pi,tau):
+ d=dirs(pi,tau); b=[pi[i] for i in range(1,len(pi)-1) if d[i-1]!=d[i]]
+ ans=[]; ops=len(d)
+ while b:
+  pos={}
+  for i,x in enumerate(b):pos.setdefault(abs(x),[]).append(i)
+  good=[x for x,p in pos.items() if len(p)==2 and b[p[0]]==-b[p[1]]]
+  if not good:return None,ops,b
+  x=min(good); p=pos[x]; ops+=p[1]-p[0]+1
+  b=b[:p[0]]+[-z for z in b[p[0]:p[1]+1][::-1]]+b[p[1]+1:]
+  # endpoints remain same values and are now obsolete boundaries
+  b=b[:p[0]]+b[p[0]+1:p[1]]+b[p[1]+1:]
+  ans.append(x)
+ return ans,ops,b
+
+for seed in range(50):
+ a=make(80,12,10,seed)
+ if not a: print('FAIL MAKE',seed);continue
+ pi,tau,cert=a
+ d=dirs(pi,tau); bd=[False]*len(pi)
+ for i in range(1,len(pi)-1):bd[i]=d[i-1]!=d[i]
+ pos={}
+ for i,x in enumerate(pi):pos.setdefault(abs(x),[]).append(i)
+ good=[x for x,p in pos.items() if len(p)==2 and bd[p[0]] and bd[p[1]] and pi[p[0]]==-pi[p[1]]]
+ both=[x for x,p in pos.items() if len(p)==2 and bd[p[0]] and bd[p[1]]]
+ #print('initialgood',good,'bothbd',both,'cert',cert,'seteq',set(both)==set(cert))
+ s=solve(pi,tau)
+ c,cops,left=compact(pi,tau)
+ def okseq(q):
+  z=pi
+  for x in q:
+   z=rev(z,x)
+   if z is None:return False
+  return z==tau
+ hs={
+  'numeric':sorted(both),
+  'firstpos':sorted(both,key=lambda x:pos[x][0]),
+  'span':sorted(both,key=lambda x:pos[x][1]-pos[x][0]),
+  'reversefirst':sorted(both,key=lambda x:pos[x][0],reverse=True),
+ }
+ print(seed,cops,{k:okseq(v) for k,v in hs.items()})
