+        compact_solution, compact_stats = _compact_boundary_algorithm(inst)
+        compact_operations.append(compact_stats["operations"])
+        if compact_solution is not None:
+            compact_successes += int(verify(inst, compact_solution)[0])
+
+    for name in attacks:
