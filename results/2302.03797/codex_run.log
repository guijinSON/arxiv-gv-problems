+        "attempts": attempts,
+        "failures": failures,
+        "construction": "inverse reversal composition with a one-MNS increase certified at every step",
+    }
+
+    shipping = make_instance(seed=230203797, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = shipping["answer"]
