+ #print('initialgood',good,'bothbd',both,'cert',cert,'seteq',set(both)==set(cert))
+ s=solve(pi,tau)
+ c,cops,left=compact(pi,tau)
+ def okseq(q):
+  z=pi
+  for x in q:
+   z=rev(z,x)
+   if z is None:return False
+  return z==tau
+ hs={
+  'numeric':sorted(both),
+  'firstpos':sorted(both,key=lambda x:pos[x][0]),
+  'span':sorted(both,key=lambda x:pos[x][1]-pos[x][0]),
+  'reversefirst':sorted(both,key=lambda x:pos[x][0],reverse=True),
