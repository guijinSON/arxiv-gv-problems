+
+def _attack_sign_parity(inst):
+    labels = list(inst["repeat_ids"])
+    labels.sort(
+        key=lambda label: (
+            _orientation_product(inst["start"], label)
+            == _orientation_product(inst["target"], label),
+            _positions(inst["start"], label)[0],
+        )
+    )
+    return labels[: inst["optimum_distance"]]
