+def escalate(params):
+    harder = dict(params)
+    n = int(harder.get("n", 0))
+    if n >= 88:
+        return "cap_bound"
+    harder["n"] = min(88, n + max(8, n // 5))
+    harder["genes"] = max(int(harder.get("genes", 0)), harder["n"] // 7)
+    # Keep the answer length fixed: only the repeat haystack grows.
+    return harder
