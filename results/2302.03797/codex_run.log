+def escalate(params):
+    harder = dict(params)
+    n = int(harder.get("n", 0))
+    if n >= 45:
+        return "cap_bound"
+    harder["n"] = 45
+    harder["genes"] = int(harder.get("genes", 0))
+    # Keep the answer length fixed: only the repeat haystack grows.
+    return harder
