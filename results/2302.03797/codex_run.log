+def reverse(c, label):
+    ps=[i for i,x in enumerate(c) if abs(x)==label]
+    assert len(ps)==2 and c[ps[0]]==-c[ps[1]]
+    i,j=ps
+    return c[:i]+[-x for x in reversed(c[i:j+1])]+c[j+1:]
+
+def dirs(pi,tau):
+    tm={frozenset(e):e for e in adjs(tau)}
+    ans=[]
+    for e in adjs(pi):
+        t=tm[frozenset(e)]
+        ans.append('+' if e==t else '-')
+    return ''.join(ans)
+
+def mns(pi,tau):
+    d=dirs(pi,tau)
+    return sum(1 for i,x in enumerate(d) if x=='-' and (i==0 or d[i-1]=='+'))
+
