+def lr(x):
+    a=abs(x)
+    return ((a,'h'),(a,'t')) if x>0 else ((a,'t'),(a,'h'))
+
+def adjs(c):
+    out=[]
+    for a,b in zip(c,c[1:]):
+        out.append((lr(a)[1],lr(b)[0]))
+    return out
+
+def reverse(c, label):
+    ps=[i for i,x in enumerate(c) if abs(x)==label]
+    assert len(ps)==2 and c[ps[0]]==-c[ps[1]]
+    i,j=ps
+    return c[:i]+[-x for x in reversed(c[i:j+1])]+c[j+1:]
+
+def dirs(pi,tau):
+    tm={frozenset(e):e for e in adjs(tau)}
+    ans=[]
+    for e in adjs(pi):
+        t=tm[frozenset(e)]
+        ans.append('+' if e==t else '-')
+    return ''.join(ans)
+
+def mns(pi,tau):
+    d=dirs(pi,tau)
+    return sum(1 for i,x in enumerate(d) if x=='-' and (i==0 or d[i-1]=='+'))
+
+def show(k, order):
+    # repeat labels 1..k nested, unique genes k+1...
+    tau=[1000]
+    tau += list(range(1,k+1))
+    tau += list(range(k+1,2*k+3))
+    tau += list(range(-k,0)) # -k,..,-1 nested closing
+    tau += [-1000]
+    pi=tau
+    print('tau',tau)
+    for x in order:
+       pi=reverse(pi,x)
+       print(x,pi,dirs(pi,tau),mns(pi,tau))
+
+for o in ([1,2,3],[3,2,1],[1,3,2],[2,1,3]):
+ print('ORDER',o); show(3,o)
