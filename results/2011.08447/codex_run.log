+    def color_sort(candidates: int) -> tuple[list[int], list[int]]:
+        order: list[int] = []
+        bounds: list[int] = []
+        color = 0
+        uncolored = candidates
+        while uncolored:
+            color += 1
+            available = uncolored
+            while available:
+                bit = available & -available
+                vertex = bit.bit_length() - 1
+                order.append(vertex)
+                bounds.append(color)
+                uncolored &= ~bit
+                available &= ~bit
+                available &= ~rows[vertex]
+        return order, bounds
 
