+                )
+    report["G8_canonical_key"] = {
+        "pass": (not g8_failures and invariant_checks == 60
+                 and carried_checks == 60
+                 and len(set(unrelated_keys)) == 20),
+        "invariance_checks": invariant_checks,
+        "real_transformation_witness_checks": carried_checks,
+        "unrelated_distinct_keys": len(set(unrelated_keys)),
+        "unrelated_instances": 20,
+        "exact_canonical_branches": exact_branches,
+        "fallback_branches": 20 - exact_branches,
+        "failures": g8_failures,
