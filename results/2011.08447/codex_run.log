+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=424242, **shipping_params)
+
+    # G4/G5 density: the structure-aware prior is uniform over k-subsets.
+    guess_rng = random.Random(0xC1A0)
+    samples = 200_000
