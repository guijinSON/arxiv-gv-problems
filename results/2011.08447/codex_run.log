+    os.path.abspath(__file__)))))
+try:
+    from gvlib import exact_matrices, rationals  # noqa: F401
+except ImportError:
+    exact_matrices = rationals = None
+
+
+TRACK = "A"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "undirected graph given by exact adjacency bit rows",
+        "fixed-cardinality vertex subset",
+    ],
+    "verification_operations": [
+        "integer range and distinctness checks",
+        "exact adjacency-bit lookup for every selected vertex pair",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "search pruning",
+    "intuition_description": (
+        "Exploit the common-neighborhood signature shared by clique vertices; "
+        "without effective neighborhood-intersection pruning, a solver faces "
+        "all k-subsets of the graph."
+    ),
+    "hardness_basis": (
+        "Track A: Section 1.4 cites the Barak-et-al. sum-of-squares lower "
+        "bound for planted clique when k=o(sqrt(n)), while Theorem 2 and the "
+        "spectral/SDP results surveyed there recover only at the "
+        "Omega(sqrt(np)) scale; the shipping distribution is Definition 2 "
+        "with r=t=0, p=1/2, n=1024, k=20, and the measured centered-spectral "
+        "and 300,000-node exact clique attacks both fail on all eight panel "
+        "seeds."
