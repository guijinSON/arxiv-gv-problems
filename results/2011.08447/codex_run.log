+def _color_bound_search(
+    inst: dict, node_cap: int = 100_000
+) -> tuple[list[int] | None, int, bool]:
+    """Budgeted exact maximum-clique search with greedy-color upper bounds."""
+    rows = inst["adjacency_rows"]
+    n = inst["n"]
+    target = inst["k"]
+    nodes = 0
+    exhausted = False
