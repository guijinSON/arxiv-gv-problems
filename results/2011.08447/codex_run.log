# quick only degree+greedy restart bitset
import random,time

def gen(n,k,s):
 r=random.Random(s);S=set(r.sample(range(n),k));a=[0]*n;d=[0]*n
 for i in range(n):
  for j in range(i+1,n):
   if (i in S and j in S) or r.getrandbits(1):a[i]|=1<<j;a[j]|=1<<i;d[i]+=1;d[j]+=1
 return a,d

def ok(a,x):
 m=0
 for v in x:
  if a[v]&m"'!=m:return 0
  m|=1<<v
 return 1

def g(a,d,k,v):
 C=(1<<len(a))-1;o=[]
 while len(o)<k:
  o.append(v);C&=a[v];C&=~(1<<v)
  if len(o)==k:return 1
  if not C:return 0
  z=C;bs=(-1,-1);v=-1
  while z:
   b=z&-z;x=b.bit_length()-1;z-=b;sc=((a[x]&C).bit_count(),d[x])
   if sc>bs:bs=sc;v=x
for n,k in [(384,14),(512,14),(512,15),(512,16),(768,14),(768,16)]:
 R=[0,0,0];t=time.time()
 for s in range(8):
  a,d=gen(n,k,s);R[0]+=ok(a,sorted(range(n),key=lambda x:d[x],reverse=1)[:k]);R[1]+=g(a,d,k,max(range(n),key=lambda x:d[x]));q=random.Random(s+99);R[2]+=any(g(a,d,k,q.randrange(n)) for _ in range(256))
 print(n,k,R,round(time.time()-t,2),flush=True)
