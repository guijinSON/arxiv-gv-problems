+    "medium": {"n": 1536, "k": 22},
+    "hard": {"n": 2048, "k": 24},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+
+STRUCTURAL_HINT = (
+    "Clique vertices have adjacency rows sharing one common all-one pattern "
+    "on the clique's own columns."
+)
+PLACEBO_HINT = (
+    "The hexadecimal adjacency rows should be read carefully using the stated "
