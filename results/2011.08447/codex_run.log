import random,time,math

def gen(n,k,seed,p=.5):
 r=random.Random(seed); S=set(r.sample(range(n),k)); adj=[0]*n; deg=[0]*n
 for i in range(n):
  for j in range(i+1,n):
   e=(i in S and j in S) or r.random()<p
   if e: adj[i]|=1<<j;adj[j]|=1<<i;deg[i]+=1;deg[j]+=1
 return adj,deg,S

def ok(adj,a):
 m=0
 for x in a:
  if (adj[x]&m)"'!=m:return False
  m|=1<<x
 return True

def greedy(adj,deg,k,start):
 C=(1<<len(adj))-1;out=[];v=start
 while len(out)<k:
  out.append(v);C &= adj[v];C &= ~(1<<v)
  if len(out)>=k:return out
  if not C:return None
  best=-1;score=(-1,-1);bits=C
  while bits:
   b=bits&-bits;x=b.bit_length()-1;bits-=b
   sc=((adj[x]&C).bit_count(),deg[x])
   if sc>score:score=sc;best=x
  v=best
 return out

def spectral(adj,k,p=.5,it=35):
 n=len(adj);x=[((i*11939)%1009)/1009-.5 for i in range(n)];sm=sum(x)/n;x=[v-sm for v in x]
 for _ in range(it):
  sx=sum(x);y=[0.0]*n
  for i in range(n):
   bits=adj[i];s=0.0
   while bits:
    b=bits&-bits;j=b.bit_length()-1;bits-=b;s+=x[j]
   y[i]=s-p*(sx-x[i])
  norm=math.sqrt(sum(v*v for v in y)) or 1;x=[v/norm for v in y]
 for rev in (True,False):
  a=sorted(range(n),key=lambda i:x[i],reverse=rev)[:k]
  if ok(adj,a):return a
 return None
for n,k in [(256,14),(512,16),(768,16)]:
 print('"'case',n,k,flush=True);t=time.time();res={x:0 for x in ['deg','greedy','rr64','spectral']}
 for seed in range(4):
  adj,deg,S=gen(n,k,seed)
  res['deg']+=ok(adj,sorted(range(n),key=lambda x:deg[x],reverse=True)[:k])
  res['greedy']+=bool(greedy(adj,deg,k,max(range(n),key=lambda x:deg[x])))
  rng=random.Random(seed+999);res['rr64']+=any(greedy(adj,deg,k,rng.randrange(n)) for _ in range(64))
  res['spectral']+=bool(spectral(adj,k))
 print(res,'sec',round(time.time()-t,2),flush=True)
