 # try top and bottom abs? planted positive top
 for rev in (True,False):
  a=sorted(range(n),key=lambda i:x[i],reverse=rev)[:k]
  if ok(adj,a):return a
 return None

for n,k in [(256,12),(256,14),(512,14),(512,16),(768,16),(1024,16)]:
