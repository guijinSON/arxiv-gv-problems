+def _validate_params(n: int, k: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 8:
+        raise ValueError("n must be an integer at least 8")
+    if isinstance(k, bool) or not isinstance(k, int) or not 2 <= k < n:
+        raise ValueError("k must be an integer satisfying 2 <= k < n")
+    if k >= math.sqrt(n):
+        raise ValueError("this family requires k < sqrt(n)")
+
+
+def _default_k(n: int) -> int:
+    """Stay above the typical random-clique scale but below sqrt(n)."""
+    value = max(5, int(math.ceil(
+        2.0 * math.log2(n) - 2.0 * math.log2(max(2.0, math.log2(n))) + 3.0
+    )))
+    return min(value, int(math.isqrt(n - 1)))
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Plant a uniformly sampled k-clique in independent G(n,1/2) noise.
+
+    This is inverse generation: the answer is sampled first.  The later random
+    graph generation does not inspect, derive, or search for any clique.
+    """
+    k = params.pop("k", None)
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    if k is None:
+        k = _default_k(n)
+    _validate_params(n, k)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    answer_zero = sorted(rng.sample(range(n), k))
+    planted_mask = sum(1 << v for v in answer_zero)
+    rows = [0] * n
+
+    # Every bit belonging to a non-forced unordered pair is an independent fair
+    # Bernoulli draw.  Bits drawn for forced pairs are simply overwritten, which
+    # leaves the distribution of every non-forced bit unchanged.
+    for u in range(n - 1):
+        higher = rng.getrandbits(n - u - 1)
+        rows[u] |= higher << (u + 1)
+        bits = higher
+        while bits:
+            low = bits & -bits
+            bits -= low
+            v = u + 1 + (low.bit_length() - 1)
+            rows[v] |= 1 << u
+
+    for u in answer_zero:
+        rows[u] |= planted_mask ^ (1 << u)
+    for u in answer_zero:
+        for v in answer_zero:
+            if u != v:
+                rows[v] |= 1 << u
+
+    return {
+        "family": "semi-random planted clique, Definition 2 with r=t=0",
+        "vertex_count": n,
+        "clique_size": k,
+        "edge_probability": [1, 2],
+        "model_parameters": {"r": 0, "t": 0, "w": n - k},
+        "adjacency_rows": rows,
+        "edge_count": sum(row.bit_count() for row in rows) // 2,
+        "answer": [v + 1 for v in answer_zero],
+    }
+
+
+def _rows(inst: dict) -> list[int]:
+    rows = inst.get("adjacency_rows")
+    n = inst.get("vertex_count")
+    if (not isinstance(rows, list) or len(rows) != n
+            or any(isinstance(row, bool) or not isinstance(row, int)
+                   or row < 0 for row in rows)):
+        raise ValueError("malformed adjacency rows")
+    return rows
+
+
+def render(inst: dict) -> str:
+    """Render a complete, exact planted-clique witness problem."""
+    n = inst["vertex_count"]
+    k = inst["clique_size"]
+    rows = _rows(inst)
+    if n <= 32:
+        row_heading = (
+            "Each row below is a binary string in vertex order 1..n; character "
+            "j is 1 exactly when the row vertex is adjacent to vertex j."
+        )
+        data = "\n".join(
+            f"{i + 1}: " + "".join(
+                "1" if (rows[i] >> j) & 1 else "0" for j in range(n)
+            )
+            for i in range(n)
+        )
+        encoding = "binary_adjacency_rows"
+    else:
+        width = (n + 3) // 4
+        row_heading = (
+            "Each row below is one nonnegative hexadecimal integer. Bit b of "
+            "that integer (the coefficient of 2^b, with bit 0 the least "
+            "significant bit) is 1 exactly when the row vertex is adjacent to "
+            "vertex b+1. Leading zeroes are included to width ceil(n/4)."
+        )
+        data = "\n".join(
+            f"{i + 1}: {rows[i]:0{width}x}" for i in range(n)
+        )
+        encoding = "hexadecimal_adjacency_bit_rows"
+
+    example = list(range(1, k + 1))
+    statement = (
+        "Find a clique of the required size in the undirected simple graph "
+        "specified below.\n\n"
+        "Definitions and conventions:\n"
+        f"- The vertex labels are the integers 1 through {n}, inclusive.\n"
+        "- A clique is a set of distinct vertices in which every unordered "
+        "pair of distinct vertices is joined by an edge.\n"
+        f"- Return exactly {k} distinct labels. Their order is ignored; "
+        "repetitions are forbidden. Any clique of that size is accepted.\n"
+        "- The graph has no self-loops, so every diagonal adjacency bit is 0. "
+        "The rows are symmetric and exact; no probability or approximation is "
+        "part of the question.\n"
+        f"- {row_heading}\n\n"
+        f"vertex_count: {n}\n"
+        f"required_clique_size: {k}\n"
+        f"adjacency_encoding: {encoding}\n"
+        "adjacency_rows:\n"
+        + data
+        + "\n\nGive your final answer inside <answer></answer> tags, as a "
+        f"JSON array of exactly {k} integer labels.\n"
+        f"Example format only: <answer>{json.dumps(example)}</answer>\n"
+        "Output nothing else inside the tags."
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: object) -> object | None:
+    """Parse one tagged JSON integer array, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if len(matches) != 1:
+        return None
+    body = matches[0].strip()
+    fence = re.fullmatch(r"```(?:json|text)?\s*(.*?)\s*```", body,
+                         re.I | re.S)
+    if fence:
+        body = fence.group(1).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if (not isinstance(value, list)
+            or any(isinstance(v, bool) or not isinstance(v, int)
+                   for v in value)):
+        return None
+    return value
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Verify any size-k clique, without reading ``inst['answer']``."""
+    if (not isinstance(answer, list)
+            or any(isinstance(v, bool) or not isinstance(v, int)
+                   for v in answer)):
+        return False, "answer must be a JSON array of integer vertex labels"
+    if not answer:
+        return False, "answer is empty"
+    k = inst["clique_size"]
+    if len(answer) != k:
+        return False, f"wrong size: expected {k} labels, received {len(answer)}"
+    if len(set(answer)) != len(answer):
+        return False, "vertex labels must be distinct; a duplicate was found"
+    n = inst["vertex_count"]
+    bad = next((v for v in answer if not 1 <= v <= n), None)
+    if bad is not None:
+        return False, f"vertex label {bad} is outside the inclusive range 1..{n}"
+    try:
+        rows = _rows(inst)
+    except (TypeError, ValueError) as exc:
+        return False, f"malformed instance: {exc}"
+    for index, u_label in enumerate(answer):
+        u = u_label - 1
+        for v_label in answer[index + 1:]:
+            v = v_label - 1
+            if not ((rows[u] >> v) & 1):
+                return False, (
+                    f"missing edge between vertices {u_label} and {v_label}"
+                )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the exact statement-aware language of k-subsets."""
+    if not hasattr(rng, "sample"):
+        raise TypeError("rng must provide sample()")
+    return sorted(rng.sample(
+        range(1, inst["vertex_count"] + 1), inst["clique_size"]
+    ))
+
+
+def search_space(inst: dict) -> int | None:
+    """Return the number of k-subsets of n labelled vertices."""
+    try:
+        return math.comb(inst["vertex_count"], inst["clique_size"])
+    except (KeyError, TypeError, ValueError):
+        return None
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count all witnesses exactly when no more than two million are tested."""
+    space = search_space(inst)
+    if space is None or space > _ENUMERATION_CAP:
+        return None
+    count = 0
+    for candidate in itertools.combinations(
+            range(1, inst["vertex_count"] + 1), inst["clique_size"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def _compress(values: list[object]) -> list[int]:
+    table = {value: index for index, value in enumerate(sorted(set(values)))}
+    return [table[value] for value in values]
+
+
+def _canonical_payload(inst: dict) -> tuple[str, bool]:
+    """Canonical 1-WL payload; exact when refinement makes colors discrete."""
+    rows = _rows(inst)
+    n = inst["vertex_count"]
+    k = inst["clique_size"]
+    colors = _compress([row.bit_count() for row in rows])
+    history = []
+    for _ in range(n):
+        signatures = []
+        for v, row in enumerate(rows):
+            neighborhood_colors = []
+            bits = row
+            while bits:
+                low = bits & -bits
+                bits -= low
+                neighborhood_colors.append(colors[low.bit_length() - 1])
+            signatures.append((colors[v], tuple(sorted(neighborhood_colors))))
+        new_colors = _compress(signatures)
+        class_sizes = sorted(new_colors.count(c) for c in set(new_colors))
+        history.append(class_sizes)
+        colors = new_colors
+        if len(set(colors)) == n:
+            order = sorted(range(n), key=lambda v: colors[v])
+            upper = "".join(
+                "1" if (rows[order[i]] >> order[j]) & 1 else "0"
+                for i in range(n) for j in range(i + 1, n)
+            )
+            return json.dumps(
+                ["exact-1wl", n, k, upper], separators=(",", ":")
+            ), True
+        if len(history) >= 2 and history[-1] == history[-2]:
+            break
+
+    # This branch is invariant but not a complete graph-isomorphism canonical
+    # form.  Dense random instances almost surely take the exact branch.
+    vertex_stats = []
+    for v, row in enumerate(rows):
+        triangle_twice = 0
+        bits = row
+        while bits:
+            low = bits & -bits
+            bits -= low
+            triangle_twice += (row & rows[low.bit_length() - 1]).bit_count()
+        vertex_stats.append((colors[v], row.bit_count(), triangle_twice))
+    payload = ["invariant-1wl", n, k, history, sorted(vertex_stats)]
+    return json.dumps(payload, separators=(",", ":")), False
+
+
+def canonical_key(inst: dict) -> str:
+    """Graph-isomorphism invariant key, exact on the usual discrete branch."""
+    payload, exact = _canonical_payload(inst)
+    tag = "exact" if exact else "fallback"
+    return (
+        "semi-random-planted-clique-v1:"
+        + tag
+        + ":"
+        + hashlib.sha256(payload.encode("utf-8")).hexdigest()
+    )
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow the graph/crowding first and increase k only to retain rarity."""
+    if not isinstance(params, dict) or "n" not in params:
+        return None
+    old_n = int(params["n"])
+    old_k = int(params.get("k", _default_k(old_n)))
+    new_n = int(math.ceil(old_n * 1.5))
+    new_k = max(old_k, _default_k(new_n))
+    # At k=25 verification uses exactly 300 pair checks.  A larger k would
+    # violate G9(c), so the correct outcome after fixed-length growth is park.
+    if new_k * (new_k - 1) // 2 > 300:
+        return "cap_bound"
+    return {"n": new_n, "k": new_k}
+
+
+def _relabel_instance(inst: dict, permutation: list[int]) -> dict:
+    """Relabel old zero-based vertex v as permutation[v], carrying witness."""
+    n = inst["vertex_count"]
+    if sorted(permutation) != list(range(n)):
+        raise ValueError("permutation must contain every zero-based label once")
+    old_rows = _rows(inst)
+    new_rows = [0] * n
+    for old_u, row in enumerate(old_rows):
+        bits = row
+        while bits:
+            low = bits & -bits
+            bits -= low
+            old_v = low.bit_length() - 1
+            new_rows[permutation[old_u]] |= 1 << permutation[old_v]
+    out = dict(inst)
+    out["adjacency_rows"] = new_rows
+    out["answer"] = sorted(permutation[v - 1] + 1 for v in inst["answer"])
+    return out
+
+
+def _is_witness(inst: dict, candidate: object) -> bool:
+    return candidate is not None and verify(inst, candidate)[0]
+
+
+def _candidate_from_zero(vertices: list[int]) -> list[int]:
+    return sorted(v + 1 for v in vertices)
+
+
+def _attack_outlier(inst: dict) -> list[int] | None:
+    """Try both degree and local triangle-incidence outlier rankings."""
+    rows = _rows(inst)
+    k = inst["clique_size"]
+    degrees = [row.bit_count() for row in rows]
+    triangle_scores = []
+    for v, row in enumerate(rows):
+        score = 0
+        bits = row
+        while bits:
+            low = bits & -bits
+            bits -= low
+            score += (row & rows[low.bit_length() - 1]).bit_count()
+        triangle_scores.append(score)
+    rankings = [
+        sorted(range(len(rows)), key=lambda v: (degrees[v], -v), reverse=True),
+        sorted(range(len(rows)),
+               key=lambda v: (triangle_scores[v], degrees[v], -v),
+               reverse=True),
+    ]
+    for order in rankings:
+        candidate = _candidate_from_zero(order[:k])
+        if _is_witness(inst, candidate):
+            return candidate
+    return None
+
+
+def _greedy_completion(
+    inst: dict,
+    start: int,
+    priority: list[float] | None = None,
+    rng: random.Random | None = None,
+) -> list[int] | None:
+    rows = _rows(inst)
+    n = len(rows)
+    k = inst["clique_size"]
+    clique = [start]
+    candidates = rows[start]
+    while candidates and len(clique) < k:
+        choices = []
+        bits = candidates
+        while bits:
+            low = bits & -bits
+            bits -= low
+            v = low.bit_length() - 1
+            lookahead = (rows[v] & candidates).bit_count()
+            base = priority[v] if priority is not None else rows[v].bit_count()
+            choices.append((lookahead, base, v))
+        choices.sort(reverse=True)
+        if rng is None:
+            v = choices[0][2]
+        else:
+            pool = choices[:max(1, min(8, len(choices) // 4 or 1))]
+            v = rng.choice(pool)[2]
+        clique.append(v)
+        candidates &= rows[v]
+    if len(clique) == k:
+        answer = _candidate_from_zero(clique)
+        if _is_witness(inst, answer):
+            return answer
+    return None
+
+
+def _attack_greedy(inst: dict) -> list[int] | None:
+    rows = _rows(inst)
+    order = sorted(range(len(rows)),
+                   key=lambda v: (rows[v].bit_count(), -v), reverse=True)
+    for start in order:
+        answer = _greedy_completion(inst, start)
+        if answer is not None:
+            return answer
+    return None
+
+
+def _attack_random_restarts(
+    inst: dict, rng: random.Random, restarts: int = 256
+) -> list[int] | None:
+    rows = _rows(inst)
+    vertices = list(range(len(rows)))
+    weights = [row.bit_count() + 1 for row in rows]
+    for _ in range(restarts):
+        start = rng.choices(vertices, weights=weights, k=1)[0]
+        answer = _greedy_completion(inst, start, rng=rng)
+        if answer is not None:
+            return answer
+    return None
+
+
+def _attack_spectral(
+    inst: dict, seed: int, iterations: int = 12
+) -> tuple[list[int] | None, int]:
+    """Centered-adjacency power iteration followed by clique repair."""
+    rows = _rows(inst)
+    n = len(rows)
+    rng = random.Random(seed)
+    vector = [rng.random() - 0.5 for _ in range(n)]
+    operations = 0
+    for _ in range(iterations):
+        total = sum(vector)
+        nxt = [0.0] * n
+        for i, row in enumerate(rows):
+            edge_sum = 0.0
+            bits = row
+            while bits:
+                low = bits & -bits
+                bits -= low
+                edge_sum += vector[low.bit_length() - 1]
+                operations += 1
+            nxt[i] = edge_sum - 0.5 * (total - vector[i])
+            operations += 3
+        norm = math.sqrt(sum(value * value for value in nxt)) or 1.0
+        vector = [value / norm for value in nxt]
+        operations += 2 * n
+
+    k = inst["clique_size"]
+    for signed in (vector, [-value for value in vector]):
+        order = sorted(range(n), key=lambda v: signed[v], reverse=True)
+        direct = _candidate_from_zero(order[:k])
+        if _is_witness(inst, direct):
+            return direct, operations
+        for start in order[:min(64, n)]:
+            answer = _greedy_completion(inst, start, priority=signed)
+            if answer is not None:
+                return answer, operations
+    return None, operations
+
+
+def _color_sort(rows: list[int], candidates: int) -> tuple[list[int], list[int]]:
+    """Greedy sequential coloring used as an exact branch-and-bound upper bound."""
+    order = []
+    bounds = []
+    remaining = candidates
+    color = 0
+    while remaining:
+        color += 1
+        available = remaining
+        while available:
+            low = available & -available
+            v = low.bit_length() - 1
+            order.append(v)
+            bounds.append(color)
+            remaining &= ~low
+            available &= ~low
+            available &= ~rows[v]
+    return order, bounds
+
+
+def _attack_exact_clique(
+    inst: dict, node_limit: int = _EXACT_NODE_LIMIT
+) -> dict:
+    """Complete target-clique DPLL if uncapped; report a capped run exactly."""
+    rows = _rows(inst)
+    n = len(rows)
+    target = inst["clique_size"]
+    nodes = 0
+    hit_limit = False
+    found: list[int] | None = None
+    started = time.perf_counter()
+
+    def expand(chosen: list[int], candidates: int) -> None:
+        nonlocal nodes, hit_limit, found
+        if found is not None or hit_limit:
+            return
+        if len(chosen) == target:
+            found = list(chosen)
+            return
+        if len(chosen) + candidates.bit_count() < target:
+            return
+        order, bounds = _color_sort(rows, candidates)
+        current = candidates
+        for index in range(len(order) - 1, -1, -1):
+            if found is not None or hit_limit:
+                return
+            if len(chosen) + bounds[index] < target:
+                return
+            v = order[index]
+            bit = 1 << v
+            if not current & bit:
+                continue
+            nodes += 1
+            if nodes > node_limit:
+                hit_limit = True
+                return
+            nxt = current & rows[v]
+            if len(chosen) + 1 == target:
+                found = chosen + [v]
+                return
+            if len(chosen) + 1 + nxt.bit_count() >= target:
+                expand(chosen + [v], nxt)
+            current &= ~bit
+
+    expand([], (1 << n) - 1)
+    elapsed = time.perf_counter() - started
+    candidate = _candidate_from_zero(found) if found is not None else None
+    return {
+        "candidate": candidate,
+        "nodes": nodes,
+        "node_limit": node_limit,
+        "hit_limit": hit_limit,
+        "wall_clock_sec": elapsed,
+    }
+
+
+def _bad_outsider_replacement(inst: dict, answer: list[int]) -> list[int]:
+    inside = set(answer)
+    for outsider in range(1, inst["vertex_count"] + 1):
+        if outsider in inside:
+            continue
+        for removed in answer:
+            candidate = sorted((inside - {removed}) | {outsider})
+            ok, _ = verify(inst, candidate)
+            if not ok:
+                return candidate
+    raise AssertionError("could not construct a non-clique replacement")
+
+
+def _answer_atoms(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(v) for v in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(v) for v in value)
+    return 1
+
+
+def selftest() -> dict:
+    """Run all mandatory gates and return a JSON-serializable report."""
+    report: dict = {}
+
+    # G1: all named presets, several seeds, plus JSON round-tripping.
+    failures = []
+    checked = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 2):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            checked += 1
+            if not ok:
+                failures.append(f"{preset}/{seed}: {why}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append(f"{preset}/{seed}: answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "checked": checked,
+        "failures": failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=1729, **shipping_params)
+    planted = list(shipping["answer"])
+
+    # G2: five corruption types and five distinct diagnostics.
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_one_for_outsider": _bad_outsider_replacement(shipping, planted),
+        "duplicate": planted[:-1] + [planted[0]],
+        "empty": [],
+        "out_of_range": planted[:-1] + [shipping["vertex_count"] + 1],
+    }
+    cases = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(shipping, candidate)
+        cases[name] = {"rejected": not ok, "reason": why}
+    reasons = [case["reason"] for case in cases.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": (all(case["rejected"] for case in cases.values())
+                 and len(set(reasons)) == len(reasons)),
+        "cases": cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    # G3: model-style prose plus a fenced JSON answer inside the required tags.
+    response = (
+        "I intersected the relevant neighborhoods and checked every pair.\n\n"
+        "<answer>```json\n"
+        + json.dumps(planted)
+        + "\n```</answer>\n"
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": (parsed == planted
+                 and parse_answer("no tagged answer") is None
+                 and parse_answer("<answer>[1, nope]</answer>") is None),
+        "parsed": parsed,
+    }
+
+    # G4/G5 density: the exact free prior is a uniform k-subset.  No edge
+    # constraint is baked in because satisfying all of them is the search task.
+    guess_rng = random.Random(0x201108447)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        guess_hits += int(verify(
+            shipping, random_candidate(shipping, guess_rng)
+        )[0])
+    guess_probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "measured_probability": guess_probability,
+        "candidate_space": search_space(shipping),
+        "sampler": "uniform k-subset with exact arity/range/distinctness",
+    }
+
+    baseline_inst = make_instance(seed=100, **shipping_params)
+    baseline = _attack_exact_clique(baseline_inst)
+    demo = make_instance(seed=11, **DIFFICULTY["demo"])
+    demo_solutions = enumerate_all(demo)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": (guess_probability < 1e-6
+                 and not _is_witness(baseline_inst, baseline["candidate"])
+                 and baseline["hit_limit"]
+                 and baseline["nodes"] >= _EXACT_NODE_LIMIT
+                 and demo_solutions is not None),
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_solution_density_estimate": guess_probability,
+        "shipping_candidate_space": search_space(shipping),
+        "baseline_wall_clock_seconds": baseline["wall_clock_sec"],
+        "baseline_search_nodes": baseline["nodes"],
+        "baseline_node_budget": _EXACT_NODE_LIMIT,
+        "baseline_solved": int(_is_witness(
+            baseline_inst, baseline["candidate"]
+        )),
+        "demo_exact_solution_count": demo_solutions,
+        "demo_candidate_space": search_space(demo),
+    }
+
+    # G6: construction-aware probes, spectral recovery, and exact clique DPLL.
+    names = [
+        "outlier_degree_and_triangles",
+        "greedy_all_starts",
+        "random_restart_lookahead_256",
+        "centered_spectral_power_iteration_with_repair",
+        "exact_clique_coloring_dpll_300000_nodes",
+    ]
+    results = {name: {"successes": 0, "attempts": 0} for name in names}
+    exact_nodes = 0
+    exact_seconds = 0.0
+    spectral_operations = 0
+    per_seed = []
+    for seed in _PANEL_SEEDS:
+        inst = make_instance(seed=seed, **shipping_params)
+        spectral, operations = _attack_spectral(inst, seed ^ 0x5EED, 12)
+        exact = _attack_exact_clique(inst)
+        candidates = {
+            "outlier_degree_and_triangles": _attack_outlier(inst),
+            "greedy_all_starts": _attack_greedy(inst),
+            "random_restart_lookahead_256": _attack_random_restarts(
+                inst, random.Random(seed ^ 0xA5A5), 256
+            ),
+            "centered_spectral_power_iteration_with_repair": spectral,
+            "exact_clique_coloring_dpll_300000_nodes": exact["candidate"],
+        }
+        exact_nodes += exact["nodes"]
+        exact_seconds += exact["wall_clock_sec"]
+        spectral_operations += operations
+        seed_result = {}
+        for name, candidate in candidates.items():
+            solved = _is_witness(inst, candidate)
+            results[name]["attempts"] += 1
+            results[name]["successes"] += int(solved)
+            seed_result[name] = solved
+        per_seed.append({"seed": seed, "solved": seed_result})
+    report["G6_adversary_panel"] = {
+        "pass": all(
+            row["successes"] == 0 and row["attempts"] >= 8
+            for row in results.values()
+        ),
+        "attacks": results,
+        "standard_algorithm": {
+            "name": "exact clique DPLL with greedy-coloring upper bounds",
+            "completeness": "complete if the reported node cap is removed",
+            "complexity": "exponential worst case",
+            "aggregate_nodes": exact_nodes,
+            "aggregate_wall_clock_seconds": exact_seconds,
+        },
+        "paper_specific_relaxation_probe": {
