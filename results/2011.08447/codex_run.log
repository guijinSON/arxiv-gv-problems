def _candidate_ok(inst: dict, candidate: list[int] | None) -> bool:
    return candidate is not None and verify(inst, candidate)[0]


def _greedy_candidate(inst: dict, start: int) -> list[int] | None:
    rows = inst["adjacency_rows"]
    degrees = _degrees(rows)
    n = inst["n"]
    k = inst["k"]
    remaining = (1 << n) - 1
    chosen: list[int] = []
    vertex = start
    while len(chosen) < k:
        chosen.append(vertex)
        remaining &= rows[vertex]
        remaining &= ~(1 << vertex)
        if len(chosen) == k:
            return chosen
        if not remaining:
            return None
        bits = remaining
        best_vertex = -1
        best_score = (-1, -1)
        while bits:
            bit = bits & -bits
            v = bit.bit_length() - 1
            bits -= bit
            score = ((rows[v] & remaining).bit_count(), degrees[v])
            if score > best_score:
                best_score = score
                best_vertex = v
        vertex = best_vertex
    return chosen


