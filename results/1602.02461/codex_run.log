import random,time,statistics

def gen(k,seed,p):
 r=random.Random(seed); n=3*k; perm=list(range(n));r.shuffle(perm)
 adj=[set() for _ in range(n)]
 for i in range(k):
  T=perm[3*i:3*i+3]
  for a in range(3):
   for b in range(a+1,3): adj[T[a]].add(T[b]);adj[T[b]].add(T[a])
 for i in range(n):
  for j in range(i+1,n):
   if j not in adj[i] and r.random()<p: adj[i].add(j);adj[j].add(i)
 # force theorem regime without referencing plant: add uniformly random missing edges incident to low degree vertices
 lows=[v for v in range(n) if len(adj[v])<2*k]
 guard=0
 while lows:
  v=r.choice(lows); cand=[u for u in range(n) if u"'!=v and u not in adj[v]]
  if not cand: raise RuntimeError
  u=r.choice(cand);adj[v].add(u);adj[u].add(v)
  lows=[x for x in lows if len(adj[x])<2*k]
  guard+=1
 return adj

def greedy(adj,seed,restarts=256):
 r=random.Random(seed);n=len(adj); ops=0
 for z in range(restarts):
  remain=set(range(n));out=[]
  while remain:
   # fail-first vertex by triangle count among remaining
   best=None; opts_best=None
   for v in remain:
    N=list(adj[v]&remain);opts=[]
    for ix,u in enumerate(N):
     for w in N[ix+1:]:
      ops+=1
      if w in adj[u]: opts.append((v,u,w))
    if not opts: best=v;opts_best=[];break
    if opts_best is None or len(opts)<len(opts_best): best=v;opts_best=opts
   if not opts_best: break
   tri=r.choice(opts_best);out.append(tri);remain.difference_update(tri)
  if not remain:return out,ops,z+1
 return None,ops,restarts

for k,p in [(8,.72),(12,.72),(20,.72),(30,.72),(40,.72)]:
 succ=0;times=[];ops=[];rs=[]; mind=[]
 for seed in range(20):
  a=gen(k,seed,p);mind.append(min(map(len,a)));t=time.perf_counter();sol,o,q=greedy(a,1000+seed);times.append(time.perf_counter()-t);ops.append(o);rs.append(q);succ+=sol is not None
 print({'"'k':k,'n':3*k,'p':p,'succ':succ,'attempts':20,'min_degree':min(mind),'median_sec':statistics.median(times),'median_ops':int(statistics.median(ops)),'median_restarts':statistics.median(rs),'max_restarts':max(rs)})
