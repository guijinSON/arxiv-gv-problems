# Count adjacency probes for the paper's simple greedy on implicit G(n,1/2).
def run(n, seed):
    rng=random.Random(seed); chosen=[]; probes=0
    # Pre-sample rows in stream order exactly enough for a G(n,1/2) graph.
    for v in range(n):
        ok=True
        for u in chosen:
            probes += 1
            if rng.getrandbits(1):
