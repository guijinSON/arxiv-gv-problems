+# The five k=9 solutions mentioned (and proved exhaustive in the cited work) in
+# Section 1.  Each tuple is independently checked at import-free construction
+# time by make_instance; they are data, not results of solving a generated pool.
+_NINE_TERM_SOLUTIONS = (
+    (3, 5, 7, 9, 11, 15, 21, 231, 315),
+    (3, 5, 7, 9, 11, 15, 35, 45, 231),
+    (3, 5, 7, 9, 11, 15, 21, 135, 10395),
+    (3, 5, 7, 9, 11, 15, 33, 45, 385),
+    (3, 5, 7, 9, 11, 15, 21, 165, 693),
+)
+_CORE = (3, 5, 7, 9, 11, 15)
+_BAIT = (13, 17, 19)
+_MODULUS = 2_305_843_009_213_693_951  # 2^61-1, prime
+
+
+def _unit_sum(values: list[int] | tuple[int, ...]) -> Fraction:
+    return sum((Fraction(1, value) for value in values), Fraction(0, 1))
+
+
+def _proper_divisors(value: int) -> list[int]:
+    out = []
+    for divisor in range(1, math.isqrt(value) + 1):
+        if value % divisor:
+            continue
+        if divisor < value:
+            out.append(divisor)
+        other = value // divisor
+        if other != divisor and other < value:
+            out.append(other)
+    return sorted(out)
+
+
+def _base_multiplier_union() -> set[int]:
+    return {1, *(value for solution in _NINE_TERM_SOLUTIONS for value in solution)}
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Build a planted Lemma 2.5(a) instance without solving its subset search."""
+    if isinstance(n, bool) or not isinstance(n, int) or n < 11:
+        raise ValueError("n must be an integer at least 11")
+    exponent = int(params.get("exponent", 84))
+    decoy_bound = int(params.get("decoy_bound", max(10_001, 4 * n + 1)))
+    if exponent < 4:
+        raise ValueError("exponent must be at least 4")
+    if decoy_bound < 51:
+        raise ValueError("decoy_bound must be at least 51")
+
+    rng = random.Random(seed)
+    divisors = _proper_divisors(exponent)
+    if not divisors:
+        raise ValueError("exponent must be composite")
+    a = rng.choice(divisors)
+    q = (1 << exponent) - 1
+    d = (1 << a) - 1
+    if q % d:
+        raise AssertionError("2^a-1 must divide 2^t-1 when a divides t")
+    scale = q // d
+    anchor = q + 2 * d
+
+    solution = rng.choice(_NINE_TERM_SOLUTIONS)
+    if _unit_sum(solution) != 1:
+        raise AssertionError("bad fixed nine-term identity")
+    planted_multipliers = {1, *solution}
+
+    if n == 11:
+        multipliers = set(planted_multipliers)
+    else:
+        multipliers = set(planted_multipliers)
+        # Once there is room, expose all five valid cores.  This removes the
+        # arbitrary choice of planted core as a per-element signature.
+        union = _base_multiplier_union()
+        if n - 1 >= len(union):
+            multipliers.update(union)
+        multipliers.update(_BAIT[:max(0, min(len(_BAIT), n - 1 - len(multipliers)))])
+
+        available = [
+            value for value in range(3, decoy_bound + 1, 2)
+            if value not in multipliers
+        ]
+        rng.shuffle(available)
+        needed = (n - 1) - len(multipliers)
+        if needed > len(available):
+            raise ValueError("decoy_bound leaves too few distinct odd multipliers")
+        multipliers.update(available[:needed])
+
+    if len(multipliers) != n - 1:
+        raise AssertionError("candidate multiplier count mismatch")
+
+    inner_scale = anchor * scale
+    candidates = [anchor] + [inner_scale * value for value in multipliers]
+    if len(set(candidates)) != n or any(value <= 0 or value % 2 == 0 for value in candidates):
+        raise AssertionError("construction did not produce distinct positive odd denominators")
+    rng.shuffle(candidates)
+
+    answer = sorted([anchor] + [inner_scale * value for value in planted_multipliers])
+    instance = {
+        "target": [1, q],
+        "answer_size": 11,
+        "candidates": candidates,
+        "answer": answer,
+    }
