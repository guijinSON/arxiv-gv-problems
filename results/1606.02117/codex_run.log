+            ok, reason = verify(trial, trial["answer"])
+            planted += int(ok)
+            json_native += int(json.loads(json.dumps(trial["answer"])) == trial["answer"])
+            if not ok:
+                failures.append(f"{preset}/{seed}: {reason}")
+    report["G1_planted_verifies"] = {
