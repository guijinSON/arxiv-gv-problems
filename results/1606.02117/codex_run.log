+    if len(multipliers) != n - 1:
+        raise AssertionError("candidate multiplier count mismatch")
+
+    inner_scale = anchor * scale
+    candidates = [anchor] + [inner_scale * value for value in multipliers]
+    if len(set(candidates)) != n or any(value <= 0 or value % 2 == 0 for value in candidates):
+        raise AssertionError("construction did not produce distinct positive odd denominators")
+    rng.shuffle(candidates)
