+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Removing two nested common scales exposes a nine-term odd Egyptian-"
+        "fraction representation of one; without that normalization one faces "
+        "fixed-length exact reciprocal subset search."
