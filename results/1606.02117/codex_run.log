+    "worst_case_answer_chars": 561,
+    "worst_case_answer_tokens": 141
+  },
+  "all_passed": true,
+  "paper": "arXiv:1606.02117",
+  "shipping_difficulty": "hard",
+  "shipping_params": {
+    "decoy_bound": 10001,
+    "exponent": 84,
+    "n": 36
+  },
+  "track": "B"
+}

