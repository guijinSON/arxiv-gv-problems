+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from the exact shape/membership language stated to solvers."""
+    return sorted(rng.sample(list(inst["candidates"]), int(inst["answer_size"])))
+
+
+def search_space(inst: dict) -> int | None:
+    """Count unordered displayed subsets of the required cardinality."""
+    return math.comb(len(inst["candidates"]), int(inst["answer_size"]))
+
+
+def _public_normalization(inst: dict) -> tuple[int, int, dict[int, int]] | None:
+    """Recover the two scales using public instance data only."""
+    candidates = inst.get("candidates")
+    target = inst.get("target")
+    if not isinstance(candidates, list) or not candidates or target is None:
+        return None
+    if not all(isinstance(value, int) and value > 0 for value in candidates):
+        return None
+    if not isinstance(target, list) or len(target) != 2 or target[0] != 1:
+        return None
+    q = int(target[1])
+    anchor = 0
+    for value in candidates:
+        anchor = math.gcd(anchor, value)
+    delta = anchor - q
+    if delta <= 0 or delta % 2:
+        return None
+    d = delta // 2
+    if d <= 0 or q % d:
+        return None
+    scale = q // d
+    inner = anchor * scale
+    by_multiplier = {}
+    for value in candidates:
+        if value == anchor:
+            continue
+        if value % inner:
+            return None
+        multiplier = value // inner
+        if multiplier in by_multiplier:
+            return None
+        by_multiplier[multiplier] = value
+    return anchor, inner, by_multiplier
+
+
+def _reference_mitm(inst: dict, count_all: bool = False) -> tuple[list[int] | None, dict]:
+    """Exact fixed-nine meet-in-the-middle search after lossless normalization."""
+    normalized = _public_normalization(inst)
+    stats = {
+        "left_subsets": 0,
+        "right_subsets": 0,
+        "modular_additions": 0,
+        "exact_checks": 0,
+        "solutions": 0,
+    }
+    if normalized is None:
+        return None, stats
+    anchor, inner, by_multiplier = normalized
+    if 1 not in by_multiplier:
+        return None, stats
+    multipliers = sorted(value for value in by_multiplier if value != 1)
+    modulus = _MODULUS
+    if any(value % modulus == 0 for value in multipliers):
+        raise AssertionError("reference modulus divides a multiplier")
+    weights = [pow(value, -1, modulus) for value in multipliers]
+
+    left: dict[int, int | list[int]] = {}
+    for combo in itertools.combinations(range(len(multipliers)), 4):
+        residue = sum(weights[index] for index in combo) % modulus
+        mask = sum(1 << index for index in combo)
+        old = left.get(residue)
+        if old is None:
+            left[residue] = mask
+        elif isinstance(old, int):
+            left[residue] = [old, mask]
+        else:
+            old.append(mask)
+        stats["left_subsets"] += 1
+        stats["modular_additions"] += 4
+
+    target_residue = 1
+    found_masks: set[int] = set()
+    first_answer = None
+    for combo in itertools.combinations(range(len(multipliers)), 5):
+        residue = sum(weights[index] for index in combo) % modulus
+        stats["right_subsets"] += 1
+        stats["modular_additions"] += 5
+        matches = left.get((target_residue - residue) % modulus)
+        if matches is None:
+            continue
+        right_mask = sum(1 << index for index in combo)
+        left_masks = [matches] if isinstance(matches, int) else matches
+        for left_mask in left_masks:
+            if left_mask & right_mask:
+                continue
+            full_mask = left_mask | right_mask
+            chosen = [multipliers[index] for index in range(len(multipliers))
+                      if full_mask >> index & 1]
+            stats["exact_checks"] += 1
+            if len(chosen) != 9 or _unit_sum(chosen) != 1:
+                continue
+            found_masks.add(full_mask)
+            if first_answer is None:
+                first_answer = sorted(
+                    [anchor, by_multiplier[1]]
+                    + [by_multiplier[value] for value in chosen]
+                )
+                if not count_all:
+                    stats["solutions"] = 1
+                    return first_answer, stats
+    stats["solutions"] = len(found_masks)
+    return first_answer, stats
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count exact answers at supported sizes; refuse an unbounded brute force."""
+    if len(inst.get("candidates", [])) > 40:
+        return None
+    _, stats = _reference_mitm(inst, count_all=True)
+    return int(stats["solutions"])
+
+
+def _greedy_candidate(inst: dict) -> list[int] | None:
+    target = Fraction(*inst["target"])
+    chosen = []
+    total = Fraction(0, 1)
+    unused = set(inst["candidates"])
+    for _ in range(inst["answer_size"]):
+        fitting = [value for value in unused if total + Fraction(1, value) <= target]
+        if not fitting:
+            if not unused:
+                return None
+            pick = max(unused)
+        else:
+            pick = min(fitting)
+        chosen.append(pick)
+        unused.remove(pick)
+        total += Fraction(1, pick)
+    return sorted(chosen)
+
+
+def _normalized_greedy(inst: dict) -> list[int] | None:
+    normalized = _public_normalization(inst)
+    if normalized is None:
+        return None
+    anchor, _, by_multiplier = normalized
+    if 1 not in by_multiplier:
+        return None
+    chosen = [anchor, by_multiplier[1]]
+    remaining = Fraction(1, 1)
+    unused = set(by_multiplier) - {1}
+    for _ in range(9):
+        fitting = [value for value in unused if Fraction(1, value) <= remaining]
+        if not fitting:
+            return sorted(chosen)
+        pick = min(fitting)
+        chosen.append(by_multiplier[pick])
+        remaining -= Fraction(1, pick)
+        unused.remove(pick)
+    return sorted(chosen)
+
+
+def _core_ansatz(inst: dict) -> list[int] | None:
+    normalized = _public_normalization(inst)
+    if normalized is None:
+        return None
+    anchor, _, by_multiplier = normalized
+    required = {1, *_CORE}
+    if not required.issubset(by_multiplier):
+        return None
+    remaining = sorted(set(by_multiplier) - required)[:3]
+    if len(remaining) != 3:
+        return None
+    multipliers = sorted(required | set(remaining))
+    return sorted([anchor] + [by_multiplier[value] for value in multipliers])
+
+
+def _attack_candidates(inst: dict, seed: int) -> dict[str, list[object]]:
+    candidates = list(inst["candidates"])
+    outlier = sorted(sorted(candidates)[:inst["answer_size"]])
+    rng = random.Random(seed ^ 0x160602117)
+    restarts = [random_candidate(inst, rng) for _ in range(256)]
+    return {
+        "outlier_smallest_magnitude": [outlier],
+        "greedy_exact_reciprocals": [_greedy_candidate(inst)],
+        "normalized_odd_greedy": [_normalized_greedy(inst)],
+        "common_core_smallest_tail": [_core_ansatz(inst)],
+        "random_restart_256": restarts,
+    }
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonicalize input order and simultaneous scaling via target-normalized weights."""
+    numerator, q = inst["target"]
+    normalized = []
+    for denominator in inst["candidates"]:
+        value = Fraction(numerator * q, denominator) if False else Fraction(q, denominator)
+        normalized.append([value.numerator, value.denominator])
+    payload = {
+        "family": "odd_egyptian_reciprocal_subset",
+        "answer_size": int(inst["answer_size"]),
+        "normalized_reciprocal_weights": sorted(normalized),
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow only the candidate haystack; the eleven-denominator witness stays fixed."""
+    harder = dict(params)
+    harder["n"] = int(params.get("n", 11)) + 4
+    needed_bound = 2 * harder["n"] + 51
+    if int(harder.get("decoy_bound", 0)) < needed_bound:
+        harder["decoy_bound"] = needed_bound | 1
+    return harder
+
+
+def _scaled_instance(inst: dict, factor: int) -> dict:
+    clone = json.loads(json.dumps(inst))
+    clone["target"][1] *= factor
+    clone["candidates"] = [factor * value for value in clone["candidates"]]
+    clone["answer"] = [factor * value for value in clone["answer"]]
+    return clone
+
+
+def _answer_size_bounds(params: dict) -> tuple[int, int, int]:
+    exponent = int(params["exponent"])
+    q = (1 << exponent) - 1
+    worst = []
+    for a in _proper_divisors(exponent):
+        d = (1 << a) - 1
+        scale = q // d
+        anchor = q + 2 * d
+        inner = anchor * scale
+        for solution in _NINE_TERM_SOLUTIONS:
+            answer = sorted([anchor, inner] + [inner * value for value in solution])
+            compact = json.dumps(answer, separators=(",", ":"))
+            worst.append((len(compact), math.ceil(len(compact) / 4), len(answer)))
+    return max(worst)
+
