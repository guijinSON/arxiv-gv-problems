+    "medium": {"n": 30, "exponent": 84, "decoy_bound": 10_001},
+    "hard": {"n": 36, "exponent": 84, "decoy_bound": 10_001},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The denominator multiset has two nested common scales, and at the inner "
