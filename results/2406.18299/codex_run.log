+
+    guess_inst = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    guess_rng = random.Random(271828)
+    samples = 200_000
+    hits = 0
+    fast_cross_checks = 0
+    for sample_index in range(samples):
