  \begin{claim}\label{claim:stable-or-delete}
    Fix $s \in V$. Then for every vertex $v \in V \setminus \{s\}$
    there is either a stable $v$-witness walk (relative to~$s$) or $v$
    has to be deleted in order to satisfy~$\phi$ when the
    existential quantifier is instantiated with the fixed~$s$.  
  \end{claim}

  \begin{proof}
%%     First, observe that if there is a stable $v$-witness walk
%%     $(v_1,\dots,v_j)$ (so $v=v_1$), then we never have to delete any vertex on this
%%     walk (formally, if there  is a set $D \subseteq V \setminus \{s\}$
%%     with $G \setminus D \models \phi$, then we also have $(G \setminus
