+        pairs = []
+        for u, row in zip(inst["left"], inst["rows"]):
+            options = [v for v in row if v not in used]
+            if not options:
+                break
+            v = rng.choice(options)
+            used.add(v)
+            pairs.append((u, v))
+        if len(pairs) == inst["p"]:
