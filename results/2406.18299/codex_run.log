    swapped[0], swapped[1] = swapped[1], swapped[0]
    out_of_range = base["answer"][:]
    parsed_last = _parse_label(out_of_range[-1])
    out_of_range[-1] = _label(parsed_last[0], parsed_last[1], 2 * base["p"])
    corruptions = {
