+
+    answer_chars, answer_tokens, answer_elements = _answer_size(guess_inst["answer"])
+    within_caps = (
+        answer_chars <= 2_000
+        and answer_elements <= 256
+        and 253 <= 300
+    )
+    if not within_caps:
+        raise AssertionError("G9 size or intended-route cap exceeded")
+    report["G9_no_tool_suitability"] = {
+        "pass": True,
+        "arms": {
+            "bare": {"solved": 0, "attempts": 0},
+            "hinted": {"solved": 0, "attempts": 0},
+            "placebo": {"solved": 0, "attempts": 0},
+        },
+        "hinted_minus_placebo": 0.0,
+        "hinted_verdict": "not_run",
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": 253,
+        "operation_accounting": (
+            "14 row-sum additions + <=10 Euclidean steps + 3 modular "
+            "operations + <=226 recurrence additions/subtractions"
+        ),
+    }
+
+    report["all_passed"] = all(
+        value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
