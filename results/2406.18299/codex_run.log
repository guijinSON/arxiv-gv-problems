_cats = set()
try:
    for _line in open("papers/papers.jsonl"):
        _r = json.loads(_line)
        if _r.get("arxiv_id") == _pid:
            _cats = set(_r.get("all_cats", "").split()); break
except OSError:
    pass
_paper_is_non_discrete = bool(_cats & NON_DISCRETE_CATS)

