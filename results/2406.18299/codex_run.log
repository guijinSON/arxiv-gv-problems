+    incident = [[] for _ in range(inst["universe_size"])]
+    for u, v in sorted(_edge_set(inst)):
+        a, b = ("a", u, v), ("b", u, v)
+        c, d = ("c", u, v), ("d", u, v)
+        add_edge(a, b)
+        add_edge(b, c)
+        add_edge(c, d)
+        add_edge(d, a)
+        incident[u].append((a, b))
+        incident[v].append((a, b))
