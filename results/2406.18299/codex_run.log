+def escalate(params: dict) -> dict | str | None:
+    """Increase shore size first, then crowding at fixed answer length."""
+    if "n" not in params:
+        return None
+    out = {key: value for key, value in params.items() if not key.startswith("_")}
+    n = int(out["n"])
+    degree = int(out.get("degree", 8))
+    if _next_prime(n) < 127:
+        out["n"] = 127
+        return out
+    if degree < 12:
+        out["degree"] = min(12, degree + 2)
+        return out
+    return "cap_bound"
