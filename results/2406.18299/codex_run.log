+
+def _parse_label(value: object):
+    if not isinstance(value, str):
+        return None
+    if len(value) < 5 or value[0] not in "ab" or value[1] != ":":
+        return None
+    parts = value.split(":")
+    if len(parts) != 3 or not parts[1].isdigit() or not parts[2].isdigit():
