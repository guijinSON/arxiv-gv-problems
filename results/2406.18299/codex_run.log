+"""Scratch wrapper: shipping preset only, for the structural-hint arm."""
+import importlib.util
+import os
+
+_source = os.path.join(os.path.dirname(os.path.dirname(__file__)), "gen_2406_18299.py")
+_spec = importlib.util.spec_from_file_location("_main_generator", _source)
+_main = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_main)
+for _name in dir(_main):
+    if not _name.startswith("__"):
+        globals()[_name] = getattr(_main, _name)
+DIFFICULTY = {"hard": dict(_main.DIFFICULTY[_main.SHIPPING_DIFFICULTY])}
+SHIPPING_DIFFICULTY = "hard"
