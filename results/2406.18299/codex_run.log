+def _attack_outlier_degree(inst: dict):
+    degrees = [0] * inst["universe_size"]
+    for u, row in zip(inst["left"], inst["rows"]):
+        degrees[u] += len(row)
+        for v in row:
+            degrees[v] += 1
+    pairs = []
+    for u, row in zip(inst["left"], inst["rows"]):
+        pairs.append((u, min(row, key=lambda v: (degrees[v], v))))
+    return _matching_candidate(inst, pairs)
