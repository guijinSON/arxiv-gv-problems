+def _is_prime(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    limit = math.isqrt(value)
+    divisor = 3
+    while divisor <= limit:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(value: int) -> int:
+    candidate = max(2, value)
+    if candidate > 2 and candidate % 2 == 0:
+        candidate += 1
+    while not _is_prime(candidate):
+        candidate += 1 if candidate == 2 else 2
+    return candidate
