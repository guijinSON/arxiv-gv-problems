+        "fixed first-order sentence with quantifier pattern aea",
+        "vertex-deletion set",
+    ],
+    "verification_operations": [
+        "exact parsing of graph-vertex labels",
+        "set-gadget incidence lookup",
+        "exact universe coverage and disjointness",
+    ],
