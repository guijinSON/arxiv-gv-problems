+_ANSWER_RE = re.compile(r"<answer>\s*(.*?)\s*</answer>", re.I | re.S)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    if payload.startswith("```"):
+        payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
+        payload = re.sub(r"\s*```$", "", payload)
+    try:
+        answer = json.loads(payload)
+    except (TypeError, ValueError):
+        return None
+    return answer if isinstance(answer, list) else None
+
+
+def _validate_polynomial(inst, answer):
+    if not isinstance(answer, list):
+        return None, "answer_not_a_list"
+    if not answer:
+        return None, "empty_polynomial"
+    exponents = []
+    for term in answer:
+        if (not isinstance(term, list) or len(term) != 2
+                or not isinstance(term[0], int) or isinstance(term[0], bool)
+                or not isinstance(term[1], list) or len(term[1]) != 2
+                or any(not isinstance(e, int) or isinstance(e, bool)
+                       for e in term[1])):
+            return None, "malformed_term"
+        exponents.append(tuple(term[1]))
+    if len(set(exponents)) != len(exponents):
+        return None, "duplicate_monomial"
+    if len(answer) < 2:
+        return None, "missing_term"
+    if len(answer) > 2:
+        return None, "wrong_term_count"
+    if exponents != [(1, 0), (0, 1)]:
+        return None, "noncanonical_term_order"
+    a, b = answer[0][0], answer[1][0]
+    p = inst["p"]
+    if not (0 <= a < p and 0 <= b < p):
+        return None, "coefficient_out_of_range"
+    if a == 0 and b == 0:
+        return None, "zero_polynomial"
+    if (a != 0 and a != 1) or (a == 0 and b != 1):
+        return None, "nonprojective_normal_form"
+    return (a, b), "ok"
+
+
+def verify(inst, answer):
+    direction, reason = _validate_polynomial(inst, answer)
+    if direction is None:
+        return False, reason
+    a, b = direction
+    p = inst["p"]
+    colors = [(a * x + b * y) % p for x, y in inst["points"]]
+    used = len(set(colors))
+    if used != inst["q"]:
+        return False, f"wrong_color_count:{used}"
+    for edge in inst["edges"]:
+        count = len({colors[edge[0]], colors[edge[1]], colors[edge[2]]})
+        if count == 1:
+            return False, "monochromatic_bi_edge"
+        if count == 3:
+            return False, "rainbow_bi_edge"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    index = rng.randrange(inst["p"] + 1)
+    direction = (0, 1) if index == inst["p"] else (1, index)
+    return _poly(direction)
