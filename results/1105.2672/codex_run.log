+def _normalise_direction(a, b, p):
+    """Canonical point [a:b] of the projective line over GF(p)."""
+    a %= p
+    b %= p
+    if a:
+        inv = pow(a, -1, p)
+        return (1, (b * inv) % p)
+    if b:
+        return (0, 1)
+    return None
