+
+def search_space(inst):
+    return inst["p"] + 1
+
+
+def enumerate_all(inst):
+    if search_space(inst) > 20_000:
+        return None
+    count = 0
+    for index in range(inst["p"] + 1):
+        direction = (0, 1) if index == inst["p"] else (1, index)
+        if verify(inst, _poly(direction))[0]:
+            count += 1
+    return count
