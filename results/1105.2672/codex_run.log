+def _attack_greedy_raw_axis(inst):
+    candidates = [(1, 0), (0, 1)]
+    # Greedily choose the displayed axis whose values come closest to q colors.
+    direction = min(
+        candidates,
+        key=lambda d: abs(len({(d[0] * x + d[1] * y) % inst["p"]
+                               for x, y in inst["points"]}) - inst["q"]),
+    )
+    return _poly(direction)
