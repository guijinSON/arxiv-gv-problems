+    "easy": {"n": 19, "modulus_floor": 10_007, "edge_budget": 400},
+    "medium": {"n": 43, "modulus_floor": 1_000_003, "edge_budget": 1_500},
+    "hard": {"n": 79, "modulus_floor": 1_000_000_007, "edge_budget": 5_000},
+}
