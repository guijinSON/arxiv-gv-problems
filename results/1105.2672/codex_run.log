+            "invertible affine coordinate relabeling with carried polynomial",
+            "composition of both transformations",
+        ],
+    }
+
+    answer_blob = json.dumps(shipping["answer"], separators=(",", ":"))
+    arms = {
+        name: dict(G9_DIAGNOSTIC[name])
+        for name in ("bare", "hinted", "placebo")
