   829	def _run_adversary_panel(params: dict) -> dict:
   830	    names = (
   831	        "outlier_tag_degree",
   832	        "greedy_single_sweep",
   833	        "random_restart_256",
   834	        "rhs_majority_ansatz",
   835	        "all_zero_baseline_ansatz",
   836	    )
   837	    results = {
   838	        name: {"successes": 0, "attempts": 0, "operations": 0, "wall_clock_sec": 0.0}
   839	        for name in names
   840	    }
   841	    reference_successes = 0
   842	    reference_operations = 0
   843	    reference_wall = 0.0
   844	    reference_ranks = []
   845	    dpll_successes = 0
   846	    dpll_clause_scans = 0
   847	    dpll_literal_checks = 0
   848	    dpll_nodes = 0
   849	    dpll_wall = 0.0
   850	    for attack_seed in _ATTACK_SEEDS:
   851	        inst = make_instance(seed=attack_seed, **params)
   852	        attacks = {
   853	            "outlier_tag_degree": lambda: _attack_outlier_tag_degree(inst),
   854	            "greedy_single_sweep": lambda: _attack_greedy_single_sweep(inst),
   855	            "random_restart_256": lambda: _attack_random_restart(inst, attack_seed ^ 0x5A5A),
   856	            "rhs_majority_ansatz": lambda: _attack_rhs_majority(inst),
   857	            "all_zero_baseline_ansatz": lambda: _attack_all_zero_baseline(inst),
   858	        }
   859	        for name, attack in attacks.items():
   860	            started = time.perf_counter()
   861	            candidate, operations = attack()
   862	            elapsed = time.perf_counter() - started
   863	            results[name]["attempts"] += 1
   864	            results[name]["operations"] += operations
   865	            results[name]["wall_clock_sec"] += elapsed
   866	            if candidate is not None and verify(inst, candidate)[0]:
   867	                results[name]["successes"] += 1
   868	
   869	        reference, metrics = _reference_gaussian(inst)
   870	        reference_successes += int(reference is not None and verify(inst, reference)[0])
   871	        reference_operations += metrics["bit_operations"]
   872	        reference_wall += metrics["wall_clock_sec"]
   873	        reference_ranks.append(metrics["rank"])
   874	
   875	        dpll_answer, dpll_metrics = _reference_dpll(inst)
   876	        dpll_successes += int(dpll_answer is not None and verify(inst, dpll_answer)[0])
   877	        dpll_clause_scans += dpll_metrics["clause_scans"]
   878	        dpll_literal_checks += dpll_metrics["literal_checks"]
   879	        dpll_nodes += dpll_metrics["nodes"]
   880	        dpll_wall += dpll_metrics["wall_clock_sec"]
   881	
   882	    for value in results.values():
   883	        value["wall_clock_sec"] = round(value["wall_clock_sec"], 6)
   884	    all_failed = all(value["successes"] == 0 for value in results.values())
   885	    return {
   886	        "pass": (
   887	            all_failed
   888	            and reference_successes == len(_ATTACK_SEEDS)
   889	            and dpll_successes == len(_ATTACK_SEEDS)
   890	        ),
   891	        "attacks": results,
   892	        "reference_algorithm": {
   893	            "name": "DPLL with unit propagation (domain-standard SAT baseline)",
   894	            "complexity": (
   895	                "O(2^n*C) clause work in the worst case; the promised XOR "
   896	                "subfamily also admits polynomial GF(2) elimination"
   897	            ),
   898	            "wall_clock_sec": round(dpll_wall, 6),
   899	            "average_wall_clock_sec": round(dpll_wall / len(_ATTACK_SEEDS), 6),
   900	            "operations": dpll_clause_scans,
   901	            "operation_unit": "clause scans",
   902	            "average_operations": dpll_clause_scans // len(_ATTACK_SEEDS),
   903	            "literal_checks": dpll_literal_checks,
   904	            "nodes": dpll_nodes,
   905	            "solves": f"{dpll_successes}/{len(_ATTACK_SEEDS)}, as expected",
   906	            "promised_polynomial_algorithm": {
   907	                "name": "four-tree XOR recognition plus GF(2) Gaussian elimination",
   908	                "complexity": "O(e*n^2) elementary bit operations; polynomial",
   909	                "wall_clock_sec": round(reference_wall, 6),
   910	                "average_wall_clock_sec": round(
   911	                    reference_wall / len(_ATTACK_SEEDS), 6
   912	                ),
   913	                "operations": reference_operations,
   914	                "average_operations": reference_operations // len(_ATTACK_SEEDS),
   915	                "operation_unit": "scalar bit operations",
   916	                "ranks": reference_ranks,
   917	                "solves": f"{reference_successes}/{len(_ATTACK_SEEDS)}, as expected",
   918	            },
   919	        },
   920	    }
