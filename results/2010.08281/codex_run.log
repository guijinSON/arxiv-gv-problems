+"""Verified problem generator for arXiv:2010.08281.
+
+The family is the paper's L0-bounded suspected-path extraction problem, using
+the exact decision-tree ensemble in the proof of Theorem 1.  A Boolean
+polynomial is sampled first.  Its values on nonzero points of F_2^d form the
+adversarial input, and affine-cocycle identities are compiled into 3-XOR
+gadgets, four clause trees per gadget.  The planted polynomial is therefore
+known by construction; make_instance never solves its output.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "The parity gadgets are affine-cocycle evaluations of one quadratic Boolean polynomial on the displayed coordinate space."
+)
+PLACEBO_HINT: str = (
+    "The parity gadgets use consistent feature names and exact binary conventions throughout the displayed coordinate space."
+)
+
+# Filled from the separately owned harden.py transcripts after the three runs.
+G9_ARM_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+}
+G9_HINTED_VERDICT = "unmeasured"
+
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "logic",
+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "polynomial",
+    "native_objects": [
+        "Boolean-feature decision-tree ensemble",
+        "suspected target joint paths",
+        "quadratic Boolean polynomial describing an adversarial input",
+    ],
+    "verification_operations": [
+        "GF(2) polynomial evaluation",
+        "exact decision-tree clause evaluation",
+        "integer majority-vote comparison",
+        "exact L0-distance comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The four clause trees on each triple encode an affine cocycle whose "
+        "basis evaluations reveal a sparse quadratic polynomial; without that "
+        "invariant, the solver faces the full tree-ensemble satisfiability system."
+    ),
+    "hardness_basis": (
+        "Track B: Section 6 and Theorem 1 use SMT for the NP-complete general "
+        "extraction problem, while this promised parity-gadget distribution is "
+        "solved by gadget recovery and GF(2) RREF in O(EV^2) bit operations; "
+        "the measured shipping cost is patched from selftest below, whereas the "
+        "cocycle route uses at most 70 exact XOR operations once recognized."
+    ),
+    "max_answer_tokens": 120,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+# n is the coordinate dimension.  There are 2^n-1 Boolean input features.
+# The planted support is held at eight terms on the three evaluated rungs, so
+# escalation grows the ambient haystack while keeping the symbolic witness short.
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "terms": 2},
+    "easy": {"n": 5, "terms": 8},
+    "medium": {"n": 6, "terms": 8},
+    "hard": {"n": 7, "terms": 8},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A canonical algebraic-normal-form polynomial over GF(2) with exactly "
+        "the stated number of distinct nonconstant squarefree monomials, each "
+        "of degree one or two, in the displayed coordinate variables.  A term "
+        "is JSON [1,[e1,...,ed]] with every exponent in {0,1}."
+    ),
+    "bounds": {
+        "coefficient_field": 2,
+        "min_degree": 1,
+        "max_degree": 2,
+        "squarefree": True,
+        "term_count": "instance.terms",
+        "variables": "instance.dimension",
+    },
+}
+
+
+NOTES: str = """
+Section 2.1 fixes a path as a conjunction of exact feature tests and Section
+2.2 fixes majority voting for an ensemble.  Section 6, Eq. (12), fixes the
+native witness: an x' within an L0 budget of a training input that traverses a
+suspected target joint path.  Theorem 1 proves this problem NP-complete by
+turning each 3-SAT clause into a decision tree and adding n-1 constant-False
+trees, so a target majority occurs exactly when every clause tree returns True.
+The generator uses that construction verbatim, with x=0 and the theorem's
+full-feature L0 budget.
+
+The discriminating Step-0 answer is therefore: the paper's general certificate
+is produced by an SMT solver (Section 6), and the exact path disjunction may be
+exponential in the ensemble size.  This particular promised distribution has
+an additional polynomial algorithm: group each four-clause parity gadget and
+run GF(2) Gaussian elimination.  It is Track B, never a Track-A claim.  The
+shorter route notices that the right sides are evaluations of the polarization
+of one quadratic Boolean polynomial.  Basis-pair gadgets give every quadratic
+coefficient, and seven closing gadgets give the linear coefficients.
+
+What is easy is also explicit in the paper: embedding is PTIME (Algorithms 1
+and 2), exact extraction is delegated to SMT, and Section 6.2 proposes model-
+loss and activation-pattern outlier detection only as a non-exact prefilter
+that can produce false alarms.  The generated feature order and gadget order
+are shuffled.  The correlation outlier, greedy single-swap, random-restart,
+and naive closing-sign ansatz attacks are measured in selftest.  The successful
+GF(2) reference algorithm is reported separately, as Track B requires.
+""".strip()
+
+
+def _bitstring(x: int, d: int) -> str:
+    return format(x, f"0{d}b")
+
+
+def _monomial_masks(d: int) -> list[int]:
+    """Degree-one and degree-two squarefree monomials, exponent-lex order."""
+    masks = [1 << i for i in range(d)]
+    masks.extend((1 << i) | (1 << j) for i in range(d) for j in range(i + 1, d))
+    return sorted(masks, key=lambda m: _mask_to_exponents(m, d))
+
+
+def _mask_to_exponents(mask: int, d: int) -> list[int]:
+    # Coordinate variable z_1 is the leftmost displayed bit, hence bit d-1.
+    return [int(bool(mask & (1 << (d - 1 - i)))) for i in range(d)]
+
+
+def _exponents_to_mask(exponents: list[int]) -> int:
+    d = len(exponents)
+    mask = 0
+    for i, exponent in enumerate(exponents):
+        if exponent:
+            mask |= 1 << (d - 1 - i)
+    return mask
+
+
+def _poly_from_masks(masks: list[int], d: int) -> list[list[object]]:
+    exps = sorted((_mask_to_exponents(mask, d) for mask in masks))
+    return [[1, exponent] for exponent in exps]
+
+
+def _poly_masks(answer: object, d: int, terms: int) -> tuple[list[int] | None, str]:
+    if not isinstance(answer, list):
+        return None, "answer must be a JSON list"
+    if not answer:
+        return None, "answer list is empty"
+    if len(answer) != terms:
+        return None, f"wrong term count: expected {terms}"
+    exponents: list[list[int]] = []
+    for term in answer:
+        if not isinstance(term, list) or len(term) != 2 or term[0] != 1:
+            return None, "each term must have coefficient 1 and one exponent list"
+        exp = term[1]
+        if not isinstance(exp, list) or len(exp) != d:
+            return None, f"each exponent list must have length {d}"
+        if any(type(value) is not int or value not in (0, 1) for value in exp):
+            return None, "every exponent must be the integer 0 or 1"
+        if sum(exp) not in (1, 2):
+            return None, "every monomial must have degree one or two"
+        exponents.append(exp)
+    packed = [tuple(exp) for exp in exponents]
+    if len(set(packed)) != len(packed):
+        return None, "duplicate monomial"
+    if packed != sorted(packed):
+        return None, "terms are not in canonical exponent order"
+    return [_exponents_to_mask(exp) for exp in exponents], "ok"
+
+
+def _eval_masks(masks: list[int], point: int) -> int:
+    value = 0
+    for mask in masks:
+        value ^= int((point & mask) == mask)
+    return value
+
+
+def _canonical_gadget(a: int, b: int, c: int, rhs: int) -> tuple[int, int, int, int]:
+    x, y, z = sorted((a, b, c))
+    return x, y, z, rhs
+
+
+def _cocycle_gadgets(d: int, masks: list[int]) -> list[tuple[int, int, int, int]]:
+    """A theorem-backed full-rank family of affine-cocycle equations.
+
+    All nonzero hypercube edges enforce y(v+e_i)=y(v)+y(e_i) for the
+    difference y between any solution and the plant, so y is linear.  The d
+    closing triples have XOR-syndromes e_i and kill that linear kernel.
+    """
+    gadgets: set[tuple[int, int, int, int]] = set()
+    limit = 1 << d
+    for i in range(d):
+        basis = 1 << i
+        for v in range(1, limit):
+            w = v ^ basis
+            if not w or v == basis:
+                continue
+            a, b, c = basis, v, w
+            rhs = _eval_masks(masks, a) ^ _eval_masks(masks, b) ^ _eval_masks(masks, c)
+            gadgets.add(_canonical_gadget(a, b, c, rhs))
+
+    # For each i use two other basis vectors and their three-bit sum.  The XOR
+    # of the three feature coordinates is e_i, independently for every i.
+    for i in range(d):
+        j = (i + 1) % d
+        k = (i + 2) % d
+        a, b = 1 << j, 1 << k
+        c = (1 << i) | (1 << j) | (1 << k)
+        rhs = _eval_masks(masks, a) ^ _eval_masks(masks, b) ^ _eval_masks(masks, c)
+        gadgets.add(_canonical_gadget(a, b, c, rhs))
+    return sorted(gadgets)
+
+
+def make_instance(n: int, seed: int = 0, **params: object) -> dict:
+    """Inverse-generate a native suspected-path extraction instance."""
+    d = int(n)
+    terms = int(params.get("terms", 8))
+    if d < 3:
+        raise ValueError("n must be at least 3")
+    universe = _monomial_masks(d)
+    if not 1 <= terms <= len(universe):
+        raise ValueError("terms must fit the degree-one/two monomial basis")
+    rng = random.Random(seed)
+    support = rng.sample(universe, terms)
+    answer = _poly_from_masks(support, d)
+    masks, reason = _poly_masks(answer, d, terms)
+    if masks is None:
+        raise AssertionError(reason)
+
+    gadgets = _cocycle_gadgets(d, masks)
+    rng.shuffle(gadgets)
+    gadget_records = [
+        {"features": [_bitstring(v, d) for v in (a, b, c)], "parity": rhs}
+        for a, b, c, rhs in gadgets
+    ]
+    features = [_bitstring(v, d) for v in range(1, 1 << d)]
+    rng.shuffle(features)
+    clause_trees = 4 * len(gadget_records)
+    return {
+        "paper": "arXiv:2010.08281",
+        "dimension": d,
+        "terms": terms,
+        "features": features,
+        "original_input": "all-zero",
+        "l0_bound": len(features),
+        "gadgets": gadget_records,
+        "clause_trees": clause_trees,
+        "constant_other_trees": clause_trees - 1,
+        "target_label": "TARGET",
+        "other_label": "OTHER",
+        "answer": answer,
+    }
+
+
+def _gadget_clause_text(names: list[str], rhs: int) -> str:
+    return f"XOR({names[0]},{names[1]},{names[2]})={rhs}"
+
+
+def render(inst: dict) -> str:
+    d = inst["dimension"]
+    lines = [
+        "L0-bounded suspected-path extraction in a Boolean tree ensemble",
+        "",
+        "Every input feature is Boolean (0 or 1). Its name is a nonzero binary",
+        f"coordinate in F_2^{d}; the leftmost bit is coordinate variable z_1.",
+        "The original training input assigns 0 to every feature. The L0 distance",
+        "is the number of feature values that differ from that all-zero input.",
+        "",
+        "A clause tree tests up to three named features and returns TARGET exactly",
+        "when their listed disjunctive clause is true; otherwise it returns OTHER.",
+        "For compactness, a gadget XOR(a,b,c)=r below denotes the four clause trees",
+        "that reject exactly the four assignments with a XOR b XOR c != r.",
+        "Thus all four trees return TARGET exactly when a XOR b XOR c = r.",
+        f"There are {inst['clause_trees']} such clause trees and",
+        f"{inst['constant_other_trees']} additional trees that always return OTHER.",
+        "The ensemble label is the strict majority label. Consequently it returns",
+        "TARGET exactly when every listed parity gadget is satisfied (there is no tie).",
+        "",
+        "You must give an algebraic-normal-form polynomial q over GF(2). It must",
+        f"contain exactly {inst['terms']} distinct nonconstant squarefree monomials,",
+        "each of degree 1 or 2, with coefficient 1. It describes the candidate",
+        "adversarial input by assigning feature v the bit q(v). The terms must be",
+        "sorted lexicographically by their exponent lists. Your polynomial is valid",
+        f"iff that input has L0 distance at most {inst['l0_bound']} and the ensemble",
+        "returns TARGET. All XORs and polynomial sums are modulo 2.",
+        "",
+        "Feature declaration order (the names themselves are the coordinates):",
+        " ".join(inst["features"]),
+        "",
+        "Parity-gadget tree blocks:",
+    ]
+    for index, gadget in enumerate(inst["gadgets"], 1):
+        lines.append(
+            f"{index}: " + _gadget_clause_text(gadget["features"], gadget["parity"])
+        )
+    example_exp1 = [1] + [0] * (d - 1)
+    example_exp2 = ([0, 1] + [0] * (d - 2)) if d >= 2 else [1]
+    lines.extend(
+        [
+            "",
+            "Output format: a JSON array of terms [1,[e1,...,ed]], using integer",
+            "0/1 exponents in the coordinate order z_1,...,z_d. No repeats are",
+            "allowed and term order is canonical; no constant term is allowed.",
+            "Give your final answer inside <answer></answer> tags.",
+            "A format-only example for a hypothetical two-term answer is:",
+            f"<answer>{json.dumps([[1, example_exp1], [1, example_exp2]], separators=(',', ':'))}</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    tagged = re.findall(r"<answer>\s*(.*?)\s*</answer>", text, re.I | re.S)
+    candidates = list(reversed(tagged))
+    candidates.extend(re.findall(r"```(?:json)?\s*(.*?)```", text, re.I | re.S))
+    if not candidates:
+        candidates = [text]
+    decoder = json.JSONDecoder()
+    for candidate in candidates:
+        starts = [i for i, char in enumerate(candidate) if char == "["]
+        for start in starts:
+            try:
+                value, _end = decoder.raw_decode(candidate[start:])
+            except (ValueError, TypeError):
+                continue
+            if isinstance(value, list):
+                return value
+    return None
+
+
+def _clause_tree_accepts(values: dict[str, int], bad: tuple[int, int, int], names: list[str]) -> bool:
+    # The corresponding disjunction is false only on this bad assignment.
+    return any(values[name] != bit for name, bit in zip(names, bad))
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    d, terms = inst["dimension"], inst["terms"]
+    masks, reason = _poly_masks(answer, d, terms)
+    if masks is None:
+        return False, reason
+
+    values: dict[str, int] = {}
+    nonzero = 0
+    for name in inst["features"]:
+        value = _eval_masks(masks, int(name, 2))
+        values[name] = value
+        nonzero += value
+    if nonzero > inst["l0_bound"]:
+        return False, "candidate exceeds the inclusive L0 bound"
+
+    target_votes = 0
+    other_votes = inst["constant_other_trees"]
+    for gadget in inst["gadgets"]:
+        names = gadget["features"]
+        rhs = gadget["parity"]
+        for bad in itertools.product((0, 1), repeat=3):
+            if (bad[0] ^ bad[1] ^ bad[2]) == rhs:
+                continue
+            if _clause_tree_accepts(values, bad, names):
+                target_votes += 1
+            else:
+                other_votes += 1
+    if target_votes <= other_votes:
+        return False, "tree-ensemble majority is OTHER, not TARGET"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    support = rng.sample(_monomial_masks(inst["dimension"]), inst["terms"])
+    return _poly_from_masks(support, inst["dimension"])
+
+
+def search_space(inst: dict) -> int:
+    d, terms = inst["dimension"], inst["terms"]
+    return math.comb(d + d * (d - 1) // 2, terms)
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space > 100_000:
+        return None
+    valid = 0
+    universe = _monomial_masks(inst["dimension"])
+    for support in itertools.combinations(universe, inst["terms"]):
+        valid += int(verify(inst, _poly_from_masks(list(support), inst["dimension"]))[0])
+    return valid
+
+
+def canonical_key(inst: dict) -> str:
+    """Normalize feature order, gadget order, and order within each XOR triple."""
+    gadgets = sorted(
+        (tuple(sorted(gadget["features"])), int(gadget["parity"]))
+        for gadget in inst["gadgets"]
+    )
+    normalized = {
+        "dimension": inst["dimension"],
+        "terms": inst["terms"],
+        "l0_bound": inst["l0_bound"],
+        "features": sorted(inst["features"]),
+        "gadgets": gadgets,
+        "constant_other_trees": inst["constant_other_trees"],
+    }
+    blob = json.dumps(normalized, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    harder = {k: v for k, v in params.items() if k != "_preset"}
+    d = int(harder.get("n", 7))
+    terms = int(harder.get("terms", 8))
+    # The ambient feature set doubles while the number of polynomial terms is
+    # fixed.  Only when exponent vectors themselves cross the atom/character
+    # cap do we report cap_bound.
+    next_d = d + 1
+    estimated_atoms = terms * (next_d + 1)
+    estimated_chars = terms * (2 * next_d + 12)
+    if estimated_atoms > 256 or estimated_chars > 2000:
+        return "cap_bound"
+    harder["n"] = next_d
+    harder["terms"] = terms
+    return harder
+
+
+def _equations(inst: dict) -> list[tuple[int, int]]:
+    """Return coefficient bitmask and rhs for every displayed XOR gadget."""
+    index = {name: i for i, name in enumerate(sorted(inst["features"]))}
+    rows = []
+    for gadget in inst["gadgets"]:
+        row = 0
+        for name in gadget["features"]:
+            row ^= 1 << index[name]
+        rows.append((row, int(gadget["parity"])))
+    return rows
+
+
+def _reference_algorithm(inst: dict) -> tuple[object | None, dict[str, int]]:
+    """Exact GF(2) RREF, followed by ANF interpolation from point values."""
+    equations = _equations(inst)
+    width = len(inst["features"])
+    rows = [bits | (rhs << width) for bits, rhs in equations]
+    pivot_row = 0
+    pivot_for_col: dict[int, int] = {}
+    pivot_tests = 0
+    row_xors = 0
+    for col in range(width):
+        pivot = None
+        for row_index in range(pivot_row, len(rows)):
+            pivot_tests += 1
+            if (rows[row_index] >> col) & 1:
+                pivot = row_index
+                break
+        if pivot is None:
+            continue
+        rows[pivot_row], rows[pivot] = rows[pivot], rows[pivot_row]
+        for row_index in range(len(rows)):
+            pivot_tests += 1
+            if row_index != pivot_row and ((rows[row_index] >> col) & 1):
+                rows[row_index] ^= rows[pivot_row]
+                row_xors += 1
+        pivot_for_col[col] = pivot_row
+        pivot_row += 1
+        if pivot_row == len(rows):
+            break
+    coeff_mask = (1 << width) - 1
+    for row in rows:
+        if (row & coeff_mask) == 0 and ((row >> width) & 1):
+            return None, {
+                "pivot_tests": pivot_tests,
+                "row_xors": row_xors,
+                "bit_operations": pivot_tests + row_xors * (width + 1),
+            }
+    if len(pivot_for_col) != width:
+        return None, {
+            "pivot_tests": pivot_tests,
+            "row_xors": row_xors,
+            "bit_operations": pivot_tests + row_xors * (width + 1),
+        }
+    solution = [0] * width
+    for col, row_index in pivot_for_col.items():
+        solution[col] = (rows[row_index] >> width) & 1
+
+    names = sorted(inst["features"])
+    value_by_point = {int(name, 2): solution[i] for i, name in enumerate(names)}
+    d = inst["dimension"]
+    support: list[int] = []
+    for i in range(d):
+        e = 1 << i
+        if value_by_point[e]:
+            support.append(e)
+    for i in range(d):
+        for j in range(i + 1, d):
+            ei, ej = 1 << i, 1 << j
+            coefficient = value_by_point[ei] ^ value_by_point[ej] ^ value_by_point[ei | ej]
+            if coefficient:
+                support.append(ei | ej)
+    answer = _poly_from_masks(support, d)
+    operations = {
+        "pivot_tests": pivot_tests,
+        "row_xors": row_xors,
+        "bit_operations": pivot_tests + row_xors * (width + 1),
+    }
+    return answer, operations
+
+
+def _unsatisfied(inst: dict, masks: list[int]) -> int:
+    misses = 0
+    for gadget in inst["gadgets"]:
+        points = [int(name, 2) for name in gadget["features"]]
+        lhs = 0
+        for point in points:
+            lhs ^= _eval_masks(masks, point)
+        misses += int(lhs != gadget["parity"])
+    return misses
+
+
+def _attack_correlation(inst: dict) -> object:
+    """Per-monomial agreement, the natural construction-outlier probe."""
+    scores = []
+    for mask in _monomial_masks(inst["dimension"]):
+        agreement = 0
+        for gadget in inst["gadgets"]:
+            lhs = 0
+            for name in gadget["features"]:
+                lhs ^= _eval_masks([mask], int(name, 2))
+            agreement += int(lhs == gadget["parity"])
+        scores.append((agreement, -mask, mask))
+    chosen = [record[2] for record in sorted(scores, reverse=True)[: inst["terms"]]]
+    return _poly_from_masks(chosen, inst["dimension"])
+
+
+def _attack_greedy_swap(inst: dict) -> tuple[object, int]:
+    universe = _monomial_masks(inst["dimension"])
+    candidate_obj = _attack_correlation(inst)
+    masks, _ = _poly_masks(candidate_obj, inst["dimension"], inst["terms"])
+    assert masks is not None
+    chosen = set(masks)
+    evaluations = 1
+    score = _unsatisfied(inst, sorted(chosen))
+    # Two best-improvement sweeps are a plausible unaided local strategy, not
+    # the algebraic reference algorithm.
+    for _ in range(2):
+        best = (score, None, None)
+        for old in sorted(chosen):
+            for new in universe:
+                if new in chosen:
+                    continue
+                trial = sorted((chosen - {old}) | {new})
+                trial_score = _unsatisfied(inst, trial)
+                evaluations += 1
+                if trial_score < best[0]:
+                    best = (trial_score, old, new)
+        if best[1] is None:
+            break
+        chosen.remove(best[1])
+        chosen.add(best[2])
+        score = best[0]
+    return _poly_from_masks(sorted(chosen), inst["dimension"]), evaluations
+
+
+def _attack_naive_closing(inst: dict) -> object:
+    """Treat each closing parity as a coefficient and ignore cocycle corrections."""
+    d = inst["dimension"]
+    chosen: list[int] = []
+    for gadget in inst["gadgets"]:
+        syndrome = 0
+        for name in gadget["features"]:
+            syndrome ^= int(name, 2)
+        if syndrome and syndrome & (syndrome - 1) == 0 and gadget["parity"]:
+            chosen.append(syndrome)
+    for mask in _monomial_masks(d):
+        if mask not in chosen:
+            chosen.append(mask)
+        if len(chosen) == inst["terms"]:
+            break
+    return _poly_from_masks(chosen[: inst["terms"]], d)
+
+
+def _reordered_instance(inst: dict, rng: random.Random) -> dict:
+    moved = copy.deepcopy(inst)
+    rng.shuffle(moved["features"])
+    rng.shuffle(moved["gadgets"])
+    for gadget in moved["gadgets"]:
+        rng.shuffle(gadget["features"])
+    return moved
+
+
+def _answer_metrics(answer: object) -> tuple[int, int, int]:
+    blob = json.dumps(answer, separators=(",", ":"))
+
+    def atoms(value: object) -> int:
+        if isinstance(value, dict):
+            return sum(atoms(item) for item in value.values())
+        if isinstance(value, (list, tuple)):
+            return sum(atoms(item) for item in value)
+        return 1
+
+    chars = len(blob)
+    return chars, math.ceil(chars / 4), atoms(answer)
+
+
+def selftest() -> dict:
+    report: dict[str, object] = {}
+
+    # G1: every named rung, three independent plants each.
+    g1_checks = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_checks += 1
+            if not ok:
+                g1_failures.append(f"{preset}/{seed}: {reason}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append(f"{preset}/{seed}: answer not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "checks": g1_checks,
+        "failures": g1_failures,
+        "generation_route": "inverse polynomial plant plus composition of cocycle identities",
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    sample = make_instance(seed=4242, **shipping)
+
+    # G2: distinct corruptions reach distinct rejection paths.
+    corruptions: dict[str, object] = {}
+    dropped = copy.deepcopy(sample["answer"][:-1])
+    swapped = copy.deepcopy(sample["answer"])
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    duplicated = copy.deepcopy(sample["answer"])
+    duplicated[1] = copy.deepcopy(duplicated[0])
+    out_of_range = copy.deepcopy(sample["answer"])
+    out_of_range[0][1][0] = 2
+    corruptions["drop_one"] = dropped
+    corruptions["swap_two"] = swapped
+    corruptions["duplicate_one"] = duplicated
+    corruptions["empty"] = []
+    corruptions["out_of_range"] = out_of_range
+    reasons = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(sample, candidate)
+        reasons[name] = {"rejected": not ok, "reason": reason}
+    report["G2_rejects_corruption"] = {
+        "pass": all(item["rejected"] for item in reasons.values())
+        and len({item["reason"] for item in reasons.values()}) == len(reasons),
+        "corruptions": reasons,
+    }
+
+    payload = json.dumps(sample["answer"], separators=(",", ":"))
+    response = f"I used the parity invariant.\n```json\n<answer>{payload}</answer>\n```"
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == sample["answer"] and parse_answer("not an answer") is None,
+        "model_style_response_parsed": parsed == sample["answer"],
+        "garbage_returns_none": parse_answer("not an answer") is None,
+    }
+
+    # G4 and shipping-density sample share the same 200k public candidates.
+    guess_rng = random.Random(20260905)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(sample, random_candidate(sample, guess_rng))[0])
+    guess_seconds = time.perf_counter() - guess_start
+    exact_density = 1 / search_space(sample)
+    report["G4_guess_resistance"] = {
+        "pass": guess_hits / guess_total < 1e-6 and exact_density < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_hits / guess_total,
+        "theorem_backed_exact_probability": exact_density,
+        "certificate_space": search_space(sample),
+        "sampler": "uniform exact-term-count degree-one/two ANF polynomials",
+        "wall_seconds": guess_seconds,
+    }
+
+    ref_start = time.perf_counter()
+    reference_answer, reference_ops = _reference_algorithm(sample)
+    reference_seconds = time.perf_counter() - ref_start
+    ref_ok = reference_answer is not None and verify(sample, reference_answer)[0]
+    report["G5_density_and_baseline"] = {
+        "pass": ref_ok,
+        "shipping_sampled_density_hits": guess_hits,
+        "shipping_sampled_density_total": guess_total,
+        "shipping_observed_solution_density": guess_hits / guess_total,
+        "theorem_backed_valid_count": 1,
+        "certificate_space_count": search_space(sample),
+        "theorem_backed_exact_density": exact_density,
+        "baseline_wall_seconds": reference_seconds,
+        "baseline_bit_operations": reference_ops["bit_operations"],
+        "baseline_row_xors": reference_ops["row_xors"],
+    }
+
+    attack_names = (
+        "outlier_single_monomial_correlation",
+        "greedy_two_single_swap_sweeps",
+        "random_restart_256",
+        "in_context_naive_closing_sign_ansatz",
+    )
+    attack_successes = {name: 0 for name in attack_names}
+    attack_attempts = {name: 0 for name in attack_names}
+    greedy_evaluations = 0
+    restart_candidates = 0
+    reference_successes = 0
+    reference_operations = 0
+    reference_wall = 0.0
+    for seed in range(8):
+        inst = make_instance(seed=7000 + seed, **shipping)
+        candidates = {
+            "outlier_single_monomial_correlation": _attack_correlation(inst),
+            "in_context_naive_closing_sign_ansatz": _attack_naive_closing(inst),
+        }
+        greedy, evaluations = _attack_greedy_swap(inst)
+        greedy_evaluations += evaluations
+        candidates["greedy_two_single_swap_sweeps"] = greedy
+        found_random = None
+        rrng = random.Random(8000 + seed)
+        for _ in range(256):
+            candidate = random_candidate(inst, rrng)
+            restart_candidates += 1
+            if verify(inst, candidate)[0]:
+                found_random = candidate
+                break
+        candidates["random_restart_256"] = found_random
+        for name, candidate in candidates.items():
+            attack_attempts[name] += 1
+            attack_successes[name] += int(candidate is not None and verify(inst, candidate)[0])
+
+        started = time.perf_counter()
+        solved, ops = _reference_algorithm(inst)
+        reference_wall += time.perf_counter() - started
+        reference_operations += ops["bit_operations"]
+        reference_successes += int(solved is not None and verify(inst, solved)[0])
+
+    attacks = {
+        name: {"successes": attack_successes[name], "attempts": attack_attempts[name]}
+        for name in attack_names
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(result["successes"] == 0 for result in attacks.values()),
+        "attacks": attacks,
+        "greedy_candidate_evaluations": greedy_evaluations,
+        "random_restart_candidates": restart_candidates,
+        "reference_algorithm": {
+            "name": "parity-gadget recovery plus exact GF(2) RREF and ANF interpolation",
+            "complexity": "O(E*V^2) textbook bit operations",
+            "wall_clock_sec": reference_wall,
+            "operations": reference_operations,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] = int(shipping["n"]) + 1
+    doubled = make_instance(seed=9090, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and len(doubled["features"]) == 2 * len(sample["features"]) + 1
+        and search_space(doubled) > search_space(sample),
+        "base_features": len(sample["features"]),
+        "doubled_features": len(doubled["features"]),
+        "base_certificate_space": search_space(sample),
+        "doubled_certificate_space": search_space(doubled),
+        "fixed_polynomial_terms": doubled["terms"],
+        "verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    failures = []
+    keys = []
+    for seed in range(20):
+        inst = make_instance(seed=12000 + seed, **shipping)
+        key = canonical_key(inst)
+        keys.append(key)
+        rng = random.Random(13000 + seed)
+        for repeat in range(3):
+            moved = _reordered_instance(inst, rng)
+            invariance_checks += 1
+            if canonical_key(moved) != key:
+                failures.append(f"seed {seed}, reorder {repeat}: key changed")
+            if verify(moved, inst["answer"])[0]:
+                carried_checks += 1
+            else:
+                failures.append(f"seed {seed}, reorder {repeat}: witness failed")
+    report["G8_canonical_key"] = {
+        "pass": not failures and len(set(keys)) == 20 and carried_checks == invariance_checks,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": carried_checks,
+        "unrelated_distinct": len(set(keys)),
+        "unrelated_attempts": 20,
+        "transformations": [
+            "feature declaration reordering",
+            "parity-gadget reordering",
+            "within-gadget decision-test reordering",
+            "their compositions",
+        ],
+        "failures": failures,
+    }
+
+    answer_chars, answer_tokens, answer_elements = _answer_metrics(sample["answer"])
+    intended_ops = (sample["dimension"] * (sample["dimension"] - 1) // 2) + 7 * sample["dimension"]
+    hinted = G9_ARM_RESULTS["hinted"]
+    placebo = G9_ARM_RESULTS["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else None
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else None
+    difference = (
+        hinted_rate - placebo_rate
+        if hinted_rate is not None and placebo_rate is not None
+        else None
+    )
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": G9_ARM_RESULTS,
+        "hinted_minus_placebo": difference,
+        "hinted_verdict": G9_HINTED_VERDICT,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        item.get("pass")
+        for key, item in report.items()
+        if key.startswith("G") and isinstance(item, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

