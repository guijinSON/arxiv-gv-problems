   948	def _reorder_trees(inst: dict) -> tuple[dict, str]:
   949	    transformed = {key: value for key, value in inst.items() if key != "answer"}
   950	    transformed["clause_trees"] = list(reversed(inst["clause_trees"]))
   951	    transformed["answer"] = inst["answer"]
   952	    return transformed, inst["answer"]
   953	
   954	
   955	def _reorder_tests(inst: dict) -> tuple[dict, str]:
   956	    transformed = {key: value for key, value in inst.items() if key != "answer"}
   957	    transformed["clause_trees"] = [list(reversed(clause)) for clause in inst["clause_trees"]]
   958	    transformed["answer"] = inst["answer"]
   959	    return transformed, inst["answer"]
