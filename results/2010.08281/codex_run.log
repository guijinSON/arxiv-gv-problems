   745	def _relabel_instance(inst: dict, rng: random.Random) -> tuple[dict, str]:
   746	    """Reorder features, trees, and literal tests; carry the answer through."""
   747	    n = inst["n"]
   748	    old_at_new = list(range(n))
   749	    rng.shuffle(old_at_new)
   750	    new_of_old = [0] * n
   751	    for new, old in enumerate(old_at_new):
   752	        new_of_old[old] = new
   753	
   754	    transformed = {key: value for key, value in inst.items() if key != "answer"}
   755	    transformed["tags"] = [inst["tags"][old] for old in old_at_new]
   756	    transformed["baseline"] = "".join(inst["baseline"][old] for old in old_at_new)
   757	    clauses = []
   758	    for old_clause in reversed(inst["clause_trees"]):
   759	        clause = []
   760	        for literal in reversed(old_clause):
   761	            new_index = new_of_old[abs(literal) - 1] + 1
   762	            clause.append(new_index if literal > 0 else -new_index)
   763	        clauses.append(clause)
   764	    transformed["clause_trees"] = clauses
   765	    carried = "".join(inst["answer"][old] for old in old_at_new)
   766	    transformed["answer"] = carried
   767	    return transformed, carried
   768	
   769	
   770	def _reorder_trees(inst: dict) -> tuple[dict, str]:
   771	    transformed = {key: value for key, value in inst.items() if key != "answer"}
   772	    transformed["clause_trees"] = list(reversed(inst["clause_trees"]))
   773	    transformed["answer"] = inst["answer"]
   774	    return transformed, inst["answer"]
   775	
   776	
   777	def _reorder_tests(inst: dict) -> tuple[dict, str]:
   778	    transformed = {key: value for key, value in inst.items() if key != "answer"}
   779	    transformed["clause_trees"] = [list(reversed(clause)) for clause in inst["clause_trees"]]
   780	    transformed["answer"] = inst["answer"]
   781	    return transformed, inst["answer"]
   782	
   783	
   784	def _change_tag_basis(inst: dict) -> tuple[dict, str]:
   785	    """Apply the invertible transvection e_0 -> e_0+e_1 to every tag."""
   786	    transformed = {key: value for key, value in inst.items() if key != "answer"}
   787	    transformed["tags"] = [tag ^ (((tag >> 0) & 1) << 1) for tag in inst["tags"]]
   788	    transformed["answer"] = inst["answer"]
   789	    return transformed, inst["answer"]
   790	
