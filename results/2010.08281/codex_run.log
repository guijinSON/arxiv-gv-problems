   778	
   779	def _attack_greedy_single_sweep(inst: dict) -> tuple[str, int]:
   780	    equations = _extract_xor_equations(inst)
   781	    bits = [0] * inst["n"]
   782	    operations = 0
   783	    current = _equation_violations(equations, bits)
   784	    operations += len(equations)
   785	    # A deliberately plausible no-backtracking local repair: keep a flip only
   786	    # if it strictly improves the number of satisfied clause blocks.
   787	    for index in range(inst["n"]):
   788	        bits[index] ^= 1
   789	        trial = _equation_violations(equations, bits)
   790	        operations += len(equations)
   791	        if trial < current:
   792	            current = trial
   793	        else:
   794	            bits[index] ^= 1
   795	    return "".join(map(str, bits)), operations
