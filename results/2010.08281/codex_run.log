+"""Verified problem generator for arXiv:2010.08281.
+
+The family is the paper's L0-bounded suspected-path extraction problem, using
+the exact decision-tree ensemble in the proof of Theorem 1.  A Boolean
+polynomial is sampled first.  Its values on nonzero points of F_2^d form the
+adversarial input, and affine-cocycle identities are compiled into 3-XOR
+gadgets, four clause trees per gadget.  The planted polynomial is therefore
+known by construction; make_instance never solves its output.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
