   499	def enumerate_all(inst: dict) -> int | None:
   500	    space = search_space(inst)
   501	    if space is None or space > _ENUMERATION_CAP:
   502	        return None
   503	    n = inst["n"]
   504	    count = 0
   505	    for value in range(space):
   506	        candidate = format(value, f"0{n}b")
   507	        count += int(verify(inst, candidate)[0])
