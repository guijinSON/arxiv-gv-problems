   476	            or any(isinstance(x, bool) or not isinstance(x, int) or x == 0 or abs(x) > n for x in clause)
   477	            or len({abs(x) for x in clause}) != 3
   478	        ):
   479	            return False, "instance contains a malformed clause tree"
   480	        if _clause_value(clause, answer):
   481	            true_votes += 1
   482	        elif first_false is None:
   483	            first_false = tree_index
   484	    if true_votes <= (len(clauses) + false_trees) // 2:
   485	        detail = f": clause tree {first_false} voted False" if first_false is not None else ""
   486	        return False, "forest majority is False" + detail
   487	    return True, "ok"
