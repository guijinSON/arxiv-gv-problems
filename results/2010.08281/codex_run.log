   792	def _corruptions(inst: dict) -> dict[str, object]:
   793	    answer = inst["answer"]
   794	    left = next(i for i, bit in enumerate(answer) if bit == "0")
   795	    right = next(i for i, bit in enumerate(answer) if bit == "1")
   796	    swapped = list(answer)
   797	    swapped[left], swapped[right] = swapped[right], swapped[left]
   798	    return {
   799	        "drop_one": answer[:-1],
   800	        "swap_unequal": "".join(swapped),
   801	        "duplicate_one": answer + answer[-1],
   802	        "empty": "",
   803	        "out_of_range": "2" + answer[1:],
   804	    }
