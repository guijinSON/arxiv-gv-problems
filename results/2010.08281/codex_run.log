+        "generation_route": "inverse polynomial plant plus composition of cocycle identities",
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    sample = make_instance(seed=4242, **shipping)
+
+    # G2: distinct corruptions reach distinct rejection paths.
