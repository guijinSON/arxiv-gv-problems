   985	def selftest() -> dict:
   986	    report: dict[str, object] = {
   987	        "paper": "arXiv:2010.08281",
   988	        "track": TRACK,
   989	        "shipping_difficulty": SHIPPING_DIFFICULTY,
   990	        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
   991	    }
   992	
   993	    # G1: every named rung, several independently generated instances.
   994	    g1_checks = 0
   995	    g1_failures = []
   996	    for preset, params in DIFFICULTY.items():
   997	        for seed in (0, 1, 19):
