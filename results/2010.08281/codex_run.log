   962	def _change_tag_basis(inst: dict) -> tuple[dict, str]:
   963	    """Apply the invertible transvection e_0 -> e_0+e_1 to every tag."""
   964	    transformed = {key: value for key, value in inst.items() if key != "answer"}
   965	    transformed["tags"] = [tag ^ (((tag >> 0) & 1) << 1) for tag in inst["tags"]]
   966	    transformed["answer"] = inst["answer"]
   967	    return transformed, inst["answer"]
