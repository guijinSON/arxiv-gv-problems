+def _attack_rhs_majority(inst: dict) -> tuple[str, int]:
+    equations = _extract_xor_equations(inst)
+    zero_votes = [0] * inst["n"]
+    one_votes = [0] * inst["n"]
+    for indices, rhs in equations:
+        for index in indices:
+            if rhs:
+                one_votes[index] += 1
+            else:
+                zero_votes[index] += 1
+    answer = "".join(
