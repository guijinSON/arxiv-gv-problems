   676	def _reference_dpll(inst: dict) -> tuple[str | None, dict]:
   677	    """A small domain-standard SAT baseline: DPLL with unit propagation."""
   678	    started = time.perf_counter()
   679	    clauses = inst["clause_trees"]
   680	    n = inst["n"]
   681	    activity = [0] * n
   682	    for clause in clauses:
   683	        for literal in clause:
   684	            activity[abs(literal) - 1] += 1
   685	
   686	    metrics = {
   687	        "nodes": 0,
   688	        "decisions": 0,
   689	        "propagations": 0,
   690	        "clause_scans": 0,
   691	        "literal_checks": 0,
   692	    }
   693	
   694	    def solve(values: list[int]) -> list[int] | None:
   695	        metrics["nodes"] += 1
   696	        while True:
   697	            unit_literal = None
   698	            all_satisfied = True
   699	            for clause in clauses:
   700	                metrics["clause_scans"] += 1
   701	                unknown = []
   702	                satisfied = False
   703	                for literal in clause:
   704	                    metrics["literal_checks"] += 1
   705	                    value = values[abs(literal) - 1]
   706	                    if value < 0:
   707	                        unknown.append(literal)
   708	                    elif bool(value) == (literal > 0):
   709	                        satisfied = True
   710	                        break
   711	                if satisfied:
   712	                    continue
   713	                all_satisfied = False
   714	                if not unknown:
   715	                    return None
   716	                if len(unknown) == 1:
   717	                    unit_literal = unknown[0]
   718	                    break
   719	            if all_satisfied:
   720	                return [0 if value < 0 else value for value in values]
   721	            if unit_literal is None:
   722	                break
   723	            index = abs(unit_literal) - 1
   724	            forced = int(unit_literal > 0)
   725	            if values[index] >= 0 and values[index] != forced:
   726	                return None
   727	            if values[index] < 0:
   728	                values[index] = forced
   729	                metrics["propagations"] += 1
   730	
   731	        variable = max(
   732	            (index for index, value in enumerate(values) if value < 0),
   733	            key=lambda index: (activity[index], -index),
   734	            default=None,
   735	        )
   736	        if variable is None:
   737	            return values
   738	        for chosen in (0, 1):
   739	            metrics["decisions"] += 1
   740	            branch = values.copy()
   741	            branch[variable] = chosen
   742	            result = solve(branch)
   743	            if result is not None:
   744	                return result
   745	        return None
   746	
   747	    solution = solve([-1] * n)
   748	    metrics["wall_clock_sec"] = time.perf_counter() - started
   749	    if solution is None:
   750	        return None, metrics
   751	    return "".join(map(str, solution)), metrics
   752	
