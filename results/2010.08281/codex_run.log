+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+# n is the coordinate dimension.  There are 2^n-1 Boolean input features.
+# The planted support is held at eight terms on the three evaluated rungs, so
+# escalation grows the ambient haystack while keeping the symbolic witness short.
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "terms": 2},
+    "easy": {"n": 5, "terms": 8},
+    "medium": {"n": 6, "terms": 8},
