   626	def _reference_gaussian(inst: dict) -> tuple[str | None, dict]:
   627	    """Polynomial Track-B reference solver, with elementary bit-op accounting."""
   628	    started = time.perf_counter()
   629	    n = inst["n"]
   630	    equations = _extract_xor_equations(inst)
   631	    variable_mask = (1 << n) - 1
   632	    pivots: dict[int, int] = {}
   633	    bit_operations = 0
   634	    row_xors = 0
   635	    pivot_tests = 0
   636	    for indices, rhs in equations:
   637	        row = (1 << indices[0]) | (1 << indices[1]) | (1 << indices[2]) | (rhs << n)
   638	        while row & variable_mask:
   639	            pivot = (row & variable_mask).bit_length() - 1
   640	            pivot_tests += 1
   641	            bit_operations += 1
   642	            if pivot in pivots:
   643	                row ^= pivots[pivot]
   644	                row_xors += 1
   645	                bit_operations += n + 1
   646	            else:
   647	                pivots[pivot] = row
   648	                break
   649	        if not (row & variable_mask) and ((row >> n) & 1):
   650	            return None, {
   651	                "wall_clock_sec": time.perf_counter() - started,
   652	                "bit_operations": bit_operations,
   653	                "row_xors": row_xors,
   654	                "pivot_tests": pivot_tests,
   655	                "rank": len(pivots),
   656	            }
   657	
   658	    solution = 0
   659	    for pivot, row in sorted(pivots.items()):
   660	        lower = row & ((1 << pivot) - 1)
   661	        rhs = (row >> n) & 1
   662	        bit = rhs ^ ((lower & solution).bit_count() & 1)
   663	        bit_operations += pivot + 2
   664	        if bit:
   665	            solution |= 1 << pivot
   666	    answer = "".join("1" if (solution >> i) & 1 else "0" for i in range(n))
   667	    return answer, {
   668	        "wall_clock_sec": time.perf_counter() - started,
   669	        "bit_operations": bit_operations,
   670	        "row_xors": row_xors,
   671	        "pivot_tests": pivot_tests,
   672	        "rank": len(pivots),
   673	    }
   674	
