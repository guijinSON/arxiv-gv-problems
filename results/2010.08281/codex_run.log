   584	def escalate(params: dict) -> dict | str | None:
   585	    result = dict(params)
   586	    n = int(result.get("n", 31))
   587	    factor = int(result.get("equation_factor", 3))
   588	    if factor < 8:
   589	        result["equation_factor"] = factor + 1
   590	        return result
   591	    if n < 255:
   592	        next_n = 2 * n + 1
   593	        next_operations = 2 * (next_n - _dimension(next_n))
   594	        if next_n > 256 or next_operations > 300:
   595	            return "cap_bound"
   596	        result["n"] = next_n
   597	        result["equation_factor"] = 5
   598	        return result
   599	    return "cap_bound"
