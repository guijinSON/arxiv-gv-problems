   754	def _equation_violations(equations: list[tuple[tuple[int, int, int], int]], bits: list[int]) -> int:
   755	    return sum((bits[a] ^ bits[b] ^ bits[c]) != rhs for (a, b, c), rhs in equations)
   756	
   757	
   758	def _candidate_satisfies_equations(
   759	    candidate: str, equations: list[tuple[tuple[int, int, int], int]]
   760	) -> bool:
   760	) -> bool:
   761	    """Fast exact equivalent of the forest vote for prevalidated instances."""
   762	    for (a, b, c), rhs in equations:
   763	        if ((candidate[a] == "1") ^ (candidate[b] == "1") ^ (candidate[c] == "1")) != bool(rhs):
   764	            return False
   765	    return True
