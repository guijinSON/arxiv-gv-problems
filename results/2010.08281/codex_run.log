   923	def _relabel_instance(inst: dict, rng: random.Random) -> tuple[dict, str]:
   924	    """Reorder features, trees, and literal tests; carry the answer through."""
   925	    n = inst["n"]
   926	    old_at_new = list(range(n))
   927	    rng.shuffle(old_at_new)
   928	    new_of_old = [0] * n
   929	    for new, old in enumerate(old_at_new):
   930	        new_of_old[old] = new
   931	
   932	    transformed = {key: value for key, value in inst.items() if key != "answer"}
   933	    transformed["tags"] = [inst["tags"][old] for old in old_at_new]
   934	    transformed["baseline"] = "".join(inst["baseline"][old] for old in old_at_new)
   935	    clauses = []
   936	    for old_clause in reversed(inst["clause_trees"]):
   937	        clause = []
   938	        for literal in reversed(old_clause):
   939	            new_index = new_of_old[abs(literal) - 1] + 1
   940	            clause.append(new_index if literal > 0 else -new_index)
   941	        clauses.append(clause)
   942	    transformed["clause_trees"] = clauses
   943	    carried = "".join(inst["answer"][old] for old in old_at_new)
   944	    transformed["answer"] = carried
   945	    return transformed, carried
   946	
