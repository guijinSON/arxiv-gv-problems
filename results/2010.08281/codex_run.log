import importlib.util, time
p='gen_2010_08281.py'
s=importlib.util.spec_from_file_location('g',p);g=importlib.util.module_from_spec(s);s.loader.exec_module(g)

def dpll(inst):
    clauses=[[lit for lit in c] for c in inst['clause_trees']]
    n=inst['n']; nodes=0; scans=0; assigns=0
    # occurrences static
    occ=[0]*n
    for c in clauses:
      for l in c: occ[abs(l)-1]+=1
    def rec(vals):
      nonlocal nodes,scans,assigns
      nodes+=1
      while True:
        unit=None
        for c in clauses:
          scans+=1
          sat=False; unknown=[]
          for l in c:
            v=vals[abs(l)-1]
            if v is None: unknown.append(l)
            elif v == (l>0): sat=True; break
          if sat: continue
          if not unknown:return None
          if len(unknown)==1:
            unit=unknown[0];break
        if unit is None: break
        i=abs(unit)-1; value=unit>0
        if vals[i] is not None and vals[i]"'!=value:return None
        if vals[i] is None: vals[i]=value;assigns+=1
      # all clauses sat?
      best=-1; bv=None
      for i,v in enumerate(vals):
        if v is None and occ[i]>best:best=occ[i];bv=i
      if bv is None:return vals
      for value in (False,True):
        nv=vals.copy();nv[bv]=value;assigns+=1
        out=rec(nv)
        if out is not None:return out
      return None
    t=time.perf_counter(); vals=rec([None]*n); dt=time.perf_counter()-t
    return '"''.join('1' if x else '0' for x in vals) if vals else None,(nodes,scans,assigns,dt)
