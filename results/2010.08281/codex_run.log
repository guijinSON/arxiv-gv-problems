+        ),
+        "parsed_matches": parsed == shipping["answer"],
+        "garbage_returns_none": parse_answer("no tagged answer here") is None,
+    }
+
+    guess_rng = random.Random(99173)
+    guess_hits = 0
+    guess_started = time.perf_counter()
