+
+def _bitstring(x: int, d: int) -> str:
+    return format(x, f"0{d}b")
+
+
+def _monomial_masks(d: int) -> list[int]:
+    """Degree-one and degree-two squarefree monomials, exponent-lex order."""
+    masks = [1 << i for i in range(d)]
+    masks.extend((1 << i) | (1 << j) for i in range(d) for j in range(i + 1, d))
+    return sorted(masks, key=lambda m: _mask_to_exponents(m, d))
+
+
+def _mask_to_exponents(mask: int, d: int) -> list[int]:
+    # Coordinate variable z_1 is the leftmost displayed bit, hence bit d-1.
+    return [int(bool(mask & (1 << (d - 1 - i)))) for i in range(d)]
+
+
+def _exponents_to_mask(exponents: list[int]) -> int:
+    d = len(exponents)
+    mask = 0
+    for i, exponent in enumerate(exponents):
+        if exponent:
+            mask |= 1 << (d - 1 - i)
+    return mask
+
+
+def _poly_from_masks(masks: list[int], d: int) -> list[list[object]]:
+    exps = sorted((_mask_to_exponents(mask, d) for mask in masks))
+    return [[1, exponent] for exponent in exps]
+
+
+def _poly_masks(answer: object, d: int, terms: int) -> tuple[list[int] | None, str]:
+    if not isinstance(answer, list):
+        return None, "answer must be a JSON list"
+    if not answer:
+        return None, "answer list is empty"
+    if len(answer) != terms:
+        return None, f"wrong term count: expected {terms}"
+    exponents: list[list[int]] = []
+    for term in answer:
+        if not isinstance(term, list) or len(term) != 2 or term[0] != 1:
+            return None, "each term must have coefficient 1 and one exponent list"
+        exp = term[1]
+        if not isinstance(exp, list) or len(exp) != d:
+            return None, f"each exponent list must have length {d}"
+        if any(type(value) is not int or value not in (0, 1) for value in exp):
+            return None, "every exponent must be the integer 0 or 1"
+        if sum(exp) not in (1, 2):
+            return None, "every monomial must have degree one or two"
+        exponents.append(exp)
+    packed = [tuple(exp) for exp in exponents]
+    if len(set(packed)) != len(packed):
+        return None, "duplicate monomial"
+    if packed != sorted(packed):
+        return None, "terms are not in canonical exponent order"
+    return [_exponents_to_mask(exp) for exp in exponents], "ok"
+
+
+def _eval_masks(masks: list[int], point: int) -> int:
+    value = 0
+    for mask in masks:
+        value ^= int((point & mask) == mask)
+    return value
+
+
+def _canonical_gadget(a: int, b: int, c: int, rhs: int) -> tuple[int, int, int, int]:
+    x, y, z = sorted((a, b, c))
+    return x, y, z, rhs
+
+
+def _cocycle_gadgets(d: int, masks: list[int]) -> list[tuple[int, int, int, int]]:
+    """A theorem-backed full-rank family of affine-cocycle equations.
+
+    All nonzero hypercube edges enforce y(v+e_i)=y(v)+y(e_i) for the
+    difference y between any solution and the plant, so y is linear.  The d
+    closing triples have XOR-syndromes e_i and kill that linear kernel.
+    """
+    gadgets: set[tuple[int, int, int, int]] = set()
+    limit = 1 << d
+    for i in range(d):
+        basis = 1 << i
+        for v in range(1, limit):
+            w = v ^ basis
+            if not w or v == basis:
+                continue
+            a, b, c = basis, v, w
+            rhs = _eval_masks(masks, a) ^ _eval_masks(masks, b) ^ _eval_masks(masks, c)
+            gadgets.add(_canonical_gadget(a, b, c, rhs))
+
+    # For each i use two other basis vectors and their three-bit sum.  The XOR
+    # of the three feature coordinates is e_i, independently for every i.
+    for i in range(d):
+        j = (i + 1) % d
+        k = (i + 2) % d
+        a, b = 1 << j, 1 << k
+        c = (1 << i) | (1 << j) | (1 << k)
+        rhs = _eval_masks(masks, a) ^ _eval_masks(masks, b) ^ _eval_masks(masks, c)
+        gadgets.add(_canonical_gadget(a, b, c, rhs))
+    return sorted(gadgets)
+
+
+def make_instance(n: int, seed: int = 0, **params: object) -> dict:
+    """Inverse-generate a native suspected-path extraction instance."""
+    d = int(n)
+    terms = int(params.get("terms", 8))
+    if d < 3:
+        raise ValueError("n must be at least 3")
+    universe = _monomial_masks(d)
+    if not 1 <= terms <= len(universe):
+        raise ValueError("terms must fit the degree-one/two monomial basis")
+    rng = random.Random(seed)
+    support = rng.sample(universe, terms)
+    answer = _poly_from_masks(support, d)
+    masks, reason = _poly_masks(answer, d, terms)
+    if masks is None:
+        raise AssertionError(reason)
+
+    gadgets = _cocycle_gadgets(d, masks)
+    rng.shuffle(gadgets)
+    gadget_records = [
+        {"features": [_bitstring(v, d) for v in (a, b, c)], "parity": rhs}
+        for a, b, c, rhs in gadgets
+    ]
+    features = [_bitstring(v, d) for v in range(1, 1 << d)]
+    rng.shuffle(features)
+    clause_trees = 4 * len(gadget_records)
+    return {
+        "paper": "arXiv:2010.08281",
+        "dimension": d,
+        "terms": terms,
+        "features": features,
+        "original_input": "all-zero",
+        "l0_bound": len(features),
+        "gadgets": gadget_records,
+        "clause_trees": clause_trees,
+        "constant_other_trees": clause_trees - 1,
+        "target_label": "TARGET",
+        "other_label": "OTHER",
+        "answer": answer,
+    }
+
+
+def _gadget_clause_text(names: list[str], rhs: int) -> str:
+    return f"XOR({names[0]},{names[1]},{names[2]})={rhs}"
+
+
+def render(inst: dict) -> str:
+    d = inst["dimension"]
+    lines = [
+        "L0-bounded suspected-path extraction in a Boolean tree ensemble",
+        "",
+        "Every input feature is Boolean (0 or 1). Its name is a nonzero binary",
+        f"coordinate in F_2^{d}; the leftmost bit is coordinate variable z_1.",
+        "The original training input assigns 0 to every feature. The L0 distance",
+        "is the number of feature values that differ from that all-zero input.",
+        "",
+        "A clause tree tests up to three named features and returns TARGET exactly",
+        "when their listed disjunctive clause is true; otherwise it returns OTHER.",
+        "For compactness, a gadget XOR(a,b,c)=r below denotes the four clause trees",
+        "that reject exactly the four assignments with a XOR b XOR c != r.",
+        "Thus all four trees return TARGET exactly when a XOR b XOR c = r.",
+        f"There are {inst['clause_trees']} such clause trees and",
+        f"{inst['constant_other_trees']} additional trees that always return OTHER.",
+        "The ensemble label is the strict majority label. Consequently it returns",
+        "TARGET exactly when every listed parity gadget is satisfied (there is no tie).",
+        "",
+        "You must give an algebraic-normal-form polynomial q over GF(2). It must",
+        f"contain exactly {inst['terms']} distinct nonconstant squarefree monomials,",
+        "each of degree 1 or 2, with coefficient 1. It describes the candidate",
+        "adversarial input by assigning feature v the bit q(v). The terms must be",
+        "sorted lexicographically by their exponent lists. Your polynomial is valid",
+        f"iff that input has L0 distance at most {inst['l0_bound']} and the ensemble",
+        "returns TARGET. All XORs and polynomial sums are modulo 2.",
+        "",
+        "Feature declaration order (the names themselves are the coordinates):",
+        " ".join(inst["features"]),
+        "",
+        "Parity-gadget tree blocks:",
+    ]
+    for index, gadget in enumerate(inst["gadgets"], 1):
+        lines.append(
+            f"{index}: " + _gadget_clause_text(gadget["features"], gadget["parity"])
+        )
+    example_exp1 = [1] + [0] * (d - 1)
+    example_exp2 = ([0, 1] + [0] * (d - 2)) if d >= 2 else [1]
+    lines.extend(
+        [
+            "",
+            "Output format: a JSON array of terms [1,[e1,...,ed]], using integer",
+            "0/1 exponents in the coordinate order z_1,...,z_d. No repeats are",
+            "allowed and term order is canonical; no constant term is allowed.",
+            "Give your final answer inside <answer></answer> tags.",
+            "A format-only example for a hypothetical two-term answer is:",
+            f"<answer>{json.dumps([[1, example_exp1], [1, example_exp2]], separators=(',', ':'))}</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    tagged = re.findall(r"<answer>\s*(.*?)\s*</answer>", text, re.I | re.S)
+    candidates = list(reversed(tagged))
+    candidates.extend(re.findall(r"```(?:json)?\s*(.*?)```", text, re.I | re.S))
+    if not candidates:
+        candidates = [text]
+    decoder = json.JSONDecoder()
+    for candidate in candidates:
+        starts = [i for i, char in enumerate(candidate) if char == "["]
+        for start in starts:
+            try:
+                value, _end = decoder.raw_decode(candidate[start:])
+            except (ValueError, TypeError):
+                continue
+            if isinstance(value, list):
+                return value
+    return None
+
+
+def _clause_tree_accepts(values: dict[str, int], bad: tuple[int, int, int], names: list[str]) -> bool:
+    # The corresponding disjunction is false only on this bad assignment.
+    return any(values[name] != bit for name, bit in zip(names, bad))
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    d, terms = inst["dimension"], inst["terms"]
+    masks, reason = _poly_masks(answer, d, terms)
+    if masks is None:
+        return False, reason
+
+    values: dict[str, int] = {}
+    nonzero = 0
+    for name in inst["features"]:
+        value = _eval_masks(masks, int(name, 2))
+        values[name] = value
+        nonzero += value
+    if nonzero > inst["l0_bound"]:
+        return False, "candidate exceeds the inclusive L0 bound"
+
+    target_votes = 0
+    other_votes = inst["constant_other_trees"]
+    for gadget in inst["gadgets"]:
+        names = gadget["features"]
+        rhs = gadget["parity"]
+        for bad in itertools.product((0, 1), repeat=3):
+            if (bad[0] ^ bad[1] ^ bad[2]) == rhs:
+                continue
+            if _clause_tree_accepts(values, bad, names):
+                target_votes += 1
+            else:
+                other_votes += 1
+    if target_votes <= other_votes:
+        return False, "tree-ensemble majority is OTHER, not TARGET"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    support = rng.sample(_monomial_masks(inst["dimension"]), inst["terms"])
+    return _poly_from_masks(support, inst["dimension"])
+
+
+def search_space(inst: dict) -> int:
+    d, terms = inst["dimension"], inst["terms"]
+    return math.comb(d + d * (d - 1) // 2, terms)
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space > 100_000:
+        return None
+    valid = 0
+    universe = _monomial_masks(inst["dimension"])
+    for support in itertools.combinations(universe, inst["terms"]):
