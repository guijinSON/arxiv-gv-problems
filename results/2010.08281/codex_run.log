   602	def _extract_xor_equations(inst: dict) -> list[tuple[tuple[int, int, int], int]]:
   603	    """Recognize the four-tree 3-CNF encoding of every XOR row."""
   604	    groups: dict[tuple[int, int, int], list[list[int]]] = {}
   605	    for clause in inst["clause_trees"]:
   606	        key = tuple(sorted(abs(literal) - 1 for literal in clause))
   607	        groups.setdefault(key, []).append(clause)
   608	    equations = []
   609	    for key, clauses in groups.items():
   610	        if len(clauses) != 4:
   611	            raise ValueError("clause trees do not form four-tree XOR blocks")
   612	        forbidden_patterns = set()
   613	        forbidden_parities = set()
   614	        for clause in clauses:
   615	            by_index = {abs(literal) - 1: literal for literal in clause}
   616	            forbidden = tuple(0 if by_index[index] > 0 else 1 for index in key)
   617	            forbidden_patterns.add(forbidden)
   618	            forbidden_parities.add(forbidden[0] ^ forbidden[1] ^ forbidden[2])
   619	        if len(forbidden_patterns) != 4 or len(forbidden_parities) != 1:
   620	            raise ValueError("malformed XOR clause block")
   621	        forbidden_parity = next(iter(forbidden_parities))
   622	        equations.append((key, 1 ^ forbidden_parity))
   623	    return equations
