   970	def _corruptions(inst: dict) -> dict[str, object]:
   971	    answer = inst["answer"]
   972	    left = next(i for i, bit in enumerate(answer) if bit == "0")
   973	    right = next(i for i, bit in enumerate(answer) if bit == "1")
   974	    swapped = list(answer)
   975	    swapped[left], swapped[right] = swapped[right], swapped[left]
   976	    return {
   977	        "drop_one": answer[:-1],
   978	        "swap_unequal": "".join(swapped),
   979	        "duplicate_one": answer + answer[-1],
   980	        "empty": "",
   981	        "out_of_range": "2" + answer[1:],
   982	    }
