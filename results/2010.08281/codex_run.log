+            "greedy_single_sweep": lambda: _attack_greedy_single_sweep(inst),
+            "random_restart_256": lambda: _attack_random_restart(inst, attack_seed ^ 0x5A5A),
+            "rhs_majority_ansatz": lambda: _attack_rhs_majority(inst),
+        }
