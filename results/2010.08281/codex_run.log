+    for index in range(inst["n"]):
+        bits[index] ^= 1
+        trial = _equation_violations(equations, bits)
+        operations += len(equations)
+        if trial < current:
+            current = trial
+        else:
+            bits[index] ^= 1
+    return "".join(map(str, bits)), operations
 
