   672	def _attack_rhs_majority(inst: dict) -> tuple[str, int]:
   673	    equations = _extract_xor_equations(inst)
   674	    zero_votes = [0] * inst["n"]
   675	    one_votes = [0] * inst["n"]
   676	    for indices, rhs in equations:
   677	        for index in indices:
   678	            if rhs:
   679	                one_votes[index] += 1
   680	            else:
   681	                zero_votes[index] += 1
   682	    answer = "".join(
   683	        "1" if one_votes[index] > zero_votes[index] else "0" for index in range(inst["n"])
   684	    )
   685	    return answer, len(equations) * 3
