+    duplicated = copy.deepcopy(sample["answer"])
+    duplicated[1] = copy.deepcopy(duplicated[0])
+    out_of_range = copy.deepcopy(sample["answer"])
+    out_of_range[0][1][0] = 2
+    corruptions["drop_one"] = dropped
+    corruptions["swap_two"] = swapped
+    corruptions["duplicate_one"] = duplicated
