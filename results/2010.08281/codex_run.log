def canonical_key(inst: dict) -> str:
    """Canonical under feature-index and tree/test-order relabellings."""
    n = inst["n"]
    tags = inst["tags"]
    if len(tags) != n or len(set(tags)) != n:
        raise ValueError("malformed tag list")
    canonical_trees = []
    for clause in inst["clause_trees"]:
        tagged = tuple(
            sorted((tags[abs(literal) - 1], 1 if literal > 0 else 0) for literal in clause)
        )
        canonical_trees.append(tagged)
    payload = (
        n,
        inst["tag_bits"],
        tuple(sorted(canonical_trees)),
