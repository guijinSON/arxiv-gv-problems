+def _attack_greedy_single_sweep(inst: dict) -> tuple[str, int]:
+    equations = _extract_xor_equations(inst)
+    bits = [0] * inst["n"]
+    operations = 0
+    current = _equation_violations(equations, bits)
+    operations += len(equations)
