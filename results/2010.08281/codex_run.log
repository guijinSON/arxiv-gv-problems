+                one_votes[index] += 1
+            else:
+                zero_votes[index] += 1
+    answer = "".join(
+        "1" if one_votes[index] > zero_votes[index] else "0" for index in range(inst["n"])
+    )
+    return answer, len(equations) * 3
 
