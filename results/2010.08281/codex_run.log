   798	def _attack_random_restart(inst: dict, seed: int, restarts: int = 256) -> tuple[str | None, int]:
   799	    rng = random.Random(seed)
   800	    equations = _extract_xor_equations(inst)
   801	    for attempt in range(restarts):
   802	        candidate = random_candidate(inst, rng)
   803	        if _candidate_satisfies_equations(candidate, equations):
   804	            return candidate, attempt + 1
   805	    return None, restarts
