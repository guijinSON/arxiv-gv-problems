   768	def _attack_outlier_tag_degree(inst: dict) -> tuple[str, int]:
   769	    equations = _extract_xor_equations(inst)
   770	    degree = [0] * inst["n"]
   771	    for indices, _ in equations:
   772	        for index in indices:
   773	            degree[index] += 1
   774	    ordered = sorted(degree)
   775	    median = ordered[len(ordered) // 2]
   776	    return "".join("1" if value > median else "0" for value in degree), len(equations) * 3
