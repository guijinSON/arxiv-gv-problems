   808	def _attack_rhs_majority(inst: dict) -> tuple[str, int]:
   809	    equations = _extract_xor_equations(inst)
   810	    zero_votes = [0] * inst["n"]
   811	    one_votes = [0] * inst["n"]
   812	    for indices, rhs in equations:
   813	        for index in indices:
   814	            if rhs:
   815	                one_votes[index] += 1
   816	            else:
   817	                zero_votes[index] += 1
   818	    answer = "".join(
   819	        "1" if one_votes[index] > zero_votes[index] else "0" for index in range(inst["n"])
   820	    )
   821	    return answer, len(equations) * 3
