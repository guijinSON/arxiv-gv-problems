   688	def _run_adversary_panel(params: dict) -> dict:
   689	    names = (
   690	        "outlier_tag_degree",
   691	        "greedy_single_sweep",
   692	        "random_restart_256",
   693	        "rhs_majority_ansatz",
   694	    )
   695	    results = {
   696	        name: {"successes": 0, "attempts": 0, "operations": 0, "wall_clock_sec": 0.0}
   697	        for name in names
   698	    }
   699	    reference_successes = 0
   700	    reference_operations = 0
   701	    reference_wall = 0.0
   702	    reference_ranks = []
   703	    for attack_seed in _ATTACK_SEEDS:
   704	        inst = make_instance(seed=attack_seed, **params)
   705	        attacks = {
   706	            "outlier_tag_degree": lambda: _attack_outlier_tag_degree(inst),
   707	            "greedy_single_sweep": lambda: _attack_greedy_single_sweep(inst),
   708	            "random_restart_256": lambda: _attack_random_restart(inst, attack_seed ^ 0x5A5A),
   709	            "rhs_majority_ansatz": lambda: _attack_rhs_majority(inst),
   710	        }
   711	        for name, attack in attacks.items():
   712	            started = time.perf_counter()
   713	            candidate, operations = attack()
   714	            elapsed = time.perf_counter() - started
   715	            results[name]["attempts"] += 1
   716	            results[name]["operations"] += operations
   717	            results[name]["wall_clock_sec"] += elapsed
   718	            if candidate is not None and verify(inst, candidate)[0]:
   719	                results[name]["successes"] += 1
   720	
   721	        reference, metrics = _reference_gaussian(inst)
   722	        reference_successes += int(reference is not None and verify(inst, reference)[0])
   723	        reference_operations += metrics["bit_operations"]
   724	        reference_wall += metrics["wall_clock_sec"]
   725	        reference_ranks.append(metrics["rank"])
   726	
   727	    for value in results.values():
   728	        value["wall_clock_sec"] = round(value["wall_clock_sec"], 6)
   729	    all_failed = all(value["successes"] == 0 for value in results.values())
   730	    return {
   731	        "pass": all_failed and reference_successes == len(_ATTACK_SEEDS),
   732	        "attacks": results,
   733	        "reference_algorithm": {
   734	            "name": "four-tree XOR recognition plus GF(2) Gaussian elimination",
   735	            "complexity": "O(e*n^2) elementary bit operations; polynomial",
   736	            "wall_clock_sec": round(reference_wall, 6),
   737	            "operations": reference_operations,
   738	            "average_operations": reference_operations // len(_ATTACK_SEEDS),
   739	            "ranks": reference_ranks,
   740	            "solves": f"{reference_successes}/{len(_ATTACK_SEEDS)}, as expected",
   741	        },
   742	    }
