   662	def _attack_random_restart(inst: dict, seed: int, restarts: int = 256) -> tuple[str | None, int]:
   663	    rng = random.Random(seed)
   664	    equations = _extract_xor_equations(inst)
   665	    for attempt in range(restarts):
   666	        candidate = random_candidate(inst, rng)
   667	        if _candidate_satisfies_equations(candidate, equations):
   668	            return candidate, attempt + 1
   669	    return None, restarts
