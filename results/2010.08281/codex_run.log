   511	def canonical_key(inst: dict) -> str:
   512	    """Strong cheap invariant under feature, tree, test, and tag-basis relabelling.
   513	
   514	    Exact isomorphism of the signed 3-uniform incidence structure is not known
   515	    to be cheap.  Colour refinement gives a deterministic structural fingerprint
   516	    and, unlike hashing the rendered tags, also quotients a global GL(d,2)
   517	    change of coordinates on those tags.
   518	    """
   519	    n = inst["n"]
   520	    tags = inst["tags"]
   521	    if len(tags) != n or len(set(tags)) != n:
   522	        raise ValueError("malformed tag list")
   523	    equations = _extract_xor_equations(inst)
   524	    baseline = inst.get("baseline")
   525	    if not isinstance(baseline, str) or len(baseline) != n:
   526	        raise ValueError("malformed baseline")
   527	
   528	    incident: list[list[int]] = [[] for _ in range(n)]
   529	    for edge_index, (indices, _) in enumerate(equations):
   530	        for index in indices:
   531	            incident[index].append(edge_index)
   532	
   533	    # One-dimensional Weisfeiler--Lehman refinement on the bipartite incidence
   534	    # graph, with equation right sides and baseline bits as initial colours.
   535	    variable_colours = [int(bit) for bit in baseline]
   536	    equation_colours = [rhs for _, rhs in equations]
   537	    for _ in range(n + 1):
   538	        variable_signatures = [
   539	            (variable_colours[index], tuple(sorted(equation_colours[e] for e in incident[index])))
   540	            for index in range(n)
   541	        ]
   542	        variable_palette = {
   543	            signature: colour
   544	            for colour, signature in enumerate(sorted(set(variable_signatures)))
   545	        }
   546	        new_variable_colours = [variable_palette[s] for s in variable_signatures]
   547	
   548	        equation_signatures = [
   549	            (rhs, tuple(sorted(new_variable_colours[index] for index in indices)))
   550	            for indices, rhs in equations
   551	        ]
   552	        equation_palette = {
   553	            signature: colour
   554	            for colour, signature in enumerate(sorted(set(equation_signatures)))
   555	        }
   556	        new_equation_colours = [equation_palette[s] for s in equation_signatures]
   557	        if (
   558	            new_variable_colours == variable_colours
   559	            and new_equation_colours == equation_colours
   560	        ):
   561	            break
   562	        variable_colours = new_variable_colours
   563	        equation_colours = new_equation_colours
   564	
   565	    canonical_equations = tuple(
   566	        sorted(
   567	            (rhs, tuple(sorted(variable_colours[index] for index in indices)))
   568	            for indices, rhs in equations
   569	        )
   570	    )
   571	    payload = (
   572	        n,
   573	        inst["tag_bits"],
   574	        tuple(sorted(variable_colours)),
   575	        canonical_equations,
   576	        inst["constant_false_trees"],
   577	        inst["l0_budget"],
   578	        inst["target_label"],
   579	    )
   580	    raw = repr(payload).encode("ascii")
   581	    return hashlib.sha256(raw).hexdigest()
   582	
