+        ),
+        "shipping_density": {
+            "method": "structure-aware uniform sampling from all n-bit inputs",
+            "hits": guess_hits,
+            "samples": _GUESS_SAMPLES,
+            "observed_fraction": guess_hits / _GUESS_SAMPLES,
+            "exact_solution_count_by_rank": 1 << shipping["tag_bits"],
+            "exact_fraction": f"2^{shipping['tag_bits'] - shipping['n']}",
+        },
+        "small_preset_exact_count": {
+            "preset": "demo",
+            "n": demo["n"],
+            "valid_answers": demo_count,
+            "candidate_space": search_space(demo),
+        },
+        "strongest_failing_attack": {
+            "name": strongest_name,
