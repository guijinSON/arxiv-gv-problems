+    carried_bits = [0] * n
+    for v in range(n):
+        carried_bits[perm[v]] = old[v] ^ flips[v]
+    carried = _candidate(carried_bits)
+    changed = dict(inst)
+    changed["equations"] = equations
+    changed["answer"] = carried
+    return changed, carried
