+            "samples": total,
+            "observed_fraction": hits / total,
+            "exact_solution_count_from_full_rank": 1,
+            "search_space": search_space(inst),
+        },
+        "shipping_baseline_cost": {
+            "name": "GF(2) Gauss-Jordan elimination",
