+    else:
+        swapped = list(answer)
+        swapped[0], swapped[unequal] = swapped[unequal], swapped[0]
+        swapped = "".join(swapped)
+    return {
+        "drop_one": answer[:-1],
+        "swap_one": swapped,
+        "duplicate": answer + answer[0],
+        "empty": "",
+        "out_of_range": "2" + answer[1:],
