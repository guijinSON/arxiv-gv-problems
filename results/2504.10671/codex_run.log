+    if inconsistent or rank < n:
+        return None, {
+            "rank": rank, "row_xors": row_xors, "row_swaps": swaps,
+            "field_operations": row_xors * (n + 1), "inconsistent": inconsistent,
+        }
+    answer = [0] * n
+    for r, col in enumerate(pivots):
+        answer[col] = (rows[r] >> n) & 1
+    return "".join(map(str, answer)), {
