    "objects": [
        "oriented graph",
        "initial and target independent vertex sets",
        "exact move bound",
    ],
    "intuition": "phase invariants expose a hidden Boolean consistency constraint",
    "reduction": None,
}


CERTIFICATE_LANGUAGE = {
