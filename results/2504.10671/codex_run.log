+def enumerate_all(inst: dict) -> int | None:
+    if inst["n"] > 22:
+        return None
+    count = 0
+    for bits in itertools.product((0, 1), repeat=inst["n"]):
+        candidate = "".join(map(str, bits))
+        if verify(inst, candidate)[0]:
+            count += 1
+    return count
