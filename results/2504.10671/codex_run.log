+def escalate(params: dict) -> dict | str | None:
+    """Grow shuffled recurrence families while keeping the 97-bit answer fixed."""
+
+    n = int(params.get("n", 97))
+    cycles = int(params.get("cycles", 5))
+    if n < 97:
