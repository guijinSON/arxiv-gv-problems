+        "n": inst["n"],
+        "m": len(inst["equations"]),
+        "degree_multiset": sorted(degrees),
+        "pair_multiplicities": sorted(w for _, _, w in edges),
+        "traces": _closed_walk_traces(inst["n"], edges),
