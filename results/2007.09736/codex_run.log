+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>",
+                        re.IGNORECASE | re.DOTALL)
+_INT_LIST_RE = re.compile(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*")
