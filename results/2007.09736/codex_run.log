+    fraction = solutions / naive if solutions is not None else None
+    report["G5_sparse"] = {
+        "pass": solutions is not None and fraction < 0.01,
+        "instance": {"n": 2, "q": 4, "seed": 7},
+        "solutions": solutions,
+        "search_space": naive,
+        "solution_fraction": fraction,
