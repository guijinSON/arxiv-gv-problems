%--------------------------
\section{The equation $F_{1,t}(x,y)=1$}
%--------------------------

The equation
\begin{equation} \label{five-one}
F_{1,t}(x,y)=x^3-(t+1)x^2y+txy^2+y^3=1,
\end{equation}
has integer solutions
\begin{equation} \label{sol-five-1}
(x,y)=(1,0), (1,1), (1,-t-1), (0,1), (t,1),
\end{equation}
and hence at least $5$ distinct integer solutions, provided $t \not\in \{ -2, -1, 0, 1 \}$. Notice, further that $F_{1,-t}(x,y)=F_{1,t-1}(y,x)$, so that it suffices to consider equation (\ref{five-one}) for $t \geq 0$. Further still, since the discriminant of $F_{1,t}$ is given by
$$
D_{F_{1,t}}  =t^4 +2t^3 -5t^2 -6t-23,
$$
in order to restrict to forms of positive discriminant, we may suppose that $t \geq 3$. 
We have the following theorem
\begin{theorem} \label{miggy} (Mignotte)
If $t \geq 3$ is an integer, then equation (\ref{five-one}) has precisely the solutions given in (\ref{sol-five-1}), unless $t=3$ or $t=4$, where we find the additional solutions $(x,y)=(-14,-5)$, $(-3,-2)$, $(-2,-1)$ and $(13,9)$, and $(x,y)=(9,7)$, respectively.
\end{theorem}

%--------------------------
\section{The equation $F_{2,t}(x,y)=1$}
%--------------------------


We next consider   equation (\ref{five-2}), with solutions
\begin{equation} \label{sol-five-2}
(x,y)=(0,1), (1,0), (1,t^2), (t,1), (-t,1),
\end{equation}
and associated discriminant $D_{F_{2,t}} = 4t^6-27$. For $t \geq 2$, there are thus three real roots to the equation $F_{2,t}(x,1)=0$, say $\theta_1 <  \theta_2 < \theta_3$. It is readily observed that the only solutions to (\ref{five-2}) with $\min \{ |x|, |y| \} \leq 1$ are as given in (\ref{sol-five-2}). We will thus assume that $\min \{ |x|, |y| \} \geq 2$ (and, say, that $t \geq 10$). Under these hypotheses, we may slightly sharpen Lemma 1 of Wakabayashi \cite{Wa5}, proving
\begin{equation} \label{lump}
\theta_1 = -t - \frac{1}{2 t^2} +\frac{\alpha_1}{t^5}, \; \theta_2 = \frac{1}{t^2}+\frac{1}{t^8}+ \frac{\alpha_2}{t^{14}} \; \mbox{ and } \; \theta_3 = t - \frac{1}{2t^2} - \frac{\alpha_3}{t^5},
\end{equation}
where $\alpha_1 \in (0.374,0.375)$, $\alpha_2 \in ( 3, 3.01)$ and $\alpha_3 \in (0.375,0.376)$.

Suppose here and henceforth that $(x,y)$ is a solution to the equation (\ref{five-2}). It follows that, for each $i \in \{ 1, 2, 3\}$, $x- y \theta_i$ is a unit in $\mathbb{Q}(\theta_i)$  
and hence, since Lemma 4.11 of \cite{Th93} implies that $t-\theta_i$ and $\theta_i$ form a pair of fundamental units in $\mathbb{Q}(\theta_i)$, we may write 
\begin{equation}\label{unit-2}
{x - y \theta_i = (-1)^\delta (t - \theta_i)^n \theta_i^{-m} \ \ \text{for} \ m,n \in \mathbb{Z}}, \; \delta \in \{ 0, 1 \}.
\end{equation}
In particular, this implies that
so that $n = m_1-m$ and $n_1=m-m_1$. From Lemma 5.1 of \cite{Wa5}, we have that $n_1 > m_1 > 0$ and so $n<0, m > 0$ and $|n| < m$.


 
