+        "distinct_reasons": len(set(reasons)),
+    }
+
+    b, i = answer["blocker"]
+    p, q = answer["side"]
+    response = (
+        "The affine crossing identifies this boundary point.\n```text\n"
+        f"<answer>{b}, {i}, {p}/{q}</answer>\n```\n"
