+_ANSWER_RE = re.compile(
+    r"<answer>\s*([+-]?\d+)\s*,\s*([+-]?\d+)\s*,\s*"
+    r"([+-]?\d+)\s*/\s*([+-]?\d+)\s*</answer>",
