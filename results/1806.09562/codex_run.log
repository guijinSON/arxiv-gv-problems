+def _nearest_indices_to_fraction(numerator, denominator, length):
+    floor_value = numerator // denominator
+    return sorted(
+        {
+            max(0, min(length - 1, floor_value + shift))
+            for shift in (-1, 0, 1, 2)
+        }
+    )
