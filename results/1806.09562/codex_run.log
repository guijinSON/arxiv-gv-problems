+            "batch_count": inst["batch_count"],
+            "points_per_batch": inst["points_per_batch"],
+            "denominator": inst["denominator"],
+            "batches": batches,
+            "swap_xy": inst["swap_xy"] ^ bool(mask & 4),
+            "answer": {
+                "blocker": [new_b, new_i],
