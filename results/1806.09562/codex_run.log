+def parse_answer(text):
+    """Parse tagged output amid prose or Markdown; return None on garbage."""
+    if not isinstance(text, str):
+        return None
+    matches = list(_ANSWER_RE.finditer(text))
+    if len(matches) != 1:
+        return None
