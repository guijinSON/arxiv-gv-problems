--- /dev/null
+++ b/selftest_report.json
@@ -0,0 +1,158 @@
+{
+  "G1_planted_verifies": {
+    "attempts": 9,
+    "failures": [],
+    "pass": true
+  },
+  "G2_rejects_corruption": {
+    "cases": {
+      "drop": {
+        "reason": "missing side",
+        "rejected": true
+      },
+      "duplicate": {
