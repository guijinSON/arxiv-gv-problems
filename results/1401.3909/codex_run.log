def parse_answer(text: str) -> object | None:
    """Extract the last tagged JSON answer; never raise on malformed output."""

    if not isinstance(text, str):
        return None
    matches = _ANSWER_RE.findall(text)
    if not matches:
        return None
    payload = matches[-1].strip()
    if payload.startswith("```") and payload.endswith("```"):
        lines = payload.splitlines()
        if len(lines) >= 2:
            payload = "\n".join(lines[1:-1]).strip()
    try:
        answer = json.loads(payload)
    except (TypeError, ValueError):
        return None
    if not isinstance(answer, list):
        return None
    return answer


def _candidate_groups(inst: dict, answer: object) -> tuple[list[list[int]] | None, str]:
    if not isinstance(answer, list):
        return None, "answer must be a JSON array"
    if not answer:
        return None, "answer is empty"
    if len(answer) != 2:
        return None, "coefficient vector must have exactly two entries"
    if any(isinstance(value, bool) or not isinstance(value, int) for value in answer):
        return None, "coefficients must be integers"
    prime = inst["prime"]
    if any(value < 0 or value >= prime for value in answer):
        return None, "coefficient is outside the field range"
    if answer[0] == answer[1]:
        return None, "the two coefficients must be distinct"

    a, b = answer
    buckets: dict[int, list[int]] = {}
    for team, (u, v) in enumerate(inst["tags"]):
        key = (a * u + b * v) % prime
        buckets.setdefault(key, []).append(team)
    if len(buckets) != inst["m"] or any(len(row) != 3 for row in buckets.values()):
        return None, "coefficient fibers are not all triples"
    return _canonical_partition(list(buckets.values())), "ok"


def _schedule_from_groups(n: int, y_groups: list[list[int]]) -> list[list[tuple[int, bool]]]:
    """Expand the Section-5 Latin triplet blocks.

    Entries are (opponent_global_id, is_home).  X IDs are 0..n-1 and Y IDs
    are n..2n-1.
    """

    m = n // 3
    x_groups = [[3 * g, 3 * g + 1, 3 * g + 2] for g in range(m)]
    schedule: list[list[tuple[int, bool] | None]] = [
        [None] * (2 * n) for _ in range(2 * n)
    ]
    for r in range(m):
        blocks = ((2 * r, r % m, True), (2 * r + 1, (r + 2) % m, False))
        for block, shift, x_home in blocks:
            for g in range(m):
                h = (g + shift) % m
                for subslot in range(3):
                    slot = 3 * block + subslot
                    for member in range(3):
                        x_team = x_groups[g][member]
                        y_team = y_groups[h][(member + subslot) % 3]
                        schedule[x_team][slot] = (n + y_team, x_home)
                        schedule[n + y_team][slot] = (x_team, not x_home)
    return [[entry for entry in row if entry is not None] for row in schedule]


def _check_schedule(n: int, schedule: list[list[tuple[int, bool]]]) -> tuple[bool, str]:
    if len(schedule) != 2 * n or any(len(row) != 2 * n for row in schedule):
        return False, "expanded schedule has the wrong shape"

    for team, row in enumerate(schedule):
        run = 1
        for slot, (opponent, is_home) in enumerate(row):
            if not 0 <= opponent < 2 * n or (team < n) == (opponent < n):
                return False, "expanded schedule has an invalid opponent"
            other_opponent, other_home = schedule[opponent][slot]
            if other_opponent != team or other_home == is_home:
                return False, "expanded match entries are inconsistent"
            if slot:
                if row[slot - 1][0] == opponent:
                    return False, "expanded schedule violates no-repeat"
                if row[slot - 1][1] == is_home:
                    run += 1
                    if run > 3:
                        return False, "expanded schedule violates at-most-three"
                else:
                    run = 1

    for x_team in range(n):
        counts: dict[tuple[int, bool], int] = {}
        for opponent, is_home in schedule[x_team]:
            key = (opponent - n, is_home)
            counts[key] = counts.get(key, 0) + 1
        if len(counts) != 2 * n or any(value != 1 for value in counts.values()):
            return False, "expanded schedule violates each-venue"

    for slot in range(2 * n):
        x_status = {schedule[x][slot][1] for x in range(n)}
        if len(x_status) != 1:
            return False, "expanded schedule is not uniform"
    return True, "ok"


def _travel_cost(inst: dict, groups: list[list[int]]) -> int:
    matrix = inst["distance"]
    perimeter_sum = 0
    for i, j, k in groups:
        perimeter_sum += matrix[i][j] + matrix[j][k] + matrix[k][i]
    return inst["fixed_cost"] + inst["perimeter_multiplier"] * perimeter_sum


def verify(inst: dict, answer: object) -> tuple[bool, str]:
    """Expand and check any valid symbolic witness; never inspect inst['answer']."""

    groups, reason = _candidate_groups(inst, answer)
    if groups is None:
        return False, reason
    schedule = _schedule_from_groups(inst["n"], groups)
    schedule_ok, schedule_reason = _check_schedule(inst["n"], schedule)
    if not schedule_ok:
        return False, schedule_reason
    cost = _travel_cost(inst, groups)
    if cost > inst["target"]:
        return False, f"travel {cost} exceeds target {inst['target']}"
    return True, "ok"


def _fast_valid(inst: dict, answer: object) -> bool:
    groups, _reason = _candidate_groups(inst, answer)
    return groups is not None and _travel_cost(inst, groups) <= inst["target"]


def random_candidate(inst: dict, rng: random.Random) -> object:
    """Uniformly sample the stated language of distinct field coefficients."""

    prime = inst["prime"]
    a = rng.randrange(prime)
    b_index = rng.randrange(prime - 1)
    b = b_index if b_index < a else b_index + 1
    return [a, b]


def search_space(inst: dict) -> int | None:
    prime = inst["prime"]
    return prime * (prime - 1)


def enumerate_all(inst: dict) -> int | None:
    """Brute-force the certificate language only when explicitly capped."""

    if search_space(inst) > _ENUMERATION_CAP:
        return None
    total = 0
    for a in range(inst["prime"]):
        for b in range(inst["prime"]):
            if a != b:
                total += int(_fast_valid(inst, [a, b]))
    return total


def canonical_key(inst: dict) -> str:
    """A strong cheap weighted-metric invariant, independent of team labels.

    Full weighted-graph isomorphism is not attempted.  Sorted row multisets are
    invariant under all tested team permutations and under invertible changes
    of the public tag-coordinate basis; random tree weights provide diversity.
    """

    row_profiles = sorted(tuple(sorted(row)) for row in inst["distance"])
    payload = {
        "n": inst["n"],
        "prime": inst["prime"],
        "fixed_cost": inst["fixed_cost"],
        "multiplier": inst["perimeter_multiplier"],
        "target": inst["target"],
        "rows": row_profiles,
    }
    blob = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
    return hashlib.sha256(blob).hexdigest()


def escalate(params: dict) -> dict | str | None:
    """Enlarge coefficient entropy at fixed two-integer answer length."""

    harder = dict(params)
    current = int(harder.get("prime", 50_000_017))
    if current >= 8_000_000_000:
        return "cap_bound"
    harder["prime"] = _next_prime(2 * current + 1)
    harder["weight_scale"] = min(
        1_000_000, max(1, int(harder.get("weight_scale", 64)) * 2)
    )
    return harder


def _structural_decode(inst: dict) -> list[int] | None:
    sum_u = sum(tag[0] for tag in inst["tags"]) % inst["prime"]
    sum_v = sum(tag[1] for tag in inst["tags"]) % inst["prime"]
    candidate = [sum_v, (-sum_u) % inst["prime"]]
    return candidate if _fast_valid(inst, candidate) else None


def _intended_operation_bound(inst: dict) -> int:
    # Two running sums (2n additions), two modular reductions, one negation.
    return 2 * inst["n"] + 3


def _normal_from_pair(inst: dict, i: int, j: int) -> list[int]:
    prime = inst["prime"]
    u0, v0 = inst["tags"][i]
    u1, v1 = inst["tags"][j]
    return [(v1 - v0) % prime, (u0 - u1) % prime]


def _reference_profile_scan(inst: dict) -> tuple[list[int] | None, dict[str, int]]:
    """Recover tree clusters by exhaustive constant row-difference tests."""

    n = inst["n"]
    matrix = inst["distance"]
    neighbours = [set() for _ in range(n)]
    operations = 0
    pair_tests = 0
    for i in range(n):
        for j in range(i + 1, n):
            pair_tests += 1
            deltas = set()
            for k in range(n):
                if k != i and k != j:
                    deltas.add(matrix[i][k] - matrix[j][k])
                    operations += 1
            if len(deltas) == 1:
                neighbours[i].add(j)
                neighbours[j].add(i)

    unseen = set(range(n))
    groups: list[list[int]] = []
    while unseen:
        root = min(unseen)
        group = {root} | neighbours[root]
        if len(group) != 3:
            return None, {"operations": operations, "pair_tests": pair_tests}
        groups.append(sorted(group))
        unseen -= group
    candidate = _normal_from_pair(inst, groups[0][0], groups[0][1])
    return candidate, {"operations": operations, "pair_tests": pair_tests}


def _attack_candidates(inst: dict, rng: random.Random) -> dict[str, object]:
    n = inst["n"]
    matrix = inst["distance"]
    row_sums = [sum(row) for row in matrix]
    closest_rows = min(
        ((abs(row_sums[i] - row_sums[j]), i, j)
         for i in range(n) for j in range(i + 1, n)),
        key=lambda item: item,
    )
    shortest = min(
        ((matrix[i][j], i, j)
         for i in range(n) for j in range(i + 1, n)),
        key=lambda item: item,
    )
    return {
        "outlier_closest_row_sums": _normal_from_pair(
            inst, closest_rows[1], closest_rows[2]
        ),
        "greedy_shortest_distance_edge": _normal_from_pair(
            inst, shortest[1], shortest[2]
        ),
        "by_hand_equal_tag_sum": [1, 1],
        "random_projective_256": [
            random_candidate(inst, rng) for _ in range(256)
        ],
    }


def _attack_succeeds(inst: dict, candidate: object) -> bool:
    if isinstance(candidate, list) and candidate and isinstance(candidate[0], list):
        return any(_fast_valid(inst, item) for item in candidate)
    return _fast_valid(inst, candidate)


def _permuted_instance(inst: dict, rng: random.Random) -> dict:
    permutation = list(range(inst["n"]))
    rng.shuffle(permutation)
    transformed = dict(inst)
    transformed["tags"] = [inst["tags"][old] for old in permutation]
    transformed["distance"] = [
        [inst["distance"][old_i][old_j] for old_j in permutation]
        for old_i in permutation
    ]
    return transformed


def _swapped_tag_basis(inst: dict) -> tuple[dict, list[int]]:
    transformed = dict(inst)
    transformed["tags"] = [[v, u] for u, v in inst["tags"]]
    carried = [inst["answer"][1], inst["answer"][0]]
    return transformed, carried


def _atom_count(value: object) -> int:
    if isinstance(value, dict):
        return sum(_atom_count(item) for item in value.values())
    if isinstance(value, (list, tuple)):
        return sum(_atom_count(item) for item in value)
    return 1


def selftest() -> dict:
    """Run G1--G9 and return a JSON-native report with measured costs."""

    report: dict[str, Any] = {
        "track": TRACK,
        "shipping_difficulty": SHIPPING_DIFFICULTY,
    }

    g1_failures: list[str] = []
    g1_attempts = 0
    for preset, params in DIFFICULTY.items():
        for seed in range(5):
            inst = make_instance(seed=seed, **params)
            ok, reason = verify(inst, inst["answer"])
            g1_attempts += 1
            if not ok:
                g1_failures.append(f"{preset}/{seed}: {reason}")
            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
                g1_failures.append(f"{preset}/{seed}: answer is not JSON-native")
    report["G1_planted_verifies"] = {
        "pass": not g1_failures,
        "attempts": g1_attempts,
        "failures": g1_failures,
    }

    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
    ship = make_instance(seed=314159, **shipping_params)
    planted = list(ship["answer"])
    corruptions = {
        "drop_one": planted[:-1],
        "swap_one": [planted[1], planted[0]],
        "duplicate_one": [planted[0], planted[0]],
        "empty": [],
        "out_of_range": [planted[0], ship["prime"]],
    }
    cases: dict[str, dict[str, Any]] = {}
    reasons: list[str] = []
    for name, candidate in corruptions.items():
        ok, reason = verify(ship, candidate)
        cases[name] = {"rejected": not ok, "reason": reason}
        reasons.append(reason)
    report["G2_rejects_corruption"] = {
        "pass": all(row["rejected"] for row in cases.values())
        and len(set(reasons)) == len(reasons),
        "distinct_reasons": len(set(reasons)),
        "cases": cases,
    }

    model_style = (
        "The modular fibers and exact travel sum check out.\n```json\n"
        f"<answer>{json.dumps(planted)}</answer>\n```\n"
        "This is the coefficient vector."
    )
    parsed = parse_answer(model_style)
    report["G3_round_trip"] = {
        "pass": parsed == planted and parse_answer("no tagged answer") is None,
        "parsed": parsed,
    }

    samples = 250_000
    sample_rng = random.Random(8_675_309)
    hits = 0
    for _ in range(samples):
        hits += int(_fast_valid(ship, random_candidate(ship, sample_rng)))
    observed = hits / samples
    exact_density = 1.0 / ship["prime"]
    report["G4_guess_resistance"] = {
        "pass": observed < 1e-6 and exact_density < 1e-6,
        "hits": hits,
        "total": samples,
        "observed_probability": observed,
        "exact_probability_by_construction": exact_density,
        "candidate_space": search_space(ship),
        "exact_valid_certificates": ship["prime"] - 1,
        "sampler": "uniform distinct coefficient pairs in GF(p)^2",
    }

    demo = make_instance(seed=0, **DIFFICULTY["demo"])
    demo_count = enumerate_all(demo)
    attack_names = [
        "outlier_closest_row_sums",
        "greedy_shortest_distance_edge",
        "by_hand_equal_tag_sum",
        "random_projective_256",
    ]
    attack_results = {
        name: {"successes": 0, "attempts": 8} for name in attack_names
    }
    reference_successes = 0
    reference_times: list[float] = []
    reference_operations: list[int] = []
    reference_pair_tests: list[int] = []
    for seed in range(8):
        trial = make_instance(seed=12_000 + seed, **shipping_params)
        candidates = _attack_candidates(trial, random.Random(700_000 + seed))
        for name in attack_names:
            attack_results[name]["successes"] += int(
                _attack_succeeds(trial, candidates[name])
            )
        started = time.perf_counter()
        reference_answer, counts = _reference_profile_scan(trial)
        elapsed = time.perf_counter() - started
        reference_times.append(elapsed)
        reference_operations.append(counts["operations"])
        reference_pair_tests.append(counts["pair_tests"])
        reference_successes += int(
            reference_answer is not None and verify(trial, reference_answer)[0]
        )

    reference = {
        "name": "complete constant distance-profile difference scan",
        "paper_location": (
            "Section 5 triplet packing; structure-specific exact metric scan"
        ),
        "complexity": "O(n^3) exact integer subtractions and O(n^2) storage",
        "wall_clock_sec_mean": sum(reference_times) / len(reference_times),
        "wall_clock_sec_max": max(reference_times),
        "operations_mean": sum(reference_operations) / len(reference_operations),
        "operations_max": max(reference_operations),
        "pair_tests_mean": sum(reference_pair_tests) / len(reference_pair_tests),
        "solves": f"{reference_successes}/8, as expected",
    }
    all_attacks_failed = all(
        row["successes"] == 0 and row["attempts"] >= 8
        for row in attack_results.values()
    )
    report["G5_density_and_baseline"] = {
        "pass": exact_density < 1e-6
        and demo_count == demo["prime"] - 1
        and reference_successes == 8
        and reference["operations_mean"] >= 100_000,
        "shipping_density_hits": hits,
        "shipping_density_total": samples,
        "shipping_observed_fraction": observed,
        "shipping_exact_fraction_by_construction": exact_density,
        "shipping_structure_aware_space": search_space(ship),
        "shipping_exact_valid_certificates": ship["prime"] - 1,
        "demo_valid_solution_count": demo_count,
        "demo_candidate_space": search_space(demo),
        "baseline_wall_clock_sec_mean": reference["wall_clock_sec_mean"],
        "baseline_wall_clock_sec_max": reference["wall_clock_sec_max"],
        "baseline_operations_mean": reference["operations_mean"],
        "baseline_operations_max": reference["operations_max"],
    }
    report["G6_adversary_panel"] = {
        "pass": all_attacks_failed and reference_successes == 8,
        "attacks": attack_results,
        "reference_algorithm": reference,
    }

    doubled_params = dict(shipping_params)
    doubled_params["n"] = 2 * doubled_params["n"]
    doubled = make_instance(seed=314159, **doubled_params)
    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
    shipping_scan = math.comb(ship["n"], 2) * (ship["n"] - 2)
    doubled_scan = math.comb(doubled["n"], 2) * (doubled["n"] - 2)
    report["G7_scales"] = {
        "pass": doubled_ok
        and doubled_scan > shipping_scan
        and _atom_count(doubled["answer"]) == _atom_count(ship["answer"]),
        "shipping_n": ship["n"],
        "doubled_n": doubled["n"],
        "shipping_reference_operations": shipping_scan,
        "doubled_reference_operations": doubled_scan,
        "doubled_verify_reason": doubled_reason,
        "answer_elements_shipping": _atom_count(ship["answer"]),
        "answer_elements_doubled": _atom_count(doubled["answer"]),
    }

    invariant_checks = 0
    real_transform_checks = 0
    basis_checks = 0
    composed_checks = 0
    unrelated_keys: list[str] = []
    g8_failures: list[str] = []
    for seed in range(20):
        trial = make_instance(seed=20_000 + seed, **DIFFICULTY["medium"])
        key = canonical_key(trial)
        unrelated_keys.append(key)

        permuted = _permuted_instance(trial, random.Random(30_000 + seed))
        if canonical_key(permuted) == key:
            invariant_checks += 1
        else:
            g8_failures.append(f"team permutation changed key at seed {seed}")
        if verify(permuted, trial["answer"])[0]:
            real_transform_checks += 1
        else:
            g8_failures.append(f"team permutation rejected witness at seed {seed}")

        swapped, carried = _swapped_tag_basis(trial)
        if canonical_key(swapped) == key and verify(swapped, carried)[0]:
            basis_checks += 1
        else:
            g8_failures.append(f"tag-basis swap failed at seed {seed}")

        composed_source = _permuted_instance(
            trial, random.Random(40_000 + seed)
        )
        composed, composed_carried = _swapped_tag_basis(composed_source)
        if canonical_key(composed) == key and verify(composed, composed_carried)[0]:
            composed_checks += 1
        else:
            g8_failures.append(f"composed relabel/basis map failed at seed {seed}")

    distinct = len(set(unrelated_keys))
    report["G8_canonical_key"] = {
        "pass": not g8_failures and distinct == 20,
        "invariance_checks": invariant_checks,
        "real_transformation_checks": real_transform_checks,
        "basis_change_checks": basis_checks,
        "composed_transformation_checks": composed_checks,
        "unrelated_distinct": distinct,
        "unrelated_attempts": 20,
        "transformations": [
            "Y-team permutation with the same symbolic witness",
            "swap of the two GF(p) tag coordinates with carried coefficients",
            "composition of team permutation and tag-basis swap",
        ],
        "key_limit": (
            "sorted weighted-row profiles; full weighted-graph canonization "
            "is not attempted"
        ),
        "failures": g8_failures,
    }

    answer_blob = json.dumps(ship["answer"], separators=(",", ":"))
    answer_chars = len(answer_blob)
    answer_tokens = (answer_chars + 3) // 4
    arms = {
        name: {
            "solved": int(G9_MEASUREMENTS[name]["solved"]),
            "attempts": int(G9_MEASUREMENTS[name]["attempts"]),
        }
        for name in ("bare", "hinted", "placebo")
    }
    hinted_rate = (
        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
        if arms["hinted"]["attempts"] else None
    )
    placebo_rate = (
        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
        if arms["placebo"]["attempts"] else None
    )
    compact_answer = _structural_decode(ship)
    intended_operations = _intended_operation_bound(ship)
    within_caps = (
        answer_chars <= 2_000
        and _atom_count(ship["answer"]) <= 256
        and intended_operations <= 300
        and compact_answer is not None
        and verify(ship, compact_answer)[0]
    )
    report["G9_no_tool_suitability"] = {
        "pass": within_caps,
        "arms": arms,
        "hinted_minus_placebo": (
            hinted_rate - placebo_rate
            if hinted_rate is not None and placebo_rate is not None
            else None
        ),
        "hinted_verdict": G9_MEASUREMENTS["hinted_verdict"],
        "answer_chars": answer_chars,
        "answer_tokens": answer_tokens,
        "answer_elements": _atom_count(ship["answer"]),
        "intended_route_operations": intended_operations,
        "compact_route_verifies": compact_answer is not None
        and verify(ship, compact_answer)[0],
    }

    report["certificate_language"] = CERTIFICATE_LANGUAGE
    report["problem_profile"] = PROBLEM_PROFILE
    gates = [name for name in report if name.startswith("G")]
    report["all_passed"] = all(bool(report[name].get("pass")) for name in gates)
    return report


if __name__ == "__main__":
    print(json.dumps(selftest(), indent=2, sort_keys=True))

