+    matrix = inst["distance"]
+    remaining = set(range(inst["n"]))
+    plan: list[list[int]] = []
+    while remaining:
+        ordered = sorted(remaining)
+        _length, a, b = min(
+            (matrix[i + 1][j + 1], i, j)
+            for pos, i in enumerate(ordered)
+            for j in ordered[pos + 1:]
+        )
+        c = min(
+            remaining - {a, b},
+            key=lambda team: min(
+                matrix[0][a + 1]
+                + matrix[a + 1][b + 1]
+                + matrix[b + 1][team + 1]
+                + matrix[team + 1][0],
+                matrix[0][a + 1]
+                + matrix[a + 1][team + 1]
+                + matrix[team + 1][b + 1]
+                + matrix[b + 1][0],
+            ),
+        )
+        plan.append([a, b, c])
+        remaining -= {a, b, c}
+    return _canonical_plan(plan)
 
 
