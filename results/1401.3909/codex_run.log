-def _is_prime(value: int) -> bool:
-    if value < 2:
-        return False
-    if value % 2 == 0:
-        return value == 2
-    limit = math.isqrt(value)
-    factor = 3
-    while factor <= limit:
-        if value % factor == 0:
-            return False
-        factor += 2
-    return True
-
-
-def _next_prime(value: int) -> int:
-    candidate = max(3, value | 1)
-    while not _is_prime(candidate):
-        candidate += 2
-    return candidate
-
-
-def _validate_params(n: int, prime: int, weight_scale: int) -> None:
-    values = (n, prime, weight_scale)
-    if any(isinstance(v, bool) or not isinstance(v, int) for v in values):
-        raise ValueError("n, prime, and weight_scale must be integers")
-    if n < 6 or n % 3:
-        raise ValueError("n must be a multiple of 3 and at least 6")
-    if prime <= n // 3 + 3 or not _is_prime(prime):
-        raise ValueError("prime must be prime and exceed n/3+3")
-    if not 1 <= weight_scale <= 1_000_000:
-        raise ValueError("weight_scale must lie in [1,1000000]")
-
-
-def _sample_fiber_values(m: int, prime: int, rng: random.Random) -> list[int]:
-    """Distinct nonzero residues summing to zero, sampled without solving."""
-
-    for _ in range(10_000):
-        first = rng.sample(range(1, prime), m - 1)
-        last = (-sum(first)) % prime
-        if last and last not in first:
-            return first + [last]
-    raise RuntimeError("could not sample distinct zero-sum fiber values")
-
-
-def _canonical_partition(groups: list[list[int]]) -> list[list[int]]:
-    return sorted((sorted(group) for group in groups), key=lambda row: tuple(row))
-
-
-def make_instance(n: int, seed: int = 0, *, prime: int = 50_000_017,
-                  weight_scale: int = 64) -> dict:
-    """Inverse-generate a compactly certified uniform BTTP road-trip plan."""
-
-    _validate_params(n, prime, weight_scale)
-    rng = random.Random(seed)
-    m = n // 3
-
-    # G: sample the witness before any venue tags or distances exist.
-    while True:
-        a = rng.randrange(1, prime)
-        b = rng.randrange(1, prime)
-        if a != b and (a + b) % prime != 0:
-            break
-    answer = [a, b]
-    b_inverse = pow(b, prime - 2, prime)
-
-    # Resample only construction pieces until the compact sum invariant is
-    # nonzero.  The previously selected witness never changes.
-    for _ in range(1_000):
-        fiber_values = _sample_fiber_values(m, prime, rng)
-        records: list[tuple[int, int, int]] = []
-        used_tags: set[tuple[int, int]] = set()
-        valid = True
-        for group, value in enumerate(fiber_values):
-            group_tags: list[tuple[int, int]] = []
-            attempts = 0
-            while len(group_tags) < 3 and attempts < 1_000:
-                attempts += 1
-                u = rng.randrange(prime)
-                v = ((value - a * u) * b_inverse) % prime
-                tag = (u, v)
-                if tag not in used_tags:
-                    used_tags.add(tag)
-                    group_tags.append(tag)
-            if len(group_tags) != 3:
-                valid = False
-                break
-            records.extend((u, v, group) for u, v in group_tags)
-        if not valid:
-            continue
-        sum_u = sum(row[0] for row in records) % prime
-        sum_v = sum(row[1] for row in records) % prime
-        if sum_u or sum_v:
-            break
-    else:
-        raise RuntimeError("could not realize the nonzero global-sum invariant")
-
-    # The identity follows from three points per fiber and sum(fiber_values)=0.
-    assert (a * sum_u + b * sum_v) % prime == 0
-
-    rng.shuffle(records)
-    tags = [[u, v] for u, v, _group in records]
-    hidden_group = [group for _u, _v, group in records]
-
-    center_weight = [
-        weight_scale * rng.randrange(700, 5_001) + rng.randrange(weight_scale)
-        for _ in range(m)
-    ]
-    # Every center gets one pendant in each of three interleaved rank bands.
-    # Consecutive ranks therefore belong to different centers.  The large rank
-    # gap dominates every center-edge perturbation, so both the shortest edge
-    # and the closest pair of row sums join different centers.  The group order
-    # is shuffled and the same exchangeable recipe is used in every band.
-    leaf_weight = [0] * n
-    members_by_group = [[] for _ in range(m)]
-    for team, group in enumerate(hidden_group):
-        members_by_group[group].append(team)
-    for members in members_by_group:
-        rng.shuffle(members)
-    group_order = list(range(m))
-    rng.shuffle(group_order)
-    rank_gap = 20_000 * weight_scale
-    for band in range(3):
-        for position, group in enumerate(group_order):
-            rank = band * m + position
-            team = members_by_group[group][band]
-            leaf_weight[team] = (
-                20_000 * weight_scale
-                + rank * rank_gap
-                + rng.randrange(max(1, 500 * weight_scale))
-            )
-
-    distance = [[0] * n for _ in range(n)]
-    for i in range(n):
-        for j in range(i + 1, n):
-            value = leaf_weight[i] + leaf_weight[j]
-            if hidden_group[i] != hidden_group[j]:
-                value += (
-                    center_weight[hidden_group[i]]
-                    + center_weight[hidden_group[j]]
-                )
-            distance[i][j] = value
-            distance[j][i] = value
-
-    true_groups = [[] for _ in range(m)]
-    for team, group in enumerate(hidden_group):
-        true_groups[group].append(team)
-    true_partition = _canonical_partition(true_groups)
-
-    # Complete the unshown side of the tree metric only to derive the exact
-    # candidate-independent contribution.  The rendered compressed instance
-    # supplies this aggregate, so verify never needs hidden construction data.
-    x_center = [
-        weight_scale * rng.randrange(800, 5_501) + rng.randrange(weight_scale)
-        for _ in range(m)
-    ]
-    x_leaf = [
-        weight_scale * rng.randrange(25_000, 1_100_001)
-        + rng.randrange(weight_scale)
-        for _ in range(n)
-    ]
-    sum_x_branch = sum(
-        x_leaf[i] + x_center[i // 3] for i in range(n)
-    )
-    sum_y_branch = sum(
-        leaf_weight[i] + center_weight[hidden_group[i]] for i in range(n)
-    )
-    x_perimeters = 0
-    for group in range(m):
-        i, j, k = 3 * group, 3 * group + 1, 3 * group + 2
-        x_perimeters += 2 * (x_leaf[i] + x_leaf[j] + x_leaf[k])
-
-    multiplier = 2 * m
-    fixed_cost = (
-        4 * m * (sum_x_branch + sum_y_branch)
-        + multiplier * x_perimeters
-    )
-    planted_perimeters = sum(
-        distance[i][j] + distance[j][k] + distance[k][i]
-        for i, j, k in true_partition
-    )
-    target = fixed_cost + multiplier * planted_perimeters
-
-    return {
-        "paper": "arXiv:1401.3909",
-        "n": n,
-        "m": m,
-        "prime": prime,
-        "weight_scale": weight_scale,
-        "tags": tags,
-        "distance": distance,
-        "fixed_cost": fixed_cost,
-        "perimeter_multiplier": multiplier,
-        "target": target,
-        "answer": answer,
-    }
-
-
-def _matrix_text(matrix: list[list[int]]) -> str:
-    lines = []
-    n = len(matrix)
-    for i in range(n - 1):
-        values = " ".join(str(matrix[i][j]) for j in range(i + 1, n))
-        lines.append(f"{i}: {values}")
-    lines.append(f"{n - 1}: (empty)")
-    return "\n".join(lines)
-
-
-def render(inst: dict) -> str:
-    """Render the complete self-contained problem and exact output contract."""
-
-    tag_lines = "\n".join(
-        f"{i}: {tag[0]} {tag[1]}" for i, tag in enumerate(inst["tags"])
-    )
-    statement = f"""Bipartite triplet-road scheduling (arXiv:1401.3909, Section 5)
-
-There are two leagues X and Y, each with n={inst['n']} teams, and m={inst['m']}.
-The X teams are already partitioned into consecutive triples.  You must give a
-compact rule that partitions the 0-indexed Y teams 0,...,{inst['n'] - 1} into
-triples.  The rule will be expanded into a uniform double round-robin schedule.
-
-Definitions.  A double round-robin bipartite schedule has 2n slots.  Every X-Y
-pair plays twice, once at each venue.  It is uniform when all X teams have the
-same home/away status in a slot.  No team may have more than three consecutive
-home games or away games (the at-most-three rule), and no team may face the same
-opponent in consecutive slots (the no-repeat rule).
-
-Expansion template.  Treat each Y triple as one road-trip unit.  For block
-r=0,...,m-1, pair X triple g with Y triple (g+r) mod m for an X-home block, then
-with Y triple (g+r+2) mod m for a Y-home block.  Each block has three slots and
-uses the cyclic 3-by-3 matching: member q of the X triple faces member (q+s)
-mod 3 of the Y triple in subslot s.  This deterministically gives 2n slots and
-the checker explicitly verifies all three constraints above.
-
-Each Y team i has a public tag (u_i,v_i) over GF(p), where p={inst['prime']}.
-For your two coefficients [a,b], define
-    K(i) = (a*u_i + b*v_i) mod p.
-Teams with equal K(i) form one Y road-trip unit.  Your coefficients must be
-distinct residues in 0,...,p-1, and the fibers of K must be exactly m triples.
-
-Tags, as `team: u v`:
-{tag_lines}
-
-The symmetric Y-venue distance matrix D has D(i,i)=0.  Its strict upper
-triangle is below: row i lists D(i,i+1), D(i,i+2), ..., D(i,n-1), in that order.
-All entries are exact nonnegative integers.
-{_matrix_text(inst['distance'])}
-
-For a fiber {{i,j,k}}, its perimeter is D(i,j)+D(j,k)+D(k,i).  For the expanded
-uniform schedule, all other travel contributes the exact fixed amount
-F={inst['fixed_cost']}, and the exact total travel is
-    F + {inst['perimeter_multiplier']} * (sum of all fiber perimeters).
-The total must be at most T={inst['target']} (inclusive).  Fiber order and the
-order of teams inside a fiber do not affect this total.
-
-Give your final answer inside <answer></answer> tags as one JSON array [a,b].
-Example syntax: <answer>[0, 1]</answer>
-Output nothing else inside the tags."""
-    mode = os.environ.get("GV_HINT_MODE")
-    if mode == "structural":
-        statement += "\n\nHint: " + STRUCTURAL_HINT
-    elif mode == "placebo":
-        statement += "\n\nHint: " + PLACEBO_HINT
-    return statement
-
-
-def parse_answer(text: str) -> object | None:
-    """Extract the last tagged JSON answer; never raise on malformed output."""
-
-    if not isinstance(text, str):
-        return None
-    matches = _ANSWER_RE.findall(text)
-    if not matches:
-        return None
-    payload = matches[-1].strip()
-    if payload.startswith("```") and payload.endswith("```"):
-        lines = payload.splitlines()
-        if len(lines) >= 2:
-            payload = "\n".join(lines[1:-1]).strip()
-    try:
-        answer = json.loads(payload)
-    except (TypeError, ValueError):
-        return None
-    if not isinstance(answer, list):
-        return None
-    return answer
-
-
-def _candidate_groups(inst: dict, answer: object) -> tuple[list[list[int]] | None, str]:
-    if not isinstance(answer, list):
-        return None, "answer must be a JSON array"
-    if not answer:
-        return None, "answer is empty"
-    if len(answer) != 2:
-        return None, "coefficient vector must have exactly two entries"
-    if any(isinstance(value, bool) or not isinstance(value, int) for value in answer):
-        return None, "coefficients must be integers"
-    prime = inst["prime"]
-    if any(value < 0 or value >= prime for value in answer):
-        return None, "coefficient is outside the field range"
-    if answer[0] == answer[1]:
-        return None, "the two coefficients must be distinct"
-
-    a, b = answer
-    buckets: dict[int, list[int]] = {}
-    for team, (u, v) in enumerate(inst["tags"]):
-        key = (a * u + b * v) % prime
-        buckets.setdefault(key, []).append(team)
-    if len(buckets) != inst["m"] or any(len(row) != 3 for row in buckets.values()):
-        return None, "coefficient fibers are not all triples"
-    return _canonical_partition(list(buckets.values())), "ok"
-
-
-def _schedule_from_groups(n: int, y_groups: list[list[int]]) -> list[list[tuple[int, bool]]]:
-    """Expand the Section-5 Latin triplet blocks.
-
-    Entries are (opponent_global_id, is_home).  X IDs are 0..n-1 and Y IDs
-    are n..2n-1.
-    """
-
-    m = n // 3
-    x_groups = [[3 * g, 3 * g + 1, 3 * g + 2] for g in range(m)]
-    schedule: list[list[tuple[int, bool] | None]] = [
-        [None] * (2 * n) for _ in range(2 * n)
-    ]
-    for r in range(m):
-        blocks = ((2 * r, r % m, True), (2 * r + 1, (r + 2) % m, False))
-        for block, shift, x_home in blocks:
-            for g in range(m):
-                h = (g + shift) % m
-                for subslot in range(3):
-                    slot = 3 * block + subslot
-                    for member in range(3):
-                        x_team = x_groups[g][member]
-                        y_team = y_groups[h][(member + subslot) % 3]
-                        schedule[x_team][slot] = (n + y_team, x_home)
