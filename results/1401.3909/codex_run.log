+def escalate(params: dict) -> dict | str | None:
+    """Enlarge coefficient entropy at fixed two-integer answer length."""
 
+    harder = dict(params)
+    current = int(harder.get("prime", 50_000_017))
+    if current >= 8_000_000_000:
+        return "cap_bound"
+    harder["prime"] = _next_prime(2 * current + 1)
+    harder["weight_scale"] = min(
+        1_000_000, max(1, int(harder.get("weight_scale", 64)) * 2)
+    )
+    return harder
 
