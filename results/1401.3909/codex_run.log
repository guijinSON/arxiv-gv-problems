+#!/usr/bin/env python3
+"""Verified rooted road-trip covers from arXiv:1401.3909.
+
+The paper identifies one team's individual travel lower bound with the weight
+of a rooted 4-cycle-cover: every cycle is a road trip of at most three away
+games.  This module inverse-generates a metric and a minimum cover.  It samples
+the affine relabellings first and uses the rearrangement inequality to know the
+cover without running the assignment algorithm used as the Track-B baseline.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "optimization",
+    "object_regime": "finite_discrete",
+    "computational_core": "permutation",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "metric distance function on a home venue and opponent venues",
+        "rooted 4-cycle-cover of three-game road trips",
+    ],
+    "verification_operations": [
+        "exact modular rank evaluation",
+        "exact integer travel-distance addition",
+        "permutation and cycle-cover checks",
+        "integer threshold comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Each polynomial feature is centered over its venue class and all "
+        "features share one hidden affine order, so the rearrangement invariant "
+        "selects the opposite order; without recognizing it one must solve two "
+        "dense assignment problems."
+    ),
+    "hardness_basis": (
+        "Track B: Section 5 computes individual lower bounds by rooted "
+        "4-cycle-cover enumeration (340,540,200 cases at n=15); for this "
+        "shipping specialization two Hungarian assignments run in O(n^3), "
+        "with measured cost recorded by selftest at n=79, while cancellation "
+        "plus affine recurrences needs 196 exact operations and no tool."
+    ),
+    "max_answer_tokens": 230,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+DIFFICULTY = {
+    "demo": {"n": 5, "decoy_terms": 0, "coefficient_span": 9},
