+def _schedule_from_groups(n: int, y_groups: list[list[int]]) -> list[list[tuple[int, bool]]]:
+    """Expand the Section-5 Latin triplet blocks.
+
+    Entries are (opponent_global_id, is_home).  X IDs are 0..n-1 and Y IDs
+    are n..2n-1.
+    """
+
+    m = n // 3
+    x_groups = [[3 * g, 3 * g + 1, 3 * g + 2] for g in range(m)]
+    schedule: list[list[tuple[int, bool] | None]] = [
+        [None] * (2 * n) for _ in range(2 * n)
+    ]
+    for r in range(m):
+        blocks = ((2 * r, r % m, True), (2 * r + 1, (r + 2) % m, False))
+        for block, shift, x_home in blocks:
+            for g in range(m):
+                h = (g + shift) % m
+                for subslot in range(3):
+                    slot = 3 * block + subslot
+                    for member in range(3):
+                        x_team = x_groups[g][member]
+                        y_team = y_groups[h][(member + subslot) % 3]
+                        schedule[x_team][slot] = (n + y_team, x_home)
+                        schedule[n + y_team][slot] = (x_team, not x_home)
+    return [[entry for entry in row if entry is not None] for row in schedule]
+
+
+def _check_schedule(n: int, schedule: list[list[tuple[int, bool]]]) -> tuple[bool, str]:
+    if len(schedule) != 2 * n or any(len(row) != 2 * n for row in schedule):
+        return False, "expanded schedule has the wrong shape"
+
+    for team, row in enumerate(schedule):
+        run = 1
+        for slot, (opponent, is_home) in enumerate(row):
+            if not 0 <= opponent < 2 * n or (team < n) == (opponent < n):
+                return False, "expanded schedule has an invalid opponent"
+            other_opponent, other_home = schedule[opponent][slot]
+            if other_opponent != team or other_home == is_home:
+                return False, "expanded match entries are inconsistent"
+            if slot:
+                if row[slot - 1][0] == opponent:
+                    return False, "expanded schedule violates no-repeat"
+                if row[slot - 1][1] == is_home:
+                    run += 1
+                    if run > 3:
+                        return False, "expanded schedule violates at-most-three"
+                else:
+                    run = 1
+
+    for x_team in range(n):
+        counts: dict[tuple[int, bool], int] = {}
+        for opponent, is_home in schedule[x_team]:
+            key = (opponent - n, is_home)
