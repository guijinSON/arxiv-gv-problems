+#!/usr/bin/env python3
+"""Verified rooted road-trip covers from arXiv:1401.3909.
+
+The paper identifies one team's individual travel lower bound with the weight
+of a rooted 4-cycle-cover: every cycle is a road trip of at most three away
+games.  This module inverse-generates a metric and a minimum cover.  It samples
+the affine relabellings first and uses the rearrangement inequality to know the
+cover without running the assignment algorithm used as the Track-B baseline.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "optimization",
+    "object_regime": "finite_discrete",
+    "computational_core": "permutation",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "metric distance function on a home venue and opponent venues",
+        "rooted 4-cycle-cover of three-game road trips",
+    ],
+    "verification_operations": [
+        "exact modular rank evaluation",
+        "exact integer travel-distance addition",
+        "permutation and cycle-cover checks",
+        "integer threshold comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Each polynomial feature is centered over its venue class and all "
+        "features share one hidden affine order, so the rearrangement invariant "
+        "selects the opposite order; without recognizing it one must solve two "
+        "dense assignment problems."
+    ),
+    "hardness_basis": (
+        "Track B: Section 5 computes individual lower bounds by rooted "
+        "4-cycle-cover enumeration (340,540,200 cases at n=15); for this "
+        "shipping specialization two Hungarian assignments run in O(n^3), "
+        "with measured cost recorded by selftest at n=79, while cancellation "
+        "plus affine recurrences needs 196 exact operations and no tool."
+    ),
+    "max_answer_tokens": 230,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+DIFFICULTY = {
+    "demo": {"n": 5, "decoy_terms": 0, "coefficient_span": 9},
+    "easy": {"n": 53, "decoy_terms": 2, "coefficient_span": 500},
+    "medium": {"n": 67, "decoy_terms": 3, "coefficient_span": 1000},
+    "hard": {"n": 79, "decoy_terms": 4, "coefficient_span": 2000},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+
+STRUCTURAL_HINT = (
+    "Every displayed centered-power feature sums to zero over its venue class "
+    "and all such features share the same rank order."
+)
+PLACEBO_HINT = (
+    "Careful attention to the class positions and canonical cycle order helps "
+    "avoid transcription errors in the final cover."
+)
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list of n cycles [a,b,c], canonically ordered with b=0,...,n-1; "
+        "the a entries and c entries are each permutations of 0,...,n-1."
+    ),
+    "bounds": {
+        "cycles": "n",
+        "entries_per_cycle": 3,
+        "label_min": 0,
+        "label_max": "n-1",
+        "A_and_C_each_permutations": True,
+        "B_order": "0 through n-1",
+        "shipping_max_atomic_elements": 256,
+    },
+}
+
+
+NOTES = (
+    "Section 2 fixes the BTTP rules: at-most-three, no-repeat, each-venue, "
+    "direct travel between consecutive away venues, and departure from/return "
+    "to home. Definition 1 in Section 3 turns one team's legal road trips into "
+    "a rooted 4-cycle-cover; Section 5 uses exactly these covers to compute "
+    "ILB_t and states the 15!/(5!*2^5)=340,540,200-case enumeration. Theorem 1 "
+    "makes general BTTP and uniform BTTP NP-complete, while Section 4 is the "
+    "easy warning: Proposition 1 prunes by individual lower bounds, Proposition "
+    "2 exploits a special n=6 geometry, and their specialized NPB search still "
+    "took 34,716 seconds. This family is therefore Track B, not a false Track-A "
+    "claim. It uses the paper's cover object directly but specializes every trip "
+    "to the three displayed venue classes A,B,C. The generator samples strictly "
+    "increasing rank-value maps and affine relabellings, then pairs opposite "
+    "ranks; the rearrangement inequality certifies optimality. Centered-power "
+    "features have identical row and column sums, defeating the direct outlier "
+    "leak while preserving the same opposite-order optimum. The adversary panel "
+    "checks centered row-sum outliers, nearest-unused greed, bounded random-swap "
+    "restarts, and the obvious same-label ansatz; "
+    "the standard Hungarian algorithm is reported separately as required for "
+    "Track B."
+)
+
+
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_FENCE_RE = re.compile(r"^\s*```(?:json|text)?\s*(.*?)\s*```\s*$", re.I | re.S)
+_G4_SAMPLES = 200_000
+_ENUMERATION_CAP = 200_000
+_ATTACK_SEEDS = 8
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _is_prime(value):
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    d = 3
+    while d * d <= value:
+        if value % d == 0:
+            return False
+        d += 2
+    return True
+
+
+def _next_prime(value):
+    value = max(3, value | 1)
+    while not _is_prime(value):
+        value += 2
+    return value
+
+
+def _validate(n, decoy_terms, coefficient_span):
+    for name, value in (
+        ("n", n),
+        ("decoy_terms", decoy_terms),
+        ("coefficient_span", coefficient_span),
+    ):
+        if not _is_int(value):
+            raise ValueError(f"{name} must be an integer")
+    if not 5 <= n <= 257 or not _is_prime(n):
+        raise ValueError("n must be an odd prime in 5..257")
+    if not 0 <= decoy_terms <= 16:
+        raise ValueError("decoy_terms must lie in 0..16")
+    if not 3 <= coefficient_span <= 10**9:
+        raise ValueError("coefficient_span must lie in 3..1000000000")
+
+
+def _inverse(value, modulus):
+    return pow(value, -1, modulus)
+
+
+def _correct_map(inst, outer):
+    """Return (u,v) for outer_label = u*B_label+v (mod p)."""
+    p = inst["n"]
+    middle = inst["affine"]["B"]
+    side = inst["affine"][outer]
+    inv = _inverse(side[0], p)
+    u = (-middle[0] * inv) % p
+    v = ((p - 1 - middle[1] - side[1]) * inv) % p
+    return u, v
+
+
+def _answer_from_maps(inst, amap, cmap):
+    p = inst["n"]
+    return [
+        [(amap[0] * b + amap[1]) % p, b,
+         (cmap[0] * b + cmap[1]) % p]
+        for b in range(p)
+    ]
+
+
+def make_instance(n, seed=0, decoy_terms=2, coefficient_span=500, **params):
+    """Inverse-generate a minimum rooted 4-cycle-cover, never solve for it."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+    _validate(n, decoy_terms, coefficient_span)
+    rng = random.Random(seed)
+
+    # value_X(r)=r^2+c_X*r is strictly increasing on ranks 0,...,p-1.
+    seq_coeff = {
+        "A": rng.randint(2, coefficient_span),
+        "B": rng.randint(2, coefficient_span),
+        "C": rng.randint(2, coefficient_span),
+    }
+    while seq_coeff["C"] == seq_coeff["A"]:
+        seq_coeff["C"] = rng.randint(2, coefficient_span)
+
+    affine = {}
+    for cls in "ABC":
+        affine[cls] = [rng.randrange(1, n), rng.randrange(n)]
+
+    # Avoid making either of the two obvious raw-label guesses accidentally exact.
+    forbidden = {(1, 0), (n - 1, n - 1)}
+    while (_correct_map({"n": n, "affine": affine}, "A") in forbidden or
+           _correct_map({"n": n, "affine": affine}, "C") in forbidden):
+        affine["A"] = [rng.randrange(1, n), rng.randrange(n)]
+        affine["C"] = [rng.randrange(1, n), rng.randrange(n)]
+
+    decoys = {
+        "AB": [rng.randint(1, coefficient_span) for _ in range(decoy_terms)],
+        "BC": [rng.randint(1, coefficient_span) for _ in range(decoy_terms)],
+    }
+    salts = {
+        "AA": rng.randint(1, coefficient_span),
+        "AC": rng.randint(1, coefficient_span),
+        "CC": rng.randint(1, coefficient_span),
+        "BB": rng.randint(1, coefficient_span),
+    }
+
+    inst = {
+        "paper": "arXiv:1401.3909",
+        "seed": seed,
+        "n": n,
+        "decoy_terms": decoy_terms,
+        "coefficient_span": coefficient_span,
+        "seq_coeff": seq_coeff,
+        "affine": affine,
+        "decoys": decoys,
+        "salts": salts,
+    }
+
+    # For exponent t, feature p*v^t-sum(v^t) is integral, strictly ordered by
+    # rank, and sums to zero. Positive sums of products of two such feature
+    # vectors all have the same opposite-order optimum by rearrangement.
+    center_sums = {}
+    for cls in "ABC":
+        values = [r * r + seq_coeff[cls] * r for r in range(n)]
+        center_sums[cls] = [
+            sum(value ** exponent for value in values)
+            for exponent in range(1, decoy_terms + 2)
+        ]
+    inst["center_sums"] = center_sums
+
+    cross_shift = {}
+    cross_max = {}
+    for left, right, key in (("A", "B", "AB"), ("B", "C", "BC")):
+        weights = [1] + decoys[key]
+        low = None
+        high = None
+        for left_rank in range(n):
+            x = left_rank * left_rank + seq_coeff[left] * left_rank
+            for right_rank in range(n):
+                y = right_rank * right_rank + seq_coeff[right] * right_rank
+                raw = 0
+                for index, coefficient in enumerate(weights):
+                    exponent = index + 1
+                    xf = n * (x ** exponent) - center_sums[left][index]
+                    yf = n * (y ** exponent) - center_sums[right][index]
+                    raw += coefficient * xf * yf
+                low = raw if low is None else min(low, raw)
+                high = raw if high is None else max(high, raw)
+        cross_shift[key] = 1 - low
+        cross_max[key] = high + cross_shift[key]
+    inst["cross_shift"] = cross_shift
+
+    # Pick BASE after all exact formula parameters. Every nonzero distance lies
+    # in [BASE,2*BASE), which proves the triangle inequality mechanically.
+    base = max(
+        cross_max["AB"], cross_max["BC"],
+        max(salts.values()) + (n - 1) ** 2,
+    ) + 1
+    inst["base"] = base
+
+    amap = _correct_map(inst, "A")
+    cmap = _correct_map(inst, "C")
+    answer = _answer_from_maps(inst, amap, cmap)
+    inst["threshold"] = _cover_cost(inst, answer)
+    inst["answer"] = answer
+    return inst
+
+
+def _rank(inst, cls, label):
+    mul, shift = inst["affine"][cls]
+    return (mul * label + shift) % inst["n"]
+
+
+def _value(inst, cls, label):
+    rank = _rank(inst, cls, label)
+    return rank * rank + inst["seq_coeff"][cls] * rank
+
+
+def _cross_deviation(inst, left_cls, left, right_cls, right):
+    if {left_cls, right_cls} == {"A", "B"}:
+        key = "AB"
+    elif {left_cls, right_cls} == {"B", "C"}:
+        key = "BC"
+    else:
+        raise ValueError("cross deviation is defined only for A-B or B-C")
+    x = _value(inst, left_cls, left)
+    y = _value(inst, right_cls, right)
+    weights = [1] + inst["decoys"][key]
+    total = inst["cross_shift"][key]
+    for index, coefficient in enumerate(weights):
+        exponent = index + 1
+        xf = inst["n"] * (x ** exponent) - inst["center_sums"][left_cls][index]
+        yf = inst["n"] * (y ** exponent) - inst["center_sums"][right_cls][index]
+        total += coefficient * xf * yf
+    return total
+
+
+def _distance(inst, first, second):
+    """Exact metric distance. Venues are None (home) or (class,label)."""
+    if first == second:
+        return 0
+    base = inst["base"]
+    if first is None or second is None:
+        return base
+    c1, x = first
+    c2, y = second
+    pair = {c1, c2}
+    if pair == {"A", "B"} or pair == {"B", "C"}:
+        return base + _cross_deviation(inst, c1, x, c2, y)
+    key = "".join(sorted((c1, c2)))
+    delta = _rank(inst, c1, x) - _rank(inst, c2, y)
+    return base + (delta * delta + inst["salts"].get(key, 0)) % base
+
+
+def _cycle_cost(inst, cycle):
+    a, b, c = cycle
+    return (
+        _distance(inst, None, ("A", a))
+        + _distance(inst, ("A", a), ("B", b))
+        + _distance(inst, ("B", b), ("C", c))
+        + _distance(inst, ("C", c), None)
+    )
+
+
+def _cover_cost(inst, answer):
+    return sum(_cycle_cost(inst, cycle) for cycle in answer)
+
+
+def render(inst):
+    """Return the complete self-contained rooted road-trip-cover problem."""
+    p = inst["n"]
+    lines = [
+        "MINIMUM ROOTED THREE-GAME ROAD-TRIP COVER",
+        "",
+        f"A team starts and ends at its home venue P and must visit {3*p} opponent venues exactly once. The opponents are A_0,...,A_{p-1}, B_0,...,B_{p-1}, and C_0,...,C_{p-1}, where p={p}. A road trip is the cycle P -> A_a -> B_b -> C_c -> P. A cover consists of exactly p such trips, using every A, every B, and every C exactly once. Thus it is a P-rooted 4-cycle-cover: every cycle has four vertices including P.",
+        "",
+        "All labels are integers modulo p, represented by 0,...,p-1. For class X in {A,B,C}, define",
+        "  r_X(i) = (alpha_X*i + beta_X) mod p",
+        "  v_X(i) = r_X(i)^2 + gamma_X*r_X(i).",
+        "The exact parameters are:",
+    ]
+    for cls in "ABC":
+        alpha, beta = inst["affine"][cls]
+        gamma = inst["seq_coeff"][cls]
+        lines.append(
+            f"  {cls}: alpha={alpha}, beta={beta}, gamma={gamma}"
+        )
+    lines.extend([
+        "",
+        "Distances are symmetric. A venue has distance 0 to itself. The distance from P to every opponent is BASE. For class X and exponent t define the centered integer feature f_X,t(i)=p*v_X(i)^t-S_X,t, where S_X,t is the sum of v_X(j)^t over j=0,...,p-1.",
+        "For A-B use weights [1]+lambda_AB; for B-C use [1]+lambda_BC. If x,y are the venue labels, then",
+        "  d(A_x,B_y) = BASE + SHIFT_AB + sum_t weight_AB[t]*f_A,t(x)*f_B,t(y),",
+        "  d(B_x,C_y) = BASE + SHIFT_BC + sum_t weight_BC[t]*f_B,t(x)*f_C,t(y).",
+        "Exponents t start at 1. The shifts make every displayed deviation positive.",
+        f"  lambda_AB = {inst['decoys']['AB']}; SHIFT_AB = {inst['cross_shift']['AB']}",
+        f"  lambda_BC = {inst['decoys']['BC']}; SHIFT_BC = {inst['cross_shift']['BC']}",
+        f"  S_A = {inst['center_sums']['A']}",
+        f"  S_B = {inst['center_sums']['B']}",
+        f"  S_C = {inst['center_sums']['C']}",
+        f"  BASE = {inst['base']}",
+        "Distances between two non-home venues of any other class-pair do not occur in a legal trip; for completeness they equal BASE + ((r_X(i)-r_Y(j))^2+s_XY) mod BASE, with s_AA=%d, s_AC=%d, s_BB=%d, s_CC=%d." % (
+            inst["salts"]["AA"], inst["salts"]["AC"],
+            inst["salts"]["BB"], inst["salts"]["CC"],
+        ),
+        "Every nonzero distance lies in [BASE,2*BASE), so these exact integer distances satisfy the triangle inequality.",
+        "",
+        f"Find a cover whose total travel distance is at most T={inst['threshold']}. The total is the sum of the four displayed legs of every trip. Equality is allowed.",
+        "",
+        f"Output exactly {p} triples [a,b,c]. The triple means P -> A_a -> B_b -> C_c -> P. Put the triples in canonical order with b=0,1,...,{p-1}; the A-labels must form a permutation of 0,...,{p-1}, as must the C-labels. Repeats are forbidden.",
+        "",
+        "Give your final answer inside <answer></answer> tags as one JSON list of integer triples.",
+        "Example format only: <answer>[[2,0,1],[0,1,2],[1,2,0]]</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    """Extract a tagged JSON cover; return None on absent or malformed text."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    body = match.group(1).strip()
+    fence = _FENCE_RE.match(body)
+    if fence:
+        body = fence.group(1).strip()
+    try:
+        return json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+
+
+def verify(inst, answer):
+    """Check any cover in the declared language; never inspect inst['answer']."""
+    p = inst["n"]
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer must not be empty"
+    if len(answer) != p:
+        return False, f"cover must contain exactly {p} cycles"
+    for index, cycle in enumerate(answer):
+        if not isinstance(cycle, list) or len(cycle) != 3:
+            return False, f"cycle {index} must be a three-integer list [a,b,c]"
+        if any(not _is_int(value) for value in cycle):
+            return False, f"cycle {index} contains a non-integer label"
+        if any(value < 0 or value >= p for value in cycle):
+            return False, f"cycle {index} has a label outside 0..{p-1}"
+    if [cycle[1] for cycle in answer] != list(range(p)):
+        return False, "cycles must be in canonical B-label order 0,1,...,n-1"
+    if sorted(cycle[0] for cycle in answer) != list(range(p)):
+        return False, "A-labels must form a permutation with no duplicates"
+    if sorted(cycle[2] for cycle in answer) != list(range(p)):
+        return False, "C-labels must form a permutation with no duplicates"
+    total = _cover_cost(inst, answer)
+    if total > inst["threshold"]:
+        return False, f"travel distance {total} exceeds threshold {inst['threshold']}"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample uniformly from the two-permutation certificate language."""
+    p = inst["n"]
+    a = list(range(p))
+    c = list(range(p))
+    rng.shuffle(a)
+    rng.shuffle(c)
+    return [[a[b], b, c[b]] for b in range(p)]
+
+
+def search_space(inst):
+    """There are independently n! choices for the A and C permutations."""
+    return math.factorial(inst["n"]) ** 2
+
+
+def enumerate_all(inst):
+    """Brute-force an exact valid-answer count only when safely below the cap."""
+    p = inst["n"]
+    space = search_space(inst)
+    if space > _ENUMERATION_CAP:
+        return None
+    count = 0
+    labels = tuple(range(p))
+    for a in itertools.permutations(labels):
+        for c in itertools.permutations(labels):
+            candidate = [[a[b], b, c[b]] for b in labels]
+            if verify(inst, candidate)[0]:
+                count += 1
+    return count
+
+
+def canonical_key(inst):
+    """Canonical under affine venue relabelling and reversal A<->C."""
+    branches = [
+        [inst["seq_coeff"]["A"], inst["salts"]["AA"], inst["decoys"]["AB"]],
+        [inst["seq_coeff"]["C"], inst["salts"]["CC"], inst["decoys"]["BC"]],
+    ]
+    branches.sort(key=lambda value: json.dumps(value, separators=(",", ":")))
+    normal = {
+        "n": inst["n"],
+        "middle_sequence": inst["seq_coeff"]["B"],
+        "middle_salt": inst["salts"]["BB"],
+        "outer_pair_salt": inst["salts"]["AC"],
+        "branches": branches,
+    }
+    blob = json.dumps(normal, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode()).hexdigest()
+
+
+def escalate(params):
+    """First add invariant decoys at fixed answer length, then use the last safe p."""
+    current = dict(params)
+    terms = int(current.get("decoy_terms", 0))
+    if terms < 10:
+        current["decoy_terms"] = terms + 2
+        current["coefficient_span"] = min(
+            10**9, int(current.get("coefficient_span", 500)) * 2
+        )
+        return current
+    p = int(current["n"])
+    if p < 83:
+        current["n"] = 83
+        return current
+    return "cap_bound"
+
+
+def _hungarian(cost):
+    """Minimum square assignment; return row->column and relaxation count."""
+    n = len(cost)
+    u = [0] * (n + 1)
+    v = [0] * (n + 1)
+    pcol = [0] * (n + 1)
+    way = [0] * (n + 1)
+    relaxations = 0
+    for i in range(1, n + 1):
+        pcol[0] = i
+        minv = [None] + [10**2000] * n
+        used = [False] * (n + 1)
+        j0 = 0
+        while True:
+            used[j0] = True
+            i0 = pcol[j0]
+            delta = 10**2000
+            j1 = 0
+            for j in range(1, n + 1):
+                if not used[j]:
+                    relaxations += 1
+                    cur = cost[i0 - 1][j - 1] - u[i0] - v[j]
+                    if cur < minv[j]:
+                        minv[j] = cur
+                        way[j] = j0
+                    if minv[j] < delta:
+                        delta = minv[j]
+                        j1 = j
+            for j in range(n + 1):
+                if used[j]:
+                    u[pcol[j]] += delta
+                    v[j] -= delta
+                elif j:
+                    minv[j] -= delta
+            j0 = j1
+            if pcol[j0] == 0:
+                break
+        while True:
+            j1 = way[j0]
+            pcol[j0] = pcol[j1]
+            j0 = j1
+            if j0 == 0:
+                break
+    assignment = [0] * n
+    for j in range(1, n + 1):
+        assignment[pcol[j] - 1] = j - 1
+    return assignment, relaxations
+
+
+def _reference_algorithm(inst):
+    """Solve the two dense assignments without using the planted formula."""
+    p = inst["n"]
+    start = time.perf_counter()
+    ab = []
+    bc = []
+    matrix_evaluations = 0
+    for b in range(p):
+        ab_row = []
+        bc_row = []
+        for outer in range(p):
+            ab_row.append(_distance(inst, ("A", outer), ("B", b)))
+            bc_row.append(_distance(inst, ("B", b), ("C", outer)))
+            matrix_evaluations += 2
+        ab.append(ab_row)
+        bc.append(bc_row)
+    amap, relax_ab = _hungarian(ab)
+    cmap, relax_bc = _hungarian(bc)
+    candidate = [[amap[b], b, cmap[b]] for b in range(p)]
+    elapsed = time.perf_counter() - start
+    # Count each matrix formula as 10+8(d+1) exact operations and each Hungarian
+    # relaxation as its subtraction/comparison/update unit. This is explicit and
+    # reproducible rather than a hardware-dependent cardinality inference.
+    formula_ops = matrix_evaluations * (10 + 8 * (inst["decoy_terms"] + 1))
+    operations = formula_ops + relax_ab + relax_bc
+    return candidate, elapsed, operations, {
+        "matrix_evaluations": matrix_evaluations,
+        "relaxations": relax_ab + relax_bc,
+    }
+
+
+def _greedy_nearest_unused(inst):
+    p = inst["n"]
+    unused_a = set(range(p))
+    unused_c = set(range(p))
+    result = []
+    for b in range(p):
+        a = min(unused_a, key=lambda x: (_distance(inst, ("A", x), ("B", b)), x))
+        c = min(unused_c, key=lambda x: (_distance(inst, ("B", b), ("C", x)), x))
+        unused_a.remove(a)
+        unused_c.remove(c)
+        result.append([a, b, c])
+    return result
+
+
+def _row_sum_outlier(inst):
+    """Rank venues only by the cheapest common per-vertex outlier statistic."""
+    p = inst["n"]
+    a_order = sorted(
+        range(p),
+        key=lambda a: (
+            sum(_distance(inst, ("A", a), ("B", b)) for b in range(p)), a
+        ),
+    )
+    b_order_ab = sorted(
+        range(p),
+        key=lambda b: (
+            sum(_distance(inst, ("A", a), ("B", b)) for a in range(p)), b
+        ),
+    )
+    c_order = sorted(
+        range(p),
+        key=lambda c: (
+            sum(_distance(inst, ("B", b), ("C", c)) for b in range(p)), c
+        ),
+    )
+    b_order_bc = sorted(
+        range(p),
+        key=lambda b: (
+            sum(_distance(inst, ("B", b), ("C", c)) for c in range(p)), b
+        ),
+    )
+    amap = {}
+    cmap = {}
+    for index in range(p):
+        amap[b_order_ab[index]] = a_order[p - 1 - index]
+        cmap[b_order_bc[index]] = c_order[p - 1 - index]
+    return [[amap[b], b, cmap[b]] for b in range(p)]
+
+
+def _random_swap_restarts(inst, rng, restarts=64, steps=32):
+    """Mild assignment hill-climbing with bounded random restarts."""
+    p = inst["n"]
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        a = [row[0] for row in candidate]
+        c = [row[2] for row in candidate]
+        for _ in range(steps):
+            b1, b2 = rng.sample(range(p), 2)
+            if rng.randrange(2) == 0:
+                old = (_distance(inst, ("A", a[b1]), ("B", b1))
+                       + _distance(inst, ("A", a[b2]), ("B", b2)))
+                new = (_distance(inst, ("A", a[b2]), ("B", b1))
+                       + _distance(inst, ("A", a[b1]), ("B", b2)))
+                if new < old:
+                    a[b1], a[b2] = a[b2], a[b1]
+            else:
+                old = (_distance(inst, ("B", b1), ("C", c[b1]))
+                       + _distance(inst, ("B", b2), ("C", c[b2])))
+                new = (_distance(inst, ("B", b1), ("C", c[b2]))
+                       + _distance(inst, ("B", b2), ("C", c[b1])))
+                if new < old:
+                    c[b1], c[b2] = c[b2], c[b1]
+        candidate = [[a[b], b, c[b]] for b in range(p)]
+        if verify(inst, candidate)[0]:
+            return candidate
+    return candidate
+
+
+def _transform_affine(inst, transforms, swap_outer=False):
+    """Relabel class coordinates by new=u*old+v; carry the witness."""
+    p = inst["n"]
+    transformed = {
+        key: json.loads(json.dumps(value))
+        for key, value in inst.items()
+        if key != "answer"
+    }
+    for cls in "ABC":
+        u, shift = transforms[cls]
+        invu = _inverse(u, p)
+        oldmul, oldshift = inst["affine"][cls]
+        transformed["affine"][cls] = [
+            (oldmul * invu) % p,
+            (oldshift - oldmul * invu * shift) % p,
+        ]
+    carried = []
+    for a, b, c in inst["answer"]:
+        carried.append([
+            (transforms["A"][0] * a + transforms["A"][1]) % p,
+            (transforms["B"][0] * b + transforms["B"][1]) % p,
+            (transforms["C"][0] * c + transforms["C"][1]) % p,
+        ])
+    carried.sort(key=lambda row: row[1])
+    if swap_outer:
+        transformed["seq_coeff"]["A"], transformed["seq_coeff"]["C"] = (
+            transformed["seq_coeff"]["C"], transformed["seq_coeff"]["A"]
+        )
+        transformed["affine"]["A"], transformed["affine"]["C"] = (
+            transformed["affine"]["C"], transformed["affine"]["A"]
+        )
+        transformed["decoys"]["AB"], transformed["decoys"]["BC"] = (
+            transformed["decoys"]["BC"], transformed["decoys"]["AB"]
+        )
+        transformed["salts"]["AA"], transformed["salts"]["CC"] = (
+            transformed["salts"]["CC"], transformed["salts"]["AA"]
+        )
+        carried = [[c, b, a] for a, b, c in carried]
+    transformed["answer"] = carried
+    return transformed
+
+
+def _answer_atoms(answer):
+    if isinstance(answer, dict):
+        return sum(_answer_atoms(value) for value in answer.values())
+    if isinstance(answer, list):
+        return sum(_answer_atoms(value) for value in answer)
+    return 1
+
+
+def selftest():
+    """Run mandatory gates and return a fully JSON-native measurement report."""
