+def _structural_decode(inst: dict) -> list[int] | None:
+    sum_u = sum(tag[0] for tag in inst["tags"]) % inst["prime"]
+    sum_v = sum(tag[1] for tag in inst["tags"]) % inst["prime"]
+    candidate = [sum_v, (-sum_u) % inst["prime"]]
+    return candidate if _fast_valid(inst, candidate) else None
