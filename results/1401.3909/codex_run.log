+def _normal_from_pair(inst: dict, i: int, j: int) -> list[int]:
+    prime = inst["prime"]
+    u0, v0 = inst["tags"][i]
+    u1, v1 = inst["tags"][j]
+    return [(v1 - v0) % prime, (u0 - u1) % prime]
+
+
+def _reference_profile_scan(inst: dict) -> tuple[list[int] | None, dict[str, int]]:
+    """Recover tree clusters by exhaustive constant row-difference tests."""
+
+    n = inst["n"]
+    matrix = inst["distance"]
+    neighbours = [set() for _ in range(n)]
+    operations = 0
+    pair_tests = 0
+    for i in range(n):
+        for j in range(i + 1, n):
+            pair_tests += 1
+            deltas = set()
+            for k in range(n):
+                if k != i and k != j:
+                    deltas.add(matrix[i][k] - matrix[j][k])
+                    operations += 1
+            if len(deltas) == 1:
+                neighbours[i].add(j)
+                neighbours[j].add(i)
+
+    unseen = set(range(n))
+    groups: list[list[int]] = []
+    while unseen:
+        root = min(unseen)
+        group = {root} | neighbours[root]
+        if len(group) != 3:
+            return None, {"operations": operations, "pair_tests": pair_tests}
+        groups.append(sorted(group))
+        unseen -= group
+    candidate = _normal_from_pair(inst, groups[0][0], groups[0][1])
+    return candidate, {"operations": operations, "pair_tests": pair_tests}
 
 
