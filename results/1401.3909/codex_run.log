+
+    attacks = {
+        "outlier_row_sum_ranking": {"successes": 0, "attempts": _ATTACK_SEEDS},
+        "greedy_nearest_unused": {"successes": 0, "attempts": _ATTACK_SEEDS},
+        "random_swap_restarts_64x32": {"successes": 0, "attempts": _ATTACK_SEEDS},
