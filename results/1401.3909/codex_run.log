def escalate(params: dict) -> dict | str | None:
    """Enlarge coefficient entropy at fixed two-integer answer length."""

    harder = dict(params)
    current = int(harder.get("prime", 50_000_017))
    if current >= 8_000_000_000:
        return "cap_bound"
    harder["prime"] = _next_prime(2 * current + 1)
    harder["weight_scale"] = min(
        1_000_000, max(1, int(harder.get("weight_scale", 64)) * 2)
    )
    return harder


def _structural_decode(inst: dict) -> list[int] | None:
    sum_u = sum(tag[0] for tag in inst["tags"]) % inst["prime"]
    sum_v = sum(tag[1] for tag in inst["tags"]) % inst["prime"]
    candidate = [sum_v, (-sum_u) % inst["prime"]]
    return candidate if _fast_valid(inst, candidate) else None


def _intended_operation_bound(inst: dict) -> int:
    # Two running sums (2n additions), two modular reductions, one negation.
    return 2 * inst["n"] + 3


def _normal_from_pair(inst: dict, i: int, j: int) -> list[int]:
    prime = inst["prime"]
    u0, v0 = inst["tags"][i]
    u1, v1 = inst["tags"][j]
    return [(v1 - v0) % prime, (u0 - u1) % prime]


def _reference_profile_scan(inst: dict) -> tuple[list[int] | None, dict[str, int]]:
    """Recover tree clusters by exhaustive constant row-difference tests."""

    n = inst["n"]
    matrix = inst["distance"]
    neighbours = [set() for _ in range(n)]
    operations = 0
    pair_tests = 0
    for i in range(n):
        for j in range(i + 1, n):
            pair_tests += 1
            deltas = set()
            for k in range(n):
                if k != i and k != j:
                    deltas.add(matrix[i][k] - matrix[j][k])
                    operations += 1
            if len(deltas) == 1:
                neighbours[i].add(j)
                neighbours[j].add(i)

    unseen = set(range(n))
    groups: list[list[int]] = []
    while unseen:
        root = min(unseen)
        group = {root} | neighbours[root]
        if len(group) != 3:
            return None, {"operations": operations, "pair_tests": pair_tests}
        groups.append(sorted(group))
        unseen -= group
    candidate = _normal_from_pair(inst, groups[0][0], groups[0][1])
    return candidate, {"operations": operations, "pair_tests": pair_tests}


def _attack_candidates(inst: dict, rng: random.Random) -> dict[str, object]:
    n = inst["n"]
    matrix = inst["distance"]
    row_sums = [sum(row) for row in matrix]
    closest_rows = min(
        ((abs(row_sums[i] - row_sums[j]), i, j)
         for i in range(n) for j in range(i + 1, n)),
        key=lambda item: item,
    )
    shortest = min(
        ((matrix[i][j], i, j)
         for i in range(n) for j in range(i + 1, n)),
        key=lambda item: item,
    )
    return {
        "outlier_closest_row_sums": _normal_from_pair(
            inst, closest_rows[1], closest_rows[2]
        ),
        "greedy_shortest_distance_edge": _normal_from_pair(
            inst, shortest[1], shortest[2]
        ),
        "by_hand_equal_tag_sum": [1, 1],
        "random_projective_256": [
            random_candidate(inst, rng) for _ in range(256)
        ],
    }


def _attack_succeeds(inst: dict, candidate: object) -> bool:
    if isinstance(candidate, list) and candidate and isinstance(candidate[0], list):
        return any(_fast_valid(inst, item) for item in candidate)
    return _fast_valid(inst, candidate)


def _permuted_instance(inst: dict, rng: random.Random) -> dict:
    permutation = list(range(inst["n"]))
    rng.shuffle(permutation)
    transformed = dict(inst)
    transformed["tags"] = [inst["tags"][old] for old in permutation]
    transformed["distance"] = [
        [inst["distance"][old_i][old_j] for old_j in permutation]
        for old_i in permutation
    ]
    return transformed


def _swapped_tag_basis(inst: dict) -> tuple[dict, list[int]]:
    transformed = dict(inst)
    transformed["tags"] = [[v, u] for u, v in inst["tags"]]
    carried = [inst["answer"][1], inst["answer"][0]]
    return transformed, carried


def _atom_count(value: object) -> int:
    if isinstance(value, dict):
        return sum(_atom_count(item) for item in value.values())
    if isinstance(value, (list, tuple)):
        return sum(_atom_count(item) for item in value)
    return 1


def selftest() -> dict:
    """Run G1--G9 and return a JSON-native report with measured costs."""

    report: dict[str, Any] = {
        "track": TRACK,
        "shipping_difficulty": SHIPPING_DIFFICULTY,
    }

    g1_failures: list[str] = []
    g1_attempts = 0
    for preset, params in DIFFICULTY.items():
        for seed in range(5):
            inst = make_instance(seed=seed, **params)
            ok, reason = verify(inst, inst["answer"])
            g1_attempts += 1
            if not ok:
                g1_failures.append(f"{preset}/{seed}: {reason}")

