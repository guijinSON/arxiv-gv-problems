+def _travel_cost(inst: dict, groups: list[list[int]]) -> int:
+    matrix = inst["distance"]
+    perimeter_sum = 0
+    for i, j, k in groups:
+        perimeter_sum += matrix[i][j] + matrix[j][k] + matrix[k][i]
+    return inst["fixed_cost"] + inst["perimeter_multiplier"] * perimeter_sum
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Expand and check any valid symbolic witness; never inspect inst['answer']."""
+
+    groups, reason = _candidate_groups(inst, answer)
+    if groups is None:
+        return False, reason
+    schedule = _schedule_from_groups(inst["n"], groups)
+    schedule_ok, schedule_reason = _check_schedule(inst["n"], schedule)
+    if not schedule_ok:
+        return False, schedule_reason
+    cost = _travel_cost(inst, groups)
+    if cost > inst["target"]:
+        return False, f"travel {cost} exceeds target {inst['target']}"
+    return True, "ok"
+
+
+def _fast_valid(inst: dict, answer: object) -> bool:
+    groups, _reason = _candidate_groups(inst, answer)
+    return groups is not None and _travel_cost(inst, groups) <= inst["target"]
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the stated language of distinct field coefficients."""
 
+    prime = inst["prime"]
+    a = rng.randrange(prime)
+    b_index = rng.randrange(prime - 1)
+    b = b_index if b_index < a else b_index + 1
+    return [a, b]
 
