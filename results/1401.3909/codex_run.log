-def _normal_from_pair(inst: dict, i: int, j: int) -> list[int]:
-    prime = inst["prime"]
-    u0, v0 = inst["tags"][i]
-    u1, v1 = inst["tags"][j]
-    return [(v1 - v0) % prime, (u0 - u1) % prime]
