+def _hungarian(cost):
+    """Minimum square assignment; return row->column and relaxation count."""
+    n = len(cost)
+    u = [0] * (n + 1)
+    v = [0] * (n + 1)
+    pcol = [0] * (n + 1)
+    way = [0] * (n + 1)
+    relaxations = 0
+    for i in range(1, n + 1):
+        pcol[0] = i
+        minv = [None] + [10**2000] * n
+        used = [False] * (n + 1)
+        j0 = 0
+        while True:
+            used[j0] = True
+            i0 = pcol[j0]
+            delta = 10**2000
+            j1 = 0
+            for j in range(1, n + 1):
+                if not used[j]:
+                    relaxations += 1
+                    cur = cost[i0 - 1][j - 1] - u[i0] - v[j]
+                    if cur < minv[j]:
+                        minv[j] = cur
+                        way[j] = j0
+                    if minv[j] < delta:
+                        delta = minv[j]
+                        j1 = j
+            for j in range(n + 1):
+                if used[j]:
+                    u[pcol[j]] += delta
+                    v[j] -= delta
+                elif j:
+                    minv[j] -= delta
+            j0 = j1
+            if pcol[j0] == 0:
+                break
+        while True:
+            j1 = way[j0]
+            pcol[j0] = pcol[j1]
+            j0 = j1
+            if j0 == 0:
+                break
