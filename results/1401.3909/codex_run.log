+def _attack_candidates(inst: dict, rng: random.Random) -> dict[str, object]:
+    n = inst["n"]
+    matrix = inst["distance"]
+    row_sums = [sum(row) for row in matrix]
+    closest_rows = min(
+        ((abs(row_sums[i] - row_sums[j]), i, j)
+         for i in range(n) for j in range(i + 1, n)),
+        key=lambda item: item,
+    )
+    shortest = min(
+        ((matrix[i][j], i, j)
+         for i in range(n) for j in range(i + 1, n)),
+        key=lambda item: item,
+    )
+    return {
+        "outlier_closest_row_sums": _normal_from_pair(
+            inst, closest_rows[1], closest_rows[2]
+        ),
+        "greedy_shortest_distance_edge": _normal_from_pair(
+            inst, shortest[1], shortest[2]
+        ),
+        "by_hand_equal_tag_sum": [1, 1],
+        "random_projective_256": [
+            random_candidate(inst, rng) for _ in range(256)
+        ],
     }
 
 
