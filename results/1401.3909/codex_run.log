+def _check_schedule(n: int, schedule: list[list[tuple[int, bool]]]) -> tuple[bool, str]:
+    if len(schedule) != 2 * n or any(len(row) != 2 * n for row in schedule):
+        return False, "expanded schedule has the wrong shape"
+
+    for team, row in enumerate(schedule):
+        run = 1
+        for slot, (opponent, is_home) in enumerate(row):
+            if not 0 <= opponent < 2 * n or (team < n) == (opponent < n):
+                return False, "expanded schedule has an invalid opponent"
+            other_opponent, other_home = schedule[opponent][slot]
+            if other_opponent != team or other_home == is_home:
+                return False, "expanded match entries are inconsistent"
+            if slot:
+                if row[slot - 1][0] == opponent:
+                    return False, "expanded schedule violates no-repeat"
+                if row[slot - 1][1] == is_home:
