+    rank = _rank(inst, cls, label)
+    return rank * rank + inst["seq_coeff"][cls] * rank
+
+
+def _cross_deviation(inst, left_cls, left, right_cls, right):
+    if {left_cls, right_cls} == {"A", "B"}:
+        key = "AB"
+    elif {left_cls, right_cls} == {"B", "C"}:
+        key = "BC"
+    else:
+        raise ValueError("cross deviation is defined only for A-B or B-C")
+    x = _value(inst, left_cls, left)
+    y = _value(inst, right_cls, right)
+    total = (x + y) ** 2
+    for exponent, coefficient in enumerate(inst["decoys"][key], start=1):
+        total += coefficient * (x ** exponent + y ** exponent)
+    return total
+
+
+def _distance(inst, first, second):
+    """Exact metric distance. Venues are None (home) or (class,label)."""
+    if first == second:
+        return 0
+    base = inst["base"]
+    if first is None or second is None:
+        return base
+    c1, x = first
+    c2, y = second
+    pair = {c1, c2}
+    if pair == {"A", "B"} or pair == {"B", "C"}:
+        return base + _cross_deviation(inst, c1, x, c2, y)
+    key = "".join(sorted((c1, c2)))
+    delta = _rank(inst, c1, x) - _rank(inst, c2, y)
+    return base + (delta * delta + inst["salts"].get(key, 0)) % base
+
+
+def _cycle_cost(inst, cycle):
+    a, b, c = cycle
+    return (
+        _distance(inst, None, ("A", a))
+        + _distance(inst, ("A", a), ("B", b))
+        + _distance(inst, ("B", b), ("C", c))
+        + _distance(inst, ("C", c), None)
+    )
+
+
+def _cover_cost(inst, answer):
+    return sum(_cycle_cost(inst, cycle) for cycle in answer)
+
+
+def render(inst):
+    """Return the complete self-contained rooted road-trip-cover problem."""
+    p = inst["n"]
+    lines = [
+        "MINIMUM ROOTED THREE-GAME ROAD-TRIP COVER",
+        "",
+        f"A team starts and ends at its home venue P and must visit {3*p} opponent venues exactly once. The opponents are A_0,...,A_{p-1}, B_0,...,B_{p-1}, and C_0,...,C_{p-1}, where p={p}. A road trip is the cycle P -> A_a -> B_b -> C_c -> P. A cover consists of exactly p such trips, using every A, every B, and every C exactly once. Thus it is a P-rooted 4-cycle-cover: every cycle has four vertices including P.",
+        "",
+        "All labels are integers modulo p, represented by 0,...,p-1. For class X in {A,B,C}, define",
+        "  r_X(i) = (alpha_X*i + beta_X) mod p",
+        "  v_X(i) = r_X(i)^2 + gamma_X*r_X(i).",
+        "The exact parameters are:",
+    ]
+    for cls in "ABC":
+        alpha, beta = inst["affine"][cls]
+        gamma = inst["seq_coeff"][cls]
+        lines.append(
+            f"  {cls}: alpha={alpha}, beta={beta}, gamma={gamma}"
+        )
+    lines.extend([
+        "",
+        "Distances are symmetric. A venue has distance 0 to itself. The distance from P to every opponent is BASE. For an A-B or B-C pair, let x and y be their respective v-values and define",
+        "  d(A_a,B_b) = BASE + (x+y)^2 + sum_t lambda_AB[t]*(x^t+y^t),",
+        "  d(B_b,C_c) = BASE + (x+y)^2 + sum_t lambda_BC[t]*(x^t+y^t),",
+        "where exponents t start at 1 in the displayed coefficient lists. An empty list means the sum is zero.",
+        f"  lambda_AB = {inst['decoys']['AB']}",
+        f"  lambda_BC = {inst['decoys']['BC']}",
+        f"  BASE = {inst['base']}",
+        "Distances between two non-home venues of any other class-pair do not occur in a legal trip; for completeness they equal BASE + ((r_X(i)-r_Y(j))^2+s_XY) mod BASE, with s_AA=%d, s_AC=%d, s_BB=%d, s_CC=%d." % (
+            inst["salts"]["AA"], inst["salts"]["AC"],
+            inst["salts"]["BB"], inst["salts"]["CC"],
+        ),
+        "Every nonzero distance lies in [BASE,2*BASE), so these exact integer distances satisfy the triangle inequality.",
+        "",
+        f"Find a cover whose total travel distance is at most T={inst['threshold']}. The total is the sum of the four displayed legs of every trip. Equality is allowed.",
+        "",
+        f"Output exactly {p} triples [a,b,c]. The triple means P -> A_a -> B_b -> C_c -> P. Put the triples in canonical order with b=0,1,...,{p-1}; the A-labels must form a permutation of 0,...,{p-1}, as must the C-labels. Repeats are forbidden.",
+        "",
+        "Give your final answer inside <answer></answer> tags as one JSON list of integer triples.",
+        "Example format only: <answer>[[2,0,1],[0,1,2],[1,2,0]]</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    """Extract a tagged JSON cover; return None on absent or malformed text."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    body = match.group(1).strip()
+    fence = _FENCE_RE.match(body)
+    if fence:
+        body = fence.group(1).strip()
+    try:
+        return json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+
+
+def verify(inst, answer):
+    """Check any cover in the declared language; never inspect inst['answer']."""
+    p = inst["n"]
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer must not be empty"
+    if len(answer) != p:
+        return False, f"cover must contain exactly {p} cycles"
+    for index, cycle in enumerate(answer):
+        if not isinstance(cycle, list) or len(cycle) != 3:
+            return False, f"cycle {index} must be a three-integer list [a,b,c]"
+        if any(not _is_int(value) for value in cycle):
+            return False, f"cycle {index} contains a non-integer label"
+        if any(value < 0 or value >= p for value in cycle):
+            return False, f"cycle {index} has a label outside 0..{p-1}"
+    if [cycle[1] for cycle in answer] != list(range(p)):
+        return False, "cycles must be in canonical B-label order 0,1,...,n-1"
+    if sorted(cycle[0] for cycle in answer) != list(range(p)):
+        return False, "A-labels must form a permutation with no duplicates"
+    if sorted(cycle[2] for cycle in answer) != list(range(p)):
+        return False, "C-labels must form a permutation with no duplicates"
+    total = _cover_cost(inst, answer)
+    if total > inst["threshold"]:
+        return False, f"travel distance {total} exceeds threshold {inst['threshold']}"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample uniformly from the two-permutation certificate language."""
+    p = inst["n"]
+    a = list(range(p))
+    c = list(range(p))
+    rng.shuffle(a)
+    rng.shuffle(c)
+    return [[a[b], b, c[b]] for b in range(p)]
+
+
+def search_space(inst):
+    """There are independently n! choices for the A and C permutations."""
+    return math.factorial(inst["n"]) ** 2
+
+
+def enumerate_all(inst):
+    """Brute-force an exact valid-answer count only when safely below the cap."""
+    p = inst["n"]
+    space = search_space(inst)
+    if space > _ENUMERATION_CAP:
+        return None
+    count = 0
+    labels = tuple(range(p))
+    for a in itertools.permutations(labels):
+        for c in itertools.permutations(labels):
+            candidate = [[a[b], b, c[b]] for b in labels]
+            if verify(inst, candidate)[0]:
+                count += 1
+    return count
+
+
+def canonical_key(inst):
+    """Canonical under affine venue relabelling and reversal A<->C."""
+    branches = [
+        [inst["seq_coeff"]["A"], inst["salts"]["AA"], inst["decoys"]["AB"]],
+        [inst["seq_coeff"]["C"], inst["salts"]["CC"], inst["decoys"]["BC"]],
+    ]
+    branches.sort(key=lambda value: json.dumps(value, separators=(",", ":")))
+    normal = {
+        "n": inst["n"],
+        "middle_sequence": inst["seq_coeff"]["B"],
+        "middle_salt": inst["salts"]["BB"],
+        "outer_pair_salt": inst["salts"]["AC"],
+        "branches": branches,
+    }
+    blob = json.dumps(normal, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode()).hexdigest()
+
+
+def escalate(params):
+    """First add invariant decoys at fixed answer length, then use the last safe p."""
+    current = dict(params)
+    terms = int(current.get("decoy_terms", 0))
+    if terms < 10:
+        current["decoy_terms"] = terms + 2
+        current["coefficient_span"] = min(
+            10**9, int(current.get("coefficient_span", 500)) * 2
+        )
+        return current
+    p = int(current["n"])
+    if p < 83:
+        current["n"] = 83
+        return current
+    return "cap_bound"
+
+
+def _hungarian(cost):
+    """Minimum square assignment; return row->column and relaxation count."""
+    n = len(cost)
+    u = [0] * (n + 1)
+    v = [0] * (n + 1)
+    pcol = [0] * (n + 1)
+    way = [0] * (n + 1)
+    relaxations = 0
+    for i in range(1, n + 1):
+        pcol[0] = i
+        minv = [None] + [10**2000] * n
+        used = [False] * (n + 1)
+        j0 = 0
+        while True:
+            used[j0] = True
+            i0 = pcol[j0]
+            delta = 10**2000
+            j1 = 0
+            for j in range(1, n + 1):
+                if not used[j]:
+                    relaxations += 1
+                    cur = cost[i0 - 1][j - 1] - u[i0] - v[j]
+                    if cur < minv[j]:
+                        minv[j] = cur
+                        way[j] = j0
+                    if minv[j] < delta:
+                        delta = minv[j]
+                        j1 = j
+            for j in range(n + 1):
+                if used[j]:
+                    u[pcol[j]] += delta
+                    v[j] -= delta
+                elif j:
+                    minv[j] -= delta
+            j0 = j1
+            if pcol[j0] == 0:
+                break
+        while True:
+            j1 = way[j0]
+            pcol[j0] = pcol[j1]
+            j0 = j1
+            if j0 == 0:
+                break
+    assignment = [0] * n
+    for j in range(1, n + 1):
+        assignment[pcol[j] - 1] = j - 1
+    return assignment, relaxations
+
+
+def _reference_algorithm(inst):
+    """Solve the two dense assignments without using the planted formula."""
+    p = inst["n"]
+    start = time.perf_counter()
+    ab = []
+    bc = []
+    matrix_evaluations = 0
+    for b in range(p):
+        ab_row = []
+        bc_row = []
+        for outer in range(p):
+            ab_row.append(_distance(inst, ("A", outer), ("B", b)))
+            bc_row.append(_distance(inst, ("B", b), ("C", outer)))
+            matrix_evaluations += 2
+        ab.append(ab_row)
+        bc.append(bc_row)
+    amap, relax_ab = _hungarian(ab)
+    cmap, relax_bc = _hungarian(bc)
+    candidate = [[amap[b], b, cmap[b]] for b in range(p)]
+    elapsed = time.perf_counter() - start
+    # Count each matrix formula as 6+4d exact operations and each Hungarian
+    # relaxation as its subtraction/comparison/update unit. This is explicit and
+    # reproducible rather than a hardware-dependent cardinality inference.
+    formula_ops = matrix_evaluations * (6 + 4 * inst["decoy_terms"])
+    operations = formula_ops + relax_ab + relax_bc
+    return candidate, elapsed, operations, {
+        "matrix_evaluations": matrix_evaluations,
+        "relaxations": relax_ab + relax_bc,
+    }
+
+
+def _greedy_nearest_unused(inst):
+    p = inst["n"]
+    unused_a = set(range(p))
+    unused_c = set(range(p))
+    result = []
+    for b in range(p):
+        a = min(unused_a, key=lambda x: (_distance(inst, ("A", x), ("B", b)), x))
+        c = min(unused_c, key=lambda x: (_distance(inst, ("B", b), ("C", x)), x))
+        unused_a.remove(a)
+        unused_c.remove(c)
+        result.append([a, b, c])
+    return result
+
+
+def _transform_affine(inst, transforms, swap_outer=False):
+    """Relabel class coordinates by new=u*old+v; carry the witness."""
+    p = inst["n"]
+    transformed = {
+        key: json.loads(json.dumps(value))
+        for key, value in inst.items()
+        if key != "answer"
+    }
+    for cls in "ABC":
+        u, shift = transforms[cls]
+        invu = _inverse(u, p)
+        oldmul, oldshift = inst["affine"][cls]
+        transformed["affine"][cls] = [
+            (oldmul * invu) % p,
+            (oldshift - oldmul * invu * shift) % p,
+        ]
+    carried = []
+    for a, b, c in inst["answer"]:
+        carried.append([
+            (transforms["A"][0] * a + transforms["A"][1]) % p,
+            (transforms["B"][0] * b + transforms["B"][1]) % p,
+            (transforms["C"][0] * c + transforms["C"][1]) % p,
+        ])
+    carried.sort(key=lambda row: row[1])
+    if swap_outer:
+        transformed["seq_coeff"]["A"], transformed["seq_coeff"]["C"] = (
+            transformed["seq_coeff"]["C"], transformed["seq_coeff"]["A"]
+        )
+        transformed["affine"]["A"], transformed["affine"]["C"] = (
+            transformed["affine"]["C"], transformed["affine"]["A"]
+        )
+        transformed["decoys"]["AB"], transformed["decoys"]["BC"] = (
+            transformed["decoys"]["BC"], transformed["decoys"]["AB"]
+        )
+        transformed["salts"]["AA"], transformed["salts"]["CC"] = (
+            transformed["salts"]["CC"], transformed["salts"]["AA"]
+        )
+        carried = [[c, b, a] for a, b, c in carried]
+    transformed["answer"] = carried
+    return transformed
+
+
+def _answer_atoms(answer):
+    if isinstance(answer, dict):
+        return sum(_answer_atoms(value) for value in answer.values())
+    if isinstance(answer, list):
+        return sum(_answer_atoms(value) for value in answer)
+    return 1
+
+
+def selftest():
+    """Run mandatory gates and return a fully JSON-native measurement report."""
+    report = {}
+
+    # G1: every named setting, several independent seeds, plus JSON nativeness.
+    g1_ok = 0
+    g1_total = 0
+    json_ok = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in range(3):
+            inst = make_instance(seed=seed, **params)
+            g1_total += 1
+            if verify(inst, inst["answer"])[0]:
+                g1_ok += 1
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_ok += 1
+    report["G1_planted_verifies"] = {
+        "pass": g1_ok == g1_total and json_ok == g1_total,
+        "verified": g1_ok,
+        "attempts": g1_total,
+        "json_roundtrips": json_ok,
+    }
+
+    shipping = make_instance(seed=1909, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    answer = shipping["answer"]
+    corruptions = {}
+    corruptions["drop_one"] = answer[:-1]
+    swapped = json.loads(json.dumps(answer))
+    swapped[0][0], swapped[1][0] = swapped[1][0], swapped[0][0]
+    corruptions["swap_two"] = swapped
+    duplicated = json.loads(json.dumps(answer))
+    duplicated[1][0] = duplicated[0][0]
+    corruptions["duplicate"] = duplicated
+    corruptions["empty"] = []
+    out_of_range = json.loads(json.dumps(answer))
+    out_of_range[0][2] = shipping["n"]
+    corruptions["out_of_range"] = out_of_range
+    reasons = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
+        reasons[name] = {"rejected": not ok, "reason": reason}
+    distinct_reasons = len({entry["reason"] for entry in reasons.values()})
+    report["G2_rejects_corruption"] = {
+        "pass": all(entry["rejected"] for entry in reasons.values()) and distinct_reasons == 5,
+        "cases": reasons,
+        "distinct_reasons": distinct_reasons,
+    }
+
+    model_style = (
+        "The pure terms cancel over each permutation. My result is:\n"
+        "<answer>```json\n" + json.dumps(answer) + "\n```</answer>\n"
+        "The tags contain only the requested object."
+    )
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(shipping, parsed)[0],
+        "parsed": parsed == answer,
+        "verified": verify(shipping, parsed)[0] if parsed is not None else False,
+    }
+
+    guess_rng = random.Random(14013909)
+    hits = 0
+    g4_start = time.perf_counter()
+    for _ in range(_G4_SAMPLES):
+        if verify(shipping, random_candidate(shipping, guess_rng))[0]:
+            hits += 1
+    g4_elapsed = time.perf_counter() - g4_start
+    probability = hits / _G4_SAMPLES
+    report["G4_guess_resistance"] = {
+        "pass": probability < 1e-6,
+        "hits": hits,
+        "total": _G4_SAMPLES,
+        "observed_probability": probability,
+        "candidate_space": str(search_space(shipping)),
+        "structure_aware_prior": "two independent uniform permutations; B order fixed",
+        "wall_clock_sec": round(g4_elapsed, 6),
+    }
+
+    ref_answer, ref_elapsed, ref_ops, ref_detail = _reference_algorithm(shipping)
+    ref_ok = verify(shipping, ref_answer)[0]
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": probability < 1e-6 and ref_ok and demo_count is not None,
+        "shipping_density_hits": hits,
+        "shipping_density_samples": _G4_SAMPLES,
+        "shipping_observed_fraction": probability,
+        "demo_exact_valid_answers": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "baseline_wall_clock_sec": round(ref_elapsed, 6),
+        "baseline_operations": ref_ops,
+        "baseline_verified": ref_ok,
+        "baseline_detail": ref_detail,
+    }
+
+    attacks = {
+        "outlier_raw_label_alignment": {"successes": 0, "attempts": _ATTACK_SEEDS},
+        "greedy_nearest_unused": {"successes": 0, "attempts": _ATTACK_SEEDS},
+        "random_restart_256": {"successes": 0, "attempts": _ATTACK_SEEDS},
+        "obvious_reverse_raw_labels": {"successes": 0, "attempts": _ATTACK_SEEDS},
+    }
+    reference_successes = 0
+    reference_ops = 0
+    reference_elapsed = 0.0
+    for seed in range(_ATTACK_SEEDS):
+        inst = make_instance(seed=5000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        p = inst["n"]
+        raw_identity = [[b, b, b] for b in range(p)]
+        if verify(inst, raw_identity)[0]:
+            attacks["outlier_raw_label_alignment"]["successes"] += 1
+        greedy = _greedy_nearest_unused(inst)
+        if verify(inst, greedy)[0]:
+            attacks["greedy_nearest_unused"]["successes"] += 1
+        restart_rng = random.Random(900000 + seed)
+        restart_hit = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, restart_rng))[0]:
+                restart_hit = True
+                break
+        if restart_hit:
+            attacks["random_restart_256"]["successes"] += 1
+        raw_reverse = [[p - 1 - b, b, p - 1 - b] for b in range(p)]
+        if verify(inst, raw_reverse)[0]:
+            attacks["obvious_reverse_raw_labels"]["successes"] += 1
+        solved, elapsed, operations, _detail = _reference_algorithm(inst)
+        reference_elapsed += elapsed
+        reference_ops += operations
+        if verify(inst, solved)[0]:
+            reference_successes += 1
+    all_failed = all(item["successes"] == 0 for item in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == _ATTACK_SEEDS,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "two dense Hungarian minimum-cost assignments",
+            "complexity": "O(n^3) exact integer arithmetic",
+            "wall_clock_sec": round(reference_elapsed, 6),
+            "operations": reference_ops,
+            "solves": f"{reference_successes}/{_ATTACK_SEEDS}, as expected",
+        },
+    }
+
+    double_n = _next_prime(2 * shipping["n"])
+    doubled = make_instance(
+        n=double_n,
+        seed=77,
+        decoy_terms=shipping["decoy_terms"],
+        coefficient_span=shipping["coefficient_span"],
+    )
+    named_spaces = [
+        search_space(make_instance(seed=3, **params))
+        for params in DIFFICULTY.values()
+    ]
+    report["G7_scales"] = {
+        "pass": all(a < b for a, b in zip(named_spaces, named_spaces[1:])) and verify(doubled, doubled["answer"])[0],
+        "named_candidate_space_bits": [value.bit_length() for value in named_spaces],
+        "doubled_n": double_n,
+        "doubled_answer_elements": _answer_atoms(doubled["answer"]),
+        "doubled_planted_verifies": verify(doubled, doubled["answer"])[0],
+    }
+
+    invariant = 0
+    carried_ok = 0
+    transformations = 0
+    for seed in range(20):
+        inst = make_instance(seed=7000 + seed, **DIFFICULTY["easy"])
+        rng = random.Random(8000 + seed)
+        transforms = {
+            cls: [rng.randrange(1, inst["n"]), rng.randrange(inst["n"])]
+            for cls in "ABC"
+        }
+        variants = [
+            _transform_affine(inst, transforms, False),
+            _transform_affine(inst, {cls: [1, 0] for cls in "ABC"}, True),
+            _transform_affine(inst, transforms, True),
+        ]
+        for variant in variants:
+            transformations += 1
+            if canonical_key(variant) == canonical_key(inst):
+                invariant += 1
+            if verify(variant, variant["answer"])[0]:
+                carried_ok += 1
+    unrelated = [
+        canonical_key(make_instance(seed=9000 + seed, **DIFFICULTY["easy"]))
+        for seed in range(20)
+    ]
+    distinct = len(set(unrelated))
+    report["G8_canonical_key"] = {
+        "pass": invariant == transformations and carried_ok == transformations and distinct == 20,
+        "invariance_checks": invariant,
+        "invariance_attempts": transformations,
+        "carried_witnesses_verified": carried_ok,
+        "carried_witness_attempts": transformations,
+        "distinct_unrelated": distinct,
+        "distinct_attempts": 20,
+        "symmetries_tested": ["independent affine coordinate relabelling", "A-C reversal", "their composition"],
+    }
+
+    answer_blob = json.dumps(answer, separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _answer_atoms(answer)
+    intended_ops = 2 * (shipping["n"] - 1) + 40
+    arms = {
+        name: {
+            "solved": int(G9_ORACLE_RESULTS[name]["solved"]),
+            "attempts": int(G9_ORACLE_RESULTS[name]["attempts"]),
+        }
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = arms["hinted"]["solved"] / arms["hinted"]["attempts"] if arms["hinted"]["attempts"] else 0.0
+    placebo_rate = arms["placebo"]["solved"] / arms["placebo"]["attempts"] if arms["placebo"]["attempts"] else 0.0
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        isinstance(value, dict) and value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G")
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

