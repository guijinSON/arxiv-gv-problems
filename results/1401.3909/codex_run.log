+    def top_cross(left, right, key):
+        x, y = top[left], top[right]
+        total = (x + y) ** 2
+        for exponent, coefficient in enumerate(decoys[key], start=1):
+            total += coefficient * (x ** exponent + y ** exponent)
+        return total
