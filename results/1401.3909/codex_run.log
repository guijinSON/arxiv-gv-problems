-def _candidate_groups(inst: dict, answer: object) -> tuple[list[list[int]] | None, str]:
-    if not isinstance(answer, list):
-        return None, "answer must be a JSON array"
-    if not answer:
-        return None, "answer is empty"
-    if len(answer) != 2:
-        return None, "coefficient vector must have exactly two entries"
-    if any(isinstance(value, bool) or not isinstance(value, int) for value in answer):
-        return None, "coefficients must be integers"
-    prime = inst["prime"]
-    if any(value < 0 or value >= prime for value in answer):
-        return None, "coefficient is outside the field range"
-    if answer[0] == answer[1]:
-        return None, "the two coefficients must be distinct"
-
-    a, b = answer
-    buckets: dict[int, list[int]] = {}
-    for team, (u, v) in enumerate(inst["tags"]):
-        key = (a * u + b * v) % prime
-        buckets.setdefault(key, []).append(team)
-    if len(buckets) != inst["m"] or any(len(row) != 3 for row in buckets.values()):
-        return None, "coefficient fibers are not all triples"
-    return _canonical_partition(list(buckets.values())), "ok"
-
-
-def _schedule_from_groups(n: int, y_groups: list[list[int]]) -> list[list[tuple[int, bool]]]:
-    """Expand the Section-5 Latin triplet blocks.
-
-    Entries are (opponent_global_id, is_home).  X IDs are 0..n-1 and Y IDs
-    are n..2n-1.
-    """
-
-    m = n // 3
-    x_groups = [[3 * g, 3 * g + 1, 3 * g + 2] for g in range(m)]
-    schedule: list[list[tuple[int, bool] | None]] = [
-        [None] * (2 * n) for _ in range(2 * n)
-    ]
-    for r in range(m):
-        blocks = ((2 * r, r % m, True), (2 * r + 1, (r + 2) % m, False))
-        for block, shift, x_home in blocks:
-            for g in range(m):
-                h = (g + shift) % m
-                for subslot in range(3):
-                    slot = 3 * block + subslot
-                    for member in range(3):
-                        x_team = x_groups[g][member]
-                        y_team = y_groups[h][(member + subslot) % 3]
-                        schedule[x_team][slot] = (n + y_team, x_home)
-                        schedule[n + y_team][slot] = (x_team, not x_home)
-    return [[entry for entry in row if entry is not None] for row in schedule]
-
-
-def _check_schedule(n: int, schedule: list[list[tuple[int, bool]]]) -> tuple[bool, str]:
-    if len(schedule) != 2 * n or any(len(row) != 2 * n for row in schedule):
-        return False, "expanded schedule has the wrong shape"
-
-    for team, row in enumerate(schedule):
-        run = 1
-        for slot, (opponent, is_home) in enumerate(row):
-            if not 0 <= opponent < 2 * n or (team < n) == (opponent < n):
-                return False, "expanded schedule has an invalid opponent"
-            other_opponent, other_home = schedule[opponent][slot]
-            if other_opponent != team or other_home == is_home:
-                return False, "expanded match entries are inconsistent"
-            if slot:
-                if row[slot - 1][0] == opponent:
-                    return False, "expanded schedule violates no-repeat"
-                if row[slot - 1][1] == is_home:
-                    run += 1
-                    if run > 3:
-                        return False, "expanded schedule violates at-most-three"
-                else:
-                    run = 1
-
-    for x_team in range(n):
-        counts: dict[tuple[int, bool], int] = {}
-        for opponent, is_home in schedule[x_team]:
-            key = (opponent - n, is_home)
-            counts[key] = counts.get(key, 0) + 1
-        if len(counts) != 2 * n or any(value != 1 for value in counts.values()):
-            return False, "expanded schedule violates each-venue"
-
-    for slot in range(2 * n):
-        x_status = {schedule[x][slot][1] for x in range(n)}
-        if len(x_status) != 1:
-            return False, "expanded schedule is not uniform"
-    return True, "ok"
-
-
-def _travel_cost(inst: dict, groups: list[list[int]]) -> int:
-    matrix = inst["distance"]
-    perimeter_sum = 0
-    for i, j, k in groups:
-        perimeter_sum += matrix[i][j] + matrix[j][k] + matrix[k][i]
-    return inst["fixed_cost"] + inst["perimeter_multiplier"] * perimeter_sum
-
-
-def verify(inst: dict, answer: object) -> tuple[bool, str]:
-    """Expand and check any valid symbolic witness; never inspect inst['answer']."""
-
-    groups, reason = _candidate_groups(inst, answer)
-    if groups is None:
-        return False, reason
-    schedule = _schedule_from_groups(inst["n"], groups)
-    schedule_ok, schedule_reason = _check_schedule(inst["n"], schedule)
-    if not schedule_ok:
-        return False, schedule_reason
-    cost = _travel_cost(inst, groups)
-    if cost > inst["target"]:
-        return False, f"travel {cost} exceeds target {inst['target']}"
-    return True, "ok"
-
-
-def _fast_valid(inst: dict, answer: object) -> bool:
-    groups, _reason = _candidate_groups(inst, answer)
-    return groups is not None and _travel_cost(inst, groups) <= inst["target"]
-
-
-def random_candidate(inst: dict, rng: random.Random) -> object:
-    """Uniformly sample the stated language of distinct field coefficients."""
-
-    prime = inst["prime"]
-    a = rng.randrange(prime)
-    b_index = rng.randrange(prime - 1)
-    b = b_index if b_index < a else b_index + 1
-    return [a, b]
-
-
-def search_space(inst: dict) -> int | None:
-    prime = inst["prime"]
-    return prime * (prime - 1)
-
-
-def enumerate_all(inst: dict) -> int | None:
-    """Brute-force the certificate language only when explicitly capped."""
-
-    if search_space(inst) > _ENUMERATION_CAP:
-        return None
-    total = 0
-    for a in range(inst["prime"]):
-        for b in range(inst["prime"]):
-            if a != b:
-                total += int(_fast_valid(inst, [a, b]))
-    return total
-
-
-def canonical_key(inst: dict) -> str:
-    """A strong cheap weighted-metric invariant, independent of team labels.
-
-    Full weighted-graph isomorphism is not attempted.  Sorted row multisets are
-    invariant under all tested team permutations and under invertible changes
-    of the public tag-coordinate basis; random tree weights provide diversity.
-    """
-
-    row_profiles = sorted(tuple(sorted(row)) for row in inst["distance"])
-    payload = {
-        "n": inst["n"],
-        "prime": inst["prime"],
-        "fixed_cost": inst["fixed_cost"],
-        "multiplier": inst["perimeter_multiplier"],
-        "target": inst["target"],
-        "rows": row_profiles,
-    }
-    blob = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
-    return hashlib.sha256(blob).hexdigest()
-
-
-def escalate(params: dict) -> dict | str | None:
-    """Enlarge coefficient entropy at fixed two-integer answer length."""
-
-    harder = dict(params)
-    current = int(harder.get("prime", 50_000_017))
-    if current >= 8_000_000_000:
-        return "cap_bound"
-    harder["prime"] = _next_prime(2 * current + 1)
-    harder["weight_scale"] = min(
-        1_000_000, max(1, int(harder.get("weight_scale", 64)) * 2)
-    )
-    return harder
-
-
-def _structural_decode(inst: dict) -> list[int] | None:
-    sum_u = sum(tag[0] for tag in inst["tags"]) % inst["prime"]
-    sum_v = sum(tag[1] for tag in inst["tags"]) % inst["prime"]
-    candidate = [sum_v, (-sum_u) % inst["prime"]]
-    return candidate if _fast_valid(inst, candidate) else None
-
-
-def _intended_operation_bound(inst: dict) -> int:
-    # Two running sums (2n additions), two modular reductions, one negation.
-    return 2 * inst["n"] + 3
-
-
-def _normal_from_pair(inst: dict, i: int, j: int) -> list[int]:
-    prime = inst["prime"]
-    u0, v0 = inst["tags"][i]
-    u1, v1 = inst["tags"][j]
-    return [(v1 - v0) % prime, (u0 - u1) % prime]
-
-
-def _reference_profile_scan(inst: dict) -> tuple[list[int] | None, dict[str, int]]:
-    """Recover tree clusters by exhaustive constant row-difference tests."""
-
-    n = inst["n"]
-    matrix = inst["distance"]
-    neighbours = [set() for _ in range(n)]
-    operations = 0
-    pair_tests = 0
-    for i in range(n):
-        for j in range(i + 1, n):
-            pair_tests += 1
-            deltas = set()
-            for k in range(n):
-                if k != i and k != j:
-                    deltas.add(matrix[i][k] - matrix[j][k])
-                    operations += 1
-            if len(deltas) == 1:
-                neighbours[i].add(j)
-                neighbours[j].add(i)
-
-    unseen = set(range(n))
-    groups: list[list[int]] = []
-    while unseen:
-        root = min(unseen)
-        group = {root} | neighbours[root]
-        if len(group) != 3:
-            return None, {"operations": operations, "pair_tests": pair_tests}
-        groups.append(sorted(group))
-        unseen -= group
-    candidate = _normal_from_pair(inst, groups[0][0], groups[0][1])
-    return candidate, {"operations": operations, "pair_tests": pair_tests}
-
-
-def _attack_candidates(inst: dict, rng: random.Random) -> dict[str, object]:
-    n = inst["n"]
-    matrix = inst["distance"]
-    row_sums = [sum(row) for row in matrix]
-    closest_rows = min(
-        ((abs(row_sums[i] - row_sums[j]), i, j)
-         for i in range(n) for j in range(i + 1, n)),
-        key=lambda item: item,
-    )
-    shortest = min(
-        ((matrix[i][j], i, j)
-         for i in range(n) for j in range(i + 1, n)),
-        key=lambda item: item,
-    )
-    return {
-        "outlier_closest_row_sums": _normal_from_pair(
-            inst, closest_rows[1], closest_rows[2]
-        ),
-        "greedy_shortest_distance_edge": _normal_from_pair(
-            inst, shortest[1], shortest[2]
-        ),
-        "by_hand_equal_tag_sum": [1, 1],
-        "random_projective_256": [
-            random_candidate(inst, rng) for _ in range(256)
-        ],
-    }
-
-
-def _attack_succeeds(inst: dict, candidate: object) -> bool:
-    if isinstance(candidate, list) and candidate and isinstance(candidate[0], list):
-        return any(_fast_valid(inst, item) for item in candidate)
-    return _fast_valid(inst, candidate)
-
-
-def _permuted_instance(inst: dict, rng: random.Random) -> dict:
-    permutation = list(range(inst["n"]))
-    rng.shuffle(permutation)
-    transformed = dict(inst)
-    transformed["tags"] = [inst["tags"][old] for old in permutation]
-    transformed["distance"] = [
-        [inst["distance"][old_i][old_j] for old_j in permutation]
-        for old_i in permutation
-    ]
-    return transformed
-
-
-def _swapped_tag_basis(inst: dict) -> tuple[dict, list[int]]:
-    transformed = dict(inst)
-    transformed["tags"] = [[v, u] for u, v in inst["tags"]]
-    carried = [inst["answer"][1], inst["answer"][0]]
-    return transformed, carried
-
-
-def _atom_count(value: object) -> int:
-    if isinstance(value, dict):
-        return sum(_atom_count(item) for item in value.values())
-    if isinstance(value, (list, tuple)):
-        return sum(_atom_count(item) for item in value)
-    return 1
-
