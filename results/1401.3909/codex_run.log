+def _schedule_from_groups(n: int, y_groups: list[list[int]]) -> list[list[tuple[int, bool]]]:
+    """Expand the Section-5 Latin triplet blocks.
+
+    Entries are (opponent_global_id, is_home).  X IDs are 0..n-1 and Y IDs
+    are n..2n-1.
+    """
+
+    m = n // 3
+    x_groups = [[3 * g, 3 * g + 1, 3 * g + 2] for g in range(m)]
+    schedule: list[list[tuple[int, bool] | None]] = [
+        [None] * (2 * n) for _ in range(2 * n)
+    ]
+    for r in range(m):
+        blocks = ((2 * r, r % m, True), (2 * r + 1, (r + 2) % m, False))
+        for block, shift, x_home in blocks:
+            for g in range(m):
+                h = (g + shift) % m
+                for subslot in range(3):
+                    slot = 3 * block + subslot
+                    for member in range(3):
+                        x_team = x_groups[g][member]
+                        y_team = y_groups[h][(member + subslot) % 3]
+                        schedule[x_team][slot] = (n + y_team, x_home)
+                        schedule[n + y_team][slot] = (x_team, not x_home)
+    return [[entry for entry in row if entry is not None] for row in schedule]
