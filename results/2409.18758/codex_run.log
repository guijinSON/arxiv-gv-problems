+        "base_n": ship_params["n"],
+        "doubled_valid_n": doubled_prime,
+        "doubled_verify": doubled_why,
+        "answer_terms_unchanged": (
+            len(doubled["answer"]) == len(inst["answer"]))
+    }
+
+    invariance = 0
+    carried_checks = 0
+    attempts = 0
+    for seed in range(20):
