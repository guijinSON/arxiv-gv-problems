+def _mod_inv(a: int, p: int, counter: _Counter | None = None) -> int:
+    a %= p
+    if a == 0:
+        raise ZeroDivisionError("zero has no inverse")
+    old_r, r = p, a
+    old_s, s = 0, 1
+    while r:
+        q = old_r // r
+        if counter is not None:
+            counter.euclid_divisions += 1
+        old_r, r = r, old_r - q * r
