+# Replaced with script-owned measurements after the three hardening runs.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 1, "attempts": 3},
+    "placebo": {"solved": 2, "attempts": 3},
