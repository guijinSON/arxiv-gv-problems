import random, time, statistics

def instance(n, k, seed):
    rng = random.Random(seed)
    plant = rng.sample(range(n), k)
    red = [bytearray(n) for _ in range(n)]
    forced = {tuple(sorted((plant[i], plant[(i+1)%k]))) for i in range(k)}
    for u in range(n):
        for v in range(u+1,n):
            c = (u,v) in forced or rng.randrange(2)==0
            red[u][v]=red[v][u]=c
    return red, plant

def greedy(red, k, seed, restarts=32):
    rng=random.Random(seed)
    n=len(red); probes=0
    for r in range(restarts):
        path=[rng.randrange(n)]; used={path[0]}
        while len(path)<k:
            candidates=list(range(n)); rng.shuffle(candidates)
            nxt=None
            for v in candidates:
                if v in used: continue
                probes += 1
                if red[path[-1]][v]: nxt=v; break
            if nxt is None: break
            path.append(nxt); used.add(nxt)
        if len(path)==k:
            probes += 1
            if red[path[-1]][path[0]]:
                return path, probes, r+1
    return None, probes, restarts

rows=[]
start=time.perf_counter()
for seed in range(20):
    red, plant=instance(256,64,seed)
    t=time.perf_counter(); ans, probes, restarts=greedy(red,64,10_000+seed); elapsed=time.perf_counter()-t
    ok=ans is not None and len(set(ans))==64 and all(red[ans[i]][ans[(i+1)%64]] for i in range(64))
    rows.append((ok,probes,restarts,elapsed, ans==plant))
print('successes',sum(x[0] for x in rows),'attempts',len(rows))
print('edge_probes_min_median_max',min(x[1] for x in rows),statistics.median(x[1] for x in rows),max(x[1] for x in rows))
print('restarts_min_median_max',min(x[2] for x in rows),statistics.median(x[2] for x in rows),max(x[2] for x in rows))
print('wall_sec_total',time.perf_counter()-start)
print('greedy_wall_min_median_max',min(x[3] for x in rows),statistics.median(x[3] for x in rows),max(x[3] for x in rows))
print('returned_planted_order',sum(x[4] for x in rows))
