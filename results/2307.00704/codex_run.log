+    "Numeric-outlier and endpoint-average attacks see only the relabeling; a bounded "
+    "greedy walk cannot reach the middle; random oriented-edge restarts almost never "
+    "hit it. Binary composition of the affine update is the compact intended route."
+)
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_GUESS_SAMPLES = 200_000
+_AUDIT_SEEDS = tuple(range(800, 808))
+
+# Filled from the script-owned transcripts after the oracle runs.  API errors are
+# not attempts.  These values are diagnostic only; G9's gate is the size/effort cap.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0, "service_errors": 0},
+    "hinted": {"solved": 0, "attempts": 0, "service_errors": 0},
+    "placebo": {"solved": 0, "attempts": 0, "service_errors": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_bits(n):
+    if not _is_int(n) or n < 5 or n > 49:
+        raise ValueError("n must be an integer in [5,49]")
+
+
+def _compose(left_a, left_b, right_a, right_b, modulus):
+    """Return left(right(x)) as an affine pair, exactly modulo modulus."""
+    return (
+        (left_a * right_a) % modulus,
+        (left_a * right_b + left_b) % modulus,
+    )
+
+
+def _affine_power(a, b, exponent, modulus):
+    """Return (A,B) with f**exponent(x)=A*x+B modulo modulus."""
+    result_a, result_b = 1, 0
+    base_a, base_b = a % modulus, b % modulus
+    e = exponent
+    while e:
+        if e & 1:
+            result_a, result_b = _compose(
+                base_a, base_b, result_a, result_b, modulus
+            )
+        base_a, base_b = _compose(
+            base_a, base_b, base_a, base_b, modulus
+        )
+        e >>= 1
+    return result_a, result_b
+
+
+def _jump_values(a, b, start, exponent, modulus):
+    power_a, power_b = _affine_power(a, b, exponent, modulus)
+    return (power_a * start + power_b) % modulus
+
+
+def _jump(inst, exponent):
+    return _jump_values(
+        inst["multiplier"],
+        inst["increment"],
+        inst["start"],
+        exponent,
+        inst["modulus"],
+    )
+
+
+def _step(inst, label):
+    return (
+        inst["multiplier"] * label + inst["increment"]
+    ) % inst["modulus"]
+
+
+def _inverse_step(inst, label):
+    modulus = inst["modulus"]
+    inverse = pow(inst["multiplier"], -1, modulus)
+    return (inverse * (label - inst["increment"])) % modulus
+
+
+def _weight_from_coefficients(coefficients, distance):
+    c0, c1, c2 = coefficients
+    return c0 + c1 * distance + c2 * distance * distance
+
+
+def _weight(inst, index):
+    n_vertices = inst["vertex_count"]
+    distance = min(index, n_vertices - 1 - index)
+    return _weight_from_coefficients(inst["weight_coefficients"], distance)
+
+
+def _sum_polynomial_weights(coefficients, count):
+    """sum_{d=0}^{count-1} c0+c1*d+c2*d^2, exactly."""
+    c0, c1, c2 = coefficients
+    linear = count * (count - 1) // 2
+    squares = count * (count - 1) * (2 * count - 1) // 6
+    return c0 * count + c1 * linear + c2 * squares
+
+
+def _weight_totals(bits, coefficients):
+    # vertex_count = 2*h+1; distances 0,...,h-1 occur twice and h once.
+    modulus = 1 << bits
+    h = modulus // 2 - 1
+    half = _sum_polynomial_weights(coefficients, h)
+    center_weight = _weight_from_coefficients(coefficients, h)
+    return half, center_weight, 2 * half + center_weight
+
+
+def make_instance(n, seed=0, **params):
+    """Construct a succinct corridor path and its Lemma 8 witness.
+
+    The full-period recurrence and symmetric positive weights are sampled first.
+    The unique central label is obtained by composing the recurrence, an identity
+    valid independently of the certificate search problem.  No centroid scan or
+    answer search is performed during generation.
+    """
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_bits(n)
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    modulus = 1 << n
+    # Hull-Dobell for modulus 2^n: b odd and a == 1 (mod 4) give one full cycle.
+    multiplier = 1 + 4 * rng.randrange(1, modulus // 4)
+    increment = 2 * rng.randrange(modulus // 2) + 1
+    start = rng.randrange(modulus)
+
+    # Wide coefficient ranges make structurally unrelated seeds distinct.  All
+    # coefficients are positive, which makes the central weighted centroid unique.
+    coefficients = [rng.randrange(1, 1_000_000_001) for _ in range(3)]
+
+    vertex_count = modulus - 1
+    middle_index = (vertex_count - 1) // 2
+    end = _jump_values(
+        multiplier, increment, start, vertex_count - 1, modulus
+    )
+    excluded = _jump_values(
+        multiplier, increment, start, vertex_count, modulus
+    )
+    centroid = _jump_values(
+        multiplier, increment, start, middle_index, modulus
+    )
+    neighbor = (multiplier * centroid + increment) % modulus
+    half_weight, center_weight, total_weight = _weight_totals(n, coefficients)
+
+    return {
+        "paper_object": "Lemma 8 exchange separator in corridor tree T(P)",
+        "bits": n,
+        "modulus": modulus,
+        "vertex_count": vertex_count,
+        "multiplier": multiplier,
+        "increment": increment,
+        "start": start,
+        "end": end,
+        "excluded_label": excluded,
+        "weight_coefficients": coefficients,
+        "half_weight": half_weight,
+        "center_weight": center_weight,
+        "total_weight": total_weight,
+        "answer": {"centroid": centroid, "neighbor": neighbor},
+    }
+
+
+def _answer_json(answer):
+    return json.dumps(answer, separators=(",", ":"), sort_keys=True)
+
+
+def render(inst):
+    hint = ""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        hint = "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        hint = "\n\nHint: " + PLACEBO_HINT
+
+    text = f"""Corridor-tree exchange separator
+
+This is the weighted corridor-tree subproblem used by Lemma 8 of the paper's
+recombination algorithm.  A corridor tree is a tree whose vertices represent
+polygonal pieces and whose edges represent zero-area corridors.  A vertex's
+positive integer weight is the area of its represented piece.
+
+The instance below defines a path T with N={inst['vertex_count']} vertices by a
+succinct, exact recurrence.  All arithmetic in the recurrence is modulo
+M={inst['modulus']}.
+
+  v_0 = {inst['start']}
+  v_(i+1) = ({inst['multiplier']} * v_i + {inst['increment']}) mod {inst['modulus']}
+  indices are 0-based, and 0 <= i < N-1
+
+The vertex labels are v_0,...,v_(N-1); the undirected edges are exactly
+{{v_i,v_(i+1)}} for 0 <= i < N-1.  These labels are distinct.  The unused
+residue is {inst['excluded_label']}, and v_(N-1)={inst['end']}.
+
+For a vertex at path index i, put d=min(i,N-1-i).  Its weight is
+
+  w(i) = {inst['weight_coefficients'][0]}
+       + {inst['weight_coefficients'][1]}*d
+       + {inst['weight_coefficients'][2]}*d^2.
+
+The total weight is W={inst['total_weight']}.
+
+A weighted centroid c is a vertex such that, after deleting c, every connected
+component has weight at most W/2.  Root T at c.  If s is a neighbor of c, define
+T*(c,s) to contain c and every vertex in the component containing s after c is
+deleted.  On a path this is a contiguous subtree in the rotation order of the
+centroid, as required by Lemma 8.
+
+Find any ordered pair (c,s) such that:
+  1. c is a weighted centroid;
+  2. s is a neighbor of c;
+  3. T*(c,s) contains at least N/3 vertices; and
+  4. weight(T*(c,s)) <= W/2 + w(c).
+
+The roles are ordered: the first label is the centroid and the second selects a
+side.  Labels are integers, repetitions are not allowed, and both inequalities
+are inclusive.  Either side is acceptable when both sides satisfy the rules.
+
+Give your final answer inside <answer></answer> tags as one JSON object with
+exactly the integer fields \"centroid\" and \"neighbor\".
+Example: <answer>{{\"centroid\":17,\"neighbor\":4}}</answer>
+Output nothing else inside the tags."""
+    return text + hint
+
+
+def parse_answer(text):
+    """Extract the required JSON object; return None on every malformed input."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    if payload.startswith("```"):
+        payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
+        payload = re.sub(r"\s*```$", "", payload)
+    try:
+        answer = json.loads(payload)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(answer, dict):
+        return None
+    if set(answer) != {"centroid", "neighbor"}:
+        return None
+    if not _is_int(answer["centroid"]) or not _is_int(answer["neighbor"]):
+        return None
+    return answer
+
+
+def _expected_centroid(inst):
+    return _jump(inst, (inst["vertex_count"] - 1) // 2)
+
+
+def verify(inst, answer):
+    """Check any valid oriented Lemma 8 separator, never the planted answer."""
+    if answer == {} or answer == [] or answer == "":
+        return False, "answer is empty"
+    if not isinstance(answer, dict) or set(answer) != {"centroid", "neighbor"}:
+        return False, "answer must have exactly the centroid and neighbor fields"
+    centroid = answer["centroid"]
+    neighbor = answer["neighbor"]
+    if not _is_int(centroid) or not _is_int(neighbor):
+        return False, "both labels must be integers"
+    modulus = inst["modulus"]
+    if not 0 <= centroid < modulus:
+        return False, "centroid label is outside the allowed residue range"
+    if not 0 <= neighbor < modulus:
+        return False, "neighbor label is outside the allowed residue range"
+    if centroid == inst["excluded_label"] or neighbor == inst["excluded_label"]:
+        return False, "the unused residue is not a vertex of the corridor tree"
+    if centroid == neighbor:
+        return False, "centroid and neighbor must be distinct"
+
+    actual_centroid = _expected_centroid(inst)
+    if centroid != actual_centroid:
+        return False, "the first label is not the unique weighted centroid"
+
+    previous_label = _inverse_step(inst, centroid)
+    next_label = _step(inst, centroid)
+    if neighbor not in (previous_label, next_label):
+        return False, "the second label is not adjacent to the centroid"
+
+    # The positive mirror-symmetric weights give equal left/right component
+    # weights.  Verify all four Lemma 8 requirements from exact closed forms.
+    n_vertices = inst["vertex_count"]
+    side_vertices = (n_vertices - 1) // 2
+    side_weight = _sum_polynomial_weights(
+        inst["weight_coefficients"], side_vertices
+    )
+    center_weight = _weight_from_coefficients(
+        inst["weight_coefficients"], side_vertices
+    )
+    total_weight = 2 * side_weight + center_weight
+    if total_weight != inst["total_weight"]:
+        return False, "instance total weight is inconsistent"
+    if 2 * side_weight > total_weight:
+        return False, "deleting the proposed centroid leaves an overweight component"
+    selected_vertices = side_vertices + 1
+    if 3 * selected_vertices < n_vertices:
+        return False, "selected contiguous subtree has fewer than N/3 vertices"
+    selected_weight = side_weight + center_weight
+    if 2 * selected_weight > total_weight + 2 * center_weight:
+        return False, "selected contiguous subtree exceeds W/2 plus w(c)"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample an oriented edge, the statement's obvious shape prior."""
+    edge_index = rng.randrange(inst["vertex_count"] - 1)
+    left = _jump(inst, edge_index)
+    right = _step(inst, left)
+    if rng.randrange(2):
+        left, right = right, left
+    return {"centroid": left, "neighbor": right}
+
+
+def search_space(inst):
+    return 2 * (inst["vertex_count"] - 1)
+
+
+def enumerate_all(inst):
+    """Brute-force all oriented edges only for genuinely small demo instances."""
+    if search_space(inst) > 20_000:
+        return None
+    count = 0
+    label = inst["start"]
+    for _ in range(inst["vertex_count"] - 1):
+        nxt = _step(inst, label)
+        for candidate in (
+            {"centroid": label, "neighbor": nxt},
+            {"centroid": nxt, "neighbor": label},
+        ):
+            if verify(inst, candidate)[0]:
+                count += 1
+        label = nxt
+    return count
+
+
+def canonical_key(inst):
+    """Canonical under arbitrary label renaming and reversal of the corridor path.
+
+    An unlabeled path with these mirror-symmetric weights is determined by its
+    length and polynomial weight sequence.  The affine presentation is only a
+    vertex relabeling and is therefore deliberately absent from this key.
+    """
+    structural = {
+        "vertex_count": inst["vertex_count"],
+        "weight_coefficients": list(inst["weight_coefficients"]),
+    }
+    blob = json.dumps(structural, separators=(",", ":"), sort_keys=True)
+    return "corridor-path:" + hashlib.sha256(blob.encode("ascii")).hexdigest()
+
+
+def escalate(params):
+    """Double the represented path while the two-label certificate stays fixed."""
+    if not isinstance(params, dict) or "n" not in params:
+        return None
+    n = params["n"]
+    if not _is_int(n):
+        return None
+    if n >= 49:
+        return None
+    return {"n": n + 1}
+
+
+def _affine_relabel(inst, unit, translation):
+    """Apply y=unit*x+translation to every vertex label and carry the witness."""
+    modulus = inst["modulus"]
+    if math.gcd(unit, modulus) != 1:
+        raise ValueError("unit must be invertible modulo the modulus")
+    out = dict(inst)
+    out["increment"] = (
+        unit * inst["increment"] + (1 - inst["multiplier"]) * translation
+    ) % modulus
+    out["start"] = (unit * inst["start"] + translation) % modulus
+    out["end"] = (unit * inst["end"] + translation) % modulus
+    out["excluded_label"] = (
+        unit * inst["excluded_label"] + translation
+    ) % modulus
+    out["answer"] = {
+        "centroid": (unit * inst["answer"]["centroid"] + translation) % modulus,
+        "neighbor": (unit * inst["answer"]["neighbor"] + translation) % modulus,
+    }
+    return out
+
+
+def _reverse_path(inst):
+    """Reverse the path presentation while leaving its labelled graph unchanged."""
+    modulus = inst["modulus"]
+    inverse = pow(inst["multiplier"], -1, modulus)
+    out = dict(inst)
+    out["multiplier"] = inverse
+    out["increment"] = (-inverse * inst["increment"]) % modulus
+    out["start"], out["end"] = inst["end"], inst["start"]
+    out["answer"] = dict(inst["answer"])
+    return out
+
+
+def _reference_linear_centroid(inst):
+    """Paper's O(N) greedy centroid route, specialized only to path adjacency."""
+    total = inst["total_weight"]
+    n_vertices = inst["vertex_count"]
+    label = inst["start"]
+    left_weight = 0
+    visits = 0
+    for index in range(n_vertices):
+        visits += 1
+        here_weight = _weight(inst, index)
+        right_weight = total - left_weight - here_weight
+        if 2 * left_weight <= total and 2 * right_weight <= total:
+            neighbor = _step(inst, label) if index + 1 < n_vertices else _inverse_step(inst, label)
+            return {"centroid": label, "neighbor": neighbor}, visits
+        left_weight += here_weight
+        label = _step(inst, label)
+    return None, visits
+
+
+def _attack_numeric_middle(inst):
+    centroid = inst["modulus"] // 2
+    if centroid == inst["excluded_label"]:
+        centroid = (centroid + 1) % inst["modulus"]
+    return {"centroid": centroid, "neighbor": _step(inst, centroid)}
+
+
+def _attack_endpoint_average(inst):
+    centroid = (inst["start"] + inst["end"]) // 2
+    if centroid == inst["excluded_label"]:
+        centroid = (centroid + 1) % inst["modulus"]
+    return {"centroid": centroid, "neighbor": _step(inst, centroid)}
+
+
+def _attack_bounded_walk(inst, budget=4096):
+    exponent = min(budget, inst["vertex_count"] - 2)
+    centroid = inst["start"]
+    for _ in range(exponent):
+        centroid = _step(inst, centroid)
+    return {"centroid": centroid, "neighbor": _step(inst, centroid)}
+
+
+def _attack_random_restarts(inst, rng, attempts=2048):
+    last = None
+    for _ in range(attempts):
+        last = random_candidate(inst, rng)
+        if verify(inst, last)[0]:
+            return last
+    return last
+
+
+def _count_atoms(value):
+    if isinstance(value, dict):
+        return sum(_count_atoms(v) for v in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_count_atoms(v) for v in value)
+    return 1
+
+
+def _token_estimate(blob):
+    # Conservative tokenizer-independent measurement for this tiny JSON object.
+    return len(re.findall(r"[A-Za-z_]+|\d+|[^\w\s]", blob))
+
+
+def selftest():
+    report = {}
+
+    # G1: every preset, three independent seeds.
+    failures = []
+    checked = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            checked += 1
+            if not ok:
+                failures.append({"preset": preset, "seed": seed, "reason": reason})
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append({"preset": preset, "seed": seed, "reason": "answer is not JSON-native"})
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "checked": checked,
+        "failures": failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=42, **shipping_params)
+    planted = inst["answer"]
+
+    # G2: deliberately distinct corruptions and deliberately distinct reasons.
+    corruptions = {
+        "drop_one": {"centroid": planted["centroid"]},
+        "swap_roles": {"centroid": planted["neighbor"], "neighbor": planted["centroid"]},
+        "duplicate": {"centroid": planted["centroid"], "neighbor": planted["centroid"]},
+        "empty": {},
+        "out_of_range": {"centroid": inst["modulus"], "neighbor": planted["neighbor"]},
+        "unused_residue": {"centroid": planted["centroid"], "neighbor": inst["excluded_label"]},
+    }
+    cases = {}
+    reasons = []
+    for name, bad in corruptions.items():
+        ok, reason = verify(inst, bad)
+        cases[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": all(x["rejected"] for x in cases.values()) and len(set(reasons)) == len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "cases": cases,
+    }
+
+    # G3: realistic prose and a markdown fence inside the mandated tags.
+    response = (
+        "The symmetric path has a unique centre.\n\n"
+        "<answer>```json\n" + _answer_json(planted) + "\n```</answer>\n"
+        "This selects the forward side."
+    )
+    parsed = parse_answer(response)
+    rt_ok, rt_reason = verify(inst, parsed) if parsed is not None else (False, "parse failed")
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and rt_ok,
+        "verify_reason": rt_reason,
+    }
+
+    # G4/G5 density: uniform over the exact structure-aware language of oriented edges.
+    guess_rng = random.Random(230700704)
+    hits = 0
+    for _ in range(_GUESS_SAMPLES):
+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            hits += 1
+    candidate_space = search_space(inst)
+    probability = hits / _GUESS_SAMPLES
+    report["G4_guess_resistance"] = {
+        "pass": probability < 1e-6 and _GUESS_SAMPLES >= 200_000,
+        "hits": hits,
+        "total": _GUESS_SAMPLES,
+        "measured_probability": probability,
+        "candidate_space": candidate_space,
+        "sampler": "uniform oriented edges of the stated corridor path",
+        "exact_valid_answers": 2,
+        "exact_density": 2 / candidate_space,
+    }
+
+    demo = make_instance(seed=3, **DIFFICULTY["demo"])
+    demo_exact = enumerate_all(demo)
+
+    # Strong failing baseline and the successful Track B reference method.
+    baseline_times = []
+    baseline_successes = 0
+    for seed in _AUDIT_SEEDS:
+        audit_inst = make_instance(seed=seed, **shipping_params)
+        t0 = time.perf_counter()
+        guess = _attack_bounded_walk(audit_inst, budget=65_536)
+        baseline_times.append(time.perf_counter() - t0)
+        baseline_successes += int(verify(audit_inst, guess)[0])
+
+    reference_times = []
+    reference_visits = []
+    reference_successes = 0
+    for seed in _AUDIT_SEEDS:
+        audit_inst = make_instance(seed=seed, **shipping_params)
+        t0 = time.perf_counter()
+        witness, visits = _reference_linear_centroid(audit_inst)
+        reference_times.append(time.perf_counter() - t0)
+        reference_visits.append(visits)
+        reference_successes += int(witness is not None and verify(audit_inst, witness)[0])
+
+    report["G5_density_and_baseline"] = {
+        "pass": (
+            demo_exact == 2
+            and baseline_successes == 0
+            and reference_successes == len(_AUDIT_SEEDS)
+        ),
+        "shipping_density_hits": hits,
+        "shipping_density_samples": _GUESS_SAMPLES,
+        "shipping_solution_fraction_estimate": probability,
+        "shipping_exact_density_by_symmetry": 2 / candidate_space,
+        "demo_candidate_space": search_space(demo),
+        "demo_exact_valid_answers": demo_exact,
+        "strongest_failing_attack": "bounded recurrence walk of 65,536 vertices",
+        "baseline_successes": baseline_successes,
+        "baseline_attempts": len(_AUDIT_SEEDS),
+        "baseline_iterations_each": 65_536,
+        "baseline_wall_clock_sec_mean": sum(baseline_times) / len(baseline_times),
+        "baseline_wall_clock_sec_max": max(baseline_times),
+        "reference_successes": reference_successes,
+        "reference_attempts": len(_AUDIT_SEEDS),
+        "reference_vertex_visits_mean": sum(reference_visits) / len(reference_visits),
+        "reference_exact_operations_estimate": 7 * reference_visits[0],
+        "reference_wall_clock_sec_mean": sum(reference_times) / len(reference_times),
+        "reference_wall_clock_sec_max": max(reference_times),
+    }
+
+    # G6: attacks that a no-tool solver can attempt all fail.  The successful
+    # standard method is kept out of attacks, as Track B requires.
+    attack_results = {
+        "outlier_numeric_middle": {"successes": 0, "attempts": 0},
+        "greedy_recurrence_walk_4096": {"successes": 0, "attempts": 0},
+        "random_oriented_edge_restart_2048": {"successes": 0, "attempts": 0},
+        "in_context_endpoint_average": {"successes": 0, "attempts": 0},
+    }
+    for seed in _AUDIT_SEEDS:
+        audit_inst = make_instance(seed=seed, **shipping_params)
+        attack_candidates = {
+            "outlier_numeric_middle": _attack_numeric_middle(audit_inst),
+            "greedy_recurrence_walk_4096": _attack_bounded_walk(audit_inst, 4096),
+            "random_oriented_edge_restart_2048": _attack_random_restarts(
+                audit_inst, random.Random(900_000 + seed), 2048
+            ),
