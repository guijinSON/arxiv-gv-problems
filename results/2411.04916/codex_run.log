+        "swap_two_positions": [planted[1], planted[0], *planted[2:]],
+        "duplicate_index": [planted[0], planted[0], *planted[2:]],
+        "empty": [],
+        "out_of_range": [*planted[:-1], 3 * probe["n"]],
