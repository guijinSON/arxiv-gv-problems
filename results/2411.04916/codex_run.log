+    reasons = [entry["reason"] for entry in g2_results.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(entry["rejected"] for entry in g2_results.values())
+        and len(set(reasons)) == len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "cases": g2_results,
+    }
