+        instance = make_instance(n=24, seed=70_000 + seed, degree=5, mix_factor=20)
+        key = canonical_key(instance)
+        keys.append(key)
+        relabel_rng = random.Random(80_000 + seed)
+        permutation = list(range(instance["n"]))
