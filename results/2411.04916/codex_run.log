/bin/bash -lc "python3 - <<'PY'
import random
import gen_2411_04916 as g
for name in ('easy','medium','hard'):
    stats={k:0 for k in ('outlier','greedy','restart')}
    for seed in range(100,108):
        i=g.make_instance(seed=seed,**g.DIFFICULTY[name])
        stats['outlier'] += g.verify(i,g._outlier_attack(i))[0]
        stats['greedy'] += g.verify(i,g._greedy_attack(i))[0]
        stats['restart'] += g.verify(i,g._random_restart_attack(i,random.Random(900000+seed)))[0]
    print(name,stats)
