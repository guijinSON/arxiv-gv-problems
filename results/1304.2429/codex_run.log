+def _answer_valid_with_maps(inst, answer, maps):
+    """Fast exact check for well-shaped sampled candidates with a shared index."""
+
+    if not isinstance(answer, dict) or set(answer) != set(LEAVES):
+        return False
+    return all(_leaf_valid(inst, leaf, answer[leaf], maps=maps) for leaf in LEAVES)
+
