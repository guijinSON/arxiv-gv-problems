+        transformed = inverse_graph
+        inverted = []
+        for a, b in maps:
+            a_inv = pow(a, -1, p)
+            inverted.append([a_inv, (-a_inv * b) % p])
+        maps = inverted
+    rows = [[x, list(neighbors)] for x, neighbors in transformed.items()]
