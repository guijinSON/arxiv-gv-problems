+        "demo_exact_solution_count": enumerate_all(demo),
+        "baseline_wall_clock_seconds": round(reference_sec, 6),
+        "baseline_edge_membership_probes": reference_ops,
+        "baseline_algorithm": "exhaustive affine-map scan",
+    }
+
+    attacks = {
+        "outlier_target_indegree": {"successes": 0, "attempts": 8},
+        "greedy_lexicographic_pair": {"successes": 0, "attempts": 8},
+        "random_restart_256": {"successes": 0, "attempts": 8},
+        "translation_ansatz": {"successes": 0, "attempts": 8},
+    }
+    ref_success = 0
+    ref_ops = []
+    ref_seconds = []
+    for seed in range(800, 808):
+        instance = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        probes = {
+            "outlier_target_indegree": _outlier_candidate(instance),
+            "greedy_lexicographic_pair": _greedy_candidate(instance),
+            "translation_ansatz": _translation_candidate(instance),
