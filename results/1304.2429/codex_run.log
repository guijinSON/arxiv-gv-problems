+def _attack_outlier_frequency(inst):
+    maps = _instance_maps(inst)
+    _coord_by_id, _id_by_coord, adjacency, _row_order = maps
+    frequency = {leaf: {} for leaf in LEAVES}
+    for leaf in LEAVES:
+        for targets in adjacency[leaf].values():
+            for target in targets:
+                frequency[leaf][target] = frequency[leaf].get(target, 0) + 1
+
+    def select(leaf, _index, values, local_maps):
+        coord_by_id, id_by_coord, _adj, _rows = local_maps
+        return min(
+            values,
+            key=lambda coord: (frequency[leaf][id_by_coord[leaf][coord]], id_by_coord[leaf][coord]),
+        )
+
+    return _derive_from_selector(inst, select)
+
+
+def _attack_greedy_lexicographic(inst):
+    return _derive_from_selector(
+        inst, lambda _leaf, _index, values, _maps: min(values)
+    )
+
+
+def _attack_random_basis(inst, rng, attempts):
+    maps = _instance_maps(inst)
+    choices = {
+        leaf: _basis_neighbor_coords(inst, leaf, maps=maps, ordered=True)
+        for leaf in LEAVES
+    }
+    last = None
+    for _ in range(attempts):
+        candidate = {}
+        for leaf in LEAVES:
+            images = [rng.choice(values) for values in choices[leaf]]
+            candidate[leaf] = _cert_from_images(images, inst["field_order"])
+        last = candidate
+        if verify(inst, candidate)[0]:
+            return candidate, True
+    return last, False
+
+
+def _attack_identity_ansatz(inst):
+    maps = _instance_maps(inst)
+    choices = {
+        leaf: _basis_neighbor_coords(inst, leaf, maps=maps, ordered=False)[0]
+        for leaf in LEAVES
     }
+    ident = _identity()
+    for left_b in choices["L"]:
+        for right_b in choices["R"]:
+            candidate = {"L": _cert(ident, left_b), "R": _cert(ident, right_b)}
+            if verify(inst, candidate)[0]:
+                return candidate
+    return {"L": _cert(ident, choices["L"][0]), "R": _cert(ident, choices["R"][0])}
 
 
