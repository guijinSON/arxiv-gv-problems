+            "operation_unit": "finite-field arithmetic operations across eight shipping instances",
+            "candidate_matrices": total_reference_candidates,
+            "edge_membership_tests": total_reference_edges,
+            "per_instance_field_operations": [item["field_operations"] for item in reference_metrics],
+        },
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] = _next_prime(2 * shipping_params["n"])
+    scale_started = time.perf_counter()
+    doubled = make_instance(seed=314159, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    scale_seconds = time.perf_counter() - scale_started
+    report["G7_scales"] = {
+        "pass": doubled_ok and search_space(doubled) > search_space(shipping),
+        "shipping_field_order": shipping_params["n"],
+        "shipping_class_size": shipping_params["n"] ** DIMENSION,
+        "doubled_field_order": doubled_params["n"],
+        "doubled_class_size": doubled_params["n"] ** DIMENSION,
+        "candidate_space_log2_shipping": round(math.log2(search_space(shipping)), 3),
+        "candidate_space_log2_doubled": round(math.log2(search_space(doubled)), 3),
+        "build_and_verify_wall_clock_sec": round(scale_seconds, 6),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    real_transformations = 0
+    key_failures = []
+    g8_params = {"n": 5, "degree": 7}
+    for seed in range(20):
+        base = make_instance(seed=50_000 + seed, **g8_params)
+        base_key = canonical_key(base)
+        for index, options in enumerate((
+            {"relabel_ids": True, "reorder": True},
