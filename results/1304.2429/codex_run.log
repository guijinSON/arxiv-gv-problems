+    p = data["p"]
+    u, w = rng.randrange(1, p), rng.randrange(1, p)
+    v, z = rng.randrange(p), rng.randrange(p)
+    transformed = {}
+    for x, neighbors in data["adjacency"].items():
+        nx = (u * x + v) % p
+        transformed[nx] = {(w * y + z) % p for y in neighbors}
+    maps = []
