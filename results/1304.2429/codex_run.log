+def _sample_translation_pair(rng, coordinates, degree, q):
+    """Sample two spanning sets with the minimum possible nonempty overlap."""
 
+    overlap_size = max(1, 2 * degree - len(coordinates))
+    while True:
+        shared = rng.sample(coordinates, overlap_size)
+        remaining = [point for point in coordinates if point not in set(shared)]
+        left_only = rng.sample(remaining, degree - overlap_size)
+        left_only_set = set(left_only)
+        right_pool = [point for point in remaining if point not in left_only_set]
+        right_only = rng.sample(right_pool, degree - overlap_size)
+        left = shared + left_only
+        right = shared + right_only
+        rng.shuffle(left)
+        rng.shuffle(right)
+        if _affinely_spans(left, q) and _affinely_spans(right, q):
+            return {"L": left, "R": right}, shared
 
