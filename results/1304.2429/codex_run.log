+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    """Extract the final tagged JSON certificate; return None on all garbage."""
+
+    if not isinstance(text, str):
+        return None
+    blocks = _ANSWER_RE.findall(text)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    fenced = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
+    if fenced:
+        body = fenced.group(1).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _instance_maps(inst):
+    coord_by_id = {}
+    id_by_coord = {}
+    for part, records in inst["vertices"].items():
+        coord_by_id[part] = {record["id"]: tuple(record["coord"]) for record in records}
+        id_by_coord[part] = {tuple(record["coord"]): record["id"] for record in records}
+    adjacency = {}
+    row_order = {}
+    for superedge in inst["superedges"]:
+        leaf = superedge["leaf"]
+        adjacency[leaf] = {
+            row["center"]: set(row["neighbors"]) for row in superedge["rows"]
+        }
+        row_order[leaf] = {
+            row["center"]: list(row["neighbors"]) for row in superedge["rows"]
+        }
+    return coord_by_id, id_by_coord, adjacency, row_order
+
+
+def _normalise_cert(cert, leaf, q):
+    if not isinstance(cert, dict) or set(cert) != {"matrix", "offset"}:
+        return None, f"{leaf} certificate must have exactly matrix and offset"
+    matrix = cert["matrix"]
+    offset = cert["offset"]
+    if (
+        not isinstance(matrix, list)
+        or len(matrix) != DIMENSION
+        or any(not isinstance(row, list) or len(row) != DIMENSION for row in matrix)
+    ):
+        return None, f"{leaf} matrix must have shape 3x3"
+    if not isinstance(offset, list) or len(offset) != DIMENSION:
+        return None, f"{leaf} offset must have length 3"
+    values = [value for row in matrix for value in row] + list(offset)
+    if any(not _is_int(value) for value in values):
+        return None, f"{leaf} coefficients must be JSON integers"
+    if any(value < 0 or value >= q for value in values):
+        return None, f"{leaf} coefficient is outside 0..{q - 1}"
+    if not _det3(matrix, q):
+        return None, f"{leaf} matrix is singular modulo {q}"
+    return (matrix, tuple(offset)), None
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check affine bijectivity and every selected graph edge; ignore the plant."""
+
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer object is empty"
+    if set(answer) != set(LEAVES):
+        return False, "answer must contain exactly the two keys L and R"
+    q = inst["field_order"]
+    coord_by_id, id_by_coord, adjacency, _ = _instance_maps(inst)
+    for leaf in LEAVES:
+        normalised, reason = _normalise_cert(answer[leaf], leaf, q)
+        if normalised is None:
+            return False, reason
+        matrix, offset = normalised
+        for center_id, source in coord_by_id["C"].items():
+            target = _vadd(_mat_vec(matrix, source, q), offset, q)
+            target_id = id_by_coord[leaf].get(target)
+            if target_id is None or target_id not in adjacency[leaf].get(center_id, set()):
+                return False, (
+                    f"{leaf} affine map selects a non-edge at center coordinate "
+                    f"{_format_coord(source)}"
+                )
+    return True, "ok"
+
+
+def _random_gl(q, rng):
+    while True:
+        matrix = [
+            [rng.randrange(q) for _ in range(DIMENSION)]
+            for _ in range(DIMENSION)
+        ]
+        if _det3(matrix, q):
+            return matrix
+
+
+def random_candidate(inst, rng) -> object:
+    """Sample uniformly from two affine bijections, enforcing the stated shape."""
+
+    q = inst["field_order"]
+    return {
+        leaf: {
+            "matrix": _random_gl(q, rng),
+            "offset": [rng.randrange(q) for _ in range(DIMENSION)],
+        }
+        for leaf in LEAVES
+    }
+
+
+def search_space(inst) -> int:
+    q = inst["field_order"]
+    gl = math.prod(q ** DIMENSION - q ** i for i in range(DIMENSION))
+    affine = gl * q ** DIMENSION
+    return affine ** len(LEAVES)
+
+
+def _basis_coords(q):
+    zero = (0, 0, 0)
+    basis = []
+    for column in range(DIMENSION):
+        vector = [0, 0, 0]
+        vector[column] = 1 % q
+        basis.append(tuple(vector))
+    return [zero] + basis
+
+
+def _cert_from_images(images, q):
+    origin = images[0]
+    columns = [_vsub(images[index], origin, q) for index in range(1, DIMENSION + 1)]
+    matrix = [
+        [columns[column][row] for column in range(DIMENSION)]
+        for row in range(DIMENSION)
+    ]
+    return _cert(matrix, origin)
+
+
+def _leaf_valid(inst, leaf, cert, maps=None, metrics=None):
+    q = inst["field_order"]
+    normalised, _reason = _normalise_cert(cert, leaf, q)
+    if normalised is None:
+        return False
+    matrix, offset = normalised
+    if maps is None:
+        maps = _instance_maps(inst)
+    coord_by_id, id_by_coord, adjacency, _ = maps
+    for center_id, source in coord_by_id["C"].items():
+        if metrics is not None:
+            metrics["edge_membership_tests"] += 1
+            metrics["field_operations"] += 18
+        target = _vadd(_mat_vec(matrix, source, q), offset, q)
+        target_id = id_by_coord[leaf][target]
+        if target_id not in adjacency[leaf][center_id]:
+            return False
+    return True
+
+
+def _answer_valid_with_maps(inst, answer, maps):
+    """Fast exact check for well-shaped sampled candidates with a shared index."""
+
+    if not isinstance(answer, dict) or set(answer) != set(LEAVES):
+        return False
+    return all(_leaf_valid(inst, leaf, answer[leaf], maps=maps) for leaf in LEAVES)
+
+
+def _basis_neighbor_coords(inst, leaf, maps=None, ordered=True):
+    if maps is None:
+        maps = _instance_maps(inst)
+    coord_by_id, id_by_coord, _adjacency, row_order = maps
+    result = []
+    for source in _basis_coords(inst["field_order"]):
+        center_id = id_by_coord["C"][source]
+        neighbor_ids = row_order[leaf][center_id]
+        coordinates = [coord_by_id[leaf][vertex_id] for vertex_id in neighbor_ids]
+        result.append(coordinates if ordered else sorted(coordinates))
+    return result
+
+
+def _enumerate_leaf(inst, leaf, stop_first=False):
+    """Enumerate affine maps determined by the four affine-basis images."""
+
+    q = inst["field_order"]
+    maps = _instance_maps(inst)
+    choices = _basis_neighbor_coords(inst, leaf, maps=maps, ordered=True)
+    metrics = {
+        "candidate_matrices": 0,
+        "determinant_checks": 0,
+        "edge_membership_tests": 0,
+        "field_operations": 0,
+    }
+    valid = []
+    seen = set()
+    for images in itertools.product(*choices):
+        cert = _cert_from_images(images, q)
+        key = tuple(value for row in cert["matrix"] for value in row) + tuple(cert["offset"])
+        if key in seen:
+            continue
+        seen.add(key)
+        metrics["candidate_matrices"] += 1
+        metrics["determinant_checks"] += 1
+        metrics["field_operations"] += 26
+        if not _det3(cert["matrix"], q):
+            continue
+        if _leaf_valid(inst, leaf, cert, maps=maps, metrics=metrics):
+            valid.append(cert)
+            if stop_first:
+                return cert, metrics
+    return (valid[0] if stop_first and valid else valid), metrics
+
+
+def enumerate_all(inst) -> int | None:
+    """Exactly count valid coefficient certificates when basis enumeration is capped."""
+
+    if inst["degree"] ** (DIMENSION + 1) > 200_000:
+        return None
+    counts = []
+    for leaf in LEAVES:
+        valid, _metrics = _enumerate_leaf(inst, leaf, stop_first=False)
+        counts.append(len(valid))
+    return math.prod(counts)
+
+
+def _canonical_affine_set(points, q):
+    """Canonical form of a spanning point set under AGL(3,q)."""
+
+    points = [tuple(point) for point in points]
+    best = None
+    for origin_index, origin in enumerate(points):
+        others = [index for index in range(len(points)) if index != origin_index]
+        for indices in itertools.permutations(others, DIMENSION):
+            columns = [_vsub(points[index], origin, q) for index in indices]
+            basis = [
+                [columns[column][row] for column in range(DIMENSION)]
+                for row in range(DIMENSION)
+            ]
+            if not _det3(basis, q):
+                continue
+            inverse = _mat_inv(basis, q)
+            transformed = tuple(sorted(
+                _mat_vec(inverse, _vsub(point, origin, q), q)
+                for point in points
+            ))
+            if best is None or transformed < best:
+                best = transformed
+    if best is None:
+        # Generated translation sets always span, but keep the key deterministic.
+        return ("nonspanning", tuple(sorted(points)))
+    return best
+
+
+def canonical_key(inst) -> str:
+    """Canonical under IDs, input order, leaf swap, and affine coordinates."""
+
+    q = inst["field_order"]
+    coord_by_id, id_by_coord, _adjacency, row_order = _instance_maps(inst)
+    zero_id = id_by_coord["C"][(0, 0, 0)]
+    pair_forms = []
+    for leaf in LEAVES:
+        neighbor_points = [
+            coord_by_id[leaf][vertex_id] for vertex_id in row_order[leaf][zero_id]
+        ]
+        pair_forms.append(_canonical_affine_set(neighbor_points, q))
+    payload = {
+        "q": q,
+        "dimension": DIMENSION,
+        "degree": inst["degree"],
+        "translation_sets": sorted(pair_forms),
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Grow all three vertex classes at fixed 24-coefficient answer length."""
+
+    current = {key: value for key, value in params.items() if key != "_preset"}
+    q = int(current.get("n", 7))
+    current["n"] = _next_prime(2 * q + 1)
+    current["degree"] = int(current.get("degree", 11))
+    return current
+
+
+def _derive_from_selector(inst, selector):
+    answer = {}
+    maps = _instance_maps(inst)
+    for leaf in LEAVES:
+        choices = _basis_neighbor_coords(inst, leaf, maps=maps, ordered=True)
+        images = [selector(leaf, index, values, maps) for index, values in enumerate(choices)]
+        answer[leaf] = _cert_from_images(images, inst["field_order"])
+    return answer
+
+
+def _attack_outlier_frequency(inst):
+    maps = _instance_maps(inst)
+    _coord_by_id, _id_by_coord, adjacency, _row_order = maps
+    frequency = {leaf: {} for leaf in LEAVES}
+    for leaf in LEAVES:
+        for targets in adjacency[leaf].values():
+            for target in targets:
+                frequency[leaf][target] = frequency[leaf].get(target, 0) + 1
+
+    def select(leaf, _index, values, local_maps):
+        coord_by_id, id_by_coord, _adj, _rows = local_maps
+        return min(
+            values,
+            key=lambda coord: (frequency[leaf][id_by_coord[leaf][coord]], id_by_coord[leaf][coord]),
+        )
+
+    return _derive_from_selector(inst, select)
+
+
+def _attack_greedy_lexicographic(inst):
+    return _derive_from_selector(
+        inst, lambda _leaf, _index, values, _maps: min(values)
+    )
+
+
+def _attack_random_basis(inst, rng, attempts):
+    maps = _instance_maps(inst)
+    choices = {
+        leaf: _basis_neighbor_coords(inst, leaf, maps=maps, ordered=True)
+        for leaf in LEAVES
+    }
+    last = None
+    for _ in range(attempts):
+        candidate = {}
+        for leaf in LEAVES:
+            images = [rng.choice(values) for values in choices[leaf]]
+            candidate[leaf] = _cert_from_images(images, inst["field_order"])
+        last = candidate
+        if verify(inst, candidate)[0]:
+            return candidate, True
+    return last, False
+
+
+def _attack_identity_ansatz(inst):
+    maps = _instance_maps(inst)
+    choices = {
+        leaf: _basis_neighbor_coords(inst, leaf, maps=maps, ordered=False)[0]
+        for leaf in LEAVES
+    }
+    ident = _identity()
+    for left_b in choices["L"]:
+        for right_b in choices["R"]:
+            candidate = {"L": _cert(ident, left_b), "R": _cert(ident, right_b)}
+            if verify(inst, candidate)[0]:
+                return candidate
+    return {"L": _cert(ident, choices["L"][0]), "R": _cert(ident, choices["R"][0])}
+
+
+def _reference_algorithm(inst):
+    answer = {}
+    total = {
+        "candidate_matrices": 0,
+        "determinant_checks": 0,
+        "edge_membership_tests": 0,
+        "field_operations": 0,
+    }
+    for leaf in LEAVES:
+        cert, metrics = _enumerate_leaf(inst, leaf, stop_first=True)
+        if cert is None:
+            return None, total
+        answer[leaf] = cert
+        for key in total:
+            total[key] += metrics[key]
+    return answer, total
+
+
+def _random_affine_change(rng, q):
+    return _random_gl(q, rng), tuple(rng.randrange(q) for _ in range(DIMENSION))
+
+
+def _transform_instance(inst, rng, relabel_ids=False, affine=False,
+                        swap_leaves=False, reorder=False):
+    """Apply genuine problem symmetries and carry the coefficient witness."""
+
+    result = copy.deepcopy(inst)
+    q = result["field_order"]
+
+    if relabel_ids:
+        old_ids = [record["id"] for part in ("C", "L", "R")
+                   for record in result["vertices"][part]]
+        new_ids = list(old_ids)
+        rng.shuffle(new_ids)
+        mapping = dict(zip(old_ids, new_ids))
+        for records in result["vertices"].values():
+            for record in records:
+                record["id"] = mapping[record["id"]]
+        for superedge in result["superedges"]:
+            for row in superedge["rows"]:
+                row["center"] = mapping[row["center"]]
+                row["neighbors"] = [mapping[value] for value in row["neighbors"]]
+
+    if affine:
+        changes = {part: _random_affine_change(rng, q) for part in ("C", "L", "R")}
+        for part, records in result["vertices"].items():
+            matrix, offset = changes[part]
+            for record in records:
+                record["coord"] = list(
+                    _vadd(_mat_vec(matrix, tuple(record["coord"]), q), offset, q)
+                )
+        center_matrix, center_offset = changes["C"]
+        center_inverse = _mat_inv(center_matrix, q)
+        transformed_answer = {}
+        for leaf in LEAVES:
+            leaf_matrix, leaf_offset = changes[leaf]
+            old = result["answer"][leaf]
+            new_matrix = _mat_mul(
+                _mat_mul(leaf_matrix, old["matrix"], q), center_inverse, q
+            )
+            transformed_center_offset = _mat_vec(new_matrix, center_offset, q)
+            new_offset = _vsub(
+                _vadd(_mat_vec(leaf_matrix, tuple(old["offset"]), q), leaf_offset, q),
+                transformed_center_offset,
+                q,
+            )
+            transformed_answer[leaf] = _cert(new_matrix, new_offset)
+        result["answer"] = transformed_answer
+
+    if swap_leaves:
+        result["vertices"]["L"], result["vertices"]["R"] = (
+            result["vertices"]["R"], result["vertices"]["L"]
+        )
+        for superedge in result["superedges"]:
+            superedge["leaf"] = "R" if superedge["leaf"] == "L" else "L"
+        result["answer"] = {
+            "L": result["answer"]["R"],
+            "R": result["answer"]["L"],
+        }
+
+    if reorder:
+        for records in result["vertices"].values():
+            rng.shuffle(records)
+        rng.shuffle(result["superedges"])
+        for superedge in result["superedges"]:
+            rng.shuffle(superedge["rows"])
+            for row in superedge["rows"]:
+                rng.shuffle(row["neighbors"])
+    return result
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def _intended_route_operations(params):
+    degree = params["degree"]
+    # Per super-edge: sum d three-vectors at 0,e1,e2,e3; take nine
+    # differences and multiply by d^{-1}.  One small Euclidean inversion of d
+    # is shared between the two edges and conservatively charged four steps.
+    return 2 * (4 * DIMENSION * (degree - 1) + 2 * DIMENSION * DIMENSION) + 4
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return a JSON-native measurement report."""
+
+    report = {}
+
+    failures = []
+    checks = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 19):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            checks += 1
+            if not ok or json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append({"preset": preset, "seed": seed, "reason": reason})
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "checks": checks,
+        "failures": failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=271828, **shipping_params)
+    answer = shipping["answer"]
+    # Find a genuine coefficient transposition that changes validity.  Some
+    # equal-value transpositions are no-ops, and another valid translation is
+    # also admissible, so a fixed pair would not be a sound corruption test.
+    locations = [
+        ("matrix", row, column)
+        for row in range(DIMENSION)
+        for column in range(DIMENSION)
+    ] + [("offset", index, None) for index in range(DIMENSION)]
+    swapped = None
+    for first, second in itertools.combinations(locations, 2):
+        trial = copy.deepcopy(answer)
+        def get(location):
+            kind, one, two = location
+            return trial["L"][kind][one] if two is None else trial["L"][kind][one][two]
+        def put(location, value):
+            kind, one, two = location
+            if two is None:
+                trial["L"][kind][one] = value
+            else:
+                trial["L"][kind][one][two] = value
+        left_value, right_value = get(first), get(second)
+        if left_value == right_value:
+            continue
+        put(first, right_value)
+        put(second, left_value)
+        if not verify(shipping, trial)[0]:
+            swapped = trial
+            break
+    if swapped is None:
+        swapped = {"not": "a valid certificate"}
+    duplicate = {"L": copy.deepcopy(answer["L"]), "R": copy.deepcopy(answer["L"])}
+    out_of_range = copy.deepcopy(answer)
+    out_of_range["R"]["offset"][2] = shipping["field_order"]
+    wrong_shape = copy.deepcopy(answer)
+    wrong_shape["L"]["offset"] = wrong_shape["L"]["offset"][:-1]
+    corruptions = {
+        "drop_one_element": wrong_shape,
+        "swap_one_matrix_offset_entry": swapped,
+        "duplicate_one_superedge_certificate": duplicate,
+        "empty": {},
+        "out_of_range": out_of_range,
+    }
+    corruption_results = {}
+    reasons = []
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
+        corruption_results[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": (
+            all(item["rejected"] for item in corruption_results.values())
+            and len(set(reasons)) == len(corruptions)
+        ),
+        "attempts": len(corruptions),
+        "distinct_reasons": len(set(reasons)),
+        "cases": corruption_results,
+    }
+
+    model_response = (
+        "I checked both affine maps against every adjacency row.\n"
+        "<answer>```json\n" + json.dumps(answer) + "\n```</answer>\n"
+        "The matrices are nonsingular modulo q."
+    )
+    parsed = parse_answer(model_response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and json.loads(json.dumps(answer)) == answer,
+        "parsed_equals_answer": parsed == answer,
+        "json_native": json.loads(json.dumps(answer)) == answer,
+        "surrounding_prose_and_fence": True,
+    }
+
+    trials = 200_000
+    hits = 0
+    guess_rng = random.Random(0x13042429)
+    shipping_maps = _instance_maps(shipping)
+    guess_started = time.perf_counter()
+    for _ in range(trials):
+        hits += int(_answer_valid_with_maps(
+            shipping, random_candidate(shipping, guess_rng), shipping_maps
+        ))
+    guess_seconds = time.perf_counter() - guess_started
+    observed = hits / trials
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6,
+        "hits": hits,
+        "total": trials,
+        "observed_probability": observed,
+        "candidate_space": search_space(shipping),
+        "candidate_space_log2": round(math.log2(search_space(shipping)), 3),
+        "prior": "two independent uniformly random affine bijections of F_q^3",
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    exact_started = time.perf_counter()
+    exact_valid = enumerate_all(shipping)
+    exact_seconds = time.perf_counter() - exact_started
+    baseline_started = time.perf_counter()
+    _baseline_candidate, baseline_success = _attack_random_basis(
+        shipping, random.Random(161803), 256
+    )
+    baseline_seconds = time.perf_counter() - baseline_started
+    ref_started = time.perf_counter()
+    ref_answer, ref_metrics = _reference_algorithm(shipping)
+    ref_seconds = time.perf_counter() - ref_started
+    reference_ok = ref_answer is not None and verify(shipping, ref_answer)[0]
+    exact_density = exact_valid / search_space(shipping) if exact_valid is not None else None
+    report["G5_density_and_baseline_cost"] = {
+        "pass": (
+            exact_valid is not None
+            and exact_density < 1e-6
+            and not baseline_success
+            and reference_ok
+        ),
+        "shipping_seed": 271828,
+        "shipping_exact_valid_answers": exact_valid,
+        "shipping_candidate_space": search_space(shipping),
+        "shipping_exact_solution_fraction": exact_density,
+        "shipping_sample_hits": hits,
+        "shipping_sample_total": trials,
+        "shipping_sampled_density": observed,
+        "exact_count_wall_clock_sec": round(exact_seconds, 6),
+        "strongest_failing_attack": "random affine-basis images, 256 restarts",
+        "baseline_restarts": 256,
+        "baseline_success": baseline_success,
+        "baseline_wall_clock_sec": round(baseline_seconds, 6),
+        "reference_wall_clock_sec": round(ref_seconds, 6),
+        "reference_candidate_matrices": ref_metrics["candidate_matrices"],
+        "reference_edge_membership_tests": ref_metrics["edge_membership_tests"],
+        "reference_field_operations": ref_metrics["field_operations"],
+    }
+
+    attacks = {
+        "outlier_target_frequency": {"successes": 0, "attempts": 8},
+        "greedy_lexicographic_basis": {"successes": 0, "attempts": 8},
+        "random_restart_256_basis_images": {"successes": 0, "attempts": 8},
+        "in_context_identity_matrix_ansatz": {"successes": 0, "attempts": 8},
+    }
+    attack_times = {name: 0.0 for name in attacks}
+    reference_successes = 0
+    reference_times = []
+    reference_metrics = []
+    for seed in range(10_000, 10_008):
+        current = make_instance(seed=seed, **shipping_params)
+        candidates = {}
+
+        started = time.perf_counter()
+        candidates["outlier_target_frequency"] = _attack_outlier_frequency(current)
+        attack_times["outlier_target_frequency"] += time.perf_counter() - started
+
+        started = time.perf_counter()
+        candidates["greedy_lexicographic_basis"] = _attack_greedy_lexicographic(current)
+        attack_times["greedy_lexicographic_basis"] += time.perf_counter() - started
+
+        started = time.perf_counter()
+        restart_candidate, _ = _attack_random_basis(
+            current, random.Random(seed ^ 0xA5A5A5), 256
+        )
+        candidates["random_restart_256_basis_images"] = restart_candidate
+        attack_times["random_restart_256_basis_images"] += time.perf_counter() - started
+
+        started = time.perf_counter()
+        candidates["in_context_identity_matrix_ansatz"] = _attack_identity_ansatz(current)
+        attack_times["in_context_identity_matrix_ansatz"] += time.perf_counter() - started
+
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(current, candidate)[0]:
+                attacks[name]["successes"] += 1
+
+        started = time.perf_counter()
+        current_ref, metrics = _reference_algorithm(current)
+        reference_times.append(time.perf_counter() - started)
+        reference_metrics.append(metrics)
+        if current_ref is not None and verify(current, current_ref)[0]:
+            reference_successes += 1
+
+    for name in attacks:
+        attacks[name]["wall_clock_sec"] = round(attack_times[name], 6)
+    total_reference_ops = sum(item["field_operations"] for item in reference_metrics)
+    total_reference_candidates = sum(item["candidate_matrices"] for item in reference_metrics)
+    total_reference_edges = sum(item["edge_membership_tests"] for item in reference_metrics)
+    all_failed = all(
+        result["successes"] == 0 and result["attempts"] >= 8
+        for result in attacks.values()
+    )
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "affine-basis image enumeration with exact graph validation",
+            "complexity": "O(2*d^4*q^3) worst-case exact",
+            "solves": f"{reference_successes}/8, as expected",
+            "wall_clock_sec": round(sum(reference_times), 6),
+            "operations": total_reference_ops,
+            "operation_unit": "finite-field arithmetic operations across eight shipping instances",
+            "candidate_matrices": total_reference_candidates,
+            "edge_membership_tests": total_reference_edges,
+            "per_instance_field_operations": [item["field_operations"] for item in reference_metrics],
+        },
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] = _next_prime(2 * shipping_params["n"])
+    scale_started = time.perf_counter()
+    doubled = make_instance(seed=314159, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    scale_seconds = time.perf_counter() - scale_started
+    report["G7_scales"] = {
+        "pass": doubled_ok and search_space(doubled) > search_space(shipping),
+        "shipping_field_order": shipping_params["n"],
+        "shipping_class_size": shipping_params["n"] ** DIMENSION,
+        "doubled_field_order": doubled_params["n"],
+        "doubled_class_size": doubled_params["n"] ** DIMENSION,
+        "candidate_space_log2_shipping": round(math.log2(search_space(shipping)), 3),
+        "candidate_space_log2_doubled": round(math.log2(search_space(doubled)), 3),
+        "build_and_verify_wall_clock_sec": round(scale_seconds, 6),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    real_transformations = 0
+    key_failures = []
+    g8_params = {"n": 5, "degree": 7}
+    for seed in range(20):
+        base = make_instance(seed=50_000 + seed, **g8_params)
+        base_key = canonical_key(base)
+        for index, options in enumerate((
+            {"relabel_ids": True, "reorder": True},
+            {"affine": True, "reorder": True},
+            {"relabel_ids": True, "affine": True, "swap_leaves": True, "reorder": True},
+        )):
+            transformed = _transform_instance(
+                base, random.Random(60_000 + 10 * seed + index), **options
+            )
+            invariance_checks += 1
+            if canonical_key(transformed) != base_key:
+                key_failures.append({"seed": seed, "transform": index})
+            if verify(transformed, transformed["answer"])[0]:
+                real_transformations += 1
+    unrelated = [
+        canonical_key(make_instance(seed=80_000 + seed, **g8_params))
+        for seed in range(20)
+    ]
+    report["G8_canonical_key"] = {
+        "pass": (
+            not key_failures
+            and real_transformations == invariance_checks
+            and len(set(unrelated)) == 20
+        ),
+        "invariance_checks": invariance_checks,
+        "real_transformations_verified": real_transformations,
+        "unrelated_attempts": 20,
+        "unrelated_distinct_keys": len(set(unrelated)),
+        "failures": key_failures,
+        "symmetries": [
+            "arbitrary vertex-ID relabelling",
+            "all input-list reorderings",
+            "independent affine coordinate changes on C,L,R",
+            "P3 leaf reflection L<->R",
+            "compositions of the above",
+        ],
+    }
+
+    answer_blob = json.dumps(answer)
+    max_value = shipping["field_order"] - 1
+    worst_answer = {
+        leaf: {
+            "matrix": [[max_value] * DIMENSION for _ in range(DIMENSION)],
+            "offset": [max_value] * DIMENSION,
+        }
+        for leaf in LEAVES
+    }
+    worst_blob = json.dumps(worst_answer)
+    arms = {
+        name: {
+            "solved": G9_ORACLE_RESULTS[name]["solved"],
+            "attempts": G9_ORACLE_RESULTS[name]["attempts"],
+        }
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_minus_placebo = None
+    if arms["hinted"]["attempts"] and arms["placebo"]["attempts"]:
+        hinted_minus_placebo = (
+            arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+            - arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        )
+    intended_ops = _intended_route_operations(shipping_params)
+    within_caps = (
+        len(worst_blob) <= 2000
+        and _answer_atoms(worst_answer) <= 256
+        and intended_ops <= 300
+    )
+    hinted_hardened = G9_ORACLE_RESULTS["hinted_verdict"] == "hardened"
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_hardened and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_minus_placebo,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": len(answer_blob),
+        "answer_tokens": math.ceil(len(answer_blob) / 4),
+        "answer_elements": _answer_atoms(answer),
+        "worst_case_answer_chars": len(worst_blob),
+        "worst_case_answer_tokens": math.ceil(len(worst_blob) / 4),
+        "worst_case_answer_elements": _answer_atoms(worst_answer),
+        "intended_route_operations": intended_ops,
+        "caps_pass": within_caps,
+    }
+
+    report["all_passed"] = all(
+        isinstance(value, dict) and value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G")
+    )
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(shipping_params)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

