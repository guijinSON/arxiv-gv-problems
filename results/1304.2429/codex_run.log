+    for slope in sorted(by_slope):
+        bs = sorted(by_slope[slope])
+        if len(bs) >= data["required"]:
+            return [[slope, b] for b in bs[:data["required"]]], operations, len(valid)
+    return None, operations, len(valid)
 
