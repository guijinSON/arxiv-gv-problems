+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_TEMPLATE_EDGES = ((0, 1), (1, 2), (2, 3))
+
+
+def _is_prime(value):
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    limit = math.isqrt(value)
+    divisor = 3
+    while divisor <= limit:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(value):
+    candidate = max(2, value)
+    if candidate > 2 and candidate % 2 == 0:
+        candidate += 1
+    while not _is_prime(candidate):
+        candidate += 1 if candidate == 2 else 2
+    return candidate
+
+
+def _sample_separated_maps(q, degree, rng):
+    """Sample exchangeable affine maps with a three-row pairing separator.
+
+    The conditioning is symmetric in all components.  It prevents a cross
+    pairing of F_i(0) with F_j(1) from masquerading as a component at x=2.
+    This is a construction check on already sampled certificate pieces, not a
+    search for a certificate in the generated graph.
+    """
+    while True:
+        maps = []
+        seen = set()
+        while len(maps) < degree:
+            item = (rng.randrange(1, q), rng.randrange(q))
+            if item not in seen:
+                seen.add(item)
+                maps.append(item)
+        y0 = [b for a, b in maps]
+        y1 = [(a + b) % q for a, b in maps]
+        y2 = [(2 * a + b) % q for a, b in maps]
+        if len(set(y0)) < degree or len(set(y1)) < degree or len(set(y2)) < degree:
+            continue
+        target2 = set(y2)
+        separated = True
+        for i in range(degree):
+            for j in range(degree):
+                predicted = (2 * y1[j] - y0[i]) % q
+                if (predicted in target2) != (i == j):
+                    separated = False
+                    break
+            if not separated:
+                break
+        if separated:
+            rng.shuffle(maps)
+            return maps
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Construct a P4 blow-up from affine perfect matchings known in advance."""
+    lanes = params.pop("lanes", 6)
+    degree = params.pop("degree", 3)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(n, bool) or not isinstance(n, int) or n < 5:
+        raise ValueError("n must be an integer at least 5")
+    if isinstance(lanes, bool) or not isinstance(lanes, int) or lanes < 1:
+        raise ValueError("lanes must be a positive integer")
+    if isinstance(degree, bool) or not isinstance(degree, int) or degree < 1:
+        raise ValueError("degree must be a positive integer")
+    q = _next_prime(n)
+    if degree >= q:
+        raise ValueError("degree must be smaller than the selected prime")
+
+    rng = random.Random(seed)
+    tables = []
+    planted = []
+    for _lane in range(lanes):
+        maps = _sample_separated_maps(q, degree, rng)
+        rows = []
+        for x in range(q):
+            rows.append(sorted({(a * x + b) % q for a, b in maps}))
+        tables.append(rows)
+        planted.append(list(rng.choice(maps)))
+
+    return {
+        "paper": "arXiv:1304.2429",
+        "tree": "P4",
+        "template_edges": [list(e) for e in _TEMPLATE_EDGES],
+        "q": q,
+        "requested_n": n,
+        "lanes": lanes,
+        "regular_degree": degree,
+        "neighbors": tables,
+        "answer": {"affine_maps": planted},
+    }
+
+
