"""Verified generator from arXiv:0709.1499, Section 2.

The paper writes down the (up to scale) infinitesimal automorphism R of the
upper-unitriangular matrix M(a,b,c).  It explicitly allows a,b,c to lie in an
arbitrary commutative ring.  This generator substitutes sparse polynomials in
Z[x] for a,b,c and asks for the normalized polynomial matrix R(x).

Generation composes the displayed polynomial identity with a substitution; it
never solves the generated coefficient-matching system.
"""

from __future__ import annotations

import hashlib
import itertools
import json
import math
import os
import random
import re
import time


TRACK = "B"


PROBLEM_PROFILE = {
    "native_domain": "algebra",
    "object_regime": "rational_exact",
    "computational_core": "polynomial_identity",
    "certificate_form": "matrix_certificate",
    "native_objects": [
        "upper-unitriangular 3 by 3 matrix over Z[x]",
        "polynomial infinitesimal automorphism matrix",
    ],
    "verification_operations": [
        "exact sparse-polynomial multiplication over Z",
        "exact polynomial coefficient comparison",
        "matrix transpose and multiplication",
    ],
    "domain_essentiality": "native",
    "reduction_kind": "none",
    "reduction": None,
    "reduction_source": "paper_central",
    "intuition_type": "change of variables",
    "intuition_description": (
        "Treat the three displayed polynomials as the abstract entries a, b, c, "
        "derive the universal 3 by 3 identity once, and only then substitute; "
        "without that abstraction one faces a large coefficient-matching system."
    ),
    "hardness_basis": (
        "Track B: generic coefficient matching can be performed exactly by "
        "evaluation, 9-variable modular elimination, and interpolation in "
        "O(D*9^3+9D^2) field operations for output degree D=3n; at shipping "
        "n=100, seed 800, it used 2,382,636 counted operations and about 0.2 seconds, "
        "whereas recognizing the universal Section 2 identity reduces the route "
        "to 138 sparse coefficient operations, a symbolic abstraction unavailable "
        "to mechanical coefficient matching in the no-tool context."
    ),
    "max_answer_tokens": 310,
}


NATIVE = {
    "domain": PROBLEM_PROFILE["native_domain"],
    "core": PROBLEM_PROFILE["computational_core"],
    "objects": list(PROBLEM_PROFILE["native_objects"]),
    "intuition": (
        PROBLEM_PROFILE["intuition_type"]
        + ": "
        + PROBLEM_PROFILE["intuition_description"]
    ),
    "reduction": PROBLEM_PROFILE["reduction"],
}


CERTIFICATE_LANGUAGE = {
    "description": (
        "A 3 by 3 matrix of sparse univariate polynomials over Z.  Every term is "
        "[coefficient, [exponent]], total degree is at most D=3n, coefficients "
        "have absolute value at most H, the total support has exactly K terms, "
        "and entry (2,2) is the fixed normalization c(x)^2-a(x)^2."
    ),
    "bounds": {
        "matrix_rows": 3,
        "matrix_columns": 3,
        "variables": 1,
        "max_degree": "D=3n",
        "coefficient_height": "instance value H",
        "total_nonzero_terms": "instance value K",
        "fixed_normalization_entry": "R[1][1]=c^2-a^2",
    },
}


DIFFICULTY = {
    "demo": {"n": 0, "terms": 1, "input_coeff_bound": 2},
    "easy": {"n": 40, "terms": 2, "input_coeff_bound": 7},
    "medium": {"n": 70, "terms": 2, "input_coeff_bound": 8},
    "hard": {"n": 100, "terms": 2, "input_coeff_bound": 9},
}

SHIPPING_DIFFICULTY = "hard"


STRUCTURAL_HINT = (
    "The three off-diagonal polynomials can be treated as abstract ring elements "
    "before any coefficient expansion is performed."
)
PLACEBO_HINT = (
    "The nine output entries use exact integer coefficients, so careful attention "
    "to signs and exponents is worthwhile."
)


G9_ORACLE_RESULTS = {
    "bare": {"solved": None, "attempts": 0},
    "hinted": {"solved": None, "attempts": 0},
    "placebo": {"solved": None, "attempts": 0},
    "hinted_verdict": "pending",
}


NOTES = r"""
The exact definition comes from Section 2: M(a,b,c) is upper unitriangular,
R is the nonzero solution of R^t M + M R = 0, and the text explicitly says a,
b,c may lie in any commutative ring.  The displayed R formula immediately
after Proposition 2.1 is the construction identity used here.  Its stated
characteristic polynomial also explains why R becomes nilpotent on the Markoff
surface d=a^2+b^2+c^2-abc=0.

The Step 0 easy-result is in the same paragraph: R is unique up to a scalar and
is displayed explicitly.  Independently, a generic solver obtains it through a
linear coefficient system.  Track A would therefore be false.  Track B compares
that exact evaluation/elimination/interpolation route with deriving the identity
over abstract a,b,c and substituting only at the end.

The source was withdrawn in version 7.  This family does not use its withdrawn
headline claim that the dominant Markoff number determines a triple.  It uses
only the Section 2 polynomial identity, rechecked from scratch by verify() on
every generated instance.  The correct parts were later incorporated into
arXiv:1208.4032, as the withdrawal notice says.

Generation draws a,b,c from the same sparse-binomial distribution.  Their top
degree is n, so coefficient matching has output degree 3n while the certificate
keeps at most 82 terms.  The outlier attack guesses only high-degree support;
the greedy attack guesses low-degree support; random restart samples the exact
bounded language; and the in-context attack deliberately tests the tempting but
wrong substitution of the finite automorphism M^{-1}M^t-I for its infinitesimal
generator.  All are checked over eight seeds.  The reference algorithm is
reported separately because it is expected to solve on Track B.
