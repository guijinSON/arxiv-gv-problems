+    "Hint: An affine permutation over the displayed prime field is fixed by its images of two coordinates."
+)
+PLACEBO_HINT: str = (
+    "Hint: A complete answer should respect every displayed lane and use the stated prime field."
+)
+
+# These values are replaced from the harness-owned transcripts after the bare,
+## structural-hint, and placebo runs.  They are diagnostic data, not a substitute
+# for those transcript files.
+_G9_EVIDENCE = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 3},
+        "hinted": {"solved": 0, "attempts": 3},
+        "placebo": {"solved": 0, "attempts": 3},
