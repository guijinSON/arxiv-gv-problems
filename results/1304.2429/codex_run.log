+        "reference_wall_clock_sec": round(ref_seconds, 6),
+        "reference_candidate_matrices": ref_metrics["candidate_matrices"],
+        "reference_edge_membership_tests": ref_metrics["edge_membership_tests"],
+        "reference_field_operations": ref_metrics["field_operations"],
+    }
+
+    attacks = {
