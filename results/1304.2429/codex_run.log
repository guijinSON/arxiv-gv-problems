   568	Note that the $\gh{i}$'s are now edge-disjoint by construction. Our goal
   569	will be to prove that the $\gh{i}$'s have regularity properties similar to
   570	those of the $G_i$'s, but with larger $\e$ and smaller $p$.
   571	
   572	\begin{lemma}\label{everyEdgeIn}
   573	 Run Procedure \ref{proc1} on an \epr graph $G$ with $n$ vertices, where
   574	 $n$ is divisible by $t$. Then with probability $1-o(n^{-1})$, each edge
   575	 $e\in G$ appears in $(1\pm\e)\k$ of the $G_i$'s, where
   576	 \[\k=\frac{60}{\e^2}\log n = \frac{2(t-1)}{t^2}r.\]
   577	\end{lemma}
   578	\begin{proof}
   579	 We first compute the probability $q$ that an edge $e=(v,w)$ appears in
   580	 $G_\s$, when $\s$ is a uniformly random permutation. Then if we let $X_e$
   581	 be the random variable counting the number of $G_i$'s which contain
   582	 $e$, by the independence of the permutations $\s_1,\ldots,\s_r$, we have that
   583	 $X_e$ is distributed as $\Bin[r,q]$.
   584	
   585	 The edge $e$ appears in $G_\s$ if and only if $e$ is part of a super-edge.
   586	 Let $(i,j)$ be a fixed edge of $T$. The probability that $e$ crosses
   587	 $(\vsi,\vsj)$ is $\frac{2}{t^2}\frac{n}{n-1}$. To see this, expose the
   588	 position of $v$ under $\s$.  Then $v$ lies in $\vsi$ or $\vsj$ with
   589	 probability $2\cdot\frac{n/t}{n}$. Conditioning, on this, the probability
   590	 that $w$ lands in the other set is $\frac{n/t}{n-1}$. There are $t-1$
   591	 edges of $T$, and the events corresponding to $e$ belonging to different
   592	 super-edges are mutually disjoint. So we have
   593	 \[q = \frac{2(t-1)}{t^2}\of{1+\frac{1}{n-1}}\,,\]
   594	 which implies that
   595	 \[\E{X_e} = rq=\frac{60}{\e^2}\log n\of{1+\frac{1}{n-1}}\,,\]
   596	 and by
   597	Theorem \ref{chernoff}, the probability that $X_e$ differs from its mean by more than $.5\e rq$
   598	is bounded above by
   599	\[\exp\set{-\frac{(.5\e)^2}{3}rq} = o(n^{-3}).\]
   600	Hence with probability at least $1-o(n^{-1})$, every edge is contained in $(1\pm\e)\frac{60}{\e^2}\log n$ of the $G_i$'s.
   601	\end{proof}
   602	
   603	\begin{lemma}\label{ghatsaregood}
   604	 Suppose that $\e^6np^4\gg\log^3n$. Then after Step $\tbf{P3}$ of Procedure \ref{proc1}, with probability $1-o(1)$, each $\gh{i}$ is a $(7\e,\frac{p}{\k})$-regular blow up of $T$.
   605	\end{lemma}
   606	\begin{proof}
   607	  Since $r=\Theta(\log n/\e^2) = o(n)$, by our assumptions on $n,p$ and
   608	  $\e$, we may assume that at the beginning of step
   609	  \tbf{P3}, each of $G_1,\ldots,G_r$ is a $(2\e,p)$-regular blow up of $T$
   610	  and each edge of $G$ appears in $(1\pm\e)\k$ of the $G_i$'s.
   611	
   612	  Now consider a single $\gh{i}.$ We will show that with sufficiently high
   613	  probability, this is a $(7\e,\frac{p}{\k})$-regular blow up of $T$. This
   614	  means we must show that across super-edges, all degrees and co-degrees
   615	  are very typically correct.  The super-edges of $\gh{i}$ are the same as those in $G_i$,
   616	  but the edge density is lower by a factor of approximately $\k$ since
   617	  each edge of $G_i$ chose to be in $\gh{i}$ with probability approximately
   618	  $1/\k$.
   619	
   620	  Let $v$ be an arbitrary vertex of $\gh{i}$, and let $\nhv$ represent the
   621	  degree of $v$ across a super-edge in $\gh{i}$. If we let $Z_v$ represent
   622	  the degree of $v$ across this super-edge in $G_i$, then since $G_i$ is a
   623	  $(2\e,p)$-regular blow up of $T$, we have that $Z_v \ge (1 -2\e)\nu p$.
   624	  Each of these $Z_v$ edges is included in $\gh{i}$ independently with
   625	  probability $\frac{1}{(1\pm\e)\k}$. So $\nhv$ stochastically dominates
   626	  the distribution
   627	  \[\Bin\sqbs{Z_v, \frac{1}{(1+\e)\k}}.\]
   628	  Thus
   629	  \[\E{\nhv} \ge (1 - 4\e)\nu \frac{p}{\k},\]
   630	  and Theorem \ref{chernoff} tells us that
   631	  \[\nhv \ge (1 - 6\e)\nu \frac{p}{\k}\]
   632	  with probability $1-o(n^{-K})$ for any positive constant $K$ as long as
   633	  \[\e^2n\frac{p}{\k} \gg \log n \iff \e^4np \gg \log^2n. \]
   634	
   635	  \newcommand{\nhvw}{\widehat{N}_{v,w}}
   636	
   637	  Now for co-degrees, we let $v,w$ be vertices in $\gh{i}$ and let $\nhvw$
   638	  represent the co-degree of $v$ and $w$ across a super-edge in $\gh{i}$.
   639	  We let $Z_{v,w}$ represent the co-degree of $v$ and $w$ across this
   640	  super-edge in $G_i$. Applying $(2\e,p)$-regularity of $G_i$, we have that
   641	  $Z_{v,w} \le (1+2\e)\nu p^2$.  Each of these vertices remains a common
   642	  neighbor of $v$ and $w$ in $\gh{i}$ with probability
   643	  $\bfrac{1}{(1\pm\e)\k}^2$, so $\nhvw$ is stochastically dominated by
   644	  \[\Bin\sqbs{Z_{v,w}, \bfrac{1}{(1-\e)\k}^2 }.\]
   645	  Thus
   646	  \[\E{\nhvw} \le (1+ 5\e)\nu \bfrac{p}{\k}^2\]
   647	  and Theorem \ref{chernoff} gives that
   648	  \[\nhvw  \le  (1 + 7\e)\nu\bfrac{p}{\k}^2\]
   649	  with probability $1-o(n^{-K})$ for any positive constant $K$ as long as
   650	  \[\e^2n\bfrac{p}{\k}^2 \gg \log n \iff \e^6np^2\gg \log^3 n.\]
   651	  Taking a union bound over choices of vertices, super-edges and $\gh{i}$,
   652	  we conclude that with probability $1-o(1)$ each $\gh{i}$ is a $(7\e,\frac{p}{\k})$-regular blow-up
   653	  of $T$.
   654	\end{proof}
   655	
   656	
   657	To prove Theorem \ref{mainpseudo}, we will apply the following result of
   658	Frieze and Krivelevich, which shows that any $(\e,p)$-regular pair can have
   659	almost all of its edges covered by edge-disjoint perfect matchings.
   660	
   661	\begin{lemma}[Frieze, Krivelevich \cite{FK12}]\label{packmatch:pseudo}
   662	 Suppose $(A,B)$ is an $(\eta,d)$-regular pair with $\abs{A}=\abs{B}=\nu$  and $\eta^{4/3}d^2\nu \gg 1$ for some small value $\eta\ll 1$. Then $(A,B)$
   663	contains a collection of $(1-\eta^{1/3})d\nu$ edge-disjoint perfect matchings.
   664	\end{lemma}
   665	%---original statement of packmatch:pseudo-----------------------------------------
   666	%\begin{lemma}[Frieze, Krivelevich \cite{FK}]\label{packmatch:pseudo}
   667	% Let $G$ be a bipartite graph with vertex set $A \cup B$ where $\abs{A} = \abs{B} = n$. Suppose
   668	%that the minimum degree in G is at least $(1-\e)dn$ and the maximum co-degree of two vertices
   669	%is at most $(1+\e)d^2n$ for some small value $\e \ll 1$. Suppose further that $\e^{4/3}d^2n \gg 1$. Then $G$
   670	%contains a collection of $(1-\e^{1/3})dn$ edge-disjoint perfect matchings.
   671	%\end{lemma}
   672	
   673	
   674	\begin{proof}[Proof of Theorem \ref{mainpseudo}.]
   675	  Let $G$ be an $(\e,p)$-regular graph on $n$ vertices with $\e^{6}np^4 \gg
   676	  \log^3n$.  Apply Procedure \ref{proc1}.  Our conditions on $\e,p$, and
   677	  $n$ allow us to apply Lemma \ref{ghatsaregood} and to conclude that at the
   678	  end of Step \tbf{P3} of Procedure \ref{proc1}, every $\gh{i}$ is a
   679	  $(7\e,\frac{p}{\k})$-regular blow up of $T$. We also have that each
   680	  edge of $G$
   681	  appears in \emph{exactly}\/ one of the $\gh{i}$.
   682	
   683	  Consider one of the $\gh{i}$, and call its $t-1$ super-edges
   684	  $Q_1,\ldots,Q_{t-1}$. On each of these super-edges,  we apply Lemma
   685	  \ref{packmatch:pseudo} with $\nu=n/t$, $\eta=7\e$ and $d=\frac{p}{\k}$.
   686	  Then we have that each $Q_j$ contains a collection of edge-disjoint
   687	  perfect matchings $\scr{M}_j$ of size at least
   688	  \[s:=(1-(7\e)^{1/3})\frac{p}{\k}\frac{n}{t}.\]
   689	  Now select arbitrary matchings $M_1 \in \scr{M}_1, M_2\in\scr{M}_2,\ldots,M_{t-1}\in\scr{M}_{t-1}.$
   690	  Observe that
   691	  \[M_1\cup M_2\cup\cdots\cup M_{t-1}\]
   692	  is a $T$ factor since the super-edge structure of $\gh{i}$ is isomorphic
   693	  to $T$. We may thus extract at least $s$ edge-disjoint $T$-factors from
   694	  $\gh{i}$.  Indeed, we may do this for each of $\gh{1},\ldots,\gh{r}$.
   695	  Tree factors extracted from distinct $\gh{i}$ are edge-disjoint.
   696	
   697	  In total, the number of edges covered by these tree factors is at least
   698	  \[s\cdot\frac{n}{t}\cdot(t-1)\cdot r = (1-(7\e)^{1/3})\frac{n^2}{2}p\,,\]
   699	  while the $(\e,p)$-regularity of $G$ tells us that $G$ had at most
   700	  $(1+\e)\frac{n^2}{2}p$ edges total.  So, the total fraction covered is at
   701	  least
   702	  \[\frac{1-(7\e)^{1/3}}{1+\e} \ge 1-2\e^{1/3}\,,\]
   703	  as long as $\e$ is sufficiently small.
   704	\end{proof}
   705	
   706	
   707	
   708	\section{Proof of Theorem \ref{randomthmlogsq}}
   709	
   710	Direct application of Theorem \ref{mainpseudo} for pseudo-random
   711	graphs gives a packing result for random graphs with $p \gg n^{-1/4}
   712	\log^{3/4} n$. In this section, we use additional properties of
   713	random graphs to improve the range of $p$ to $p \gg \frac{\log^2
   714	n}{n}$.  For this, we will apply the following result, which is an
   715	analogue of Lemma \ref{packmatch:pseudo} for the fully random graph
   716	setting.
   717	
   718	\begin{lemma}[Frieze, Krivelevich \cite{FK12}]\label{packmatch:random}
   719	  Let $G$ be a random bipartite graph with sides $A, B$ of size $\abs{A} =
   720	  \abs{B} = \n$, where each edge appears independently with probability at
   721	  least $p = p(\n)$. Assume that $p(\n) \gg \frac{\log \n}{\n}$. Then with
   722	  probability $1 - o(\n^{-1})$, $G$ contains a family of $(1 - \d)\n p$
   723	  edge-disjoint perfect matchings, where
   724	  \[\d = \bfrac{16\log \n}{\n p}^{1/2}.\]
   725	\end{lemma}
   726	
   727	
   728	
   729	\begin{proof}[Proof of Theorem \ref{randomthmlogsq}]
   730	  The proof of this theorem is essentially identical to that in the
   731	  previous section. Run Procedure \ref{proc1} on a random graph $G=G_{n,p}$
   732	  with $n$ a multiple of $t$, and let $\nu = n/t$.  Since $G$ is random,
   733	  after Step \tbf{P1},  each super-edge of each $G_i$ is a copy of
   734	  $B_{\nu,\nu,p}$, the random bipartite graph with parts of size $\nu$ and
   735	  edge probability $p$.  The proof of Lemma \ref{everyEdgeIn} applied to
   736	  $G_{n,p}$ instead of an \epr graph gives us that with probability
   737	  $1-o(n^{-1})$, each edge appears in $(1\pm \e)\k$ of the $G_i$'s where
   738	  $\k = \frac{60}{\e^2}\log n$.
   739	
   740	  Conditioning on this, we see that after Step \tbf{P3} of Procedure
   741	  \ref{proc1}, in a particular $\gh{i}$, across a super-edge $(A,B)$, each
   742	  pair $(a,b), a\in A, b\in B$ is an edge of $\gh{i}$ with probability at
   743	  least
   744	  \begin{displaymath}
   745	    q :=
   746	    p\cdot\frac{1}{(1+\e)\k}
   747	    \gg \frac{\log n}{n}
   748	    = \Theta\left(\frac{\log\n}{\n}\right).
   749	  \end{displaymath}
   750	  So, we may apply Lemma \ref{packmatch:random} to each of the $(t-1)r$
   751	  super-edges in the $\gh{i}$'s.  Since $(t-1)r \ll \nu$, we have that
   752	  \tbf{whp}, each of the $(t-1)r$ super-edges satisfies the conclusion of
   753	  the lemma.
   754	
   755	  Consider one of the $\gh{i}$'s and suppose that we call its $t-1$
   756	  super-edges $Q_1,\ldots,Q_{t-1}$. Then we have that each $Q_j$ contains
   757	  a collection of edge-disjoint perfect matchings $\scr{M}_j$ of size at
   758	  least
   759	  \[s:=(1-\d)q\n.\]
   760	  Note that $\d$ is bounded by
   761	  \[\bfrac{16\log\nu}{\nu \frac{p}{(1+\e)\k}}^{1/2} = O(\e).\]
   762	  As before, selecting arbitrary matchings $M_1 \in \scr{M}_1,
   763	  M_2\in\scr{M}_2,\ldots,M_{t-1}\in\scr{M}_{t-1}$ gives a $T$-factor
   764	  \[M_1\cup M_2\cup\cdots\cup M_{t-1}.\]
   765	 We may thus extract at least $s$ edge-disjoint $T$-factors from $\gh{i}$ and do this for each of $\gh{1},\ldots,\gh{r}$. In total, the number of edges covered will be at least
   766	\[s\cdot\n\cdot(t-1)\cdot r = (1-O(\e))\frac{n^2}{2}p\]
   767	which is the desired number of edges since the graph has at most
   768	$(1+\e)\binom{n}{2}p$ edges total \tbf{whp} by Theorem \ref{chernoff}.
   769	
   770	
   771	
   772	\end{proof}
   773	
   774	
   775	\section{Proof of Theorem \ref{randomthmlog}}
   776	
   777	We conclude by introducing a different argument which ``bootstraps''
   778	Theorem \ref{mainpseudo} to drive the range of $p$ all the way down to
   779	about $\frac{\log n}{n}$.  Note that this is essentially the limit, because
   780	for $p$ below $\frac{\log n}{n}$, the random graph typically contains
   781	isolated vertices, and therefore finding even a single $T$-factor would be
   782	impossible.
   783	
   784	\begin{proof}[Proof of Theorem \ref{randomthmlog}]
   785	  Let $\tau_1$ be the smallest value of $\tau$ for which Theorem 1 applies
   786	  for $(\epsilon^3, 1)$-regular graphs on $\tau$ vertices.  Let $\tau_0 =
   787	  \max\{\tau_1, \epsilon^{-3}\}$, and assume that $\tau \geq \tau_0$, with
   788	  $t \mid \tau$.  Define $C = \tau \epsilon^{-2}$.  The idea of the proof
   789	  is to first split the vertex set of $G\sim G_{n,p}$ into $\tau$ parts
   790	  $V_1 \cup \cdots \cup V_\tau$ of size $\ell$ each.  We then think of
   791	  these parts as vertices of the complete graph on $\tau$ vertices and note
   792	  that the complete graph $K_\tau$ is a $(\d,1)$-regular graph for any $\d
   793	  \geq 1/\tau$. We apply Theorem \ref{mainpseudo} to find a collection of
   794	  edge-disjoint $T$-factors which cover almost all the edges of $K_\tau$.
   795	  Each edge appearing in a $T$-factor of $K_\tau$ corresponds to a random
   796	  bipartite graph $B_{\ell,\ell,p}$ in $G$. To each such bipartite graph we
   797	  apply Lemma \ref{packmatch:random}. We must show that the total number of
   798	  edges covered is at least $(1-O(\e))\binom{n}{2}p$ since by Theorem
   799	  \ref{chernoff}, $G_{n,p}$ has at most $(1+\e)\binom{n}{2}p$ edges total
   800	  \tbf{whp}.
   801	
   802	  We now analyze this procedure quantitatively.  We fail to cover edges in
   803	  three ways: when they are within a single $V_i$, when they are between a
   804	  pair $(V_i, V_j)$ which is not covered by a $T$-factor, and when they are
   805	  within a $T$-factor edge, but missed by Lemma \ref{packmatch:random}.  We
   806	  must ensure that the total fraction missed is $O(\epsilon)$.  To this
   807	  end, note that the first omission loses only at most
   808	  $\frac{1}{\tau}$-fraction of the edges, while the second loses at most $2
   809	  \delta^{1/3}$-fraction of the edges by Theorem \ref{mainpseudo}.
   810	  Therefore, as long as $\tau > \tau_0 = \epsilon^{-3}$ (which implies that
   811	  $K_\tau$ is $(\delta,1)$-regular with $\delta = \epsilon^3$), the total
   812	  loss from the first two types is only $O(\epsilon)$.  Note that this
   813	  bounded loss is completely deterministic.
   814	
   815	  We control the third type of omission using the randomness in $G_{n,p}$.
   816	  The bipartite graph between every pair $(V_i,V_j)$ covered by a
   817	  $T$-factor in $K_\tau$ is a copy of the random bipartite graph
   818	  $B_{\ell,\ell,p}$.  If we apply Lemma \ref{packmatch:random} to such a
   819	  graph, we obtain a collection $\scr{M}_{i,j}$ of at least
   820	  $\of{1-\bfrac{16\log\ell}{\ell p}^{1/2}}\ell p$ edge-disjoint matchings
   821	  with probability $1-o(\ell^{-1})$.  Since we are proving that $G_{n,p}$
   822	  satisfies $\scr{P}(\epsilon)$ \tbf{whp}, $\tau$ is a constant while $n
   823	  \rightarrow \infty$, and therefore $\tau^2 \ll \ell$; a union bound then
   824	  implies that \tbf{whp}, every pair $(V_i,V_j)$ from the $T$-factor of
   825	  $K_\tau$ contains such a collection $\scr{M}_{i,j}$.  As in the proofs of
   826	  our other two results, these perfect matchings combine to form
   827	  $T$-factors of the full $n$-vertex graph.  It therefore remains only to
   828	  show that the fractional loss can be kept below $O(\epsilon)$.  For
   829	  this, we use $p > \frac{C \log n}{n}$, and simplify:
   830	  \begin{displaymath}
   831	    \bfrac{16\log\ell}{\ell p}^{1/2}
   832	    < \bfrac{16\log\ell}{\ell \frac{C \log(\tau\ell)}{\tau \ell}}^{1/2}
   833	    =O\left(\left( \frac{\tau}{C} \right)^{1/2}\right)
   834	    = O(\epsilon) \,,
   835	  \end{displaymath}
   836	  since $C = \tau \epsilon^{-2}$.
   837	\end{proof}
