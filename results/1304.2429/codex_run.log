+    if error is not None:
+        raise ValueError(error)
+    p, adjacency = data["p"], data["adjacency"]
+    operations = 0
+    valid = set()
+    for b in sorted(adjacency[0]):
+        for y1 in sorted(adjacency[1]):
+            slope = (y1 - b) % p
+            operations += 2
+            if slope == 0:
+                continue
+            good = True
+            for x in range(p):
+                y = (slope * x + b) % p
