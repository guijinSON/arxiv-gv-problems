+def _basis_coords(q):
+    zero = (0, 0, 0)
+    basis = []
+    for column in range(DIMENSION):
+        vector = [0, 0, 0]
+        vector[column] = 1 % q
+        basis.append(tuple(vector))
+    return [zero] + basis
