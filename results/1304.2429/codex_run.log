+
+NOTES = """\
+Section 1 fixes the exact factor definition: copies need not be induced, must be
+vertex-disjoint, and together cover every vertex. Section 3 defines a blow-up of
+a fixed tree and the proof of Theorem 1 (especially the paragraph following
+Lemma 3.4) says that arbitrary perfect matchings on its super-edges combine into
+a T-factor. This module specializes the native object to T=P3 and asks for the
+two matching certificates themselves; there is no graph-to-CSP reduction.
+
+STEP 0 rules out Track A. The same Section 3 proof explicitly obtains the
+certificate from bipartite perfect matchings, a polynomial-time problem, and
+Section 1 already identifies T=K2 with ordinary perfect matching. The random
+regime is also existence-friendly: Theorem 2 covers epsilon^4*n*p much larger
+than log(n)^2, while Section 5 explains that below about log(n)/n isolated
+vertices make even one factor impossible. The honest claim is therefore Track
+B, not average-case or worst-case hardness.
+
+Generation is by composition of identities. For each super-edge it samples an
+invertible matrix A and a set B of translations. Every map x -> A*x+b, b in B,
+is a perfect matching, all are sampled symmetrically, and one is carried as the
+certificate. The two carried matchings compose into a P3-factor exactly as in
+the paper. Vertex IDs, vertex rows, adjacency rows, and neighbor orders are all
+shuffled. Equal source and target degrees defeat the frequency outlier; shuffled
+IDs defeat ID-minimum selection; independent translation choices defeat greedy
+and random basis-image guesses; and matrices with A-I invertible defeat the
+identity ansatz. The successful affine-image enumerator is reported separately
+as Track B's reference algorithm.
+"""
+
+
+# Filled after the script-owned bare/hinted/placebo oracle runs.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
+}
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _is_prime(value):
+    if not _is_int(value) or value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(value):
+    candidate = max(2, int(value))
+    if candidate > 2 and candidate % 2 == 0:
+        candidate += 1
+    while not _is_prime(candidate):
+        candidate += 1 if candidate == 2 else 2
+    return candidate
+
+
+def _coords(q):
+    return [tuple(x) for x in itertools.product(range(q), repeat=DIMENSION)]
+
+
+def _vadd(a, b, q):
+    return tuple((a[i] + b[i]) % q for i in range(DIMENSION))
+
+
+def _vsub(a, b, q):
+    return tuple((a[i] - b[i]) % q for i in range(DIMENSION))
+
+
+def _det3(matrix, q):
+    a, b, c = matrix[0]
+    d, e, f = matrix[1]
+    g, h, i = matrix[2]
+    return (
+        a * (e * i - f * h)
+        - b * (d * i - f * g)
+        + c * (d * h - e * g)
+    ) % q
+
+
+def _mat_vec(matrix, vector, q):
+    return tuple(
+        sum(matrix[row][column] * vector[column] for column in range(DIMENSION)) % q
+        for row in range(DIMENSION)
+    )
+
+
+def _mat_mul(left, right, q):
+    return [
+        [
+            sum(left[i][k] * right[k][j] for k in range(DIMENSION)) % q
+            for j in range(DIMENSION)
+        ]
+        for i in range(DIMENSION)
+    ]
+
+
+def _mat_inv(matrix, q):
+    augmented = [
+        [matrix[i][j] % q for j in range(DIMENSION)]
+        + [int(i == j) for j in range(DIMENSION)]
+        for i in range(DIMENSION)
+    ]
+    for column in range(DIMENSION):
+        pivot = next(
+            (row for row in range(column, DIMENSION) if augmented[row][column] % q),
+            None,
+        )
+        if pivot is None:
+            raise ValueError("singular matrix")
+        augmented[column], augmented[pivot] = augmented[pivot], augmented[column]
+        inverse = pow(augmented[column][column], -1, q)
+        augmented[column] = [(value * inverse) % q for value in augmented[column]]
+        for row in range(DIMENSION):
+            if row == column:
+                continue
+            factor = augmented[row][column] % q
+            if factor:
+                augmented[row] = [
+                    (augmented[row][j] - factor * augmented[column][j]) % q
+                    for j in range(2 * DIMENSION)
+                ]
+    return [row[DIMENSION:] for row in augmented]
+
+
+def _identity():
+    return [[int(i == j) for j in range(DIMENSION)] for i in range(DIMENSION)]
+
+
+def _sample_matrix(rng, q, forbidden=()):
+    forbidden_keys = {
+        tuple(value for row in matrix for value in row) for matrix in forbidden
+    }
+    ident = _identity()
+    while True:
+        matrix = [
+            [rng.randrange(q) for _ in range(DIMENSION)]
+            for _ in range(DIMENSION)
+        ]
+        key = tuple(value for row in matrix for value in row)
+        difference = [
+            [(matrix[i][j] - ident[i][j]) % q for j in range(DIMENSION)]
+            for i in range(DIMENSION)
+        ]
+        if _det3(matrix, q) and _det3(difference, q) and key not in forbidden_keys:
+            return matrix
+
+
+def _affinely_spans(points, q):
+    origin = points[0]
+    for indices in itertools.combinations(range(1, len(points)), DIMENSION):
+        columns = [_vsub(points[index], origin, q) for index in indices]
+        matrix = [[columns[column][row] for column in range(DIMENSION)]
+                  for row in range(DIMENSION)]
+        if _det3(matrix, q):
+            return True
+    return False
+
+
+def _sample_translations(rng, all_coords, degree, q):
+    while True:
+        points = rng.sample(all_coords, degree)
+        if _affinely_spans(points, q):
+            return points
+
+
+def _cert(matrix, offset):
+    return {
+        "matrix": [[int(value) for value in row] for row in matrix],
+        "offset": [int(value) for value in offset],
+    }
+
+
+def make_instance(n, seed=0, degree=11, **params) -> dict:
+    """Compose affine perfect matchings into a P3-factor without solving.
+
+    ``n`` is the prime field order q.  Each of the three graph classes has
+    q^3 vertices.  ``degree`` is the number of equally distributed affine
+    translation matchings in each super-edge.
+    """
+
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if not _is_prime(n):
+        raise ValueError("n must be a prime field order")
+    if not _is_int(degree) or degree < DIMENSION + 1 or degree >= n ** DIMENSION:
+        raise ValueError("degree must be in 4..n^3-1")
+    if degree % n == 0:
+        raise ValueError("degree must be invertible modulo n")
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+
+    q = n
+    rng = random.Random(seed)
+    coordinates = _coords(q)
+    class_size = len(coordinates)
+
+    matrices = {}
+    translations = {}
+    used_matrices = []
+    for leaf in LEAVES:
+        matrix = _sample_matrix(rng, q, used_matrices)
+        used_matrices.append(matrix)
+        matrices[leaf] = matrix
+        translations[leaf] = _sample_translations(
+            rng, coordinates, degree, q
+        )
+
+    all_ids = list(range(3 * class_size))
+    rng.shuffle(all_ids)
+    vertices = {}
+    coord_to_id = {}
+    cursor = 0
+    for part in ("C", "L", "R"):
+        records = []
+        mapping = {}
+        for coordinate in coordinates:
+            vertex_id = all_ids[cursor]
+            cursor += 1
+            mapping[coordinate] = vertex_id
+            records.append({"id": vertex_id, "coord": list(coordinate)})
+        rng.shuffle(records)
+        vertices[part] = records
+        coord_to_id[part] = mapping
+
+    superedges = []
+    answer = {}
+    for leaf in LEAVES:
+        matrix = matrices[leaf]
+        offsets = translations[leaf]
+        chosen = rng.choice(offsets)
+        answer[leaf] = _cert(matrix, chosen)
+        rows = []
+        for source in coordinates:
+            linear = _mat_vec(matrix, source, q)
+            neighbor_ids = [
+                coord_to_id[leaf][_vadd(linear, offset, q)]
+                for offset in offsets
+            ]
+            rng.shuffle(neighbor_ids)
+            rows.append({
+                "center": coord_to_id["C"][source],
+                "neighbors": neighbor_ids,
+            })
+        rng.shuffle(rows)
+        superedges.append({"leaf": leaf, "rows": rows})
+    rng.shuffle(superedges)
+
+    return {
+        "family": "affine P3-factor in a tree blow-up",
+        "field_order": q,
+        "dimension": DIMENSION,
+        "class_size": class_size,
+        "degree": degree,
+        "tree": {"vertices": ["L", "C", "R"], "edges": [["L", "C"], ["C", "R"]]},
+        "vertices": vertices,
+        "superedges": superedges,
+        "answer": answer,
+    }
+
+
+def _format_coord(coord):
+    return "(" + ",".join(str(value) for value in coord) + ")"
+
+
+def render(inst) -> str:
+    """Render the complete graph, certificate semantics, and output contract."""
+
+    q = inst["field_order"]
+    class_size = inst["class_size"]
+    degree = inst["degree"]
+    lines = [
+        "AFFINE P3-FACTOR IN A TREE BLOW-UP",
+        "",
+        "The tree P3 is the three-vertex path L--C--R. A P3-factor of a graph",
+        "is a collection of vertex-disjoint (not necessarily induced) copies of",
+        "P3 that covers every graph vertex exactly once.",
+        "",
+        f"Here q={q} is prime. Each of L, C, and R has {class_size}=q^3 vertices.",
+        "Every vertex has a displayed integer ID and an intrinsic coordinate",
+        "(x0,x1,x2) in F_q^3; all coordinate arithmetic below is modulo q.",
+        "Edges exist only on the two displayed bipartite super-edges C--L and",
+        f"C--R. Every adjacency row has exactly {degree} distinct neighbors.",
+        "",
+        "Your certificate must give, independently for X=L and X=R, an affine",
+        "map f_X(x)=A_X*x+b_X over F_q. A_X must be an invertible 3x3 matrix",
+        "and b_X a length-3 vector. For every center coordinate x, the graph",
+        "must contain the edge from that center vertex to the X-vertex with",
+        "coordinate f_X(x). Invertibility makes each f_X a bijection, so the two",
+        "matchings then combine into a P3-factor with center class C.",
+        "",
+        "Vertex tables (input order has no significance):",
+    ]
+    for part in ("C", "L", "R"):
+        rendered = " ".join(
+            f"{record['id']}:{_format_coord(record['coord'])}"
+            for record in inst["vertices"][part]
+        )
+        lines.extend([f"  {part} vertices as ID:coordinate", "  " + rendered])
+
+    lines.extend(["", "Super-edge adjacency; neighbor order and row order have no significance:"])
+    for superedge in inst["superedges"]:
+        leaf = superedge["leaf"]
+        lines.append(f"  C--{leaf}")
+        for row in superedge["rows"]:
+            lines.append(
+                f"    center {row['center']} -> "
+                + ",".join(str(value) for value in row["neighbors"])
+            )
+
+    example = {
+        "L": {"matrix": [[1, 0, 0], [0, 1, 0], [0, 0, 1]], "offset": [0, 0, 0]},
+        "R": {"matrix": [[1, 0, 0], [0, 1, 0], [0, 0, 1]], "offset": [0, 0, 0]},
+    }
+    lines.extend([
+        "",
+        "Find any certificate satisfying these conditions. Coefficients must be",
+        f"JSON integers in the inclusive range 0..{q - 1}. Matrix row/column order",
+        "and offset coordinate order are x0,x1,x2. The keys must be exactly L and R.",
+        "",
+        "Give your final answer inside <answer></answer> tags as one JSON object",
+        "with the exact shape shown below (the numbers shown are syntax only):",
+        "<answer>" + json.dumps(example, separators=(",", ":")) + "</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    """Extract the final tagged JSON certificate; return None on all garbage."""
+
+    if not isinstance(text, str):
+        return None
+    blocks = _ANSWER_RE.findall(text)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    fenced = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
+    if fenced:
+        body = fenced.group(1).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _instance_maps(inst):
+    coord_by_id = {}
+    id_by_coord = {}
+    for part, records in inst["vertices"].items():
+        coord_by_id[part] = {record["id"]: tuple(record["coord"]) for record in records}
+        id_by_coord[part] = {tuple(record["coord"]): record["id"] for record in records}
+    adjacency = {}
+    row_order = {}
+    for superedge in inst["superedges"]:
+        leaf = superedge["leaf"]
+        adjacency[leaf] = {
+            row["center"]: set(row["neighbors"]) for row in superedge["rows"]
+        }
+        row_order[leaf] = {
+            row["center"]: list(row["neighbors"]) for row in superedge["rows"]
+        }
+    return coord_by_id, id_by_coord, adjacency, row_order
+
+
+def _normalise_cert(cert, leaf, q):
+    if not isinstance(cert, dict) or set(cert) != {"matrix", "offset"}:
+        return None, f"{leaf} certificate must have exactly matrix and offset"
+    matrix = cert["matrix"]
+    offset = cert["offset"]
+    if (
+        not isinstance(matrix, list)
+        or len(matrix) != DIMENSION
+        or any(not isinstance(row, list) or len(row) != DIMENSION for row in matrix)
+    ):
+        return None, f"{leaf} matrix must have shape 3x3"
+    if not isinstance(offset, list) or len(offset) != DIMENSION:
+        return None, f"{leaf} offset must have length 3"
+    values = [value for row in matrix for value in row] + list(offset)
+    if any(not _is_int(value) for value in values):
+        return None, f"{leaf} coefficients must be JSON integers"
+    if any(value < 0 or value >= q for value in values):
+        return None, f"{leaf} coefficient is outside 0..{q - 1}"
+    if not _det3(matrix, q):
+        return None, f"{leaf} matrix is singular modulo {q}"
+    return (matrix, tuple(offset)), None
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check affine bijectivity and every selected graph edge; ignore the plant."""
+
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer object is empty"
+    if set(answer) != set(LEAVES):
+        return False, "answer must contain exactly the two keys L and R"
+    q = inst["field_order"]
+    coord_by_id, id_by_coord, adjacency, _ = _instance_maps(inst)
+    for leaf in LEAVES:
+        normalised, reason = _normalise_cert(answer[leaf], leaf, q)
+        if normalised is None:
+            return False, reason
+        matrix, offset = normalised
+        for center_id, source in coord_by_id["C"].items():
+            target = _vadd(_mat_vec(matrix, source, q), offset, q)
+            target_id = id_by_coord[leaf].get(target)
+            if target_id is None or target_id not in adjacency[leaf].get(center_id, set()):
+                return False, (
+                    f"{leaf} affine map selects a non-edge at center coordinate "
+                    f"{_format_coord(source)}"
+                )
+    return True, "ok"
+
+
+def _random_gl(q, rng):
+    while True:
+        matrix = [
+            [rng.randrange(q) for _ in range(DIMENSION)]
+            for _ in range(DIMENSION)
+        ]
+        if _det3(matrix, q):
+            return matrix
+
+
+def random_candidate(inst, rng) -> object:
+    """Sample uniformly from two affine bijections, enforcing the stated shape."""
+
+    q = inst["field_order"]
+    return {
+        leaf: {
+            "matrix": _random_gl(q, rng),
+            "offset": [rng.randrange(q) for _ in range(DIMENSION)],
+        }
+        for leaf in LEAVES
+    }
+
+
+def search_space(inst) -> int:
+    q = inst["field_order"]
+    gl = math.prod(q ** DIMENSION - q ** i for i in range(DIMENSION))
+    affine = gl * q ** DIMENSION
+    return affine ** len(LEAVES)
+
+
+def _basis_coords(q):
+    zero = (0, 0, 0)
+    basis = []
+    for column in range(DIMENSION):
+        vector = [0, 0, 0]
+        vector[column] = 1 % q
+        basis.append(tuple(vector))
+    return [zero] + basis
+
+
+def _cert_from_images(images, q):
+    origin = images[0]
+    columns = [_vsub(images[index], origin, q) for index in range(1, DIMENSION + 1)]
+    matrix = [
+        [columns[column][row] for column in range(DIMENSION)]
+        for row in range(DIMENSION)
+    ]
+    return _cert(matrix, origin)
+
+
+def _leaf_valid(inst, leaf, cert, maps=None, metrics=None):
+    q = inst["field_order"]
+    normalised, _reason = _normalise_cert(cert, leaf, q)
+    if normalised is None:
+        return False
+    matrix, offset = normalised
+    if maps is None:
+        maps = _instance_maps(inst)
+    coord_by_id, id_by_coord, adjacency, _ = maps
+    for center_id, source in coord_by_id["C"].items():
+        if metrics is not None:
+            metrics["edge_membership_tests"] += 1
+            metrics["field_operations"] += 18
+        target = _vadd(_mat_vec(matrix, source, q), offset, q)
+        target_id = id_by_coord[leaf][target]
+        if target_id not in adjacency[leaf][center_id]:
+            return False
+    return True
+
+
+def _answer_valid_with_maps(inst, answer, maps):
+    """Fast exact check for well-shaped sampled candidates with a shared index."""
+
+    if not isinstance(answer, dict) or set(answer) != set(LEAVES):
+        return False
+    return all(_leaf_valid(inst, leaf, answer[leaf], maps=maps) for leaf in LEAVES)
+
+
+def _basis_neighbor_coords(inst, leaf, maps=None, ordered=True):
+    if maps is None:
+        maps = _instance_maps(inst)
+    coord_by_id, id_by_coord, _adjacency, row_order = maps
+    result = []
+    for source in _basis_coords(inst["field_order"]):
+        center_id = id_by_coord["C"][source]
+        neighbor_ids = row_order[leaf][center_id]
+        coordinates = [coord_by_id[leaf][vertex_id] for vertex_id in neighbor_ids]
+        result.append(coordinates if ordered else sorted(coordinates))
+    return result
+
+
+def _enumerate_leaf(inst, leaf, stop_first=False):
+    """Enumerate affine maps determined by the four affine-basis images."""
+
+    q = inst["field_order"]
+    maps = _instance_maps(inst)
+    choices = _basis_neighbor_coords(inst, leaf, maps=maps, ordered=True)
+    metrics = {
+        "candidate_matrices": 0,
+        "determinant_checks": 0,
+        "edge_membership_tests": 0,
+        "field_operations": 0,
+    }
+    valid = []
+    seen = set()
+    for images in itertools.product(*choices):
+        cert = _cert_from_images(images, q)
+        key = tuple(value for row in cert["matrix"] for value in row) + tuple(cert["offset"])
+        if key in seen:
+            continue
+        seen.add(key)
+        metrics["candidate_matrices"] += 1
+        metrics["determinant_checks"] += 1
+        metrics["field_operations"] += 26
+        if not _det3(cert["matrix"], q):
+            continue
+        if _leaf_valid(inst, leaf, cert, maps=maps, metrics=metrics):
+            valid.append(cert)
+            if stop_first:
+                return cert, metrics
+    return (valid[0] if stop_first and valid else valid), metrics
+
+
+def enumerate_all(inst) -> int | None:
+    """Exactly count valid coefficient certificates when basis enumeration is capped."""
+
+    if inst["degree"] ** (DIMENSION + 1) > 200_000:
+        return None
+    counts = []
+    for leaf in LEAVES:
+        valid, _metrics = _enumerate_leaf(inst, leaf, stop_first=False)
+        counts.append(len(valid))
+    return math.prod(counts)
+
+
+def _canonical_affine_set(points, q):
+    """Canonical form of a spanning point set under AGL(3,q)."""
+
+    points = [tuple(point) for point in points]
+    best = None
+    for origin_index, origin in enumerate(points):
+        others = [index for index in range(len(points)) if index != origin_index]
+        for indices in itertools.permutations(others, DIMENSION):
+            columns = [_vsub(points[index], origin, q) for index in indices]
+            basis = [
+                [columns[column][row] for column in range(DIMENSION)]
+                for row in range(DIMENSION)
+            ]
+            if not _det3(basis, q):
+                continue
+            inverse = _mat_inv(basis, q)
+            transformed = tuple(sorted(
+                _mat_vec(inverse, _vsub(point, origin, q), q)
+                for point in points
+            ))
+            if best is None or transformed < best:
+                best = transformed
+    if best is None:
+        # Generated translation sets always span, but keep the key deterministic.
+        return ("nonspanning", tuple(sorted(points)))
+    return best
+
+
+def canonical_key(inst) -> str:
+    """Canonical under IDs, input order, leaf swap, and affine coordinates."""
+
+    q = inst["field_order"]
+    coord_by_id, id_by_coord, _adjacency, row_order = _instance_maps(inst)
+    zero_id = id_by_coord["C"][(0, 0, 0)]
+    pair_forms = []
+    for leaf in LEAVES:
+        neighbor_points = [
+            coord_by_id[leaf][vertex_id] for vertex_id in row_order[leaf][zero_id]
+        ]
+        pair_forms.append(_canonical_affine_set(neighbor_points, q))
+    payload = {
+        "q": q,
+        "dimension": DIMENSION,
+        "degree": inst["degree"],
+        "translation_sets": sorted(pair_forms),
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Grow all three vertex classes at fixed 24-coefficient answer length."""
+
+    current = {key: value for key, value in params.items() if key != "_preset"}
+    q = int(current.get("n", 7))
+    current["n"] = _next_prime(2 * q + 1)
+    current["degree"] = int(current.get("degree", 11))
+    return current
+
+
+def _derive_from_selector(inst, selector):
+    answer = {}
+    maps = _instance_maps(inst)
+    for leaf in LEAVES:
+        choices = _basis_neighbor_coords(inst, leaf, maps=maps, ordered=True)
+        images = [selector(leaf, index, values, maps) for index, values in enumerate(choices)]
+        answer[leaf] = _cert_from_images(images, inst["field_order"])
+    return answer
+
+
+def _attack_outlier_frequency(inst):
+    maps = _instance_maps(inst)
+    _coord_by_id, _id_by_coord, adjacency, _row_order = maps
+    frequency = {leaf: {} for leaf in LEAVES}
+    for leaf in LEAVES:
+        for targets in adjacency[leaf].values():
+            for target in targets:
+                frequency[leaf][target] = frequency[leaf].get(target, 0) + 1
+
+    def select(leaf, _index, values, local_maps):
+        coord_by_id, id_by_coord, _adj, _rows = local_maps
+        return min(
+            values,
+            key=lambda coord: (frequency[leaf][id_by_coord[leaf][coord]], id_by_coord[leaf][coord]),
+        )
+
+    return _derive_from_selector(inst, select)
+
+
+def _attack_greedy_lexicographic(inst):
+    return _derive_from_selector(
+        inst, lambda _leaf, _index, values, _maps: min(values)
+    )
+
+
+def _attack_random_basis(inst, rng, attempts):
+    maps = _instance_maps(inst)
+    choices = {
+        leaf: _basis_neighbor_coords(inst, leaf, maps=maps, ordered=True)
+        for leaf in LEAVES
+    }
+    last = None
+    for _ in range(attempts):
+        candidate = {}
+        for leaf in LEAVES:
+            images = [rng.choice(values) for values in choices[leaf]]
+            candidate[leaf] = _cert_from_images(images, inst["field_order"])
+        last = candidate
+        if verify(inst, candidate)[0]:
+            return candidate, True
+    return last, False
+
+
+def _attack_identity_ansatz(inst):
+    maps = _instance_maps(inst)
+    choices = {
+        leaf: _basis_neighbor_coords(inst, leaf, maps=maps, ordered=False)[0]
+        for leaf in LEAVES
+    }
+    ident = _identity()
+    for left_b in choices["L"]:
+        for right_b in choices["R"]:
+            candidate = {"L": _cert(ident, left_b), "R": _cert(ident, right_b)}
+            if verify(inst, candidate)[0]:
+                return candidate
+    return {"L": _cert(ident, choices["L"][0]), "R": _cert(ident, choices["R"][0])}
+
+
+def _reference_algorithm(inst):
+    answer = {}
+    total = {
+        "candidate_matrices": 0,
+        "determinant_checks": 0,
+        "edge_membership_tests": 0,
+        "field_operations": 0,
+    }
+    for leaf in LEAVES:
+        cert, metrics = _enumerate_leaf(inst, leaf, stop_first=True)
+        if cert is None:
+            return None, total
+        answer[leaf] = cert
+        for key in total:
+            total[key] += metrics[key]
+    return answer, total
+
+
+def _random_affine_change(rng, q):
+    return _random_gl(q, rng), tuple(rng.randrange(q) for _ in range(DIMENSION))
+
+
+def _transform_instance(inst, rng, relabel_ids=False, affine=False,
+                        swap_leaves=False, reorder=False):
+    """Apply genuine problem symmetries and carry the coefficient witness."""
+
+    result = copy.deepcopy(inst)
+    q = result["field_order"]
+
+    if relabel_ids:
+        old_ids = [record["id"] for part in ("C", "L", "R")
+                   for record in result["vertices"][part]]
+        new_ids = list(old_ids)
+        rng.shuffle(new_ids)
+        mapping = dict(zip(old_ids, new_ids))
+        for records in result["vertices"].values():
+            for record in records:
+                record["id"] = mapping[record["id"]]
+        for superedge in result["superedges"]:
+            for row in superedge["rows"]:
+                row["center"] = mapping[row["center"]]
+                row["neighbors"] = [mapping[value] for value in row["neighbors"]]
+
+    if affine:
+        changes = {part: _random_affine_change(rng, q) for part in ("C", "L", "R")}
+        for part, records in result["vertices"].items():
+            matrix, offset = changes[part]
+            for record in records:
+                record["coord"] = list(
+                    _vadd(_mat_vec(matrix, tuple(record["coord"]), q), offset, q)
+                )
+        center_matrix, center_offset = changes["C"]
+        center_inverse = _mat_inv(center_matrix, q)
+        transformed_answer = {}
+        for leaf in LEAVES:
+            leaf_matrix, leaf_offset = changes[leaf]
+            old = result["answer"][leaf]
+            new_matrix = _mat_mul(
+                _mat_mul(leaf_matrix, old["matrix"], q), center_inverse, q
+            )
+            transformed_center_offset = _mat_vec(new_matrix, center_offset, q)
+            new_offset = _vsub(
+                _vadd(_mat_vec(leaf_matrix, tuple(old["offset"]), q), leaf_offset, q),
+                transformed_center_offset,
+                q,
+            )
+            transformed_answer[leaf] = _cert(new_matrix, new_offset)
+        result["answer"] = transformed_answer
+
+    if swap_leaves:
+        result["vertices"]["L"], result["vertices"]["R"] = (
+            result["vertices"]["R"], result["vertices"]["L"]
+        )
+        for superedge in result["superedges"]:
+            superedge["leaf"] = "R" if superedge["leaf"] == "L" else "L"
+        result["answer"] = {
+            "L": result["answer"]["R"],
+            "R": result["answer"]["L"],
+        }
+
+    if reorder:
+        for records in result["vertices"].values():
+            rng.shuffle(records)
+        rng.shuffle(result["superedges"])
+        for superedge in result["superedges"]:
+            rng.shuffle(superedge["rows"])
+            for row in superedge["rows"]:
+                rng.shuffle(row["neighbors"])
+    return result
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def _intended_route_operations(params):
+    degree = params["degree"]
+    # Per super-edge: sum d three-vectors at 0,e1,e2,e3; take nine
+    # differences and multiply by d^{-1}.  One small Euclidean inversion of d
+    # is shared between the two edges and conservatively charged four steps.
+    return 2 * (4 * DIMENSION * (degree - 1) + 2 * DIMENSION * DIMENSION) + 4
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return a JSON-native measurement report."""
+
+    report = {}
+
+    failures = []
+    checks = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 19):
