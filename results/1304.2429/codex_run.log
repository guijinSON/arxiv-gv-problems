+    q = inst["q"]
+    lanes = inst["lanes"]
+    degree = inst["regular_degree"]
+    lines = [
+        "AFFINE P4-FACTOR CERTIFICATE",
+        "",
+        "Let F_q be the integers modulo the displayed prime q.  The graph has",
+        "vertices (part, lane, x), where part is 0,1,2,3; lane is numbered",
+        f"0 through {lanes - 1}; and x is in F_q.  Thus it has {4 * lanes * q} vertices.",
+        "A P4 is a path on four vertices.  A P4-factor is a set of vertex-disjoint",
+        "P4 copies covering every graph vertex; its edges need not be induced.",
+        "",
+        "For each lane, the table below defines a bipartite graph B_lane:",
+        "row x lists every right coordinate y adjacent to left coordinate x.",
+        "The same B_lane is used between parts 0-1, 1-2, and 2-3 in that lane.",
+        "There are no edges between different lanes and no other graph edges.",
+        "Neighbor order is irrelevant; coordinates and lane numbers are not.",
+        "",
+        f"Promise: every B_lane is the union of exactly {degree} affine perfect",
+        "matchings x -> a*x+b (mod q), with a nonzero.  The component ordering",
+        "is hidden.  Rows x=0,1,2 distinguish the consistent pairings: pairing",
+        "an image in row 0 with an image in row 1 and extending affinely reaches",
+        "a listed image in row 2 exactly for a true component matching.",
+        "",
+        "Task: for every lane give coefficients [a,b] of any one affine component.",
+        "Using that same component on all three consecutive part pairs gives a",
+        "perfect matching on each super-edge and hence a P4-factor of the full graph.",
+        f"Coefficients must be ordinary base-10 integers with 1 <= a < {q} and",
+        f"0 <= b < {q}; all arithmetic in the condition is modulo q={q}.",
+        "",
+        f"q = {q}; lanes = {lanes}; affine components per lane = {degree}",
+        "",
+    ]
+    for lane, rows in enumerate(inst["neighbors"]):
+        lines.append(f"LANE {lane}")
+        for x, ys in enumerate(rows):
+            lines.append(f"{x}: " + ",".join(str(y) for y in ys))
+        lines.append("")
+
+    lines.extend([
+        "Give your final answer inside <answer></answer> tags as one JSON object",
+        f"with exactly {lanes} pairs in lane order:",
+        '<answer>{"affine_maps":[[a0,b0],[a1,b1]]}</answer>',
+        "The example above illustrates two lanes; your array must have the displayed",
+        "number of lanes. Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text) -> object | None:
+    """Extract the tagged JSON certificate, tolerating prose and code fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
+    if fence:
+        body = fence.group(1).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check any affine-map certificate directly; never consult inst['answer']."""
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if set(answer) != {"affine_maps"}:
+        return False, "answer must contain only the affine_maps field"
+    maps = answer["affine_maps"]
+    if not isinstance(maps, list):
+        return False, "affine_maps must be a list"
+    if not maps:
+        return False, "affine_maps must not be empty"
+    lanes = inst["lanes"]
+    if len(maps) < lanes:
+        return False, f"too few lane maps: expected {lanes}, got {len(maps)}"
+    if len(maps) > lanes:
+        return False, f"too many lane maps: expected {lanes}, got {len(maps)}"
+    q = inst["q"]
+    for lane, pair in enumerate(maps):
+        if not isinstance(pair, list) or len(pair) != 2:
+            return False, f"lane {lane} map must be a two-integer list [a,b]"
+        a, b = pair
+        if isinstance(a, bool) or not isinstance(a, int):
+            return False, f"lane {lane} slope is not an integer"
+        if isinstance(b, bool) or not isinstance(b, int):
+            return False, f"lane {lane} intercept is not an integer"
+        if not 1 <= a < q:
+            return False, f"lane {lane} slope is outside 1..q-1"
+        if not 0 <= b < q:
+            return False, f"lane {lane} intercept is outside 0..q-1"
+        rows = inst["neighbors"][lane]
+        for x in range(q):
+            y = (a * x + b) % q
+            if y not in rows[x]:
+                return False, f"lane {lane} affine edge is missing at x={x}"
+        # a != 0 over prime F_q makes x -> ax+b a bijection.  Reusing it on
+        # the three super-edges creates q disjoint P4s in this lane.
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Sample uniformly from the fully shape-aware affine certificate language."""
+    q = inst["q"]
+    return {
+        "affine_maps": [
+            [rng.randrange(1, q), rng.randrange(q)]
+            for _ in range(inst["lanes"])
+        ]
+    }
+
+
+def search_space(inst) -> int | None:
+    """Count all allowed affine coefficient vectors exactly."""
+    return (inst["q"] * (inst["q"] - 1)) ** inst["lanes"]
+
+
+def enumerate_all(inst) -> int | None:
+    """Brute-force the full language only for genuinely hand-scale fields."""
+    q = inst["q"]
+    lanes = inst["lanes"]
+    if q > 31 or lanes != 1:
+        return None
+    count = 0
+    for a in range(1, q):
+        for b in range(q):
+            count += int(verify(inst, {"affine_maps": [[a, b]]})[0])
+    return count
+
+
+def _valid_affine_maps(rows, q):
+    """Recover valid maps for canonicalisation, independent of row-list order."""
+    found = set()
+    for b in rows[0]:
+        for y1 in rows[1]:
+            a = (y1 - b) % q
+            if a == 0:
+                continue
+            if all((a * x + b) % q in rows[x] for x in range(q)):
+                found.add((a, b))
+    return sorted(found)
+
+
+def canonical_key(inst) -> str:
+    """A structural invariant under lane order, affine coordinates, and P4 reversal.
+
+    Slopes of the recovered component permutations are invariant under a common
+    affine coordinate change x -> ux+t.  Reversing P4 replaces each slope by
+    its multiplicative inverse.  Sorted row/column degree profiles strengthen
+    the invariant without pretending to solve unrestricted graph isomorphism.
+    """
+    q = inst["q"]
+    lane_signatures = []
+    reversed_signatures = []
+    for rows in inst["neighbors"]:
+        maps = _valid_affine_maps(rows, q)
+        slopes = tuple(sorted(a for a, _b in maps))
+        inv_slopes = tuple(sorted(pow(a, -1, q) for a, _b in maps))
+        row_degrees = tuple(sorted(len(set(ys)) for ys in rows))
+        col = [0] * q
+        for ys in rows:
+            for y in set(ys):
+                col[y] += 1
+        col_degrees = tuple(sorted(col))
+        lane_signatures.append((slopes, row_degrees, col_degrees))
+        reversed_signatures.append((inv_slopes, col_degrees, row_degrees))
+    forward = tuple(sorted(lane_signatures))
+    backward = tuple(sorted(reversed_signatures))
+    normal = min(forward, backward)
+    payload = json.dumps({"q": q, "lanes": normal}, separators=(",", ":"))
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Grow only the field haystack; certificate length and compact work stay fixed."""
+    clean = {k: v for k, v in params.items() if k != "_preset"}
+    n = int(clean["n"])
+    if n >= 16001:
+        return None
+    return {
+        "n": 2 * n + 1,
+        "lanes": int(clean.get("lanes", 6)),
+        "degree": int(clean.get("degree", 3)),
+    }
+
+
+def _reference_scan(inst):
+    """General exhaustive affine scan; return a witness and edge-probe count."""
+    q = inst["q"]
+    answer = []
+    probes = 0
+    for rows in inst["neighbors"]:
+        chosen = None
+        for a in range(1, q):
+            for b in range(q):
+                good = True
+                for x in range(q):
+                    probes += 1
+                    if (a * x + b) % q not in rows[x]:
+                        good = False
+                        break
+                if good:
+                    chosen = [a, b]
+                    break
+            if chosen is not None:
+                break
+        if chosen is None:
+            return None, probes
+        answer.append(chosen)
+    return {"affine_maps": answer}, probes
+
+
+def _greedy_candidate(inst):
+    maps = []
+    q = inst["q"]
+    for rows in inst["neighbors"]:
+        b = min(rows[0])
+        y1 = next((y for y in sorted(rows[1]) if (y - b) % q != 0), rows[1][0])
+        a = (y1 - b) % q or 1
+        maps.append([a, b])
+    return {"affine_maps": maps}
+
+
+def _outlier_candidate(inst):
+    maps = []
+    q = inst["q"]
+    for rows in inst["neighbors"]:
+        indegree = [0] * q
+        for ys in rows:
+            for y in set(ys):
+                indegree[y] += 1
+        b = min(rows[0], key=lambda y: (indegree[y], y))
+        choices = [y for y in rows[1] if (y - b) % q]
+        y1 = min(choices or rows[1], key=lambda y: (indegree[y], y))
+        maps.append([(y1 - b) % q or 1, b])
+    return {"affine_maps": maps}
+
+
+def _translation_candidate(inst):
+    return {"affine_maps": [[1, min(rows[0])] for rows in inst["neighbors"]]}
+
+
+def _relabel_instance(inst, lane_order, transforms, reverse_path=False, shuffle_seed=0):
+    """Carry graph and witness through composed genuine problem symmetries."""
+    q = inst["q"]
+    out_tables = []
+    out_answers = []
+    old_answers = inst["answer"]["affine_maps"]
+    rrng = random.Random(shuffle_seed)
+    for new_lane, old_lane in enumerate(lane_order):
+        u, t = transforms[new_lane]
+        old_rows = inst["neighbors"][old_lane]
+        rows = [[] for _ in range(q)]
+        for x, ys in enumerate(old_rows):
+            nx = (u * x + t) % q
+            rows[nx] = [(u * y + t) % q for y in ys]
+            rrng.shuffle(rows[nx])
+        a, b = old_answers[old_lane]
+        nb = (u * b + (1 - a) * t) % q
+        if reverse_path:
+            reversed_rows = [[] for _ in range(q)]
+            for x, ys in enumerate(rows):
+                for y in ys:
+                    reversed_rows[y].append(x)
+            for ys in reversed_rows:
+                rrng.shuffle(ys)
+            rows = reversed_rows
+            inv_a = pow(a, -1, q)
+            a, nb = inv_a, (-inv_a * nb) % q
+        out_tables.append(rows)
+        out_answers.append([a, nb])
+    out = dict(inst)
+    out["neighbors"] = out_tables
+    out["answer"] = {"affine_maps": out_answers}
+    return out
+
+
+def _answer_atom_count(answer):
+    if not isinstance(answer, dict):
+        return 0
+    maps = answer.get("affine_maps")
+    if not isinstance(maps, list):
+        return 0
+    return sum(len(pair) for pair in maps if isinstance(pair, list))
+
+
+def selftest() -> dict:
+    report = {}
+
+    # G1: every named preset, three independent seeds.
+    planted_ok = 0
+    planted_total = 0
+    for _preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 2):
+            instance = make_instance(seed=seed, **params)
+            planted_ok += int(verify(instance, instance["answer"])[0])
+            planted_total += 1
+    report["G1_planted_verifies"] = {
+        "pass": planted_ok == planted_total,
+        "verified": planted_ok,
+        "attempts": planted_total,
+    }
+
+    shipping = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    base = [pair[:] for pair in shipping["answer"]["affine_maps"]]
+    swapped = base[:]
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    duplicated = [pair[:] for pair in base]
+    duplicated[1] = duplicated[0][:]
+    corruptions = {
+        "drop": {"affine_maps": base[:-1]},
+        "swap": {"affine_maps": swapped},
+        "duplicate": {"affine_maps": duplicated},
+        "empty": {"affine_maps": []},
+        "out_of_range": {"affine_maps": [[shipping["q"], base[0][1]]] + base[1:]},
+    }
+    corruption_results = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(shipping, candidate)
+        corruption_results[name] = {"rejected": not ok, "reason": why}
+    reasons = {entry["reason"] for entry in corruption_results.values()}
+    report["G2_rejects_corruption"] = {
+        "pass": all(entry["rejected"] for entry in corruption_results.values())
+                and len(reasons) == len(corruption_results),
+        "cases": corruption_results,
+        "distinct_reasons": len(reasons),
+    }
+
+    wire = json.dumps(shipping["answer"], separators=(",", ":"))
+    realistic = (
+        "I matched the affine rows in each lane.\n"
+        f"<answer>```json\n{wire}\n```</answer>\n"
+        "The maps give the three super-edge matchings."
