+def _leaf_valid(inst, leaf, cert, maps=None, metrics=None):
+    q = inst["field_order"]
+    normalised, _reason = _normalise_cert(cert, leaf, q)
+    if normalised is None:
+        return False
+    matrix, offset = normalised
+    if maps is None:
+        maps = _instance_maps(inst)
+    coord_by_id, id_by_coord, adjacency, _ = maps
+    for center_id, source in coord_by_id["C"].items():
+        if metrics is not None:
+            metrics["edge_membership_tests"] += 1
+            metrics["field_operations"] += 18
+        target = _vadd(_mat_vec(matrix, source, q), offset, q)
+        target_id = id_by_coord[leaf][target]
+        if target_id not in adjacency[leaf][center_id]:
+            return False
+    return True
