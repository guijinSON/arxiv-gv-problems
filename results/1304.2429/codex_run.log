+    values = list(dict.fromkeys(int(v) % data["p"] for v in intercepts))
+    for value in range(data["p"]):
+        if len(values) >= data["required"]:
+            break
+        if value not in values:
+            values.append(value)
+    return [[slope % data["p"], b] for b in values[:data["required"]]]
 
