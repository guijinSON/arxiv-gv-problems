def _is_prime(value):
    if value < 2:
        return False
    if value % 2 == 0:
        return value == 2
    divisor = 3
    while divisor * divisor <= value:
        if value % divisor == 0:
            return False
        divisor += 2
    return True


def _next_prime(value):
    candidate = max(3, value | 1)
    while not _is_prime(candidate):
        candidate += 2
    return candidate


def make_instance(n, seed=0, decoy_permutations=3, label_modulus=1000003, **params):
    """Plant a perfect matching first, then add edge-disjoint decoy matchings."""
    if not isinstance(n, int) or n < 3:
        raise ValueError("n must be an integer at least 3")
    if not isinstance(decoy_permutations, int) or decoy_permutations < 1:
        raise ValueError("decoy_permutations must be a positive integer")
    if not isinstance(label_modulus, int) or not _is_prime(label_modulus):
        raise ValueError("label_modulus must be prime")
    if n >= label_modulus:
        raise ValueError("n must be smaller than label_modulus")
    if decoy_permutations >= n:
        raise ValueError("fewer than n decoy permutations are required")

    rng = random.Random(seed)
    q = label_modulus
    forbidden = ({x % q for x in range(-16, 17)} if q > 100 else {0})
    multiplier = rng.randrange(1, q)
    while multiplier in forbidden:
        multiplier = rng.randrange(1, q)

    labels = []
    seen_labels = set()
    while len(labels) < n:
        label = rng.randrange(q)
        if label not in seen_labels:
            seen_labels.add(label)
            labels.append(label)

    planted = [(multiplier * label) % q for label in labels]
    users = list(planted)
    rng.shuffle(users)
    authorizations = [[planted[i]] for i in range(n)]

    # Each accepted decoy is itself a perfect matching and shares no row-edge
    # with an earlier one. Rejection samples decoys, never the certificate.
    for _ in range(decoy_permutations):
        while True:
            proposal = list(users)
            rng.shuffle(proposal)
            if all(proposal[i] not in authorizations[i] for i in range(n)):
                break
        for i, user in enumerate(proposal):
            authorizations[i].append(user)
    for row in authorizations:
        rng.shuffle(row)

    return {
        "n": n,
        "label_modulus": q,
        "audit_multiplier": multiplier,
        "step_labels": labels,
        "users": users,
        "authorizations": authorizations,
        "counting_constraint": [1, list(range(n))],
        "answer": planted,
    }


def render(inst):
    """Render the complete native WSP instance and exact answer format."""
    n = inst["n"]
    q = inst["label_modulus"]
    lines = [
        "WORKFLOW SATISFIABILITY: AUTHORIZATION MATCHING",
        "",
        f"There are {n} steps S0,...,S{n-1} and exactly {n} users.",
        "A plan assigns one displayed user identifier to every step. There are no",
        "precedence restrictions. A plan is authorized when each assigned user",
        "appears in that step's authorization list.",
        "",
        "The workflow has the counting constraint (1,{S0,...,S(n-1)}). By",
        "definition, every user who performs any listed steps must perform exactly",
        "one of them. Since there are n steps and n users, a valid plan therefore",
        "uses every displayed user exactly once; order matters by step, repeats are",
        "forbidden, and no other constraint is imposed.",
        "",
        f"Auxiliary audit modulus: q={q}.",
        f"Auxiliary audit multiplier: A={inst['audit_multiplier']}.",
        "Step labels and authorized user identifiers:",
    ]
    for i, (label, row) in enumerate(zip(inst["step_labels"], inst["authorizations"])):
        lines.append(
            f"  S{i}: label={label}; authorized=" + ",".join(str(x) for x in row)
            f"  S{i}: label={label}; authorized=" + ",".join(str(x) for x in row)
        )
    lines.extend([
        "",
        "Displayed user set (input order has no significance):",
        "  " + ",".join(str(x) for x in inst["users"]),
        "",
        "Find any valid plan. Output exactly n integer user identifiers in fixed",
        f"step order S0,S1,...,S{n-1}. Each must be from the displayed user set.",
        "",
        "Give your final answer inside <answer></answer> tags as comma-separated",
        "integers. Example syntax: <answer>17, 4, 29</answer>",
        "Output nothing else inside the tags.",
    ])
    mode = os.environ.get("GV_HINT_MODE")
    if mode == "structural":
        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
    elif mode == "placebo":
        lines.extend(["", "Hint: " + PLACEBO_HINT])
    return "\n".join(lines)


_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer>", re.I | re.S)


def parse_answer(text):
    """Parse the final delimited comma-separated integer list; never raise."""
    if not isinstance(text, str):
        return None
    blocks = _ANSWER_RE.findall(text)
    if not blocks:
        return None
    body = blocks[-1].strip()
    if not body:
        return []
    if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
        return None
    try:
        return [int(token.strip()) for token in body.split(",")]
    except (TypeError, ValueError):
        return None


def verify(inst, answer):
    """Check authorization and (1,S) exactly; never consult inst['answer']."""
    if not isinstance(answer, list):
        return False, "answer must be a list of user identifiers"
    n = inst["n"]
    if not answer:
        return False, "answer is empty"
    if len(answer) < n:
        return False, f"too few plan entries: expected {n}, got {len(answer)}"
    if len(answer) > n:
        return False, f"too many plan entries: expected {n}, got {len(answer)}"
    user_set = set(inst["users"])
    for i, user in enumerate(answer):
        if type(user) is not int or user not in user_set:
            return False, f"entry {i} is not a displayed user identifier"
    if len(set(answer)) != n:
        return False, "counting constraint (1,S) is violated by a repeated user"
    for step, user in enumerate(answer):
        if user not in inst["authorizations"][step]:
            return False, f"step S{step} is assigned an unauthorized user"
    return True, "ok"


def random_candidate(inst, rng):
    """Uniformly sample permutations, enforcing the obvious all-different rule."""
    candidate = list(inst["users"])
    rng.shuffle(candidate)
    return candidate


def search_space(inst):
    return math.factorial(inst["n"])


def enumerate_all(inst):
    """Exact brute-force count only when the permutation space is safely small."""
    if search_space(inst) > 1_000_000:
        return None
    return sum(
        verify(inst, list(candidate))[0]
        for candidate in itertools.permutations(inst["users"])
    )


def canonical_key(inst):
    """Canonical under step renumbering and every input-list reordering."""
    rows = sorted(
        [label, sorted(row)]
        for label, row in zip(inst["step_labels"], inst["authorizations"])
    )
    payload = {
        "q": inst["label_modulus"],
        "audit_multiplier": inst["audit_multiplier"],
        "users": sorted(inst["users"]),
        "rows": rows,
        "constraint": [1, "all steps"],
    }
    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def escalate(params):
    """Grow arithmetic and decoy axes at fixed 120-entry witness length."""
    p = {key: value for key, value in params.items() if key != "_preset"}
    q = int(p.get("label_modulus", 1000003))
    decoys = int(p.get("decoy_permutations", 4))
    n = int(p["n"])
    if q < 1_000_000_000_000:
        p["label_modulus"] = _next_prime(10 * q + 1)
        p["decoy_permutations"] = decoys
        p["n"] = n
        return p
    if decoys < 8:
        p["decoy_permutations"] = decoys + 1
        p["label_modulus"] = q
        p["n"] = n
        return p
    return None


def _hopcroft_karp_reference(inst):
    """Paper-standard maximum matching, with exact operation counters."""
    n = inst["n"]
    user_index = {user: i for i, user in enumerate(inst["users"])}
    adjacency = [[user_index[user] for user in row] for row in inst["authorizations"]]
    pair_step = [-1] * n
    pair_user = [-1] * n
    distance = [0] * n
    counts = {"edge_scans": 0, "bfs_rounds": 0, "dfs_calls": 0, "augmentations": 0}

    def bfs():
        counts["bfs_rounds"] += 1
        queue = deque()
        found = False
        for step in range(n):
            if pair_step[step] < 0:
                distance[step] = 0
                queue.append(step)
            else:
                distance[step] = -1
        while queue:
            step = queue.popleft()
            for user in adjacency[step]:
                counts["edge_scans"] += 1
                other = pair_user[user]
                if other < 0:
                    found = True
                elif distance[other] < 0:
                    distance[other] = distance[step] + 1
                    queue.append(other)
        return found

    def dfs(step):
        counts["dfs_calls"] += 1
        for user in adjacency[step]:
            counts["edge_scans"] += 1
            other = pair_user[user]
            if other < 0 or (distance[other] == distance[step] + 1 and dfs(other)):
                pair_step[step] = user
                pair_user[user] = step
                return True
        distance[step] = -1
        return False

    while bfs():
        progress = False
        for step in range(n):
            if pair_step[step] < 0 and dfs(step):
                counts["augmentations"] += 1
                progress = True
        if not progress:
            break
    if any(user < 0 for user in pair_step):
        return None, counts
    return [inst["users"][user] for user in pair_step], counts


def _attack_row_extreme(inst, largest=False):
    return [(max(row) if largest else min(row)) for row in inst["authorizations"]]


def _attack_label_nearest(inst):
    q = inst["label_modulus"]
    answer = []
    for label, row in zip(inst["step_labels"], inst["authorizations"]):
        answer.append(min(row, key=lambda user: (min((user-label) % q, (label-user) % q), user)))
    return answer


def _attack_greedy_unused(inst, rng, attempts):
    """Random-order greedy matching with restarts, but no augmenting paths."""
    n = inst["n"]
    last = None
    for _ in range(attempts):
        order = list(range(n))
        rng.shuffle(order)
        used = set()
        answer = [None] * n
        for step in order:
            choices = [user for user in inst["authorizations"][step] if user not in used]
            if not choices:
                break
            user = rng.choice(choices)
            answer[step] = user
            used.add(user)
        else:
            if verify(inst, answer)[0]:
                return answer, True
        last = answer
    # Return a well-shaped but invalid candidate if every restart got stuck.
    if last is None or any(user is None for user in last):
        last = _attack_row_extreme(inst)
    return last, False


def _permute_instance(inst, step_permutation, user_order, row_orders):
    n = inst["n"]
    labels = [None] * n
    rows = [None] * n
    answer = [None] * n
    for old, new in enumerate(step_permutation):
        labels[new] = inst["step_labels"][old]
        rows[new] = [inst["authorizations"][old][i] for i in row_orders[old]]
        answer[new] = inst["answer"][old]
    return {
        "n": n,
        "label_modulus": inst["label_modulus"],
        "audit_multiplier": inst["audit_multiplier"],
        "step_labels": labels,
        "users": [inst["users"][i] for i in user_order],
        "authorizations": rows,
        "counting_constraint": [1, list(range(n))],
        "answer": answer,
    }


def selftest():
    """Run all local gates and return a JSON-native measurement report."""
    report = {}
    failures = []
    attempts = 0
    for preset, params in DIFFICULTY.items():
        for seed in (0, 1, 19):
            inst = make_instance(seed=seed, **params)
            ok, why = verify(inst, inst["answer"])
            attempts += 1
            if not ok:
                failures.append([preset, seed, why])
    report["G1_planted_verifies"] = {
        "pass": not failures, "attempts": attempts, "failures": failures,
    }

    shipping = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
    planted = shipping["answer"]
    swapped = None
    for i in range(shipping["n"]):
        for j in range(i + 1, shipping["n"]):
            trial = list(planted)
            trial[i], trial[j] = trial[j], trial[i]
            if not verify(shipping, trial)[0]:
                swapped = trial
                break
        if swapped is not None:
            break
    corruptions = {
        "drop": planted[:-1],
        "swap": swapped,
        "duplicate": planted[:1] + planted,
        "empty": [],
        "out_of_range": planted[:-1] + [shipping["label_modulus"]],
    }
    cases, reasons = {}, []
    for name, candidate in corruptions.items():
        ok, why = verify(shipping, candidate)
        cases[name] = {"accepted": bool(ok), "reason": why}
        reasons.append(why)
    report["G2_rejects_corruption"] = {
        "pass": all(not case["accepted"] for case in cases.values()) and len(set(reasons)) == 5,
        "cases": cases, "distinct_reasons": len(set(reasons)),
    }

    wire = ", ".join(str(value) for value in planted)
    parsed = parse_answer("Matching found.\n```\n<answer>" + wire + "</answer>\n```")
    report["G3_round_trip"] = {
        "pass": parsed == planted and json.loads(json.dumps(planted)) == planted,
        "parsed_entries": len(parsed) if isinstance(parsed, list) else None,
        "json_native": json.loads(json.dumps(planted)) == planted,
    }

    total, hits = 200_000, 0
    rng = random.Random(271828)
    t0 = time.perf_counter()
    for _ in range(total):
        hits += int(verify(shipping, random_candidate(shipping, rng))[0])
    density_wall = time.perf_counter() - t0
    density = hits / total
    report["G4_guess_resistance"] = {
        "pass": density < 1e-6, "hits": hits, "total": total,
        "observed_fraction": density, "structure_aware_space": search_space(shipping),
        "prior": "uniform over permutations of all displayed users",
    }

    t0 = time.perf_counter()
    _, baseline_success = _attack_greedy_unused(shipping, random.Random(161803), 4096)
    baseline_wall = time.perf_counter() - t0
    demo = make_instance(seed=0, **DIFFICULTY["demo"])
    report["G5_density_and_baseline_cost"] = {
        "pass": not baseline_success,
        "shipping_density_hits": hits,
        "shipping_density_samples": total,
        "shipping_sampled_density": density,
        "shipping_density_wall_sec": round(density_wall, 6),
        "demo_exact_solution_count": enumerate_all(demo),
        "demo_candidate_count": search_space(demo),
        "baseline_greedy_restarts": 4096,
        "baseline_wall_sec": round(baseline_wall, 6),
        "baseline_successes": int(baseline_success),
    }

    names = [
        "outlier_row_minimum", "outlier_row_maximum", "label_nearest_authorized",
        "greedy_single_pass", "random_greedy_restart_256",
    ]
    attacks = {name: {"successes": 0, "attempts": 0} for name in names}
    reference = {
        "name": "Hopcroft-Karp maximum matching",
        "complexity": "O(E * sqrt(V))",
        "attempts": 0, "successes": 0, "wall_clock_sec": 0.0,
        "edge_scans": 0, "bfs_rounds": 0, "dfs_calls": 0, "augmentations": 0,
    }
    for seed in range(8):
        inst = make_instance(seed=10_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
        greedy_min, _ = _attack_greedy_unused(inst, random.Random(seed), 1)
        random_greedy, _ = _attack_greedy_unused(inst, random.Random(90_000 + seed), 256)
        candidates = {
            "outlier_row_minimum": _attack_row_extreme(inst),
            "outlier_row_maximum": _attack_row_extreme(inst, True),
            "label_nearest_authorized": _attack_label_nearest(inst),
            "greedy_single_pass": greedy_min,
            "random_greedy_restart_256": random_greedy,
        }
        for name, candidate in candidates.items():
            attacks[name]["attempts"] += 1
            attacks[name]["successes"] += int(verify(inst, candidate)[0])
        t0 = time.perf_counter()
        plan, counts = _hopcroft_karp_reference(inst)
        reference["wall_clock_sec"] += time.perf_counter() - t0
        reference["attempts"] += 1
        reference["successes"] += int(plan is not None and verify(inst, plan)[0])
        for key in ("edge_scans", "bfs_rounds", "dfs_calls", "augmentations"):
            reference[key] += counts[key]
    reference["wall_clock_sec"] = round(reference["wall_clock_sec"], 6)
    reference["solves"] = f"{reference['successes']}/{reference['attempts']}, as expected"
    all_failed = all(x["successes"] == 0 and x["attempts"] >= 8 for x in attacks.values())
    report["G6_adversary_panel"] = {
        "pass": all_failed and reference["successes"] == 8,
        "attacks": attacks, "reference_algorithm": reference,
    }

    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
    doubled_params["n"] *= 2
    t0 = time.perf_counter()
    doubled = make_instance(seed=424242, **doubled_params)
    build_wall = time.perf_counter() - t0
    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
    report["G7_scales"] = {
        "pass": bool(doubled_ok), "base_n": shipping["n"],
        "doubled_n": doubled["n"], "build_wall_sec": round(build_wall, 6),
        "verify_reason": doubled_why,
    }

    invariant_checks, carried_checks = 0, 0
    distinct, g8_failures = [], []
    for seed in range(20):
        inst = make_instance(seed=70_000 + seed, **DIFFICULTY["easy"])
        rng = random.Random(80_000 + seed)
        steps = list(range(inst["n"])); rng.shuffle(steps)
        users = list(range(inst["n"])); rng.shuffle(users)
        row_orders = []
        for row in inst["authorizations"]:
            order = list(range(len(row))); rng.shuffle(order); row_orders.append(order)
        transformed = _permute_instance(inst, steps, users, row_orders)
        invariant_checks += 1
        if canonical_key(transformed) != canonical_key(inst):
            g8_failures.append([seed, "key changed under relabeling/reordering"])
        carried_checks += 1
        if not verify(transformed, transformed["answer"])[0]:
            g8_failures.append([seed, "carried witness failed"])
        distinct.append(canonical_key(inst))
    report["G8_canonical_key"] = {
        "pass": not g8_failures and len(set(distinct)) == 20,
        "invariance_checks": invariant_checks,
        "carried_witness_checks": carried_checks,
        "unrelated_instances": 20, "distinct_keys": len(set(distinct)),
        "failures": g8_failures,
    }

    blob = json.dumps(planted, separators=(",", ":"))
    chars, elements = len(blob), len(planted)
    tokens = (chars + 3) // 4
    operations = 2 * shipping["n"]
    hinted, placebo = _G9_ARMS["hinted"], _G9_ARMS["placebo"]
    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
    caps = chars <= 2000 and elements <= 256 and operations <= 300
    report["G9_no_tool_suitability"] = {
        "pass": _G9_HINTED_VERDICT == "hardened" and caps,
        "arms": json.loads(json.dumps(_G9_ARMS)),
        "hinted_minus_placebo": hinted_rate - placebo_rate,
        "hinted_verdict": _G9_HINTED_VERDICT,
        "answer_chars": chars, "answer_tokens": tokens,
        "answer_elements": elements, "intended_route_operations": operations,
        "within_caps": caps,
    }

    report["track"] = TRACK
    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
    report["all_passed"] = all(
        value.get("pass") is True
        for key, value in report.items()
        if key.startswith("G") and isinstance(value, dict)
    )
    return report


if __name__ == "__main__":
    print(json.dumps(selftest(), indent=2, sort_keys=True))
# arXiv 1205.0852 WSP generator

> Status: locally verified, but **not shippable yet**. STEP 4 and G9 are blocked because the configured OpenRouter key returns HTTP 403 `Key limit exceeded (total limit)` before any attempt can be scored. `selftest_report.json` therefore records G9 as pending and `all_passed=false`.

| Profile field | Value |
|---|---|
| Track | B — a polynomial reference algorithm exists and is disclosed |
| Native domain | combinatorics |
| Object regime | finite discrete |
| Computational core | graph (authorization matching) |
| Certificate | integer tuple: a workflow plan |
| Intuition | invariant — one matching is linear in the step labels over `Z_q` |
| Domain essentiality | native; no reduction |

## Problem and provenance

The generator is based on Crampton, Gutin, and Yeo, [*On the Parameterized Complexity and Kernelization of the Workflow Satisfiability Problem*](https://arxiv.org/abs/1205.0852). A solver receives workflow steps, users, the step-user authorization relation, and the paper's counting constraint `(1,S)`, which requires a different user for every listed step. It must return an authorized user for every step, with no repeats. `verify` checks user membership, distinctness, and authorization using exact integer operations.

Sections 2.1–2.2 fix those definitions. Section 6, Theorem 6.5 constructs the authorization bipartite graph and explicitly applies Hopcroft–Karp maximum matching. That observation determines the track: this family is not structurally hard. Hopcroft–Karp solves it in `O(E sqrt(V))`; the final local run solved 8/8 shipping instances in 0.003164 seconds total with 16,435 edge scans. The benchmark target is the no-tool gap between that mechanical matching route and the 240-operation shortcut `user = A * step_label mod q`.

The generator chooses this linear matching first, then adds independent edge-disjoint permutation matchings as decoys. Every step and every user has the same authorization degree, and authorization-list order is shuffled. The certificate is therefore known by inverse generation, not recovered by solving the generated instance.

## Worked demo (`seed=0`)

```text
WORKFLOW SATISFIABILITY: AUTHORIZATION MATCHING

There are 6 steps S0,...,S5 and exactly 6 users.
The counting constraint (1,{S0,...,S5}) requires all assigned users to differ.
Auxiliary audit modulus: q=31.
Auxiliary audit multiplier: A=28.

S0: label=12; authorized=26,7
S1: label=24; authorized=26,21
S2: label=28; authorized=28,9
S3: label=13; authorized=23,9
S4: label=1;  authorized=23,28
S5: label=8;  authorized=7,21

Displayed users: 26,9,21,7,23,28
```

The planted answer is `[26, 21, 9, 23, 28, 7]`; `verify(inst, answer)` returns `(True, "ok")`. Replacing the last entry with `26` returns `(False, "counting constraint (1,S) is violated by a repeated user")`. A person can solve this six-row matching by hand.

