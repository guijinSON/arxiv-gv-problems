+    report["G6_adversary_panel"] = {
+        "pass": all_failed and ref_success == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "exhaustive affine-map scan",
+            "complexity": "O(lanes*q^3) worst-case exact edge probes",
+            "wall_clock_sec_mean": round(sum(ref_seconds) / len(ref_seconds), 6),
+            "wall_clock_sec_max": round(max(ref_seconds), 6),
+            "operations_mean": round(sum(ref_ops) / len(ref_ops)),
+            "operations_max": max(ref_ops),
+            "solves": f"{ref_success}/8, as expected",
+        },
+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=2718, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["q"] > shipping["q"]
+                and search_space(doubled) > search_space(shipping),
+        "shipping_q": shipping["q"],
+        "doubled_q": doubled["q"],
+        "shipping_vertices": 4 * shipping["lanes"] * shipping["q"],
+        "doubled_vertices": 4 * doubled["lanes"] * doubled["q"],
+        "doubled_planted_verifies": doubled_ok,
+        "answer_elements_unchanged": (
+            _answer_atom_count(doubled["answer"]) == _answer_atom_count(shipping["answer"])
+        ),
+    }
+
+    invariant = 0
+    carried_valid = 0
+    transformed_changed = 0
+    for seed in range(20):
+        instance = make_instance(seed=1000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        rrng = random.Random(9000 + seed)
+        order = list(range(instance["lanes"]))
+        rrng.shuffle(order)
