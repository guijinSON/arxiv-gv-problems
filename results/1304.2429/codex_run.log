-def _intended_route_operations(params):
-    degree = params["degree"]
-    # Per super-edge: sum d three-vectors at 0,e1,e2,e3; take nine
-    # differences and multiply by d^{-1}.  One small Euclidean inversion of d
-    # is shared between the two edges and conservatively charged four steps.
-    return 2 * (4 * DIMENSION * (degree - 1) + 2 * DIMENSION * DIMENSION) + 4
