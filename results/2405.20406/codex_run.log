+
+def _contained_hyperplanes(
+    basis: tuple[tuple[int, ...], ...], p: int
+) -> tuple[tuple[tuple[int, ...], ...], ...]:
+    k, ambient = len(basis), len(basis[0])
+    children = []
+    for h in _subspaces(k, k - 1, p):
+        rows = [
+            [sum(h[i][a] * basis[a][j] for a in range(k)) % p
