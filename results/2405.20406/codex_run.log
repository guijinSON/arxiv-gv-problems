+def _random_gl(n: int, p: int, rng: random.Random) -> list[list[int]]:
+    """Uniformly sample GL(n,p) by rejection from all n-by-n matrices."""
+    while True:
+        a = [[rng.randrange(p) for _ in range(n)] for _ in range(n)]
+        if _rank(a, p) == n:
