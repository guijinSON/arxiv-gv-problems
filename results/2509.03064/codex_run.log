+    return solutions
+
+
+def canonical_key(inst):
+    """A vertex-renaming-invariant 1-WL trace and colour quotient fingerprint."""
+    n = inst["n"]
+    adjacency = [set() for _ in range(n)]
+    for left, right in inst["edges"]:
+        if left == right:
+            continue
+        adjacency[left].add(right)
+        adjacency[right].add(left)
