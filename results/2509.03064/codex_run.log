+
+    # G8: edge ordering, endpoint order, vertex labels, and their composition.
+    invariance_checks = 0
+    carried_witness_checks = 0
+    g8_failures = []
+    unrelated_keys = []
+    key_params = {"n": 48, "k": 3, "mode": "random"}
+    for seed in range(20):
