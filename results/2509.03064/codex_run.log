+        choices = set()
+        choices.add(tuple(range(k)))
+        choices.add(tuple(range(final_length - k, final_length)))
+        even = tuple(sorted({round(i * (final_length - 1) / max(1, k - 1)) for i in range(k)}))
+        if len(even) == k:
