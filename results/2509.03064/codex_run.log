+    report["G2_rejects_corruption"] = {
+        "pass": swapped is not None and rejected == 5 and len(set(reasons.values())) == 5,
+        "rejected": rejected,
+        "distinct_reasons": len(set(reasons.values())),
+        "reasons": reasons,
