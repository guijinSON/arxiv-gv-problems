+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the balanced multiset space a solver would search."""
+    candidate = [
+        vertex
+        for vertex in range(inst["n"])
+        for _ in range(inst["k"])
+    ]
+    rng.shuffle(candidate)
+    return candidate
