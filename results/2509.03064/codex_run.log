+        "n": n,
+        "k": inst["k"],
+        "trace": trace,
+        "sizes": sizes,
+        "cells": [[a, b, cells[(a, b)]] for a in range(class_count)
+                  for b in range(a, class_count) if cells[(a, b)]],
+    }
