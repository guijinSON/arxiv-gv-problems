+    report["G3_round_trip"] = {
+        "pass": parsed == planted,
+        "parsed_length": len(parsed) if parsed is not None else None,
+    }
+
+    # G4: every sample already has exact length, range, and multiplicities.
+    guess_rng = random.Random(20260902)
+    total = 200_000
+    hits = 0
+    for _ in range(total):
