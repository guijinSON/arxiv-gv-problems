+            and search_space(doubled) > search_space(inst)
+            and _is_connected(doubled["n"], _target_edges(doubled))
+        ),
+        "base_n": inst["n"],
+        "base_edges": len(inst["edges"]),
+        "doubled_n": doubled["n"],
+        "doubled_edges": len(doubled["edges"]),
+        "verify_reason": doubled_reason,
+    }
