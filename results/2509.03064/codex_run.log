+    class_count = max(colors, default=-1) + 1
+    sizes = [0] * class_count
+    for color in colors:
+        sizes[color] += 1
+    cells = Counter()
+    for left in range(n):
+        for right in adjacency[left]:
+            if left < right:
+                a, b = sorted((colors[left], colors[right]))
+                cells[(a, b)] += 1
