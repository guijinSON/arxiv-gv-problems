+    # G6: all attacks inspect only public graph data.
+    attack_rows = {
+        "degree_spacing_outlier": [],
+        "incremental_insertion_greedy": [],
+        "local_swap_random_restarts": [],
+    }
+    for seed in range(800, 808):
+        attacked = make_instance(seed=seed, **shipping)
