from random import Random
from time import perf_counter
P0=251

def invs(a): return pow(a,P0-2,P0)
def eye(n): return [[int(i==j) for j in range(n)] for i in range(n)]
def mul(a,b):
 return [[sum(x*y for x,y in zip(row,col))%P0 for col in zip(*b)] for row in a]
def minv(a):
 n=len(a); z=[row[:] + e for row,e in zip(a,eye(n))]
 for c in range(n):
  pivot=next((r for r in range(c,n) if z[r][c]%P0),None)
  if pivot is None: raise ValueError
  z[c],z[pivot]=z[pivot],z[c]
  q=invs(z[c][c]); z[c]=[q*x%P0 for x in z[c]]
  for r in range(n):
   if r"'!=c and z[r][c]:
    q=z[r][c]; z[r]=[(x-q*y)%P0 for x,y in zip(z[r],z[c])]
 return [row[n:] for row in z]
def gl(n,rng):
 while True:
  a=[[rng.randrange(P0) for _ in range(n)] for _ in range(n)]
  try:return a,minv(a)
  except ValueError:pass
def diag(v): return [[v[i] if i==j else 0 for j in range(len(v))] for i in range(len(v))]
def scales(M,N):
 n=len(M); x=[None]*n; a=[None]*n
 for start in range(n):
  if x[start] is not None: continue
  x[start]=1; todo=[(0,start)]
  while todo:
   side,k=todo.pop()
   if side==0:
    for j in range(n):
     if N[k][j] and a[j] is None:
      a[j]=x[k]*M[k][j]*invs(N[k][j])%P0; todo.append((1,j))
   else:
    for i in range(n):
     if M[i][k] and x[i] is None:
      x[i]=N[i][k]*a[k]*invs(M[i][k])%P0; todo.append((0,i))
 if any(v is None or v==0 for v in x+a): raise ValueError
 assert all(x[i]*M[i][j]%P0==N[i][j]*a[j]%P0 for i in range(n) for j in range(n))
 return x,a
def attack(pub):
 P,Q,R,S,u,v,w=pub; pi,qi,ri,si=map(minv,(P,Q,R,S))
 M=mul(mul(S,w),qi); N=mul(S,qi); dx2,da3=scales(M,N)
 x2=mul(mul(si,diag(dx2)),S); a3=mul(mul(qi,diag(da3)),Q)
 c=mul(v,minv(x2)); M=mul(mul(R,c),pi); N=mul(R,pi); dx1,da2=scales(M,N)
 x1=mul(mul(ri,diag(dx1)),R); a2=mul(mul(pi,diag(da2)),P)
 a1=mul(u,minv(x1))
 assert mul(a1,x1)==u and mul(mul(minv(x1),a2),x2)==v and mul(minv(x2),a3)==w
 return a1,a2,a3,x1,x2

def case(seed,n=8):
 rng=Random(seed)
 P,pi=gl(n,rng); Q,qi=gl(n,rng); R,ri=gl(n,rng); S,si=gl(n,rng)
 ds=[[rng.randrange(1,P0) for _ in range(n)] for _ in range(4)]
 a1,_=gl(n,rng)
 a2=mul(mul(pi,diag(ds[0])),P); a3=mul(mul(qi,diag(ds[1])),Q)
 x1=mul(mul(ri,diag(ds[2])),R); x2=mul(mul(si,diag(ds[3])),S)
 u=mul(a1,x1); v=mul(mul(minv(x1),a2),x2); w=mul(minv(x2),a3)
 return P,Q,R,S,u,v,w
cases=[case(i) for i in range(100)]
t0=perf_counter()
for pub in cases: attack(pub)
dt=perf_counter()-t0
print({'"'attacks':len(cases),'full_witness_successes':len(cases),'total_sec':round(dt,6),'mean_ms':round(1000*dt/len(cases),4),'complexity':'O(d"'^3) field operations'"'})
