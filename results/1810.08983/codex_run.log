from random import Random

def inv(a,p): return pow(a,p-2,p)
def mm(a,b,p):
 n=len(a); m=len(b); q=len(b[0])
 return [[sum(a[i][k]*b[k][j] for k in range(m))%p for j in range(q)] for i in range(n)]
def eye(n): return [[int(i==j) for j in range(n)] for i in range(n)]
def mi(a,p):
 n=len(a); z=[row[:] + e for row,e in zip(a,eye(n))]
 for c in range(n):
  r=next(r for r in range(c,n) if z[r][c]%p)
  z[c],z[r]=z[r],z[c]
  t=inv(z[c][c]%p,p); z[c]=[(v*t)%p for v in z[c]]
  for r in range(n):
   if r"'!=c:
    t=z[r][c]%p
    z[r]=[(x-t*y)%p for x,y in zip(z[r],z[c])]
 return [r[n:] for r in z]
def rand_gl(n,p,rng):
 while True:
  a=[[rng.randrange(p) for _ in range(n)] for _ in range(n)]
  try: mi(a,p); return a
  except StopIteration: pass

def diag(v): return [[v[i] if i==j else 0 for j in range(len(v))] for i in range(len(v))]

p=251; n=8; rng=Random(181008983)
Q=rand_gl(n,p,rng); S=rand_gl(n,p,rng)
dx=[rng.randrange(1,p) for _ in range(n)]; da=[rng.randrange(1,p) for _ in range(n)]
x2=mm(mm(mi(S,p),diag(dx),p),S,p)
a3=mm(mm(mi(Q,p),diag(da),p),Q,p)
w=mm(mi(x2,p),a3,p)
M=mm(mm(S,w,p),mi(Q,p),p); N=mm(S,mi(Q,p),p)
assert all(dx[i]*M[i][j]%p == N[i][j]*da[j]%p for i in range(n) for j in range(n))
# In the generic all-nonzero case, normalize da[0]=1 and recover both vectors by ratios.
assert all(M[i][0] and N[i][0] and M[0][i] and N[0][i] for i in range(n))
rda0=1
rdx=[N[i][0]*rda0*inv(M[i][0],p)%p for i in range(n)]
rda=[rdx[0]*M[0][j]*inv(N[0][j],p)%p for j in range(n)]
assert all(rdx[i]*M[i][j]%p == N[i][j]*rda[j]%p for i in range(n) for j in range(n))
rx2=mm(mm(mi(S,p),diag(rdx),p),S,p)
ra3=mm(mm(mi(Q,p),diag(rda),p),Q,p)
assert mm(rx2,w,p)==ra3
print({'"'dimension':n,'prime':p,'linear_equations':n*n,'unknowns':2*n,'verified_recovered_component':True})
