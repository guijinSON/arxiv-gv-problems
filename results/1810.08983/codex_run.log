from random import Random
from time import perf_counter
P=251

def invs(a): return pow(a,P-2,P)
def eye(n): return [[int(i==j) for j in range(n)] for i in range(n)]
def mul(a,b):
 n=len(a); k=len(b); m=len(b[0])
 return [[sum(a[i][t]*b[t][j] for t in range(k))%P for j in range(m)] for i in range(n)]
def minv(a):
 n=len(a); z=[row[:] + e for row,e in zip(a,eye(n))]
 for c in range(n):
  pivot=next((r for r in range(c,n) if z[r][c]%P),None)
  if pivot is None: raise ValueError
  z[c],z[pivot]=z[pivot],z[c]
  q=invs(z[c][c]); z[c]=[q*x%P for x in z[c]]
  for r in range(n):
   if r"'!=c and z[r][c]:
    q=z[r][c]; z[r]=[(x-q*y)%P for x,y in zip(z[r],z[c])]
 return [row[n:] for row in z]
def gl(n,rng):
 while True:
  a=[[rng.randrange(P) for _ in range(n)] for _ in range(n)]
  try:return a,minv(a)
  except ValueError:pass
def diag(v): return [[v[i] if i==j else 0 for j in range(len(v))] for i in range(len(v))]
def attack(Q,S,w):
 qi=minv(Q); M=mul(mul(S,w),qi); N=mul(S,qi); n=len(Q)
 # Propagate x_i M_ij=N_ij a_j on its bipartite support graph.
 x=[None]*n; a=[None]*n
 for start in range(n):
  if x[start] is not None: continue
  x[start]=1; todo=[(0,start)]
  while todo:
   side,k=todo.pop()
   if side==0:
    for j in range(n):
     if N[k][j] and a[j] is None:
      a[j]=x[k]*M[k][j]*invs(N[k][j])%P; todo.append((1,j))
   else:
    for i in range(n):
     if M[i][k] and x[i] is None:
      x[i]=N[i][k]*a[k]*invs(M[i][k])%P; todo.append((0,i))
 if any(v is None or v==0 for v in x+a): raise ValueError('"'degenerate support')
 a3=mul(mul(qi,diag(a)),Q)
 x2=mul(mul(minv(S),diag(x)),S)
 assert mul(x2,w)==a3
 return a3

def case(seed,n=8):
 rng=Random(seed); Q,qi=gl(n,rng); S,si=gl(n,rng)
 dx=[rng.randrange(1,P) for _ in range(n)]; da=[rng.randrange(1,P) for _ in range(n)]
 x2=mul(mul(si,diag(dx)),S); a3=mul(mul(qi,diag(da)),Q); w=mul(minv(x2),a3)
 return Q,S,w
cases=[case(i) for i in range(100)]
t0=perf_counter()
for Q,S,w in cases: attack(Q,S,w)
dt=perf_counter()-t0
print({'attacks':len(cases),'successes':len(cases),'total_sec':round(dt,6),'mean_ms':round(1000*dt/len(cases),4),'complexity':'O(d"'^3) field operations'"'})
