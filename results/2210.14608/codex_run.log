   667	    succ1 = [-1] * n
   668	    succ2 = [-1] * n
   669	    nodes = 0
   670	
   671	    # Static edge scores are label-free local statistics, not construction order.
   672	    incoming = [0] * n
   673	    for row in options:
   674	        for target in row:
   675	            incoming[target] += 1
   676	
   677	    def recurse(left: int) -> bool:
   678	        nonlocal nodes
   679	        if nodes >= node_cap:
   680	            return False
   681	        nodes += 1
   682	        if left == 0:
   683	            return True
   684	        assigned = n - left + 1
   685	        best_source = -1
   686	        best_targets: list[int] | None = None
   687	        for source in range(n):
