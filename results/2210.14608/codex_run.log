import random,time

def word_k(a,b):
 A=list(range(a));B=list(range(a,a+b))
 return A+B+A[::-1]+B[::-1]

def instance(c,seed):
 a=c//2;b=c-a;w=word_k(a,b);q=2*c;H=[(i+1)%q for i in range(q)];pos=[[j for j,x in enumerate(w) if x==i] for i in range(c)];P=H[:]
 for x,y in pos:P[x],P[y]=P[y],P[x]
 rng=random.Random(seed);lab=list(range(q));rng.shuffle(lab);h=[0]*q;p=[0]*q
 for old in range(q):h[lab[old]]=lab[H[old]];p[lab[old]]=lab[P[old]]
 return [sorted({h[i],p[i]}) for i in range(q)]

def solve(adj,cap=1000000):
 groups={}
 for i,a in enumerate(adj):groups.setdefault(tuple(a),[]).append(i)
 pairs=[];succ={}
 for t,srcs in groups.items():
  if len(srcs)==2 and len(t)==2:pairs.append((srcs,t))
  elif len(srcs)==1 and len(t)==1:succ[srcs[0]]=t[0]
 pairs.sort();q=len(adj);nodes=0
 def bad():
  seen=set()
  for s in succ:
   if s in seen:continue
   path={};x=s;k=0
   while x in succ and x not in path:path[x]=k;k+=1;x=succ[x]
   seen.update(path)
   if x in path and (len(succ)<q or k-path[x]<q):return True
  return False
 def rec(i):
  nonlocal nodes
  if nodes>=cap:return False
  nodes+=1
  if bad():return False
  if i==len(pairs):return True
  (a,b),(x,y)=pairs[i]
  succ[a]=x;succ[b]=y
  if rec(i+1):return True
  succ[a]=y;succ[b]=x
  if rec(i+1):return True
  del succ[a];del succ[b];return False
 return rec(0),nodes,len(pairs)
for c in [20,30,40,50,60]:
 vals=[];oks=[]
 t=time.time()
 for seed in range(8):
  o,n,k=solve(instance(c,seed),200000);vals.append(n);oks.append(o)
 print(c,oks,vals,'sec',time.time()-t,flush=True)
