 rng=random.Random(seed);lab=list(range(q));rng.shuffle(lab);h=[0]*q;p=[0]*q
 for old in range(q):h[lab[old]]=lab[H[old]];p[lab[old]]=lab[P[old]]
 adj=[sorted({h[i],p[i]}) for i in range(q)]
 return adj

