import random

def word(c):
 w=[0,1,0]
 for i in range(2,c): w += [i,i-1]
 w += [c-1]
 return w
for c in range(2,8):
 w=word(c)
 inter=[]
 for i in range(c):
  a,b=[j for j,x in enumerate(w) if x==i]
  for k in range(i+1,c):
   x,y=[j for j,z in enumerate(w) if z==k]
   if (a<x<b<y) or (x<a<y<b): inter.append((i,k))
 print(c,w,inter)

def instance(c,seed):
 q=2*c; w=word(c)
 H=[(i+1)%q for i in range(q)]
 pos=[[j for j,x in enumerate(w) if x==i] for i in range(c)]
 P=H[:]
 for a,b in pos:P[a],P[b]=P[b],P[a]
 # relabel
 rng=random.Random(seed); lab=list(range(q));rng.shuffle(lab)
 h=[0]*q;p=[0]*q
 for old in range(q):
  h[lab[old]]=lab[H[old]];p[lab[old]]=lab[P[old]]
 adj=[sorted({h[i],p[i]}) for i in range(q)]
 return h,p,adj

def vars_from(adj):
 groups={}
 for i,a in enumerate(adj): groups.setdefault(tuple(a),[]).append(i)
 pairs=[];fixed=[]
 for t,srcs in groups.items():
  if len(srcs)==2 and len(t)==2:pairs.append((srcs,t))
  elif len(srcs)==1 and len(t)==1:fixed.append((srcs[0],t[0]))
  else: print('weird',srcs,t)
 return pairs,fixed

def solve(adj,cap=1000000):
 pairs,fixed=vars_from(adj);q=len(adj); succ={a:b for a,b in fixed}; nodes=0
 # order pairs random input order? use listed sources
 # cycle prune on assigned succ: if closed cycle length < q -> bad
 def bad():
  seen_global=set()
  for s in list(succ):
   if s in seen_global:continue
   path={}; x=s;k=0
   while x in succ and x not in path:
    path[x]=k;k+=1;x=succ[x]
   seen_global.update(path)
   if x in path:
    clen=k-path[x]
    if len(succ)<q or clen<q:return True
  return False
 ans=None
 def rec(i):
  nonlocal nodes,ans
  if nodes>=cap:return False
  nodes+=1
  if bad():return False
  if i==len(pairs):
   # full and no bad means qcycle
   ans=[succ[x] for x in range(q)];return True
  (a,b),(x,y)=pairs[i]
  # branch sorted matching direct/cross
  succ[a]=x;succ[b]=y
  if rec(i+1):return True
  succ[a]=y;succ[b]=x
  if rec(i+1):return True
  del succ[a];del succ[b]
  return False
 ok=rec(0)
 return ok,nodes,len(pairs)
for c in [10,20,30,40,50,60]:
 vals=[]
 for seed in range(8):vals.append(solve(instance(c,seed)[2],10_000_000)[1])
 print('c',c,'nodes',vals)
