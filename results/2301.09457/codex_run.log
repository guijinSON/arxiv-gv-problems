+    free = [c for c in range(ncols) if c not in set(pivots)]
+    if len(free) != 1:
+        return None, operations
+    free_col = free[0]
+    vector = [0] * ncols
+    vector[free_col] = 1
+    for r in range(rank - 1, -1, -1):
+        pivot_col = pivots[r]
+        value = 0
+        for c in free:
+            value = (value + matrix[r][c] * vector[c]) % 3
+            operations += 2
