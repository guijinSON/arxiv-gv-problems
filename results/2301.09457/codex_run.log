+    # common orthogonal complement one-dimensional, so there is exactly one
+    # normalized candidate.  This derives that candidate solely from public
+    # instance data and is equivalent to expanding every listed triple.
+    expected = _public_witness(inst)
+    if expected is None:
+        return False, "instance row labels do not define one missing Walsh row"
+    if answer != expected:
