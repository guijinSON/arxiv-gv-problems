+
+# Script-owned oracle evidence is copied into these fields after the three
+# independent harden.py runs.  Zeros mean not yet run, not model failures.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
