+        return {
+            "n": nxt,
+            "multiplicity_max": min(8, multiplicity_max + 1),
+            # At n=256 the checksum keeps the post-insight arithmetic route
+            # within 300 operations while the answer reaches the atom cap.
+            "publish_checksum": nxt == 256,
+        }
+    return "cap_bound"
