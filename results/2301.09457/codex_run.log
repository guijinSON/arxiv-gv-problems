+
+def _row_vector_from_parts(n, row_code, row_mask, basis_perm, basis_scales):
+    return [
+        (basis_scales[j] * _walsh_base(row_code, basis_perm[j], row_mask)) % 3
+        for j in range(n)
+    ]
+
+
+def _row_vector(inst, row_code):
+    return _row_vector_from_parts(
+        inst["n"],
+        row_code,
+        inst["row_mask"],
+        inst["basis_perm"],
+        inst["basis_scales"],
+    )
+
