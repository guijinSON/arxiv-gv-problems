+    return "\n".join("  " + " ".join(chunk) for chunk in _chunks(pairs, width))
+
+
+def render(inst):
+    """Render a complete, self-contained exact finite-field problem."""
+    n = inst["n"]
+    code_length = (pow(3, n) - 1) // 2
+    checksum_text = ""
