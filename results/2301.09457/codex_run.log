+    # character evaluation starts the cyclic Gray walk, and n-1 sign updates
+    # emit the remaining coordinates (plus projective normalization).
+    intended_operations = 2 * shipping["n"] + 2
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
