+        "column_count": len(logical_columns),
+        "target_row": row_label[true_and[-1]],
+        "all_one_rows": all_one_rows,
+        "and_inputs": and_inputs,
+        "mate_columns": mate_columns,
+        "or_inputs": or_inputs,
+        "witness_length": 2 * depth - 1,
+        "answer": answer,
