+    if inst.get("witness_length") != expected_length:
+        return None, "witness length is inconsistent with depth"
+    compiled = {
+        "cache_version": 1,
+        "rows": rows,
+        "cols": cols,
+        "target": target,
+        "depth": depth,
+        "all_one": all_one,
+        "and_inputs": and_inputs,
+        "mates": tuple(mates),
+        "base_columns": set(mates),
+        "or_inputs": or_inputs,
+    }
