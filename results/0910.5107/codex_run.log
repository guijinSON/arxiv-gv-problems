index 6f1a206fd6e5e1e0549a30e7be37ddba594b24de..0e3962880fcc0c8a567434bba523cdf7c50d37fb
--- a/g9_hinted/gen_0910_5107.py
+++ b/g9_hinted/gen_0910_5107.py
@@ -90,10 +90,7 @@
 # n is the number of false AND/OR branch pairs.  Depth, hence answer length,
 # stays fixed on the shipping ladder; only the haystack grows.
