+
+def _compile(inst):
+    """Validate and compile the sparse, complete payoff specification."""
+    if isinstance(inst, dict):
+        cached = inst.get("_compiled")
+        if isinstance(cached, dict) and cached.get("cache_version") == 1:
+            return cached, "ok"
