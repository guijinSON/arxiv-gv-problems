+            attack_results[name]["successes"] += int(verify(probe, candidate)[0])
+    attack_wall = time.perf_counter() - attack_started
+    all_failed = all(x["successes"] == 0 for x in attack_results.values())
+    report["G6_adversary_panel"] = {
