+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _falling(x, k):
+    result = 1
+    for i in range(k):
+        result *= x - i
+    return result
+
+
+def _token(side, victim, dominator):
+    return f"{side}{victim}<{side}{dominator}"
