import random,time

def nc_match(points,rng):
    if not points:return []
    # random Catalan split recursively
    i_choices=list(range(1,len(points),2)); rng.shuffle(i_choices)
    j=i_choices[0]
    return [(points[0],points[j])]+nc_match(points[1:j],rng)+nc_match(points[j+1:],rng)

def gen(n,seed):
    rng=random.Random(seed)
    for _ in range(100000):
        side=[rng.randrange(2) for _ in range(n)]
        if sum(side)%2 or (n-sum(side))%2:continue
        M=[]
        for s in (0,1):M+=nc_match([i for i,x in enumerate(side) if x==s],rng)
        if len(M)"'!=n//2:continue
        if any((a-b)%n in (1,n-1) for a,b in M):continue
        E={tuple(sorted((i,(i+1)%n))) for i in range(n)}|{tuple(sorted(e)) for e in M}
        perm=list(range(n));rng.shuffle(perm)
        E={tuple(sorted((perm[a],perm[b]))) for a,b in E}
        plant=[perm[i] for i in range(n)]
        return E,plant
    raise Exception('"'fail')

def dfs_ham(n,E,limit=1_000_000):
    A=[[] for _ in range(n)]
    for a,b in E:A[a].append(b);A[b].append(a)
    for x in A:x.sort()
    nodes=0; start=0; seen=[False]*n;seen[start]=1;path=[start]
    def rec(v):
        nonlocal nodes
        nodes+=1
        if nodes>limit:return None
        if len(path)==n:return path[:] if start in A[v] else None
        # candidates onward-degree smallest
        C=[w for w in A[v] if not seen[w]]
        C.sort(key=lambda w:sum(not seen[z] for z in A[w]))
        for w in C:
            seen[w]=1;path.append(w)
            # prune any unvisited vertex with zero possible incident to unvisited/current/start rough
            bad=False
            for u in range(n):
                if not seen[u] and not any((not seen[z]) or z==start for z in A[u]):bad=True;break
            if not bad:
                z=rec(w)
                if z:return z
            path.pop();seen[w]=0
        return None
    t=time.perf_counter();sol=rec(start);return bool(sol),nodes,time.perf_counter()-t
for n in (30,50,80,120,160):
    vals=[]
    for seed in range(8):
        E,p=gen(n,seed)
        vals.append(dfs_ham(n,E))
    print(n,vals)
