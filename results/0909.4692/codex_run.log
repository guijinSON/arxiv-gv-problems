+            key=lambda v: (
+                sum((not seen[w]) or w == 0 for w in adj[v]),
+                v,
+            )
+        )
+        for nxt in choices:
+            seen[nxt] = True
+            path.append(nxt)
+            result = visit(nxt)
+            if result is not None:
+                return result
+            path.pop()
+            seen[nxt] = False
+            if exhausted:
+                return None
+        return None
