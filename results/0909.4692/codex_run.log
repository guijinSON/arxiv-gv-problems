+    return _candidate_from_path(path)
+
+
+def _attack_random_restarts(
+    inst: dict, rng: random.Random, restarts: int = 64
+) -> tuple[list[int] | None, int]:
+    adj = _adjacency(inst)
+    n = inst["n"]
+    operations = 0
+    for _ in range(restarts):
+        path = [0]
+        seen = {0}
