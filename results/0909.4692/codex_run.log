+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=731, **ship_params)
+    planted = inst["answer"]
+
+    # G2: choose a swap that genuinely breaks an edge, and demand five distinct
+    # rejection codes (prefix before optional detail).
