+def _normalize_cycle(order: list[int]) -> list[int]:
+    """Canonicalize rotation and reversal of a spanning cyclic order."""
+    if not order:
+        return []
+    try:
+        at = order.index(0)
+    except ValueError:
+        return order[:]
+    out = order[at:] + order[:at]
+    if len(out) > 2 and out[1] > out[-1]:
+        out = [out[0]] + list(reversed(out[1:]))
+    return out
