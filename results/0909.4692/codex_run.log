+            return None
+        order = [0]
+        previous = -1
+        current = 0
+        while True:
+            nxt = cut[current][0] if cut[current][0] != previous else cut[current][1]
+            if nxt == 0:
+                return _normalize_cycle(order) if len(order) == n else None
+            if nxt in order:
