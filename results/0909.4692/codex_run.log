+            "samples": guess_total,
+            "observed_fraction": guess_hits / guess_total,
+            "wall_clock_sec": round(density_seconds, 6),
+        },
+        "demo_exact_valid_answers": demo_count,
+        "demo_search_space": search_space(demo),
+        "strongest_attack": {
