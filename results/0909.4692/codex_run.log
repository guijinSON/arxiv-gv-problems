+    attack_seeds = list(range(9100, 9108))
+    successes = {
+        "label_order_outlier": 0,
+        "greedy_constrained_walk": 0,
+        "random_restart_64": 0,
+        "hamilton_dfs_250k": 0,
+    }
+    random_operations = 0
+    dfs_nodes = 0
+    dfs_wall = 0.0
+    per_seed_nodes = []
+    for seed in attack_seeds:
+        attack_inst = make_instance(seed=seed, **ship_params)
