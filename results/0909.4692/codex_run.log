+    # can define it more compactly than listing these predictable edges.
+    pattern_edges = [[i, (i + 1) % n] for i in range(n)]
+    return {
+        "family": "planar_spanning_cycle_subgraph_isomorphism",
+        "n": n,
+        "host_vertices": list(range(n)),
+        "host_edges": edge_list,
