+    edges = {tuple(sorted(e)) for e in inst["host_edges"]}
+    for i, u in enumerate(answer):
+        v = answer[(i + 1) % n]
+        if tuple(sorted((u, v))) not in edges:
+            return False, f"missing_host_edge_at_position_{i}"
+    return True, "ok"
