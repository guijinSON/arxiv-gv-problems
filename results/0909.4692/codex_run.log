+        if verify(inst, candidate)[0]:
+            guess_hits += 1
+    density_seconds = time.perf_counter() - t0
+    report["G4_guess_resistance"] = {
+        "pass": guess_hits / guess_total < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
