+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Edges whose endpoint lists name a nonedge of the skew-sum target form the "
+    "only obstruction subgraph."
+)
+PLACEBO_HINT = (
+    "The endpoint conventions and sorted output format reward especially careful "
