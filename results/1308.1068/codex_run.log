+def random_candidate(inst: dict[str, Any], rng: random.Random) -> object:
+    """Uniformly sample the exact disjoint-union certificate language."""
+    symbolic = 2 * inst["p"]
+    explicit = 1 << inst["n"]
+    draw = rng.randrange(symbolic + explicit)
+    if draw < symbolic:
+        return {"shift": draw // 2, "swap": draw & 1}
+    bits = draw - symbolic
+    return {"mapping": [(bits >> i) & 1 for i in range(inst["n"])]}
 
 
