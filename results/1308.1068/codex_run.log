+
+def render(inst: dict) -> str:
+    n = inst["padding_per_side"]
+    active = inst["active_per_color"]
+    total = inst["n_vertices"]
+    rows = _adjacency_rows(inst)
+    row_text = "\n".join(
+        f"  {v}: " + (" ".join(map(str, nbrs)) if nbrs else "-")
