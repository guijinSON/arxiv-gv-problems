+def _adjacency_bitsets(inst: dict[str, Any]) -> tuple[list[int], list[int]]:
+    n = inst["n"]
+    bitsets = [0] * n
+    degrees = [0] * n
+    for u, v in inst["edges"]:
+        bitsets[u] |= 1 << v
+        bitsets[v] |= 1 << u
+        degrees[u] += 1
+        degrees[v] += 1
+    return bitsets, degrees
 
 
