+    path_logical: list[list[tuple[int, int]]] = []
+    path_half_sizes: list[int] = []
+    path_id = 0
+    for d in pair_sizes:
+        for orientation in (0, 1):
+            path = []
+            for pos in range(2 * d + 1):
