-
-def _pairs_text(pairs: list[list[int]], per_line: int = 4) -> str:
-    chunks = []
-    for i in range(0, len(pairs), per_line):
-        chunks.append("  " + " ".join(
-            f"({a},{b})" for a, b in pairs[i:i + per_line]
-        ))
-    return "\n".join(chunks) if chunks else "  (none)"
