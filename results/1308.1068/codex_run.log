+def canonical_key(inst: dict[str, Any]) -> str:
+    """Affine-label and vertex-renumbering invariant structural key.
+
+    The centered label set is canonicalised exactly under every nonzero affine
+    field map.  The graph component uses isomorphism invariants (degrees,
+    vertex common-neighbour signatures, and their global histogram).  This is
+    intentionally not a hash of the seed or renderer.
+    """
+    p = inst["p"]
+    n = inst["n"]
+    labels = inst["labels"]
+    center = sum(labels) * pow(n, -1, p) % p
+    offsets = [(label - center) % p for label in labels]
+    label_normal = min(
+        tuple(sorted(value * pow(base, -1, p) % p for value in offsets))
+        for base in offsets
+        if base
+    )
 
+    adjacency, degrees = _adjacency_bitsets(inst)
+    vertex_signatures = []
+    pair_counts: Counter[int] = Counter()
+    for i in range(n):
+        local = []
+        for j in range(n):
+            if i == j:
+                continue
+            common = (adjacency[i] & adjacency[j]).bit_count()
+            local.append(common)
+            if i < j:
+                pair_counts[common] += 1
+        vertex_signatures.append((degrees[i], tuple(sorted(local))))
+    graph_invariant = (
+        len(inst["edges"]),
+        tuple(sorted(degrees)),
+        tuple(sorted(vertex_signatures)),
+        tuple(sorted(pair_counts.items())),
+    )
+    payload = repr((p, n, label_normal, graph_invariant)).encode("ascii")
+    return hashlib.sha256(payload).hexdigest()
 
