+def escalate(params: dict[str, Any]) -> dict[str, Any] | None:
+    """Grow coefficient entropy and edge crowding without lengthening the answer."""
+    n = int(params["n"])
+    p = int(params["p"])
+    degree = int(params["degree"])
+    next_p = _next_prime_3mod4(4 * p + 3)
+    next_degree = min(n // 2 - 2, degree + 4)
+    intended_ops = n + 2 * next_p.bit_length() + 1
+    if intended_ops > 300 or next_degree < 2:
+        return None
+    return {"n": n, "p": next_p, "degree": next_degree}
 
