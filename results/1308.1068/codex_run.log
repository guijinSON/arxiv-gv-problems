-def _bad_degrees(inst: dict) -> dict[int, int]:
-    degree = {v: 0 for v in _active_vertices(inst)}
-    for u, v in inst["constraint_edges_E12"]:
-        degree[u] += 1
-        degree[v] += 1
-    return degree
