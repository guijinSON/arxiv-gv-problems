-def _adjacency_rows(inst: dict) -> list[tuple[int, list[int]]]:
-    rows = {v: [] for v in _active_vertices(inst)}
-    for u, v in inst["constraint_edges_E12"]:
-        rows[u].append(v)
-        rows[v].append(u)
-    return [(v, sorted(rows[v])) for v in sorted(rows)]
