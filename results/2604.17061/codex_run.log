+    n = inst["n"]
+    x = [1] * n
+    y = [1] * n
+    for i in range(n - 1):
+        y[i + 1] = -q[i][i + 1] * x[i]
+        x[i + 1] = -q[i + 1][i] * y[i]
+        operations += 4
+    answer = {"x": x, "y": y, "z": _zero_slice_vector(inst)}
+    elapsed = time.perf_counter() - started
+    return answer, operations, elapsed
