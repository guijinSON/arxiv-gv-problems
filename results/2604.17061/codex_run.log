+def _candidate_from_scores(inst, row_scores, col_scores):
+    x = [1] + [1 if value >= 0 else -1 for value in row_scores[1:]]
+    y = [1] + [1 if value >= 0 else -1 for value in col_scores[1:]]
+    return {"x": x, "y": y, "z": _zero_slice_vector(inst)}
