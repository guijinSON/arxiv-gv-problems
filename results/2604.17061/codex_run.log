+def _sign(rng):
+    return 1 if rng.randrange(2) else -1
+
+
+def _zero_matrix(n):
+    return [[0 for _ in range(n)] for _ in range(n)]
+
+
+def _edge_piece(x, y, edge):
+    """diag(x)*(e_i-e_j)(e_i-e_j)^T*diag(y), j=i+1."""
+    n = len(x)
+    i, j = edge, edge + 1
+    out = _zero_matrix(n)
+    out[i][i] = x[i] * y[i]
+    out[i][j] = -x[i] * y[j]
+    out[j][i] = -x[j] * y[i]
+    out[j][j] = x[j] * y[j]
+    return out
