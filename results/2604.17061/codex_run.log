+            "complexity": "O(m*n^2) exact integer additions plus O(n) sign propagation",
+            "wall_clock_sec": round(sum(reference_times) / 8, 6),
+            "operations": round(sum(reference_operations) / 8),
+            "solves": f"{reference_successes}/8, as expected",
+        },
