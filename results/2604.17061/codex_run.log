+except ImportError:                 # pragma: no cover - documented fallback
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "rational_exact",
+    "computational_core": "polynomial_identity",
