+        "answer": answer,
+    }
+
+
+def _compact_json(value):
+    return json.dumps(value, separators=(",", ":"))
+
+
+def render(inst):
+    n = inst["n"]
+    slices = inst["slices"]
+    m = len(slices)
+    rows = []
+    for k, matrix in enumerate(slices):
+        rows.append(f"slice {k}:")
+        rows.extend("  " + " ".join(str(v) for v in row) for row in matrix)
+
