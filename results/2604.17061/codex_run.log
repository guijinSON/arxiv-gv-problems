+    out["slices"] = [[[signs[i] * value for value in row]
+                      for i, row in enumerate(matrix)] for matrix in inst["slices"]]
+    x = [a * b for a, b in zip(signs, inst["answer"]["x"])]
+    if x[0] == -1:
