+    return out
+
+
+def _matrix_add(a, b):
+    return [[u + v for u, v in zip(ra, rb)] for ra, rb in zip(a, b)]
+
+
+def _matrix_neg_plus(a, d):
+    return [[-u + v for u, v in zip(ra, rd)] for ra, rd in zip(a, d)]
