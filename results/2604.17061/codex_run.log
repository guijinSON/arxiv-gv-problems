+
+def _run_attack_panel(params, seeds=range(8)):
+    attacks = {
+        "outlier_lowest_l1_slice": {"successes": 0, "attempts": 0,
+                                     "wall_clock_sec": 0.0},
+        "greedy_single_slice_signs": {"successes": 0, "attempts": 0,
