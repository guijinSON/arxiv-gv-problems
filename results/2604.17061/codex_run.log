+        raise ValueError("coefficient_bound must be an integer at least 2")
+
+    rng = random.Random(seed)
+    x = [1] + [_sign(rng) for _ in range(n - 1)]
+    y = [1] + [_sign(rng) for _ in range(n - 1)]
