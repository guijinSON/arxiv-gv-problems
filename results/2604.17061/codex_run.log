+def _flip_cols(inst, signs):
+    out = copy.deepcopy(inst)
+    out["slices"] = [[[signs[j] * value for j, value in enumerate(row)]
+                      for row in matrix] for matrix in inst["slices"]]
+    y = [a * b for a, b in zip(signs, inst["answer"]["y"])]
+    if y[0] == -1:
