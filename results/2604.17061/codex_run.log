+    a_selected = inst["slices"][selected]
+    if any(value != 0 for row in a_selected for value in row):
+        return False, "z does not select the unique all-zero slice"
+
+    n = inst["n"]
+    for k, matrix in enumerate(inst["slices"]):
+        contraction = 0
+        for i in range(n):
+            row_dot = 0
+            for j in range(n):
+                row_dot += matrix[i][j] * y[j]
