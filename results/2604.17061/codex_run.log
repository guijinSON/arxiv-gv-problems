+        values.extend((value, -value))
+    if count % 2:
+        values.append(0)
+    rng.shuffle(values)
+    out = _zero_matrix(n)
+    for position, value in enumerate(values):
+        i, j = divmod(position, n)
+        out[i][j] = x[i] * y[j] * value
