+        rng2 = random.Random(700_001 + seed)
+        sp = list(range(len(original["slices"])))
+        rp = list(range(original["n"]))
+        cp = list(range(original["n"]))
+        rng2.shuffle(sp)
+        rng2.shuffle(rp)
+        rng2.shuffle(cp)
