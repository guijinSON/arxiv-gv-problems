+        "zero comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 3.3, Theorem 3.5 (zero-slice singular pencil), and Section 4, "
+        "Proposition 4.2 (matrix slices are exactly tensor contractions)"
