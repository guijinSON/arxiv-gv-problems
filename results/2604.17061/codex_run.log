+
+def _permute_cols(inst, permutation):
+    out = copy.deepcopy(inst)
+    out["slices"] = [[[row[old] for old in permutation] for row in matrix]
+                     for matrix in inst["slices"]]
+    y = [inst["answer"]["y"][old] for old in permutation]
+    if y[0] == -1:
