+    cases = {}
+    cases["empty"] = {}
+    dropped = copy.deepcopy(a)
+    dropped["x"] = dropped["x"][:-1]
+    cases["drop_coordinate"] = dropped
+    swapped = copy.deepcopy(a)
+    swapped["x"], swapped["z"] = swapped["z"], swapped["x"]
+    cases["swap_vectors"] = swapped
+    duplicate = copy.deepcopy(a)
