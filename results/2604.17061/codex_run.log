+def canonical_key(inst):
+    """Cheap monomial-basis invariant: normalized absolute coefficient multiset."""
+    values = [abs(value) for matrix in inst["slices"]
+              for row in matrix for value in row]
+    common = 0
+    for value in values:
+        common = math.gcd(common, value)
+    common = common or 1
+    normalized = sorted(value // common for value in values)
+    payload = {
+        "shape": [inst["n"], inst["n"], len(inst["slices"])],
+        "absolute_coefficients": normalized,
+    }
+    return hashlib.sha256(_compact_json(payload).encode()).hexdigest()
