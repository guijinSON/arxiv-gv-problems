+    "hard": {"n": 18, "pair_factor": 3, "coefficient_bound": 9},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+
+STRUCTURAL_HINT = (
+    "Pair the nonzero slices as near-negatives: their sparse residuals form a "
+    "signed path Laplacian whose off-diagonals propagate x and y."
+)
+PLACEBO_HINT = (
