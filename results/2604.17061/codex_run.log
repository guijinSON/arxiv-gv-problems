+        return f"x has wrong length: expected {n}, got {len(x)}"
+    if len(y) != n:
+        return f"y has wrong length: expected {n}, got {len(y)}"
+    if len(z) != m:
+        return f"z has wrong length: expected {m}, got {len(z)}"
+    return None
