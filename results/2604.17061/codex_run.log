+    guess_time = time.perf_counter() - started
+    density = hits / samples
+    report["G4_guess_resistance"] = {
+        "pass": density < 1e-6,
+        "hits": hits, "total": samples, "fraction": density,
+        "candidate_space": search_space(inst),
