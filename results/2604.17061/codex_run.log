+        "pass": not failures, "attempts": attempts, "failures": failures}
+
+    params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=73, **params)
+    a = inst["answer"]
+    corruptions = {}
+    cases = {}
+    cases["empty"] = {}
+    dropped = copy.deepcopy(a)
