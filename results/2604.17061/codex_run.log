+def _aggregate_slices(inst):
+    n = inst["n"]
+    total = _zero_matrix(n)
+    operations = 0
+    for matrix in inst["slices"]:
+        for i in range(n):
+            for j in range(n):
+                total[i][j] += matrix[i][j]
+                operations += 1
+    return total, operations
