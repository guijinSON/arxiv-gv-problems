+        ("greedy_single_slice_signs", _attack_greedy_first_slice),
+        ("random_restart_64_coordinate_descent", _attack_random_restart),
+        ("by_hand_constant_alternating_diagonal_ansatz", _attack_by_hand_ansatz),
+    ]
