+    if any(mtx):
+        return False, "third contraction M(z)^T x is nonzero"
+    return True, "ok"
+
+
+def _zero_slice_vector(inst):
+    positions = [k for k, matrix in enumerate(inst["slices"])
+                 if all(value == 0 for row in matrix for value in row)]
+    if len(positions) != 1:
+        return None
+    z = [0] * len(inst["slices"])
+    z[positions[0]] = 1
+    return z
