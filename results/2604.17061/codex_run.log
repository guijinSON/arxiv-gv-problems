+    chars, tokens, elements = _answer_metrics(inst)
+    pair_count = max(inst["n"] - 1, inst["n"] * inst["pair_factor"])
+    intended_operations = 4 * pair_count + 4 * (inst["n"] - 1)
+    arms = {name: dict(G9_ORACLE_RESULTS[name])
