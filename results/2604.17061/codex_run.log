+
+def _dense_annihilator(x, y, bound, rng):
+    """An exchangeable dense integer matrix R with x^T R y exactly zero."""
+    n = len(x)
+    count = n * n
+    values = []
+    for _ in range(count // 2):
+        value = rng.randint(1, bound)
+        values.extend((value, -value))
+    if count % 2:
+        values.append(0)
+    rng.shuffle(values)
+    out = _zero_matrix(n)
