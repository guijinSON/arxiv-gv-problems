+        "invariant_relabellings": invariant,
+        "invariance_attempts": expected,
+        "real_transformations_verified": carried,
+        "real_transformation_attempts": expected,
+        "unrelated_distinct_keys": len(set(unrelated)),
+        "unrelated_attempts": 20,
