+                 and len(larger["slices"]) * larger["n"] ** 2
+                 > len(inst["slices"]) * inst["n"] ** 2),
+        "shipping_n": inst["n"], "doubled_n": larger["n"],
+        "shipping_tensor_entries": len(inst["slices"]) * inst["n"] ** 2,
+        "doubled_tensor_entries": len(larger["slices"]) * larger["n"] ** 2,
