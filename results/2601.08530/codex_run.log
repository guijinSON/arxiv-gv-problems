+
+def _winner(rows: list[int], seeding: Iterable[int]) -> int:
+    current = list(seeding)
+    while len(current) > 1:
+        current = [
+            a if _beats(rows, a, b) else b
+            for a, b in zip(current[0::2], current[1::2])
+        ]
+    return current[0]
