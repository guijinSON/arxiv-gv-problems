+    # of opponents it directly defeated along this particular bracket path.
+    current = answer[:]
+    path_wins: dict[int, set[int]] = {}
+    favorite_opponents = []
+    while len(current) > 1:
+        following = []
+        for a, b in zip(current[0::2], current[1::2]):
+            if favorite in (a, b):
+                other = b if a == favorite else a
+                favorite_opponents.append(other)
+                win = favorite
+            else:
+                win = a if _beats(rows, a, b) else b
+                lose = b if win == a else a
+                path_wins.setdefault(win, set()).add(lose)
+            following.append(win)
+        current = following
