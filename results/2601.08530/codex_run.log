+{
+  "G1_planted_verifies": {
+    "pass": true,
+    "attempts": 12,
+    "failures": []
+  },
+  "G2_rejects_corruption": {
+    "pass": true,
+    "cases": {
+      "drop_one": {
+        "rejected": true,
+        "reason": "wrong length: expected 256, got 255"
+      },
+      "swap_one": {
+        "rejected": true,
+        "reason": "favorite 70 did not win; champion was 235"
+      },
+      "duplicate": {
+        "rejected": true,
+        "reason": "player labels are duplicated"
+      },
+      "empty": {
+        "rejected": true,
+        "reason": "answer is empty"
