+                if len(winners) == size:
+                    break
+            if winners:
+                layer[mask] = winners
+            states += 1
+            if states >= cap and mask != full:
+                return None, states
+        possible = layer
+        if full in possible and inst["favorite"] in possible[full]:
+            return possible[full][inst["favorite"]], states
+        size *= 2
+    return None, states
