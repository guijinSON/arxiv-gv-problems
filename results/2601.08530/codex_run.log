+        "drop_one": base[:-1],
+        "swap_one": _find_losing_swap(inst),
+        "duplicate": base[:-1] + [base[0]],
+        "empty": [],
+        "out_of_range": base[:-1] + [inst["n"]],
+    }
+    g2_results = {}
+    for name, candidate in corruptions.items():
+        if candidate is None:
+            g2_results[name] = {"rejected": False, "reason": "no losing swap found"}
+        else:
