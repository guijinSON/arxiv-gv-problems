+        and search_space(doubled) > search_space(inst),
+        "base_n": base_n,
+        "doubled_n": base_n * 2,
+        "doubled_verify": doubled_why,
+        "render_chars_base": len(render(inst)),
+        "render_chars_doubled": len(render(doubled)),
+    }
