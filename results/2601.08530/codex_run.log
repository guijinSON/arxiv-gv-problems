+def _merge_blocks(rows: list[int], pairs, blocks):
+    next_blocks = {}
+    active = []
+    for a, b in pairs:
+        win = a if _beats(rows, a, b) else b
+        next_blocks[win] = blocks[a] + blocks[b]
+        active.append(win)
+    return active, next_blocks
