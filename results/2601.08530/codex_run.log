+        local_seedings.append([M[2 * variable_count + offset]] + group)
+    answer = [v for local in local_seedings for v in local]
+    if len(answer) != n or len(set(answer)) != n:
+        raise AssertionError("witness is not a complete seeding")
+
+    rows = [0] * n
