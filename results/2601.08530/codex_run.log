+        choice.append(names)
+    clause_gadgets = []
+    for _ in range(variable_count):
+        names = {name: fresh() for name in
+                 ("mp", "a", "b", "c", "d", "e", "cg",
+                  "ap", "bp", "cp", "dp", "ep", "cgp")}
