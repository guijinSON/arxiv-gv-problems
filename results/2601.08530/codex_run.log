+    assignment = [bool(rng.getrandbits(1)) for _ in range(variable_count)]
+    clauses = _bounded_formula(variable_count, assignment, rng)
+    gadget_count = n // 16
+
+    next_label = 0
+
+    def fresh(count=1):
+        nonlocal next_label
+        if count == 1:
