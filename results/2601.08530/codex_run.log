+        size *= 2
+    return None, states
+
+
+def _relabel(inst: dict, permutation: list[int]) -> dict:
+    """Map each old player v to new label permutation[v]."""
+    n = inst["n"]
+    rows = [0] * n
+    for old_a in range(n):
