import random, math

def make(n,seed):
 r=random.Random(seed); fav=r.randrange(n); ans=list(range(n));r.shuffle(ans); rows=[0]*n
 for i in range(n):
  if i==fav:continue
  for j in range(i+1,n):
   if j==fav:continue
   if r.getrandbits(1):rows[i]|=1<<j
   else:rows[j]|=1<<i
 cur=ans[:]; opp=[]
 while len(cur)>1:
  nxt=[]
  for a,b in zip(cur[::2],cur[1::2]):
   if a==fav or b==fav:o=b if a==fav else a;opp.append(o);w=fav
   else:w=a if rows[a]>>b&1 else b
   nxt.append(w)
  cur=nxt
 for v in range(n):
  if v==fav:continue
  if v in opp:rows[fav]|=1<<v
  else:rows[v]|=1<<fav
 return fav,rows,ans,opp

def sim(rows,p):
 while len(p)>1:p=[a if rows[a]>>b&1 else b for a,b in zip(p[::2],p[1::2])]
 return p[0]

def greedy(fav, rows):
 n=len(rows); O={v for v in range(n) if v"'!=fav and rows[fav]>>v&1}
 blocks={v:[v] for v in range(n)}; active=list(range(n)); f=fav
 while len(active)>1:
  if f not in active:return None
  os=[v for v in active if v in O]
  if not os:return None
  # spend weakest current O that leaves enough winners
  q=min(os,key=lambda v:((rows[v]&((1<<n)-1)).bit_count(),v))
  pairs=[(f,q)]; used={f,q}; nextw=[f]; O.remove(q)
  # protect remaining O, hardest (low degree) first
  for o in sorted([x for x in active if x in O],key=lambda v:((rows[v]).bit_count(),v)):
   if o in used:continue
   victims=[x for x in active if x not in used and x not in O and (rows[o]>>x)&1]
   if not victims:return None
   x=max(victims,key=lambda v:rows[v].bit_count())
   pairs.append((o,x));used|={o,x};nextw.append(o)
  rest=[x for x in active if x not in used]
  while rest:
   a=rest.pop(0);b=rest.pop(0);pairs.append((a,b));nextw.append(a if rows[a]>>b&1 else b)
  nb={}
  for a,b in pairs:
   w=a if rows[a]>>b&1 else b
   nb[w]=blocks[a]+blocks[b]
  blocks=nb;active=nextw
 return blocks[f]
for n in (32,64,128,256):
 suc=0
 for s in range(100):
  f,w,a,o=make(n,s);p=greedy(f,w)
