+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    if body.startswith("```") and body.endswith("```"):
+        lines = body.splitlines()
+        if len(lines) >= 2:
+            body = "\n".join(lines[1:-1]).strip()
+    if not body:
+        return []
+    if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
+        return None
