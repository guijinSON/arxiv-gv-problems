+
+    # Put the favorable opponents on the tight side of feasibility.  Against
+    # ordinary players, they retain exactly their planted direct wins.  Edges
+    # within the favorable-opponent set stay unbiased, avoiding an artificial
+    # total order among the special players.
+    for a in favorite_opponents:
+        retained = path_wins.get(a, set())
+        for b in range(n):
+            if b == favorite or b == a or b in opponent_set:
+                continue
+            rows[a] &= ~(1 << b)
+            rows[b] &= ~(1 << a)
+            if b in retained:
+                rows[a] |= 1 << b
+            else:
+                rows[b] |= 1 << a
+
+    # The favorite has exactly one possible direct opponent per round.
+    for b in range(n):
+        if b == favorite:
+            continue
+        rows[favorite] &= ~(1 << b)
+        rows[b] &= ~(1 << favorite)
+        if b in opponent_set:
+            rows[favorite] |= 1 << b
+        else:
+            rows[b] |= 1 << favorite
