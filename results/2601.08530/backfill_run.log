   479	def canonical_key(inst: dict) -> str:
   480	    """Canonical rooted-tournament key, invariant under player renumbering."""
   481	    n = inst["n"]
   482	    rows = inst["rows"]
   483	    order = _refinement_order(n, inst["favorite"], rows)
   484	    if order is None:
   485	        # make_instance screens this case; transformed legitimate instances are
   486	        # equally discrete.  Refuse a misleading label-dependent fallback.
   487	        raise ValueError("tournament color refinement is not discrete")
   488	    where = {old: new for new, old in enumerate(order)}
   489	    canonical_rows = []
   490	    for old_a in order:
   491	        mask = 0
   492	        for old_b in order:
   493	            if _beats(rows, old_a, old_b):
   494	                mask |= 1 << where[old_b]
   495	        canonical_rows.append(mask)
   496	    payload = json.dumps(
   497	        [n, where[inst["favorite"]], canonical_rows], separators=(",", ":")
   498	    ).encode("ascii")
   499	    return hashlib.sha256(payload).hexdigest()
