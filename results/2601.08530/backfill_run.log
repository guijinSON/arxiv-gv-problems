   363	    """Sample a winning leaf order first, then construct outcomes around it."""
   364	    if params:
   365	        unknown = ", ".join(sorted(params))
   366	        raise TypeError(f"unknown make_instance parameter(s): {unknown}")
   367	    if type(n) is not int or not _is_power_of_two(n) or n < 128:
   368	        raise ValueError("n must be a power of two and at least 128")
   369	    rng = random.Random(seed)
