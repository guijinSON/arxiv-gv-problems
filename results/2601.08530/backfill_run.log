   435	def verify(inst: dict, answer) -> tuple[bool, str]:
   436	    """Replay a candidate bracket.  The planted answer is never consulted."""
   437	    n = inst["n"]
   438	    if not isinstance(answer, list):
   439	        return False, "answer must be a list"
   440	    if not answer:
   441	        return False, "answer is empty"
   442	    if len(answer) != n:
   443	        return False, f"wrong length: expected {n}, got {len(answer)}"
   444	    if any(type(v) is not int for v in answer):
   445	        return False, "every player label must be an integer"
   446	    if any(v < 0 or v >= n for v in answer):
   447	        return False, f"player label outside inclusive range 0..{n - 1}"
   448	    if len(set(answer)) != n:
   449	        return False, "player labels are duplicated"
   450	    champion = _winner(inst["rows"], answer)
   451	    if champion != inst["favorite"]:
   452	        return False, f"favorite {inst['favorite']} did not win; champion was {champion}"
   453	    return True, "ok"
