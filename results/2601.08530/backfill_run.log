   377	def render(inst: dict) -> str:
   378	    """Render the complete task, data, conventions, and answer wire format."""
   379	    n = inst["n"]
   380	    width = (n + 3) // 4
   381	    rows = "\n".join(
   382	        f"{i}: {inst['rows'][i]:0{width}x}" for i in range(n)
   383	    )
   384	    example = ", ".join(str(i) for i in range(n))
   385	    return f"""Balanced knockout tournament fixing
   386	
   387	There are {n} distinct players, numbered 0 through {n - 1}.  Player
   388	{inst['favorite']} is the favorite.  For every two distinct players, exactly
   389	one is predetermined to beat the other.
   390	
   391	Construct one seeding that makes the favorite champion.  A seeding is a list
   392	containing every player exactly once.  List position is the leaf position and
   393	positions are 0-indexed.  In round 1, positions 0 and 1 play, positions 2 and 3
   394	play, and so on.  In every later round, consecutive surviving winners play in
   395	the same left-to-right order.  A match winner is determined by the table below;
   396	there are no ties or probabilistic outcomes.  Continue until one champion
   397	remains.  Swapping subtrees may describe an equivalent bracket, but your output
   398	must still be a complete {n}-integer list.
   399	
   400	Outcome table (hexadecimal bit masks): row i is a {width}-hex-digit nonnegative
   401	integer.  Its bit j, where the least-significant/rightmost bit is bit 0, is 1
   402	exactly when player i beats player j.  Diagonal bits are 0.  Leading zeroes are
   403	shown and are significant only as padding.
   404	
   405	{rows}
   406	
   407	Give your final answer inside <answer></answer> tags, as {n} comma-separated
   408	base-10 player numbers in leaf order.
   409	Example format: <answer>{example}</answer>
   410	Output nothing else inside the tags."""
   411	
   412	
   413	def parse_answer(text: str) -> object | None:
   414	    """Extract one strict comma-separated integer list from tagged output."""
   415	    if not isinstance(text, str):
   416	        return None
   417	    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text, re.I | re.S)
   418	    if not blocks:
   419	        return None
   420	    body = blocks[-1].strip()
   421	    if body.startswith("```") and body.endswith("```"):
   422	        lines = body.splitlines()
   423	        if len(lines) >= 2:
   424	            body = "\n".join(lines[1:-1]).strip()
   425	    if not body:
   426	        return []
   427	    if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
   428	        return None
   429	    try:
   430	        return [int(piece.strip(), 10) for piece in body.split(",")]
   431	    except (TypeError, ValueError):
   432	        return None
