   512	def _merge_blocks(rows: list[int], pairs, blocks):
   513	    next_blocks = {}
   514	    active = []
   515	    for a, b in pairs:
   516	        win = a if _beats(rows, a, b) else b
   517	        next_blocks[win] = blocks[a] + blocks[b]
   518	        active.append(win)
   519	    return active, next_blocks
   520	
   521	
   522	def _greedy_protector(inst: dict, rng: random.Random | None = None):
   523	    """Keep unused favorite-beatable players alive, using greedy bodyguards."""
   524	    n, favorite, rows = inst["n"], inst["favorite"], inst["rows"]
   525	    favorable = {v for v in range(n) if v != favorite and _beats(rows, favorite, v)}
   526	    active = list(range(n))
   527	    blocks = {v: [v] for v in active}
   528	    while len(active) > 1:
   529	        available = [v for v in active if v in favorable]
   530	        if not available or favorite not in active:
   531	            return None
   532	        if rng is None:
   533	            spent = min(available, key=lambda v: (rows[v].bit_count(), v))
   534	        else:
   535	            spent = rng.choice(available)
   536	        pairs = [(favorite, spent)]
   537	        used = {favorite, spent}
   538	        favorable.remove(spent)
   539	        protect = [v for v in active if v in favorable]
   540	        if rng is None:
   541	            protect.sort(key=lambda v: (rows[v].bit_count(), v))
   542	        else:
   543	            rng.shuffle(protect)
   544	        for player in protect:
   545	            victims = [
   546	                v for v in active
   547	                if v not in used and v not in favorable and _beats(rows, player, v)
   548	            ]
   549	            if not victims:
   550	                return None
   551	            if rng is None:
   552	                victim = max(victims, key=lambda v: (rows[v].bit_count(), -v))
   553	            else:
   554	                victim = rng.choice(victims)
   555	            pairs.append((player, victim))
   556	            used.update((player, victim))
   557	        rest = [v for v in active if v not in used]
   558	        if rng is not None:
   559	            rng.shuffle(rest)
   560	        while rest:
   561	            pairs.append((rest.pop(), rest.pop()))
   562	        active, blocks = _merge_blocks(rows, pairs, blocks)
   563	    return blocks.get(favorite)
   564	
   565	
   566	def _outlier_degree_attack(inst: dict):
   567	    """Put low-outdegree vertices early and the favorite in the first leaf."""
   568	    favorite = inst["favorite"]
   569	    others = [v for v in range(inst["n"]) if v != favorite]
   570	    others.sort(key=lambda v: (inst["rows"][v].bit_count(), v))
   571	    return [favorite] + others
   572	
   573	
   574	def _subset_dp_attack(inst: dict, cap: int = 50_000):
   575	    """Resource-bounded form of the standard exact subset recurrence.
   576	
   577	    It computes all possible winners and one leaf-order witness for power-of-two
   578	    subsets.  ``None`` means the state cap was exhausted before the full set.
   579	    """
   580	    n, rows = inst["n"], inst["rows"]
   581	    possible = {1 << v: {v: [v]} for v in range(n)}
   582	    states = n
   583	    size = 2
   584	    full = (1 << n) - 1
   585	    while size <= n:
   586	        layer = {}
   587	        for combo in itertools.combinations(range(n), size):
   588	            mask = sum(1 << v for v in combo)
   589	            anchor = combo[0]
   590	            rest = combo[1:]
   591	            winners = {}
   592	            for left_tail in itertools.combinations(rest, size // 2 - 1):
   593	                left = (1 << anchor) | sum(1 << v for v in left_tail)
   594	                right = mask ^ left
   595	                if left not in possible or right not in possible:
   596	                    continue
   597	                for a, wa in possible[left].items():
   598	                    for b, wb in possible[right].items():
   599	                        win = a if _beats(rows, a, b) else b
   600	                        if win not in winners:
   601	                            winners[win] = wa + wb
   602	                if len(winners) == size:
   603	                    break
   604	            if winners:
   605	                layer[mask] = winners
   606	            states += 1
   607	            if states >= cap and mask != full:
   608	                return None, states
   609	        possible = layer
   610	        if full in possible and inst["favorite"] in possible[full]:
   611	            return possible[full][inst["favorite"]], states
   612	        size *= 2
   613	    return None, states
   614	
   615	
   616	def _relabel(inst: dict, permutation: list[int]) -> dict:
   617	    """Map each old player v to new label permutation[v]."""
   618	    n = inst["n"]
   619	    rows = [0] * n
   620	    for old_a in range(n):
   621	        new_a = permutation[old_a]
   622	        for old_b in range(n):
   623	            if _beats(inst["rows"], old_a, old_b):
   624	                rows[new_a] |= 1 << permutation[old_b]
   625	    return {
   626	        "n": n,
   627	        "favorite": permutation[inst["favorite"]],
   628	        "rows": rows,
   629	        "answer": [permutation[v] for v in inst["answer"]],
   630	    }
   631	
   632	
   633	def _find_losing_swap(inst: dict):
   634	    base = inst["answer"]
   635	    for i in range(inst["n"]):
   636	        for j in range(i + 1, inst["n"]):
   637	            changed = base[:]
   638	            changed[i], changed[j] = changed[j], changed[i]
   639	            ok, _ = verify(inst, changed)
   640	            if not ok:
   641	                return changed
   642	    return None
   643	
