   468	def enumerate_all(inst: dict) -> int | None:
   469	    """Exactly count winning leaf orders when at most 8! must be replayed."""
   470	    n = inst["n"]
   471	    if n > 8:
   472	        return None
   473	    return sum(
   474	        _winner(inst["rows"], order) == inst["favorite"]
   475	        for order in itertools.permutations(range(n))
