+            value ^= (1 << first) | (1 << second)
+        return value
+    raise ValueError(f"unknown gate kind {kind!r}")
+
+
+def _transpose_gate(mask: int, gate: list | tuple) -> int:
+    """Apply the transpose of a gate to a parity covector."""
+
+    kind, first, second = gate
