+# Updated from the three isolated harden.py runs before shipping.  Pending
+# evidence deliberately makes G9 fail rather than manufacturing an oracle result.
+G9_RESULTS: dict = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
