+    "easy": {"n": 24, "mixer_steps": 176, "chord_count": 3},
+    "medium": {"n": 26, "mixer_steps": 224, "chord_count": 4},
+    "hard": {"n": 28, "mixer_steps": 272, "chord_count": 5},
+}
+
+SHIPPING_DIFFICULTY: str = "easy"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON object {mask, offset} representing the exact rule "
+        "b(x)=popcount(mask AND x) mod 2 XOR offset.  The mask is an n-bit "
+        "integer and offset is 0 or 1; b=0 assigns {0,1}, b=1 assigns {2,3}."
+    ),
+    "bounds": {
+        "mask_min": 0,
+        "mask_max": "2^n-1",
+        "offset_values": [0, 1],
+        "atomic_elements": 2,
+    },
+}
