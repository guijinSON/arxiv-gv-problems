and take no responsibility for any damage it may cause.
#!/usr/bin/python

import itertools
import cytonaut
import networkx
import sys
from reader import read_file
from cert import tag_cert
from gensig import generate_signatures
from minimize import minimal_sets

verbose = True

def path_tags_iter(u_list, v_list, X_restrict=False, bound=4):
    """Iterate over the possible "path tags",
    i.e., assignments to Xhat_1, Xhat_n, and A,
    for given sig, subject to restriction that
    len(Xhat_1) + len(Xhat_n) + len(A) <= bound.

    If X_restrict, then no element may be in both Xhat_1 and Xhat_n.

    Returns 3-tuple A, Xhat_1, Xhat_n."""
    uv_intersection = [x for x in u_list if x in v_list]
    for A_size in range(bound+1):
        for A in itertools.combinations(uv_intersection, A_size):
            UnotA = [x for x in u_list if x not in A and (not X_restrict or x not in v_list)]
            VnotA = [x for x in v_list if x not in A and (not X_restrict or x not in u_list)]
            for X1_size in range(bound+1 - A_size):
                for X1 in itertools.combinations(UnotA, X1_size):
                    if X_restrict:
                        # kick X1 elts out of pool for Xn
                        VnotA = [x for x in VnotA if x not in X1]
                        forced_Xn = ()
                    else:
                        # use observation that Xn "needs to" contain all elts of X1 in the intersection
                        # since otherwise adversary should've just used A
                        # and likewise for X1
                        forced_Xn = tuple(x for x in X1 if x in uv_intersection)

                    VnotA = [x for x in VnotA if (x in X1 or x not in uv_intersection)]
                    max_Xn_size = bound-A_size-X1_size-len(forced_Xn)
                    if max_Xn_size < 0:
                        continue
                    # maybe there's some reason to check smaller Xn (running up against # of colors?)
                    # but I doubt it...
                    for Xn_size in [max_Xn_size]: #range(bound+1 - A_size - X1_size - len(forced_Xn)):
                        for Xn in itertools.combinations(VnotA, Xn_size):
                            # "Flat is better than nested."
                            # --The Zen of Python
                            yield (A, X1, forced_Xn + Xn)

def precolorings(H, sig, partial=None):
    if partial is None:
        partial = {}
    if len(partial) == H.number_of_nodes():
        yield partial
        return

    idx = next(x[1] for x in H if x[1] not in partial) #len(partial)
    v = ("s", idx)
    L = sig[idx]
    for col in itertools.combinations(L, 2):
        # check whether col conflicts with
        # edges of H
        if any( c in partial[j]
                for c in col
                for j in partial
                if ("s", j) in H.neighbors(v) ):
            continue
        new_partial = partial.copy() #partial + (col,)
        new_partial[idx] = col
        for yd in precolorings(H, sig, new_partial):
            yield yd

def solution_iter(H, sig, path_pairs, initial_partial=None):
    """Iterate over solutions to the given H, sig and path_pairs.
    H is the subgraph induced by "decision nodes".
    sig is the list of colors on each decision node.
    path_pairs is a list of
    tuples of the form ((p1,p2, rest), tag), where p1 is the unique
    (for now) X-vertex adjacent to v1 and p2 is the unique (for now)
    X-vertex adjacent to vn.
    
    Right now, we will use index 0 to refer to "u" and index 1 to refer
    to "v". Probably we will eventually want to use some kind of dict for
    this purpose?"""
    # we assume that always we can tolerate <= 2 damage, for now...
    # this may need to change when we start considering even paths.
    #print "checking", path_pairs
    for col in precolorings(H, sig, initial_partial):
 #itertools.product(*(itertools.combinations(x, 2)
 #                       for x in sig)):
        dead = False
        for ((p1,p2,rest), tag) in path_pairs:
            (A, X1hat, Xnhat) = tag
            damage = (len([x for x in col[p1] if x in X1hat or x in A]) +
                      len([x for x in col[p2] if x in Xnhat or x in A]) -
                      len([x for x in A if x in col[p1] and x in col[p2]]))
            if damage >= 3:
                dead = True
                break
        if dead:
            continue
        yield col

def tags_solvable(H, sig, path_pairs):
    return any(True for x in solution_iter(H, sig, path_pairs))

def feasible_precolorings(H, sig, path_pairs, v):
    """Return set of possible colorings we can assign to v from its
    list."""    
    return ( "".join(pre)
             for pre in itertools.combinations(sig[v], 2)
             if any(True for x in solution_iter(H, sig, path_pairs, {v : "".join(pre)})) )

# For a given signature (as defined in gensig.py), this function generates
# all the possible *tags*, obtained by assigning a tuple (X1, Xn, A)
# to each internal path (where X1, Xn, A are, respectively, the sets
# $\hat{X}_1$, $\hat{X}_n$, $A$ defined in the paper).

def tags_iter(H, sig, tag_endpoints, partial=None, certs_seen=None):
    # we're shoehorning restriction information to tag_endpoints for
    # convenience
    if partial is None:
        partial = ()
        certs_seen = set()
    idx = len(partial)
    if idx == len(tag_endpoints):
        yield partial
        return
    restricted = tag_endpoints[idx][2]
    u_list = sig[tag_endpoints[idx][0]]
    v_list = sig[tag_endpoints[idx][1]]

    for idx_tags in path_tags_iter(u_list, v_list, X_restrict=restricted):
        new_partial = partial + (idx_tags,)
        path_pairs = zip(tag_endpoints, new_partial)
        cert = tag_cert(H, sig, path_pairs)
        if cert in certs_seen:
            continue
        certs_seen.add(cert)
        for yd in tags_iter(H, sig, tag_endpoints, new_partial, certs_seen):
            yield yd
    
def main():
    filename = sys.argv[1]
    (H, tag_endpoints, v) = read_file(filename)
    possible_precols = set()
    for sig in generate_signatures(H, tag_endpoints, v):
        if verbose:
            print sig
            print "checking solvability..."
        sys.stdout.flush()
        counted = 0
        for tags in tags_iter(H, sig, tag_endpoints):
            # define path_pairs...
            counted += 1
            precols = tuple(feasible_precolorings(H, sig, zip(tag_endpoints, tags), v))
            if len(precols) == 0:
                print "NOT SOLVABLE:"
                print "signature: ", sig
                print "tags:"
                print "\n".join(str(x) for x in zip(tag_endpoints, tags))
                return  
            possible_precols.add(precols)

        if verbose:
            print "solvable, checked", counted, "tags"
        sys.stdout.flush()
    print "minimal solution sets:"
    for x in minimal_sets(possible_precols):
        print x

if __name__ == '__main__':
    main()
import networkx
import cytonaut

# Generates "tag certificates", which identify signatures (defined in
# gensig.py) up to isomorphism (either permutation of colors or
# automorphisms of the graph).  These certificates are used in order
# to avoid wasting effort on generating and testing signatures that
# are isomorphic to signatures already considered.

def tag_cert(H, sig, path_pairs):
    """Nauty certificate for indicated path_pairs.

    H is the subgraph induced by the decision nodes;
    sig has the list assignments for decision nodes;
    path_pairs is a list of tuples (endpoints, (A, X1, Xn)) describing the internal paths,
    where endpoints is misleadlingly named because it is (u,v,restricted).

    for now, we still assume that decision nodes are 0,1,...,n-1.
    However, nodes of H should have the form ("s", i). """
    ground_set = set()
    G = H.copy()
    for i,v in enumerate(sig):
        #G.add_node(("s", i))
        s = sig[v]
        ground_set.update(s)
        #G.add_nodes_from(("g", g) for g in s)
        G.add_edges_from( (("s",i), ("g",g)) for g in s )
        G.node[("s",i)]["color"] = "signode"
    for g in ground_set:
        G.node[("g",g)]["color"] = "groundset"
    for (i, ((u,v, rest), (A, X1, Xn))) in enumerate(path_pairs):
        # right now, we assume that each path has exactly 1 nbor
        # for each endpoint... might generalize this but it'll
        # take some care since we'd then need to explicitly enforce
        # each endpoint losing <= 2m colors
        x1v = ("t", i, "X1")
        xnv = ("t", i, "Xn")
        av = ("t", i, "A")
        G.add_nodes_from([x1v, xnv, av])
        G.node[x1v]["color"] = ("tag", rest)
        G.node[xnv]["color"] = ("tag", rest)
        G.node[av]["color"] = ("tag", rest)
        G.add_edges_from([(x1v, xnv), (xnv, av), (av, x1v)])
        G.add_edge(x1v, u)
        G.add_edge(xnv, v)
        G.add_edges_from([(av, u), (av,v)])
        G.add_edges_from((x1v, g) for g in X1)
        G.add_edges_from((xnv, g) for g in Xn)
        G.add_edges_from((av, g) for g in A)
    CG = cytonaut.CytoGraph(G)
    CG.do_nauty()
    # maybe need to return some more info, e.g. color counts? but I think this should suffice for our purposes,
    # since we'll never be comparing canon strings from different signatures...
    return CG.canon_string()

