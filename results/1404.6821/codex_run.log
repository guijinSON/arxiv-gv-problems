+    # with the transported certificate is construction hardening, not solving.
+    for _ in range(200):
+        gates, planted_mask = _sample_mixer(rng, n, mixer_steps)
+        inst = {
+            "n": n,
+            "vertex_count": 1 << n,
+            "mixer": gates,
+            "label_offset": rng.getrandbits(n),
+            "chords": [list(edge) for edge in chords],
+            "lists": [0, 1, 2, 3],
+        }
