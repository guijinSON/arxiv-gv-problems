+            "offset": base["answer"]["offset"],
+        }
+
+        transformations = [
+            ("reorder", reorder, base["answer"]),
+            ("rotate", rotate, base["answer"]),
+            ("reflect", reflect, base["answer"]),
+            ("composed", composed, base["answer"]),
+            ("translate", translate, base["answer"]),
+            ("linear", linear, carried),
