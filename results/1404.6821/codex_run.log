+        "duplicate": [answer["mask"], answer["mask"]],
+        "empty": {},
+        "out_of_range": {"mask": 1 << inst["n"], "offset": answer["offset"]},
+        "wrong_mask": {"mask": answer["mask"] ^ 1, "offset": answer["offset"]},
+    }
+    rejection_reasons = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
