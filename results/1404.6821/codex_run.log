-        "shipping_sampled_total": guess_total,
-        "shipping_sampled_density": guess_rate,
-        "shipping_exact_valid_answers": 2,
-        "shipping_candidate_space": search_space(inst),
-        "density_sampling_wall_sec": guess_elapsed,
