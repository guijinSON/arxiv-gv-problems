+def _reference_algorithm(inst: dict) -> tuple[dict | None, int, int]:
+    """Mechanical explicit-cycle scan followed by exact GF(2) elimination.
+
+    The scan discovers a constraint for the high Gray coordinate only halfway
+    around the cycle.  It intentionally represents the standard explicit graph
