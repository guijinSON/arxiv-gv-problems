+
+def enumerate_all(inst: dict) -> int | None:
+    """Brute-force the bounded language only while the work remains small."""
+
+    n = inst["n"]
+    if n > 14:
+        return None
+    count = 0
+    for mask in range(1 << n):
+        for offset in (0, 1):
+            if verify(inst, {"mask": mask, "offset": offset})[0]:
+                count += 1
+    return count
