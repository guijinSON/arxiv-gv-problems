+    "bounds": {
+        "length": "number of degree-four X vertices (at most 186 at shipping)",
+        "entry_min": 1,
+        "entry_max": "number of graph vertices",
+        "local_choices_per_entry": "2 to 4",
+        "candidate_count": "product of locally eligible neighbor counts",
