+
+    y_targets = [[label[y], int(0 < y[0] < height - 1)] for y in y_coordinates]
+    rng.shuffle(y_targets)
+
+    active_coordinates = [x for x in x_coordinates if 0 < x[0] < height - 1]
+    rng.shuffle(active_coordinates)
