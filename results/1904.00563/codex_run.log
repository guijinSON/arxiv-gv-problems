+        "perfect matching here; Hopcroft-Karp is O(E sqrt(V)) and at the shipping "
+        "preset averaged 0.00029 seconds and 2,984 counted edge/queue/pair operations "
+        "over eight seeds, while the three-cycle route uses at most 189 selections/"
+        "parity updates."
+    ),
+    "max_answer_tokens": 187,
+}
+
+NATIVE = {
