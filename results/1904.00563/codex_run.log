+        return None, 0
+
+    matching = {}
+    unseen = set(cycle_graph)
+    cycles = 0
+    while unseen:
+        start = min(unseen)
+        order = [start]
+        previous = None
+        current = start
+        while True:
+            nxt = cycle_graph[current][0]
+            if nxt == previous:
+                nxt = cycle_graph[current][1]
+            if nxt == start:
+                break
+            if nxt in order:
+                return None, 0
+            order.append(nxt)
+            previous, current = current, nxt
+        if len(order) % 2:
+            return None, 0
