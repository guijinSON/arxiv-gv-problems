+        "json_native_roundtrips": json_roundtrips,
+    }
+
+    shipping = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    inst = make_instance(seed=30, **shipping)  # maximum jitter, hence worst answer size
+    corruptions = {
