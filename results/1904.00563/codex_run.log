+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Among target-one vertices, keep edges whose endpoints have equal eligible "
+    "degree; the result is three even cycles, so take alternating edges on each."
+)
+PLACEBO_HINT = (
