$V(G) = \{a_{ijk} \} \cup \{b_{ij}, c_{ij} \} \cup \{d_{ik} \} \cup \{p_i, q_i \} \cup \{ s, t \}$, 
where $1\le i, j \le 4, ~1 \le k \le 7$, 
and 
\begin{eqnarray*}
E(G) &=& \{a_{ijk}b_{ij}, a_{ijk}c_{ij} \mid 1\le i, j \le 4, ~1 \le k \le 7 \} \cup\\
& & \{b_{ij}p_i, b_{ij}q_i, c_{ij}p_i, c_{ij}q_i \mid 1\le i, j \le 4 \} \cup\\
& & \{d_{ik}p_i, d_{ik}q_i \mid 1\le i \le 4, ~1 \le k \le 7 \} \cup\\
& & \{p_is, p_it, q_is, q_it \mid 1\le i \le 4 \}. 
\end{eqnarray*}

