+def _neighbors_of_coordinate(r, c, height, width):
+    out = [(r, (c - 1) % width), (r, (c + 1) % width)]
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < height:
+        out.append((r + 1, c))
+    return out
