\title{Proper $3$-orientations of bipartite planar graphs with minimum degree at least $3$}

\author{
Kenta Noguchi\thanks{Department of Information Sciences, 
Tokyo University of Science, 
2641 Yamazaki, Noda, Chiba 278-8510, Japan.
