+        # Every sampled candidate already meets local adjacency/target constraints.
+        # Since both sides have equal cardinality and every target is one, global
+        # validity is exactly injectivity.  Confirm any rare hit with the full checker.
+        if len(set(candidate)) == len(candidate):
+            if verify(inst, candidate)[0]:
