+# These values are replaced only if the three harness runs produce different
+# evidence.  The transcripts, not this constant, are the authoritative oracle log.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
