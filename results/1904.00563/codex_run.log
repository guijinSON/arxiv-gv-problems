+        "perfect matching here; Hopcroft-Karp is O(E sqrt(V)) and at the shipping "
+        "preset is measured by selftest in wall-clock time and exact edge scans, while "
+        "the three-cycle route uses at most 189 selections/parity updates."
+    ),
+    "max_answer_tokens": 187,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
