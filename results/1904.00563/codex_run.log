+        "family": "prescribed_proper_3_orientation",
+        "vertex_count": height * width,
+        "edge_count": (2 * height - 1) * width,
+        "x_records": x_records,
+        "y_targets": y_targets,
+        "active_x": active_x,
+        # Derived only for efficient structure-aware sampling; verify ignores it.
+        "candidate_options": candidate_options,
+        "answer": answer,
+    }
+
