+    @functools.lru_cache(maxsize=None)
+    def count(remaining: tuple[int, ...]) -> int:
+        if not remaining:
+            return 1
+        first = remaining[0]
+        total = 0
+        for second, third in itertools.combinations(remaining[1:], 2):
+            if weights[first] + weights[second] + weights[third] != target:
+                continue
+            used = {first, second, third}
+            total += count(tuple(item for item in remaining if item not in used))
+        return total
+
+    return count(tuple(range(len(weights))))
+
+
+def canonical_key(inst) -> str:
+    """A strong item/test-relabeling invariant of the generated set system."""
+
+    records = sorted(
+        (weight, code.bit_count())
+        for weight, code in zip(inst["weights"], inst["item_codes"])
+    )
+    by_weight = sorted(zip(inst["weights"], inst["item_codes"]))
+    distance_rows = []
+    for left in range(len(by_weight)):
+        weight_left, code_left = by_weight[left]
+        for right in range(left + 1, len(by_weight)):
+            weight_right, code_right = by_weight[right]
+            distance_rows.append(
+                (weight_left, weight_right, (code_left ^ code_right).bit_count())
+            )
+    payload = {
+        "target": inst["target"],
+        "test_limit": inst["test_limit"],
+        "weight_code_weights": records,
+        "code_hamming_distances": distance_rows,
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Increase coefficient height while keeping the certificate length fixed."""
+
+    n = int(params.get("n", 56))
+    target_multiple = int(params.get("target_multiple", 56))
+    modulus = int(params.get("modulus", BASE_MODULUS))
+    modulus_ladder = [
+        BASE_MODULUS,
+        2147483647,
+        2305843009213693951,
+        618970019642690137449562111,
+        162259276829213363391578010288127,
+        170141183460469231731687303715884105727,
+    ]
+    for candidate in modulus_ladder:
+        if candidate > modulus:
+            return {
+                "n": n,
+                "target_multiple": target_multiple + 8,
+                "modulus": candidate,
+            }
+    return {
+        "n": n,
+        "target_multiple": target_multiple + 8,
+        "modulus": 2**521 - 1,
+    }
+
+
+def _reference_algorithm(inst):
+    """Quadratic pair-sum indexing of every core test in the succinct family."""
+
+    weights = inst["weights"]
+    by_value = {value: index for index, value in enumerate(weights)}
+    triples = set()
+    pair_probes = 0
+    lookup_hits = 0
+    for first in range(len(weights)):
+        for second in range(first + 1, len(weights)):
+            pair_probes += 1
+            needed = inst["target"] - weights[first] - weights[second]
+            third = by_value.get(needed)
+            if third is not None:
+                lookup_hits += 1
+                if third > second:
+                    triples.add((first, second, third))
+    answer = _canonical_answer(triples)
+    return answer, {
+        "pair_probes": pair_probes,
+        "lookup_hits": lookup_hits,
+        "operations": 2 * pair_probes + lookup_hits,
+        "core_tests_generated": len(triples),
+    }
+
+
+def _display_order_candidate(inst):
+    return _canonical_answer(
+        range(start, start + 3) for start in range(0, len(inst["weights"]), 3)
+    )
+
+
+def _sorted_adjacent_candidate(inst):
+    ids = sorted(range(len(inst["weights"])), key=lambda item: inst["weights"][item])
+    return _canonical_answer(ids[start : start + 3] for start in range(0, len(ids), 3))
+
+
+def _balanced_rank_candidate(inst):
+    ids = sorted(range(len(inst["weights"])), key=lambda item: inst["weights"][item])
+    n = inst["n"]
+    return _canonical_answer(
+        [ids[index], ids[n + index], ids[3 * n - 1 - index]] for index in range(n)
+    )
+
+
+def _central_outlier_candidate(inst):
+    ids = sorted(
+        range(len(inst["weights"])),
+        key=lambda item: (abs(3 * inst["weights"][item] - inst["target"]), item),
+    )
+    return _canonical_answer(ids[start : start + 3] for start in range(0, len(ids), 3))
+
+
+def _relabel_items(inst, order):
+    """Carry the certificate through an arbitrary original-item relabeling."""
+
+    moved = copy.deepcopy(inst)
+    moved["weights"] = [inst["weights"][old] for old in order]
+    moved["item_codes"] = [inst["item_codes"][old] for old in order]
+    old_to_new = {old: new for new, old in enumerate(order)}
+    moved["answer"] = _canonical_answer(
+        [old_to_new[item_id] for item_id in triple] for triple in inst["answer"]
+    )
+    return moved
+
+
+def _permute_bit_coordinates(inst, order):
+    """Relabel bit tests and their private items, carrying every code."""
+
+    moved = copy.deepcopy(inst)
+    codes = []
+    for code in inst["item_codes"]:
+        changed = 0
+        for new_bit, old_bit in enumerate(order):
+            if (code >> old_bit) & 1:
+                changed |= 1 << new_bit
+        codes.append(changed)
+    moved["item_codes"] = codes
+    return moved
+
+
+def _answer_atoms(value) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def _full_residue_pool_check() -> bool:
+    """Exhaustively confirm the fixed residue construction, once in selftest."""
+
+    base = [1024 + _cantor_code(index) for index in range(128)]
+    # Each generated group contains TWO distinct weights with residue r and
+    # one with residue -2r.  The old audit accidentally represented r only
+    # once, so it could not count even the intended triples it claimed to test.
+    residues = []
+    for group, value in enumerate(base):
+        residues.extend(
+            ((value, group, 0), (value, group, 0),
+             ((-2 * value) % BASE_MODULUS, group, 1))
+        )
+    intended = 0
+    unintended = 0
+    # A generated group has two distinct items carrying the same base residue,
+    # so check every allowed repeated-base triple separately.
+    for group, value in enumerate(base):
+        for other_value, other_group, other_role in residues:
+            if (2 * value + other_value) % BASE_MODULUS:
+                continue
+            if other_group == group and other_role == 1:
+                intended += 1
+            else:
+                unintended += 1
+    # All entries below have distinct residue types.  Complements occur once
+    # and base residues occur twice, already handled above when both copies are
+    # selected.
+    for first in range(len(residues)):
+        for second in range(first + 1, len(residues)):
+            for third in range(second + 1, len(residues)):
+                chosen = (residues[first], residues[second], residues[third])
+                if sum(entry[0] for entry in chosen) % BASE_MODULUS:
+                    continue
+                groups = [entry[1] for entry in chosen]
+                roles = [entry[2] for entry in chosen]
+                unintended += 1
+    return intended == 128 and unintended == 0
+
+
+def selftest() -> dict:
