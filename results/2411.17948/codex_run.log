+def verify(inst, answer) -> tuple[bool, str]:
+    """Accept every valid compact Test Cover witness; never read inst['answer']."""
+
+    if not isinstance(answer, list):
+        return False, "answer_not_list"
+    if not answer:
+        return False, "empty_answer"
+    if len(answer) != inst["n"]:
+        return False, "wrong_core_test_count"
+    item_count = len(inst["weights"])
+    for triple in answer:
+        if not isinstance(triple, list) or len(triple) != 3:
+            return False, "wrong_triple_size"
+        for item_id in triple:
+            if isinstance(item_id, bool) or not isinstance(item_id, int):
+                return False, "noninteger_item_id"
+            if not 0 <= item_id < item_count:
+                return False, "item_id_out_of_range"
+    flattened = [item_id for triple in answer for item_id in triple]
+    if len(set(flattened)) != len(flattened):
+        return False, "duplicate_item_id"
+    if set(flattened) != set(range(item_count)):
+        return False, "items_missing"
+    for triple in answer:
+        if sum(inst["weights"][item_id] for item_id in triple) != inst["target"]:
+            return False, "triple_weight_not_target"
+
+    # This is a direct, executable signature invariant for the decoded tests.
+    # Nonzero injective codes distinguish different P/Q pairs and all private
+    # items; coverage distinguishes P_i from Q_i; Z_0 separates paired items
+    # from every D_t and O.
+    codes = inst["item_codes"]
+    if len(codes) != item_count or len(set(codes)) != item_count:
+        return False, "item_codes_not_injective"
+    if any(code <= 0 or code >= 1 << inst["bit_width"] for code in codes):
+        return False, "item_code_out_of_range"
+    return True, "ok"
