#!/usr/bin/env bash
for attempt in $(seq 1 8); do
  /home/gson/.npm-global/bin/codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -m gpt-5.6-sol -c model_reasoning_effort=xhigh "$(cat .task.md)" >> codex_run.log 2>&1
  if { [ -f README.md ] && [ -f selftest_report.json ] && [ -f llm_loop_transcript.jsonl ]; } || [ -f REJECTED.md ]; then break; fi
  tail -5 codex_run.log | grep -q "at capacity" || break
  echo "[runner] model at capacity - retry $attempt of 8 in 90s" >> codex_run.log
  sleep 90
done

