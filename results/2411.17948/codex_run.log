+
+    remaining = list(range(len(inst["weights"])))
+    weights = inst["weights"]
+    target = inst["target"]
+    while remaining:
+        length = len(remaining)
+        first_position = 0
+        second_position = rng.randrange(1, length)
+        third_position = rng.randrange(1, length - 1)
+        if third_position >= second_position:
+            third_position += 1
+        triple_sum = (
+            weights[remaining[first_position]]
+            + weights[remaining[second_position]]
+            + weights[remaining[third_position]]
+        )
+        if triple_sum != target:
+            return False
