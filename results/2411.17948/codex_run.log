+    "easy": {"n": 32, "target_multiple": 40, "modulus": BASE_MODULUS},
+    "medium": {"n": 48, "target_multiple": 48, "modulus": BASE_MODULUS},
+    "hard": {"n": 56, "target_multiple": 56, "modulus": 2147483647},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON list forming an unordered partition of all 3n zero-based "
+        "original-item IDs into exactly n unordered triples.  Each triple "
+        "names a core test; the decoder also selects every forced bit test."
+    ),
+    "bounds": {
+        "triple_size": 3,
