-        # denser union of hidden matchings, not a longer certificate.
-        out["crowding"] = int(out.get("crowding", 0)) + 1
-        return out
-    # A larger q lengthens both the witness and the intended recurrence; the
-    # compact route is already close to the 300-operation no-tool cap.
-    return "cap_bound"
