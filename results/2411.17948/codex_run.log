+        "entry_range": "integers 0 through q-1",
+        "shipping_length": 127,
+    },
+}
+
+DIFFICULTY = {
+    "demo": {"n": 5, "degree": 2},
+    "easy": {"n": 31, "degree": 6},
+    "medium": {"n": 61, "degree": 10},
+    "hard": {"n": 127, "degree": 16},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Across the source-edge tests, one perfect matching preserves the affine "
+    "residue right minus twice left modulo q."
+)
+PLACEBO_HINT = (
+    "Across the source-edge tests, careful bookkeeping of endpoint labels "
+    "and the stated indexing convention is useful."
+)
+
+# Replaced with script-owned measurements after the three oracle arms run.
+G9_MEASUREMENTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
