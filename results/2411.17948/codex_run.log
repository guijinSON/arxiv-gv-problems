+def _rank(rows: list[int]) -> int:
+    """Exact rank of binary row masks."""
+    pivots: dict[int, int] = {}
+    for value in rows:
+        x = value
+        while x:
+            pivot = x.bit_length() - 1
+            if pivot in pivots:
+                x ^= pivots[pivot]
+            else:
+                pivots[pivot] = x
+                break
+    return len(pivots)
+
