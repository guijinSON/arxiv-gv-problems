+def _full_residue_pool_check() -> bool:
+    """Exhaustively confirm the fixed residue construction, once in selftest."""
+
+    base = [1024 + _cantor_code(index) for index in range(128)]
+    # Represent residue TYPES once.  The allowed use of both distinct
+    # base-residue items is checked in the repeated-base loop below.
+    residues = [(value, group, 0) for group, value in enumerate(base)]
+    residues += [
+        ((-2 * value) % BASE_MODULUS, group, 1)
+        for group, value in enumerate(base)
+    ]
+    intended = 0
+    unintended = 0
+    # A generated group has two distinct items carrying the same base residue,
+    # so check every allowed repeated-base triple separately.
+    for group, value in enumerate(base):
+        for other_value, other_group, other_role in residues:
+            if (2 * value + other_value) % BASE_MODULUS:
+                continue
+            if other_group == group and other_role == 1:
+                intended += 1
+            else:
+                unintended += 1
+    # All entries below have distinct residue types.  Use a pair-sum index so
+    # this exhaustive check is quadratic rather than a slow cubic scan.
+    value_to_positions = {}
+    for position, entry in enumerate(residues):
+        value_to_positions.setdefault(entry[0], []).append(position)
+    for first in range(len(residues)):
+        for second in range(first + 1, len(residues)):
+            needed = (-residues[first][0] - residues[second][0]) % BASE_MODULUS
+            unintended += sum(
+                third > second for third in value_to_positions.get(needed, ())
+            )
+    return intended == 128 and unintended == 0
