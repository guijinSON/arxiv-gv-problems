-
-def _greedy_unused(inst: dict) -> list[int]:
-    used: set[int] = set()
-    answer: list[int] = []
-    for row in inst["adjacency"]:
-        choices = [value for value in sorted(row) if value not in used]
-        if not choices:
-            # Preserve the required shape while guaranteeing a visible repeat.
-            answer.append(min(row))
-        else:
-            answer.append(choices[0])
-            used.add(choices[0])
-    return answer
