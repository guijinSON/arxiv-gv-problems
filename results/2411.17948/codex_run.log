+def _random_fixed_weight_mask(
+    dimension: int, weight: int, rng: random.Random
+) -> int:
+    result = 0
+    for position in rng.sample(range(dimension), weight):
+        result |= 1 << position
+    return result
+
+
+def _span_vector(basis: list[int], selector: int) -> int:
+    result = 0
+    index = 0
+    while selector:
+        if selector & 1:
+            result ^= basis[index]
+        selector >>= 1
+        index += 1
+    return result
 
