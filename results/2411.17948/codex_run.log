+def _make_decoys(
+    orbit: list[int], count: int, subspace_dimension: int, weight: int,
+    rng: random.Random,
+) -> list[int]:
+    """Sample distinct same-weight rows from a planted proper subspace."""
+    dimension = len(orbit)
+    span_basis = orbit[:subspace_dimension]
+    used = set(orbit)
+    decoys: list[int] = []
+    attempts = 0
