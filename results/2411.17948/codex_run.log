+def _selected_signatures(inst: dict, answer: list[int]) -> list[int]:
+    """Expand the selected paper-gadget tests into exact item signatures."""
+    q = inst["q"]
+    p = inst["bit_tests"] - 1
+    edge_all = (1 << q) - 1
+    signatures: list[int] = []
+
+    inverse_right = [0] * q
+    for left, right in enumerate(answer):
+        inverse_right[right] = left
+
+    # Bits 0..p are Z_0..Z_p.  Edge-test bits begin at p+1.
+    for source_index in range(2 * q):
+        forced = 1  # Z_0
+        code = source_index + 1
+        for h in range(1, p + 1):
+            if (code >> (h - 1)) & 1:
+                forced |= 1 << h
+
+        circ = forced | (edge_all << (p + 1))
+        if source_index < q:
+            incident_position = source_index
+        else:
+            incident_position = inverse_right[source_index - q]
+        star_edge_bits = edge_all ^ (1 << incident_position)
+        star = forced | (star_edge_bits << (p + 1))
+        signatures.extend((circ, star))
+
+    for h in range(p + 1):
+        signatures.append(1 << h)
+    signatures.append(0)  # omega
+    return signatures
+
