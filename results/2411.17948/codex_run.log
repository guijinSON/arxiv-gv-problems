index f194dc321fb1abda78813b62fdbca522615fd3c7..7a2ea50f261caef7d35914eebd2150ef06b31b87
--- a/g9_hinted/gen_2411_17948.py
+++ b/g9_hinted/gen_2411_17948.py
@@ -1,16 +1,15 @@
-"""Verified Test Cover certificate generator for arXiv:2411.17948.
+"""Verified Track-B Test Cover generator for arXiv:2411.17948.
 
-The module inverse-generates a strict 3-partition, regards every target-sum
-triple as a red vertex of Red-Blue Dominating Set, and carries the held
-partition through the paper's Section 5 reduction to Test Cover.  A submitted
-partition is a compact name for the selected core tests; all forced bit tests
-are added by the decoder.
+The paper defines Test Cover on a finite set system: selected tests must give
+different incidence signatures to every pair of items.  Here the items are all
+vectors of F_2^d and a test is a parity functional.  Consequently a submitted
+set of d tests is a test cover exactly when its d coefficient masks have full
+rank over F_2.  The generator samples a full-rank cyclic orbit first and only
+then surrounds it with same-weight decoys from a proper subspace.
 """
 
 from __future__ import annotations
 
