+def _attack_greedy_coordinate_novelty(
+    inst: dict, rng: random.Random
+) -> list[int]:
+    del rng
+    d = inst["dimension"]
+    chosen: list[int] = []
+    unseen = (1 << d) - 1
+    remaining = set(range(inst["test_count"]))
+    while len(chosen) < d:
+        pick = min(
+            remaining,
+            key=lambda i: (-((inst["test_masks"][i] & unseen).bit_count()), i),
+        )
+        chosen.append(pick)
+        remaining.remove(pick)
