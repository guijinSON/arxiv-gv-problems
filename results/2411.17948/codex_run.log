+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any submitted Test Cover without consulting inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array of test IDs"
+    if not answer:
