+NOTES = r"""
+Definition and source results.  The Introduction defines Test Cover as follows:
+given items U and tests F subseteq 2^U, select at most k tests so that every
+pair of items occurs differently in at least one selected test.  Section 3
+represents it by the natural red-test/blue-item auxiliary bipartite graph.
+Theorem 1 and Lemma 4 give a 2^{O(|U| log |U|)} polynomial-space-style
+partition-refinement dynamic program; the Test Cover subsection also records
+the direct |F|^{O(k)} subset enumeration and Bondy's |U|-1 upper bound.  These
+algorithms are why this constructed distribution is Track B, never Track A.
+
+Paper-licensed transformation.  Section 5, 'Incompressibility of Test Cover',
+reduces a Red-Blue Dominating Set graph G' to Test Cover.  It makes a circ/star
+item pair for each source blue vertex.  A source red test contains both copies
+of every non-neighbour but only the circ copy of each neighbour.  The forced
+bit-representation tests distinguish different pairs, and an isolated item
+forces all of those bit tests into every size-k solution.  Consequently the
+remaining source tests distinguish every circ/star pair exactly when they
+dominate every source blue vertex.
+
+Construction.  The source blue vertices are the q left and q right vertices
+of a degree-regular bipartite graph; source red vertices are its edges.  Since
+each source test covers exactly two blue vertices, q tests dominate all 2q
+vertices exactly when their edges form a perfect matching.  Before assembling
+the graph, choose b and plant y=2x+b mod q.  The other degree-1 perfect
+matchings are conjugated cyclic shifts, so every left and right source vertex
+has the same degree and every edge is generated as part of a perfect matching.
+The planted vector is then carried through the paper's reduction.  It is not
+found by solving the completed instance.
+
+Easy regimes and attacks.  Locating-Dominating Set is linear-time on trees in
+the feedback-edge-set section; Theorem 2 gives a linear kernel in feedback
+edge set number; Lemma 5 gives a 2d-vertex neighbourhood-diversity kernel; and
+Theorem 1 gives the vertex-cover/item-parameter FPT algorithms.  For this
+family, tiny q and low degree are easy, hence the demo is not shipped.  The
+attack panel uses equal-degree/first-slot outliers, smallest-endpoint choices,
+left-to-right greedy matching, uniform restarts, and simple translations.
+The reference Hopcroft-Karp algorithm is reported separately, as Track B
+requires.  The compact route filters b candidates from N(0) using the invariant
+2x+b in N(x), then emits the modular recurrence.
+""".strip()
+
+
+def _is_prime(value: int) -> bool:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_odd_prime(value: int) -> int:
+    candidate = max(3, int(value))
+    if candidate % 2 == 0:
+        candidate += 1
+    while not _is_prime(candidate):
+        candidate += 2
+    return candidate
+
+
+def _compact_affine_route(inst: dict[str, Any]) -> tuple[list[int] | None, int]:
+    """Recover the planted affine matching without consulting the answer.
+
+    Count one exact modular evaluation and one exact membership test per
+    filtered candidate, then one modular addition per emitted coordinate.
+    """
+    q = inst["q"]
+    adjacency = inst["adjacency"]
+    candidates = list(adjacency[0])
+    checks = 0
+    for left in range(1, q):
+        neighbours = set(adjacency[left])
+        survivors = []
+        for offset in candidates:
+            checks += 1
+            if (2 * left + offset) % q in neighbours:
+                survivors.append(offset)
+        candidates = survivors
+        if len(candidates) <= 1:
+            break
+    if len(candidates) != 1:
+        return None, 2 * checks + q
+    offset = candidates[0]
+    result = []
+    value = offset
+    for _ in range(q):
+        result.append(value)
+        value = (value + 2) % q
+    return result, 2 * checks + q
+
+
+def _assemble_instance(
+    requested_n: int,
+    q: int,
+    degree: int,
+    adjacency: list[list[int]],
+    answer: list[int],
+) -> dict[str, Any]:
+    source_items = 2 * q
+    p = math.ceil(math.log2(source_items)) + 1
+    return {
+        "n": requested_n,
+        "q": q,
+        "degree": degree,
+        "source_item_count": source_items,
+        "bit_tests": p + 1,
+        "test_count": q * degree + p + 1,
+        "test_cover_item_count": 2 * source_items + (p + 1) + 1,
+        "adjacency": [list(row) for row in adjacency],
+        "answer": list(answer),
+    }
+
+
+def make_instance(n: int, seed: int = 0, degree: int = 16, **params: Any) -> dict:
+    """Inverse-generate a Test Cover instance and a matching certificate.
+
+    The source graph is the union of ``degree`` edge-disjoint perfect
+    matchings.  One is selected first as y=2x+b mod q.  The paper's reduction
+    then carries it to a Test Cover certificate.
+    """
+    del params
+    if isinstance(n, bool) or not isinstance(n, int) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    q = _next_odd_prime(n)
+    if (isinstance(degree, bool) or not isinstance(degree, int)
+            or degree < 2 or degree >= q):
+        raise ValueError("degree must be an integer in [2,q-1]")
+
+    rng = random.Random(seed)
+    # Resampling only removes accidental additional slope-two matchings and
+    # enforces the declared compact-route cap.  The known matching was selected
+    # before this check and is valid on every trial.
+    for _attempt in range(10_000):
+        offset = rng.randrange(q)
+        planted = [(2 * left + offset) % q for left in range(q)]
+
+        conjugator = list(range(q))
+        rng.shuffle(conjugator)
+        inverse = [0] * q
+        for position, value in enumerate(conjugator):
+            inverse[value] = position
+        shifts = rng.sample(range(1, q), degree - 1)
+
+        permutations = [planted]
+        for shift in shifts:
+            permutation = [
+                planted[inverse[(conjugator[left] + shift) % q]]
+                for left in range(q)
+            ]
+            permutations.append(permutation)
+
+        adjacency = [
+            [permutation[left] for permutation in permutations]
+            for left in range(q)
+        ]
+        for row in adjacency:
+            rng.shuffle(row)
+
+        inst = _assemble_instance(n, q, degree, adjacency, planted)
+        recovered, operations = _compact_affine_route(inst)
+        if recovered == planted and operations <= 300:
+            return inst
+    raise RuntimeError("could not realize the bounded compact-route instance")
+
+
+def render(inst: dict) -> str:
+    q = inst["q"]
+    degree = inst["degree"]
+    p = inst["bit_tests"] - 1
+    rows = "\n".join(
+        f"  {left}: " + " ".join(str(right) for right in row)
+        for left, row in enumerate(inst["adjacency"])
+    )
+    text = f"""Find a size-{q + p + 1} Test Cover, encoded by a perfect matching.
+
+A Test Cover instance consists of a finite item set and a family of tests
+(subsets of the items).  Selected tests distinguish two items when exactly one
+of the two is in the test.  A valid answer must make every two distinct items
+have different selected-test membership signatures.
+
+The following is a compact, exact specification of this instance.  Let q={q}.
+There are source vertices A_0,...,A_{q-1} and B_0,...,B_{q-1}.  For every
+listed adjacency A_x--B_y there is a source-edge test X_(x,y).  Each row has
+exactly {degree} distinct neighbours; row order carries no meaning.
+
+Adjacency rows (0-based left endpoint, followed by its right endpoints):
+{rows}
+
+Here is the full Test Cover gadget.  Enumerate the 2q source vertices as
+v_0=A_0,...,v_(q-1)=A_(q-1),v_q=B_0,...,v_(2q-1)=B_(q-1).
+
+* For every v_j there are two items v_j^circ and v_j^star.
+* There are leaf items leaf_0,...,leaf_{p} and one isolated item omega.
+* Source-edge test X_(x,y) contains v_j^circ for every j.  It also contains
+  v_j^star for every source vertex except its two endpoints A_x and B_y.  It
+  contains no leaf and does not contain omega.
+* Test Z_0 contains both copies of every v_j and leaf_0.
+* For h=1,...,{p}, test Z_h contains leaf_h and both copies of v_j exactly
+  when bit h-1 (least significant bit is bit 0) of the {p}-bit binary
+  representation of j+1 is 1.
+* There are no other item-test incidences.  In particular omega belongs to no
+  test.  All intervals and index ranges stated here are inclusive.
+
+Your selected tests are defined to be every forced test Z_0,...,Z_{p}, plus
+exactly one source-edge test incident with each A_x.  Encode them by a JSON
+list [y_0,...,y_{q-1}], where entry y_x selects X_(x,y_x).  The list must have
+exactly {q} integer entries in 0,...,{q-1}; each listed edge must occur in the
+corresponding adjacency row; and right endpoints may not repeat.  The position
+x fixes the left endpoint, so the order is not interchangeable.
+
+Give your final answer inside <answer></answer> tags as that JSON list.
+For format only, a q=3 example is <answer>[2,0,1]</answer>.
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        text += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        text += "\n\nHint: " + PLACEBO_HINT
+    return text
+
+
+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer>\s*(.*?)\s*</answer>", text,
+                         flags=re.IGNORECASE | re.DOTALL)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.IGNORECASE)
+        body = re.sub(r"\s*```$", "", body)
+    try:
+        answer = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(answer, list):
+        return None
+    if not all(isinstance(value, int) and not isinstance(value, bool)
+               for value in answer):
+        return None
+    return answer
+
+
+def _selected_signatures(inst: dict, answer: list[int]) -> list[int]:
+    """Expand the selected paper-gadget tests into exact item signatures."""
+    q = inst["q"]
+    p = inst["bit_tests"] - 1
+    edge_all = (1 << q) - 1
+    signatures: list[int] = []
+
+    inverse_right = [0] * q
+    for left, right in enumerate(answer):
+        inverse_right[right] = left
+
+    # Bits 0..p are Z_0..Z_p.  Edge-test bits begin at p+1.
+    for source_index in range(2 * q):
+        forced = 1  # Z_0
+        code = source_index + 1
+        for h in range(1, p + 1):
+            if (code >> (h - 1)) & 1:
+                forced |= 1 << h
+
+        circ = forced | (edge_all << (p + 1))
+        if source_index < q:
+            incident_position = source_index
+        else:
+            incident_position = inverse_right[source_index - q]
+        star_edge_bits = edge_all ^ (1 << incident_position)
+        star = forced | (star_edge_bits << (p + 1))
+        signatures.extend((circ, star))
+
+    for h in range(p + 1):
+        signatures.append(1 << h)
+    signatures.append(0)  # omega
+    return signatures
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    q = inst["q"]
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) != q:
+        return False, f"wrong vector length: expected {q}"
+    if not all(isinstance(value, int) and not isinstance(value, bool)
+               for value in answer):
+        return False, "every endpoint must be an integer"
+    if any(value < 0 or value >= q for value in answer):
+        return False, f"right endpoint out of range 0..{q - 1}"
+    if len(set(answer)) != q:
+        return False, "a right endpoint is repeated, so this is not a perfect matching"
+    for left, right in enumerate(answer):
+        if right not in inst["adjacency"][left]:
+            return False, f"listed source edge A_{left}--B_{right} does not exist"
+
+    signatures = _selected_signatures(inst, answer)
+    if len(signatures) != inst["test_cover_item_count"]:
+        return False, "internal item count disagrees with the gadget specification"
+    if len(set(signatures)) != len(signatures):
+        return False, "selected tests do not distinguish every item pair"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    # One source edge per left vertex is free from the output grammar and from
+    # the q-test capacity bound.  Right-endpoint uniqueness is the matching
+    # constraint being tested, so it is deliberately not pre-enforced.
+    return [rng.choice(row) for row in inst["adjacency"]]
+
+
+def search_space(inst: dict) -> int | None:
+    return inst["degree"] ** inst["q"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space is None or space > 1_000_000:
+        return None
+    count = 0
+    for answer in itertools.product(*inst["adjacency"]):
+        if len(set(answer)) == inst["q"]:
+            ok, _ = verify(inst, list(answer))
+            count += int(ok)
+    return count
+
+
+def _side_profiles(neighbour_sets: list[set[int]]) -> list[tuple[int, ...]]:
+    profiles = []
+    for i, row in enumerate(neighbour_sets):
+        intersections = sorted(
+            len(row & other)
+            for j, other in enumerate(neighbour_sets) if i != j
+        )
+        profiles.append(tuple(intersections))
+    return sorted(profiles)
+
+
+def canonical_key(inst: dict) -> str:
+    """Strong relabelling invariant of the source incidence graph.
+
+    Exact bipartite graph canonisation is intentionally not attempted.  The
+    sorted per-vertex common-neighbour profiles are invariant under arbitrary
+    permutations within either side, adjacency-list order, and swapping the
+    two sides.  The README states the possible collision caveat.
+    """
+    q = inst["q"]
+    left = [set(row) for row in inst["adjacency"]]
+    right = [set() for _ in range(q)]
+    for x, row in enumerate(left):
+        for y in row:
+            right[y].add(x)
+    sides = sorted([_side_profiles(left), _side_profiles(right)])
+    payload = json.dumps(
+        {"q": q, "degree": inst["degree"], "profiles": sides},
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Increase crowding at fixed witness length before touching q."""
+    out = {key: value for key, value in params.items() if key != "_preset"}
+    q = _next_odd_prime(out["n"])
+    degree = int(out.get("degree", 16))
+    if q == 127 and degree < 32:
+        out["degree"] = min(32, degree + 4)
+        # This second dial records that the larger degree is deliberately a
+        # denser union of hidden matchings, not a longer certificate.
+        out["crowding"] = int(out.get("crowding", 0)) + 1
+        return out
+    # A larger q lengthens both the witness and the intended recurrence; the
+    # compact route is already close to the 300-operation no-tool cap.
+    return "cap_bound"
+
+
+def _hopcroft_karp(inst: dict) -> tuple[list[int] | None, dict[str, int]]:
+    adjacency = inst["adjacency"]
+    q = inst["q"]
+    match_left = [-1] * q
+    match_right = [-1] * q
+    distance = [-1] * q
+    scans = 0
+    phases = 0
+    augmentations = 0
+
+    while True:
+        phases += 1
+        queue: deque[int] = deque()
+        reachable_free = False
+        for left in range(q):
+            if match_left[left] == -1:
+                distance[left] = 0
+                queue.append(left)
+            else:
+                distance[left] = -1
+        while queue:
+            left = queue.popleft()
+            for right in adjacency[left]:
+                scans += 1
+                mate = match_right[right]
+                if mate == -1:
+                    reachable_free = True
+                elif distance[mate] == -1:
+                    distance[mate] = distance[left] + 1
+                    queue.append(mate)
+        if not reachable_free:
+            break
+
+        def dfs(left: int) -> bool:
+            nonlocal scans
+            for right in adjacency[left]:
+                scans += 1
+                mate = match_right[right]
+                if mate == -1 or (distance[mate] == distance[left] + 1
+                                  and dfs(mate)):
+                    match_left[left] = right
+                    match_right[right] = left
+                    return True
+            distance[left] = -1
+            return False
+
+        progress = 0
+        for left in range(q):
+            if match_left[left] == -1 and dfs(left):
+                progress += 1
+                augmentations += 1
+        if progress == 0:
+            break
+    if any(value == -1 for value in match_left):
+        return None, {"edge_scans": scans, "phases": phases,
+                      "augmentations": augmentations}
+    return match_left, {"edge_scans": scans, "phases": phases,
+                        "augmentations": augmentations}
+
+
+def _first_slot(inst: dict) -> list[int]:
+    return [row[0] for row in inst["adjacency"]]
+
+
+def _smallest_endpoint(inst: dict) -> list[int]:
+    return [min(row) for row in inst["adjacency"]]
+
+
+def _greedy_unused(inst: dict) -> list[int]:
+    used: set[int] = set()
+    answer: list[int] = []
+    for row in inst["adjacency"]:
+        choices = [value for value in sorted(row) if value not in used]
+        if not choices:
+            # Preserve the required shape while guaranteeing a visible repeat.
+            answer.append(min(row))
+        else:
+            answer.append(choices[0])
+            used.add(choices[0])
+    return answer
+
+
+def _simple_translation(inst: dict) -> list[int] | None:
+    q = inst["q"]
+    adjacency = [set(row) for row in inst["adjacency"]]
+    for shift in range(min(16, q)):
+        answer = [(left + shift) % q for left in range(q)]
+        if all(answer[left] in adjacency[left] for left in range(q)):
+            return answer
+    return None
+
+
+def _relabel_instance(inst: dict, left_perm: list[int],
+                      right_perm: list[int]) -> tuple[dict, list[int]]:
+    q = inst["q"]
+    adjacency = [[] for _ in range(q)]
+    for old_left, row in enumerate(inst["adjacency"]):
+        adjacency[left_perm[old_left]] = sorted(right_perm[y] for y in row)
+    carried = [0] * q
+    for old_left, old_right in enumerate(inst["answer"]):
+        carried[left_perm[old_left]] = right_perm[old_right]
+    transformed = _assemble_instance(
+        inst["n"], q, inst["degree"], adjacency, carried
+    )
+    return transformed, carried
+
+
+def _atom_count(value: Any) -> int:
+    if isinstance(value, dict):
+        return sum(_atom_count(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_atom_count(item) for item in value)
+    return 1
+
+
+def selftest() -> dict:
+    report: dict[str, Any] = {
+        "paper": "2411.17948",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    g1_failures = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in range(4):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok or json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append({"preset": preset, "seed": seed,
+                                    "reason": reason})
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=20260905, **ship_params)
+    planted = ship["answer"]
+    corruptions: dict[str, object] = {
+        "drop_one": planted[:-1],
+        "empty": [],
+        "duplicate_endpoint": planted[:-1] + [planted[0]],
+        "out_of_range": planted[:-1] + [ship["q"]],
+    }
+    swapped = None
+    for i in range(ship["q"]):
+        for j in range(i + 1, ship["q"]):
+            trial = list(planted)
+            trial[i], trial[j] = trial[j], trial[i]
+            if (trial[i] not in ship["adjacency"][i]
+                    or trial[j] not in ship["adjacency"][j]):
+                swapped = trial
+                break
+        if swapped is not None:
+            break
+    corruptions["swap_two_positions"] = swapped or list(reversed(planted))
+    cases = {}
+    reasons = []
+    for name, answer in corruptions.items():
+        ok, reason = verify(ship, answer)
+        cases[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": all(case["rejected"] for case in cases.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    realistic = (
+        "I used the paired-item signatures and obtained:\n```json\n"
+        "<answer>" + json.dumps(planted, separators=(",", ":"))
+        + "</answer>\n```\nThe entries use zero-based endpoints."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted,
+        "parsed_length": len(parsed) if isinstance(parsed, list) else None,
+    }
+
+    sample_rng = random.Random(0x241117948)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        candidate = random_candidate(ship, sample_rng)
+        if verify(ship, candidate)[0]:
+            guess_hits += 1
+    guess_probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_probability,
+        "candidate_space": search_space(ship),
+        "sampler": "one uniformly random listed neighbour independently per left vertex",
+    }
+
+    baseline_rows = []
+    for seed in range(8):
+        inst = make_instance(seed=10_000 + seed, **ship_params)
+        started = time.perf_counter()
+        solution, metrics = _hopcroft_karp(inst)
+        elapsed = time.perf_counter() - started
+        ok = solution is not None and verify(inst, solution)[0]
+        baseline_rows.append({**metrics, "wall_clock_sec": elapsed, "ok": ok})
+    edge_scans = [row["edge_scans"] for row in baseline_rows]
+    wall_times = [row["wall_clock_sec"] for row in baseline_rows]
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": all(row["ok"] for row in baseline_rows)
+        and guess_probability < 1e-6 and demo_count is not None,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_total": guess_total,
+        "shipping_observed_solution_fraction": guess_probability,
+        "shipping_structure_aware_space": search_space(ship),
+        "shipping_valid_solution_count": None,
+        "demo_candidate_space": search_space(demo),
+        "demo_valid_solution_count": demo_count,
+        "baseline_edge_scans_mean": sum(edge_scans) / len(edge_scans),
+        "baseline_edge_scans_max": max(edge_scans),
+        "baseline_wall_clock_sec_mean": sum(wall_times) / len(wall_times),
+        "baseline_wall_clock_sec_max": max(wall_times),
+        "baseline_attempts": len(baseline_rows),
+    }
+
+    attack_results = {
+        "outlier_equal_degree_first_slot": {"successes": 0, "attempts": 0},
+        "greedy_smallest_endpoint": {"successes": 0, "attempts": 0},
+        "greedy_smallest_unused": {"successes": 0, "attempts": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0},
+        "by_hand_simple_translation": {"successes": 0, "attempts": 0},
+    }
+    for seed in range(8):
+        inst = make_instance(seed=20_000 + seed, **ship_params)
+        fixed_attacks = {
+            "outlier_equal_degree_first_slot": _first_slot(inst),
+            "greedy_smallest_endpoint": _smallest_endpoint(inst),
+            "greedy_smallest_unused": _greedy_unused(inst),
+            "by_hand_simple_translation": _simple_translation(inst),
+        }
+        for name, candidate in fixed_attacks.items():
+            attack_results[name]["attempts"] += 1
+            if candidate is not None and verify(inst, candidate)[0]:
+                attack_results[name]["successes"] += 1
+
+        restart_rng = random.Random(30_000 + seed)
+        restart_success = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, restart_rng))[0]:
+                restart_success = True
+                break
+        attack_results["random_restart_256"]["attempts"] += 1
+        attack_results["random_restart_256"]["successes"] += int(restart_success)
+
+    reference = {
+        "name": "Hopcroft-Karp bipartite perfect matching",
+        "complexity": "O(E*sqrt(V))",
+        "wall_clock_sec_mean": sum(wall_times) / len(wall_times),
+        "wall_clock_sec_max": max(wall_times),
+        "operations_edge_scans_mean": sum(edge_scans) / len(edge_scans),
+        "operations_edge_scans_max": max(edge_scans),
+        "phases_mean": sum(row["phases"] for row in baseline_rows) / len(baseline_rows),
+        "solves": f"{sum(row['ok'] for row in baseline_rows)}/8, as expected",
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(result["successes"] == 0
+                    and result["attempts"] >= 8
+                    for result in attack_results.values()),
+        "attacks": attack_results,
+        "reference_algorithm": reference,
+    }
+
+    doubled = make_instance(
+        n=2 * ship_params["n"], degree=ship_params["degree"], seed=4242
+    )
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["q"] > ship["q"]
+        and search_space(doubled) > search_space(ship),
+        "shipping_n": ship_params["n"],
+        "shipping_q": ship["q"],
+        "doubled_n": 2 * ship_params["n"],
+        "doubled_q": doubled["q"],
+        "shipping_space": search_space(ship),
+        "doubled_space": search_space(doubled),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    g8_failures = []
+    invariance_checks = 0
+    real_checks = 0
+    keys = []
+    for seed in range(20):
+        inst = make_instance(seed=40_000 + seed, **ship_params)
+        keys.append(canonical_key(inst))
+        rng = random.Random(50_000 + seed)
+        left_perm = list(range(inst["q"]))
+        right_perm = list(range(inst["q"]))
+        rng.shuffle(left_perm)
+        rng.shuffle(right_perm)
+        transformed, carried = _relabel_instance(inst, left_perm, right_perm)
+        invariance_checks += 1
+        if canonical_key(transformed) != canonical_key(inst):
+            g8_failures.append({"seed": seed, "kind": "key changed"})
+        real_checks += 1
+        if not verify(transformed, carried)[0]:
+            g8_failures.append({"seed": seed, "kind": "carried witness failed"})
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures and len(set(keys)) == len(keys),
+        "invariance_checks": invariance_checks,
+        "composed_transformation_checks": invariance_checks,
+        "real_transformation_checks": real_checks,
+        "unrelated_attempts": len(keys),
+        "unrelated_distinct": len(set(keys)),
+        "transformations": [
+            "arbitrary left-vertex permutation",
+            "arbitrary right-vertex permutation",
+            "adjacency-row reordering",
+            "composition of all three with a carried matching vector",
+        ],
+        "failures": g8_failures,
+    }
+
+    compact_answer, route_operations = _compact_affine_route(ship)
+    compact_ok = compact_answer is not None and verify(ship, compact_answer)[0]
+    answer_blob = json.dumps(planted, separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _atom_count(planted)
+    arms = {name: dict(G9_MEASUREMENTS[name])
+            for name in ("bare", "hinted", "placebo")}
+    hinted_rate = (arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+                   if arms["hinted"]["attempts"] else None)
+    placebo_rate = (arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+                    if arms["placebo"]["attempts"] else None)
+    within_caps = (answer_chars <= 2000 and answer_elements <= 256
+                   and route_operations <= 300)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps and compact_ok,
+        "arms": arms,
+        "hinted_minus_placebo": (
+            hinted_rate - placebo_rate
+            if hinted_rate is not None and placebo_rate is not None else None
+        ),
+        "hinted_verdict": G9_MEASUREMENTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": route_operations,
+        "compact_route_verifies": compact_ok,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gate_values = [value for key, value in report.items()
+                   if key.startswith("G") and isinstance(value, dict)]
+    report["all_passed"] = all(value.get("pass") for value in gate_values)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

