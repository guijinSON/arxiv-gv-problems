+
+def _cantor_code(value: int, digits: int = 7) -> int:
+    """Encode bits as base-three 0/1 digits, a three-term-AP-free set."""
+
+    result = 0
+    power = 1
+    for bit in range(digits):
+        if (value >> bit) & 1:
+            result += power
+        power *= 3
+    return result
+
+
+def _canonical_answer(groups) -> list[list[int]]:
+    return sorted(sorted(int(item) for item in group) for group in groups)
+
+
+def _sample_quotients(rng: random.Random, target_multiple: int, carry: int):
+    """Choose three quotients that keep every weight in (B/4, B/2)."""
+
+    low = target_multiple // 4 + 1
+    high = target_multiple // 2 - 1
+    choices = [
+        (first, second, target_multiple - carry - first - second)
+        for first in range(low, high + 1)
+        for second in range(low, high + 1)
+        if first != second
+        and low <= target_multiple - carry - first - second <= high
+    ]
+    if not choices:
+        raise ValueError("target_multiple leaves no strict 3-partition band")
+    return choices[rng.randrange(len(choices))]
+
+
+def make_instance(n, seed=0, target_multiple=56, modulus=BASE_MODULUS, **params) -> dict:
+    """Inverse-generate a strict partition and carry it through Section 5."""
+
+    del params
+    if isinstance(n, bool) or not isinstance(n, int) or not 3 <= n <= 128:
+        raise ValueError("n must be an integer in [3, 128]")
+    if (
+        isinstance(target_multiple, bool)
+        or not isinstance(target_multiple, int)
+        or target_multiple < 32
+        or target_multiple % 8 != 0
+    ):
+        raise ValueError("target_multiple must be a multiple of 8 and at least 32")
+    if (
+        isinstance(modulus, bool)
+        or not isinstance(modulus, int)
+        or modulus < BASE_MODULUS
+        or modulus % 2 == 0
+        or (modulus != BASE_MODULUS and modulus < 6 * (1024 + _cantor_code(127)) + 1)
+    ):
+        raise ValueError(
+            "modulus must be the odd base modulus 10009 or an odd integer at least 12703"
+        )
+
+    rng = random.Random(seed)
+    target = target_multiple * modulus
+
+    # The 128 base residues have been exhaustively checked in selftest: among
+    # residues r,r,-2r the only zero-sum triples are the intended ones.
+    base_pool = [1024 + _cantor_code(index) for index in range(128)]
+    selected = rng.sample(base_pool, n)
+    scale = rng.randrange(1, modulus)
+    while math.gcd(scale, modulus) != 1:
+        scale = rng.randrange(1, modulus)
+
+    encoded = []
+    for group, base_residue in enumerate(selected):
+        residue = (scale * base_residue) % modulus
+        complement = (-2 * residue) % modulus
+        carry = (2 * residue + complement) // modulus
+        first, second, third = _sample_quotients(rng, target_multiple, carry)
+        sizes = [
+            first * modulus + residue,
+            second * modulus + residue,
+            third * modulus + complement,
+        ]
+        if sum(sizes) != target:
+            raise AssertionError("internal residue-carry error")
+        if not all(4 * size > target and 2 * size < target for size in sizes):
+            raise AssertionError("internal strict-band error")
+        for role, size in enumerate(sizes):
+            encoded.append({"weight": size, "group": group, "role": role})
+
+    rng.shuffle(encoded)
+    weights = [entry["weight"] for entry in encoded]
+    groups = [[] for _ in range(n)]
+    for item_id, entry in enumerate(encoded):
+        groups[entry["group"]].append(item_id)
+    answer = _canonical_answer(groups)
+    if len(set(weights)) != 3 * n:
+        raise AssertionError("generated item weights unexpectedly collided")
+
+    item_count = 3 * n
+    bit_width = math.ceil(math.log2(item_count)) + 1
+    item_codes = list(range(1, item_count + 1))
+    total_tests = n + bit_width + 1
+    total_items = 2 * item_count + (bit_width + 1) + 1
+
+    return {
+        "n": n,
+        "target_multiple": target_multiple,
+        "modulus_parameter": modulus,
+        "target": target,
+        "weights": weights,
+        "item_codes": item_codes,
+        "bit_width": bit_width,
+        "test_limit": total_tests,
+        "test_cover_item_count": total_items,
+        "answer": answer,
+    }
+
+
+def _format_answer(answer) -> str:
+    return json.dumps(answer, separators=(",", ":"))
+
+
+def render(inst) -> str:
+    """Render the complete finite Test Cover instance and output contract."""
+
+    item_count = len(inst["weights"])
+    bit_width = inst["bit_width"]
+    lines = [
+        "PAIRED-ITEM TEST COVER",
+        "",
+        "A test is a subset of a finite item set. A selected collection is a test",
+        "cover when every two distinct items have different membership signatures:",
+        "some selected test contains exactly one of them. Tests and items below are",
+        "finite even where a formula names a whole family.",
+        "",
+        f"There are m={item_count} original labels 0 through {item_count - 1}.",
+        f"Label i has integer weight w_i, and the target is B={inst['target']}.",
+        "Every weight lies strictly between B/4 and B/2. The weights are:",
+    ]
+    for start in range(0, item_count, 8):
+        segment = [
+            f"{index}:{inst['weights'][index]}"
+            for index in range(start, min(start + 8, item_count))
+        ]
+        lines.append("  " + "  ".join(segment))
+
+    lines.extend(
+        [
+            "",
+            "The Test Cover item set contains an isolated item O; private items",
+            f"D_0,...,D_{bit_width}; and paired items P_i,Q_i for every original label i.",
+            f"Each label i has the displayed nonzero binary code c_i={inst['item_codes'][0]}+i,",
+            f"written in exactly {bit_width} bits (least significant bit is bit 1).",
+            "",
+            "The tests are exactly the following:",
+            "* Z_0 contains D_0 and every P_i,Q_i.",
+            f"* For t=1,...,{bit_width}, Z_t contains D_t and contains both P_i,Q_i",
+            "  exactly when bit t of c_i is 1.",
+            "* For every unordered triple T={i,j,k} of distinct original labels whose",
+            "  three weights sum to B, there is one core test C_T. It contains every",
+            "  P_l; it contains Q_l exactly when l is not in T; and it contains no O",
+            "  or D_t. There are no other tests.",
+            "",
+            f"Find a test cover using at most K={inst['test_limit']} tests.",
+            "The private item D_t and isolated O force every Z_t into any cover. A",
+            "compact certificate therefore lists only the selected core tests, naming",
+            "C_{i,j,k} by [i,j,k]; the decoder adds all Z_t automatically.",
+            f"Return exactly n={inst['n']} triples. Every original label must occur",
+            "exactly once, and every listed triple must have weight sum exactly B.",
+            "These conditions make the decoded tests a concrete cover of size K.",
+            "IDs are zero-based; repeats are forbidden. Triple order and the order",
+            "inside a triple do not matter.",
+            "",
+            "Give your final answer inside <answer></answer> tags, as a JSON array of",
+            f"exactly {inst['n']} arrays, each containing exactly three integer IDs.",
+            "Syntax example for a hypothetical six-label instance:",
+            "<answer>[[0,2,4],[1,3,5]]</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text) -> object | None:
+    """Extract a tagged JSON list while tolerating prose and Markdown fences."""
+
+    if not isinstance(text, str):
+        return None
+    tagged = re.search(r"<answer\b[^>]*>(.*?)</answer\s*>", text, re.I | re.S)
+    candidates = [tagged.group(1)] if tagged else []
+    candidates.append(text)
+    decoder = json.JSONDecoder()
+    for candidate in candidates:
+        cleaned = re.sub(r"```(?:json)?", "", candidate, flags=re.I).replace("```", "")
+        for match in re.finditer(r"\[", cleaned):
+            try:
+                value, _ = decoder.raw_decode(cleaned[match.start() :])
+            except (ValueError, json.JSONDecodeError):
+                continue
+            if isinstance(value, list):
+                return value
+    return None
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Accept every valid compact Test Cover witness; never read inst['answer']."""
+
+    if not isinstance(answer, list):
+        return False, "answer_not_list"
+    if not answer:
+        return False, "empty_answer"
+    if len(answer) != inst["n"]:
+        return False, "wrong_core_test_count"
+    item_count = len(inst["weights"])
+    for triple in answer:
+        if not isinstance(triple, list) or len(triple) != 3:
+            return False, "wrong_triple_size"
+        for item_id in triple:
+            if isinstance(item_id, bool) or not isinstance(item_id, int):
+                return False, "noninteger_item_id"
+            if not 0 <= item_id < item_count:
+                return False, "item_id_out_of_range"
+    flattened = [item_id for triple in answer for item_id in triple]
+    if len(set(flattened)) != len(flattened):
+        return False, "duplicate_item_id"
+    if set(flattened) != set(range(item_count)):
+        return False, "items_missing"
+    for triple in answer:
+        if sum(inst["weights"][item_id] for item_id in triple) != inst["target"]:
+            return False, "triple_weight_not_target"
+
+    # Expand the actual selected-test membership signatures.  Bits 0 through
+    # bit_width name Z_0 through Z_bit_width; the n following bits name the
+    # submitted core tests in their submitted order.
+    codes = inst["item_codes"]
+    if len(codes) != item_count or len(set(codes)) != item_count:
+        return False, "item_codes_not_injective"
+    if any(code <= 0 or code >= 1 << inst["bit_width"] for code in codes):
+        return False, "item_code_out_of_range"
+    core_all = (1 << inst["n"]) - 1
+    item_to_core = [0] * item_count
+    for core_index, triple in enumerate(answer):
+        for item_id in triple:
+            item_to_core[item_id] = core_index
+    signatures = []
+    for item_id, code in enumerate(codes):
+        forced = 1 | (code << 1)  # Z_0 and the p binary-code tests
+        p_signature = forced | (core_all << (inst["bit_width"] + 1))
+        q_core = core_all ^ (1 << item_to_core[item_id])
+        q_signature = forced | (q_core << (inst["bit_width"] + 1))
+        signatures.extend((p_signature, q_signature))
+    signatures.extend(1 << bit for bit in range(inst["bit_width"] + 1))
+    signatures.append(0)  # isolated item O
+    if len(signatures) != inst["test_cover_item_count"]:
+        return False, "decoded_item_count_mismatch"
+    if len(set(signatures)) != len(signatures):
+        return False, "selected_tests_do_not_distinguish_all_items"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample a partition satisfying all stated shape constraints."""
+
+    item_ids = list(range(len(inst["weights"])))
+    rng.shuffle(item_ids)
+    # Forgetting the displayed block order maps every ordered sample to an
+    # unlabeled partition with the same multiplicity n!*(3!)^n, so this is
+    # uniform over the certificate language while avoiding needless sorting.
+    return [item_ids[start : start + 3]
+            for start in range(0, len(item_ids), 3)]
+
+
+def _sampled_partition_verifies(inst, rng) -> bool:
+    """Sample the same uniform language, stopping at the first bad triple.
+
+    Taking the least remaining label and choosing its two partners uniformly
+    generates every unlabeled triple partition with the same probability.  A
+    failed target sum cannot be repaired by the ungenerated suffix, so this is
+    exactly equivalent to constructing the whole candidate and calling verify,
+    but makes the required 200,000-sample experiment practical.
+    """
+
+    remaining = list(range(len(inst["weights"])))
+    weights = inst["weights"]
+    target = inst["target"]
+    while remaining:
+        length = len(remaining)
+        first_position = 0
+        second_position = rng.randrange(1, length)
+        third_position = rng.randrange(1, length - 1)
+        if third_position >= second_position:
+            third_position += 1
+        triple_sum = (
+            weights[remaining[first_position]]
+            + weights[remaining[second_position]]
+            + weights[remaining[third_position]]
+        )
+        if triple_sum != target:
+            return False
+        for position in sorted(
+            (first_position, second_position, third_position), reverse=True
+        ):
+            remaining.pop(position)
+    return True
+
+
+def search_space(inst) -> int | None:
+    """Count partitions of 3n labeled items into n unordered triples."""
+
+    n = inst["n"]
+    return math.factorial(3 * n) // (6**n * math.factorial(n))
+
+
+def enumerate_all(inst) -> int | None:
+    """Exactly count valid compact covers when the partition space is small."""
+
+    if search_space(inst) > 1_000_000:
+        return None
+    weights = inst["weights"]
+    target = inst["target"]
+
+    @functools.lru_cache(maxsize=None)
+    def count(remaining: tuple[int, ...]) -> int:
+        if not remaining:
+            return 1
+        first = remaining[0]
+        total = 0
+        for second, third in itertools.combinations(remaining[1:], 2):
+            if weights[first] + weights[second] + weights[third] != target:
+                continue
+            used = {first, second, third}
+            total += count(tuple(item for item in remaining if item not in used))
+        return total
+
+    return count(tuple(range(len(weights))))
+
+
+def canonical_key(inst) -> str:
+    """A strong item/test-relabeling invariant of the generated set system."""
+
+    records = sorted(
+        (weight, code.bit_count())
+        for weight, code in zip(inst["weights"], inst["item_codes"])
+    )
+    by_weight = sorted(zip(inst["weights"], inst["item_codes"]))
+    distance_rows = []
+    for left in range(len(by_weight)):
+        weight_left, code_left = by_weight[left]
+        for right in range(left + 1, len(by_weight)):
+            weight_right, code_right = by_weight[right]
+            distance_rows.append(
+                (weight_left, weight_right, (code_left ^ code_right).bit_count())
+            )
+    payload = {
+        "target": inst["target"],
+        "test_limit": inst["test_limit"],
+        "weight_code_weights": records,
+        "code_hamming_distances": distance_rows,
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Increase coefficient height while keeping the certificate length fixed."""
+
+    n = int(params.get("n", 56))
+    target_multiple = int(params.get("target_multiple", 56))
+    modulus = int(params.get("modulus", BASE_MODULUS))
+    modulus_ladder = [
+        BASE_MODULUS,
+        2147483647,
+        2305843009213693951,
+        618970019642690137449562111,
+        162259276829213363391578010288127,
+        170141183460469231731687303715884105727,
+    ]
+    for candidate in modulus_ladder:
+        if candidate > modulus:
+            return {
+                "n": n,
+                "target_multiple": target_multiple + 8,
+                "modulus": candidate,
+            }
+    return {
+        "n": n,
+        "target_multiple": target_multiple + 8,
+        "modulus": 2**521 - 1,
+    }
+
+
+def _reference_algorithm(inst):
+    """Quadratic pair-sum indexing of every core test in the succinct family."""
+
+    weights = inst["weights"]
+    by_value = {value: index for index, value in enumerate(weights)}
+    triples = set()
+    pair_probes = 0
+    lookup_hits = 0
+    for first in range(len(weights)):
+        for second in range(first + 1, len(weights)):
+            pair_probes += 1
+            needed = inst["target"] - weights[first] - weights[second]
+            third = by_value.get(needed)
+            if third is not None:
+                lookup_hits += 1
+                if third > second:
+                    triples.add((first, second, third))
+    answer = _canonical_answer(triples)
+    return answer, {
+        "pair_probes": pair_probes,
+        "lookup_hits": lookup_hits,
+        "operations": 2 * pair_probes + lookup_hits,
+        "core_tests_generated": len(triples),
+    }
+
+
+def _display_order_candidate(inst):
+    return _canonical_answer(
+        range(start, start + 3) for start in range(0, len(inst["weights"]), 3)
+    )
+
+
+def _sorted_adjacent_candidate(inst):
+    ids = sorted(range(len(inst["weights"])), key=lambda item: inst["weights"][item])
+    return _canonical_answer(ids[start : start + 3] for start in range(0, len(ids), 3))
+
+
+def _balanced_rank_candidate(inst):
+    ids = sorted(range(len(inst["weights"])), key=lambda item: inst["weights"][item])
+    n = inst["n"]
+    return _canonical_answer(
+        [ids[index], ids[n + index], ids[3 * n - 1 - index]] for index in range(n)
+    )
+
+
+def _central_outlier_candidate(inst):
+    ids = sorted(
+        range(len(inst["weights"])),
+        key=lambda item: (abs(3 * inst["weights"][item] - inst["target"]), item),
+    )
+    return _canonical_answer(ids[start : start + 3] for start in range(0, len(ids), 3))
+
+
+def _relabel_items(inst, order):
+    """Carry the certificate through an arbitrary original-item relabeling."""
+
+    moved = copy.deepcopy(inst)
+    moved["weights"] = [inst["weights"][old] for old in order]
+    moved["item_codes"] = [inst["item_codes"][old] for old in order]
+    old_to_new = {old: new for new, old in enumerate(order)}
+    moved["answer"] = _canonical_answer(
+        [old_to_new[item_id] for item_id in triple] for triple in inst["answer"]
+    )
+    return moved
+
+
+def _permute_bit_coordinates(inst, order):
+    """Relabel bit tests and their private items, carrying every code."""
+
+    moved = copy.deepcopy(inst)
+    codes = []
+    for code in inst["item_codes"]:
+        changed = 0
+        for new_bit, old_bit in enumerate(order):
+            if (code >> old_bit) & 1:
+                changed |= 1 << new_bit
+        codes.append(changed)
+    moved["item_codes"] = codes
+    return moved
+
+
+def _answer_atoms(value) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def _full_residue_pool_check() -> bool:
+    """Exhaustively confirm the fixed residue construction, once in selftest."""
+
+    base = [1024 + _cantor_code(index) for index in range(128)]
