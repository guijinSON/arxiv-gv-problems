+def _relabel_coordinates(inst: dict, relabel: list[int]) -> dict:
+    """Relabel coordinate names and carry the marked order."""
+    d = inst["dimension"]
+    if sorted(relabel) != list(range(d)):
+        raise ValueError("not a coordinate permutation")
