+)
+try:
+    from gvlib import exact_matrices, rationals
+except ImportError:  # pragma: no cover - this family needs no helper
+    exact_matrices = rationals = None
+
+
+TRACK: str = "B"
+
+BASE_MODULUS = 10009
+
+STRUCTURAL_HINT: str = (
+    "The item weights fall into repeated residue classes under one common "
+    "divisor of the target."
+)
+PLACEBO_HINT: str = (
+    "The item identifiers should be tracked with consistent care throughout "
+    "the calculation."
+)
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "exact_cover",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "finite Test Cover set system",
+        "paired items with the paper's bit-representation tests",
+        "selected core tests named by their three exceptional item IDs",
+    ],
+    "verification_operations": [
+        "exact integer target-sum comparison",
+        "item-ID range, disjointness, and coverage checks",
+        "exact binary-signature distinctness invariant",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 5, Incompressibility of Test Cover: the reduction from "
+        "Red-Blue Dominating Set using paired blue items, forced bit tests, "
+        "and one isolated item"
+    ),
