import random,time

def gen(k,s,ratio,seed):
 r=random.Random(seed); u=k*s; m=k*ratio
 xs=list(range(u)); r.shuffle(xs)
 edges=[tuple(sorted(xs[i*s:(i+1)*s])) for i in range(k)]
 seen=set(edges)
 while len(edges)<m:
  e=tuple(sorted(r.sample(range(u),s)))
  if e not in seen: seen.add(e); edges.append(e)
 r.shuffle(edges)
 return u,edges

def greedy(u,edges,seed,restarts=256):
 rr=random.Random(seed+123456)
 em=[sum(1<<x for x in e) for e in edges]
 full=(1<<u)-1
 for z in range(restarts):
  covered=0; sol=[]
  while len(sol)<u//len(edges[0]):
   gains=[(em[i]&~covered).bit_count() for i in range(len(edges))]
   g=max(gains)
   opts=[i for i,x in enumerate(gains) if x==g and i not in sol]
   i=rr.choice(opts); sol.append(i);covered|=em[i]
  if covered==full:return True,z+1
 return False,restarts

for k in [12,16,20,24,32]:
 for ratio in [12,16,20]:
  vals=[]
  for seed in range(8):
   u,e=gen(k,4,ratio,seed); vals.append(greedy(u,e,seed))
  print(k,ratio,vals,flush=True)
