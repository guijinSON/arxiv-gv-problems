-def _side_profiles(neighbour_sets: list[set[int]]) -> list[tuple[int, ...]]:
-    profiles = []
-    for i, row in enumerate(neighbour_sets):
-        intersections = sorted(
-            len(row & other)
-            for j, other in enumerate(neighbour_sets) if i != j
-        )
-        profiles.append(tuple(intersections))
-    return sorted(profiles)
-
