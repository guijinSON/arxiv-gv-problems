+def _attack_single_anchor_orbit(
+    inst: dict, rng: random.Random
+) -> list[int]:
+    del rng
+    d = inst["dimension"]
+    cycle = inst["coordinate_cycle"]
+    logical = [_named_to_logical(x, cycle) for x in inst["test_masks"]]
+    by_mask = {mask: i for i, mask in enumerate(logical)}
