+def _reference_gaussian(inst: dict) -> tuple[list[int] | None, int]:
+    """Incremental Gaussian basis and a conservative bit-operation count."""
+    d = inst["dimension"]
+    pivots: dict[int, tuple[int, int]] = {}
+    selected: list[int] = []
+    operations = 0
+    for test_id, row in enumerate(inst["test_masks"]):
+        value = row
