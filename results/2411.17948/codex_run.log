import gen_2411_17948 as g

def explicit(inst, ans):
    w=inst['bit_width']; n=len(ans); offset=w+1
    sig=[0]  # O
    sig += [1<<t for t in range(w+1)]  # D_t
    membership={i:set() for i in range(len(inst['weights']))}
    for z,tr in enumerate(ans):
        for i in tr: membership[i].add(z)
    core_all=sum(1<<(offset+z) for z in range(n))
    for i,code in enumerate(inst['item_codes']):
        forced=1
        for bit in range(w):
            if (code>>bit)&1: forced |= 1<<(bit+1)
        p=forced|core_all
        q=forced
        for z in range(n):
            if z not in membership[i]: q |= 1<<(offset+z)
        sig.extend([p,q])
