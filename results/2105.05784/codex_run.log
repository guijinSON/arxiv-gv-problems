	\includegraphics[scale=0.032]{figures/Disconnected_Edge_Construction_3_c.jpg}
	\caption{Different views on a disconnected 2-wall. To separate the 2-wall into two disconnected components, light gray cubes of the solid layer are removed in the space between the blue and purple teeth.}
