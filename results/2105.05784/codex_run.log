+            "operations": shipping["tag_dim"] + 2 * len(shipping["shear_program"]),
+        },
+    }
+
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_probability < 1e-6 and all_attacks_failed
