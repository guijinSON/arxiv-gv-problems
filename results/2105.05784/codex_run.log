+        coord = ",".join(map(str, record["coord"]))
+        tag = ",".join(map(str, record["tag"]))
+        lines.append(f"({coord}) : [{tag}]")
+    lines.extend([
+        "",
+        "A certificate is two vectors slope and offset. Each has length r, every",
