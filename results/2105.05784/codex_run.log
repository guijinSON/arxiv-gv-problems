+    # G8: record order, spatial axes, named tag axes, and their compositions.
+    invariance_checks = 0
+    carried_checks = 0
+    failures = []
+    unrelated_keys = []
+    g8_params = {"n": 48, "modulus": 1009, "tag_dim": 6, "shears": 12}
+    for index in range(20):
