+        # and clearance are certified by the bounds/rank checks above.
+        step_moves = high + x + y + (high - z - 1) + 1
+        if step_moves <= 0:
+            return False, f"rank {rank} has an invalid run-length path"
+        total_unit_moves += step_moves
