            operations += 1
            if (work[row][0] >> column) & 1:
                work[row][0] ^= work[rank][0]
                work[row][1] ^= work[rank][1]
                operations += bits + 1
        pivots.append((column, rank))
        rank += 1
        if rank == bits:
            break
    if rank != bits:
        return None, operations
