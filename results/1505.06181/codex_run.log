+def _compose_affine(rows_b, shift_b, rows_a, shift_a, d):
+    """Return B(A(v)) for the two affine maps."""
+    z = _affine(rows_b, shift_b, _affine(rows_a, shift_a, 0))
+    basis = [
+        _affine(rows_b, shift_b, _affine(rows_a, shift_a, 1 << j))
+        for j in range(d)
