+    offset = 2 * m1 + 2
+    e2, t2, c2, internal2 = _h1(m2, offset)
+    x1, y1 = 0, 1
+    x2, y2 = offset, offset + 1
+    bridge = _edge(internal1[u1], internal2[u2])
+    edges = ((e1 - {_edge(x1, y1)}) | (e2 - {_edge(x2, y2)}) |
+             {_edge(x1, x2), _edge(y1, y2), bridge})
