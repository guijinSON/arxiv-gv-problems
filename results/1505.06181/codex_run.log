-    queue = [0]
-    head = 0
-    inspections = 0
-    while head < len(queue):
-        u = queue[head]
-        head += 1
-        for v in range(n):
-            if u == v:
-                continue
-            inspections += 1
-            if v in adjacency[u]:
-                continue
-            expected = 1 - colour[u]
-            if colour[v] == -1:
-                colour[v] = expected
-                queue.append(v)
-            elif colour[v] != expected:
-                return None, inspections
-    if any(value == -1 for value in colour):
-        return None, inspections
-    parts = [
-        [v for v, value in enumerate(colour) if value == 0],
-        [v for v, value in enumerate(colour) if value == 1],
-    ]
-    return parts, inspections
