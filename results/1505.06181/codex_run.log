+def _reference_solve(inst):
+    """Generic bounded-template enumeration followed by exact isomorphism."""
+    n = inst["n"]
+    actual = {_edge(a, b) for a, b in inst["edges"]}
+    target_sig = _decompose_signature(n, actual)
+    operations = 0
