+
+def _attack_greedy_translation(inst):
+    ans = _attack_outlier_identity(inst)
+    adj = _adjacency(inst["n"], [tuple(e) for e in inst["edges"]])
+    high = [v for v in range(inst["n"]) if len(adj[v]) == 4]
+    ans["shift"] = min(high)
+    return ans
