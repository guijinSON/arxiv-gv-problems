+    # In each H1, deleting xy turns its leaf cycle into x--side--y.
+    path1 = [x1] + list(reversed(c1[2:])) + [y1]
+    path2 = [x2] + list(reversed(c2[2:])) + [y2]
+    cycle = path1 + [y2] + list(reversed(path2[:-1]))
