index 0000000000000000000000000000000000000000..96d326f7eed0c229670b1653097c5b59c73f680d
--- /dev/null
+++ b/gen_1505_06181.py
@@ -0,0 +1,940 @@
+"""Exact problem generator based on arXiv:1505.06181.
+
+The generated graph is an exact, finite version of the paper's Extremal Case 1:
+two dense pieces have a sparse cut between them.  A witness is the balanced
+two-piece decomposition.  From it the verifier constructs the paper's graph Q
+from Proposition 1 (two copies of H_1 joined by three independent edges) and
+checks, without trusting the proposition, its spanning tree, leaf cycle, and a
+compatible planar leaf order.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "finite simple graph satisfying the paper's Dirac minimum-degree bound",
+        "balanced approximate vertex-cut in Extremal Case 1",
+        "two H_1 ladder graphs composed into the paper's Halin graph Q",
+    ],
+    "verification_operations": [
+        "exact adjacency and degree comparison",
+        "complement-graph bipartition check",
+        "spanning-tree connectivity and degree check",
+        "leaf-cycle and circular-split planarity check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "Recognize that the nonedges form a connected bipartite graph, so its "
+        "two colour classes recover the paper's extremal cut; without this "
+        "change of viewpoint one must sort a dense adjacency matrix by hand."
+    ),
+    "hardness_basis": (
+        "Track B: breadth-first two-colouring of the complement runs in O(n^2); "
+        "at shipping n=120 it inspects 14,280 ordered vertex pairs per instance "
+        "and is measured in selftest(), whereas the two-row extremal-cut route "
+        "uses at most 252 exact adjacency decisions once the decomposition is seen."
+    ),
+    "max_answer_tokens": 94,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 12},
+    "easy": {"n": 48},
+    "medium": {"n": 84},
+    "hard": {"n": 120},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The nonedges form a connected bipartite graph whose two colour classes "
+    "are the paper's extremal pieces."
+)
+PLACEBO_HINT = (
+    "Careful bookkeeping of vertex labels is useful when presenting the two "
+    "parts of the certificate."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An unordered balanced partition [A,B] of all n vertices, normalized "
+        "by placing vertex 0 in A; A and B are integer lists of length n/2."
+    ),
+    "bounds": {
+        "parts": 2,
+        "part_size": "n/2",
+        "vertex_min": 0,
+        "vertex_max": "n-1",
+        "normalization": "vertex 0 belongs to the first part",
+        "shipping_n": 120,
+        "candidate_count": "C(n-1,n/2-1)",
+    },
+}
+
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+NOTES = r"""
+Definition and paper objects. Section 1 defines a Halin graph H=T union C,
+where T is a spanning tree with no degree-two vertex and C is a cycle on
+exactly the leaves in the planar order. Section 2 defines the ladder L_n and
+the ladder-based Halin graphs H_1 through H_5. Proposition 1 joins two H_1 or
+H_2 graphs after deleting their leaf edges x_i y_i and adding the three edges
+x_1x_2, y_1y_2, and u_1u_2; its proof explicitly gives the new underlying tree
+and leaf cycle. Section 3 defines Extremal Case 1 by an approximate cut into
+two dense pieces. Theorem 2 (labelled ``extremal1'' in the source) constructs
+exactly a spanning graph Q from Proposition 1 in that regime.
+
+Step-0 decision. The paper says that spanning-Halin recognition is NP-complete
+in general, but worst-case hardness does not apply to the generated promise
+distribution. The paper's main Dirac theorem is also existential and its
+non-extremal proof invokes the Regularity and Blow-up Lemmas. Therefore neither
+fact licenses a Track-A claim. This module is explicitly Track B. Its successful
+reference algorithm scans all O(n^2) pairs to build and two-colour the complement.
+The compact route examines the nonneighbors of one vertex and one opposite
+vertex; only four exceptional cross-neighbors remain, and three same-side
+anchors classify each of them. At n=120 this is at most 2n+12=252 exact
+adjacency decisions after the complement insight.
+
+Generation. A random balanced relabelling is sampled first. Each part is made
+a clique. Across the cut, two edge-disjoint perfect matchings are added; their
+union is a random collection of even cycles of length at least six. Thus every
+vertex has degree n/2+1, exactly the integer form of delta(G)>=(n+1)/2, and the
+empty-set cut is an exact member of Extremal Case 1. The partition is known
+before any graph search. Any cross-cycle supplies three independent connector
+edges. The verifier assigns those endpoints to x, y, and an internal vertex u
+of each H_1, fills all other ladder roles inside the cliques, and constructs Q.
+
+Executable verification does not merely cite Proposition 1. It checks every Q
+edge against the instance; checks that the proposed tree is connected, has
+n-1 edges and no degree-two vertex; checks that the remaining edges form one
+cycle on exactly the leaves; and checks that every tree-edge split is contiguous
+in the proposed circular leaf order. The last condition is a finite exact
+certificate that the tree embeds in a disk with those leaves on its boundary,
+so adding the boundary cycle is planar.
+
+Easy regimes and attacks. A degree outlier cannot distinguish the parts because
+the graph is regular. Label order, parity, taking neighbors of vertex zero, and
+lexicographic row order are destroyed by the balanced random relabelling. Random
+balanced partitions sample the fully constrained certificate language. The
+reference complement two-colouring is expected to solve every instance and is
+reported separately, as Track B requires.
+
+Canonicalization. In the complement the balanced bipartition is unique up to
+swap. Between the recovered parts, the original graph is 2-regular, so its
+sorted cross-cycle lengths are a complete isomorphism invariant for this exact
+generated family. The key is therefore independent of vertex names, edge order,
+part order, and seed; different keys represent genuinely non-isomorphic cycle
+types.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_FENCE_RE = re.compile(r"```(?:json|text)?\s*(.*?)```", re.I | re.S)
+_ENUMERATION_CAP = 2_000_000
+
+
+def _edge(u: int, v: int) -> tuple[int, int]:
+    return (u, v) if u < v else (v, u)
+
+
+def _validate_n(n: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise ValueError("n must be an integer")
+    if n < 12 or n % 12 != 0:
+        raise ValueError("n must be a positive multiple of 12 with n >= 12")
+
+
+def _permutation_without_short_cycles(size: int, rng: random.Random) -> list[int]:
+    for _ in range(20_000):
+        permutation = list(range(size))
+        rng.shuffle(permutation)
+        seen: set[int] = set()
+        lengths: list[int] = []
+        for start in range(size):
+            if start in seen:
+                continue
+            vertex = start
+            length = 0
+            while vertex not in seen:
+                seen.add(vertex)
+                length += 1
+                vertex = permutation[vertex]
+            lengths.append(length)
+        if min(lengths) >= 3:
+            return permutation
+    raise RuntimeError("could not sample a permutation with cycle lengths >= 3")
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Build an exact Extremal-Case-1 graph around a known balanced cut."""
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    _validate_n(n)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+    rng = random.Random(seed)
+    half = n // 2
+    labels = list(range(n))
+    rng.shuffle(labels)
+    left = labels[:half]
+    right = labels[half:]
+    permutation = _permutation_without_short_cycles(half, rng)
+
+    edges: set[tuple[int, int]] = set()
+    for part in (left, right):
+        for i, u in enumerate(part):
+            for v in part[i + 1 :]:
+                edges.add(_edge(u, v))
+    for i in range(half):
+        edges.add(_edge(left[i], right[i]))
+        edges.add(_edge(left[i], right[permutation[i]]))
+
+    answer_parts = [sorted(left), sorted(right)]
+    if 0 not in answer_parts[0]:
+        answer_parts.reverse()
+    return {
+        "n": n,
+        "edges": [list(pair) for pair in sorted(edges)],
+        "answer": answer_parts,
+    }
+
+
+def _adjacency(inst: dict) -> list[set[int]]:
+    n = inst.get("n")
+    if isinstance(n, bool) or not isinstance(n, int) or n < 1:
+        return []
+    adjacency = [set() for _ in range(n)]
+    edges = inst.get("edges")
+    if not isinstance(edges, list):
+        return []
+    for item in edges:
+        if (
+            not isinstance(item, (list, tuple))
+            or len(item) != 2
+            or any(isinstance(x, bool) or not isinstance(x, int) for x in item)
+        ):
+            return []
+        u, v = item
+        if not (0 <= u < n and 0 <= v < n) or u == v:
+            return []
+        adjacency[u].add(v)
+        adjacency[v].add(u)
+    return adjacency
+
+
+def render(inst: dict) -> str:
+    n = inst["n"]
+    adjacency = _adjacency(inst)
+    rows = ["".join("1" if j in adjacency[i] else "0" for j in range(n)) for i in range(n)]
+    statement = [
+        "SPANNING HALIN CERTIFICATE VIA AN EXTREMAL CUT",
+        "",
+        f"The vertices of a finite simple undirected graph G are 0,1,...,{n - 1}.",
+        "Its adjacency matrix is listed below. Row i has n bits; bit j is 1",
+        "exactly when {i,j} is an edge. The diagonal bits are 0 and the matrix",
+        "is symmetric.",
+        "",
+        "A Halin graph is the union of (i) a spanning tree with at least four",
+        "vertices and no vertex of tree-degree 2, and (ii) a cycle through",
+        "exactly the leaves in a cyclic order compatible with a planar embedding",
+        "of the tree. All tree and cycle edges must be edges of G.",
+        "",
+        "Find the balanced extremal cut certificate [A,B]. A and B must each",
+        f"contain exactly {n // 2} distinct vertices, must be disjoint, and must",
+        "together contain every vertex. Each of A and B must induce a clique",
+        "(every pair in that part is adjacent). Every vertex must have exactly",
+        "two neighbors in the other part, and every connected component of these",
+        "cross-edges must be an even cycle of length at least 6. These conditions",
+        "let the checker construct and directly verify a spanning Halin subgraph",
+        "using two ladder pieces and three independent cross-edges.",
+        "",
+        "Order inside A or B does not matter, and swapping A with B is allowed.",
+        "Vertex labels are 0-based and repetitions are forbidden.",
+        "",
+        "Adjacency rows:",
+    ]
+    statement.extend(f"{i}: {row}" for i, row in enumerate(rows))
+    statement.extend(
+        [
+            "",
+            "Give your final answer inside <answer></answer> tags as a JSON array",
+            "of two integer arrays, with no text inside the tags except the JSON.",
+            "Example: <answer>[[0,2,4,6,8,10],[1,3,5,7,9,11]]</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement.extend(["", STRUCTURAL_HINT])
+    elif mode == "placebo":
+        statement.extend(["", PLACEBO_HINT])
+    return "\n".join(statement)
+
+
+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    payload = match.group(1).strip() if match else None
+    if payload is None:
+        fence = _FENCE_RE.search(text)
+        payload = fence.group(1).strip() if fence else text.strip()
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(value, list):
+        return None
+    return value
+
+
+def _partition_shape(inst: dict, answer: object) -> tuple[bool, str, list[list[int]] | None]:
+    n = inst["n"]
+    half = n // 2
+    if answer == []:
+        return False, "answer is empty", None
+    if not isinstance(answer, list) or len(answer) != 2:
+        return False, "answer must contain exactly two parts", None
+    if not all(isinstance(part, list) for part in answer):
+        return False, "each part must be a list", None
+    if len(answer[0]) != half or len(answer[1]) != half:
+        return False, "parts must each contain n/2 vertices", None
+    flat = answer[0] + answer[1]
+    if any(isinstance(v, bool) or not isinstance(v, int) for v in flat):
+        return False, "every vertex label must be an integer", None
+    if any(v < 0 or v >= n for v in flat):
+        return False, "vertex out of range", None
+    if len(set(flat)) != n:
+        return False, "vertices must occur exactly once", None
+    return True, "ok", [list(answer[0]), list(answer[1])]
+
+
+def _cross_cycles(
+    adjacency: list[set[int]], left: set[int], right: set[int]
+) -> tuple[bool, str, list[list[int]]]:
+    cross = {
+        v: sorted(adjacency[v] & (right if v in left else left))
+        for v in left | right
+    }
+    if any(len(neighbors) != 2 for neighbors in cross.values()):
+        return False, "each vertex must have exactly two cross-neighbors", []
+    seen: set[int] = set()
+    cycles: list[list[int]] = []
+    for start in sorted(cross):
+        if start in seen:
+            continue
+        cycle: list[int] = []
+        previous = -1
+        current = start
+        while current not in seen:
+            seen.add(current)
+            cycle.append(current)
+            first, second = cross[current]
+            nxt = first if first != previous else second
+            previous, current = current, nxt
+        if current != start:
+            return False, "cross-edges do not form disjoint cycles", []
+        if len(cycle) < 6 or len(cycle) % 2:
+            return False, "every cross-cycle must have even length at least 6", []
+        cycles.append(cycle)
+    return True, "ok", cycles
+
+
+def _h1_edges(rungs: int) -> set[tuple[int, int]]:
+    x = 2 * rungs
+    y = x + 1
+    edges: set[tuple[int, int]] = set()
+    for i in range(rungs):
+        for j in range(max(0, i - 1), min(rungs, i + 2)):
+            edges.add(_edge(i, rungs + j))
+    for pair in ((x, 0), (x, rungs), (y, rungs - 1), (y, 2 * rungs - 1), (x, y)):
+        edges.add(_edge(*pair))
+    return edges
+
+
+def _h1_tree_and_leaf_cycle(rungs: int) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    edges = _h1_edges(rungs)
+    internal = {i for i in range(rungs) if i % 2 == 1}
+    internal.update(rungs + i for i in range(rungs) if i % 2 == 0)
+    tree = {pair for pair in edges if pair[0] in internal or pair[1] in internal}
+    leaf_cycle = edges - tree
+    return tree, leaf_cycle
+
+
+def _map_edges(edges: set[tuple[int, int]], mapping: list[int]) -> set[tuple[int, int]]:
+    return {_edge(mapping[u], mapping[v]) for u, v in edges}
+
+
+def _mapping_for_part(part: set[int], x_value: int, y_value: int, u_value: int) -> list[int]:
+    half = len(part)
+    rungs = (half - 2) // 2
+    mapping: list[int | None] = [None] * half
+    mapping[2 * rungs] = x_value
+    mapping[2 * rungs + 1] = y_value
+    mapping[1] = u_value  # a_2 in one-based paper notation; internal in our fixed tree.
+    remaining = iter(sorted(part - {x_value, y_value, u_value}))
+    for index in range(half):
+        if mapping[index] is None:
+            mapping[index] = next(remaining)
+    return [int(value) for value in mapping]
+
+
+def _circularly_contiguous(order: list[int], subset: set[int]) -> bool:
+    if not subset or len(subset) == len(order):
+        return True
+    flags = [vertex in subset for vertex in order]
+    transitions = sum(flags[i] != flags[(i + 1) % len(flags)] for i in range(len(flags)))
+    return transitions == 2
+
+
+def _check_halin(
+    n: int,
+    host_edges: set[tuple[int, int]],
+    tree: set[tuple[int, int]],
+    leaf_cycle: set[tuple[int, int]],
+) -> tuple[bool, str]:
+    if tree & leaf_cycle:
+        return False, "constructed tree and leaf cycle are not edge-disjoint"
+    if not (tree | leaf_cycle) <= host_edges:
+        return False, "a constructed Halin edge is absent from G"
+    if len(tree) != n - 1:
+        return False, "constructed tree does not have n-1 edges"
+    tree_adj = [set() for _ in range(n)]
+    for u, v in tree:
+        tree_adj[u].add(v)
+        tree_adj[v].add(u)
+    reached = {0}
+    stack = [0]
+    while stack:
+        current = stack.pop()
+        for nxt in tree_adj[current] - reached:
+            reached.add(nxt)
+            stack.append(nxt)
+    if len(reached) != n:
+        return False, "constructed tree is disconnected"
+    if any(len(neighbors) == 2 for neighbors in tree_adj):
+        return False, "constructed tree has a degree-two vertex"
+    leaves = {v for v in range(n) if len(tree_adj[v]) == 1}
+    cycle_adj = {v: set() for v in leaves}
+    for u, v in leaf_cycle:
+        if u not in leaves or v not in leaves:
+            return False, "constructed cycle contains a non-leaf"
+        cycle_adj[u].add(v)
+        cycle_adj[v].add(u)
+    if set(cycle_adj) != leaves or any(len(cycle_adj[v]) != 2 for v in leaves):
+        return False, "constructed leaf edges are not 2-regular on all leaves"
+    start = min(leaves)
+    order = [start]
+    previous = -1
+    current = start
+    while True:
+        neighbors = sorted(cycle_adj[current])
+        nxt = neighbors[0] if neighbors[0] != previous else neighbors[1]
+        if nxt == start:
+            break
+        if nxt in order:
+            return False, "constructed leaf edges contain more than one cycle"
+        order.append(nxt)
+        previous, current = current, nxt
+    if len(order) != len(leaves):
+        return False, "constructed leaf cycle is not spanning on the leaves"
+
+    # A cyclic leaf order is compatible with a plane tree exactly when each
+    # edge-induced leaf split is circularly contiguous.
+    for blocked_u, blocked_v in tree:
+        component = {blocked_u}
+        stack = [blocked_u]
+        while stack:
+            current = stack.pop()
+            for nxt in tree_adj[current]:
+                if (current == blocked_u and nxt == blocked_v) or (
+                    current == blocked_v and nxt == blocked_u
+                ):
+                    continue
+                if nxt not in component:
+                    component.add(nxt)
+                    stack.append(nxt)
+        if not _circularly_contiguous(order, leaves & component):
+            return False, "leaf order is incompatible with a planar tree embedding"
+    return True, "ok"
+
+
+def _construct_q(
+    inst: dict, parts: list[list[int]], adjacency: list[set[int]]
+) -> tuple[bool, str]:
+    part_sets = [set(parts[0]), set(parts[1])]
+    ok, reason, cycles = _cross_cycles(adjacency, part_sets[0], part_sets[1])
+    if not ok:
+        return False, reason
+    chosen = min(cycles, key=lambda cycle: (len(cycle), sorted(cycle)))
+    # Rotate/orient the cycle deterministically and take alternating edges.
+    anchor = min(chosen)
+    anchor_index = chosen.index(anchor)
+    forward = chosen[anchor_index:] + chosen[:anchor_index]
+    reverse_raw = list(reversed(chosen))
+    reverse_index = reverse_raw.index(anchor)
+    reverse = reverse_raw[reverse_index:] + reverse_raw[:reverse_index]
+    cycle = min(forward, reverse)
+    connectors = [(cycle[0], cycle[1]), (cycle[2], cycle[3]), (cycle[4], cycle[5])]
+    oriented: list[tuple[int, int]] = []
+    for u, v in connectors:
+        oriented.append((u, v) if u in part_sets[0] else (v, u))
+    (x0, x1), (y0, y1), (u0, u1) = oriented
+
+    mappings = [
+        _mapping_for_part(part_sets[0], x0, y0, u0),
+        _mapping_for_part(part_sets[1], x1, y1, u1),
+    ]
+    rungs = (len(part_sets[0]) - 2) // 2
+    h1_tree, h1_cycle = _h1_tree_and_leaf_cycle(rungs)
+    x_role, y_role = 2 * rungs, 2 * rungs + 1
+    xy = _edge(x_role, y_role)
+    tree = _map_edges(h1_tree, mappings[0]) | _map_edges(h1_tree, mappings[1])
+    tree.add(_edge(u0, u1))
+    leaf_cycle = _map_edges(h1_cycle - {xy}, mappings[0])
+    leaf_cycle |= _map_edges(h1_cycle - {xy}, mappings[1])
+    leaf_cycle.update({_edge(x0, x1), _edge(y0, y1)})
+    host_edges = {
+        _edge(u, v) for u, neighbors in enumerate(adjacency) for v in neighbors if u < v
+    }
+    return _check_halin(inst["n"], host_edges, tree, leaf_cycle)
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Verify any valid extremal partition; never inspect inst['answer']."""
+    try:
+        shape_ok, reason, parts = _partition_shape(inst, answer)
+        if not shape_ok or parts is None:
+            return False, reason
+        adjacency = _adjacency(inst)
+        if len(adjacency) != inst["n"]:
+            return False, "instance graph is malformed"
+        for part_index, part in enumerate(parts):
+            for i, u in enumerate(part):
+                for v in part[i + 1 :]:
+                    if v not in adjacency[u]:
+                        name = "first" if part_index == 0 else "second"
+                        return False, f"{name} part is not a clique"
+        return _construct_q(inst, parts, adjacency)
+    except (KeyError, TypeError, ValueError, StopIteration, IndexError):
+        return False, "malformed instance or answer"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    n = inst["n"]
+    chosen = set(rng.sample(range(1, n), n // 2 - 1))
+    first = sorted({0} | chosen)
+    second = sorted(set(range(n)) - set(first))
+    return [first, second]
+
+
+def search_space(inst: dict) -> int:
+    n = inst["n"]
+    return math.comb(n - 1, n // 2 - 1)
+
+
+def enumerate_all(inst: dict) -> int | None:
+    n = inst["n"]
+    space = search_space(inst)
+    if space > _ENUMERATION_CAP:
+        return None
+    valid = 0
+    others = range(1, n)
+    for selected in itertools.combinations(others, n // 2 - 1):
+        first = [0, *selected]
+        first_set = set(first)
+        second = [v for v in range(n) if v not in first_set]
+        valid += int(verify(inst, [first, second])[0])
+    return valid
+
+
+def _reference_complement_bipartition(inst: dict) -> tuple[list[list[int]] | None, int]:
+    adjacency = _adjacency(inst)
+    n = inst["n"]
+    if len(adjacency) != n:
+        return None, 0
+    colour = [-1] * n
+    colour[0] = 0
+    queue = [0]
+    head = 0
+    inspections = 0
+    while head < len(queue):
+        u = queue[head]
+        head += 1
+        for v in range(n):
+            if u == v:
+                continue
+            inspections += 1
+            if v in adjacency[u]:
+                continue
+            expected = 1 - colour[u]
+            if colour[v] == -1:
+                colour[v] = expected
+                queue.append(v)
+            elif colour[v] != expected:
+                return None, inspections
+    if any(value == -1 for value in colour):
+        return None, inspections
+    parts = [
+        [v for v, value in enumerate(colour) if value == 0],
+        [v for v, value in enumerate(colour) if value == 1],
+    ]
+    return parts, inspections
+
+
+def canonical_key(inst: dict) -> str:
+    parts, _ = _reference_complement_bipartition(inst)
+    if parts is None:
+        adjacency = _adjacency(inst)
+        degrees = sorted(len(row) for row in adjacency)
+        return "fallback:" + hashlib.sha256(json.dumps(degrees).encode()).hexdigest()
+    adjacency = _adjacency(inst)
+    left, right = set(parts[0]), set(parts[1])
+    ok, _, cycles = _cross_cycles(adjacency, left, right)
+    if not ok:
+        return "fallback:" + hashlib.sha256(
+            json.dumps(sorted(len(row) for row in adjacency)).encode()
+        ).hexdigest()
+    return json.dumps(
+        {"n": inst["n"], "cross_cycle_lengths": sorted(len(cycle) for cycle in cycles)},
+        separators=(",", ":"),
+        sort_keys=True,
+    )
+
+
+def escalate(params: dict) -> dict | str | None:
+    n = int(params.get("n", 12))
+    if n < 144:
+        return {"n": n + 12}
+    return "cap_bound"
+
+
+def _balanced(values: list[int], n: int) -> list[list[int]]:
+    half = n // 2
+    first = sorted(values[:half])
+    second = sorted(values[half:])
+    if 0 not in first:
+        first, second = second, first
+    return [first, second]
+
+
+def _attack_candidates(inst: dict, seed: int) -> dict[str, list[object]]:
+    n = inst["n"]
+    half = n // 2
+    adjacency = _adjacency(inst)
+    labels = list(range(n))
+    degree_order = sorted(labels, key=lambda v: (-len(adjacency[v]), v))
+    neighbor_order = [0] + sorted(adjacency[0]) + sorted(set(labels) - {0} - adjacency[0])
+    row_order = sorted(labels, key=lambda v: tuple(int(j in adjacency[v]) for j in labels))
+    parity = [v for v in labels if v % 2 == 0] + [v for v in labels if v % 2 == 1]
+    rng = random.Random(seed ^ 0x150506181)
+    restarts = [random_candidate(inst, rng) for _ in range(256)]
+    return {
+        "outlier_degree_split": [_balanced(degree_order, n)],
+        "greedy_neighbors_of_zero": [_balanced(neighbor_order[:half] + [v for v in labels if v not in set(neighbor_order[:half])], n)],
+        "lexicographic_row_ansatz": [_balanced(row_order, n)],
+        "parity_label_ansatz": [_balanced(parity, n)],
+        "random_restart_256": restarts,
+    }
+
+
+def _relabel_instance(inst: dict, permutation: list[int], reorder_seed: int | None = None) -> dict:
+    edges = [[permutation[u], permutation[v]] for u, v in inst["edges"]]
+    edges = [list(_edge(u, v)) for u, v in edges]
+    if reorder_seed is not None:
+        random.Random(reorder_seed).shuffle(edges)
+    answer = [[permutation[v] for v in part] for part in inst["answer"]]
+    answer = [sorted(part) for part in answer]
+    if 0 not in answer[0]:
+        answer.reverse()
+    return {"n": inst["n"], "edges": edges, "answer": answer}
+
+
+def _transformed_instances(inst: dict, seed: int) -> list[dict]:
+    n = inst["n"]
+    rng = random.Random(seed)
+    permutation = list(range(n))
+    rng.shuffle(permutation)
+    relabelled = _relabel_instance(inst, permutation)
+    reordered = _relabel_instance(inst, list(range(n)), reorder_seed=seed ^ 0xAA55)
+    composed = _relabel_instance(inst, permutation, reorder_seed=seed ^ 0x55AA)
+    return [relabelled, reordered, composed]
+
+
+def _answer_size(n: int) -> tuple[int, int]:
+    digit_chars = sum(len(str(v)) for v in range(n))
+    chars = digit_chars + n + 5
+    return chars, math.ceil(chars / 4)
+
