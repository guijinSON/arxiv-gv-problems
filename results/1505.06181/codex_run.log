+        "construction": "Proposition 1 composition plus affine relabelling",
+        "failures": failures,
+    }
+
+    inst = make_instance(seed=97, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    answer = json.loads(json.dumps(inst["answer"]))
