import random,time

def h1(m):
 n=2*m+2;x=2*m;y=x+1
 E=set()
 def add(a,b): E.add(tuple(sorted((a,b))))
 for i in range(m):
  for j in range(max(0,i-1),min(m,i+2)):add(i,m+j)
 add(x,0);add(x,m);add(y,m-1);add(y,2*m-1);add(x,y)
 return n,E

def gen(m,seed):
 n,E=h1(m);r=random.Random(seed); avail=list(range(n));r.shuffle(avail)
 # add random perfect matching of nonedges via retry recursion-ish
 for z in range(10000):
  r.shuffle(avail); M=[];ok=True
  for i in range(0,n,2):
   e=tuple(sorted((avail[i],avail[i+1])))
   if e in E:ok=False;break
   M.append(e)
  if ok:return n,E|set(M)
 raise Exception

def solve(m,G,cap=1000000):
 n,P=h1(m); PA=[set() for _ in range(n)];GA=[set() for _ in range(n)]
 for a,b in P:PA[a].add(b);PA[b].add(a)
 for a,b in G:GA[a].add(b);GA[b].add(a)
 # order using BFS starting x then constraints
 # dynamic MRV unmapped pattern with most mapped nbrs, ties structural
 mp={}; used=set(); nodes=0
 def rec():
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  if len(mp)==n:return dict(mp)
  unm=[u for u in range(n) if u not in mp]
  u=max(unm,key=lambda z:(sum(v in mp for v in PA[z]),len(PA[z])))
  mapped=[v for v in PA[u] if v in mp]
  if mapped:
   cand=set.intersection(*(GA[mp[v]] for v in mapped))-used
  else:cand=set(range(n))-used
  for w in cand:
   # forward every unmapped pattern neighbor needs enough free host nbrs
   mp[u]=w;used.add(w)
   ok=True
   for q in PA[u]:
    if q not in mp and not (GA[w]-used):ok=False;break
   if ok:
    ans=rec()
    if ans:return ans
   used.remove(w);del mp[u]
  return None
 t=time.perf_counter();a=rec();return a,nodes,time.perf_counter()-t
for m in (8,12,16,24,32,48,64):
 vals=[]
 for s in range(3):
  n,G=gen(m,s); a,nodes,t=solve(m,G,2000000);vals.append((bool(a),nodes,round(t,3)))
 print(m*2+2,vals)
