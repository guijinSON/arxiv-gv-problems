-def _check_halin(
-    n: int,
-    host_edges: set[tuple[int, int]],
-    tree: set[tuple[int, int]],
-    leaf_cycle: set[tuple[int, int]],
-) -> tuple[bool, str]:
-    if tree & leaf_cycle:
-        return False, "constructed tree and leaf cycle are not edge-disjoint"
-    if not (tree | leaf_cycle) <= host_edges:
-        return False, "a constructed Halin edge is absent from G"
-    if len(tree) != n - 1:
-        return False, "constructed tree does not have n-1 edges"
-    tree_adj = [set() for _ in range(n)]
-    for u, v in tree:
-        tree_adj[u].add(v)
-        tree_adj[v].add(u)
-    reached = {0}
-    stack = [0]
-    while stack:
-        current = stack.pop()
-        for nxt in tree_adj[current] - reached:
-            reached.add(nxt)
-            stack.append(nxt)
-    if len(reached) != n:
-        return False, "constructed tree is disconnected"
-    if any(len(neighbors) == 2 for neighbors in tree_adj):
-        return False, "constructed tree has a degree-two vertex"
-    leaves = {v for v in range(n) if len(tree_adj[v]) == 1}
-    cycle_adj = {v: set() for v in leaves}
-    for u, v in leaf_cycle:
-        if u not in leaves or v not in leaves:
-            return False, "constructed cycle contains a non-leaf"
-        cycle_adj[u].add(v)
-        cycle_adj[v].add(u)
-    if set(cycle_adj) != leaves or any(len(cycle_adj[v]) != 2 for v in leaves):
-        return False, "constructed leaf edges are not 2-regular on all leaves"
-    start = min(leaves)
-    order = [start]
-    previous = -1
-    current = start
-    while True:
-        neighbors = sorted(cycle_adj[current])
-        nxt = neighbors[0] if neighbors[0] != previous else neighbors[1]
-        if nxt == start:
-            break
-        if nxt in order:
-            return False, "constructed leaf edges contain more than one cycle"
-        order.append(nxt)
-        previous, current = current, nxt
-    if len(order) != len(leaves):
-        return False, "constructed leaf cycle is not spanning on the leaves"
-
-    # A cyclic leaf order is compatible with a plane tree exactly when each
-    # edge-induced leaf split is circularly contiguous.
-    for blocked_u, blocked_v in tree:
-        component = {blocked_u}
-        stack = [blocked_u]
-        while stack:
-            current = stack.pop()
-            for nxt in tree_adj[current]:
-                if (current == blocked_u and nxt == blocked_v) or (
-                    current == blocked_v and nxt == blocked_u
-                ):
-                    continue
-                if nxt not in component:
-                    component.add(nxt)
-                    stack.append(nxt)
-        if not _circularly_contiguous(order, leaves & component):
-            return False, "leaf order is incompatible with a planar tree embedding"
-    return True, "ok"
-
