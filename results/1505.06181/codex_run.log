import random,time

def gen(n,s):
 r=random.Random(s); p=list(range(n));r.shuffle(p);E={tuple(sorted((p[i],p[(i+1)%n]))) for i in range(n)}
 for z in range(10000):
  q=list(range(n));r.shuffle(q);M=[]
  for i in range(0,n,2):
   e=tuple(sorted((q[i],q[i+1])))
   if e in E:break
   M.append(e)
  else:return E|set(M)

def solve(n,E,cap=2000000):
 A=[set() for _ in range(n)]
 for a,b in E:A[a].add(b);A[b].add(a)
 # simple path DFS fix 0 and first neighbor
 nodes=0;path=[0];seen={0}
 def rec():
  nonlocal nodes
  nodes+=1
  if nodes>cap:return False
  if len(path)==n:return path[-1] in A[0]
  u=path[-1]
  cand=[v for v in A[u] if v not in seen]
  # Warnsdorff
  cand.sort(key=lambda v:sum(w not in seen for w in A[v]))
  for v in cand:
   path.append(v);seen.add(v)
   if rec():return True
   seen.remove(v);path.pop()
  return False
 t=time.perf_counter();ok=rec();return ok,nodes,time.perf_counter()-t
for n in (20,40,80,120,160,240):
 out=[]
 for s in range(8):
  E=gen(n,s);o=solve(n,E,500000);out.append((o[0],o[1],round(o[2],3)))
 print(n,out)
