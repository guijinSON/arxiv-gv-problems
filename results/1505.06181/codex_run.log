+    bb = [offset + 3 + 2 * i for i in range(m)]
+    edges = set()
+    for i, a in enumerate(aa):
+        for j in range(max(0, i - 1), min(m, i + 2)):
+            edges.add(_edge(a, bb[j]))
+    edges.update({_edge(x, aa[0]), _edge(x, bb[0]),
+                  _edge(y, aa[-1]), _edge(y, bb[-1]), _edge(x, y)})
