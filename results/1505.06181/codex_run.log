+def _rows_from_images(zero_image, basis_images, d):
+    columns = [x ^ zero_image for x in basis_images]
+    rows = []
+    for out_bit in range(d):
+        row = 0
+        for in_bit, col in enumerate(columns):
+            row |= ((col >> out_bit) & 1) << in_bit
+        rows.append(row)
+    return rows
