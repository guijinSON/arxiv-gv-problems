+def _relabel_instance(inst, rows_b, shift_b, rng):
+    n, d = inst["n"], inst["d"]
+    edges = [[_affine(rows_b, shift_b, a), _affine(rows_b, shift_b, b)]
+             for a, b in inst["edges"]]
+    edges = [list(_edge(a, b)) for a, b in edges]
