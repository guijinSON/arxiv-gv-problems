+
+    doubled = make_instance(n=DIFFICULTY[SHIPPING_DIFFICULTY]["n"] * 2, seed=81)
+    start = time.perf_counter(); doubled_ok = verify(doubled, doubled["answer"]); doubled_elapsed = time.perf_counter() - start
+    report["G7_scales"] = {
