%covering all vertices in $R_4(X_i')\cup R_4(Y_{i+1}')$ such that $V(L_{4x}^i)\subseteq X_i'\cup Y_i'$,
%$V(L_{4xy}^i)\subseteq  Y_i'\cup X_{i+1}'$, and $V(L_{4y}^{i+1})\subseteq X_{i+1}'\cup Y_{i+1}'$,
%and that $|X_i'\cap V(L_{4x}^i\cup L_{4xy}^i)|=|Y_i'\cap V(L_{4x}^i\cup L_{4xy}^i\cup L_{4y}^{i+1})|=
%|X_{i+1}'\cap V(L_{4x}^i\cup L_{4xy}^i\cup L_{4y}^{i+1})|=|Y_{i+1}'\cap V( L_{4xy}^i\cup L_{4y}^{i+1})|$.
\end{CLA}

\pf
Notice that by Claim~\ref{super-regular}, $(X_i', Y_i')$ is $2\ve$-regular with density at least $d-\ve$.
%By Claim~\ref{absorbing-pre},
% we have that
% $|R(X_i')|\le d^2N/5$.
Let $R(X_i')=\{x_1, \cdots, x_r\}$.
%Since for each $x_j$, $\Gamma(x_j, X_i')\ge (d-3\ve)|X_i'|>3|R'(X_i')|$,
%we know that there are $|R'(X_i')|$ vertex-disjoint 3-stars with their centers in
%$R(X_i')$ and with their leaves in $X_i'$.
