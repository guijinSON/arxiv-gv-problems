+def _random_gl(d, rng):
+    n = 1 << d
+    while True:
+        rows = [rng.randrange(n) for _ in range(d)]
+        if _rank_rows(rows, d) == d:
+            return rows
+
+
+def _affine(rows, shift, v):
+    out = 0
+    for i, row in enumerate(rows):
+        out |= ((row & v).bit_count() & 1) << i
+    return out ^ shift
 
