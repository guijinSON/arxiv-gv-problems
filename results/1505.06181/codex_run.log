-def _circularly_contiguous(order: list[int], subset: set[int]) -> bool:
-    if not subset or len(subset) == len(order):
-        return True
-    flags = [vertex in subset for vertex in order]
-    transitions = sum(flags[i] != flags[(i + 1) % len(flags)] for i in range(len(flags)))
-    return transitions == 2
