+def _rank_rows(rows, d):
+    work = list(rows)
+    rank = 0
+    for col in range(d - 1, -1, -1):
+        pivot = next((i for i in range(rank, len(work)) if (work[i] >> col) & 1), None)
+        if pivot is None:
+            continue
+        work[rank], work[pivot] = work[pivot], work[rank]
+        for i in range(len(work)):
+            if i != rank and ((work[i] >> col) & 1):
+                work[i] ^= work[rank]
+        rank += 1
+    return rank
