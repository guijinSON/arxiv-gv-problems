\begin{CLA}\label{small-ladders}
For each $i=1,2,\cdots, k$,  there  exist  vertex-disjoint
ladders $L_{x}^i$, $L_y^i$
such that
\begin{enumerate}[(a)]
\item $R(X_i')\subseteq V(L_{x}^{i})\subseteq  R(X_i')\cup  X_{i}'\cup Y_{i}'$
and $R'(Y_i')\subseteq V(L_{y}^{i})\subseteq  X_{i}'\cup Y_{i}'\cup R'(Y_i')$;
\item $|(V(L_x^i)\cup V(L_y^i))\cap X_i'|=4|R(X_i')|+3|R(Y_i')|+3|R_4(X_i')|-2$ and $|(V(L_x^i)\cup V(L_y^i))\cap Y_i'|=4|R(Y_i')|+4|R_4(X_i')|+3|R(X_i')|-2$; and
  \item the vertices on the first  and last rungs of each of  $L_{x}^i$ and  $L_y^i$ are contained in $X_i'\cup Y_i'$.
 % \item $|X_i'\cap V(L_{x}^i\cup L_{y}^i)|=|Y_i'\cap V(L_{x}^i\cup L_{y}^i|$.
\end{enumerate}
