+    components = []
+    unseen = set(range(n))
+    while unseen:
+        start = min(unseen)
+        comp = set(_distances(adj, {start}, cuts))
+        components.append(comp)
+        unseen -= comp
+    if len(components) != 2:
+        raise ValueError("removing the three Proposition 1 joins did not give two H1 pieces")
