+        "demo_exact_solution_fraction": demo_count / search_space(demo),
+        "demo_enumeration_wall_clock_sec": round(enum_elapsed, 6),
+        "strongest_failing_attack": "random_restart_2048",
+        "baseline_attack_restarts": 2048,
