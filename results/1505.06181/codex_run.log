+            - arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+        ),
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "oracle_evidence_ready": all(arms[x]["attempts"] > 0 for x in arms),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_atoms,
+        "intended_route_operations": route_ops,
+        "within_caps": within_caps,
+    }
+
+    report["all_passed"] = all(
+        value.get("pass", False) for key, value in report.items() if key.startswith("G")
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

codex
The replacement generator passes targeted correctness checks and is materially stronger than the cut draft: at \(n=128\), the general bounded-template matcher takes about 1.76 million counted operations and 16.5 seconds, while the topology-plus-XOR route uses 187 counted operations and returns a valid matrix certificate. I fixed an undercounting expression so the compact figure now explicitly includes the full one-pass topological labelling. The full gate suite is running next.
