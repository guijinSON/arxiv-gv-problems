+    cached = _VISIBLE_TEMPLATE_CACHE.get(key)
+    if cached is not None and cached[0] is inst:
+        return cached[1]
+    try:
+        (m1, u1), (m2, u2) = _decompose_signature(
+            inst["n"], [tuple(e) for e in inst["edges"]])
