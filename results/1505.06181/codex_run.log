-def verify(inst: dict, answer: object) -> tuple[bool, str]:
-    """Verify any valid extremal partition; never inspect inst['answer']."""
-    try:
-        shape_ok, reason, parts = _partition_shape(inst, answer)
-        if not shape_ok or parts is None:
-            return False, reason
-        adjacency = _adjacency(inst)
-        if len(adjacency) != inst["n"]:
-            return False, "instance graph is malformed"
-        for part_index, part in enumerate(parts):
-            for i, u in enumerate(part):
-                for v in part[i + 1 :]:
-                    if v not in adjacency[u]:
-                        name = "first" if part_index == 0 else "second"
-                        return False, f"{name} part is not a clique"
-        return _construct_q(inst, parts, adjacency)
-    except (KeyError, TypeError, ValueError, StopIteration, IndexError):
-        return False, "malformed instance or answer"
