+def _attack_outlier_identity(inst):
+    sig = _decompose_signature(inst["n"], [tuple(e) for e in inst["edges"]])
+    (m1, u1), (_, u2) = sig
+    d = inst["d"]
+    return {"m1": m1, "u1": u1, "u2": u2,
+            "rows": [1 << i for i in range(d)], "shift": 0}
