import math

def sieve(n):
 b=bytearray(b'\\x01')*(n+1); b[:2]=b'\\x00\\x00'
 for p in range(2,math.isqrt(n)+1):
  if b[p]: b[p*p:n+1:p]=b'\\x00'*(((n-p*p)//p)+1)
 return b

def aof(q,j,s): return 2*((j*q)//(2*s))
for n,c,s in [(20,5,8),(50,8,12),(100,8,12),(200,10,16),(1000,12,20),(10000,24,36),(200000,40,56),(1000000,52,68),(3000000,64,80)]:
 lim=4*n+100;b=sieve(lim); qs=0;pairs=0; cop=0; ex=None
 for q in range(n,2*n):
  if not b[q]:continue
  js=[]
  for j in range(1,c+1):
   a=aof(q,j,s)
   if 0<a<q and b[q-a] and b[q+a]: js.append(j)
  if js: qs+=1;pairs+=len(js)**2
  for x in range(len(js)):
   for y in range(x):
    a=aof(q,js[x],s);d=aof(q,js[y],s)
    f=4*q*q+12*a*a+1;g=4*q*q+12*d*d+1
    if math.gcd(f,g)==1:
     cop+=1; ex=ex or (q,js[x],js[y],a,d)
 print(n,c,s,'qgroups',qs,'pairs',pairs,'cop_pairs',cop,'example',ex)
