+def _iroot3(value: int) -> int:
+    lo, hi = 0, 1 << ((value.bit_length() + 2) // 3 + 1)
+    while lo + 1 < hi:
+        mid = (lo + hi) // 2
+        if mid * mid * mid <= value:
+            lo = mid
+        else:
+            hi = mid
+    return lo
