+
+NOTES = r"""
+Section 1 fixes arithmetic complexity as the number of additions and
+subtractions used by a matrix-multiplication scheme.  Table 1 displays the 23
+expanded A-forms, B-forms, and output forms of the rank-23 scheme; Table 2
+replaces repeated subexpressions by t-, u-, and v-registers and reports 59
+additions.  Its caption says Greedy Vanilla produces the reduction and Greedy
+Potential does not improve it.  Appendix A gives the same coefficient matrices
+in software format.  The paper explicitly defers technical search details, so
+it supplies no distributional Track-A theorem; this module is honestly Track B.
+
+The construction samples a balanced binary interval tree and independent input
+signs before it creates any expanded form.  Every internal node becomes a
+requested form, target names are shuffled, and the postorder tree is the held
+program.  Verification does not read that program: it expands the submitted
+signed-register additions over Z and compares every coefficient.
+
+An efficient algorithm exists.  A generic exact pair-sum/subset-DAG scan tests
+which previously representable subforms add to each target; selftest measures
+its coefficient inspections and wall time.  The intended no-tool route notices
+that the supports are contiguous intervals and laminar, then selects the two
+maximal proper subintervals.  Signs only orient leaf references.  Target-name
+shuffle and leaf signs defeat positional and magnitude outliers; randomized,
+smallest-support, balanced-pair, and chain ansatz attacks are tested separately.
+""".strip()
+
+
+# Filled from harden.py evidence after the three isolated runs.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
+}
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _compact_json(value):
+    return json.dumps(value, separators=(",", ":"), sort_keys=True)
+
+
+def _support_mask(vector):
+    mask = 0
+    for i, value in enumerate(vector):
+        if value:
+            mask |= 1 << i
+    return mask
+
+
+def _ref_code(ref, old_to_target, n, signs):
+    kind, index = ref
+    if kind == "x":
+        return signs[index] * (index + 1)
+    return n + old_to_target[index] + 1
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate expanded forms from a held signed addition tree."""
+    min_split_fraction = params.pop("min_split_fraction", 0.24)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if not _is_int(n) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    if not isinstance(min_split_fraction, (int, float)) or isinstance(
+            min_split_fraction, bool):
+        raise ValueError("min_split_fraction must be numeric")
+    if not 0.0 <= min_split_fraction < 0.5:
+        raise ValueError("min_split_fraction must lie in [0, 0.5)")
+
+    rng = random.Random(seed)
+    nodes = []
+
+    def build(lo, hi):
+        if hi - lo == 1:
+            return ("x", lo)
+        length = hi - lo
+        margin = max(1, int(math.ceil(length * min_split_fraction)))
+        first = lo + margin
+        last = hi - margin
+        if first > last:
+            first, last = lo + 1, hi - 1
+        split = rng.randint(first, last)
+        left = build(lo, split)
+        right = build(split, hi)
+        old_index = len(nodes)
+        nodes.append({
+            "lo": lo,
+            "hi": hi,
+            "left": left,
+            "right": right,
+        })
+        return ("t", old_index)
+
+    root = build(0, n)
+    if root[0] != "t" or len(nodes) != n - 1:
+        raise AssertionError("binary-tree construction failed")
+
+    target_order = list(range(n - 1))
+    rng.shuffle(target_order)
+    old_to_target = [0] * (n - 1)
+    for target_id, old_index in enumerate(target_order):
+        old_to_target[old_index] = target_id
+
+    signs = [1 if rng.randrange(2) else -1 for _ in range(n)]
+    targets = [None] * (n - 1)
+    intervals = [None] * (n - 1)
+    for old_index, node in enumerate(nodes):
+        target_id = old_to_target[old_index]
+        lo, hi = node["lo"], node["hi"]
+        targets[target_id] = [
+            signs[j] if lo <= j < hi else 0 for j in range(n)
+        ]
+        intervals[target_id] = [lo, hi - 1]
+
+    gates = []
+    for old_index, node in enumerate(nodes):
+        operand_a = _ref_code(node["left"], old_to_target, n, signs)
+        operand_b = _ref_code(node["right"], old_to_target, n, signs)
+        if abs(operand_a) > abs(operand_b):
+            operand_a, operand_b = operand_b, operand_a
+        gates.append([
+            old_to_target[old_index],
+            operand_a,
+            operand_b,
+        ])
+    gates.sort(key=lambda gate: (
+        sum(value != 0 for value in targets[gate[0]]), gate[0]))
+
+    return {
+        "family": "shared-addition program for laminar integer linear forms",
+        "n": n,
+        "target_count": n - 1,
+        "min_split_fraction": min_split_fraction,
+        "targets": targets,
+        "intervals": intervals,
+        "answer": {"gates": gates},
+    }
+
+
+def _format_form(vector):
+    pieces = []
+    for index, coeff in enumerate(vector, 1):
+        if not coeff:
+            continue
+        variable = "x" + str(index)
+        if not pieces:
+            pieces.append(variable if coeff > 0 else "-" + variable)
+        else:
+            pieces.append((" + " if coeff > 0 else " - ") + variable)
+    return "".join(pieces) if pieces else "0"
+
+
+def render(inst):
+    n = inst["n"]
+    m = inst["target_count"]
+    lines = [
+        "Shared-addition program recovery over the integers",
+        "",
+        f"The symbols x1,...,x{n} are independent formal variables over Z.",
+        f"Below are {m} target linear forms, in the stated target numbering:",
+    ]
+    for target_id, vector in enumerate(inst["targets"]):
+        lines.append(f"T{target_id} = {_format_form(vector)}")
+    lines.extend([
+        "",
+        f"Produce exactly {m} binary addition/subtraction gates that compute every target once.",
+        "A gate is [d,p,q] and means T_d = R(p) + R(q).",
+        f"Destination d is 0-indexed and must lie in 0..{m - 1}.",
+        f"For 1 <= |s| <= {n}, R(s) is sign(s)*x_|s|.",
+        f"For {n + 1} <= |s| <= {n + m}, R(s) is sign(s)*T_(|s|-{n + 1}).",
+        "Thus signed operand codes are nonzero integers; their signs mean negation.",
+        "The two operands of a gate must name distinct underlying registers.",
+        "Each target must be a destination exactly once, and a target used as an operand must have an earlier gate.",
+        "No unnamed temporary registers are allowed.",
+        "To remove harmless encodings, require |p| < |q| in every gate and order gates by increasing target support size (number of nonzero coefficients), breaking ties by d.",
+        "All equalities are exact coefficientwise identities over Z.",
+        "",
+        "Give your final answer inside <answer></answer> tags as compact JSON of the form",
+        '<answer>{"gates":[[d,p,q],...]}</answer>',
+        f"with exactly {m} gate records and no comments inside the tags.",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    body = match.group(1).strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _decode_operand(code, n, targets, available):
+    if not _is_int(code) or code == 0:
+        return None, "operand codes must be nonzero integers"
+    absolute = abs(code)
+    limit = n + len(targets)
+    if absolute > limit:
+        return None, f"operand reference {code} is out of range"
+    sign = 1 if code > 0 else -1
+    if absolute <= n:
+        vector = [0] * n
+        vector[absolute - 1] = sign
+        return vector, None
+    target_id = absolute - n - 1
+    if target_id not in available:
+        return None, f"target operand T{target_id} is not available yet"
+    return [sign * value for value in available[target_id]], None
+
+
+def verify(inst, answer):
+    """Expand a submitted program exactly; never consult inst['answer']."""
+    if not isinstance(answer, dict) or "gates" not in answer:
+        return False, "answer must be a JSON object containing gates"
+    gates = answer["gates"]
+    if not isinstance(gates, list):
+        return False, "gates must be a JSON list"
+    if not gates:
+        return False, "gate list is empty"
+    n = inst.get("n")
+    targets = inst.get("targets")
+    if not _is_int(n) or not isinstance(targets, list):
+        return False, "malformed instance"
+    m = len(targets)
+    if len(gates) != m:
+        return False, f"wrong gate count: expected {m}, got {len(gates)}"
+
+    available = {}
+    expected_order = _target_execution_order(inst)
+    for position, gate in enumerate(gates):
+        if not isinstance(gate, list) or len(gate) != 3:
+            return False, f"gate {position} must be [d,p,q]"
+        destination, p, q = gate
+        if not _is_int(destination) or not 0 <= destination < m:
+            return False, f"gate {position} destination is out of range"
+        if destination in available:
+            return False, f"duplicate destination T{destination}"
+        if destination != expected_order[position]:
+            return False, (
+                f"gate order mismatch at position {position}: expected "
+                f"T{expected_order[position]}, got T{destination}"
+            )
+        if _is_int(p) and _is_int(q) and p and q and abs(p) == abs(q):
+            return False, f"gate {position} operands must be distinct registers"
+        if _is_int(p) and _is_int(q) and p and q and abs(p) > abs(q):
+            return False, f"gate {position} operands are not in canonical order"
+        left, reason = _decode_operand(p, n, targets, available)
+        if reason:
+            return False, reason
+        right, reason = _decode_operand(q, n, targets, available)
+        if reason:
+            return False, reason
+        value = [a + b for a, b in zip(left, right)]
+        expected = targets[destination]
+        if value != expected:
+            first = next((j for j in range(n) if value[j] != expected[j]), 0)
+            return False, (
+                f"coefficient mismatch at T{destination}, x{first + 1}: "
+                f"got {value[first]}, expected {expected[first]}"
+            )
+        available[destination] = value
+    if len(available) != m:
+        return False, "not every target was computed"
+    return True, "ok"
+
+
+def _objects(inst):
+    n = inst["n"]
+    result = []
+    for j in range(n):
+        result.append((j + 1, 1 << j, [1 if k == j else 0 for k in range(n)]))
+    for target_id, vector in enumerate(inst["targets"]):
+        result.append((n + target_id + 1, _support_mask(vector), vector))
+    return result
+
+
+def _orientation(source, destination):
+    sign = None
+    for a, b in zip(source, destination):
+        if not a:
+            continue
+        if b == a:
+            current = 1
+        elif b == -a:
+            current = -1
+        else:
+            return None
+        if sign is None:
+            sign = current
+        elif sign != current:
+            return None
+    return sign
+
+
+def _candidate_pairs(inst):
+    cached = inst.get("_candidate_pairs_cache")
+    if cached is not None:
+        return cached
+    n = inst["n"]
+    objects = _objects(inst)
+    all_pairs = []
+    for destination, target in enumerate(inst["targets"]):
+        target_mask = _support_mask(target)
+        contained = [
+            item for item in objects
+            if item[1] != target_mask and not (item[1] & ~target_mask)
+        ]
+        pairs = []
+        for i, (code_a, mask_a, vec_a) in enumerate(contained):
+            orient_a = _orientation(vec_a, target)
+            if orient_a is None:
+                continue
+            for code_b, mask_b, vec_b in contained[i + 1:]:
+                if mask_a & mask_b:
+                    continue
+                orient_b = _orientation(vec_b, target)
+                if orient_b is None:
+                    continue
+                pairs.append((orient_a * code_a, orient_b * code_b))
+        if not pairs:
+            raise AssertionError(f"target {destination} has no structural candidates")
+        all_pairs.append(pairs)
+    inst["_candidate_pairs_cache"] = all_pairs
+    return all_pairs
+
+
+def _target_execution_order(inst):
+    return sorted(
+        range(inst["target_count"]),
+        key=lambda d: (sum(value != 0 for value in inst["targets"][d]), d),
+    )
+
+
+def random_candidate(inst, rng):
+    """Sample topological, contained, disjoint pairs—not arbitrary integer noise."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    pairs = _candidate_pairs(inst)
+    gates = []
+    for destination in _target_execution_order(inst):
+        p, q = rng.choice(pairs[destination])
+        gates.append([destination, p, q])
+    return {"gates": gates}
+
+
+def search_space(inst):
+    space = 1
+    for pairs in _candidate_pairs(inst):
+        space *= len(pairs)
+    return space
+
+
+def enumerate_all(inst):
+    pairs = _candidate_pairs(inst)
+    total = math.prod(len(options) for options in pairs)
+    if total > 100_000:
+        return None
+    order = _target_execution_order(inst)
+    valid = 0
+    ordered_options = [pairs[d] for d in order]
+    for choices in itertools.product(*ordered_options):
+        answer = {
+            "gates": [[d, p, q] for d, (p, q) in zip(order, choices)]
+        }
+        if verify(inst, answer)[0]:
+            valid += 1
+    return valid
+
+
+def _canonical_shape(inst):
+    n = inst["n"]
+    masks = [_support_mask(vector) for vector in inst["targets"]]
+    objects = [(1 << j, None) for j in range(n)]
+    objects.extend((mask, target_id) for target_id, mask in enumerate(masks))
+    memo = {}
+
+    def encode(mask):
+        if mask & (mask - 1) == 0:
+            return "L"
+        if mask in memo:
+            return memo[mask]
+        proper = [candidate for candidate, _ in objects
+                  if candidate != mask and not (candidate & ~mask)]
+        maximal = []
+        for candidate in proper:
+            if not any(candidate != other and not (candidate & ~other)
+                       for other in proper):
+                maximal.append(candidate)
+        maximal = sorted(set(maximal))
+        if len(maximal) != 2 or maximal[0] & maximal[1] or (
+                maximal[0] | maximal[1]) != mask:
+            raise ValueError("target supports are not a full laminar binary family")
+        children = sorted((encode(maximal[0]), encode(maximal[1])))
+        memo[mask] = "(" + children[0] + children[1] + ")"
+        return memo[mask]
+
+    root = max(masks, key=int.bit_count)
+    return encode(root)
+
+
+def canonical_key(inst):
+    shape = _canonical_shape(inst)
+    return hashlib.sha256(shape.encode("ascii")).hexdigest()
+
+
+def escalate(params):
+    n = params.get("n")
+    if not _is_int(n):
+        return None
+    if n < 72:
+        new_n = 72
+    elif n < 80:
+        new_n = 80
+    elif n < 84:
+        new_n = 84
+    else:
+        return None
+    out = dict(params)
+    out["n"] = new_n
+    return out
+
+
+def _operand_vector(inst, code):
+    n = inst["n"]
+    absolute = abs(code)
+    if absolute <= n:
+        vector = [0] * n
+        vector[absolute - 1] = 1 if code > 0 else -1
+        return vector
+    vector = inst["targets"][absolute - n - 1]
+    return vector if code > 0 else [-v for v in vector]
+
+
+def _reference_pair_scan(inst):
+    """Exact generic pair-sum scan; returns (answer, scalar operation count)."""
+    n = inst["n"]
+    pairs = _candidate_pairs(inst)
+    operations = inst["target_count"] * (2 * n - 1) * n
+    gates = []
+    for destination in _target_execution_order(inst):
+        expected = inst["targets"][destination]
+        found = None
+        for p, q in pairs[destination]:
+            left = _operand_vector(inst, p)
+            right = _operand_vector(inst, q)
+            matches = True
+            for a, b, want in zip(left, right, expected):
+                operations += 2  # one integer addition and one comparison
+                if a + b != want:
+                    matches = False
+                    break
+            if matches:
+                found = (p, q)
+                break
+        if found is None:
+            return None, operations
+        gates.append([destination, found[0], found[1]])
+    return {"gates": gates}, operations
+
+
+def _interval_solve(inst):
+    """The intended compact route, using interval endpoints only."""
+    n = inst["n"]
+    interval_to_code = {(j, j): j + 1 for j in range(n)}
+    target_intervals = {}
+    for destination, vector in enumerate(inst["targets"]):
+        support = [j for j, value in enumerate(vector) if value]
+        interval = (support[0], support[-1])
+        target_intervals[destination] = interval
+        interval_to_code[interval] = n + destination + 1
+
+    gates = []
+    endpoint_probes = 0
+    for destination in sorted(target_intervals,
+                              key=lambda d: (target_intervals[d][1]
+                                             - target_intervals[d][0], d)):
+        lo, hi = target_intervals[destination]
+        left = None
+        for split in range(hi - 1, lo - 1, -1):
+            endpoint_probes += 1
+            code = interval_to_code.get((lo, split))
+            if code is not None:
+                right = interval_to_code.get((split + 1, hi))
+                endpoint_probes += 1
+                if right is not None:
+                    left = code
+                    break
+        if left is None:
+            return None, endpoint_probes
+        target = inst["targets"][destination]
+        left_vec = _operand_vector(inst, left)
+        right_vec = _operand_vector(inst, right)
+        orient_left = _orientation(left_vec, target)
+        orient_right = _orientation(right_vec, target)
+        if orient_left is None or orient_right is None:
+            return None, endpoint_probes
+        operand_a = orient_left * left
+        operand_b = orient_right * right
+        if abs(operand_a) > abs(operand_b):
+            operand_a, operand_b = operand_b, operand_a
+        gates.append([destination, operand_a, operand_b])
+    return {"gates": gates}, endpoint_probes
+
+
+def _heuristic(inst, name, rng=None):
+    pairs = _candidate_pairs(inst)
+    objects = {code: mask for code, mask, _ in _objects(inst)}
+    gates = []
+    for destination in _target_execution_order(inst):
+        options = pairs[destination]
+        if name == "smallest":
+            chosen = min(options, key=lambda pair: (
+                (objects[abs(pair[0])].bit_count()
+                 + objects[abs(pair[1])].bit_count()),
+                abs(pair[0]), abs(pair[1])))
+        elif name == "balanced":
+            chosen = min(options, key=lambda pair: (
+                abs(objects[abs(pair[0])].bit_count()
+                    - objects[abs(pair[1])].bit_count()),
+                objects[abs(pair[0])].bit_count()
+                + objects[abs(pair[1])].bit_count(),
+                abs(pair[0]), abs(pair[1])))
+        elif name == "leftmost":
+            chosen = min(options, key=lambda pair: (abs(pair[0]), abs(pair[1])))
+        elif name == "chain":
+            leaf_options = [pair for pair in options
+                            if (objects[abs(pair[0])].bit_count() == 1
+                                or objects[abs(pair[1])].bit_count() == 1)]
+            pool = leaf_options or options
+            chosen = max(pool, key=lambda pair: (
+                objects[abs(pair[0])].bit_count()
+                + objects[abs(pair[1])].bit_count(),
+                -abs(pair[0]), -abs(pair[1])))
+        elif name == "random":
+            chosen = rng.choice(options)
+        else:
+            raise ValueError("unknown heuristic")
+        gates.append([destination, chosen[0], chosen[1]])
+    return {"gates": gates}
+
+
+def _adversary_panel(params):
+    names = {
+        "outlier_smallest_support": "smallest",
+        "greedy_most_balanced_pair": "balanced",
+        "left_to_right_register_pair": "leftmost",
+        "obvious_chain_ansatz": "chain",
+    }
+    results = {name: {"successes": 0, "attempts": 8}
+               for name in names}
+    random_successes = 0
+    random_attempts = 8
+    random_restarts = 256
+    attack_start = time.perf_counter()
+    reference_successes = 0
+    reference_operations = []
+    for seed in range(8):
+        inst = make_instance(seed=90_000 + seed, **params)
+        for public_name, internal_name in names.items():
+            candidate = _heuristic(inst, internal_name)
+            if verify(inst, candidate)[0]:
+                results[public_name]["successes"] += 1
+        rrng = random.Random(700_000 + seed)
+        solved = False
+        for _ in range(random_restarts):
+            if verify(inst, random_candidate(inst, rrng))[0]:
+                solved = True
+                break
+        random_successes += int(solved)
+    attack_elapsed = time.perf_counter() - attack_start
+    results["random_restart_256"] = {
+        "successes": random_successes,
+        "attempts": random_attempts,
+    }
+    reference_start = time.perf_counter()
+    for seed in range(8):
+        inst = make_instance(seed=190_000 + seed, **params)
+        candidate, operations = _reference_pair_scan(inst)
+        reference_operations.append(operations)
+        if candidate is not None and verify(inst, candidate)[0]:
+            reference_successes += 1
+    reference_elapsed = time.perf_counter() - reference_start
+    return {
+        "pass": all(item["successes"] == 0 for item in results.values()),
+        "attacks": results,
+        "attack_wall_clock_sec": attack_elapsed,
+        "attack_restarts": random_attempts * random_restarts,
+        "reference_algorithm": {
+            "name": "exact contained pair-sum / subset-DAG scan",
+            "complexity": "O(n^3) coefficient inspections plus candidate pair tests",
+            "wall_clock_sec": reference_elapsed,
+            "operations_max": max(reference_operations),
+            "operations_total": sum(reference_operations),
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+
+def _transform(inst, input_perm, target_perm, input_signs, target_signs):
+    """Carry an answer through input/target renaming and independent sign changes."""
+    n = inst["n"]
+    m = inst["target_count"]
+    old_input_to_new = [0] * n
+    for new, old in enumerate(input_perm):
+        old_input_to_new[old] = new
+    old_target_to_new = [0] * m
+    for new, old in enumerate(target_perm):
+        old_target_to_new[old] = new
+
+    targets = [[0] * n for _ in range(m)]
+    intervals = [[0, 0] for _ in range(m)]
+    for new_target, old_target in enumerate(target_perm):
+        for new_input, old_input in enumerate(input_perm):
+            targets[new_target][new_input] = (
+                target_signs[old_target]
+                * inst["targets"][old_target][old_input]
+                * input_signs[old_input]
+            )
+        support = [j for j, value in enumerate(targets[new_target]) if value]
+        intervals[new_target] = [min(support), max(support)]
+
+    def remap_operand(code, destination_sign):
+        old_sign = 1 if code > 0 else -1
+        absolute = abs(code)
+        if absolute <= n:
+            old_input = absolute - 1
+            sign = old_sign * destination_sign * input_signs[old_input]
+            return sign * (old_input_to_new[old_input] + 1)
+        old_target = absolute - n - 1
+        sign = old_sign * destination_sign * target_signs[old_target]
+        return sign * (n + old_target_to_new[old_target] + 1)
+
+    gates = []
+    for old_destination, p, q in inst["answer"]["gates"]:
+        destination_sign = target_signs[old_destination]
+        operand_a = remap_operand(p, destination_sign)
+        operand_b = remap_operand(q, destination_sign)
+        if abs(operand_a) > abs(operand_b):
+            operand_a, operand_b = operand_b, operand_a
+        gates.append([
+            old_target_to_new[old_destination],
+            operand_a,
+            operand_b,
+        ])
+    gates.sort(key=lambda gate: (
+        sum(value != 0 for value in targets[gate[0]]), gate[0]))
+    out = {
+        "family": inst["family"],
+        "n": n,
+        "target_count": m,
+        "min_split_fraction": inst["min_split_fraction"],
+        "targets": targets,
+        "intervals": intervals,
+        "answer": {"gates": gates},
+    }
+    return out
+
+
+def _corruption_tests(inst):
+    planted = inst["answer"]
+    corruptions = {}
+
+    dropped = copy.deepcopy(planted)
+    dropped["gates"].pop()
+    corruptions["drop_one"] = dropped
+
+    swapped = copy.deepcopy(planted)
+    leaf_gates = [i for i, (_, p, q) in enumerate(swapped["gates"])
+                  if abs(p) <= inst["n"] and abs(q) <= inst["n"]]
+    if len(leaf_gates) >= 2:
+        a, b = leaf_gates[:2]
+        swapped["gates"][a][1:], swapped["gates"][b][1:] = (
+            swapped["gates"][b][1:], swapped["gates"][a][1:])
+    else:
+        swapped["gates"][0][1] *= -1
+    corruptions["swap_one"] = swapped
+
+    duplicated = copy.deepcopy(planted)
+    duplicated["gates"][-1] = copy.deepcopy(duplicated["gates"][0])
+    corruptions["duplicate_one"] = duplicated
+
+    corruptions["empty"] = {"gates": []}
+
+    out_of_range = copy.deepcopy(planted)
+    out_of_range["gates"][0][1] = inst["n"] + inst["target_count"] + 7
+    corruptions["out_of_range"] = out_of_range
+
+    outcomes = {}
+    reasons = []
+    for name, answer in corruptions.items():
+        ok, reason = verify(inst, answer)
+        outcomes[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    passed = all(item["rejected"] for item in outcomes.values())
+    passed = passed and len(set(reasons)) == len(reasons)
+    return passed, outcomes
+
+
+def selftest():
+    report = {
+        "paper": "2601.05272",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    g1_count = 0
+    g1_ok = True
+    json_ok = True
+    for preset, params in DIFFICULTY.items():
+        for seed in range(3):
+            inst = make_instance(seed=10_000 * (1 + list(DIFFICULTY).index(preset)) + seed,
+                                 **params)
+            ok, _ = verify(inst, inst["answer"])
+            g1_ok = g1_ok and ok
+            json_ok = json_ok and (
+                json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            )
+            g1_count += 1
+    report["G1_planted_verifies"] = {
+        "pass": g1_ok and json_ok,
+        "instances": g1_count,
+        "answers_json_native": json_ok,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=424_242, **shipping_params)
+    g2_ok, g2_outcomes = _corruption_tests(shipping)
+    report["G2_rejects_corruption"] = {
+        "pass": g2_ok,
+        "cases": g2_outcomes,
+    }
+
+    realistic = (
+        "I used the shared subexpressions below.\n```json\n<answer>\n"
+        + _compact_json(shipping["answer"])
+        + "\n</answer>\n```\nThe signs use the statement's convention."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == shipping["answer"],
+        "model_style_response_parsed": parsed is not None,
+    }
+
+    guess_rng = random.Random(2_601_052_720)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_start = time.perf_counter()
+    for _ in range(guess_total):
+        if verify(shipping, random_candidate(shipping, guess_rng))[0]:
+            guess_hits += 1
+    guess_elapsed = time.perf_counter() - guess_start
+    guess_probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_probability,
+        "structure_aware_space": str(search_space(shipping)),
+        "sampling_wall_clock_sec": guess_elapsed,
+    }
+
+    panel = _adversary_panel(shipping_params)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_probability < 1e-6,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_sampled_density": guess_probability,
+        "valid_solution_count": 1,
+        "baseline_attack_wall_clock_sec": panel["attack_wall_clock_sec"],
+        "baseline_attack_restarts": panel["attack_restarts"],
+        "reference_wall_clock_sec": panel["reference_algorithm"]["wall_clock_sec"],
+        "reference_operations_max": panel["reference_algorithm"]["operations_max"],
+        "demo_enumerated_valid_answers": enumerate_all(
+            make_instance(seed=7, **DIFFICULTY["demo"])),
+    }
+    report["G6_adversary_panel"] = panel
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=808_080, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] == 2 * shipping["n"],
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "doubled_gate_count": doubled["target_count"],
+        "verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    invariant_ok = True
+    carried_ok = True
+    unrelated_keys = []
+    for seed in range(20):
+        inst = make_instance(seed=300_000 + seed, **shipping_params)
+        key = canonical_key(inst)
+        unrelated_keys.append(key)
+        rng = random.Random(400_000 + seed)
+        n, m = inst["n"], inst["target_count"]
+        input_perm = list(range(n))
+        target_perm = list(range(m))
+        rng.shuffle(input_perm)
+        rng.shuffle(target_perm)
+        input_signs = [1 if rng.randrange(2) else -1 for _ in range(n)]
+        target_signs = [1 if rng.randrange(2) else -1 for _ in range(m)]
+        transforms = [
+            (input_perm, list(range(m)), [1] * n, [1] * m),
+            (list(range(n)), target_perm, [1] * n, [1] * m),
+            (list(range(n)), list(range(m)), input_signs, target_signs),
+            (input_perm, target_perm, input_signs, target_signs),
+        ]
+        for args in transforms:
+            changed = _transform(inst, *args)
+            invariant_ok = invariant_ok and canonical_key(changed) == key
+            carried = verify(changed, changed["answer"])[0]
+            carried_ok = carried_ok and carried
+            invariance_checks += 1
+            carried_checks += 1
+    distinct_count = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant_ok and carried_ok and distinct_count == 20,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": carried_checks,
+        "unrelated_instances": 20,
+        "distinct_keys": distinct_count,
+        "transformations": [
+            "input permutation",
+            "target permutation",
+            "input and target sign changes",
+            "composition of all three",
+        ],
+    }
+
+    compact_answer, endpoint_probes = _interval_solve(shipping)
+    compact_ok = compact_answer is not None and verify(shipping, compact_answer)[0]
+    answer_strings = []
+    for seed in range(32):
+        answer_strings.append(_compact_json(
+            make_instance(seed=500_000 + seed, **shipping_params)["answer"]))
+    answer_chars = max(map(len, answer_strings))
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = 3 * shipping["target_count"]
+    intended_operations = shipping["target_count"]
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = (hinted["solved"] / hinted["attempts"]
+                   if hinted["attempts"] else 0.0)
+    placebo_rate = (placebo["solved"] / placebo["attempts"]
+                    if placebo["attempts"] else 0.0)
+    within_caps = (answer_chars <= 2000 and answer_elements <= 256
+                   and intended_operations <= 300)
+    hinted_hardened = G9_ORACLE_RESULTS["hinted_verdict"] == "hardened"
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_hardened and within_caps and compact_ok,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "interval_endpoint_probes": endpoint_probes,
+        "compact_route_verifies": compact_ok,
+    }
+
+    gate_values = [value.get("pass") for key, value in report.items()
+                   if key.startswith("G") and isinstance(value, dict)]
+    report["all_passed"] = bool(gate_values) and all(gate_values)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

