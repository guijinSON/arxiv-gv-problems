+def _transform(inst, input_perm, target_perm, input_signs, target_signs):
+    """Carry an answer through input/target renaming and independent sign changes."""
+    n = inst["n"]
+    m = inst["target_count"]
+    old_input_to_new = [0] * n
+    for new, old in enumerate(input_perm):
+        old_input_to_new[old] = new
+    old_target_to_new = [0] * m
+    for new, old in enumerate(target_perm):
+        old_target_to_new[old] = new
