+def _heuristic(inst, name, rng=None):
+    pairs = _candidate_pairs(inst)
+    objects = {code: mask for code, mask, _ in _objects(inst)}
+    gates = []
+    for destination in _target_execution_order(inst):
+        options = pairs[destination]
+        if name == "smallest":
+            chosen = min(options, key=lambda pair: (
+                (objects[abs(pair[0])].bit_count()
+                 + objects[abs(pair[1])].bit_count()),
+                abs(pair[0]), abs(pair[1])))
+        elif name == "balanced":
+            chosen = min(options, key=lambda pair: (
+                abs(objects[abs(pair[0])].bit_count()
+                    - objects[abs(pair[1])].bit_count()),
+                objects[abs(pair[0])].bit_count()
+                + objects[abs(pair[1])].bit_count(),
+                abs(pair[0]), abs(pair[1])))
+        elif name == "leftmost":
+            chosen = min(options, key=lambda pair: (abs(pair[0]), abs(pair[1])))
+        elif name == "chain":
+            leaf_options = [pair for pair in options
+                            if (objects[abs(pair[0])].bit_count() == 1
+                                or objects[abs(pair[1])].bit_count() == 1)]
+            pool = leaf_options or options
+            chosen = max(pool, key=lambda pair: (
+                objects[abs(pair[0])].bit_count()
+                + objects[abs(pair[1])].bit_count(),
+                -abs(pair[0]), -abs(pair[1])))
+        elif name == "random":
+            chosen = rng.choice(options)
+        else:
+            raise ValueError("unknown heuristic")
+        gates.append([destination, chosen[0], chosen[1]])
+    return {"gates": gates}
