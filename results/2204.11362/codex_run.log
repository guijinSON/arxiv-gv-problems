   618	def _attack_random_restart(inst, rng, attempts=8192):
   619	    last = 0
   620	    for _ in range(attempts):
   621	        last = rng.getrandbits(inst["n"])
   622	        if _assignment_error(inst, last) is None:
   623	            return _encode_int(inst, last)
   624	    return _encode_int(inst, last)
