   321	        return None, "answer must be one hexadecimal string"
   322	    if not answer:
   323	        return None, "answer is empty"
   324	    width = (inst["n"] + 3) // 4
   325	    if len(answer) < width:
   326	        return None, "answer has too few hexadecimal digits"
   327	    if len(answer) > width:
   328	        return None, "answer has too many hexadecimal digits"
   329	    if re.fullmatch(r"[0-9a-fA-F]+", answer) is None:
   330	        return None, "answer contains a non-hexadecimal character"
   331	    packed = int(answer, 16)
   332	    if packed >= (1 << inst["n"]):
   333	        return None, "unused high bits of the hexadecimal mask must be zero"
   334	    return packed, None
   335	
