+def parse_answer(text):
+    """Extract the last tagged bit string or JSON bit list; never raise."""
+    if not isinstance(text, str):
+        return None
+    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text, re.I | re.S)
+    for raw in reversed(blocks):
+        value = raw.strip()
+        value = re.sub(r"^```(?:json|text)?\s*", "", value, flags=re.I)
+        value = re.sub(r"\s*```$", "", value)
+        compact = re.sub(r"\s+", "", value)
+        if compact and set(compact) <= {"0", "1"}:
+            return [int(bit) for bit in compact]
+        try:
+            parsed = json.loads(value)
+        except (TypeError, ValueError):
+            continue
+        if isinstance(parsed, list):
+            return parsed
+    return None
