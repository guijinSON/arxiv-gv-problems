   734	def selftest():
   735	    report = {
   736	        "paper": "arXiv:2204.11362",
   737	        "track": TRACK,
   738	        "shipping_difficulty": SHIPPING_DIFFICULTY,
   739	        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
   740	    }
   741	
   742	    # G1: every named rung, several independent seeds.
   743	    g1_failures = []
   744	    g1_attempts = 0
   745	    for preset, parameters in DIFFICULTY.items():
   746	        for seed in (0, 1, 7):
   747	            inst = make_instance(seed=seed, **parameters)
   748	            ok, reason = verify(inst, inst["answer"])
   749	            g1_attempts += 1
   750	            if not ok:
   751	                g1_failures.append({"preset": preset, "seed": seed, "reason": reason})
   752	            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
   753	                g1_failures.append({"preset": preset, "seed": seed, "reason": "answer is not JSON-native"})
   754	    report["G1_planted_verifies"] = {
   755	        "pass": not g1_failures,
   756	        "attempts": g1_attempts,
   757	        "failures": g1_failures,
   758	    }
   759	
   760	    shipping = make_instance(seed=20220424, **DIFFICULTY[SHIPPING_DIFFICULTY])
   761	
   762	    # G2: five corruptions exercise five distinct rejection paths.
   763	    planted = shipping["answer"]
   764	    first = 0
   765	    second = next(index for index, digit in enumerate(planted) if digit != planted[first])
   766	    swapped_digits = list(planted)
   767	    swapped_digits[first], swapped_digits[second] = swapped_digits[second], swapped_digits[first]
   768	    swapped = "".join(swapped_digits)
   769	    corruptions = {
   770	        "drop_one": planted[:-1],
   771	        "swap_two_unequal_digits": swapped,
   772	        "duplicate_one": planted + planted[-1],
   773	        "empty": "",
   774	        "out_of_range": "g" + planted[1:],
   775	    }
   776	    rejection_reasons = {}
   777	    for name, candidate in corruptions.items():
   778	        ok, reason = verify(shipping, candidate)
   779	        rejection_reasons[name] = {"rejected": not ok, "reason": reason}
   780	    reason_set = {entry["reason"] for entry in rejection_reasons.values()}
   781	    report["G2_rejects_corruption"] = {
   782	        "pass": all(entry["rejected"] for entry in rejection_reasons.values())
   783	        and len(reason_set) == len(rejection_reasons),
   784	        "cases": rejection_reasons,
   785	        "distinct_reasons": len(reason_set),
   786	    }
   787	
   788	    # G3: prose, whitespace, and a Markdown fence around the tagged witness.
   789	    bit_text = shipping["answer"]
   790	    realistic = (
   791	        "I decoded the parity blocks and checked the detector neighborhoods.\n"
   792	        "<answer>\n```text\n" + bit_text + "\n```\n</answer>\n"
   793	        "The represented set has the requested size."
   794	    )
   795	    parsed = parse_answer(realistic)
   796	    report["G3_round_trip"] = {
   797	        "pass": parsed == shipping["answer"] and parse_answer("no tagged answer") is None,
   798	        "parsed_length": len(parsed) if isinstance(parsed, list) else None,
   799	    }
   800	
   801	    # G4/G5 density measurement at the actual shipping preset.
   802	    guess_rng = random.Random(0x220411362)
   803	    guess_total = 200_000
   804	    guess_hits = 0
   805	    started = time.perf_counter()
   806	    for _ in range(guess_total):
   807	        candidate = random_candidate(shipping, guess_rng)
   808	        if verify(shipping, candidate)[0]:
   809	            guess_hits += 1
   810	    guess_elapsed = time.perf_counter() - started
   811	    guess_probability = guess_hits / guess_total
   812	    report["G4_guess_resistance"] = {
   813	        "pass": guess_probability < 1e-6,
   814	        "hits": guess_hits,
   815	        "total": guess_total,
   816	        "observed_probability": guess_probability,
   817	        "structure_aware_space": search_space(shipping),
   818	        "sampling_rule": "uniform over all length-n bit vectors, after enforcing exactly one optional detector per variable gadget",
   819	        "wall_clock_sec": round(guess_elapsed, 6),
   820	    }
   821	
   822	    # Attack panel.  The successful polynomial algorithm is intentionally not
   823	    # in attacks: Track B records it separately as the reference algorithm.
   824	    attack_functions = {
   825	        "incidence_outlier": lambda inst, rng: _encode_bits(inst["n"], _attack_incidence_outlier(inst)),
   826	        "all_zero_ansatz": lambda inst, rng: _encode_int(inst, 0),
   827	        "greedy_bit_flip": lambda inst, rng: _encode_bits(inst["n"], _attack_greedy_bit_flip(inst)),
   828	        "random_restart_8192": lambda inst, rng: _attack_random_restart(inst, rng, 8192),
   829	        "public_order_recurrence": lambda inst, rng: _encode_bits(inst["n"], _attack_public_order_recurrence(inst)),
   830	    }
   831	    attack_results = {
   832	        name: {"successes": 0, "attempts": 0} for name in attack_functions
   833	    }
   834	    attack_seeds = list(range(8100, 8108))
   835	    strongest_elapsed = 0.0
   836	    for seed in attack_seeds:
   837	        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
   838	        for offset, (name, function) in enumerate(attack_functions.items()):
   839	            rng = random.Random(seed * 1009 + offset)
   840	            t0 = time.perf_counter()
   841	            candidate = function(inst, rng)
   842	            elapsed = time.perf_counter() - t0
   843	            if name == "random_restart_8192":
   844	                strongest_elapsed += elapsed
   845	            success = verify(inst, candidate)[0]
   846	            attack_results[name]["successes"] += int(success)
   847	            attack_results[name]["attempts"] += 1
   848	
   849	    reference_successes = 0
   850	    reference_elapsed = 0.0
   851	    reference_operations = []
   852	    reference_row_xors = []
   853	    for seed in attack_seeds:
   854	        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
   855	        t0 = time.perf_counter()
   856	        candidate, stats = _gaussian_reference(inst)
   857	        reference_elapsed += time.perf_counter() - t0
