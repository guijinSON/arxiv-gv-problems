+def escalate(params):
+    current = dict(params)
+    n = current.get("n")
+    copies = current.get("copies", 1)
+    if not _is_int(n):
+        return None
+    # n=74 is the last supported rung whose two-pass recurrence remains under
+    # the 300-operation no-tool cap: 4*(74-2)+6 = 294.
+    if n < 74:
+        candidate = min(74, n + 3)
+        while candidate % 3 == 0:
+            candidate += 1
+        return {"n": candidate, "copies": copies}
