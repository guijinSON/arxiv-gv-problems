   579	def _attack_incidence_outlier(inst):
   580	    scores = [0] * inst["n"]
   581	    for check in inst["checks"]:
   582	        for variable in check["vars"]:
   583	            scores[variable] += check["copies"]
   584	    ordered = sorted(scores)
   585	    median = ordered[len(ordered) // 2]
   586	    return [int(score > median) for score in scores]
