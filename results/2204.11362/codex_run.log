   449	def verify(inst, answer):
   450	    """Verify any represented threshold code without consulting inst['answer']."""
   451	    packed, error = _decode_answer(inst, answer)
   452	    if error is not None:
   453	        return False, error
   454	
   455	    # This is a direct local graph consequence: a false source clause leaves
   456	    # the corresponding c_j,d_j pair short of three distinguishing detectors.
   457	    error = _assignment_error(inst, packed)
   458	    if error is not None:
   459	        return False, error
   460	    error = _graph_certificate_error(inst, packed)
   461	    if error is not None:
   462	        return False, error
   463	    return True, "ok"
   464	
