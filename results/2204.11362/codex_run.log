   337	def _assignment_error(inst, packed):
   338	    for index, check in enumerate(inst["checks"]):
   339	        p, q, r = check["vars"]
   340	        parity = ((packed >> p) ^ (packed >> q) ^ (packed >> r)) & 1
   341	        if parity != check["rhs"]:
   342	            return f"parity block P{index:03d} leaves one of its clause gadgets unsatisfied"
   343	    return None
   344	
   345	
   346	def _parity_clauses(check):
   347	    """Yield signed-literal triples; positive k denotes v_(k-1)."""
   348	    variables = check["vars"]
   349	    rhs = check["rhs"]
   350	    clauses = []
   351	    for a in (0, 1):
   352	        for b in (0, 1):
   353	            for c in (0, 1):
   354	                values = (a, b, c)
   355	                if a ^ b ^ c == rhs:
   356	                    continue
   357	                clauses.append(tuple(
   358	                    variable + 1 if value == 0 else -(variable + 1)
   359	                    for variable, value in zip(variables, values)
   360	                ))
   361	    return clauses
   362	
   363	
   364	def _add_edge(adjacency, u, v):
   365	    adjacency[u] |= 1 << v
   366	    adjacency[v] |= 1 << u
   367	
   368	
   369	def _build_graph(inst):
   370	    """Expand the paper's exact gadgets to adjacency bitsets."""
   371	    n = inst["n"]
   372	    clauses = []
   373	    for check in inst["checks"]:
   374	        base_clauses = _parity_clauses(check)
   375	        for _ in range(check["copies"]):
   376	            clauses.extend(base_clauses)
   377	    vertex_count = 10 * n + 8 * len(clauses)
   378	    adjacency = [0] * vertex_count
   379	
   380	    for variable in range(n):
   381	        base = 10 * variable
   382	        for left, right in _VARIABLE_EDGE_TEMPLATE:
   383	            _add_edge(adjacency, base + left, base + right)
   384	
   385	    clause_start = 10 * n
   386	    for clause_index, clause in enumerate(clauses):
   387	        base = clause_start + 8 * clause_index
   388	        for left, right in _CLAUSE_EDGE_TEMPLATE:
   389	            _add_edge(adjacency, base + left, base + right)
   390	        connector = base + 7
   391	        for literal in clause:
   392	            variable = abs(literal) - 1
   393	            choice_vertex = 10 * variable + (0 if literal > 0 else 1)
   394	            _add_edge(adjacency, connector, choice_vertex)
   395	    return adjacency
   396	
   397	
   398	def _detector_mask(inst, packed):
   399	    n = inst["n"]
   400	    mask = 0
   401	    for variable in range(n):
   402	        bit = (packed >> variable) & 1
   403	        base = 10 * variable
   404	        mask |= 1 << (base + (0 if bit else 1))
   405	        for offset in range(2, 10):
   406	            mask |= 1 << (base + offset)
   407	    clause_start = 10 * n
   408	    for vertex in range(clause_start, inst["graph_vertices"]):
   409	        mask |= 1 << vertex
   410	    return mask
   411	
   412	
   413	def _iter_bits(mask):
   414	    while mask:
   415	        low = mask & -mask
   416	        yield low.bit_length() - 1
   417	        mask ^= low
   418	
   419	
   420	def _graph_certificate_error(inst, packed):
   421	    adjacency = _build_graph(inst)
   422	    if len(adjacency) != inst["graph_vertices"]:
   423	        return "internal graph expansion disagrees with the stated vertex count"
   424	    detectors = _detector_mask(inst, packed)
   425	    if detectors.bit_count() != inst["threshold"]:
   426	        return "represented detector set does not have the threshold size"
   427	
   428	    signatures = []
   429	    for vertex, neighbors in enumerate(adjacency):
   430	        signature = (neighbors | (1 << vertex)) & detectors
   431	        if signature.bit_count() < 3:
   432	            return f"vertex {vertex} is dominated by fewer than three detectors"
   433	        signatures.append(signature)
   434	
   435	    # If closed neighborhoods are disjoint, the two signatures each have size
   436	    # at least three and hence differ in at least six positions.  It is therefore
   437	    # exact (and much cheaper) to inspect only pairs at graph distance <= 2.
   438	    for u, neighbors in enumerate(adjacency):
   439	        nearby = neighbors
   440	        for middle in _iter_bits(neighbors):
   441	            nearby |= adjacency[middle]
   442	        nearby &= ~((1 << (u + 1)) - 1)
   443	        for v in _iter_bits(nearby):
   444	            if (signatures[u] ^ signatures[v]).bit_count() < 3:
   445	                return f"vertices {u} and {v} are distinguished by fewer than three detectors"
   446	    return None
   447	
