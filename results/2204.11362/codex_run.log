   475	def enumerate_all(inst):
   476	    if inst["n"] > 14:
   477	        return None
   478	    count = 0
   479	    for packed in range(1 << inst["n"]):
   480	        candidate = _encode_int(inst, packed)
   481	        if verify(inst, candidate)[0]:
   482	            count += 1
   483	    return count
