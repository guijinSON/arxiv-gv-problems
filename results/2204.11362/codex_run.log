   552	def escalate(params):
   553	    current = dict(params)
   554	    n = current.get("n")
   555	    copies = current.get("copies", 1)
   556	    if not _is_int(n):
   557	        return None
   558	    # Packing keeps the witness one atom.  Grow the cyclic haystack by 3/2 while
   559	    # the hexadecimal answer remains below the 2,000-character cap.
   560	    candidate = n + max(32, n // 2)
   561	    while candidate % 3 == 0:
   562	        candidate += 1
   563	    if (candidate + 3) // 4 > 1998:  # leave room for JSON quotes
   564	        return "cap_bound"
   565	    return {"n": candidate, "copies": copies}
