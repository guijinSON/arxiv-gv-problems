+def _least_dihedral_rotation(word):
+    candidates = []
+    for oriented in (list(word), list(reversed(word))):
+        for shift in range(len(oriented)):
+            candidates.append(tuple(oriented[shift:] + oriented[:shift]))
+    return min(candidates)
+
