   521	def _least_dihedral_rotation(word):
   522	    candidates = []
   523	    for oriented in (list(word), list(reversed(word))):
   524	        for shift in range(len(oriented)):
   525	            candidates.append(tuple(oriented[shift:] + oriented[:shift]))
   526	    return min(candidates)
   527	
