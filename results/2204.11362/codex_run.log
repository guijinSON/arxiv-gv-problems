def deg(a): return a.bit_length()-1

def divmod_poly(a,b):
    q=0; db=deg(b)
    while a and deg(a)>=db:
        s=deg(a)-db; q "'^= 1<<s; a ''^= b<<s
    return q,a

def mul(a,b):
    z=0
    while b:
        if b&1: z''^=a
        a<<=1; b>>=1
    return z

def mod(a,m): return divmod_poly(a,m)[1]
def inv(a,m):
