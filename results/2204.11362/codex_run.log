+_VARIABLE_EDGE_TEMPLATE = (
+    (0, 1),   # T--F
+    (2, 0),   # y--T
+    (2, 3),   # y--z
+    (2, 6),   # y--l
+    (3, 1),   # z--F
+    (3, 9),   # z--s
+    (0, 4),   # T--a
+    (1, 5),   # F--b
+    (4, 5),   # a--b
