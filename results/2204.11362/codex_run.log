   486	def _cycle_order(inst):
   487	    """Recover one orientation of the unique-triple cyclic hypergraph."""
   488	    pair_counts = {}
   489	    for check in inst["checks"]:
   490	        triple = sorted(check["vars"])
   491	        for i in range(3):
   492	            for j in range(i + 1, 3):
   493	                pair = (triple[i], triple[j])
   494	                pair_counts[pair] = pair_counts.get(pair, 0) + 1
   495	    neighbors = {vertex: [] for vertex in range(inst["n"])}
   496	    for (u, v), count in pair_counts.items():
   497	        if count == 2:
   498	            neighbors[u].append(v)
   499	            neighbors[v].append(u)
   500	    if any(len(values) != 2 for values in neighbors.values()):
   501	        raise ValueError("parity triples do not define one hidden cycle")
   502	
   503	    start = min(neighbors)
   504	    previous = None
   505	    current = start
   506	    order = []
   507	    first_next = min(neighbors[start])
   508	    while len(order) < inst["n"]:
   509	        order.append(current)
   510	        options = neighbors[current]
   511	        if previous is None:
   512	            nxt = first_next
   513	        else:
   514	            nxt = options[0] if options[0] != previous else options[1]
   515	        previous, current = current, nxt
   516	    if current != start or len(set(order)) != inst["n"]:
   517	        raise ValueError("pair-incidence graph is not a simple cycle")
   518	    return order
   519	
