   588	
   589	def _weighted_unsatisfied(inst, candidate):
   590	    total = 0
   591	    for check in inst["checks"]:
   592	        p, q, r = check["vars"]
   593	        if candidate[p] ^ candidate[q] ^ candidate[r] != check["rhs"]:
   594	            total += check["copies"]
   595	    return total
   596	
   597	
   598	def _attack_greedy_bit_flip(inst):
   599	    candidate = [0] * inst["n"]
   600	    score = _weighted_unsatisfied(inst, candidate)
   601	    for _ in range(inst["n"]):
   602	        best_score = score
   603	        best_variable = None
   604	        for variable in range(inst["n"]):
   605	            candidate[variable] ^= 1
   606	            trial = _weighted_unsatisfied(inst, candidate)
   607	            candidate[variable] ^= 1
   608	            if trial < best_score:
   609	                best_score = trial
   610	                best_variable = variable
   611	        if best_variable is None:
   612	            break
   613	        candidate[best_variable] ^= 1
   614	        score = best_score
   615	    return candidate
   616	
