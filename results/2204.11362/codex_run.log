   697	def _transformed_instance(inst, permutation, flips, seed):
   698	    """Carry an instance and witness through variable/clause relabellings."""
   699	    n = inst["n"]
   700	    checks = []
   701	    rng = random.Random(seed)
   702	    for check in inst["checks"]:
   703	        variables = [permutation[old] for old in check["vars"]]
   704	        rng.shuffle(variables)
   705	        rhs = check["rhs"]
   706	        for old in check["vars"]:
   707	            rhs ^= flips[old]
   708	        checks.append({"vars": variables, "rhs": rhs, "copies": check["copies"]})
   709	    rng.shuffle(checks)
   710	    old_packed, error = _decode_answer(inst, inst["answer"])
   711	    if error is not None:
   712	        raise ValueError(error)
   713	    answer = [0] * n
   714	    for old in range(n):
   715	        answer[permutation[old]] = ((old_packed >> old) & 1) ^ flips[old]
   716	    clause_count = 4 * sum(check["copies"] for check in checks)
   717	    return {
   718	        "paper": inst["paper"],
   719	        "family": inst["family"],
   720	        "n": n,
   721	        "checks": checks,
   722	        "clause_count": clause_count,
   723	        "graph_vertices": 10 * n + 8 * clause_count,
   724	        "threshold": 9 * n + 8 * clause_count,
   725	        "answer": _encode_bits(n, answer),
   726	    }
   727	
