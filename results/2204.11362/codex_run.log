+_CLAUSE_EDGE_TEMPLATE = (
+    (0, 1),   # L--M
+    (1, 2),   # M--N
+    (2, 3),   # N--R
+    (0, 4),   # L--U
+    (4, 2),   # U--N
+    (1, 5),   # M--V
+    (5, 3),   # V--R
+    (0, 6),   # L--D
+    (6, 7),   # D--C
+    (7, 3),   # C--R
+)
