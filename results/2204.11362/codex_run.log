+        p, q, r = check["vars"]
+        parity = ((packed >> p) ^ (packed >> q) ^ (packed >> r)) & 1
+        if parity != check["rhs"]:
+            return f"parity block P{index:03d} leaves one of its clause gadgets unsatisfied"
+    return None
