+    "hinted_verdict": "not_run",
+}
+
+
+_VARIABLE_EDGE_TEMPLATE = (
+    (0, 1),   # T--F
+    (2, 0),   # y--T
+    (2, 3),   # y--z
+    (2, 6),   # y--l
+    (3, 1),   # z--F
+    (3, 9),   # z--s
+    (0, 4),   # T--a
+    (1, 5),   # F--b
+    (4, 5),   # a--b
+    (6, 7),   # l--m
+    (8, 9),   # r--s
+    (6, 4),   # l--a
+    (7, 5),   # m--b
+    (4, 8),   # a--r
+    (5, 9),   # b--s
+)
+
+_CLAUSE_EDGE_TEMPLATE = (
+    (0, 1),   # L--M
+    (1, 2),   # M--N
+    (2, 3),   # N--R
+    (0, 4),   # L--U
