   645	def _gaussian_reference(inst):
   646	    """Generic GF(2) Gauss-Jordan elimination with an operation audit."""
   647	    n = inst["n"]
   648	    rows = []
   649	    for check in inst["checks"]:
   650	        coefficients = 0
   651	        for variable in check["vars"]:
   652	            coefficients ^= 1 << variable
   653	        rows.append(coefficients | (check["rhs"] << n))
   654	
   655	    rank = 0
   656	    pivot_rows = {}
   657	    bit_tests = 0
   658	    row_xors = 0
   659	    for column in range(n):
   660	        pivot = None
   661	        for row_index in range(rank, len(rows)):
   662	            bit_tests += 1
   663	            if (rows[row_index] >> column) & 1:
   664	                pivot = row_index
   665	                break
   666	        if pivot is None:
   667	            continue
   668	        rows[rank], rows[pivot] = rows[pivot], rows[rank]
   669	        for row_index in range(len(rows)):
   670	            if row_index == rank:
   671	                continue
   672	            bit_tests += 1
   673	            if (rows[row_index] >> column) & 1:
   674	                rows[row_index] ^= rows[rank]
   675	                row_xors += 1
   676	        pivot_rows[column] = rank
   677	        rank += 1
   678	
   679	    if rank != n:
   680	        return None, {
   681	            "rank": rank,
   682	            "row_xors": row_xors,
   683	            "bit_tests": bit_tests,
   684	            "scalar_operations": bit_tests + (n + 1) * row_xors,
   685	        }
   686	    solution = [0] * n
   687	    for column, row_index in pivot_rows.items():
   688	        solution[column] = (rows[row_index] >> n) & 1
   689	    return solution, {
   690	        "rank": rank,
   691	        "row_xors": row_xors,
   692	        "bit_tests": bit_tests,
   693	        "scalar_operations": bit_tests + (n + 1) * row_xors,
   694	    }
   695	
