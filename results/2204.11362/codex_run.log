   627	def _attack_public_order_recurrence(inst):
   628	    """Tempting by-hand ansatz: treat public labels as the cycle order."""
   629	    rhs_by_sorted_triple = {
   630	        tuple(sorted(check["vars"])): check["rhs"] for check in inst["checks"]
   631	    }
   632	    candidates = []
   633	    for first in (0, 1):
   634	        for second in (0, 1):
   635	            candidate = [0] * inst["n"]
   636	            candidate[0], candidate[1] = first, second
   637	            for index in range(inst["n"] - 2):
   638	                key = (index, index + 1, index + 2)
   639	                rhs = rhs_by_sorted_triple.get(key, 0)
   640	                candidate[index + 2] = rhs ^ candidate[index] ^ candidate[index + 1]
   641	            candidates.append(candidate)
   642	    return min(candidates, key=lambda value: _weighted_unsatisfied(inst, value))
