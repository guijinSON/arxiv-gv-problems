   529	def canonical_key(inst):
   530	    """Canonical cyclic multiplicity word, invariant under gadget relabelling.
   531	
   532	    Parity right-hand sides are intentionally absent: because the coefficient
   533	    matrix is invertible, complementing variable gadgets carries any right-hand
   534	    side word to any other one.  Those graphs are genuinely isomorphic.
   535	    """
   536	    order = _cycle_order(inst)
   537	    copies_by_triple = {
   538	        frozenset(check["vars"]): check["copies"] for check in inst["checks"]
   539	    }
   540	    word = []
   541	    n = len(order)
   542	    for index in range(n):
   543	        triple = frozenset((
   544	            order[index], order[(index + 1) % n], order[(index + 2) % n]
   545	        ))
   546	        word.append(copies_by_triple[triple])
   547	    canonical = _least_dihedral_rotation(word)
   548	    payload = f"n={n};multiplicities=" + ",".join(map(str, canonical))
   549	    return "xor-cycle-v1:" + hashlib.sha256(payload.encode()).hexdigest()
   550	
