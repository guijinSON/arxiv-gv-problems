   192	        raise ValueError("seed must be an integer")
   193	
   194	    rng = random.Random(seed)
   195	    answer = [rng.getrandbits(1) for _ in range(n)]
   196	    # G2 needs a genuine swap corruption.  This conditioning is independent of
   197	    # public labels and excludes only the two constant strings.
   198	    if not any(answer):
   199	        answer[rng.randrange(n)] = 1
   200	    if all(answer):
