+    )
+    reference_ok, reference_reason = verify(shipping, scan_answer)
+
+    sample_total = 200000
+    sample_hits = 0
+    guess_rng = random.Random(181000203)
+    density_started = time.perf_counter()
+    for _ in range(sample_total):
