+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(planted)
+    intended_operations = _intended_operation_bound(shipping)
+    arms = {
+        key: dict(ORACLE_ARM_RESULTS[key])
