+
+
+def _theta_matrix(theta: int, modulus: int):
+    # det(A_theta)=theta, tr(A_theta)=theta, hence tr^2/det=theta.
+    return [[0, modulus - 1], [theta % modulus, theta % modulus]]
+
+
+def _has_exact_projective_order(
+    theta: int,
+    modulus: int,
+    order: int,
+    prime_divisors: tuple[int, ...],
