+        "exact projective-order test by repeated squaring",
+        "exact finite-field linear-factor decoding",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The squared-trace-over-determinant parameters of powers of one "
+        "projective element follow a second-order trace recurrence, avoiding "
+        "a scan of the whole field."
+    ),
+    "hardness_basis": (
+        "Track B: the Section 3 exact-order field scan costs "
+        "O(p * omega(k) * log k) exact matrix operations and measured "
+        "15,359,104 modular scalar operations (2.31 s) at the hard shipping "
+        "audit instance, whereas the Section 4 coprime-power recurrence takes "
+        "at most 110 exact arithmetic operations."
+    ),
+    "max_answer_tokens": 34,
+}
+
+
+NATIVE = {
