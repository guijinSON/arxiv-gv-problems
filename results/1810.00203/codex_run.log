   604	def enumerate_all(inst: dict):
   605	    space = search_space(inst)
   606	    if space > 100000:
   607	        return None
   608	    valid = 0
   609	    for roots in itertools.combinations(
   610	        range(1, inst["p"]), inst["factor_count"]
   611	    ):
   612	        valid += int(verify(inst, _factors_from_roots(roots, inst["p"]))[0])
   613	    return valid
