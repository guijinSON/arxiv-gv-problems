   203	
   204	def _prime_divisors(value: int) -> tuple[int, ...]:
   205	    factors = []
   206	    divisor = 2
   207	    remaining = value
   208	    while divisor * divisor <= remaining:
   209	        if remaining % divisor == 0:
   210	            factors.append(divisor)
   211	            while remaining % divisor == 0:
   212	                remaining //= divisor
   213	        divisor = 3 if divisor == 2 else divisor + 2
   214	    if remaining > 1:
   215	        factors.append(remaining)
   216	    return tuple(factors)
   217	
   218	
   219	def _totient_from_factors(value: int, factors: tuple[int, ...]) -> int:
   220	    result = value
   221	    for prime in factors:
   222	        result = result // prime * (prime - 1)
   223	    return result
