+            result = _mat_mul(result, base, modulus)
+        base = _mat_mul(base, base, modulus)
+        exponent //= 2
+    return result
+
+
+def _mat_pow_count(matrix, exponent: int, modulus: int):
+    result = [[1, 0], [0, 1]]
+    base = matrix
+    multiplications = 0
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, base, modulus)
+            multiplications += 1
+        base = _mat_mul(base, base, modulus)
+        multiplications += 1
+        exponent //= 2
