+                + left[0][1] * right[1][0]
+            )
+            % modulus,
+            (
+                left[0][0] * right[0][1]
+                + left[0][1] * right[1][1]
+            )
+            % modulus,
+        ],
+        [
+            (
+                left[1][0] * right[0][0]
+                + left[1][1] * right[1][0]
