+        ],
+    }
+
+    # G9: transcript arms are patched after script-owned runs.  Under the
+    # current contract they are diagnostic; only the measured caps gate.
+    answer_blob = json.dumps(planted, separators=(",", ":"))
+    answer_chars = len(answer_blob)
