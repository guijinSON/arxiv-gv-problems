   741	def _intended_operation_bound(inst: dict) -> int:
   742	    # 8 field operations form tr^2/det, two per recurrence step, one negation
   743	    # per factor, and a conservative insertion-sort comparison budget.
   744	    recurrence = 2 * max(0, inst["compact_largest_exponent"] - 1)
   745	    m = inst["factor_count"]
   746	    return 8 + recurrence + m + m * (m - 1) // 2
