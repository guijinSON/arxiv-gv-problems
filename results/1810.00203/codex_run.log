+    # The admissible polynomial language depends on p, k and m only.  All
+    # reference matrices of exact order k are route-equivalent auxiliary data.
+    return json.dumps(
+        ["hecke_januarial_trace_parameters", inst["p"], inst["k"], inst["factor_count"]],
