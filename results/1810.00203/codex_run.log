   667	def _attack_candidates(inst: dict, rng: random.Random):
   668	    p = inst["p"]
   669	    m = inst["factor_count"]
   670	    theta0 = _matrix_invariant(inst["reference_matrix"], p)
   671	
   672	    smallest = list(range(1, m + 1))
   673	    neighbourhood = []
   674	    step = 0
   675	    while len(neighbourhood) < m:
   676	        value = (theta0 + step) % p
   677	        if value and value not in neighbourhood:
   678	            neighbourhood.append(value)
   679	        step += 1
   680	
   681	    ordinary_powers = []
   682	    exponent = 1
   683	    while len(ordinary_powers) < m and exponent < p:
   684	        value = pow(theta0, exponent, p)
   685	        if value and value not in ordinary_powers:
   686	            ordinary_powers.append(value)
   687	        exponent += 1
   688	
   689	    attacks = {
   690	        "outlier_smallest_parameters": _candidate_from_roots(inst, smallest),
   691	        "greedy_seed_neighbourhood": _candidate_from_roots(inst, neighbourhood),
   692	        "ordinary_field_power_ansatz": _candidate_from_roots(inst, ordinary_powers),
   693	    }
   694	
   695	    last = None
   696	    solved = False
   697	    for _ in range(256):
   698	        last = random_candidate(inst, rng)
   699	        if verify(inst, last)[0]:
   700	            solved = True
   701	            break
   702	    attacks["random_restart_256"] = (last, solved)
   703	    return attacks
