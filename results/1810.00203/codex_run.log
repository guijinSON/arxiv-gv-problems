+
+def escalate(params: dict):
+    """Grow the field and seed spacing while preserving twelve factors."""
+    harder = dict(params)
+    current_n = int(harder.get("n", 1009))
+    current_stride = int(harder.get("seed_stride", 4))
+    if current_n >= 2**60:
+        return None
