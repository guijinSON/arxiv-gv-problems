   k,node,pdat,c=out;chain.append(node);counts.append(c);return k,pdat[0],chain,counts
  lo=max(2,q//8);hi=(q-1)//2
  q,node,_,c=nextprime(q,rng,lo,hi,False);chain.append(node);counts.append(c)
for bits in (64,96,128,160,192):
