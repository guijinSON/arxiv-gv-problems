   638	def _reference_scan(inst: dict):
   639	    """Section-3-style field scan, with transparent exact-operation counts."""
   640	    p = inst["p"]
   641	    k = inst["k"]
   642	    divisors = tuple(inst["prime_divisors_of_k"])
   643	    started = time.perf_counter()
   644	    valid = []
   645	    matrix_multiplications = 0
   646	    for theta in range(1, p):
   647	        ok, count = _exact_order_with_count(theta, p, k, divisors)
   648	        matrix_multiplications += count
   649	        if ok:
   650	            valid.append(theta)
   651	    elapsed = time.perf_counter() - started
   652	    # Each 2-by-2 product evaluates four entries, each with two scalar
   653	    # multiplications, one addition, and one modular reduction.
   654	    modular_scalar_operations = 16 * matrix_multiplications
   655	    return tuple(valid), {
   656	        "wall_clock_sec": elapsed,
   657	        "parameters_scanned": p - 1,
   658	        "matrix_multiplications": matrix_multiplications,
   659	        "modular_scalar_operations": modular_scalar_operations,
   660	    }
