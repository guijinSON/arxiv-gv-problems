   288	
   289	def _theta_matrix(theta: int, modulus: int):
   290	    # det(A_theta)=theta, tr(A_theta)=theta, hence tr^2/det=theta.
   291	    return [[0, modulus - 1], [theta % modulus, theta % modulus]]
   292	
   293	
   294	def _has_exact_projective_order(
   295	    theta: int,
   296	    modulus: int,
   297	    order: int,
   298	    prime_divisors: tuple[int, ...],
   299	) -> bool:
   300	    if not isinstance(theta, int) or isinstance(theta, bool):
   301	        return False
   302	    if theta <= 0 or theta >= modulus:
   303	        return False
   304	    matrix = _theta_matrix(theta, modulus)
   305	    if not _is_scalar(_mat_pow(matrix, order, modulus), modulus):
   306	        return False
   307	    return all(
   308	        not _is_scalar(_mat_pow(matrix, order // prime, modulus), modulus)
   309	        for prime in prime_divisors
   310	    )
   311	
   312	
   313	def _exact_order_with_count(
   314	    theta: int,
   315	    modulus: int,
   316	    order: int,
   317	    prime_divisors: tuple[int, ...],
   318	):
   319	    matrix = _theta_matrix(theta, modulus)
   320	    power, matrix_multiplications = _mat_pow_count(matrix, order, modulus)
   321	    if not _is_scalar(power, modulus):
   322	        return False, matrix_multiplications
   323	    for prime in prime_divisors:
   324	        power, count = _mat_pow_count(matrix, order // prime, modulus)
   325	        matrix_multiplications += count
   326	        if _is_scalar(power, modulus):
   327	            return False, matrix_multiplications
   328	    return True, matrix_multiplications
