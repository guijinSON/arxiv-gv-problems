   400	def make_instance(
   401	    n: int,
   402	    seed: int = 0,
   403	    factor_count: int = 12,
   404	    seed_slots: int = 256,
   405	    seed_stride: int = 16,
   406	) -> dict:
   407	    """Build a root certificate from coprime powers of a known PGL element."""
   408	    if not isinstance(n, int) or isinstance(n, bool) or n < 5:
   409	        raise ValueError("n must be an integer at least 5")
   410	    if (
   411	        not isinstance(factor_count, int)
   412	        or isinstance(factor_count, bool)
   413	        or factor_count < 1
   414	        or factor_count > 12
   415	    ):
   416	        raise ValueError("factor_count must be an integer from 1 through 12")
   417	    if not isinstance(seed_slots, int) or seed_slots < 1:
   418	        raise ValueError("seed_slots must be positive")
   419	    if not isinstance(seed_stride, int) or seed_stride < 1:
   420	        raise ValueError("seed_stride must be positive")
   421	
   422	    modulus, order, order_factors = _find_modulus(
   423	        n, seed, factor_count, seed_slots, seed_stride
   424	    )
   425	    rng = random.Random(seed)
   426	
   427	    # Inverse generation: choose and certify the reference object before the
   428	    # problem is exposed.  The requested roots are then transported from it.
   429	    seed_parameter = None
   430	    trials = 0
   431	    while seed_parameter is None:
   432	        trials += 1
   433	        if trials > 100000:
   434	            raise RuntimeError("could not sample a reference projective element")
   435	        candidate = rng.randrange(1, modulus)
   436	        if _has_exact_projective_order(
   437	            candidate, modulus, order, order_factors
   438	        ):
   439	            seed_parameter = candidate
   440	
   441	    reference_matrix = _theta_matrix(seed_parameter, modulus)
   442	    roots, largest_exponent = _coprime_power_parameters(
   443	        seed_parameter, modulus, order, factor_count
   444	    )
   445	    answer = _factors_from_roots(roots, modulus)
   446	
   447	    return {
   448	        "family": "hecke_januarial_trace_parameters",
   449	        "size_parameter": n,
   450	        "p": modulus,
   451	        "k": order,
   452	        "prime_divisors_of_k": list(order_factors),
   453	        "factor_count": factor_count,
   454	        "reference_matrix": reference_matrix,
   455	        "construction_trials": trials,
   456	        "compact_largest_exponent": largest_exponent,
   457	        "answer": answer,
   458	    }
