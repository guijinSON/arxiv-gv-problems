   511	def _decode_json_fragment(fragment: str):
   512	    candidate = fragment.strip()
   513	    fence = re.fullmatch(
   514	        r"```(?:json)?\s*(.*?)\s*```", candidate, re.DOTALL | re.I
   515	    )
   516	    if fence:
   517	        candidate = fence.group(1).strip()
   518	    try:
   519	        return json.loads(candidate)
   520	    except (TypeError, ValueError):
   520	    except (TypeError, ValueError):
   521	        return None
   522	
   523	
   524	def parse_answer(text: str):
   525	    """Parse tagged/fenced JSON or a JSON list surrounded by prose."""
   526	    if not isinstance(text, str):
   527	        return None
   528	    tagged = re.findall(r"<answer>(.*?)</answer>", text, re.DOTALL | re.I)
   529	    if tagged:
   530	        return _decode_json_fragment(tagged[-1])
   531	
   532	    fenced = re.findall(r"```(?:json)?\s*(.*?)\s*```", text, re.DOTALL | re.I)
   533	    for fragment in reversed(fenced):
   534	        parsed = _decode_json_fragment(fragment)
   535	        if parsed is not None:
   536	            return parsed
   537	
   538	    decoder = json.JSONDecoder()
   539	    for match in re.finditer(r"\[", text):
   540	        try:
   541	            parsed, _ = decoder.raw_decode(text[match.start() :])
   542	        except ValueError:
   543	            continue
   544	        if isinstance(parsed, list):
   545	            return parsed
   546	    return None
