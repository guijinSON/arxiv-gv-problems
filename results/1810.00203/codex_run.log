   226	def _mat_mul(left, right, modulus: int):
   227	    return [
   228	        [
   229	            (
   230	                left[0][0] * right[0][0]
   231	                + left[0][1] * right[1][0]
   232	            )
   233	            % modulus,
   234	            (
   235	                left[0][0] * right[0][1]
   236	                + left[0][1] * right[1][1]
   237	            )
   238	            % modulus,
   239	        ],
   240	        [
   241	            (
   242	                left[1][0] * right[0][0]
   243	                + left[1][1] * right[1][0]
   244	            )
   245	            % modulus,
   246	            (
   247	                left[1][0] * right[0][1]
   248	                + left[1][1] * right[1][1]
   249	            )
   250	            % modulus,
   251	        ],
   252	    ]
   253	
   254	
   255	def _mat_pow(matrix, exponent: int, modulus: int):
   256	    result = [[1, 0], [0, 1]]
   257	    base = matrix
   258	    while exponent:
   259	        if exponent & 1:
   260	            result = _mat_mul(result, base, modulus)
   261	        base = _mat_mul(base, base, modulus)
   262	        exponent //= 2
   263	    return result
   264	
   265	
   266	def _mat_pow_count(matrix, exponent: int, modulus: int):
   267	    result = [[1, 0], [0, 1]]
   268	    base = matrix
   269	    multiplications = 0
   270	    while exponent:
   271	        if exponent & 1:
   272	            result = _mat_mul(result, base, modulus)
   273	            multiplications += 1
   274	        base = _mat_mul(base, base, modulus)
   275	        multiplications += 1
   276	        exponent //= 2
   277	    return result, multiplications
   278	
   279	
   280	def _is_scalar(matrix, modulus: int) -> bool:
   281	    return (
   282	        matrix[0][1] % modulus == 0
   283	        and matrix[1][0] % modulus == 0
   284	        and (matrix[0][0] - matrix[1][1]) % modulus == 0
   285	        and matrix[0][0] % modulus != 0
   286	    )
