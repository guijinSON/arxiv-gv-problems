   706	def _matrix_det(matrix, p: int) -> int:
   707	    return (
   708	        matrix[0][0] * matrix[1][1] - matrix[0][1] * matrix[1][0]
   709	    ) % p
   710	
   711	
   712	def _matrix_inverse(matrix, p: int):
   713	    determinant = _matrix_det(matrix, p)
   714	    inverse_det = pow(determinant, -1, p)
   715	    return [
   716	        [matrix[1][1] * inverse_det % p, -matrix[0][1] * inverse_det % p],
   717	        [-matrix[1][0] * inverse_det % p, matrix[0][0] * inverse_det % p],
   718	    ]
   719	
   720	
   721	def _conjugate(matrix, change, p: int):
   722	    return _mat_mul(_mat_mul(change, matrix, p), _matrix_inverse(change, p), p)
