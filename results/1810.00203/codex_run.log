   184	    d = value - 1
   185	    shifts = 0
   186	    while d % 2 == 0:
   187	        d //= 2
   188	        shifts += 1
   189	    for base in _MR_BASES_64:
   190	        if base % value == 0:
   191	            continue
   192	        x = pow(base, d, value)
   193	        if x in (1, value - 1):
   194	            continue
   195	        for _ in range(shifts - 1):
   196	            x = x * x % value
   197	            if x == value - 1:
   198	                break
   199	        else:
   200	            return False
   201	    return True
