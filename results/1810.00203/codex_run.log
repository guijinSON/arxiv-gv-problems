   330	
   331	def _matrix_invariant(matrix, modulus: int) -> int:
   332	    trace = (matrix[0][0] + matrix[1][1]) % modulus
   333	    determinant = (
   334	        matrix[0][0] * matrix[1][1] - matrix[0][1] * matrix[1][0]
   335	    ) % modulus
   336	    if determinant == 0:
   337	        raise ValueError("matrix must be invertible")
   338	    return trace * trace * pow(determinant, -1, modulus) % modulus
   339	
