   626	def escalate(params: dict):
   627	    """Grow the field and seed spacing while preserving twelve factors."""
   628	    harder = dict(params)
   629	    current_n = int(harder.get("n", 1009))
   630	    current_stride = int(harder.get("seed_stride", 4))
   631	    if current_n >= 2**60:
   632	        return None
   633	    harder["n"] = current_n * 4 + 1
   634	    harder["seed_stride"] = current_stride * 2
   635	    return harder
