   549	def verify(inst: dict, answer) -> tuple[bool, str]:
   550	    """Verify any polynomial in the language; never inspect inst['answer']."""
   551	    if not isinstance(answer, list):
   552	        return False, "answer must be a JSON list of linear factors"
   553	    if not answer:
   554	        return False, "factor list is empty"
   555	    expected = inst["factor_count"]
   556	    if len(answer) != expected:
   557	        return False, f"wrong number of factors: expected {expected}"
   558	
   559	    p = inst["p"]
   560	    roots = []
   561	    for factor in answer:
   562	        if not isinstance(factor, list) or len(factor) != 2:
   563	            return False, "each factor must be a two-entry list [1,c]"
   564	        leading, constant = factor
   565	        if (
   566	            not isinstance(leading, int)
   567	            or isinstance(leading, bool)
   568	            or not isinstance(constant, int)
   569	            or isinstance(constant, bool)
   570	        ):
   571	            return False, "factor coefficients must be integers"
   572	        if leading != 1:
   573	            return False, "every linear factor must be monic"
   574	        if constant < 0 or constant >= p:
   575	            return False, "factor coefficient is outside the canonical field range"
   576	        root = (-constant) % p
   577	        if root == 0:
   578	            return False, "decoded roots must be nonzero"
   579	        roots.append(root)
   580	
   581	    if len(set(roots)) != len(roots):
   582	        return False, "decoded roots must be pairwise distinct"
   583	    if roots != sorted(roots):
   584	        return False, "factors are not ordered by increasing decoded root"
   585	
   586	    k = inst["k"]
   587	    order_factors = tuple(inst["prime_divisors_of_k"])
   588	    for root in roots:
   589	        if not _has_exact_projective_order(root, p, k, order_factors):
   590	            return False, f"decoded root {root} is not admissible"
   591	    return True, "ok"
