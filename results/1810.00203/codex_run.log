   341	def _find_modulus(
   342	    n: int,
   343	    seed: int,
   344	    factor_count: int,
   345	    seed_slots: int,
   346	    seed_stride: int,
   347	):
   348	    start = n + (seed % seed_slots) * seed_stride
   349	    candidate = max(5, start)
   350	    if candidate % 2 == 0:
   351	        candidate += 1
   352	    while candidate < 2**63:
   353	        if _is_prime(candidate):
   354	            order = (candidate + 1) // 2
   355	            factors = _prime_divisors(order)
   356	            if (
   357	                order not in (1, 2, 6)
   358	                and _totient_from_factors(order, factors) // 2 >= factor_count
   359	            ):
   360	                return candidate, order, factors
   361	        candidate += 2
   362	    raise ValueError("no supported 64-bit prime found")
   363	
   364	
   365	def _coprime_power_parameters(
   366	    theta: int,
   367	    modulus: int,
   368	    order: int,
   369	    factor_count: int,
   370	):
   371	    """Transport theta through the first small coprime powers.
   372	
   373	    If w is the eigenvalue ratio, theta=w+w^-1+2.  Thus c_e=theta_e-2
   374	    satisfies c_0=2, c_1=theta-2, c_(e+1)=(theta-2)c_e-c_(e-1).
   375	    """
   376	    trace_ratio = (theta - 2) % modulus
   377	    previous = 2 % modulus
   378	    current = trace_ratio
   379	    roots = []
   380	    exponent = 1
   381	    while len(roots) < factor_count:
   382	        if math.gcd(exponent, order) == 1:
   383	            value = (current + 2) % modulus
   384	            if value and value not in roots:
   385	                roots.append(value)
   386	        exponent += 1
   387	        previous, current = (
   388	            current,
   389	            (trace_ratio * current - previous) % modulus,
   390	        )
   391	        if exponent >= order:
   392	            raise ValueError("not enough distinct coprime-power parameters")
   393	    return roots, exponent - 1
   394	
   395	
   396	def _factors_from_roots(roots, modulus: int):
   397	    return [[1, (-root) % modulus] for root in sorted(roots)]
   398	
