   749	def selftest() -> dict:
   750	    report = {}
   751	
   752	    # G1: all rungs, several seeds, exact verification, and JSON nativeness.
   753	    g1_checks = 0
   754	    g1_failures = []
   755	    for preset, params in DIFFICULTY.items():
   756	        for seed in (0, 1, 7, 99):
   757	            inst = make_instance(seed=seed, **params)
   758	            ok, reason = verify(inst, inst["answer"])
   759	            g1_checks += 1
   760	            if not ok:
   761	                g1_failures.append(f"{preset}/{seed}: {reason}")
   762	            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
   763	                g1_failures.append(f"{preset}/{seed}: answer is not JSON-native")
   764	    report["G1_planted_verifies"] = {
