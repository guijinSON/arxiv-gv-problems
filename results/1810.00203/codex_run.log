  if both:
   P=2*N-1
   if not probable(P):continue
   wp=witness(P,q)
   if wp is None:continue
   return N,(q,w,a),(P,wp),tested
  return N,(q,w,a),None,tested
 raise RuntimeError

def gen(bits,seed):
