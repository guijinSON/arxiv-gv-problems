/bin/bash -lc "PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'
import json, os, random
import gen_1810_00203 as g
r=g.selftest()
on_disk=json.load(open('selftest_report.json'))
assert r['all_passed']
assert on_disk['all_passed']
for gate in ('G1_planted_verifies','G2_rejects_corruption','G3_round_trip','G4_guess_resistance','G5_density_and_baseline','G6_adversary_panel','G7_scales','G8_canonical_key','G9_no_tool_suitability'):
    assert r[gate]['pass'] and on_disk[gate]['pass'], gate
assert r['G9_no_tool_suitability']['intended_route_operations']==190
assert r['G9_no_tool_suitability']['answer_chars']==121
assert on_disk['G9_no_tool_suitability']['shipping_seed_slots_audited']==256
params=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
a=g.make_instance(seed=123456,**params)
b=g.make_instance(seed=123456,**params)
assert a==b
assert json.loads(json.dumps(a['answer']))==a['answer']
assert 'Hint:' not in g.render(a)
for mode,hint in [('structural',g.STRUCTURAL_HINT),('placebo',g.PLACEBO_HINT)]:
    os.environ['GV_HINT_MODE']=mode
    assert g.render(a).endswith(hint)
os.environ.pop('GV_HINT_MODE',None)
for s in range(100):
    c=g.random_candidate(a,random.Random(s))
    assert isinstance(g.verify(a,c),tuple)
print('verified: local gates, report schema, determinism, JSON, hint modes, candidate fuzz')
