   594	def random_candidate(inst: dict, rng: random.Random):
   595	    """Uniformly sample the obvious distinct/sorted split-polynomial space."""
   596	    roots = rng.sample(range(1, inst["p"]), inst["factor_count"])
   597	    return _factors_from_roots(roots, inst["p"])
