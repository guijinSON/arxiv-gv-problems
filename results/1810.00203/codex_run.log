\end{equation*}%
and equation $\left( \ref{t01}\right) $ becomes%
\begin{eqnarray}
N &=&\left\vert N_{k}\right\vert -\sum_{i=1}^{s}\left\vert
N_{k/p_{i}}\right\vert +\sum_{1\leq i<j\leq s}\left\vert
N_{k/p_{i}p_{j}}\right\vert -  \label{t2} \\
&&\sum_{1\leq i<j<l\leq s}\left\vert
