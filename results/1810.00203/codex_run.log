+        os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    ),
+)
+try:
+    from gvlib import exact_matrices  # noqa: F401
+except ImportError:  # pragma: no cover - documented graceful fallback
+    exact_matrices = None
+
+
+TRACK = "B"
+
+
