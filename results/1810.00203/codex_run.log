+
+    # G6: four no-tool attacks fail; the exact scan succeeds separately.
+    attack_names = (
+        "outlier_smallest_parameters",
+        "greedy_seed_neighbourhood",
+        "random_restart_256",
+        "ordinary_field_power_ansatz",
