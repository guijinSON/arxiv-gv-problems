+        "invariance_checks": invariant_checks,
+        "witness_transport_checks": witness_transport_checks,
+        "invariance_failures": invariant_failures,
+        "unrelated_distinct": len(set(distinct_keys)),
+        "unrelated_attempts": 20,
+        "transformations": [
