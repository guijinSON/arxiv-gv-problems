s}(k/p_{i}p_{j})-\sum_{1\leq i<j<l\leq s}(k/p_{i}p_{j}p_{l}) \\ 
+\cdots +(-1)^{s}(k/p_{1}p_{2}\cdots p_{s}) \\ 
-\binom{s}{0}+\binom{s}{1}-\binom{s}{2}+\binom{s}{3}-\cdots +(-1)^{s+1}%
\binom{s}{s}%
\end{array}%
\right] .  \label{t4}
\end{equation}%
Since 
\begin{equation}
\binom{s}{0}-\binom{s}{1}+\binom{s}{2}-\binom{s}{3}+\cdots +(-1)^{s+1}\binom{%
s}{s}=0  \label{t5}
\end{equation}%
therefore using $\left( \ref{t5}\right) $ in equation $\left( \ref{t4}%
\right) $ we get%
\begin{equation*}
N=\frac{1}{2}\left[ 
\begin{array}{c}
k-\sum_{i=1}^{s}k/p_{i}+\sum_{1\leq i<j\leq
s}(k/p_{i}p_{j})-\sum_{1\leq i<j<l\leq s}(k/p_{i}p_{j}p_{l}) \\ 
+\cdots +(-1)^{s}(k/p_{1}p_{2}\cdots p_{s})%
\end{array}%
\right] .
