+    shifts = 0
+    while d % 2 == 0:
+        d //= 2
+        shifts += 1
+    for base in _MR_BASES_64:
+        if base % value == 0:
+            continue
+        x = pow(base, d, value)
+        if x in (1, value - 1):
+            continue
