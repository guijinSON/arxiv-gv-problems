+    # G3: prose and a Markdown fence surround the tagged wire format.
+    model_style = (
+        "I balanced the capacity and recomputed the score.\n```text\n"
+        f"<answer>{_format_answer(planted)}</answer>\n```\nThis is the improving flip."
+    )
