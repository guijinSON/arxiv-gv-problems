+        "pass": not invariant_failures and real_transform_checks == 40 and len(unrelated_keys) == 24,
+        "invariance_checks_passed": invariant_checks - len(invariant_failures),
+        "invariance_checks_total": invariant_checks,
+        "real_transformation_verifications": f"{real_transform_checks}/40",
+        "distinct_unrelated_keys": f"{len(unrelated_keys)}/24",
+        "transformations": ["input-row permutation", "arbitrary item-ID permutation", "their composition"],
+        "failures": invariant_failures,
