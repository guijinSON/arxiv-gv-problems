+            attack_reasons[name].append(reason)
+    attack_rows = {
+        name: {
+            "successes": successes,
+            "seeds": len(attack_seeds),
+            "failed_all": successes == 0,
+            "reasons": sorted(set(attack_reasons[name])),
+        }
