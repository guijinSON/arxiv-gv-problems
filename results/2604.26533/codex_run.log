  mean=sum(x)/n;x=[v-mean for v in x]
  y=[C*x[i]-sum(w*x[j] for j,w in A[i].items()) for i in range(n)]
  mean=sum(y)/n;y=[v-mean for v in y]
  norm=math.sqrt(sum(v*v for v in y));x=[v/norm for v in y]
 # threshold zero/median candidates, greedy improve #mono clauses
 for mode in range(2):
  if mode==0:ans=[int(v>0) for v in x]
  else:
   med=sorted(x)[n//2];ans=[int(v>med) for v in x]
  # local descent flip that reduces mono count
  inc=[[]for _ in range(n)]
  for ci,c in enumerate(cs):
   for v in c:inc[v].append(ci)
