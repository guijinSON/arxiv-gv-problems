     c=cs[ci]; vals=[ans[z] for z in c];before+=len(set(vals))==1
     vals=[(1-ans[z] if z==v else ans[z]) for z in c];after+=len(set(vals))==1
    if after<before:ans[v]"'^=1;changed=True
   if not changed:break
  if all(len({ans[v] for v in c})>1 for c in cs):return ans
 return None
for ratio in (1.9,2.05,2.2,2.5,3):
 ok=cor=0
 print('"'ratio',ratio)
 for s in range(8):
  cs,t=gen(240,ratio,s);st=time.perf_counter();a=spectral(240,cs,s);dt=time.perf_counter()-st
  good=a is not None; ok+=good
  if good:cor+=max(sum(x==y for x,y in zip(a,t)),sum(x"'!=y for x,y in zip(a,t)))/240
  print(s,good,round(dt,3),None if not good else round(max(sum(x==y for x,y in zip(a,t)),sum(x!=y for x,y in zip(a,t)))/240,3))
