import random,time,collections

def gen(n,ratio,seed):
 r=random.Random(seed);tau=[0]*(n//2)+[1]*(n-n//2);r.shuffle(tau)
 if tau[0]:tau=[1-x for x in tau]
 if not tau[1]:
  j=next(j for j in range(2,n) if tau[j]);tau[1],tau[j]=tau[j],tau[1]
 cs=set()
 while len(cs)<round(n*ratio):
  c=tuple(sorted(r.sample(range(n),3)))
  if len({tau[x] for x in c})>1:cs.add(c)
 return list(cs)

def dpll(n,clauses,cap=20000):
 occ=[[]for _ in range(n)]
 for ci,c in enumerate(clauses):
  for v in c:occ[v].append(ci)
 order=sorted(range(n),key=lambda x:-len(occ[x]));nodes=checks=0
 def prop(a,qs):
  nonlocal checks
  q=collections.deque(qs);inq=set(qs)
  while q:
   ci=q.popleft();inq.discard(ci);checks+=1;c=clauses[ci];vals=(a[c[0]],a[c[1]],a[c[2]])
   if vals[0]>=0 and vals[0]==vals[1]==vals[2]:return False
   if vals.count(-1)==1:
    k=vals.index(-1);others=[vals[z] for z in range(3) if z"'!=k]
    if others[0]==others[1]:
     u=c[k];want=1-others[0]
     if a[u]>=0:
      if a[u]!=want:return False
     else:
      a[u]=want
      for cj in occ[u]:
       if cj not in inq:q.append(cj);inq.add(cj)
  return True
 def rec(a):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  v=next((x for x in order if a[x]<0),None)
  if v is None:return True
  for x in (0,1):
   b=a.copy();b[v]=x
   if prop(b,occ[v]):
    z=rec(b)
    if z:return True
    if z is None:return None
  return False
 a=[-1]*n;a[0]=0;st=time.perf_counter();z=rec(a);return z,nodes,checks,time.perf_counter()-st
for ratio in (2.1,2.2,2.3,2.4,2.5,2.7,3.0):
 rows=[]
 for seed in range(1000,1008):rows.append(dpll(240,gen(240,ratio,seed)))
 print(ratio,[(z[0],z[1],round(z[3],2)) for z in rows],flush=True)
