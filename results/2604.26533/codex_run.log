# Same simple propagation DPLL, one n=240 near-threshold planted instance per process.
import random,time,sys
n=240; ratio=2.05; seed=int(sys.argv[1]) if len(sys.argv)>1 else 0
r=random.Random(seed); tau=[r.randrange(2) for _ in range(n)]; cs=set()
while len(cs)<int(n*ratio):
 c=tuple(sorted(r.sample(range(n),3)))
 if len({tau[x] for x in c})>1:cs.add(c)
clauses=list(cs); asn=[-1]*n;occ=[[]for _ in range(n)]
for ci,c in enumerate(clauses):
 for v in c:occ[v].append(ci)
nodes=checks=0;cap=200000;deadline=time.perf_counter()+25

def rec():
 global nodes,checks
 nodes+=1
 if nodes>cap or time.perf_counter()>deadline:return None
 changed=[]
 while 1:
  forced=None
  for c in clauses:
   checks+=1; a,b,d=(asn[v] for v in c)
   if a>=0 and a==b==d:
    for v in reversed(changed):asn[v]=-1
    return False
   us=[v for v in c if asn[v]<0];ks=[asn[v] for v in c if asn[v]>=0]
   if len(us)==1 and ks[0]==ks[1]:forced=(us[0],1-ks[0]);break
  if forced is None:break
  v,x=forced
  if asn[v]>=0:
   if asn[v]"'!=x:
    for w in reversed(changed):asn[w]=-1
    return False
  else:asn[v]=x;changed.append(v)
 if all(x>=0 for x in asn):return True
 v=max((v for v in range(n) if asn[v]<0),key=lambda z:len(occ[z]))
 for x in (0,1):
  asn[v]=x;got=rec()
  if got:return True
  if got is None:
   asn[v]=-1
   for w in reversed(changed):asn[w]=-1
   return None
 asn[v]=-1
 for w in reversed(changed):asn[w]=-1
 return False
st=time.perf_counter();ok=rec();print({'"'ok':ok,'nodes':nodes,'checks':checks,'sec':time.perf_counter()-st},flush=True)
