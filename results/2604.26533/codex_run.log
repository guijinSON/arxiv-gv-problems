import random,time

def gen(n,m,seed):
 r=random.Random(seed); tau=[r.randrange(2) for _ in range(n)]; cs=set()
 while len(cs)<m:
  c=tuple(sorted(r.sample(range(n),3)))
  if len({tau[x] for x in c})>1: cs.add(c)
 return list(cs),tau

def solve(n,clauses,cap=2000000):
 asn=[-1]*n; occ=[[] for _ in range(n)]
 for ci,c in enumerate(clauses):
  for v in c:occ[v].append(ci)
 nodes=checks=props=0
 def rec():
  nonlocal nodes,checks,props
  nodes+=1
  if nodes>cap:return None
  changed=[]
  while True:
   forced=None
   for c in clauses:
    checks+=1
    vals=[asn[v] for v in c]
    if vals[0]>=0 and vals[0]==vals[1]==vals[2]:
     for v in reversed(changed):asn[v]=-1
     return False
    us=[v for v in c if asn[v]<0]
    ks=[asn[v] for v in c if asn[v]>=0]
    if len(us)==1 and len(ks)==2 and ks[0]==ks[1]:forced=(us[0],1-ks[0]);break
   if forced is None:break
   v,x=forced
   if asn[v]>=0:
    if asn[v]"'!=x:
     for w in reversed(changed):asn[w]=-1
     return False
   else:asn[v]=x;changed.append(v);props+=1
  if all(x>=0 for x in asn):return True
  v=max((v for v in range(n) if asn[v]<0),key=lambda z:len(occ[z]))
  for x in (0,1):
   asn[v]=x;got=rec()
   if got:return True
   if got is None:
    asn[v]=-1
    for w in reversed(changed):asn[w]=-1
    return None
  asn[v]=-1
  for w in reversed(changed):asn[w]=-1
  return False
 t=time.perf_counter();ok=rec();dt=time.perf_counter()-t
 return ok,nodes,checks,props,dt
for ratio in (1.7,1.9,2.05,2.2,2.5,3.0,4.0):
 print('"'ratio',ratio)
 for s in range(4):
  c,t=gen(240,int(240*ratio),s); z=solve(240,c);print(s,z[1:])
