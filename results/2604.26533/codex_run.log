  if len({tau[x] for x in c})>1:cs.add(c)
 return list(cs),tau

def dpll(n,clauses,cap):
 occ=[[]for _ in range(n)]
 for ci,c in enumerate(clauses):
  for v in c:occ[v].append(ci)
 order=sorted(range(n),key=lambda x:-len(occ[x]));nodes=checks=props=0
 def prop(a,qs):
  nonlocal checks,props
  q=collections.deque(qs);inq=set(qs)
  while q:
   ci=q.popleft();inq.discard(ci);checks+=1;c=clauses[ci];v=[a[x] for x in c]
