import random,time,statistics

def make(n,seed):
 r=random.Random(seed)
 # Random recursive tree, then a random relabeling. Trees are planar and contain no cycles.
 e=[(v,r.randrange(v)) for v in range(1,n)]
 p=list(range(n)); r.shuffle(p)
 return [(p[a],p[b]) for a,b in e]

def bfs_partition(n,edges):
 adj=[[] for _ in range(n)]; ops=0
 for u,v in edges: adj[u].append(v);adj[v].append(u);ops+=2
 col=[-1]*n
 for s in range(n):
  if col[s]>=0: continue
  col[s]=0; q=[s]; h=0; ops+=1
  while h<len(q):
   u=q[h];h+=1
   for v in adj[u]:
    ops+=1
    if col[v]<0: col[v]=1-col[u];q.append(v);ops+=1
 return col,ops

def verify(n,edges,a):
 deg=[0]*n
 for u,v in edges:
  if a[u]==0 and a[v]==0:return False
  if a[u]==3 and a[v]==3:deg[u]+=1;deg[v]+=1
 return max(deg,default=0)<=3
for n in (64,128,256):
 ts=[];ops=[];ok=0
 for seed in range(20):
  e=make(n,seed);t=time.perf_counter(); c,o=bfs_partition(n,e);ts.append(time.perf_counter()-t);ops.append(o)
  a=[0 if x==0 else 3 for x in c];ok+=verify(n,e,a)
 print(n,'solved',ok,'/20','ops',min(ops),statistics.median(ops),max(ops),'sec median',format(statistics.median(ts),'.9f'),'max',format(max(ts),'.9f'))
