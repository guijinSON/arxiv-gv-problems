+def _random_positive_det_matrix(rng: random.Random, bits: int) -> list[list[int]]:
+    lo = 1 << max(0, bits - 1)
+    hi = 1 << bits
+    while True:
+        values = [
+            rng.randrange(lo, hi) * (-1 if rng.randrange(2) else 1)
+            for _ in range(4)
+        ]
