+    span = q_max - q_min
+    if span <= 0 or span % (n - 1):
+        return None
+    step = span // (n - 1)
+    magnitudes = []
+    for value in q:
+        offset = value - q_min
+        if offset % step:
+            return None
+        rank = offset // step + 1
+        magnitudes.append(n + 1 - rank)
+    if sorted(magnitudes) != list(range(1, n + 1)):
+        return None
