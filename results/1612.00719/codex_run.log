+def _decode_magnitudes(inst: dict) -> list[int]:
+    n = inst["n"]
+    order = sorted(range(n), key=lambda i: inst["quadratic"][i])
+    magnitudes = [0] * n
+    for rank, coordinate in enumerate(order, 1):
+        magnitudes[coordinate] = n + 1 - rank
+    return magnitudes
+
