-def _rank_at_least_three(rows: list[list[int]]) -> bool:
-    if len(rows) != 3:
-        return False
-    size = len(rows[0])
-    a, b, c = rows
-    for i in range(size - 2):
-        for j in range(i + 1, size - 1):
-            for k in range(j + 1, size):
-                det = (
-                    a[i] * (b[j] * c[k] - b[k] * c[j])
-                    - a[j] * (b[i] * c[k] - b[k] * c[i])
-                    + a[k] * (b[i] * c[j] - b[j] * c[i])
-                )
-                if det:
-                    return True
-    return False
