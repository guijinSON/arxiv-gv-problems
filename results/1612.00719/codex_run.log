+    upper_v = v[1] > 0 or (v[1] == 0 and v[0] > 0)
+    if upper_u != upper_v:
+        return -1 if upper_u else 1
+    determinant = _det2(u, v)
+    if determinant:
+        return -1 if determinant > 0 else 1
+    return 0
+
