+        if rng.randrange(2):
+            components.append(value - high)
+            high = value
+        else:
+            components.append(low - value)
+            low = value
+    components.extend((coordinates[-1] - high, low - coordinates[-1]))
+    assert len(components) == n and sum(components) == 0
+    return components
