+    terms: list[tuple[int, int]], indices: list[int]
+) -> tuple[list[tuple[int, int, int]], int]:
+    states = [(0, 0, 0)]
+    operations = 0
+    for bit, index in enumerate(indices):
+        a, b = terms[index]
+        expanded = []
+        for x, y, mask in states:
+            expanded.append((x + a, y + b, mask | (1 << bit)))
