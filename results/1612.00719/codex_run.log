+def _decode_magnitudes(inst: dict) -> list[int]:
+    n = inst["n"]
+    order = sorted(range(n), key=lambda i: inst["quadratic"][i])
+    magnitudes = [0] * n
+    for rank, coordinate in enumerate(order, 1):
+        magnitudes[coordinate] = n + 1 - rank
+    return magnitudes
+
+
+def _compact_decode(inst: dict) -> list[int] | None:
+    """The intended rearrangement-plus-determinant route, with no search."""
+
+    n = inst["n"]
+    q = inst["quadratic"]
+    q_min, q_max = min(q), max(q)
+    span = q_max - q_min
+    if span <= 0 or span % (n - 1):
+        return None
+    step = span // (n - 1)
+    magnitudes = []
+    for value in q:
+        offset = value - q_min
+        if offset % step:
+            return None
+        rank = offset // step + 1
+        magnitudes.append(n + 1 - rank)
+    if sorted(magnitudes) != list(range(1, n + 1)):
+        return None
+
+    coordinate = {magnitude: i for i, magnitude in enumerate(magnitudes)}
+    points = list(zip(inst["cubics"][0], inst["cubics"][1]))
+    a, b, c = coordinate[1], coordinate[2], coordinate[3]
+    dab = _det2(points[a], points[b])
+    dbc = _det2(points[b], points[c])
+    dca = _det2(points[c], points[a])
+    if not dab or not dbc or not dca:
+        return None
+    # For increasing base directions, sign(dab*dbc*dca) = -sign(det M):
+    # every planted column sign occurs twice and therefore cancels.
+    det_transform_sign = -1 if dab * dbc * dca > 0 else 1
+
+    relative = [0] * n
+    relative[a] = 1
+    for i, magnitude in enumerate(magnitudes):
+        if i == a:
+            continue
+        observed = _det2(points[a], points[i])
+        if observed == 0:
+            return None
+        base_sign = -1 if magnitude == n else 1
+        observed_sign = 1 if observed > 0 else -1
+        relative[i] = observed_sign * det_transform_sign * base_sign
+
+    # x_0 must be positive. Since relative[i] = sign_i/sign_a, this fixes
+    # the one remaining global choice sign_a.
+    sign_a = relative[0]
+    answer = [
+        magnitude * sign_a * relative[i]
+        for i, magnitude in enumerate(magnitudes)
+    ]
+    return answer if verify(inst, answer)[0] else None
+
