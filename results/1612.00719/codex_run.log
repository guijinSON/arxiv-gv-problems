new file mode 100644
index 0000000000000000000000000000000000000000..c5b55395d1f43dbe1fcb8542a7fe926eec838ba0
--- /dev/null
+++ b/gen_1612_00719.py
@@ -0,0 +1,960 @@
+"""Verified problem generator for arXiv:1612.00719.
+
+The paper studies simultaneous diagonal quadratic and cubic equations over the
+integers.  This module inverse-generates a nonsingular integral point first and
+then samples coefficient rows from the exact orthogonal lattices of its square
+and cube vectors.  No search for the planted witness is performed.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from typing import Callable
+
+
+TRACK = "A"
+
+PROBLEM_PROFILE = {
+    "native_domain": "number_theory",
+    "object_regime": "integer_lattice",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "one highly nonsingular quadratic diagonal form over Z",
+        "two highly nonsingular cubic diagonal forms over Z",
+        "bounded integral vector",
+    ],
+    "verification_operations": [
+        "exact integer exponentiation",
+        "exact integer multiplication",
+        "exact integer summation",
+        "signed-permutation comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "Even powers constrain the hidden magnitude permutation while odd powers "
+        "also constrain a separate sign layer; ignoring either layer leaves a vast "
+        "space of near-misses."
+    ),
+    "hardness_basis": (
+        "Theorem 1's native regime r2=1, r3=2, s=n>=17 is used; for the generated "
+        "signed-permutation distribution no polynomial-time recovery method is "
+        "known, and the measured capped permutation-CSP attack at the shipping "
+        "preset explores 250000 nodes per instance without a success."
+    ),
+    # Exact worst-case character count at n=32 is 150; ceil(150/4)=38 tokens.
+    "max_answer_tokens": 38,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 17, "coeff_bits": 3, "mix_factor": 5, "demo_pattern": True},
+    "easy": {"n": 24, "coeff_bits": 16, "mix_factor": 8},
+    "medium": {"n": 28, "coeff_bits": 20, "mix_factor": 10},
+    "hard": {"n": 32, "coeff_bits": 24, "mix_factor": 12},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A length-n signed permutation of 1,...,n, with coordinate 0 positive; "
+        "all entries are nonzero integers and no absolute value repeats."
+    ),
+    "bounds": {
+        "max_length": 256,
+        "min_magnitude": 1,
+        "max_magnitude": 256,
+        "signs": 2,
+        "coordinate_zero_positive": True,
+    },
+}
+
+STRUCTURAL_HINT = (
+    "Even powers see only the hidden magnitude permutation, whereas odd powers "
+    "also see its independent sign layer."
+)
+
+PLACEBO_HINT = (
+    "Careful bookkeeping keeps the coordinate conventions and exact integer "
+    "arithmetic consistently aligned."
+)
+
+# Filled from the three isolated harden.py runs.  G9(a,b) are diagnostics; only
+# the answer/operation caps gate shipping.
+G9_ARMS = {
+    "bare": {"solved": 0, "attempts": 0, "errors": 4},
+    "hinted": {"solved": 0, "attempts": 0, "errors": 4},
+    "placebo": {"solved": 0, "attempts": 0, "errors": 4},
+}
+
+
+NOTES = """
+Section 1 and Theorem 1 fix the native system, the meanings of highly
+non-singular, and the regime r3 >= 2 r2 > 0 with
+s >= 6 r3 + floor(14 r2/3) + 1.  Section 4 is the decisive limitation: the
+asymptotic constant need not be positive, and positivity additionally requires
+nonsingular real and p-adic points.  The theorem is an asymptotic counting
+argument, not a certificate-finding algorithm.
+
+Generation is inverse: choose a signed permutation x, then form every row by
+random two-coordinate lattice moves orthogonal to (x_i^2) or (x_i^3).  The
+planted point is therefore known without solving.  Rejection sampling checks
+the paper's highly-nonsingular column conditions and a rank-three Jacobian; it
+never searches for a solution.
+
+The column-scale probe was defeated by using exchangeable lattice moves rather
+than solving for one conspicuous final coefficient.  The joint greedy and
+random-restart probes were defeated by independently mixing all coefficient
+rows.  The permutation-CSP attack branches on the exact signed-permutation
+language with safe residual bounds and is capped only after its measured node
+budget.  Plants and non-planted coordinates undergo the same move distribution.
+""".strip()
+
+
+def _dot(a: list[int], b: list[int]) -> int:
+    return sum(x * y for x, y in zip(a, b))
+
+
+def _orthogonal_row(
+    vector: list[int], rng: random.Random, coeff_bits: int, mix_factor: int
+) -> list[int]:
+    """Sample a dense lattice vector c with c.vector == 0 by construction."""
+
+    size = len(vector)
+    row = [0] * size
+    lo = 1 << max(0, coeff_bits - 1)
+    hi = 1 << coeff_bits
+    for _ in range(mix_factor * size):
+        i = rng.randrange(size)
+        j = rng.randrange(size - 1)
+        if j >= i:
+            j += 1
+        step = rng.randrange(lo, hi)
+        if rng.randrange(2):
+            step = -step
+        g = math.gcd(abs(vector[i]), abs(vector[j]))
+        row[i] += step * (vector[j] // g)
+        row[j] -= step * (vector[i] // g)
+    assert _dot(row, vector) == 0
+    return row
+
+
+def _cubic_highly_nonsingular(rows: list[list[int]]) -> bool:
+    a, b = rows
+    size = len(a)
+    for i in range(size):
+        for j in range(i + 1, size):
+            if a[i] * b[j] - a[j] * b[i] == 0:
+                return False
+    return True
+
+
+def _rank_at_least_three(rows: list[list[int]]) -> bool:
+    if len(rows) != 3:
+        return False
+    size = len(rows[0])
+    a, b, c = rows
+    for i in range(size - 2):
+        for j in range(i + 1, size - 1):
+            for k in range(j + 1, size):
+                det = (
+                    a[i] * (b[j] * c[k] - b[k] * c[j])
+                    - a[j] * (b[i] * c[k] - b[k] * c[i])
+                    + a[k] * (b[i] * c[j] - b[j] * c[i])
+                )
+                if det:
+                    return True
+    return False
+
+
+def _valid_paper_hypotheses(
+    quadratic: list[int], cubics: list[list[int]], witness: list[int]
+) -> bool:
+    if any(value == 0 for value in quadratic):
+        return False
+    if not _cubic_highly_nonsingular(cubics):
+        return False
+    jacobian = [
+        [2 * quadratic[i] * witness[i] for i in range(len(witness))],
+        [3 * cubics[0][i] * witness[i] ** 2 for i in range(len(witness))],
+        [3 * cubics[1][i] * witness[i] ** 2 for i in range(len(witness))],
+    ]
+    return _rank_at_least_three(jacobian)
+
+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    coeff_bits: int = 20,
+    mix_factor: int = 10,
+    demo_pattern: bool = False,
+    **params: object,
+) -> dict:
+    """Create a native diagonal system around a known nonsingular integer point.
+
+    The answer is selected before any coefficient row.  Each row is then a sum
+    of identities of the form
+    ``(v_j/g)e_i - (v_i/g)e_j``, whose dot product with ``v`` is zero.
+    """
+
+    del params
+    if isinstance(n, bool) or not isinstance(n, int) or n < 17:
+        raise ValueError("n must be an integer at least 17 (Theorem 1 regime)")
+    if n > 256:
+        raise ValueError("n exceeds the 256-atom certificate-language bound")
+    if not (2 <= coeff_bits <= 60):
+        raise ValueError("coeff_bits must lie in 2..60")
+    if not (2 <= mix_factor <= 64):
+        raise ValueError("mix_factor must lie in 2..64")
+
+    rng = random.Random(seed)
+    if demo_pattern:
+        witness = list(range(1, n + 1))
+    else:
+        magnitudes = list(range(1, n + 1))
+        rng.shuffle(magnitudes)
+        witness = []
+        for i, magnitude in enumerate(magnitudes):
+            sign = 1 if i == 0 else (-1 if rng.randrange(2) else 1)
+            witness.append(sign * magnitude)
+
+    squares = [x * x for x in witness]
+    cubes = [x * x * x for x in witness]
+
+    for attempt in range(1, 129):
+        quadratic = _orthogonal_row(squares, rng, coeff_bits, mix_factor)
+        cubics = [
+            _orthogonal_row(cubes, rng, coeff_bits, mix_factor),
+            _orthogonal_row(cubes, rng, coeff_bits, mix_factor),
+        ]
+        if _valid_paper_hypotheses(quadratic, cubics, witness):
+            break
+    else:
+        raise RuntimeError("could not sample highly nonsingular coefficient rows")
+
+    return {
+        "paper": "arXiv:1612.00719",
+        "family": "bounded integral point on one quadratic and two cubic diagonal forms",
+        "n": n,
+        "r2": 1,
+        "r3": 2,
+        "bound": n,
+        "coefficient_bits": coeff_bits,
+        "mix_factor": mix_factor,
+        "demo_pattern": bool(demo_pattern),
+        "quadratic": quadratic,
+        "cubics": cubics,
+        "construction_attempt": attempt,
+        "answer": witness,
+    }
+
+
+def render(inst: dict) -> str:
+    n = inst["n"]
+    lines = [
+        "Find a bounded nonzero integral solution of simultaneous diagonal equations.",
+        "",
+        "Definitions and constraints.",
+        f"There are {n} integer variables x_0,...,x_{n - 1}; indices are 0-based.",
+        f"Your answer must contain exactly {n} integers.",
+        f"Their absolute values must be exactly 1,2,...,{n}, each used once.",
+        "Signs are free except that x_0 must be positive; this removes the global sign ambiguity.",
+        "For a coefficient row a, its degree-d diagonal form is sum_i a_i*x_i^d.",
+        "All sums and powers are over the ordinary integers, with no modulus.",
+        "A valid answer makes the following one quadratic and two cubic forms exactly zero.",
+        "",
+        "Quadratic row Q (degree 2):",
+        " ".join(map(str, inst["quadratic"])),
+        "",
+        "Cubic row C1 (degree 3):",
+        " ".join(map(str, inst["cubics"][0])),
+        "",
+        "Cubic row C2 (degree 3):",
+        " ".join(map(str, inst["cubics"][1])),
+        "",
+        "Thus you must have Q(x)=C1(x)=C2(x)=0 exactly.",
+        "Order matters because position j is the value of x_j; repeated absolute values are forbidden.",
+        "",
+        "Give your final answer inside <answer></answer> tags, as a JSON-style list of integers.",
+        "Example: <answer>[1, -3, 2]</answer>",
+        "Output nothing else inside the tags.",
+    ]
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: object) -> object | None:
+    if not isinstance(text, str):
+        return None
+    try:
+        match = re.search(
+            r"<answer>(.*?)</answer>", text, flags=re.IGNORECASE | re.DOTALL
+        )
+        if not match:
+            return None
+        body = match.group(1).strip()
+        body = re.sub(r"^```(?:json|python|text)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body).strip()
+        if not body:
+            return []
+        if body.startswith("[") and body.endswith("]"):
+            value = json.loads(body)
+            if not isinstance(value, list):
+                return None
+            if not all(isinstance(x, int) and not isinstance(x, bool) for x in value):
+                return None
+            return value
+        tokens = [token for token in re.split(r"[\s,]+", body) if token]
+        if not tokens or not all(re.fullmatch(r"[+-]?\d+", token) for token in tokens):
+            return None
+        return [int(token) for token in tokens]
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    n = inst["n"]
+    if not isinstance(answer, list) or not all(
+        isinstance(x, int) and not isinstance(x, bool) for x in answer
+    ):
+        return False, "malformed: expected a list containing only integers"
+    if not answer:
+        return False, "empty answer: expected a nonzero signed permutation"
+    if len(answer) < n:
+        return False, f"wrong length: too few entries ({len(answer)} instead of {n})"
+    if len(answer) > n:
+        return False, f"wrong length: too many entries ({len(answer)} instead of {n})"
+    magnitudes = [abs(x) for x in answer]
+    outside = [m for m in magnitudes if m < 1 or m > n]
+    if outside:
+        return False, f"magnitude out of range: {outside[0]} is not in 1..{n}"
+    if len(set(magnitudes)) != n:
+        return False, "duplicate magnitude: absolute values must be a permutation of 1..n"
+    if answer[0] <= 0:
+        return False, "sign convention: x_0 must be positive"
+
+    q_value = sum(c * x * x for c, x in zip(inst["quadratic"], answer))
+    if q_value != 0:
+        return False, f"quadratic residual is {q_value}, not zero"
+    c1_value = sum(c * x * x * x for c, x in zip(inst["cubics"][0], answer))
+    if c1_value != 0:
+        return False, f"first cubic residual is {c1_value}, not zero"
+    c2_value = sum(c * x * x * x for c, x in zip(inst["cubics"][1], answer))
+    if c2_value != 0:
+        return False, f"second cubic residual is {c2_value}, not zero"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    values = list(range(1, inst["n"] + 1))
+    rng.shuffle(values)
+    for i in range(1, len(values)):
+        if rng.randrange(2):
+            values[i] = -values[i]
+    # Coordinate zero is positive by construction, exactly as the statement says.
+    return values
+
+
+def search_space(inst: dict) -> int | None:
+    return math.factorial(inst["n"]) * (1 << (inst["n"] - 1))
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Enumerate only genuinely tiny languages; the paper regime starts at 17."""
+
+    n = inst["n"]
+    if n > 9:
+        return None
+    count = 0
+    for permutation in itertools.permutations(range(1, n + 1)):
+        for mask in range(1 << (n - 1)):
+            candidate = [permutation[0]] + [
+                (-permutation[i] if mask & (1 << (i - 1)) else permutation[i])
+                for i in range(1, n)
+            ]
+            if verify(inst, candidate)[0]:
+                count += 1
+    return count
+
+
+def _normalised_row(row: list[int]) -> list[int]:
+    divisor = 0
+    for value in row:
+        divisor = math.gcd(divisor, abs(value))
+    divisor = max(1, divisor)
+    return [value // divisor for value in row]
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonicalise variable relabelling, row order, and equation sign/scaling."""
+
+    q = _normalised_row(inst["quadratic"])
+    c_rows = [_normalised_row(row) for row in inst["cubics"]]
+    candidates: list[str] = []
+    for swap in (False, True):
+        c1, c2 = (c_rows[1], c_rows[0]) if swap else (c_rows[0], c_rows[1])
+        for sq, s1, s2 in itertools.product((-1, 1), repeat=3):
+            columns = sorted(
+                (sq * q[i], s1 * c1[i], s2 * c2[i]) for i in range(inst["n"])
+            )
+            candidates.append(json.dumps(columns, separators=(",", ":")))
+    payload = min(candidates).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Increase coefficient entropy/mixing first, then length only if necessary."""
+
+    harder = {k: v for k, v in params.items() if k != "_preset"}
+    harder.pop("demo_pattern", None)
+    n = int(harder.get("n", 24))
+    bits = int(harder.get("coeff_bits", 16))
+    mix = int(harder.get("mix_factor", 8))
+    if bits < min(28, n):
+        harder["coeff_bits"] = min(min(28, n), bits + 3)
+        harder["mix_factor"] = min(64, mix + 2)
+        return harder
+    # The exact no-tool route count is 9*n, so lengthening past n=33 would
+    # violate G9(c) even though the serialized witness itself would still fit.
+    if n + 8 <= 144 and 9 * (n + 8) <= 300:
+        harder["n"] = n + 8
+        harder["coeff_bits"] = min(36, bits + 2)
+        harder["mix_factor"] = min(64, mix + 2)
+        return harder
+    return "cap_bound"
+
+
+# ---------------------------------------------------------------------------
+# Construction-aware adversaries used by selftest.
+
+
+def _residuals(inst: dict, candidate: list[int]) -> tuple[int, int, int]:
+    return (
+        sum(c * x * x for c, x in zip(inst["quadratic"], candidate)),
+        sum(c * x * x * x for c, x in zip(inst["cubics"][0], candidate)),
+        sum(c * x * x * x for c, x in zip(inst["cubics"][1], candidate)),
+    )
+
+
+def _score(inst: dict, candidate: list[int]) -> float:
+    residuals = _residuals(inst, candidate)
+    n = inst["n"]
+    scales = [
+        max(1, sum(abs(c) for c in inst["quadratic"]) * n**2),
+        max(1, sum(abs(c) for c in inst["cubics"][0]) * n**3),
+        max(1, sum(abs(c) for c in inst["cubics"][1]) * n**3),
+    ]
+    return sum(abs(value) / scale for value, scale in zip(residuals, scales))
+
+
+def _sign_greedy(inst: dict, magnitudes: list[int]) -> list[int]:
+    candidate = list(magnitudes)
+    candidate[0] = abs(candidate[0])
+    sums = [0, 0]
+    order = sorted(
+        range(1, inst["n"]),
+        key=lambda i: (
+            abs(inst["cubics"][0][i]) + abs(inst["cubics"][1][i])
+        )
+        * magnitudes[i] ** 3,
+        reverse=True,
+    )
+    # Account for fixed positive coordinate zero.
+    sums[0] = inst["cubics"][0][0] * candidate[0] ** 3
+    sums[1] = inst["cubics"][1][0] * candidate[0] ** 3
+    for i in order:
+        magnitude = abs(magnitudes[i])
+        plus = [
+            sums[h] + inst["cubics"][h][i] * magnitude**3 for h in range(2)
+        ]
+        minus = [
+            sums[h] - inst["cubics"][h][i] * magnitude**3 for h in range(2)
+        ]
+        if sum(abs(v) for v in minus) < sum(abs(v) for v in plus):
+            candidate[i] = -magnitude
+            sums = minus
+        else:
+            candidate[i] = magnitude
+            sums = plus
+    return candidate
+
+
+def _attack_column_scale(inst: dict, rng: random.Random) -> list[list[int]]:
+    del rng
+    n = inst["n"]
+    scales = []
+    for i in range(n):
+        scales.append(
+            abs(inst["quadratic"][i]) / max(1, n**2)
+            + abs(inst["cubics"][0][i]) / max(1, n**3)
+            + abs(inst["cubics"][1][i]) / max(1, n**3)
+        )
+    order = sorted(range(n), key=lambda i: scales[i])
+    candidates = []
+    for reverse in (False, True):
+        assigned = [0] * n
+        magnitudes = list(range(1, n + 1))
+        if reverse:
+            magnitudes.reverse()
+        for coordinate, magnitude in zip(order, magnitudes):
+            assigned[coordinate] = magnitude
+        candidates.append(_sign_greedy(inst, assigned))
+    return candidates
+
+
+def _attack_joint_greedy(inst: dict, rng: random.Random) -> list[list[int]]:
+    candidates = []
+    n = inst["n"]
+    for trial in range(3):
+        order = list(range(n))
+        if trial == 0:
+            order.sort(
+                key=lambda i: sum(
+                    abs(row[i]) for row in [inst["quadratic"], *inst["cubics"]]
+                ),
+                reverse=True,
+            )
+        else:
+            rng.shuffle(order)
+        remaining = set(range(1, n + 1))
+        candidate = [0] * n
+        sums = [0, 0, 0]
+        rows = [inst["quadratic"], *inst["cubics"]]
+        degrees = [2, 3, 3]
+        for coordinate in order:
+            best = None
+            choices = sorted(remaining)
+            for magnitude in choices:
+                signs = (1,) if coordinate == 0 else (-1, 1)
+                for sign in signs:
+                    value = sign * magnitude
+                    next_sums = [
+                        sums[h] + rows[h][coordinate] * value ** degrees[h]
+                        for h in range(3)
+                    ]
+                    merit = sum(abs(v) for v in next_sums)
+                    key = (merit, magnitude, sign)
+                    if best is None or key < best[0]:
+                        best = (key, value, next_sums)
+            assert best is not None
+            candidate[coordinate] = best[1]
+            sums = best[2]
+            remaining.remove(abs(best[1]))
+        candidates.append(candidate)
+    return candidates
+
+
+def _attack_random_restart(
+    inst: dict, rng: random.Random, restarts: int = 24, moves: int = 1200
+) -> list[list[int]]:
+    best_candidates: list[list[int]] = []
+    n = inst["n"]
+    for _ in range(restarts):
+        current = random_candidate(inst, rng)
+        assert isinstance(current, list)
+        current_score = _score(inst, current)
+        for _ in range(moves):
+            proposal = current[:]
+            if rng.randrange(3) == 0:
+                i = rng.randrange(1, n)
+                proposal[i] = -proposal[i]
+            else:
+                i = rng.randrange(n)
+                j = rng.randrange(n - 1)
+                if j >= i:
+                    j += 1
+                proposal[i], proposal[j] = proposal[j], proposal[i]
+                proposal[0] = abs(proposal[0])
+            proposal_score = _score(inst, proposal)
+            if proposal_score < current_score:
+                current, current_score = proposal, proposal_score
+            if current_score == 0.0 and verify(inst, current)[0]:
+                return [current]
+        best_candidates.append(current)
+    return best_candidates
+
+
+def _attack_csp(
+    inst: dict, rng: random.Random, node_cap: int = 250_000
+) -> tuple[list[int] | None, int]:
+    """Depth-first permutation CSP with exact residual bounds and a node cap."""
+
+    n = inst["n"]
+    rows = [inst["quadratic"], *inst["cubics"]]
+    degrees = [2, 3, 3]
+    order = list(range(n))
+    # Strongest coefficients first makes the residual bounds useful sooner.
+    order.sort(
+        key=lambda i: (
+            abs(rows[0][i]) * n**2
+            + abs(rows[1][i]) * n**3
+            + abs(rows[2][i]) * n**3
+        ),
+        reverse=True,
+    )
+    suffix_abs = [[0] * (n + 1) for _ in range(3)]
+    for depth in range(n - 1, -1, -1):
+        coordinate = order[depth]
+        for h in range(3):
+            suffix_abs[h][depth] = suffix_abs[h][depth + 1] + abs(rows[h][coordinate])
+
+    candidate = [0] * n
+    nodes = 0
+    found: list[int] | None = None
+
+    def visit(depth: int, remaining: tuple[int, ...], sums: tuple[int, int, int]) -> None:
+        nonlocal nodes, found
+        if found is not None or nodes >= node_cap:
+            return
+        nodes += 1
+        if depth == n:
+            if sums == (0, 0, 0) and verify(inst, candidate)[0]:
+                found = candidate[:]
+            return
+        maximum = remaining[-1]
+        for h in range(3):
+            # Safe (deliberately generous) interval bound for all unassigned terms.
+            if abs(sums[h]) > suffix_abs[h][depth] * maximum ** degrees[h]:
+                return
+        coordinate = order[depth]
+        values = list(remaining)
+        rng.shuffle(values)
+        values.sort(
+            key=lambda magnitude: abs(
+                sums[0] + rows[0][coordinate] * magnitude**2
+            )
+        )
+        for magnitude in values:
+            signs = (1,) if coordinate == 0 else (-1, 1)
+            for sign in signs:
+                value = sign * magnitude
+                next_sums = tuple(
+                    sums[h] + rows[h][coordinate] * value ** degrees[h]
+                    for h in range(3)
+                )
+                candidate[coordinate] = value
+                next_remaining = tuple(v for v in remaining if v != magnitude)
+                visit(depth + 1, next_remaining, next_sums)
+                if found is not None or nodes >= node_cap:
+                    return
+
+    visit(0, tuple(range(1, n + 1)), (0, 0, 0))
+    return found, nodes
+
+
+def _run_attack_panel(params: dict, seeds: list[int]) -> dict:
+    results = {
+        "outlier_column_scale": {"successes": 0, "attempts": len(seeds)},
+        "greedy_joint_residual": {"successes": 0, "attempts": len(seeds)},
+        "random_restart_local_24x1200": {"successes": 0, "attempts": len(seeds)},
+        "permutation_csp_branch_bound_250k": {
+            "successes": 0,
+            "attempts": len(seeds),
+            "nodes": 0,
+            "wall_clock_sec": 0.0,
+        },
+    }
+    built = [make_instance(seed=seed, **params) for seed in seeds]
+    cheap: list[tuple[str, Callable[[dict, random.Random], list[list[int]]]]] = [
+        ("outlier_column_scale", _attack_column_scale),
+        ("greedy_joint_residual", _attack_joint_greedy),
+        ("random_restart_local_24x1200", _attack_random_restart),
+    ]
+    for name, attack in cheap:
+        for seed, inst in zip(seeds, built):
+            guesses = attack(inst, random.Random(100_000 + seed))
+            if any(verify(inst, guess)[0] for guess in guesses):
+                results[name]["successes"] += 1
+
+    started = time.perf_counter()
+    for seed, inst in zip(seeds, built):
+        guess, nodes = _attack_csp(inst, random.Random(200_000 + seed))
+        results["permutation_csp_branch_bound_250k"]["nodes"] += nodes
+        if guess is not None and verify(inst, guess)[0]:
+            results["permutation_csp_branch_bound_250k"]["successes"] += 1
+    elapsed = time.perf_counter() - started
+    results["permutation_csp_branch_bound_250k"]["wall_clock_sec"] = round(elapsed, 6)
+    return results
+
+
+def _corruption_results(inst: dict) -> dict[str, str]:
+    planted = list(inst["answer"])
+    swapped = None
+    for i in range(inst["n"]):
+        for j in range(i + 1, inst["n"]):
+            trial = planted[:]
+            trial[i], trial[j] = trial[j], trial[i]
+            trial[0] = abs(trial[0])
+            ok, _ = verify(inst, trial)
+            if not ok:
+                swapped = trial
+                break
+        if swapped is not None:
+            break
+    assert swapped is not None
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_two": swapped,
+        "duplicate": planted[:-1] + [abs(planted[0])],
+        "empty": [],
+        "out_of_range": [inst["n"] + 1] + planted[1:],
+    }
+    reasons = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        reasons[name] = "ACCEPTED" if ok else reason
+    return reasons
+
+
+def _permute_instance(inst: dict, permutation: list[int]) -> tuple[dict, list[int]]:
+    transformed = dict(inst)
+    transformed["quadratic"] = [inst["quadratic"][i] for i in permutation]
+    transformed["cubics"] = [
+        [row[i] for i in permutation] for row in inst["cubics"]
+    ]
+    answer = [inst["answer"][i] for i in permutation]
+    if answer[0] < 0:
+        answer = [-x for x in answer]
+    transformed["answer"] = answer
+    return transformed, answer
+
+
+def _canonical_gate(params: dict) -> dict:
+    invariance_checks = 0
+    carried_witness_checks = 0
+    keys = []
+    for seed in range(20):
+        inst = make_instance(seed=seed + 7000, **params)
+        base = canonical_key(inst)
+        keys.append(base)
+        rng = random.Random(seed + 8000)
+        permutation = list(range(inst["n"]))
+        rng.shuffle(permutation)
+        permuted, answer = _permute_instance(inst, permutation)
+        variants = [permuted]
+        swapped_rows = dict(permuted)
+        swapped_rows["cubics"] = [permuted["cubics"][1], permuted["cubics"][0]]
+        variants.append(swapped_rows)
+        signed_rows = dict(swapped_rows)
+        signed_rows["quadratic"] = [-x for x in swapped_rows["quadratic"]]
+        signed_rows["cubics"] = [
+            swapped_rows["cubics"][0],
+            [-x for x in swapped_rows["cubics"][1]],
+        ]
+        variants.append(signed_rows)
+        for variant in variants:
+            invariance_checks += 1
+            if canonical_key(variant) != base:
+                return {
+                    "pass": False,
+                    "invariance_checks": invariance_checks,
+                    "carried_witness_checks": carried_witness_checks,
+                    "distinct_keys": len(set(keys)),
+                    "unrelated_instances": len(keys),
+                }
+            ok, _ = verify(variant, answer)
+            carried_witness_checks += 1
+            if not ok:
+                return {
+                    "pass": False,
+                    "invariance_checks": invariance_checks,
+                    "carried_witness_checks": carried_witness_checks,
+                    "distinct_keys": len(set(keys)),
+                    "unrelated_instances": len(keys),
+                }
+    return {
+        "pass": len(set(keys)) == 20,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": carried_witness_checks,
+        "distinct_keys": len(set(keys)),
+        "unrelated_instances": 20,
+        "transformations": [
+            "variable permutation",
+            "cubic-equation reorder composed with variable permutation",
+            "independent equation sign changes composed with both",
+        ],
+    }
+
+
+def selftest() -> dict:
+    report: dict[str, object] = {}
+    seeds = [0, 1, 2, 3]
+
+    checked = 0
+    failures = []
+    json_roundtrips = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in seeds:
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            checked += 1
+            if not ok:
+                failures.append({"preset": preset, "seed": seed, "reason": reason})
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_roundtrips += 1
+    report["G1_planted_verifies"] = {
+        "pass": not failures and json_roundtrips == checked,
+        "instances_checked": checked,
+        "json_native_answers": json_roundtrips,
+        "failures": failures,
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=12345, **shipping)
+    corruption = _corruption_results(inst)
+    report["G2_rejects_corruption"] = {
+        "pass": (
+            all(not reason.startswith("ACCEPTED") for reason in corruption.values())
+            and len(set(corruption.values())) == len(corruption)
+        ),
+        "reasons": corruption,
+        "distinct_reasons": len(set(corruption.values())),
+    }
+
+    response = (
+        "The even and odd constraints agree.\n\n<answer>\n```json\n"
+        + json.dumps(inst["answer"])
+        + "\n```\n</answer>\nThat is my final witness."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == inst["answer"],
+        "realistic_prose": True,
+        "parsed_entries": len(parsed) if isinstance(parsed, list) else None,
+    }
+
+    rng = random.Random(99001)
+    sample_total = 200_000
+    sample_hits = 0
+    for _ in range(sample_total):
+        if verify(inst, random_candidate(inst, rng))[0]:
+            sample_hits += 1
+    density = sample_hits / sample_total
+    report["G4_guess_resistance"] = {
+        "pass": density < 1e-6,
+        "hits": sample_hits,
+        "total": sample_total,
+        "structure_aware_probability": density,
+        "prior": "uniform signed permutations with x_0 positive",
+        "search_space": search_space(inst),
+    }
+
+    panel = _run_attack_panel(shipping, list(range(8)))
+    domain = panel["permutation_csp_branch_bound_250k"]
+    report["G5_density_and_baseline_cost"] = {
+        "pass": density < 1e-6 and domain["successes"] == 0,
+        "shipping_n": inst["n"],
+        "sample_hits": sample_hits,
+        "sample_total": sample_total,
+        "sampled_valid_fraction": density,
+        "baseline_wall_seconds": domain["wall_clock_sec"],
+        "baseline_nodes": domain["nodes"],
+        "baseline_attempts": domain["attempts"],
+        "baseline_successes": domain["successes"],
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(result["successes"] == 0 for result in panel.values()),
+        "attacks": panel,
+        "standard_algorithm": "permutation CSP depth-first branch-and-bound with exact residual bounds",
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] = 2 * int(shipping["n"])
+    doubled = make_instance(seed=54321, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    ladder_logs = [
+        search_space(make_instance(seed=321, **params)) for params in DIFFICULTY.values()
+    ]
+    report["G7_scales"] = {
+        "pass": doubled_ok and all(
+            a is not None and b is not None and b > a
+            for a, b in zip(ladder_logs, ladder_logs[1:])
+        ),
+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+        "log2_search_spaces": [
+            round(math.log2(value), 3) if value is not None else None
+            for value in ladder_logs
+        ],
+    }
+
+    report["G8_canonical_key"] = _canonical_gate(shipping)
+
+    answer_blob = json.dumps(inst["answer"])
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
+    intended_operations = 9 * inst["n"]
+    arms_ran = bool(
+        G9_ARMS["hinted"]["attempts"] and G9_ARMS["placebo"]["attempts"]
+    )
+    hinted_rate = (
+        G9_ARMS["hinted"]["solved"] / G9_ARMS["hinted"]["attempts"]
+        if G9_ARMS["hinted"]["attempts"]
+        else None
+    )
+    placebo_rate = (
+        G9_ARMS["placebo"]["solved"] / G9_ARMS["placebo"]["attempts"]
+        if G9_ARMS["placebo"]["attempts"]
+        else None
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": answer_chars <= 2000 and inst["n"] <= 256 and intended_operations <= 300,
+        "arms": G9_ARMS,
+        "hinted_minus_placebo": (
+            hinted_rate - placebo_rate if arms_ran else None
+        ),
+        "hinted_verdict": (
+            "not_run"
+            if not G9_ARMS["hinted"]["attempts"]
+            else ("hardened" if G9_ARMS["hinted"]["solved"] == 0 else "too_easy")
+        ),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": inst["n"],
+        "intended_route_operations": intended_operations,
+        "operation_convention": (
+            "one exponentiation, coefficient multiplication, and accumulation for each of three rows"
+        ),
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [
+        value
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    ]
+    report["all_passed"] = all(bool(gate.get("pass")) for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
