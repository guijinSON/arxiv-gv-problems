   559	def _relative_code(first, second):
   560	    n = len(first)
   561	    fs = _cycle_successor(first)
   562	    ss = _cycle_successor(second)
   563	    pos = {v: i for i, v in enumerate(first)}
   564	    raw = [pos[ss[first[i]]] for i in range(n)]
   565	    best = None
   566	    for shift in range(n):
   567	        code = tuple((raw[(i + shift) % n] - shift) % n for i in range(n))
   568	        if best is None or code < best:
   569	            best = code
   570	    return best
   571	
