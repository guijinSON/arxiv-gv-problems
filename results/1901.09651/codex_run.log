   352	        return None, "invalid switch-component count"
   353	    if any(not isinstance(c, list) or len(c) != 3
   354	           or any(not _is_int(v) or not 0 <= v < n for v in c)
   355	           or len(set(c)) != 3 for c in components):
   356	        return None, "switch components must be triples of distinct vertices"
   357	    flat = [v for c in components for v in c]
   358	    if len(set(flat)) != len(flat):
   359	        return None, "switch components overlap"
   360	
   361	    xs_map = _cycle_successor(x)
   362	    ys_map = _cycle_successor(y)
   363	    xs = [xs_map[v] for v in universe]
   364	    ys = [ys_map[v] for v in universe]
   365	    pred_x = [0] * n
   366	    for v, w in enumerate(xs):
   367	        pred_x[w] = v
   368	    rel = [pred_x[ys[v]] for v in universe]
   369	    actual = _orbit_sets(rel)
   370	    stated = sorted(tuple(sorted(c)) for c in components)
   371	    if actual != stated:
   372	        return None, "listed switch components do not match the input tours"
   373	    data = (n, xs, ys, components, choose)
   374	    inst["_data_cache"] = data
   375	    return data, "ok"
