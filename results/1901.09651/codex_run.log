   611	def _reference_singleton_scan(inst):
   612	    """Exact Track-B reference: test each relative cycle as a singleton."""
   613	    data, why = _instance_data(inst)
   614	    if data is None:
   615	        return None, 0, why
   616	    n, _, _, components, choose = data
   617	    selected = []
   618	    visits = 0
   619	    for index in range(len(components)):
   620	        visits += 2 * n
   621	        if _pair_cycle_counts(data, {index}) == (1, 1):
   622	            selected.append(index)
   623	    candidate = sorted(selected)
   624	    if len(candidate) != choose:
   625	        return candidate, visits, "singleton scan found the wrong number of components"
   626	    ok, reason = verify(inst, candidate)
   627	    return candidate, visits, reason if ok else reason
