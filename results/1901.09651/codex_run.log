   378	def _pair_successors(data, selected):
   379	    n, xs, ys, components, _ = data
   380	    use_y = [False] * n
   381	    for index in selected:
   382	        for v in components[index]:
   383	            use_y[v] = True
   384	    z = [ys[v] if use_y[v] else xs[v] for v in range(n)]
   385	    w = [xs[v] if use_y[v] else ys[v] for v in range(n)]
   386	    return z, w
   387	
   388	
   389	def _pair_cycle_counts(data, selected):
   390	    """Count cycles without materialising two length-V successor arrays."""
   391	    n, xs, ys, components, _ = data
   392	    use_y = set()
   393	    for index in selected:
   394	        use_y.update(components[index])
   395	
   396	    def count(complement):
   397	        seen = [False] * n
   398	        cycles = 0
   399	        for start in range(n):
   400	            if seen[start]:
   401	                continue
   402	            cycles += 1
   403	            v = start
   404	            while not seen[v]:
   405	                seen[v] = True
   406	                chosen = v in use_y
   407	                if complement:
   408	                    chosen = not chosen
   409	                v = ys[v] if chosen else xs[v]
   410	        return cycles
   411	
   412	    return count(False), count(True)
   413	
   414	
   415	def _cycle_count(successor):
   416	    n = len(successor)
   417	    if sorted(successor) != list(range(n)):
   418	        return None
   419	    seen = set()
   420	    count = 0
   421	    for start in range(n):
   422	        if start in seen:
   423	            continue
   424	        count += 1
   425	        v = start
   426	        while v not in seen:
   427	            seen.add(v)
   428	            v = successor[v]
   429	    return count
   430	
   431	
   432	def _valid_pair(data, selected):
   433	    return _pair_cycle_counts(data, selected) == (1, 1)
