   689	def _relabel_and_reorder(inst, rng):
   690	    out = _copy_instance(inst)
   691	    n = out["vertex_count"]
   692	    label = list(range(n))
   693	    rng.shuffle(label)
   694	    out["tour_x"] = [label[v] for v in out["tour_x"]]
   695	    out["tour_y"] = [label[v] for v in out["tour_y"]]
   696	    old_components = [[label[v] for v in c] for c in out["switch_components"]]
   697	    order = list(range(len(old_components)))
   698	    rng.shuffle(order)
   699	    out["switch_components"] = [old_components[i] for i in order]
   700	    old_to_new = {old: new for new, old in enumerate(order)}
   701	    out["answer"] = sorted(old_to_new[i] for i in out["answer"])
   702	    sx = rng.randrange(n)
   703	    sy = rng.randrange(n)
   704	    out["tour_x"] = out["tour_x"][sx:] + out["tour_x"][:sx]
   705	    out["tour_y"] = out["tour_y"][sy:] + out["tour_y"][:sy]
   706	    out["tour_x"], out["tour_y"] = out["tour_y"], out["tour_x"]
   707	    return out
