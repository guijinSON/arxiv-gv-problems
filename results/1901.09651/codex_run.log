   593	def _ordered_pair_code(x: list[int], y: list[int]) -> tuple[int, ...]:
   594	    """Canonical code for ordered directed cycles under vertex relabelling."""
   595	
   596	    n = len(x)
   597	    px = [0] * n
   598	    py = [0] * n
   599	    for i, v in enumerate(x):
   600	        px[v] = i
   601	    for i, v in enumerate(y):
   602	        py[v] = i
   603	    best: tuple[int, ...] | None = None
   604	    for sx, vertex in enumerate(x):
   605	        sy = py[vertex]
   606	        candidate = tuple((px[y[(sy + k) % n]] - sx) % n for k in range(n))
   607	        if best is None or candidate < best:
   608	            best = candidate
   609	    if best is None:
   610	        raise ValueError("empty tours have no canonical code")
   611	    return best
