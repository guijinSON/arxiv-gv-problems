+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A binary word of exactly m bits, where m is the number of listed "
+        "alternating components; bit 0 is fixed to 0 to quotient the exchange "
+        "of the two output covers, and the all-zero word is excluded."
+    ),
+    "bounds": {
+        "alphabet_size": 2,
+        "fixed_prefix_bits": 1,
+        "excluded_words": 1,
+        "max_bits_at_shipping": 96,
+    },
+}
+
+DIFFICULTY = {
+    "demo": {"n": 12, "nesting": 0},
+    "easy": {"n": 48, "nesting": 25},
+    "medium": {"n": 96, "nesting": 60},
+    "hard": {"n": 192, "nesting": 90},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+# Filled from the separately-run hardening arms before delivery.  They are
+# diagnostics only; G9(c)'s size and operation limits are the gate.
+G9_ARMS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+}
+
+NOTES = """\
+Definition: Section 1, Lemma 1 and the displayed combinatorial problem require
+two Hamiltonian tours z,w, different from x,y, whose disjoint arc multisets
+equal x union y.  Section 3, directed Steps 1-2, licenses the bipartite matching
+selector used here.  The easy regime is explicit in Section 6: pyramidal tours
+admit a linear-time test, so no preset uses pyramidal tours.  Section 6 also
+shows the proposed heuristic rapidly solves many random inputs; accordingly
+this module is Track B, not Track A.  Single-component outliers and one-flip
+descent fail because one switched chord splits both covers; local arc greed has
+no information about a chord's crossing partner; random restart faces the exact
+selector density reported by selftest.  The reference best-improvement search
+is intentionally reported as a successful polynomial algorithm.
+"""
+
+
+def _normalise_n(n: int) -> int:
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise TypeError("n must be an integer")
+    if n < 12:
+        n = 12
+    return ((n + 3) // 4) * 4
+
+
+def _chord_word(blocks: int, nesting: int, rng: random.Random) -> list[int]:
+    """Return a double-occurrence word whose interlacement graph is a matching.
+
+    Every block owns chord labels 2j and 2j+1.  Its local word is a,b,a,b.
+    Recursively placing complete child words into one of the three internal
+    gaps changes the ordered-tour instance without adding inter-block crossings.
+    """
+
+    nesting = max(0, min(100, int(nesting)))
+    children: list[list[int]] = [[] for _ in range(blocks)]
+    roots: list[int] = []
+    for j in range(blocks):
+        if j == 0 or rng.randrange(100) >= nesting:
+            roots.append(j)
+        else:
+            children[rng.randrange(j)].append(j)
+    for row in children:
+        rng.shuffle(row)
+
+    slots: list[list[list[int]]] = []
+    for j in range(blocks):
+        three = [[], [], []]
+        for child in children[j]:
+            three[rng.randrange(3)].append(child)
+        slots.append(three)
+
+    def emit(j: int) -> list[int]:
+        a, b = 2 * j, 2 * j + 1
+        s0, s1, s2 = slots[j]
+        out = [a, b]
+        for child in s0:
+            out.extend(emit(child))
+        out.append(a)
+        for child in s1:
+            out.extend(emit(child))
+        out.append(b)
+        for child in s2:
+            out.extend(emit(child))
+        return out
+
+    word: list[int] = []
+    for root in roots:
+        word.extend(emit(root))
+    return word
+
+
+def _tour_to_succ(tour: list[int]) -> list[int]:
+    n = len(tour)
+    succ = [-1] * n
+    for i, u in enumerate(tour):
+        succ[u] = tour[(i + 1) % n]
+    return succ
+
+
+def _succ_to_tour(succ: list[int], start: int = 0) -> list[int] | None:
+    n = len(succ)
+    if start < 0 or start >= n:
+        return None
+    out: list[int] = []
+    seen = [False] * n
+    u = start
+    while 0 <= u < n and not seen[u]:
+        seen[u] = True
+        out.append(u)
+        u = succ[u]
+    if u != start or len(out) != n:
+        return None
+    return out
+
+
+def _is_pyramidal(tour: list[int]) -> bool:
+    """Paper's pyramidal condition, with labels shifted from 1..n to 0..n-1."""
+
+    n = len(tour)
+    start = tour.index(0)
+    ordered = tour[start:] + tour[:start]
+    peak = ordered.index(n - 1)
+    return all(ordered[i] < ordered[i + 1] for i in range(peak)) and all(
+        ordered[i] > ordered[i + 1] for i in range(peak, n - 1)
+    )
+
+
+def _derive_components(x: list[int], y: list[int]) -> list[list[int]]:
+    """Alternating cycles of two degree-two bipartite matching unions.
+
+    In this family each alternating cycle has two left/source vertices, so the
+    permutation x^{-1} y consists of transpositions.
+    """
+
+    xs = _tour_to_succ(x)
+    ys = _tour_to_succ(y)
+    inv_x = [-1] * len(x)
+    for u, v in enumerate(xs):
+        inv_x[v] = u
+    q = [inv_x[ys[u]] for u in range(len(x))]
+    seen: set[int] = set()
+    components: list[list[int]] = []
+    for u in range(len(x)):
+        if u in seen:
+            continue
+        v = q[u]
+        if v == u or v < 0 or v >= len(x) or q[v] != u:
+            raise ValueError("the constructed matching union is not transpositional")
+        seen.add(u)
+        seen.add(v)
+        components.append([u, v])
+    return components
+
+
+def _crosses(c1: tuple[int, int] | list[int], c2: tuple[int, int] | list[int]) -> bool:
+    a, b = sorted(c1)
+    c, d = sorted(c2)
+    return (a < c < b < d) or (c < a < d < b)
+
+
+def _component_positions(inst: dict) -> list[list[int]]:
+    pos = [0] * inst["n"]
+    for i, v in enumerate(inst["tour_x"]):
+        pos[v] = i
+    return [sorted([pos[u], pos[v]]) for u, v in inst["components"]]
+
+
+def _add_derived_arrays(inst: dict) -> dict:
+    """Attach JSON-native arrays reused by the grader's hot path."""
+
+    inst["succ_x"] = _tour_to_succ(inst["tour_x"])
+    inst["succ_y"] = _tour_to_succ(inst["tour_y"])
+    component_of = [-1] * inst["n"]
+    for i, (u, v) in enumerate(inst["components"]):
+        component_of[u] = i
+        component_of[v] = i
+    if any(i < 0 for i in component_of):
+        raise ValueError("alternating components do not cover every source vertex")
+    inst["component_of"] = component_of
+    return inst
+
+
+def _crossing_partners(inst: dict) -> list[int]:
+    chords = _component_positions(inst)
+    partners = [-1] * len(chords)
+    for i in range(len(chords)):
+        for j in range(i + 1, len(chords)):
+            if _crosses(chords[i], chords[j]):
+                if partners[i] != -1 or partners[j] != -1:
+                    raise ValueError("a component has more than one crossing partner")
+                partners[i] = j
+                partners[j] = i
+    if any(j < 0 for j in partners):
+        raise ValueError("a component has no crossing partner")
+    return partners
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Inverse-generate two tours and carry a complementary selector witness.
+
+    No search for the answer occurs.  First two certified tours are defined by
+    the base directed cycle and the complete chord switch.  A randomly chosen
+    union of whole crossing pairs gives the two input tours.  Vertex relabelling,
+    input exchange, cyclic rotation, and component reordering carry the planted
+    selector to the returned JSON-native string.
+    """
+
+    n = _normalise_n(n)
+    nesting = int(params.pop("nesting", 70))
+    if params:
+        raise TypeError(f"unknown parameters: {sorted(params)}")
+    rng = random.Random(seed)
+    blocks = n // 4
+    word = _chord_word(blocks, nesting, rng)
+    if len(word) != n:
+        raise AssertionError("internal chord word length error")
+
+    occurrences: list[list[int]] = [[] for _ in range(2 * blocks)]
+    for position, label in enumerate(word):
+        occurrences[label].append(position)
+    raw_components = [pair[:] for pair in occurrences]
+    if any(len(pair) != 2 for pair in raw_components):
+        raise AssertionError("internal chord occurrence error")
+
+    q = list(range(n))
+    for u, v in raw_components:
+        q[u] = v
+        q[v] = u
+    base = [(i + 1) % n for i in range(n)]
+
+    block_choice = [rng.randrange(2) for _ in range(blocks)]
+    if not any(block_choice):
+        block_choice[rng.randrange(blocks)] = 1
+    if all(block_choice):
+        block_choice[rng.randrange(blocks)] = 0
+    component_choice = [bit for bit in block_choice for _ in (0, 1)]
+
+    xs = [-1] * n
+    ys = [-1] * n
+    for i, (u, v) in enumerate(raw_components):
+        for source in (u, v):
+            if component_choice[i]:
+                xs[source] = base[q[source]]
+                ys[source] = base[source]
+            else:
+                xs[source] = base[source]
+                ys[source] = base[q[source]]
+    x = _succ_to_tour(xs)
+    y = _succ_to_tour(ys)
+    if x is None or y is None:
+        raise AssertionError("inverse construction did not produce input tours")
+
+    raw_x, raw_y = x, y
+    while True:
+        relabel = list(range(n))
+        rng.shuffle(relabel)
+        x = [relabel[u] for u in raw_x]
+        y = [relabel[u] for u in raw_y]
+        # Section 6 identifies the case where both inputs are pyramidal as
+        # linear-time.  Reject only that presentation, before carrying labels.
+        if not (_is_pyramidal(x) and _is_pyramidal(y)):
+            break
+    base_relabelled = [0] * n
+    for u in range(n):
+        base_relabelled[relabel[u]] = relabel[base[u]]
+
+    if rng.randrange(2):
+        x, y = y, x
+    rx = rng.randrange(n)
+    ry = rng.randrange(n)
+    x = x[rx:] + x[:rx]
+    y = y[ry:] + y[:ry]
+
+    components = _derive_components(x, y)
+    rng.shuffle(components)
+    x_now = _tour_to_succ(x)
+    y_now = _tour_to_succ(y)
+    answer_bits: list[str] = []
+    for u, v in components:
+        if x_now[u] == base_relabelled[u] and x_now[v] == base_relabelled[v]:
+            answer_bits.append("0")
+        elif y_now[u] == base_relabelled[u] and y_now[v] == base_relabelled[v]:
+            answer_bits.append("1")
+        else:
+            raise AssertionError("planted tour was not carried through decomposition")
+    if answer_bits[0] == "1":
+        answer_bits = ["1" if bit == "0" else "0" for bit in answer_bits]
+    answer = "".join(answer_bits)
+    if not any(bit == "1" for bit in answer):
+        raise AssertionError("planted answer accidentally reproduced an input tour")
+
+    inst = {
+        "paper": "arXiv:1901.09651",
+        "family": "complementary directed Hamiltonian tours",
+        "n": n,
+        "nesting": max(0, min(100, nesting)),
+        "tour_x": x,
+        "tour_y": y,
+        "components": components,
+        "answer": answer,
+    }
+    _add_derived_arrays(inst)
+    # This assertion checks the theorem-backed invariant of the construction,
+    # not a search for the already-carried answer.
+    _crossing_partners(inst)
+    return inst
+
+
+def render(inst: dict) -> str:
+    n = inst["n"]
+    m = len(inst["components"])
+    chords = _component_positions(inst)
+    lines = [
+        "Find a different complementary decomposition of two directed Hamiltonian tours.",
+        "",
+        "Definitions.",
+        f"The vertices are the integers 0 through {n - 1}.",
+        "A directed Hamiltonian tour is a cyclic ordering of every vertex exactly once;",
+        "its arcs go from each listed vertex to the next, and from the last back to the first.",
+        "The two input tours below have no common arcs.  Their union is therefore a directed",
+        "multigraph with two incoming and two outgoing arcs at every vertex.",
+        "",
+        "The union has alternating perfect-matching components.  Each listed component",
+        "contains two source vertices.  One selector bit controls the whole component:",
+        "bit 0 assigns both outgoing arcs used by tour X to cover Z and both X-complementary",
+        "arcs from tour Y to cover W; bit 1 swaps those assignments.  Consequently every",
+        "binary selector produces two directed cycle covers Z and W whose disjoint arc",
+        "multisets equal X union Y.  Your selector is valid exactly when Z and W are each",
+        "one Hamiltonian tour and the pair is different from the input pair X,Y.",
+        "",
+        f"There are m={m} components, indexed 0 through {m - 1}.  Output exactly m bits",
+        "in component-index order, with no separators.  The first bit must be 0; this",
+        "chooses one canonical representative because complementing every bit only exchanges",
+        "Z and W.  The all-zero word is forbidden because it reproduces X,Y.  Bits are 0 or 1.",
+        "",
+        "For structural inspection, each component line also gives its two endpoint positions",
+        "in tour X (positions are 0-indexed).  Two such components are crossing chords when",
+        "their four endpoint positions alternate around the cyclic order.  This annotation is",
+        "derived exactly from X and Y and does not change the selector semantics.",
+        "",
+        "Tour X (cyclic vertex order):",
+        " ".join(map(str, inst["tour_x"])),
+        "",
+        "Tour Y (cyclic vertex order):",
+        " ".join(map(str, inst["tour_y"])),
+        "",
+        "Alternating components, as `index: source source | X-positions position position`:",
+    ]
+    for i, ((u, v), (a, b)) in enumerate(zip(inst["components"], chords)):
+        lines.append(f"{i}: {u} {v} | X-positions {a} {b}")
+
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+
+    format_example = "0" + "1" * (m - 1)
+    lines.extend(
+        [
+            "",
+            "Give your final answer inside <answer></answer> tags, as the exact binary word.",
+            f"Example of the required {m}-bit syntax: <answer>{format_example}</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    try:
+        if not isinstance(text, str):
+            return None
+        match = re.search(r"<answer>(.*?)</answer>", text, re.IGNORECASE | re.DOTALL)
+        if not match:
+            return None
+        body = match.group(1).strip()
+        body = re.sub(r"^```(?:text|txt)?\s*", "", body, flags=re.IGNORECASE)
+        body = re.sub(r"\s*```$", "", body).strip()
+        body = re.sub(r"\s+", "", body)
+        if not body or re.fullmatch(r"[01]+", body) is None:
+            return None
+        return body
+    except Exception:
+        return None
+
+
+def _selected_successors(inst: dict, selector: str) -> tuple[list[int], list[int]]:
+    xs = inst.get("succ_x") or _tour_to_succ(inst["tour_x"])
+    ys = inst.get("succ_y") or _tour_to_succ(inst["tour_y"])
+    z = [-1] * inst["n"]
+    w = [-1] * inst["n"]
+    for bit, (u, v) in zip(selector, inst["components"]):
+        if bit == "0":
+            z[u], z[v] = xs[u], xs[v]
+            w[u], w[v] = ys[u], ys[v]
+        else:
+            z[u], z[v] = ys[u], ys[v]
+            w[u], w[v] = xs[u], xs[v]
+    return z, w
+
+
+def _one_selected_cycle(inst: dict, selector: str, complement: bool = False) -> bool:
+    """Test connectivity without materialising a cover.
+
+    A component bit always chooses an entire alternating matching component, so
+    indegree and outdegree one are already guaranteed.  It is therefore enough
+    to traverse the orbit of vertex 0 and require its first return after n arcs.
+    """
+
+    xs = inst.get("succ_x") or _tour_to_succ(inst["tour_x"])
+    ys = inst.get("succ_y") or _tour_to_succ(inst["tour_y"])
+    component_of = inst.get("component_of")
+    if component_of is None:
+        component_of = [-1] * inst["n"]
+        for i, (u, v) in enumerate(inst["components"]):
+            component_of[u] = component_of[v] = i
+    seen = [False] * inst["n"]
+    u = 0
+    steps = 0
+    while 0 <= u < inst["n"] and not seen[u]:
+        seen[u] = True
+        steps += 1
+        bit = selector[component_of[u]]
+        choose_y = (bit == "1") ^ complement
+        u = ys[u] if choose_y else xs[u]
+    return u == 0 and steps == inst["n"]
+
+
+def _cycle_count(succ: list[int], counter: list[int] | None = None) -> int | None:
+    n = len(succ)
+    indegree = [0] * n
+    for v in succ:
+        if v < 0 or v >= n:
+            return None
+        indegree[v] += 1
+    if any(d != 1 for d in indegree):
+        return None
+    seen = [False] * n
+    cycles = 0
+    for start in range(n):
+        if seen[start]:
+            continue
+        cycles += 1
+        u = start
+        while not seen[u]:
+            seen[u] = True
+            if counter is not None:
+                counter[0] += 1
+            u = succ[u]
+    return cycles
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    m = len(inst["components"])
+    if not isinstance(answer, str):
+        return False, "malformed type: expected one binary string"
+    if answer == "":
+        return False, "empty answer: expected a nonempty selector word"
+    if len(answer) < m:
+        return False, f"too short: expected {m} bits, got {len(answer)}"
+    if len(answer) > m:
+        return False, f"too long: expected {m} bits, got {len(answer)}"
+    bad = next((ch for ch in answer if ch not in "01"), None)
+    if bad is not None:
+        return False, f"non-binary symbol: {bad!r} is outside the alphabet 0,1"
+    if answer[0] != "0":
+        return False, "noncanonical complement: the first bit must be 0"
+    if "1" not in answer:
+        return False, "original decomposition: the all-zero selector reproduces X,Y"
+
+    if not _one_selected_cycle(inst, answer):
+        return False, "Z is disconnected: the selected cycle cover has multiple directed cycles"
+    if not _one_selected_cycle(inst, answer, complement=True):
+        return False, "W is disconnected: the complementary cover has multiple directed cycles"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    m = len(inst["components"])
+    tail = rng.randrange(1, 1 << (m - 1))
+    return "0" + format(tail, f"0{m - 1}b")
+
+
+def search_space(inst: dict) -> int | None:
+    m = len(inst["components"])
+    return (1 << (m - 1)) - 1
+
+
+def enumerate_all(inst: dict) -> int | None:
+    m = len(inst["components"])
+    if m > 20:
+        return None
+    count = 0
+    for tail in range(1, 1 << (m - 1)):
+        candidate = "0" + format(tail, f"0{m - 1}b")
+        if verify(inst, candidate)[0]:
+            count += 1
+    return count
+
+
+def _ordered_pair_code(x: list[int], y: list[int]) -> tuple[int, ...]:
+    """Canonical code for ordered directed cycles under vertex relabelling."""
+
+    n = len(x)
+    px = [0] * n
+    py = [0] * n
+    for i, v in enumerate(x):
+        px[v] = i
+    for i, v in enumerate(y):
+        py[v] = i
+    best: tuple[int, ...] | None = None
+    for sx, vertex in enumerate(x):
+        sy = py[vertex]
+        candidate = tuple((px[y[(sy + k) % n]] - sx) % n for k in range(n))
+        if best is None or candidate < best:
+            best = candidate
+    if best is None:
+        raise ValueError("empty tours have no canonical code")
+    return best
+
+
+def canonical_key(inst: dict) -> str:
+    """Key modulo vertex relabelling, tour rotations, and exchanging X,Y."""
+
+    x = list(inst["tour_x"])
+    y = list(inst["tour_y"])
+    code = min(_ordered_pair_code(x, y), _ordered_pair_code(y, x))
+    payload = ",".join(map(str, code)).encode("ascii")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Crowd the chord layout at fixed witness length before growing it."""
+
+    p = {k: v for k, v in params.items() if k != "_preset"}
+    n = _normalise_n(int(p.get("n", 192)))
+    nesting = int(p.get("nesting", 70))
+    if nesting < 98:
+        p["n"] = n
+        p["nesting"] = min(98, nesting + 20)
+        return p
+    # At n=192 the compact route already uses 287 elementary tests/assignments.
+    # More alternating components would cross G9(c)'s 300-operation no-tool cap.
+    return "cap_bound"
+
+
+def _energy(inst: dict, selector: str, counter: list[int] | None = None) -> int:
+    z, w = _selected_successors(inst, selector)
+    zc = _cycle_count(z, counter)
+    wc = _cycle_count(w, counter)
+    if zc is None or wc is None:
+        return 10**9
+    return zc + wc
+
+
+def _reference_best_improvement(
+    inst: dict, rng: random.Random, max_restarts: int = 4
+) -> tuple[str | None, dict]:
+    """Polynomial reference route using the paper's component-count energy.
+
+    It deliberately does not inspect chord crossings.  Each iteration evaluates
+    every legal one-bit neighbor by rebuilding and traversing both cycle covers.
+    On this distribution a mismatched hidden pair always supplies a decreasing
+    move, so a restart reaches energy two in at most m/2 improvements.
+    """
+
+    m = len(inst["components"])
+    counter = [0]
+    evaluations = 0
+    improvements = 0
+    for _restart in range(max_restarts):
+        bits = ["0"] + [str(rng.randrange(2)) for _ in range(m - 1)]
+        if "1" not in bits:
+            bits[-1] = "1"
+        current = "".join(bits)
+        current_energy = _energy(inst, current, counter)
+        evaluations += 1
+        while current_energy > 2 and improvements <= 2 * m:
+            best_energy = current_energy
+            best_word = None
+            for i in range(1, m):
+                trial = list(current)
+                trial[i] = "1" if trial[i] == "0" else "0"
+                word = "".join(trial)
+                value = _energy(inst, word, counter)
+                evaluations += 1
+                if value < best_energy:
+                    best_energy = value
+                    best_word = word
+            if best_word is None:
+                break
+            current = best_word
+            current_energy = best_energy
+            improvements += 1
+        if current_energy == 2 and verify(inst, current)[0]:
+            return current, {
+                "successor_visits": counter[0],
+                "energy_evaluations": evaluations,
+                "improvements": improvements,
+                "restarts": _restart + 1,
+            }
+    return None, {
+        "successor_visits": counter[0],
+        "energy_evaluations": evaluations,
+        "improvements": improvements,
+        "restarts": max_restarts,
+    }
+
+
+def _attack_outlier(inst: dict) -> str:
+    chords = _component_positions(inst)
+    choices = range(1, len(chords))
+    index = max(choices, key=lambda i: (chords[i][1] - chords[i][0], i))
+    bits = ["0"] * len(chords)
+    bits[index] = "1"
+    return "".join(bits)
+
+
+def _attack_local_arc_greedy(inst: dict) -> str:
+    xs = _tour_to_succ(inst["tour_x"])
+    ys = _tour_to_succ(inst["tour_y"])
+    pos = [0] * inst["n"]
+    for i, v in enumerate(inst["tour_x"]):
+        pos[v] = i
+    bits = []
+    for u, v in inst["components"]:
+        x_targets = tuple(sorted((pos[xs[u]], pos[xs[v]])))
+        y_targets = tuple(sorted((pos[ys[u]], pos[ys[v]])))
+        bits.append("1" if y_targets < x_targets else "0")
+    if bits[0] == "1":
+        bits = ["1" if bit == "0" else "0" for bit in bits]
+    if "1" not in bits:
+        bits[-1] = "1"
+    return "".join(bits)
+
+
+def _attack_random_restart(inst: dict, rng: random.Random, restarts: int = 256) -> str | None:
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate
+    return None
+
+
+def _attack_one_flip_descent(inst: dict) -> str:
+    # The original decomposition has energy two but is forbidden.  Every
+    # one-component move has the same worse energy, so this natural local route
+    # selects its first tie and stops at an invalid two-cycle state.
+    m = len(inst["components"])
+    best: str | None = None
+    best_energy = 10**9
+    for i in range(1, m):
+        bits = ["0"] * m
+        bits[i] = "1"
+        word = "".join(bits)
+        energy = _energy(inst, word)
+        if energy < best_energy:
+            best, best_energy = word, energy
+    return best or ("0" * m)
+
+
+def _relabel_instance(inst: dict, permutation: list[int]) -> dict:
+    out = dict(inst)
+    out["tour_x"] = [permutation[v] for v in inst["tour_x"]]
+    out["tour_y"] = [permutation[v] for v in inst["tour_y"]]
+    out["components"] = [
+        [permutation[u], permutation[v]] for u, v in inst["components"]
+    ]
+    return _add_derived_arrays(out)
+
+
+def _reorder_components(inst: dict, order: list[int]) -> dict:
+    out = dict(inst)
+    out["components"] = [inst["components"][i][:] for i in order]
+    answer = "".join(inst["answer"][i] for i in order)
+    if answer[0] == "1":
+        answer = "".join("1" if bit == "0" else "0" for bit in answer)
+    out["answer"] = answer
+    return _add_derived_arrays(out)
+
+
+def selftest() -> dict:
+    report: dict = {"paper": "1901.09651", "track": TRACK}
+
+    g1_attempts = 0
+    g1_failures: list[str] = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7, 23):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append(f"{preset}/{seed}: {reason}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append(f"{preset}/{seed}: answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    demo = make_instance(seed=11, **DIFFICULTY["demo"])
+    ans = demo["answer"]
+    zero = ans.index("0", 1) if "0" in ans[1:] else None
+    one = ans.index("1")
+    if zero is None:
+        raise AssertionError("demo answer needs both symbols for corruption tests")
+    swapped = list(ans)
+    swapped[zero], swapped[one] = swapped[one], swapped[zero]
+    corruptions = {
+        "drop_one": ans[:-1],
+        "swap_two": "".join(swapped),
+        "duplicate_one": ans + ans[-1],
+        "empty": "",
+        "out_of_range": ans[:2] + "2" + ans[3:],
+    }
+    corruption_reasons = {name: verify(demo, value)[1] for name, value in corruptions.items()}
+    corruption_rejected = all(not verify(demo, value)[0] for value in corruptions.values())
+    report["G2_rejects_corruption"] = {
+        "pass": corruption_rejected and len(set(corruption_reasons.values())) == 5,
+        "reasons": corruption_reasons,
+    }
+
+    model_style = (
+        "The alternating choices give the following selector.\n\n"
+        f"<answer>\n```text\n{ans}\n```\n</answer>\n"
+        "This makes both complementary covers connected."
+    )
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": parsed == ans and verify(demo, parsed)[0],
+        "parsed": parsed,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=314159, **shipping_params)
+    sample_rng = random.Random(271828)
+    sample_total = 200_000
+    sample_hits = 0
+    for _ in range(sample_total):
+        if verify(shipping, random_candidate(shipping, sample_rng))[0]:
+            sample_hits += 1
+    sampled_fraction = sample_hits / sample_total
+    report["G4_guess_resistance"] = {
+        "pass": sampled_fraction < 1e-6,
+        "hits": sample_hits,
+        "total": sample_total,
+        "sampled_probability": sampled_fraction,
+        "candidate_space": search_space(shipping),
+        "structure_aware": True,
+    }
+
+    m = len(shipping["components"])
+    blocks = m // 2
+    exact_valid = (1 << (blocks - 1)) - 1
+    exact_space = search_space(shipping)
+    demo_exact = enumerate_all(demo)
+    demo_expected = (1 << (len(demo["components"]) // 2 - 1)) - 1
+    reference_runs = []
+    reference_successes = 0
+    reference_start = time.perf_counter()
+    for seed in range(8):
+        inst = make_instance(seed=7000 + seed, **shipping_params)
+        candidate, stats = _reference_best_improvement(inst, random.Random(8000 + seed))
+        solved = candidate is not None and verify(inst, candidate)[0]
+        reference_successes += int(solved)
+        reference_runs.append({"seed": seed, "solved": solved, **stats})
+    reference_wall = time.perf_counter() - reference_start
+    reference_operations = sum(row["successor_visits"] for row in reference_runs)
+    reference_iterations = sum(row["improvements"] for row in reference_runs)
+    report["G5_density_and_baseline"] = {
+        "pass": (
+            sampled_fraction < 1e-6
+            and reference_successes == 8
+            and demo_exact == demo_expected
+        ),
+        "demo_bruteforce_valid_answers": demo_exact,
+        "demo_composition_count": demo_expected,
+        "shipping_exact_valid_answers": exact_valid,
+        "shipping_exact_candidate_space": exact_space,
+        "shipping_exact_solution_fraction": exact_valid / exact_space,
+        "shipping_sampled_valid_hits": sample_hits,
+        "shipping_sampled_valid_total": sample_total,
+        "shipping_sampled_valid_fraction": sampled_fraction,
+        "reference_algorithm_wall_clock_sec": round(reference_wall, 6),
+        "reference_algorithm_successor_visits": reference_operations,
+        "reference_algorithm_iterations": reference_iterations,
+    }
+
+    attacks = {
+        "outlier_longest_chord": {"successes": 0, "attempts": 8},
+        "greedy_local_arc_order": {"successes": 0, "attempts": 8},
+        "random_restart_256": {"successes": 0, "attempts": 8},
+        "in_context_one_flip_energy_descent": {"successes": 0, "attempts": 8},
+    }
+    for seed in range(8):
+        inst = make_instance(seed=9000 + seed, **shipping_params)
+        candidates = {
+            "outlier_longest_chord": _attack_outlier(inst),
+            "greedy_local_arc_order": _attack_local_arc_greedy(inst),
+            "random_restart_256": _attack_random_restart(
+                inst, random.Random(10000 + seed), 256
+            ),
+            "in_context_one_flip_energy_descent": _attack_one_flip_descent(inst),
+        }
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(inst, candidate)[0]:
+                attacks[name]["successes"] += 1
+    report["G6_adversary_panel"] = {
+        "pass": all(row["successes"] == 0 for row in attacks.values()),
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "best-improvement component-count search (Algorithms 1-3 energy)",
+            "complexity": "O(n m^2) exact for m alternating components",
+            "wall_clock_sec": round(reference_wall, 6),
+            "operations": reference_operations,
+            "iterations": reference_iterations,
+            "solves": f"{reference_successes}/8, as expected for Track B",
+        },
+    }
+
+    doubled = make_instance(
+        n=2 * shipping_params["n"],
+        nesting=shipping_params["nesting"],
+        seed=424242,
+    )
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] > shipping["n"],
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "doubled_answer_bits": len(doubled["answer"]),
+        "verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    transform_verifications = 0
+    invariant_ok = True
+    distinct_keys: list[str] = []
+    for seed in range(20):
+        inst = make_instance(seed=12000 + seed, **shipping_params)
+        base_key = canonical_key(inst)
+        distinct_keys.append(base_key)
+        rng = random.Random(13000 + seed)
+        permutation = list(range(inst["n"]))
+        rng.shuffle(permutation)
+        relabelled = _relabel_instance(inst, permutation)
+        rotated = dict(relabelled)
+        ax = rng.randrange(inst["n"])
+        ay = rng.randrange(inst["n"])
+        rotated["tour_x"] = rotated["tour_x"][ax:] + rotated["tour_x"][:ax]
+        rotated["tour_y"] = rotated["tour_y"][ay:] + rotated["tour_y"][:ay]
+        swapped_inst = dict(rotated)
+        swapped_inst["tour_x"], swapped_inst["tour_y"] = (
+            rotated["tour_y"],
+            rotated["tour_x"],
+        )
+        _add_derived_arrays(swapped_inst)
+        order = list(range(len(inst["components"])))
+        rng.shuffle(order)
+        composed = _reorder_components(swapped_inst, order)
+        variants = [relabelled, rotated, swapped_inst, composed]
+        for variant in variants:
+            invariance_checks += 1
+            invariant_ok &= canonical_key(variant) == base_key
+        for variant in (relabelled, rotated, swapped_inst):
+            transform_verifications += 1
+            invariant_ok &= verify(variant, inst["answer"])[0]
+        transform_verifications += 1
+        invariant_ok &= verify(composed, composed["answer"])[0]
+    all_distinct = len(set(distinct_keys)) == len(distinct_keys)
+    report["G8_canonical_key"] = {
+        "pass": invariant_ok and all_distinct,
+        "invariance_checks": invariance_checks,
+        "transform_verifications": transform_verifications,
+        "unrelated_instances": len(distinct_keys),
+        "distinct_keys": len(set(distinct_keys)),
+    }
+
+    answer_blob = json.dumps(shipping["answer"])
+    answer_chars = len(answer_blob)
+    answer_tokens_conservative = answer_chars  # one character per token is a safe upper bound
+    answer_elements = len(shipping["answer"])  # semantic selector bits, not Python leaves
+    intended_ops = 3 * (m - 1) + 2
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    hinted = G9_ARMS["hinted"]
+    placebo = G9_ARMS["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": G9_ARMS,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": "recorded, not gated" if hinted["attempts"] else "pending",
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens_conservative,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gate_values = [v for k, v in report.items() if k.startswith("G")]
+    report["all_passed"] = all(value.get("pass") for value in gate_values)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
