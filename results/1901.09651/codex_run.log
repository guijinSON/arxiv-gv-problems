   634	def _attack_minimum_span(inst, _rng):
   635	    pos = _positions(inst)
   636	    n = inst["vertex_count"]
   637	    scored = []
   638	    for index, component in enumerate(inst["switch_components"]):
   639	        at = sorted(pos[v] for v in component)
   640	        gaps = [at[1] - at[0], at[2] - at[1], n - at[2] + at[0]]
   641	        scored.append((min(gaps), sum(gaps_i * gaps_i for gaps_i in gaps), index))
   642	    return sorted(index for _, _, index in sorted(scored)[:inst["select_count"]])
   643	
   644	
   645	def _attack_successor_distance(inst, _rng):
   646	    pos = _positions(inst)
   647	    ys = _cycle_successor(inst["tour_y"])
   648	    n = inst["vertex_count"]
   649	    scored = []
   650	    for index, component in enumerate(inst["switch_components"]):
   651	        distance = 0
   652	        for v in component:
   653	            d = (pos[ys[v]] - pos[v]) % n
   654	            distance += min(d, n - d)
   655	        scored.append((distance, index))
   656	    return sorted(index for _, index in sorted(scored)[:inst["select_count"]])
