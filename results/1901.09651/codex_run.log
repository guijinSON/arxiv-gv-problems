   461	def parse_answer(text: str) -> object | None:
   462	    try:
   463	        if not isinstance(text, str):
   464	            return None
   465	        match = re.search(r"<answer>(.*?)</answer>", text, re.IGNORECASE | re.DOTALL)
   466	        if not match:
   467	            return None
   468	        body = match.group(1).strip()
   469	        body = re.sub(r"^```(?:text|txt)?\s*", "", body, flags=re.IGNORECASE)
   470	        body = re.sub(r"\s*```$", "", body).strip()
   471	        body = re.sub(r"\s+", "", body)
   472	        if not body or re.fullmatch(r"[01]+", body) is None:
   473	            return None
   474	        return body
   475	    except Exception:
   476	        return None
