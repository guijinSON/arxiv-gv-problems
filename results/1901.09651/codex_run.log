   219	def _derive_components(x: list[int], y: list[int]) -> list[list[int]]:
   220	    """Alternating cycles of two degree-two bipartite matching unions.
   221	
   222	    In this family each alternating cycle has two left/source vertices, so the
   223	    permutation x^{-1} y consists of transpositions.
   224	    """
   225	
   226	    xs = _tour_to_succ(x)
   227	    ys = _tour_to_succ(y)
   228	    inv_x = [-1] * len(x)
   229	    for u, v in enumerate(xs):
   230	        inv_x[v] = u
   231	    q = [inv_x[ys[u]] for u in range(len(x))]
   232	    seen: set[int] = set()
   233	    components: list[list[int]] = []
   234	    for u in range(len(x)):
   235	        if u in seen:
   236	            continue
   237	        v = q[u]
   238	        if v == u or v < 0 or v >= len(x) or q[v] != u:
   239	            raise ValueError("the constructed matching union is not transpositional")
   240	        seen.add(u)
   241	        seen.add(v)
   242	        components.append([u, v])
   243	    return components
