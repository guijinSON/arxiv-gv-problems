@@ -0,0 +1,40 @@
+import random,itertools
+
+def comp(q,r): return tuple(q[r[i]] for i in range(len(q)))
+def ncycles(p):
+    seen=set(); cs=[]
+    for i in range(len(p)):
+        if i not in seen:
+            c=[]; x=i
+            while x not in seen:
+                seen.add(x); c.append(x); x=p[x]
+            cs.append(c)
+    return cs
+
+def random_r(n,m,size,rng):
+    a=list(range(n)); rng.shuffle(a)
+    r=list(range(n)); blocks=[]
+    for j in range(m):
+        b=a[j*size:(j+1)*size]; blocks.append(b)
+        for u,v in zip(b,b[1:]+b[:1]):r[u]=v
+    return tuple(r),blocks
+
+rng=random.Random(4)
+for size in (2,3,4):
+  for m in range(3,9):
+    n=m*size;q=tuple(range(1,n))+(0,)
+    best=None
+    for trial in range(200000):
+        r,blocks=random_r(n,m,size,rng)
+        if len(ncycles(comp(q,r)))!=1:continue
+        valid=[]
+        for mask in range(1<<m):
+            rs=list(range(n))
+            for j,b in enumerate(blocks):
+                if mask>>j&1:
+                    for u,v in zip(b,b[1:]+b[:1]):rs[u]=v
+            if len(ncycles(comp(q,rs)))==1:
+                valid.append(mask)
+        if best is None or len(valid)<best[0]:best=(len(valid),valid,blocks)
+        if len(valid)<=4:break
+    if best:print(size,m,best[0],best[1],best[2])
