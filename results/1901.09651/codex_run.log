   207	def _is_pyramidal(tour: list[int]) -> bool:
   208	    """Paper's pyramidal condition, with labels shifted from 1..n to 0..n-1."""
   209	
   210	    n = len(tour)
   211	    start = tour.index(0)
   212	    ordered = tour[start:] + tour[:start]
   213	    peak = ordered.index(n - 1)
   214	    return all(ordered[i] < ordered[i + 1] for i in range(peak)) and all(
   215	        ordered[i] > ordered[i + 1] for i in range(peak, n - 1)
   216	    )
