   710	def _reverse_instance_with_answer(inst):
   711	    """Reverse every arc and carry the selected complementary decomposition."""
   712	    data, why = _instance_data(inst)
   713	    if data is None:
   714	        raise ValueError(why)
   715	    z, _ = _pair_successors(data, set(inst["answer"]))
   716	    z_cycle = _one_cycle_list(z)
   717	    if z_cycle is None:
   718	        raise ValueError("cannot reverse a non-Hamiltonian carried witness")
   719	
   720	    out = _copy_instance(inst)
   721	    out["tour_x"] = _reverse_cycle(out["tour_x"])
   722	    out["tour_y"] = _reverse_cycle(out["tour_y"])
   723	    z_reversed = _reverse_cycle(z_cycle)
   724	    n = out["vertex_count"]
   725	    xs = _cycle_successor(out["tour_x"])
   726	    ys = _cycle_successor(out["tour_y"])
   727	    zs = _cycle_successor(z_reversed)
   728	    pred_x = [0] * n
   729	    for v, target in xs.items():
   730	        pred_x[target] = v
   731	    relative = [pred_x[ys[v]] for v in range(n)]
   732	    components = [list(block) for block in _orbit_sets(relative)]
   733	    selected_tails = {
   734	        v for v in range(n) if xs[v] != ys[v] and zs[v] == ys[v]
   735	    }
   736	    out["switch_components"] = components
   737	    out["answer"] = sorted(
   738	        index for index, block in enumerate(components)
   739	        if set(block) <= selected_tails
   740	    )
   741	    return out
