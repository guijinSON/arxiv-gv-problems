   663	def _attack_orientation_agreement(inst, _rng):
   664	    px = _positions(inst)
   665	    py = {v: i for i, v in enumerate(inst["tour_y"])}
   666	    scored = []
   667	    for index, component in enumerate(inst["switch_components"]):
   668	        xorder = sorted(component, key=px.get)
   669	        yranks = [py[v] for v in xorder]
   670	        inversions = sum(yranks[i] > yranks[j]
   671	                         for i in range(3) for j in range(i + 1, 3))
   672	        scored.append((inversions, index))
   673	    return sorted(index for _, index in sorted(scored)[:inst["select_count"]])
