   614	def canonical_key(inst: dict) -> str:
   615	    """Key modulo vertex relabelling, tour rotations, and exchanging X,Y."""
   616	
   617	    x = list(inst["tour_x"])
   618	    y = list(inst["tour_y"])
   619	    code = min(_ordered_pair_code(x, y), _ordered_pair_code(y, x))
   620	    payload = ",".join(map(str, code)).encode("ascii")
   621	    return hashlib.sha256(payload).hexdigest()
