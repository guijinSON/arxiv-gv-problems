   744	def _solution_count_formula(tiles):
   745	    # Coefficient of x^tiles in (1+x+x^3+x^4)^tiles.  The four exponents
   746	    # are exactly the locally Hamiltonian masks 0000,0001,1110,1111.
   747	    dp = [1] + [0] * (4 * tiles)
   748	    for _ in range(tiles):
   749	        nxt = [0] * len(dp)
   750	        for degree, value in enumerate(dp):
   751	            if value:
   752	                for weight in (0, 1, 3, 4):
   753	                    nxt[degree + weight] += value
   754	        dp = nxt
   755	    return dp[tiles]
