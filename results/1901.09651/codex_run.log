   662	    improvements = 0
   663	    for _restart in range(max_restarts):
   664	        bits = ["0"] + [str(rng.randrange(2)) for _ in range(m - 1)]
   665	        if "1" not in bits:
   666	            bits[-1] = "1"
   667	        current = "".join(bits)
   668	        current_energy = _energy(inst, current, counter)
   669	        evaluations += 1
   670	        while current_energy > 2 and improvements <= 2 * m:
   671	            best_energy = current_energy
   672	            best_word = None
   673	            for i in range(1, m):
   674	                trial = list(current)
   675	                trial[i] = "1" if trial[i] == "0" else "0"
   676	                word = "".join(trial)
   677	                value = _energy(inst, word, counter)
   678	                evaluations += 1
   679	                if value < best_energy:
   680	                    best_energy = value
   681	                    best_word = word
