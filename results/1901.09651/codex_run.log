   373	\begin{algorithm}[t]
   374	    \label{simmanneal}
   375		\caption{Simulated Annealing Algorithm}
   376		\SetKwInOut{Input}{Input}
   377		\SetKwInOut{Output}{Output}
   378		\SetKwData{x}{$x$}
   379		\SetKwData{y}{$y$}
   380		\SetKwData{combinedGraph}{$combG$}
