   436	def verify(inst, answer):
   437	    """Check any certificate in the declared switch language; never read answer."""
   438	    data, why = _instance_data(inst)
   439	    if data is None:
   440	        return False, why
   441	    _, xs, ys, components, choose = data
   442	    if not isinstance(answer, list):
   443	        return False, "answer must be a JSON list"
   444	    if not answer:
   445	        return False, "answer must not be empty"
   446	    if len(answer) != choose:
   447	        return False, f"expected exactly {choose} component indices"
   448	    if any(not _is_int(v) for v in answer):
   449	        return False, "every component index must be an integer"
   450	    if len(set(answer)) != len(answer):
   451	        return False, "component indices must be distinct"
   452	    if any(v < 0 or v >= len(components) for v in answer):
   453	        return False, f"component index outside 0..{len(components) - 1}"
   454	    if answer != sorted(answer):
   455	        return False, "component indices must be in strictly increasing order"
   456	
   457	    zc, wc = _pair_cycle_counts(data, set(answer))
   458	    if zc != 1:
   459	        return False, f"the selected tour has {zc} directed cycles, not one"
   460	    if wc != 1:
   461	        return False, f"the complementary tour has {wc} directed cycles, not one"
   462	    # The language requires a nonempty proper subset of nontrivial relative
   463	    # cycles, so both successor permutations differ from both inputs.
   464	    return True, "ok"
