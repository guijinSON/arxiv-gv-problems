   577	def canonical_key(inst):
   578	    data, why = _instance_data(inst)
   579	    if data is None:
   580	        raise ValueError(why)
   581	    x, y = inst["tour_x"], inst["tour_y"]
   582	    xr, yr = _reverse_cycle(x), _reverse_cycle(y)
   583	    code = min(
   584	        _relative_code(x, y),
   585	        _relative_code(y, x),
   586	        _relative_code(xr, yr),
   587	        _relative_code(yr, xr),
   588	    )
   589	    payload = json.dumps(
   590	        [inst["vertex_count"], inst["select_count"], code],
   591	        separators=(",", ":"),
   592	    ).encode()
   593	    return hashlib.sha256(payload).hexdigest()
