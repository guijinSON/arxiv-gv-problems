   547	def enumerate_all(inst):
   548	    space = search_space(inst)
   549	    if space > 200_000:
   550	        return None
   551	    data, _ = _instance_data(inst)
   552	    count = 0
   553	    for candidate in itertools.combinations(range(len(data[3])), data[4]):
