   479	def _selected_successors(inst: dict, selector: str) -> tuple[list[int], list[int]]:
   480	    xs = inst.get("succ_x") or _tour_to_succ(inst["tour_x"])
   481	    ys = inst.get("succ_y") or _tour_to_succ(inst["tour_y"])
   482	    z = [-1] * inst["n"]
   483	    w = [-1] * inst["n"]
   484	    for bit, (u, v) in zip(selector, inst["components"]):
   485	        if bit == "0":
   486	            z[u], z[v] = xs[u], xs[v]
   487	            w[u], w[v] = ys[u], ys[v]
   488	        else:
   489	            z[u], z[v] = ys[u], ys[v]
   490	            w[u], w[v] = xs[u], xs[v]
   491	    return z, w
   492	
   493	
   494	def _one_selected_cycle(inst: dict, selector: str, complement: bool = False) -> bool:
   495	    """Test connectivity without materialising a cover.
   496	
   497	    A component bit always chooses an entire alternating matching component, so
   498	    indegree and outdegree one are already guaranteed.  It is therefore enough
   499	    to traverse the orbit of vertex 0 and require its first return after n arcs.
   500	    """
   501	
   502	    xs = inst.get("succ_x") or _tour_to_succ(inst["tour_x"])
   503	    ys = inst.get("succ_y") or _tour_to_succ(inst["tour_y"])
   504	    component_of = inst.get("component_of")
   505	    if component_of is None:
   506	        component_of = [-1] * inst["n"]
   507	        for i, (u, v) in enumerate(inst["components"]):
   508	            component_of[u] = component_of[v] = i
   509	    seen = [False] * inst["n"]
   510	    u = 0
   511	    steps = 0
   512	    while 0 <= u < inst["n"] and not seen[u]:
   513	        seen[u] = True
   514	        steps += 1
   515	        bit = selector[component_of[u]]
   516	        choose_y = (bit == "1") ^ complement
   517	        u = ys[u] if choose_y else xs[u]
   518	    return u == 0 and steps == inst["n"]
   519	
