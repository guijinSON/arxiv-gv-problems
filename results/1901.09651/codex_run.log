   648	def _reference_best_improvement(
   649	    inst: dict, rng: random.Random, max_restarts: int = 4
   650	) -> tuple[str | None, dict]:
   651	    """Polynomial reference route using the paper's component-count energy.
   652	
   653	    It deliberately does not inspect chord crossings.  Each iteration evaluates
   654	    every legal one-bit neighbor by rebuilding and traversing both cycle covers.
   655	    On this distribution a mismatched hidden pair always supplies a decreasing
   656	    move, so a restart reaches energy two in at most m/2 improvements.
   657	    """
