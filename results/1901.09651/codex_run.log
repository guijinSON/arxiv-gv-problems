   388		\SetKwData{wCand}{$wCand$}
   389		\SetKwData{currentEnergy}{$currE$}
   390		%\SetKwData{P}{$P$}
   391		\SetKwData{z}{$z$}
   392		\SetKwData{w}{$w$}
   393		\SetKwData{k}{$k$}
   394		\SetKwData{true}{true}
   395		\SetKwData{false}{false}
