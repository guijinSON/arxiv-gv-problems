   515	def parse_answer(text):
   516	    if not isinstance(text, str):
   517	        return None
   518	    matches = _ANSWER_RE.findall(text)
   519	    if not matches:
   520	        return None
   521	    body = matches[-1].strip()
   522	    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
   523	    body = re.sub(r"\s*```$", "", body)
   524	    try:
   525	        value = json.loads(body)
   526	    except (TypeError, ValueError):
   527	        return None
   528	    return value if isinstance(value, list) else None
