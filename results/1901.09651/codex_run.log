+def _relative_code(first, second):
+    n = len(first)
+    fs = _cycle_successor(first)
+    ss = _cycle_successor(second)
+    pos = {v: i for i, v in enumerate(first)}
+    raw = [pos[ss[first[i]]] for i in range(n)]
