+def _compact_invariant_witness(inst: dict) -> tuple[str | None, dict]:
+    """Construct a witness from the rendered chord data alone.
+
+    In every generated block the two crossing chords start at consecutive
+    positions in tour X.  If a chord starts at ``a`` and another at ``a+1``,
+    they are the crossing pair precisely when the first chord closes first.
+    A complete nested child block can also start at ``a+1``, but it closes
+    before its parent and therefore fails that final comparison.
+
+    Dictionary construction and writing the output word are bookkeeping, not
+    exact arithmetic.  The reported G9 cost counts one integer addition for
+    each tested start and one endpoint comparison whenever ``a+1`` is another
+    start.  It is bounded by ``2*m`` and never inspects ``inst['answer']``.
+    """
+
+    chords = _component_positions(inst)
+    by_start = {a: (i, b) for i, (a, b) in enumerate(chords)}
+    additions = 0
+    comparisons = 0
+    tested = 0
+    for i, (a, b) in enumerate(chords):
+        tested += 1
+        additions += 1
+        other = by_start.get(a + 1)
+        if other is None:
+            continue
+        j, d = other
+        comparisons += 1
+        if i != 0 and j != 0 and b < d:
+            bits = ["0"] * len(chords)
+            bits[i] = bits[j] = "1"
+            return "".join(bits), {
+                "exact_operations": additions + comparisons,
+                "additions": additions,
+                "comparisons": comparisons,
+                "components_tested": tested,
+                "operation_upper_bound": 2 * len(chords),
+            }
+    return None, {
+        "exact_operations": additions + comparisons,
+        "additions": additions,
+        "comparisons": comparisons,
+        "components_tested": tested,
+        "operation_upper_bound": 2 * len(chords),
+    }
+
+
