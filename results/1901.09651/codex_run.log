   596	def escalate(params):
   597	    q = dict(params)
   598	    padding = int(q.get("padding", 2))
   599	    tiles = int(q.get("n", 13))
   600	    if padding < 8:
   601	        q["padding"] = padding + 1
   602	        q["n"] = tiles
   603	        return q
   604	    if tiles < 240:
   605	        q["n"] = min(240, tiles + max(2, tiles // 5))
   606	        q["padding"] = padding
   607	        return q
   608	    return "cap_bound"
