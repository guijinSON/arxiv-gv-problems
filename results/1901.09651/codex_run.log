   397		\SetKwData{and}{$AND$}
   398		\SetKwData{SimulatedAnnealing}{$SimulatedAnnealing$}
   399		\SetKwData{getInitialState}{$GetInitialState$}
   400		\SetKwData{calculateEnergy}{$CalculateEnergy$}
   401		\SetKwData{transitToNewState}{$TransitToNewState$}
   402		\SetKwData{generateNeighbourCandidate}{$GenerateNeighbourCandidate$}
   403		\SetKwFunction{shouldAcceptCandidate}{$ShouldAcceptCandidate$}
   404		\SetKwFunction{coolingSchedule}{$CoolingSchedule$}
   405		\SetKwData{TestVertexAdjacency}{$TestVertexAdjacency$}
   406		
   407		\Input{ 
   408		    Hamiltonian tours \x and \y (or $2$/$4$-regular graph \combinedGraph), \newline 
   409		    initial temperature \startTemp, %and final temperature \finishTemp, 
   410		    number of iterations \numOfIterations, size of a queue of fixed edges \numOfEdgesToFix
   411		    %циклы \x и \y (или 2/4"~регулярный граф \combinedGraph), \newline 
   412		    %начальная температура \startTemp и конечная температура \finishTemp, \newline
   413		    %число итераций \numOfIterations, \newline 
   414		    %число зафиксированных рёбер \numOfEdgesToFix
   415		}
   416		\Output{ vertices $x^v$ and $y^v$ are adjacent or not adjacent, complementary Hamiltonian tours \z and \w, if exist}
   417		\BlankLine
   418		\Proc{\SimulatedAnnealing{\x, \y, \combinedGraph, \startTemp, 
   419		%\numOfEdgesToExchage, \numOfAnswersToGenerate,
   420		\numOfEdgesToFix}}{
   421		    \T $\leftarrow$ \startTemp\;
   422			\z, \w $\leftarrow$ \getInitialState{\x, \y, \combinedGraph}\;
   423				
   424			\For{$k\leftarrow 1$ \KwTo \numOfIterations}{
   425			    %\For{$a\leftarrow 1$ \KwTo \numOfAnswersToGenerate}{
   426	    		    \If{\z and \w are Hamiltonian tours different from \x and \y}{
   427	    		        \Return \z and \w\;
   428	    		    }
   429	    		  
   430			        \zCand, \wCand $\leftarrow$ \generateNeighbourCandidate{\z, \w, \numOfEdgesToFix}\;
   431	    		    \candidateEnergy $\leftarrow$ \calculateEnergy{\zCand, \wCand} \;
   432	    		    
   433	    		    \If{\candidateEnergy \textless \currentEnergy \KwOr \shouldAcceptCandidate{}}{
   434	    		        \z $\leftarrow$ \zCand, \w $\leftarrow$ \wCand\;
   435	    		    }
   436	    		   
   437	    		    \T $\leftarrow$ \coolingSchedule{\k}\;
   438	    		  
   439	    		%    \If{\T \textless \finishTemp}{
   440	    		%        \Return no complementary tours found;
   441	    		%    }
   442			    %}
   443			}
   444			\Return no complementary tours found;
   445	  }\;
   446	\Proc{\TestVertexAdjacency{\x, \y, \combinedGraph, \startTemp, \numOfEdgesToFix}}{
   447		\z, \w  $\leftarrow$ \SimulatedAnnealing{\x, \y, \combinedGraph, \startTemp, \numOfEdgesToFix}
   448		
   449		\eIf{\z and \w are not empty}{
   450			\Return vertices $x^v$ and $y^v$ are not adjacent\;
   451		}{
   452			\Return vertices $x^v$ and $y^v$  are probably adjacent\;
   453		}
   454	}
   455	\end{algorithm}
