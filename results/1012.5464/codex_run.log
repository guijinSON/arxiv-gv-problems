+def _columns(block: dict) -> list[int]:
+    rows = _ints(block)
+    out = []
+    for c in range(36):
+        syndrome = 0
+        for r, row in enumerate(rows):
+            syndrome |= (((row >> c) & 1) << r)
+        out.append(syndrome)
+    return out
