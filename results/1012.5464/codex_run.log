+def _b_enumerator(m: int) -> list[int]:
+    # A sum of t generator rows has weight 2t when t is even, and m when t
+    # is odd.  This proves the decoys have no word of weight six.
+    out = [0] * (2 * m + 1)
+    for t in range(m + 1):
+        out[2 * t if t % 2 == 0 else m] += math.comb(m, t)
+    return out
+
