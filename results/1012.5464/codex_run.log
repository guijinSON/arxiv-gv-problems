# Figure 1 of arXiv:1012.5464.  The target generator is (I_18, M).
_FIGURE1_M = (
    "001100000010100010",
    "001100000010101101",
    "000110000001110101",
    "000110000001000110",
    "001000000001100101",
    "001000000010011001",
