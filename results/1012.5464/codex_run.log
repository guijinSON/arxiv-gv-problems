+            syndrome ^= candidate_columns[candidate[0]][coordinate]
+        hits += int(syndrome == 0)
+    guess_sec = time.perf_counter() - t0
+    exact_solutions = sum(block["weight_enumerator"][6]
+                          for block in inst["blocks"])
+    exact_space = search_space(inst)
