+def _recipe_enumerator(parts: tuple[int, ...]) -> tuple[int, ...]:
+    out = [1]
+    for m in parts:
+        out = _poly_mul(out, _b_enumerator(m))
+    out += [0] * (37 - len(out))
+    return tuple(out[:37])
 
 
