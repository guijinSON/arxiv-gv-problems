+        for _ in range(rank):
+            for _try in range(20_000):
+                vec = _sample_weight_vector(rng, k, weight)
+                if any((vec & u).bit_count() & 1 for u in ucols):
+                    continue
+                if not ((vec & answer_bits).bit_count() & 1):
+                    continue
+                if _rank_vectors(vcols + [vec], k) != len(vcols) + 1:
+                    continue
