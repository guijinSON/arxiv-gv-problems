+    if len(rows) != 18:
+        raise ValueError("an enumerated code must have dimension 18")
+    counts = [0] * 37
+    word = 0
+    previous_gray = 0
+    counts[0] = 1
+    for index in range(1, 1 << 18):
+        gray = index ^ (index >> 1)
+        changed = gray ^ previous_gray
+        word ^= rows[changed.bit_length() - 1]
+        counts[word.bit_count()] += 1
+        previous_gray = gray
+    return tuple(counts)
