+                            "xor_operations": xor_operations,
+                            "collision_checks": collision_checks,
+                            "operations": xor_operations + collision_checks,
+                        }
+            seen.setdefault(syndrome, []).append(triple)
+    return None, {
+        "triple_syndromes": triple_count,
+        "xor_operations": xor_operations,
+        "collision_checks": collision_checks,
