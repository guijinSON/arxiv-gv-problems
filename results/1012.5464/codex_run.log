+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "Seven integers [block,c1,c2,c3,c4,c5,c6]: block is a displayed "
+        "0-based block index, and 0 <= c1 < ... < c6 < 36 are distinct "
+        "0-based coordinate indices."
+    ),
