+
+def _decoy_counts(n_decoys: int, seed: int) -> tuple[int, ...]:
+    choices = list(_weak_compositions(n_decoys, len(_DECOY_RECIPES)))
+    return choices[abs(int(seed)) % len(choices)]
+
+
+def _make_transformed_block(
+    base_rows: list[int],
+    enumerator: tuple[int, ...],
+    kind: str,
+    rng: random.Random,
+    rounds: int,
+    order: list[int] | None = None,
+    constrained_coeff: int | None = None,
