+    }
+
+    guess_rng = random.Random(1012546401)
+    sample_total = 200_000
+    hits = 0
+    candidate_columns = [_columns(block) for block in inst["blocks"]]
+    t0 = time.perf_counter()
+    for _ in range(sample_total):
