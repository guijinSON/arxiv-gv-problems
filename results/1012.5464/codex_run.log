+        "duplicate": [good[0], good[1], good[1]] + good[3:],
+        "empty": [],
+        "out_of_range": [len(inst["blocks"])] + good[1:],
+    }
+    rejection_reasons = {}
+    for name, candidate in corruptions.items():
