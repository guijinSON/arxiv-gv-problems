        for name in ("bare", "hinted", "placebo")
    }
    oracle_ready = all(arms[name]["attempts"] >= 3 for name in arms)
    hinted_hardened = (
        G9_ORACLE_RESULTS.get("hinted_verdict") == "hardened"
