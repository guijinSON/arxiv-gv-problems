        # A tiny non-proportional offset prevents the displayed rational
        # coordinates from cancelling the large scalar.
        delta = 1 if hyp == 5 else 1 + 2 * rng.randrange(1, 16)
        scale = (3 * scalar * hyp) // 5 + delta

