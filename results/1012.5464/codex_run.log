+    "placebo": {"solved": 0, "attempts": 0, "errors": 4},
+    "hinted_verdict": "unscored_openrouter_403",
+}
+
+
+def selftest() -> dict:
+    report: dict = {}
+
+    enumerator_checks = {
+        "figure1": _bruteforce_enumerator(_figure1_rows()) == _TARGET_ENUM,
