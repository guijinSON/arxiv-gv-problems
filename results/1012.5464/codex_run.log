+def _block_is_self_dual(block: dict) -> bool:
+    rows = _ints(block)
+    if len(rows) != 18 or _gf2_rank(rows) != 18:
+        return False
+    return all(
+        ((rows[i] & rows[j]).bit_count() % 2) == 0
+        for i in range(18)
+        for j in range(i, 18)
