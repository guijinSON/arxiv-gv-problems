+        "permute": True,
+    },
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+# Scratch G9 runs set this flag after copying the exact shipping module.
+if os.environ.get("GV_G9_SINGLE") == "1":
+    DIFFICULTY = {
