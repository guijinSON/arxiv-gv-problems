+                return True, {
+                    "pair_syndromes": pair_syndromes,
+                    "pair_collision_checks": collision_checks,
+                }
+        seen.setdefault(syndrome, []).append((i, j))
+    return False, {
+        "pair_syndromes": pair_syndromes,
+        "pair_collision_checks": collision_checks,
+    }
