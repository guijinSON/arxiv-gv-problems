index 0000000000000000000000000000000000000000..b5ef7fd5c94e5512a63c62e4b9c229729c8de780
--- /dev/null
+++ b/gen_1012_5464.py
@@ -0,0 +1,885 @@
+"""Verified generator for recovering a self-dual-code extension column.
+
+Harada and Munemasa, arXiv:1012.5464, Section 2.1, construct a binary
+self-dual code two coordinates at a time.  Their codimension-one subcode has
+generator [G1 | a | a], where G1 generates a shorter self-dual code and a is
+a column over F_2.  This module changes the row basis by an invertible matrix
+L, displays [L G1 | b | b] with b=L a, and asks for the original a.
+
+The answer is inverse-generated.  The checker independently substitutes it
+in L a=b over F_2 and never reads the planted answer.  The ordinary recovery
+algorithm is Gaussian elimination; the deliberately structured row-basis
+change gives a much shorter no-tool route if its low-rank invariant is seen.
+"""
+
+from __future__ import annotations
+
+import functools
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import Counter
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "matrix_certificate",
+    "native_objects": [
+        "binary self-dual code generator matrix",
+        "row-basis matrix over F_2",
+        "repeated extension column over F_2",
+    ],
+    "verification_operations": [
+        "exact matrix-vector multiplication over F_2",
+        "exact binary equality",
+        "exact generator-row inner products over F_2",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "Recognize that the row-basis matrix is identity plus a rank-two "
+        "nilpotent correction having only four row offsets; without that "
+        "decomposition one must perform binary Gaussian elimination."
+    ),
+    "hardness_basis": (
+        "Track B: Section 2.1 represents extensions by a binary column a; "
+        "recovering a from b=L a uses O(k^3) Gaussian elimination, measured "
+        "at shipping k=64 below by selftest, whereas grouping the at most "
+        "four rows of L-I uses at most 256 exact XOR operations."
+    ),
+    "max_answer_tokens": 80,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+# n is the length 2k+2 of the extended code.  The direct-sum base code has
+# dimension k and length 2k.  The demo is deliberately hand-scale.
+DIFFICULTY = {
+    "demo": {"n": 10, "rank": 1, "mask_weight": 2},
+    "easy": {"n": 82, "rank": 2, "mask_weight": 16},
+    "medium": {"n": 106, "rank": 2, "mask_weight": 22},
+    "hard": {"n": 130, "rank": 2, "mask_weight": 28},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Over F2, the displayed row-basis matrix is identity plus a rank-two "
+    "nilpotent matrix having only four distinct row offsets."
+)
+PLACEBO_HINT = (
+    "Over F2, the displayed row-basis matrix should be read carefully because "
+    "every bit and row position affects the requested column."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON k-by-1 matrix over F_2: exactly k one-element rows, each "
+        "containing the integer 0 or 1, in the displayed coefficient-column order."
+    ),
+    "bounds": {
+        "rows": "k=(n-2)/2",
+        "columns": 1,
+        "entries": [0, 1],
+        "candidate_count": "2^k",
+    },
+}
+
+NOTES = (
+    "Section 2.1 fixes the definition used here: if G1 generates a shorter "
+    "self-dual code, the codimension-one extension subcode has generator "
+    "[G1 | a | a], with a in F_2^k; Lemma 2 explains that automorphisms act "
+    "on these columns, and the authors use Magma to enumerate orbit "
+    "representatives.  Section 3 and Theorem 1 make the length-36 "
+    "classification itself an explicit finite lookup, so that is an easy "
+    "regime and is not used as a search problem.  For the scalable recovery "
+    "task, ordinary Gaussian elimination produces the certificate in O(k^3), "
+    "which rules out Track A but creates an honest Track B gap.  The generator "
+    "samples a first, then composes the basis change L=I+UV^T with V^T U=0; "
+    "thus L is an involution.  Balanced masks and a forced nonzero syndrome "
+    "defeat identity/diagonal, per-column-outlier, greedy, rank-one-ansatz, "
+    "and random-restart attacks while leaving a short rank-two decomposition."
+)
+
+# The extended Hamming [8,4,4] generator [I_4 | J_4-I_4].  Direct sums give
+# the self-dual length-2k base codes used by every supported instance.
+_G8 = ("10000111", "01001011", "00101101", "00011110")
+
+# These fields are filled from the separately owned harden.py transcripts once
+# those runs exist.  They are diagnostics only; G9 gates solely on the caps.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": None, "attempts": 0},
+    "hinted": {"solved": None, "attempts": 0},
+    "placebo": {"solved": None, "attempts": 0},
+    "hinted_verdict": "unrun",
+}
+
+
+def _bitstring(value, width):
+    """Use character j for coefficient j (least-significant integer bit j)."""
+    return "".join("1" if (value >> j) & 1 else "0" for j in range(width))
+
+
+def _bits_from_string(value):
+    out = 0
+    for j, ch in enumerate(value):
+        if ch == "1":
+            out |= 1 << j
+        elif ch != "0":
+            raise ValueError("matrix rows and rhs must contain only 0 and 1")
+    return out
+
+
+def _rank_vectors(vectors, width):
+    """Rank of integer bit-vectors over F_2."""
+    basis = {}
+    for raw in vectors:
+        value = raw & ((1 << width) - 1)
+        while value:
+            pivot = value.bit_length() - 1
+            if pivot in basis:
+                value ^= basis[pivot]
+            else:
+                basis[pivot] = value
+                break
+    return len(basis)
+
+
+def _sample_weight_vector(rng, width, weight):
+    value = 0
+    for j in rng.sample(range(width), weight):
+        value |= 1 << j
+    return value
+
+
+def _row_patterns(columns, width):
+    return [sum(((col >> i) & 1) << j for j, col in enumerate(columns))
+            for i in range(width)]
+
+
+def _sample_factors(rng, answer_bits, k, rank, weight):
+    """Sample U,V with V^T U=0 and V^T a=1, without solving for a."""
+    for _outer in range(10_000):
+        ucols = [_sample_weight_vector(rng, k, weight) for _ in range(rank)]
+        if _rank_vectors(ucols, k) != rank:
+            continue
+        if _rank_vectors(ucols + [answer_bits], k) != rank + 1:
+            continue
+        # All row coefficient types make the rank-two presentation balanced and
+        # keep any one offset from becoming a conspicuous plant.
+        if set(_row_patterns(ucols, k)) != set(range(1 << rank)):
+            continue
+        vcols = []
+        for _ in range(rank):
+            for _try in range(20_000):
+                vec = _sample_weight_vector(rng, k, weight)
+                if any((vec & u).bit_count() & 1 for u in ucols):
+                    continue
+                if not ((vec & answer_bits).bit_count() & 1):
+                    continue
+                if _rank_vectors(vcols + [vec], k) != len(vcols) + 1:
+                    continue
+                vcols.append(vec)
+                break
+            else:
+                break
+        if len(vcols) == rank:
+            return ucols, vcols
+    raise RuntimeError("could not sample balanced orthogonal low-rank factors")
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a row-scrambled self-dual-code extension instance."""
+    if isinstance(n, bool) or not isinstance(n, int) or n < 10 or n % 8 != 2:
+        raise ValueError("n must be an integer at least 10 with n == 2 (mod 8)")
+    rank = params.pop("rank", 2)
+    k = (n - 2) // 2
+    mask_weight = params.pop("mask_weight", k // 2)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(rank, bool) or not isinstance(rank, int) or rank not in (1, 2):
+        raise ValueError("rank must be 1 or 2")
+    if (isinstance(mask_weight, bool) or not isinstance(mask_weight, int)
+            or not (1 <= mask_weight <= k - 1)):
+        raise ValueError("mask_weight must be an integer strictly between 0 and k")
+
+    rng = random.Random(seed)
+    # The certificate comes first.  Requiring both symbols avoids degenerate
+    # corruption tests and does not reveal any coordinate of it.
+    while True:
+        answer_bits = rng.getrandbits(k)
+        if k // 3 <= answer_bits.bit_count() <= (2 * k) // 3:
+            break
+    ucols, vcols = _sample_factors(
+        rng, answer_bits, k, rank, mask_weight
+    )
+
+    differences = []
+    rows = []
+    rhs_bits = 0
+    for i in range(k):
+        diff = 0
+        for j in range(rank):
+            if (ucols[j] >> i) & 1:
+                diff ^= vcols[j]
+        row = diff ^ (1 << i)
+        differences.append(diff)
+        rows.append(row)
+        if (row & answer_bits).bit_count() & 1:
+            rhs_bits |= 1 << i
+
+    # V^T U=0 makes (I+UV^T)^2=I.  V^T a=(1,...,1) and full-rank U
+    # guarantee b != a, closing the most obvious shortcut by construction.
+    return {
+        "paper": "arXiv:1012.5464, Section 2.1",
+        "code_length": n,
+        "dimension": k,
+        "base_generator_block": list(_G8),
+        "base_blocks": k // 4,
+        "row_basis_matrix": [_bitstring(row, k) for row in rows],
+        "repeated_column": _bitstring(rhs_bits, k),
+        "answer": [[(answer_bits >> i) & 1] for i in range(k)],
+    }
+
+
+def _answer_json(answer):
+    return json.dumps(answer, separators=(",", ":"))
+
+
+def render(inst):
+    k = inst["dimension"]
+    n = inst["code_length"]
+    lines = [
+        "Recover the extension column of a binary self-dual code.",
+        "",
+        "All arithmetic is in F_2={0,1}: addition is XOR and multiplication is AND.",
+        "A binary code is the row span of a generator matrix. Its dual consists",
+        "of all binary vectors having dot product 0 with every codeword; a code",
+        "is self-dual when it equals its dual.",
+        "",
+        "The 4-by-8 matrix with rows",
+        *["  " + row for row in inst["base_generator_block"]],
+        (f"generates the self-dual [8,4,4] extended Hamming code.  Let G1 be "
+         f"the block-diagonal direct sum of {inst['base_blocks']} copies, so G1 "
+         f"has {k} rows and {2*k} columns."),
+        "",
+        (f"The paper's extension subcode has generator [G1 | a | a], where a "
+         f"is an unknown {k}-by-1 binary column.  Its code length is {n}."),
+        ("An invertible change of generator-row basis L was applied, producing "
+         "[L G1 | b | b].  Recover a from the displayed L and b."),
+        "Equivalently, find the unique binary column a satisfying L a = b over F_2.",
+        "",
+        f"L ({k} rows, coefficient columns numbered 0 through {k-1}):",
+    ]
+    width = max(2, len(str(k - 1)))
+    lines.extend(
+        f"  {i:0{width}d}: {row}"
+        for i, row in enumerate(inst["row_basis_matrix"])
+    )
+    lines.extend([
+        "",
+        "b, from row 0 through row " + str(k - 1) + ":",
+        "  " + inst["repeated_column"],
+        "",
+        (f"Output exactly a {k}-by-1 JSON matrix in coefficient-column order. "
+         "Each of its k rows must be [0] or [1]; indexing is 0-based, order "
+         "matters, and no row may be omitted or repeated."),
+        "Give your final answer inside <answer></answer> tags, as that JSON matrix.",
+        "Example: <answer>" + _answer_json([[0] for _ in range(k)]) + "</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    """Parse a tagged JSON matrix, tolerating prose, fences, and whitespace."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\s*>(.*?)</answer\s*>", text,
+                         flags=re.IGNORECASE | re.DOTALL)
+    bodies = list(reversed(matches)) if matches else [text]
+    for body in bodies:
+        body = re.sub(r"^\s*```(?:json)?\s*", "", body, flags=re.IGNORECASE)
+        body = re.sub(r"\s*```\s*$", "", body)
+        try:
+            value = json.loads(body.strip())
+        except (ValueError, TypeError):
+            continue
+        if isinstance(value, list):
+            return value
+    return None
+
+
+@functools.lru_cache(maxsize=128)
+def _cached_public_rows(rows_tuple, k):
+    if len(rows_tuple) != k:
+        raise ValueError(f"instance L must have {k} rows")
+    values = []
+    for i, row in enumerate(rows_tuple):
+        if not isinstance(row, str) or len(row) != k:
+            raise ValueError(f"instance L row {i} must be a {k}-bit string")
+        values.append(_bits_from_string(row))
+    return tuple(values)
+
+
+def _pack_candidate(answer, k):
+    if not isinstance(answer, list):
+        return None, "answer must be a JSON list of one-element rows"
+    if len(answer) != k:
+        return None, f"expected {k} rows, got {len(answer)}"
+    bits = 0
+    for i, row in enumerate(answer):
+        if not isinstance(row, list) or len(row) != 1:
+            return None, f"row {i} must be a one-element JSON list"
+        value = row[0]
+        if type(value) is not int or value not in (0, 1):
+            return None, f"entry in row {i} must be the integer 0 or 1"
+        bits |= value << i
+    return bits, None
+
+
+def verify(inst, answer):
+    """Check L a=b exactly over F_2; never consult inst['answer']."""
+    try:
+        k = inst["dimension"]
+        if isinstance(k, bool) or not isinstance(k, int) or k < 1:
+            return False, "malformed instance dimension"
+        rows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
+        rhs_text = inst["repeated_column"]
+        if not isinstance(rhs_text, str) or len(rhs_text) != k:
+            return False, f"instance b must be a {k}-bit string"
+        rhs = _bits_from_string(rhs_text)
+    except (KeyError, TypeError, ValueError) as exc:
+        return False, "malformed instance: " + str(exc)
+    bits, reason = _pack_candidate(answer, k)
+    if reason is not None:
+        return False, reason
+    for i, row in enumerate(rows):
+        got = (row & bits).bit_count() & 1
+        expected = (rhs >> i) & 1
+        if got != expected:
+            return False, (
+                f"equation row {i} fails: dot product is {got}, expected {expected}"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the stated k-by-1 binary-matrix language."""
+    k = inst["dimension"]
+    return [[rng.randrange(2)] for _ in range(k)]
+
+
+def search_space(inst):
+    return 1 << inst["dimension"]
+
+
+def enumerate_all(inst):
+    k = inst["dimension"]
+    if k > 20:
+        return None
+    count = 0
+    for bits in range(1 << k):
+        candidate = [[(bits >> i) & 1] for i in range(k)]
+        count += int(verify(inst, candidate)[0])
+    return count
+
+
+def _wl_label(tag, payload):
+    raw = json.dumps([tag, payload], separators=(",", ":"), sort_keys=True)
+    return hashlib.sha256(raw.encode("ascii")).hexdigest()
+
+
+def canonical_key(inst):
+    """Cheap bipartite-graph invariant under equation and variable relabelling.
+
+    Rows are coloured by their rhs bit, columns by their role.  Six rounds of
+    exact colour refinement, followed by the colour-pair edge multiset, is a
+    strong invariant.  It need not decide arbitrary bipartite isomorphism; that
+    limitation is recorded in README.md.
+    """
+    k = inst["dimension"]
+    rows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
+    rhs = _bits_from_string(inst["repeated_column"])
+    rlabels = [_wl_label("row", (rhs >> i) & 1) for i in range(k)]
+    clabels = [_wl_label("column", 0) for _ in range(k)]
+    for _ in range(6):
+        new_rows = []
+        for i, row in enumerate(rows):
+            counts = Counter(clabels[j] for j in range(k) if (row >> j) & 1)
+            new_rows.append(_wl_label("row", [rlabels[i], sorted(counts.items())]))
+        new_cols = []
+        for j in range(k):
+            counts = Counter(rlabels[i] for i, row in enumerate(rows)
+                             if (row >> j) & 1)
+            new_cols.append(_wl_label("column", [clabels[j], sorted(counts.items())]))
+        rlabels, clabels = new_rows, new_cols
+    edge_types = Counter(
+        (rlabels[i], clabels[j])
+        for i, row in enumerate(rows)
+        for j in range(k)
+        if (row >> j) & 1
+    )
+    payload = [sorted(rlabels), sorted(clabels), sorted(
+        [a, b, count] for (a, b), count in edge_types.items()
+    )]
+    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
+
+
+def escalate(params):
+    """First crowd the masks at fixed answer length, then respect the effort cap."""
+    out = {key: value for key, value in params.items() if key != "_preset"}
+    n = out["n"]
+    k = (n - 2) // 2
+    weight = out.get("mask_weight", k // 2)
+    if weight < k // 2:
+        out["mask_weight"] = min(k // 2, weight + max(1, k // 16))
+        return out
+    # Increasing k beyond 64 makes the worst-case compact rank-two route exceed
+    # the 300 exact-operation G9 cap; increasing rank does the same sooner.
+    return "cap_bound"
+
+
+def _base_generator_rows(k):
+    rows = []
+    for block in range(k // 4):
+        for text in _G8:
+            rows.append(_bits_from_string(text) << (8 * block))
+    return rows
+
+
+def _public_extension_rows(inst):
+    """Reconstruct the displayed [L G1 | b | b] rows as integers."""
+    k = inst["dimension"]
+    lrows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
+    grows = _base_generator_rows(k)
+    rhs = _bits_from_string(inst["repeated_column"])
+    out = []
+    for i, lrow in enumerate(lrows):
+        base = 0
+        for j in range(k):
+            if (lrow >> j) & 1:
+                base ^= grows[j]
+        bit = (rhs >> i) & 1
+        out.append(base | (bit << (2 * k)) | (bit << (2 * k + 1)))
+    return out
+
+
+def _gaussian_reference(inst):
+    """Ordinary exact Gaussian elimination, with bit-operation accounting."""
+    k = inst["dimension"]
+    rows = [list(map(int, row)) + [int(inst["repeated_column"][i])]
+            for i, row in enumerate(inst["row_basis_matrix"])]
+    operations = 0
+    comparisons = 0
+    for col in range(k):
+        pivot = None
+        for i in range(col, k):
+            comparisons += 1
+            if rows[i][col]:
+                pivot = i
+                break
+        if pivot is None:
+            return None, {"bit_operations": operations, "pivot_tests": comparisons}
+        if pivot != col:
+            rows[col], rows[pivot] = rows[pivot], rows[col]
+        for i in range(col + 1, k):
+            comparisons += 1
+            if rows[i][col]:
+                for j in range(col, k + 1):
+                    rows[i][j] ^= rows[col][j]
+                    operations += 1
+    answer = [0] * k
+    for i in range(k - 1, -1, -1):
+        value = rows[i][k]
+        for j in range(i + 1, k):
+            value ^= rows[i][j] & answer[j]
+            operations += 2
+        answer[i] = value
+    return [[bit] for bit in answer], {
+        "bit_operations": operations,
+        "pivot_tests": comparisons,
+    }
+
+
+def _compact_solve(inst):
+    """Exploit L^(-1)=L and reuse the <=3 nonzero row offsets of L-I."""
+    k = inst["dimension"]
+    rows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
+    rhs = _bits_from_string(inst["repeated_column"])
+    diffs = [row ^ (1 << i) for i, row in enumerate(rows)]
+    parity = {diff: ((diff & rhs).bit_count() & 1) for diff in set(diffs)}
+    bits = rhs
+    for i, diff in enumerate(diffs):
+        if parity[diff]:
+            bits ^= 1 << i
+    return [[(bits >> i) & 1] for i in range(k)]
+
+
+def _candidate(bits, k):
+    return [[(bits >> i) & 1] for i in range(k)]
+
+
+def _attack_candidates(inst, seed):
+    k = inst["dimension"]
+    rows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
+    rhs = _bits_from_string(inst["repeated_column"])
+
+    col_weights = [sum((row >> j) & 1 for row in rows) for j in range(k)]
+    median = sorted(col_weights)[k // 2]
+    outlier = sum((col_weights[j] > median) << j for j in range(k))
+
+    residual = rhs
+    greedy = 0
+    for j in range(k):
+        col = sum(((row >> j) & 1) << i for i, row in enumerate(rows))
+        if (residual ^ col).bit_count() < residual.bit_count():
+            residual ^= col
+            greedy |= 1 << j
+
+    diffs = [row ^ (1 << i) for i, row in enumerate(rows)]
+    nonzero = [d for d in diffs if d]
+    common = Counter(nonzero).most_common(1)[0][0] if nonzero else 0
+    rank_one = rhs
+    if (common & rhs).bit_count() & 1:
+        for i, diff in enumerate(diffs):
+            if diff == common:
+                rank_one ^= 1 << i
+
+    rng = random.Random(seed ^ 0x10125464)
+    restarts = [_candidate(rng.getrandbits(k), k) for _ in range(256)]
+    return {
+        "outlier_column_weight_threshold": [_candidate(outlier, k)],
+        "greedy_left_to_right_residual": [_candidate(greedy, k)],
+        "diagonal_identity_ansatz": [_candidate(rhs, k)],
+        "by_hand_rank_one_offset_ansatz": [_candidate(rank_one, k)],
+        "random_restart_256": restarts,
+    }
+
+
+def _relabel_variants(inst, seed):
+    k = inst["dimension"]
+    rng = random.Random(seed)
+    row_perm = list(range(k))
+    col_perm = list(range(k))
+    rng.shuffle(row_perm)
+    rng.shuffle(col_perm)
+
+    def transformed(do_rows, do_cols):
+        rows = list(inst["row_basis_matrix"])
+        rhs = inst["repeated_column"]
+        answer = [list(row) for row in inst["answer"]]
+        if do_cols:
+            rows = ["".join(row[j] for j in col_perm) for row in rows]
+            answer = [answer[j] for j in col_perm]
+        if do_rows:
+            rows = [rows[i] for i in row_perm]
+            rhs = "".join(rhs[i] for i in row_perm)
+        out = dict(inst)
+        out["row_basis_matrix"] = rows
+        out["repeated_column"] = rhs
+        out["answer"] = answer
+        return out
+
+    return [transformed(True, False), transformed(False, True), transformed(True, True)]
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def selftest():
+    report = {}
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+
+    g1_failures = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append([preset, seed, why])
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append([preset, seed, "answer is not JSON-native"])
+            k = inst["dimension"]
+            lrows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
+            if _rank_vectors(lrows, k) != k:
+                g1_failures.append([preset, seed, "row-basis matrix is singular"])
+            # Execute the code certificate: the public rows have rank k and zero
+            # pairwise inner products, hence span a self-orthogonal k-space.
+            hrows = _public_extension_rows(inst)
+            if _rank_vectors(hrows, inst["code_length"]) != k:
+                g1_failures.append([preset, seed, "public generator loses rank"])
+            if any((x & y).bit_count() & 1 for x in hrows for y in hrows):
+                g1_failures.append([preset, seed, "public generator is not self-orthogonal"])
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+        "construction_checks": "full rank and all public generator inner products zero",
+    }
+
+    inst = make_instance(seed=19, **shipping_params)
+    answer = inst["answer"]
+    first_zero = next(i for i, row in enumerate(answer) if row == [0])
+    first_one = next(i for i, row in enumerate(answer) if row == [1])
+    swapped = [list(row) for row in answer]
+    swapped[first_zero], swapped[first_one] = swapped[first_one], swapped[first_zero]
+    out_of_range = [list(row) for row in answer]
+    out_of_range[3] = [2]
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": swapped,
+        "duplicate": answer + [list(answer[0])],
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    rejected = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        rejected[name] = {"rejected": not ok, "reason": why}
+    reasons = [value["reason"] for value in rejected.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": (all(item["rejected"] for item in rejected.values())
+                 and len(set(reasons)) == len(reasons)),
+        "cases": rejected,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    response = (
+        "The low-rank correction gives this column.\n```json\n<answer>\n"
+        + json.dumps(answer, indent=1)
+        + "\n</answer>\n```\nI checked it over F_2."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_equals_answer": parsed == answer,
+    }
+
+    guess_rng = random.Random(0x10125464)
+    guess_total = 200_000
+    guess_hits = 0
+    start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
+    guess_seconds = time.perf_counter() - start
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_fraction,
+        "exact_candidate_space": search_space(inst),
+        "candidate_space_bits": inst["dimension"],
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    attack_names = [
+        "outlier_column_weight_threshold",
+        "greedy_left_to_right_residual",
+        "diagonal_identity_ansatz",
+        "by_hand_rank_one_offset_ansatz",
+        "random_restart_256",
+    ]
+    successes = {name: 0 for name in attack_names}
+    attack_seconds = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    reference_seconds = 0.0
+    reference_operations = 0
+    reference_pivot_tests = 0
+    compact_successes = 0
+    for seed in range(101, 109):
+        trial = make_instance(seed=seed, **shipping_params)
+        start = time.perf_counter()
+        candidates = _attack_candidates(trial, seed)
+        construction_elapsed = time.perf_counter() - start
+        for name in attack_names:
+            start = time.perf_counter()
+            won = any(verify(trial, candidate)[0] for candidate in candidates[name])
+            attack_seconds[name] += time.perf_counter() - start
+            successes[name] += int(won)
+        attack_seconds["random_restart_256"] += construction_elapsed
+
+        start = time.perf_counter()
+        recovered, counts = _gaussian_reference(trial)
+        reference_seconds += time.perf_counter() - start
+        reference_operations += counts["bit_operations"]
+        reference_pivot_tests += counts["pivot_tests"]
+        reference_successes += int(
+            recovered is not None and verify(trial, recovered)[0]
+        )
+        compact_successes += int(verify(trial, _compact_solve(trial))[0])
+
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_seconds[name] / 8, 6),
+        }
+        for name in attack_names
+    }
+    reference = {
+        "name": "binary Gaussian elimination with back substitution",
+        "complexity": "O(k^3) exact bit operations",
+        "wall_clock_sec": round(reference_seconds / 8, 6),
+        "operations": reference_operations // 8,
+        "pivot_tests": reference_pivot_tests // 8,
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    all_failed = all(value == 0 for value in successes.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8 and compact_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": reference,
+        "intended_compact_route": {
+            "name": "reuse the at most three nonzero rows of L-I",
+            "solves": f"{compact_successes}/8",
+            "operations_upper_bound": 4 * inst["dimension"],
+        },
+    }
+
+    demo_count = enumerate_all(make_instance(seed=3, **DIFFICULTY["demo"]))
+    report["G5_density_and_baseline_cost"] = {
+        "pass": (guess_fraction < 1e-6 and demo_count == 1 and all_failed
+                 and reference_successes == 8),
+        "shipping_sample_hits": guess_hits,
+        "shipping_sample_total": guess_total,
+        "shipping_solution_density": guess_fraction,
+        "exact_density": f"1/2^{inst['dimension']} (unique invertible system)",
+        "demo_exact_solution_count": demo_count,
+        "baseline_attack_wall_clock_sec": round(
+            attack_seconds["random_restart_256"] / 8, 6
+        ),
+        "baseline_attack_iterations": 256,
+        "reference_wall_clock_sec": reference["wall_clock_sec"],
+        "reference_operation_count": reference["operations"],
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_k = 2 * ((doubled_params["n"] - 2) // 2)
+    doubled_params["n"] = 2 * doubled_k + 2
+    doubled_params["mask_weight"] = min(
+        doubled_params["mask_weight"] * 2, doubled_k // 2
+    )
+    start = time.perf_counter()
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_build = time.perf_counter() - start
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    ladder = [DIFFICULTY[name]["n"] for name in DIFFICULTY]
+    report["G7_scales"] = {
+        "pass": (doubled_ok and doubled["dimension"] == 2 * inst["dimension"]
+                 and len(render(doubled)) > len(render(inst))
+                 and ladder == sorted(ladder) and len(set(ladder)) == 4),
+        "shipping_n": inst["code_length"],
+        "shipping_dimension": inst["dimension"],
+        "doubled_n": doubled["code_length"],
+        "doubled_dimension": doubled["dimension"],
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_why,
+        "candidate_space_bits_shipping": inst["dimension"],
+        "candidate_space_bits_doubled": doubled["dimension"],
+    }
+
+    invariant_count = 0
+    real_transform_count = 0
+    unrelated_keys = []
+    for seed in range(201, 221):
+        original = make_instance(seed=seed, **shipping_params)
+        key = canonical_key(original)
+        for transformed in _relabel_variants(original, seed ^ 0x5A5A):
+            invariant_count += int(key == canonical_key(transformed))
+            real_transform_count += int(verify(transformed, transformed["answer"])[0])
+        unrelated_keys.append(key)
+    distinct_count = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": (invariant_count == 60 and real_transform_count == 60
+                 and distinct_count == 20),
+        "invariant_relabellings": invariant_count,
+        "invariance_attempts": 60,
+        "real_transformations_verified": real_transform_count,
+        "real_transformation_attempts": 60,
+        "unrelated_distinct_keys": distinct_count,
+        "unrelated_attempts": 20,
+        "transformations": [
+            "equation-row reordering",
+            "coefficient-column relabelling with carried witness",
+            "composition of row and column relabelling",
+        ],
+    }
+
+    encoded = json.dumps(inst["answer"])
+    answer_chars = len(encoded)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(inst["answer"])
+    worst_chars = 5 * inst["dimension"]
+    worst_tokens = math.ceil(worst_chars / 4)
+    intended_operations = 4 * inst["dimension"]
+    arms = {name: dict(G9_ORACLE_RESULTS[name])
+            for name in ("bare", "hinted", "placebo")}
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = (hinted["solved"] / hinted["attempts"]
+                   if hinted["attempts"] and hinted["solved"] is not None else None)
+    placebo_rate = (placebo["solved"] / placebo["attempts"]
+                    if placebo["attempts"] and placebo["solved"] is not None else None)
+    delta = hinted_rate - placebo_rate if hinted_rate is not None and placebo_rate is not None else None
+    within_caps = (
+        answer_chars <= 2_000
+        and answer_elements <= 256
+        and intended_operations <= 300
+        and PROBLEM_PROFILE["max_answer_tokens"] == worst_tokens
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": delta,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "worst_case_answer_chars": worst_chars,
+        "worst_case_answer_tokens": worst_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [value for key, value in report.items()
+             if key.startswith("G") and key[1:2].isdigit()]
+    report["all_passed"] = all(value.get("pass") is True for value in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

