+            g1_attempts += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": why})
+            if not all(_block_is_self_dual(block) for block in inst["blocks"]):
+                g1_failures.append({
+                    "preset": preset,
+                    "seed": seed,
+                    "reason": "a displayed block is not exactly self-dual",
+                })
