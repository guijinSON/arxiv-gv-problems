+def _make_transformed_block(
+    base_rows: list[int],
+    enumerator: tuple[int, ...],
+    kind: str,
+    rng: random.Random,
+    rounds: int,
+    order: list[int] | None = None,
+    constrained_coeff: int | None = None,
