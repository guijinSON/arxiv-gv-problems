/bin/bash -lc 'scratch_dir=$(mktemp -d /tmp/gv1012-hinted-XXXXXX) && cp gen_1012_5464.py "$scratch_dir/" && cd "$scratch_dir" && GV_HINT_MODE=structural GV_G9_SINGLE=1 ORACLE_MAX_ESCALATIONS=0 python3 /home/gson/gvrepo/scripts/harden.py gen_1012_5464.py; status=$?; printf '"'\\nSCRATCH=%s\\nSTATUS=%s\\n' \""'$scratch_dir" "$status"' in /home/gson/gvrepo/results/1012.5464
