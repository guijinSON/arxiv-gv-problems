+
+def _ints(block: dict) -> list[int]:
+    return [
+        sum((ch == "1") << i for i, ch in enumerate(text))
+        for text in block["rows"]
+    ]
+
+
+def _weak_compositions(total: int, parts: int):
+    if parts == 1:
+        yield (total,)
+        return
+    for first in range(total + 1):
+        for rest in _weak_compositions(total - first, parts - 1):
+            yield (first,) + rest
+
+
+def _decoy_counts(n_decoys: int, seed: int) -> tuple[int, ...]:
+    choices = list(_weak_compositions(n_decoys, len(_DECOY_RECIPES)))
+    return choices[abs(int(seed)) % len(choices)]
