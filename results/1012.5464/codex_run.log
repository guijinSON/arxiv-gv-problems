assert a==b
assert json.loads(json.dumps(a['answer']))==a['answer']
assert g.verify(a,a['answer'])==(True,'ok')
assert g.parse_answer('prose "'```'"\\n<answer>'+','.join(map(str,a['answer']))+'</answer>\\n"'```'"')==a['answer']
os.environ.pop('GV_HINT_MODE',None)
text=g.render(a)
assert g.STRUCTURAL_HINT not in text and g.PLACEBO_HINT not in text
sys.path.insert(0,os.path.abspath('../../scripts'))
import corpus_report
