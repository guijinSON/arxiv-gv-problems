+        planted_steps = _multiply_steps(pattern_steps, multiplier, k)
+        # Defeat the obvious "align the smallest displayed steps" ansatz.
+        guessed = _smallest_step_multiplier(pattern_steps, planted_steps, k)
+        if set(_multiply_steps(pattern_steps, guessed, k)) == set(planted_steps):
+            continue
+        break
+
+    triangle_sum = sum(pattern_signatures)
+    pattern_profile = tuple(sorted(pattern_signatures))
+    decoys = []
+    while len(decoys) < n - 1:
+        candidate = _sample_steps(
+            k,
+            step_count,
+            rng,
+            triangle_sum=triangle_sum,
