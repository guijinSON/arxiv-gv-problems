+# answer remains 67 integers on every non-demo rung: escalation grows the
+# haystack, not the witness.
+DIFFICULTY = {
+    "demo": {"n": 2, "pattern_size": 5, "step_count": 1, "crowding": 1},
+    "easy": {"n": 24, "pattern_size": 67, "step_count": 6, "crowding": 1},
