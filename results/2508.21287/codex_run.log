+        multiplier = rng.choice((2, 3))
+        planted_steps = _multiply_steps(pattern_steps, multiplier, k)
+        blocks_steps = []
+        for _ in range(n):
+            blocks_steps.append([rng.choice((1, 2))])
+        answer_block = rng.randrange(n)
+        blocks_steps[answer_block] = planted_steps
+        return _assemble_instance(
+            k, blocks_steps, pattern_steps, answer_block, multiplier
+        )
+
+    # Sample the answer-bearing object before constructing the data graph.
+    while True:
+        pattern_steps = _sample_steps(k, step_count, rng)
+        pattern_signatures = _step_signatures(k, pattern_steps)
+        # Stay in a high-mass slice of the same random-step distribution so that
+        # dozens of statistically comparable decoys remain cheap to sample.
+        if k == 67 and step_count == 6 and sum(pattern_signatures) != 12:
+            continue
+        if not _has_two_unique_signatures(pattern_signatures):
+            continue
