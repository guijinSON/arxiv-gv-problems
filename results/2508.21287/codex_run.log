+    triangle_sum = sum(pattern_signatures)
+    pattern_profile = tuple(sorted(pattern_signatures))
+    decoys = []
+    while len(decoys) < n - 1:
+        candidate = _sample_steps(
+            k,
+            step_count,
+            rng,
+            triangle_sum=triangle_sum,
+            forbidden_profile=pattern_profile,
