+    blocks_steps.insert(answer_block, planted_steps)
+    return _assemble_instance(k, blocks_steps, pattern_steps, answer_block, multiplier)
+
+
+def render(inst):
+    k = inst["k"]
+    block_count = inst["n"]
+    pattern_table = ", ".join(
+        f"{step}:{count}"
+        for step, count in zip(inst["pattern_steps"], inst["pattern_signatures"])
+    )
+    block_lines = []
+    for block in inst["blocks"]:
