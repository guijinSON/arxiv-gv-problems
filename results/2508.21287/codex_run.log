+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariance = 0
+    real = 0
+    unrelated_keys = []
+    transformation_names = [
+        "pattern relabelling",
+        "data relabelling",
+        "input reordering and connector reversal",
