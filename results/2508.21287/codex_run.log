+        if _is_affinely_equivalent(pattern_steps, candidate, k):
+            continue
+        guessed = _smallest_step_multiplier(pattern_steps, candidate, k)
+        if set(_multiply_steps(pattern_steps, guessed, k)) == set(candidate):
+            continue
+        decoys.append(candidate)
