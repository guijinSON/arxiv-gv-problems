+    attack_times = {name: 0.0 for name in attack_names}
+    compact_successes = 0
+    compact_operations = []
+    for seed in range(900, 908):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        attacks = (
+            (attack_names[0], lambda: _attack_outlier_coarse(inst)),
