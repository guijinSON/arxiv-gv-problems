+        },
+        "intended_compact_route": {
+            "name": "bridge decomposition plus edge-motif profile multiplier",
+            "operations_max": max(compact_operations),
+            "solves": f"{compact_successes}/8",
+        },
+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
