+
+    answer_blob = json.dumps(shipping["answer"], separators=(",", ":"))
+    _, intended_operations = _compact_profile_route(shipping)
+    arms = {
+        key: dict(G9_ORACLE_RESULTS[key]) for key in ("bare", "hinted", "placebo")
+    }
