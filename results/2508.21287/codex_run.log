+    report["G3_round_trip"] = {
+        "pass": parsed == planted,
+        "parsed_equals_answer": parsed == planted,
+        "garbage_returns_none": parse_answer("no tagged list here") is None,
+    }
+
+    rng = random.Random(271828)
