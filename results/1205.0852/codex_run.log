+        "labels": sorted(inst["labels"]),
+        "anchor_label": inst["labels"][inst["anchor_step"]],
+        "relations": _canonical_relations(inst),
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
