   317	def enumerate_all(inst):
   318	    """Exact brute-force count only when the permutation space is safely small."""
   319	    if search_space(inst) > 1_000_000:
   320	        return None
   321	    return sum(
   322	        verify(inst, list(candidate))[0]
   323	        for candidate in itertools.permutations(inst["users"])
