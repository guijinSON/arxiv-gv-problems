+def _is_prime(value):
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(value):
+    candidate = max(3, value | 1)
+    while not _is_prime(candidate):
+        candidate += 2
+    return candidate
+
+
+def make_instance(n, seed=0, constraint_count=None, user_modulus=1000003, **params):
+    """Inverse-generate a satisfiable modular-relation WSP instance."""
+    if not isinstance(n, int) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    if not isinstance(user_modulus, int) or not _is_prime(user_modulus):
+        raise ValueError("user_modulus must be prime")
+    if n >= user_modulus:
+        raise ValueError("n must be smaller than user_modulus")
+    if constraint_count is None:
+        constraint_count = 4 * n
+    max_pairs = n * (n - 1) // 2
+    if not isinstance(constraint_count, int) or not (n - 1 <= constraint_count <= max_pairs):
+        raise ValueError("constraint_count must be between n-1 and C(n,2)")
+
+    rng = random.Random(seed)
+    q = user_modulus
+    # Demo needs all six nonzero labels in Z_7, so only production-sized
+    # moduli exclude the short-slope attack's finite list.
+    forbidden = ({x % q for x in range(-16, 17)} if q > 100 else {0})
+    slope = rng.randrange(1, q)
+    while slope in forbidden:
+        slope = rng.randrange(1, q)
+
+    labels = [0]
+    seen = {0}
+    while len(labels) < n:
+        label = rng.randrange(1, q)
+        if label not in seen:
+            seen.add(label)
+            labels.append(label)
+    rng.shuffle(labels)
+    anchor_step = labels.index(0)
+    anchor_user = 0
+    planted = [(slope * label) % q for label in labels]
+
+    # A uniformly relabelled random tree certifies connectivity by construction.
+    order = list(range(n))
+    rng.shuffle(order)
+    pairs = set()
+    for i in range(1, n):
+        a = order[i]
+        b = order[rng.randrange(i)]
+        pairs.add((min(a, b), max(a, b)))
+    while len(pairs) < constraint_count:
+        a, b = rng.sample(range(n), 2)
+        pairs.add((min(a, b), max(a, b)))
+
+    relations = []
+    for lo, hi in pairs:
+        if rng.randrange(2):
+            a, b = hi, lo
+        else:
+            a, b = lo, hi
+        relations.append([a, b, (planted[b] - planted[a]) % q])
+    rng.shuffle(relations)
+
+    return {
+        "n": n,
+        "user_modulus": q,
+        "labels": labels,
+        "anchor_step": anchor_step,
+        "anchor_user": anchor_user,
+        "type1_difference_constraints": relations,
+        "answer": planted,
+    }
+
+
+def render(inst):
+    """Render a complete WSP statement and an exact output contract."""
+    n = inst["n"]
+    q = inst["user_modulus"]
+    lines = [
+        "WORKFLOW SATISFIABILITY WITH MODULAR USER RELATIONS",
+        "",
+        f"There are {n} workflow steps S0,...,S{n-1} and {q} users.",
+        f"Users are the integer residues 0,...,{q-1} modulo q={q}.",
+        "A plan assigns exactly one user to every step. There are no precedence",
+        "restrictions. Every user is authorized for every step except the anchor",
+        f"step S{inst['anchor_step']}, whose only authorized user is {inst['anchor_user']}.",
+        "",
+        "Each step also has a scalar label in Z_q. Labels are auxiliary instance",
+        "data and impose no additional validity condition by themselves:",
+    ]
+    for i, label in enumerate(inst["labels"]):
+        lines.append(f"  S{i}: label={label}")
+
+    lines.extend([
+        "",
+        "A displayed Type-1 entailment constraint DIFF(a,b,d) uses the binary",
+        "user relation rho_d={(u,v): (v-u) mod q = d}. Thus it is satisfied",
+        "exactly when (plan[b]-plan[a]) mod q equals d. All intervals above are",
+        "inclusive, and every modular result is its least residue in 0,...,q-1.",
+        "",
+        "Type-1 constraints:",
+    ])
+    for a, b, d in inst["type1_difference_constraints"]:
+        lines.append(f"  DIFF(S{a},S{b},{d})")
+
+    lines.extend([
+        "",
+        "Find any authorized plan satisfying every Type-1 constraint. Repeated",
+        "users are allowed. Output exactly n integers in step order S0,S1,...,",
+        f"S{n-1}; each must lie in the inclusive range 0,...,{q-1}.",
+        "",
+        "Give your final answer inside <answer></answer> tags as comma-separated",
+        "integer user identifiers. Example syntax: <answer>0, 17, 4</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer>", re.I | re.S)
+
+
+def parse_answer(text):
+    """Extract the last delimited comma-separated integer list; never raise."""
+    if not isinstance(text, str):
+        return None
+    blocks = _ANSWER_RE.findall(text)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    if not body:
+        return []
+    if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
+        return None
+    try:
+        return [int(token.strip()) for token in body.split(",")]
+    except (TypeError, ValueError):
+        return None
+
+
+def verify(inst, answer):
+    """Check only the supplied plan and the displayed workflow instance."""
+    if not isinstance(answer, list):
+        return False, "answer must be a list of user identifiers"
+    n = inst["n"]
+    q = inst["user_modulus"]
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) < n:
+        return False, f"too few plan entries: expected {n}, got {len(answer)}"
+    if len(answer) > n:
+        return False, f"too many plan entries: expected {n}, got {len(answer)}"
+    for i, user in enumerate(answer):
+        if type(user) is not int or not (0 <= user < q):
+            return False, f"entry {i} is outside the authorized user range 0..{q-1}"
+    anchor = inst["anchor_step"]
+    if answer[anchor] != inst["anchor_user"]:
+        return False, f"anchor step S{anchor} is assigned an unauthorized user"
+    for index, (a, b, offset) in enumerate(inst["type1_difference_constraints"]):
+        if (answer[b] - answer[a]) % q != offset:
+            return False, f"Type-1 difference constraint {index} is violated"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample after enforcing the explicit singleton anchor authorization."""
+    q = inst["user_modulus"]
+    plan = [rng.randrange(q) for _ in range(inst["n"])]
+    plan[inst["anchor_step"]] = inst["anchor_user"]
+    return plan
+
+
+def search_space(inst):
+    return inst["user_modulus"] ** (inst["n"] - 1)
