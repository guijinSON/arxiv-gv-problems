+
+def random_candidate(inst, rng):
+    """Sample after enforcing the explicit singleton anchor authorization."""
+    q = inst["user_modulus"]
+    plan = [rng.randrange(q) for _ in range(inst["n"])]
+    plan[inst["anchor_step"]] = inst["anchor_user"]
+    return plan
