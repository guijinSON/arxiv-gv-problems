   344	def escalate(params):
   345	    """Grow arithmetic and decoy axes at fixed 120-entry witness length."""
   346	    p = {key: value for key, value in params.items() if key != "_preset"}
   347	    q = int(p.get("label_modulus", 1000003))
   348	    decoys = int(p.get("decoy_permutations", 4))
   349	    n = int(p["n"])
   350	    if q < 1_000_000_000_000:
   351	        p["label_modulus"] = _next_prime(10 * q + 1)
   352	        p["decoy_permutations"] = decoys
   353	        p["n"] = n
   354	        return p
   355	    if decoys < 8:
   356	        p["decoy_permutations"] = decoys + 1
   357	        p["label_modulus"] = q
   358	        p["n"] = n
   359	        return p
   360	    return None
