+    def bfs():
+        counts["bfs_rounds"] += 1
+        queue = deque()
+        found = False
+        for step in range(n):
+            if pair_step[step] < 0:
+                distance[step] = 0
+                queue.append(step)
+            else:
+                distance[step] = -1
+        while queue:
+            step = queue.popleft()
+            for user in adjacency[step]:
+                counts["edge_scans"] += 1
