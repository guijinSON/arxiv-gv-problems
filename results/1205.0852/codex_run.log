   327	def canonical_key(inst):
   328	    """Canonical under step renumbering and every input-list reordering."""
   329	    rows = sorted(
   330	        [label, sorted(row)]
   331	        for label, row in zip(inst["step_labels"], inst["authorizations"])
   332	    )
   333	    payload = {
   334	        "q": inst["label_modulus"],
   335	        "audit_multiplier": inst["audit_multiplier"],
   336	        "users": sorted(inst["users"]),
   337	        "rows": rows,
   338	        "constraint": [1, "all steps"],
   339	    }
   340	    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
   341	    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
