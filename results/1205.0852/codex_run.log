+def _attack_one_pass_propagation(inst, rng):
+    """Random-order local propagation without a queue, repair, or backtracking."""
+    n = inst["n"]
+    q = inst["user_modulus"]
+    incident = [[] for _ in range(n)]
+    for a, b, offset in inst["type1_difference_constraints"]:
+        incident[a].append((b, offset))
+        incident[b].append((a, (-offset) % q))
+    plan = [None] * n
+    plan[inst["anchor_step"]] = inst["anchor_user"]
+    order = [i for i in range(n) if i != inst["anchor_step"]]
+    rng.shuffle(order)
+    for step in order:
+        suggestions = [
+            (plan[other] - offset) % q
+            for other, offset in incident[step]
+            if plan[other] is not None
+        ]
+        plan[step] = suggestions[0] if suggestions else rng.randrange(q)
+    return plan
