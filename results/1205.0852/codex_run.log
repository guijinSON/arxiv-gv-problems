+    density = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": density < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_fraction": density,
+        "structure_aware_space": search_space(shipping),
+        "prior": "uniform over all plans after enforcing the singleton anchor authorization",
+    }
+
+    baseline_t0 = time.perf_counter()
+    _, baseline_success = _attack_random_affine_restart(
+        shipping, random.Random(161803), 4096
+    )
+    baseline_wall = time.perf_counter() - baseline_t0
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    report["G5_density_and_baseline_cost"] = {
+        "pass": not baseline_success,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_sampled_density": density,
+        "shipping_density_wall_sec": round(density_wall, 6),
+        "demo_exact_solution_count": enumerate_all(demo),
+        "demo_candidate_count": search_space(demo),
+        "baseline_affine_restarts": 4096,
+        "baseline_wall_sec": round(baseline_wall, 6),
+        "baseline_successes": int(baseline_success),
+    }
+
+    attack_names = [
+        "outlier_label_identity",
+        "greedy_lowest_authorized",
+        "obvious_small_affine_slopes",
+        "random_one_pass_propagation",
+        "random_affine_restart_256",
+    ]
+    attacks = {name: {"successes": 0, "attempts": 0} for name in attack_names}
+    reference = {
+        "name": "connected modular-difference propagation",
+        "complexity": "O(n + constraint_count)",
+        "attempts": 0,
+        "successes": 0,
+        "wall_clock_sec": 0.0,
+        "relation_scans": 0,
+        "assignments": 0,
+        "queue_pops": 0,
+    }
+    for seed in range(8):
+        inst = make_instance(seed=10_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        small_candidate, _ = _attack_small_affine_slopes(inst)
+        affine_candidate, _ = _attack_random_affine_restart(
