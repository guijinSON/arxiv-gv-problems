   265	def parse_answer(text):
   266	    """Parse the final delimited comma-separated integer list; never raise."""
   267	    if not isinstance(text, str):
   268	        return None
   269	    blocks = _ANSWER_RE.findall(text)
   270	    if not blocks:
   271	        return None
   272	    body = blocks[-1].strip()
   273	    if not body:
   274	        return []
   275	    if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
   276	        return None
   277	    try:
   278	        return [int(token.strip()) for token in body.split(",")]
   279	    except (TypeError, ValueError):
   280	        return None
