   432	def _attack_greedy_unused(inst, rng, attempts):
   433	    """Random-order greedy matching with restarts, but no augmenting paths."""
   434	    n = inst["n"]
   435	    last = None
   436	    for _ in range(attempts):
   437	        order = list(range(n))
   438	        rng.shuffle(order)
   439	        used = set()
   440	        answer = [None] * n
   441	        for step in order:
   442	            choices = [user for user in inst["authorizations"][step] if user not in used]
   443	            if not choices:
   444	                break
   445	            user = rng.choice(choices)
   446	            answer[step] = user
   447	            used.add(user)
   448	        else:
   449	            if verify(inst, answer)[0]:
   450	                return answer, True
   451	        last = answer
   452	    # Return a well-shaped but invalid candidate if every restart got stuck.
   453	    if last is None or any(user is None for user in last):
   454	        last = _attack_row_extreme(inst)
   455	    return last, False
