+    lines.extend([
+        "",
+        "Find any authorized plan satisfying every Type-1 constraint. Repeated",
+        "users are allowed. Output exactly n integers in step order S0,S1,...,",
+        f"S{n-1}; each must lie in the inclusive range 0,...,{q-1}.",
+        "",
