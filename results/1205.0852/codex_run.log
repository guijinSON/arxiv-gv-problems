+    counters["assignments"] = 1
+    queue = [anchor]
+    head = 0
+    while head < len(queue):
+        step = queue[head]
+        head += 1
+        counters["queue_pops"] += 1
+        for other, offset in adjacency[step]:
+            counters["relation_scans"] += 1
+            expected = (plan[step] + offset) % q
+            if plan[other] is None:
+                plan[other] = expected
+                counters["assignments"] += 1
+                queue.append(other)
+            elif plan[other] != expected:
+                return None, counters
+    if any(value is None for value in plan):
+        return None, counters
+    return plan, counters
+
+
+def _attack_identity(inst):
+    plan = [label % inst["user_modulus"] for label in inst["labels"]]
+    plan[inst["anchor_step"]] = inst["anchor_user"]
+    return plan
+
+
+def _attack_lowest_authorized(inst):
+    plan = [0] * inst["n"]
+    plan[inst["anchor_step"]] = inst["anchor_user"]
+    return plan
+
+
+def _attack_small_affine_slopes(inst):
+    q = inst["user_modulus"]
+    anchor = inst["anchor_step"]
+    last = None
+    for slope in list(range(1, 17)) + list(range(q - 16, q)):
+        last = [(slope * label) % q for label in inst["labels"]]
+        last[anchor] = inst["anchor_user"]
+        if verify(inst, last)[0]:
+            return last, True
+    return last, False
+
+
+def _attack_random_affine_restart(inst, rng, attempts):
+    q = inst["user_modulus"]
+    anchor = inst["anchor_step"]
+    last = None
+    for _ in range(attempts):
+        slope = rng.randrange(1, q)
+        last = [(slope * label) % q for label in inst["labels"]]
+        last[anchor] = inst["anchor_user"]
+        if verify(inst, last)[0]:
+            return last, True
+    return last, False
+
+
+def _attack_one_pass_propagation(inst, rng):
+    """Random-order local propagation without a queue, repair, or backtracking."""
+    n = inst["n"]
+    q = inst["user_modulus"]
+    incident = [[] for _ in range(n)]
+    for a, b, offset in inst["type1_difference_constraints"]:
+        incident[a].append((b, offset))
+        incident[b].append((a, (-offset) % q))
+    plan = [None] * n
+    plan[inst["anchor_step"]] = inst["anchor_user"]
+    order = [i for i in range(n) if i != inst["anchor_step"]]
+    rng.shuffle(order)
+    for step in order:
+        suggestions = [
+            (plan[other] - offset) % q
+            for other, offset in incident[step]
+            if plan[other] is not None
+        ]
+        plan[step] = suggestions[0] if suggestions else rng.randrange(q)
+    return plan
+
+
+def _permute_instance(inst, permutation, reverse_mask=None, constraint_order=None):
+    n = inst["n"]
+    if sorted(permutation) != list(range(n)):
+        raise ValueError("not a permutation")
+    labels = [None] * n
+    answer = [None] * n
+    for old, new in enumerate(permutation):
+        labels[new] = inst["labels"][old]
+        answer[new] = inst["answer"][old]
+    relations = []
+    for index, (a, b, offset) in enumerate(inst["type1_difference_constraints"]):
+        a, b = permutation[a], permutation[b]
+        if reverse_mask is not None and reverse_mask[index]:
+            a, b, offset = b, a, (-offset) % inst["user_modulus"]
+        relations.append([a, b, offset])
+    if constraint_order is not None:
+        relations = [relations[i] for i in constraint_order]
+    return {
+        "n": n,
+        "user_modulus": inst["user_modulus"],
+        "labels": labels,
+        "anchor_step": permutation[inst["anchor_step"]],
+        "anchor_user": inst["anchor_user"],
+        "type1_difference_constraints": relations,
+        "answer": answer,
+    }
+
+
+def _affine_user_relabel(inst, scale, translation):
+    q = inst["user_modulus"]
+    if not (1 <= scale < q):
+        raise ValueError("scale must be a nonzero residue")
+    return {
+        "n": inst["n"],
+        "user_modulus": q,
+        "labels": list(inst["labels"]),
+        "anchor_step": inst["anchor_step"],
+        "anchor_user": (scale * inst["anchor_user"] + translation) % q,
+        "type1_difference_constraints": [
+            [a, b, (scale * offset) % q]
+            for a, b, offset in inst["type1_difference_constraints"]
+        ],
+        "answer": [(scale * user + translation) % q for user in inst["answer"]],
+    }
+
+
+def _answer_atom_count(answer):
+    if isinstance(answer, dict):
+        return sum(_answer_atom_count(value) for value in answer.values())
+    if isinstance(answer, (list, tuple)):
+        return sum(_answer_atom_count(value) for value in answer)
+    return 1
+
+
+def selftest():
+    """Run every local gate and return a JSON-native report."""
+    report = {}
+    g1_attempts = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 19):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append([preset, seed, why])
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    shipping = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = shipping["answer"]
+    swap_index = next(i for i, value in enumerate(planted)
+                      if i != shipping["anchor_step"] and value != 0)
+    swapped = list(planted)
+    anchor = shipping["anchor_step"]
+    swapped[anchor], swapped[swap_index] = swapped[swap_index], swapped[anchor]
+    corruptions = {
+        "drop": list(planted[:-1]),
+        "swap": swapped,
+        "duplicate": list(planted[:1]) + list(planted),
+        "empty": [],
+        "out_of_range": list(planted[:-1]) + [shipping["user_modulus"]],
+    }
+    g2_cases = {}
+    reasons = []
+    for name, candidate in corruptions.items():
+        ok, why = verify(shipping, candidate)
+        g2_cases[name] = {"accepted": bool(ok), "reason": why}
+        reasons.append(why)
+    report["G2_rejects_corruption"] = {
+        "pass": all(not case["accepted"] for case in g2_cases.values())
+        and len(set(reasons)) == 5,
+        "cases": g2_cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    wire = ", ".join(str(value) for value in planted)
+    model_style = "I propagated the relations.\n```text\n<answer>" + wire + "</answer>\n```"
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and json.loads(json.dumps(planted)) == planted,
+        "parsed_entries": len(parsed) if isinstance(parsed, list) else None,
+        "json_native": json.loads(json.dumps(planted)) == planted,
+    }
+
+    guess_total = 200_000
+    guess_hits = 0
+    guess_rng = random.Random(271828)
+    density_t0 = time.perf_counter()
+    for _ in range(guess_total):
+        if verify(shipping, random_candidate(shipping, guess_rng))[0]:
+            guess_hits += 1
+    density_wall = time.perf_counter() - density_t0
+    density = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": density < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_fraction": density,
+        "structure_aware_space": search_space(shipping),
+        "prior": "uniform over all plans after enforcing the singleton anchor authorization",
+    }
+
+    baseline_t0 = time.perf_counter()
+    _, baseline_success = _attack_random_affine_restart(
+        shipping, random.Random(161803), 4096
+    )
+    baseline_wall = time.perf_counter() - baseline_t0
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    report["G5_density_and_baseline_cost"] = {
+        "pass": not baseline_success,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_sampled_density": density,
+        "shipping_density_wall_sec": round(density_wall, 6),
+        "demo_exact_solution_count": enumerate_all(demo),
+        "demo_candidate_count": search_space(demo),
+        "baseline_affine_restarts": 4096,
+        "baseline_wall_sec": round(baseline_wall, 6),
+        "baseline_successes": int(baseline_success),
+    }
+
+    attack_names = [
+        "outlier_label_identity",
+        "greedy_lowest_authorized",
+        "obvious_small_affine_slopes",
+        "random_one_pass_propagation",
+        "random_affine_restart_256",
+    ]
+    attacks = {name: {"successes": 0, "attempts": 0} for name in attack_names}
+    reference = {
+        "name": "connected modular-difference propagation",
+        "complexity": "O(n + constraint_count)",
+        "attempts": 0,
+        "successes": 0,
+        "wall_clock_sec": 0.0,
+        "relation_scans": 0,
+        "assignments": 0,
+        "queue_pops": 0,
+    }
+    for seed in range(8):
+        inst = make_instance(seed=10_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        small_candidate, _ = _attack_small_affine_slopes(inst)
+        affine_candidate, _ = _attack_random_affine_restart(
+            inst, random.Random(90_000 + seed), 256
+        )
+        candidates = {
+            "outlier_label_identity": _attack_identity(inst),
+            "greedy_lowest_authorized": _attack_lowest_authorized(inst),
+            "obvious_small_affine_slopes": small_candidate,
+            "random_one_pass_propagation": _attack_one_pass_propagation(
+                inst, random.Random(50_000 + seed)
+            ),
+            "random_affine_restart_256": affine_candidate,
+        }
+        for name, candidate in candidates.items():
+            attacks[name]["attempts"] += 1
+            attacks[name]["successes"] += int(verify(inst, candidate)[0])
+
+        ref_t0 = time.perf_counter()
+        ref_plan, counters = _propagate_reference(inst)
+        reference["wall_clock_sec"] += time.perf_counter() - ref_t0
+        reference["attempts"] += 1
+        reference["successes"] += int(
+            ref_plan is not None and verify(inst, ref_plan)[0]
+        )
+        for key in ("relation_scans", "assignments", "queue_pops"):
+            reference[key] += counters[key]
+    reference["wall_clock_sec"] = round(reference["wall_clock_sec"], 6)
+    reference["solves"] = f"{reference['successes']}/{reference['attempts']}, as expected"
+    all_failed = all(result["successes"] == 0 and result["attempts"] >= 8
+                     for result in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference["successes"] == reference["attempts"],
+        "attacks": attacks,
+        "reference_algorithm": reference,
+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled_params["constraint_count"] *= 2
+    scale_t0 = time.perf_counter()
+    doubled = make_instance(seed=424242, **doubled_params)
+    scale_wall = time.perf_counter() - scale_t0
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": bool(doubled_ok),
+        "base_n": DIFFICULTY[SHIPPING_DIFFICULTY]["n"],
+        "doubled_n": doubled_params["n"],
+        "build_wall_sec": round(scale_wall, 6),
+        "verify_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    carried_checks = 0
+    distinct_keys = []
+    g8_failures = []
+    for seed in range(20):
+        inst = make_instance(seed=70_000 + seed, **DIFFICULTY["easy"])
+        rng = random.Random(80_000 + seed)
+        permutation = list(range(inst["n"]))
+        rng.shuffle(permutation)
+        reverse_mask = [bool(rng.randrange(2))
+                        for _ in inst["type1_difference_constraints"]]
+        order = list(range(len(inst["type1_difference_constraints"])))
+        rng.shuffle(order)
+        relabelled = _permute_instance(inst, permutation)
+        composed = _permute_instance(inst, permutation, reverse_mask, order)
+        scale = rng.randrange(1, inst["user_modulus"])
+        translation = rng.randrange(inst["user_modulus"])
+        user_relabelled = _affine_user_relabel(inst, scale, translation)
+        base_key = canonical_key(inst)
+        for transformed in (relabelled, composed, user_relabelled):
+            invariant_checks += 1
+            if canonical_key(transformed) != base_key:
+                g8_failures.append([seed, "key changed under a valid relabeling"])
+            carried_checks += 1
+            if not verify(transformed, transformed["answer"])[0]:
+                g8_failures.append([seed, "carried witness failed"])
+        distinct_keys.append(base_key)
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures and len(set(distinct_keys)) == 20,
+        "invariance_checks": invariant_checks,
+        "carried_witness_checks": carried_checks,
+        "unrelated_instances": 20,
+        "distinct_keys": len(set(distinct_keys)),
+        "failures": g8_failures,
+    }
+
+    answer_blob = json.dumps(planted, separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _answer_atom_count(planted)
+    intended_operations = 30 + 2 * shipping["n"]
+    hinted = _G9_ARMS["hinted"]
+    placebo = _G9_ARMS["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": _G9_HINTED_VERDICT == "hardened" and within_caps,
+        "arms": json.loads(json.dumps(_G9_ARMS)),
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": _G9_HINTED_VERDICT,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["all_passed"] = all(
+        value.get("pass") is True
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

codex
The solved replies confirm the weakness: the models were doing direct difference propagation and ignoring the intended labels. I’m replacing that mechanism with the paper’s own Section 6 matching object—a sparse authorization relation plus the paper’s \((1,S)\) all-different counting constraint. The certificate is a planted perfect matching; Hopcroft–Karp is the disclosed reference algorithm from Theorem 6.5; the compact label route remains 240 modular operations. This also makes the mechanical route materially different from the shortcut.
