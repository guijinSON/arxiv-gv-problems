+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "workflow steps",
+        "finite user set",
+        "step-user authorization relation",
+        "counting constraint (1,S) requiring distinct users",
+    ],
