+def search_space(inst):
+    return inst["user_modulus"] ** (inst["n"] - 1)
+
+
+def enumerate_all(inst):
+    """Brute-force an exact count only for safely tiny candidate languages."""
+    space = search_space(inst)
+    if space > 1_000_000:
+        return None
+    n = inst["n"]
+    q = inst["user_modulus"]
+    anchor = inst["anchor_step"]
+    free = [i for i in range(n) if i != anchor]
+    count = 0
+    for code in range(space):
+        plan = [0] * n
+        plan[anchor] = inst["anchor_user"]
+        value = code
+        for step in free:
+            plan[step] = value % q
+            value //= q
+        if verify(inst, plan)[0]:
+            count += 1
+    return count
