+def _canonical_relations(inst):
+    """Orient by labels and normalize affine user relabeling of all offsets."""
+    q = inst["user_modulus"]
+    labels = inst["labels"]
+    rows = []
+    for a, b, offset in inst["type1_difference_constraints"]:
+        la, lb = labels[a], labels[b]
+        if la < lb:
+            rows.append([la, lb, offset % q])
+        else:
+            rows.append([lb, la, (-offset) % q])
