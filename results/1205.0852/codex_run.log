+except ImportError:  # pragma: no cover - the module remains stdlib-only.
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "workflow steps",
+        "two users",
+        "authorization relation",
+        "Type-1 and Type-2 separation-of-duty constraints",
+    ],
+    "verification_operations": [
+        "integer range check",
+        "authorization lookup",
+        "exact inequality comparison",
+        "finite existential check over a two-step set",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The primary-step user is determined by which half of a modular residue "
+        "system contains the sum of its three label coordinates; without that "
+        "invariant one must solve the shuffled NAE constraint system."
+    ),
+    "hardness_basis": (
+        "Track B: DPLL with unit propagation (worst-case O(2^n c)) is the exact "
+        "reference algorithm; across eight shipping instances it averaged 0.00624 "
+        "seconds, 14.5 search nodes, and 40,932 literal inspections, versus at "
+        "most 5n=300 exact operations for the compact label-invariant route."
+    ),
+    "max_answer_tokens": 61,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
