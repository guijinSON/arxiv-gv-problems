+
+def make_instance(n, seed=0, constraint_count=None, user_modulus=1000003, **params):
+    """Inverse-generate a satisfiable modular-relation WSP instance."""
+    if not isinstance(n, int) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    if not isinstance(user_modulus, int) or not _is_prime(user_modulus):
+        raise ValueError("user_modulus must be prime")
+    if n >= user_modulus:
+        raise ValueError("n must be smaller than user_modulus")
+    if constraint_count is None:
+        constraint_count = 4 * n
+    max_pairs = n * (n - 1) // 2
+    if not isinstance(constraint_count, int) or not (n - 1 <= constraint_count <= max_pairs):
