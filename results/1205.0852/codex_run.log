+NOTES = """\
+Definition source: Section 2 defines plans, authorization, counting constraints,
+and Type-1/2/3 entailment constraints; in particular, (!=, S1, S2) requires an
+existential pair assigned to different users.  The family follows the appendix
+proof of Theorem 4 (label thm:lb): one primary and one complement step per Boolean
+variable, a Type-1 != constraint on every pair, and a Type-2 != constraint for
+each NAE triple.  That proof also fixes the hard regime at exactly two users.
+
+Easy-method audit: Theorem 1 gives a general ~O(2^k(c+n_users^2)) Max Weighted
+Partition method; Theorem 4 supplies only an ETH worst-case lower bound and does
+not prove a planted distribution hard.  Therefore this module is honestly Track
+B.  Its reference algorithm is exact DPLL with unit propagation.  The compact
+route is a modular label invariant planted before constraints are sampled.
+
+Construction and attacks: labels are balanced between the two modular halves;
+signed triples are sampled uniformly conditional only on being NAE under the
+planted plan, so individual occurrence statistics do not identify the plant.
+The panel tests first-coordinate outliers, literal-frequency bias, a sequential
+no-backtracking assignment, a natural sum-parity ansatz, and random restarts.
+The labels are intrinsic instance attributes; canonicalization sorts by those
+labels and is invariant to variable-pair renumbering, constraint/literal order,
+and the global swap of the two indistinguishable users.
+"""
+
+
+# Filled only after the script-owned hardening runs.  selftest reports these
+# constants without reading transcript files, so the generator performs no I/O.
+_G9_ARMS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+}
+_G9_HINTED_VERDICT = "pending"
+
+
+def _label_class(label, modulus):
+    """The planted primary-step user, computed without any workflow search."""
+    return int((sum(label) % modulus) >= (modulus // 2))
+
+
+def _step_name(step, n):
+    return ("X" + str(step)) if step < n else ("NX" + str(step - n))
+
+
+def make_instance(n, seed=0, clause_count=None, label_modulus=10007, **params):
+    """Inverse-generate a satisfiable native two-user WSP instance.
+
+    ``n`` is the number of Boolean variable pairs and hence half the number of
+    workflow steps.  The valid plan is chosen from labels first.  Every sampled
+    constraint is then conditioned on that already-known plan being NAE.
+    """
+    if not isinstance(n, int) or n < 4:
+        raise ValueError("n must be an integer at least 4")
+    if not isinstance(label_modulus, int) or label_modulus < 5:
+        raise ValueError("label_modulus must be an integer at least 5")
+    if clause_count is None:
+        clause_count = 5 * n
+    if not isinstance(clause_count, int) or clause_count < n:
+        raise ValueError("clause_count must be an integer at least n")
+
+    # At most 6*C(n,3) of the 8*C(n,3) signed triples are NAE under
+    # any fixed assignment.  This conservative check keeps rejection sampling
+    # bounded even at the demo setting.
+    max_nae = n * (n - 1) * (n - 2)
+    if clause_count > max_nae:
+        raise ValueError("too many distinct conditional NAE constraints requested")
+
+    rng = random.Random(seed)
+
+    # Give both planted user classes the same population (up to one when n is
+    # odd).  Labels within a class are otherwise independent samples from the
+    # same three-coordinate distribution conditioned on the class.
+    targets = [n // 2, n - n // 2]
+    buckets = [[], []]
+    seen_labels = set()
+    while len(buckets[0]) < targets[0] or len(buckets[1]) < targets[1]:
+        label = tuple(rng.randrange(label_modulus) for _ in range(3))
+        if label in seen_labels:
+            continue
+        cls = _label_class(label, label_modulus)
+        if len(buckets[cls]) >= targets[cls]:
+            continue
+        seen_labels.add(label)
+        buckets[cls].append(label)
+
+    labels = buckets[0] + buckets[1]
+    rng.shuffle(labels)
+    primary = [_label_class(label, label_modulus) for label in labels]
+    planted = primary + [1 - bit for bit in primary]
+
+    constraints = set()
+    while len(constraints) < clause_count:
+        variables = rng.sample(range(n), 3)
+        steps = tuple(
+            v + (n if rng.randrange(2) else 0)
+            for v in variables
+        )
+        values = [planted[s] for s in steps]
+        if values[0] == values[1] == values[2]:
+            continue
+        # NAE is symmetric in its three literal steps.  Store a sorted triple so
+        # duplicates do not arise merely from a different Type-2 anchor choice.
+        constraints.add(tuple(sorted(steps)))
+
+    constraints = list(constraints)
+    rng.shuffle(constraints)
+
+    return {
+        "n": n,
+        "users": [0, 1],
+        "label_modulus": label_modulus,
+        "labels": [list(x) for x in labels],
+        "complement_pairs": [[i, n + i] for i in range(n)],
+        "type2_neq_constraints": [list(x) for x in constraints],
+        "answer": list(planted),
+    }
+
+
+def render(inst):
+    """Render the complete, standalone WSP question."""
+    n = inst["n"]
+    lines = [
+        "WORKFLOW SATISFIABILITY (two users, separation-of-duty constraints)",
+        "",
+        f"There are {2*n} workflow steps and exactly two users, numbered 0 and 1.",
+        "A plan assigns one user to every step. Both users are authorized for",
+        "every step, and the workflow has no precedence restrictions.",
+        "",
+        "A Type-1 constraint NE(a,b) is satisfied exactly when steps a and b",
+        "are assigned to different users. A Type-2 constraint NE(a,{b,c}) is",
+        "satisfied exactly when at least one of b,c is assigned to a different",
+        "user from a; equivalently, a,b,c must not all have the same user.",
+        "",
+        "For each i, Xi is a primary step and NXi is its complement step.",
+        "The displayed integer triple is an auxiliary label on Xi; labels impose",
+        "no extra constraint. All modular residues, if used, are least residues",
+        f"in 0..{inst['label_modulus']-1}, with modulus {inst['label_modulus']}.",
+        "",
+        "Step pairs and labels:",
+    ]
+    for i, label in enumerate(inst["labels"]):
+        lines.append(f"  {i:02d}: X{i}, NX{i}, label=({label[0]},{label[1]},{label[2]})")
+
+    lines.extend([
+        "",
+        "Type-1 constraints (one per line):",
+    ])
+    for a, b in inst["complement_pairs"]:
+        lines.append(f"  NE({_step_name(a,n)},{_step_name(b,n)})")
+
+    lines.extend([
+        "",
+        "Type-2 constraints (one per line):",
+    ])
+    for a, b, c in inst["type2_neq_constraints"]:
+        lines.append(
+            f"  NE({_step_name(a,n)},{{{_step_name(b,n)},{_step_name(c,n)}}})"
+        )
+
+    lines.extend([
+        "",
+        "Find any valid plan. Repetitions of a user are allowed except where a",
+        "constraint forbids them. Output exactly 2n integers in this fixed order:",
+        "X0,X1,...,X(n-1),NX0,NX1,...,NX(n-1). Each integer must be 0 or 1.",
+        "",
+        "Give your final answer inside <answer></answer> tags as comma-separated",
+        "user identifiers. Example syntax: <answer>0, 1</answer>",
+        "Output nothing else inside the tags.",
+    ])
+
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer>", re.I | re.S)
+
+
+def parse_answer(text):
+    """Parse the last delimited comma-separated integer plan; never raise."""
+    if not isinstance(text, str):
+        return None
+    blocks = _ANSWER_RE.findall(text)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    if not body:
+        return []
+    if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
+        return None
+    try:
+        return [int(x.strip()) for x in body.split(",")]
+    except (TypeError, ValueError):
+        return None
+
+
+def verify(inst, answer):
+    """Check a candidate plan exactly, without consulting ``inst['answer']``."""
+    if not isinstance(answer, list):
+        return False, "answer must be a list of user identifiers"
+    expected = 2 * inst["n"]
+    if len(answer) == 0:
+        return False, "answer is empty"
+    if len(answer) < expected:
+        return False, f"too few plan entries: expected {expected}, got {len(answer)}"
+    if len(answer) > expected:
+        return False, f"too many plan entries: expected {expected}, got {len(answer)}"
+    for i, user in enumerate(answer):
+        if type(user) is not int or user not in (0, 1):
+            return False, f"entry {i} is not an authorized user identifier 0 or 1"
+    for pair_index, (a, b) in enumerate(inst["complement_pairs"]):
+        if answer[a] == answer[b]:
+            return False, f"Type-1 constraint {pair_index} is violated"
+    for constraint_index, (a, b, c) in enumerate(inst["type2_neq_constraints"]):
+        if answer[a] == answer[b] == answer[c]:
+            return False, f"Type-2 constraint {constraint_index} is violated"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample uniformly after enforcing every explicit complement-pair rule."""
+    primary = [rng.randrange(2) for _ in range(inst["n"])]
+    return primary + [1 - bit for bit in primary]
+
+
+def search_space(inst):
+    """The bounded, structure-aware plan language has exactly 2^n members."""
+    return 1 << inst["n"]
+
+
+def enumerate_all(inst):
+    """Brute-force the exact solution count only while that is safely small."""
+    n = inst["n"]
+    if n > 20:
+        return None
+    count = 0
+    for mask in range(1 << n):
+        primary = [(mask >> i) & 1 for i in range(n)]
+        candidate = primary + [1 - bit for bit in primary]
+        if verify(inst, candidate)[0]:
+            count += 1
+    return count
+
+
+def canonical_key(inst):
+    """Canonicalize variable-pair numbering and all constraint orderings."""
+    n = inst["n"]
+    labels = [tuple(x) for x in inst["labels"]]
+
+    canonical_constraints = []
+    for triple in inst["type2_neq_constraints"]:
+        named = []
+        for step in triple:
+            polarity = 0 if step < n else 1
+            variable = step if step < n else step - n
+            named.append([list(labels[variable]), polarity])
+        named.sort(key=lambda x: (x[0], x[1]))
+        canonical_constraints.append(named)
+    canonical_constraints.sort(
+        key=lambda clause: tuple((tuple(x[0]), x[1]) for x in clause)
+    )
+
+    payload = {
+        "users": 2,
+        "label_modulus": inst["label_modulus"],
+        "labels": [list(x) for x in sorted(labels)],
+        "constraints": canonical_constraints,
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params):
+    """Increase mental arithmetic and constraint crowding before answer length."""
+    p = {k: v for k, v in params.items() if k != "_preset"}
+    modulus = int(p.get("label_modulus", 10007))
+    clauses = int(p.get("clause_count", 5 * int(p["n"])))
+    n = int(p["n"])
+
+    # The first six post-ladder escalations keep the 2n-entry witness fixed and
+    # enlarge the arithmetic haystack.  This is the principal Track-B axis.
+    if modulus < 10_000_019:
+        p["label_modulus"] = modulus * 10 + 3
+        p["clause_count"] = clauses
+        p["n"] = n
+        return p
+
+    # A second fixed-answer axis adds crowded, uniformly conditioned constraints.
+    if clauses < 9 * n:
+        p["clause_count"] = min(9 * n, clauses + n)
+        p["label_modulus"] = modulus
+        p["n"] = n
+        return p
+
+    # The compact route already uses 5n operations at n=60.  There is no honest
+    # room to lengthen it under G9(c); all fixed-length axes above are exhausted.
+    return None
+
+
+def _clauses_over_primary_variables(inst):
+    """Convert the WSP Type-2 constraints to the two CNF clauses for NAE."""
+    n = inst["n"]
+    clauses = []
+    for triple in inst["type2_neq_constraints"]:
+        positive = []
+        for step in triple:
+            if step < n:
+                positive.append(step + 1)
+            else:
+                positive.append(-(step - n + 1))
+        clauses.append(tuple(positive))
+        clauses.append(tuple(-lit for lit in positive))
+    return clauses
+
+
+def _dpll_reference(inst, node_limit=None):
+    """Exact DPLL + unit propagation; returns (plan|None, counters)."""
+    clauses = _clauses_over_primary_variables(inst)
+    n = inst["n"]
+    counters = {"nodes": 0, "literal_inspections": 0, "unit_assignments": 0}
+
+    def lit_value(lit, assignment):
+        val = assignment[abs(lit) - 1]
+        if val < 0:
+            return None
+        return bool(val) if lit > 0 else not bool(val)
+
+    def propagate(assignment):
+        while True:
+            changed = False
+            for clause in clauses:
+                satisfied = False
+                unassigned = []
+                for lit in clause:
+                    counters["literal_inspections"] += 1
+                    val = lit_value(lit, assignment)
+                    if val is True:
+                        satisfied = True
+                        break
+                    if val is None:
+                        unassigned.append(lit)
+                if satisfied:
+                    continue
+                if not unassigned:
+                    return False
+                if len(unassigned) == 1:
+                    lit = unassigned[0]
+                    idx = abs(lit) - 1
+                    needed = 1 if lit > 0 else 0
+                    if assignment[idx] >= 0 and assignment[idx] != needed:
+                        return False
+                    if assignment[idx] < 0:
+                        assignment[idx] = needed
+                        counters["unit_assignments"] += 1
+                        changed = True
+            if not changed:
+                return True
+
+    def choose_variable(assignment):
+        scores = [0] * n
+        for clause in clauses:
+            if any(lit_value(lit, assignment) is True for lit in clause):
+                continue
+            for lit in clause:
+                idx = abs(lit) - 1
+                if assignment[idx] < 0:
+                    scores[idx] += 1
+        best = max((score, -idx) for idx, score in enumerate(scores)
+                   if assignment[idx] < 0)
+        return -best[1]
+
+    def solve(assignment):
+        counters["nodes"] += 1
+        if node_limit is not None and counters["nodes"] > node_limit:
+            return None
+        assignment = list(assignment)
+        if not propagate(assignment):
+            return False
+        if all(x >= 0 for x in assignment):
+            return assignment
+        var = choose_variable(assignment)
+        for value in (0, 1):
+            child = list(assignment)
+            child[var] = value
+            result = solve(child)
+            if result is None:
+                return None
+            if result is not False:
+                return result
+        return False
+
+    primary = solve([-1] * n)
+    if primary is None or primary is False:
+        return None, counters
+    plan = list(primary) + [1 - bit for bit in primary]
+    return plan, counters
+
+
+def _attack_first_coordinate(inst):
+    midpoint = inst["label_modulus"] // 2
+    primary = [int(label[0] >= midpoint) for label in inst["labels"]]
+    return primary + [1 - bit for bit in primary]
+
+
+def _attack_literal_frequency(inst):
+    n = inst["n"]
+    score = [0] * n
+    for triple in inst["type2_neq_constraints"]:
+        for step in triple:
+            if step < n:
+                score[step] += 1
+            else:
+                score[step - n] -= 1
+    primary = [int(x < 0) for x in score]
+    return primary + [1 - bit for bit in primary]
+
+
+def _attack_sum_parity(inst):
+    primary = [sum(label) & 1 for label in inst["labels"]]
+    return primary + [1 - bit for bit in primary]
+
+
+def _attack_greedy_no_backtracking(inst):
+    clauses = _clauses_over_primary_variables(inst)
+    n = inst["n"]
+    assignment = [-1] * n
+
+    def clause_violated(clause):
+        values = []
+        for lit in clause:
+            value = assignment[abs(lit) - 1]
+            if value < 0:
+                return False
+            values.append(value if lit > 0 else 1 - value)
+        return not any(values)
+
+    for var in range(n):
+        assignment[var] = 0
+        if any(clause_violated(clause) for clause in clauses):
+            assignment[var] = 1
+    return assignment + [1 - bit for bit in assignment]
+
+
+def _attack_random_restart(inst, rng, attempts):
+    last = None
+    for _ in range(attempts):
+        last = random_candidate(inst, rng)
+        if verify(inst, last)[0]:
+            return last, True
+    return last, False
+
+
+def _permute_instance(inst, permutation, constraint_order=None):
+    """Relabel variable pairs, carrying labels and plan through the bijection."""
+    n = inst["n"]
+    if sorted(permutation) != list(range(n)):
+        raise ValueError("not a permutation")
+    labels = [None] * n
+    answer = [None] * (2 * n)
+    for old, new in enumerate(permutation):
+        labels[new] = list(inst["labels"][old])
+        answer[new] = inst["answer"][old]
+        answer[n + new] = inst["answer"][n + old]
+
+    triples = []
+    for triple in inst["type2_neq_constraints"]:
+        mapped = []
+        for step in triple:
+            if step < n:
+                mapped.append(permutation[step])
+            else:
+                mapped.append(n + permutation[step - n])
+        triples.append(mapped)
+    if constraint_order is not None:
+        triples = [triples[i] for i in constraint_order]
+
+    return {
+        "n": n,
+        "users": list(inst["users"]),
+        "label_modulus": inst["label_modulus"],
+        "labels": labels,
+        "complement_pairs": [[i, n + i] for i in range(n)],
+        "type2_neq_constraints": triples,
+        "answer": answer,
+    }
+
+
+def _answer_atom_count(answer):
+    if isinstance(answer, dict):
+        return sum(_answer_atom_count(v) for v in answer.values())
+    if isinstance(answer, (list, tuple)):
+        return sum(_answer_atom_count(v) for v in answer)
+    return 1
+
+
+def selftest():
+    """Run all local gates and return a fully JSON-native measurement report."""
+    report = {}
+
+    # G1: every named preset, several independent seeds.
+    g1_attempts = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 19):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append([preset, seed, why])
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    shipping = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = shipping["answer"]
+
+    # G2: five genuinely different corruptions and five distinct diagnostics.
+    opposite = next(i for i in range(1, len(planted)) if planted[i] != planted[0])
+    swapped = list(planted)
+    swapped[0], swapped[opposite] = swapped[opposite], swapped[0]
+    corruptions = {
+        "drop": list(planted[:-1]),
+        "swap": swapped,
+        "duplicate": list(planted[:1]) + list(planted),
+        "empty": [],
+        "out_of_range": list(planted[:-1]) + [2],
+    }
+    g2_results = {}
+    reasons = []
+    for name, candidate in corruptions.items():
+        ok, why = verify(shipping, candidate)
+        g2_results[name] = {"accepted": bool(ok), "reason": why}
+        reasons.append(why)
+    report["G2_rejects_corruption"] = {
+        "pass": all(not x["accepted"] for x in g2_results.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": g2_results,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    # G3: model-style prose, markdown fencing, and JSON-native round trip.
+    wire = ", ".join(str(x) for x in planted)
+    realistic = "I checked every constraint.\n```text\n<answer>" + wire + "</answer>\n```"
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and json.loads(json.dumps(planted)) == planted,
+        "parsed_entries": len(parsed) if isinstance(parsed, list) else None,
+        "json_native": json.loads(json.dumps(planted)) == planted,
+    }
+
+    # G4/G5: the same shipping-preset, structure-aware sample.
+    guess_total = 200_000
+    guess_hits = 0
+    guess_rng = random.Random(271828)
+    sample_t0 = time.perf_counter()
+    for _ in range(guess_total):
+        if verify(shipping, random_candidate(shipping, guess_rng))[0]:
+            guess_hits += 1
+    sample_wall = time.perf_counter() - sample_t0
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_fraction": guess_fraction,
+        "structure_aware_space": search_space(shipping),
+        "prior": "uniform primary bits with all complement-pair constraints enforced",
+    }
+
+    baseline_rng = random.Random(161803)
+    baseline_t0 = time.perf_counter()
+    _, baseline_success = _attack_random_restart(shipping, baseline_rng, 4096)
+    baseline_wall = time.perf_counter() - baseline_t0
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    report["G5_density_and_baseline_cost"] = {
