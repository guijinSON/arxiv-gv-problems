+        "n": n,
+        "user_modulus": q,
+        "labels": labels,
+        "anchor_step": anchor_step,
+        "anchor_user": anchor_user,
+        "type1_difference_constraints": relations,
+        "answer": planted,
+    }
+
+
+def render(inst):
+    """Render a complete WSP statement and an exact output contract."""
+    n = inst["n"]
+    q = inst["user_modulus"]
+    lines = [
+        "WORKFLOW SATISFIABILITY WITH MODULAR USER RELATIONS",
+        "",
+        f"There are {n} workflow steps S0,...,S{n-1} and {q} users.",
+        f"Users are the integer residues 0,...,{q-1} modulo q={q}.",
+        "A plan assigns exactly one user to every step. There are no precedence",
+        "restrictions. Every user is authorized for every step except the anchor",
+        f"step S{inst['anchor_step']}, whose only authorized user is {inst['anchor_user']}.",
+        "",
+        "Each step also has a scalar label in Z_q. Labels are auxiliary instance",
+        "data and impose no additional validity condition by themselves:",
