+def _attack_small_affine_slopes(inst):
+    q = inst["user_modulus"]
+    anchor = inst["anchor_step"]
+    last = None
+    for slope in list(range(1, 17)) + list(range(q - 16, q)):
+        last = [(slope * label) % q for label in inst["labels"]]
+        last[anchor] = inst["anchor_user"]
+        if verify(inst, last)[0]:
+            return last, True
+    return last, False
+
+
+def _attack_random_affine_restart(inst, rng, attempts):
+    q = inst["user_modulus"]
+    anchor = inst["anchor_step"]
+    last = None
+    for _ in range(attempts):
+        slope = rng.randrange(1, q)
+        last = [(slope * label) % q for label in inst["labels"]]
+        last[anchor] = inst["anchor_user"]
+        if verify(inst, last)[0]:
+            return last, True
+    return last, False
