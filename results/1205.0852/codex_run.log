+        "user_modulus": q,
+        "labels": list(inst["labels"]),
+        "anchor_step": inst["anchor_step"],
+        "anchor_user": (scale * inst["anchor_user"] + translation) % q,
+        "type1_difference_constraints": [
+            [a, b, (scale * offset) % q]
+            for a, b, offset in inst["type1_difference_constraints"]
+        ],
+        "answer": [(scale * user + translation) % q for user in inst["answer"]],
+    }
