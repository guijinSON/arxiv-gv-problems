+            "greedy_lowest_authorized": _attack_lowest_authorized(inst),
+            "obvious_small_affine_slopes": small_candidate,
+            "random_one_pass_propagation": _attack_one_pass_propagation(
+                inst, random.Random(50_000 + seed)
