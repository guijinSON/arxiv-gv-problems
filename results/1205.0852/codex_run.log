   363	def _hopcroft_karp_reference(inst):
   364	    """Paper-standard maximum matching, with exact operation counters."""
   365	    n = inst["n"]
   366	    user_index = {user: i for i, user in enumerate(inst["users"])}
   367	    adjacency = [[user_index[user] for user in row] for row in inst["authorizations"]]
   368	    pair_step = [-1] * n
   369	    pair_user = [-1] * n
   370	    distance = [0] * n
   371	    counts = {"edge_scans": 0, "bfs_rounds": 0, "dfs_calls": 0, "augmentations": 0}
   372	
   373	    def bfs():
   374	        counts["bfs_rounds"] += 1
   375	        queue = deque()
   376	        found = False
   377	        for step in range(n):
   378	            if pair_step[step] < 0:
   379	                distance[step] = 0
   380	                queue.append(step)
   381	            else:
   382	                distance[step] = -1
   383	        while queue:
   384	            step = queue.popleft()
   385	            for user in adjacency[step]:
   386	                counts["edge_scans"] += 1
   387	                other = pair_user[user]
   388	                if other < 0:
   389	                    found = True
   390	                elif distance[other] < 0:
   391	                    distance[other] = distance[step] + 1
   392	                    queue.append(other)
   393	        return found
   394	
   395	    def dfs(step):
   396	        counts["dfs_calls"] += 1
   397	        for user in adjacency[step]:
   398	            counts["edge_scans"] += 1
   399	            other = pair_user[user]
   400	            if other < 0 or (distance[other] == distance[step] + 1 and dfs(other)):
   401	                pair_step[step] = user
   402	                pair_user[user] = step
   403	                return True
   404	        distance[step] = -1
   405	        return False
   406	
   407	    while bfs():
   408	        progress = False
   409	        for step in range(n):
   410	            if pair_step[step] < 0 and dfs(step):
   411	                counts["augmentations"] += 1
   412	                progress = True
   413	        if not progress:
   414	            break
   415	    if any(user < 0 for user in pair_step):
   416	        return None, counts
   417	    return [inst["users"][user] for user in pair_step], counts
   418	
   419	
   420	def _attack_row_extreme(inst, largest=False):
   421	    return [(max(row) if largest else min(row)) for row in inst["authorizations"]]
   422	
   423	
   424	def _attack_label_nearest(inst):
   425	    q = inst["label_modulus"]
   426	    answer = []
   427	    for label, row in zip(inst["step_labels"], inst["authorizations"]):
   428	        answer.append(min(row, key=lambda user: (min((user-label) % q, (label-user) % q), user)))
   429	    return answer
