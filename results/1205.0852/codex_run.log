+"""Verified generator for arXiv:1205.0852.
+
+The family uses the NAE-3-SAT -> two-user WSP_2(!=) construction in the
+appendix proof of Theorem 4.  Instances are generated inversely: choose a plan
+from a modular invariant first, then sample only NAE constraints it satisfies.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import random
+import re
+import sys
