+    slope = rng.randrange(1, q)
+    while slope in forbidden:
+        slope = rng.randrange(1, q)
+
+    labels = [0]
+    seen = {0}
+    while len(labels) < n:
+        label = rng.randrange(1, q)
+        if label not in seen:
+            seen.add(label)
+            labels.append(label)
+    rng.shuffle(labels)
+    anchor_step = labels.index(0)
+    anchor_user = 0
+    planted = [(slope * label) % q for label in labels]
+
+    # A uniformly relabelled random tree certifies connectivity by construction.
+    order = list(range(n))
+    rng.shuffle(order)
+    pairs = set()
+    for i in range(1, n):
+        a = order[i]
+        b = order[rng.randrange(i)]
+        pairs.add((min(a, b), max(a, b)))
+    while len(pairs) < constraint_count:
+        a, b = rng.sample(range(n), 2)
+        pairs.add((min(a, b), max(a, b)))
