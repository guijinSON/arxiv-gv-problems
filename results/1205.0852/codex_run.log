+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A length-n permutation of the displayed n integer user identifiers, in "
+        "step order; this enforces the explicit (1,S) all-different counting "
+        "constraint before authorization is tested."
+    ),
+    "bounds": {
