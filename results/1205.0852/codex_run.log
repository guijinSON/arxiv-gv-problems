   283	def verify(inst, answer):
   284	    """Check authorization and (1,S) exactly; never consult inst['answer']."""
   285	    if not isinstance(answer, list):
   286	        return False, "answer must be a list of user identifiers"
   287	    n = inst["n"]
   288	    if not answer:
   289	        return False, "answer is empty"
   290	    if len(answer) < n:
   291	        return False, f"too few plan entries: expected {n}, got {len(answer)}"
   292	    if len(answer) > n:
   293	        return False, f"too many plan entries: expected {n}, got {len(answer)}"
   294	    user_set = set(inst["users"])
   295	    for i, user in enumerate(answer):
   296	        if type(user) is not int or user not in user_set:
   297	            return False, f"entry {i} is not a displayed user identifier"
   298	    if len(set(answer)) != n:
   299	        return False, "counting constraint (1,S) is violated by a repeated user"
   300	    for step, user in enumerate(answer):
   301	        if user not in inst["authorizations"][step]:
   302	            return False, f"step S{step} is assigned an unauthorized user"
   303	    return True, "ok"
