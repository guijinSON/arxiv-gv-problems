+    "hardness_basis": (
+        "Track B: the Section 6 Hopcroft-Karp reference algorithm solves the "
+        "authorization matching in O(E sqrt(V)) and is expected to succeed; across "
+        "eight shipping instances it took 0.003164 seconds and 16,435 edge "
+        "scans, while the compact linear-label route uses 240 modular operations."
+    ),
+    "max_answer_tokens": 208,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
