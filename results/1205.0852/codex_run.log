+def _residue_rows(inst):
+    """Authorization rows expressed in intrinsic cyclic coordinates."""
+    user_residue = inst["user_residues"]
+    rows = {}
+    for step, row in enumerate(inst["authorizations"]):
+        residue = inst["step_residues"][step]
