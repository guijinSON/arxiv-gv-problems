+    counters = {"relation_scans": 0, "assignments": 0, "queue_pops": 0}
+    for a, b, offset in inst["type1_difference_constraints"]:
+        adjacency[a].append((b, offset))
+        adjacency[b].append((a, (-offset) % q))
