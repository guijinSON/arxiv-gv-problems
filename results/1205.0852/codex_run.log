/bin/bash -lc "python3 - <<'PY'
import importlib.util,json,os
s=importlib.util.spec_from_file_location('g','gen_1205_0852.py');m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
p=m.DIFFICULTY[m.SHIPPING_DIFFICULTY]
a=m.make_instance(seed=4242,**p);b=m.make_instance(seed=4242,**p)
assert a==b
assert json.loads(json.dumps(a['answer']))==a['answer']
assert 'Hint:' not in m.render(a)
os.environ['GV_HINT_MODE']='structural'; assert m.STRUCTURAL_HINT in m.render(a)
