+            invariant_checks += 1
+            if canonical_key(transformed) != base_key:
+                g8_failures.append([seed, "key changed under a valid relabeling"])
+            carried_checks += 1
+            if not verify(transformed, transformed["answer"])[0]:
+                g8_failures.append([seed, "carried witness failed"])
+        distinct_keys.append(base_key)
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures and len(set(distinct_keys)) == 20,
+        "invariance_checks": invariant_checks,
+        "carried_witness_checks": carried_checks,
+        "unrelated_instances": 20,
+        "distinct_keys": len(set(distinct_keys)),
+        "failures": g8_failures,
