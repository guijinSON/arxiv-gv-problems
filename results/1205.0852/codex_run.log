+    n = int(p["n"])
+    q = int(p.get("user_modulus", 1000003))
+    constraints = int(p.get("constraint_count", 15 * n))
+    maximum = n * (n - 1) // 2
+    if q < 1_000_000_000_000:
+        p["user_modulus"] = _next_prime(10 * q + 1)
+        p["constraint_count"] = constraints
+        p["n"] = n
+        return p
+    if constraints < min(maximum, 25 * n):
