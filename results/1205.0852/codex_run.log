+        relations = [relations[i] for i in constraint_order]
+    return {
+        "n": n,
+        "user_modulus": inst["user_modulus"],
+        "labels": labels,
+        "anchor_step": permutation[inst["anchor_step"]],
+        "anchor_user": inst["anchor_user"],
+        "type1_difference_constraints": relations,
+        "answer": answer,
+    }
