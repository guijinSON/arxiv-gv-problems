   458	def _permute_instance(inst, step_permutation, user_order, row_orders):
   459	    n = inst["n"]
   460	    labels = [None] * n
   461	    rows = [None] * n
   462	    answer = [None] * n
   463	    for old, new in enumerate(step_permutation):
   464	        labels[new] = inst["step_labels"][old]
   465	        rows[new] = [inst["authorizations"][old][i] for i in row_orders[old]]
   466	        answer[new] = inst["answer"][old]
   467	    return {
   468	        "n": n,
   469	        "label_modulus": inst["label_modulus"],
   470	        "audit_multiplier": inst["audit_multiplier"],
   471	        "step_labels": labels,
   472	        "users": [inst["users"][i] for i in user_order],
   473	        "authorizations": rows,
   474	        "counting_constraint": [1, list(range(n))],
   475	        "answer": answer,
   476	    }
