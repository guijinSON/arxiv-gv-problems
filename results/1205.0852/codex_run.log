+                    continue
+                if not unassigned:
+                    return False
+                if len(unassigned) == 1:
+                    lit = unassigned[0]
+                    idx = abs(lit) - 1
+                    needed = 1 if lit > 0 else 0
+                    if assignment[idx] >= 0 and assignment[idx] != needed:
+                        return False
