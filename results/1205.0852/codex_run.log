+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 6, "decoy_permutations": 1, "label_modulus": 31},
+    "easy": {"n": 48, "decoy_permutations": 2, "label_modulus": 10007},
+    "medium": {"n": 84, "decoy_permutations": 3, "label_modulus": 100003},
+    "hard": {"n": 120, "decoy_permutations": 4, "label_modulus": 1000003},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A length-n permutation of the displayed n integer user identifiers, in "
+        "step order; this enforces the explicit (1,S) all-different counting "
+        "constraint before authorization is tested."
+    ),
+    "bounds": {
+        "entries": "n",
+        "distinct_entries": "n",
+        "candidate_users": "the displayed n-element user set",
+        "shipping_n": 120,
+    },
+}
+
+STRUCTURAL_HINT = (
+    "One authorized matching is linear over Z_q in the displayed scalar step labels."
+)
+PLACEBO_HINT = (
+    "The authorized matching rewards careful bookkeeping across the displayed workflow data."
+)
+
+NOTES = """\
+Sections 2.1--2.2 fix the native problem and the counting-constraint semantics:
+a plan maps steps to authorized users, and (1,S) requires a different user for
+every step in S. Section 6 and Theorem 6.5 explicitly build the authorization
+bipartite graph and use Hopcroft-Karp maximum matching to obtain a plan. This
+module hands the solver exactly those objects; no convenience reduction is used.
+
+STEP 0 rules out Track A. Theorem 3.4 supplies an FPT route for regular
+constraints, Proposition 6.2 covers (1,t,S)-style constraints, and Theorem 6.5's
+proof gives the polynomial matching algorithm used here. Its certificate is the
+output of that algorithm, so this is honestly Track B. Mechanical matching is
+reported as a successful reference algorithm; the tested difficulty is the gap
+between that route and recognizing one linear matching hidden in the labels.
+
+Generation is inverse. A multiplier and distinct step labels are sampled first;
+their products modulo q form a perfect matching and the planted plan. Independent
+random permutations add decoy authorized pairs. Every permutation contributes
+one edge at each step and user, and row order is shuffled, so planted and decoy
+edges have identical degree and position statistics. Attacks test row minima,
+row maxima, label-nearest choices, greedy unused-user assignment, and 256 random
+greedy restarts. Canonicalization sorts intrinsic step labels, user identifiers,
+and authorization sets; G8 tests step renumbering and every input-order symmetry.
+"""
+
+
+# Populated only after script-owned bare/hinted/placebo runs. No file I/O occurs.
+_G9_ARMS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+}
+_G9_HINTED_VERDICT = "pending"
+
+
+def _is_prime(value):
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(value):
+    candidate = max(3, value | 1)
+    while not _is_prime(candidate):
+        candidate += 2
+    return candidate
+
+
+def make_instance(n, seed=0, decoy_permutations=3, label_modulus=1000003, **params):
+    """Plant a perfect matching first, then add edge-disjoint decoy matchings."""
+    if not isinstance(n, int) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    if not isinstance(decoy_permutations, int) or decoy_permutations < 1:
+        raise ValueError("decoy_permutations must be a positive integer")
+    if not isinstance(label_modulus, int) or not _is_prime(label_modulus):
+        raise ValueError("label_modulus must be prime")
+    if n >= label_modulus:
+        raise ValueError("n must be smaller than label_modulus")
+    if decoy_permutations >= n:
+        raise ValueError("fewer than n decoy permutations are required")
+
+    rng = random.Random(seed)
+    q = label_modulus
+    forbidden = ({x % q for x in range(-16, 17)} if q > 100 else {0})
+    multiplier = rng.randrange(1, q)
+    while multiplier in forbidden:
+        multiplier = rng.randrange(1, q)
+
+    labels = []
+    seen_labels = set()
+    while len(labels) < n:
+        label = rng.randrange(q)
+        if label not in seen_labels:
+            seen_labels.add(label)
+            labels.append(label)
+
+    planted = [(multiplier * label) % q for label in labels]
+    users = list(planted)
+    rng.shuffle(users)
+    authorizations = [[planted[i]] for i in range(n)]
+
+    # Each accepted decoy is itself a perfect matching and shares no row-edge
+    # with an earlier one. Rejection samples decoys, never the certificate.
+    for _ in range(decoy_permutations):
+        while True:
+            proposal = list(users)
+            rng.shuffle(proposal)
+            if all(proposal[i] not in authorizations[i] for i in range(n)):
+                break
+        for i, user in enumerate(proposal):
+            authorizations[i].append(user)
+    for row in authorizations:
+        rng.shuffle(row)
+
+    return {
+        "n": n,
+        "label_modulus": q,
+        "audit_multiplier": multiplier,
+        "step_labels": labels,
+        "users": users,
+        "authorizations": authorizations,
+        "counting_constraint": [1, list(range(n))],
+        "answer": planted,
+    }
+
+
+def render(inst):
+    """Render the complete native WSP instance and exact answer format."""
+    n = inst["n"]
+    q = inst["label_modulus"]
+    lines = [
+        "WORKFLOW SATISFIABILITY: AUTHORIZATION MATCHING",
+        "",
+        f"There are {n} steps S0,...,S{n-1} and exactly {n} users.",
+        "A plan assigns one displayed user identifier to every step. There are no",
+        "precedence restrictions. A plan is authorized when each assigned user",
+        "appears in that step's authorization list.",
+        "",
+        "The workflow has the counting constraint (1,{S0,...,S(n-1)}). By",
+        "definition, every user who performs any listed steps must perform exactly",
+        "one of them. Since there are n steps and n users, a valid plan therefore",
+        "uses every displayed user exactly once; order matters by step, repeats are",
+        "forbidden, and no other constraint is imposed.",
+        "",
+        f"Auxiliary audit modulus: q={q}.",
+        f"Auxiliary audit multiplier: A={inst['audit_multiplier']}.",
+        "Step labels and authorized user identifiers:",
+    ]
+    for i, (label, row) in enumerate(zip(inst["step_labels"], inst["authorizations"])):
+        lines.append(
+            f"  S{i}: label={label}; authorized=" + ",".join(str(x) for x in row)
+        )
+    lines.extend([
+        "",
+        "Displayed user set (input order has no significance):",
+        "  " + ",".join(str(x) for x in inst["users"]),
+        "",
+        "Find any valid plan. Output exactly n integer user identifiers in fixed",
+        f"step order S0,S1,...,S{n-1}. Each must be from the displayed user set.",
+        "",
+        "Give your final answer inside <answer></answer> tags as comma-separated",
+        "integers. Example syntax: <answer>17, 4, 29</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer>", re.I | re.S)
+
+
+def parse_answer(text):
+    """Parse the final delimited comma-separated integer list; never raise."""
+    if not isinstance(text, str):
+        return None
+    blocks = _ANSWER_RE.findall(text)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    if not body:
+        return []
+    if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
+        return None
+    try:
+        return [int(token.strip()) for token in body.split(",")]
+    except (TypeError, ValueError):
+        return None
+
+
+def verify(inst, answer):
+    """Check authorization and (1,S) exactly; never consult inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a list of user identifiers"
+    n = inst["n"]
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) < n:
+        return False, f"too few plan entries: expected {n}, got {len(answer)}"
+    if len(answer) > n:
+        return False, f"too many plan entries: expected {n}, got {len(answer)}"
+    user_set = set(inst["users"])
+    for i, user in enumerate(answer):
+        if type(user) is not int or user not in user_set:
+            return False, f"entry {i} is not a displayed user identifier"
+    if len(set(answer)) != n:
+        return False, "counting constraint (1,S) is violated by a repeated user"
+    for step, user in enumerate(answer):
+        if user not in inst["authorizations"][step]:
+            return False, f"step S{step} is assigned an unauthorized user"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample permutations, enforcing the obvious all-different rule."""
+    candidate = list(inst["users"])
+    rng.shuffle(candidate)
+    return candidate
