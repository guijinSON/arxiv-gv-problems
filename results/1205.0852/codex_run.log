+
+def _is_prime(value):
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(value):
+    candidate = max(3, value | 1)
+    while not _is_prime(candidate):
+        candidate += 2
+    return candidate
+
+
+def make_instance(n, seed=0, constraint_count=None, user_modulus=1000003, **params):
+    """Inverse-generate a satisfiable modular-relation WSP instance."""
+    if not isinstance(n, int) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    if not isinstance(user_modulus, int) or not _is_prime(user_modulus):
+        raise ValueError("user_modulus must be prime")
+    if n >= user_modulus:
+        raise ValueError("n must be smaller than user_modulus")
+    if constraint_count is None:
+        constraint_count = 4 * n
+    max_pairs = n * (n - 1) // 2
+    if not isinstance(constraint_count, int) or not (n - 1 <= constraint_count <= max_pairs):
+        raise ValueError("constraint_count must be between n-1 and C(n,2)")
+
+    rng = random.Random(seed)
+    q = user_modulus
+    forbidden = {x % q for x in range(-16, 17)}
+    slope = rng.randrange(1, q)
+    while slope in forbidden:
+        slope = rng.randrange(1, q)
+
+    labels = [0]
+    seen = {0}
+    while len(labels) < n:
+        label = rng.randrange(1, q)
+        if label not in seen:
+            seen.add(label)
+            labels.append(label)
+    rng.shuffle(labels)
+    anchor_step = labels.index(0)
+    anchor_user = 0
+    planted = [(slope * label) % q for label in labels]
+
+    # A uniformly relabelled random tree certifies connectivity by construction.
+    order = list(range(n))
+    rng.shuffle(order)
+    pairs = set()
+    for i in range(1, n):
+        a = order[i]
+        b = order[rng.randrange(i)]
+        pairs.add((min(a, b), max(a, b)))
+    while len(pairs) < constraint_count:
+        a, b = rng.sample(range(n), 2)
+        pairs.add((min(a, b), max(a, b)))
+
+    relations = []
+    for lo, hi in pairs:
+        if rng.randrange(2):
+            a, b = hi, lo
+        else:
+            a, b = lo, hi
+        relations.append([a, b, (planted[b] - planted[a]) % q])
+    rng.shuffle(relations)
+
+    return {
+        "n": n,
+        "user_modulus": q,
+        "labels": labels,
+        "anchor_step": anchor_step,
+        "anchor_user": anchor_user,
+        "type1_difference_constraints": relations,
+        "answer": planted,
+    }
+
+
+def render(inst):
+    """Render a complete WSP statement and an exact output contract."""
+    n = inst["n"]
+    q = inst["user_modulus"]
+    lines = [
+        "WORKFLOW SATISFIABILITY WITH MODULAR USER RELATIONS",
+        "",
+        f"There are {n} workflow steps S0,...,S{n-1} and {q} users.",
+        f"Users are the integer residues 0,...,{q-1} modulo q={q}.",
+        "A plan assigns exactly one user to every step. There are no precedence",
+        "restrictions. Every user is authorized for every step except the anchor",
+        f"step S{inst['anchor_step']}, whose only authorized user is {inst['anchor_user']}.",
+        "",
+        "Each step also has a scalar label in Z_q. Labels are auxiliary instance",
+        "data and impose no additional validity condition by themselves:",
+    ]
+    for i, label in enumerate(inst["labels"]):
+        lines.append(f"  S{i}: label={label}")
+
+    lines.extend([
+        "",
+        "A displayed Type-1 entailment constraint DIFF(a,b,d) uses the binary",
+        "user relation rho_d={(u,v): (v-u) mod q = d}. Thus it is satisfied",
+        "exactly when (plan[b]-plan[a]) mod q equals d. All intervals above are",
+        "inclusive, and every modular result is its least residue in 0,...,q-1.",
+        "",
+        "Type-1 constraints:",
+    ])
+    for a, b, d in inst["type1_difference_constraints"]:
+        lines.append(f"  DIFF(S{a},S{b},{d})")
+
+    lines.extend([
+        "",
+        "Find any authorized plan satisfying every Type-1 constraint. Repeated",
+        "users are allowed. Output exactly n integers in step order S0,S1,...,",
+        f"S{n-1}; each must lie in the inclusive range 0,...,{q-1}.",
+        "",
+        "Give your final answer inside <answer></answer> tags as comma-separated",
+        "integer user identifiers. Example syntax: <answer>0, 17, 4</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer>", re.I | re.S)
+
+
+def parse_answer(text):
+    """Extract the last delimited comma-separated integer list; never raise."""
+    if not isinstance(text, str):
+        return None
+    blocks = _ANSWER_RE.findall(text)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    if not body:
+        return []
+    if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
+        return None
+    try:
+        return [int(token.strip()) for token in body.split(",")]
+    except (TypeError, ValueError):
+        return None
+
+
+def verify(inst, answer):
+    """Check only the supplied plan and the displayed workflow instance."""
+    if not isinstance(answer, list):
+        return False, "answer must be a list of user identifiers"
+    n = inst["n"]
+    q = inst["user_modulus"]
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) < n:
+        return False, f"too few plan entries: expected {n}, got {len(answer)}"
+    if len(answer) > n:
+        return False, f"too many plan entries: expected {n}, got {len(answer)}"
+    for i, user in enumerate(answer):
+        if type(user) is not int or not (0 <= user < q):
+            return False, f"entry {i} is outside the authorized user range 0..{q-1}"
+    anchor = inst["anchor_step"]
+    if answer[anchor] != inst["anchor_user"]:
+        return False, f"anchor step S{anchor} is assigned an unauthorized user"
+    for index, (a, b, offset) in enumerate(inst["type1_difference_constraints"]):
+        if (answer[b] - answer[a]) % q != offset:
+            return False, f"Type-1 difference constraint {index} is violated"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample after enforcing the explicit singleton anchor authorization."""
+    q = inst["user_modulus"]
+    plan = [rng.randrange(q) for _ in range(inst["n"])]
+    plan[inst["anchor_step"]] = inst["anchor_user"]
+    return plan
+
+
+def search_space(inst):
+    return inst["user_modulus"] ** (inst["n"] - 1)
+
+
+def enumerate_all(inst):
+    """Brute-force an exact count only for safely tiny candidate languages."""
+    space = search_space(inst)
+    if space > 1_000_000:
+        return None
+    n = inst["n"]
+    q = inst["user_modulus"]
+    anchor = inst["anchor_step"]
+    free = [i for i in range(n) if i != anchor]
+    count = 0
+    for code in range(space):
+        plan = [0] * n
+        plan[anchor] = inst["anchor_user"]
+        value = code
+        for step in free:
+            plan[step] = value % q
+            value //= q
+        if verify(inst, plan)[0]:
+            count += 1
+    return count
+
+
+def _canonical_relations(inst):
+    """Orient by labels and normalize affine user relabeling of all offsets."""
+    q = inst["user_modulus"]
+    labels = inst["labels"]
+    rows = []
+    for a, b, offset in inst["type1_difference_constraints"]:
+        la, lb = labels[a], labels[b]
+        if la < lb:
+            rows.append([la, lb, offset % q])
+        else:
+            rows.append([lb, la, (-offset) % q])
+    rows.sort()
+    factor = pow(rows[0][2], -1, q)
+    return [[a, b, (d * factor) % q] for a, b, d in rows]
+
+
+def canonical_key(inst):
+    """A structural key, never a seed or hash of rendered text."""
+    payload = {
+        "q": inst["user_modulus"],
+        "labels": sorted(inst["labels"]),
+        "anchor_label": inst["labels"][inst["anchor_step"]],
+        "relations": _canonical_relations(inst),
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params):
+    """Grow fixed-witness arithmetic and crowding axes before answer length."""
+    p = {key: value for key, value in params.items() if key != "_preset"}
+    n = int(p["n"])
+    q = int(p.get("user_modulus", 1000003))
+    constraints = int(p.get("constraint_count", 15 * n))
+    maximum = n * (n - 1) // 2
+    if q < 1_000_000_000_000:
+        p["user_modulus"] = _next_prime(10 * q + 1)
+        p["constraint_count"] = constraints
+        p["n"] = n
+        return p
+    if constraints < min(maximum, 25 * n):
+        p["constraint_count"] = min(maximum, constraints + 2 * n)
+        p["user_modulus"] = q
+        p["n"] = n
+        return p
+    return None
+
+
+def _propagate_reference(inst):
+    """Exact O(n+c) propagation; returns (plan or None, counters)."""
+    n = inst["n"]
+    q = inst["user_modulus"]
+    adjacency = [[] for _ in range(n)]
+    counters = {"relation_scans": 0, "assignments": 0, "queue_pops": 0}
+    for a, b, offset in inst["type1_difference_constraints"]:
+        adjacency[a].append((b, offset))
+        adjacency[b].append((a, (-offset) % q))
+    plan = [None] * n
+    anchor = inst["anchor_step"]
+    plan[anchor] = inst["anchor_user"]
+    counters["assignments"] = 1
+    queue = [anchor]
+    head = 0
+    while head < len(queue):
+        step = queue[head]
+        head += 1
+        counters["queue_pops"] += 1
+        for other, offset in adjacency[step]:
+            counters["relation_scans"] += 1
+            expected = (plan[step] + offset) % q
+            if plan[other] is None:
+                plan[other] = expected
+                counters["assignments"] += 1
+                queue.append(other)
+            elif plan[other] != expected:
+                return None, counters
+    if any(value is None for value in plan):
+        return None, counters
+    return plan, counters
+
+
+def _attack_identity(inst):
+    plan = [label % inst["user_modulus"] for label in inst["labels"]]
+    plan[inst["anchor_step"]] = inst["anchor_user"]
+    return plan
+
+
+def _attack_lowest_authorized(inst):
+    plan = [0] * inst["n"]
+    plan[inst["anchor_step"]] = inst["anchor_user"]
+    return plan
+
+
+def _attack_small_affine_slopes(inst):
+    q = inst["user_modulus"]
+    anchor = inst["anchor_step"]
+    last = None
+    for slope in list(range(1, 17)) + list(range(q - 16, q)):
+        last = [(slope * label) % q for label in inst["labels"]]
+        last[anchor] = inst["anchor_user"]
+        if verify(inst, last)[0]:
+            return last, True
+    return last, False
+
+
+def _attack_random_affine_restart(inst, rng, attempts):
+    q = inst["user_modulus"]
+    anchor = inst["anchor_step"]
+    last = None
+    for _ in range(attempts):
+        slope = rng.randrange(1, q)
+        last = [(slope * label) % q for label in inst["labels"]]
+        last[anchor] = inst["anchor_user"]
+        if verify(inst, last)[0]:
+            return last, True
+    return last, False
+
+
+def _attack_one_pass_propagation(inst, rng):
+    """Random-order local propagation without a queue, repair, or backtracking."""
+    n = inst["n"]
+    q = inst["user_modulus"]
+    incident = [[] for _ in range(n)]
+    for a, b, offset in inst["type1_difference_constraints"]:
+        incident[a].append((b, offset))
+        incident[b].append((a, (-offset) % q))
+    plan = [None] * n
+    plan[inst["anchor_step"]] = inst["anchor_user"]
+    order = [i for i in range(n) if i != inst["anchor_step"]]
+    rng.shuffle(order)
+    for step in order:
+        suggestions = [
+            (plan[other] - offset) % q
+            for other, offset in incident[step]
+            if plan[other] is not None
+        ]
+        plan[step] = suggestions[0] if suggestions else rng.randrange(q)
+    return plan
+
+
+def _permute_instance(inst, permutation, reverse_mask=None, constraint_order=None):
+    n = inst["n"]
+    if sorted(permutation) != list(range(n)):
+        raise ValueError("not a permutation")
+    labels = [None] * n
+    answer = [None] * n
+    for old, new in enumerate(permutation):
+        labels[new] = inst["labels"][old]
+        answer[new] = inst["answer"][old]
+    relations = []
+    for index, (a, b, offset) in enumerate(inst["type1_difference_constraints"]):
+        a, b = permutation[a], permutation[b]
+        if reverse_mask is not None and reverse_mask[index]:
+            a, b, offset = b, a, (-offset) % inst["user_modulus"]
+        relations.append([a, b, offset])
+    if constraint_order is not None:
+        relations = [relations[i] for i in constraint_order]
+    return {
+        "n": n,
+        "user_modulus": inst["user_modulus"],
+        "labels": labels,
+        "anchor_step": permutation[inst["anchor_step"]],
+        "anchor_user": inst["anchor_user"],
+        "type1_difference_constraints": relations,
+        "answer": answer,
+    }
+
+
+def _affine_user_relabel(inst, scale, translation):
+    q = inst["user_modulus"]
+    if not (1 <= scale < q):
+        raise ValueError("scale must be a nonzero residue")
+    return {
+        "n": inst["n"],
+        "user_modulus": q,
+        "labels": list(inst["labels"]),
+        "anchor_step": inst["anchor_step"],
+        "anchor_user": (scale * inst["anchor_user"] + translation) % q,
+        "type1_difference_constraints": [
+            [a, b, (scale * offset) % q]
+            for a, b, offset in inst["type1_difference_constraints"]
+        ],
+        "answer": [(scale * user + translation) % q for user in inst["answer"]],
+    }
+
