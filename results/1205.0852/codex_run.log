+def _propagate_reference(inst):
+    """Exact O(n+c) propagation; returns (plan or None, counters)."""
+    n = inst["n"]
+    q = inst["user_modulus"]
+    adjacency = [[] for _ in range(n)]
+    counters = {"relation_scans": 0, "assignments": 0, "queue_pops": 0}
