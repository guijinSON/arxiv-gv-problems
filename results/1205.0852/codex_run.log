+        ref_t0 = time.perf_counter()
+        ref_plan, counters = _propagate_reference(inst)
+        reference["wall_clock_sec"] += time.perf_counter() - ref_t0
+        reference["attempts"] += 1
+        reference["successes"] += int(
+            ref_plan is not None and verify(inst, ref_plan)[0]
+        )
+        for key in ("relation_scans", "assignments", "queue_pops"):
+            reference[key] += counters[key]
+    reference["wall_clock_sec"] = round(reference["wall_clock_sec"], 6)
+    reference["solves"] = f"{reference['successes']}/{reference['attempts']}, as expected"
+    all_failed = all(result["successes"] == 0 and result["attempts"] >= 8
+                     for result in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference["successes"] == reference["attempts"],
+        "attacks": attacks,
+        "reference_algorithm": reference,
+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled_params["constraint_count"] *= 2
+    scale_t0 = time.perf_counter()
+    doubled = make_instance(seed=424242, **doubled_params)
+    scale_wall = time.perf_counter() - scale_t0
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": bool(doubled_ok),
+        "base_n": DIFFICULTY[SHIPPING_DIFFICULTY]["n"],
+        "doubled_n": doubled_params["n"],
+        "build_wall_sec": round(scale_wall, 6),
+        "verify_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    carried_checks = 0
+    distinct_keys = []
+    g8_failures = []
+    for seed in range(20):
