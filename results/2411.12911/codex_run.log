+
+# The least irreducible binary polynomials found by a deterministic Rabin test;
+# bit i is the coefficient of z^i.  The leading z^d bit is retained.
+_MODULI = {
+    3: 0xB,
+    5: 0x25,
+    7: 0x83,
+    9: 0x203,
+    11: 0x805,
+    13: 0x201B,
+    15: 0x8003,
+    17: 0x20009,
+}
+
+
+def _parity(value: int) -> int:
+    return value.bit_count() & 1
+
+
+def _gf_mul(a: int, b: int, modulus: int, degree: int) -> int:
+    """Multiply polynomial-basis field elements exactly modulo ``modulus``."""
+    result = 0
+    mask = (1 << degree) - 1
+    for _ in range(degree):
+        if b & 1:
+            result ^= a
+        b >>= 1
+        a <<= 1
+        if a & (1 << degree):
+            a ^= modulus
+    return result & mask
+
+
+def _cube(x: int, modulus: int, degree: int) -> int:
+    return _gf_mul(_gf_mul(x, x, modulus, degree), x, modulus, degree)
+
+
+def _trace(x: int, modulus: int, degree: int) -> int:
+    total = 0
+    term = x
+    for _ in range(degree):
+        total ^= term
+        term = _gf_mul(term, term, modulus, degree)
+    if total not in (0, 1):
+        raise AssertionError("field trace did not land in GF(2)")
+    return total
+
+
+def _trace_mask(modulus: int, degree: int) -> int:
+    return sum(
+        (_trace(1 << coordinate, modulus, degree) & 1) << coordinate
+        for coordinate in range(degree)
+    )
+
+
+def _rank_and_protected(xs, points, target_rank):
+    """Return affine rank and x-labels of one protected affine basis."""
+    if not points:
+        return 0, ()
+    origin = points[0]
+    protected = [xs[0]]
+    basis = {}
+    for x, point in zip(xs[1:], points[1:]):
+        row = point ^ origin
+        while row:
+            pivot = row.bit_length() - 1
+            if pivot in basis:
+                row ^= basis[pivot]
+            else:
+                basis[pivot] = row
+                protected.append(x)
+                break
+        if len(basis) == target_rank:
+            break
+    return len(basis), tuple(protected)
+
+
+@functools.lru_cache(maxsize=None)
+def _base_data(degree: int):
+    modulus = _MODULI[degree]
+    tau = _trace_mask(modulus, degree)
+    base_normal = tau | (tau << degree)
+    sides = [[], []]
+    side_points = [[], []]
+    for x in range(1 << degree):
+        y = _cube(x, modulus, degree)
+        point = x | (y << degree)
+        side = _parity(base_normal & point)
+        sides[side].append(x)
+        side_points[side].append(point)
+    # Choose the larger Walsh level set.  The normal was fixed before this
+    # count, so this selects an affine side and does not search for a witness.
+    base_side = 0 if len(sides[0]) >= len(sides[1]) else 1
+    xs = tuple(sides[base_side])
+    points = tuple(side_points[base_side])
+    affine_rank, protected = _rank_and_protected(
+        xs, points, 2 * degree - 1
+    )
+    if affine_rank != 2 * degree - 1:
+        raise AssertionError("Gold trace slice did not span its hyperplane")
+    walsh = len(sides[0]) - len(sides[1])
+    if abs(walsh) != 1 << ((degree + 1) // 2):
+        raise AssertionError("unexpected Gold Walsh magnitude")
+    return {
+        "modulus": modulus,
+        "trace_mask": tau,
+        "base_normal": base_normal,
+        "base_side": base_side,
+        "xs": xs,
+        "points": points,
+        "protected": protected,
+        "affine_rank": affine_rank,
+        "walsh_magnitude": abs(walsh),
+    }
+
+
+def _swap_bits(value: int, first: int, second: int) -> int:
+    if ((value >> first) ^ (value >> second)) & 1:
+        value ^= (1 << first) | (1 << second)
+    return value
+
+
+def _apply_point_op(value: int, op) -> int:
+    kind, source, destination = op
+    if kind == "swap":
+        return _swap_bits(value, source, destination)
+    if kind == "xor":
+        if (value >> source) & 1:
+            value ^= 1 << destination
+        return value
+    raise ValueError("unknown coordinate operation")
+
+
+def _push_normal(value: int, op) -> int:
+    """Apply E^{-T} to a normal when the point operation is E."""
+    kind, source, destination = op
+    if kind == "swap":
+        return _swap_bits(value, source, destination)
+    if kind == "xor":
+        if (value >> destination) & 1:
+            value ^= 1 << source
+        return value
+    raise ValueError("unknown coordinate operation")
+
+
+def _pull_normal(value: int, op) -> int:
+    # Every elementary operation used here is an involution.  Pulling through a
+    # whole product differs from pushing only in the order of operations.
+    return _push_normal(value, op)
+
+
+def _compact_witness(inst):
+    """Public-data change-of-variables route; never reads inst['answer']."""
+    normal = inst["base_normal"]
+    for op in inst["operations"]:
+        normal = _push_normal(normal, op)
+    offset = inst["base_side"] ^ _parity(normal & inst["translation"])
+    return [normal, offset]
+
+
+def _validate_parameters(n, degree, removal_span):
+    if isinstance(n, bool) or not isinstance(n, int) or not 1 <= n <= 2000:
+        raise ValueError("n must be an integer from 1 through 2000")
+    if isinstance(degree, bool) or degree not in _MODULI:
+        raise ValueError("degree must be one of " + repr(sorted(_MODULI)))
+    if degree % 2 == 0:
+        raise ValueError("degree must be odd so x^3 is APN")
+    if (
+        isinstance(removal_span, bool)
+        or not isinstance(removal_span, int)
+        or removal_span < 1
+    ):
+        raise ValueError("removal_span must be a positive integer")
+
+
+def make_instance(n, seed=0, degree=None, removal_span=None, **params):
+    """Construct a Sidon slice and carry its known hyperplane certificate.
+
+    The base equation is selected before the random coordinate map.  A protected
+    affine basis is never removed, so the final set has affine codimension one
+    and the certificate language contains exactly one valid witness.
+    """
+    if params or degree is None or removal_span is None:
+        raise ValueError("n, degree, and removal_span are the only parameters")
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+    _validate_parameters(n, degree, removal_span)
+    data = _base_data(degree)
+    rng = random.Random(seed)
+    ambient_bits = 2 * degree
+
+    protected = set(data["protected"])
+    removable = [x for x in data["xs"] if x not in protected]
+    removal_count = seed % removal_span
+    if removal_count > len(removable):
+        raise ValueError("removal_span is too large for this degree")
+    excluded_x = sorted(rng.sample(removable, removal_count))
+
+    operations = []
+    for _ in range(n):
+        source = rng.randrange(ambient_bits)
+        destination = rng.randrange(ambient_bits - 1)
+        if destination >= source:
+            destination += 1
+        kind = "swap" if rng.randrange(5) == 0 else "xor"
+        operations.append([kind, source, destination])
+    translation = rng.randrange(1 << ambient_bits)
+
+    inst = {
+        "n": n,
+        "degree": degree,
+        "ambient_bits": ambient_bits,
+        "modulus": data["modulus"],
+        "trace_mask": data["trace_mask"],
+        "base_normal": data["base_normal"],
+        "base_side": data["base_side"],
+        "walsh_magnitude": data["walsh_magnitude"],
+        "operations": operations,
+        "translation": translation,
+        "excluded_x": excluded_x,
+        "point_count": len(data["xs"]) - removal_count,
+        "affine_dimension": ambient_bits - 1,
+    }
+    # This is certificate transport, not solution of the newly built set.
+    inst["answer"] = _compact_witness(inst)
+    return inst
+
+
+def render(inst):
+    """Render the complete native finite-field/Sidon-set problem."""
+    degree = inst["degree"]
+    t = inst["ambient_bits"]
+    modulus_terms = [str(i) for i in range(degree + 1)
+                     if (inst["modulus"] >> i) & 1]
+    excluded = json.dumps(inst["excluded_x"], separators=(",", ":"))
+    lines = [
+        "AFFINE HYPERPLANE OF AN APN-GRAPH SIDON SET",
+        "",
+        f"Work in the binary vector space F_2^{t}. A vector is encoded by an integer",
+        f"0 <= v < 2^{t}; bit i is coordinate i (coordinates are 0-indexed).",
+        "Vector addition is bitwise XOR. The binary dot product of h and v is",
+        "parity(h & v), i.e. the number of common 1-bits modulo 2.",
+        "",
+        "A Sidon set is a set with no four distinct elements whose XOR is zero.",
+        "The set below is given in the paper's native APN-graph form.",
+        "",
+        f"Represent GF(2^{degree}) in the polynomial basis modulo the irreducible",
+        f"binary polynomial with exponent set {modulus_terms}; its integer mask is",
+        f"{inst['modulus']}. Thus field addition is XOR and multiplication is",
+        "carryless polynomial multiplication followed by reduction modulo that polynomial.",
+        f"For each integer 0 <= x < 2^{degree}, let z=x^3 in this field and encode",
+        f"the graph point (x,z) as v = x + 2^{degree}*z in F_2^{t}.",
+        "",
+        f"The polynomial-basis trace functional has bit mask tau={inst['trace_mask']}.",
+        f"Let h0=tau + 2^{degree}*tau = {inst['base_normal']}. Keep exactly those",
+        f"graph points with parity(h0 & v)={inst['base_side']}, except for x-values",
+        f"in this explicit exclusion list (order has no meaning): {excluded}",
+        f"This leaves {inst['point_count']} points and still affinely spans a",
+        f"{inst['affine_dimension']}-dimensional hyperplane. It is Sidon because x -> x^3",
+        "is APN in odd degree and every subset of a Sidon set is Sidon.",
+        "",
+        "Now apply the following coordinate operations to every retained point v,",
+        "in the displayed order. 'xor s d' replaces coordinate d by d XOR s;",
+        "'swap i j' swaps coordinates i and j. All other coordinates stay fixed.",
+    ]
+    for index, (kind, source, destination) in enumerate(inst["operations"], 1):
+        lines.append(f"{index}: {kind} {source} {destination}")
+    lines.extend([
+        f"Finally XOR every resulting vector with translation {inst['translation']}.",
+        "Call the resulting displayed Sidon set M.",
+        "",
+        "Find an affine hyperplane containing every point of M. Your answer must be",
+        f"the JSON list [h,c], where 1 <= h < 2^{t} and c is exactly 0 or 1,",
+        "such that parity(h & y)=c for every y in M. The order [normal,offset]",
+        "is mandatory; no repeated or extra entries are allowed.",
+        "",
+        "Give your final answer inside <answer></answer> tags, as [h,c] in JSON.",
+        "Example: <answer>[37,1]</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+_ANSWER_RE = re.compile(r"<answer\s*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def parse_answer(text):
+    """Extract one strict [normal,offset] JSON list from surrounding prose."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    try:
+        value = json.loads(matches[-1].strip())
+    except (ValueError, TypeError):
+        return None
+    if not isinstance(value, list) or len(value) != 2:
+        return None
+    if any(isinstance(item, bool) or not isinstance(item, int) for item in value):
+        return None
+    return value
+
+
+def _decoded_instance(inst):
+    if not isinstance(inst, dict):
+        return None
+    try:
+        n = inst["n"]
+        degree = inst["degree"]
+        removal_span = max(1, len(inst["excluded_x"]) + 1)
+        _validate_parameters(n, degree, removal_span)
+        t = 2 * degree
+        data = _base_data(degree)
+        if (
+            inst["ambient_bits"] != t
+            or inst["modulus"] != data["modulus"]
+            or inst["trace_mask"] != data["trace_mask"]
+            or inst["base_normal"] != data["base_normal"]
+            or inst["base_side"] != data["base_side"]
+            or inst["walsh_magnitude"] != data["walsh_magnitude"]
+            or inst["affine_dimension"] != t - 1
+        ):
+            return None
+        operations = inst["operations"]
+        if not isinstance(operations, list) or len(operations) != n:
+            return None
+        for op in operations:
+            if (
+                not isinstance(op, list)
+                or len(op) != 3
+                or op[0] not in ("xor", "swap")
+                or any(isinstance(v, bool) or not isinstance(v, int) for v in op[1:])
+                or not 0 <= op[1] < t
+                or not 0 <= op[2] < t
+                or op[1] == op[2]
+            ):
+                return None
+        translation = inst["translation"]
+        if (
+            isinstance(translation, bool)
+            or not isinstance(translation, int)
+            or not 0 <= translation < (1 << t)
+        ):
+            return None
+        excluded = inst["excluded_x"]
+        if (
+            not isinstance(excluded, list)
+            or excluded != sorted(set(excluded))
+            or any(isinstance(x, bool) or not isinstance(x, int) for x in excluded)
+            or any(x not in set(data["xs"]) for x in excluded)
+            or any(x in set(data["protected"]) for x in excluded)
+            or inst["point_count"] != len(data["xs"]) - len(excluded)
+        ):
+            return None
+    except (KeyError, TypeError, ValueError):
+        return None
+    return data, set(excluded)
+
+
+def verify(inst, answer):
+    """Check any proposed affine hyperplane by an exact exhaustive scan."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if len(answer) == 0:
+        return False, "answer list is empty"
+    if len(answer) == 1:
+        return False, "answer omits the offset bit"
+    if len(answer) != 2:
+        return False, f"answer has {len(answer)} elements; exactly 2 required"
+    normal, offset = answer
+    if isinstance(normal, bool) or not isinstance(normal, int):
+        return False, "normal must be an integer"
+    if normal == 0:
+        return False, "normal must be nonzero"
+    if normal < 0 or normal >= (1 << inst.get("ambient_bits", 0)):
+        return False, "normal is outside the ambient t-bit range"
+    if isinstance(offset, bool) or not isinstance(offset, int) or offset not in (0, 1):
+        return False, "offset must be exactly the bit 0 or 1"
+    decoded = _decoded_instance(inst)
+    if decoded is None:
+        return False, "instance is malformed"
+    data, excluded = decoded
+
+    # Execute the affine pullback exactly, then inspect every native graph point.
+    pulled = normal
+    for op in reversed(inst["operations"]):
+        pulled = _pull_normal(pulled, op)
+    required_base_side = offset ^ _parity(normal & inst["translation"])
+    modulus = inst["modulus"]
+    degree = inst["degree"]
+    for x in data["xs"]:
+        if x in excluded:
+            continue
+        z = _cube(x, modulus, degree)
+        point = x | (z << degree)
+        if _parity(pulled & point) != required_base_side:
+            return False, f"hyperplane misses displayed point generated by x={x}"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the statement-aware language: nonzero h and one bit c."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    return [rng.randrange(1, 1 << inst["ambient_bits"]), rng.randrange(2)]
+
+
+def search_space(inst):
+    """Exact size of the bounded, structure-aware certificate language."""
+    return 2 * ((1 << inst["ambient_bits"]) - 1)
+
+
+def enumerate_all(inst):
+    """Brute-force valid answers only when the language has at most 10,000 entries."""
+    total = search_space(inst)
+    if total > 10_000:
+        return None
+    valid = 0
+    for normal in range(1, 1 << inst["ambient_bits"]):
+        for offset in (0, 1):
+            valid += int(verify(inst, [normal, offset])[0])
+    return valid
+
+
+def _display_point(inst, point):
+    for op in inst["operations"]:
+        point = _apply_point_op(point, op)
+    return point ^ inst["translation"]
+
+
+def _triple_collision_signature(points):
+    if len(points) < 3:
+        return []
+    counts = Counter(a ^ b ^ c for a, b, c in itertools.combinations(points, 3))
+    multiplicities = Counter(counts.values())
+    return sorted([multiplicity, frequency]
+                  for multiplicity, frequency in multiplicities.items())
+
+
+def canonical_key(inst):
+    """Affine-invariant size and omitted-point triple-collision signature.
+
+    This is intentionally not a seed/render hash.  Equality of triple sums is
+    preserved by every invertible affine coordinate map, as are all dimensions
+    and cardinalities included below.
+    """
+    decoded = _decoded_instance(inst)
+    if decoded is None:
+        return "malformed"
+    excluded_points = []
+    for x in inst["excluded_x"]:
+        z = _cube(x, inst["modulus"], inst["degree"])
+        excluded_points.append(_display_point(inst, x | (z << inst["degree"])))
+    signature = [
+        inst["ambient_bits"],
+        inst["point_count"],
+        inst["affine_dimension"],
+        len(excluded_points),
+        _triple_collision_signature(excluded_points),
+    ]
+    encoded = json.dumps(signature, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def escalate(params):
+    """Use the one remaining under-cap route length, then stop."""
+    try:
+        n = params["n"]
+        degree = params["degree"]
+        removal_span = params["removal_span"]
+    except (KeyError, TypeError):
+        return None
+    if n < 280:
+        return {
+            "n": 280,
+            "degree": 17 if degree < 17 else degree,
+            "removal_span": max(removal_span, 64),
+        }
+    return None
+
+
+def _apply_vector_rule(value, op):
+    """Tempting wrong normal propagation: treat a covector as a point vector."""
+    return _apply_point_op(value, op)
+
+
+def _attack_candidates(inst, seed):
+    t = inst["ambient_bits"]
+    touches = [0] * t
+    for _kind, source, destination in inst["operations"]:
+        touches[source] += 1
+        touches[destination] += 1
+    outlier_coordinate = min(range(t), key=lambda i: (touches[i], i))
+    outlier_normal = 1 << outlier_coordinate
+
+    forward = inst["base_normal"]
+    for op in inst["operations"]:
+        forward = _apply_vector_rule(forward, op)
+
+    reversed_transpose = inst["base_normal"]
+    for op in reversed(inst["operations"]):
+        reversed_transpose = _push_normal(reversed_transpose, op)
+
+    unchanged = inst["base_normal"]
+    attacks = {
+        "outlier_least_touched_coordinate": [
+            outlier_normal,
+            inst["base_side"] ^ _parity(outlier_normal & inst["translation"]),
+        ],
+        "greedy_treat_covector_as_vector": [
+            forward,
+            inst["base_side"] ^ _parity(forward & inst["translation"]),
+        ],
+        "by_hand_reverse_order_transpose": [
+            reversed_transpose,
+            inst["base_side"] ^ _parity(
+                reversed_transpose & inst["translation"]
+            ),
+        ],
+        "obvious_unchanged_base_normal": [
+            unchanged,
+            inst["base_side"] ^ _parity(unchanged & inst["translation"]),
+        ],
+    }
+    rng = random.Random(seed ^ 0x241112911)
+    attacks["random_restart_256_hyperplanes"] = [
+        random_candidate(inst, rng) for _ in range(256)
+    ]
+    return attacks
+
+
+def _reference_gaussian(inst):
+    """Recover the affine hull from displayed points by binary elimination."""
+    degree = inst["degree"]
+    t = inst["ambient_bits"]
+    modulus = inst["modulus"]
+    excluded = set(inst["excluded_x"])
+    basis = {}
+    origin = None
+    point_count = 0
+    field_bit_rounds = 0
+    transform_coordinate_ops = 0
+    elimination_bit_operations = 0
+
+    for x in range(1 << degree):
+        z = _cube(x, modulus, degree)
+        field_bit_rounds += 2 * degree
+        base_point = x | (z << degree)
+        if _parity(inst["base_normal"] & base_point) != inst["base_side"]:
+            continue
+        if x in excluded:
+            continue
+        shown = base_point
+        for op in inst["operations"]:
+            shown = _apply_point_op(shown, op)
+            transform_coordinate_ops += 1
+        shown ^= inst["translation"]
+        point_count += 1
+        if origin is None:
+            origin = shown
+            continue
+        row = shown ^ origin
+        while row:
+            pivot = row.bit_length() - 1
+            if pivot in basis:
+                row ^= basis[pivot]
+                elimination_bit_operations += t
+            else:
+                basis[pivot] = row
+                break
+
+    if origin is None or point_count != inst["point_count"] or len(basis) != t - 1:
+        return None, {
+            "field_bit_rounds": field_bit_rounds,
+            "transform_coordinate_operations": transform_coordinate_ops,
+            "elimination_bit_operations": elimination_bit_operations,
+            "total_operations": (
+                field_bit_rounds + transform_coordinate_ops
+                + elimination_bit_operations
+            ),
+        }
+    free = [coordinate for coordinate in range(t) if coordinate not in basis]
+    if len(free) != 1:
+        return None, {"total_operations": 0}
+    normal = 1 << free[0]
+    for pivot in sorted(basis):
+        lower = basis[pivot] ^ (1 << pivot)
+        if _parity(lower & normal):
+            normal |= 1 << pivot
+        elimination_bit_operations += t
+    offset = _parity(normal & origin)
+    counts = {
+        "field_bit_rounds": field_bit_rounds,
+        "transform_coordinate_operations": transform_coordinate_ops,
+        "elimination_bit_operations": elimination_bit_operations,
+    }
+    counts["total_operations"] = sum(counts.values())
+    return [normal, offset], counts
+
+
+def _append_output_relabel(inst, extra_operations, extra_translation=0,
+                           reverse_exclusions=False):
+    """Carry the whole native set through another affine coordinate relabelling."""
+    out = dict(inst)
+    out["operations"] = [list(op) for op in inst["operations"]]
+    translated = inst["translation"]
+    for op in extra_operations:
+        out["operations"].append(list(op))
+        translated = _apply_point_op(translated, op)
+    out["n"] = len(out["operations"])
+    out["translation"] = translated ^ extra_translation
+    out["excluded_x"] = list(inst["excluded_x"])
+    if reverse_exclusions:
+        out["excluded_x"].reverse()
+        # Input order has no meaning.  Restore the module's normal form after
+        # exercising the permutation explicitly so validation stays strict.
+        out["excluded_x"].sort()
+    out["answer"] = _compact_witness(out)
+    return out
+
+
+def _sidon_pair_sums_unique(inst):
+    """Direct small-instance check of Definition 1.1."""
+    decoded = _decoded_instance(inst)
+    if decoded is None:
+        return False
+    data, excluded = decoded
+    points = []
+    for x, point in zip(data["xs"], data["points"]):
+        if x not in excluded:
+            points.append(_display_point(inst, point))
+    seen = set()
+    for first, second in itertools.combinations(points, 2):
+        value = first ^ second
+        if value in seen:
+            return False
+        seen.add(value)
+    return True
+
+
+def _intended_route_operations(inst):
+    return len(inst["operations"]) + 1
+
+
+def selftest():
+    report = {}
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+
+    failures = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                failures.append([preset, seed, why])
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append([preset, seed, "answer is not JSON-native"])
+    demo_sidon = _sidon_pair_sums_unique(
+        make_instance(seed=0, **DIFFICULTY["demo"])
+    )
+    report["G1_planted_verifies"] = {
+        "pass": not failures and demo_sidon,
+        "attempts": attempts,
+        "failures": failures,
+        "demo_pair_sum_scan_confirms_sidon": demo_sidon,
+    }
+
+    inst = make_instance(seed=19, **shipping)
+    answer = inst["answer"]
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": list(reversed(answer)),
+        "duplicate": answer[:1] + answer,
+        "empty": [],
+        "out_of_range": [1 << inst["ambient_bits"], answer[1]],
+    }
+    rejected = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        rejected[name] = {"rejected": not ok, "reason": why}
+    reasons = [entry["reason"] for entry in rejected.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": (
+            all(entry["rejected"] for entry in rejected.values())
+            and len(set(reasons)) == len(reasons)
+        ),
+        "cases": rejected,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    model_response = (
+        "The contragredient update gives this equation.\n```json\n<answer>"
+        + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```\nIt is nonzero and uses the required order."
+    )
+    parsed = parse_answer(model_response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_equals_answer": parsed == answer,
+    }
+
