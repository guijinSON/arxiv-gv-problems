+        reference_operations.append(counts["total_operations"])
+        reference_breakdowns.append(counts)
+        reference_successes += int(
+            recovered is not None and verify(trial, recovered)[0]
+        )
+
+        compact = _compact_witness(trial)
+        compact_operations.append(_intended_route_operations(trial))
+        compact_successes += int(verify(trial, compact)[0])
+
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_seconds[name] / 8, 6),
+        }
+        for name in attack_names
+    }
+    reference = {
+        "name": "binary Gaussian elimination on all affine point differences",
+        "complexity": "O(|M| d^2) exact GF(2) bit operations",
+        "wall_clock_sec": round(reference_seconds / 8, 6),
