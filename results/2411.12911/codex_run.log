+    if len(answer) != 2:
+        return False, f"answer has {len(answer)} elements; exactly 2 required"
+    normal, offset = answer
+    if isinstance(normal, bool) or not isinstance(normal, int):
+        return False, "normal must be an integer"
+    if normal == 0:
+        return False, "normal must be nonzero"
+    if normal < 0 or normal >= (1 << inst.get("ambient_bits", 0)):
+        return False, "normal is outside the ambient t-bit range"
+    if isinstance(offset, bool) or not isinstance(offset, int) or offset not in (0, 1):
+        return False, "offset must be exactly the bit 0 or 1"
