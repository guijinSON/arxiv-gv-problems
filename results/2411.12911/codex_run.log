+        if swap[0][1] == swap[0][2]:
+            swap[0][2] = (swap[0][2] + 1) % t
+        shear = [["xor", (seed * 5 + 1) % t, (seed * 11 + 2) % t]]
+        if shear[0][1] == shear[0][2]:
+            shear[0][2] = (shear[0][2] + 1) % t
+        variants = [
+            _append_output_relabel(original, swap),
+            _append_output_relabel(original, shear, 1 << ((seed + 4) % t)),
+            _append_output_relabel(
+                _append_output_relabel(original, swap),
+                shear,
+                (1 << ((seed + 9) % t)) ^ (1 << ((seed + 13) % t)),
+                reverse_exclusions=True,
