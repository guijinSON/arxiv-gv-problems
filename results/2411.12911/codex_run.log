+"""Verified affine-hyperplane witnesses for large binary Sidon sets.
+
+This module turns the hyperplane-intersection construction of Czerwinski and
+Pott, arXiv:2411.12911, into exact Track-B instances.  The native object is an
+affinely scrambled subset of the graph of the Gold APN function x -> x^3 over
+GF(2^d).  The witness is sampled first as the known trace-hyperplane normal and
+is carried through the affine map; it is never recovered by solving the set.
+
+Only the Python standard library is required.  ``gvlib`` is imported when
+available to comply with the repository-local convention, but binary field
+arithmetic here is simpler and remains standard-library-only.
+"""
+
+from __future__ import annotations
+
+import functools
+import hashlib
+import itertools
+import json
+import os
+import random
+import re
+import sys
+import time
+from collections import Counter
+
