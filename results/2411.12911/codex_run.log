+    os.path.abspath(__file__)))))
+try:
+    from gvlib import exact_matrices, rationals
+except ImportError:  # pragma: no cover - the standard-library path is complete
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "graph of an APN function over GF(2^d)",
+        "binary Sidon set in an affine hyperplane",
+        "affine hyperplane over GF(2)",
+    ],
+    "verification_operations": [
+        "exact polynomial-basis arithmetic in GF(2^d)",
+        "exact affine pullback over GF(2)",
+        "exhaustive parity and membership comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "The set is a scrambled APN-graph hyperplane slice, so transport its "
+        "displayed trace normal contragrediently through the affine coordinate "
+        "changes instead of row-reducing all of its points."
+    ),
+    "hardness_basis": (
+        "Track B: affine-hull recovery by binary Gaussian elimination costs "
+        "O(|M|d^2); at the hard shipping preset the measured reference cost is "
