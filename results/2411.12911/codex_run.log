+def verify(inst, answer):
+    """Check any proposed affine hyperplane by an exact exhaustive scan."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if len(answer) == 0:
+        return False, "answer list is empty"
+    if len(answer) == 1:
+        return False, "answer omits the offset bit"
+    if len(answer) != 2:
+        return False, f"answer has {len(answer)} elements; exactly 2 required"
+    normal, offset = answer
+    if isinstance(normal, bool) or not isinstance(normal, int):
+        return False, "normal must be an integer"
+    if normal == 0:
+        return False, "normal must be nonzero"
+    if normal < 0 or normal >= (1 << inst.get("ambient_bits", 0)):
+        return False, "normal is outside the ambient t-bit range"
+    if isinstance(offset, bool) or not isinstance(offset, int) or offset not in (0, 1):
+        return False, "offset must be exactly the bit 0 or 1"
+    decoded = _decoded_instance(inst)
+    if decoded is None:
+        return False, "instance is malformed"
+    data, excluded = decoded
+
+    # Execute the affine pullback exactly, then inspect every native graph point.
+    pulled = normal
+    for op in reversed(inst["operations"]):
+        pulled = _pull_normal(pulled, op)
+    required_base_side = offset ^ _parity(normal & inst["translation"])
+    modulus = inst["modulus"]
+    degree = inst["degree"]
+    for x in data["xs"]:
+        if x in excluded:
+            continue
+        z = _cube(x, modulus, degree)
+        point = x | (z << degree)
+        if _parity(pulled & point) != required_base_side:
+            return False, f"hyperplane misses displayed point generated by x={x}"
+    return True, "ok"
