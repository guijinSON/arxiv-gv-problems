+}
+
+DIFFICULTY = {
+    "demo": {"n": 7, "k": 4},
+    "easy": {"n": 1009, "k": 64},
+    "medium": {"n": 10007, "k": 64},
+    "hard": {"n": 100003, "k": 64},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A length-k coefficient vector over F_p in the displayed blockwise "
+        "coefficient basis: exactly k JSON integers, each in 0,...,p-1."
