   512	def _attack_outlier_frequency(inst):
   513	    rows = _row_map(inst)
   514	    frequency = [0] * inst["n"]
   515	    for slots in rows.values():
   516	        for slot in slots:
   517	            frequency[slot] += 1
   518	    return [min(rows[edge], key=lambda s: (frequency[s], s)) for edge in range(inst["n"])]
   519	
   520	
   521	def _attack_greedy_first_fit(inst, rng=None):
   522	    order = [row["edge"] for row in inst["rows"]]
   523	    if rng is not None:
   524	        rng.shuffle(order)
   525	    rows = _row_map(inst)
   526	    used = set()
   527	    answer = [None] * inst["n"]
   528	    for edge in order:
   529	        available = [slot for slot in rows[edge] if slot not in used]
   530	        if not available:
   531	            return None
   532	        slot = rng.choice(available) if rng is not None else available[0]
   533	        answer[edge] = slot
   534	        used.add(slot)
   535	    return answer
