   548	def _relabeled(inst, permutation, reorder_rows=False, seed=0):
   549	    """Relabel leaves and carry the slot-list witness through the map."""
   550	
   551	    result = {
   552	        key: value
   553	        for key, value in inst.items()
   554	        if key not in {"rows", "answer"}
   555	    }
   556	    rows = [
   557	        {"edge": permutation[row["edge"]], "slots": list(row["slots"])}
   558	        for row in inst["rows"]
   559	    ]
   560	    if reorder_rows:
   561	        random.Random(seed).shuffle(rows)
   562	    result["rows"] = rows
   563	    answer = [None] * inst["n"]
   564	    for old_edge, slot in enumerate(inst["answer"]):
   565	        answer[permutation[old_edge]] = slot
   566	    result["answer"] = answer
   567	    return result
   568	
   569	
   570	def _answer_atoms(value):
   571	    if isinstance(value, dict):
   572	        return sum(_answer_atoms(item) for item in value.values())
   573	    if isinstance(value, (list, tuple)):
   574	        return sum(_answer_atoms(item) for item in value)
   575	    return 1
