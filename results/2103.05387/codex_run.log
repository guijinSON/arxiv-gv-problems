_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)


def _is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def _is_prime(value):
    if not _is_int(value) or value < 2:
        return False
    if value % 2 == 0:
        return value == 2
    limit = math.isqrt(value)
    divisor = 3
    while divisor <= limit:
        if value % divisor == 0:
            return False
        divisor += 2
    return True


def _next_prime(value):
    candidate = max(2, int(value))
    if candidate > 2 and candidate % 2 == 0:
        candidate += 1
    while not _is_prime(candidate):
        candidate += 1 if candidate == 2 else 2
    return candidate


def _row_map(inst):
    return {row["edge"]: row["slots"] for row in inst["rows"]}


def make_instance(n, seed=0, degree=7, **params) -> dict:
    """Compose affine slot permutations and carry one as an exploration.

    ``n`` is the prime number of leaves and visit slots.  ``degree`` is the
    number of equally distributed affine offsets, hence the number of allowed
    slots per edge.  No matching or search routine is called here.
    """

    if params:
        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
    if not _is_prime(n) or n < 5:
        raise ValueError("n must be a prime integer at least 5")
    if not _is_int(degree) or not 2 <= degree < n:
        raise ValueError("degree must be an integer in 2..n-1")
    if math.gcd(degree, n) != 1:
        raise ValueError("degree must be invertible modulo n")
    if not _is_int(seed):
        raise ValueError("seed must be an integer")

    rng = random.Random(seed)
    multiplier = rng.randrange(2, n)  # never the slope-one ansatz
    translation = rng.randrange(n)
    offsets = rng.sample(range(n), degree)
    chosen_offset = rng.choice(offsets)

    rows = []
    for edge in range(n):
        slots = sorted(
            (multiplier * edge + translation + offset) % n
            for offset in offsets
        )
        rows.append({"edge": edge, "slots": slots})
    rng.shuffle(rows)

    answer = [
        (multiplier * edge + translation + chosen_offset) % n
        for edge in range(n)
    ]
    return {
        "family": "strict temporal-star slot exploration",
        "n": n,
        "degree": degree,
        "rows": rows,
        "rows": rows,
        "time_rule": "slot s is the visit (2*s+1, 2*s+2)",
        "answer": answer,
    }


