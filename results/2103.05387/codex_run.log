import random,time,math

def gen(n,k,seed):
 r=random.Random(seed); planted=set(r.sample(range(n),k)); adj=[0]*n
 for i in range(n):
  for j in range(i+1,n):
   if (i in planted and j in planted) or r.getrandbits(1):
    adj[i]|=1<<j; adj[j]|=1<<i
 return adj,planted

def solve(adj,k,cap=1000000):
 n=len(adj); nodes=0
 # order vertices degree ascending in bit iteration not material
 def color_sort(P):
  order=[]; bounds=[]; color=0
  Q=P
  while Q:
   color+=1; R=Q
   while R:
    b=R & -R; v=b.bit_length()-1
    order.append(v); bounds.append(color)
    Q &= ~b
    R &= ~b
    R &= ~adj[v]
  return order,bounds
 def expand(size,P,chosen):
  nonlocal nodes
  nodes+=1
  if nodes>=cap: return None
  if size>=k: return chosen
  if size+P.bit_count()<k: return False
  order,bounds=color_sort(P)
  for idx in range(len(order)-1,-1,-1):
   if size+bounds[idx]<k: return False
   v=order[idx]; b=1<<v
   if not P&b: continue
   res=expand(size+1,P&adj[v],chosen+[v])
   if res is None or res is not False: return res
   P &= ~b
  return False
 t=time.perf_counter(); res=expand(0,(1<<n)-1,[]); return res,nodes,time.perf_counter()-t
