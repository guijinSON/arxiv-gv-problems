+        if tagged:
+            payload = tagged[-1].strip()
+            payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
+            payload = re.sub(r"\s*```$", "", payload)
+        else:
+            fenced = re.findall(r"```(?:json)?\s*(\[[\s\S]*?\])\s*```", text, re.I)
