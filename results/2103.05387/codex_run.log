            rv, rb = right
            if lv == rv:
                continue
            add_arc(node(lv, lb), node(rv, 1 - rb))
            add_arc(node(rv, rb), node(lv, 1 - lb))

    seen = [False] * size
    order = []
    scans = 0

    def dfs1(start):
        nonlocal scans
        stack = [(start, 0)]
        seen[start] = True
        while stack:
