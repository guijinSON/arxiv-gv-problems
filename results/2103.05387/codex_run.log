        \node[state] (r2)  [right = of r1] {$y$};
        \draw[-] (c) -- node[left =0.15 cm] {$1,9$} (tll);
        \draw[-] (c) -- node[left =0.15 cm] {$3,5$} (trr);
        %---- 
