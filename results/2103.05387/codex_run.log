   164	def _next_prime(value):
   165	    candidate = max(2, int(value))
   166	    if candidate > 2 and candidate % 2 == 0:
   167	        candidate += 1
   168	    while not _is_prime(candidate):
   169	        candidate += 1 if candidate == 2 else 2
   170	    return candidate
