   177	def make_instance(n, seed=0, degree=7, **params) -> dict:
   178	    """Compose affine slot permutations and carry one as an exploration.
   179	
   180	    ``n`` is the prime number of leaves and visit slots.  ``degree`` is the
   181	    number of equally distributed affine offsets, hence the number of allowed
   182	    slots per edge.  No matching or search routine is called here.
   183	    """
   184	
   185	    if params:
   186	        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
   187	    if not _is_prime(n) or n < 5:
   188	        raise ValueError("n must be a prime integer at least 5")
   189	    if not _is_int(degree) or not 2 <= degree < n:
   190	        raise ValueError("degree must be an integer in 2..n-1")
   191	    if math.gcd(degree, n) != 1:
   192	        raise ValueError("degree must be invertible modulo n")
   193	    if not _is_int(seed):
   194	        raise ValueError("seed must be an integer")
   195	
   196	    rng = random.Random(seed)
   197	    multiplier = rng.randrange(2, n)  # never the slope-one ansatz
   198	    translation = rng.randrange(n)
   199	    offsets = rng.sample(range(n), degree)
   200	    chosen_offset = rng.choice(offsets)
   201	
   202	    rows = []
   203	    for edge in range(n):
   204	        slots = sorted(
   205	            (multiplier * edge + translation + offset) % n
   206	            for offset in offsets
   207	        )
   208	        rows.append({"edge": edge, "slots": slots})
   209	    rng.shuffle(rows)
   210	
   211	    answer = [
   212	        (multiplier * edge + translation + chosen_offset) % n
   213	        for edge in range(n)
   214	    ]
   215	    return {
   216	        "family": "strict temporal-star slot exploration",
   217	        "n": n,
   218	        "degree": degree,
   219	        "rows": rows,
   220	        "time_rule": "slot s is the visit (2*s+1, 2*s+2)",
   221	        "answer": answer,
   222	    }
