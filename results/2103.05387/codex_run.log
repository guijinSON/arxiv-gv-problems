   443	                            "answer_atoms": _atoms, "answer_chars": _chars,
   444	                            "atom_cap": ANSWER_ATOM_CAP, "char_cap": ANSWER_CHAR_CAP,
   445	                            "axes_moved": sorted(axes_moved),
   446	                            # Two different diagnoses share this verdict, and the
   447	                            # cure differs. "answer_cap": the format genuinely
   448	                            # blocked the ladder -- needs a fixed-length witness.
   449	                            # "single_axis": the ladder only ever turned one dial,
   450	                            # so the family was never actually explored -- often
   451	                            # with a tiny answer and enormous headroom left.
   452	                            "signal": "+".join(
   453	                                x for x in (("answer_cap" if _near else ""),
   454	                                            ("single_axis" if _one_dial else "")) if x),
   455	                            "reason": (
   456	                                "escalate() returned None, but this looks like the ANSWER "
   457	                                "CAP rather than a hardness ceiling"
   458	                                + (f": the answer is already {_atoms} atoms / {_chars} chars "
   459	                                   f"against a {ANSWER_ATOM_CAP}-atom, {ANSWER_CHAR_CAP}-char cap"
   460	                                   if _atoms is not None else "")
   461	                                + (f"; the ladder only ever moved {sorted(axes_moved) or ['nothing']}, "
   462	                                   "so no fixed-answer-length axis was tried"
   463	                                   if _one_dial else "")
   464	                                + ".  PARK this paper -- do not write REJECTED.md.  Harden at "
   465	                                  "fixed answer length instead (bigger ground set with the same "
   466	                                  "witness size, larger modulus, denser decoys, tighter "
   467	                                  "constraints) and re-run."),
   468	                        }
   469	                        break
   470	                    verdict = {"verdict": "too_easy", "escalations_used": escalation_round,
   471	                               "axes_moved": sorted(axes_moved),
   472	                               "answer_atoms": _atoms,
   473	                               "reason": "escalate() returned None — the family cannot be "
   474	                                         "made harder, and the oracle pool still solves it"}
   475	                    break
   476	                params = dict(nxt, _preset="escalated")
   477	        else:
   478	            # The loop ran out of ESCALATIONS, which says nothing about the family
   479	            # until we ask whether it had anywhere left to go.  Ask.
   480	            _atoms, _chars = _answer_size(mod, prev_call or {})
   481	            try:
   482	                _more = mod.escalate(dict(prev_call or {}))
   483	            except Exception:                               # noqa: BLE001
   484	                _more = None
   485	            if _more is not None:
   486	                verdict = {
   487	                    "verdict": "budget_bound",
   488	                    "escalations_used": MAX_ESCALATIONS,
   489	                    "axes_moved": sorted(axes_moved),
   490	                    "answer_atoms": _atoms, "answer_chars": _chars,
   491	                    "next_level": None if _more == "cap_bound" else _more,
   492	                    "escalate_says": "cap_bound" if _more == "cap_bound" else "more levels",
   493	                    "reason": (
   494	                        f"the oracle pool solved every level through {MAX_ESCALATIONS} "
   495	                        f"escalations, but escalate() was STILL WILLING TO CLIMB "
   496	                        f"({'it would next report cap_bound' if _more == 'cap_bound' else _more}). "
   497	                        "The binding constraint was this harness's escalation budget, not "
   498	                        "the paper.  PARK it -- do not write REJECTED.md.  Re-run with "
   499	                        "ORACLE_MAX_ESCALATIONS raised, or ship at a higher preset."),
   500	                }
   501	            else:
   502	                verdict = {"verdict": "too_easy", "escalations_used": MAX_ESCALATIONS,
   503	                           "axes_moved": sorted(axes_moved),
   504	                           "answer_atoms": _atoms, "answer_chars": _chars,
   505	                           "reason": f"the oracle pool solved every level through "
   506	                                     f"{MAX_ESCALATIONS} escalations, and escalate() "
   507	                                     f"has nothing further to offer"}
   508	
   509	    update_meta(harden_verdict=verdict)
   510	    print(json.dumps(verdict, indent=1))
   511	    # 0 hardened / 9 too_easy (give the paper up) / 10 park it -- the paper is fine
   512	    # and the binding constraint is ours: the answer format (cap_bound) or the
   513	    # escalation budget (budget_bound).
   514	    return {"hardened": 0, "cap_bound": 10, "budget_bound": 10}.get(verdict["verdict"], 9)
   515	
   516	
   517	if __name__ == "__main__":
   518	    sys.exit(main())

