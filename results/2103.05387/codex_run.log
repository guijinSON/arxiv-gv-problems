def _attack_outlier(inst):
    adjacency = _adjacency(inst)
    _, exposed = _matching_maps(inst)
    candidate = list(exposed)
    for u, v in inst["matching"]:
        candidate.append(min((u, v), key=lambda x: (len(adjacency[x]), x)))
