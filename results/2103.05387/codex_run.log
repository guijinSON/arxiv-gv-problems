   150	def _is_prime(value):
   151	    if not _is_int(value) or value < 2:
   152	        return False
   153	    if value % 2 == 0:
   154	        return value == 2
   155	    limit = math.isqrt(value)
   156	    divisor = 3
   157	    while divisor <= limit:
   158	        if value % divisor == 0:
   159	            return False
   160	        divisor += 2
   161	    return True
