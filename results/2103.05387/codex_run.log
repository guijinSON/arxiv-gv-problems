   578	def _intended_route_operations(params):
   579	    # Sum two rows, multiply both sums by degree^-1, subtract the means,
   580	    # and extend one allowed slot by n-1 modular additions.
   581	    return 2 * (params["degree"] - 1) + 3 + (params["n"] - 1)
