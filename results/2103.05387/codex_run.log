   273	        tagged = _ANSWER_RE.findall(text)
   274	        if tagged:
   275	            payload = tagged[-1].strip()
   276	            payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
   277	            payload = re.sub(r"\s*```$", "", payload)
   278	        else:
   279	            fenced = re.findall(r"```(?:json)?\s*(\[[\s\S]*?\])\s*```", text, re.I)
