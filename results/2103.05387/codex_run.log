   297	def _validate_instance(inst):
   298	    try:
   299	        n = inst["n"]
   300	        degree = inst["degree"]
   301	        rows = inst["rows"]
   302	    except (KeyError, TypeError):
   303	        return False, "malformed instance"
   304	    if not _is_prime(n) or n < 5:
   305	        return False, "malformed slot count"
   306	    if not _is_int(degree) or not 2 <= degree < n:
   307	        return False, "malformed row degree"
   308	    if not isinstance(rows, list) or len(rows) != n:
   309	        return False, "instance must contain one row per edge"
   310	    seen_edges = set()
   311	    for row in rows:
   312	        if not isinstance(row, dict) or set(row) != {"edge", "slots"}:
   313	            return False, "malformed availability row"
   314	        edge = row["edge"]
   315	        slots = row["slots"]
   316	        if not _is_int(edge) or not 0 <= edge < n or edge in seen_edges:
   317	            return False, "edge labels must be distinct integers in range"
   318	        seen_edges.add(edge)
   319	        if not isinstance(slots, list) or len(slots) != degree:
   320	            return False, "availability row has wrong size"
   321	        if any(not _is_int(slot) or not 0 <= slot < n for slot in slots):
   322	            return False, "availability slot out of range"
   323	        if slots != sorted(set(slots)):
   324	            return False, "availability slots must be sorted and distinct"
   325	    if seen_edges != set(range(n)):
   326	        return False, "edge labels are incomplete"
   327	    return True, "ok"
