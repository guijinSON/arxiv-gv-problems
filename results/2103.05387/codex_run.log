   512	def _attack_outlier_frequency(inst):
   513	    rows = _row_map(inst)
   514	    frequency = [0] * inst["n"]
   515	    for slots in rows.values():
   516	        for slot in slots:
   517	            frequency[slot] += 1
   518	    return [min(rows[edge], key=lambda s: (frequency[s], s)) for edge in range(inst["n"])]
