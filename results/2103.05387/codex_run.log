+        if _candidate_valid_fast(inst, random_candidate(inst, rng), row_sets):
+            hits += 1
+    guess_seconds = time.perf_counter() - guess_started
+    report["G4_guess_resistance"] = {
+        "pass": hits / trials < 1e-6,
+        "hits": hits,
+        "total": trials,
