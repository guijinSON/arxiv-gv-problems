/bin/bash -lc "python3 - <<'PY'
import ast, importlib.util, json, os, random, re
p='gen_2103_05387.py'
source=open(p,encoding='utf-8').read(); tree=ast.parse(source)
assert 'random.random(' not in source and 'random.shuffle(' not in source
s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
assert g.TRACK in {'A','B'}
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.SHIPPING_DIFFICULTY in {'easy','medium','hard'}
assert set(g.PROBLEM_PROFILE) >= {'native_domain','object_regime','computational_core','certificate_form','native_objects','verification_operations','domain_essentiality','reduction_kind','reduction_source','intuition_type','intuition_description','hardness_basis','max_answer_tokens'}
report=json.load(open('selftest_report.json'))
assert all(v.get('pass') for k,v in report.items() if re.match(r'G\\\\d',k))
for preset,params in g.DIFFICULTY.items():
 for seed in range(100):
  i=g.make_instance(seed=seed,**params)
  assert i==g.make_instance(seed=seed,**params)
  assert json.loads(json.dumps(i['answer']))==i['answer']
  detached={k:v for k,v in i.items() if k"'!='"'answer'}
  assert g.verify(detached,i['answer'])==(True,'ok')
  response='Reasoning before.\\\\n"'```json'"\\\\n<answer>'+json.dumps(i['answer'])+'</answer>\\\\n"'```'"\\\\nReasoning after.'
  assert g.parse_answer(response)==i['answer']
  assert g.verify(detached,g._invariant_witness(i))==(True,'ok')
for name in ('llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl'):
 rows=[json.loads(x) for x in open(name) if x.strip()]
 assert len(rows)==4
 assert all(r['schema_version']==2 and r['solved']=='error' and r['error'] for r in rows)
print('STATIC/INTERFACE: pass')
print('DETERMINISM/DETACHED VERIFY/ROUNDTRIP/INVARIANT: 400 instances pass')
print('REPORT JSON: pass; all local gate flags true')
