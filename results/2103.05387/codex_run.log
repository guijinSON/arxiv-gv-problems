   447	def _hopcroft_karp(inst):
   448	    """Domain-standard perfect matching, with exact edge-inspection counts."""
   449	
   450	    adjacency = _row_map(inst)
   451	    n = inst["n"]
   452	    pair_left = [-1] * n
   453	    pair_right = [-1] * n
   454	    distance = [0] * n
   455	    inspections = 0
   456	    phases = 0
   457	
   458	    def bfs():
   459	        nonlocal inspections
   460	        queue = deque()
   461	        found = False
   462	        for left in range(n):
   463	            if pair_left[left] == -1:
   464	                distance[left] = 0
   465	                queue.append(left)
   466	            else:
   467	                distance[left] = -1
   468	        while queue:
   469	            left = queue.popleft()
   470	            for right in adjacency[left]:
   471	                inspections += 1
   472	                mate = pair_right[right]
   473	                if mate == -1:
   474	                    found = True
   475	                elif distance[mate] < 0:
   476	                    distance[mate] = distance[left] + 1
   477	                    queue.append(mate)
   478	        return found
   479	
   480	    def dfs(left):
   481	        nonlocal inspections
   482	        for right in adjacency[left]:
   483	            inspections += 1
   484	            mate = pair_right[right]
   485	            if mate == -1 or (
   486	                distance[mate] == distance[left] + 1 and dfs(mate)
   487	            ):
   488	                pair_left[left] = right
   489	                pair_right[right] = left
   490	                return True
   491	        distance[left] = -1
   492	        return False
   493	
   494	    matched = 0
   495	    while bfs():
   496	        phases += 1
   497	        progress = 0
   498	        for left in range(n):
   499	            if pair_left[left] == -1 and dfs(left):
   500	                matched += 1
   501	                progress += 1
   502	        if progress == 0:
   503	            break
   504	    result = pair_left if matched == n else None
   505	    return result, {
   506	        "edge_inspections": inspections,
   507	        "phases": phases,
   508	        "matched": matched,
   509	    }
