   538	def _attack_constant_shift(inst):
   539	    rows = _row_map(inst)
   540	    n = inst["n"]
   541	    for shift in rows[0]:
   542	        candidate = [(edge + shift) % n for edge in range(n)]
   543	        if _candidate_valid_fast(inst, candidate):
   544	            return candidate
   545	    return None
