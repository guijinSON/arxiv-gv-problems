   330	def verify(inst, answer):
   331	    """Check any complete temporal exploration without reading ``inst['answer']``."""
   332	
   333	    valid, reason = _validate_instance(inst)
   334	    if not valid:
   335	        return False, reason
   336	    n = inst["n"]
   337	    if not isinstance(answer, list):
   338	        return False, "answer must be a JSON list"
   339	    if not answer:
   340	        return False, "answer is empty"
   341	    if any(not _is_int(slot) for slot in answer):
   342	        return False, "every answer entry must be an integer"
   343	    if len(answer) != n:
   344	        return False, f"wrong length: expected exactly {n} slots"
   345	    if any(slot < 0 or slot >= n for slot in answer):
   346	        return False, f"slot index out of range 0..{n - 1}"
   347	    if len(set(answer)) != n:
   348	        return False, "slot indices must be distinct"
   349	
   350	    rows = _row_map(inst)
   351	    for edge, slot in enumerate(answer):
   352	        if slot not in rows[edge]:
   353	            return False, f"edge {edge} is not active throughout slot {slot}"
   354	
   355	    # Exact replay in temporal order.  Slot distinctness makes this sequence use
   356	    # all n slots, but replay it explicitly so verification remains about the
   357	    # paper's temporal walk rather than only an abstract matching.
   358	    ordered = sorted((slot, edge) for edge, slot in enumerate(answer))
   359	    previous_time = 0
   360	    visited = set()
   361	    at_centre = True
   362	    for slot, edge in ordered:
   363	        outward = 2 * slot + 1
   364	        backward = outward + 1
   365	        if not at_centre or outward <= previous_time or backward <= outward:
   366	            return False, "traversal times are not a strict closed walk"
   367	        if edge in visited:
   368	            return False, "an edge is visited more than once"
   369	        at_centre = False
   370	        previous_time = outward
   371	        at_centre = True
   372	        previous_time = backward
   373	        visited.add(edge)
   374	    if not at_centre or len(visited) != n:
   375	        return False, "walk is not a complete closed exploration"
   376	    return True, "ok"
