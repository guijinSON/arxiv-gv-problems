+def _invariant_witness(inst):
+    """Recover an affine exploration using only the rendered row data.
+
+    This is the intended compact Track-B route, not generation: the modular
+    mean of row ``i`` is ``multiplier*i + constant``.  Any slot in row zero
+    therefore extends to one of the affine perfect matchings by repeatedly
+    adding the difference between the means of rows one and zero.
+    """
+
+    rows = _row_map(inst)
+    n = inst["n"]
+    inverse_degree = pow(inst["degree"], -1, n)
+    mean_zero = (sum(rows[0]) * inverse_degree) % n
+    mean_one = (sum(rows[1]) * inverse_degree) % n
+    step = (mean_one - mean_zero) % n
+    answer = [rows[0][0]]
+    for _ in range(1, n):
+        answer.append((answer[-1] + step) % n)
+    return answer
+
+
 def _relabeled(inst, permutation, reorder_rows=False, seed=0):
     """Relabel leaves and carry the slot-list witness through the map."""
 
