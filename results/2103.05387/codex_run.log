import random,math

def gen(n,d,seed):
 r=random.Random(seed); units=[x for x in range(2,n) if math.gcd(x,n)==1];a=r.choice(units);b=r.randrange(n);C=r.sample(range(n),d); rows=[]
 for i in range(n): rows.append(sorted({(a*i+b+c)%n for c in C}))
 return a,b,C,rows

def verify(rows,a): return len(a)==len(rows) and all(y in rows[i] for i,y in enumerate(a)) and len(set(a))==len(a)
def greedy(rows,order=None,randomize=False,rng=None):
 used=set();ans=[None]*len(rows)
 for i in (order or range(len(rows))):
  cand=[y for y in rows[i] if y not in used]
  if not cand:return None
  y=rng.choice(cand) if randomize else cand[0];ans[i]=y;used.add(y)
 return ans
for n,d in [(41,7),(61,11),(83,17),(83,9),(101,11)]:
 print('case',n,d)
 for s in range(8):
  A,b,C,rows=gen(n,d,s)
  g=greedy(rows)
  succ=bool(g and verify(rows,g))
  rr=0
  rng=random.Random(100000+s)
  for z in range(256):
   order=list(range(n));rng.shuffle(order);x=greedy(rows,order,True,rng)
   if x and verify(rows,x):rr=1;break
  print(s,'a',A,'greedy',succ,'rr',rr)
