import random, math
from collections import deque

def rank(cols,b):
    piv={}
    for x in cols:
        y=x
        while y:
            j=y.bit_length()-1
            if j in piv:y"'^=piv[j]
            else:piv[j]=y;break
    return len(piv)

def inst(n,d,seed):
 r=random.Random(seed); b=n.bit_length()-1
 while 1:
  cols=[r.randrange(1,n) for _ in range(b)]
  if rank(cols,b)==b and sum(x.bit_count() for x in cols)>=2*b:break
 def lm(x):
  y=0
  while x:
   l=x & -x; j=l.bit_length()-1;y''^=cols[j];x''^=l
  return y
 off=r.sample(range(n),d); chosen=r.choice(off)
 rows={i:sorted(lm(i)''^o for o in off) for i in range(n)}
 order=list(range(n));r.shuffle(order)
 return rows,order,[lm(i)''^chosen for i in range(n)]

def greedy(rows,order,rng=None):
 used=set();a=[None]*len(rows);o=order[:]
 if rng:rng.shuffle(o)
 for e in o:
  q=[x for x in rows[e] if x not in used]
  if not q:return None
  x=rng.choice(q) if rng else q[0];a[e]=x;used.add(x)
 return a
for n in (64,128,256):
