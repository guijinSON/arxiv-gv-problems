   413	def canonical_key(inst):
   414	    """Complete invariant under leaf relabelling and availability-row order.
   415	
   416	    A temporal star has no structure among its leaves, so with fixed integer
   417	    times its isomorphism type is exactly the multiset of leaf time-sets.  Slot
   418	    s deterministically stands for the time pair (2s+1,2s+2).
   419	    """
   420	
   421	    normalized_rows = sorted(tuple(row["slots"]) for row in inst["rows"])
   422	    payload = {
   423	        "n": inst["n"],
   424	        "degree": inst["degree"],
   425	        "time_sets": normalized_rows,
   426	    }
   427	    blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
   428	    return hashlib.sha256(blob).hexdigest()
