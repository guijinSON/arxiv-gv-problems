   361	def verify(inst: dict, answer) -> tuple[bool, str]:
   362	    """Check any deleted support by exact substitution; never inspect inst['answer']."""
   363	    t = inst["deletions"]
   364	    p = inst["p"]
   365	    q = inst["q"]
   366	    if not isinstance(answer, list):
   367	        return False, "answer must be a list of integer positions"
   368	    if not answer:
   369	        return False, "answer is empty"
   370	    if len(answer) != t:
   371	        return False, f"expected exactly {t} deleted positions"
   372	    if any(isinstance(value, bool) or not isinstance(value, int) for value in answer):
   373	        return False, "every position must be an integer"
   374	    if len(set(answer)) != len(answer):
   375	        return False, "deleted positions must be distinct"
   376	    if answer != sorted(answer):
   377	        return False, "deleted positions must be in strictly increasing order"
   378	    if any(value < 1 or value > q for value in answer):
   379	        return False, f"a position is outside the inclusive alphabet range 1..{q}"
   380	    survivor_set = set(inst["survivors"])
   381	    if any(value in survivor_set for value in answer):
   382	        return False, "a deleted position is also listed as a survivor"
   383	
   384	    # Compare one power at a time.  This is still exact substitution into every
   385	    # displayed identity for a correct witness, while letting the 200,000-sample
   386	    # density audit reject a random candidate at its first bad power instead of
   387	    # needlessly evaluating all t powers.
   388	    values = list(answer) + inst["survivors"]
   389	    powers = [1] * len(values)
   390	    for k, wanted in enumerate(inst["syndrome"], 1):
   391	        actual = 0
   392	        for index, value in enumerate(values):
   393	            powers[index] = powers[index] * value % p
   394	            actual = (actual + powers[index]) % p
   395	        if actual != wanted:
   396	            return False, f"VT syndrome mismatch at power k={k}"
   397	    return True, "ok"
   398	
