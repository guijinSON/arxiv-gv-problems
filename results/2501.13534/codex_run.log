@@ -1,9 +1,9 @@
-"""Verified Track-B VT-syndrome deletion instances from arXiv:2501.13534.
+"""Exact VT-syndrome deletion-decoding problem generator for arXiv:2501.13534.
 
-The solver receives the syndrome of a constant-weight set-code word and the
-set left after deletions.  It returns the deleted symbols together with their
-error-locator polynomial.  Instances are inverse-generated from reflection
-orbits, so the certificate is known before the public syndrome is formed.
+The family uses the paper's Section 2.3 binary constant-weight/set-code
+construction.  It is deterministic in (n, seed, params), uses only the standard
+library (gvlib is detected but not needed), performs no file I/O, and prints
+nothing at import time.
 """
 
 from __future__ import annotations
@@ -15,43 +15,56 @@
 import os
 import random
 import re
