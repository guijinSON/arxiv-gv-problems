+def _poly_mulmod(a, b, modulus, p, counter):
+    raw = [0] * (len(a) + len(b) - 1)
+    for i, avalue in enumerate(a):
+        if avalue:
+            for j, bvalue in enumerate(b):
+                raw[i + j] = (raw[i + j] + avalue * bvalue) % p
+                counter["operations"] += 2
+    _, remainder = _poly_divmod(raw, modulus, p, counter)
+    return remainder
 
 
