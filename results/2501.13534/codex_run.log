import itertools, json, random
import gen_2501_13534 as g

# Determinism, answer-independence, both decoders, compact cap.
for preset, params in g.DIFFICULTY.items():
    for seed in range(40):
        a=g.make_instance(seed=seed,**params)
        b=g.make_instance(seed=seed,**params)
        assert a==b
        public={k:v for k,v in a.items() if k"'!='"'answer'}
        assert g.verify(public,a['answer'])==(True,'ok')
        compact,cnt=g._compact_decode(public)
        assert g.verify(public,compact)[0] and cnt['operations']<=300
        if seed<8:
            roots,_=g._reference_decode(public,seed=1000+seed)
            assert g.verify(public,roots)[0]

# Exhaust the demo certificate language for several seeds: theorem uniqueness,
# count formula, and enumeration agree.
for seed in range(12):
    inst=g.make_instance(seed=seed,**g.DIFFICULTY['demo'])
    p,t=inst['p'],inst['deletions']
    forbidden={0,*inst['survivors']}
    allowed=[x for x in range(p) if x not in forbidden]
    target=g._residual_first(inst)
    language=[]
    valid=[]
    for comb in itertools.combinations(allowed,t):
        if sum(comb)%p==target:
            language.append(comb)
            if g.verify(inst,list(comb))[0]: valid.append(comb)
    assert len(language)==g.search_space(inst)
    assert len(valid)==g.enumerate_all(inst)==1

# Parser safety and JSON round trip.
assert g.parse_answer('garbage') is None
assert g.parse_answer('<answer>1, nope</answer>') is None
for seed in range(20):
    inst=g.make_instance(seed=seed,**g.DIFFICULTY['medium'])
    ans=inst['answer']
    assert json.loads(json.dumps(ans))==ans
    assert g.parse_answer('prose <answer>'+', '.join(map(str,ans))+'</answer> tail')==ans
print('extended audit: ok')
