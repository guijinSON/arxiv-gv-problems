+    # G5: shipping density and costs, plus genuine demo brute force.
+    demo = make_instance(seed=123, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    strongest = max(attack_stats.items(), key=lambda item: item[1]["wall_clock_sec"])
+    report["G5_density_and_baseline"] = {
+        "pass": (
+            demo_count == 1 and reference_successes == 8 and observed < 1e-6
+        ),
+        "shipping_uniqueness_basis": (
+            "Newton identities uniquely determine the degree-t locator because p>t"
+        ),
+        "shipping_certified_solution_count": 1,
+        "shipping_exact_solution_fraction": 1.0 / search_space(ship),
+        "shipping_sampled_valid_hits": hits,
+        "shipping_sampled_valid_total": sample_count,
+        "shipping_sampled_density": observed,
