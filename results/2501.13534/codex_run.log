   400	# ---------------------------------------------------------------------------
   401	# Candidate language and exact counting
   402	
   403	def _residual_first(inst: dict) -> int:
   404	    return (inst["syndrome"][0] - sum(inst["survivors"])) % inst["p"]
   405	
   406	
   407	def random_candidate(inst: dict, rng: random.Random) -> object:
   408	    """Uniformly sample the obvious first-syndrome-constrained answer language."""
   409	    if not isinstance(rng, random.Random):
   410	        raise TypeError("rng must be an instance of random.Random")
   411	    p = inst["p"]
   412	    t = inst["deletions"]
   413	    forbidden = set(inst["survivors"])
   414	    target = _residual_first(inst)
   415	    # Choosing an ordered (t-1)-tuple and deriving its last member gives every
   416	    # valid unordered t-set exactly t! preimages, so rejection preserves uniformity.
   417	    while True:
   418	        prefix = []
   419	        used = set(forbidden)
   420	        while len(prefix) < t - 1:
   421	            value = rng.randrange(1, p)
   422	            if value not in used:
   423	                used.add(value)
   424	                prefix.append(value)
   425	        last = (target - sum(prefix)) % p
   426	        if last != 0 and last not in used:
   427	            return sorted(prefix + [last])
   428	
   429	
   430	def _count_language(inst: dict) -> int:
   760	        for value in inst["syndrome"]:
   761	            power = power * scale % p
   762	            normalized_syndrome.append(value * power % p)
   763	        forms.append((normalized_survivors, tuple(normalized_syndrome)))
   764	    canonical = min(forms)
   765	    payload = json.dumps({
   766	        "p": p,
   767	        "t": inst["deletions"],
   768	        "weight": inst["word_weight"],
   769	        "survivors": canonical[0],
   770	        "syndrome": canonical[1],
   771	    }, separators=(",", ":"))
   772	    return hashlib.sha256(payload.encode("ascii")).hexdigest()
