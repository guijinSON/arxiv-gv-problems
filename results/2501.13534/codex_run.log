+def _attack_greedy_near_survivor(inst: dict):
+    p = inst["p"]
+    anchor = inst["survivors"][0]
+    order = (value for distance in range(p)
+             for value in ((anchor - distance) % p, (anchor + distance) % p))
+    return _complete_from_order(inst, order)
 
 
