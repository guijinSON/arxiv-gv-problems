+def _scale_instance(inst: dict, multiplier: int, reverse_survivors=False) -> dict:
+    p = inst["p"]
+    multiplier %= p
+    if multiplier == 0:
+        raise ValueError("multiplier must be nonzero modulo p")
+    out = dict(inst)
+    survivors_list = [(multiplier * value) % p for value in inst["survivors"]]
