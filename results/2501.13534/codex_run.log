+        "deleted alphabet symbols outside the received set, and the t+1 "
+        "highest-degree-first coefficients in GF(p) of their monic locator "
+        "polynomial."
+    ),
+    "bounds": {
+        "deleted_length": "t",
+        "symbol_lower_inclusive": 0,
+        "symbol_upper_exclusive": "q",
+        "deleted_order": "strictly increasing",
+        "locator_length": "t+1",
+        "coefficient_lower_inclusive": 0,
