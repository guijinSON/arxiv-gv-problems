   812	def selftest() -> dict:
   813	    """Run gates G1--G9 and return a fully JSON-native measurement report."""
   814	    report = {}
   815	
   816	    # G1: every preset and several seeds.
   817	    g1_failures = []
   818	    g1_total = 0
   819	    for preset, params in DIFFICULTY.items():
   820	        for seed in range(3):
