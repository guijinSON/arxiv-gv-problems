+        "n": n,
+        "q": q,
+        "p": p,
+        "t": t,
+        "syndrome": syndrome,
+        "received": received,
+        # This is a derived public-instance quantity cached for cheap exact
+        # verification; render deliberately asks the solver to derive it.
+        "erased_syndrome": erased_syndrome,
+        "answer": answer,
+    }
