+    """Enlarge the field first; only later use still-bounded fixed-shape dials."""
+    out = dict(params)
+    ambient = int(out.get("n", 200_000))
+    survivor_count = int(out.get("survivors", 2))
+    t = int(out.get("t", 48))
+    if survivor_count > 1:
+        out["survivors"] = survivor_count - 1
+        out["n"] = ambient * 2
+        out["t"] = t
+        return out
+    if ambient < 2**57:
+        out["n"] = ambient * 4
+        out["survivors"] = survivor_count
+        out["t"] = t
+        return out
+    if t < 64:
+        out["t"] = min(64, t + 8)
+        out["n"] = ambient
+        out["survivors"] = survivor_count
+        return out
+    return "cap_bound"
