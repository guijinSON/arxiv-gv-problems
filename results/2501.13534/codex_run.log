+def _complete_from_order(inst: dict, ordered_values) -> list[int]:
+    t = inst["deletions"]
+    p = inst["p"]
+    forbidden = {0, *inst["survivors"]}
+    target = _residual_first(inst)
+    chosen = []
+    used = set(forbidden)
+    for value in ordered_values:
+        value %= p
+        if value in used:
