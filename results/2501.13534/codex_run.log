+            x = x * x % value
+            if x == value - 1:
+                break
+        else:
+            return False
+    return True
+
+
+def _next_prime(q: int) -> int:
+    candidate = q + 1
+    if candidate > 2 and candidate % 2 == 0:
+        candidate += 1
+    while not _is_prime(candidate):
+        candidate += 2
+    return candidate
+
+
+def _power_sums(values: list[int], t: int, p: int) -> list[int]:
+    sums = [0] * t
+    for value in values:
+        power = value % p
+        for k in range(t):
+            sums[k] = (sums[k] + power) % p
+            power = power * value % p
+    return sums
+
+
+def _locator_from_roots(roots: list[int], p: int) -> list[int]:
+    """Highest-degree-first coefficients of product (z-root) over GF(p)."""
+    coefficients = [1]
+    for root in roots:
+        nxt = [0] * (len(coefficients) + 1)
+        for i, coefficient in enumerate(coefficients):
+            nxt[i] = (nxt[i] + coefficient) % p
+            nxt[i + 1] = (nxt[i + 1] - root * coefficient) % p
+        coefficients = nxt
+    return coefficients
+
+
+def _certificate(deleted: list[int], p: int) -> dict:
+    roots = sorted(deleted)
+    return {"deleted": roots, "locator": _locator_from_roots(roots, p)}
+
+
+def make_instance(n: int, seed: int = 0, q: int | None = None,
+                  t: int = 8, **params) -> dict:
+    """Inverse-generate one received VT-syndrome set-code word.
+
+    ``n`` is the transmitted set size.  The answer has fixed length ``t``;
+    increasing n adds complete reflection-pair decoys.  Increasing q enlarges
+    both the generic decoder scan and the completion space without lengthening
+    the witness.
+    """
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4 or n % 2:
+        raise ValueError("n must be an even integer at least 4")
+    if isinstance(t, bool) or not isinstance(t, int) or t < 1 or t > n // 2:
+        raise ValueError("t must be an integer in [1,n/2]")
+    if q is None:
+        q = max(1009, 4 * n + 1)
+    if isinstance(q, bool) or not isinstance(q, int) or q <= n:
+        raise ValueError("q must be an integer strictly larger than n")
+    if q >= (1 << 63):
+        raise ValueError("q must be below 2^63 for deterministic primality")
+    p = _next_prime(q)
+    if p <= max(q, n, t):
+        raise AssertionError("prime modulus invariant failed")
+
+    rng = random.Random(seed)
+    half = n // 2
+    center_lo = max(half, q // 2 - q // 20)
+    center_hi = min(q - half, q // 2 + q // 20 + 1)
+    if center_lo >= center_hi:
+        center_lo, center_hi = half, q - half
+    center = rng.randrange(center_lo, center_hi)
+    radius = min(center, q - 1 - center)
+    if radius < half:
+        raise ValueError("q leaves too few reflection pairs")
+
+    offsets = rng.sample(range(1, radius + 1), half)
+    pairs = [(center - offset, center + offset) for offset in offsets]
+    erased_pair_indices = set(rng.sample(range(half), t))
+    deleted = []
+    received = []
+    for index, (left, right) in enumerate(pairs):
+        if index in erased_pair_indices:
+            if rng.randrange(2):
+                deleted.append(left)
+                received.append(right)
+            else:
+                deleted.append(right)
+                received.append(left)
+        else:
+            received.extend((left, right))
+    rng.shuffle(received)
+    transmitted = received + deleted
+    syndrome = _power_sums(transmitted, t, p)
+    erased_syndrome = _power_sums(deleted, t, p)
+    answer = _certificate(deleted, p)
+    return {
+        "family": "VT-syndrome constant-weight set-code deletion recovery",
+        "n": n,
+        "q": q,
+        "p": p,
+        "t": t,
+        "syndrome": syndrome,
+        "received": received,
+        # This is a derived public-instance quantity cached for cheap exact
+        # verification; render deliberately asks the solver to derive it.
+        "erased_syndrome": erased_syndrome,
+        "answer": answer,
+    }
+
+
+def _wrapped(values: list[int], width: int = 12) -> str:
+    return "\n".join(
+        "  " + " ".join(str(value) for value in values[i:i + width])
+        for i in range(0, len(values), width)
+    )
+
+
+def render(inst: dict) -> str:
+    """Render a complete set-code decoding problem and exact JSON contract."""
+    t = inst["t"]
+    example_deleted = list(range(t))
+    example_locator = [1] + [0] * t
+    example = json.dumps(
+        {"deleted": example_deleted, "locator": example_locator},
+        separators=(",", ":"),
+    )
+    statement = f"""VT-syndrome set-code deletion recovery
+
+The alphabet is Sigma_q = {{0,1,...,{inst['q'] - 1}}}.  All syndrome arithmetic
+is in the prime field GF({inst['p']}), meaning integers are reduced modulo
+{inst['p']}.  A transmitted codeword is a SET A of exactly n={inst['n']}
+distinct alphabet symbols.  Its order-t VT syndrome is the vector (a_1,...,
+a_t), where
+
+    a_k = sum_(x in A) x^k mod {inst['p']}   for k=1,...,{t}.
+
+Exactly t={t} symbols were deleted.  The received set B therefore contains
+exactly {inst['n'] - t} distinct symbols and is listed below.  Line breaks and
+the displayed order carry no information; repeats are not allowed.
+
+Full transmitted syndrome a_1,...,a_{t}:
+  {' '.join(str(value) for value in inst['syndrome'])}
+
+Received set B:
+{_wrapped(inst['received'])}
+
+Recover the deleted set D=A\\B.  Also give its monic error-locator polynomial
+
+    L(z) = product_(d in D) (z-d)  in GF({inst['p']})[z].
+
+Your answer must be one JSON object with exactly two keys.  "deleted" is the
+strictly increasing list of exactly {t} distinct integers in [0,{inst['q'] - 1}];
+none may occur in B.  "locator" is a list of exactly {t + 1} canonical residues
+in [0,{inst['p'] - 1}], ordered from the coefficient of z^{t} down to the
+constant coefficient.  Its first entry must be 1.  The two lists must describe
+the same deleted set.  Any set satisfying these requirements and all syndrome
+equations is accepted.
+
+Give your final answer inside <answer></answer> tags, as compact JSON.
+Syntax example only: <answer>{example}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the last tagged JSON object, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```") and body.endswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any exact missing-set/locator witness without the planted answer."""
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer object is empty"
+    if set(answer) != {"deleted", "locator"}:
+        return False, "answer must have exactly the keys deleted and locator"
+    deleted = answer["deleted"]
+    locator = answer["locator"]
+    if not isinstance(deleted, list) or not isinstance(locator, list):
+        return False, "deleted and locator must both be JSON lists"
+    t, q, p = inst["t"], inst["q"], inst["p"]
+    if len(deleted) != t:
+        return False, f"wrong deleted count: expected {t}, got {len(deleted)}"
+    if any(isinstance(value, bool) or not isinstance(value, int) for value in deleted):
+        return False, "every deleted symbol must be an integer"
+    if any(value < 0 or value >= q for value in deleted):
+        return False, f"deleted symbol outside alphabet [0,{q - 1}]"
+    if len(set(deleted)) != len(deleted):
+        return False, "deleted symbols are not distinct"
+    if deleted != sorted(deleted):
+        return False, "deleted symbols are not strictly increasing"
+    received = set(inst["received"])
+    if any(value in received for value in deleted):
+        return False, "a deleted symbol is already in the received set"
+    if len(locator) != t + 1:
+        return False, f"wrong locator length: expected {t + 1}, got {len(locator)}"
+    if any(isinstance(value, bool) or not isinstance(value, int) for value in locator):
+        return False, "every locator coefficient must be an integer"
+    if any(value < 0 or value >= p for value in locator):
+        return False, f"locator coefficient outside canonical range [0,{p - 1}]"
+    if locator[0] != 1:
+        return False, "locator polynomial is not monic"
+    expected_locator = _locator_from_roots(deleted, p)
+    if locator != expected_locator:
+        return False, "locator polynomial does not equal the product over deleted roots"
+    moments = _power_sums(deleted, t, p)
+    for k, (actual, target) in enumerate(zip(moments, inst["erased_syndrome"]), 1):
+        if actual != target:
+            return False, f"VT power-sum equation k={k} is violated"
+    if len(received | set(deleted)) != inst["n"]:
+        return False, "reconstructed transmitted set has wrong cardinality"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniform completion of the stated size, disjointness, and order shape."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    forbidden = set(inst["received"])
+    chosen: set[int] = set()
+    while len(chosen) < inst["t"]:
+        value = rng.randrange(inst["q"])
+        if value not in forbidden:
+            chosen.add(value)
+    return _certificate(sorted(chosen), inst["p"])
+
+
+def search_space(inst: dict) -> int | None:
+    """All t-subset completions outside B; the locator is then determined."""
+    return math.comb(inst["q"] - len(inst["received"]), inst["t"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Brute-force the exact certificate language when safely below the cap."""
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    received = set(inst["received"])
+    available = [value for value in range(inst["q"]) if value not in received]
+    count = 0
+    for roots in itertools.combinations(available, inst["t"]):
+        count += int(verify(inst, _certificate(list(roots), inst["p"]))[0])
+    return count
+
+
+def _transform_moments(moments: list[int], count: int,
+                       intercept: int, p: int) -> list[int]:
+    """Moments after x -> intercept-x, using only public moments."""
+    source = [count % p] + list(moments)
+    transformed = []
+    for k in range(1, len(source)):
+        total = 0
+        for j in range(k + 1):
+            term = math.comb(k, j) * pow(intercept, k - j, p) * source[j]
+            total += -term if j % 2 else term
+        transformed.append(total % p)
+    return transformed
+
+
+def _reflect_instance(inst: dict) -> dict:
+    """Apply the alphabet involution x -> q-1-x and carry the witness."""
+    moved = dict(inst)
+    h = inst["q"] - 1
+    moved["received"] = [h - value for value in inst["received"]]
+    moved["syndrome"] = _transform_moments(
+        inst["syndrome"], inst["n"], h, inst["p"]
+    )
+    moved["erased_syndrome"] = _transform_moments(
+        inst["erased_syndrome"], inst["t"], h, inst["p"]
+    )
+    moved["answer"] = _certificate(
+        [h - value for value in inst["answer"]["deleted"]], inst["p"]
+    )
+    return moved
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonical under received-set order and whole-alphabet reflection."""
+    base = [
+        inst["n"], inst["q"], inst["p"], inst["t"],
+        sorted(inst["received"]), list(inst["syndrome"]),
+    ]
+    reflected = _reflect_instance(inst)
+    mirror = [
+        reflected["n"], reflected["q"], reflected["p"], reflected["t"],
+        sorted(reflected["received"]), list(reflected["syndrome"]),
+    ]
+    encoded = min(
+        json.dumps(base, separators=(",", ":")),
+        json.dumps(mirror, separators=(",", ":")),
+    )
+    return hashlib.sha256(encoded.encode()).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow alphabet crowding first, at fixed answer and received-set lengths."""
+    if not isinstance(params, dict) or not {"n", "q", "t"} <= set(params):
+        return None
+    n, q, t = params["n"], params["q"], params["t"]
+    if not all(isinstance(value, int) and not isinstance(value, bool)
+               for value in (n, q, t)):
+        return None
+    if q < 16_000_000:
+        return {"n": n, "q": 2 * q, "t": t}
+    # A few more complete pairs increase the no-tool matching burden while the
+    # answer remains fixed.  Stop before the compact arithmetic cap is crossed.
+    if n + 8 - t + 60 <= 300:
+        return {"n": n + 8, "q": q, "t": t}
+    return "cap_bound"
+
+
+def _newton_locator(power_sums: list[int], p: int) -> tuple[list[int], int]:
+    """Recover a monic locator from power sums; return field-op count."""
+    t = len(power_sums)
+    elementary = [1]
+    operations = 0
+    for k in range(1, t + 1):
+        total = 0
+        for i in range(1, k + 1):
+            term = elementary[k - i] * power_sums[i - 1] % p
+            operations += 1
+            if i % 2:
+                total = (total + term) % p
+            else:
+                total = (total - term) % p
+            operations += 1
+        elementary.append(total * pow(k, -1, p) % p)
+        operations += 1
+    coefficients = [1]
+    for k in range(1, t + 1):
+        coefficients.append(elementary[k] if k % 2 == 0 else (-elementary[k]) % p)
+    return coefficients, operations
+
+
+def _reference_decode(inst: dict) -> tuple[dict | None, int, int]:
+    """Newton identities plus Chien root scan, the generic VT route."""
+    t, p = inst["t"], inst["p"]
+    received_sums = [0] * t
+    operations = 0
+    for value in inst["received"]:
+        power = value % p
+        for k in range(t):
+            received_sums[k] = (received_sums[k] + power) % p
+            operations += 1
+            if k + 1 < t:
+                power = power * value % p
+                operations += 1
+    missing_sums = []
+    for full, kept in zip(inst["syndrome"], received_sums):
+        missing_sums.append((full - kept) % p)
+        operations += 1
+    locator, newton_ops = _newton_locator(missing_sums, p)
+    operations += newton_ops
+    roots = []
+    tested = 0
+    for value in range(inst["q"]):
+        evaluation = locator[0]
+        for coefficient in locator[1:]:
+            evaluation = (evaluation * value + coefficient) % p
+            operations += 2
+        tested += 1
+        if evaluation == 0:
+            roots.append(value)
+            if len(roots) == t:
+                break
+    if len(roots) != t:
+        return None, operations, tested
+    return _certificate(roots, p), operations, tested
+
+
+def _inverse_with_operation_count(value: int, p: int) -> tuple[int, int]:
+    """Extended Euclid, counting division/multiply/subtract updates."""
+    old_r, r = p, value
+    old_s, s = 0, 1
+    operations = 0
+    while r:
+        quotient = old_r // r
+        operations += 1
+        old_r, r = r, old_r - quotient * r
+        operations += 2
+        old_s, s = s, old_s - quotient * s
+        operations += 2
+    if old_r != 1:
+        raise ValueError("value has no inverse modulo p")
+    return old_s % p, operations
+
+
+def _compact_reflection_decode(inst: dict) -> tuple[dict | None, int]:
+    inverse, operations = _inverse_with_operation_count(inst["n"], inst["p"])
+    center = inst["syndrome"][0] * inverse % inst["p"]
+    twice_center = 2 * center % inst["p"]
+    operations += 2
+    received = set(inst["received"])
+    deleted = []
+    for value in inst["received"]:
+        mate = (twice_center - value) % inst["p"]
+        operations += 1
+        if mate not in received:
+            deleted.append(mate)
+    if len(set(deleted)) != inst["t"]:
+        return None, operations
+    candidate = _certificate(deleted, inst["p"])
+    return candidate, operations
+
+
+def _available_extremes(inst: dict) -> dict:
+    forbidden = set(inst["received"])
+    roots = []
+    left, right = 0, inst["q"] - 1
+    while len(roots) < inst["t"]:
+        if left not in forbidden:
+            roots.append(left)
+        if len(roots) < inst["t"] and right not in forbidden:
+            roots.append(right)
+        left += 1
+        right -= 1
+    return _certificate(roots, inst["p"])
+
+
+def _largest_gap_attack(inst: dict) -> dict:
+    forbidden = set(inst["received"])
+    ordered = sorted(forbidden)
+    gaps = sorted(
+        ((ordered[i + 1] - ordered[i], ordered[i], ordered[i + 1])
+         for i in range(len(ordered) - 1)),
+        reverse=True,
+    )
+    roots = []
+    for _, left, right in gaps:
+        value = (left + right) // 2
+        while value in forbidden or value in roots:
+            value += 1
+            if value >= right:
+                value = left + 1
+                break
+        if 0 <= value < inst["q"] and value not in forbidden and value not in roots:
+            roots.append(value)
+        if len(roots) == inst["t"]:
+            break
+    if len(roots) < inst["t"]:
+        return _available_extremes(inst)
+    return _certificate(roots, inst["p"])
+
+
+def _first_moment_greedy(inst: dict) -> dict:
+    """Meet the missing first moment with a cluster near its modular mean."""
+    p, q, t = inst["p"], inst["q"], inst["t"]
+    forbidden = set(inst["received"])
+    target = inst["erased_syndrome"][0]
+    mean = target * pow(t, -1, p) % p
+    for spread in range(1, 100):
+        trial = []
+        for delta in range(-(t // 2), t // 2 + 1):
+            value = (mean + spread * delta) % p
+            if value < q and value not in forbidden and value not in trial:
+                trial.append(value)
+            if len(trial) == t - 1:
+                break
+        if len(trial) != t - 1:
+            continue
+        last = (target - sum(trial)) % p
+        if last < q and last not in forbidden and last not in trial:
+            return _certificate(trial + [last], p)
+    return _available_extremes(inst)
+
+
+def _centered_ansatz(inst: dict) -> dict:
+    p, q, t = inst["p"], inst["q"], inst["t"]
+    forbidden = set(inst["received"])
+    target = inst["erased_syndrome"][0]
+    mean = target * pow(t, -1, p) % p
+    roots = []
+    radius = 1
+    while len(roots) < t and radius < q:
+        for value in ((mean - radius) % p, (mean + radius) % p):
+            if value < q and value not in forbidden and value not in roots:
+                roots.append(value)
+                if len(roots) == t:
+                    break
+        radius += 1
+    return _certificate(roots, p) if len(roots) == t else _available_extremes(inst)
+
+
+def _random_restart(inst: dict, rng: random.Random,
+                    restarts: int = 256) -> tuple[bool, int]:
+    for attempt in range(1, restarts + 1):
+        if verify(inst, random_candidate(inst, rng))[0]:
+            return True, attempt
+    return False, restarts
+
+
+def _answer_metrics(answer: dict) -> tuple[int, int, int]:
+    encoded = json.dumps(answer, separators=(",", ":"))
+    atoms = len(answer["deleted"]) + len(answer["locator"])
+    return len(encoded), math.ceil(len(encoded) / 4), atoms
+
+
+def selftest() -> dict:
+    """Run all construction, parsing, density, attack, scale, and key gates."""
+    report: dict = {
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    # G1: every preset, multiple seeds, and JSON-native round trips.
+    g1_failures = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                g1_failures.append(f"{preset}/{seed}: {reason}")
+            try:
+                restored = json.loads(json.dumps(inst["answer"]))
+            except (TypeError, ValueError) as exc:
+                g1_failures.append(f"{preset}/{seed}: JSON error {exc}")
+            else:
+                if restored != inst["answer"]:
+                    g1_failures.append(f"{preset}/{seed}: JSON changed answer")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures, "attempts": attempts, "failures": g1_failures,
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=123, **shipping)
+    original = ship["answer"]
+
+    # G2: five required corruptions with intentionally distinct diagnoses.
+    drop = json.loads(json.dumps(original))
+    drop["deleted"].pop()
+    swap = json.loads(json.dumps(original))
+    swap["deleted"][0], swap["deleted"][1] = swap["deleted"][1], swap["deleted"][0]
+    duplicate = json.loads(json.dumps(original))
+    duplicate["deleted"][1] = duplicate["deleted"][0]
+    out_of_range = json.loads(json.dumps(original))
+    out_of_range["deleted"][0] = ship["q"]
+    corruptions = {
+        "drop": drop,
+        "swap": swap,
+        "duplicate": duplicate,
+        "empty": {},
+        "out_of_range": out_of_range,
+    }
+    corruption_results = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(ship, candidate)
+        corruption_results[name] = {"accepted": ok, "reason": reason}
+    reasons = [entry["reason"] for entry in corruption_results.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": (
+            all(not entry["accepted"] for entry in corruption_results.values())
+            and len(set(reasons)) == 5
+        ),
+        "cases": corruption_results,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    # G3: realistic prose, Markdown, whitespace, tags, and compact JSON.
+    encoded_answer = json.dumps(original, separators=(",", ":"))
+    realistic = (
+        "I computed the missing moments and factored the locator.\n```json\n"
+        f"<answer>\n{encoded_answer}\n</answer>\n```\n"
+        "The coefficients are highest-degree first."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == original and verify(ship, parsed)[0],
+        "parsed_matches": parsed == original,
+        "realistic_wrapper": True,
+    }
+
+    # G4: uniform t-subset completions outside the received set.
+    sample_count = 200_000
+    guess_rng = random.Random(0x250113534)
+    hits = 0
+    t0 = time.perf_counter()
+    for _ in range(sample_count):
+        hits += int(verify(ship, random_candidate(ship, guess_rng))[0])
+    guess_wall = time.perf_counter() - t0
+    observed = hits / sample_count
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6,
+        "hits": hits,
+        "total": sample_count,
+        "observed_fraction": observed,
+        "candidate_space": search_space(ship),
+        "sampling_prior": (
+            "uniform over all strictly increasing t-subsets of the alphabet "
+            "disjoint from the received set; the monic locator is derived"
+        ),
+        "wall_clock_sec": round(guess_wall, 6),
+    }
+
+    # G6: failing no-tool attacks and the separately successful Track-B decoder.
+    attack_names = (
+        "outlier_alphabet_extremes",
+        "largest_received_gap",
+        "first_moment_greedy",
+        "random_restart_256",
+        "centered_consecutive_ansatz",
+    )
+    attack_stats = {
+        name: {"successes": 0, "attempts": 0, "steps": 0, "wall_clock_sec": 0.0}
+        for name in attack_names
+    }
+    reference_successes = 0
+    reference_operations = 0
+    reference_tested = 0
+    reference_wall = 0.0
+    compact_successes = 0
+    compact_operations = []
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed, **shipping)
+        deterministic_attacks = (
+            ("outlier_alphabet_extremes", _available_extremes),
+            ("largest_received_gap", _largest_gap_attack),
+            ("first_moment_greedy", _first_moment_greedy),
+            ("centered_consecutive_ansatz", _centered_ansatz),
+        )
+        for name, attack in deterministic_attacks:
+            start = time.perf_counter()
+            candidate = attack(inst)
+            elapsed = time.perf_counter() - start
+            stat = attack_stats[name]
+            stat["attempts"] += 1
+            stat["successes"] += int(verify(inst, candidate)[0])
+            stat["steps"] += inst["n"]
+            stat["wall_clock_sec"] += elapsed
+
+        start = time.perf_counter()
+        success, steps = _random_restart(inst, random.Random(seed ^ 0xBEEF), 256)
+        elapsed = time.perf_counter() - start
+        stat = attack_stats["random_restart_256"]
+        stat["attempts"] += 1
+        stat["successes"] += int(success)
+        stat["steps"] += steps
+        stat["wall_clock_sec"] += elapsed
+
+        start = time.perf_counter()
+        decoded, operations, tested = _reference_decode(inst)
+        elapsed = time.perf_counter() - start
+        reference_wall += elapsed
+        reference_operations += operations
+        reference_tested += tested
+        reference_successes += int(decoded is not None and verify(inst, decoded)[0])
+
+        compact, compact_ops = _compact_reflection_decode(inst)
+        compact_operations.append(compact_ops)
+        compact_successes += int(compact is not None and verify(inst, compact)[0])
+
+    for stat in attack_stats.values():
+        stat["wall_clock_sec"] = round(stat["wall_clock_sec"], 6)
+    all_failed = all(stat["successes"] == 0 for stat in attack_stats.values())
+    report["G6_adversary_panel"] = {
+        "pass": (
+            all_failed and reference_successes == 8 and compact_successes == 8
+        ),
+        "attacks": attack_stats,
+        "reference_algorithm": {
+            "name": "Newton identities plus Chien root search for the VT syndrome",
+            "paper_location": "Section 2.3, decoder cited after Definition 4",
+            "complexity": "O((n+q)t) exact field operations in this implementation",
+            "wall_clock_sec": round(reference_wall, 6),
+            "operations": reference_operations,
+            "alphabet_values_tested": reference_tested,
+            "average_operations_per_instance": reference_operations // 8,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+        "compact_route": {
+            "name": "recover reflection center and match missing mates",
+            "operations_max": max(compact_operations),
+            "solves": f"{compact_successes}/8",
+        },
+    }
+
+    # G5: shipping density and costs, plus genuine demo brute force.
+    demo = make_instance(seed=123, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    strongest = max(attack_stats.items(), key=lambda item: item[1]["wall_clock_sec"])
+    report["G5_density_and_baseline"] = {
+        "pass": (
+            demo_count == 1 and reference_successes == 8 and observed < 1e-6
+        ),
+        "shipping_uniqueness_basis": (
+            "Newton identities uniquely determine the degree-t locator because p>t"
+        ),
+        "shipping_certified_solution_count": 1,
+        "shipping_exact_solution_fraction": 1.0 / search_space(ship),
+        "shipping_sampled_valid_hits": hits,
+        "shipping_sampled_valid_total": sample_count,
+        "shipping_sampled_density": observed,
+        "demo_bruteforce_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "reference_algorithm_wall_clock_sec": round(reference_wall, 6),
+        "reference_algorithm_operations": reference_operations,
+        "reference_average_operations": reference_operations // 8,
+        "strongest_failing_attack": strongest[0],
+        "strongest_failing_attack_wall_clock_sec": strongest[1]["wall_clock_sec"],
+        "strongest_failing_attack_steps": strongest[1]["steps"],
+    }
+
+    # G7: ascending ladder, doubled n, and fixed-answer alphabet escalation.
+    ladder_instances = [
+        make_instance(seed=777, **params) for params in DIFFICULTY.values()
+    ]
+    ladder_n = [inst["n"] for inst in ladder_instances]
+    ladder_spaces = [search_space(inst) for inst in ladder_instances]
+    doubled = make_instance(
+        n=2 * ship["n"], q=ship["q"], t=ship["t"], seed=909
+    )
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    fixed_params = escalate(dict(shipping))
+    fixed = make_instance(seed=910, **fixed_params) if isinstance(fixed_params, dict) else None
+    fixed_ok, fixed_reason = verify(fixed, fixed["answer"]) if fixed else (False, "no dict")
+    report["G7_scales"] = {
+        "pass": (
+            ladder_n == sorted(set(ladder_n))
+            and ladder_spaces == sorted(set(ladder_spaces))
+            and doubled_ok and fixed_ok
+            and len(fixed["answer"]["deleted"]) == len(ship["answer"]["deleted"])
+        ),
+        "preset_n": dict(zip(DIFFICULTY, ladder_n)),
+        "preset_candidate_spaces": dict(zip(DIFFICULTY, ladder_spaces)),
+        "doubled_n": doubled["n"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+        "fixed_answer_axis": fixed_params,
+        "fixed_answer_verifies": fixed_ok,
+        "fixed_answer_reason": fixed_reason,
+        "fixed_answer_elements": len(fixed["answer"]["deleted"]) + len(fixed["answer"]["locator"]),
+    }
+
+    # G8: reorder, reflect, and compose over at least twenty unrelated seeds.
+    invariance_checks = 0
+    witness_checks = 0
+    failures = []
+    unrelated = []
+    for seed in range(20):
+        inst = make_instance(n=24, q=2003, t=4, seed=20_000 + seed)
+        key = canonical_key(inst)
+        unrelated.append(key)
+        reordered = dict(inst)
+        reordered["received"] = list(inst["received"])
+        random.Random(30_000 + seed).shuffle(reordered["received"])
+        reflected = _reflect_instance(inst)
+        composed = _reflect_instance(reordered)
+        variants = (reordered, reflected, composed)
+        for number, moved in enumerate(variants):
+            invariance_checks += 1
+            if canonical_key(moved) != key:
+                failures.append(f"key/{seed}/{number}")
+            witness_checks += 1
+            if not verify(moved, moved["answer"])[0]:
+                failures.append(f"witness/{seed}/{number}")
+    distinct_keys = len(set(unrelated))
+    report["G8_canonical_key"] = {
+        "pass": not failures and distinct_keys == 20,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": witness_checks,
+        "invariance_failures": failures,
+        "unrelated_instances": 20,
+        "distinct_keys": distinct_keys,
+        "transformations": [
+            "arbitrary received-list reorder",
+            "whole-alphabet reflection x -> q-1-x",
+            "composition of reorder and reflection",
+        ],
+    }
+
+    # G9 oracle evidence is script-owned; answer and compact costs are local.
+    chars, tokens, elements = _answer_metrics(ship["answer"])
+    compact_ship, intended_operations = _compact_reflection_decode(ship)
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = (
+        chars <= 2000 and elements <= 256 and intended_operations <= 300
+        and PROBLEM_PROFILE["max_answer_tokens"] == tokens
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": (
+            G9_ORACLE_RESULTS["hinted_verdict"] == "hardened"
+            and within_caps
+            and compact_ship is not None
+            and verify(ship, compact_ship)[0]
+        ),
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": chars,
+        "answer_tokens": tokens,
+        "answer_elements": elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(gate.get("pass") is True for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

