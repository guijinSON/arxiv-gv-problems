   775	def escalate(params: dict) -> dict | str | None:
   776	    """Enlarge the field first; only later use still-bounded fixed-shape dials."""
   777	    out = dict(params)
   778	    ambient = int(out.get("n", 200_000))
   779	    survivor_count = int(out.get("survivors", 2))
   780	    t = int(out.get("t", 48))
   781	    if survivor_count > 1:
   782	        out["survivors"] = survivor_count - 1
   783	        out["n"] = ambient * 2
   784	        out["t"] = t
   785	        return out
   786	    if ambient < 2**57:
   787	        out["n"] = ambient * 4
   788	        out["survivors"] = survivor_count
   789	        out["t"] = t
   790	        return out
   791	    if t < 64:
   792	        out["t"] = min(64, t + 8)
   793	        out["n"] = ambient
   794	        out["survivors"] = survivor_count
   795	        return out
   796	    return "cap_bound"
