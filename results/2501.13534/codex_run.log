+    attack_stats = {
+        name: {"successes": 0, "attempts": 0, "steps": 0, "wall_clock_sec": 0.0}
+        for name in attack_names
+    }
+    reference_successes = 0
+    reference_operations = 0
+    reference_tested = 0
+    reference_wall = 0.0
+    compact_successes = 0
+    compact_operations = []
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed, **shipping)
+        deterministic_attacks = (
+            ("outlier_alphabet_extremes", _available_extremes),
+            ("largest_received_gap", _largest_gap_attack),
+            ("first_moment_greedy", _first_moment_greedy),
+            ("centered_consecutive_ansatz", _centered_ansatz),
+        )
+        for name, attack in deterministic_attacks:
+            start = time.perf_counter()
+            candidate = attack(inst)
+            elapsed = time.perf_counter() - start
+            stat = attack_stats[name]
+            stat["attempts"] += 1
+            stat["successes"] += int(verify(inst, candidate)[0])
+            stat["steps"] += inst["n"]
+            stat["wall_clock_sec"] += elapsed
