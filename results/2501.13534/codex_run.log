+    ]
+    ladder_n = [inst["n"] for inst in ladder_instances]
+    ladder_spaces = [search_space(inst) for inst in ladder_instances]
+    doubled = make_instance(
+        n=2 * ship["n"], q=ship["q"], t=ship["t"], seed=909
+    )
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    fixed_params = escalate(dict(shipping))
+    fixed = make_instance(seed=910, **fixed_params) if isinstance(fixed_params, dict) else None
+    fixed_ok, fixed_reason = verify(fixed, fixed["answer"]) if fixed else (False, "no dict")
+    report["G7_scales"] = {
