+        start = time.perf_counter()
+        success, steps = _random_restart(inst, random.Random(seed ^ 0xBEEF), 256)
+        elapsed = time.perf_counter() - start
+        stat = attack_stats["random_restart_256"]
+        stat["attempts"] += 1
+        stat["successes"] += int(success)
+        stat["steps"] += steps
+        stat["wall_clock_sec"] += elapsed
+
+        start = time.perf_counter()
+        decoded, operations, tested = _reference_decode(inst)
+        elapsed = time.perf_counter() - start
+        reference_wall += elapsed
+        reference_operations += operations
+        reference_tested += tested
+        reference_successes += int(decoded is not None and verify(inst, decoded)[0])
+
+        compact, compact_ops = _compact_reflection_decode(inst)
+        compact_operations.append(compact_ops)
+        compact_successes += int(compact is not None and verify(inst, compact)[0])
+
+    for stat in attack_stats.values():
+        stat["wall_clock_sec"] = round(stat["wall_clock_sec"], 6)
+    all_failed = all(stat["successes"] == 0 for stat in attack_stats.values())
+    report["G6_adversary_panel"] = {
+        "pass": (
+            all_failed and reference_successes == 8 and compact_successes == 8
+        ),
+        "attacks": attack_stats,
+        "reference_algorithm": {
+            "name": "Newton identities plus Chien root search for the VT syndrome",
+            "paper_location": "Section 2.3, decoder cited after Definition 4",
+            "complexity": "O((n+q)t) exact field operations in this implementation",
+            "wall_clock_sec": round(reference_wall, 6),
+            "operations": reference_operations,
+            "alphabet_values_tested": reference_tested,
+            "average_operations_per_instance": reference_operations // 8,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+        "compact_route": {
+            "name": "recover reflection center and match missing mates",
+            "operations_max": max(compact_operations),
+            "solves": f"{compact_successes}/8",
+        },
+    }
