+    @lru_cache(maxsize=None)
+    def count(j: int, size: int, total: int) -> int:
+        if size < 0 or size > p - j:
+            return 0
+        total %= p
+        if size == 0:
+            return int(total == 0)
+        if j == 0:
+            # Translation by c sends a size-k subset's sum to sum+k*c.
+            # Since 0<k<p, the p sum classes of F_p are equinumerous.
