+def _attack_unit_scale_ansatz(inst: dict):
+    p = inst["p"]
+    t = inst["deletions"]
+    center = _residual_first(inst) * pow(t, -1, p) % p
+    candidate = sorted({(center + d) % p for d in _template(t)})
