+        "doubled_reason": doubled_reason,
+        "fixed_answer_axis": fixed_params,
+        "fixed_answer_verifies": fixed_ok,
+        "fixed_answer_reason": fixed_reason,
+        "fixed_answer_elements": len(fixed["answer"]["deleted"]) + len(fixed["answer"]["locator"]),
+    }
+
+    # G8: reorder, reflect, and compose over at least twenty unrelated seeds.
+    invariance_checks = 0
+    witness_checks = 0
+    failures = []
+    unrelated = []
+    for seed in range(20):
+        inst = make_instance(n=24, q=2003, t=4, seed=20_000 + seed)
+        key = canonical_key(inst)
+        unrelated.append(key)
+        reordered = dict(inst)
