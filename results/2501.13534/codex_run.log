   315	_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
   316	_FENCE_RE = re.compile(r"```(?:json|text)?\s*(.*?)\s*```", re.I | re.S)
   317	
   318	
   319	def _parse_int_list(body: str):
   320	    body = body.strip()
   321	    if body.startswith("[") and body.endswith("]"):
   322	        try:
   323	            value = json.loads(body)
   324	        except (TypeError, ValueError):
   325	            return None
   326	        if (isinstance(value, list) and
   327	                all(isinstance(v, int) and not isinstance(v, bool) for v in value)):
   328	            return value
   329	        return None
   330	    if not body or not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
   331	        return None
   332	    try:
   333	        return [int(part.strip()) for part in body.split(",")]
   334	    except ValueError:
   335	        return None
   336	
   337	
   338	def parse_answer(text: str) -> object | None:
   339	    """Extract the advertised integer list from tags, fences, or nearby prose."""
   340	    if not isinstance(text, str):
   341	        return None
   342	    bodies = list(reversed(_ANSWER_RE.findall(text)))
   343	    bodies.extend(reversed(_FENCE_RE.findall(text)))
   344	    for body in bodies:
   345	        parsed = _parse_int_list(body)
   346	        if parsed is not None:
   347	            return parsed
   348	    # Tolerate a bare JSON list embedded in a final sentence.
   349	    decoder = json.JSONDecoder()
   350	    for start in (i for i, char in enumerate(text) if char == "["):
   351	        try:
   352	            value, _ = decoder.raw_decode(text[start:])
   353	        except (TypeError, ValueError):
   354	            continue
   355	        if (isinstance(value, list) and
   356	                all(isinstance(v, int) and not isinstance(v, bool) for v in value)):
   357	            return value
   358	    return None
