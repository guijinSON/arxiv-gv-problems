        composed = _scale_instance(original, multiplier, reverse_survivors=True)
        invariance_checks += 1
        witness_checks += 1
        if canonical_key(composed) != key:
            g8_failures.append({"seed": offset, "transform": "scaling plus reorder"})
        if not verify(composed, composed["answer"])[0]:
