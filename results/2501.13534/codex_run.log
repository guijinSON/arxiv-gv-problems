+        "distinct_reasons": len(set(reasons)),
+    }
+
+    # G3: realistic prose, Markdown, whitespace, tags, and compact JSON.
+    encoded_answer = json.dumps(original, separators=(",", ":"))
+    realistic = (
+        "I computed the missing moments and factored the locator.\n```json\n"
+        f"<answer>\n{encoded_answer}\n</answer>\n```\n"
+        "The coefficients are highest-degree first."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == original and verify(ship, parsed)[0],
+        "parsed_matches": parsed == original,
+        "realistic_wrapper": True,
+    }
+
+    # G4: uniform t-subset completions outside the received set.
+    sample_count = 200_000
+    guess_rng = random.Random(0x250113534)
