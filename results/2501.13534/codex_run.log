+def _poly_gcd(a, b, p, counter):
+    a = _poly_trim(a, p)
+    b = _poly_trim(b, p)
+    while b != [0]:
+        _, remainder = _poly_divmod(a, b, p, counter)
+        a, b = b, remainder
+    return _poly_monic(a, p, counter)
