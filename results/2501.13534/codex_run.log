+"""Verified Track-B VT-syndrome deletion instances from arXiv:2501.13534.
+
+The solver receives the syndrome of a constant-weight set-code word and the
+set left after deletions.  It returns the deleted symbols together with their
+error-locator polynomial.  Instances are inverse-generated from reflection
+orbits, so the certificate is known before the public syndrome is formed.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
