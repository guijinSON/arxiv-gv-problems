+    statement = f"""VT-syndrome set-code deletion recovery
+
+The alphabet is Sigma_q = {{0,1,...,{inst['q'] - 1}}}.  All syndrome arithmetic
+is in the prime field GF({inst['p']}), meaning integers are reduced modulo
+{inst['p']}.  A transmitted codeword is a SET A of exactly n={inst['n']}
+distinct alphabet symbols.  Its order-t VT syndrome is the vector (a_1,...,
+a_t), where
+
+    a_k = sum_(x in A) x^k mod {inst['p']}   for k=1,...,{t}.
+
+Exactly t={t} symbols were deleted.  The received set B therefore contains
+exactly {inst['n'] - t} distinct symbols and is listed below.  Line breaks and
+the displayed order carry no information; repeats are not allowed.
+
+Full transmitted syndrome a_1,...,a_{t}:
+  {' '.join(str(value) for value in inst['syndrome'])}
+
+Received set B:
+{_wrapped(inst['received'])}
+
+Recover the deleted set D=A\\B.  Also give its monic error-locator polynomial
+
+    L(z) = product_(d in D) (z-d)  in GF({inst['p']})[z].
+
+Your answer must be one JSON object with exactly two keys.  "deleted" is the
+strictly increasing list of exactly {t} distinct integers in [0,{inst['q'] - 1}];
+none may occur in B.  "locator" is a list of exactly {t + 1} canonical residues
+in [0,{inst['p'] - 1}], ordered from the coefficient of z^{t} down to the
+constant coefficient.  Its first entry must be 1.  The two lists must describe
+the same deleted set.  Any set satisfying these requirements and all syndrome
+equations is accepted.
+
+Give your final answer inside <answer></answer> tags, as compact JSON.
+Syntax example only: <answer>{example}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the last tagged JSON object, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```") and body.endswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any exact missing-set/locator witness without the planted answer."""
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer object is empty"
+    if set(answer) != {"deleted", "locator"}:
+        return False, "answer must have exactly the keys deleted and locator"
+    deleted = answer["deleted"]
+    locator = answer["locator"]
+    if not isinstance(deleted, list) or not isinstance(locator, list):
+        return False, "deleted and locator must both be JSON lists"
+    t, q, p = inst["t"], inst["q"], inst["p"]
+    if len(deleted) != t:
+        return False, f"wrong deleted count: expected {t}, got {len(deleted)}"
+    if any(isinstance(value, bool) or not isinstance(value, int) for value in deleted):
+        return False, "every deleted symbol must be an integer"
+    if any(value < 0 or value >= q for value in deleted):
+        return False, f"deleted symbol outside alphabet [0,{q - 1}]"
+    if len(set(deleted)) != len(deleted):
+        return False, "deleted symbols are not distinct"
+    if deleted != sorted(deleted):
+        return False, "deleted symbols are not strictly increasing"
+    received = set(inst["received"])
+    if any(value in received for value in deleted):
+        return False, "a deleted symbol is already in the received set"
+    if len(locator) != t + 1:
+        return False, f"wrong locator length: expected {t + 1}, got {len(locator)}"
+    if any(isinstance(value, bool) or not isinstance(value, int) for value in locator):
+        return False, "every locator coefficient must be an integer"
+    if any(value < 0 or value >= p for value in locator):
+        return False, f"locator coefficient outside canonical range [0,{p - 1}]"
+    if locator[0] != 1:
+        return False, "locator polynomial is not monic"
+    expected_locator = _locator_from_roots(deleted, p)
+    if locator != expected_locator:
+        return False, "locator polynomial does not equal the product over deleted roots"
+    moments = _power_sums(deleted, t, p)
+    for k, (actual, target) in enumerate(zip(moments, inst["erased_syndrome"]), 1):
+        if actual != target:
+            return False, f"VT power-sum equation k={k} is violated"
+    if len(received | set(deleted)) != inst["n"]:
+        return False, "reconstructed transmitted set has wrong cardinality"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniform completion of the stated size, disjointness, and order shape."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    forbidden = set(inst["received"])
+    chosen: set[int] = set()
+    while len(chosen) < inst["t"]:
+        value = rng.randrange(inst["q"])
+        if value not in forbidden:
+            chosen.add(value)
+    return _certificate(sorted(chosen), inst["p"])
+
+
+def search_space(inst: dict) -> int | None:
+    """All t-subset completions outside B; the locator is then determined."""
+    return math.comb(inst["q"] - len(inst["received"]), inst["t"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Brute-force the exact certificate language when safely below the cap."""
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    received = set(inst["received"])
+    available = [value for value in range(inst["q"]) if value not in received]
+    count = 0
+    for roots in itertools.combinations(available, inst["t"]):
+        count += int(verify(inst, _certificate(list(roots), inst["p"]))[0])
+    return count
+
+
+def _transform_moments(moments: list[int], count: int,
+                       intercept: int, p: int) -> list[int]:
+    """Moments after x -> intercept-x, using only public moments."""
+    source = [count % p] + list(moments)
+    transformed = []
+    for k in range(1, len(source)):
+        total = 0
+        for j in range(k + 1):
+            term = math.comb(k, j) * pow(intercept, k - j, p) * source[j]
+            total += -term if j % 2 else term
+        transformed.append(total % p)
+    return transformed
+
+
+def _reflect_instance(inst: dict) -> dict:
+    """Apply the alphabet involution x -> q-1-x and carry the witness."""
+    moved = dict(inst)
+    h = inst["q"] - 1
+    moved["received"] = [h - value for value in inst["received"]]
+    moved["syndrome"] = _transform_moments(
+        inst["syndrome"], inst["n"], h, inst["p"]
+    )
+    moved["erased_syndrome"] = _transform_moments(
+        inst["erased_syndrome"], inst["t"], h, inst["p"]
+    )
+    moved["answer"] = _certificate(
+        [h - value for value in inst["answer"]["deleted"]], inst["p"]
+    )
+    return moved
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonical under received-set order and whole-alphabet reflection."""
+    base = [
+        inst["n"], inst["q"], inst["p"], inst["t"],
+        sorted(inst["received"]), list(inst["syndrome"]),
+    ]
+    reflected = _reflect_instance(inst)
+    mirror = [
+        reflected["n"], reflected["q"], reflected["p"], reflected["t"],
+        sorted(reflected["received"]), list(reflected["syndrome"]),
+    ]
+    encoded = min(
+        json.dumps(base, separators=(",", ":")),
+        json.dumps(mirror, separators=(",", ":")),
+    )
+    return hashlib.sha256(encoded.encode()).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow alphabet crowding first, at fixed answer and received-set lengths."""
+    if not isinstance(params, dict) or not {"n", "q", "t"} <= set(params):
+        return None
+    n, q, t = params["n"], params["q"], params["t"]
+    if not all(isinstance(value, int) and not isinstance(value, bool)
+               for value in (n, q, t)):
+        return None
+    if q < 16_000_000:
+        return {"n": n, "q": 2 * q, "t": t}
+    # A few more complete pairs increase the no-tool matching burden while the
+    # answer remains fixed.  Stop before the compact arithmetic cap is crossed.
+    if n + 8 - t + 60 <= 300:
+        return {"n": n + 8, "q": q, "t": t}
+    return "cap_bound"
+
+
+def _newton_locator(power_sums: list[int], p: int) -> tuple[list[int], int]:
+    """Recover a monic locator from power sums; return field-op count."""
+    t = len(power_sums)
+    elementary = [1]
+    operations = 0
+    for k in range(1, t + 1):
+        total = 0
+        for i in range(1, k + 1):
+            term = elementary[k - i] * power_sums[i - 1] % p
+            operations += 1
+            if i % 2:
+                total = (total + term) % p
+            else:
+                total = (total - term) % p
+            operations += 1
+        elementary.append(total * pow(k, -1, p) % p)
+        operations += 1
+    coefficients = [1]
+    for k in range(1, t + 1):
+        coefficients.append(elementary[k] if k % 2 == 0 else (-elementary[k]) % p)
+    return coefficients, operations
+
+
+def _reference_decode(inst: dict) -> tuple[dict | None, int, int]:
+    """Newton identities plus Chien root scan, the generic VT route."""
+    t, p = inst["t"], inst["p"]
+    received_sums = [0] * t
+    operations = 0
+    for value in inst["received"]:
+        power = value % p
+        for k in range(t):
+            received_sums[k] = (received_sums[k] + power) % p
+            operations += 1
+            if k + 1 < t:
+                power = power * value % p
+                operations += 1
+    missing_sums = []
+    for full, kept in zip(inst["syndrome"], received_sums):
+        missing_sums.append((full - kept) % p)
+        operations += 1
+    locator, newton_ops = _newton_locator(missing_sums, p)
+    operations += newton_ops
+    roots = []
+    tested = 0
+    for value in range(inst["q"]):
+        evaluation = locator[0]
+        for coefficient in locator[1:]:
+            evaluation = (evaluation * value + coefficient) % p
+            operations += 2
+        tested += 1
+        if evaluation == 0:
+            roots.append(value)
+            if len(roots) == t:
+                break
+    if len(roots) != t:
+        return None, operations, tested
+    return _certificate(roots, p), operations, tested
+
+
+def _inverse_with_operation_count(value: int, p: int) -> tuple[int, int]:
+    """Extended Euclid, counting division/multiply/subtract updates."""
+    old_r, r = p, value
+    old_s, s = 0, 1
+    operations = 0
+    while r:
+        quotient = old_r // r
+        operations += 1
+        old_r, r = r, old_r - quotient * r
+        operations += 2
+        old_s, s = s, old_s - quotient * s
+        operations += 2
+    if old_r != 1:
+        raise ValueError("value has no inverse modulo p")
+    return old_s % p, operations
+
+
+def _compact_reflection_decode(inst: dict) -> tuple[dict | None, int]:
+    inverse, operations = _inverse_with_operation_count(inst["n"], inst["p"])
+    center = inst["syndrome"][0] * inverse % inst["p"]
+    twice_center = 2 * center % inst["p"]
+    operations += 2
+    received = set(inst["received"])
+    deleted = []
+    for value in inst["received"]:
+        mate = (twice_center - value) % inst["p"]
+        operations += 1
+        if mate not in received:
+            deleted.append(mate)
+    if len(set(deleted)) != inst["t"]:
+        return None, operations
+    candidate = _certificate(deleted, inst["p"])
+    return candidate, operations
+
+
+def _available_extremes(inst: dict) -> dict:
+    forbidden = set(inst["received"])
+    roots = []
+    left, right = 0, inst["q"] - 1
+    while len(roots) < inst["t"]:
+        if left not in forbidden:
+            roots.append(left)
+        if len(roots) < inst["t"] and right not in forbidden:
+            roots.append(right)
+        left += 1
+        right -= 1
+    return _certificate(roots, inst["p"])
+
+
+def _largest_gap_attack(inst: dict) -> dict:
+    forbidden = set(inst["received"])
+    ordered = sorted(forbidden)
+    gaps = sorted(
+        ((ordered[i + 1] - ordered[i], ordered[i], ordered[i + 1])
+         for i in range(len(ordered) - 1)),
+        reverse=True,
+    )
+    roots = []
+    for _, left, right in gaps:
+        value = (left + right) // 2
+        while value in forbidden or value in roots:
+            value += 1
+            if value >= right:
+                value = left + 1
+                break
+        if 0 <= value < inst["q"] and value not in forbidden and value not in roots:
+            roots.append(value)
+        if len(roots) == inst["t"]:
+            break
+    if len(roots) < inst["t"]:
+        return _available_extremes(inst)
+    return _certificate(roots, inst["p"])
+
+
+def _first_moment_greedy(inst: dict) -> dict:
+    """Meet the missing first moment with a cluster near its modular mean."""
+    p, q, t = inst["p"], inst["q"], inst["t"]
+    forbidden = set(inst["received"])
+    target = inst["erased_syndrome"][0]
+    mean = target * pow(t, -1, p) % p
+    for spread in range(1, 100):
+        trial = []
+        for delta in range(-(t // 2), t // 2 + 1):
+            value = (mean + spread * delta) % p
+            if value < q and value not in forbidden and value not in trial:
+                trial.append(value)
+            if len(trial) == t - 1:
+                break
+        if len(trial) != t - 1:
+            continue
+        last = (target - sum(trial)) % p
+        if last < q and last not in forbidden and last not in trial:
+            return _certificate(trial + [last], p)
+    return _available_extremes(inst)
+
+
+def _centered_ansatz(inst: dict) -> dict:
+    p, q, t = inst["p"], inst["q"], inst["t"]
+    forbidden = set(inst["received"])
+    target = inst["erased_syndrome"][0]
+    mean = target * pow(t, -1, p) % p
+    roots = []
+    radius = 1
+    while len(roots) < t and radius < q:
+        for value in ((mean - radius) % p, (mean + radius) % p):
+            if value < q and value not in forbidden and value not in roots:
+                roots.append(value)
+                if len(roots) == t:
+                    break
+        radius += 1
+    return _certificate(roots, p) if len(roots) == t else _available_extremes(inst)
+
+
+def _random_restart(inst: dict, rng: random.Random,
+                    restarts: int = 256) -> tuple[bool, int]:
+    for attempt in range(1, restarts + 1):
+        if verify(inst, random_candidate(inst, rng))[0]:
+            return True, attempt
+    return False, restarts
