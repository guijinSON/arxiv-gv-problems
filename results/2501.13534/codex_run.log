+    """Extract the advertised integer list from tags, fences, or nearby prose."""
+    if not isinstance(text, str):
+        return None
+    bodies = list(reversed(_ANSWER_RE.findall(text)))
+    bodies.extend(reversed(_FENCE_RE.findall(text)))
