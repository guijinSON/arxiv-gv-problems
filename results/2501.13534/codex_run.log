+
+def _transform_moments(moments: list[int], count: int,
+                       intercept: int, p: int) -> list[int]:
+    """Moments after x -> intercept-x, using only public moments."""
+    source = [count % p] + list(moments)
+    transformed = []
+    for k in range(1, len(source)):
+        total = 0
+        for j in range(k + 1):
+            term = math.comb(k, j) * pow(intercept, k - j, p) * source[j]
+            total += -term if j % 2 else term
+        transformed.append(total % p)
+    return transformed
+
+
+def _reflect_instance(inst: dict) -> dict:
+    """Apply the alphabet involution x -> q-1-x and carry the witness."""
+    moved = dict(inst)
+    h = inst["q"] - 1
+    moved["received"] = [h - value for value in inst["received"]]
+    moved["syndrome"] = _transform_moments(
+        inst["syndrome"], inst["n"], inst["q"] + 1, inst["p"]
+    )
+    moved["erased_syndrome"] = _transform_moments(
+        inst["erased_syndrome"], inst["t"], inst["q"] + 1, inst["p"]
+    )
+    moved["answer"] = _certificate(
+        [h - value for value in inst["answer"]["deleted"]], inst["p"]
+    )
+    return moved
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonical under received-set order and whole-alphabet reflection."""
+    base = [
+        inst["n"], inst["q"], inst["p"], inst["t"],
+        sorted(inst["received"]), list(inst["syndrome"]),
+    ]
+    reflected = _reflect_instance(inst)
+    mirror = [
+        reflected["n"], reflected["q"], reflected["p"], reflected["t"],
+        sorted(reflected["received"]), list(reflected["syndrome"]),
+    ]
+    encoded = min(
+        json.dumps(base, separators=(",", ":")),
+        json.dumps(mirror, separators=(",", ":")),
+    )
+    return hashlib.sha256(encoded.encode()).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow alphabet crowding first, at fixed answer and received-set lengths."""
+    if not isinstance(params, dict) or not {"n", "q", "t"} <= set(params):
+        return None
+    n, q, t = params["n"], params["q"], params["t"]
+    if not all(isinstance(value, int) and not isinstance(value, bool)
+               for value in (n, q, t)):
+        return None
+    if q < 16_000_000:
+        return {"n": n, "q": 2 * q, "t": t}
+    # A few more complete pairs increase the no-tool matching burden while the
+    # answer remains fixed.  Stop before the compact arithmetic cap is crossed.
+    if n + 8 - t + 60 <= 300:
+        return {"n": n + 8, "q": q, "t": t}
+    return "cap_bound"
+
