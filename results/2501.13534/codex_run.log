+def _poly_powmod(base, exponent, modulus, p, counter):
+    result = [1]
+    base = _poly_trim(base, p)
+    while exponent:
+        if exponent & 1:
+            result = _poly_mulmod(result, base, modulus, p, counter)
+        exponent >>= 1
+        if exponent:
+            base = _poly_mulmod(base, base, modulus, p, counter)
+    return result
 
 
