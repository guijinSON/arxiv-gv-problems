+    poly = _poly_monic(poly, p, counter)
+    degree = len(poly) - 1
+    if degree == 0:
+        return []
+    if degree == 1:
+        counter["operations"] += 2
+        return [(-poly[0] * pow(poly[1], -1, p)) % p]
+    for _ in range(128):
+        counter["iterations"] += 1
+        probe = [rng.randrange(p) for _ in range(degree)]
