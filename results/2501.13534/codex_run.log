+
+    # G6: failing no-tool attacks and the separately successful Track-B decoder.
+    attack_names = (
+        "outlier_alphabet_extremes",
+        "largest_received_gap",
+        "first_moment_greedy",
+        "random_restart_256",
+        "centered_consecutive_ansatz",
