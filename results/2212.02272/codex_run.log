+def _attack_random_restart(inst: dict, attack_seed: int,
+                           restarts: int = 4096) -> list[int] | None:
+    rng = random.Random(attack_seed)
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate
