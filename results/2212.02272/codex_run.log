+    attack_results = {
+        "outlier_minimum_degree": {"successes": 0, "attempts": 0},
+        "greedy_smallest_label": {"successes": 0, "attempts": 0},
+        "random_restart_4096": {"successes": 0, "attempts": 0},
+        "single_congruence_ansatz": {"successes": 0, "attempts": 0},
