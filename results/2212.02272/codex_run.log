+def _quotient_has_induced_p6() -> bool:
+    """Exhaust the bag patterns of a hypothetical induced six-vertex path."""
+    for code in range(5 ** 6):
+        value = code
+        bags = []
+        for _ in range(6):
+            bags.append(value % 5)
+            value //= 5
+        valid = True
+        for i in range(6):
+            for j in range(i + 1, 6):
+                adjacent = (bags[i] - bags[j]) % 5 in (1, 4)
+                if adjacent != (j == i + 1):
+                    valid = False
+                    break
+            if not valid:
+                break
+        if valid:
+            return True
+    return False
