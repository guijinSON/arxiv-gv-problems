+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "succinctly represented oriented graph",
+        "five independent vertex bags forming a blow-up of C5",
