+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 2, "mask_pairs": 0},
+    "easy": {"n": 155, "mask_pairs": 20},
+    "medium": {"n": 179, "mask_pairs": 22},
+    "hard": {"n": 203, "mask_pairs": 24},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
