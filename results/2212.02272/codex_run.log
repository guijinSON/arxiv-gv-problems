+
+def _rule_text(index: int, rule: dict[str, Any]) -> str:
+    if rule["kind"] == "constant":
+        base = "true" if rule["value"] else "false"
+    else:
+        base = (
+            f"r mod {rule['modulus']} = {rule['residue']}"
+        )
+    if rule.get("polarity", 1) == -1:
+        base = f"NOT ({base})"
+    return f"T_{index}(r) is {base}."
+
