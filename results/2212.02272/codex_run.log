+        "shipping_candidate_count": search_space(probe),
+        "doubled_candidate_count": search_space(doubled),
+        "answer_atoms_before": _answer_atoms(probe["answer"]),
+        "answer_atoms_after": _answer_atoms(doubled["answer"]),
