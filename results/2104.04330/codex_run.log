+def _attack_random_restart(inst: dict, rng: random.Random, restarts: int = 96) -> list[int]:
+    """Randomized greedy with a mild induced-degree heuristic."""
+    rows = inst["rows"]
+    n = inst["n"]
+    k = inst["k"]
