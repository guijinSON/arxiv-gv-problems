+        "swap_one": swap_bad,
+        "duplicate": planted[:-1] + [planted[0]],
+        "empty": None,
+        "out_of_range": planted[:-1] + [inst["n"]],
+    }
+    corruption_reasons = {}
+    corruption_failures = []
+    for name, candidate in corruptions.items():
