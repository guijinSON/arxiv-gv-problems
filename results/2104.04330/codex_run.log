+def _triangle_scores(rows: list[str]) -> list[int]:
+    masks = _rows_to_masks(rows)
+    scores = []
+    for i, row in enumerate(rows):
+        score_twice = 0
+        bits = masks[i]
+        while bits:
+            low = bits & -bits
+            j = low.bit_length() - 1
