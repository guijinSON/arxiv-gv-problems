+        for old_j in range(n):
+            if rows[old_i][old_j] == "1":
+                matrix[new_i][old_to_new[old_j]] = 49
+    return {
+        "n": n,
+        "k": inst["k"],
+        "margin_tenths": inst.get("margin_tenths", 25),
+        "rows": [row.decode("ascii") for row in matrix],
+        "answer": sorted(old_to_new[v] for v in inst["answer"]),
+    }
+
