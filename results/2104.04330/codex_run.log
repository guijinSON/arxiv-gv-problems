+def _triangle_scores(rows: list[str]) -> list[int]:
+    masks = _rows_to_masks(rows)
+    scores = []
+    for i, row in enumerate(rows):
+        score_twice = 0
+        bits = masks[i]
+        while bits:
+            low = bits & -bits
+            j = low.bit_length() - 1
+            score_twice += (masks[i] & masks[j]).bit_count()
+            bits ^= low
+        scores.append(score_twice // 2)
+    return scores
