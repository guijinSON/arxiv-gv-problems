+    "easy": {"n": 196, "margin_tenths": 25},
+    "medium": {"n": 324, "margin_tenths": 25},
+    "hard": {"n": 484, "margin_tenths": 25},
+}
+
+SHIPPING_DIFFICULTY = "easy"
