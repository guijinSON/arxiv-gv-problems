+    for i in range(n):
+        for j in range(i + 1, n):
+            edge = block_of[i] == block_of[j] or bool(rng.getrandbits(1))
+            if edge:
+                matrix[i][j] = 49  # ord("1")
+                matrix[j][i] = 49
