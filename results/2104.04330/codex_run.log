--- /dev/null
+++ b/selftest_report.json
@@ -0,0 +1,102 @@
+{
+  "G1_planted_verifies": {
+    "failures": [],
+    "pass": true,
+    "trials": 9,
+    "verified": 9
+  },
+  "G2_rejects_corruption": {
+    "distinct_reasons": 5,
+    "pass": true,
+    "reasons": {
+      "drop_one": "wrong number of indices: expected 18, got 17",
