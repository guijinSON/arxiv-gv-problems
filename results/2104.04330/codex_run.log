+    report["G5_sparse"] = {
+        "pass": enum_count is not None and enum_count >= 1 and enum_fraction < 1e-3,
+        "n": enum_inst["n"],
+        "k": enum_inst["k"],
+        "valid_answers": enum_count,
+        "search_space": enum_space,
+        "solution_fraction": enum_fraction,
+        "shipping_enumeration": enumerate_all(inst),
