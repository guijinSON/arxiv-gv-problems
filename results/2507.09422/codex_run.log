+
+def _dense_add(a, b):
+    out = [Fraction(0)] * max(len(a), len(b))
+    for i in range(len(a)):
+        out[i] += a[i]
+    for i in range(len(b)):
+        out[i] += b[i]
+    return _dense_normalize(out)
