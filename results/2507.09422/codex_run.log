+                slope = Fraction(-1, scale)
+            else:
+                constant = Fraction(shift, scale)
+                slope = Fraction(1, scale)
+            poly = _affine_variable(poly, player, constant, slope)
+        poly = _integer_normalize(poly)
+        owner = role_to_player[role]
+        if flips[owner]:
