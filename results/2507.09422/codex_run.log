+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "Exactly n distinct degree-at-most-five polynomials R(z), each encoded by "
+        "six integer coefficients [c0,...,c5] as c0/7812500 + sum_{k=1}^5 "
