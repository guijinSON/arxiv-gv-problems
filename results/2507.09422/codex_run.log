+    # Every monomial is in [0,1].  Replacing every negative monomial by 1 and
+    # every positive monomial by 0 gives a valid global lower bound.
+    mask[frozenset()] = negative_mass + rng.randint(1, MASK_COEFF_BOUND)
+    return mask
