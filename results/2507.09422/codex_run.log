+def _divide_positive_factor(poly, var, constant, slope, counter):
+    without = {}
+    with_var = {}
+    for monomial, coeff in poly.items():
+        if var in monomial:
+            rest = frozenset(v for v in monomial if v != var)
+            with_var[rest] = coeff
+        else:
+            without[monomial] = coeff
+    keys = set(without) | set(with_var)
+    for monomial in keys:
+        counter[0] += 2
+        if slope * without.get(monomial, 0) != constant * with_var.get(monomial, 0):
+            return None
+    quotient = {}
+    for monomial, coeff in with_var.items():
+        if coeff % slope:
+            return None
+        quotient[monomial] = coeff // slope
+    return _clean(quotient)
