+        (left for left in left_subsets if poly.get(left, 0) != 0), None
+    )
+    if pivot_left is None:
+        return None
+    pivot = Fraction(poly[pivot_left])
+    left_factor = {
+        left: Fraction(poly.get(left, 0))
+        for left in left_subsets if poly.get(left, 0) != 0
