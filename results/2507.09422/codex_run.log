+        term_count,
+        math.log1p(absolute_sum / maximum),
+        math.log1p(abs(signed_sum) / maximum),
+        math.log1p(abs(constant) / maximum),
+        1 if signed_sum > 0 else (-1 if signed_sum < 0 else 0),
+        1 if constant > 0 else (-1 if constant < 0 else 0),
+    )
 
 
