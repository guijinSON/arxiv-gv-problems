+# z = x_4 - 8/25.  Appendix A isolates x_4 in
+# (0.320065197644, 0.320065197645), hence z lies in this interval.
+PRIMITIVE_POLY = [
+    434, -6665425, 134165625, -1061484375,
+    3919921875, -1679687500, 244140625,
+]
