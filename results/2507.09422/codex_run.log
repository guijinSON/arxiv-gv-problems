+_MOD_INV_D1 = pow(D1, MOD_PRIME - 2, MOD_PRIME)
+_SCREEN_INV_D0 = pow(D0, SCREEN_PRIME - 2, SCREEN_PRIME)
+_SCREEN_INV_D1 = pow(D1, SCREEN_PRIME - 2, SCREEN_PRIME)
