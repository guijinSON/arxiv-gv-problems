+            result.append(_poly_to_json(poly))
+        out[key] = result
+    selector = []
+    for player, digit in enumerate(inst["answer"]["selector"]):
+        value = SELECTOR_ALPHABET.index(digit)
+        if swap_flags[player]:
+            value ^= 1
+        selector.append(SELECTOR_ALPHABET[value])
+    out["answer"] = {
+        "values": [list(v) for v in inst["answer"]["values"]],
+        "selector": "".join(selector),
