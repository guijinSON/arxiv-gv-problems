+            for role, poly in enumerate(_transform_base(list(range(4)), flips, scale)):
+                value = tuple(_scaled_value(scale, role, flips[role]))
+                templates.setdefault(value, []).append(_coefficient_feature(poly))
+
+    player_options = []
+    n = inst["n"]
