+def _scaled_value(scale, role, flipped=False):
+    base = CORE_VALUES[2 * role]
+    vector = [(scale * base[0]) % D0] + [scale * c for c in base[1:]]
+    if flipped:
+        vector = [D0 - vector[0]] + [-c for c in vector[1:]]
+    return vector
