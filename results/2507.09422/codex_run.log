+def escalate(params):
+    """First thicken positive masks at fixed answer length, then add more blocks."""
+    out = {k: v for k, v in params.items() if k != "_preset"}
+    n = out["n"]
+    width = out["mask_width"]
+    if width < min(7, n - 4):
+        out["mask_width"] = width + 1
+        return out
+    if n + 4 > 36:
