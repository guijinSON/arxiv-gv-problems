+        PROBLEM_PROFILE["intuition_type"] + ": " +
+        PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 4, "mask_width": 0, "value_slots": 4},
+    "easy": {"n": 12, "mask_width": 2, "value_slots": 12},
+    "medium": {"n": 16, "mask_width": 3, "value_slots": 16},
+    "hard": {"n": 20, "mask_width": 4, "value_slots": 20},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The zero sets are governed by the factors whose signs can vary on the unit "
+    "probability cube."
+)
+PLACEBO_HINT = (
+    "The coefficient order and one-based player labels require consistent exact "
