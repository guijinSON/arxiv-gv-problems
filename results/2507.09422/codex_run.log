+def _constant_value(vector):
+    return Fraction(vector[0], D0)
+
+
+def _eval_multilinear_rational(poly, values):
+    total = Fraction(0)
+    for monomial, coeff in poly.items():
+        term = Fraction(coeff)
+        for variable in monomial:
+            term *= values[variable]
+        total += term
+    return total
