+    negative_mass = 0
+    for bits in range(1, 1 << len(variables)):
+        coefficient = 0
+        while coefficient == 0:
+            coefficient = rng.randint(-MASK_COEFF_BOUND, MASK_COEFF_BOUND)
+        monomial = frozenset(
+            variables[index]
+            for index in range(len(variables))
+            if (bits >> index) & 1
