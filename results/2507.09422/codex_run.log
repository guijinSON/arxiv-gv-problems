+def _reference_algorithm(inst):
+    """Strip masks, then try 11 scales and all 384 role/action symmetries."""
+    n = inst["n"]
+    full = [_poly_from_json(poly, n) for poly in inst["equations"]]
+    counter = [0]
+    stripped = []
+    for owner, original in enumerate(full):
+        poly = dict(original)
+        changed = True
+        while changed:
+            changed = False
+            for var in range(n):
+                if var == owner:
+                    continue
+                for constant, slope in ((2, 1), (3, -1)):
+                    quotient = _divide_positive_factor(
+                        poly, var, constant, slope, counter
+                    )
+                    if quotient is not None:
+                        poly = quotient
+                        changed = True
+                        break
+                if changed:
+                    break
+        stripped.append(poly)
+
+    adjacency = [set() for _ in range(n)]
+    for owner, poly in enumerate(stripped):
+        support = set().union(*poly.keys()) if poly else set()
+        for var in support:
+            adjacency[owner].add(var)
+            adjacency[var].add(owner)
+    components = []
+    unseen = set(range(n))
+    while unseen:
+        start = min(unseen)
