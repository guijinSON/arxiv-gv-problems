+        for name in attack_names
+    }
+    reference = {
+        "name": "exact positive-factor stripping plus exhaustive G4 symmetry matching",
+        "complexity": "O(n^2*T + 384*n) exact coefficient probes for T displayed terms",
+        "wall_clock_sec": round(reference_wall / attack_attempts, 6),
+        "operations": max(reference_operations),
