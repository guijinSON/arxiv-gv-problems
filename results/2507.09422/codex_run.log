+def _attack_greedy(inst):
+    n = inst["n"]
+    slots = inst["value_slots"]
+    base_values = [_constant_value(v) for v in _planted_value_list(slots)]
+    selector = [i % slots for i in range(n)]
+    core = [_poly_from_json(poly, n) for poly in inst["_core_equations"]]
+    for _ in range(2):
+        current = [base_values[s] for s in selector]
+        for player in range(n):
+            best = None
+            # A player's own F_i omits y_i, so greedily choose the value that
+            # minimizes the residuals of equations in which that player occurs.
+            for slot in range(slots):
+                current[player] = base_values[slot]
+                score = sum(
+                    abs(_eval_multilinear_rational(core[j], current))
+                    for j in range(n) if j != player and
+                    any(player in monomial for monomial in core[j])
+                )
+                choice = (score, slot)
+                if best is None or choice < best:
+                    best = choice
+            selector[player] = best[1]
+            current[player] = base_values[best[1]]
+    return _candidate_with_selector(inst, selector)
