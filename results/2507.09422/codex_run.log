def stat(poly,dmin):
 p={m:c for m,c in poly.items() if len(m)>=dmin}
 return (tuple(sorted((len(m),c) for m,c in p.items())), len(p),max(map(abs,p.values())),sum(map(abs,p.values())),sum(p.values())) if p else None
# Compare current full polynomials to all core candidates after multiplying by 2 masks over abstract vars.
# Just report whether high-degree scalar summaries map uniquely to planted value after allowing mask signs/constants.
for dmin in (2,3,4):
 mp={}
 # enumerate exact generated current equation over fixed core vars and two mask vars 4,5
 for scale in g.SCALE_CHOICES:
