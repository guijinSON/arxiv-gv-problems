   441	\section{Three players}\label{sec:3}
   442	
   443	Define the $2\times2\times2$ game $G_3$:
   444	\begin{figure}[H]
   445	\centering
   446	\begin{align*}
   447	  \left[\begin{array}{ccc|ccc}
   448	    0&0&0&0&0&2\\
   449	    0&0&1&1&0&0\\
   450	    0&1&0&0&1&0\\
   451	    0&1&1&0&0&1\\
   452	    1&0&0&0&0&0\\
   453	    1&0&1&0&1&1\\
   454	    1&1&0&1&1&0\\
   455	    1&1&1&1&0&1
   456	  \end{array}\right]
   457	\end{align*}
   458	\caption{The game $G_3$}
   459	\label{fig:G3}
   460	\end{figure}
   461	
   462	\begin{proposition}\label{prop:n=3}
   463	  $G_3$ has a unique NE $((x_1,1-x_1),(x_2,1-x_2),(x_3,1-x_3))$ given by
   464	  \begin{align*}
   465	    x_1=\frac{7-\sqrt{13}}{6},~x_2=\frac{7+\sqrt{13}}{18},~x_3=\frac{-3+\sqrt{13}}{2}.
   466	  \end{align*}
   467	  The probabilities in the NE are all irrational.
   468	\end{proposition}
   469	
   470	\begin{proof}
   471	  First observe that $\PNE(G_3)=\emptyset$ using this table of profitable deviations:
   472	  \begin{align*}
   473	    \begin{array}{|c|c|}
   474	      \hline
   475	      \text{action profile}&\text{unsatisfied players}\\
   476	      \hline
   477	      (0,0,0)&2\\
   478	      (0,0,1)&3\\
   479	      (0,1,0)&1,3\\
   480	      (0,1,1)&1\\
   481	      (1,0,0)&2,3\\
   482	      (1,0,1)&1\\
   483	      (1,1,0)&3\\
   484	      (1,1,1)&2\\
   485	      \hline
   486	    \end{array}
   487	  \end{align*}
   488	  
   489	  Now the polynomials $f_1,f_2,f_3$ from Equation~\ref{eq:polys} are
   490	  \begin{align*}
   491	    f_1(x_2,x_3)&=-x_2x_3+2x_2-1,~f_2(x_1,x_3)=x_1x_3-x_1-2x_3+1,\\
   492	    f_3(x_1,x_2)&=3x_1x_2-1.
   493	  \end{align*}
   494	
   495	  We show using Lemma \ref{lmm:ne-poly-cond} that if $x_i\in\s{0,1}$ for some $i$ then 
   496	  $x\notin\NE(G_3)$. There are 6 cases.
   497	
   498	  \paragraph{Case 1: $x_1=0$} then $f_2=-2x_3+1,~f_3=-1<0$, so $x_3=0$ so $f_2=1>0$ so 
   499	  $x_2=1$. Therefore $x=(0,1,0)\notin\NE(G_3)$.
   500	  
   501	  \paragraph{Case 2: $x_1=1$} then $f_2=-x_3,~f_3=3x_2-1$.
   502	  If $x_3>0$ then $f_2<0$ so $x_2=0$ so $f_3=-1<0$ so $x_3=0$ -- a contradiction. Therefore 
   503	  $x_3=0$, so $f_3\le0$ so $x_2\le\frac{1}{3}$ so $f_1\le-\frac{1}{3}<0$ so $x_1=0$ -- a 
   504	  contradiction.
   505	
   506	  \paragraph{Case 3: $x_2=0$} then $f_1=-1$ so $x_1=0$ so by case 1 $x\notin\NE(G_3)$.
   507	
   508	  \paragraph{Case 4: $x_2=1$} then $f_1=-x_3+1,~f_3=3x_1-1$. By cases 1 and 2, 
   509	  $x_1\in(0,1)$ so $f_1=0$ so $x_3=1$ so $f_2=-1<0$ so $x_2=0$ -- a contradiction.  
   510	  Therefore $x\notin\NE(G_3)$.
   511	
   512	  \paragraph{Case 5: $x_3=0$} then $f_2=-x_1+1$. By cases 3 and 4, $x_2\in(0,1)$ so 
   513	  $f_2=0$ so $-x_1+1=0$ so $x_1=1$ so by case 2 we conclude that $x\notin\NE(G_3)$.
   514	
   515	  \paragraph{Case 6: $x_3=1$} then $f_1=x_2-1$. Again $0=f_1=x_2-1$ so $x_2=1$, so by case 
   516	  4 we conclude that $x\notin\NE(G_3)$.
   517	
   518	  \bigskip
   519	
   520	  Therefore the only NEs are fully mixed. This means that $x\in\NE(G_3)$ satisfies 
   521	  $f_i(x)=0$ for every $i$. By $f_3$ we have $x_1=\frac{1}{3x_2}$.
   522	  Then by $f_2$ we have $\frac{x_3}{3x_2}-\frac{1}{3x_2}-2x_3+1=0$ so $(6x_3-3)x_2=x_3-1$.  
   523	  $x_3\ne\frac{1}{2}$ because $x_3\ne1$ so $x_2=\frac{x_3-1}{6x_3-3}$.
   524	  Then by $f_1$ we have $\frac{(x_3-1)(2-x_3)}{6x_3-3}=1$ so $-x_3^2+3x_3-2=6x_3-3$ so 
   525	  $x_3^2+3x_3-1=0$ so because $x_3>0$ we get $x_3=\frac{-3+\sqrt{13}}{2}$, 
   526	  $x_2=\frac{-5+\sqrt{13}}{-24+6\sqrt{13}}=\frac{7+\sqrt{13}}{18}$ and 
   527	  $x_1=\frac{6}{7+\sqrt{13}}=\frac{7-\sqrt{13}}{6}$.
   528	
   529	  $x_1,x_2,x_3\notin\Q$ because they are expressions involving only rationals and 
   530	  $\sqrt{13}$ which is irrational. Their minimal polynomials in $\Q[y]$ are
   531	  \begin{align*}
   532	    P_1(y)=3y^2-7y+3,~P_2(y)=9y^2-7y+1,~P_3(y)=y^2+3y-1.
   533	  \end{align*}
   534	  These are all indeed irreducible by the rational root theorem.
   535	\end{proof}
   536	
   537	We conclude with a proof that square roots of rationals (along with rational arithmetic) 
   538	are always enough to represent a NE of a $2\times2\times2$ game.
   539	
   540	\begin{proposition}\label{prop:n=3-sqrt}
   541	  Let $G$ be a $2\times2\times2$ game with integer payoffs. There is a NE 
   542	  $((x_1,1-x_1),(x_2,1-x_2),(x_3,1-x_3))$ such that for every $i\in\s{1,2,3}$, 
   543	  $x_i=a_i+b_i\sqrt c_i$ for some $a_i,b_i,c_i\in\Q$.
   544	\end{proposition}
   545	\begin{proof}
   546	  In full generality, the polynomials $f_1,f_2,f_3$ have the form
   547	  \begin{align*}
   548	    f_1(x_2,x_3)&=A_1x_2x_3+B_1x_2+C_1x_3+D_1,\\
   549	    f_2(x_1,x_3)&=A_2x_1x_3+B_2x_1+C_2x_3+D_2,\\
   550	    f_3(x_1,x_2)&=A_3x_1x_2+B_3x_1+C_3x_2+D_3,
   551	  \end{align*}
   552	  where the coefficients $A_i,B_i,C_i,D_i$ are all integers, as the payoffs in the game are 
   553	  integers.
   554	
   555	  Let $x\in\NE$.
   556	  There are 3 cases up to permuting actions and payoffs:
   557	
   558	  \paragraph{Case 1: $x_1=0$ and $x_2,x_3\in(0,1)$} Then 
   559	  $f_1\le0,~f_2=C_2x_3+D_2=0,~f_3=C_3x_2+D_3=0$.
   560	
   561	  From $f_1\le0$ we get $(A_1x_3+B_1)x_2\le-C_1x_3-D_1$. If $A_1x_3+B_1=0$ then either 
   562	  $x_3=-\frac{B_1}{A_1}\in\Q$ or $A_1=B_1=0$, in which case $x_2,x_3$ are defined by linear 
   563	  equations and inequalities with rational coefficients, so $x_2,x_3$ can be 
   564	  rational in a NE.
   565	
   566	  Otherwise, $x_2\le-\frac{C_1x_3+D_1}{A_1x_3+B_1}$.
   567	  
   568	  If $C_i\ne0$ for $i\in\s{2,3}$ then $x_{5-i}=-\frac{D_i}{C_i}\in\Q$. If $i=2$ then 
   569	  $f_1=\p{-\frac{A_1D_2}{C_2}+B_1}x_2-\frac{C_1D_2}{C_2}+D_1\le0$. Since this inequality 
   570	  holds for some value of $x_2$, the inequality also holds for some rational value of 
   571	  $x_2$. In total, $x_1,x_2,x_3$ can all be rational (in a NE).
   572	
   573	  Otherwise $C_2=C_3=0$. Then the only constraints on $x_2,x_3$ are being in $(0,1)$ and 
   574	  the inequality $x_2\le-\frac{C_1x_3+D_1}{A_1x_3+B_1}$. This inequality is in particular 
   575	  satisfied for some rational values of $x_2,x_3$, meaning that $x_1,x_2,x_3$ can all be 
   576	  rational.
   577	  
   578	  \paragraph{Case 2: $x_1=x_2=0$ and $x_3\in(0,1)$} Then 
   579	  $f_1=C_1x_3+D_1\le0,~f_2=C_2x_3+D_2\le0,~f_3=D_3=0$. So $x_3$ can be rational in a NE with $x_1=x_2=0$.
   580	
   581	  \paragraph{Case 3: $x_1,x_2,x_3\in(0,1)$} Then $f_1=f_2=f_3=0$.
   582	  Then $(A_1x_3+B_1)x_2=-C_1x_3-D_1$. Suppose that $(*)$ $A_1x_3+B_1\ne0$. Then 
   583	  $x_2=-\frac{C_1x_3+D_1}{A_1x_3+B_1}$. From $f_3=0$ we then get 
   584	  $\p{-\frac{A_3(C_1x_3+D_1)}{A_1x_3+B_1}+B_3}x_1-\frac{C_3(C_1x_3+D_1)}{A_1x_3+B_1}+D_3=0$.  
   585	  So
   586	  \begin{align*}
   587	    \p{(B_3A_1-A_3C_1)x_3+B_3B_1-A_3D_1}x_1=(C_3C_1-D_3A_1)x_3+C_3D_1-D_3B_1.
   588	  \end{align*}
   589	  Suppose that $(**)$ $(B_3A_1-A_3C_1)x_3+B_3B_1-A_3D_1\ne0$. Then
   590	  \begin{align*}
   591	    x_1=\frac{(C_3C_1-D_3A_1)x_3+C_3D_1-D_3B_1}{(B_3A_1-A_3C_1)x_3+B_3B_1-A_3D_1}.
   592	  \end{align*}
   593	  
   594	  Now $f_2=0$ simplifies into a quadratic equation in $x_3$ involving rational 
   595	  coefficients.
   596	  So $x_3$ can be written with rational arithmetic and (non-nested) square roots. The same then holds for $x_1,x_2$ by their expressions as ratios of linear 
   597	  functions of $x_3$.
   598	
   599	  Now suppose that $(*)$ and $(**)$ are not both true. There are 2 cases:
   600	  \begin{itemize}
   601	    \item $(*)$ is false, so $A_1x_3+B_1=0$. Then $C_1x_3+D_1=0$. If 
   602	      $A_1=C_1=0$ then $B_1=D_1=0$ and $f_1$ is always $0$. If $f_2$ is always~$0$ then 
   603	      $x_3$ can take any value in $(0,1)$ (particularly rational ones), and one can verify 
   604	      that $x_1,x_2$ can take rational values. So $f_2,f_3$ are not always $0$, and because 
   605	      of symmetry we can swap $f_1$ and $f_2$ to have one of $A_1\ne0$ and $C_1\ne0$ being 
   606	      true which implies that $x_3\in\Q$. It can then be verified that $x_1,x_2$ can both 
   607	      be rational.
   608	
   609	    \item $f_1,f_3$ are not always $0$ and $A_1x_3+B_1\ne0$, $(*)$ is true and $(**)$ is false, so $(B_3A_1-A_3C_1)x_3+B_3B_1-A_3D_1=0$. Then 
   610	      $(C_3C_1-D_3A_1)x_3+C_3D_1-D_3B_1=0$. If $B_3A_1-A_3C_1=C_3C_1-D_3A_1=0$ then 
   611	      $C_3D_1-D_3B_1=B_3B_1-A_3D_1=0$ and conditioned on $f_1(x_2,x_3)=0$, we get that 
   612	      $f_3$ is always $0$ in contradiction to our assumption.
   613	
   614	      So one of $B_3A_1-A_3C_1$ and $C_3C_1-D_3A_1$ is not $0$. Then $x_3\in\Q$. It can 
   615	      then be verified that $x_1,x_2$ can both be rational. \qedhere
   616	  \end{itemize}
   617	\end{proof}
