    if a == b:
        if evaluate(q, a) != 0:
            raise ValueError("degenerate interval that is not a root")
        return (a, a)
    if a > b:
        raise ValueError("need a <= b, got %s and %s" % (a, b))
    fa, fb = evaluate(q, a), evaluate(q, b)
    if fa == 0:
        return (a, a)
    if fb == 0:
        return (b, b)
    if (fa > 0) == (fb > 0):
        raise ValueError("endpoints do not bracket a sign change")
