+    }
+
+    invariant_checks = 0
+    carried_checks = 0
+    keys = []
+    g8_failures = []
+    for seed in range(20):
+        original = make_instance(seed=20000 + seed, **ship_params)
+        key = canonical_key(original)
+        keys.append(key)
+        rng = random.Random(30000 + seed)
