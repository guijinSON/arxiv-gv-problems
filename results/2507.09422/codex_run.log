   932	    f_3(x_1,x_2,x_4,x_5)=&-2x_1x_2x_4x_5+x_1x_2x_4+x_1x_2x_5+2x_1x_4x_5-x_1x_4-x_1x_5\\
   933	    &+3x_2x_4x_5-3x_2x_4+x_2-x_4x_5+x_4-x_5,\\
