+        return out
+    out["n"] = n + 4
+    out["value_slots"] = max(12, out["value_slots"])
+    out["mask_width"] = min(7, out["n"] - 4)
+    # At n=1200 the selector itself approaches the 2000-character answer cap.
+    if out["n"] > 1200:
