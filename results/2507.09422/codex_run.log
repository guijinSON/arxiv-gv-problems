+def _attack_outlier(inst):
+    scores = []
+    for i, terms in enumerate(inst["equations"]):
+        max_coeff = max(abs(term[0]) for term in terms)
+        scores.append((len(terms), max_coeff, i))
+    ranks = {player: rank for rank, (_, _, player) in enumerate(sorted(scores))}
+    values = [CODEBOOK[i] for i in range(inst["n"])]
+    return {
+        "values": [list(value) for value in values],
+        "selector": [ranks[i] for i in range(inst["n"])],
+    }
