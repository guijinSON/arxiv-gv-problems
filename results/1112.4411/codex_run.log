+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    key_failures = []
+    unrelated_keys = set()
+    for seed in range(20):
+        instance = make_instance(seed=8000 + seed, **shipping_params)
+        base_key = canonical_key(instance)
+        unrelated_keys.add(base_key)
+        rng = random.Random(9000 + seed)
