+    g9_measured = all(arms[name]["attempts"] >= 3 for name in ("bare", "hinted", "placebo"))
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and compact_stats["operations"] <= 300
+    report["G9_no_tool_suitability"] = {
