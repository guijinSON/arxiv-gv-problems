+# Filled only from script-owned hardening transcripts.  A fresh build starts
+# honestly unmeasured; selftest consequently leaves G9 false until all arms run.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
