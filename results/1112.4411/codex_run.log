+    for row in range(d):
+        for column in range(d):
+            terms = []
+            for variable, (a, b) in enumerate(positions):
+                if b == column:
+                    terms.append([variable, signed_h[row][a] % field])
+            matrix[row][column] = _cell(constant_block[row][column], terms)
+    matrix[d][d] = _cell(1, [])
