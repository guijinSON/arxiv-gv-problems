        signed = coefficient if coefficient <= field // 2 else coefficient - field
        if signed == 1:
            term = f"x{variable}"
        elif signed == -1:
            term = f"-x{variable}"
        else:
            term = f"{signed}*x{variable}"
        pieces.append(term)
