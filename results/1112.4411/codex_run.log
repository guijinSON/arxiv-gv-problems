+    base_h = _hadamard(d)
+    patterns = {}
+    for a in range(d):
+        vector = tuple(base_h[row][a] % field for row in range(d))
+        negative = tuple((-base_h[row][a]) % field for row in range(d))
+        patterns[vector] = (a, 1)
+        patterns[negative] = (a, -1)
