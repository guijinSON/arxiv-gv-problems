+        row_perm = list(range(instance["matrix_size"]))
+        column_perm = list(range(instance["matrix_size"]))
+        rng.shuffle(variable_perm)
+        rng.shuffle(row_perm)
+        rng.shuffle(column_perm)
+        variants = [
