+        "field": field,
+        "dimension": d,
+        "matrix_size": size,
+        "variables": variables,
+        "rank_bound": 1,
+        "degree": 1,
+        "anchor": [d, d],
+        "matrix": matrix,
+        "answer": list(answer),
+    }
