+    evaluated = _evaluate(inst, answer)
+    rank = _rank_mod(evaluated, field)
+    if rank > inst["rank_bound"]:
+        return False, f"evaluated matrix has rank {rank}, exceeding bound {inst['rank_bound']}"
+    return True, "ok"
