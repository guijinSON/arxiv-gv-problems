+    constant_block = [[0] * d for _ in range(d)]
+    for row in range(d):
+        for column in range(d):
+            constant_block[row][column] = (
+                -sum(
+                    signed_h[row][a] * solution_matrix[a][column]
+                    for a in range(d)
+                )
+            ) % field
