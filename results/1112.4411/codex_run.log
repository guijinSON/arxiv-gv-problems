+    for variable, coefficient in terms:
+        signed = coefficient if coefficient <= field // 2 else coefficient - field
+        if signed == 1:
+            term = f"x{variable}"
+        elif signed == -1:
+            term = f"-x{variable}"
+        else:
+            term = f"{signed}*x{variable}"
+        pieces.append(term)
+    if not pieces:
+        return "0"
+    expression = pieces[0]
+    for term in pieces[1:]:
+        expression += (" - " + term[1:]) if term.startswith("-") else (" + " + term)
+    return expression
