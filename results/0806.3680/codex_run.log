+    n = inst["n"]
+    adjacency = [set() for _ in range(n)]
+    for a, b in inst["mixed_pairs"]:
+        adjacency[a - 1].add(b - 1)
+        adjacency[b - 1].add(a - 1)
+    unseen = set(range(n))
+    classes = []
+    while unseen:
+        anchor = min(unseen)
+        block = {j for j in range(n) if j == anchor or j not in adjacency[anchor]}
+        classes.append(block)
+        unseen -= block
+    return classes
