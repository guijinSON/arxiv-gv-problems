+def _reference_decomposition(inst):
+    """Section 4.3's sort-and-adjacent-corner algorithm, with comparisons."""
+    data = [tuple(row) for row in inst["generators"]]
+    comparisons = 0
+
+    def merge_sort(items):
+        nonlocal comparisons
+        if len(items) <= 1:
+            return items
+        middle = len(items) // 2
+        left = merge_sort(items[:middle])
+        right = merge_sort(items[middle:])
+        merged = []
+        i = j = 0
+        while i < len(left) and j < len(right):
+            comparisons += 1
+            if left[i][0] > right[j][0]:
+                merged.append(left[i])
+                i += 1
+            else:
+                merged.append(right[j])
+                j += 1
+        merged.extend(left[i:])
+        merged.extend(right[j:])
+        return merged
+
+    ordered = merge_sort(data)
+    answer = [[ordered[i][0], ordered[i + 1][1]] for i in range(inst["n"])]
+    return answer, {"comparisons": comparisons, "operations": comparisons + inst["n"]}
+
+
+def _compact_reflection_decomposition(inst):
+    positive_x = [a for a, _ in inst["generators"] if a > 0]
+    positive_y = [b for _, b in inst["generators"] if b > 0]
+    # Finding min(positive_y), one addition, and one subtraction per component.
+    center = max(positive_x) + min(positive_y)
+    answer = [[a, center - a] for a in positive_x]
+    operations = (len(positive_y) - 1) + 1 + len(positive_x)
+    return answer, operations
+
