+def _incidence_reference(inst):
+    """Exact standard scan of the quadratic generators, with operation counts."""
+    anchor = 1
+    conflicts = set()
+    endpoint_comparisons = 0
+    for a, b in inst["mixed_pairs"]:
+        endpoint_comparisons += 1
