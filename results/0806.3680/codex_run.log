+        relabelled["mixed_pairs"].append([min(na, nb), max(na, nb)])
+    rng.shuffle(relabelled["mixed_pairs"])
+    relabelled["answer"] = sorted(
+        [[old_to_new[index - 1] + 1, exponent] for index, exponent in inst["answer"]]
+    )
 
