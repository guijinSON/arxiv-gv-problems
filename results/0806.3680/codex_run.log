+"""Verified generator for irreducible decompositions of monomial ideals.
+
+The source is arXiv:0806.3680, especially Sections 2.1--2.2 and the
+two-variable base case in Section 4.3.  An instance gives the shuffled minimal
+monomial generators of an artinian ideal I in k[x,y].  The witness is the
+unique irredundant decomposition of I into irreducible monomial ideals.
+
+Generation is inverse: sample incomparable irreducible components first,
+intersect them by the two-variable staircase identity, and retain the sampled
+components as the certificate.  Verification independently reconstructs the
+intersection from any proposed irredundant component list and compares its
+minimal generators with the public input.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "finite_discrete",
+    "computational_core": "other",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "monomial ideal in k[x,y] given by its minimal exponent vectors",
+        "irreducible monomial ideals generated by pure powers",
+    ],
+    "verification_operations": [
+        "exact integer exponent comparison",
+        "exact monomial-ideal intersection by staircase reconstruction",
+        "exact equality of minimal monomial-generator sets",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Recognize that the positive x- and y-exponent sets are reflections "
+        "across a constant total degree; without that invariant one must sort "
+        "the shuffled staircase and pair adjacent corners."
+    ),
+    "hardness_basis": (
+        "Track B: Section 4.3 gives the standard two-variable sort-and-adjacent-"
+        "corner algorithm, which is O(n log n); at shipping n=120 its exact "
+        "reference cost and wall-clock time are measured by selftest, whereas "
+        "the reflection route uses at most 240 exact comparisons/subtractions "
+        "and fits the no-tool operation cap."
+    ),
+    "max_answer_tokens": 360,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 3, "ceiling": 11},
+    "easy": {"n": 64, "ceiling": 257},
+    "medium": {"n": 96, "ceiling": 509},
+    "hard": {"n": 120, "ceiling": 997},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The positive x- and y-exponent multisets are reflections of one another "
+    "across a single constant total degree."
+)
+PLACEBO_HINT = (
+    "The exponent pairs should be copied carefully and every requested ideal "
+    "should appear exactly once in the final list."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An unordered JSON list of exactly n distinct irreducible ideals "
+        "<x^a,y^b>, represented by pairs [a,b], with 1<=a<=A and 1<=b<=B; "
+        "the n pairs must be irredundant, so their a-coordinates and b-"
+        "coordinates are distinct and oppositely ordered."
+    ),
+    "bounds": {
+        "components": "n",
+        "generators_per_component": 2,
+        "a_min": 1,
+        "a_max": "the public pure-x exponent A",
+        "b_min": 1,
+        "b_max": "the public pure-y exponent B",
+        "candidate_count": "binom(A,n)*binom(B,n)",
+    },
+}
+
+NOTES = (
+    "Section 2.1 fixes the definition: an irreducible monomial ideal is "
+    "generated by pure powers, and every monomial ideal has a unique "
+    "irredundant irreducible decomposition. Proposition 3 relates those "
+    "components to maximal standard monomials. Section 4.3 is the decisive easy "
+    "case: in two variables the maximal staircase corners are obtained after "
+    "sorting the minimal generators, so this cannot be Track A. The generator "
+    "samples incomparable component pairs first and intersects them; random "
+    "exponents and a final shuffle defeat magnitude, input-order, same-monomial, "
+    "and random-restart probes. The intended invariant is that the two positive "
+    "coordinate projections are complementary about one hidden total degree."
+)
+
+# Filled from the three script-owned harness runs before shipping.  These fields
+# are diagnostic only: G9(c)'s size/effort caps are the part that gates.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _sorted_generators(generators):
+    return sorted((int(a), int(b)) for a, b in generators)
+
+
+def _public_bounds(inst):
+    pure_x = [a for a, b in inst["generators"] if a > 0 and b == 0]
+    pure_y = [b for a, b in inst["generators"] if a == 0 and b > 0]
+    if len(pure_x) != 1 or len(pure_y) != 1:
+        raise ValueError("instance must have exactly one pure generator per variable")
+    return pure_x[0], pure_y[0]
+
+
+def _intersection_generators(components):
+    """Minimal generators of an irredundant two-variable intersection.
+
+    If Q_i=<x^a_i,y^b_i> are sorted with a_i strictly decreasing and b_i
+    strictly increasing, then their intersection has staircase generators
+    (a_0,0), (a_1,b_0), ..., (a_{r-1},b_{r-2}), (0,b_{r-1}).
+    """
+    rows = sorted(((a, b) for a, b in components), reverse=True)
+    out = [(rows[0][0], 0)]
+    out.extend((rows[i][0], rows[i - 1][1]) for i in range(1, len(rows)))
+    out.append((0, rows[-1][1]))
+    return sorted(out)
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate an artinian two-variable monomial ideal.
+
+    The irreducible components are sampled before the public minimal generators.
+    No decomposition algorithm is run during generation.
+    """
+    if not _is_int(n) or n < 2:
+        raise ValueError("n must be an integer at least 2")
+    ceiling = params.pop("ceiling", max(2 * n + 1, 257))
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if not _is_int(ceiling) or ceiling < n + 1:
+        raise ValueError("ceiling must be an integer at least n+1")
+
+    rng = random.Random(seed)
+
+    # Sample the answer first.  p_0=ceiling-1 forces the smallest reflected
+    # y-exponent to be 1; the remaining p_i are unbiased distinct interior
+    # exponents.  Sorting makes the component ideals pairwise incomparable.
+    positive_x = [ceiling - 1]
+    positive_x.extend(rng.sample(range(1, ceiling - 1), n - 1))
+    positive_x.sort(reverse=True)
+    answer = [[p, ceiling - p] for p in positive_x]
+
+    # Compose the intersection identity, then erase the staircase order.
+    generators = [list(pair) for pair in _intersection_generators(answer)]
+    rng.shuffle(generators)
+
+    return {
+        "paper": "arXiv:0806.3680",
+        "family": "irreducible decomposition of a two-variable monomial ideal",
+        "n": n,
+        "variables": ["x", "y"],
+        "generators": generators,
+        "answer": answer,
+    }
+
+
+def render(inst):
+    n = inst["n"]
+    x_bound, y_bound = _public_bounds(inst)
+    lines = [
+        "Find the irredundant irreducible decomposition of a monomial ideal.",
+        "",
+        "Definitions and conventions.",
+        "Work in the polynomial ring k[x,y] over an arbitrary field k.",
+        "A pair [a,b] denotes the monomial x^a y^b; exponent 0 means that",
+        "the corresponding variable is absent. A monomial x^a y^b divides",
+        "x^c y^d exactly when a<=c and b<=d.",
+        "A monomial ideal <M> contains all multiples of its listed monomials.",
+        "The list below is the complete minimal generating set of the input ideal I.",
+        "An irreducible monomial ideal in this task has the form <x^a,y^b>",
+        "with positive integers a,b; represent it by the pair [a,b].",
+        "An irreducible decomposition is an intersection of such ideals equal to I.",
+        "It is irredundant when deleting any component changes the intersection.",
+        "",
+        f"The answer has exactly {n} distinct components. Their order does not matter.",
+        f"Every answer pair must satisfy 1<=a<={x_bound} and 1<=b<={y_bound}.",
+        "Rows use [x exponent, y exponent] order. Repeats and omitted components",
+        "are forbidden.",
+        "",
+        f"Minimal generators of I ({n + 1} shuffled exponent pairs):",
+    ]
+    lines.extend("  " + json.dumps(row, separators=(",", ":")) for row in inst["generators"])
+    lines.extend(
+        [
+            "",
+            "Return a JSON list of the component pairs [a,b].",
+            "Give your final answer inside <answer></answer> tags, as that JSON list.",
+            "Example: <answer>[[3,5],[2,8]]</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    try:
+        if not isinstance(text, str):
+            return None
+        match = re.search(r"<answer>(.*?)</answer>", text, re.IGNORECASE | re.DOTALL)
+        if not match:
+            return None
+        body = match.group(1).strip()
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.IGNORECASE)
+        body = re.sub(r"\s*```$", "", body).strip()
+        parsed = json.loads(body)
+        return parsed if isinstance(parsed, list) else None
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+
+
+def verify(inst, answer):
+    n = inst["n"]
+    if not isinstance(answer, list):
+        return False, "malformed answer: expected a JSON list of component pairs"
+    if not answer:
+        return False, "empty answer: at least one component is required"
+    if len(answer) != n:
+        return False, f"wrong component count: expected {n}, got {len(answer)}"
+
+    x_bound, y_bound = _public_bounds(inst)
+    rows = []
+    for index, row in enumerate(answer):
+        if (
+            not isinstance(row, list)
+            or len(row) != 2
+            or not all(_is_int(value) for value in row)
+        ):
+            return False, f"malformed component at position {index}: expected [a,b]"
+        a, b = row
+        if not (1 <= a <= x_bound and 1 <= b <= y_bound):
+            return False, (
+                f"exponent out of range at position {index}: require "
+                f"1<=a<={x_bound} and 1<=b<={y_bound}"
+            )
+        rows.append((a, b))
+
+    if len(set(rows)) != len(rows):
+        return False, "duplicate component: every irreducible ideal must appear once"
+
+    ordered = sorted(rows, reverse=True)
+    if any(ordered[i][0] == ordered[i - 1][0] for i in range(1, n)):
+        return False, "redundant components: x exponents must be distinct"
+    if any(ordered[i][1] <= ordered[i - 1][1] for i in range(1, n)):
+        return False, (
+            "redundant components: y exponents must increase when x exponents decrease"
+        )
+
+    proposed = _intersection_generators(ordered)
+    public = _sorted_generators(inst["generators"])
+    if proposed != public:
+        return False, "intersection mismatch: proposed components do not intersect to I"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniform over the stated bounded language of irredundant decompositions."""
+    n = inst["n"]
+    x_bound, y_bound = _public_bounds(inst)
+    xs = sorted(rng.sample(range(1, x_bound + 1), n), reverse=True)
+    ys = sorted(rng.sample(range(1, y_bound + 1), n))
+    return [[a, b] for a, b in zip(xs, ys)]
+
+
+def search_space(inst):
+    n = inst["n"]
+    x_bound, y_bound = _public_bounds(inst)
+    return math.comb(x_bound, n) * math.comb(y_bound, n)
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 100_000:
+        return None
+    n = inst["n"]
+    x_bound, y_bound = _public_bounds(inst)
+    count = 0
+    for xs in itertools.combinations(range(1, x_bound + 1), n):
+        xs_desc = tuple(reversed(xs))
+        for ys in itertools.combinations(range(1, y_bound + 1), n):
+            candidate = [[a, b] for a, b in zip(xs_desc, ys)]
+            count += int(verify(inst, candidate)[0])
+    return count
+
+
+def canonical_key(inst):
+    """Invariant under input order and interchange of the variables x and y."""
+    normal = _sorted_generators(inst["generators"])
+    swapped = sorted((b, a) for a, b in normal)
+    rep_normal = json.dumps(normal, separators=(",", ":"))
+    rep_swapped = json.dumps(swapped, separators=(",", ":"))
+    canonical = min(rep_normal, rep_swapped)
+    return hashlib.sha256(canonical.encode("ascii")).hexdigest()
+
+
+def escalate(params):
+    """Increase exponent-space density at fixed 120-component answer length."""
+    n = params.get("n")
+    ceiling = params.get("ceiling")
+    if not _is_int(n) or not _is_int(ceiling):
+        return None
+    if n < 120:
+        return {"n": 120, "ceiling": max(997, ceiling)}
+    levels = [5_003, 10_007, 20_011, 40_009, 70_001, 99_991]
+    for next_ceiling in levels:
+        if ceiling < next_ceiling:
+            return {"n": n, "ceiling": next_ceiling}
+    return "cap_bound"
+
+
+def _reference_decomposition(inst):
+    """Section 4.3's sort-and-adjacent-corner algorithm, with comparisons."""
+    data = [tuple(row) for row in inst["generators"]]
+    comparisons = 0
+
+    def merge_sort(items):
+        nonlocal comparisons
+        if len(items) <= 1:
+            return items
+        middle = len(items) // 2
+        left = merge_sort(items[:middle])
+        right = merge_sort(items[middle:])
+        merged = []
+        i = j = 0
+        while i < len(left) and j < len(right):
+            comparisons += 1
+            if left[i][0] > right[j][0]:
+                merged.append(left[i])
+                i += 1
+            else:
+                merged.append(right[j])
+                j += 1
+        merged.extend(left[i:])
+        merged.extend(right[j:])
+        return merged
+
+    ordered = merge_sort(data)
+    answer = [[ordered[i][0], ordered[i + 1][1]] for i in range(inst["n"])]
+    return answer, {"comparisons": comparisons, "operations": comparisons + inst["n"]}
+
+
+def _compact_reflection_decomposition(inst):
+    positive_x = [a for a, _ in inst["generators"] if a > 0]
+    positive_y = [b for _, b in inst["generators"] if b > 0]
+    # Finding min(positive_y), one addition, and one subtraction per component.
+    center = max(positive_x) + min(positive_y)
+    answer = [[a, center - a] for a in positive_x]
+    operations = (len(positive_y) - 1) + 1 + len(positive_x)
+    return answer, operations
+
+
+def _attack_extreme_ranges(inst):
+    n = inst["n"]
+    x_bound, y_bound = _public_bounds(inst)
+    xs = list(range(x_bound, x_bound - n, -1))
+    ys = list(range(1, n + 1))
+    if ys[-1] > y_bound:
+        ys = list(range(y_bound - n + 1, y_bound + 1))
+    return [[a, b] for a, b in zip(xs, ys)]
+
+
+def _attack_input_order(inst):
+    xs = [a for a, _ in inst["generators"] if a > 0]
+    ys = [b for _, b in inst["generators"] if b > 0]
+    return [[a, b] for a, b in zip(xs, ys)]
+
+
+def _attack_same_monomial(inst):
+    x_bound, _ = _public_bounds(inst)
+    positive_y = [b for _, b in inst["generators"] if b > 0]
+    mixed = [[a, b] for a, b in inst["generators"] if a > 0 and b > 0]
+    return [[x_bound, min(positive_y)]] + mixed
+
+
+def _attack_candidates(inst, seed):
+    rng = random.Random(seed ^ 0x08063680)
+    return {
+        "outlier_extreme_exponents": [_attack_extreme_ranges(inst)],
+        "greedy_shuffled_input_order": [_attack_input_order(inst)],
+        "same_monomial_coordinate_ansatz": [_attack_same_monomial(inst)],
+        "random_restart_256": [random_candidate(inst, rng) for _ in range(256)],
+    }
+
+
+def _relabel_variants(inst, seed):
+    variants = []
+    for mask in range(1, 4):
+        out = json.loads(json.dumps(inst))
+        carried = [list(row) for row in inst["answer"]]
+        if mask & 1:
+            random.Random(seed + mask).shuffle(out["generators"])
+        if mask & 2:
+            out["generators"] = [[b, a] for a, b in out["generators"]]
+            out["variables"] = ["y", "x"]
+            carried = [[b, a] for a, b in carried]
+        out["answer"] = carried
+        variants.append(out)
+    return variants
+
+
+def _atom_count(value):
+    if isinstance(value, dict):
+        return sum(_atom_count(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_atom_count(item) for item in value)
+    return 1
+
+
+def selftest():
+    report = {}
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+
+    g1_attempts = 0
+    g1_failures = []
+    for preset, preset_params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            trial = make_instance(seed=seed, **preset_params)
+            ok, why = verify(trial, trial["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append([preset, seed, why])
+            if json.loads(json.dumps(trial["answer"])) != trial["answer"]:
+                g1_failures.append([preset, seed, "answer is not JSON-native"])
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+        "generation_route": "inverse construction followed by exact intersection",
+    }
+
+    inst = make_instance(seed=19, **shipping)
+    answer = inst["answer"]
+    swapped = [list(row) for row in answer]
+    swapped[0][1], swapped[1][1] = swapped[1][1], swapped[0][1]
+    duplicated = [list(row) for row in answer]
+    duplicated[-1] = list(duplicated[0])
+    out_of_range = [list(row) for row in answer]
+    out_of_range[2][0] = 0
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": swapped,
+        "duplicate": duplicated,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    cases = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        cases[name] = {"rejected": not ok, "reason": why}
+    reasons = [case["reason"] for case in cases.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(case["rejected"] for case in cases.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    model_response = (
+        "The staircase corners give the following decomposition.\n"
+        "<answer>\n```json\n"
+        + json.dumps(answer, separators=(",", ":"))
+        + "\n```\n</answer>\nEach row denotes one irreducible ideal."
+    )
+    parsed = parse_answer(model_response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_equals_answer": parsed == answer,
+        "garbage_returns_none": parse_answer("no tagged JSON here") is None,
+    }
+
+    guess_rng = random.Random(0x08063680)
+    guess_total = 200_000
+    guess_hits = 0
+    started = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
+    guess_seconds = time.perf_counter() - started
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_fraction,
+        "candidate_space": search_space(inst),
+        "candidate_space_bits": search_space(inst).bit_length(),
+        "sampling_prior": "uniform over all bounded irredundant n-component lists",
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    attack_names = [
+        "outlier_extreme_exponents",
+        "greedy_shuffled_input_order",
+        "same_monomial_coordinate_ansatz",
+        "random_restart_256",
+    ]
+    successes = {name: 0 for name in attack_names}
+    attack_seconds = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    compact_successes = 0
+    reference_seconds = 0.0
+    reference_comparisons = 0
+    reference_operations = 0
+    compact_operations = 0
+    for seed in range(101, 109):
+        trial = make_instance(seed=seed, **shipping)
+        candidates = _attack_candidates(trial, seed)
+        for name in attack_names:
+            started = time.perf_counter()
+            won = any(verify(trial, candidate)[0] for candidate in candidates[name])
+            attack_seconds[name] += time.perf_counter() - started
+            successes[name] += int(won)
+
+        started = time.perf_counter()
+        recovered, counts = _reference_decomposition(trial)
+        reference_seconds += time.perf_counter() - started
+        reference_successes += int(verify(trial, recovered)[0])
+        reference_comparisons += counts["comparisons"]
+        reference_operations += counts["operations"]
+
+        compact, compact_count = _compact_reflection_decomposition(trial)
+        compact_successes += int(verify(trial, compact)[0])
+        compact_operations = max(compact_operations, compact_count)
+
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_seconds[name], 6),
+        }
+        for name in attack_names
+    }
+    reference = {
+        "name": "Section 4.3 two-variable sort and adjacent-corner conversion",
+        "complexity": "O(n log n) exact exponent comparisons",
+        "wall_clock_sec": round(reference_seconds / 8, 8),
+        "operations": round(reference_operations / 8, 3),
+        "comparisons": round(reference_comparisons / 8, 3),
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    all_failed = all(value == 0 for value in successes.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8 and compact_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": reference,
+        "intended_compact_route": {
+            "name": "constant-total-degree reflection",
+            "solves": f"{compact_successes}/8",
+            "operations_upper_bound": compact_operations,
+        },
+    }
+
+    demo = make_instance(seed=3, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_fraction < 1e-6
+        and demo_count == 1
+        and all_failed
+        and reference_successes == 8,
+        "shipping_sample_hits": guess_hits,
+        "shipping_sample_total": guess_total,
+        "shipping_solution_density": guess_fraction,
+        "shipping_exact_solution_count": 1,
+        "uniqueness_basis": "Section 2.1 uniqueness of irredundant decomposition",
+        "demo_exact_solution_count_by_enumeration": demo_count,
+        "baseline_attack_wall_clock_sec": round(
+            attack_seconds["random_restart_256"] / 8, 6
+        ),
+        "baseline_attack_iterations": 256,
+        "reference_wall_clock_sec": reference["wall_clock_sec"],
+        "reference_operation_count": reference["operations"],
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] *= 2
+    started = time.perf_counter()
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_build = time.perf_counter() - started
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    ladder_n = [DIFFICULTY[name]["n"] for name in DIFFICULTY]
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["n"] == 2 * inst["n"]
+        and len(render(doubled)) > len(render(inst))
+        and ladder_n == sorted(ladder_n)
+        and len(set(ladder_n)) == len(ladder_n),
+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_why,
+        "candidate_space_bits_shipping": search_space(inst).bit_length(),
+        "candidate_space_bits_doubled": search_space(doubled).bit_length(),
+    }
+
+    invariants = 0
+    carried_valid = 0
+    unrelated = []
+    for seed in range(201, 221):
+        original = make_instance(seed=seed, **shipping)
+        original_key = canonical_key(original)
+        for transformed in _relabel_variants(original, seed ^ 0x5A5A):
+            invariants += int(canonical_key(transformed) == original_key)
+            carried_valid += int(verify(transformed, transformed["answer"])[0])
+        unrelated.append(original_key)
+    distinct = len(set(unrelated))
+    report["G8_canonical_key"] = {
+        "pass": invariants == 60 and carried_valid == 60 and distinct == 20,
+        "invariant_relabellings": invariants,
+        "real_transformations_verified": carried_valid,
+        "unrelated_distinct_keys": distinct,
+        "unrelated_attempts": 20,
+        "transformations": [
+            "minimal-generator reordering",
+            "interchange of variables x and y with carried component exponents",
+            "composition of input reordering and variable interchange",
+        ],
+    }
+
+    encoded = json.dumps(inst["answer"])
+    answer_chars = len(encoded)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _atom_count(inst["answer"])
+    max_component = max(_public_bounds(inst))
+    digit_count = len(str(max_component))
+    worst_case_answer_chars = len(
+        json.dumps([[10**digit_count - 1, 10**digit_count - 1]] * inst["n"])
+    )
+    worst_case_answer_tokens = math.ceil(worst_case_answer_chars / 4)
+    intended_operations = 2 * inst["n"]
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = (
+        answer_chars <= 2_000
+        and answer_elements <= 256
+        and intended_operations <= 300
+        and PROBLEM_PROFILE["max_answer_tokens"] == worst_case_answer_tokens
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "worst_case_answer_chars": worst_case_answer_chars,
+        "worst_case_answer_tokens": worst_case_answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2_000, "elements": 256, "operations": 300},
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(value.get("pass") is True for value in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

