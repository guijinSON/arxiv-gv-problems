+    unseen = set(range(n))
+    classes = []
+    while unseen:
+        anchor = min(unseen)
+        block = {j for j in range(n) if j == anchor or j not in adjacency[anchor]}
+        classes.append(block)
+        unseen -= block
+    return classes
