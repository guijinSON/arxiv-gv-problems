+def _affine_compact_solve(inst):
+    """The intended route; never called by make_instance."""
+    p = max(inst["caps"])
+    slope = inst["caps"][0] % p
+    buckets = {}
+    for i, cap in enumerate(inst["caps"], 1):
+        residue = (cap - slope * i) % p
