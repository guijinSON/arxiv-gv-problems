+    # These three permutations ARE the sampled certificate.  All later work is
+    # forward construction, never certificate search.
+    px = list(range(n))
+    py = list(range(n))
+    pz = list(range(n))
+    rng.shuffle(px)
+    rng.shuffle(py)
+    rng.shuffle(pz)
