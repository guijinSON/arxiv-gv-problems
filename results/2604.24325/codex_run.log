+    if isinstance(quotient_bits, bool) or not isinstance(quotient_bits, int):
+        raise ValueError("quotient_bits must be an integer")
+    if n < 8 or n % _GROUP_SIZE:
+        raise ValueError("n must be a multiple of 4 and at least 8")
+    if n // _GROUP_SIZE > _MODULUS:
+        raise ValueError("n/4 must not exceed 997 distinct residue classes")
+    if not 4 <= quotient_bits <= 48:
