-def random_candidate(inst: dict, rng: random.Random) -> object:
-    """Sample uniformly from partitions into unlabeled four-element blocks."""
-
-    ids = list(range(1, inst["n"] + 1))
-    rng.shuffle(ids)
-    # Keeping the sampled presentation order avoids spending time canonically
-    # sorting 200,000 guesses.  Every unlabeled partition still has exactly
-    # (4!)^(n/4)*(n/4)! preimages, so this is uniform over the declared language.
-    return [
-        ids[start:start + inst["group_size"]]
-        for start in range(0, inst["n"], inst["group_size"])
-    ]
