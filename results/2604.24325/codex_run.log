+    # For b>=4, the only multiset of four tags from this set summing to zero is
+    # one copy of each: base-b uniqueness gives 1+b+b^2, balanced by tag D.
+    tag_a, tag_b, tag_c = 1, tag_base, tag_base * tag_base
