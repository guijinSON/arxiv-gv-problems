-    ids = sorted(range(1, inst["n"] + 1), key=key)
-    return _normalise_partition([
-        ids[start:start + inst["group_size"]]
-        for start in range(0, inst["n"], inst["group_size"])
-    ])
-
-
-def _greedy_partition(inst: dict) -> list[list[int]]:
-    remaining = set(range(1, inst["n"] + 1))
-    blocks: list[list[int]] = []
-    for target in sorted(inst["target_lengths"], reverse=True):
-        residual = target
-        block: list[int] = []
-        for slots in range(inst["group_size"], 0, -1):
-            chosen = min(
-                remaining,
-                key=lambda item: (
-                    abs(inst["source_lengths"][item - 1] * slots - residual),
-                    item,
-                ),
-            )
-            remaining.remove(chosen)
-            block.append(chosen)
-            residual -= inst["source_lengths"][chosen - 1]
-        blocks.append(sorted(block))
-    return _normalise_partition(blocks)
-
