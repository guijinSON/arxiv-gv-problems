+        z = w2 - w0
+        x = w0 - y
+        x -= z
+        operations += 9
+        if not (0 <= x < n and 0 <= y < n and 0 <= z < n):
+            return None, operations
+        groups.append([a_band[x], b_band[y], c_band[z], d])
+    return _canonical_groups(groups), operations
+
