+    # Replaced with measurements from selftest before final delivery.
+    "hardness_basis": (
+        "Track B: 4SUM meet-in-the-middle uses O(s^2+z) expected exact operations "
+        "on s source paths; the shipping measurement is recorded by selftest, while "
+        "the mixed-radix route uses at most 268 exact arithmetic operations."
+    ),
