+    step_b = values[b_band[1]] - values[b_band[0]]
+    radix = step_b - step_a
+    operations += 3
+    if radix <= 1:
+        return None, operations
+
+    baseline = target - values[a_band[0]]
+    baseline -= values[b_band[0]]
+    baseline -= values[c_band[0]]
+    operations += 3
+
+    groups = []
