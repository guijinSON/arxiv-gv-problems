-def _fast_valid(inst: dict, answer: object) -> bool:
-    """Fast exact check for internally generated, already well-shaped candidates."""
-
-    if not isinstance(answer, list) or len(answer) != len(inst["target_lengths"]):
-        return False
-    remaining = Counter(inst["target_lengths"])
-    seen: set[int] = set()
-    for block in answer:
-        if not isinstance(block, list) or len(block) != inst["group_size"]:
-            return False
-        total = 0
-        for item in block:
-            if (isinstance(item, bool) or not isinstance(item, int)
-                    or not 1 <= item <= inst["n"] or item in seen):
-                return False
-            seen.add(item)
-            total += inst["source_lengths"][item - 1]
-        if remaining.get(total, 0) == 0:
-            return False
-        remaining[total] -= 1
-        if remaining[total] == 0:
-            del remaining[total]
-    return len(seen) == inst["n"] and not remaining
-
