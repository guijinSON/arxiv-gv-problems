+    records = []
+    for x in range(n):
+        records.append([center + tag_a * q + _mix_code(x, 0, 0, radix), "A", x])
+    for y in range(n):
+        records.append([center + tag_b * q + _mix_code(0, y, 0, radix), "B", y])
