    # the ladder there would spend one of MAX_ESCALATIONS proving that, so the
    # hardening ladder begins at `easy`.
    ladder = [dict(p, _preset=name) for name, p in mod.DIFFICULTY.items()
              if name != "demo"]
    params = ladder[0]
    rung = 0
    verdict = None

