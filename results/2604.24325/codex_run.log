+    "computational_core": "exact_cover",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "linear forest represented by exact path-component lengths",
+        "partition of source paths into endpoint-concatenation blocks",
+    ],
+    "verification_operations": [
+        "integer index validation",
+        "exact integer addition of path lengths",
+        "multiset equality of target component lengths",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The four source paths concatenated into one target path have a common "
+        "residue modulo 997; without noticing that invariant, one must solve a "
+        "large exact four-way partition."
