+def _mix_code(x, y, z, radix):
+    """Encode R*(x,y,z), R=[[1,1,1],[1,2,1],[1,1,2]]."""
+    w0 = x + y + z
+    w1 = x + 2 * y + z
+    w2 = x + y + 2 * z
+    return w0 + radix * w1 + radix * radix * w2
