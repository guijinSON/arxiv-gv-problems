+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON array of n/4 unordered blocks, each containing exactly four "
+        "distinct 1-indexed source-component IDs; every ID from 1 through n "
+        "occurs exactly once.  Block order and order within blocks are ignored."
+    ),
+    "bounds": {
+        "blocks": "n/4",
+        "block_size": 4,
+        "minimum_id": 1,
+        "maximum_id": "n",
+        "all_ids_used_once": True,
+        "ordering": "irrelevant",
+    },
+}
+
+DIFFICULTY = {
+    "demo": {"n": 8, "quotient_bits": 4},
+    "easy": {"n": 192, "quotient_bits": 24},
+    "medium": {"n": 224, "quotient_bits": 27},
+    "hard": {"n": 256, "quotient_bits": 30},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The four source-path lengths belonging to one target path have the same "
+    "residue modulo 997."
+)
+PLACEBO_HINT = (
+    "The source-path identifiers should be copied carefully when assembling "
+    "each group of four."
+)
+
+# Filled from script-owned transcripts after the three oracle arms have run.
+G9_MEASUREMENTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+NOTES = r"""
+Definition and certificate.  Section 1 defines identification and the equivalent
+H-witness partition.  Section 2, Observation 1 and Proposition 1 explain why a
+connected source component cannot be split among target components and how path
+diameters compose.  Theorem 2 uses exactly this endpoint-concatenation view to
+reduce unary Bin Packing to Identification with a linear-forest target.  The
+certificate here is the proof's partition of source components; the checker
+executes its consequence directly by exact path-length addition.
+
+Step 0 and easy regimes.  Corollary 1 makes Identification to the *class* of
+linear forests polynomial, so that is not the task used here.  For an explicitly
+given linear-forest target, Theorem 2 proves W[1]-hardness in its number of
+components, while Lemma 6 gives the honest O(nm+n^(t+1)) XP dynamic program.
+The generated distribution is not covered by a distributional lower bound, so a
+Track-A claim would be unjustified.  This module therefore declares Track B and
+reports a successful generic exact-cover solver separately from failing attacks.
+
+Construction.  Sample distinct residues and four random quotients for every
+future target component, construct four source path lengths 997*q+r, and only
+then set the target length to their sum.  Shuffle source and target components.
+All source items have the same marginal construction; there is no separate decoy
+distribution.  The planted partition is known before the public order exists.
+
+Compression and attacks.  Generic pair-sum enumeration performs one complement
+query for every target and source pair, then Algorithm X covers all target and
+source columns.  The compact route groups the source lengths by their common
+residue modulo 997.  The adversary panel tries magnitude grouping, input-order
+grouping, decimal-suffix grouping, a global-difference-gcd guess, residual-average
+greedy packing, and uniform random restarts.  These are kept separate from the
+successful reference algorithm, as Track B requires.
+""".strip()
+
+
+_MODULUS = 997
+_GROUP_SIZE = 4
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 500_000
+
+
+def _validate_params(n: int, quotient_bits: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise ValueError("n must be an integer")
+    if isinstance(quotient_bits, bool) or not isinstance(quotient_bits, int):
+        raise ValueError("quotient_bits must be an integer")
+    if n < 8 or n % _GROUP_SIZE:
+        raise ValueError("n must be a multiple of 4 and at least 8")
+    if n // _GROUP_SIZE > _MODULUS:
+        raise ValueError("n/4 must not exceed 997 distinct residue classes")
+    if not 4 <= quotient_bits <= 48:
+        raise ValueError("quotient_bits must lie in [4,48]")
+
+
+def _normalise_partition(answer: list[list[int]]) -> list[list[int]]:
+    return sorted((sorted(block) for block in answer), key=lambda block: tuple(block))
+
+
+def make_instance(n: int, seed: int = 0, *, quotient_bits: int = 24) -> dict:
+    """Inverse-generate a linear-forest Identification witness.
+
+    `n` is the number of source path components.  Four independently sampled
+    source lengths share each sampled residue.  Their sum defines one target
+    length, so the endpoint-identification certificate is known by construction.
+    """
+
+    _validate_params(n, quotient_bits)
+    rng = random.Random(seed)
+    groups = n // _GROUP_SIZE
+    residues = rng.sample(range(_MODULUS), groups)
+    q_low = 1 << (quotient_bits - 1)
+    q_high = 1 << quotient_bits
+
+    records: list[tuple[int, int]] = []
+    target_lengths: list[int] = []
+    for group_id, residue in enumerate(residues):
+        quotients = rng.sample(range(q_low, q_high), _GROUP_SIZE)
+        lengths = [_MODULUS * q + residue for q in quotients]
+        records.extend((length, group_id) for length in lengths)
+        target_lengths.append(sum(lengths))
+
+    # IDs are assigned only after the witness objects have been shuffled.
+    rng.shuffle(records)
+    rng.shuffle(target_lengths)
+    answer_by_group: list[list[int]] = [[] for _ in range(groups)]
+    source_lengths: list[int] = []
+    for item_id, (length, group_id) in enumerate(records, 1):
+        source_lengths.append(length)
+        answer_by_group[group_id].append(item_id)
+
+    answer = _normalise_partition(answer_by_group)
+    return {
+        "family": "linear_forest_exact_endpoint_identification",
+        "n": n,
+        "group_size": _GROUP_SIZE,
+        "source_lengths": source_lengths,
+        "target_lengths": target_lengths,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render a complete, standalone problem with an exact JSON answer format."""
+
+    source_lines = []
+    for start in range(0, inst["n"], 8):
+        rows = [
+            f"{i + 1}:{inst['source_lengths'][i]}"
+            for i in range(start, min(start + 8, inst["n"]))
+        ]
+        source_lines.append("  " + "  ".join(rows))
+    target_lines = []
+    for start in range(0, len(inst["target_lengths"]), 6):
+        rows = [
+            f"{i + 1}:{inst['target_lengths'][i]}"
+            for i in range(start, min(start + 6, len(inst["target_lengths"])))
+        ]
+        target_lines.append("  " + "  ".join(rows))
+
+    statement = f"""Exact identification of one linear forest with another
+
+A path's length is its number of edges.  A linear forest is a disjoint union of
+paths.  The source forest G below has {inst['n']} path components; source ID i
+denotes a path of the displayed length.  The target forest L has
+{len(inst['target_lengths'])} path components, whose displayed order is irrelevant.
+
+Identifying two vertices replaces them by one vertex adjacent to the union of
+their neighbors.  In particular, identifying an endpoint of one path with an
+endpoint of a disjoint path concatenates them into a path whose length is the sum
+of the two lengths.
+
+Find an endpoint-concatenation witness of the following required form: partition
+all source IDs into exactly {len(inst['target_lengths'])} unordered blocks of
+exactly four distinct IDs.  Every source ID 1 through {inst['n']} must occur once.
+After the three endpoint identifications within every block, the multiset of
+resulting path lengths (the four displayed source lengths added exactly) must
+equal the multiset of target lengths.  Block order and order inside a block do
+not matter.  All integers and equalities are exact.
+
+Source components, as ID:length:
+{chr(10).join(source_lines)}
+
+Target components, as ID:length:
+{chr(10).join(target_lines)}
+
+Give your final answer inside <answer></answer> tags as one JSON array of arrays.
+There must be exactly {len(inst['target_lengths'])} inner arrays, each containing
+four distinct 1-indexed source IDs, with every source ID used exactly once.
+Example format: <answer>[[1,4,6,8],[2,3,5,7]]</answer>
+Output nothing else inside the tags."""
+
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the tagged JSON partition; return None on all malformed input."""
+
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", payload, re.I | re.S)
+    if fence:
+        payload = fence.group(1).strip()
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list):
+        return None
+    if not all(isinstance(block, list) for block in value):
+        return None
+    if not all(
+        isinstance(item, int) and not isinstance(item, bool)
+        for block in value for item in block
+    ):
+        return None
+    return value
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any valid endpoint-concatenation witness without reading the plant."""
+
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array of blocks"
+    if not answer:
+        return False, "answer is empty"
+    expected_groups = len(inst["target_lengths"])
+    if len(answer) != expected_groups:
+        return False, f"expected {expected_groups} blocks, received {len(answer)}"
+
+    flat: list[int] = []
+    group_sums: list[int] = []
+    for block_index, block in enumerate(answer, 1):
+        if not isinstance(block, list):
+            return False, f"block {block_index} is not a JSON array"
+        if len(block) != inst["group_size"]:
+            return False, (
+                f"block {block_index} must contain exactly "
+                f"{inst['group_size']} source IDs"
+            )
+        for item in block:
+            if isinstance(item, bool) or not isinstance(item, int):
+                return False, f"block {block_index} contains a non-integer ID"
+            if not 1 <= item <= inst["n"]:
+                return False, f"source ID {item} is outside 1..{inst['n']}"
+        flat.extend(block)
+        group_sums.append(sum(inst["source_lengths"][item - 1] for item in block))
+
+    if len(set(flat)) != len(flat):
+        return False, "a source component ID is repeated"
+    if set(flat) != set(range(1, inst["n"] + 1)):
+        return False, "the blocks do not cover every source component exactly once"
+    if sorted(group_sums) != sorted(inst["target_lengths"]):
+        return False, "the block-sum multiset does not match the target lengths"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from partitions into unlabeled four-element blocks."""
+
+    ids = list(range(1, inst["n"] + 1))
+    rng.shuffle(ids)
+    # Keeping the sampled presentation order avoids spending time canonically
+    # sorting 200,000 guesses.  Every unlabeled partition still has exactly
+    # (4!)^(n/4)*(n/4)! preimages, so this is uniform over the declared language.
+    return [
+        ids[start:start + inst["group_size"]]
+        for start in range(0, inst["n"], inst["group_size"])
+    ]
+
+
+def search_space(inst: dict) -> int:
+    """Count partitions of n labeled items into unlabeled blocks of size four."""
+
+    n = inst["n"]
+    groups = n // inst["group_size"]
+    return math.factorial(n) // (
+        math.factorial(inst["group_size"]) ** groups * math.factorial(groups)
+    )
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Exactly count valid certificates when the bounded language is small."""
+
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    values = inst["source_lengths"]
+    wanted = Counter(inst["target_lengths"])
+    count = 0
+
+    def visit(remaining: tuple[int, ...], sums_left: Counter[int]) -> None:
+        nonlocal count
+        if not remaining:
+            if not sums_left:
+                count += 1
+            return
+        first = remaining[0]
+        tail = remaining[1:]
+        for others in itertools.combinations(tail, inst["group_size"] - 1):
+            block = (first,) + others
+            total = sum(values[index] for index in block)
+            if sums_left.get(total, 0) == 0:
+                continue
+            chosen = set(block)
+            next_remaining = tuple(index for index in remaining if index not in chosen)
+            sums_left[total] -= 1
+            if sums_left[total] == 0:
+                del sums_left[total]
+            visit(next_remaining, sums_left)
+            sums_left[total] += 1
+
+    visit(tuple(range(inst["n"])), wanted.copy())
+    return count
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonicalize the two disjoint unions of paths under component relabeling."""
+
+    normal = {
+        "source_path_lengths": sorted(inst["source_lengths"]),
+        "target_path_lengths": sorted(inst["target_lengths"]),
+        "required_block_size": inst["group_size"],
+    }
+    blob = json.dumps(normal, separators=(",", ":"), sort_keys=True).encode()
+    return hashlib.sha256(blob).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Raise the number of source paths until the answer-atom cap binds."""
+
+    current = dict(params)
+    n = int(current.get("n", 0))
+    if n >= 256:
+        return "cap_bound"
+    next_n = min(256, 4 * math.ceil((n * 1.2) / 4))
+    if next_n <= n:
+        next_n = min(256, n + 4)
+    current["n"] = next_n
+    current["quotient_bits"] = min(48, int(current.get("quotient_bits", 24)) + 2)
+    return current
+
+
+def _fast_valid(inst: dict, answer: object) -> bool:
+    """Fast exact check for internally generated, already well-shaped candidates."""
+
+    if not isinstance(answer, list) or len(answer) != len(inst["target_lengths"]):
+        return False
+    remaining = Counter(inst["target_lengths"])
+    seen: set[int] = set()
+    for block in answer:
+        if not isinstance(block, list) or len(block) != inst["group_size"]:
+            return False
+        total = 0
+        for item in block:
+            if (isinstance(item, bool) or not isinstance(item, int)
+                    or not 1 <= item <= inst["n"] or item in seen):
+                return False
+            seen.add(item)
+            total += inst["source_lengths"][item - 1]
+        if remaining.get(total, 0) == 0:
+            return False
+        remaining[total] -= 1
+        if remaining[total] == 0:
+            del remaining[total]
+    return len(seen) == inst["n"] and not remaining
+
+
+def _partition_by_key(inst: dict, key: Callable[[int], Any]) -> list[list[int]]:
+    ids = sorted(range(1, inst["n"] + 1), key=key)
+    return _normalise_partition([
+        ids[start:start + inst["group_size"]]
+        for start in range(0, inst["n"], inst["group_size"])
+    ])
+
+
+def _greedy_partition(inst: dict) -> list[list[int]]:
+    remaining = set(range(1, inst["n"] + 1))
+    blocks: list[list[int]] = []
+    for target in sorted(inst["target_lengths"], reverse=True):
+        residual = target
+        block: list[int] = []
+        for slots in range(inst["group_size"], 0, -1):
+            chosen = min(
+                remaining,
+                key=lambda item: (
+                    abs(inst["source_lengths"][item - 1] * slots - residual),
+                    item,
+                ),
+            )
+            remaining.remove(chosen)
+            block.append(chosen)
+            residual -= inst["source_lengths"][chosen - 1]
+        blocks.append(sorted(block))
+    return _normalise_partition(blocks)
+
+
+def _attack_candidates(inst: dict, seed: int) -> dict[str, list[list[int]]]:
+    lengths = inst["source_lengths"]
+    candidates = {
+        "outlier_magnitude_chunks": _partition_by_key(
+            inst, lambda item: (lengths[item - 1], item)
+        ),
+        "input_order_chunks": _partition_by_key(inst, lambda item: item),
+        "by_hand_decimal_suffix": _partition_by_key(
+            inst, lambda item: (lengths[item - 1] % 1000, lengths[item - 1], item)
+        ),
+        "greedy_residual_average": _greedy_partition(inst),
+    }
+
+    base = min(lengths)
+    guessed_modulus = 0
+    for value in lengths:
+        guessed_modulus = math.gcd(guessed_modulus, value - base)
+    guessed_modulus = max(1, guessed_modulus)
+    candidates["global_difference_gcd_bucket"] = _partition_by_key(
+        inst,
+        lambda item: (
+            lengths[item - 1] % guessed_modulus,
+            lengths[item - 1],
+            item,
+        ),
+    )
+
+    restart_rng = random.Random(seed)
+    last = random_candidate(inst, restart_rng)
+    for _ in range(511):
+        candidate = random_candidate(inst, restart_rng)
+        if _fast_valid(inst, candidate):
+            last = candidate
+            break
+        last = candidate
+    candidates["random_restart_512"] = last
+    return candidates
+
+
+def _structural_decode(inst: dict) -> list[list[int]] | None:
+    buckets: dict[int, list[int]] = defaultdict(list)
+    for item_id, value in enumerate(inst["source_lengths"], 1):
+        buckets[value % _MODULUS].append(item_id)
+    if len(buckets) != len(inst["target_lengths"]):
+        return None
+    if any(len(block) != inst["group_size"] for block in buckets.values()):
+        return None
+    return _normalise_partition(list(buckets.values()))
+
+
+def _reference_exact_cover(inst: dict) -> tuple[list[list[int]] | None, dict]:
+    """Generic pair-sum enumeration followed by an exact-cover search."""
+
+    n = inst["n"]
+    values = inst["source_lengths"]
+    pair_rows: list[tuple[int, int, int]] = []
+    pair_map: dict[int, list[tuple[int, int]]] = defaultdict(list)
+    operations = 0
+    for left in range(n):
+        for right in range(left + 1, n):
+            pair_sum = values[left] + values[right]
+            pair_rows.append((left, right, pair_sum))
+            pair_map[pair_sum].append((left, right))
+            operations += 2
+
+    rows: list[tuple[int, tuple[int, int, int, int]]] = []
+    for target_id, target in enumerate(inst["target_lengths"]):
+        seen: set[tuple[int, int, int, int]] = set()
+        for left, right, pair_sum in pair_rows:
+            complements = pair_map.get(target - pair_sum, ())
+            operations += 2
+            for other_left, other_right in complements:
+                operations += 1
+                quad = tuple(sorted((left, right, other_left, other_right)))
+                if len(set(quad)) != _GROUP_SIZE or quad in seen:
+                    continue
+                if sum(values[index] for index in quad) != target:
+                    continue
+                operations += _GROUP_SIZE
+                seen.add(quad)
+                rows.append((target_id, quad))
+
+    column_rows: dict[tuple[str, int], list[int]] = defaultdict(list)
+    for row_id, (target_id, quad) in enumerate(rows):
+        column_rows[("target", target_id)].append(row_id)
+        for item in quad:
+            column_rows[("item", item)].append(row_id)
+
+    all_columns = {
+        *(("target", target_id) for target_id in range(len(inst["target_lengths"]))),
+        *(("item", item) for item in range(n)),
+    }
+    search_nodes = 0
+
+    def compatible(row_id: int, used_targets: set[int], used_items: set[int]) -> bool:
+        target_id, quad = rows[row_id]
+        return target_id not in used_targets and not used_items.intersection(quad)
+
+    def search(
+        used_targets: set[int], used_items: set[int], chosen: list[int]
+    ) -> list[int] | None:
+        nonlocal search_nodes
+        search_nodes += 1
+        if len(used_targets) == len(inst["target_lengths"]):
+            return list(chosen) if len(used_items) == n else None
+        uncovered = [
+            column for column in all_columns
+            if not (
+                (column[0] == "target" and column[1] in used_targets)
+                or (column[0] == "item" and column[1] in used_items)
+            )
+        ]
+        best_options: list[int] | None = None
+        for column in uncovered:
+            options = [
+                row_id for row_id in column_rows.get(column, ())
+                if compatible(row_id, used_targets, used_items)
+            ]
+            if not options:
+                return None
+            if best_options is None or len(options) < len(best_options):
+                best_options = options
+                if len(best_options) == 1:
+                    break
+        assert best_options is not None
+        for row_id in best_options:
+            target_id, quad = rows[row_id]
+            chosen.append(row_id)
+            result = search(
+                used_targets | {target_id}, used_items | set(quad), chosen
+            )
+            if result is not None:
+                return result
+            chosen.pop()
+        return None
+
+    solution_rows = search(set(), set(), []) if rows else None
+    answer = None
+    if solution_rows is not None:
+        answer = _normalise_partition([
+            [item + 1 for item in rows[row_id][1]] for row_id in solution_rows
+        ])
+    operations += search_nodes
+    return answer, {
+        "operations": operations,
+        "pair_count": len(pair_rows),
+        "candidate_rows": len(rows),
+        "search_nodes": search_nodes,
+    }
+
+
+def _atom_count(value: Any) -> int:
+    if isinstance(value, dict):
+        return sum(_atom_count(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_atom_count(item) for item in value)
+    return 1
+
+
+def _permute_instance(
+    inst: dict, rng: random.Random
+) -> tuple[dict, list[list[int]]]:
+    order = list(range(inst["n"]))
+    rng.shuffle(order)
+    old_to_new = {old + 1: new + 1 for new, old in enumerate(order)}
+    changed = dict(inst)
+    changed["source_lengths"] = [inst["source_lengths"][old] for old in order]
+    changed["target_lengths"] = list(reversed(inst["target_lengths"]))
+    carried = _normalise_partition([
+        [old_to_new[item] for item in block] for block in inst["answer"]
+    ])
+    changed["answer"] = carried
+    return changed, carried
+
+
+def selftest() -> dict:
+    """Run all mandatory gates and return a JSON-native measured report."""
+
+    report: dict[str, Any] = {
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    failures: list[str] = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in range(5):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                failures.append(f"{preset}/{seed}: {reason}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append(f"{preset}/{seed}: answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "attempts": attempts,
+        "failures": failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=314159, **shipping_params)
+    planted = json.loads(json.dumps(ship["answer"]))
+    swapped = json.loads(json.dumps(planted))
+    found_swap = False
+    for left in range(len(swapped)):
+        for right in range(left + 1, len(swapped)):
+            swapped[left][0], swapped[right][0] = swapped[right][0], swapped[left][0]
+            if not verify(ship, swapped)[0]:
+                found_swap = True
+                break
+            swapped[left][0], swapped[right][0] = swapped[right][0], swapped[left][0]
+        if found_swap:
+            break
+
+    duplicate = json.loads(json.dumps(planted))
+    duplicate[0][0] = duplicate[0][1]
+    out_of_range = json.loads(json.dumps(planted))
+    out_of_range[0][0] = ship["n"] + 1
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_one": swapped,
+        "duplicate_one": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    cases: dict[str, dict[str, Any]] = {}
+    reasons: list[str] = []
+    for name, candidate in corruptions.items():
+        ok, reason = verify(ship, candidate)
+        cases[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": found_swap
+        and all(case["rejected"] for case in cases.values())
+        and len(set(reasons)) == len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "cases": cases,
+    }
+
+    encoded = json.dumps(planted, separators=(",", ":"))
+    model_style = (
+        "I checked the endpoint concatenations exactly.\n"
+        f"<answer>\n```json\n{encoded}\n```\n</answer>\n"
+        "Each source component occurs once."
+    )
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("no tagged answer") is None,
+        "realistic_response_recovered": parsed == planted,
+        "garbage_returns_none": parse_answer("no tagged answer") is None,
+    }
+
+    guess_total = 200_000
+    guess_rng = random.Random(0x260424325)
+    guess_hits = 0
+    guess_started = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(_fast_valid(ship, random_candidate(ship, guess_rng)))
+    guess_seconds = time.perf_counter() - guess_started
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_total >= 200_000 and guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_fraction,
+        "candidate_space": search_space(ship),
+        "sample_wall_clock_sec": guess_seconds,
+        "sampler": "uniform partitions into unlabeled blocks of exactly four",
+    }
+
+    attack_names = (
+        "outlier_magnitude_chunks",
+        "input_order_chunks",
+        "by_hand_decimal_suffix",
+        "global_difference_gcd_bucket",
+        "greedy_residual_average",
+        "random_restart_512",
+    )
+    attack_successes = {name: 0 for name in attack_names}
+    attack_seconds = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    reference_times: list[float] = []
+    reference_operations: list[int] = []
+    reference_pairs: list[int] = []
+    reference_rows: list[int] = []
+    reference_nodes: list[int] = []
+    compact_successes = 0
+
+    for seed in range(8):
+        inst = make_instance(seed=12_000 + seed, **shipping_params)
+        candidates = _attack_candidates(inst, 700_000 + seed)
+        for name in attack_names:
+            started = time.perf_counter()
+            attack_successes[name] += int(_fast_valid(inst, candidates[name]))
+            attack_seconds[name] += time.perf_counter() - started
+
+        started = time.perf_counter()
+        reference_answer, counts = _reference_exact_cover(inst)
+        reference_times.append(time.perf_counter() - started)
+        reference_operations.append(counts["operations"])
+        reference_pairs.append(counts["pair_count"])
+        reference_rows.append(counts["candidate_rows"])
+        reference_nodes.append(counts["search_nodes"])
+        reference_successes += int(
+            reference_answer is not None and verify(inst, reference_answer)[0]
+        )
+        compact = _structural_decode(inst)
+        compact_successes += int(compact is not None and verify(inst, compact)[0])
+
+    attacks = {
+        name: {
+            "successes": attack_successes[name],
+            "attempts": 8,
+            "wall_clock_sec": attack_seconds[name],
+        }
+        for name in attack_names
+    }
+    all_attacks_failed = all(result["successes"] == 0 for result in attacks.values())
+    reference = {
+        "name": "pair-sum candidate enumeration plus Algorithm X exact cover",
+        "paper_location": "Theorem 2 and Lemma 6 (component partition formulation)",
+        "complexity": "O(t*s^2 + R) candidate generation plus output-sensitive exact cover",
+        "wall_clock_sec_mean": sum(reference_times) / len(reference_times),
+        "wall_clock_sec_max": max(reference_times),
+        "operations_mean": sum(reference_operations) / len(reference_operations),
+        "operations_max": max(reference_operations),
+        "pair_count_mean": sum(reference_pairs) / len(reference_pairs),
+        "candidate_rows_mean": sum(reference_rows) / len(reference_rows),
+        "search_nodes_mean": sum(reference_nodes) / len(reference_nodes),
+        "solves": f"{reference_successes}/8, as expected",
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    strongest_name = "random_restart_512"
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_fraction < 1e-6
+        and demo_count is not None and demo_count >= 1
+        and all_attacks_failed and reference_successes == 8,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_total": guess_total,
+        "shipping_observed_fraction": guess_fraction,
+        "shipping_structure_aware_space": search_space(ship),
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "baseline_attack": strongest_name,
+        "baseline_attack_wall_clock_sec": attack_seconds[strongest_name] / 8,
+        "baseline_attack_iterations": 512,
+        "reference_wall_clock_sec_mean": reference["wall_clock_sec_mean"],
+        "reference_operations_mean": reference["operations_mean"],
+        "reference_search_nodes_mean": reference["search_nodes_mean"],
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == 8
+        and compact_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": reference,
+        "compact_route": {
+            "name": "common-residue bucketing modulo 997",
+            "operations": ship["n"],
+            "solves": f"{compact_successes}/8",
+        },
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled_started = time.perf_counter()
+    doubled = make_instance(seed=314159, **doubled_params)
+    doubled_build_seconds = time.perf_counter() - doubled_started
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    ladder = [DIFFICULTY[name]["n"] for name in DIFFICULTY]
+    report["G7_scales"] = {
