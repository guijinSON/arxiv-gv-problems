+    carried = _canonical_groups([[old_to_new[i] for i in g] for g in inst["answer"]])
+    out = dict(inst)
+    out["source_path_lengths"] = lengths
+    out["target_path_length"] = multiplier * inst["target_path_length"] + 4 * translation
+    out["answer"] = carried
+    return out
