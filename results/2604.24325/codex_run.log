-def _reference_exact_cover(inst: dict) -> tuple[list[list[int]] | None, dict]:
-    """Generic pair-sum enumeration followed by an exact-cover search."""
-
-    n = inst["n"]
-    values = inst["source_lengths"]
-    pair_rows: list[tuple[int, int, int]] = []
-    pair_map: dict[int, list[tuple[int, int]]] = defaultdict(list)
-    operations = 0
-    for left in range(n):
-        for right in range(left + 1, n):
-            pair_sum = values[left] + values[right]
-            pair_rows.append((left, right, pair_sum))
-            pair_map[pair_sum].append((left, right))
-            operations += 2
-
-    rows: list[tuple[int, tuple[int, int, int, int]]] = []
-    for target_id, target in enumerate(inst["target_lengths"]):
-        seen: set[tuple[int, int, int, int]] = set()
-        for left, right, pair_sum in pair_rows:
-            complements = pair_map.get(target - pair_sum, ())
-            operations += 2
-            for other_left, other_right in complements:
-                operations += 1
-                quad = tuple(sorted((left, right, other_left, other_right)))
-                if len(set(quad)) != _GROUP_SIZE or quad in seen:
-                    continue
-                if sum(values[index] for index in quad) != target:
-                    continue
-                operations += _GROUP_SIZE
-                seen.add(quad)
-                rows.append((target_id, quad))
-
-    column_rows: dict[tuple[str, int], list[int]] = defaultdict(list)
-    for row_id, (target_id, quad) in enumerate(rows):
-        column_rows[("target", target_id)].append(row_id)
-        for item in quad:
-            column_rows[("item", item)].append(row_id)
-
-    all_columns = {
-        *(("target", target_id) for target_id in range(len(inst["target_lengths"]))),
-        *(("item", item) for item in range(n)),
-    }
-    search_nodes = 0
-
-    def compatible(row_id: int, used_targets: set[int], used_items: set[int]) -> bool:
-        target_id, quad = rows[row_id]
-        return target_id not in used_targets and not used_items.intersection(quad)
-
-    def search(
-        used_targets: set[int], used_items: set[int], chosen: list[int]
-    ) -> list[int] | None:
-        nonlocal search_nodes
-        search_nodes += 1
-        if len(used_targets) == len(inst["target_lengths"]):
-            return list(chosen) if len(used_items) == n else None
-        uncovered = [
-            column for column in all_columns
-            if not (
-                (column[0] == "target" and column[1] in used_targets)
-                or (column[0] == "item" and column[1] in used_items)
-            )
-        ]
-        best_options: list[int] | None = None
-        for column in uncovered:
-            options = [
-                row_id for row_id in column_rows.get(column, ())
-                if compatible(row_id, used_targets, used_items)
-            ]
-            if not options:
-                return None
-            if best_options is None or len(options) < len(best_options):
-                best_options = options
-                if len(best_options) == 1:
-                    break
-        assert best_options is not None
-        for row_id in best_options:
-            target_id, quad = rows[row_id]
-            chosen.append(row_id)
-            result = search(
-                used_targets | {target_id}, used_items | set(quad), chosen
-            )
-            if result is not None:
-                return result
-            chosen.pop()
-        return None
-
-    solution_rows = search(set(), set(), []) if rows else None
-    answer = None
-    if solution_rows is not None:
-        answer = _normalise_partition([
-            [item + 1 for item in rows[row_id][1]] for row_id in solution_rows
-        ])
-    operations += search_nodes
-    return answer, {
-        "operations": operations,
-        "pair_count": len(pair_rows),
-        "candidate_rows": len(rows),
-        "search_nodes": search_nodes,
-    }
-
-
-def _atom_count(value: Any) -> int:
-    if isinstance(value, dict):
-        return sum(_atom_count(item) for item in value.values())
-    if isinstance(value, (list, tuple)):
-        return sum(_atom_count(item) for item in value)
-    return 1
-
