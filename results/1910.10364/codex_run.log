%	$G$ and the task is to extend it into a proper coloring of $G$ with at most $r$ colors.
%	We show that the problem is $\fpt$ parameterized by the distance to threshold graphs.
%\end{enumerate}
\keywords{Parameterized complexity \and Precoloring extension \and Equitable coloring \and List coloring.}
\end{abstract}

\section{Introduction}


Given a graph $G$, and a positive integer $k$, the $k$-coloring problem is to color the vertices of $G$ with at most $k$ colors such that adjacent vertices receive different colors. 
