+        "attempts": 8,
+        "successes": 0
+      },
+      "spectral_bottom_eigenvector": {
+        "attempts": 8,
+        "successes": 0
+      }
+    },
+    "pass": true
+  },
+  "G7_scales": {
+    "base_n": 40,
+    "base_search_space_digits": 43,
+    "base_triples": 200,
+    "doubled_n": 80,
+    "doubled_search_space_digits": 86,
