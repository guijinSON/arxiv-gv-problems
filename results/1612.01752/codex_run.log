+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "An ordered pair [close_id, open_id] containing exactly one currently "
+        "open facility ID followed by exactly one currently closed facility "
