+    def clause_cost(first: int, second: int, weight: int) -> Fraction:
+        if first in open_tokens or second in open_tokens:
+            distance = Fraction(4, 3)
+        elif first ^ 1 in open_tokens or second ^ 1 in open_tokens:
+            distance = Fraction(5, 3)
+        else:
+            distance = Fraction(2)
+        return weight * distance
