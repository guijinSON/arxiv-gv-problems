+def _frobenius_root_reference(
+        inst: dict) -> tuple[list[int] | None, int, int]:
+    """Find roots of P(x)+1 over F_p by gcd(x^p-x, P(x)+1).
+
+    This deliberately does not use the planted perfect-cube identity.  It is
