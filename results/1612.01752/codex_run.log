+    inverse_lead = pow(left[1], -1, p)
+    operations += _inverse_euclid_steps(left[1], p)
+    coordinate = (-left[0] * inverse_lead) % p
+    operations += 2
+    return (_candidate_for_coordinate(inst, coordinate), operations,
+            polynomial_multiplications)
