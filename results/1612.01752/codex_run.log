+    operations += _inverse_euclid_steps(c3, p)
+    modulus = [((c0 + 1) * inverse_c3) % p,
+               (c1 * inverse_c3) % p,
+               (c2 * inverse_c3) % p, 1]
+    operations += 6
+
+    def multiply_mod(left: list[int], right: list[int]) -> list[int]:
+        nonlocal operations, polynomial_multiplications
+        polynomial_multiplications += 1
