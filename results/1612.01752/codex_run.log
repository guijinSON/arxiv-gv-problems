+def _direct_mufl_cost(inst: dict, open_tokens: set[int]) -> Fraction:
+    """Independently evaluate the explicitly rendered MUFL instance."""
+    total = Fraction(len(open_tokens) * inst["opening_cost"])
+    literal_weight = inst["literal_client_weight"]
+    for token in range(inst["facility_count"]):
+        distance = 0 if token in open_tokens else (1 if token ^ 1 in open_tokens else 2)
+        total += literal_weight * distance
