+        for i, x in enumerate(left):
+            for j, y in enumerate(right):
+                product[i + j] = (product[i + j] + x * y) % p
+                operations += 2
+        while len(product) >= len(modulus):
+            quotient = product[-1] % p
+            if quotient:
+                shift = len(product) - len(modulus)
+                for j in range(len(modulus) - 1):
