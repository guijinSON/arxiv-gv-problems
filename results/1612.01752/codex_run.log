+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "An ordered pair [close_id, open_id] containing exactly one currently "
+        "open facility ID followed by exactly one currently closed facility "
+        "ID; both IDs lie in the displayed finite facility range."
+    ),
+    "bounds": {
+        "length": 2,
+        "close_id": "one of the V currently open facilities",
+        "open_id": "one of the V currently closed facilities",
+        "candidate_count": "V squared",
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 11, "camouflage": 0},
+    "easy": {"n": 2003, "camouflage": 256},
+    "medium": {"n": 4001, "camouflage": 512},
+    "hard": {"n": 8009, "camouflage": 1024},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The balanced orientation columns are cubic images of one affine orbit "
