import importlib.util, time
spec=importlib.util.spec_from_file_location('g','gen_1612_01752.py')
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)

def root_via_frobenius(inst):
    p=inst['n']; c3,c2,c1,c0=inst['polynomial_coefficients']; ops=0
    # Polynomials use ascending coefficients. Normalize f=P+1 to monic.
    inv=pow(c3,-1,p)
    f=[(c0+1)*inv%p,c1*inv%p,c2*inv%p,1]
    # Count an extended-Euclid inverse by the same convention as the module.
    ops += g._inverse_euclid_steps(c3,p)
    ops += 3*2  # multiply/reduce for the lower coefficients
    def trim(a):
        while len(a)>1 and a[-1]%p==0: a.pop()
        return a
    def mulmod(a,b,mod):
        nonlocal ops
        z=[0]*(len(a)+len(b)-1)
        for i,x in enumerate(a):
            for j,y in enumerate(b):
                z[i+j]=(z[i+j]+x*y)%p; ops += 2
        for k in range(len(z)-1,len(mod)-2,-1):
            q=z[k]%p
            if q:
                for j in range(len(mod)-1):
                    z[k-len(mod)+1+j]=(z[k-len(mod)+1+j]-q*mod[j])%p; ops += 2
            z.pop()
        return trim(z)
    def sub(a,b):
        nonlocal ops
        z=[0]*max(len(a),len(b))
        for i in range(len(z)):
            z[i]=((a[i] if i<len(a) else 0)-(b[i] if i<len(b) else 0))%p; ops += 1
        return trim(z)
    def divrem(a,b):
        nonlocal ops
        a=a[:]; b=trim(b[:]); invlead=pow(b[-1],-1,p); ops += g._inverse_euclid_steps(b[-1],p)
        while len(a)>=len(b) and any(a):
            q=a[-1]*invlead%p; ops += 2
            shift=len(a)-len(b)
            for j,v in enumerate(b):
                a[shift+j]=(a[shift+j]-q*v)%p; ops += 2
            trim(a)
        return trim(a)
    base=[0,1]; acc=[1]
    for bit in bin(p)[2:]:
        acc=mulmod(acc,acc,f)
        if bit=='1': acc=mulmod(acc,base,f)
    h=sub(acc,base)
    a=f
    b=h
    while not (len(b)==1 and b[0]==0):
        a,b=b,divrem(a,b)
    # gcd is linear; root=-a0/a1
    invlead=pow(a[-1],-1,p); ops += g._inverse_euclid_steps(a[-1],p)
    root=(-a[0]*invlead)%p; ops += 2
    return root,ops
for seed in [0,1,4242,9100,9107]:
    inst=g.make_instance(seed=seed,**g.DIFFICULTY['medium'])
    t=time.perf_counter(); root,ops=root_via_frobenius(inst); dt=time.perf_counter()-t
    print(seed,root,ops,round(dt,6),g.verify(inst,g._candidate_for_coordinate(inst,root)))
