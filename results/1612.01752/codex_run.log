  total += i['literal_client_weight']*dist
 for a,b,w in clauses:
  dist=min(Fraction(4,3) if x in (a,b) else Fraction(5,3) if x in (mate[a],mate[b]) else 2 for x in O)
  total += w*dist
 return total
base=cost(i['current_open'])
fast=[]; exact=[]
for close in i['current_open']:
