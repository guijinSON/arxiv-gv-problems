-def canonical_key(inst: dict) -> str:
-    """Canonicalize facility IDs, input-row order, and variable relabelling.
-
-    Ordinary variables have every code 0,...,p-1 exactly once.  Their order is
-    therefore immaterial to the underlying metric instance; the sorted code
-    multiset plus all exact numeric weights is a complete cheap normal form for
-    this generated subfamily.
-    """
-    abstract = {
-        "family": inst["family"],
-        "n": inst["n"],
-        "camouflage": inst["camouflage"],
-        "codes": sorted(inst["codes"]),
-        "scale": inst["scale"],
-        "base_weight": inst["base_weight"],
-        "threshold_weight": inst["threshold_weight"],
-        "bit_high_weights": inst["bit_high_weights"],
-        "camouflage_weights": inst["camouflage_weights"],
-        "lock_weight": inst["lock_weight"],
-        "literal_client_weight": inst["literal_client_weight"],
-        "opening_cost": inst["opening_cost"],
-    }
-    blob = json.dumps(abstract, sort_keys=True, separators=(",", ":"))
-    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
-
-
-def escalate(params: dict) -> dict | str | None:
-    current_n = int(params["n"])
-    harder = _next_supported_prime(2 * current_n - 5)
-    # Both the ground set and the cancelling-clause crowding grow, while the
-    # two-ID witness remains fixed.  This grows the haystack, not the needle.
-    return {
-        "n": harder,
-        "camouflage": max(1, int(params.get("camouflage", 0)) * 2),
-    }
-
-
-# ---------------------------------------------------------------------------
-# Attacks and tests
-
-
-def _candidate_for_coordinate(inst: dict, coordinate: int) -> list[int]:
-    positive, negative = inst["pairs"][coordinate]
-    return [negative, positive]
-
-
-def _reference_gain_scan(inst: dict) -> tuple[list[int] | None, int]:
-    """Mechanical O(M) clause-incidence scan, including every camouflage term."""
-    operations = 0
-    for coordinate, code in enumerate(inst["codes"]):
-        gain = 0
-        for bit, high in enumerate(inst["bit_high_weights"]):
-            if (code >> bit) & 1:
-                gain += high
-                gain -= inst["base_weight"]
-            else:
-                gain += inst["base_weight"]
-                gain -= high
-            operations += 2
-        gain -= inst["threshold_weight"]
-        operations += 1
-        for weight in inst["camouflage_weights"]:
-            gain += weight
-            gain -= weight
-            operations += 2
-        if gain > 0:
-            return _candidate_for_coordinate(inst, coordinate), operations
-    # Scan the two guards too.  Their gains are -1 and 0.
-    operations += 2
-    return None, operations
-
-
-def _compact_route_operations(inst: dict) -> int:
-    inverse_exp = inst["inverse_exponent"]
-    root0 = pow(inst["codes"][0], inverse_exp, inst["n"])
-    root1 = pow(inst["codes"][1], inverse_exp, inst["n"])
-    slope = (root1 - root0) % inst["n"]
-    # Read two d-bit columns, two exponentiations, two subtractions, an exact
-    # inverse, a multiplication, and two facility-array lookups.
-    return (
-        2 * inst["bits"]
-        + 2 * _pow_multiplication_count(inverse_exp)
-        + _egcd_inverse_steps(slope, inst["n"])
-        + 5
-    )
-
-
-def _relabel_instance(inst: dict, permutation: list[int]) -> dict:
-    out = dict(inst)
-    out["pairs"] = [[permutation[a], permutation[b]]
-                    for a, b in inst["pairs"]]
-    out["current_open"] = sorted(permutation[x] for x in inst["current_open"])
-    out["currently_closed"] = sorted(
-        permutation[x] for x in inst["currently_closed"])
-    out["answer"] = [permutation[x] for x in inst["answer"]]
-    pair_of = [-1] * inst["facility_count"]
-    role_of = [""] * inst["facility_count"]
-    for pair_index, (positive, negative) in enumerate(out["pairs"]):
-        pair_of[positive] = pair_index
-        pair_of[negative] = pair_index
-        role_of[positive] = "positive"
-        role_of[negative] = "negative"
-    out["_pair_of"] = pair_of
-    out["_role_of"] = role_of
-    out["_current_set"] = set(out["current_open"])
-    out["_closed_set"] = set(out["currently_closed"])
-    return out
-
-
-def _attack_results(params: dict, attempts: int = 8) -> tuple[dict, dict]:
-    names = [
-        "outlier_pair_total_weight",
-        "greedy_highest_bit_first",
-        "random_restart_256",
-        "by_hand_prefix_8",
-        "uncubed_affine_ansatz",
-    ]
-    successes = {name: 0 for name in names}
-    reference_successes = 0
-    reference_operations = []
-    reference_times = []
-
-    for seed in range(9100, 9100 + attempts):
-        inst = make_instance(seed=seed, **params)
-
-        # Every ordinary pair has the same degree, total pair weight, and
-        # incident weight multiset.  An outlier probe therefore ties at i=0.
-        candidate = _candidate_for_coordinate(inst, 0)
-        successes[names[0]] += int(verify(inst, candidate)[0])
-
-        top_bit = inst["bits"] - 1
-        greedy_index = next(
-            (i for i, code in enumerate(inst["codes"])
-             if (code >> top_bit) & 1),
-            0,
-        )
-        successes[names[1]] += int(
-            verify(inst, _candidate_for_coordinate(inst, greedy_index))[0]
-        )
-
-        attack_rng = random.Random(0x5A17 + seed)
-        restart_hit = False
-        for _ in range(256):
-            if verify(inst, random_candidate(inst, attack_rng))[0]:
-                restart_hit = True
-                break
-        successes[names[2]] += int(restart_hit)
-
-        prefix_candidate = None
-        for i in range(min(8, inst["n"])):
-            cand = _candidate_for_coordinate(inst, i)
-            if verify(inst, cand)[0]:
-                prefix_candidate = cand
-                break
-        successes[names[3]] += int(prefix_candidate is not None)
-
-        t0, t1 = inst["codes"][0], inst["codes"][1]
-        denominator = (t1 - t0) % inst["n"]
-        if denominator:
-            guessed = ((inst["n"] - 1 - t0)
-                       * pow(denominator, -1, inst["n"])) % inst["n"]
-        else:
-            guessed = 0
-        successes[names[4]] += int(
-            verify(inst, _candidate_for_coordinate(inst, guessed))[0]
-        )
-
-        started = time.perf_counter()
-        ref_answer, ref_ops = _reference_gain_scan(inst)
-        reference_times.append(time.perf_counter() - started)
-        reference_operations.append(ref_ops)
-        reference_successes += int(
-            ref_answer is not None and verify(inst, ref_answer)[0]
-        )
-
-    attacks = {
-        name: {"successes": successes[name], "attempts": attempts}
-        for name in names
-    }
-    reference = {
-        "name": "exact clause-incidence flip-gain scan",
-        "complexity": "O(M) exact signed integer additions",
-        "wall_clock_sec": round(sum(reference_times) / attempts, 6),
-        "operations": max(reference_operations),
-        "solves": f"{reference_successes}/{attempts}, as expected",
-    }
-    return attacks, reference
-
-
-def selftest() -> dict:
