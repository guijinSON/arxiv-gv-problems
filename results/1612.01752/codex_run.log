def _orientation_rows(inst: dict) -> list[tuple[int, str]]:
    rows = []
    for bit in inst["bit_order"]:
        row = "".join("1" if (code >> bit) & 1 else "0"
                      for code in inst["codes"])
        rows.append((bit, row))
    return rows


def render(inst: dict) -> str:
    p = inst["n"]
    pairs = inst["pairs"]
    positive_ids = ",".join(str(pairs[i][0]) for i in range(p))
    negative_ids = ",".join(str(pairs[i][1]) for i in range(p))
    z_positive, z_negative = pairs[inst["z_pair_index"]]
    y_positive, y_negative = pairs[inst["y_pair_index"]]
    bit_lines = []
    for bit, row in _orientation_rows(inst):
        bit_lines.append(
            f"bit={bit} delta={inst['scale'] * (1 << bit)} "
            f"high={inst['bit_high_weights'][bit]} row={row}"
        )
    camouflage_rule = (
        "none"
        if not inst["camouflage_weights"]
        else (
            f"for r=0,...,{len(inst['camouflage_weights']) - 1}, use weight "
            f"B+s*(2^d+r+1) (these are {len(inst['camouflage_weights'])} "
            "additional cancelling pairs per coordinate)"
        )
    )

    statement = f"""Weighted metric facility-location single replacement

There are {inst['facility_count']} facilities, with integer IDs 0 through {inst['facility_count'] - 1}.
They form {inst['variable_pair_count']} complementary pairs.  Coordinates i=0,...,{p - 1}
are ordinary pairs; the last two pairs are named z and y.  In every pair the
first displayed ID is the positive literal and the second is its complement.

For ordinary coordinates, indexed from 0 at the LEFT of every orientation row:
POSITIVE_IDS={positive_ids}
NEGATIVE_IDS={negative_ids}
z_pair={z_positive},{z_negative}
y_pair={y_positive},{y_negative}

The currently open set contains the negative ID of every pair (including z and y):
CURRENT_OPEN={','.join(map(str, inst['current_open']))}

This compact specification defines the complete MUFL instance.  It is not an
approximation.  There is one client co-located with every literal facility; every
such client has integer weight W={inst['literal_client_weight']}.  Every facility
has opening cost 2W={inst['opening_cost']}.

There are also weighted clause clients.  A clause client is specified by two
literal-facility IDs a,b.  Its distance is 4/3 from a and b, 5/3 from the
complementary facilities mate(a),mate(b), and 2 from every other facility.
A literal client has distance 0 from its own facility, 1 from its complement,
and 2 from every other facility.  Distinct clause clients are distance 2 from
one another.  Together with symmetry and distance 0 on identical points, these
rules define the metric.  The cost of an open set is opening cost plus, for every
client, its weight times its distance to the nearest open facility.

Here is the exact clause-client rule.  Put p={p}, d={inst['bits']},
B={inst['base_weight']}, and s={inst['scale']}.  For each ordinary coordinate i
and each orientation line below, create two distinct clients.  If row[i]=1,
create (positive_i,z_positive) with weight high and
(negative_i,z_positive) with weight B.  If row[i]=0, exchange those two
weights.  The row index convention is inclusive and 0-based.

ORIENTATION_ROWS
{chr(10).join(bit_lines)}

For every ordinary i also create (negative_i,z_positive) with threshold weight
C={inst['threshold_weight']}.  Camouflage rule: {camouflage_rule}.
Each camouflage r creates both (positive_i,z_positive) and
(negative_i,z_positive) with the same stated weight.  Finally create the guard
client (z_negative,y_positive) with weight L={inst['lock_weight']}.
Thus there are exactly M={inst['clause_count']} clause clients.  Repeated literal
pairs denote distinct clients and are allowed.

Task: replace exactly one currently open facility by exactly one currently
closed facility so that the exact MUFL cost strictly decreases.  Order matters:
write the closed ID first and the newly opened ID second.  IDs cannot repeat.

Give your final answer inside <answer></answer> tags, as two decimal integers
close_id, open_id.  Example: <answer>7, 12</answer>
Output nothing else inside the tags."""
    mode = os.environ.get("GV_HINT_MODE")
    if mode == "structural":
        statement += "\n\nHint: " + STRUCTURAL_HINT
    elif mode == "placebo":
        statement += "\n\nHint: " + PLACEBO_HINT
    return statement


def parse_answer(text: str) -> object | None:
    if not isinstance(text, str):
        return None
    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text,
                        flags=re.IGNORECASE | re.DOTALL)
    if not blocks:
        return None
    body = blocks[-1].strip()
    if body.startswith("[") and body.endswith("]"):
        body = body[1:-1].strip()
    match = re.fullmatch(r"([+-]?\d+)\s*,\s*([+-]?\d+)", body)
    if not match:
        return None
    try:
        return [int(match.group(1)), int(match.group(2))]
    except ValueError:
        return None


def _variable_gain(inst: dict, coordinate: int) -> int:
    code = inst["codes"][coordinate]
    gain = 0
    for bit, high in enumerate(inst["bit_high_weights"]):
        if (code >> bit) & 1:
            gain += high - inst["base_weight"]
        else:
            gain += inst["base_weight"] - high
    gain -= inst["threshold_weight"]
    # Every camouflage pair contributes +R and -R exactly.
    return gain


def verify(inst: dict, answer: object) -> tuple[bool, str]:
    """Check any valid improving replacement; never consult inst['answer']."""
    if answer == []:
        return False, "answer is empty"
    if not isinstance(answer, list):
        return False, "answer must be a list of two integer facility IDs"
    if len(answer) == 1:
        return False, "answer is incomplete: open_id is missing"
    if len(answer) != 2:
        return False, "answer must contain exactly two facility IDs"
    close_id, open_id = answer
    if (isinstance(close_id, bool) or isinstance(open_id, bool)
            or not isinstance(close_id, int) or not isinstance(open_id, int)):
        return False, "both facility IDs must be integers"
    if close_id == open_id:
        return False, "the two facility IDs must be distinct"
    if not (0 <= close_id < inst["facility_count"]
            and 0 <= open_id < inst["facility_count"]):
        return False, "a facility ID is outside the stated range"
    if close_id not in inst["_current_set"]:
        return False, "close_id is not currently open"
    if open_id not in inst["_closed_set"]:
        return False, "open_id is not currently closed"

    close_pair = inst["_pair_of"][close_id]
    open_pair = inst["_pair_of"][open_id]
    if close_pair != open_pair:
        # The two affected literal pairs change their service cost from 2W to
        # 4W: +2W.  Across all clauses the best possible saving is at most
        # (2/3)*sum(weights) <= (2/3)W, because W=M*w_max.  Hence this exact
        # lower bound on new-old cost is +4W/3.
        return False, (
            "cross-pair replacement is not improving: its literal-client "
            "penalty exceeds every possible clause-client saving"
        )
    if inst["_role_of"][close_id] != "negative" \
            or inst["_role_of"][open_id] != "positive":
        return False, "replacement does not flip the displayed complementary pair"

    if close_pair < inst["n"]:
        gain = _variable_gain(inst, close_pair)
    elif close_pair == inst["z_pair_index"]:
        gain = -1
    else:
        gain = 0
    if gain <= 0:
        return False, (
            f"replacement is not strictly improving: exact clause-weight "
            f"gain is {gain}, so the scaled MUFL cost does not decrease"
        )
    return True, "ok"


def random_candidate(inst: dict, rng: random.Random) -> object:
    r"""Uniformly sample the exact stated language O x (F\O)."""
    return [rng.choice(inst["current_open"]),
            rng.choice(inst["currently_closed"])]


def search_space(inst: dict) -> int | None:
    return len(inst["current_open"]) * len(inst["currently_closed"])


def enumerate_all(inst: dict) -> int | None:
    space = search_space(inst)
    if space is None or space > 200_000:
        return None
    total = 0
    for close_id in inst["current_open"]:
        for open_id in inst["currently_closed"]:
            if verify(inst, [close_id, open_id])[0]:
                total += 1
    return total


def canonical_key(inst: dict) -> str:
    """Canonicalize facility IDs, input-row order, and variable relabelling.

    Ordinary variables have every code 0,...,p-1 exactly once.  Their order is
    therefore immaterial to the underlying metric instance; the sorted code
    multiset plus all exact numeric weights is a complete cheap normal form for
    this generated subfamily.
    """
    abstract = {
        "family": inst["family"],
        "n": inst["n"],
        "camouflage": inst["camouflage"],
        "codes": sorted(inst["codes"]),
        "scale": inst["scale"],
        "base_weight": inst["base_weight"],
        "threshold_weight": inst["threshold_weight"],
        "bit_high_weights": inst["bit_high_weights"],
        "camouflage_weights": inst["camouflage_weights"],
        "lock_weight": inst["lock_weight"],
        "literal_client_weight": inst["literal_client_weight"],
        "opening_cost": inst["opening_cost"],
    }
    blob = json.dumps(abstract, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def escalate(params: dict) -> dict | str | None:
    current_n = int(params["n"])
    harder = _next_supported_prime(2 * current_n - 5)
    # Both the ground set and the cancelling-clause crowding grow, while the
    # two-ID witness remains fixed.  This grows the haystack, not the needle.
    return {
        "n": harder,
        "camouflage": max(1, int(params.get("camouflage", 0)) * 2),
    }


# ---------------------------------------------------------------------------
# Attacks and tests


def _candidate_for_coordinate(inst: dict, coordinate: int) -> list[int]:
    positive, negative = inst["pairs"][coordinate]
    return [negative, positive]


def _reference_gain_scan(inst: dict) -> tuple[list[int] | None, int]:
    """Mechanical O(M) clause-incidence scan, including every camouflage term."""
    operations = 0
    for coordinate, code in enumerate(inst["codes"]):
        gain = 0
        for bit, high in enumerate(inst["bit_high_weights"]):
            if (code >> bit) & 1:
                gain += high
                gain -= inst["base_weight"]
            else:
                gain += inst["base_weight"]
                gain -= high
            operations += 2
        gain -= inst["threshold_weight"]
        operations += 1
        for weight in inst["camouflage_weights"]:
            gain += weight
            gain -= weight
            operations += 2
        if gain > 0:
        if gain > 0:
            return _candidate_for_coordinate(inst, coordinate), operations
    # Scan the two guards too.  Their gains are -1 and 0.
    operations += 2
    return None, operations


def _compact_route_operations(inst: dict) -> int:
    inverse_exp = inst["inverse_exponent"]
    root0 = pow(inst["codes"][0], inverse_exp, inst["n"])
    root1 = pow(inst["codes"][1], inverse_exp, inst["n"])
    slope = (root1 - root0) % inst["n"]
    # Read two d-bit columns, two exponentiations, two subtractions, an exact
    # inverse, a multiplication, and two facility-array lookups.
    return (
        2 * inst["bits"]
        + 2 * _pow_multiplication_count(inverse_exp)
        + _egcd_inverse_steps(slope, inst["n"])
        + 5
    )


def _relabel_instance(inst: dict, permutation: list[int]) -> dict:
    out = dict(inst)
    out["pairs"] = [[permutation[a], permutation[b]]
                    for a, b in inst["pairs"]]
    out["current_open"] = sorted(permutation[x] for x in inst["current_open"])
    out["currently_closed"] = sorted(
        permutation[x] for x in inst["currently_closed"])
    out["answer"] = [permutation[x] for x in inst["answer"]]
    pair_of = [-1] * inst["facility_count"]
    role_of = [""] * inst["facility_count"]
    for pair_index, (positive, negative) in enumerate(out["pairs"]):
        pair_of[positive] = pair_index
        pair_of[negative] = pair_index
        role_of[positive] = "positive"
        role_of[negative] = "negative"
    out["_pair_of"] = pair_of
    out["_role_of"] = role_of
    out["_current_set"] = set(out["current_open"])
    out["_closed_set"] = set(out["currently_closed"])
    return out


def _attack_results(params: dict, attempts: int = 8) -> tuple[dict, dict]:
    names = [
        "outlier_pair_total_weight",
        "greedy_highest_bit_first",
        "random_restart_256",
        "by_hand_prefix_8",
        "uncubed_affine_ansatz",
    ]
    successes = {name: 0 for name in names}
    reference_successes = 0
    reference_operations = []
    reference_times = []

    for seed in range(9100, 9100 + attempts):
        inst = make_instance(seed=seed, **params)

        # Every ordinary pair has the same degree, total pair weight, and
        # incident weight multiset.  An outlier probe therefore ties at i=0.
        candidate = _candidate_for_coordinate(inst, 0)
        successes[names[0]] += int(verify(inst, candidate)[0])

        top_bit = inst["bits"] - 1
        greedy_index = next(
            (i for i, code in enumerate(inst["codes"])
             if (code >> top_bit) & 1),
            0,
        )
        successes[names[1]] += int(
            verify(inst, _candidate_for_coordinate(inst, greedy_index))[0]
        )

        attack_rng = random.Random(0x5A17 + seed)
        restart_hit = False
        for _ in range(256):
            if verify(inst, random_candidate(inst, attack_rng))[0]:
                restart_hit = True
                break
        successes[names[2]] += int(restart_hit)

        prefix_candidate = None
        for i in range(min(8, inst["n"])):
            cand = _candidate_for_coordinate(inst, i)
            if verify(inst, cand)[0]:
                prefix_candidate = cand
                break
        successes[names[3]] += int(prefix_candidate is not None)

        t0, t1 = inst["codes"][0], inst["codes"][1]
        denominator = (t1 - t0) % inst["n"]
        if denominator:
            guessed = ((inst["n"] - 1 - t0)
                       * pow(denominator, -1, inst["n"])) % inst["n"]
        else:
            guessed = 0
        successes[names[4]] += int(
            verify(inst, _candidate_for_coordinate(inst, guessed))[0]
        )

        started = time.perf_counter()
        ref_answer, ref_ops = _reference_gain_scan(inst)
        reference_times.append(time.perf_counter() - started)
        reference_operations.append(ref_ops)
        reference_successes += int(
            ref_answer is not None and verify(inst, ref_answer)[0]
        )

    attacks = {
        name: {"successes": successes[name], "attempts": attempts}
        for name in names
    }
    reference = {
        "name": "exact clause-incidence flip-gain scan",
        "complexity": "O(M) exact signed integer additions",
        "wall_clock_sec": round(sum(reference_times) / attempts, 6),
        "operations": max(reference_operations),
        "solves": f"{reference_successes}/{attempts}, as expected",
    }
    return attacks, reference


def selftest() -> dict:
    report: dict = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}

    planted_attempts = 0
    planted_failures = []
    for preset, params in DIFFICULTY.items():
        for seed in (0, 1, 8675309):
            inst = make_instance(seed=seed, **params)
            planted_attempts += 1
            ok, reason = verify(inst, inst["answer"])
            if not ok:
                planted_failures.append([preset, seed, reason])
            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
                planted_failures.append([preset, seed, "answer is not JSON-native"])
    report["G1_planted_verifies"] = {
        "pass": not planted_failures,
        "attempts": planted_attempts,
        "failures": planted_failures,
    }

    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
    sample_inst = make_instance(seed=4242, **shipping_params)
    planted = sample_inst["answer"]
    corruptions = {
        "drop_one": planted[:1],
        "swap_order": [planted[1], planted[0]],
        "duplicate": [planted[0], planted[0]],
        "empty": [],
        "out_of_range": [planted[0], sample_inst["facility_count"]],
    }
    corruption_results = {}
    reasons = []
    for name, candidate in corruptions.items():
        ok, reason = verify(sample_inst, candidate)
        corruption_results[name] = {"rejected": not ok, "reason": reason}
        reasons.append(reason)
    g2_pass = (all(v["rejected"] for v in corruption_results.values())
               and len(set(reasons)) == len(reasons))
    report["G2_rejects_corruption"] = {
        "pass": g2_pass,
        "cases": corruption_results,
        "distinct_reasons": len(set(reasons)),
    }

    model_style = (
        "I compared the exact costs.\n```text\n"
        f"<answer>{planted[0]}, {planted[1]}</answer>\n```\n"
        "The first ID is closed and the second is opened."
    )
    parsed = parse_answer(model_style)
    report["G3_round_trip"] = {
        "pass": parsed == planted and parse_answer("garbage") is None,
        "parsed": parsed,
    }

    guess_total = 200_000
    guess_hits = 0
    guess_rng = random.Random(20270117)
    for _ in range(guess_total):
        guess_hits += int(verify(sample_inst,
                                 random_candidate(sample_inst, guess_rng))[0])
    exact_density = 1.0 / search_space(sample_inst)
    report["G4_guess_resistance"] = {
        "pass": guess_total >= 200_000 and exact_density < 1e-6,
        "hits": guess_hits,
        "total": guess_total,
        "sampled_fraction": guess_hits / guess_total,
        "exact_fraction": exact_density,
        "structure_aware_space": search_space(sample_inst),
    }

    started = time.perf_counter()
    baseline_answer, baseline_ops = _reference_gain_scan(sample_inst)
    baseline_wall = time.perf_counter() - started
    baseline_ok = (baseline_answer is not None
                   and verify(sample_inst, baseline_answer)[0])
    density_rng = random.Random(20270118)
    density_total = 200_000
    density_hits = 0
    for _ in range(density_total):
        density_hits += int(verify(
            sample_inst, random_candidate(sample_inst, density_rng))[0])
    report["G5_density_and_baseline"] = {
        "pass": baseline_ok and density_total >= 200_000,
        "shipping_valid_answer_count": 1,
        "shipping_exact_density": exact_density,
        "shipping_sample_hits": density_hits,
        "shipping_sample_total": density_total,
        "shipping_sampled_fraction": density_hits / density_total,
        "baseline_wall_seconds": round(baseline_wall, 6),
        "baseline_iterations": sample_inst["n"],
        "baseline_operation_count": baseline_ops,
    }

    attacks, reference = _attack_results(shipping_params, attempts=8)
    all_failed = all(result["successes"] == 0 for result in attacks.values())
    report["G6_adversary_panel"] = {
        "pass": all_failed,
        "attacks": attacks,
        "reference_algorithm": reference,
    }

    harder_params = escalate(shipping_params)
    g7_ok = isinstance(harder_params, dict)
    harder_reason = "escalate did not return parameters"
    if g7_ok:
        harder_inst = make_instance(seed=271828, **harder_params)
        g7_ok, harder_reason = verify(harder_inst, harder_inst["answer"])
        g7_ok = g7_ok and harder_inst["n"] > sample_inst["n"]
    report["G7_scales"] = {
        "pass": bool(g7_ok),
        "from": shipping_params,
        "to": harder_params,
        "verification": harder_reason,
        "answer_elements_before": _answer_atoms(sample_inst["answer"]),
        "answer_elements_after": (
            _answer_atoms(harder_inst["answer"]) if g7_ok else None
        ),
    }

    invariant_checks = 0
    carried_checks = 0
    distinct_keys = []
    g8_failures = []
    for offset in range(20):
        inst = make_instance(seed=70000 + offset, **shipping_params)
        key = canonical_key(inst)
        relabel_rng = random.Random(80000 + offset)
        permutation = list(range(inst["facility_count"]))
        relabel_rng.shuffle(permutation)
        transformed = _relabel_instance(inst, permutation)
        transformed["bit_order"] = list(reversed(transformed["bit_order"]))
        invariant_checks += 1
        if canonical_key(transformed) != key:
            g8_failures.append([offset, "key changed under relabelling"])
        carried_checks += 1
        if not verify(transformed, transformed["answer"])[0]:
            g8_failures.append([offset, "carried answer stopped verifying"])
        distinct_keys.append(key)
    distinct_count = len(set(distinct_keys))
    report["G8_canonical_key"] = {
        "pass": not g8_failures and distinct_count == 20,
        "invariance_checks": invariant_checks,
        "carried_witness_checks": carried_checks,
        "distinct_unrelated_keys": distinct_count,
        "unrelated_attempts": 20,
        "failures": g8_failures,
    }

    answer_blob = json.dumps(sample_inst["answer"], separators=(",", ":"))
    answer_chars = len(answer_blob)
    answer_tokens = math.ceil(answer_chars / 4)
    answer_elements = _answer_atoms(sample_inst["answer"])
    route_ops = _compact_route_operations(sample_inst)
    arms = {
        name: dict(G9_EVIDENCE[name])
        for name in ("bare", "hinted", "placebo")
    }
    hinted_attempts = arms["hinted"]["attempts"]
    placebo_attempts = arms["placebo"]["attempts"]
    hinted_rate = (arms["hinted"]["solved"] / hinted_attempts
                   if hinted_attempts else 0.0)
    placebo_rate = (arms["placebo"]["solved"] / placebo_attempts
                    if placebo_attempts else 0.0)
    g9_caps = (answer_chars <= 2000 and answer_elements <= 256
               and route_ops <= 300)
    g9_oracle = (G9_EVIDENCE["hinted_verdict"] == "hardened"
                 and hinted_attempts >= 3)
    report["G9_no_tool_suitability"] = {
        "pass": g9_caps and g9_oracle,
        "arms": arms,
        "hinted_minus_placebo": hinted_rate - placebo_rate,
        "hinted_verdict": G9_EVIDENCE["hinted_verdict"],
        "answer_chars": answer_chars,
        "answer_tokens": answer_tokens,
        "answer_elements": answer_elements,
        "intended_route_operations": route_ops,
    }

    report["all_passed"] = all(
        isinstance(value, dict) and value.get("pass")
        for key, value in report.items()
        if key.startswith("G") and key[1:2].isdigit()
    )
    return report


if __name__ == "__main__":
    print(json.dumps(selftest(), indent=2, sort_keys=True))

