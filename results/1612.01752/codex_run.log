/bin/bash -lc "python3 - <<'PY'
import time,json
import gen_1612_01752 as g
x=g.make_instance(seed=4242,**g.DIFFICULTY['medium'])
t=time.perf_counter(); a,ops,it=g._reference_swap_scan(x); dt=time.perf_counter()-t
print(json.dumps({'answer':x['answer'],'chars':len(json.dumps(x['answer'],separators=(',',':'))),'tokens':__import__('math').ceil(len(json.dumps(x['answer'],separators=(',',':')))/4),'operations':ops,'iterations':it,'wall':round(dt,6),'route_ops':g._compact_route_operations(x),'verify':g.verify(x,a)},indent=2))
