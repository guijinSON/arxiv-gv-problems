import importlib.util
s=importlib.util.spec_from_file_location('m','gen_1612_01752.py');m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
i=m.make_instance(seed=17,**m.DIFFICULTY['demo'])
mate={a:b for a,b in i['pairs'] for a,b in ((a,b),(b,a))}
zp,zn=i['pairs'][i['z_pair_index']]
yp,yn=i['pairs'][i['y_pair_index']]
clauses=[]
for coord,code in enumerate(i['codes']):
 p,n=i['pairs'][coord]
 for bit,hi in enumerate(i['bit_high_weights']):
  if (code>>bit)&1: clauses += [(p,zp,hi),(n,zp,i['base_weight'])]
  else: clauses += [(p,zp,i['base_weight']),(n,zp,hi)]
 clauses.append((n,zp,i['threshold_weight']))
 for w in i['camouflage_weights']: clauses += [(p,zp,w),(n,zp,w)]
clauses.append((zn,yp,i['lock_weight']))
assert len(clauses)==i['clause_count']
def cost(opened):
 O=set(opened); total=Fraction(len(O)*i['opening_cost'])
 for f in range(i['facility_count']):
