+DIFFICULTY: dict = {
+    "demo": {"n": 11, "camouflage": 0},
+    "easy": {"n": 2003, "camouflage": 256},
+    "medium": {"n": 4001, "camouflage": 512},
+    "hard": {"n": 8009, "camouflage": 1024},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The balanced orientation columns are cubic images of one affine orbit "
+    "modulo the displayed prime."
+)
+PLACEBO_HINT = (
