+    invariance_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    distinct_keys = []
+    for seed in range(20):
+        original = make_instance(seed=7000 + seed, **DIFFICULTY["easy"])
+        original_key = canonical_key(original)
+        distinct_keys.append(original_key)
+        variant = copy.deepcopy(original)
+        for round_index in range(4):
