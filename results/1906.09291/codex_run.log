+        "shipping_structure_aware_space": search_space(inst),
+        "doubled_structure_aware_space": search_space(doubled),
+        "doubled_verify_reason": doubled_reason,
+        "next_parameters": escalated,
+    }
+
+    invariance_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    distinct_keys = []
+    for seed in range(20):
