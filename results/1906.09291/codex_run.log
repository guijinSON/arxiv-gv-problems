+
+def _sample_betas(p: int, rows: int, rng: random.Random):
+    """Sample one reverse-Lemma plant and rows-1 Lemma-backed decoys."""
+    plant = None
+    decoys = []
+    used_orbits = set()
+    budget = max(2_000, 300 * rows)
+    candidates = [rng.randrange(2, p - 1) for _ in range(budget)]
