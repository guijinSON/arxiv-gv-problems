+
+def _transform_instance(inst: dict, rng: random.Random):
+    """Independent affine row relabelings, factor swaps, and row reordering."""
+    p = inst["p"]
+    original_answer = inst["answer"]
+    plant_old = original_answer[0]
+    transformed_rows = []
+    row_maps = []
+    swaps = []
+    for row in inst["rows"]:
