+import copy
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "After centering a row at its two matching centers, each mate map has two "
+    "linear branches selected by quadratic character."
+)
+PLACEBO_HINT: str = (
