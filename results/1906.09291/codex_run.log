import time

def qr(a,q):
    a%=q
    return a and pow(a,(q-1)//2,q)==1

def valid(beta,q):
    beta%=q
    inv2=(q+1)//2
    excluded={2,inv2,q-1}
    if beta in excluded or beta==0 or qr(beta,q) or pow(beta,3,q)==q-1:
        return False
    m1=qr((beta*beta+1)*inv2,q)
    m2=qr((beta-1)*inv2,q)
    return m1 or m2

qs=[11,19,43,59,107,251,499,1019,4091,10007,100003,1000003]
for q in qs:
    if q%4"'!=3: continue
    # primality quick check
    if any(q%d==0 for d in range(2,int(q**.5)+1)): continue
    t=time.perf_counter(); vals=[b for b in range(1,q) if valid(b,q)]; dt=time.perf_counter()-t
    first=vals[0] if vals else None
    print(q,len(vals),f'"'{len(vals)/(q-1):.6f}',first,f'{dt:.6f}s')
