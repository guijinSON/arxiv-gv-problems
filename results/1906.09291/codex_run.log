+def _attack_outlier(inst: dict):
+    p = inst["p"]
+    index = max(range(len(inst["rows"])), key=lambda j: abs(inst["rows"][j]["beta"] - p // 2))
+    return _cycle_from_start(inst, index, inst["rows"][index]["a"])
