+def _attack_greedy(inst: dict):
+    p = inst["p"]
+    index = min(
+        range(len(inst["rows"])),
+        key=lambda j: min(
+            (inst["rows"][j]["b"] - inst["rows"][j]["a"]) % p,
+            (inst["rows"][j]["a"] - inst["rows"][j]["b"]) % p,
+        ),
+    )
+    start = min(inst["rows"][index]["a"], inst["rows"][index]["b"])
+    return _cycle_from_start(inst, index, start)
