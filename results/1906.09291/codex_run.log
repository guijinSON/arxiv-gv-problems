+def _residue_product(beta: int, p: int) -> int:
+    # It has the same quadratic character as (beta^2+1)/(beta-1), because a
+    # nonzero value and its inverse have the same quadratic character.
+    return ((beta * beta + 1) % p) * ((beta - 1) % p) % p
