+def _attack_greedy(inst: dict):
+    p = inst["p"]
+    index = min(
+        range(len(inst["rows"])),
+        key=lambda j: min(
+            (inst["rows"][j]["b"] - inst["rows"][j]["a"]) % p,
+            (inst["rows"][j]["a"] - inst["rows"][j]["b"]) % p,
