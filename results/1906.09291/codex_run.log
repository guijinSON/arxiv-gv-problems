+            "a": (scale * row["a"] + shift) % p,
+            "b": (scale * row["b"] + shift) % p,
+            "beta": beta,
+        }
+        swap = bool(rng.randrange(2))
+        if swap:
+            new_row["a"], new_row["b"] = new_row["b"], new_row["a"]
