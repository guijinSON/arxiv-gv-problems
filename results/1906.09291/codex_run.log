+"""Verified finite-field one-factor C4 generator for arXiv:1906.09291."""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
