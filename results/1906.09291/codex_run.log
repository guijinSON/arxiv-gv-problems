+    placebo_rate = arms["placebo"]["solved"] / placebo_attempts if placebo_attempts else 0.0
+    intended_operations = int(statistics.median(compact_operations))
+    hinted_hardened = G9_RESULTS["hinted_verdict"] == "hardened"
