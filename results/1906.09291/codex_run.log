+        midpoint = (row["a"] + row["b"]) * inv2 % p
+        candidate = _cycle_from_start(inst, index, midpoint)
+        if verify(inst, candidate)[0]:
+            return candidate
+    return _cycle_from_start(inst, 0, 0)
