+def _plant_beta_ok(beta: int, p: int) -> bool:
+    if beta in (0, 1, p - 1) or _legendre(beta, p) != -1:
+        return False
+    if _legendre(_residue_product(beta, p), p) != -1:
+        return False
+    if _legendre(beta - 1, p) != _legendre(2, p):
+        return False
