+        "in_context_infinity_component": {"successes": 0, "attempts": 0},
+        "in_context_midpoint_ansatz": {"successes": 0, "attempts": 0},
+    }
+    reference_successes = 0
+    reference_times = []
+    reference_operations = []
+    reference_steps = []
+    compact_successes = 0
+    compact_times = []
