+
+    attack_results = {
+        "outlier_beta_magnitude": {"successes": 0, "attempts": 0},
+        "greedy_smallest_center_gap": {"successes": 0, "attempts": 0},
+        "random_restart_4096": {"successes": 0, "attempts": 0},
+        "in_context_infinity_component": {"successes": 0, "attempts": 0},
