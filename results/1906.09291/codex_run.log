+        return center
+    if vertex == center:
+        return p
+    delta = (vertex - center) % p
+    multiplier = beta if _legendre(delta, p) == 1 else pow(beta, -1, p)
+    return (center + multiplier * delta) % p
+
+
+def _cycle_from_start(inst: dict, row_index: int, start: int) -> list[int]:
