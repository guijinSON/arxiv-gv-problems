+    all_attacks_failed = all(entry["successes"] == 0 for entry in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == 8 and compact_successes == 8,
+        "attacks": attack_results,
