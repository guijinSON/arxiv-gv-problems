from math import isqrt

def prime(p): return p>1 and all(p%d for d in range(2,isqrt(p)+1))
def qr(x,p): return x%p and pow(x%p,(p-1)//2,p)==1

def valid_b(b,p):
    if not (b and not qr(b,p)) or b in (p-1,): return False
    if (b-1)%p==0: return False
    R=(b*b+1)*pow(b-1,-1,p)%p
    return not qr(R,p) and qr(b-1,p)==qr(2,p)
def part(z,c,b,p):
    if z==p:return c
    if z==c:return p
    d=(z-c)%p
    return (c+d*(b if qr(d,p) else pow(b,-1,p)))%p
def cyc4starts(p,b,i):
    good=[]
    for s in range(p+1):
        z=s
        arr=[]
        for c in (0,i,0,i):
            arr.append(z); z=part(z,c,b,p)
        if z==s and len(set(arr))==4: good.append(s)
    return good
for p in range(11,2000,4):
    if not prime(p):continue
    bs=[b for b in range(2,p) if valid_b(b,p) and pow(b,3,p)"'!=p-1]
    if not bs:continue
    b=bs[len(bs)//2]; a=pow(3,2,p) # qr
    i=a*b*(b+1)*pow(b-1,-1,p)%p
    starts=cyc4starts(p,b,i)
    # planted
    c=(a-i)*b+i; ab=a*b%p; d=(ab-i)*b+i
    ok=len({a,ab,d%p,c%p})==4
    print(p,b,'"'nc4',len(starts)//4,'inf',p in starts,'plant',ok,[a,ab,d%p,c%p]);
    if p>500: break
