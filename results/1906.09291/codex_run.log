from math import isqrt

def qr(x,p): return x%p and pow(x%p,(p-1)//2,p)==1

def roots(p): return [x for x in range(p) if (x*x-x+1)%p==0]
def partner(z,c,b,p):
    if z==p: return c
    if z==c: return p
    d=(z-c)%p
    return (c + d*(b if qr(d,p) else pow(b,-1,p)))%p

def comps(p,b,i=1):
    seen=set(); out=[]
    for s in range(p+1):
        if s in seen: continue
        cyc=[]; z=s; which=0
        while z not in cyc:
            cyc.append(z); seen.add(z)
            z=partner(z,0 if which==0 else i,b,p); which"'^=1
        out.append(cyc)
    return sorted(map(len,out))
for p in [7,19,31,43,67,79,103,127,139,151,163,199,211,223,271,283,307,331,367,379,463,487,499,523,547,571,607,619,631,643,691,727,739,751,787,811,823,859,883,907,919,967,991,1009,1039,1051,1063,1087,1111,1123,1171,1207,1219,1231,1259,1291,1303,1327,1367,1399,1423]:
    if p%12!=7 or any(p%d==0 for d in range(2,isqrt(p)+1)): continue
    rs=roots(p)
    if not rs: continue
    for b in rs[:1]:
        cs=comps(p,b)
        print(p,b,'"'c4',cs.count(4),'min',cs[:12],'ncomp',len(cs))
