+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "Exactly five base-10 integers [r,v0,v1,v2,v3]: a zero-based row index "
+        "and four distinct vertex labels in the stated 0..q range, cyclically "
