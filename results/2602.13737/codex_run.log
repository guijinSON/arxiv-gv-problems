+            "solves": f"{compact_successes}/{len(seeds)}, as expected",
+        },
+    }
+
+    doubled = make_instance(
+        n=2 * default_difficulty[SHIPPING_DIFFICULTY]["n"],
+        spread=default_difficulty[SHIPPING_DIFFICULTY]["spread"], seed=77)
+    report["G7_scales"] = {
