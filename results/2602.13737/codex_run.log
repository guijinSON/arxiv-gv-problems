+    "description": (
+        "A JSON object {\"offsets\":[s_AB,s_BC,s_CA]} with one residue "
+        "chosen from each displayed offset set.  It symbolically denotes all "
+        "q directed triangles obtained by translating one triangle through "
+        "Z/qZ."
+    ),
+    "bounds": {
