+        "rejected": sum(v["rejected"] for v in reasons.values()),
+        "attempts": len(reasons),
+        "distinct_reasons": distinct_reasons,
+        "cases": reasons,
+    }
+
+    model_style = (
+        "The modular offsets close as required.\n<answer>\n```json\n"
+        + json.dumps(shipping["answer"])
