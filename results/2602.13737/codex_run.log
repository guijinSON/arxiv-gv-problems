+def _affine_transform(inst, rng, rotate=0, reorder=False):
+    """Carry an instance and witness through a genuine graph relabelling."""
+    q = inst["q"]
+    while True:
+        unit = rng.randrange(1, q)
+        if math.gcd(unit, q) == 1:
+            break
