+    for start, char in enumerate(payload):
+        if char != "{":
+            continue
+        try:
+            value, _ = decoder.raw_decode(payload[start:])
+        except (ValueError, TypeError):
+            continue
+        if isinstance(value, dict):
+            return value
+    return None
