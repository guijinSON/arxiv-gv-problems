+
+def random_candidate(inst, rng):
+    """Sample uniformly after applying all obvious shape/membership rules."""
+    return {"offsets": [rng.choice(values)
+                         for values in inst["offset_sets"]]}
+
+
+def search_space(inst):
+    return inst["d"] ** 3
