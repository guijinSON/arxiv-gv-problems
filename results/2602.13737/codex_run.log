import random,time,statistics

def mk(n, seed, p=.78):
    rng=random.Random(seed)
    perm=list(range(n)); rng.shuffle(perm)
    e=set()
    # plant directed C3 factor
    planted=[]
    for i in range(0,n,3):
        a,b,c=perm[i:i+3]
        e.update(((a,b),(b,c),(c,a))); planted.append((a,b,c))
    for a in range(n):
        for b in range(n):
            if a"'!=b and rng.random()<p: e.add((a,b))
    return e,planted

def cyc_order(e,a,b,c):
    for x,y,z in ((a,b,c),(a,c,b)):
        if (x,y) in e and (y,z) in e and (z,x) in e: return (x,y,z)
    return None

def exact_cover(e,n):
    tests=nodes=backs=0
    # simplest domain-standard exact-cover DFS: anchor smallest remaining vertex
    def rec(rem):
        nonlocal tests,nodes,backs
        nodes+=1
        if not rem: return []
        a=min(rem); others=sorted(rem-{a})
        # candidates are already structure-aware: only directed cyclic triangles
        for ii,b in enumerate(others):
            for c in others[ii+1:]:
                tests+=1
                o=cyc_order(e,a,b,c)
                if o:
                    got=rec(rem-{a,b,c})
                    if got is not None: return [o]+got
                    backs+=1
        return None
    t=time.perf_counter(); ans=rec(set(range(n))); wall=time.perf_counter()-t
    return ans,tests,nodes,backs,wall

def greedy_restarts(e,n,seed,restarts=256):
    rng=random.Random(seed); tests=0
    for r in range(restarts):
        rem=list(range(n)); rng.shuffle(rem); ans=[]; ok=True
        while rem:
            a=rem.pop()
            found=None
            # randomized greedy: first cyclic triangle through a
            rng.shuffle(rem)
            for ii,b in enumerate(rem):
                for c in rem[ii+1:]:
                    tests+=1
                    o=cyc_order(e,a,b,c)
                    if o: found=(b,c,o); break
                if found: break
            if not found: ok=False; break
            b,c,o=found; rem.remove(b); rem.remove(c); ans.append(o)
        if ok: return True,r+1,tests
    return False,restarts,tests

for n in (48,96,192):
    rows=[]
    for seed in range(8):
        e,plant=mk(n,seed)
        indeg=[sum((u,v) in e for u in range(n) if u!=v) for v in range(n)]
        outdeg=[sum((v,u) in e for u in range(n) if u!=v) for v in range(n)]
        threshold=(2/3+.05)*n
        degree_ok=min(indeg+outdeg)>=threshold
        ans,tests,nodes,backs,wall=exact_cover(e,n)
        gok,tries,gtests=greedy_restarts(e,n,seed''^999)
        rows.append((degree_ok,tests,nodes,backs,wall,gok,tries,gtests,len(e)))
    print('"'n',n,'degree_ok',sum(x[0] for x in rows),'/8')
    print(' exact success',sum(x[1] is not None for x in rows),'/8',
          'tests median/max',statistics.median(x[1] for x in rows),max(x[1] for x in rows),
          'nodes median/max',statistics.median(x[2] for x in rows),max(x[2] for x in rows),
          'backs median/max',statistics.median(x[3] for x in rows),max(x[3] for x in rows),
          'wall median/max',round(statistics.median(x[4] for x in rows),6),round(max(x[4] for x in rows),6))
    print(' greedy success',sum(x[5] for x in rows),'/8','tries', [x[6] for x in rows], 'tests median',statistics.median(x[7] for x in rows))
