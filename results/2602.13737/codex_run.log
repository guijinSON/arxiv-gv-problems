+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3, "service_errors": 0},
+    "hinted": {"solved": 3, "attempts": 3, "service_errors": 0},
+    "placebo": {"solved": 1, "attempts": 3, "service_errors": 0},
+    "hinted_verdict": "too_easy at shipping preset: 3/3 solved (diagnostic only)",
+}
