+
+# Filled after the script-owned oracle runs.  These arms are diagnostic; only
+# the answer-size and intended-operation caps gate G9.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0, "service_errors": 0},
+    "hinted": {"solved": 0, "attempts": 0, "service_errors": 0},
+    "placebo": {"solved": 0, "attempts": 0, "service_errors": 0},
+    "hinted_verdict": "not yet run",
