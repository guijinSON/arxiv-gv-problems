import itertools,random,time,statistics,json
N=192; P=0.80; ATTEMPTS=20

def make(seed):
    rng=random.Random(seed); order=list(range(N));rng.shuffle(order);e=set();pl=[]
    for i in range(0,N,3):
        a,b,c=order[i:i+3]
        # a,b,c in the transitive order
        e.update(((a,b),(a,c),(b,c)));pl.append((a,b,c))
    for a in range(N):
        for b in range(N):
            if a"'!=b and rng.random()<P:e.add((a,b))
    return e,pl

def t3order(e,a,b,c):
    # Any order x<y<z with arcs x->y,x->z,y->z witnesses T3.
    for x,y,z in itertools.permutations((a,b,c)):
        if (x,y) in e and (x,z) in e and (y,z) in e:return (x,y,z)
    return None

def exact_cover(e):
    tests=nodes=backtracks=0
    def rec(rem):
        nonlocal tests,nodes,backtracks
        nodes+=1
        if not rem:return []
        a=min(rem); others=sorted(rem-{a})
        for i,b in enumerate(others):
            for c in others[i+1:]:
                tests+=1;o=t3order(e,a,b,c)
                if o is None:continue
                got=rec(rem-{a,b,c})
                if got is not None:return [o]+got
                backtracks+=1
        return None
