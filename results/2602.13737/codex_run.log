+
+def search_space(inst):
+    return inst["d"] ** 3
+
+
+def _all_pair_solutions(inst):
+    q = inst["q"]
+    third = set(inst["offset_sets"][2])
+    found = []
+    probes = 0
+    for a in inst["offset_sets"][0]:
+        for b in inst["offset_sets"][1]:
+            probes += 1
+            c = (-a - b) % q
+            if c in third:
+                found.append({"offsets": [a, b, c]})
