+    "writing the final matrix."
+)
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON object {\"maps\":[[1,0],[1,c1],[-1,c2],[-1,c3]]}.  Every "
+        "shift is an integer in [0,M-1], and c1=(c2+c3) mod M.  Thus c2 and "
+        "c3 are the two free bounded entries and the structure-aware language "
+        "contains exactly M^2 matrices."
+    ),
+    "bounds": {
