+        try:
+            return json.loads(cleaned)
+        except (TypeError, ValueError):
+            pass
+        for match in re.finditer(r"\{", cleaned):
+            try:
+                value, _end = decoder.raw_decode(cleaned[match.start() :])
+                return value
+            except ValueError:
