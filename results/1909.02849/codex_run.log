+        items.sort(key=lambda item: (sign * item["size"]) % modulus)
+        bands.append(
+            {
+                "name": name,
+                "sign": sign,
+                "items": [
+                    {"id": item["id"], "size": item["size"]} for item in items
+                ],
+            }
+        )
