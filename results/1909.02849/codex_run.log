+if os.environ.get("GV_G9_SINGLE") == "1":
+    DIFFICULTY = {"easy": dict(DIFFICULTY[SHIPPING_DIFFICULTY])}
+
+
+STRUCTURAL_HINT = (
+    "The cyclic gap word of each fixed-sign residue row is a rotation of the "
+    "first row, with one uniquely long gap."
+)
+
+PLACEBO_HINT = (
