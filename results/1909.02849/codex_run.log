            return False, f"row {_BAND_NAMES[band_index]} has a different label set"
    for label in sorted(base_labels):
        quartet = [label_maps[band][label] for band in range(4)]
        if sum(item["size"] for item in quartet) != inst["target"]:
            return False, f"the quartet with normalized label {label} misses K"
        if len({item["id"] for item in quartet}) != 4:
            return False, f"the quartet with normalized label {label} repeats an item"
    if len(base_labels) != inst["m"]:
        return False, "the matrix does not induce exactly m quartets"
    # Recompute the reduction's scalar target, an exact consistency check on the
    # Kingdomino macro instance rather than an appeal to stored answer data.
    m = inst["m"]
    scaled_target = 28 * inst["target"]
    expected_score = 72 * m * m + 54 * m + (scaled_target // 2) * (3 * m + 1) + 1
    if inst["scaled_target"] != scaled_target or inst["score_target"] != expected_score:
        return False, "the compressed Kingdomino score data are inconsistent"
    return True, "ok"


def random_candidate(inst, rng):
    """Uniform candidate from the structure-aware two-shift language."""
    modulus = inst["modulus"]
    c2 = rng.randrange(modulus)
    c3 = rng.randrange(modulus)
    return _make_answer((0, (c2 + c3) % modulus, c2, c3))


def search_space(inst):
    return inst["modulus"] ** 2


def enumerate_all(inst):
    """Brute-force the bounded language only when it has at most 50k members."""
    if search_space(inst) > 50_000:
        return None
    count = 0
    modulus = inst["modulus"]
    for c2 in range(modulus):
        for c3 in range(modulus):
            candidate = _make_answer((0, (c2 + c3) % modulus, c2, c3))
            count += int(verify(inst, candidate)[0])
    return count


def canonical_key(inst):
    """Key on unlabeled item multisets per semantic magnitude band."""
    payload = {
        "modulus": inst["modulus"],
        "target": inst["target"],
        "bands": [
            sorted(item["size"] for item in band["items"])
            for band in inst["bands"]
        ],
    }
    blob = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
    return hashlib.sha256(blob).hexdigest()


def escalate(params):
    """Grow row crowding while the compact cyclic-gap route remains under cap."""
    current = {key: value for key, value in params.items() if key != "_preset"}
    n = int(current.get("n", 0))
    if n >= 280:
        return "cap_bound"
    new_n = min(280, n + 40)
    new_n -= new_n % 4
    current["n"] = new_n
    current["quotient_total"] = max(
        int(current.get("quotient_total", 80)), new_n // 3
    )
    if new_n + 3 > 300:
        return "cap_bound"
    return current


def _candidate_from_shifts(shifts):
    return _make_answer(shifts)


def _attack_candidates(inst, seed):
    rows = [_row_signed_residues(band, inst["modulus"]) for band in inst["bands"]]
    vectors = _simple_shift_vectors_from_rows(rows, inst["modulus"])
    attacks = {
        name: [_candidate_from_shifts(vector)] for name, vector in vectors.items()
    }
    rng = random.Random((seed << 20) ^ 0x190902849)
    attacks["random_restart_256"] = [random_candidate(inst, rng) for _ in range(256)]
    return attacks


def _reference_translate(inst):
    """Generic anchored O(m^2) set-translation matcher for each row."""
    modulus = inst["modulus"]
    rows = [_row_signed_residues(band, modulus) for band in inst["bands"]]
    base = set(rows[0])
    shifts = [0]
    candidate_alignments = 0
    modular_evaluations = 0
    for band_index in range(1, 4):
        source = rows[band_index]
        anchor = source[0]
        found = None
        for target in rows[0]:
            candidate_alignments += 1
            shift = (target - anchor) % modulus
            shifted = set()
            for value in source:
                modular_evaluations += 1
                shifted.add((value + shift) % modulus)
            if shifted == base:
                found = shift
                break
        if found is None:
            return None, {
                "candidate_alignments": candidate_alignments,
                "modular_evaluations": modular_evaluations,
            }
        shifts.append(found)
    answer = _make_answer(shifts)
    return answer, {
        "candidate_alignments": candidate_alignments,
        "modular_evaluations": modular_evaluations,
    }


def _compact_gap_solve(inst):
    modulus = inst["modulus"]
    rows = [_row_signed_residues(band, modulus) for band in inst["bands"]]
    anchors = [_cyclic_gap_anchor(row, modulus) for row in rows]
    if any(anchor is None for anchor in anchors):
        return None
    shifts = [0] + [(anchors[0] - anchors[index]) % modulus for index in range(1, 4)]
    return _make_answer(shifts)


def _atomic_elements(value):
    if isinstance(value, dict):
        return sum(_atomic_elements(child) for child in value.values())
    if isinstance(value, list):
        return sum(_atomic_elements(child) for child in value)
    return 1


def _relabel_variants(inst, seed):
    rng = random.Random(seed)
    variants = []

    reversed_rows = copy.deepcopy(inst)
    for band in reversed_rows["bands"]:
        band["items"].reverse()
    variants.append(reversed_rows)

    reordered = copy.deepcopy(inst)
    for band in reordered["bands"]:
        rng.shuffle(band["items"])
    variants.append(reordered)

    relabelled = copy.deepcopy(inst)
    labels = list(range(1, inst["n"] + 1))
    shuffled = list(labels)
    rng.shuffle(shuffled)
    mapping = dict(zip(labels, shuffled))

