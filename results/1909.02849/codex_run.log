+            [[2, 0], [2, 0]],
+            [[3, 0], [3, 0]],
+            [[4, 0], [4, 0]],
+        ],
+        "square": {"domino": [[1, 0], [1, 0]], "repeat": 18 * m * m - 6},
+        "contour_prefix": [
+            [[1, 0], [5, 1]],
+            [[5, 0], [6, 1]],
+            [[6, 0], [7, 1]],
+            [[7, 0], [8, 1]],
+            [[8, 0], [1, 0]],
+            [[8, 0], [1, 0]],
+            [[8, 0], [2, 0]],
+            [[8, 0], [9, 1]],
