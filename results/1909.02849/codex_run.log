+def verify(inst, answer):
+    """Check any valid affine matrix without consulting ``inst['answer']``."""
+    maps, reason = _validate_answer_shape(inst, answer)
+    if maps is None:
+        return False, reason
+    modulus = inst["modulus"]
+    label_maps = []
+    for band_index, band in enumerate(inst["bands"]):
+        sign, shift = maps[band_index]
+        labelled = {}
+        for item in band["items"]:
+            label = (sign * (item["size"] % modulus) + shift) % modulus
+            if label in labelled:
+                return False, f"row {band['name']} has a repeated normalized label"
+            labelled[label] = item
+        label_maps.append(labelled)
+    base_labels = set(label_maps[0])
+    for band_index in range(1, 4):
+        if set(label_maps[band_index]) != base_labels:
+            return False, f"row {_BAND_NAMES[band_index]} has a different label set"
+    for label in sorted(base_labels):
+        quartet = [label_maps[band][label] for band in range(4)]
+        if sum(item["size"] for item in quartet) != inst["target"]:
+            return False, f"the quartet with normalized label {label} misses K"
+        if len({item["id"] for item in quartet}) != 4:
