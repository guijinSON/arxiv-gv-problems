+# G9 scratch copies set this so harden.py runs exactly the shipping rung.
+if os.environ.get("GV_G9_SINGLE") == "1":
+    DIFFICULTY = {"easy": dict(DIFFICULTY[SHIPPING_DIFFICULTY])}
