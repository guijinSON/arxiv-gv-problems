+def _reference_translate(inst):
+    """Generic anchored O(m^2) set-translation matcher for each row."""
+    modulus = inst["modulus"]
+    rows = [_row_signed_residues(band, modulus) for band in inst["bands"]]
+    base = set(rows[0])
+    shifts = [0]
+    candidate_alignments = 0
+    modular_evaluations = 0
+    for band_index in range(1, 4):
+        source = rows[band_index]
+        anchor = source[0]
+        found = None
+        for target in rows[0]:
+            candidate_alignments += 1
+            shift = (target - anchor) % modulus
+            shifted = set()
+            for value in source:
+                modular_evaluations += 1
+                shifted.add((value + shift) % modulus)
+            if shifted == base:
+                found = shift
+                break
+        if found is None:
+            return None, {
+                "candidate_alignments": candidate_alignments,
+                "modular_evaluations": modular_evaluations,
+            }
+        shifts.append(found)
+    answer = _make_answer(shifts)
+    return answer, {
+        "candidate_alignments": candidate_alignments,
+        "modular_evaluations": modular_evaluations,
+    }
+
+
+def _compact_gap_solve(inst):
+    modulus = inst["modulus"]
+    rows = [_row_signed_residues(band, modulus) for band in inst["bands"]]
+    anchors = [_cyclic_gap_anchor(row, modulus) for row in rows]
+    if any(anchor is None for anchor in anchors):
+        return None
+    shifts = [0] + [(anchors[0] - anchors[index]) % modulus for index in range(1, 4)]
+    return _make_answer(shifts)
+
+
+def _atomic_elements(value):
+    if isinstance(value, dict):
+        return sum(_atomic_elements(child) for child in value.values())
+    if isinstance(value, list):
+        return sum(_atomic_elements(child) for child in value)
+    return 1
+
