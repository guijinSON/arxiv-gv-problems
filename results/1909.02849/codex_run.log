+def random_candidate(inst, rng):
+    """Uniform candidate from the structure-aware two-shift language."""
+    modulus = inst["modulus"]
+    c2 = rng.randrange(modulus)
+    c3 = rng.randrange(modulus)
+    return _make_answer((0, (c2 + c3) % modulus, c2, c3))
