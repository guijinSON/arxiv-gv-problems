+def _relabel_variants(inst, seed):
+    rng = random.Random(seed)
+    variants = []
+
+    reversed_rows = copy.deepcopy(inst)
+    for band in reversed_rows["bands"]:
+        band["items"].reverse()
+    variants.append((reversed_rows, copy.deepcopy(inst["answer"])))
