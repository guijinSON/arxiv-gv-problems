+def _composition4(total, rng):
+    """Uniform stars-and-bars composition of total into four labelled parts."""
+    bars = sorted(rng.sample(range(total + 3), 3))
+    return [
+        bars[0],
+        bars[1] - bars[0] - 1,
+        bars[2] - bars[1] - 1,
+        total + 2 - bars[2],
