+        reference_successes += int(
+            recovered is not None and verify(trial, recovered)[0]
+        )
+        compact = _compact_gap_solve(trial)
+        compact_successes += int(compact is not None and verify(trial, compact)[0])
+
+    attacks = {
+        name: {
+            "successes": successes[name],
