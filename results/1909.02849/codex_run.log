+def _validate_answer_shape(inst, answer):
+    if not isinstance(answer, dict):
+        return None, "answer must be a JSON object"
+    if set(answer) != {"maps"}:
+        return None, 'answer object must contain exactly the key "maps"'
+    maps = answer["maps"]
+    if not isinstance(maps, list) or len(maps) != 4:
+        return None, "maps must contain exactly four rows"
+    for index, row in enumerate(maps):
+        if not isinstance(row, list) or len(row) != 2:
+            return None, f"map row {index} must contain exactly two integers"
+        if not all(isinstance(value, int) and not isinstance(value, bool) for value in row):
+            return None, f"map row {index} contains a non-integer"
+    signs = [row[0] for row in maps]
+    if signs != list(_SIGNS):
+        return None, "map multipliers must be +1,+1,-1,-1 in A,B,C,D order"
+    shifts = [row[1] for row in maps]
+    modulus = inst["modulus"]
+    if shifts[0] != 0:
+        return None, "the anchor-row shift must be zero"
+    if any(shift < 0 or shift >= modulus for shift in shifts[1:]):
+        return None, f"every free shift must lie in [0,{modulus-1}]"
+    if shifts[1] != (shifts[2] + shifts[3]) % modulus:
+        return None, "the shifts violate c1=(c2+c3) mod M"
+    return maps, "ok"
