+def _attack_candidates(inst, seed):
+    rows = [_row_signed_residues(band, inst["modulus"]) for band in inst["bands"]]
+    vectors = _simple_shift_vectors_from_rows(rows, inst["modulus"])
+    attacks = {
+        name: [_candidate_from_shifts(vector)] for name, vector in vectors.items()
+    }
+    rng = random.Random((seed << 20) ^ 0x190902849)
+    attacks["random_restart_256"] = [random_candidate(inst, rng) for _ in range(256)]
+    return attacks
