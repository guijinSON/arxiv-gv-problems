+def escalate(params):
+    """Grow row crowding while the compact cyclic-gap route remains under cap."""
+    current = {key: value for key, value in params.items() if key != "_preset"}
+    n = int(current.get("n", 0))
+    if n >= 280:
+        return "cap_bound"
+    new_n = min(280, n + 40)
+    new_n -= new_n % 4
+    current["n"] = new_n
+    current["quotient_total"] = max(
