+    "reduction_source": "paper_central",
+    "intuition_type": "reduction recognition",
+    "intuition_description": (
+        "Vertices born together must be independent, so after recognizing the "
+        "paper's universal-clique construction the three final growth slots "
+        "are exactly a proper 3-colouring of the sparse factor; without this "
+        "recognition one searches directly over growth schedules."
+    ),
+    "hardness_basis": (
