  for z in range(n):
   # randomized among top saturation degree
   cand=[v for v in range(n) if colors[v]<0]
   mx=max((len(sat[v]),len(A[v])) for v in cand)
   top=[v for v in cand if (len(sat[v]),len(A[v]))==mx]
   v=rng.choice(top); avail=[c for c in range(k) if c not in sat[v]]
   if not avail:break
   c=rng.choice(avail);colors[v]=c
   for u in A[v]:
    if colors[u]<0:sat[u].add(c)
  else:return colors
 return None

def minconf(A,k,rng,restarts=20,steps=5000):
