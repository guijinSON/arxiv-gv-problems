   if hc[i]"'!=hc[j] and r.randrange(den)<num:A[i]|=1<<j;A[j]|=1<<i
 return A

def dsatur(A,k,limit=100000):
 n=len(A); C=[-1]*n;S=[0]*n;D=[x.bit_count() for x in A];nodes=0;cap=False;t=time.perf_counter()
 def rec(done):
  nonlocal nodes,cap
  nodes+=1
  if nodes>limit:cap=True;return None
  if done==n:return C[:]
  v=max((x for x in range(n) if C[x]<0),key=lambda x:(S[x].bit_count(),D[x],-x));f=S[v];m=max(C)
  for c in range(min(k,m+2)):
