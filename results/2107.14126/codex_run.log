+    p = dict(params)
+    n = int(p["n"])
+    num = int(p.get("edge_num", 13))
+    den = int(p.get("edge_den", 100))
+    # First tighten at fixed witness length.  This shrinks the solution set
+    # while remaining below the planted-color spectral threshold in this range.
