        assert g.verify(i,i['answer']) == (True,'ok')
        assert json.loads(json.dumps(i['answer'])) == i['answer']
        assert g.parse_answer('prose <answer>'+json.dumps(i['answer'])+'</answer> end') == i['answer']
print('compile/interface/G1/G3 smoke: ok')
print('hint lengths:',len(g.STRUCTURAL_HINT),len(g.PLACEBO_HINT))
print('shipping render chars:',len(g.render(g.make_instance(seed=0,**g.DIFFICULTY[g.SHIPPING_DIFFICULTY]))))
