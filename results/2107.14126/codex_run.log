+
+    # G6 is measured before G5 so G5 can report the strongest baseline cost.
+    attack_names = [
+        "degree_quantile_outlier",
+        "greedy_dsatur_no_backtrack",
+        "randomized_greedy_256",
+        "spectral_bottom_eigenspace",
+        "exact_dsatur_100k_nodes",
