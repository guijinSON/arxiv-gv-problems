+            native = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            checks += 1
+            if not (ok and native):
+                failures.append({"preset": preset, "seed": seed,
+                                 "reason": reason, "json_native": native})
+    report["G1_planted_verifies"] = {
