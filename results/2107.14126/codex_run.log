def graph(n,k,num,den,seed):
 r=random.Random(seed); hidden=[]; ids=list(range(n));r.shuffle(ids); q,rem=divmod(n,k);at=0
 for c in range(k):hidden.append(ids[at:at+q+(c<rem)]);at+=q+(c<rem)
 hc=[0]*n
