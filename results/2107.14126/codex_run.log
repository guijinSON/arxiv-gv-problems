CONTINUOUS = {"geometry", "analysis", "dynamics", "optimization"}
DISCRETE_CORE = {"graph", "csp_sat", "exact_cover", "subset_sum", "permutation"}
# Read what the SOLVER is actually shown, not the dict key names -- renaming
