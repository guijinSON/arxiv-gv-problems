+        all_rejected &= not ok
+        rejection_reasons[name] = why
+    report["G2_rejects_corruption"] = {
+        "pass": all_rejected and len(set(rejection_reasons.values())) == 5,
+        "reasons": rejection_reasons,
+    }
+
+    # G3: realistic surrounding prose, fences, and exact JSON round trip.
