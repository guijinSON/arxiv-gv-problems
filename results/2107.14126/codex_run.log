+def escalate(params):
+    p = dict(params)
+    n = int(p["n"])
+    num = int(p.get("edge_num", 13))
+    den = int(p.get("edge_den", 100))
+    # First tighten at fixed witness length.  This shrinks the solution set
+    # while remaining below the planted-color spectral threshold in this range.
+    if den == 100 and num < 15:
+        p["edge_num"] = num + 1
+        return p
+    # Then grow the graph while the certificate remains within 256 atoms.
+    if n < 256:
+        p["n"] = min(256, n + 16)
+        p["edge_num"] = 13
+        p["edge_den"] = 100
+        return p
+    return "cap_bound"
 
 
