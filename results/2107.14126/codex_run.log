+        sigs = [(colors[v], tuple(sorted(colors[u] for u in adj[v])))
+                for v in range(n)]
+        palette = {sig: i for i, sig in enumerate(sorted(set(sigs)))}
+        new = [palette[sig] for sig in sigs]
+        if new == colors:
