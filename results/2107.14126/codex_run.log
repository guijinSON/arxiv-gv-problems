+def _stirling2(n, k):
+    if k < 0 or k > n:
+        return 0
+    row = [0] * (k + 1)
+    row[0] = 1
+    for _ in range(n):
+        nxt = [0] * (k + 1)
+        for j in range(1, k + 1):
+            nxt[j] = row[j - 1] + j * row[j]
+        row = nxt
+    return row[k]
+
