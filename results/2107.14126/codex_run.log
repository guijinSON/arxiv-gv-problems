import importlib.util, json, os, random
p='gen_2107_14126.py'
s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
assert g.TRACK in {'A','B'}
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.SHIPPING_DIFFICULTY"'!='"'demo'
i=g.make_instance(seed=424242,**g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
assert g.verify(i,i['answer'])==(True,'ok')
assert json.loads(json.dumps(i['answer']))==i['answer']
wire='<answer>'+json.dumps(i['answer'],separators=(',',':'))+'</answer>'
assert g.parse_answer('prose\\n"'```'"\\n'+wire+'\\n"'```'"\\nmore')==i['answer']
assert 'Hint:' not in g.render(i)
os.environ['GV_HINT_MODE']='structural'; assert g.STRUCTURAL_HINT in g.render(i)
os.environ['GV_HINT_MODE']='placebo'; assert g.PLACEBO_HINT in g.render(i)
os.environ.pop('GV_HINT_MODE')
for seed in range(20):
    c=g.random_candidate(i,random.Random(seed))
    assert isinstance(c,list) and len(c)==i['colors']
    assert sorted(v for part in c for v in part)==list(range(i['n']))
rep=json.load(open('selftest_report.json'))
assert rep['all_passed'] and all(v.get('pass') for k,v in rep.items() if k.startswith('G'))
print('final local validation: ok')
print('track',g.TRACK,'shipping',g.SHIPPING_DIFFICULTY)
print('answer chars/elements',rep['G9_no_tool_suitability']['answer_chars'],rep['G9_no_tool_suitability']['answer_elements'])
print('oracle scoreable attempts',sum(1 for line in open('llm_loop_transcript.jsonl') if json.loads(line).get('solved')"'!='"'error'))
