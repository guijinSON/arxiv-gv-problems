+    hidden = []
+    pos = 0
+    for c in range(colors):
+        size = q + (1 if c < rem else 0)
+        hidden.append(vertices[pos:pos + size])
+        pos += size
+    hidden_color = [0] * n
+    for c, group in enumerate(hidden):
