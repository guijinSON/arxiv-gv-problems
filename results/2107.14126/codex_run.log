+NOTES: str = r"""
+Definition.  Section 2, Definition 1 fixes d=2: an old vertex creates at most
+one child per slot, and the child may attach only to its parent and the old
+neighbors of that parent.  Proposition 1 then forces every set of vertices
+born in one slot to be independent in the target graph.
+
+Step 0 and hardness.  Section 4's fast-growth theorem is an explicit
+polynomial-time perfect-matching plus 2-SAT algorithm for exactly log n slots
+and zero excess, so that regime cannot be Track A.  Candidate elimination is
+also polynomial for unrestricted length n-1, and constant excess remains
+polynomial.  The family instead uses Section 4, Theorem 1: for an arbitrary G,
+join an isomorphic copy of G to a same-sized clique of universal vertices.
+The resulting graph has a zero-excess schedule with the clique prefix followed
+by q independent slots exactly when G is q-colourable.  The theorem makes the
+zero-excess decision problem NP-complete.  Worst-case hardness alone is not
+claimed as evidence for this generator's distribution: the shipping G5/G6
+measure capped exact DSATUR and a spectral partition attack on the actual
+sparse planted distribution.
+
+Construction.  A balanced three-way partition is sampled first.  For every
+pair of parts, independently shuffled perfect matchings are overlaid.  Duplicate
+edges are coalesced, creating small degree fluctuations and removing the exact
+equitable-partition eigenvector leaked by a perfectly regular construction.
+Only cross-part edges are ever inserted.  The target is the paper's join with
+K_n.  The planted colouring is canonicalised and directly describes the last
+three slots.  The universal clique grows first, one vertex per slot; each base
+vertex then uses a different universal vertex as parent.  Universal parents
+are adjacent to every old vertex, so all requested target edges are legal and
+no edge is deleted.
+
+Attacks.  Labels and class membership are independently shuffled.  Overlaying
+the same number of matchings between every pair makes degree an uninformative
+plant marker; collisions provide spectral noise.  The panel includes degree
+ranking, left-to-right greedy colouring, 256 random-order greedy restarts,
+two-vector shifted-adjacency spectral clustering, and capped exact DSATUR.
+The last is the standard exact graph-colouring attack.  A solved attack is
+reported as a failed gate; it is never hidden as a reference algorithm.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 1_000_000
+_DSATUR_NODE_CAP = 8_000
+
+
+def _canonicalise_labels(values):
+    mapping = {}
+    result = []
+    for value in values:
+        if value not in mapping:
+            mapping[value] = len(mapping)
+        result.append(mapping[value])
+    return result
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate a coloured graph, then apply the paper's reduction."""
+    if isinstance(n, bool) or not isinstance(n, int) or n < 6 or n % 3:
+        raise ValueError("n must be an integer multiple of 3 and at least 6")
+    matchings = params.get("matchings", 3)
+    if (isinstance(matchings, bool) or not isinstance(matchings, int)
+            or matchings < 1 or matchings >= n // 3):
+        raise ValueError("matchings must be an integer in [1,n/3)")
+
+    rng = random.Random(seed)
+    shuffled = list(range(n))
+    rng.shuffle(shuffled)
+    groups = [shuffled[i::3] for i in range(3)]
+    planted = [0] * n
+    for colour, group in enumerate(groups):
+        for vertex in group:
+            planted[vertex] = colour
+
+    edges = set()
+    for first in range(3):
+        for second in range(first + 1, 3):
+            left = groups[first]
+            right = groups[second]
+            for _ in range(matchings):
+                left_order = left[:]
+                right_order = right[:]
+                rng.shuffle(left_order)
+                rng.shuffle(right_order)
+                for u, v in zip(left_order, right_order):
+                    edges.add((u, v) if u < v else (v, u))
+
+    base_vertices = list(range(n))
+    universal_vertices = list(range(n, 2 * n))
+    answer = _canonicalise_labels(planted)
+    return {
+        "paper": "arXiv:2107.14126",
+        "d": 2,
+        "excess_budget": 0,
+        "slot_budget": n + 2,
+        "n_base": n,
+        "target_n": 2 * n,
+        "base_vertices": base_vertices,
+        "universal_vertices": universal_vertices,
+        "base_edges": [list(edge) for edge in sorted(edges)],
+        "answer": answer,
+        "construction": {
+            "cross_class_matchings_per_pair": matchings,
+            "target": "join(base graph, complete graph on universal_vertices)",
+        },
+    }
+
+
+def render(inst) -> str:
+    """Render a self-contained statement and append only the selected hint."""
+    base = inst["base_vertices"]
+    universal = inst["universal_vertices"]
+    edge_lines = []
+    edges = inst["base_edges"]
+    for start in range(0, len(edges), 12):
+        edge_lines.append("  " + " ".join(
+            f"{u}-{v}" for u, v in edges[start:start + 12]))
+    statement = f"""ZERO-EXCESS d=2 GRAPH-GROWTH SCHEDULE
+
+The target is a finite undirected simple graph.  It starts at time 0 with one
+initiator.  In each later slot, every already-present vertex may create at most
+one new child.  A new child must be joined to its parent and may also be joined
+to any already-present neighbor of that parent.  No edge may join two vertices
+born in the same slot.  An excess edge is an edge later deleted; no deletions
+are allowed here.
+
+The target graph is specified compactly as a join.  Its base vertices, in the
+order used by your answer, are:
+  {json.dumps(base)}
+Its universal-clique vertices, in their fixed prefix order, are:
+  {json.dumps(universal)}
+The base-base edges are exactly the following unordered pairs:
+{chr(10).join(edge_lines)}
+In addition, every two universal-clique vertices are adjacent and every
+universal-clique vertex is adjacent to every base vertex.  There are no other
+edges.  Thus this fully defines the {inst['target_n']}-vertex target graph.
+
+Submit a compressed schedule as a JSON list of exactly {inst['n_base']} integers,
+one for each base vertex in the displayed order.  Each entry must be 0, 1, or
+2 and says that the vertex is born in that one of the final three slots.
+All three labels must occur.  To remove meaningless renaming, their first
+occurrences while scanning the list must be 0, then 1, then 2.
+
+The rest of the schedule is fixed by this list.  The first displayed universal
+vertex is the time-0 initiator.  Each later universal vertex is born alone,
+in displayed order, from the initiator.  Then slots 0, 1, and 2 of your list
+are executed in that order.  Within each such slot, its base vertices in
+displayed order are assigned distinct universal parents in displayed order;
+each child activates exactly its target edges to older vertices.  Your list
+must make this replay legal and obtain the target in at most {inst['slot_budget']}
+slots with zero deleted edges.  Indices are the displayed integer vertex
+names; edge order is irrelevant and repeats are not allowed.
+
+Give your final answer inside <answer></answer> tags, as one JSON integer list.
+Example: <answer>[0,1,0,2,1,2]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Extract the last tagged JSON list; malformed output returns None."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, list) else None
+
+
+def _edge_set(inst):
+    return {tuple(sorted(edge)) for edge in inst.get("base_edges", [])
+            if isinstance(edge, list) and len(edge) == 2}
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Replay the compressed schedule exactly, never consulting inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer list is empty"
+    n = inst.get("n_base")
+    base = inst.get("base_vertices")
+    universal = inst.get("universal_vertices")
+    if not isinstance(n, int) or not isinstance(base, list) or not isinstance(universal, list):
+        return False, "malformed instance vertex data"
+    if len(answer) != n:
+        return False, f"expected {n} entries; got {len(answer)}"
+    if len(base) != n or len(universal) != n:
+        return False, "instance parts do not both have n vertices"
+    if len(set(base + universal)) != 2 * n:
+        return False, "instance vertex parts overlap or repeat"
+    if any(isinstance(value, bool) or not isinstance(value, int)
+           for value in answer):
+        return False, "every slot label must be an integer"
+    if any(value < 0 or value > 2 for value in answer):
+        return False, "slot label outside the inclusive range 0..2"
+    if set(answer) != {0, 1, 2}:
+        return False, "all three final slot labels must occur"
+    if _canonicalise_labels(answer) != answer:
+        return False, "first occurrences of slot labels are not 0, then 1, then 2"
+
+    position = {vertex: i for i, vertex in enumerate(base)}
+    raw_edges = inst.get("base_edges")
+    if not isinstance(raw_edges, list):
+        return False, "malformed instance edge list"
+    seen = set()
+    for edge in raw_edges:
+        if (not isinstance(edge, list) or len(edge) != 2
+                or edge[0] not in position or edge[1] not in position
+                or edge[0] == edge[1]):
+            return False, "malformed base edge"
+        pair = tuple(sorted(edge))
+        if pair in seen:
+            return False, "duplicate base edge"
+        seen.add(pair)
+        u, v = edge
+        if answer[position[u]] == answer[position[v]]:
+            return False, f"base edge {u}-{v} has both endpoints in one birth slot"
+
+    # Exact compressed replay.  The n-1 prefix births are legal because the
+    # initiator is adjacent to every older universal.  In each final slot there
+    # are at most n children and n distinct universal parents.  A universal
+    # parent is adjacent to every older vertex, so all and only target edges to
+    # an arriving child can be activated.  Independence above is precisely the
+    # remaining same-slot legality condition.
+    prefix_slots = n - 1
+    final_slots = 3
+    if inst.get("d") != 2 or inst.get("excess_budget") != 0:
+        return False, "instance is not the promised d=2 zero-excess regime"
+    if prefix_slots + final_slots > inst.get("slot_budget", -1):
+        return False, "decoded schedule exceeds the slot budget"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample an unlabeled, nonempty three-block partition."""
+    n = inst["n_base"]
+    while True:
+        values = [rng.randrange(3) for _ in range(n)]
+        if len(set(values)) == 3:
+            return _canonicalise_labels(values)
+
+
+def search_space(inst) -> int | None:
+    """Stirling number S(n,3), matching random_candidate's exact language."""
+    n = inst["n_base"]
+    return (pow(3, n) - 3 * pow(2, n) + 3) // 6
+
+
+def enumerate_all(inst) -> int | None:
+    """Count valid canonical colourings exactly when the language is small."""
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    n = inst["n_base"]
+    count = 0
+    for values in itertools.product(range(3), repeat=n):
+        if set(values) == {0, 1, 2} and _canonicalise_labels(values) == list(values):
+            count += int(verify(inst, list(values))[0])
+    return count
+
+
+def _base_adjacency(inst):
+    base = inst["base_vertices"]
+    pos = {vertex: i for i, vertex in enumerate(base)}
+    adjacency = [set() for _ in base]
+    for u, v in inst["base_edges"]:
+        i, j = pos[u], pos[v]
+        adjacency[i].add(j)
+        adjacency[j].add(i)
+    return adjacency
+
+
+def _distance_profile(adjacency, root):
+    distance = [-1] * len(adjacency)
+    distance[root] = 0
+    frontier = [root]
+    while frontier:
+        nxt = []
+        for vertex in frontier:
+            for neighbor in adjacency[vertex]:
+                if distance[neighbor] < 0:
+                    distance[neighbor] = distance[vertex] + 1
+                    nxt.append(neighbor)
+        frontier = nxt
+    finite = [value for value in distance if value >= 0]
+    diameter = max(finite, default=0)
+    return tuple(distance.count(level) for level in range(diameter + 1)) + (distance.count(-1),)
+
+
+def canonical_key(inst) -> str:
+    """A label-invariant WL/distance fingerprint; no seed or rendering enters."""
+    adjacency = _base_adjacency(inst)
+    colours = [len(neighbors) for neighbors in adjacency]
+    history = []
+    for _ in range(len(adjacency)):
+        signatures = [
+            (colours[v], tuple(sorted(colours[w] for w in adjacency[v])))
+            for v in range(len(adjacency))
+        ]
+        palette = {signature: i for i, signature in enumerate(sorted(set(signatures)))}
+        new_colours = [palette[signature] for signature in signatures]
+        history.append(tuple(sorted(new_colours)))
+        if new_colours == colours:
+            break
+        colours = new_colours
+    edge_colours = sorted(tuple(sorted((colours[u], colours[v])))
+                          for u in range(len(adjacency)) for v in adjacency[u] if u < v)
+    profiles = sorted(_distance_profile(adjacency, vertex)
+                      for vertex in range(len(adjacency)))
+    payload = json.dumps({
+        "n": len(adjacency),
+        "m": len(inst["base_edges"]),
+        "wl": history,
+        "edge_colours": edge_colours,
+        "distance_profiles": profiles,
+    }, separators=(",", ":"))
+    return hashlib.sha256(payload.encode()).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """The answer is already near the 256-atom cap at the hard preset."""
+    n = int(params.get("n", 0))
+    matchings = int(params.get("matchings", 3))
+    if n < 240:
+        return {"n": min(240, max(n + 3, int(math.ceil(n * 1.5 / 3)) * 3)),
+                "matchings": matchings}
+    return "cap_bound"
+
+
+def _attack_outlier_degree(inst):
+    adjacency = _base_adjacency(inst)
+    order = sorted(range(len(adjacency)),
+                   key=lambda v: (len(adjacency[v]), v))
+    proposed = [0] * len(adjacency)
+    for rank, vertex in enumerate(order):
+        proposed[vertex] = rank % 3
+    proposed = _canonicalise_labels(proposed)
+    return verify(inst, proposed)[0]
+
+
+def _greedy_colouring(inst, order, colour_orders=None):
+    adjacency = _base_adjacency(inst)
+    values = [-1] * len(adjacency)
+    for step, vertex in enumerate(order):
+        choices = (colour_orders[step] if colour_orders is not None else (0, 1, 2))
+        used = {values[neighbor] for neighbor in adjacency[vertex]
+                if values[neighbor] >= 0}
+        chosen = next((colour for colour in choices if colour not in used), None)
+        if chosen is None:
+            return None
+        values[vertex] = chosen
+    return _canonicalise_labels(values)
+
+
+def _attack_greedy_left_to_right(inst):
+    proposed = _greedy_colouring(inst, list(range(inst["n_base"])))
+    return proposed is not None and verify(inst, proposed)[0]
+
+
+def _attack_random_restarts(inst, seed, restarts=256):
+    rng = random.Random(seed ^ 0x210714126)
+    n = inst["n_base"]
+    for _ in range(restarts):
+        order = list(range(n))
+        rng.shuffle(order)
+        colour_orders = []
+        for _vertex in order:
+            choices = [0, 1, 2]
+            rng.shuffle(choices)
+            colour_orders.append(choices)
+        proposed = _greedy_colouring(inst, order, colour_orders)
+        if proposed is not None and verify(inst, proposed)[0]:
+            return True
+    return False
+
+
+def _matvec_shifted(adjacency, vector, shift):
+    return [shift * vector[i] - sum(vector[j] for j in adjacency[i])
+            for i in range(len(adjacency))]
+
+
+def _normalise_vector(vector, previous=()):
+    n = len(vector)
+    mean = sum(vector) / n
+    result = [value - mean for value in vector]
+    for old in previous:
+        dot = sum(a * b for a, b in zip(result, old))
+        result = [a - dot * b for a, b in zip(result, old)]
+    norm = math.sqrt(sum(value * value for value in result))
+    if norm < 1e-14:
+        return None
+    return [value / norm for value in result]
+
+
+def _attack_spectral(inst):
+    adjacency = _base_adjacency(inst)
+    n = len(adjacency)
+    shift = max(len(neighbors) for neighbors in adjacency) + 1
+    vectors = []
+    for phase in (0.37, 1.19):
+        vector = [math.sin((i + 1) * phase) + math.cos((i + 1) * (phase + .41))
+                  for i in range(n)]
+        vector = _normalise_vector(vector, vectors)
+        if vector is None:
+            return False
+        for _ in range(100):
+            vector = _normalise_vector(_matvec_shifted(adjacency, vector, shift), vectors)
+            if vector is None:
+                return False
+        vectors.append(vector)
+    points = list(zip(vectors[0], vectors[1]))
+    first = min(range(n), key=lambda i: points[i][0])
+    second = max(range(n), key=lambda i: (
+        (points[i][0] - points[first][0]) ** 2
+        + (points[i][1] - points[first][1]) ** 2))
+    third = max(range(n), key=lambda i: min(
+        (points[i][0] - points[first][0]) ** 2 + (points[i][1] - points[first][1]) ** 2,
+        (points[i][0] - points[second][0]) ** 2 + (points[i][1] - points[second][1]) ** 2))
+    centers = [points[first], points[second], points[third]]
+    labels = [0] * n
+    for _ in range(30):
+        labels = [min(range(3), key=lambda c:
+                      (point[0] - centers[c][0]) ** 2
+                      + (point[1] - centers[c][1]) ** 2)
+                  for point in points]
+        new_centers = []
+        for colour in range(3):
+            members = [points[i] for i in range(n) if labels[i] == colour]
+            if not members:
+                return False
+            new_centers.append((sum(p[0] for p in members) / len(members),
+                                sum(p[1] for p in members) / len(members)))
+        if new_centers == centers:
+            break
+        centers = new_centers
+    proposed = _canonicalise_labels(labels)
+    return verify(inst, proposed)[0]
+
+
+def _dsatur(inst, node_cap=_DSATUR_NODE_CAP):
+    """Capped exact 3-colouring via saturation-degree branch and bound."""
+    adjacency_sets = _base_adjacency(inst)
+    n = len(adjacency_sets)
+    adjacency = [sum(1 << neighbor for neighbor in neighbors)
+                 for neighbors in adjacency_sets]
+    full = (1 << n) - 1
+    colours = [-1] * n
+    nodes = 0
+    operations = 0
+
+    def search(uncoloured, colour_bits):
+        nonlocal nodes, operations
+        if not uncoloured:
+            return True
+        if nodes >= node_cap:
+            return False
+        nodes += 1
+        best = -1
+        best_key = (-1, -1, 0)
+        remaining = uncoloured
+        while remaining:
+            bit = remaining & -remaining
+            vertex = bit.bit_length() - 1
+            remaining -= bit
+            saturation = sum(bool(adjacency[vertex] & bits)
+                             for bits in colour_bits)
+            operations += 5
+            key = (saturation, len(adjacency_sets[vertex]), -vertex)
+            if key > best_key:
+                best, best_key = vertex, key
+        bit = 1 << best
+        for colour in range(3):
+            operations += 1
+            if not adjacency[best] & colour_bits[colour]:
+                colours[best] = colour
+                changed = list(colour_bits)
+                changed[colour] |= bit
+                if search(uncoloured ^ bit, changed):
+                    return True
+        colours[best] = -1
+        return False
+
+    start = time.perf_counter()
+    solved = search(full, [0, 0, 0])
+    elapsed = time.perf_counter() - start
+    proposed = _canonicalise_labels(colours) if solved else None
+    verified = bool(proposed is not None and verify(inst, proposed)[0])
+    return {
+        "success": verified,
+        "nodes": nodes,
+        "operations": operations,
+        "wall_clock_sec": elapsed,
+        "node_cap": node_cap,
+        "candidate": proposed if verified else None,
+    }
+
+
+def _transform_instance(inst, permutation, reorder=False):
+    moved = {key: value for key, value in inst.items() if key != "answer"}
+    colour_by_new_vertex = {
+        permutation[old]: inst["answer"][i]
+        for i, old in enumerate(inst["base_vertices"])
+    }
+    base = [permutation[v] for v in inst["base_vertices"]]
+    universal = [permutation[v] for v in inst["universal_vertices"]]
+    if reorder:
+        base = list(reversed(base[::2])) + list(reversed(base[1::2]))
+        universal = universal[1:] + universal[:1]
+    moved["base_vertices"] = base
+    moved["universal_vertices"] = universal
+    moved["base_edges"] = [
+        [permutation[u], permutation[v]] for u, v in reversed(inst["base_edges"])
+    ]
+    moved["answer"] = _canonicalise_labels(
+        [colour_by_new_vertex[v] for v in base])
+    return moved
+
+
+def _answer_metrics(answer):
+    blob = json.dumps(answer, separators=(",", ":"))
+    return len(blob), math.ceil(len(blob) / 4), len(answer)
+
+
+def selftest() -> dict:
+    report = {}
+
+    failures = []
+    checks = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17, 101):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            native = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            checks += 1
+            if not (ok and native):
+                failures.append({"preset": preset, "seed": seed,
+                                 "reason": reason, "json_native": native})
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "checks": checks,
+        "failures": failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=314159, **ship_params)
+    answer = inst["answer"]
+    swapped = None
+    for i in range(len(answer)):
+        for j in range(i + 1, len(answer)):
+            if answer[i] == answer[j]:
+                continue
+            trial = list(answer)
+            trial[i], trial[j] = trial[j], trial[i]
+            if not verify(inst, trial)[0]:
+                swapped = trial
+                break
+        if swapped is not None:
+            break
+    corruptions = {
+        "drop_one": answer[:-1],
+        "swap_one": swapped if swapped is not None else list(reversed(answer)),
+        "duplicate_one": answer + [answer[-1]],
+        "empty": [],
+        "out_of_range": answer[:-1] + [3],
+    }
+    rejections = {}
+    for name, bad in corruptions.items():
+        ok, reason = verify(inst, bad)
+        rejections[name] = {"rejected": not ok, "reason": reason}
+    reasons = [value["reason"] for value in rejections.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": (all(value["rejected"] for value in rejections.values())
+                 and len(set(reasons)) == len(reasons)),
+        "rejections": rejections,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    realistic = (
+        "The universal prefix is fixed; I used three independent final slots.\n"
+        "```text\nintermediate work omitted\n```\n"
+        f"<answer>\n{json.dumps(answer)}\n</answer>\n"
+        "This list follows the displayed base-vertex order."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": (parsed == answer and verify(inst, parsed)[0]
+                 and parse_answer("garbage") is None),
+        "parsed_matches": parsed == answer,
+        "garbage_returns_none": parse_answer("garbage") is None,
+    }
+
+    rng = random.Random(0x210714126)
+    total = 200_000
+    hits = 0
+    sampling_start = time.perf_counter()
+    for _ in range(total):
+        hits += int(verify(inst, random_candidate(inst, rng))[0])
+    sampling_seconds = time.perf_counter() - sampling_start
+    probability = hits / total
+    report["G4_guess_resistance"] = {
+        "pass": probability < 1e-6,
+        "hits": hits,
+        "total": total,
+        "empirical_probability": probability,
+        "candidate_space": search_space(inst),
+        "prior": "uniform over canonical nonempty three-block partitions",
+        "sampling_wall_seconds": sampling_seconds,
+    }
+
+    baseline = _dsatur(inst)
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": probability < 1e-6 and not baseline["success"]
+                and isinstance(demo_count, int) and demo_count > 0,
+        "shipping_observed_valid_fraction": probability,
+        "shipping_density_sample_count": total,
+        "shipping_valid_hits": hits,
+        "shipping_candidate_space": search_space(inst),
+        "baseline_name": "capped exact DSATUR 3-colouring",
+        "baseline_wall_seconds": baseline["wall_clock_sec"],
+        "baseline_nodes": baseline["nodes"],
+        "baseline_node_cap": baseline["node_cap"],
+        "baseline_operations": baseline["operations"],
+        "baseline_successes": int(baseline["success"]),
+        "demo_exact_solution_count": demo_count,
+        "enumerate_all_shipping": None,
+    }
+
+    attack_names = (
+        "outlier_degree_rank",
+        "greedy_left_to_right",
+        "random_restart_256",
+        "spectral_two_smallest_eigenvectors",
+        "exact_dsatur_8000_nodes",
+    )
+    successes = {name: 0 for name in attack_names}
+    dsatur_nodes = 0
+    dsatur_operations = 0
+    dsatur_seconds = 0.0
+    for seed in range(100, 108):
+        trial = make_instance(seed=seed, **ship_params)
+        successes["outlier_degree_rank"] += int(_attack_outlier_degree(trial))
+        successes["greedy_left_to_right"] += int(_attack_greedy_left_to_right(trial))
+        successes["random_restart_256"] += int(_attack_random_restarts(trial, seed))
+        successes["spectral_two_smallest_eigenvectors"] += int(_attack_spectral(trial))
+        exact = _dsatur(trial)
+        successes["exact_dsatur_8000_nodes"] += int(exact["success"])
+        dsatur_nodes += exact["nodes"]
+        dsatur_operations += exact["operations"]
+        dsatur_seconds += exact["wall_clock_sec"]
+    report["G6_adversary_panel"] = {
+        "pass": all(value == 0 for value in successes.values()),
+        "attacks": {
+            name: {"successes": value, "attempts": 8}
+            for name, value in successes.items()
+        },
+        "standard_algorithm": {
+            "name": "exact DSATUR with saturation-degree branching",
+            "node_cap_per_instance": _DSATUR_NODE_CAP,
+            "nodes_total": dsatur_nodes,
+            "operations_total": dsatur_operations,
+            "wall_clock_sec_total": dsatur_seconds,
+        },
+    }
+
+    doubled_params = dict(ship_params)
+    doubled_params["n"] = 2 * ship_params["n"]
+    doubled_start = time.perf_counter()
+    doubled = make_instance(seed=7, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    doubled_seconds = time.perf_counter() - doubled_start
+    named_sizes = [DIFFICULTY[name]["n"] for name in ("easy", "medium", "hard")]
+    report["G7_scales"] = {
+        "pass": (doubled_ok and doubled["n_base"] == 2 * inst["n_base"]
+                 and named_sizes == sorted(named_sizes)
+                 and len(set(named_sizes)) == len(named_sizes)),
+        "shipping_n": inst["n_base"],
+        "doubled_n": doubled["n_base"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+        "doubled_build_and_verify_seconds": doubled_seconds,
+        "named_n_values": named_sizes,
+    }
+
+    invariant = True
+    invariance_checks = 0
+    real_checks = 0
+    for seed in range(20):
+        trial = make_instance(seed=10_000 + seed, **ship_params)
+        size = trial["target_n"]
+        rng_local = random.Random(90_000 + seed)
+        random_perm = list(range(size))
+        rng_local.shuffle(random_perm)
+        reverse_perm = list(reversed(range(size)))
+        composed_perm = [random_perm[reverse_perm[i]] for i in range(size)]
+        original_key = canonical_key(trial)
+        for index, permutation in enumerate((reverse_perm, random_perm, composed_perm)):
+            moved = _transform_instance(trial, permutation, reorder=bool(index % 2))
+            invariance_checks += 1
+            invariant &= canonical_key(moved) == original_key
+            real_checks += 1
+            invariant &= verify(moved, moved["answer"])[0]
+    unrelated_keys = {
+        canonical_key(make_instance(seed=20_000 + seed, **ship_params))
+        for seed in range(20)
+    }
+    report["G8_canonical_key"] = {
+        "pass": invariant and len(unrelated_keys) == 20,
+        "invariance_checks": invariance_checks,
+        "real_transformation_verify_checks": real_checks,
+        "distinct_unrelated_keys": len(unrelated_keys),
+        "unrelated_instances": 20,
+        "symmetries": [
+            "full vertex relabelling",
+            "base/universal input reordering",
+            "composition of relabelling and reordering",
+        ],
+        "caveat": "WL plus distance-profile fingerprint is not a complete GI canonical form",
+    }
+
+    chars, tokens, elements = _answer_metrics(answer)
+    intended_operations = len(answer)
+    arms = {name: dict(G9_EVIDENCE[name])
+            for name in ("bare", "hinted", "placebo")}
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = chars <= 2000 and elements <= 256 and intended_operations <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": G9_EVIDENCE["hinted_verdict"] == "hardened" and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_EVIDENCE["hinted_verdict"],
+        "answer_chars": chars,
+        "answer_tokens": tokens,
+        "answer_elements": elements,
+        "intended_route_operations": intended_operations,
+        "within_size_and_operation_caps": within_caps,
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = ship_params
+    report["certificate_language"] = CERTIFICATE_LANGUAGE
+    report["problem_profile"] = PROBLEM_PROFILE
+    report["all_passed"] = all(
+        value.get("pass", False) for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

