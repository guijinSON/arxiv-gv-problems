def _normalize_pair(a: int, b: int) -> list[int]:
    return [a, b] if a < b else [b, a]


def _normalize_answer(pairs) -> list[list[int]]:
    return sorted((_normalize_pair(int(a), int(b)) for a, b in pairs),
                  key=lambda p: (p[0], p[1]))


def _reflection_pairs(n: int, axis: int) -> list[tuple[int, int]]:
    """The unordered pairs of i -> axis-i mod n for an odd axis."""
    pairs = set()
    for i in range(n):
        j = (axis - i) % n
        if i != j:
            pairs.add((min(i, j), max(i, j)))
    return sorted(pairs)


def _shift_pairs(n: int, shift: int) -> list[tuple[int, int]]:
    """Perfect matching 2*i -> 2*(i+shift)+1 on the cyclic bipartition."""
    half = n // 2
    return sorted(
        (min(2 * i, 2 * ((i + shift) % half) + 1),
         max(2 * i, 2 * ((i + shift) % half) + 1))
        for i in range(half)
    )


def make_instance(n, seed=0, **params) -> dict:
    """Generate by superposing sampled complete reflection matchings.

    The first sampled reflection is retained as the answer before any instance
    is assembled.  Hence the generator never obtains a witness by solving its
    own output.
    """
    n = int(n)
    axis_count = int(params.get("axis_count", 5))
    trap_count = int(params.get("trap_count", 3))
    if n < 8 or n % 4:
        raise ValueError("n must be an integer multiple of four and at least 8")
    half = n // 2
    if not 1 <= axis_count <= half // 2:
        raise ValueError("axis_count must lie in 1,...,n/4")
    if not 0 <= trap_count <= half // 2 - 1:
        raise ValueError("trap_count must lie in 0,...,n/4-1")

    rng = random.Random(seed)
    # Write even positions as 2*i and odd positions as 2*j+1.  A reflection is
    # j=a-i and a shift trap is j=i+s on Z_(n/2).  When a and s have opposite
    # parity these matchings share no edge: equality would give a-s=2*i.
    # Thus each component contributes degree one at every vertex.
    for _construction_attempt in range(128):
        trap_parity = rng.randrange(2)
        axis_parity = 1 - trap_parity
        axis_codes = [a for a in range(half) if a % 2 == axis_parity]
        shift_codes = [
            s for s in range(half)
            if s % 2 == trap_parity and s not in (0, half - 1)
        ]
        axes = rng.sample(axis_codes, axis_count)
        shifts = []
        if trap_count:
            # Force one near-diameter shift orbit.  Its chords are the longest
            # eligible chords, but selecting one mixes badly with reflection
            # orbits; this targets the longest-first planting signature found
            # by the first adversarial sweep.
            poison_shift = next(
                s for s in (half // 2 - 1, half // 2)
                if s % 2 == trap_parity
            )
            shifts.append(poison_shift)
            remaining_shifts = [s for s in shift_codes if s != poison_shift]
            rng.shuffle(remaining_shifts)
            for candidate in remaining_shifts:
                # After comparing two consecutive even-position rows, shift
                # codes differing by 2 would mimic a reflection for one step.
                # Excluding adjacent codes makes that two-row invariant exact.
                if all((candidate - old) % half not in (2, half - 2)
                       for old in shifts):
                    shifts.append(candidate)
                    if len(shifts) == trap_count:
                        break
            if len(shifts) != trap_count:
                continue
        planted_axis = 2 * axes[0] + 1

        allowed_pos = []
        for axis_code in axes:
            allowed_pos.extend(_reflection_pairs(n, 2 * axis_code + 1))
        for shift in shifts:
            allowed_pos.extend(_shift_pairs(n, shift))

        # This is construction filtering, not certificate search: the planted
        # reflection is already known.  Reject the rare parameter draw on which
        # the documented longest-first attack happens to assemble some valid
        # hybrid matching.
        identity = {
            "n": n,
            "cyclic_order": list(range(n)),
            "allowed_chords": [list(edge) for edge in allowed_pos],
            "answer": [list(edge) for edge in _reflection_pairs(n, planted_axis)],
        }
        longest = sorted(
            allowed_pos,
            key=lambda e: (min(e[1] - e[0], n - (e[1] - e[0])), e),
            reverse=True,
        )
        greedy = _greedy_from_positions(identity, longest)
        if greedy is None or not verify(identity, greedy)[0]:
            break
    else:
        raise RuntimeError("could not defeat longest-chord construction probe")

    cyclic_order = list(range(n))
    rng.shuffle(cyclic_order)

    allowed = [
        _normalize_pair(cyclic_order[i], cyclic_order[j])
        for i, j in allowed_pos
    ]
    # Order is presentation-only and is independently obscured.
    rng.shuffle(allowed)

    answer = _normalize_answer(
        (cyclic_order[i], cyclic_order[j])
        for i, j in _reflection_pairs(n, planted_axis)
    )

    return {
        "n": n,
        "cyclic_order": cyclic_order,
        "allowed_chords": allowed,
        "answer": answer,
    }


