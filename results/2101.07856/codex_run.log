+                if values[0] == values[1] == values[2]:
+                    satisfied = False
+            if satisfied:
+                return bits, {
+                    "candidates_tested": candidates,
+                    "operations": operations,
+                }
+    return None, {"candidates_tested": candidates, "operations": operations}
