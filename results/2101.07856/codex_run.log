   681	\end{figure}
   682	\noindent
   683	We can now do as follows. Consider an induced $6$-vertex cycle~$C$ in $G$, say on vertices $x_1,\ldots,x_6$ in that order.
   684	Then we may assume without loss of generality that if $G$ has a colouring $c$ that respects $L$, then $c(x_1)=1$, $c(x_2)=2$, $c(x_3)=3$, $c(x_4)=1$, $c(x_5)=2$ and $c(x_6)=3$ (otherwise we can do some permutation of the colours). See also Figure~\ref{f-22}.
   685	
   686	We let again $N_0=\{x_1,\ldots,x_6\}$, $N_1$ be the set of vertices that do not belong to $C$ but that are adjacent to at least one vertex of $C$, and $N_2=V\setminus (N_0\cup N_1)$  be the set of remaining vertices. We  do a full $c$-propagation but now we also include the exhaustive use of Rule-C6. By combining Lemma~\ref{l-easy} with the observation that Rule-C6  runs in polynomial time and reduces the list size of at least one vertex, this takes polynomial time.
   687	By combining the same lemma with the fact that Rule-C6 is safe (due to Claim~1) and the above observation that every $L$-respecting colouring of $G$ coincides with $c$ on $N_0$ (subject to colour permutation), we are done if we can prove that the propagation algorithm either outputs {\tt yes} or {\tt no}.
   688	
   689	For contradiction, assume that the propagation algorithm returns {\tt unknown}. Then we obtained the $c$-propagated list assignment $L'_c$. By definition of $L'_c$ we find that $G$ contains a a vertex $v$ with $L'_c(v)=\{1,2,3\}$. Then $v\notin N_0$, as every $u\in N_0$ has $L'_c(u)=\{c(u)\}$. Moreover, $v\notin N_1$, as vertices in $N_1$ have a list of size at most~$2$ after applying Rule~\ref{r-one2}.
   690	Hence, we find that $v\in N_2$. 
   691	
   692	As $G$ has diameter~$2$, there exists a vertex $y\in N_1$ that is adjacent to $x_1$ and~$v$.  Hence, $y$ is not adjacent to any vertex in $\{x_2,x_3,x_5,x_6\}$;
   693	otherwise $y$ would have a list of size~$1$ due to Rule~\ref{r-one2}, and by the same rule, $v$ would have a list of size~$2$.
   694	As $G$ has diameter~$2$ and $yx_3\notin E$, there exists a vertex $y'\in N_1\setminus \{y\}$ that is adjacent to $x_3$ and~$v$. By the same arguments as above, $y'$ is not adjacent to any vertex in $\{x_1,x_2,x_4,x_5\}$. 
   695	If $yy'\notin E$, then $\{x_1,x_2,x_3,y',v,y\}$ induces a $C_6$. However, in that case we would have applied Rule-C6 and $v$ would have had list $\{2\}$. Hence, we find that $y$ and $y'$ are adjacent; see also Figure~\ref{f-22}.
   696	
   697	As $G$ has diameter~$2$, $yx_5\notin E$ and $y'x_5\notin E$, there exists a vertex $y''\in N_1\setminus \{y,y'\}$ that is adjacent to $x_5$ and~$v$. By using exactly the same arguments as above but now applied to $y''$ and to the pairs $(y,y'')$ and $(y',y'')$, respectively, we find that $y''$ is adjacent to both $y$ and $y'$.
   698	However, now the vertices $v,y,y',y''$ induce a $K_4$, contradicting the $K_4$-freeness of $G$ (see again Figure~\ref{f-22}).
   699	We conclude that the propagation algorithm returned either {\tt yes} or {\tt no}. \qed
   700	\end{proof}
   701	
   702	\begin{theorem}\label{t-c4c9}
   703	{\sc List $3$-Colouring} can be solved in polynomial time for $(C_4,C_9)$-free graphs of diameter~$2$.
   704	\end{theorem}
   705	
   706	\begin{proof}
   707	Let $G=(V,E)$ be a $(C_4,C_9)$-free graph of diameter~$2$ with a list $3$-assignment $L$. If $G$ is $C_7$-free, then we apply Theorem~\ref{t-c4c7}. 
   708	 If $G$ contains a $K_4$, then $G$ is not $3$-colourable and hence, $(G,L)$ is a no-instance of {\sc List $3$-Colouring}. We check these properties in polynomial time. So, from now on, we assume that $G$ is a $K_4$-free graph that contains at least one induced cycle on seven vertices.
   709	 
   710	We set $p=7$ and perform a full $p$-propagation. This takes polynomial time by Lemma~\ref{l-easy}. By the same lemma, we have solved {\sc List $3$-Colouring} on $(G,L)$ if $(G,L)$ is $p$-terminal. Suppose we find that $(G,L)$ is not $p$-terminal.
   711	
   712	We first prove the following claim.
   713	
   714	\medskip
   715	\noindent
   716	{\it Claim 1. For each induced $7$-vertex cycle $C$, the propagation algorithm returned {\tt no} for every $L$-promising $V(C)$-colouring $c$ that 
   717	assigns the same colour $i$ on two vertices of $C$ that have a common neighbour on $C$ and that gives every other vertex of $C$ a colour different from~$i$.}
   718	
   719	\medskip
   720	\noindent
   721	We prove Claim~1 as follows.
   722	Consider an induced $7$-vertex cycle~$C$, say with vertex set $N_0=\{x_1,\ldots,x_7\}$ in this order. Let $N_1$ be the set of vertices that do not belong to $C$ but that are adjacent to at least one vertex of $C$. Let $N_2=V\setminus (N_0\cup N_1)$  be the set of remaining vertices.
   723	Let $c$ be an $L$-promising $V(C)$-colouring that assigns two vertices of $C$ with a common neighbour on $C$ the same colour, say $c(x_1)=1$ and $c(x_3)=1$, and moreover, that assigns every vertex $x_i$ with $i\in \{2,4,5,6,7\}$ colour
   724	 $c(x_i)\neq 1$.
   725	
   726	For contradiction, suppose that a full $c$-propagation does not yield a {\tt no} output. As $(G,L)$ is not $p$-terminal, this means
   727	that we obtained the $c$-propagated list assignment $L'_c$. By definition of $L'_c$ we find that $G$ contains a 
   728	vertex $v$ with $L'_c(v)=\{1,2,3\}$. Then $v\notin N_0$, as every $u\in N_0$ has $L'_c(u)=\{c(u)\}$. 
   729	Moreover, $v\notin N_1$, as vertices in $N_1$ have a list of size at most~$2$ after applying Rule~\ref{r-one2}.
   730	Hence, we find that $v\in N_2$. 
   731	
   732	As $G$ has diameter~$2$, there exist a vertex $y\in N_1$ that is adjacent to both $v$ and $x_1$.
   733	Then $y$ is not adjacent to any $x_i$ with $i\in \{2,4,5,6,7\}$; in that case $y$ would have a list of size~$1$ (as each $x_i$ other than $x_1$ and $x_3$ is coloured $2$ or $3$) meaning that $L_c'(v)$ would have size at most~$2$. Hence, $y$ is not adjacent to $x_3$ either, as otherwise $\{y,x_1,x_2,x_3\}$ would induce a $C_4$. As $G$ has diameter~$2$, this means that there exists a vertex $y'\in N_1$ with $y'\neq y$ such that $y'$ is adjacent to both $v$ and $x_3$. By the same arguments we used for $y'$, we find that $x_3$ is the only neighbour of $y'$ on $C$.
   734	
   735	If $yy'$ is an edge then, by Rule~\ref{r-bull}, $v$ would have had list $\{1\}$ instead of $\{1,2,3\}$. Hence, $y$ and $y'$ are not adjacent. However, now $\{y,v,y',x_3,x_4,x_5,x_6,x_7,x_1\}$ induces a $C_9$, a contradiction; see also Figure~\ref{f-ccc1}. This proves Claim~1.
   736	
