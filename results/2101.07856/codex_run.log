+    return [1 if positive[i] > negative[i] else 0 for i in range(inst["n"])]
+
+
+def _greedy_no_backtracking_attack(inst):
+    """Assign in index order, minimizing immediate forced/conflict penalties."""
+    n = inst["n"]
+    assigned = [-1] * n
+
