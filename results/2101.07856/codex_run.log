+                key_failures.append([seed, name])
+            if verify(transformed, transformed["answer"])[0]:
+                transform_verifications += 1
+        unrelated_keys.append(base_key)
+    distinct_count = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
