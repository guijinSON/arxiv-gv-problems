+    flips = 0
+    for _ in range(restarts):
+        bits = [rng.randrange(2) for _ in range(inst["n"])]
+        for _step in range(inst["n"]):
+            violated = [
+                clause for clause in inst["clauses"]
+                if len({_literal_value(bits, occurrence) for occurrence in clause}) == 1
+            ]
