    return last


def _fixed_by_matrix(
    matrix: tuple[int, int, int, int], value: int, p: int
) -> bool:
    """Test a projective fixed point without division."""
    a, b, c, d = matrix
    if value == p:
        return c == 0
    return (c * value * value + (d - a) * value - b) % p == 0


def _reference_all_labels(inst: dict) -> tuple[list[int] | None, int, int]:
    """Compose once, scan every label, and return the first closed trajectory."""
    product = _cycle_product(inst)
    first_start = None
    solutions = 0
    for start in range(inst["p"] + 1):
