   630		\end{figure}
   631	
   632	\medskip
   633	\noindent
   634	Due to Claim~1, we know that if $G$ has a colouring~$c$ respecting $L$, then any such colouring~$c$ gives a different colour to every two non-adjacent vertices that are of distance~$2$ on some induced $6$-vertex cycle. Hence, we can safely use the following new rule. To explain this, $x_5$ cannot get the same colour of both $x_1$ and $x_3$, which are both of distance~$2$ from $x_5$ on an induced $C_6$, thus $x_5$ must get the remaining colour, which is the colour of $x_2$. Moreover, an application of the new rule takes polynomial time.
   635	Note that we must also have that $L(x_4)=L(x_1)$ and $L(x_6)=L(x_3)$ but this will be irrelevant for our purposes.
   636	
   637	\begin{enumerate}[\bf Rule-C6.]
   638		\item \label{r-c6} {\bf(${\mathbf {C_6}}$ colour propagation)} 
   639		Let $C$ be an induced cycle on six vertices $x_1,x_2,\ldots,x_6$ in that order. If $|L(x_1)|=|L(x_2)|=|L(x_3)|=1$, $L(\{x_1,x_2,x_3\})=\{1,2,3\}$ and $L(x_2)\neq L(x_5)$, then set $L(x_5):=L(x_2)\cap L(x_5)$ (so $x_5$ gets a list of size at most~$1$).\\[-12pt]
   640	\end{enumerate}
   641	
   642	\noindent
   643	\begin{figure}
