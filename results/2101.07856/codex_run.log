def _is_prime(value: int) -> bool:
    if value < 2:
        return False
    if value % 2 == 0:
        return value == 2
    factor = 3
    while factor * factor <= value:
        if value % factor == 0:
            return False
        factor += 2
    return True


def _next_prime(value: int) -> int:
    candidate = max(3, value | 1)
    while not _is_prime(candidate):
        candidate += 2
    return candidate


def _validate_params(n: int, groups: int, prime_window: int) -> None:
    if isinstance(n, bool) or not isinstance(n, int) or not 5 <= n <= 50_000_000:
        raise ValueError("n must be an integer in 5..50000000")
    if (
        isinstance(groups, bool)
