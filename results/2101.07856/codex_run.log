    ):
        raise ValueError("prime_window must be an integer in 0..5000000")


# Matrices are tuples (a,b,c,d), interpreted projectively over F_p.
def _det(matrix: tuple[int, int, int, int], p: int) -> int:
    a, b, c, d = matrix
    return (a * d - b * c) % p


def _mat_mul(
    left: tuple[int, int, int, int],
    right: tuple[int, int, int, int],
    p: int,
) -> tuple[int, int, int, int]:
    a, b, c, d = left
    e, f, g, h = right
    return (
        (a * e + b * g) % p,
        (a * f + b * h) % p,
        (c * e + d * g) % p,
        (c * f + d * h) % p,
    )


def _mat_inv(matrix: tuple[int, int, int, int], p: int) -> tuple[int, int, int, int]:
    a, b, c, d = matrix
    inverse_det = pow(_det(matrix, p), -1, p)
    return (
        d * inverse_det % p,
        -b * inverse_det % p,
        -c * inverse_det % p,
        a * inverse_det % p,
    )


def _mobius(matrix: tuple[int, int, int, int], value: int, p: int) -> int:
    """Apply a PGL(2,p) matrix; the integer p is the infinity label."""
    a, b, c, d = matrix
    if value == p:
        return p if c == 0 else a * pow(c, -1, p) % p
    denominator = (c * value + d) % p
    if denominator == 0:
        return p
    return (a * value + b) * pow(denominator, -1, p) % p


def _random_matrix(rng: random.Random, p: int) -> tuple[int, int, int, int]:
    """Sample a non-affine map whose images of 0, 1 and infinity are finite."""
    while True:
        matrix = tuple(rng.randrange(p) for _ in range(4))
        _a, b, c, d = matrix
        if _det(matrix, p) and b and c and d and (c + d) % p:
            return matrix


def _parabolic_with_fixed_point(value: int, p: int) -> tuple[int, int, int, int]:
    """Return a conjugate of y -> y+1 whose sole P^1 fixed point is value."""
    translation = (1, 1, 0, 1)
    if value == p:
        conjugator = (1, 0, 0, 1)
    else:
        conjugator = (value % p, -1 % p, 1, 0)
    return _mat_mul(
        _mat_mul(conjugator, translation, p),
        _mat_inv(conjugator, p),
        p,
    )


def _cycle_product(inst: dict) -> tuple[int, int, int, int]:
    product = (1, 0, 0, 1)
    for matrix_data in inst["matrices"]:
        product = _mat_mul(tuple(matrix_data), product, inst["p"])
    return product


def _valid_trajectory(inst: dict, vector: list[int]) -> bool:
    groups = inst["groups"]
    return all(
        vector[(i + 1) % groups]
        == _mobius(tuple(inst["matrices"][i]), vector[i], inst["p"])
        for i in range(groups)
    )


def _affine_ansatz(inst: dict) -> list[int]:
    """Misread every fractional-linear map as an affine map fitted at 0 and 1."""
    p = inst["p"]
    affine: list[tuple[int, int]] = []
    for matrix_data in inst["matrices"]:
        matrix = tuple(matrix_data)
        intercept = _mobius(matrix, 0, p)
        at_one = _mobius(matrix, 1, p)
        affine.append(((at_one - intercept) % p, intercept))

    total_slope, total_intercept = 1, 0
    for slope, intercept in affine:
        total_slope = slope * total_slope % p
        total_intercept = (slope * total_intercept + intercept) % p
    if total_slope != 1:
        start = total_intercept * pow((1 - total_slope) % p, -1, p) % p
    elif total_intercept == 0:
        start = 0
    else:
        start = p

    candidate = [start]
    for slope, intercept in affine[:-1]:
        current = candidate[-1]
        candidate.append(p if current == p else (slope * current + intercept) % p)
    return candidate


