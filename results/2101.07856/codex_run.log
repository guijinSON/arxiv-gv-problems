+# Script-owned oracle measurements are copied here only after the three runs.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0, "errors": 0},
+    "hinted": {"solved": 0, "attempts": 0, "errors": 0},
+    "placebo": {"solved": 0, "attempts": 0, "errors": 0},
