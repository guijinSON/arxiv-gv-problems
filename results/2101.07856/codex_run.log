p='gen_2101_07856.py'; s=importlib.util.spec_from_file_location('m',p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)

def random_greedy(inst,rng,restarts):
    last=None
    n=inst['n']
    inc=[[] for _ in range(n)]
    for ci,c in enumerate(inst['clauses']):
        for v,_ in c: inc[v].append(ci)
    for _ in range(restarts):
        a=[-1]*n; order=list(range(n)); rng.shuffle(order)
        for v in order:
            scores=[]
            for bit in (0,1):
                a[v]=bit; bad=forced=0
                for ci in inc[v]:
                    known=[]; unk=0
                    for u,neg in inst['clauses'][ci]:
                        if a[u]<0: unk+=1
                        else: known.append(a[u]"'^neg)
                    if unk==0 and len(set(known))==1: bad+=1
                    elif unk==1 and len(known)==2 and known[0]==known[1]: forced+=1
                scores.append((bad*1000+forced,bit))
                a[v]=-1
            best=min(x[0] for x in scores); opts=[bit for score,bit in scores if score==best]
            a[v]=rng.choice(opts)
        last=a
        if m._formula_satisfied(inst,a): return a
    return last

def one_pass(inst,rng,restarts,steps):
    last=None
    for _ in range(restarts):
        a=[rng.randrange(2) for _ in range(inst['"'n'])]
        for __ in range(steps):
            violated=[c for c in inst['clauses'] if len({m._literal_value(a,o) for o in c})==1]
            if not violated:return a
            c=rng.choice(violated); v=rng.choice(c)[0]; a[v]"'^=1
        last=a
        if m._formula_satisfied(inst,a):return a
    return last
for name,fn in [
 ('"'rg1',lambda i,r:random_greedy(i,r,1)),('rg8',lambda i,r:random_greedy(i,r,8)),
 ('rw8q',lambda i,r:one_pass(i,r,8,i['n']//4)),('rw32q',lambda i,r:one_pass(i,r,32,i['n']//4)),
 ('rw8n',lambda i,r:one_pass(i,r,8,i['n']))]:
    succ=0
    for seed in range(8):
        i=m.make_instance(seed=10000+seed,**m.DIFFICULTY['hard']); a=fn(i,random.Random(20000+seed));succ+=m._formula_satisfied(i,a)
    print(name,succ)
