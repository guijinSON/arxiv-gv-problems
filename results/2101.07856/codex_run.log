+            "complexity": "O(2^n*m) worst case",
+            "wall_clock_sec_max": round(max_seconds, 6),
+            "wall_clock_sec_mean": round(sum(reference_seconds) / len(reference_seconds), 6),
+            "operations_max": max_ops,
