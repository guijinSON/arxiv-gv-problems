+    transformed["clauses"] = [
+        [[old_to_new[variable], negated] for variable, negated in clause]
+        for clause in inst["clauses"]
+    ]
+    old_bits = [pair[1] for pair in inst["answer"]]
+    transformed["answer"] = _answer_from_bits([old_bits[old] for old in old_at_new])
