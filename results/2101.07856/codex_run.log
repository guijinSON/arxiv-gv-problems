+    "easy": {"n": 78, "degree": 24, "subdivisions": 6},
+    "medium": {"n": 78, "degree": 36, "subdivisions": 6},
+    "hard": {"n": 78, "degree": 48, "subdivisions": 6},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT: str = (
