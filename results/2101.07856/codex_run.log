+            "wall_clock_sec_max": round(strongest_seconds, 6),
+            "operations_max": strongest_operations,
+            "flips_max": max(walksat_flips),
+            "solves": f"{walksat_successes}/{_ATTACK_SEEDS}, as expected on Track B",
