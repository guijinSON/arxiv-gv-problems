+    "easy": {"n": 96, "block_size": 3, "cross_percent": 70, "internal_percent": 15},
+    "medium": {"n": 108, "block_size": 3, "cross_percent": 70, "internal_percent": 15},
+    "hard": {"n": 120, "block_size": 3, "cross_percent": 70, "internal_percent": 15},
+}
