+            flip.remove(u)
+            flip.append(v)
+            break
+        if v in selected:
+            flip.remove(v)
+            flip.append(u)
+            break
+    corruptions["flip_one_matching_choice"] = sorted(flip)
+    corruption_results = {}
+    reasons = []
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
