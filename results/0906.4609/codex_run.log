+    # G9(a,b) uses only script-owned transcript results; (c) is local and exact.
+    answer_blob = json.dumps(answer, separators=(",", ":"))
+    worst_answer = list(range(inst["target_size"]))
+    worst_blob = json.dumps(worst_answer, separators=(",", ":"))
+    compact_answer, compact_ops = _compact_closure(inst)
+    arms = {
+        name: {
