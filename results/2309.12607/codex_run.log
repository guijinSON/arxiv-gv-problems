    old=importlib.util.module_from_spec(spec); spec.loader.exec_module(old)
    os.environ['GV_HINT_MODE']=mode
    a=cur.make_instance(seed=123, **cur.DIFFICULTY['hard'])
    b=old.make_instance(seed=123, **old.DIFFICULTY['hard'])
    print(arm, cur.render(a)==old.render(b), cur.verify(a,a['answer']))
os.environ.pop('GV_HINT_MODE',None)
