+        "auxiliary bipartite graph; Hopcroft--Karp is O(E sqrt(V)) and averaged "
+        "2,697 exact edge scans (0.0039 s) at shipping, whereas the measured "
+        "affine change of variables needs fewer than 300 modular operations."
+    ),
+    "max_answer_tokens": 80,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
