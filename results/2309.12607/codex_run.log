+        "requested_n": inst["requested_n"],
+        "p": p,
+        "width": inst["width"],
+        "vertices": sorted(vertex_map),
+        "cycle": [vertex_map[v] for v in inst["cycle"]],
+        "graphs": [row for row in transformed_graphs if row is not None],
+        "display_order": new_display_order,
+        "answer": answer,
+    }
