def _spawn_winner(a: int, b: int, positions: dict[int, int]) -> int:
    """Winner relation of the paper's left-to-right spawning construction."""
    i, j = positions[a], positions[b]
    if i > j:
        i, j, a, b = j, i, b, a
    parent = j - (j & -j)
    return a if i == parent else b


