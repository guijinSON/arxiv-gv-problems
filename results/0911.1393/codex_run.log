+    "bounds": {
+        "vectors": 3,
+        "lengths": [1, "n", "n"],
+        "anchor_value": 1,
+        "coefficient_min": "-B",
+        "coefficient_max": "B",
+        "integer_coefficients_only": True,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "coefficient_span": 9},
+    "easy": {"n": 48, "coefficient_span": 9},
+    "medium": {"n": 66, "coefficient_span": 9},
+    "hard": {"n": 84, "coefficient_span": 9},
