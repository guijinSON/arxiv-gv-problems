+        "pass": parsed == original,
+        "surrounding_prose_and_fence": True,
+        "json_round_trip": parsed == original,
+    }
+
+    # One structure-aware density sample serves G4 and the shipping part of G5.
+    guess_rng = random.Random(0x9141393)
