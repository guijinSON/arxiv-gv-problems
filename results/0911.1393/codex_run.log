 print(path, f\"{sum(r['solved']=='solved' for r in valid)}/{len(valid)} solved\",f\"{len(rows)-len(valid)} excluded errors\")
print('profile',profile)
print('gates',len(gates),'all pass; README lines',sum(1 for _ in open('README.md')))
print('shipping answer',len(json.dumps(inst['answer'])),'chars',sum(map(len,inst['answer'])),'atoms')
