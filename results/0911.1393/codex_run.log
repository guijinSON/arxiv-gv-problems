+        "specified anchor coordinate of each vector is 1; every other entry "
+        "is an integer in the inclusive interval [-B,B], where B is printed "
+        "in the instance."
+    ),
+    "bounds": {
+        "vectors": 3,
+        "lengths": [1, "n", "n"],
+        "anchor_value": 1,
+        "coefficient_min": "-B",
+        "coefficient_max": "B",
+        "integer_coefficients_only": True,
