+    doubled = make_instance(n=2 * ship_params["n"], seed=77,
+                            coefficient_span=ship_params["coefficient_span"])
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok,
+        "base_n": ship_params["n"],
