+
+def _poly_pow(base: list[int], exponent: int, modulus: int) -> list[int]:
+    out = [1]
+    factor = list(base)
+    e = exponent
+    while e:
+        if e & 1:
+            out = _poly_mul(out, factor, modulus)
+        e //= 2
+        if e:
+            factor = _poly_mul(factor, factor, modulus)
+    return out
