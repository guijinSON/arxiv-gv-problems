+def _poly_mul(left: list[int], right: list[int], modulus: int) -> list[int]:
+    out = [0] * (len(left) + len(right) - 1)
+    for i, a in enumerate(left):
+        for j, b in enumerate(right):
+            out[i + j] = (out[i + j] + a * b) % modulus
+    return out
