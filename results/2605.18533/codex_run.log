   351	Your witness is a cyclic-row descriptor [y,{length},-1]. It denotes all {length} propagations p(r,i), one for each i=0,...,{length - 1}, where y is the displayed label of r. The -1 records that the imposed target-vertex cycle runs from position i+1 to i. Find a descriptor whose denoted propagation set is a minimal FPS. Integers are exact; intervals and repeats are not involved.
   352	
   353	Give your final answer inside <answer></answer> tags, as one JSON array [row_label,{length},-1].
   354	Example of format only: <answer>{example}</answer>
   355	Output nothing else inside the tags."""
   356	    mode = os.environ.get("GV_HINT_MODE")
   357	    if mode == "structural":
   358	        text += "\n\nHint: " + STRUCTURAL_HINT
   359	    elif mode == "placebo":
   360	        text += "\n\nHint: " + PLACEBO_HINT
   361	    return text
   362	
   363	
   364	def parse_answer(text: str) -> object | None:
   365	    if not isinstance(text, str):
   366	        return None
   367	    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
   368	    if not matches:
   369	        return None
   370	    body = matches[-1].strip()
   371	    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, flags=re.I | re.S)
   372	    if fence:
   373	        body = fence.group(1).strip()
   374	    try:
   375	        value = json.loads(body)
   376	    except (TypeError, ValueError, json.JSONDecodeError):
   377	        return None
   378	    return value
   379	
   380	
   381	def verify(inst: dict, answer: object) -> tuple[bool, str]:
   382	    if not isinstance(answer, list):
   383	        return False, "answer must be a JSON array descriptor"
   384	    if not answer:
   385	        return False, "empty descriptor"
   386	    if len(answer) < 3:
   387	        return False, "descriptor has too few fields"
   388	    if len(answer) > 3:
   389	        return False, "descriptor has too many fields"
   390	    if any(not isinstance(value, int) or isinstance(value, bool) for value in answer):
   391	        return False, "all descriptor fields must be integers"
   392	    displayed_row, claimed_length, direction = answer
   393	    q = inst["q"]
   394	    if not 0 <= displayed_row < q:
   395	        return False, "row label is outside the field range"
   396	    if claimed_length != inst["cycle_length"]:
   397	        return False, "cycle length marker does not match the instance"
   398	    if direction != -1:
   399	        return False, "cycle direction marker must be -1"
   400	
   401	    row = _decode_row(inst, displayed_row)
   402	    value = _poly_eval(inst, row)
   403	    length = inst["cycle_length"]
   404	    active = [
   405	        _is_active_position(inst, row, position, value)
   406	        for position in range(length)
   407	    ]
   408	    if not all(active):
   409	        first_missing = active.index(False)
   410	        return False, f"row contains inactive propagation at position {first_missing}"
   411	
   412	    # For every i, p(r,i) imposes v(r,i+1)->v(r,i), as well as an arc from
   413	    # its helper.  Helpers have indegree zero in D_W.  Execute Kahn's exact
   414	    # cycle test on the target arcs and after every propagation deletion.
   415	    full = [((position + 1) % length, position) for position in range(length)]
   416	
   417	    def has_cycle(edges: list[tuple[int, int]]) -> bool:
   418	        outgoing = [[] for _ in range(length)]
   419	        indegree = [0] * length
   420	        for source, target in edges:
   421	            outgoing[source].append(target)
   422	            indegree[target] += 1
   423	        stack = [vertex for vertex in range(length) if indegree[vertex] == 0]
   424	        removed_vertices = 0
   425	        while stack:
   426	            vertex = stack.pop()
   427	            removed_vertices += 1
   428	            for target in outgoing[vertex]:
   429	                indegree[target] -= 1
   430	                if indegree[target] == 0:
   431	                    stack.append(target)
   432	        return removed_vertices != length
   433	
   434	    if not has_cycle(full):
   435	        return False, "precedence arcs do not close into the claimed cycle"
   436	    for removed in range(length):
   437	        remaining_arcs = [edge for index, edge in enumerate(full) if index != removed]
   438	        if has_cycle(remaining_arcs):
   439	            return False, "minimality check failed after deletion"
   440	    return True, "ok"
   441	
   442	
   443	def random_candidate(inst: dict, rng: random.Random) -> object:
   444	    """Uniform over the q structurally valid cyclic-row descriptors."""
   445	    semantic_row = rng.randrange(inst["q"])
   446	    return [_encode_row(inst, semantic_row), inst["cycle_length"], -1]
   447	
   448	
   449	def search_space(inst: dict) -> int | None:
   450	    return inst["q"]
   451	
   452	
   453	def enumerate_all(inst: dict) -> int | None:
   454	    if inst["q"] > 100000:
   455	        return None
   456	    count = 0
   457	    for row in range(inst["q"]):
   458	        candidate = [_encode_row(inst, row), inst["cycle_length"], -1]
   459	        if verify(inst, candidate)[0]:
   460	            count += 1
