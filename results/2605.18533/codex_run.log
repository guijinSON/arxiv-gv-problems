+    period = min(period, q)
+    decoy_shift_mul = rng.randrange(1, length)
+    decoy_shift_add = rng.randrange(length)
+
+    inst = {
+        "q": q,
+        "cycle_length": length,
+        "outer_power": outer,
+        "inner_power": 5,
+        "polynomial_degree": 5 * outer,
