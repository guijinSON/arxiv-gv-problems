+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A three-integer cyclic-FPS descriptor [row_label, cycle_length, -1]; "
+        "row_label is in [0,q-1], and the two structural markers are fixed by the instance."
+    ),
+    "bounds": {
