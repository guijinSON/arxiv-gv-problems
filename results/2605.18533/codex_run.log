+    guess_elapsed = time.perf_counter() - guess_started
+    observed = hits / samples
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": observed,
