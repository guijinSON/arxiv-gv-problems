+DIFFICULTY = {
+    "demo": {"n": 17, "cycle_length": 6, "outer_power": 1},
+    "easy": {"n": 5000011, "cycle_length": 32, "outer_power": 5},
+    "medium": {"n": 10000019, "cycle_length": 40, "outer_power": 6},
+    "hard": {"n": 20000003, "cycle_length": 48, "outer_power": 7},
+}
