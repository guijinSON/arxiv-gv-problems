codex
A qualifying direction is emerging, but it is not the prior “hide a known pattern” idea—that would collapse to catalog lookup. The paper’s native Section 2.4 composition law says noninteracting oscillators have period equal to the LCM of their component periods, and Section 2.5 proves a parameterized Snark-loop construction for every period ≥43. A potential Track B instance can therefore present several separated finite Life patterns and ask for a checkable LCM-period certificate: brute cycle detection is enormous, while recognizing the components and composing periods is short. I’m validating that the paper’s actual RLE data supports a parameterized construction rather than assuming the diagram does.
exec
/bin/bash -lc "sed -n '471p;478p' /tmp/arxiv_2312_source/omniperiodicity.tex | python3 -c '
import re,sys,itertools
lines=sys.stdin.read().splitlines()
def grab(s): return re.search(r\"rle=(["'^&]+)&name",s).group(1)
def parse(rle):
 x=y=0; cells=set(); num=""
 for ch in rle:
  if ch.isdigit(): num+=ch; continue
  k=int(num or 1); num=""
  if ch=="b": x+=k
  elif ch=="o":
   cells.update((x+i,y) for i in range(k)); x+=k
  elif ch=="$": y+=k; x=0
  elif ch=="!": break
 return cells
sn=parse(grab(lines[0])); loop=parse(grab(lines[1]))
print("snark",len(sn),min(x for x,y in sn),max(x for x,y in sn),min(y for x,y in sn),max(y for x,y in sn))
print("loop",len(loop),min(x for x,y in loop),max(x for x,y in loop),min(y for x,y in loop),max(y for x,y in loop))
def norms(s):
 outs=[]
 for swap in [0,1]:
  for sx in [-1,1]:
   for sy in [-1,1]:
    q={(sx*(y if swap else x),sy*(x if swap else y)) for x,y in s}
    ax=min(x for x,y in q); ay=min(y for x,y in q)
    q={(x-ax,y-ay) for x,y in q}
    if q not in outs: outs.append(q)
 return outs
found=[]
for oi,shape in enumerate(norms(sn)):
 anchor=min(shape)
 for lx,ly in loop:
  dx=lx-anchor[0]; dy=ly-anchor[1]
  moved={(x+dx,y+dy) for x,y in shape}
  if moved <= loop:
   item=(oi,dx,dy,moved)
   if not any(moved==z[3] for z in found): found.append(item)
print("found",[(o,x,y) for o,x,y,s in found],len(found))
union=set().union(*(z[3] for z in found)); rem=loop-union
print("union",len(union),"rem",len(rem),sorted(rem))
# connected comps remainder king-neighbor or exact expected gliders
while rem:
 st=[next(iter(rem))]; comp=set(st); rem-=comp
 while st:
  x,y=st.pop()
  for xx in range(x-1,x+2):
   for yy in range(y-1,y+2):
    if (xx,yy) in rem: rem.remove((xx,yy)); comp.add((xx,yy)); st.append((xx,yy))
 print("comp",len(comp),sorted(comp))
