 return q
def comps(s):
 rem=set(s); out=[]
 while rem:
  z=rem.pop(); q=[z]; c={z}
  while q:
   x,y=q.pop()
   for dx in (-1,0,1):
    for dy in (-1,0,1):
     w=(x+dx,y+dy)
     if w in rem: rem.remove(w);c.add(w);q.append(w)
  out.append(c)
 return out
def step(s):
 c=collections.Counter((x+dx,y+dy) for x,y in s for dx in (-1,0,1) for dy in (-1,0,1) if dx or dy)
 return {z for z,k in c.items() if k==3 or (k==2 and z in s)}
