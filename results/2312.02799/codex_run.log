/bin/bash -lc "sed -n '471p;478p' /tmp/arxiv_2312_source/omniperiodicity.tex | python3 -c '
import re,sys,collections
lines=sys.stdin.read().splitlines()
def parse(s):
 rle=re.search(r\"rle=(["'^&]+)&name",s).group(1); x=y=0; q=set(); num=""
 for ch in rle:
  if ch.isdigit(): num+=ch; continue
  k=int(num or 1); num=""
  if ch=="b": x+=k
  elif ch=="o": q.update((x+i,y) for i in range(k)); x+=k
  elif ch=="$": y+=k; x=0
 return q
def step(s):
 c=collections.Counter((x+dx,y+dy) for x,y in s for dx in (-1,0,1) for dy in (-1,0,1) if dx or dy)
 return {z for z,k in c.items() if k==3 or (k==2 and z in s)}
for label,line in zip(["snark","p43"],lines):
 s=parse(line); orig=set(s)
 print(label,"pop0",len(s),"pop1",len(step(s)),"stable",step(s)==s)
 for t in range(1,45):
  s=step(s)
  if s==orig: print("returns",t); break
 else: print("no return <=44",len(s))
