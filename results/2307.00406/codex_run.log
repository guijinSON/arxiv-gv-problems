+    compact = json.dumps(planted, separators=(",", ":"))
+    answer_chars = len(compact)
+    answer_atoms = _atomic_elements(planted)
+    answer_tokens = _answer_tokens(planted)
+    intended_ops = 4 * inst["n"] + 2
+    arms = {key: dict(_G9_EVIDENCE[key])
+            for key in ("bare", "hinted", "placebo")}
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = (answer_chars <= 2000 and answer_atoms <= 256
+                   and intended_ops <= 300)
+    hinted_minus_placebo = (
