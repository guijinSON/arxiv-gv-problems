+    row_profiles = sorted(tuple(sorted(abs(x) for x in row)) for row in matrix)
+    col_profiles = sorted(
+        tuple(sorted(abs(matrix[r][c]) for r in range(inst["n"])))
+        for c in range(inst["n"])
+    )
+    return {
+        "n": inst["n"],
+        "bound": inst["coeff_bound"],
+        "cone_coordinates": coordinates,
+        "target_absolute_coordinates": sorted(abs(x) for x in q),
+        "row_absolute_profiles": row_profiles,
+        "column_absolute_profiles": col_profiles,
