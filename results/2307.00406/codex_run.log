+def _dense_exact_solve(inst: dict) -> tuple[list[list[int]] | None, dict]:
+    """Generic dense exact RREF, deliberately unaware of planted structure."""
+    matrix, rhs = _matrix_and_rhs(inst)
+    rows = len(matrix)
+    cols = len(matrix[0])
+    aug = [[Fraction(value) for value in matrix[r]] + [Fraction(rhs[r])]
+           for r in range(rows)]
+    operations = 0
+    swaps = 0
+    start = time.perf_counter()
+    pivot_row_for_col = [-1] * cols
+    row = 0
+    for col in range(cols):
+        pivot = next((r for r in range(row, rows) if aug[r][col] != 0), None)
+        if pivot is None:
+            continue
+        if pivot != row:
+            aug[row], aug[pivot] = aug[pivot], aug[row]
+            swaps += 1
+        pivot_value = aug[row][col]
+        for j in range(col, cols + 1):
+            aug[row][j] /= pivot_value
+            operations += 1
+        for r in range(rows):
+            if r == row:
+                continue
+            factor = aug[r][col]
+            # A dense implementation updates the full trailing row even when a
+            # numerical factor happens to vanish after earlier elimination.
+            for j in range(col, cols + 1):
+                aug[r][j] -= factor * aug[row][j]
+                operations += 2
+        pivot_row_for_col[col] = row
+        row += 1
+    elapsed = time.perf_counter() - start
+    if row < cols:
+        return None, {"wall_clock_sec": elapsed, "operations": operations,
+                      "row_swaps": swaps, "rank": row}
+    for r in range(rows):
+        if all(aug[r][c] == 0 for c in range(cols)) and aug[r][cols] != 0:
+            return None, {"wall_clock_sec": elapsed, "operations": operations,
+                          "row_swaps": swaps, "rank": row}
+    solution = [aug[pivot_row_for_col[c]][cols] for c in range(cols)]
+    if any(value.denominator != 1 or value < 1 for value in solution):
+        answer = None
+    else:
+        answer = _certificate_from_coeffs(inst, [int(value) for value in solution])
+    return answer, {"wall_clock_sec": elapsed, "operations": operations,
+                    "row_swaps": swaps, "rank": row}
 
 
