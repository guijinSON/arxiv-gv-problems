+        "wall_clock_sec": guess_elapsed,
+    }
+
+    reference, reference_cost = _dense_exact_solve(inst)
+    reference_ok = reference is not None and verify(inst, reference)[0]
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
