+def _certificate_from_coeffs(inst: dict, coeffs: list[int]) -> list[list[int]]:
+    n = inst["n"]
+    top = (1 << inst["label_bits"]) - 1
+    if len(coeffs) != n:
+        raise ValueError("wrong coefficient count")
+    # These three blocks are already in increasing generator-index order.
+    terms = [[offset, int(multiplicity)]
+             for offset, multiplicity in enumerate(coeffs, 1)]
+    terms.extend([top - offset, int(coeffs[offset - 1])]
+                 for offset in range(n, 0, -1))
+    filler = inst["target"] - sum(coeffs)
+    if filler <= 0:
+        raise ValueError("nonpositive complement filler")
+    terms.append([top, filler])
+    return terms
 
