+def _make_swapped_multiplicity_corruption(inst: dict) -> list[list[int]]:
+    bad = [term[:] for term in inst["answer"]]
+    top = inst["point_count"] - 1
+    coeff = {i: m for i, m in bad}
+    first = next(i for i in range(1, inst["n"] + 1)
