+        "algorithm with enc(P)^(2^O(d)) running time, while decoding the "
+        "shipping instance and applying ordinary dense exact Gaussian "
+        "elimination costs O(n^3) and measured 90,160 exact operations (0.0092 "
+        "seconds) at the shipping preset, whereas the rank-one plus scaled-"
+        "permutation route needs at most 4n+2 exact operations (162 there)."
+    ),
+    "max_answer_tokens": 487,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
