+        cases[name] = {"rejected": not ok, "reason": why}
+    distinct = len({row["reason"] for row in cases.values()})
+    report["G2_rejects_corruption"] = {
+        "pass": all(row["rejected"] for row in cases.values()) and distinct == 5,
+        "distinct_reasons": distinct,
+        "cases": cases,
