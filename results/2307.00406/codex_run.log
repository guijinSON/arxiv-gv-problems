+        while True:
+            choices = [(neighbor, total) for neighbor, total in adjacency[current]
+                       if neighbor != previous]
+            if not choices:
+                return None, {"operations": operations, "reason": "open walk"}
+            following, total = choices[0]
+            edge_sums.append(total)
+            if following == root:
