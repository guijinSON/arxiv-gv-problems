+            attack_names[0]: [_attack_magnitude_rank(attack_inst)],
+            attack_names[1]: [_attack_scalar_greedy(attack_inst)],
+            attack_names[3]: _attack_spike_only_candidates(attack_inst),
+        }
+        for name, candidates in fixed_candidates.items():
