+"""Verified Track-B generator for Point in Cone on unimodular simplices.
+
+The native problem is the paper's Point in Cone problem (Section 2 of
+arXiv:2307.00406).  An integer unimodular matrix B defines the bounded simplex
+
+    P = {x in R^n : Bx >= 0 and 1^T Bx <= 1}.
+
+Its lattice points are exactly 0 and the columns of B^{-1}.  Hence the unique
+nonnegative cone coordinates of q are Bq.  The generator samples those
+coordinates first and transports the standard simplex through B^{-1}; it never
+solves a generated instance.
+
+The displayed B is dense.  Generic exact evaluation takes quadratic work, but
+B is secretly a signed-permuted rank-one perturbation of the identity.  Seeing
+that invariant reduces the arithmetic to one signed dot product and one vector
+update.  This is deliberately a Track-B compression task: the polynomial
+algorithm is disclosed, measured, and expected to succeed.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "optimization",
+    "object_regime": "integer_lattice",
+    "computational_core": "linear_algebra",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "bounded unimodular simplex given by integer facet inequalities",
+        "integer target point",
+        "nonnegative integer-cone coefficient vector",
+    ],
+    "verification_operations": [
+        "exact integer matrix-vector multiplication",
+        "nonnegativity and coefficient-bound checks",
+        "exact coordinate comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Recognize the dense facet-normal matrix as a signed-permuted rank-one "
+        "perturbation of the identity; without that change of coordinates, the "
+        "solver must carry out the displayed dense exact matrix-vector product."
+    ),
+    "hardness_basis": (
+        "Track B: Section 2 defines Point in Cone and the general algorithm cited "
+        "there is even more expensive; on this promised unimodular-simplex subclass, "
+        "dense exact evaluation of Bq is Theta(n^2), costing 18,336 scalar "
+        "multiply/add operations at the shipping preset n=96 (wall-clock measured "
+        "by selftest), whereas the signed rank-one route costs 191 exact additions."
+    ),
+    "max_answer_tokens": 97,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 4, "coeff_bound": 3},
+    "easy": {"n": 96, "coeff_bound": 31},
+    "medium": {"n": 120, "coeff_bound": 31},
+    "hard": {"n": 144, "coeff_bound": 31},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The dense facet-normal matrix is a signed-permuted rank-one perturbation "
+    "of the identity."
+)
+PLACEBO_HINT = (
+    "The dense facet-normal matrix rewards careful tracking of row and column "
+    "indices."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list of exactly n integers, in the displayed facet-row order, "
+        "with every coefficient in the inclusive interval 0..coeff_bound."
+    ),
+    "bounds": {
+        "length": "n",
+        "entry_min": 0,
+        "entry_max": "coeff_bound",
+        "candidate_count": "(coeff_bound+1)^n",
+        "maximum_supported_length": 256,
+    },
+}
+
+NOTES = (
+    "Section 2 fixes the definition used here: the input is an inequality-described "
+    "bounded polytope P and an integer q, and the question is membership in the "
+    "integer cone of P's lattice points.  The Introduction and Section 2 also name "
+    "the Goemans--Rothvoss enc(P)^(2^O(d)) algorithm, so a Track-A claim would be "
+    "wrong without distributional evidence.  This module instead declares Track B. "
+    "It transports the standard lattice simplex by an integer unimodular map.  The "
+    "certificate is sampled first, q is formed by the inverse signed-rank-one map, "
+    "and validity is checked as Bq=lambda.  Random row/column permutations and sign "
+    "changes remove fixed-coordinate leakage.  The audited outlier, largest-term, "
+    "permutation-only, and random-restart attacks omit most dense interactions and "
+    "fail; full dense multiplication is reported separately as the successful "
+    "reference algorithm."
+)
+
+# These are replaced with transcript-derived counts after the external runs.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _matvec(matrix, vector):
+    return [sum(a * b for a, b in zip(row, vector)) for row in matrix]
+
+
+_VERIFY_CACHE = {}
+
+
+def _cone_coordinates(inst):
+    """Memoize the exact instance-derived Bq, never the planted answer."""
+    key = id(inst)
+    cached = _VERIFY_CACHE.get(key)
+    marker = (id(inst.get("matrix")), id(inst.get("q")))
+    if cached is not None and cached[0] == marker:
+        return cached[1]
+    coordinates = _matvec(inst["matrix"], inst["q"])
+    if len(_VERIFY_CACHE) >= 64:
+        _VERIFY_CACHE.clear()
+    _VERIFY_CACHE[key] = (marker, coordinates)
+    return coordinates
+
+
+def _core_matrix(u, v):
+    n = len(u)
+    return [
+        [(1 if i == j else 0) - u[i] * v[j] for j in range(n)]
+        for i in range(n)
+    ]
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a certified Point-in-Cone instance.
+
+    First sample lambda.  Next choose C=I-u*v^T with u,v in {+1,-1}^n
+    and v^T u=0, so C^{-1}=I+u*v^T is integral.  Finally hide C by
+    signed row/column permutations and form q=B^{-1}lambda directly.
+    """
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4 or n % 2:
+        raise ValueError("n must be an even integer at least 4")
+    coeff_bound = params.pop("coeff_bound", 31)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if (
+        isinstance(coeff_bound, bool)
+        or not isinstance(coeff_bound, int)
+        or coeff_bound < 1
+    ):
+        raise ValueError("coeff_bound must be a positive integer")
+
+    rng = random.Random(seed)
+    answer = [rng.randrange(coeff_bound + 1) for _ in range(n)]
+
+    # w_i=u_i*v_i has equally many +1 and -1 entries, hence v^T u=0.
+    u = [rng.choice((-1, 1)) for _ in range(n)]
+    w = [1] * (n // 2) + [-1] * (n // 2)
+    rng.shuffle(w)
+    v = [u[i] * w[i] for i in range(n)]
+    core = _core_matrix(u, v)
+
+    row_perm = list(range(n))
+    col_perm = list(range(n))
+    rng.shuffle(row_perm)
+    rng.shuffle(col_perm)
+    row_sign = [rng.choice((-1, 1)) for _ in range(n)]
+    col_sign = [rng.choice((-1, 1)) for _ in range(n)]
+
+    matrix = [
+        [
+            row_sign[r]
+            * core[row_perm[r]][col_perm[c]]
+            * col_sign[c]
+            for c in range(n)
+        ]
+        for r in range(n)
+    ]
+
+    # Solve Bq=lambda by applying the known inverse, not by elimination.
+    z = [0] * n
+    for r in range(n):
+        z[row_perm[r]] = row_sign[r] * answer[r]
+    scalar = sum(v[i] * z[i] for i in range(n))
+    y = [z[i] + u[i] * scalar for i in range(n)]
+    q = [col_sign[c] * y[col_perm[c]] for c in range(n)]
+
+    # This assertion checks the construction, not searches for the answer.
+    if _matvec(matrix, q) != answer:
+        raise AssertionError("internal signed rank-one construction error")
+
+    return {
+        "family": "Point in Cone on a unimodular simplex",
+        "n": n,
+        "coeff_bound": coeff_bound,
+        "matrix": matrix,
+        "q": q,
+        "answer": answer,
+    }
+
+
+def render(inst):
+    n = inst["n"]
+    bound = inst["coeff_bound"]
+    rows = "\n".join(
+        f"  {i + 1}: " + " ".join(str(value) for value in row)
+        for i, row in enumerate(inst["matrix"])
+    )
+    q_text = " ".join(str(value) for value in inst["q"])
+    example = json.dumps([0] * n, separators=(",", ":"))
+    statement = f"""Find an exact integer-cone certificate for a bounded polytope.
+
+All indexing is 1-based.  Matrix-vector products use ordinary integer
+arithmetic, not arithmetic modulo any number.  Let B be the following {n} by
+{n} integer matrix; row labels are not matrix entries:
+{rows}
+
+Target q, in coordinate order:
+  {q_text}
+
+The instance guarantees det(B) is +1 or -1.  Define the bounded simplex
+
+  P = {{x in R^{n} : every coordinate of Bx is >= 0,
+                     and the sum of the coordinates of Bx is <= 1}}.
+
+Because B is integer unimodular, the integer points of P are exactly 0 and the
+vectors v_1,...,v_{n} uniquely defined by B v_j = e_j, where e_j has a 1 in
+position j and zeros elsewhere.  Thus these v_j are concrete integer points of
+P; no other lattice points are hidden from you.
+
+Return the unique coefficient vector lambda=(lambda_1,...,lambda_{n}) satisfying
+
+  q = lambda_1 v_1 + ... + lambda_{n} v_{n}.
+
+Every lambda_j is an integer in the inclusive range 0..{bound}.  Order matters,
+repetitions of coefficient values are allowed, and all {n} entries are required.
+
+Give your final answer inside <answer></answer> tags, as one JSON list of exactly
+{n} base-10 integers in facet-row order.
+Example of the required syntax: <answer>{example}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Parse a tagged JSON vector, tolerating prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    candidates = list(reversed(matches))
+    if not candidates:
+        # Conservative fallback for a model that omitted the requested tags:
+        # try JSON lists from the end, which avoids an earlier worked expression.
+        starts = [i for i, char in enumerate(text) if char == "["]
+        candidates = [text[i:] for i in reversed(starts)]
+    decoder = json.JSONDecoder()
+    for body in candidates:
+        cleaned = body.strip()
+        cleaned = re.sub(r"^```(?:json)?\s*", "", cleaned, flags=re.I)
+        cleaned = re.sub(r"\s*```$", "", cleaned)
+        try:
+            value, _ = decoder.raw_decode(cleaned.lstrip())
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continue
+        if isinstance(value, list):
+            return value
+    return None
+
+
+def verify(inst, answer):
+    """Check any valid coefficient witness; never consult inst['answer']."""
+    n = inst.get("n")
+    bound = inst.get("coeff_bound")
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) != n:
+        return False, f"wrong length: expected {n}, got {len(answer)}"
+    for i, value in enumerate(answer):
+        if isinstance(value, bool) or not isinstance(value, int):
+            return False, f"coefficient {i + 1} is not an integer"
+        if value < 0 or value > bound:
+            return False, (
+                f"coefficient {i + 1} is outside the inclusive range 0..{bound}"
+            )
+    matrix = inst.get("matrix")
+    q = inst.get("q")
+    if (
+        not isinstance(matrix, list)
+        or len(matrix) != n
+        or not isinstance(q, list)
+        or len(q) != n
+    ):
+        return False, "malformed instance dimensions"
+    for i, row in enumerate(matrix):
+        if not isinstance(row, list) or len(row) != n:
+            return False, f"malformed matrix row {i + 1}"
+    coordinates = _cone_coordinates(inst)
+    for i, coordinate in enumerate(coordinates):
+        if coordinate != answer[i]:
+            return False, (
+                f"cone-coordinate mismatch at position {i + 1}: "
+                f"Bq gives {coordinate}, answer gives {answer[i]}"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the fully structure-aware bounded coefficient language."""
+    bound = inst["coeff_bound"]
+    alphabet = bound + 1
+    if alphabet & (alphabet - 1) == 0:
+        bits = alphabet.bit_length() - 1
+        packed = rng.getrandbits(bits * inst["n"])
+        return [(packed >> (bits * i)) & bound for i in range(inst["n"])]
+    return [rng.randrange(bound + 1) for _ in range(inst["n"])]
+
+
+def search_space(inst):
+    return (inst["coeff_bound"] + 1) ** inst["n"]
+
+
+def enumerate_all(inst):
+    """Brute-force the bounded language only when it has at most 100,000 words."""
+    space = search_space(inst)
+    if space > 100_000:
+        return None
+    count = 0
+    alphabet = range(inst["coeff_bound"] + 1)
+    for candidate in itertools.product(alphabet, repeat=inst["n"]):
+        ok, _ = verify(inst, list(candidate))
+        count += int(ok)
+    return count
+
+
+def _canonical_payload(inst):
+    """Cheap signed-coordinate/row invariant, deliberately not a seed hash."""
+    matrix = inst["matrix"]
+    q = inst["q"]
+    coordinates = sorted(_matvec(matrix, q))
+    row_profiles = sorted(tuple(sorted(abs(x) for x in row)) for row in matrix)
+    col_profiles = sorted(
+        tuple(sorted(abs(matrix[r][c]) for r in range(inst["n"])))
+        for c in range(inst["n"])
+    )
+    return {
+        "n": inst["n"],
+        "bound": inst["coeff_bound"],
+        "cone_coordinates": coordinates,
+        "target_absolute_coordinates": sorted(abs(x) for x in q),
+        "row_absolute_profiles": row_profiles,
+        "column_absolute_profiles": col_profiles,
+    }
+
+
+def canonical_key(inst):
+    payload = json.dumps(_canonical_payload(inst), separators=(",", ":"))
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def escalate(params):
+    """Raise coefficient entropy at fixed answer length before reporting the cap."""
+    harder = dict(params)
+    bound = int(harder.get("coeff_bound", 31))
+    # Fixed n keeps the number of answer atoms and the compact operation count fixed.
+    if bound < 4095:
+        harder["coeff_bound"] = 2 * bound + 1
+        return harder
+    return "cap_bound"
+
+
+def _clip(value, bound):
+    return min(bound, max(0, value))
+
+
+def _attack_outlier(inst):
+    """Use only each row's unique non-unit-magnitude entry."""
+    out = []
+    for row in inst["matrix"]:
+        exceptional = [j for j, value in enumerate(row) if abs(value) != 1]
+        j = exceptional[0] if exceptional else 0
+        out.append(_clip(row[j] * inst["q"][j], inst["coeff_bound"]))
+    return out
+
+
+def _attack_greedy_largest_term(inst):
+    """Keep only the largest-magnitude summand in every dense row."""
+    out = []
+    bound = inst["coeff_bound"]
+    for row in inst["matrix"]:
+        terms = [a * b for a, b in zip(row, inst["q"])]
+        value = max(terms, key=lambda x: abs(x))
+        out.append(_clip(value, bound))
+    return out
+
+
+def _attack_permutation_only(inst):
+    """Treat exceptional positions as a monomial matrix and ignore rank one."""
+    out = []
+    modulus = inst["coeff_bound"] + 1
+    for r, row in enumerate(inst["matrix"]):
+        exceptional = [j for j, value in enumerate(row) if abs(value) != 1]
+        j = exceptional[0] if exceptional else r
+        sign = 1 if row[j] >= 0 else -1
+        out.append((sign * inst["q"][j]) % modulus)
+    return out
+
+
+def _transform_instance(inst, row_perm=None, col_perm=None, col_sign=None):
+    """Apply exact problem-preserving relabellings for the G8 audit."""
+    n = inst["n"]
+    row_perm = list(range(n)) if row_perm is None else list(row_perm)
+    col_perm = list(range(n)) if col_perm is None else list(col_perm)
+    col_sign = [1] * n if col_sign is None else list(col_sign)
+    matrix = [
+        [
+            inst["matrix"][row_perm[r]][col_perm[c]] * col_sign[c]
+            for c in range(n)
+        ]
+        for r in range(n)
+    ]
+    q = [inst["q"][col_perm[c]] * col_sign[c] for c in range(n)]
+    answer = [inst["answer"][row_perm[r]] for r in range(n)]
+    return {
+        "family": inst["family"],
+        "n": n,
+        "coeff_bound": inst["coeff_bound"],
+        "matrix": matrix,
+        "q": q,
+        "answer": answer,
+    }
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(v) for v in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(v) for v in value)
+    return 1
+
+
+def selftest():
+    report = {}
+
+    # G1: all presets, several independent seeds, plus JSON-native answers.
+    g1_checks = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            if not ok:
+                g1_failures.append(f"{preset}/seed={seed}: {why}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append(f"{preset}/seed={seed}: answer not JSON-native")
+            g1_checks += 1
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "checks": g1_checks,
+        "failures": g1_failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=1729, **shipping_params)
+
+    # G2: five corruption modes, with distinguishable diagnostics.
+    answer = list(inst["answer"])
+    swap_i = next((i for i in range(1, len(answer)) if answer[i] != answer[0]), 1)
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": [answer[swap_i]] + answer[1:swap_i] + [answer[0]] + answer[swap_i + 1 :],
+        "duplicate": answer + [answer[-1]],
+        "empty": [],
+        "out_of_range": [inst["coeff_bound"] + 1] + answer[1:],
+    }
+    corruption_results = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        corruption_results[name] = {"rejected": not ok, "reason": why}
+    reasons = [entry["reason"] for entry in corruption_results.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(x["rejected"] for x in corruption_results.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": corruption_results,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    # G3: realistic tagged output with prose and a Markdown fence.
+    realistic = (
+        "Multiplying by the facet-coordinate map gives the certificate.\n"
+        "```json\n<answer>"
+        + json.dumps(inst["answer"])
+        + "</answer>\n```\nThe entries use the required row order."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == inst["answer"],
+        "parsed_matches": parsed == inst["answer"],
+        "garbage_returns_none": parse_answer("not an answer") is None,
+    }
+
+    # G4 and shipping density: 200k uniform samples from the declared language.
+    samples = 200_000
+    hits = 0
+    guess_rng = random.Random(8675309)
+    density_start = time.perf_counter()
+    for _ in range(samples):
+        candidate = random_candidate(inst, guess_rng)
+        ok, _ = verify(inst, candidate)
+        hits += int(ok)
+    density_wall = time.perf_counter() - density_start
+    report["G4_guess_resistance"] = {
+        "pass": hits / samples < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": hits / samples,
+        "candidate_space": search_space(inst),
+        "sampling_prior": "uniform over all bounded length-n coefficient vectors",
+    }
+
+    # G6: four no-tool attacks fail; the successful polynomial algorithm is separate.
+    attack_names = (
+        "outlier_exceptional_entry",
+        "greedy_largest_term",
+        "random_restart_256",
+        "permutation_only_ansatz",
+    )
+    attack_stats = {
+        name: {"successes": 0, "attempts": 8} for name in attack_names
+    }
+    reference_times = []
+    reference_successes = 0
+    for seed in range(8):
+        probe = make_instance(seed=10_000 + seed, **shipping_params)
+        candidates = {
+            "outlier_exceptional_entry": _attack_outlier(probe),
+            "greedy_largest_term": _attack_greedy_largest_term(probe),
+            "permutation_only_ansatz": _attack_permutation_only(probe),
+        }
+        rr_rng = random.Random(20_000 + seed)
+        rr_success = False
+        for _ in range(256):
+            candidate = random_candidate(probe, rr_rng)
+            ok, _ = verify(probe, candidate)
+            if ok:
+                rr_success = True
+                break
+        attack_stats["random_restart_256"]["successes"] += int(rr_success)
+        for name, candidate in candidates.items():
+            ok, _ = verify(probe, candidate)
+            attack_stats[name]["successes"] += int(ok)
+
+        t0 = time.perf_counter()
+        reference = _matvec(probe["matrix"], probe["q"])
+        reference_times.append(time.perf_counter() - t0)
+        ok, _ = verify(probe, reference)
+        reference_successes += int(ok)
+
+    n_ship = inst["n"]
+    dense_operations = n_ship * n_ship + n_ship * (n_ship - 1)
+    report["G6_adversary_panel"] = {
+        "pass": all(entry["successes"] == 0 for entry in attack_stats.values()),
+        "attacks": attack_stats,
+        "reference_algorithm": {
+            "name": "dense exact facet-coordinate evaluation Bq",
+            "complexity": "Theta(n^2) exact integer arithmetic",
+            "wall_clock_sec_mean": sum(reference_times) / len(reference_times),
+            "operations": dense_operations,
+            "successes": reference_successes,
+            "attempts": 8,
+            "solves": f"{reference_successes}/8, as expected for Track B",
+        },
+    }
+
+    # G5: density at the actual shipping preset plus a measured strongest failure.
+    baseline_rng = random.Random(314159)
+    baseline_restarts = 2048
+    baseline_hits = 0
+    baseline_start = time.perf_counter()
+    for _ in range(baseline_restarts):
+        ok, _ = verify(inst, random_candidate(inst, baseline_rng))
+        baseline_hits += int(ok)
+    baseline_wall = time.perf_counter() - baseline_start
+    report["G5_density_and_baseline_cost"] = {
+        "pass": hits / samples < 1e-6 and baseline_hits == 0,
+        "shipping_sample_hits": hits,
+        "shipping_sample_total": samples,
+        "shipping_sampled_density": hits / samples,
+        "density_wall_clock_sec": density_wall,
+        "strongest_failing_attack": "uniform random restart",
+        "baseline_restarts": baseline_restarts,
+        "baseline_successes": baseline_hits,
+        "baseline_wall_clock_sec": baseline_wall,
+        "reference_operations": dense_operations,
+    }
+
+    # G7: n raises both the matrix work and language entropy; doubled n still works.
+    doubled = make_instance(
+        n=2 * shipping_params["n"],
+        coeff_bound=shipping_params["coeff_bound"],
+        seed=424242,
+    )
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and search_space(doubled) > search_space(inst)
+        and len(doubled["matrix"]) == 2 * len(inst["matrix"]),
+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "shipping_dense_operations": dense_operations,
+        "doubled_dense_operations": 2 * doubled["n"] ** 2 - doubled["n"],
+        "doubled_verify_reason": doubled_why,
+    }
+
+    # G8: row reorder, signed coordinate reorder, and their composition.
+    invariant_checks = 0
+    real_transform_checks = 0
+    invariant_failures = []
+    distinct_keys = []
+    for seed in range(20):
+        base = make_instance(n=16, coeff_bound=31, seed=50_000 + seed)
+        distinct_keys.append(canonical_key(base))
+        rng = random.Random(60_000 + seed)
+        rp = list(range(base["n"]))
+        cp = list(range(base["n"]))
+        rng.shuffle(rp)
+        rng.shuffle(cp)
+        signs = [rng.choice((-1, 1)) for _ in range(base["n"])]
+        transforms = [
+            _transform_instance(base, row_perm=rp),
+            _transform_instance(base, col_perm=cp),
+            _transform_instance(base, col_sign=signs),
+            _transform_instance(base, row_perm=rp, col_perm=cp, col_sign=signs),
+        ]
+        key = canonical_key(base)
+        for transformed in transforms:
+            invariant_checks += 1
+            if canonical_key(transformed) != key:
+                invariant_failures.append(f"seed={seed}, transform={invariant_checks % 4}")
+            ok, why = verify(transformed, transformed["answer"])
+            real_transform_checks += 1
+            if not ok:
+                invariant_failures.append(f"seed={seed}, transformed witness: {why}")
+    distinct_count = len(set(distinct_keys))
+    report["G8_canonical_key"] = {
+        "pass": not invariant_failures and distinct_count == 20,
+        "invariance_checks": invariant_checks,
+        "real_transformation_checks": real_transform_checks,
+        "distinct_unrelated": distinct_count,
+        "unrelated_total": 20,
+        "failures": invariant_failures,
+        "transformations": [
+            "facet-row permutation with carried coefficients",
+            "ambient-coordinate permutation",
+            "ambient-coordinate sign changes",
+            "composition of all three",
+        ],
+    }
+
+    # G9(c) alone gates.  Oracle arms are diagnostics populated after harden.py.
+    answer_blob = json.dumps(inst["answer"])
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(inst["answer"])
+    intended_operations = 2 * inst["n"] - 1
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = (
+        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+        if arms["hinted"]["attempts"]
+        else 0.0
+    )
+    placebo_rate = (
+        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        if arms["placebo"]["attempts"]
+        else 0.0
+    )
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        isinstance(value, dict) and value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G")
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

