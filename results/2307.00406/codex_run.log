+def _int_to_digits(value: int, base: int, length: int) -> list[int]:
+    out = []
+    for _ in range(length):
+        out.append(value % base)
+        value //= base
+    if value:
+        raise ValueError("integer does not fit the declared digit length")
+    return out
+
