python3 - <<'PY'
import importlib.util
s=importlib.util.spec_from_file_location('g','gen_2307_00406.py'); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
for preset,params in g.DIFFICULTY.items():
    worst_slack=10**100
    for seed in range(200):
        x=g.make_instance(seed=seed,**params)
        w=max(params['coeff_max']*sum(x['height_digits'][c][r] for c in range(x['n'])) for r in range(x['digit_rows']))
        worst_slack=min(worst_slack,x['base']-1-w)
        assert g.verify(x,x['answer'])==(True,'ok')
    print(preset,'minimum no-carry slack',worst_slack)
x=g.make_instance(seed=1,**g.DIFFICULTY['hard'])
bad=[z[:] for z in x['answer']]; bad[0][0]=0
print('noncanonical',g.verify(x,bad))
y=g._permute_binary_coordinates(x,__import__('random').Random(4))
print('permuted',g.verify(y,y['answer']),g.canonical_key(x)==g.canonical_key(y))
print('demo render size',len(g.render(g.make_instance(seed=7,**g.DIFFICULTY['demo']))))
