+        return False
+    for other, other_height in enumerate(inst["heights"]):
+        distance = (index ^ other).bit_count()
+        discrepancy = distance * target
+        if height + discrepancy < other_height:
+            return False
+        if target - height + discrepancy < target - other_height:
+            return False
+    return True
