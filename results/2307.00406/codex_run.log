+
+def _core_matrix(u, v):
+    n = len(u)
+    return [
+        [(1 if i == j else 0) - u[i] * v[j] for j in range(n)]
+        for i in range(n)
+    ]
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a certified Point-in-Cone instance.
+
+    First sample lambda.  Next choose C=I-u*v^T with u,v in {+1,-1}^n
+    and v^T u=0, so C^{-1}=I+u*v^T is integral.  Finally hide C by
+    signed row/column permutations and form q=B^{-1}lambda directly.
+    """
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4 or n % 2:
+        raise ValueError("n must be an even integer at least 4")
+    coeff_bound = params.pop("coeff_bound", 31)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if (
+        isinstance(coeff_bound, bool)
+        or not isinstance(coeff_bound, int)
+        or coeff_bound < 1
+    ):
+        raise ValueError("coeff_bound must be a positive integer")
+
+    rng = random.Random(seed)
+    answer = [rng.randrange(coeff_bound + 1) for _ in range(n)]
+
+    # w_i=u_i*v_i has equally many +1 and -1 entries, hence v^T u=0.
+    u = [rng.choice((-1, 1)) for _ in range(n)]
+    w = [1] * (n // 2) + [-1] * (n // 2)
+    rng.shuffle(w)
+    v = [u[i] * w[i] for i in range(n)]
+    core = _core_matrix(u, v)
+
+    row_perm = list(range(n))
+    col_perm = list(range(n))
+    rng.shuffle(row_perm)
+    rng.shuffle(col_perm)
+    row_sign = [rng.choice((-1, 1)) for _ in range(n)]
+    col_sign = [rng.choice((-1, 1)) for _ in range(n)]
+
+    matrix = [
+        [
+            row_sign[r]
+            * core[row_perm[r]][col_perm[c]]
+            * col_sign[c]
+            for c in range(n)
+        ]
+        for r in range(n)
+    ]
+
+    # Solve Bq=lambda by applying the known inverse, not by elimination.
+    z = [0] * n
+    for r in range(n):
+        z[row_perm[r]] = row_sign[r] * answer[r]
+    scalar = sum(v[i] * z[i] for i in range(n))
+    y = [z[i] + u[i] * scalar for i in range(n)]
+    q = [col_sign[c] * y[col_perm[c]] for c in range(n)]
+
+    # This assertion checks the construction, not searches for the answer.
+    if _matvec(matrix, q) != answer:
+        raise AssertionError("internal signed rank-one construction error")
+
+    return {
+        "family": "Point in Cone on a unimodular simplex",
+        "n": n,
+        "coeff_bound": coeff_bound,
+        "matrix": matrix,
+        "q": q,
+        "answer": answer,
+    }
+
+
+def render(inst):
+    n = inst["n"]
+    bound = inst["coeff_bound"]
+    rows = "\n".join(
+        f"  {i + 1}: " + " ".join(str(value) for value in row)
+        for i, row in enumerate(inst["matrix"])
+    )
+    q_text = " ".join(str(value) for value in inst["q"])
+    example = json.dumps([0] * n, separators=(",", ":"))
+    statement = f"""Find an exact integer-cone certificate for a bounded polytope.
+
+All indexing is 1-based.  Matrix-vector products use ordinary integer
+arithmetic, not arithmetic modulo any number.  Let B be the following {n} by
+{n} integer matrix; row labels are not matrix entries:
+{rows}
+
+Target q, in coordinate order:
+  {q_text}
+
+The instance guarantees det(B) is +1 or -1.  Define the bounded simplex
+
+  P = {{x in R^{n} : every coordinate of Bx is >= 0,
+                     and the sum of the coordinates of Bx is <= 1}}.
+
+Because B is integer unimodular, the integer points of P are exactly 0 and the
+vectors v_1,...,v_{n} uniquely defined by B v_j = e_j, where e_j has a 1 in
+position j and zeros elsewhere.  Thus these v_j are concrete integer points of
+P; no other lattice points are hidden from you.
+
+Return the unique coefficient vector lambda=(lambda_1,...,lambda_{n}) satisfying
+
+  q = lambda_1 v_1 + ... + lambda_{n} v_{n}.
+
+Every lambda_j is an integer in the inclusive range 0..{bound}.  Order matters,
+repetitions of coefficient values are allowed, and all {n} entries are required.
+
+Give your final answer inside <answer></answer> tags, as one JSON list of exactly
+{n} base-10 integers in facet-row order.
+Example of the required syntax: <answer>{example}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Parse a tagged JSON vector, tolerating prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    candidates = list(reversed(matches))
+    if not candidates:
+        # Conservative fallback for a model that omitted the requested tags:
+        # try JSON lists from the end, which avoids an earlier worked expression.
+        starts = [i for i, char in enumerate(text) if char == "["]
+        candidates = [text[i:] for i in reversed(starts)]
+    decoder = json.JSONDecoder()
+    for body in candidates:
+        cleaned = body.strip()
+        cleaned = re.sub(r"^```(?:json)?\s*", "", cleaned, flags=re.I)
+        cleaned = re.sub(r"\s*```$", "", cleaned)
+        try:
+            value, _ = decoder.raw_decode(cleaned.lstrip())
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continue
+        if isinstance(value, list):
+            return value
+    return None
+
+
+def verify(inst, answer):
+    """Check any valid coefficient witness; never consult inst['answer']."""
+    n = inst.get("n")
+    bound = inst.get("coeff_bound")
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) != n:
+        return False, f"wrong length: expected {n}, got {len(answer)}"
+    for i, value in enumerate(answer):
+        if isinstance(value, bool) or not isinstance(value, int):
+            return False, f"coefficient {i + 1} is not an integer"
+        if value < 0 or value > bound:
+            return False, (
+                f"coefficient {i + 1} is outside the inclusive range 0..{bound}"
+            )
+    matrix = inst.get("matrix")
+    q = inst.get("q")
+    if (
+        not isinstance(matrix, list)
+        or len(matrix) != n
+        or not isinstance(q, list)
+        or len(q) != n
+    ):
+        return False, "malformed instance dimensions"
+    for i, row in enumerate(matrix):
+        if not isinstance(row, list) or len(row) != n:
+            return False, f"malformed matrix row {i + 1}"
+    coordinates = _cone_coordinates(inst)
+    for i, coordinate in enumerate(coordinates):
+        if coordinate != answer[i]:
+            return False, (
+                f"cone-coordinate mismatch at position {i + 1}: "
+                f"Bq gives {coordinate}, answer gives {answer[i]}"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the fully structure-aware bounded coefficient language."""
+    bound = inst["coeff_bound"]
+    alphabet = bound + 1
+    if alphabet & (alphabet - 1) == 0:
+        bits = alphabet.bit_length() - 1
+        packed = rng.getrandbits(bits * inst["n"])
+        return [(packed >> (bits * i)) & bound for i in range(inst["n"])]
+    return [rng.randrange(bound + 1) for _ in range(inst["n"])]
+
+
+def search_space(inst):
+    return (inst["coeff_bound"] + 1) ** inst["n"]
+
+
+def enumerate_all(inst):
+    """Brute-force the bounded language only when it has at most 100,000 words."""
+    space = search_space(inst)
+    if space > 100_000:
+        return None
+    count = 0
+    alphabet = range(inst["coeff_bound"] + 1)
+    for candidate in itertools.product(alphabet, repeat=inst["n"]):
+        ok, _ = verify(inst, list(candidate))
+        count += int(ok)
+    return count
+
+
+def _canonical_payload(inst):
+    """Cheap signed-coordinate/row invariant, deliberately not a seed hash."""
+    matrix = inst["matrix"]
+    q = inst["q"]
+    coordinates = sorted(_matvec(matrix, q))
+    row_profiles = sorted(tuple(sorted(abs(x) for x in row)) for row in matrix)
+    col_profiles = sorted(
+        tuple(sorted(abs(matrix[r][c]) for r in range(inst["n"])))
+        for c in range(inst["n"])
+    )
+    return {
+        "n": inst["n"],
+        "bound": inst["coeff_bound"],
+        "cone_coordinates": coordinates,
+        "target_absolute_coordinates": sorted(abs(x) for x in q),
+        "row_absolute_profiles": row_profiles,
+        "column_absolute_profiles": col_profiles,
+    }
+
+
+def canonical_key(inst):
+    payload = json.dumps(_canonical_payload(inst), separators=(",", ":"))
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def escalate(params):
+    """Raise coefficient entropy at fixed answer length before reporting the cap."""
+    harder = dict(params)
+    bound = int(harder.get("coeff_bound", 31))
+    # Fixed n keeps the number of answer atoms and the compact operation count fixed.
+    if bound < 4095:
+        harder["coeff_bound"] = 2 * bound + 1
+        return harder
+    return "cap_bound"
