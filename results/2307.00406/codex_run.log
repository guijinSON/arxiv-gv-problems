+    for old, height in enumerate(inst["heights"]):
+        heights[move(old)] = height
+    out["heights"] = heights
+    out["answer"] = sorted([[move(index), multiplicity]
+                            for index, multiplicity in inst["answer"]])
+    return out
 
 
