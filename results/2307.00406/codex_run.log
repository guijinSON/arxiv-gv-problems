+                numerator = aug[r][j] * pivot_value - factor * aug[row][j]
+                aug[r][j] = numerator // previous_pivot
+                operations += 4  # two multiplies, subtraction, exact division
+            aug[r][col] = 0
+        previous_pivot = pivot_value
+        pivot_cols.append(col)
+        row += 1
