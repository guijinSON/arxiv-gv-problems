+    a, b = 1, first
+    replacements = {a: coeff[b], top - a: coeff[b],
+                    b: coeff[a], top - b: coeff[a]}
+    for term in bad:
+        if term[0] in replacements:
+            term[1] = replacements[term[0]]
+    return bad
