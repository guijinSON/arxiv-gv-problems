        rec["verify_reason"] = "parse_answer returned None"
        return rec

    ok, why = mod.verify(inst, ans)
    rec["verify_ok"] = bool(ok)
    rec["verify_reason"] = why
    rec["solved"] = "solved" if ok else "failed"
    return rec


