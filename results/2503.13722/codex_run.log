def _row_support(n, successor, row):
    """Return the three natural (pre-relabel) columns in one row of A."""
    half = n // 2
    if row < half:
        i = row
        return (i, successor[i], half + successor[i])
    i = row - half
    return (half + i, successor[i], half + successor[i])


def _parity_clauses(triple, rhs):
    """The four exact 3-clauses whose conjunction says xor(triple)=rhs."""
    clauses = []
    for bad in itertools.product((0, 1), repeat=3):
        if (bad[0] ^ bad[1] ^ bad[2]) == rhs:
            continue
        clauses.append([
            (v + 1) if bit == 0 else -(v + 1)
            for v, bit in zip(triple, bad)
        ])
    return clauses


def _false_tuple_clause(triple, bad):
    """A clause false at exactly the supplied three-bit tuple."""
    return [
        (v + 1) if bit == 0 else -(v + 1)
        for v, bit in zip(triple, bad)
    ]


def make_instance(n, seed=0, **params) -> dict:
    """Inverse-generate a MAX-3-SAT_tlb instance with a known witness.

    The assignment is sampled before the clauses.  The identity A^2=I proves
    that the parity core has exactly one solution; the Section 3 conversion
    carries that certificate to the exact 3-CNF instance.
    """
    decoy_pairs = params.pop("decoy_pairs", 0)
    if params:
        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
    if isinstance(n, bool) or not isinstance(n, int) or n < 6 or n % 2:
        raise ValueError("n must be an even integer at least 6")
    if (isinstance(decoy_pairs, bool) or not isinstance(decoy_pairs, int)
            or decoy_pairs < 0):
        raise ValueError("decoy_pairs must be a nonnegative integer")
    max_decoys = (n * (n - 1) * (n - 2)) // 6 - n
    if decoy_pairs > max_decoys:
        raise ValueError("too many decoy pairs for distinct variable triples")

    rng = random.Random(seed)
    half = n // 2
    cycle = list(range(half))
    rng.shuffle(cycle)
    clauses = []
    for clause in inst["clauses"]:
        moved = []
        for lit in clause:
            new = old_to_new[abs(lit) - 1] + 1
            moved.append(new if lit > 0 else -new)
        rng.shuffle(moved)
        clauses.append(moved)
    rng.shuffle(clauses)
    carried = [0] * n
    for old, new in enumerate(old_to_new):
        carried[new] = inst["answer"][old]
    return {
        "r": 3,
        "n": n,
        "m": inst["m"],
        "k": inst["k"],
        "threshold": inst["threshold"],
        "clauses": clauses,
        "decoy_pairs": inst.get("decoy_pairs", 0),
        "answer": carried,
    }


