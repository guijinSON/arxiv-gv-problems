def rank(A):
    """Exact rank of `A`.

    Guarantees the true rank over Q (no numerical threshold anywhere): for a
    square `A`, ``rank(A) == n`` iff ``det(A) != 0``, and
    ``rank(A) == rank(transpose(A))``.
    """
    _, pivots = _rref(A)
    return len(pivots)


def solve(A, b):
