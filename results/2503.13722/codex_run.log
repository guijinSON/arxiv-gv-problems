/bin/bash -lc "python3 - <<'PY'
import random, timeit
rng=random.Random(314159)
pi=list(range(35)); rng.shuffle(pi)
sigma=list(range(35))
for i in range(0,34,2): sigma[i],sigma[i+1]=i+1,i
stmt='inv=[0]*35\\nfor i,x in enumerate(pi): inv[x]=i\\ntau=[pi[sigma[inv[y]]] for y in range(35)]'
reps=200000
elapsed=timeit.timeit(stmt, number=reps, globals={'pi':pi,'sigma':sigma})
print({'repetitions':reps,'seconds':elapsed,'seconds_per_certificate':elapsed/reps,'coarse_table_writes':70})
