-
-    def visit(colored: int) -> list[int] | None:
-        nonlocal nodes
-        nodes += 1
-        if nodes > node_cap:
-            return None
-        if colored == n:
-            return list(labels)
-        uncolored = (u for u in range(n) if labels[u] < 0)
-        u = max(
-            uncolored,
-            key=lambda x: (
-                saturation_masks[x].bit_count(),
-                len(adjacency[x]),
-                -x,
-            ),
-        )
