+                    break
+            if u < 0:
+                bad_vertices = [vertex for vertex, value in enumerate(conflicts) if value > 0]
+                if not bad_vertices:
+                    continue
+                u = bad_vertices[rng.randrange(len(bad_vertices))]
+            best = min(neighbor_counts[u])
