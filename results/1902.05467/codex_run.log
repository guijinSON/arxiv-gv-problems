def attack(inst, cap=500000):
    adj=g._adjacency(inst); n=inst['n']; q=inst['colors']; labels=[-1]*n; masks=[0]*n
    first=max(range(n),key=lambda u:(len(adj[u]),-u)); second=max(adj[first],key=lambda u:(len(adj[u]),-u))
    labels[first]=0; labels[second]=1
    for v in adj[first]:
        if labels[v]<0:masks[v]|=1
    for v in adj[second]:
        if labels[v]<0:masks[v]|=2
    nodes=0
    def search(left):
        nonlocal nodes
        nodes+=1
        if nodes>cap:return None
        if left==0:return labels[:]
        u=max((x for x in range(n) if labels[x]<0),key=lambda x:(masks[x].bit_count(),len(adj[x]),-x))
        avail=((1<<q)-1)"'^masks[u]
        # least-constraining color ordering by number uncolored neighbors already forbidding it
        opts=[c for c in range(q) if avail>>c&1]
        opts.sort(key=lambda c:sum(1 for v in adj[u] if labels[v]<0 and not (masks[v]>>c&1)))
        for c in opts:
            bit=1<<c; labels[u]=c; changed=[]; impossible=False
            for v in adj[u]:
                if labels[v]<0:
                    old=masks[v]; new=old|bit
                    if new!=old:
                        masks[v]=new; changed.append((v,old))
                        if new==(1<<q)-1: impossible=True
            if not impossible:
                z=search(left-1)
                if z is not None:return z
            for v,old in changed:masks[v]=old
            labels[u]=-1
            if nodes>cap:return None
        return None
    ans=search(n-2)
    return ans,nodes

