+            range(n),
+            key=lambda i: min(
+                sum((x - y) ** 2 for x, y in zip(points[i], center))
+                for center in centers
+            ),
+        )
+        centers.append(points[index])
+
+    labels = [0] * n
+    for _ in range(40):
+        labels = [
+            min(
+                range(q),
+                key=lambda color: sum(
+                    (x - y) ** 2 for x, y in zip(point, centers[color])
+                ),
+            )
+            for point in points
+        ]
+        operations += n * q * dimension * 3
+        if len(set(labels)) < q:
