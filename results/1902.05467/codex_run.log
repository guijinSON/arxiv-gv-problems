-def selftest() -> dict:
-    """Run all mandatory construction, attack, diversity, and size gates."""
-    report: dict = {
-        "track": TRACK,
-        "shipping_difficulty": SHIPPING_DIFFICULTY,
-        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
