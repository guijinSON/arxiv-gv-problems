-    def assign(u: int, color: int) -> None:
-        labels[u] = color
-        bit = 1 << color
-        for v in adjacency[u]:
-            if labels[v] < 0:
-                neighbor_color_counts[v][color] += 1
-                saturation_masks[v] |= bit
-
-    def unassign(u: int, color: int) -> None:
-        labels[u] = -1
