+    outgoing = [
+        [position[(v, w)] for w in sorted(adjacency[v])]
+        for _, v in directed
+    ]
+    size = len(directed)
+    vectors = _orthonormalize(
+        [[rng.uniform(-1.0, 1.0) for _ in range(size)] for _ in range(dimension)]
+    )
+    operations = 0
