checks=[]
for name,p in g.DIFFICULTY.items():
    for seed in (0,1,17):
        inst=g.make_instance(seed=seed,**p)
        checks.append(g.verify(inst,inst['answer'])[0])
        assert json.loads(json.dumps(inst['answer'])) == inst['answer']
print('G1',sum(checks),'/',len(checks))
inst=g.make_instance(seed=0,**g.DIFFICULTY['demo'])
wrapped='prose\\n"'```json'"\\n<answer>'+json.dumps(inst['answer'])+'</answer>\\n"'```'"'
print('G3',g.parse_answer(wrapped)==inst['answer'])
print('demo',inst['answer'],g.verify(inst,inst['answer']))
print('hints',len(g.STRUCTURAL_HINT),len(g.PLACEBO_HINT))
