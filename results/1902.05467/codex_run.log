--- a/g9_hinted/gen_1902_05467.py
+++ b/g9_hinted/gen_1902_05467.py
@@ -49,11 +49,11 @@
     "hardness_basis": (
         "Track A: Section 3's identity between S-empty L(2,1)-labeling and graph "
