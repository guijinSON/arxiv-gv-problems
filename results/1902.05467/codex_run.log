import random,time

def graph(N,d,seed):
 r=random.Random(seed); lab=list(range(N));r.shuffle(lab); c=[None]*N
 for i,v in enumerate(lab):c[v]=i%3
 edges=set(); p=d/(2*N/3)
 for u in range(N):
  for v in range(u+1,N):
   if c[u]"'!=c[v] and r.random()<p:edges.add((u,v))
 return edges,c

def dsatur(N,E,cap=500000):
 adj=[set() for _ in range(N)]
 for u,v in E:adj[u].add(v);adj[v].add(u)
 color=[-1]*N;nodes=0
 # symmetry set first max-degree vertex 0
 first=max(range(N),key=lambda u:len(adj[u]));color[first]=0
 def go(done):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  if done==N:return color[:]
  un=[u for u in range(N) if color[u]<0]
  u=max(un,key=lambda x:(len({color[v] for v in adj[x] if color[v]>=0}),len(adj[x])))
  used={color[v] for v in adj[u] if color[v]>=0}
  for q in range(3):
   if q not in used:
    color[u]=q
    z=go(done+1)
    if z is not None:return z
    color[u]=-1
  return None
 t=time.perf_counter();z=go(1);return z,nodes,time.perf_counter()-t
for N in (96,144,192,240):
 for d in (3,4,5,6,7,8,10,12,15,20):
