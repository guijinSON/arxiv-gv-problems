The regenerated bare, structural, and placebo runs each stopped after four API redraws; all twelve records are preserved as service errors, with zero solver attempts. Local construction and verification are complete, but I will not label the family “hardened” or fabricate a verdict from those 403s. I’m doing a final interface/schema audit and synchronizing the README with the fresh measurements.
exec
/bin/bash -lc "python3 - <<'PY'
import importlib.util,json,re,ast
from pathlib import Path
p=Path('gen_1902_05467.py')
s=importlib.util.spec_from_file_location('m',p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
required=['make_instance','render','parse_answer','verify','random_candidate','search_space','enumerate_all','canonical_key','escalate','selftest']
assert all(callable(getattr(m,x,None)) for x in required)
assert m.TRACK in {'A','B'}
assert list(m.DIFFICULTY)==['demo','easy','medium','hard']
assert m.SHIPPING_DIFFICULTY in {'easy','medium','hard'}
assert isinstance(m.CERTIFICATE_LANGUAGE,dict) and m.CERTIFICATE_LANGUAGE.get('description') and 'bounds' in m.CERTIFICATE_LANGUAGE
inst=m.make_instance(seed=4242,**m.DIFFICULTY[m.SHIPPING_DIFFICULTY])
assert inst==m.make_instance(seed=4242,**m.DIFFICULTY[m.SHIPPING_DIFFICULTY])
assert json.loads(json.dumps(inst['answer']))==inst['answer']
assert m.verify(inst,inst['answer'])==(True,'ok')
assert m.parse_answer('prose <answer>'+json.dumps(inst['answer'])+'</answer> tail')==inst['answer']
assert m.parse_answer('garbage') is None
assert 'inst[\"answer\"]' not in ast.get_source_segment(p.read_text(), next(n for n in ast.walk(ast.parse(p.read_text())) if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) and n.name=='verify'))
rep=json.loads(Path('selftest_report.json').read_text())
assert rep['all_passed'] and all(v.get('pass') for k,v in rep.items() if re.match(r'G\\d',k))
assert len(rep['G6_adversary_panel']['attacks'])>=4
assert all(v['successes']==0 and v['attempts']>=8 for v in rep['G6_adversary_panel']['attacks'].values())
for f in ['llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl']:
 rows=[json.loads(x) for x in Path(f).read_text().splitlines() if x.strip()]
 assert len(rows)==4 and all(r['solved']=='error' and r['http_status']==403 for r in rows)
print('interface/schema/local-gates: OK')
print('oracle records: 12 errors, 0 completed attempts')
