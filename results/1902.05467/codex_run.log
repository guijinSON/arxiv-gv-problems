-def search_space(inst: dict) -> int:
-    """Return the Stirling number S(n,q), matching random_candidate exactly."""
-    n = inst["n"]
-    q = inst["colors"]
-    row = [0] * (q + 1)
-    row[0] = 1
-    for _ in range(n):
-        nxt = [0] * (q + 1)
-        for k in range(1, q + 1):
-            nxt[k] = row[k - 1] + k * row[k]
-        row = nxt
-    return math.factorial(q) * row[q]
