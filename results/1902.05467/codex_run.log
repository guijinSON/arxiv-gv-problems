+    "accidental transcription errors."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An unordered partition of vertices 1..n into exactly q nonempty classes, "
+        "encoded canonically as q sorted integer lists ordered by their least "
+        "element.  It is equivalent to an S-empty L(2,1) labeling using the "
