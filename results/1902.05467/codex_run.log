+                if old_v_conflict == 0 < conflicts[v]:
+                    bad_count += 1
+                elif old_v_conflict > 0 == conflicts[v]:
+                    bad_count -= 1
+                operations += 2
+            labels[u] = new_color
+            conflicts[u] = neighbor_counts[u][new_color]
+            if old_u_conflict == 0 < conflicts[u]:
+                bad_count += 1
+            elif old_u_conflict > 0 == conflicts[u]:
+                bad_count -= 1
+            operations += q
