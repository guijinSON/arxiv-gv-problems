+def _nonbacktracking_spectral_attack(
+    inst: dict, rng: random.Random, iterations: int = 80
+) -> tuple[object | None, int]:
+    """Cluster a bottom nonbacktracking subspace, then check the coloring."""
+    adjacency = _adjacency(inst)
+    n = inst["n"]
+    q = inst["colors"]
