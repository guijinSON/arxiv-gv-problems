-_G4_SAMPLES = 200_000
-_ATTACK_SEEDS = 8
-_DSATUR_NODE_CAP = 100_000
-_UNPACK_FOUR_EVEN = tuple(
-    tuple(2 * ((byte >> (2 * offset)) & 3) for offset in range(4))
-    for byte in range(256)
