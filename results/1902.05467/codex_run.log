import gen_1902_05467 as g,random,time

def walk(inst,seed,restarts=64,steps_factor=500):
 A=g._adjacency(inst);n=inst['n'];q=inst['colors'];r=random.Random(seed);ops=0
 for z in range(restarts):
  c=[r.randrange(q) for _ in range(n)];conf=[0]*n
  for u in range(n):conf[u]=sum(c[u]==c[v] for v in A[u]);ops+=len(A[u])
  bad={u for u in range(n) if conf[u]}
  for step in range(steps_factor*n):
   if not bad:return c,ops,z,step
   u=r.choice(tuple(bad)); scores=[sum(c[v]==x for v in A[u]) for x in range(q)];m=min(scores)
   choices=[x for x,s in enumerate(scores) if s==m]
   # noise sometimes random; mostly min
   new=r.randrange(q) if r.random()<0.03 else r.choice(choices);old=c[u]
   if new==old:continue
   for v in A[u]:
    if c[v]==old:
     conf[u]-=1;conf[v]-=1
     if conf[v]==0:bad.discard(v)
    if c[v]==new:
     conf[u]+=1;conf[v]+=1;bad.add(v)
   c[u]=new
   if conf[u]:bad.add(u)
   else:bad.discard(u)
   ops+=q*len(A[u])
 return None,ops,restarts,steps_factor*n
for s in range(800,808):
 i=g.make_instance(seed=s,**g.DIFFICULTY['hard']);t=time.perf_counter();c,ops,z,st=walk(i,s"'^123,64,500);print(s,c is not None,z,st,ops,round(time.perf_counter()-t,3),flush=True)
