def walk(inst,seed,restarts=32,steps_factor=200):
 A=g._adjacency(inst);n=inst['n'];q=inst['colors'];r=random.Random(seed);ops=0
 for z in range(restarts):
  c=[r.randrange(q) for _ in range(n)]
  for step in range(steps_factor*n):
   bad=[u for u in range(n) if any(c[u]==c[v] for v in A[u])]
