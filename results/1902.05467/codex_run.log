-def _dsatur_attack(inst: dict, node_cap: int = _DSATUR_NODE_CAP) -> tuple[object | None, int]:
-    """Exact DSATUR backtracking, stopped after a declared node budget."""
-    adjacency = _adjacency(inst)
-    n = inst["n"]
-    q = inst["colors"]
