import gen_1902_05467 as g,random,time

def walk(inst,seed,restarts=16,steps_factor=200):
 A=g._adjacency(inst);n=inst['n'];q=inst['colors'];r=random.Random(seed);ops=0
 for z in range(restarts):
  c=[r.randrange(q) for _ in range(n)];conf=[0]*n
  for u in range(n):conf[u]=sum(c[u]==c[v] for v in A[u]);ops+=len(A[u])
  bad=sum(x>0 for x in conf)
  for step in range(steps_factor*n):
   if bad==0:return c,ops,z,step
   for _ in range(20):
    u=r.randrange(n)
    if conf[u]:break
   else:
    candidates=[u for u,x in enumerate(conf) if x];u=r.choice(candidates)
   scores=[sum(c[v]==x for v in A[u]) for x in range(q)];m=min(scores)
   new=r.choice([x for x,s in enumerate(scores) if s==m]);old=c[u]
