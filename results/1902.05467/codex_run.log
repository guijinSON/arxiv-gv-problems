+        "domain_standard_attack": "DSATUR exact coloring search with unit-style propagation",
+    }
+
+    demo = make_instance(seed=123, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    dsatur = attacks["dsatur_backtracking_20000_nodes"]
+    report["G5_density_and_baseline"] = {
