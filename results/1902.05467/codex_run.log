-    duplicate = list(answer) + [answer[0]]
-    emptied: list[int] = []
-    out_of_range = list(answer)
-    out_of_range[0] = 2 * shipping["colors"]
-    corruptions = {
-        "drop": dropped,
-        "swap": swapped,
-        "duplicate": duplicate,
-        "empty": emptied,
-        "out_of_range": out_of_range,
