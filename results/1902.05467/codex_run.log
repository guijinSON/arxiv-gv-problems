+    atoms = 0
+
+    def visit(value: object) -> None:
+        nonlocal atoms
+        if isinstance(value, dict):
+            for child in value.values():
+                visit(child)
+        elif isinstance(value, (list, tuple)):
+            for child in value:
+                visit(child)
+        else:
+            atoms += 1
+
+    visit(answer)
+    return len(encoded), math.ceil(len(encoded) / 4), atoms
