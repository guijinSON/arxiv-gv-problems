+    "bounds": {
+        "vertex_range": "1..n",
+        "class_count": "q=colors",
+        "class_size": "1..n-q+1",
+        "total_vertex_atoms": "n",
+        "named_preset_max_vertices": 240,
+        "candidate_count": "q! times the Stirling number S(n,q)",
