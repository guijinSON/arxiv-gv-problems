-            edges = trial
-            break
-    if edges is None:
-        raise RuntimeError("could not sample a connected planted graph")
-
-    arcs = []
-    for u, v in edges:
-        if rng.randrange(2):
-            u, v = v, u
-        arcs.append([u + 1, v + 1])
-    rng.shuffle(arcs)
-    answer = [2 * label for label in planted_class]
-    return {
-        "family": "planted_S_empty_oriented_L21_labeling",
-        "n": n,
-        "colors": colors,
-        "avg_degree": avg_degree,
-        "arcs": arcs,
-        "answer": answer,
-    }
