+    for code in inst["answer"]:
+        root = _decode(code, p)
+        if conjugate:
+            root = _conj(root, p)
+        root = _mul(root, vinv, p)
+        carried.append(_encode(root, p))
+    moved["answer"] = carried
+    return moved, carried
