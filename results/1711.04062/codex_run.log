+    moved = copy.deepcopy(inst)
+    p = inst["p"]
+    v_inv = _inv(_square(u, p), p)
+    v_inv2 = _square(v_inv, p)
+    target = _internal_curve(inst["target_curve"], p)
+    moved["target_curve"] = _public_curve((
+        _mul(target[0], v_inv, p),
+        _mul(target[1], v_inv2, p),
+    ))
+    return moved
+
