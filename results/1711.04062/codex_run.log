+    # G8: source-root translation, coordinate scaling, Frobenius, and
+    # compositions of those genuine curve-model relabelings.
+    invariant_checks = 0
+    carried_checks = 0
+    unrelated_keys = []
+    g8_failures = []
+    symmetry_params = {"n": 16, "mersenne_exponent": 31}
+    for seed in range(20):
