+    # G6 across eight independently generated shipping instances.
+    attack_successes = {
+        "outlier_smallest_kernel": 0,
+        "greedy_endpoint_coefficients": 0,
+        "random_restart_64": 0,
+        "meet_in_middle_capped_16384": 0,
