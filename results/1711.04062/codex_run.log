+    # G9(c) is the only gate.  Seven exact field expressions per edge are
+    # sufficient when the supplied roots are replayed with common subexpressions:
+    # t^2, a2*t, root equality, A, B, new a2, new a4.
+    answer_blob = json.dumps(inst["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
