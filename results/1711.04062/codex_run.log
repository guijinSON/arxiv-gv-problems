+
+    attacks = {
+        name: {"successes": attack_successes[name],
+               "attempts": attack_attempts[name]}
+        for name in attack_successes
+    }
+    all_failed = len(attacks) >= 4 and all(v["successes"] == 0
+                                           and v["attempts"] >= 8
+                                           for v in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed,
+        "attacks": attacks,
