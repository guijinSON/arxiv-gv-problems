for p in [5,13,17,29,37,41,61,73,89,97]:
    if any(p%d==0 for d in range(2,int(p**0.5)+1)):
        continue
    reps=[]
    for a in range(1,int(p**0.5)+1):
        b2=p-a*a
        b=int(b2**0.5)
        if b*b==b2:
            reps.append((a,b))
    row=[]
    for A in [-1,1]:
        s=0
        for x in range(p):
            v=(x*x*x+A*x)%p
            s += 0 if v==0 else (1 if pow(v,(p-1)//2,p)==1 else -1)
        row.append((A,p+1+s,-s))
    print(p,reps,row)
