+def _relabel_instance(inst: dict, u: tuple[int, int], conjugate: bool
+                     ) -> tuple[dict, list[str]]:
+    """Apply x=u^2*x' (and optionally Frobenius) and carry the witness."""
+    moved = copy.deepcopy(inst)
+    p = inst["p"]
+    v = _square(u, p)
+    vinv = _inv(v, p)
+    vinv2 = _square(vinv, p)
