+        "mitm_total_wall_clock_sec": sum(s["wall_clock_sec"] for s in mitm_stats),
+        "complete_forward_leaves": 3 * (1 << (inst["n"] // 2 - 1)),
+        "complete_reverse_leaves": 1 << (inst["n"] - inst["n"] // 2),
