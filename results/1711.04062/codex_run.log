+_BASE36 = "0123456789abcdefghijklmnopqrstuvwxyz"
+_BASE36_RE = re.compile(r"^[0-9a-z]+$")
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer>", re.I | re.S)
+
