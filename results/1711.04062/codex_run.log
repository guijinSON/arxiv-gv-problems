+                tk = _curve_key(target)
+                score = sum(abs(a - b) for a, b in zip(ck, tk))
+            options.append((score, t, child))
+        _, chosen, curve = min(options, key=lambda row: (row[0], row[1]))
+        answer.append(_encode(chosen, p))
