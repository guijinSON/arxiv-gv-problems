+def _random_restart(inst: dict, rng: random.Random, attempts: int) -> tuple[bool, int]:
+    for trial in range(1, attempts + 1):
+        if verify(inst, random_candidate(inst, rng))[0]:
+            return True, trial
+    return False, attempts
