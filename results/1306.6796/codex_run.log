index 0558ea143a65222d654656ae1b21baa1b24f7ee5..0059b6dff2fafd7a17933216c9ce653039074401
--- a/medium_hinted/gen_1306_6796.py
+++ b/medium_hinted/gen_1306_6796.py
@@ -79,10 +79,7 @@
 # it does not change the answer length.  The demo has one tiny factor so that
