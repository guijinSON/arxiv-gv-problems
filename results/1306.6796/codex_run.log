+def escalate(params: dict) -> dict:
+    harder = dict(params)
+    harder.pop("_preset", None)
+    harder["n"] = int(harder["n"] * 3 // 2) + 1
+    harder["prime_pool"] = max(32, int(harder.get("prime_pool", 32)))
+    return harder
