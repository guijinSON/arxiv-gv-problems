+        "greedy_prefix_missing_direction": {"successes": 0, "attempts": 0, "operations": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0, "candidates": 0},
+        "by_hand_three_point_second_difference": {"successes": 0, "attempts": 0,
