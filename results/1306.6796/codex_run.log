+def _answer_measure(inst: dict) -> tuple[int, int, int]:
+    blob = json.dumps(inst["answer"], separators=(",", ":"))
+    atoms = sum(len(row) for matrix in inst["answer"] for row in matrix)
+    return len(blob), (len(blob) + 3) // 4, atoms
