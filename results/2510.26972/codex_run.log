+    before_params = dict(DIFFICULTY["medium"])
+    after_params = dict(before_params)
+    after_params["n"] *= 2
+    before = make_instance(seed=771, **before_params)
+    after = make_instance(seed=771, **after_params)
+    g7_ok = (
