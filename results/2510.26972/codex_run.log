+def _in_context_ansatz(inst: dict) -> list[list[int]]:
+    t = inst["answer_terms"] - 1
+    stride = max(1, inst["target_degree"] // (t + 1))
+    return _candidate_with_exponents(inst, [j * stride for j in range(1, t)])
