+    duplicated = json.loads(json.dumps(planted))
+    duplicated[2][1] = duplicated[1][1]
+    out_of_range = json.loads(json.dumps(planted))
+    out_of_range[0][0] = ship["q"]
+    corruptions = {
+        "drop_one": dropped,
+        "swap_two": swapped,
