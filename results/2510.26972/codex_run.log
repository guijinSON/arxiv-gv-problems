+def _outlier_attack(inst: dict) -> list[list[int]]:
+    q = inst["q"]
+    t = inst["answer_terms"] - 1
+    ranked = sorted(
+        inst["beta_coordinates"],
+        key=lambda pair: abs(pair[1] - q // 2),
+        reverse=True,
