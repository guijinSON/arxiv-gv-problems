+        "computable by a fast Walsh-Hadamard inversion in O(n log n); at the "
+        "provisional shipping preset n=1024 it takes 13,319 counted exact "
+        "operations (measured wall-clock is recorded by selftest), while the "
+        "unit-character route uses at most 161 exact operations and is not "
+        "apparent without undoing both relabellings."
+    ),
+    "max_answer_tokens": 39,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
