+        if not (row_on or column_on or reorder):
+            continue
+        variants.append(
+            _relabel_instance(
+                inst,
+                row_phi=row_phi if row_on else None,
+                column_phi=column_phi if column_on else None,
+                reorder=reorder,
+            )
+        )
