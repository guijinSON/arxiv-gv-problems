+def _worst_answer_chars(inst):
+    maximum_weight = (1 << (inst["weight_bits"] - 1)) - 1
+    specimen = [
+        [inst["n"] - 1, [maximum_weight, 1]] for _ in range(inst["k"])
+    ]
+    return len(json.dumps(specimen, separators=(",", ":")))
+
+
+def escalate(params):
