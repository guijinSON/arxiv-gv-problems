+def _fwht(values):
+    out = list(values)
+    width = 1
+    n = len(out)
+    while width < n:
+        for start in range(0, n, 2 * width):
+            for j in range(start, start + width):
+                a, b = out[j], out[j + width]
+                out[j] = a + b
+                out[j + width] = a - b
+        width *= 2
+    return out
