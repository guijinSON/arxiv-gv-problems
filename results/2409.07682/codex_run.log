def _format_indexed_pairs(pairs, per_line=8):
    chunks = []
    for start in range(0, len(pairs), per_line):
        chunks.append("  " + "  ".join(f"{i}:{v}" for i, v in pairs[start:start + per_line]))
    return "\n".join(chunks)


