+                verify(transformed, transformed["answer"])[0]
+            )
+        unrelated_keys.append(original_key)
+    distinct_count = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant_count == 140
+        and real_transform_count == 140
