/bin/bash -lc "python3 - <<'PY'
from fractions import Fraction
import gen_2409_07682 as g
inst=g.make_instance(seed=0,**g.DIFFICULTY['demo'])
n=inst['n']
S=[[Fraction(g._walsh_entry(g._network(r,inst['row_network'],n),g._network(c,inst['column_network'],n))) for c in range(n)] for r in range(n)]
# For a row/column-permuted Walsh matrix, S"'^{-1}=(1/n) Q''^T H P''^T;
# compute it directly from orthogonality as transpose only when permutations differ:
# generic Gauss-Jordan keeps this audit independent of that shortcut.
aug=[row[:] + [Fraction(int(i==j)) for j in range(n)] for i,row in enumerate(S)]
for c in range(n):
    p=next(i for i in range(c,n) if aug[i][c])
    aug[c],aug[p]=aug[p],aug[c]
    q=aug[c][c]
    aug[c]=[x/q for x in aug[c]]
    for i in range(n):
        if i!=c and aug[i][c]:
            q=aug[i][c]
            aug[i]=[a-q*b for a,b in zip(aug[i],aug[c])]
Sinv=[row[n:] for row in aug]
