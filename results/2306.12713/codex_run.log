+        transformed_answer = {
+            "path": list(reversed(original["answer"]["path"])),
+            "cycles": [],
+        }
+        for index, cycle in enumerate(reversed(original["answer"]["cycles"])):
+            moved = cycle[1:] + cycle[:1]
+            if index % 2:
