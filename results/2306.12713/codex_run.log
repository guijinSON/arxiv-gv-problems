   334	\begin{theorem}\label{pyramidal+mathing:thm} 
   335	There exists a pyramidal solution to 
   336	$OP(x, \;^2\ell_1,  \ldots,\;^2 \ell_u)$, with $u\geq 1$, that satisfies the matching property when either
   337	\begin{enumerate}
   338	  \item there exists a graceful labeling of $\left[\lfloor\frac{x-3}{2}\rfloor\mid \ell_1, \ldots, \ell_u\right]$, or
   339	  \item $x\geq 2B(L)+3$ with $L=\{\ell_1, \ldots, \ell_u\}$.
   340	\end{enumerate}
   341	\end{theorem}
   342	\begin{proof} Let $x=2k+\epsilon$, with $\epsilon\in\{1,2\}$, and set
   343	  $a = k + \sum_{i=1}^u\ell_i$. Note that $a\geq2$ since $u\geq 1$, 
   344	  and $\lfloor\frac{x-3}{2}\rfloor = k-1$.
   345	  Since Theorem \ref{graceful:thm} guarantees the existence of a graceful labeling of $[k-1\mid \ell_1, \ldots, \ell_u]$ whenever $k-1\geq B(L)$, that is, $x\geq 2B(L)+3$, it is enough to prove the assertion under assumption 1. 
   346	  Therefore, let
   347	$T = P\,\cup\,R$ be a graceful labeling of $[k-1\mid\ell_1, \ldots, \ell_u]$,
   348	where $P$ is a $(k-1)$-path disjoint from the $2$-regular graph $R\simeq[\ell_1, \ldots, \ell_u]$. 
   349	Hence,
   350	 \begin{equation}\label{graceful}
   351	   V(T)     = \{0, \ldots, a-1\}\;\;\;\text{and}\;\;\; 
   352	   \Delta T = \{\pm1, \ldots, \pm (a-1)\}.
   353	 \end{equation}
   354	 Let $p_0$ and $p_1$ denote the end-vertices of $P$, let $\cE$ be the graph 
   355	 with $E(\cE) = \{\{\infty_1, p_0\}, \{\infty_1, p_0+a\}, \{p_1, p_1+a\}\}$, and set
   356	 $\cC = P \cup (P+a)\cup \cE$. Finally, set
   357	 \[
   358	   G = T \,\cup\, (T+a)\, \cup\, \cE = 
   359	       R \,\cup\, (R+a)\, \cup\, \cC
   360	 \]
   361	 By \eqref{graceful}, 
   362	 $V(G) = V(T)\,\cup\,V(T+a)\,\cup\,\{\infty_1\} = \{0,\ldots,2a-1\}\,\cup\,\{\infty_1\}$. Also, recalling that $P$ and $R$ are vertex-disjoint, it follows that $P,R, P+a, R+a$ are vertex-disjoint, as well. Hence, $\cC$ is a $(2k+1)$-cycle, and
   363	 $G\simeq[2k+1, \;^2\ell_1,  \ldots,\;^2 \ell_u]$. 
   364	 
   365	From now on, we consider the vertices of $G$ and its subgraphs modulo $2a$, hence $V(G)=\Z_{2a}\,\cup\,\{\infty_1\}$. By \eqref{graceful} and considering that $a\in\Delta \cE$, we have that 
   366	 $\Delta G \supset \Delta T\,\cup\,\Delta \cE \supset  \Z_{2a}\setminus\{0\}$. Also, by construction, $G + a = G$. Therefore, Theorem \ref{starter} guarantees that
   367	 $\cG = \{G+i\mid i\in\Z_{2a}\}$ is a $1$-rotational solution to 
   368	 $OP(2k+1, \;^2\ell_1,  \ldots,\;^2 \ell_u)$.
   369	 
   370	 We now show that $\cG$ satisfies the matching property. 
   371	 Let $H = Q\,\cup\,R$ be a halving of $G$
   372	 obtained by choosing the $1$-path $Q$ in $\cC$ so that
   373	 \[
   374	   V(Q)=
   375	   \begin{cases}
   376	     \{\infty_1, p_0\} & \text{if $1\leq p_0\leq a-1$},\\
   377	     \{\infty_1, p_0+a\} & \text{if $p_0=0$}.     
   378	   \end{cases}
   379	 \]
   380	 Also, let $M = Q\,\cup\, N$ be a matching of $H$, 
   381	 where $N$ consists of $u$ edges belonging to the $u$ distinct cycles of $R$. 
   382	 Recalling that $V(R)\subset\{0, \ldots, a-1\}$, it is not difficult to see that the matching $N$ of $R$ can be chosen so that $0\not\in V(N)$, that is
   383	 \[
   384	   V(N)\subset\{1, \ldots, a-1\}. 
   385	 \]
   386	 Clearly, $cs(G\setminus M) = \{\ell_1, \ldots, \ell_u\}$. 
   387	 Also, $H' = H+(a+1)$ is a halving of $G'=G+(a+1)=G+1$ which is a graph of $\cG$  distinct from $G$, since $a>1$. Note that $H'$ is the vertex-disjoint union of the 
   388	 $1$-path $Q'=Q+(a+1)$ and the $2$-regular graph $R' = R+(a+1)$, where
   389	 \[
   390	   V(R') \subset \{0\}\,\cup\,\{a+1,\ldots, 2a-1\}.
   391	 \]
   392	 Considering the vertex-sets of $Q, N$ and $R'$, we conclude that $M$ and $R'$ are vertex-disjoint. Also, $M\,\cup\,Q'$ is either a matching or a linear forest. Hence
   393	 $M\,\cup\, H'$ is a $(1,2)$-graph with $cs(M\,\cup\, H') = cs(R') = \{\ell_1, \ldots, \ell_u\}$. This proves that $\cG$ satisfies the matching property with respect to $M$, the two distinct graphs $G$ and $G'$, and the halving $H'$ of $G'$, thus showing the assertion for $\epsilon=1$.
   394	 
   395	 Consider  the matching $I$ containing the edges $e_\infty = \{\infty_1, \infty_2\}$ and $e_i=\{p_1+i, p_1+a+i\}$, for $0\leq i< a$. Clearly,
   396	 $I$ is a $1$-factor of $K_{2a+2}$, with 
   397	$V(K_{2a+2}) = \Z_{2a}\,\cup\, \{\infty_1, \infty_2\}$. 
   398	 Now let $G^*$ be the graph obtained from $G$ by removing the edge  
   399	 $e_0$ and then joining its end-vertices to $\infty_2$, and set
   400	 \[
   401	   \cG^* = \{G^*+i\mid 0\leq i <a\}.
