+DIFFICULTY = {
+    "easy": {
+        "n": 64,
+        "min_cycles": 3,
+        "min_distinct_cycles": 3,
+        "path_min_ratio": 0.10,
+        "path_max_ratio": 0.65,
+        "build_attempts": 1400,
+    },
+    "medium": {
+        "n": 96,
+        "min_cycles": 3,
+        "min_distinct_cycles": 3,
+        "path_min_ratio": 0.10,
+        "path_max_ratio": 0.60,
+        "build_attempts": 1800,
+    },
+    "hard": {
+        "n": 144,
+        "min_cycles": 4,
+        "min_distinct_cycles": 3,
+        "path_min_ratio": 0.08,
+        "path_max_ratio": 0.55,
+        "build_attempts": 3000,
+    },
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
