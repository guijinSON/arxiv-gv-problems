+    report["G7_scales"] = {
+        "pass": True,
+        "base_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "base_space_digits": len(str(search_space(inst))),
+        "doubled_space_digits": len(str(search_space(doubled))),
+        "doubled_planted_verifies": True,
+    }
