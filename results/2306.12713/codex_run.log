+{
+  "G1_planted_verifies": {
+    "cases": [
+      {"ok": true, "preset": "easy", "seed": 0},
+      {"ok": true, "preset": "easy", "seed": 1},
+      {"ok": true, "preset": "easy", "seed": 2},
+      {"ok": true, "preset": "medium", "seed": 0},
+      {"ok": true, "preset": "medium", "seed": 1},
+      {"ok": true, "preset": "medium", "seed": 2},
+      {"ok": true, "preset": "hard", "seed": 0},
+      {"ok": true, "preset": "hard", "seed": 1},
+      {"ok": true, "preset": "hard", "seed": 2}
+    ],
+    "pass": true
+  },
+  "G2_rejects_corruption": {
