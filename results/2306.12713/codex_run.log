import random, math

def make(a,seed):
 r=random.Random(seed)
 starts=[None]+[r.randrange(a-d+1) for d in range(1,a+1)]
 deg=[0]*(a+1)
 for d in range(1,a+1):
  s=starts[d];deg[s]+=1;deg[s+d]+=1
 def pc(x): return (1-x)**2 if x<1 else (x-2)**2 if x>2 else 0
 score=sum(map(pc,deg))
 best=score
 for it in range(2000000):
  if score==0: break
  d=r.randrange(1,a+1); old=starts[d]; new=r.randrange(a-d+1)
  if new==old: continue
  affected={old,old+d,new,new+d}
  before=sum(pc(deg[x]) for x in affected)
  deg[old]-=1;deg[old+d]-=1;deg[new]+=1;deg[new+d]+=1
  after=sum(pc(deg[x]) for x in affected); ns=score+after-before
  temp=max(.02,2*(1-it/2000000))
  if ns<=score or r.random()<math.exp((score-ns)/temp): starts[d]=new;score=ns
  else:
   deg[old]+=1;deg[old+d]+=1;deg[new]-=1;deg[new+d]-=1
  best=min(best,score)
 if score: return None,it,best
 adj=[[] for _ in deg]
 for d in range(1,a+1):
  s=starts[d];adj[s].append(s+d);adj[s+d].append(s)
 seen=set();lens=[];paths=[]
 for v in range(a+1):
  if v not in seen:
   st=[v];seen.add(v);c=[]
   while st:
    x=st.pop();c.append(x)
    for y in adj[x]:
     if y not in seen:seen.add(y);st.append(y)
   (paths if any(len(adj[x])==1 for x in c) else lens).append(len(c))
 return (len(paths[0])-1, sorted(lens)),it,best
for a in [20,30,40,60,80,100]:
 print('a',a)
 for s in range(5):print(s,make(a,s))
