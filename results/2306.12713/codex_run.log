+    # G8: component order, traversal direction, cycle rotation/reversal, and
+    # global label reflection are the full cheap symmetries of this encoding.
+    keys = []
+    invariance_checks = 0
+    carried_witness_checks = 0
+    answer_symmetry_checks = 0
