+        "carried_witness_checks": carried_witness_checks,
+        "answer_symmetry_checks": answer_symmetry_checks,
+        "distinct_unrelated_keys": len(set(keys)),
+        "complete_invariant": "one path length plus sorted cycle-length multiset",
+    }
