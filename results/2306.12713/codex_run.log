+def search_space(inst: dict) -> int | None:
+    """Number of structurally legal labelings modulo presentation symmetries."""
+    a = inst["path_edges"] + sum(inst["cycle_lengths"])
+    return math.factorial(a + 1) // _representation_symmetry(inst)
