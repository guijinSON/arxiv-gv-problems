+    # G6: three construction-aware cheap attacks over eight fresh problems.
+    attack_rows = {
+        "degree_outlier_extremes": {"attempts": 0, "solved": 0},
+        "largest_difference_greedy": {"attempts": 0, "solved": 0},
+        "random_restart_128": {"attempts": 0, "solved": 0},
