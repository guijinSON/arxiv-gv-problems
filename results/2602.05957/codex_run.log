    \begin{tikzpicture}
        \node[anchor=south west,inner sep=0] at (0,0) {\includegraphics[width=0.5\linewidth]{NNI_cone_decomp4.png}};
       \node at (4,5) {\Large\textcolor{Grn}{$K$}}; 
       \node at (5,2) {\Large\textcolor{Blue}{$K_{-}$}}; 
       \node at (5,3.3) {\Large\textcolor{OliveGreen}{$\bm{u}$}}; 
