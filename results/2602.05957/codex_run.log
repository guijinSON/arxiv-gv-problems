+    c = (rays[0][0], rays[0][1])
+    d = (rays[1][0], rays[1][1])
+    if _det(c, d) == 0:
+        raise ValueError("cone rays are collinear")
+    if _det(c, d) < 0:
+        c, d = d, c
+    return c, d
+
+
+def _points(inst: dict) -> list[tuple[int, int]]:
