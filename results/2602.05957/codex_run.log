+
+    rng = random.Random(seed)
+    a = (_fibonacci(fib_index), _fibonacci(fib_index + 1))
+    b = (_fibonacci(fib_index + 1), _fibonacci(fib_index + 2))
+    if _det(a, b) < 0:
+        a, b = b, a
+
+    # A seed-dependent unimodular shear changes the displayed coordinates but
+    # preserves primitivity, determinants, the cone problem, and the answer.
+    shear = rng.randrange(0, 9)
+    T = [[1, 0], [shear, 1]]
+    a = _matvec(T, a)
+    b = _matvec(T, b)
+    c = (margin * a[0] - b[0], margin * a[1] - b[1])
+    d = (margin * b[0] - a[0], margin * b[1] - a[1])
+    if min(*a, *b, *c, *d) <= 0 or _det(c, a) <= 0 or _det(b, d) <= 0:
+        raise ArithmeticError("internal cone construction failed")
+
+    # This optional gvlib check exercises the repo's exact matrix layer without
+    # making it a dependency.  All emitted values remain JSON-native integers.
+    if exact_matrices is not None:
+        basis = exact_matrices.matrix([[a[0], b[0]], [a[1], b[1]]])
+        if exact_matrices.det(basis) != 1:
+            raise ArithmeticError("hidden generators are not unimodular")
+    elif _det(a, b) != 1:
+        raise ArithmeticError("hidden generators are not unimodular")
+
+    common_sum = (8 * n + 2 * pairs + 1
+                  + 2 * rng.randrange(max(1, n // 4 + 1)))
+    differences = [6 * n + 1, 6 * n + 3]
+    pool = [4 * n + 1 + 2 * j for j in range(max(2 * pairs, 2 * n))]
+    pool = [x for x in pool
+            if x < common_sum and x not in differences]
+    differences.extend(rng.sample(pool, pairs - 2))
+
+    displayed: list[tuple[int, int]] = []
+    coefficients: list[tuple[int, int, int]] = []
+    for difference in differences:
+        alpha = (common_sum + difference) // 2
+        beta = (common_sum - difference) // 2
+        if beta <= 0 or alpha + beta != common_sum:
+            raise ArithmeticError("invalid hidden coefficient pair")
+        left = (alpha * a[0] + beta * b[0],
+                alpha * a[1] + beta * b[1])
+        right = (beta * a[0] + alpha * b[0],
+                 beta * a[1] + alpha * b[1])
+        displayed.extend((left, right))
+        coefficients.append((difference, alpha, beta))
+
+    rng.shuffle(displayed)
+    u, _ = _extreme_points(displayed)
+    max_difference, alpha_max, beta_max = max(coefficients)
+    expected_u = (alpha_max * a[0] + beta_max * b[0],
+                  alpha_max * a[1] + beta_max * b[1])
+    if u != expected_u:
+        raise ArithmeticError("coefficient extrema do not match cone extrema")
+    q = (alpha_max * a[0], alpha_max * a[1])
+
+    return {
+        "family": "rank-two affine-semigroup generators",
+        "scale": n,
+        "cone_rays": [list(c), list(d)],
+        "points": [list(p) for p in displayed],
+        "answer": {
+            "split": list(q),
+            "generators": [list(a), list(b)],
+        },
+    }
+
+
+def _answer_text(answer: object) -> str:
+    return json.dumps(answer, separators=(",", ":"), sort_keys=True)
+
+
+def render(inst: dict) -> str:
+    """Render a self-contained exact cone-generation problem."""
+    c, d = _ordered_rays(inst)
+    points = _points(inst)
+    u, v = _extreme_points(points)
+    lines = [
+        "Rank-two integer-semigroup generator problem",
+        "",
+        "For integer vectors x=(x1,x2), y=(y1,y2), define",
+        "det(x,y)=x1*y2-x2*y1.  The pointed cone cone(c,d) is the set",
+        "{lambda*c+mu*d : lambda,mu are nonnegative real numbers}.",
+        "A nonzero integer vector is primitive when gcd(|x1|,|x2|)=1.",
+        "",
+        f"The ordered cone rays are c={list(c)} and d={list(d)}; det(c,d)>0.",
+        "The integer points, in arbitrary order, are:",
+    ]
+    lines.extend(f"  p{i} = {list(p)}" for i, p in enumerate(points, 1))
+    lines.extend([
+        "",
+        f"Here u={list(u)} is the minimum oriented-slope point and v={list(v)}",
+        "is the maximum oriented-slope point.  (Equivalently, det(u,p)>=0",
+        "and det(p,v)>=0 for every displayed p.)",
+        "",
+        "Find an integer split q and two ordered primitive integer generators a,b.",
+        "They must satisfy all of the following exact conditions:",
+        "1. q and u-q are both nonzero.",
+        "2. q lies in cone(c,u), and u-q lies in cone(v,d).  Closed cone",
+        "   boundaries are allowed.",
+        "3. a is the primitive vector on q's positive ray, and b is the",
+        "   primitive vector on (u-q)'s positive ray.",
+        "4. Every displayed point p has p=r*a+s*b for some nonnegative",
+        "   integers r,s.  The coefficients need not be output.",
+        "",
+        "All coordinates and all output entries are base-10 integers.  Order matters:",
+        "a is the lower-cone generator belonging to q, and b belongs to u-q.",
+        "Give your final answer inside <answer></answer> tags as exactly one JSON",
+        "object with keys split and generators, where split is [q1,q2] and",
+        "generators is [[a1,a2],[b1,b2]].",
+        "Example format: <answer>{\"split\":[12,20],\"generators\":[[3,5],[5,8]]}</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    statement = "\n".join(lines)
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Parse the tagged JSON object, tolerating prose and markdown fences."""
+    if not isinstance(text, str):
+        return None
+    tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
+                        flags=re.IGNORECASE | re.DOTALL)
+    bodies = list(reversed(tagged))
+    if not bodies:
+        # A conservative fallback for a model that omitted only the tags.
+        bodies = [text]
+    decoder = json.JSONDecoder()
+    for body in bodies:
+        cleaned = re.sub(r"^\s*```(?:json)?\s*|\s*```\s*$", "", body.strip(),
+                         flags=re.IGNORECASE | re.DOTALL)
+        try:
+            value = json.loads(cleaned)
+            if isinstance(value, dict):
+                return value
+        except (TypeError, ValueError):
+            pass
+        for match in re.finditer(r"\{", cleaned):
+            try:
+                value, _ = decoder.raw_decode(cleaned[match.start():])
+            except ValueError:
+                continue
+            if isinstance(value, dict):
+                return value
+    return None
+
+
+def _inside_ordered_cone(left: tuple[int, int], x: tuple[int, int],
+                         right: tuple[int, int]) -> bool:
+    return _det(left, x) >= 0 and _det(x, right) >= 0
+
+
+def _generators_valid(points: list[tuple[int, int]],
+                      a: tuple[int, int], b: tuple[int, int]) -> bool:
+    determinant = _det(a, b)
+    if determinant <= 0:
+        return False
+    for p in points:
+        ra = _det(p, b)
+        rb = _det(a, p)
+        if (ra < 0 or rb < 0
+                or ra % determinant != 0 or rb % determinant != 0):
+            return False
+    return True
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any declared lattice-split witness without reading inst['answer']."""
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if set(answer) != {"split", "generators"}:
+        return False, "answer must contain exactly split and generators"
+    split = answer.get("split")
+    generators = answer.get("generators")
+    if (not isinstance(split, list) or len(split) != 2
+            or any(isinstance(x, bool) or not isinstance(x, int) for x in split)):
+        return False, "split must be a length-2 integer list"
+    if (not isinstance(generators, list) or len(generators) != 2
+            or any(not isinstance(row, list) or len(row) != 2 for row in generators)
+            or any(isinstance(x, bool) or not isinstance(x, int)
+                   for row in generators for x in row)):
+        return False, "generators must be a 2-by-2 integer matrix"
+    try:
+        c, d = _ordered_rays(inst)
+        points = _points(inst)
+    except (KeyError, TypeError, ValueError) as exc:
+        return False, f"invalid instance: {exc}"
+    u, v = _extreme_points(points)
+    q = (split[0], split[1])
+    remainder = (u[0] - q[0], u[1] - q[1])
+    if q == (0, 0) or remainder == (0, 0):
+        return False, "split parts must both be nonzero"
+    if not _inside_ordered_cone(c, q, u):
+        return False, "split lies outside the lower closed cone"
+    if not _inside_ordered_cone(v, remainder, d):
+        return False, "split remainder lies outside the upper closed cone"
+    expected_a = _primitive(q)
+    expected_b = _primitive(remainder)
+    a = (generators[0][0], generators[0][1])
+    b = (generators[1][0], generators[1][1])
+    if a != expected_a:
+        return False, "first generator is not the primitive ray of split"
+    if b != expected_b:
+        return False, "second generator is not the primitive ray of the remainder"
+    if not _generators_valid(points, a, b):
+        return False, "a displayed point has no nonnegative integer coordinates"
+    return True, "ok"
+
+
+def _ceil_div(a: int, b: int) -> int:
+    return -((-a) // b)
+
+
+_ROW_CACHE: dict[tuple[Any, ...], tuple[list[tuple[int, int, int]], list[int], int]] = {}
+
+
+def _row_cache_key(inst: dict) -> tuple[Any, ...]:
+    c, d = _ordered_rays(inst)
+    return (c, d, tuple(_points(inst)))
+
+
+def _delta_segments(inst: dict) -> tuple[list[tuple[int, int, int]], list[int], int]:
+    """Return x/lo/hi segments, cumulative counts, and |Delta \ {0,u}|.
+
+    Generated instances have positive coordinates.  The four determinant
+    inequalities are solved exactly for y at each integer x; no float or search
+    for a certificate is involved.
+    """
+    key = _row_cache_key(inst)
+    cached = _ROW_CACHE.get(key)
+    if cached is not None:
+        return cached
+    c, d = _ordered_rays(inst)
+    points = _points(inst)
+    u, v = _extreme_points(points)
+    if min(*c, *d, *u, *v) <= 0:
+        raise ValueError("candidate enumeration requires the generated positive chart")
+    segments: list[tuple[int, int, int]] = []
+    cumulative: list[int] = []
+    total = 0
+    for x in range(u[0] + 1):
+        lower = max(
+            0,
+            _ceil_div(c[1] * x, c[0]),
+            _ceil_div(d[1] * x + d[0] * u[1] - d[1] * u[0], d[0]),
+        )
+        upper = min(
+            u[1],
+            (u[1] * x) // u[0],
+            (v[1] * x + v[0] * u[1] - v[1] * u[0]) // v[0],
+        )
+        if lower > upper:
+            continue
+        cuts = {(0, 0), u}
+        start = lower
+        for bad_x, bad_y in sorted(cuts):
+            if bad_x == x and lower <= bad_y <= upper:
+                if start <= bad_y - 1:
+                    segments.append((x, start, bad_y - 1))
+                    total += bad_y - start
+                    cumulative.append(total)
+                start = bad_y + 1
+        if start <= upper:
+            segments.append((x, start, upper))
+            total += upper - start + 1
+            cumulative.append(total)
+    result = (segments, cumulative, total)
+    _ROW_CACHE[key] = result
+    return result
+
+
+def _candidate_from_q(inst: dict, q: tuple[int, int]) -> dict[str, Any]:
+    u, _ = _extreme_points(_points(inst))
+    r = (u[0] - q[0], u[1] - q[1])
+    a = _primitive(q)
+    b = _primitive(r)
+    if a is None or b is None:
+        return {"split": list(q), "generators": [[0, 0], [0, 0]]}
+    return {"split": list(q), "generators": [list(a), list(b)]}
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the exact paper-derived bounded split language."""
+    segments, cumulative, total = _delta_segments(inst)
+    if total <= 0:
+        return None
+    index = rng.randrange(total)
+    row = bisect.bisect_right(cumulative, index)
+    before = cumulative[row - 1] if row else 0
+    x, lo, _ = segments[row]
+    q = (x, lo + index - before)
+    return _candidate_from_q(inst, q)
+
+
+def search_space(inst: dict) -> int | None:
+    """Exact number of non-endpoint lattice splits in Delta."""
+    return _delta_segments(inst)[2]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count valid split witnesses exactly when the region has <=100,000 points."""
+    segments, _, total = _delta_segments(inst)
+    if total > 100_000:
+        return None
+    count = 0
+    for x, lo, hi in segments:
+        for y in range(lo, hi + 1):
+            count += int(verify(inst, _candidate_from_q(inst, (x, y)))[0])
+    return count
+
+
+def canonical_key(inst: dict) -> str:
+    """A strong GL(2,Z)- and point-order-invariant determinant signature."""
+    c, d = _ordered_rays(inst)
+    points = _points(inst)
+    data = {
+        "cone_index": abs(_det(c, d)),
+        "point_contents": sorted(math.gcd(abs(x), abs(y)) for x, y in points),
+        "point_pair_areas": sorted(abs(_det(p, q))
+                                   for p, q in combinations(points, 2)),
+        "boundary_areas": sorted(
+            sorted((abs(_det(c, p)), abs(_det(p, d)))) for p in points
+        ),
+    }
+    payload = json.dumps(data, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow triangle crowding first, then displayed decoys, at fixed answer size."""
+    result = {k: v for k, v in params.items() if k != "_preset"}
+    n = int(result.get("n", 1))
+    pairs = int(result.get("pairs", 2))
+    fib_index = int(result.get("fib_index", 3))
+    if n < 10**30:
+        result["n"] = n * 2
+        if pairs < 8:
+            result["pairs"] = pairs + 1
+        elif fib_index < 12:
+            # A larger ambient basis enlarges printed arithmetic while the
+            # six-atom witness shape stays fixed.
+            result["fib_index"] = fib_index + 1
+        return result
+    return "cap_bound"
+
+
+def _certificate_for_generators(inst: dict, a: tuple[int, int],
+                                b: tuple[int, int]) -> dict[str, Any] | None:
+    if _det(a, b) < 0:
+        a, b = b, a
+    determinant = _det(a, b)
+    if determinant <= 0:
+        return None
+    points = _points(inst)
+    if not _generators_valid(points, a, b):
+        return None
+    u, _ = _extreme_points(points)
+    alpha_num = _det(u, b)
+    beta_num = _det(a, u)
+    if (alpha_num <= 0 or beta_num <= 0
+            or alpha_num % determinant or beta_num % determinant):
+        return None
+    alpha = alpha_num // determinant
+    q = (alpha * a[0], alpha * a[1])
+    candidate = {"split": list(q), "generators": [list(a), list(b)]}
+    return candidate if verify(inst, candidate)[0] else None
+
+
+def _attack_candidates(inst: dict, seed: int) -> dict[str, object | None]:
+    points = _points(inst)
+    c, d = _ordered_rays(inst)
+    u, v = _extreme_points(points)
+
+    shortest = sorted(points, key=lambda p: (p[0] * p[0] + p[1] * p[1], p))[:2]
+    shortest_candidate = _certificate_for_generators(
+        inst, _primitive(shortest[0]) or (0, 0),
+        _primitive(shortest[1]) or (0, 0))
+    extreme_candidate = _certificate_for_generators(
+        inst, _primitive(u) or (0, 0), _primitive(v) or (0, 0))
+    boundary_candidate = _certificate_for_generators(
+        inst, _primitive(c) or (0, 0), _primitive(d) or (0, 0))
+
+    input_pair_candidate = None
+    for p, q in combinations(points, 2):
+        pp, qq = _primitive(p), _primitive(q)
+        if pp is None or qq is None:
+            continue
+        input_pair_candidate = _certificate_for_generators(inst, pp, qq)
+        if input_pair_candidate is not None:
+            break
+
+    restart_candidate = None
+    rng = random.Random(seed)
+    for _ in range(4096):
+        candidate = random_candidate(inst, rng)
+        if candidate is not None and verify(inst, candidate)[0]:
+            restart_candidate = candidate
+            break
+    return {
+        "outlier_two_shortest_inputs": shortest_candidate,
+        "greedy_primitive_extreme_rays": extreme_candidate,
+        "obvious_primitive_cone_boundaries": boundary_candidate,
+        "by_hand_all_input_direction_pairs": input_pair_candidate,
+        "random_restart_4096": restart_candidate,
+    }
+
+
+def _reference_algorithm(inst: dict) -> tuple[dict[str, Any] | None, dict[str, int]]:
+    """Section 3/Algorithm 1's bounded triangle scan in lexicographic order."""
+    points = _points(inst)
+    u, _ = _extreme_points(points)
+    segments, _, _ = _delta_segments(inst)
+    candidates = point_checks = operations = 0
+    for x, lo, hi in segments:
+        for y in range(lo, hi + 1):
+            candidates += 1
+            q = (x, y)
+            r = (u[0] - x, u[1] - y)
+            ga = math.gcd(abs(x), abs(y))
+            gb = math.gcd(abs(r[0]), abs(r[1]))
+            operations += 6  # two gcd calls and four exact divisions
+            a = (x // ga, y // ga)
+            b = (r[0] // gb, r[1] // gb)
+            determinant = _det(a, b)
+            operations += 3
+            if determinant <= 0:
+                continue
+            ok = True
+            for p in points:
+                point_checks += 1
+                ra = _det(p, b)
+                rb = _det(a, p)
+                operations += 10  # two dets, signs, two divisibility tests
+                if (ra < 0 or rb < 0
+                        or ra % determinant or rb % determinant):
+                    ok = False
+                    break
+            if ok:
+                answer = {"split": [x, y], "generators": [list(a), list(b)]}
+                if verify(inst, answer)[0]:
+                    return answer, {
+                        "candidate_splits": candidates,
+                        "point_coordinate_checks": point_checks,
+                        "operations": operations,
+                    }
+    return None, {
+        "candidate_splits": candidates,
+        "point_coordinate_checks": point_checks,
+        "operations": operations,
+    }
+
+
+def _gcd_with_cost(a: int, b: int) -> tuple[int, int]:
+    a, b = abs(a), abs(b)
+    cost = 0
+    while b:
+        a, b = b, a % b
+        cost += 1
+    return a, cost
+
+
+def _compact_route(inst: dict) -> tuple[dict[str, Any] | None, int]:
+    """Recover the witness from central symmetry; count exact arithmetic."""
+    points = _points(inst)
+    if len(points) % 2:
+        return None, 0
+    pair_count = len(points) // 2
+    total_x = total_y = 0
+    operations = 0
+    for x, y in points:
+        total_x += x
+        total_y += y
+        operations += 2
+    if total_x % pair_count or total_y % pair_count:
+        return None, operations + 2
+    W = (total_x // pair_count, total_y // pair_count)
+    operations += 4
+
+    sum_gcd, gcd_cost = _gcd_with_cost(W[0], W[1])
+    operations += gcd_cost
+    if sum_gcd == 0:
+        return None, operations
+    sum_direction = (W[0] // sum_gcd, W[1] // sum_gcd)
+    operations += 2
+
+    unused = set(points)
+    differences: list[tuple[int, int]] = []
+    while unused:
+        p = min(unused)
+        mate = (W[0] - p[0], W[1] - p[1])
+        operations += 2
+        if mate not in unused or mate == p:
+            return None, operations
+        unused.remove(p)
+        unused.remove(mate)
+        if _det(p, mate) > 0:
+            low, high = p, mate
+        else:
+            low, high = mate, p
+        operations += 3
+        differences.append((high[0] - low[0], high[1] - low[1]))
+        operations += 2
+
+    dx = dy = 0
+    for x, y in differences:
+        dx, cost = _gcd_with_cost(dx, x)
+        operations += cost
+        dy, cost = _gcd_with_cost(dy, y)
+        operations += cost
+    difference_direction = (dx, dy)
+    a_num = (sum_direction[0] - difference_direction[0],
+             sum_direction[1] - difference_direction[1])
+    b_num = (sum_direction[0] + difference_direction[0],
+             sum_direction[1] + difference_direction[1])
+    operations += 4
+    if any(x % 2 for x in (*a_num, *b_num)):
+        return None, operations + 4
+    a = (a_num[0] // 2, a_num[1] // 2)
+    b = (b_num[0] // 2, b_num[1] // 2)
+    operations += 4
+    if _det(a, b) < 0:
+        a, b = b, a
+    u, _ = _extreme_points(points)
+    determinant = _det(a, b)
+    alpha_num = _det(u, b)
+    operations += 6
+    if determinant <= 0 or alpha_num <= 0 or alpha_num % determinant:
+        return None, operations + 2
+    alpha = alpha_num // determinant
+    q = (alpha * a[0], alpha * a[1])
+    operations += 4
+    answer = {"split": list(q), "generators": [list(a), list(b)]}
+    return (answer, operations) if verify(inst, answer)[0] else (None, operations)
+
+
+def _atom_count(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_atom_count(v) for v in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_atom_count(v) for v in value)
+    return 1
+
+
+def _transform_instance(inst: dict, T: list[list[int]], *, reverse_points: bool = False
+                        ) -> tuple[dict, dict]:
+    if _det((T[0][0], T[1][0]), (T[0][1], T[1][1])) != 1:
+        raise ValueError("test transform must lie in SL(2,Z)")
+    transformed = dict(inst)
+    transformed["cone_rays"] = [list(_matvec(T, v)) for v in inst["cone_rays"]]
+    transformed_points = [list(_matvec(T, v)) for v in inst["points"]]
+    if reverse_points:
+        transformed_points.reverse()
+    transformed["points"] = transformed_points
+    carried = {
+        "split": list(_matvec(T, inst["answer"]["split"])),
+        "generators": [list(_matvec(T, v))
+                       for v in inst["answer"]["generators"]],
+    }
+    # Deliberately retain the old planted field: verify receives `carried`
+    # explicitly, proving neither it nor canonical_key consults inst['answer'].
+    transformed["answer"] = inst["answer"]
+    return transformed, carried
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return a fully JSON-native evidence dictionary."""
+    report: dict[str, Any] = {
+        "paper": "2602.05957",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    failures: list[str] = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in range(4):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                failures.append(f"{preset}/{seed}: {reason}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append(f"{preset}/{seed}: answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not failures, "attempts": attempts, "failures": failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=314159, **ship_params)
+    planted = json.loads(json.dumps(ship["answer"]))
+    corruptions = {
+        "drop_one": {"split": planted["split"],
+                     "generators": planted["generators"][:1]},
+        "swap_one": {"split": planted["split"],
+                     "generators": list(reversed(planted["generators"]))},
+        "duplicate_one": {"split": planted["split"],
+                          "generators": [planted["generators"][0],
+                                         planted["generators"][0]]},
+        "empty": [],
+        "out_of_range": {"split": [-1, 0],
+                         "generators": planted["generators"]},
+    }
+    cases: dict[str, Any] = {}
+    reasons: list[str] = []
+    for name, candidate in corruptions.items():
+        ok, reason = verify(ship, candidate)
+        cases[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": all(case["rejected"] for case in cases.values())
+        and len(set(reasons)) == len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "cases": cases,
+    }
+
+    realistic = (
+        "I used exact determinant coordinates.\n```json\n<answer>"
+        + _answer_text(planted) + "</answer>\n```\nAll coefficients are integral."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("no answer here") is None,
+        "parsed": parsed,
+    }
+
+    sample_total = 200_000
+    sample_rng = random.Random(8675309)
+    sample_hits = 0
+    sample_started = time.perf_counter()
+    for _ in range(sample_total):
+        candidate = random_candidate(ship, sample_rng)
+        sample_hits += int(candidate is not None and verify(ship, candidate)[0])
+    sample_wall = time.perf_counter() - sample_started
+    observed = sample_hits / sample_total
+    space = search_space(ship)
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6 and space is not None and space > 1_000_000,
+        "hits": sample_hits,
+        "total": sample_total,
+        "observed_probability": observed,
+        "candidate_space": space,
+        "sampler": "uniform over non-endpoint lattice splits in Delta",
+        "sample_wall_clock_sec": sample_wall,
+    }
+
+    attack_names = [
+        "outlier_two_shortest_inputs",
+        "greedy_primitive_extreme_rays",
+        "obvious_primitive_cone_boundaries",
+        "by_hand_all_input_direction_pairs",
+        "random_restart_4096",
+    ]
+    attacks = {name: {"successes": 0, "attempts": 8} for name in attack_names}
+    reference_successes = 0
+    reference_times: list[float] = []
+    reference_candidates: list[int] = []
+    reference_checks: list[int] = []
+    reference_operations: list[int] = []
+    for seed in range(8):
+        trial = make_instance(seed=12_000 + seed, **ship_params)
+        for name, candidate in _attack_candidates(trial, 700_000 + seed).items():
+            if candidate is not None and verify(trial, candidate)[0]:
+                attacks[name]["successes"] += 1
+        started = time.perf_counter()
+        found, metrics = _reference_algorithm(trial)
+        reference_times.append(time.perf_counter() - started)
+        reference_candidates.append(metrics["candidate_splits"])
+        reference_checks.append(metrics["point_coordinate_checks"])
+        reference_operations.append(metrics["operations"])
+        reference_successes += int(found is not None and verify(trial, found)[0])
+
+    reference = {
+        "name": "Section 3 Algorithm 1 bounded-triangle lattice enumeration",
+        "complexity": (
+            "polynomial in ||u|| and matrix size; pseudo-polynomial in coordinate bitlength"
+        ),
+        "wall_clock_sec_mean": sum(reference_times) / len(reference_times),
+        "wall_clock_sec_max": max(reference_times),
+        "candidate_splits_mean": sum(reference_candidates) / len(reference_candidates),
+        "candidate_splits_max": max(reference_candidates),
+        "point_coordinate_checks_mean": sum(reference_checks) / len(reference_checks),
+        "operations_mean": sum(reference_operations) / len(reference_operations),
+        "operations_max": max(reference_operations),
+        "solves": f"{reference_successes}/8, as expected",
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": (sample_total >= 200_000 and demo_count is not None
+                 and reference_successes == 8),
+        "shipping_density_hits": sample_hits,
+        "shipping_density_total": sample_total,
+        "shipping_observed_fraction": observed,
+        "shipping_candidate_space": space,
+        "shipping_valid_solution_count": enumerate_all(ship),
+        "demo_valid_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "baseline_wall_clock_sec_mean": reference["wall_clock_sec_mean"],
+        "baseline_wall_clock_sec_max": reference["wall_clock_sec_max"],
+        "baseline_candidate_splits_mean": reference["candidate_splits_mean"],
+        "baseline_operations_mean": reference["operations_mean"],
+        "baseline_operations_max": reference["operations_max"],
+    }
+
+    all_attacks_failed = all(
+        value["successes"] == 0 and value["attempts"] >= 8
+        for value in attacks.values()
+    )
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": reference,
+    }
+
+    doubled_params = dict(ship_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=271828, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    doubled_space = search_space(doubled)
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled_space is not None and doubled_space > space,
+        "shipping_n": ship_params["n"],
+        "shipping_space": space,
+        "doubled_n": doubled_params["n"],
+        "doubled_space": doubled_space,
+        "doubled_planted_verifies": doubled_ok,
+    }
+
+    invariance_checks = real_transform_checks = 0
+    invariant_failures: list[str] = []
+    distinct_keys: list[str] = []
+    transforms = [
+        ([[1, 0], [0, 1]], True),
+        ([[1, 1], [0, 1]], False),
+        ([[0, -1], [1, 0]], True),
+        ([[1, -1], [1, 0]], False),
+    ]
+    for seed in range(20):
+        base = make_instance(seed=90_000 + seed, **ship_params)
+        key = canonical_key(base)
+        distinct_keys.append(key)
+        for T, reverse in transforms:
+            changed, carried = _transform_instance(base, T, reverse_points=reverse)
+            invariance_checks += 1
+            if canonical_key(changed) != key:
+                invariant_failures.append(f"seed {seed}, T={T}: key changed")
+            real_transform_checks += 1
+            ok, reason = verify(changed, carried)
+            if not ok:
+                invariant_failures.append(f"seed {seed}, T={T}: {reason}")
+    distinct_count = len(set(distinct_keys))
+    report["G8_canonical_key"] = {
+        "pass": (not invariant_failures and invariance_checks >= 20
+                 and real_transform_checks >= 20 and distinct_count == 20),
+        "invariance_checks": invariance_checks,
+        "real_transformation_checks": real_transform_checks,
+        "unrelated_distinct": distinct_count,
+        "unrelated_attempts": 20,
+        "failures": invariant_failures,
+        "invariant": (
+            "absolute determinant multisets, primitive contents, and boundary areas"
+        ),
+    }
+
+    compact_answer, compact_operations = _compact_route(ship)
+    compact_ok = compact_answer is not None and verify(ship, compact_answer)[0]
+    answer_blob = _answer_text(planted)
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _atom_count(planted)
+    arms = {name: dict(value) for name, value in G9_RESULTS.items()
+            if name in ("bare", "hinted", "placebo")}
+    hinted_attempts = arms["hinted"]["attempts"]
+    placebo_attempts = arms["placebo"]["attempts"]
+    hinted_rate = (arms["hinted"]["solved"] / hinted_attempts
+                   if hinted_attempts else 0.0)
+    placebo_rate = (arms["placebo"]["solved"] / placebo_attempts
+                    if placebo_attempts else 0.0)
+    within_caps = (answer_chars <= 2000 and answer_elements <= 256
+                   and compact_operations <= 300 and compact_ok)
+    report["G9_no_tool_suitability"] = {
