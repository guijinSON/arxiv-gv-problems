+def _sum_difference_certificate(
+        inst: dict, p: tuple[int, int], q: tuple[int, int]
+        ) -> dict[str, Any] | None:
+    """Try the obvious sum/difference ansatz on a proposed point pair."""
+    sum_direction = _primitive((p[0] + q[0], p[1] + q[1]))
+    difference_direction = _primitive((q[0] - p[0], q[1] - p[1]))
+    if sum_direction is None or difference_direction is None:
+        return None
+    for sign in (1, -1):
+        dx = sign * difference_direction[0]
+        dy = sign * difference_direction[1]
+        a_num = (sum_direction[0] - dx, sum_direction[1] - dy)
+        b_num = (sum_direction[0] + dx, sum_direction[1] + dy)
+        if any(value % 2 for value in (*a_num, *b_num)):
+            continue
+        candidate = _certificate_for_generators(
+            inst,
+            (a_num[0] // 2, a_num[1] // 2),
+            (b_num[0] // 2, b_num[1] // 2),
+        )
+        if candidate is not None:
+            return candidate
+    return None
+
