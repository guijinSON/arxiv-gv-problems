+        "pointed rational cone in a rank-two integer lattice",
+        "integer points in the cone",
+        "two integer semigroup generators and a lattice split",
+    ],
+    "verification_operations": [
+        "exact integer determinant",
+        "gcd primitive-vector normalization",
+        "exact divisibility and sign comparison",
+        "exact two-by-two coordinate solve",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "The displayed lattice points are centrally paired; their common sum "
+        "and primitive difference directions reveal the two generators, while "
+        "a solver missing that symmetry faces the paper's bounded triangle search."
