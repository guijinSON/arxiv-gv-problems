+    "object_regime": "integer_lattice",
+    "computational_core": "linear_algebra",
+    "certificate_form": "matrix_certificate",
+    "native_objects": [
+        "pointed rational cone in a rank-two integer lattice",
+        "integer points in the cone",
+        "two integer semigroup generators and a lattice split",
+    ],
+    "verification_operations": [
+        "exact integer determinant",
+        "gcd primitive-vector normalization",
+        "exact divisibility and sign comparison",
+        "exact two-by-two coordinate solve",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "The displayed lattice points are centrally paired; their common sum "
+        "and primitive difference directions reveal the two generators, while "
+        "a solver missing that symmetry faces the paper's bounded triangle search."
+    ),
+    "hardness_basis": (
+        "Track B: Section 3, Algorithm 1 enumerates lattice splits in a bounded "
+        "triangle, with cost polynomial in ||u|| (pseudo-polynomial in the input "
+        "bitlength); across eight shipping instances the measured reference scan "
+        "examined 6.89 million splits and 140.3 million counted exact operations "
+        "in 6.35 seconds on average, whereas central pairing took at most 165 "
+        "exact operations in the measured shipping tests."
+    ),
+    "max_answer_tokens": 17,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON object with one nonzero integer split q in the paper's bounded "
+        "triangle Delta, excluding q=u, and the ordered 2-by-2 integer matrix "
+        "whose rows are the primitive ray generators of q and u-q."
+    ),
+    "bounds": {
