/bin/bash -lc "PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'
import importlib.util, json
p='rejected_gen_2602_05957.py'
s=importlib.util.spec_from_file_location('candidate',p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
for preset, params in m.DIFFICULTY.items():
    for seed in range(4):
        inst=m.make_instance(seed=seed,**params)
        assert m.verify(inst,inst['answer'])==(True,'ok')
        assert json.loads(json.dumps(inst['answer']))==inst['answer']
report=json.load(open('selftest_report.json'))
assert report['all_passed'] and all(v.get('pass') for k,v in report.items() if k.startswith('G'))
rows=[json.loads(x) for x in open('llm_loop_transcript.jsonl') if x.strip()]
valid=[r for r in rows if r['solved']"'!='"'error']
solved=[r for r in valid if r['solved']=='solved']
print('module presets/seeds:',16,'verified')
