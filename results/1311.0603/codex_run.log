import random,statistics,time

def classes(n,q,P,seed):
 r=random.Random(seed); per=n//q; rem=n%q; want=[i for i in range(q) for _ in range(per+(i<rem))];r.shuffle(want);used=set();xs=[];cs=[]
 for c in want:
  opts=[x for x in range(10,P) if x not in used and ((x*x)%P)*q//P==c]
  x=r.choice(opts);used.add(x);xs.append(x);cs.append(c)
 order=list(range(n));r.shuffle(order)
 return [xs[i] for i in order],[cs[i] for i in order]

def graph(n,q,P,seed,p):
 r=random.Random(seed+999);xs,c=classes(n,q,P,seed);E=[];ad=[set() for _ in range(n)]
 for i in range(n):
  for j in range(i+1,n):
   if c[i]"'!=c[j] and r.random()<p:E.append((i,j));ad[i].add(j);ad[j].add(i)
 return xs,c,E,ad

def greedy(ad,q,order):
 a=[None]*len(ad)
 for v in order:
  seen={a[w] for w in ad[v] if a[w] is not None}
  for c in range(q):
   if c not in seen:a[v]=c;break
  if a[v] is None:return None
 return a

def dsatur(ad,q,budget=10**8):
 n=len(ad);a=[-1]*n;neigh=[set() for _ in range(n)];deg=[len(x)for x in ad];ops=nodes=0
 def dfs(left):
  nonlocal ops,nodes
  nodes+=1
  if not left:return a[:]
  v=max(left,key=lambda z:(len(neigh[z]),deg[z],-z));used=neigh[v]
  for c in range(q):
   ops+=1
   if c in used:continue
   a[v]=c;changed=[];ok=True
   for w in ad[v]:
    ops+=1
    if a[w]==c:ok=False;break
    if a[w]<0 and c not in neigh[w]:neigh[w].add(c);changed.append(w)
   if ok:
    left.remove(v);z=dfs(left)
    if z is not None:return z
    left.add(v)
   for w in changed:neigh[w].remove(c)
   a[v]=-1
  return None
 t=time.perf_counter();z=dfs(set(range(n)));return z,nodes,ops,time.perf_counter()-t

