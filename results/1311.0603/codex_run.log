import importlib.util, math, random, time
s=importlib.util.spec_from_file_location('g','gen_1311_0603.py'); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)

def jacobi(a, eps=1e-10, sweeps=200):
 n=len(a); v=[[float(i==j) for j in range(n)] for i in range(n)]
 for sw in range(sweeps*n*n):
  p=q=0; big=0.0
  for i in range(n):
   for j in range(i+1,n):
    z=abs(a[i][j])
    if z>big: big=z;p=i;q=j
  if big<eps: break
  app,aqq,apq=a[p][p],a[q][q],a[p][q]
  phi=0.5*math.atan2(2*apq,aqq-app); c=math.cos(phi); ss=math.sin(phi)
  for k in range(n):
   if k"'!=p and k!=q:
    akp,akq=a[k][p],a[k][q]
    a[k][p]=a[p][k]=c*akp-ss*akq
    a[k][q]=a[q][k]=ss*akp+c*akq
  a[p][p]=c*c*app-2*ss*c*apq+ss*ss*aqq
  a[q][q]=ss*ss*app+2*ss*c*apq+c*c*aqq
  a[p][q]=a[q][p]=0.0
  for k in range(n):
   vkp,vkq=v[k][p],v[k][q]
   v[k][p]=c*vkp-ss*vkq; v[k][q]=ss*vkp+c*vkq
 return [a[i][i] for i in range(n)],v

def kmeans(x,q,rng,tries=20):
 n=len(x);d=len(x[0]); best=None
 for tr in range(tries):
  centers=[x[rng.randrange(n)][:]]
  while len(centers)<q:
   ds=[min(sum((row[k]-c[k])**2 for k in range(d)) for c in centers) for row in x]
   # probabilistic kmeans++
   total=sum(ds); z=rng.random()*total; acc=0
   pick=n-1
   for i,a in enumerate(ds):
    acc+=a
    if acc>=z:pick=i;break
   centers.append(x[pick][:])
  lab=[0]*n
  for it in range(100):
   nl=[min(range(q),key=lambda j:sum((row[k]-centers[j][k])**2 for k in range(d))) for row in x]
   if nl==lab and it:break
   lab=nl
   for j in range(q):
    inds=[i for i in range(n) if lab[i]==j]
    if inds: centers[j]=[sum(x[i][k] for i in inds)/len(inds) for k in range(d)]
  score=sum(sum((x[i][k]-centers[lab[i]][k])**2 for k in range(d)) for i in range(n))
  if best is None or score<best[0]:best=(score,lab)
 return best[1]

def attack(inst,variant):
 n=inst['"'n'];q=inst['colors']; A=[[0.0]*n for _ in range(n)]; m=len(inst['edges']); p=2*m/(n*(n-1))
 for e in inst['edges']: A[e['u']][e['v']]=A[e['v']][e['u']]=1.0
 if variant=='center':
  for i in range(n):
   for j in range(n):
    if i"'!=j:A[i][j]-=p
 if variant=='"'lap':
  for i in range(n):
   A[i][i]=-sum(A[i]) # negative Laplacian, top/smallest?
 vals,V=jacobi(A)
 idx=sorted(range(n),key=lambda j:vals[j])[:q-1]
 X=[[V[i][j] for j in idx] for i in range(n)]
 labs=kmeans(X,q,random.Random(12345),50)
 ans=g._candidate_from_colors(inst,labs)
 return g.verify(inst,ans)[0], vals, labs
for variant in ['adj','center']:
 hits=0;t=time.perf_counter()
 for seed in range(9000,9008):
  ins=g.make_instance(seed=seed,**g.DIFFICULTY['hard'])
  ok,vals,labs=attack(ins,variant);hits+=ok
  # true agreement best permutation omitted
  print(variant,seed,ok, [round(vals[j],2) for j in sorted(range(len(vals)),key=lambda j:vals[j])[:8]])
 print('RESULT',variant,hits,'time',time.perf_counter()-t)
