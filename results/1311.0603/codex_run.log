def _canonical_payload(inst, reflected):
    all_labels = [label for vertex in inst["vertices"] for label in vertex["labels"]]
    low, high = min(all_labels), max(all_labels)

    def normal(label):
        return high - label if reflected else label - low

    records = sorted(
        (vertex["key"], tuple(sorted(normal(x) for x in vertex["labels"])))
        for vertex in inst["vertices"]
    )
    keys = [vertex["key"] for vertex in inst["vertices"]]
    edges = sorted(
        (min(keys[edge["u"]], keys[edge["v"]]),
         max(keys[edge["u"]], keys[edge["v"]]),
         tuple(sorted(edge["forbidden"])))
        for edge in inst["edges"]
    )
    return {
        "colors": inst["colors"],
        "prime": inst["key_prime"],
        "vertices": records,
        "edges": edges,
    }


def canonical_key(inst):
    """Invariant under vertex order, list order, edge order, shift and reflection."""
