+"""Verified generalized list T-coloring problem generator.
+
+The native instance is exactly the triple (G, Lambda, t) from arXiv:1311.0603:
+each vertex has a finite list of natural-number labels and each edge has a set
+of forbidden absolute differences containing zero.  A proper labeling is
+planted before the edges are sampled, so generation never solves its output.
+
+Every local list is a short consecutive block.  Edge differences make equal
+positions in two local lists conflict, giving a mechanically solvable coloring
+CSP.  The compact route is less mechanical: public vertex keys fall into
+quadratic-residue buckets that are independent sets of G.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import sys
+import time
+
+
