codex
The bare oracle loop is valid and hardened at the named medium rung: easy was solved 3/3, while medium failed 0/3 across Google and OpenAI with usable responses. Before adopting medium as the shipping preset, I’m re-running the full adversary panel there; the shipping rung must still satisfy every local gate, and the exact reference cost must be reported at that same size.
exec
/bin/bash -lc "python3 - <<'PY'
import importlib.util, statistics, time
s=importlib.util.spec_from_file_location('g','gen_1311_0603.py'); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
p=g.DIFFICULTY['medium']; succ={k:0 for k in ['degree','raw','greedy','random','affine','spectral']}; rows=[]
for seed in range(9000,9008):
 i=g.make_instance(seed=seed,**p)
 cs={'degree':g._attack_degree_residue(i),'raw':g._attack_raw_magnitude_buckets(i),
     'greedy':g._attack_greedy(i),'random':g._attack_random_restart(i,700000+seed),
     'affine':g._attack_affine_key(i),'spectral':g._attack_spectral(i,810000+seed)}
 for k,a in cs.items(): succ[k]+=int(a is not None and g.verify(i,a)[0])
 a,c=g._dsatur_reference(i); rows.append(c)
print('attacks',succ)
print('reference median',int(statistics.median(x['nodes'] for x in rows)),int(statistics.median(x['operations'] for x in rows)),statistics.median(x['wall_clock_sec'] for x in rows))
print('max',max(x['nodes'] for x in rows),max(x['operations'] for x in rows))
