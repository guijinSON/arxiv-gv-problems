+        columns = _orthonormalize(multiplied)
+        if columns is None:
+            return None
+
+    rows = [[columns[j][i] for j in range(q - 1)] for i in range(n)]
+    colors = _kmeans_rows(rows, q, rng)
+    return _candidate_from_colors(inst, colors)
