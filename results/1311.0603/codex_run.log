+    for u, v in sorted(edge_pairs):
+        block_u = (vertices[u]["labels"][0] - 1) // stride
+        block_v = (vertices[v]["labels"][0] - 1) // stride
+        difference = abs(block_u - block_v) * stride
+        edges.append({"u": u, "v": v, "forbidden": [0, difference]})
