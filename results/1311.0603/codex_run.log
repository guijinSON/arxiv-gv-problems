 r.shuffle(pairs); xs=[x for x,c in pairs];cs=[c for x,c in pairs];ad=[set()for _ in range(n)]
 for i in range(n):
  for j in range(i+1,n):
   if cs[i]"'!=cs[j] and r.random()<p:ad[i].add(j);ad[j].add(i)
 # random cross-color spanning path
 by=[[]for _ in range(q)]
 for i,c in enumerate(cs):by[c].append(i)
 for z in by:r.shuffle(z)
 order=[]
 for k in range(max(map(len,by))):
  cols=list(range(q));r.shuffle(cols)
  for c in cols:
   if k<len(by[c]):order.append(by[c][k])
 for a,b in zip(order,order[1:]):
  assert cs[a]!=cs[b]
  ad[a].add(b);ad[b].add(a)
 return xs,cs,ad

