"""Exact planted sign-CP decomposition instances for order-three tensors.

This module specializes the tensor rank-decomposition fiber from
Vannieuwenhoven, "A condition number for the tensor rank decomposition"
(arXiv:1604.00052) to a finite, exactly checkable witness space.  It uses only
the Python standard library and performs no I/O at import time.
"""

from __future__ import annotations

import hashlib
import itertools
import json
import math
import random
import re


# The first rung is intentionally already beyond the n^(3/2) random-component
# algorithmic scale.  harden.py owns any decision to move to the second rung.
DIFFICULTY = {
    "hard": {"n": 14, "rank": 60},
    "extreme": {"n": 18, "rank": 96},
}

SHIPPING_DIFFICULTY = "hard"

NOTES = r"""
Definition.  Section 1, equation (1), defines an r-term CP decomposition as a
sum of outer products and defines the fiber f^dagger(A) as all factor vectors
that reconstruct A.  It also makes the important distinction between an
r-term decomposition and a rank-r (minimal-length) decomposition.  This
generator asks only for an r-term witness, so verification never asserts
minimality or optimality.  Section 3 identifies term permutation and within-
term scaling as the trivial ambiguities.  Restricting every factor entry to
{-1,+1}, fixing the first entries of the first two factors to +1, forbidding
duplicate terms, and ignoring term order gives a finite normalized slice of
that exact fiber.

Regime and easy cases.  Sections 2--3 use the strictly subgeneric inequality
r(3n-2) < n^3 for cubic order-three tensors.  Every preset satisfies it, but
also has r > n and r > n^(3/2), with r growing quadratically in n.  Thus the
generalized-eigenvalue/direct regime used in Section 7 (where rank is no larger
than every multilinear rank) is excluded.  Section 6 gives closed condition-
number formulas for rank-1 and weakly 3-orthogonal tensors; the construction
instead uses many independent dense sign terms of equal weight.  The paper is
a conditioning paper, not a complexity paper: it proves no average-case
hardness theorem for these planted instances.  The hardness claim is therefore
the narrower, honest claim that no polynomial-time exact recovery method is
known in this highly overcomplete random regime; it is supported empirically by
the required attack panel and oracle loop, not proved by the paper.

Planting and attacks.  Each normalized rank-one sign atom is sampled uniformly
without replacement, and all atoms have the same distribution and coefficient;
there is no decoy distribution or magnitude marker.  The marginal outlier
attack rounds one-coordinate contractions.  Greedy deflation repeatedly runs
alternating sign maximization on the residual.  Random restart runs 256 such
maximizations on the original tensor.  The domain-standard attack is CP-ALS:
it performs alternating regularized least-squares updates over real factors,
then rounds and normalizes them into the required sign witness.  The shipping
level is accepted only if every attack fails on every panel seed.  These tests
do not constitute an average-case hardness proof.

Canonicalization.  Independent signed coordinate permutations in the three
modes and permutations of the three equally-sized modes preserve the family.
The key hashes exact invariants: absolute entry/slice/fiber profiles and the
absolute 2x2 minors of every matrix slice.  This is a strong cheap invariant,
not a complete canonical form for signed three-way array isomorphism; collisions
can over-collapse unrelated instances but cannot turn relabellings into fake
diversity.  selftest checks all stated symmetries and carried witnesses.
""".strip()


_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
_ENUMERATION_CAP = 600_000


def _rank_limit(n: int) -> int:
    """Largest integer r satisfying the paper's strict subgeneric inequality."""
    return (n ** 3 - 1) // (3 * n - 2)


def _rank_for_fraction(n: int, fraction: float = 0.88) -> int:
    return max(2, min(_rank_limit(n), int(math.floor(fraction * n ** 3 / (3 * n - 2)))))


def _validate_params(n: int, rank: int) -> None:
    if isinstance(n, bool) or not isinstance(n, int) or n < 3:
        raise ValueError("n must be an integer at least 3")
    if isinstance(rank, bool) or not isinstance(rank, int) or rank < 2:
        raise ValueError("rank must be an integer at least 2")
    if rank > _rank_limit(n):
        raise ValueError("rank must satisfy the strict subgeneric inequality rank*(3*n-2) < n^3")
    if rank >= (1 << (3 * n - 2)):
        raise ValueError("rank exceeds the number of distinct normalized sign atoms")


def _decode_term(code: int, n: int) -> list[list[int]]:
    width = 3 * n - 2
    bits = [1 if (code >> (width - 1 - i)) & 1 else -1 for i in range(width)]
    return [[1] + bits[: n - 1],
            [1] + bits[n - 1 : 2 * n - 2],
            bits[2 * n - 2 :]]


def _encode_term(term: list[list[int]], n: int) -> int:
    values = term[0][1:] + term[1][1:] + term[2]
    code = 0
    for value in values:
        code = (code << 1) | int(value == 1)
    return code


def _sign_at(code: int, n: int, mode: int, coordinate: int) -> int:
    """Read one factor sign directly from its compact normalized code."""
    if coordinate == 0 and mode < 2:
        return 1
    if mode == 0:
        position = coordinate - 1
    elif mode == 1:
        position = (n - 1) + coordinate - 1
    else:
        position = 2 * n - 2 + coordinate
    bit = 3 * n - 3 - position
    return 1 if (code >> bit) & 1 else -1


def _term_tuple(term) -> tuple[tuple[int, ...], tuple[int, ...], tuple[int, ...]]:
    return tuple(tuple(int(x) for x in vector) for vector in term)  # type: ignore[return-value]


def _normalise_term(term) -> list[list[int]]:
    """Choose the unique sign scaling with a[0] = b[0] = +1."""
    a, b, c = [list(map(int, vector)) for vector in term]
    if a[0] == -1:
        a = [-x for x in a]
        c = [-x for x in c]
    if b[0] == -1:
        b = [-x for x in b]
        c = [-x for x in c]
    return [a, b, c]


def _sorted_terms(terms) -> list[list[list[int]]]:
    return [[list(v) for v in term] for term in sorted(_term_tuple(t) for t in terms)]


def _build_tensor(n: int, terms) -> list[list[list[int]]]:
    tensor = [[[0 for _ in range(n)] for _ in range(n)] for _ in range(n)]
    for term in terms:
        a, b, c = term
        for i, ai in enumerate(a):
            plane = tensor[i]
            for j, bj in enumerate(b):
                row = plane[j]
                scale = ai * bj
                for k, ck in enumerate(c):
                    row[k] += scale * ck
    return tensor


def make_instance(n, seed=0, **params) -> dict:
    """Sample normalized sign factors first, then sum their outer products.

    ``n`` is the common length of all three factor vectors.  ``rank`` is the
    exact number of distinct terms required in the witness; if omitted, it is
    chosen near the strictly subgeneric boundary and grows quadratically in n.
    """
    rank = params.pop("rank", None)
    rank_fraction = params.pop("rank_fraction", 0.88)
    if params:
        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
    if rank is None:
        if isinstance(rank_fraction, bool) or not isinstance(rank_fraction, (int, float)):
            raise ValueError("rank_fraction must be a real number")
        if not 0.1 <= float(rank_fraction) < 1.0:
            raise ValueError("rank_fraction must lie in [0.1, 1.0)")
        rank = _rank_for_fraction(n, float(rank_fraction))
    _validate_params(n, rank)
    if isinstance(seed, bool) or not isinstance(seed, int):
        raise ValueError("seed must be an integer")

    rng = random.Random(seed)
    width = 3 * n - 2
    codes: set[int] = set()
    while len(codes) < rank:
        codes.add(rng.getrandbits(width))
    answer = sorted(codes)
    tensor = _build_tensor(n, (_decode_term(code, n) for code in answer))
    return {
        "family": "bounded_sign_cp_decomposition",
        "order": 3,
        "dimension": n,
        "term_count": rank,
        "field": "ordinary_integers",
        "tensor": tensor,
        "answer": answer,
    }


def render(inst) -> str:
    """Render the complete finite exact-decomposition search problem."""
    n = int(inst["dimension"])
    rank = int(inst["term_count"])
    tensor_text = json.dumps(inst["tensor"], separators=(",", ":"))
    return (
        "Find an exact bounded sign CP decomposition of the order-3 tensor below.\n\n"
        "Definitions and conventions:\n"
        f"- The tensor T has shape {n} x {n} x {n}. All indices are 0-based and "
        f"range from 0 through {n - 1}, inclusive.\n"
        "- A rank-one sign term is an ordered triple [a,b,c] of integer vectors. "
        f"Each vector has exactly {n} entries, and every entry is either -1 or +1.\n"
        "- Its entry at coordinate (i,j,k) is a[i]*b[j]*c[k]. Arithmetic is over "
        "the ordinary integers, not modulo any number.\n"
        f"- Return exactly {rank} pairwise-distinct rank-one sign terms whose "
        "entrywise sum equals T at every coordinate. Repeated terms are forbidden.\n"
        "- To remove sign-scaling ambiguity, every term is normalized by "
        "a[0]=+1 and b[0]=+1. This loses no sign term: flipping a and c together, "
        "or b and c together, preserves the outer product.\n"
        f"- Encode a normalized term by a nonnegative integer from 0 through "
        f"{(1 << (3 * n - 2)) - 1}, inclusive. Write it in binary using exactly "
        f"{3 * n - 2} bits (pad on the left with zeros). From left to right, the "
        f"bits encode a[1]..a[{n - 1}], then b[1]..b[{n - 1}], then "
        f"c[0]..c[{n - 1}]. Bit 1 means sign +1 and bit 0 means sign -1; "
        "a[0] and b[0] are the two implicit +1 signs.\n"
        "- Return the term codes as a JSON array of integers. Their order does not "
        "matter; the checker accepts any order.\n"
        "- The tensor is encoded as nested JSON: T[i][j][k] is the integer at "
        "coordinate (i,j,k).\n\n"
        f"dimension: {n}\n"
        f"required_term_count: {rank}\n"
        f"tensor: {tensor_text}\n\n"
        "Give your final answer inside <answer></answer> tags, as one JSON array "
        f"containing exactly {rank} distinct integer term codes.\n"
        "Toy syntax example for three term codes only: <answer>[5,19,42]</answer>\n"
        "Output nothing else inside the tags."
    )


def parse_answer(text) -> object | None:
    """Extract exactly one JSON witness block; return None on malformed output."""
    if not isinstance(text, str):
        return None
    matches = _ANSWER_RE.findall(text)
    if len(matches) != 1:
        return None
    try:
        return json.loads(matches[0])
    except (json.JSONDecodeError, TypeError, ValueError):
        return None


def _shape_check(inst: dict, answer) -> tuple[bool, str]:
    n = int(inst["dimension"])
    rank = int(inst["term_count"])
    if not isinstance(answer, list):
        return False, "answer must be a JSON array of rank-one terms"
    if not answer:
        return False, "answer is empty"
    if len(answer) != rank:
        return False, f"wrong term count: expected {rank}, received {len(answer)}"
    upper = 1 << (3 * n - 2)
    for term_index, code in enumerate(answer):
        if isinstance(code, bool) or not isinstance(code, int):
            return False, f"term code {term_index} must be an integer"
        if not 0 <= code < upper:
            return False, (f"term code {term_index} is outside the inclusive range "
                           f"0..{upper - 1}")
    if len(set(answer)) != len(answer):
        return False, "rank-one term codes must be distinct; a duplicate was found"
    return True, "ok"


def verify(inst, answer) -> tuple[bool, str]:
    """Check any normalized bounded sign decomposition; never read inst['answer']."""
    ok, reason = _shape_check(inst, answer)
    if not ok:
        return False, reason
    n = int(inst["dimension"])
    target = inst["tensor"]
    # Coordinate-by-coordinate comparison rejects random guesses quickly while
    # remaining a complete exact substitution check.
    for i in range(n):
        for j in range(n):
            for k in range(n):
                value = sum(_sign_at(code, n, 0, i)
                            * _sign_at(code, n, 1, j)
                            * _sign_at(code, n, 2, k) for code in answer)
                if value != target[i][j][k]:
                    return False, (f"reconstruction mismatch at coordinate ({i},{j},{k}): "
                                   f"candidate gives {value}, tensor has {target[i][j][k]}")
    return True, "ok"


def _sample_codes(width: int, count: int, rng) -> list[int]:
    if not hasattr(rng, "getrandbits"):
        raise TypeError("rng must provide getrandbits()")
    codes: set[int] = set()
    while len(codes) < count:
        codes.add(rng.getrandbits(width))
    return list(codes)


def random_candidate(inst, rng) -> object:
    """Uniform r-subset of normalized sign atoms, with all obvious rules built in."""
    n = int(inst["dimension"])
    rank = int(inst["term_count"])
    codes = _sample_codes(3 * n - 2, rank, rng)
    return sorted(codes)


def search_space(inst) -> int | None:
    """Exact statement-aware space: r-subsets of normalized sign atoms."""
    try:
        n = int(inst["dimension"])
        rank = int(inst["term_count"])
        return math.comb(1 << (3 * n - 2), rank)
    except (KeyError, TypeError, ValueError, OverflowError):
        return None


