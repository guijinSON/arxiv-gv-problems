 ('n72q6p28',dict(n=72,colors=6,prime_floor=127,edge_rate_num=7,edge_rate_den=25)),
 ('n74q6p28',dict(n=74,colors=6,prime_floor=127,edge_rate_num=7,edge_rate_den=25)),
 ('n72q6p32',dict(n=72,colors=6,prime_floor=127,edge_rate_num=8,edge_rate_den=25)),
