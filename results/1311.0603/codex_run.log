+                        (row[k] - centers[j][k]) ** 2
+                        for k in range(dimension)
+                    ),
+                )
+                for row in rows
+            ]
+            if new_labels == labels:
+                break
+            labels = new_labels
+            for cluster in range(clusters):
+                members = [i for i, value in enumerate(labels) if value == cluster]
+                if members:
+                    centers[cluster] = [
+                        sum(rows[i][k] for i in members) / len(members)
+                        for k in range(dimension)
+                    ]
+
