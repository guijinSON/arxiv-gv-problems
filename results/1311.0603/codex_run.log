def ortho(cols):
 out=[]
 for c in cols:
  v=c[:]
  for u in out:
   z=sum(x*y for x,y in zip(v,u))
   for i in range(len(v)):v[i]-=z*u[i]
  z=math.sqrt(sum(x*x for x in v))
  if z<1e-12:
   return None
  out.append([x/z for x in v])
 return out

def km(rows,q,rng,tries=12):
 n=len(rows);d=len(rows[0]);best=None
 for tr in range(tries):
  centers=[rows[rng.randrange(n)][:]]
  while len(centers)<q:
   ds=[min(sum((x[k]-c[k])**2 for k in range(d)) for c in centers) for x in rows]
   pick=max(range(n),key=lambda i:(ds[i],-i))
   centers.append(rows[pick][:])
  lab=None
  for it in range(50):
   nl=[min(range(q),key=lambda j:sum((x[k]-centers[j][k])**2 for k in range(d))) for x in rows]
   if nl==lab:break
   lab=nl
   for j in range(q):
    ids=[i for i,z in enumerate(lab) if z==j]
    if ids: centers[j]=[sum(rows[i][k] for i in ids)/len(ids) for k in range(d)]
  sc=sum(sum((rows[i][k]-centers[lab[i]][k])**2 for k in range(d)) for i in range(n))
  if best is None or sc<best[0]:best=(sc,lab)
 return best[1]

