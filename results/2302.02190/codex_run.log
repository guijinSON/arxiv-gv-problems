-        ref_l, ref_f, ref_a = _dihedral_data(
-            reordered["lists"], reordered["fixed"], reordered["answer"],
-            shift, -1
-        )
-        reflected = {"n": inst["n"], "q": inst["q"], "fixed": ref_f,
-                     "lists": ref_l, "answer": ref_a}
-        for transformed in (reordered, rotated, reflected):
