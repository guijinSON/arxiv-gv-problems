-        "structure_aware": True,
-        "sampling_wall_clock_sec": round(guess_seconds, 6),
-    }
-
-    attack_names = (
-        "outlier_endpoint_values",
-        "greedy_smallest_no_backtracking",
-        "random_restart_256",
