+        for i in range(inst["n"]):
+            for j in range(inst["n"]):
+                if i != j and base[i] != base[j] and base[i] in inst["lists"][j]:
+                    candidate = list(base)
+                    candidate[j] = base[i]
+                    candidates.append(candidate)
