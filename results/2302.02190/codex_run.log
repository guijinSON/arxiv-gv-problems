-    }
-
-    invariant_count = 0
-    carried_count = 0
-    unrelated = []
-    for seed in range(201, 221):
-        inst = make_instance(seed=seed, **shipping_params)
-        key = canonical_key(inst)
-        rng = random.Random(seed ^ 0xD1EED)
-        reordered = {
