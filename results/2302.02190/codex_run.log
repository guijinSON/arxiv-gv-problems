-                f"neighbour-sum collision on spoke edge u_{i}--v_{i}: "
-                f"both sums are {sum_u[i]}"
-            )
-        if sum_u[i] == sum_v[j]:
-            return (
-                f"neighbour-sum collision on spoke edge u_{i}--v_{j}: "
-                f"both sums are {sum_u[i]}"
