+
+def _neighbour_sums(fixed, variable):
+    n = len(variable)
+    sum_u = [variable[i] + variable[(i + 1) % n] for i in range(n)]
+    sum_v = [
+        variable[(i - 1) % n] + variable[(i + 1) % n]
