-                                 and verify(inst, compact)[0])
-
-    attacks = {
-        name: {
-            "successes": successes[name],
-            "attempts": 8,
-            "wall_clock_sec": round(elapsed[name], 6),
-        }
-        for name in attack_names
-    }
-    reference = {
