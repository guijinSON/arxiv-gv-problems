-
-    attack_names = (
-        "outlier_endpoint_values",
-        "greedy_smallest_no_backtracking",
-        "random_restart_256",
-        "by_hand_constant_missing_offset",
-    )
-    successes = {name: 0 for name in attack_names}
-    elapsed = {name: 0.0 for name in attack_names}
-    reference_successes = 0
