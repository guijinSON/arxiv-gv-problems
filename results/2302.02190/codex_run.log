-            stats["constraint_evaluations"] += 3
-            if verify(inst, path)[0]:
-                stats["exact_operations"] = 5 * stats["constraint_evaluations"]
-                return path, stats
-    stats["exact_operations"] = 5 * stats["constraint_evaluations"]
-    return None, stats
