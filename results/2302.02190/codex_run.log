+    r_positions = [i for i, value in enumerate(fixed) if 2 * q < value < 3 * q]
+    if len(a_positions) != 1 or len(r_positions) != 1:
+        return None
+    ai, ri = a_positions[0], r_positions[0]
+    initial = fixed[ai] - q
+    ratio = fixed[ri] - 2 * q
