-        answer = _sample_valid_variable_sequence(n, q, fixed, rng)
-        offset = initial
-        missing = []
-        for value in answer:
-            missing.append(_residue_to_label(value - offset, q))
-            offset = offset * ratio % q
-        lists = []
-        for omitted in missing:
-            row = [value for value in range(1, q + 1) if value != omitted]
-            rng.shuffle(row)
