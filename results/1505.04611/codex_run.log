+
+def _is_prime_small(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    limit = math.isqrt(value)
+    for divisor in range(3, limit + 1, 2):
+        if value % divisor == 0:
+            return False
+    return True
