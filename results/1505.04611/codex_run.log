+        "shipping_density_estimate": density,
+        "exact_valid_answer_count": 1,
+        "certificate_space": search_space(shipping),
+        "strongest_failing_attack_wall_sec": attack_elapsed,
+        "strongest_failing_attack_iterations": 256,
