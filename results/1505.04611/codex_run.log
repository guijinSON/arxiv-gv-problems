+STRUCTURAL_HINT = (
+    "Focus on the unique exponent representing -1, which is omitted from the "
+    "partition C0 union C1."
+)
+PLACEBO_HINT = (
+    "Focus on keeping the modular representatives and the row ordering consistent "
