$\{3,4,5,9\}$&$\{4,6,7,8\}$&$\{0,5,8,10\}$&$\{0,2,6,9\}$&$\{2,3,7,10\}$ \\
$\{4,8,9,10\}$&$\{0,3,6,10\}$&$\{0,2,4,7\}$&$\{2,3,5,8\}$&$\{5,6,7,9\}$
\end{tabular}\end{center}
\end{example}

