+)
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An n-by-2 indexed integer table [[i,s_i],...] in canonical row order; "
+        "each s_i is one of the two displayed adjacent levels and exactly n/2 "
