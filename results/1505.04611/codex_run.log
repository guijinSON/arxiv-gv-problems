+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+DIFFICULTY = {
+    "demo": {
+        "n": 4,
+        "modulus": 41,
+        "argument_bound": 40,
+        "max_jacobi_steps": 7,
+    },
+    "easy": {
+        "n": 28,
+        "modulus": 65537,
+        "argument_bound": 10000,
+        "max_jacobi_steps": 7,
+    },
+    "medium": {
+        "n": 30,
+        "modulus": 114689,
+        "argument_bound": 10000,
