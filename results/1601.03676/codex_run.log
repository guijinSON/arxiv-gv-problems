   673	def escalate(params) -> dict | str | None:
   674	    """Increase crowding at fixed witness length before touching other axes."""
   675	
   676	    p = {k: int(v) for k, v in params.items() if not k.startswith("_")}
   677	    n = p["n"]
   678	    degree = p.get("degree", 3)
   679	    if degree + 2 <= n - 5:
   680	        p["degree"] = degree + 2
   681	        return p
   682	    q = p.get("q", 8)
   683	    if q < MAX_Q:
   684	        p["q"] = q + 1
   685	        p["degree"] = min(degree, n - 5)
   686	        return p
   687	    if n < MAX_N:
   688	        p["n"] = min(MAX_N, n + 16)
   689	        p["degree"] = min(degree, p["n"] - 5)
   690	        return p
   691	    return "cap_bound"
