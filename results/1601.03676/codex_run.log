+    "description": (
+        "A JSON list of exactly n pairs [group, option], containing every group "
+        "0..n-1 exactly once and one option 0..q-1 for that group; pair order is "
+        "irrelevant.  The bounded language therefore contains q^n witnesses."
+    ),
