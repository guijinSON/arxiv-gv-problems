+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+}
+G9_HINTED_VERDICT = "pending: all harden arms hit OpenRouter HTTP 403 key total limit"
+
+
+PROBLEM_PROFILE: dict = {
