		     \STATE{Let $u_l$ be the $l$th element of $I^*$}
				
		     \STATE{$\mathbf{Q^l}=\{s^i_1,s^i_2,\dots,s^i_j \cup u_l, \dots, s^i_k\}$}\label{Line_BranchQL_alpha}
         
				 \STATE{\textsc{\textsc{CreateNode($T$,node $i$,node $l$,$\mathbf{Q^l}$)}}} 
         
         \STATE{$l=l+1$}
         
     \ENDWHILE  
  \end{algorithmic}\label{BranchRoutine}
\end{algorithm}

\begin{algorithm}
  \caption{\texttt{Compute} $\mathcal{S}(s^i_j,\mathbf{Q^i},\alpha$)}
  \begin{algorithmic}[1]
		\STATE{$l=0$, $\mathcal{S}(s^i_j,\mathbf{Q^i},\alpha) = \emptyset$}
			      \WHILE{$l < |\mathcal{S}(s^i_j)|$}
						     \STATE{Let $S_l$ be the $l$-th set in $\mathcal{S}(s^i_j)$}
