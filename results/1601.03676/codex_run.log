  option 0: {11,17,24,29,36,37}
  option 1: {5,7,11,17,28,35}
  option 2: {1,11,13,16,17,26}
Group 1:
  option 0: {4,11,30,32,33,39}
  option 1: {11,15,19,22,25,30}
