   570	def enumerate_all(inst) -> int | None:
   571	    space = search_space(inst)
   572	    if space is None or space > 200_000:
   573	        return None
   574	    total = 0
   575	    for options in itertools.product(range(inst["q"]), repeat=inst["n"]):
   576	        candidate = [[i, options[i]] for i in range(inst["n"])]
   577	        if verify(inst, candidate)[0]:
   578	            total += 1
   579	    return total
