def _candidate_set(inst: dict, group: int, option: int) -> frozenset[int]:
    return frozenset(inst["groups"][group][option])


def _alpha_conflict(inst: dict, left: frozenset[int], right: frozenset[int]) -> bool:
    zero = inst["zero_weight_element"]
    threshold = inst["overlap_threshold"]
    shared_weight = sum(1 for x in left.intersection(right) if x != zero)
    return shared_weight > threshold


def _normalize_answer(inst: dict, answer) -> tuple[dict[int, int] | None, str]:
    n = inst["n"]
    q = inst["q"]
    if not isinstance(answer, list):
        return None, "answer must be a JSON list"
    if not answer:
        return None, "answer is empty"
    for pos, pair in enumerate(answer):
        if (
            not isinstance(pair, list)
            or len(pair) != 2
            or isinstance(pair[0], bool)
            or isinstance(pair[1], bool)
            or not isinstance(pair[0], int)
    n = inst["n"]
    # Materialize only the selected sets that verification actually reaches.
    # A random candidate almost always alpha-conflicts on an early constraint
    # edge; eagerly rebuilding all n frozensets made the mandated 200,000-sample
    # density audit spend most of its time on unused allocations.
    selected: dict[int, frozenset[int]] = {}

    def chosen_set(i: int) -> frozenset[int]:
        if i not in selected:
            selected[i] = _candidate_set(inst, i, chosen[i])
        return selected[i]
    priority = {tuple(sorted(map(int, e))) for e in inst["constraint_edges"]}
    pairs = sorted(priority)
    pairs.extend(
        (i, j)
        for i in range(n)
        for j in range(i + 1, n)
        if (i, j) not in priority
    )
    for i, j in pairs:
        if _alpha_conflict(inst, chosen_set(i), chosen_set(j)):
            return False, (
                f"selected sets for groups {i} and {j} alpha-conflict: "
                "their shared positive weight exceeds 0"
            )
    return True, "ok"


