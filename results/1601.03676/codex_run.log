   538	def parse_answer(text) -> object | None:
   539	    """Parse the delimited JSON witness, tolerating prose and Markdown fences."""
   540	
   541	    if not isinstance(text, str):
   542	        return None
   543	    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
   544	    bodies = matches[-1:] if matches else [text]
   545	    decoder = json.JSONDecoder()
   546	    for body in bodies:
   547	        cleaned = re.sub(r"```(?:json)?", "", body, flags=re.I).replace("```", "")
   548	        for start, ch in enumerate(cleaned):
   549	            if ch != "[":
   550	                continue
   551	            try:
   552	                value, _ = decoder.raw_decode(cleaned[start:])
   553	            except (ValueError, TypeError):
   554	                continue
   555	            if isinstance(value, list):
   556	                return value
   557	    return None
