   876	def _attack_greedy_left_to_right(inst: dict) -> list[list[int]]:
   877	    selected: dict[int, int] = {}
   878	    selected_sets: dict[int, frozenset[int]] = {}
   879	    for i in range(inst["n"]):
   880	        choice = None
   881	        for a in range(inst["q"]):
   882	            candidate = _candidate_set(inst, i, a)
   883	            if all(
   884	                not _alpha_conflict(inst, candidate, selected_sets[j])
   885	                for j in selected_sets
   886	            ):
   887	                choice = a
   888	                break
   889	        if choice is None:
   890	            choice = 0
   891	        selected[i] = choice
   892	        selected_sets[i] = _candidate_set(inst, i, choice)
   893	    return [[i, selected[i]] for i in range(inst["n"])]
   894	
