+def _validate_parameters(n: int, q: int, degree: int) -> None:
+    if n < 6 or n % 2:
+        raise ValueError("n must be an even integer at least 6")
+    if q < 3:
+        raise ValueError("q must be at least 3")
+    if not 2 <= degree < n:
+        raise ValueError("degree must lie in 2..n-1")
+    if (n * degree) % 2:
+        raise ValueError("n*degree must be even")
 
 
