   915	def _transform_instance(inst: dict, seed: int) -> dict:
   916	    """Compose universe, option, group and presentation relabellings."""
   917	
   918	    rng = random.Random(seed)
   919	    out = {
   920	        k: v
   921	        for k, v in inst.items()
   922	        if k not in {
   923	            "groups", "group_anchors", "group_anchor_weights",
   924	            "constraint_edges", "edge_matchings", "answer"
   925	        }
   926	    }
   927	    groups = [[list(s) for s in group] for group in inst["groups"]]
   928	    answer_map = {int(g): int(a) for g, a in inst["answer"]}
   929	
   930	    # Universe relabelling, including transport of the distinguished weight-zero
   931	    # element.  Also reorder each set's presentation.
   932	    elements = sorted({x for group in groups for s in group for x in s})
   933	    shuffled = elements[:]
   934	    rng.shuffle(shuffled)
   935	    element_map = dict(zip(elements, shuffled))
   936	    groups = [
   937	        [[element_map[x] for x in s] for s in group]
   938	        for group in groups
   939	    ]
   940	    for group in groups:
   941	        for s in group:
   942	            rng.shuffle(s)
   943	    out["zero_weight_element"] = element_map[inst["zero_weight_element"]]
   944	    anchors = [element_map[value] for value in inst["group_anchors"]]
   945	    anchor_weights = list(inst["group_anchor_weights"])
   946	
   947	    # Independent option permutations.
   948	    for i in range(inst["n"]):
   949	        order = list(range(inst["q"]))
   950	        rng.shuffle(order)
   951	        inverse = {old: new for new, old in enumerate(order)}
   952	        groups[i] = [groups[i][old] for old in order]
   953	        answer_map[i] = inverse[answer_map[i]]
   954	
   955	    # Group permutation.  order[new] = old.
   956	    order = list(range(inst["n"]))
   957	    rng.shuffle(order)
   958	    inverse_group = {old: new for new, old in enumerate(order)}
   959	    groups = [groups[old] for old in order]
   960	    anchors = [anchors[old] for old in order]
   961	    anchor_weights = [anchor_weights[old] for old in order]
   962	    edges = [
   963	        [inverse_group[int(i)], inverse_group[int(j)]]
   964	        for i, j in inst["constraint_edges"]
   965	    ]
   966	    rng.shuffle(edges)
   967	    for edge in edges:
   968	        if rng.randrange(2):
   969	            edge.reverse()
   970	    answer = [
   971	        [inverse_group[old], answer_map[old]]
   972	        for old in range(inst["n"])
   973	    ]
   974	    rng.shuffle(answer)
   975	
   976	    out["groups"] = groups
   977	    out["group_anchors"] = anchors
   978	    out["group_anchor_weights"] = anchor_weights
   979	    out["constraint_edges"] = edges
   980	    out["answer"] = answer
   981	    out["edge_matchings"] = _derive_edge_matchings(out)
   982	    return out
   983	
   984	
   985	def _answer_atoms(value) -> int:
   986	    if isinstance(value, dict):
   987	        return sum(_answer_atoms(v) for v in value.values())
   988	    if isinstance(value, (list, tuple)):
   989	        return sum(_answer_atoms(v) for v in value)
   990	    return 1
