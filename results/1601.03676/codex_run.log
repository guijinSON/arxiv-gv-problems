+        row["successes"] += int(verify(trial, candidate)[0])
+
+        started = time.perf_counter()
+        candidate, operations = _greedy_independent(trial)
+        row = attacks["minimum_conflict_greedy"]
+        row["wall_clock_sec"] += time.perf_counter() - started
+        row["attempts"] += 1
+        row["operations"] += operations
+        row["successes"] += int(verify(trial, candidate)[0])
+
+        started = time.perf_counter()
+        candidate, operations = _attack_random_restarts(
+            trial, random.Random(seed ^ 0xA11CE), 256
+        )
+        row = attacks["randomized_greedy_256_restarts"]
+        row["wall_clock_sec"] += time.perf_counter() - started
+        row["attempts"] += 1
+        row["operations"] += operations
+        row["successes"] += int(verify(trial, candidate)[0])
+
+        started = time.perf_counter()
+        candidate, operations = _attack_spectral(trial)
+        row = attacks["bottom_eigenvector_sweep"]
+        row["wall_clock_sec"] += time.perf_counter() - started
+        row["attempts"] += 1
