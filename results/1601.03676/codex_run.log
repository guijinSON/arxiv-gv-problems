   896	def _attack_local_plurality(inst: dict) -> list[list[int]]:
   897	    """Choose the option compatible with most option-zero neighboring sets."""
   898	
   899	    adj = _constraint_adjacency(inst)
   900	    answer = []
   900	    answer = []
   901	    for i in range(inst["n"]):
   902	        scores = []
   903	        for a in range(inst["q"]):
   904	            candidate = _candidate_set(inst, i, a)
   905	            score = sum(
   906	                not _alpha_conflict(inst, candidate, _candidate_set(inst, j, 0))
   907	                for j in adj[i]
   908	            )
   909	            scores.append(score)
   910	        best = max(range(inst["q"]), key=lambda a: (scores[a], -a))
   911	        answer.append([i, best])
   912	    return answer
