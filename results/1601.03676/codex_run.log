/bin/bash -lc "python3 - <<'PY'
import copy
import importlib.util
import itertools
import json

path = 'gen_1601_03676.py'
spec = importlib.util.spec_from_file_location('g', path)
g = importlib.util.module_from_spec(spec)
spec.loader.exec_module(g)
checks = 0
for preset, params in g.DIFFICULTY.items():
    for seed in range(40):
        a = g.make_instance(seed=seed, **params)
        b = g.make_instance(seed=seed, **params)
        assert a == b
        assert json.loads(json.dumps(a['answer'])) == a['answer']
        assert g._derive_edge_matchings(a) == a['edge_matchings']
        for sheet in range(a['q']):
            candidate = [[i, (sheet - (w % a['q'])) % a['q']]
                         for i, w in enumerate(a['group_anchor_weights'])]
            without_cache = copy.deepcopy(a)
            without_cache.pop('edge_matchings')
            without_cache['answer'] = []
            assert g.verify(without_cache, candidate) == (True, 'ok')
            checks += 1
        if preset == 'demo':
            assert g.enumerate_all(a) == a['q']
        magnitude_changed = copy.deepcopy(a)
        magnitude_changed['group_anchor_weights'] = [1] * a['n']
        assert g.canonical_key(magnitude_changed) == g.canonical_key(a)
print({'independent_checks': checks, 'presets': len(g.DIFFICULTY), 'seeds_each': 40})
