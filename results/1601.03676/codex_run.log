   582	def _constraint_adjacency(inst: dict) -> list[list[int]]:
   583	    n = inst["n"]
   584	    adj = [[] for _ in range(n)]
   585	    for raw in inst["constraint_edges"]:
   586	        i, j = map(int, raw)
   587	        if i == j or not (0 <= i < n and 0 <= j < n):
   588	            raise ValueError("malformed constraint edge")
   589	        adj[i].append(j)
   590	        adj[j].append(i)
   591	    for row in adj:
   592	        row.sort()
   593	    return adj
