   694	def _reference_algorithm(inst: dict) -> tuple[object | None, dict]:
   695	    """Index positive-element incidences, then propagate one component.
   696	
   697	    This is the strongest simple exact baseline for the displayed distribution:
   698	    scan every set once, use shared positive elements to mark forbidden option
   699	    pairs, inspect each local table, and propagate.  It does not read
   700	    ``inst['answer']`` or the redundant ``inst['edge_matchings']`` cache.
   701	    """
   702	
   703	    started = time.perf_counter()
   704	    n, q = inst["n"], inst["q"]
   705	    zero = inst["zero_weight_element"]
   706	    edge_keys = {
   707	        tuple(sorted((int(raw_i), int(raw_j))))
   708	        for raw_i, raw_j in inst["constraint_edges"]
   709	    }
   710	    allowed = {
   711	        edge: [[True] * q for _ in range(q)]
   712	        for edge in edge_keys
   713	    }
   714	    postings: dict[int, list[tuple[int, int]]] = {}
   715	    operations = 0
   716	    incidence_reads = 0
   717	    conflict_marks = 0
   718	    compatibility_cells = 0
   719	
   720	    for i, group in enumerate(inst["groups"]):
   721	        for a, candidate in enumerate(group):
   722	            for element in candidate:
   723	                incidence_reads += 1
   724	                operations += 1
   725	                if element != zero:
   726	                    postings.setdefault(element, []).append((i, a))
   727	
   728	    for occurrences in postings.values():
   729	        for left_pos in range(len(occurrences)):
   730	            left_group, left_option = occurrences[left_pos]
   731	            for right_group, right_option in occurrences[left_pos + 1:]:
   732	                operations += 1
   733	                if left_group == right_group:
   734	                    continue
   735	                i, a = left_group, left_option
   736	                j, b = right_group, right_option
   737	                if i > j:
   738	                    i, j, a, b = j, i, b, a
   739	                edge = (i, j)
   740	                if edge not in allowed:
   741	                    return None, {
   742	                        "operations": operations,
   743	                        "incidence_reads": incidence_reads,
   744	                        "conflict_marks": conflict_marks,
   745	                        "compatibility_cells": compatibility_cells,
   746	                        "nodes": 0,
   747	                        "wall_clock_sec": time.perf_counter() - started,
   748	                        "reason": "positive overlap appeared on an unlisted group pair",
   749	                    }
   750	                if allowed[edge][a][b]:
   751	                    allowed[edge][a][b] = False
   752	                    conflict_marks += 1
   753	
   754	    tables: dict[tuple[int, int], list[int]] = {}
   755	    for edge in sorted(edge_keys):
   756	        mapping = [-1] * q
   757	        used = set()
   758	        for a in range(q):
   759	            compatible = [b for b in range(q) if allowed[edge][a][b]]
   760	            compatibility_cells += q
   761	            operations += q
   762	            if len(compatible) != 1:
   763	                return None, {
   764	                    "operations": operations,
   765	                    "incidence_reads": incidence_reads,
   766	                    "conflict_marks": conflict_marks,
   767	                    "compatibility_cells": compatibility_cells,
   768	                    "nodes": 0,
   769	                    "wall_clock_sec": time.perf_counter() - started,
   770	                    "reason": "a local compatibility row was not a singleton",
   771	                }
   772	            mapping[a] = compatible[0]
   773	            used.add(compatible[0])
   774	        if len(used) != q:
   775	            return None, {
   776	                "operations": operations,
   777	                "incidence_reads": incidence_reads,
   778	                "conflict_marks": conflict_marks,
   779	                "compatibility_cells": compatibility_cells,
   780	                "nodes": 0,
   781	                "wall_clock_sec": time.perf_counter() - started,
   782	                "reason": "a local compatibility relation was not a perfect matching",
   783	            }
   784	        tables[edge] = mapping
   785	
   786	    adjacency = [[] for _ in range(n)]
   787	    for (i, j), mapping in tables.items():
   788	        inverse = [-1] * q
   789	        for a, b in enumerate(mapping):
   790	            inverse[b] = a
   791	        adjacency[i].append((j, mapping))
   792	        adjacency[j].append((i, inverse))
   793	
   794	    assigned: dict[int, int] = {0: 0}
   795	    queue = deque([0])
   796	    nodes = 0
   797	    while queue:
   798	        i = queue.popleft()
   799	        nodes += 1
   800	        for j, mapping in adjacency[i]:
   801	            operations += 1
   802	            b = mapping[assigned[i]]
   803	            if j in assigned:
   804	                if assigned[j] != b:
   805	                    return None, {
   806	                        "operations": operations,
   807	                        "incidence_reads": incidence_reads,
   808	                        "conflict_marks": conflict_marks,
   809	                        "compatibility_cells": compatibility_cells,
   810	                        "nodes": nodes,
   811	                        "wall_clock_sec": time.perf_counter() - started,
   812	                        "reason": "cycle inconsistency",
   813	                    }
   814	            else:
   815	                assigned[j] = b
   816	                queue.append(j)
   817	    if len(assigned) != n:
   818	        return None, {
   819	            "operations": operations,
   820	            "incidence_reads": incidence_reads,
   821	            "conflict_marks": conflict_marks,
   822	            "compatibility_cells": compatibility_cells,
   823	            "nodes": nodes,
   824	            "wall_clock_sec": time.perf_counter() - started,
   825	            "reason": "constraint graph disconnected",
   826	        }
   827	    answer = [[i, assigned[i]] for i in range(n)]
   828	    elapsed = time.perf_counter() - started
   829	    return answer, {
   830	        "operations": operations,
   831	        "incidence_reads": incidence_reads,
   832	        "conflict_marks": conflict_marks,
   833	        "compatibility_cells": compatibility_cells,
   834	        "nodes": nodes,
   835	        "wall_clock_sec": elapsed,
   836	        "reason": "ok",
   837	    }
   838	
