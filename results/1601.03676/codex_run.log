+    if degree + 2 <= n - 5:
+        p["degree"] = degree + 2
+        return p
+    q = p.get("q", 8)
+    if (n - 1) * (q + 2) <= 300:
+        p["q"] = q + 1
+        p["degree"] = min(degree, n - 5)
+        return p
