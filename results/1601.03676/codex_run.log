+    for u in order:
+        buckets: dict[int, list[int]] = {}
+        for v in right:
+            if residual[v] > 0:
+                buckets.setdefault(residual[v], []).append(v)
+        choices: list[int] = []
+        for degree in sorted(buckets, reverse=True):
+            bucket = buckets[degree]
+            rng.shuffle(bucket)
+            choices.extend(bucket)
+        if len(choices) < left_degree:
+            raise RuntimeError("bipartite degree realization failed")
+        for v in choices[:left_degree]:
+            edges.add((min(u, v), max(u, v)))
+            residual[v] -= 1
+    if any(residual.values()):
+        raise RuntimeError("bipartite realization left residual stubs")
+    return edges
+
+
+def _simple_havel_hakimi(
+    vertices: list[int], degrees: dict[int, int], rng: random.Random,
+) -> set[tuple[int, int]]:
+    """Realize a graphical simple degree sequence with randomized tie breaks."""
+    residual = dict(degrees)
+    edges: set[tuple[int, int]] = set()
+    while True:
+        active = [v for v in vertices if residual[v] > 0]
+        if not active:
+            break
+        maximum = max(residual[v] for v in active)
+        top = [v for v in active if residual[v] == maximum]
+        u = rng.choice(top)
+        candidates = [v for v in active if v != u and (min(u, v), max(u, v)) not in edges]
+        rng.shuffle(candidates)
+        candidates.sort(key=lambda v: residual[v], reverse=True)
+        need = residual[u]
+        if len(candidates) < need:
+            raise RuntimeError("simple degree realization failed")
+        residual[u] = 0
+        for v in candidates[:need]:
+            edge = (min(u, v), max(u, v))
+            edges.add(edge)
+            residual[v] -= 1
+            if residual[v] < 0:
+                raise RuntimeError("negative residual degree")
+    return edges
+
+
+def _edge_switches(
+    edges: set[tuple[int, int]], allowed_vertices: set[int] | None,
+    bipartition: set[int] | None, rng: random.Random, attempts: int,
+) -> set[tuple[int, int]]:
+    """Randomize a simple realization while preserving every vertex degree."""
+    edge_list = list(edges)
+    if len(edge_list) < 2:
+        return edges
+    for _ in range(attempts):
+        i, j = rng.sample(range(len(edge_list)), 2)
+        a, b = edge_list[i]
+        c, d = edge_list[j]
+        if allowed_vertices is not None and not {a, b, c, d} <= allowed_vertices:
+            continue
+        if bipartition is not None:
+            # Orient each edge left-to-right before swapping right endpoints.
+            if (a in bipartition) == (b in bipartition) or (c in bipartition) == (d in bipartition):
+                continue
+            left1, right1 = (a, b) if a in bipartition else (b, a)
+            left2, right2 = (c, d) if c in bipartition else (d, c)
+            if left1 == left2 or right1 == right2:
+                continue
+            new1 = (min(left1, right2), max(left1, right2))
+            new2 = (min(left2, right1), max(left2, right1))
+        else:
+            if len({a, b, c, d}) < 4:
+                continue
+            if rng.getrandbits(1):
+                new1, new2 = (min(a, c), max(a, c)), (min(b, d), max(b, d))
+            else:
+                new1, new2 = (min(a, d), max(a, d)), (min(b, c), max(b, c))
+        old1, old2 = edge_list[i], edge_list[j]
+        if new1 == new2 or new1 in edges or new2 in edges:
+            continue
+        edges.remove(old1)
+        edges.remove(old2)
+        edges.add(new1)
+        edges.add(new2)
+        edge_list[i], edge_list[j] = new1, new2
+    return edges
+
+
+def _build_balanced_graph(n: int, k: int, r: int, rng: random.Random) -> tuple[list[int], set[tuple[int, int]]]:
+    """Build an r-regular graph with a uniformly labelled planted independent set."""
+    planted = sorted(rng.sample(range(n), k))
+    planted_set = set(planted)
+    other = [v for v in range(n) if v not in planted_set]
+
+    cross_total = r * k
+    base, extra = divmod(cross_total, len(other))
+    shuffled_other = list(other)
+    rng.shuffle(shuffled_other)
+    cross_degrees = {
+        v: base + int(i < extra) for i, v in enumerate(shuffled_other)
+    }
+    if any(degree > r for degree in cross_degrees.values()):
+        raise RuntimeError("invalid cross degree")
+
+    # The degree sequences used by the named presets are graphical.  Retrying
+    # only changes randomized tie breaks, never the planted witness.
+    last_error: Exception | None = None
+    for _ in range(100):
+        try:
+            cross = _bipartite_havel_hakimi(
+                planted, other, r, cross_degrees, rng
+            )
+            internal_degrees = {v: r - cross_degrees[v] for v in other}
+            internal = _simple_havel_hakimi(other, internal_degrees, rng)
+            cross = _edge_switches(
+                cross, None, planted_set, rng, 20 * len(cross)
+            )
+            internal = _edge_switches(
+                internal, set(other), None, rng, 20 * max(1, len(internal))
+            )
+            edges = cross | internal
+            degree = [0] * n
+            for u, v in edges:
+                degree[u] += 1
+                degree[v] += 1
+            if all(value == r for value in degree):
+                return planted, edges
+            last_error = RuntimeError("degree check failed after realization")
+        except RuntimeError as exc:
+            last_error = exc
+    raise RuntimeError(f"could not realize planted regular graph: {last_error}")
+
+
+def _conflict_masks(sets: list[list[int]]) -> list[int]:
+    owners: dict[int, list[int]] = {}
+    for index, values in enumerate(sets):
+        for value in values:
+            owners.setdefault(value, []).append(index)
+    masks = [0] * len(sets)
+    for incident in owners.values():
+        for i, u in enumerate(incident):
+            for v in incident[i + 1 :]:
+                masks[u] |= 1 << v
+                masks[v] |= 1 << u
+    return masks
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Inverse-generate a packing before sampling its balanced incidences."""
+    k = params.pop("k", max(2, n // 5))
+    r = params.pop("r", max(3, n // 7))
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    _validate_parameters(n, k, r)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+    rng = random.Random(seed)
+    answer, edges = _build_balanced_graph(n, k, r, rng)
+
+    edge_list = list(edges)
+    rng.shuffle(edge_list)
+    element_names = list(range(len(edge_list)))
+    rng.shuffle(element_names)
+    incident = [[] for _ in range(n)]
+    for element, (u, v) in zip(element_names, edge_list):
+        incident[u].append(element)
+        incident[v].append(element)
+    for values in incident:
+        rng.shuffle(values)
+
+    return {
+        "n": n,
+        "k": k,
+        "r": r,
+        "universe_size": len(edge_list),
+        "weight": 1,
+        "overlap_weight_threshold": 0,
+        "sets": incident,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render the complete native weighted-overlap packing problem."""
+    lines = "\n".join(
+        f"{index}: " + " ".join(str(value) for value in values)
+        for index, values in enumerate(inst["sets"])
+    )
+    statement = f"""WEIGHTED-OVERLAP SET PACKING
+
+The universe consists of the integer elements 0 through
+{inst['universe_size'] - 1}.  Every universe element has weight 1.  Below are
+{inst['n']} labelled sets, indexed 0 through {inst['n'] - 1}; the integers after
+an index are exactly the elements of that set.  Each set has exactly
+{inst['r']} distinct elements.
+
+For two sets A and B, their overlap weight is the sum of the weights of the
+elements in A intersection B.  The allowed threshold is 0, inclusive: two
+sets are compatible exactly when their overlap weight is at most 0.  Because
+all weights are 1, this is equivalent to A and B being disjoint.
+
+Find exactly {inst['k']} DISTINCT set indices such that every pair of selected
+sets is compatible.  The packing is unordered, but submit its indices in
+STRICTLY INCREASING order.  Repeats are forbidden and index bounds are
+inclusive.
+
+SETS
+{lines}
+
+Give your final answer inside <answer></answer> tags, as one JSON array of
+exactly {inst['k']} strictly increasing integer set indices.
+Example of syntax only: <answer>[3, 17, 42]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Parse a tagged JSON integer list, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    bodies = list(reversed(matches))
+    # Also tolerate a model that fenced the requested JSON but omitted tags.
+    bodies.extend(
+        match.group(1)
+        for match in reversed(list(re.finditer(r"```(?:json)?\s*(\[[\s\S]*?\])\s*```", text, re.I)))
+    )
+    for body in bodies:
+        body = body.strip()
+        if body.startswith("```") and body.endswith("```"):
+            rows = body.splitlines()
+            if len(rows) >= 3:
+                body = "\n".join(rows[1:-1]).strip()
+        try:
+            value = json.loads(body)
+        except (TypeError, ValueError):
+            continue
+        if isinstance(value, list) and all(type(item) is int for item in value):
+            return value
+    return None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any valid weighted-overlap packing without reading inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer is not a JSON array"
+    if not answer:
+        return False, "answer array is empty"
+    if len(answer) != inst["k"]:
+        return False, f"wrong number of indices: expected {inst['k']}, got {len(answer)}"
+    if any(type(value) is not int for value in answer):
+        return False, "every set index must be an integer"
+    if any(value < 0 or value >= inst["n"] for value in answer):
+        return False, f"set index out of range 0..{inst['n'] - 1}"
+    if len(set(answer)) != len(answer):
+        return False, "set indices must be distinct"
+    if answer != sorted(answer):
+        return False, "set indices must be strictly increasing"
+
+    used: dict[int, int] = {}
+    for set_index in answer:
+        for element in inst["sets"][set_index]:
+            if element in used:
+                return False, (
+                    f"sets {used[element]} and {set_index} overlap in element "
+                    f"{element}, giving weight 1 > 0"
+                )
+            used[element] = set_index
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the stated unordered k-subset candidate language."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    return sorted(rng.sample(range(inst["n"]), inst["k"]))
+
+
+def search_space(inst: dict) -> int | None:
+    return math.comb(inst["n"], inst["k"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    total = search_space(inst)
+    if total is None or total > _ENUMERATION_CAP:
+        return None
+    masks = _conflict_masks(inst["sets"])
+    count = 0
+    for candidate in itertools.combinations(range(inst["n"]), inst["k"]):
+        chosen = 0
+        valid = True
+        for vertex in candidate:
+            if masks[vertex] & chosen:
+                valid = False
+                break
+            chosen |= 1 << vertex
+        count += int(valid)
+    return count
+
+
+def _local_signatures(masks: list[int]) -> tuple[list[int], list[tuple]]:
+    n = len(masks)
+    triangles = [0] * n
+    four_cycles = [0] * n
+    for v in range(n):
+        neighbours = [u for u in range(n) if (masks[v] >> u) & 1]
+        triangles[v] = sum(
+            1 for i, u in enumerate(neighbours) for w in neighbours[i + 1 :] if (masks[u] >> w) & 1
+        )
+        common_counts = []
+        for u in range(n):
+            if u != v:
+                common_counts.append((masks[v] & masks[u]).bit_count())
+        four_cycles[v] = sum(c * (c - 1) // 2 for c in common_counts)
+    initial = [(masks[v].bit_count(), triangles[v], four_cycles[v]) for v in range(n)]
+    palette = {signature: i for i, signature in enumerate(sorted(set(initial)))}
+    colors = [palette[signature] for signature in initial]
+    histories: list[tuple] = [tuple(sorted(initial))]
+    for _ in range(n):
+        signatures = []
+        for v in range(n):
+            neighbor_colors = sorted(colors[u] for u in range(n) if (masks[v] >> u) & 1)
+            signatures.append((colors[v], tuple(neighbor_colors)))
+        palette2 = {signature: i for i, signature in enumerate(sorted(set(signatures)))}
+        refined = [palette2[signature] for signature in signatures]
+        histories.append(tuple(sorted(signatures)))
+        if refined == colors:
+            break
+        colors = refined
+    return colors, histories
+
+
+def canonical_key(inst: dict) -> str:
+    """Invariant under set order, universe labels, and within-set order."""
+    masks = _conflict_masks(inst["sets"])
+    n = len(masks)
+    colors, histories = _local_signatures(masks)
+    if len(set(colors)) == n:
+        order = sorted(range(n), key=lambda v: colors[v])
+        bits = "".join(
+            "1" if (masks[order[i]] >> order[j]) & 1 else "0"
+            for i in range(n) for j in range(i + 1, n)
+        )
+        material = (n, inst["k"], inst["r"], bits)
+        kind = "refined-exact"
+    else:
+        edge_colors: dict[tuple[int, int], int] = {}
+        for u in range(n):
+            for v in range(u + 1, n):
+                if (masks[u] >> v) & 1:
+                    pair = tuple(sorted((colors[u], colors[v])))
+                    edge_colors[pair] = edge_colors.get(pair, 0) + 1
+        material = (
+            n,
+            inst["k"],
+            inst["r"],
+            tuple(histories),
+            tuple(sorted(edge_colors.items())),
+        )
+        kind = "refined-invariant"
+    digest = hashlib.sha256(repr(material).encode("utf-8")).hexdigest()
+    return f"{kind}:n={n}:k={inst['k']}:r={inst['r']}:{digest}"
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow and crowd the decoy side while keeping the 24-label witness fixed."""
+    if not all(name in params for name in ("n", "k", "r")):
+        return None
+    n, k, r = int(params["n"]), int(params["k"]), int(params["r"])
+    if k < 24:
+        return {"n": n + 25, "k": k + 5, "r": r + 3}
+    if n >= 220 or r >= 34:
+        return None
+    new_n = n + 20
+    new_r = r + 3
+    if (new_r * (new_n - 2 * k)) % 2:
+        new_r += 1
+    return {"n": new_n, "k": k, "r": new_r}
+
+
+def _greedy_independent(inst: dict, rng: random.Random | None = None) -> tuple[list[int], int]:
+    masks = _conflict_masks(inst["sets"])
+    available = (1 << inst["n"]) - 1
+    chosen: list[int] = []
+    operations = 0
+    while available and len(chosen) < inst["k"]:
+        vertices = [v for v in range(inst["n"]) if (available >> v) & 1]
+        degrees = [(masks[v] & available).bit_count() for v in vertices]
+        minimum = min(degrees)
+        pool = [v for v, degree in zip(vertices, degrees) if degree == minimum]
+        v = min(pool) if rng is None else rng.choice(pool)
+        chosen.append(v)
+        available &= ~(masks[v] | (1 << v))
+        operations += len(vertices)
+    if len(chosen) < inst["k"]:
+        chosen.extend(v for v in range(inst["n"]) if v not in chosen)
+    return sorted(chosen[: inst["k"]]), operations
+
+
+def _attack_outlier(inst: dict) -> tuple[list[int], int]:
+    masks = _conflict_masks(inst["sets"])
+    n = inst["n"]
+    scores = []
+    for v in range(n):
+        neighbours = [u for u in range(n) if (masks[v] >> u) & 1]
+        triangles = sum(
+            int((masks[u] >> w) & 1)
+            for i, u in enumerate(neighbours) for w in neighbours[i + 1 :]
+        )
+        scores.append((triangles, sum(inst["sets"][u].__len__() for u in neighbours), v))
+    candidates = []
+    for reverse in (False, True):
+        trial = sorted(v for _, _, v in sorted(scores, reverse=reverse)[: inst["k"]])
+        if verify(inst, trial)[0]:
+            return trial, n * inst["r"]
+        candidates = trial
+    return candidates, n * inst["r"]
+
+
+def _attack_random_restarts(inst: dict, rng: random.Random, restarts: int = 256) -> tuple[list[int], int]:
+    last: list[int] = []
+    operations = 0
+    for _ in range(restarts):
+        last, cost = _greedy_independent(inst, rng)
+        operations += cost
+        if verify(inst, last)[0]:
+            return last, operations
+    return last, operations
+
+
+def _attack_spectral(inst: dict) -> tuple[list[int], int]:
+    """Bottom-adjacency eigenvector sweep and ranked greedy repair."""
+    masks = _conflict_masks(inst["sets"])
+    n, degree, k = inst["n"], inst["r"], inst["k"]
+    vector = [math.sin((i + 1) * 1.61803398875) for i in range(n)]
+    mean = sum(vector) / n
+    vector = [value - mean for value in vector]
+    iterations = 120
+    for _ in range(iterations):
+        nxt = []
+        for v in range(n):
+            neighbor_sum = sum(vector[u] for u in range(n) if (masks[v] >> u) & 1)
+            nxt.append(degree * vector[v] - neighbor_sum)
+        norm = math.sqrt(sum(value * value for value in nxt)) or 1.0
+        vector = [value / norm for value in nxt]
+
+    last = list(range(k))
+    for reverse in (False, True):
+        order = sorted(range(n), key=lambda v: vector[v], reverse=reverse)
+        direct = sorted(order[:k])
+        if verify(inst, direct)[0]:
+            return direct, iterations * n * degree
+        chosen: list[int] = []
+        forbidden = 0
+        for v in order:
+            if not ((forbidden >> v) & 1):
+                chosen.append(v)
+                forbidden |= masks[v] | (1 << v)
+                if len(chosen) == k:
+                    trial = sorted(chosen)
+                    if verify(inst, trial)[0]:
+                        return trial, iterations * n * degree
+                    last = trial
+                    break
+    return last, iterations * n * degree
+
+
+def _color_sort(vertices: int, adjacency: list[int]) -> tuple[list[int], list[int]]:
+    """Greedy coloring upper bound for a maximum-clique expansion."""
+    order: list[int] = []
+    bounds: list[int] = []
+    remaining = vertices
+    color = 0
+    while remaining:
+        color += 1
+        available = remaining
+        while available:
+            bit = available & -available
+            v = bit.bit_length() - 1
+            order.append(v)
+            bounds.append(color)
+            remaining ^= bit
+            available ^= bit
+            available &= ~adjacency[v]
+    return order, bounds
+
+
+def _exact_branch_attack(inst: dict, node_cap: int = _EXACT_NODE_CAP) -> tuple[list[int] | None, int, bool]:
+    """Capped exact target-clique search on the compatibility graph."""
+    conflicts = _conflict_masks(inst["sets"])
+    n, target = inst["n"], inst["k"]
+    full = (1 << n) - 1
+    adjacency = [full & ~(conflicts[v] | (1 << v)) for v in range(n)]
+    nodes = 0
+    found: list[int] | None = None
+    exhausted = True
+
+    def expand(clique: list[int], candidates: int) -> None:
+        nonlocal nodes, found, exhausted
+        if found is not None or not candidates:
+            return
+        order, colors = _color_sort(candidates, adjacency)
+        for index in range(len(order) - 1, -1, -1):
+            if found is not None:
+                return
+            if len(clique) + colors[index] < target:
+                return
+            v = order[index]
+            bit = 1 << v
+            if not (candidates & bit):
+                continue
+            nodes += 1
+            if nodes >= node_cap:
+                exhausted = False
+                return
+            clique.append(v)
+            if len(clique) == target:
+                found = sorted(clique)
+                clique.pop()
+                return
+            expand(clique, candidates & adjacency[v])
+            clique.pop()
+            if not exhausted:
+                return
+            candidates ^= bit
+
+    expand([], full)
+    return found, nodes, exhausted
+
+
+def _relabel_instance(
+    inst: dict, set_old_to_new: list[int], element_old_to_new: list[int], rng: random.Random,
+) -> dict:
+    n, universe = inst["n"], inst["universe_size"]
+    if sorted(set_old_to_new) != list(range(n)):
+        raise ValueError("set_old_to_new is not a permutation")
+    if sorted(element_old_to_new) != list(range(universe)):
+        raise ValueError("element_old_to_new is not a permutation")
+    moved_sets: list[list[int]] = [[] for _ in range(n)]
+    for old_index, values in enumerate(inst["sets"]):
+        new_values = [element_old_to_new[value] for value in values]
+        rng.shuffle(new_values)
+        moved_sets[set_old_to_new[old_index]] = new_values
+    return {
+        "n": n,
+        "k": inst["k"],
+        "r": inst["r"],
+        "universe_size": universe,
+        "weight": inst["weight"],
+        "overlap_weight_threshold": inst["overlap_weight_threshold"],
+        "sets": moved_sets,
+        "answer": sorted(set_old_to_new[index] for index in inst["answer"]),
+    }
+
+
+def _answer_metrics(answer: list[int]) -> tuple[int, int, int]:
+    blob = json.dumps(answer)
+    return len(blob), math.ceil(len(blob) / 4), len(answer)
+
+
+def selftest() -> dict:
+    report: dict = {
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    g1_failures = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                g1_failures.append(f"{preset}/{seed}: {reason}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append(f"{preset}/{seed}: answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": attempts,
+        "verified": attempts - len(g1_failures),
+        "failures": g1_failures,
+        "construction": "inverse generation of an independent incidence class",
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=123, **shipping)
