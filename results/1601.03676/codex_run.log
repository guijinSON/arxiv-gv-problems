+    """Increase crowding at fixed witness length before touching other axes."""
+
+    p = {k: int(v) for k, v in params.items() if not k.startswith("_")}
+    n = p["n"]
+    degree = p.get("degree", 3)
+    if degree + 2 <= n - 5:
+        p["degree"] = degree + 2
+        return p
+    q = p.get("q", 8)
+    if (n - 1) * (q + 2) <= 300:
+        p["q"] = q + 1
+        p["degree"] = min(degree, n - 5)
+        return p
+    return "cap_bound"
+
 
