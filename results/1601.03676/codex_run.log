   993	def selftest() -> dict:
   994	    """Run mandatory gates and return their machine-readable measurements."""
   995	
   996	    report: dict = {"paper": "1601.03676", "track": TRACK}
   997	
   998	    # G1: all presets, several seeds, and JSON-native answers.
   999	    g1_checks = 0
  1000	    g1_errors = []
  1001	    for preset, params in DIFFICULTY.items():
  1002	        for seed in (0, 1, 19):
  1003	            inst = make_instance(seed=seed, **params)
  1004	            ok, reason = verify(inst, inst["answer"])
  1005	            json_ok = json.loads(json.dumps(inst["answer"])) == inst["answer"]
  1006	            compact, _ = _compact_anchor_algorithm(inst)
  1007	            compact_ok = verify(inst, compact)[0]
  1008	            g1_checks += 1
  1009	            if not ok or not json_ok or not compact_ok:
  1010	                g1_errors.append({"preset": preset, "seed": seed, "reason": reason})
  1011	    report["G1_planted_verifies"] = {
  1012	        "pass": not g1_errors,
  1013	        "checks": g1_checks,
  1014	        "errors": g1_errors,
  1015	    }
  1016	
  1017	    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
  1018	    inst = make_instance(seed=73, **shipping)
  1019	
  1020	    # G2: five qualitatively different corruptions and five distinct reasons.
  1021	    planted = [pair[:] for pair in inst["answer"]]
  1022	    corruptions = {
  1023	        "empty": [],
  1024	        "drop_one": planted[:-1],
  1025	        "duplicate_group": planted[:-1] + [planted[0][:]],
  1026	        "out_of_range": planted[:-1] + [[planted[-1][0], inst["q"]]],
  1027	    }
  1028	    swapped = None
  1029	    for i in range(inst["n"]):
  1030	        for j in range(i + 1, inst["n"]):
  1031	            trial = [pair[:] for pair in planted]
  1032	            trial[i][1], trial[j][1] = trial[j][1], trial[i][1]
  1033	            if trial != planted and not verify(inst, trial)[0]:
  1034	                swapped = trial
  1035	                break
