+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 15, "k": 3, "r": 4},
+    "easy": {"n": 70, "k": 14, "r": 12},
+    "medium": {"n": 95, "k": 19, "r": 16},
+    "hard": {"n": 120, "k": 24, "r": 18},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Hint: Every universe element links exactly two sets, so choosing a set "
+    "propagates exclusions through a regular incidence graph."
+)
+PLACEBO_HINT = (
+    "Hint: Careful bookkeeping helps avoid confusing set labels with the "
+    "universe elements written on each line."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A strictly increasing JSON list of exactly k distinct integer set "
+        "indices from 0 through n-1; order is normalized because the packing "
