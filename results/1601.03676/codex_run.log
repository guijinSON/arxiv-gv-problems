+def _closed_walk_traces(adj: list[list[int]], limit: int = 14) -> tuple[int, ...]:
+    n = len(adj)
+    base = [[0] * n for _ in range(n)]
+    for i, row in enumerate(adj):
+        for j in row:
+            base[i][j] = 1
+    power = [row[:] for row in base]
+    traces = []
