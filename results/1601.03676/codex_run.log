   495	        "weight element is forbidden.  All comparisons and sums are exact integers.",
   496	        "",
   497	        f"Find exactly k={n} distinct candidate sets with no alpha-conflicting pair.",
   498	        "You must choose exactly one option from every group.  (Candidates in the",
   499	        "same group share a positive-weight group element, so no valid packing can",
   500	        "take two of them.)  The listed constraint edges identify group pairs that",
   501	        "may have an additional positive-weight overlap; all validity is still",
   502	        "defined by the displayed sets and the alpha rule above.",
   503	        "",
   504	        "For reference, [anchor element, weight] is listed in group order 0..n-1",
   505	        "(each anchor is also visible in every option of its group):",
   506	        "  " + json.dumps(
   507	            list(zip(inst["group_anchors"], inst["group_anchor_weights"])),
   508	            separators=(",", ":"),
   509	        ),
   510	        "",
   511	        "Constraint edges (undirected group pairs):",
   512	        "  " + json.dumps(inst["constraint_edges"], separators=(",", ":")),
   513	        "",
   514	        "Candidate sets:",
   515	    ]
   516	    for i, group in enumerate(inst["groups"]):
   517	        lines.append(f"Group {i}:")
   518	        for a, candidate in enumerate(group):
   519	            body = ",".join(map(str, candidate))
   520	            lines.append(f"  option {a}: {{{body}}}")
   520	            lines.append(f"  option {a}: {{{body}}}")
   521	    lines.extend([
   522	        "",
   523	        "Group IDs and option IDs are 0-indexed.  Return one [group,option] pair",
   524	        "for every group.  Pair order is irrelevant; group IDs may not repeat.",
   525	        "Give your final answer inside <answer></answer> tags as one JSON array.",
   526	        "Example: <answer>[[0,2],[1,0],[2,1]]</answer>",
   527	        "That three-pair example illustrates syntax only; it is not a complete answer.",
   528	        "Output nothing else inside the tags.",
   529	    ])
   530	    mode = os.environ.get("GV_HINT_MODE")
   531	    if mode == "structural":
   532	        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
   533	    elif mode == "placebo":
   534	        lines.extend(["", "Hint: " + PLACEBO_HINT])
