   596	def _rooted_wl_signature(adj: list[list[int]], root: int) -> tuple:
   597	    """A relabelling-invariant rooted 1-WL fingerprint."""
   598	
   599	    n = len(adj)
   600	    colors = [1 if v == root else 0 for v in range(n)]
   601	    for _ in range(n):
   602	        sigs = [(colors[v], tuple(sorted(colors[w] for w in adj[v]))) for v in range(n)]
   603	        palette = {sig: i for i, sig in enumerate(sorted(set(sigs)))}
   604	        new = [palette[sig] for sig in sigs]
   605	        if new == colors:
   606	            break
   607	        colors = new
   608	    class_sizes = tuple(sorted(Counter(colors).items()))
   609	    edge_colors = Counter()
   610	    for u, row in enumerate(adj):
   611	        for v in row:
   612	            if u < v:
   613	                edge_colors[tuple(sorted((colors[u], colors[v])))] += 1
   614	    distances = [-1] * n
   615	    distances[root] = 0
   616	    queue = deque([root])
   617	    while queue:
   618	        u = queue.popleft()
   619	        for v in adj[u]:
   620	            if distances[v] < 0:
   621	                distances[v] = distances[u] + 1
   622	                queue.append(v)
   623	    return (
   624	        class_sizes,
   625	        tuple(sorted(edge_colors.items())),
   626	        tuple(sorted(Counter(distances).items())),
   627	    )
   628	
   629	
   630	def _closed_walk_traces(adj: list[list[int]], limit: int = 14) -> tuple[int, ...]:
   631	    n = len(adj)
   632	    base = [[0] * n for _ in range(n)]
   633	    for i, row in enumerate(adj):
   634	        for j in row:
   635	            base[i][j] = 1
   636	    power = [row[:] for row in base]
   637	    traces = []
   638	    for _length in range(1, min(limit, n) + 1):
   639	        traces.append(sum(power[i][i] for i in range(n)))
   640	        nxt = [[0] * n for _ in range(n)]
   641	        for i in range(n):
   642	            for k, value in enumerate(power[i]):
   643	                if not value:
   644	                    continue
   645	                for j in adj[k]:
   646	                    nxt[i][j] += value
   647	        power = nxt
   648	    return tuple(traces)
