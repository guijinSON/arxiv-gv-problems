   651	def canonical_key(inst) -> str:
   652	    """Hash a structural invariant of the constraint graph, never the seed/render.
   653	
   654	    Independent option names and universe labels are pure relabellings.  Every
   655	    generated consistent q-cover over the same base graph is isomorphic under
   656	    those relabellings, so the key intentionally reduces to strong invariants of
   657	    the unlabelled base graph plus n, q, degree and the alpha threshold.
   658	    """
   659	
   660	    adj = _constraint_adjacency(inst)
   661	    invariant = {
   662	        "n": inst["n"],
   663	        "q": inst["q"],
   664	        "degree": inst["degree"],
   665	        "threshold": inst["overlap_threshold"],
   666	        "rooted_wl": sorted(_rooted_wl_signature(adj, v) for v in range(len(adj))),
   667	        "walk_traces": _closed_walk_traces(adj),
   668	    }
   669	    blob = json.dumps(invariant, sort_keys=True, separators=(",", ":"))
   670	    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
