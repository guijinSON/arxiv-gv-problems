+"""Verified weighted-overlap set-packing generator for arXiv:1601.03676.
+
+The paper defines r-Set Packing with alpha()-Overlap.  This module uses its
+Section 4.1 alpha-Weight function with unit element weights and threshold zero:
+two selected sets are compatible exactly when they are disjoint.  Instances
+are inverse-generated as degree-balanced incidence systems with a planted
+packing; the witness is known before the remaining incidences are sampled.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import sys
+import time
+
