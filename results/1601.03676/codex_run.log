   665	        "threshold": inst["overlap_threshold"],
   666	        "rooted_wl": sorted(_rooted_wl_signature(adj, v) for v in range(len(adj))),
   667	        "walk_traces": _closed_walk_traces(adj),
   668	    }
   669	    blob = json.dumps(invariant, sort_keys=True, separators=(",", ":"))
   670	    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
