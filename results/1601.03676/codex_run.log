   840	def _compact_anchor_algorithm(inst: dict) -> tuple[list[list[int]], int]:
   841	    """Recover global sheet zero from the anchor-weight-residue invariant.
   842	
   843	    This reads only rendered instance fields, never ``inst['answer']``.  One
   844	    remainder and one modular negation per group give the local option whose
   845	    coordinate is zero.
   846	    """
   847	
   848	    q = inst["q"]
   849	    answer = []
   850	    operations = 0
   851	    for group, weight in enumerate(inst["group_anchor_weights"]):
   852	        shift = weight % q
   853	        option = (-shift) % q
   854	        operations += 2
   855	        answer.append([group, option])
   856	    return answer, operations
   857	
   858	
   859	def _attack_equal_option(inst: dict) -> list[list[int]]:
   860	    return [[i, 0] for i in range(inst["n"])]
   861	
   862	
   863	def _attack_outlier_min_sum(inst: dict) -> list[list[int]]:
   864	    zero = inst["zero_weight_element"]
   865	    answer = []
   866	    for i, group in enumerate(inst["groups"]):
   867	        total_weight = inst["group_anchor_weights"][i] + inst["r"] - 2
   868	        scores = [
   869	            (total_weight, sum(x for x in candidate if x != zero), a)
   870	            for a, candidate in enumerate(group)
   871	        ]
   872	        answer.append([i, min(range(inst["q"]), key=lambda a: scores[a])])
   873	    return answer
