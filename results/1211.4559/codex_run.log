+    return result
+
+
+def _rotation(a, b):
+    denominator = a * a + b * b
+    cosine = Fraction(a * a - b * b, denominator)
+    sine = Fraction(2 * a * b, denominator)
+    return ((cosine, -sine), (sine, cosine))
+
+
+def _rotation_json(matrix):
+    return [[_qpair(value) for value in row] for row in matrix]
+
