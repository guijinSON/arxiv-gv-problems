+
+def _read_q(value):
+    if (
+        not isinstance(value, list)
+        or len(value) != 2
+        or not all(_is_int(x) for x in value)
+        or value[1] == 0
+    ):
+        raise ValueError("a rational must be [integer numerator, nonzero integer denominator]")
+    return Fraction(value[0], value[1])
+
+
+def _point_from_json(point):
