+        if key.startswith("G") and isinstance(value, dict) and "pass" in value
+    ]
+    report["all_pass"] = all(gate_values)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

