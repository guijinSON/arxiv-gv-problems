+        _format_q(matrix[row][column])
+        for row in range(2)
+        for column in range(2)
+    )
+
+
+def render(inst):
+    """Render the complete, stand-alone exact geometry problem."""
+    epsilon_squared = _read_q(inst["epsilon_squared"])
