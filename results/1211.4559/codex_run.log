+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A 2 by 2 orientation-preserving rational rotation R(a,b), where "
+        "R=[[(a^2-b^2)/(a^2+b^2),-2ab/(a^2+b^2)],"
+        "[2ab/(a^2+b^2),(a^2-b^2)/(a^2+b^2)]], 1<=a<=H, "
