+        [
+            "",
+            "Give your final answer inside <answer></answer> tags as two matrix rows,",
+            "using four reduced rationals num/den in this exact layout:",
+            "<answer>[[3/5,-4/5],[4/5,3/5]]</answer>",
+            "Output nothing else inside the tags.",
