+_GAUSSIAN_PRIMES = (
+    (2, 1),   # 5
+    (3, 2),   # 13
+    (4, 1),   # 17
+    (5, 2),   # 29
+    (6, 1),   # 37
+    (5, 4),   # 41
+    (7, 2),   # 53
