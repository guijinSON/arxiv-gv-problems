+    rotated = [_apply(matrix, point) for point in points]
+    identifiers = rng.sample(range(1000000, 9000000), n)
+    sites = [
+        {"id": identifier, "point": _point_to_json(point)}
+        for identifier, point in zip(identifiers, rotated)
+    ]
+    rng.shuffle(sites)
