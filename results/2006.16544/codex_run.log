+        return None
+    start = min(adjacency)
+    order = [start]
+    previous = None
+    current = start
+    while True:
+        candidates = [v for v in adjacency[current] if v != previous]
+        if not candidates:
+            return None
+        nxt = min(candidates) if previous is None else candidates[0]
+        if nxt == start:
+            break
+        if nxt in order:
+            return None
+        order.append(nxt)
+        previous, current = current, nxt
+    if len(order) != len(adjacency):
+        return None
+    if order[1] > order[-1]:
+        order = [order[0]] + list(reversed(order[1:]))
+    return order
