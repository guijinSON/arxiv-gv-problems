+            "complexity": "O(r*b^2 + |E|*b) bit operations",
+            "wall_clock_sec_median": round(
+                sorted(reference_times)[len(reference_times) // 2], 6
+            ),
+            "operations_median": sorted(reference_operations)[
+                len(reference_operations) // 2
