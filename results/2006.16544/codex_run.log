+def _structured_decoder_rows(bits, decoys, key, rng):
+    inverse = _circulant_inverse(bits)
+    offset = _offset(bits)
+    masks = [offset] + [offset ^ _rotl(inverse, i, bits) for i in range(bits)]
+    used = set(masks)
