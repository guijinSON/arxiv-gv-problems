+# Filled from scripts/harden.py evidence after the three isolated runs.  A pending
+# verdict deliberately fails G9 rather than inventing oracle evidence.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
