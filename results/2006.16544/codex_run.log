+def _random_matching_avoiding(n, forbidden, rng):
+    vertices = list(range(n))
+    for _ in range(10000):
+        rng.shuffle(vertices)
+        matching = [
+            tuple(sorted((vertices[i], vertices[i + 1])))
+            for i in range(0, n, 2)
+        ]
