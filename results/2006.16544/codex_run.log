+    pivot_row = 0
+    for column in range(bits):
+        pivot = next(
+            (r for r in range(pivot_row, bits) if (rows[r][0] >> column) & 1),
+            None,
+        )
+        if pivot is None:
+            raise ValueError("key_bits makes 1+x+x^3 singular modulo x^b-1")
