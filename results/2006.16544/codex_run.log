+    offset = _offset(bits)
+    inverse = _circulant_inverse(bits)
+    if offset not in table:
+        return None
+    offset_rhs = table[offset]
+    z = 0
+    for i in range(bits):
+        row = offset ^ _rotl(inverse, i, bits)
+        if row not in table:
