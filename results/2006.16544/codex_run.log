+    ordered = sorted(vertices)
+    if len(ordered) != 4 or len(set(ordered)) != 4:
+        return None
+    return sum(math.comb(value, i + 1) for i, value in enumerate(ordered))
+
+
+def verify(inst, answer) -> tuple[bool, str]:
