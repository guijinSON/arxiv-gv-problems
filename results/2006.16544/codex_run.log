+    anchor_edges = []
+    taken = set()
+    for i in range(0, n, max(1, n // max(1, anchors))):
+        if len(anchor_edges) >= anchors:
+            break
+        edge = tuple(sorted((planted[i], planted[(i + 1) % n])))
+        if not (set(edge) & taken):
+            anchor_edges.append(list(edge))
+            taken.update(edge)
+    if len(anchor_edges) != anchors:
+        for edge in sorted(cycle_edges):
+            if len(anchor_edges) >= anchors:
