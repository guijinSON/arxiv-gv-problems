+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Project an alternating tight cycle to the cubic base graph and cancel "
+        "the affine offset in a hidden circulant GF(2) basis; without that change "
+        "of variables one must eliminate a dense decoder system."
+    ),
+    "hardness_basis": (
+        "Track B: GF(2) Gaussian elimination followed by edge classification "
+        "solves the shipping decoder in O(r*b^2+|E|*b) bit operations; the final "
+        "measured row-operation count and wall time are recorded by selftest, "
+        "whereas the circulant route needs at most 279 exact packed-word XOR/parity "
+        "operations.  The underlying near-threshold regime is the k=4 case of "
+        "Garbe--Mycroft Theorem 1.5 (minimum codegree N/2-O(1))."
+    ),
