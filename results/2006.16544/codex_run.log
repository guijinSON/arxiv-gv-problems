+        if pivot is None:
+            raise ValueError("key_bits makes 1+x+x^3 singular modulo x^b-1")
+        rows[pivot_row], rows[pivot] = rows[pivot], rows[pivot_row]
+        for r in range(bits):
+            if r != pivot_row and ((rows[r][0] >> column) & 1):
+                rows[r][0] ^= rows[pivot_row][0]
+                rows[r][1] ^= rows[pivot_row][1]
