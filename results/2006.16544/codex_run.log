+        relabelled = _relabel_instance(trial, mapping, reorder_seed=15000 + seed)
+        if canonical_key(relabelled) == canonical_key(trial):
+            invariant_checks += 1
+        if verify(relabelled, relabelled["answer"])[0]:
+            carried_checks += 1
