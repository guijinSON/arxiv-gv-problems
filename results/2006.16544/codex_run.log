+def _mask(bits):
+    return (1 << bits) - 1
+
+
+def _rotl(value, amount, bits):
+    amount %= bits
+    value &= _mask(bits)
+    if amount == 0:
+        return value
+    return ((value << amount) | (value >> (bits - amount))) & _mask(bits)
+
+
+def _rotr(value, amount, bits):
+    return _rotl(value, -amount, bits)
+
