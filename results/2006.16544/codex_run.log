+    seen = {start}
+    while len(order) < len(adjacency):
+        choices = sorted(v for v in adjacency[order[-1]] if v not in seen)
+        if not choices:
+            return None
+        order.append(choices[0])
+        seen.add(choices[0])
+    if start not in adjacency[order[-1]]:
+        return None
+    return _answer_from_projected(inst, order)
