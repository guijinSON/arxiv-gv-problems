        "field_prime": _P,
        "moment_degree": 2,
        "inverse_power": inverse_power,
        "n": n,
        "moment_matrix_dimension": 1 + n + n * (n - 1) // 2,
        "coefficient_matrix": matrix,
        "rhs": rhs,
        "answer": answer,
