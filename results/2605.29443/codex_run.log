       \begin{picture}(0,0)
         \put(-3,98){\footnotesize $1$}
     \put(-3,35){\footnotesize  $2$ }
      \end{picture}
    
    \caption{Bumping pure sliding moves 1 and 2.}
    \label{fig:Bps move}
