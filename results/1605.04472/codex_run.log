   400	def random_candidate(inst, rng) -> object:
   401	    """Uniformly sample the stated distinct bounded coefficient language."""
   402	    return rng.sample(range(1, inst["coeff_bound"] + 1), inst["variables"])
   403	
   404	
   405	def search_space(inst) -> int | None:
   406	    """Number of ordered, pairwise-distinct arrays in the language: B!/(B-k)!."""
   407	    b, k = inst["coeff_bound"], inst["variables"]
   408	    return math.prod(range(b - k + 1, b + 1))
   409	
