   424	def canonical_key(inst) -> str:
   425	    """Invariant under generator reordering and arbitrary variable renaming.
   426	
   427	    Rows distinguished by the same variable are grouped; row triples (u,lambda,c)
   428	    are sorted within groups, then the groups themselves are sorted.  Variable
   429	    labels and row positions therefore disappear, while all public coefficients
   430	    remain in the invariant.
   431	    """
   432	    k = inst["variables"]
   433	    groups = [[] for _ in range(k)]
   434	    for u, lam, p, c in inst["rows"]:
   435	        groups[p].append([u, lam, c])
   436	    normalized = sorted(sorted(group) for group in groups)
   437	    payload = {
   438	        "variables": k,
   439	        "coeff_bound": inst["coeff_bound"],
   440	        "groups": normalized,
   441	    }
   442	    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
   443	    return hashlib.sha256(raw).hexdigest()
