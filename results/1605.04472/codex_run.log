-CERTIFICATE_LANGUAGE: dict = {
-    "description": (
-        "A JSON object containing k ordered monic two-term polynomials "
-        "x_j^2-a_j as coefficient pairs [[-p,q],[1,1]], where a_j=p/q, "
-        "2^(n-1)<=p<2^n, q is in the instance denominator list, gcd(p,q)=1, "
