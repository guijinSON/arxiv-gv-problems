+    lo, hi = _bounds(inst["n"])
+    best = None
+    for q in inst["denominators"]:
+        center = int(estimate * q)
+        for delta in range(0, 4 + len(used)):
+            for p in ({center - delta, center + delta} if delta else {center}):
+                p = min(hi, max(lo, p))
+                if math.gcd(p, q) != 1:
+                    continue
+                value = Fraction(p, q)
