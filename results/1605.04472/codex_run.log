+def _candidate_from_estimates(inst, estimates):
+    used, values = set(), []
+    for estimate in estimates:
+        value = _nearest_language_value(inst, Fraction(estimate), used)
+        used.add(value)
+        values.append(value)
+    return _basis_from_values(values)
