+    for q in inst["denominators"]:
+        count = _count_for_denominator(inst["n"], q)
+        if index < count:
+            return Fraction(_nth_numerator(inst["n"], q, index), q)
+        index -= count
+    raise IndexError("rational-language index out of range")
