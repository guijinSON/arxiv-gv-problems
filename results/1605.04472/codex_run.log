-        "reference_algorithm": {
-            "name": "exact Gauss-Jordan elimination on the quadratic coefficient matrix",
-            "complexity": "O(k^3) exact rational operations",
-            "wall_clock_sec_mean": sum(ref_times) / len(ref_times),
