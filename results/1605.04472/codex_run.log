        b >>= 1
        carry = a >> (degree - 1)
        a = (a << 1) & mask
        if carry:
            a ^= low_modulus
        loops += 1
    if counter is not None:
        counter["field_multiplications"] += 1
        counter["multiply_loop_steps"] += loops
    return result


