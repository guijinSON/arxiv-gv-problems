   179	def make_instance(n, seed=0, **params) -> dict:
   180	    """Inverse-generate a q=1 Groebner instance and its reduced basis.
   181	
   182	    Let b_j=x_j^2-a_j and S_b=sum_j b_j.  Every emitted polynomial is
   183	    f_i=u_i*S_b+lambda_i*b_{p_i}.  One row for every p has positive u_i and
   184	    lambda_i, so the corresponding coefficient matrix is D+u*1^T and is
   185	    nonsingular by the matrix determinant lemma.  Thus <F>=<b_1,...,b_k>.
   186	    """
   187	    variables = params.get("variables", 32)
   188	    coeff_bound = params.get("coeff_bound", 1_000_000)
   189	    mix_bound = params.get("mix_bound", 19)
   190	    _validate_params(n, variables, coeff_bound, mix_bound)
   191	    _require_int("seed", seed)
   192	    rng = random.Random(seed)
   193	
   194	    # Sampling the certificate first is the generatability route.  Positive,
   195	    # distinct values are part of the public bounded certificate language.
   196	    answer = rng.sample(range(1, coeff_bound + 1), variables)
   197	    answer_sum = sum(answer)
   198	
   199	    # All rows for the same p are scalar multiples of one independently drawn
   200	    # archetype.  Hence redundant rows enlarge the generic elimination workload
   201	    # without leaking a two-row shortcut for S_b.  There is no distinguished
   202	    # "planted row": every emitted row is drawn by the same scaled-archetype rule.
   203	    archetypes = [
   204	        [rng.randint(1, mix_bound), rng.randint(1, mix_bound)]
   205	        for _ in range(variables)
   206	    ]
   207	    distinguished = list(range(variables))
   208	    distinguished.extend(rng.randrange(variables) for _ in range(n - variables))
   209	    rng.shuffle(distinguished)
   210	
   211	    rows = []
   212	    for p in distinguished:
   213	        base_u, base_lam = archetypes[p]
   214	        scale = rng.randint(1, mix_bound)
   215	        u = scale * base_u
   216	        lam = scale * base_lam
   217	        c = scale * (base_u * answer_sum + base_lam * answer[p])
   218	        rows.append([u, lam, p, c])
   219	
   220	    return {
   221	        "n": n,
   222	        "variables": variables,
   223	        "coeff_bound": coeff_bound,
   224	        "mix_bound": mix_bound,
   225	        "rows": rows,
   226	        "answer": answer,
   227	    }
