   345	def verify(inst, answer) -> tuple[bool, str]:
   346	    """Check the claimed reduced basis exactly, without reading inst['answer'].
   347	
   348	    Reducing u*Q2+lambda*x_p^2-c by x_j^2-a_j leaves the
   349	    constant u*sum(a_j)+lambda*a_p-c.  Vanishing of all such remainders proves
   350	    <F> is contained in <G>.  Full coefficient rank proves the reverse
   351	    containment.  Pairwise-coprime leading monomials make every S-polynomial
   352	    reduce to zero, which is Buchberger's criterion.
   353	    """
   354	    if not isinstance(answer, list):
   355	        return False, "answer must be a JSON integer array"
   356	    if len(answer) == 0:
   357	        return False, "answer array is empty"
   358	    k = inst.get("variables")
   359	    if len(answer) != k:
   360	        return False, f"wrong length: expected {k} constants"
   361	    if any(isinstance(a, bool) or not isinstance(a, int) for a in answer):
   362	        return False, "every basis constant must be an integer"
   363	    bound = inst.get("coeff_bound")
   364	    if any(a < 1 or a > bound for a in answer):
   365	        return False, f"basis constant outside the inclusive range 1..{bound}"
   366	    if len(set(answer)) != k:
   367	        return False, "basis constants must be pairwise distinct"
   368	
   369	    total = sum(answer)
   370	    rows = inst.get("rows")
   371	    if not isinstance(rows, list):
   372	        return False, "instance rows are malformed"
   373	    coefficient_rows = []
   374	    for i, row in enumerate(rows, 1):
   375	        if (not isinstance(row, list) or len(row) != 4
   376	                or any(isinstance(x, bool) or not isinstance(x, int) for x in row)):
   377	            return False, f"instance row {i} is malformed"
   378	        u, lam, p, c = row
   379	        if not 0 <= p < k:
   380	            return False, f"instance row {i} has an invalid variable index"
   381	        remainder = u * total + lam * answer[p] - c
   382	        if remainder != 0:
   383	            return False, f"input polynomial {i} has nonzero exact remainder {remainder}"
   384	        coeffs = [u] * k
   385	        coeffs[p] += lam
   386	        coefficient_rows.append(coeffs)
   387	
   388	    # Executable Buchberger check: for i!=j the S-polynomial of
   389	    # x_i^2-a_i and x_j^2-a_j reduces to a_j*a_i-a_i*a_j.
   390	    for i in range(k):
   391	        for j in range(i + 1, k):
   392	            if answer[j] * answer[i] - answer[i] * answer[j] != 0:
   393	                return False, f"S-polynomial ({i + 1},{j + 1}) did not reduce to zero"
   394	
   395	    if _matrix_rank_q(coefficient_rows) != k:
   396	        return False, "input generators do not have full exact coefficient rank"
   397	    return True, "ok"
   398	
