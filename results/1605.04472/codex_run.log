   285	def _extract_json_array(text):
   286	    if not isinstance(text, str):
   287	        return None
   288	    tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
   289	                        flags=re.IGNORECASE | re.DOTALL)
   290	    regions = tagged[::-1] if tagged else [text]
   291	    decoder = json.JSONDecoder()
   292	    for region in regions:
   293	        clean = re.sub(r"^\s*```(?:json)?\s*|\s*```\s*$", "", region.strip(),
   294	                       flags=re.IGNORECASE | re.DOTALL)
   295	        starts = [m.start() for m in re.finditer(r"\[", clean)]
   296	        if not starts and clean:
   297	            starts = [0]
   298	        for start in starts:
   299	            try:
   300	                obj, _ = decoder.raw_decode(clean[start:])
   301	            except (ValueError, TypeError):
   302	                continue
   303	            if isinstance(obj, list):
   304	                return obj
   305	    return None
   306	
