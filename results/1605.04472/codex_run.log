+    "hard": {
+        "n": 1024, "variables": 48, "coeff_bound": 100_000_000,
+        "mix_bound": 41,
+    },
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT: str = (
+    "Normalize one row for each distinguished square, then sum those rows to "
+    "solve first for the shared sum of all unknown basis constants."
+)
+PLACEBO_HINT: str = (
+    "Keep the variable indices and signs aligned carefully, then check every "
+    "reported constant against all of the supplied polynomial rows."
+)
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON array [a_1,...,a_k] of k pairwise-distinct integers in "
+        "1..B, denoting the monic reduced basis "
+        "{x_1^2-a_1,...,x_k^2-a_k}."
