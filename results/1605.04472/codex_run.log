   460	def _reference_gaussian(inst):
   461	    """Generic exact Gauss-Jordan solve of every expanded coefficient row."""
   462	    k = inst["variables"]
   463	    matrix = []
   464	    for u, lam, p, c in inst["rows"]:
   465	        row = [Fraction(u) for _ in range(k)]
