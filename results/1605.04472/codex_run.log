+    while len(result) < count:
+        value = rng.randrange(population)
+        if value not in chosen:
+            chosen.add(value)
+            result.append(value)
+    rng.shuffle(result)
+    return result
+
+
+def _basis_from_values(values):
+    return {"basis": [[_rat_to_json(-value), [1, 1]] for value in values]}
