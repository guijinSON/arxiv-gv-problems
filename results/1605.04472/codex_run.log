   308	def parse_answer(text) -> object | None:
   309	    """Extract the last tagged JSON array, tolerating prose and fences."""
   310	    try:
   311	        obj = _extract_json_array(text)
   312	        if obj is None or any(isinstance(x, bool) or not isinstance(x, int) for x in obj):
   313	            return None
   314	        return obj
   315	    except Exception:               # untrusted model output must never escape
   316	        return None
