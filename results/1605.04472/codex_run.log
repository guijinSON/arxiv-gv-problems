+    pre = [p for p in range(lo, first_end) if math.gcd(p, q) == 1]
+    if index < len(pre):
+        return pre[index]
+    index -= len(pre)
+    residues = _allowed_residues(q)
+    start = first_end
+    full = max(0, (hi - start + 1) // q)
