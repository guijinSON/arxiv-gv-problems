   411	def enumerate_all(inst) -> int | None:
   412	    """Brute-force small languages, with a hard 100,000-candidate cap."""
   413	    space = search_space(inst)
   414	    if space is None or space > 100_000:
   415	        return None
   416	    count = 0
   417	    for candidate in itertools.permutations(range(1, inst["coeff_bound"] + 1),
   418	                                            inst["variables"]):
   419	        if verify(inst, list(candidate))[0]:
   420	            count += 1
   421	    return count
