+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
+}
+
+NOTES = (
+    "Section 2 (Definition of the q-Fractional Groebner Basis Problem) fixes the "
+    "output and explicitly says q=1 is ordinary Groebner-basis computation. "
+    "Section 2, Theorem 2 proves robust NP-hardness for lexicographic order even "
+    "at degree 2 and at most three variables per input polynomial, but that is a "
+    "worst-case theorem and does not make this inverse-generated distribution "
+    "Track A. The same proof invokes exact successive elimination from a lex "
+    "basis, while the Introduction names Buchberger's algorithm as the standard "
+    "mechanical method. Here the certificate-producing algorithm is generic "
+    "exact Gaussian elimination on the coefficient matrix, in polynomial time, "
+    "so the family is honestly Track B. Generation samples distinct constants "
+    "a_j first, forms the known reduced basis b_j=x_j^2-a_j, and emits only "
+    "full-rank rank-one mixtures u_i*sum_j(b_j)+lambda_i*b_p. The local-outlier, "
+    "independent greedy, random-restart, and mean-sum ansatz attacks all use the "
+    "same bounded candidate language and fail; the disclosed elimination "
+    "reference succeeds, as Track B requires."
+)
+
+
+def _require_int(name, value, minimum=None):
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError(f"{name} must be an integer")
+    if minimum is not None and value < minimum:
+        raise ValueError(f"{name} must be at least {minimum}")
+
+
+def _validate_params(n, variables, coeff_bound, mix_bound):
+    _require_int("n", n, 1)
+    _require_int("variables", variables, 2)
+    _require_int("coeff_bound", coeff_bound, variables)
+    _require_int("mix_bound", mix_bound, 2)
+    if n < variables:
+        raise ValueError("n must be at least variables so every square is present")
+    if variables > 49:
+        raise ValueError("variables must be at most 49 to keep the 6*k route under 300 operations")
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate a q=1 Groebner instance and its reduced basis.
+
+    Let b_j=x_j^2-a_j and S_b=sum_j b_j.  Every emitted polynomial is
+    f_i=u_i*S_b+lambda_i*b_{p_i}.  One row for every p has positive u_i and
+    lambda_i, so the corresponding coefficient matrix is D+u*1^T and is
+    nonsingular by the matrix determinant lemma.  Thus <F>=<b_1,...,b_k>.
+    """
+    variables = params.get("variables", 32)
+    coeff_bound = params.get("coeff_bound", 1_000_000)
+    mix_bound = params.get("mix_bound", 19)
+    _validate_params(n, variables, coeff_bound, mix_bound)
+    _require_int("seed", seed)
+    rng = random.Random(seed)
+
+    # Sampling the certificate first is the generatability route.  Positive,
+    # distinct values are part of the public bounded certificate language.
+    answer = rng.sample(range(1, coeff_bound + 1), variables)
+    answer_sum = sum(answer)
+
+    # All rows for the same p are scalar multiples of one independently drawn
+    # archetype.  Hence redundant rows enlarge the generic elimination workload
+    # without leaking a two-row shortcut for S_b.  There is no distinguished
+    # "planted row": every emitted row is drawn by the same scaled-archetype rule.
+    archetypes = [
+        [rng.randint(1, mix_bound), rng.randint(1, mix_bound)]
+        for _ in range(variables)
+    ]
+    distinguished = list(range(variables))
+    distinguished.extend(rng.randrange(variables) for _ in range(n - variables))
+    rng.shuffle(distinguished)
+
+    rows = []
+    for p in distinguished:
+        base_u, base_lam = archetypes[p]
+        scale = rng.randint(1, mix_bound)
+        u = scale * base_u
+        lam = scale * base_lam
+        c = scale * (base_u * answer_sum + base_lam * answer[p])
+        rows.append([u, lam, p, c])
+
+    return {
+        "n": n,
+        "variables": variables,
+        "coeff_bound": coeff_bound,
+        "mix_bound": mix_bound,
+        "rows": rows,
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    """Render a self-contained native polynomial-ideal problem."""
+    k = inst["variables"]
+    variable_names = ",...,".join(("x1", f"x{k}")) if k > 2 else ",".join(
+        f"x{j}" for j in range(1, k + 1)
+    )
+    q2 = " + ".join(f"x{j}^2" for j in range(1, k + 1))
+    lines = [
+        "Compute a reduced lexicographic Groebner basis over Q.",
+        "",
+        "Definitions:",
+        "- Q is the field of rational numbers.",
+        f"- The polynomial ring is Q[{variable_names}] with lexicographic order "
+        + " > ".join(f"x{j}" for j in range(1, k + 1)) + ".",
+        "- For a nonzero polynomial, its leading monomial is its largest monomial "
+        "in that order.",
+        "- A finite set G is a Groebner basis of an ideal I when G generates I "
+        "and the leading monomials of G generate the leading-monomial ideal of I.",
+        "- It is reduced when every member is monic and no non-leading monomial "
+        "in one member is divisible by a leading monomial of another member.",
+        "",
+        f"Put Q2 = {q2}.",
+        "Each input row [u,lambda,p,c] denotes the polynomial",
+        "    u*Q2 + lambda*x_p^2 - c",
+        "where p is 1-indexed. The input ideal I is generated by every row's "
+        "polynomial. Row order has no meaning.",
+        "",
+        f"There are {len(inst['rows'])} rows and k={k}. All data are exact integers:",
+    ]
+    lines.extend(
+        f"{i}: [{u}, {lam}, {p + 1}, {c}]"
+        for i, (u, lam, p, c) in enumerate(inst["rows"], 1)
+    )
+    example = list(range(1, k + 1))
+    lines.extend([
+        "",
+        "It is guaranteed that the unique reduced basis has the form",
+        "    {x1^2-a_1, x2^2-a_2, ..., xk^2-a_k},",
+        f"where the a_j are pairwise-distinct integers in the inclusive range "
+        f"1..{inst['coeff_bound']}.",
+        "Return the constants in variable order as one JSON integer array of "
+        f"exactly {k} elements. Order matters and repeats are forbidden.",
+        "",
+        "Give your final answer inside <answer></answer> tags, as the JSON array.",
+        f"Example: <answer>{json.dumps(example, separators=(',', ':'))}</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def _extract_json_array(text):
+    if not isinstance(text, str):
+        return None
+    tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
+                        flags=re.IGNORECASE | re.DOTALL)
+    regions = tagged[::-1] if tagged else [text]
+    decoder = json.JSONDecoder()
+    for region in regions:
+        clean = re.sub(r"^\s*```(?:json)?\s*|\s*```\s*$", "", region.strip(),
+                       flags=re.IGNORECASE | re.DOTALL)
+        starts = [m.start() for m in re.finditer(r"\[", clean)]
+        if not starts and clean:
+            starts = [0]
+        for start in starts:
+            try:
+                obj, _ = decoder.raw_decode(clean[start:])
+            except (ValueError, TypeError):
+                continue
+            if isinstance(obj, list):
+                return obj
+    return None
+
+
+def parse_answer(text) -> object | None:
+    """Extract the last tagged JSON array, tolerating prose and fences."""
+    try:
+        obj = _extract_json_array(text)
+        if obj is None or any(isinstance(x, bool) or not isinstance(x, int) for x in obj):
+            return None
+        return obj
+    except Exception:               # untrusted model output must never escape
+        return None
+
+
+def _matrix_rank_q(matrix):
+    """Exact rational rank by ordinary elimination; used only after remainders vanish."""
+    if not matrix:
+        return 0
+    a = [[Fraction(x) for x in row] for row in matrix]
+    m, n = len(a), len(a[0])
+    rank = 0
+    for col in range(n):
+        pivot = next((r for r in range(rank, m) if a[r][col]), None)
+        if pivot is None:
+            continue
+        a[rank], a[pivot] = a[pivot], a[rank]
+        pv = a[rank][col]
+        for j in range(col, n):
+            a[rank][j] /= pv
+        for r in range(rank + 1, m):
+            factor = a[r][col]
+            if factor:
+                for j in range(col, n):
+                    a[r][j] -= factor * a[rank][j]
+        rank += 1
+        if rank == m:
+            break
+    return rank
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check the claimed reduced basis exactly, without reading inst['answer'].
+
+    Reducing u*Q2+lambda*x_p^2-c by x_j^2-a_j leaves the
+    constant u*sum(a_j)+lambda*a_p-c.  Vanishing of all such remainders proves
+    <F> is contained in <G>.  Full coefficient rank proves the reverse
+    containment.  Pairwise-coprime leading monomials make every S-polynomial
+    reduce to zero, which is Buchberger's criterion.
+    """
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON integer array"
+    if len(answer) == 0:
+        return False, "answer array is empty"
+    k = inst.get("variables")
+    if len(answer) != k:
+        return False, f"wrong length: expected {k} constants"
+    if any(isinstance(a, bool) or not isinstance(a, int) for a in answer):
+        return False, "every basis constant must be an integer"
+    bound = inst.get("coeff_bound")
+    if any(a < 1 or a > bound for a in answer):
+        return False, f"basis constant outside the inclusive range 1..{bound}"
+    if len(set(answer)) != k:
+        return False, "basis constants must be pairwise distinct"
+
+    total = sum(answer)
+    rows = inst.get("rows")
+    if not isinstance(rows, list):
+        return False, "instance rows are malformed"
+    coefficient_rows = []
+    for i, row in enumerate(rows, 1):
+        if (not isinstance(row, list) or len(row) != 4
+                or any(isinstance(x, bool) or not isinstance(x, int) for x in row)):
+            return False, f"instance row {i} is malformed"
+        u, lam, p, c = row
+        if not 0 <= p < k:
+            return False, f"instance row {i} has an invalid variable index"
+        remainder = u * total + lam * answer[p] - c
+        if remainder != 0:
+            return False, f"input polynomial {i} has nonzero exact remainder {remainder}"
+        coeffs = [u] * k
+        coeffs[p] += lam
+        coefficient_rows.append(coeffs)
+
+    # Executable Buchberger check: for i!=j the S-polynomial of
+    # x_i^2-a_i and x_j^2-a_j reduces to a_j*a_i-a_i*a_j.
+    for i in range(k):
+        for j in range(i + 1, k):
+            if answer[j] * answer[i] - answer[i] * answer[j] != 0:
+                return False, f"S-polynomial ({i + 1},{j + 1}) did not reduce to zero"
+
+    if _matrix_rank_q(coefficient_rows) != k:
+        return False, "input generators do not have full exact coefficient rank"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample the stated distinct bounded coefficient language."""
+    return rng.sample(range(1, inst["coeff_bound"] + 1), inst["variables"])
+
+
+def search_space(inst) -> int | None:
+    """Number of ordered, pairwise-distinct arrays in the language: B!/(B-k)!."""
+    b, k = inst["coeff_bound"], inst["variables"]
+    return math.prod(range(b - k + 1, b + 1))
+
+
+def enumerate_all(inst) -> int | None:
+    """Brute-force small languages, with a hard 100,000-candidate cap."""
+    space = search_space(inst)
+    if space is None or space > 100_000:
+        return None
+    count = 0
+    for candidate in itertools.permutations(range(1, inst["coeff_bound"] + 1),
+                                            inst["variables"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def canonical_key(inst) -> str:
+    """Invariant under generator reordering and arbitrary variable renaming.
+
+    Rows distinguished by the same variable are grouped; row triples (u,lambda,c)
+    are sorted within groups, then the groups themselves are sorted.  Variable
+    labels and row positions therefore disappear, while all public coefficients
+    remain in the invariant.
+    """
+    k = inst["variables"]
+    groups = [[] for _ in range(k)]
+    for u, lam, p, c in inst["rows"]:
+        groups[p].append([u, lam, c])
+    normalized = sorted(sorted(group) for group in groups)
+    payload = {
+        "variables": k,
+        "coeff_bound": inst["coeff_bound"],
+        "groups": normalized,
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Grow redundant rows and coefficient entropy while fixing witness length."""
+    p = dict(params)
+    p["n"] = int(p.get("n", 512)) * 2
+    p["coeff_bound"] = int(p.get("coeff_bound", 1_000_000)) * 10
+    p["mix_bound"] = int(p.get("mix_bound", 19)) + 12
+    p["variables"] = min(49, int(p.get("variables", 32)))
+    return p
+
+
+# ---------------------------------------------------------------------------
+# Reference algorithm and construction-aware attacks used only by selftest.
+
+
+def _reference_gaussian(inst):
+    """Generic exact Gauss-Jordan solve of every expanded coefficient row."""
+    k = inst["variables"]
+    matrix = []
+    for u, lam, p, c in inst["rows"]:
+        row = [Fraction(u) for _ in range(k)]
+        row[p] += lam
+        row.append(Fraction(c))
+        matrix.append(row)
+
+    m = len(matrix)
+    pivot_row = 0
+    pivot_for_col = {}
+    operations = 0
+    for col in range(k):
+        pivot = next((r for r in range(pivot_row, m) if matrix[r][col]), None)
+        if pivot is None:
+            continue
+        matrix[pivot_row], matrix[pivot] = matrix[pivot], matrix[pivot_row]
+        pv = matrix[pivot_row][col]
+        for j in range(col, k + 1):
+            matrix[pivot_row][j] /= pv
+            operations += 1
+        for r in range(m):
+            if r == pivot_row:
+                continue
+            factor = matrix[r][col]
+            if factor:
+                for j in range(col, k + 1):
+                    matrix[r][j] -= factor * matrix[pivot_row][j]
+                    operations += 2
+        pivot_for_col[col] = pivot_row
+        pivot_row += 1
+    if len(pivot_for_col) != k:
+        return None, operations
+    solution = []
+    for col in range(k):
+        value = matrix[pivot_for_col[col]][k]
+        if value.denominator != 1:
+            return None, operations
+        solution.append(value.numerator)
+    # Consistency checking is part of processing the full public instance.
+    for u, lam, p, c in inst["rows"]:
+        lhs = u * sum(solution) + lam * solution[p]
+        operations += k + 2
+        if lhs != c:
+            return None, operations
+    return solution, operations
+
+
+def _project_unique(values, bound):
+    """Turn heuristic scores into an in-language distinct ordered candidate."""
+    k = len(values)
+    order = sorted(range(k), key=lambda i: (values[i], i))
+    out = [0] * k
+    if k == 1:
+        return [max(1, min(bound, int(values[0])))]
+    for rank, index in enumerate(order):
+        out[index] = 1 + (rank * (bound - 1)) // (k - 1)
+    return out
+
+
+def _rows_by_variable(inst):
+    groups = [[] for _ in range(inst["variables"])]
+    for row in inst["rows"]:
+        groups[row[2]].append(row)
+    return groups
+
+
+def _attack_local_outlier(inst):
+    values = []
+    for rows in _rows_by_variable(inst):
+        row = min(rows, key=lambda r: (Fraction(r[0], r[1]), abs(r[3])))
+        values.append(Fraction(row[3], row[1]))
+    return _project_unique(values, inst["coeff_bound"])
+
+
+def _attack_greedy_median(inst):
+    values = []
+    for rows in _rows_by_variable(inst):
+        local = sorted(Fraction(c, lam) for u, lam, p, c in rows)
+        values.append(local[len(local) // 2])
+    return _project_unique(values, inst["coeff_bound"])
+
+
+def _attack_zero_shared_sum(inst):
+    values = []
+    for rows in _rows_by_variable(inst):
+        u, lam, p, c = rows[0]
+        values.append(Fraction(c, lam))
+    return _project_unique(values, inst["coeff_bound"])
+
+
+def _attack_mean_sum(inst):
+    guessed_sum = Fraction(inst["variables"] * (inst["coeff_bound"] + 1), 2)
+    values = []
+    for rows in _rows_by_variable(inst):
+        u, lam, p, c = rows[0]
+        values.append(Fraction(c - u * guessed_sum, lam))
+    return _project_unique(values, inst["coeff_bound"])
+
+
+def _relabel_instance(inst, old_to_new, reorder=False):
+    k = inst["variables"]
+    new_rows = [[u, lam, old_to_new[p], c] for u, lam, p, c in inst["rows"]]
+    if reorder:
+        new_rows.reverse()
+    out = {key: value for key, value in inst.items() if key not in ("rows", "answer")}
+    out["rows"] = new_rows
+    carried = [0] * k
+    for old, new in enumerate(old_to_new):
+        carried[new] = inst["answer"][old]
+    out["answer"] = carried
+    return out
+
+
+def _answer_metrics(answer):
+    encoded = json.dumps(answer, separators=(",", ":"))
+    return len(encoded), math.ceil(len(encoded) / 4), len(answer)
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return a JSON-native evidence report."""
+    report = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+
+    # G1: every preset, several independent seeds.
+    g1_checks = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_checks += 1
+            if not ok:
+                g1_failures.append([preset, seed, why])
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append([preset, seed, "answer is not JSON-native"])
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures, "checks": g1_checks, "failures": g1_failures,
+    }
+
+    # G2: five corruption classes with distinct rejection diagnostics.
+    inst = make_instance(seed=12345, **shipping_params)
+    planted = inst["answer"]
+    corruptions = {
+        "drop": planted[:-1],
+        "swap": [planted[1], planted[0]] + planted[2:],
+        "duplicate": planted[:-1] + [planted[0]],
+        "empty": [],
+        "out_of_range": [inst["coeff_bound"] + 1] + planted[1:],
+    }
+    rejected = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        rejected[name] = {"rejected": not ok, "reason": why}
+    reasons = [entry["reason"] for entry in rejected.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(v["rejected"] for v in rejected.values())
+        and len(set(reasons)) == len(reasons),
+        "corruptions": rejected,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    # G3: realistic prose/fence response and direct JSON round trip.
+    body = json.dumps(planted, separators=(",", ":"))
+    realistic = "I used the shared-square invariant.\n```json\n<answer>" + body \
+        + "</answer>\n```\n"
+    parsed = parse_answer(realistic)
+    malformed = parse_answer("prose only; no array here")
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and malformed is None,
+        "realistic_response_parsed": parsed == planted,
+        "garbage_returns_none": malformed is None,
+    }
+
+    # G4/G5 density: structure-aware samples already obey bounds, length, and
+    # distinctness.  Verification almost always exits on the first polynomial.
+    guess_rng = random.Random(0x160504472)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            guess_hits += 1
+    guess_probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_probability,
+        "candidate_space": search_space(inst),
+        "sampler": "uniform ordered sample without replacement from 1..B",
+    }
+
+    # G6: four failed in-context attacks and the intentionally successful
+    # polynomial-time reference algorithm in its Track-B-only sibling field.
+    attack_fns = {
+        "outlier_minimum_mixing": _attack_local_outlier,
+        "greedy_independent_medians": _attack_greedy_median,
+        "random_restart_256": None,
+        "by_hand_mean_sum_ansatz": _attack_mean_sum,
+        "obvious_zero_shared_sum": _attack_zero_shared_sum,
+    }
+    attack_results = {name: {"successes": 0, "attempts": 8}
+                      for name in attack_fns}
+    ref_successes = 0
+    ref_times = []
+    ref_operations = []
+    for seed in range(800, 808):
+        attack_inst = make_instance(seed=seed, **shipping_params)
+        for name, fn in attack_fns.items():
+            if fn is None:
+                solved = False
+                rr = random.Random(seed ^ 0xA55A)
+                for _ in range(256):
+                    if verify(attack_inst, random_candidate(attack_inst, rr))[0]:
+                        solved = True
+                        break
+            else:
+                solved = verify(attack_inst, fn(attack_inst))[0]
+            attack_results[name]["successes"] += int(solved)
+        t0 = time.perf_counter()
+        recovered, operations = _reference_gaussian(attack_inst)
+        elapsed = time.perf_counter() - t0
+        ref_times.append(elapsed)
+        ref_operations.append(operations)
+        ref_successes += int(recovered is not None and verify(attack_inst, recovered)[0])
+    all_failed = all(v["successes"] == 0 for v in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and ref_successes == 8,
+        "attacks": attack_results,
+        "reference_algorithm": {
+            "name": "exact Gauss-Jordan elimination on the expanded coefficient matrix",
+            "complexity": "O(n*k^2+k^3) exact rational operations",
+            "wall_clock_sec_mean": sum(ref_times) / len(ref_times),
+            "wall_clock_sec_max": max(ref_times),
+            "operations_mean": sum(ref_operations) // len(ref_operations),
+            "operations_max": max(ref_operations),
+            "attempts": 8,
+            "successes": ref_successes,
+            "solves": f"{ref_successes}/8, as expected for Track B",
+        },
+    }
+
+    report["G5_density_and_baseline"] = {
+        "pass": guess_total >= 200_000 and guess_probability < 1e-6
+        and ref_successes == 8,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_density_estimate": guess_probability,
+        "known_solution_count": 1,
+        "shipping_candidate_space": search_space(inst),
+        "baseline_wall_seconds_mean": sum(ref_times) / len(ref_times),
+        "baseline_exact_operations_mean": sum(ref_operations) // len(ref_operations),
+        "baseline_iterations": inst["variables"],
+    }
+
+    # G7: double only the haystack and measure reference work on the larger
+    # instance; the certificate has exactly the same number of atoms.
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=77, **doubled_params)
+    t0 = time.perf_counter()
+    doubled_answer, doubled_operations = _reference_gaussian(doubled)
+    doubled_time = time.perf_counter() - t0
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled_answer is not None
+        and doubled_operations > (sum(ref_operations) / len(ref_operations))
+        and len(doubled["answer"]) == len(planted),
+        "shipping_rows": shipping_params["n"],
+        "doubled_rows": doubled_params["n"],
+        "answer_elements_shipping": len(planted),
+        "answer_elements_doubled": len(doubled["answer"]),
+        "doubled_reference_operations": doubled_operations,
+        "doubled_reference_wall_seconds": doubled_time,
+        "planted_verifies": doubled_ok,
+    }
+
+    # G8: row permutations, variable permutations, and their composition over
+    # twenty seeds, plus carried-witness validation and unrelated distinctness.
+    invariant_checks = 0
+    transformation_checks = 0
+    keys = []
+    g8_ok = True
+    for seed in range(20):
+        base = make_instance(seed=2000 + seed, **shipping_params)
+        key = canonical_key(base)
+        keys.append(key)
+        perm = list(range(base["variables"]))
+        random.Random(9000 + seed).shuffle(perm)
+        row_only = _relabel_instance(base, list(range(base["variables"])), True)
+        variable_only = _relabel_instance(base, perm, False)
+        composed = _relabel_instance(base, perm, True)
+        for transformed in (row_only, variable_only, composed):
+            invariant_checks += 1
+            transformation_checks += 1
+            g8_ok &= canonical_key(transformed) == key
+            g8_ok &= verify(transformed, transformed["answer"])[0]
+    distinct = len(set(keys))
+    report["G8_canonical_key"] = {
+        "pass": bool(g8_ok and distinct == 20),
+        "invariance_checks": invariant_checks,
+        "real_transformation_witness_checks": transformation_checks,
+        "distinct_unrelated_keys": distinct,
+        "unrelated_instances": 20,
+        "transformations": [
+            "generator-row permutation", "variable renaming",
+            "composed variable and row permutation",
+        ],
+    }
+
+    # G9(a) is recorded; (b) and (c) are gated.  The provisional pending oracle
+    # value keeps this gate false until the script-owned arms have really run.
+    metric_samples = [
+        _answer_metrics(make_instance(seed=s, **shipping_params)["answer"])
+        for s in range(20)
+    ]
+    answer_chars = max(x[0] for x in metric_samples)
+    answer_tokens = max(x[1] for x in metric_samples)
+    answer_elements = max(x[2] for x in metric_samples)
+    intended_ops = 6 * shipping_params["variables"]
+    hinted_hardened = G9_ORACLE_RESULTS["hinted_verdict"] == "hardened"
+    within_caps = (answer_chars <= 2000 and answer_elements <= 256
+                   and intended_ops <= 300)
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_hardened and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "within_caps": within_caps,
+    }
+
+    gate_values = [v for key, v in report.items() if key.startswith("G")]
+    report["all_passed"] = all(v.get("pass") is True for v in gate_values)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

