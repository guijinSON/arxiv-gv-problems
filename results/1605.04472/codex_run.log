-
-    doubled_params = dict(shipping_params)
-    doubled_params["n"] *= 2
-    doubled = make_instance(seed=77, **doubled_params)
-    doubled_answer, doubled_operations = _reference_gaussian(doubled)
-    doubled_ok = verify(doubled, doubled["answer"])[0]
-    report["G7_scales"] = {
