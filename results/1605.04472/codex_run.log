   446	def escalate(params) -> dict | str | None:
   447	    """Grow redundant rows and coefficient entropy while fixing witness length."""
   448	    p = dict(params)
   449	    p["n"] = int(p.get("n", 512)) * 2
   450	    p["coeff_bound"] = int(p.get("coeff_bound", 1_000_000)) * 10
   451	    p["mix_bound"] = int(p.get("mix_bound", 19)) + 12
   452	    p["variables"] = min(49, int(p.get("variables", 32)))
   453	    return p
