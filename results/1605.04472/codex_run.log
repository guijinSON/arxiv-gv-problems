+def verify(inst, answer) -> tuple[bool, str]:
+    """Check the claimed reduced basis exactly, without reading inst['answer'].
+
+    Reducing u*Q2+lambda*x_p^2-c by x_j^2-a_j leaves the
+    constant u*sum(a_j)+lambda*a_p-c.  Vanishing of all such remainders proves
+    <F> is contained in <G>.  Full coefficient rank proves the reverse
+    containment.  Pairwise-coprime leading monomials make every S-polynomial
+    reduce to zero, which is Buchberger's criterion.
+    """
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON integer array"
+    if len(answer) == 0:
+        return False, "answer array is empty"
+    k = inst.get("variables")
+    if len(answer) != k:
+        return False, f"wrong length: expected {k} constants"
+    if any(isinstance(a, bool) or not isinstance(a, int) for a in answer):
+        return False, "every basis constant must be an integer"
+    bound = inst.get("coeff_bound")
+    if any(a < 1 or a > bound for a in answer):
+        return False, f"basis constant outside the inclusive range 1..{bound}"
+    if len(set(answer)) != k:
+        return False, "basis constants must be pairwise distinct"
+
+    total = sum(answer)
+    rows = inst.get("rows")
+    if not isinstance(rows, list):
+        return False, "instance rows are malformed"
+    coefficient_rows = []
+    for i, row in enumerate(rows, 1):
+        if (not isinstance(row, list) or len(row) != 4
+                or any(isinstance(x, bool) or not isinstance(x, int) for x in row)):
+            return False, f"instance row {i} is malformed"
+        u, lam, p, c = row
+        if not 0 <= p < k:
+            return False, f"instance row {i} has an invalid variable index"
+        remainder = u * total + lam * answer[p] - c
+        if remainder != 0:
+            return False, f"input polynomial {i} has nonzero exact remainder {remainder}"
+        coeffs = [u] * k
+        coeffs[p] += lam
+        coefficient_rows.append(coeffs)
+
+    # Executable Buchberger check: for i!=j the S-polynomial of
+    # x_i^2-a_i and x_j^2-a_j reduces to a_j*a_i-a_i*a_j.
+    for i in range(k):
+        for j in range(i + 1, k):
+            if answer[j] * answer[i] - answer[i] * answer[j] != 0:
+                return False, f"S-polynomial ({i + 1},{j + 1}) did not reduce to zero"
+
+    if _matrix_rank_q(coefficient_rows) != k:
+        return False, "input generators do not have full exact coefficient rank"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample the stated distinct bounded coefficient language."""
+    return rng.sample(range(1, inst["coeff_bound"] + 1), inst["variables"])
+
+
+def search_space(inst) -> int | None:
+    """Number of ordered, pairwise-distinct arrays in the language: B!/(B-k)!."""
+    b, k = inst["coeff_bound"], inst["variables"]
+    return math.prod(range(b - k + 1, b + 1))
+
+
+def enumerate_all(inst) -> int | None:
+    """Brute-force small languages, with a hard 100,000-candidate cap."""
+    space = search_space(inst)
+    if space is None or space > 100_000:
+        return None
+    count = 0
+    for candidate in itertools.permutations(range(1, inst["coeff_bound"] + 1),
+                                            inst["variables"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def canonical_key(inst) -> str:
+    """Invariant under generator reordering and arbitrary variable renaming.
+
+    Rows distinguished by the same variable are grouped; row triples (u,lambda,c)
+    are sorted within groups, then the groups themselves are sorted.  Variable
+    labels and row positions therefore disappear, while all public coefficients
+    remain in the invariant.
+    """
+    k = inst["variables"]
+    groups = [[] for _ in range(k)]
+    for u, lam, p, c in inst["rows"]:
+        groups[p].append([u, lam, c])
+    normalized = sorted(sorted(group) for group in groups)
+    payload = {
+        "variables": k,
+        "coeff_bound": inst["coeff_bound"],
+        "groups": normalized,
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Grow redundant rows and coefficient entropy while fixing witness length."""
+    p = dict(params)
+    p["n"] = int(p.get("n", 512)) * 2
+    p["coeff_bound"] = int(p.get("coeff_bound", 1_000_000)) * 10
+    p["mix_bound"] = int(p.get("mix_bound", 19)) + 12
+    p["variables"] = min(49, int(p.get("variables", 32)))
