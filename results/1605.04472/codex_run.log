-def _language_descriptor(n, q):
-    key = (n, q)
-    if key in _LANGUAGE_CACHE:
-        return _LANGUAGE_CACHE[key]
-    lo, hi = _bounds(n)
-    first_end = min(hi + 1, (lo // q + 1) * q)
-    pre = [p for p in range(lo, first_end) if math.gcd(p, q) == 1]
