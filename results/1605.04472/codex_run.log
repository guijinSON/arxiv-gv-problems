-def _answer_metrics(answer):
-    encoded = json.dumps(answer, separators=(",", ":"))
-    basis = answer.get("basis", []) if isinstance(answer, dict) else []
-    return len(encoded), math.ceil(len(encoded) / 4), 2 * len(basis)
