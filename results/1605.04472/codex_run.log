+def _bounds(n):
+    return 1 << (n - 1), (1 << n) - 1
+
+
+def _allowed_residues(q):
+    return [r for r in range(q) if math.gcd(r, q) == 1]
+
+
+def _count_for_denominator(n, q):
+    lo, hi = _bounds(n)
+    first_end = min(hi + 1, (lo // q + 1) * q)
+    pre = sum(math.gcd(p, q) == 1 for p in range(lo, first_end))
+    start = first_end
+    full = max(0, (hi - start + 1) // q)
+    tail_start = start + full * q
+    tail = sum(math.gcd(p, q) == 1 for p in range(tail_start, hi + 1))
+    return pre + full * len(_allowed_residues(q)) + tail
 
 
+def _language_size_raw(n, denominators):
+    return sum(_count_for_denominator(n, q) for q in denominators)
