+def escalate(params) -> dict | str | None:
+    """Raise coefficient bit complexity while keeping the 32-polynomial answer fixed."""
+    p = dict(params)
+    next_n = int(p.get("n", 64)) + 16
+    if next_n > 128:
+        return "cap_bound"
+    p["n"] = next_n
+    p["mix_bits"] = int(p.get("mix_bits", 10)) + 2
+    return p
 
 
