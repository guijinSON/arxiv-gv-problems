def _require_int(name, value, minimum=None):
    if isinstance(value, bool) or not isinstance(value, int):
        raise ValueError(f"{name} must be an integer")
    if minimum is not None and value < minimum:
        raise ValueError(f"{name} must be at least {minimum}")


def _validate_params(n, variables, coeff_bound, mix_bound):
    _require_int("n", n, 1)
    _require_int("variables", variables, 2)
    _require_int("coeff_bound", coeff_bound, variables)
    _require_int("mix_bound", mix_bound, 2)
    if n < variables:
        raise ValueError("n must be at least variables so every square is present")
    if variables > 49:
        raise ValueError("variables must be at most 49 to keep the 6*k route under 300 operations")


def make_instance(n, seed=0, **params) -> dict:
    """Inverse-generate a q=1 Groebner instance and its reduced basis.

    Let b_j=x_j^2-a_j and S_b=sum_j b_j.  Every emitted polynomial is
    f_i=u_i*S_b+lambda_i*b_{p_i}.  One row for every p has positive u_i and
    lambda_i, so the corresponding coefficient matrix is D+u*1^T and is
    nonsingular by the matrix determinant lemma.  Thus <F>=<b_1,...,b_k>.
    """
    variables = params.get("variables", 32)
    coeff_bound = params.get("coeff_bound", 1_000_000)
    mix_bound = params.get("mix_bound", 19)
    _validate_params(n, variables, coeff_bound, mix_bound)
    _require_int("seed", seed)
    rng = random.Random(seed)

    # Sampling the certificate first is the generatability route.  Positive,
    # distinct values are part of the public bounded certificate language.
    answer = rng.sample(range(1, coeff_bound + 1), variables)
    answer_sum = sum(answer)

    # All rows for the same p are scalar multiples of one independently drawn
    # archetype.  Hence redundant rows enlarge the generic elimination workload
    # without leaking a two-row shortcut for S_b.  There is no distinguished
    # "planted row": every emitted row is drawn by the same scaled-archetype rule.
    archetypes = [
        [rng.randint(1, mix_bound), rng.randint(1, mix_bound)]
        for _ in range(variables)
    ]
    distinguished = list(range(variables))
    distinguished.extend(rng.randrange(variables) for _ in range(n - variables))
    rng.shuffle(distinguished)

    rows = []
    for p in distinguished:
        base_u, base_lam = archetypes[p]
        scale = rng.randint(1, mix_bound)
        u = scale * base_u
        lam = scale * base_lam
        c = scale * (base_u * answer_sum + base_lam * answer[p])
        rows.append([u, lam, p, c])

    return {
        "n": n,
        "variables": variables,
        "coeff_bound": coeff_bound,
        "mix_bound": mix_bound,
        "rows": rows,
        "answer": answer,
    }


def render(inst) -> str:
    """Render a self-contained native polynomial-ideal problem."""
    k = inst["variables"]
    variable_names = ",...,".join(("x1", f"x{k}")) if k > 2 else ",".join(
        f"x{j}" for j in range(1, k + 1)
    )
    q2 = " + ".join(f"x{j}^2" for j in range(1, k + 1))
    lines = [
        "Compute a reduced lexicographic Groebner basis over Q.",
        "",
        "Definitions:",
        "- Q is the field of rational numbers.",
        f"- The polynomial ring is Q[{variable_names}] with lexicographic order "
        + " > ".join(f"x{j}" for j in range(1, k + 1)) + ".",
        "- For a nonzero polynomial, its leading monomial is its largest monomial "
        "in that order.",
        "- A finite set G is a Groebner basis of an ideal I when G generates I "
        "and the leading monomials of G generate the leading-monomial ideal of I.",
        "- It is reduced when every member is monic and no non-leading monomial "
        "in one member is divisible by a leading monomial of another member.",
        "",
        f"Put Q2 = {q2}.",
        "Each input row [u,lambda,p,c] denotes the polynomial",
        "    u*Q2 + lambda*x_p^2 - c",
        "where p is 1-indexed. The input ideal I is generated by every row's "
        "polynomial. Row order has no meaning.",
        "",
        f"There are {len(inst['rows'])} rows and k={k}. All data are exact integers:",
    ]
    lines.extend(
        f"{i}: [{u}, {lam}, {p + 1}, {c}]"
        for i, (u, lam, p, c) in enumerate(inst["rows"], 1)
    )
    example = list(range(1, k + 1))
    lines.extend([
        "",
        "It is guaranteed that the unique reduced basis has the form",
        "    {x1^2-a_1, x2^2-a_2, ..., xk^2-a_k},",
        f"where the a_j are pairwise-distinct integers in the inclusive range "
        f"1..{inst['coeff_bound']}.",
        "Return the constants in variable order as one JSON integer array of "
        f"exactly {k} elements. Order matters and repeats are forbidden.",
        "",
        "Give your final answer inside <answer></answer> tags, as the JSON array.",
        f"Example: <answer>{json.dumps(example, separators=(',', ':'))}</answer>",
        "Output nothing else inside the tags.",
    ])
    mode = os.environ.get("GV_HINT_MODE")
    if mode == "structural":
        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
    elif mode == "placebo":
        lines.extend(["", "Hint: " + PLACEBO_HINT])
    return "\n".join(lines)


def _extract_json_array(text):
    if not isinstance(text, str):
        return None
    tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
                        flags=re.IGNORECASE | re.DOTALL)
    regions = tagged[::-1] if tagged else [text]
    decoder = json.JSONDecoder()
    for region in regions:
        clean = re.sub(r"^\s*```(?:json)?\s*|\s*```\s*$", "", region.strip(),
                       flags=re.IGNORECASE | re.DOTALL)
        starts = [m.start() for m in re.finditer(r"\[", clean)]
        if not starts and clean:
            starts = [0]
        for start in starts:
            try:
                obj, _ = decoder.raw_decode(clean[start:])
            except (ValueError, TypeError):
                continue
            if isinstance(obj, list):
                return obj
    return None


def parse_answer(text) -> object | None:
    """Extract the last tagged JSON array, tolerating prose and fences."""
    try:
        obj = _extract_json_array(text)
        if obj is None or any(isinstance(x, bool) or not isinstance(x, int) for x in obj):
            return None
        return obj
    except Exception:               # untrusted model output must never escape
        return None


def _matrix_rank_q(matrix):
    """Exact rational rank by ordinary elimination; used only after remainders vanish."""

