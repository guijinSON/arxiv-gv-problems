+        "Buchberger S-polynomial criterion",
+        "exact rational coefficient-matrix rank",
+        "integer comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
