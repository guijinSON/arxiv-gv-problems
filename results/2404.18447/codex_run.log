+            "coeff": _basis_transform_tensor(clause["coeff"], local_inv, p),
+        })
+    answer = [_apply_gl2(matrices[v], q, p) for v, q in enumerate(inst["answer"])]
+    return {"n": inst["n"], "m": inst["m"], "k": 3, "p": p,
+            "clauses": clauses, "answer": answer}
+
+
