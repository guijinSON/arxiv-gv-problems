_ANSWER_RE = re.compile(r"<answer(?:\s[^>]*)?>(.*?)</answer\s*>", re.I | re.S)


def parse_answer(text: str) -> object | None:
    """Extract the last tagged JSON answer, tolerating prose and fences."""
    if not isinstance(text, str):
