+    "base_n": 12,
+    "base_search_bits": 44,
+    "doubled_n": 24,
+    "doubled_search_bits": 87,
+    "doubled_verify_reason": "ok",
+    "pass": true
+  },
+  "G8_canonical_key": {
+    "errors": [],
+    "invariance_checks": 80,
+    "key_caveat": "strong invariant, not complete tensor-network canonization",
+    "pass": true,
+    "real_transform_checks": 80,
+    "transformations": [
+      "clause reorder",
+      "variable and tensor-axis relabelling",
+      "independent local GL(2,p) basis changes",
+      "all composed"
+    ],
+    "unrelated_distinct": 20,
