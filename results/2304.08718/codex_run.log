+    s = 0
+    while d % 2 == 0:
+        d //= 2
+        s += 1
+    for base in _MR64_BASES:
+        if base % n == 0:
+            continue
+        value = pow(base, d, n)
+        if value in (1, n - 1):
+            continue
+        for _ in range(s - 1):
+            value = value * value % n
+            if value == n - 1:
+                break
+        else:
+            return False
+    return True
