+)
+PLACEBO_HINT = (
+    "Hint: The two requested prime divisors should be copied in displayed order "
+    "with all decimal digits intact."
+)
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON array [d1,d2]; di is a positive prime of the exact bit length "
