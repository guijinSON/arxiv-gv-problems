+    if not 5 <= bits <= 39:
+        raise ValueError("small_factor_bits must lie in 5..39")
+    top_translation = 1 << (bits - 2)
+    lower_r = top_translation
+    r_span = top_translation
+    for _ in range(max(50_000, bits * bits * 400)):
+        r = lower_r + rng.randrange(r_span)
