+def _uniform_prime_with_bits(bits: int, rng: random.Random) -> int:
+    """Uniform prime from the exact bit interval, by rejection sampling."""
+
+    if bits <= 25:
+        return rng.choice(_primes_with_bits(bits))
+    if bits not in _PRIME_INTERVAL_COUNTS:
