+# keep the two-number answer and its 22/23-bit factors fixed while enlarging the
+# large-factor haystack.
+DIFFICULTY = {
+    "demo": {"n": 12, "small_factor_bits": 3},
+    "easy": {"n": 200, "small_factor_bits": 22},
+    "medium": {"n": 300, "small_factor_bits": 22},
+    "hard": {"n": 400, "small_factor_bits": 22},
+}
