+    rng = random.Random(seed)
+    stats = {"prime_candidates": 0, "safe_candidates": 0}
+
+    if n == 12 and small_factor_bits == 3:
+        # 281 and 5 are Sophie Germain primes.  This is the paper-scale demo:
+        # N_A=281*11=3091, N_B=563*5=2815, both exactly 12 bits.
+        p, p_partner = 281, 563
+        r, r_partner = 5, 11
+        certificates = [
+            {"kind": "trial", "n": p},
+            {"kind": "trial", "n": p_partner},
+            {"kind": "trial", "n": r},
+            {"kind": "trial", "n": r_partner},
+        ]
+    else:
+        found = None
+        for _ in range(32):
+            p, p_partner, p_certificate, pp_certificate = _generate_safe_pair(
+                large_bits, rng, stats
+            )
+            # Resample only the cheap small pair until both cross-products have
+            # exactly n bits.  The endpoint exclusion makes the deliberately
+            # cheap boundary guesses in the adversary panel deterministic misses.
+            for _ in range(512):
+                r, r_partner, r_certificate, rp_certificate = _generate_safe_pair(
+                    small_factor_bits, rng, stats
+                )
+                lower = (1 << (small_factor_bits - 1)) | 1
+                rank = (r - lower) // 2
+                total_odds = 1 << (small_factor_bits - 2)
+                if rank < 8192 or rank >= total_odds - 8192:
+                    continue
+                n_a = p * r_partner
+                n_b = p_partner * r
+                if n_a.bit_length() == n and n_b.bit_length() == n:
+                    found = (
+                        p,
+                        p_partner,
+                        r,
+                        r_partner,
+                        [
+                            p_certificate,
+                            pp_certificate,
+                            r_certificate,
+                            rp_certificate,
+                        ],
+                    )
+                    break
+            if found is not None:
+                break
+        if found is None:
+            raise RuntimeError("could not make two exact-n-bit GIFP moduli")
+        p, p_partner, r, r_partner, certificates = found
