+    "easy": {"n": 200, "small_factor_bits": 22},
+    "medium": {"n": 300, "small_factor_bits": 22},
+    "hard": {"n": 400, "small_factor_bits": 22},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+
+STRUCTURAL_HINT = (
+    "Hint: The two hidden factor pairs are compatible with reciprocal one-bit "
