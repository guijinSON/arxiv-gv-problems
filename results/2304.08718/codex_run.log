+    if n.bit_length() <= _BASE_TRIAL_BITS:
+        return {"kind": "trial", "n": n} if _trial_is_prime(n) else None
+    if n < 1 << 64 and _mr64_is_prime(n):
+        return {"kind": "mr64", "n": n, "bases": list(_MR64_BASES)}
+    return None
