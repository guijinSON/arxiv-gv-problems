+    changed = list(answer)
+    changed[0] ^= 1
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": swapped,
+        "duplicate": answer + [answer[-1]],
+        "empty": [],
+        "out_of_range": answer[:4] + [2] + answer[5:],
+        "bit_flip": changed,
+    }
+    cases = {}
+    reasons = []
+    for name, candidate in corruptions.items():
