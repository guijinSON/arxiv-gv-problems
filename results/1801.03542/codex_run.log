+    "unrelated_attempts": 20,
+    "unrelated_distinct_keys": 20
+  },
+  "G9_no_tool_suitability": {
+    "answer_chars": 432,
+    "answer_elements": 144,
+    "answer_tokens": 108,
+    "arms": {
+      "bare": {"attempts": 15, "solved": 8},
+      "hinted": {"attempts": 0, "solved": 0},
+      "placebo": {"attempts": 0, "solved": 0}
+    },
+    "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    "hinted_minus_placebo": 0.0,
+    "hinted_verdict": "not_run",
+    "intended_route_operations": 216,
+    "pass": true
+  },
+  "all_passed": true
+}

diff --git a/REJECTED.md b/REJECTED.md
