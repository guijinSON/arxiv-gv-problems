+    outer_selector = {
+        "period": outer_period,
+        "stride": _coprime_stride(outer_period, rng),
+        "shift": rng.randrange(outer_period),
+        "runs": outer_runs,
+    }
+    local_selector = {
+        "period": local_period,
+        "stride": _coprime_stride(local_period, rng),
+        "shift": rng.randrange(local_period),
+        "runs": local_runs,
+    }
