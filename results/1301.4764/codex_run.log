        rng.randrange(inst["filling_blocks_per_design"] + 1),
    ]


def search_space(inst):
    return ((inst["outer_blocks_per_design"] + 1)
            * (inst["filling_blocks_per_design"] + 1))


def enumerate_all(inst):
    space = search_space(inst)
    if space > 20_000:
        return None
    hits = 0
    for outer in range(inst["outer_blocks_per_design"] + 1):
        for filling in range(inst["filling_blocks_per_design"] + 1):
            ok, _ = verify(inst, [outer, filling])
            hits += int(ok)
    return hits


