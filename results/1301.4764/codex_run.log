+_LOCAL_CYCLE_TEXT = (
+    ("id", "id"),
+    ("(0 1 2 3 4 5)", "(5 4 3 2 1 0)"),
+    ("(8 5)(a b)(3 7)(1 6)", "(8 6)(1 5)(a 3 b 7)"),
+    ("(7 b c 6)", "(8 5 6 7)"),
+    ("(4 7)(9 2)(1 8)", "(3 9 c)(1 8)"),
+    ("(3 7)(c 0 2)(1 6)(9 b)", "(9 4)(3 7)(0 2)(1 6)"),
+    ("(a b)(4 5)", "(a b)(c 8)"),
+)
