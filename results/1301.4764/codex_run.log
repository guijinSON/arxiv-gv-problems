+    (1, 2, 4, 10), (1, 5, 6, 8), (1, 7, 11, 12),
+    (2, 3, 5, 11), (2, 6, 7, 9), (3, 4, 6, 12),
+    (3, 7, 8, 10), (4, 8, 9, 11), (5, 9, 10, 12),
