+    inst = {
+        "family": "three-way S(2,4,v) intersection profile",
+        "n": n,
+        "q": q,
+        "u": u,
+        "master_blocks": master_blocks,
+        "v": v,
+        "total_blocks_per_design": total_blocks,
+        "outer_blocks_per_design": 16 * master_blocks,
+        "filling_blocks_per_design": 13 * u,
