+        other = [i for i in range(n) if i != pivot]
+        for raw in itertools.product(range(4), repeat=n - 1):
+            if not any(raw):
+                continue
+            base = [0] * n
+            for index, value in zip(other, raw):
+                base[index] = value
+            points = []
+            for scalar in range(4):
