+        "distinct_reasons": len(set(reasons)),
+    }
+
+    answer_text = f"{planted[0][0]}/1, {planted[1][0]}/1"
+    realistic = f"I used the GDD decomposition.\n```text\n<answer>{answer_text}</answer>\n```"
