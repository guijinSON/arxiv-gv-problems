+def _largest_divisor_at_most(number, cap):
+    if number <= 0:
+        return 1
+    cap = max(1, min(int(cap), number))
+    for candidate in range(cap, 0, -1):
+        if number % candidate == 0:
+            return candidate
+    return 1
