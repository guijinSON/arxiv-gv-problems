+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A length-two integer vector [outer, filling].  The outer count is in "
+        "[0,16m] and the filling count is in [0,13u], "
+        "where m and u are printed in the instance."
+    ),
+    "bounds": {
+        "components": 2,
+        "outer": "0..16m (instance-dependent finite bound)",
+        "filling": "0..13u (instance-dependent finite bound)",
+    },
+}
