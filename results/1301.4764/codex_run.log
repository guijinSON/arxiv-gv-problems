+    ("id", "id"),
+    ("(6 7 c)", "(6 c 7)"),
+    ("(0 1 2)(a e)", "(f b)(1 0 2)"),
+    ("(4 f)(d 7)(a 9 5)", "(7 c d)(f b 4)"),
