+)
+
+# The S(2,4,16) in Lemma 4.2; deleting parallel class _P16 gives
+# the 4-GDD of type 4^4 used in Lemma 4.5.
+_B16 = (
+    (0, 1, 2, 3), (0, 4, 5, 6), (0, 7, 8, 9), (0, 10, 11, 12),
+    (0, 13, 14, 15), (1, 4, 7, 10), (1, 5, 11, 13),
+    (1, 6, 8, 14), (1, 9, 12, 15), (2, 4, 12, 14),
