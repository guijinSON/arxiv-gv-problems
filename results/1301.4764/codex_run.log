+
+def _cycles(n, *cycles):
+    p = list(range(n))
+    for cyc in cycles:
+        if len(cyc) < 2:
+            continue
+        for a, b in zip(cyc, cyc[1:] + cyc[:1]):
+            p[a] = b
+    return tuple(p)
+
+
