+    outer_common = _weighted_catalog_sum(
+        outer_runs, _OUTER_COUNTS, master_blocks // outer_period
+    )
+    local_common = _weighted_catalog_sum(
+        local_runs, _LOCAL_COUNTS, u // local_period
+    )
+
