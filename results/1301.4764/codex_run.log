+    (0, 1, 2, 3),
+    (0, 2, 3, 1),
+    (0, 3, 1, 2),
+)
+
+
+def _cycles(n, *cycles):
+    p = list(range(n))
+    for cyc in cycles:
+        if len(cyc) < 2:
+            continue
+        for a, b in zip(cyc, cyc[1:] + cyc[:1]):
+            p[a] = b
+    return tuple(p)
+
+
+_ID13 = tuple(range(13))
+_ID16 = tuple(range(16))
