+    ),
+    "bounds": {
+        "components": 2,
+        "outer": "0..16m (instance-dependent finite bound)",
+        "filling": "0..13u (instance-dependent finite bound)",
+    },
+}
+
+DIFFICULTY = {
+    "demo": {"n": 1, "period_cap": 1},
+    "easy": {"n": 2, "period_cap": 15},
+    "medium": {"n": 4, "period_cap": 255},
+    "hard": {"n": 5, "period_cap": 600},
+}
