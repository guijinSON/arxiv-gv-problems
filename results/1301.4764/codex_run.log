+def verify(inst, answer):
+    """Verify any valid profile without consulting inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a two-component rational vector"
+    if len(answer) == 0:
+        return False, "the rational vector is empty"
+    if len(answer) == 1:
+        return False, "the filling component is missing"
+    if len(answer) > 2:
+        return False, "the rational vector has extra components"
+    names = ("outer", "filling")
+    limits = (inst["outer_blocks_per_design"], inst["filling_blocks_per_design"])
+    numerators = []
+    for index, (component, name, limit) in enumerate(zip(answer, names, limits)):
+        if not isinstance(component, list) or len(component) != 2:
+            return False, f"{name} component is not a numerator/denominator pair"
+        num, den = component
+        if isinstance(num, bool) or isinstance(den, bool) or not isinstance(num, int) or not isinstance(den, int):
+            return False, f"{name} rational entries must be integers"
+        if den != 1:
