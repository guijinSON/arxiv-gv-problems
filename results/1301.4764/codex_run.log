+
+def _catalog_counts(blocks, templates):
+    base = {tuple(sorted(b)) for b in blocks}
+    out = []
+    for triple in templates:
+        sets = [_image_blocks(blocks, p) for p in triple]
+        out.append(len(base.intersection(sets[1], sets[2])))
+    return tuple(out)
