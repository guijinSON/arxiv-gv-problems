+_ANSWER_TAG = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_RATIONAL_PAIR = re.compile(
+    r"^\s*([+-]?\d+)\s*/\s*([+-]?\d+)\s*,\s*"
+    r"([+-]?\d+)\s*/\s*([+-]?\d+)\s*$"
+)
+
+
+def parse_answer(text):
+    """Parse the delimited two-rational answer, returning None on any garbage."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_TAG.search(text)
+    if not match:
+        return None
+    body = match.group(1).strip()
+    rational = _RATIONAL_PAIR.fullmatch(body)
+    if rational:
+        values = [int(x) for x in rational.groups()]
+        return [[values[0], values[1]], [values[2], values[3]]]
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, list) else None
