+    report["G1_planted_verifies"] = {
+        "pass": not failures and small_ok and json_checks == planted_checks,
+        "checks": planted_checks,
+        "json_native_checks": json_checks,
+        "expanded_S_2_4_61_check": small_reason,
+        "failures": failures,
