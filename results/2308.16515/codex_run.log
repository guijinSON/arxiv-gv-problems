+    )
+    corruptions = {
+        "drop_one": [matrix[0], matrix[1][:-1]],
+        "swap_two": transpose,
+        "duplicate_row": [matrix[0], matrix[0]],
+        "empty": [],
+        "out_of_range": [[p, matrix[0][1]], matrix[1]],
+    }
+    corruption_reasons = {}
+    for name, candidate in corruptions.items():
