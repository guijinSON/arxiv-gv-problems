+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_counts = _enumerate_counts(demo)
+    demo_valid = sum(demo_counts) if demo_counts is not None else None
+    report["G5_density_and_baseline"] = {
+        "pass": (
+            exact_shipping is None
