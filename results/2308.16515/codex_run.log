+        "matching (Hopcroft-Karp O(E sqrt(V))); shipping-seed measurements are "
+        "filled from selftest, while the compact cross-ratio route checks at "
+        "most 27 three-point hypotheses in at most 228 exact operations."
+    ),
+    "max_answer_tokens": 225,
+}
+
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
