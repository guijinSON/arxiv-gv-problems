import random

def inv(a,p): return pow(a,-1,p)
def norm(M,p):
 f=[z%p for row in M for z in row]
 s=next(z for z in f if z)
 t=inv(s,p)
 f=[z*t%p for z in f]
 return [f[:2],f[2:]]
def image(M,x,p):
 a,b=M[0]; c,d=M[1]
 if x==p:
  return p if c==0 else a*inv(c,p)%p
 den=(c*x+d)%p
 return p if den==0 else (a*x+b)*inv(den,p)%p
def trial(seed,p=251,degree=3,restarts=256):
 rng=random.Random(seed)
 while True:
  M=norm([[rng.randrange(p),rng.randrange(p)],[rng.randrange(1,p),rng.randrange(p)]],p)
  a,b=M[0];c,d=M[1]
  if (a*d-b*c)%p: break
 q=p+1
 layers=[[image(M,x,p) for x in range(q)]]
 while len(layers)<degree:
  for z in range(100):
   perm=list(range(q));rng.shuffle(perm)
   if all(perm[x] not in {L[x] for L in layers} for x in range(q)):
    layers.append(perm);break
  else: return None
 inc=[]
 for x in range(q):
  v=[L[x] for L in layers];rng.shuffle(v);inc.append(v)
 def greedy(rr):
  order=list(range(q));rr.shuffle(order); used=set(); out=[None]*q
  for x in order:
   opts=[y for y in inc[x] if y not in used]
   if not opts:return False
   y=rr.choice(opts);out[x]=y;used.add(y)
  return True
 det_used=set(); det=True
 for x in range(q):
  opts=[y for y in inc[x] if y not in det_used]
  if not opts: det=False;break
  y=min(opts);det_used.add(y)
 rr=random.Random(seed"'^123456)
 success=0
 for z in range(restarts):success+=greedy(rr)
 return det,success,M
for seed in range(20):print(seed,trial(seed))
