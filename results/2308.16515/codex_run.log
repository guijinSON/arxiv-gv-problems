/bin/bash -lc "python3 - <<'PY'
import random,time,itertools

def build(v,t,seed):
 r=random.Random(seed); edges=set(); plant=[]
 tries=0
 while len(plant)<t and tries<200000:
  tri=tuple(sorted(r.sample(range(v),3))); es={(tri[0],tri[1]),(tri[0],tri[2]),(tri[1],tri[2])};tries+=1
  if es&edges:continue
  edges|=es;plant.append(tri)
 if len(plant)<t:return None
 tris=[z for z in itertools.combinations(range(v),3) if {(z[0],z[1]),(z[0],z[2]),(z[1],z[2])}<=edges]
 emap={e:i for i,e in enumerate(sorted(edges))}; masks=[];by=[[] for _ in edges]
 for rid,z in enumerate(tris):
  mask=0
  for e in ((z[0],z[1]),(z[0],z[2]),(z[1],z[2])):mask|=1<<emap[e]
  masks.append(mask)
  for j in range(len(edges)):
   if mask>>j&1:by[j].append(rid)
 return edges,plant,tris,masks,by

def ax(data,cap):
 edges,pl,tris,masks,by=data;full=(1<<len(edges))-1;nodes=0;part=[]
 def go(cov):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  if cov==full:return part[:]
  rem=full"'^cov;opts=None
  while rem:
   bit=rem&-rem;j=bit.bit_length()-1;rem-=bit
   o=[i for i in by[j] if not masks[i]&cov]
   if not o:return False
   if opts is None or len(o)<len(opts):opts=o
  for i in opts:
   part.append(i);z=go(cov|masks[i]);part.pop()
   if z is None or z:return z
  return False
 z=go(0);return isinstance(z,list),nodes
for v,t in [(24,50),(28,64),(30,70),(32,80),(34,85)]:
 print('"'PARAM',v,t)
 for s in range(8):
  d=build(v,t,s)
  if not d:print(s,'buildfail');continue
  deg=[]
  for j in range(len(d[0])):deg.append(len(d[4][j]))
  st=time.perf_counter();ok,n=ax(d,100000);dt=time.perf_counter()-st
  print(s,'T',len(d[2]),'mindeg',min(deg),'avg',sum(deg)/len(deg),'AX',ok,n,round(dt,3))
