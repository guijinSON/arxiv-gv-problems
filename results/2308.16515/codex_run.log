+    "medium": {"n": 181, "degree": 3},
+    "hard": {"n": 251, "degree": 3},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+
+STRUCTURAL_HINT = (
+    "Look for a spanning matching whose projective coordinate map preserves cross-ratios."
+)
