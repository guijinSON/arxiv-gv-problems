+        [[matrix[0][0], matrix[1][0]], [matrix[0][1], matrix[1][1]]], p
+    )
+    corruptions = {
+        "drop_one": [matrix[0], matrix[1][:-1]],
+        "swap_two": transpose,
+        "duplicate_row": [matrix[0], matrix[0]],
