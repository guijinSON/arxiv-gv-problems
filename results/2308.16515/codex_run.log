+        "doubled_graph_vertices": doubled["graph_vertex_count"],
+        "answer_atoms_before": _answer_atoms(inst["answer"]),
+        "answer_atoms_after": _answer_atoms(doubled["answer"]),
+        "verify_reason": doubled_reason,
