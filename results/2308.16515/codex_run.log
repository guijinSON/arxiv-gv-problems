+        "track": TRACK,
+        "family": "projectively compressed fat-head crown witness packing",
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    planted_failures = []
+    planted_checks = 0
+    for preset, preset_params in DIFFICULTY.items():
