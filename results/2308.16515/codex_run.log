+
+    guess_rng = random.Random(314159265)
+    guess_total = 200_000
+    guess_hits = 0
+    matrix_trials = 0
+    matrix_hits = 0
+    explicit_trials = 0
+    explicit_hits = 0
+    for _ in range(guess_total):
