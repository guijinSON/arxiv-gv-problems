+        ),
+        "shipping_preset": SHIPPING_DIFFICULTY,
+        "shipping_seed": 271828,
+        "density_method": "branch-balanced random_candidate sampling",
+        "density_hits": guess_hits,
+        "density_samples": guess_total,
+        "solution_fraction": guess_rate,
