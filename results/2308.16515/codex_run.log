+        "density_hits": guess_hits,
+        "density_samples": guess_total,
+        "solution_fraction": guess_rate,
+        "exact_solution_count": exact_shipping,
+        "baseline_attack": "256 random greedy restarts",
+        "baseline_success": baseline_success,
