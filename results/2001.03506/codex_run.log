+                len(common & neighbour_sets[k])
+                for k in range(size) if k != i and k != j
+            ))
+            pair_profiles.append((len(common), triples))
+    return (tuple(sorted(vertex_profiles)), tuple(sorted(pair_profiles)))
 
 
