+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any valid packing directly, without consulting the planted answer."""
+    n = inst["n"]
+    copies = inst["copies"]
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if set(answer) != {"maps"} or not isinstance(answer.get("maps"), list):
+        return False, "answer must contain only a maps list"
+    maps = answer["maps"]
+    if len(maps) != copies:
+        return False, f"wrong number of map records: expected {copies}"
+
+    host = {tuple(edge) for edge in inst["host_edges"]}
+    used: set[tuple[int, int]] = set()
+    for h, record in enumerate(maps):
