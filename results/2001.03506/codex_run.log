new file mode 100644
index 0000000000000000000000000000000000000000..5a73f3102f8e6ae7d60ced94f0ffb572c702d658
--- /dev/null
+++ b/gen_2001_03506.py
@@ -0,0 +1,832 @@
+"""Verified problem generator for arXiv:2001.03506.
+
+The paper's Section 4.1 defines a conflict-free packing as a collection of
+injective vertex maps whose image edges do not overlap.  This module asks for
+exactly such a witness in the simpler two-cluster setting of Theorem 1.1: two
+labelled perfect matchings must be packed edge-disjointly into one bipartite
+host graph.  Instances are inverse-generated from cyclic edge orbits and then
+independently relabelled on both host clusters.
+"""
+
+from __future__ import annotations
+
+import itertools
+import json
+import math
+import os
+import random
+import re
+import sys
+import time
+from collections import deque
+
+
+# Keep repository helpers importable when harden.py is launched in this folder.
+# This family needs only integer graph operations, so it remains standard-library
+# only if gvlib is absent.
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.dirname(
