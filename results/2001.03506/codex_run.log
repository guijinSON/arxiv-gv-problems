+    os.path.abspath(__file__)))))
+try:
+    from gvlib import exact_matrices, rationals  # noqa: F401
+except ImportError:  # pragma: no cover - documented dependency-free path
+    exact_matrices = rationals = None
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "exact_cover",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "bipartite host graph",
+        "two-cluster perfect-matching graphs",
+        "cluster-respecting injective vertex maps",
+    ],
+    "verification_operations": [
+        "permutation check",
+        "host-edge membership",
+        "cross-copy edge-disjointness",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "The two displayed host permutations act simultaneously on every host "
+        "edge, so whole edge-disjoint perfect matchings are short symmetry orbits."
+    ),
+    "hardness_basis": (
+        "Track B: Section 4.2's matching route is implemented by repeated "
+        "Hopcroft-Karp in O(copies*E*sqrt(n)); at the hard preset the recorded "
+        "reference run is measured in selftest_report.json, while the compact "
