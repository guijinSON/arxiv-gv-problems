+    levels = [
+        (23, 16, 10),
+        (29, 17, 8),
+        (31, 19, 8),
+        (41, 20, 6),
+        (47, 20, 5),
+        (59, 21, 4),
+    ]
+    for index, level in enumerate(levels[:-1]):
