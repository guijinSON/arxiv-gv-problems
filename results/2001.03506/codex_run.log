+# Populated after the two isolated diagnostic hardening runs.  G9(a,b) are
+# recorded, not gated; G9(c)'s size and operation limits are the sole pass test.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
