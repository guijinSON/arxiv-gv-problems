import random

def inv(x,p):return 0 if x==0 else pow(x,-1,p)
def build(p,D,seed):
 r=random.Random(seed);T=r.sample(range(1,p),D);return [{inv((inv(x,p)+s)%p,p) for s in T} for x in range(p)]
def go(p,D,k,seed,rng):
 a=build(p,D,seed);used=set();rows=[]
 for _ in range(k):
  taken=set();row=[None]*p;xs=list(range(p));rng.shuffle(xs)
  for x in xs:
   ys=[y for y in a[x] if y not in taken and (x,y) not in used]
   if not ys:return 0
   y=rng.choice(ys);row[x]=y;taken.add(y);used.add((x,y))
  rows.append(row)
 return 1
for p,D,k in [(29,13,8),(31,13,8),(37,10,6),(41,10,6),(47,8,5),(59,7,4)]:
 print(p,D,k,end=' ')
 for s in range(8):
  hit=0;r=random.Random(1000+s)
  for _ in range(256):
   if go(p,D,k,s,r):hit=1;break
  print(hit,end='')
 print()
