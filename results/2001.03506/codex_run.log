+NOTES = """\
+Section 1.1 fixes the native witness: a packing is a map that is injective on
+each input graph and maps all input edges injectively to host edges.  Section
+4.1 specializes this to conflict-free cluster maps, and Step 1 of the proof of
+the Approximate Packing Lemma (Section 4.2) gives a bijection with matchings in
+an auxiliary hypergraph.  Theorem 1.1 identifies the easy existence regime:
+dense super-regular hosts, bounded-degree input graphs, and total load bounded
+away from all host edges.  The proof then constructs a packing by pseudorandom
+hypergraph matching followed by an ordinary blow-up-lemma completion; it is not
+a hardness theorem.
+
+Accordingly this is Track B, not Track A.  The exact paper-native object is
+retained: two cluster-respecting maps for each matching graph, checked directly
+for host membership and edge-disjointness.  Repeated bipartite matching is the
+disclosed efficient reference method.  Plants and decoys are identically
+distributed complete cyclic edge orbits; independent host relabellings defeat
+public-index shifts, regular degrees defeat outlier statistics, and plain
+lexicographic and random greedy matchings are checked over eight seeds.  The
+compact route notices that the supplied permutations carry every host edge
+around a perfect-matching orbit and traces two different orbits.
+"""
+
+
+def _random_cycle_labels(n: int, rng: random.Random) -> tuple[list[int], list[int]]:
+    """Return (coordinate->label, successor-on-labels)."""
+    labels = list(range(n))
+    rng.shuffle(labels)
+    successor = [0] * n
+    for i, value in enumerate(labels):
+        successor[value] = labels[(i + 1) % n]
+    return labels, successor
+
+
+def make_instance(n: int, seed: int = 0, copies: int = 2,
+                  degree: int | None = None, **params) -> dict:
+    """Inverse-generate an edge-disjoint packing and carry it through relabelling.
+
+    Hidden coordinates form Z/nZ.  Every sampled offset contributes an entire
+    perfect-matching orbit to the host, so the offsets later used by the planted
+    witness have exactly the same distribution as all decoy offsets.  No search
+    is performed during generation.
+    """
+    del params
+    if isinstance(n, bool) or not isinstance(n, int) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    if isinstance(copies, bool) or not isinstance(copies, int) or copies < 2:
+        raise ValueError("copies must be an integer at least 2")
+    if degree is None:
+        degree = max(copies, n // 6)
+    if (isinstance(degree, bool) or not isinstance(degree, int)
+            or not copies <= degree <= n):
+        raise ValueError("degree must be an integer between copies and n")
+
+    rng = random.Random(seed)
+    coord0, successor0 = _random_cycle_labels(n, rng)
+    coord1, successor1 = _random_cycle_labels(n, rng)
+
+    offsets = rng.sample(range(n), degree)
+    witness_offsets = rng.sample(offsets, copies)
+    host_edges = sorted(
+        [coord0[i], coord1[(i + d) % n]]
+        for i in range(n) for d in offsets
+    )
+
+    # All source graphs are the same labelled perfect matching, but its X1
+    # labels are independently scrambled from the host labels.
+    source_partner = list(range(n))
+    rng.shuffle(source_partner)
+    base_source_edges = [[a, source_partner[a]] for a in range(n)]
+    source_edges = []
+    for _ in range(copies):
+        listed = [edge[:] for edge in base_source_edges]
+        rng.shuffle(listed)
+        source_edges.append(listed)
+
+    maps = []
+    for h, shift in enumerate(witness_offsets):
+        origin = rng.randrange(n)
+        map0 = [0] * n
+        map1 = [0] * n
+        for a, b in base_source_edges:
+            map0[a] = coord0[(origin + a) % n]
+            map1[b] = coord1[(origin + a + shift) % n]
+        maps.append({"x0": map0, "x1": map1})
+
+    return {
+        "family": "cyclic_conflict_free_blow_up_packing",
+        "n": n,
+        "copies": copies,
+        "degree": degree,
+        "host_edges": host_edges,
+        "successor0": successor0,
+        "successor1": successor1,
+        "source_edges": source_edges,
+        "answer": {"maps": maps},
+    }
+
+
+def _format_rows(inst: dict) -> str:
+    n = inst["n"]
+    rows = [[] for _ in range(n)]
+    for u, v in inst["host_edges"]:
+        rows[u].append(v)
+    return "\n".join(f"  {u}: " + " ".join(map(str, sorted(rows[u])))
+                     for u in range(n))
+
+
+def render(inst: dict) -> str:
+    """Render a complete statement with a strict JSON answer contract."""
+    n = inst["n"]
+    source_blocks = []
+    for h, edges in enumerate(inst["source_edges"]):
+        source_blocks.append(
+            f"H{h} edges (x0,x1): "
+            + " ".join(f"({a},{b})" for a, b in edges)
+        )
+    statement = f"""Conflict-free two-cluster packing
+
+There are two host clusters V0 and V1, each with vertices numbered 0 through
+{n - 1}.  The bipartite host graph has an edge from u in V0 to v in V1 exactly
+when v occurs on row u of the following adjacency table:
+{_format_rows(inst)}
+
+There are {inst['copies']} separate source graphs H0 through
+H{inst['copies'] - 1}.  Each Hh has clusters X0 and X1, each numbered 0 through
+{n - 1}, and its complete edge list is shown below.  Every list is a perfect
+matching.
+{chr(10).join(source_blocks)}
+
+A packing record for Hh consists of two arrays x0 and x1.  Entry x0[a] is the
+V0 image of source vertex a in Hh's X0; entry x1[b] is the V1 image of source
+vertex b in Hh's X1.  Each array must have length {n} and must be a permutation
+of 0,...,{n - 1}.  For every displayed source edge (a,b),
+(x0[a],x1[b]) must be a displayed host edge.  Across all source graphs, no host
+edge may be used twice.  Different source graphs may reuse host vertices.
+
+The instance also supplies two auxiliary permutations of the host vertices:
+P0 on V0 = {json.dumps(inst['successor0'], separators=(',', ':'))}
+P1 on V1 = {json.dumps(inst['successor1'], separators=(',', ':'))}
+They impose no additional validity condition; they are ordinary instance data.
+
+Give your final answer inside <answer></answer> tags as one strict JSON object
+{{"maps":[{{"x0":[...],"x1":[...]}},...]}} with exactly {inst['copies']}
+records in H0,H1,... order and exactly {n} integer entries in every array.
+Example shape: <answer>{{"maps":[{{"x0":[0,1],"x1":[1,0]}}]}}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the tagged strict-JSON witness; never raise on model output."""
+    if not isinstance(text, str):
+        return None
+    match = re.search(r"<answer\s*>(.*?)</answer\s*>", text,
+                      flags=re.IGNORECASE | re.DOTALL)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    if payload.startswith("```"):
+        payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.IGNORECASE)
+        payload = re.sub(r"\s*```$", "", payload)
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any valid packing directly, without consulting the planted answer."""
+    n = inst["n"]
+    copies = inst["copies"]
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if set(answer) != {"maps"} or not isinstance(answer.get("maps"), list):
+        return False, "answer must contain only a maps list"
+    maps = answer["maps"]
+    if len(maps) != copies:
+        return False, f"wrong number of map records: expected {copies}"
+
+    host = {tuple(edge) for edge in inst["host_edges"]}
+    used: set[tuple[int, int]] = set()
+    for h, record in enumerate(maps):
+        if not isinstance(record, dict) or set(record) != {"x0", "x1"}:
+            return False, f"map {h} must contain exactly x0 and x1 arrays"
+        for cluster in ("x0", "x1"):
+            arr = record[cluster]
+            if not isinstance(arr, list) or len(arr) != n:
+                return False, f"map {h} {cluster} has wrong length (expected {n})"
+            for value in arr:
+                if isinstance(value, bool) or not isinstance(value, int) \
+                        or not 0 <= value < n:
+                    return False, f"map {h} {cluster} contains an out-of-range entry"
+            if len(set(arr)) != n:
+                return False, f"map {h} {cluster} repeats a host vertex"
+
+        for a, b in inst["source_edges"][h]:
+            image = (record["x0"][a], record["x1"][b])
+            if image not in host:
+                return False, f"map {h} sends a source edge to an absent host edge"
+            if image in used:
+                return False, f"host edge {image} is reused across source graphs"
+            used.add(image)
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from the obvious language of 2*copies permutations."""
+    n = inst["n"]
+    maps = []
+    for _ in range(inst["copies"]):
+        x0 = list(range(n))
+        x1 = list(range(n))
+        rng.shuffle(x0)
+        rng.shuffle(x1)
+        maps.append({"x0": x0, "x1": x1})
+    return {"maps": maps}
+
+
+def search_space(inst: dict) -> int:
+    """Exact size of the structure-aware bounded certificate language."""
+    return math.factorial(inst["n"]) ** (2 * inst["copies"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count all valid witnesses only when the full declared space is tiny."""
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    perms = list(itertools.permutations(range(inst["n"])))
+    count = 0
+    for choice in itertools.product(perms, repeat=2 * inst["copies"]):
+        maps = []
+        for h in range(inst["copies"]):
+            maps.append({"x0": list(choice[2 * h]),
+                         "x1": list(choice[2 * h + 1])})
+        count += int(verify(inst, {"maps": maps})[0])
+    return count
+
+
+def _minimum_rotation(bits: str) -> str:
+    """Lexicographically least cyclic rotation (small n makes O(n^2) ample)."""
+    return min(bits[i:] + bits[:i] for i in range(len(bits)))
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonicalize the oriented cyclic host, ignoring all vertex/list labels."""
+    n = inst["n"]
+    host = {tuple(edge) for edge in inst["host_edges"]}
+    u = 0
+    v = 0
+    bits = []
+    for _ in range(n):
+        bits.append("1" if (u, v) in host else "0")
+        v = inst["successor1"][v]
+    necklace = _minimum_rotation("".join(bits))
+    return f"n={n}|copies={inst['copies']}|oriented_host={necklace}"
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Tighten the host at fixed witness length before acknowledging the cap."""
+    out = {k: v for k, v in params.items() if not k.startswith("_")}
+    degree = int(out.get("degree", max(2, int(out["n"]) // 6)))
+    copies = int(out.get("copies", 2))
+    if degree > copies + 2:
+        out["degree"] = degree - 1
+        return out
+    # Increasing n is still available mathematically, but 2*copies*n would
+    # exceed the 256-atom answer cap at the shipping scale.
+    return "cap_bound"
+
+
+def _hopcroft_karp(n: int, adjacency: list[list[int]]) \
+        -> tuple[list[int] | None, int]:
+    """Perfect matching plus a reproducible count of queue/edge operations."""
+    pair_u = [-1] * n
+    pair_v = [-1] * n
+    distance = [0] * n
+    operations = 0
+
+    def bfs() -> bool:
+        nonlocal operations
+        q = deque()
+        found = False
+        for u in range(n):
+            operations += 1
+            if pair_u[u] == -1:
+                distance[u] = 0
+                q.append(u)
+            else:
+                distance[u] = -1
+        while q:
+            u = q.popleft()
+            operations += 1
+            for v in adjacency[u]:
+                operations += 1
+                mate = pair_v[v]
+                if mate == -1:
+                    found = True
+                elif distance[mate] == -1:
+                    distance[mate] = distance[u] + 1
+                    q.append(mate)
+        return found
+
+    def dfs(u: int) -> bool:
+        nonlocal operations
+        for v in adjacency[u]:
+            operations += 1
+            mate = pair_v[v]
+            if mate == -1 or (distance[mate] == distance[u] + 1 and dfs(mate)):
+                pair_u[u] = v
+                pair_v[v] = u
+                return True
+        distance[u] = -1
+        return False
+
+    matched = 0
+    while bfs():
+        for u in range(n):
+            if pair_u[u] == -1 and dfs(u):
+                matched += 1
+    return (pair_u if matched == n else None), operations
+
+
+def _reference_algorithm(inst: dict) -> tuple[object | None, float, int]:
+    """Repeated domain-standard bipartite matching; deliberately ignores P0/P1."""
+    n = inst["n"]
+    remaining = [set() for _ in range(n)]
+    for u, v in inst["host_edges"]:
+        remaining[u].add(v)
+    maps = []
+    operations = 0
+    started = time.perf_counter()
+    for h in range(inst["copies"]):
+        adjacency = [sorted(row) for row in remaining]
+        matching, used_ops = _hopcroft_karp(n, adjacency)
+        operations += used_ops + sum(len(row) for row in adjacency)
+        if matching is None:
+            return None, time.perf_counter() - started, operations
+        map0 = [-1] * n
+        map1 = [-1] * n
+        for a, b in inst["source_edges"][h]:
+            u = a
+            v = matching[u]
+            map0[a] = u
+            map1[b] = v
+            remaining[u].remove(v)
+            operations += 3
+        maps.append({"x0": map0, "x1": map1})
+    return {"maps": maps}, time.perf_counter() - started, operations
+
+
+def _greedy_mapping(inst: dict, rng: random.Random | None,
+                    randomized: bool) -> object | None:
+    n = inst["n"]
+    adjacency = [[] for _ in range(n)]
+    for u, v in inst["host_edges"]:
+        adjacency[u].append(v)
+    used_edges: set[tuple[int, int]] = set()
+    maps = []
+    for h in range(inst["copies"]):
+        source = sorted(inst["source_edges"][h])
+        u_order = list(range(n))
+        if randomized and rng is not None:
+            rng.shuffle(u_order)
+            rng.shuffle(source)
+        free_v = set(range(n))
+        map0 = [-1] * n
+        map1 = [-1] * n
+        for (a, b), u in zip(source, u_order):
+            choices = [v for v in adjacency[u]
+                       if v in free_v and (u, v) not in used_edges]
+            if not choices:
+                return None
+            v = rng.choice(choices) if randomized and rng is not None else min(choices)
+            map0[a] = u
+            map1[b] = v
+            free_v.remove(v)
+            used_edges.add((u, v))
+        maps.append({"x0": map0, "x1": map1})
+    return {"maps": maps}
+
+
+def _attack_candidates(inst: dict, rng: random.Random) -> dict[str, list[object]]:
+    """Construction-aware cheap/no-tool attacks, all returning legal shapes."""
+    n = inst["n"]
+    copies = inst["copies"]
+
+    # All host degrees are equal, so sorting on the standard per-vertex outlier
+    # statistic reduces to public labels and has no access to hidden coordinates.
+    outlier_maps = []
+    for h in range(copies):
+        map0 = list(range(n))
+        map1 = [0] * n
+        for a, b in inst["source_edges"][h]:
+            map1[b] = (a + h) % n
+        outlier_maps.append({"x0": map0, "x1": map1})
+
+    greedy = _greedy_mapping(inst, None, False)
+
+    restarted = None
+    for _ in range(64):
+        restarted = _greedy_mapping(inst, rng, True)
+        if restarted is not None and verify(inst, restarted)[0]:
+            break
+    if restarted is None:
+        restarted = {"maps": outlier_maps}
+
+    public_shifts = []
+    for shift in range(n):
+        records = []
+        for h in range(copies):
+            map0 = list(range(n))
+            map1 = [0] * n
+            for a, b in inst["source_edges"][h]:
+                map1[b] = (a + shift + h) % n
+            records.append({"x0": map0, "x1": map1})
+        public_shifts.append({"maps": records})
+
+    return {
+        "outlier_degree_order": [{"maps": outlier_maps}],
+        "greedy_lexicographic_edges": [greedy] if greedy is not None else [],
+        "random_restart_64": [restarted],
+        "public_cyclic_shift_ansatz": public_shifts,
+    }
+
+
+def _relabel_instance(inst: dict, rng: random.Random) -> dict:
+    """Compose host/source/copy relabellings and carry the witness through."""
+    n = inst["n"]
+    p0 = list(range(n))
+    p1 = list(range(n))
+    rng.shuffle(p0)
+    rng.shuffle(p1)
+    copy_order = list(range(inst["copies"]))
+    rng.shuffle(copy_order)
+
+    host_edges = [[p0[u], p1[v]] for u, v in inst["host_edges"]]
+    rng.shuffle(host_edges)
+    successor0 = [0] * n
+    successor1 = [0] * n
+    for u in range(n):
+        successor0[p0[u]] = p0[inst["successor0"][u]]
+        successor1[p1[u]] = p1[inst["successor1"][u]]
+
+    source_edges = []
+    maps = []
+    for old_h in copy_order:
+        q0 = list(range(n))
+        q1 = list(range(n))
+        rng.shuffle(q0)
+        rng.shuffle(q1)
+        edges = [[q0[a], q1[b]] for a, b in inst["source_edges"][old_h]]
+        rng.shuffle(edges)
+        old_map = inst["answer"]["maps"][old_h]
+        new0 = [0] * n
+        new1 = [0] * n
+        for a in range(n):
+            new0[q0[a]] = p0[old_map["x0"][a]]
+            new1[q1[a]] = p1[old_map["x1"][a]]
+        source_edges.append(edges)
+        maps.append({"x0": new0, "x1": new1})
+
+    return {
+        "family": inst["family"],
+        "n": n,
+        "copies": inst["copies"],
+        "degree": inst["degree"],
+        "host_edges": host_edges,
+        "successor0": successor0,
+        "successor1": successor1,
+        "source_edges": source_edges,
+        "answer": {"maps": maps},
+    }
+
+
+def _atomic_elements(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_atomic_elements(v) for v in value.values())
+    if isinstance(value, list):
+        return sum(_atomic_elements(v) for v in value)
+    return 1
+
+
+def _find_swap_corruption(inst: dict) -> object:
+    answer = json.loads(json.dumps(inst["answer"]))
+    arr = answer["maps"][0]["x1"]
+    for i in range(len(arr)):
+        for j in range(i + 1, len(arr)):
+            arr[i], arr[j] = arr[j], arr[i]
+            ok, why = verify(inst, answer)
+            if not ok and "absent host edge" in why:
+                return answer
+            arr[i], arr[j] = arr[j], arr[i]
+    # Complete hosts make this impossible; shipping presets are deliberately
+    # non-complete, but retain a well-formed fallback.
+    arr[0], arr[1] = arr[1], arr[0]
+    return answer
+
+
+def selftest() -> dict:
+    report: dict = {
+        "paper": "2001.03506",
