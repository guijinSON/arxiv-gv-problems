import random

def inv(x,p): return 0 if x==0 else pow(x,-1,p)
def build(p,D,k,seed):
 r=random.Random(seed); T=r.sample(range(1,p),D)
 fs=[[inv((inv(x,p)+s)%p,p) for x in range(p)] for s in T]
 adj=[set() for _ in range(p)]
 for row in fs:
  for x,y in enumerate(row):adj[x].add(y)
 return adj

def greedy_once(adj,k,rng):
 p=len(adj);used=set();rows=[]
 for _ in range(k):
  take=set(); row=[None]*p; xs=list(range(p));rng.shuffle(xs)
  for x in xs:
   ys=[y for y in adj[x] if y not in take and (x,y) not in used]
   if not ys:return None
   y=rng.choice(ys);take.add(y);used.add((x,y));row[x]=y
  rows.append(row)
 return rows

def valid(adj,rows):
 if rows is None:return False
 p=len(adj);u=set()
 for row in rows:
  if len(set(row))<p:return False
  for x,y in enumerate(row):
   if y not in adj[x] or (x,y) in u:return False
   u.add((x,y))
 return True
for p,D,k in [(13,10,7),(17,13,9),(23,16,10),(29,20,8),(31,22,8)]:
 print(p,D,k,end=' ')
 print('lex',end='')
 for seed in range(8):
  a=build(p,D,k,seed); rng=random.Random(seed+999); print(int(valid(a,greedy_once(a,k,random.Random(0)))),end='')
 print(' rr',end='')
 for seed in range(8):
  a=build(p,D,k,seed);rng=random.Random(seed+999);hit=0
  for _ in range(256):
   if valid(a,greedy_once(a,k,rng)):hit=1;break
  print(hit,end='')
 print()
