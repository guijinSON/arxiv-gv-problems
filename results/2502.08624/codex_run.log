+        "expected_count": len(good)}
+
+    # G4: the candidate generator keeps every recognizable edge label and
+    # guesses only which graph vertices to delete.
+    guess_rng = random.Random(271828)
+    trials = 200_000
+    hits = 0
+    for _ in range(trials):
