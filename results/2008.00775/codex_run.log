+    lines.extend([
+        "",
+        "Give your final answer inside <answer></answer> tags as one JSON object",
+        f"with exactly the key vertical_parameters and a list of {blocks} distinct",
+        f"integers from 0 through {p - 1}, in component order.",
+        "Example: <answer>{\"vertical_parameters\":[3,17,42]}</answer>",
+        "Output nothing else inside the tags.",
