+    attack_counts = {name: {"successes": 0, "attempts": 8}
+                     for name in attack_names}
+    reference_successes = 0
+    reference_total_ops = 0
+    reference_total_seconds = 0.0
+    for seed in range(8):
+        trial_inst = make_instance(seed=seed + 9000, **shipping)
+        candidates = {
