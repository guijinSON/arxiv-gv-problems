+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    instance = make_instance(seed=314159, **shipping)
+
+    # G2: five qualitatively different corruptions and five different reasons.
+    original = instance["answer"]["vertical_parameters"]
