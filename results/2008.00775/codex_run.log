+        },
+    }
+    swapped = None
+    for left in range(len(original)):
+        for right in range(left + 1, len(original)):
+            trial = list(original)
+            trial[left], trial[right] = trial[right], trial[left]
+            if not verify(instance, {"vertical_parameters": trial})[0]:
