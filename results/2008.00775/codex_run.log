+# Filled from the three script-owned hardening runs after the module is stable.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 2, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
+    "hinted_verdict": "too_easy",
+}
