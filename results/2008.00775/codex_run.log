+def _first_prefix_candidate(inst, prefix, limited_range=None):
+    p = inst["p"]
+    output = []
+    for component in inst["components"]:
+        records = component["intercepts"][:min(prefix, p)]
+        choices = range(p if limited_range is None else min(p, limited_range))
+        selected = 0
+        best_score = -1
+        for parameter in choices:
+            score = len({(parameter * slope + intercept) % p
+                         for slope, intercept in records})
+            if score > best_score:
+                selected, best_score = parameter, score
+            if score == len(records):
+                selected = parameter
+                break
+        output.append(selected)
+    # Repair only the explicit pairwise-distinct syntax, without consulting any
+    # full component constraints.
+    used = set()
+    for index, value in enumerate(output):
+        while value in used:
+            value = (value + 1) % p
+        output[index] = value
+        used.add(value)
+    return {"vertical_parameters": output}
+
+
+def _one_layer_candidate(inst):
+    p = inst["p"]
+    output = []
+    for component in inst["components"]:
+        a, exponent, shift = component["circuit"][0]
+        first_layer_at_one = (a * pow(1, exponent, p) + shift) % p
+        intercepts = _ordered_intercepts(component, p)
+        output.append((first_layer_at_one - intercepts[1]) % p)
+    used = set()
+    for index, value in enumerate(output):
+        while value in used:
+            value = (value + 1) % p
+        output[index] = value
+        used.add(value)
+    return {"vertical_parameters": output}
+
+
+def _reference_scan(inst):
+    operation_box = [0]
+    valid_sets = [_valid_parameters(component, inst["p"], operation_box)
+                  for component in inst["components"]]
+    match_value_to_component = {}
+
+    def augment(component_index, visited):
+        for value in valid_sets[component_index]:
+            if value in visited:
+                continue
+            visited.add(value)
+            owner = match_value_to_component.get(value)
+            if owner is None or augment(owner, visited):
+                match_value_to_component[value] = component_index
+                return True
+        return False
+
+    for component_index in range(inst["blocks"]):
+        if not augment(component_index, set()):
+            return None, operation_box[0], valid_sets
+    answer = [None] * inst["blocks"]
+    for value, component_index in match_value_to_component.items():
+        answer[component_index] = value
+    return {"vertical_parameters": answer}, operation_box[0], valid_sets
+
