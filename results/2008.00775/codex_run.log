+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_field",
+    "computational_core": "other",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "complete graphs",
+        "compact list assignments over GF(p)",
+        "proper list-colouring functions",
+    ],
+    "verification_operations": [
