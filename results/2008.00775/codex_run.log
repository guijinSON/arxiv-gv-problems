+def _reference_scan(inst):
+    operation_box = [0]
+    valid_sets = [_valid_parameters(component, inst["p"], operation_box)
+                  for component in inst["components"]]
+    match_value_to_component = {}
+
+    def augment(component_index, visited):
+        for value in valid_sets[component_index]:
+            if value in visited:
+                continue
+            visited.add(value)
+            owner = match_value_to_component.get(value)
+            if owner is None or augment(owner, visited):
+                match_value_to_component[value] = component_index
+                return True
+        return False
+
+    for component_index in range(inst["blocks"]):
+        if not augment(component_index, set()):
+            return None, operation_box[0], valid_sets
+    answer = [None] * inst["blocks"]
+    for value, component_index in match_value_to_component.items():
+        answer[component_index] = value
+    return {"vertical_parameters": answer}, operation_box[0], valid_sets
+
