+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=123, **shipping)
+    answer = ship["answer"]
+
+    swapped = list(answer)
+    swap_pair = None
+    for left in range(12):
+        for right in range(left + 1, 12):
+            trial = list(answer)
+            trial[left], trial[right] = trial[right], trial[left]
+            if not verify(ship, trial)[0]:
