+            nested = re.findall(
+                r"\[(?:\s*-?\d+\s*,){11}\s*-?\d+\s*\]", cleaned, re.S
+            )
+            if not nested:
+                continue
+            try:
+                value = json.loads(nested[-1])
+            except (TypeError, ValueError, json.JSONDecodeError):
+                continue
+        if (
+            isinstance(value, list)
+            and len(value) == 12
+            and all(not isinstance(x, bool) and isinstance(x, int) for x in value)
+        ):
