+        "base": [0, 1, 2, 3, 4, 23, 32, 67, 40, 62, 19, 26],
+    },
+    217: {
+        "omega": 25,
+        "base": [0, 1, 2, 3, 4, 6, 115, 206, 157, 196, 40, 90],
+    },
+    577: {
+        "omega": 27,
+        "base": [0, 1, 2, 3, 4, 6, 14, 501, 69, 300, 402, 539],
