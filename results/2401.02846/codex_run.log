+            if compact is None or not verify(inst, compact)[0]:
+                g1_failures.append(f"{preset}/{seed}: compact route failed")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+        "construction_audit": (
