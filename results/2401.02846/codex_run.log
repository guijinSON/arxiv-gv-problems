+    reference_successes = 0
+    reference_maps = 0
+    reference_operations = 0
+    reference_wall = 0.0
+    compact_successes = 0
+    compact_operations = 0
+    compact_candidates = 0
+    attack_seeds = list(range(800, 808))
+    for seed in attack_seeds:
