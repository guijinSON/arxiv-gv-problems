    assert needle in source, (order, needle)
assert len(g._GRAPH_201_EDGES) == 36
assert all(sum(v in edge for edge in g._GRAPH_201_EDGES) == 6 for v in range(12))
count = 0
t0 = time.perf_counter()
levels = list(g.DIFFICULTY.values())
p = dict(g.DIFFICULTY['hard'])
while True:
    p = g.escalate(p)
    if not isinstance(p, dict):
        break
    levels.append(p)
for level_index, params in enumerate(levels):
    for seed in range(100):
        inst = g.make_instance(seed=100000 * level_index + seed, **params)
        assert g.verify(inst, inst['answer']) == (True, 'ok')
        compact, operations, _ = g._difference_multiplicity_solve(inst)
        assert compact is not None and g.verify(inst, compact) == (True, 'ok')
        assert operations <= 300
        assert g.parse_answer('<answer>' + __import__('json').dumps(inst['answer']) + '</answer>') == inst['answer']
        count += 1
print({'source_blocks_matched': len(g._DESIGNS), 'stress_instances': count, 'levels': len(levels), 'elapsed_sec': round(time.perf_counter()-t0, 3)})
