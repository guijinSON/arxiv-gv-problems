+    corruptions = {
+        "drop": answer[:-1],
+        "swap": swapped,
+        "duplicate": duplicated,
+        "empty": [],
+        "out_of_range": [ship["order"]] + answer[1:],
+        "not_in_pool": not_in_pool,
+    }
