   639	def _attack_random_restart(
   640	    inst: dict, rng: random.Random, restarts: int = 256
   641	) -> tuple[list[int], int, bool]:
   642	    last = _valid_shape_fallback(inst)
   643	    for attempt in range(1, restarts + 1):
   644	        last = random_candidate(inst, rng)
   645	        if verify(inst, last)[0]:
   646	            return last, attempt, True
   647	    return last, restarts, False
