import contextlib
import importlib.util
import io
import json
from pathlib import Path
required = {'schema_version','model','effort','preset','params','seed','escalation_round','solved','parsed','verify_ok','verify_reason','reply','error','elapsed_sec','http_status','finish_reason'}
for name in ('llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl'):
    rows=[]
    for line_no,line in enumerate(Path(name).read_text().splitlines(),1):
        row=json.loads(line)
        assert required <= row.keys(), (name,line_no,required-row.keys())
        assert row['solved']=='error' and row['error'] and row['http_status']==403
        rows.append(row)
    assert len(rows)==4
capture=io.StringIO()
with contextlib.redirect_stdout(capture), contextlib.redirect_stderr(capture):
    spec=importlib.util.spec_from_file_location('quiet_gen','gen_2401_02846.py')
    mod=importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
assert capture.getvalue()==''
inst1=mod.make_instance(seed=987654321,**mod.DIFFICULTY['hard'])
inst2=mod.make_instance(seed=987654321,**mod.DIFFICULTY['hard'])
assert inst1==inst2
base=mod.render(inst1)
import os
old=os.environ.get('GV_HINT_MODE')
try:
    os.environ.pop('GV_HINT_MODE',None)
    assert mod.render(inst1)==base and mod.STRUCTURAL_HINT not in base and mod.PLACEBO_HINT not in base
    os.environ['GV_HINT_MODE']='structural'
    assert mod.render(inst1).endswith(mod.STRUCTURAL_HINT)
    os.environ['GV_HINT_MODE']='placebo'
    assert mod.render(inst1).endswith(mod.PLACEBO_HINT)
finally:
    if old is None: os.environ.pop('GV_HINT_MODE',None)
    else: os.environ['GV_HINT_MODE']=old
print('final schema, import silence, determinism, and hint-mode checks passed')
