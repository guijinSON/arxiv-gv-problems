+    return answer, "ok"
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any submitted cyclic starter exactly, never reading inst['answer']."""
+    block, reason = _shape_check(inst, answer)
+    if block is None:
+        return False, reason
