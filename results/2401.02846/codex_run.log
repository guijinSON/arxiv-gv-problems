+def _valid_shape_fallback(inst: dict) -> list[int]:
+    marked = list(inst["marked"][: inst["marked_quota"]])
+    unmarked = sorted(set(inst["pool"]).difference(inst["marked"]))
+    return marked + unmarked[: 12 - inst["marked_quota"]]
