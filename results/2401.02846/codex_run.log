%ADFvfyBlocksEnd
\ADFvfyParStart{\{\{72, 7\}, \{504, \{\{2, 504, 3, 25, \{\{504, 1\}\}\}\}, \{\{72, 7\}\}\}\}}
%ADFvfyParEnd
\end{proof}
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{lemma} \label{lem-Design-73-et-al}
For each of the 12-vertex, 6-regular graphs
\begin{align*}
201, 1513, 3470, 6383, 6397, 6401, 6406, 6408, \\ 6713, 6753, 7677, 7700, 7754, 7840, 7845, 7847,
\end{align*}
there exist designs of orders
$73$, $145$, $217$, $289$, $433$, $577$ and $1009$.
\end{lemma}
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{proof}
For a design of order $n$, the point set is $\mathbb{Z}_{n}$.
The blocks are developed from a single base block by
$x \mapsto \omega^e x + d  \mathrm{~mod~} n$, $0 \le  e < (n - 1)/72$, $0 \le d < n$,
where $\omega$ is a specified parameter.
% Perhaps we should emphasize that the ring for order 289 is $\mathbb{Z}_{289}$, not the Galois field $\mathbb{F}(17^2)$.
%
% Orders 289, 577, 1009 needed only for graphs 6406, 6408, 7845 and 7847.
%

%%%
%%% DESIGN ORDER BLOCKS GO BELOW HERE
\end{proof}

