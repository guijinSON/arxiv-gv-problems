   670	def _relabel_instance(
   671	    inst: dict,
   672	    ambient_multiplier: int,
   673	    ambient_translation: int,
   674	    vertex_permutation: list[int],
   675	    rng: random.Random,
   676	) -> dict:
   677	    """Apply genuine ambient/vertex relabellings and carry the witness."""
   678	    p = inst["order"]
   679	
   680	    def move(value: int) -> int:
   681	        return (ambient_multiplier * value + ambient_translation) % p
   682	
   683	    moved = dict(inst)
   684	    moved["pool"] = [move(value) for value in inst["pool"]]
   685	    moved["marked"] = [move(value) for value in inst["marked"]]
   686	    moved["reference_base_block"] = [0] * 12
   687	    moved["answer"] = [0] * 12
   688	    for old_vertex in range(12):
   689	        new_vertex = vertex_permutation[old_vertex]
   690	        moved["reference_base_block"][new_vertex] = move(
   691	            inst["reference_base_block"][old_vertex]
   692	        )
   693	        moved["answer"][new_vertex] = move(inst["answer"][old_vertex])
   694	    moved["graph_edges"] = [
   695	        sorted((vertex_permutation[left], vertex_permutation[right]))
   696	        for left, right in inst["graph_edges"]
   697	    ]
   698	    rng.shuffle(moved["pool"])
   699	    rng.shuffle(moved["marked"])
   700	    rng.shuffle(moved["graph_edges"])
   701	    return moved
