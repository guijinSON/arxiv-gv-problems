   572	        for translation in sorted(marker_set.difference(non_starts)):
   573	            chain = [translation]
   574	            while chain[-1] in successors:
   575	                chain.append(successors[chain[-1]])
   576	            if len(chain) != 5:
   577	                continue
   578	            candidate = [
   579	                (multiplier * value + translation) % p for value in reference
   580	            ]
   580	            ]
   581	            modular_operations += len(reference)
   582	            candidates_tested += 1
   583	            if all(value in pool for value in candidate) and verify(inst, candidate)[0]:
