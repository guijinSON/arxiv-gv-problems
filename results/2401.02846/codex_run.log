   588	def _valid_shape_fallback(inst: dict) -> list[int]:
   589	    marked = list(inst["marked"][: inst["marked_quota"]])
   590	    unmarked = sorted(set(inst["pool"]).difference(inst["marked"]))
   591	    return marked + unmarked[: 12 - inst["marked_quota"]]
   592	
   593	
   594	def _attack_outlier_magnitude(inst: dict) -> tuple[list[int], int]:
   595	    """Choose the smallest allowed residues, then sort them by magnitude."""
   596	    marked = sorted(inst["marked"])[: inst["marked_quota"]]
   597	    unmarked = sorted(set(inst["pool"]).difference(inst["marked"]))[:7]
   598	    return sorted(marked + unmarked), len(inst["pool"])
   599	
   600	
   601	def _attack_greedy_vertex_order(inst: dict) -> tuple[list[int], int]:
   602	    """Put marked residues first and greedily avoid early difference repeats."""
   603	    available = list(inst["pool"])
   604	    marked = set(inst["marked"])
   605	    chosen: list[int] = []
   606	    used_differences: set[int] = set()
   607	    steps = 0
   608	    for vertex in range(12):
   609	        want_marked = vertex < inst["marked_quota"]
   610	        candidates = [value for value in available if (value in marked) == want_marked]
   611	        if not candidates:
   612	            return _valid_shape_fallback(inst), steps
   613	        best = None
   614	        best_score = None
   615	        for value in candidates:
   616	            new_differences = []
   617	            collision = 0
   618	            for edge_left, edge_right in inst["graph_edges"]:
   619	                if edge_right == vertex and edge_left < len(chosen):
   620	                    difference = (value - chosen[edge_left]) % inst["order"]
   621	                    difference = min(difference, inst["order"] - difference)
   622	                    new_differences.append(difference)
   623	                    collision += int(difference in used_differences)
   624	                    steps += 1
   625	            score = (collision, value)
   626	            if best_score is None or score < best_score:
   627	                best_score = score
   628	                best = value
   629	        assert best is not None
   630	        chosen.append(best)
   631	        available.remove(best)
   632	        for edge_left, edge_right in inst["graph_edges"]:
   633	            if edge_right == vertex and edge_left < len(chosen) - 1:
   634	                difference = (best - chosen[edge_left]) % inst["order"]
   635	                used_differences.add(min(difference, inst["order"] - difference))
   636	    return chosen, steps
