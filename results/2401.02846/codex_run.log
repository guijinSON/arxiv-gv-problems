   650	def _attack_small_step_ansatz(inst: dict) -> tuple[list[int], int]:
   651	    """Try only small positive affine steps and the least marked translation."""
   652	    p = inst["order"]
   653	    translation = min(inst["marked"])
   654	    pool = set(inst["pool"])
   655	    attempts = 0
   656	    for multiplier in range(1, 17):
   657	        attempts += 1
   658	        candidate = [
   659	            (multiplier * value + translation) % p
   660	            for value in inst["reference_base_block"]
   661	        ]
   662	        if (
   663	            all(value in pool for value in candidate)
   664	            and len(set(candidate).intersection(inst["marked"])) == inst["marked_quota"]
   665	        ):
   666	            return candidate, attempts
   667	    return _valid_shape_fallback(inst), attempts
