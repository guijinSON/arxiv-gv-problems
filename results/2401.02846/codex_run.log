+        "exact undirected edge-difference comparison",
+        "set membership and cardinality comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "Recognize that affine relabellings preserve the cyclic multiplier "
+        "development and expose themselves through pairwise-difference "
+        "multiplicities among the marked residues; otherwise search for a "
+        "12-vertex labelling in a large residue pool."
+    ),
+    "hardness_basis": (
+        "Track B: exhaustive affine-template scanning takes "
+        "O(p^2*|V(G)|); across eight shipping p=1009 instances it used "
+        "45,831,132 exact modular image operations in 13.985 seconds "
+        "(5,728,891 operations and 1.748 seconds per instance), while the "
+        "difference-multiplicity route used at most 234 modular operations "
+        "once the affine symmetry was seen."
+    ),
+    "max_answer_tokens": 16,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
