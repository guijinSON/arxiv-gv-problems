    cand=None if a is None else [i*inst['"'part_size']+x for i,x in enumerate(a)]
    print(seed, bool(cand and g.verify(inst,cand)[0]), r, st, e, round(dt,3), 'planted', a==[x%inst['part_size'] for x in inst['answer']] if a else None)
