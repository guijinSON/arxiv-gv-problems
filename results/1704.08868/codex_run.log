        for block in inst["blocks"]
    }


def _has_edge(inst: dict, i: int, a: int, j: int, b: int) -> bool:
    if i > j:
        i, j, a, b = j, i, b, a
    rows = inst["blocks"][_pair_index(i, j, inst["source_colors"])]["rows"]
