+def _pair_index(i: int, j: int, k: int) -> int:
+    if not (0 <= i < j < k):
+        raise ValueError("pair indices must satisfy 0 <= i < j < k")
+    return i * (2 * k - i - 1) // 2 + (j - i - 1)
