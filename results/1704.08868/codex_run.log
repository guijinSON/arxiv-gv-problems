+                score = sum(
+                    not ((adj[color][value][j] >> selected[j]) & 1)
+                    for j in range(k) if j != color
+                )
+                if score < best_score:
+                    best_score = score
+                    best_values = [value]
+                elif score == best_score:
+                    best_values.append(value)
+            selected[color] = rng.choice(best_values)
+    return None
