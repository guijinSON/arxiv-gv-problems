+    hinted_rate = (
+        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+        if arms["hinted"]["attempts"] else 0.0
+    )
+    placebo_rate = (
+        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        if arms["placebo"]["attempts"] else 0.0
+    )
