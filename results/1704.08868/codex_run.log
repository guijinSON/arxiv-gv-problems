+        for x in range(s):
+            if x == local[i]:
+                continue
+            for j in range(inst["k"]):
+                if i != j and not _safe(inst, i, x, j, local[j]):
+                    bad = list(inst["answer"])
+                    bad[i] = i * s + x
+                    return bad
+    return None
