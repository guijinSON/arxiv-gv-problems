+def _attack_min_conflicts(
+    inst: dict,
+    rng: random.Random,
+    restarts: int = 4,
+    steps: int = 500,
+) -> list[int] | None:
+    """Repair a random assignment by minimizing its incident conflicts."""
+    k, s = inst["k"], inst["part_size"]
