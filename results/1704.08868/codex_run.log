+    # At conflict U(i,x,j,y), P(i,z) is at distance <=4s iff z!=x:
+    # min((s+z+1)+(3s-x), (2s-z)+(2s+x+1))
+    # = 4s+1-|z-x|.  Both selected endpoints miss U only when z=x,w=y.
+    for i in range(k):
