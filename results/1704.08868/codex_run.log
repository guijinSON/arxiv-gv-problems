def minconf(inst, seed, restarts=32, steps=5000):
    rng=random.Random(seed); k=inst['k']; s=inst['part_size']; adj=g._safe_adjacency(inst)
    evals=0
    for rr in range(restarts):
        a=[rng.randrange(s) for _ in range(k)]
        for st in range(steps):
            bad=[]
            for i in range(k):
                c=sum(not ((adj[i][a[i]][j]>>a[j])&1) for j in range(k) if j"'!=i)
                if c: bad.append((i,c))
            if not bad:
                return a,rr,st,evals
            # random conflicting variable, choose min conflicts value with random tie
            i=rng.choice(bad)[0]
            vals=[]; best=k+1
            for x in range(s):
                c=sum(not ((adj[i][x][j]>>a[j])&1) for j in range(k) if j!=i); evals += k-1
                if c<best: best=c; vals=[x]
                elif c==best: vals.append(x)
            a[i]=rng.choice(vals)
    return None,restarts,steps,evals

for seed in range(100,108):
