   919	def canonical_key(inst: dict) -> str:
   920	    """Canonical under raw source renaming and every input row reordering."""
   921	    id_to_code, _ = _code_maps(inst)
   922	    canonical_blocks = []
   923	    for block in inst["blocks"]:
   924	        canonical_blocks.append(sorted(id_to_code[int(v)] for v in block))
   925	    normal = {
   926	        "bits": int(inst["bits"]),
   927	        "weight": int(inst["weight"]),
   928	        "codes": sorted(id_to_code.values()),
   929	        "blocks_as_code_multiset": sorted(canonical_blocks),
   930	    }
   931	    blob = json.dumps(normal, sort_keys=True, separators=(",", ":")).encode()
   932	    return hashlib.sha256(blob).hexdigest()
