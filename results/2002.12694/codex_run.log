   988	def _intended_route_operations(inst: dict) -> int:
   989	    # For w-1 basis rows: three word-XORs, one sparse-direction inspection,
   990	    # and one mark/union.  Two final operations choose either constant and emit.
   991	    return 5 * (int(inst["bits"]) - 1) + 2
