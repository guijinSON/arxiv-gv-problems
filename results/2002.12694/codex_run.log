   722	def _reference_algorithm(inst: dict) -> tuple[dict | None, dict[str, int]]:
   723	    """Domain reference: exact-two propagation, then GF(2) elimination."""
   724	    blocks = _unique_blocks(inst)
   725	    n = int(inst["n"])
   726	    bits = int(inst["bits"])
   727	    id_to_code, _ = _code_maps(inst)
   728	    adjacency = [[] for _ in blocks]
   729	    overlap_comparisons = 0
   730	    for i in range(len(blocks)):
   731	        for j in range(i + 1, len(blocks)):
   732	            shared = 0
   733	            # Count the literal comparisons a simple implementation performs.
   734	            for a in blocks[i]:
   735	                for b in blocks[j]:
   736	                    overlap_comparisons += 1
   737	                    shared += int(a == b)
   738	            if shared == 3:
   739	                adjacency[i].append(j)
   740	                adjacency[j].append(i)
   741	
   742	    propagation_ops = 0
   743	    elimination_ops = 0
   744	    candidates_tried = 0
   745	    if not blocks:
   746	        return None, {
   747	            "overlap_comparisons": overlap_comparisons,
   748	            "propagation_operations": 0,
   749	            "elimination_operations": 0,
   750	            "candidates_tried": 0,
   751	            "operations": overlap_comparisons,
   752	        }
   753	
   754	    root = blocks[0]
   755	    for ones in itertools.combinations(range(4), 2):
   756	        candidates_tried += 1
   757	        colours: dict[int, int] = {
   758	            root[i]: int(i in ones) for i in range(4)
   759	        }
   760	        queue = deque([0])
   760	        queue = deque([0])
   761	        reached = {0}
   762	        consistent = True
   763	        while queue and consistent:
   764	            current = queue.popleft()
   765	            propagation_ops += 1
   766	            for neighbour in adjacency[current]:
   767	                propagation_ops += 1
   768	                if neighbour in reached:
   769	                    continue
   770	                block = blocks[neighbour]
   771	                unknown = [v for v in block if v not in colours]
   772	                known_sum = sum(colours[v] for v in block if v in colours)
   773	                propagation_ops += len(block) + 1
   774	                if len(unknown) == 1:
   775	                    forced = 2 - known_sum
   776	                    if forced not in (0, 1):
   777	                        consistent = False
   778	                        break
   779	                    colours[unknown[0]] = forced
   780	                    reached.add(neighbour)
   781	                    queue.append(neighbour)
   782	                elif not unknown:
   783	                    if known_sum != 2:
   784	                        consistent = False
   785	                        break
   786	                    reached.add(neighbour)
   787	                    queue.append(neighbour)
   788	        if not consistent or len(colours) != n:
   789	            continue
   790	        for block in blocks:
   791	            propagation_ops += 4
   792	            if sum(colours[v] for v in block) != 2:
   793	                consistent = False
   794	                break
   795	        if not consistent:
   796	            continue
   797	
   798	        ordered_ids = sorted(id_to_code)
   799	        candidate, cost = _solve_gf2_affine(
   800	            [id_to_code[v] for v in ordered_ids],
   801	            [colours[v] for v in ordered_ids],
   802	            bits,
   803	        )
   804	        elimination_ops += cost
   805	        if candidate is not None and len(candidate["support"]) == int(inst["weight"]):
   806	            if verify(inst, candidate)[0]:
   807	                counts = {
   808	                    "overlap_comparisons": overlap_comparisons,
   809	                    "propagation_operations": propagation_ops,
   810	                    "elimination_operations": elimination_ops,
   811	                    "candidates_tried": candidates_tried,
   812	                }
   813	                counts["operations"] = sum(
   814	                    counts[k] for k in (
   815	                        "overlap_comparisons",
   816	                        "propagation_operations",
   817	                        "elimination_operations",
   818	                    )
   819	                )
   820	                return candidate, counts
   821	
   822	    counts = {
   823	        "overlap_comparisons": overlap_comparisons,
   824	        "propagation_operations": propagation_ops,
   825	        "elimination_operations": elimination_ops,
   826	        "candidates_tried": candidates_tried,
   827	    }
   828	    counts["operations"] = sum(
   829	        counts[k] for k in (
   830	            "overlap_comparisons",
   831	            "propagation_operations",
   832	            "elimination_operations",
   833	        )
   834	    )
   835	    return None, counts
