   935	def _renumber_and_reorder(inst: dict, rng: random.Random) -> dict:
   936	    """Apply a genuine base-vertex relabelling and independent input reorderings."""
   937	    n = int(inst["n"])
   938	    labels = list(range(n))
   939	    shuffled = list(labels)
   940	    rng.shuffle(shuffled)
   941	    mapping = dict(zip(labels, shuffled))
   942	    transformed = {
   943	        "n": n,
   944	        "bits": int(inst["bits"]),
   945	        "weight": int(inst["weight"]),
   946	        "repeat_factor": int(inst["repeat_factor"]),
   947	        "centre": inst["centre"],
   948	        "variables": [
   949	            {"id": mapping[int(row["id"])], "code": int(row["code"])}
   950	            for row in inst["variables"]
   951	        ],
   952	        "blocks": [
   953	            [mapping[int(v)] for v in block]
   954	            for block in inst["blocks"]
   955	        ],
   956	        "answer": {
   957	            "constant": int(inst["answer"]["constant"]),
   958	            "support": list(inst["answer"]["support"]),
   959	        },
   960	    }
   961	    rng.shuffle(transformed["variables"])
   962	    rng.shuffle(transformed["blocks"])
   963	    for block in transformed["blocks"]:
   964	        rng.shuffle(block)
   965	    return transformed
