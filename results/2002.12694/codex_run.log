   980	def _atom_count(value: Any) -> int:
   981	    if isinstance(value, dict):
   982	        return sum(_atom_count(v) for v in value.values())
   983	    if isinstance(value, (list, tuple)):
   984	        return sum(_atom_count(v) for v in value)
   985	    return 1
