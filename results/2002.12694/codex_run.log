   968	def escalate(params: dict) -> dict | str | None:
   969	    """Increase temporal crowding first, then graph size; the answer stays fixed."""
   970	    clean = {k: v for k, v in params.items() if k != "_preset"}
   971	    repeat_factor = int(clean.get("repeat_factor", 1))
   972	    if repeat_factor < 4:
   973	        clean["repeat_factor"] = repeat_factor + 1
   974	        return clean
   975	    clean["n"] = 2 * int(clean.get("n", DIFFICULTY[SHIPPING_DIFFICULTY]["n"]))
   976	    clean["repeat_factor"] = 1
   977	    return clean
