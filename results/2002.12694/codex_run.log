   859	def _attack_candidates(inst: dict, seed: int) -> dict[str, dict]:
   860	    bits = int(inst["bits"])
   861	    weight = int(inst["weight"])
   862	    id_to_code, _ = _code_maps(inst)
   863	
   864	    low = list(range(weight))
   865	    one_counts = [sum((code >> bit) & 1 for code in id_to_code.values()) for bit in range(bits)]
   866	    frequency = sorted(
   867	        range(bits),
   868	        key=lambda bit: (-abs(2 * one_counts[bit] - len(id_to_code)), bit),
   869	    )[:weight]
   870	
   871	    # A bounded, genuinely by-hand partial use of the intended XOR invariant:
   872	    # inspect only eight rows, mark singleton directions as zero, and favor
   873	    # endpoints of observed two-bit relations.  It deliberately does not scan
   874	    # the full basis-sized prefix.
   875	    forbidden: set[int] = set()
   876	    pair_degree = [0] * bits
   877	    for block in _unique_blocks(inst)[:8]:
   878	        d = _block_code_xor(inst, block)
   879	        support_d = [bit for bit in range(bits) if (d >> bit) & 1]
   880	        if len(support_d) == 1:
   881	            forbidden.add(support_d[0])
   882	        elif len(support_d) == 2:
   883	            pair_degree[support_d[0]] += 1
   884	            pair_degree[support_d[1]] += 1
   885	    partial = sorted(
   886	        range(bits), key=lambda bit: (bit in forbidden, -pair_degree[bit], bit)
   887	    )[:weight]
   888	
   889	    # Limited local improvement from the conspicuous low-bit ansatz.  Eight
   890	    # swaps is small enough to attempt manually; ties are deterministic.
   891	    greedy = set(low)
   892	    current_score = _score_support(inst, sorted(greedy))
   893	    for _ in range(8):
   894	        best = None
   895	        best_score = current_score
   896	        for remove in sorted(greedy):
   897	            for add in range(bits):
   898	                if add in greedy:
   899	                    continue
   900	                trial = sorted((greedy - {remove}) | {add})
   901	                score = _score_support(inst, trial)
   902	                if score > best_score:
   903	                    best_score = score
   904	                    best = (remove, add)
   905	        if best is None:
   906	            break
   907	        greedy.remove(best[0])
   908	        greedy.add(best[1])
   909	        current_score = best_score
   910	
   911	    return {
   912	        "linear_low_bits_ansatz": {"constant": 0, "support": sorted(low)},
   913	        "outlier_bit_frequency": {"constant": 0, "support": sorted(frequency)},
   914	        "prefix_xor_constraints_8": {"constant": 0, "support": sorted(partial)},
   915	        "greedy_balance_swap_8": {"constant": 0, "support": sorted(greedy)},
   916	    }
