   657	def _unique_blocks(inst: dict) -> list[list[int]]:
   658	    seen: set[tuple[int, ...]] = set()
   659	    result = []
   660	    for block in inst["blocks"]:
   661	        key = tuple(sorted(map(int, block)))
   662	        if key not in seen:
   663	            seen.add(key)
   664	            result.append(list(key))
   665	    return result
