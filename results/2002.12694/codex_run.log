   846	def _score_support(inst: dict, support: list[int]) -> int:
   847	    candidate = {"constant": 0, "support": sorted(support)}
   848	    good, _ = _answer_syntax(inst, candidate)
   849	    if not good:
   850	        return -1
   851	    id_to_code, _ = _code_maps(inst)
   852	    mask = _mask_from_support(candidate["support"])
   853	    score = 0
   854	    for block in _unique_blocks(inst):
   855	        score += int(sum(_colour(id_to_code[v], mask, 0) for v in block) == 2)
