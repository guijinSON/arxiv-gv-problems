   668	def _solve_gf2_affine(
   669	    codes: list[int],
   670	    colours: list[int],
   671	    bits: int,
   672	) -> tuple[dict | None, int]:
   673	    """Solve L(code_i)=colour_i and count elementary GF(2) operations."""
   674	    rows = [[int(code) | (1 << bits), int(colour)] for code, colour in zip(codes, colours)]
   675	    variables = bits + 1
   676	    rank = 0
   677	    pivots: list[int] = []
   678	    operations = 0
   679	    for col in range(variables):
   680	        pivot = None
   681	        for r in range(rank, len(rows)):
   682	            operations += 1
   683	            if (rows[r][0] >> col) & 1:
   684	                pivot = r
   685	                break
   686	        if pivot is None:
   687	            continue
   688	        if pivot != rank:
   689	            rows[rank], rows[pivot] = rows[pivot], rows[rank]
   690	            operations += 1
   691	        for r in range(len(rows)):
   692	            if r == rank:
   693	                continue
   694	            operations += 1
   695	            if (rows[r][0] >> col) & 1:
   696	                rows[r][0] ^= rows[rank][0]
   697	                rows[r][1] ^= rows[rank][1]
   698	                operations += variables + 1
   699	        pivots.append(col)
   700	        rank += 1
   701	        if rank == len(rows):
   702	            break
   703	    for coeffs, rhs in rows:
   704	        operations += 1
   705	        if coeffs == 0 and rhs:
   706	            return None, operations
   707	
   708	    solution = 0
   709	    for r, col in reversed(list(enumerate(pivots))):
   710	        rhs = rows[r][1]
   711	        remaining = rows[r][0] & ~(1 << col)
   712	        operations += 1 + remaining.bit_count()
   713	        if (remaining & solution).bit_count() & 1:
   714	            rhs ^= 1
   715	        if rhs:
   716	            solution |= 1 << col
   717	    support = [bit for bit in range(bits) if (solution >> bit) & 1]
   718	    constant = (solution >> bits) & 1
   719	    return {"constant": constant, "support": support}, operations
   720	
