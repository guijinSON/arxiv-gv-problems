+def _reference_forward_scan(inst: dict) -> tuple[list[int], int, int]:
+    """Mechanical preimage enumeration, expected to solve on Track B."""
+    modulus = inst["n"] - 1
+    tested = 0
+    fold = None
+    for candidate in range(modulus):
+        tested += 1
+        if _forward_chain(modulus, inst["updates"], candidate) == inst["target"]:
+            fold = candidate
+            break
+    if fold is None:
+        raise AssertionError("bijective chain had no preimage")
+    answer = sorted(
+        [_public_label(inst, fold), _public_label(inst, inst["n"] - 1)]
+    )
+    operations = tested * (3 * len(inst["updates"])) + 6
+    return answer, tested, operations
 
 
