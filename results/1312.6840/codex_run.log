+        if base % value == 0:
+            continue
+        witness = pow(base, d, value)
+        if witness in (1, value - 1):
+            continue
+        for _ in range(power - 1):
+            witness = witness * witness % value
+            if witness == value - 1:
+                break
+        else:
+            return False
+    return True
+
