+            for name in attack_names
+        },
+        "domain_standard_attack": attack_names[-1],
+        "exact_node_counts": node_counts,
+    }
+
+    base_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    doubled_params = dict(base_params)
+    doubled_params["n"] *= 2
+    # Give the doubled instance enough code coordinates without making the
+    # generator rely on the conspicuous even-parity code.
+    doubled_params["landmarks"] += 2
+    doubled = make_instance(seed=77, **doubled_params)
+    ok, why = verify(doubled, doubled["answer"])
+    if not ok:
+        raise AssertionError("G7 doubled instance: " + why)
+    report["G7_scales"] = {
+        "pass": True,
+        "base_n": base_params["n"],
+        "doubled_n": doubled_params["n"],
+        "base_answer_length": base_params["landmarks"],
+        "doubled_answer_length": doubled_params["landmarks"],
+        "base_space": str(search_space(shipping)),
+        "doubled_space": str(search_space(doubled)),
+        "doubled_planted_verifies": True,
+    }
+
+    invariant = carried = 0
+    unrelated_keys = []
+    key_params = DIFFICULTY["easy"]
+    for seed in range(20):
+        inst = make_instance(seed=10_000 + seed, **key_params)
+        transformed = _relabel(inst, random.Random(20_000 + seed))
+        if canonical_key(inst) != canonical_key(transformed):
+            raise AssertionError(f"G8 relabelling changed key at seed {seed}")
+        invariant += 1
+        ok, why = verify(transformed, transformed["answer"])
+        if not ok:
+            raise AssertionError(f"G8 carried witness at seed {seed}: {why}")
+        carried += 1
+        unrelated_keys.append(canonical_key(inst))
+    distinct = len(set(unrelated_keys))
+    if distinct != 20:
+        raise AssertionError(f"G8 unrelated distinctness {distinct}/20")
+    report["G8_canonical_key"] = {
+        "pass": True,
+        "invariance_transformations": invariant,
+        "carried_witnesses_verified": carried,
+        "unrelated_keys_distinct": distinct,
+        "unrelated_keys_tested": 20,
+        "symmetries": ["arbitrary vertex relabelling"],
+        "method": "exact adjacency canonicalization after discrete 1-WL refinement",
+    }
+
+    chars, tokens, elements = _answer_size(shipping["answer"])
+    PROBLEM_PROFILE["max_answer_tokens"] = tokens
+    arms = G9_ORACLE_RESULTS
+    hinted_verdict = arms.get("hinted_verdict")
+    hinted_still_hardened = (
+        hinted_verdict == "hardened"
+        and arms["hinted"]["solved"] == 0
+        and arms["hinted"]["attempts"] >= 3
+    )
+    within_caps = chars <= 2000 and elements <= 256 and 3 * shipping["landmarks"] <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_still_hardened and within_caps,
+        "arms": {
+            name: dict(arms[name]) for name in ("bare", "hinted", "placebo")
+        },
+        "hinted_minus_placebo": (
+            arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+            - arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        ),
+        "hinted_verdict": hinted_verdict,
+        "answer_chars": chars,
+        "answer_tokens": tokens,
+        "answer_elements": elements,
+        "intended_route_operations": 3 * shipping["landmarks"],
+        "operation_model": (
+            "three exact pair-mask updates per recognized landmark column; "
+            "search for the columns is the structural task"
+        ),
+    }
+    if not report["G9_no_tool_suitability"]["pass"]:
+        raise AssertionError("G9 oracle evidence or size/effort cap failed")
+
+    report["all_passed"] = all(
+        value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

