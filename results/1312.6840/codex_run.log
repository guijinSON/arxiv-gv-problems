  a=rng.choice(tuple(S)); b=rng.choice(tuple(set(range(n))-S)); T=(S-{a})|{b}; q=obj(c,full,T)[0]
  temp=max(.05,3*(1-(it%5000)/5000))
  if q<=cur or rng.random()<math.exp((cur-q)/temp): S=T;cur=q
  if cur<best[0]:best=(cur,sorted(S))
 return None,steps,best
