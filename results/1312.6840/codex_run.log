\node [draw=black, shape=circle, fill=white,text=black] (v) at (0,0) {$v$};
\draw[black] (u13) -- (u12)  -- (w1) -- (v) -- (w2) -- (u22) -- (u23);
\draw[black] (w1) -- (u11);
\draw[black] (w2) -- (u21);
\end{tikzpicture}
\caption{A $3$-metric dimensional tree $T$ for which $\dim_{3}(T)=\vert{\cal D}_3(T)\vert=6$.}
\label{figTree3D}
\end{figure}

Figure \ref{figTree3D} shows an  example of a $3$-metric dimensional tree.   In this case $\mathcal{M}(T)=\{w,w'\}$, $\ter(w)=\ter(w')=2$ and $\varsigma(w)=\varsigma(w')=3$. Then Proposition \ref{propTauk} leads to $\dim_{3}(T)=\vert{\cal D}_3(T)\vert=|\{u_{1},u_{2},u_{3},u_{1}',u_{2}',u_{3}'\}|=6$. 

