codex
The script-owned metadata is now clean for the strengthened family, and the prior affine-only verdict is preserved separately. I’m doing one final independent small-graph audit by materializing the succinct graph, checking connectivity and neighborhoods, and recomputing the paper’s \(\min |D_G(x,y)|\) definition rather than relying on the optimized verifier.
exec
/bin/bash -lc "python3 - <<'PY'
from collections import deque
import gen_1312_6840 as g
for n in (13,17,19,23):
  for seed in range(5):
    inst=g.make_instance(n=n,seed=seed,rounds=2)
    (special,fold),why=g._validate_instance(inst)
    inv=pow(inst['label_multiplier'],-1,n)
    def base(v):
      x=inv*(v-inst['label_shift'])%n
      return fold if x==special else x if x<special else x-1
    adj=[set() for _ in range(n)]
    for u in range(n):
      for v in range(u+1,n):
        if abs(base(u)-base(v))==1:
          adj[u].add(v);adj[v].add(u)
    seen={0};q=deque([0])
    while q:
      u=q.popleft()
      for v in adj[u]-seen:seen.add(v);q.append(v)
    assert len(seen)==n
    twins=[[u,v] for u in range(n) for v in range(u+1,n)
           if v not in adj[u] and adj[u]==adj[v]]
    assert twins==[inst['answer']],(n,seed,twins,inst['answer'])
    d=[]
    for s in range(n):
      row=[n]*n;row[s]=0;q=deque([s])
      while q:
        u=q.popleft()
        for v in adj[u]:
          if row[v]==n:row[v]=row[u]+1;q.append(v)
      d.append(row)
    max_k=min(sum(d[z][u]"'!=d[z][v] for z in range(n))
              for u in range(n) for v in range(u+1,n))
    assert max_k==2
