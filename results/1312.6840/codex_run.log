NOTES: str = r"""
Definition and certificate. Section 1 defines a k-metric generator by requiring
every pair x,y to have at least k selected vertices at unequal distances from
x and y. Theorem 2.2 identifies the largest feasible k as
min_{x!=y}|D_G(x,y)|. Corollary 2.3 specializes this at k=2: a connected graph
is 2-metric dimensional exactly when it has twin vertices. This module asks for
the concrete twin pair that certifies that case, not for an unsupported proof.

What produces the certificate. A standard exact method evaluates the displayed
bijective update chain on successive base coordinates until its target is hit,
then checks the repeated neighborhood; this is O(n*rounds), and the planted
coordinate is restricted to the middle third so the scan performs millions of
modular updates at shipping size. That efficient algorithm makes Track A
inappropriate. Track B uses the compression gap: reverse the short affine
chain, then apply the visible vertex relabelling to the recovered coordinate
and to the exceptional coordinate n-1.

Inverse generation. The duplicated internal path coordinate f is sampled
first. Random invertible update rounds are applied forward to f to produce only
the displayed target. A random affine permutation then gives the two copies
their public vertex labels. Thus the answer exists before the instance data is
assembled and is never found by a search.

Exact graph. After undoing the public affine vertex labelling, canonical
indices 0..n-2 denote the corresponding vertices of a path. Canonical index
n-1 denotes a second copy of f. Two public vertices are adjacent exactly when
their base-path coordinates differ by one. The two copies of f are nonadjacent
and have identical open neighborhoods, so they are false twins. Every pair in
any connected graph is distinguished by its own two vertices, while this pair
is distinguished by no others; hence the maximum k is exactly two.

Easy regimes and attacks. Corollary 2.3 itself gives an efficient twin scan, so
the family is explicitly Track B. Degree endpoints, label order, random pairs,
treating the target as the preimage, and undoing only the last update all fail
on the audited seeds. The reference forward scan succeeds, as Track B requires.
""".strip()


_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)


def _random_unit(rng: random.Random, modulus: int) -> int:
    while True:
        value = rng.randrange(1, modulus)
        if math.gcd(value, modulus) == 1:
            return value


def _forward_chain(modulus: int, updates: list[list[int]], value: int) -> int:
    for sign, shift in updates:
        value = (sign * 2 * value + shift) % modulus
    return value


def _reverse_chain(modulus: int, updates: list[list[int]], target: int) -> int:
    """Invert y <- (+/-2)y+b modulo an odd modulus, exactly."""
    value = target
    for sign, shift in reversed(updates):
        residue = (value - shift) % modulus
        if sign == -1:
            residue = (-residue) % modulus
        value = residue // 2 if residue % 2 == 0 else (residue + modulus) // 2
    return value


def _compact_route_operations(inst: dict) -> int:
    # Six exact operations safely cover subtraction/reduction, optional sign
    # change, parity correction, and halving. Each final public label costs
    # multiply, add, reduce.
    return 6 * len(inst["updates"]) + 6


def _public_label(inst: dict, canonical: int) -> int:
    return (
        inst["label_multiplier"] * canonical + inst["label_shift"]
    ) % inst["n"]


def _validate_instance(inst: dict) -> tuple[int | None, str]:
    if not isinstance(inst, dict):
        return None, "instance is not a dictionary"
    n = inst.get("n")
    if isinstance(n, bool) or not isinstance(n, int) or n < 12 or n % 2:
        return None, "instance n must be an even integer at least 12"
    if inst.get("k") != 2:
        return None, "instance k must equal 2"
    multiplier = inst.get("label_multiplier")
    shift = inst.get("label_shift")
    if (
        isinstance(multiplier, bool)
        or not isinstance(multiplier, int)
        or not 1 <= multiplier < n
        or math.gcd(multiplier, n) != 1
    ):
        return None, "instance label multiplier is not a unit modulo n"
    if isinstance(shift, bool) or not isinstance(shift, int) or not 0 <= shift < n:
        return None, "instance label shift is out of range"
    updates = inst.get("updates")
    if not isinstance(updates, list) or not updates:
        return None, "instance update chain is empty or malformed"
    modulus = n - 1
    for index, update in enumerate(updates):
        if (
            not isinstance(update, list)
            or len(update) != 2
            or update[0] not in (-1, 1)
            or isinstance(update[1], bool)
            or not isinstance(update[1], int)
            or not 0 <= update[1] < modulus
        ):
            return None, f"instance update {index} is malformed"
    target = inst.get("target")
    if isinstance(target, bool) or not isinstance(target, int) or not 0 <= target < modulus:
        return None, "instance target is out of range"
    fold = _reverse_chain(modulus, updates, target)
    if not 2 <= fold <= modulus - 3:
        return None, "instance repeated coordinate is not internal to the base path"
    if _forward_chain(modulus, updates, fold) != target:
        return None, "instance update chain does not invert exactly"
    return fold, "ok"


def _build_from_fold(
    n: int,
    fold: int,
    label_multiplier: int,
    label_shift: int,
    updates: list[list[int]],
) -> dict:
    modulus = n - 1
    target = _forward_chain(modulus, updates, fold)
    inst = {
        "family": "modularly labelled one-vertex blow-up of a path",
        "n": n,
        "k": 2,
        "label_multiplier": label_multiplier,
        "label_shift": label_shift,
        "updates": updates,
        "target": target,
    }
    inst["answer"] = sorted(
        [_public_label(inst, fold), _public_label(inst, n - 1)]
    )
    return inst


def make_instance(n: int, seed: int = 0, rounds: int = 12, **params) -> dict:
    """Inverse-generate a succinct connected graph and its false-twin pair."""
    if params:
        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
