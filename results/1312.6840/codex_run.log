/bin/bash -lc "python3 - <<'PY'
import ast, importlib.util, json, os, random
path='gen_1312_6840.py'
spec=importlib.util.spec_from_file_location('g',path); g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
assert g.TRACK in {'A','B'}
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.SHIPPING_DIFFICULTY"'!='"'demo'
assert g.NATIVE['domain']==g.PROBLEM_PROFILE['native_domain']
assert g.NATIVE['core']==g.PROBLEM_PROFILE['computational_core']
assert g.NATIVE['objects']==g.PROBLEM_PROFILE['native_objects']
assert g.NATIVE['reduction']==g.PROBLEM_PROFILE['reduction']
p=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
i1=g.make_instance(seed=123,**p); i2=g.make_instance(seed=123,**p)
assert i1==i2
assert g.verify(i1,i1['answer'])==(True,'ok')
assert json.loads(json.dumps(i1['answer']))==i1['answer']
assert g.parse_answer('garbage') is None
assert g.parse_answer('prose <answer>'+json.dumps(i1['answer'])+'</answer> tail')==i1['answer']
os.environ.pop('GV_HINT_MODE',None); bare=g.render(i1)
os.environ['GV_HINT_MODE']='structural'; structural=g.render(i1)
os.environ['GV_HINT_MODE']='placebo'; placebo=g.render(i1)
assert g.STRUCTURAL_HINT not in bare and g.PLACEBO_HINT not in bare
assert g.STRUCTURAL_HINT in structural and g.PLACEBO_HINT in placebo
harder=g.escalate(p); assert isinstance(harder,dict) and harder['n']>p['n']
assert g._is_prime(harder['n'])
rep=json.load(open('selftest_report.json'))
assert rep['all_passed'] and all(v.get('pass') for k,v in rep.items() if k.startswith('G'))
for fn in ('llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl'):
 rows=[json.loads(line) for line in open(fn) if line.strip()]
 assert len(rows)==4 and all(r['solved']=='error' and r['http_status']==403 for r in rows)
print('final schema, determinism, rendering, and artifact checks: ok')
print('shipping answer:',i1['answer'])
print('shipping search space:',g.search_space(i1))
print('README lines:',sum(1 for _ in open('README.md')))
