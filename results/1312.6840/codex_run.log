+    # Count one operation for each Euclidean division used to invert an exponent,
+    # each square/multiply in binary modular powering, subtraction/reduction, and
+    # each arithmetic operation in the two public labels.
+    modulus = inst["n"]
+    total = 6
+    for exponent, _ in reversed(inst["special_updates"]):
+        divisions = _euclid_divisions(exponent, modulus - 1)
+        inverse_exponent = pow(exponent, -1, modulus - 1)
+        power_ops = inverse_exponent.bit_length() + inverse_exponent.bit_count()
+        total += divisions + power_ops + 2
