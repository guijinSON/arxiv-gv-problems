+++ b/gen_1312_6840.py
@@ -0,0 +1,1043 @@
+"""Planted 2-metric generators for arXiv:1312.6840.
+
+The native object is a simple connected graph.  A hidden vertex set is sampled
+first; edges are then sampled so that its graph-distance representations form
+a binary code of minimum Hamming distance two.  Thus the witness is known by
+inverse generation, while verification accepts every valid 2-metric generator.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import deque
+
+
+TRACK: str = "A"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "simple connected graph as an adjacency matrix",
+        "2-metric generator (fault-tolerant resolving set)",
+    ],
+    "verification_operations": [
+        "breadth-first shortest-path distance",
+        "integer distance comparison",
+        "pairwise distinguisher counting",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "constraint propagation",
+    "intuition_description": (
+        "In a diameter-two graph, chosen vertices are adjacency-code columns, "
+        "and every pair of vertex rows must differ in at least two chosen columns."
+    ),
+    "hardness_basis": (
+        "Track A: Schmitz--Vietz--Wanke (2023), Theorem 2, proves fixed "
+        "2-Metric Dimension NP-complete even for bipartite graphs; this native "
+        "dense diameter-two planted-code distribution has growing landmark "
+        "count and no known efficient recovery method, and the shipping exact "
+        "multicover baseline exhausts 100000 nodes (1.47 measured seconds on "
+        "the shipping seed) without a witness."
+    ),
+    "max_answer_tokens": 6,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON array of exactly r distinct 0-based vertex indices in strictly "
+        "increasing order; it denotes an r-subset of the N graph vertices."
+    ),
+    "bounds": {
+        "array_length": "inst['landmarks']",
+        "index_lower_inclusive": 0,
+        "index_upper_exclusive": "inst['n']",
+        "distinct": True,
+        "ordering": "strictly increasing",
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 8, "landmarks": 4, "edge_percent": 50},
+    "easy": {"n": 40, "landmarks": 8, "edge_percent": 44},
+    "medium": {"n": 72, "landmarks": 10, "edge_percent": 48},
+    "hard": {"n": 128, "landmarks": 12, "edge_percent": 50},
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT: str = (
+    "Because the graph has diameter two, landmark distance signatures are "
+    "adjacency columns with each landmark's diagonal entry treated as a third symbol."
+)
+PLACEBO_HINT: str = (
+    "This problem rewards careful bookkeeping across the displayed rows and "
+    "close attention to the required output conventions."
+)
+
+# Filled from the three isolated harden.py runs.  Keeping the measurements in
+# the module makes selftest() deterministic and leaves the transcripts as the
+# independently produced source of truth.
+G9_ORACLE_RESULTS: dict = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "blocked_api_quota",
+}
+
+NOTES: str = r"""
+Paper definition and triage. Section 1 defines a k-metric generator: every
+unordered pair of graph vertices must be distinguished, by unequal shortest-
+path distances, by at least k selected vertices. Theorem 2.2 says that the
+largest feasible k is min_{x!=y}|D_G(x,y)|. That value can be obtained by
+all-pairs shortest paths and a scan, so asking for it would fail Track A. This
+module instead asks for a size-r 2-metric generator, the minimum-basis decision
+search studied by the definition.
+
+Easy regimes avoided. Corollary 2.2 makes twins characterize 2-metric-
+dimensional graphs; Proposition 3.3 identifies paths with 2-metric dimension
+two; Proposition 2.5 and the following theorem give cycles and paths explicit
+formulae; and Theorems 4.1 and 4.3 give direct formulae and witnesses for
+trees. Generated graphs are dense, diameter two, twin-free, and have discrete
+color refinement, so none of those classifications supplies the answer.
+
+Hardness source. The original paper does not claim computational hardness.
+The later primary result Schmitz, Vietz and Wanke, "A note on the complexity of
+k-Metric Dimension" (2023), Theorem 2, proves NP-completeness for every fixed
+k>=2 even on bipartite graphs. We use fixed k=2. That is worst-case evidence,
+not a theorem about this planted distribution; G5, G6, and the oracle loop are
+the distribution-specific evidence.
+
+Inverse generation. The answer vertices are chosen before any edge. Their
+mutual edges are random. Every other vertex receives a random adjacency word
+on the answer coordinates, conditioned only so that (i) two outside words
+differ in at least two positions and (ii) an outside word differs from each
+landmark row away from that landmark's diagonal. Remaining edges are sampled
+from the same Bernoulli law. A diameter-two check turns adjacency words into
+exact distance words. The conditions then prove the planted set is a
+2-metric generator without searching for one. Vertex labels are randomized.
+
+Attacks. The panel tests degree/separation outliers, lexicographic selection,
+deterministic deficit-greedy selection, 256 randomized greedy restarts, several
+centered-adjacency spectral orderings, and capped exact set-multicover branching.
+The code words and noise edges use the same edge density, the answer is shuffled
+among all labels, and generation rejects non-discrete color refinement only to
+make canonicalization exact; no answer is recovered in that rejection check.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def _bernoulli(rng: random.Random, percent: int) -> bool:
+    return rng.randrange(100) < percent
+
+
+def _row_ints(rows: list[str]) -> list[int]:
+    return [int(row, 2) for row in rows]
+
+
+def _diameter_two(row_bits: list[int], n: int) -> bool:
+    full = (1 << n) - 1
+    for u in range(n):
+        if (row_bits[u] >> u) & 1:
+            return False
+        reached = row_bits[u] | (1 << u)
+        scan = row_bits[u]
+        while scan:
+            bit = scan & -scan
+            reached |= row_bits[bit.bit_length() - 1]
+            scan ^= bit
+        if reached != full:
+            return False
+    return True
+
+
+def _wl_order(row_bits: list[int], require_discrete: bool = False) -> list[int] | None:
+    """Canonical 1-WL order when refinement is discrete."""
+    n = len(row_bits)
+    signatures = [(row_bits[v].bit_count(),) for v in range(n)]
+    palette = {sig: i for i, sig in enumerate(sorted(set(signatures)))}
+    colors = [palette[sig] for sig in signatures]
+    for _ in range(n + 1):
+        signatures = []
+        for v in range(n):
+            neigh_colors = []
+            scan = row_bits[v]
+            while scan:
+                bit = scan & -scan
+                neigh_colors.append(colors[bit.bit_length() - 1])
+                scan ^= bit
+            signatures.append((colors[v], tuple(sorted(neigh_colors))))
+        palette = {sig: i for i, sig in enumerate(sorted(set(signatures)))}
+        new_colors = [palette[sig] for sig in signatures]
+        if new_colors == colors:
+            break
+        colors = new_colors
+    if len(set(colors)) != n:
+        return None if require_discrete else sorted(range(n), key=lambda v: (colors[v], v))
+    return sorted(range(n), key=lambda v: colors[v])
+
+
+def _pack_codewords(
+    rng: random.Random,
+    count: int,
+    r: int,
+    landmark_rows: list[int],
+    percent: int,
+) -> list[int] | None:
+    words: list[int] = []
+    trials = 0
+    max_trials = max(20_000, 2_000 * count)
+    while len(words) < count and trials < max_trials:
+        trials += 1
+        word = 0
+        for j in range(r):
+            if _bernoulli(rng, percent):
+                word |= 1 << j
+        if any((word ^ old).bit_count() < 2 for old in words):
+            continue
+        bad = False
+        for i, landmark_word in enumerate(landmark_rows):
+            mask_without_i = ((1 << r) - 1) ^ (1 << i)
+            if ((word ^ landmark_word) & mask_without_i) == 0:
+                bad = True
+                break
+        if not bad:
+            words.append(word)
+    return words if len(words) == count else None
+
+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    landmarks: int = 12,
+    edge_percent: int = 50,
+    **params,
+) -> dict:
+    """Inverse-generate a diameter-two graph and a known 2-metric generator."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    for name, value in (("n", n), ("landmarks", landmarks),
+                        ("edge_percent", edge_percent)):
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise TypeError(f"{name} must be an integer")
+    if n < 8:
+        raise ValueError("n must be at least 8")
+    if not 4 <= landmarks < n:
+        raise ValueError("landmarks must satisfy 4 <= landmarks < n")
+    if not 35 <= edge_percent <= 50:
+        raise ValueError("edge_percent must lie in 35..50")
+    if n - landmarks > (1 << (landmarks - 1)):
+        raise ValueError("too many vertices for the distance-two code budget")
+
+    rng = random.Random(seed)
+    # G: choose the witness first.  Every later random choice is made around it.
+    planted = sorted(rng.sample(range(n), landmarks))
+    planted_set = set(planted)
+    outside = [v for v in range(n) if v not in planted_set]
+    pos = {v: i for i, v in enumerate(planted)}
+
+    for _attempt in range(200):
+        rows = [0] * n
+        # Random landmark-landmark edges.
+        for ai, u in enumerate(planted):
+            for v in planted[ai + 1:]:
+                if _bernoulli(rng, edge_percent):
+                    rows[u] |= 1 << v
+                    rows[v] |= 1 << u
+        landmark_words = []
+        for u in planted:
+            word = 0
+            for v in planted:
+                if (rows[u] >> v) & 1:
+                    word |= 1 << pos[v]
+            landmark_words.append(word)
+
+        codes = _pack_codewords(
+            rng, len(outside), landmarks, landmark_words, edge_percent
+        )
+        if codes is None:
+            continue
+        for u, word in zip(outside, codes):
+            for j, v in enumerate(planted):
+                if (word >> j) & 1:
+                    rows[u] |= 1 << v
+                    rows[v] |= 1 << u
+        # All non-code coordinates are ordinary Bernoulli noise.
+        for ai, u in enumerate(outside):
+            for v in outside[ai + 1:]:
+                if _bernoulli(rng, edge_percent):
+                    rows[u] |= 1 << v
+                    rows[v] |= 1 << u
+        if not _diameter_two(rows, n):
+            continue
+        if _wl_order(rows, require_discrete=True) is None:
+            continue
+        matrix = [
+            "".join("1" if (row >> j) & 1 else "0" for j in range(n))
+            for row in rows
+        ]
+        inst = {
+            "family": "planted 2-metric generator in a diameter-two graph",
+            "n": n,
+            "k": 2,
+            "landmarks": landmarks,
+            "edge_percent": edge_percent,
+            "adjacency_rows": matrix,
+            "answer": planted,
+        }
+        ok, why = verify(inst, planted)
+        if not ok:
+            raise AssertionError("construction proof failed: " + why)
+        return inst
+    raise RuntimeError("could not sample a diameter-two asymmetric graph")
+
+
+def render(inst: dict) -> str:
+    rows = "\n".join(f"{i}: {row}" for i, row in enumerate(inst["adjacency_rows"]))
+    r = inst["landmarks"]
+    hint = ""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        hint = "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        hint = "\n\nHint: " + PLACEBO_HINT
+    example = list(range(r))
+    return f"""Fault-tolerant resolving landmarks (2-metric generator)
+
+You are given a simple, undirected, connected graph with vertices 0 through
+{inst['n'] - 1}. Graph distance d(x,y) is the number of edges in a shortest
+path from x to y. A vertex s distinguishes two distinct vertices x,y when
+d(s,x) != d(s,y).
+
+Find exactly {r} landmark vertices such that every unordered pair of distinct
+graph vertices is distinguished by at least k={inst['k']} different selected
+landmarks. This is called a 2-metric generator. The selected vertices must be
+distinct. Mathematically their order is irrelevant, but the output must list
+them in strictly increasing order as a unique encoding.
+
+The adjacency matrix is below. Row i is a {inst['n']}-character bit string;
+its character in position j (positions are counted from 0 at the left) is 1
+exactly when {{i,j}} is an edge. The diagonal is 0 and the matrix is symmetric.
+
+{rows}{hint}
+
+Give your final answer inside <answer></answer> tags as one JSON array of
+exactly {r} distinct, 0-based integers in strictly increasing order. Every
+integer must lie in 0..{inst['n'] - 1}; repeats are forbidden.
+Example format only: <answer>{json.dumps(example)}</answer>
+Output nothing else inside the tags."""
+
+
+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```") and body.endswith("```"):
+        body = re.sub(r"^```(?:json|python)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value
+
+
+def _validate_graph(inst: dict) -> tuple[list[int] | None, str]:
+    n = inst.get("n")
+    rows = inst.get("adjacency_rows")
+    if isinstance(n, bool) or not isinstance(n, int) or n < 2:
+        return None, "instance has invalid vertex count"
+    if not isinstance(rows, list) or len(rows) != n:
+        return None, "instance adjacency matrix has wrong row count"
+    if any(not isinstance(row, str) or len(row) != n or set(row) - {"0", "1"}
+           for row in rows):
+        return None, "instance adjacency row is malformed"
+    natural = []
+    for row in rows:
+        value = 0
+        for j, char in enumerate(row):
+            if char == "1":
+                value |= 1 << j
+        natural.append(value)
+    for i in range(n):
+        if (natural[i] >> i) & 1:
+            return None, f"instance has a loop at vertex {i}"
+        for j in range(i + 1, n):
+            if ((natural[i] >> j) & 1) != ((natural[j] >> i) & 1):
+                return None, f"instance adjacency is asymmetric at {i},{j}"
+    # Connectedness is required by the paper's definition.
+    seen = 1
+    frontier = 1
+    while frontier:
+        nxt = 0
+        scan = frontier
+        while scan:
+            bit = scan & -scan
+            nxt |= natural[bit.bit_length() - 1]
+            scan ^= bit
+        nxt &= ~seen
+        seen |= nxt
+        frontier = nxt
+    if seen != (1 << n) - 1:
+        return None, "instance graph is disconnected"
+    return natural, "ok"
+
+
+def _bfs_distances(rows: list[int], source: int) -> list[int]:
+    n = len(rows)
+    dist = [-1] * n
+    dist[source] = 0
+    queue = deque([source])
+    while queue:
+        u = queue.popleft()
+        scan = rows[u]
+        while scan:
+            bit = scan & -scan
+            v = bit.bit_length() - 1
+            scan ^= bit
+            if dist[v] < 0:
+                dist[v] = dist[u] + 1
+                queue.append(v)
+    return dist
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Verify any size-r 2-metric generator; never inspect inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if not answer:
+        return False, "answer is empty"
+    r = inst.get("landmarks")
+    n = inst.get("n")
+    if len(answer) != r:
+        return False, f"wrong number of landmarks: expected {r}, got {len(answer)}"
+    for position, value in enumerate(answer):
+        if isinstance(value, bool) or not isinstance(value, int):
+            return False, f"entry {position} is not an integer"
+        if not 0 <= value < n:
+            return False, f"vertex {value} is out of range 0..{n - 1}"
+    if len(set(answer)) != r:
+        return False, "a landmark vertex is repeated"
+    if any(answer[i] >= answer[i + 1] for i in range(r - 1)):
+        return False, "landmark vertices are not in strictly increasing order"
+    rows, why = _validate_graph(inst)
+    if rows is None:
+        return False, why
+    distances = [_bfs_distances(rows, s) for s in answer]
+    for x in range(n):
+        for y in range(x + 1, n):
+            distinguishers = sum(dist[x] != dist[y] for dist in distances)
+            if distinguishers < 2:
+                return False, (
+                    f"vertices {x} and {y} are distinguished by only "
+                    f"{distinguishers} selected landmark(s)"
+                )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    return sorted(rng.sample(range(inst["n"]), inst["landmarks"]))
+
+
+def search_space(inst: dict) -> int | None:
+    return math.comb(inst["n"], inst["landmarks"])
+
+
+def _coverage_masks(inst: dict) -> tuple[list[int], int]:
+    rows, why = _validate_graph(inst)
+    if rows is None:
+        raise ValueError(why)
+    n = inst["n"]
+    # Generated instances have diameter two, so the exact distance symbol is
+    # 0 on the diagonal, 1 on an edge and 2 otherwise.
+    if not _diameter_two(rows, n):
+        distances = [_bfs_distances(rows, s) for s in range(n)]
+    else:
+        distances = [
+            [0 if v == s else (1 if (rows[s] >> v) & 1 else 2)
+             for v in range(n)]
+            for s in range(n)
+        ]
+    covers = [0] * n
+    pair_bit = 1
+    for x in range(n):
+        for y in range(x + 1, n):
+            for s in range(n):
+                if distances[s][x] != distances[s][y]:
+                    covers[s] |= pair_bit
+            pair_bit <<= 1
+    return covers, pair_bit - 1
+
+
+def _fast_valid(covers: list[int], full: int, candidate: list[int]) -> bool:
+    once = twice = 0
+    for v in candidate:
+        cover = covers[v]
+        twice |= once & cover
+        once |= cover
+    return twice == full
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space is None or space > 2_000_000:
+        return None
+    covers, full = _coverage_masks(inst)
+    return sum(
+        _fast_valid(covers, full, list(candidate))
+        for candidate in itertools.combinations(range(inst["n"]), inst["landmarks"])
+    )
+
+
+def canonical_key(inst: dict) -> str:
+    """Exact canonical form on the generated (discrete-WL) graph class."""
+    rows, why = _validate_graph(inst)
+    if rows is None:
+        raise ValueError(why)
+    order = _wl_order(rows, require_discrete=True)
+    if order is None:
+        # Not reached for generated instances; this remains an invariant rather
+        # than smuggling labels into the key.
+        degrees = sorted(row.bit_count() for row in rows)
+        common = sorted((rows[u] & rows[v]).bit_count()
+                        for u in range(len(rows)) for v in range(u + 1, len(rows)))
+        payload = [inst["k"], inst["landmarks"], degrees, common]
+    else:
+        upper = []
+        for ai, u in enumerate(order):
+            for v in order[ai + 1:]:
+                upper.append("1" if (rows[u] >> v) & 1 else "0")
+        payload = [inst["k"], inst["landmarks"], len(rows), "".join(upper)]
+    raw = json.dumps(payload, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    out = {k: v for k, v in params.items() if k != "_preset"}
+    if "n" not in out or "landmarks" not in out:
+        return None
+    # First crowd the same fixed-length witness and erase density bias.  Only
+    # when the code budget is close do we add one landmark coordinate.
+    out["edge_percent"] = min(50, int(out.get("edge_percent", 50)) + 1)
+    proposed = math.ceil(int(out["n"]) * 5 / 4)
+    capacity = (1 << (int(out["landmarks"]) - 1)) + int(out["landmarks"])
+    if proposed <= min(capacity, 4096):
+        out["n"] = proposed
+        return out
+    if int(out["landmarks"]) < 64:
+        out["landmarks"] = int(out["landmarks"]) + 1
+        out["n"] = proposed
+        return out
+    return "cap_bound"
+
+
+def _candidate_from_order(inst: dict, order: list[int]) -> list[int] | None:
+    candidate = sorted(order[:inst["landmarks"]])
+    return candidate if verify(inst, candidate)[0] else None
+
+
+def _attack_lexicographic(inst: dict) -> list[int] | None:
+    return _candidate_from_order(inst, list(range(inst["n"])))
+
+
+def _attack_outliers(inst: dict, covers: list[int]) -> list[int] | None:
+    rows, _ = _validate_graph(inst)
+    assert rows is not None
+    n, r = inst["n"], inst["landmarks"]
+    degrees = [row.bit_count() for row in rows]
+    separation = [cover.bit_count() for cover in covers]
+    mean_degree = sum(degrees) / n
+    orders = [
+        sorted(range(n), key=lambda v: (-degrees[v], v)),
+        sorted(range(n), key=lambda v: (degrees[v], v)),
+        sorted(range(n), key=lambda v: (-separation[v], v)),
+        sorted(range(n), key=lambda v: (separation[v], v)),
+        sorted(range(n), key=lambda v: (-abs(degrees[v] - mean_degree), v)),
+        sorted(range(n), key=lambda v: (abs(degrees[v] - mean_degree), v)),
+    ]
+    for order in orders:
+        candidate = sorted(order[:r])
+        if _fast_valid(covers, (1 << (n * (n - 1) // 2)) - 1, candidate):
+            return candidate
+    return None
+
+
+def _greedy(
+    inst: dict,
+    covers: list[int],
+    full: int,
+    rng: random.Random | None = None,
+) -> list[int] | None:
+    r, n = inst["landmarks"], inst["n"]
+    selected: list[int] = []
+    once = twice = 0
+    available = set(range(n))
+    for _ in range(r):
+        scored = []
+        for v in available:
+            first = (covers[v] & ~once & full).bit_count()
+            second = (covers[v] & once & ~twice & full).bit_count()
+            scored.append((4 * second + first, v))
+        best = max(score for score, _ in scored)
+        choices = [v for score, v in scored if score == best]
+        if rng is None:
+            chosen = min(choices)
+        else:
+            # Randomized restricted candidate list, not a blind random subset.
+            threshold = best - max(1, best // 50)
+            choices = [v for score, v in scored if score >= threshold]
+            chosen = rng.choice(choices)
+        selected.append(chosen)
+        available.remove(chosen)
+        twice |= once & covers[chosen]
+        once |= covers[chosen]
+    candidate = sorted(selected)
+    return candidate if twice == full else None
+
+
+def _attack_random_restarts(
+    inst: dict, covers: list[int], full: int, rng: random.Random, restarts: int = 256
+) -> list[int] | None:
+    for _ in range(restarts):
+        candidate = _greedy(inst, covers, full, rng)
+        if candidate is not None:
+            return candidate
+    return None
+
+
+def _attack_spectral(inst: dict, covers: list[int], full: int, seed: int) -> list[int] | None:
+    rows, _ = _validate_graph(inst)
+    assert rows is not None
+    n, r = inst["n"], inst["landmarks"]
+    p = inst["edge_percent"] / 100.0
+    rng = random.Random(seed)
+    for _start in range(4):
+        vector = [rng.uniform(-1.0, 1.0) for _ in range(n)]
+        for _ in range(18):
+            total = sum(vector)
+            nxt = []
+            for i in range(n):
+                neigh_sum = 0.0
+                scan = rows[i]
+                while scan:
+                    bit = scan & -scan
+                    neigh_sum += vector[bit.bit_length() - 1]
+                    scan ^= bit
+                nxt.append(neigh_sum - p * (total - vector[i]))
+            norm = math.sqrt(sum(x * x for x in nxt)) or 1.0
+            vector = [x / norm for x in nxt]
+        orders = [
+            sorted(range(n), key=lambda v: (-vector[v], v)),
+            sorted(range(n), key=lambda v: (vector[v], v)),
+            sorted(range(n), key=lambda v: (-abs(vector[v]), v)),
+            sorted(range(n), key=lambda v: (abs(vector[v]), v)),
+        ]
+        for order in orders:
+            candidate = sorted(order[:r])
+            if _fast_valid(covers, full, candidate):
+                return candidate
+    return None
+
+
+def _attack_exact_multicover(
+    inst: dict, covers: list[int], full: int, node_limit: int = 100_000
+) -> tuple[list[int] | None, int]:
+    """Complete set-multicover branching, stopped at a documented node cap."""
+    n, r = inst["n"], inst["landmarks"]
+    distinguishers = [0] * (n * (n - 1) // 2)
+    for v, cover in enumerate(covers):
+        scan = cover
+        while scan:
+            bit = scan & -scan
+            distinguishers[bit.bit_length() - 1] |= 1 << v
+            scan ^= bit
+    nodes = 0
+
+    def search(once: int, twice: int, available: int, selected: list[int]):
+        nonlocal nodes
+        if nodes >= node_limit:
+            return None
+        nodes += 1
+        if twice == full:
+            if len(selected) <= r:
+                # Supersets preserve validity; fill deterministically to size r.
+                fill = [v for v in range(n)
+                        if (available >> v) & 1][:r - len(selected)]
+                if len(selected) + len(fill) == r:
+                    return sorted(selected + fill)
+            return None
+        slots = r - len(selected)
+        if slots <= 0 or available.bit_count() < slots:
+            return None
+        # Unit-demand lower bound from the best remaining column.
+        deficit_units = (2 * ((~once) & full).bit_count()
+                         + ((~twice) & once & full).bit_count())
+        best_gain = 0
+        scan_avail = available
+        while scan_avail:
+            bit = scan_avail & -scan_avail
+            v = bit.bit_length() - 1
+            best_gain = max(best_gain, (covers[v] & ~twice & full).bit_count())
+            scan_avail ^= bit
+        if best_gain == 0 or (deficit_units + best_gain - 1) // best_gain > slots:
+            return None
+
+        # Branch on a deficient pair.  This is the standard complete multicover
+        # branching rule; choosing the first bit keeps the measured node budget
+        # about search rather than an O(n^2) Python scan at every node.
+        need = (~twice) & full
+        pair_bit = need & -need
+        idx = pair_bit.bit_length() - 1
+        chosen_options = distinguishers[idx] & available
+        deficit = 2 if not ((once >> idx) & 1) else 1
+        if chosen_options.bit_count() < deficit:
+            return None
+        options_list = []
+        scan = chosen_options
+        while scan:
+            bit = scan & -scan
+            v = bit.bit_length() - 1
+            gain = (covers[v] & ~twice & full).bit_count()
+            options_list.append((-gain, v))
+            scan ^= bit
+        branch_available = available
+        for _neg_gain, v in sorted(options_list):
+            if not ((branch_available >> v) & 1):
+                continue
+            branch_available &= ~(1 << v)
+            cover = covers[v]
+            result = search(
+                once | cover,
+                twice | (once & cover),
+                branch_available,
+                selected + [v],
+            )
+            if result is not None:
+                return result
+            if nodes >= node_limit:
+                break
+        return None
+
+    candidate = search(0, 0, (1 << n) - 1, [])
+    return candidate, nodes
+
+
+def _relabel(inst: dict, rng: random.Random) -> dict:
+    n = inst["n"]
+    permutation = list(range(n))
+    rng.shuffle(permutation)  # old -> new
+    rows, why = _validate_graph(inst)
+    if rows is None:
+        raise ValueError(why)
+    new_rows = [0] * n
+    for u in range(n):
+        scan = rows[u]
+        while scan:
+            bit = scan & -scan
+            v = bit.bit_length() - 1
+            new_rows[permutation[u]] |= 1 << permutation[v]
+            scan ^= bit
+    transformed = {
+        key: value for key, value in inst.items()
+        if key not in ("adjacency_rows", "answer")
+    }
+    transformed["adjacency_rows"] = [
+        "".join("1" if (row >> j) & 1 else "0" for j in range(n))
+        for row in new_rows
+    ]
+    transformed["answer"] = sorted(permutation[v] for v in inst["answer"])
+    return transformed
+
+
+def _answer_size(answer: object) -> tuple[int, int, int]:
+    blob = json.dumps(answer, separators=(",", ":"))
+
+    def atoms(value: object) -> int:
+        if isinstance(value, dict):
+            return sum(atoms(v) for v in value.values())
+        if isinstance(value, list):
+            return sum(atoms(v) for v in value)
+        return 1
+
+    return len(blob), math.ceil(len(blob) / 4), atoms(answer)
+
+
+def selftest() -> dict:
+    report: dict = {
+        "paper": "1312.6840",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    verified = attempted = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 2):
+            attempted += 1
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            if not ok:
+                raise AssertionError(f"G1 {preset}/{seed}: {why}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                raise AssertionError("answer is not JSON-native")
+            verified += 1
+    report["G1_planted_verifies"] = {
+        "pass": verified == attempted, "verified": verified, "attempted": attempted
+    }
+
+    base = make_instance(seed=12345, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    answer = base["answer"]
+    corruptions = {
+        "drop_one": answer[:-1],
+        "swap_two": [answer[1], answer[0]] + answer[2:],
+        "duplicate": answer[:-1] + [answer[-2]],
+        "empty": [],
+        "out_of_range": answer[:-1] + [base["n"]],
+    }
+    reasons = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(base, candidate)
+        if ok:
+            raise AssertionError(f"G2 accepted {name}")
+        reasons[name] = why
+    if len(set(reasons.values())) != len(reasons):
+        raise AssertionError("G2 reasons are not distinct: " + repr(reasons))
+    report["G2_rejects_corruption"] = {
+        "pass": True, "rejected": len(reasons), "attempted": len(reasons),
+        "reasons": reasons,
+    }
+
+    response = (
+        "I used the distance signatures.\n```json\n<answer>\n"
+        + json.dumps(answer) + "\n</answer>\n```\nThe pair checks agree."
+    )
+    parsed = parse_answer(response)
+    if parsed != answer:
+        raise AssertionError("G3 realistic response did not round-trip")
+    report["G3_round_trip"] = {
+        "pass": True, "entries_recovered": len(answer),
+        "prose": True, "markdown_fence": True,
+    }
+
+    shipping = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    covers, full = _coverage_masks(shipping)
+    samples = 200_000
+    guess_rng = random.Random(271828)
+    hits = 0
+    for _ in range(samples):
+        candidate = random_candidate(shipping, guess_rng)
+        if _fast_valid(covers, full, candidate):
+            if not verify(shipping, candidate)[0]:
+                raise AssertionError("fast exact G4 predicate disagrees with verify")
+            hits += 1
+    probability = hits / samples
+    if probability >= 1e-6:
+        raise AssertionError(f"G4 guess probability {hits}/{samples}")
+    report["G4_guess_resistance"] = {
+        "pass": True, "hits": hits, "samples": samples,
+        "measured_probability": probability,
+        "candidate_space": str(search_space(shipping)),
+        "prior": "uniform sorted r-subset of all graph vertices",
+    }
+
+    small_counts = []
+    for seed in (5, 6, 7):
+        small = make_instance(seed=seed, **DIFFICULTY["demo"])
+        count = enumerate_all(small)
+        if count is None:
+            raise AssertionError("demo enumeration unexpectedly capped")
+        small_counts.append({
+            "n": small["n"], "seed": seed, "valid_answers": count,
+            "candidate_space": search_space(small),
+            "solution_fraction": count / search_space(small),
+        })
+    start = time.perf_counter()
+    exact_candidate, exact_nodes = _attack_exact_multicover(
+        shipping, covers, full, 100_000
+    )
+    exact_seconds = time.perf_counter() - start
+    exact_solved = exact_candidate is not None and verify(shipping, exact_candidate)[0]
+    if exact_solved or exact_nodes != 100_000:
+        raise AssertionError(
+            f"G5 baseline did not exhaust cap: solved={exact_solved}, nodes={exact_nodes}"
+        )
+    report["G5_density_and_baseline"] = {
+        "pass": True,
+        "shipping_preset": SHIPPING_DIFFICULTY,
+        "shipping_n": shipping["n"],
+        "shipping_seed": 314159,
+        "density_method": "sampled exact predicate on random_candidate",
+        "density_hits": hits,
+        "density_samples": samples,
+        "observed_solution_fraction": probability,
+        "enumerate_all_shipping": enumerate_all(shipping),
+        "baseline_attack": "exact_set_multicover_branching",
+        "baseline_solved": exact_solved,
+        "baseline_wall_seconds": round(exact_seconds, 6),
+        "baseline_nodes": exact_nodes,
+        "baseline_node_limit": 100_000,
+        "additional_demo_exact_counts": small_counts,
+    }
+
+    attack_names = (
+        "lexicographic_first_r",
+        "degree_and_separation_outliers",
+        "deficit_greedy",
+        "randomized_greedy_256_restarts",
+        "centered_adjacency_spectral",
+        "exact_set_multicover_100000_nodes",
+    )
+    successes = {name: 0 for name in attack_names}
+    node_counts = []
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        local_covers, local_full = _coverage_masks(inst)
+        exact, nodes = _attack_exact_multicover(
+            inst, local_covers, local_full, 100_000
+        )
+        node_counts.append(nodes)
+        candidates = {
+            attack_names[0]: _attack_lexicographic(inst),
+            attack_names[1]: _attack_outliers(inst, local_covers),
+            attack_names[2]: _greedy(inst, local_covers, local_full),
+            attack_names[3]: _attack_random_restarts(
+                inst, local_covers, local_full, random.Random(90_000 + seed), 256
+            ),
+            attack_names[4]: _attack_spectral(
+                inst, local_covers, local_full, 100_000 + seed
+            ),
+            attack_names[5]: exact,
+        }
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(inst, candidate)[0]:
+                successes[name] += 1
+    if any(successes.values()):
+        raise AssertionError("G6 attack succeeded: " + repr(successes))
+    report["G6_adversary_panel"] = {
+        "pass": True,
+        "attacks": {
+            name: {"successes": successes[name], "attempts": 8}
+            for name in attack_names
+        },
+        "domain_standard_attack": attack_names[-1],
+        "exact_node_counts": node_counts,
+    }
+
+    base_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    doubled_params = dict(base_params)
+    doubled_params["n"] *= 2
+    # Give the doubled instance enough code coordinates without making the
+    # generator rely on the conspicuous even-parity code.
+    doubled_params["landmarks"] += 2
+    doubled = make_instance(seed=77, **doubled_params)
+    ok, why = verify(doubled, doubled["answer"])
+    if not ok:
+        raise AssertionError("G7 doubled instance: " + why)
+    report["G7_scales"] = {
+        "pass": True,
+        "base_n": base_params["n"],
+        "doubled_n": doubled_params["n"],
+        "base_answer_length": base_params["landmarks"],
+        "doubled_answer_length": doubled_params["landmarks"],
+        "base_space": str(search_space(shipping)),
+        "doubled_space": str(search_space(doubled)),
+        "doubled_planted_verifies": True,
+    }
+
+    invariant = carried = 0
+    unrelated_keys = []
+    key_params = DIFFICULTY["easy"]
+    for seed in range(20):
+        inst = make_instance(seed=10_000 + seed, **key_params)
+        transformed = _relabel(inst, random.Random(20_000 + seed))
+        if canonical_key(inst) != canonical_key(transformed):
+            raise AssertionError(f"G8 relabelling changed key at seed {seed}")
+        invariant += 1
+        ok, why = verify(transformed, transformed["answer"])
+        if not ok:
+            raise AssertionError(f"G8 carried witness at seed {seed}: {why}")
+        carried += 1
+        unrelated_keys.append(canonical_key(inst))
+    distinct = len(set(unrelated_keys))
+    if distinct != 20:
+        raise AssertionError(f"G8 unrelated distinctness {distinct}/20")
+    report["G8_canonical_key"] = {
+        "pass": True,
+        "invariance_transformations": invariant,
+        "carried_witnesses_verified": carried,
+        "unrelated_keys_distinct": distinct,
+        "unrelated_keys_tested": 20,
+        "symmetries": ["arbitrary vertex relabelling"],
+        "method": "exact adjacency canonicalization after discrete 1-WL refinement",
+    }
+
+    chars, tokens, elements = _answer_size(shipping["answer"])
+    PROBLEM_PROFILE["max_answer_tokens"] = tokens
+    arms = G9_ORACLE_RESULTS
+    hinted_verdict = arms.get("hinted_verdict")
+    hinted_still_hardened = (
+        hinted_verdict == "hardened"
+        and arms["hinted"]["solved"] == 0
+        and arms["hinted"]["attempts"] >= 3
+    )
+    within_caps = chars <= 2000 and elements <= 256 and 3 * shipping["landmarks"] <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_still_hardened and within_caps,
+        "arms": {
+            name: dict(arms[name]) for name in ("bare", "hinted", "placebo")
+        },
+        "hinted_minus_placebo": (
+            arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+            - arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+            if arms["hinted"]["attempts"] and arms["placebo"]["attempts"]
+            else None
+        ),
+        "hinted_verdict": hinted_verdict,
+        "answer_chars": chars,
+        "answer_tokens": tokens,
+        "answer_elements": elements,
+        "intended_route_operations": 3 * shipping["landmarks"],
+        "operation_model": (
+            "three exact pair-mask updates per recognized landmark column; "
+            "search for the columns is the structural task"
+        ),
+    }
+    report["all_passed"] = all(
+        value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
