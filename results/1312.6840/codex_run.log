/bin/bash -lc "python3 - <<'PY'
import gen_1312_6840 as g
for n in (12, 14, 20, 30):
    for seed in range(10):
        inst = g.make_instance(n=n, rounds=3, seed=seed)
        fold, why = g._validate_instance(inst)
        assert fold is not None, why
        inv = pow(inst['label_multiplier'], -1, n)
        def base(v):
            x = inv * (v - inst['label_shift']) % n
            return fold if x == n - 1 else x
        neigh = [frozenset(w for w in range(n) if w "'!= v and abs(base(v)-base(w)) == 1)
                 for v in range(n)]
        twins = [[u,v] for u in range(n) for v in range(u+1,n)
                 if v not in neigh[u] and neigh[u] == neigh[v]]
        assert twins == [inst['"'answer']], (n, seed, twins, inst['answer'])
        assert g.verify(inst, twins[0]) == (True, 'ok')
print('expanded false-twin uniqueness: 40/40')
print('garbage parse:', g.parse_answer('no tagged answer here'))
