     return None
 
 
+def _deficit_units(covers: list[int], full: int, selected: set[int]) -> int:
+    """Number of still-missing pair/landmark incidences (zero is feasible)."""
+    once = twice = 0
+    for v in selected:
+        cover = covers[v]
+        twice |= once & cover
+        once |= cover
+    uncovered = ((~once) & full).bit_count()
+    covered_once = (once & ~twice & full).bit_count()
+    return 2 * uncovered + covered_once
+
+
+def _attack_min_conflicts(
+    inst: dict,
+    covers: list[int],
+    full: int,
+    seed: int,
+    steps: int = 100_000,
+) -> tuple[list[int] | None, int, int]:
+    """Random-swap min-conflicts with a periodically reheated annealing move."""
+    n, r = inst["n"], inst["landmarks"]
+    rng = random.Random(seed)
+    selected = set(rng.sample(range(n), r))
+    current = _deficit_units(covers, full, selected)
+    best = current
+    for iteration in range(steps):
+        if current == 0:
+            return sorted(selected), best, iteration
+        removed = rng.choice(tuple(selected))
+        added = rng.randrange(n)
+        if added in selected:
+            continue
+        proposal = (selected - {removed}) | {added}
+        proposed = _deficit_units(covers, full, proposal)
+        temperature = max(0.05, 3.0 * (1.0 - (iteration % 5_000) / 5_000))
+        if proposed <= current or rng.random() < math.exp(
+            (current - proposed) / temperature
+        ):
+            selected = proposal
+            current = proposed
+            best = min(best, current)
+    return None, best, steps
+
+
 def _attack_spectral(inst: dict, covers: list[int], full: int, seed: int) -> list[int] | None:
     rows, _ = _validate_graph(inst)
     assert rows is not None

