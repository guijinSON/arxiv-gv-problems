import random,time,math
import gen_1312_6840 as g

def obj(covers,full,S):
    once=twice=0
    for v in S:
        c=covers[v]; twice|=once&c; once|=c
    zero=((~once)&full).bit_count(); one=((once & ~twice)&full).bit_count()
    return 2*zero+one,zero,one

def attack(inst, seed, steps=200000):
 c,full=g._coverage_masks(inst); n=inst[\"n\"];r=inst[\"landmarks\"]; rng=random.Random(seed); S=set(rng.sample(range(n),r)); cur=obj(c,full,S)[0]; best=(cur,sorted(S));
 for it in range(steps):
