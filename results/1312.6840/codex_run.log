+    if inst.get("k") != 2:
+        return None, "instance k must equal 2"
+    multiplier = inst.get("label_multiplier")
+    shift = inst.get("label_shift")
+    if (
+        isinstance(multiplier, bool)
+        or not isinstance(multiplier, int)
