\title{The $k$-metric dimension of a graph}


\author{Alejandro Estrada-Moreno$^{(1)}$, Juan A. Rodr\'{\i}guez-Vel\'{a}zquez$^{(1)}$,\\ and Ismael G. Yero$^{(2)}$
