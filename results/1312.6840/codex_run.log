+        divisions = _euclid_divisions(exponent, modulus - 1)
+        inverse_exponent = pow(exponent, -1, modulus - 1)
+        power_ops = inverse_exponent.bit_length() + inverse_exponent.bit_count()
+        total += divisions + power_ops + 2
