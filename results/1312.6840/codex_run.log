+def _reverse_chain(modulus: int, updates: list[list[int]], target: int) -> int:
+    """Invert y <- (+/-2)y+b modulo an odd modulus, exactly."""
+    value = target
+    for sign, shift in reversed(updates):
+        residue = (value - shift) % modulus
+        if sign == -1:
+            residue = (-residue) % modulus
+        value = residue // 2 if residue % 2 == 0 else (residue + modulus) // 2
+    return value
 
 
