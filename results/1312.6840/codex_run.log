        "hinted_verdict": hinted_verdict,
        "answer_chars": chars,
        "answer_tokens": tokens,
        "answer_elements": elements,
        "intended_route_operations": intended_operations,
        "operation_model": (
            "at most six exact operations per reversed update plus three per "
