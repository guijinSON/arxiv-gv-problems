+
+
+def selftest() -> dict:
+    """Run the mandatory G1--G8 gates and return JSON-serializable evidence."""
+    report: dict[str, object] = {}
+
+    # G1: every named preset, several seeds.
+    g1_total = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in range(5):
