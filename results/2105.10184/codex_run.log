+    # G8: reorderings, local relabellings, class relabellings, and their
+    # composition. Every carried witness is checked as a real semantic audit.
+    invariant_checks = 0
+    carried_checks = 0
+    invariant_failures = []
+    carried_failures = []
+    distinct_keys = []
