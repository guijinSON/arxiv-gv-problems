+    report["G4_guess_resistance"] = {
+        "pass": hits / trials < 1e-6,
+        "hits": hits,
+        "total": trials,
+        "observed_probability": hits / trials,
+        "structure_aware_space": pow(guess_inst["part_size"], guess_inst["n"]),
+        "naive_group_product": search_space(guess_inst),
