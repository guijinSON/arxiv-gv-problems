+    attack_results = {
+        "triangle_outlier": {"successes": 0, "seeds": 8},
+        "left_to_right_greedy": {"successes": 0, "seeds": 8},
+        "random_restart_mrv_32": {"successes": 0, "seeds": 8},
+    }
