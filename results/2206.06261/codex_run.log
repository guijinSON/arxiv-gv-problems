    modulus = params.pop("modulus", 65537)
    degree_pad = params.pop("degree_pad", 128)
    if params:
        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
    for name, value, lower in (("n", n, 2), ("modulus", modulus, 3),
