# Internal sparse polynomials are dictionaries exponent -> integer coefficient.


def _clean(p):
    return {int(e): int(c) for e, c in p.items() if c}


def _p_add(*polys):
    out = {}
    for p in polys:
        for e, c in p.items():
            out[e] = out.get(e, 0) + c
            if out[e] == 0:
                del out[e]
    return out


def _p_scale(p, k):
    return _clean({e: k * c for e, c in p.items()})


def _p_mul(p, q):
    out = {}
    for e, a in p.items():
        for f, b in q.items():
            out[e + f] = out.get(e + f, 0) + a * b
