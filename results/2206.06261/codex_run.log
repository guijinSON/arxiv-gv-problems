+
+DIFFICULTY: dict = {
+    "demo": {"n": 5, "public_exponent": 7},
+    "easy": {"n": 512, "public_exponent": 65537},
+    "medium": {"n": 640, "public_exponent": 65537},
+    "hard": {"n": 768, "public_exponent": 65537},
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT: str = (
