+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "a nodal curve y^2 = x(x^2-a)^2 over Z/NZ",
+        "a balanced Blum semiprime public modulus",
+        "the factorization trapdoor and canonical private exponent",
