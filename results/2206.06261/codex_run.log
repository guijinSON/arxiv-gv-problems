+def _attack_fermat(inst, steps=_FERMAT_STEPS):
+    modulus = inst["modulus"]
+    x = math.isqrt(modulus)
+    if x * x < modulus:
+        x += 1
+    for iteration in range(1, steps + 1):
+        square = x * x - modulus
+        y = math.isqrt(square)
+        if y * y == square:
+            factor = x - y
+            return _answer_from_factor(inst, factor), iteration
+        x += 1
+    return None, steps
