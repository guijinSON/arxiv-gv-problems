/bin/bash -lc "python3 - <<'PY'
import json

def labels(j,k):
    N=2*j**k
    out=[[],[]] if j==2 else [[] for _ in range(j)]
    for x in range(N):
        q=x//(j**(k-1))
        b=q if q<j else 2*j-1-q
        ds=[]; y=x
        for _ in range(k-1):
            ds.append(y%j); y//=j
        g=sum((1 if s%2==0 else -1)*ds[s] for s in range(k-1)) + ((-1)**(k-1))*b
        out[g%j].append(x+1)
    return out
for j,k in [(2,7),(3,4),(4,3)]:
    a=labels(j,k)
    ok=all(sum(v**r for v in a[0])==sum(v**r for v in group) for group in a[1:] for r in range(1,k+1))
    blob=json.dumps(a,separators=(',',':'))
    updates=sum(2*j**t for t in range(2,k+1))
    print(j,k,2*j**k,ok,len(blob),(len(blob)+3)//4,updates)
