+            (element_perm, identity_sets),
+            (identity_elements, set_order),
+            (element_perm, set_order),
+        ]
+        for ep, so in transforms:
+            moved, moved_answer = _relabel_instance(inst, ep, so)
+            invariant_checks += 1
