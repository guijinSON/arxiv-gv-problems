+        "preset_candidate_spaces": dict(zip(DIFFICULTY, ladder_spaces)),
+        "doubled_n": doubled["n"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+        "fixed_answer_length_axis_after_hard": "increase p at n=96",
+    }
+
+    invariant_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    unrelated_keys = []
