+        framed = _transform_frame(inst, 19 - seed, seed - 7, True)
+        composed = _transform_frame(
+            _reorder_boundary(relabelled, 5 + seed, True), -13, 29, True
+        )
+        for number, moved in enumerate(
+            (relabelled, reordered, framed, composed)
