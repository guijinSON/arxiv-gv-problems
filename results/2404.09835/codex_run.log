+    reference_successes = 0
+    reference_operations = 0
+    reference_walls = []
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed, **shipping)
+
+        start = time.perf_counter()
+        candidate = _attack_outlier_rank(inst)
+        elapsed = time.perf_counter() - start
