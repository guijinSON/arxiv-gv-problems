+
+        start = time.perf_counter()
+        candidate = _attack_identity(inst)
+        elapsed = time.perf_counter() - start
+        stat = attack_stats["direct_offset_as_key"]
+        stat["attempts"] += 1
+        stat["successes"] += int(verify(inst, candidate)[0])
+        stat["steps"] += inst["n"]
+        stat["wall_clock_sec"] += elapsed
+
