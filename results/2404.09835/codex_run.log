+def parse_answer(text) -> object | None:
+    """Parse tagged JSON, fenced JSON, or a JSON matrix surrounded by prose."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if match:
+        return _json_from_fragment(match.group(1))
