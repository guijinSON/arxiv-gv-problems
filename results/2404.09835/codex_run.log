+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate a compressed perfect packing of a simple grid polygon."""
+    del params
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4:
+        raise ValueError("n must be an integer at least 4")
+    p = None
+    # p is positional through the public signature but retained in **params by
+    # callers that pass unusual dictionaries.  Fetching it here would be too late,
+    # so the explicit wrapper below supplies it through this sentinel branch.
+    raise RuntimeError("internal make_instance dispatch failure")
+
+
+def _make_instance(n: int, p: int, seed: int = 0) -> dict:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4:
+        raise ValueError("n must be an integer at least 4")
+    if not _is_prime(p) or p <= n:
+        raise ValueError("p must be prime and greater than n")
+    rng = random.Random(seed)
+    rho = _random_cycle(n, rng)
+    matrix = _inverse_two_tap(n, p, rho)
