+        order = list(range(inst["n"]))
+        rng.shuffle(order)
+        relabelled = _relabel_decoder(inst, order)
+        reordered = _reorder_boundary(inst, 3 + seed, bool(seed & 1))
+        framed = _transform_frame(inst, 19 - seed, seed - 7, True)
+        composed = _transform_frame(
+            _reorder_boundary(relabelled, 5 + seed, True), -13, 29, True
