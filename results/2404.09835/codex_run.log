+
+    attack_names = (
+        "outlier_offset_rank",
+        "greedy_diagonal_fit",
+        "random_restart_256",
+        "direct_offset_as_key",
+    )
+    attack_stats = {
+        name: {"successes": 0, "attempts": 0, "steps": 0,
