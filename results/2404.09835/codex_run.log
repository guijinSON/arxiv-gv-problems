+def _reorder_boundary(inst: dict, shift: int, reverse: bool) -> dict:
+    moved = dict(inst)
+    vertices = [list(v) for v in inst["polygon"]]
+    shift %= len(vertices)
+    vertices = vertices[shift:] + vertices[:shift]
+    if reverse:
+        vertices.reverse()
+    moved["polygon"] = vertices
+    moved["answer"] = [list(inst["answer"][0])]
+    return moved
+
