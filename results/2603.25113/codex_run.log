+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_fraction,
+        "structure_aware_space_bits": search_space(inst).bit_length(),
+        "wall_clock_sec": round(guess_seconds, 6),
