+def _greedy_candidate(inst, order, conflicts0, conflicts2):
+    answer = [-1] * inst["num_vertices"]
+    for u in order:
+        chosen = None
+        for color in range(4):
+            conflicts = conflicts0[u] if color == 0 else conflicts2[u]
+            if all(answer[v] != color for v in conflicts):
+                chosen = color
+                break
+        if chosen is None:
+            return answer
+        answer[u] = chosen
+    return answer
