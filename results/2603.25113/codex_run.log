+    for u in degree3:
+        answer[u] = 1 if u < partners[u] else 2
+        for vertex in arms[u]:
+            answer[vertex] = 0
+    used = set()
+    for u in degree3:
+        v = connector[u]
+        edge = (min(u, v), max(u, v))
+        if edge in used:
+            continue
+        used.add(edge)
+        internal = paths[u]
+        colors = [0, 3, 0] if len(internal) == 3 else [0, 3]
+        for vertex, color in zip(internal, colors):
+            answer[vertex] = color
+    return answer
