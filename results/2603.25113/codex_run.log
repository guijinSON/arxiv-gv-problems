+        [min(permutation[u], permutation[v]), max(permutation[u], permutation[v])]
+        for u, v in inst["edges"]
+    ]
+    if reorder_edges:
+        edges.reverse()
+    out["edges"] = edges
+    carried = [0] * n_vertices
+    for old, new in enumerate(permutation):
+        carried[new] = inst["answer"][old]
+    out["answer"] = carried
+    return out
