+    return {
+        "family": "local-girth (1,2,2,2)-packing coloring",
+        "n": n,
+        "irregularity": irregularity,
+        "num_vertices": total,
+        "thresholds": [1, 2, 2, 2],
+        "edges": [list(edge) for edge in visible_edges],
+        "answer": answer,
+    }
