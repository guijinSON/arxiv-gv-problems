+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    bodies = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    if not bodies:
+        return None
+    for body in reversed(bodies):
+        cleaned = body.strip()
+        cleaned = re.sub(r"^```(?:json)?\s*", "", cleaned, flags=re.I)
+        cleaned = re.sub(r"\s*```$", "", cleaned)
