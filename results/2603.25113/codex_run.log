+
+def _all_pairs_bfs_cost(inst):
+    """Mechanical local-girth/distance preprocessing used by the reference route."""
+    adj = _adjacency(inst)
+    queue_pops = 0
+    edge_inspections = 0
+    for source in range(len(adj)):
+        distances = [-1] * len(adj)
