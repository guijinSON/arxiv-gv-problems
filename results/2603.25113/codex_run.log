+    # For radii 2, inspect exactly the closed two-hop neighborhood of each vertex.
+    for u in range(n_vertices):
+        color = answer[u]
+        if color == 0:
+            continue
+        near = set(adj[u])
+        for w in adj[u]:
+            near.update(adj[w])
+        near.discard(u)
+        for v in near:
