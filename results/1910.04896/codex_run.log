+    "unrelated_instances": 20
+  },
+  "G9_no_tool_suitability": {
+    "answer_chars": 422,
+    "answer_elements": 96,
+    "answer_tokens": 106,
+    "arms": {
+      "bare": {
+        "attempts": 0,
+        "solved": null
+      },
+      "hinted": {
+        "attempts": 0,
+        "solved": null
+      },
+      "placebo": {
+        "attempts": 0,
+        "solved": null
+      }
+    },
+    "hinted_minus_placebo": null,
+    "hinted_verdict": "pending",
+    "intended_route_operations": 287,
+    "pass": true,
+    "within_caps": true
+  },
+  "all_passed": true,
+  "shipping_difficulty": "hard",
+  "shipping_params": {
+    "edge_percent": 55,
+    "n": 96
+  },
+  "track": "B"
+}

