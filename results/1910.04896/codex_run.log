@@ -0,0 +1,168 @@
+{
+  "G1_planted_verifies": {
+    "attempts": 12,
+    "failures": [],
+    "pass": true
+  },
+  "G2_rejects_corruption": {
+    "cases": {
+      "drop": {
+        "accepted": false,
+        "reason": "wrong class size: expected 96, got 95"
+      },
+      "duplicate": {
+        "accepted": false,
+        "reason": "vertex indices must be distinct"
