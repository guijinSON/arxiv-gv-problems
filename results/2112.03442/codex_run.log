+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+DIFFICULTY = {
+    "demo": {"n": 4, "sparsity": 2, "scale_max": 3},
+    "easy": {"n": 64, "sparsity": 4, "scale_max": 3},
