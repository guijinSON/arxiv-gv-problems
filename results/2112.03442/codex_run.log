+
+def escalate(params):
+    out = dict(params)
+    out.pop("_preset", None)
+    n = out.get("n")
+    if not _is_int(n):
+        return None
+    if n >= CERTIFICATE_LANGUAGE["bounds"]["max_players_per_side"]:
+        return "cap_bound"
