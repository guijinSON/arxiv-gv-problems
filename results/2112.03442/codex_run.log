            spectrum_input[transformed_row] = rec["force"] // rec["scale"]
        transformed = _fwht(spectrum_input)
        code_to_id = {r["code"]: r["id"] for r in inst["groups"][target_side]}
        terms = []
        for code, value in enumerate(transformed):
