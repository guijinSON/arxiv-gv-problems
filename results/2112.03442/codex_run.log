def _edge(u, v):
    return (u, v) if u < v else (v, u)


def _adjacency(n, edges):
    adj = [[] for _ in range(n)]
    for u, v in edges:
        adj[u].append(v)
        adj[v].append(u)
    for row in adj:
        row.sort()
    return adj


def _random_ktree(n, width, rng):
    """Return a maximal width-tree and one PEO, both on temporary labels."""
    base = list(range(n - width - 1, n))
    edges = {_edge(u, v) for u, v in itertools.combinations(base, 2)}
    cliques = [tuple(c) for c in itertools.combinations(base, width)]
    seen = set(cliques)
    for v in range(n - width - 2, -1, -1):
        chosen = cliques[rng.randrange(len(cliques))]
        for u in chosen:
            edges.add(_edge(u, v))
        for omitted in range(width):
            new_clique = tuple(sorted((v,) + chosen[:omitted] + chosen[omitted + 1 :]))
            if new_clique not in seen:
                seen.add(new_clique)
                cliques.append(new_clique)
    return sorted(edges), list(range(n))


def _forced_coloring(n, k, h_adj, order):
    """Greedy H-coloring backwards along a PEO; maximality makes it forced."""
    pos = {v: i for i, v in enumerate(order)}
    colors = [0] * n
    for v in reversed(order):
        used = {colors[u] for u in h_adj[v] if pos[u] > pos[v] and colors[u]}
        colors[v] = next(c for c in range(1, k + 1) if c not in used)
    return colors


