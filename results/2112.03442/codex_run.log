    a = colors[start]
    if other == a:
        return [start]
    allowed = {a, other}
    seen = {start}
    stack = [start]
    while stack:
        v = stack.pop()
        for u in adj[v]:
            if counter is not None:
                counter["edge_scans"] += 1
            if u not in seen and colors[u] in allowed:
                seen.add(u)
                stack.append(u)
    return sorted(seen)


