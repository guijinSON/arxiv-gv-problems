+        rng.shuffle(chosen)
+        terms = []
+        moved = False
+        for rec, weight in zip(chosen, weights):
+            signed = weight if rng.randrange(2) else -weight
+            terms.append([rec["id"], signed])
+            moved = moved or (_matvec(rows, rec["code"]) != rec["code"])
