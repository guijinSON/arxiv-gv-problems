+        "outlier_absolute_force": {"successes": 0, "attempts": attack_attempts},
+        "greedy_uniform_best_response": {"successes": 0, "attempts": attack_attempts},
+        "random_restart_256": {"successes": 0, "attempts": attack_attempts},
