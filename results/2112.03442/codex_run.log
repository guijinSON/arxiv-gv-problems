+def _compact_algorithm(inst):
+    """Recover the equilibrium from code 0 and the coordinate rows only.
+
+    If F(r) is ``force/scale`` at row code r, then
+
+        F(r) = sum_c x[c] (-1)^(r dot M c).
+
+    The superincreasing absolute values let each of F(0), F(e_0), ...,
+    F(e_(d-1)) be decoded greedily into one sign per planted weight.  Comparing
+    those signs reveals every transformed support code M*c.  The generated
+    rank-one shear satisfies M^2=I, so applying M once recovers c.  This is the
+    short no-tool route whose operation count is reported in G9.
+    """
+    rows = inst["matrix_rows"]
+    weights = inst["weights"]
+    recovered = {}
+    for equation_side, target_side in (("left", "right"), ("right", "left")):
+        by_code = {r["code"]: r for r in inst["groups"][equation_side]}
+        decoded_rows = []
+        for row_code in [0] + [1 << bit for bit in range(inst["dimension"])]:
+            rec = by_code[row_code]
+            if rec["force"] % rec["scale"]:
+                return None
+            decoded = _decode_superincreasing(
+                rec["force"] // rec["scale"], weights
+            )
+            if decoded is None:
+                return None
+            decoded_rows.append(decoded)
+
+        base = decoded_rows[0]
+        code_to_id = {r["code"]: r["id"] for r in inst["groups"][target_side]}
+        terms = []
+        used_codes = set()
+        for weight in weights:
+            transformed_code = 0
+            for bit, signs in enumerate(decoded_rows[1:]):
+                if signs[weight] != base[weight]:
+                    transformed_code |= 1 << bit
+            code = _matvec(rows, transformed_code)
+            if code in used_codes or code not in code_to_id:
+                return None
+            used_codes.add(code)
+            terms.append(
+                [code_to_id[code], [base[weight] * weight, inst["denominator"]]]
+            )
+        recovered[target_side] = sorted(terms)
+    return recovered
+
