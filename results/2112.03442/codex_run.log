+        ids = [
+            r["id"]
+            for r in rng.sample(inst["groups"][side], inst["sparsity"])
+        ]
+        terms = []
+        for pid, weight in zip(ids, sorted(inst["weights"])):
+            terms.append([pid, weight if rng.randrange(2) else -weight])
+        answer[side] = sorted(terms)
+    return answer
