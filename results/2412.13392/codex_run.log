+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["m"] > ship["m"]
+        and search_space(doubled) > space,
+        "shipping_requested_n": ship["n"],
+        "shipping_order_m": ship["m"],
+        "doubled_requested_n": doubled["n"],
