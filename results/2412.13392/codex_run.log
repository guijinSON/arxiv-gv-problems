   820	def _atom_count(value: Any) -> int:
   821	    if isinstance(value, dict):
   822	        return sum(_atom_count(item) for item in value.values())
   823	    if isinstance(value, (list, tuple)):
   824	        return sum(_atom_count(item) for item in value)
   825	    return 1
