+        "ordering": "entry positions are the displayed first-set row indices",
+    },
+}
+
+DIFFICULTY = {
+    "demo": {"n": 15, "switch_fraction": 0.20},
+    "easy": {"n": 27, "switch_fraction": 0.30},
+    "medium": {"n": 51, "switch_fraction": 0.36},
+    "hard": {"n": 75, "switch_fraction": 0.40},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The two regular sets are opposite shifts of the same indexed family, whose "
+    "role-marked rows occur in adjacent odd-even blocks."
+)
+PLACEBO_HINT = (
+    "The two displayed regular sets contain many similar permutations, whose "
+    "entries require careful zero-based transcription throughout."
+)
+
+# Updated from the three script-owned hardening runs before final delivery.
+G9_MEASUREMENTS = {
+    "bare": {"solved": 0, "attempts": 0},
