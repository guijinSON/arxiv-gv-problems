+        "complexity": "O(m^3) exact compatibility work plus O(m^(5/2)) matching",
+        "wall_clock_sec_mean": sum(reference_times) / 8,
+        "wall_clock_sec_max": max(reference_times),
+        "operations_mean": mean_operations,
