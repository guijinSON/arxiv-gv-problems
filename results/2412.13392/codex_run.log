&\gamma_8=( 0, 8, 2, 10, 4, 12, 6)(1, 9, 3, 11, 5, 13, 7)(14);\\
&\gamma_9=(0, 9, 4, 13, 8, 3, 12, 7, 2, 11, 61, 10, 5)(14);\\
