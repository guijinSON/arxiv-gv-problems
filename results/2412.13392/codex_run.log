   708	def _canonical_descriptor(inst: dict) -> dict[str, Any]:
   709	    """A strong cheap invariant of the role-coloured compatibility graph.
   710	
   711	    Independent reordering of either set and simultaneous conjugation carrying d
   712	    leave this graph unchanged up to bipartite colour-preserving isomorphism.
   713	    One-dimensional colour refinement plus colour-pair edge counts is not a
   714	    complete graph canonizer, but is deterministic, invariant, and strong on
   715	    this deliberately asymmetric construction.
   716	    """
   717	    adjacency, _ = _compatibility_graph(inst)
   718	    m = inst["m"]
   719	    reverse = [[] for _ in range(m)]
   720	    for left, neighbours in enumerate(adjacency):
   721	        for right in neighbours:
   722	            reverse[right].append(left)
   723	
   724	    colors = [0 if role == "H" else 1 for role in inst["roles"]] + [2] * m
   725	    all_neighbours = adjacency + [
   726	        [left for left in reverse[right]] for right in range(m)
   727	    ]
   728	    for _ in range(2 * m + 2):
   729	        signatures = []
   730	        for vertex in range(2 * m):
   731	            neighbour_vertices = (
   732	                [m + value for value in all_neighbours[vertex]]
   733	                if vertex < m else all_neighbours[vertex]
   734	            )
   735	            signatures.append((
   736	                0 if vertex < m else 1,
   737	                colors[vertex],
   738	                tuple(sorted(colors[value] for value in neighbour_vertices)),
   739	            ))
   740	        vocabulary = {signature: index for index, signature in enumerate(sorted(set(signatures)))}
   741	        new_colors = [vocabulary[signature] for signature in signatures]
   742	        if new_colors == colors:
   743	            break
   744	        colors = new_colors
   745	
   746	    vertex_histogram: dict[int, int] = {}
   747	    for color in colors:
   748	        vertex_histogram[color] = vertex_histogram.get(color, 0) + 1
   749	    edge_histogram: dict[tuple[int, int], int] = {}
   750	    for left, neighbours in enumerate(adjacency):
   751	        for right in neighbours:
   752	            pair = (colors[left], colors[m + right])
   753	            edge_histogram[pair] = edge_histogram.get(pair, 0) + 1
   754	    return {
   755	        "m": m,
   756	        "c": inst["c"],
   757	        "vertices": sorted(vertex_histogram.items()),
   758	        "edges": sorted((a, b, count) for (a, b), count in edge_histogram.items()),
   759	        "left_profiles": sorted(
   760	            (inst["roles"][row], colors[row], len(adjacency[row])) for row in range(m)
   761	        ),
   762	        "right_profiles": sorted(
   763	            (colors[m + right], len(reverse[right])) for right in range(m)
   764	        ),
   765	    }
   766	
   767	
   768	def canonical_key(inst: dict) -> str:
   769	    descriptor = _canonical_descriptor(inst)
   770	    payload = json.dumps(descriptor, sort_keys=True, separators=(",", ":")).encode()
   771	    return hashlib.sha256(payload).hexdigest()
