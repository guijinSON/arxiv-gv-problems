   507	
   508	def verify(inst: dict, answer: object) -> tuple[bool, str]:
   509	    """Accept every valid role-respecting twined pairing, not only the planted one."""
   510	    shape_ok, reason = _answer_shape(inst, answer)
   511	    if not shape_ok:
   512	        return False, reason
   513	    assert isinstance(answer, list)
   514	    d = inst["distinguished"]
   515	    for row, column in enumerate(answer):
   516	        first = inst["first_set"][row]
   517	        second = inst["second_set"][column]
   518	        role = inst["roles"][row]
   519	        if role == "H":
   520	            if not _is_hamiltonian_pair(first, second):
   521	                return False, f"row {row} is labelled H but its paired product is not one cycle"
   522	        elif role == "T":
   523	            if not _is_truncated_pair(first, second, d):
   524	                return False, (
   525	                    f"row {row} is labelled T but its paired truncation product "
   526	                    "does not meet the two-cycle/nonfixing rule"
   527	                )
   528	        else:
   529	            return False, f"instance row {row} has an unknown role"
   530	    return True, "ok"
