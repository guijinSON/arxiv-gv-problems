+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "two regular permutation sets of order m",
+        "a c-twined directed 2-factorization of C_2 wreath empty_m",
+        "Hamiltonian and truncated-Hamiltonian permutation pairs",
+    ],
