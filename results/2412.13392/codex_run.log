   319	def _base_construction(
   320	    m: int, switches: set[int]
   321	) -> tuple[list[list[int]], list[list[int]], list[int], list[str]]:
   322	    """Proposition 5.10 before the two independent row reorderings."""
   323	    family = _family_f(m)
   324	    first = [_compose(_gamma(m, 1), permutation) for permutation in family]
   325	    second = [_compose(_gamma(m, -1), permutation) for permutation in family]
   326	
   327	    pairing: list[int | None] = [None] * m
   328	    roles = ["H"] * m
   329	    pairing[1], pairing[2] = 2, 1
   330	    roles[1] = roles[2] = "T"
   331	    for i in switches:
   332	        pairing[i] = (m - i) % m
   333	        pairing[i + 1] = (m - i + 1) % m
   334	        roles[i] = roles[i + 1] = "T"
   335	    pairing[0], pairing[m - 1] = m - 1, 0
   336	    for i in range(3, m - 1):
   337	        if i not in switches and i - 1 not in switches:
   338	            pairing[i] = (m - i + 1) % m
   339	
   340	    if any(value is None for value in pairing):
   341	        raise AssertionError("Proposition 5.10 pairing is incomplete")
   342	    answer = [int(value) for value in pairing if value is not None]
   343	    if sorted(answer) != list(range(m)):
   344	        raise AssertionError("Proposition 5.10 pairing is not bijective")
   345	    return first, second, answer, roles
