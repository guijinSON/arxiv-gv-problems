   828	def selftest() -> dict:
   829	    """Run every local correctness, resistance, scaling, and suitability gate."""
   830	    report: dict[str, Any] = {
   831	        "track": TRACK,
   832	        "shipping_difficulty": SHIPPING_DIFFICULTY,
   833	    }
   834	
   835	    g1_failures: list[str] = []
   836	    attempts = 0
   837	    for preset, params in DIFFICULTY.items():
   838	        for seed in range(4):
   839	            inst = make_instance(seed=seed, **params)
   840	            ok, reason = verify(inst, inst["answer"])
   841	            attempts += 1
   842	            if not ok:
   843	                g1_failures.append(f"{preset}/{seed}: {reason}")
   844	            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
   845	                g1_failures.append(f"{preset}/{seed}: answer is not JSON-native")
   846	            if not (_regular(inst["first_set"]) and _regular(inst["second_set"])):
   847	                g1_failures.append(f"{preset}/{seed}: displayed set is not regular")
   848	    report["G1_planted_verifies"] = {
   849	        "pass": not g1_failures,
   850	        "attempts": attempts,
   851	        "failures": g1_failures,
   852	    }
   853	
   854	    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
   855	    ship = make_instance(seed=314159, **ship_params)
   856	    planted = list(ship["answer"])
   857	    swapped = None
   858	    for left in range(ship["m"]):
   859	        for right in range(left + 1, ship["m"]):
   860	            trial = list(planted)
   861	            trial[left], trial[right] = trial[right], trial[left]
   862	            if not verify(ship, trial)[0]:
   863	                swapped = trial
   864	                break
   865	        if swapped is not None:
   866	            break
   867	    if swapped is None:
   868	        raise AssertionError("could not construct a rejected swap corruption")
   869	    duplicate = list(planted)
   870	    duplicate[-1] = duplicate[0]
   871	    outside = list(planted)
   872	    outside[0] = ship["m"]
   873	    corruptions = {
   874	        "drop_one": planted[:-1],
   875	        "swap_two": swapped,
   876	        "duplicate_one": duplicate,
   877	        "empty": [],
   878	        "out_of_range": outside,
   879	    }
   880	    cases = {}
   881	    reasons = []
   882	    for name, candidate in corruptions.items():
   883	        ok, reason = verify(ship, candidate)
   884	        cases[name] = {"rejected": not ok, "reason": reason}
   885	        reasons.append(reason)
   886	    report["G2_rejects_corruption"] = {
   887	        "pass": all(case["rejected"] for case in cases.values())
   888	        and len(set(reasons)) == len(reasons),
   889	        "distinct_reasons": len(set(reasons)),
   890	        "cases": cases,
   891	    }
   892	
   893	    model_style = (
   894	        "The cycle checks give the requested twined factorization.\n```json\n"
   895	        f"<answer>{json.dumps(planted)}</answer>\n```\n"
   896	        "Each second-set row is used once."
   897	    )
   898	    parsed = parse_answer(model_style)
   899	    report["G3_round_trip"] = {
   900	        "pass": parsed == planted and parse_answer("no tagged answer here") is None,
   901	        "parsed_length": len(parsed) if isinstance(parsed, list) else None,
   902	    }
   903	
   904	    samples = 250_000
   905	    sample_rng = random.Random(8_675_309)
   906	    hits = 0
   907	    density_started = time.perf_counter()
   908	    for _ in range(samples):
   909	        candidate = random_candidate(ship, sample_rng)
   910	        if _fast_valid(ship, candidate):
   911	            hits += 1
   912	            if not verify(ship, candidate)[0]:
   913	                raise AssertionError("fast density check disagrees with verify")
   914	    density_elapsed = time.perf_counter() - density_started
   915	    density = hits / samples
   916	    space = search_space(ship)
   917	    report["G4_guess_resistance"] = {
   918	        "pass": density < 1e-6,
   919	        "hits": hits,
   920	        "total": samples,
   921	        "observed_probability": density,
   922	        "candidate_space": space,
   923	        "sample_wall_clock_sec": density_elapsed,
   924	        "sampler": "uniform over all m! bijections after enforcing length, range, and no repeats",
   925	    }
   926	
   927	    attack_names = [
   928	        "outlier_distinguished_image_rank",
   929	        "greedy_lexicographic_allowed_edge",
   930	        "random_restart_256",
   931	        "by_hand_cyclic_row_offset_ansatz",
   932	    ]
   933	    attack_results = {
   934	        name: {"successes": 0, "attempts": 8} for name in attack_names
