+        if index == 0:
+            partner = m - 1
+        elif index == m - 1:
+            partner = 0
+        elif index == 1:
+            partner = 2
+        elif index == 2:
+            partner = 1
+        elif role == "H":
+            partner = m - index + 1
+        elif role == "T" and index % 2 == 1:
+            partner = m - index
+        elif role == "T":
+            partner = m - index + 2
+        else:
+            raise ValueError("unknown row role")
+        answer[row] = right_position[partner]
+
+    if any(position < 0 for position in answer):
+        raise ValueError("compact route produced an absent partner index")
+    return answer, 3 * m + 8
+
