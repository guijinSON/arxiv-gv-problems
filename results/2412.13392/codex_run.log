   348	def make_instance(
   349	    n: int,
   350	    seed: int = 0,
   351	    switch_fraction: float = 0.40,
   352	    **params: Any,
   353	) -> dict:
   354	    """Construct and then relabel a certified Proposition 5.10 factorization.
   355	
   356	    The certificate is built from the proposition's formulas before the two
   357	    regular sets are shuffled.  No search is used.
   358	    """
   359	    if params:
   360	        raise TypeError(f"unknown parameters: {sorted(params)}")
   361	    if isinstance(seed, bool) or not isinstance(seed, int):
   362	        raise ValueError("seed must be an integer")
   363	    if not isinstance(switch_fraction, (int, float)) or isinstance(
   364	        switch_fraction, bool
   365	    ) or not (0.0 <= float(switch_fraction) <= 1.0):
   366	        raise ValueError("switch_fraction must lie in [0,1]")
   367	
   368	    m = _supported_order(n)
   369	    eligible = list(range(3, m - 3, 2))
   370	    switch_count = int(round(float(switch_fraction) * len(eligible)))
   371	    switch_count = max(0, min(len(eligible), switch_count))
   372	
   373	    rng = random.Random(seed)
   374	    switches = set(rng.sample(eligible, switch_count))
   375	    first, second, base_answer, base_roles = _base_construction(m, switches)
   376	
   377	    second_order = list(range(m))
   378	    rng.shuffle(second_order)
   379	    second_position = [0] * m
   380	    for displayed, original in enumerate(second_order):
   381	        second_position[original] = displayed
   382	    displayed_second = [second[original] for original in second_order]
   383	
   384	    # A uniformly random display order makes the most obvious left-to-right
   385	    # greedy rule succeed surprisingly often on this compatibility graph.  Draw
   386	    # the display order from the same row-relabeling orbit, conditioned only on
   387	    # that cheap attack failing.  This changes no mathematical object and never
   388	    # searches for the certificate, which was already carried from the proof.
   389	    for _ in range(128):
   390	        first_order = list(range(m))
   391	        rng.shuffle(first_order)
   392	        displayed_roles = [base_roles[original] for original in first_order]
   393	        answer = [
   394	            second_position[base_answer[original]] for original in first_order
   395	        ]
   396	        instance = {
   397	            "paper_id": "2412.13392",
   398	            "construction": "Construction 5.3 and Proposition 5.10",
   399	            "n": int(n),
   400	            "m": m,
   401	            "c": displayed_roles.count("T"),
   402	            "distinguished": m - 1,
   403	            "first_set": [first[original] for original in first_order],
   404	            "second_set": displayed_second,
   405	            "roles": displayed_roles,
   406	            "answer": answer,
   407	        }
   408	        if _greedy_attack(instance) is None:
