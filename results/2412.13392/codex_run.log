   491	def _answer_shape(inst: dict, answer: object) -> tuple[bool, str]:
   492	    m = inst["m"]
   493	    if not isinstance(answer, list):
   494	        return False, "answer must be a JSON list"
   495	    if not answer:
   496	        return False, "answer list must be nonempty"
   497	    if len(answer) != m:
   498	        return False, f"pairing length must be exactly {m}"
   499	    if any(isinstance(value, bool) or not isinstance(value, int) for value in answer):
   500	        return False, "every pairing entry must be an integer"
   501	    if any(value < 0 or value >= m for value in answer):
   502	        return False, f"pairing entries must lie in the inclusive range 0..{m - 1}"
   503	    if len(set(answer)) != m:
   504	        return False, "pairing entries must be distinct"
   505	    return True, "ok"
