   789	def _relabel_instance(
   790	    inst: dict,
   791	    first_order: list[int],
   792	    second_order: list[int],
   793	    symbol_map: list[int],
   794	    answer: list[int],
   795	) -> tuple[dict, list[int]]:
   796	    """Apply row reorderings and a simultaneous symbol conjugation."""
   797	    m = inst["m"]
   798	    symbol_inverse = _inverse(symbol_map)
   799	
   800	    def conjugate(permutation: list[int]) -> list[int]:
   801	        return _compose(symbol_inverse, permutation, symbol_map)
   802	
   803	    second_position = [0] * m
   804	    for displayed, old in enumerate(second_order):
   805	        second_position[old] = displayed
   806	    transformed = dict(inst)
   807	    transformed["first_set"] = [
   808	        conjugate(inst["first_set"][old]) for old in first_order
   809	    ]
   810	    transformed["second_set"] = [
   811	        conjugate(inst["second_set"][old]) for old in second_order
   812	    ]
   813	    transformed["roles"] = [inst["roles"][old] for old in first_order]
   814	    transformed["distinguished"] = symbol_map[inst["distinguished"]]
   815	    carried = [second_position[answer[old]] for old in first_order]
   816	    transformed["answer"] = carried
   817	    return transformed, carried
