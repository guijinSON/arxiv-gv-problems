   545	def enumerate_all(inst: dict) -> int | None:
   546	    """Count valid pairings only when the declared space is safely tiny."""
   547	    space = search_space(inst)
   548	    if space is None or space > 2_000_000:
   549	        return None
   550	    # No supported preset currently enters this branch, but it is exact for a
   551	    # future smaller construction with the same instance schema.
   552	    import itertools
   553	
   554	    count = 0
   555	    for candidate in itertools.permutations(range(inst["m"])):
   556	        if verify(inst, list(candidate))[0]:
   557	            count += 1
   558	    return count
