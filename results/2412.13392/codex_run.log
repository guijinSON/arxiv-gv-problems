+DIFFICULTY = {
+    "demo": {"n": 15, "switch_fraction": 0.20},
+    "easy": {"n": 27, "switch_fraction": 0.30},
+    "medium": {"n": 51, "switch_fraction": 0.36},
+    "hard": {"n": 75, "switch_fraction": 0.40},
+}
