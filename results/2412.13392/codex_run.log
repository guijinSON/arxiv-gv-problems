   663	def _distinguished_image_attack(inst: dict) -> list[int]:
   664	    """Pair equal ranks of the most immediate per-row statistic p(d)."""
   665	    d = inst["distinguished"]
   666	    left_order = sorted(range(inst["m"]), key=lambda i: inst["first_set"][i][d])
   667	    right_order = sorted(range(inst["m"]), key=lambda j: inst["second_set"][j][d])
   668	    answer = [0] * inst["m"]
   669	    for left, right in zip(left_order, right_order):
   670	        answer[left] = right
   671	    return answer
   672	
   673	
   674	def _greedy_attack(inst: dict) -> list[int] | None:
   675	    """Input-order greedy, choosing the lexicographically smallest allowed row."""
   676	    unused = set(range(inst["m"]))
   677	    answer = [-1] * inst["m"]
   678	    right_keys = [tuple(permutation) for permutation in inst["second_set"]]
   679	    for row in range(inst["m"]):
   680	        choices = [column for column in unused if _allowed(inst, row, column)]
   681	        if not choices:
   682	            return None
   683	        column = min(choices, key=lambda value: right_keys[value])
   684	        answer[row] = column
   685	        unused.remove(column)
   686	    return answer
   687	
   688	
   689	def _cyclic_offset_attack(inst: dict) -> list[int] | None:
   690	    """Try the obvious row-position ansatz p[i]=i+s mod m for every offset."""
   691	    m = inst["m"]
   692	    for offset in range(m):
   693	        candidate = [(row + offset) % m for row in range(m)]
   694	        if _fast_valid(inst, candidate):
   695	            return candidate
   696	    return None
   697	
   698	
   699	def _random_restart_attack(inst: dict, seed: int, restarts: int = 256) -> list[int] | None:
   700	    rng = random.Random(seed)
   701	    for _ in range(restarts):
   702	        candidate = random_candidate(inst, rng)
   703	        if _fast_valid(inst, candidate):
   704	            return candidate
   705	    return None
