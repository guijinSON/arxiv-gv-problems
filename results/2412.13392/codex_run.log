   774	def escalate(params: dict) -> dict | str | None:
   775	    """Increase m while keeping the role density and the same certificate shape."""
   776	    current = _supported_order(int(params.get("n", 15)))
   777	    next_order = current + 24
   778	    # The compact construction-index route is bounded by 3m+8 operations.  Past
   779	    # m=75 the no-tool route breaches the 300-operation cap before the answer's
   780	    # 256-atom limit, so further escalation is cap-bound.
   781	    if 3 * next_order + 8 > 300 or next_order > 256:
   782	        return "cap_bound"
   783	    return {
   784	        "n": next_order,
   785	        "switch_fraction": float(params.get("switch_fraction", 0.40)),
   786	    }
