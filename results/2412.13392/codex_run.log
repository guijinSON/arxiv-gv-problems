   465	def parse_answer(text: str) -> object | None:
   466	    """Parse a tagged JSON permutation, tolerating prose and Markdown fences."""
   467	    if not isinstance(text, str):
   468	        return None
   469	    match = re.search(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
   470	    if not match:
   471	        return None
   472	    payload = match.group(1).strip()
   473	    payload = re.sub(r"^```(?:json|text)?\s*", "", payload, flags=re.I)
   474	    payload = re.sub(r"\s*```$", "", payload)
   475	    try:
   476	        parsed = json.loads(payload)
   477	    except (json.JSONDecodeError, TypeError):
   478	        # A common model rendering omits brackets but still obeys the comma list.
   479	        raw = payload.strip()
   480	        if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", raw):
   481	            return None
   482	        try:
   483	            parsed = [int(piece.strip()) for piece in raw.split(",")]
   484	        except ValueError:
   485	            return None
   486	    if not isinstance(parsed, list):
   487	        return None
   488	    return parsed
