   657	def _fast_valid(inst: dict, candidate: list[int]) -> bool:
   658	    if len(candidate) != inst["m"] or len(set(candidate)) != inst["m"]:
   659	        return False
   660	    return all(_allowed(inst, row, column) for row, column in enumerate(candidate))
