+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON array p of length m containing every integer 0,...,m-1 exactly "
+        "once; row i of the first regular set is paired with row p[i] of the "
+        "second set."
