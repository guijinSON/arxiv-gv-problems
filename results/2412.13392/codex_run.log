   275	def _family_f(m: int) -> list[list[int]]:
   276	    """Construction 5.3's regular permutation set F_m."""
   277	    k = (m - 1) // 2
   278	    family: list[list[int] | None] = [None] * m
   279	    family[0] = list(range(m))
   280	
   281	    for j in range(k):
   282	        i = 2 * j + 1
   283	        family[i] = _compose(_gamma(m, i), _transposition(m, m - 1, j + 2))
   284	    for j in range(1, k - 1):
   285	        i = 2 * j
   286	        family[i] = _compose(
   287	            _gamma(m, i), _transposition(m, m - 1, k + j + 1)
   288	        )
   289	    family[m - 3] = _compose(
   290	        _gamma(m, m - 3), _transposition(m, m - 1, 0)
   291	    )
   292	
   293	    exceptional = [0] * m
   294	    for a in range(m):
   295	        if 3 <= a <= k:
   296	            exceptional[a] = m - a + 1
   297	        elif k + 2 <= a <= m - 2:
   298	            exceptional[a] = m - a + 2
   299	        elif a == 0:
   300	            exceptional[a] = 3
   301	        elif a == 1:
   302	            exceptional[a] = 2
   303	        elif a == 2:
   304	            exceptional[a] = 0
   305	        elif a == k + 1:
   306	            exceptional[a] = m - 1
   307	        else:  # a == m-1
   308	            exceptional[a] = 1
   309	    family[m - 1] = exceptional
   310	
   311	    if any(permutation is None for permutation in family):
   312	        raise AssertionError("Construction 5.3 left an undefined permutation")
