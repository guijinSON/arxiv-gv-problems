   561	def _allowed(inst: dict, row: int, column: int) -> bool:
   562	    first = inst["first_set"][row]
   563	    second = inst["second_set"][column]
   564	    if inst["roles"][row] == "H":
   565	        return _is_hamiltonian_pair(first, second)
   566	    return _is_truncated_pair(first, second, inst["distinguished"])
