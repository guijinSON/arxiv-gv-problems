   569	def _compatibility_graph(inst: dict) -> tuple[list[list[int]], dict[str, int]]:
   570	    """Build the exact role-compatible bipartite graph and count primitive work."""
   571	    m = inst["m"]
   572	    adjacency: list[list[int]] = []
   573	    image_operations = 0
   574	    for row in range(m):
   575	        neighbours = []
   576	        for column in range(m):
   577	            if inst["roles"][row] == "H":
   578	                # One length-m product and one exact length-m cycle scan.
   579	                image_operations += 2 * m
   580	            else:
   581	                # Two length-m truncations, their length-m product, and one
   582	                # exact length-m cycle scan.  Failed nonfixing tests are cheaper,
   583	                # but counting the full bound is reproducible and honest.
   584	                image_operations += 4 * m + 2
   585	            if _allowed(inst, row, column):
   586	                neighbours.append(column)
   587	        adjacency.append(neighbours)
   588	    return adjacency, {
   589	        "pair_tests": m * m,
   590	        "permutation_image_operations": image_operations,
   591	        "allowed_edges": sum(map(len, adjacency)),
   592	    }
   593	
   594	
   595	def _hopcroft_karp(adjacency: list[list[int]]) -> tuple[list[int] | None, int]:
   596	    """Maximum bipartite matching; return a perfect left matching when one exists."""
   597	    n_left = len(adjacency)
   598	    n_right = n_left
   599	    left_match = [-1] * n_left
   600	    right_match = [-1] * n_right
   601	    distance = [0] * n_left
   602	    edge_visits = 0
   603	
   604	    while True:
   605	        queue: deque[int] = deque()
   606	        for left in range(n_left):
   607	            if left_match[left] < 0:
   608	                distance[left] = 0
   609	                queue.append(left)
   610	            else:
   611	                distance[left] = -1
   612	        found = False
   613	        while queue:
   614	            left = queue.popleft()
   615	            for right in adjacency[left]:
   616	                edge_visits += 1
   617	                mate = right_match[right]
   618	                if mate < 0:
   619	                    found = True
   620	                elif distance[mate] < 0:
   621	                    distance[mate] = distance[left] + 1
   622	                    queue.append(mate)
   623	        if not found:
   624	            break
   625	
   626	        def augment(left: int) -> bool:
   627	            nonlocal edge_visits
   628	            for right in adjacency[left]:
   629	                edge_visits += 1
   630	                mate = right_match[right]
   631	                if mate < 0 or (
   632	                    distance[mate] == distance[left] + 1 and augment(mate)
   633	                ):
   634	                    left_match[left] = right
   635	                    right_match[right] = left
   636	                    return True
   637	            distance[left] = -1
   638	            return False
   639	
   640	        for left in range(n_left):
   641	            if left_match[left] < 0:
   642	                augment(left)
   643	
   644	    if any(value < 0 for value in left_match):
   645	        return None, edge_visits
   646	    return left_match, edge_visits
   647	
   648	
   649	def _reference_algorithm(inst: dict) -> tuple[list[int] | None, dict[str, int]]:
   650	    adjacency, counts = _compatibility_graph(inst)
   651	    answer, visits = _hopcroft_karp(adjacency)
   652	    counts["matching_edge_visits"] = visits
   653	    counts["operations"] = counts["permutation_image_operations"] + visits
   654	    return answer, counts
   655	
