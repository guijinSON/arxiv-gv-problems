+def escalate(params: dict) -> dict | str | None:
+    """Increase m while keeping the role density and the same certificate shape."""
+    current = _supported_order(int(params.get("n", 15)))
+    next_order = current + 24
+    # The compact construction-index route is bounded by 2m+8 operations.  Past
+    # m=123 the no-tool route breaches the 300-operation cap before the answer's
+    # 256-atom limit, so further escalation is cap-bound.
+    if 2 * next_order + 8 > 300 or next_order > 256:
