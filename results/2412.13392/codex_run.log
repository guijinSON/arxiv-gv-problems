import itertools, math, random

def comp(*ps):
    r=list(range(len(ps[0])))
    for p in ps:
        r=[p[x] for x in r]
    return r

def shift(m,i): return [(x+i)%m for x in range(m)]
def transp(m,a,b):
    p=list(range(m));p[a],p[b]=p[b],p[a];return p

def cycles(p):
    n=len(p);seen=[0]*n;c=0
    for i in range(n):
        if not seen[i]:
            c+=1;x=i
            while not seen[x]:seen[x]=1;x=p[x]
    return c

def trunc(p,d): return comp(p,transp(len(p),d,p[d]))
def kind(p,q,d):
    H=cycles(comp(p,q))==1
    T=p[d]"'!=d and q[d]!=d and cycles(comp(trunc(p,d),trunc(q,d)))==2
    return T,H

def build(m):
    pi=[shift(m,i) for i in range(m)]
    sw=transp(m,0,m-1)
    R1=[comp(sw,pi[i]) for i in range(m)]
    R2=pi
    pair=[];roles=[]
    for i in range(m):
        if i==0: j=1; role='"'T'
        elif i in (m-2,m-1): j={m-2:0,m-1:m-1}[i]; role='H'
        else: j=(m-i-1)%m;role='T'
        pair.append(j);roles.append(role)
    return R1,R2,pair,roles
for m in [4,6,8,10,12,20,50,100]:
    R1,R2,pair,roles=build(m);d=m-1
    ok=all(kind(R1[i],R2[pair[i]],d)[0 if roles[i]=='T' else 1] for i in range(m)) and len(set(pair))==m
    deg=[]
    for i in range(m):
        ri=0 if roles[i]=='T' else 1
        deg.append(sum(kind(R1[i],R2[j],d)[ri] for j in range(m)))
    print(m,ok,'degree min/avg/max',min(deg),sum(deg)/m,max(deg), 'deg',deg if m<=12 else '')
    if m<=8:
        cnt=0
        for p in itertools.permutations(range(m)):
            if all(kind(R1[i],R2[p[i]],d)[0 if roles[i]=='T' else 1] for i in range(m)):cnt+=1
        print(' exact',cnt,'/',math.factorial(m),cnt/math.factorial(m))
