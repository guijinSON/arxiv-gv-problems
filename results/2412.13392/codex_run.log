   177	def _supported_order(n: int) -> int:
   178	    """Smallest m>=n with m == 3 (mod 12), within Proposition 5.10."""
   179	    if isinstance(n, bool) or not isinstance(n, int) or n < 1:
   180	        raise ValueError("n must be a positive integer")
   181	    n = max(n, 15)
   182	    return n + ((3 - n) % 12)
   183	
   184	
   185	def _compose(*permutations: list[int]) -> list[int]:
   186	    """Paper convention: x^(p q) = (x^p)^q."""
   187	    if not permutations:
   188	        return []
   189	    result = list(range(len(permutations[0])))
   190	    for permutation in permutations:
   191	        result = [permutation[x] for x in result]
   192	    return result
   193	
   194	
   195	def _inverse(permutation: list[int]) -> list[int]:
   196	    result = [0] * len(permutation)
   197	    for source, target in enumerate(permutation):
   198	        result[target] = source
   199	    return result
   200	
   201	
   202	def _transposition(m: int, a: int, b: int) -> list[int]:
   203	    result = list(range(m))
   204	    result[a], result[b] = result[b], result[a]
   205	    return result
   206	
   207	
   208	def _gamma(m: int, exponent: int) -> list[int]:
   209	    """gamma_exponent rotates 0,...,m-2 and fixes m-1."""
   210	    modulus = m - 1
   211	    return [((x + exponent) % modulus) if x < modulus else x for x in range(m)]
   212	
   213	
   214	def _cycle_count(permutation: list[int]) -> int:
   215	    seen = bytearray(len(permutation))
   216	    cycles = 0
   217	    for start in range(len(permutation)):
   218	        if seen[start]:
   219	            continue
   220	        cycles += 1
   221	        point = start
   222	        while not seen[point]:
   223	            seen[point] = 1
   224	            point = permutation[point]
   225	    return cycles
   226	
   227	
   228	def _cycle_type(permutation: list[int]) -> tuple[int, ...]:
   229	    seen = bytearray(len(permutation))
   230	    lengths: list[int] = []
   231	    for start in range(len(permutation)):
   232	        if seen[start]:
   233	            continue
   234	        point = start
   235	        length = 0
   236	        while not seen[point]:
   237	            seen[point] = 1
   238	            length += 1
   239	            point = permutation[point]
   240	        lengths.append(length)
   241	    return tuple(sorted(lengths))
   242	
   243	
   244	def _truncate(permutation: list[int], distinguished: int) -> list[int]:
   245	    image = permutation[distinguished]
   246	    return _compose(permutation, _transposition(len(permutation), distinguished, image))
   247	
   248	
   249	def _is_hamiltonian_pair(first: list[int], second: list[int]) -> bool:
   250	    return _cycle_count(_compose(first, second)) == 1
   251	
   252	
   253	def _is_truncated_pair(
   254	    first: list[int], second: list[int], distinguished: int
   255	) -> bool:
   256	    if first[distinguished] == distinguished or second[distinguished] == distinguished:
   257	        return False
   258	    product = _compose(
   259	        _truncate(first, distinguished), _truncate(second, distinguished)
   260	    )
   261	    return _cycle_count(product) == 2
   262	
   263	
   264	def _regular(permutations: list[list[int]]) -> bool:
   265	    m = len(permutations)
   266	    expected = list(range(m))
   267	    return (
   268	        len(permutations) == m
   269	        and all(sorted(permutation) == expected for permutation in permutations)
   270	        and all(len({permutation[x] for permutation in permutations}) == m
   271	                for x in range(m))
   272	    )
