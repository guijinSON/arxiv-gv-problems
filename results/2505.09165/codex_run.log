+    n = int(params.get("n", 80))
+    target_multiple = int(params.get("target_multiple", 80))
+    if n >= 84:
+        return "cap_bound"
+    return {
+        "n": min(84, n + 12),
+        "target_multiple": target_multiple + 16,
+    }
