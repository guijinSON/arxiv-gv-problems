+# Filled from the three harness-owned transcripts after the oracle runs.  Keeping
+# this explicit lets selftest remain deterministic and perform no file I/O.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
