+        "propagation solves this generated distribution in O(m^2+bm+z); at shipping "
+        "m=168 and b=56 it uses 47,040 exact arithmetic/lookup operations (14,028 "
+        "pair builds and 9,408 target probes) and under 0.01 seconds, whereas the "
+        "common-residue route uses 168 exact operations but is not mechanically "
+        "executable by hand across 168 displayed lengths."
+    ),
+    "max_answer_tokens": 169,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"]
+    + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 2, "target_multiple": 32},
+    "easy": {"n": 32, "target_multiple": 40},
+    "medium": {"n": 56, "target_multiple": 56},
+    "hard": {"n": 80, "target_multiple": 80},
+}
