+def _cantor_code(value: int, digits: int = 7) -> int:
+    """Map bits to base-three digits 0/1, a progression-free integer set."""
+
+    result = 0
+    power = 1
+    for bit in range(digits):
+        if (value >> bit) & 1:
+            result += power
+        power *= 3
+    return result
