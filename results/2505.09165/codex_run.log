+    doubled_params["target_multiple"] += 16
+    t0 = time.perf_counter()
+    doubled = make_instance(seed=31337, **doubled_params)
+    doubled_build_seconds = time.perf_counter() - t0
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
