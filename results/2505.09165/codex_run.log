            for i, j in pair_sums.get(target - length, ()):
                pair_scans += 1
                if k != i and k != j:
                    triples.add(tuple(sorted((i, j, k))))
    candidate = _canonical_answer(triples)
    operations = 2 * pair_builds + 2 * target_probes + pair_scans
