+def selftest() -> dict:
+    """Run correctness, resistance, scaling, canonicalization, and size gates."""
+
+    report = {}
+
+    # G1: every named setting, multiple seeds, deterministic and JSON-native.
+    g1_checks = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
