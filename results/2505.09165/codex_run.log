+    encoded = []
+    for group, base_residue in enumerate(selected):
+        residue = (scale * base_residue) % MODULUS
+        qa, qb, qc = _sample_quotients(rng, target_multiple, residue)
+        lengths = [
+            qa * MODULUS + residue,
+            qb * MODULUS + residue,
