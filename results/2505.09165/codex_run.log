+    "share a residue."
+)
+PLACEBO_HINT: str = (
+    "Track the path identifiers carefully and check every group before finalizing "
+    "the dispatch plan."
+)
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "exact_cover",
