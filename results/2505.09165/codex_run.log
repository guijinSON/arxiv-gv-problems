+    def count(remaining: tuple[int, ...]) -> int:
+        if not remaining:
+            return 1
+        first = remaining[0]
+        total = 0
+        tail = remaining[1:]
+        for j, k in itertools.combinations(tail, 2):
+            if lengths[first] + lengths[j] + lengths[k] != target:
+                continue
+            used = {first, j, k}
+            total += count(tuple(x for x in remaining if x not in used))
