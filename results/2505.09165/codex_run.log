+def _balanced_rank_candidate(inst):
+    ids = sorted(range(len(inst["paths"])), key=lambda i: inst["paths"][i])
+    n = inst["n"]
+    return _canonical_answer(
+        [ids[i], ids[n + i], ids[3 * n - 1 - i]] for i in range(n)
