+    spot_empty = True
+    by_target = {}
+    for group in groups:
+        target = sum(inst["paths"][path_id] for path_id in group)
+        if target not in set(inst["block_targets"]):
+            return False, "triple_not_a_passenger_block"
+        if target in by_target:
