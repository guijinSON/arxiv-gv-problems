+    # arithmetic progressions.  The offset also excludes the other homogeneous
+    # zero-sum patterns; multiplication by a nonzero field element preserves all
+    # those properties while hiding the small base representatives.
+    base_pool = [1024 + _cantor_code(i) for i in range(128)]
