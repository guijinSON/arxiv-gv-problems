+    center3 = sum(inst["block_targets"]) // inst["n"]
+    ids = sorted(
+        range(len(inst["paths"])),
+        key=lambda i: (abs(3 * inst["paths"][i] - center3), i),
+    )
+    return _canonical_answer(ids[start : start + 3] for start in range(0, len(ids), 3))
