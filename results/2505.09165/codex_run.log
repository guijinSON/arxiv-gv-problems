+            pair_probes += 1
+            need = inst["target"] - lengths[i] - lengths[j]
+            k = by_value.get(need)
+            if k is not None:
+                lookup_hits += 1
+                if k > j:
+                    triples.add((i, j, k))
+    candidate = _canonical_answer(triples)
