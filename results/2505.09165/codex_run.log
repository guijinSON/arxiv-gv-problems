+        "shipping_density_samples": sample_total,
+        "shipping_density_fraction": guess_fraction,
+        "shipping_sampling_wall_seconds": sampling_seconds,
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_count": search_space(demo),
