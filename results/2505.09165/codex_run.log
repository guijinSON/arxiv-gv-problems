+        sample_hits += int(verify(inst, candidate)[0])
+    sampling_seconds = time.perf_counter() - t0
+    guess_fraction = sample_hits / sample_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": sample_hits,
+        "total": sample_total,
+        "fraction": guess_fraction,
