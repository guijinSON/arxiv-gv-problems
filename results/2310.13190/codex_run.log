def gen(n=256,r=16,k=12,L=24,seed=0):
    R=random.Random(seed); edges=[]; seen=set(); ansv=R.sample(range(n),L)
    for i in range(L):
        core={ansv[i],ansv[(i+1)%L]}
        pool=[x for x in range(n) if x not in core]
        while True:
            e=tuple(sorted(core|set(R.sample(pool,r-2))))
            if e not in seen: break
        seen.add(e);edges.append(e)
    deg=[0]*n
    for e in edges:
        for v in e:deg[v]+=1
    while min(deg)<k:
        low=sorted(range(n),key=lambda v:(deg[v],R.random()))[:max(r*2,n//3)]
        chosen=[]
