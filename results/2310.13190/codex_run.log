%longest Berge path $ u_1, f_1, \ldots, u_\ell, f_\ell, u_{\ell+1}$ from $V(C)$ to $V(H) - V(C)$ that is internally disjoint from $V(C) \cup E(C)$; otherwise, 
% $P$ is a longest partial Berge path $  f_1, \ldots, u_\ell, f_\ell, u_{\ell+1}$ from $E(C)$ to $V(H) - V(C)$ that is internally disjoint from $V(C) \cup E(C)$. 

\item[(R3)] Rules (R1) and (R2) do not distinguish $(C,P)$  from   $(C',P')$, and the total number of vertices of $V(P)-V(C)$ contained in the  edges of $E(C)-E(P)$ counted with multiplicities is larger than the total number of vertices of $V(P')-V(C')$ contained in the  edges of $E(C')-E(P')$; or 
\item[(R4)] 
%Rules (a)--(c) do not distinguish $(C,P)$ from $(C',P')$, and $(C,P)$ is an o-lollipop while $(C',P')$ is a p-lollipop; or \item[(e)] 
 Rules (R1)--(R3) do not distinguish $(C,P)$  from   $(C',P')$, and
 the number of edges in $E(P)-E(C)$ fully contained in $V(P)-V(C)$ is larger than the number of edges in $E(P')-E(C')$ fully contained in $V(P')-V(C')$. 
 \end{enumerate}



The criteria (R1)--(R4) define a partial ordering on the (finite) set of lollipops.
For $1\leq j\leq 4$, we will say that a lollipop is $j$-{\em good} if it is best among all lollipops according to the  rules (R1)--(Rj). For example,
a lollipop is $1$-good if the cycle in it is a longest cycle in $H$. Clearly if $i < j$ and a lollipop is $j$-good, then it is also $i$-good. We call a $4$-good lollipop a {\em best lollipop}.


Let  a lollipop $(C,P)$ be $j$-good for some $1\leq j\leq 4$. Say $C = v_1, e_1, \ldots, v_c, e_c, v_1$. If $(C,P)$ is a o-lollipop then let $P = u_0, f_0,u_1, \ldots, f_{\ell-1}, u_{\ell}$, where $u_0 = v_c$. If $(C,P)$ is a p-lollipop then let $P = f_0, u_1, f_1, \ldots, f_{\ell-1}, u_{\ell}$ where $f_0 = e_c$. With this notation, we have $|E(P)| = \ell$, $|V(P)| = \ell+1$ if $P$ is a Berge path, and $|V(P)|=\ell$ if $P$ is a partial Berge path. Assume $c < \min\{2k,|E(G)|,n\}$. 

A big part of the proof is to show that the case $\ell\geq k$ is impossible. After we prove this, we assume that $\ell\leq k-1$ and consider a somewhat weaker structure than lollipop, we call it a {\bf disjoint cycle-path pair} or {\em dcp-pair} for short. It is a pair $(C,P)$ of a cycle $C$ and a path $P$ without common edges and common defining vertices.
%We call it {\em broken}, because we view it as obtained from a p-lollipop by deleting edge $f_0$ from $P$.
Similarly to lollipops, we say  that a dcp-pair $(C,P)$  {\em is better} than  another dcp-pair $(C',P')$  following the Rules (R1)--(R4) above. We say a dcp-pair $(C,P)$ is $j$-good for some $1 \leq j \leq 4$ if it is best among all dcp-pairs according to rules (R1)--(Rj).
A small simplification in the definition for dcp-pairs is that $V(P)-V(C)=V(P)$ and  $E(C)-E(P)=E(C)$.
%For short, instead of a { broken lollipop} we will say a {\em b-lollipop}.

With the help of dcp-pairs, we will show that there is 
a $2$-good lollipop $(C',P')$ with $|E(P)|\geq k$, thus obtaining the final contradiction.

So, the four big pieces of the proof are the following.


\begin{lemma}\label{nlem3}
Let $(C,P)$ be a best lollipop in $H$. If $|V(C)|=c$, $|E(P))|=\ell$ and
 $c < \min\{2k,n,|E(H)|\}$, % and $P$ is a Berge path,
then $\ell < k$.
\end{lemma}


\begin{lemma}\label{nlem2}
%If $H$ contains  a b-lollipop $(C,P)$ with $|V(C)|=c<\min\{2k,n,|E(H)|\}$ and $|V(P))|=\ell\geq k$, 
%then $H$ contains  a   lollipop $(C',P')$ with $|V(C')|=c$ and $|V(P'))|\geq k$.
%
Let $(C,P)$ be a best lollipop in $H$ with $|V(C)|=c$, $|E(P))| < k$ and
 $c < \min\{2k,n,|E(H)|\}$. Then every $2$-good dcp-pair $(C', P')$ in $H$ has $|V(P')| < k$. 
\end{lemma}


\begin{lemma}\label{nlem0}
Let $(C,P)$ be a $3$-good dcp-pair in $H$. If $|V(C)|=c$, $|V(P))|=\ell$ and
 $c < \min\{2k,n,|E(H)|\}$, % and $P$ is a Berge path,
then $\ell \geq 2$.
\end{lemma}


\begin{lemma}\label{nlem1}
Let $(C,P)$ be a $4$-good dcp-pair in $H$. If $|V(C)|=c$, $|V(P))|=\ell$ and
 $c < \min\{2k,n,|E(H)|\}$, % and $P$ is a Berge path,
then $\ell \geq k$.
\end{lemma}



To prepare the proofs of Lemmas~\ref{nlem3}--\ref{nlem1}, in the next  section we 
describe some useful properties of good  lollipops and dcp-pairs. After that, in the next four sections we prove Lemmas~\ref{nlem3}--\ref{nlem1}.








