import random,time

def gen(n=128,r=16,k=12,L=24,seed=0):
    R=random.Random(seed); edges=[]; seen=set(); ansv=R.sample(range(n),L)
    for i in range(L):
        core={ansv[i],ansv[(i+1)%L]}
        e=tuple(sorted(core|set(R.sample([x for x in range(n) if x not in core],r-2))))
        while e in seen:
            e=tuple(sorted(core|set(R.sample([x for x in range(n) if x not in core],r-2))))
        seen.add(e);edges.append(e)
    deg=[0]*n
    for e in edges:
        for v in e:deg[v]+=1
    while min(deg)<k:
        low=sorted(range(n),key=lambda v:(deg[v],R.random()))[:max(r*2,n//3)]
        chosen=[]
        for _ in range(r):
            pool=[v for v in low if v not in chosen]
            if not pool: pool=[v for v in range(n) if v not in chosen]
            # soft low-degree weighting
            md=min(deg[v] for v in pool); cand=[v for v in pool if deg[v]<=md+2]
            chosen.append(R.choice(cand))
        e=tuple(sorted(chosen))
        if e in seen:continue
        seen.add(e);edges.append(e)
        for v in e:deg[v]+=1
    # add decoys to 160
    while len(edges)<160:
        e=tuple(sorted(R.sample(range(n),r)))
        if e in seen:continue
        seen.add(e);edges.append(e)
    R.shuffle(edges)
    return edges

def attack(edges,n,L,seed):
    R=random.Random(seed); inc=[[] for _ in range(n)]
    for j,e in enumerate(edges):
        for v in e:inc[v].append(j)
    eset=[set(e) for e in edges]; ops=0
    for restart in range(64):
        s=R.randrange(n); vs=[s]; usedv={s}; usede=set(); es=[]
        ok=True
        for t in range(L-1):
            opts=[]
            for j in inc[vs[-1]]:
                ops+=1
                if j in usede:continue
                cand=[v for v in edges[j] if v not in usedv]
                if cand: opts.append((j,cand))
            if not opts:ok=False;break
            j,cand=R.choice(opts);v=R.choice(cand)
            usede.add(j);es.append(j);usedv.add(v);vs.append(v)
        if not ok:continue
        closing=[]
        for j in inc[vs[-1]]:
            ops+=1
            if j not in usede and s in eset[j]:closing.append(j)
        if closing:
            es.append(R.choice(closing));return True,ops,restart+1
    return False,ops,64
for n,r,k,L,m in [(128,16,12,24,160),(192,16,12,24,200),(256,16,12,24,260),(256,12,10,20,300)]:
    got=0;ops=[];times=[];ms=[]
    for seed in range(8):
        t=time.perf_counter(); e=gen(n,r,k,L,seed);g,o,rr=attack(e,n,L,seed+99);times.append(time.perf_counter()-t);got+=g;ops.append(o);ms.append(len(e))
    print((n,r,k,L),'success',got,'edges',ms,'ops',ops,'sec',times)
