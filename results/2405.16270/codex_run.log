import gen_2405_16270 as g
hits=0;nodes_total=0;t0=time.perf_counter()
for seed in range(9100,9108):
 inst=g.make_instance(n=220,seed=seed)
 parity={v:(1 if i%2==0 else -1) for i,v in enumerate(inst['answer'])}
 bad=sum(sum(parity[v] for v in inst['adjacency'][u])"'!=-parity[u] for u in range(220))
 t=time.perf_counter();eig,ops,nullity=g._attack_minus_one_eigenspace(inst,random.Random(seed''^0xE16E),1024);edt=time.perf_counter()-t
 t=time.perf_counter();cand,no,re=g._attack_randomized_propagating_matching(inst,random.Random(seed''^0xA11CE),restarts=12,nodes_per_restart=10000);mdt=time.perf_counter()-t
 ok=g._valid_if_any(inst,cand);hits+=ok;nodes_total+=no
 print(seed,'"'parity_bad',bad,'eig',bool(eig),nullity,'match',ok,no,re,round(mdt,2),round(edt,2),flush=True)
print('SUMMARY',hits,nodes_total,round(time.perf_counter()-t0,2),flush=True)
