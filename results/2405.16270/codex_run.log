+    size = len(points)
+    if size % 2:
+        return None
+    counts = [[0] * (size + 1) for _ in range(size + 1)]
+    for i in range(size + 1):
+        counts[i][i] = 1
+    for length in range(2, size + 1, 2):
+        for left in range(size - length + 1):
+            right = left + length
+            total = 0
+            for partner in range(left + 1, right, 2):
+                u, v = points[left], points[partner]
+                if (u - v) % n in (1, n - 1):
