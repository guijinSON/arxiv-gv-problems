+            [v for v in adjacency[u] if signs[v] != signs[u]] for u in range(n)
+        ]
+        if any(len(row) != 2 for row in cycle_adjacency):
+            return None
+        order = [0]
+        seen = {0}
+        previous = -1
+        current = 0
+        while True:
+            nxt = next(v for v in cycle_adjacency[current] if v != previous)
+            if nxt == 0:
+                break
+            if nxt in seen:
+                return None
+            order.append(nxt)
+            seen.add(nxt)
+            previous, current = current, nxt
