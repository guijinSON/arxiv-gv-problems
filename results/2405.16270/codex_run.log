+            best_delta = n
+            choices: list[int] = []
+            for flipped in [vertex] + adjacency[vertex]:
+                affected = [flipped] + adjacency[flipped]
+                before = sum(item in bad for item in affected)
+                signs[flipped] ^= 1
+                after = sum(not good(item, signs) for item in affected)
+                signs[flipped] ^= 1
