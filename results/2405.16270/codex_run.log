    stack=[st];verts=0;ds=0
    while stack:
     u=stack.pop()
     if u in seen:continue
     seen.add(u);verts+=1;ds+=len(ca[u]);stack += [v for v in ca[u] if v not in seen]
    if ds//2>=verts and verts<n:return False
  return True
 def completed():
