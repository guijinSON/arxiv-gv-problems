+    if best_signs is None:
+        return None, iterations, 0, n
+    order = sorted(
+        range(n),
+        key=lambda vertex: (
+            not good(vertex, best_signs),
+            best_signs[vertex],
+            rng.random(),
+        ),
+    )
+    permutation = [0] * n
