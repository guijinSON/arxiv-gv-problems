+}
+
+SHIPPING_DIFFICULTY: str = "medium"
+
+STRUCTURAL_HINT: str = (
+    "In a cubic graph the omitted edges form a perfect matching whose two "
+    "noncrossing pages share one hidden cyclic order."
+)
+
+PLACEBO_HINT: str = (
+    "In this cubic graph every listed endpoint matters, so check the closing "
