+    order = sorted(
+        range(n),
+        key=lambda vertex: (
+            not good(vertex, best_signs),
+            best_signs[vertex],
+            rng.random(),
+        ),
+    )
+    permutation = [0] * n
+    for new, old in enumerate(order):
+        permutation[old] = new
