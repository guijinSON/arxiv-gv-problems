+        choices: list[tuple[int, int]] = []
+        total = 0
+        for partner in range(left + 1, right, 2):
+            u, v = points[left], points[partner]
+            if (u - v) % n in (1, n - 1):
+                continue
+            weight = counts[left + 1][partner] * counts[partner + 1][right]
+            if weight:
