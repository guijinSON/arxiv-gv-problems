+
+    attack_seeds = list(range(9100, 9108))
+    successes = {
+        "local_signature_outlier": 0,
+        "greedy_constrained_walk": 0,
+        "random_restart_64": 0,
+        "spectral_cycle_seriation": 0,
+        "perfect_matching_complement_200k": 0,
+    }
+    random_operations = 0
+    spectral_operations = 0
+    matching_nodes = 0
+    matching_wall = 0.0
+    matching_nodes_per_seed = []
+    for seed in attack_seeds:
+        attack_inst = make_instance(seed=seed, **ship_params)
+        if _valid(attack_inst, _local_signature_attack(attack_inst)):
+            successes["local_signature_outlier"] += 1
+        if _valid(attack_inst, _greedy_attack(attack_inst)):
+            successes["greedy_constrained_walk"] += 1
+        candidate, operations = _random_restart_attack(
+            attack_inst, random.Random(seed ^ 0x5A17), restarts=64
+        )
+        random_operations += operations
