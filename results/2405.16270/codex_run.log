import random,time,math
import numpy as np
import gen_2405_16270 as g

def make(n,seed,swaps):
 rng=random.Random(seed)
 for _ in range(64):
  A=list(range(0,n,2));B=list(range(1,n,2))
  ae=rng.sample(range(len(A)),swaps);bo=rng.sample(range(len(B)),swaps)
  for i,j in zip(ae,bo):A[i],B[j]=B[j],A[i]
  A.sort();B.sort()
  x=g._sample_noncrossing_matching_without_cycle_edges(A,n,rng);y=g._sample_noncrossing_matching_without_cycle_edges(B,n,rng)
  if x is not None and y is not None:break
 rel=list(range(n));rng.shuffle(rel);ans=g._normalize_cycle([rel[i] for i in range(n)])
 edges={tuple(sorted((rel[u],rel[v]))) for u,v in [(i,(i+1)%n) for i in range(n)]+x+y};el=[list(e) for e in edges];rng.shuffle(el)
 return {'n':n,'edges':el,'adjacency':g._adjacency_from_edges(n,el),'answer':ans}

def eigcorr(inst):
 n=inst['n'];A=np.zeros((n,n))
 for u,row in enumerate(inst['adjacency']):
  for v in row:A[u,v]=1
 vals,Q=np.linalg.eigh(A);ix=np.argmin(abs(vals+1));s=np.where(Q[:,ix]>=0,1,-1)
 true=np.zeros(n,dtype=int)
 for i,v in enumerate(inst['answer']):true[v]=1 if i%2==0 else -1
 return float(abs(np.dot(s,true))/n),float(vals[ix]),int(sum(sum(s[v]==s[u] for v in inst['adjacency'][u])"'!=1 for u in range(n)))
for swaps in (4,10,20,35,55):
 print('"'SWAPS',swaps,flush=True);hits=0;nodes=0;cors=[]
 for seed in range(9100,9108):
  inst=make(220,seed,swaps);cor,val,bad=eigcorr(inst);cors.append(cor)
  t=time.perf_counter();cand,no,re=g._attack_randomized_propagating_matching(inst,random.Random(seed"'^0xA11CE),restarts=2,nodes_per_restart=5000)
  ok=g._valid_if_any(inst,cand);hits+=ok;nodes+=no
  print(seed,ok,no,'"'eig',round(val,3),'corr',round(cor,3),'bad',bad,'sec',round(time.perf_counter()-t,2),flush=True)
 print('SUM',hits,nodes,'corravg',round(sum(cors)/8,3),flush=True)
