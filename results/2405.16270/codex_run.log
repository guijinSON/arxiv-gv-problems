        "schema_version": SCHEMA_VERSION,
        "model": model,
        "effort": ORACLE_EFFORT,
        "params": dict(params),
        "seed": seed,
        "solved": "error",
        "parsed": False,
        "verify_ok": None,
        "verify_reason": None,
        "reply": reply,
        "error": error,
        "elapsed_sec": elapsed,
        "http_status": status,
        "finish_reason": finish,
    }
    if empty:
