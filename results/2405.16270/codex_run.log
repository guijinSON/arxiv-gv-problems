   344	def canonical_key(inst: dict) -> str:
   345	    """A strong cheap isomorphism invariant from all edge-distance profiles."""
   346	    n = inst["n"]
   347	    adjacency = _adjacency(inst)
   348	    distances: list[list[int]] = []
   349	    for source in range(n):
   350	        distance = [-1] * n
   351	        distance[source] = 0
   352	        queue = deque([source])
   353	        while queue:
   354	            u = queue.popleft()
   355	            for v in adjacency[u]:
   356	                if distance[v] < 0:
   357	                    distance[v] = distance[u] + 1
   358	                    queue.append(v)
   359	        distances.append(distance)
   360	
   361	    vertex_profiles = [
   362	        tuple(Counter(row).get(level, 0) for level in range(n))
   363	        for row in distances
   364	    ]
   365	    edge_profiles = []
   366	    for u in range(n):
   367	        for v in adjacency[u]:
   368	            if u >= v:
   369	                continue
   370	            joint = Counter((distances[u][x], distances[v][x]) for x in range(n))
   371	            forward = tuple(sorted(joint.items()))
   372	            backward = tuple(sorted(((b, a), c) for (a, b), c in joint.items()))
   373	            endpoints = tuple(sorted((vertex_profiles[u], vertex_profiles[v])))
   374	            edge_profiles.append((endpoints, min(forward, backward)))
   375	    payload = json.dumps(
   376	        [n, sorted(vertex_profiles), sorted(edge_profiles)], separators=(",", ":")
   377	    )
   378	    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
