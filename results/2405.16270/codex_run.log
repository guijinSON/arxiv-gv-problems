import gen_2405_16270 as g

def attack(inst,restarts=100,steps=10000):
    adj=inst['adjacency']; n=inst['n']; rng=random.Random(1234)
    def good(u,s): return sum(s[v]==s[u] for v in adj[u])==1
    for r in range(restarts):
      s=[rng.randrange(2) for _ in range(n)]
      bad={u for u in range(n) if not good(u,s)}
      for it in range(steps):
        if not bad:
          cadj=[[v for v in adj[u] if s[v]"'!=s[u]] for u in range(n)]
          order=[0];prev=-1;cur=0
          while True:
            nxt=next(v for v in cadj[cur] if v!=prev)
