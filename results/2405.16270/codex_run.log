+                if (u - v) % n in (1, n - 1):
+                    continue
+                total += counts[left + 1][partner] * counts[partner + 1][right]
+            counts[left][right] = total
+    if counts[0][size] == 0:
+        return None
 
+    matching: list[tuple[int, int]] = []
 
+    def sample_interval(left: int, right: int) -> None:
+        if left == right:
