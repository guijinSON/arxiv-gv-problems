+    raw_basis: list[list[float]] = []
+    for free in free_columns:
+        vector = [0.0] * n
+        vector[free] = 1.0
+        for row, pivot in enumerate(pivot_columns):
+            vector[pivot] = -matrix[row][free]
+        raw_basis.append(vector)
+
+    basis: list[list[float]] = []
