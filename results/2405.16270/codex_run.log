+        first_page.sort()
+        second_page.sort()
+        first = _sample_noncrossing_matching_without_cycle_edges(first_page, n, rng)
+        second = _sample_noncrossing_matching_without_cycle_edges(second_page, n, rng)
+        if first is not None and second is not None:
+            return first + second
