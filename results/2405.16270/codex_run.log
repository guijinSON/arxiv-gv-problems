+        "exact per-vertex visit count",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "duality",
+    "intuition_description": (
+        "In a cubic graph a Hamiltonian cycle is the complement of a perfect "
+        "matching; the hidden cyclic order also makes the remaining matching "
+        "split into two noncrossing pages, while local edge and vertex "
+        "statistics do not identify the cycle."
+    ),
+    "hardness_basis": (
+        "Track A: Theorem 1 proves NP-hardness for d-regular graphs when d is "
+        "odd and b<d; shipping uses a=b=1, d=3, n=120 in a relabelled "
+        "two-page planted distribution, where the measured domain-standard "
+        "perfect-matching/complement search exhausts 200000 nodes on each of "
+        "8 seeds without finding a witness."
