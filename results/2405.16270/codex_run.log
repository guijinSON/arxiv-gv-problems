+    decoys only; the Hamilton cycle certificate was already chosen.
+    """
+    size = len(points)
+    if size % 2:
+        return None
+    counts = [[0] * (size + 1) for _ in range(size + 1)]
+    for i in range(size + 1):
+        counts[i][i] = 1
+    for length in range(2, size + 1, 2):
