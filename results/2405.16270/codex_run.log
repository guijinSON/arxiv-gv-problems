+    for _ in range(trials):
+        values = [rng.gauss(0.0, 1.0) for _ in range(n)]
+        previous_signs: tuple[int, ...] | None = None
+        for _ in range(16):
+            coefficients = [
+                sum(x * y for x, y in zip(values, vector)) for vector in basis
+            ]
