    random.Random(reorder_seed).shuffle(edges)
    out = dict(inst)
    out["vertices"] = list(range(n))
    out["edges"] = edges
    out["adjacency"] = _adjacency_from_edges(n, edges)
    out["answer"] = _normalize_cycle([permutation[v] for v in inst["answer"]])
    return out


