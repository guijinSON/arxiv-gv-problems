+        chosen = choices[-1][0]
+        for partner, weight in choices:
+            if draw < weight:
+                chosen = partner
+                break
+            draw -= weight
+        matching.append((points[left], points[chosen]))
+        sample_interval(left + 1, chosen)
+        sample_interval(chosen + 1, right)
+
+    sample_interval(0, size)
+    return matching
