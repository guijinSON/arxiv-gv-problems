   577	        current = min(
   578	            candidates,
   579	            key=lambda u: (sum(mate[v] < 0 for v in adjacency[u]), u),
   580	        )
   581	        choices = [v for v in adjacency[current] if mate[v] < 0]
   582	        for nxt in choices:
