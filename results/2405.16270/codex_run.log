+        if abs(matrix[best][column]) <= tolerance:
+            continue
+        matrix[pivot_row], matrix[best] = matrix[best], matrix[pivot_row]
+        pivot = matrix[pivot_row][column]
+        for j in range(column, n):
+            matrix[pivot_row][j] /= pivot
+            operations += 1
+        for row in range(n):
