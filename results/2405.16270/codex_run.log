+def _two_page_decoy_matching(n: int, rng: random.Random) -> list[tuple[int, int]]:
+    """Draw a perfect decoy matching carried by two noncrossing pages."""
+    for _ in range(64):
+        first_page = list(range(0, n, 2))
+        second_page = list(range(1, n, 2))
