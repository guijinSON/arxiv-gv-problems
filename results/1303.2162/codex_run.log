+        if first is None:
+            return None, j
+        c = 8 * n + 6 * j
+        choices = {
+            1: (c + 3, c + 5),
+            2: (c + 2, c + 5),
+            3: (c + 2, c + 4),
+        }
+        for x in choices[first]:
