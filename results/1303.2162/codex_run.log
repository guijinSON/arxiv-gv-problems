+    answer_chars = len(serialized)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = len(answer)
+    intended_ops = 10 + 2 * (inst["n"] - 5)
+    arms = copy.deepcopy(G9_RESULTS["arms"])
