+        body = matches[-1].strip()
+        if body.startswith("~~~") and body.endswith("~~~"):
+            body = re.sub(r"^~~~[^\n]*\n?", "", body)
+            body = re.sub(r"\n?~~~$", "", body).strip()
+        if body.startswith("[") and body.endswith("]"):
+            body = body[1:-1].strip()
+        if not body:
+            return []
+        parts = [p.strip() for p in body.split(",")]
+        if any(not re.fullmatch(r"[+-]?\d+", p) for p in parts):
