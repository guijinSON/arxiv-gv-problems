+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    count = 0
+    for candidate in itertools.combinations(range(1, inst["n"] + 1), inst["true_count"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
