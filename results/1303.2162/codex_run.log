\title{New Hardness Results for Guarding Orthogonal Polygons with Sliding
Cameras\thanks{Work supported in part by the Natural Sciences and
Engineering Research Council of Canada (NSERC).}}

\author{Stephane Durocher and Saeed Mehrabi\\
Department of Computer Science,\\ University of Manitoba, Winnipeg,
Canada.\\ \texttt{\{durocher,mehrabi\}@cs.umanitoba.ca}}

