import random

def xor_clauses(vs,b):
 out=[]
 for mask in range(8):
  if ((mask.bit_count()&1)==b): continue
  clause=[]
  for q,v in enumerate(vs):
   val=(mask>>q)&1
   clause.append(-v if val else v)
  out.append(clause)
 return out

def gen(n,seed):
 rng=random.Random(seed)
 sol=[0]*n
 for i in rng.sample(range(n),n//2):sol[i]=1
 perm=list(range(1,n+1));rng.shuffle(perm)
 eq=[]
 for i in range(5):
  vs=[i,(i+1)%5,(i+2)%5]; b=sol[vs[0]]"'^sol[vs[1]]''^sol[vs[2]]
  eq.append(([perm[x] for x in vs],b))
 for i in range(5,n):
  vs=[i,i-1,i-2]; b=sol[i]''^sol[i-1]''^sol[i-2]
  eq.append(([perm[x] for x in vs],b))
 cls=[]
 for vs,b in eq:
  z=xor_clauses(vs,b)
  for c in z:rng.shuffle(c)
  cls+=z
 rng.shuffle(cls)
 phys=[0]*n
 for h,p in enumerate(perm):phys[p-1]=sol[h]
 return cls,phys

def sat(c,a):return any((lit>0)==bool(a[abs(lit)-1]) for lit in c)
def score(cls,a):return sum(sat(c,a) for c in cls)
def greedy(cls,n,steps=10000):
 # start first half true; best swaps
 a=[1 if i<n//2 else 0 for i in range(n)]
 cur=score(cls,a)
 for st in range(steps):
  best=cur; pair=None
  ones=[i for i,x in enumerate(a) if x]
  zeros=[i for i,x in enumerate(a) if not x]
  for i in ones:
   a[i]=0
   for j in zeros:
    a[j]=1;s=score(cls,a);a[j]=0
    if s>best:best=s;pair=(i,j)
   a[i]=1
  if pair is None:return a,cur,st
  i,j=pair;a[i]=0;a[j]=1;cur=best
 return a,cur,steps
for seed in range(8):
 cls,sol=gen(120,seed)
 a,s,it=greedy(cls,120)
 print(seed,a==sol,s,len(cls),it)
