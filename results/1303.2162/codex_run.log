+def render(inst):
+    n, m = inst["n"], inst["m"]
+    frame = inst["frame"]
+    sorted_segments = sorted(inst["segments"], key=lambda p: (p[0], p[1]))
+    segment_lines = []
+    for start in range(0, len(sorted_segments), 16):
+        chunk = sorted_segments[start : start + 16]
+        segment_lines.append("  " + "  ".join(f"[{a},{b}]" for a, b in chunk))
