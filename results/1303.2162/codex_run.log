+    "committing to the final certificate."
+)
+
+PROBLEM_PROFILE = {
+    "native_domain": "geometry",
+    "object_regime": "integer_lattice",
+    "computational_core": "csp_sat",
+    "certificate_form": "exact_symbolic",
