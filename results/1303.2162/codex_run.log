+def _canonical_segment_data(n, clauses):
+    """Return [a,b] for the unit segment [(a,b),(a+1,b)]."""
+    segments = []
+    variable_shape = ((1, 2), (2, 4), (3, 3), (5, 2), (6, 1), (7, 3))
+    for i in range(n):
