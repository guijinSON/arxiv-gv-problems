+import os
+import random
+import re
+import statistics
+import time
+
+TRACK = "B"
+
+STRUCTURAL_HINT = (
+    "Group clauses by their three indices: each four-clause block is one XOR, and "
+    "the resulting incidence hypergraph peels to a five-variable core."
+)
