+                x = a if sx == 1 else -a - 1
+                y = sy * b
+                transformed.append((x, y))
+            min_x = min(x for x, _ in transformed)
+            min_y = min(y for _, y in transformed)
+            normalized = sorted((x - min_x, y - min_y) for x, y in transformed)
