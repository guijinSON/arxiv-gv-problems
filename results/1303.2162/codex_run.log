+        "greedy_balanced_swaps": {"successes": 0, "attempts": 0},
+        "random_restart_balanced_12x": {"successes": 0, "attempts": 0},
+        "in_context_fixed_ansatz": {"successes": 0, "attempts": 0},
+    }
+    ref_successes = 0
