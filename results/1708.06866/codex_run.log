    # Shared structure-aware shipping density sample for G4/G5.
    density_inst = make_instance(
        seed=11, **DIFFICULTY[SHIPPING_DIFFICULTY]
    )
    density_rng = random.Random(0x170806866)
    samples = 200_000
    hits = 0
