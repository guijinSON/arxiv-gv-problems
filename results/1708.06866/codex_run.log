-def _inverse_vertex(comp, u: int, v: int) -> tuple[int, int]:
-    a, b, c, d = comp["matrix"]
-    s, t = comp["offset"]
-    uu, vv = u - s, v - t
-    return d * uu - b * vv, -c * uu + a * vv
