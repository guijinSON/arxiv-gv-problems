   344	def _validate_component(comp) -> tuple[bool, str]:
   345	    if not isinstance(comp, dict):
   346	        return False, "component data are malformed"
   347	    try:
   348	        matrix = comp["matrix"]
   349	        offset = comp["offset"]
   350	        bounds = comp["bounds"]
   351	        steps = comp["steps"]
   352	        tag = comp["tag"]
   353	    except KeyError:
   354	        return False, "component data omit a required field"
   355	    if isinstance(tag, bool) or not isinstance(tag, int):
   356	        return False, "component tag is invalid"
   357	    if (not isinstance(matrix, list) or len(matrix) != 4
   358	            or any(isinstance(x, bool) or not isinstance(x, int) for x in matrix)):
   359	        return False, "component matrix is malformed"
   360	    a, b, c, d = matrix
   361	    if a * d - b * c != 1:
   362	        return False, "component coordinate matrix is not unimodular"
   363	    if (not isinstance(offset, list) or len(offset) != 2
   364	            or any(isinstance(x, bool) or not isinstance(x, int) for x in offset)):
   365	        return False, "component offset is malformed"
   366	    if (not isinstance(bounds, list) or len(bounds) != 4
   367	            or any(isinstance(x, bool) or not isinstance(x, int) for x in bounds)):
   368	        return False, "component bounds are malformed"
   369	    width, height = _shape(comp)
   370	    if width < 3 or height < 3 or width != height:
   371	        return False, "component bounds do not define a supported square"
   372	    if (not isinstance(steps, list) or len(steps) != 4
   373	            or any(not isinstance(v, list) or len(v) != 2 for v in steps)
   374	            or any(isinstance(x, bool) or not isinstance(x, int)
   375	                   for v in steps for x in v)):
   376	        return False, "component edge steps are malformed"
   377	    got = {_canonical_undirected_step((v[0], v[1])) for v in steps}
   378	    if got != _expected_steps(matrix):
   379	        return False, "component edge steps do not match its coordinate forms"
   380	    return True, "ok"
   381	
