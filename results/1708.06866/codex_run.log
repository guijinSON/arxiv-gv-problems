+def _visible_consecutive_run(inst):
+    q = int(inst["q"])
+    magnitudes = {min(int(s), q - int(s)) for s in inst["steps"]}
+    run = 0
+    while run + 1 in magnitudes:
+        run += 1
+    return q * run * (run - 1) // 2
 
 
