+def _attack_smallest_gap(inst) -> list[int]:
+    output = []
+    for graph in inst["graphs"]:
+        q = int(graph["q"])
+        values = sorted(graph["steps"])
+        gaps = [values[i + 1] - values[i] for i in range(len(values) - 1)]
+        gaps.append(q + values[0] - values[-1])
+        guess = min(gaps)
+        if math.gcd(guess, q) == 1 and _fit_template(graph, guess, False):
+            output.append(_interval_formula(graph))
+        else:
+            output.append(0)
+    return output
 
 
