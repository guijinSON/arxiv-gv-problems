-    for comp, tag in zip(out["components"], tags):
-        comp["tag"] = tag
-    return out
+def _attack_random_scalars(inst, seed: int, restarts: int = 32) -> list[int]:
+    rng = random.Random(seed)
+    output = []
+    for graph in inst["graphs"]:
+        recognized = None
+        q = int(graph["q"])
+        for _ in range(restarts):
+            candidate = _random_unit(q, rng)
+            if _fit_template(graph, candidate, False):
+                recognized = _interval_formula(graph)
+                break
+            if _fit_template(graph, candidate, True):
+                recognized = 0
+                break
+        output.append(0 if recognized is None else recognized)
+    return output
 
 
