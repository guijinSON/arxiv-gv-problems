   556	def _retagged(inst, rng):
   557	    out = json.loads(json.dumps(inst))
   558	    tags = rng.sample(range(1_000_000_000, 1_999_999_999), len(out["components"]))
   559	    for comp, tag in zip(out["components"], tags):
   560	        comp["tag"] = tag
