+def _greedy_smallest_gap_scalar(inst):
+    q = int(inst["q"])
+    values = sorted(inst["steps"])
+    gaps = [values[i + 1] - values[i] for i in range(len(values) - 1)]
+    gaps.append(q + values[0] - values[-1])
+    guess = min(gaps)
+    if math.gcd(guess, q) != 1:
+        return None
+    n = len(values) // 2
+    predicted = {(guess * j) % q for j in range(1, n + 1)}
+    predicted |= {(-guess * j) % q for j in range(1, n + 1)}
+    return q * n * (n - 1) // 2 if predicted == set(values) else None
 
 
