+    reorder_steps: bool,
+    reorder_components: bool,
+) -> dict:
+    rng = random.Random(seed)
+    items = []
+    for graph, count in zip(inst["graphs"], inst["answer"]):
+        q = int(graph["q"])
+        unit = _random_unit(q, rng) if scale else 1
+        steps = [(unit * int(step)) % q for step in graph["steps"]]
+        if reorder_steps:
