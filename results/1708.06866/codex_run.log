-        "floor(28*w*h/3) for its w*h-vertex maximum-degree-8 graph; `total` is "
-        "forced to be their sum."
-    ),
-    "bounds": {
-        "shipping_component_count": 40,
-        "component_count_lower": 0,
-        "component_count_upper": "floor(28*w*h/3)",
-        "total": "sum(component_counts)",
-    },
-}
