   123	NOTES = """\
   124	Section III-A fixes the native object and witness: a triangle is a set of three
   125	mutually adjacent vertices, and correctness is an exact triangle count (Section
   126	IV-A).  Algorithms 1-3 in Section III-A are the decisive easy-case result: they
   127	compute the certificate by matrix products, so this cannot honestly be Track A.
   128	Section V-C supplies the construction used here: an M by M image graph connects
   129	each pixel to its eight neighbours.  The module composes disjoint copies and
   130	carries their counts through integer unimodular coordinate relabellings.
   131	
   132	The paper's Table II lists 8(M-1)^2 triangles, but its set definition and its
   133	Algorithm 2 division by six give the ordinary undirected count 4(M-1)^2: every
   134	unit cell induces K4 and contributes its four 3-subsets exactly once.  This
   135	module follows that definition, not the inconsistent table.
   136	
   137	The largest-component outlier attack ignores all other components; edge/3 and
   138	the degree-bound midpoint lose the cell structure; the one-triangle-per-cell
   139	ansatz misses three of K4's four triangles; copying Table II double-counts; and
   140	uniform restarts sample the statement-aware degree-bounded certificate language.
   141	All are checked across eight shipping seeds.  The successful standard forward
   142	triangle algorithm is disclosed separately, as Track B requires.
   143	"""
   144	
   145	
   146	def _unimodular_matrix(rng: random.Random, shears: int) -> list[int]:
   147	    """Generate [a,b,c,d] with determinant one, without search."""
   148	    a, b, c, d = 1, 0, 0, 1
   149	    for _ in range(shears):
   150	        k = rng.choice((-4, -3, -2, -1, 1, 2, 3, 4))
   151	        if rng.randrange(2):
   152	            a, b = a + k * c, b + k * d
   153	        else:
   154	            c, d = c + k * a, d + k * b
   155	    if rng.randrange(2):
   156	        # Left multiplication by [[0,1],[-1,0]] preserves determinant one.
   157	        a, b, c, d = c, d, -a, -b
   158	    if rng.randrange(2):
   159	        a, b, c, d = -a, -b, -c, -d
   160	    assert a * d - b * c == 1
   161	    return [a, b, c, d]
   162	
   163	
   164	def _raw_steps(matrix: list[int]) -> list[tuple[int, int]]:
   165	    """Images under A^-1 of (1,0),(0,1),(1,1),(1,-1)."""
   166	    a, b, c, d = matrix
   167	    return [(d, -c), (-b, a), (d - b, a - c), (d + b, -c - a)]
   168	
   169	
   170	def _canonical_undirected_step(v: tuple[int, int]) -> tuple[int, int]:
   171	    x, y = v
   172	    return (-x, -y) if (x < 0 or (x == 0 and y < 0)) else (x, y)
   173	
   174	
   175	def _display_steps(matrix: list[int], rng: random.Random) -> list[list[int]]:
   176	    steps = list(_raw_steps(matrix))
   177	    rng.shuffle(steps)
   178	    out = []
   179	    for x, y in steps:
   180	        if rng.randrange(2):
   181	            x, y = -x, -y
   182	        out.append([x, y])
   183	    return out
   184	
   185	
   186	def _shape(comp) -> tuple[int, int]:
   187	    lo1, hi1, lo2, hi2 = comp["bounds"]
   188	    return hi1 - lo1, hi2 - lo2
   189	
   190	
   191	def _component_count(comp) -> int:
   192	    width, height = _shape(comp)
   193	    # Each unit cell induces K4.  Every triangle has a unique
   194	    # 1-by-1 bounding cell and is one of that K4's four 3-subsets.
   195	    return 4 * (width - 1) * (height - 1)
   196	
   197	
   198	def _component_bound(comp) -> int:
   199	    # Delta <= 8, so at most C(8,2) incident triangle pairs per vertex; every
   200	    # triangle is incident with three vertices.
   201	    width, height = _shape(comp)
   202	    return (28 * width * height) // 3
   203	
