+
+def _validate_component(comp) -> tuple[bool, str]:
+    if not isinstance(comp, dict):
+        return False, "component data are malformed"
+    try:
+        matrix = comp["matrix"]
+        offset = comp["offset"]
+        bounds = comp["bounds"]
