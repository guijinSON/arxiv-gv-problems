+DIFFICULTY = {
+    "demo": {"n": 3, "components": 2, "jitter": 1, "shears": 1},
+    "easy": {"n": 18, "components": 12, "jitter": 7, "shears": 2},
+    "medium": {"n": 48, "components": 28, "jitter": 15, "shears": 3},
