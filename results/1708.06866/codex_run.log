   524	def _attack_candidates(inst, rng):
   525	    components = inst["components"]
   526	    shapes = [_shape(c) for c in components]
   527	    one_per_cell = [(w - 1) * (h - 1) for w, h in shapes]
   528	    paper_table = [8 * (w - 1) * (h - 1) for w, h in shapes]
   529	    edge_over_three = [
   530	        (w * (h - 1) + h * (w - 1) + 2 * (w - 1) * (h - 1)) // 3
   531	        for w, h in shapes
   532	    ]
   533	    midpoint = [_component_bound(c) // 2 for c in components]
   534	    largest = max(range(len(components)), key=lambda i: math.prod(shapes[i]))
   535	    largest_only = [0] * len(components)
   536	    largest_only[largest] = _component_count(components[largest])
   537	    return {
   538	        "outlier_largest_component_only": [_candidate_from_counts(largest_only)],
   539	        "greedy_edges_divided_by_three": [_candidate_from_counts(edge_over_three)],
   540	        "degree_bound_midpoint": [_candidate_from_counts(midpoint)],
   541	        "in_context_one_triangle_per_cell": [_candidate_from_counts(one_per_cell)],
   542	        "paper_table_double_count": [_candidate_from_counts(paper_table)],
   543	        "random_restart_256": [random_candidate(inst, rng) for _ in range(256)],
   544	    }
   545	
