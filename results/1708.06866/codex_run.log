+def _reference_component_count(graph) -> tuple[int, int]:
+    """Generic exact circulant count; return (triangles, ordered pairs tested)."""
+    q = int(graph["q"])
+    steps = [int(value) for value in graph["steps"]]
+    if q < 4 or q % 3 == 0:
+        raise ValueError("q must be at least 4 and not divisible by 3")
+    if len(steps) != int(graph.get("degree", -1)):
+        raise ValueError("degree does not match its step-list length")
+    if not steps or len(set(steps)) != len(steps):
+        raise ValueError("steps must be nonempty and distinct")
+    membership = set(steps)
+    if 0 in membership or any(not 0 < step < q for step in steps):
+        raise ValueError("steps must be nonzero canonical residues")
+    if any((-step) % q not in membership for step in steps):
+        raise ValueError("connection set is not symmetric")
+
+    ordered_closing_pairs = 0
+    for first in steps:
+        for second in steps:
+            if (second - first) % q in membership:
+                ordered_closing_pairs += 1
+    numerator = q * ordered_closing_pairs
+    if numerator % 6:
+        raise ValueError("ordered-wedge count is inconsistent with a graph")
+    return numerator // 6, len(steps) ** 2
+
+
+def _reference_answer(inst) -> tuple[list[int], int]:
+    counts = []
+    operations = 0
+    for graph in inst["graphs"]:
+        count, component_operations = _reference_component_count(graph)
+        counts.append(count)
+        operations += component_operations
+    return counts, operations
 
 
