   313	def parse_answer(text):
   314	    """Parse the final tagged JSON object while tolerating surrounding prose."""
   315	    if not isinstance(text, str):
   316	        return None
   317	    blocks = re.findall(r"<answer>\s*(.*?)\s*</answer>", text, re.I | re.S)
   318	    if not blocks:
   319	        return None
   320	    body = blocks[-1].strip()
   321	    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
   322	    body = re.sub(r"\s*```$", "", body)
   323	    try:
   324	        answer = json.loads(body)
   325	    except (TypeError, ValueError):
   326	        return None
   327	    if not isinstance(answer, dict) or set(answer) != {"component_counts", "total"}:
   328	        return None
   329	    counts = answer.get("component_counts")
   330	    total = answer.get("total")
   331	    if not isinstance(counts, list):
   332	        return None
   333	    if any(isinstance(x, bool) or not isinstance(x, int) for x in counts):
   334	        return None
   335	    if isinstance(total, bool) or not isinstance(total, int):
   336	        return None
   337	    return answer
