+def _transformed_copy(
+    inst,
+    seed: int,
+    *,
+    scale: bool,
+    reorder_steps: bool,
+    reorder_components: bool,
+) -> dict:
+    rng = random.Random(seed)
+    items = []
+    for graph, count in zip(inst["graphs"], inst["answer"]):
+        q = int(graph["q"])
+        unit = _random_unit(q, rng) if scale else 1
+        steps = [(unit * int(step)) % q for step in graph["steps"]]
+        if reorder_steps:
+            rng.shuffle(steps)
+        items.append(
+            ({"q": q, "degree": len(steps), "steps": steps}, int(count))
+        )
+    if reorder_components:
+        rng.shuffle(items)
+    return {
+        "graphs": [item[0] for item in items],
+        "answer": [item[1] for item in items],
+    }
 
 
