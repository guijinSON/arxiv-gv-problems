+def _linear_form(a: int, b: int, s: int) -> str:
+    def term(coef, name, first=False):
+        if coef == 0:
+            return ""
+        magnitude = "" if abs(coef) == 1 else str(abs(coef)) + "*"
+        core = magnitude + name
+        if first:
+            return ("-" if coef < 0 else "") + core
+        return (" - " if coef < 0 else " + ") + core
+
+    text = term(a, "x", True)
+    text += term(b, "y", not text)
+    if not text:
+        text = "0"
+    if s:
+        text += (" + " if s > 0 else " - ") + str(abs(s))
+    return text
+
