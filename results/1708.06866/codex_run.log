   205	def make_instance(n, seed=0, **params) -> dict:
   206	    """Build certified image-graph components by composition and relabelling."""
   207	    n = int(n)
   208	    number = int(params.get("components", 40))
   209	    jitter = int(params.get("jitter", max(1, n // 3)))
   210	    shears = int(params.get("shears", 4))
   211	    if n < 3:
   212	        raise ValueError("n must be at least 3")
   213	    if number < 1 or number > 200:
   214	        raise ValueError("components must be in 1..200")
   215	    if jitter < 0:
   216	        raise ValueError("jitter must be nonnegative")
   217	    if shears < 0 or shears > 8:
   218	        raise ValueError("shears must be in 0..8")
   219	
   220	    rng = random.Random(seed)
   221	    tags = rng.sample(range(100_000, 999_999_999), number)
   222	    components = []
   223	    for tag in tags:
   224	        m = n + rng.randrange(jitter + 1)
   225	        matrix = _unimodular_matrix(rng, shears)
   226	        offset = [rng.randrange(-9999, 10000), rng.randrange(-9999, 10000)]
   227	        lo1 = rng.randrange(-5000, 5001)
   228	        lo2 = rng.randrange(-5000, 5001)
   229	        components.append({
   230	            "tag": tag,
   231	            "matrix": matrix,
   232	            "offset": offset,
   233	            "bounds": [lo1, lo1 + m, lo2, lo2 + m],
   234	            "steps": _display_steps(matrix, rng),
   235	        })
   236	    rng.shuffle(components)
   237	    counts = [_component_count(c) for c in components]
   238	    return {
   239	        "paper": "1708.06866",
   240	        "components": components,
   241	        "answer": {"component_counts": counts, "total": sum(counts)},
   242	    }
   243	
   244	
   245	def _linear_form(a: int, b: int, s: int) -> str:
   246	    def term(coef, name, first=False):
   247	        if coef == 0:
   248	            return ""
   249	        magnitude = "" if abs(coef) == 1 else str(abs(coef)) + "*"
   250	        core = magnitude + name
   251	        if first:
   252	            return ("-" if coef < 0 else "") + core
   253	        return (" - " if coef < 0 else " + ") + core
   254	
   255	    text = term(a, "x", True)
   256	    text += term(b, "y", not text)
   257	    if not text:
   258	        text = "0"
   259	    if s:
   260	        text += (" + " if s > 0 else " - ") + str(abs(s))
   261	    return text
