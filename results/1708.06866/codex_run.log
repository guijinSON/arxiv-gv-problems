+    paper_table = [8 * (w - 1) * (h - 1) for w, h in shapes]
+    edge_over_three = [
+        (w * (h - 1) + h * (w - 1) + 2 * (w - 1) * (h - 1)) // 3
+        for w, h in shapes
+    ]
