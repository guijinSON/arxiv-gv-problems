+        matrix = [c, d, -a, -b]
+        s, t = comp["offset"]
+        comp["matrix"] = matrix
+        comp["offset"] = [t, -s]
+        comp["steps"] = [list(v) for v in _raw_steps(matrix)]
+    return out
