   547	def _reordered(inst, rng):
   548	    perm = list(range(len(inst["components"])))
   549	    rng.shuffle(perm)
   550	    components = [json.loads(json.dumps(inst["components"][i])) for i in perm]
   551	    counts = [inst["answer"]["component_counts"][i] for i in perm]
   552	    return {"paper": inst["paper"], "components": components,
   553	            "answer": {"component_counts": counts, "total": sum(counts)}}
