+def _choose_modulus(n: int, q_base: int, q_span: int, rng: random.Random) -> int:
+    """Choose an odd q, not divisible by 3, with q > 6n."""
+    floor_q = max(int(q_base), 6 * n + 1)
+    first_k = max(1, (floor_q + 4) // 6)
+    q = 6 * (first_k + rng.randrange(max(1, int(q_span)))) + 1
+    if q <= 6 * n:
+        q += 6 * ((6 * n - q) // 6 + 1)
+    return q
 
 
