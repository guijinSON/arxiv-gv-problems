    print("ERROR: G6 records a SUCCESSFUL attack: " + "; ".join(_wins) + "\n"
          "       The family is solved by its own adversary panel.  Escalate the\n"
          "       parameters or reject the paper -- do not ship it.")
    sys.exit(1)
