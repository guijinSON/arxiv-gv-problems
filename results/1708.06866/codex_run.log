   471	
   472	def _inverse_vertex(comp, u: int, v: int) -> tuple[int, int]:
   473	    a, b, c, d = comp["matrix"]
   474	    s, t = comp["offset"]
   475	    uu, vv = u - s, v - t
   476	    return d * uu - b * vv, -c * uu + a * vv
   477	
   478	
   479	def _reference_component_count(comp) -> tuple[int, int]:
   480	    """Generic forward-neighbour triangle enumeration on the actual graph."""
   481	    lo1, hi1, lo2, hi2 = comp["bounds"]
   482	    vertices = {_inverse_vertex(comp, u, v)
   483	                for u in range(lo1, hi1) for v in range(lo2, hi2)}
   484	    full_steps = set()
   485	    for dx, dy in comp["steps"]:
   486	        full_steps.add((dx, dy))
   487	        full_steps.add((-dx, -dy))
   488	    triangle_count = 0
   489	    operations = len(vertices)  # vertex insertions
   490	    for x, y in vertices:
   491	        higher = []
   492	        here = (x, y)
   493	        for dx, dy in full_steps:
   494	            operations += 1
   495	            other = (x + dx, y + dy)
   496	            if other in vertices and other > here:
   497	                higher.append(other)
   498	        for i in range(len(higher)):
   499	            ux, uy = higher[i]
   500	            for j in range(i + 1, len(higher)):
   501	                vx, vy = higher[j]
   502	                operations += 1
   503	                if (vx - ux, vy - uy) in full_steps:
   504	                    triangle_count += 1
   505	    return triangle_count, operations
   506	
   507	
   508	def _reference_algorithm(inst):
   509	    start = time.perf_counter()
   510	    counts = []
   511	    operations = 0
   512	    for comp in inst["components"]:
   513	        count, used = _reference_component_count(comp)
   514	        counts.append(count)
   515	        operations += used
   516	    answer = {"component_counts": counts, "total": sum(counts)}
   517	    return answer, time.perf_counter() - start, operations
   518	
   519	
   520	def _candidate_from_counts(counts):
   521	    return {"component_counts": counts, "total": sum(counts)}
