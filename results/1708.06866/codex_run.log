        ]
        composed = _axis_swapped(_recoordinatized(_retagged(_reordered(inst, rng), rng), rng))
        variants.append(composed)
        for variant in variants:
            same = canonical_key(variant) == key
            ok, _ = verify(variant, variant["answer"])
