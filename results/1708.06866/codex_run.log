+def _has_triangle(graph) -> bool:
+    """A relabelling-invariant one-bit template signature for canonicalization."""
+    q = int(graph["q"])
+    steps = graph["steps"]
+    membership = set(steps)
+    return any(
+        (second - first) % q in membership
+        for first in steps
+        for second in steps
+    )
 
 
