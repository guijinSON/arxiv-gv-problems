+def _sampled_wedge_estimate(inst, seed: int, samples: int = 256):
+    q = int(inst["q"])
+    steps = inst["steps"]
+    membership = set(steps)
+    rng = random.Random(seed)
+    hits = 0
+    for _ in range(samples):
