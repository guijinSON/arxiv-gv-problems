   574	def _axis_swapped(inst):
   575	    """Swap the two hidden coordinates, an isomorphism of each square."""
   576	    out = json.loads(json.dumps(inst))
   577	    for comp in out["components"]:
   578	        a, b, c, d = comp["matrix"]
   579	        # [[c,d],[-a,-b]] has determinant one and represents (v,-u).
   580	        matrix = [c, d, -a, -b]
   581	        s, t = comp["offset"]
   582	        lo1, hi1, lo2, hi2 = comp["bounds"]
   583	        comp["matrix"] = matrix
   584	        comp["offset"] = [t, -s]
   585	        # If lo <= u < hi for integral u, then 1-hi <= -u < 1-lo.
   586	        comp["bounds"] = [lo2, hi2, 1 - hi1, 1 - lo1]
   587	        comp["steps"] = [list(v) for v in _raw_steps(matrix)]
   588	    return out
