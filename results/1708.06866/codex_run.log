+def escalate(params):
+    """Grow every component while keeping the certificate length fixed."""
+    out = dict(params)
+    old_n = int(out.get("n", 96))
+    out["n"] = old_n * 2
+    out["jitter"] = max(int(out.get("jitter", 31)) * 2, old_n // 2)
+    out["shears"] = min(int(out.get("shears", 4)) + 1, 8)
