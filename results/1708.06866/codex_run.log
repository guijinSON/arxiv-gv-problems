+def _reference_triangle_count(inst) -> tuple[int, int]:
+    """Exact generic circulant count; returns (triangles, pairs examined)."""
+    q = int(inst["q"])
+    steps = [int(x) for x in inst["steps"]]
+    if q < 4 or q % 3 == 0:
+        raise ValueError("q must be at least 4 and not divisible by 3")
+    if len(steps) != int(inst.get("degree", -1)):
+        raise ValueError("degree does not match the step-list length")
+    if not steps or len(set(steps)) != len(steps):
+        raise ValueError("steps must be nonempty and distinct")
+    step_set = set(steps)
+    if 0 in step_set or any(not 0 < s < q for s in steps):
+        raise ValueError("steps must be nonzero canonical residues")
+    if any((-s) % q not in step_set for s in steps):
+        raise ValueError("connection set is not symmetric")
+
+    ordered_closing_pairs = 0
+    for first in steps:
+        for second in steps:
+            if (second - first) % q in step_set:
+                ordered_closing_pairs += 1
+    numerator = q * ordered_closing_pairs
+    if numerator % 6:
+        raise ValueError("ordered-wedge count is inconsistent with a graph")
+    return numerator // 6, len(steps) * len(steps)
+
 
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check a proposed count by exact ordered-wedge enumeration."""
+    if answer is None:
+        return False, "answer is missing"
+    if isinstance(answer, list):
+        if not answer:
+            return False, "answer is an empty sequence"
+        if len(answer) > 1 and len(set(map(str, answer))) < len(answer):
+            return False, "answer contains duplicated values"
+        return False, "multiple values supplied; expected one integer"
+    if isinstance(answer, tuple):
+        return False, "tuple-shaped answer has dropped the scalar value"
+    if isinstance(answer, bool) or not isinstance(answer, int):
+        return False, "answer must be one base-10 integer"
 
