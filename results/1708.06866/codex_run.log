   427	def random_candidate(inst, rng):
   428	    """Uniformly sample the degree-aware bounded certificate language."""
   429	    counts = [rng.randrange(_component_bound(c) + 1)
   430	              for c in inst["components"]]
   431	    return {"component_counts": counts, "total": sum(counts)}
   432	
   433	
   434	def search_space(inst):
   435	    size = 1
   436	    for comp in inst["components"]:
   437	        size *= _component_bound(comp) + 1
   438	    return size
   439	
   440	
   441	def enumerate_all(inst):
   442	    ranges = [_component_bound(c) + 1 for c in inst["components"]]
   443	    size = math.prod(ranges)
   444	    if size > 200_000:
   445	        return None
   446	    hits = 0
   447	    for counts in itertools.product(*(range(r) for r in ranges)):
   448	        answer = {"component_counts": list(counts), "total": sum(counts)}
   449	        hits += int(verify(inst, answer)[0])
   450	    return hits
   451	
   452	
   453	def canonical_key(inst):
   454	    """Canonicalize component order, tags, coordinates, and grid-axis swaps."""
   455	    shapes = sorted(tuple(sorted(_shape(c))) for c in inst["components"])
   456	    blob = json.dumps(shapes, separators=(",", ":"))
   457	    return hashlib.sha256(blob.encode()).hexdigest()
   458	
   459	
   460	def escalate(params):
   461	    """Grow every component while keeping the certificate length fixed."""
   462	    out = dict(params)
   463	    old_n = int(out.get("n", 96))
   464	    out["n"] = old_n * 2
   465	    out["jitter"] = max(int(out.get("jitter", 31)) * 2, old_n // 2)
   466	    out["shears"] = min(int(out.get("shears", 4)) + 1, 8)
   467	    return out
   468	
   469	
   470	# --- Reference algorithm and adversarial probes (selftest only) ------------
   471	
   472	def _inverse_vertex(comp, u: int, v: int) -> tuple[int, int]:
   473	    a, b, c, d = comp["matrix"]
   474	    s, t = comp["offset"]
   475	    uu, vv = u - s, v - t
   476	    return d * uu - b * vv, -c * uu + a * vv
   477	
   478	
   479	def _reference_component_count(comp) -> tuple[int, int]:
   480	    """Generic forward-neighbour triangle enumeration on the actual graph."""
   481	    lo1, hi1, lo2, hi2 = comp["bounds"]
   482	    vertices = {_inverse_vertex(comp, u, v)
   483	                for u in range(lo1, hi1) for v in range(lo2, hi2)}
   484	    full_steps = set()
   485	    for dx, dy in comp["steps"]:
   486	        full_steps.add((dx, dy))
   487	        full_steps.add((-dx, -dy))
   488	    triangle_count = 0
   489	    operations = len(vertices)  # vertex insertions
   490	    for x, y in vertices:
   491	        higher = []
   492	        here = (x, y)
   493	        for dx, dy in full_steps:
   494	            operations += 1
   495	            other = (x + dx, y + dy)
   496	            if other in vertices and other > here:
   497	                higher.append(other)
   498	        for i in range(len(higher)):
   499	            ux, uy = higher[i]
   500	            for j in range(i + 1, len(higher)):
   501	                vx, vy = higher[j]
   502	                operations += 1
   503	                if (vx - ux, vy - uy) in full_steps:
   504	                    triangle_count += 1
   505	    return triangle_count, operations
   506	
   507	
   508	def _reference_algorithm(inst):
   509	    start = time.perf_counter()
   510	    counts = []
   511	    operations = 0
   512	    for comp in inst["components"]:
   513	        count, used = _reference_component_count(comp)
   514	        counts.append(count)
   515	        operations += used
   516	    answer = {"component_counts": counts, "total": sum(counts)}
   517	    return answer, time.perf_counter() - start, operations
   518	
   519	
   520	def _candidate_from_counts(counts):
   521	    return {"component_counts": counts, "total": sum(counts)}
   522	
   523	
   524	def _attack_candidates(inst, rng):
   525	    components = inst["components"]
   526	    shapes = [_shape(c) for c in components]
   527	    one_per_cell = [(w - 1) * (h - 1) for w, h in shapes]
   528	    paper_table = [8 * (w - 1) * (h - 1) for w, h in shapes]
   529	    edge_over_three = [
   530	        (w * (h - 1) + h * (w - 1) + 2 * (w - 1) * (h - 1)) // 3
   531	        for w, h in shapes
   532	    ]
   533	    midpoint = [_component_bound(c) // 2 for c in components]
   534	    largest = max(range(len(components)), key=lambda i: math.prod(shapes[i]))
   535	    largest_only = [0] * len(components)
   536	    largest_only[largest] = _component_count(components[largest])
   537	    return {
   538	        "outlier_largest_component_only": [_candidate_from_counts(largest_only)],
   539	        "greedy_edges_divided_by_three": [_candidate_from_counts(edge_over_three)],
   540	        "degree_bound_midpoint": [_candidate_from_counts(midpoint)],
   541	        "in_context_one_triangle_per_cell": [_candidate_from_counts(one_per_cell)],
   542	        "paper_table_double_count": [_candidate_from_counts(paper_table)],
   543	        "random_restart_256": [random_candidate(inst, rng) for _ in range(256)],
   544	    }
   545	
   546	
   547	def _reordered(inst, rng):
   548	    perm = list(range(len(inst["components"])))
   549	    rng.shuffle(perm)
   550	    components = [json.loads(json.dumps(inst["components"][i])) for i in perm]
   551	    counts = [inst["answer"]["component_counts"][i] for i in perm]
   552	    return {"paper": inst["paper"], "components": components,
   553	            "answer": {"component_counts": counts, "total": sum(counts)}}
   554	
   555	
   556	def _retagged(inst, rng):
   557	    out = json.loads(json.dumps(inst))
   558	    tags = rng.sample(range(1_000_000_000, 1_999_999_999), len(out["components"]))
   559	    for comp, tag in zip(out["components"], tags):
   560	        comp["tag"] = tag
