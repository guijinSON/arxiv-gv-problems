+def _fit_template(graph, multiplier: int, odd: bool) -> bool:
+    q = int(graph["q"])
+    radius = len(graph["steps"]) // 2
+    base = range(1, 2 * radius, 2) if odd else range(1, radius + 1)
+    predicted = {(multiplier * value) % q for value in base}
+    predicted |= {(-multiplier * value) % q for value in base}
+    return predicted == set(graph["steps"])
 
 
