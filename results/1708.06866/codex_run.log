   596	def selftest():
   597	    report = {
   598	        "paper": "1708.06866",
   599	        "track": TRACK,
   600	        "shipping_difficulty": SHIPPING_DIFFICULTY,
   601	    }
   602	
   603	    # G1: all presets, several seeds.
   604	    verified = 0
   605	    failures = []
   606	    for preset, params in DIFFICULTY.items():
   607	        for seed in (0, 1, 7):
   608	            inst = make_instance(seed=seed, **params)
   609	            ok, why = verify(inst, inst["answer"])
   610	            verified += int(ok)
   611	            if not ok:
   612	                failures.append(f"{preset}/{seed}: {why}")
   613	    report["G1_planted_verifies"] = {
   614	        "pass": verified == 12,
   615	        "verified": verified,
   616	        "attempts": 12,
   617	        "failures": failures,
   618	    }
   619	
   620	    # G2: corruption shapes are adapted to the structured decomposition witness.
   621	    ship = make_instance(seed=3, **DIFFICULTY[SHIPPING_DIFFICULTY])
