   564	def _recoordinatized(inst, rng):
   565	    out = json.loads(json.dumps(inst))
   566	    for comp in out["components"]:
   567	        matrix = _unimodular_matrix(rng, 4)
   568	        comp["matrix"] = matrix
   569	        comp["offset"] = [rng.randrange(-9999, 10000), rng.randrange(-9999, 10000)]
   570	        comp["steps"] = _display_steps(matrix, rng)
   571	    return out
