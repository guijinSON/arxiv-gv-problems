   383	def verify(inst, answer):
   384	    """Verify any correct certificate exactly; never consult inst['answer']."""
   385	    if not isinstance(answer, dict):
   386	        return False, "answer must be a JSON object"
   387	    if not answer:
   388	        return False, "answer object is empty"
   389	    missing = {"component_counts", "total"} - set(answer)
   390	    if missing:
   391	        return False, "answer is missing required fields"
   392	    extra = set(answer) - {"component_counts", "total"}
   393	    if extra:
   394	        return False, "answer has unexpected fields"
   395	    counts = answer["component_counts"]
   396	    total = answer["total"]
   397	    if not isinstance(counts, list):
   398	        return False, "component_counts must be a JSON list"
   399	    expected_len = len(inst["components"])
   400	    if len(counts) < expected_len:
   401	        return False, f"too few component counts: expected {expected_len}"
   402	    if len(counts) > expected_len:
   403	        return False, f"too many component counts: expected {expected_len}"
   404	    if any(isinstance(x, bool) or not isinstance(x, int) for x in counts):
   405	        return False, "every component count must be an integer"
   406	    if any(x < 0 for x in counts):
   407	        return False, "component count is outside the nonnegative range"
   408	    if isinstance(total, bool) or not isinstance(total, int):
   409	        return False, "total must be an integer"
   410	    if total != sum(counts):
   411	        return False, "total is not the sum of component_counts"
   412	
   413	    seen_tags = set()
   414	    for i, (comp, claimed) in enumerate(zip(inst["components"], counts)):
   415	        ok, why = _validate_component(comp)
   416	        if not ok:
   417	            return False, f"component {i}: {why}"
   418	        if comp["tag"] in seen_tags:
   419	            return False, "component tags are not distinct"
   420	        seen_tags.add(comp["tag"])
   421	        expected = _component_count(comp)
   422	        if claimed != expected:
   423	            return False, f"component {i} triangle count is incorrect"
   424	    return True, "ok"
   425	
