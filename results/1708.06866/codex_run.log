+def _random_scalar_restart(inst, seed: int, restarts: int = 256):
+    q = int(inst["q"])
+    n = len(inst["steps"]) // 2
+    target = set(inst["steps"])
+    rng = random.Random(seed)
+    for _ in range(restarts):
+        candidate = _random_unit(q, rng)
+        predicted = {(candidate * j) % q for j in range(1, n + 1)}
+        predicted |= {(-candidate * j) % q for j in range(1, n + 1)}
+        if predicted == target:
+            return q * n * (n - 1) // 2
+    return None
 
 
