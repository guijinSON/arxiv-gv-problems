+
+def parse_answer(text):
+    """Parse the final tagged JSON object while tolerating surrounding prose."""
+    if not isinstance(text, str):
+        return None
+    blocks = re.findall(r"<answer>\s*(.*?)\s*</answer>", text, re.I | re.S)
