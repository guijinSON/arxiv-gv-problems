  if k.startswith('G2'): print(' ',{n:x['reason'] for n,x in v['cases'].items()})
  if k.startswith('G4'): print(' ',v['hits'],v['total'],v['exact_unique_answer_probability'],v['construction_aware_template_guess_probability'])
  if k.startswith('G5'): print(' ',v['baseline_wall_clock_sec'],v['baseline_pair_checks_per_instance'])
  if k.startswith('G6'): print(' ',v['attacks'],v['reference_algorithm'])
