+def _attack_sampled_wedges(inst, seed: int, samples: int = 32) -> list[int]:
+    rng = random.Random(seed)
+    output = []
+    for graph in inst["graphs"]:
+        steps = graph["steps"]
+        q = int(graph["q"])
+        membership = set(steps)
+        hits = 0
+        for _ in range(samples):
+            first = steps[rng.randrange(len(steps))]
+            second = steps[rng.randrange(len(steps))]
+            hits += (second - first) % q in membership
+        estimated_ordered = (hits * len(steps) ** 2 + samples // 2) // samples
+        output.append(q * estimated_ordered // 6)
+    return output
 
 
