+    corruptions = {
+        "drop_one": answer[:-1],
+        "collapse_endpoint": [[answer[0][0], answer[0][0]]] + answer[1:],
+        "duplicate_edge": [answer[0], answer[0]] + answer[2:],
+        "empty": [],
+        "out_of_range": [[0, shipping["n"]]] + answer[1:],
