+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > _ENUMERATION_CAP:
+        return None
+    count = 0
+    edges = _graph(inst)["edges"]
+    for selection in itertools.combinations(edges, inst["k"]):
+        if verify(inst, [list(edge) for edge in selection])[0]:
+            count += 1
+    return count
