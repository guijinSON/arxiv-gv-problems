import random,math,time

def gen(n=240,k=16,seed=0,L=9):
 r=random.Random(seed); pts=[]; ans=[]
 # anchors distributed jittered grid to ensure spread
 q=math.ceil(math.sqrt(k)); mids=[]
 for z in range(k):
  i=z%q;j=z//q
  x=(i+0.5)*L/q+r.uniform(-.35,.35);y=(j+.5)*L/q+r.uniform(-.35,.35)
  ang=r.random()*2*math.pi; d=r.uniform(.25,.9)
  a=len(pts);pts.append((x-d/2*math.cos(ang),y-d/2*math.sin(ang)))
  b=len(pts);pts.append((x+d/2*math.cos(ang),y+d/2*math.sin(ang)));ans.append((a,b));mids.append((x,y))
 while len(pts)<n:
  x=r.uniform(0,L);y=r.uniform(0,L)
  if any((x-pts[a][0])**2+(y-pts[a][1])**2<=1 or (x-pts[b][0])**2+(y-pts[b][1])**2<=1 for a,b in ans):pts.append((x,y))
 perm=list(range(n));r.shuffle(perm);new=[None]*n
 for old,p in enumerate(perm):new[p]=pts[old]
 ans=[tuple(sorted((perm[a],perm[b]))) for a,b in ans]
 return new,ans

def graph(pts):
 n=len(pts);adj=[0]*n;edges=[]
 for i in range(n):
  xi,yi=pts[i]
  for j in range(i):
   x,y=pts[j]
   if (x-xi)**2+(y-yi)**2<=1+1e-12:
    adj[i]|=1<<j;adj[j]|=1<<i;edges.append((j,i))
 cov=[]; ALL=(1<<n)-1
 for a,b in edges: cov.append((1<<a)|(1<<b)|adj[a]|adj[b])
 return adj,edges,cov

def greedy(pts,k):
 a,e,c=graph(pts);U=(1<<len(pts))-1;sol=[]
 for _ in range(k):
  j=max(range(len(e)),key=lambda q:(c[q]&U).bit_count())
  sol.append(j);U&=~c[j]
  if not U:return True,len(sol)
 return False,len(sol)
for L in (7,8,9,10,11):
 out=[]
 for s in range(20):
  p,a=gen(L=L,seed=s); ok,t=greedy(p,16);out.append((ok,t))
 print(L,sum(x for x,t in out),out)
