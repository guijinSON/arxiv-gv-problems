+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An unordered JSON list of exactly k distinct undirected graph edges; "
+        "each edge is a two-element increasing list [u,v] with 0 <= u < v < n."
+    ),
+    "bounds": {
