+                                       graph["edges"][i]))
+        if not ranked:
+            break
+        width = min(rcl, len(ranked))
+        index = ranked[0] if rng is None else ranked[rng.randrange(width)]
+        chosen.append(index)
+        available.remove(index)
+        uncovered &= ~graph["covers"][index]
+        if not uncovered:
