+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "doubled_build_and_verify_wall_sec": round(time.perf_counter() - t0, 6),
+        "doubled_planted_verifies": doubled_ok,
+    }
+
+    invariant_checks = 0
+    carried_checks = 0
+    unrelated_keys = []
