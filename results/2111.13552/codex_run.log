+
+def _attack_maximal_matching(inst):
+    """Run Section 4's maximal-matching EVDS, then its obvious k-edge trim."""
+    graph = _graph(inst)
+    order = sorted(range(len(graph["edges"])),
+                   key=lambda i: (-graph["covers"][i].bit_count(), graph["edges"][i]))
+    used_vertices = set()
+    matching = []
+    for i in order:
+        u, v = graph["edges"][i]
