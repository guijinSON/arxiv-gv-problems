    if n < 2 * k + 1:
        raise ValueError("n must be at least 2*k+1")
    if not 1500 <= pitch <= 2400:
        raise ValueError("pitch must lie in 1500..2400")


def _sqdist(p, q):
    dx = p[0] - q[0]
    dy = p[1] - q[1]
    return dx * dx + dy * dy


