+def _attack_short_edges(inst):
+    graph = _graph(inst)
+    points = inst["points"]
+    order = sorted(range(len(graph["edges"])),
+                   key=lambda i: (_sqdist(points[graph["edges"][i][0]],
+                                          points[graph["edges"][i][1]]),
+                                  graph["edges"][i]))
+    return verify(inst, _ids_to_answer(graph, order, inst["k"]))[0]
+
