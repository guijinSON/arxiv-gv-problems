+    body = match.group(1).strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.IGNORECASE)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        answer = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(answer, list):
+        return None
+    return answer
