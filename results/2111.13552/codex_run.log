+
+STRUCTURAL_HINT = (
+    "Extreme uncovered points constrain the useful edges through overlapping "
+    "unit-radius lens neighborhoods."
+)
+PLACEBO_HINT = (
+    "Careful bookkeeping of vertex labels and squared distances is useful in "
+    "this instance."
+)
