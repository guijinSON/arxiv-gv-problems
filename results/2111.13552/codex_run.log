+        if 250 * 250 <= d2 <= 900 * 900:
+            return dx, dy
+
+
+def _apply_isometry(points, code, tx, ty):
+    out = []
+    for x, y in points:
+        if code == 0:
+            a, b = x, y
+        elif code == 1:
+            a, b = -x, y
+        elif code == 2:
+            a, b = x, -y
+        elif code == 3:
+            a, b = -x, -y
+        elif code == 4:
+            a, b = y, x
+        elif code == 5:
+            a, b = -y, x
+        elif code == 6:
+            a, b = y, -x
+        else:
+            a, b = -y, -x
+        out.append([a + tx, b + ty])
+    return out
