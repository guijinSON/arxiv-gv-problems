+def _ids_to_answer(graph, ids, k):
+    chosen = []
+    seen = set()
+    for index in ids:
+        if index not in seen:
+            seen.add(index)
+            chosen.append(index)
+    if len(chosen) > k:
+        chosen = chosen[:k]
+    if len(chosen) < k:
+        for index in range(len(graph["edges"])):
+            if index not in seen:
+                chosen.append(index)
+                seen.add(index)
+                if len(chosen) == k:
+                    break
