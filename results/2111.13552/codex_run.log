+        "family": "exact edge-vertex domination in a rational unit disk graph",
+        "n": n,
+        "k": k,
+        "scale": _SCALE,
+        "pitch": pitch,
+        "points": points,
+        "answer": [list(edge) for edge in sorted(planted)],
