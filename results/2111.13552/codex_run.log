+        "distinct_reasons": len(set(reasons)),
+    }
+
+    model_text = ("I checked the closed neighborhoods.\n```json\n<answer>"
+                  + json.dumps(answer) + "</answer>\n```\nThat is my final set.")
+    parsed = parse_answer(model_text)
+    report["G3_round_trip"] = {
