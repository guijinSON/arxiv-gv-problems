+def _attack_random_restart(inst, seed, restarts=64):
+    graph = _graph(inst)
+    rng = random.Random(seed ^ 0x9E3779B9)
+    for _ in range(restarts):
+        ids = _greedy_ids(inst, rng, rcl=12)
+        if verify(inst, _ids_to_answer(graph, ids, inst["k"]))[0]:
