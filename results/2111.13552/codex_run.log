+        elif code == 1:
+            a, b = -x, y
+        elif code == 2:
+            a, b = x, -y
+        elif code == 3:
+            a, b = -x, -y
+        elif code == 4:
+            a, b = y, x
+        elif code == 5:
+            a, b = -y, x
+        elif code == 6:
