+            _relabel_instance(base, permutation),
+            _coordinate_variant(base, 1, 12_345, -7_654),
+            _coordinate_variant(_relabel_instance(base, permutation),
+                                6, -33_333, 22_222),
+            _coordinate_variant(base, 4, 999, 111),
