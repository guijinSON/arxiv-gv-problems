+        "each edge is a two-element increasing list [u,v] with 0 <= u < v < n."
+    ),
+    "bounds": {
+        "edge_count": "exactly the displayed k",
+        "endpoints": "integer vertex labels 0..n-1",
+        "edge_order": "u < v",
+        "distinct": True,
+        "outer_order": "irrelevant",
