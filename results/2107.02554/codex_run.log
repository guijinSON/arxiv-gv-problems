+def make_instance(n, seed=0, **params):
+    """Inverse-generate a unique exact-weight k-clique.
+
+    The answer is sampled before weights or target.  No search is performed.
+    Vertex potentials are offset + scale*(-2)^e for a random assignment of the
+    exponents e=0,...,n-1, and edge {u,v} has weight potential[u]+potential[v].
+    Distinct 0/1 sums of powers of -2 are distinct, so the target has exactly one
+    k-subset witness.
+    """
+    if isinstance(n, bool) or not isinstance(n, int) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    k = params.pop("k", 8)
+    scale_bits = params.pop("scale_bits", 24)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(k, bool) or not isinstance(k, int) or not 2 <= k <= min(n, 8):
+        raise ValueError("k must be an integer with 2 <= k <= min(n,8)")
+    if (
+        isinstance(scale_bits, bool)
+        or not isinstance(scale_bits, int)
+        or scale_bits < 2
+    ):
+        raise ValueError("scale_bits must be an integer at least 2")
+
+    rng = random.Random(seed)
+
+    # G: sample the certificate first, uniformly from the bounded language.
+    answer = sorted(rng.sample(range(n), k))
+
+    exponents = list(range(n))
+    rng.shuffle(exponents)
+    scale = rng.randrange(1 << (scale_bits - 1), 1 << scale_bits)
+    # Offset is public auxiliary information.  The random tail prevents a fixed
+    # low-digit signature, while 2^(n+1)*scale keeps every potential positive.
+    offset = scale * (1 << (n + 1)) + rng.randrange(scale)
+    potentials = [offset + scale * ((-2) ** e) for e in exponents]
+    weights = [[0] * n for _ in range(n)]
+    for u in range(n):
+        for v in range(u + 1, n):
+            value = potentials[u] + potentials[v]
+            if value < 0:
+                raise AssertionError("construction produced a negative edge weight")
+            weights[u][v] = weights[v][u] = value
+
+    target = (k - 1) * sum(potentials[v] for v in answer)
+    return {
+        "family": "fixed-cardinality Exact-Edge-Weight Clique",
+        "n": n,
+        "k": k,
+        "weights": weights,
+        "target": target,
+        "normalization": {"offset": offset, "scale": scale},
+        "answer": answer,
+    }
+
+
+def render(inst):
+    """Render a complete, self-contained problem with an exact output contract."""
+    n, k = inst["n"], inst["k"]
+    edge_lines = []
+    for u in range(n):
+        for v in range(u + 1, n):
+            edge_lines.append(f"{u} {v} {inst['weights'][u][v]}")
+    edges = "\n".join(edge_lines)
+    offset = inst["normalization"]["offset"]
+    scale = inst["normalization"]["scale"]
+    example = list(range(k))
+    statement = f"""Find an exact-edge-weight clique of prescribed cardinality.
+
+The graph is undirected, simple, and complete on vertices 0 through {n - 1}.
+For a vertex set S, its total edge weight means the sum of w(u,v) over every
+unordered pair of distinct vertices u,v in S.  Find a set S of exactly k={k}
+vertices whose total edge weight is exactly the target
+
+  t = {inst['target']}.
+
+All weights and calculations are ordinary integers, not residues.  Each edge is
+listed once below as "u v weight" with u<v; all endpoints are zero-indexed.
+
+The instance also supplies two exact normalization constants that may or may not
+be useful: offset={offset} and scale={scale}.
+
+Edges ({n * (n - 1) // 2} total):
+{edges}
+
+Return the k vertex indices as a strictly increasing JSON list.  Repetitions are
+forbidden, order is otherwise immaterial but the required serialization is
+increasing, and every index must lie in the inclusive range 0 through {n - 1}.
+
+Give your final answer inside <answer></answer> tags, as that JSON list.
+Example: <answer>{json.dumps(example, separators=(',', ':'))}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Extract the last tagged JSON list, tolerating prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\s*>(.*?)</answer\s*>", text, re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list):
+        return None
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in value):
+        return None
+    return value
+
+
+def verify(inst, answer):
+    """Verify any valid clique exactly, never consulting inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    k, n = inst["k"], inst["n"]
+    if len(answer) != k:
+        return False, f"wrong cardinality: expected {k}, got {len(answer)}"
+    for pos, vertex in enumerate(answer):
+        if isinstance(vertex, bool) or not isinstance(vertex, int):
+            return False, f"entry {pos + 1} is not an integer"
+        if not 0 <= vertex < n:
+            return False, f"vertex {vertex} is outside the inclusive range 0..{n - 1}"
+    if len(set(answer)) != len(answer):
+        return False, "vertex indices are not distinct"
+    if any(answer[i] >= answer[i + 1] for i in range(len(answer) - 1)):
+        return False, "vertex indices are not strictly increasing"
+
+    total = 0
+    for i, u in enumerate(answer):
+        for v in answer[i + 1 :]:
+            weight = inst["weights"][u][v]
+            if weight is None:
+                return False, f"vertices {u} and {v} are not adjacent"
+            total += weight
+    if total != inst["target"]:
+        return False, f"induced-edge sum is {total}, not target {inst['target']}"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the exact k-subsets a statement-aware solver searches."""
+    return sorted(rng.sample(range(inst["n"]), inst["k"]))
+
+
+def search_space(inst):
+    return math.comb(inst["n"], inst["k"])
+
+
+def enumerate_all(inst):
+    """Count witnesses exactly when at most 200,000 candidates are required."""
+    if search_space(inst) > 200_000:
+        return None
+    return sum(
+        verify(inst, list(candidate))[0]
+        for candidate in itertools.combinations(range(inst["n"]), inst["k"])
+    )
+
+
+def _recover_potentials(inst):
+    """Recover a_i from w_ij=a_i+a_j using three anchor edges."""
+    weights = inst["weights"]
+    a0_twice = weights[0][1] + weights[0][2] - weights[1][2]
+    if a0_twice % 2:
+        raise ValueError("edge weights do not have integral additive potentials")
+    a0 = a0_twice // 2
+    return [a0] + [weights[0][v] - a0 for v in range(1, inst["n"])]
+
+
+def canonical_key(inst):
+    """Canonicalize the additive weighted graph under every vertex relabelling."""
+    payload = {
+        "k": inst["k"],
+        "target": inst["target"],
+        "potentials": sorted(_recover_potentials(inst)),
+    }
+    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def escalate(params):
+    """The hard rung already reaches the 300-operation compact-route cap."""
+    n = params.get("n")
+    if n is None or n >= DIFFICULTY["hard"]["n"]:
+        return None
+    return {
+        "n": min(DIFFICULTY["hard"]["n"], n + 8),
+        "k": params.get("k", 8),
+        "scale_bits": params.get("scale_bits", 24) + 3,
+    }
+
+
+def _target_potential_sum(inst):
+    k = inst["k"]
+    if inst["target"] % (k - 1):
+        raise ValueError("target is incompatible with additive edge weights")
+    return inst["target"] // (k - 1)
+
+
+def _reference_mitm(inst):
+    """Meet-in-the-middle k-sum; return (answer, combination records touched)."""
+    potentials = _recover_potentials(inst)
+    n, k = inst["n"], inst["k"]
+    left_size = k // 2
+    right_size = k - left_size
+    target = _target_potential_sum(inst)
+    sums = {}
+    operations = 0
+    for combo in itertools.combinations(range(n), left_size):
+        subtotal = sum(potentials[i] for i in combo)
+        mask = sum(1 << i for i in combo)
+        sums[subtotal] = mask
+        operations += 1
+    for combo in itertools.combinations(range(n), right_size):
+        subtotal = sum(potentials[i] for i in combo)
+        operations += 1
+        mask = sums.get(target - subtotal)
+        if mask is None or any(mask & (1 << i) for i in combo):
+            continue
+        answer = [i for i in range(n) if mask & (1 << i)] + list(combo)
+        answer.sort()
+        if verify(inst, answer)[0]:
+            return answer, operations
+    return None, operations
+
+
+def _attack_outlier_largest(inst, _rng):
+    potentials = _recover_potentials(inst)
+    choice = sorted(range(inst["n"]), key=lambda i: potentials[i], reverse=True)
+    answer = sorted(choice[: inst["k"]])
+    return answer, inst["n"]
+
+
+def _attack_greedy_residual(inst, _rng):
+    potentials = _recover_potentials(inst)
+    remaining = set(range(inst["n"]))
+    residual = _target_potential_sum(inst)
+    chosen = []
+    operations = 0
+    for slots in range(inst["k"], 0, -1):
+        # The obvious target-average heuristic, with deterministic tie breaking.
+        vertex = min(
+            remaining,
+            key=lambda i: (abs(potentials[i] * slots - residual), i),
+        )
+        operations += len(remaining)
+        chosen.append(vertex)
+        remaining.remove(vertex)
+        residual -= potentials[vertex]
+    return sorted(chosen), operations
+
+
+def _attack_random_restart(inst, rng):
+    for attempt in range(512):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate, attempt + 1
+    return None, 512
+
+
+def _attack_local_swap(inst, _rng):
+    """Single-swap descent from vertices closest to the target average."""
+    potentials = _recover_potentials(inst)
+    target = _target_potential_sum(inst)
+    k = inst["k"]
+    order = sorted(
+        range(inst["n"]),
+        key=lambda i: (abs(potentials[i] * k - target), i),
+    )
+    chosen = set(order[:k])
+    current = sum(potentials[i] for i in chosen)
+    operations = inst["n"]
+    for _ in range(32):
+        best = None
+        best_error = abs(current - target)
+        for old in sorted(chosen):
+            for new in range(inst["n"]):
+                if new in chosen:
+                    continue
+                trial = current - potentials[old] + potentials[new]
+                error = abs(trial - target)
+                operations += 1
+                if error < best_error:
+                    best_error = error
+                    best = (old, new, trial)
+        if best is None:
+            break
+        old, new, current = best
+        chosen.remove(old)
+        chosen.add(new)
+    answer = sorted(chosen)
+    return answer, operations
+
+
+def _relabel(inst, permutation):
+    """Carry an instance and its witness through old_vertex -> new_vertex."""
+    n = inst["n"]
+    if sorted(permutation) != list(range(n)):
+        raise ValueError("permutation is not a relabelling")
+    weights = [[0] * n for _ in range(n)]
+    for old_u in range(n):
+        for old_v in range(old_u + 1, n):
+            u, v = permutation[old_u], permutation[old_v]
+            weights[u][v] = weights[v][u] = inst["weights"][old_u][old_v]
+    return {
+        **inst,
+        "weights": weights,
+        "answer": sorted(permutation[v] for v in inst["answer"]),
+    }
+
+
+def _answer_metrics(answer):
+    wire = json.dumps(answer, separators=(",", ":"))
+    # Punctuation and each decimal integer are conservative token-like atoms.
+    tokens = len(re.findall(r"\d+|[\[\],-]", wire))
+    return len(wire), tokens, len(answer)
+
+
+def selftest():
+    """Run all local gates and return their machine-readable measurements."""
+    report = {
+        "paper": "2107.02554",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    # G1: every preset, multiple unrelated seeds, plus JSON-native certificates.
+    g1_checks = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17, 2027):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_checks += 1
+            if not ok:
+                g1_failures.append(f"{preset}/{seed}: {why}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append(f"{preset}/{seed}: answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "checks": g1_checks,
+        "failures": g1_failures,
+    }
+
+    # G2: each requested corruption reaches a different rejecting branch.
+    ship = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = ship["answer"]
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_two": [planted[1], planted[0]] + planted[2:],
+        "duplicate": planted[:-1] + [planted[0]],
+        "empty": [],
+        "out_of_range": planted[:-1] + [ship["n"]],
+    }
+    reasons = {}
+    accepted = []
+    for name, candidate in corruptions.items():
+        ok, why = verify(ship, candidate)
+        reasons[name] = why
+        if ok:
+            accepted.append(name)
+    report["G2_rejects_corruption"] = {
+        "pass": not accepted and len(set(reasons.values())) == len(reasons),
+        "accepted": accepted,
+        "distinct_reasons": len(set(reasons.values())),
+        "reasons": reasons,
+    }
+
+    # G3: tagged JSON survives ordinary model prose and a fenced block.
+    realistic = (
+        "I used the induced-edge sum.\n<answer>\n```json\n"
+        + json.dumps(planted)
+        + "\n```\n</answer>\nThe list is zero-indexed."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("garbage") is None,
+        "parsed_matches": parsed == planted,
+        "garbage_returns_none": parse_answer("garbage") is None,
+    }
+
+    # G4: uniform k-subsets already enforce every obvious output constraint.
+    guess_total = 200_000
+    guess_hits = 0
+    guess_rng = random.Random(0x210702554)
+    for _ in range(guess_total):
+        guess_hits += int(verify(ship, random_candidate(ship, guess_rng))[0])
+    guess_fraction = guess_hits / guess_total
+    exact_guess_probability = 1.0 / search_space(ship)
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6 and exact_guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "sampled_fraction": guess_fraction,
+        "exact_probability_from_uniqueness": exact_guess_probability,
+        "candidate_space": search_space(ship),
+        "prior": "uniform over strictly increasing k-subsets",
+    }
+
+    # G5/G6 share eight fixed shipping seeds and the measured reference solve.
+    attack_functions = {
+        "outlier_largest_incident_mean": _attack_outlier_largest,
+        "greedy_target_average": _attack_greedy_residual,
+        "random_restart_512": _attack_random_restart,
+        "single_swap_target_average": _attack_local_swap,
+    }
+    attack_results = {
+        name: {"successes": 0, "attempts": 8, "operations": 0, "wall_clock_sec": 0.0}
+        for name in attack_functions
+    }
+    ref_successes = 0
+    ref_operations = 0
+    ref_wall = 0.0
+    panel_seeds = (101, 211, 307, 401, 503, 601, 701, 809)
+    for seed in panel_seeds:
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        for index, (name, attack) in enumerate(attack_functions.items()):
+            rng = random.Random(seed * 1009 + index)
+            started = time.perf_counter()
+            candidate, operations = attack(inst, rng)
+            elapsed = time.perf_counter() - started
+            success = candidate is not None and verify(inst, candidate)[0]
+            attack_results[name]["successes"] += int(success)
+            attack_results[name]["operations"] += operations
+            attack_results[name]["wall_clock_sec"] += elapsed
+        started = time.perf_counter()
+        candidate, operations = _reference_mitm(inst)
+        ref_wall += time.perf_counter() - started
+        ref_operations += operations
+        ref_successes += int(candidate is not None and verify(inst, candidate)[0])
+    for result in attack_results.values():
+        result["wall_clock_sec"] = round(result["wall_clock_sec"], 6)
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": (
+            demo_count == 1
+            and guess_fraction < 1e-6
+            and ref_successes == len(panel_seeds)
+            and ref_operations > 0
+            and ref_wall > 0
+        ),
+        "shipping_sampled_valid_count": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_sampled_density": guess_fraction,
+        "shipping_exact_solution_count_by_signed_radix_uniqueness": 1,
+        "shipping_candidate_count": search_space(ship),
+        "demo_exact_solution_count": demo_count,
+        "reference_wall_clock_sec": round(ref_wall, 6),
+        "reference_combination_records": ref_operations,
+        "reference_attempts": len(panel_seeds),
+    }
+    all_attacks_failed = all(v["successes"] == 0 for v in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and ref_successes == len(panel_seeds),
+        "attacks": attack_results,
+        "reference_algorithm": {
+            "name": "additive-potential recovery plus meet-in-the-middle fixed-k sum",
+            "complexity": "O(n^(ceil(k/2))) time and O(n^(floor(k/2))) space; k<=8",
+            "wall_clock_sec": round(ref_wall, 6),
+            "operations": ref_operations,
+            "solves": f"{ref_successes}/{len(panel_seeds)}, as expected",
+        },
+    }
+
+    # G7: n really controls work and a doubled shipping instance remains valid.
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=424242, **doubled_params)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    spaces = [search_space(make_instance(seed=9, **params)) for params in DIFFICULTY.values()]
+    report["G7_scales"] = {
+        "pass": doubled_ok and spaces == sorted(spaces) and len(set(spaces)) == len(spaces),
+        "candidate_spaces": dict(zip(DIFFICULTY, spaces)),
+        "doubled_n": doubled["n"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_why,
+    }
+
+    # G8: arbitrary vertex relabellings and their compositions, then diversity.
+    invariant_checks = 0
+    carried_witness_checks = 0
+    invariant_failures = []
+    distinct_keys = []
+    base_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    for seed in range(20):
+        inst = make_instance(seed=10_000 + seed, **base_params)
+        distinct_keys.append(canonical_key(inst))
+        rr = random.Random(90_000 + seed)
+        p = list(range(inst["n"]))
+        q = list(range(inst["n"]))
+        rr.shuffle(p)
+        rr.shuffle(q)
+        composed = [q[p[v]] for v in range(inst["n"])]
+        for permutation in (p, q, composed):
+            moved = _relabel(inst, permutation)
+            invariant_checks += 1
+            if canonical_key(moved) != canonical_key(inst):
+                invariant_failures.append(seed)
+            carried_witness_checks += 1
+            if not verify(moved, moved["answer"])[0]:
+                invariant_failures.append(f"witness/{seed}")
+    distinct_count = len(set(distinct_keys))
+    report["G8_canonical_key"] = {
+        "pass": not invariant_failures and distinct_count == 20,
+        "invariance_checks": invariant_checks,
+        "carried_witness_checks": carried_witness_checks,
+        "invariance_failures": invariant_failures,
+        "unrelated_instances": 20,
+        "distinct_keys": distinct_count,
+        "canonicalization": "sorted recovered vertex potentials plus k and target",
+    }
+
+    # G9(a,b) comes only from script-owned transcripts; (c) is local and exact.
+    chars, tokens, elements = _answer_metrics(ship["answer"])
+    intended_operations = 5 * ship["n"] + 10
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = (
+        placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    )
+    within_caps = chars <= 2000 and elements <= 256 and intended_operations <= 300
+    hinted_hardened = G9_ORACLE_RESULTS["hinted_verdict"] == "hardened"
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_hardened and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": chars,
+        "answer_tokens": tokens,
+        "answer_elements": elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+    }
+
+    gates = [v for key, v in report.items() if key.startswith("G")]
+    report["all_passed"] = all(gate.get("pass") is True for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

codex
The third vendor solved `medium`, so that rung is also rejected (1/3 solved). The harness has escalated to the predefined `hard` rung at 56 vertices—the largest setting whose compact route remains under the 300-operation cap. If any vendor solves this rung, the family must be rejected rather than enlarged by hand.
