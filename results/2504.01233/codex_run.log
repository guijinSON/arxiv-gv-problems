+def _affine_rank(values):
+    if not values:
+        return 0
+    basis = {}
+    for value in (v ^ values[0] for v in values[1:]):
+        while value:
+            bit = value.bit_length() - 1
+            if bit in basis:
+                value ^= basis[bit]
+            else:
+                basis[bit] = value
+                break
+    return len(basis)
 
 
