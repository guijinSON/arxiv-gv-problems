+"""Verified generator for the exceptional Hamming K4 from arXiv:2504.01233.
+
+The paper's Section 3 separates the two isometry types of distance-six K4s in
+the 10-cube: the first type has XOR zero.  This module scales that native
+search object to even-dimensional Boolean cubes.  It plants one XOR-zero,
+equidistant quartet and carries the witness through random cube coordinates.
+"""
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "vertices of a Boolean cube",
+        "Hamming distance graph",
+        "exceptional equidistant four-vertex configuration",
+    ],
+    "verification_operations": [
+        "bitwise XOR",
+        "exact population count",
+        "integer index comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The XOR invariant distinguishing the paper's two K4 isometry types, "
+        "combined with a whole-instance checksum, exposes one anchor vertex; "
+        "without it one must compare quadratically many vertex pairs."
+    ),
+    "hardness_basis": (
+        "Track B: Section 3 identifies the XOR-zero K4 type; the reference "
+        "pair-XOR collision algorithm is O(N^2) dictionary operations (measured "
+        "at the shipping preset in selftest_report.json), whereas the checksum "
+        "route uses at most 288 exact word operations after the invariant is seen."
+    ),
+    "max_answer_tokens": 5,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A strictly increasing JSON array of four distinct 0-based indices "
+        "chosen from one vertex-parity class (forced because the required "
+        "Hamming distance is even)."
+    ),
+    "bounds": {"indices": 4, "minimum": 0, "maximum": "N-1"},
+}
+
+DIFFICULTY = {
+    "demo": {"n": 12, "bits": 16, "distance": 8, "max_anchor_degree": 8},
+    "easy": {"n": 140, "bits": 300, "distance": 180, "max_anchor_degree": 3},
+    "medium": {"n": 144, "bits": 400, "distance": 240, "max_anchor_degree": 3},
+    "hard": {"n": 148, "bits": 500, "distance": 300, "max_anchor_degree": 3},
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The whole-list XOR checksum is tied to the same four-vertex XOR invariant "
+    "that distinguishes the two quartet types."
+)
+PLACEBO_HINT = (
+    "The fixed-width hexadecimal encoding is useful for keeping the many "
+    "exact vertex comparisons carefully organized."
+)
+
+NOTES = (
+    "Section 2 fixes G(V;k): cube vertices are adjacent exactly at Hamming "
+    "distance k. Section 3 states that its first K4 type has XOR of its four "
+    "vertices equal to zero, while the second type does not. The paper's "
+    "colorability checks use kissat with a one-second cutoff and its outer "
+    "configuration enumeration took about 14 days, so this is Track B rather "
+    "than an unsupported Track A distributional-hardness claim. Generation "
+    "takes direct products of the paper's displayed K4 types and applies random "
+    "cube isometries. Every decoy is the second type and the plant is the first, "
+    "so their individual marginals and all six internal distances agree. The "
+    "decoy XORs set the plant translation, making XOR(all vertices) a planted "
+    "anchor. Pair-XOR uniqueness removes accidental certificates without finding "
+    "the planted answer. Degree, greedy-clique, random-restart, and bounded "
+    "lexicographic pair-XOR attacks are rejected during construction."
+)
+
+
+def _popcount(x):
+    return x.bit_count()
+
+
+def _mask_from_positions(positions):
+    value = 0
+    for position in positions:
+        value |= 1 << position
+    return value
+
+
+def _values(inst):
+    return [int(text, 16) for text in inst["vertices"]]
+
+
+def _structural_ok(values, planted_positions):
+    """True iff pair-XOR collisions encode only the planted four-set.
+
+    Four distinct values XOR to zero exactly when two disjoint pairs have the
+    same XOR.  The planted quartet necessarily creates three such collisions.
+    Forbidding every other collision proves uniqueness without searching for a
+    witness: the witness positions are already known.
+    """
+    planted = frozenset(planted_positions)
+    seen = {}
+    collision_keys = set()
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            key = values[i] ^ values[j]
+            pair = (i, j)
+            if key in seen:
+                old = seen[key]
+                if ({old[0], old[1]} & {i, j}) or frozenset(old + pair) != planted:
+                    return False
+                if key in collision_keys:
+                    return False
+                collision_keys.add(key)
+            else:
+                seen[key] = pair
+    return len(collision_keys) == 3
+
+
+def _degree_list(values, distance):
+    degrees = [0] * len(values)
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            if _popcount(values[i] ^ values[j]) == distance:
+                degrees[i] += 1
+                degrees[j] += 1
+    return degrees
+
+
+def _candidate_valid_values(values, distance, candidate):
+    if candidate is None or len(candidate) != 4 or len(set(candidate)) != 4:
+        return False
+    selected = [values[i] for i in candidate]
+    if selected[0] ^ selected[1] ^ selected[2] ^ selected[3]:
+        return False
+    return all(
+        _popcount(selected[a] ^ selected[b]) == distance
+        for a in range(4) for b in range(a + 1, 4)
+    )
+
+
+def _attack_outlier_degree(inst):
+    values = _values(inst)
+    degrees = _degree_list(values, inst["distance"])
+    mean = sum(degrees) / len(degrees)
+    picked = sorted(
+        sorted(range(len(values)), key=lambda i: (-abs(degrees[i] - mean), i))[:4]
+    )
+    return picked if _candidate_valid_values(values, inst["distance"], picked) else None
+
+
+def _attack_greedy_clique(inst):
+    values = _values(inst)
+    distance = inst["distance"]
+    degrees = _degree_list(values, distance)
+    order = sorted(range(len(values)), key=lambda i: (-degrees[i], i))
+    for start in order[: min(16, len(order))]:
+        clique = [start]
+        for vertex in order:
+            if vertex not in clique and all(
+                _popcount(values[vertex] ^ values[u]) == distance for u in clique
+            ):
+                clique.append(vertex)
+                if len(clique) == 4:
+                    candidate = sorted(clique)
+                    if _candidate_valid_values(values, distance, candidate):
+                        return candidate
+                    break
+    return None
+
+
+def _attack_random_restart(inst, trials=256):
+    values = _values(inst)
+    # Stable instance-derived seed; never the generator's seed or planted answer.
+    attack_seed = (values[0] ^ values[-1] ^ len(values) ^ inst["bits"]) & ((1 << 64) - 1)
+    rng = random.Random(attack_seed)
+    for _ in range(trials):
+        candidate = sorted(rng.sample(range(len(values)), 4))
+        if _candidate_valid_values(values, inst["distance"], candidate):
+            return candidate
+    return None
+
+
+def _attack_bounded_pair_xor(inst, budget=256):
+    values = _values(inst)
+    seen = {}
+    inspected = 0
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            if inspected >= budget:
+                return None
+            inspected += 1
+            key = values[i] ^ values[j]
+            if key in seen:
+                a, b = seen[key]
+                candidate = sorted({a, b, i, j})
+                if len(candidate) == 4 and _candidate_valid_values(
+                    values, inst["distance"], candidate
+                ):
+                    return candidate
+            else:
+                seen[key] = (i, j)
+    return None
+
+
+def _cheap_attacks_fail(inst):
+    return all(
+        attack(inst) is None
+        for attack in (
+            _attack_outlier_degree,
+            _attack_greedy_clique,
+            _attack_random_restart,
+            _attack_bounded_pair_xor,
+        )
+    )
+
+
+def make_instance(n, seed=0, **params):
+    """Transform and compose the two displayed K4 types from Section 3.
+
+    The planted first-type quartet is known before the instance is assembled.
+    Every other four-vertex block is a transformed second-type quartet.  No
+    search for a quartet obtains the answer.  Rejection only enforces uniqueness,
+    checksum route size, and failure of the declared cheap attacks.
+    """
+    bits = int(params.get("bits", 96))
+    distance = int(params.get("distance", bits // 2))
+    max_anchor_degree = int(params.get("max_anchor_degree", 10))
+    n = int(n)
+    if n < 8 or n % 4:
+        raise ValueError("n must be a multiple of four and at least 8")
+    if bits == 16:
+        # A tiny hand-scale analogue used only by the demo rung.
+        base_first = [0x0000, 0xFF00, 0xF0F0, 0x0FF0]
+        base_second = [0x0000, 0xFF00, 0xF0F0, 0x6996]
+        if distance != 8:
+            raise ValueError("the 16-bit demo construction requires distance 8")
+    else:
+        if bits < 10 or bits % 10 or distance != 6 * (bits // 10):
+            raise ValueError(
+                "the paper-derived construction requires bits=10m and distance=6m"
+            )
+        first10 = [
+            int("0000000000", 2),
+            int("1111110000", 2),
+            int("1110001110", 2),
+            int("0001111110", 2),
+        ]
+        second10 = [
+            int("0000000000", 2),
+            int("1111110000", 2),
+            int("1110001110", 2),
+            int("0101011011", 2),
+        ]
+        base_first = []
+        base_second = []
+        for source, target in ((first10, base_first), (second10, base_second)):
+            for word in source:
+                repeated = 0
+                for block in range(bits // 10):
+                    repeated |= word << (10 * block)
+                target.append(repeated)
+    if max_anchor_degree < 3:
+        raise ValueError("max_anchor_degree must be at least 3")
+
+    rng = random.Random(seed)
+    width = (bits + 3) // 4
+    full_mask = (1 << bits) - 1
+
+    for _attempt in range(20000):
+        decoy_quartets = []
+        decoy_xor = 0
+        quartet_count = n // 4
+        # Since every internal distance is even, a solver gets vertex parity for
+        # free.  Balance the two parity classes so that this deduction does not
+        # reveal the planted (even-parity) quartet or inflate G4's haystack.
+        even_decoys = (quartet_count + 1) // 2 - 1
+        decoy_parities = [0] * even_decoys + [1] * (
+            quartet_count - 1 - even_decoys
+        )
+        rng.shuffle(decoy_parities)
+        for wanted_parity in decoy_parities:
+            permutation = list(range(bits))
+            rng.shuffle(permutation)
+            translation = rng.getrandbits(bits) & full_mask
+            if (_popcount(translation) & 1) != wanted_parity:
+                translation ^= 1
+            quartet = [
+                _permute_coordinates(word, permutation) ^ translation
+                for word in base_second
+            ]
+            decoy_quartets.append(quartet)
+            for value in quartet:
+                decoy_xor ^= value
+
+        plant_permutation = list(range(bits))
+        rng.shuffle(plant_permutation)
+        anchor = decoy_xor
+        planted_values = [
+            _permute_coordinates(word, plant_permutation) ^ anchor
+            for word in base_first
+        ]
+        values = planted_values + [
+            value for quartet in decoy_quartets for value in quartet
+        ]
+        if len(set(values)) != len(values):
+            continue
+        anchor_degree = sum(
+            _popcount(anchor ^ value) == distance for value in values[1:]
+        )
+        if anchor_degree > max_anchor_degree:
+            continue
+        if not _structural_ok(values, range(4)):
+            continue
+
+        order = list(range(n))
+        rng.shuffle(order)
+        shuffled = [values[i] for i in order]
+        inverse = {old: new for new, old in enumerate(order)}
+        answer = sorted(inverse[i] for i in range(4))
+        inst = {
+            "bits": bits,
+            "distance": distance,
+            "vertices": [format(value, "0{}X".format(width)) for value in shuffled],
+            "answer": answer,
+        }
+        # The demo is deliberately hand-solvable, so adversarial filtering is
+        # applied only at benchmark-sized levels.
+        if n < DIFFICULTY["easy"]["n"] or _cheap_attacks_fail(inst):
+            return inst
+    raise RuntimeError("could not construct a filtered planted instance")
+
+
+def render(inst):
+    lines = [
+        "Exceptional equidistant quartet in a Boolean cube",
+        "",
+        "Each displayed fixed-width hexadecimal word encodes one vertex of the",
+        "{}-dimensional Boolean cube {{0,1}}^{}; leading zeroes are significant.".format(
+            inst["bits"], inst["bits"]
+        ),
+        "The Hamming distance between two vertices is the number of bit positions",
+        "where they differ, equivalently popcount(x XOR y).",
+        "",
+        "Find four distinct listed vertices such that:",
+        "1. every one of their six pairwise Hamming distances is exactly {}, and".format(
+            inst["distance"]
+        ),
+        "2. the bitwise XOR of all four vertices is the all-zero word.",
+        "This is the XOR-zero analogue of the paper's exceptional K4 type.",
+        "",
+        "Vertices are indexed from 0. Your four indices must be written once each",
+        "in strictly increasing order. The order of vertices in the input has no",
+        "mathematical significance.",
+        "",
+        "Vertices:",
+    ]
+    lines.extend("{}: {}".format(i, value) for i, value in enumerate(inst["vertices"]))
+    lines.extend(
+        [
+            "",
+            "Give your final answer inside <answer></answer> tags, as a JSON array",
+            "of exactly four strictly increasing 0-based indices.",
+            "Example: <answer>[1, 3, 7, 10]</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        answer = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(answer, list) or not all(
+        isinstance(item, int) and not isinstance(item, bool) for item in answer
+    ):
+        return None
+    return answer
+
+
+def verify(inst, answer):
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if len(answer) == 0:
+        return False, "answer is empty"
+    if not all(isinstance(item, int) and not isinstance(item, bool) for item in answer):
+        return False, "every index must be an integer"
+    if len(answer) != 4:
+        return False, "answer must contain exactly four indices"
+    if len(set(answer)) != 4:
+        return False, "indices must be distinct"
+    if answer != sorted(answer):
+        return False, "indices must be strictly increasing"
+    if answer[0] < 0 or answer[-1] >= len(inst["vertices"]):
+        return False, "index out of range"
+
+    values = _values(inst)
+    chosen = [values[i] for i in answer]
+    if chosen[0] ^ chosen[1] ^ chosen[2] ^ chosen[3]:
+        return False, "quartet XOR is nonzero"
+    for a in range(4):
+        for b in range(a + 1, 4):
+            got = _popcount(chosen[a] ^ chosen[b])
+            if got != inst["distance"]:
+                return False, "pair ({},{}) has Hamming distance {}, expected {}".format(
+                    answer[a], answer[b], got, inst["distance"]
+                )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    values = _values(inst)
+    classes = [
+        [i for i, value in enumerate(values) if (_popcount(value) & 1) == parity]
+        for parity in (0, 1)
+    ]
+    weights = [math.comb(len(group), 4) if len(group) >= 4 else 0 for group in classes]
+    draw = rng.randrange(sum(weights))
+    group = classes[0] if draw < weights[0] else classes[1]
+    return sorted(rng.sample(group, 4))
+
+
+def search_space(inst):
+    values = _values(inst)
+    counts = [
+        sum((_popcount(value) & 1) == parity for value in values)
+        for parity in (0, 1)
+    ]
+    return sum(math.comb(count, 4) for count in counts if count >= 4)
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 250000:
+        return None
+    count = 0
+    for candidate in itertools.combinations(range(len(inst["vertices"])), 4):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def canonical_key(inst):
+    """Strong cheap cube-isometry invariant: the complete distance multiset."""
+    values = _values(inst)
+    distances = []
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            distances.append(_popcount(values[i] ^ values[j]))
+    payload = "{}|{}|{}".format(
+        inst["bits"], inst["distance"], ",".join(map(str, sorted(distances)))
+    )
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params):
+    p = {k: v for k, v in dict(params).items() if k != "_preset"}
+    bits = int(p.get("bits", 128))
+    p["bits"] = bits * 2
+    p["distance"] = p["bits"] // 2
+    p["max_anchor_degree"] = min(int(p.get("max_anchor_degree", 10)), 10)
+    return p
+
+
+def _pair_xor_reference(inst):
+    values = _values(inst)
+    seen = {}
+    pair_operations = 0
+    collision_checks = 0
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            pair_operations += 1
+            key = values[i] ^ values[j]
+            old = seen.get(key)
+            if old is not None:
+                collision_checks += 1
+                candidate = sorted({old[0], old[1], i, j})
+                if len(candidate) == 4 and _candidate_valid_values(
+                    values, inst["distance"], candidate
+                ):
+                    return candidate, pair_operations, collision_checks
+            else:
+                seen[key] = (i, j)
+    return None, pair_operations, collision_checks
+
+
+def _checksum_route(inst):
+    values = _values(inst)
+    aggregate = 0
+    xor_operations = 0
+    for position, value in enumerate(values):
+        aggregate ^= value
+        if position:
+            xor_operations += 1
+    try:
+        anchor_index = values.index(aggregate)
+    except ValueError:
+        return None, xor_operations
+    neighbours = []
+    distance_operations = 0
+    for i, value in enumerate(values):
+        if i == anchor_index:
+            continue
+        distance_operations += 1
+        if _popcount(value ^ aggregate) == inst["distance"]:
+            neighbours.append(i)
+    lookup = {values[i]: i for i in neighbours}
+    pair_operations = 0
+    for a_pos, a in enumerate(neighbours):
+        for b in neighbours[a_pos + 1:]:
+            pair_operations += 2
+            wanted = aggregate ^ values[a] ^ values[b]
+            c = lookup.get(wanted)
+            if c is not None and c != a and c != b:
+                candidate = sorted([anchor_index, a, b, c])
+                if _candidate_valid_values(values, inst["distance"], candidate):
+                    return candidate, xor_operations + distance_operations + pair_operations
+    return None, xor_operations + distance_operations + pair_operations
+
+
+def _permute_coordinates(value, permutation):
+    out = 0
+    for old, new in enumerate(permutation):
+        if (value >> old) & 1:
+            out |= 1 << new
+    return out
+
+
+def _transformed(inst, order=None, coordinate_permutation=None, translation=0):
+    values = _values(inst)
+    if coordinate_permutation is not None:
+        values = [_permute_coordinates(v, coordinate_permutation) for v in values]
+    if translation:
+        values = [v ^ translation for v in values]
+    if order is None:
+        order = list(range(len(values)))
+    inverse = {old: new for new, old in enumerate(order)}
+    width = (inst["bits"] + 3) // 4
+    answer = sorted(inverse[i] for i in inst["answer"])
+    return {
+        "bits": inst["bits"],
+        "distance": inst["distance"],
+        "vertices": [format(values[i], "0{}X".format(width)) for i in order],
+        "answer": answer,
+    }
+
+
+def selftest():
+    report = {}
+
+    planted_checks = 0
+    json_checks = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in range(4):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            if not ok:
+                raise AssertionError((preset, seed, reason))
+            planted_checks += 1
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                raise AssertionError("answer is not JSON-native")
+            json_checks += 1
+    report["G1_planted_verifies"] = {
+        "pass": True,
+        "checks": planted_checks,
+        "json_native_checks": json_checks,
+    }
+
+    inst = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    answer = inst["answer"]
+    corruptions = {
+        "empty": [],
+        "drop_one": answer[:-1],
+        "swap_order": [answer[1], answer[0], answer[2], answer[3]],
+        "duplicate": [answer[0], answer[0], answer[2], answer[3]],
+        "out_of_range": [answer[0], answer[1], answer[2], len(inst["vertices"])],
+    }
+    reasons = {}
+    for name, bad in corruptions.items():
+        ok, reason = verify(inst, bad)
+        if ok:
+            raise AssertionError("corruption accepted: " + name)
+        reasons[name] = reason
+    if len(set(reasons.values())) != len(reasons):
+        raise AssertionError("corruptions did not receive distinct reasons")
+    report["G2_rejects_corruption"] = {
+        "pass": True,
+        "rejected": len(reasons),
+        "reasons": reasons,
+    }
+
+    model_text = "Reasoning omitted.\n```json\n<answer>{}</answer>\n```".format(
+        json.dumps(answer)
+    )
+    parsed = parse_answer(model_text)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer,
+        "parsed": parsed,
+    }
+
+    samples = 200000
+    guess_rng = random.Random(20260905)
+    hits = 0
+    for _ in range(samples):
+        candidate = random_candidate(inst, guess_rng)
+        if verify(inst, candidate)[0]:
+            hits += 1
+    exact_valid = 1  # proved by the pair-XOR collision invariant in construction
+    exact_probability = exact_valid / search_space(inst)
+    report["G4_guess_resistance"] = {
+        "pass": exact_probability < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "sampled_fraction": hits / samples,
+        "exact_valid_answers": exact_valid,
+        "search_space": search_space(inst),
+        "exact_probability": exact_probability,
+        "sampler": (
+            "uniform over all strictly increasing four-index subsets contained "
+            "in one freely deduced vertex-parity class"
+        ),
+    }
+
+    t0 = time.perf_counter()
+    reference_answer, pair_ops, collision_checks = _pair_xor_reference(inst)
+    reference_wall = time.perf_counter() - t0
+    ref_ok = reference_answer is not None and verify(inst, reference_answer)[0]
+    report["G5_density_and_baseline"] = {
+        "pass": exact_probability < 1e-6 and ref_ok,
+        "shipping_valid_answer_count": exact_valid,
+        "shipping_solution_density": exact_probability,
+        "density_sample_hits": hits,
+        "density_sample_total": samples,
+        "baseline_wall_clock_seconds": reference_wall,
+        "baseline_pair_operations": pair_ops,
+        "baseline_collision_checks": collision_checks,
+    }
+
+    attacks = {
+        "outlier_absolute_degree": {"successes": 0, "attempts": 0},
+        "greedy_degree_clique": {"successes": 0, "attempts": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0},
+        "lexicographic_pair_xor_256": {"successes": 0, "attempts": 0},
+    }
+    attack_functions = {
+        "outlier_absolute_degree": _attack_outlier_degree,
+        "greedy_degree_clique": _attack_greedy_clique,
+        "random_restart_256": _attack_random_restart,
+        "lexicographic_pair_xor_256": _attack_bounded_pair_xor,
+    }
+    reference_successes = 0
+    reference_operations = 0
+    reference_elapsed = 0.0
+    for seed in range(8):
+        trial = make_instance(seed=9000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        for name, attack in attack_functions.items():
+            candidate = attack(trial)
+            attacks[name]["attempts"] += 1
+            if candidate is not None and verify(trial, candidate)[0]:
+                attacks[name]["successes"] += 1
+        start = time.perf_counter()
+        candidate, operations, _ = _pair_xor_reference(trial)
+        reference_elapsed += time.perf_counter() - start
+        reference_operations += operations
+        if candidate is not None and verify(trial, candidate)[0]:
+            reference_successes += 1
+    all_failed = all(item["successes"] == 0 for item in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "pair-XOR collision hashing with exact Hamming checks",
+            "complexity": "O(N^2) exact word operations and O(N^2) memory",
+            "wall_clock_sec_total_8": reference_elapsed,
+            "operations_total_8": reference_operations,
+            "operations_mean": reference_operations / 8,
+            "solves": "{}/8, as expected".format(reference_successes),
+        },
+    }
+
+    spaces = []
+    for params in DIFFICULTY.values():
+        sample = make_instance(seed=8181, **params)
+        spaces.append(search_space(sample))
+    doubled_params = {
+        "n": 2 * DIFFICULTY["hard"]["n"],
+        "bits": 1000,
+        "distance": 600,
+        "max_anchor_degree": 3,
+    }
+    doubled = make_instance(seed=271828, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": spaces == sorted(spaces) and len(set(spaces)) == 4 and doubled_ok,
+        "preset_search_spaces": spaces,
+        "size_doubled_n": doubled_params["n"],
+        "size_doubled_verifies": doubled_ok,
+    }
+
+    invariance_checks = 0
+    real_transform_checks = 0
+    distinct_keys = set()
+    for seed in range(20):
+        base = make_instance(seed=12000 + seed, **DIFFICULTY["easy"])
+        key = canonical_key(base)
+        distinct_keys.add(key)
+        trng = random.Random(50000 + seed)
+        order = list(range(len(base["vertices"])))
+        trng.shuffle(order)
+        permutation = list(range(base["bits"]))
+        trng.shuffle(permutation)
+        translation = trng.getrandbits(base["bits"])
+        variants = [
+            _transformed(base, order=order),
+            _transformed(base, coordinate_permutation=permutation),
+            _transformed(base, translation=translation),
+            _transformed(
+                base,
+                order=order,
+                coordinate_permutation=permutation,
+                translation=translation,
+            ),
+        ]
+        for variant in variants:
+            invariance_checks += 1
+            if canonical_key(variant) != key:
+                raise AssertionError("canonical key changed under cube isometry")
+            real_transform_checks += 1
+            if not verify(variant, variant["answer"])[0]:
+                raise AssertionError("carried witness failed under cube isometry")
+    report["G8_canonical_key"] = {
+        "pass": invariance_checks == 80 and real_transform_checks == 80
+        and len(distinct_keys) == 20,
+        "invariance_checks": invariance_checks,
+        "real_transformation_checks": real_transform_checks,
+        "unrelated_distinct": len(distinct_keys),
+        "unrelated_attempts": 20,
+        "invariant": "SHA-256 of the sorted complete pairwise Hamming-distance multiset",
+    }
+
+    checksum_answer, route_operations = _checksum_route(inst)
+    encoded = json.dumps(answer)
+
+    def atoms(obj):
+        if isinstance(obj, dict):
+            return sum(atoms(value) for value in obj.values())
+        if isinstance(obj, list):
+            return sum(atoms(value) for value in obj)
+        return 1
+
+    answer_elements = atoms(answer)
+    answer_tokens = max(1, math.ceil(len(encoded) / 4))
+    within_caps = (
+        len(encoded) <= 2000 and answer_elements <= 256 and route_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": {
+            "bare": {"solved": 0, "attempts": 0},
+            "hinted": {"solved": 0, "attempts": 0},
+            "placebo": {"solved": 0, "attempts": 0},
+        },
+        "hinted_minus_placebo": 0.0,
+        "hinted_verdict": "not_yet_run",
+        "answer_chars": len(encoded),
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": route_operations,
+        "route_verified": checksum_answer is not None
+        and verify(inst, checksum_answer)[0],
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        isinstance(value, dict) and value.get("pass")
+        for key, value in report.items() if key.startswith("G")
+    )
+    return report
+
