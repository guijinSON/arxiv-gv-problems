+        "empty": [],
+        "drop_one": answer[:-1],
+        "swap_order": [answer[1], answer[0], answer[2], answer[3]],
+        "duplicate": [answer[0], answer[0], answer[2], answer[3]],
+        "out_of_range": [answer[0], answer[1], answer[2], len(inst["vertices"])],
+    }
