+    for _ in range(trials):
+        candidate = sorted(rng.sample(range(len(values)), 4))
+        if _candidate_valid_values(values, inst["distance"], candidate):
+            return candidate
+    return None
+
+
+def _attack_bounded_pair_xor(inst, budget=256):
+    values = _values(inst)
+    seen = {}
+    inspected = 0
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            if inspected >= budget:
+                return None
+            inspected += 1
+            key = values[i] ^ values[j]
+            if key in seen:
+                a, b = seen[key]
+                candidate = sorted({a, b, i, j})
+                if len(candidate) == 4 and _candidate_valid_values(
+                    values, inst["distance"], candidate
+                ):
+                    return candidate
+            else:
+                seen[key] = (i, j)
+    return None
+
+
+def _cheap_attacks_fail(inst):
+    return all(
+        attack(inst) is None
+        for attack in (
+            _attack_outlier_degree,
+            _attack_greedy_clique,
+            _attack_random_restart,
+            _attack_bounded_pair_xor,
+        )
+    )
+
+
+def make_instance(n, seed=0, **params):
+    """Transform and compose the two displayed K4 types from Section 3.
+
+    The planted first-type quartet is known before the instance is assembled.
+    Every other four-vertex block is a transformed second-type quartet.  No
+    search for a quartet obtains the answer.  Rejection only enforces uniqueness,
+    checksum route size, and failure of the declared cheap attacks.
+    """
+    bits = int(params.get("bits", 96))
+    distance = int(params.get("distance", bits // 2))
+    max_anchor_degree = int(params.get("max_anchor_degree", 10))
+    n = int(n)
+    if n < 8 or n % 4:
+        raise ValueError("n must be a multiple of four and at least 8")
+    if bits == 16:
+        # A tiny hand-scale analogue used only by the demo rung.
+        base_first = [0x0000, 0xFF00, 0xF0F0, 0x0FF0]
+        base_second = [0x0000, 0xFF00, 0xF0F0, 0x6996]
+        if distance != 8:
+            raise ValueError("the 16-bit demo construction requires distance 8")
+    else:
+        if bits < 10 or bits % 10 or distance != 6 * (bits // 10):
+            raise ValueError(
+                "the paper-derived construction requires bits=10m and distance=6m"
+            )
+        first10 = [
+            int("0000000000", 2),
+            int("1111110000", 2),
+            int("1110001110", 2),
+            int("0001111110", 2),
+        ]
+        second10 = [
+            int("0000000000", 2),
+            int("1111110000", 2),
+            int("1110001110", 2),
+            int("0101011011", 2),
+        ]
+        base_first = []
+        base_second = []
+        for source, target in ((first10, base_first), (second10, base_second)):
