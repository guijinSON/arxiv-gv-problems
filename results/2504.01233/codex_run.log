+        "label_bits": inst["label_bits"],
+        "ambient_dimension": inst["ambient_dimension"],
+        "distance": inst["distance"],
+        "labels": [format(values[i], "0{}X".format(width)) for i in order],
+        "answer": sorted(inverse[i] for i in inst["answer"]),
+    }
