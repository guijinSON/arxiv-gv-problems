+        "pass": True, "rejected": len(reasons), "reasons": reasons}
+
+    model_text = "Reasoning omitted.\n```json\n<answer>{}</answer>\n```".format(
+        json.dumps(answer))
+    parsed = parse_answer(model_text)
+    report["G3_round_trip"] = {"pass": parsed == answer, "parsed": parsed}
+
+    samples = 200000
