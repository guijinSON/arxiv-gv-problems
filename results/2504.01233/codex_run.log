+"""Verified generator for the exceptional Hamming K4 from arXiv:2504.01233.
+
+The paper's Section 3 separates the two isometry types of distance-six K4s in
+the 10-cube: the first type has XOR zero.  This module scales that native
+search object to even-dimensional Boolean cubes.  It plants one XOR-zero,
+equidistant quartet and carries the witness through random cube coordinates.
+"""
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "vertices of a Boolean cube",
+        "Hamming distance graph",
+        "exceptional equidistant four-vertex configuration",
+    ],
+    "verification_operations": [
+        "bitwise XOR",
+        "exact population count",
+        "integer index comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The XOR invariant distinguishing the paper's two K4 isometry types, "
+        "combined with a whole-instance checksum, exposes one anchor vertex; "
+        "without it one must compare quadratically many vertex pairs."
+    ),
+    "hardness_basis": (
+        "Track B: Section 3 identifies the XOR-zero K4 type; the reference "
+        "pair-XOR collision algorithm is O(N^2) dictionary operations (measured "
+        "at the shipping preset in selftest_report.json), whereas the checksum "
+        "route uses at most 288 exact word operations after the invariant is seen."
+    ),
+    "max_answer_tokens": 7,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A strictly increasing JSON array of four distinct 0-based indices "
+        "chosen from the N displayed cube vertices."
+    ),
+    "bounds": {"indices": 4, "minimum": 0, "maximum": "N-1"},
+}
+
+DIFFICULTY = {
+    "demo": {"n": 12, "bits": 16, "distance": 8, "max_anchor_degree": 8},
+    "easy": {"n": 80, "bits": 96, "distance": 48, "max_anchor_degree": 10},
+    "medium": {"n": 92, "bits": 112, "distance": 56, "max_anchor_degree": 10},
+    "hard": {"n": 104, "bits": 128, "distance": 64, "max_anchor_degree": 10},
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The bitwise-XOR aggregate of the complete vertex list is a useful "
+    "cube-isometry invariant for locating the exceptional quartet."
+)
+PLACEBO_HINT = (
+    "The fixed-width hexadecimal encoding is useful for keeping the many "
+    "exact vertex comparisons carefully organized."
+)
+
+NOTES = (
+    "Section 2 fixes G(V;k): cube vertices are adjacent exactly at Hamming "
+    "distance k. Section 3 states that its first K4 type has XOR of its four "
+    "vertices equal to zero, while the second type does not. The paper's "
+    "colorability checks use kissat with a one-second cutoff and its outer "
+    "configuration enumeration took about 14 days, so this is Track B rather "
+    "than an unsupported Track A distributional-hardness claim. Generation "
+    "plants the four marginally uniform vertices first, adds marginally uniform "
+    "decoys, and chooses one checksum decoy so XOR(all vertices) is a planted "
+    "anchor. Pair-XOR uniqueness removes accidental certificates without finding "
+    "the planted answer. Degree, greedy-clique, random-restart, and bounded "
+    "lexicographic pair-XOR attacks are rejected during construction."
+)
+
+
+def _popcount(x):
+    return x.bit_count()
+
+
+def _mask_from_positions(positions):
+    value = 0
+    for position in positions:
+        value |= 1 << position
+    return value
+
+
+def _values(inst):
+    return [int(text, 16) for text in inst["vertices"]]
+
+
+def _structural_ok(values, planted_positions):
+    """True iff pair-XOR collisions encode only the planted four-set.
+
+    Four distinct values XOR to zero exactly when two disjoint pairs have the
+    same XOR.  The planted quartet necessarily creates three such collisions.
+    Forbidding every other collision proves uniqueness without searching for a
+    witness: the witness positions are already known.
+    """
+    planted = frozenset(planted_positions)
+    seen = {}
+    collision_keys = set()
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            key = values[i] ^ values[j]
+            pair = (i, j)
+            if key in seen:
+                old = seen[key]
+                if ({old[0], old[1]} & {i, j}) or frozenset(old + pair) != planted:
+                    return False
+                if key in collision_keys:
+                    return False
+                collision_keys.add(key)
+            else:
+                seen[key] = pair
+    return len(collision_keys) == 3
+
+
+def _degree_list(values, distance):
+    degrees = [0] * len(values)
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            if _popcount(values[i] ^ values[j]) == distance:
+                degrees[i] += 1
+                degrees[j] += 1
+    return degrees
+
+
+def _candidate_valid_values(values, distance, candidate):
+    if candidate is None or len(candidate) != 4 or len(set(candidate)) != 4:
+        return False
+    selected = [values[i] for i in candidate]
+    if selected[0] ^ selected[1] ^ selected[2] ^ selected[3]:
+        return False
+    return all(
+        _popcount(selected[a] ^ selected[b]) == distance
+        for a in range(4) for b in range(a + 1, 4)
+    )
+
+
+def _attack_outlier_degree(inst):
+    values = _values(inst)
+    degrees = _degree_list(values, inst["distance"])
+    mean = sum(degrees) / len(degrees)
+    picked = sorted(
+        sorted(range(len(values)), key=lambda i: (-abs(degrees[i] - mean), i))[:4]
+    )
+    return picked if _candidate_valid_values(values, inst["distance"], picked) else None
+
+
+def _attack_greedy_clique(inst):
+    values = _values(inst)
+    distance = inst["distance"]
+    degrees = _degree_list(values, distance)
+    order = sorted(range(len(values)), key=lambda i: (-degrees[i], i))
+    for start in order[: min(16, len(order))]:
+        clique = [start]
+        for vertex in order:
+            if vertex not in clique and all(
+                _popcount(values[vertex] ^ values[u]) == distance for u in clique
+            ):
+                clique.append(vertex)
+                if len(clique) == 4:
+                    candidate = sorted(clique)
+                    if _candidate_valid_values(values, distance, candidate):
+                        return candidate
+                    break
+    return None
+
+
+def _attack_random_restart(inst, trials=256):
+    values = _values(inst)
+    # Stable instance-derived seed; never the generator's seed or planted answer.
+    attack_seed = (values[0] ^ values[-1] ^ len(values) ^ inst["bits"]) & ((1 << 64) - 1)
+    rng = random.Random(attack_seed)
+    for _ in range(trials):
+        candidate = sorted(rng.sample(range(len(values)), 4))
+        if _candidate_valid_values(values, inst["distance"], candidate):
+            return candidate
+    return None
+
+
+def _attack_bounded_pair_xor(inst, budget=256):
+    values = _values(inst)
+    seen = {}
+    inspected = 0
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            if inspected >= budget:
+                return None
+            inspected += 1
+            key = values[i] ^ values[j]
+            if key in seen:
+                a, b = seen[key]
+                candidate = sorted({a, b, i, j})
+                if len(candidate) == 4 and _candidate_valid_values(
+                    values, inst["distance"], candidate
+                ):
+                    return candidate
+            else:
+                seen[key] = (i, j)
+    return None
+
+
+def _cheap_attacks_fail(inst):
+    return all(
+        attack(inst) is None
+        for attack in (
+            _attack_outlier_degree,
+            _attack_greedy_clique,
+            _attack_random_restart,
+            _attack_bounded_pair_xor,
+        )
+    )
+
+
+def make_instance(n, seed=0, **params):
+    """Plant one exceptional equidistant quartet, then add checksum decoys.
+
+    The certificate is sampled before the instance.  No search for a quartet is
+    used to obtain it.  Rejection only enforces uniqueness, checksum route size,
+    and failure of the declared cheap attacks.
+    """
+    bits = int(params.get("bits", 96))
+    distance = int(params.get("distance", bits // 2))
+    max_anchor_degree = int(params.get("max_anchor_degree", 10))
+    n = int(n)
+    if n < 8:
+        raise ValueError("n must be at least 8")
+    if bits < 8 or distance <= 0 or distance > bits or distance % 2:
+        raise ValueError("distance must be a positive even integer at most bits")
+    if max_anchor_degree < 3:
+        raise ValueError("max_anchor_degree must be at least 3")
+
+    rng = random.Random(seed)
+    width = (bits + 3) // 4
+    full_mask = (1 << bits) - 1
+
+    for _attempt in range(20000):
+        anchor = rng.getrandbits(bits)
+        a_positions = rng.sample(range(bits), distance)
+        a_set = set(a_positions)
+        overlap = rng.sample(a_positions, distance // 2)
+        outside = rng.sample(
+            [i for i in range(bits) if i not in a_set], distance // 2
+        )
+        mask_a = _mask_from_positions(a_positions)
+        mask_b = _mask_from_positions(overlap + outside)
+        planted_values = [
+            anchor,
+            anchor ^ mask_a,
+            anchor ^ mask_b,
+            anchor ^ mask_a ^ mask_b,
+        ]
+
+        used = set(planted_values)
+        random_decoys = []
+        while len(random_decoys) < n - 5:
+            value = rng.getrandbits(bits) & full_mask
+            if value not in used:
+                used.add(value)
+                random_decoys.append(value)
+
+        checksum_decoy = anchor
+        for value in random_decoys:
+            checksum_decoy ^= value
+        if checksum_decoy in used:
+            continue
+
+        values = planted_values + random_decoys + [checksum_decoy]
+        anchor_degree = sum(
+            _popcount(anchor ^ value) == distance for value in values[1:]
+        )
+        if anchor_degree > max_anchor_degree:
+            continue
+        if not _structural_ok(values, range(4)):
+            continue
+
+        order = list(range(n))
+        rng.shuffle(order)
+        shuffled = [values[i] for i in order]
+        inverse = {old: new for new, old in enumerate(order)}
+        answer = sorted(inverse[i] for i in range(4))
+        inst = {
+            "bits": bits,
+            "distance": distance,
+            "vertices": [format(value, "0{}X".format(width)) for value in shuffled],
+            "answer": answer,
+        }
+        # The demo is deliberately hand-solvable, so adversarial filtering is
+        # applied only at benchmark-sized levels.
+        if n < DIFFICULTY["easy"]["n"] or _cheap_attacks_fail(inst):
+            return inst
+    raise RuntimeError("could not construct a filtered planted instance")
+
+
+def render(inst):
+    lines = [
+        "Exceptional equidistant quartet in a Boolean cube",
+        "",
+        "Each displayed fixed-width hexadecimal word encodes one vertex of the",
+        "{}-dimensional Boolean cube {{0,1}}^{}; leading zeroes are significant.".format(
+            inst["bits"], inst["bits"]
+        ),
+        "The Hamming distance between two vertices is the number of bit positions",
+        "where they differ, equivalently popcount(x XOR y).",
+        "",
+        "Find four distinct listed vertices such that:",
+        "1. every one of their six pairwise Hamming distances is exactly {}, and".format(
+            inst["distance"]
+        ),
+        "2. the bitwise XOR of all four vertices is the all-zero word.",
+        "Such four vertices form the exceptional K4 type in the distance graph.",
+        "",
+        "Vertices are indexed from 0. Your four indices must be written once each",
+        "in strictly increasing order. The order of vertices in the input has no",
+        "mathematical significance.",
+        "",
+        "Vertices:",
+    ]
+    lines.extend("{}: {}".format(i, value) for i, value in enumerate(inst["vertices"]))
+    lines.extend(
+        [
+            "",
+            "Give your final answer inside <answer></answer> tags, as a JSON array",
+            "of exactly four strictly increasing 0-based indices.",
+            "Example: <answer>[3, 17, 42, 61]</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        answer = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(answer, list) or not all(
+        isinstance(item, int) and not isinstance(item, bool) for item in answer
+    ):
+        return None
+    return answer
+
+
+def verify(inst, answer):
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if len(answer) == 0:
+        return False, "answer is empty"
+    if not all(isinstance(item, int) and not isinstance(item, bool) for item in answer):
+        return False, "every index must be an integer"
+    if len(answer) != 4:
+        return False, "answer must contain exactly four indices"
+    if len(set(answer)) != 4:
+        return False, "indices must be distinct"
+    if answer != sorted(answer):
+        return False, "indices must be strictly increasing"
+    if answer[0] < 0 or answer[-1] >= len(inst["vertices"]):
+        return False, "index out of range"
