+        "pass": invariance_checks == 80 and real_transform_checks == 80
+        and len(distinct_keys) == 20,
+        "invariance_checks": invariance_checks,
+        "real_transformation_checks": real_transform_checks,
+        "unrelated_distinct": len(distinct_keys),
+        "unrelated_attempts": 20,
+        "invariant": "SHA-256 of the sorted complete pairwise Hamming-distance multiset",
+    }
