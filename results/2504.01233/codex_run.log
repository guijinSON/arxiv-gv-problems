+    classes = [
+        [i for i, value in enumerate(values) if (_popcount(value) & 1) == parity]
+        for parity in (0, 1)
+    ]
+    weights = [math.comb(len(group), 4) if len(group) >= 4 else 0 for group in classes]
+    draw = rng.randrange(sum(weights))
+    group = classes[0] if draw < weights[0] else classes[1]
+    return sorted(rng.sample(group, 4))
+
+
+def search_space(inst):
+    values = _values(inst)
+    counts = [
+        sum((_popcount(value) & 1) == parity for value in values)
+        for parity in (0, 1)
+    ]
+    return sum(math.comb(count, 4) for count in counts if count >= 4)
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 250000:
+        return None
+    count = 0
+    for candidate in itertools.combinations(range(len(inst["vertices"])), 4):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def canonical_key(inst):
+    """Strong cheap cube-isometry invariant: the complete distance multiset."""
+    values = _values(inst)
+    distances = []
+    for i in range(len(values)):
+        for j in range(i + 1, len(values)):
+            distances.append(_popcount(values[i] ^ values[j]))
+    payload = "{}|{}|{}".format(
+        inst["bits"], inst["distance"], ",".join(map(str, sorted(distances)))
+    )
