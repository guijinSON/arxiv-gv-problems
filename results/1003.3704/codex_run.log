+    duplicated_left = left[:]
+    duplicated_left.insert(1, duplicated_left[0])
+    duplicated = {"left": duplicated_left, "right": right[:]}
+    outside_right = right[:]
+    outside_right[-1] = inst["n"]
+    outside = {"left": left[:], "right": outside_right}
+    return {
