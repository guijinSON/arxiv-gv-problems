+            roundtrip = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            rows.append({"seed": seed, "ok": ok, "reason": why, "json_native": roundtrip})
+            g1_pass &= ok and roundtrip
+            json_native += int(roundtrip)
+            total_instances += 1
