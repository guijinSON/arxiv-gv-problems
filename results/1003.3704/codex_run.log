+        "spectral_bottom_eigenvector_with_repair",
+        "nae_dpll_unit_propagation_10000",
+    )
+    stats = {
+        name: {"successes": 0, "attempts": 0, "operations": 0, "wall_clock_sec": 0.0}
+        for name in attack_names
+    }
+    node_samples = []
+    dpll_time_samples = []
+    for seed in range(800, 808):
