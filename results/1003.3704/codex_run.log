+    "easy": {"n": 180, "degree": 6, "extra_layers": 3},
+    "medium": {"n": 210, "degree": 6, "extra_layers": 3},
+    "hard": {"n": 240, "degree": 6, "extra_layers": 4},
+}
+SHIPPING_DIFFICULTY: str = "easy"
