+        reordered = _reorder_instance(inst, random.Random(seed * 17 + 2))
+        composed = _reorder_instance(relabelled, random.Random(seed * 17 + 3))
+        for transformed in (relabelled, reordered, composed):
+            invariant_checks += 1
