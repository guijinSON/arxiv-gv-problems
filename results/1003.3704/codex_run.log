+    baseline_seconds = time.perf_counter() - baseline_started
+    baseline_solved = bool(baseline_candidate and verify(ship, baseline_candidate)[0])
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    exact_demo = enumerate_all(demo)
