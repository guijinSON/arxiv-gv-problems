+        "pass": parsed == ship["answer"],
+        "parsed_left": None if parsed is None else len(parsed["left"]),
+        "parsed_right": None if parsed is None else len(parsed["right"]),
+    }
+
+    guess_rng = random.Random(0x10033704)
