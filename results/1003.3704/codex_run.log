+
+        started = time.perf_counter()
+        candidate, dpll_stats = _dpll_search(inst)
+        elapsed = time.perf_counter() - started
+        success = bool(candidate and verify(inst, candidate)[0])
+        row = stats["nae_dpll_unit_propagation_10000"]
