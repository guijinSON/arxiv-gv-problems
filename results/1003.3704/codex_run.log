+        "shipping_n": ship["n"],
+        "shipping_clauses": ship["clause_count"],
+        "doubled_n": doubled["n"],
+        "doubled_clauses": doubled["clause_count"],
+        "doubled_planted_verifies": doubled_ok,
+        "doubled_verify_reason": doubled_reason,
+        "escalated_params": harder,
