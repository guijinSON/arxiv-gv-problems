+        "distinct_reasons": len(set(reasons)),
+    }
+
+    response = (
+        "The two sides below satisfy every NAE clause.\n\n<answer>\n```json\n"
+        + json.dumps(ship["answer"], separators=(",", ":"))
+        + "\n```\n</answer>\nI used zero-based indexing."
+    )
+    parsed = parse_answer(response)
