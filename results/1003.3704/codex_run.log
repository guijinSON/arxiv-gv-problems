+        "fixed_answer_length_crowding_exhausted_before_n_growth": fixed_axis_exhausted,
+    }
+
+    invariant_checks = 0
+    preservation_checks = 0
+    keys = []
+    g8_ok = True
+    for seed in range(1_200, 1_220):
+        inst = make_instance(seed=seed, **shipping_params)
+        key = canonical_key(inst)
+        keys.append(key)
