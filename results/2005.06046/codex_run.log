+def _poly_eval(coefficients, value):
+    result = 0
+    for coefficient in reversed(coefficients):
+        result = result * value + coefficient
+    return result
+
+
+def _sign(value):
+    return 1 if value > 0 else -1 if value < 0 else 0
+
