+def _poly_mul(a, b):
+    out = [0] * (len(a) + len(b) - 1)
+    for i, x in enumerate(a):
+        for j, y in enumerate(b):
+            out[i + j] += x * y
+    return out
+
+
+def _poly_pow(poly, exponent):
+    out = [1]
+    base = list(poly)
+    power = exponent
+    while power:
+        if power & 1:
+            out = _poly_mul(out, base)
+        power //= 2
+        if power:
+            base = _poly_mul(base, base)
+    return out
+
