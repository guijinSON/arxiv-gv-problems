+def _all_matchings(values):
+    values = tuple(values)
+    if not values:
+        yield ()
+        return
+    first = values[0]
+    for i in range(1, len(values)):
+        second = values[i]
+        rest = values[1:i] + values[i + 1:]
+        for tail in _all_matchings(rest):
+            yield ((first, second),) + tail
