+    rng.shuffle(gaps)
+    rows = []
+    for i in range(0, count, 2):
+        pair = sorted((2 * gaps[i] + 1, 2 * gaps[i + 1] + 1))
+        rows.append([[pair[0], 2], [pair[1], 2]])
+    return sorted(rows)
