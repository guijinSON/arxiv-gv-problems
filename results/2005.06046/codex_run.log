+    coefficients = inst["coefficients"]
+    degree = len(coefficients) - 1
+    switches = []
+    previous = _sign(_poly_eval(coefficients, 0))
+    operations = 2 * degree
+    for j in range(1, inst["n"]):
+        current = _sign(_poly_eval(coefficients, 2 * j))
+        operations += 2 * degree
