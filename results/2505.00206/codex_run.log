+        "shipping_k": 4,
+        "shipping_n": 96,
+    },
+}
+
+STRUCTURAL_HINT: str = (
+    "The running coordinatewise AND is precisely the set of one-bits that the "
+    "unselected collections still have to erase."
+)
+
+PLACEBO_HINT: str = (
