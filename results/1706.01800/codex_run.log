+    "intended_route_verified_instances": 20,
+    "operation_unit": "one exact F_q addition, multiplication, or division",
+    "pass": true
+  },
+  "all_passed": true,
+  "paper": "1706.01800",
+  "shipping_difficulty": "hard",
+  "track": "B"
+}

