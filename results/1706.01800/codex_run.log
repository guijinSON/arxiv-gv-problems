+        "paper": "arXiv:1706.01800",
+        "q": q,
+        "f": n,
+        "zero_row_generators": zero_rows,
+        "target_row_generator": target_row,
+        "columns": columns,
+        "fixed_coordinate": [fixed_index, answer[fixed_index]],
+        "target": target,
