def _is_prime(value: int) -> bool:
    if value < 2:
        return False
    if value % 2 == 0:
        return value == 2
    factor = 3
    while factor * factor <= value:
        if value % factor == 0:
            return False
        factor += 2
    return True


def _next_prime(value: int) -> int:
    candidate = max(3, value | 1)
    while not _is_prime(candidate):
        candidate += 2
    return candidate


def _validate_params(n: int, groups: int, multiplicity_span: int) -> None:
    if isinstance(n, bool) or not isinstance(n, int) or not _is_prime(n):
        raise ValueError("n must be an odd prime")
    if not 3 <= n <= 65537:
        raise ValueError("n must be an odd prime in 3..65537")
    if isinstance(groups, bool) or not isinstance(groups, int) or not 3 <= groups <= 64:
        raise ValueError("groups must be an integer in 3..64")
    if (
        isinstance(multiplicity_span, bool)
        or not isinstance(multiplicity_span, int)
        or not 1 <= multiplicity_span <= 1_000_000
    ):
        raise ValueError("multiplicity_span must be an integer in 1..1000000")


# Matrices are tuples (a,b,c,d), interpreted projectively over F_p.
def _det(matrix: tuple[int, int, int, int], p: int) -> int:
    a, b, c, d = matrix
    return (a * d - b * c) % p


def _mat_mul(
    left: tuple[int, int, int, int],
    right: tuple[int, int, int, int],
    p: int,
) -> tuple[int, int, int, int]:
    a, b, c, d = left
    e, f, g, h = right
    return (
        (a * e + b * g) % p,
        (a * f + b * h) % p,
        (c * e + d * g) % p,
        (c * f + d * h) % p,
    )


def _mat_inv(matrix: tuple[int, int, int, int], p: int) -> tuple[int, int, int, int]:
    a, b, c, d = matrix
    inverse_det = pow(_det(matrix, p), -1, p)
    return (
        d * inverse_det % p,
        -b * inverse_det % p,
        -c * inverse_det % p,
        a * inverse_det % p,
    )


def _mobius(matrix: tuple[int, int, int, int], value: int, p: int) -> int:
    """Apply a PGL(2,p) matrix; integer p is the infinity label."""
    a, b, c, d = matrix
    if value == p:
        return p if c == 0 else a * pow(c, -1, p) % p
    denominator = (c * value + d) % p
    if denominator == 0:
        return p
    return (a * value + b) * pow(denominator, -1, p) % p


def _random_matrix(rng: random.Random, p: int) -> tuple[int, int, int, int]:
    """Sample a non-affine map whose images of 0, 1 and infinity are finite."""
    while True:
        matrix = tuple(rng.randrange(p) for _ in range(4))
        a, _b, c, d = matrix
        if _det(matrix, p) and c and d and (c + d) % p and a < p:
            return matrix


def _parabolic_with_fixed_point(value: int, p: int) -> tuple[int, int, int, int]:
    """A conjugate of y -> y+1 whose sole P^1 fixed point is value."""
    translation = (1, 1, 0, 1)
    if value == p:
        conjugator = (1, 0, 0, 1)
    else:
        conjugator = (value % p, -1 % p, 1, 0)
    return _mat_mul(
        _mat_mul(conjugator, translation, p),
        _mat_inv(conjugator, p),
        p,
    )


def _table(matrix: tuple[int, int, int, int], p: int) -> list[int]:
    return [_mobius(matrix, value, p) for value in range(p + 1)]


def _valid_vector(inst: dict, vector: list[int]) -> bool:
    groups = inst["groups"]
    return all(
        vector[(i + 1) % groups] == inst["maps"][i][vector[i]]
        for i in range(groups)
    )


def _affine_ansatz(inst: dict) -> list[int]:
    """Misread every projective table as x -> slope*x+intercept."""
    p = inst["p"]
    affine: list[tuple[int, int]] = []
    for table in inst["maps"]:
        intercept = table[0]
        slope = (table[1] - intercept) % p
        affine.append((slope, intercept))

    total_slope, total_intercept = 1, 0
    for slope, intercept in affine:
        total_slope = slope * total_slope % p
