+        "doubled_build_and_verify": doubled_ok,
+    }
+
+    # G8: four generators of the equivalence group and their composition.
+    invariance_checks = 0
+    carried_checks = 0
+    canonical_failures: list[str] = []
+    distinct_keys = set()
+    for seed in range(20):
+        base = make_instance(seed=100000 + seed, **shipping_params)
