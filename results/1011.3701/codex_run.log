+        right = _sample_matrix(relabel_rng, trial["p"])
+        relabelled, carried = _projective_relabel(trial, left, right, False)
+        composed, composed_carried = _projective_relabel(trial, left, right, True)
+        reordered = dict(trial)
+        reordered["incidence"] = [
