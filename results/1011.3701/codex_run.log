def _connected_incidence(incidence: list[list[int]], q: int) -> bool:
    adjacency = [[] for _ in range(2 * q)]
    for x, candidates in enumerate(incidence):
        for y in candidates:
            adjacency[x].append(q + y)
            adjacency[q + y].append(x)
