+    matched = 0
+    while bfs():
+        progress = 0
+        for left in range(q):
+            if pair_left[left] < 0 and dfs(left):
+                progress += 1
+        matched += progress
+        if progress == 0:
+            break
+    return (pair_left if matched == q else None), edge_scans
