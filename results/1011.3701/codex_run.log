+def _projective_image(matrix: list[list[int]], point: int, p: int) -> int:
+    """Apply a Mobius matrix; the integer p represents infinity."""
+
+    a, b = matrix[0]
+    c, d = matrix[1]
+    if point == p:
+        numerator, denominator = a % p, c % p
