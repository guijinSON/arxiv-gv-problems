+
+    guess_rng = random.Random(314159265)
+    guess_total = 200_000
+    guess_hits = 0
+    matrix_trials = 0
+    matrix_hits = 0
+    explicit_trials = 0
+    explicit_hits = 0
+    for _ in range(guess_total):
+        candidate = random_candidate(inst, guess_rng)
+        ok = verify(inst, candidate)[0]
+        guess_hits += int(ok)
+        if (
+            isinstance(candidate, list)
+            and len(candidate) == 2
