+    lines.extend(
+        [
+            "",
+            "Give your final answer inside <answer></answer> tags as JSON in one accepted format.",
+            "Example syntax: <answer>[[1,0],[0,1]]</answer>",
+            "Output nothing else inside the tags.",
+        ]
