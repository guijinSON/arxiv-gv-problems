+
+    doubled_n = _next_prime(2 * shipping_params["n"] - 1)
+    doubled = make_instance(
+        n=doubled_n, degree=shipping_params["degree"], seed=424242
+    )
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
