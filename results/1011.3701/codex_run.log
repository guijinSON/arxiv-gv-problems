        pivot_columns.append(column)
        pivot_row += 1
        if pivot_row == 3:
            break
    if len(pivot_columns) != 3:
        return None
    free_columns = [column for column in range(4) if column not in pivot_columns]
    if len(free_columns) != 1:
        return None
    free = free_columns[0]
    solution = [0, 0, 0, 0]
    solution[free] = 1
