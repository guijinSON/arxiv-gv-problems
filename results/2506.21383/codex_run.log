+    invariant_checks = 0
+    invariant_passes = 0
+    carried_checks = 0
+    carried_passes = 0
+    unrelated_keys: list[str] = []
+    for seed in range(20):
+        inst = make_instance(n=32, seed=7000 + seed)
+        base_key = canonical_key(inst)
+        unrelated_keys.append(base_key)
