+        costs[attack_names[1]]["work"] += inst["n"] * inst["n"] // 2
+        successes[attack_names[1]] += int(verify(inst, candidate)[0])
+
+        t0 = time.perf_counter()
+        candidate, work = _local_restart_attack(inst, random.Random(seed ^ 0xBAD5EED), 64)
