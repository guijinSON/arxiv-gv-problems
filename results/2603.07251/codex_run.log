+{
+  "G1_planted_verifies": {
+    "failures": [],
+    "pass": true,
+    "tested": 12
+  },
+  "G2_rejects_corruption": {
+    "cases": {
+      "drop_one": {
+        "reason": "wrong group sizes: each list must contain exactly 32 indices",
+        "rejected": true
+      },
+      "duplicate": {
