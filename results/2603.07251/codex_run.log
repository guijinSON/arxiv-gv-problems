def _residue_score(value: int, modulus: int) -> int:
    value %= modulus
    return min(value, modulus - value)


def _random_restart_attack(inst, rng, restarts: int = 24) -> dict:
    """Random balanced starts followed by best improving plus/minus swaps."""
    q = inst["modulus"]
    xs = inst["sequence"]
