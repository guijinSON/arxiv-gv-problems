+def _check_linear_3cnf(inst: dict) -> tuple[bool, str]:
+    """Execute the paper's literal-based definition of linear 3-CNF exactly."""
 
+    clauses = [set(clause) for clause in inst["clauses"]]
+    for ci, clause in enumerate(inst["clauses"]):
