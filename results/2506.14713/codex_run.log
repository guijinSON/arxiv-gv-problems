+    for i, left in enumerate(clauses):
+        intersections = 0
+        for j in range(i + 1, len(clauses)):
+            common = left & clauses[j]
+            if len(common) > 1:
+                return False, f"clauses {i + 1} and {j + 1} share multiple literals"
+            if common:
