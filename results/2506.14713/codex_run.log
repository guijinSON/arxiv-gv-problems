index 0000000000000000000000000000000000000000..da8349c2c6e3febd8c52d4fdfcfc2bfa228e40e3
--- /dev/null
+++ b/gen_2506_14713.py
@@ -0,0 +1,1199 @@
+"""Verified generator for monotone linear planar SAT witnesses.
+
+This module instantiates the paper's linear literal-planar construction and
+then applies the friend-assignment transformation from Section 3, Theorem 3.2
+of arXiv:2506.14713.  The generated formulas are a deliberately honest Track B
+subfamily: ordinary unit-propagating DPLL solves the shipping instances, while
+the displayed instances are too large to execute that mechanical route by
+hand.  A short quadratic-residue invariant recovers the planted friend
+assignment.
+
+Only the Python standard library is used.  Importing the module performs no
+I/O and produces no output.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+_REDUCTION = (
+    "Section 3, Theorem 3.2 (equations (10)--(11)): replace each negative "
+    "literal not-v by a fresh positive variable v' and add (not-v or not-v'); "
+    "the proof carries a satisfying assignment to its friend assignment"
+)
+
+PROBLEM_PROFILE = {
+    "native_domain": "logic",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "monotone linear planar 3-CNF formula",
+        "variable cycle certifying the paper's planar regime",
+        "Boolean truth assignment",
+    ],
+    "verification_operations": [
+        "exact Boolean literal evaluation",
+        "exact clause conjunction",
+        "bitstring shape checking",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": _REDUCTION,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The first truth values in the displayed complementary pairs are "
+        "constant on the quadratic-residue coset of their tags; without that "
+        "invariant a solver must propagate a large implication graph."
+    ),
+    "hardness_basis": (
+        "Track B: unit-propagating DPLL has O(2^N*M) worst-case complexity but "
+        "solves every shipping instance and performs about 70,000 literal "
+        "checks there; the generated distribution also has an O(n*sqrt(n)) "
+        "tag algorithm, whose compact execution uses 63 modular squarings and "
+        "126 exact membership decisions."
+    ),
+    "max_answer_tokens": 64,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 6, "or_percent": 35},
+    "easy": {"n": 30, "or_percent": 35},
+    "medium": {"n": 60, "or_percent": 35},
+    "hard": {"n": 126, "or_percent": 35},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The first-variable truth values in the displayed pairs form the "
+    "quadratic-residue coset of their nonzero tags modulo p."
+)
+PLACEBO_HINT = (
+    "Careful bookkeeping of complementary variables and clause signs is "
+    "especially useful for this instance."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A bitstring of exactly 2n Boolean values in variable-ID order; for "
+        "structure-aware guessing, each displayed negative pair clause is "
+        "satisfied in advance, leaving the three pair states 00, 01, and 10."
+    ),
+    "bounds": {
+        "length": "2 * inst['n']",
+        "alphabet": [0, 1],
+        "allowed_states_per_displayed_pair": ["00", "01", "10"],
+        "candidate_count": "3 ** inst['n']",
+    },
+}
+
+NOTES = r"""
+STEP 0.  Section 2 defines a linear formula exactly: every clause intersects
+at most one other clause as a set of signed literals, and such an intersection
+has size at most one.  Section 2 also defines planar 3-SAT using a variable
+cycle and explicitly uses "3-CNF" for clauses of size at most three.  Section
+3, Theorem 3.2 proves NP-completeness for monotone linear planar 3-SAT even when
+each variable has at most one negative occurrence.  Its proof gives the exact
+transformation used here: replace not-v by v', add (not-v or not-v'), and carry
+nu to the friend assignment nu(v')=1-nu(v).
+
+Certificate cost and track.  The construction below uses both two- and
+three-literal clauses, in the parameter regime of Theorem 3.2.  A standard
+unit-propagating DPLL search nevertheless solves all generated shipping
+instances, so this distribution cannot honestly be Track A.  selftest runs
+that successful search and reports its wall time, nodes, and literal checks
+separately from the failing attacks.  More specifically, the extra tags give
+this generated distribution an O(n*sqrt(n)) algorithm: recognize the
+quadratic-residue coset and directly write the friend assignment.  That is the
+compact Track B route.
+
+Generation.  Before any clauses exist, a noncrossing cubic port diagram and a
+legal orientation are sampled.  Every local component has three ports.  An OR
+component has one three-literal clause.  An AND component has two source
+clauses sharing one heavy literal; the heavy port is chosen so that either it
+points inward or both light ports point inward.  Thus the sampled orientation
+satisfies the source linear literal-planar formula by construction.
+Cycle edges join adjacent ports and the remaining ports use a Catalan
+noncrossing matching, so paired-literal edges lie inside the literal cycle;
+the two-clause local components occupy disjoint arcs outside it.  The paper's
+Theorem 3.2 then gives the emitted monotone linear planar formula and friend
+assignment without solving either formula.
+
+Plant leakage defenses.  Edge IDs, pair tags, clause order, literal order, and
+the Catalan matching are independently shuffled.  Vertices of in-degree two
+randomly alternate between the two legal AND modes, preventing the repeated
+heavy literal from consistently identifying truth.  Clause order is sampled
+until a full one-pass greedy repair fails.  The adversary panel separately
+tests positive-occurrence outliers, all-first and tag-parity ansatzes, that
+one-pass greedy route, and 256 structure-aware random restarts.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 1_000_000
+
+# Filled from script-owned hardening transcripts after those runs complete.
+_ORACLE_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _is_prime(value):
+    if type(value) is not int or value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _normalise_n(n):
+    if type(n) is not int or n < 2:
+        raise ValueError("n must be an integer at least 2")
+    size = max(6, n)
+    while size % 6 or not _is_prime(size + 1):
+        size += 1
+    return size
+
+
+def _catalans(count):
+    values = [1]
+    for size in range(1, count + 1):
+        values.append(sum(values[left] * values[size - 1 - left]
+                          for left in range(size)))
+    return values
+
+
+def _noncrossing_matching(items, rng):
+    """Uniform Catalan matching on an even cyclically ordered list."""
+    if not items:
+        return []
+    pairs = len(items) // 2
+    cats = _catalans(pairs)
+
+    def build(seq):
+        if not seq:
+            return []
+        half = len(seq) // 2
+        choices = []
+        total = 0
+        for left_pairs in range(half):
+            weight = cats[left_pairs] * cats[half - 1 - left_pairs]
+            choices.append((left_pairs, weight))
+            total += weight
+        draw = rng.randrange(total)
+        running = 0
+        chosen = 0
+        for left_pairs, weight in choices:
+            running += weight
+            if draw < running:
+                chosen = left_pairs
+                break
+        partner = 2 * chosen + 1
+        return ([(seq[0], seq[partner])]
+                + build(seq[1:partner])
+                + build(seq[partner + 1:]))
+
+    return build(list(items))
+
+
+def _literal_value(literal, bits):
+    bit = bits[abs(literal) - 1]
+    return bit if literal > 0 else 1 - bit
+
+
+def _bits_satisfy(clauses, bits):
+    for index, clause in enumerate(clauses):
+        if not any(_literal_value(literal, bits) for literal in clause):
+            return False, index
+    return True, None
+
+
+def _class_errors(inst):
+    """Check the exact syntactic and explicit-embedding promises of the family."""
+    errors = []
+    variable_count = inst["num_variables"]
+    expected_variables = set(range(1, variable_count + 1))
+    cycle = inst["variable_cycle"]
+    if len(cycle) != variable_count or set(cycle) != expected_variables:
+        errors.append("variable cycle is not a permutation")
+
+    tagged_variables = []
+    tags = []
+    expected_negative = set()
+    for record in inst["pair_tags"]:
+        first, second = record["variables"]
+        tagged_variables.extend((first, second))
+        tags.append(record["tag"])
+        expected_negative.add(frozenset((-first, -second)))
+    if set(tagged_variables) != expected_variables or len(tagged_variables) != variable_count:
+        errors.append("pair tags do not partition the variables")
+    if sorted(tags) != list(range(1, inst["prime"])):
+        errors.append("pair tags are not all nonzero residues")
+
+    literal_sets = []
+    actual_negative = set()
+    negative_occurrences = [0] * variable_count
+    positive_clauses = []
+    for clause in inst["clauses"]:
+        if len(clause) not in (2, 3):
+            errors.append("clause size is outside 2..3")
+            continue
+        if len(set(map(abs, clause))) != len(clause):
+            errors.append("clause repeats a variable")
+        if not (all(literal > 0 for literal in clause)
+                or all(literal < 0 for literal in clause)):
+            errors.append("clause is not monotone")
+        literal_sets.append(set(clause))
+        if clause[0] < 0:
+            actual_negative.add(frozenset(clause))
+            for literal in clause:
+                negative_occurrences[abs(literal) - 1] += 1
+        else:
+            positive_clauses.append(clause)
+    if actual_negative != expected_negative:
+        errors.append("negative clauses do not match displayed pairs")
+    if any(count > 1 for count in negative_occurrences):
+        errors.append("a variable has more than one negative occurrence")
+
+    for left, literals in enumerate(literal_sets):
+        intersections = 0
+        for right, other in enumerate(literal_sets):
+            if left == right:
+                continue
+            overlap = literals & other
+            if len(overlap) > 1:
+                errors.append("two clauses share more than one signed literal")
+            if overlap:
+                intersections += 1
+        if intersections > 1:
+            errors.append("a clause intersects more than one other clause")
+            break
+
+    # Positive clause components lie in disjoint three-position boundary arcs.
+    if len(cycle) % 3 == 0:
+        position = {variable: index for index, variable in enumerate(cycle)}
+        local_embedding_found = False
+        for offset in range(3):
+            if all(len({((position[variable] - offset) % len(cycle)) // 3
+                        for variable in clause}) == 1
+                   for clause in positive_clauses):
+                local_embedding_found = True
+                break
+        if not local_embedding_found:
+            errors.append("positive components do not occupy disjoint cycle arcs")
+
+    # Pair subdivisions are noncrossing chords on the other side of the cycle.
+    if len(cycle) == variable_count:
+        position = {variable: index for index, variable in enumerate(cycle)}
+        chords = []
+        for record in inst["pair_tags"]:
+            first, second = record["variables"]
+            left, right = sorted((position[first], position[second]))
+            chords.append((left, right))
+        for first_index, (a, b) in enumerate(chords):
+            for c, d in chords[first_index + 1:]:
+                if (a < c < b < d) or (c < a < d < b):
+                    errors.append("displayed negative pairs cross in the cycle")
+                    return errors
+    return errors
+
+
+def _pair_mates(pair_tags):
+    mate = {}
+    for record in pair_tags:
+        first, second = record["variables"]
+        mate[first] = second
+        mate[second] = first
+    return mate
+
+
+def _greedy_one_pass(clauses, pair_tags, num_variables):
+    """The obvious irreversible left-to-right covering heuristic."""
+    bits = [0] * num_variables
+    mate = _pair_mates(pair_tags)
+    for clause in clauses:
+        if clause[0] < 0:
+            continue
+        if any(bits[literal - 1] for literal in clause):
+            continue
+        placed = False
+        for literal in clause:
+            if bits[mate[literal] - 1] == 0:
+                bits[literal - 1] = 1
+                placed = True
+                break
+        if not placed:
+            # Keep the failure explicit rather than silently violating a pair.
+            return "".join(map(str, bits))
+    return "".join(map(str, bits))
+
+
+def make_instance(n, seed=0, or_percent=35, **params):
+    """Construct a satisfying monotone linear planar 3-CNF without solving it."""
+    del params
+    if type(or_percent) is not int or not 0 <= or_percent <= 100:
+        raise ValueError("or_percent must be an integer from 0 through 100")
+    size = _normalise_n(n)
+    prime = size + 1
+    vertex_count = 2 * size // 3
+    rng = random.Random(seed)
+
+    # Three cyclically ordered literal ports per local component.  Boundary
+    # pairs plus a Catalan matching of middle ports are noncrossing.
+    records = []
+    for vertex in range(vertex_count):
+        records.append({
+            "kind": "boundary",
+            "ends": [(vertex, 2), ((vertex + 1) % vertex_count, 0)],
+        })
+    middle = [(vertex, 1) for vertex in range(vertex_count)]
+    for left, right in _noncrossing_matching(middle, rng):
+        records.append({"kind": "middle", "ends": [left, right]})
+    if len(records) != size:
+        raise AssertionError("cubic port construction has the wrong edge count")
+
+    # Orient the middle matching first.  Every uncovered vertex receives its
+    # preceding boundary edge.  Vertex 0 is forced to have a sole incoming edge
+    # so a single-pair corruption is guaranteed to be rejected in G2.
+    heads = {}
+    middle_for_vertex = {}
+    for edge_index in range(vertex_count, size):
+        left, right = records[edge_index]["ends"]
+        middle_for_vertex[left[0]] = edge_index
+        middle_for_vertex[right[0]] = edge_index
+        heads[edge_index] = left if rng.randrange(2) == 0 else right
+    zero_middle = middle_for_vertex[0]
+    zero_ends = records[zero_middle]["ends"]
+    heads[zero_middle] = zero_ends[1] if zero_ends[0][0] == 0 else zero_ends[0]
+
+    covered = {port[0] for port in heads.values()}
+    for vertex in range(vertex_count):
+        if vertex not in covered:
+            heads[(vertex - 1) % vertex_count] = (vertex, 0)
+    heads[0] = (1, 0)
+    heads[vertex_count - 1] = (0, 0)
+    for edge_index in range(vertex_count):
+        if edge_index not in heads:
+            left, right = records[edge_index]["ends"]
+            heads[edge_index] = left if rng.randrange(2) == 0 else right
+
+    incoming = [[] for _ in range(vertex_count)]
+    for edge_index, port in heads.items():
+        incoming[port[0]].append((edge_index, port))
+    if any(not ports for ports in incoming):
+        raise AssertionError("orientation construction left a source")
+
+    # For indegree one the heavy literal points inward; for indegree two we
+    # randomise between the legal heavy-in and both-lights-in modes.
+    heavy_ports = []
+    for vertex in range(vertex_count):
+        in_ports = [port for _edge, port in incoming[vertex]]
+        all_ports = [(vertex, local) for local in range(3)]
+        if len(in_ports) == 1:
+            heavy = in_ports[0]
+        elif len(in_ports) == 2 and rng.randrange(2) == 0:
+            heavy = next(port for port in all_ports if port not in in_ports)
+        else:
+            heavy = rng.choice(in_ports)
+        heavy_ports.append(heavy)
+
+    # Shuffle edge IDs independently of the embedding, and attach every
+    # nonzero residue once.  Truth is sampled first as quadratic-residue class.
+    old_indices = list(range(size))
+    rng.shuffle(old_indices)
+    shuffled_records = [records[index] for index in old_indices]
+    shuffled_heads = [heads[index] for index in old_indices]
+    residues = list(range(1, prime))
+    rng.shuffle(residues)
+    squares = {value * value % prime for value in range(1, prime)}
+    source_bits = [int(tag in squares) for tag in residues]
+
+    port_literal = {}
+    for edge_id, record in enumerate(shuffled_records):
+        head = shuffled_heads[edge_id]
+        bit = source_bits[edge_id]
+        for port in record["ends"]:
+            true_here = port == head
+            source_positive = bool(bit) == bool(true_here)
+            # Theorem 3.2 replaces a negative source literal not-v by v'.
+            final_variable = edge_id + 1 if source_positive else size + edge_id + 1
+            port_literal[port] = final_variable
+
+    positive_clauses = []
+    for vertex in range(vertex_count):
+        heavy = heavy_ports[vertex]
+        lights = [port for port in [(vertex, j) for j in range(3)]
+                  if port != heavy]
+        is_or = vertex != 0 and rng.randrange(100) < or_percent
+        if is_or:
+            positive_clauses.append([
+                port_literal[(vertex, 0)],
+                port_literal[(vertex, 1)],
+                port_literal[(vertex, 2)],
+            ])
+        else:
+            positive_clauses.append([port_literal[heavy], port_literal[lights[0]]])
+            positive_clauses.append([port_literal[heavy], port_literal[lights[1]]])
+
+    pair_tags = [
+        {"variables": [edge_id + 1, size + edge_id + 1],
+         "tag": residues[edge_id]}
+        for edge_id in range(size)
+    ]
+    answer_bits = source_bits + [1 - bit for bit in source_bits]
+
+    # Input order is not geometric order.  Select an ordinary random ordering
+    # on which the obvious one-pass greedy attack fails; this changes no clause.
+    negative_clauses = [[-(edge_id + 1), -(size + edge_id + 1)]
+                        for edge_id in range(size)]
+    clauses = positive_clauses + negative_clauses
+    for _attempt in range(256):
+        trial = [list(clause) for clause in clauses]
+        for clause in trial:
+            rng.shuffle(clause)
+        rng.shuffle(trial)
+        greedy = _greedy_one_pass(trial, pair_tags, 2 * size)
+        greedy_bits = [int(char) for char in greedy]
+        if not _bits_satisfy(trial, greedy_bits)[0]:
+            clauses = trial
+            break
+    else:
+        # This is only a defensive fallback for the tiny demo; shipping sizes
+        # empirically find a failing order almost immediately.
+        clauses = trial
+
+    variable_cycle = [port_literal[(vertex, local)]
+                      for vertex in range(vertex_count) for local in range(3)]
+    if len(set(variable_cycle)) != 2 * size:
+        raise AssertionError("the variable cycle is not a permutation")
+
+    displayed_tags = [dict(record) for record in pair_tags]
+    rng.shuffle(displayed_tags)
+    instance = {
+        "requested_n": n,
+        "n": size,
+        "or_percent": or_percent,
+        "prime": prime,
+        "num_variables": 2 * size,
+        "clauses": clauses,
+        "variable_cycle": variable_cycle,
+        "pair_tags": displayed_tags,
+        "answer": "".join(map(str, answer_bits)),
+    }
+    ok, failed = _bits_satisfy(clauses, answer_bits)
+    if not ok:
+        raise AssertionError(f"constructed friend assignment fails clause {failed + 1}")
+    return instance
+
+
+def render(inst):
+    """Render the complete self-contained task, with hints disabled by default."""
+    tag_rows = []
+    for index in range(0, len(inst["pair_tags"]), 6):
+        chunk = inst["pair_tags"][index:index + 6]
+        tag_rows.append("  " + "  ".join(
+            f"({row['variables'][0]},{row['variables'][1]}):{row['tag']}"
+            for row in chunk))
+    clause_rows = [
+        f"C{index}: " + " ".join(f"{literal:+d}" for literal in clause)
+        for index, clause in enumerate(inst["clauses"], 1)
+    ]
+    cycle_rows = []
+    cycle = inst["variable_cycle"]
+    for index in range(0, len(cycle), 24):
+        cycle_rows.append("  " + " ".join(map(str, cycle[index:index + 24])))
+
+    statement = f"""MONOTONE LINEAR PLANAR SAT
+
+There are {inst['num_variables']} Boolean variables, numbered 1 through
+{inst['num_variables']}.  A positive literal +i has the value of variable i;
+a negative literal -i has the opposite value.  A clause is true when at least
+one of its listed literals is true, and the formula is true when every clause
+is true.
+
+For this problem, 3-CNF means clauses of size at most three, as in the source
+paper; this instance uses clauses of sizes two and three.  Every clause is
+monotone (both signs agree).  The formula is linear in the paper's exact sense:
+each clause, regarded as a set of signed literals, intersects at most one other
+clause and that intersection has size at most one.
+
+The listed VARIABLE CYCLE is a permutation of all variables.  It is part of a
+planar embedding of the variable-clause graph: that bipartite graph has one
+node per variable and clause, incidence edges join clauses to their variables,
+and the cycle edges join consecutive listed variables including last to first.
+Thus this is a monotone linear planar instance in the paper's native regime.
+
+Each PAIR TAG row `(a,b):r` records the two variables in one negative pair
+clause and a distinct nonzero tag r modulo p={inst['prime']}.  Tags are exact
+instance data.  Variable IDs, not tags, index the answer.
+
+PAIR TAGS (first variable, second variable):tag
+{chr(10).join(tag_rows)}
+
+VARIABLE CYCLE (continued lines form one cyclic order)
+{chr(10).join(cycle_rows)}
+
+CLAUSES
+{chr(10).join(clause_rows)}
+
+Return one bit for every variable in increasing ID order: bit i is 1 exactly
+when variable i is TRUE.  The answer must therefore be exactly
+{inst['num_variables']} characters long and contain only 0 and 1.
+
+Give your final answer inside <answer></answer> tags as the raw bitstring.
+Example for four variables: <answer>0101</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Extract a raw binary string from answer tags; never raise on garbage."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json|text)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body).strip()
+    if body.startswith('"') and body.endswith('"'):
+        try:
+            decoded = json.loads(body)
+        except (TypeError, ValueError):
+            return None
+        if not isinstance(decoded, str):
+            return None
+        body = decoded
+    compact = "".join(body.split())
+    return compact if compact and re.fullmatch(r"[01]+", compact) else None
+
+
+def verify(inst, answer):
+    """Check any submitted assignment directly; never consult inst['answer']."""
+    if not isinstance(answer, str):
+        return False, "answer must be a raw bitstring"
+    if not answer:
+        return False, "answer is empty"
+    expected = inst["num_variables"]
+    if len(answer) < expected:
+        return False, f"answer is too short: expected {expected} bits"
+    if len(answer) > expected:
+        return False, f"answer is too long: expected {expected} bits"
+    for position, char in enumerate(answer, 1):
+        if char not in "01":
+            return False, f"non-binary character at position {position}"
+    bits = [int(char) for char in answer]
+    for index, clause in enumerate(inst["clauses"], 1):
+        if not any(_literal_value(literal, bits) for literal in clause):
+            kind = "positive" if clause[0] > 0 else "negative"
+            return False, f"{kind} clause C{index} is false"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample uniformly after enforcing every displayed negative pair clause."""
+    bits = [0] * inst["num_variables"]
+    for record in inst["pair_tags"]:
+        first, second = record["variables"]
+        state = rng.randrange(3)
+        if state == 1:
+            bits[first - 1] = 1
+        elif state == 2:
+            bits[second - 1] = 1
+    return "".join(map(str, bits))
+
+
+def search_space(inst):
+    return 3 ** inst["n"]
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > _ENUMERATION_CAP:
+        return None
+    count = 0
+    pairs = [record["variables"] for record in inst["pair_tags"]]
+    for states in itertools.product(range(3), repeat=len(pairs)):
+        bits = [0] * inst["num_variables"]
+        for state, (first, second) in zip(states, pairs):
+            if state == 1:
+                bits[first - 1] = 1
+            elif state == 2:
+                bits[second - 1] = 1
+        if verify(inst, "".join(map(str, bits)))[0]:
+            count += 1
+    return count
+
+
+def _solve_dpll(inst, node_budget=1_000_000):
+    """Unit-propagating DPLL, returning (answer, measured search statistics)."""
+    clauses = inst["clauses"]
+    assignment = [-1] * inst["num_variables"]
+    nodes = 0
+    literal_checks = 0
+
+    def search():
+        nonlocal nodes, literal_checks
+        nodes += 1
+        if nodes > node_budget:
+            return None
+        trail = []
+        while True:
+            unit = None
+            all_satisfied = True
+            for clause in clauses:
+                clause_satisfied = False
+                unassigned = []
+                for literal in clause:
+                    literal_checks += 1
+                    value = assignment[abs(literal) - 1]
+                    if value < 0:
+                        unassigned.append(literal)
+                    elif (value == 1) == (literal > 0):
+                        clause_satisfied = True
+                        break
+                if clause_satisfied:
+                    continue
+                all_satisfied = False
+                if not unassigned:
+                    for variable in reversed(trail):
+                        assignment[variable] = -1
+                    return False
+                if len(unassigned) == 1:
+                    unit = unassigned[0]
+                    break
+            if all_satisfied:
+                return assignment[:]
+            if unit is None:
+                break
+            variable = abs(unit) - 1
+            value = int(unit > 0)
+            if assignment[variable] >= 0 and assignment[variable] != value:
+                for changed in reversed(trail):
+                    assignment[changed] = -1
+                return False
+            if assignment[variable] < 0:
+                assignment[variable] = value
+                trail.append(variable)
+
+        scores = [0] * len(assignment)
+        for clause in clauses:
+            if any(assignment[abs(literal) - 1] >= 0
+                   and ((assignment[abs(literal) - 1] == 1) == (literal > 0))
+                   for literal in clause):
+                continue
+            for literal in clause:
+                variable = abs(literal) - 1
+                if assignment[variable] < 0:
+                    scores[variable] += 1
+        variable = max(range(len(assignment)),
+                       key=lambda item: scores[item] if assignment[item] < 0 else -1)
+        for value in (1, 0):
+            assignment[variable] = value
+            result = search()
+            if result not in (False, None):
+                return result
+            if result is None:
+                assignment[variable] = -1
+                for changed in reversed(trail):
+                    assignment[changed] = -1
+                return None
+        assignment[variable] = -1
+        for changed in reversed(trail):
+            assignment[changed] = -1
+        return False
+
+    result = search()
+    stats = {
+        "nodes": nodes,
+        "literal_checks": literal_checks,
+        "operations": nodes + literal_checks,
+        "node_budget": node_budget,
+    }
+    if result in (False, None):
+        return None, stats
+    answer = "".join(map(str, result))
+    if not verify(inst, answer)[0]:
+        raise AssertionError("DPLL produced a false assignment")
+    return answer, stats
+
+
+def _quadratic_residue_answer(inst):
+    squares = {value * value % inst["prime"]
+               for value in range(1, (inst["prime"] - 1) // 2 + 1)}
+    bits = [0] * inst["num_variables"]
+    for record in inst["pair_tags"]:
+        first, second = record["variables"]
+        bits[first - 1] = int(record["tag"] in squares)
+        bits[second - 1] = 1 - bits[first - 1]
+    return "".join(map(str, bits))
+
+
+def _wl_key(inst):
+    """Relabelling-invariant WL signature of all semantic instance relations."""
+    variables = inst["num_variables"]
+    clauses = inst["clauses"]
+    total = variables + len(clauses)
+    adjacency = [[] for _ in range(total)]
+    raw_edges = []
+
+    tags = {}
+    roles = {}
+    for record in inst["pair_tags"]:
+        first, second = record["variables"]
+        tags[first] = tags[second] = record["tag"]
+        roles[first], roles[second] = 0, 1
+        raw_edges.append((first - 1, second - 1, "pair"))
+
+    initial = [("V", tags[index], roles[index])
+               for index in range(1, variables + 1)]
+    for clause in clauses:
+        initial.append(("C", len(clause), 1 if clause[0] > 0 else -1))
+    for clause_index, clause in enumerate(clauses):
+        clause_node = variables + clause_index
+        for literal in clause:
+            raw_edges.append((abs(literal) - 1, clause_node,
+                              "occ+" if literal > 0 else "occ-"))
+    cycle = inst["variable_cycle"]
+    for index, variable in enumerate(cycle):
+        following = cycle[(index + 1) % len(cycle)]
+        raw_edges.append((variable - 1, following - 1, "cycle"))
+    for left, right, edge_type in raw_edges:
+        adjacency[left].append((edge_type, right))
+        adjacency[right].append((edge_type, left))
+
+    palette = {signature: index for index, signature
+               in enumerate(sorted(set(initial), key=repr))}
+    colors = [palette[signature] for signature in initial]
+    for _round in range(total + 1):
+        signatures = []
+        for vertex in range(total):
+            neighborhood = tuple(sorted(
