+                if intersections > 1:
+                    return False, f"clause {i + 1} intersects multiple clauses"
+        # A previous clause may also intersect i, so count all earlier neighbors.
+        intersections += sum(bool(left & clauses[j]) for j in range(i))
+        if intersections > 1:
+            return False, f"clause {i + 1} intersects multiple clauses"
+    return True, "ok"
 
