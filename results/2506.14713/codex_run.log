def prism(r):
 V=2*r; e=[]
 for layer in range(2):
  off=layer*r
  e += [(off+i, off+(i+1)%r) for i in range(r)]
 e += [(i,r+i) for i in range(r)]
 return V,e

def indeg(V,e,a):
 d=[0]*V
 for i,(u,v) in enumerate(e): d[v if a[i] else u]+=1
 return d

def legal(V,e,a): return min(indeg(V,e,a))>=1

