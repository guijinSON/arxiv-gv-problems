\newcommand{\edgeweighttwo}[2]{\tikz[baseline=-1mm]{
		\node[inner sep=0.1mm] (a) at (0.8, 0) {$#1$};
		\draw (0, 0) edge[two weig edge] node[above] {$#2$} (a);}
