import random

def inst(r,seed):
 # nodes top 0..r-1 AND, bottom r..2r-1 OR
 e=[];w=[];a=[]
 # top cycle edges i-(i+1), orient odd -> even (r even): if i even, edge next odd -> i => bit0; if i odd -> next even bit1
 for i in range(r):e.append((i,(i+1)%r));w.append(1);a.append(0 if i%2==0 else 1)
 # bottom ring clockwise
 for i in range(r):e.append((r+i,r+(i+1)%r));w.append(2);a.append(1)
 # spokes top->bottom if top even, bottom->top if top odd
 for i in range(r):e.append((i,r+i));w.append(2);a.append(1 if i%2==0 else 0)
 inc=[[]for _ in range(2*r)]
