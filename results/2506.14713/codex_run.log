import random

def cats(n):
 c=[1]*(n+1)
 for i in range(1,n+1): c[i]=sum(c[j]*c[i-1-j] for j in range(i))
 return c
C=cats(250)
def tri(poly,rng):
 out=set(); stack=[poly]
 while stack:
  p=stack.pop(); m=len(p)
  if m<=3: continue
  ws=[C[k-1]*C[m-k-2] for k in range(1,m-1)]
  x=rng.randrange(sum(ws)); s=0
  for kk,w in enumerate(ws,1):
   s+=w
   if x<s: k=kk;break
  if k>1: out.add(tuple(sorted((p[0],p[k]))))
  if k<m-2: out.add(tuple(sorted((p[k],p[-1]))))
  stack.append(p[:k+1]); stack.append(p[k:])
 return out
