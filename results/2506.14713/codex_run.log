import importlib.util,json
p='results/2506.14713/gen_2506_14713.py'
s=importlib.util.spec_from_file_location('m',p);m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
rows=[json.loads(x) for x in open('artifacts/2506.14713.jsonl') if x.strip()]
keys=[]
for r in rows:
 i=m.make_instance(**r['params']);ok,why=m.verify(i,r['answer']);
 if not ok: raise SystemExit(why)
 keys.append(m.canonical_key(i))
print('verified',len(rows),'distinct_keys',len(set(keys)))
print('difficulty_order',list(m.DIFFICULTY),'shipping',m.SHIPPING_DIFFICULTY)
print('render_parse_example',m.parse_answer('<answer>3, 17, 17, 42</answer>'))
print('report_all_passed',json.load(open('results/2506.14713/selftest_report.json'))['all_passed'])
