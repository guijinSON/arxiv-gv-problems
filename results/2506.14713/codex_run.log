   472	
   473	\begin{theorem}
   474	    Let $I = (G=(V,E),V')$. If $I$ has a \specialInst $E'$ %
   475	     then a $V'$-cycle $\acycle$ can be computed in poly-time that separates 
   476	     %
   477	      $E'$ from~$E \setminus E'$.
   478	    \label{th:pi_constructible_for_edge_coll_instance}
   479	\end{theorem}
   480	\begin{proof}
   481	The proof consists in building an embedding of a kite-graph $\gvf$.
   482	    Let $G_{E'}^* := G^* \edgedeletion \bijectionedgetodualG(E \setminus E')$.
   483	    Since $E'$ is a \specialInst, by \Cref{def:SepcialInst}, $G_{E'}^*$ is planar and connected. 
   484	    Consider the planar 
   485	    %
   486	    embeddings $\Gamma_{G_{E'}^*}$ and $\Gamma_G$ (Definition \ref{def:planar_embedding}).
   487	    
   488	    \paragraph{Definition of the graph $K_I$}
   489	    The set of vertices of $K_I$ is $V' \cup \set{\text{vertices of $G_{E'}^*$}}$. Edges of $K_I$ are obtained as follows.
   490	    Each edge $FF'$ in $G_{E'}^*$ corresponds to an edge $uv \in E'$. 
   491	    For each edge $FF'$ in $G_{E'}^*$, the four edges $e_1 = Fu,  e_2 = uF',
   492	        e_3 = Fv, e_4 = vF'$ are in $K_I$.
   493	        
   494	        
   495	     \paragraph{Definition of the embedding $\Gamma_{K_I}$}   
   496	        The embedding $\Gamma_{K_I}$ of $K_I$ is obtained from $\Gamma_{G_{E'}^*}$. We first add the edges $e_1, e_2, e_3, e_4$ for each edge $FF'$ 
   497	    (see the operation of edge addition on embedding, \Cref{def:edge_addition}).
   498	    Those edges $e_1, e_2, e_3, e_4$ form two faces in $\Gamma_{G_{E'}^*}'$:
   499	    $\gvfface^1 = (e_1,e_2,FF')$ and $\gvfface^2 = (e_4,e_3,FF')$.
   500	    Since $FF'$ touches two different faces $\gvfface^1$ and $\gvfface^2$, we can remove $FF'$ from $\Gamma_{G_{E'}^*}'$ (\Cref{def:edge_deletion}).
   501	    This deletion implies that $\gvfface^1$ and $\gvfface^2$ are merged into the face $\gvfface_{uv} = (e_1,e_2,e_3,e_4)$
   502	    %
   503	     (Property \ref{prop:edge_contraction}). We obtain an embedding of $\Gamma_{K_I}$.
   504	    Since our edge addition and edge deletion preserve planarity and connectivity (Property \ref{prop:operations_preserve_planar_and_conn}), $\Gamma_{K_I}$ is planar and connected (see for instance the Figure~\ref{fig:face_embedded_graph_after_vertex_contraction}).
   505	    
   506	    
   507	    \paragraph{Proof that $K_I$ is a kite-graph}
   508	    The graph $K_I$ is bipartite: edges in $K_I$ are between a vertex in $V'$ and a vertex of $G^*_{E'}$. 
   509	    
   510	    Consider a vertex in $V'$. 
   511	    By \Cref{def:SepcialInst}, each vertex $v$ in $V'$ either appears in some edge in $E'$ and then is linked to two $G$-faces $F$ and $F'$. So $\degree{K_I}(v) = 2$ (point 3 in \Cref{def:kitegraph}).
   512	    
   513	    Moreover a vertex $F$ is of even degree since $F$ is linked to one or multiple pairs of $u$ and $v$ such that $uv \in E'$. Thus $K_I$ is Eulerian (point 2 in \Cref{def:kitegraph}).
   514	    
   515	    
   516	    
   517	    
   518	    $K_I \cup G$ is obtained from $G$ by adding fresh vertices $F, F'$ etc. located inside $G$-faces, and edges from vertices in $V'$ to these fresh vertices. So
   519	    $K_I \cup G$ is planar.
   520	    
   521	    
   522	%
   523	%
   524	    
   525	    
   526	    \paragraph{About colors}
   527	    Recall that $K_I$ is a kite-graph. By~\Cref{prop:bipartite_dual_eulerian}, $K^*_I$ is bipartite hence 2-colorable. Consider a coloring of $K^*_I$. Let us prove that $E'$ are located in red faces while $E \setminus E'$ are in blue faces (up to renaming the colors).
   528	    
   529	    Given $uv \in E'$, let $\gvfface_{uv}$ be the $K_I$-face in which the edge $uv$ is located. Let us prove that $\gvfface_{uv}$ are all of the same color -- let say red.
   530	    
   531	    Suppose that there exists $K_I$-faces $\gvfface_{uv}$ and $\gvfface_{u'''v'''}$ of different colors with $uv, u'''v''' \in E'$. As $G^*_{E'}$ is connected (see~\Cref{fig:dualg_edge_coll}), there is a path linking the dual edge of $uv$ to the dual edge of $u'''v''''$:
   532	    
   533	    
   534	    \newcommand\drawdiamond[3]{
   535	    	\draw[#3] (0, 0) -- (1, 0.5) -- (2, 0) -- (1, -0.5) -- cycle;
   536	    	\node[inVprime] (u) at (1, 0.5) {$#1$};
   537	    	\node[inVprime] (v) at (1, -0.5) {$#2$};
   538	    	\node[dual] (a) at (0, 0) {};
   539	    	\node[dual] (b) at (2, 0) {};
   540	    	\draw[paired] (u) -- (v);
   541	    	\draw[dual] (a) -- (b);
   542	    	\draw[kite] (u) to (b) to (v) to (a) to (u);
   543	    }
   544	    
   545	    \begin{center}
   546	    \begin{tikzpicture}
   547	    	\drawdiamond uv{redface}
   548	    	\begin{scope}[xshift=2cm]
   549	    	\drawdiamond {}{}{redface}
   550	       	\node at (4, 0) {$\dots$};
   551	       	\end{scope}
   552	   		 	    	
   553	    	\begin{scope}[xshift=10cm]
   554	    	\drawdiamond {u'''}{v'''}{blueface}
   555	       	\end{scope}
   556	    \end{tikzpicture}
   557	    \end{center}
   558	     Along this path, there are two consecutive dual edges of $u'v'$ and $u''v''$ in $E'$ with $\gvfface_{u'v'}$ and $\gvfface_{u''v''}$ of different colors:
   559	     
   560	    \begin{center}
   561	     \begin{tikzpicture}
   562	     	\drawdiamond {u'}{v'}{redface}
   563	     	\begin{scope}[xshift=2cm]
   564	     	\drawdiamond {u''}{v''}{blueface}
   565	       	\end{scope}
   566	     \end{tikzpicture}
   567	     \end{center}    
   568	     
   569	      The faces $\gvfface_{u'v'}$ and $\gvfface_{u''v''}$ are around a common vertex $F$. We now consider the faces around $F$ in clockwise-order. There are three consecutive faces around $F$ in the clockwise order of the form $\gvfface_{u^1v^1}$, $\gvfface_{other}$, $\gvfface_{u^2v^2}$ with $\gvfface_{u^1v^1}$ and $\gvfface_{u^2v^2}$ of different colors with $u^1v^1, u^2v^2 \in E'$, and $\gvfface_{other}$ is a $K_I$-face in which no edge of $E'$ is located\footnote{Consecutive $K_I$-faces of the form $\gvfface_{u^1v^1}$ and $\gvfface_{u^2v^2}$ in the clockwise order is impossible because $E'$ is a matching.}. W.l.o.g. $\gvfface_{u^1v^1}$ is red and $\gvfface_{u^2v^2}$ is blue:
   570	      W.l.o.g. $\gvfface_{other}$ is red.
   571	           
   572	          \begin{center}
   573	           \begin{tikzpicture}[scale=1.5]
   574	           \draw[redface] (0, 0) -- (120:2cm) -- (60:2cm) -- cycle;
   575	           \node at (0, 1) {$\gvfface_{other}$};
   576	           	\begin{scope}[rotate=150]
   577	           	\drawdiamond {u_1}{v_1}{redface}
   578	           	\end{scope}
   579	           	\begin{scope}[rotate=30]
   580	           	\drawdiamond {u_2}{v_2}{blueface}
   581	           	\end{scope}
   582	           \end{tikzpicture}
   583	           \end{center}    
   584	           
   585	      
   586	        Contradiction because $\gvfface_{u^1v^1}$ and $\gvfface_{other}$ are of the same color.
   587	    We conclude that all $\gvfface_{e}$ with $e \in E'$ are all red.
   588	    
   589	    
   590	    Thus edges in $E'$ are red while those in $E \setminus E'$ are blue. By \Cref{th:construct_cycle_poly_time}, a $V'$-cycle~$\pi$ is constructible in polynomial time such that $\pi$ separates $E'$ from $E \setminus E'$.
   591	\end{proof}
   592	
   593	We are now ready to present our results on the hardness of reconfigurations problems in the next section.
   594	We will prove the PSPACE-hardness of the linear-literal planar 3-SAT and linear planar 3-SAT reconfiguration problems
   595	crucially applying \Cref{th:pi_constructible_for_edge_coll_instance}.

