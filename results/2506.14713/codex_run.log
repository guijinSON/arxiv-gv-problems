+def _formula_index(clauses: list[list[int]], q: int) -> tuple[list[list[int]], list[tuple[int, int]]]:
+    occurrence = [[] for _ in range(q)]
+    masks: list[tuple[int, int]] = []
+    for ci, clause in enumerate(clauses):
+        pos = 0
+        neg = 0
+        for lit in clause:
