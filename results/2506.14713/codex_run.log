import random,time,sys
sys.setrecursionlimit(10000)

def sample_tri(n,rng,forbid=frozenset()):
 T=[[0]*n for _ in range(n)]
 for i in range(n-1): T[i][i+1]=1
 def allowed(a,b): return b==a+1 or (a==0 and b==n-1) or (a,b) not in forbid
 for span in range(2,n):
  for i in range(n-span):
   j=i+span; s=0
   for k in range(i+1,j):
    if allowed(i,k) and allowed(k,j): s += T[i][k]*T[k][j]
   T[i][j]=s
 if not T[0][n-1]: return None
 out=set(); st=[(0,n-1)]
 while st:
  i,j=st.pop()
  if j-i<2: continue
  opts=[]; total=0
  for k in range(i+1,j):
   if allowed(i,k) and allowed(k,j):
    w=T[i][k]*T[k][j]
    if w: opts.append((k,w));total+=w
  x=rng.randrange(total); s=0
  for k,w in opts:
   s+=w
   if x<s: break
  if k>i+1: out.add((i,k))
  if j>k+1: out.add((k,j))
  st.append((i,k));st.append((k,j))
 return out

def make(n,seed):
 rng=random.Random(seed)
 a=sample_tri(n,rng)
 b=sample_tri(n,rng,a)
 cyc=[(i,(i+1)%n) for i in range(n)]
 es={tuple(sorted(e)) for e in cyc}|a|b
