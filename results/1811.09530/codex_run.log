    "anthropic/claude-sonnet-5",
    "google/gemini-3.1-pro-preview",
    "x-ai/grok-4.6",
]
ORACLE_POOL = [m.strip() for m in os.environ.get(
    "ORACLE_POOL", ",".join(DEFAULT_POOL)).split(",") if m.strip()]

ORACLE_EFFORT = os.environ.get("ORACLE_EFFORT", "medium")
