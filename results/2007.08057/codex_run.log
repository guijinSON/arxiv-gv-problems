+        # A coordinate permutation relabels every x and every pendant P_x.
+        if flags & 2:
+            order = list(range(d))
+            rng.shuffle(order)
+            rows = [_permute_bits(x, order) for x in rows]
+            w = _permute_bits(w, order)
