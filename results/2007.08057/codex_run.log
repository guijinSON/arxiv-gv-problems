   147	
   148	def _parity(x: int) -> int:
   149	    return x.bit_count() & 1
   150	
   151	
   152	def _rank_bits(rows: list[int], d: int) -> int:
   153	    """Rank of integer-encoded row vectors over GF(2)."""
   154	
   155	    basis = [0] * d
   156	    rank = 0
   157	    for value in rows:
   158	        x = value
   159	        while x:
   160	            p = x.bit_length() - 1
   161	            if basis[p]:
   162	                x ^= basis[p]
   163	            else:
   164	                basis[p] = x
   165	                rank += 1
   166	                break
   167	    return rank
