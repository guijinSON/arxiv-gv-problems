+        "checks": planted_checks,
+        "failures": planted_failures,
+    }
+
+    inst = make_instance(seed=19, **shipping)
+    answer = inst["answer"]
+    corruptions = {
+        "drop": answer[:1],
+        "swap": [answer[1], answer[0]],
+        "duplicate": [answer[0], answer[0]],
+        "empty": [],
