   645	
   646	def _relabel_variants(inst, seed: int) -> list[dict]:
   647	    """All nonempty compositions of three genuine graph relabellings."""
   648	
   649	    d = inst["dimension"]
   650	    width = inst["hex_width"]
   651	    original_rows = [int(s, 16) for s in inst["generators"]]
   652	    original_w = int(inst["answer"][0], 16)
   653	    original_side = inst["answer"][1]
   654	    variants = []
   655	
   656	    for flags in range(1, 8):
   657	        rows = list(original_rows)
   658	        w = original_w
   659	        side = original_side
   660	        rng = random.Random(seed ^ flags)
   661	
   662	        # Reordering generators does not change the edge set.
   663	        if flags & 1:
   664	            rng.shuffle(rows)
   665	
   666	        # A coordinate permutation relabels every x and every pendant P_x.
   667	        if flags & 2:
   668	            order = list(range(d))
   669	            rng.shuffle(order)
   670	            rows = [_permute_bits(x, order) for x in rows]
   671	            w = _permute_bits(w, order)
   672	
   673	        # An affine relabelling combines the invertible shear y_i=x_i+x_j
   674	        # with a translation. The dual functional changes by w'_j=w_j+w_i;
   675	        # translation flips the named side when its inner product is one.
   676	        if flags & 4:
   677	            i = rng.randrange(d)
   678	            j = rng.randrange(d - 1)
   679	            if j >= i:
   680	                j += 1
   681	
   682	            def shear(x):
   683	                return x ^ ((1 << i) if ((x >> j) & 1) else 0)
   684	
   685	            rows = [shear(x) for x in rows]
   686	            if (w >> i) & 1:
   687	                w ^= 1 << j
   688	            translation = rng.getrandbits(d)
   689	            side ^= _parity(w & translation)
   690	
   691	        transformed = dict(inst)
   692	        transformed["generators"] = [format(x, f"0{width}x") for x in rows]
   693	        transformed["answer"] = [format(w, f"0{width}x"), side]
   694	        variants.append(transformed)
   695	    return variants
   696	
   697	
   698	def _answer_atoms(value) -> int:
   699	    if isinstance(value, dict):
   700	        return sum(_answer_atoms(v) for v in value.values())

