+            rrng.shuffle(mapping)
+            moved = _relabel_instance(base, mapping)
+            invariant_checks += 1
+            invariant_ok &= canonical_key(moved) == base_key
+            carried_checks += 1
+            carried_ok &= verify(moved, moved["answer"])[0]
+    distinct = len(set(original_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant_ok and carried_ok and distinct == 20,
+        "invariance_passed": invariant_ok,
+        "invariance_checks": invariant_checks,
+        "carried_witness_passed": carried_ok,
+        "carried_witness_checks": carried_checks,
+        "distinct_unrelated": distinct,
+        "unrelated_attempts": 20,
+        "invariant_kind": "canonical 1-WL colour quotient",
+    }
+
+    answer_blob = json.dumps(shipping["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(shipping["answer"])
+    intended_ops = 2 * shipping["n"] + shipping["k"]
+    hinted_rate = G9_ARM_RESULTS["hinted"]["solved"] / max(1, G9_ARM_RESULTS["hinted"]["attempts"])
+    placebo_rate = G9_ARM_RESULTS["placebo"]["solved"] / max(1, G9_ARM_RESULTS["placebo"]["attempts"])
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": G9_ARM_RESULTS,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": "diagnostic_only",
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_gates_pass"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

