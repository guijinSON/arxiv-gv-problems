   594	
   595	def _attack_candidates(inst, seed: int) -> dict[str, list[object]]:
   596	    d = inst["dimension"]
   597	    width = inst["hex_width"]
   598	    rows = [int(s, 16) for s in inst["generators"]]
   599	
   600	    # Per-row statistics: try every displayed element itself, ordered from the
   601	    # largest Hamming-weight outlier inward.
   602	    outliers = sorted(rows, key=lambda x: abs(x.bit_count() - d / 2), reverse=True)
   603	    outlier_candidates = [[format(x, f"0{width}x"), 0] for x in outliers]
   604	
   605	    # A left-to-right, no-elimination pivot rule that a solver can execute from
   606	    # the displayed equations but that ignores interactions with later rows.
   607	    greedy_w = 0
   608	    assigned = 0
   609	    for row in rows:
   610	        free = row & ~assigned
   611	        if free:
   612	            bit = free & -free
   613	            if _parity(greedy_w & row) == 0:
   614	                greedy_w ^= bit
   615	            assigned |= bit
   616	    greedy = [[format(greedy_w or 1, f"0{width}x"), 0]]
   617	
   618	    ones = (1 << d) - 1
   619	    even_xor = _xor_all(rows[::2]) or 1
   620	    first_half = _xor_all(rows[: len(rows) // 2]) or 1
   621	    obvious = [
   622	        [format(ones, f"0{width}x"), 0],
   623	        [format(even_xor, f"0{width}x"), 0],
   624	        [format(first_half, f"0{width}x"), 0],
   625	    ]
   626	    obvious.extend([[format(1 << j, f"0{width}x"), 0] for j in range(d)])
   627	
   628	    rng = random.Random(seed ^ 0xC1A57E2)
   629	    restarts = [random_candidate(inst, rng) for _ in range(256)]
   630	    return {
   631	        "outlier_generator_as_functional": outlier_candidates,
   632	        "greedy_pivot_without_elimination": greedy,
   633	        "random_restart_256": restarts,
   634	        "obvious_allones_units_partial_xors": obvious,
   635	    }
