   405	def random_candidate(inst, rng) -> object:
   406	    """Uniform candidate from the stated nonzero-functional/side language."""
   407	
   408	    d = inst["dimension"]
   409	    w = rng.randrange(1, 1 << d)
   410	    return [format(w, f"0{inst['hex_width']}x"), rng.randrange(2)]
