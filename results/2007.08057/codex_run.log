+        remaining = ((1 << n) - 1) & ~mask
+        unseen = remaining
+        cluster_ok = True
+        while unseen and cluster_ok:
+            bit = unseen & -unseen
+            first = bit.bit_length() - 1
+            component = 0
+            frontier = bit
+            unseen ^= bit
+            while frontier:
+                component |= frontier
+                step = frontier
+                neighbors = 0
+                while step:
+                    b = step & -step
+                    v = b.bit_length() - 1
+                    neighbors |= rows[v]
+                    probes += rows[v].bit_count()
+                    step ^= b
+                frontier = neighbors & unseen
+                unseen &= ~frontier
+            step = component
+            while step:
+                b = step & -step
+                v = b.bit_length() - 1
+                probes += component.bit_count() - 1
+                if (component ^ b) & ~rows[v]:
