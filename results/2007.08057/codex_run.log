+
+def _cluster_remainder(rows: list[int], removed: int, n: int) -> tuple[bool, str]:
+    remaining = ((1 << n) - 1) & ~removed
+    unseen = remaining
+    while unseen:
+        first_bit = unseen & -unseen
+        component = 0
+        frontier = first_bit
+        unseen ^= first_bit
+        while frontier:
+            component |= frontier
+            neighbors = 0
+            scan = frontier
+            while scan:
+                bit = scan & -scan
+                v = bit.bit_length() - 1
+                neighbors |= rows[v]
