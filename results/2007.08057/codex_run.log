   511	def canonical_key(inst) -> str:
   512	    """Hash a structural invariant, never the seed, answer, or rendering."""
   513	
   514	    blob = json.dumps(_canonical_invariant(inst), sort_keys=True, separators=(",", ":"))
   515	    return "gf2-cayley-pendant:" + hashlib.sha256(blob.encode()).hexdigest()
