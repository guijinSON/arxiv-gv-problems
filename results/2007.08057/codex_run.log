+        # A coordinate permutation relabels every x and every pendant P_x.
+        if flags & 2:
+            order = list(range(d))
+            rng.shuffle(order)
+            rows = [_permute_bits(x, order) for x in rows]
+            w = _permute_bits(w, order)
+
+        # Invertible shear y_i=x_i+x_j. The dual functional changes by
+        # w'_j=w_j+w_i, which carries the same deletion set through relabelling.
+        if flags & 4:
