+def escalate(params) -> dict | str | None:
+    """Increase equation crowding and then dimension while the route stays <=300."""
+
+    p = {k: v for k, v in dict(params).items() if k != "_preset"}
+    n = int(p["n"])
+    m = int(p.get("m", 3 * n))
