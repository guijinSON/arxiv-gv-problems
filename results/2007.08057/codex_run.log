+"""Verified generator for hitting cliques in chordal, 2P3-free graphs.
+
+The problem family is the constructive object of Lemma 4 in Section 2.2 of
+Aprile--Drescher--Fiorini--Huynh, "A Tight Approximation Algorithm for the
+Cluster Vertex Deletion Problem" (arXiv:2007.08057).  A hitting clique is a
+clique whose deletion leaves a disjoint union of cliques.
+
+Instances are inverse-generated: choose the hitting clique first, assemble
+nested clique blocks around it, and finally relabel every vertex.  No solver is
+used to obtain ``inst["answer"]``.  The module is standard-library-only,
+performs no I/O, and is deterministic for fixed arguments.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from typing import Any
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "chordal induced-2P3-free graph",
+        "hitting clique (a vertex subset)",
+    ],
+    "verification_operations": [
+        "exact graph adjacency tests",
+        "connected-component traversal",
+        "component completeness checks",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "Recognize the nested maximal-clique decomposition and its common clique "
+        "separator; without it one must construct and orient a clique tree."
+    ),
+    "hardness_basis": (
+        "Track B: the proof of Lemma 4 and the Section 3 analysis give a "
+        "clique-tree orientation algorithm taking O(N^3) time; the bundled "
+        "reference implementation succeeds on every shipping instance, while "
+        "its measured wall-clock and adjacency-probe counts are recorded by "
+        "selftest(), and the nested-block route uses at most 276 exact decisions."
+    ),
+    "max_answer_tokens": 30,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An unordered set of exactly k distinct vertex labels from 0..N-1, "
+        "serialized as a JSON integer array; the set must itself be a clique."
+    ),
+    "bounds": {"cardinality": "instance k", "labels": "0..N-1", "repeats": 0},
+}
+
+DIFFICULTY = {
+    "demo": {"n": 8, "witness_size": 3},
+    "easy": {"n": 56, "witness_size": 20},
+    "medium": {"n": 88, "witness_size": 20},
+    "hard": {"n": 128, "witness_size": 20},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The maximal cliques have a nested, path-like decomposition around one common clique separator."
+)
+PLACEBO_HINT = (
+    "The vertex labels are arbitrary, so keep careful track of each submitted index."
+)
+
+# Filled from isolated harden.py runs.  These are diagnostics, never gates.
+G9_ARM_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
+}
+
+NOTES = r"""
+Definition and theorem source.  The Introduction defines a cluster graph as a
+disjoint union of cliques and a hitting set X by the condition that G-X is a
+cluster graph; equivalently X hits every induced P3.  Section 2.2 then defines a
+hitting clique and Lemma 4 proves that every chordal, induced-2P3-free graph
+contains one.  The proof constructs a clique tree, orients each tree edge
+towards its non-cluster side, and takes a sink clique.  The generated task asks
+for exactly this native graph object.
+
+Step-0 algorithm audit.  This cannot be Track A.  Lemma 4 explicitly says the
+hitting clique is polynomial-time constructible, and the proof of Lemma 8 in
+Section 3 bounds the relevant clique-tree construction by O(N^3).  The paper
+also records 1.811^k n^{O(1)} FPT and O(1.488^n) exact algorithms for general
+Cluster Vertex Deletion, as well as its O(N^4) 2-approximation.  Here the
+reference clique-tree/PEO algorithm is therefore expected to solve every
+instance and is reported separately.  Track B measures the gap between that
+mechanical scan and recognizing the deliberately nested clique blocks.
+
+Generation.  A clique K is sampled first.  The remaining vertices are split
+into two cliques C0,C1 with no edges between them.  Each outside vertex receives
+a threshold t in {1,...,|K|}; after ordering K as k1,...,kk, it is adjacent to
+ki exactly when i>t.  Thus every K-to-Cj neighborhood is nested.  K is a known
+hitting clique because deleting it leaves C0 disjoint from C1.  The graph is
+chordal: an induced cycle cannot use both outside cliques (two K vertices would
+give a chord), and within K union Cj nested cross-neighborhoods forbid an
+induced C4.  Every induced P3 meets K, so two disjoint induced P3s have an edge
+between their K vertices; hence the graph is induced-2P3-free.  A final uniform
+vertex relabelling removes positional information.  Seed-dependent block sizes
+and threshold multiplicities give genuinely non-isomorphic instances.
+
+Attack defenses.  The stored clique spans the full degree range, while the two
+outside cliques overlap its middle degrees; taking degree outliers fails.  The
+same overlap defeats largest-first clique greed.  Random restarts sample the
+statement-aware k-subset language.  The in-context degree-band ansatz chooses
+the k vertices nearest the median degree and also fails.  Unlike these attacks,
+the reference algorithm enumerates maximal cliques from a perfect-elimination
+ordering and tests the cluster remainder, so it succeeds as Track B requires.
+
+Canonicalization.  Vertex labels are the only relabelling symmetry exposed by
+the statement.  canonical_key performs canonical 1-dimensional Weisfeiler--
+Leman refinement from degrees and hashes the resulting colour quotient (class
+sizes and all between-class edge counts).  It is invariant under every vertex
+permutation.  This is an invariant, not a complete graph canonizer, so in
+principle non-isomorphic graphs can collide; the 20-seed distinctness test is
+reported and passes for the shipping distribution.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def _validate_params(n: int, witness_size: int, extra: dict[str, Any]) -> None:
+    if extra:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(extra)))
+    if type(n) is not int or type(witness_size) is not int:
+        raise ValueError("n and witness_size must be integers")
+    if witness_size < 3:
+        raise ValueError("witness_size must be at least 3")
+    if n < 2 * witness_size + 2:
+        raise ValueError("n must be at least 2*witness_size+2")
+    if n > 800:
+        raise ValueError("n above 800 makes the inline edge list excessive")
+
+
+def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
+    """Inverse-generate a promised graph and its hitting-clique witness.
+
+    ``n`` is the number of vertices.  Increasing it grows the ambient graph and
+    the number of decoy clique vertices while ``witness_size`` stays fixed.
+    """
+    witness_size = params.pop("witness_size", 20)
+    _validate_params(n, witness_size, params)
+    rng = random.Random(seed)
+    k = witness_size
+
+    # Construction labels: 0..k-1 are K.  The outside labels are assigned to
+    # two nonempty clique blocks.  Their sizes vary with the seed but stay
+    # balanced enough that degree alone does not reveal K.
+    outside_count = n - k
+    jitter = max(1, min(k // 3, outside_count // 8))
+    left_size = outside_count // 2 + rng.randint(-jitter, jitter)
+    left_size = max(k // 2 + 1, min(outside_count - (k // 2 + 1), left_size))
+    block_of = [-1] * n
+    for v in range(k, k + left_size):
+        block_of[v] = 0
+    for v in range(k + left_size, n):
+        block_of[v] = 1
+
+    # Put every boundary 1..k-1 somewhere before drawing repeats.  This makes
+    # the K rows distinct without searching for a certificate.
+    outside_vertices = list(range(k, n))
+    rng.shuffle(outside_vertices)
+    thresholds: dict[int, int] = {}
+    for t, v in zip(range(1, k), outside_vertices):
+        thresholds[v] = t
+    for v in outside_vertices[k - 1 :]:
+        thresholds[v] = rng.randint(1, k)
+
+    rows = [0] * n
+
+    def add_edge(u: int, v: int) -> None:
+        rows[u] |= 1 << v
+        rows[v] |= 1 << u
+
+    # K and each outside block are cliques.
+    for u in range(k):
+        for v in range(u + 1, k):
+            add_edge(u, v)
+    for block in (0, 1):
+        verts = [v for v in range(k, n) if block_of[v] == block]
+        for pos, u in enumerate(verts):
+            for v in verts[pos + 1 :]:
+                add_edge(u, v)
+
+    # Nested cross-neighborhoods: construction vertex i (0-based) is adjacent
+    # to an outside threshold t precisely when i+1 > t.
+    for i in range(k):
+        for v in range(k, n):
+            if i + 1 > thresholds[v]:
+                add_edge(i, v)
+
+    # Hide construction positions with a full random vertex permutation.
+    permutation = list(range(n))
+    rng.shuffle(permutation)
+    relabelled_rows = [0] * n
+    edges: list[list[int]] = []
+    for old_u in range(n):
+        new_u = permutation[old_u]
+        mask = rows[old_u]
+        while mask:
+            bit = mask & -mask
+            old_v = bit.bit_length() - 1
+            if old_u < old_v:
+                new_v = permutation[old_v]
+                a, b = sorted((new_u, new_v))
+                relabelled_rows[a] |= 1 << b
+                relabelled_rows[b] |= 1 << a
+                edges.append([a, b])
+            mask ^= bit
+    edges.sort()
+    answer = sorted(permutation[:k])
+
+    return {
+        "n": n,
+        "k": k,
+        "edges": edges,
+        "adjacency_bits": relabelled_rows,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render the complete, standalone hitting-clique problem."""
+    n = inst["n"]
+    k = inst["k"]
+    by_left: list[list[int]] = [[] for _ in range(n)]
+    for u, v in inst["edges"]:
+        by_left[u].append(v)
+    edge_lines = "\n".join(
+        f"{u}: " + (" ".join(map(str, by_left[u])) if by_left[u] else "-")
+        for u in range(n)
+    )
+    statement = f"""HITTING CLIQUE IN A PROMISED GRAPH
+
+An undirected simple graph has {n} vertices labelled 0 through {n - 1}.
+It is promised to be chordal (it has no induced cycle of length at least 4)
+and induced-2P3-free.  Here P3 means a three-vertex path with exactly its two
+path edges, and induced-2P3-free means that no six vertices induce two disjoint
+P3 components.
+
+A cluster graph is a graph whose connected components are complete graphs.  A
+hitting clique is a vertex set X with BOTH properties:
+  1. every two distinct vertices of X are adjacent, so X is a clique; and
+  2. deleting X and all incident edges leaves a cluster graph.
+
+Find a hitting clique containing exactly {k} DISTINCT vertices.  The order of
+the submitted labels is irrelevant, repetitions are forbidden, and every label
+must be an integer in the inclusive range 0..{n - 1}.
+
+The edge list below contains each edge once.  On a line "u: v1 v2 ...", every
+listed vi is greater than u and {{u,vi}} is an edge.  A dash means no later
+neighbor.  Pairs not listed are nonedges.
+
+EDGE LIST
+{edge_lines}
+
+Give your final answer inside <answer></answer> tags, as one JSON array of
+exactly {k} distinct integer labels.
+Example syntax only: <answer>[3, 17, 42]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Parse the last tagged JSON integer list, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    for body in reversed(_ANSWER_RE.findall(text)):
+        candidate = body.strip()
+        if candidate.startswith("```") and candidate.endswith("```"):
+            lines = candidate.splitlines()
+            if len(lines) >= 3:
+                candidate = "\n".join(lines[1:-1]).strip()
+        try:
+            value = json.loads(candidate)
+        except (TypeError, ValueError):
+            continue
+        if isinstance(value, list) and all(type(v) is int for v in value):
+            return value
+    return None
+
+
+def _cluster_remainder(rows: list[int], removed: int, n: int) -> tuple[bool, str]:
+    remaining = ((1 << n) - 1) & ~removed
+    unseen = remaining
+    while unseen:
+        first_bit = unseen & -unseen
+        component = 0
+        frontier = first_bit
+        unseen ^= first_bit
+        while frontier:
+            component |= frontier
+            neighbors = 0
+            scan = frontier
+            while scan:
+                bit = scan & -scan
+                v = bit.bit_length() - 1
+                neighbors |= rows[v]
+                scan ^= bit
+            frontier = neighbors & unseen
+            unseen &= ~frontier
+        scan = component
+        while scan:
+            bit = scan & -scan
+            v = bit.bit_length() - 1
+            if (component ^ bit) & ~rows[v]:
+                return False, f"remaining component containing {v} is not complete"
+            scan ^= bit
+    return True, "ok"
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any size-k hitting clique without consulting inst['answer']."""
+    n = inst.get("n")
+    k = inst.get("k")
+    rows = inst.get("adjacency_bits")
+    if type(n) is not int or type(k) is not int or not isinstance(rows, list) or len(rows) != n:
+        return False, "invalid instance graph"
+    if not isinstance(answer, list):
+        return False, "answer is not a JSON array"
+    if not answer:
+        return False, "answer array is empty"
+    if any(type(v) is not int for v in answer):
+        return False, "every vertex label must be an integer"
+    if any(v < 0 or v >= n for v in answer):
+        return False, f"vertex label out of range 0..{n - 1}"
+    if len(set(answer)) != len(answer):
+        return False, "vertex labels must be distinct"
+    if len(answer) != k:
+        return False, f"wrong clique size: expected {k}, got {len(answer)}"
+
+    chosen = 0
+    for v in answer:
+        chosen |= 1 << v
+    for v in answer:
+        if (chosen ^ (1 << v)) & ~rows[v]:
+            return False, "chosen vertices are not a clique"
+    ok, reason = _cluster_remainder(rows, chosen, n)
+    if not ok:
+        return False, reason
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the obvious exactly-k-subset certificate language."""
+    return sorted(rng.sample(range(inst["n"]), inst["k"]))
+
+
+def search_space(inst: dict) -> int:
+    return math.comb(inst["n"], inst["k"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    count = 0
+    for candidate in itertools.combinations(range(inst["n"]), inst["k"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def _wl_payload(inst: dict) -> dict[str, Any]:
+    n = inst["n"]
+    rows = inst["adjacency_bits"]
+    degrees = [row.bit_count() for row in rows]
+    degree_values = {d: i for i, d in enumerate(sorted(set(degrees)))}
+    colours = [degree_values[d] for d in degrees]
+    for _ in range(n):
+        signatures = []
+        for v in range(n):
+            neighbour_colours = []
+            scan = rows[v]
+            while scan:
+                bit = scan & -scan
+                neighbour_colours.append(colours[bit.bit_length() - 1])
+                scan ^= bit
+            signatures.append((colours[v], tuple(sorted(neighbour_colours))))
+        unique = {sig: i for i, sig in enumerate(sorted(set(signatures)))}
+        new_colours = [unique[sig] for sig in signatures]
+        if new_colours == colours:
+            break
+        colours = new_colours
+
+    class_count = max(colours, default=-1) + 1
+    sizes = [0] * class_count
+    edge_counts = [[0] * class_count for _ in range(class_count)]
+    for colour in colours:
+        sizes[colour] += 1
+    for u, v in inst["edges"]:
+        a, b = colours[u], colours[v]
+        edge_counts[a][b] += 1
+        if a != b:
+            edge_counts[b][a] += 1
+    return {"sizes": sizes, "edge_counts": edge_counts}
+
+
+def canonical_key(inst: dict) -> str:
+    """A relabelling-invariant WL colour-quotient key; never uses the seed."""
+    blob = json.dumps(_wl_payload(inst), sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    current = dict(params)
+    current.pop("_preset", None)
+    n = int(current.get("n", 56))
+    k = int(current.get("witness_size", 20))
+    harder = max(n + 24, (3 * n + 1) // 2)
+    if harder > 800:
+        return None
+    return {"n": harder, "witness_size": k}
+
+
+def _degree_attack(inst: dict, largest: bool) -> list[int]:
+    rows = inst["adjacency_bits"]
+    order = sorted(range(inst["n"]), key=lambda v: (rows[v].bit_count(), v), reverse=largest)
+    return sorted(order[: inst["k"]])
+
+
+def _greedy_clique_attack(inst: dict) -> list[int]:
+    rows = inst["adjacency_bits"]
+    order = sorted(range(inst["n"]), key=lambda v: (-rows[v].bit_count(), v))
+    chosen: list[int] = []
+    for v in order:
+        if all((rows[v] >> u) & 1 for u in chosen):
+            chosen.append(v)
+            if len(chosen) == inst["k"]:
+                return sorted(chosen)
+    return sorted(chosen)
+
+
+def _median_band_attack(inst: dict) -> list[int]:
+    rows = inst["adjacency_bits"]
+    degrees = sorted(row.bit_count() for row in rows)
+    median = degrees[len(degrees) // 2]
+    order = sorted(range(inst["n"]), key=lambda v: (abs(rows[v].bit_count() - median), v))
+    return sorted(order[: inst["k"]])
+
+
+def _mcs_candidates(inst: dict) -> tuple[list[list[int]], int]:
+    """Maximal-clique candidates from an MCS perfect-elimination ordering."""
+    n = inst["n"]
+    rows = inst["adjacency_bits"]
+    weights = [0] * n
+    remaining = set(range(n))
+    selection: list[int] = []
+    probes = 0
+    while remaining:
+        v = min(remaining, key=lambda x: (-weights[x], x))
+        remaining.remove(v)
+        selection.append(v)
+        scan = rows[v]
+        while scan:
+            bit = scan & -scan
+            u = bit.bit_length() - 1
+            probes += 1
+            if u in remaining:
+                weights[u] += 1
+            scan ^= bit
+    peo = list(reversed(selection))
+    position = {v: i for i, v in enumerate(peo)}
+    candidates: set[tuple[int, ...]] = set()
+    for v in peo:
+        clique = [v]
+        scan = rows[v]
+        while scan:
+            bit = scan & -scan
+            u = bit.bit_length() - 1
+            probes += 1
+            if position[u] > position[v]:
+                clique.append(u)
+            scan ^= bit
+        candidates.add(tuple(sorted(clique)))
+    raw = sorted(candidates, key=lambda c: (len(c), c), reverse=True)
+    maximal: list[list[int]] = []
+    raw_sets = [set(c) for c in raw]
+    for i, clique in enumerate(raw_sets):
+        if not any(clique < other for j, other in enumerate(raw_sets) if i != j):
+            maximal.append(sorted(clique))
+    maximal.sort(key=lambda c: (min(c), len(c), c))
+    return maximal, probes
+
+
+def _reference_algorithm(inst: dict) -> tuple[list[int] | None, int]:
+    """Find a size-k hitting maximal clique by the paper's PEO/clique route."""
+    candidates, probes = _mcs_candidates(inst)
+    n = inst["n"]
+    rows = inst["adjacency_bits"]
+    for clique in candidates:
+        if len(clique) != inst["k"]:
+            continue
+        mask = 0
+        for v in clique:
+            mask |= 1 << v
+        # Count the exact adjacency probes made by the cluster test.
+        remaining = ((1 << n) - 1) & ~mask
+        unseen = remaining
+        cluster_ok = True
+        while unseen and cluster_ok:
+            bit = unseen & -unseen
+            first = bit.bit_length() - 1
+            component = 0
+            frontier = bit
+            unseen ^= bit
+            while frontier:
+                component |= frontier
+                step = frontier
+                neighbors = 0
+                while step:
+                    b = step & -step
+                    v = b.bit_length() - 1
+                    neighbors |= rows[v]
+                    probes += rows[v].bit_count()
+                    step ^= b
+                frontier = neighbors & unseen
+                unseen &= ~frontier
+            step = component
+            while step:
+                b = step & -step
+                v = b.bit_length() - 1
+                probes += component.bit_count() - 1
+                if (component ^ b) & ~rows[v]:
+                    cluster_ok = False
+                    break
+                step ^= b
+        if cluster_ok:
+            return sorted(clique), probes
+    return None, probes
+
+
+def _relabel_instance(inst: dict, mapping: list[int]) -> dict:
+    n = inst["n"]
+    rows = [0] * n
+    edges: list[list[int]] = []
+    for old_u, old_v in inst["edges"]:
+        u, v = sorted((mapping[old_u], mapping[old_v]))
+        rows[u] |= 1 << v
+        rows[v] |= 1 << u
+        edges.append([u, v])
+    edges.sort()
+    return {
+        "n": n,
+        "k": inst["k"],
+        "edges": edges,
+        "adjacency_bits": rows,
+        "answer": sorted(mapping[v] for v in inst["answer"]),
+    }
+
+
+def _is_chordal(inst: dict) -> bool:
+    """MCS chordality check used by selftest, not by answer verification."""
+    n = inst["n"]
+    rows = inst["adjacency_bits"]
+    weights = [0] * n
+    remaining = set(range(n))
+    selection: list[int] = []
+    while remaining:
+        v = min(remaining, key=lambda x: (-weights[x], x))
+        remaining.remove(v)
+        selection.append(v)
+        scan = rows[v]
+        while scan:
+            bit = scan & -scan
+            u = bit.bit_length() - 1
+            if u in remaining:
+                weights[u] += 1
+            scan ^= bit
+    peo = list(reversed(selection))
+    pos = {v: i for i, v in enumerate(peo)}
+    for v in peo:
+        later = [u for u in range(n) if pos[u] > pos[v] and ((rows[v] >> u) & 1)]
+        if not later:
+            continue
+        parent = min(later, key=lambda u: pos[u])
+        required = 0
+        for u in later:
+            if u != parent:
+                required |= 1 << u
+        if required & ~rows[parent]:
+            return False
+    return True
+
+
+def _answer_atoms(value: Any) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(v) for v in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(v) for v in value)
+    return 1
+
+
+def selftest() -> dict:
+    """Run gates G1--G9 and return their machine-readable measurements."""
+    report: dict[str, Any] = {"track": TRACK}
+
+    # G1: every named preset, four independent seeds, plus the promise check.
+    g1_rows = []
+    g1_pass = True
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7, 19):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            json_ok = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            chordal = _is_chordal(inst)
+            row = {
+                "preset": preset,
+                "seed": seed,
+                "verified": ok,
+                "reason": reason,
+                "json_native_roundtrip": json_ok,
+                "chordal_promise": chordal,
+                "2P3_free_proof": "every P3 meets the planted clique, which is complete",
+            }
+            g1_rows.append(row)
+            g1_pass &= ok and json_ok and chordal
+    report["G1_planted_verifies"] = {"pass": g1_pass, "checks": g1_rows}
+
+    # G2: five corruptions and five deliberately distinct rejection reasons.
+    inst = make_instance(seed=314159, **DIFFICULTY["medium"])
+    good = list(inst["answer"])
+    outside = [v for v in range(inst["n"]) if v not in set(good)]
+    swap_bad = None
+    for remove_pos in range(len(good)):
+        for new_v in outside:
+            candidate = good[:remove_pos] + good[remove_pos + 1 :] + [new_v]
+            ok, reason = verify(inst, candidate)
+            if not ok and reason == "chosen vertices are not a clique":
+                swap_bad = candidate
+                break
+        if swap_bad is not None:
+            break
+    if swap_bad is None:
+        swap_bad = good[:-1] + [outside[0]]
+    corruptions = {
+        "drop_one": good[:-1],
+        "swap_one": swap_bad,
+        "duplicate": good[:-1] + [good[0]],
+        "empty": [],
+        "out_of_range": good[:-1] + [inst["n"]],
+    }
+    g2_results = {}
+    reasons = []
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        g2_results[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    g2_pass = all(item["rejected"] for item in g2_results.values()) and len(set(reasons)) == 5
+    report["G2_rejects_corruption"] = {
+        "pass": g2_pass,
+        "distinct_reasons": len(set(reasons)),
+        "cases": g2_results,
+    }
+
+    # G3: realistic prose/fence round-trip and malformed-input behavior.
+    tagged = "I found the separator.\n<answer>\n```json\n" + json.dumps(good) + "\n```\n</answer>\nDone."
+    parsed = parse_answer(tagged)
+    g3_pass = parsed == good and parse_answer("no tagged answer") is None
+    report["G3_round_trip"] = {
+        "pass": g3_pass,
+        "parsed_equals_answer": parsed == good,
+        "garbage_returns_none": parse_answer("no tagged answer") is None,
+    }
+
+    shipping = make_instance(seed=20260905, **DIFFICULTY[SHIPPING_DIFFICULTY])
+
+    # G4/G5 density: 200k structure-aware samples at the actual shipping preset.
+    guess_rng = random.Random(0x200708057)
+    samples = 200_000
+    hits = 0
+    start = time.perf_counter()
+    for _ in range(samples):
+        if verify(shipping, random_candidate(shipping, guess_rng))[0]:
+            hits += 1
+    guess_wall = time.perf_counter() - start
+    observed = hits / samples
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": observed,
+        "candidate_prior": "uniform over all exactly-k vertex subsets",
+        "search_space": search_space(shipping),
+        "wall_clock_sec": guess_wall,
+    }
+
+    demo = make_instance(seed=5, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+
+    # Reference algorithm is expected to solve on Track B.
+    ref_start = time.perf_counter()
+    ref_answer, ref_probes = _reference_algorithm(shipping)
+    ref_wall = time.perf_counter() - ref_start
+    ref_ok = ref_answer is not None and verify(shipping, ref_answer)[0]
+
+    # G6 panel over eight seeds.  The polynomial reference is not an attack.
+    attack_names = (
+        "outlier_high_degree",
+        "greedy_largest_first",
+        "random_restart_256",
+        "by_hand_median_degree_band",
+    )
+    attack_successes = {name: 0 for name in attack_names}
+    attack_operations = {name: 0 for name in attack_names}
+    panel_start = time.perf_counter()
+    reference_successes = 0
+    reference_probes_total = 0
+    reference_wall_total = 0.0
+    for seed in range(8):
+        panel_inst = make_instance(seed=1000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        candidate = _degree_attack(panel_inst, largest=True)
+        attack_operations["outlier_high_degree"] += panel_inst["n"]
+        attack_successes["outlier_high_degree"] += int(verify(panel_inst, candidate)[0])
+
+        candidate = _greedy_clique_attack(panel_inst)
+        attack_operations["greedy_largest_first"] += panel_inst["n"] * panel_inst["k"]
+        attack_successes["greedy_largest_first"] += int(verify(panel_inst, candidate)[0])
+
+        rrng = random.Random(900_000 + seed)
+        found = False
+        for _ in range(256):
+            attack_operations["random_restart_256"] += 1
+            if verify(panel_inst, random_candidate(panel_inst, rrng))[0]:
+                found = True
+                break
+        attack_successes["random_restart_256"] += int(found)
+
+        candidate = _median_band_attack(panel_inst)
+        attack_operations["by_hand_median_degree_band"] += panel_inst["n"]
+        attack_successes["by_hand_median_degree_band"] += int(verify(panel_inst, candidate)[0])
+
+        one_start = time.perf_counter()
+        candidate, probes = _reference_algorithm(panel_inst)
+        reference_wall_total += time.perf_counter() - one_start
+        reference_probes_total += probes
+        reference_successes += int(candidate is not None and verify(panel_inst, candidate)[0])
+    panel_wall = time.perf_counter() - panel_start
+    attacks = {
+        name: {
+            "successes": attack_successes[name],
+            "attempts": 8,
+            "operations": attack_operations[name],
+        }
+        for name in attack_names
+    }
+    g6_pass = all(item["successes"] == 0 for item in attacks.values()) and ref_ok and reference_successes == 8
+    report["G6_adversary_panel"] = {
+        "pass": g6_pass,
+        "attacks": attacks,
+        "wall_clock_sec": panel_wall,
+        "reference_algorithm": {
+            "name": "MCS perfect-elimination ordering plus maximal-clique cluster tests",
+            "paper_source": "Lemma 4 and Section 3, Lemma 8",
+            "complexity": "O(N^3) exact in the paper's analysis",
+            "wall_clock_sec_shipping_one": ref_wall,
+            "operations_shipping_one": ref_probes,
+            "wall_clock_sec_8_seeds": reference_wall_total,
+            "operations_8_seeds": reference_probes_total,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    report["G5_density_and_baseline"] = {
+        "pass": True,
+        "shipping_preset": SHIPPING_DIFFICULTY,
+        "shipping_density": {
+            "kind": "sampled",
+            "hits": hits,
+            "samples": samples,
+            "observed_fraction": observed,
+        },
+        "demo_exact_solution_count": {
+            "n": demo["n"],
+            "k": demo["k"],
+            "valid_answers": demo_count,
+            "candidate_space": search_space(demo),
+        },
+        "strongest_failing_attack": {
+            "name": "random_restart_256",
+            "attempts_total": attack_operations["random_restart_256"],
+            "successes": attack_successes["random_restart_256"],
+            "panel_wall_clock_sec": panel_wall,
+        },
+        "reference_algorithm_cost": {
+            "wall_clock_sec": ref_wall,
+            "adjacency_probes": ref_probes,
+            "verified": ref_ok,
+        },
+    }
+
+    # G7: double only the ambient graph; keep the answer length fixed.
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] > shipping["n"] and doubled["k"] == shipping["k"],
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "answer_length_shipping": shipping["k"],
+        "answer_length_doubled": doubled["k"],
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    # G8: two independent permutations for 20 seeds, with carried witnesses.
+    invariant_checks = 0
+    carried_checks = 0
+    invariant_ok = True
+    carried_ok = True
+    original_keys = []
+    for seed in range(20):
+        base = make_instance(seed=20_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        base_key = canonical_key(base)
+        original_keys.append(base_key)
+        for salt in (1, 2):
+            rrng = random.Random(700_000 + 31 * seed + salt)
+            mapping = list(range(base["n"]))
+            rrng.shuffle(mapping)
+            moved = _relabel_instance(base, mapping)
+            invariant_checks += 1
+            invariant_ok &= canonical_key(moved) == base_key
+            carried_checks += 1
+            carried_ok &= verify(moved, moved["answer"])[0]
+    distinct = len(set(original_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant_ok and carried_ok and distinct == 20,
+        "invariance_passed": invariant_ok,
+        "invariance_checks": invariant_checks,
+        "carried_witness_passed": carried_ok,
+        "carried_witness_checks": carried_checks,
+        "distinct_unrelated": distinct,
+        "unrelated_attempts": 20,
+        "invariant_kind": "canonical 1-WL colour quotient",
+    }
+
+    answer_blob = json.dumps(shipping["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(shipping["answer"])
+    intended_ops = 2 * shipping["n"] + shipping["k"]
+    hinted_rate = G9_ARM_RESULTS["hinted"]["solved"] / max(1, G9_ARM_RESULTS["hinted"]["attempts"])
+    placebo_rate = G9_ARM_RESULTS["placebo"]["solved"] / max(1, G9_ARM_RESULTS["placebo"]["attempts"])
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": G9_ARM_RESULTS,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": "diagnostic_only",
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_gates_pass"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

