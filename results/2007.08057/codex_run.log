   186	def make_instance(n, seed=0, **params) -> dict:
   187	    """Inverse-generate a certified optimum Cluster-VD instance.
   188	
   189	    ``n`` is the bit-vector dimension d. ``m`` is the Cayley degree. Larger d
   190	    enlarges the answer space; larger m crowds it with more exact constraints.
   191	    The exponentially large graph is specified without materialising it.
   192	    """
   193	
   194	    if type(n) is not int:
   195	        raise ValueError("n must be an integer")
   196	    d = n
   197	    m = params.pop("m", 3 * d)
   198	    if params:
   199	        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
   200	    if type(m) is not int:
   201	        raise ValueError("m must be an integer")
   202	    if d < 4:
   203	        raise ValueError("n must be at least 4")
   204	    if m < d:
   205	        raise ValueError("m must be at least n so the constraints can have full rank")
   206	    if m > (1 << (d - 1)):
   207	        raise ValueError("m exceeds the number of distinct affine-hyperplane masks")
   208	
   209	    rng = random.Random(seed)
   210	
   211	    # Sample the certificate first. The parity condition is necessary for m
   212	    # affine-hyperplane vectors to have XOR w: <w,w> = m (mod 2).
   213	    while True:
   214	        planted_w = rng.getrandbits(d)
   215	        if planted_w and _parity(planted_w) == (m & 1):
   216	            break
   217	
   218	    # The planted four-circuits make non-isomorphic seeds cheaply detectable by
   219	    # an invariant, while shuffling gives every displayed row the same marginal
   220	    # role. They do not reveal the functional: every row is sampled from the

 succeeded in 0ms:
   221	    # same affine hyperplane <w,s>=1.
   222	    for _attempt in range(512):
   223	        rows: list[int] = []
   224	        used: set[int] = set()
   225	
   226	        if d >= 16 and m >= d + 20:
   227	            anchor_count = min(16, max(6, d // 8))
   228	            circuit_low = max(2, d // 6)
   229	            circuit_high = min(
   230	                len(list(itertools.combinations(range(anchor_count), 2))),
   231	                d // 3,
   232	                (m - anchor_count - 2) // 2,
   233	            )
   234	            circuit_count = rng.randint(circuit_low, circuit_high)
   235	        else:
   236	            anchor_count = 0
   237	            circuit_count = 0
   238	
   239	        anchors: list[int] = []
   240	        for _ in range(anchor_count):
   241	            a = _sample_affine(rng, planted_w, d, used)
   242	            anchors.append(a)
   243	            rows.append(a)
   244	            used.add(a)
   245	
   246	        if anchors:
   247	            pairs = list(itertools.combinations(range(len(anchors)), 2))
   248	            for i, j in rng.sample(pairs, circuit_count):
   249	                for _ in range(256):
   250	                    c = _sample_affine(rng, planted_w, d, used)
   251	                    derived = anchors[i] ^ anchors[j] ^ c
   252	                    if derived and derived not in used and derived != c:
   253	                        rows.extend((c, derived))
   254	                        used.add(c)
   255	                        used.add(derived)
   256	                        break
   257	                else:
   258	                    rows = []
   259	                    break
   260	        if anchor_count and not rows:
   261	            continue
   262	
   263	        while len(rows) < m - 1:
   264	            s = _sample_affine(rng, planted_w, d, used)
   265	            rows.append(s)
   266	            used.add(s)
   267	
   268	        last = planted_w ^ _xor_all(rows)
   269	        if not last or last in used or _parity(planted_w & last) != 1:
   270	            continue
   271	        rows.append(last)
   272	        if _rank_bits(rows, d) != d:
   273	            continue
   274	        rng.shuffle(rows)
   275	        break
   276	    else:
   277	        raise RuntimeError("could not construct a full-rank generator family")
   278	
   279	    width = (d + 3) // 4
   280	    side = rng.randrange(2)
   281	    answer = [format(planted_w, f"0{width}x"), side]
   282	    return {
   283	        "dimension": d,
   284	        "generator_count": m,
   285	        "generators": [format(s, f"0{width}x") for s in rows],
   286	        "original_vertices": 1 << d,
   287	        "total_vertices": 1 << (d + 1),
   288	        "minimum_deletions": 1 << (d - 1),
   289	        "hex_width": width,
   290	        "answer": answer,
   291	    }
