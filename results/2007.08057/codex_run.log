   170	def _sample_affine(rng: random.Random, w: int, d: int, used: set[int]) -> int:
   171	    """Uniformly rejection-sample an unused s with <w,s>=1."""
   172	
   173	    while True:
   174	        s = rng.getrandbits(d)
   175	        if s not in used and _parity(w & s) == 1:
   176	            return s
   177	
   178	
   179	def _xor_all(values) -> int:
   180	    out = 0
   181	    for value in values:
   182	        out ^= value
   183	    return out
