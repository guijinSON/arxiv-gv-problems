   433	def _canonical_invariant(inst) -> dict:
   434	    """A GL(d,2)- and generator-order-invariant short-circuit signature."""
   435	
   436	    rows = [int(s, 16) for s in inst["generators"]]
   437	    buckets: dict[int, list[tuple[int, int]]] = {}
   438	    for i in range(len(rows)):
   439	        for j in range(i + 1, len(rows)):
   440	            buckets.setdefault(rows[i] ^ rows[j], []).append((i, j))
   441	
   442	    circuits: set[tuple[int, int, int, int]] = set()
   443	    bucket_sizes = []
   444	    for pairs in buckets.values():
   445	        if len(pairs) > 1:
   446	            bucket_sizes.append(len(pairs))
   447	            for a in range(len(pairs)):
   448	                i, j = pairs[a]
   449	                for b in range(a + 1, len(pairs)):
   450	                    k, ell = pairs[b]
   451	                    if len({i, j, k, ell}) == 4:
   452	                        circuits.add(tuple(sorted((i, j, k, ell))))
   453	
   454	    degrees = [0] * len(rows)
   455	    for circuit in circuits:
   456	        for i in circuit:
   457	            degrees[i] += 1
   458	    circuit_profiles = sorted(
   459	        tuple(sorted(degrees[i] for i in circuit)) for circuit in circuits
   460	    )
   461	    intersection_histogram = [0, 0, 0, 0, 0]
   462	    circuit_list = list(circuits)
   463	    intersections: dict[tuple[int, int], int] = {}
   464	    for i in range(len(circuit_list)):
   465	        left = set(circuit_list[i])
   466	        for j in range(i + 1, len(circuit_list)):
   467	            overlap = len(left.intersection(circuit_list[j]))
   468	            intersection_histogram[overlap] += 1
   469	            if overlap:
   470	                intersections[(i, j)] = overlap
   471	
   472	    # Canonical colour refinement of the circuit-intersection graph.  The final
   473	    # coloured edge list records substantially more than a degree histogram,
   474	    # but remains invariant under every permutation of generators/circuits.
   475	    initial = [tuple(sorted(degrees[v] for v in circuit)) for circuit in circuit_list]
   476	    palette = {value: rank for rank, value in enumerate(sorted(set(initial)))}
   477	    colours = [palette[value] for value in initial]
   478	    for _ in range(8):
   479	        signatures = []
   480	        for i in range(len(circuit_list)):
   481	            neighbours = []
   482	            for (a, b), overlap in intersections.items():
   483	                if a == i:
   484	                    neighbours.append((overlap, colours[b]))
   485	                elif b == i:
   486	                    neighbours.append((overlap, colours[a]))
   487	            signatures.append((colours[i], tuple(sorted(neighbours))))
   488	        palette = {
   489	            value: rank for rank, value in enumerate(sorted(set(signatures)))
   490	        }
   491	        new_colours = [palette[value] for value in signatures]
   492	        if new_colours == colours:
   493	            break
   494	        colours = new_colours
   495	    coloured_edges = sorted(
   496	        (min(colours[i], colours[j]), max(colours[i], colours[j]), overlap)
   497	        for (i, j), overlap in intersections.items()
   498	    )
   499	    return {
   500	        "d": inst["dimension"],
   501	        "m": len(rows),
   502	        "pair_bucket_sizes": sorted(bucket_sizes),
   503	        "four_circuit_degrees": sorted(degrees),
   504	        "four_circuit_profiles": circuit_profiles,
   505	        "four_circuit_intersections": intersection_histogram,
   506	        "four_circuit_coloured_edges": coloured_edges,
   507	        "four_circuit_count": len(circuits),
   508	    }
