+def _gaussian_reference(inst) -> tuple[object | None, dict]:
+    """Solve <w,s>=1 by exact GF(2) elimination and count scalar bit work."""
+
+    d = inst["dimension"]
+    basis: list[tuple[int, int] | None] = [None] * d
