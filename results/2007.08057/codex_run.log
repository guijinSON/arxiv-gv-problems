+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            json_ok = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            chordal = _is_chordal(inst)
+            row = {
+                "preset": preset,
+                "seed": seed,
+                "verified": ok,
+                "reason": reason,
+                "json_native_roundtrip": json_ok,
+                "chordal_promise": chordal,
+                "2P3_free_proof": "every P3 meets the planted clique, which is complete",
+            }
+            g1_rows.append(row)
+            g1_pass &= ok and json_ok and chordal
+    report["G1_planted_verifies"] = {"pass": g1_pass, "checks": g1_rows}
+
+    # G2: five corruptions and five deliberately distinct rejection reasons.
+    inst = make_instance(seed=314159, **DIFFICULTY["medium"])
+    good = list(inst["answer"])
+    outside = [v for v in range(inst["n"]) if v not in set(good)]
+    swap_bad = None
+    for remove_pos in range(len(good)):
+        for new_v in outside:
+            candidate = good[:remove_pos] + good[remove_pos + 1 :] + [new_v]
+            ok, reason = verify(inst, candidate)
+            if not ok and reason == "chosen vertices are not a clique":
+                swap_bad = candidate
+                break
+        if swap_bad is not None:
+            break
+    if swap_bad is None:
+        swap_bad = good[:-1] + [outside[0]]
+    corruptions = {
+        "drop_one": good[:-1],
+        "swap_one": swap_bad,
+        "duplicate": good[:-1] + [good[0]],
+        "empty": [],
+        "out_of_range": good[:-1] + [inst["n"]],
+    }
+    g2_results = {}
+    reasons = []
+    for name, candidate in corruptions.items():
