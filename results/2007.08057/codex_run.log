   364	
   365	def verify(inst, answer) -> tuple[bool, str]:
   366	    """Check any parity-hyperplane optimum; never consult inst['answer']."""
   367	
   368	    if not isinstance(answer, list):
   369	        return False, "answer must be a JSON list"
   370	    if len(answer) == 0:
   371	        return False, "answer is empty"
   372	    if len(answer) == 1:
   373	        return False, "answer has one element; expected [w,b]"
   374	    if len(answer) != 2:
   375	        return False, "answer must have exactly two elements"
   376	
   377	    encoded_w, side = answer
   378	    if not isinstance(encoded_w, str):
   379	        return False, "w must be a quoted hexadecimal string"
   380	    if isinstance(side, bool) or not isinstance(side, int) or side not in (0, 1):
   381	        return False, "b must be the integer 0 or 1"
   382	    if not re.fullmatch(r"[0-9a-f]+", encoded_w):
   383	        return False, "w must contain only lowercase hexadecimal digits"
   384	
   385	    w = int(encoded_w, 16)
   386	    d = inst["dimension"]
   387	    if w >= (1 << d):
   388	        return False, "w is outside the d-bit range"
   389	    if len(encoded_w) != inst["hex_width"]:
   390	        return False, "w has the wrong fixed hexadecimal width"
   391	    if w == 0:
   392	        return False, "w must be nonzero"
   393	
   394	    for encoded_s in inst["generators"]:
   395	        if _parity(w & int(encoded_s, 16)) != 1:
   396	            return False, "w does not alternate across every generator edge"
   397	
   398	    # Executable certificate logic: alternation means X(w,b) covers every Cayley
   399	    # edge. Proposition 18 then makes it a CVD hitting set of G+. It contains
   400	    # exactly 2^(d-1) originals. Any nonzero generator pairs every x with x XOR s,
   401	    # a perfect matching of that size, so no vertex cover/hitting set is smaller.
   402	    return True, "ok"
   403	
