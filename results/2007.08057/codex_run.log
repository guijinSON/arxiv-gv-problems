   413	def search_space(inst) -> int | None:
   414	    """Size of the exact bounded certificate language."""
   415	
   416	    return 2 * ((1 << inst["dimension"]) - 1)
   417	
   418	
   419	def enumerate_all(inst) -> int | None:
   420	    """Brute-force the bounded language only when it has at most 100,000 items."""
   421	
   422	    space = search_space(inst)
   423	    if space is None or space > 100_000:
   424	        return None
   425	    count = 0
   426	    for w in range(1, 1 << inst["dimension"]):
   427	        encoded = format(w, f"0{inst['hex_width']}x")
   428	        for side in (0, 1):
   429	            count += int(verify(inst, [encoded, side])[0])
   430	    return count
