   518	def escalate(params) -> dict | str | None:
   519	    """Increase equation crowding and then dimension while the route stays <=300."""
   520	
   521	    p = {k: v for k, v in dict(params).items() if k != "_preset"}
   522	    n = int(p["n"])
   523	    m = int(p.get("m", 3 * n))
   524	    if m < 300:
   525	        p["m"] = min(300, m + max(4, n // 6))
   526	        p["n"] = min(p["m"], n + max(4, n // 8))
   527	        return p
   528	    if n < m:
   529	        p["n"] = min(m, n + max(4, n // 8))
   530	        p["m"] = m
   531	        return p
   532	    return "cap_bound"
