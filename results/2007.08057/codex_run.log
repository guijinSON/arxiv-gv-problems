   535	def _gaussian_reference(inst) -> tuple[object | None, dict]:
   536	    """Solve <w,s>=1 by exact GF(2) elimination and count scalar bit work."""
   537	
   538	    d = inst["dimension"]
   539	    basis: list[tuple[int, int] | None] = [None] * d
   540	    row_xors = 0
   541	    pivot_inspections = 0
   542	    for encoded in inst["generators"]:
   543	        row = int(encoded, 16)
   544	        rhs = 1
   545	        while row:
   546	            p = row.bit_length() - 1
   547	            pivot_inspections += 1
   548	            if basis[p] is None:
   549	                basis[p] = (row, rhs)
   550	                break
   551	            old_row, old_rhs = basis[p]
   552	            row ^= old_row
   553	            rhs ^= old_rhs
   554	            row_xors += 1
   555	        else:
   556	            if rhs:
   557	                return None, {
   558	                    "row_xors": row_xors,
   559	                    "pivot_inspections": pivot_inspections,
   560	                    "scalar_bit_operations": row_xors * (d + 1) + pivot_inspections,
   561	                }
   562	
   563	    if any(entry is None for entry in basis):
   564	        return None, {
   565	            "row_xors": row_xors,
   566	            "pivot_inspections": pivot_inspections,
   567	            "scalar_bit_operations": row_xors * (d + 1) + pivot_inspections,
   568	        }
   569	
   570	    w = 0
   571	    back_substitution_bits = 0
   572	    for p in range(d):
   573	        row, rhs = basis[p]  # type: ignore[misc]
   574	        lower = row & ((1 << p) - 1)
   575	        rhs ^= _parity(lower & w)
   576	        back_substitution_bits += p + 1
   577	        if rhs:
   578	            w |= 1 << p
   579	    counts = {
   580	        "row_xors": row_xors,
   581	        "pivot_inspections": pivot_inspections,
   582	        "back_substitution_bits": back_substitution_bits,
   583	        "scalar_bit_operations": (
   584	            row_xors * (d + 1) + pivot_inspections + back_substitution_bits
   585	        ),
   586	    }
   587	    return [format(w, f"0{inst['hex_width']}x"), 0], counts
   588	
