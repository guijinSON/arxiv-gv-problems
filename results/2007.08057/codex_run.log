+    d = inst["dimension"]
+    width = inst["hex_width"]
+    original_rows = [int(s, 16) for s in inst["generators"]]
+    original_w = int(inst["answer"][0], 16)
+    original_side = inst["answer"][1]
+    variants = []
 
