+def _rank_bits(rows: list[int], d: int) -> int:
+    """Rank of integer-encoded row vectors over GF(2)."""
 
+    basis = [0] * d
+    rank = 0
+    for value in rows:
+        x = value
+        while x:
+            p = x.bit_length() - 1
+            if basis[p]:
+                x ^= basis[p]
+            else:
+                basis[p] = x
+                rank += 1
+                break
+    return rank
+
 
