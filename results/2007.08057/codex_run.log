   294	def render(inst) -> str:
   295	    """Render a self-contained, exact statement with an explicit wire format."""
   296	
   297	    d = inst["dimension"]
   298	    width = inst["hex_width"]
   299	    generator_lines = "\n".join(
   300	        f"  {i:03d}: {s}" for i, s in enumerate(inst["generators"])
   301	    )
   302	    hint = ""
   303	    mode = os.environ.get("GV_HINT_MODE")
   304	    if mode == "structural":
   305	        hint = f"\nHint: {STRUCTURAL_HINT}\n"
   306	    elif mode == "placebo":
   307	        hint = f"\nHint: {PLACEBO_HINT}\n"
   308	
   309	    example_w = "0" * (width - 1) + "1"
   310	    return f"""Minimum Cluster Vertex Deletion in a succinct graph
   311	
   312	All arithmetic on bit-vectors below is over GF(2). A d-bit vector is written as
   313	exactly {width} lowercase hexadecimal digits, including leading zeroes. XOR is
   314	bitwise exclusive-or. For vectors a and z, <a,z> is the parity (0 for even, 1
   315	for odd) of the number of 1-bits in a AND z.
   316	
   317	A cluster graph is an undirected simple graph whose connected components are
   318	complete graphs. A cluster vertex-deletion hitting set is a set of vertices
   319	whose deletion leaves a cluster graph.
   320	
   321	Here d={d}. Define an undirected simple graph H as follows. For every d-bit
   322	vector x there are two vertices O_x (an original vertex) and P_x (its pendant).
   323	There is an edge O_x--P_x for every x. There is also an edge O_x--O_(x XOR s)
   324	for every x and every generator mask s in the list below. These are all edges;
   325	repeated descriptions of the same undirected edge count only once.
   326	
   327	Generator masks ({inst['generator_count']} total, indices are only labels):
   328	{generator_lines}
   329	
   330	Your answer must be a pair [w,b]. Here w is a nonzero d-bit vector in exactly
   331	{width} lowercase hexadecimal digits, and b is the integer 0 or 1. The pair
   332	symbolically denotes the deletion set
   333	
   334	    X(w,b) = {{ O_x : <w,x> = b }}.
   335	
   336	No pendant P_x is deleted. Find any [w,b] for which X(w,b) is a minimum-cardinality
   337	cluster vertex-deletion hitting set of H. Both b choices are allowed if valid.
   338	The minimum deletion size is promised to be {inst['minimum_deletions']}; you do
   339	not write out those vertices. Order in the two-element pair matters.
   340	{hint}
   341	Give your final answer inside <answer></answer> tags as a JSON pair
   342	["w",b], with the hexadecimal mask quoted and b unquoted.
   343	Example of format only: <answer>["{example_w}",0]</answer>
   344	Output nothing else inside the tags."""
   345	
   346	
   347	def parse_answer(text) -> object | None:
   348	    """Extract the last tagged JSON answer, tolerating surrounding prose/fences."""
   349	
   350	    if not isinstance(text, str):
   351	        return None
   352	    blocks = re.findall(r"<answer\s*>(.*?)</answer\s*>", text, flags=re.I | re.S)
   353	    if not blocks:
   354	        return None
   355	    body = blocks[-1].strip()
   356	    if body.startswith("```"):
   357	        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
   358	        body = re.sub(r"\s*```$", "", body)
   359	    try:
   360	        return json.loads(body)
   361	    except (TypeError, ValueError):
   362	        return None
