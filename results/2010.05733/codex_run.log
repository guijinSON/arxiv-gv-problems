+def _add_edge(adj: list[int], u: int, v: int) -> None:
+    if u == v:
+        raise ValueError("loops are not allowed")
+    adj[u] |= 1 << v
+    adj[v] |= 1 << u
+
+
+def _add_clique(adj: list[int], vertices) -> None:
+    vs = list(vertices)
+    for i, u in enumerate(vs):
+        for v in vs[i + 1:]:
