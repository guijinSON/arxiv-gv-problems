+        "node_cap": 2_000_000,
+        "mean_wall_clock_sec": round(sum(dpll_times) / attempts, 6),
+        "max_wall_clock_sec": round(max(dpll_times), 6),
+        "maximal_bicliques_range": [min(dpll_concepts), max(dpll_concepts)],
