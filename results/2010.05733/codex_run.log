+def _maximal_bicliques_from_rows(rows: tuple[int, ...], p: int,
+                                 q: int) -> tuple[tuple[int, int], ...]:
+    """Enumerate formal concepts by Ganter's Next-Closure algorithm."""
+    cache_key = (rows, p, q)
+    cached = _CONCEPT_CACHE.get(cache_key)
+    if cached is not None:
+        return cached
+    full_x = (1 << p) - 1
