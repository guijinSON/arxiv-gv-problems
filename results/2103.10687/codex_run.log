+    compact_answer, compact_metrics = _compact_route(ship)
+    compact_ok = compact_answer is not None and verify(ship, compact_answer)[0]
+    width = _hex_width(ship["k"])
+    worst_answer = {"z": "0x" + "f" * width, "trace": 0}
