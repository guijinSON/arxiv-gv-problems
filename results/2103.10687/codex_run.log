+# Replaced with script-owned measurements after the three hardening arms run.
+G9_MEASUREMENTS = {
+    "bare": {"solved": 0, "attempts": 0, "error_calls": 4},
+    "hinted": {"solved": 0, "attempts": 0, "error_calls": 4},
