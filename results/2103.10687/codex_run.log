102:\title{Low differentially uniform permutations from Dobbertin APN function over $\mathbb{F}_{2^n}$ }
103-\author{Yan-Ping Wang$^{1,2}$, WeiGuo Zhang$^{1}${\thanks{Email:~zwg@xidian.edu.cn} }, Zhengbang Zha$^3$ \\
104-\vspace*{0.0cm}\\
