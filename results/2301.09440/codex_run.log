def _is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def _validate_params(n, classes, degree, seed):
    if not _is_int(n) or n < 3:
        raise ValueError("n must be an integer at least 3")
    if not _is_int(classes) or classes < 3:
        raise ValueError("classes must be an integer at least 3")
    if not _is_int(degree) or not 1 <= degree < n:
        raise ValueError("degree must be an integer with 1 <= degree < n")
    if not _is_int(seed):
        raise ValueError("seed must be an integer")


def _regular_pair(n, degree, plant_left, plant_right, rng):
    """A simple degree-regular bipartite graph containing the planted edge.

    The starting circulant is randomized by degree-preserving two-switches.
    The planted edge is pinned, but its endpoints retain exactly the same degree
    as every decoy endpoint.
    """
    # Independently relabel both shores of a random circulant.  Coordinate zero
    # is assigned to the planted endpoints and shift zero is retained, which
    # guarantees the planted edge without changing any degree.  Independent
    # relabellings for every colour pair destroy any global cyclic coordinate.
    left_at = [plant_left] + [x for x in range(n) if x != plant_left]
    right_at = [plant_right] + [y for y in range(n) if y != plant_right]
    left_tail = left_at[1:]
    right_tail = right_at[1:]
    rng.shuffle(left_tail)
    rng.shuffle(right_tail)
    left_at = [plant_left] + left_tail
    right_at = [plant_right] + right_tail
    left_coordinate = {vertex: coordinate for coordinate, vertex in enumerate(left_at)}
    shifts = [0] + rng.sample(range(1, n), degree - 1)
    rows = [set() for _ in range(n)]
    for x in range(n):
        coordinate = left_coordinate[x]
        rows[x] = {right_at[(coordinate + shift) % n] for shift in shifts}
    assert plant_right in rows[plant_left]

    # A linear number of switches breaks the remaining visible circulant motif
    # while keeping generation cheap enough for the 20-seed invariance audit.
    for _ in range(2 * n):
        a = rng.randrange(n)
        b = rng.randrange(n - 1)
        if b >= a:
            b += 1
        only_a = rows[a] - rows[b]
        only_b = rows[b] - rows[a]
        if a == plant_left:
            only_a.discard(plant_right)
        if b == plant_left:
            only_b.discard(plant_right)
        if not only_a or not only_b:
            continue
        y = rng.choice(tuple(only_a))
        z = rng.choice(tuple(only_b))
        rows[a].remove(y)
        rows[b].remove(z)
        rows[a].add(z)
        rows[b].add(y)

    assert all(len(row) == degree for row in rows)
    column_degrees = [0] * n
    for row in rows:
        for y in row:
            column_degrees[y] += 1
    assert all(value == degree for value in column_degrees)
    assert plant_right in rows[plant_left]
    return ["".join("1" if y in row else "0" for y in range(n)) for row in rows]


