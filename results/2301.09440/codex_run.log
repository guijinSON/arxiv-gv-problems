+    while available and len(chosen) < inst["k"]:
+        face_id = max(
+            available,
+            key=lambda f: (len(set(table[f]) & uncovered), -f),
+        )
+        chosen.append(face_id)
+        available.remove(face_id)
+        uncovered.difference_update(table[face_id])
+    return sorted(chosen)
