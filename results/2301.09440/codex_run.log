+def _greedy_independent(adjacency, order):
+    chosen = set()
+    forbidden = set()
+    for vertex in order:
+        if vertex not in forbidden:
+            chosen.add(vertex)
+            forbidden.add(vertex)
+            forbidden.update(adjacency[vertex])
+    return chosen
