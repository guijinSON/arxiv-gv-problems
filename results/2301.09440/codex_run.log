+        dual_rotation, dual_faces, face_to_source, cover, rng
+    )
+    return {
+        "n": n,
+        "nesting_bias": nesting_bias,
+        "plane_vertex_count": len(dual_rotation),
+        "face_count": vertex_count,
+        "k": expected_cover,
+        "faces": faces,
+        "answer": answer,
+    }
