# Matrices are tuples (a,b,c,d), interpreted projectively over F_p.
def _det(matrix: tuple[int, int, int, int], p: int) -> int:
    a, b, c, d = matrix
    return (a * d - b * c) % p


def _mat_mul(
    left: tuple[int, int, int, int],
    right: tuple[int, int, int, int],
    p: int,
) -> tuple[int, int, int, int]:
    a, b, c, d = left
    e, f, g, h = right
    return (
        (a * e + b * g) % p,
        (a * f + b * h) % p,
        (c * e + d * g) % p,
        (c * f + d * h) % p,
    )


def _mat_inv(matrix: tuple[int, int, int, int], p: int) -> tuple[int, int, int, int]:
    a, b, c, d = matrix
    inverse_det = pow(_det(matrix, p), -1, p)
    return (
        d * inverse_det % p,
        -b * inverse_det % p,
        -c * inverse_det % p,
        a * inverse_det % p,
    )


def _mobius(matrix: tuple[int, int, int, int], value: int, p: int) -> int:
    """Apply a PGL(2,p) matrix; integer p is the infinity label."""
    a, b, c, d = matrix
    if value == p:
        return p if c == 0 else a * pow(c, -1, p) % p
    denominator = (c * value + d) % p
    if denominator == 0:
        return p
    return (a * value + b) * pow(denominator, -1, p) % p


def _random_matrix(rng: random.Random, p: int) -> tuple[int, int, int, int]:
