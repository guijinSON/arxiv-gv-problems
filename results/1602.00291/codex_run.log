+
+def _torus_distance(L, M, first, second):
+    return _cyclic_distance(first[0], second[0], L) + _cyclic_distance(
+        first[1], second[1], M
+    )
+
+
+def _attack_panel(instances):
+    names = [
+        "outlier_degree_tie_break",
+        "greedy_farthest_first",
+        "random_restart_256",
+        "obvious_two_axis_antipodes",
