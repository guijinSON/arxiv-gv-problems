+
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_started = time.perf_counter()
+    demo_count = enumerate_all(demo)
+    demo_elapsed = time.perf_counter() - demo_started
+    attack_instances = [
