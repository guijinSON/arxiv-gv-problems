+
+    invariant = 0
+    carried = 0
+    unrelated_keys = []
+    selected = []
+    diversity_params = {"n": 1, "span": 20, "axis_gap": 21, "encoding_layers": 2}
+    for seed in range(1000):
+        inst = make_instance(seed=910_000 + seed, **diversity_params)
+        key = canonical_key(inst)
+        if key in unrelated_keys:
