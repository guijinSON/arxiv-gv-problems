+        results[names[2]]["wall_clock_sec"] += time.perf_counter() - started
+
+        started = time.perf_counter()
+        ax, ay = anchor_coordinate
+        obvious = [
+            anchor_coordinate,
+            ((ax + inst["L"] // 2) % inst["L"], ay),
+            (ax, (ay + inst["M"] // 2) % inst["M"]),
