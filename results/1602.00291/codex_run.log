+    changed["r"], changed["t"] = inst["t"], inst["r"]
+    changed["transpose_before_flattening"] = not inst["transpose_before_flattening"]
+    changed["encoding_layers"] = [list(layer) for layer in inst["encoding_layers"]]
+    return changed
