+def _random_unit(rng, modulus):
+    while True:
+        value = rng.randrange(2, modulus)
+        if math.gcd(value, modulus) == 1:
+            return value
+
+
+def _affine_constants(layers, modulus):
+    multiplier = 1
+    shift = 0
+    for a, b in layers:
+        multiplier = a * multiplier % modulus
+        shift = (a * shift + b) % modulus
+    return multiplier, shift
