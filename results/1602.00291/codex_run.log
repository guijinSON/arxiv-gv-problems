+def _pair_ambiguity(first, second, stride):
+    counts = {}
+    ambiguity = 0
+    for left, right in zip(first, second):
+        key = left * stride + right
+        previous = counts.get(key, 0)
+        ambiguity += previous
+        counts[key] = previous + 1
+    return ambiguity
+
