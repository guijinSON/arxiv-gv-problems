+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    duplicated = list(answer)
+    duplicated[2] = duplicated[1]
+    out_of_range = list(answer)
+    out_of_range[-1] = shipping["N"]
+    corruptions = {
+        "drop_one": answer[:-1],
+        "swap_two": swapped,
