+    "easy": {"n": 4, "span": 2, "axis_gap": 2, "encoding_layers": 3},
+    "medium": {"n": 10, "span": 3, "axis_gap": 3, "encoding_layers": 5},
+    "hard": {"n": 24, "span": 4, "axis_gap": 4, "encoding_layers": 7},
