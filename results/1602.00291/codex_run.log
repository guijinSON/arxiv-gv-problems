    return a * d - b * c


def _egcd(a, b):
    old_r, r = a, b
    old_s, s = 1, 0
    old_t, t = 0, 1
    while r:
        q = old_r // r
        old_r, r = r, old_r - q * r
        old_s, s = s, old_s - q * s
        old_t, t = t, old_t - q * t
    return old_r, old_s, old_t


def _conjugator(rng):
    while True:
        p = rng.randint(2, 97)
        r = rng.randint(2, 97)
        if rng.randrange(2):
            p = -p
        if rng.randrange(2):
            r = -r
        gcd, s, t = _egcd(p, r)
        if gcd == -1:
            gcd, s, t = 1, -s, -t
        if gcd == 1:
            # p*s + r*t = 1, so [[p,-t],[r,s]] has determinant one.
