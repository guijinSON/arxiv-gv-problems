+    "easy": {"n": 24, "span": 4, "axis_gap": 0, "encoding_layers": 7},
+    "medium": {"n": 36, "span": 5, "axis_gap": 1, "encoding_layers": 8},
+    "hard": {"n": 54, "span": 6, "axis_gap": 2, "encoding_layers": 9},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+
+STRUCTURAL_HINT = (
+    "A resolving triple on this 4r-by-4t torus is governed by a half-cycle "
