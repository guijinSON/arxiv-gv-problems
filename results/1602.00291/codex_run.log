+    changed["anchor"] = (multiplier * inst["anchor"] + shift) % inst["N"]
+    changed["answer"] = sorted(
+        (multiplier * label + shift) % inst["N"] for label in inst["answer"]
+    )
+    return _refresh_derived(changed)
