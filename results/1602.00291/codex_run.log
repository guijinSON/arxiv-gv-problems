+    elapsed = time.perf_counter() - started
+    verified = answer is not None and verify(inst, answer)[0]
+    return {
+        "name": "orbit-reduced greedy edge-signature/set-cover scan",
+        "complexity": "O(N^2) exact distance evaluations and O(N) memory",
