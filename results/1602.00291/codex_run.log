+        ),
+        "distinct_reasons": len(set(corruption_reasons)),
+        "cases": corruption_cases,
+    }
+
+    realistic = (
+        "I used the torus symmetries and decoded the anchor.\n```text\n<answer>"
+        + ", ".join(map(str, answer))
+        + "</answer>\n```\nThe labels are sorted."
