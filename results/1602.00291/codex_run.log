+        "json_native": json_native,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=_SHIPPING_SEED, **shipping_params)
+    answer = shipping["answer"]
