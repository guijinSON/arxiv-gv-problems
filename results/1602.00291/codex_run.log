        "hits": hits,
        "total": guesses,
        "fraction": hits / guesses,
        "candidate_space": candidate_space,
        "candidate_space_bits": candidate_space.bit_length() - 1,
        "structure_aware_prior": "uniform one-white-choice-per-group vectors",
        "wall_clock_sec": round(guess_elapsed, 6),
    }

    demo = make_instance(seed=7, **DIFFICULTY["demo"])
    demo_start = time.perf_counter()
    demo_count = enumerate_all(demo)
    demo_elapsed = time.perf_counter() - demo_start

    attack_instances = [
        make_instance(seed=81_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
        for seed in range(8)
    ]
    attacks, reference = _attack_panel(attack_instances)
    strongest_name = max(
        attacks,
        key=lambda name: attacks[name]["wall_clock_sec"],
    )
    report["G5_density_and_baseline_cost"] = {
        "pass": demo_count is not None,
        "shipping_sample_hits": hits,
        "shipping_sample_total": guesses,
        "shipping_solution_density": hits / guesses,
        "demo_exact_solution_count": demo_count,
        "demo_candidate_space": search_space(demo),
        "demo_count_wall_clock_sec": round(demo_elapsed, 6),
        "baseline_attack": strongest_name,
        "baseline_attack_iterations": attacks[strongest_name]["attempts"],
        "baseline_attack_wall_clock_sec": attacks[strongest_name]["wall_clock_sec"],
        "reference_operations": reference["operations"],
        "reference_wall_clock_sec": reference["wall_clock_sec"],
    }

    all_failed = all(result["successes"] == 0 for result in attacks.values())
    report["G6_adversary_panel"] = {
        "pass": all_failed and len(attacks) >= 4,
        "attacks": attacks,
        "reference_algorithm": reference,
        "paper_algorithm": {
            "name": "bounded-degeneracy kernelization from Theorem 2",
            "complexity": "O(2^d*d*N^2), followed by exact search on the kernel",
            "generated_graph_degeneracy_bound": shipping["p"] + 1,
        },
    }

    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
    doubled_params["n"] = _next_prime(2 * doubled_params["n"] + 1)
    doubled_params["multiplicity_span"] = 2 * doubled_params["multiplicity_span"] + 1
    scale_start = time.perf_counter()
    doubled = make_instance(seed=2026, **doubled_params)
    build_elapsed = time.perf_counter() - scale_start
    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
    report["G7_scales"] = {
        "pass": doubled_ok and search_space(doubled) > search_space(shipping),
        "shipping_p": shipping["p"],
        "doubled_p": doubled["p"],
        "shipping_candidate_space_bits": search_space(shipping).bit_length() - 1,
        "doubled_candidate_space_bits": search_space(doubled).bit_length() - 1,
        "doubled_build_sec": round(build_elapsed, 6),
        "doubled_verify_reason": doubled_reason,
    }

    invariant = 0
    carried = 0
    unrelated_keys = []
    for seed in range(20):
        inst = make_instance(seed=410_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
        key = canonical_key(inst)
        unrelated_keys.append(key)
        transform_rng = random.Random(510_000 + seed)
        relabelled = _relabel_values(inst, transform_rng)
        rotated = _rotate_groups(inst, 1 + seed % (inst["groups"] - 1))
        composed = _rotate_groups(
            _relabel_values(inst, random.Random(610_000 + seed)),
            1 + (2 * seed) % (inst["groups"] - 1),
        )
        for transformed in (relabelled, rotated, composed):
            invariant += int(canonical_key(transformed) == key)
            carried += int(verify(transformed, transformed["answer"])[0])
    report["G8_canonical_key"] = {
        "pass": invariant == 60 and carried == 60 and len(set(unrelated_keys)) == 20,
        "invariant_relabellings": invariant,
        "real_transformations_verified": carried,
        "unrelated_attempts": 20,
        "unrelated_distinct_keys": len(set(unrelated_keys)),
        "transformations": [
            "independent value relabelling in every white group",
            "cyclic rotation of groups and compatibility bundles",
            "composition of value relabelling with group rotation",
        ],
        "key_scope": "strong multiplicity-multiset invariant, not complete graph canonization",
    }

    worst_answer = [shipping["p"]] * shipping["groups"]
    answer_chars = len(json.dumps(worst_answer))
    answer_tokens = math.ceil(answer_chars / 4)
    answer_elements = shipping["groups"]
    intended_operations = 17 * shipping["groups"] + 12
    arms = {
        name: dict(G9_ORACLE_RESULTS[name])
        for name in ("bare", "hinted", "placebo")
    }
    hinted_rate = (
        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
        if arms["hinted"]["attempts"]
        else 0.0
    )
    placebo_rate = (
        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
        if arms["placebo"]["attempts"]
        else 0.0
    )
    report["G9_no_tool_suitability"] = {
        "pass": answer_chars <= 2000 and answer_elements <= 256 and intended_operations <= 300,
        "arms": arms,
        "hinted_minus_placebo": hinted_rate - placebo_rate,
        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
        "answer_chars": answer_chars,
        "answer_tokens": answer_tokens,
        "answer_elements": answer_elements,
        "intended_route_operations": intended_operations,
        "caps": {"chars": 2000, "elements": 256, "operations": 300},
    }

    report["all_passed"] = all(
        value.get("pass", False)
        for key, value in report.items()
        if key.startswith("G") and isinstance(value, dict)
    )
    return report


if __name__ == "__main__":
    print(json.dumps(selftest(), indent=2, sort_keys=True))

