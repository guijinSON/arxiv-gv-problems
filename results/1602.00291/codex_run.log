+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariant = 0
+    carried = 0
+    unrelated_keys = []
+    selected = []
+    diversity_params = {"n": 1, "span": 20, "axis_gap": 21, "encoding_layers": 2}
+    for seed in range(1000):
