+def _edge_vector(L, M, coordinate):
+    dx, dy, horizontal_x, vertical_y = _landmark_arrays(L, M, coordinate)
+    result = array("H")
+    for x in range(L):
+        for y in range(M):
+            result.append(horizontal_x[x] + dy[y])
+            result.append(dx[x] + vertical_y[y])
+    return result
