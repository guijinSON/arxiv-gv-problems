            invariance_failures.append([offset, "panel_reorder_key"])
        if verify(reordered, reordered["answer"])[0]:
            witness_checks += 1
        else:
            invariance_failures.append([offset, "panel_reorder_witness"])

        swapped = copy.deepcopy(inst)
