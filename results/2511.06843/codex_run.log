+        and parse_answer("garbage") is None,
+        "parsed_equals_answer": parsed == ship["answer"],
+        "garbage_returns_none": parse_answer("garbage") is None,
+    }
+
+    # G4: uniform sampling from the exact promised affine matrix language.
