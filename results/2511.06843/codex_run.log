+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 5, "prime": 17, "panels": 1},
+    "easy": {"n": 40, "prime": 1009, "panels": 6},
+    "medium": {"n": 60, "prime": 1009, "panels": 8},
+    "hard": {"n": 80, "prime": 1009, "panels": 10},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
