"0.900em">±</mo><mi mathsize="0.900em">ϵ</mi></mrow></mrow><mtext mathsize="0.900em">;</mtext></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">±</mo><mi mathsize="0.900em">ϵ</mi></mrow><mo mathsize="0.900em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext mathsize="0.900em">if </mtext><mrow><mrow><mi mathsize="0.900em">𝐱</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi mathsize="0.900em">v</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">n</mi><mn mathsize="0.900em">1</mn></msub></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">±</mo><mrow><mi mathsize="0.900em">ϵ</mi><mo lspace="0.800em" rspace="0em">​</mo><mtext mathsize="0.900em">and</mtext><mo lspace="0.800em" rspace="0em">​</mo><mi mathsize="0.900em">𝐱</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi mathsize="0.900em">v</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">n</mi><mn mathsize="0.900em">2</mn></msub></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">±</mo><mi mathsize="0.900em">ϵ</mi></mrow></mrow><mtext mathsize="0.900em">.</mtext></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathbf{x}[v_{out}]=\left\{\begin{array}[]{ll}1\pm\epsilon,&amp;\hbox{if $\mathbf{x}[v_{in_{1}}]=1\pm\epsilon\,\,\ \text{or}\,\,\ \mathbf{x}[v_{in_{2}}]=1\pm\epsilon$;}\\
464:0\pm\epsilon,&amp;\hbox{if $\mathbf{x}[v_{in_{1}}]=0\pm\epsilon\,\,\ \text{and}\,\,\ \mathbf{x}[v_{in_{2}}]=0\pm\epsilon$.}\end{array}\right.</annotation></semantics></math></td></tr>
