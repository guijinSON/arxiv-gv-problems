new file mode 100644
index 0000000000000000000000000000000000000000..a103419d3c8fb6cdeef0189a653ab7c85dd34f77
--- /dev/null
+++ b/gen_1609_05136.py
@@ -0,0 +1,835 @@
+"""Self-contained verified problem generator for arXiv:1609.05136.
+
+The family is an exact, promised-slot form of Consensus-Halving with rational
+step-function value densities.  Certificates are planted by inverse generation;
+verification integrates every density exactly over the proposed alternating
+partition.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+from fractions import Fraction
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "After centering the 1/3 density weights at 2, their signs form Walsh "
+    "characters indexed by the displayed binary codes."
+)
+PLACEBO_HINT: str = (
+    "Keep the interval endpoints and rational density weights aligned with the "
+    "displayed indexing conventions throughout."
+)
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "optimization",
+    "object_regime": "rational_exact",
+    "computational_core": "linear_algebra",
+    "certificate_form": "rational",
+    "native_objects": [
+        "interval with rational step-density valuations",
+        "alternating consensus-halving partition",
+        "rational cut vector",
+    ],
+    "verification_operations": [
+        "exact rational interval integration",
+        "exact rational addition",
+        "equality comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Recenter every cut in its slot and absorb the alternating label sign; "
+        "the dense balance equations become a permuted Walsh transform plus one "
+        "rank-one term, whereas an unstructured treatment requires dense exact "
+        "elimination."
+    ),
+    "hardness_basis": (
+        "Track B: exact Gauss-Jordan elimination solves the promised balance "
+        "system in O(n^3) rational field operations; at the shipping n=32 preset "
+        "the reference implementation uses about 65,000 field operations (the "
+        "measured median wall-clock is recorded by selftest), while the Walsh "
+        "change-of-variables route uses 289 exact arithmetic operations."
+    ),
+    "max_answer_tokens": 120,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 2, "q": 5},
+    "easy": {"n": 4, "q": 11},
+    "medium": {"n": 8, "q": 31},
+    "hard": {"n": 32, "q": 257},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "Exactly n rational cuts. Cut j is an interior point of its designated "
+        "slot (3j+1,3j+2) on the 1/(2q) grid; cuts are therefore automatically "
+        "strictly increasing and the partition labels alternate +,-,+,... from 0."
+    ),
+    "bounds": {
+        "cuts": "n",
+        "grid_denominator": "2q",
+        "choices_per_cut": "2q-1",
+        "max_shipping_cuts": 32,
+        "max_shipping_atoms": 64,
+    },
+}
+
+NOTES: str = (
+    "Section 2 (Preliminaries) fixes the object as an interval, defines cuts and "
+    "+/- labels, and permits step-function value densities; it also fixes the "
+    "discrepancy inequality. Section 3, Lemma 1 supplies the paper's central hard "
+    "regime: a constant-error solution with n cuts is PPAD-hard, even with a "
+    "constant number of extra cuts. Section 5 and the related-work discussion say "
+    "what produces a general certificate: the Simmons--Su/Tucker path-following "
+    "protocol, whose worst-case running time is exponential in n. That theorem is "
+    "not claimed for this inverse-generated distribution. Here the promise of one "
+    "cut in each displayed slot linearizes balance, so exact Gauss-Jordan "
+    "elimination is disclosed as the Track B reference algorithm. Plants and all "
+    "decoy coordinates use the same grid. Guard-skew, one-pass greedy, random-grid "
+    "restart, and common-offset attacks are tested; row/column codes and guard "
+    "blocks are independently permuted to remove positional leakage."
+)
+
+# Filled from the script-owned hardening runs before shipping.  The arms are a
+# recorded diagnostic; only hinted_verdict and the size/effort caps gate G9.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 3},
+        "hinted": {"solved": 0, "attempts": 3},
+        "placebo": {"solved": 0, "attempts": 3},
+    },
+    "hinted_verdict": "hardened",
+}
+
+
+def _rat(value: Fraction | int) -> list[int]:
+    f = value if isinstance(value, Fraction) else Fraction(value)
+    return [f.numerator, f.denominator]
+
+
+def _frac(value) -> Fraction:
+    if isinstance(value, bool):
+        raise ValueError("boolean is not a rational")
+    if isinstance(value, int):
+        return Fraction(value)
+    if (
+        isinstance(value, (list, tuple))
+        and len(value) == 2
+        and all(isinstance(x, int) and not isinstance(x, bool) for x in value)
+        and value[1] != 0
+    ):
+        return Fraction(value[0], value[1])
+    raise ValueError("expected [numerator, denominator]")
+
+
+def _ftext(value) -> str:
+    f = _frac(value)
+    return str(f.numerator) if f.denominator == 1 else f"{f.numerator}/{f.denominator}"
+
+
+def _is_power_of_two(n: int) -> bool:
+    return n > 0 and (n & (n - 1)) == 0
+
+
+def _hadamard_sign(row_code: int, col_code: int) -> int:
+    return -1 if ((row_code & col_code).bit_count() & 1) else 1
+
+
+def _is_prime(q: int) -> bool:
+    if q < 2:
+        return False
+    if q % 2 == 0:
+        return q == 2
+    d = 3
+    while d * d <= q:
+        if q % d == 0:
+            return False
+        d += 2
+    return True
+
+
+def _next_prime(q: int) -> int:
+    q = max(3, q | 1)
+    while not _is_prime(q):
+        q += 2
+    return q
+
+
+def _make_instance(n, q, seed=0) -> dict:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 2 or not _is_power_of_two(n):
+        raise ValueError("n must be a power of two and at least 2")
+    if isinstance(q, bool) or not isinstance(q, int) or q < 3 or not _is_prime(q):
+        raise ValueError("q must be an odd prime at least 3")
+    rng = random.Random(seed)
+
+    row_codes = list(range(n))
+    col_codes = list(range(n))
+    guards = list(range(n))
+    rng.shuffle(row_codes)
+    rng.shuffle(col_codes)
+    rng.shuffle(guards)
+
+    # z_j = (-1)^j(2*x_j-1) = a_j/q.  Resample the whole vector until the
+    # answer is visibly nonconstant and every b_i retains denominator q; this
+    # keeps the compact integer transform honest and avoids zero-skew outliers.
+    for _ in range(10000):
+        a = [rng.randrange(-q + 1, q) for _ in range(n)]
+        if len(set(a)) < 3 and n >= 3:
+            continue
+        b_nums = []
+        for rcode in row_codes:
+            total = 0
+            for j, ccode in enumerate(col_codes):
+                total += (2 + _hadamard_sign(rcode, ccode)) * a[j]
+            b_nums.append(total)
+        if all(v % q for v in b_nums):
+            break
+    else:  # deterministic construction should never approach this in practice
+        raise RuntimeError("could not sample nonsingular rational skews")
+
+    agents = []
+    for row, rcode in enumerate(row_codes):
+        g = guards[row]
+        weights = [2 + _hadamard_sign(rcode, ccode) for ccode in col_codes]
+        row_mass = sum(weights)
+        left = Fraction(2 * row_mass + 1)
+        b = Fraction(b_nums[row], q)
+        right = left + (b if g % 2 == 0 else -b)
+        agents.append(
+            {
+                "code": rcode,
+                "guard": g,
+                "left": _rat(left),
+                "right": _rat(right),
+                "weights": [_rat(w) for w in weights],
+            }
+        )
+    rng.shuffle(agents)
+
+    cuts = []
+    for j, numerator in enumerate(a):
+        x = Fraction(q + (numerator if j % 2 == 0 else -numerator), 2 * q)
+        cuts.append(_rat(Fraction(3 * j + 1) + x))
+
+    return {
+        "family": "exact promised-slot consensus-halving",
+        "n": n,
+        "q": q,
+        "length": 3 * n,
+        "slot_codes": col_codes,
+        "agents": agents,
+        "answer": cuts,
+    }
+
+
+# Keep the public signature exactly as required while making q explicit.
+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate exact rational cuts and compose valuations around them."""
+    if "q" not in params:
+        raise ValueError("q is required")
+    q = params.pop("q")
+    if params:
+        raise ValueError("unknown parameters: " + ", ".join(sorted(params)))
+    return _make_instance(n=n, q=q, seed=seed)
+
+
+def _answer_text(answer) -> str:
+    return ", ".join(_ftext(x) for x in answer)
+
+
+def render(inst) -> str:
+    n, q = inst["n"], inst["q"]
+    width = max(1, (n - 1).bit_length())
+    slots = " ".join(
+        f"{j}:{inst['slot_codes'][j]:0{width}b}" for j in range(n)
+    )
+    rows = []
+    for i, agent in enumerate(inst["agents"], 1):
+        weights = " ".join(_ftext(x) for x in agent["weights"])
+        rows.append(
+            f"A{i}: code={agent['code']:0{width}b}; guard={agent['guard']}; "
+            f"L={_ftext(agent['left'])}; R={_ftext(agent['right'])}; W={weights}"
+        )
+
+    statement = f"""EXACT PROMISED-SLOT CONSENSUS-HALVING
+
+The object is the closed interval [0,{inst['length']}]. There are n={n} agents.
+A value density is constant on each interval stated below and zero elsewhere;
+the value of a portion is the exact integral of that density over the portion.
+All endpoints have measure zero.
+
+Choose exactly n rational cuts t_0<...<t_{n-1}. For every j=0,...,{n-1}, cut
+t_j must lie strictly inside its designated slot (3j+1,3j+2) and must be on
+the 1/(2q) grid, where q={q}; equivalently 2q*t_j is an integer. Label [0,t_0]
+with +, alternate labels at every cut, and label the final interval accordingly.
+For every agent, the total value of the + portion must equal the total value of
+the - portion exactly (epsilon=0).
+
+The slot-code list is in left-to-right j order:
+{slots}
+
+An agent row "guard=g; L; R; W=w_0 ... w_{n-1}" defines its full density:
+L on [3g,3g+1], R on [3g+2,3g+3], and w_j on slot [3j+1,3j+2].
+These intervals are disjoint. Agent rows may appear in any order. The binary
+codes are annotations; the listed rational densities are the authoritative data.
+
+{chr(10).join(rows)}
+
+Give your final answer inside <answer></answer> tags, as exactly {n}
+comma-separated reduced or unreduced rational numbers num/den in increasing
+left-to-right order. Denominators must be nonzero; no brackets or repeats.
+Format example for a two-cut instance: <answer>3/2, 9/2</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text) -> object | None:
+    try:
+        matches = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", str(text), re.I | re.S)
+        if not matches:
+            return None
+        body = matches[-1].strip()
+        for fence in ("~~~", chr(96) * 3):
+            if body.startswith(fence) and body.endswith(fence):
+                body = re.sub(r"^" + re.escape(fence) + r"[^\n]*\n?", "", body)
+                body = re.sub(r"\n?" + re.escape(fence) + r"$", "", body).strip()
+        if body.startswith("[") and body.endswith("]"):
+            body = body[1:-1].strip()
+        if not body:
+            return []
+        tokens = [x.strip() for x in body.split(",")]
+        out = []
+        for token in tokens:
+            m = re.fullmatch(r"([+-]?\d+)(?:\s*/\s*([+-]?\d+))?", token)
+            if not m:
+                return None
+            num = int(m.group(1))
+            den = int(m.group(2) or 1)
+            if den == 0:
+                return None
+            out.append(_rat(Fraction(num, den)))
+        return out
+    except Exception:
+        return None
+
+
+def _validated_cuts(inst, answer):
+    if not isinstance(answer, list):
+        return None, "answer must be a list of rational cuts"
+    if not answer:
+        return None, "answer is empty"
+    n = inst["n"]
+    if len(answer) != n:
+        return None, f"wrong number of cuts: expected {n}"
+    cuts = []
+    for i, raw in enumerate(answer):
+        try:
+            cuts.append(_frac(raw))
+        except (TypeError, ValueError, ZeroDivisionError):
+            return None, f"cut {i} is not a valid rational"
+    length = Fraction(inst["length"])
+    for i, cut in enumerate(cuts):
+        if cut < 0 or cut > length:
+            return None, f"cut {i} lies outside [0,{inst['length']}]"
+    if len(set(cuts)) != n:
+        return None, "cuts must be distinct"
+    if any(cuts[i] >= cuts[i + 1] for i in range(n - 1)):
+        return None, "cuts must be strictly increasing"
+    for j, cut in enumerate(cuts):
+        if not (3 * j + 1 < cut < 3 * j + 2):
+            return None, f"cut {j} is outside its designated open interval"
+        if (cut * (2 * inst["q"])).denominator != 1:
+            return None, f"cut {j} is off the required 1/(2q) grid"
+    return cuts, "ok"
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Integrate every stated step density exactly; never consult inst['answer']."""
+    cuts, reason = _validated_cuts(inst, answer)
+    if cuts is None:
+        return False, reason
+    offsets = [cuts[j] - (3 * j + 1) for j in range(inst["n"])]
+    for ai, agent in enumerate(inst["agents"], 1):
+        g = agent["guard"]
+        discrepancy = ((-1) ** g) * (_frac(agent["left"]) - _frac(agent["right"]))
+        for j, raw_weight in enumerate(agent["weights"]):
+            signed_slot = (2 * offsets[j] - 1) if j % 2 == 0 else (1 - 2 * offsets[j])
+            discrepancy += _frac(raw_weight) * signed_slot
+        if discrepancy:
+            return False, f"agent {ai} is not balanced (discrepancy {_ftext(_rat(discrepancy))})"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Sample uniformly from the fully structure-aware promised grid language."""
+    q = inst["q"]
+    return [
+        _rat(Fraction(3 * j + 1) + Fraction(rng.randrange(1, 2 * q), 2 * q))
+        for j in range(inst["n"])
+    ]
+
+
+def search_space(inst) -> int | None:
+    return (2 * inst["q"] - 1) ** inst["n"]
+
+
+def enumerate_all(inst) -> int | None:
+    space = search_space(inst)
+    if space is None or space > 200_000:
+        return None
+    q, n = inst["q"], inst["n"]
+    count = 0
+    for ks in itertools.product(range(1, 2 * q), repeat=n):
+        candidate = [
+            _rat(Fraction(3 * j + 1) + Fraction(ks[j], 2 * q)) for j in range(n)
+        ]
+        if verify(inst, candidate)[0]:
+            count += 1
+    return count
+
+
+def _primitive_coefficients(agent):
+    values = [_frac(agent["left"]), _frac(agent["right"])] + [
+        _frac(x) for x in agent["weights"]
+    ]
+    common = 1
+    for value in values:
+        common = math.lcm(common, value.denominator)
+    ints = [value.numerator * (common // value.denominator) for value in values]
+    divisor = 0
+    for value in ints:
+        divisor = math.gcd(divisor, abs(value))
+    if divisor:
+        ints = [value // divisor for value in ints]
+    if next((v for v in ints if v), 1) < 0:
+        ints = [-v for v in ints]
+    return tuple(ints)
+
+
+def _canonical_payload(inst, reflected=False):
+    n = inst["n"]
+    rows = []
+    for agent in inst["agents"]:
+        coeff = list(_primitive_coefficients(agent))
+        left, right, weights = coeff[0], coeff[1], coeff[2:]
+        guard = agent["guard"]
+        if reflected:
+            guard = n - 1 - guard
+            left, right = right, left
+            weights = list(reversed(weights))
+        rows.append((guard, left, right, tuple(weights)))
+    rows.sort()
+    return (n, inst["q"], tuple(rows))
+
+
+def canonical_key(inst) -> str:
+    """Canonicalize agent order, positive per-agent scaling, and reflection."""
+    payload = min(_canonical_payload(inst, False), _canonical_payload(inst, True))
+    blob = repr(payload).encode("utf-8")
+    return hashlib.sha256(blob).hexdigest()
+
+
+def _scaled_instance(inst, rng):
+    out = json.loads(json.dumps(inst))
+    for agent in out["agents"]:
+        factor = Fraction(rng.randrange(1, 8), rng.randrange(1, 8))
+        agent["left"] = _rat(_frac(agent["left"]) * factor)
+        agent["right"] = _rat(_frac(agent["right"]) * factor)
+        agent["weights"] = [_rat(_frac(x) * factor) for x in agent["weights"]]
+    rng.shuffle(out["agents"])
+    return out
+
+
+def _reflected_instance(inst):
+    out = json.loads(json.dumps(inst))
+    n = out["n"]
+    out["slot_codes"] = list(reversed(out["slot_codes"]))
+    for agent in out["agents"]:
+        agent["guard"] = n - 1 - agent["guard"]
+        agent["left"], agent["right"] = agent["right"], agent["left"]
+        agent["weights"] = list(reversed(agent["weights"]))
+    return out
+
+
+def _reflected_answer(inst, answer):
+    length = Fraction(inst["length"])
+    return [_rat(length - _frac(cut)) for cut in reversed(answer)]
+
+
+def _linear_system(inst):
+    rows = []
+    rhs = []
+    for agent in inst["agents"]:
+        rows.append([_frac(x) for x in agent["weights"]])
+        skew = _frac(agent["right"]) - _frac(agent["left"])
+        rhs.append(skew if agent["guard"] % 2 == 0 else -skew)
+    return rows, rhs
+
+
+def _gauss_jordan_solve(matrix, rhs):
+    """Return (solution, counted rational field operations)."""
+    n = len(matrix)
+    a = [list(row) + [rhs[i]] for i, row in enumerate(matrix)]
+    operations = 0
+    for col in range(n):
+        pivot = next((r for r in range(col, n) if a[r][col]), None)
+        if pivot is None:
+            raise ValueError("singular balance system")
+        if pivot != col:
+            a[col], a[pivot] = a[pivot], a[col]
+        p = a[col][col]
+        if p != 1:
+            for k in range(col, n + 1):
+                a[col][k] /= p
+                operations += 1
+        for r in range(n):
+            if r == col or not a[r][col]:
+                continue
+            factor = a[r][col]
+            for k in range(col, n + 1):
+                a[r][k] -= factor * a[col][k]
+                operations += 2
+    return [a[i][n] for i in range(n)], operations
+
+
+def _reference_algorithm(inst):
+    matrix, rhs = _linear_system(inst)
+    z, operations = _gauss_jordan_solve(matrix, rhs)
+    cuts = []
+    for j, zj in enumerate(z):
+        x = (1 + (zj if j % 2 == 0 else -zj)) / 2
+        cuts.append(_rat(Fraction(3 * j + 1) + x))
+    return cuts, operations
+
+
+def _quantize_offset(value: Fraction, q: int) -> Fraction:
+    scaled = value * (2 * q)
+    # Round halves away from zero is immaterial here; clamp to the open slot.
+    k = (scaled.numerator * 2 + scaled.denominator) // (2 * scaled.denominator)
+    k = max(1, min(2 * q - 1, k))
+    return Fraction(k, 2 * q)
+
+
+def _attack_guard_skew(inst, rng=None):
+    del rng
+    q, n = inst["q"], inst["n"]
+    offsets = [Fraction(1, 2) for _ in range(n)]
+    for agent in inst["agents"]:
+        j = agent["guard"]
+        b = _frac(agent["right"]) - _frac(agent["left"])
+        if j % 2:
+            b = -b
+        row_mass = sum((_frac(x) for x in agent["weights"]), Fraction())
+        zguess = b / row_mass
+        xguess = (1 + (zguess if j % 2 == 0 else -zguess)) / 2
+        offsets[j] = _quantize_offset(xguess, q)
+    return [_rat(Fraction(3 * j + 1) + offsets[j]) for j in range(n)], n
+
+
+def _discrepancy(agent, offsets):
+    g = agent["guard"]
+    value = ((-1) ** g) * (_frac(agent["left"]) - _frac(agent["right"]))
+    for j, weight in enumerate(agent["weights"]):
+        signed = (2 * offsets[j] - 1) if j % 2 == 0 else (1 - 2 * offsets[j])
+        value += _frac(weight) * signed
+    return value
+
+
+def _attack_greedy_one_pass(inst, rng=None):
+    del rng
+    q, n = inst["q"], inst["n"]
+    offsets = [Fraction(1, 2) for _ in range(n)]
+    for agent in inst["agents"]:
+        j = agent["guard"]
+        residual = _discrepancy(agent, offsets)
+        coefficient = (2 if j % 2 == 0 else -2) * _frac(agent["weights"][j])
+        offsets[j] = _quantize_offset(offsets[j] - residual / coefficient, q)
+    return [_rat(Fraction(3 * j + 1) + offsets[j]) for j in range(n)], n
+
+
+def _attack_shared_offset(inst, rng=None):
+    del rng
+    q, n = inst["q"], inst["n"]
+    for k in range(1, 2 * q):
+        x = Fraction(k, 2 * q)
+        candidate = [_rat(Fraction(3 * j + 1) + x) for j in range(n)]
+        if verify(inst, candidate)[0]:
+            return candidate, k
+    return None, 2 * q - 1
+
+
+def _attack_random_restart(inst, rng, restarts=512):
+    for attempt in range(1, restarts + 1):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate, attempt
+    return None, restarts
+
+
+def _intended_operations(n: int) -> int:
+    # Fast Walsh transform + n output scalings + rank-one correction + cut map.
+    return n * int(math.log2(n)) + n + (n - 2) + 3 + 2 * n
+
+
+def _answer_atoms(value) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(v) for v in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(v) for v in value)
+    return 1
+
+
+def escalate(params) -> dict | str | None:
+    """Increase arithmetic haystack at fixed 32-cut witness length."""
+    n = int(params["n"])
+    q = int(params["q"])
+    if n < 32:
+        return {"n": min(32, n * 2), "q": _next_prime(4 * q + 1)}
+    if len(str(q)) >= 24:
+        return "cap_bound"
+    return {"n": n, "q": _next_prime(8 * q + 1)}
+
+
+def selftest() -> dict:
+    report = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
+
+    planted = json_ok = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 19):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            if not ok:
+                raise AssertionError(f"G1 {preset}/{seed}: {why}")
+            planted += 1
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_ok += 1
+    report["G1_planted_verifies"] = {
+        "pass": planted == 12 and json_ok == 12,
+        "verified": planted,
+        "json_round_trips": json_ok,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=20260904, **ship_params)
+    answer = json.loads(json.dumps(inst["answer"]))
+    corruptions = {}
+    variants = {
+        "drop": answer[:-1],
+        "swap": [answer[1], answer[0]] + answer[2:],
+        "duplicate": [answer[0], answer[0]] + answer[2:],
+        "empty": [],
+        "out_of_range": [[-1, 1]] + answer[1:],
+    }
+    reasons = []
+    for name, candidate in variants.items():
+        ok, why = verify(inst, candidate)
+        corruptions[name] = {"rejected": not ok, "reason": why}
+        reasons.append(why)
+    report["G2_rejects_corruption"] = {
+        "pass": all(v["rejected"] for v in corruptions.values()) and len(set(reasons)) == 5,
+        "distinct_reasons": len(set(reasons)),
+        "cases": corruptions,
+    }
+
+    response = (
+        "I integrated each row exactly. My final cuts are:\n"
+        "<answer>```text\n" + _answer_text(answer) + "\n```</answer>\n"
+        "The alternating labels start with plus as requested."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_cuts": len(parsed) if isinstance(parsed, list) else 0,
+    }
+
+    samples = 200_000
+    guess_rng = random.Random(9141609)
+    hits = 0
+    t0 = time.perf_counter()
+    for _ in range(samples):
+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            hits += 1
+    guess_seconds = time.perf_counter() - t0
+    report["G4_guess_resistance"] = {
+        "pass": hits / samples < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "probability": hits / samples,
+        "structure_aware_space": search_space(inst),
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+
+    attack_names = {
+        "outlier_guard_skew": _attack_guard_skew,
+        "greedy_one_pass": _attack_greedy_one_pass,
+        "random_restart_512": _attack_random_restart,
+        "shared_offset_ansatz": _attack_shared_offset,
+    }
+    attack_results = {name: {"successes": 0, "attempts": 8} for name in attack_names}
+    attack_seconds = {name: [] for name in attack_names}
+    attack_iterations = {name: [] for name in attack_names}
+    reference_seconds = []
+    reference_operations = []
+    reference_successes = 0
+    for seed in range(8):
+        trial = make_instance(seed=7000 + seed, **ship_params)
+        for name, attack in attack_names.items():
+            rng = random.Random(800000 + 97 * seed)
+            start = time.perf_counter()
+            candidate, iterations = attack(trial, rng)
+            elapsed = time.perf_counter() - start
+            won = candidate is not None and verify(trial, candidate)[0]
+            attack_results[name]["successes"] += int(won)
+            attack_seconds[name].append(elapsed)
+            attack_iterations[name].append(iterations)
+        start = time.perf_counter()
+        reference, operations = _reference_algorithm(trial)
+        reference_seconds.append(time.perf_counter() - start)
+        reference_operations.append(operations)
+        reference_successes += int(verify(trial, reference)[0])
+    for name in attack_names:
+        attack_results[name]["median_wall_clock_sec"] = round(
+            statistics.median(attack_seconds[name]), 6
+        )
+        attack_results[name]["median_iterations"] = statistics.median(
+            attack_iterations[name]
+        )
+
+    strongest = max(attack_names, key=lambda name: statistics.median(attack_seconds[name]))
+    baseline_seconds = statistics.median(attack_seconds[strongest])
+    baseline_iterations = statistics.median(attack_iterations[strongest])
+    report["G5_density_and_baseline"] = {
+        "pass": demo_count == 1 and hits / samples < 1e-6 and baseline_seconds >= 0,
+        "shipping_solution_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_sampled_density": hits / samples,
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_count": search_space(demo),
+        "strongest_failing_attack": strongest,
+        "baseline_wall_clock_sec": round(baseline_seconds, 6),
+        "baseline_iterations": baseline_iterations,
+    }
+
+    report["G6_adversary_panel"] = {
+        "pass": all(v["successes"] == 0 and v["attempts"] >= 8 for v in attack_results.values())
+        and reference_successes == 8,
+        "attacks": attack_results,
+        "reference_algorithm": {
+            "name": "exact Gauss-Jordan elimination on promised balance equations",
+            "complexity": "O(n^3) rational field operations",
+            "wall_clock_sec": round(statistics.median(reference_seconds), 6),
+            "operations": int(statistics.median(reference_operations)),
+            "successes": reference_successes,
+            "attempts": 8,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    doubled = make_instance(n=2 * ship_params["n"], q=ship_params["q"], seed=12345)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and search_space(doubled) > search_space(inst),
+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+        "shipping_space_bits": round(math.log2(search_space(inst)), 3),
+        "doubled_space_bits": round(math.log2(search_space(doubled)), 3),
+    }
+
+    invariant = carried = 0
+    for seed in range(20):
+        base = make_instance(seed=9000 + seed, **ship_params)
+        key = canonical_key(base)
+        transforms = []
+        reordered = json.loads(json.dumps(base))
+        reordered["agents"] = list(reversed(reordered["agents"]))
+        transforms.append((reordered, base["answer"]))
+        scaled = _scaled_instance(base, random.Random(seed))
+        transforms.append((scaled, base["answer"]))
+        reflected = _reflected_instance(base)
+        reflected_answer = _reflected_answer(base, base["answer"])
+        transforms.append((reflected, reflected_answer))
+        reflected_scaled = _scaled_instance(reflected, random.Random(100 + seed))
+        transforms.append((reflected_scaled, reflected_answer))
+        for transformed, carried_answer in transforms:
+            invariant += int(canonical_key(transformed) == key)
+            carried += int(verify(transformed, carried_answer)[0])
+    distinct_keys = {
+        canonical_key(make_instance(seed=12000 + seed, **ship_params)) for seed in range(20)
+    }
+    report["G8_canonical_key"] = {
+        "pass": invariant == 80 and carried == 80 and len(distinct_keys) == 20,
+        "invariance_checks": invariant,
+        "invariance_total": 80,
+        "carried_witness_checks": carried,
+        "carried_witness_total": 80,
+        "distinct_unrelated_keys": len(distinct_keys),
+        "distinctness_total": 20,
+        "symmetries": ["agent reorder", "positive agent scaling", "global reflection"],
+    }
+
+    answer_blob = json.dumps(inst["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _answer_atoms(inst["answer"])
+    intended = _intended_operations(inst["n"])
+    arms = G9_RESULTS["arms"]
+    hinted = G9_RESULTS["hinted_verdict"] == "hardened"
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended <= 300
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended,
+    }
+
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and key[1:2].isdigit()
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

