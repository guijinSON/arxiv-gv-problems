"0.900em">±</mo><mi mathsize="0.900em">ϵ</mi></mrow></mrow><mtext mathsize="0.900em">;</mtext></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">±</mo><mi mathsize="0.900em">ϵ</mi></mrow><mo mathsize="0.900em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext mathsize="0.900em">if </mtext><mrow><mrow><mi mathsize="0.900em">𝐱</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi mathsize="0.900em">v</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">n</mi><mn mathsize="0.900em">1</mn></msub></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">±</mo><mrow><mi mathsize="0.900em">ϵ</mi><mo lspace="0.800em" rspace="0em">​</mo><mtext mathsize="0.900em">or</mtext><mo lspace="0.800em" rspace="0em">​</mo><mi mathsize="0.900em">𝐱</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi mathsize="0.900em">v</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">n</mi><mn mathsize="0.900em">2</mn></msub></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">±</mo><mi mathsize="0.900em">ϵ</mi></mrow></mrow><mtext mathsize="0.900em">.</mtext></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathbf{x}[v_{out}]=\left\{\begin{array}[]{ll}1\pm\epsilon,&amp;\hbox{if $\mathbf{x}[v_{in_{1}}]=1\pm\epsilon\,\,\ \text{and}\,\,\ \mathbf{x}[v_{in_{2}}]=1\pm\epsilon$;}\\
469:0\pm\epsilon,&amp;\hbox{if $\mathbf{x}[v_{in_{1}}]=0\pm\epsilon\,\,\ \text{or}\,\,\ \mathbf{x}[v_{in_{2}}]=0\pm\epsilon$.}\end{array}\right.</annotation></semantics></math></td></tr>
472:<td id="S2.T1.3.10.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><math id="S2.T1.m20" class="ltx_Math" alttext="\mathbf{x}[v_{out}]=\left\{\begin{array}[]{ll}1\pm\epsilon,&amp;\hbox{if $\mathbf{x}[v_{in_{1}}]=0\pm\epsilon$;}\\
473:0\pm\epsilon,&amp;\hbox{if $\mathbf{x}[v_{in_{1}}]=1\pm\epsilon$.}\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">𝐱</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi mathsize="0.900em">v</mi><mrow><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">±</mo><mi mathsize="0.900em">ϵ</mi></mrow><mo mathsize="0.900em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext mathsize="0.900em">if </mtext><mrow><mrow><mi mathsize="0.900em">𝐱</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi mathsize="0.900em">v</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">n</mi><mn mathsize="0.900em">1</mn></msub></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">±</mo><mi mathsize="0.900em">ϵ</mi></mrow></mrow><mtext mathsize="0.900em">;</mtext></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">±</mo><mi mathsize="0.900em">ϵ</mi></mrow><mo mathsize="0.900em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext mathsize="0.900em">if </mtext><mrow><mrow><mi mathsize="0.900em">𝐱</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi mathsize="0.900em">v</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">n</mi><mn mathsize="0.900em">1</mn></msub></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">±</mo><mi mathsize="0.900em">ϵ</mi></mrow></mrow><mtext mathsize="0.900em">.</mtext></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathbf{x}[v_{out}]=\left\{\begin{array}[]{ll}1\pm\epsilon,&amp;\hbox{if $\mathbf{x}[v_{in_{1}}]=0\pm\epsilon$;}\\
474:0\pm\epsilon,&amp;\hbox{if $\mathbf{x}[v_{in_{1}}]=1\pm\epsilon$.}\end{array}\right.</annotation></semantics></math></td></tr>
481:<p id="Thmlemma1.p1.1" class="ltx_p"><span id="Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">There exists a constant <math id="Thmlemma1.p1.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math> such that <math id="Thmlemma1.p1.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-<span id="Thmlemma1.p1.1.1.1" class="ltx_text ltx_font_smallcaps">Gcircuit</span> is PPAD-complete.</span></p>
487:<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span><math id="S3.m1" class="ltx_Math" alttext="(n,n+k,\epsilon)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mi>k</mi></mrow><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,n+k,\epsilon)</annotation></semantics></math>-<span id="S3.1" class="ltx_text ltx_font_smallcaps">ConHalving</span> is PPAD-hard</h2>
490:<p id="S3.p1.1" class="ltx_p">In this section, we will prove that finding an approximate partition for Consensus-halving using <math id="S3.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> cuts is PPAD-hard, even if the allowed discrepancy between the two portions is a constant. We describe the reduction from <math id="S3.p1.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-<span id="S3.p1.1.1" class="ltx_text ltx_font_smallcaps">Gcircuit</span> that we will be using for the PPAD-hardness proof. Given an instance <math id="S3.p1.m3" class="ltx_Math" alttext="S=(V,\mathcal{T})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S=(V,\mathcal{T})</annotation></semantics></math> of <math id="S3.p1.m4" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-<span id="S3.p1.1.2" class="ltx_text ltx_font_smallcaps">Gcircuit</span>, we will construct an instance of <math id="S3.p1.m5" class="ltx_Math" alttext="(n,n,\epsilon^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>n</mi><mo>,</mo><msup><mi>ϵ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,n,\epsilon^{\prime})</annotation></semantics></math>-<span id="S3.p1.1.3" class="ltx_text ltx_font_smallcaps">ConHalving</span> with <math id="S3.p1.m6" class="ltx_Math" alttext="n=2N" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">n=2N</annotation></semantics></math> agents, in which each node <math id="S3.p1.m7" class="ltx_Math" alttext="v_{i}\in V" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v_{i}\in V</annotation></semantics></math> of the circuit will correspond to two agents <math id="S3.p1.m8" class="ltx_Math" alttext="var_{i}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">var_{i}</annotation></semantics></math> and <math id="S3.p1.m9" class="ltx_Math" alttext="copy_{i}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">copy_{i}</annotation></semantics></math> and where <math id="S3.p1.m10" class="ltx_Math" alttext="\epsilon^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ϵ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\epsilon^{\prime}</annotation></semantics></math> will be defined later. As a matter of convenience in the reduction, we will assume that for every gate <math id="S3.p1.m11" class="ltx_Math" alttext="(G,v_{in_{1}},v_{in_{2}},v_{out},\alpha)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><msub><mi>v</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>2</mn></msub></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,v_{in_{1}},v_{in_{2}},v_{out},\alpha)</annotation></semantics></math> in <math id="S3.p1.m12" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math>, <math id="S3.p1.m13" class="ltx_Math" alttext="v_{in_{1}},v_{in_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>2</mn></msub></mrow></msub></mrow><annotation encoding="application/x-tex">v_{in_{1}},v_{in_{2}}</annotation></semantics></math> and <math id="S3.p1.m14" class="ltx_Math" alttext="v_{out}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">v_{out}</annotation></semantics></math> are distinct. This does not affect the hardness of the problem as any <math id="S3.p1.m15" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-generalized circuit can be converted to this form by use of at most <math id="S3.p1.m16" class="ltx_Math" alttext="2N" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">2N</annotation></semantics></math> additional equality-gates and nodes, and also since an <math id="S3.p1.m17" class="ltx_Math" alttext="(\epsilon/2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\epsilon/2)</annotation></semantics></math>-approximate solution to the converted problem can clearly be converted to a solution in the original circuit.</p>
493:<p id="S3.p2.1" class="ltx_p">For ease of notation we consider a <span id="S3.p2.1.1" class="ltx_text ltx_font_smallcaps">ConHalving</span> instance on the interval <math id="S3.p2.m1" class="ltx_Math" alttext="[0,6N]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,6N]</annotation></semantics></math>. Let <math id="S3.p2.m2" class="ltx_Math" alttext="d_{i}:=6(i-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>:=</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>Γ1</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{i}:=6(i-1)</annotation></semantics></math>; the two agents <math id="S3.p2.m3" class="ltx_Math" alttext="var_{i}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">var_{i}</annotation></semantics></math> and <math id="S3.p2.m4" class="ltx_Math" alttext="copy_{i}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">copy_{i}</annotation></semantics></math> that we construct for every node <math id="S3.p2.m5" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> have valuations</p>
520:<p id="S3.p2.2" class="ltx_p">Since each node is the output of at most one gate, <math id="S3.p2.m6" class="ltx_Math" alttext="var_{i}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">var_{i}</annotation></semantics></math> is well-defined. Note that apart from the valuation defined by the function <math id="S3.p2.m7" class="ltx_Math" alttext="G^{\tau}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mi>τ</mi></msup><annotation encoding="application/x-tex">G^{\tau}</annotation></semantics></math>, agents <math id="S3.p2.m8" class="ltx_Math" alttext="var_{i}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">var_{i}</annotation></semantics></math> and <math id="S3.p2.m9" class="ltx_Math" alttext="copy_{i}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">copy_{i}</annotation></semantics></math> only have valuations on the sub-interval <math id="S3.p2.m10" class="ltx_Math" alttext="[d_{i},d_{i+1}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>d</mi><mi>i</mi></msub><mo>,</mo><msub><mi>d</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[d_{i},d_{i+1}]</annotation></semantics></math>, i.e., the agents associated with node <math id="S3.p2.m11" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> only have valuations on <math id="S3.p2.m12" class="ltx_Math" alttext="[0,6]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>6</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,6]</annotation></semantics></math>, the agents associated with <math id="S3.p2.m13" class="ltx_Math" alttext="v_{2}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>2</mn></msub><annotation encoding="application/x-tex">v_{2}</annotation></semantics></math> only on have valuations on <math id="S3.p2.m14" class="ltx_Math" alttext="[6,12]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>6</mn><mo>,</mo><mn>12</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[6,12]</annotation></semantics></math> and so on. Let <math id="S3.p2.m15" class="ltx_Math" alttext="v_{i}^{-}:=[d_{i}+1,d_{i}+2]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>v</mi><mi>i</mi><mi>Γ</mi></msubsup><mo>:=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>2</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">v_{i}^{-}:=[d_{i}+1,d_{i}+2]</annotation></semantics></math> and the right and left endpoints respectively be <math id="S3.p2.m16" class="ltx_Math" alttext="v_{i,\ell}^{-}" display="inline" intent=":literal"><semantics><msubsup><mi>v</mi><mrow><mi>i</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>Γ</mi></msubsup><annotation encoding="application/x-tex">v_{i,\ell}^{-}</annotation></semantics></math> and <math id="S3.p2.m17" class="ltx_Math" alttext="v_{i,r}^{-}" display="inline" intent=":literal"><semantics><msubsup><mi>v</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi></mrow><mi>Γ</mi></msubsup><annotation encoding="application/x-tex">v_{i,r}^{-}</annotation></semantics></math>, (and analogously for <math id="S3.p2.m18" class="ltx_Math" alttext="v_{i}^{+}:=[d_{i}+3,d_{i}+4]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>v</mi><mi>i</mi><mo>+</mo></msubsup><mo>:=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>3</mn></mrow><mo>,</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>4</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">v_{i}^{+}:=[d_{i}+3,d_{i}+4]</annotation></semantics></math>, <math id="S3.p2.m19" class="ltx_Math" alttext="v_{i,\ell}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>v</mi><mrow><mi>i</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">v_{i,\ell}^{+}</annotation></semantics></math> and <math id="S3.p2.m20" class="ltx_Math" alttext="v_{i,r}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>v</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">v_{i,r}^{+}</annotation></semantics></math>). Now, we are ready to define the functions <math id="S3.p2.m21" class="ltx_Math" alttext="G^{\tau}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mi>τ</mi></msup><annotation encoding="application/x-tex">G^{\tau}</annotation></semantics></math> according to Table <a href="#S3.T2" title="Table 2 ‣ 3 (𝑛,𝑛+𝑘,ϵ)-ConHalving is PPAD-hard ‣ Hardness Results for Consensus-Halving" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Notice that because of the assumption that the two input nodes and the output node are distinct, the graphs of the functions are as in Table <a href="#S3.T2" title="Table 2 ‣ 3 (𝑛,𝑛+𝑘,ϵ)-ConHalving is PPAD-hard ‣ Hardness Results for Consensus-Halving" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Figure <a href="#S3.F1" title="Figure 1 ‣ 3 (𝑛,𝑛+𝑘,ϵ)-ConHalving is PPAD-hard ‣ Hardness Results for Consensus-Halving" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> demonstrates an example of a Consensus-halving instance corresponding to a small circuit.</p>
523:<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">Table 2: </span>Agent preferences from gate <math id="S3.T2.m4" class="ltx_Math" alttext="\tau=(G,v_{in_{1}},v_{in_{2}},v_{out},\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><msub><mi>v</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>1</mn></msub></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>2</mn></msub></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau=(G,v_{in_{1}},v_{in_{2}},v_{out},\alpha)</annotation></semantics></math>. For the gate <math id="S3.T2.m5" class="ltx_Math" alttext="G_{\times\zeta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ζ</mi></mrow></msub><annotation encoding="application/x-tex">G_{\times\zeta}</annotation></semantics></math>, the figure depicts the case when <math id="S3.T2.m6" class="ltx_Math" alttext="\alpha+\epsilon&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>¡</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha+\epsilon&lt;1</annotation></semantics></math>.</figcaption>
560:1/\alpha&amp;\text{if }t\in[v_{out,\ell}^{-},v_{out,\ell}^{-}+\min(\alpha+\epsilon,1)]\\
