		& $\begin{scriptsize} \begin{aligned}
		\begin{cases}
		1								& \text{if } t \in v_{in_1}^+ \cup v_{in_2}^{-} \\
		1/\epsilon			& \text{if } t \in [v_{out,\ell}^{-},v_{out,\ell}^{-}+\epsilon] \\
		1/\epsilon			& \text{if } t \in [v_{out,r}^{-}-\epsilon,v_{out,r}^{-}] \\
		0								& \text{otherwise} 
		\end{cases}
		\end{aligned} \end{scriptsize}$
		& \input{comparison_gate} \\
		\hline
		$\begin{scriptsize} G_{\vee} \end{scriptsize}$ 
		& $\begin{scriptsize} \begin{aligned}
		\begin{cases}
		1								& \text{if } t \in v_{in_1}^+ \cup v_{in_2}^{+} \\
		0.5/\epsilon		& \text{if } t \in [v_{out,\ell}^{-},v_{out,\ell}^{-}+\epsilon] \\
		1.5/\epsilon		& \text{if } t \in [v_{out,r}^{-}-\epsilon,v_{out,r}^{-}] \\
		0								& \text{otherwise} 
		\end{cases}
		\end{aligned} \end{scriptsize}$
		& \input{or_gate} \\
		\hline
		$\begin{scriptsize} G_{\wedge} \end{scriptsize}$ 
		&	$\begin{scriptsize}
		\begin{cases}
		1								& \text{if } t \in v_{in_1}^+ \cup v_{in_2}^{+} \\
		1.5/\epsilon		& \text{if } t \in [v_{out,\ell}^{-},v_{out,\ell}^{-}+\epsilon] \\
		0.5/\epsilon		& \text{if } t \in [v_{out,r}^{-}-\epsilon,v_{out,r}^{-}] \\
		0								& \text{otherwise} 
		\end{cases}
		\end{scriptsize}$
		& \input{and_gate} \\
		\hline
	\end{tabular}
\end{table}

