566:<span id="S3.T2.1.3.3.1" class="ltx_inline-block ltx_align_middle" style="width:135.1pt;"><span class="ltx_inline-block"><svg id="S3.T2.pic2" class="ltx_picture ltx_centering" height="67.82" overflow="visible" version="1.1" viewBox="0 0 189.1 67.82" width="189.1"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,67.82) matrix(1 0 0 -1 0 0) translate(4.61,0) translate(0,30.41)"><g stroke-width="0.4pt"><path style="fill:none" d="M 4.89 0 L 174.99 0"></path><g style="--ltx-fill-color:#BFBFBF;" fill="#BFBFBF"><path d="M 49.81 0 M 49.81 0 L 49.81 13.84 L 78.87 13.84 L 78.87 0 Z M 78.87 13.84"></path></g><g style="--ltx-fill-color:#BFBFBF;" fill="#BFBFBF"><path d="M 107.93 0 M 107.93 0 L 107.93 20.76 L 127.3 20.76 L 127.3 0 Z M 127.3 20.76"></path></g><g stroke-dasharray="0.4pt,1.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 108.57 24.91 L 126.66 24.91"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(-1.0 0.0 0.0 -1.0 108.57 24.91)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(1.0 0.0 0.0 1.0 126.66 24.91)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 106.51 28.18)"><foreignObject style="--ltx-fo-width:2.18em;--ltx-fo-height:0.45em;--ltx-fo-depth:0.11em;font-size:7.36pt;" height="5.77" overflow="visible" transform="matrix(1 0 0 -1 0 4.61)" width="22.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.T2.pic2.m1" class="ltx_Math" alttext="\alpha+\epsilon" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.500em">α</mi><mo mathsize="0.500em">+</mo><mi mathsize="0.500em">ϵ</mi></mrow><annotation encoding="application/x-tex">\alpha+\epsilon</annotation></semantics></math></span></span></foreignObject></g><g stroke-dasharray="0.4pt,1.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 132.84 20.12 L 132.84 0.64"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(0.0 1.0 -1.0 0.0 132.84 20.12)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(0.0 -1.0 1.0 0.0 132.84 0.64)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 136.54 6.62)"><foreignObject style="--ltx-fo-width:1.99em;--ltx-fo-height:0.51em;--ltx-fo-depth:0.17em;font-size:7.36pt;" height="6.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.19)" width="20.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.T2.pic2.m2" class="ltx_Math" alttext="1/\alpha" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.500em">1</mn><mo maxsize="0.500em" minsize="0.500em" stretchy="true" symmetric="true">/</mo><mi mathsize="0.500em">α</mi></mrow><annotation encoding="application/x-tex">1/\alpha</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 49.81 0 M 49.81 -6.92 C 50.33 -7.96 51.54 -8.65 53.27 -8.65 L 60.88 -8.65 C 62.61 -8.65 63.82 -9.34 64.34 -10.38 C 64.86 -9.34 66.07 -8.65 67.8 -8.65 L 75.41 -8.65 C 77.14 -8.65 78.35 -7.96 78.87 -6.92"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 55.02 -23.1)"><foreignObject style="--ltx-fo-width:1.35em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.15em;font-size:10pt;" height="13.09" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="18.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.T2.pic2.m3" class="ltx_Math" alttext="v_{in}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>v</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">v_{in}^{+}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 107.93 0 M 107.93 -6.92 C 108.45 -7.96 109.66 -8.65 111.39 -8.65 L 119 -8.65 C 120.73 -8.65 121.94 -9.34 122.46 -10.38 C 122.98 -9.34 124.19 -8.65 125.92 -8.65 L 133.53 -8.65 C 135.26 -8.65 136.47 -7.96 136.99 -6.92"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 110.42 -23.72)"><foreignObject style="--ltx-fo-width:1.74em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.15em;font-size:10pt;" height="13.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="24.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.T2.pic2.m4" class="ltx_Math" alttext="v_{out}^{-}" display="inline" intent=":literal"><semantics><msubsup><mi>v</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mi>Γ</mi></msubsup><annotation encoding="application/x-tex">v_{out}^{-}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
