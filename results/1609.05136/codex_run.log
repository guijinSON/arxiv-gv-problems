    for i, agent in enumerate(inst["agents"], 1):
        weights = " ".join(_ftext(x) for x in agent["weights"])
        skew = _frac(agent["right"]) - _frac(agent["left"])
        balance_rhs = skew if agent["guard"] % 2 == 0 else -skew
        rows.append(
            f"A{i}: guard={agent['guard']}; "
            f"D={_ftext(_rat(balance_rhs))}; L={_ftext(agent['left'])}; "
