"""Self-contained verified problem generator for arXiv:1609.05136.

The family is an exact, promised-slot form of Consensus-Halving with rational
step-function value densities.  Certificates are planted by inverse generation;
verification integrates every density exactly over the proposed alternating
partition.
"""

from __future__ import annotations

import hashlib
import itertools
import json
import math
import os
import random
import re
import statistics
import time
from fractions import Fraction


