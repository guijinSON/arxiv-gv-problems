+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {
+        "n": 4, "composition_height": 1, "transform_height": 2,
+    },
+    "easy": {
+        "n": 10, "composition_height": 2, "transform_height": 8,
