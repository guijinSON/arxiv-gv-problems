+)
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A sparse homogeneous degree-10 polynomial in X,Y,Z with integer "
+        "coefficients: terms are [coefficient,[i,j,k]], zero terms are omitted, "
