+    height = inst["transform_height"]
+    minimum = 1 if height == 2 else 2
+    for _ in range(256):
+        guess = tuple(_signed_nonzero(rng, height, minimum) for _ in range(4))
+        candidate = _candidate_relation(inst, *guess)
