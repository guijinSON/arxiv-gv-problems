+def _basis() -> list[tuple[int, int, int]]:
+    """All degree-10 ternary monomials, descending lexicographic order."""
+    return [
+        (i, j, 10 - i - j)
+        for i in range(10, -1, -1)
+        for j in range(10 - i, -1, -1)
