+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT: str = (
+    "The coefficients of t^0, t^1, and t^3 form a Taylor frame unchanged by "
+    "a common right-composition congruent to t modulo t^4."
