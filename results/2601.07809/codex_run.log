+        return None
+    alpha, beta, gamma = p3 // 9, q1 // 6, -r0 // 3
+    if not alpha or not beta or not gamma:
+        return None
+    p0 = _coefficient(p, 0)
+    delta = p0 - 6 * alpha
+    if delta % (3 * alpha):
+        return None
+    a = delta // (3 * alpha)
+    return a, alpha, beta, gamma
