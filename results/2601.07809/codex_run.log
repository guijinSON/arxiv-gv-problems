+def _recover_parameters(inst: dict) -> tuple[int, int, int, int] | None:
+    """Recover (a, alpha, beta, gamma) from the marked low Taylor frame."""
+    p, q, r = inst["target"]
+    p3 = _coefficient(p, 3)
+    q1 = _coefficient(q, 1)
