+    corruptions: dict[str, object] = {
+        "drop_one": answer[:drop_index] + answer[drop_index + 1:],
+        "swap_two": [answer[1], answer[0]] + answer[2:],
+        "duplicate": answer + [answer[-1]],
+        "empty": [],
+        "out_of_range": [
+            [inst["numerator_bound_B"] + 1, answer[0][1]]
+        ] + answer[1:],
