+    answer_chars = max(row[0] for row in sizes)
+    answer_tokens = max(row[1] for row in sizes)
+    answer_elements = max(row[2] for row in sizes)
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
