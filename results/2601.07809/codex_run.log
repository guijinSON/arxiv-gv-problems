+        "shipping_answer_terms": len(answer),
+        "doubled_answer_terms": len(doubled["answer"]),
+        "named_parameter_degrees": named_degrees,
+    }
+
+    # G8: -1, 2, and their composition are true common projective rescalings.
+    invariance = 0
