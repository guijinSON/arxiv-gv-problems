+    y_var = sparse_poly.var(1, 3)
+    z_var = sparse_poly.var(2, 3)
+    x_sub = sparse_poly.add(
+        sparse_poly.scale(x_var, Fraction(1, alpha)),
+        sparse_poly.scale(z_var, Fraction(a, gamma)),
