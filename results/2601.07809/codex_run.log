p=g.DIFFICULTY['medium']; rows=[]
for s in range(200):
 a=g.make_instance(seed=30000+s,**p)['answer']; b=json.dumps(a,separators=(',',':')); rows.append((len(b),(len(b)+3)//4,g._answer_atoms(a)))
print('size-max-200',max(rows))
for name,path in [('bare','g9_medium_bare/llm_loop_transcript.jsonl'),('hinted','g9_medium_hinted/llm_loop_transcript.jsonl'),('placebo','g9_medium_placebo/llm_loop_transcript.jsonl')]:
 rec=[json.loads(x) for x in open(path) if x.strip()]
 print(name,[(r['model'],r['seed'],r['solved'],r['verify_reason']) for r in rec])
