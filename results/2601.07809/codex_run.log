+    return {
+        "family": "implicit equation of a framed parametrized plane curve",
+        "n": n,
+        "composition_height": composition_height,
+        "transform_height": transform_height,
+        "target": [p, q, r],
+        "normalization_D": denominator,
+        "numerator_bound_B": numerator_bound,
+        "answer": answer,
+    }
