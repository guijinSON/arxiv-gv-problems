+        "shipping_density_sample_count": samples,
+        "shipping_valid_hits": hits,
+        "shipping_observed_valid_fraction": hits / samples,
+        "shipping_candidate_space": search_space(inst),
+        "enumerate_all_shipping": enumerate_all(inst),
