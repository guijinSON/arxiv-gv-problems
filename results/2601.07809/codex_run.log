+        "recovery is polynomial time, O(n^2+m^3) here for m=66 candidate "
+        "monomials; its shipping wall time and modular-operation count are "
+        "measured in G6, while the Taylor-frame pullback uses 140 exact "
+        "multiply-add operations but must be executed without a CAS."
+    ),
+    "max_answer_tokens": 500,  # replaced by the measured shipping maximum below
+}
+
+NATIVE: dict = {
