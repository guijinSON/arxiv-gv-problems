+def _trim(poly: list[int]) -> list[int]:
+    while len(poly) > 1 and poly[-1] == 0:
+        poly.pop()
+    return poly
+
+
+def _uadd(a: list[int], b: list[int]) -> list[int]:
+    out = [0] * max(len(a), len(b))
+    for i, value in enumerate(a):
+        out[i] += value
+    for i, value in enumerate(b):
+        out[i] += value
