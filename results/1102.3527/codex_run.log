+def _layer_masks(n: int, offsets: tuple[int, int, int, int]) -> list[int]:
+    rows = []
+    for i in range(n):
+        mask = 0
+        for offset in offsets:
+            mask ^= 1 << ((i + offset) % n)
+        rows.append(mask)
+    return rows
