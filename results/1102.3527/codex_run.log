+def _gf2_rank_masks(rows: list[int], n: int) -> int:
+    work = list(rows)
+    rank = 0
+    for col in range(n):
+        pivot = next((r for r in range(rank, len(work)) if (work[r] >> col) & 1), None)
+        if pivot is None:
+            continue
+        work[rank], work[pivot] = work[pivot], work[rank]
+        for r in range(len(work)):
+            if r != rank and ((work[r] >> col) & 1):
+                work[r] ^= work[rank]
+        rank += 1
+        if rank == len(work):
+            break
+    return rank
