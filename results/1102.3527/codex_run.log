+    rng.shuffle(permutation)  # old coordinate -> new coordinate
+    order = list(range(len(inst["receiver_checks"])))
+    rng.shuffle(order)
+    transformed_checks = []
+    for old_receiver in order:
+        support = [permutation[x] for x in inst["receiver_checks"][old_receiver]]
+        rng.shuffle(support)
