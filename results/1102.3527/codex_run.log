+                unknown.append(coordinate)
+            else:
+                parity ^= values[coordinate]
+        if unknown:
+            chosen = min(unknown)
+            values[chosen] = parity ^ 1
+            for coordinate in unknown:
+                if values[coordinate] < 0:
+                    values[coordinate] = 0
