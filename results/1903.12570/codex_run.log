index 0000000000000000000000000000000000000000..507dd4e1333558838ae118a3f534f3ef80fafe2f
--- /dev/null
+++ b//tmp/bench_1903.py
@@ -0,0 +1,64 @@
+import random, time
+
+def build(k, seed):
+    # G_k from Section 2.1, deleting one inter-pair chain edge.
+    a,b=0,1
+    vv=list(range(2,2+2*k))
+    c,d=2+2*k,3+2*k
+    edges=[(a,b),(a,b),(a,vv[0]),(b,vv[0]),
+           (vv[-1],c),(vv[-1],d),(c,d),(c,d)]
+    edges += [(vv[i],vv[i+1]) for i in range(2*k-1)]
+    edges += [(vv[i],vv[i+1]) for i in range(0,2*k,2)]
+    cut=random.Random(seed).randrange(k-1)
+    missing=tuple(sorted((vv[2*cut+1],vv[2*cut+2])))
+    edges.remove((vv[2*cut+1],vv[2*cut+2]))
+    labels=list(range(2*k+4)); random.Random(seed ^ 99173).shuffle(labels)
+    edges=[tuple(sorted((labels[u],labels[v]))) for u,v in edges]
+    return 2*k+4, edges, labels, missing
+
+def decode(k, edges):
+    ops=0
+    mult={}
+    for e in edges:
+        mult[e]=mult.get(e,0)+1; ops += 2
+    pairs=[e for e,c in mult.items() if c==2]; ops += len(mult)
+    mate={}
+    for u,v in pairs:
+        mate[u]=v; mate[v]=u; ops += 2
+    simple=[]
+    for e,c in mult.items():
+        if c==1: simple.append(e)
+        ops += 1
+    adj=[[] for _ in range(2*k+4)]
+    for u,v in simple:
+        adj[u].append(v); adj[v].append(u); ops += 2
+    # Constraint propagation: seed the smaller endpoint of every unresolved
+    # doubled pair only when needed, then propagate independence along edges.
+    state=[-1]*(2*k+4)  # 1=I, 0=F
+    changed=True
+    while changed:
+        changed=False
+        for u,v in pairs:
+            ops += 1
+            if state[u]>=0 and state[v]<0:
+                state[v]=1-state[u]; changed=True; ops += 1
+            elif state[v]>=0 and state[u]<0:
+                state[u]=1-state[v]; changed=True; ops += 1
+        for u,v in simple:
+            ops += 1
+            if state[u]==1 and state[v]<0:
+                state[v]=0; changed=True; ops += 1
+            elif state[v]==1 and state[u]<0:
+                state[u]=0; changed=True; ops += 1
+        if not changed:
+            unresolved=next(((u,v) for u,v in pairs if state[u]<0),None)
+            if unresolved:
+                state[min(unresolved)]=1; changed=True; ops += 1
+    return [i for i,x in enumerate(state) if x==1],ops
+
+for k in (32,64,120):
+    times=[]; counts=[]
+    for seed in range(200):
+        n,e,_,_=build(k,seed)
+        t=time.perf_counter(); ans,ops=decode(k,e); times.append(time.perf_counter()-t); counts.append(ops)
+    print(k,n,len(e),len(ans),sum(counts)/len(counts),sum(times)/len(times),max(times))
