+    w = inst["W"]
+    mask = (1 << degree) - 1
+
+    outlier = [
+        _normalized_candidate(w, degree),
+        _normalized_candidate(w ^ mask, degree),
+        _bits_to_support(sum(1 << i for i in range(m)), degree),
+        _bits_to_support(sum(1 << i for i in range(m, degree)), degree),
+    ]
