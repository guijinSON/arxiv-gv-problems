codex
The local audit exposed one weakness before submission: with the answer written only as the order-three factor \(z\), the random public cube changes the resulting coefficient but not the required support, so a strict duplicate notion could collapse all seeds at fixed \(m\). I’m tightening the family so the typed witness itself depends on the random instance; otherwise the canonical-key diversity claim would be too generous.
exec
/bin/bash -lc "python3 - <<'PY'
import gen_1310_0337 as g,itertools,time
for n,maxk in [(29,4),(89,3)]:
 i=g.make_instance(n=n,seed=1); N=i['degree'];p=i['p'];Q=i['unit_order']
 print('n',n,N)
 for k in range(2,maxk+1):
  found=[];t=time.time();count=0
  # normalize support includes 0 under monomial shift; every sparse orbit can.
  for rest in itertools.combinations(range(1,N),k-1):
   w=1|sum(1<<x for x in rest)
   count+=1
   if g._pow_bits(w,Q,p)==1 and g._pow_bits(w,Q//3,p)==1:
    found.append((0,)+rest)
    if len(found)>=5:break
  print(k,'count',count,'found',found,'sec',time.time()-t)
