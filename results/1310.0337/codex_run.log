+    "certificate_form": "polynomial",
+    "native_objects": [
+        "finite field GF(2)[beta]/(1+beta+...+beta^(p-1))",
+        "unit-circle elements in GF(2^(2m))",
+        "binomial permutation polynomial x^d+u*x",
