+        "requested_n": n,
+        "m": m,
+        "p": p,
+        "degree": degree,
+        "q": q,
+        "unit_order": unit_order,
+        "d": 6 * (q - 1) + 1,
+        "W": w,
+        "W_support": _bits_to_support(w, degree),
+        "answer": answer,
+    }
+
+
+def render(inst):
+    m = inst["m"]
+    p = inst["p"]
+    degree = inst["degree"]
+    q = inst["q"]
+    unit_order = inst["unit_order"]
