+    for row_index, column in enumerate(pivots):
+        if (rows[row_index] >> degree) & 1:
+            solution |= 1 << column
+    counts = {
+        "rank": len(pivots),
+        "packed_row_xors": row_xors,
+        "coefficient_inspections": coefficient_inspections,
+        "bit_xor_operations": row_xors * (degree + 1),
+    }
