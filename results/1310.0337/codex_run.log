+def _linear_algebra_reference(inst):
+    """Solve z^2+z=1 as a GF(2) system, with packed exact row reduction."""
+    degree = inst["degree"]
+    p = inst["p"]
+    rows = [0] * degree
+    for column in range(degree):
+        image = _square_bits(1 << column, p) ^ (1 << column)
+        work = image
