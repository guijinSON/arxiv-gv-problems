+    result = 1
+    while exponent:
+        if exponent & 1:
+            result = _mul_bits(result, base, p)
+        exponent >>= 1
+        if exponent:
+            base = _square_bits(base, p)
+    return result
+
+
+def _pow_bits_counted(base, exponent, p):
+    """Binary exponentiation plus an implementation-independent work count."""
+    result = 1
+    multiplications = 0
+    squarings = 0
+    schoolbook_terms = 0
+    square_terms = 0
+    while exponent:
