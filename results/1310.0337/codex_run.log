+    u = _mul_bits(inst["W"], z, p)
+    unit_order = inst["unit_order"]
+    if _pow_bits(u, unit_order, p) != 1:
+        return False, "W*z is not on the unit circle"
+    if _pow_bits(u, unit_order // 3, p) == 1:
+        return False, "W*z is a cube on the unit circle"
