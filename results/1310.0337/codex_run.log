+def _support_to_bits(support):
+    value = 0
+    for exponent in support:
+        value |= 1 << exponent
+    return value
+
+
+def _quadratic_residue_support(p):
+    m = (p - 1) // 2
+    return sorted({(value * value) % p for value in range(1, m + 1)})
