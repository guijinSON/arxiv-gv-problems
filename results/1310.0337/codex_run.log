+    z = _support_to_bits(answer)
+    if z in (0, 1):
+        return False, "z must be nonconstant"
+    p = inst["p"]
+    if _square_bits(z, p) ^ z ^ 1:
+        return False, "z^2+z+1 is not zero in F"
