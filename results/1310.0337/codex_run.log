+        "polynomials are excluded, leaving 2^(2m)-2 candidates."
+    ),
+    "bounds": {
+        "coefficient_field": 2,
+        "max_degree_exclusive": "2m",
+        "max_support_size": "2m",
+        "excluded_polynomials": ["0", "1"],
