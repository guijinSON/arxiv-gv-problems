+    at_node = [set() for _ in range(inst["tree_n"])]
+    for x, clique in zip(active, cliques):
+        at_node[x] = clique
+    models = [set() for _ in range(inst["graph_n"])]
+    for x, clique in enumerate(at_node):
+        for v in clique:
+            models[v].add(x)
