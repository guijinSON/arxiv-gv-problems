+# Filled from script-owned evidence after the three hardening runs.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 2},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
