+
+inst = g.make_instance(seed=7, **g.DIFFICULTY["demo"])
+text = g.render(inst)
+candidate = g.parse_answer("<answer>[5, 1, 2, 4, 7]</answer>")
+assert g.verify(inst, candidate) == (True, "ok")
+other = g.random_candidate(inst, random.Random(1))
