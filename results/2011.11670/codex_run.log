+def parse_answer(text) -> object | None:
+    if not isinstance(text, str):
+        return None
+    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
+                        flags=re.IGNORECASE | re.DOTALL)
+    candidates = blocks if blocks else re.findall(
+        r"```(?:json)?\s*(\[[\s\S]*?\])\s*```", text,
+        flags=re.IGNORECASE,
