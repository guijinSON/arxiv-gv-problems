+    "easy": {"n": 40, "private_twins": 1, "edge_twins": 1},
+    "medium": {"n": 68, "private_twins": 1, "edge_twins": 1},
+    "hard": {"n": 96, "private_twins": 1, "edge_twins": 1},
+}
+SHIPPING_DIFFICULTY = "hard"
