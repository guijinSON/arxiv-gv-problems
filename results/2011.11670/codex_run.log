+    # original n nodes are nonleaves and are in bijection with maximal cliques.
+    host_edges = [edge[:] for edge in core_edges]
+    next_host = n
+    for x in range(n):
+        if len(core_adj[x]) == 1:
+            host_edges.append([x, next_host])
