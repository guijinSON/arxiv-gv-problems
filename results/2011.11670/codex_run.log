+        keys = {x: (rng.randrange(10_000) + (bias if x >= m else 0), rng.random())
+                for x in universe}
+        p = sorted(universe, key=keys.__getitem__)
+        orders.append(p)
+    pos = [[0] * (2 * m) for _ in range(3)]
+    for d, order in enumerate(orders):
+        for rank, x in enumerate(order):
+            pos[d][x] = rank
+    rel = [[all(pos[d][a] < pos[d][m + b] for d in range(3))
+            for b in range(m)] for a in range(m)]
+    return rel, orders
+
+
+def topo_candidate(rel, assigned):
+    m = len(rel)
+    nn = 2 * m
+    out = []
+    for d in range(3):
+        adj = [set() for _ in range(nn)]
+        indeg = [0] * nn
+        for a in range(m):
+            for b in range(m):
+                if rel[a][b]:
+                    u, v = a, m + b
+                elif assigned.get((a, b)) == d:
+                    u, v = m + b, a
+                else:
+                    continue
+                if v not in adj[u]:
+                    adj[u].add(v); indeg[v] += 1
+        todo = sorted((i for i in range(nn) if indeg[i] == 0), reverse=True)
+        order = []
+        while todo:
+            u = todo.pop(); order.append(u)
+            for v in sorted(adj[u]):
+                indeg[v] -= 1
+                if indeg[v] == 0:
+                    todo.append(v); todo.sort(reverse=True)
+        if len(order) != nn:
+            return None
+        out.append(order)
+    return out
+
+
+def valid(rel, orders):
+    if orders is None:
+        return False
+    m = len(rel)
+    pos = [[0] * (2 * m) for _ in range(3)]
+    for d in range(3):
+        for i, x in enumerate(orders[d]): pos[d][x] = i
+    return all(rel[a][b] == all(pos[d][a] < pos[d][m+b] for d in range(3))
+               for a in range(m) for b in range(m))
+
+
+def solve(rel, cap=100000, randomized=False, seed=0):
+    m = len(rel)
+    zeros = [(a, b) for a in range(m) for b in range(m) if not rel[a][b]]
+    # Constrained pairs first: endpoints having many positive incidences.
+    rd = [sum(row) for row in rel]
+    cd = [sum(rel[a][b] for a in range(m)) for b in range(m)]
+    zeros.sort(key=lambda x: (-(rd[x[0]] + cd[x[1]]), x))
+    rng = random.Random(seed)
+    if randomized: rng.shuffle(zeros)
+    assigned = {}
+    nodes = 0
+
+    def acyclic(d):
+        return topo_candidate(rel, {z: c for z, c in assigned.items() if c == d}) is not None
+
+    def rec(i):
+        nonlocal nodes
+        if nodes >= cap: return None
+        nodes += 1
+        if i == len(zeros):
+            c = topo_candidate(rel, assigned)
+            return c if valid(rel, c) else None
+        z = zeros[i]
+        colors = [0, 1, 2]
+        if randomized: rng.shuffle(colors)
+        for d in colors:
+            assigned[z] = d
+            if acyclic(d):
+                ans = rec(i + 1)
+                if ans is not None: return ans
+            assigned.pop(z, None)
+        return None
+
+    t = time.perf_counter()
+    ans = rec(0)
+    return ans, nodes, time.perf_counter() - t
+
+
+if __name__ == "__main__":
+    for bias in (2000, 3500, 5000):
+      print("bias", bias)
+      for m in (10, 12, 14, 16, 18, 20):
+        vals = []
+        for seed in range(3):
+            rel, planted = make(m, seed, bias)
+            ans, nodes, sec = solve(rel, cap=20000)
+            vals.append((bool(ans), nodes, round(sec, 3), sum(map(sum, rel))))
+        print(m, vals)

