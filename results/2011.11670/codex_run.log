+
+    invariant_checks = 0
+    carried_checks = 0
+    keys = []
+    g8_failures = []
+    for seed in range(20):
+        inst = make_instance(seed=10_000 + seed, **ship_params)
+        key = canonical_key(inst)
+        keys.append(key)
+        rng = random.Random(90_000 + seed)
+        hp = list(range(inst["tree_n"])); rng.shuffle(hp)
+        gp = list(range(inst["graph_n"])); rng.shuffle(gp)
+        transforms = [
