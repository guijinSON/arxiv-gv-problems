+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Each displayed hyperplane misses a unique frame point, so summing all "
+        "point values exposes the total coefficient sum and replaces a dense solve."
+    ),
+    "hardness_basis": (
+        "Track B: exact modular Gaussian elimination solves the coefficient system "
+        "in O(n^3); at shipping n=96 it averages 64,273 field operations and "
+        "0.0018 seconds, while the total-sum invariant uses exactly 192 field "
+        "operations "
