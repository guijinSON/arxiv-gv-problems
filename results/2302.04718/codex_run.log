+                                    "reason": why})
+            if json.loads(json.dumps(trial["answer"])) != trial["answer"]:
+                g1_failures.append({"preset": preset, "seed": seed,
+                                    "reason": "answer is not JSON-native"})
+    report["G1_planted_verifies"] = {
