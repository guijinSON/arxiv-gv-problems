+def _worst_answer_chars(n, p):
+    # Compact JSON: [[0,p-1],[1,p-1],...].
+    index_digits = sum(len(str(i)) for i in range(n))
+    return 2 + index_digits + n * len(str(p - 1)) + 3 * n + (n - 1)
