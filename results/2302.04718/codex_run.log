+    "description": (
+        "A JSON list of exactly n pairs [i,x_i], containing every hyperplane "
+        "index i=0,...,n-1 exactly once in any order, with 0 <= x_i < p."
+    ),
+    "bounds": {
+        "pair_count": "n",
+        "hyperplane_index_min": 0,
+        "hyperplane_index_max": "n-1",
+        "coefficient_min": 0,
+        "coefficient_max": "p-1",
+        "candidate_count": "p^n",
