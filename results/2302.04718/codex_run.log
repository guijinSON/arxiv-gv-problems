+    corruptions["duplicate_index"] = duplicate
+    out_of_range = json.loads(json.dumps(base))
+    out_of_range[0][0] = inst["n"]
+    corruptions["out_of_range"] = out_of_range
+    swapped = json.loads(json.dumps(base))
