+
+    g1_checks = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in range(4):
+            trial = make_instance(seed=seed, **params)
+            ok, why = verify(trial, trial["answer"])
+            g1_checks += 1
+            if not ok:
