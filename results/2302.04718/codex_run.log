+                   if swapped[j][1] != swapped[0][1]), 1)
+    swapped[0][1], swapped[swap_j][1] = swapped[swap_j][1], swapped[0][1]
+    corruptions["swapped_coefficients"] = swapped
+    rejection_reasons = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
