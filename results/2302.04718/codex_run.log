if fail:
    print("TRANSCRIPT INVALID:")
    for f in fail: print("  -", f)
    sys.exit(1)
print(f"  {len(rows)} calls | {len(models)} distinct models | "
      f"{max(rounds)+1} difficulty level(s) | verdict "
      f"{meta.get('harden_verdict',{}).get('verdict')}")
