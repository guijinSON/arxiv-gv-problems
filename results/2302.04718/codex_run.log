+                        flags=re.IGNORECASE | re.DOTALL)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.IGNORECASE)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, list) else None
