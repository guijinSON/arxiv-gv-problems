+def _candidate_from_total_guess(inst, total_guess):
+    p = inst["p"]
+    values = [0] * inst["n"]
+    for hyperplane, point in enumerate(inst["excluded"]):
+        values[hyperplane] = (total_guess - inst["values"][point]) % p
+    return [[i, values[i]] for i in range(inst["n"])]
