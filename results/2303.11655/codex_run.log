+    "easy": {"n": 18, "chains": 3, "variables": 3},
+    "medium": {"n": 24, "chains": 3, "variables": 3},
+    "hard": {"n": 30, "chains": 3, "variables": 3},
+}
+SHIPPING_DIFFICULTY = "hard"
