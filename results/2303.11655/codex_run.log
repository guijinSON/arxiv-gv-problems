   473	The proof of Theorem \ref{thm:subdes} uses the following result from \cite{CP93}.
   474	
   475	\begin{proposition} \label{thm:strategy} \cite[Proposition 1.1]{CP93}
   476	Let $\D = (\PP,\B)$ be a $t$-$(v,k,\lambda)$ design admitting a block-transitive (respectively, flag-transitive) group $G$. Let $H$ be a permutation group with $G \leq H \leq \Sym(\PP)$, and $\B^* = \big\{ B^H \ \big| \ B \in \B \big\}$. Then $\D^* = (\PP,\B^*)$ is a $t$-$(v,k,\lambda^*)$ design for some $\lambda^*$, admitting $H$ as a block-transitive (respectively, flag-transitive) group.
   477	\end{proposition}
   478	
   479	\begin{proof}[Proof of Theorem $\ref{thm:subdes}$]
   480	It follows from Proposition \ref{thm:strategy} that there is a design $\D^* = (\PP,B^*)$ with the same point set $\PP$ as $\D$, with block set $\B^*$ containing the block set $\B$ of $\D$, such that $\D^*$ is $H$-block-transitive and $(H,s)$-chain-imprimitive, for $H = S_{e_1} \wr \ldots \wr S_{e_s}$. The design $\D^*$ has the same parameters $e_1, \ldots, e_s$, $v$, and $k$ as $\D$, and by Theorem \ref{mainthm:2des} these parameters must satisfy conditions \eqref{2des-1} and \eqref{2des}. This proves Theorem \ref{thm:subdes}. 
   481	\end{proof}
