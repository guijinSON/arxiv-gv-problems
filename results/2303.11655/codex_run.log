+    os.path.abspath(__file__))))
+if _REPO_ROOT not in sys.path:
+    sys.path.insert(0, _REPO_ROOT)
+try:
+    from gvlib import sparse_poly
+except ImportError:                 # pragma: no cover - exact fallback below
+    sparse_poly = None
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
