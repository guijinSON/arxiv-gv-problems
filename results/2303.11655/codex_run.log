\title{Block-transitive $2$-designs with a chain of imprimitive point-partitions}
\author{Carmen Amarra$^{\rm\lowercase{a,b,\ast}}$} \author{Alice Devillers$^{\rm \lowercase{a}}$} \author{Cheryl E. Praeger$^{\rm \lowercase{b}}$}
