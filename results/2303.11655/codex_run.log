   155	
   156	\section{Chain structures and iterated wreath products} \label{sec:2-des}
   157	
   158	\subsection{Chain structure on a set} \label{subsec:chain}
   159	
   160	Let $s \geq 2$ and let $e_1, \ldots, e_s$ be integers with $e_i \geq 2$ for each $i$. Let $\PP$ be a set of size $|\PP| = \prod_{i=1}^s e_i$, and for each $i \in \{1, \ldots, s\}$ let $\Delta_i$ be a set of size $|\Delta_i| = e_i$. Then we can identify  $\PP$ with the set of $s$-tuples in $\prod_{i=1}^s \Delta_i$.
   161	
   162	For any $i \in \{0, \ldots, s-1\}$ and any fixed $(s-i)$-tuple $(\delta_j)_{j>i} = (\delta_{i+1},\delta_{i+2},\ldots,\delta_{s-1},\delta_{s})%(\delta_j)_{j=i+1}^s 
   163	\in \prod_{j>i} \Delta_j$, let $C_{(\delta_j)_{j>i}}$ denote the set
   164	    \begin{equation} \label{class}
   165	    C_{(\delta_j)_{j>i}} := \big\{ (\varepsilon_j)_{j=1}^s \in \PP \ \big| \ \varepsilon_j = \delta_j \ \text{for } \ i+1 \leq j \leq s \big\}.
   166	    \end{equation}
   167	Note in particular that $C_{(\delta_j)_{j>0}}$ is the singleton set $\big\{ (\delta_j)_{j>0} \big\}$. Also by convention we write
   168	    \[ C_{(\delta_j)_{j>s}} := \PP, \]
   169	and we consider $\prod_{j>s} \Delta_j$ as a singleton. For $i \in \{0, \ldots, s\}$ define the family $\C_i$ of subsets of $\PP$ as
   170	    \begin{equation} \label{partition}
   171	    \C_i := \Big\{ C_{(\delta_j)_{j>i}} \ \Big| \ (\delta_j)_{j>i} \in \prod_{j>i} \Delta_j \Big\}.
   172	    \end{equation}
   173	Then $\C_0 = \binom{\PP}{1}$, the set of singleton subsets of $\PP$; $\C_s = \{\PP\}$; and for $1 \leq i \leq s-1$ the family $\C_i$ is a nontrivial partition of $\PP$. For $0 \leq i \leq s-1$ the partition $\C_i$ is a proper refinement of $\C_{i+1}$ since each $e_j \geq 2$, and we write $\C_i \prec \C_{i+1}$ to denote this 
   174	 relation. Each class of $\C_{i+1}$ contains $e_{i+1}$ classes of $\C_i$. Thus we have
   175	    \[ \C_0 \prec \C_1 \prec \cdots \prec \C_{s-1} \prec \C_s, \]
   176	so the partitions $\C_0, \ldots, \C_s$ form an $s$-chain $\Ch$ under the relation (partial order) $\prec$.
   177	
   178	Set $e_0 := 1$ and $\Delta_0$ to be a singleton, and by convention take $\prod_{j > i} e_j := 1$ for $i = s$. Then for each $i \in \{0, \ldots, s\}$ the partition $\C_i$ consists of $d_i$ classes each of size $c_i$, where
   179	    \begin{equation} \label{cd}
   180	    c_i := \prod_{j \leq i} |\Delta_j| = \prod_{j \leq i} e_j \quad \text{and} \quad d_i := \prod_{j > i} |\Delta_j| = \prod_{j > i} e_j.
   347	\section{Proofs of Theorems \ref{mainthm:2des} and \ref{thm:subdes}}
   348	
   349	Let $s\geq2$, and suppose that the partitions  $\C_0, \ldots, \C_{s}$ of $\PP$ form an $s$-chain $\Ch$ as in \eqref{eq:chain} in Definition~\ref{def:chain}, with stabiliser $G = S_{e_1} \wr \ldots \wr S_{e_s}$. Consider a subset $B\subseteq\PP$ of size $k$, with array function $\chi_{B}$ with respect to $\Ch$, and let $\B = B^G$. It follows from Lemma \ref{lem:array-equiv} that $\B$ consists of all $k$-subsets $B'$ of $\PP$ such that the array function $\chi_{B'}$ with respect to $\Ch$ is $G$-equivalent to $\chi_B$. Recall from \eqref{cd} that the parameters $c_i$ and $d_i$ can be obtained from the numbers $e_i$, for $1 \leq i \leq s$. Thus $\D = (\PP,\B)$ is determined by the parameters $e_1, \ldots, e_s$, and an array function $\chi$ (up to $G$-equivalence) satisfying the conditions \eqref{array1} and \eqref{array2} of Definition \ref{def:array}. We denote $\D$ by $\D(e_1, \ldots, e_s; \,\chi)$, noting that this is the same notation used in \cite{CP93} when $s=2$.
   350	
   351	In the case where $s=2$ the result  \cite[Proposition 2.2 (ii)]{CP93} gives necessary and sufficient conditions on $c$, $d$, and $\mathbf{x}$ in order for $\D(c,d;\mathbf{x})$ to be a $2$-design and to be a $3$-design; designs constructed in this manner are now called Cameron--Praeger designs. We generalise this result for $\D(e_1, \ldots, e_s; \,\chi)$ with $s \geq 2$ in Theorem \ref{mainthm:2des}, which we prove below. For any set $X$, the symbol $X^{\{2\}}$ denotes the set of all unordered pairs of elements of $X$.
   352	
   353	Given an array function $\chi$, for brevity we will frequently use the notation
   354	    \begin{equation} \label{x_C}
   355	    x_C := \chi(C)
   356	    \end{equation}
   357	for any $C \in \C_i$, $1 \leq i \leq s$. 
   358	If $B \subseteq \PP$ such that $\chi_B = \chi$, we can extend the notation \eqref{x_C} by defining $x_C$, for any $C = \{(\delta_j)_{j>0}\} \in \C_0$, to be
   359	    \[ x_C = |B \cap C| = \begin{cases} 1 &\text{if } (\delta_j)_{j>0} \in B \\ 0 &\text{otherwise}. \end{cases} \]
   360	
   361	\begin{proof}[Proof of Theorem \ref{mainthm:2des}]
   362	Let $G, \PP$ be as above with $v=|\PP|=\prod_{i=1}^{s}e_i$, and let $B\subseteq\PP$ of size $k$. Let $\chi=\chi_B$ be the array function of $B$ with respect to $\Ch$ and recall the notation $x_C$ introduced above. Let $O_1, \ldots, O_s$ be as in \eqref{O_i}. By \cite[Proposition 1.3]{CP93}, the point-block incidence structure $\D = \big( \PP, B^G \big)$ is a $2$-design if and only if there is a constant $n$ such that $\big| B^{\{2\}} \cap O_i \big| = n\,|O_i|$ for all $i \in \{1, \ldots, s\}$. Assume such a $n$ exists. Note that $\sum_{i=1}^s |O_i| = \big| \PP^{\{2\}} \big| = \frac{1}{2} v(v-1)$, and $\sum_{i=1}^s \big| B^{\{2\}} \cap O_i \big| = \big| B^{\{2\}} \big| = \frac{1}{2} k(k-1)$.  Thus,  summing $n\,|O_i|$ over all $i$, we obtain
   363	    \[ 
   364	    n \cdot \frac{v(v-1)}{2} = \sum_{i=1}^s n \,|O_i| = \sum_{i=1}^s \big| B^{\{2\}} \cap O_i \big| = \frac{k(k-1)}{2}, 
   365	    \]
   366	so that $n = \frac{k(k-1)}{v(v-1)}$. Hence $\D$ is a $2$-design if and only if 
   367	    \begin{equation} \label{ratio}
   368	    \big| B^{\{2\}} \cap O_i \big| = \frac{k(k-1)}{v(v-1)} \cdot |O_i| \text{ for all } i \in \{1, \ldots, s\}.
   369	    \end{equation}
   370	Replacing $|O_i|$ with the formula in \eqref{|O_i|} we get
   371	    \begin{equation} \label{ratio2}
   372	    \frac{k(k-1)}{v(v-1)} \cdot |O_i| = \frac{k(k-1)}{v(v-1)} \cdot \frac{1}{2} \,v(e_i - 1) \prod_{j \leq i-1} e_j = \frac{1}{2} \cdot \frac{k(k-1)}{v-1} \,(e_i - 1) \prod_{j \leq i-1} e_j.
   373	    \end{equation}
   374	Recall from Section~\ref{s:innout} that the orbit $O_1$ consists of all $1$-inner pairs. Hence
   375	    \[ 
   376	    \big| B^{\{2\}} \cap O_1 \big|
   377	    =  \sum_{C \in \C_1} \big| (B \cap C)^{\{2\}} \big|
   378	    = \frac{1}{2} \sum_{C \in \C_1} |B \cap C| \cdot \big( |B \cap C| - 1\big)
   379	    = \frac{1}{2} \sum_{C \in \C_1} x_C (x_C - 1). \]
   380	To determine $\big| B^{\{2\}} \cap O_i \big|$ for $i \geq 2$, recall that point pairs $\{\alpha,\beta\}$ in $O_i$, that is,  $i$-strong inner pairs, must lie in the same $\C_i$-class and in different $\C_{i-1}$-classes, and observe that for any class $C' \in \C_i$, a pair $\{\alpha,\beta\}$ of points in $B \cap C'$ lies in the orbit $O_i$ exactly when $\alpha \in C$ for some $\C_{i-1}$-class $C \subseteq C'$ but $\beta \notin C$. With $\C_{i-1}(C')$ as in \eqref{C(X)} we have
   381	    \begin{align*}
   382	    \big| (B \cap C')^{\{2\}} \cap O_i \big|
   383	    &= \frac{1}{2} \sum_{C \in \C_{i-1}(C')} |B \cap C| \cdot \big( |B \cap C'| - |B \cap C| \big) \\
   384	    &= \frac{1}{2} \sum_{C \in \C_{i-1}(C')} x_{C} \big( x_{C'} - x_{C} \big)
   385	    \end{align*}
   386	and so
   387	    \begin{align*}
   388	    \big| B^{\{2\}} \cap O_i \big|
   389	    &= \sum_{C' \in \C_i} \big| (B \cap C')^{\{2\}} \cap O_i \big|
   390	    = \frac{1}{2} \sum_{C' \in \C_i} \ \sum_{C \in \C_{i-1}(C')} x_{C} \big( x_{C'} - x_{C} \big).
   391	    \end{align*}
   392	Note that the double summation runs over all pairs $(C',C)$ such that $C'\in\C_i$, $C\in\C_{i-1}$, and $C\subset C'$. For each $C\in\C_{i-1}$, the unique possibility for $C'$ is the class $C' = C^+$ 
   393	defined in \eqref{C+}. Thus writing the double summation as a single summation over $C \in \C_{i-1}$, and writing $C^+$ instead of $C'$, we have
   394	    \[
   395	    \frac{1}{2} \sum_{C' \in \C_i} \ \sum_{C \in \C_{i-1}(C')} x_{C} \big( x_{C'} - x_{C} \big)
   396	    = \frac{1}{2} \sum_{C \in \C_{i-1}} x_{C} \big( x_{C^+} - x_{C} \big).
   397	    \]
   398	Therefore, rewriting the conditions in \eqref{ratio} and \eqref{ratio2},  $\D$ is a $2$-design if and only if
   399	    \[
   400	    \frac{1}{2} \sum_{C \in \C_1} x_C (x_C - 1)
   401	    = \frac{1}{2} \cdot \frac{k(k-1)}{v-1} \,(e_1 - 1)
   402	    \]
   403	and
   404	    \[
   405	    \frac{1}{2} \sum_{C \in \C_{i-1}} x_{C} \big( x_{C^+} - x_{C} \big)
   406	    = \frac{1}{2} \cdot \frac{k(k-1)}{v-1} \,(e_i - 1) \prod_{j \leq i-1} e_j,\quad \text{ for all } i \in \{2, \ldots, s\}, 
   407	    \]
   408	which yield condition \eqref{2des-1} and conditions \eqref{2des} for all $i \in \{2, \ldots, s\}$.
   409	
   410	Observe that the right hand side of the equalities \eqref{2des-1} and \eqref{2des} are even integers, since the expressions on the left hand side count the number of ordered pairs of distinct points that lie in the same $\C_1$-class for \eqref{2des-1}, and that lie in the same $\C_i$-class but different $\C_{i-1}$-classes for \eqref{2des}. Hence, for each $i \in \{1, \ldots, s\}$, the number $\frac{1}{2} \cdot \frac{k(k-1)}{v-1} \,(e_i - 1) \prod_{j \leq i-1} e_j = \frac{1}{v-1} \cdot \binom{k}{2} \,(e_i - 1) \prod_{j \leq i-1} e_j$ is an integer. Since $v-1 = \big(\prod_{j=0}^s e_j\big) - 1$ is coprime to $\prod_{j \leq i-1} e_j$, the number $v-1$ must divide $\binom{k}{2}(e_i - 1)$ for each $i \in \{1, \ldots, s\}$. Therefore $v-1$ divides $\binom{k}{2} \cdot \gcd(e_1-1, \ldots, e_s-1)$.
   411	
   412	This proves Theorem~\ref{mainthm:2des}.
   413	\end{proof}
   414	
   415	We explore these conditions further.
   416	Recall from Remark \ref{rem:s-cond} that conditions \eqref{2des-1} and \eqref{2des} consist of $s$ equations. We see in the next result that these $s$ equations are not independent.
   417	
   418	\begin{lemma} \label{lem:2des-red}
   419	If any $s-1$ equations out of the $s$ equations in \eqref{2des-1} and \eqref{2des} are satisfied, then the remaining equation is also satisfied.
   420	\end{lemma}
   421	
   422	\begin{proof}
   423	Recall from the proof of Theorem \ref{mainthm:2des} that the condition \eqref{2des-1} is equivalent to \eqref{ratio} with $i=1$, and for any $i \in \{2, \ldots, s\}$ the condition \eqref{2des} is equivalent to \eqref{ratio}. Hence to prove the result it is enough to show that if \eqref{ratio} holds for all $i \in \{1, \ldots, s\} \setminus \{i'\}$ (for some $1 \leq i' \leq s$) then \eqref{ratio} holds for $i = i'$. Indeed, observe that
   424	    \[ \big| B^{\{2\}} \cap O_{i'} \big| = \sum_{1 \leq i \leq s} \big| B^{\{2\}} \cap O_i \big| - \sum_{1 \leq i \leq s, \ i \neq i'} \big| B^{\{2\}} \cap O_i \big|. \]
   425	Since $\sum_{i=1}^s \big| B^{\{2\}} \cap O_i \big| = \big| B^{\{2\}} \big| = \frac{1}{2} k(k-1)$, and since, by hypothesis, \eqref{ratio} holds for all $i \neq i'$, we can replace the terms of the sums on the right side of the equation above to obtain
   426	    \begin{align*}
   427	    \sum_{1 \leq i \leq s} \big| B^{\{2\}} \cap O_i \big| - \sum_{1 \leq i \leq s, \ i \neq i'} \big| B^{\{2\}} \cap O_i \big|
   428	    &= \frac{k(k-1)}{2} - \sum_{1 \leq i \leq s, \ i \neq i'} \frac{k(k-1)}{v(v-1)} \cdot |O_i| \\
   429	    &= \frac{k(k-1)}{2} - \frac{k(k-1)}{v(v-1)} \sum_{1 \leq i \leq s, \ i \neq i'} |O_i| \\
   430	    &= \frac{k(k-1)}{2} - \frac{k(k-1)}{v(v-1)} \left( \left( \sum_{1 \leq i \leq s} |O_i| \right) - |O_{i'}| \right).
   431	    \end{align*}
   432	Now $\sum_{i=1}^s |O_i| = \big| \PP^{\{2\}} \big| = \frac{1}{2} v(v-1)$, so
   433	    \[ \frac{k(k-1)}{v(v-1)} \left( \left( \sum_{1 \leq i \leq s} |O_i| \right) - |O_{i'}| \right) 
   434	    = \frac{k(k-1)}{v(v-1)} \left( \frac{v(v-1)}{2} - |O_{i'}| \right)
   435	    = \frac{k(k-1)}{2} - \frac{k(k-1)}{v(v-1)} \cdot |O_{i'}|. \]
   436	Thus
   437	    \[ \big| B^{\{2\}} \cap O_{i'} \big| = \sum_{1 \leq i \leq s} \big| B^{\{2\}} \cap O_i \big| - \sum_{1 \leq i \leq s, \ i \neq i'} \big| B^{\{2\}} \cap O_i \big| = \frac{k(k-1)}{v(v-1)} \cdot |O_{i'}|, \]
   438	which shows that \eqref{ratio} holds for $i = i'$, as required. This proves the lemma.
   439	\end{proof}
   440	
   441	Corollary \ref{cor:2des-red} is an immediate consequence of Theorem \ref{mainthm:2des} and Lemma \ref{lem:2des-red}. Note that since $G = S_{e_1} \wr \ldots \wr S_{e_s}$, the structure $\D = \big(\PP, B^G\big)$ in Theorem \ref{mainthm:2des} is $\D(e_1, \ldots, e_s; \,\chi)$ for any array function $\chi$ that is $G$-equivalent to $\chi_B$.
   442	
   443	\begin{corollary} \label{cor:2des-red}
   444	Given integers $s \geq 2$ and $e_1, \ldots, e_s \geq 2$, and an array function $\chi : \bigcup_{i=1}^{s}  \C_i \rightarrow \mathbb{Z}_{\geq 0}$ as in Definition $\ref{def:array}$, the incidence structure $\D(e_1, \ldots, e_s; \,\chi)$ is a $2$-design if and only if $s-1$ out of the $s$ equations in \eqref{2des-1} and \eqref{2des} hold.
   445	\end{corollary}
   446	
   447	\begin{remark} \label{rem:2des-b}
   448	Let $(\delta_j)_{j>i-1} \in \prod_{j>i-1} \Delta_j$. 
   449	Recall from \eqref{partition} that $C_{(\delta_j)_{j>i-1}}$ is a class of $\C_{i-1}$, and from \eqref{C+} that $(C_{(\delta_j)_{j>i-1}})^+ = C_{(\delta_j)_{j>i}}$ is a class $C$ of $\C_i$. Using this labelling of $\C_i$, the parameter $x_C$ defined in \eqref{x_C} can be denoted by $x_C = x_{(\delta_j)_{j>i}}$. That is,
   450	     \begin{equation} \label{array-specific} x_{(\delta_j)_{j>i}} := \big| B \cap C_{(\delta_j)_{j>i}}\big|, \end{equation}
   451	so $x_{(\delta_j)_{j>i}} = \chi\big(C_{(\delta_j)_{j>i}}\big)$ for $i \geq 0$. Thus, using the notation \eqref{array-specific}, we can write the left hand side of \eqref{2des} as
   452	    \[
   453	    \sum_{C \in \C_{i-1}} x_C \left( x_{C^+} - x_C \right)
   454	    = \sum_{(\delta_j)_{j>i-1} \in \prod_{j>i-1} \Delta_j} x_{(\delta_j)_{j>i-1}} \big( x_{(\delta_j)_{j>i}} - x_{(\delta_j)_{j>i-1}} \big).
   455	    \]
   456	Hence condition \eqref{2des} is equivalent to
   457	    \begin{equation} \label{2des-b}
   458	    \sum_{(\delta_j)_{j>i-1} \in \prod_{j>i-1} \Delta_j} x_{(\delta_j)_{j>i-1}} \left( x_{(\delta_j)_{j>i}} - x_{(\delta_j)_{j>i-1}} \right)
   459	    = \frac{k(k-1)}{v-1} (e_i - 1) \prod_{j \leq i-1} e_j
   460	    \end{equation}
   461	    for $i\in\{2,\dots,s\}$.
   462	\end{remark}
   463	
   464	\begin{remark}
   465	Assume that $s = 2$. By Corollary \ref{cor:2des-red}, the point-block structure $\D = \D(e_1, e_2; \,\chi)$ is a $2$-design if and only if condition \eqref{2des} holds for $i = 1$. It follows from \eqref{2des-1} that $\D$ is a $2$-design if and only if
   466	    \[ 
   467	    \sum_{\delta_2 \in \Delta_2} x_{(\delta_2)} \big( x_{(\delta_2)} - 1 \big) = \frac{k(k-1)}{v-1} (e_1 - 1). \]
   468	Recall from Subsection \ref{subsec:chain} that $e_1 = c_1$ and that $|\Delta_2| = e_2 = d_1$; take $\Delta_2 = \{1, \ldots, d_1\}$. Thus $\D$ is a $2$-design if and only if
   469	    \[ \sum_{\delta_2 = 1}^{d_1} x_{(\delta_2)} \big( x_{(\delta_2)} - 1 \big) = \frac{k(k-1)}{v-1} (c_1 - 1), \]
   470	which is precisely  \cite[Proposition 2.2 (ii)]{CP93}.
   471	\end{remark}
