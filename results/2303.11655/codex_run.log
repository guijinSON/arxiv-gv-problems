def read_meta():
    try:
        with open(META) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def update_meta(**fields):
    meta = read_meta()
    meta.update(fields)
    with open(META, "w") as f:
        json.dump(meta, f, indent=1)


