+        (1 << (stage - 1), -1) for stage in range(2, inst["n"])
+    ]
+    for entries in groups.values():
+        if sorted(entries) != sorted(expected_scales):
+            raise ValueError("an exponent ray is not a complete Lemma 4.1 chain")
