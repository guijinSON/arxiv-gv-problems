    \hline\hline
    $(\underbrace{0,\ldots,0}_{s-i+1})$ & $p^{2^{i-2}} + 1$ & $p^{2^{i-1}} + 1$ & $p^{2^{i-2}}$ & $p^{2^{i-1}} - p^{2^{i-2}}$ \\
    $(\delta_i,\underbrace{0,\ldots,0}_{s-i})$, $\delta_i \in \mathbb{Z}^*_{e_i}$ & $1$ & $p^{2^{i-1}} + 1$ & $0$ & $p^{2^{i-1}}$ \\
