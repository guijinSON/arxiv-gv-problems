    &\sum_{(\delta_2,\delta_3,\delta_4) \in \mathbb{Z}_3^3} x_{(\delta_2,\delta_3,\delta_4)} \big( x_{(\delta_3,\delta_4)} - x_{(\delta_2,\delta_3,\delta_4)} \big) \\
    &= 3 \cdot 1(3-1) + 2 \cdot 2(2-2) + 3 \cdot 1(3-1) + 2(2-2) + 1(1-1) + 3 \cdot 1(3-1) \\
