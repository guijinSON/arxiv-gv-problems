+        "bits": bits,
+        "vertex_count": vertex_count,
+        "graph_edges": graph_edges,
+        "tags": tags,
+        "slots": slots,
+        "adjacency": adjacency,
+        "quick": quick,
+    }
+    _PREPARED_CACHE[id(inst)] = (inst, data)
+    return data, "ok"
