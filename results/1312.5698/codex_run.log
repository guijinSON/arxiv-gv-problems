+    }
+
+    invariant_ok = 0
+    carried_ok = 0
+    original_keys = []
+    for seed in range(20):
+        original = make_instance(seed=9000 + seed, **DIFFICULTY["medium"])
+        transformed, carried = _relabel_instance(original, random.Random(70000 + seed))
+        original_key = canonical_key(original)
