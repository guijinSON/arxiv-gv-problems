+    transformed["probe_vertex"] = labels[inst["probe_vertex"]]
+    transformed["probe_edges"] = sorted(
+        (row[:] for row in rows if transformed["probe_vertex"] in row[:2]),
+        key=lambda row: (row[3], row[2]),
