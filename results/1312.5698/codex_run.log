+    probe_rows = sorted((edge_rows[i][:] for i in incident[probe]), key=lambda row: (row[3], row[2]))
+    return {
+        "paper": "arXiv:1312.5698",
+        "n": n,
+        "bits": bits,
+        "vertex_count": vertex_count,
+        "edge_count": len(edge_rows),
+        "edges": edge_rows,
+        "probe_vertex": probe,
+        "probe_edges": probe_rows,
+        "answer": {"mask": mask},
+    }
+
