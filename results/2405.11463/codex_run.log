+  "G1_planted_verifies": {
+    "attempts": 12,
+    "json_roundtrips": 12,
+    "pass": true,
+    "verified": 12
+  },
+  "G2_rejects_corruption": {
+    "attempts": 5,
+    "distinct_reasons": 5,
+    "pass": true,
