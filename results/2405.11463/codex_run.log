+        "A descending three-term sparse-polynomial fragment over F_q: exactly "
+        "[[1,[n]],[c1,[n-1]],[c2,[n-2]]], with c1,c2 independently ranging "
+        "over the canonical residues 0,...,q-1."
+    ),
+    "bounds": {
+        "terms": 3,
+        "variables": 1,
+        "free_coefficients": 2,
+        "coefficient_modulus": _Q,
+        "max_degree": _MAX_DEGREE,
+    },
+}
