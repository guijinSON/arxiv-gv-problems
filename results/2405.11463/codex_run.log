+        "composed_refactoring_and_root_scaling_invariance": invariant,
+        "invariance_attempts": 20,
+        "carried_witnesses_verified": carried_ok,
+        "carried_attempts": 20,
+        "unrelated_distinct_keys": len(set(keys)),
+        "unrelated_attempts": 20,
+    }
