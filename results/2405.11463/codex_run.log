+++ b/selftest_report.json
@@ -0,0 +1,139 @@
+{
+  "G1_planted_verifies": {
+    "attempts": 12,
+    "json_roundtrips": 12,
+    "pass": true,
+    "verified": 12
+  },
+  "G2_rejects_corruption": {
