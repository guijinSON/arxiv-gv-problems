+# Updated after the script-owned hardening and diagnostic runs.
+_ORACLE_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
+    "hinted_verdict": "not_run",
+}
