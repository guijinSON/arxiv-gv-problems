+            "solves": f"{ref_successes}/{_ATTACK_SEEDS}, as expected",
+        },
+    }
+
+    # G7 doubles degree only; certificate size is fixed.
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
