+    "easy": {"n": 4_096, "chain_length": 8},
+    "medium": {"n": 65_536, "chain_length": 16},
+    "hard": {"n": 262_144, "chain_length": 32},
+}
+SHIPPING_DIFFICULTY = "easy"
