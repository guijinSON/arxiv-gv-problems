+def _dense_reference(inst: dict, materialize: bool = True
+                     ) -> tuple[list[list[object]], int, int]:
+    """Expand every coefficient of U^-n((UX+V)^n-3) in O(n)."""
+    q, n = inst["q"], inst["degree"]
