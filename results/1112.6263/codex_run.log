36:\title{On the Complexity of Solving Quadratic Boolean Systems}
37:\author[1]{Magali Bardet}
38:\author[2,3,4]{Jean-Charles Faug\`ere}
39:\author[5]{Bruno Salvy}
40:\author[2,3,4]{Pierre-Jean Spaenlehauer}
41:\affil[1]{\'Equipe Combinatoire et Algorithmes -- Universit\'e de Rouen/LITIS}
42:\affil[2]{INRIA, Paris-Rocquencourt Center, SALSA Project}
43:\affil[3]{CNRS, UMR 7606, LIP6}
44:\affil[4]{UPMC, Univ Paris 06, LIP6
45:       {\small UFR Ing\'enierie 919, LIP6,
46:       Case 169, 4, Place Jussieu, F-75252 Paris}}
