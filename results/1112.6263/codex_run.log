def clip(q, head=45, tail=12):
    L = q.splitlines()
    if len(L) <= head + tail + 3:
        return q
    n = len(L) - head - tail
    return "\n".join(L[:head] + ["", f"    ... [{n} lines of instance data omitted] ...", ""] + L[-tail:])

with open("samples/SAMPLES.md", "w") as f:
    f.write("# One sample question per generator\n\n")
