def solve(n,eq,cap=200000):
 occ=[[] for _ in range(n)]
 for e,(ps,c) in enumerate(eq):
  for i,j in ps:occ[i].append(e);occ[j].append(e)
 order=sorted(range(n),key=lambda x:-len(occ[x])); nodes=0; asn=[-1]*n
 def prop():
