+    doubled["m"] = 2 * shipping_params["m"]
+    doubled_inst = make_instance(seed=271828, **doubled)
+    doubled_ok, doubled_why = verify(doubled_inst, doubled_inst["answer"])
+    fixed_escalation = escalate(dict(shipping_params))
+    report["G7_scales"] = {
