+)
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A vector of exactly n Boolean field elements, each encoded by the JSON "
+        "integer 0 or 1, with 4 <= n <= 192."
+    ),
+    "bounds": {
