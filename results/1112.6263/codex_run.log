+    for i in range(n):
+        singleton_col = col[(i,)] - 1
+        candidate.append(values.get(singleton_col, 0))
+    stats = {
+        "macaulay_rows": len(lifted_rows),
+        "macaulay_columns": len(basis3),
+        "rank": len(pivots),
+        "xor_operations": xor_operations,
+        "inconsistent": inconsistent,
+    }
