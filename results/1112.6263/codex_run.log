+    inst = {
+        "n": n,
+        "m": m,
+        "basis_size": basis_size,
+        "hex_width": width,
+        "attack_budget": attack_budget,
+        "equations": [format(row, f"0{width}x") for row in accepted_rows],
+        "_rows": accepted_rows,
+        "answer": answer,
+    }
