+def _active_mask(bits: list[int]) -> int:
+    """Coefficient-basis mask of monomials evaluating to one at bits."""
+    n = len(bits)
+    mask = 1  # the constant monomial
+    for i, b in enumerate(bits):
+        if b:
+            mask |= 1 << (1 + i)
+    pos = 1 + n
+    for i in range(n - 1):
+        if bits[i]:
+            for j in range(i + 1, n):
+                if bits[j]:
+                    mask |= 1 << pos
+                pos += 1
+        else:
+            pos += n - i - 1
+    return mask
+
