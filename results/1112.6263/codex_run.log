 return es

def solve(n,eq,cap=500000):
 occ=[0]*n
 for ps,c in eq:
  for i,j in ps:occ[i]+=1;occ[j]+=1
 order=sorted(range(n),key=lambda x:-occ[x]); A=[-1]*n;nodes=0
 def prop():
