+
+def _gray_inverse(gray: int) -> int:
+    value = 0
+    while gray:
+        value ^= gray
+        gray >>= 1
+    return value
+
+
+def _prefix_solution(rows: list[int], n: int, budget: int) -> list[int] | None:
+    """Bounded Gray-code exhaustive attack used only as an easy-case filter."""
+    budget = max(0, int(budget))
+    bits = [0] * n
