  while change:
   change=0
   for ps,c in eq:
    par=0;u=[]
    for i,j in ps:
     x,y=A[i],A[j]
     if x==0 or y==0:continue
     if x==y==1:par''^=1
     else:u.append((i,j))
    need=c''^par
    if not u:
     if need:return 0
    elif len(u)==1:
     i,j=u[0];x,y=A[i],A[j]
