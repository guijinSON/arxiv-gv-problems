+    rng = random.Random(seed)
+    ceiling = 1 << n
+    # The filter enumerates the first attack_budget Gray words.  Keeping the
+    # planted answer out of that prefix prevents a rejection loop and removes a
+    # the uniform prior at non-demo sizes.
+    while True:
