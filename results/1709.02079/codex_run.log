%\begin{eqnarray*}
% S&:=&\{1, \ldots, n^2\}\setminus\{i_1, \dots, i_{|T|}\},\\
% S&=&\{ j_1, \dots,j_{n^2-|T|}\},
% \end{eqnarray*}
