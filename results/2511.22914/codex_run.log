	\begin{definition}
		Let $R$ be a relation on $\{0,1\}$.
		\begin{itemize}
			\item $R$ is \emph{bijunctive} if it is the set of solutions of a 2-CNF-formula.
			\item $R$ is \emph{componentwise bijunctive} if every connected component $G(R)$ is a bijunctive relation.
			\item $R$ is \emph{safely componentwise bijunctive} if $R$ and every relation $R'$ obtained from $R$ by identification of variables is componentwise bijunctive.
		\end{itemize}
		We denote the set of safely componentwise bijunctive relations by $\varGamma_{\scb}$.
	\end{definition}
	
	\ifconference
