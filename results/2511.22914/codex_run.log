+
+# These values are replaced with measurements from script-owned transcripts
+# after the three hardening arms have run.  They never affect G9's gated cap.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
