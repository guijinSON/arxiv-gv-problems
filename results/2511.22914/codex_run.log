+def _attack_static_greedy(inst):
+    active = _changing_variables(inst)
+    active_set = set(active)
+    score = Counter()
+    for left, right in inst["implications"]:
+        if left in active_set:
+            score[left] += 1
+        if right in active_set:
+            score[right] -= 1
