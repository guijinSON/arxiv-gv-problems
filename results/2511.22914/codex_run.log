+    "medium": {"n": 73, "active_count": 12, "decoy_percent": 24},
+    "hard": {"n": 131, "active_count": 12, "decoy_percent": 32},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The endpoint-difference indices form a modular arithmetic progression "
+    "under the modulus equal to the number of variables."
+)
+PLACEBO_HINT = (
+    "The endpoint assignments and grouped inequalities reward careful "
+    "attention to variable indices and constraint directions."
