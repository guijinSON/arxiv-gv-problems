+def _attack_outlier_degree(inst):
+    active = _changing_variables(inst)
+    degrees = Counter()
+    for left, right in inst["implications"]:
+        degrees[left] += 1
+        degrees[right] += 1
+    candidate = _candidate_from_order(active, [(-degrees[v], v) for v in active])
+    return verify(inst, candidate)[0]
