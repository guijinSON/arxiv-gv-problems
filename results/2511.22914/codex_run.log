+    )
+    compact_ok = compact_answer is not None and verify(shipping, compact_answer)[0]
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and compact_stats["operations"] <= 300
+    )
+    report["G9_no_tool_suitability"] = {
