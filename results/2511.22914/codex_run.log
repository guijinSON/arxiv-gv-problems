		Let $r$ be a positive integer and $R$ is an $r$-ary relation $R \subseteq \{0,1\}^r$.
		Then, $R$ is safely NAND-free if and only if 
		it is invariant under the \emph{$(D,\le)$-Maltsev} operation.
	\end{lemma}
	%\begin{proof}
	%The proof is analogous to that of \cref{thm:OR-free=partial-ordered-Maltsev}.
	%\end{proof}
	\fi 
	
	\begin{theorem}\label{thm:SNF<=>ordered-Maltsev}
		Let $D = \{0,1\}$ and $1 < 0$.
		Then $\varGamma_{\snand} = \inv(M_{D,\le})$.
	\end{theorem}
	
