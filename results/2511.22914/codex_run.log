+    "under the modulus equal to the number of variables."
+)
+PLACEBO_HINT = (
+    "The endpoint assignments and grouped inequalities reward careful "
+    "attention to variable indices and constraint directions."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list containing every endpoint-difference variable exactly "
+        "once; its length is k and its entries are distinct indices in "
+        "0,...,p-1.  The order is the proposed shortest reconfiguration path."
