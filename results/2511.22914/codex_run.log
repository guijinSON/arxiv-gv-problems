+
+def _reorder_constraints(inst, rng):
+    transformed = copy.deepcopy(inst)
+    rng.shuffle(transformed["pins"])
+    rng.shuffle(transformed["implications"])
+    transformed["answer"] = list(inst["answer"])
+    return _refresh_derived(transformed)
