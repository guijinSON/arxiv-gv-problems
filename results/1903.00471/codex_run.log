import time

def paley(q):
    residues={x*x%q for x in range(1,(q+1)//2)}
    def chi(x):
        x%=q
        if x==0:return 0
        return 1 if x in residues else -1
    n=q+1
    W=[[0]*n for _ in range(n)]
    for s in range(q):
        for t in range(q):
            W[s][t]=chi(t-s)
        W[s][q]=1
        W[q][s]=1
    return W

def verify(W,q):
    n=q+1
    for i in range(n):
        for j in range(n):
            z=sum(W[i][k]*W[j][k] for k in range(n))
            if z "'!= (q if i==j else 0):
                return False
    return True
for q in (3,5,7,11,13):
    W=paley(q)
    assert verify(W,q)
    reps=20000
    t=time.perf_counter()
    for _ in range(reps): paley(q)
    build=(time.perf_counter()-t)/reps
    reps2=5000
    t=time.perf_counter()
    for _ in range(reps2): verify(W,q)
    chk=(time.perf_counter()-t)/reps2
    residue_mults=(q-1)//2
    differences=q*(q-1)
    print(q, q+1, (q+1)**2, residue_mults+differences, f'"'{build:.9f}', f'{chk:.9f}')
