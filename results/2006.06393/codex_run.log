+
+    PROBLEM_PROFILE["max_answer_tokens"] = answer_tokens
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(shipping_params)
+    report["certificate_language"] = CERTIFICATE_LANGUAGE
