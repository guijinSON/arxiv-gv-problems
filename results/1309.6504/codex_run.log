+def _render_blocks(inst: dict) -> str:
+    width = (inst["part_size"] + 3) // 4
+    lines = []
+    for block in inst["blocks"]:
+        i, j = block["parts"]
+        encoded = " ".join(format(row, f"0{width}x") for row in block["rows"])
+        lines.append(f"{i},{j}: {encoded}")
+    return "\n".join(lines)
