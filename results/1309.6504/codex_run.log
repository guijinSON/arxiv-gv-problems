import random,time,math

def gen(k,s,p,seed):
 r=random.Random(seed); plant=[r.randrange(s) for _ in range(k)]; B={}
 for i in range(k):
  for j in range(i+1,k):
   rows=[]
   for a in range(s):
    mask=0
    for b in range(s):
     if r.randrange(10000)<p:mask|=1<<b
    rows.append(mask)
   rows[plant[i]]|=1<<plant[j];B[i,j]=rows
 return plant,B

def edge(B,i,a,j,b):
 return bool((B[i,j][a]>>b)&1) if i<j else bool((B[j,i][b]>>a)&1)
def candok(x,B):
 return all(edge(B,i,x[i],j,x[j]) for i in range(len(x)) for j in range(i+1,len(x)))
def domains_for(B,k,s,c,a):
 out={}
 for d in range(k):
  if d==c:continue
  if c<d:out[d]=B[c,d][a]
  else:
   z=0
   for b,row in enumerate(B[d,c]):
    if row>>a&1:z|=1<<b
   out[d]=z
 return out

def solve(k,s,B,limit=50000):
 full=(1<<s)-1;nodes=0;ans=[-1]*k; cache={}
 def nb(c,a,d):
  key=(c,a,d)
  if key not in cache:cache[key]=domains_for(B,k,s,c,a)[d]
  return cache[key]
 def rec(dom,rem):
  nonlocal nodes
  if not rem:return ans.copy()
  if nodes>=limit:return None
  c=min(rem,key=lambda x:dom[x].bit_count()); vals=dom[c];order=[]
  while vals:
   bit=vals&-vals;a=bit.bit_length()-1;vals-=bit
   score=sum((dom[d]&nb(c,a,d)).bit_count() for d in rem if d"'!=c)
   order.append((-score,a))
  for _,a in sorted(order):
   nodes+=1
   if nodes>limit:return None
   nd=dom.copy();nr=rem-{c};ok=True
   for d in nr:
    nd[d]&=nb(c,a,d)
    if not nd[d]:ok=False;break
   if ok:
    ans[c]=a;z=rec(nd,nr)
    if z is not None:return z
  ans[c]=-1;return None
 t=time.perf_counter();z=rec([full]*k,set(range(k)));return z,nodes,time.perf_counter()-t

def degree(B,k,s):
 deg=[[0]*s for _ in range(k)]
 for (i,j),rows in B.items():
  for a,row in enumerate(rows):
   deg[i][a]+=row.bit_count()
   x=row
   while x:
    bit=x&-x;b=bit.bit_length()-1;x-=bit;deg[j][b]+=1
 return [max(range(s),key=lambda a:(deg[i][a],-a)) for i in range(k)]
def greedy(B,k,s):
 x=[]
 for i in range(k):
  opts=[a for a in range(s) if all(edge(B,j,x[j],i,a) for j in range(i))]
  if not opts:return None
  x.append(opts[0])
 return x

def restarts(B,k,s,seed,R=256):
 r=random.Random(seed)
 for _ in range(R):
  order=list(range(k));r.shuffle(order);x=[-1]*k
  for c in order:
   opts=[a for a in range(s) if all(x[d]<0 or edge(B,c,a,d,x[d]) for d in range(k))]
   if not opts:break
   x[c]=r.choice(opts)
  else:return x
 return None
for seed in range(100,108):
 pl,B=gen(22,48,7000,seed)
 d=degree(B,22,48);g=greedy(B,22,48);rr=restarts(B,22,48,seed''^999)
 z,n,t=solve(22,48,B)
