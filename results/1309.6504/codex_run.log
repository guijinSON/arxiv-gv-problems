+    # exactly at a 1 bit.  At every (i,j,x), V(i,a_i) swaps P_i -> Q_ij iff
+    # x=a_i, while that same edge-card swaps Q_ij -> P_i iff x=a_i.  Thus all
+    # q labels occur once in every attribute precisely when all bits below are 1.
+    for i in range(k):
