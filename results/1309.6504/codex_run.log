+    "left-to-right greedy clique, 256 randomized greedy restarts, centered "
+    "spectral recovery, and a 50,000-node exact forward-checking clique solver."
+)
+
+
+# Filled from isolated harden.py runs after the local mathematical gates pass.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
