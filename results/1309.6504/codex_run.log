+    # G9: oracle arms are transcript-derived; size and route counts are exact.
+    answer_blob = json.dumps(shipping["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
