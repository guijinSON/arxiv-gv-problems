+        "named_work_sizes": work_sizes,
+        "named_n_values": [p["n"] for p in DIFFICULTY.values()],
+        "doubled_n": doubled_params["n"],
+        "doubled_work_size": (
+            doubled["source_colors"] * doubled["part_size"]
+            + doubled["source_edge_count"]
