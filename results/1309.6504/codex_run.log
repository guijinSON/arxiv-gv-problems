%\centering
%\includegraphics[scale=0.4]{vertices.eps}
%\caption{The vertex-multiedge of $G'$ that corresponds to vertex $v_{13}$ of part $V_1$ in $G$.}
%\label{fig:vertices}
%\end{figure}

%\begin{figure}[h]
%\centering
%\includegraphics[scale=0.4]{edges.eps}
%\caption{The edge-multiedge of $G'$ that corresponds to the edge $e_{ij}$ of $G$ that connects the $1^{st}$ vertex in part $V_i$ to the $2^{nd}$ vertex in part $V_j$.}
%\label{fig:edges}
%\end{figure}

\begin{figure}[ht]
\centering
\begin{minipage}[b]{0.45\linewidth}
\centering
\includegraphics[scale=1.2]{vertices}
\caption{The vertex-multiedge of $G'$ that corresponds to vertex $v_{13}$ of part $V_1$ in $G$.}
\label{fig:vertices}
\end{minipage}
\hspace{0.5cm}
\begin{minipage}[b]{0.45\linewidth}
