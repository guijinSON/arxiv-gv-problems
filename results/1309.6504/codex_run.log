+            "completeness": "complete if run without the reported node cap",
+            "complexity": "O(part_size^source_colors) worst case",
+            "aggregate_nodes": dpll_nodes,
+            "aggregate_wall_clock_seconds": dpll_seconds,
+        },
+    }
