+        "unbounded attributes; the hard preset uses source k=22, q=253, "
+        "22,176 attributes, and 48 vertices per color at the planted-clique "
+        "threshold, while the measured 50,000-node exact clique attack fails "
+        "on all eight shipping seeds."
+    ),
+    "max_answer_tokens": 42,
+}
+
+NATIVE = {
