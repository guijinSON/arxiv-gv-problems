+        "source_colors": n,
+        "part_size": part_size,
+        "density_per_10000": density,
+        "blocks": blocks,
+        "source_edge_count": edge_count,
+        "set_size": q,
+        "number_of_values": q,
+        "number_of_attributes": attributes,
+        "number_of_vertex_cards": n * part_size,
+        "number_of_edge_cards": edge_count,
