+                failures.append(f"{preset}/{seed}: answer is not JSON-native")
+            if preset == "demo":
+                demo_expansions += 1
+                if not _explicit_demo_set_check(inst, inst["answer"]):
+                    failures.append(f"{preset}/{seed}: expanded SET failed")
+    report["G1_planted_verifies"] = {
