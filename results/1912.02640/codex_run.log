+    ok, reason = verify(inst, answer)
+    return {
+        "answer": answer,
+        "ok": ok,
+        "reason": reason,
+        "wall_clock_sec": elapsed,
+        "field_operations": counter.field_operations,
+        "bit_operations": counter.bit_operations,
+    }
