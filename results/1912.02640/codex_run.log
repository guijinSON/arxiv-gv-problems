+    return _mul_raw_counted(a, a, modulus, n, counter)
+
+
+def _mul_raw_counted(a: int, b: int, modulus: int, n: int,
+                     counter: _FieldCounter | None) -> int:
+    result = 0
+    top = 1 << n
+    while b:
+        if counter is not None:
+            counter.bit_iterations += 1
+        if b & 1:
+            result ^= a
+        b >>= 1
+        a <<= 1
+        if a & top:
