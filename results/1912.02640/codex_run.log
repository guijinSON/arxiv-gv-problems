+def _attack_small_expression_ansatz(inst: dict) -> bool:
+    t = inst["t"]
+    t2 = _square(t, inst["modulus"], inst["n"])
+    values = {t, t ^ 1, t2, t2 ^ 1}
+    for alpha in values:
+        for beta in values:
+            if alpha not in (0, 1) and beta not in (0, alpha):
+                if _candidate_ok(inst, [alpha, beta]):
+                    return True
+    return False
