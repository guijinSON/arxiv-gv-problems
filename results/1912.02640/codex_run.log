+                 and witness_checks == transform_count and len(unrelated) == 20),
+        "invariance_checks": invariance_checks,
+        "invariance_attempts": transform_count,
+        "transformed_witness_checks": witness_checks,
+        "unrelated_distinct": len(unrelated),
