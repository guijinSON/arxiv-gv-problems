+
+def _attack_random_restart(inst: dict, seed: int, restarts: int = 512) -> bool:
+    rng = random.Random(seed ^ 0x1912026400)
+    for _ in range(restarts):
+        if _candidate_ok(inst, random_candidate(inst, rng)):
+            return True
+    return False
