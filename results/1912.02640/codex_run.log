+    "demo": {"n": 3},
+    "easy": {"n": 31},
+    "medium": {"n": 47},
+    "hard": {"n": 61},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Introduce s through t=s^2+s, and use d=t+1 to express both butterfly "
+    "coefficients directly."
+)
+PLACEBO_HINT = (
+    "Track every reduction in the stated field, and keep all butterfly "
