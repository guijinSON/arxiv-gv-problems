+    top = 1 << n
+    while b:
+        if counter is not None:
+            counter.bit_iterations += 1
+        if b & 1:
+            result ^= a
+        b >>= 1
+        a <<= 1
+        if a & top:
+            a ^= modulus
+            if counter is not None:
+                counter.reduction_xors += 1
