+def escalate(params):
+    """Add matched decoy blocks while keeping the 14-integer witness fixed."""
+    p = {key: value for key, value in params.items() if key != "_preset"}
+    current = int(p.get("n", 1))
+    if current >= 12:
+        return "cap_bound"
+    p["n"] = current + 2
+    return p
