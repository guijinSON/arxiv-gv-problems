+    operations = 0
+
+    def backtrack():
+        nonlocal operations
+        if len(chosen) == len(target_nodes):
+            return True
+        remaining = [u for u in target_nodes if u not in chosen]
+        u = min(remaining,
+                key=lambda x: (-sum(v in chosen for v in target_adj[x]), x))
+        for image in pairs[mapping[u]]:
+            good = True
