+    # G8: arbitrary host/target relabellings, real carried witnesses, diversity.
+    invariant = 0
+    carried = 0
+    distinct_keys = set()
+    for seed in range(20):
+        params = DIFFICULTY["medium"]
+        inst = make_instance(seed=1000 + seed, **params)
+        key = canonical_key(inst)
