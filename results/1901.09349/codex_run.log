+def _attack_high_square_edges(inst):
+    counts, _ = _edge_square_counts(inst["n_vertices"], inst["host_edges"])
+    ordered = sorted(counts, key=lambda e: (-counts[e], e))
+    return _greedy_disjoint_edges(inst, ordered)
