+                              [e for e, value in mult.items() if value == 2])
+    comps = [c for c in comps if len(c) == target_n]
+    if not comps:
+        return None
+    comp = min(comps, key=lambda c: min(min(pairs[x]) for x in c))
+    adj = {x: set() for x in comp}
+    for a, b in mult:
