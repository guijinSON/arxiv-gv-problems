+    duplicate[1].sort()
+    corruptions["duplicate_vertex"] = duplicate
+    empty = json.loads(json.dumps(planted))
+    empty[0] = []
+    corruptions["empty_branch"] = empty
+    outside = json.loads(json.dumps(planted))
