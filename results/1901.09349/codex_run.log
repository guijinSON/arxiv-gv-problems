+    return {
+        "family": "two_sheet_expander_minor",
+        "n_vertices": host_n,
+        "target_vertices": k,
+        "host_degree": base_degree + 1,
+        "alpha_lower_bound": [2, host_n],
+        "host_edges": [list(edge) for edge in labelled_host_edges],
+        "target_edges": [list(edge) for edge in target_edges],
+        "answer": answer,
+    }
