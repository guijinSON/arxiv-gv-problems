+def _greedy_disjoint_edges(inst, ordered_edges):
+    answer = []
+    used = set()
+    for edge in ordered_edges:
+        if edge[0] in used or edge[1] in used:
+            continue
+        answer.append(list(edge))
+        used.update(edge)
+        if len(answer) == inst["target_vertices"]:
+            return answer
+    return None
