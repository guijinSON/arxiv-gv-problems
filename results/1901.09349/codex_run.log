+    "easy": {"n": 4, "k": 14, "base_degree": 3},
+    "medium": {"n": 7, "k": 14, "base_degree": 3},
+    "hard": {"n": 10, "k": 14, "base_degree": 3},
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An ordered JSON list [B0,...,B(k-1)] keyed by target vertices "
+        "0,...,k-1; every Bi is a strictly increasing pair of host vertex "
+        "identifiers, and all 2k identifiers are distinct."
+    ),
+    "bounds": {
+        "branch_sets": "k",
+        "vertices_per_branch": 2,
+        "total_atomic_elements": "2*k (28 at every non-demo preset)",
+        "entry_range": "0 <= vertex < N",
+        "ordering": "branches follow target labels; each pair increases",
+    },
+}
+
+STRUCTURAL_HINT = (
+    "The host's hidden two-sheet involution is visible in how its edges participate in 4-cycles."
+)
