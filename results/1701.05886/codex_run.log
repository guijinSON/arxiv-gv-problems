/bin/bash -lc "python3 - <<'PY'
import random, time, statistics

def inverse_factor(n, k, seed, p=0.5):
    rng = random.Random(seed)
    planted = set(rng.sample(range(n), k))
    adj = [set() for _ in range(n)]
    outside = [v for v in range(n) if v not in planted]
    for v in outside:
        for s in rng.sample(sorted(planted), min(2, k)):
            adj[v].add(s); adj[s].add(v)
    for i, u in enumerate(outside):
        for v in outside[i + 1:]:
            if rng.random() < p:
                adj[u].add(v); adj[v].add(u)
    return [sorted(row) for row in adj]

def greedy_mis(adj):
    blocked = [False] * len(adj)
    chosen, ops = [], 0
    for v in range(len(adj)):
        ops += 1
        if blocked[v]:
            continue
        chosen.append(v); ops += 1
        blocked[v] = True; ops += 1
        for w in adj[v]:
            blocked[w] = True; ops += 1
    return chosen, ops

def is_maximal_independent(adj, chosen):
    S = set(chosen)
    return (all(v not in adj[u] for u in S for v in S if u < v)
            and all(v in S or any(w in S for w in adj[v]) for v in range(len(adj))))

for n, k in ((32, 4), (128, 8)):
    operations, elapsed, answer_pairs, successes = [], [], [], 0
    for seed in range(20):
        G = inverse_factor(n, k, 2 * seed)
        H = inverse_factor(n, k, 2 * seed + 1)
        start = time.perf_counter()
        I, oi = greedy_mis(G)
        J, oj = greedy_mis(H)
        answer = [(x, y) for x in I for y in J]
        elapsed.append(time.perf_counter() - start)
        operations.append(oi + oj + len(answer))
        answer_pairs.append(len(answer))
        successes += int(is_maximal_independent(G, I) and is_maximal_independent(H, J))
    print({
        'factor_vertices_each': n,
        'attempts': 20,
        'successes': successes,
        'ops_mean': statistics.mean(operations),
        'ops_max': max(operations),
        'wall_mean_sec': statistics.mean(elapsed),
        'wall_max_sec': max(elapsed),
        'answer_pairs_mean': statistics.mean(answer_pairs),
        'answer_pairs_max': max(answer_pairs),
    })
