+        operations += 1
+    bits = [0] * n
+    for position, variable in enumerate(order):
+        bits[variable] = bits_by_position[position]
+    return (
+        [inst["generator_pairs"][j][bits[j]] for j in range(n)],
+        operations,
+        search_nodes,
+    )
