+_ZERO = 0
+_E = 1       # [1,1]
+_S = 2       # [1,2]
+_T = 3       # [2,1], included for the full multiplication table
+_F = 4       # [2,2]
+_PAIR_TO_ELEMENT = {(1, 1): _E, (1, 2): _S, (2, 1): _T, (2, 2): _F}
+_ELEMENT_TO_PAIR = {value: key for key, value in _PAIR_TO_ELEMENT.items()}
