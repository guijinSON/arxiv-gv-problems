+    # stepping by three visits every position.  Compute offsets from x_0.
+    offsets = [0] * n
+    operations = 0
+    position = 0
+    for _ in range(n - 1):
+        difference = rhs[position] ^ rhs[(position + 1) % n]
+        operations += 1
+        following = (position + 3) % n
+        offsets[following] = offsets[position] ^ difference
+        operations += 1
+        position = following
