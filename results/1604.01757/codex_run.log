+        stat["wall_clock_sec"] += elapsed
+
+        t0 = time.perf_counter()
+        success, steps = _random_restart(inst, random.Random(seed ^ 0xB2), 256)
+        elapsed = time.perf_counter() - t0
+        stat = attacks["random_restart_256"]
