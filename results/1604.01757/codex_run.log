_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
_ENUMERATION_CAP = 600_000


def _rank_limit(n: int) -> int:
    """Largest integer r satisfying the paper's strict subgeneric inequality."""
    return (n ** 3 - 1) // (3 * n - 2)


def _rank_for_fraction(n: int, fraction: float = 0.88) -> int:
    return max(2, min(_rank_limit(n), int(math.floor(fraction * n ** 3 / (3 * n - 2)))))


def _validate_params(n: int, rank: int) -> None:
    if isinstance(n, bool) or not isinstance(n, int) or n < 3:
        raise ValueError("n must be an integer at least 3")
    if isinstance(rank, bool) or not isinstance(rank, int) or rank < 2:
        raise ValueError("rank must be an integer at least 2")
    if rank > _rank_limit(n):
        raise ValueError("rank must satisfy the strict subgeneric inequality rank*(3*n-2) < n^3")
    if rank >= (1 << (3 * n - 2)):
        raise ValueError("rank exceeds the number of distinct normalized sign atoms")


def _decode_term(code: int, n: int) -> list[list[int]]:
    width = 3 * n - 2
    bits = [1 if (code >> (width - 1 - i)) & 1 else -1 for i in range(width)]
    return [[1] + bits[: n - 1],
            [1] + bits[n - 1 : 2 * n - 2],
            bits[2 * n - 2 :]]


def _encode_term(term: list[list[int]], n: int) -> int:
    values = term[0][1:] + term[1][1:] + term[2]
    code = 0
    for value in values:
        code = (code << 1) | int(value == 1)
    return code


def _sign_at(code: int, n: int, mode: int, coordinate: int) -> int:
    """Read one factor sign directly from its compact normalized code."""
    if coordinate == 0 and mode < 2:
        return 1
    if mode == 0:
        position = coordinate - 1
    elif mode == 1:
        position = (n - 1) + coordinate - 1
    else:
        position = 2 * n - 2 + coordinate
    bit = 3 * n - 3 - position
    return 1 if (code >> bit) & 1 else -1


def _term_tuple(term) -> tuple[tuple[int, ...], tuple[int, ...], tuple[int, ...]]:
    return tuple(tuple(int(x) for x in vector) for vector in term)  # type: ignore[return-value]


def _normalise_term(term) -> list[list[int]]:
    """Choose the unique sign scaling with a[0] = b[0] = +1."""
    a, b, c = [list(map(int, vector)) for vector in term]
    if a[0] == -1:
        a = [-x for x in a]
        c = [-x for x in c]
    if b[0] == -1:
        b = [-x for x in b]
        c = [-x for x in c]
    return [a, b, c]


def _sorted_terms(terms) -> list[list[list[int]]]:
    return [[list(v) for v in term] for term in sorted(_term_tuple(t) for t in terms)]


def _build_tensor(n: int, terms) -> list[list[list[int]]]:
    tensor = [[[0 for _ in range(n)] for _ in range(n)] for _ in range(n)]
    for term in terms:
        a, b, c = term
        for i, ai in enumerate(a):
            plane = tensor[i]
            for j, bj in enumerate(b):
                row = plane[j]
                scale = ai * bj
                for k, ck in enumerate(c):
                    row[k] += scale * ck
    return tensor


def make_instance(n, seed=0, **params) -> dict:
    """Sample normalized sign factors first, then sum their outer products.

    ``n`` is the common length of all three factor vectors.  ``rank`` is the
    exact number of distinct terms required in the witness; if omitted, it is
    chosen near the strictly subgeneric boundary and grows quadratically in n.
    """
    rank = params.pop("rank", None)
    rank_fraction = params.pop("rank_fraction", 0.88)
    if params:
        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
    if rank is None:
        if isinstance(rank_fraction, bool) or not isinstance(rank_fraction, (int, float)):
            raise ValueError("rank_fraction must be a real number")
        if not 0.1 <= float(rank_fraction) < 1.0:
            raise ValueError("rank_fraction must lie in [0.1, 1.0)")
        rank = _rank_for_fraction(n, float(rank_fraction))
    _validate_params(n, rank)
    if isinstance(seed, bool) or not isinstance(seed, int):
        raise ValueError("seed must be an integer")

    rng = random.Random(seed)
    width = 3 * n - 2
    codes: set[int] = set()
    while len(codes) < rank:
        codes.add(rng.getrandbits(width))
    answer = sorted(codes)
    tensor = _build_tensor(n, (_decode_term(code, n) for code in answer))
    return {
        "family": "bounded_sign_cp_decomposition",
        "order": 3,
        "dimension": n,
        "term_count": rank,
        "field": "ordinary_integers",
        "tensor": tensor,
        "answer": answer,
    }


