+        "edges": len(supports),
+        "rounds": rounds,
+        "variable_colors": sorted(variable_hist.items()),
+        "edge_colors": sorted(edge_hist.items()),
+        "incidence_colors": sorted(incidence_hist.items()),
+    }
+
