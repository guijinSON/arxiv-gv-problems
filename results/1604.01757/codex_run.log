+def _incidence_signature(
+    equations: list[tuple[tuple[int, ...], int]], n: int
+) -> dict:
+    """A label-invariant color-refinement signature of the support hypergraph."""
+    supports = sorted(tuple(sorted(support)) for support, _ in equations)
