+    rhs_by_support = {frozenset(support): rhs for support, rhs in equations}
+    rhs = [
+        rhs_by_support[
+            frozenset((order[i], order[(i + 1) % n], order[(i + 2) % n]))
+        ]
+        for i in range(n)
+    ]
+
