  variable 0: value 0 -> generator 2; value 1 -> generator 0
  variable 1: value 0 -> generator 1; value 1 -> generator 3
  variable 2: value 0 -> generator 9; value 1 -> generator 5
  variable 3: value 0 -> generator 6; value 1 -> generator 8
  variable 4: value 0 -> generator 4; value 1 -> generator 7

