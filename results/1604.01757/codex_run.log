+def _compact_cycle_solve(inst: dict) -> tuple[list[int], int]:
+    """Use the hidden-cycle recurrence, counting only exact bit XORs."""
+    n = inst["n"]
+    equations = _equations(inst)
+    ternary = [(support, rhs) for support, rhs in equations if len(support) == 3]
+    order = _cycle_from_equations(ternary, n)
