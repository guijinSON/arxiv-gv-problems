+        operations += 1
+        following = (position + 3) % n
+        offsets[following] = offsets[position] ^ difference
+        operations += 1
+        position = following
+
+    # rhs_0 = x_0 XOR x_1 XOR x_2, and each x_i=x_0 XOR offsets_i.
