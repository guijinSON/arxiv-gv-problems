+        "IDs, with position j choosing one of the two IDs displayed for "
+        "control coordinate j; IDs lie in [0,2n-1]."
+    ),
+    "bounds": {
+        "word_length": "n",
+        "choices_per_position": 2,
+        "generator_id_min": 0,
+        "generator_id_max": "2n-1",
+        "maximum_shipping_length": 100,
+        "candidate_count": "2^n",
+    },
+}
