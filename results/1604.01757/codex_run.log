+    transitions: dict[frozenset[int], set[int]] = {}
+    for support in supports:
+        a, b, c = tuple(support)
+        for u, v, w in ((a, b, c), (a, c, b), (b, c, a)):
+            transitions.setdefault(frozenset((u, v)), set()).add(w)
