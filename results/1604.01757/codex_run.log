+    position = 0
+    for _ in range(n - 1):
+        difference = rhs[position] ^ rhs[(position + 1) % n]
+        operations += 1
+        following = (position + 3) % n
+        offsets[following] = offsets[position] ^ difference
+        operations += 1
+        position = following
+
+    # rhs_0 = x_0 XOR x_1 XOR x_2, and each x_i=x_0 XOR offsets_i.
+    base = rhs[0] ^ offsets[1] ^ offsets[2]
