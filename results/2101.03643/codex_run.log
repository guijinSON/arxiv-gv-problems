+    return {
+        "family": "missing quadratic Noetherian operator",
+        "n": n,
+        "coeff_bound": coeff_bound,
+        "mix_bound": mix_bound,
+        "monomials": [[i, j] for i, j in monomials],
+        "quadrics": quadrics,
+        "answer": _matrix_from_upper(z, n),
+    }
