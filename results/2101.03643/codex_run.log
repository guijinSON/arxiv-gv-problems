+def escalate(params):
+    n = params.get("n")
+    bound = params.get("coeff_bound", 31)
+    mix = params.get("mix_bound", 3)
+    if isinstance(n, int) and n < 9:
+        return {"n": n + 1, "coeff_bound": 2 * bound + 1, "mix_bound": mix}
+    if n == 9:
+        return "cap_bound"
+    return None
