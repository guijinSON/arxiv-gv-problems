+    norms = [sum(abs(rows[i][j]) for i in range(r)) for j in range(r)]
+    norm_order = {value: rank + 1 for rank, value in enumerate(sorted(set(norms)))}
+    outlier = _candidate_from_prefix(inst, [norm_order[value] for value in norms])
