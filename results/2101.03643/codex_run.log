+# Filled after the three harness arms.  Until then this is an explicit record
+# of no external trials, not a claim that any oracle failed.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
