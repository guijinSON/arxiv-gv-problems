+
+def _pairs(n):
+    return [(i, j) for i in range(n) for j in range(i, n)]
+
+
+def _nonzero_int(rng, bound):
+    value = 0
+    while value == 0:
+        value = rng.randint(-bound, bound)
+    return value
+
+
+def _matrix_from_upper(values, n):
+    out = [[0] * n for _ in range(n)]
+    for value, (i, j) in zip(values, _pairs(n)):
+        out[i][j] = value
+        out[j][i] = value
+    return out
