/bin/bash -lc "python3 - <<'PY'
import time, statistics

def mul(t,n,a,b): return t[a*n+b]
def check(n,k):
 t=[0]*(n*n); comparisons=lookups=0
 for _ in range(k):
  for x in range(n):
   for y in range(n):
    xy=mul(t,n,x,y); lookups+=1
    for z in range(n):
     zx=mul(t,n,z,x); lhs=mul(t,n,xy,zx)
     xyz=mul(t,n,xy,z); rhs=mul(t,n,xyz,x)
     # two cached subtree lookups + four further multiplications for F1
     lookups+=4; comparisons+=1
     if lhs"'!=rhs:return False,lookups,comparisons
 return True,lookups,comparisons
# Straight evaluation without subtree caching is 6 table lookups/triple.
times=[]
for _ in range(9):
 t=time.perf_counter(); out=check(16,60); times.append(time.perf_counter()-t)
print({'"'result':out[0], 'cached_lookups':out[1], 'comparisons':out[2],
       'uncached_primitive_ops':60*16**3*7,
       'median_wall_sec':statistics.median(times), 'runs':times})
print({'order4_all_60_uncached_primitive_ops':60*4**3*7,
       'order4_candidate_tables':4**(4**2)})
