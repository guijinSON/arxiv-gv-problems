    n=inst['dimension']; N=1<<n
    valid=[]
    for mask in range(1,N):
      for phase in (0,1):
        ans=[g._mask_text(mask,n),phase]
        explicit=[x for x in range(N) if g._parity(mask & x)==phase]
        in1=set(explicit); e1=e2=0
        for rec in inst['generators']:
          gen=int(rec['mask'],16); mult=rec['multiplicity']
          for x in range(N):
            y=x"'^gen
            if x<y:
              if x in in1 and y in in1: e1+=mult
              if x not in in1 and y not in in1: e2+=mult
        exact=(len(in1)==inst['"'mu'] and e1<=inst['k1'] and e2<=inst['k2'])
        checked=g.verify(inst,ans)[0]
        assert exact==checked,(seed,ans,e1,e2)
        if checked: valid.append(ans)
    assert len(valid)==2,(seed,valid)
print('explicit demo graph cross-check: 20 seeds, every bounded certificate')
inst=g.make_instance(seed=3,**g.DIFFICULTY['easy'])
os.environ.pop('GV_HINT_MODE',None)
