   618	def _answer_elements(answer):
   619	    if isinstance(answer, dict):
   620	        return sum(_answer_elements(value) for value in answer.values())
   621	    if isinstance(answer, (list, tuple)):
   622	        return sum(_answer_elements(value) for value in answer)
   623	    return 1
