   247	            block = []
   248	            previous = None
   249	            for _ in range(n - 1):
   250	                while True:
   251	                    i = rng.randrange(n)
   252	                    j = rng.randrange(n - 1)
   253	                    if j >= i:
   254	                        j += 1
   255	                    if (i, j) != previous:
   256	                        break
   257	                block.append([i, j])
   258	                previous = (i, j)
   259	            update_blocks.append(block)
   260	        basis = _apply_column_updates(n, update_blocks)
   261	        witness = _update_witness(n, update_blocks)
   262	        if n < 16 or n // 3 <= witness.bit_count() <= (2 * n) // 3:
   263	            break
   264	    else:
   265	        raise AssertionError("could not sample a dense carried witness")
   266	    if witness == 0 or any(_parity(witness & column) != 1 for column in basis):
   267	        raise AssertionError("internal basis-change identity failed")
   268	
   269	    generator_records = []
   270	    for i, column in enumerate(basis):
   271	        generator_records.append({
   272	            "mask": _mask_text(column, n),
   273	            "multiplicity": 1001 + i,
   274	        })
   275	
   276	    used_preimages = {1 << i for i in range(n)}
   277	    for j in range(extras):
   278	        while True:
   279	            preimage = _random_odd_mask(rng, n)
   280	            if preimage not in used_preimages:
   281	                used_preimages.add(preimage)
   282	                break
   283	        generator_records.append({
   284	            "mask": _mask_text(_linear_image(preimage, basis), n),
   285	            "multiplicity": 1001 + n + j,
   286	        })
   287	
   288	    rng.shuffle(generator_records)
   289	    phase = rng.getrandbits(1)
   290	    answer = [_mask_text(witness, n), phase]
   291	    return {
   292	        "paper": "arXiv:1710.05491",
   293	        "family": "succinct connected bipartite Cayley multigraph",
   294	        "dimension": n,
   295	        "vertex_count": 1 << n,
   296	        "mu": 1 << (n - 1),
   297	        "k1": 0,
   298	        "k2": 0,
   299	        "generators": generator_records,
   300	        "update_blocks": update_blocks,
   301	        "layers": layers,
   302	        "extras": extras,
   303	        "answer": answer,
   304	    }
