   581	def _attack_forward_updates(inst):
   582	    n = inst["dimension"]
   583	    rhs = [1] * n
   584	    for block in inst["update_blocks"]:
   585	        for i, j in block:
   586	            rhs[i] ^= rhs[j]
   587	    value = sum(bit << i for i, bit in enumerate(rhs))
   588	    if value == 0:
   589	        value = 1
   590	    return [_mask_text(value, n), 0]
