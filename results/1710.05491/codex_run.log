def _hex_width(n):
    return (n + 3) // 4


def _mask_text(value, n):
    return format(value, f"0{_hex_width(n)}x")


def _apply_column_tours(n, tours):
    columns = [1 << i for i in range(n)]
    for tour in tours:
        for position in range(1, n):
            i, j = tour[position], tour[position - 1]
            columns[i] ^= columns[j]
    return columns


def _tour_witness(n, tours):
    rhs = [1] * n
    for tour in reversed(tours):
        for position in range(n - 1, 0, -1):
            i, j = tour[position], tour[position - 1]
            rhs[i] ^= rhs[j]
    value = 0
    for i, bit in enumerate(rhs):
        value |= bit << i
    return value


def _linear_image(mask, columns):
    result = 0
    bit = 0
    value = mask
    while value:
        if value & 1:
            result ^= columns[bit]
        value >>= 1
        bit += 1
    return result


def _random_odd_mask(rng, n):
    # Odd weights at least three avoid duplicating a basis generator.
    choices = [w for w in (3, 5, 7, 9) if w <= n]
    weight = rng.choice(choices)
    value = 0
    for index in rng.sample(range(n), weight):
        value |= 1 << index
    return value


