+
+def search_space(inst):
+    return 2 * ((1 << inst["dimension"]) - 1)
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > _ENUMERATION_CAP:
+        return None
+    hits = 0
+    n = inst["dimension"]
+    for mask in range(1, 1 << n):
+        text = _mask_text(mask, n)
+        for phase in (0, 1):
+            if verify(inst, [text, phase])[0]:
+                hits += 1
+    return hits
