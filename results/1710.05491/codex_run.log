   645	    good = demo["answer"]
   646	    width = _hex_width(demo["dimension"])
   647	    corruptions = {
   648	        "drop_one": [good[0]],
   649	        "swap_fields": [good[1], good[0]],
   650	        "duplicate_field": [good[0], good[0]],
   651	        "empty": [],
   652	        "out_of_range": ["f" * (width + 1), good[1]],
   653	    }
   654	    cases = {}
   655	    reasons = []
   656	    for name, bad in corruptions.items():
   657	        ok, reason = verify(demo, bad)
   658	        cases[name] = {"rejected": not ok, "reason": reason}
   659	        reasons.append(reason)
   660	    report["G2_rejects_corruption"] = {
   661	        "pass": all(case["rejected"] for case in cases.values())
   662	                and len(set(reasons)) == len(reasons),
   663	        "cases": cases,
   664	        "distinct_reasons": len(set(reasons)),
   665	    }
   666	
   667	    realistic = (
   668	        "I used the parity constraints.\n```text\n<answer>"
   669	        + good[0] + ", " + str(good[1])
   670	        + "</answer>\n```\nThis is my final witness."
   671	    )
   672	    parsed = parse_answer(realistic)
   673	    report["G3_round_trip"] = {
   674	        "pass": parsed == good and verify(demo, parsed)[0],
   675	        "parsed": parsed,
   676	    }
   677	
   678	    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
   679	    shipping = make_instance(seed=314159, **shipping_params)
   680	    rng = random.Random(271828)
   681	    hits = 0
   682	    t0 = time.perf_counter()
   683	    for _ in range(_G4_SAMPLES):
   684	        hits += int(verify(shipping, random_candidate(shipping, rng))[0])
   685	    g4_elapsed = time.perf_counter() - t0
   686	    probability = hits / _G4_SAMPLES
   687	    report["G4_guess_resistance"] = {
   688	        "pass": probability < 1e-6,
   689	        "hits": hits,
   690	        "total": _G4_SAMPLES,
   691	        "observed_probability": probability,
   692	        "structure_aware_space": search_space(shipping),
   693	        "sampling_rule": "uniform nonzero n-bit affine mask and uniform phase",
   694	        "wall_clock_sec": round(g4_elapsed, 6),
   695	    }
   696	
   697	    density_rng = random.Random(161803)
   698	    density_samples = 200_000
   699	    density_hits = 0
   700	    for _ in range(density_samples):
   701	        density_hits += int(verify(
   702	            shipping, random_candidate(shipping, density_rng))[0])
   703	
   704	    reference_times = []
   705	    reference_ops = []
   706	    reference_successes = 0
   707	    attack_results = {
   708	        "coordinate_frequency_outlier": {"successes": 0, "attempts": _ATTACK_SEEDS},
   709	        "greedy_column_majority": {"successes": 0, "attempts": _ATTACK_SEEDS},
   710	        "random_affine_restart_256": {"successes": 0, "attempts": _ATTACK_SEEDS},
   711	        "forward_update_ansatz": {"successes": 0, "attempts": _ATTACK_SEEDS},
   712	    }
   713	    attack_times = {name: 0.0 for name in attack_results}
   714	    for seed in range(_ATTACK_SEEDS):
   715	        inst = make_instance(seed=10_000 + seed, **shipping_params)
   716	        for name, function in (
   717	            ("coordinate_frequency_outlier", _attack_outlier),
   718	            ("greedy_column_majority", _attack_greedy),
   719	            ("forward_update_ansatz", _attack_forward_updates),
   720	        ):
   721	            start = time.perf_counter()
   722	            candidate = function(inst)
   723	            attack_times[name] += time.perf_counter() - start
   724	            attack_results[name]["successes"] += int(verify(inst, candidate)[0])
   725	        start = time.perf_counter()
   726	        restart_rng = random.Random(90_000 + seed)
