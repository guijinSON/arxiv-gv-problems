+
+    invariance_checks = 0
+    carried_checks = 0
+    invariance_failures = []
+    keys = []
+    for seed in range(20):
+        inst = make_instance(seed=20_000 + seed, **shipping_params)
+        key = canonical_key(inst)
+        keys.append(key)
+        transformed = _transformed_instance(inst, random.Random(30_000 + seed))
+        transformed_key = canonical_key(transformed)
+        invariance_checks += 1
