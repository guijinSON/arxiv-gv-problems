+            invariance_failures.append([seed, "composed coordinate relabelling"])
+        carried_checks += 1
+        if not verify(composed, composed["answer"])[0]:
+            invariance_failures.append([seed, "composed carried witness failed"])
+    report["G8_canonical_key"] = {
