+    new_mask = transform_mask(old_mask)
+    translation = rng.randrange(1 << n)
+    new_phase = inst["answer"][1] ^ _parity(new_mask & transform_mask(translation))
+    transformed["answer"] = [_mask_text(new_mask, n), new_phase]
+    return transformed
