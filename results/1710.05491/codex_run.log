   451	def _solve_equations(inst, instrument=False):
   452	    """Solve g.w=1 over GF(2) by ordinary row elimination."""
   453	    n = inst["dimension"]
   454	    rows = []
   455	    scalar_ops = 0
   456	    for record in inst["generators"]:
   457	        rows.append(int(record["mask"], 16) | (1 << n))
   458	    pivot_row = 0
   459	    pivot_columns = []
   460	    for column in range(n):
   461	        pivot = None
   462	        for r in range(pivot_row, len(rows)):
   463	            scalar_ops += 1
   464	            if (rows[r] >> column) & 1:
   465	                pivot = r
   466	                break
   467	        if pivot is None:
   468	            continue
   469	        rows[pivot_row], rows[pivot] = rows[pivot], rows[pivot_row]
   470	        for r in range(len(rows)):
   471	            if r != pivot_row:
   472	                scalar_ops += 1
   473	                if (rows[r] >> column) & 1:
   474	                    rows[r] ^= rows[pivot_row]
   475	                    scalar_ops += n + 1
   476	        pivot_columns.append(column)
   477	        pivot_row += 1
   478	        if pivot_row == len(rows):
   479	            break
   480	    for row in rows:
   481	        if (row & ((1 << n) - 1)) == 0 and ((row >> n) & 1):
   482	            return None, scalar_ops
   483	    if len(pivot_columns) < n:
   484	        return None, scalar_ops
   485	    solution = 0
   486	    for r, column in enumerate(pivot_columns[:n]):
   487	        solution |= ((rows[r] >> n) & 1) << column
   488	    return solution, scalar_ops
   489	
