+def escalate(params):
+    current = {k: v for k, v in params.items() if k != "_preset"}
+    extras = current.get("extras", 8)
+    if extras < 64:
+        current["extras"] = min(64, max(extras + 8, extras * 2))
+        return current
+    n = current.get("n", 64)
+    layers = current.get("layers", 3)
+    if layers * (n - 1) < 297 and n < 99:
+        current["n"] = min(99, n + 2)
+        return current
+    return None
