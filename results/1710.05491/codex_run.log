   361	def parse_answer(text):
   362	    if not isinstance(text, str):
   363	        return None
   364	    matches = _ANSWER_RE.findall(text)
   365	    if not matches:
   366	        return None
   367	    body = matches[-1].strip()
   368	    fenced = _FENCE_RE.fullmatch(body)
   369	    if fenced:
   370	        body = fenced.group(1).strip()
   371	    # Accept either the requested comma form or the JSON-native pair.
   372	    try:
   373	        if body.startswith("["):
   374	            value = json.loads(body)
   375	            if (isinstance(value, list) and len(value) == 2
   376	                    and isinstance(value[0], str) and _is_int(value[1])):
   377	                return [value[0].lower(), value[1]]
   378	            return None
   379	        parts = [part.strip() for part in body.split(",")]
   380	        if len(parts) != 2 or not _HEX_RE.fullmatch(parts[0].lower()):
   381	            return None
   382	        if parts[1] not in ("0", "1"):
   383	            return None
   384	        return [parts[0].lower(), int(parts[1])]
   385	    except (ValueError, TypeError, json.JSONDecodeError):
   386	        return None
