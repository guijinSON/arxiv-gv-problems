   437	def enumerate_all(inst):
   438	    space = search_space(inst)
   439	    if space > _ENUMERATION_CAP:
   440	        return None
   441	    hits = 0
   442	    n = inst["dimension"]
   443	    for mask in range(1, 1 << n):
   444	        text = _mask_text(mask, n)
   445	        for phase in (0, 1):
   446	            if verify(inst, [text, phase])[0]:
   447	                hits += 1
   448	    return hits
