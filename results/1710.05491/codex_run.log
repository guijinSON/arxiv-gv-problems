   556	def _attack_outlier(inst):
   557	    n = inst["dimension"]
   558	    counts = [0] * n
   559	    for record in inst["generators"]:
   560	        value = int(record["mask"], 16)
   561	        for i in range(n):
   562	            counts[i] += (value >> i) & 1
   563	    bit = min(range(n), key=lambda i: (counts[i], i))
   564	    return [_mask_text(1 << bit, n), 0]
   565	
