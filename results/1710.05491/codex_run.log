   593	def _transformed_instance(inst, rng):
   594	    """Apply a coordinate permutation and a Cayley-vertex translation."""
   595	    n = inst["dimension"]
   596	    permutation = list(range(n))
   597	    rng.shuffle(permutation)
   598	
   599	    def transform_mask(value):
   600	        result = 0
   601	        for old, new in enumerate(permutation):
   602	            result |= ((value >> old) & 1) << new
   603	        return result
   604	
   605	    transformed = copy.deepcopy(inst)
   606	    for record in transformed["generators"]:
   607	        record["mask"] = _mask_text(transform_mask(int(record["mask"], 16)), n)
   608	    rng.shuffle(transformed["generators"])
   609	    transformed["update_blocks"] = copy.deepcopy(inst["update_blocks"])
   610	    old_mask = int(inst["answer"][0], 16)
   611	    new_mask = transform_mask(old_mask)
   612	    translation = rng.randrange(1 << n)
   613	    new_phase = inst["answer"][1] ^ _parity(new_mask & transform_mask(translation))
   614	    transformed["answer"] = [_mask_text(new_mask, n), new_phase]
   615	    return transformed
   616	
