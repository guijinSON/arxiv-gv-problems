   491	def _coordinates_in_basis(vector, basis):
   492	    n = len(basis)
   493	    rows = []
   494	    for bit in range(n):
   495	        coefficients = 0
   496	        for column, value in enumerate(basis):
   497	            coefficients |= ((value >> bit) & 1) << column
   498	        rhs = (vector >> bit) & 1
   499	        rows.append(coefficients | (rhs << n))
   500	    pivot_row = 0
   501	    for column in range(n):
   502	        pivot = next((r for r in range(pivot_row, n)
   503	                      if (rows[r] >> column) & 1), None)
   504	        if pivot is None:
   505	            raise ValueError("distinguished generators do not form a basis")
   506	        rows[pivot_row], rows[pivot] = rows[pivot], rows[pivot_row]
   507	        for r in range(n):
   508	            if r != pivot_row and ((rows[r] >> column) & 1):
   509	                rows[r] ^= rows[pivot_row]
   510	        pivot_row += 1
   511	    result = 0
   512	    for r in range(n):
   513	        result |= ((rows[r] >> n) & 1) << r
   514	    return result
   515	
