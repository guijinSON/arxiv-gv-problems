+def _attack_outlier(inst):
+    n = inst["dimension"]
+    counts = [0] * n
+    for record in inst["generators"]:
+        value = int(record["mask"], 16)
+        for i in range(n):
+            counts[i] += (value >> i) & 1
+    bit = min(range(n), key=lambda i: (counts[i], i))
+    return [_mask_text(1 << bit, n), 0]
+
