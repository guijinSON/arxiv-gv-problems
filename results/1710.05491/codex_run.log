   735	        start = time.perf_counter()
   736	        solution, operations = _solve_equations(inst, instrument=True)
   737	        reference_times.append(time.perf_counter() - start)
   738	        reference_ops.append(operations)
   739	        candidate = [_mask_text(solution, inst["dimension"]), 0] if solution else None
   740	        reference_successes += int(candidate is not None and verify(inst, candidate)[0])
   741	    for name in attack_results:
   742	        attack_results[name]["wall_clock_sec_total_8"] = round(attack_times[name], 6)
   743	    all_failed = all(result["successes"] == 0 for result in attack_results.values())
   744	    reference = {
   745	        "name": "Gauss-Jordan elimination over GF(2)",
   746	        "complexity": "O(n^3) scalar bit operations",
   747	        "wall_clock_sec_mean": round(sum(reference_times) / len(reference_times), 6),
   748	        "wall_clock_sec_total_8": round(sum(reference_times), 6),
   749	        "operations_mean": round(sum(reference_ops) / len(reference_ops)),
   750	        "operations_min": min(reference_ops),
   751	        "operations_max": max(reference_ops),
   752	        "solves": f"{reference_successes}/{_ATTACK_SEEDS}, as expected",
   753	    }
   754	    report["G5_density_and_baseline_cost"] = {
   755	        "pass": density_hits / density_samples < 1e-6 and reference_successes == _ATTACK_SEEDS,
   756	        "shipping_density_hits": density_hits,
   757	        "shipping_density_samples": density_samples,
