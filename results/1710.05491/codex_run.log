+def _attack_forward_updates(inst):
+    n = inst["dimension"]
+    rhs = [1] * n
+    for block in inst["update_blocks"]:
+        for i, j in block:
+            rhs[i] ^= rhs[j]
+    value = sum(bit << i for i, bit in enumerate(rhs))
