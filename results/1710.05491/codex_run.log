+    placebo_rate = arms["placebo"]["solved"] / placebo_attempts if placebo_attempts else 0.0
+    hinted_hardened = (
+        G9_ORACLE_RESULTS["hinted_verdict"] == "hardened"
+        and hinted_attempts >= 3
+        and arms["hinted"]["solved"] == 0
+    )
