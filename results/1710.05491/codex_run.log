   542	def escalate(params):
   543	    current = {k: v for k, v in params.items() if k != "_preset"}
   544	    extras = current.get("extras", 8)
   545	    if extras < 64:
   546	        current["extras"] = min(64, max(extras + 8, extras * 2))
   547	        return current
   548	    n = current.get("n", 64)
   549	    layers = current.get("layers", 3)
   550	    if layers * (n - 1) < 297 and n < 99:
   551	        current["n"] = min(99, n + 2)
   552	        return current
   553	    return None
