   626	def selftest():
   627	    report = {}
   628	
   629	    failures = []
   630	    attempts = 0
   631	    for preset, params in DIFFICULTY.items():
   632	        for seed in (0, 1, 17):
   633	            attempts += 1
   634	            inst = make_instance(seed=seed, **params)
   635	            ok, reason = verify(inst, inst["answer"])
   636	            if not ok:
   637	                failures.append([preset, seed, reason])
   638	            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
   639	                failures.append([preset, seed, "answer is not JSON-native"])
