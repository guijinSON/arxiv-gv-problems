+        "distinct_reasons": len(set(reasons)),
+    }
+
+    realistic = (
+        "I used the parity constraints.\n```text\n<answer>"
+        + good[0] + ", " + str(good[1])
+        + "</answer>\n```\nThis is my final witness."
