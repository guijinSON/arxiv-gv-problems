+def _attack_forward_tours(inst):
+    n = inst["dimension"]
+    rhs = [1] * n
+    for tour in inst["coordinate_tours"]:
+        for position in range(1, n):
+            rhs[tour[position]] ^= rhs[tour[position - 1]]
+    value = sum(bit << i for i, bit in enumerate(rhs))
+    if value == 0:
+        value = 1
+    return [_mask_text(value, n), 0]
+
