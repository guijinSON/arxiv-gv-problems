   517	def canonical_key(inst):
   518	    """Canonicalize generator order and every invertible coordinate relabeling."""
   519	    n = inst["dimension"]
   520	    records = sorted(inst["generators"], key=lambda rec: rec["multiplicity"])
   521	    basis_records = records[:n]
   522	    expected = list(range(1001, 1001 + n))
   523	    if [rec["multiplicity"] for rec in basis_records] != expected:
   524	        raise ValueError("missing distinguished multiplicity basis")
   525	    basis = [int(rec["mask"], 16) for rec in basis_records]
   526	    relations = []
   527	    for record in records[n:]:
   528	        coordinate = _coordinates_in_basis(int(record["mask"], 16), basis)
   529	        relations.append([record["multiplicity"], _mask_text(coordinate, n)])
   530	    payload = {
   531	        "dimension": n,
   532	        "multiplicities": [record["multiplicity"] for record in records],
   533	        "extra_relations": relations,
   534	        "mu": inst["mu"],
   535	        "k1": inst["k1"],
   536	        "k2": inst["k2"],
   537	    }
   538	    return hashlib.sha256(json.dumps(payload, sort_keys=True,
   539	                                     separators=(",", ":")).encode()).hexdigest()
