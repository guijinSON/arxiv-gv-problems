   567	def _attack_greedy(inst):
   568	    n = inst["dimension"]
   569	    records = [int(record["mask"], 16) for record in inst["generators"]]
   570	    candidate = 0
   571	    # Independently choose bits whose generator-column frequency is odd.  This
   572	    # is a plausible majority/correlation shortcut but ignores interactions.
   573	    for bit in range(n):
   574	        if sum((row >> bit) & 1 for row in records) * 2 >= len(records):
   575	            candidate |= 1 << bit
   576	    if candidate == 0:
   577	        candidate = 1
   578	    return [_mask_text(candidate, n), 0]
