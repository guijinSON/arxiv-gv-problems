+        "attack_restarts_total_8": 8 * 256,
+        "reference_algorithm_operations_mean": reference["operations_mean"],
+        "reference_algorithm_wall_clock_sec_mean": reference["wall_clock_sec_mean"],
+    }
+    report["G6_adversary_panel"] = {
