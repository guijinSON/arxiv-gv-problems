   389	def verify(inst, answer):
   390	    if answer == []:
   391	        return False, "answer is empty"
   392	    if not isinstance(answer, (list, tuple)) or len(answer) != 2:
   393	        return False, "wrong answer shape: expected [mask_hex, phase]"
   394	    mask_text, phase = answer
   395	    if not isinstance(mask_text, str):
   396	        return False, "mask must be a hexadecimal string"
   397	    if not _is_int(phase) or phase not in (0, 1):
   398	        return False, "phase must be the integer 0 or 1"
   399	    n = inst["dimension"]
   400	    if len(mask_text) != _hex_width(n) or not _HEX_RE.fullmatch(mask_text):
   401	        return False, f"mask must have exactly {_hex_width(n)} lowercase hex digits"
   402	    mask = int(mask_text, 16)
   403	    if not 1 <= mask < (1 << n):
   404	        return False, "mask is zero or outside the n-bit range"
   405	
   406	    # Every nonconstant affine parity rule on GF(2)^n is exactly balanced.
   407	    if (1 << (n - 1)) != inst["mu"]:
   408	        return False, "the affine rule does not meet the requested side size"
   409	    bad_v1 = 0
   410	    bad_v2 = 0
   411	    for record in inst["generators"]:
   412	        generator = int(record["mask"], 16)
   413	        if _parity(mask & generator) == 0:
   414	            # Translation by this generator preserves both sides.  It induces
   415	            # 2^(n-2) unordered internal pairs in each side.
   416	            internal = (1 << (n - 2)) * record["multiplicity"]
   417	            bad_v1 += internal
   418	            bad_v2 += internal
   419	            if bad_v1 > inst["k1"] or bad_v2 > inst["k2"]:
   420	                return False, "a Cayley generator creates forbidden internal edges"
   421	    if bad_v1 > inst["k1"]:
   422	        return False, "too many edges induced by V1"
   423	    if bad_v2 > inst["k2"]:
   424	        return False, "too many edges induced by V2"
   425	    return True, "ok"
   426	
