+        for index in active:
+            predicted, operations = _predict_from_key(
+                inst["tags"][vertex], inst["key_candidates"][index], frequency
+            )
+            membership_tests += 1
+            selection_xors += operations
+            if predicted in inst["lists"][vertex]:
+                survivors.append(index)
+        active = survivors
