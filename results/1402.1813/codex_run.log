+def _predict_from_key(tag, key, frequency):
+    """Return one key prediction and its exact XOR count."""
+    value = key["zero"] if frequency % 2 == 0 else 0
+    first = frequency % 2 == 1
+    operations = 0
+    for base_vertex, weight in tag:
+        if not (weight & 1):
+            continue
+        if first:
