import ast,json
import gen_1402_1813 as g
checks=[]
for name,p in g.DIFFICULTY.items():
 for seed in (0,1,17):
  i=g.make_instance(seed=seed,**p)
  checks.append((name,seed,*g.verify(i,i['answer'])))
print('G1',sum(x[2] for x in checks),'/',len(checks))
for p in ('selftest_report.json','.meta.json'):
 json.load(open(p)); print(p,'valid JSON')
rows=[json.loads(x) for x in open('llm_loop_transcript.jsonl') if x.strip()]
print('transcript',len(rows),'rows',len({x['model'] for x in rows}),'models')
print('meta verdict',json.load(open('.meta.json'))['harden_verdict']['verdict'])
print('hard solved',sum(x['solved']=='solved' for x in rows if x['preset']=='hard'),'/3')
# AST check: verify contains no subscript access with key \"answer\".
tree=ast.parse(open('gen_1402_1813.py').read())
fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='verify')
reads=[]
for n in ast.walk(fn):
 if isinstance(n,ast.Subscript) and isinstance(n.slice,ast.Constant) and n.slice.value=='answer':
  reads.append(n.lineno)
print('verify instance-answer reads',reads)
print('next instance atoms',g.make_instance(n=6,seed=0)['vertex_count'])
