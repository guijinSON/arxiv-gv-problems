codex
The bare ladder returned `cap_bound`: frequency 5 was eventually solved by the last vendor, while frequency 6 exceeds the 256-element answer cap. I’m not stopping at the one-axis diagnosis, because the instructions require trying fixed-length hardening first. The most promising remaining axis is to keep 246 vertices but enlarge the color palette so the five-element interior lists are no longer the full palette; the planted parity certificate stays 246 entries and 114 XORs. I’m measuring that variant locally before deciding whether the paper must be parked.
exec
/bin/bash -lc "python3 - <<'PY'
import random, statistics
import gen_1402_1813 as g

def trial(q,seed):
 i=g.make_instance(n=5,seed=seed)
 rng=random.Random(seed*1009+q)
 # random four distinct planted labels, preserving existing answer equality pattern
 labels=rng.sample(range(q),4)
 amap=dict(enumerate(labels))
 ans=[amap[c] for c in i['answer']]
 outer=set(i['outer_cycle']); special=set(i['special_vertices'])
 lists=[]
 for v,a in enumerate(ans):
  size=2 if v in special else 3 if v in outer else 5
  d=[c for c in range(q) if c"'!=a]; rng.shuffle(d)
  lists.append(sorted([a]+d[:size-1]))
 ii={**i,'"'lists':lists,'answer':ans}
 cand,st=g._reference_dpll(ii)
 def greedy(order, rr=None):
  return g._greedy_candidate(lists,i['edges'],order,rr)
 adj=g._adjacency(len(lists),i['edges'])
 outs=[]
 outs.append(bool(greedy(range(len(lists)))))
 outs.append(bool(greedy(sorted(range(len(lists)),key=lambda v:(-len(adj[v]),v)))))
 wins=0
 rr=random.Random(seed+44)
 for _ in range(16):
  o=list(range(len(lists)));rr.shuffle(o)
  c=greedy(o,rr)
  wins += int(c is not None and g._valid_coloring_data(lists,i['edges'],c))
 return st,outs,wins

for q in (6,7,8,10,12):
 stats=[]; greedy=[]; rest=[]
 for s in range(20):
  st,gr,w=trial(q,1000+s)
  stats.append(st);greedy.append(gr);rest.append(w)
 print('q',q,'tests med/max',statistics.median(x['list_tests'] for x in stats),max(x['list_tests'] for x in stats),'back med/max',statistics.median(x['backtracks'] for x in stats),max(x['backtracks'] for x in stats),'greedy',sum(a for x in greedy for a in x),'/40','restart solved inst',sum(w>0 for w in rest),'/20','restart wins',sum(rest))
