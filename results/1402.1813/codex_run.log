 perm=rng.choice(g._AFFINE_PERMUTATIONS); order=list(range(len(points)));rng.shuffle(order);p2v={p:order[k] for k,p in enumerate(points)}
 ans=[None]*len(points)
 for p in points:ans[p2v[p]]=perm[g._raw_color(p)]
 edges=sorted(tuple(sorted((p2v[a],p2v[b]))) for a,b in bedges);outer=[p2v[p] for p in bouter];sp={outer[0],outer[n+1]};adj=g._adjacency(len(ans),edges)
 lists=[]
 for v,a in enumerate(ans):
  size=2 if v in sp else 3 if v in set(outer) else 5
  neigh=list({ans[w] for w in adj[v]}-{a});rng.shuffle(neigh)
  rest=list(set(g._PALETTE)-{a}-set(neigh));rng.shuffle(rest)
  if mode=='neighbor': dec=neigh+rest
  elif mode=='weighted':
   mult=[ans[w] for w in adj[v] if ans[w]"'!=a];rng.shuffle(mult);dec=[]
   for c in mult+rest:
    if c not in dec:dec.append(c)
  elif mode=='"'global4':
   # prefer three low? no
   dec=neigh+rest
  lists.append(sorted([a]+dec[:size-1]))
 return lists,edges
for mode in ['neighbor','weighted']:
