  f,_=g._attack_random_greedy(lists,edges,seed*37,16);rst+=int(f is not None)
  o=g._attack_outlier(lists,edges);out+=int(o is not None)
  ii={'lists':lists,'edges':edges}
  _,st=g._reference_dpll(ii);ss.append(st)
