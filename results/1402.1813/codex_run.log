codex
I found and fixed one audit issue in the retained module: the old diversity key depended on the arbitrary icosahedral base numbering. The new key uses affine-color-normalized multisets of vertex and edge signatures, making it invariant under all vertex relabelings (including base-frame automorphisms) while remaining an explicitly documented fingerprint rather than claiming full graph canonization. I’m rerunning G8 after that change.
exec
/bin/bash -lc "python3 - <<'PY'
import random,time
import gen_1402_1813 as g
params=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
checks=carried=0; keys=set(); t=time.perf_counter()
for seed in range(20):
    original=g.make_instance(seed=20000+seed,**params)
    k=g.canonical_key(original); keys.add(k)
    rr=random.Random(90000+seed)
    p=list(range(original['vertex_count'])); rr.shuffle(p)
    cmap=dict(enumerate(rr.choice(g._AFFINE_PERMUTATIONS)))
    for reverse,rotate,cm in ((False,0,None),(True,seed+1,None),(False,seed*2+1,cmap),(True,seed*3+2,cmap)):
        x=g._relabel_instance(original,p,reverse_outer=reverse,rotate=rotate,color_map=cm)
        checks += g.canonical_key(x)==k
        carried += g.verify(x,x['answer'])[0]
print({'invariant':checks,'carried':carried,'distinct':len(keys),'seconds':time.perf_counter()-t})
