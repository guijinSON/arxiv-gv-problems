+    "medium": {"n": 8, "layers": 10, "modulus": 5003, "screen_restarts": 2048},
+    "hard": {"n": 12, "layers": 10, "modulus": 10007, "screen_restarts": 4096},
+}
+SHIPPING_DIFFICULTY = "hard"
