+def _attack_same_row(inst: dict) -> dict | None:
+    for index in range(inst["n"]):
+        candidate = _candidate_from_indices(inst, [index] * inst["layers"])
+        if verify(inst, candidate)[0]:
+            return candidate
+    return None
