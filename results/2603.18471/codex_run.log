+        compact_total_operations += operations
+        if candidate is not None and verify(inst, candidate)[0]:
+            compact_successes += 1
+    attack_report = {
+        name: {"successes": attack_successes[name], "attempts": len(panel_seeds)}
+        for name in attack_names
+    }
+    report["G6_adversary_panel"] = {
