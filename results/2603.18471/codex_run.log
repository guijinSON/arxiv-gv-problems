+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 6, "degree": 2, "screen_restarts": 0},
+    "easy": {"n": 22, "degree": 4, "screen_restarts": 64},
+    "medium": {"n": 42, "degree": 7, "screen_restarts": 128},
+    "hard": {"n": 60, "degree": 10, "screen_restarts": 256},
+}
+SHIPPING_DIFFICULTY = "hard"
