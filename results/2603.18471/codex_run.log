+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "An exact symbolic affine-map word: one record {layer, anchor, slope} "
+        "chosen from each displayed layer, with every integer in 0..p-1, whose "
+        "maps compose to the identity."
+    ),
