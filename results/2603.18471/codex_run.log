+        "intended_route_operations": intended_operations,
+        "operation_model": (
+            "two arithmetic operations per anchor normalization and two per "
+            "slope-product update"
+        ),
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
