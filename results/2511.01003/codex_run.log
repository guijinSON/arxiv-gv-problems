+    # autocorrelation of a deterministic encoding of the multiplicity classes.
+    # A linear relabelling preserves u XOR v and merely permutes all indices.
+    if width <= 20:
+        size = 1 << width
+        encoded = [0] * size
+        for difference, count in pair_counts.items():
+            encoded[difference] = 13 * count * count + 7 * count + 1
+        encoded[0] = len(points) * len(points) + 97
+        step = 1
+        while step < size:
+            jump = step * 2
+            for start in range(0, size, jump):
+                for j in range(start, start + step):
+                    left = encoded[j]
+                    right = encoded[j + step]
+                    encoded[j] = left + right
+                    encoded[j + step] = left - right
+            step = jump
+        encoded = [value * value for value in encoded]
+        step = 1
+        while step < size:
+            jump = step * 2
+            for start in range(0, size, jump):
