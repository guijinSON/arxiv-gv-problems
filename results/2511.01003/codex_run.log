+
+
+def _ordered_affine_basis(points: list[int], width: int,
+                          order: list[int]) -> list[int] | None:
+    if not order:
+        return None
+    anchor = order[0]
+    chosen = [anchor]
+    differences: list[int] = []
+    rank = 0
+    for point in order[1:]:
+        difference = point ^ anchor
+        new_rank = _rank(differences + [difference], width)
+        if new_rank > rank:
