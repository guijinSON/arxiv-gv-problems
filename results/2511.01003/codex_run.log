+import random
+
+def deg(x): return x.bit_length()-1
+def mod(a,p):
+    d=deg(p)
+    while deg(a)>=d: a ^= p << (deg(a)-d)
+    return a
+def mul(a,b,p,d):
+    z=0
+    while b:
+        if b&1:z^=a
+        b>>=1;a<<=1
+        if a>>d:a^=p
+    return z
+def sq(a,p,d): return mul(a,a,p,d)
+def gcd(a,b):
+    while b:a,b=b,mod(a,b)
+    return a
+def irreducible(p,d):
+    x=2;y=x
+    for _ in range(1,d//2+1):
+        y=sq(y,p,d)
+        if gcd(y^x,p)!=1:return False
+    y=x
+    for _ in range(d):y=sq(y,p,d)
+    return y==x
+def findpoly(d):
+    for low in range(1,1<<d,2):
+        p=(1<<d)|low
+        if irreducible(p,d):return p
+def pow2(x,k,p,d):
+    for _ in range(k):x=sq(x,p,d)
+    return x
+def inv(a,p,d):
+    z=1;b=a;e=(1<<d)-2
+    while e:
+        if e&1:z=mul(z,b,p,d)
+        b=sq(b,p,d);e>>=1
+    return z
+def norm(a,m,p,d): return mul(a,pow2(a,m,p,d),p,d)
+def basis(a,x,m,p,d):
+    aq=pow2(a,m,p,d); xq=pow2(x,m,p,d)
+    a2=sq(a,p,d);x2=sq(x,p,d)
+    a2q=sq(aq,p,d);x2q=sq(xq,p,d)
+    return [mul(a,x2,p,d)^mul(a2,x,p,d),
+            mul(a,xq,p,d)^mul(aq,x,p,d),
+            mul(a,x2q,p,d)^mul(a2q,x,p,d),
+            mul(a2,xq,p,d)^mul(aq,x2,p,d),
+            mul(a2,x2q,p,d)^mul(a2q,x2,p,d)], mul(aq,x2q,p,d)^mul(a2q,xq,p,d)
+def B(a,x,m,p,d,co):
+    bs,c=basis(a,x,m,p,d);z=c
+    for u,v in zip(co,bs):z^=mul(u,v,p,d)
+    return z
+def nullity(a,m,p,d,co):
+    cols=[B(a,1<<j,m,p,d,co) for j in range(d)]
+    rows=[]
+    for bit in range(d):rows.append(sum(((cols[j]>>bit)&1)<<j for j in range(d)))
+    rank=0
+    for col in range(d):
+        piv=next((i for i in range(rank,d) if rows[i]>>col&1),None)
+        if piv is not None:
+            rows[rank],rows[piv]=rows[piv],rows[rank]
+            for i in range(d):
+                if i!=rank and rows[i]>>col&1:rows[i]^=rows[rank]
+            rank+=1
+    return d-rank
+def plant_one(m,rng,j):
+    d=2*m;p=findpoly(d);M=(1<<d)-1
+    A=rng.randrange(1,M+1)
+    while norm(A,m,p,d)==1:A=rng.randrange(1,M+1)
+    a=rng.randrange(1,M+1);x=rng.randrange(1,M+1)
+    while x==a:x=rng.randrange(1,M+1)
+    bs,c=basis(a,x,m,p,d)
+    co=[A,0,0,0,0]
+    rhs=c^mul(A,bs[0],p,d)
+    if not bs[j]:return plant_one(m,rng,j)
+    co[j]=mul(rhs,inv(bs[j],p,d),p,d)
+    return p,co,(a,x)
+
+for j in range(1,5):
+  print('coefficient',j)
+  for m in [4,6,8]:
+    rng=random.Random(100+j); vals=[]
+    for instn in range(4):
+      p,co,w=plant_one(m,rng,j);d=2*m;M=(1<<d)-1
+      hits=0
+      for _ in range(80):
+        a=rng.randrange(1,M+1);hits += nullity(a,m,p,d,co)>1
+      vals.append(hits/80)
+    print(m, round(sum(vals)/len(vals),4), round(min(vals),4), round(max(vals),4))

