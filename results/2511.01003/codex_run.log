+        "doubled_n": 4, "doubled_points": len(doubled["source"]),
+        "base_answer_bits": base["ambient_width"] ** 2 + base["ambient_width"],
+        "doubled_answer_bits": doubled["ambient_width"] ** 2 + doubled["ambient_width"],
+    }
