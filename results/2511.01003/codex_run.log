+    return hashlib.sha256(encoded).hexdigest()
+
+
+def escalate(params: dict) -> dict | None:
+    """Increase field dimension; each step quadruples the displayed set size."""
+    n = params.get("n")
+    if not isinstance(n, int) or n >= 7:
+        return None
+    return {"n": n + 1}
