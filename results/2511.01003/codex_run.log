+        raise AssertionError(f"G2 reasons not distinct: {corruptions}")
+    report["G2_rejects_corruption"] = {
+        "pass": True, "reasons": corruptions,
+    }
+
+    # G3: realistic prose and a markdown fence inside the required tags.
