+    return [mul(a,x2,p,d)^mul(a2,x,p,d),
+            mul(a,xq,p,d)^mul(aq,x,p,d),
+            mul(a,x2q,p,d)^mul(a2q,x,p,d),
+            mul(a2,xq,p,d)^mul(aq,x2,p,d),
+            mul(a2,x2q,p,d)^mul(a2q,x2,p,d)], mul(aq,x2q,p,d)^mul(a2q,xq,p,d)
