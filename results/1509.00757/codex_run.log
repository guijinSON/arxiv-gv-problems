+    answer_chars = max(measured_answer_chars)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _answer_atoms(inst["answer"])
+    intended_operations = 2 * inst["n"] - 1
+    arms = {
+        key: {"solved": value["solved"], "attempts": value["attempts"]}
