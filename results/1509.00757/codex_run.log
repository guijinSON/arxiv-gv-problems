+    # G: sample the certificate's global phase first.
+    planted_phase = rng.randrange(2)
+
+    next_vertex = 1
+
+    def new_vertex():
+        nonlocal next_vertex
+        value = next_vertex
+        next_vertex += 1
+        return value
