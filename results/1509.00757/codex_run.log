+    "easy": {"n": 32, "decoys": 16, "tail_length": 3},
+    "medium": {"n": 40, "decoys": 40, "tail_length": 3},
+    "hard": {"n": 48, "decoys": 96, "tail_length": 3},
+}
+SHIPPING_DIFFICULTY = "easy"
+
