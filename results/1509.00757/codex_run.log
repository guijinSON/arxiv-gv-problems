+        faces = {literal[0] for literal in literals}
+        if len(faces) == 1:
+            colors[next(iter(faces))] += 1
+        elif len(faces) == 2:
+            i, j = sorted(faces)
+            tree_edges.add((i, j))
+            clauses.append((literals[0], literals[1]))
