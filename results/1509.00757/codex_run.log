+    tree_edges = set()
+    clauses = []
+    option_index = {}
+    for face_index, face in enumerate(inst["faces"]):
+        for bit, option in enumerate(_radial_options(inst, face)):
+            endpoint = option[1] if option[0] == inst["root"] else option[0]
+            option_index[endpoint] = (face_index, bit)
