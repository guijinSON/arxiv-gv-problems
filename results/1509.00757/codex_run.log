+        "pass": doubled_ok and search_space(doubled) > search_space(inst) and isinstance(escalated, dict) and escalated["decoys"] > shipping_params["decoys"],
+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "shipping_space_bits": inst["n"],
