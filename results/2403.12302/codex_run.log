from collections import deque
import gen_2403_12302 as g

def compact(inst):
 pts=[tuple(p) for p in inst['coordinates']]
 directed=set()
 for u,v in inst['edges']:
  d=(pts[v][0]-pts[u][0],pts[v][1]-pts[u][1])
  directed|={d,(-d[0],-d[1])}
 choice=None
 for p in directed:
  for q in directed:
   if p==q or p==(-q[0],-q[1]): continue
   r=(p[0]-q[0],p[1]-q[1])
   if r in directed:
    choice=(p,q,r); break
  if choice: break
 assert choice and len(directed)==6
 p,q,r=choice
 inc={p:1,(-p[0],-p[1]):-1,q:3,(-q[0],-q[1]):-3,r:-2,(-r[0],-r[1]):2}
 adj=[[] for _ in pts]
 for u,v in inst['edges']:
  d=(pts[v][0]-pts[u][0],pts[v][1]-pts[u][1])
  adj[u].append((v,d)); adj[v].append((u,(-d[0],-d[1])))
 val=[None]*len(pts); val[0]=0; todo=deque([0])
 while todo:
  u=todo.popleft()
  for v,d in adj[u]:
   z=(val[u]+inc[d])%7
   if val[v] is None: val[v]=z; todo.append(v)
   else: assert val[v]==z
 return [x+1 for x in val]

for preset,p in g.DIFFICULTY.items():
 for seed in range(100):
  i=g.make_instance(seed=seed,**p)
  a=compact(i)
  assert g.verify(i,a)==(True,'ok'),(preset,seed)
print('compact public-data route verified: 400/400')
