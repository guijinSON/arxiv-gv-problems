/bin/bash -lc "python3 - <<'PY'
import gen_2403_12302 as g
D=[]
for x in range(-2,3):
 for y in range(-2,3):
  if (x,y)"'!=(0,0) and g._hex_norm((x,y))<=2:
   D.append(((x,y),(x+3*y)%7))
print(len(D),sorted(D))
assert len(D)==18 and all(r for _,r in D)
# Validate edge vectors, degree bound and exact crossing-free affine embedding on 80 builds.
def orient(a,b,c):
 return (b[0]-a[0])*(c[1]-a[1])-(b[1]-a[1])*(c[0]-a[0])
def proper_cross(a,b,c,d):
 return orient(a,b,c)*orient(a,b,d)<0 and orient(c,d,a)*orient(c,d,b)<0
for seed in range(80):
 i=g.make_instance(seed=seed,**g.DIFFICULTY['"'hard'])
 assert max(sum(v in e for e in i['edges']) for v in range(i['vertex_count']))==6
 es=i['edges']; p=i['coordinates']
 for j,(u,v) in enumerate(es):
  for x,y in es[j+1:]:
   if len({u,v,x,y})<4: continue
   assert not proper_cross(p[u],p[v],p[x],p[y]), (seed,(u,v),(x,y))
print('80 hard embeddings: degree 6, no proper edge crossings')
