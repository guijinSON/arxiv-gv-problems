+        "maximum_degree": 6,
+        "palette_size": _PALETTE,
+        "coordinates": coordinates,
+        "edges": edges,
+        "_distance_two_pairs": pairs,
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    """Return the complete statement shown to a solver."""
