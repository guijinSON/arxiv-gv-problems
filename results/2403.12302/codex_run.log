+        for seed in (0, 1, 2):
+            inst = make_instance(seed=seed, **params)
+            planted += int(verify(inst, inst["answer"])[0])
+            total += 1
+    report["G1_planted_verifies"] = {
+        "pass": planted == total,
+        "verified": planted,
+        "attempts": total,
