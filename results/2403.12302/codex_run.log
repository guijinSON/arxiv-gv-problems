        "carried_witnesses_valid": valid_carried,
        "unrelated_distinct_keys": len(unrelated_keys),
        "attempts_each": 20,
    }

    answer_lengths = []
    answer_chars = 0
    answer_atoms = 0
    for seed in range(40):
        ans = make_instance(seed=3000 + seed,
