+
+def _hex(value, bits):
+    return f"{value:0{(bits + 3) // 4}x}"
+
+
+def render(inst) -> str:
+    tag_lines = []
+    for start in range(0, inst["n"], 2):
+        tag_lines.append("  " + "  ".join(
+            f"{i + 1}:{_hex(inst['tags'][i], inst['tag_bits'])}"
