import random

def graph(n,d,seed):
 r=random.Random(seed); h=n//2; L=list(range(h));R=list(range(h,n));ed=set()
 # random perfect matchings via shuffled R until no duplicates entire matching
 for _ in range(d):
  for z in range(10000):
   rr=R[:];r.shuffle(rr); cand={(i,rr[i]) for i in range(h)}
   if not (cand&ed):ed|=cand;break
  else:raise Exception
 p=list(range(n));r.shuffle(p);return [(p[u],p[v]) for u,v in ed],set(p[:h])

def valid(X,E):return all((u in X)"'!=(v in X) for u,v in E)
def greedy(n,E):
 adj=[[] for _ in range(n)]
 for u,v in E:adj[u].append(v);adj[v].append(u)
 bits=[0]*n
 for v in range(1,n):
  # opposite majority assigned lower ids
  z=sum(bits[u] for u in adj[v] if u<v); c=sum(u<v for u in adj[v])
  bits[v]=int(2*z<c) # choose 1 if more assigned 0
 X={i for i,x in enumerate(bits) if x}
 return valid(X,E),len(X)
def loc(n,E,seed,restarts=64,steps=1000):
 r=random.Random(seed); adj=[[] for _ in range(n)]
