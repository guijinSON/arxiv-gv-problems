+def escalate(params):
+    p = dict(params)
+    if int(p.get("tag_bits", 128)) < 512:
+        p["tag_bits"] = int(p.get("tag_bits", 128)) + 64
+        return p
+    if int(p["n"]) < 148:
+        p["n"] = int(p["n"]) + 4
+        p["base_equations"] = int(p.get("base_equations", p["n"] + 4)) + 4
+        return p
