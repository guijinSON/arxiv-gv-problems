+DIFFICULTY: dict = {
+    "demo": {"n": 8, "base_equations": 10, "tag_bits": 24},
+    "easy": {"n": 40, "base_equations": 48, "tag_bits": 128},
+    "medium": {"n": 44, "base_equations": 52, "tag_bits": 192},
+    "hard": {"n": 48, "base_equations": 56, "tag_bits": 256},
