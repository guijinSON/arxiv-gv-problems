+        raise ValueError("tag_bits must be at least 8")
+    limit = (1 << bits) - 1
+    while True:
+        audit_mask = rng.getrandbits(bits) & limit
+        if audit_mask and audit_mask.bit_count() >= bits // 3:
+            break
+    tags, used = [], set()
+    for bit in assignment:
+        for _ in range(10000):
+            tag = rng.getrandbits(bits) & limit
