    dropped = answer[:-1]
    swapped = list(reversed(answer))
    duplicated = list(answer)
    if len(duplicated) >= 2:
        duplicated[1] = duplicated[0]
    outside = list(answer)
    outside[-1] = key_bits + 1
    return {
        "drop_one": dropped,
        "swap_order": swapped,
        "duplicate": duplicated,
        "empty": [],
        "out_of_range": outside,
    }


