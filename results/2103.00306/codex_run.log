+            zero = rng.choice([i for i, x in enumerate(values) if not x])
+            values[one] ^= 1
+            values[zero] ^= 1
+            candidate = _satisfied(inst, values)
+            operations += inst["equation_count"]
+            if candidate >= score:
+                score = candidate
+            else:
+                values[one] ^= 1
+                values[zero] ^= 1
