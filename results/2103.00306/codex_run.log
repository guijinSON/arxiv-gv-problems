+"""Verified problem generator for arXiv:2103.00306.
+
+The generated object is an odd-vertex pairing F of a finite multigraph G.  A
+certificate names whole vertex clouds and thereby defines a concrete cut X.
+The construction composes the cut identity in Section 3.1 of the paper with a
+low-degree channel network, so the planted auxiliary cut is carried to an exact
+cut-admissibility violation without solving the generated instance.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "The hexadecimal cloud tags and the displayed audit mask carry a masked-parity invariant."
+)
+PLACEBO_HINT: str = (
+    "The hexadecimal cloud tags and the displayed audit data reward careful indexing throughout."
+)
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "a finite multigraph G given by exact vertex and edge-block definitions",
+        "an odd-vertex pairing F",
+        "a symbolic vertex cut consisting of whole clouds and fixed channel blocks",
+    ],
+    "verification_operations": [
+        "exact multigraph cut counting",
+        "exact odd-degree and pairing identities",
+        "integer comparison with an exact q-to-t edge-connectivity",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "A masked parity of the cloud tags gives the extremal auxiliary cut; "
+        "without noticing it, one must mechanically two-colour the paired-cloud graph."
+    ),
+    "hardness_basis": (
+        "Track B: breadth-first bipartite two-colouring solves this generated regime "
+        "in O(n+m), with its measured shipping cost recorded by selftest, while the "
+        "compact masked-parity route uses two exact word operations per cloud."
+    ),
+    "max_answer_tokens": 40,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 16, "block_size": 4, "tag_bits": 16},
+    "easy": {"n": 96, "block_size": 8, "tag_bits": 48},
+    "medium": {"n": 112, "block_size": 8, "tag_bits": 56},
+    "hard": {"n": 128, "block_size": 8, "tag_bits": 64},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A strictly increasing list of exactly n/2 distinct one-based cloud indices "
+        "from 1..n, required to contain cloud 1; it symbolically denotes q, every "
+        "left channel, and all centers and incidence leaves in the named clouds."
+    ),
+    "bounds": {
+        "max_clouds": 512,
+        "max_selected_clouds": 256,
+        "index_base": 1,
+        "order": "strictly increasing",
+    },
+}
+
+NOTES: str = (
+    "Section 1 fixes odd-vertex pairings, R_G(X), and cut-admissibility. Section "
+    "2.1 fixes AMAXCUT's even-edge/even-degree regime. Section 3.1, especially "
+    "Lemma 4, supplies the constant-boundary-minus-auxiliary-cut identity; Sections "
+    "3.2--3.3 show why degrees and the distinguished connectivity must be controlled. "
+    "The literal augmented-grid construction is polynomial but far too large for a "
+    "writable benchmark, so this generator proves the same identity directly with "
+    "low-degree channel vertices. It does not claim average-case hardness from "
+    "Theorems 2 or 3: the generated auxiliary graph is bipartite and BFS solves it, "
+    "hence Track B. All cloud vertices have the same auxiliary degree; randomized "
+    "block ports and labels remove positional and degree outliers; balanced greedy, "
+    "pair-swap restarts, raw tag parity, and alternating-index attacks are measured."
+)
+
+# Replaced with evidence produced by the three isolated harden.py runs.  "pending"
+# deliberately prevents a final selftest report from passing before that evidence
+# exists.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
+    },
+    "hinted_verdict": "pending",
+}
+
+
+def _parity(value):
+    return value.bit_count() & 1
+
+
+def _random_regular_supergraph(blocks, rng):
+    """Connected degree-3 graph: a cycle plus a disjoint random perfect matching."""
+    if blocks < 4 or blocks % 2:
+        raise ValueError("the number of blocks must be even and at least 4")
+    cycle = {tuple(sorted((i, (i + 1) % blocks))) for i in range(blocks)}
+    for _ in range(2000):
+        order = list(range(blocks))
+        rng.shuffle(order)
+        matching = {
+            tuple(sorted((order[i], order[i + 1])))
+            for i in range(0, blocks, 2)
+        }
+        if len(matching) == blocks // 2 and not (matching & cycle):
+            return sorted(cycle | matching)
+    raise RuntimeError("could not sample the block-level perfect matching")
+
+
+def _auxiliary_graph(n, block_size, rng):
+    """A connected even-regular bipartite graph with local-search block traps."""
+    if block_size < 4 or block_size % 2:
+        raise ValueError("block_size must be an even integer at least 4")
+    if n % block_size:
+        raise ValueError("n must be divisible by block_size")
+    if block_size == 4:
+        # A single cycle keeps the smallest supported instance genuinely
+        # connected and hand-checkable.  The larger presets use the traps below.
+        old_to_new = list(range(n))
+        rng.shuffle(old_to_new)
+        result = [
+            sorted((old_to_new[i], old_to_new[(i + 1) % n])) for i in range(n)
+        ]
+        side = {old_to_new[i] for i in range(0, n, 2)}
+        rng.shuffle(result)
+        return result, side
+    blocks = n // block_size
+    if blocks < 4 or blocks % 2:
+        raise ValueError("n/block_size must be even and at least 4")
+    half = block_size // 2
+    internal = []
+    left = []
+    right = []
+    for block in range(blocks):
+        base = block * block_size
+        lpart = [base + i for i in range(half)]
+        rpart = [base + half + i for i in range(half)]
+        left.append(lpart)
+        right.append(rpart)
+        internal.extend((u, v) for u in lpart for v in rpart)
+
+    edges = set(internal)
+    super_edges = _random_regular_supergraph(blocks, rng)
+    incident = [[] for _ in range(blocks)]
+    for edge_id, (a, b) in enumerate(super_edges):
+        incident[a].append(edge_id)
+        incident[b].append(edge_id)
+
+    # Every block has three ports.  Removing one internal edge at each endpoint
+    # and cross-joining the two pairs preserves every degree and the bipartition.
+    ports = {}
+    for block in range(blocks):
+        choices = [(u, v) for u in left[block] for v in right[block]]
+        rng.shuffle(choices)
+        for edge_id, port in zip(sorted(incident[block]), choices):
+            ports[(block, edge_id)] = port
+
+    for edge_id, (a, b) in enumerate(super_edges):
+        ua, va = ports[(a, edge_id)]
+        ub, vb = ports[(b, edge_id)]
+        edges.remove((ua, va))
+        edges.remove((ub, vb))
+        edges.add((ua, vb))
+        edges.add((ub, va))
+
+    # Hide blocks, ports, and the two sides behind a uniform vertex relabelling.
+    old_to_new = list(range(n))
+    rng.shuffle(old_to_new)
+    mapped = {
+        tuple(sorted((old_to_new[u], old_to_new[v]))) for u, v in edges
+    }
+    side = {old_to_new[u] for part in left for u in part}
+    result = sorted(mapped)
+    rng.shuffle(result)
+    return result, side
+
+
+def _sample_tags(n, tag_bits, selected, rng):
+    if tag_bits < 8:
+        raise ValueError("tag_bits must be at least 8")
+    limit = (1 << tag_bits) - 1
+    while True:
+        audit_mask = rng.getrandbits(tag_bits) & limit
+        if audit_mask and audit_mask.bit_count() >= tag_bits // 3:
+            break
+    tags = []
+    used = set()
+    for vertex in range(n):
+        wanted = int(vertex in selected)
+        for _ in range(10000):
+            tag = rng.getrandbits(tag_bits) & limit
+            if tag not in used and _parity(tag & audit_mask) == wanted:
+                used.add(tag)
+                tags.append(tag)
+                break
+        else:
+            raise RuntimeError("could not sample distinct parity-balanced tags")
+    return tags, audit_mask
+
+
+def make_instance(n, seed=0, block_size=8, tag_bits=64, **params) -> dict:
+    """Construct a certified non-cut-admissibility witness without solving it."""
+    del params
+    for name, value in (("n", n), ("block_size", block_size), ("tag_bits", tag_bits)):
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise ValueError(f"{name} must be an integer")
+    rng = random.Random(seed)
+    edges, one_side = _auxiliary_graph(n, block_size, rng)
+    # Fix the complement symmetry in the certificate language.
+    selected = set(one_side)
+    if 0 not in selected:
+        selected = set(range(n)) - selected
+    tags, audit_mask = _sample_tags(n, tag_bits, selected, rng)
+
+    m = len(edges)
+    cut_threshold = m - 2
+    channel_count = m * n - cut_threshold
+    if m % 2 or cut_threshold % 2 or channel_count % 2:
+        raise AssertionError("the AMAXCUT and channel parity invariants failed")
+    if channel_count < 2 * m + block_size // 2:
+        raise AssertionError("channel count does not dominate all vertex degrees")
+
+    return {
+        "family": "symbolic cut-admissibility violation for an odd-vertex pairing",
+        "n": n,
+        "block_size": block_size,
+        "tag_bits": tag_bits,
+        "tags": tags,
+        "audit_mask": audit_mask,
+        "aux_edges": [list(edge) for edge in edges],
+        "m": m,
+        "cut_threshold": cut_threshold,
+        "channel_count": channel_count,
+        "graph_vertex_count": 2 + n + 2 * m + 2 * channel_count,
+        "graph_edge_count": 2 * channel_count + 2 * m * n + 2 * m,
+        "pairing_edge_count": m + 2 * (cut_threshold // 2),
+        "answer": [i + 1 for i in sorted(selected)],
+    }
+
+
+def _hex(value, bits):
+    return f"{value:0{(bits + 3) // 4}x}"
+
+
+def render(inst) -> str:
+    tags = []
+    for start in range(0, inst["n"], 4):
+        tags.append(
+            "  "
+            + "  ".join(
+                f"{i + 1}:{_hex(inst['tags'][i], inst['tag_bits'])}"
+                for i in range(start, min(start + 4, inst["n"]))
+            )
+        )
+    edge_lines = []
+    for start in range(0, inst["m"], 8):
+        edge_lines.append(
+            "  "
+            + "  ".join(
+                f"{u + 1}-{v + 1}"
+                for u, v in inst["aux_edges"][start : start + 8]
+            )
+        )
+
+    statement = f"""CUT-ADMISSIBILITY WITNESS FOR AN ODD-VERTEX PAIRING
+
+All graphs below are finite undirected multigraphs without loops. Parallel edges
+are counted with multiplicity. For a graph J and vertex set Y, d_J(Y) is the
+number of J-edges with exactly one endpoint in Y. For vertices a,b,
+lambda_J(a,b) is the minimum d_J(Y) over all sets Y containing a but not b.
+For a nonempty proper Y define
+  R_J(Y) = max 2*floor(lambda_J(a,b)/2),
+where the maximum is over a in Y and b outside Y. A pairing F of the odd-degree
+vertices of G is cut-admissible when d_G(Y)-d_F(Y) >= R_G(Y) for every Y.
+A set violating this inequality is an exact certificate of non-admissibility.
+
+This instance defines G, F, and a bounded language of candidate sets. There are
+n={inst['n']} CLOUDS, numbered 1..{inst['n']}. Cloud i has a center c_i and one
+incidence leaf z_(e,i) for every auxiliary edge e incident with i. The auxiliary
+graph H has m={inst['m']} edges:
+{chr(10).join(edge_lines)}
+
+H is part of the instance, not an omitted promise: the list above contains every
+edge once. Its vertex tags are fixed-width {inst['tag_bits']}-bit hexadecimal names:
+{chr(10).join(tags)}
+The public audit mask is C={_hex(inst['audit_mask'], inst['tag_bits'])}.
+
+Here is the complete block definition of G and F. It is an exact compact notation
+for individual vertices and parallel edges; all index bounds are inclusive.
+
+Let k=m-2={inst['cut_threshold']}, M=m*n-k={inst['channel_count']}, and A=m*n={inst['m'] * inst['n']}.
+Besides the cloud vertices, G has q,t, left channels L_0..L_(M-1), and right
+channels R_0..R_(M-1). For every j, G has q--L_j and R_j--t. Flatten the A tokens
+(i,r), 1<=i<=n and 0<=r<m, by z=(i-1)*m+r. Put h(z)=z when z<M and h(z)=z-M
+when M<=z<A. For every token z belonging to cloud i, G has L_h(z)--c_i and
+c_i--R_h(z). Finally G has c_i--z_(e,i) for every incidence of i with e in H.
+There are no other G-edges.
+
+F contains z_(e,u)--z_(e,v) for every H-edge e=u-v. Channels L_0..L_(k-1)
+are paired consecutively (L_0--L_1, L_2--L_3, ...), and independently so are
+R_0..R_(k-1). There are no other F-edges. Thus F pairs every odd-degree vertex
+of G exactly once.
+
+Your answer must be a strictly increasing list S of exactly {inst['n'] // 2}
+distinct cloud indices from 1..{inst['n']}, and S must contain 1. It denotes the
+concrete vertex set X containing q, every left channel, and, for each i in S,
+the center c_i and all incidence leaves z_(e,i). It contains no other vertices.
+Find S such that d_G(X)-d_F(X) < R_G(X). The checker evaluates the exact cut
+identity and the exact q-to-t connectivity M; no approximation or hidden answer
+is used. Order and cardinality are mandatory, repeats are forbidden, and indices
+are one-based.
+
+Give your final answer inside <answer></answer> tags, as comma-separated decimal
+integers in strictly increasing order. A format example (not this instance's
+answer) is <answer>1, 4, 9</answer>.
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json|text)?\s*|\s*```$", "", body, flags=re.I | re.S)
+    body = body.strip()
+    if body == "":
+        return []
+    if body.startswith("[") and body.endswith("]"):
+        try:
+            value = json.loads(body)
+        except (TypeError, ValueError):
+            return None
+        if not isinstance(value, list):
+            return None
+        if any(isinstance(x, bool) or not isinstance(x, int) for x in value):
+            return None
+        return value
+    if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
+        return None
+    try:
+        return [int(item.strip()) for item in body.split(",")]
+    except ValueError:
+        return None
+
+
+def _aux_cut(inst, chosen):
+    return sum((u in chosen) != (v in chosen) for u, v in inst["aux_edges"])
+
+
+def verify(inst, answer):
+    if not isinstance(answer, list):
+        return False, "answer must be a list of cloud indices"
+    if not answer:
+        return False, "answer is empty"
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in answer):
+        return False, "every cloud index must be an integer"
+    if any(x < 1 or x > inst["n"] for x in answer):
+        return False, f"cloud indices must lie in 1..{inst['n']}"
+    if len(set(answer)) != len(answer):
+        return False, "cloud indices must be distinct"
+    if answer != sorted(answer):
+        return False, "cloud indices must be in strictly increasing order"
+    if len(answer) != inst["n"] // 2:
+        return False, f"answer must contain exactly {inst['n'] // 2} clouds"
+    if answer[0] != 1:
+        return False, "the selected side must contain cloud 1"
+
+    chosen = {value - 1 for value in answer}
+    d_f = _aux_cut(inst, chosen)
+    d_g = inst["m"] * inst["n"]
+    # In the compact channel graph q has degree M.  The M paths using token z=j
+    # are edge-disjoint, so lambda(q,t)=M.  Every vertex has degree <=M, hence the
+    # paper's R_G(X) is exactly M for every candidate X in this language.
+    connectivity = inst["channel_count"]
+    if d_g - d_f >= connectivity:
+        return False, (
+            "cut inequality fails: "
+            f"d_G(X)-d_F(X)={d_g - d_f} is not below R_G(X)={connectivity}"
+        )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    rest = rng.sample(range(2, inst["n"] + 1), inst["n"] // 2 - 1)
+    return [1] + sorted(rest)
+
+
+def search_space(inst):
+    return math.comb(inst["n"] - 1, inst["n"] // 2 - 1)
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 100_000:
+        return None
+    count = 0
+    for rest in itertools.combinations(range(2, inst["n"] + 1), inst["n"] // 2 - 1):
+        count += int(verify(inst, [1] + list(rest))[0])
+    return count
+
+
+def _structural_coloring_key(inst):
+    """Strong cheap isomorphism invariant of the unlabelled auxiliary graph."""
+    n = inst["n"]
+    adjacency = [set() for _ in range(n)]
+    for u, v in inst["aux_edges"]:
+        adjacency[u].add(v)
+        adjacency[v].add(u)
+
+    initial = []
+    for u in range(n):
+        common = sorted(len(adjacency[u] & adjacency[v]) for v in range(n) if v != u)
+        initial.append(tuple(common))
+    palette = {sig: i for i, sig in enumerate(sorted(set(initial)))}
+    colors = [palette[sig] for sig in initial]
+    for _ in range(n):
+        signatures = [
+            (colors[u], tuple(sorted(colors[v] for v in adjacency[u])))
+            for u in range(n)
+        ]
+        palette = {sig: i for i, sig in enumerate(sorted(set(signatures)))}
+        refined = [palette[sig] for sig in signatures]
+        if refined == colors:
+            break
+        colors = refined
+    color_counts = {}
+    edge_counts = {}
+    for color in colors:
+        color_counts[color] = color_counts.get(color, 0) + 1
+    for u, v in inst["aux_edges"]:
+        pair = tuple(sorted((colors[u], colors[v])))
+        edge_counts[pair] = edge_counts.get(pair, 0) + 1
+    return {
+        "color_counts": sorted(color_counts.items()),
+        "edge_color_counts": sorted([a, b, c] for (a, b), c in edge_counts.items()),
+        "common_neighbor_profiles": sorted(initial),
+    }
+
+
+def canonical_key(inst):
+    payload = {
+        "n": inst["n"],
+        "m": inst["m"],
+        "block_size": inst["block_size"],
+        "profile": _structural_coloring_key(inst),
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params):
+    harder = dict(params)
+    if harder.get("tag_bits", 64) < 160:
+        harder["tag_bits"] = int(harder.get("tag_bits", 64)) + 32
+        return harder
+    n = int(harder["n"])
+    if n < 512:
+        harder["n"] = n + 16
+        return harder
+    return "cap_bound"
+
+
+def _force_language(inst, chosen):
+    chosen = set(chosen)
+    chosen.add(0)
+    ordered = sorted(chosen)
+    if len(ordered) > inst["n"] // 2:
+        removable = [x for x in reversed(ordered) if x != 0]
+        for x in removable[: len(ordered) - inst["n"] // 2]:
+            chosen.remove(x)
+    elif len(ordered) < inst["n"] // 2:
+        for x in range(inst["n"]):
+            if x not in chosen:
+                chosen.add(x)
+                if len(chosen) == inst["n"] // 2:
+                    break
+    return [x + 1 for x in sorted(chosen)]
+
+
+def _attack_numeric_outlier(inst):
+    order = sorted(range(inst["n"]), key=lambda i: (inst["tags"][i], i))
+    return _force_language(inst, order[: inst["n"] // 2]), inst["n"]
+
+
+def _attack_raw_hamming_parity(inst):
+    selected = [i for i, tag in enumerate(inst["tags"]) if _parity(tag)]
+    return _force_language(inst, selected), inst["n"]
+
+
+def _attack_alternating_indices(inst):
+    return _force_language(inst, range(0, inst["n"], 2)), inst["n"]
+
+
+def _attack_greedy_order(inst):
+    adjacency = [[] for _ in range(inst["n"])]
+    for u, v in inst["aux_edges"]:
+        adjacency[u].append(v)
+        adjacency[v].append(u)
+    bits = [None] * inst["n"]
+    bits[0] = 1
+    operations = 0
+    for vertex in range(1, inst["n"]):
+        seen = [bits[u] for u in adjacency[vertex] if bits[u] is not None]
+        operations += len(adjacency[vertex])
+        if not seen:
+            bits[vertex] = inst["tags"][vertex] & 1
+        else:
+            bits[vertex] = int(2 * sum(seen) < len(seen))
+    scores = []
+    for vertex in range(inst["n"]):
+        score = sum(bits[vertex] != bits[u] for u in adjacency[vertex])
+        scores.append((score, -vertex, vertex))
+        operations += len(adjacency[vertex])
+    preferred = [i for i, bit in enumerate(bits) if bit]
+    if len(preferred) != inst["n"] // 2:
+        preferred = [item[2] for item in sorted(scores, reverse=True)[: inst["n"] // 2]]
+    return _force_language(inst, preferred), operations
+
+
+def _cut_score(inst, bits):
+    return sum(bits[u] != bits[v] for u, v in inst["aux_edges"])
+
+
+def _attack_pair_swap_restarts(inst, rng, restarts=64):
+    operations = 0
+    half = inst["n"] // 2
+    for _ in range(restarts):
+        chosen = {0}
+        chosen.update(rng.sample(range(1, inst["n"]), half - 1))
+        bits = [int(i in chosen) for i in range(inst["n"])]
+        score = _cut_score(inst, bits)
+        operations += inst["m"]
+        for _step in range(2 * inst["n"]):
+            inside = [i for i in range(1, inst["n"]) if bits[i]]
+            outside = [i for i in range(1, inst["n"]) if not bits[i]]
+            a = rng.choice(inside)
+            b = rng.choice(outside)
+            bits[a] ^= 1
+            bits[b] ^= 1
+            candidate = _cut_score(inst, bits)
+            operations += inst["m"]
+            if candidate >= score:
+                score = candidate
+            else:
+                bits[a] ^= 1
+                bits[b] ^= 1
+            if score == inst["m"]:
+                answer = [i + 1 for i, bit in enumerate(bits) if bit]
+                return answer, operations
+    return [i + 1 for i, bit in enumerate(bits) if bit], operations
+
+
+def _bfs_reference(inst):
+    adjacency = [[] for _ in range(inst["n"])]
+    operations = 0
+    for u, v in inst["aux_edges"]:
+        adjacency[u].append(v)
+        adjacency[v].append(u)
+        operations += 2
+    colors = [-1] * inst["n"]
+    colors[0] = 1
+    queue = [0]
+    head = 0
+    while head < len(queue):
+        u = queue[head]
+        head += 1
+        operations += 1
+        for v in adjacency[u]:
+            operations += 1
+            wanted = 1 - colors[u]
+            if colors[v] < 0:
+                colors[v] = wanted
+                queue.append(v)
+            elif colors[v] != wanted:
+                return None, operations
+    if any(color < 0 for color in colors):
+        return None, operations
+    answer = [i + 1 for i, color in enumerate(colors) if color == 1]
+    return answer, operations
+
+
+def _relabel_instance(inst, rng):
+    n = inst["n"]
+    order = list(range(n))
+    rng.shuffle(order)
+    old_to_new = [0] * n
+    tags = [0] * n
+    for new, old in enumerate(order):
+        old_to_new[old] = new
+        tags[new] = inst["tags"][old]
+    edges = [
+        sorted((old_to_new[u], old_to_new[v])) for u, v in inst["aux_edges"]
+    ]
+    for edge in edges:
+        if rng.randrange(2):
+            edge.reverse()
+    rng.shuffle(edges)
+    answer = sorted(old_to_new[value - 1] + 1 for value in inst["answer"])
+    if 1 not in answer:
+        answer = sorted(set(range(1, n + 1)) - set(answer))
+    out = dict(inst)
+    out["tags"] = tags
+    out["aux_edges"] = edges
+    out["answer"] = answer
+    return out
+
+
+def _corruptions(inst):
+    answer = list(inst["answer"])
+    dropped = answer[:-1]
+    swapped = list(answer)
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    duplicated = list(answer)
+    duplicated[-1] = duplicated[-2]
+    outside = list(answer)
+    outside[-1] = inst["n"] + 1
+    unselected = next(i for i in range(2, inst["n"] + 1) if i not in answer)
+    changed = sorted(answer[:-1] + [unselected])
+    return {
+        "drop_one": dropped,
+        "swap_order": swapped,
+        "duplicate": duplicated,
+        "empty": [],
+        "out_of_range": outside,
+        "same_shape_wrong_cut": changed,
+    }
+
+
+def selftest():
+    report = {}
+
+    checked = 0
+    roundtrips = 0
+    g1_ok = True
+    for params in DIFFICULTY.values():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            g1_ok &= verify(inst, inst["answer"])[0]
+            checked += 1
+            roundtrips += int(json.loads(json.dumps(inst["answer"])) == inst["answer"])
+    report["G1_planted_verifies"] = {
+        "pass": g1_ok and checked == roundtrips,
+        "instances_checked": checked,
+        "json_native_roundtrips": roundtrips,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=314159, **ship_params)
+    reasons = {}
+    corruption_ok = True
+    for name, bad in _corruptions(ship).items():
+        ok, why = verify(ship, bad)
+        corruption_ok &= not ok
+        reasons[name] = why
+    distinct = len(set(reasons.values())) == len(reasons)
+    report["G2_rejects_corruption"] = {
+        "pass": corruption_ok and distinct,
+        "reasons": reasons,
+        "distinct_reasons": distinct,
+    }
+
+    body = ", ".join(map(str, ship["answer"]))
+    parsed = parse_answer(
+        "The cloud cut follows from the invariant.\n```text\n"
+        f"<answer>{body}</answer>\n```\nThat is my final witness."
+    )
+    report["G3_round_trip"] = {
+        "pass": parsed == ship["answer"],
+        "parsed_elements": len(parsed) if isinstance(parsed, list) else None,
+    }
+
+    guess_rng = random.Random(0x210300306)
+    guess_total = 200_000
+    guess_hits = 0
+    started = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(ship, random_candidate(ship, guess_rng))[0])
+    guess_elapsed = time.perf_counter() - started
+    report["G4_guess_resistance"] = {
+        "pass": guess_hits / guess_total < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_hits / guess_total,
+        "candidate_space": search_space(ship),
+        "exact_valid_answers_in_language": 1,
+        "exact_probability": 1 / search_space(ship),
+        "prior": "uniform over anchored balanced cloud subsets required by the statement",
+        "wall_clock_sec": round(guess_elapsed, 6),
+    }
+
+    attack_names = (
+        "outlier_smallest_numeric_tags",
+        "greedy_vertex_order",
+        "random_restart_pair_swap_64",
+        "raw_hamming_parity_ansatz",
+        "alternating_index_ansatz",
+    )
+    stats = {
+        name: {"successes": 0, "attempts": 0, "nodes": 0, "wall_clock_sec": 0.0}
+        for name in attack_names
+    }
+    node_samples = {name: [] for name in attack_names}
+    time_samples = {name: [] for name in attack_names}
+    ref_times = []
+    ref_ops = []
+    ref_successes = 0
+    for trial_seed in range(800, 808):
+        inst = make_instance(seed=trial_seed, **ship_params)
+        rng = random.Random(trial_seed ^ 0xA55A)
+        attacks = {
+            "outlier_smallest_numeric_tags": lambda: _attack_numeric_outlier(inst),
+            "greedy_vertex_order": lambda: _attack_greedy_order(inst),
+            "random_restart_pair_swap_64": lambda: _attack_pair_swap_restarts(inst, rng, 64),
+            "raw_hamming_parity_ansatz": lambda: _attack_raw_hamming_parity(inst),
+            "alternating_index_ansatz": lambda: _attack_alternating_indices(inst),
+        }
+        for name, attack in attacks.items():
+            attack_start = time.perf_counter()
+            candidate, nodes = attack()
+            elapsed = time.perf_counter() - attack_start
+            stats[name]["successes"] += int(verify(inst, candidate)[0])
+            stats[name]["attempts"] += 1
+            stats[name]["nodes"] += nodes
+            stats[name]["wall_clock_sec"] += elapsed
+            node_samples[name].append(nodes)
+            time_samples[name].append(elapsed)
+
+        ref_start = time.perf_counter()
+        candidate, operations = _bfs_reference(inst)
+        ref_times.append(time.perf_counter() - ref_start)
+        ref_ops.append(operations)
+        ref_successes += int(candidate is not None and verify(inst, candidate)[0])
+
+    for name, stat in stats.items():
+        stat["wall_clock_sec"] = round(stat["wall_clock_sec"], 6)
+        stat["nodes_median_per_instance"] = int(statistics.median(node_samples[name]))
+        stat["wall_clock_sec_median_per_instance"] = round(
+            statistics.median(time_samples[name]), 8
+        )
+    reference = {
+        "name": "breadth-first bipartite two-colouring of the paired-cloud graph",
+        "complexity": "O(n+m) exact graph operations",
+        "wall_clock_sec_median": round(statistics.median(ref_times), 8),
+        "operations_median": int(statistics.median(ref_ops)),
+        "operations_range": [min(ref_ops), max(ref_ops)],
+        "solves": f"{ref_successes}/8, as expected",
+    }
+    all_failed = all(stat["successes"] == 0 for stat in stats.values())
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_hits / guess_total < 1e-6 and ref_successes == 8,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_total": guess_total,
+        "shipping_valid_fraction": guess_hits / guess_total,
+        "shipping_exact_valid_answer_count": 1,
+        "exact_demo_valid_answer_count": enumerate_all(
+            make_instance(seed=0, **DIFFICULTY["demo"])
+        ),
+        "reference_wall_clock_sec_median": reference["wall_clock_sec_median"],
+        "reference_operation_count_median": reference["operations_median"],
+        "strongest_failing_attack_nodes_median": stats[
+            "random_restart_pair_swap_64"
+        ]["nodes_median_per_instance"],
+        "strongest_failing_attack_wall_clock_sec_median": stats[
+            "random_restart_pair_swap_64"
+        ]["wall_clock_sec_median_per_instance"],
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and ref_successes == 8,
+        "attacks": stats,
+        "reference_algorithm": reference,
+    }
+
+    doubled_params = dict(ship_params)
+    doubled_params["n"] = 2 * ship_params["n"]
+    doubled = make_instance(seed=271828, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    harder = escalate(ship_params)
+    escalated = make_instance(seed=271829, **harder) if isinstance(harder, dict) else None
+    escalated_ok = bool(escalated and verify(escalated, escalated["answer"])[0])
+    fixed_answer = bool(escalated and len(escalated["answer"]) == len(ship["answer"]))
+    report["G7_scales"] = {
+        "pass": doubled_ok and escalated_ok and fixed_answer,
+        "shipping_n": ship["n"],
+        "doubled_n": doubled["n"],
+        "doubled_graph_vertices": doubled["graph_vertex_count"],
+        "doubled_planted_verifies": doubled_ok,
+        "escalated_params": harder,
+        "escalated_planted_verifies": escalated_ok,
+        "fixed_answer_elements_on_escalation": fixed_answer,
+    }
+
+    invariant_checks = 0
+    preservation_checks = 0
+    keys = []
+    g8_ok = True
+    for seed in range(1200, 1220):
+        inst = make_instance(seed=seed, **ship_params)
+        key = canonical_key(inst)
+        keys.append(key)
+        transformed = _relabel_instance(inst, random.Random(seed * 17 + 1))
+        composed = _relabel_instance(transformed, random.Random(seed * 17 + 2))
+        for other in (transformed, composed):
+            invariant_checks += 1
+            g8_ok &= canonical_key(other) == key
+            preservation_checks += 1
+            g8_ok &= verify(other, other["answer"])[0]
+    distinct_keys = len(set(keys))
+    report["G8_canonical_key"] = {
+        "pass": g8_ok and distinct_keys == 20,
+        "invariance_checks": invariant_checks,
+        "certificate_preservation_checks": preservation_checks,
+        "distinct_unrelated_instances": distinct_keys,
+        "unrelated_instances_tested": 20,
+        "transformations": [
+            "cloud renumbering with tags and certificate carried through",
+            "auxiliary-edge reordering and endpoint swapping",
+            "composition of two independent cloud relabellings",
+        ],
+        "invariant_strength": (
+            "common-neighbor profiles followed by stable color refinement; "
+            "not a complete graph-isomorphism canonical form"
+        ),
+    }
+
+    char_samples = [
+        len(json.dumps(make_instance(seed=s, **ship_params)["answer"], separators=(",", ":")))
+        for s in range(64)
+    ]
+    answer_chars = max(char_samples)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = len(ship["answer"])
+    intended_operations = 2 * ship["n"]
+    arms = G9_RESULTS["arms"]
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    evidence_complete = all(arms[name]["attempts"] >= 3 for name in arms)
+    hinted_hardened = G9_RESULTS.get("hinted_verdict") == "hardened"
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_operations <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": evidence_complete and hinted_hardened and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_RESULTS.get("hinted_verdict"),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "answer_size_instances_measured": len(char_samples),
+        "intended_route_operations": intended_operations,
+        "operation_model": "one exact word AND and one exact parity operation per cloud tag",
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = ship_params
+    report["all_passed"] = all(
+        item.get("pass", False)
+        for name, item in report.items()
+        if name.startswith("G") and isinstance(item, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

codex
The fixed-answer escalation to 96-bit tags was also solved on its first attempt. That means increasing coefficient width does not rescue the family; the weakness is structural, not a cap or transcription artifact.
