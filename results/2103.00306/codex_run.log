+    h_edges = 14 * r
+    max_cut = 9 * r
+    threshold = max_cut - 2
+    channels = h_edges * cloud_count - threshold
+    if r % 2 or h_edges % 2 or threshold % 2 or channels % 2:
+        raise AssertionError("the AMAXCUT/channel parity conditions failed")
