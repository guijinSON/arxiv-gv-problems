+    missing = next(i for i in range(1, inst["n"] + 1) if i not in a)
+    return {"drop_one": a[:-1], "swap_order": swap, "duplicate": dup, "empty": [],
+            "out_of_range": outside, "same_shape_wrong_assignment": sorted(a[:-1] + [missing])}
+
+
