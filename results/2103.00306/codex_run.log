+    colors[0] = 1
+    queue = [0]
+    head = 0
+    while head < len(queue):
+        u = queue[head]
+        head += 1
+        operations += 1
+        for v in adjacency[u]:
+            operations += 1
+            wanted = 1 - colors[u]
+            if colors[v] < 0:
+                colors[v] = wanted
+                queue.append(v)
+            elif colors[v] != wanted:
+                return None, operations
