+    "medium": {"n": 44, "base_equations": 52, "tag_bits": 192},
+    "hard": {"n": 48, "base_equations": 56, "tag_bits": 256},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+CERTIFICATE_LANGUAGE: dict = {
