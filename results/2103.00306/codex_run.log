diff --git a/gen_2103_00306.py b/gen_2103_00306.py
new file mode 100644
index 0000000000000000000000000000000000000000..8967bf5adec40a5527e717ce8791f413e2dbc73f
--- /dev/null
+++ b/gen_2103_00306.py
@@ -0,0 +1,626 @@
+"""Verified problem generator for arXiv:2103.00306.
+
+The answer symbolically describes a concrete violating cut for an odd-vertex
+pairing. A planted 3-XOR assignment is carried through a termwise MAXCUT gadget
+and then through the paper's constant-boundary cut identity.
+"""
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+
+TRACK: str = "B"
+STRUCTURAL_HINT: str = (
