+    stats = {x: {"successes": 0, "attempts": 0, "nodes": 0, "wall_clock_sec": 0.0} for x in names}
+    nodes, times, ref_t, ref_o, ref_ok = {x: [] for x in names}, {x: [] for x in names}, [], [], 0
+    for seed in range(800, 808):
