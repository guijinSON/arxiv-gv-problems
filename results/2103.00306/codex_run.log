+    equations = []
+    for row in inst["equations"]:
+        mapped = [old_new[i] for i in row]
+        rng.shuffle(mapped)
+        equations.append(mapped)
+    rng.shuffle(equations)
+    out = dict(inst)
+    out["tags"], out["equations"] = tags, equations
+    out["answer"] = sorted(old_new[i - 1] + 1 for i in inst["answer"])
+    return out
