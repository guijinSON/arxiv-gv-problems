+def _attack_numeric(inst):
+    return _force_weight(inst, [-x for x in inst["tags"]]), inst["n"]
+
+
+def _attack_raw_parity(inst):
+    return _force_weight(inst, [2 * _parity(x) - 1 for x in inst["tags"]]), inst["n"]
