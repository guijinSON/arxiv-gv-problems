+
+
+def _assignment(inst, answer):
+    selected = set(answer)
+    return [int(i + 1 in selected) for i in range(inst["n"])]
+
+
+def _h_cut(inst, values):
+    total = 0
+    for a, b, c in inst["equations"]:
