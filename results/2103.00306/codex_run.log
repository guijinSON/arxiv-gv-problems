+    "easy": {"n": 40, "base_equations": 48, "tag_bits": 128},
+    "medium": {"n": 44, "base_equations": 52, "tag_bits": 192},
+    "hard": {"n": 48, "base_equations": 56, "tag_bits": 256},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A strictly increasing list of exactly n/2 distinct one-based variable "
+        "indices from 1..n; listed variables have value 1, and the statement's "
