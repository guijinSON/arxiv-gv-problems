+def _relabel_instance(inst, rng):
+    n = inst["n"]
+    order = list(range(n))
+    rng.shuffle(order)
+    old_to_new = [0] * n
+    tags = [0] * n
+    for new, old in enumerate(order):
+        old_to_new[old] = new
+        tags[new] = inst["tags"][old]
+    edges = [
+        sorted((old_to_new[u], old_to_new[v])) for u, v in inst["aux_edges"]
+    ]
+    for edge in edges:
+        if rng.randrange(2):
+            edge.reverse()
+    rng.shuffle(edges)
+    answer = sorted(old_to_new[value - 1] + 1 for value in inst["answer"])
+    if 1 not in answer:
+        answer = sorted(set(range(1, n + 1)) - set(answer))
+    out = dict(inst)
+    out["tags"] = tags
+    out["aux_edges"] = edges
+    out["answer"] = answer
+    return out
