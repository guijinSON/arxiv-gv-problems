import random, math, time

def gen(n,c,seed):
 r=random.Random(seed); sec=set(r.sample(range(n),n//2)); E=[]; seen=set()
 while len(E)<c:
  t=tuple(sorted(r.sample(range(n),3)))
  if t in seen: continue
  z=sum(x in sec for x in t)
  if z in (1,2): seen.add(t); E.append(t)
 return sec,E

def valid(S,E): return all(0 < sum(x in S for x in e)<3 for e in E)

def local(n,E,seed,restarts=256,steps=None):
 r=random.Random(seed); inc=[[] for _ in range(n)]
 for j,e in enumerate(E):
  for x in e:inc[x].append(j)
 steps=steps or 20*n
 for q in range(restarts):
  bits=[r.randrange(2) for _ in range(n)]
  bad={j for j,e in enumerate(E) if bits[e[0]]==bits[e[1]]==bits[e[2]]}
  for st in range(steps):
   if not bad:return set(i for i,b in enumerate(bits) if b)
   j=r.choice(tuple(bad)); cand=[]
   for x in E[j]:
    delta=0
    for h in inc[x]:
     e=E[h]; before=bits[e[0]]==bits[e[1]]==bits[e[2]]
     after=all((bits[y]"'^(y==x))==(bits[e[0]]''^(e[0]==x)) for y in e[1:])
     delta += after-before
    cand.append((delta,r.random(),x))
   _,_,x=min(cand);bits[x]''^=1
   for h in inc[x]:
    e=E[h]
    if bits[e[0]]==bits[e[1]]==bits[e[2]]:bad.add(h)
    else:bad.discard(h)
 return None

def dpll(n,E,limit=100000):
 inc=[[] for _ in range(n)]
 for ci,e in enumerate(E):
  for x in e: inc[x].append(ci)
 val=[-1]*n; nodes=0
 def rec():
  nonlocal nodes
  nodes+=1
  if nodes>limit:return None
  # propagation repeatedly scan
  changed=True
  trail=[]
  while changed:
   changed=False
   for e in E:
    vs=[val[x] for x in e]
    if -1 not in vs:
     if vs[0]==vs[1]==vs[2]:
      for x in reversed(trail):val[x]=-1
      return False
    elif vs.count(-1)==1:
     known=[z for z in vs if z>=0]
     if known[0]==known[1]:
      x=e[vs.index(-1)];val[x]=1-known[0];trail.append(x);changed=True
  if all(x>=0 for x in val):return list(val)
  # max active degree
  x=max((i for i,z in enumerate(val) if z<0),key=lambda i:sum(any(val[y]<0 for y in E[j]) for j in inc[i]))
  for b in (0,1):
   val[x]=b
   got=rec()
   if got is None:
    val[x]=-1
    for y in reversed(trail):val[y]=-1
    return None
   if got is not False:return got
  val[x]=-1
  for y in reversed(trail):val[y]=-1
  return False
 got=rec();return got,nodes
for ratio in [2.0,2.5,3,4,5,6,8]:
 print('"'ratio',ratio)
 for n in [64,96,128]:
  ls=dp=uniq=0; nod=[]; st=time.time()
  for seed in range(8):
   S,E=gen(n,int(ratio*n),seed)
   x=local(n,E,seed+99,restarts=32)
   ls+= x is not None
   y,no=dpll(n,E,limit=200000);dp+= isinstance(y,list);nod.append(no)
  print(n,'ls',ls,'dpll',dp,'nodes',min(nod),sum(nod)//8,max(nod),'sec',round(time.time()-st,2))
