+
+def _attack_alternating(inst):
+    return list(range(1, inst["n"] + 1, 2)), inst["n"]
+
+
+def _satisfied(inst, values):
+    return sum(values[a] ^ values[b] ^ values[c] for a, b, c in inst["equations"])
