+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["vertex_count"] >= 2 * shipping["base_vertices"],
+        "shipping_n": shipping["tree_depth"],
