+def _mirror_position(position, base_vertices):
+    if position > base_vertices:
+        return position
+    depth = _position_depth(position)
+    leading = 1 << depth
+    suffix = position - leading
+    mask = leading - 1
+    return leading + (suffix ^ mask)
