+        if target not in predecessor:
+            return None, {"edge_scans": edge_scans, "visited": visited_total}
+        reverse_path = []
+        cursor = target
+        while cursor is not None:
+            reverse_path.append(cursor)
+            cursor = predecessor[cursor]
