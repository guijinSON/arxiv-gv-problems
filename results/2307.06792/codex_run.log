+    endpoint_decodes = 2 * inst["pair_count"]
+    parent_steps = sum(length - 1 for length in inst["path_lengths"])
+    return (
+        inst["inverse_euclid_divisions"]
+        + 3 * endpoint_decodes
+        + parent_steps
+        + 3 * atoms
+    )
