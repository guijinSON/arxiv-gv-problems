+        result["wall_clock_sec_total_8"] = round(result["wall_clock_sec_total_8"], 6)
+
+    reference_successes = 0
+    reference_seconds = 0.0
+    reference_scans = []
+    reference_visited = []
+    compact_successes = 0
+    for seed in seeds:
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
