+    "hard": {"n": 36, "route_depth": 16, "pairs": 2, "decoys": 20},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The public vertex labels are an affine image of rooted binary-tree "
+    "coordinates."
+)
