+        predecessor = {source: None}
+        while queue:
+            vertex = queue.popleft()
+            if vertex == target:
+                break
+            for neighbor in _neighbors(inst, vertex, decoration_map):
+                edge_scans += 1
+                if neighbor not in predecessor:
+                    predecessor[neighbor] = vertex
+                    queue.append(neighbor)
