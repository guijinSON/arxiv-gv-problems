+
+def _attack_degree(inst):
+    decoration_map = _decoration_maps(inst) or {}
+    return _walk_by_rule(
+        inst,
+        lambda graph, choices, target, step: min(
+            choices,
+            key=lambda x: (-len(_neighbors(graph, x, decoration_map)), _encode(graph, x)),
+        ),
+    )
