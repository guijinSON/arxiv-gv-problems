+}
+
+DIFFICULTY = {
+    "demo": {"n": 4, "route_depth": 2, "pairs": 2, "decoys": 2},
+    "easy": {"n": 32, "route_depth": 16, "pairs": 2, "decoys": 12},
+    "medium": {"n": 34, "route_depth": 16, "pairs": 2, "decoys": 16},
+    "hard": {"n": 36, "route_depth": 16, "pairs": 2, "decoys": 20},
+}
+SHIPPING_DIFFICULTY = "easy"
+
