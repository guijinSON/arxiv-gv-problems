+def _counted_gcd(x: int, y: int, counter: _OperationCounter) -> int:
+    counter.gcd_calls += 1
+    x, y = abs(x), abs(y)
+    while y:
+        x, y = y, x % y
+        counter.euclidean_remainders += 1
+    return x
