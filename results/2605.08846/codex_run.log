+        "named_max_operand_bits": operand_bits,
+        "answer_entries_fixed": len(answer),
+    }
+
+    invariant = True
+    invariance_checks = 0
+    real_checks = 0
+    for seed in range(20):
+        trial = make_instance(seed=10_000 + seed, **ship_params)
+        count = len(trial["rows"])
