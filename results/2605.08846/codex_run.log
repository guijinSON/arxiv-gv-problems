+def _smooth_signed_prime(sign: int, steps: int, rng: random.Random,
+                         forbidden: set[int]) -> tuple[int, int]:
+    """Prove p=2^u*3^v+sign, with u,v>=steps, and return (p,k)."""
+    if sign not in (-1, 1):
+        raise ValueError("sign must be -1 or +1")
