+def _attack_outlier_magnitude(inst: dict) -> bool:
+    ranked = sorted(range(len(inst["rows"])),
+                    key=lambda i: inst["rows"][i]["N"])
+    answer = [0] * len(ranked)
+    for index in ranked[:len(ranked) // 2]:
