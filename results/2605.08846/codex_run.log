/bin/bash -lc "python3 - <<'PY'
import json, os
import gen_2605_08846 as g
for fn,mode in [('llm_loop_transcript.jsonl',None),('g9_hinted_transcript.jsonl','structural'),('g9_placebo_transcript.jsonl','placebo')]:
    rows=[json.loads(x) for x in open(fn) if x.strip()]
    for r in rows:
        inst=g.make_instance(seed=r['seed'],**r['params'])
        if r['reply'] is None:
            assert not r['parsed'] and r['verify_ok'] is None
        else:
            ans=g.parse_answer(r['reply'])
            assert (ans is not None)==r['parsed']
            if ans is not None:
                ok,why=g.verify(inst,ans)
                assert ok==r['verify_ok'] and why==r['verify_reason'],(fn,r['seed'],why,r['verify_reason'])
        old=os.environ.get('GV_HINT_MODE')
        try:
            if mode is None: os.environ.pop('GV_HINT_MODE',None)
            else: os.environ['GV_HINT_MODE']=mode
            rendered=g.render(inst)
            assert ('Hint: '+g.STRUCTURAL_HINT in rendered)==(mode=='structural')
            assert ('Hint: '+g.PLACEBO_HINT in rendered)==(mode=='placebo')
        finally:
            if old is None: os.environ.pop('GV_HINT_MODE',None)
            else: os.environ['GV_HINT_MODE']=old
print('transcripts_replay_against_current_module: ok')
rep=json.load(open('selftest_report.json'))
print('saved_gates:',all(v.get('pass') for k,v in rep.items() if k.startswith('G') and isinstance(v,dict)))
print('readme_lines:',sum(1 for _ in open('README.md')))
