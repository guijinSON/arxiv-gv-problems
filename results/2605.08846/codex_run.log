+            cert = _pocklington_certificate(value, central, (2, 3))
+        else:
+            cert = _lucas_n_plus_one_certificate(value, (2, 3))
+        if cert is not None:
+            base_power = pow(6, steps)
+            assert central % base_power == 0
+            return value, central // base_power
