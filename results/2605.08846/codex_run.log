+    ranked = sorted(range(len(answer)),
+                    key=lambda i: (inst["rows"][i]["N"] % 10, i), reverse=True)
+    for index in ranked[:len(answer) // 2]:
+        answer[index] = -1
+    return verify(inst, answer)[0]
