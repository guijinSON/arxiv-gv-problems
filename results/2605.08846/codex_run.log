+    for divisor in prime_divisors:
+        found = None
+        for base in range(2, 80):
+            if pow(base, value - 1, value) != 1:
+                continue
+            if math.gcd(pow(base, (value - 1) // divisor, value) - 1,
+                        value) == 1:
+                found = base
+                break
+        if found is None:
+            return None
+        witnesses[divisor] = found
+    return {"known_part": known_part, "witnesses": witnesses}
