+            assert cert["known_part"] > math.isqrt(value)
+            assert all(
+                pow(base, value - 1, value) == 1
+                and math.gcd(pow(base, (value - 1) // divisor, value) - 1,
+                             value) == 1
+                for divisor, base in cert["witnesses"].items()
