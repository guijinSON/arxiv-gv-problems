+
+def _strong_probable_prime(value: int, bases: tuple[int, ...]) -> bool:
+    if value < 2:
+        return False
+    for prime in _SIEVE_PRIMES:
+        if value % prime == 0:
+            return value == prime
+    d = value - 1
+    s = 0
+    while d % 2 == 0:
+        s += 1
+        d //= 2
+    for base in bases:
+        if base >= value:
+            continue
+        x = pow(base, d, value)
+        if x in (1, value - 1):
+            continue
+        for _ in range(s - 1):
+            x = x * x % value
+            if x == value - 1:
+                break
+        else:
