+DIFFICULTY: dict = {
+    "demo": {"n": 3, "rows": 3},
+    "easy": {"n": 18, "rows": 24},
+    "medium": {"n": 24, "rows": 24},
+    "hard": {"n": 32, "rows": 24},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
