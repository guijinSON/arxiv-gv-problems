+    if (value - 1) % known_part or known_part <= math.isqrt(value):
+        return None
+    witnesses: dict[int, int] = {}
+    for divisor in prime_divisors:
+        found = None
+        for base in range(2, 80):
+            if pow(base, value - 1, value) != 1:
+                continue
+            if math.gcd(pow(base, (value - 1) // divisor, value) - 1,
+                        value) == 1:
+                found = base
+                break
