+def _matrix_mul_2x2(left: tuple[int, int, int, int],
+                    right: tuple[int, int, int, int], modulus: int
+                    ) -> tuple[int, int, int, int]:
+    a, b, c, d = left
+    e, f, g, h = right
+    return ((a * e + b * g) % modulus,
+            (a * f + b * h) % modulus,
+            (c * e + d * g) % modulus,
+            (c * f + d * h) % modulus)
+
