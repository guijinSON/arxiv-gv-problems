def _random_prime64(bits: int, rng: random.Random,
                    forbidden: set[int]) -> int:
    if not 3 <= bits <= 62:
        raise ValueError("q_bits must lie from 3 through 62")
    high = 1 << (bits - 1)
    for _ in range(100_000):
        value = rng.getrandbits(bits) | high | 1
        if value not in forbidden and _is_prime64(value):
            return value
    raise RuntimeError("64-bit prime search exhausted")


def _random_prime_interval(lower: int, upper: int, rng: random.Random,
                           forbidden: set[int]) -> int:
    """Choose a proved prime uniformly by rejection from an odd interval."""
    lower = max(3, lower)
    if upper <= lower or upper >= 1 << 64:
        raise ValueError("prime interval must be nonempty and below 2^64")
    for _ in range(100_000):
        value = rng.randrange(lower, upper) | 1
        if value < upper and value not in forbidden and _is_prime64(value):
            return value
    raise RuntimeError("interval prime search exhausted")


def _validate_parameters(n: int, rows: int) -> None:
    values = (n, rows)
    if any(isinstance(v, bool) or not isinstance(v, int) for v in values):
        raise ValueError("n and rows must be integers")
    if n < 3:
        raise ValueError("n must be at least 3")
    if not 1 <= rows <= 24:
        raise ValueError("rows must lie from 1 through 24")


def _descent(value: int, a: int, b: int, steps: int) -> int:
    q_value = value
    for _ in range(steps):
        q_value = (b * q_value) // a
    return q_value


@functools.lru_cache(maxsize=192)
def _make_cached(n: int, seed: int, rows: int,
                 steps: int, q_bits: int) -> dict:
    _validate_parameters(n, rows, steps, q_bits)
    rng = random.Random(seed)

    # a is smooth and not a perfect power.  For non-demo sizes, b is chosen so
    # (a/b)^steps has about q_bits bits.  Sampling q from the upper half of the
    # resulting exact interval makes the final fractional term exchangeable
    # with the last discarded fraction, producing both corrections without a
    # visible size class.
    a = 3 << (n - 2)
    if n < 24:
        b = 1
    else:
        root = 1 << max(2, q_bits // steps)
        centre = max(3, a // root)
        low = max(3, 9 * centre // 10)
        high = centre + 1
        while True:
            b = rng.randrange(low, high) | 1
            if b % 3 and math.gcd(a, b) == 1:
                break
    q_upper = (pow(a, steps) - 1) // pow(b, steps)
    if q_upper >= 1 << 64:
        raise ValueError("chosen rational-base interval exceeds exact q range")

    built_rows = []
    used_primes: set[int] = set()
    for _ in range(rows):
        p, k = _structured_prime(a, steps, n, rng, used_primes)
        used_primes.add(p)
        if b == 1:
            q = _random_prime64(q_bits, rng, used_primes)
        else:
            q = _random_prime_interval(q_upper // 2, q_upper,
                                       rng, used_primes)
        used_primes.add(q)
        if not pow(a, steps) > q * pow(b, steps):
            raise AssertionError("Theorem 1 size inequality failed")
        composite = p * q
        endpoint = _descent(composite, a, b, steps)
        c = k * pow(b, steps)
        correction = endpoint - c * q
        if correction not in (-1, 0):
            raise AssertionError("sharpened descent correction left {-1,0}")
        if math.gcd(endpoint - correction, composite) not in (p, q):
            raise AssertionError("constructed correction does not expose a factor")
        built_rows.append({"N": composite, "correction": correction})

    # Row order is presentation only.  Conditioning on seeing both symbols
    # makes corruption tests deterministic without changing row exchangeability.
    if b > 1 and rows > 1 and len({row["correction"] for row in built_rows}) == 1:
        # Deterministically continue the same inverse-generation process until
        # one replacement supplies the other correction.
        wanted = -1 if built_rows[0]["correction"] == 0 else 0
        for _ in range(50_000):
            p, k = _structured_prime(a, steps, n, rng, used_primes)
            used_primes.add(p)
            q = _random_prime_interval(q_upper // 2, q_upper,
                                       rng, used_primes)
            used_primes.add(q)
            composite = p * q
            endpoint = _descent(composite, a, b, steps)
            correction = endpoint - (k * pow(b, steps)) * q
            if correction == wanted:
                built_rows[-1] = {"N": composite, "correction": correction}
                break
        else:
            raise RuntimeError("could not obtain both correction values")

    rng.shuffle(built_rows)
    answer = [row["correction"] for row in built_rows]
    public_rows = [{"N": row["N"]} for row in built_rows]
    return {
        "family": "rational_base_descent_corrections_v1",
        "n": n,
        "a": a,
        "b": b,
        "steps": steps,
        "rows": public_rows,
        "correction_alphabet": [-1, 0],
        "answer": answer,
    }


def make_instance(n: int, seed: int = 0, **params) -> dict:
    """Inverse-generate structured semiprimes and theorem corrections."""
    rows = params.pop("rows", 24)
    steps = params.pop("steps", 3)
    q_bits = params.pop("q_bits", 55)
    if params:
        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))

