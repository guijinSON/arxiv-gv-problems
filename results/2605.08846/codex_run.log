+def _descent(value: int, a: int, b: int, steps: int) -> int:
+    q_value = value
+    for _ in range(steps):
+        q_value = (b * q_value) // a
+    return q_value
+
+
+@functools.lru_cache(maxsize=192)
+def _make_cached(n: int, seed: int, rows: int) -> dict:
+    _validate_parameters(n, rows)
