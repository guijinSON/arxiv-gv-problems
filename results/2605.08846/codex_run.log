+def _permute_rows(inst: dict, permutation: list[int]) -> dict:
+    moved = {key: copy.deepcopy(value) for key, value in inst.items()
+             if key != "answer"}
+    moved["rows"] = [copy.deepcopy(inst["rows"][i]) for i in permutation]
