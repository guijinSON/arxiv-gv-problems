+    "medium": {"n": 24, "rows": 24},
+    "hard": {"n": 32, "rows": 24},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+STRUCTURAL_HINT: str = (
+    "Unroll the floor recurrence as a rational power minus the bounded "
+    "geometric sum of all discarded fractions."
+)
