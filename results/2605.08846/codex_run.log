+    doubled_seconds = time.perf_counter() - doubled_start
+    operand_bits = []
+    for preset in ("easy", "medium", "hard"):
+        trial = make_instance(seed=9, **DIFFICULTY[preset])
+        operand_bits.append(max(row["N"].bit_length() for row in trial["rows"]))
+    report["G7_scales"] = {
