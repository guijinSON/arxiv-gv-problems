+@functools.lru_cache(maxsize=64)
+def _signed_prime_pool(sign: int, steps: int) -> tuple[tuple[int, int], ...]:
+    """Reusable proved-prime pool; seed-dependent q values still vary instances."""
+    count = 8 if steps <= 4 else 36
