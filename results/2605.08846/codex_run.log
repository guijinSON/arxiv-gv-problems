+def _validate_parameters(n: int, rows: int, steps: int, q_bits: int) -> None:
+    values = (n, rows, steps, q_bits)
+    if any(isinstance(v, bool) or not isinstance(v, int) for v in values):
+        raise ValueError("n, rows, steps, and q_bits must be integers")
+    if n < 8:
+        raise ValueError("n must be at least 8")
+    if not 1 <= rows <= 24:
+        raise ValueError("rows must lie from 1 through 24")
+    if not 2 <= steps <= 8:
+        raise ValueError("steps must lie from 2 through 8")
+    if not 3 <= q_bits <= 62:
+        raise ValueError("q_bits must lie from 3 through 62")
