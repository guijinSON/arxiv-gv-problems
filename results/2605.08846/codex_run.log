+    if value < 2:
+        return False
+    for prime in _SIEVE_PRIMES:
+        if value % prime == 0:
+            return value == prime
+    d = value - 1
+    s = 0
+    while d % 2 == 0:
+        s += 1
+        d //= 2
+    for base in bases:
+        if base >= value:
