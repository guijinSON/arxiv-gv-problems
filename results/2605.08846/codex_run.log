+            return {
+                "ok": False,
+                "reason": f"reference found {len(target_valid)} target corrections",
+                "answer": corrections,
+                "wall_clock_sec": time.perf_counter() - start,
+                "counter": counter,
+            }
+        corrections.append(target_valid[0])
+    ok, reason = verify(inst, corrections)
+    return {
