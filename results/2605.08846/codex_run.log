+            "operations_total": reference_operations,
+            "operations_mean": reference_operations // 8,
+            "gcd_calls_total": reference_gcds,
+            "gcd_calls_mean": reference_gcds // 8,
+            "solves": f"{reference_ok}/8, as expected",
