+    # A genuinely in-context pencil-and-paper guess: treat an odd final digit
+    # as evidence that the accumulated floor error crossed one integer.
+    answer = [-1 if row["N"] % 10 in (1, 3, 7, 9) else 0
+              for row in inst["rows"]]
+    return verify(inst, answer)[0]
