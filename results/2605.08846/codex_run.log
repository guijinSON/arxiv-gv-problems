+DIFFICULTY: dict = {
+    "demo": {"n": 8, "rows": 3, "steps": 2, "q_bits": 5},
+    "easy": {"n": 40, "rows": 24, "steps": 3, "q_bits": 55},
+    "medium": {"n": 64, "rows": 24, "steps": 3, "q_bits": 59},
