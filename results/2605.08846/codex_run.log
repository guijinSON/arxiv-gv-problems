+def _jacobi(a: int, n: int) -> int:
+    """Jacobi symbol (a/n) for positive odd n."""
+    if n <= 0 or n % 2 == 0:
+        raise ValueError("Jacobi denominator must be positive and odd")
+    a %= n
+    result = 1
+    while a:
+        while a % 2 == 0:
+            a //= 2
+            if n % 8 in (3, 5):
+                result = -result
+        a, n = n, a
+        if a % 4 == n % 4 == 3:
+            result = -result
+        a %= n
+    return result if n == 1 else 0
+
