+    "pass": true
+  },
+  "G2_rejects_corruption": {
+    "distinct_reasons": true,
+    "pass": true,
+    "reasons": {
+      "drop": "expected exactly 96 blocks, got 95",
+      "duplicate": "block B1 repeats a point label",
+      "empty": "answer must contain at least one block",
+      "out_of_range": "point label 289 is outside 1..288",
+      "swap": "block B1 is not a projective line"
