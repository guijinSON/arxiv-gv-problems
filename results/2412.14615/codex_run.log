+    "easy": {
+        "n": 8,
+        "bits": 7,
+        "min_degree": 1,
+        "guard_restarts": 0,
+        "guard_nodes": 0,
+    },
+    "medium": {
+        "n": 24,
+        "bits": 9,
+        "min_degree": 2,
+        "guard_restarts": 0,
+        "guard_nodes": 0,
+    },
+    "hard": {
+        "n": 96,
+        "bits": 12,
+        "min_degree": 3,
+        "guard_restarts": 16,
+        "guard_nodes": 25_000,
+    },
+}
+
