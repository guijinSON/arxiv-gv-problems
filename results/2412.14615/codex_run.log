+            for a in range(3):
+                for b in range(3):
+                    trial = [block[:] for block in plant]
+                    trial[i][a], trial[j][b] = trial[j][b], trial[i][a]
+                    if not verify(inst, trial)[0]:
+                        swapped = trial
+                        break
+                if swapped is not None:
