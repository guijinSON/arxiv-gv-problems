+    def count(remaining):
+        nonlocal nodes
+        nodes += 1
+        if nodes > cap:
+            raise OverflowError
+        if remaining == 0:
+            return 1
+        scan = remaining
+        choices = None
+        while scan:
+            bit = scan & -scan
+            point = bit.bit_length() - 1
+            scan ^= bit
+            here = [mask for mask in by_point[point] if mask & remaining == mask]
+            if not here:
+                return 0
+            if choices is None or len(here) < len(choices):
+                choices = here
+                if len(choices) == 1:
