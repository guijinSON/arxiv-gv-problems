+    "easy": {
+        "n": 8,
+        "bits": 7,
+        "min_degree": 1,
+        "guard_restarts": 0,
+        "guard_nodes": 0,
+    },
+    "medium": {
+        "n": 96,
+        "bits": 12,
+        "min_degree": 3,
+        "guard_restarts": 16,
+        "guard_nodes": 25_000,
+    },
+    "hard": {
+        "n": 192,
+        "bits": 14,
+        "min_degree": 3,
+        "guard_restarts": 16,
+        "guard_nodes": 25_000,
+    },
+}
+
