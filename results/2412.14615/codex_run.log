  \end{array}\right)}}
  \quad\text{and}\quad
  {\tiny\arraycolsep=0.3\arraycolsep\ensuremath{\left(\begin{array}{rrrrrrrrrrrrr}
  1 & 0 & 0 & 0 & 0 & 1 & 0 & 1 & 0 & 2 & 2 & 0 & 2 \\
