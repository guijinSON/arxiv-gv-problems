+    }
+
+    preset_spaces = {
+        name: search_space(make_instance(seed=3, **preset_params))
+        for name, preset_params in DIFFICULTY.items()
+    }
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=424242, **doubled_params)
