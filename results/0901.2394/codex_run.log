+            for left, right in zip(names[:-1], names[1:])),
+        "preset_candidate_spaces": preset_spaces,
+        "doubled_n": doubled["n"],
+        "doubled_field_size": doubled["p"],
+        "doubled_verifies": doubled_ok,
