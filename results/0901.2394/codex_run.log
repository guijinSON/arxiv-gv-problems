+    from gvlib import rationals  # noqa: F401 (available; F_p needs no helper)
+except ImportError:
+    rationals = None
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "polynomial",
+    "native_objects": [
