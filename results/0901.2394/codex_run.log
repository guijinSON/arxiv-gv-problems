+    os.path.abspath(__file__)))))
+try:
+    from gvlib import rationals  # noqa: F401 (available; F_p needs no helper)
+except ImportError:
+    rationals = None
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
