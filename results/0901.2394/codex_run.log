+def _attack_answers(inst):
+    p = inst["p"]
+    coefficients = list(inst["h"]) + list(inst["r1"]) + list(inst["c"])
+    outlier = sorted(set(coefficients), key=lambda x: (min(x, p - x), x))
+    return {
