+def _completion_state(inst: dict):
+    """Build domains for a normalized partial Latin square, or return None."""
+    q = inst.get("n")
+    if type(q) is not int or q < 1:
+        return None
+    rows = [set(range(q)) for _ in range(q)]
+    columns = [set(range(q)) for _ in range(q)]
