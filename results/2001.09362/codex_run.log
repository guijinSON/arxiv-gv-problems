import random,time

def puzzle(q,seed,density):
 r=random.Random(seed);rp=list(range(q));cp=list(range(q));sp=list(range(q));r.shuffle(rp);r.shuffle(cp);r.shuffle(sp)
 L=[[sp[(rp[i]+cp[j])%q] for j in range(q)] for i in range(q)]
 clues={}
 for i in range(q):
  for j in range(q):
   if r.random()<density:clues[i,j]=L[i][j]
 return L,clues

def solve(q,clues,cap=2000000):
 g=[[-1]*q for _ in range(q)]; rows=[set(range(q)) for _ in range(q)];cols=[set(range(q)) for _ in range(q)]
 for (i,j),z in clues.items():
  if z not in rows[i] or z not in cols[j]:return False,0
  g[i][j]=z;rows[i].remove(z);cols[j].remove(z)
 nodes=0
 def rec(left):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return False
  if not left:return True
  best=None;dom=None
  for ij in left:
   i,j=ij;d=rows[i]&cols[j]
   if not d:return False
   if dom is None or len(d)<len(dom):best=ij;dom=d
  i,j=best;left.remove(best)
  for z in list(dom):
   g[i][j]=z;rows[i].remove(z);cols[j].remove(z)
   if rec(left):return True
   rows[i].add(z);cols[j].add(z);g[i][j]=-1
  left.add(best);return False
 ok=rec({(i,j) for i in range(q) for j in range(q) if g[i][j]<0});return ok,nodes
for q in [8,10,12,14,16]:
 for den in [.15,.25,.35,.45,.55,.65]:
  vals=[];t=time.time()
  for s in range(8):
   L,c=puzzle(q,100+s,den);ok,k=solve(q,c);vals.append(k)
  print(q,den,min(vals),max(vals),'over',sum(x>2000000 for x in vals),'sec',round(time.time()-t,2),flush=True)
