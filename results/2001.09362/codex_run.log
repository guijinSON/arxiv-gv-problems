import random,time

def latin(q,r):
 L=[];used=[set() for _ in range(q)]
 for i in range(q):
  cols=list(range(q));r.shuffle(cols); mt={}
  pref={c:r.sample([z for z in range(q) if z not in used[c]], q-len(used[c])) for c in cols}
  def aug(c,seen):
   for z in pref[c]:
    if z in seen:continue
    seen.add(z)
    if z not in mt or aug(mt[z],seen):mt[z]=c;return True
   return False
  for c in cols:
   if not aug(c,set()):raise Exception('no match')
  row=[None]*q
  for z,c in mt.items():row[c]=z;used[c].add(z)
  L.append(row)
 return L

def one(q,seed,d):
