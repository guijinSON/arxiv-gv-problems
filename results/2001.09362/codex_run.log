+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = preset_instances.get(SHIPPING_DIFFICULTY) or make_instance(seed=0, **shipping_params)
+
+    # G2: five requested corruptions, each landing on a distinct diagnostic.
