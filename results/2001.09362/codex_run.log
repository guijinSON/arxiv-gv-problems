    38	\title{$S$-packing chromatic vertex-critical graphs}
    39	
    40	\author{P\v{r}emysl Holub$^{a}$\thanks{Email: \texttt{holubpre@kma.zcu.cz}} 
    41	\and Marko Jakovac$^{b,c}$\thanks{Email: \texttt{marko.jakovac@um.si}}
