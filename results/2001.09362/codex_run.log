import random

def gen(n,seed,d):
 r=random.Random(seed); ans=[i%3 for i in range(n)]; r.shuffle(ans)
 p=d/(n-1)*1.5
 ed=[]; adj=[set() for _ in range(n)]
 for u in range(n):
  for v in range(u+1,n):
   if ans[u]"'!=ans[v] and r.random()<p:
    adj[u].add(v);adj[v].add(u);ed.append((u,v))
 return ans,ed,adj

def greedy(adj):
