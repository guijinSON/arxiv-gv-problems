+def _shuffle_rows(inst: dict, rng: random.Random) -> dict:
+    out = {k: v for k, v in inst.items() if k not in {"neighbors", "answer"}}
+    out["neighbors"] = [row[:] for row in inst["neighbors"]]
+    for row in out["neighbors"]:
