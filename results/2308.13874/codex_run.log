import importlib.util, io, json, os, pathlib, contextlib
p=pathlib.Path('gen_2308_13874.py')
buf=io.StringIO()
with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
 s=importlib.util.spec_from_file_location('finalcheck',p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
assert buf.getvalue()==''
rep=json.load(open('selftest_report.json')); assert rep['all_passed']
assert all(v.get('pass') for k,v in rep.items() if k.startswith('G'))
inst=m.make_instance(seed=0,**m.DIFFICULTY[m.SHIPPING_DIFFICULTY])
os.environ.pop('GV_HINT_MODE',None); bare=m.render(inst)
os.environ['GV_HINT_MODE']='structural'; hinted=m.render(inst)
os.environ['GV_HINT_MODE']='placebo'; placebo=m.render(inst)
os.environ.pop('GV_HINT_MODE',None)
assert m.STRUCTURAL_HINT not in bare and m.PLACEBO_HINT not in bare
assert m.STRUCTURAL_HINT in hinted and m.PLACEBO_HINT in placebo
need={'schema_version','model','effort','preset','params','seed','escalation_round','solved','parsed','verify_ok','verify_reason','reply','error','elapsed_sec','http_status','finish_reason'}
for path in ['llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl']:
 rows=[json.loads(x) for x in open(path) if x.strip()]
 assert rows and all(need<=set(x) for x in rows)
meta=json.load(open('.meta.json')); assert meta['harden_verdict']['verdict']=='hardened'
assert meta['harden_verdict']['shipping_params']==m.DIFFICULTY[m.SHIPPING_DIFFICULTY]
print('final validation: ok')
print('shipping:',m.SHIPPING_DIFFICULTY,m.DIFFICULTY[m.SHIPPING_DIFFICULTY])
print('gates:',len([k for k in rep if k.startswith('G')]))
print('oracle:',meta['harden_verdict'])
