import importlib.util
s=importlib.util.spec_from_file_location('g','gen_2308_13874.py'); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
real=m._candidate_random_greedy
m._candidate_random_greedy=lambda rows:(None,0)
hits=0
built=[]
for seed in range(10000,10100):
    inst=m.make_instance(seed=seed, **m.DIFFICULTY['hard'])
