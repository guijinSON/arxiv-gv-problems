+    "hardness_basis": (
+        "Track B: a 1-factor is found by Hopcroft--Karp in O(E sqrt(V)); at "
+        "the shipping preset the measured reference cost is recorded by "
+        "selftest(), while the neighborhood-sum route uses fewer than 300 exact "
+        "operations and the explicit permutation space is n!."
+    ),
+    "max_answer_tokens": 0,  # replaced after the final shipping rung is known
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
