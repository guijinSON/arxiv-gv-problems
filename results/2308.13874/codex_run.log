+        for seed in range(4):
+            inst = make_instance(seed=seed, **DIFFICULTY[preset])
+            ok, _ = verify(inst, inst["answer"])
+            g1_ok &= ok and json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            g1_instances += 1
