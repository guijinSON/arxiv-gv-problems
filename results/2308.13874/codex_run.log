+    invariant_checks = 0
+    real_transform_checks = 0
+    distinct_keys: list[str] = []
+    g8_ok = True
+    for seed in range(20):
+        inst = make_instance(seed=20_000 + seed, **shipping_params)
+        base_key = canonical_key(inst)
