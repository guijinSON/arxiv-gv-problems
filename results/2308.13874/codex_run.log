+    s1 = sum(rows[1]) % n
+    inv_d, euclid_steps = _inverse_with_division_count(d, n)
+    slope = ((s1 - s0) * inv_d) % n
+    value = rows[0][0]
+    answer = [value]
+    for _ in range(1, n):
+        value = (value + slope) % n
+        answer.append(value)
