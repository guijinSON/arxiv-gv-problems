+def _inverse_with_division_count(a: int, modulus: int) -> tuple[int, int]:
+    """Extended Euclid inverse and a conservative division-step count."""
+    old_r, r = a, modulus
+    old_s, s = 1, 0
+    steps = 0
+    while r:
+        q = old_r // r
+        old_r, r = r, old_r - q * r
+        old_s, s = s, old_s - q * s
+        steps += 1
+    if old_r != 1:
+        raise ValueError("noninvertible degree")
