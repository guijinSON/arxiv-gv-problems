\begin{theorem}\label{thm:izo}
Let $n\in \mathbb{N}$, $(G,+,0)$ be an abelian group and $\alpha\in\aut{G}$ be of an order dividing~$n$.

Let $(B,+,\circ)=(G\times \Z_n,+,\circ)$  be the $\alpha$-semidirect product of trivial braces constructed in Example \ref{exm:unisol}. 
Let~$X$ be a transitive cycle base of~$B$ and let
 $(g,h)\in X$.
 Then the solution $(G\times \Z_n, \sigma,\tau)$ described in Example \ref{exm:unisol}, with \[
\sigma_{(a,i)}((b,j))=(\alpha^{-h}(b)-\alpha^{i-h}(g),j-h),
\]
for $(a,i),(b,j)\in G\times \Z_n$,
is isomorphic to the solution $\mathcal{S}(G\times \Z_n,{\bf c},f)$, for ${\bf c}=(c_i)=(-\alpha^{-(i+1)h}(g))\in G^n$ and $f=\alpha^{-h}$. 

\end{theorem}

\begin{proof}
By definition for the solution $\mathcal{S}(G\times \Z_n,{\bf c},\alpha^{-h})$ with ${\bf c}=(c_i)=(-\alpha^{-(i+1)h}(g))\in G^n$ 
we have
$$c_{i,j}=\alpha^{-jh}(c_{i-j}-c_{-j})=$$
$$\alpha^{-jh}(-\alpha^{-(i-j+1)h}(g)+\alpha^{-(1-j)h}(g))=
-\alpha^{-ih-h}(g)+\alpha^{-h}(g)=$$
$$\alpha^{-h}(g-\alpha^{-ih}(g)),
$$
for all $i,j$. 
Hence,

\[ \sigma_{(a,i)}((b,j))=(\alpha^{-h}(b)+\alpha^{-h}(g-\alpha^{-ih}(g)),j+1).\]
Let $\Phi:G\times \Z_n\to G\times \Z_n$ be
\[ \Phi((a,i))=(a-\sum_{k=1}^i\alpha^{-kh}(g),-i\cdot h).\]
First note that the mapping $\Phi$ is well defined. Let $(a,i), (a,i')\in G\times \Z$, where $i\equiv i' (\mod n)$. Without loss of generality we can assume that $i'=i+n$. Then 
by Lemma \ref{lem:sum} we obtain:
\begin{align*}
& \Phi((a,i'))=(a-\sum_{k=1}^{n+i}\alpha^{-kh}(g),-(n+i)\cdot h)=(a-\sum_{k=1}^{n+i}\alpha^{-kh}(g),-(n+i)\cdot h)=\\
 &(a-\sum_{k=1}^{n}\alpha^{-kh}(g)-\sum_{k=n+1}^{n+i}\alpha^{-kh}(g),-i\cdot h)=(a-\sum_{k=n+1}^{n+i}\alpha^{-kh}(g),-i\cdot h)=\\
 &(a-\sum_{k=1}^{i}\alpha^{-(k+n)h}(g),-i\cdot h)=
 (a-\sum_{k=1}^{i}\alpha^{-kh}(g),-i\cdot h)=\Phi((a,i)),
 \end{align*}
 since the order of $\alpha$ divides~$n$.

We shall prove that $\Phi$ is a~homomorphism of the solutions:
\begin{multline*}
 \Phi(\sigma_{(a,i)}((b,j))) =
 \Phi( (\alpha^{-h}(b)+\alpha^{-h}(g)-\alpha^{-(i+1)h}(g),j+1))=\\
 (\alpha^{-h}(b)+\alpha^{-h}(g)-\alpha^{-(i+1)h}(g)-\sum_{k=1}^{j+1}\alpha^{-hk}(g),-(j+1)\cdot h)
 =\\
 (\alpha^{-h}(b-\alpha^{-hi}(g))-\sum_{k=2}^{j+1}\alpha^{-hk}(g),-j\cdot h-h)
\end{multline*}
and
\begin{multline*}
 \sigma_{\Phi((a,i))}(\Phi((b,j)))=\sigma_{(a-\sum_{k=1}^i\alpha^{-hk}(g),-i\cdot h)}(b-\sum_{k=1}^j\alpha^{-hk}(g),-j\cdot h)=\\
 (\alpha^{-h}(b)-\sum_{k=2}^{j+1} \alpha^{-hk}(g)-\alpha^{-(i+1)h}(g),-j\cdot h-h) =(\alpha^{-h}(b-\alpha^{-hi}(g))-\sum_{k=2}^{j+1}\alpha^{-kh}(g),-j\cdot h-h).
\end{multline*}
Since the element~$h$ is a generator of~$\Z_n$, the mapping $\Phi$ is a bijection and therefore an isomorphism.
%If~$h$ is not a homomorphism than it can be somehow solved but this case is of little interest.
\end{proof}

