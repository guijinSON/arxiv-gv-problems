    answer_chars = len(compact_answer)
    answer_tokens = math.ceil(answer_chars / 4)
    worst_chars = _worst_answer_chars(shipping["d"], shipping["p"])
    worst_tokens = math.ceil(worst_chars / 4)
    arms = {
        key: dict(G9_ORACLE_RESULTS[key])
