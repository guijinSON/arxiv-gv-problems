+    pd = _mat_mul(perm_matrix, diagonal, p)
+    ds = _mat_mul(diagonal, shear, p)
+    pds = _mat_mul(pd, shear, p)
+    return [perm_matrix, diagonal, shear, pd, ds, pds]
