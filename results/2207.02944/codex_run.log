+    # G8: generators of GL(d,p), their compositions, and side reversal.
+    invariant = 0
+    real = 0
+    keys = []
+    for seed in range(20):
+        inst = make_instance(seed=9000 + seed, **shipping_params)
+        original_key = canonical_key(inst)
+        keys.append(original_key)
