+def _corruptions(inst):
+    answer = inst["answer"]
+    u, v = answer["u"], answer["v"]
+    duplicated = list(v)
+    duplicated[-1] = duplicated[-2]
+    return {
+        "drop": {"u": u[:-1], "v": list(v)},
+        "swap": {"u": list(v), "v": list(u)},
+        "duplicate": {"u": list(u), "v": duplicated},
+        "empty": {},
+        "out_of_range": {"u": list(u), "v": list(v[:-1]) + [inst["p"]]},
+    }
+
