+                continue
+            change = (u[free]
+                      - u[pivot] * source[free]
+                      * pow(source[pivot], -1, p)) % p
+            if change:
+                v[free] = (v[free] + 1) % p
+                solve_pivot()
+                break
+        else:
+            raise ValueError("first equation is dependent on determinant constraint")
+    return {"u": u, "v": v}
