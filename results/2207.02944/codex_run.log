+def _dot(a, b, p):
+    return sum(x * y for x, y in zip(a, b)) % p
+
+
+def _vadd(a, b, p):
+    return [(x + y) % p for x, y in zip(a, b)]
+
+
+def _vsub(a, b, p):
+    return [(x - y) % p for x, y in zip(a, b)]
+
+
+def _vscale(s, a, p):
+    return [(s * x) % p for x in a]
