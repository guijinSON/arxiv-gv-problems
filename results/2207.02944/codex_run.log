+    reference_times = []
+    baseline_time = 0.0
+    for seed in range(8):
+        inst = make_instance(seed=7000 + seed, **shipping_params)
+        for name, attack in attack_functions.items():
+            start = time.perf_counter()
+            candidate = attack(inst)
