+def _solution_r(sequence, p, x, y):
+    """Evaluate the paper's r map exactly on two encoded elements of X."""
+    m = len(sequence)
+    a, i = x
+    b, j = y
+    sigma = (
+        tuple(_vadd(
+            b,
+            _vsub(sequence[(i - j - 1) % m], sequence[(-j - 1) % m], p),
+            p,
+        )),
+        (j + 1) % m,
+    )
+    tau = (
+        tuple(_vsub(
+            a,
+            _vsub(sequence[(j - i + 1) % m], sequence[(-i) % m], p),
+            p,
+        )),
+        (i - 1) % m,
+    )
+    return sigma, tau
+
