+    inversions = 0
+    for col in range(n):
+        pivot = next((r for r in range(col, n) if aug[r][col] % p), None)
+        if pivot is None:
+            raise ValueError("singular matrix")
+        if pivot != col:
+            aug[col], aug[pivot] = aug[pivot], aug[col]
+        inv = pow(aug[col][col], -1, p)
+        inversions += 1
+        for j in range(col, n + 1):
+            aug[col][j] = aug[col][j] * inv % p
+            operations += 1
