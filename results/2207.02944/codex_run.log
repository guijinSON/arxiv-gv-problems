+def _transform_basis(inst, matrix):
+    d, p = inst["d"], inst["p"]
+    inverse = _matrix_inverse(matrix, p)
+    inverse_transpose = _transpose(inverse)
+    source = [_mat_vec(matrix, vector, p)
+              for vector in inst["source_sequence"]]
+    target = [_mat_vec(matrix, vector, p)
