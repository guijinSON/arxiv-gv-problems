+            "complexity": "O(d^3 + md) exact field operations",
+            "wall_clock_sec": round(avg_reference_time, 6),
+            "operations": avg_ops,
+            "inversions": avg_inversions,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+        "intended_compact_route": {
