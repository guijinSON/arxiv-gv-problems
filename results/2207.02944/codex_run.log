\begin{proposition}\label{prop:d}
The permutation group $\mathcal{G}(X)$ is abelian if and only if $c_{i\bmod n}=i\cdot c_1$, for all $i\in\Z$.
\end{proposition}

\begin{proof}
Taking in \eqref{piLx}, $\widetilde 0=(0,0)$, we directly obtain
\begin{align}\label{eq:Lpi}
\pi L_{(a,i)}\pi^{-1}= L_{\pi((0,0))}^{-1}L_{\pi((a,i))}=L_{(0,1)}^{-1}L_{(a,i+1)}%=L_{(\cz{0},1)}^{-1}L_{(a,i+1)},
\end{align}
for $a\in G$ and $i\in\Z_n$.

Recall that the abelian group $\dis{X}$ is generated by the set $\{L_{(0,i)} \mid i\in\Z_n\}$. Then by \eqref{eq:Lpi}, the group  $\mathcal{G}(X)$ is abelian if and only if for every $(b,j)\in G\times \Z_n$ and all~$i\in\Z_n$
$$L_{(0,i)}((b,j))= L_{(0,i+1)}L_{(0,1)}^{-1}((b,j)).$$ 
This is equivalent
to, for all $i,j\in\Z_n$, 
\begin{align*}
c_{i+1,j}=c_{i,j}+c_{1,j}.
\end{align*}
This condition 
%forces
%\begin{align*}
%$f^j(c_{i+1-j}-c_{-j})=f^j(c_{i-j}-c_{-j})+f^j(c_{1-j}-c_{-j})$,
%\end{align*}
%which 
is equivalent to
%\begin{align*}
$c_{i+1-j}=c_{i-j}+c_{1-j}-c_{-j}$,
 %\end{align*}
 for all $i,j\in\Z_n$.
%If there exists $j\in\Z_n$, such that $f(d_j)\neq d_{j+1}$, then
%\[c_{2,j+1}=d_{j+1}+f(d_j)\neq d_{j+1} + d_{j+1}=c_{1,j+1}+c_{1,j+1}\]
%and the group $\mathcal{G}(X)$ is not abelian. 
In particular, for $j=0$, we obtain $c_{i+1}=c_i+c_1$, which, by an easy induction, implies $c_{i\mod n}=i\cdot c_1$, for $i\in \Z$.
On the other hand, $c_{i\mod n}=i\cdot c_1$ implies $c_{i+1-j}+c_{-j}=c_{i-j}+c_{1-j}$ for $i,j\in \Z_n$.
\end{proof}
Note that by Proposition \ref{prop:d}, for a solution $\mathcal{S}(G\times \Z_n,{\bf c})$ with abelian permutation group, the group $(G,+,0)$ is cyclic. In a finite case, such solution with ${\bf c}=(c_i)_{i\in \Z_n}=(i)_{i\in \Z_n}$
% and $f=\id$ 
overlaps with the solution $\mathcal{C}(m,n,0)$ described in \cite[Theorem 3.1]{JPZ21}.

