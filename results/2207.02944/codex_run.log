+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 2, "p": 7, "extra": 1},
+    "easy": {"n": 16, "p": 65_537, "extra": 12},
+    "medium": {"n": 20, "p": 1_000_003, "extra": 24},
