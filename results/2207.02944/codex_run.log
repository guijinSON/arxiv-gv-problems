+def _swap_sides(inst):
+    p = inst["p"]
+    u, v = inst["answer"]["u"], inst["answer"]["v"]
+    denominator = (1 + _dot(v, u, p)) % p
+    inverse_v = _vscale((-pow(denominator, -1, p)) % p, v, p)
