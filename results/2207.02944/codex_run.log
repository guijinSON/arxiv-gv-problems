+        # exists that changes u dot v.  Move one free coordinate by one and
+        # re-solve the pivot; the formerly zero determinant becomes nonzero.
+        for free in range(d):
+            if free == pivot:
+                continue
+            change = (u[free]
+                      - u[pivot] * source[free]
+                      * pow(source[pivot], -1, p)) % p
+            if change:
+                v[free] = (v[free] + 1) % p
