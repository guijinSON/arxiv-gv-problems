## Caveats

- This is emphatically Track B.  Python, a CAS, or any finite-field linear-algebra package solves it almost instantly; it is not evidence that Yang--Baxter isomorphism is computationally hard.
- The external hardening and both G9 comparison arms are missing because the supplied OpenRouter key exhausted its total limit.  Local gates do not substitute for that evidence.
- The rank-one frame is benchmark-side structure, not a claim that arbitrary sequences in Theorem 4.1 have this form.  The paper's native sequences, solutions, and isomorphism criterion remain present and are checked exactly.
- G4 is uniform over the exact normalized rank-one certificate language.  Its tiny density says nothing about informed algebraic guesses; G6 only samples five such cheap attacks.
- The outlier, diagonal, identity-frame, one-equation, and 256-restart attacks were tried.  General CAS elimination, optimized low-rank factorization, and arbitrary symbolic solvers were not counted as attacks because they are expected to succeed; exact Gauss--Jordan is the disclosed reference.
- Large coefficients add a real exact-arithmetic burden.  Until the three G9 arms run, it is unknown how much observed model difficulty comes from discovering rank one versus executing modular arithmetic.
- The standard library is sufficient.  `gvlib` is not needed because all native objects here are vectors over a prime field rather than rationals or polynomial certificates.
    for pivot in range(d):
        block = p ** (d - pivot - 1)
        if ticket < block:
            tail = [0] * (d - pivot - 1)
            value = ticket
            for j in range(len(tail) - 1, -1, -1):
                value, tail[j] = divmod(value, p)
            return [0] * pivot + [1] + tail
        ticket -= block
    raise AssertionError("projective sampler exhausted its exact range")


def _sample_valid_v(
    u, p, rng, *, avoid_normalized=False, avoid_last_equal=False
):
    d = len(u)
    population = p ** d
    while True:
        ticket = rng.randrange(population)
        v = [0] * d
        for i in range(d - 1, -1, -1):
            ticket, v[i] = divmod(ticket, p)
        if not any(v) or (1 + _dot(v, u, p)) % p == 0:
            continue
        if avoid_normalized:
            pivot = _first_nonzero(v)
            if pivot is not None and v[pivot] == 1:
                continue
        if avoid_last_equal and d > 1 and v[-1] == v[-2]:
            continue
        return v


def _is_arithmetic_sequence(sequence, p):
    if not sequence:
        return False
    first = sequence[1] if len(sequence) > 1 else sequence[0]
    return all(vector == _vscale(i, first, p)
               for i, vector in enumerate(sequence))


def make_instance(n, seed=0, **params):
    """Inverse-generate an isomorphism and build both solutions around it."""
    if isinstance(n, bool) or not isinstance(n, int) or n < 2:
        raise ValueError("n must be an integer at least 2")
    p = params.pop("p", 2_147_483_647)
    return {"u": u, "v": v}, operations + d * d + d, inversions + 1


def _compact_solve(inst):
    """The intended double-rank-one route, used only to audit its claim."""
    d, p = inst["d"], inst["p"]
    source, target = inst["source_sequence"], inst["target_sequence"]

    first_difference = _vsub(target[1], source[1], p)
    u = _normalize_projective(first_difference, p)
    if u is None:
        raise ValueError("compact frame promise was not met")
    pivot_u = _first_nonzero(u)
    scalars = [
        (target[i][pivot_u] - source[i][pivot_u]) % p
        for i in range(1, d + 1)
    ]

    # The first frame deviation is nonzero by construction.  Once it is
    # normalized to a, each scalar b_i is read from a single pivot coordinate
    # of c[i+1]-e_i; expanding all d full deviation vectors would turn this
    # compact route into an unnecessary quadratic calculation.
    first_dev = _vsub(source[1], _basis(d, 0), p)
    a = _normalize_projective(first_dev, p)
    if a is None:
        raise ValueError("compact source-frame promise was not met")
    pivot_a = _first_nonzero(a)
    b = [
        (source[i + 1][pivot_a] - (1 if i == pivot_a else 0)) % p
        for i in range(d)
    ]
    denominator = (1 + _dot(a, b, p)) % p
    correction = _dot(a, scalars, p) * pow(denominator, -1, p) % p
    v = [(s - b_i * correction) % p for s, b_i in zip(scalars, b)]
    return {"u": u, "v": v}


def _make_valid_attack_candidate(u, v, p):
    """Keep attacks inside the obvious certificate constraints."""
    u = _normalize_projective([x % p for x in u], p)
    if u is None:
        u = [1] + [0] * (len(v) - 1)
    v = [x % p for x in v]
    if not any(v):
        v[0] = 1
    if (1 + _dot(v, u, p)) % p == 0:
        for i in range(len(v) - 1, -1, -1):
            original = v[i]
            v[i] = (v[i] + 1) % p
            if any(v) and (1 + _dot(v, u, p)) % p:
                break

def escalate(params):
    """Raise coefficient entropy and decoy count before lengthening the answer."""
    harder = dict(params)
    p = harder.get("p", 2_147_483_647)
    extra = harder.get("extra", max(1, harder["n"] // 2))
    if p < 2_147_483_647:
        harder["p"] = 2_147_483_647
        harder["extra"] = max(extra, harder["n"] * 2)
        return harder
    if p < _MERSENNE_61:
        harder["p"] = _MERSENNE_61
        harder["extra"] = max(extra, harder["n"] * 3)
        return harder
    if extra < harder["n"] * 12:
        harder["extra"] = min(harder["n"] * 12, max(extra + 1, extra * 2))
        return harder
    # The fixed-length entropy and haystack axes are exhausted.  Increasing d
    # would still remain below the answer cap for a while, so this is not a cap.
    # d=24 already costs 12*d+3 = 291 exact operations by the compact route.
    # Raising the dimension would violate G9's 300-operation cap, and the two
    # useful fixed-answer-length axes above are now exhausted.
    return None


def _answer_atoms(answer):
    if isinstance(answer, dict):
        return sum(_answer_atoms(value) for value in answer.values())
    if isinstance(answer, list):
        return sum(_answer_atoms(value) for value in answer)
    return 1


def _worst_answer_chars(d, p):
    answer = {"u": [p - 1] * d, "v": [p - 1] * d}
    return len(json.dumps(answer, separators=(",", ":")))


def _corruptions(inst):
    answer = inst["answer"]
    u, v = answer["u"], answer["v"]
    duplicated = list(v)
    duplicated[-1] = duplicated[-2]
    return {
        "drop": {"u": u[:-1], "v": list(v)},
        "swap": {"u": list(v), "v": list(u)},
        "duplicate": {"u": list(u), "v": duplicated},
        "empty": {},
        "out_of_range": {"u": list(u), "v": list(v[:-1]) + [inst["p"]]},
    }


def selftest():
    report = {}

    # G1: every named level, three independent seeds, plus field and JSON checks.
    failures = []
    attempts = 0
    for preset, params in DIFFICULTY.items():
        if not _is_prime_64(params["p"]):
            failures.append(f"{preset}: modulus is not prime")
