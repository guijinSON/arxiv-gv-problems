+    v = [(proposal[i] if i < len(proposal) else 0) % p for i in range(d)]
+
+    def solve_pivot():
+        remainder = sum(source[i] * v[i] for i in range(d) if i != pivot) % p
+        v[pivot] = (scalar - remainder) * pow(source[pivot], -1, p) % p
