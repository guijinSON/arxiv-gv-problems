+def _condition_on_first_equation(inst, proposal):
+    """Project a proposed v onto its obvious affine constraint, preserving shape."""
+    d, p = inst["d"], inst["p"]
+    u, scalar = _forced_mapping_data(inst)
+    source = inst["source_sequence"][1]
