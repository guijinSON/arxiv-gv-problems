+    pivot = _first_nonzero(u_raw)
+    scale = u_raw[pivot]
+    u = _vscale(pow(scale, -1, p), u_raw, p)
+    v_raw = _mat_vec(inverse_transpose, inst["answer"]["v"], p)
+    v = _vscale(scale, v_raw, p)
