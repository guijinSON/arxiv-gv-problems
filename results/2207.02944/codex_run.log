+def _forced_mapping_data(inst):
+    """The normalized image direction and scalar forced by index 1."""
+    p = inst["p"]
+    delta = _vsub(inst["target_sequence"][1], inst["source_sequence"][1], p)
+    u = _normalize_projective(delta, p)
