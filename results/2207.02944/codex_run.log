+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+_MERSENNE_61 = 2_305_843_009_213_693_951
+_KNOWN_PRIMES = {7, 65_537, 1_000_003, 2_147_483_647, _MERSENNE_61}
