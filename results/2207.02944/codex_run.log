\begin{theorem}\label{thm:izo}
Let $n\in \mathbb{N}$, $(G,+,0)$ be an abelian group and $\alpha\in\aut{G}$ be of an order dividing~$n$.

Let $(B,+,\circ)=(G\times \Z_n,+,\circ)$  be the $\alpha$-semidirect product of trivial braces constructed in Example \ref{exm:unisol}. 
Let~$X$ be a transitive cycle base of~$B$ and let
 $(g,h)\in X$.
 Then the solution $(G\times \Z_n, \sigma,\tau)$ described in Example \ref{exm:unisol}, with \[
\sigma_{(a,i)}((b,j))=(\alpha^{-h}(b)-\alpha^{i-h}(g),j-h),
\]
for $(a,i),(b,j)\in G\times \Z_n$,
is isomorphic to the solution $\mathcal{S}(G\times \Z_n,{\bf c},f)$, for ${\bf c}=(c_i)=(-\alpha^{-(i+1)h}(g))\in G^n$ and $f=\alpha^{-h}$. 

\end{theorem}

\begin{proof}
By definition for the solution $\mathcal{S}(G\times \Z_n,{\bf c},\alpha^{-h})$ with ${\bf c}=(c_i)=(-\alpha^{-(i+1)h}(g))\in G^n$ 
we have
$$c_{i,j}=\alpha^{-jh}(c_{i-j}-c_{-j})=$$
$$\alpha^{-jh}(-\alpha^{-(i-j+1)h}(g)+\alpha^{-(1-j)h}(g))=
-\alpha^{-ih-h}(g)+\alpha^{-h}(g)=$$
$$\alpha^{-h}(g-\alpha^{-ih}(g)),
$$
for all $i,j$. 
Hence,

\[ \sigma_{(a,i)}((b,j))=(\alpha^{-h}(b)+\alpha^{-h}(g-\alpha^{-ih}(g)),j+1).\]
Let $\Phi:G\times \Z_n\to G\times \Z_n$ be
\[ \Phi((a,i))=(a-\sum_{k=1}^i\alpha^{-kh}(g),-i\cdot h).\]
First note that the mapping $\Phi$ is well defined. Let $(a,i), (a,i')\in G\times \Z$, where $i\equiv i' (\mod n)$. Without loss of generality we can assume that $i'=i+n$. Then 
by Lemma \ref{lem:sum} we obtain:
\begin{align*}
& \Phi((a,i'))=(a-\sum_{k=1}^{n+i}\alpha^{-kh}(g),-(n+i)\cdot h)=(a-\sum_{k=1}^{n+i}\alpha^{-kh}(g),-(n+i)\cdot h)=\\
 &(a-\sum_{k=1}^{n}\alpha^{-kh}(g)-\sum_{k=n+1}^{n+i}\alpha^{-kh}(g),-i\cdot h)=(a-\sum_{k=n+1}^{n+i}\alpha^{-kh}(g),-i\cdot h)=\\
 &(a-\sum_{k=1}^{i}\alpha^{-(k+n)h}(g),-i\cdot h)=
 (a-\sum_{k=1}^{i}\alpha^{-kh}(g),-i\cdot h)=\Phi((a,i)),
 \end{align*}
 since the order of $\alpha$ divides~$n$.

We shall prove that $\Phi$ is a~homomorphism of the solutions:
\begin{multline*}
 \Phi(\sigma_{(a,i)}((b,j))) =
 \Phi( (\alpha^{-h}(b)+\alpha^{-h}(g)-\alpha^{-(i+1)h}(g),j+1))=\\
 (\alpha^{-h}(b)+\alpha^{-h}(g)-\alpha^{-(i+1)h}(g)-\sum_{k=1}^{j+1}\alpha^{-hk}(g),-(j+1)\cdot h)
 =\\
 (\alpha^{-h}(b-\alpha^{-hi}(g))-\sum_{k=2}^{j+1}\alpha^{-hk}(g),-j\cdot h-h)
\end{multline*}
and
\begin{multline*}
 \sigma_{\Phi((a,i))}(\Phi((b,j)))=\sigma_{(a-\sum_{k=1}^i\alpha^{-hk}(g),-i\cdot h)}(b-\sum_{k=1}^j\alpha^{-hk}(g),-j\cdot h)=\\
 (\alpha^{-h}(b)-\sum_{k=2}^{j+1} \alpha^{-hk}(g)-\alpha^{-(i+1)h}(g),-j\cdot h-h) =(\alpha^{-h}(b-\alpha^{-hi}(g))-\sum_{k=2}^{j+1}\alpha^{-kh}(g),-j\cdot h-h).
\end{multline*}
Since the element~$h$ is a generator of~$\Z_n$, the mapping $\Phi$ is a bijection and therefore an isomorphism.
%If~$h$ is not a homomorphism than it can be somehow solved but this case is of little interest.
\end{proof}

$\Z_2\times \Z_2\times \Z_3$ has 12 elements, for the sake of simplicity
we shall give them the following names:
\begin{align*}
 \mathbf{a}&=((0,0),0) & \mathbf{e}&=((0,0),1) & \mathbf{i}&=((0,0),2) \\
 \mathbf{b}&=((1,0),0) & \mathbf{f}&=((1,0),1) & \mathbf{j}&=((1,0),2) \\
 \mathbf{c}&=((0,1),0) & \mathbf{g}&=((0,1),1) & \mathbf{k}&=((0,1),2) \\
 \mathbf{d}&=((1,1),0) & \mathbf{h}&=((1,1),1) & \mathbf{l}&=((1,1),2) 
\end{align*}

Then the permutation group  $\mathcal{G}(\Z_2\times \Z_2\times \Z_3)\cong(\Z_2\times \Z_2)\rtimes \Z_3$ has also 12 elements. There are the following ones:
\begin{align*}
\sigma_{\mathbf{a}}=\sigma_{\mathbf{b}}=\sigma_{\mathbf{c}}=\sigma_{\mathbf{d}}&=
 (\mathbf{a},\mathbf{l},\mathbf{f})(\mathbf{e},\mathbf{d},\mathbf{j})(\mathbf{i},\mathbf{h},\mathbf{b})(\mathbf{c},\mathbf{j},\mathbf{f}),\\
\sigma_{\mathbf{e}}=\sigma_{\mathbf{f}}=\sigma_{\mathbf{g}}=\sigma_{\mathbf{h}}&=
 (\mathbf{a},\mathbf{j},\mathbf{g})(\mathbf{b},\mathbf{k},\mathbf{e})(\mathbf{c},\mathbf{i},\mathbf{f})(\mathbf{d},\mathbf{l},\mathbf{h}),\\
\sigma_{\mathbf{i}}=\sigma_{\mathbf{j}}=\sigma_{\mathbf{k}}=\sigma_{\mathbf{l}}&=
 (\mathbf{a},\mathbf{k},\mathbf{h})(\mathbf{b},\mathbf{j},\mathbf{f})(\mathbf{c},\mathbf{l},\mathbf{e})(\mathbf{d},\mathbf{i},\mathbf{h})
\end{align*}
and their inverses. Moreover:
\begin{align*}
\sigma_{\mathbf{a}}\sigma^{-1}_{\mathbf{a}}&=\id\\
\sigma_{\mathbf{e}}\sigma^{-1}_{\mathbf{a}}&=(\mathbf{a},\mathbf{c})(\mathbf{b},\mathbf{d})(\mathbf{e},\mathbf{g})(\mathbf{f},\mathbf{h})(\mathbf{i},\mathbf{k})(\mathbf{j},\mathbf{l}),\\
\sigma_{\mathbf{i}}\sigma^{-1}_{\mathbf{a}}&=
({\mathbf{a}},{\mathbf{b}})({\mathbf{c}},{\mathbf{d}})({\mathbf{e}},{\mathbf{f}})({\mathbf{g}},{\mathbf{h}})({\mathbf{i}},{\mathbf{j}})({\mathbf{k}},{\mathbf{l}}),\\
\sigma_{\mathbf{e}}\sigma^{-1}_{\mathbf{a}}\sigma_{\mathbf{i}}\sigma^{-1}_{\mathbf{a}}&=
(\mathbf{a},\mathbf{d})(\mathbf{b},\mathbf{c})(\mathbf{e},\mathbf{h})(\mathbf{f},\mathbf{g})(\mathbf{i},\mathbf{l})(\mathbf{j},\mathbf{k}),\\
\sigma_{\mathbf{e}}\sigma^{-1}_{\mathbf{a}}\sigma_{\mathbf{i}}&=(\mathbf{a},\mathbf{i},\mathbf{e})(\mathbf{b},\mathbf{l},\mathbf{g})(\mathbf{c},\mathbf{j},\mathbf{h})(\mathbf{d},\mathbf{k},\mathbf{f}),\\
\sigma_{\mathbf{i}}\sigma_{\mathbf{a}}&=
(\mathbf{a},\mathbf{e},\mathbf{i})(\mathbf{b},\mathbf{g},\mathbf{l})(\mathbf{c},\mathbf{h},\mathbf{j})(\mathbf{d},\mathbf{f},\mathbf{k}).
\end{align*}
Note that all permutations $\sigma_x$ are composed of cycles of length $3$. We have also that the subgroup $(\{\id, \sigma_{\mathbf{e}}\sigma^{-1}_{\mathbf{a}},\sigma_{\mathbf{i}}\sigma^{-1}_{\mathbf{a}},\sigma_{\mathbf{e}}\sigma^{-1}_{\mathbf{a}}\sigma_{\mathbf{i}}\sigma^{-1}_{\mathbf{a}}\},\circ)$ is isomorphic to the group $\Z_2\times \Z_2$ and $\langle\sigma_{\mathbf{a}}\rangle\cong \Z_3$.

We can see that for no automorphism $\beta\in\aut{G}$ of order $2$ 
there exists an element $(g,h)\in  \Z_2\times \Z_2\times \Z_3$ such that the set  $\{(\beta^i(g),h)\mid i\in\Z_3\}=\{(g,h), (\beta(g),h)\}$ generates the group $\Z_2\times \Z_2\times \Z_3$.

\begin{lemma}\label{lem:sum}
Let $(B,+,\circ)=(G\times \Z_n,+,\circ)$  be the $\alpha$-semidirect product of trivial braces constructed in Example \ref{exm:unisol}. 
Let~$X$ be a transitive cycle base of~$B$ and let
 $(g,h)\in X$. Then
 \[ \sum_{i=1}^n \alpha^i(a)=0, \qquad\text{for all a}\in G.\]
\end{lemma}

\begin{proof}
Let us define two mappings on the set $G$: $\beta(x)=\sum_{i=1}^{n} \alpha^i(x)$ and $\gamma(x)=\alpha(x)-x$. Both $\beta$ and $\gamma$ are endomorphisms of~$(G,+,0)$, $\alpha\gamma=\gamma\alpha$ and
\[\beta\gamma(x)=(\sum_{i=1}^{n} \alpha^i) (\alpha-1) (x)=(\sum_{i=0}^{n-1} \alpha^i) (\alpha-1)(x) =\alpha^n(x)-x=0.\]
We shall prove that $\gamma$ is an epimorphism and this will imply that $\beta$ is the zero endomorphism.

Let us define the following subset of~$B=G\times \Z_n$:
\[S=\{ ( s\cdot g+\gamma(c),s\cdot h) \mid s\in\Z \text{ and }c\in G\}.\]
Clearly, $S$ is a subgroup of the additive group of the brace $(B,+, \circ)$. In fact it is also a subgroup of its adjoint group. To show this it is sufficient to notice that if $(a,j)\in S$ then $(\alpha(a),j)\in S$, for all~$a\in G$ and $j\in \Z_n$. Let $(a,j)\in S$. Then there are $s\in \Z$ and $c\in G$ such that $(a,j)=(s\cdot g+\gamma(c),s\cdot h)$. Hence
\begin{multline*}
(\alpha(a),j)=(\alpha(s\cdot g+\gamma(c)),s\cdot h)=(s\cdot\alpha(g)+\alpha(\gamma(c)),s\cdot h)=\\
=(s\cdot\alpha(g)-s\cdot g+s\cdot g+\gamma(\alpha(c)),s\cdot h)=( s\cdot g+\gamma(s\cdot g+\alpha(c)),s\cdot h).
\end{multline*}
From this, it is now easy to see that $S$ is a subbrace of~$(B,+,\circ)$. Moreover, $S$ contains $(g,h)$ as well as the entire $\lambda$-orbit of~$(g,h)$. Hence~$S=B$ and $\gamma$ is onto. Therefore
$\beta$ is the zero endomorphism.
\end{proof}

