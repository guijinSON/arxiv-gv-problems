+        for forbidden in block["forbidden"]:
+            for position, variable in enumerate(block["vars"]):
+                forbidden[position] = (forbidden[position] + shifts[variable]) % 3
+        block["forbidden_mask"] = _forbidden_mask(block["forbidden"])
+    transformed["answer"] = [
