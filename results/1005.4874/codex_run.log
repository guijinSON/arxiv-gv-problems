+def _attack_sequential_greedy(inst):
+    answer = [-1] * inst["n"]
+    for variable in range(inst["n"]):
+        best = None
+        for color in range(3):
+            answer[variable] = color
+            violations = 0
+            for block in inst["blocks"]:
