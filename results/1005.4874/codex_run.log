print(json.dumps({'fresh_G1_checks':checks,'report_all_passed':report['all_passed'],'shipping_answer_chars':len(json.dumps(a['answer'],separators=(',',':'))),'shipping_render_chars':len(g.render(a)),'transcript_rows':[4,4,4]}))
