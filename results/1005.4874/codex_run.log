import importlib.util,json,os,random
s=importlib.util.spec_from_file_location('g','gen_1005_4874.py'); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
assert g.TRACK in ('A','B')
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.SHIPPING_DIFFICULTY"'!='"'demo'
checks=0
for name,p in g.DIFFICULTY.items():
 for seed in range(3):
  i=g.make_instance(seed=seed,**p); assert g.verify(i,i['answer'])==(True,'ok'); assert json.loads(json.dumps(i['answer']))==i['answer']; checks+=1
p=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
a=g.make_instance(seed=4242,**p); b=g.make_instance(seed=4242,**p); c=g.make_instance(seed=4243,**p)
assert g.canonical_key(a)==g.canonical_key(b)"'!=g.canonical_key(c)
blob=json.dumps(a['"'answer']); assert g.parse_answer('prose <answer>'+blob+'</answer> tail')==a['answer']
assert os.environ.get('GV_HINT_MODE') is None
assert g.STRUCTURAL_HINT not in g.render(a) and g.PLACEBO_HINT not in g.render(a)
report=json.load(open('selftest_report.json')); assert report['all_passed'] is True
for pth in ('llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl'):
