+def escalate(params):
+    harder = dict(params)
+    d_min = harder.get("d_min", 1201)
+    d_span = harder.get("d_span", 401)
+    harder["d_min"] = 2 * d_min + 1
+    harder["d_span"] = 2 * d_span
+    return harder
