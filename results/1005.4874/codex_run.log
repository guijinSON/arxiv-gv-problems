+        matrix[pivot_row], matrix[found] = matrix[found], matrix[pivot_row]
+        if matrix[pivot_row][column] == 2:
+            for j in range(column, n + 1):
+                matrix[pivot_row][j] = 2 * matrix[pivot_row][j] % 3
+                operations += 2
