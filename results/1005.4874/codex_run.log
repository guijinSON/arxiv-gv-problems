+def canonical_key(inst):
+    n = inst["n"]
+    incidence = [[0, 0] for _ in range(n)]
+    pair_counts = {}
+    arities = []
+    for block in inst["blocks"]:
+        arity = len(block["vars"])
+        arities.append(arity)
+        for variable in block["vars"]:
+            incidence[variable][arity - 2] += 1
+        for left, right in itertools.combinations(sorted(block["vars"]), 2):
+            pair_counts[(left, right)] = pair_counts.get((left, right), 0) + 1
+    invariant = {
+        "n": n,
+        "arities": sorted(arities),
+        "incidence": sorted(tuple(row) for row in incidence),
+        "pair_multiplicities": sorted(pair_counts.values()),
+    }
