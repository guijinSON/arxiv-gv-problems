+                    if not allowed:
+                        return False
+                    if len(allowed) == 1:
+                        variable = block["vars"][position]
+                        if assignment[variable] < 0:
+                            assignment[variable] = allowed[0]
+                            changed = True
+                        elif assignment[variable] != allowed[0]:
