index 0000000000000000000000000000000000000000..1bd02429a4ac1c56ccc9e523f62e0339fc178697
--- /dev/null
+++ b/gen_1005_4874.py
@@ -0,0 +1,776 @@
+"""Exact directed-cycle sphere certificates from arXiv:1005.4874.
+
+Section 3 of Scheder's paper defines the directed-cycle distance on color
+assignments and identifies the exact-sphere count T(m,r) as the coefficient of
+(1+x+...+x^(d-1))^m.  This generator samples the center and parameters, then
+constructs a short inclusion--exclusion expression for that coefficient.  The
+checker independently recomputes it by the paper's dynamic program.
+"""
+
+from __future__ import annotations
+
+import functools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "directed cycle on d colors",
+        "assignments in the Cartesian power of the cycle",
+        "exact sphere coefficient of (1+x+...+x^(d-1))^m",
+    ],
+    "verification_operations": [
+        "exact integer dynamic programming for a generating-function coefficient",
+        "exact binomial-coefficient evaluation",
+        "integer equality comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "Factor the directed-cycle step polynomial into a finite numerator and "
+        "a geometric-series denominator; without that decomposition, the paper's "
+        "dynamic program updates every radius at every coordinate."
+    ),
+    "hardness_basis": (
+        "Track B: Section 3 after Theorem 3.3 prescribes dynamic programming for "
+        "T(m,r), which is O(mr) with sliding windows; the shipping preset uses "
+        "2,614,000 exact coefficient additions/subtractions and 0.306 seconds at "
+        "the fixed measurement seed in selftest, while the bounded inclusion--"
+        "exclusion certificate needs at most 72 symbolic/index arithmetic "
+        "operations after the factorization is seen."
+    ),
+    "max_answer_tokens": 58,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 6, "d_min": 7, "d_span": 3, "quotient": 2},
+    "easy": {"n": 24, "d_min": 97, "d_span": 31, "quotient": 4},
+    "medium": {"n": 48, "d_min": 401, "d_span": 127, "quotient": 7},
+    "hard": {"n": 80, "d_min": 1201, "d_span": 401, "quotient": 11},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The finite color-step polynomial is a geometric-series quotient whose "
+    "numerator has support only at multiples of d."
+)
+PLACEBO_HINT = (
+    "Careful attention to coefficient indices and binomial conventions helps "
+    "avoid off-by-one errors in this calculation."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "JSON object {\"value\":V}, with 0<=V<=d^m, or {\"terms\":[...]}; "
+        "a terms certificate has 1..floor(r/d)+1 ordered terms [s,a,b,c,e], "
+        "s in {-1,1}, 0<=b<=a<=r+m and 0<=e<=c<=r+m, and denotes "
+        "sum s*C(a,b)*C(c,e)."
+    ),
+    "bounds": {
+        "forms": 2,
+        "value_min": 0,
+        "value_max": "d^m",
+        "term_count_min": 1,
+        "term_count_max": "floor(r/d)+1 (12 at shipping)",
+        "term_arity": 5,
+        "signs": [-1, 1],
+        "binomial_parameter_max": "r+m",
+    },
+}
+
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0, "errors": 4},
+    "hinted": {"solved": 0, "attempts": 0, "errors": 4},
+    "placebo": {"solved": 0, "attempts": 0, "errors": 4},
+    "hinted_verdict": "infrastructure_blocked_http_403",
+}
+
+NOTES = r"""
+Definition. Section 1 defines a (d,k)-CSP assignment as a point of [d]^n.
+Section 3 replaces Hamming distance by shortest-path distance in a graph G on
+the colors and lifts it additively to assignments. For the directed cycle C_d,
+the one-coordinate distances from any center are exactly 0,1,...,d-1. Lemma
+3.2 therefore identifies T(m,r), the number of assignments at exact distance
+r, with [x^r](1+x+...+x^(d-1))^m. This is the native object used here; no graph,
+SAT, finite-field, or integer-coordinate surrogate replaces it.
+
+Step-0 decision. Theorem 3.3 is an upper-bound algorithm, not evidence that a
+random planted CSP distribution is hard. The prior planted-assignment triage
+was therefore not used. The paragraph immediately after Theorem 3.3 says that
+the maximizing coefficients T(m,r) can be computed quickly by dynamic
+programming. That rules out an honest Track-A claim but supplies the Track-B
+mechanical route. The implemented sliding-window recurrence performs O(mr)
+exact additions/subtractions. At the named hard preset this is roughly two
+million operations. In contrast, the identity
+  (1+x+...+x^(d-1))^m = (1-x^d)^m (1-x)^(-m)
+gives the r-th coefficient as a sum over j=0..floor(r/d) of
+  (-1)^j C(m,j) C(r-j*d+m-1,m-1).
+The hard preset fixes floor(r/d)=11, so writing the certificate takes twelve
+terms and at most 72 symbolic/index operations. The certificate is produced by
+composition of these two formal-power-series identities, never by running the
+dynamic program on the generated instance.
+
+Generation and verification. The center assignment is sampled uniformly and
+the alphabet size and radius are sampled before the symbolic identity is
+instantiated. Center relabellings and coordinate permutations are genuine
+isometries, and the exact sphere count is independent of the center. verify()
+never reads inst["answer"]: it validates the bounded expression grammar, uses
+two modular filters, evaluates a surviving expression over the integers, and
+compares it with an independently cached sliding-window dynamic program.
+
+Easy regimes and attacks. Very small r or r<d makes the unbounded
+stars-and-bars term correct and is deliberately avoided outside the demo.
+Every non-demo radius crosses several upper-boundary layers. The outlier attack
+keeps only the largest boundary term; greedy ignores the upper color bound;
+random restart samples the full declared certificate language; and the
+in-context truncation attack keeps only the first two inclusion-exclusion
+terms. The successful dynamic program is reported separately, as Track B
+requires. Difficulty escalation enlarges d and r while keeping the twelve-term
+witness fixed.
+
+Canonicalization. Permuting coordinates, independently translating each
+center color around C_d, and composing those maps preserve the problem and its
+answer. The canonical key removes the center entirely and retains (m,d,r), the
+complete invariant of the sphere-count question. It contains neither seed nor
+rendered text.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_FENCE_RE = re.compile(r"```(?:json|text)?\s*(.*?)```", re.I | re.S)
+_G4_SAMPLES = 200_000
+_ATTACK_SEEDS = 8
+_ENUMERATION_CAP = 200_000
+_MODULI = (1_000_000_007, 1_000_000_009)
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_parameters(n, d_min, d_span, quotient):
+    for name, value in (
+        ("n", n),
+        ("d_min", d_min),
+        ("d_span", d_span),
+        ("quotient", quotient),
+    ):
+        if not _is_int(value):
+            raise ValueError(f"{name} must be an integer")
+    if not 3 <= n <= 256:
+        raise ValueError("n must lie in 3..256")
+    if d_min < 2:
+        raise ValueError("d_min must be at least 2")
+    if d_span < 1:
+        raise ValueError("d_span must be positive")
+    if not 1 <= quotient <= n - 2:
+        raise ValueError("quotient must lie in 1..n-2")
+
+
+def _ie_terms(m, d, r):
+    return [
+        [(-1 if j & 1 else 1), m, j, r - j * d + m - 1, m - 1]
+        for j in range(r // d + 1)
+    ]
+
+
+def make_instance(n, seed=0, **params):
+    """Construct a directed-cycle sphere and its symbolic coefficient identity."""
+    d_min = params.pop("d_min", 1201)
+    d_span = params.pop("d_span", 401)
+    quotient = params.pop("quotient", 11)
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    _validate_parameters(n, d_min, d_span, quotient)
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    d = d_min + rng.randrange(d_span)
+    # Keep floor(r/d) fixed while making seed-dependent canonical instances.
+    remainder_low = max(1, d // 5)
+    remainder_high = max(remainder_low + 1, 4 * d // 5)
+    remainder = rng.randrange(remainder_low, remainder_high)
+    r = quotient * d + remainder
+    if r > (d - 1) * n:
+        raise ValueError("chosen radius exceeds the maximum directed-cycle distance")
+    center = [rng.randrange(d) for _ in range(n)]
+    answer = {"terms": _ie_terms(n, d, r)}
+    return {
+        "family": "directed_cycle_exact_sphere_coefficient",
+        "dimension": n,
+        "colors": d,
+        "radius": r,
+        "center": center,
+        "max_distance": (d - 1) * n,
+        "term_limit": quotient + 1,
+        "parameter_bound": r + n,
+        "answer": answer,
+    }
+
+
+def _answer_example(term_limit):
+    terms = [[1, 0, 0, 0, 0] for _ in range(term_limit)]
+    return json.dumps({"terms": terms}, separators=(",", ":"))
+
+
+def render(inst):
+    m = inst["dimension"]
+    d = inst["colors"]
+    r = inst["radius"]
+    limit = inst["term_limit"]
+    bound = inst["parameter_bound"]
+    lines = [
+        "EXACT SPHERE IN A DIRECTED-CYCLE PRODUCT",
+        "",
+        f"There are m={m} coordinates and d={d} colors, numbered 0 through {d-1}.",
+        "The directed color cycle has the edge c -> (c+1) mod d.",
+        "Thus the directed distance from color a to color b is the unique integer",
+        "(b-a) mod d in {0,...,d-1}. For assignments, distances add coordinatewise.",
+        "",
+        "Center assignment (coordinates are listed in order):",
+        " ".join(map(str, inst["center"])),
+        "",
+        f"Let T be the number of d-color assignments at directed distance exactly r={r}",
+        "from this center. Give either T itself or an exact symbolic certificate for T.",
+        "",
+        "Accepted JSON forms:",
+        f"1. {{\"value\":V}}, where V is an integer with 0 <= V <= d^m.",
+        "2. {\"terms\":[term,...]}, where the list has between 1 and "
+        f"{limit} terms. A term is [s,a,b,c,e] and means",
+        "   s * binom(a,b) * binom(c,e). Here s is -1 or 1, and",
+        f"   0 <= b <= a <= {bound} and 0 <= e <= c <= {bound}.",
+        "   The value of the certificate is the sum of its terms.",
+        "The convention is binom(0,0)=1. All quantities and comparisons are exact.",
+        "Order in the term list matters only for parsing; repeats are allowed.",
+        "",
+        "Give your final answer inside <answer></answer> tags as one accepted JSON object.",
+        "The following illustrates syntax and list length only; it is not this instance's answer:",
+        f"<answer>{_answer_example(limit)}</answer>",
+        "Output nothing else inside the tags.",
+    ]
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if match:
+        payload = match.group(1).strip()
+    else:
+        fenced = _FENCE_RE.search(text)
+        payload = fenced.group(1).strip() if fenced else text.strip()
+    try:
+        result = json.loads(payload)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(result, dict):
+        return None
+    return result
+
+
+@functools.lru_cache(maxsize=128)
+def _sphere_count(m, d, r):
+    """Coefficient through the Section-3 recurrence, optimized by a window."""
+    previous = [0] * (r + 1)
+    previous[0] = 1
+    for _ in range(m):
+        current = [0] * (r + 1)
+        window = 0
+        for s in range(r + 1):
+            window += previous[s]
+            if s >= d:
+                window -= previous[s - d]
+            current[s] = window
+        previous = current
+    return previous[r]
+
+
+def _dp_operations(m, d, r):
+    return m * (r + 1) + m * max(0, r - d + 1)
+
+
+@functools.lru_cache(maxsize=64)
+def _factorials_mod(bound, modulus):
+    factorial = [1] * (bound + 1)
+    for i in range(1, bound + 1):
+        factorial[i] = factorial[i - 1] * i % modulus
+    inverse = [1] * (bound + 1)
+    inverse[bound] = pow(factorial[bound], modulus - 2, modulus)
+    for i in range(bound, 0, -1):
+        inverse[i - 1] = inverse[i] * i % modulus
+    return tuple(factorial), tuple(inverse)
+
+
+def _comb_mod(a, b, modulus, bound):
+    factorial, inverse = _factorials_mod(bound, modulus)
+    return factorial[a] * inverse[b] % modulus * inverse[a - b] % modulus
+
+
+def _validate_answer_shape(inst, answer):
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if set(answer) == {"value"}:
+        value = answer["value"]
+        if not _is_int(value):
+            return False, "value must be an integer"
+        if not 0 <= value <= pow(inst["colors"], inst["dimension"]):
+            return False, "value lies outside 0..d^m"
+        return True, "value"
+    if set(answer) != {"terms"}:
+        return False, "answer must contain exactly one of value or terms"
+    terms = answer["terms"]
+    if not isinstance(terms, list):
+        return False, "terms must be a list"
+    if not terms:
+        return False, "terms list must be nonempty"
+    if len(terms) > inst["term_limit"]:
+        return False, "terms list exceeds the instance term limit"
+    bound = inst["parameter_bound"]
+    for index, term in enumerate(terms):
+        if not isinstance(term, list) or len(term) != 5:
+            return False, f"term {index} must be a five-integer list"
+        if not all(_is_int(x) for x in term):
+            return False, f"term {index} contains a non-integer"
+        sign, a, b, c, e = term
+        if sign not in (-1, 1):
+            return False, f"term {index} sign must be -1 or 1"
+        if not (0 <= b <= a <= bound and 0 <= e <= c <= bound):
+            return False, f"term {index} violates the binomial parameter bounds"
+    return True, "terms"
+
+
+def _terms_mod(terms, modulus, bound):
+    total = 0
+    for sign, a, b, c, e in terms:
+        part = _comb_mod(a, b, modulus, bound)
+        part = part * _comb_mod(c, e, modulus, bound) % modulus
+        total = (total + sign * part) % modulus
+    return total
+
+
+def _terms_exact(terms):
+    return sum(
+        sign * math.comb(a, b) * math.comb(c, e)
+        for sign, a, b, c, e in terms
+    )
+
+
+def verify(inst, answer):
+    ok, form = _validate_answer_shape(inst, answer)
+    if not ok:
+        return False, form
+    expected = _sphere_count(inst["dimension"], inst["colors"], inst["radius"])
+    if form == "value":
+        if answer["value"] != expected:
+            return False, "integer value is not the exact sphere count"
+        return True, "ok"
+
+    terms = answer["terms"]
+    bound = inst["parameter_bound"]
+    for modulus in _MODULI:
+        if _terms_mod(terms, modulus, bound) != expected % modulus:
+            return False, "symbolic expression fails an exact modular coefficient check"
+    if _terms_exact(terms) != expected:
+        return False, "symbolic expression does not equal the exact sphere count"
+    return True, "ok"
+
+
+def _triangular_size(bound):
+    return (bound + 1) * (bound + 2) // 2
+
+
+def _term_space(inst):
+    pair_count = _triangular_size(inst["parameter_bound"])
+    return 2 * pair_count * pair_count
+
+
+def search_space(inst):
+    base = _term_space(inst)
+    expression_count = sum(pow(base, length) for length in range(1, inst["term_limit"] + 1))
+    return pow(inst["colors"], inst["dimension"]) + 1 + expression_count
+
+
+def _decode_pair(code):
+    a = (math.isqrt(8 * code + 1) - 1) // 2
+    start = a * (a + 1) // 2
+    return a, code - start
+
+
+def random_candidate(inst, rng):
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    value_count = pow(inst["colors"], inst["dimension"]) + 1
+    base = _term_space(inst)
+    powers = [pow(base, length) for length in range(1, inst["term_limit"] + 1)]
+    total = value_count + sum(powers)
+    index = rng.randrange(total)
+    if index < value_count:
+        return {"value": index}
+    index -= value_count
+    length = 1
+    for count in powers:
+        if index < count:
+            break
+        index -= count
+        length += 1
+
+    pair_count = _triangular_size(inst["parameter_bound"])
+    terms = []
+    for _ in range(length):
+        index, digit = divmod(index, base)
+        sign_code, rest = divmod(digit, pair_count * pair_count)
+        left_code, right_code = divmod(rest, pair_count)
+        a, b = _decode_pair(left_code)
+        c, e = _decode_pair(right_code)
+        terms.append([1 if sign_code else -1, a, b, c, e])
+    return {"terms": terms}
+
