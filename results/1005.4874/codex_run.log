+def _dimension_for(n):
+    q = 1
+    power = 3
+    while power <= n:
+        q += 1
+        power *= 3
+    return q
+
+
+def _trits(number, q):
+    digits = []
+    for _ in range(q):
+        number, digit = divmod(number, 3)
+        digits.append(digit)
+    return digits
+
+
+def _from_trits(digits):
+    value = 0
+    place = 1
+    for digit in digits:
+        value += digit * place
+        place *= 3
+    return value
 
 
