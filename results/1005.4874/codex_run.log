+def _decode_relation(block):
+    arity = len(block["vars"])
+    forbidden = {tuple(values) for values in block["forbidden"]}
+    checks = 0
+    for tail in itertools.product((1, 2), repeat=arity - 1):
+        coefficients = (1,) + tail
