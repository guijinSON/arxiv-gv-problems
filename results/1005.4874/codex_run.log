+                values = tuple(answer[index] for index in block["vars"])
+                violations += int(any(values == tuple(f) for f in block["forbidden"]))
+            score = (violations, color)
+            if best is None or score < best[0]:
+                best = (score, color)
+        answer[variable] = best[1]
+    return answer
 
