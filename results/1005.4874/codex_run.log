+
+
+def _attack_greedy_unbounded(inst):
+    m, r = inst["dimension"], inst["radius"]
+    return {"terms": [[1, m, 0, r + m - 1, m - 1]]}
+
+
+def _attack_reflected_unbounded(inst):
+    m, d, r = inst["dimension"], inst["colors"], inst["radius"]
+    reflected = (d - 1) * m - r
+    return {"terms": [[1, m, 0, reflected + m - 1, m - 1]]}
