   669	                violations += int(any(values == tuple(f) for f in block["forbidden"]))
   670	            score = (violations, color)
   671	            if best is None or score < best[0]:
   672	                best = (score, color)
   673	        answer[variable] = best[1]
   674	    return answer
   675	
   676	
   677	def _attack_affine_labels(inst):
   678	    q = inst["label_dimension"]
   679	    attempts = 0
   680	    for coefficients in itertools.product(range(3), repeat=q):
   681	        for constant in range(3):
   682	            attempts += 1
   683	            answer = [
   684	                (_dot(coefficients, label) + constant) % 3
   685	                for label in inst["labels"]
   686	            ]
   687	            if verify(inst, answer)[0]:
   688	                return answer, attempts
   689	    return [0] * inst["n"], attempts
   690	
   691	
   692	def _attack_label_digit_sum(inst):
   693	    return [sum(label) % 3 for label in inst["labels"]]
   694	
   695	
   696	def _translated_instance(inst, shifts):
   697	    transformed = json.loads(json.dumps(inst))
   698	    for block in transformed["blocks"]:
   699	        for forbidden in block["forbidden"]:
   700	            for position, variable in enumerate(block["vars"]):
   701	                forbidden[position] = (forbidden[position] + shifts[variable]) % 3
   702	        block["forbidden_mask"] = _forbidden_mask(block["forbidden"])
   703	    transformed["answer"] = [
   704	        (color + shift) % 3 for color, shift in zip(inst["answer"], shifts)
   705	    ]
   706	    return transformed
   707	
   708	
   709	def _permuted_instance(inst, old_order):
   710	    transformed = json.loads(json.dumps(inst))
   711	    old_to_new = {old: new for new, old in enumerate(old_order)}
   712	    transformed["labels"] = [inst["labels"][old] for old in old_order]
   713	    transformed["answer"] = [inst["answer"][old] for old in old_order]
   714	    for block in transformed["blocks"]:
   715	        block["vars"] = [old_to_new[old] for old in block["vars"]]
   716	    return transformed
   717	
   718	
   719	def _atoms(value):
   720	    if isinstance(value, dict):
   721	        return sum(_atoms(item) for item in value.values())
   722	    if isinstance(value, list):
   723	        return sum(_atoms(item) for item in value)
   724	    return 1
   725	

