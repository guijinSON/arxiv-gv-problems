import json,os,datetime
p='claims/$ID.json'
d=json.load(open(p)) if os.path.exists(p) else {'paper':'$ID'}
d['status']='done'
d['done_at']=datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
