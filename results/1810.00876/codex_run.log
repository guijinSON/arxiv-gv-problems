import random, time, statistics

def graph(n, seed):
    r=random.Random(seed)
    a=[set() for _ in range(n)]
    for i in range(n):
        for j in range(i+1,n):
            if r.getrandbits(1):
                a[i].add(j); a[j].add(i)
    p=list(range(n)); r.shuffle(p)
    b=[set() for _ in range(n)]
    for i in range(n):
        for j in a[i]:
            if i<j:
                b[p[i]].add(p[j]); b[p[j]].add(p[i])
    return a,b,p

def refine(a,b):
    n=len(a); colors=[len(x) for x in a]+[len(x) for x in b]
    sig_ops=0; rounds=0
    while True:
        sig=[]
        for off,g in ((0,a),(n,b)):
            for v,nb in enumerate(g):
                sig_ops += len(nb)
                sig.append((colors[off+v], tuple(sorted(colors[off+w] for w in nb))))
        uniq={s:i for i,s in enumerate(sorted(set(sig)))}
        new=[uniq[s] for s in sig]
        rounds+=1
        if new==colors: break
        colors=new
        if rounds>n: break
    counts={}
    for c in colors: counts[c]=counts.get(c,0)+1
    discrete=all(v==2 for v in counts.values()) and len(counts)==n
    return discrete,rounds,sig_ops

for n in (64,128,256):
    rows=[]
    for seed in range(20):
        a,b,p=graph(n,seed)
        t=time.perf_counter(); ok,r,o=refine(a,b); dt=time.perf_counter()-t
        rows.append((ok,r,o,dt,sum(map(len,a))//2))
    print(n, 'solved',sum(x[0] for x in rows),'/20', 'rounds',sorted(set(x[1] for x in rows)),
          'incidence_ops_median',int(statistics.median(x[2] for x in rows)),
          'time_median_sec',format(statistics.median(x[3] for x in rows),'.6f'),
          'edges_median',int(statistics.median(x[4] for x in rows)))
