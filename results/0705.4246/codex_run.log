   495	def search_space(inst: dict) -> int | None:
   496	    return _multinomial(inst["x_counts"]) * _multinomial(inst["y_counts"])
   497	
   498	
   499	def _unique_multiset_words(counts):
   500	    letters = list(_COUNT_ORDER)
   501	    remaining = list(counts)
   502	    length = sum(counts)
   503	    output = []
   504	
   505	    def visit():
   506	        if len(output) == length:
   507	            yield "".join(output)
   508	            return
   509	        for index, letter in enumerate(letters):
   510	            if remaining[index]:
   511	                remaining[index] -= 1
   512	                output.append(letter)
   513	                yield from visit()
   514	                output.pop()
   515	                remaining[index] += 1
   516	
   517	    yield from visit()
   518	
   519	
   520	def enumerate_all(inst: dict) -> int | None:
   520	def enumerate_all(inst: dict) -> int | None:
   521	    if search_space(inst) > 500_000:
   522	        return None
   523	    count = 0
   524	    y_words = list(_unique_multiset_words(inst["y_counts"]))
   525	    for x_word in _unique_multiset_words(inst["x_counts"]):
   526	        for y_word in y_words:
   527	            if verify(inst, {"x": x_word, "y": y_word})[0]:
   528	                count += 1
   529	    return count
