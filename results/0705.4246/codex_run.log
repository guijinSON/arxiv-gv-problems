+        pair = _mat_apply_signed_pair(inverse_normalizer, pair, p)
+        first, second = pair
+        for move in sequence:
+            if move == "L":
+                first = _mat_mul(first, second, p)
+            else:
+                second = _mat_mul(second, first, p)
