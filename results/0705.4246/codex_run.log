   288	def _inverse_nielsen_values(pair, sequence):
   289	    first, second = pair
   290	    # The image pair is built by right-composing elementary maps, so values are
   291	    # recovered in reverse construction order.
   292	    for move in reversed(sequence):
   293	        if move == "L":
   294	            first = _multiply(first, _inverse(second))
   295	        else:
   296	            second = _multiply(second, _inverse(first))
   297	    return first, second
