+def _mat_mul(left, right, p):
+    a, b, c, d = left
+    e, f, g, h = right
+    return (
+        (a * e + b * g) % p,
+        (a * f + b * h) % p,
+        (c * e + d * g) % p,
+        (c * f + d * h) % p,
+    )
 
 
