+def _attack_target_prefix(inst):
+    stream = itertools.cycle(inst["u"] + inst["u"][::-1])
+    x = _fit_counts_from_stream(inst, "x", stream)
+    stream = itertools.cycle(inst["u"][::-1] + inst["u"])
+    y = _fit_counts_from_stream(inst, "y", stream)
+    return {"x": x, "y": y}
