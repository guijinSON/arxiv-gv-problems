   261	def _base_target_and_solution(t):
   262	    a = (1,)
   263	    b = (2,)
   264	    # Section 3: [b^-1 a^t, b^-1 a b]^2_comm * b^-1 a^t
   265	    # equals [a,b] a^-1 b^-1 a^(t+1).
   266	    x0 = _multiply(_inverse(b), _power(a, t))
   267	    y0 = _multiply(_inverse(b), a, b)
   268	    u = _multiply(
   269	        _commutator(a, b), _inverse(a), _inverse(b), _power(a, t + 1)
   270	    )
   271	    # w1 = L(w0), so L^-1 carries the displayed solution to w1.
   272	    x1 = _multiply(x0, _inverse(y0))
   273	    y1 = y0
   274	    assert _substitute(_W1, x1, y1) == u
   275	    return u, (x1, y1)
