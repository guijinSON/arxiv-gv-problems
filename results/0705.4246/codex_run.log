   395	def render(inst: dict) -> str:
   396	    statement = f"""Solve one exact equation in the free group F(a,b).
   397	
   398	A word is a string over a, A, b, B.  Here A means a^(-1), B means
   399	b^(-1), juxtaposition is multiplication, and the empty word is the identity.
   400	Equality means equality after repeatedly deleting adjacent inverse pairs aA,
   401	Aa, bB, or Bb.  The unknown words x and y are substituted into a word over
   402	x, X, y, Y, where X means x^(-1) and Y means y^(-1).
   403	
   404	Equation word w(x,y): {inst['w']}
   405	Target reduced word u: {inst['u']}
   406	
   407	For reference, the exponent sums of x and y in w are respectively
   408	{inst['exponent_sums'][0]} and {inst['exponent_sums'][1]}.  An exponent sum
   409	counts a lowercase occurrence as +1 and its uppercase inverse as -1.
   410	
   411	Find words x and y such that freely reducing w(x,y) gives exactly u.  Your
   412	spelled words need not themselves be freely reduced, but they must obey all
   413	of these exact side constraints:
   414	  x has length {inst['x_length']} and counts [a,A,b,B] = {inst['x_counts']};
   415	  y has length {inst['y_length']} and counts [a,A,b,B] = {inst['y_counts']}.
   416	Order matters, repetitions are allowed exactly as prescribed by those counts,
   417	and all indexing implicit in the strings is left-to-right.
   418	
   419	Give your final answer inside <answer></answer> tags as one JSON object with
   420	exactly two string fields, x and y.
   421	Example: <answer>{{"x":"aB","y":"bA"}}</answer>
   422	Output nothing else inside the tags."""
   423	    mode = os.environ.get("GV_HINT_MODE")
   424	    if mode == "structural":
   425	        statement += "\n\nHint: " + STRUCTURAL_HINT
   426	    elif mode == "placebo":
   427	        statement += "\n\nHint: " + PLACEBO_HINT
   428	    return statement
