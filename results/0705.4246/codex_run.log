   205	def _decode(text, formal=False, allow_identity=True):
   206	    if not isinstance(text, str):
   207	        return None
   208	    if text == "1" and allow_identity:
   209	        return ()
   210	    table = _CHAR_TO_FORMAL if formal else _CHAR_TO_AMBIENT
   211	    if not text or any(letter not in table for letter in text):
   212	        return None
   213	    return tuple(table[letter] for letter in text)
