   148	# Internal words are tuples from {+/-1,+/-2}; 1,2 denote the first and second
   149	# generator and negative integers denote inverses.  Strings are used on the wire.
   150	_AMBIENT_TO_CHAR = {1: "a", -1: "A", 2: "b", -2: "B"}
   151	_CHAR_TO_AMBIENT = {value: key for key, value in _AMBIENT_TO_CHAR.items()}
   152	_FORMAL_TO_CHAR = {1: "x", -1: "X", 2: "y", -2: "Y"}
   153	_CHAR_TO_FORMAL = {value: key for key, value in _FORMAL_TO_CHAR.items()}
