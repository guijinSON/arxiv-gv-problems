   332	
   333	def make_instance(
   334	    n: int,
   335	    seed: int = 0,
   336	    min_switches: int = 0,
   337	    t_span: int = 3,
   338	    answer_cap: int = 250,
   339	) -> dict:
   340	    """Construct an equation and its solution by exact Nielsen transport."""
   341	
   342	    _validate_parameters(n, min_switches, t_span, answer_cap)
   343	    rng = random.Random(seed)
   344	    chosen = None
   345	    # This samples construction parameters, not candidate solutions.  Every
   346	    # trial already comes with its transported certificate.
   347	    for _ in range(20_000):
   348	        sequence = "".join(rng.choice("LR") for _ in range(n))
   349	        if _switches(sequence) < min_switches:
   350	            continue
   351	        t = 1 + rng.randrange(t_span)
   352	        u_base, base_pair = _base_target_and_solution(t)
   353	        images = _forward_nielsen_images(sequence)
   354	        w_positive = _substitute(_W1, images[0], images[1])
   355	        pair_positive = _inverse_nielsen_values(base_pair, sequence)
   356	        if len(pair_positive[0]) + len(pair_positive[1]) > answer_cap:
   357	            continue
   358	        # Avoid shallow accidental instances at non-demo levels.
   359	        if n >= 7 and len(w_positive) < 55:
   360	            continue
   361	        chosen = (sequence, t, u_base, w_positive, pair_positive)
   362	        break
   363	    if chosen is None:
   364	        raise ValueError("no construction fits the requested answer cap")
   365	
   366	    sequence, t, u_base, w_positive, pair_positive = chosen
   367	    variable_map = rng.choice(_SIGNED_MAPS)
   368	    ambient_map = rng.choice(_SIGNED_MAPS)
   369	    w_final = _apply_signed_word(w_positive, variable_map)
   370	    variable_normalizer = _inverse_signed_map(variable_map)
   371	    pair_variable = _apply_signed_pair(variable_normalizer, pair_positive)
   372	    u_final = _apply_signed_word(u_base, ambient_map)
   373	    pair_final = tuple(_apply_signed_word(word, ambient_map) for word in pair_variable)
   374	    assert _substitute(w_final, pair_final[0], pair_final[1]) == u_final
   375	
   376	    answer = {"x": _encode(pair_final[0]), "y": _encode(pair_final[1])}
   377	    exponent_sums = [
   378	        sum(1 if letter == generator else -1 if letter == -generator else 0
   379	            for letter in w_final)
   380	        for generator in (1, 2)
   381	    ]
   382	    return {
   383	        "n": n,
   384	        "w": _encode(w_final, formal=True),
   385	        "u": _encode(u_final),
   386	        "exponent_sums": exponent_sums,
   387	        "x_length": len(answer["x"]),
   388	        "y_length": len(answer["y"]),
   389	        "x_counts": _counts(pair_final[0]),
   390	        "y_counts": _counts(pair_final[1]),
   391	        "answer": answer,
   392	    }
