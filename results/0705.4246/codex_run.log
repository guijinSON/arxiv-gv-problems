+def _nielsen_reduce_full_word(normalized, max_depth):
+    queue = deque([(normalized, "")])
+    seen = {normalized}
+    operations = 0
+    while queue:
+        current, path = queue.popleft()
+        if current == _W1:
+            return path, operations
+        if len(path) >= max_depth:
+            continue
+        for name, mapping in (("L", _L_INV), ("R", _R_INV)):
+            operations += len(current)
+            candidate = _substitute(current, mapping[0], mapping[1])
+            if len(candidate) >= len(current) or candidate in seen:
+                continue
+            seen.add(candidate)
+            queue.append((candidate, path + name))
