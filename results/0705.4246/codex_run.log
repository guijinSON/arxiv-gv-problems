+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list) or len(value) != 2:
+        return None
+    if not all(isinstance(v, str) for v in value):
+        return None
+    return value
+
+
+def verify(inst, answer):
+    if answer is None:
+        return False, "answer is absent"
+    if answer == []:
+        return False, "answer is empty"
+    if not isinstance(answer, list) or len(answer) != 2:
+        return False, "answer must be a two-word JSON list"
+    if not all(isinstance(v, str) for v in answer):
+        return False, "both words must be strings"
+    x, y = answer
+    if not x or not y or x == "1" or y == "1":
+        return False, "both words must be nonempty"
+    allowed = set(inst["alphabet"] + inst["alphabet"].upper())
+    if any(ch not in allowed for word in answer for ch in word):
+        return False, "invalid generator symbol"
+    if len(x) > inst["max_word_len"] or len(y) > inst["max_word_len"]:
+        return False, "word exceeds the stated length bound"
+    if _free_reduce(x) != x or _free_reduce(y) != y:
+        return False, "word is not freely reduced"
+    if x == y:
+        return False, "x and y must be distinct"
+    if _commutator(x, y) != _free_reduce(inst["target"]):
+        return False, "the reduced commutator does not equal the target"
+    return True, "ok"
+
+
+def _word_count(rank, bound):
+    if bound < 1:
+        return 0
+    return sum(2 * rank * (2 * rank - 1) ** (length - 1)
+               for length in range(1, bound + 1))
+
+
+@functools.lru_cache(maxsize=None)
+def _word_tables(rank, bound):
+    alphabet = _letters(rank) + _letters(rank).upper()
+    base = 2 * rank - 1
+    powers = tuple(base ** exponent for exponent in range(bound + 1))
+    cumulative = []
+    running = 0
+    for length in range(1, bound + 1):
+        running += 2 * rank * powers[length - 1]
+        cumulative.append(running)
+    choices = {
+        previous: tuple(ch for ch in alphabet if ch != _inverse_letter(previous))
+        for previous in alphabet
+    }
+    return alphabet, powers, tuple(cumulative), choices
+
+
+def _unrank_reduced_word(index, rank, bound):
+    alphabet, powers, cumulative, choices_by_previous = _word_tables(rank, bound)
+    total = cumulative[-1] if cumulative else 0
+    if not 0 <= index < total:
+        raise ValueError("word index out of range")
+    length = bisect.bisect_right(cumulative, index) + 1
+    if length > 1:
+        index -= cumulative[length - 2]
+    block = powers[length - 1]
+    first = index // block
+    index %= block
+    out = [alphabet[first]]
+    for position in range(1, length):
+        choices = choices_by_previous[out[-1]]
+        power = powers[length - position - 1]
+        digit, index = divmod(index, power)
+        out.append(choices[digit])
+    return "".join(out)
+
+
+def random_candidate(inst, rng):
+    rank, bound = inst["rank"], inst["max_word_len"]
+    alphabet, _powers, cumulative, choices_by_previous = _word_tables(rank, bound)
+
+    def uniform_digits(modulus, count):
+        digits = []
+        ceiling = (256 // modulus) * modulus
+        while len(digits) < count:
+            need = count - len(digits)
+            if hasattr(rng, "randbytes"):
+                raw = rng.randbytes(max(8, need + need // 8 + 2))
+            else:  # pragma: no cover - for older standard-library Random objects
+                raw = bytes(rng.getrandbits(8) for _ in range(max(8, need + 2)))
+            digits.extend(byte % modulus for byte in raw if byte < ceiling)
+        return digits[:count]
+
+    def draw_word():
+        # Length is weighted by its exact number of freely reduced words; within
+        # that length every successive legal letter is sampled uniformly.
+        length = bisect.bisect_right(cumulative, rng.randrange(cumulative[-1])) + 1
+        first = uniform_digits(len(alphabet), 1)[0]
+        transition_digits = uniform_digits(len(alphabet) - 1, length - 1)
+        out = [alphabet[first]]
+        for digit in transition_digits:
+            choices = choices_by_previous[out[-1]]
+            out.append(choices[digit])
+        return "".join(out)
+
+    first = draw_word()
+    second = draw_word()
+    while second == first:
+        second = draw_word()
+    return [first, second]
+
+
+def search_space(inst):
+    words = _word_count(inst["rank"], inst["max_word_len"])
+    return words * (words - 1)
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 200000:
+        return None
+    words = [_unrank_reduced_word(i, inst["rank"], inst["max_word_len"])
+             for i in range(_word_count(inst["rank"], inst["max_word_len"]))]
+    count = 0
+    for i, x in enumerate(words):
+        for j, y in enumerate(words):
+            if i != j and verify(inst, [x, y])[0]:
+                count += 1
+    return count
+
+
+def _normalise_signed_labels(word):
+    mapping = {}
+    next_label = 0
+    out = []
+    for ch in word:
+        base = ch.lower()
+        sign = 1 if ch.isupper() else 0
+        if base not in mapping:
+            mapping[base] = (next_label, sign)
+            next_label += 1
+        label, flip = mapping[base]
+        out.append(chr(ord("a") + label).upper() if sign ^ flip else
+                   chr(ord("a") + label))
+    return "".join(out)
+
+
+def canonical_key(inst):
+    """Canonical under conjugacy, inversion, and signed generator relabelling."""
+    core = _cyclic_core(inst["target"])
+    if not core:
+        normal = "1"
+    else:
+        candidates = []
+        for oriented in (core, _inverse(core)):
+            for shift in range(len(oriented)):
+                candidates.append(_normalise_signed_labels(
+                    oriented[shift:] + oriented[:shift]))
+        normal = min(candidates)
+    return f"r={inst['rank']}|B={inst['max_word_len']}|{normal}"
+
+
+def _reference_solve(inst):
+    """Exact cyclic Wicks-form matcher; never inspects inst['answer']."""
+    target = _free_reduce(inst["target"])
+    core, outer = _cyclic_reduce_with_conjugator(target)
+    operations = len(target)
+    length = len(core)
+    if length < 4 or length % 2:
+        return None, operations
+    half = length // 2
+
+    def equal_counted(left, right):
+        nonlocal operations
+        if len(left) != len(right):
+            operations += 1
+            return False
+        for a, b in zip(left, right):
+            operations += 1
+            if a != b:
+                return False
+        return True
+
+    for shift in range(length):
+        candidate_core = core[shift:] + core[:shift]
+        operations += 2 * length  # symbols copied by the two slices and concat
+        prefix = core[:shift]
+        for x_len in range(1, half):
+            x_inv = candidate_core[:x_len]
+            y_inv = candidate_core[x_len:half]
+            x0 = candidate_core[half:half + x_len]
+            y0 = candidate_core[half + x_len:]
+            if not equal_counted(x_inv, _inverse(x0)):
+                continue
+            if not equal_counted(y_inv, _inverse(y0)):
+                continue
+            # candidate_core = prefix^-1 core prefix, hence
+            # target = h^-1 candidate_core h for h=prefix^-1 outer.
+            by = _free_reduce(_inverse(prefix) + outer)
+            # A conjugator is defined only modulo left multiplication by the
+            # centralizer <candidate_core>.  Trying the neighbouring powers is
+            # the standard cyclic normalisation and recovers the short witness
+            # after a cut close to the end of the cyclic word.
+            for central_power in (_inverse(candidate_core), "", candidate_core):
+                normal_by = _free_reduce(central_power + by)
+                x = _conjugate(x0, normal_by)
+                y = _conjugate(y0, normal_by)
+                operations += (
+                    len(central_power) + len(by) + 2 * (len(x0) + len(y0))
+                )
+                candidate = [x, y]
+                if verify(inst, candidate)[0]:
+                    return candidate, operations
+    return None, operations
+
+
+def _attack_frequency(inst):
+    core = _cyclic_core(inst["target"])
+    bases = list(inst["alphabet"])
+    bases.sort(key=lambda b: -sum(ch.lower() == b for ch in core))
+    if len(bases) < 2:
+        return None
+    guess = []
+    for base in bases[:2]:
+        lo = core.count(base)
+        hi = core.count(base.upper())
+        guess.append(base if lo >= hi else base.upper())
+    return guess
+
+
+def _attack_equal_quarters(inst):
+    core = _cyclic_core(inst["target"])
+    if len(core) % 4:
+        return None
+    q = len(core) // 4
+    return [core[2 * q:3 * q], core[3 * q:]]
+
+
+def _attack_visible_prefix(inst):
+    core = _cyclic_core(inst["target"])
+    if len(core) % 2:
+        return None
+    half = len(core) // 2
+    best = 0
+    for size in range(1, half):
+        if core[:size] == _inverse(core[half:half + size]):
+            best = size
+        else:
+            break
+    if best == 0:
+        return None
+    return [core[half:half + best], core[half + best:]]
+
+
+def _relabel_word(word, mapping):
+    out = []
+    for ch in word:
+        mapped = mapping[ch.lower()]
+        out.append(_inverse_letter(mapped) if ch.isupper() else mapped)
+    return "".join(out)
+
+
+def _g8_variants(inst):
+    rank = inst["rank"]
+    alphabet = inst["alphabet"]
+    permuted = list(reversed(alphabet))
+    mapping = {
+        source: (target.upper() if i % 2 else target)
+        for i, (source, target) in enumerate(zip(alphabet, permuted))
+    }
+
+    relabelled = copy.deepcopy(inst)
+    relabelled["target"] = _relabel_word(inst["target"], mapping)
+    relabelled["answer"] = [_relabel_word(w, mapping) for w in inst["answer"]]
+
+    conjugated = copy.deepcopy(inst)
+    by = alphabet[0]
+    conjugated["target"] = _conjugate(inst["target"], by)
+    conjugated["answer"] = [_conjugate(w, by) for w in inst["answer"]]
+
+    inverted = copy.deepcopy(inst)
+    inverted["target"] = _inverse(inst["target"])
+    inverted["answer"] = [inst["answer"][1], inst["answer"][0]]
+
+    composed = copy.deepcopy(relabelled)
+    by2 = alphabet[-1].upper()
+    composed["target"] = _inverse(_conjugate(relabelled["target"], by2))
+    carried = [_conjugate(w, by2) for w in relabelled["answer"]]
+    composed["answer"] = [carried[1], carried[0]]
+    return [relabelled, conjugated, inverted, composed]
+
+
+def escalate(params):
+    harder = dict(params)
+    n = harder.get("n", 72)
+    if n >= 136:
+        return "cap_bound"
+    next_n = n + 16
+    next_rotation = harder.get("rotation_max", 9) + 2
+    next_conjugator = harder.get("conjugator_len", 4) + 1
+    # This raises the cyclic-cut haystack and the number of obscuring conjugator
+    # letters together. Beyond n=136 the carried witness approaches 256 letters.
+    if next_n > 136:
+        return "cap_bound"
+    harder["n"] = next_n
+    harder["rotation_min"] = harder.get("rotation_min", 7) + 1
+    harder["rotation_max"] = next_rotation
+    harder["conjugator_len"] = next_conjugator
+    harder["word_bound"] = max(harder.get("word_bound", 80) + 16, next_n)
+    return harder
