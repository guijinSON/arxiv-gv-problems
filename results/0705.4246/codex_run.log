+def _normalise_signed_labels(word):
+    mapping = {}
+    next_label = 0
+    out = []
+    for ch in word:
+        base = ch.lower()
+        sign = 1 if ch.isupper() else 0
+        if base not in mapping:
+            mapping[base] = (next_label, sign)
+            next_label += 1
+        label, flip = mapping[base]
+        out.append(chr(ord("a") + label).upper() if sign ^ flip else
+                   chr(ord("a") + label))
+    return "".join(out)
