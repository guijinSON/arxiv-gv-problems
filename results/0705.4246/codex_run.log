+def _word_matrix(word, p):
+    result = (1, 0, 0, 1)
+    generators = {1: _HASH_A, 2: _HASH_B}
+    for letter in word:
+        matrix = generators[abs(letter)]
+        if letter < 0:
+            matrix = _mat_inv(matrix, p)
+        result = _mat_mul(result, matrix, p)
+    return result
