   868	def _fit_counts_from_stream(inst, name, stream):
   869	    remaining = dict(zip(_COUNT_ORDER, inst[name + "_counts"]))
   870	    output = []
   871	    # Attack streams may be cyclic and omit a required letter.  Give the
   872	    # heuristic a bounded opportunity, then append the still-missing multiset
   873	    # in the public alphabet order.
   874	    budget = max(16, 16 * inst[name + "_length"])
   875	    bounded = itertools.islice(stream, budget)
   876	    fallback = itertools.chain.from_iterable(
   877	        itertools.repeat(letter, inst[name + "_length"])
   878	        for letter in _COUNT_ORDER
   879	    )
   880	    for letter in itertools.chain(bounded, fallback):
   881	        if remaining.get(letter, 0):
   882	            output.append(letter)
   883	            remaining[letter] -= 1
   884	            if len(output) == inst[name + "_length"]:
   885	                return "".join(output)
   886	    raise AssertionError("unreachable")
