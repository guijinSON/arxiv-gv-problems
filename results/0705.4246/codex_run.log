   700	            (_substitute(current, _L_INV[0], _L_INV[1]), "L"),
   701	            (_substitute(current, _R_INV[0], _R_INV[1]), "R"),
   702	        ]
   703	        candidates.sort(key=lambda item: (len(item[0]), item[1]))
   704	        next_word, move = candidates[0]
   705	        if len(next_word) >= len(current):
   706	            break
   707	        current = next_word
   708	        path += move
   709	    return None, operations
