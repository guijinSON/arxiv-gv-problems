   216	def _signed_maps():
   217	    maps = []
   218	    for order in ((1, 2), (2, 1)):
   219	        for sign1 in (-1, 1):
   220	            for sign2 in (-1, 1):
   220	            for sign2 in (-1, 1):
   221	                maps.append((sign1 * order[0], sign2 * order[1]))
   222	    return tuple(maps)
