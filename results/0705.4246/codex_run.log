   579	def canonical_key(inst: dict) -> str:
   580	    # Complete for signed permutations/inversions of the two coefficient
   581	    # generators and two variables.  General Nielsen equivalence is deliberately
   582	    # not claimed as a cheap relabelling invariant.
   583	    canonical = min(
   584	        _canonical_serial(inst, ambient, variable)
   585	        for ambient in _SIGNED_MAPS
   586	        for variable in _SIGNED_MAPS
   587	    )
   588	    return hashlib.sha256(canonical.encode("ascii")).hexdigest()
