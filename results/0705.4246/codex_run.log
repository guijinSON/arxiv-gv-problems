   614	def _decode_column_sum(p, q):
   615	    """Recover the unique nonnegative unimodular columns summing to (p,q)."""
   616	    if p <= 0 or q <= 0 or math.gcd(p, q) != 1:
   617	        return None
   618	    if q == 1:
   619	        second = (p - 1, 1)
   620	    else:
   621	        d = pow(p, -1, q)
   622	        second = ((p * d - 1) // q, d)
   623	    first = (p - second[0], q - second[1])
   624	    if first[0] * second[1] - first[1] * second[0] != 1:
   625	        return None
   626	    left = list(first)
   627	    right = list(second)
   628	    reversed_moves = []
   629	    while left != [1, 0] or right != [0, 1]:
   630	        if left[0] >= right[0] and left[1] >= right[1]:
   631	            left[0] -= right[0]
   632	            left[1] -= right[1]
   633	            reversed_moves.append("L")
   634	        elif right[0] >= left[0] and right[1] >= left[1]:
   635	            right[0] -= left[0]
   636	            right[1] -= left[1]
   637	            reversed_moves.append("R")
   638	        else:
   639	            return None
   640	        if len(reversed_moves) > 64:
   641	            return None
   642	    return "".join(reversed(reversed_moves))
