   654	def _compact_solve(inst):
   655	    formal = _decode(inst["w"], formal=True)
   656	    operations = 0
   657	    for ambient_normalizer, t in _normalizers_for_target(inst):
   658	        operations += 8
   659	        ambient_denormalizer = _inverse_signed_map(ambient_normalizer)
   660	        _, base_pair = _base_target_and_solution(t)
   661	        for variable_normalizer in _SIGNED_MAPS:
   662	            normalized = _apply_signed_word(formal, variable_normalizer)
   663	            sx = sum(1 if z == 1 else -1 if z == -1 else 0 for z in normalized)
   664	            sy = sum(1 if z == 2 else -1 if z == -2 else 0 for z in normalized)
   665	            operations += 6
   666	            sequence = _decode_column_sum(sx, sy)
   667	            if sequence is None:
   668	                continue
   669	            images = _forward_nielsen_images(sequence)
   670	            operations += 2 * len(sequence) + 4
   671	            if _substitute(_W1, images[0], images[1]) != normalized:
   672	                continue
   673	            positive_pair = _inverse_nielsen_values(base_pair, sequence)
   674	            variable_pair = _apply_signed_pair(variable_normalizer, positive_pair)
   675	            final_pair = tuple(
   676	                _apply_signed_word(word, ambient_denormalizer)
   677	                for word in variable_pair
   678	            )
