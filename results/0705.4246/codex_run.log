+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate [x,y]=u and carry its witness through conjugation."""
+    rank = params.pop("rank", 4)
+    rotation_min = params.pop("rotation_min", 5)
+    rotation_max = params.pop("rotation_max", 9)
+    conjugator_len = params.pop("conjugator_len", 3)
+    word_bound = params.pop("word_bound", n + 32)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    ints = (n, rank, rotation_min, rotation_max, conjugator_len, word_bound, seed)
+    if any(isinstance(v, bool) or not isinstance(v, int) for v in ints):
+        raise ValueError("all parameters and seed must be integers")
+    if n < 2 or n % 2:
+        raise ValueError("n must be an even integer at least 2")
+    if not 2 <= rank <= 8:
+        raise ValueError("rank must lie in 2..8")
+    if not 0 <= rotation_min <= rotation_max < 2 * n:
+        raise ValueError("rotation bounds must lie in 0..2n-1")
+    if conjugator_len < 0 or word_bound < 1:
+        raise ValueError("conjugator_len and word_bound are out of range")
