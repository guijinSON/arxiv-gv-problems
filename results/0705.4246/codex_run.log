+def random_candidate(inst, rng):
+    words = _word_count(inst["rank"], inst["max_word_len"])
+    first = rng.randrange(words)
+    second = rng.randrange(words - 1)
+    if second >= first:
+        second += 1
+    return [
+        _unrank_reduced_word(first, inst["rank"], inst["max_word_len"]),
+        _unrank_reduced_word(second, inst["rank"], inst["max_word_len"]),
+    ]
