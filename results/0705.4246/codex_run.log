   228	def _inverse_signed_map(mapping):
   229	    result = [0, 0]
   230	    for source, image in enumerate(mapping, 1):
   231	        target = abs(image)
   232	        result[target - 1] = source if image > 0 else -source
   233	    return tuple(result)
