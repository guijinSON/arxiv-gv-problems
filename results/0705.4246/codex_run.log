   604	def _parse_base_target(word):
   605	    for t in range(1, 128):
   606	        target, _ = _base_target_and_solution(t)
   607	        if target == word:
   608	            return t
   609	        if len(target) > len(word) + 2:
   610	            break
   611	    return None
