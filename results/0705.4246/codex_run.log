   278	def _forward_nielsen_images(sequence):
   279	    first, second = (1,), (2,)
   280	    for move in sequence:
   281	        if move == "L":
   282	            first = _multiply(first, second)
   283	        else:
   284	            second = _multiply(second, first)
   285	    return first, second
