   319	def _validate_parameters(n, min_switches, t_span, answer_cap):
   320	    values = (n, min_switches, t_span, answer_cap)
   321	    if any(not isinstance(value, int) or isinstance(value, bool) for value in values):
   322	        raise ValueError("all parameters must be integers")
   323	    if n < 0 or n > 24:
   324	        raise ValueError("n must lie between 0 and 24")
   325	    if min_switches < 0 or min_switches > max(0, n - 1):
   326	        raise ValueError("min_switches must lie between 0 and n-1")
   327	    if t_span < 1:
   328	        raise ValueError("t_span must be positive")
   329	    if answer_cap < 8:
   330	        raise ValueError("answer_cap is too small")
