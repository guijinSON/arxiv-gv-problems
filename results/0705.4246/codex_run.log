   452	def verify(inst: dict, answer: object) -> tuple[bool, str]:
   453	    if not isinstance(answer, dict):
   454	        return False, "answer must be a JSON object"
   455	    if set(answer) != {"x", "y"}:
   456	        return False, "answer must have exactly the fields x and y"
   457	    if not isinstance(answer["x"], str) or not isinstance(answer["y"], str):
   458	        return False, "x and y must both be strings"
   459	    for name in ("x", "y"):
   460	        word = answer[name]
   461	        expected_length = inst[name + "_length"]
   462	        if len(word) != expected_length:
   463	            return False, f"{name} must have length {expected_length}"
   464	        invalid = sorted(set(word) - set(_CHAR_TO_AMBIENT))
   465	        if invalid:
   466	            return False, f"{name} contains a symbol outside a,A,b,B"
   467	        if _counts(_decode(word)) != inst[name + "_counts"]:
   468	            return False, f"{name} has the wrong [a,A,b,B] multiplicities"
   469	    x_word = _decode(answer["x"])
   470	    y_word = _decode(answer["y"])
   471	    formal = _decode(inst["w"], formal=True)
   472	    target = _decode(inst["u"])
   473	    if formal is None or target is None:
   474	        return False, "instance contains a malformed word"
   475	    if _substitute(formal, x_word, y_word) != target:
   476	        return False, "the freely reduced substitution does not equal u"
   477	    return True, "ok"
