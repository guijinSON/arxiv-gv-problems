   547	def _transform_constraints_variable(inst, mapping):
   548	    inverse_map = _inverse_signed_map(mapping)
   549	    old = {
   550	        1: (inst["x_length"], list(inst["x_counts"])),
   551	        2: (inst["y_length"], list(inst["y_counts"])),
   552	    }
   553	    transformed = []
   554	    for image in inverse_map:
   555	        length, counts = old[abs(image)]
   556	        transformed.append((length, counts if image > 0 else _inverse_counts(counts)))
   557	    return transformed
