   532	def _transform_counts_ambient(counts, mapping):
   533	    result = [0, 0, 0, 0]
   534	    char_index = {letter: index for index, letter in enumerate(_COUNT_ORDER)}
   535	    for old_letter, amount in zip((1, -1, 2, -2), counts):
   536	        image = mapping[abs(old_letter) - 1]
   537	        if old_letter < 0:
   538	            image = -image
   539	        result[char_index[_AMBIENT_TO_CHAR[image]]] += amount
   540	    return result
