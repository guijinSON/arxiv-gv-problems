   247	def _base_words():
   248	    x = (1,)
   249	    y = (2,)
   250	    comm = _commutator(x, y)
   251	    w0 = _multiply(comm, comm, x)       # [x,y]^2 x from Section 3
   252	    w1 = _substitute(w0, (1, 2), (2,))  # one fixed Nielsen transform
   253	    return w0, w1
