+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list) or len(value) != 2:
+        return None
+    if not all(isinstance(v, str) for v in value):
+        return None
+    return value
+
+
+def verify(inst, answer):
+    if answer is None:
+        return False, "answer is absent"
+    if answer == []:
+        return False, "answer is empty"
+    if not isinstance(answer, list) or len(answer) != 2:
+        return False, "answer must be a two-word JSON list"
+    if not all(isinstance(v, str) for v in answer):
+        return False, "both words must be strings"
+    x, y = answer
+    if not x or not y or x == "1" or y == "1":
+        return False, "both words must be nonempty"
+    allowed = set(inst["alphabet"] + inst["alphabet"].upper())
+    if any(ch not in allowed for word in answer for ch in word):
+        return False, "invalid generator symbol"
+    if len(x) > inst["max_word_len"] or len(y) > inst["max_word_len"]:
+        return False, "word exceeds the stated length bound"
+    if _free_reduce(x) != x or _free_reduce(y) != y:
+        return False, "word is not freely reduced"
+    if x == y:
+        return False, "x and y must be distinct"
+    if _commutator(x, y) != _free_reduce(inst["target"]):
+        return False, "the reduced commutator does not equal the target"
+    return True, "ok"
+
+
+def _word_count(rank, bound):
+    if bound < 1:
+        return 0
+    return sum(2 * rank * (2 * rank - 1) ** (length - 1)
+               for length in range(1, bound + 1))
+
+
+@functools.lru_cache(maxsize=None)
+def _word_tables(rank, bound):
+    alphabet = _letters(rank) + _letters(rank).upper()
+    base = 2 * rank - 1
+    powers = tuple(base ** exponent for exponent in range(bound + 1))
+    cumulative = []
+    running = 0
+    for length in range(1, bound + 1):
+        running += 2 * rank * powers[length - 1]
+        cumulative.append(running)
+    choices = {
+        previous: tuple(ch for ch in alphabet if ch != _inverse_letter(previous))
+        for previous in alphabet
+    }
+    return alphabet, powers, tuple(cumulative), choices
+
+
+def _unrank_reduced_word(index, rank, bound):
+    alphabet, powers, cumulative, choices_by_previous = _word_tables(rank, bound)
+    total = cumulative[-1] if cumulative else 0
+    if not 0 <= index < total:
+        raise ValueError("word index out of range")
+    length = bisect.bisect_right(cumulative, index) + 1
+    if length > 1:
+        index -= cumulative[length - 2]
+    block = powers[length - 1]
+    first = index // block
+    index %= block
+    out = [alphabet[first]]
+    for position in range(1, length):
+        choices = choices_by_previous[out[-1]]
+        power = powers[length - position - 1]
+        digit, index = divmod(index, power)
+        out.append(choices[digit])
+    return "".join(out)
+
+
+def random_candidate(inst, rng):
+    rank, bound = inst["rank"], inst["max_word_len"]
+    alphabet, _powers, cumulative, choices_by_previous = _word_tables(rank, bound)
+
+    def uniform_digits(modulus, count):
+        digits = []
+        ceiling = (256 // modulus) * modulus
+        while len(digits) < count:
+            need = count - len(digits)
+            if hasattr(rng, "randbytes"):
+                raw = rng.randbytes(max(8, need + need // 8 + 2))
+            else:  # pragma: no cover - for older standard-library Random objects
+                raw = bytes(rng.getrandbits(8) for _ in range(max(8, need + 2)))
+            digits.extend(byte % modulus for byte in raw if byte < ceiling)
+        return digits[:count]
+
+    def draw_word():
+        # Length is weighted by its exact number of freely reduced words; within
+        # that length every successive legal letter is sampled uniformly.
+        length = bisect.bisect_right(cumulative, rng.randrange(cumulative[-1])) + 1
+        first = uniform_digits(len(alphabet), 1)[0]
+        transition_digits = uniform_digits(len(alphabet) - 1, length - 1)
+        out = [alphabet[first]]
+        for digit in transition_digits:
+            choices = choices_by_previous[out[-1]]
+            out.append(choices[digit])
+        return "".join(out)
+
+    first = draw_word()
+    second = draw_word()
+    while second == first:
+        second = draw_word()
+    return [first, second]
+
+
+def search_space(inst):
+    words = _word_count(inst["rank"], inst["max_word_len"])
+    return words * (words - 1)
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 200000:
+        return None
+    words = [_unrank_reduced_word(i, inst["rank"], inst["max_word_len"])
+             for i in range(_word_count(inst["rank"], inst["max_word_len"]))]
+    count = 0
+    for i, x in enumerate(words):
+        for j, y in enumerate(words):
+            if i != j and verify(inst, [x, y])[0]:
+                count += 1
+    return count
+
+
+def _normalise_signed_labels(word):
+    mapping = {}
+    next_label = 0
+    out = []
+    for ch in word:
+        base = ch.lower()
+        sign = 1 if ch.isupper() else 0
+        if base not in mapping:
+            mapping[base] = (next_label, sign)
+            next_label += 1
+        label, flip = mapping[base]
+        out.append(chr(ord("a") + label).upper() if sign ^ flip else
+                   chr(ord("a") + label))
+    return "".join(out)
+
+
+def canonical_key(inst):
+    """Canonical under conjugacy, inversion, and signed generator relabelling."""
+    core = _cyclic_core(inst["target"])
+    if not core:
+        normal = "1"
+    else:
+        candidates = []
+        for oriented in (core, _inverse(core)):
+            for shift in range(len(oriented)):
+                candidates.append(_normalise_signed_labels(
+                    oriented[shift:] + oriented[:shift]))
+        normal = min(candidates)
+    return f"r={inst['rank']}|B={inst['max_word_len']}|{normal}"
+
+
+def _reference_solve(inst):
+    """Exact cyclic Wicks-form matcher; never inspects inst['answer']."""
+    target = _free_reduce(inst["target"])
+    core, outer = _cyclic_reduce_with_conjugator(target)
+    operations = len(target)
+    length = len(core)
+    if length < 4 or length % 2:
+        return None, operations
+    half = length // 2
+
+    def equal_counted(left, right):
+        nonlocal operations
+        if len(left) != len(right):
+            operations += 1
+            return False
+        for a, b in zip(left, right):
+            operations += 1
+            if a != b:
+                return False
+        return True
+
+    for shift in range(length):
+        candidate_core = core[shift:] + core[:shift]
+        operations += 2 * length  # symbols copied by the two slices and concat
+        prefix = core[:shift]
+        for x_len in range(1, half):
+            x_inv = candidate_core[:x_len]
+            y_inv = candidate_core[x_len:half]
+            x0 = candidate_core[half:half + x_len]
+            y0 = candidate_core[half + x_len:]
+            if not equal_counted(x_inv, _inverse(x0)):
+                continue
+            if not equal_counted(y_inv, _inverse(y0)):
+                continue
+            # candidate_core = prefix^-1 core prefix, hence
+            # target = h^-1 candidate_core h for h=prefix^-1 outer.
+            by = _free_reduce(_inverse(prefix) + outer)
+            # A conjugator is defined only modulo left multiplication by the
+            # centralizer <candidate_core>.  Trying the neighbouring powers is
+            # the standard cyclic normalisation and recovers the short witness
+            # after a cut close to the end of the cyclic word.
+            for central_power in (_inverse(candidate_core), "", candidate_core):
+                normal_by = _free_reduce(central_power + by)
+                x = _conjugate(x0, normal_by)
+                y = _conjugate(y0, normal_by)
+                operations += (
+                    len(central_power) + len(by) + 2 * (len(x0) + len(y0))
+                )
+                candidate = [x, y]
+                if verify(inst, candidate)[0]:
+                    return candidate, operations
+    return None, operations
+
+
+def _attack_frequency(inst):
+    core = _cyclic_core(inst["target"])
+    bases = list(inst["alphabet"])
+    bases.sort(key=lambda b: -sum(ch.lower() == b for ch in core))
+    if len(bases) < 2:
+        return None
+    guess = []
+    for base in bases[:2]:
+        lo = core.count(base)
+        hi = core.count(base.upper())
+        guess.append(base if lo >= hi else base.upper())
+    return guess
+
+
+def _attack_equal_quarters(inst):
+    core = _cyclic_core(inst["target"])
+    if len(core) % 4:
+        return None
+    q = len(core) // 4
+    return [core[2 * q:3 * q], core[3 * q:]]
+
+
+def _attack_visible_prefix(inst):
+    core = _cyclic_core(inst["target"])
+    if len(core) % 2:
+        return None
+    half = len(core) // 2
+    best = 0
+    for size in range(1, half):
+        if core[:size] == _inverse(core[half:half + size]):
+            best = size
+        else:
+            break
+    if best == 0:
+        return None
+    return [core[half:half + best], core[half + best:]]
+
+
+def _relabel_word(word, mapping):
+    out = []
+    for ch in word:
+        mapped = mapping[ch.lower()]
+        out.append(_inverse_letter(mapped) if ch.isupper() else mapped)
+    return "".join(out)
+
+
+def _g8_variants(inst):
+    rank = inst["rank"]
+    alphabet = inst["alphabet"]
+    permuted = list(reversed(alphabet))
+    mapping = {
+        source: (target.upper() if i % 2 else target)
+        for i, (source, target) in enumerate(zip(alphabet, permuted))
+    }
+
+    relabelled = copy.deepcopy(inst)
+    relabelled["target"] = _relabel_word(inst["target"], mapping)
+    relabelled["answer"] = [_relabel_word(w, mapping) for w in inst["answer"]]
+
+    conjugated = copy.deepcopy(inst)
+    by = alphabet[0]
+    conjugated["target"] = _conjugate(inst["target"], by)
+    conjugated["answer"] = [_conjugate(w, by) for w in inst["answer"]]
+
+    inverted = copy.deepcopy(inst)
+    inverted["target"] = _inverse(inst["target"])
+    inverted["answer"] = [inst["answer"][1], inst["answer"][0]]
+
+    composed = copy.deepcopy(relabelled)
+    by2 = alphabet[-1].upper()
+    composed["target"] = _inverse(_conjugate(relabelled["target"], by2))
+    carried = [_conjugate(w, by2) for w in relabelled["answer"]]
+    composed["answer"] = [carried[1], carried[0]]
+    return [relabelled, conjugated, inverted, composed]
+
+
+def escalate(params):
+    harder = dict(params)
+    n = harder.get("n", 72)
+    if n >= 136:
+        return "cap_bound"
+    next_n = n + 16
+    next_rotation = harder.get("rotation_max", 9) + 2
+    next_conjugator = harder.get("conjugator_len", 4) + 1
+    # This raises the cyclic-cut haystack and the number of obscuring conjugator
+    # letters together. Beyond n=136 the carried witness approaches 256 letters.
+    if next_n > 136:
+        return "cap_bound"
+    harder["n"] = next_n
+    harder["rotation_min"] = harder.get("rotation_min", 7) + 1
+    harder["rotation_max"] = next_rotation
+    harder["conjugator_len"] = next_conjugator
+    harder["word_bound"] = max(harder.get("word_bound", 80) + 16, next_n)
+    return harder
+
+
+def selftest():
+    report = {}
+
+    failures = []
+    json_roundtrips = 0
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            attempts += 1
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            if not ok:
+                failures.append({"preset": preset, "seed": seed, "reason": why})
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_roundtrips += 1
+    report["G1_planted_verifies"] = {
+        "pass": not failures and json_roundtrips == attempts,
+        "attempts": attempts,
+        "failures": failures,
+        "json_roundtrips": json_roundtrips,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=314159, **ship_params)
+    x, y = inst["answer"]
+    corruptions = {
+        "drop": [x],
+        "swap": [y, x],
+        "duplicate": [x, x],
+        "empty": [],
+        "out_of_range": ["z", y],
+    }
+    cases = {}
+    reasons = []
+    for name, answer in corruptions.items():
+        ok, why = verify(inst, answer)
+        cases[name] = {"rejected": not ok, "reason": why}
+        reasons.append(why)
+    report["G2_rejects_corruption"] = {
+        "pass": all(c["rejected"] for c in cases.values()) and len(set(reasons)) == 5,
+        "cases": cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    model_reply = (
+        "I reduced the cyclic word and checked the substitution.\n```json\n"
+        f"<answer>{_answer_text(inst['answer'])}</answer>\n```"
+    )
+    parsed = parse_answer(model_reply)
+    report["G3_round_trip"] = {
+        "pass": parsed == inst["answer"] and parse_answer("garbage") is None,
+        "parsed_matches": parsed == inst["answer"],
+        "garbage_returns_none": parse_answer("garbage") is None,
+    }
+
+    samples = 200000
+    rng = random.Random(8675309)
+    hits = 0
+    for _ in range(samples):
+        if verify(inst, random_candidate(inst, rng))[0]:
+            hits += 1
+    report["G4_guess_resistance"] = {
+        "pass": hits / samples < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": hits / samples,
+        "structure_aware_space": search_space(inst),
+        "sampler": (
+            "uniform ordered pair of distinct nonempty freely reduced words within "
+            "the stated rank and length bound"
+        ),
+    }
+
+    reference_times = []
+    reference_ops = []
+    reference_solved = 0
+    for seed in range(800, 808):
+        trial = make_instance(seed=seed, **ship_params)
+        start = time.perf_counter()
+        candidate, operations = _reference_solve(trial)
+        reference_times.append(time.perf_counter() - start)
+        reference_ops.append(operations)
+        if candidate is not None and verify(trial, candidate)[0]:
+            reference_solved += 1
+    demo_inst = make_instance(seed=3, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo_inst)
+    median_time = statistics.median(reference_times)
+    median_ops = int(statistics.median(reference_ops))
+    report["G5_density_and_baseline"] = {
+        "pass": reference_solved == 8 and demo_count is not None,
+        "shipping_valid_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_observed_solution_fraction": hits / samples,
+        "demo_exact_solution_count": demo_count,
+        "baseline_wall_seconds": round(median_time, 6),
+        "baseline_symbol_operations": median_ops,
+    }
+
+    attack_results = {
+        "outlier_symbol_frequency": 0,
+        "greedy_equal_quarters": 0,
+        "random_restart_64": 0,
+        "in_context_visible_prefix": 0,
+    }
+    attack_attempts = 8
+    for seed in range(900, 900 + attack_attempts):
+        trial = make_instance(seed=seed, **ship_params)
+        candidates = {
+            "outlier_symbol_frequency": _attack_frequency(trial),
+            "greedy_equal_quarters": _attack_equal_quarters(trial),
+            "in_context_visible_prefix": _attack_visible_prefix(trial),
+        }
+        rrng = random.Random(100000 + seed)
+        random_hit = False
+        for _ in range(64):
+            if verify(trial, random_candidate(trial, rrng))[0]:
+                random_hit = True
+                break
+        candidates["random_restart_64"] = trial["answer"] if random_hit else None
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(trial, candidate)[0]:
+                attack_results[name] += 1
+    attacks = {
+        name: {"successes": successes, "attempts": attack_attempts}
+        for name, successes in attack_results.items()
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(v["successes"] == 0 for v in attacks.values()),
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "exact cyclic Wicks-form matcher",
+            "complexity": "O(L^3) worst-case symbol copying/comparison",
+            "median_wall_clock_sec": round(median_time, 6),
+            "median_operations": median_ops,
+            "operation_definition": "reduced symbols inspected, copied, or compared",
+            "solves": f"{reference_solved}/8, as expected",
+            "broader_result": (
+                "Ciobanu's polynomial-time two-generator endomorphism algorithm, "
+                "cited in the paper's Introduction"
+            ),
+        },
+    }
+
+    doubled = dict(ship_params)
+    doubled["n"] = 2 * ship_params["n"]
+    doubled["word_bound"] = max(2 * ship_params["word_bound"], doubled["n"] + 32)
+    doubled["rotation_min"] = ship_params["rotation_min"] + 2
+    doubled["rotation_max"] = ship_params["rotation_max"] + 4
+    doubled["conjugator_len"] = ship_params["conjugator_len"] + 2
+    bigger = make_instance(seed=2718, **doubled)
+    bigger_ok, bigger_why = verify(bigger, bigger["answer"])
+    report["G7_scales"] = {
+        "pass": bigger_ok and len(_cyclic_core(bigger["target"])) >
+        len(_cyclic_core(inst["target"])),
+        "shipping_n": ship_params["n"],
+        "doubled_n": doubled["n"],
+        "shipping_target_letters": len(inst["target"]),
+        "doubled_target_letters": len(bigger["target"]),
+        "doubled_verify_reason": bigger_why,
+        "shipping_space_bits": round(math.log2(search_space(inst)), 3),
+        "doubled_space_bits": round(math.log2(search_space(bigger)), 3),
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    g8_failures = []
+    unrelated = []
+    for seed in range(20):
+        original = make_instance(seed=5000 + seed, **ship_params)
+        key = canonical_key(original)
+        unrelated.append(key)
+        for number, variant in enumerate(_g8_variants(original)):
+            invariance_checks += 1
+            if canonical_key(variant) != key:
+                g8_failures.append({"seed": seed, "variant": number, "kind": "key"})
+            carried_checks += 1
+            if not verify(variant, variant["answer"])[0]:
+                g8_failures.append(
+                    {"seed": seed, "variant": number, "kind": "witness"})
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures and len(set(unrelated)) == 20,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": carried_checks,
+        "unrelated_attempts": 20,
+        "unrelated_distinct": len(set(unrelated)),
+        "symmetries": [
+            "signed generator relabelling",
+            "global conjugation",
+            "target inversion with x/y swap",
+            "composition of all three",
+        ],
+        "failures": g8_failures,
+    }
+
+    answer_chars = 0
+    answer_elements = 0
+    for seed in range(100):
+        trial = make_instance(seed=7000 + seed, **ship_params)
+        answer_chars = max(answer_chars, len(_answer_text(trial["answer"])))
+        answer_elements = max(answer_elements, sum(len(w) for w in trial["answer"]))
+    # Counting every generator letter as a token is conservative for ordinary BPEs.
+    answer_tokens = answer_elements + 8
+    intended_ops = 2 * len(_cyclic_core(inst["target"])) + 2 * ship_params[
+        "conjugator_len"] + 8
+    arms = copy.deepcopy(G9_RESULTS["arms"])
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = (placebo["solved"] / placebo["attempts"]
+                    if placebo["attempts"] else 0.0)
+    report["G9_no_tool_suitability"] = {
+        "pass": answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        value.get("pass", False) for key, value in report.items()
+        if key.startswith("G")
+    )
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["track"] = TRACK
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

