   743	def _mat_mul(left, right, p):
   744	    a, b, c, d = left
   745	    e, f, g, h = right
   746	    return (
   747	        (a * e + b * g) % p,
   748	        (a * f + b * h) % p,
   749	        (c * e + d * g) % p,
   750	        (c * f + d * h) % p,
   751	    )
   752	
   753	
   754	def _mat_inv(matrix, p):
   755	    a, b, c, d = matrix
   756	    return (d % p, -b % p, -c % p, a % p)
   757	
