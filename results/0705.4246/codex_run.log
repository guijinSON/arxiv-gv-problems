   645	def _normalizers_for_target(inst):
   646	    target = _decode(inst["u"])
   647	    for ambient_normalizer in _SIGNED_MAPS:
   648	        normalized = _apply_signed_word(target, ambient_normalizer)
   649	        t = _parse_base_target(normalized)
   650	        if t is not None:
   651	            yield ambient_normalizer, t
