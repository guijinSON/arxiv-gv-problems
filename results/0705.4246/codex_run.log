+"""Verified native free-group word-equation generator for arXiv:0705.4246."""
+
+from __future__ import annotations
+
+import copy
+import bisect
+import functools
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "On the cyclically reduced target, four blocks occur in the pattern "
+    "P^-1, Q^-1, P, Q around the circle."
+)
