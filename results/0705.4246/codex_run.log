+"""Verified native free-group word-equation generator for arXiv:0705.4246."""
+
+from __future__ import annotations
+
+import copy
+import bisect
+import functools
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+
+
