+    denorm = _inverse_signed_map(ambient_normalizer)
+    streams = [
+        itertools.cycle(_encode(_apply_signed_word(word, denorm)) or "a")
+        for word in guessed
+    ]
+    return {
+        "x": _fit_counts_from_stream(inst, "x", streams[0]),
+        "y": _fit_counts_from_stream(inst, "y", streams[1]),
+    }
 
 
