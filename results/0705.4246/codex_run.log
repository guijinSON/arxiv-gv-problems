   759	def _word_matrix(word, p):
   760	    result = (1, 0, 0, 1)
   761	    generators = {1: _HASH_A, 2: _HASH_B}
   762	    for letter in word:
   763	        matrix = generators[abs(letter)]
   764	        if letter < 0:
   765	            matrix = _mat_inv(matrix, p)
   766	        result = _mat_mul(result, matrix, p)
   767	    return result
