+def _mat_apply_signed_pair(mapping, pair, p):
+    result = []
+    for image in mapping:
+        matrix = pair[abs(image) - 1]
+        result.append(matrix if image > 0 else _mat_inv(matrix, p))
+    return tuple(result)
+
