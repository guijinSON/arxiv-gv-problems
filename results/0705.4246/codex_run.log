   560	def _canonical_serial(inst, ambient_map, variable_map):
   561	    w = _apply_signed_word(_decode(inst["w"], formal=True), variable_map)
   562	    u = _apply_signed_word(_decode(inst["u"]), ambient_map)
   563	    constraints = _transform_constraints_variable(inst, variable_map)
   564	    constraints = [
   565	        (length, _transform_counts_ambient(counts, ambient_map))
   566	        for length, counts in constraints
   567	    ]
   568	    payload = [
   569	        _encode(w, formal=True),
   570	        _encode(u),
   571	        constraints[0][0],
   572	        constraints[0][1],
   573	        constraints[1][0],
   574	        constraints[1][1],
   575	    ]
   576	    return json.dumps(payload, separators=(",", ":"))
