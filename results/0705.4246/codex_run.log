+        itertools.repeat(letter, inst[name + "_length"])
+        for letter in _COUNT_ORDER
+    )
+    for letter in itertools.chain(bounded, fallback):
+        if remaining.get(letter, 0):
+            output.append(letter)
+            remaining[letter] -= 1
+            if len(output) == inst[name + "_length"]:
+                return "".join(output)
