   431	def parse_answer(text: str) -> object | None:
   432	    if not isinstance(text, str):
   433	        return None
   434	    matches = re.findall(r"<answer>\s*(.*?)\s*</answer>", text, flags=re.I | re.S)
   435	    if not matches:
   436	        return None
   437	    body = matches[-1].strip()
   438	    if body.startswith("```"):
   439	        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
   440	        body = re.sub(r"\s*```$", "", body)
   441	    try:
   442	        answer = json.loads(body)
   443	    except (TypeError, ValueError):
   444	        return None
   445	    if not isinstance(answer, dict) or set(answer) != {"x", "y"}:
   446	        return None
   447	    if not all(isinstance(answer[key], str) for key in ("x", "y")):
   448	        return None
   449	    return {"x": answer["x"], "y": answer["y"]}
