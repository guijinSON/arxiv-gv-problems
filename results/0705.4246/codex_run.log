+"""Verified native free-group word-equation generator for arXiv:0705.4246."""
+
+from __future__ import annotations
+
+import copy
+import bisect
+import functools
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "On the cyclically reduced target, four blocks occur in the pattern "
+    "P^-1, Q^-1, P, Q around the circle."
+)
+PLACEBO_HINT: str = (
+    "Careful tracking of inverse letters and candidate block boundaries helps "
+    "when checking a proposed pair of words."
+)
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "algebra",
+    "object_regime": "finite_discrete",
+    "computational_core": "other",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "reduced words in a finite-rank free group",
+        "a two-variable orientable quadratic word equation [x,y]=u",
+    ],
+    "verification_operations": [
+        "formal word inversion",
+        "free reduction by adjacent inverse cancellation",
+        "exact reduced-word comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Recognize the cyclic four-block inverse pattern of a commutator; without "
+        "it, one must mechanically test cyclic cuts and two block boundaries."
+    ),
+    "hardness_basis": (
+        "Track B: the paper's Introduction cites Ciobanu's polynomial-time "
+        "two-generator endomorphism algorithm, while the implemented exact cyclic "
+        "Wicks-form matcher is O(L^3) symbol work; shipping measurements are filled "
+        "by selftest, and the compact four-block route uses at most 2L+O(1) exact "
+        "symbol operations."
+    ),
+    "max_answer_tokens": 190,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {
+        "n": 2,
+        "rank": 2,
+        "rotation_min": 0,
+        "rotation_max": 0,
+        "conjugator_len": 0,
+        "word_bound": 2,
+    },
+    "easy": {
+        "n": 72,
+        "rank": 4,
+        "rotation_min": 7,
+        "rotation_max": 9,
+        "conjugator_len": 4,
