   174	
   175	def _power(word, exponent):
   176	    if exponent < 0:
   177	        return _power(_inverse(word), -exponent)
   178	    result = ()
   179	    base = tuple(word)
   180	    # Straight repetition is deliberately used: shipping exponents are tiny,
   181	    # and it makes the exact work performed by the verifier transparent.
   182	    for _ in range(exponent):
   183	        result = _multiply(result, base)
   184	    return result
