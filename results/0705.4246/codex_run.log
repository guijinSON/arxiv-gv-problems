   591	def escalate(params: dict) -> dict | str | None:
   592	    current = dict(params)
   593	    if current["n"] >= 10:
   594	        return "cap_bound"
   595	    current["n"] += 1
   596	    current["min_switches"] = min(
   597	        current["n"] - 1, current.get("min_switches", 0) + 1
   598	    )
   599	    current["t_span"] = current.get("t_span", 3) + 1
   600	    current["answer_cap"] = min(250, current.get("answer_cap", 250) + 20)
   601	    return current
