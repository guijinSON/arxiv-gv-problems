+def _dih_mul(left, right, p=_DIHEDRAL_P):
+    # (r,s) denotes rotation^r * reflection^s in D_{2p}.
+    return ((left[0] + (-right[0] if left[1] else right[0])) % p,
+            left[1] ^ right[1])
