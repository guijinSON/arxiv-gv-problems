from math import isqrt

def comps(t):return (-(t*t+4*t+3),-(4*t*t-2*t),-(t*t+4*t-3))
def N(m,t,r):return 18*m*(t*t+1)**2-12*r*t*(t+1)
def bound(a,n):return isqrt(a*(n+1)-1)
def nearest(a,v,b):
 g=min(b,isqrt(max(0,a*v)))
 return min(range(max(0,g-2),min(b,g+2)+1),key=lambda x:(abs(x*x//a-v),x))
def greedy(m,t,r,ds):
 n=N(m,t,r); den=[m*d*d for d in ds]; bs=[bound(a,n) for a in den]
 ans=[0,0,0]; rem=n
 for rank,i in enumerate(sorted(range(3),key=lambda i:-den[i])):
  x=nearest(den[i],rem,bs[i])
  while x in ans[:i]+ans[i+1:] and x>0:x-=1
  ans[i]=x;rem-=x*x//den[i]
  if rem<0:rem=0
 if len(set(ans))<3:
