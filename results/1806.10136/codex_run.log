from math import isqrt

def N(m,t,r):return 18*m*(t*t+1)**2-12*r*t*(t+1)
def cbounds(a,n):
 lo=n//30; hi=9*n//10
 L=isqrt(a*lo)
 if L*L<a*lo:L+=1
 U=isqrt(a*(hi+1)-1)
 return L,U,lo,hi
def near(a,v,L,U):
 g=min(U,max(L,isqrt(max(0,a*v))))
 return min(range(max(L,g-3),min(U,g+3)+1),key=lambda x:(abs(x*x//a-v),x))
def greedy(m,t,r,ds):
 n=N(m,t,r); den=[m*d*d for d in ds]; B=[cbounds(a,n) for a in den]
 ans=[None]*3; rem=n
 order=sorted(range(3),key=lambda i:-den[i])
 for pos,i in enumerate(order):
  reserve=sum(B[j][2] for j in order[pos+1:])
  desired=max(B[i][2],min(B[i][3],rem-reserve))
  x=near(den[i],desired,B[i][0],B[i][1])
  while x in [v for v in ans if v is not None] and x>B[i][0]:x-=1
  ans[i]=x;rem-=x*x//den[i]
 return sum(x*x//a for x,a in zip(ans,den))==n,ans,rem,[(x*x//a) for x,a in zip(ans,den)],B
for ds in ([1,1,1],[1,1,2],[1,2,3]):
 print('ds',ds)
 for m in (5,7,19,127,251):
  outs=[greedy(m,t,1,ds)[0] for t in (12,28,40)]
  print(m,outs)
print(greedy(19,28,1,[1,2,3]))
