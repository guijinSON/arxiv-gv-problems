+
+def _reference_solve(inst: dict) -> tuple[list[int] | None, int, int]:
+    """Equation-(1.2) normalization plus monotone floor-square 3SUM."""
+    normalized = _normalization(inst)
+    if normalized is None:
+        return None, 0, 0
+    m, scales, operations = normalized
+    target = inst["target"]
+    upper = math.isqrt(m * (target + 1) - 1)
+    values = [u * u // m for u in range(upper + 1)]
+    operations += 2 * (upper + 1) + 2
+    comparisons = 0
+    for first in range(upper + 1):
+        left = first
+        right = upper
+        remaining = target - values[first]
+        operations += 1
+        while left <= right:
+            current = values[left] + values[right]
+            comparisons += 1
+            operations += 2
+            if current == remaining:
+                base = (first, left, right)
+                for perm in set(itertools.permutations(base)):
+                    answer = [scale * value for scale, value in zip(scales, perm)]
+                    operations += 6
+                    if verify(inst, answer)[0]:
+                        return answer, operations, comparisons
+                left += 1
+            elif current < remaining:
+                left += 1
+            else:
+                right -= 1
+    return None, operations, comparisons
+
+
+def _nearest_coordinate(denominator: int, desired_term: int, bound: int) -> int:
+    guess = min(bound, math.isqrt(max(0, denominator * desired_term)))
+    choices = range(max(0, guess - 2), min(bound, guess + 2) + 1)
+    return min(
+        choices,
+        key=lambda value: (abs(value * value // denominator - desired_term), value),
+    )
+
+
+def _attack_largest_denominator(inst: dict) -> list[int]:
+    index = max(range(3), key=lambda i: inst["denominators"][i])
+    answer = [0, 1, 2]
+    answer[index] = _nearest_coordinate(
+        inst["denominators"][index], inst["target"], inst["bounds"][index]
+    )
+    # Preserve pairwise distinctness if the nearest coordinate was tiny.
+    if len(set(answer)) < 3:
+        answer[(index + 1) % 3] = 3
+    return answer
+
+
+def _attack_greedy(inst: dict) -> list[int]:
+    answer = [0, 0, 0]
+    remaining = inst["target"]
+    for rank, index in enumerate(sorted(range(3), key=lambda i: -inst["denominators"][i])):
+        value = _nearest_coordinate(
+            inst["denominators"][index], remaining, inst["bounds"][index]
+        )
+        while value in answer[:index] + answer[index + 1:] and value > 0:
+            value -= 1
+        answer[index] = value
+        remaining -= value * value // inst["denominators"][index]
+        if remaining < 0:
+            remaining = 0
+    if len(set(answer)) < 3:
+        for index in range(3):
+            while answer.count(answer[index]) > 1 and answer[index] < inst["bounds"][index]:
+                answer[index] += 1
+    return answer
