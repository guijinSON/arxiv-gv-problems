+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer,
+        "parsed_equals_answer": parsed == answer,
+        "surrounding_prose_and_markdown": True,
+    }
+
+    trials = 200_000
+    guess_rng = random.Random(0x180610136)
