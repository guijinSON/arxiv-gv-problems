+def enumerate_all(inst: dict) -> int | None:
+    """Count all valid witnesses exactly when a two-coordinate scan is small."""
+    bounds = inst["bounds"]
+    order = sorted(range(3), key=lambda index: bounds[index])
+    i, j, k = order
+    work = (bounds[i] + 1) * (bounds[j] + 1)
+    if work > 2_000_000:
+        return None
+    target = inst["target"]
+    denominators = inst["denominators"]
+    third_counts: dict[int, list[int]] = {}
+    for z in range(bounds[k] + 1):
+        value = z * z // denominators[k]
