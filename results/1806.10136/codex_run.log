+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count_started = time.perf_counter()
+    demo_count = enumerate_all(demo)
+    demo_count_seconds = time.perf_counter() - demo_count_started
+
+    restart_started = time.perf_counter()
