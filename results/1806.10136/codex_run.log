+            - arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        )
+    representative_compact, representative_ops = _compact_solve(inst)
+    intended_operations = max(compact_operations + [representative_ops])
+    within_caps = (
+        answer_chars <= 2_000
+        and answer_elements <= 256
