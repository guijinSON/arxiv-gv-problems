+                    continue
+                changed_digits = list(digits)
+                changed_digits[i], changed_digits[j] = changed_digits[j], changed_digits[i]
+                changed = list(answer)
+                changed[index] = int("".join(changed_digits))
+                ok, reason = verify(inst, changed)
