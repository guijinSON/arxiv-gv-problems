+        blob = json.dumps(current["answer"], separators=(",", ":"))
+        measured_max_chars = max(measured_max_chars, len(blob))
+        measured_max_tokens = max(measured_max_tokens, math.ceil(len(blob) / 4))
+    report["profile_measurements"] = {
