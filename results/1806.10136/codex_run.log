+def _permute_instance(inst: dict, permutation: tuple[int, int, int]) -> dict:
+    changed = dict(inst)
+    for key in ("denominators", "lower_bounds", "bounds", "answer"):
+        changed[key] = [inst[key][index] for index in permutation]
+    return changed
