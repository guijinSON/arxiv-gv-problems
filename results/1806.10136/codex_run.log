+DIFFICULTY = {
+    "demo": {"n": 2, "core_bits": 3},
+    "easy": {"n": 28, "core_bits": 6},
+    "medium": {"n": 40, "core_bits": 7},
+    "hard": {"n": 56, "core_bits": 8},
+}
