+        candidate_attacks = {
+            "largest_denominator_outlier": _attack_largest_denominator(current),
+            "greedy_residual_largest_first": _attack_greedy(current),
+            "in_context_zero_residue_orthogonal_ansatz": (
+                _attack_zero_residue_identity(current)
