+
+    failures = []
+    invariance_checks = 0
+    real_checks = 0
+    composed_checks = 0
+    keys = []
+    for seed in range(20):
+        sample = make_instance(seed=12_000 + seed, **shipping)
+        key = canonical_key(sample)
+        keys.append(key)
+        rng = random.Random(22_000 + seed)
