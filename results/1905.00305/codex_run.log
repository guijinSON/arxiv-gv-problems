 o=list(range(len(sets)));r.shuffle(o);ss=[sets[i] for i in o];tt=[tags[i] for i in o]
 return ss,sorted(i for i,x in enumerate(tt) if x==0)
def valid(ss,ch,k,w):
 if len(ch)"'!=k:return False
 ct=[0]*(k*w)
