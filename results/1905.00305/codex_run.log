def gen(k=13,r=7,L=10,seed=0):
 rng=random.Random(seed)
 bases=[]
 seen=set()
 while len(bases)<L+1:
  b=tuple(rng.randrange(k) for _ in range(r))
  norm=tuple((x-b[0])%k for x in b)
  if norm not in seen:
   seen.add(norm); bases.append(b)
 sets=[]; tags=[]
 for oi,b in enumerate(bases):
  shifts=list(range(k))
  if oi: shifts.remove(rng.randrange(k))
  for s in shifts:
   sets.append(tuple(c*k+(b[c]+s)%k for c in range(r))); tags.append((oi,s))
 order=list(range(len(sets))); rng.shuffle(order)
 sets=[sets[i] for i in order]; tags=[tags[i] for i in order]
 ans=sorted(i for i,t in enumerate(tags) if t[0]==0)
 return sets,ans,tags

def solve(sets,U,limit=1000000, order_mode='min'):
 contain=[[] for _ in range(U)]
 for i,S in enumerate(sets):
  for e in S: contain[e].append(i)
 uncovered=set(range(U)); chosen=[]; nodes=0
 def rec():
  nonlocal nodes
  nodes+=1
  if nodes>limit:return None
  if not uncovered:return chosen[:]
  e=min(uncovered,key=lambda x:sum(1 for i in contain[x] if all(y in uncovered for y in sets[i])))
  opts=[i for i in contain[e] if all(y in uncovered for y in sets[i])]
  # natural ids
  for i in opts:
   chosen.append(i); uncovered.difference_update(sets[i])
   z=rec()
   if z is not None:return z
   uncovered.update(sets[i]);chosen.pop()
  return None
 t=time.perf_counter(); z=rec(); return z,nodes,time.perf_counter()-t
for k,r,L in [(7,4,3),(11,6,6),(13,7,10),(17,8,12),(19,9,15),(23,10,20)]:
