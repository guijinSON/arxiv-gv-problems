+    for set_id, row in enumerate(inst["sets"], 1):
+        values = [0] * width
+        for element in row:
+            column, value = divmod(element, n)
+            if 0 <= column < width:
+                values[column] = value
+        lines.append(f"{set_id}: " + " ".join(map(str, values)))
+    lines.extend([
+        "",
