+        f"of exactly {n} increasing set IDs.",
+        "Format example only (shown with three IDs): <answer>[1, 4, 9]</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
