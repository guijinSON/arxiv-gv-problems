+DIFFICULTY = {
+    "demo": {"n": 3, "decoy_orbits": 1, "width": 2},
+    "easy": {"n": 13, "decoy_orbits": 8, "width": 6},
+    "medium": {"n": 17, "decoy_orbits": 11, "width": 6},
