+    for base in (2, 325, 9375, 28178, 450775, 9780504, 1795265022):
+        a = base % value
+        if a == 0:
+            continue
+        x = pow(a, d, value)
+        if x in (1, value - 1):
+            continue
+        for _ in range(s - 1):
+            x = x * x % value
+            if x == value - 1:
+                break
