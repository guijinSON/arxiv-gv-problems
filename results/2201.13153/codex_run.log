+    output = []
+    low = 1 << (inst["factor_bits"] - 1)
+    for row in inst["rows"]:
+        found = None
+        divisor = 3
+        while divisor <= limit:
+            if row["N"] % divisor == 0:
+                found = divisor
+                break
+            divisor += 2
+        output.append(found if found is not None else low + 1)
+    return output
