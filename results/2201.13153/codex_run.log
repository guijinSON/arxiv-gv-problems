+            invariance_checks += canonical_key(transformed) == key
+            carried_witness_checks += verify(transformed, carried)[0]
+    unrelated_keys = {
+        canonical_key(make_instance(seed=1000 + seed, **shipping_params))
+        for seed in range(20)
