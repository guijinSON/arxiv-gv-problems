+        "shipping_n": shipping_params["n"],
+        "doubled_n": doubled_params["n"],
+        "shipping_reference_operations": median_operations,
+        "doubled_reference_operations": doubled_operations,
+        "doubled_verify_reason": doubled_reason,
+    }
