+    T = _random_prime(factor_bits - c, rng, residue4=3)
+    rows = []
+    answer = []
+    used_primes: set[int] = set()
+    for _ in range(n):
+        row, smaller = _make_row(factor_bits, c, T, rng, used_primes)
+        cofactor = row["N"] // smaller
+        used_primes.update((smaller, cofactor))
+        rows.append(row)
+        answer.append(smaller)
