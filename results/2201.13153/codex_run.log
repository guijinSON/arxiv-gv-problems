+def _fermat_factor(value: int, iterations: int) -> tuple[int | None, int]:
+    a = _ceil_sqrt(value)
+    for node in range(1, iterations + 1):
+        b2 = a * a - value
+        b = math.isqrt(b2)
+        if b * b == b2:
+            factor = a - b
+            if 1 < factor < value and value % factor == 0:
+                return min(factor, value // factor), node
+        a += 1
+    return None, iterations
