+def _build_wheel_prefix() -> tuple[int, ...]:
+    count = 0
+    prefix = []
+    for value in range(_WHEEL):
+        count += math.gcd(value, _WHEEL) == 1
+        prefix.append(count)
+    return tuple(prefix)
