+def _reference_algorithm(inst) -> tuple[list[int], int]:
+    answer = []
+    operations = 0
+    for row in inst["rows"]:
+        factor, row_operations = _recover_row(inst["T"], row)
+        answer.append(factor)
+        operations += row_operations
+    return answer, operations
+
