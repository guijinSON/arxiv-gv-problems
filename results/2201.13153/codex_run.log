+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["all_passed"] = all(
+        result.get("pass", False)
+        for name, result in report.items()
+        if name.startswith("G") and name[1:2].isdigit()
+    )
+    return report
