+}
+
+DIFFICULTY = {
+    "demo": {"n": 16, "coordinate_bits": 5},
+    "easy": {"n": 256, "coordinate_bits": 16},
+    "medium": {"n": 512, "coordinate_bits": 16},
+    "hard": {"n": 1024, "coordinate_bits": 16},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "XOR the coordinate vectors in a closed neighborhood: these local "
+    "signatures span the kernel of the hidden three-row coloring map."
+)
+PLACEBO_HINT = (
+    "Keep careful track of the coordinate order and vertex indices: all "
+    "calculations in this problem use exact binary arithmetic."
+)
