   642	def _decode_answer(inst: dict, answer: object
   643	                   ) -> tuple[list[int] | None, int | None, str | None]:
   644	    d = inst["coordinate_bits"]
   645	    if not isinstance(answer, dict) or set(answer) != {"matrix", "offset"}:
   646	        return None, None, "answer must be a JSON object with exactly matrix and offset"
   647	    matrix = answer["matrix"]
   648	    offset = answer["offset"]
   649	    if not isinstance(matrix, list) or len(matrix) != _ROWS:
   650	        return None, None, "matrix must contain exactly three rows"
   651	    if not isinstance(offset, list) or len(offset) != _ROWS:
   652	        return None, None, "offset must contain exactly three bits"
   653	    if any(not isinstance(row, list) or len(row) != d for row in matrix):
   654	        return None, None, f"each matrix row must contain exactly {d} bits"
   655	    flat = [value for row in matrix for value in row] + list(offset)
   656	    if any(isinstance(value, bool) or not isinstance(value, int)
   657	           or value not in (0, 1) for value in flat):
   658	        return None, None, "all matrix and offset entries must be integer bits 0 or 1"
   659	    masks = [sum(value << j for j, value in enumerate(row)) for row in matrix]
   660	    if _rank(masks, d) != _ROWS:
   661	        return None, None, "the three matrix rows must be linearly independent"
   662	    offset_value = sum(value << j for j, value in enumerate(offset))
   663	    return masks, offset_value, None
