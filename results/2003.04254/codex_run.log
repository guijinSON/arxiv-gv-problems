   683	    target = set(range(_COLORS))
   684	    for v in range(inst["n"]):
   685	        seen = {color(v)} | {color(w) for w in adj[v]}
   686	        if seen != target:
   687	            return False, f"closed neighborhood of vertex {v} does not contain all eight colors"
   688	    return True, "ok"
