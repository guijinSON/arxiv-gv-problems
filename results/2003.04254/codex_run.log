+
+def _adjacency(inst: dict) -> list[list[int]]:
+    n = inst["n"]
+    adj = [[] for _ in range(n)]
+    for edge in inst["edges"]:
+        u, v = edge
+        adj[u].append(v)
+        adj[v].append(u)
+    for row in adj:
+        row.sort()
+    return adj
+
+
+def _is_connected(n: int, edges: list[list[int]]) -> bool:
+    adj = [[] for _ in range(n)]
+    for u, v in edges:
+        adj[u].append(v)
+        adj[v].append(u)
+    seen = {0}
+    queue = deque([0])
+    while queue:
+        v = queue.popleft()
+        for w in adj[v]:
+            if w not in seen:
