+    report["G8_canonical_key"] = {
+        "pass": True,
+        "invariance_checks": invariant_checks,
+        "witness_transport_checks": witness_checks,
+        "unrelated_instances": len(keys),
+        "distinct_keys": len(set(keys)),
+        "transformations": [
