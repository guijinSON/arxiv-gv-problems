+    hinted_rate = (_G9_ARMS["hinted"]["solved"]
+                   / max(1, _G9_ARMS["hinted"]["attempts"]))
+    placebo_rate = (_G9_ARMS["placebo"]["solved"]
+                    / max(1, _G9_ARMS["placebo"]["attempts"]))
+    report["G9_no_tool_suitability"] = {
