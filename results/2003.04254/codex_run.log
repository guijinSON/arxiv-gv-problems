def _parity(x: int) -> int:
    return x.bit_count() & 1


def _mask_to_row(mask: int, d: int) -> list[int]:
    return [(mask >> j) & 1 for j in range(d)]


def _rank(masks: list[int], d: int) -> int:
    basis: dict[int, int] = {}
    for value in masks:
        x = value & ((1 << d) - 1)
        while x:
            pivot = x.bit_length() - 1
            if pivot not in basis:
                basis[pivot] = x
                break
            x ^= basis[pivot]
    return len(basis)


def _rref_nullspace(rows: list[int], width: int) -> tuple[list[int], dict]:
    """Exact GF(2) nullspace using packed integer rows."""
    work = [row & ((1 << width) - 1) for row in rows]
    rank = 0
    pivots: list[int] = []
    bit_tests = 0
    row_xors = 0
    swaps = 0
    for col in range(width):
        pivot = None
        for i in range(rank, len(work)):
            bit_tests += 1
            if (work[i] >> col) & 1:
                pivot = i
                break
        if pivot is None:
            continue
        if pivot != rank:
            work[rank], work[pivot] = work[pivot], work[rank]
            swaps += 1
        for i in range(len(work)):
            if i == rank:
                continue
            bit_tests += 1
            if (work[i] >> col) & 1:
                work[i] ^= work[rank]
                row_xors += 1
        pivots.append(col)
        rank += 1
        if rank == len(work):
            break
    reduced = work[:rank]
    pivot_set = set(pivots)
    free = [j for j in range(width) if j not in pivot_set]
    nullspace: list[int] = []
    back_substitutions = 0
    for free_col in free:
        vector = 1 << free_col
        for row, pivot_col in zip(reduced, pivots):
            back_substitutions += 1
            if (row >> free_col) & 1:
                vector |= 1 << pivot_col
        nullspace.append(vector)
    stats = {
        "rank": rank,
        "nullity": len(nullspace),
        "bit_tests": bit_tests,
        "row_xors": row_xors,
        "row_swaps": swaps,
        "back_substitutions": back_substitutions,
        "packed_exact_operations": (
            bit_tests + row_xors + swaps + back_substitutions
        ),
    }
    return nullspace, stats


def _validate_params(n: int, coordinate_bits: int) -> None:
    if isinstance(n, bool) or not isinstance(n, int):
        raise ValueError("n must be an integer")
    if n < 16 or n % _COLORS:
        raise ValueError("n must be a multiple of 8 and at least 16")
    if isinstance(coordinate_bits, bool) or not isinstance(coordinate_bits, int):
        raise ValueError("coordinate_bits must be an integer")
    if coordinate_bits < 5 or coordinate_bits > 24:
        raise ValueError("coordinate_bits must lie in 5..24")
    if n // _COLORS > (1 << (coordinate_bits - _ROWS)):
        raise ValueError("not enough distinct coordinates in each affine fibre")
    if n < coordinate_bits - 1:
        raise ValueError("n must supply at least d-1 local signatures")


def _dense_independent_rows(rng: random.Random, d: int) -> list[int]:
    lo = max(2, d // 3)
    hi = min(d - 1, (2 * d + 2) // 3)
    while True:
        rows = [rng.randrange(1, 1 << d) for _ in range(_ROWS)]
        combinations = [rows[0], rows[1], rows[2],
                        rows[0] ^ rows[1], rows[0] ^ rows[2],
                        rows[1] ^ rows[2], rows[0] ^ rows[1] ^ rows[2]]
# Affine fall-coloring generator for arXiv:2003.04254

| profile field | value |
|---|---|
| track | **B — no-tool compression** |
| native domain | combinatorics |
| object regime | finite field |
| computational core | graph |
| certificate form | matrix certificate |
| intuition | invariant: closed-neighborhood coordinate XORs lie in the hidden coloring map's kernel |
| domain essentiality | native |
| reduction | none |

## Problem and trust model

This module instantiates the paper [*b-Coloring Parameterized by Clique-Width*](https://arxiv.org/abs/2003.04254), specifically the fall-coloring object in Section 3.6. A fall coloring is a proper coloring in which every vertex has a neighbor in every other color, so every vertex is a `b`-vertex. The solver receives a finite simple 7-regular graph, a distinct GF(2) coordinate for each vertex, and an affine coordinate frame. It must return a full-rank three-row binary matrix and a three-bit offset whose eight induced colors form a fall coloring. `verify` expands that map, checks every edge, and checks every closed neighborhood using exact binary arithmetic; it never reads the planted answer.

Generation is inverse. The module samples the affine certificate first, draws equally many coordinates in each of its eight fibers, and connects every pair of fibers by an independently shuffled perfect matching. Consequently each closed neighborhood contains one vertex of each color. Connectivity and promised presentation properties are checked during rejection sampling, but the answer is never obtained by solving the generated graph.

## Why Track B

This is deliberately not a Track A claim. The paper's Theorem 3.20 gives an `n^(2^O(w))` dynamic program when a module-width-`w` branch decomposition is supplied; Proposition 3.21 gives matching worst-case parameterized lower bounds, but says nothing about this generated distribution. Corollary 2.10 is FPT in vertex-cover number, and Corollary 2.11 is FPT for chordal graphs parameterized by the number of colors. Those results rule out pretending that every structured instance is hard.

For this distribution, a construction-specific polynomial algorithm exists and is disclosed: recover the cover fibers from the nullspace of adjacency-plus-identity over GF(2), then fit an affine projection. Packed exact Gaussian elimination costs `O(n^3/word_size)`. On eight shipping instances it solved 8/8 in 1.143 seconds and 15,757,327 packed exact operations, at most 1,978,355 on one instance. The compact route notices that the XOR of the eight coordinates in a closed neighborhood is killed by the coloring matrix; a handful of these signatures exposes its three-dimensional kernel. The measured compact route uses at most 253 packed exact operations. The benchmark tests whether a no-tool solver finds that invariant, not whether the instances defeat software.

