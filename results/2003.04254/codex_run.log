   627	def parse_answer(text: str) -> object | None:
   628	    if not isinstance(text, str):
   629	        return None
   630	    match = _ANSWER_RE.search(text)
   631	    if not match:
   632	        return None
   633	    payload = match.group(1).strip()
   634	    payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
   635	    payload = re.sub(r"\s*```$", "", payload)
   636	    try:
   637	        return json.loads(payload)
   638	    except (TypeError, ValueError, json.JSONDecodeError):
   639	        return None
