+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 500_000
+_COLORS = 8
+_ROWS = 3
+
+# Patched after the three hardening runs.  These values are diagnostics only;
+# they never affect generation or verification.
