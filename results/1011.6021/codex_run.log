+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "The three algebraic matchings share one projective point-image pair; use it "
+    "with two other rows to interpolate a projective transformation."
+)
