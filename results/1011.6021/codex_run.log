+    report["G3_round_trip"] = {
+        "pass": parsed == answer and parse_answer("not an answer") is None,
+        "parsed_fields": len(parsed) if isinstance(parsed, list) else None,
+        "garbage_returns_none": parse_answer("not an answer") is None,
