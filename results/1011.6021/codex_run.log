    report["G5_sparse"] = {
        "pass": valid_count is not None and fraction is not None and fraction < 1e-3,
        "n": 18,
        "valid_answers": valid_count,
        "candidate_space": enum_space,
        "fraction": fraction,
        "work_cap": _ENUMERATION_CAP,
    }

    # G6: four plant-aware cheap attacks, across eight seeds.
