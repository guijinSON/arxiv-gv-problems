-def render(inst) -> str:
-    B = "\n".join(" ".join(map(str, row)) for row in inst["bilinear_matrix"])
-    n = inst["n"]
-    N = inst["communication_dimension"]
-    text = f"""Exact coordinate certificate for a PSD-rank upper bound
-
-All vector and matrix arithmetic in this problem is over GF(2): addition and
-multiplication are reduced modulo 2. Let x and y range over all binary column
-vectors of length n={n}. The displayed invertible binary matrix B defines the
-{N} by {N} nonnegative communication matrix W_B implicitly by
-
-    W_B(x,y) = x^T B y mod 2.
-
-Thus every entry of W_B is the ordinary integer 0 or 1. The standard inner-
-product communication matrix is IP_n(x,z)=x^T z mod 2. A binary n by n matrix
-Q is a change-of-coordinate certificate when
-
-    B Q = I_n over GF(2).
-
-This equation is equivalent to W_B(x,Qz)=IP_n(x,z) for every binary x,z, so Q
-is an exact column relabelling that transports any PSD factorization of IP_n to
-W_B. Matrix B, one row per line, is:
-
-{B}
-
-Return one change-of-coordinate certificate Q. It must be a JSON array of
-exactly {n} rows, each containing exactly {n} integers. Each entry must be 0 or
-1; booleans are not accepted. Row and column positions are 0-based, their order
-is the displayed order, and repeated rows are not allowed. Ordinary matrix
-multiplication is used before reducing each entry modulo 2.
-
-Give your final answer inside <answer></answer> tags as one JSON object with the
-single key \"matrix\".
-Example format only: <answer>{{\"matrix\":[[1,0],[0,1]]}}</answer>
-Output nothing else inside the tags."""
-    mode = os.environ.get("GV_HINT_MODE")
-    if mode == "structural":
-        text += "\n\n" + STRUCTURAL_HINT
-    elif mode == "placebo":
-        text += "\n\n" + PLACEBO_HINT
-    return text
-
-
-def parse_answer(text) -> object | None:
-    if not isinstance(text, str):
-        return None
-    matches = _ANSWER_RE.findall(text)
-    if not matches:
-        return None
-    body = matches[-1].strip()
-    if body.startswith("```") and body.endswith("```"):
-        body = re.sub(r"^```(?:json|python)?\s*", "", body, flags=re.I)
-        body = re.sub(r"\s*```$", "", body).strip()
-    try:
-        obj = json.loads(body)
-    except (TypeError, ValueError, json.JSONDecodeError):
-        return None
-    return obj if isinstance(obj, dict) else None
-
-
-def verify(inst, answer) -> tuple[bool, str]:
-    """Check any exact inverse in the declared language; never read answer data."""
-    if not isinstance(answer, dict) or set(answer) != {"matrix"}:
-        return False, "answer must be an object with only the key 'matrix'"
-    Q = answer["matrix"]
-    if not isinstance(Q, list):
-        return False, "matrix must be a JSON array"
-    if not Q:
-        return False, "matrix is empty"
-    n = inst["n"]
-    if len(Q) != n:
-        return False, f"wrong row count: expected {n}, got {len(Q)}"
-    for i, row in enumerate(Q):
-        if not isinstance(row, list) or len(row) != n:
-            got = len(row) if isinstance(row, list) else "non-array"
-            return False, f"wrong width in row {i}: expected {n}, got {got}"
-        for j, value in enumerate(row):
-            if isinstance(value, bool) or not isinstance(value, int) or value not in (0, 1):
-                return False, f"entry ({i},{j}) is not the integer 0 or 1"
-    if len({tuple(row) for row in Q}) != n:
-        return False, "candidate matrix has duplicate rows and is singular"
-
-    B = inst["bilinear_matrix"]
-    for i in range(n):
-        for j in range(n):
-            value = 0
-            for k in range(n):
-                value ^= B[i][k] & Q[k][j]
-            expected = int(i == j)
-            if value != expected:
-                return False, f"B*Q differs from the identity at ({i},{j})"
-    return True, "ok"
-
-
-def _rank_bits(rows, n):
-    basis = [0] * n
-    rank = 0
-    for original in rows:
-        value = original
-        while value:
-            pivot = value.bit_length() - 1
-            if basis[pivot]:
-                value ^= basis[pivot]
-            else:
-                basis[pivot] = value
-                rank += 1
-                break
-    return rank
-
-
-def random_candidate(inst, rng) -> object:
-    """Uniformly sample GL(n,2), enforcing the obvious invertibility promise."""
-    if not isinstance(rng, random.Random):
-        raise TypeError("rng must be random.Random")
-    n = inst["n"]
-    basis = [0] * n
-    rows = []
-    while len(rows) < n:
-        original = rng.getrandbits(n)
-        value = original
-        while value:
-            pivot = value.bit_length() - 1
-            if basis[pivot]:
-                value ^= basis[pivot]
-            else:
-                basis[pivot] = value
-                rows.append(original)
-                break
-    matrix = [[(row >> j) & 1 for j in range(n)] for row in rows]
-    return {"matrix": matrix}
-
-
-def search_space(inst) -> int | None:
-    """Exact cardinality |GL(n,2)| of the structure-aware candidate language."""
-    n = inst["n"]
-    total = 1
-    size = 1 << n
-    for i in range(n):
-        total *= size - (1 << i)
-    return total
-
