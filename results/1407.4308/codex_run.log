-def search_space(inst) -> int | None:
-    """Exact cardinality |GL(n,2)| of the structure-aware candidate language."""
-    n = inst["n"]
-    total = 1
-    size = 1 << n
-    for i in range(n):
-        total *= size - (1 << i)
-    return total
