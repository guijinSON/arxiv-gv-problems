   157	
   158	# Five connected row/column-isomorphism classes in GL(3,2). Their inverses are
   159	# hard-coded beside them, so generation only transports and composes known
   160	# certificates; it never solves even a sampled local block.
   161	_BLOCKS = (
   162	    ((1, 1, 1), (0, 1, 0), (1, 0, 0)),
   163	    ((1, 0, 1), (1, 1, 0), (1, 0, 0)),
   164	    ((0, 1, 1), (1, 1, 0), (1, 0, 0)),
   165	    ((1, 1, 1), (1, 1, 0), (1, 0, 0)),
   166	    ((1, 1, 1), (1, 0, 1), (1, 1, 0)),
   167	)
