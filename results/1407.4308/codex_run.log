+def _levels_from_steps(steps):
+    levels = []
+    total = 0
+    for step in steps:
+        total += step * step
+        levels.append(total)
+    return levels
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a scaled covariance Gram matrix and its hidden order."""
+    if isinstance(n, bool) or not isinstance(n, int) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    scale_low = params.pop("scale_low", 11)
+    scale_high = params.pop("scale_high", 97)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if (isinstance(scale_low, bool) or isinstance(scale_high, bool)
+            or not isinstance(scale_low, int) or not isinstance(scale_high, int)
+            or scale_low < 1 or scale_high < scale_low):
+        raise ValueError("scale bounds must be positive integers with low <= high")
+
+    rng = random.Random(seed)
+
+    # The answer is chosen before C exists.  The distinguished anchor is also
+    # randomly labelled, so the construction has no fixed positional tell.
+    order = list(range(n))
+    rng.shuffle(order)
+    anchor = order[0]
+
+    # Perfect-square increments make the whitening matrix rational.  Varying
+    # them supplies genuine structural diversity not removable by relabelling
+    # or positive diagonal congruence.
+    steps = [1] + [rng.randrange(2, 10) for _ in range(n - 1)]
+    levels = _levels_from_steps(steps)
+    scales = [rng.randrange(scale_low, scale_high + 1) for _ in range(n)]
+    position = [0] * n
+    for k, observed in enumerate(order):
+        position[observed] = k
+
+    # C is the Gram matrix of scaled, nested step vectors.  Equivalently,
+    # C_ij = s_i s_j min(level_i, level_j), hence C is positive definite.
+    matrix = [
+        [
+            scales[i] * scales[j] * levels[min(position[i], position[j])]
+            for j in range(n)
+        ]
+        for i in range(n)
+    ]
+
+    return {
+        "family": "sparse congruence normalizer for a PSD Gram matrix",
+        "n": n,
+        "anchor": anchor,
+        "levels": levels,
+        "matrix": matrix,
+        "scale_bounds": [scale_low, scale_high],
+        "answer": order,
+    }
+
+
+def render(inst):
+    n = inst["n"]
+    anchor = inst["anchor"]
+    levels = inst["levels"]
+    upper = "\n".join(
+        f"  row {i}, columns {i}..{n - 1}: "
+        + " ".join(str(inst["matrix"][i][j]) for j in range(i, n))
+        for i in range(n)
+    )
+    statement = f"""Recover a sparse congruence normalizer of an exact PSD Gram matrix.
+
+All arithmetic is over the rational numbers; floating-point approximations are
+not allowed.  The supplied n-by-n integer matrix C is symmetric and positive
+definite.  Only its upper triangle is printed: on the line for row i, the first
+number is C[i,i], followed in order by C[i,i+1],...,C[i,n-1].
+
+The zero-based index a={anchor} is distinguished.  The following strictly
+increasing covariance levels are part of the instance:
+  {json.dumps(levels, separators=(',', ':'))}
+Write them as ell_1,...,ell_{n}.  Set ell_0=0 and let h_k be the
+positive integer square root of ell_k-ell_(k-1); every such difference is
+promised to be a perfect square.
+
+Your answer is a permutation pi=[pi_1,...,pi_{n}] of every index
+0,...,{n - 1}, with pi_1=a.  It compactly denotes an n-by-n rational matrix V.
+First set s_i=C[a,i]/sqrt(C[a,a]), using the positive square root (all s_i are
+promised positive integers).  Row 1 of V has the single nonzero entry
+
+  V[1,pi_1] = 1/(h_1*s_(pi_1)).
+
+For k=2,...,n, row k has exactly two nonzero entries
+
+  V[k,pi_k]     =  1/(h_k*s_(pi_k)),
+  V[k,pi_(k-1)] = -1/(h_k*s_(pi_(k-1))).
+
+All other entries of V are zero.  Find a permutation pi for which the exact
+matrix identity V C V^T = I_n holds.  This identity is the definition of a
+valid answer; order matters, indices cannot repeat, and the interval of allowed
+indices is inclusive at both endpoints.
+
+Upper triangle of C:
+{upper}
+
+Return exactly one JSON list of {n} decimal integers in zero-based chain order.
+Give your final answer inside <answer></answer> tags, as that JSON list.
+Example format (for n=4): <answer>[3,0,2,1]</answer>
