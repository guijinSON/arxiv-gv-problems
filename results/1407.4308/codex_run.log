   450	def _components_of_complement(B):
   451	    """Connected bipartite components of D=B+J, as (rows, columns)."""
   452	    n = len(B)
   453	    row_neighbors = [[j for j in range(n) if B[i][j] == 0] for i in range(n)]
   454	    col_neighbors = [[i for i in range(n) if B[i][j] == 0] for j in range(n)]
   455	    seen_rows, seen_cols = set(), set()
   456	    components = []
   457	    for start in range(n):
   458	        if start in seen_rows:
   459	            continue
   460	        rows, cols = set([start]), set()
   461	        queue = [(0, start)]
   462	        seen_rows.add(start)
   463	        while queue:
   464	            side, index = queue.pop()
   465	            if side == 0:
   466	                for j in row_neighbors[index]:
   467	                    if j not in seen_cols:
   468	                        seen_cols.add(j)
   469	                        cols.add(j)
   470	                        queue.append((1, j))
   471	            else:
   472	                for i in col_neighbors[index]:
   473	                    if i not in seen_rows:
   474	                        seen_rows.add(i)
   475	                        rows.add(i)
   476	                        queue.append((0, i))
   477	        components.append((sorted(rows), sorted(cols)))
   478	    return components
   479	
   480	
   481	def _canonical_block(A):
   482	    r = len(A)
   483	    c = len(A[0]) if A else 0
   484	    best = None
   485	    for rp in itertools.permutations(range(r)):
   486	        for cp in itertools.permutations(range(c)):
   487	            item = tuple(A[rp[i]][cp[j]] for i in range(r) for j in range(c))
   488	            if best is None or item < best:
   489	                best = item
   490	    return (r, c, best)
   491	
   492	
   493	def canonical_key(inst) -> str:
   494	    """Complete row/column-relabel invariant for this block-background family."""
   495	    B = inst["bilinear_matrix"]
   496	    block_keys = []
   497	    for rows, cols in _components_of_complement(B):
   498	        block = [[B[i][j] ^ 1 for j in cols] for i in rows]
   499	        block_keys.append(_canonical_block(block))
   500	    payload = (inst["n"], tuple(sorted(block_keys)))
   501	    raw = json.dumps(payload, separators=(",", ":")).encode()
   502	    return hashlib.sha256(raw).hexdigest()
