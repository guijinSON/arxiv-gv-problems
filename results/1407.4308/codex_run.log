   434	def enumerate_all(inst) -> int | None:
   435	    """Brute-force all binary matrices at the hand-scale demo only."""
   436	    n = inst["n"]
   437	    if n > 3:
   438	        return None
   439	    count = 0
   440	    for bits in range(1 << (n * n)):
   441	        rows = [sum(((bits >> (i * n + j)) & 1) << j for j in range(n))
   442	                for i in range(n)]
   443	        if _rank_bits(rows, n) != n:
   444	            continue
   445	        matrix = [[(rows[i] >> j) & 1 for j in range(n)] for i in range(n)]
   446	        count += int(verify(inst, {"matrix": matrix})[0])
   447	    return count
