+def _candidate_conditional_greedy(inst):
+    C = inst["matrix"]
+    anchor = inst["anchor"]
+    order = [anchor]
+    unused = set(range(inst["n"])) - {anchor}
+    while unused:
+        current = order[-1]
+        nxt = min(
+            unused,
+            key=lambda j: C[current][current] * C[j][j] - C[current][j] ** 2,
+        )
+        order.append(nxt)
+        unused.remove(nxt)
+    return order
