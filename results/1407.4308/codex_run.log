+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 4, "scale_low": 2, "scale_high": 9},
+    "easy": {"n": 56, "scale_low": 11, "scale_high": 97},
+    "medium": {"n": 64, "scale_low": 11, "scale_high": 97},
+    "hard": {"n": 72, "scale_low": 11, "scale_high": 97},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Squared correlations with the distinguished anchor are invariant under "
+    "the unknown diagonal scaling and coincide with the displayed covariance levels."
+)
+PLACEBO_HINT = (
+    "Exact rational bookkeeping and careful attention to the distinguished "
+    "index are important when checking the requested matrix identity."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A compact sparse-normalizer encoding: one JSON permutation of all n "
+        "zero-based indices, with the displayed anchor first; it denotes the "
+        "first-difference congruence matrix defined in the problem statement."
+    ),
+    "bounds": {
+        "length": "n",
+        "entry_min": 0,
+        "entry_max": "n-1",
+        "distinct": True,
+        "first_entry": "anchor",
+        "candidate_count": "(n-1)!",
+    },
+}
+
+NOTES = (
+    "Definition 1 fixes the native objects as PSD factors with trace products. "
+    "Lemma 17 fixes the relevant normalization: for a column-stochastic "
+    "factorization, C=sum_i C_i is made into the identity by a congruence, while "
+    "the opposite factors receive the inverse congruence and all trace products "
+    "are preserved.  Lemma 17 also answers STEP 0: diagonalization and scaling "
+    "produce a certificate efficiently, so this cannot be Track A.  The generator "
+    "therefore declares Track B and plants a diagonally scaled covariance Gram "
+    "matrix whose inverse has path support.  Exact dense inversion is the measured "
+    "mechanical algorithm; the compact route uses anchor-normalized squared "
+    "correlations.  Random diagonal scalings defeat diagonal magnitude, raw-anchor, "
+    "conditional-covariance greedy, and short partial-normalization attacks; random "
