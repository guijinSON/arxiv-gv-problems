   580	def _relabel_instance(inst, row_order, col_order):
   581	    """Carry B and Q through independent coordinate-axis relabellings."""
   582	    n = inst["n"]
   583	    if sorted(row_order) != list(range(n)) or sorted(col_order) != list(range(n)):
   584	        raise ValueError("orders must be permutations")
   585	    out = dict(inst)
   586	    B = inst["bilinear_matrix"]
   587	    Q = inst["answer"]["matrix"]
   588	    out["bilinear_matrix"] = [
   589	        [B[row_order[i]][col_order[j]] for j in range(n)] for i in range(n)
   590	    ]
   591	    out["answer"] = {"matrix": [
   592	        [Q[col_order[i]][row_order[j]] for j in range(n)] for i in range(n)
   593	    ]}
   594	    return out
