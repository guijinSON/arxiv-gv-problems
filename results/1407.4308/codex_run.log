   505	def escalate(params) -> dict | str | None:
   506	    n = params.get("n")
   507	    if isinstance(n, bool) or not isinstance(n, int) or n < 3 or n % 3:
   508	        return None
   509	    if n < 15:
   510	        return {"n": n + 3}
   511	    return "cap_bound"
