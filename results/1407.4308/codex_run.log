   529	def _attack_greedy_units(inst):
   530	    """Match public columns greedily to the closest identity columns."""
   531	    B = inst["bilinear_matrix"]
   532	    n = inst["n"]
   533	    unused = set(range(n))
   534	    chosen = []
   535	    for target in range(n):
   536	        col = min(
   537	            unused,
   538	            key=lambda k: (
   539	                sum(B[i][k] != int(i == target) for i in range(n)), k
   540	            ),
   541	        )
   542	        unused.remove(col)
   543	        chosen.append(col)
   544	    Q = [[0] * n for _ in range(n)]
   545	    for target, source_col in enumerate(chosen):
   546	        Q[source_col][target] = 1
   547	    return {"matrix": Q}
   548	
   549	
   550	def _attack_outlier_matching(inst):
   551	    """Pair rows and columns using only their individual zero counts."""
   552	    B = inst["bilinear_matrix"]
   553	    n = inst["n"]
   554	    row_order = sorted(range(n), key=lambda i: (B[i].count(0), i))
   555	    col_order = sorted(range(n), key=lambda j: (
   556	        sum(B[i][j] == 0 for i in range(n)), j
   557	    ))
   558	    Q = [[0] * n for _ in range(n)]
   559	    for r, c in zip(row_order, col_order):
   560	        Q[c][r] = 1
   561	    return {"matrix": Q}
