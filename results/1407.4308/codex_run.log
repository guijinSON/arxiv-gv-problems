+    "native_objects": [
+        "positive-definite Gram matrix over Q",
+        "sparse rational congruence normalizer",
+    ],
+    "verification_operations": [
+        "exact rational reconstruction of a sparse matrix",
+        "exact rational congruence",
+        "identity-matrix comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Normalize every diagonal against the distinguished anchor: the squared "
+        "anchor correlation exposes the hidden covariance level, while a solver "
+        "missing this change of variables must factor or invert a dense matrix."
+    ),
+    "hardness_basis": (
+        "Track B: Lemma 17 gives an efficient normalization by spectral change "
+        "of basis; the shipping reference algorithm instead performs exact "
+        "Gauss-Jordan inversion and path recovery in O(n^3), averaging 0.0 seconds "
+        "and 0 rational operations at the shipping preset before final audit, "
+        "whereas anchor normalization uses at most 221 exact operations."
