   402	def random_candidate(inst, rng) -> object:
   403	    """Uniformly sample GL(n,2), enforcing the obvious invertibility promise."""
   404	    if not isinstance(rng, random.Random):
   405	        raise TypeError("rng must be random.Random")
   406	    n = inst["n"]
   407	    basis = [0] * n
   408	    rows = []
   409	    while len(rows) < n:
   410	        original = rng.getrandbits(n)
   411	        value = original
   412	        while value:
   413	            pivot = value.bit_length() - 1
   414	            if basis[pivot]:
   415	                value ^= basis[pivot]
   416	            else:
   417	                basis[pivot] = value
   418	                rows.append(original)
   419	                break
   420	    matrix = [[(row >> j) & 1 for j in range(n)] for row in rows]
   421	    return {"matrix": matrix}
