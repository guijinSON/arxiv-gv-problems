-    rank = 0
-    for original in rows:
-        value = original
-        while value:
-            pivot = value.bit_length() - 1
-            if basis[pivot]:
-                value ^= basis[pivot]
-            else:
-                basis[pivot] = value
-                rank += 1
-                break
-    return rank
