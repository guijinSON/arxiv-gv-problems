python3 - <<'PY'
import ast, importlib.util, json, math, random, sys
p='gen_1407_4308.py'
t=ast.parse(open(p).read())
allowed={'__future__','hashlib','itertools','json','os','random','re','sys','time','gvlib'}
mods=[]
for n in ast.walk(t):
    if isinstance(n,ast.Import): mods += [a.name.split('.')[0] for a in n.names]
    elif isinstance(n,ast.ImportFrom) and n.module: mods.append(n.module.split('.')[0])
assert set(mods)<=allowed,(set(mods)-allowed)
s=importlib.util.spec_from_file_location('g',p);g=importlib.util.module_from_spec(s);s.loader.exec_module(g)
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.TRACK in ('A','B')
for name,params in g.DIFFICULTY.items():
  for seed in range(20):
    a=g.make_instance(seed=seed,**params);b=g.make_instance(seed=seed,**params)
    assert a==b
    assert json.loads(json.dumps(a['answer']))==a['answer']
    assert g.verify(a,a['answer'])==(True,'ok')
    wire=json.dumps(a['answer'],separators=(',',':'))
    assert g.parse_answer('prose\\n<answer>"'```json'"\\n'+wire+'\\n"'```</answer>'"\\nprose')==a['answer']
# Simulate the emit diversity loop over many fresh master seeds without writing.
fails=0; worst=99
for master in range(1000):
  rng=random.Random(master); seen=set(); tries=0
  while len(seen)<20 and tries<60:
    tries+=1
    seed=rng.randrange(1,2**31-1)
    seen.add(g.canonical_key(g.make_instance(seed=seed,**g.DIFFICULTY['hard'])))
  fails += len(seen)<20
  worst=min(worst,len(seen))
print('IMPORTS_OK',sorted(set(mods)))
print('PRESETS_DETERMINISTIC_JSON_ROUNDTRIP_80_80')
print('EMIT_SIM_FAILURES',fails,'OF_1000','MIN_UNIQUE',worst)
print('SELFTEST_ALL_PASSED',g.selftest()['all_passed'])
