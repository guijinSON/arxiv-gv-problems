+    root = math.isqrt(diagonal)
+    if root <= 0 or root * root != diagonal:
+        return None
+    scales = [Fraction(C[anchor][i], root) for i in range(inst["n"])]
+    if any(value <= 0 for value in scales):
+        return None
+    return scales
