   169	
   170	def _identity(n):
   171	    return [[int(i == j) for j in range(n)] for i in range(n)]
   172	
   173	
   174	def _invert_gf2(A, count_scalar_xors=False):
   175	    """Return the exact inverse and a transparent scalar-XOR operation count."""
   176	    n = len(A)
   177	    if n == 0 or any(len(row) != n for row in A):
   178	        return None, 0
   179	    rows = []
   180	    for i, row in enumerate(A):
   181	        left = sum((int(row[j]) & 1) << j for j in range(n))
   182	        rows.append(left | (1 << (n + i)))
   183	    operations = 0
   184	    for col in range(n):
   185	        pivot = next((r for r in range(col, n) if (rows[r] >> col) & 1), None)
   186	        if pivot is None:
   187	            return None, operations
   188	        rows[col], rows[pivot] = rows[pivot], rows[col]
   189	        for r in range(n):
   190	            if r != col and ((rows[r] >> col) & 1):
   191	                rows[r] ^= rows[col]
   192	                operations += 2 * n if count_scalar_xors else 1
   193	    inv = [[(rows[i] >> (n + j)) & 1 for j in range(n)] for i in range(n)]
   194	    return inv, operations
   195	
   196	
   197	_BLOCK_INVERSES = (
   198	    ((0, 0, 1), (0, 1, 0), (1, 1, 1)),
   199	    ((0, 0, 1), (0, 1, 1), (1, 0, 1)),
   200	    ((0, 0, 1), (0, 1, 1), (1, 1, 1)),
   201	    ((0, 0, 1), (0, 1, 1), (1, 1, 0)),
   202	    ((1, 1, 1), (1, 1, 0), (1, 0, 1)),
   203	)
   204	_BLOCK_SCALARS = tuple(
   205	    sum(sum(row) for row in inv) & 1 for inv in _BLOCK_INVERSES
   206	)
   207	_BLOCK_X_WEIGHTS = tuple(
   208	    sum(sum(row) & 1 for row in inv) for inv in _BLOCK_INVERSES
   209	)
   210	_BLOCK_Y_WEIGHTS = tuple(
   211	    sum(sum(inv[i][j] for i in range(3)) & 1 for j in range(3))
   212	    for inv in _BLOCK_INVERSES
   213	)
   214	
   215	
   216	def _valid_type_multisets(block_count):
   217	    """Canonical type multisets satisfying the rank-one invertibility parity."""
   218	    choices = []
   219	    for combo in itertools.combinations_with_replacement(range(len(_BLOCKS)),
   220	                                                          block_count):
   221	        if sum(_BLOCK_SCALARS[t] for t in combo) & 1:
   222	            continue
   223	        # At shippable sizes, keep the compact outer correction below 80 XORs.
   224	        xw = sum(_BLOCK_X_WEIGHTS[t] for t in combo)
   225	        yw = sum(_BLOCK_Y_WEIGHTS[t] for t in combo)
   226	        if block_count <= 5 and xw * yw > 80:
   227	            continue
   228	        choices.append(combo)
   229	    if not choices:
   230	        raise ValueError("no admissible block type multiset")
   231	    return choices
   232	
   233	
   234	def _permute_block(A, row_order, col_order):
   235	    return [[A[row_order[i]][col_order[j]] for j in range(3)] for i in range(3)]
   236	
   237	
   238	def make_instance(n, seed=0, **params) -> dict:
   239	    """Compose a known inverse, then publish the forward coordinate change."""
   240	    if params:
   241	        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
   242	    if isinstance(n, bool) or not isinstance(n, int) or n < 3 or n % 3:
   243	        raise ValueError("n must be an integer multiple of 3 and at least 3")
   244	    rng = random.Random(seed)
   245	    block_count = n // 3
   246	    type_choices = _valid_type_multisets(block_count)
   247	    types = list(rng.choice(type_choices))
   248	    rng.shuffle(types)
   249	
   250	    D = [[0] * n for _ in range(n)]
   251	    Dinv = [[0] * n for _ in range(n)]
   252	    for block_index, block_type in enumerate(types):
   253	        rp = list(range(3))
   254	        cp = list(range(3))
   255	        rng.shuffle(rp)
   256	        rng.shuffle(cp)
   257	        C = _permute_block(_BLOCKS[block_type], rp, cp)
   258	        # If C' = P C R^T, then (C')^-1 = R C^-1 P^T.
   259	        base_inv = _BLOCK_INVERSES[block_type]
   260	        Cinv = [[base_inv[cp[j]][rp[i]] for i in range(3)] for j in range(3)]
   261	        off = 3 * block_index
   262	        for i in range(3):
   263	            for j in range(3):
   264	                D[off + i][off + j] = C[i][j]
   265	                Dinv[off + j][off + i] = Cinv[j][i]
   266	
   267	    x = [sum(row) & 1 for row in Dinv]
   268	    y = [sum(Dinv[i][j] for i in range(n)) & 1 for j in range(n)]
   269	    if sum(x) & 1:
   270	        raise AssertionError("block parity failed to make the rank-one update invertible")
   271	    B = [[D[i][j] ^ 1 for j in range(n)] for i in range(n)]
   272	    Q = [[Dinv[i][j] ^ (x[i] & y[j]) for j in range(n)] for i in range(n)]
   273	
   274	    row_order = list(range(n))
   275	    col_order = list(range(n))
   276	    rng.shuffle(row_order)
   277	    rng.shuffle(col_order)
   278	    public_B = [[B[row_order[i]][col_order[j]] for j in range(n)] for i in range(n)]
   279	    public_Q = [[Q[col_order[i]][row_order[j]] for j in range(n)] for i in range(n)]
   280	
   281	    return {
   282	        "family": "GF(2) coordinate transport of the inner-product matrix",
   283	        "n": n,
   284	        "communication_dimension": 1 << n,
   285	        "field": 2,
   286	        "bilinear_matrix": public_B,
   287	        "psd_rank_upper_bound": (1 << (n // 2)) + (1 << (n - n // 2)) - 1,
   288	        "answer": {"matrix": public_Q},
   289	    }
   290	
