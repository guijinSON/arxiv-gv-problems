-        raise TypeError("rng must be random.Random")
-    n = inst["n"]
-    basis = [0] * n
-    rows = []
-    while len(rows) < n:
-        original = rng.getrandbits(n)
-        value = original
-        while value:
-            pivot = value.bit_length() - 1
-            if basis[pivot]:
-                value ^= basis[pivot]
-            else:
-                basis[pivot] = value
-                rows.append(original)
-                break
-    matrix = [[(row >> j) & 1 for j in range(n)] for row in rows]
-    return {"matrix": matrix}
