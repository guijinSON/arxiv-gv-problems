   625	def selftest() -> dict:
   626	    report = {}
   627	
   628	    planted_ok = 0
   629	    planted_total = 0
   630	    for preset, params in DIFFICULTY.items():
   631	        for seed in (0, 1, 2):
   632	            inst = make_instance(seed=seed, **params)
   633	            ok, _ = verify(inst, inst["answer"])
   634	            planted_ok += int(ok)
   635	            planted_total += 1
   636	    report["G1_planted_verifies"] = {
   637	        "pass": planted_ok == planted_total,
   638	        "verified": planted_ok,
   639	        "attempts": planted_total,
   640	    }
   641	
   642	    shipping = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
   643	    base = shipping["answer"]["matrix"]
   644	    drop = [row[:] for row in base]
   645	    drop[0] = drop[0][:-1]
   646	    swapped = None
   647	    for i in range(shipping["n"]):
