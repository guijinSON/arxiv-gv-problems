-def _reference_inverse(inst):
-    return _invert_gf2(inst["bilinear_matrix"], count_scalar_xors=True)
-
-
-def _attack_transpose(inst):
-    B = inst["bilinear_matrix"]
-    n = inst["n"]
-    return {"matrix": [[B[j][i] for j in range(n)] for i in range(n)]}
-
-
-def _attack_complement(inst):
-    B = inst["bilinear_matrix"]
-    return {"matrix": [[value ^ 1 for value in row] for row in B]}
-
-
-def _attack_greedy_units(inst):
-    """Match public columns greedily to the closest identity columns."""
-    B = inst["bilinear_matrix"]
-    n = inst["n"]
-    unused = set(range(n))
-    chosen = []
-    for target in range(n):
-        col = min(
-            unused,
-            key=lambda k: (
-                sum(B[i][k] != int(i == target) for i in range(n)), k
-            ),
-        )
-        unused.remove(col)
-        chosen.append(col)
-    Q = [[0] * n for _ in range(n)]
-    for target, source_col in enumerate(chosen):
-        Q[source_col][target] = 1
-    return {"matrix": Q}
-
-
-def _attack_outlier_matching(inst):
-    """Pair rows and columns using only their individual zero counts."""
-    B = inst["bilinear_matrix"]
-    n = inst["n"]
-    row_order = sorted(range(n), key=lambda i: (B[i].count(0), i))
-    col_order = sorted(range(n), key=lambda j: (
-        sum(B[i][j] == 0 for i in range(n)), j
-    ))
-    Q = [[0] * n for _ in range(n)]
-    for r, c in zip(row_order, col_order):
-        Q[c][r] = 1
-    return {"matrix": Q}
-
-
-def _attack_local_blocks(inst):
-    """Invert D=B+J blockwise but omit the essential rank-one correction."""
-    B = inst["bilinear_matrix"]
-    n = inst["n"]
-    Q = [[0] * n for _ in range(n)]
-    for rows, cols in _components_of_complement(B):
-        block = [[B[i][j] ^ 1 for j in cols] for i in rows]
-        inv, _ = _invert_gf2(block)
-        if inv is None:
-            return _attack_greedy_units(inst)
-        for j, public_col in enumerate(cols):
-            for i, public_row in enumerate(rows):
-                Q[public_col][public_row] = inv[j][i]
-    return {"matrix": Q}
-
-
-def _relabel_instance(inst, row_order, col_order):
-    """Carry B and Q through independent coordinate-axis relabellings."""
-    n = inst["n"]
-    if sorted(row_order) != list(range(n)) or sorted(col_order) != list(range(n)):
-        raise ValueError("orders must be permutations")
-    out = dict(inst)
-    B = inst["bilinear_matrix"]
-    Q = inst["answer"]["matrix"]
-    out["bilinear_matrix"] = [
-        [B[row_order[i]][col_order[j]] for j in range(n)] for i in range(n)
-    ]
-    out["answer"] = {"matrix": [
-        [Q[col_order[i]][row_order[j]] for j in range(n)] for i in range(n)
-    ]}
-    return out
-
-
-def _answer_atom_count(answer):
-    if not isinstance(answer, dict) or not isinstance(answer.get("matrix"), list):
-        return 0
-    return sum(len(row) for row in answer["matrix"] if isinstance(row, list))
-
-
-def _compact_route_operations(inst):
-    """Conservative scalar-op accounting for block inversion plus rank-one update."""
-    B = inst["bilinear_matrix"]
-    n = inst["n"]
-    Dinv = [[0] * n for _ in range(n)]
-    blocks = _components_of_complement(B)
-    for rows, cols in blocks:
-        block = [[B[i][j] ^ 1 for j in cols] for i in rows]
-        inv, _ = _invert_gf2(block)
-        if inv is None:
-            return 10**9
-        for j, public_col in enumerate(cols):
-            for i, public_row in enumerate(rows):
-                Dinv[public_col][public_row] = inv[j][i]
-    x = [sum(row) & 1 for row in Dinv]
-    y = [sum(Dinv[i][j] for i in range(n)) & 1 for j in range(n)]
-    # Nine 2-by-2 minors per 3-by-3 inverse, at three GF(2) ops each;
-    # two XORs for every local row and column parity, n-1 for the scalar
-    # denominator check, and one XOR for each entry toggled by xy^T.
-    return 27 * len(blocks) + 4 * n + (n - 1) + sum(x) * sum(y)
-
