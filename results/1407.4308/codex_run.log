+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == len(panel_seeds)
+        and compact_successes == len(panel_seeds),
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "exact Gauss-Jordan inverse followed by inverse-support path traversal",
+            "complexity": "O(n^3) exact rational operations",
+            "wall_clock_sec": round(reference_avg_seconds, 6),
+            "operations": reference_avg_operations,
+            "solves": f"{reference_successes}/{len(panel_seeds)}, as expected",
+        },
+        "intended_compact_route": {
