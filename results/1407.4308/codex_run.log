   424	def search_space(inst) -> int | None:
   425	    """Exact cardinality |GL(n,2)| of the structure-aware candidate language."""
   426	    n = inst["n"]
   427	    total = 1
   428	    size = 1 << n
   429	    for i in range(n):
   430	        total *= size - (1 << i)
   431	    return total
