   335	def parse_answer(text) -> object | None:
   336	    if not isinstance(text, str):
   337	        return None
   338	    matches = _ANSWER_RE.findall(text)
   339	    if not matches:
   340	        return None
   341	    body = matches[-1].strip()
   342	    if body.startswith("```") and body.endswith("```"):
   343	        body = re.sub(r"^```(?:json|python)?\s*", "", body, flags=re.I)
   344	        body = re.sub(r"\s*```$", "", body).strip()
   345	    try:
   346	        obj = json.loads(body)
   347	    except (TypeError, ValueError, json.JSONDecodeError):
   348	        return None
   349	    return obj if isinstance(obj, dict) else None
