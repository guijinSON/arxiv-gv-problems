   352	def verify(inst, answer) -> tuple[bool, str]:
   353	    """Check any exact inverse in the declared language; never read answer data."""
   354	    if not isinstance(answer, dict) or set(answer) != {"matrix"}:
   355	        return False, "answer must be an object with only the key 'matrix'"
   356	    Q = answer["matrix"]
   357	    if not isinstance(Q, list):
   358	        return False, "matrix must be a JSON array"
   359	    if not Q:
   360	        return False, "matrix is empty"
   361	    n = inst["n"]
   362	    if len(Q) != n:
   363	        return False, f"wrong row count: expected {n}, got {len(Q)}"
   364	    for i, row in enumerate(Q):
   365	        if not isinstance(row, list) or len(row) != n:
   366	            got = len(row) if isinstance(row, list) else "non-array"
   367	            return False, f"wrong width in row {i}: expected {n}, got {got}"
   368	        for j, value in enumerate(row):
   369	            if isinstance(value, bool) or not isinstance(value, int) or value not in (0, 1):
   370	                return False, f"entry ({i},{j}) is not the integer 0 or 1"
   371	    if len({tuple(row) for row in Q}) != n:
   372	        return False, "candidate matrix has duplicate rows and is singular"
   373	
   374	    B = inst["bilinear_matrix"]
   375	    for i in range(n):
   376	        for j in range(n):
   377	            value = 0
   378	            for k in range(n):
   379	                value ^= B[i][k] & Q[k][j]
   380	            expected = int(i == j)
   381	            if value != expected:
   382	                return False, f"B*Q differs from the identity at ({i},{j})"
   383	    return True, "ok"
