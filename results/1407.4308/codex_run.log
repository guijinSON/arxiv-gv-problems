   564	def _attack_local_blocks(inst):
   565	    """Invert D=B+J blockwise but omit the essential rank-one correction."""
   566	    B = inst["bilinear_matrix"]
   567	    n = inst["n"]
   568	    Q = [[0] * n for _ in range(n)]
   569	    for rows, cols in _components_of_complement(B):
   570	        block = [[B[i][j] ^ 1 for j in cols] for i in rows]
   571	        inv, _ = _invert_gf2(block)
   572	        if inv is None:
   573	            return _attack_greedy_units(inst)
   574	        for j, public_col in enumerate(cols):
   575	            for i, public_row in enumerate(rows):
   576	                Q[public_col][public_row] = inv[j][i]
   577	    return {"matrix": Q}
