+def _compact_route_operations(inst):
+    """Conservative scalar-op accounting for block inversion plus rank-one update."""
+    B = inst["bilinear_matrix"]
+    n = inst["n"]
+    Dinv = [[0] * n for _ in range(n)]
+    blocks = _components_of_complement(B)
+    for rows, cols in blocks:
+        block = [[B[i][j] ^ 1 for j in cols] for i in rows]
+        inv, _ = _invert_gf2(block)
+        if inv is None:
+            return 10**9
+        for j, public_col in enumerate(cols):
+            for i, public_row in enumerate(rows):
+                Dinv[public_col][public_row] = inv[j][i]
+    x = [sum(row) & 1 for row in Dinv]
+    y = [sum(Dinv[i][j] for i in range(n)) & 1 for j in range(n)]
+    # Nine 2-by-2 minors per 3-by-3 inverse, at three GF(2) ops each;
+    # two XORs for every local row and column parity, n-1 for the scalar
+    # denominator check, and one XOR for each entry toggled by xy^T.
+    return 27 * len(blocks) + 4 * n + (n - 1) + sum(x) * sum(y)
 
