+
+    # The answer is chosen before C exists.  The distinguished anchor is also
+    # randomly labelled, so the construction has no fixed positional tell.
+    order = list(range(n))
+    rng.shuffle(order)
+    anchor = order[0]
+
+    # Perfect-square increments make the whitening matrix rational.  Varying
+    # them supplies genuine structural diversity not removable by relabelling
+    # or positive diagonal congruence.
+    steps = [1] + [rng.randrange(2, 10) for _ in range(n - 1)]
+    levels = _levels_from_steps(steps)
+    scales = [rng.randrange(scale_low, scale_high + 1) for _ in range(n)]
+    position = [0] * n
+    for k, observed in enumerate(order):
+        position[observed] = k
+
+    # C is the Gram matrix of scaled, nested step vectors.  Equivalently,
+    # C_ij = s_i s_j min(level_i, level_j), hence C is positive definite.
+    matrix = [
+        [
+            scales[i] * scales[j] * levels[min(position[i], position[j])]
+            for j in range(n)
+        ]
+        for i in range(n)
+    ]
+
+    return {
+        "family": "sparse congruence normalizer for a PSD Gram matrix",
+        "n": n,
+        "anchor": anchor,
+        "levels": levels,
+        "matrix": matrix,
+        "scale_bounds": [scale_low, scale_high],
+        "answer": order,
+    }
+
+
+def render(inst):
+    n = inst["n"]
+    anchor = inst["anchor"]
+    levels = inst["levels"]
+    upper = "\n".join(
+        f"  row {i}, columns {i}..{n - 1}: "
+        + " ".join(str(inst["matrix"][i][j]) for j in range(i, n))
+        for i in range(n)
+    )
+    statement = f"""Recover a sparse congruence normalizer of an exact PSD Gram matrix.
+
+All arithmetic is over the rational numbers; floating-point approximations are
+not allowed.  The supplied n-by-n integer matrix C is symmetric and positive
+definite.  Only its upper triangle is printed: on the line for row i, the first
+number is C[i,i], followed in order by C[i,i+1],...,C[i,n-1].
+
+The zero-based index a={anchor} is distinguished.  The following strictly
+increasing covariance levels are part of the instance:
+  {json.dumps(levels, separators=(',', ':'))}
+Write them as ell_1,...,ell_{n}.  Set ell_0=0 and let h_k be the
+positive integer square root of ell_k-ell_(k-1); every such difference is
+promised to be a perfect square.
+
+Your answer is a permutation pi=[pi_1,...,pi_{n}] of every index
+0,...,{n - 1}, with pi_1=a.  It compactly denotes an n-by-n rational matrix V.
+First set s_i=C[a,i]/sqrt(C[a,a]), using the positive square root (all s_i are
+promised positive integers).  Row 1 of V has the single nonzero entry
+
+  V[1,pi_1] = 1/(h_1*s_(pi_1)).
+
+For k=2,...,n, row k has exactly two nonzero entries
+
+  V[k,pi_k]     =  1/(h_k*s_(pi_k)),
+  V[k,pi_(k-1)] = -1/(h_k*s_(pi_(k-1))).
+
+All other entries of V are zero.  Find a permutation pi for which the exact
+matrix identity V C V^T = I_n holds.  This identity is the definition of a
+valid answer; order matters, indices cannot repeat, and the interval of allowed
+indices is inclusive at both endpoints.
+
+Upper triangle of C:
+{upper}
+
+Return exactly one JSON list of {n} decimal integers in zero-based chain order.
+Give your final answer inside <answer></answer> tags, as that JSON list.
+Example format (for n=4): <answer>[3,0,2,1]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer>", re.I | re.S)
+
+
+def parse_answer(text):
+    """Parse a tagged JSON permutation, tolerating surrounding prose/fences."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
+    payload = re.sub(r"\s*```$", "", payload)
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list):
+        return None
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in value):
+        return None
+    return value
+
+
+def _validate_answer_shape(inst, answer):
+    n = inst["n"]
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer must not be empty"
+    if len(answer) != n:
+        return False, f"expected {n} indices, got {len(answer)}"
+    for k, value in enumerate(answer):
+        if isinstance(value, bool) or not isinstance(value, int):
+            return False, f"entry {k} is not an integer"
+        if value < 0 or value >= n:
+            return False, f"entry {k} is outside 0 <= index < {n}"
+    if len(set(answer)) != n:
+        return False, "indices must form a permutation without repeats"
+    if answer[0] != inst["anchor"]:
+        return False, "the distinguished anchor must be the first index"
+    return True, "ok"
+
+
+def _instance_scales(inst):
+    """Derive the positive rational diagonal scaling from the public anchor."""
+    C = inst["matrix"]
+    anchor = inst["anchor"]
+    diagonal = C[anchor][anchor]
+    root = math.isqrt(diagonal)
+    if root <= 0 or root * root != diagonal:
+        return None
+    scales = [Fraction(C[anchor][i], root) for i in range(inst["n"])]
+    if any(value <= 0 for value in scales):
+        return None
+    return scales
+
+
+def _step_roots(inst):
+    roots = []
+    previous = 0
+    for level in inst["levels"]:
+        delta = level - previous
+        root = math.isqrt(delta) if isinstance(delta, int) and delta >= 0 else -1
+        if root <= 0 or root * root != delta:
+            return None
+        roots.append(root)
+        previous = level
+    return roots
+
+
+def _normalizer_rows(inst, order, scales, roots):
+    """Sparse rows as {column: Fraction}; no dense answer is trusted."""
+    rows = []
+    for k, observed in enumerate(order):
+        denom = roots[k] * scales[observed]
+        row = {observed: Fraction(1, 1) / denom}
+        if k:
+            previous = order[k - 1]
+            row[previous] = -Fraction(1, 1) / (roots[k] * scales[previous])
+        rows.append(row)
+    return rows
+
+
+def _sparse_bilinear(row, C, col):
+    total = Fraction(0)
+    for i, left in row.items():
+        for j, right in col.items():
+            total += left * C[i][j] * right
+    return total
+
+
+def verify(inst, answer):
+    """Check a compact normalizer without consulting ``inst['answer']``."""
+    ok, reason = _validate_answer_shape(inst, answer)
+    if not ok:
+        return False, reason
+    n = inst["n"]
+    C = inst.get("matrix")
+    if (not isinstance(C, list) or len(C) != n
+            or any(not isinstance(row, list) or len(row) != n for row in C)):
+        return False, "instance matrix has the wrong shape"
+    anchor = inst["anchor"]
+    anchor_diagonal = C[anchor][anchor]
+    anchor_root = math.isqrt(anchor_diagonal)
+    if anchor_root <= 0 or anchor_root * anchor_root != anchor_diagonal:
+        return False, "instance anchor does not define positive rational scales"
+
+    # A cheap exact diagonal check rejects almost every random permutation before
+    # constructing scales or inspecting all O(n^2) instance/congruence entries.
+    for k, observed in enumerate(answer):
+        # Cross multiplication is equivalent to the rational scale equality and
+        # avoids allocating Fractions on the 200,000 random G4 candidates.
+        if (C[observed][observed] * anchor_root * anchor_root
+                != C[anchor][observed] * C[anchor][observed]
+                * inst["levels"][k]):
+            return False, f"normalizer diagonal mismatch at chain position {k}"
+
+    if any(C[i][j] != C[j][i] for i in range(n) for j in range(i + 1, n)):
+        return False, "instance matrix is not symmetric"
+    scales = _instance_scales(inst)
+    if scales is None:
+        return False, "instance anchor does not define positive rational scales"
+    roots = _step_roots(inst)
+    if roots is None or len(roots) != n:
+        return False, "instance levels do not have positive square increments"
+
+    rows = _normalizer_rows(inst, answer, scales, roots)
+    for i in range(n):
+        for j in range(i, n):
+            got = _sparse_bilinear(rows[i], C, rows[j])
+            expected = Fraction(1 if i == j else 0)
+            if got != expected:
+                return False, f"V C V^T mismatch at entry ({i},{j})"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the exact anchor-first permutation language."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    rest = [i for i in range(inst["n"]) if i != inst["anchor"]]
+    rng.shuffle(rest)
+    return [inst["anchor"]] + rest
+
+
+def search_space(inst):
+    return math.factorial(inst["n"] - 1)
+
+
+def enumerate_all(inst):
+    n = inst["n"]
+    if n > 9:
+        return None
+    rest = [i for i in range(n) if i != inst["anchor"]]
+    count = 0
+    for tail in itertools.permutations(rest):
+        if verify(inst, [inst["anchor"]] + list(tail))[0]:
+            count += 1
+    return count
+
+
+def _compact_solve(inst):
+    """Anchor-correlation route; returns (order, exact-operation count)."""
+    C = inst["matrix"]
+    anchor = inst["anchor"]
+    levels_to_position = {value: k for k, value in enumerate(inst["levels"])}
+    order = [None] * inst["n"]
+    order[0] = anchor
+    operations = 0
+    for observed in range(inst["n"]):
+        if observed == anchor:
+            continue
+        # q = C_aa*C_ii/C_ai^2; count multiply, square, division, lookup.
+        numerator = C[anchor][anchor] * C[observed][observed]
+        denominator = C[anchor][observed] * C[anchor][observed]
+        operations += 3
+        if denominator == 0 or numerator % denominator:
+            return None, operations
+        level = numerator // denominator
+        position = levels_to_position.get(level)
+        operations += 1
+        if position is None or order[position] is not None:
+            return None, operations
+        order[position] = observed
+    return order, operations
+
+
+def _inverse_gauss_jordan(matrix):
+    """Exact dense inverse and a scalar rational-operation count."""
+    n = len(matrix)
+    work = [
+        [Fraction(x) for x in matrix[i]]
+        + [Fraction(1 if i == j else 0) for j in range(n)]
+        for i in range(n)
+    ]
+    operations = 0
+    for column in range(n):
+        pivot = next((r for r in range(column, n) if work[r][column]), None)
+        if pivot is None:
+            return None, operations
+        if pivot != column:
+            work[column], work[pivot] = work[pivot], work[column]
+        value = work[column][column]
+        if value != 1:
+            for j in range(column, 2 * n):
+                work[column][j] /= value
+                operations += 1
+        for i in range(n):
+            if i == column:
+                continue
+            factor = work[i][column]
+            if factor:
+                for j in range(column, 2 * n):
+                    work[i][j] -= factor * work[column][j]
+                    operations += 2
+    return [row[n:] for row in work], operations
+
+
+def _reference_solve(inst):
+    """Mechanical O(n^3) inverse-support path recovery."""
+    inverse, operations = _inverse_gauss_jordan(inst["matrix"])
+    if inverse is None:
+        return None, operations
+    n = inst["n"]
+    neighbors = [[] for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            if inverse[i][j] != 0:
+                neighbors[i].append(j)
+                neighbors[j].append(i)
+    anchor = inst["anchor"]
+    if len(neighbors[anchor]) != 1:
+        return None, operations
+    order = []
+    previous = None
+    current = anchor
+    while current is not None:
+        order.append(current)
+        choices = [x for x in neighbors[current] if x != previous]
+        if len(choices) > 1:
+            return None, operations
+        previous, current = current, choices[0] if choices else None
+    if len(order) != n:
+        return None, operations
+    return order, operations
+
+
+def canonical_key(inst):
+    """Invariant under relabelling and positive diagonal congruence.
+
+    For generated instances, the displayed level profile is the complete
+    invariant after these transformations.  It varies independently by seed.
+    """
+    payload = {
+        "family": "scaled_covariance_chain",
+        "n": inst["n"],
+        "levels": list(inst["levels"]),
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(blob).hexdigest()
+
+
+def escalate(params):
+    current = dict(params)
+    n = current.get("n")
+    if isinstance(n, bool) or not isinstance(n, int):
+        return None
+    # Four counted operations per coordinate keep the compact route <=300
+    # through n=75.  Past that the no-tool operation cap, not the mathematics,
+    # is the limiting resource.
+    if n >= 75:
+        return "cap_bound"
+    current["n"] = min(75, n + 8)
+    return current
+
+
+def _permute_instance(inst, old_to_new):
+    n = inst["n"]
+    C = inst["matrix"]
+    transformed = [[0] * n for _ in range(n)]
+    for old_i in range(n):
+        for old_j in range(n):
+            transformed[old_to_new[old_i]][old_to_new[old_j]] = C[old_i][old_j]
+    return {
+        **inst,
+        "anchor": old_to_new[inst["anchor"]],
+        "matrix": transformed,
+        "answer": [old_to_new[i] for i in inst["answer"]],
+    }
+
+
+def _scale_instance(inst, diagonal):
+    n = inst["n"]
+    C = inst["matrix"]
+    transformed = [
+        [diagonal[i] * C[i][j] * diagonal[j] for j in range(n)]
+        for i in range(n)
+    ]
+    return {**inst, "matrix": transformed, "answer": list(inst["answer"])}
+
+
+def _candidate_diagonal_sort(inst):
+    anchor = inst["anchor"]
+    rest = [i for i in range(inst["n"]) if i != anchor]
+    rest.sort(key=lambda i: inst["matrix"][i][i])
+    return [anchor] + rest
+
+
+def _candidate_anchor_raw_sort(inst):
+    anchor = inst["anchor"]
+    rest = [i for i in range(inst["n"]) if i != anchor]
+    rest.sort(key=lambda i: inst["matrix"][anchor][i])
+    return [anchor] + rest
+
+
+def _candidate_row_sum_sort(inst):
+    anchor = inst["anchor"]
+    rest = [i for i in range(inst["n"]) if i != anchor]
+    rest.sort(key=lambda i: sum(inst["matrix"][i]))
+    return [anchor] + rest
+
+
+def _candidate_conditional_greedy(inst):
+    C = inst["matrix"]
+    anchor = inst["anchor"]
+    order = [anchor]
+    unused = set(range(inst["n"])) - {anchor}
+    while unused:
+        current = order[-1]
+        nxt = min(
+            unused,
+            key=lambda j: C[current][current] * C[j][j] - C[current][j] ** 2,
+        )
+        order.append(nxt)
+        unused.remove(nxt)
+    return order
+
+
+def _candidate_partial_anchor(inst, width=8):
+    """A bounded by-hand version of the right invariant, then raw fill."""
+    C = inst["matrix"]
+    anchor = inst["anchor"]
+    levels = {value: k for k, value in enumerate(inst["levels"])}
+    chosen = [i for i in range(inst["n"]) if i != anchor][:width]
+    slots = {0: anchor}
+    for observed in chosen:
+        numerator = C[anchor][anchor] * C[observed][observed]
+        denominator = C[anchor][observed] ** 2
+        if denominator and numerator % denominator == 0:
+            position = levels.get(numerator // denominator)
+            if position is not None:
+                slots[position] = observed
+    remaining = [i for i in range(inst["n"]) if i not in slots.values()]
+    remaining.sort(key=lambda i: C[i][i])
+    iterator = iter(remaining)
+    return [slots.get(k, next(iterator)) if k not in slots else slots[k]
+            for k in range(inst["n"])]
+
+
+def _run_attack_panel(params, seeds):
+    attack_builders = {
+        "outlier_diagonal_magnitude": _candidate_diagonal_sort,
+        "greedy_raw_anchor_covariance": _candidate_anchor_raw_sort,
+        "greedy_row_sum": _candidate_row_sum_sort,
+        "greedy_conditional_covariance": _candidate_conditional_greedy,
+        "by_hand_eight_anchor_ratios": _candidate_partial_anchor,
+    }
+    results = {
+        name: {"successes": 0, "attempts": len(seeds), "wall_clock_sec": 0.0}
+        for name in attack_builders
+    }
+    for seed in seeds:
+        inst = make_instance(seed=seed, **params)
+        for name, builder in attack_builders.items():
+            start = time.perf_counter()
+            candidate = builder(inst)
+            elapsed = time.perf_counter() - start
+            solved = verify(inst, candidate)[0]
+            results[name]["wall_clock_sec"] += elapsed
+            results[name]["successes"] += int(solved)
+
+    # Random restart is a separate attack because it makes 256 attempts/seed.
+    random_result = {"successes": 0, "attempts": len(seeds), "restarts": 256,
+                     "wall_clock_sec": 0.0}
+    for seed in seeds:
+        inst = make_instance(seed=seed, **params)
+        rng = random.Random(0xBAD5EED ^ seed)
+        start = time.perf_counter()
+        found = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, rng))[0]:
+                found = True
+                break
+        random_result["wall_clock_sec"] += time.perf_counter() - start
+        random_result["successes"] += int(found)
+    results["random_restart_256"] = random_result
+    for value in results.values():
+        value["wall_clock_sec"] = round(value["wall_clock_sec"], 6)
+    return results
+
+
+def selftest():
+    report = {}
+
+    # G1: every named preset, three seeds, plus JSON-native certificate checks.
+    failures = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 90210):
+            inst = make_instance(seed=seed, **params)
+            attempts += 1
+            ok, reason = verify(inst, inst["answer"])
+            if not ok:
+                failures.append({"preset": preset, "seed": seed, "reason": reason})
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append({"preset": preset, "seed": seed,
+                                 "reason": "answer is not JSON-native"})
+    demo_for_psd = make_instance(seed=0, **DIFFICULTY["demo"])
+    helper_psd = None
+    if exact_matrices is not None:
+        helper_psd = exact_matrices.is_positive_definite(
+            exact_matrices.matrix(demo_for_psd["matrix"])
+        )
+        if not helper_psd:
+            failures.append({"preset": "demo", "seed": 0,
+                             "reason": "gvlib rejected positive definiteness"})
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "attempts": attempts,
+        "failures": failures,
+        "gvlib_demo_positive_definite": helper_psd,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    base = make_instance(seed=314159, **shipping_params)
+
+    # G2: each corruption has a deliberately different diagnostic.
+    answer = list(base["answer"])
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": answer[:1] + [answer[2], answer[1]] + answer[3:],
+        "duplicate": answer[:-1] + [answer[-2]],
+        "empty": [],
+        "out_of_range": answer[:-1] + [base["n"]],
+    }
+    cases = {}
+    reasons = []
+    for name, candidate in corruptions.items():
+        ok, reason = verify(base, candidate)
+        cases[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": all(value["rejected"] for value in cases.values())
+        and len(set(reasons)) == len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "cases": cases,
+    }
+
+    # G3: model-style prose, markdown, whitespace, and the required tags.
+    response = (
+        "I used exact rational elimination.\n\n```text\nFinal response follows.\n```\n"
+        "<answer>\n```json\n" + json.dumps(base["answer"]) + "\n```\n</answer>\n"
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == base["answer"],
+        "parsed_equals_answer": parsed == base["answer"],
+        "garbage_returns_none": parse_answer("no tagged witness here") is None,
+    }
+
+    # G4: structure-aware uniform sampling of anchor-first permutations.
+    rng = random.Random(271828)
+    total = 200_000
+    hits = 0
+    start = time.perf_counter()
+    for _ in range(total):
+        hits += int(verify(base, random_candidate(base, rng))[0])
+    guess_seconds = time.perf_counter() - start
+    space = search_space(base)
+    report["G4_guess_resistance"] = {
+        "pass": hits / total < 1e-6,
+        "hits": hits,
+        "total": total,
+        "fraction": hits / total,
+        "candidate_space": space,
+        "candidate_space_bits": space.bit_length() - 1,
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    # G6 and the Track-B reference algorithm.
+    panel_seeds = list(range(8100, 8108))
+    attacks = _run_attack_panel(shipping_params, panel_seeds)
+    reference_successes = 0
+    reference_seconds = 0.0
+    reference_operations = 0
+    compact_successes = 0
+    compact_operations = 0
+    for seed in panel_seeds:
+        inst = make_instance(seed=seed, **shipping_params)
+        start = time.perf_counter()
+        recovered, operations = _reference_solve(inst)
+        reference_seconds += time.perf_counter() - start
+        reference_operations += operations
+        reference_successes += int(recovered is not None and verify(inst, recovered)[0])
+        compact, operations = _compact_solve(inst)
+        compact_operations = max(compact_operations, operations)
+        compact_successes += int(compact is not None and verify(inst, compact)[0])
+    reference_avg_seconds = reference_seconds / len(panel_seeds)
+    reference_avg_operations = round(reference_operations / len(panel_seeds))
+    all_failed = len(attacks) >= 4 and all(
+        result["successes"] == 0 and result["attempts"] >= 8
+        for result in attacks.values()
+    )
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == len(panel_seeds)
+        and compact_successes == len(panel_seeds),
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "exact Gauss-Jordan inverse followed by inverse-support path traversal",
+            "complexity": "O(n^3) exact rational operations",
+            "wall_clock_sec": round(reference_avg_seconds, 6),
+            "operations": reference_avg_operations,
+            "solves": f"{reference_successes}/{len(panel_seeds)}, as expected",
+        },
+        "intended_compact_route": {
+            "name": "anchor-normalized squared-correlation lookup",
+            "operations_upper_bound": compact_operations,
+            "solves": f"{compact_successes}/{len(panel_seeds)}",
+        },
+    }
+
+    # G5: shipping density and the actual strongest/reference costs.
+    demo_count = enumerate_all(demo_for_psd)
+    random_attack = attacks["random_restart_256"]
+    report["G5_density_and_baseline_cost"] = {
+        "pass": isinstance(hits / total, float)
+        and isinstance(reference_avg_seconds, float)
+        and reference_successes == len(panel_seeds),
+        "shipping_sample_hits": hits,
+        "shipping_sample_total": total,
+        "shipping_solution_density": hits / total,
+        "exact_solution_count": 1,
+        "exact_density": f"1/{space} (the covariance levels identify a unique order)",
+        "demo_exact_solution_count": demo_count,
+        "baseline_attack_restarts": random_attack["restarts"] * random_attack["attempts"],
+        "baseline_attack_wall_clock_sec": random_attack["wall_clock_sec"],
+        "reference_operation_count": reference_avg_operations,
+        "reference_wall_clock_sec": round(reference_avg_seconds, 6),
+    }
+
+    # G7: n doubles while construction and the witness remain exact.
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] = 2 * shipping_params["n"]
+    start = time.perf_counter()
+    doubled = make_instance(seed=424242, **doubled_params)
+    build_seconds = time.perf_counter() - start
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and search_space(doubled) > space,
+        "shipping_n": shipping_params["n"],
+        "doubled_n": doubled_params["n"],
+        "doubled_build_sec": round(build_seconds, 6),
+        "doubled_verify_reason": doubled_reason,
+        "candidate_space_bits_shipping": space.bit_length() - 1,
+        "candidate_space_bits_doubled": search_space(doubled).bit_length() - 1,
+    }
+
+    # G8: relabelling, diagonal congruence, and their composition.
+    invariant = 0
+    carried = 0
+    unrelated_keys = []
+    for seed in range(20):
+        inst = make_instance(n=12, seed=12000 + seed, scale_low=5, scale_high=31)
+        unrelated_keys.append(canonical_key(inst))
+        rng_local = random.Random(seed ^ 0xC0FFEE)
+        mapping = list(range(inst["n"]))
+        rng_local.shuffle(mapping)
+        diagonal = [rng_local.randrange(2, 8) for _ in range(inst["n"])]
+        variants = [
+            _permute_instance(inst, mapping),
+            _scale_instance(inst, diagonal),
+            _scale_instance(_permute_instance(inst, mapping),
+                            [diagonal[mapping.index(i)] for i in range(inst["n"])]),
+        ]
+        key = canonical_key(inst)
+        for variant in variants:
+            invariant += int(canonical_key(variant) == key)
+            carried += int(verify(variant, variant["answer"])[0])
+    expected_transformations = 20 * 3
+    distinct = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant == expected_transformations
+        and carried == expected_transformations and distinct == 20,
+        "invariant_relabellings": invariant,
+        "real_transformations_verified": carried,
+        "expected_each": expected_transformations,
+        "unrelated_attempts": 20,
+        "unrelated_distinct_keys": distinct,
+        "transformations": [
+            "simultaneous row/column relabelling with anchor and witness carried",
+            "positive rational diagonal congruence",
+            "their composition",
+        ],
+    }
+
+    # G9: oracle arms are populated only from script-owned transcripts.
+    compact_json = json.dumps(base["answer"])
+    answer_chars = len(compact_json)
+    answer_elements = len(base["answer"])
+    answer_tokens = math.ceil(answer_chars / 4)
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = (arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+                   if arms["hinted"]["attempts"] else 0.0)
+    placebo_rate = (arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+                    if arms["placebo"]["attempts"] else 0.0)
+    intended_operations = 4 * (base["n"] - 1)
+    report["G9_no_tool_suitability"] = {
+        "pass": answer_chars <= 2000 and answer_elements <= 256
+        and intended_operations <= 300,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        value.get("pass") is True
+        for key, value in report.items()
+        if key.startswith("G")
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

