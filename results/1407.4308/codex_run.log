+        "greedy_conditional_covariance": _candidate_conditional_greedy,
+        "by_hand_eight_anchor_ratios": _candidate_partial_anchor,
+    }
+    results = {
+        name: {"successes": 0, "attempts": len(seeds), "wall_clock_sec": 0.0}
+        for name in attack_builders
+    }
+    for seed in seeds:
+        inst = make_instance(seed=seed, **params)
+        for name, builder in attack_builders.items():
+            start = time.perf_counter()
+            candidate = builder(inst)
+            elapsed = time.perf_counter() - start
+            solved = verify(inst, candidate)[0]
+            results[name]["wall_clock_sec"] += elapsed
+            results[name]["successes"] += int(solved)
