+def _block_inverse_data(B):
+    """Return D^-1 and 1^T D^-1 1 for the complement-block decomposition."""
+    n = len(B)
+    Dinv = [[0] * n for _ in range(n)]
+    components = _components_of_complement(B)
+    if len(components) != n // 3:
+        return None, None
+    for rows, cols in components:
