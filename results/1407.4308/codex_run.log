-                operations += 2 * n if count_scalar_xors else 1
-    inv = [[(rows[i] >> (n + j)) & 1 for j in range(n)] for i in range(n)]
-    return inv, operations
-
-
-_BLOCK_INVERSES = tuple(
-    tuple(tuple(x for x in row) for row in _invert_gf2(B)[0])
-    for B in _BLOCKS
-)
-_BLOCK_SCALARS = tuple(
-    sum(sum(row) for row in inv) & 1 for inv in _BLOCK_INVERSES
-)
-_BLOCK_X_WEIGHTS = tuple(
-    sum(sum(row) & 1 for row in inv) for inv in _BLOCK_INVERSES
-)
-_BLOCK_Y_WEIGHTS = tuple(
-    sum(sum(inv[i][j] for i in range(3)) & 1 for j in range(3))
-    for inv in _BLOCK_INVERSES
-)
-
-
-def _valid_type_multisets(block_count):
-    """Canonical type multisets satisfying the rank-one invertibility parity."""
-    choices = []
-    for combo in itertools.combinations_with_replacement(range(len(_BLOCKS)),
-                                                          block_count):
-        if sum(_BLOCK_SCALARS[t] for t in combo) & 1:
-            continue
-        # At shippable sizes, keep the compact outer correction below 80 XORs.
-        xw = sum(_BLOCK_X_WEIGHTS[t] for t in combo)
-        yw = sum(_BLOCK_Y_WEIGHTS[t] for t in combo)
-        if block_count <= 5 and xw * yw > 80:
-            continue
-        choices.append(combo)
-    if not choices:
-        raise ValueError("no admissible block type multiset")
-    return choices
-
-
-def _permute_block(A, row_order, col_order):
-    return [[A[row_order[i]][col_order[j]] for j in range(3)] for i in range(3)]
-
-
-def make_instance(n, seed=0, **params) -> dict:
-    """Compose a known inverse, then publish the forward coordinate change."""
-    if params:
-        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
-    if isinstance(n, bool) or not isinstance(n, int) or n < 3 or n % 3:
-        raise ValueError("n must be an integer multiple of 3 and at least 3")
-    rng = random.Random(seed)
-    block_count = n // 3
-    type_choices = _valid_type_multisets(block_count)
-    types = list(rng.choice(type_choices))
-    rng.shuffle(types)
-
-    D = [[0] * n for _ in range(n)]
-    Dinv = [[0] * n for _ in range(n)]
-    for block_index, block_type in enumerate(types):
-        rp = list(range(3))
-        cp = list(range(3))
-        rng.shuffle(rp)
-        rng.shuffle(cp)
-        C = _permute_block(_BLOCKS[block_type], rp, cp)
-        # If C' = P C R^T, then (C')^-1 = R C^-1 P^T.
-        base_inv = _BLOCK_INVERSES[block_type]
-        Cinv = [[base_inv[cp[j]][rp[i]] for i in range(3)] for j in range(3)]
-        off = 3 * block_index
-        for i in range(3):
-            for j in range(3):
-                D[off + i][off + j] = C[i][j]
-                Dinv[off + j][off + i] = Cinv[j][i]
-
-    x = [sum(row) & 1 for row in Dinv]
-    y = [sum(Dinv[i][j] for i in range(n)) & 1 for j in range(n)]
-    if sum(x) & 1:
-        raise AssertionError("block parity failed to make the rank-one update invertible")
-    B = [[D[i][j] ^ 1 for j in range(n)] for i in range(n)]
-    Q = [[Dinv[i][j] ^ (x[i] & y[j]) for j in range(n)] for i in range(n)]
-
-    row_order = list(range(n))
-    col_order = list(range(n))
-    rng.shuffle(row_order)
-    rng.shuffle(col_order)
-    public_B = [[B[row_order[i]][col_order[j]] for j in range(n)] for i in range(n)]
-    public_Q = [[Q[col_order[i]][row_order[j]] for j in range(n)] for i in range(n)]
-
-    return {
-        "family": "GF(2) coordinate transport of the inner-product matrix",
-        "n": n,
-        "communication_dimension": 1 << n,
-        "field": 2,
-        "bilinear_matrix": public_B,
-        "psd_rank_upper_bound": (1 << (n // 2)) + (1 << (n - n // 2)) - 1,
-        "answer": {"matrix": public_Q},
-    }
-
-
-def render(inst) -> str:
-    B = "\n".join(" ".join(map(str, row)) for row in inst["bilinear_matrix"])
-    n = inst["n"]
-    N = inst["communication_dimension"]
-    text = f"""Exact coordinate certificate for a PSD-rank upper bound
-
-All vector and matrix arithmetic in this problem is over GF(2): addition and
-multiplication are reduced modulo 2. Let x and y range over all binary column
-vectors of length n={n}. The displayed invertible binary matrix B defines the
-{N} by {N} nonnegative communication matrix W_B implicitly by
-
-    W_B(x,y) = x^T B y mod 2.
-
-Thus every entry of W_B is the ordinary integer 0 or 1. The standard inner-
-product communication matrix is IP_n(x,z)=x^T z mod 2. A binary n by n matrix
-Q is a change-of-coordinate certificate when
-
-    B Q = I_n over GF(2).
-
-This equation is equivalent to W_B(x,Qz)=IP_n(x,z) for every binary x,z, so Q
-is an exact column relabelling that transports any PSD factorization of IP_n to
-W_B. Matrix B, one row per line, is:
-
-{B}
-
-Return one change-of-coordinate certificate Q. It must be a JSON array of
-exactly {n} rows, each containing exactly {n} integers. Each entry must be 0 or
-1; booleans are not accepted. Row and column positions are 0-based, their order
-is the displayed order, and repeated rows are not allowed. Ordinary matrix
-multiplication is used before reducing each entry modulo 2.
-
-Give your final answer inside <answer></answer> tags as one JSON object with the
-single key \"matrix\".
-Example format only: <answer>{{\"matrix\":[[1,0],[0,1]]}}</answer>
-Output nothing else inside the tags."""
-    mode = os.environ.get("GV_HINT_MODE")
-    if mode == "structural":
-        text += "\n\n" + STRUCTURAL_HINT
-    elif mode == "placebo":
-        text += "\n\n" + PLACEBO_HINT
-    return text
-
