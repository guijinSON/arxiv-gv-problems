   385	
   386	def _rank_bits(rows, n):
   387	    basis = [0] * n
   388	    rank = 0
   389	    for original in rows:
   390	        value = original
   391	        while value:
   392	            pivot = value.bit_length() - 1
   393	            if basis[pivot]:
   394	                value ^= basis[pivot]
   395	            else:
   396	                basis[pivot] = value
   397	                rank += 1
   398	                break
   399	    return rank
   400	
