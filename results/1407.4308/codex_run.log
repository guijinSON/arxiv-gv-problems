   602	
   603	def _compact_route_operations(inst):
   604	    """Conservative scalar-op accounting for block inversion plus rank-one update."""
   605	    B = inst["bilinear_matrix"]
   606	    n = inst["n"]
   607	    Dinv = [[0] * n for _ in range(n)]
   608	    blocks = _components_of_complement(B)
   609	    for rows, cols in blocks:
   610	        block = [[B[i][j] ^ 1 for j in cols] for i in rows]
   611	        inv, _ = _invert_gf2(block)
   612	        if inv is None:
   613	            return 10**9
   614	        for j, public_col in enumerate(cols):
   615	            for i, public_row in enumerate(rows):
   616	                Dinv[public_col][public_row] = inv[j][i]
   617	    x = [sum(row) & 1 for row in Dinv]
   618	    y = [sum(Dinv[i][j] for i in range(n)) & 1 for j in range(n)]
   619	    # Nine 2-by-2 minors per 3-by-3 inverse, at three GF(2) ops each;
   620	    # two XORs for every local row and column parity, n-1 for the scalar
   621	    # denominator check, and one XOR for each entry toggled by xy^T.
   622	    return 27 * len(blocks) + 4 * n + (n - 1) + sum(x) * sum(y)
