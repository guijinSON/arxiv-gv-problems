+    corruptions = {
+        "drop_one": drop_one,
+        "swap_two": swap_two,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+        "nonsingleton": nonsingleton,
+    }
+    corruption_report = {}
+    rejection_reasons = set()
+    for name, bad in corruptions.items():
+        ok, reason = verify(inst, bad)
