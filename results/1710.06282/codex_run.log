+        "base_n": DIFFICULTY["hard"]["n"],
+        "doubled_n": doubled_n,
+        "build_and_verify_sec": round(doubled_elapsed, 6),
+        "verify_reason": doubled_reason,
+        "answer_atoms_unchanged": _answer_atoms(doubled["answer"]) == 5,
