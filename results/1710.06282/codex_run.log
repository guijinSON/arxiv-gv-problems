+
+
+DIFFICULTY = {
+    "demo": {"n": 41, "degree": 8},
+    "easy": {"n": 193, "degree": 12},
+    "medium": {"n": 277, "degree": 12},
+    "hard": {"n": 401, "degree": 12},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON array [B_h,B_0,B_1,B_2,B_3] of five singleton integer lists. "
