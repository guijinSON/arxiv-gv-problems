+        "exact branch-set disjointness checks",
+        "exact graph adjacency checks",
+        "canonical cyclic-order comparisons",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
