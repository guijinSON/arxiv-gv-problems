+        "greedy_one_square_high_to_low": {"successes": 0, "attempts": 0},
+        "random_restart_256_structure_aware": {"successes": 0, "attempts": 0},
+        "in_context_palindromic_alternating_ansatz": {"successes": 0, "attempts": 0},
+    }
