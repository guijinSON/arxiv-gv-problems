+def _block_answer_to_dense(answer, degree):
+    """Expand {stride, blocks} into an integer coefficient vector."""
+
+    stride = answer["stride"]
+    dense = [0] * (degree + 1)
+    for residue, block in enumerate(answer["blocks"]):
