   \put (26.5,25.5){1}

   \put (73.5,2.5){2}
   \put (85,2.5){4}
   \put (96.5,14){3}
   \put (96.5,25.5){1}

   \put (143.5,2.5){2}
   \put (155,2.5){3}
   \put (166.5,14){4}
   \put (166.5,25.5){1}

   \put (213.5,2.5){1}
