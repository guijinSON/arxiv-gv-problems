+    square = _trim(square)
+    degree = len(square) - 1
+    if degree < 0 or degree % 2 or square[-1] != 1:
+        return None, 0
+    root_degree = degree // 2
+    root = [0] * (root_degree + 1)
+    root[root_degree] = 1
+    operations = 0
