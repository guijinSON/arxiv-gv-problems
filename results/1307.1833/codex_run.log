+def _attack_greedy_one_square(inst):
+    g = _derivative_dense(inst)
+    degree = inst["factor_degree"]
+    # Greedily estimate the high half of one square, then fill the still
+    # required support from low exponents without solving the second square.
+    guessed = [0] * (degree + 1)
+    guessed[degree] = 1
+    scored = []
+    for exponent in range(degree - 1, 0, -1):
+        coefficient = g[degree + exponent]
+        if coefficient:
+            scored.append((exponent, 1 if coefficient > 0 else -1))
+    sign_map = dict(scored)
+    return _candidate_from_support(
+        inst, [exponent for exponent, _ in scored],
+        lambda exponent: sign_map.get(exponent, 1),
+    )
+
+
+def _attack_random_restart(inst, rng, restarts=256):
+    last = None
+    for _ in range(restarts):
+        last = random_candidate(inst, rng)
+        if verify(inst, last)[0]:
+            return last
+    return last
 
 
