+
+# Filled after the three independent harden.py runs.  Zero-attempt arms are
+# explicitly diagnostic-only and do not affect the size/effort gate.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
