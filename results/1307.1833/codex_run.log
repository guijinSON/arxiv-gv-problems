+
+def _is_int(value) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _trim(poly):
+    out = list(poly)
+    while out and out[-1] == 0:
+        out.pop()
+    return out
+
+
+def _poly_mul(left, right):
+    if not left or not right:
+        return []
+    out = [0] * (len(left) + len(right) - 1)
+    for i, a in enumerate(left):
+        if a:
+            for j, b in enumerate(right):
+                if b:
+                    out[i + j] += a * b
+    return _trim(out)
+
+
+def _linear_power(root: int, exponent: int):
+    """Dense coefficients of (t-root)^exponent, low degree first."""
+    return [
+        math.comb(exponent, degree) * (-root) ** (exponent - degree)
+        for degree in range(exponent + 1)
+    ]
+
+
+def _poly_eval(poly, value):
+    result = 0
+    for coefficient in reversed(poly):
+        result = result * value + coefficient
+    return result
+
+
+def _derivative(poly):
+    return [i * poly[i] for i in range(1, len(poly))]
+
+
+def _allowed_roots(root_bound: int):
+    return list(range(-root_bound, -1)) + list(range(2, root_bound + 1))
+
+
+def _random_unimodular(k: int, rounds: int, rng: random.Random):
+    matrix = [[int(i == j) for j in range(k)] for i in range(k)]
+    # First make the final column nonzero in every row, so every rendered
+    # polynomial has the same top degree.
+    for row in range(k - 1):
+        matrix[row] = [a + b for a, b in zip(matrix[row], matrix[k - 1])]
+    for _ in range(rounds):
+        source, target = rng.sample(range(k), 2)
+        multiplier = rng.choice((-2, -1, 1, 2))
+        matrix[target] = [
+            a + multiplier * b
+            for a, b in zip(matrix[target], matrix[source])
+        ]
+        if rng.random() < 0.12:
+            matrix[source], matrix[target] = matrix[target], matrix[source]
+    for row in range(k):
+        if matrix[row][-1] == 0:
+            source = next(i for i in range(k) if matrix[i][-1] != 0)
+            matrix[row] = [a + b for a, b in zip(matrix[row], matrix[source])]
+        if rng.getrandbits(1):
+            matrix[row] = [-value for value in matrix[row]]
+    rng.shuffle(matrix)
+    return matrix
+
+
+def _rank_fallback(rows):
+    matrix = [[Fraction(value) for value in row] for row in rows]
+    rank = 0
+    width = len(matrix[0]) if matrix else 0
+    for column in range(width):
+        pivot = next((r for r in range(rank, len(matrix))
+                      if matrix[r][column]), None)
+        if pivot is None:
+            continue
+        matrix[rank], matrix[pivot] = matrix[pivot], matrix[rank]
+        value = matrix[rank][column]
+        matrix[rank] = [entry / value for entry in matrix[rank]]
+        for row in range(len(matrix)):
+            if row != rank and matrix[row][column]:
+                factor = matrix[row][column]
+                matrix[row] = [a - factor * b
+                               for a, b in zip(matrix[row], matrix[rank])]
+        rank += 1
+        if rank == len(matrix):
+            break
+    return rank
+
+
+def _rank(rows):
+    if exact_matrices is not None:
+        return exact_matrices.rank(exact_matrices.matrix(rows))
+    return _rank_fallback(rows)
+
+
+def _nullspace_fallback(rows):
+    matrix = [[Fraction(value) for value in row] for row in rows]
+    m = len(matrix)
+    n = len(matrix[0])
+    pivots = []
+    rank = 0
+    for column in range(n):
+        pivot = next((r for r in range(rank, m) if matrix[r][column]), None)
+        if pivot is None:
+            continue
+        matrix[rank], matrix[pivot] = matrix[pivot], matrix[rank]
+        value = matrix[rank][column]
+        matrix[rank] = [entry / value for entry in matrix[rank]]
+        for row in range(m):
+            if row != rank and matrix[row][column]:
+                factor = matrix[row][column]
+                matrix[row] = [a - factor * b
+                               for a, b in zip(matrix[row], matrix[rank])]
+        pivots.append(column)
+        rank += 1
+        if rank == m:
+            break
+    free = [column for column in range(n) if column not in pivots]
+    basis = []
+    for free_column in free:
+        vector = [Fraction(0)] * n
+        vector[free_column] = Fraction(1)
+        for row, pivot_column in enumerate(pivots):
+            vector[pivot_column] = -matrix[row][free_column]
+        basis.append(vector)
+    return basis
+
+
+def _nullspace(rows):
+    if exact_matrices is not None:
+        return exact_matrices.nullspace(exact_matrices.matrix(rows))
+    return _nullspace_fallback(rows)
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Construct a polynomial k-plane with known Wronskian factorization.
+
+    ``n`` is the gap between the hidden exponents.  The answer is sampled first:
+    three roots are drawn uniformly, one becomes the shifted-coordinate root,
+    and two form the common quadratic.  A random unimodular basis change then
+    hides the power basis without changing the projective Wronskian.
+    """
+    k = params.pop("k", 6)
+    root_bound = params.pop("root_bound", 20)
+    mixing_rounds = params.pop("mixing_rounds", 80)
+    if params:
+        raise TypeError("unknown make_instance parameter(s): "
+                        + ", ".join(sorted(params)))
+    if not _is_int(n) or n < 2:
+        raise ValueError("n must be an integer at least 2")
+    if not _is_int(k) or not 2 <= k <= 8:
+        raise ValueError("k must be an integer from 2 through 8")
+    if not _is_int(root_bound) or root_bound < 3:
+        raise ValueError("root_bound must be an integer at least 3")
+    if not _is_int(mixing_rounds) or mixing_rounds < k:
+        raise ValueError("mixing_rounds must be an integer at least k")
+
+    rng = random.Random(seed)
+    roots = rng.sample(_allowed_roots(root_bound), 3)
+    shifted_root = roots[rng.randrange(3)]
+    common_roots = [root for root in roots if root != shifted_root]
+
+    common = _poly_mul([-common_roots[0], 1], [-common_roots[1], 1])
+    power_basis = []
+    for j in range(k):
+        power_basis.append(_poly_mul(
+            common, _linear_power(shifted_root, n * j)))
+    width = len(power_basis[-1])
+    padded = [row + [0] * (width - len(row)) for row in power_basis]
+    change = _random_unimodular(k, mixing_rounds, rng)
+    basis = []
+    for mix_row in change:
+        basis.append([
+            sum(mix_row[j] * padded[j][column] for j in range(k))
+            for column in range(width)
+        ])
+    if _rank(basis) != k:
+        raise AssertionError("unimodular basis change lost rank")
+    if any(row[-1] == 0 for row in basis):
+        raise AssertionError("rendered basis did not hide the degree ladder")
+
+    K = k * (k - 1) // 2
+    shifted_multiplicity = (n - 1) * K
+    answer = sorted(
+        [[common_roots[0], k], [common_roots[1], k],
+         [shifted_root, shifted_multiplicity]],
+        key=lambda pair: pair[0],
+    )
+    wronskian_degree = 2 * k + shifted_multiplicity
+    ambient_dimension = width
+    return {
+        "paper": "1307.1833",
+        "n": n,
+        "k": k,
+        "root_bound": root_bound,
+        "mixing_rounds": mixing_rounds,
+        "ambient_dimension": ambient_dimension,
+        "wronskian_degree": wronskian_degree,
+        "basis": basis,
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    """Render the complete exact Wronskian-factorization problem."""
+    rows = "\n".join(
+        f"  f_{index}(t): {json.dumps(row, separators=(',', ':'))}"
+        for index, row in enumerate(inst["basis"], 1)
+    )
+    R = inst["root_bound"]
+    statement = f"""Exact Wronskian roots of a polynomial k-plane
+
+All arithmetic is exact over Q.  A dense coefficient list [a0,a1,...,ad]
+means a0+a1*t+...+ad*t^d; coefficients below are in ascending degree order.
+Trailing zero coefficients are retained so every displayed row has the same
+length.
+
+The following {inst['k']} linearly independent polynomials of degree less than
+{inst['ambient_dimension']} are a basis of a {inst['k']}-dimensional subspace
+H of Q[t]:
+{rows}
+
+For an ordered basis f_1,...,f_k, define its Wronskian by
+
+  W(t) = det( D^(r-1) f_c(t) )_(1 <= r,c <= k),
+
+where D^j is the j-th formal derivative.  Replacing the displayed basis by any
+other basis of H multiplies W by a nonzero rational, so the monic normalization
+W_monic = W / leading_coefficient(W) depends only on H.
+
+For this instance W_monic is guaranteed to have degree
+{inst['wronskian_degree']} and exactly three distinct integer roots.  Every root
+r satisfies 2 <= |r| <= {R}.  Determine its exact factorization
+
+  W_monic(t) = product over the three roots r of (t-r)^m_r.
+
+Output exactly three JSON pairs [r,m_r], sorted by increasing r.  Roots are
+distinct integers in [-{R},-2] union [2,{R}].  Multiplicities are positive
+integers and must sum to {inst['wronskian_degree']}.  Root order matters only
+for the required canonical serialization; the polynomial basis order does not.
+
+Give your final answer inside <answer></answer> tags as one JSON list.
+Example syntax: <answer>[[-7,6],[2,105],[11,6]]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def _decode_json_list(text):
+    candidate = text.strip()
+    if candidate.startswith("```"):
+        candidate = re.sub(r"^```(?:json|python)?\s*", "", candidate,
+                           flags=re.I)
+        candidate = re.sub(r"\s*```$", "", candidate)
+    try:
+        value = json.loads(candidate)
+        return value if isinstance(value, list) else None
+    except (TypeError, ValueError):
+        return None
+
+
+def parse_answer(text) -> object | None:
+    """Extract a JSON factor list from tags, fences, or surrounding prose."""
+    if not isinstance(text, str):
+        return None
+    for body in reversed(_ANSWER_RE.findall(text)):
+        value = _decode_json_list(body)
+        if value is not None:
+            return value
+    for body in reversed(_FENCE_RE.findall(text)):
+        value = _decode_json_list(body)
+        if value is not None:
+            return value
+    decoder = json.JSONDecoder()
+    for match in re.finditer(r"\[", text):
+        try:
+            value, _ = decoder.raw_decode(text[match.start():])
+        except ValueError:
+            continue
+        if isinstance(value, list):
+            return value
+    return None
+
+
+def _validate_instance(inst):
+    cached = _VALIDATION_CACHE.get(id(inst))
+    if cached is not None and cached[0] is inst:
+        return cached[1]
+    try:
+        k = inst["k"]
+        n = inst["n"]
+        R = inst["root_bound"]
+        ambient = inst["ambient_dimension"]
+        degree = inst["wronskian_degree"]
+        basis = inst["basis"]
+    except (KeyError, TypeError):
+        result = (False, "malformed instance")
+        _VALIDATION_CACHE[id(inst)] = (inst, result)
+        return result
+    if not all(_is_int(x) for x in (k, n, R, ambient, degree)):
+        result = (False, "instance parameters must be integers")
+        _VALIDATION_CACHE[id(inst)] = (inst, result)
+        return result
+    if k < 2 or n < 2 or R < 3 or ambient < k or degree < 1:
+        result = (False, "instance parameters out of range")
+        _VALIDATION_CACHE[id(inst)] = (inst, result)
+        return result
+    if not isinstance(basis, list) or len(basis) != k:
+        result = (False, "instance basis has wrong row count")
+        _VALIDATION_CACHE[id(inst)] = (inst, result)
+        return result
+    if any(not isinstance(row, list) or len(row) != ambient for row in basis):
+        result = (False, "instance basis is not rectangular")
+        _VALIDATION_CACHE[id(inst)] = (inst, result)
+        return result
+    if any(not _is_int(value) for row in basis for value in row):
+        result = (False, "instance basis has non-integer coefficients")
+        _VALIDATION_CACHE[id(inst)] = (inst, result)
+        return result
+    if _rank(basis) != k:
+        result = (False, "instance basis is linearly dependent")
+        _VALIDATION_CACHE[id(inst)] = (inst, result)
+        return result
+    result = (True, "ok")
+    _VALIDATION_CACHE[id(inst)] = (inst, result)
+    return result
+
+
+def canonical_key(inst) -> str:
+    """Canonicalize the represented k-plane, independent of its chosen basis."""
+    cached = _OBJECT_KEY_CACHE.get(id(inst))
+    if cached is not None and cached[0] is inst:
+        return cached[1]
+    ok, reason = _validate_instance(inst)
+    if not ok:
+        return "invalid:" + reason
+    kernel = _nullspace(inst["basis"])
+    serial = [
+        [[value.numerator, value.denominator] for value in vector]
+        for vector in kernel
+    ]
+    payload = {
+        "ambient_dimension": inst["ambient_dimension"],
+        "k": inst["k"],
+        "root_bound": inst["root_bound"],
+        "kernel": serial,
+    }
+    key = hashlib.sha256(json.dumps(
+        payload, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+    _OBJECT_KEY_CACHE[id(inst)] = (inst, key)
+    return key
+
+
+def _det_bareiss(matrix, counter):
+    size = len(matrix)
+    if size == 1:
+        return matrix[0][0]
+    work = [list(row) for row in matrix]
+    sign = 1
+    previous = 1
+    for pivot_column in range(size - 1):
+        if work[pivot_column][pivot_column] == 0:
+            pivot = next((row for row in range(pivot_column + 1, size)
+                          if work[row][pivot_column]), None)
+            if pivot is None:
+                return 0
+            work[pivot_column], work[pivot] = work[pivot], work[pivot_column]
+            sign = -sign
+        pivot_value = work[pivot_column][pivot_column]
+        for row in range(pivot_column + 1, size):
+            for column in range(pivot_column + 1, size):
+                numerator = (work[row][column] * pivot_value
+                             - work[row][pivot_column]
+                             * work[pivot_column][column])
+                counter[0] += 3
+                if pivot_column:
+                    if numerator % previous:
+                        raise ArithmeticError("Bareiss division was not exact")
+                    numerator //= previous
+                    counter[0] += 1
+                work[row][column] = numerator
+            work[row][pivot_column] = 0
+        previous = pivot_value
+    return sign * work[-1][-1]
+
+
+def _eval_counted(poly, point, counter):
+    value = 0
+    for coefficient in reversed(poly):
+        value = value * point + coefficient
+        counter[0] += 2
+    return value
+
+
+def _interpolate_consecutive(values, counter):
+    """Exact power coefficients from values at 0,1,... via Newton differences."""
+    layer = [Fraction(value) for value in values]
+    differences = []
+    while layer:
+        differences.append(layer[0])
+        next_layer = []
+        for index in range(len(layer) - 1):
+            next_layer.append(layer[index + 1] - layer[index])
+            counter[0] += 1
+        layer = next_layer
+
+    result = [Fraction(0)] * len(values)
+    falling = [Fraction(1)]
+    factorial = 1
+    for order, difference in enumerate(differences):
+        scale = difference / factorial
+        counter[0] += 1
+        for degree, coefficient in enumerate(falling):
+            result[degree] += scale * coefficient
+            counter[0] += 2
+        if order + 1 < len(differences):
+            new = [Fraction(0)] * (len(falling) + 1)
+            for degree, coefficient in enumerate(falling):
+                new[degree] -= order * coefficient
+                new[degree + 1] += coefficient
+                counter[0] += 3
+            falling = new
+            factorial *= order + 1
+            counter[0] += 1
+    return _trim(result)
+
+
+def _wronskian_monic(inst, measure=False):
+    """Compute the exact monic Wronskian by evaluation and interpolation."""
+    ok, reason = _validate_instance(inst)
+    if not ok:
+        raise ValueError(reason)
+    key = canonical_key(inst)
+    if not measure and key in _TARGET_CACHE:
+        return list(_TARGET_CACHE[key]), 0
+
+    basis = [list(row) for row in inst["basis"]]
+    k = inst["k"]
+    ambient = inst["ambient_dimension"]
+    # Proposition II.6.2: degree <= k(ambient-k).
+    degree_bound = k * (ambient - k)
+    counter = [0]
+    derivative_rows = []
+    for polynomial in basis:
+        derivatives = [polynomial]
+        for _ in range(1, k):
+            previous = derivatives[-1]
+            derivative = []
+            for degree in range(1, len(previous)):
+                derivative.append(degree * previous[degree])
+                counter[0] += 1
+            derivatives.append(derivative)
+        derivative_rows.append(derivatives)
+
+    values = []
+    for point in range(degree_bound + 1):
+        matrix = [
+            [_eval_counted(derivative_rows[column][order], point, counter)
+             for column in range(k)]
+            for order in range(k)
+        ]
+        values.append(_det_bareiss(matrix, counter))
+    coefficients = _interpolate_consecutive(values, counter)
+    if not coefficients or coefficients[-1] == 0:
+        raise ValueError("Wronskian is zero")
+    leading = coefficients[-1]
+    coefficients = [coefficient / leading for coefficient in coefficients]
+    counter[0] += len(coefficients)
+    _TARGET_CACHE[key] = tuple(coefficients)
+    return coefficients, counter[0]
+
+
+def _factor_candidate(answer):
+    polynomial = [1]
+    for root, multiplicity in answer:
+        polynomial = _poly_mul(polynomial, _linear_power(root, multiplicity))
+    return [Fraction(value) for value in polynomial]
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Verify any factorization exactly, without reading ``inst['answer']``."""
+    ok, reason = _validate_instance(inst)
+    if not ok:
+        return False, reason
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer list is empty"
+    if len(answer) != 3:
+        return False, "answer must contain exactly three factors"
+    if any(not isinstance(pair, list) or len(pair) != 2 for pair in answer):
+        return False, "each factor must be [root,multiplicity]"
+    if any(not _is_int(value) for pair in answer for value in pair):
+        return False, "roots and multiplicities must be integers"
+    roots = [pair[0] for pair in answer]
+    multiplicities = [pair[1] for pair in answer]
+    if len(set(roots)) != 3:
+        return False, "factor roots must be distinct"
+    if roots != sorted(roots):
+        return False, "factor roots must be in increasing order"
+    allowed = set(_allowed_roots(inst["root_bound"]))
+    if any(root not in allowed for root in roots):
+        return False, "factor root outside the allowed range"
+    if any(multiplicity <= 0 for multiplicity in multiplicities):
+        return False, "multiplicities must be positive"
+    if sum(multiplicities) != inst["wronskian_degree"]:
+        return False, "multiplicities do not sum to the Wronskian degree"
+
+    try:
+        target, _ = _wronskian_monic(inst)
+    except (ArithmeticError, ValueError) as exc:
+        return False, "malformed instance Wronskian: " + str(exc)
+    if len(target) - 1 != inst["wronskian_degree"]:
+        return False, "instance Wronskian degree disagrees with statement"
+
+    # Two exact Vieta filters make G4 cheap without weakening verification.
+    first_sum = sum(m * root for root, m in answer)
+    if Fraction(-first_sum) != target[-2]:
+        return False, "first Vieta coefficient mismatch"
+    square_sum = sum(m * root * root for root, m in answer)
+    second = Fraction(first_sum * first_sum - square_sum, 2)
+    if second != target[-3]:
+        return False, "second Vieta coefficient mismatch"
+    if _factor_candidate(answer) != target:
+        return False, "factor product does not equal the monic Wronskian"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample the full structure-aware certificate language."""
+    roots = sorted(rng.sample(_allowed_roots(inst["root_bound"]), 3))
+    degree = inst["wronskian_degree"]
+    cuts = sorted(rng.sample(range(1, degree), 2))
+    multiplicities = [cuts[0], cuts[1] - cuts[0], degree - cuts[1]]
+    return [[root, multiplicity]
+            for root, multiplicity in zip(roots, multiplicities)]
+
+
+def search_space(inst) -> int | None:
+    root_choices = len(_allowed_roots(inst["root_bound"]))
+    degree = inst["wronskian_degree"]
+    return math.comb(root_choices, 3) * math.comb(degree - 1, 2)
+
+
+def enumerate_all(inst) -> int | None:
+    """Brute-force exact valid-answer count only when safely hand-scale."""
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    valid = 0
+    domain = _allowed_roots(inst["root_bound"])
+    degree = inst["wronskian_degree"]
+    for roots in itertools.combinations(domain, 3):
+        for cut1, cut2 in itertools.combinations(range(1, degree), 2):
+            candidate = [[roots[0], cut1], [roots[1], cut2 - cut1],
+                         [roots[2], degree - cut2]]
+            valid += int(verify(inst, candidate)[0])
+    return valid
+
+
+def escalate(params) -> dict | str | None:
+    """Grow degree, coefficient crowding, and mixing at fixed answer length."""
+    current = dict(params)
+    n = int(current.get("n", 2))
+    current["n"] = n + 2
+    current["root_bound"] = max(
+        int(current.get("root_bound", 3)) + 2,
+        (3 * int(current.get("root_bound", 3)) + 1) // 2,
+    )
+    current["mixing_rounds"] = int(current.get("mixing_rounds", 12)) + 24
+    return current
+
+
+def _synthetic_divide(poly, root, counter):
+    degree = len(poly) - 1
+    quotient = [Fraction(0)] * degree
+    quotient[-1] = poly[-1]
+    for index in range(degree - 2, -1, -1):
+        quotient[index] = poly[index + 1] + root * quotient[index + 1]
+        counter[0] += 2
+    remainder = poly[0] + root * quotient[0]
+    counter[0] += 2
+    return _trim(quotient), remainder
+
+
+def _reference_solve(inst):
+    """Definition-II.6.1 route: determinant, interpolation, root scan."""
+    polynomial, operations = _wronskian_monic(inst, measure=True)
+    counter = [operations]
+    remaining = list(polynomial)
+    factors = []
+    for root in _allowed_roots(inst["root_bound"]):
+        multiplicity = 0
+        while len(remaining) > 1:
+            value = Fraction(_poly_eval(remaining, root))
+            counter[0] += 2 * len(remaining)
+            if value:
+                break
+            remaining, remainder = _synthetic_divide(remaining, root, counter)
+            if remainder:
+                raise AssertionError("root evaluation and division disagree")
+            multiplicity += 1
+        if multiplicity:
+            factors.append([root, multiplicity])
+    if len(remaining) != 1 or remaining[0] != 1:
+        raise ValueError("bounded integer-root scan did not factor Wronskian")
+    return factors, counter[0]
+
+
+def _compact_solve(inst):
+    """Recover the three planted roots using only leading coefficients."""
+    basis = inst["basis"]
+    k = inst["k"]
+    gap = inst["n"]
+    top_degree = len(basis[0]) - 1
+    previous_degree = 2 + gap * (k - 2)
+    operations = 0
+    chosen = None
+    for first, second in itertools.combinations(range(k), 2):
+        lead_first = basis[first][top_degree]
+        lead_second = basis[second][top_degree]
+        coefficient = (lead_second * basis[first][previous_degree]
+                       - lead_first * basis[second][previous_degree])
+        operations += 3
+        if coefficient:
+            chosen = (first, second, lead_first, lead_second, coefficient)
+            break
+    if chosen is None:
+        return None, operations
+    first, second, lead_first, lead_second, combo_lead = chosen
+    combo_next = (lead_second * basis[first][previous_degree - 1]
+                  - lead_first * basis[second][previous_degree - 1])
+    operations += 3
+    ratio_top = Fraction(basis[first][top_degree - 1], lead_first)
+    ratio_previous = Fraction(combo_next, combo_lead)
+    operations += 2
+    shifted_root = -(ratio_top - ratio_previous) / (top_degree - previous_degree)
+    operations += 3
+    power_degree = gap * (k - 1)
+    common_sum = -ratio_top - power_degree * shifted_root
+    operations += 3
+    ratio_second = Fraction(basis[first][top_degree - 2], lead_first)
+    common_product = (ratio_second - common_sum * power_degree * shifted_root
+                      - math.comb(power_degree, 2) * shifted_root * shifted_root)
+    operations += 7
+    discriminant = common_sum * common_sum - 4 * common_product
+    operations += 3
+    if (shifted_root.denominator != 1 or common_sum.denominator != 1
+            or common_product.denominator != 1
+            or discriminant.denominator != 1 or discriminant < 0):
+        return None, operations
+    square = math.isqrt(discriminant.numerator)
+    operations += 1
+    if square * square != discriminant:
+        return None, operations
+    root1 = Fraction(common_sum.numerator - square, 2)
+    root2 = Fraction(common_sum.numerator + square, 2)
+    operations += 4
+    if root1.denominator != 1 or root2.denominator != 1:
+        return None, operations
+    K = k * (k - 1) // 2
+    factors = [[root1.numerator, k], [root2.numerator, k],
+               [shifted_root.numerator, (gap - 1) * K]]
+    factors.sort()
+    return factors, operations
+
+
+def _multiplicity_pattern(inst, special_root):
+    degree = inst["wronskian_degree"]
+    k = inst["k"]
+    roots = sorted(special_root)
+    # Assign the large multiplicity to the last proposed root and keep every
+    # candidate inside the statement-visible positive-composition language.
+    large = degree - 2 * k
+    return [[roots[0], k], [roots[1], k], [roots[2], large]]
+
+
+def _fill_roots(inst, proposed):
+    domain = _allowed_roots(inst["root_bound"])
+    roots = []
+    for value in proposed:
+        if isinstance(value, Fraction):
+            value = value.numerator // value.denominator
+        value = int(value)
+        nearest = min(domain, key=lambda root: (abs(root - value), root))
+        if nearest not in roots:
+            roots.append(nearest)
+    for root in domain:
+        if root not in roots:
+            roots.append(root)
+        if len(roots) == 3:
+            break
+    return sorted(roots[:3])
+
+
+def _attack_outlier_row(inst):
+    row = max(inst["basis"], key=lambda values: sum(abs(x) for x in values))
+    degree = len(row) - 1
+    center = -Fraction(row[-2], degree * row[-1])
+    roots = _fill_roots(inst, [center - 1, center, center + 1])
+    return _multiplicity_pattern(inst, roots)
+
+
+def _attack_common_roots(inst):
+    common = []
+    for root in _allowed_roots(inst["root_bound"]):
+        if all(_poly_eval(row, root) == 0 for row in inst["basis"]):
+            common.append(root)
+    filler = next(root for root in _allowed_roots(inst["root_bound"])
+                  if root not in common)
+    roots = _fill_roots(inst, common[:2] + [filler])
+    degree = inst["wronskian_degree"]
+    k = inst["k"]
+    return [[root, k if root in common else degree - 2 * k]
+            for root in roots]
+
+
+def _attack_raw_ratio(inst):
+    degree = len(inst["basis"][0]) - 1
+    ratios = [Fraction(-row[-2], degree * row[-1])
+              for row in inst["basis"]]
+    center = sum(ratios, Fraction(0)) / len(ratios)
+    roots = _fill_roots(inst, [center - 2, center, center + 2])
+    return _multiplicity_pattern(inst, roots)
+
+
+def _attack_small_roots(inst):
+    roots = _fill_roots(inst, [-2, 2, 3])
+    return _multiplicity_pattern(inst, roots)
+
+
+def _transform_basis(inst, mode, seed):
+    transformed = copy.deepcopy(inst)
+    rows = transformed["basis"]
+    rng = random.Random(seed)
+    if mode == "reorder":
+        rng.shuffle(rows)
+    elif mode == "row_add":
+        rows[0] = [a + 2 * b for a, b in zip(rows[0], rows[1])]
+    elif mode == "scale":
+        rows[-1] = [-3 * value for value in rows[-1]]
+    elif mode == "composed":
+        rows[0] = [a - b for a, b in zip(rows[0], rows[-1])]
+        rows[1] = [2 * a + b for a, b in zip(rows[1], rows[-1])]
+        rng.shuffle(rows)
+    else:
+        raise ValueError("unknown transformation")
+    return transformed
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return fully JSON-native measured evidence."""
+    report = {
