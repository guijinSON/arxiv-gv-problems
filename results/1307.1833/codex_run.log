+    }
+
+    attacks = {
+        "outlier_largest_row": {"successes": 0, "attempts": 0},
+        "greedy_common_root_scan": {"successes": 0, "attempts": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0,
+                               "candidates": 0},
+        "single_row_binomial_ansatz": {"successes": 0, "attempts": 0},
+        "small_integer_roots_by_hand": {"successes": 0, "attempts": 0},
+    }
+    reference_successes = 0
+    reference_operations = 0
+    reference_wall = 0.0
+    reference_per_seed = []
+    compact_successes = 0
+    compact_operations = 0
+    compact_per_seed = []
+    restart_wall = 0.0
+    for seed in range(8):
+        trial = make_instance(seed=10_000 + seed, **shipping_params)
+        started = time.perf_counter()
+        reference, operations = _reference_solve(trial)
+        elapsed = time.perf_counter() - started
+        solved = verify(trial, reference)[0]
+        reference_successes += int(solved)
+        reference_operations += operations
+        reference_wall += elapsed
+        reference_per_seed.append({
+            "seed": 10_000 + seed,
