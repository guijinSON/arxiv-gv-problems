codex
The isolated oracle probe produced a real answer: the current difference-of-squares construction was solved at the first shipping rung, so it cannot ship as-is. I’m hardening the same paper-licensed factor family with a less exposed composition identity: three residue blocks form \(X^4+(2-c^2)X^2Y^2+Y^4\), whose factors are \(X^2\pm cXY+Y^2\). The witness remains an exact polynomial, the reference remains generic factorization, and the compact route stays below the 300-operation cap.
exec
/bin/bash -lc "python3 - <<'PY'
import importlib.util,random,time,math,itertools
s=importlib.util.spec_from_file_location('g','gen_1307_1833.py');g=importlib.util.module_from_spec(s);s.loader.exec_module(g)

def trial(seed,m=9,ell=4,H=2,cmax=3):
 rng=random.Random(seed); prime=g._next_prime(2*(cmax*ell*H*H)+1)
 tries=0
 while True:
  tries+=1
  vals=[x for x in range(-H,H+1) if x]
  q=[rng.choice(vals) for _ in range(ell)]+[1]
  rr=[rng.choice(vals) for _ in range(ell-1)]+[1]
  c=rng.randrange(2,cmax+1)
  qd=[0]*(m*ell+1);rd=[0]*(m*ell+1)
  for i,a in enumerate(q):qd[m*i]=a
  for i,a in enumerate(rr):rd[m*i+1]=a
  q2=g._dense_mul(qd,qd);r2=g._dense_mul(rd,rd)
  q4=g._dense_mul(q2,q2);r4=g._dense_mul(r2,r2);mid=g._dense_mul(q2,r2)
  D=max(len(q4),len(r4),len(mid));gg=[0]*D
  for poly,scale in ((q4,1),(mid,2-c*c),(r4,1)):
   for i,a in enumerate(poly):gg[i]+=scale*a
  gg=g._trim(gg); mod=g._mod_trim(gg,prime)
  if g._mod_gcd(mod,g._poly_derivative_mod(mod,prime),prime)==[1]:break
 stats={'field_operations':0,'gcd_steps':0,'subset_nodes':0}
 st=time.perf_counter(); fs=g._berlekamp_factor_squarefree(mod,prime,stats);dt=time.perf_counter()-st
 return prime,tries,c,len(gg)-1,len(fs),stats['field_operations'],dt,[len(x)-1 for x in fs]
for seed in range(4):
 print(seed,trial(seed))
