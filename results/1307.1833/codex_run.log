+        "n": 6,
+        "residue_modulus": 3,
+        "compressed_degree": 2,
+        "coeff_bound": 1,
+    },
+    "easy": {
+        "n": 70,
+        "residue_modulus": 7,
+        "compressed_degree": 10,
+        "coeff_bound": 1,
+    },
+    "medium": {
