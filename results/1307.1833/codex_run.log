+    "native_domain": "algebra",
+    "object_regime": "rational_exact",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "polynomial",
+    "native_objects": [
+        "real osculation-divisor polynomial f(t) over Q",
+        "monic real factor of the derivative f'(t)",
+        "special osculating Schubert problem (omega, box^(N-1))",
+    ],
+    "verification_operations": [
+        "exact rational differentiation",
+        "exact integer polynomial division",
+        "exact coefficient comparison",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section III.4, Theorem III.4.2: real points of the special "
+        "osculating Schubert instance are exactly monic real factorizations "
+        "f'(t)=A(t)B(t) of the prescribed degrees"
+    ),
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "The derivative separates by exponent residues into two polynomial "
+        "squares, so a difference-of-squares decomposition replaces generic "
+        "exact factorization."
+    ),
+    "hardness_basis": (
+        "Track B: exact Q[t] factorization is polynomial-time via LLL; the "
+        "measured reference is classical Berlekamp factorization modulo 3 "
+        "plus degree-balanced lifting, O(D^3+2^r D^2), which at shipping "
+        "degree 140 took a median 1,143,973 field operations and 0.450 s "
+        "over eight seeds; the residue-square route took 247 operations."
+    ),
+    "max_answer_tokens": 41,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "One monic degree-n integer polynomial factor, encoded sparsely as "
+        "exactly s JSON terms [[numerator,denominator],[exponent]] in strictly "
+        "descending exponent order. Denominators are 1, the leading coefficient "
+        "is 1, exponent 0 occurs, coefficients are nonzero with absolute value "
+        "at most H, and repeated exponents are forbidden."
+    ),
+    "bounds": {
+        "degree": "instance field factor_degree",
+        "terms": "instance field answer_terms",
+        "coefficient_height": "instance field coefficient_bound",
+        "leading_coefficient": 1,
+        "constant_term_required": True,
+        "exponents": "integers from 0 through factor_degree",
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {
+        "n": 6,
+        "residue_modulus": 3,
+        "compressed_degree": 2,
+        "coeff_bound": 1,
+    },
+    "easy": {
+        "n": 70,
