def route(inst):
 terms=g._differentiate_f_terms(inst['f_terms']); ops=len(terms); tm={e:c for c,e in terms}; m=min(e for e in tm if e>4)
 maps=[{}, {}, {}]
 for e,c in tm.items():
  rr=e%m
  if rr==0: maps[0][e//m]=c
  elif rr==2: maps[1][(e-2)//m]=c
  elif rr==4: maps[2][(e-4)//m]=c
  else: return None,999
 polys=[]
 for mp in maps:
  p=[0]*(max(mp)+1)
  for e,c in mp.items():p[e]=c
  polys.append(p)
 q2,o1=g._exact_monic_square_root(polys[0]); r2,o2=g._exact_monic_square_root(polys[2]); ops+=o1+o2
 csq=2-polys[1][-1]; c=math.isqrt(csq); ops+=2
 den=2-csq
 if any(x%den for x in polys[1]): return None,ops
 qr2=[x//den for x in polys[1]]; ops+=len(qr2)
 qr,o3=g._exact_monic_square_root(qr2);ops+=o3
 mid=[-c*x for x in qr];ops+=len(mid)
 ans={'stride':m,'blocks':[q2,mid,r2]}
 return ans,ops
