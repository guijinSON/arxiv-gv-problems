+        residue = exponent % stride
+        if residue > 2:
+            return None
+        index = (exponent - residue) // stride
+        if index >= len(blocks[residue]):
+            return None
+        blocks[residue][index] = coefficient
+    return {"stride": stride, "blocks": blocks}
