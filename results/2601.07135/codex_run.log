%$$
%u_i=i+L_ip,\ \  v_j=j+M_jq,\  \   w_k=k+N_kr,
%$$
%where 
%\begin{align*}
%L_i\in \{0,1,\cdots, p-1\}\ \ & \mbox{satisfying}\ \ \mu_{\tau_p(i)}-iq^2r^2\equiv L_i pq^2r^2\pmod M, \\
%M_j\in \{0,1,\cdots, q-1\}\ \ & \mbox{satisfying}\ \  \nu_{\tau_q(j)}-jp^2r^2\equiv M_j q p^2r^2\pmod M,  \\
%N_k\in \{0,1,\cdots, r-1\}\ \ & \mbox{satisfying}\ \  \omega_{\tau_r(k)}-kp^2 q^2\equiv N_kr p^2 q^2\pmod M,
%\end{align*}
%and 
%$\tau_a(\ell)$, with $a\in\{p,q,r\}$ and $\ell=1,2,\ldots, a-1$, is the number defined in Definition \ref{Szabo-type} (IV). The proof is completed.
