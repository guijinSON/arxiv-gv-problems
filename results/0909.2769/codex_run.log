\begin{center}
{\Large \bf On Fall Colorings of Graphs}\\
\vspace{0.3 cm}
{\bf Saeed Shaebani}\\
{\it Department of Mathematical Sciences}\\
{\it Institute for Advanced Studies in Basic Sciences (IASBS)}\\
{\it P.O. Box {\rm 45195-1159}, Zanjan, Iran}\\
{\tt s\_shaebani@iasbs.ac.ir}\\ \ \\
