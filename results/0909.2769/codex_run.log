def parse_answer(text: str) -> object | None:
    """Extract the tagged JSON permutation; return None on malformed output."""
    if not isinstance(text, str):
        return None
    matches = _ANSWER_RE.findall(text)
    if not matches:
        return None
    raw = matches[-1].strip()
    try:
        value = json.loads(raw)
    except (TypeError, ValueError, json.JSONDecodeError):
        return None
    if not isinstance(value, list):
        return None
    if any(isinstance(x, bool) or not isinstance(x, int) for x in value):
        return None
    return value


def verify(inst: dict, answer: object) -> tuple[bool, str]:
    """Check any valid matching/fall-coloring certificate, never the planted one."""
    n = inst.get("n")
    if not isinstance(answer, list):
        return False, "answer must be a JSON list"
    if not answer:
        return False, "answer must not be empty"
    if len(answer) != n:
        return False, f"answer must have exactly {n} entries"
    for t, value in enumerate(answer):
        if isinstance(value, bool) or not isinstance(value, int):
            return False, f"entry {t} is not an integer"
        if not 0 <= value < n:
            return False, f"entry {t} is outside 0..{n-1}"
    if len(set(answer)) != n:
        return False, "right-vertex indices must form a permutation without repeats"

    left_order = _cycle_from_zero(inst.get("left_successor", []))
    if left_order is None:
        return False, "instance left-successor data is not one full cycle"
    adjacency = inst.get("adjacency")
    if not isinstance(adjacency, list) or len(adjacency) != n:
        return False, "instance adjacency data has the wrong shape"
    for t, (left_vertex, right_vertex) in enumerate(zip(left_order, answer)):
        row = adjacency[left_vertex]
        if not isinstance(row, list) or not _contains_sorted(row, right_vertex):
            return False, f"color class {t} is not an edge of G"

    # This executes the fall-color check in the instance's native objects.
    # Each proposed pair is an edge of G and hence an independent pair in H.
    # Distinct left endpoints form a clique in H and distinct right endpoints
    # form a clique in H.  Consequently every left vertex sees one left endpoint
    # of every other color (and itself), and symmetrically every right vertex sees
    # every color.  No theorem oracle or planted-answer comparison is involved.
    return True, "ok"


def random_candidate(inst: dict, rng: random.Random) -> object:
    """Sample uniformly from the statement-implied permutation language."""
    candidate = list(range(inst["n"]))
    rng.shuffle(candidate)
    return candidate


def search_space(inst: dict) -> int | None:
    """The exact number n! of structurally admissible permutation strings."""
    return math.factorial(inst["n"])


def enumerate_all(inst: dict) -> int | None:
    """Count all valid certificates exactly when n! stays under a hard cap."""
    space = search_space(inst)
    assert space is not None
    if space > _ENUMERATION_CAP:
        return None
    count = 0
    for candidate in itertools.permutations(range(inst["n"])):
        if verify(inst, list(candidate))[0]:
            count += 1
    return count


def _offset_signature(inst: dict) -> tuple[int, ...]:
    n = inst["n"]
    left_cycle = _cycle_from_zero(inst["left_successor"])
    right_cycle = _cycle_from_zero(inst["right_successor"])
    if left_cycle is None or right_cycle is None:
        raise ValueError("successor data must consist of full cycles")
    left_position = [0] * n
    right_position = [0] * n
    for i, vertex in enumerate(left_cycle):
        left_position[vertex] = i
    for i, vertex in enumerate(right_cycle):
        right_position[vertex] = i
    offsets = {
        (right_position[v] - left_position[u]) % n
        for u, row in enumerate(inst["adjacency"])
        for v in row
    }
    if len(offsets) != inst["degree"]:
        raise ValueError("adjacency is not a union of the declared edge orbits")

    # Origins of either cycle are arbitrary.  Swapping the bipartition negates
    # offsets.  Normalize both translation and that side-swap reflection.
    forms: list[tuple[int, ...]] = []
    for sign in (1, -1):
        signed = [(sign * x) % n for x in offsets]
        for anchor in signed:
            forms.append(tuple(sorted((x - anchor) % n for x in signed)))
    return min(forms)


def canonical_key(inst: dict) -> str:
    """Key the structured graph modulo labels, input order, and side swap."""
    payload = json.dumps(
        [inst["n"], inst["degree"], list(_offset_signature(inst))],
        separators=(",", ":"),
    ).encode()
    return hashlib.sha256(payload).hexdigest()


def escalate(params: dict) -> dict | str | None:
    """Raise order/crowding until the 256-atom output cap becomes binding."""
    n = int(params.get("n", DIFFICULTY["easy"]["n"]))
    degree = int(params.get("degree", max(2, round(n / 10))))
    if n >= 251:
        return "cap_bound"
    new_n = min(251, n + 20)
    new_degree = max(degree + 2, round(new_n * degree / n))
    return {"n": new_n, "degree": min(new_degree, new_n - 1)}


def _left_order(inst: dict) -> list[int]:
    order = _cycle_from_zero(inst["left_successor"])
    if order is None:
        raise ValueError("invalid left-successor cycle")
    return order


def _outlier_attack(inst: dict) -> list[int]:
    """Independent per-row choice using degree, then the smallest public label."""
    n = inst["n"]
    right_degree = [0] * n
    for row in inst["adjacency"]:
        for v in row:
            right_degree[v] += 1
    return [
        min(inst["adjacency"][u], key=lambda v: (right_degree[v], v))
        for u in _left_order(inst)
    ]


def _greedy_attack(inst: dict, largest: bool = False) -> list[int]:
    used: set[int] = set()
    answer: list[int] = []
    for u in _left_order(inst):
        available = [v for v in inst["adjacency"][u] if v not in used]
        if not available:
            # Preserve the required shape while making the failed partial result
            # explicit; verification will reject its repeated sentinel choice.
            answer.extend([0] * (inst["n"] - len(answer)))
            return answer
        v = max(available) if largest else min(available)
        used.add(v)
        answer.append(v)
    return answer


def _random_restart_attack(
    inst: dict, rng: random.Random, restarts: int = 256
) -> tuple[list[int], int]:
    order = _left_order(inst)
    last = [0] * inst["n"]
    choices = 0
    for _ in range(restarts):
        used: set[int] = set()
        candidate = [-1] * inst["n"]
        positions = list(range(inst["n"]))
        rng.shuffle(positions)
        failed = False
        for t in positions:
            u = order[t]
            available = [v for v in inst["adjacency"][u] if v not in used]
            choices += len(inst["adjacency"][u])
            if not available:
                failed = True
                break
            v = available[rng.randrange(len(available))]
            used.add(v)
            candidate[t] = v
        if not failed:
            return candidate, choices
        last = [0 if v < 0 else v for v in candidate]
    return last, choices


def _aligned_cycle_attack(inst: dict) -> list[int]:
    answer = [0]
    for _ in range(1, inst["n"]):
        answer.append(inst["right_successor"][answer[-1]])
    return answer


def _symmetry_decode(inst: dict) -> tuple[list[int], int]:
    """Successful compact route: orbit any edge from L_0 under sR."""
    start = inst["adjacency"][0][0]
    answer = [start]
    for _ in range(1, inst["n"]):
        answer.append(inst["right_successor"][answer[-1]])
    return answer, inst["n"] - 1


def _hopcroft_karp(inst: dict) -> tuple[list[int] | None, int]:
    """Reference maximum matching, with deterministic edge-operation count."""
    adjacency = inst["adjacency"]
    n = inst["n"]
    pair_u = [-1] * n
    pair_v = [-1] * n
    distance = [0] * n
    operations = n * inst["degree"]  # reading the explicit edge lists

    def bfs() -> bool:
        nonlocal operations
        queue: deque[int] = deque()
        found = False
        for u in range(n):
            operations += 1
            if pair_u[u] < 0:
                distance[u] = 0
                queue.append(u)
            else:
                distance[u] = -1
        while queue:
            u = queue.popleft()
            for v in adjacency[u]:
                operations += 1
                mate = pair_v[v]
                if mate < 0:
                    found = True
                elif distance[mate] < 0:
                    distance[mate] = distance[u] + 1
                    queue.append(mate)
        return found

    def dfs(u: int) -> bool:
        nonlocal operations
        for v in adjacency[u]:
            operations += 1
            mate = pair_v[v]
            if mate < 0 or (distance[mate] == distance[u] + 1 and dfs(mate)):
                pair_u[u] = v
                pair_v[v] = u
                return True
        distance[u] = -1
        return False

    matched = 0
    while bfs():
        for u in range(n):
            if pair_u[u] < 0 and dfs(u):
                matched += 1
    if matched != n:
        return None, operations
    return [pair_u[u] for u in _left_order(inst)], operations


def _relabel_instance(
    inst: dict, left_map: list[int], right_map: list[int]
) -> dict:
    """Carry the structured graph and its certificate through two relabelings."""
    n = inst["n"]
    if sorted(left_map) != list(range(n)) or sorted(right_map) != list(range(n)):
        raise ValueError("maps must be permutations of 0..n-1")
    new_left_successor = [-1] * n
    new_right_successor = [-1] * n
    new_adjacency: list[list[int]] = [[] for _ in range(n)]
    for old in range(n):
        new_left_successor[left_map[old]] = left_map[inst["left_successor"][old]]
        new_right_successor[right_map[old]] = right_map[inst["right_successor"][old]]
        new_adjacency[left_map[old]] = sorted(right_map[v] for v in inst["adjacency"][old])

    old_order = _left_order(inst)
    old_matching = {u: inst["answer"][t] for t, u in enumerate(old_order)}
    inverse_left = [0] * n
    for old, new in enumerate(left_map):
        inverse_left[new] = old
    skeleton = {
        "family": inst["family"],
        "n": n,
        "degree": inst["degree"],
        "left_successor": new_left_successor,
        "right_successor": new_right_successor,
        "adjacency": new_adjacency,
    }
    new_order = _left_order(skeleton)
    skeleton["answer"] = [
        right_map[old_matching[inverse_left[new_left]]] for new_left in new_order
    ]
    return skeleton


def _swap_sides(inst: dict) -> dict:
    """Swap L and R and carry the perfect matching by inversion."""
    n = inst["n"]
    inverse_rows: list[list[int]] = [[] for _ in range(n)]
    for u, row in enumerate(inst["adjacency"]):
        for v in row:
            inverse_rows[v].append(u)
    for row in inverse_rows:
        row.sort()
    old_order = _left_order(inst)
    old_matching = {u: inst["answer"][t] for t, u in enumerate(old_order)}
    inverse_matching = {v: u for u, v in old_matching.items()}
    skeleton = {
        "family": inst["family"],
        "n": n,
        "degree": inst["degree"],
        "left_successor": list(inst["right_successor"]),
        "right_successor": list(inst["left_successor"]),
        "adjacency": inverse_rows,
    }
    new_order = _left_order(skeleton)
    skeleton["answer"] = [inverse_matching[u] for u in new_order]
    return skeleton


def _find_invalid_swap(inst: dict, answer: list[int]) -> list[int]:
    for i in range(inst["n"]):
        for j in range(i + 1, inst["n"]):
            bad = answer[:]
            bad[i], bad[j] = bad[j], bad[i]
            if not verify(inst, bad)[0]:
                return bad
    raise AssertionError("could not find a rejected transposition")


def selftest() -> dict:
    """Run gates G1--G9 and return machine-readable measured evidence."""
    report: dict[str, Any] = {}

    checked = 0
    for preset, params in DIFFICULTY.items():
        for seed in (0, 1, 17, 99):
            inst = make_instance(seed=seed, **params)
            ok, why = verify(inst, inst["answer"])
            assert ok, (preset, seed, why)
            assert json.loads(json.dumps(inst["answer"])) == inst["answer"]
            checked += 1
    report["G1_planted_verifies"] = {
        "pass": True,
        "instances": checked,
        "generation_route": "inverse generation as a union of matching orbits",
    }

    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
    inst = make_instance(seed=20260905, **ship_params)
    answer = inst["answer"]
    corruptions = {
        "empty": [],
        "drop_one": answer[:-1],
        "duplicate": answer[:-1] + [answer[-2]],
        "out_of_range": answer[:-1] + [inst["n"]],
        "swap_two": _find_invalid_swap(inst, answer),
    }
    reasons: dict[str, str] = {}
    for name, bad in corruptions.items():
        ok, why = verify(inst, bad)
        assert not ok, (name, why)
        reasons[name] = why
    assert len(set(reasons.values())) == len(reasons), reasons
    report["G2_rejects_corruption"] = {"pass": True, "reasons": reasons}

    response = (
        "The color classes come from a perfect matching.\n```json\n<answer>"
        + json.dumps(answer)
        + "</answer>\n```\nAll indices are zero-based."
    )
    assert parse_answer(response) == answer
    assert parse_answer("no tagged answer") is None
    assert parse_answer("<answer>[0, false]</answer>") is None
    report["G3_round_trip"] = {
        "pass": True,
        "json_native": True,
        "answer_elements": len(answer),
    }

    guess_inst = make_instance(seed=8675309, **ship_params)
    guess_rng = random.Random(13579)
    guess_total = 200_000
    guess_hits = 0
    for _ in range(guess_total):
        if verify(guess_inst, random_candidate(guess_inst, guess_rng))[0]:
            guess_hits += 1
    guess_density = guess_hits / guess_total
    assert guess_density < 1e-6, (guess_hits, guess_total)
    report["G4_guess_resistance"] = {
        "pass": True,
        "hits": guess_hits,
        "total": guess_total,
        "empirical_probability": guess_density,
        "structure_aware_space": search_space(guess_inst),
        "prior": "uniform permutations of all n right-vertex indices",
    }

    demo = make_instance(seed=31415, **DIFFICULTY["demo"])
    demo_count = enumerate_all(demo)
    assert isinstance(demo_count, int) and demo_count >= 1

    density_inst = make_instance(seed=112358, **ship_params)
    density_rng = random.Random(24680)
    density_total = 200_000
    density_hits = 0
    for _ in range(density_total):
        if verify(density_inst, random_candidate(density_inst, density_rng))[0]:
            density_hits += 1

    attack_seeds = list(range(3100, 3108))
    attacks = {
        "per_element_degree_outlier": {"successes": 0, "attempts": 8},
        "greedy_largest_unused_neighbor": {"successes": 0, "attempts": 8},
        "random_restart_greedy_256": {"successes": 0, "attempts": 8},
        "by_hand_align_zero_anchors": {"successes": 0, "attempts": 8},
    }
    restart_choices = 0
    restart_elapsed = 0.0
    reference_operations: list[int] = []
    reference_elapsed = 0.0
    reference_successes = 0
    compact_operations: list[int] = []
    compact_successes = 0
    for seed in attack_seeds:
        target = make_instance(seed=seed, **ship_params)
        if verify(target, _outlier_attack(target))[0]:
            attacks["per_element_degree_outlier"]["successes"] += 1
        if verify(target, _greedy_attack(target, largest=True))[0]:
            attacks["greedy_largest_unused_neighbor"]["successes"] += 1
        t0 = time.perf_counter()
        restarted, choices = _random_restart_attack(
            target, random.Random(seed ^ 0x5A17), restarts=256
        )
        restart_elapsed += time.perf_counter() - t0
        restart_choices += choices
        if verify(target, restarted)[0]:
            attacks["random_restart_greedy_256"]["successes"] += 1
        if verify(target, _aligned_cycle_attack(target))[0]:
            attacks["by_hand_align_zero_anchors"]["successes"] += 1

        t0 = time.perf_counter()
        matched, operations = _hopcroft_karp(target)
        reference_elapsed += time.perf_counter() - t0
        reference_operations.append(operations)
        if matched is not None and verify(target, matched)[0]:
            reference_successes += 1

        decoded, operations = _symmetry_decode(target)
        compact_operations.append(operations)
        if verify(target, decoded)[0]:
            compact_successes += 1

    assert all(row["successes"] == 0 for row in attacks.values()), attacks
    assert reference_successes == len(attack_seeds)
    assert compact_successes == len(attack_seeds)
    assert max(compact_operations) <= 300

    report["G5_density_and_baseline_cost"] = {
        "pass": True,
        "shipping_sample_hits": density_hits,
        "shipping_sample_total": density_total,
        "shipping_valid_fraction": density_hits / density_total,
        "demo_exact_solution_count": demo_count,
        "demo_candidate_count": search_space(demo),
        "reference_wall_seconds": reference_elapsed,
        "reference_max_operations": max(reference_operations),
        "reference_input_edges": ship_params["n"] * ship_params["degree"],
        "reference_attempts": len(attack_seeds),
        "failing_restart_wall_seconds": restart_elapsed,
        "failing_restart_neighbor_checks": restart_choices,
    }

    report["G6_adversary_panel"] = {
        "pass": True,
        "attacks": attacks,
        "reference_algorithm": {
            "name": "Hopcroft--Karp bipartite maximum matching",
            "complexity": "O(E sqrt(V))",
            "wall_clock_sec": reference_elapsed,
            "operations": max(reference_operations),
            "input_edges": ship_params["n"] * ship_params["degree"],
            "solves": f"{reference_successes}/{len(attack_seeds)}, as expected",
        },
        "compact_route": {
            "name": "simultaneous-successor edge orbit",
            "operations": max(compact_operations),
            "solves": f"{compact_successes}/{len(attack_seeds)}",
        },
    }

    doubled_params = dict(ship_params)
    doubled_params["n"] *= 2
    doubled_params["degree"] *= 2
    doubled = make_instance(seed=424242, **doubled_params)
    ok, why = verify(doubled, doubled["answer"])
    assert ok, why
    assert search_space(doubled) > search_space(inst)
    report["G7_scales"] = {
        "pass": True,
        "base_n": inst["n"],
        "doubled_n": doubled["n"],
        "base_edges": inst["n"] * inst["degree"],
        "doubled_edges": doubled["n"] * doubled["degree"],
        "planted_verifies": True,
    }

    invariance_checks = 0
    real_transform_checks = 0
    unrelated_keys: list[str] = []
    for seed in range(20):
        base = make_instance(n=47, degree=7, seed=9000 + seed)
        key = canonical_key(base)
        unrelated_keys.append(key)
        rng = random.Random(700_000 + seed)
        left_map = list(range(base["n"]))
        right_map = list(range(base["n"]))
        rng.shuffle(left_map)
        rng.shuffle(right_map)
        relabeled = _relabel_instance(base, left_map, right_map)
        swapped = _swap_sides(base)
        composed = _swap_sides(relabeled)
        for transformed in (relabeled, swapped, composed):
            assert canonical_key(transformed) == key
            invariance_checks += 1
            ok, why = verify(transformed, transformed["answer"])
            assert ok, (seed, why)
            real_transform_checks += 1
    distinct = len(set(unrelated_keys))
    assert distinct == len(unrelated_keys)
    report["G8_canonical_key"] = {
        "pass": True,
        "invariance_checks": invariance_checks,
        "real_transform_checks": real_transform_checks,
        "distinct_unrelated": distinct,
        "unrelated_total": len(unrelated_keys),
        "symmetries": (
            "independent relabeling of both bipartition classes, adjacency-row "
            "reordering, side swap, and their composition"
        ),
    }

    compact_json = json.dumps(inst["answer"], separators=(",", ":"))
    answer_chars = len(compact_json)
    # The task equates 2,000 characters with about 500 tokens.  The exact token
    # count is tokenizer-dependent, so use the stated four-characters-per-token
    # conversion rounded upward and retain the raw character count.
    answer_tokens = math.ceil(answer_chars / 4)
    answer_elements = len(inst["answer"])
    decoded, intended_operations = _symmetry_decode(inst)
    assert verify(inst, decoded)[0]
    within_caps = (
        answer_chars <= 2000
        and answer_tokens <= 500
        and answer_elements <= 256
        and intended_operations <= 300
    )
    # Filled from the script-owned hardening transcripts after the three runs.
    arms = {
        "bare": {"solved": 0, "attempts": 3},
        "hinted": {"solved": 0, "attempts": 3},
        "placebo": {"solved": 0, "attempts": 3},
    }
    report["G9_no_tool_suitability"] = {
        "pass": within_caps,
        "arms": arms,
        "hinted_minus_placebo": 0.0,
        "hinted_verdict": "pending harden.py run",
        "answer_chars": answer_chars,
        "answer_tokens": answer_tokens,
        "answer_elements": answer_elements,
        "intended_route_operations": intended_operations,
        "token_measure": "ceil(compact JSON characters / 4)",
    }

    report["all_passed"] = all(
        isinstance(value, dict) and value.get("pass")
        for name, value in report.items()
        if name.startswith("G") and name[1:2].isdigit()
    )
    return report


if __name__ == "__main__":
    print(json.dumps(selftest(), indent=2))
