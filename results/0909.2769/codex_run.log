new file mode 100644
index 0000000000000000000000000000000000000000..3fa6cd66cb49184be52fae2baa3f1c1f47de2354
--- /dev/null
+++ b/gen_0909_2769.py
@@ -0,0 +1,900 @@
+"""Verified generator for fall colorings of complements of bipartite graphs.
+
+The family is grounded in the final theorem of arXiv:0909.2769.  For a
+bipartite graph G without isolated vertices, the two-element color classes of
+a fall coloring of the complement G^c are exactly the edges of a perfect
+matching of G.
+
+Instances below are inverse-generated as unions of matching orbits under two
+conjugate cyclic successor permutations.  A certificate is known without
+solving the generated instance.  The module is deterministic in (n, seed),
+standard-library-only, and silent on import.
+"""
+
+from __future__ import annotations
+
+import bisect
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import deque
+from typing import Any
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "bipartite graph",
+        "complement graph",
+        "fall-color classes",
+    ],
+    "verification_operations": [
+        "permutation check",
+        "bipartite edge lookup",
+        "exact proper-coloring check",
+        "exact closed-neighborhood color check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "A simultaneous cyclic action on the two vertex classes preserves every "
+        "edge, so one edge determines a whole perfect matching; without noticing "
+        "that orbit, one must perform general bipartite matching."
+    ),
+    # Updated after the measured shipping run.  The self-test reports the raw
+    # wall-clock and operation counts rather than asking readers to trust prose.
+    "hardness_basis": (
+        "Track B: Section 7 reduces the certificate to bipartite perfect "
+        "matching, for which Hopcroft--Karp runs in O(E sqrt(V)); at shipping "
+        "n=211 the measured reference run reads and processes 4,220 edges plus "
+        "its recorded search operations, while the compact symmetry route uses "
+        "210 successor applications, within the no-tool operation cap."
+    ),
+    "max_answer_tokens": 500,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 5, "degree": 2},
+    "easy": {"n": 211, "degree": 20},
+    "medium": {"n": 229, "degree": 22},
+    "hard": {"n": 251, "degree": 24},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The simultaneous action of the two displayed successor permutations "
+    "preserves the bipartite edge relation."
+)
+PLACEBO_HINT = (
+    "The indexed presentation rewards careful bookkeeping when comparing the "
+    "two displayed vertex classes."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list containing every right-vertex index 0,...,n-1 exactly "
+        "once; position t is paired with the t-th left vertex in the displayed "
+        "left-successor cycle starting at L_0."
+    ),
+    "bounds": {
+        "max_entries_at_shipping": 251,
+        "max_index_at_shipping": 250,
+        "entry_bits": 8,
+    },
+}
+
+NOTES = r"""
+Paper grounding and Step 0.  Section 1 fixes the exact definition: a fall
+k-coloring is a proper coloring in which every closed neighborhood contains
+all k colors.  The final section ("Fall colorings of complement of bipartite
+graphs") proves that, for bipartite G, a fall coloring of G^c consists of
+singletons for isolated vertices and the edges of a perfect matching on all
+positive-degree vertices.  This family uses no isolated vertices, so its
+certificates are exactly perfect matchings, represented as the resulting
+two-vertex fall-color classes.
+
+What makes it easy and the Track choice.  The same final theorem explicitly
+says recognition is polynomial-time because perfect matching is
+polynomial-time.  That rules out Track A before code is written.  This is
+therefore Track B and reports Hopcroft--Karp, O(E sqrt(V)), as a successful
+reference algorithm.  The compact route is different: the supplied successor
+permutations expose a simultaneous cyclic symmetry.  Once that invariant is
+noticed, any one edge incident with L_0 can be followed through the right
+successor cycle to write the entire matching in n-1 table applications.  The
+shipping preset stays below 300 such applications, whereas a generic matching
+implementation must at least read thousands of edge entries.
+
+Generation.  Independently shuffled full cycles are sampled on the left and
+right.  A random set of offsets is sampled, and every offset contributes one
+complete perfect-matching orbit.  The recorded answer is one of these orbits.
+Thus no search produces the certificate, and there is no special planted-edge
+population: every public edge belongs to an orbit with the same degree and
+matching status.  Relabeling either vertex class merely conjugates the two
+cycles and leaves the canonical offset pattern unchanged.
+
+Attacks.  Exact regularity defeats per-vertex degree outliers.  The shuffled
+labels defeat smallest- and largest-label greedy matching.  A 256-restart
+random greedy probe is measured at shipping size.  The hand-runnable ansatz
+that aligns the two successor cycles at their vertices numbered zero is
+excluded during generation, so it fails while other offsets remain valid.
+Hopcroft--Karp is not hidden among these failures: as Track B requires, it is
+reported separately and succeeds.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 200_000
+
+
+def _validate_params(n: int, degree: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise ValueError("n must be an integer")
+    if n < 5 or n > 1000:
+        raise ValueError("n must lie in 5..1000")
+    if isinstance(degree, bool) or not isinstance(degree, int):
+        raise ValueError("degree must be an integer")
+    if degree < 2 or degree >= n:
+        raise ValueError("degree must lie in 2..n-1")
+
+
+def _successor(cycle: list[int]) -> list[int]:
+    out = [-1] * len(cycle)
+    for i, vertex in enumerate(cycle):
+        out[vertex] = cycle[(i + 1) % len(cycle)]
+    return out
+
+
+def _cycle_from_zero(successor: list[int]) -> list[int] | None:
+    n = len(successor)
+    if n == 0:
+        return None
+    seen: set[int] = set()
+    cycle: list[int] = []
+    vertex = 0
+    for _ in range(n):
+        if vertex in seen or not 0 <= vertex < n:
+            return None
+        seen.add(vertex)
+        cycle.append(vertex)
+        vertex = successor[vertex]
+    if vertex != 0 or len(seen) != n:
+        return None
+    return cycle
+
+
+def _contains_sorted(row: list[int], value: int) -> bool:
+    i = bisect.bisect_left(row, value)
+    return i < len(row) and row[i] == value
+
+
+def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
+    """Inverse-generate a bipartite graph and a fall-coloring certificate.
+
+    ``n`` is the number of vertices in each bipartition class.  ``degree`` is
+    the number of matching orbits superposed.  The witness is selected before
+    the graph is assembled; no matching algorithm is run by generation.
+    """
+    unknown = set(params) - {"degree"}
+    if unknown:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(unknown)))
+    degree = params.get("degree", max(2, round(n / 10)))
+    _validate_params(n, degree)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    left_cycle = list(range(n))
+    right_cycle = list(range(n))
+    rng.shuffle(left_cycle)
+    rng.shuffle(right_cycle)
+    left_successor = _successor(left_cycle)
+    right_successor = _successor(right_cycle)
+
+    left_position = [0] * n
+    right_position = [0] * n
+    for i, vertex in enumerate(left_cycle):
+        left_position[vertex] = i
+    for i, vertex in enumerate(right_cycle):
+        right_position[vertex] = i
+
+    # The most obvious by-hand guess aligns the two cycles at L_0 and R_0.
+    # Exclude precisely that orbit.  This conditions only the offset set; every
+    # included orbit is still exchangeable and is itself a perfect matching.
+    aligned_zero_offset = (right_position[0] - left_position[0]) % n
+    eligible_offsets = [x for x in range(n) if x != aligned_zero_offset]
+    offsets = rng.sample(eligible_offsets, degree)
+
+    adjacency: list[list[int]] = [[] for _ in range(n)]
+    for position, left_vertex in enumerate(left_cycle):
+        adjacency[left_vertex] = sorted(
+            right_cycle[(position + offset) % n] for offset in offsets
+        )
+
+    # Choose an orbit before exposing the graph, and serialize it in the answer
+    # convention: entries follow the left-successor cycle starting at L_0.
+    planted_offset = offsets[rng.randrange(len(offsets))]
+    left_order = _cycle_from_zero(left_successor)
+    assert left_order is not None
+    answer = [
+        right_cycle[(left_position[left_vertex] + planted_offset) % n]
+        for left_vertex in left_order
+    ]
+
+    return {
+        "family": "fall_coloring_of_bipartite_complement",
+        "n": n,
+        "degree": degree,
+        "left_successor": left_successor,
+        "right_successor": right_successor,
+        "adjacency": adjacency,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render the complete standalone problem statement."""
+    n = inst["n"]
+    lines = [
+        "FALL COLORING OF A BIPARTITE COMPLEMENT",
+        "",
+        f"There are two disjoint vertex classes L_0,...,L_{n-1} and "
+        f"R_0,...,R_{n-1}.",
+        "The bipartite graph G has no edges within either class.  Its cross-edges",
+        "are given by the adjacency rows below: row i lists exactly the indices j",
+        "for which {L_i,R_j} is an edge of G.",
+        "",
+        "Let H be the simple complement of G on these 2n vertices: two distinct",
+        "vertices are adjacent in H exactly when they are not adjacent in G.",
+        "A proper k-coloring assigns colors 0,...,k-1 to vertices so adjacent",
+        "vertices have different colors.  It is a fall k-coloring when, for every",
+        "vertex, its closed neighborhood (itself plus its H-neighbors) contains",
+        "all k colors.",
+        "",
+        "Two auxiliary permutations sL and sR are also supplied.  The entry sL[i]",
+        "is the successor of left vertex L_i, and sR[j] is the successor of right",
+        "vertex R_j.  Each displayed successor list is one full cycle.",
+        "",
+        "Find a fall n-coloring of H in the following certificate form.  Define",
+        "ell_0=0 and ell_(t+1)=sL[ell_t].  Output a JSON list p of exactly n",
+        "integers.  It means that color t has the two-vertex class",
+        "{L_(ell_t), R_(p[t])}.  Thus p must contain every integer 0,...,n-1",
+        "exactly once, with no repeats, and each indicated pair must be an edge",
+        "of G.  Indices and colors are 0-based; list order matters as just defined.",
+        "",
+        "sL = " + json.dumps(inst["left_successor"], separators=(",", ":")),
+        "sR = " + json.dumps(inst["right_successor"], separators=(",", ":")),
+        "adjacency rows of G:",
+    ]
+    for i, row in enumerate(inst["adjacency"]):
+        lines.append(f"L_{i}: " + " ".join(map(str, row)))
+    lines.extend(
+        [
+            "",
+            "Give your final answer inside <answer></answer> tags as one JSON list",
+            f"of exactly {n} integers.  Example syntax: <answer>[2,0,1]</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the tagged JSON permutation; return None on malformed output."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    raw = matches[-1].strip()
+    try:
+        value = json.loads(raw)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(value, list):
+        return None
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in value):
+        return None
+    return value
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any valid matching/fall-coloring certificate, never the planted one."""
+    n = inst.get("n")
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer must not be empty"
+    if len(answer) != n:
+        return False, f"answer must have exactly {n} entries"
+    for t, value in enumerate(answer):
+        if isinstance(value, bool) or not isinstance(value, int):
+            return False, f"entry {t} is not an integer"
+        if not 0 <= value < n:
+            return False, f"entry {t} is outside 0..{n-1}"
+    if len(set(answer)) != n:
+        return False, "right-vertex indices must form a permutation without repeats"
+
+    left_order = _cycle_from_zero(inst.get("left_successor", []))
+    if left_order is None:
+        return False, "instance left-successor data is not one full cycle"
+    adjacency = inst.get("adjacency")
+    if not isinstance(adjacency, list) or len(adjacency) != n:
+        return False, "instance adjacency data has the wrong shape"
+    for t, (left_vertex, right_vertex) in enumerate(zip(left_order, answer)):
+        row = adjacency[left_vertex]
+        if not isinstance(row, list) or not _contains_sorted(row, right_vertex):
+            return False, f"color class {t} is not an edge of G"
+
+    # This executes the fall-color check in the instance's native objects.
+    # Each proposed pair is an edge of G and hence an independent pair in H.
+    # Distinct left endpoints form a clique in H and distinct right endpoints
+    # form a clique in H.  Consequently every left vertex sees one left endpoint
+    # of every other color (and itself), and symmetrically every right vertex sees
+    # every color.  No theorem oracle or planted-answer comparison is involved.
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from the statement-implied permutation language."""
+    candidate = list(range(inst["n"]))
+    rng.shuffle(candidate)
+    return candidate
+
+
+def search_space(inst: dict) -> int | None:
+    """The exact number n! of structurally admissible permutation strings."""
+    return math.factorial(inst["n"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count all valid certificates exactly when n! stays under a hard cap."""
+    space = search_space(inst)
+    assert space is not None
+    if space > _ENUMERATION_CAP:
+        return None
+    count = 0
+    for candidate in itertools.permutations(range(inst["n"])):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def _offset_signature(inst: dict) -> tuple[int, ...]:
+    n = inst["n"]
+    left_cycle = _cycle_from_zero(inst["left_successor"])
+    right_cycle = _cycle_from_zero(inst["right_successor"])
+    if left_cycle is None or right_cycle is None:
+        raise ValueError("successor data must consist of full cycles")
+    left_position = [0] * n
+    right_position = [0] * n
+    for i, vertex in enumerate(left_cycle):
+        left_position[vertex] = i
+    for i, vertex in enumerate(right_cycle):
+        right_position[vertex] = i
+    offsets = {
+        (right_position[v] - left_position[u]) % n
+        for u, row in enumerate(inst["adjacency"])
+        for v in row
+    }
+    if len(offsets) != inst["degree"]:
+        raise ValueError("adjacency is not a union of the declared edge orbits")
+
+    # Origins of either cycle are arbitrary.  Swapping the bipartition negates
+    # offsets.  Normalize both translation and that side-swap reflection.
+    forms: list[tuple[int, ...]] = []
+    for sign in (1, -1):
+        signed = [(sign * x) % n for x in offsets]
+        for anchor in signed:
+            forms.append(tuple(sorted((x - anchor) % n for x in signed)))
+    return min(forms)
+
+
+def canonical_key(inst: dict) -> str:
+    """Key the structured graph modulo labels, input order, and side swap."""
+    payload = json.dumps(
+        [inst["n"], inst["degree"], list(_offset_signature(inst))],
+        separators=(",", ":"),
+    ).encode()
+    return hashlib.sha256(payload).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Raise order/crowding until the 256-atom output cap becomes binding."""
+    n = int(params.get("n", DIFFICULTY["easy"]["n"]))
+    degree = int(params.get("degree", max(2, round(n / 10))))
+    if n >= 251:
+        return "cap_bound"
+    new_n = min(251, n + 20)
+    new_degree = max(degree + 2, round(new_n * degree / n))
+    return {"n": new_n, "degree": min(new_degree, new_n - 1)}
+
+
+def _left_order(inst: dict) -> list[int]:
+    order = _cycle_from_zero(inst["left_successor"])
+    if order is None:
+        raise ValueError("invalid left-successor cycle")
+    return order
+
+
+def _outlier_attack(inst: dict) -> list[int]:
+    """Independent per-row choice using degree, then the smallest public label."""
+    n = inst["n"]
+    right_degree = [0] * n
+    for row in inst["adjacency"]:
+        for v in row:
+            right_degree[v] += 1
+    return [
+        min(inst["adjacency"][u], key=lambda v: (right_degree[v], v))
+        for u in _left_order(inst)
+    ]
+
+
+def _greedy_attack(inst: dict, largest: bool = False) -> list[int]:
+    used: set[int] = set()
+    answer: list[int] = []
+    for u in _left_order(inst):
+        available = [v for v in inst["adjacency"][u] if v not in used]
+        if not available:
+            # Preserve the required shape while making the failed partial result
+            # explicit; verification will reject its repeated sentinel choice.
+            answer.extend([0] * (inst["n"] - len(answer)))
+            return answer
+        v = max(available) if largest else min(available)
+        used.add(v)
+        answer.append(v)
+    return answer
+
+
+def _random_restart_attack(
+    inst: dict, rng: random.Random, restarts: int = 256
+) -> tuple[list[int], int]:
+    order = _left_order(inst)
+    last = [0] * inst["n"]
+    choices = 0
+    for _ in range(restarts):
+        used: set[int] = set()
+        candidate = [-1] * inst["n"]
+        positions = list(range(inst["n"]))
+        rng.shuffle(positions)
+        failed = False
+        for t in positions:
+            u = order[t]
+            available = [v for v in inst["adjacency"][u] if v not in used]
+            choices += len(inst["adjacency"][u])
+            if not available:
+                failed = True
+                break
+            v = available[rng.randrange(len(available))]
+            used.add(v)
+            candidate[t] = v
+        if not failed:
+            return candidate, choices
+        last = [0 if v < 0 else v for v in candidate]
+    return last, choices
+
+
+def _aligned_cycle_attack(inst: dict) -> list[int]:
+    answer = [0]
+    for _ in range(1, inst["n"]):
+        answer.append(inst["right_successor"][answer[-1]])
+    return answer
+
+
+def _symmetry_decode(inst: dict) -> tuple[list[int], int]:
+    """Successful compact route: orbit any edge from L_0 under sR."""
+    start = inst["adjacency"][0][0]
+    answer = [start]
+    for _ in range(1, inst["n"]):
+        answer.append(inst["right_successor"][answer[-1]])
+    return answer, inst["n"] - 1
+
+
+def _hopcroft_karp(inst: dict) -> tuple[list[int] | None, int]:
+    """Reference maximum matching, with deterministic edge-operation count."""
+    adjacency = inst["adjacency"]
+    n = inst["n"]
+    pair_u = [-1] * n
+    pair_v = [-1] * n
+    distance = [0] * n
+    operations = n * inst["degree"]  # reading the explicit edge lists
+
+    def bfs() -> bool:
+        nonlocal operations
+        queue: deque[int] = deque()
+        found = False
+        for u in range(n):
+            operations += 1
+            if pair_u[u] < 0:
+                distance[u] = 0
+                queue.append(u)
+            else:
+                distance[u] = -1
+        while queue:
+            u = queue.popleft()
+            for v in adjacency[u]:
+                operations += 1
+                mate = pair_v[v]
+                if mate < 0:
+                    found = True
+                elif distance[mate] < 0:
+                    distance[mate] = distance[u] + 1
+                    queue.append(mate)
+        return found
+
+    def dfs(u: int) -> bool:
+        nonlocal operations
+        for v in adjacency[u]:
+            operations += 1
+            mate = pair_v[v]
+            if mate < 0 or (distance[mate] == distance[u] + 1 and dfs(mate)):
+                pair_u[u] = v
+                pair_v[v] = u
+                return True
+        distance[u] = -1
+        return False
+
+    matched = 0
+    while bfs():
+        for u in range(n):
+            if pair_u[u] < 0 and dfs(u):
+                matched += 1
+    if matched != n:
+        return None, operations
+    return [pair_u[u] for u in _left_order(inst)], operations
+
+
+def _relabel_instance(
+    inst: dict, left_map: list[int], right_map: list[int]
+) -> dict:
+    """Carry the structured graph and its certificate through two relabelings."""
+    n = inst["n"]
+    if sorted(left_map) != list(range(n)) or sorted(right_map) != list(range(n)):
+        raise ValueError("maps must be permutations of 0..n-1")
+    new_left_successor = [-1] * n
+    new_right_successor = [-1] * n
+    new_adjacency: list[list[int]] = [[] for _ in range(n)]
+    for old in range(n):
+        new_left_successor[left_map[old]] = left_map[inst["left_successor"][old]]
+        new_right_successor[right_map[old]] = right_map[inst["right_successor"][old]]
+        new_adjacency[left_map[old]] = sorted(right_map[v] for v in inst["adjacency"][old])
+
+    old_order = _left_order(inst)
+    old_matching = {u: inst["answer"][t] for t, u in enumerate(old_order)}
+    inverse_left = [0] * n
+    for old, new in enumerate(left_map):
+        inverse_left[new] = old
+    skeleton = {
+        "family": inst["family"],
+        "n": n,
+        "degree": inst["degree"],
+        "left_successor": new_left_successor,
+        "right_successor": new_right_successor,
+        "adjacency": new_adjacency,
+    }
+    new_order = _left_order(skeleton)
+    skeleton["answer"] = [
+        right_map[old_matching[inverse_left[new_left]]] for new_left in new_order
+    ]
+    return skeleton
+
+
+def _swap_sides(inst: dict) -> dict:
+    """Swap L and R and carry the perfect matching by inversion."""
+    n = inst["n"]
+    inverse_rows: list[list[int]] = [[] for _ in range(n)]
+    for u, row in enumerate(inst["adjacency"]):
+        for v in row:
+            inverse_rows[v].append(u)
+    for row in inverse_rows:
+        row.sort()
+    old_order = _left_order(inst)
+    old_matching = {u: inst["answer"][t] for t, u in enumerate(old_order)}
+    inverse_matching = {v: u for u, v in old_matching.items()}
+    skeleton = {
+        "family": inst["family"],
+        "n": n,
+        "degree": inst["degree"],
+        "left_successor": list(inst["right_successor"]),
+        "right_successor": list(inst["left_successor"]),
+        "adjacency": inverse_rows,
+    }
+    new_order = _left_order(skeleton)
+    skeleton["answer"] = [inverse_matching[u] for u in new_order]
+    return skeleton
+
+
+def _find_invalid_swap(inst: dict, answer: list[int]) -> list[int]:
+    for i in range(inst["n"]):
+        for j in range(i + 1, inst["n"]):
+            bad = answer[:]
+            bad[i], bad[j] = bad[j], bad[i]
+            if not verify(inst, bad)[0]:
+                return bad
+    raise AssertionError("could not find a rejected transposition")
+
