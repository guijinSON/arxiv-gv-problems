+def _attack_greedy_gap(inst):
+    pairs = _pair_from_twin_rows(inst)
+    pairs.sort(key=lambda p: (abs(inst["thresholds"][p[0]]
+                                  - inst["thresholds"][p[1]]), p))
+    return pairs
+
+
+def _attack_twin_numeric(inst):
+    pairs = _pair_from_twin_rows(inst)
+    pairs.sort(key=lambda p: p[0])
+    return pairs
