+        if not isinstance(move, list) or len(move) != 2:
+            return False, f"jump {idx} must be a two-integer JSON array"
+        remove, add = move
+        if (
+            isinstance(remove, bool) or not isinstance(remove, int)
+            or isinstance(add, bool) or not isinstance(add, int)
+        ):
