+def _attack_raw_threshold(inst):
+    removes = sorted(set(inst["start"]) - set(inst["end"]),
+                     key=lambda v: (inst["thresholds"][v], v))
+    unused = set(inst["end"]) - set(inst["start"])
+    pairs = []
+    for r in removes:
+        a = min(unused, key=lambda v: (abs(inst["thresholds"][r]
+                                           - inst["thresholds"][v]), v))
+        unused.remove(a)
+        pairs.append([r, a])
+    return pairs
+
