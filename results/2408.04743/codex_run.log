diff --git a/gen_2408_04743.py b/gen_2408_04743.py
new file mode 100644
index 0000000000000000000000000000000000000000..b95e61b590c0429bf558cdfebbd502cdd93fa6ba
--- /dev/null
+++ b/gen_2408_04743.py
@@ -0,0 +1,863 @@
+"""Verified problem generator for arXiv:2408.04743.
+
+The generated task is bounded-length Token Jumping.  A shortest jump sequence
+is forced to pass through a proper 3-colouring of a hidden regular graph.  The
+colouring and the complete jump sequence are sampled before the graph edges are
+drawn, so every instance has a known witness without making verification trust
+that planted witness.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import random
+import re
+
+
+DIFFICULTY = {
+    "easy": {"n": 18, "matchings": 3},
+    "medium": {"n": 90, "matchings": 3},
+    "hard": {"n": 180, "matchings": 3},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+NOTES = r"""
+Paper reading.  Section 2 gives the definition that matters here: every state
+is an independent set of the same cardinality, and a Token Jumping step removes
+exactly one vertex and adds exactly one vertex.  Section 1 states that Token
+Jumping is PSPACE-complete even on subcubic planar bounded-bandwidth graphs and
+W[1]-hard when parameterised by the number of tokens and jumps.  It also lists
+the easy regimes that must not be mistaken for hardness: FPT on planar and
+K_{3,t}-free graphs when token count is the parameter, plus kernels for bounded
+degree, bounded degeneracy, fixed surfaces, and the O(g^2+gk+k^2) kernel proved
+as Theorem 1.  Here both the token count k=n+1 and length ell=2n+1 grow, and the
+constructed graphs have no fixed-genus promise.
+
+The bounded witness avoids the unbounded-certificate problem of unrestricted
+reachability.  For an arbitrary graph H, the construction has n+1 start
+vertices, n+1 goal vertices, and three colour-choice vertices per vertex of H.
+All starts are adjacent to all goals.  A length-2n+1 path is therefore forced to
+hold one choice for every vertex of H immediately before its unique start-to-
+goal jump; choice conflicts say exactly that this is a proper 3-colouring.
+Consequently the search core is NP-hard by 3-COLOURING, while replay is linear
+in the witness and graph degree.
+
+Plant leakage.  H is the union of the same number of edge-disjoint perfect
+matchings between each pair of three equally sized planted colour classes.
+Every H vertex consequently has identical degree, and all three choice vertices
+for every H vertex also have identical degree.  The outlier attack therefore
+has no degree signal.  Vertex labels, colour names, matching order, jump order,
+and start/goal order are independently shuffled.  The adversary panel checks a
+degree/label outlier rule, deterministic greedy colouring, and 32 randomised
+DSATUR restarts.  Degree six is deliberate: sweeps found degree four easy for
+local search and higher degrees increasingly reveal/force the planted partition.
+The canonical key normally obtains an exact canonical adjacency encoding after
+invariant refinement individualises every H vertex; its documented fallback is
+a strong but incomplete graph invariant.
+""".strip()
+
+
+def _normal_edge(u: int, v: int) -> tuple[int, int]:
+    return (u, v) if u < v else (v, u)
+
+
+def _candidate_id(n: int, vertex: int, colour: int) -> int:
+    return 2 * n + 2 + 3 * vertex + colour
+
+
+def _decode_candidate(n: int, identifier: int) -> tuple[int, int] | None:
+    base = 2 * n + 2
+    offset = identifier - base
+    if offset < 0 or offset >= 3 * n:
+        return None
+    return divmod(offset, 3)
+
+
+def _sequence_from_colouring(
+    n: int,
+    colouring: list[int],
+    start_order: list[int] | None = None,
+    vertex_order: list[int] | None = None,
+    target_order: list[int] | None = None,
+    removal_order: list[int] | None = None,
+) -> list[list[int]]:
+    """Make the unique-phase shortest sequence associated with a colouring."""
+
+    starts = list(range(n + 1)) if start_order is None else list(start_order)
+    vertices = list(range(n)) if vertex_order is None else list(vertex_order)
+    targets = list(range(n + 1)) if target_order is None else list(target_order)
+    removals = list(range(n)) if removal_order is None else list(removal_order)
+
+    jumps: list[list[int]] = []
+    for i, vertex in enumerate(vertices):
+        jumps.append([starts[i], _candidate_id(n, vertex, colouring[vertex])])
+    jumps.append([starts[-1], n + 1 + targets[0]])
+    for i, vertex in enumerate(removals):
+        jumps.append(
+            [_candidate_id(n, vertex, colouring[vertex]), n + 1 + targets[i + 1]]
+        )
+    return jumps
+
+
+def _edge_disjoint_matchings(
+    left: list[int], right: list[int], count: int, rng: random.Random
+) -> set[tuple[int, int]]:
+    edges: set[tuple[int, int]] = set()
+    for _ in range(count):
+        for _attempt in range(20_000):
+            permuted = list(right)
+            rng.shuffle(permuted)
+            proposed = {
+                _normal_edge(u, v) for u, v in zip(left, permuted, strict=True)
+            }
+            if proposed.isdisjoint(edges):
+                edges.update(proposed)
+                break
+        else:
+            raise RuntimeError("could not sample edge-disjoint perfect matchings")
+    return edges
+
+
+def make_instance(n: int, seed: int = 0, matchings: int = 3, **params) -> dict:
+    """Sample a colouring/witness first, then draw a regular graph around it.
+
+    ``n`` is the number of vertices in the hidden 3-colouring instance and is
+    rounded upward to a multiple of three.  The Token Jumping graph has ``n+1``
+    tokens and the requested witness has exactly ``2*n+1`` jumps.
+    """
+
+    if params:
+        unknown = ", ".join(sorted(params))
+        raise TypeError(f"unknown make_instance parameter(s): {unknown}")
+    if type(n) is not int or type(seed) is not int or type(matchings) is not int:
+        raise TypeError("n, seed, and matchings must be integers")
+    if matchings < 1:
+        raise ValueError("matchings must be positive")
+    requested_n = n
+    n = max(n, 3 * matchings)
+    n += (-n) % 3
+    class_size = n // 3
+    if matchings > class_size:
+        raise ValueError("matchings cannot exceed one planted class size")
+
+    rng = random.Random(seed)
+
+    # Sample the answer core first: an equitable colouring, with all observable
+    # names shuffled.  No edges exist yet.
+    shuffled_vertices = list(range(n))
+    rng.shuffle(shuffled_vertices)
+    classes = [
+        shuffled_vertices[i * class_size : (i + 1) * class_size]
+        for i in range(3)
+    ]
+    colour_names = [0, 1, 2]
+    rng.shuffle(colour_names)
+    colouring = [-1] * n
+    for class_index, vertices in enumerate(classes):
+        for vertex in vertices:
+            colouring[vertex] = colour_names[class_index]
+
+    start_order = list(range(n + 1))
+    vertex_order = list(range(n))
+    target_order = list(range(n + 1))
+    removal_order = list(range(n))
+    rng.shuffle(start_order)
+    rng.shuffle(vertex_order)
+    rng.shuffle(target_order)
+    rng.shuffle(removal_order)
+    answer = _sequence_from_colouring(
+        n, colouring, start_order, vertex_order, target_order, removal_order
+    )
+
+    # Only now construct H.  Every vertex gets exactly `matchings` neighbours
+    # in each of the other two planted classes, so no per-vertex degree reveals
+    # which colour choice belongs to the witness.
+    edges: set[tuple[int, int]] = set()
+    for a, b in ((0, 1), (0, 2), (1, 2)):
+        edges.update(_edge_disjoint_matchings(classes[a], classes[b], matchings, rng))
+    edge_list = sorted(edges)
+
+    return {
+        "paper": "arXiv:2408.04743",
+        "family": "bounded-length Token Jumping through a 3-colouring barrier",
+        "requested_n": requested_n,
+        "n": n,
+        "matchings": matchings,
+        "tokens": n + 1,
+        "jump_count": 2 * n + 1,
+        "total_vertices": 5 * n + 2,
+        "edges": edge_list,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render a complete, self-contained Token Jumping search problem."""
+
+    n = inst["n"]
+    base = 2 * n + 2
+    lines = [
+        "Bounded-length Token Jumping",
+        "",
+        "A graph here is finite, undirected, and simple. An independent set is a",
+        "set of vertices with no graph edge between any two of them. A token state",
+        "is an independent set. One token jump removes one occupied vertex r and",
+        "adds one different, currently unoccupied vertex a; the state after the",
+        "jump must again be independent.",
+        "",
+        f"The graph has vertex IDs 0 through {inst['total_vertices'] - 1}, inclusive.",
+        f"There are {n + 1} indistinguishable tokens.",
+        f"Start vertices S are 0 through {n}, inclusive.",
+        f"Goal vertices T are {n + 1} through {2 * n + 1}, inclusive.",
+        f"For each auxiliary vertex v in 0..{n - 1} and colour c in 0..2,",
+        f"the colour-choice vertex X(v,c) has ID {base} + 3*v + c.",
+        "",
+        "These rules define every graph edge; there are no other edges:",
+        "1. Every S vertex is adjacent to every T vertex.",
+        "2. For each v, X(v,0), X(v,1), and X(v,2) are pairwise adjacent.",
+        "3. For each auxiliary edge 'u v' listed below and each c in 0..2,",
+        "   X(u,c) is adjacent to X(v,c).",
+        "",
+        "Auxiliary edges (one undirected edge per line, endpoints are 0-indexed):",
+    ]
+    lines.extend(f"{u} {v}" for u, v in inst["edges"])
+    lines.extend(
+        [
+            "",
+            f"Find exactly {inst['jump_count']} ordered token jumps that transform",
+            "the complete start set S into the complete goal set T. The state after",
+            "every jump, including the last, must be an independent set. Jump order",
+            "matters. Each jump is written as 'removed_vertex -> added_vertex'.",
+            "Vertex IDs are integers; bounds above are inclusive. A vertex cannot be",
+            "removed unless occupied or added unless unoccupied.",
+            "",
+            "Give your final answer inside <answer></answer> tags, with exactly one",
+            f"'removed_vertex -> added_vertex' line per jump ({inst['jump_count']} lines).",
+            "Example syntax: <answer>0 -> 12\n1 -> 15</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    """Parse arrow pairs from the delimited answer block; never raise on junk."""
+
+    try:
+        if not isinstance(text, str):
+            return None
+        match = re.search(r"<answer>(.*?)</answer>", text, re.IGNORECASE | re.DOTALL)
+        if not match:
+            return None
+        body = match.group(1).strip()
+        body = re.sub(r"^```(?:[A-Za-z0-9_-]+)?\s*", "", body)
+        body = re.sub(r"\s*```$", "", body).strip()
+        if not body:
+            return []
+
+        if body.startswith("["):
+            decoded = json.loads(body)
+            if not isinstance(decoded, list):
+                return None
+            out = []
+            for pair in decoded:
+                if (
+                    not isinstance(pair, list)
+                    or len(pair) != 2
+                    or any(type(x) is not int for x in pair)
+                ):
+                    return None
+                out.append([pair[0], pair[1]])
+            return out
+
+        out = []
+        for raw_line in body.splitlines():
+            line = raw_line.strip()
+            if not line:
+                continue
+            line = re.sub(r"^(?:[-*]\s+|\d+[.)]\s*)", "", line)
+            parsed = re.fullmatch(r"([+-]?\d+)\s*(?:->|=>|→|,)\s*([+-]?\d+)", line)
+            if not parsed:
+                return None
+            out.append([int(parsed.group(1)), int(parsed.group(2))])
+        return out
+    except Exception:
+        return None
+
+
+def _h_adjacency(inst: dict) -> list[set[int]]:
+    n = inst["n"]
+    adjacency = [set() for _ in range(n)]
+    for edge in inst["edges"]:
+        if not isinstance(edge, (list, tuple)) or len(edge) != 2:
+            continue
+        u, v = edge
+        if type(u) is int and type(v) is int and 0 <= u < n and 0 <= v < n and u != v:
+            adjacency[u].add(v)
+            adjacency[v].add(u)
+    return adjacency
+
+
+def _neighbours(inst: dict, vertex: int, h_adj: list[set[int]]) -> set[int]:
+    n = inst["n"]
+    if 0 <= vertex <= n:
+        return set(range(n + 1, 2 * n + 2))
+    if n + 1 <= vertex <= 2 * n + 1:
+        return set(range(0, n + 1))
+    decoded = _decode_candidate(n, vertex)
+    if decoded is None:
+        return set()
+    original, colour = decoded
+    result = {
+        _candidate_id(n, original, other)
+        for other in range(3)
+        if other != colour
+    }
+    result.update(_candidate_id(n, other, colour) for other in h_adj[original])
+    return result
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Replay a candidate witness without consulting ``inst['answer']``."""
+
+    if not isinstance(answer, list):
+        return False, "malformed witness: expected a list of integer jump pairs"
+    if not answer:
+        return False, "empty witness: at least one jump is required"
+    expected = inst["jump_count"]
+    if len(answer) != expected:
+        return False, f"wrong jump count: expected {expected}, got {len(answer)}"
+    if any(
+        not isinstance(pair, (list, tuple))
+        or len(pair) != 2
+        or any(type(x) is not int for x in pair)
+        for pair in answer
+    ):
+        return False, "malformed jump: every jump must contain exactly two integers"
+
+    n = inst["n"]
+    limit = inst["total_vertices"]
+    occupied = set(range(n + 1))
+    goal = set(range(n + 1, 2 * n + 2))
+    h_adj = _h_adjacency(inst)
+    seen_jumps: set[tuple[int, int]] = set()
+
+    for index, pair in enumerate(answer, 1):
+        removed, added = pair
+        if not (0 <= removed < limit) or not (0 <= added < limit):
+            return False, f"out of range at jump {index}: valid IDs are 0..{limit - 1}"
+        jump = (removed, added)
+        if jump in seen_jumps:
+            return False, f"duplicate jump at position {index}: {removed} -> {added}"
+        seen_jumps.add(jump)
+        if removed == added:
+            return False, f"same endpoint at jump {index}: remove and add must differ"
+        if removed not in occupied:
+            return False, f"source not occupied at jump {index}: {removed}"
+        if added in occupied:
+            return False, f"target already occupied at jump {index}: {added}"
+
+        occupied.remove(removed)
+        conflicts = _neighbours(inst, added, h_adj).intersection(occupied)
+        if conflicts:
+            conflict = min(conflicts)
+            return (
+                False,
+                f"independence violation at jump {index}: {added} is adjacent to occupied {conflict}",
+            )
+        occupied.add(added)
+
+    if occupied != goal:
+        missing = sorted(goal - occupied)
+        extra = sorted(occupied - goal)
+        return False, f"wrong final state: missing {missing[:3]}, extra {extra[:3]}"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the shortest-path structure, leaving only colouring hard.
+
+    A length-minimal solver gets the phase order, one choice per auxiliary
+    vertex, and all source/target cardinalities for free.  This sampler enforces
+    all of those facts.  It does not bias any choice toward the planted colour.
+    """
+
+    n = inst["n"]
+    colouring = [rng.randrange(3) for _ in range(n)]
+    starts = list(range(n + 1))
+    vertices = list(range(n))
+    targets = list(range(n + 1))
+    removals = list(range(n))
+    rng.shuffle(starts)
+    rng.shuffle(vertices)
+    rng.shuffle(targets)
+    rng.shuffle(removals)
+    return _sequence_from_colouring(
+        n, colouring, starts, vertices, targets, removals
+    )
+
+
+def search_space(inst: dict) -> int | None:
+    """The naive space of ordered, unequal endpoint pairs for every jump."""
+
+    vertex_count = inst["total_vertices"]
+    return (vertex_count * (vertex_count - 1)) ** inst["jump_count"]
+
+
+def _structured_search_space(inst: dict) -> int:
+    n = inst["n"]
+    return math.factorial(n + 1) ** 2 * math.factorial(n) ** 2 * 3**n
+
+
+def _count_three_colourings(inst: dict) -> int | None:
+    n = inst["n"]
+    if n > 15:
+        return None
+    adjacency = _h_adjacency(inst)
+    colours = [-1] * n
+
+    def visit(coloured: int) -> int:
+        if coloured == n:
+            return 1
+        uncoloured = [v for v in range(n) if colours[v] < 0]
+        vertex = max(
+            uncoloured,
+            key=lambda v: (
+                len({colours[u] for u in adjacency[v] if colours[u] >= 0}),
+                len(adjacency[v]),
+                -v,
+            ),
+        )
+        forbidden = {colours[u] for u in adjacency[vertex] if colours[u] >= 0}
+        total = 0
+        for colour in range(3):
+            if colour not in forbidden:
+                colours[vertex] = colour
+                total += visit(coloured + 1)
+                colours[vertex] = -1
+        return total
+
+    return visit(0)
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count all valid jump sequences exactly for auxiliary graphs up to 15 vertices."""
+
+    colourings = _count_three_colourings(inst)
+    if colourings is None:
+        return None
+    n = inst["n"]
+    ordering_factor = math.factorial(n + 1) ** 2 * math.factorial(n) ** 2
+    return colourings * ordering_factor
+
+
+def _digest(value: object) -> str:
+    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonicalise the auxiliary graph, ignoring all presentation labels.
+
+    Invariant local common-neighbour profiles followed by refinement normally
+    individualise every vertex of these random regular graphs.  In that case an
+    exact canonical adjacency string is emitted.  The tied-colour fallback is a
+    strong isomorphism invariant but is not a complete GI algorithm.
+    """
+
+    n = inst["n"]
+    adjacency = _h_adjacency(inst)
+    common = [[0] * n for _ in range(n)]
+    for u in range(n):
+        for v in range(u + 1, n):
+            value = len(adjacency[u].intersection(adjacency[v]))
+            common[u][v] = value
+            common[v][u] = value
+
+    colours = []
+    for v in range(n):
+        profile = sorted(
+            [int(u in adjacency[v]), common[v][u]] for u in range(n) if u != v
+        )
+        colours.append(_digest([len(adjacency[v]), profile]))
+
+    for _ in range(8):
+        next_colours = []
+        for v in range(n):
+            neighbour_profile = sorted(
+                [colours[u], common[v][u]] for u in adjacency[v]
+            )
+            nonneighbour_profile = sorted(
+                common[v][u]
+                for u in range(n)
+                if u != v and u not in adjacency[v]
+            )
+            next_colours.append(
+                _digest([colours[v], neighbour_profile, nonneighbour_profile])
+            )
+        colours = next_colours
+
+    if len(set(colours)) == n:
+        order = sorted(range(n), key=lambda v: colours[v])
+        bits = []
+        for i, u in enumerate(order):
+            bits.extend("1" if v in adjacency[u] else "0" for v in order[i + 1 :])
+        return "tj3c-exact:" + _digest([n, "".join(bits)])
+
+    pairs = sorted(
+        [
+            int(v in adjacency[u]),
+            common[u][v],
+            min(colours[u], colours[v]),
+            max(colours[u], colours[v]),
+        ]
+        for u in range(n)
+        for v in range(u + 1, n)
+    )
+    return "tj3c-invariant:" + _digest([n, sorted(colours), pairs])
+
+
+def escalate(params: dict) -> dict | None:
+    """Increase the empirically hard size while retaining degree six."""
+
+    n = int(params.get("n", 0))
+    matchings = int(params.get("matchings", 3))
+    if n >= 360:
+        return None
+    harder = n + max(45, n // 2)
+    harder += (-harder) % 3
+    return {"n": harder, "matchings": matchings}
+
+
+def _colouring_valid(inst: dict, colouring: list[int]) -> bool:
+    if len(colouring) != inst["n"] or any(c not in (0, 1, 2) for c in colouring):
+        return False
+    return all(colouring[u] != colouring[v] for u, v in inst["edges"])
+
+
+def _attack_outlier(inst: dict) -> list[list[int]]:
+    # Every option degree is 2 + degree_H(v), so label is the only tie-breaker.
+    colouring = [0] * inst["n"]
+    return _sequence_from_colouring(inst["n"], colouring)
+
+
+def _attack_greedy(inst: dict) -> list[list[int]] | None:
+    adjacency = _h_adjacency(inst)
+    colouring = [-1] * inst["n"]
+    for vertex in range(inst["n"]):
+        forbidden = {colouring[u] for u in adjacency[vertex] if colouring[u] >= 0}
+        choices = [colour for colour in range(3) if colour not in forbidden]
+        if not choices:
+            return None
+        colouring[vertex] = choices[0]
+    return _sequence_from_colouring(inst["n"], colouring)
+
+
+def _attack_random_restart(
+    inst: dict, rng: random.Random, restarts: int = 32
+) -> list[list[int]] | None:
+    adjacency = _h_adjacency(inst)
+    n = inst["n"]
+    for _ in range(restarts):
+        colouring = [-1] * n
+        remaining = set(range(n))
+        while remaining:
+            saturation = {
+                v: len({colouring[u] for u in adjacency[v] if colouring[u] >= 0})
+                for v in remaining
+            }
+            best = max(saturation.values())
+            tied = [v for v in remaining if saturation[v] == best]
+            vertex = rng.choice(tied)
+            forbidden = {
+                colouring[u] for u in adjacency[vertex] if colouring[u] >= 0
+            }
+            choices = [colour for colour in range(3) if colour not in forbidden]
+            if not choices:
+                break
+            colouring[vertex] = rng.choice(choices)
+            remaining.remove(vertex)
+        if not remaining and _colouring_valid(inst, colouring):
+            return _sequence_from_colouring(n, colouring)
+    return None
+
+
+def _transform_instance(
+    inst: dict,
+    vertex_perm: list[int],
+    start_perm: list[int],
+    target_perm: list[int],
+    colour_perm: list[int],
+    swap_start_goal: bool,
+    rng: random.Random,
+) -> dict:
+    """Relabel every family symmetry and carry the planted witness through it."""
+
+    n = inst["n"]
+
+    def map_id(identifier: int) -> int:
+        if 0 <= identifier <= n:
+            index = start_perm[identifier]
+            return n + 1 + index if swap_start_goal else index
+        if n + 1 <= identifier <= 2 * n + 1:
+            old_index = identifier - (n + 1)
+            index = target_perm[old_index]
+            return index if swap_start_goal else n + 1 + index
+        decoded = _decode_candidate(n, identifier)
+        if decoded is None:
+            raise ValueError("invalid vertex in witness")
+        vertex, colour = decoded
+        return _candidate_id(n, vertex_perm[vertex], colour_perm[colour])
+
+    edges = []
+    for u, v in inst["edges"]:
+        a, b = vertex_perm[u], vertex_perm[v]
+        edge = [a, b]
+        if rng.randrange(2):
+            edge.reverse()
+        edges.append(edge)
+    rng.shuffle(edges)
+
+    mapped = [[map_id(a), map_id(b)] for a, b in inst["answer"]]
+    if swap_start_goal:
+        mapped = [[b, a] for a, b in reversed(mapped)]
+
+    transformed = dict(inst)
+    transformed["edges"] = edges
+    transformed["answer"] = mapped
+    return transformed
+
+
+def _format_answer(answer: list[list[int]]) -> str:
+    return "\n".join(f"{removed} -> {added}" for removed, added in answer)
+
+
+def selftest() -> dict:
+    """Run gates G1--G8 and return a JSON-serialisable measurement report."""
+
+    report: dict[str, object] = {}
+
+    # G1: every preset, multiple unrelated seeds.
+    g1_checks = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7, 29):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_checks += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": reason})
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "checks": g1_checks,
+        "failures": g1_failures,
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=20260804, **shipping)
+
+    # G2: five corruption classes, deliberately routed to distinct diagnostics.
+    planted = inst["answer"]
+    corruptions: dict[str, list] = {
+        "drop_one": [pair[:] for pair in planted[:-1]],
+        "swap_endpoints": [[planted[0][1], planted[0][0]]]
+        + [pair[:] for pair in planted[1:]],
+        "duplicate_jump": [planted[0][:], planted[0][:]]
+        + [pair[:] for pair in planted[2:]],
+        "empty": [],
+        "out_of_range": [[planted[0][0], inst["total_vertices"]]]
+        + [pair[:] for pair in planted[1:]],
+    }
+    corruption_results = {}
+    reasons = []
+    for name, bad in corruptions.items():
+        ok, reason = verify(inst, bad)
+        corruption_results[name] = {"accepted": ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": all(not row["accepted"] for row in corruption_results.values())
+        and len(set(reasons)) == len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "cases": corruption_results,
+    }
+
+    # G3: prose and a Markdown fence around the exact advertised wire format.
+    easy = make_instance(seed=44, **DIFFICULTY["easy"])
+    response = (
+        "I replayed the states. Final witness follows.\n<answer>\n```text\n"
+        + _format_answer(easy["answer"])
+        + "\n```\n</answer>\nThat is my final answer."
+    )
+    parsed = parse_answer(response)
+    parsed_ok = parsed == easy["answer"]
+    verified_ok, parsed_reason = verify(easy, parsed) if parsed is not None else (False, "none")
+    report["G3_round_trip"] = {
+        "pass": parsed_ok and verified_ok,
+        "parsed_equal": parsed_ok,
+        "verify_reason": parsed_reason,
+    }
+
+    # G4: actual calls to the structure-aware sampler and public verifier.
+    trials = 200_000
+    hits = 0
+    guess_rng = random.Random(0x240804743)
+    for _ in range(trials):
+        candidate = random_candidate(inst, guess_rng)
+        if verify(inst, candidate)[0]:
+            hits += 1
+    probability = hits / trials
+    structured_space = _structured_search_space(inst)
+    naive_space = search_space(inst)
+    report["G4_guess_resistance"] = {
+        "pass": probability < 1e-6,
+        "hits": hits,
+        "total": trials,
+        "measured_probability": probability,
+        "prior": "uniform proper-phase sequences; colours remain uniformly random",
+        "structure_aware_space_digits": len(str(structured_space)),
+        "structure_aware_log10": math.log10(structured_space),
+        "naive_space_digits": len(str(naive_space)),
+        "naive_log10": math.log10(naive_space),
+    }
+
+    # G5: a complete 12-vertex tripartite graph has exactly six colourings.
+    small = make_instance(n=12, seed=5, matchings=4)
+    exact = enumerate_all(small)
+    small_structured = _structured_search_space(small)
+    ordering_factor = math.factorial(13) ** 2 * math.factorial(12) ** 2
+    colourings = exact // ordering_factor if exact is not None else None
+    structured_fraction = (
+        exact / small_structured if exact is not None and small_structured else None
+    )
+    raw_fraction = exact / search_space(small) if exact is not None else None
+    report["G5_sparse"] = {
+        "pass": exact is not None
+        and structured_fraction is not None
+        and structured_fraction < 1e-3,
+        "n": small["n"],
+        "proper_colourings": colourings,
+        "valid_sequences": str(exact),
+        "structured_candidates": str(small_structured),
+        "structured_solution_fraction": structured_fraction,
+        "naive_solution_fraction": raw_fraction,
+    }
+
+    # G6: attacks know the construction but not the answer.
+    attack_seeds = list(range(8))
+    attack_successes = {"degree_outlier": 0, "greedy": 0, "random_restart": 0}
+    degree_spreads = []
+    for seed in attack_seeds:
+        attacked = make_instance(seed=seed + 7000, **shipping)
+        degrees = [len(row) for row in _h_adjacency(attacked)]
+        degree_spreads.append(max(degrees) - min(degrees))
+        attempts = {
+            "degree_outlier": _attack_outlier(attacked),
+            "greedy": _attack_greedy(attacked),
+            "random_restart": _attack_random_restart(
+                attacked, random.Random(seed + 91_000), restarts=32
+            ),
+        }
+        for name, attempted in attempts.items():
+            if attempted is not None and verify(attacked, attempted)[0]:
+                attack_successes[name] += 1
+    report["G6_adversary_panel"] = {
+        "pass": all(value == 0 for value in attack_successes.values())
+        and max(degree_spreads) == 0,
+        "seeds": len(attack_seeds),
+        "successes": attack_successes,
+        "degree_spread_each_seed": degree_spreads,
+        "random_restart_budget_per_seed": 32,
+    }
+
+    # G7: double the shipping size, build, and replay.
+    doubled_params = dict(shipping)
+    doubled_params["n"] = 2 * shipping["n"]
+    doubled = make_instance(seed=1234567, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] >= 2 * inst["n"],
+        "base_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "doubled_graph_vertices": doubled["total_vertices"],
+        "doubled_jumps": doubled["jump_count"],
+        "verify_reason": doubled_reason,
+    }
+
+    # G8: input order, H labels, S/T labels, colour names, direction, and their
+    # composition are all genuine problem symmetries.
+    invariant_checks = 0
+    witness_checks = 0
+    g8_failures = []
+    unrelated_keys = []
+    exact_keys = 0
+    for seed in range(20):
+        original = make_instance(seed=seed + 30_000, **shipping)
+        original_key = canonical_key(original)
+        unrelated_keys.append(original_key)
+        exact_keys += int(original_key.startswith("tj3c-exact:"))
+        transform_rng = random.Random(seed + 80_000)
+        identity_v = list(range(original["n"]))
+        identity_s = list(range(original["n"] + 1))
+        identity_t = list(range(original["n"] + 1))
+        identity_c = [0, 1, 2]
+        vp = identity_v[:]
+        sp = identity_s[:]
+        tp = identity_t[:]
+        cp = identity_c[:]
+        transform_rng.shuffle(vp)
+        transform_rng.shuffle(sp)
+        transform_rng.shuffle(tp)
+        transform_rng.shuffle(cp)
+        specs = [
+            (identity_v, identity_s, identity_t, identity_c, False),
+            (vp, identity_s, identity_t, identity_c, False),
+            (identity_v, sp, tp, identity_c, False),
+            (identity_v, identity_s, identity_t, cp, False),
+            (identity_v, identity_s, identity_t, identity_c, True),
+            (vp, sp, tp, cp, True),
+        ]
+        for number, (vmap, smap, tmap, cmap, swap) in enumerate(specs):
+            transformed = _transform_instance(
+                original, vmap, smap, tmap, cmap, swap, transform_rng
+            )
+            transformed_key = canonical_key(transformed)
+            invariant_checks += 1
+            if transformed_key != original_key:
+                g8_failures.append(
+                    {"seed": seed, "transform": number, "kind": "key changed"}
+                )
+            ok, reason = verify(transformed, transformed["answer"])
+            witness_checks += 1
+            if not ok:
+                g8_failures.append(
+                    {
+                        "seed": seed,
+                        "transform": number,
+                        "kind": "carried witness failed",
+                        "reason": reason,
+                    }
+                )
+    distinct = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures and distinct == 20,
+        "invariance_checks": invariant_checks,
+        "carried_witness_checks": witness_checks,
+        "unrelated_distinct": f"{distinct}/20",
+        "exact_canonical_cases": f"{exact_keys}/20",
+        "failures": g8_failures,
+    }
+
+    gate_rows = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(
+        isinstance(row, dict) and bool(row.get("pass")) for row in gate_rows
+    )
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(shipping)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
