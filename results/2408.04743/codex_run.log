+    "degree_spread_each_seed": [0, 0, 0, 0, 0, 0, 0, 0],
+    "pass": true,
+    "random_restart_budget_per_seed": 32,
+    "seeds": 8,
+    "successes": {
+      "degree_outlier": 0,
+      "greedy": 0,
+      "random_restart": 0
+    }
+  },
+  "G7_scales": {
+    "base_n": 180,
+    "doubled_graph_vertices": 1802,
+    "doubled_jumps": 721,
+    "doubled_n": 360,
+    "pass": true,
+    "verify_reason": "ok"
+  },
+  "G8_canonical_key": {
+    "carried_witness_checks": 120,
+    "exact_canonical_cases": "20/20",
+    "failures": [],
+    "invariance_checks": 120,
+    "pass": true,
+    "unrelated_distinct": "20/20"
+  },
