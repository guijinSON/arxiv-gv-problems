        return None
    out = [0]
    prev = None
    cur = 0
    for _ in range(n - 1):
        nxts = [v for v in adj[cur] if v != prev]
        if not nxts:
            return None
        nxt = nxts[0]
        if nxt in out:
            return None
        out.append(nxt)
        prev, cur = cur, nxt
    if 0 not in adj[cur]:
        return None
    return out


