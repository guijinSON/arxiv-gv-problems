+++ b/selftest_report.json
@@ -0,0 +1,131 @@
+{
+  "G1_planted_verifies": {
+    "failures": [],
+    "pass": true,
+    "verified": 9
+  },
+  "G2_rejects_corruption": {
+    "cases": {
+      "drop_one": {
+        "reason": "A row count mismatch: expected 2, got 1",
+        "rejected": true
+      },
+      "duplicate": {
+        "reason": "A row count mismatch: expected 2, got 3",
+        "rejected": true
+      },
+      "empty": {
+        "reason": "answer keys must be exactly A and B",
+        "rejected": true
