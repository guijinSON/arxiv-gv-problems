+          {"note": "counts even a scalar precursor hit as an attack success", "restarts": 128, "seed": 5, "solved": false},
+          {"note": "counts even a scalar precursor hit as an attack success", "restarts": 128, "seed": 6, "solved": false},
+          {"note": "counts even a scalar precursor hit as an attack success", "restarts": 128, "seed": 7, "solved": false}
+        ],
