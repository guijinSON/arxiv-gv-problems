+    "planted_verify": true,
+    "verify_reason": "ok"
+  },
+  "G8_canonical_key": {
+    "failures": [],
+    "invariance_checks": 160,
+    "pass": true,
+    "real_transform_checks": 160,
+    "transformations": [
+      "permutation",
+      "basis_change",
+      "transpose",
+      "basis_transpose",
+      "power_scaling",
+      "power_scaling_basis",
+      "power_scaling_transpose",
+      "power_scaling_basis_transpose"
+    ],
+    "unrelated_distinct": 20,
