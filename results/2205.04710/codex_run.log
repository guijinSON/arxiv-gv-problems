+          {"note": "counts even a scalar precursor hit as an attack success", "restarts": 128, "seed": 1, "solved": false},
+          {"note": "counts even a scalar precursor hit as an attack success", "restarts": 128, "seed": 2, "solved": false},
+          {"note": "counts even a scalar precursor hit as an attack success", "restarts": 128, "seed": 3, "solved": false},
+          {"note": "counts even a scalar precursor hit as an attack success", "restarts": 128, "seed": 4, "solved": false},
+          {"note": "counts even a scalar precursor hit as an attack success", "restarts": 128, "seed": 5, "solved": false},
+          {"note": "counts even a scalar precursor hit as an attack success", "restarts": 128, "seed": 6, "solved": false},
+          {"note": "counts even a scalar precursor hit as an attack success", "restarts": 128, "seed": 7, "solved": false}
+        ],
