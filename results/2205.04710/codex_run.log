--- /dev/null
+++ b/selftest_report.json
@@ -0,0 +1,122 @@
+{
+  "G1_planted_verifies": {
+    "failures": [],
+    "pass": true,
+    "verified": 9
+  },
+  "G2_rejects_corruption": {
