+
+    realistic = (
+        "I used the affine coset form.\n```json\n<answer>\n"
+        + json.dumps(planted)
+        + "\n</answer>\n```\nThe modular checks are exact."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
