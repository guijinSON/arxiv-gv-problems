+    s = (q - 1) // 6
+    powers = _powers(q, omega)
+    forbidden = {
+        0,
+        q - 1,
+        (-powers[(2 * s) % (q - 1)]) % q,
+        (-powers[(4 * s) % (q - 1)]) % q,
+    }
+    for i in range(1, 4):
+        for j in range(1, 4):
+            if i == j:
+                continue
+            for t in range(1, s):
+                numerator = (
+                    powers[(2 * i * s) % (q - 1)]
+                    - powers[(t + 2 * j * s) % (q - 1)]
+                ) % q
+                denominator = (powers[t] - 1) % q
+                forbidden.add(numerator * pow(denominator, -1, q) % q)
