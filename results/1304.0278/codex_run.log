+        and search_space(doubled) > search_space(ship),
+        "shipping_n": DIFFICULTY[SHIPPING_DIFFICULTY]["n"],
+        "shipping_q": ship["q"],
+        "doubled_n": 2 * DIFFICULTY[SHIPPING_DIFFICULTY]["n"],
+        "doubled_q": doubled["q"],
+        "doubled_verify_reason": doubled_reason,
