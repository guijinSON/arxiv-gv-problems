+    s = (q - 1) // 6
+    powers = _powers(q, omega)
+    forbidden = {
+        0,
+        q - 1,
+        (-powers[(2 * s) % (q - 1)]) % q,
+        (-powers[(4 * s) % (q - 1)]) % q,
