+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        candidates = {}
+        t0 = time.perf_counter()
+        candidates["outlier_smallest_parameters"] = (_default_candidate(inst), {})
+        attack_results["outlier_smallest_parameters"]["wall_clock_sec"] += (
