+def _map_block(block, q, answer):
+    u = answer["u"]
+    shifts = answer["layer_shift"]
+    permutation = answer["layer_perm"]
+    mapped = []
+    for residue, layer in block:
+        new_layer = permutation[layer]
+        new_residue = (u * residue + shifts[new_layer]) % q
