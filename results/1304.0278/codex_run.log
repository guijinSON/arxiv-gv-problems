from time import perf_counter

def factors(n):
    out=[]; d=2
    while d*d<=n:
        if n%d==0:
            out.append(d)
            while n%d==0:n//=d
        d+=1 if d==2 else 2
    if n>1:out.append(n)
    return out

def primitive(q):
    fs=factors(q-1)
    for g in range(2,q):
        if all(pow(g,(q-1)//p,q)"'!=1 for p in fs):return g

def gamma(q,w):
    s=(q-1)//6
    rho=[pow(w,2*i*s,q) for i in range(1,4)]
    bad={0,(-1)%q,(-pow(w,2*s,q))%q,(-pow(w,4*s,q))%q}
    wp=pow(w,1,q)
    vals=[pow(w,2*i*s,q) for i in range(1,4)]
    # i,j are paper'"'s [3] = 1,2,3
    for t in range(1,s):
        wt=pow(w,t,q)
        den=wt-1
        inv=pow(den,-1,q)
        for i in range(3):
            for j in range(3):
                if i"'!=j:
                    bad.add((vals[i]-wt*vals[j])*inv%q)
    for x in range(1,q):
        if x not in bad:return x,len(bad)

for q in [7,1009,10009,1000003]:
