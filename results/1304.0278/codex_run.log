def _canonical_payload(inst):
    """Exact orbit minimum under affine index/layer relabellings.

    A cross-layer anchor fixes the three independent layer translations; a
    nonzero anchor index fixes the nonzero scale.  Enumerating those choices
    and six layer permutations gives the exact minimum without enumerating
    q^4 layer-affine maps.  Alpha translation is deliberately not quotiented:
    it is an intrinsic parameter because B blocks receive the row-frame
    correction described in _map_b_block().
    """

    q = inst["q"]
    anchors = [
        (anchor["alpha"], tuple(sorted(anchor["block"])))
        for anchor in inst["anchors"]
    ]
    cross = [
        item
        for item in anchors
        if sorted(point // q for point in item[1]) == [0, 1, 2]
    ]
    candidates = []
    for origin_alpha, origin_block in cross:
        origin_residue = {
            point // q: point % q
            for point in origin_block
        }
        for scale_anchor, _ in anchors:
            if scale_anchor == 0:
                continue
            scale = pow(scale_anchor, -1, q)
            for permutation in _PERMUTATIONS:
                normalized = []
                for alpha, block in anchors:
                    new_alpha = alpha * scale % q
                    new_block = []
                    for point in block:
                        residue, layer = _decode_point(point, q)
                        new_layer = permutation[layer]
                        new_residue = (residue - origin_residue[layer]) * scale % q
                        new_block.append(_encode_point(new_residue, new_layer, q))
                    normalized.append((new_alpha, tuple(sorted(new_block))))
                candidates.append(tuple(sorted(normalized)))
    if not candidates:
        return (q, tuple(sorted(anchors)))
    return (q, min(candidates))


def canonical_key(inst):
    payload = json.dumps(_canonical_payload(inst), separators=(",", ":"))
    return hashlib.sha256(payload.encode("ascii")).hexdigest()


def _external_relabel(inst, answer, rng):
    """Apply a real problem-preserving affine/layer relabelling."""

    q = inst["q"]
    z = rng.randrange(1, q)
    external_shift = [rng.randrange(q) for _ in range(3)]
    sigma = list(rng.choice(_PERMUTATIONS))

    def map_point(point):
        residue, layer = _decode_point(point, q)
        new_layer = sigma[layer]
        new_residue = (z * residue + external_shift[new_layer]) % q
        return _encode_point(new_residue, new_layer, q)

    anchors = []
    for anchor in inst["anchors"]:
        anchors.append(
            {
                "alpha": z * anchor["alpha"] % q,
                "block": sorted(map_point(point) for point in anchor["block"]),
            }
        )
    rng.shuffle(anchors)
    transformed_inst = {
        "family": inst["family"],
        "q": q,
        "s": inst["s"],
        "anchors": anchors,
        "answer": None,
    }

    old_perm = answer["layer_perm"]
    new_perm = [sigma[old_perm[i]] for i in range(3)]
    new_shift = [0, 0, 0]
    for old_layer in range(3):
        new_layer = sigma[old_layer]
        new_shift[new_layer] = (
            z * answer["layer_shift"][old_layer]
            + external_shift[new_layer]
        ) % q
    transformed_answer = {
        "omega": answer["omega"],
        "gamma": answer["gamma"],
        "u": z * answer["u"] % q,
        "alpha_shift": z * answer["alpha_shift"] % q,
        "layer_shift": new_shift,
        "layer_perm": new_perm,
    }
    transformed_inst["answer"] = transformed_answer
    return transformed_inst, transformed_answer


def escalate(params):
    if not isinstance(params, dict) or "n" not in params:
        return None
    harder = dict(params)
    harder["n"] = int(params["n"]) * 2
    return harder


def _anchor_score(inst, answer):
    q = inst["q"]
    score = 0
    for anchor in inst["anchors"]:
        if _mapped_a_at(q, answer, anchor["alpha"]) == anchor["block"]:
            score += 1
    return score


def _default_candidate(inst):
    q = inst["q"]
    omega, gamma = _parameter_pairs(q)[0]
    return {
        "omega": omega,
        "gamma": gamma,
        "u": 1,
        "alpha_shift": 0,
        "layer_shift": [0, 0, 0],
        "layer_perm": [0, 1, 2],
    }


def _cross_anchors(inst):
    q = inst["q"]
    return [
        anchor
        for anchor in inst["anchors"]
        if sorted(point // q for point in anchor["block"]) == [0, 1, 2]
    ]


def _frame_from_anchor_pair(inst, first, second):
    q = inst["q"]
    alpha_shift = first["alpha"]
    u = (second["alpha"] - alpha_shift) % q
    if u == 0:
        return None
    shifts = [0, 0, 0]
    for point in first["block"]:
        shifts[point // q] = point % q
    return u, alpha_shift, shifts


def _attack_first_anchor_fit(inst):
    started = time.perf_counter()
    cross = _cross_anchors(inst)
    if len(cross) < 2:
        return _default_candidate(inst), {"hypotheses": 0, "wall_clock_sec": 0.0}
    frame = _frame_from_anchor_pair(inst, cross[0], cross[1])
    hypotheses = 0
    if frame is not None:
        u, alpha_shift, shifts = frame
        for omega, gamma in _parameter_pairs(inst["q"]):
            for permutation in _PERMUTATIONS:
                hypotheses += 1
                answer = {
                    "omega": omega,
                    "gamma": gamma,
                    "u": u,
                    "alpha_shift": alpha_shift,
                    "layer_shift": list(shifts),
                    "layer_perm": list(permutation),
                }
                if (
                    _mapped_a_at(inst["q"], answer, cross[0]["alpha"])
                    == cross[0]["block"]
                    and _mapped_a_at(inst["q"], answer, cross[1]["alpha"])
                    == cross[1]["block"]
                ):
                    return answer, {
                        "hypotheses": hypotheses,
                        "wall_clock_sec": round(time.perf_counter() - started, 6),
                    }
    return _default_candidate(inst), {
        "hypotheses": hypotheses,
        "wall_clock_sec": round(time.perf_counter() - started, 6),
    }


def _attack_single_coset(inst):
    started = time.perf_counter()
    cross = _cross_anchors(inst)
    if len(cross) < 2:
        return _default_candidate(inst), {"candidates": 1, "wall_clock_sec": 0.0}
    frame = _frame_from_anchor_pair(inst, cross[0], cross[1])
    if frame is None:
        return _default_candidate(inst), {"candidates": 1, "wall_clock_sec": 0.0}
    u, alpha_shift, shifts = frame
    omega = _primitive_roots(inst["q"])[0]
    best = None
    best_score = -1
    candidates = 0
    for gamma in _admissible_gammas(inst["q"], omega):
        for permutation in _PERMUTATIONS:
            candidates += 1
            answer = {
                "omega": omega,
                "gamma": gamma,
                "u": u,
                "alpha_shift": alpha_shift,
                "layer_shift": list(shifts),
                "layer_perm": list(permutation),
            }
            score = _anchor_score(inst, answer)
            if score > best_score:
                best_score = score
                best = answer
    return best or _default_candidate(inst), {
        "candidates": candidates,

