+    """Combine the public witness with the affine frame in the instance."""
+
+    frame = inst["frame"]
+    return {
+        "omega": answer["omega"],
+        "gamma": answer["gamma"],
+        "u": frame["u"],
+        "alpha_shift": frame["alpha_shift"],
+        "layer_shift": list(frame["layer_shift"]),
+        "layer_perm": list(answer["layer_perm"]),
+    }
+
+
+def _answer_shape_reason(q, answer):
