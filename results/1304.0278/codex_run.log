+    for alpha, block in enumerate(a_blocks):
+        for point in block:
+            residue, layer = _decode_point(point, q)
+            shifted = _encode_point((residue - alpha) % q, layer, q)
+            row_counts[shifted] += 1
+    for block in b_blocks:
+        for point in block:
+            row_counts[point] += 1
