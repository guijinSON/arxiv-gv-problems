+
+@functools.lru_cache(maxsize=None)
+def _primitive_roots(q):
+    factors = _prime_factors(q - 1)
+    return tuple(
+        g
+        for g in range(2, q)
+        if all(pow(g, (q - 1) // p, q) != 1 for p in factors)
+    )
+
+
+@functools.lru_cache(maxsize=None)
+def _powers(q, omega):
+    return tuple(pow(omega, e, q) for e in range(q - 1))
