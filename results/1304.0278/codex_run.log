from collections import Counter

def primitive_root(p):
 fs=[];x=p-1;d=2
 while d*d<=x:
  if x%d==0:
   fs.append(d)
   while x%d==0:x//=d
  d+=1
 if x>1:fs.append(x)
 for g in range(2,p):
  if all(pow(g,(p-1)//r,p)"'!=1 for r in fs):return g

def valid_gammas(q,w):
 s=(q-1)//6
 ex={0,(-1)%q,(-pow(w,2*s,q))%q,(-pow(w,4*s,q))%q}
 for i in range(1,4):
  for j in range(1,4):
   if i==j:continue
   for t in range(1,s):
    ex.add(((pow(w,2*i*s,q)-pow(w,t+2*j*s,q))*pow(pow(w,t,q)-1,-1,q))%q)
 return [x for x in range(q) if x not in ex]

def cons(q,w,gamma):
 s=(q-1)//6
 lam_info={}
 for t in range(1,s+1):
  for i in range(1,4):
   a=(-gamma*pow(w,t-1+2*(i-1)*s,q))%q
   lam_info[a]=(t,i)
 A=[]
 inv=pow(gamma,-1,q)
 for a in range(q):
  if a in lam_info:
   t,i=lam_info[a]
   bl=[(pow(w,t-1+2*(j-1)*s,q),i-1) for j in range(1,4)]
  else:
   bl=[((-a*inv*pow(w,2*i*s,q))%q,i) for i in range(3)]
  A.append(bl)
 B=[]
 for t in range(1,s+1):
  for j in range(1,4):
   z=pow(w,t-1+2*(j-1)*s,q)
   B.append([((z*(pow(w,2*i*s,q)+gamma))%q,i) for i in range(3)])
 return A,B

def verify(q,A,B):
 S=A+B
 for i in range(3):
  c=Counter()
  for bl in S:
   for x,lx in bl:
    for y,ly in bl:
     if lx==ly==i and x!=y:c[(x-y)%q]+=1
  if c != Counter({d:1 for d in range(1,q)}):return False,('"'pure',i,c)
 for i in range(3):
  for j in range(3):
   if i==j:continue
   c=Counter()
   for bl in S:
    for x,lx in bl:
     for y,ly in bl:
      if lx==i and ly==j:c[(x-y)%q]+=1
   if c "'!= Counter({d:1 for d in range(q)}):return False,('"'mix',i,j,c)
 pts=Counter(p for bl in A for p in bl)
 if pts "'!= Counter({(x,i):1 for i in range(3) for x in range(q)}):return False,('"'part',pts)
 if any({i for _,i in bl}"'!={0,1,2} for bl in B):return False,('"'B')
 R=[]
 for a,bl in enumerate(A):R += [((x-a)%q,i) for x,i in bl]
 for bl in B:R+=bl
 c=Counter(R)
 if set(c.values())- {1,2} or len(c)"'!=3*q:return False,('"'row',c)
 return True,'ok'
for q in [7,13,19,31,37,43,61]:
 w=primitive_root(q); gs=valid_gammas(q,w)
 oks=[]
 for g in gs:
  ok,_=verify(q,*cons(q,w,g))
  if ok:oks.append(g)
 print(q,w,len(gs),len(oks),gs,oks)
