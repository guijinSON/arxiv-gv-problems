+    s = (q - 1) // 6
+    powers = _powers(q, omega)
+    return {
+        powers[(t - 1 + 2 * (i - 1) * s) % (q - 1)]: (t, i)
+        for t in range(1, s + 1)
+        for i in range(1, 4)
+    }
+
+
+@functools.lru_cache(maxsize=None)
+def _admissible_gammas(q, omega):
+    """Proposition 6.2 conditions (A),(B), plus 1 not in Lambda.
