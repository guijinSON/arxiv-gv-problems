+def _base_a_block(q, omega, gamma, alpha, context=None):
+    if context is None:
+        context = _starter_context(q, omega, gamma)
+    s = (q - 1) // 6
+    coset_element = (-alpha * context["gamma_inv"]) % q
+    special = context["coset"].get(coset_element)
+    if special is not None:
