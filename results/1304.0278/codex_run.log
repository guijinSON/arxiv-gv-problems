+    same_set = set(same_layer)
+    cross_layer = [alpha for alpha in range(q) if alpha not in same_set]
+    extra = anchor_count - 2
+    n_same = min(len(same_layer), extra, (q - 1) // 6)
+    n_cross = extra - n_same
