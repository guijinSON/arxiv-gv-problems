+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate an anchored Proposition 6.2 starter instance."""
+
+    if isinstance(n, bool) or not isinstance(n, int) or n < 7:
+        raise ValueError("n must be an integer at least 7")
