+@functools.lru_cache(maxsize=65536)
+def _starter_context(q, omega, gamma):
+    s = (q - 1) // 6
+    return {
+        "coset": _coset_info(q, omega),
+        "gamma_inv": pow(gamma, -1, q),
+        "rho": tuple(pow(omega, 2 * i * s, q) for i in range(3)),
+    }
