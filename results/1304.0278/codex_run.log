+    s = (q - 1) // 6
+    b_blocks = []
+    for t in range(1, s + 1):
+        for j in range(1, 4):
+            z = pow(omega, t - 1 + 2 * (j - 1) * s, q)
+            b_blocks.append(
+                [
+                    (z * (context["rho"][i] + gamma) % q, i)
+                    for i in range(3)
