+
+def _is_prime(n):
+    if isinstance(n, bool) or not isinstance(n, int) or n < 2:
+        return False
+    if n % 2 == 0:
+        return n == 2
+    d = 3
+    while d * d <= n:
+        if n % d == 0:
+            return False
+        d += 2
+    return True
