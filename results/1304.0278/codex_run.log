+    mixed = [[[0 for _ in range(q)] for _ in range(3)] for _ in range(3)]
+    for block in a_blocks + b_blocks:
+        decoded = [_decode_point(point, q) for point in block]
+        for left in range(3):
+            x, i = decoded[left]
+            for right in range(3):
