+    for omega, gamma in _parameter_pairs(q):
+        for permutation in _PERMUTATIONS:
+            counter["hypotheses"] += 1
+            answer = {
+                "omega": omega,
+                "gamma": gamma,
+                "layer_perm": list(permutation),
+            }
+            matched, _ = _matches_anchors(inst, answer, counter)
+            if matched:
