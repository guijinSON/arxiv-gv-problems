+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+
+STRUCTURAL_HINT = (
+    "The same-layer anchor triples and cross-layer slopes are affine images "
+    "of three multiplicative cosets of the sixth-power subgroup of F_q*."
+)
+PLACEBO_HINT = (
