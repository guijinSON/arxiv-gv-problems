+    # are randomized, and neither their roles nor their order is disclosed.
+    by_t = {}
+    for z, (t, i) in context["coset"].items():
+        by_t.setdefault(t, []).append((-gamma * z) % q)
+    if n_same <= (q - 1) // 6:
+        same_choices = [
+            rng.choice(by_t[t])
+            for t in range(1, n_same + 1)
+        ]
