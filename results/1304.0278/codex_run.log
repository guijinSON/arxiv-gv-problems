+        "random_restart_256": {"successes": 0, "attempts": 0, "wall_clock_sec": 0.0},
+        "in_context_single_coset_ansatz": {"successes": 0, "attempts": 0, "wall_clock_sec": 0.0},
+    }
+    reference_totals = {
+        "successes": 0,
+        "attempts": 0,
+        "hypotheses": 0,
