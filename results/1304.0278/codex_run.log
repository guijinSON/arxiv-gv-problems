+        (target_alpha - full_answer["alpha_shift"])
+        * pow(full_answer["u"], -1, q)
+    ) % q
+    context = _starter_context(q, full_answer["omega"], full_answer["gamma"])
+    block = _base_a_block(
+        q, full_answer["omega"], full_answer["gamma"], old_alpha, context
+    )
