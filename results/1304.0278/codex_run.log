+                if ok:
+                    counter["wall_clock_sec"] = round(
+                        time.perf_counter() - started, 6
+                    )
+                    return answer, counter
+    counter["wall_clock_sec"] = round(time.perf_counter() - started, 6)
+    return None, counter
