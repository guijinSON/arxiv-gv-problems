+def _attack_identity_layer_ansatz(inst):
+    """A genuinely by-hand Track-B attack with two obvious assumptions.
+
+    Locate the publicly indexed transformed A_1 block, assume the displayed
+    layers already have the paper's names, read gamma from layer zero, and
+    guess the smallest primitive element.  If that tuple violates the stated
+    certificate language, fall back to its lexicographically first member.
+    This performs no candidate enumeration and no anchor scoring.
+    """
+
+    started = time.perf_counter()
+    q = inst["q"]
+    frame = inst["frame"]
+    target_a1 = (frame["u"] + frame["alpha_shift"]) % q
+    anchor_a1 = next(
+        (anchor for anchor in inst["anchors"] if anchor["alpha"] == target_a1),
+        None,
+    )
+    fallback = _default_candidate(inst)
+    if anchor_a1 is None:
+        return fallback, {
+            "assumptions": 2,
+            "exact_arithmetic_operations": 0,
+            "wall_clock_sec": round(time.perf_counter() - started, 6),
+        }
+
+    u_inv, operations = _inverse_with_cost(frame["u"], q)
+    normalized_by_layer = [None, None, None]
+    for point in anchor_a1["block"]:
+        residue, layer = _decode_point(point, q)
+        normalized_by_layer[layer] = (
+            (residue - frame["layer_shift"][layer]) * u_inv
+        ) % q
+        operations += 2
+
+    layer_zero_value = normalized_by_layer[0]
+    if layer_zero_value in (None, 0):
+        candidate = fallback
+    else:
+        inverse, inverse_cost = _inverse_with_cost(layer_zero_value, q)
+        operations += inverse_cost
+        candidate = {
+            "omega": _primitive_roots(q)[0],
+            "gamma": (-inverse) % q,
+            "layer_perm": [0, 1, 2],
+        }
+        if _answer_shape_reason(q, candidate) is not None:
+            candidate = fallback
+    return candidate, {
+        "assumptions": 2,
+        "exact_arithmetic_operations": operations,
+        "wall_clock_sec": round(time.perf_counter() - started, 6),
+    }
+
+
