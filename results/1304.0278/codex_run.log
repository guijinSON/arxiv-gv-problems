+            arm_values["hinted"]["solved"]
+            / arm_values["hinted"]["attempts"]
+            - arm_values["placebo"]["solved"]
+            / arm_values["placebo"]["attempts"]
+        )
+    report["G9_no_tool_suitability"] = {
