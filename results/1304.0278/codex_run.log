+    frame = inst["frame"]
+    return {
+        "omega": answer["omega"],
+        "gamma": answer["gamma"],
+        "u": frame["u"],
+        "alpha_shift": frame["alpha_shift"],
+        "layer_shift": list(frame["layer_shift"]),
+        "layer_perm": list(answer["layer_perm"]),
+    }
