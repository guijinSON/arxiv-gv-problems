+        for i in range(rows):
+            if i != r and a[i][col]:
+                c = a[i][col]
+                a[i] = [(u - c * v) % p for u, v in zip(a[i], a[r])]
+        pivots.append(col)
+        r += 1
+    free = next((j for j in range(cols) if j not in pivots), None)
+    if free is None:
