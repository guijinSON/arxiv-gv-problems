+def _eval_terms_raw(terms, x, p: int, g: int, s: int):
+    """Direct exact evaluation using base-p exponent digits."""
+    bases = [tuple(x), _frob(tuple(x), p, g, 1),
+             _frob(tuple(x), p, g, 2)]
+    powers = []
+    for base in bases:
+        row = [(1, 0, 0)]
+        for _ in range(s):
+            row.append(_mul(row[-1], base, p, g))
+        powers.append(row)
