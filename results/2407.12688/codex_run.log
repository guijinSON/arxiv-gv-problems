+    "consistent throughout the calculation."
+)
+
+# The script-owned runs on 2026-09-05 received only HTTP 403 quota errors.
+# Errors never count as scored attempts, so zero attempts is the honest record.
+G9_RESULTS = {
+    "arms": {
