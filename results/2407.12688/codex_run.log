+def _frobenius_transform(inst, times: int):
+    p, g = inst["p"], inst["g"]
+    out = dict(inst)
+    out["terms"] = [[e, list(_frob(tuple(c), p, g, times))]
+                    for e, c in inst["terms"]]
+    out["target"] = list(_frob(tuple(inst["target"]), p, g, times))
+    out["answer"] = list(_frob(tuple(inst["answer"]), p, g, times))
+    return out
