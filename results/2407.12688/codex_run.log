+        "attacks": attack_counts,
+        "reference_algorithm": {
+            "name": "exhaustive evaluation / inverse-table scan",
+            "complexity": "O(p^3 log s) exact finite-field operations",
+            "wall_clock_sec": round(brute_wall, 6),
+            "candidates_checked": brute_checks,
+            "operations": brute_operations,
+            "solves": "1/1 timed generic scan; 8/8 compact reference, as expected",
+            "compact_reference_successes": compact_successes,
+            "compact_reference_attempts": 8,
