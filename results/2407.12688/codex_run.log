+    # G8: the only representation-preserving field relabellings are Frobenius.
+    invariant = transformed = 0
+    unrelated = []
+    for seed in range(20):
+        inst = make_instance(seed=10000 + seed,
+                             **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(inst)
