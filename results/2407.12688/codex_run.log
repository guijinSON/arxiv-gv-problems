+
+def canonical_key(inst):
+    """Normalize polynomial coefficients and target under field automorphisms."""
+    p, g = inst["p"], inst["g"]
+    orbit = []
+    for j in range(3):
+        terms = tuple(sorted((e, _frob(tuple(c), p, g, j))
+                             for e, c in inst["terms"]))
+        target = _frob(tuple(inst["target"]), p, g, j)
+        orbit.append((terms, target))
+    terms, target = min(orbit)
+    normal = {"p": p, "g": g, "s": inst["s"],
+              "terms": terms, "target": target}
+    blob = json.dumps(normal, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode()).hexdigest()
+
+
+def escalate(params):
+    """Raise field size—and the p^3 haystack—at fixed three-coordinate output."""
+    out = dict(params)
