+        "hinted_minus_placebo": hs - ps if hs is not None and ps is not None
+        else None,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": chars, "answer_tokens": tokens,
+        "answer_elements": atoms, "intended_route_operations": 286,
+    }
