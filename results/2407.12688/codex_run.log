+    """Exhaustive scan after support-factorized polynomial evaluation."""
+    p = inst["p"]
+    checked = 0
+    for x in itertools.product(range(p), repeat=3):
+        checked += 1
+        if _f_eval(inst, x) == tuple(inst["target"]):
+            return list(x), checked
+    return None, checked
