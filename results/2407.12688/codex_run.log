+            i, j = rng.sample(range(3), 2)
+            a[i], a[j] = a[j], a[i]
+        elif step % 3 == 1:
+            i = rng.randrange(3)
+            c = rng.randrange(1, p)
+            a[i] = [c * v % p for v in a[i]]
+        else:
