+    "easy": {"n": 103, "s": 5},
+    "medium": {"n": 163, "s": 5},
+    "hard": {"n": 193, "s": 5},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "One element of F_p[z]/(z^3-g), written uniquely as the three-integer "
