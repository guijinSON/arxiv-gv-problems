+    brute_answer, brute_checks = _brute_force_preimage(shipping)
+    brute_wall = time.perf_counter() - t0
+    brute_ok = brute_answer is not None and verify(shipping, brute_answer)[0]
+    # Conservative count for evaluating the displayed circuit: two A maps and
+    # one fifth power, measured as 86 base-field multiply/add operations each.
+    brute_operations = brute_checks * 86
+    report["G5_density_and_baseline"] = {
