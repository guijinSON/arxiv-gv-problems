+    "native_domain": "number_theory",
+    "object_regime": "integer_lattice",
+    "computational_core": "other",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "irreducible homogeneous binary form over Z",
+        "CM-field Thue equation F(X,Y)=b",
