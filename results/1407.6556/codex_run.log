+
+
+def parse_answer(text):
+    """Extract the last tagged JSON pair, tolerating prose and code fences."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text, re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
