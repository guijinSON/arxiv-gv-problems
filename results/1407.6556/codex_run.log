+    "easy": {"n": 20_000, "degree": 8, "shear_bound": 3, "radix_digits": 4},
+    "medium": {"n": 80_000, "degree": 16, "shear_bound": 4, "radix_digits": 6},
+    "hard": {"n": 240_000, "degree": 32, "shear_bound": 5, "radix_digits": 8},
+}
+SHIPPING_DIFFICULTY = "medium"
