+    doubled_seconds = time.perf_counter() - tick
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    ladder_n = [params["n"] for params in DIFFICULTY.values()]
+    ladder_degrees = [params["degree"] for params in DIFFICULTY.values()]
+    report["G7_scales"] = {
+        "pass": doubled_ok
