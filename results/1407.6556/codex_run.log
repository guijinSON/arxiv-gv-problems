+        "reference_operation_count": reference["operations"],
+        "reference_scan_iterations": reference["iterations"],
+    }
+
+    scale_base = make_instance(seed=77, **shipping)
+    doubled_params = dict(shipping)
+    doubled_params["n"] *= 2
