+def _invert_coordinates(matrix, u, v):
+    a, b, c, d = matrix
+    determinant = a * d - b * c
+    x_num = d * u - b * v
+    y_num = -c * u + a * v
+    if determinant not in (-1, 1):
+        return None
+    return [x_num // determinant, y_num // determinant]
