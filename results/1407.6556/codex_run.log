+        out["shear_bound"] = min(20, out.get("shear_bound", 4) + 1)
+        return out
+    if out.get("n", 0) < 2_000_000:
+        out["n"] = min(2_000_000, out["n"] * 2)
+        out["radix_digits"] = min(32, out.get("radix_digits", 8) + 2)
+        out["shear_bound"] = min(20, out.get("shear_bound", 5) + 1)
