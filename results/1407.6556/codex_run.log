+                swap,
+                sign_x,
+                sign_y,
+                5000 + seed * 8 + 4 * int(swap) + 2 * (sign_x > 0) + (sign_y > 0),
+            )
+            total_symmetries += 1
+            invariance_passed += int(canonical_key(transformed) == original_key)
+            carried_passed += int(verify(transformed, transformed["answer"])[0])
