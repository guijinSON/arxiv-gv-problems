   280	
   281	\section{Proof of Theorem 1}
   282	
   283	  Write
   284	 $$F(X,Y) = a_0 (X-\alpha_1 Y)\cdots (X-\alpha_n Y).$$
   285	First, we consider the case where $a_0 = \pm 1$. If $a_0=-1$,  we replace $F(X,Y)$ by $-F(X,Y)$
   286	and $b$ by $-b$ and  then we may suppose that $a_0 = 1$.
   287	By our hypothesis, there is  $j$ such that $K_j = K(\alpha_j)$ is a CM-field.   
   288	
   289	Let $x,y\in O_K$ such that $xy \neq 0$ and $F(x,y) = b$. We set $b_j:=x-\alpha_j y$.
   290	Since $K$ is a totally real number field,  we have $x-\bar{\alpha}_j y = \bar{b}_j$. 
   291	Setting $\bar{b}_j = \rho_j b_j$, we obtain the system
   292	$$x-\alpha_j y = b_j, \ \   x-\bar{\alpha}_j y = \rho_j b_j.$$
   293	Eliminating $b_j$ from the above two equations, we get
   294	$$  x = y \frac{\bar{\alpha}_j-\alpha_j\rho_j}{1-\rho_j}.$$
   295	Set
   296	$$A= \frac{\bar{\alpha}_j-\alpha_j\rho_j}{1-\rho_j}.$$
   297	We have
   298	$$H(A) \leq H(\bar{\alpha}_j-\alpha_j\rho_j) H(1-\rho_j) \leq 4 H(\alpha_j)^2 H(\rho_j)^2.$$
   299	Since $\alpha_j$ is not real,  using \cite{Mignotte}, we deduce
   300	 $H(\alpha_j)< 2 H(F)^{1/2}$.
   301	It follows that
   302	$$H(A) \leq 16 H(F) H(\rho_j)^2.$$
   303	Substituting in the equation $F(x,y) = b$ we deduce that
   304	$$y^n F(A,1) = b,$$
   305	and thus
   306	$$H(y)^n \leq H(F(A,1)) H(b)  \leq (n+1)H(F)H(A)^n H(b).$$
   307	Using the bound for $H(A)$ we obtain
   308	\begin{eqnarray}
   309	H(y)^n \leq (n+1)16^n  H(b) H(F)^{n+1} H(\rho_j)^{2n}.
   310	\end{eqnarray}
   311	
   312	
   313	Next, we shall compute a bound for the height of $\rho_j$. 
   314	We denote by $G_j$ the set of
   315	 $\mbox{\Bdd Q}$-embeddings $\sigma : K_j \rightarrow {\mbox{\Bdd C}}$.
   316	Since $K_j$ is a CM-field, \cite[Th\'{e}or\`{e}me 1]{Gyory2} yields that the complex conjugation
   317	commutes with all the elements of $G_j$. Further,  $K_j$  is closed under the operation of complex conjugation whence we get $\bar{\alpha}_j \in K_j$ and so
   318	$\bar{b}_j\in K_j$. Thus, for every   $\sigma \in G_j$, we have $\sigma(\bar{b}_j) = \overline{\sigma(b_j)}$. It follows that
   319	$$|\sigma(\rho_j) | = \frac{|\sigma(\bar{b}_j)|}{|\sigma(b_j)|} = \frac{|\overline{\sigma(b_j)}|}{|\sigma(b_j)|} = 1.$$
   320	 Let $M_j(X)$ be the minimal polynomial of $\rho_j$ over $\mbox{\Bdd Z}$ and
   321	 $m_j$ its leading coefficient. The elements $\alpha_j$, $\bar{\alpha}_j$ are algebraic integers of $K_j$ and so,
   322	  $b_j$, $\bar{b}_j$ are algebraic integers of $K_j$. It follows that 
   323	 the polynomial
   324	 $$\Pi_j(X) = \prod_{\sigma \in G_j} \sigma(b_j) (X-\sigma(\rho_j))$$
   325	 has integer coefficients. Since $\rho_j$ is a root of $\Pi_j(X)$, we have that  $M_j(X)$ divides $\Pi_j(X)$ and thus we deduce that $m_j$ divides
   326	 $$\prod_{\sigma \in G_j} \sigma(b_j)=N_{K_j}(b_j),$$
   327	 where $N_{K_j}$  is the norm relative to the  extension $K_j/{\mbox{\Bdd Q}}$.
   328	It follows that  $m_j$ divides $N_{K_j}(b_j)$.
   329	As we saw above, all the conjugates $\rho_{j1},\ldots,\rho_{j\mu}$ $(\mu \leq dn)$, of $\rho_j$ are of absolute value 1.  By \cite[page 54]{Lang}, we have
   330	$$
   331	 H_{K_j}(\rho_j) =  m_j  \prod_{i=1}^{\mu} \max\{1,|\rho_{ji}|\} = m_j.
   332	$$
   333	Since $m_j$ divides $N_{K_j}(b_j)$, we have that $m_j$ divides $N_{K_j}(b)$. Thus
   334	\begin{eqnarray}
   335	 H_{K_j}(\rho_j)  \leq N_{K_j}(b).
   336	\end{eqnarray}
   337	
   338	
   339	Combining the inequalities (1) and (2), we get
   340	$$H(y) \leq  32  H(b)^{1/n} H(F)^{1+1/n} N_{K}(b)^{2/d}.$$
   341	We have
   342	$$H(x) \leq H(A) H(y) \leq 16 H(F) H(\rho_j)^2 H(y)$$
   343	whence we obtain
   344	$$H(x) \leq 2^9   H(b)^{1/n} H(F)^{2+1/n} N_{K}(b)^{4/d}.$$
   345	
   346	Suppose now that $a_0 \neq \pm 1$. Write $F(X,1) = a_0 X^n+a_1X^{n-1}+\cdots +a_n $.
   347	Then $a_0\alpha_i$ is a root of  $f(X) = X^n+a_1X^{n-1}+a_2a_0 X^{n-2}+\cdots+a_na_0^{n-1}$ and thus
   348	$a_0\alpha_i$ is an algebraic integer. Denote by $F_1(X,Y)$ the homogenization
   349	of $f(X)$. If $(x,y)\in O_K^2$ is a solution to $F(X,Y)=b$, then $(a_0x,y)$ is  a solution to $F_1(X,Y) = ba_0^{n-1}$.
   350	Denote by $\Gamma$ a point in the projective space with  1 and the coefficients of $F$ as coordinates. Then
   351	we have $H(F_1) \leq H(\Gamma)^n$ and finally, we obtain
   352	$$H(y) \leq  32  H(b)^{1/n} H(\Gamma)^{n+1} N_{K}(b)^{2/d} H(a_0)^{n-1} N_K(a_0)^{2(n-1)/d}$$
   353	and
   354	 $$H(x) \leq 2^9   H(b)^{1/n} H(\Gamma)^{2n+1} N_{K}(b)^{4/d} H(a_0)^{n-1} N_K(a_0)^{2(n-1)/d}.$$
   355	 
   356	Now suppose that $b$ is a unit in $O_K$. Then inequality (2) implies that $H(\rho_j)=1$ and so Kronecker's theorem yields that
   357	$\rho_j$ is a root of unity. 
   358	Let $w$ be the number of the roots of unity in $K_j$. Then we have $w$ choices for $A$ (for the roots of unity  $\neq \pm 1$) and, since $y$ is real, the
   359	equation $y^n F(A,1) = b$ gives us at most $2w$ choices for $y$. Considering also the solutions of the equation with $xy=0$,
   360	we deduce that the number of integral solutions to the
   361	equation $F(X,Y) = b$ is at most $2wn$. 
   362	Finally, suppose that $b$ is not a unit in $O_K$. Using \cite[Lemma 8B]{Schmidt}, we obtain that the number of elements   $\rho_j\in K_j$ with 
   363	$H(\rho_j) \leq  N_K(b)^{1/d}$ is bounded by
   364	$$36\cdot 4^{dn} N_K(b)^{2n}$$
   365	and so the result follows.
   366	
   367	
   368	
   369	\section{An Algorithm}
   370	
   371	In this section we give an algorithm for the computation of the integral solutions
   372	to $F(X,Y) = b$ based on the proof of Theorem 1.
   373	
   374	\ \\
   375	SOLVE-THUE-1\\
   376	{\em Input:} A totally real number field $K$, a form $F(X,Y)\in O_K[X,Y]$ with $F(X,1)$ monic, $b \in O_K\setminus \{0\}$ and $\alpha$
   377	 a root of $F(X,1)$ such that $K(\alpha)$ is a CM-field.\\
   378	{\em Output:} The integral solutions of $F(X,Y) = b$ over $ K$.
   379	 \begin{enumerate}
   380	 \item Compute the set $\Lambda$  of all the elements $\rho\in K(\alpha)\setminus K$
   381	 having  the absolute values of all theirs conjugates equal to 1 and
   382	 $H_{K(\alpha)}(\rho) | N_{K(\alpha)}(b)$. If $b$ is a unit of $O_K$, then the set $\Lambda$
   383	 consist of all the roots of unity of $K(\alpha)$ which does not belong to $K$.
   384	 
   385	 \item Compute the set $\Xi$ of elements $\xi$ of $K$ of the form:
   386	$$\xi = \frac{\bar{\alpha}-\alpha\rho}{1-\rho},$$
   387	where $\rho\in \Lambda$.
   388	
   389	\item Compute the set $S$ of elements $y \in O_K$ such that there is $\xi \in \Xi\cup \{(\bar{\alpha}+ \alpha)/2\}$ with
   390	$$y^n F(\xi,1) = b.$$
   391	
   392	\item Output the solutions $(x,y)\in O_K^2$ to $F(X,Y) = b$ with $y\in S$ and  the solutions
   393	$(x,y)\in O_K^2$ with $xy =0$.
   394	\end{enumerate}
   395	 
   396	{\it Proof of Correctness.}  Let $(x,y)\in O_K^2$ be a solution to $F(X,Y)=b$ with $xy\neq 0$. We set $x-\alpha y = \beta$
   397	 and $\rho = \bar{\beta}/\beta$. From the proof of Theorem 1 we have $x = y A,$ where 
   398	$$A= \frac{\bar{\alpha}-\alpha\rho}{1-\rho},$$
   399	 and so $y^n F(A,1)=b$. Since $x,y \in K$, we get $A\in K$. Further, $H_{K(\alpha)}(\rho)$ divides $N_{K(\alpha)}(b)$.
   400	 Let $\beta = \beta_1+\beta_2 i$, with $\beta_1,\beta_2 \in \mbox{\Bdd R}$. 
   401	Suppose that $\rho\in K$. Then $\rho\in \mbox{\Bdd R}$ and $\bar{\beta} = \rho \beta = \rho\beta_1+\rho\beta_2 i$, whence we have 
   402	 $\rho\beta_1 = \beta_1 $  and  $\rho\beta_2 = -\beta_2$.  If $\beta_1 \neq 0$, then $\rho = 1$ and so $\bar{\beta} =  \beta$
   403	 which is a contradiction (since $\alpha$ is not real because $K(\alpha)$ is CM). If $\beta_1 = 0$, then $\rho=-1$.
   404	 In this case we have $A=(\bar{\alpha}+ \alpha)/2$.
   405	 Finally, if $b$ is a unit, then  we have that $H(\rho) =1$
   406	and so $\rho$ is a root of unity in $K(\alpha)$. 
   407	 
   408	 \
   409	
   410	Note that there are algorithms for the computation of the elements of a number field of bounded height
   411	\cite{Doyle} and for the computation of roots of unity in a number field \cite[Annexe C]{Molin}. 
   412	As far we know there are not implementations for such algorithms. The other computations
   413	can be carry out by a computational system such as MAGMA or MAPLE.
   414	
   415	 \begin{myre}
   416	 {\rm  
   417	 By \cite[page 54]{Lang},   the leading coefficient $m$ of the minimal polynomial of $\rho$ is equal to  $H_{K(\alpha)}(\rho)$.
   418	 Thus, $m\rho \in O_K$.
   419	 }
   420	 \end{myre}
   421	 
   422	 
   423	Finally, we give two examples of Thue equations that satisfy the hypothesis of Theorem 1 for which we use the previous algorithm to determine all the integral solutions, the first one having a right-hand side a unit but not the second one.
   424	                     
   425	
   426	  
   427	 \begin{myex}  The only solution of the equation  
   428	 $$(X^2+Y^2) (X^2-\sqrt{2}XY+Y^2) = 1$$
   429	 over $\mbox{\Bdd Z}[\sqrt{2}]$ are $(X,Y)= (\pm 1,0),(0,\pm 1)$.
   430	 \end{myex}
   431	 {\it Proof.} The complex number $i$ is a root of $X^2+1$ and  $K=\mbox{\Bdd Q}(\sqrt{2},i)$ is a CM-field. The roots of unity lying in
   432	 $K\setminus \mbox{\Bdd Q}(\sqrt{2})$  are $\pm i$. Next, we compute 
   433	$$\xi_{\pm} = \frac{-i-i(\pm i)}{1-(\pm i)} = \pm 1.$$
   434	Thus we have the equations $y^4 2(2\pm \sqrt{2}) = 1$. If there is $y\in \mbox{\Bdd Z}[\sqrt{2}]$ satisfying
   435	one of these equations, then $2$ is a unit in $\mbox{\Bdd Z}[\sqrt{2}]$, which is a contradiction since its
   436	norm is not equal to $\pm1$. Furthermore, the solutions $(x,y)\in O_K^2$ with $xy =0$ are $(\pm 1,0)$ and $(0,\pm 1)$.
   437	
   438	 
   439	
   440	 
   441	  
   442	 
   443	  \begin{myex}  Consider the form 
   444	 $$F(X,Y)= (X^2+(3-2\sqrt{2})Y^2) (X^2-4XY+\sqrt{2}Y^2)\in \mbox{\Bdd Z}[\sqrt{2}][X,Y].$$
   445	 Then the only solutions of the equation  $F(X,Y)= 3\sqrt{2}-4$    over $\mbox{\Bdd Z}[\sqrt{2}]$ are $(X,Y) = (0,\pm 1)$. 
   446	 \end{myex}
   447	 {\it Proof.}
   448	The given equation belongs to the family of equations of Example 2. Thus, we shall use the above algorithm for the determination of their
   449	solutions.  First, we remark that the equation $F(X,0) = 3\sqrt{2}-4$  has no solution over $\mbox{\Bdd Z}[\sqrt{2}]$ and the only solutions
   450	of  $F(0,Y) = 3\sqrt{2}-4$ over $\mbox{\Bdd Z}[\sqrt{2}]$  are $Y = \pm 1$. 
   451	
   452	Set $y = i\sqrt{3-2\sqrt{2}}$ and $K = \mbox{\Bdd Q}({y})$. We  have $N_K(6-4\sqrt{2}) = 16$. 
   453	 We shall compute all the elements $\rho\in K\setminus \mbox{\Bdd Q}(\sqrt{2})$ with $H_K(\rho)|16$
   454	 and having all the absolute values of theirs conjugates equal to 1. 
   455	
   456	If $H_K(\rho) = 1$, then $\rho$ is a root of unity in $K\setminus \mbox{\Bdd Q}(\sqrt{2})$.
   457	Since there are not other roots of unity in $K$ than $\pm 1$, we consider the case where 
   458	  $H_K(\rho) > 1$.  Let $H_K(\rho) = 2^{\epsilon}$, where $\epsilon = 1,2$. By Remark 1, we have $\rho= \alpha/2^{\epsilon}$, where $\alpha \in O_K$. 
   459	Using MAGMA, we get the following integral base for $K$: 
   460	$$\omega_0 = 1, \ \ \omega_1 = y, \ \  \omega_2 = \frac{1}{2} (y^2 - 1), \ \   \omega_3 = \frac{1}{4}(y^3 + y^2 - y - 1).$$
   461	
   462	
   463	Since all the conjugates of $\rho$ have absolute value 1, we obtain the two equalities 
   464	 $$((a_0-2a_1)+a_1\sqrt{2})^2+(2-\sqrt{2})((a_2-2a_3)+a_3\sqrt{2})^2 = 2^{2\epsilon},$$
   465	 and
   466	 $$((a_0-2a_1)-a_1\sqrt{2})^2+(2+\sqrt{2})((a_2-2a_3)-a_3\sqrt{2})^2 = 2^{2\epsilon}.$$
   467	 It follows that	
   468	 \begin{eqnarray}
   469	(a_0-2a_2)^2+2a_2^2+2(a_1-3a_3)^2+2a_3^2 =  2^{2\epsilon}
   470	\end{eqnarray}
   471	 and
   472	  \begin{eqnarray}
   473	 2 a_0 a_2-4 a_2^2+8 a_1 a_3-14a_3^2-a_1^2 =0.
   474	 \end{eqnarray}
   475	From (3) and (4) we deduce that   $a_0$, $a_1$, $a_2$ and $a_3$ are even. Furthermore, we have: $4|a_1$.           
   476	 
   477	Suppose that $\epsilon = 1$.   If $a_2$ or $a_3$ is not zero, then the left-hand side of (3) is $ > 4$ which is a contradiction. Hence 
   478	$a_2 = a_3 = 0$. Similarly, we deduce that $a_1 = 0$. Then $a_0 =\pm 2$ and so $\rho \in \mbox{\Bdd Q}$ which is not the case.
   479	
   480	Suppose next  that $\epsilon = 2$.  Putting $a_i = a_i^{\prime}$ $(i=0,1,2,3)$ we have 
   481	 \begin{eqnarray}
   482	(a_0^{\prime}- 2a_2^{\prime})^2+2{a^{\prime}_2}^2+2(a_1^{\prime}-3 a_3^{\prime})^2+2 {a^{\prime}_3}^2 =  4.
   483	\end{eqnarray}
