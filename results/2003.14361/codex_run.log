+def _coefficients_from_anchor_values(values, dimension):
+    """Interpolate an ANF quadratic from 0, unit, and pair-unit values."""
+    constant = values[0]
+    linear = [values[1 + index] ^ constant for index in range(dimension)]
+    quadratic = []
+    offset = 1 + dimension
