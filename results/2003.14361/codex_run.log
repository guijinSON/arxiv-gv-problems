+"""Verified generator for affine correspondence colourings (arXiv:2003.14361).
+
+Section 2.1 of the paper defines a q-fold correspondence cover H=(L,H) and
+an H-colouring as an independent transversal of its lists.  This module uses
+the exact q=2 object on regular bipartite base graphs.  It samples two affine
+Boolean colour rules first, then builds every matching around their selected
+local colours.  The certificate is therefore known by inverse generation.
+
+The promise subclass is Track B.  A signed-graph breadth-first propagation
+algorithm solves it in linear time in the displayed cover, while the intended
+no-tool route reads the affine coefficients from a small anchor pattern.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "regular bipartite graph",
+        "2-fold correspondence cover",
+        "affine Boolean H-colouring rule",
+    ],
+    "verification_operations": [
+        "exact arithmetic in F_2",
+        "affine Boolean evaluation",
+        "matching-conflict comparison on every base edge",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The matching shifts are the edge coboundary of two affine Boolean "
+        "colour rules; without recognizing that invariant one propagates "
+        "colours through the entire displayed cover."
+    ),
+    "hardness_basis": (
+        "Track B: signed-graph breadth-first propagation solves a satisfiable "
+        "2-fold correspondence cover in O(|V|+|E|) time; on the provisional "
+        "hard preset the reference scan examines 20,736 table cells (the final "
+        "measured wall-clock and operation count are recorded by selftest), "
+        "whereas the affine anchor invariant needs only 33 exact XORs."
+    ),
+    "max_answer_tokens": 12,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+DIFFICULTY = {
+    "demo": {"n": 8, "dimension": 3, "degree": 7},
+    "easy": {"n": 64, "dimension": 16, "degree": 36},
+    "medium": {"n": 96, "dimension": 16, "degree": 48},
+    "hard": {"n": 144, "dimension": 16, "degree": 64},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+
+STRUCTURAL_HINT = (
+    "The matching-shift labels form the edge coboundary of affine Boolean "
+    "functions on the displayed vertex codes."
+)
+PLACEBO_HINT = (
+    "The matching-shift table rewards careful attention to the displayed "
+    "vertex codes and row indices."
+)
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "One JSON object containing two affine Boolean polynomials, each as "
+        "[constant,a_0,...,a_(k-1)] with every coefficient in {0,1}; the "
+        "polynomials choose one local colour at every left and right vertex."
+    ),
+    "bounds": {
+        "number_of_polynomials": 2,
+        "degree": 1,
+        "variables": "dimension",
+        "coefficient_field": "F_2",
+        "coefficients_per_polynomial": "dimension+1",
+        "candidate_count": "2^(2*(dimension+1))",
+    },
+}
+
+
+# Replaced after the three harness-owned oracle arms have completed.
+G9_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
+}
+
+
+NOTES = r"""
+Paper grounding.  Section 2.1 fixes every relevant definition: a cover
+H=(L,H), the matching condition between two lists, a q-fold cover, and an
+H-colouring as an independent set of size |V(G)| in H.  The same subsection
+notes the large gap between ordinary, list, and correspondence colouring even
+for K_(d,d).  Theorem 12 is the paper's general existence theorem from local
+occupancy, and Section 8.4 is the algorithmic warning that its sufficient
+conditions do not automatically give randomized polynomial-time algorithms
+for correspondence colouring (the situation is better for list colouring).
+
+STEP 0 / track decision.  This module makes no Track-A claim.  In the q=2
+promise subclass, avoiding a matching edge is an XOR equality, so ordinary
+breadth-first propagation solves the cover in O(|V|+|E|).  That algorithm is
+reported as the successful Track-B reference algorithm.  The rendered matrix
+is the input representation, so a reference implementation also scans n^2
+cells.  The compact route uses the coboundary invariant and the zero/unit-code
+anchor edges, requiring 2*dimension+1 XORs; it does not scan or propagate over
+the remaining crowded regular cover.
+
+Certificate production.  Generation samples affine rules
+f_L(x)=c_L+a.x and f_R(y)=c_R+b.y before the graph cover.  On every base edge
+xy it sets the matching shift to f_L(x)+f_R(y)+1 in F_2.  The matching joins
+(x,z) to (y,z+shift), so the sampled colours are never joined.  This is inverse
+generation, not a solver run.  Verification independently evaluates any two
+submitted affine rules and checks all displayed matching edges; it never reads
+inst['answer'].
+
+Attack hardening.  The base graph is degree-regular and every local cover
+colour has exactly the same degree, removing degree and position signatures.
+Degree-preserving switches mix the initial circulant graph while retaining the
+small anchor set.  Dense nonconstant slopes defeat constant, one-coordinate,
+and left-first greedy ansatzes.  Marginal-majority guesses discard the affine
+edge correlations and random restart samples the full bounded coefficient
+language.  The successful signed-BFS algorithm remains outside attacks, as
+Track B requires.
+"""
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_GUESS_SAMPLES = 200_000
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_params(n, dimension, degree, seed):
+    if not _is_int(n) or n < 2:
+        raise ValueError("n must be an integer at least 2")
+    if not _is_int(dimension) or dimension < 2:
+        raise ValueError("dimension must be an integer at least 2")
+    if n <= 2 * dimension:
+        raise ValueError("n must be greater than 2*dimension")
+    if n > (1 << dimension):
+        raise ValueError("n cannot exceed the number of Boolean codes")
+    if not _is_int(degree) or not (2 * dimension + 1 <= degree < n):
+        raise ValueError("degree must satisfy 2*dimension+1 <= degree < n")
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+
+
+def _code_string(value, dimension):
+    """Coefficient-order bits: character h is the x_h coordinate."""
+    return "".join("1" if (value >> h) & 1 else "0" for h in range(dimension))
+
+
+def _dot(coefficients, code):
+    value = coefficients[0]
+    for bit, char in zip(coefficients[1:], code):
+        value ^= bit & (char == "1")
+    return int(value)
+
+
+def _xor_code(left, right):
+    return "".join("1" if a != b else "0" for a, b in zip(left, right))
+
+
+def _sample_codes(n, dimension, rng):
+    required = [0] + [1 << h for h in range(dimension)]
+    chosen = set(required)
+    while len(chosen) < n:
+        chosen.add(rng.randrange(1 << dimension))
+    values = list(chosen)
+    rng.shuffle(values)
+    return [_code_string(value, dimension) for value in values]
+
+
+def _sample_slope(dimension, rng):
+    if dimension <= 4:
+        weight = rng.randint(1, dimension - 1)
+    else:
+        weight = rng.randint(max(2, dimension // 3), min(dimension - 2, 2 * dimension // 3))
+    support = set(rng.sample(range(dimension), weight))
+    return [1 if h in support else 0 for h in range(dimension)]
+
+
+def _anchor_indices(codes, dimension):
+    wanted = ["0" * dimension]
+    for h in range(dimension):
+        wanted.append("".join("1" if j == h else "0" for j in range(dimension)))
+    where = {code: index for index, code in enumerate(codes)}
+    return [where[code] for code in wanted]
+
+
+def _regular_bipartite_graph(left_codes, right_codes, degree, rng):
+    """A switched regular bipartite graph retaining all affine anchors."""
+    n = len(left_codes)
+    dimension = len(left_codes[0])
+    left_anchor = _anchor_indices(left_codes, dimension)
+    right_anchor = _anchor_indices(right_codes, dimension)
+
+    left_tail = [x for x in range(n) if x not in set(left_anchor)]
+    right_tail = [x for x in range(n) if x not in set(right_anchor)]
+    rng.shuffle(left_tail)
+    rng.shuffle(right_tail)
+    left_at = left_anchor + left_tail
+    right_at = right_anchor + right_tail
+    left_coordinate = {vertex: coordinate for coordinate, vertex in enumerate(left_at)}
+
+    forced_shifts = {0}
+    forced_shifts.update(range(1, dimension + 1))
+    forced_shifts.update(range(n - dimension, n))
+    extra = rng.sample(
+        [shift for shift in range(n) if shift not in forced_shifts],
+        degree - len(forced_shifts),
+    )
+    shifts = sorted(forced_shifts | set(extra))
+
+    adjacency = [set() for _ in range(n)]
+    for left in range(n):
+        coordinate = left_coordinate[left]
+        adjacency[left] = {right_at[(coordinate + shift) % n] for shift in shifts}
+
+    protected = {(left_anchor[0], right_anchor[j]) for j in range(dimension + 1)}
+    protected.update((left_anchor[i], right_anchor[0]) for i in range(1, dimension + 1))
+    assert all(right in adjacency[left] for left, right in protected)
+
+    # A two-switch preserves every row and column degree.  Protected anchor
+    # edges may be inserted by a switch but are never removed.
+    # Sample proposed switch endpoints directly.  This is O(1) expected work
+    # per proposal at the preset densities; materialising two set differences
+    # at every step made a thorough selftest needlessly quadratic per switch.
+    steps = 12 * n * min(degree, n - degree)
+    for _ in range(steps):
+        a = rng.randrange(n)
+        b = rng.randrange(n - 1)
+        if b >= a:
+            b += 1
+        y = rng.randrange(n)
+        z = rng.randrange(n)
+        if (
+            y == z
+            or y not in adjacency[a]
+            or z not in adjacency[b]
+            or y in adjacency[b]
+            or z in adjacency[a]
+        ):
+            continue
+        if (a, y) in protected or (b, z) in protected:
+            continue
+        adjacency[a].remove(y)
+        adjacency[b].remove(z)
+        adjacency[a].add(z)
+        adjacency[b].add(y)
+
+    assert all(len(row) == degree for row in adjacency)
+    column_degrees = [0] * n
+    for row in adjacency:
+        for right in row:
+            column_degrees[right] += 1
+    assert all(value == degree for value in column_degrees)
+    assert all(right in adjacency[left] for left, right in protected)
+    return adjacency
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a satisfiable affine 2-fold correspondence cover."""
+    dimension = params.pop("dimension", 16)
+    degree = params.pop("degree", max(2 * dimension + 1, n // 2))
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_params(n, dimension, degree, seed)
+    rng = random.Random(seed)
+
+    # Sample the certificate before any instance constraint exists.
+    left_rule = [rng.randrange(2)] + _sample_slope(dimension, rng)
+    right_rule = [rng.randrange(2)] + _sample_slope(dimension, rng)
+    left_codes = _sample_codes(n, dimension, rng)
+    right_codes = _sample_codes(n, dimension, rng)
+    adjacency = _regular_bipartite_graph(left_codes, right_codes, degree, rng)
+
+    left_colours = [_dot(left_rule, code) for code in left_codes]
+    right_colours = [_dot(right_rule, code) for code in right_codes]
+    rows = []
+    for left in range(n):
+        chars = ["."] * n
+        for right in adjacency[left]:
+            chars[right] = str(left_colours[left] ^ right_colours[right] ^ 1)
+        rows.append("".join(chars))
+
+    answer = {"left": left_rule, "right": right_rule}
+    return {
+        "family": "affine_2fold_correspondence_colouring",
+        "n": n,
+        "dimension": dimension,
+        "degree": degree,
+        "left_codes": left_codes,
+        "right_codes": right_codes,
+        "matching_shifts": rows,
+        "answer": answer,
+    }
+
+
+def _decode_answer(inst, answer):
+    dimension = inst["dimension"]
+    if not isinstance(answer, dict):
+        return None, "answer must be a JSON object"
+    if set(answer) != {"left", "right"}:
+        return None, "answer must contain exactly the keys left and right"
+    decoded = {}
+    for side in ("left", "right"):
+        value = answer[side]
+        if not isinstance(value, list):
+            return None, f"{side} affine rule must be a JSON list"
+        expected = dimension + 1
+        if len(value) < expected:
+            return None, f"{side} affine rule is too short: expected {expected} coefficients"
+        if len(value) > expected:
+            return None, f"{side} affine rule is too long: expected {expected} coefficients"
+        for index, bit in enumerate(value):
+            if not _is_int(bit) or bit not in (0, 1):
+                return None, f"{side} coefficient {index} is not a bit in {{0,1}}"
+        decoded[side] = value
+    return decoded, None
+
+
+def verify(inst, answer):
+    """Check any submitted affine H-colouring; never consult inst['answer']."""
+    decoded, error = _decode_answer(inst, answer)
+    if error:
+        return False, error
+    n = inst["n"]
+    left_colours = [_dot(decoded["left"], code) for code in inst["left_codes"]]
+    right_colours = [_dot(decoded["right"], code) for code in inst["right_codes"]]
+    for left, row in enumerate(inst["matching_shifts"]):
+        for right, char in enumerate(row):
+            if char == ".":
+                continue
+            shift = ord(char) - ord("0")
+            if right_colours[right] == (left_colours[left] ^ shift):
+                return False, f"cover conflict on base edge L{left}-R{right}"
+    return True, "ok"
+
+
+def render(inst):
+    """Render a complete, self-contained correspondence-colouring problem."""
+    n = inst["n"]
+    dimension = inst["dimension"]
+    lines = [
+        "Affine 2-fold correspondence colouring over F_2.",
+        "",
+        f"The base graph is bipartite with left vertices L0,...,L{n-1} and",
+        f"right vertices R0,...,R{n-1}.  Each vertex has degree {inst['degree']}.",
+        "Every vertex v has a two-element local list {(v,0),(v,1)}.",
+        "The two elements inside one local list conflict with each other.",
+        "",
+        "For every base edge Li-Rj, the table entry s in {0,1} specifies the",
+        "perfect matching of conflicts between their lists: (Li,z) conflicts",
+        "with (Rj,z XOR s) for both z=0 and z=1.  A dot means Li-Rj is not",
+        "a base edge and creates no cross-list conflict.  XOR is addition mod 2.",
+        "",
+        "An H-colouring chooses exactly one local-list element at every base",
+        "vertex and contains no conflicting pair.  You must give such a colouring",
+        "in the promised affine form below; at least one is guaranteed.",
+        "",
+        f"Each vertex carries a public code x=(x0,...,x{dimension-1}) in F_2^{dimension}.",
+        "A coefficient list [c,a0,...,a_(k-1)] chooses local colour",
+        "  c XOR (a0 AND x0) XOR ... XOR (a_(k-1) AND x_(k-1)).",
+        "Give one coefficient list for all left codes and one for all right codes.",
+        "All coefficients must be literal integers 0 or 1.  Constants and slopes",
+        "may repeat.  Vertex order is fixed by the indices below.",
+        "",
+        "Left codes (the first displayed bit is x0):",
+    ]
+    lines.extend(f"L{i}: {code}" for i, code in enumerate(inst["left_codes"]))
+    lines.append("")
+    lines.append("Right codes (the first displayed bit is x0):")
+    lines.extend(f"R{i}: {code}" for i, code in enumerate(inst["right_codes"]))
+    lines.extend([
+        "",
+        "Matching-shift table: row i is Li; character j is the entry for Rj.",
+        "Columns are 0-indexed from left to right, with exactly n characters per row.",
+    ])
+    lines.extend(f"L{i}: {row}" for i, row in enumerate(inst["matching_shifts"]))
+    zero = [0] * (dimension + 1)
+    example = json.dumps({"left": zero, "right": zero}, separators=(",", ":"))
+    lines.extend([
+        "",
+        "Output one JSON object with exactly the keys left and right.  Each value",
+        f"must be a list of exactly {dimension + 1} bits in [constant,x0,...,x{dimension-1}] order.",
+        "Give your final answer inside <answer></answer> tags, as that exact JSON object.",
+        f"Example of the required syntax and shape: <answer>{example}</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    """Extract the last tagged JSON object; return None on all malformed input."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def random_candidate(inst, rng):
+    """Uniform affine-rule candidate satisfying every stated shape constraint."""
+    if not hasattr(rng, "randrange"):
+        raise TypeError("rng must provide randrange")
+    length = inst["dimension"] + 1
+    return {
+        "left": [rng.randrange(2) for _ in range(length)],
+        "right": [rng.randrange(2) for _ in range(length)],
+    }
+
+
+def search_space(inst):
+    return 1 << (2 * (inst["dimension"] + 1))
+
+
+def enumerate_all(inst):
+    """Brute-force the bounded language only when it has at most 65,536 words."""
+    space = search_space(inst)
+    if space > 65_536:
+        return None
+    length = inst["dimension"] + 1
+    count = 0
+    for word in range(space):
+        left = [(word >> h) & 1 for h in range(length)]
+        right = [(word >> (length + h)) & 1 for h in range(length)]
+        count += verify(inst, {"left": left, "right": right})[0]
+    return count
+
+
+def _anchor_signature(inst):
+    """The two slopes and relative constant fixed by the anchor constraints."""
+    dimension = inst["dimension"]
+    left_anchor = _anchor_indices(inst["left_codes"], dimension)
+    right_anchor = _anchor_indices(inst["right_codes"], dimension)
+    rows = inst["matching_shifts"]
+    s00 = int(rows[left_anchor[0]][right_anchor[0]])
+    left_slope = [
+        int(rows[left_anchor[h + 1]][right_anchor[0]]) ^ s00
+        for h in range(dimension)
+    ]
+    right_slope = [
+        int(rows[left_anchor[0]][right_anchor[h + 1]]) ^ s00
+        for h in range(dimension)
+    ]
+    return s00, left_slope, right_slope
+
+
+def _anchor_filter(inst, answer, signature=None):
+    """Cheap exact rejection on the guaranteed anchor edges, then full verify."""
+    decoded, error = _decode_answer(inst, answer)
+    if error:
+        return False
+    s00, left_slope, right_slope = signature or _anchor_signature(inst)
+    if decoded["left"][1:] != left_slope or decoded["right"][1:] != right_slope:
+        return False
+    if decoded["right"][0] != (decoded["left"][0] ^ s00 ^ 1):
+        return False
+    return verify(inst, answer)[0]
+
+
+def _side_invariant(codes):
+    dimension = len(codes[0])
+    histogram = [0] * (dimension + 1)
+    for i in range(len(codes)):
+        for j in range(i + 1, len(codes)):
+            histogram[sum(a != b for a, b in zip(codes[i], codes[j]))] += 1
+    return histogram
+
+
+def canonical_key(inst):
+    """A strong cheap invariant under all relabellings audited in selftest.
+
+    It intentionally ignores matching shifts: affine per-list colour-frame
+    changes alter those bits while preserving the correspondence-colouring
+    problem.  Pair-distance and edge-distance spectra retain the public code
+    geometry and the regular base graph without depending on vertex order.
+    """
+    dimension = inst["dimension"]
+    sides = sorted([
+        _side_invariant(inst["left_codes"]),
+        _side_invariant(inst["right_codes"]),
+    ])
+    edge_histogram = [0] * (dimension + 1)
+    for left, row in enumerate(inst["matching_shifts"]):
+        for right, char in enumerate(row):
+            if char != ".":
+                distance = sum(
+                    a != b
