+"""Verified generator for affine correspondence colourings (arXiv:2003.14361).
+
+Section 2.1 of the paper defines a q-fold correspondence cover H=(L,H) and
+an H-colouring as an independent transversal of its lists.  This module uses
+the exact q=2 object on regular bipartite base graphs.  It samples two affine
+Boolean colour rules first, then builds every matching around their selected
+local colours.  The certificate is therefore known by inverse generation.
+
+The promise subclass is Track B.  A signed-graph breadth-first propagation
+algorithm solves it in linear time in the displayed cover, while the intended
+no-tool route reads the affine coefficients from a small anchor pattern.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "regular bipartite graph",
+        "2-fold correspondence cover",
+        "affine Boolean H-colouring rule",
+    ],
+    "verification_operations": [
+        "exact arithmetic in F_2",
+        "affine Boolean evaluation",
+        "matching-conflict comparison on every base edge",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The matching shifts are the edge coboundary of two affine Boolean "
+        "colour rules; without recognizing that invariant one propagates "
+        "colours through the entire displayed cover."
+    ),
+    "hardness_basis": (
+        "Track B: signed-graph breadth-first propagation solves a satisfiable "
+        "2-fold correspondence cover in O(|V|+|E|) time; on the provisional "
+        "hard preset the reference scan examines 20,736 table cells (the final "
+        "measured wall-clock and operation count are recorded by selftest), "
+        "whereas the affine anchor invariant needs only 33 exact XORs."
+    ),
+    "max_answer_tokens": 12,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+DIFFICULTY = {
+    "demo": {"n": 8, "dimension": 3, "degree": 7},
+    "easy": {"n": 64, "dimension": 16, "degree": 36},
+    "medium": {"n": 96, "dimension": 16, "degree": 48},
+    "hard": {"n": 144, "dimension": 16, "degree": 64},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+
+STRUCTURAL_HINT = (
+    "The matching-shift labels form the edge coboundary of affine Boolean "
+    "functions on the displayed vertex codes."
+)
+PLACEBO_HINT = (
+    "The matching-shift table rewards careful attention to the displayed "
+    "vertex codes and row indices."
+)
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "One JSON object containing two affine Boolean polynomials, each as "
+        "[constant,a_0,...,a_(k-1)] with every coefficient in {0,1}; the "
