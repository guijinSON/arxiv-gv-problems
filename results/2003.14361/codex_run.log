def _is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def _validate_params(n, dimension, degree, seed):
    if not _is_int(n) or n < 2:
        raise ValueError("n must be an integer at least 2")
    if not _is_int(dimension) or dimension < 2:
        raise ValueError("dimension must be an integer at least 2")
    if n <= 2 * dimension:
        raise ValueError("n must be greater than 2*dimension")
    if n > (1 << dimension):
        raise ValueError("n cannot exceed the number of Boolean codes")
    if not _is_int(degree) or not (2 * dimension + 1 <= degree < n):
        raise ValueError("degree must satisfy 2*dimension+1 <= degree < n")
    if not _is_int(seed):
        raise ValueError("seed must be an integer")


def _code_string(value, dimension):
    """Coefficient-order bits: character h is the x_h coordinate."""
    return "".join("1" if (value >> h) & 1 else "0" for h in range(dimension))


def _dot(coefficients, code):
    value = coefficients[0]
    for bit, char in zip(coefficients[1:], code):
        value ^= bit & (char == "1")
    return int(value)


def _xor_code(left, right):
    return "".join("1" if a != b else "0" for a, b in zip(left, right))


def _sample_codes(n, dimension, rng):
    required = [0] + [1 << h for h in range(dimension)]
    chosen = set(required)
    while len(chosen) < n:
        chosen.add(rng.randrange(1 << dimension))
    values = list(chosen)
    rng.shuffle(values)
    return [_code_string(value, dimension) for value in values]


def _sample_slope(dimension, rng):
    if dimension <= 4:
        weight = rng.randint(1, dimension - 1)
    else:
        weight = rng.randint(max(2, dimension // 3), min(dimension - 2, 2 * dimension // 3))
    support = set(rng.sample(range(dimension), weight))
    return [1 if h in support else 0 for h in range(dimension)]


def _anchor_indices(codes, dimension):
    wanted = ["0" * dimension]
    for h in range(dimension):
        wanted.append("".join("1" if j == h else "0" for j in range(dimension)))
    where = {code: index for index, code in enumerate(codes)}
    return [where[code] for code in wanted]


def _regular_bipartite_graph(left_codes, right_codes, degree, rng):
    """A switched regular bipartite graph retaining all affine anchors."""
    n = len(left_codes)
    dimension = len(left_codes[0])
    left_anchor = _anchor_indices(left_codes, dimension)
    right_anchor = _anchor_indices(right_codes, dimension)

    left_tail = [x for x in range(n) if x not in set(left_anchor)]
    right_tail = [x for x in range(n) if x not in set(right_anchor)]
    rng.shuffle(left_tail)
    rng.shuffle(right_tail)
    left_at = left_anchor + left_tail
    right_at = right_anchor + right_tail
    left_coordinate = {vertex: coordinate for coordinate, vertex in enumerate(left_at)}

    forced_shifts = {0}
    forced_shifts.update(range(1, dimension + 1))
    forced_shifts.update(range(n - dimension, n))
    extra = rng.sample(
        [shift for shift in range(n) if shift not in forced_shifts],
        degree - len(forced_shifts),
    )
    shifts = sorted(forced_shifts | set(extra))

    adjacency = [set() for _ in range(n)]
    for left in range(n):
        coordinate = left_coordinate[left]
        adjacency[left] = {right_at[(coordinate + shift) % n] for shift in shifts}

    protected = {(left_anchor[0], right_anchor[j]) for j in range(dimension + 1)}
    protected.update((left_anchor[i], right_anchor[0]) for i in range(1, dimension + 1))
