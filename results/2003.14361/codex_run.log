+  "G1_planted_verifies": {
+    "checks": 12,
+    "failures": [],
+    "json_native_roundtrips": 12,
+    "pass": true
+  },
+  "G2_rejects_corruption": {
+    "cases": {
+      "drop_one": {"reason": "left affine rule is too short: expected 17 coefficients", "rejected": true},
+      "duplicate_one": {"reason": "left affine rule is too long: expected 17 coefficients", "rejected": true},
