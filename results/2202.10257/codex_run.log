+)
+
+# Filled from the harness-owned files after the three required oracle runs.
+_G9_EVIDENCE = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
