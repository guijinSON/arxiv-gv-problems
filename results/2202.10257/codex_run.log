+        "mix_steps": 288,
+    },
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT: str = (
+    "The relative operator has a two-point spectrum and generates a "
+    "two-dimensional commutative algebra."
+)
+PLACEBO_HINT: str = (
+    "The cross-block entries use exact integers and follow the displayed "
