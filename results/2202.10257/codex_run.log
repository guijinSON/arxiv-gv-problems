+NOTES: str = r"""
+Paper triage. Section 2.1 defines R-equivalence by Q2 = Q1 composed
+with g for g in GL(d,R), and identifies a quadratic form with its symmetric
+bilinear matrix. Section 5, Theorem 5.1 is the applicable result: in d>=3,
+non-degenerate real-isotropic integral forms are Z_S-equivalent exactly when
+a bounded S-integral equivalence matrix exists. Its proof produces existence
+inside a finite search region, not a short formula for a public pair. The
+opening paragraph of Section 5 says the everywhere-local-anisotropic case is
+easy because every local transporter set is compact; the generator therefore
+uses split real-isotropic forms. Dimension two is also avoided because the
+Introduction points to Gauss's efficient binary-form algorithm.
+
+Construction. Write J=[[0,I],[I,0]], the matrix of a split integral form in
+2n variables. Before any public form exists, sample a unimodular integer R and
+a rank-n/2 diagonal projector E. Put P=R^{-1}ER and C=I+(u^2-1)P^T, where u is
+a sampled power of 2. The public second form has matrix [[0,C],[C^T,0]]. Its
+relative operator is diag(C^T,C). Since P^2=P, the polynomial
+p(t)=u/(u+1)+t/(u+1) evaluates to
+diag((I+(u-1)P),(I+(u-1)P^T)), an integer matrix whose determinant is a power
+of 2 and which carries J to the second form. This is inverse generation by a
+composed projector identity; make_instance never solves an equivalence.
+
+Track B discriminator. The paper's general route is bounded matrix search.
+For this distribution an exact reference solver instead materializes the
+relative operator, extracts its two eigenvalues, interpolates the linear
+square root, and verifies a dense congruence in O(d^3) exact arithmetic. The
+reference succeeds by design and is reported separately. A solver that sees
+the invariant only sums the n diagonal cross-block entries, obtains the other
+eigenvalue, takes its integer square root, and writes two rational
+coefficients. The measured dense cost and the n+8 compact-operation count are
+recorded at the shipping preset.
+
+Attacks. Random unimodular conjugation destroys coordinate outliers while
+preserving the projector spectrum. The panel tests a largest-entry scalar,
+the relative operator itself, a diagonal-average scalar, the tempting
+unipotent midpoint polynomial, and 256 bounded random polynomials. All miss
+the simultaneous square-root conditions on the two eigenspaces. The exact
+reference algorithm is intentionally successful, as required for Track B.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 200_000
+
+
+def _plain_int(value) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _identity(size: int) -> list[list[int]]:
+    return [[1 if i == j else 0 for j in range(size)] for i in range(size)]
+
+
+def _transpose(matrix):
+    return [list(row) for row in zip(*matrix)]
+
+
+def _right_shear(matrix, inverse, source: int, target: int, amount: int) -> None:
+    """Replace R by R(I+amount*e_source*e_target^T), carrying R^-1."""
+    size = len(matrix)
+    for row in range(size):
+        matrix[row][target] += amount * matrix[row][source]
+    # (I-amount*e_source*e_target^T) R^-1: row source -= amount row target.
+    inverse[source] = [
+        inverse[source][col] - amount * inverse[target][col]
+        for col in range(size)
+    ]
+
+
+def _make_unimodular(size: int, steps: int, rng: random.Random):
+    matrix = _identity(size)
+    inverse = _identity(size)
+
+    # A cyclic warm-up prevents the random walk from leaving untouched columns.
+    for i in range(size):
+        _right_shear(matrix, inverse, i, (i + 1) % size,
+                     -1 if rng.getrandbits(1) else 1)
+    for _ in range(max(0, steps - size)):
+        source = rng.randrange(size)
+        target = rng.randrange(size - 1)
+        if target >= source:
+            target += 1
+        amount = -1 if rng.getrandbits(1) else 1
+        _right_shear(matrix, inverse, source, target, amount)
+    return matrix, inverse
+
+
+def _projector(matrix, inverse, selected):
+    """R^-1 E R, where E is diagonal with support ``selected``."""
+    size = len(matrix)
+    chosen = tuple(selected)
+    return [
+        [sum(inverse[i][k] * matrix[k][j] for k in chosen)
+         for j in range(size)]
+        for i in range(size)
+    ]
+
+
+def _validate_params(n, exponent_min, exponent_max, mix_steps):
+    if not _plain_int(n) or n < 2 or n % 2:
+        raise ValueError("n must be an even integer at least 2")
+    if (not _plain_int(exponent_min) or not _plain_int(exponent_max)
+            or exponent_min < 2 or exponent_max < exponent_min
+            or exponent_max > 30):
+        raise ValueError("exponents must satisfy 2 <= min <= max <= 30")
+    if not _plain_int(mix_steps) or mix_steps < n:
+        raise ValueError("mix_steps must be an integer at least n")
+
+
+def make_instance(n, seed=0, exponent_min=10, exponent_max=16,
+                  mix_steps=None, **params) -> dict:
+    """Inverse-generate a split S-integral quadratic-form equivalence."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if mix_steps is None:
+        mix_steps = 6 * n
+    _validate_params(n, exponent_min, exponent_max, mix_steps)
+    rng = random.Random(seed)
+
+    exponent = rng.randint(exponent_min, exponent_max)
+    unit = 1 << exponent
+    eigenvalue = unit * unit
+    matrix, inverse = _make_unimodular(n, mix_steps, rng)
+    selected = list(range(n))
+    rng.shuffle(selected)
+    selected = selected[:n // 2]
+    projector = _projector(matrix, inverse, selected)
+
+    scale = eigenvalue - 1
+    # C = I + (u^2-1) P^T.  The complete public Gram matrix is
+    # [[0,C],[C^T,0]], so displaying C loses no information.
+    cross_block = [
+        [((1 if i == j else 0) + scale * projector[j][i])
+         for j in range(n)]
+        for i in range(n)
+    ]
+    denominator = unit + 1
+    answer = {
+        "coefficients": [[unit, denominator], [1, denominator]],
+    }
+    return {
+        "family": "two-spectrum S-integral quadratic-form equivalence",
+        "n": n,
+        "dimension": 2 * n,
+        "S_finite_primes": [2],
+        "height_bound": (1 << exponent_max) + 1,
+        "exponent_range": [exponent_min, exponent_max],
+        "mix_steps": mix_steps,
+        "cross_block": cross_block,
+        "answer": answer,
+    }
+
+
+def _format_matrix(matrix) -> str:
+    return "\n".join(" ".join(str(value) for value in row) for row in matrix)
+
+
+def render(inst) -> str:
+    n = inst["n"]
+    dimension = inst["dimension"]
+    height = inst["height_bound"]
+    statement = f"""S-integral equivalence of two quadratic forms
+
+Let Z[1/2] be the rational numbers whose reduced denominator is a power of 2.
+A square matrix G is in GL(d,Z[1/2]) when every entry of G and G^(-1) is in
+Z[1/2]. For a symmetric integer matrix A, write Q_A(x)=x^T A x. An
+S-integral equivalence from Q_A to Q_B is a matrix G in GL(d,Z[1/2]) satisfying
+G^T A G = B exactly.
+
+Here d={dimension} and n={n}. Let I be the n by n identity matrix and set
+
+    A = [[0,I],[I,0]].
+
+The other symmetric matrix is
+
+    B = [[0,C],[C^T,0]],
+
+where the complete n by n integer matrix C is:
+
+{_format_matrix(inst['cross_block'])}
+
+The relative operator A^(-1)B has an S-integral square root that is a rational
+polynomial of degree at most one in A^(-1)B. Find coefficients c0,c1 such that
+
+    G = c0*I_d + c1*(A^(-1)B)
+
+belongs to GL(d,Z[1/2]) and satisfies G^T A G=B.
+
+Certificate bounds and conventions: encode c0=a0/q and c1=a1/q with one
+common positive integer denominator q. The literal integers must obey
+1 <= q <= H and -H <= a0,a1 <= H, where H={height}. Fractions need not be in
+lowest terms. Order is constant coefficient first, then linear coefficient.
+
+Give your final answer inside <answer></answer> tags as exactly one JSON object
+of the form {{"coefficients":[[a0,q],[a1,q]]}}.
+Example: <answer>{{"coefficients":[[2,3],[1,3]]}}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Extract the tagged JSON certificate; malformed text returns None."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    body = match.group(1).strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _power_of_two(value: int) -> bool:
+    return value > 0 and value & (value - 1) == 0
+
+
+def _s_integer(value: Fraction) -> bool:
+    return _power_of_two(value.denominator)
+
+
+def _s_unit(value: Fraction) -> bool:
+    return (value != 0 and _power_of_two(abs(value.numerator))
+            and _power_of_two(value.denominator))
+
+
+def _det_fraction(matrix) -> Fraction:
+    if exact_matrices is not None:
+        return exact_matrices.det(matrix)
+    size = len(matrix)
+    work = [[Fraction(value) for value in row] for row in matrix]
+    determinant = Fraction(1)
+    sign = 1
+    for col in range(size):
+        pivot = next((row for row in range(col, size)
+                      if work[row][col] != 0), None)
+        if pivot is None:
+            return Fraction(0)
+        if pivot != col:
+            work[col], work[pivot] = work[pivot], work[col]
+            sign = -sign
+        value = work[col][col]
+        determinant *= value
+        for row in range(col + 1, size):
+            if work[row][col] == 0:
+                continue
+            factor = work[row][col] / value
+            for j in range(col + 1, size):
+                work[row][j] -= factor * work[col][j]
+    return sign * determinant
+
+
+def _matmul(left, right):
+    right_t = _transpose(right)
+    return [
+        [sum((a * b for a, b in zip(row, col)), Fraction(0))
+         for col in right_t]
+        for row in left
+    ]
+
+
+def _other_eigenvalue(inst) -> Fraction:
+    trace = sum(inst["cross_block"][i][i] for i in range(inst["n"]))
+    return Fraction(2 * trace, inst["n"]) - 1
+
+
+def _decode_certificate(inst, answer):
+    if not isinstance(answer, dict):
+        return None, "certificate_not_object"
+    if "coefficients" not in answer:
+        return None, "missing_coefficients"
+    coefficients = answer["coefficients"]
+    if not isinstance(coefficients, list) or len(coefficients) != 2:
+        return None, "coefficient_count"
+    pairs = []
+    for pair in coefficients:
+        if (not isinstance(pair, list) or len(pair) != 2
+                or not all(_plain_int(value) for value in pair)):
+            return None, "rational_encoding"
+        pairs.append(pair)
+    q0, q1 = pairs[0][1], pairs[1][1]
+    if q0 <= 0 or q1 <= 0 or q0 != q1:
+        return None, "common_denominator"
+    height = inst["height_bound"]
+    if q0 > height or abs(pairs[0][0]) > height or abs(pairs[1][0]) > height:
+        return None, "coefficient_bounds"
+    return (Fraction(pairs[0][0], q0), Fraction(pairs[1][0], q0)), "ok"
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check any bounded linear-polynomial S-integral equivalence exactly."""
+    decoded, reason = _decode_certificate(inst, answer)
+    if decoded is None:
+        return False, reason
+    constant, linear = decoded
+    at_one = constant + linear
+    if at_one * at_one != 1:
+        return False, "unit_eigenspace_constraint"
+    other = _other_eigenvalue(inst)
+    if other <= 1 or other.denominator != 1:
+        return False, "invalid_instance_spectrum"
+    at_other = constant + linear * other
+    if at_other * at_other != other:
+        return False, "other_eigenspace_constraint"
+
+    # If M=diag(C^T,C), then p(M)=diag(p(C)^T,p(C)).  The congruence
+    # p(M)^T J p(M)=J M is exactly p(C)^2=C.  Check that identity rather
+    # than trusting the promised spectrum.
+    size = inst["n"]
+    block = [
+        [linear * inst["cross_block"][i][j]
+         + (constant if i == j else 0)
+         for j in range(size)]
+        for i in range(size)
+    ]
+    if any(not _s_integer(value) for row in block for value in row):
+        return False, "matrix_not_S_integral"
+    if _matmul(block, block) != inst["cross_block"]:
+        return False, "matrix_congruence"
+    determinant = _det_fraction(block)
+    if not _s_unit(determinant):
+        return False, "determinant_not_S_unit"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Sample uniformly from the literal bounded polynomial language."""
+    height = inst["height_bound"]
+    denominator = rng.randint(1, height)
+    return {
+        "coefficients": [
+            [rng.randint(-height, height), denominator],
+            [rng.randint(-height, height), denominator],
+        ]
+    }
+
+
+def search_space(inst) -> int | None:
+    height = inst["height_bound"]
+    return height * (2 * height + 1) ** 2
+
+
+def enumerate_all(inst) -> int | None:
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    height = inst["height_bound"]
+    count = 0
+    for denominator in range(1, height + 1):
+        for first in range(-height, height + 1):
+            for second in range(-height, height + 1):
+                candidate = {
+                    "coefficients": [
+                        [first, denominator], [second, denominator]
+                    ]
+                }
+                count += int(verify(inst, candidate)[0])
+    return count
+
+
+def canonical_key(inst) -> str:
+    """A cheap invariant under signed coordinate relabelling and transpose."""
+    absolute_multiset = sorted(
+        abs(value) for row in inst["cross_block"] for value in row
+    )
+    payload = json.dumps(
+        [inst["n"], sum(inst["cross_block"][i][i]
+                        for i in range(inst["n"])), absolute_multiset],
+        separators=(",", ":"),
+    ).encode()
+    return hashlib.sha256(payload).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Grow matrix work, coefficient entropy, and conjugation crowding."""
+    current = dict(params)
+    n = int(current.get("n", 20))
+    exponent_min = int(current.get("exponent_min", 10))
+    exponent_max = int(current.get("exponent_max", 16))
+    mix_steps = int(current.get("mix_steps", 6 * n))
+    return {
+        "n": n + 12,
+        "exponent_min": min(27, exponent_min + 2),
+        "exponent_max": min(30, exponent_max + 2),
+        "mix_steps": mix_steps + 72,
+    }
+
+
+def _candidate(constant_num, linear_num, denominator=1):
+    return {"coefficients": [
+        [int(constant_num), int(denominator)],
+        [int(linear_num), int(denominator)],
+    ]}
+
+
+def _attack_largest_entry_scalar(inst):
+    largest = max(abs(value) for row in inst["cross_block"] for value in row)
+    scalar = max(2, min(inst["height_bound"], math.isqrt(largest)))
+    return _candidate(scalar, 0)
+
+
+def _attack_diagonal_average_scalar(inst):
+    trace = abs(sum(inst["cross_block"][i][i] for i in range(inst["n"])))
+    scalar = max(2, min(inst["height_bound"], math.isqrt(trace // inst["n"])))
+    return _candidate(scalar, 0)
+
+
+def _signed_relabel(inst, permutation, signs, take_transpose=False):
+    size = inst["n"]
+    if sorted(permutation) != list(range(size)):
+        raise ValueError("permutation is invalid")
+    if len(signs) != size or any(sign not in (-1, 1) for sign in signs):
+        raise ValueError("sign vector is invalid")
+    source = _transpose(inst["cross_block"]) if take_transpose else inst["cross_block"]
+    cross = [
+        [signs[i] * signs[j] * source[permutation[i]][permutation[j]]
+         for j in range(size)]
+        for i in range(size)
+    ]
+    out = dict(inst)
+    out["cross_block"] = cross
+    out["answer"] = json.loads(json.dumps(inst["answer"]))
+    return out
+
+
+def _full_matrices(inst):
+    size = inst["n"]
+    dimension = 2 * size
+    zero = Fraction(0)
+    one = Fraction(1)
+    J = [[zero for _ in range(dimension)] for _ in range(dimension)]
+    Q2 = [[zero for _ in range(dimension)] for _ in range(dimension)]
+    C = inst["cross_block"]
+    for i in range(size):
+        J[i][size + i] = one
+        J[size + i][i] = one
+        for j in range(size):
+            Q2[i][size + j] = Fraction(C[i][j])
+            Q2[size + j][i] = Fraction(C[i][j])
+    return J, Q2
+
+
+def _matmul_count(left, right, counter):
+    rows = len(left)
+    inner = len(right)
+    columns = len(right[0])
+    right_t = _transpose(right)
+    out = []
+    for row in left:
+        new_row = []
+        for col in right_t:
+            total = Fraction(0)
+            for a, b in zip(row, col):
+                total += a * b
+                counter[0] += 2
+            new_row.append(total)
+        out.append(new_row)
+    assert len(out) == rows and len(out[0]) == columns and inner == len(left[0])
+    return out
+
+
+def _reference_algorithm(inst):
+    """Dense exact relative-operator/interpolation route, with op count."""
+    operations = [0]
+    J, Q2 = _full_matrices(inst)
+    relative = _matmul_count(J, Q2, operations)
+    dimension = inst["dimension"]
+    trace = sum((relative[i][i] for i in range(dimension)), Fraction(0))
+    operations[0] += dimension
+    other = trace / inst["n"] - 1
+    operations[0] += 2
+    if other.denominator != 1:
+        return None, operations[0]
+    unit = math.isqrt(other.numerator)
+    operations[0] += 1
+    if unit * unit != other:
+        return None, operations[0]
+    denominator = unit + 1
+    answer = _candidate(unit, 1, denominator)
+    constant = Fraction(unit, denominator)
+    linear = Fraction(1, denominator)
+    identity = [[Fraction(int(i == j)) for j in range(dimension)]
+                for i in range(dimension)]
+    equivalence = [
+        [constant * identity[i][j] + linear * relative[i][j]
+         for j in range(dimension)]
+        for i in range(dimension)
+    ]
+    operations[0] += 3 * dimension * dimension
+    j_times_g = _matmul_count(J, equivalence, operations)
+    lhs = _matmul_count(_transpose(equivalence), j_times_g, operations)
+    if lhs != Q2 or not verify(inst, answer)[0]:
+        return None, operations[0]
+    return answer, operations[0]
+
+
+def _answer_atom_count(answer) -> int:
+    if not isinstance(answer, dict):
+        return 0
+    coefficients = answer.get("coefficients", [])
+    return sum(len(pair) for pair in coefficients if isinstance(pair, list))
+
+
+def selftest() -> dict:
+    report = {}
+
+    planted_ok = 0
+    planted_total = 0
+    for params in DIFFICULTY.values():
+        for seed in (0, 1, 2):
+            inst = make_instance(seed=seed, **params)
+            ok, _ = verify(inst, inst["answer"])
+            planted_ok += int(ok)
+            planted_total += 1
+    report["G1_planted_verifies"] = {
+        "pass": planted_ok == planted_total,
+        "verified": planted_ok,
+        "attempts": planted_total,
+    }
+
+    shipping = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    base = shipping["answer"]["coefficients"]
+    corruptions = {
+        "drop": {"coefficients": base[:-1]},
+        "swap": {"coefficients": [base[1], base[0]]},
+        "duplicate": {"coefficients": [base[0], base[0]]},
+        "empty": {},
+        "out_of_range": {
+            "coefficients": [[shipping["height_bound"] + 1, 1], base[1]]
+        },
+    }
+    corruption_results = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(shipping, candidate)
+        corruption_results[name] = {"rejected": not ok, "reason": why}
+    reasons = {value["reason"] for value in corruption_results.values()}
+    report["G2_rejects_corruption"] = {
+        "pass": (all(value["rejected"] for value in corruption_results.values())
+                 and len(reasons) == len(corruption_results)),
+        "cases": corruption_results,
+        "distinct_reasons": len(reasons),
+    }
+
+    wire = json.dumps(shipping["answer"], separators=(",", ":"))
+    realistic = (
+        "The relative spectrum has two values.\n"
+        f"<answer>```json\n{wire}\n```</answer>\n"
+        "The polynomial is exact."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": (parsed == shipping["answer"]
+                 and json.loads(json.dumps(shipping["answer"]))
+                 == shipping["answer"]),
+        "parsed_equals_answer": parsed == shipping["answer"],
+        "json_native": (json.loads(json.dumps(shipping["answer"]))
+                        == shipping["answer"]),
+    }
+
+    guess_rng = random.Random(8675309)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        guess_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
+    guess_rate = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_rate < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_rate,
+        "candidate_space": search_space(shipping),
+        "prior": "uniform literal common-denominator linear polynomials within H",
+    }
+
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    started = time.perf_counter()
+    reference_answer, reference_ops = _reference_algorithm(shipping)
+    reference_seconds = time.perf_counter() - started
+    reference_ok = (reference_answer is not None
+                    and verify(shipping, reference_answer)[0])
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_total >= 200_000 and guess_rate < 1e-6 and reference_ok,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_density_fraction": guess_rate,
+        "shipping_exact_enumeration": enumerate_all(shipping),
+        "demo_exact_solution_count": enumerate_all(demo),
+        "baseline_wall_clock_seconds": round(reference_seconds, 6),
+        "baseline_exact_operations": reference_ops,
+        "baseline_algorithm": "dense exact relative-operator square root",
+    }
+
+    attack_names = (
+        "outlier_largest_entry_scalar",
+        "greedy_relative_operator",
+        "diagonal_average_scalar",
+        "obvious_unipotent_midpoint_ansatz",
+        "random_restart_256",
+    )
+    attacks = {name: {"successes": 0, "attempts": 8} for name in attack_names}
+    reference_successes = 0
+    reference_times = []
+    reference_operations = []
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        candidates = {
+            "outlier_largest_entry_scalar": _attack_largest_entry_scalar(inst),
+            "greedy_relative_operator": _candidate(0, 1),
+            "diagonal_average_scalar": _attack_diagonal_average_scalar(inst),
+            "obvious_unipotent_midpoint_ansatz": _candidate(1, 1, 2),
+        }
+        for name, candidate in candidates.items():
+            attacks[name]["successes"] += int(verify(inst, candidate)[0])
+        rrng = random.Random(seed ^ 0x5A17)
+        random_hit = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, rrng))[0]:
+                random_hit = True
+                break
+        attacks["random_restart_256"]["successes"] += int(random_hit)
+
+        started = time.perf_counter()
+        candidate, operations = _reference_algorithm(inst)
+        reference_times.append(time.perf_counter() - started)
+        reference_operations.append(operations)
+        reference_successes += int(candidate is not None and verify(inst, candidate)[0])
+
+    all_failed = all(value["successes"] == 0 and value["attempts"] >= 8
+                     for value in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "dense exact relative-operator square root",
+            "complexity": "O(d^3) exact arithmetic",
+            "wall_clock_sec_mean": round(sum(reference_times) / len(reference_times), 6),
+            "wall_clock_sec_max": round(max(reference_times), 6),
+            "operations_mean": round(sum(reference_operations) / len(reference_operations)),
+            "operations_max": max(reference_operations),
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled_params["mix_steps"] *= 2
+    doubled = make_instance(seed=2718, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    shipping_dimension = shipping["dimension"]
+    doubled_dimension = doubled["dimension"]
+    shipping_cost = 6 * shipping_dimension ** 3
+    doubled_cost = 6 * doubled_dimension ** 3
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled_dimension == 2 * shipping_dimension
+                and doubled_cost > shipping_cost,
+        "shipping_dimension": shipping_dimension,
+        "doubled_dimension": doubled_dimension,
+        "doubled_planted_verifies": doubled_ok,
+        "shipping_reference_operation_scale": shipping_cost,
+        "doubled_reference_operation_scale": doubled_cost,
+        "answer_elements_unchanged": (
+            _answer_atom_count(shipping["answer"])
+            == _answer_atom_count(doubled["answer"])
+        ),
+    }
+
+    invariant = 0
+    original_answer_valid = 0
+    changed = 0
+    for seed in range(20):
+        inst = make_instance(seed=1000 + seed,
+                             **DIFFICULTY[SHIPPING_DIFFICULTY])
+        rrng = random.Random(9000 + seed)
+        first_perm = list(range(inst["n"]))
+        second_perm = list(range(inst["n"]))
+        rrng.shuffle(first_perm)
+        rrng.shuffle(second_perm)
+        first_signs = [(-1 if rrng.getrandbits(1) else 1)
+                       for _ in range(inst["n"])]
+        second_signs = [(-1 if rrng.getrandbits(1) else 1)
+                        for _ in range(inst["n"])]
+        transformed = _signed_relabel(inst, first_perm, first_signs,
+                                      take_transpose=bool(seed % 2))
+        transformed = _signed_relabel(transformed, second_perm, second_signs,
+                                      take_transpose=bool((seed // 2) % 2))
+        invariant += int(canonical_key(inst) == canonical_key(transformed))
+        original_answer_valid += int(verify(transformed, inst["answer"])[0])
+        changed += int(transformed["cross_block"] != inst["cross_block"])
+    unrelated_keys = {
+        canonical_key(make_instance(seed=2000 + seed,
+                                    **DIFFICULTY[SHIPPING_DIFFICULTY]))
+        for seed in range(20)
+    }
+    report["G8_canonical_key"] = {
+        "pass": (invariant == 20 and original_answer_valid == 20
+                 and changed == 20 and len(unrelated_keys) == 20),
+        "composed_relabellings_invariant": invariant,
+        "transformed_instances_changed": changed,
+        "original_answers_valid_after_relabelling": original_answer_valid,
+        "unrelated_distinct_keys": len(unrelated_keys),
+        "attempts_each": 20,
+    }
+
+    answer_chars = 0
+    answer_atoms = 0
+    for seed in range(40):
+        answer = make_instance(seed=3000 + seed,
+                               **DIFFICULTY[SHIPPING_DIFFICULTY])["answer"]
+        answer_chars = max(
+            answer_chars, len(json.dumps(answer, separators=(",", ":")))
+        )
+        answer_atoms = max(answer_atoms, _answer_atom_count(answer))
+    answer_tokens = (answer_chars + 3) // 4
+    intended_operations = shipping["n"] + 8
+    arms = _G9_EVIDENCE["arms"]
+    hinted_attempts = arms["hinted"]["attempts"]
+    placebo_attempts = arms["placebo"]["attempts"]
+    hinted_rate = (arms["hinted"]["solved"] / hinted_attempts
+                   if hinted_attempts else 0.0)
+    placebo_rate = (arms["placebo"]["solved"] / placebo_attempts
+                    if placebo_attempts else 0.0)
+    within_caps = (answer_chars <= 2000 and answer_atoms <= 256
+                   and intended_operations <= 300)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": _G9_EVIDENCE["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_atoms,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        value.get("pass") for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = DIFFICULTY[SHIPPING_DIFFICULTY]
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

