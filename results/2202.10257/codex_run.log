# One exact rational literal: "7", "-7", "3/4", "-3 / 4".  No exponent notation.
_FRACTION_RE = re.compile(r"^([+-]?[0-9]+)(?:\s*/\s*([+-]?[0-9]+))?$")
# One exact decimal literal: "1.25", "-.5", "3.".  Read as a ratio of integers.
_DECIMAL_RE = re.compile(r"^([+-]?)([0-9]*)\.([0-9]*)$")


def _is_plain_int(x):
