                        shipping["pairs"][0])
    swap[pair_to_swap[0]], swap[pair_to_swap[1]] = swap[pair_to_swap[1]], swap[pair_to_swap[0]]
    corruptions = {
        "drop": {"coefficients": base[:-1]},
        "swap": {"coefficients": swap},
        "duplicate": {"coefficients": base + [base[-1]]},
