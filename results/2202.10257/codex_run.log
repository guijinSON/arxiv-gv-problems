+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    shipping_scale = (shipping["exponent_bound"] * shipping["n"] ** 3)
+    doubled_scale = (doubled["exponent_bound"] * doubled["n"] ** 3)
+    report["G7_scales"] = {
