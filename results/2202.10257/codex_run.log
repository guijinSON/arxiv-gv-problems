+    duplicated = [pair[:] for pair in base]
+    duplicated[1] = duplicated[0][:]
+    corruptions = {
+        "drop": {"roots": base[:-1]},
+        "swap": {"roots": swapped},
+        "duplicate": {"roots": duplicated},
+        "empty": {},
+        "out_of_range": {
