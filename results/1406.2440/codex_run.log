+
+    wire = json.dumps(base, separators=(",", ":"))
+    realistic = (
+        "The pendant endpoints are pairwise nonadjacent.\n"
+        f"<answer>```json\n{wire}\n```</answer>\nThat is my final matching."
+    )
+    parsed = parse_answer(realistic)
