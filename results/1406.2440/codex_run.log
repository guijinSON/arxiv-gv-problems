+    # If anchor_ij = (a_j-a_i)+c, one triangle exposes the common phase c.
+    phase = (anchors[(0, 1)] + anchors[(1, 2)] - anchors[(0, 2)]) % p
+    operations += 2
+    differences = {
+        pair: (anchor - phase) % p for pair, anchor in anchors.items()
+    }
+    operations += len(differences)
