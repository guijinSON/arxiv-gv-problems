+    forbidden = _forbidden_map(inst)
+    for i in range(k):
+        xi = answer[i][1]
+        for j in range(i + 1, k):
+            xj = answer[j][1]
+            difference = (xj - xi) % p
+            if difference in forbidden[(i, j)]:
+                return False, (
+                    f"core endpoints in groups {i} and {j} are joined "
+                    f"(forbidden difference {difference})"
+                )
