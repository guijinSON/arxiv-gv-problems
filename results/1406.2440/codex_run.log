+    operations = len(target)
+    for shift in range(modulus):
+        translated = _translate_mask(reference, shift, modulus)
+        operations += len(reference) + 1
+        if translated == target_mask:
+            return shift, operations
+    return None, operations
+
+
+def _reference_alignment(inst):
+    """Promise-aware exact recovery by exhaustive cyclic set alignment."""
+    p = inst["modulus"]
+    k = inst["groups"]
+    forbidden = _forbidden_map(inst)
+    reference = forbidden[(0, 1)]
+    shifts = {}
+    operations = 0
+    for i in range(k):
+        for j in range(i + 1, k):
+            shift, used = _alignment_shift(reference, forbidden[(i, j)], p)
+            operations += used
+            if shift is None:
+                return None, operations
+            shifts[(i, j)] = shift
