+    masks = inst.get("forbidden_masks")
+    if masks is None:
+        masks = _forbidden_masks(inst["forbidden_sets"], k)
+    for i in range(k):
+        xi = answer[i][1]
+        for j in range(i + 1, k):
+            xj = answer[j][1]
+            difference = (xj - xi) % p
+            if (masks[i][j] >> difference) & 1:
