+    "native_objects": [
+        "bounded-maximum-degree graph",
+        "induced matching of pendant edges",
+    ],
+    "verification_operations": [
+        "exact modular subtraction",
+        "graph-edge membership",
+        "endpoint-disjointness check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Locate the unique translation-equivariant cyclic run in each "
+        "cross-group adjacency set so its phase becomes a vertex difference."
+    ),
+    "hardness_basis": (
+        "Track B: translation-marker scanning is an O(k^2 p) exact "
+        "reference algorithm; at the shipping preset its measured cost is "
+        "filled from selftest, while the unique-run change of variables uses "
+        "at most 138 modular operations but must be recognized and executed "
