+    k = shipping["groups"]
+    # Modular arithmetic after visually locating each set's unique cyclic gap:
+    # k-2 star shifts, one triangle shift, one triangle correction, k-2 outputs,
+    # then one difference check for every group pair.
+    intended_operations = 2 * (k - 2) + 2 + k * (k - 1) // 2
+    arms = _G9_EVIDENCE["arms"]
