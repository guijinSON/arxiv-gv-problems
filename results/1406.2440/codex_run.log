+        and len(unrelated_keys) == 20,
+        "composed_relabellings_invariant": invariant,
+        "carried_witnesses_valid": carried_valid,
+        "serializations_actually_changed": changed_serialization,
+        "unrelated_distinct_keys": len(unrelated_keys),
+        "attempts_each": 20,
