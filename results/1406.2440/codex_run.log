+        for residue in range(p):
+            if all(
+                (residue - chosen[i]) % p not in forbidden[(i, j)]
+                for i in range(j)
+            ):
+                found = residue
+                break
+        if found is None:
+            chosen.extend(0 for _ in range(k - len(chosen)))
+            break
+        chosen.append(found)
+    return [[i, chosen[i]] for i in range(k)]
