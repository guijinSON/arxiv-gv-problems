+    """Exhaustively find target = reference + shift; count exact residue moves."""
+    target_mask = 0
+    for value in target:
+        target_mask |= 1 << value
+    operations = len(target)
+    for shift in range(modulus):
+        translated = _translate_mask(reference, shift, modulus)
+        operations += len(reference) + 1
+        if translated == target_mask:
