+    "native_objects": [
+        "bounded-maximum-degree graph",
+        "induced matching of pendant edges",
+    ],
+    "verification_operations": [
+        "exact modular subtraction",
+        "graph-edge membership",
+        "endpoint-disjointness check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Align the shared cyclic pattern in the cross-group adjacency sets so "
+        "that their translations become consistent vertex coordinates."
+    ),
+    "hardness_basis": (
+        "Track B: exhaustive cyclic-set alignment is an O(k^2 p^2) exact "
+        "reference algorithm; at the shipping preset its measured cost is "
+        "filled from selftest, while the unique-gap change of variables uses "
+        "at most 153 modular operations but must be recognized and executed "
+        "without tools."
