+        "requested_n": n,
+        "modulus": modulus,
+        "groups": groups,
+        "forbidden_size": forbidden_size,
+        "forbidden_sets": forbidden_sets,
+        "forbidden_masks": _forbidden_masks(forbidden_sets, groups),
+        "vertex_count": vertex_count,
+        "edge_count": edge_count,
+        "maximum_degree": core_degree,
