                            "answer_atoms": _atoms, "answer_chars": _chars,
                            "atom_cap": ANSWER_ATOM_CAP, "char_cap": ANSWER_CHAR_CAP,
                            "axes_moved": sorted(axes_moved),
                            # Two different diagnoses share this verdict, and the
