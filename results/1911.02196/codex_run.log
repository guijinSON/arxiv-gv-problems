+        "vertices": list(range(n)),
+        "z_vertices": list(inst["z_vertices"]),
+        "edges": edges,
+        "answer": answer,
+    }
+
+
+def _corruptions(inst):
+    answer = list(inst["answer"])
+    m = len(answer)
+    drop = answer[:-1]
+    duplicate = answer + [answer[-1]]
+    out_of_range = list(answer)
