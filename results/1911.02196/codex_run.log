+    random_success = False
+    for _ in range(256):
+        order = list(range(len(inst["edges"])))
+        rng.shuffle(order)
+        candidate = _greedy_candidate(inst, order)
+        if candidate is not None and verify(inst, candidate)[0]:
+            random_success = True
+            break
