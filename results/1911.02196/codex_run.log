+        bit = 1 << colour
+        if used[a] & bit or used[b] & bit:
+            return False
+        assignment[edge_id] = colour
+        used[a] |= bit
+        used[b] |= bit
+        trail.append((edge_id, a, b, bit))
+        queue.append(a)
+        queue.append(b)
+        return True
