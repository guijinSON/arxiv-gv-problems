+def _propagation_dpll(inst, node_limit=250000):
+    """Exact 3-edge-colouring search, stopped only at a documented node cap."""
+    n = inst["n"]
+    m = len(inst["edges"])
+    incident = _incidence(inst)
+    assignment = [-1] * m
+    used = [0] * n
+    nodes = 0
