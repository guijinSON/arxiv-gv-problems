try:
    v = (json.load(open(sys.argv[1])) or {}).get("harden_verdict") or {}
except Exception:
    sys.exit(0)                       # no verdict recorded; nothing to contradict
if v.get("verdict") not in ("cap_bound", "budget_bound"):
