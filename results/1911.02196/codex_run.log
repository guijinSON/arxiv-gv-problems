+        a, b = inst["edges"][i]
+        available = 7 & ~(used[a] | used[b])
+        if not available:
+            return None
+        bit = available & -available
+        c = bit.bit_length() - 1
+        answer[i] = c
+        used[a] |= bit
+        used[b] |= bit
+    return answer
