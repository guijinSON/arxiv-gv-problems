+def _distance_profile(n, edges, source):
+    adj = [[] for _ in range(n)]
+    for a, b in edges:
+        adj[a].append(b)
+        adj[b].append(a)
+    distances = [-1] * n
+    distances[source] = 0
+    queue = deque([source])
+    while queue:
+        v = queue.popleft()
+        for w in adj[v]:
+            if distances[w] < 0:
+                distances[w] = distances[v] + 1
+                queue.append(w)
