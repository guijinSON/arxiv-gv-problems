+def _normalized_line(record, q):
+    a, b, c, sign = record
+    if a % q:
+        inverse = pow(a % q, -1, q)
+    else:
+        inverse = pow(b % q, -1, q)
+    return (a * inverse % q, b * inverse % q, c * inverse % q, sign)
