+    }
+
+    failures = []
+    checks = 0
+    for preset, preset_params in DIFFICULTY.items():
+        for seed in (0, 1, 7, 19):
+            inst = make_instance(seed=seed, **preset_params)
+            ok, reason = verify(inst, inst["answer"])
+            checks += 1
+            if not ok:
