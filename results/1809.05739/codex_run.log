+def _direction(normal_a, normal_b, q):
+    if normal_a % q:
+        inverse = pow(normal_a % q, -1, q)
+        return (1, normal_b * inverse % q)
+    if normal_b % q:
+        return (0, 1)
+    raise ValueError("zero normal")
