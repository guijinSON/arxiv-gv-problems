+        "q": q,
+        "dimension": q * q,
+        "block_size": q,
+        "intersection_sizes": [1, 0],
+        "classes": classes,
+        "min_class": min_class,
+        "max_class": max_class,
+        "N": len(records),
+        "lines": records,
+        "coefficient_height": (2 * (len(records) + 2 * q)) ** classes,
+        "answer": answer,
+    }
+
