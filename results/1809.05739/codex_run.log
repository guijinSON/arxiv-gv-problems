+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Hint: The exact Gram matrix is constant on the parallel classes of the "
+    "affine blocks."
+)
+PLACEBO_HINT = (
+    "Hint: The exact Gram computation rewards careful handling of the modular "
