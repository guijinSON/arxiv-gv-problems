    swapped[swap_index] = list(reversed(swapped[swap_index]))
    duplicate = [factor[:] for factor in answer]
    duplicate[-1] = duplicate[0][:]
    outside = [factor[:] for factor in answer]
    outside[0][0] = shipping["p"]
