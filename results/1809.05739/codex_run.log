+def render(inst):
+    """Render a self-contained exact Gram characteristic-polynomial task."""
+    rows = "\n".join(
+        f"  {index}: [{a}, {b}, {c}, {sign}]"
+        for index, (a, b, c, sign) in enumerate(inst["lines"])
+    )
+    example = (
+        '{"factors":['
+        '{"poly":[[[-6,1],[0]],[[1,1],[1]]],"multiplicity":4},'
+        '{"poly":[[[-8,1],[0]],[[2,1],[1]],[[1,1],[2]]],'
+        '"multiplicity":1}]}'
