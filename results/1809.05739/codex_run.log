+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["N"] > shipping["N"] and ascending_orders,
+        "preset_gram_orders": preset_orders,
+        "preset_candidate_spaces": preset_spaces,
+        "doubled_n": doubled_params["n"],
+        "doubled_q": doubled["q"],
