+        prefix.append(_poly_mul(prefix[-1], factor, counter))
+    suffix = [None] * (r + 1)
+    suffix[r] = [1]
+    for index in range(r - 1, -1, -1):
+        suffix[index] = _poly_mul(factors[index], suffix[index + 1], counter)
+    result = prefix[-1][:]
+    for index, size in enumerate(sizes):
