+        "residual_degree": "r = classes (7 at the initial shipping preset)",
+        "bulk_root_range": "0 <= z <= floor(trace(G)/(N-r))",
+        "coefficient_height": "H = (2(N+2q))^r",
+        "rational_denominators": 1,
+        "shipping_atomic_elements_upper_bound": 64,
