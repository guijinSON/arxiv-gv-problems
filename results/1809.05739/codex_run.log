+def _poly_mul(left, right, counter=None):
+    out = [0] * (len(left) + len(right) - 1)
+    for i, a in enumerate(left):
+        if a == 0:
+            continue
+        for j, b in enumerate(right):
+            if b == 0:
+                continue
+            out[i + j] += a * b
+            if counter is not None:
+                counter[0] += 2
+    return out
