+        "preset_gram_orders": preset_orders,
+        "preset_candidate_spaces": preset_spaces,
+        "doubled_n": doubled_params["n"],
+        "doubled_q": doubled["q"],
+        "doubled_gram_order": doubled["N"],
+        "doubled_verifies": doubled_ok,
