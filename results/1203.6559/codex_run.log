+        for upper, lower in zip(stack, stack[1:]):
+            if upper not in pair_node or lower not in pair_node:
+                continue
+            source, target = pair_node[upper], pair_node[lower]
+            if source == target:
+                return False
+            if target not in adjacency[source]:
+                adjacency[source].add(target)
+                indegree[target] += 1
