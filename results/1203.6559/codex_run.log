+        signature = hashlib.sha256(
+            json.dumps(answer, separators=(",", ":")).encode("ascii")
+        ).hexdigest()[:8]
+        return False, (
+            "chosen pairings create a directed precedence cycle "
+            f"(residual nodes {residue[:6]}, candidate {signature})"
