+            if planted[left] == planted[right]:
+                continue
+            candidate = planted[:]
+            candidate[left], candidate[right] = candidate[right], candidate[left]
+            ok, reason = verify(inst, candidate)
+            if not ok:
+                return candidate, reason
+    return None, "no invalid coordinate swap found"
+
