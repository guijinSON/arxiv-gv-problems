+    tile_count = 4 * n
+    tile_stack = [-1] * tile_count
+    seen_tiles: set[int] = set()
+    for stack_index, stack in enumerate(inst.get("stacks", [])):
+        for tile in stack:
+            if (
+                isinstance(tile, bool)
+                or not isinstance(tile, int)
+                or not 0 <= tile < tile_count
+                or tile in seen_tiles
