+        },
+        "arms_note": (
+            "not scored: harden.py received HTTP 403 Key limit exceeded from "
+            "every OpenRouter redraw; see the three transcript files"
+        ),
+        "hinted_minus_placebo": None,
+        "hinted_verdict": "blocked_external",
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+    }
+
+    report["pass"] = all(
+        gate.get("pass", False)
+        for name, gate in report.items()
+        if name.startswith("G") and isinstance(gate, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
