+
+def _pairing_dfs(inst: dict, node_cap: int = 4096):
+    # Static "critical group" proxy: groups touching the shallowest positions go
+    # first.  The recursion and cycle pruning are the group-directed search of
+    # Section 3, with a strict cap so the audit always terminates.
+    depths = [[] for _ in range(inst["n"])]
+    for stack in inst["stacks"]:
+        for depth, tile in enumerate(stack):
+            depths[inst["tile_groups"][tile]].append(depth)
+    order = sorted(range(inst["n"]), key=lambda g: (sum(depths[g]), g))
+    assignment: dict[int, int] = {}
+    nodes = 0
+
+    def visit(index: int):
+        nonlocal nodes
+        if nodes >= node_cap:
+            return None
+        nodes += 1
+        if index == len(order):
+            candidate = [assignment[g] for g in range(inst["n"])]
+            return candidate if verify(inst, candidate)[0] else False
+        group = order[index]
+        for code in range(3):
+            assignment[group] = code
+            if _partial_acyclic(inst, assignment):
+                result = visit(index + 1)
+                if result is not False and result is not None:
+                    return result
+                if result is None and nodes >= node_cap:
+                    del assignment[group]
+                    return None
+            del assignment[group]
+        return False
+
+    started = time.perf_counter()
+    result = visit(0)
+    return result, nodes, time.perf_counter() - started
