+    "medium": {"n": 144, "height": 8},
+    "hard": {"n": 192, "height": 8},
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A length-n JSON vector over {0,1,2}; entry g selects one of the three "
+        "perfect pairings of the four tiles in group g, ordered by tile ID."
+    ),
