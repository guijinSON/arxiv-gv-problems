+            right_bit = (mapped >> right) & 1
+            if kind == 0:
+                if left_bit != right_bit:
+                    mapped ^= (1 << left) | (1 << right)
+            elif right_bit:
+                mapped ^= 1 << left
+        table.append(mapped)
+    return table
 
 
