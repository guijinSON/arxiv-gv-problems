+def _truth_from_masks(masks: list[int], n: int) -> list[int]:
+    values = [0] * n
+    for mask in masks:
+        values[mask] = 1
+    k = n.bit_length() - 1
+    for bit in range(k):
+        flag = 1 << bit
+        for mask in range(n):
+            if mask & flag:
+                values[mask] ^= values[mask ^ flag]
+    return values
