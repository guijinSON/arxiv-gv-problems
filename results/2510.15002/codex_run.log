   675	    symbolic_operations = 3 * len(_pairs(int(inst["dimension"]))) + 4 * int(inst["dimension"]) + 6
   676	    operations = {
   677	        "moebius_xors": n * int(inst["dimension"]) // 2,
   678	        "symbolic_boolean_operations": symbolic_operations,
   679	        "dense_involution_alternative_xors": n * (len(inst["shifts"]) - 1),
   680	    }
   681	    operations["scalar_operations"] = (
   682	        operations["moebius_xors"] + operations["symbolic_boolean_operations"]
   683	    )
   684	    if not masks or len(masks) > int(inst["max_terms"]):
   685	        return None, operations
   686	    return _masks_to_answer(masks, inst["dimension"]), operations
