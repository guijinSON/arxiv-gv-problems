import contextlib, copy, importlib.util, io, json, os
buf=io.StringIO()
with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
    s=importlib.util.spec_from_file_location('g','gen_2510_15002.py')
    g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
assert buf.getvalue()==''
p=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
a=g.make_instance(seed=424242,**p)
b=g.make_instance(seed=424242,**p)
assert a==b
planted=copy.deepcopy(a['answer'])
a['answer']=[[]]
assert g.verify(a,planted)==(True,'ok')
blob=json.dumps(planted,separators=(',',':'))
assert g.parse_answer('prose <answer>"'```json'"\\n'+blob+'\\n"'```</answer> tail'"')==planted
os.environ.pop('GV_HINT_MODE',None)
plain=g.render(a)
assert 'Hint:' not in plain and '<answer>' in plain
os.environ['GV_HINT_MODE']='structural'; assert g.STRUCTURAL_HINT in g.render(a)
os.environ['GV_HINT_MODE']='placebo'; assert g.PLACEBO_HINT in g.render(a)
assert json.loads(json.dumps(planted))==planted
print('static/interface audit: ok')
print('render chars:',len(plain),'answer chars:',len(blob),'key:',g.canonical_key(a)[:16])
