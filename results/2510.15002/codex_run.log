   830	def _answer_atoms(answer: list[list[int]]) -> int:
   831	    return len(answer) + sum(len(term) for term in answer)
   832	
   833	
   834	def _generated_answer_size_bound(k: int) -> tuple[int, int, int]:
   835	    """Exact worst-case (chars, conservative tokens, atoms) at dimension k.
   836	
   837	    Generation always selects exactly floor(C(k,2)/2) quadratic terms, while
   838	    every affine term may be present.  Among degree-two terms, selecting those
   839	    with the longest JSON spellings maximizes the serialized certificate.
   840	    """
   841	    pairs = _pairs(k)
   842	    pair_count = max(1, len(pairs) // 2)
   843	    longest_pairs = sorted(
   844	        pairs,
   845	        key=lambda pair: len(json.dumps(list(pair), separators=(",", ":"))),
   846	        reverse=True,
   847	    )[:pair_count]
   848	    masks = [0]
   849	    masks.extend(1 << bit for bit in range(k))
   850	    masks.extend((1 << left) | (1 << right) for left, right in longest_pairs)
   851	    answer = _masks_to_answer(sorted(masks), k)
   852	    chars = len(_format_answer(answer))
   853	    return chars, math.ceil(chars / 4), _answer_atoms(answer)
