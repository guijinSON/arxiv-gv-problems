+def _moments(shifts: list[int], k: int) -> tuple[int, int]:
+    first = 0
+    for shift in shifts:
+        first ^= shift
+    second = 0
+    for pair_index, (left, right) in enumerate(_pairs(k)):
+        bit = 0
+        for shift in shifts:
+            bit ^= ((shift >> left) & 1) & ((shift >> right) & 1)
+        second |= bit << pair_index
+    return first, second
+
