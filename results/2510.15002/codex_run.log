   689	def _compact_algorithm(inst: dict) -> tuple[list[list[int]], int]:
   690	    """Recover a quadratic ANF through its translation-invariant top part."""
   691	    k = int(inst["dimension"])
   692	    rhs = inst["rhs"]
   693	    r_constant = int(rhs[0])
   694	    r_linear = 0
   695	    for bit in range(k):
   696	        r_linear |= (int(rhs[1 << bit]) ^ r_constant) << bit
   697	    quadratic = 0
   698	    for pair_index, (left, right) in enumerate(_pairs(k)):
   699	        coefficient = (
   700	            int(rhs[(1 << left) | (1 << right)])
   701	            ^ int(rhs[1 << left])
   702	            ^ int(rhs[1 << right])
   703	            ^ r_constant
   704	        )
   705	        quadratic |= coefficient << pair_index
   706	    first = int(inst["first_moment"])
   707	    second = int(inst["second_moment"][::-1], 2)
   708	    neighbors = [0] * k
   709	    for pair_index, (left, right) in enumerate(_pairs(k)):
   710	        if (quadratic >> pair_index) & 1:
   711	            neighbors[left] |= 1 << right
   712	            neighbors[right] |= 1 << left
   713	    linear = r_linear
   714	    for bit in range(k):
   715	        linear ^= _parity(neighbors[bit] & first) << bit
   716	    constant = (
   717	        r_constant ^ _parity(linear & first) ^ _parity(quadratic & second)
   718	    )
   719	    masks = _coefficients_to_masks(constant, linear, quadratic, k)
   720	    operations = 3 * len(_pairs(k)) + 4 * k + 6
   721	    return _masks_to_answer(masks, k), operations
   722	
