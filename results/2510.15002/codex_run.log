+        "greedy_one_pass_propagation",
+        "random_restart_256",
+        "copy_first_truth_table",
+        "bitwise_majority_of_blocks",
+        "affine_only_ansatz",
+    ]
+    attack_results = {
+        name: {"successes": 0, "attempts": _ATTACK_SEEDS}
+        for name in attack_names
+    }
+    ref_successes = 0
+    ref_total_wall = 0.0
+    ref_total_xors = 0
+    ref_total_scalar = 0
+    compact_successes = 0
+    compact_operations = []
