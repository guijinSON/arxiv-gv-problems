   753	def _random_restart_succeeds(inst: dict, planted: list[list[int]], seed: int,
   754	                             restarts: int = 256) -> bool:
   755	    rng = random.Random(seed)
   756	    # Uniqueness from A^2=I makes equality an exact fast validity test.
   757	    return any(random_candidate(inst, rng) == planted for _ in range(restarts))
