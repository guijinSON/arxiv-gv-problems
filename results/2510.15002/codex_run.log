+def _quadratic_coefficients_from_masks(masks: list[int], k: int
+                                       ) -> tuple[int, int, int]:
+    constant = int(0 in masks)
+    linear = 0
+    quadratic = 0
+    pair_to_index = {pair: index for index, pair in enumerate(_pairs(k))}
+    for mask in masks:
