   780	def _transform_for_g8(inst: dict, answer: list[list[int]], seed: int
   781	                      ) -> tuple[dict, list[list[int]]]:
   782	    """Compose affine relabeling, support translation, gauge, and reordering."""
   783	    rng = random.Random(seed)
   784	    n = int(inst["n"])
   785	    k = int(inst["dimension"])
   786	    linear_map = _linear_map_table(k, rng)
   787	    index_translation = rng.randrange(n)
   788	    support_translation = rng.randrange(n)
   789	    answer_masks, error = _answer_to_masks(inst, answer)
   790	    assert error is None and answer_masks is not None
   791	    old_values = _truth_from_masks(answer_masks, n)
   792	    gauge_quadratic = 0
   793	    for pair_index in rng.sample(range(len(_pairs(k))), min(3, len(_pairs(k)))):
   794	        gauge_quadratic |= 1 << pair_index
   795	    gauge_values = _quadratic_table(
   796	        n, rng.getrandbits(1), rng.randrange(1 << k), gauge_quadratic
   797	    )
   798	    new_values = [0] * n
   799	    for old_index in range(n):
   800	        new_index = linear_map[old_index] ^ index_translation
   801	        new_values[new_index] = old_values[old_index] ^ gauge_values[old_index]
   802	    new_masks = _masks_from_truth(new_values)
   803	    assert 0 < len(new_masks) <= int(inst["max_terms"])
   804	    new_coeffs = _quadratic_coefficients_from_masks(new_masks, k)
   805	    new_shifts = [
   806	        linear_map[shift] ^ support_translation for shift in inst["shifts"]
   807	    ]
   808	    first, second = _moments(new_shifts, k)
   809	    r_coeffs = _translated_quadratic(*new_coeffs, first, second, k)
   810	    rhs = "".join(str(bit) for bit in _quadratic_table(n, *r_coeffs))
   811	    rng.shuffle(new_shifts)
   812	    transformed = {
   813	        "family": inst["family"],
   814	        "n": n,
   815	        "dimension": k,
   816	        "weight": len(new_shifts),
   817	        "shifts": new_shifts,
   818	        "rhs": rhs,
   819	        "first_moment": first,
   820	        "second_moment": format(second, f"0{len(_pairs(k))}b")[::-1],
   820	        "second_moment": format(second, f"0{len(_pairs(k))}b")[::-1],
   821	        "max_terms": inst["max_terms"],
   822	        "parity_equations": n,
   823	        "accumulator_steps": n * (len(new_shifts) - 1),
   824	        "nae3_row_count": 8 * n * (len(new_shifts) - 1) + n,
   825	        "answer": _masks_to_answer(new_masks, k),
   826	    }
   827	    return transformed, transformed["answer"]
