+"""Quadratic-character certificates for Binnendyk logic engines.
+
+The generated object is the logic engine used in Sections 1.4 and 4 of
+arXiv:2510.15002v2.  A compact block describes NAE-3 rows; an armature
+orientation vector is a witness that every upper and lower row has an empty
+link and therefore admits the paper's explicit left/right flag completion.
+
+Generation is inverse: choose a quadratic Boolean truth table first, then
+compute every displayed parity block from it.  The certificate is never found
+by solving the emitted instance.  The module is deterministic in (n, seed,
+params), uses only the Python standard library, performs no file I/O, and
+prints nothing on import.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import Counter
+from typing import Any
+
+
+TRACK = "B"
+
+_REDUCTION = (
+    "Sections 1.4 and 4: arbitrary NAE-3SAT clauses are represented by "
+    "logic-engine flag rows, and a satisfying assignment is equivalent to a "
+    "flat armature/flag configuration"
+)
+
+PROBLEM_PROFILE = {
+    "native_domain": "logic",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "logic-engine armatures",
+        "flag-incidence rows encoded by NAE-3 clauses",
+        "Boolean XOR-translation blocks",
+    ],
+    "verification_operations": [
+        "Boolean literal evaluation",
+        "exact parity comparison",
+        "logic-engine empty-link row check",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": _REDUCTION,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Read each displayed truth table in algebraic normal form: XOR "
+        "translations change only its affine part, while a solver missing "
+        "that invariant must eliminate the full NAE/XOR system."
+    ),
+    "hardness_basis": (
+        "Track B: sparse Gaussian elimination solves the decoded XOR system "
+        "in O(M*n^2) scalar bit operations; at the hard preset the measured "
+        "reference cost and wall time are reported by selftest, whereas the "
+        "quadratic-ANF route uses at most 216 exact Boolean operations."
+    ),
+    "max_answer_tokens": 65,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 8, "blocks": 2},
+    "easy": {"n": 32, "blocks": 8},
+    "medium": {"n": 64, "blocks": 24},
+    "hard": {"n": 128, "blocks": 64},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Across every XOR-translation block, the truth table has the same "
+    "quadratic algebraic-normal-form part."
+)
+PLACEBO_HINT = (
+    "Across every displayed data block, the notation deserves the same "
+    "careful attention to indices and parity."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "Exactly n comma-separated Boolean armature orientations, each 0 or "
+        "1; auxiliary armatures and every flag direction are fixed by the "
+        "deterministic completion rule in the statement."
+    ),
+    "bounds": {
+        "length": "exactly the instance n",
+        "alphabet": [0, 1],
+        "max_shipping_length": 128,
+        "absolute_supported_length": 4096,
+    },
+}
+
+NOTES = r"""
+Step 0.  Version 2, Section 1 defines a unit-distance realization as an
+injective map to the integer lattice whose listed edges have Euclidean length
+one; nonedges are not required to have nonunit length.  Section 1.4 defines
+the logic engine and proves the executable row criterion: a flag orientation
+exists exactly when every row has an unflagged link.  Its next theorem maps an
+NAE-3SAT assignment to armature directions.  Sections 3--4 turn that engine
+into a square-lattice unit-distance graph and prove that the only remaining
+freedoms are chain and flag flips.  Those results license this compact
+logic-engine family, but the solver is not handed all lattice coordinates;
+the profile therefore says licensed_reduction rather than native geometry.
+
+The paper's main theorem is worst-case NP-completeness.  It does not imply
+hardness for randomly planted lattice drawings, so the prior-triage proposal
+was rejected.  This generator is deliberately Track B.  Its block system is
+XOR-SAT and sparse Gaussian elimination is an efficient complete algorithm.
+The selftest reports that successful algorithm separately, including packed
+row XORs, scalar bit operations, and wall time.
+
+Certificate production.  Variables are indexed by the vector space F_2^k.
+Generation first samples a non-affine quadratic Boolean function q and keeps
+its full truth table x_i=q(i).  A block chooses distinct nonzero masks a,b and
+contains all equations
+
+    x_i XOR x_(i XOR a) XOR x_(i XOR b) = r_i.
+
+Every r_i is evaluated from the already held table.  The associated operator
+I+T_a+T_b is invertible: in the group algebra of the elementary 2-group its
+augmentation is one, so it is one plus a nilpotent element.  Thus even one
+block has a unique certificate, although uniqueness is not needed by verify.
+
+Each displayed parity equation is an exact compact encoding of NAE-3 rows.
+Introduce a reference armature z=0.  The four NAE-4 clauses whose forbidden
+complement-pairs have parity 1-r enforce
+x_a XOR x_b XOR x_c XOR z=r.  Each NAE-4(l0,l1,l2,l3) becomes
+NAE(l0,l1,y) and NAE(not y,l2,l3).  The checker constructs y from the four
+literal values and executes all eight NAE-3 row checks.  The certificate is
+therefore a concrete, deterministically expandable logic-engine orientation,
+not an appeal to a theorem inside verify.
+
+What makes this generated regime easy with tools is exactly what makes it
+Track B: Gaussian elimination.  The compact route instead notes that
+translation of a quadratic Boolean function preserves its quadratic ANF
+coefficients.  Values at 0, basis vectors, and pairwise basis sums recover
+those coefficients; the masks reveal the affine correction.  The measured
+route count includes producing all n output bits and remains below 300.
+
+Attacks.  Every variable occurs exactly three times in every block, removing
+degree outliers.  Blocks and masks are drawn uniformly from the same pool;
+there is no planted block.  Generation rejects the rare mask whose right-hand
+side is the answer or its complement.  This defeats copying a block.  Taking
+the bitwise majority across blocks, fitting only an affine ANF, one-pass local
+propagation, and 256 uniform restarts are all tested on eight seeds.  The
+successful Gaussian route is disclosed outside attacks, as Track B requires.
+
+Canonicalization.  Row order, endpoint order, arbitrary armature renumbering,
+and independent Boolean gauge flips are ignored.  Because every generated
+coefficient matrix has full column rank, all consistent right-hand sides are
+gauge-equivalent, so the key uses only the 3-uniform equation hypergraph.  It
+records pair-codegree and codegree-triangle multisets.  This is a strong cheap
+invariant, not a complete canonizer for arbitrary 3-uniform hypergraphs; that
+limitation is repeated in README.md.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_G4_SAMPLES = 200_000
+_ATTACK_SEEDS = 8
+_ENUMERATION_CAP_N = 20
+
+# Filled from script-owned runs after the bare/hinted/placebo evidence exists.
+_ORACLE_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _int_param(name: str, value: object, low: int, high: int) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError(f"{name} must be an integer")
+    if not low <= value <= high:
+        raise ValueError(f"{name} must lie in {low}..{high}")
+    return value
+
+
+def _is_power_of_two(value: int) -> bool:
+    return value > 0 and value & (value - 1) == 0
+
+
+def _parity(value: int) -> int:
+    return value.bit_count() & 1
+
+
+def _eval_quadratic(index: int, linear: int,
+                    pairs: tuple[tuple[int, int], ...], constant: int) -> int:
+    value = constant ^ _parity(index & linear)
+    for left, right in pairs:
+        value ^= ((index >> left) & 1) & ((index >> right) & 1)
+    return value
+
+
+def _block_shape(a: int, b: int) -> tuple[int, int, int]:
+    return tuple(sorted((a, b, a ^ b)))
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Inverse-generate a quadratic truth table and its logic-engine rows."""
+    n = _int_param("n", n, 8, 4096)
+    if not _is_power_of_two(n):
+        raise ValueError("n must be a power of two")
+    blocks = _int_param("blocks", params.pop("blocks", 2), 1, 4096)
+    if params:
+        raise ValueError("unknown parameters: " + ", ".join(sorted(params)))
+    k = n.bit_length() - 1
+    max_shapes = ((n - 1) * (n - 2)) // 6
+    if blocks > max_shapes:
+        raise ValueError(f"blocks exceeds the {max_shapes} distinct mask shapes")
+
+    rng = random.Random(seed)
+    all_pairs = [(i, j) for i in range(k) for j in range(i + 1, k)]
+    pair_count = max(1, min(len(all_pairs), (len(all_pairs) + 1) // 2))
+    quadratic_pairs = tuple(sorted(rng.sample(all_pairs, pair_count)))
+    linear = rng.randrange(1 << k)
+    constant = rng.getrandbits(1)
+    answer = [
+        _eval_quadratic(i, linear, quadratic_pairs, constant)
+        for i in range(n)
+    ]
+
+    used_shapes: set[tuple[int, int, int]] = set()
+    data_blocks = []
+    attempts = 0
+    while len(data_blocks) < blocks:
+        attempts += 1
+        if attempts > 100_000:
+            raise RuntimeError("could not draw enough distinct translation blocks")
+        a = rng.randrange(1, n)
+        b = rng.randrange(1, n)
+        if a == b:
+            continue
+        shape = _block_shape(a, b)
+        if shape in used_shapes:
+            continue
+        rhs = [answer[i] ^ answer[i ^ a] ^ answer[i ^ b] for i in range(n)]
+        # Copying a displayed row is an in-context baseline, not the insight.
+        if rhs == answer or rhs == [1 ^ bit for bit in answer]:
+            continue
+        used_shapes.add(shape)
+        data_blocks.append({"a": a, "b": b, "rhs": "".join(map(str, rhs))})
+
+    rng.shuffle(data_blocks)
+    return {
+        "family": "quadratic_logic_engine_v1",
+        "n": n,
+        "dimension": k,
+        "blocks": data_blocks,
+        "equation_count": n * blocks,
+        "nae3_row_count": 8 * n * blocks,
+        "answer": answer,
+    }
+
+
+def _equations(inst: dict):
+    explicit = inst.get("equations")
+    if explicit is not None:
+        for row in explicit:
+            yield int(row[0]), int(row[1]), int(row[2]), int(row[3])
+        return
+    n = inst["n"]
+    for block in inst["blocks"]:
+        a, b = block["a"], block["b"]
+        rhs = block["rhs"]
+        for i in range(n):
+            yield i, i ^ a, i ^ b, int(rhs[i])
+
+
+def _nae(values: tuple[int, int, int]) -> bool:
+    return not (values[0] == values[1] == values[2])
+
+
+def _expanded_rows_hold(xa: int, xb: int, xc: int, rhs: int) -> bool:
+    """Execute the four NAE-4 to eight NAE-3 parity gadget rows."""
+    z = 0
+    raw = (xa, xb, xc, z)
+    forbidden_parity = 1 ^ rhs
+    for tail in range(8):
+        q = (0, (tail >> 2) & 1, (tail >> 1) & 1, tail & 1)
+        if (q[0] ^ q[1] ^ q[2] ^ q[3]) != forbidden_parity:
+            continue
+        literals = tuple(raw[j] ^ q[j] for j in range(4))
+        l0, l1, l2, l3 = literals
+        if l0 == l1:
+            y = 1 ^ l0
+        elif l2 == l3:
+            y = l2
+        else:
+            y = 0
+        if not _nae((l0, l1, y)) or not _nae((1 ^ y, l2, l3)):
+            return False
+    return True
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any armature vector by expanding and testing every NAE-3 row."""
+    n = inst.get("n")
+    if not isinstance(answer, list):
+        return False, "certificate must be a list of Boolean orientations"
+    if not answer:
+        return False, "empty orientation certificate"
+    if len(answer) < n:
+        return False, f"too few armature orientations: expected {n}, got {len(answer)}"
+    if len(answer) > n:
+        return False, f"too many armature orientations: expected {n}, got {len(answer)}"
+    for index, bit in enumerate(answer):
+        if type(bit) is not int or bit not in (0, 1):
+            return False, f"orientation {index} is not Boolean"
+    for row_index, (a, b, c, rhs) in enumerate(_equations(inst)):
+        if answer[a] ^ answer[b] ^ answer[c] != rhs:
+            return False, f"parity row {row_index} is violated"
+        if not _expanded_rows_hold(answer[a], answer[b], answer[c], rhs):
+            return False, f"NAE flag-row expansion {row_index} collides"
+    return True, "ok"
+
+
+def _format_answer(answer: list[int]) -> str:
+    return ", ".join(str(bit) for bit in answer)
+
+
+def render(inst: dict) -> str:
+    """Render a self-contained flat-logic-engine witness problem."""
+    n = inst["n"]
+    lines = [
+        "FLAT LOGIC-ENGINE ORIENTATION (exact Boolean instance)",
+        "",
+        f"There are {n} primary armatures X_0,...,X_{n - 1}.",
+        "Orientation 1 means the unprimed chain points up; 0 means it points down.",
+        "The index set uses bitwise XOR, written XOR below.",
+        "",
+        "A data block 'a b : R' represents one parity record for every",
+        f"i=0,...,{n - 1}.  Character R[i] is the i-th character from the left,",
+        "with 0-based indexing, and the required relation is",
+        "",
+        "  X_i XOR X_(i XOR a) XOR X_(i XOR b) = R[i].",
+        "",
+        "Here is the exact connection to flag rows.  Add a reference armature Z",
+        "whose orientation is fixed to 0.  For each parity relation with right side",
+        "r, take the four 4-literal NAE clauses that forbid the four complement-pairs",
+        "of assignments having parity 1-r.  NAE means 'not all literals have the",
+        "same Boolean value'.  Convert each NAE(l0,l1,l2,l3) to the two rows",
+        "NAE(l0,l1,Y) and NAE(not Y,l2,l3), using its own auxiliary armature Y.",
+        "If l0=l1 fix Y=not l0; otherwise if l2=l3 fix Y=l2; otherwise fix Y=0.",
+        "Thus your primary vector deterministically specifies every auxiliary and",
+        "all eight NAE-3 rows.  A vector is valid exactly when every such row is NAE.",
+        "Equivalently, in the paper's logic engine every upper and lower flag row",
+        "has an unflagged link; flags before the first empty link point right and",
+        "flags after it point left.  This fixes a complete flat configuration.",
+        "",
+        "Nonzero masks a and b are distinct.  Blocks may be used in any order.",
+        "All arithmetic is exact over bits; there are no probabilities or floats.",
+        "",
+        "DATA BLOCKS",
+    ]
+    for block_index, block in enumerate(inst["blocks"]):
+        lines.append(
+            f"{block_index}: {block['a']} {block['b']} : {block['rhs']}"
+        )
+    lines.extend([
+        "END DATA BLOCKS",
+        "",
+        f"Return exactly {n} bits in order X_0 through X_{n - 1}.",
+        "Bits must be 0 or 1, separated by commas; repetitions are allowed and order matters.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    lines.extend([
+        "",
+        "Give your final answer inside <answer></answer> tags as comma-separated bits.",
+        "Format example for a four-armature instance: <answer>0, 1, 0, 1</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    return "\n".join(lines)
+
+
+def parse_answer(text: object) -> object | None:
+    """Parse a tagged bit vector, tolerating prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json|text|python)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body).strip()
+    try:
+        parsed = json.loads(body)
+    except (ValueError, TypeError):
+        parsed = None
+    if isinstance(parsed, list):
+        if all(type(bit) is int and bit in (0, 1) for bit in parsed):
+            return parsed
+        return None
+    if re.fullmatch(r"[01](?:\s*,\s*[01])*", body):
+        return [int(piece.strip()) for piece in body.split(",")]
+    return None
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the exact n-bit certificate language."""
+    return [rng.getrandbits(1) for _ in range(inst["n"])]
+
+
+def search_space(inst: dict) -> int | None:
+    return 1 << inst["n"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Brute-force the exact language only at hand-scale sizes."""
+    n = inst["n"]
+    if n > _ENUMERATION_CAP_N:
+        return None
+    count = 0
+    for mask in range(1 << n):
+        candidate = [(mask >> i) & 1 for i in range(n)]
+        if verify(inst, candidate)[0]:
+            count += 1
+    return count
+
+
+def _hypergraph_rows(inst: dict) -> list[tuple[int, int, int]]:
+    return [tuple(sorted((a, b, c))) for a, b, c, _ in _equations(inst)]
+
+
+def canonical_key(inst: dict) -> str:
+    """A relabeling/gauge-invariant codegree signature of the row hypergraph."""
+    n = inst["n"]
+    codegree = [[0] * n for _ in range(n)]
+    row_mult = Counter(_hypergraph_rows(inst))
+    for (a, b, c), multiplicity in row_mult.items():
+        codegree[a][b] += multiplicity
+        codegree[b][a] += multiplicity
+        codegree[a][c] += multiplicity
+        codegree[c][a] += multiplicity
+        codegree[b][c] += multiplicity
+        codegree[c][b] += multiplicity
+    pair_hist = Counter(
+        codegree[i][j] for i in range(n) for j in range(i + 1, n)
+    )
+    triangle_hist = Counter()
+    for i in range(n):
+        for j in range(i + 1, n):
+            cij = codegree[i][j]
+            for k in range(j + 1, n):
+                triangle_hist[tuple(sorted((cij, codegree[i][k], codegree[j][k])))] += 1
+    payload = {
+        "n": n,
+        "rows": sum(row_mult.values()),
+        "row_multiplicities": sorted(Counter(row_mult.values()).items()),
+        "pair_codegrees": sorted(pair_hist.items()),
+        "codegree_triangles": sorted((list(key), value) for key, value in triangle_hist.items()),
+    }
+    return hashlib.sha256(
+        json.dumps(payload, separators=(",", ":"), sort_keys=True).encode("ascii")
+    ).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Increase redundant row blocks at fixed certificate length first."""
+    out = {key: value for key, value in params.items() if key != "_preset"}
+    n = int(out["n"])
+    blocks = int(out.get("blocks", 1))
+    max_shapes = ((n - 1) * (n - 2)) // 6
+    if blocks < min(max_shapes, 512):
+        out["blocks"] = min(max_shapes, 512, max(blocks + 1, 2 * blocks))
+        return out
+    if n < 256:
+        out["n"] = 2 * n
+        out["blocks"] = min(out["blocks"], 512)
+        return out
+    return "cap_bound"
+
+
+def _reference_algorithm(inst: dict) -> tuple[object | None, dict[str, int]]:
+    """Complete sparse Gaussian elimination over GF(2)."""
+    n = inst["n"]
+    coeff_mask = (1 << n) - 1
+    basis = [0] * n
+    packed_xors = 0
+    pivot_tests = 0
+    rows = 0
+    inconsistent = False
+    for a, b, c, rhs in _equations(inst):
+        rows += 1
+        row = (1 << a) | (1 << b) | (1 << c) | (rhs << n)
+        while row & coeff_mask:
+            pivot = (row & coeff_mask).bit_length() - 1
+            pivot_tests += 1
+            if basis[pivot]:
+                row ^= basis[pivot]
+                packed_xors += 1
+            else:
+                basis[pivot] = row
+                break
+        if not (row & coeff_mask) and ((row >> n) & 1):
+            inconsistent = True
+            break
+    rank = sum(value != 0 for value in basis)
+    if inconsistent or rank < n:
+        return None, {
+            "rows": rows,
+            "rank": rank,
+            "packed_row_xors": packed_xors,
+            "pivot_tests": pivot_tests,
+            "scalar_bit_operations": packed_xors * (n + 1) + pivot_tests,
+        }
+    solution_mask = 0
+    solve_parities = 0
+    for pivot in range(n):
+        row = basis[pivot]
+        rhs = (row >> n) & 1
+        lower = row & ((1 << pivot) - 1)
+        value = rhs ^ _parity(lower & solution_mask)
+        solve_parities += 1
+        if value:
+            solution_mask |= 1 << pivot
+    answer = [(solution_mask >> i) & 1 for i in range(n)]
+    return answer, {
+        "rows": rows,
+        "rank": rank,
+        "packed_row_xors": packed_xors,
+        "pivot_tests": pivot_tests,
+        "solve_parities": solve_parities,
+        "scalar_bit_operations": packed_xors * (n + 1) + pivot_tests + solve_parities,
+    }
+
+
+def _compact_algorithm(inst: dict) -> tuple[list[int], int]:
+    """Undo one XOR translation through the quadratic ANF invariant."""
+    n = inst["n"]
+    k = inst["dimension"]
+    block = inst["blocks"][0]
+    values = [int(bit) for bit in block["rhs"]]
+    c_f = values[0]
+    linear_f = 0
+    for bit in range(k):
+        if values[1 << bit] ^ c_f:
+            linear_f |= 1 << bit
+    q_neighbors = [0] * k
+    q_pairs = []
+    for left in range(k):
+        for right in range(left + 1, k):
+            coefficient = (
+                values[(1 << left) | (1 << right)]
+                ^ values[1 << left]
+                ^ values[1 << right]
+                ^ c_f
+            )
+            if coefficient:
+                q_pairs.append((left, right))
+                q_neighbors[left] |= 1 << right
+                q_neighbors[right] |= 1 << left
+    translation = block["a"] ^ block["b"]
+    correction = 0
+    for bit in range(k):
+        if _parity(q_neighbors[bit] & translation):
+            correction |= 1 << bit
+    linear_x = linear_f ^ correction
+
+    def quadratic_only(index: int) -> int:
+        result = 0
+        for left, right in q_pairs:
+            result ^= ((index >> left) & 1) & ((index >> right) & 1)
+        return result
+
+    a, b = block["a"], block["b"]
+    c_x = (
+        c_f ^ quadratic_only(a) ^ quadratic_only(b)
+        ^ _parity(linear_x & a) ^ _parity(linear_x & b)
+    )
+    answer = [
+        _eval_quadratic(i, linear_x, tuple(q_pairs), c_x)
+        for i in range(n)
+    ]
+    pair_total = k * (k - 1) // 2
+    operations = 3 * pair_total + 2 * k + 6 + n
+    return answer, operations
+
+
+def _outlier_occurrence_attack(inst: dict) -> list[int]:
+    counts = [0] * inst["n"]
+    for a, b, c, _ in _equations(inst):
+        counts[a] += 1
+        counts[b] += 1
+        counts[c] += 1
+    median = sorted(counts)[len(counts) // 2]
+    return [int(value > median) for value in counts]
+
+
+def _copy_first_rhs_attack(inst: dict) -> list[int]:
+    return [int(bit) for bit in inst["blocks"][0]["rhs"]]
+
+
+def _majority_rhs_attack(inst: dict) -> list[int]:
+    n = inst["n"]
+    totals = [0] * n
+    for block in inst["blocks"]:
+        for index, bit in enumerate(block["rhs"]):
+            totals[index] += int(bit)
+    threshold = len(inst["blocks"]) / 2
+    return [int(total > threshold) for total in totals]
+
+
+def _affine_ansatz_attack(inst: dict) -> list[int]:
+    n, k = inst["n"], inst["dimension"]
+    rhs = inst["blocks"][0]["rhs"]
+    constant = int(rhs[0])
+    linear = 0
+    for bit in range(k):
+        if int(rhs[1 << bit]) ^ constant:
+            linear |= 1 << bit
+    return [constant ^ _parity(i & linear) for i in range(n)]
+
+
+def _greedy_one_pass_attack(inst: dict) -> list[int]:
+    n = inst["n"]
+    values: list[int | None] = [None] * n
+    values[0] = 0
+    for a, b, c, rhs in _equations(inst):
+        indices = (a, b, c)
+        missing = [index for index in indices if values[index] is None]
+        if len(missing) == 1:
+            target = missing[0]
+            value = rhs
+            for index in indices:
+                if index != target:
+                    value ^= int(values[index])
+            values[target] = value
+    return [0 if value is None else value for value in values]
+
+
+def _random_restart_succeeds(inst: dict, seed: int, restarts: int = 256) -> bool:
+    rng = random.Random(seed)
+    for _ in range(restarts):
+        if verify(inst, random_candidate(inst, rng))[0]:
+            return True
+    return False
+
+
+def _answer_atoms(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def _transform_for_g8(inst: dict, answer: list[int], seed: int) -> tuple[dict, list[int]]:
+    """Compose arbitrary renumbering, gauge flips, endpoint/row reordering."""
+    rng = random.Random(seed)
+    n = inst["n"]
+    permutation = list(range(n))
+    rng.shuffle(permutation)
+    gauge = [rng.getrandbits(1) for _ in range(n)]
+    equations = []
+    for a, b, c, rhs in _equations(inst):
+        row = [
+            permutation[a], permutation[b], permutation[c],
+            rhs ^ gauge[a] ^ gauge[b] ^ gauge[c],
+        ]
+        endpoints = row[:3]
+        rng.shuffle(endpoints)
+        equations.append(endpoints + [row[3]])
+    rng.shuffle(equations)
+    transformed = {
+        "family": inst["family"],
+        "n": n,
+        "dimension": inst["dimension"],
+        "blocks": [],
+        "equations": equations,
+        "equation_count": len(equations),
+        "nae3_row_count": 8 * len(equations),
+        "answer": [],
+    }
+    carried = [0] * n
+    for old in range(n):
+        carried[permutation[old]] = answer[old] ^ gauge[old]
+    return transformed, carried
+
+
+def selftest() -> dict:
+    """Run gates G1--G9 and return a JSON-native measured report."""
+    report: dict[str, Any] = {
+        "paper": "2510.15002",
+        "paper_version_read": "v2 (v3 is withdrawn)",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    verified = 0
+    json_roundtrips = 0
+    attempts = 0
+    for _, params in DIFFICULTY.items():
+        for seed in range(4):
+            inst = make_instance(seed=seed, **params)
+            attempts += 1
+            verified += int(verify(inst, inst["answer"])[0])
+            json_roundtrips += int(
+                json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            )
+    report["G1_planted_verifies"] = {
+        "pass": verified == attempts and json_roundtrips == attempts,
+        "verified": verified,
+        "attempts": attempts,
+        "json_roundtrips": json_roundtrips,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=20260905, **shipping_params)
+
+    planted = ship["answer"]
+    corruptions: list[tuple[str, object]] = [("empty", [])]
+    corruptions.append(("drop", planted[:-1]))
+    differing = next(
+        (j for j in range(1, len(planted)) if planted[j] != planted[0]), 1
+    )
+    swapped = planted[:]
+    swapped[0], swapped[differing] = swapped[differing], swapped[0]
+    corruptions.append(("swap", swapped))
+    corruptions.append(("duplicate", planted + [planted[-1]]))
+    out_of_range = planted[:]
+    out_of_range[0] = 2
+    corruptions.append(("out_of_range", out_of_range))
+    cases = {}
+    for name, candidate in corruptions:
+        ok, reason = verify(ship, candidate)
+        cases[name] = {"rejected": not ok, "reason": reason}
+    distinct_reasons = len({entry["reason"] for entry in cases.values()})
+    report["G2_rejects_corruption"] = {
+        "pass": all(entry["rejected"] for entry in cases.values())
+        and distinct_reasons == len(cases),
+        "rejected": sum(entry["rejected"] for entry in cases.values()),
+        "attempts": len(cases),
+        "distinct_reasons": distinct_reasons,
+        "cases": cases,
+    }
+
+    body = _format_answer(planted)
+    replies = [
+        f"I used the row invariant.\n<answer>{body}</answer>\nDone.",
+        f"Result:\n<answer>```text\n{body}\n```</answer>",
+        f"prose before <answer>  {json.dumps(planted)}  </answer> prose after",
+    ]
+    parsed = sum(parse_answer(reply) == planted for reply in replies)
+    garbage_rejected = parse_answer("there is no tagged vector") is None
+    report["G3_round_trip"] = {
+        "pass": parsed == len(replies) and garbage_rejected,
+        "parsed": parsed,
+        "attempts": len(replies),
+        "garbage_rejected": garbage_rejected,
+    }
+
+    guess_rng = random.Random(0x251015002)
+    hits = 0
+    started = time.perf_counter()
+    for _ in range(_G4_SAMPLES):
+        hits += int(verify(ship, random_candidate(ship, guess_rng))[0])
+    sampling_seconds = time.perf_counter() - started
+    observed = hits / _G4_SAMPLES
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6,
+        "hits": hits,
+        "total": _G4_SAMPLES,
+        "observed_probability": observed,
+        "exact_probability": 1 / search_space(ship),
+        "search_space": search_space(ship),
+        "sampling_seconds": round(sampling_seconds, 6),
+        "prior": "uniform over all exact-length Boolean armature vectors",
+    }
+
+    ref_started = time.perf_counter()
+    reference_answer, reference_metrics = _reference_algorithm(ship)
+    reference_seconds = time.perf_counter() - ref_started
+    reference_ok = (
+        reference_answer is not None and verify(ship, reference_answer)[0]
+    )
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": reference_ok and demo_count == 1 and _G4_SAMPLES >= 200_000,
+        "shipping_density_hits": hits,
+        "shipping_density_samples": _G4_SAMPLES,
+        "shipping_density_estimate": observed,
+        "shipping_exact_solution_count": None,
+        "theorem_backed_shipping_solution_count": 1,
+        "demo_exact_solution_count": demo_count,
+        "demo_n": demo["n"],
+        "baseline_wall_seconds": round(reference_seconds, 6),
+        "baseline_packed_row_xors": reference_metrics["packed_row_xors"],
+        "baseline_scalar_bit_operations": reference_metrics["scalar_bit_operations"],
+        "baseline_solved": reference_ok,
+    }
+
+    attack_names = [
+        "outlier_occurrence_frequency",
+        "greedy_one_pass_propagation",
+        "random_restart_256",
+        "copy_first_truth_table",
+        "bitwise_majority_of_blocks",
+        "affine_only_ansatz",
+    ]
+    attack_results = {
+        name: {"successes": 0, "attempts": _ATTACK_SEEDS}
+        for name in attack_names
+    }
+    ref_successes = 0
