+def _nae3(left: int, middle: int, right: int) -> bool:
+    return not (left == middle == right)
+
+
+def _expanded_nae4_aux(literals: tuple[int, int, int, int]) -> int | None:
+    """Canonical auxiliary for the standard two-clause NAE-4 expansion."""
+    l0, l1, l2, l3 = literals
+    if l0 == l1:
+        candidates = (1 - l0,)
+    elif l2 == l3:
+        candidates = (l2,)
+    else:
+        candidates = (0,)
+    for auxiliary in candidates:
+        if _nae3(l0, l1, auxiliary) and _nae3(
+            1 - auxiliary, l2, l3
+        ):
+            return auxiliary
+    return None
+
+
+def _parity_gadget_accepts(bits: tuple[int, int, int]) -> bool:
+    """Whether all four expanded NAE clauses accept an XOR-zero triple."""
+    for wrong in range(8):
+        if _parity(wrong) != 1:
+            continue
+        toggles = tuple((wrong >> bit) & 1 for bit in range(3))
+        literals = (
+            bits[0] ^ toggles[0],
+            bits[1] ^ toggles[1],
+            bits[2] ^ toggles[2],
+            0,
+        )
+        if _expanded_nae4_aux(literals) is None:
+            return False
+    return True
+
