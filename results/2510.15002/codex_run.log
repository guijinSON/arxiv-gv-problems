   760	def _linear_map_table(k: int, rng: random.Random) -> list[int]:
   761	    operations = []
   762	    for _ in range(5 * k):
   763	        left, right = rng.sample(range(k), 2)
   764	        operations.append((rng.getrandbits(1), left, right))
   765	    table = []
   766	    for value in range(1 << k):
   767	        mapped = value
   768	        for kind, left, right in operations:
   769	            left_bit = (mapped >> left) & 1
   770	            right_bit = (mapped >> right) & 1
   771	            if kind == 0:
   772	                if left_bit != right_bit:
   773	                    mapped ^= (1 << left) | (1 << right)
   774	            elif right_bit:
   775	                mapped ^= 1 << left
   776	        table.append(mapped)
   777	    return table
   778	
