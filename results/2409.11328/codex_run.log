   631	def _compact_transport(inst):
   632	    q = inst["profile_graphs"]
   633	    n = inst["n"]
   634	    reference_profiles = [
   635	        tuple(len(inst["pairs"][j]["reference"][v]) for j in range(q))
   636	        for v in range(n)
   637	    ]
   638	    target_profiles = {
   639	        tuple(len(inst["pairs"][j]["target"][v]) for j in range(q)): v
   640	        for v in range(n)
   641	    }
   642	    mapping = {v: target_profiles[profile]
   643	               for v, profile in enumerate(reference_profiles)}
   644	    return _encode_vertices(inst, [
   645	        mapping[pair["reference_move"]] for pair in inst["pairs"]
   646	    ])
