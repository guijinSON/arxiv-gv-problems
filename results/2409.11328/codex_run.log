+    if any(pair["reference_move"] not in mapping for pair in inst["pairs"]):
+        return inst["alphabet"][0] * inst["games"]
+    return _encode_vertices(inst, [
+        mapping[pair["reference_move"]] for pair in inst["pairs"]
+    ])
