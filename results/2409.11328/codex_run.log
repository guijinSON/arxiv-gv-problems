+def _attack_random_restart(inst, rng, restarts, valid_sets):
+    last = inst["alphabet"][0] * inst["games"]
+    for _ in range(restarts):
+        last = random_candidate(inst, rng)
+        if _candidate_fast(inst, last, valid_sets):
+            return last
+    return last
