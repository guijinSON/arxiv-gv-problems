   169	        r_set = set(vertices[a_size:-3])
   170	        if not r_set:
   171	            continue
   172	
   173	        adj = [set() for _ in range(n)]
   174	        for a in a_set:
   175	            _add_edge(adj, planted, a)
   176	        c_list = sorted(c_set)
   177	        for i, x in enumerate(c_list):
   178	            for y in c_list[i + 1:]:
   179	                _add_edge(adj, x, y)
   180	
   181	        for r_vertex in r_set:
   182	            n_a = 1 if len(a_set) == 3 else rng.choice((1, 1, 2))
   183	            for a in rng.sample(sorted(a_set), n_a):
   184	                _add_edge(adj, r_vertex, a)
   185	            missed = rng.choice([None] + c_list)
   186	            for c in c_list:
   187	                if c != missed:
   188	                    _add_edge(adj, r_vertex, c)
   189	
   190	        for group, probability in ((a_set, 0.25), (r_set, 0.16)):
   191	            ordered = sorted(group)
   192	            for i, x in enumerate(ordered):
   193	                for y in ordered[i + 1:]:
   194	                    if rng.random() < probability:
   195	                        _add_edge(adj, x, y)
   196	        for a in a_set:
   197	            for r_vertex in r_set:
   198	                if r_vertex not in adj[a] and rng.random() < 0.08:
   199	                    _add_edge(adj, a, r_vertex)
   200	
   201	        degrees = [len(row) for row in adj]
   202	        planted_degree = degrees[planted]
   203	        if max(degrees) > n - 3:
   204	            continue
   205	        if degrees.count(planted_degree) < 3:
   206	            continue
   207	        if not min(degrees) < planted_degree < max(degrees):
   208	            continue
   209	        graph = [sorted(row) for row in adj]
   210	        if not _prop10_winner(graph, planted):
   211	            raise AssertionError("inverse construction violated Proposition 10")
   212	        return graph
   213	    raise RuntimeError("could not draw a degree-balanced inverse graph")
   214	
