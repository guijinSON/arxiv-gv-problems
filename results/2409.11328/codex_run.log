   221	def _derangement(n, rng):
   222	    # Sattolo's algorithm: a uniformly generated single cycle, hence no fixed point.
   223	    permutation = list(range(n))
   224	    for i in range(n - 1, 0, -1):
   225	        j = rng.randrange(i)
   226	        permutation[i], permutation[j] = permutation[j], permutation[i]
   227	    return permutation
   228	
