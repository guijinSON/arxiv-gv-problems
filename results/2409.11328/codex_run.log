   610	def _reference_algorithm(inst):
   611	    """The paper's direct polynomial characterization scan."""
   612	    answer = []
   613	    operations = [0]
   614	    candidates_tested = 0
   615	    for pair in inst["pairs"]:
   616	        found = None
   617	        for vertex in range(inst["n"]):
   618	            candidates_tested += 1
   619	            if _prop10_winner(pair["target"], vertex, operations):
   620	                found = vertex
   621	                break
   622	        if found is None:
   623	            return None, {"operations": operations[0], "candidates_tested": candidates_tested}
   624	        answer.append(found)
   625	    return _encode_vertices(inst, answer), {
   626	        "operations": operations[0],
   627	        "candidates_tested": candidates_tested,
   628	    }
