   649	def _transformed_instance(inst, seed, reorder=True):
   650	    """Apply independent legal graph relabellings and carry the witness."""
   651	    rng = random.Random(seed)
   652	    old_values = [_ALPHABET.index(symbol) for symbol in inst["answer"]]
   653	    records = []
   654	    for index, pair in enumerate(inst["pairs"]):
   655	        reference_permutation = list(range(inst["n"]))
   656	        target_permutation = list(range(inst["n"]))
   657	        rng.shuffle(reference_permutation)
   658	        rng.shuffle(target_permutation)
   659	        records.append((
   660	            {
   661	                "reference": _relabel_graph(pair["reference"], reference_permutation),
   662	                "reference_move": reference_permutation[pair["reference_move"]],
   663	                "target": _relabel_graph(pair["target"], target_permutation),
   664	            },
   665	            target_permutation[old_values[index]],
   666	        ))
   667	    if reorder:
   668	        rng.shuffle(records)
   669	    transformed = dict(inst)
   670	    transformed["pairs"] = [record[0] for record in records]
   671	    transformed["answer"] = _encode_vertices(inst, [record[1] for record in records])
   672	    return transformed
