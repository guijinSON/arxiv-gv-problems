     2	# Submit a finished paper.  Usage: scripts/submit.sh <arxiv_id>
     3	set -uo pipefail
     4	cd "$(dirname "$0")/.." || exit 1
     5	ID="${1:?usage: scripts/submit.sh <arxiv_id> [--reject]}"
     6	REJECT=""; [ "${2:-}" = "--reject" ] && REJECT=1
