   359	def parse_answer(text):
   360	    """Extract a word answer from prose and optional Markdown fences."""
   361	    if not isinstance(text, str):
   362	        return None
   363	    match = re.search(r"<answer\b[^>]*>(.*?)</answer\s*>", text, re.I | re.S)
   364	    if not match:
   365	        return None
   366	    body = match.group(1).strip()
   367	    fence = re.fullmatch(r"```(?:text|plain|plaintext)?\s*(.*?)\s*```", body, re.I | re.S)
   368	    if fence:
   369	        body = fence.group(1).strip()
   370	    if not body or re.search(r"\s", body):
   371	        return None
   372	    return body
