"""Locally verified Track-B problem generator for arXiv:2409.11328, *Burning game*.

The family uses Proposition 10's exact characterization of three-round Burner
first moves.  It inverse-generates marked reference games with a unique winning
first move, applies one hidden vertex relabelling to all of them, and asks for
valid first moves in the relabeled games.  The carried moves are known by
construction; generation never searches a generated target for a solution.
"""

from __future__ import annotations

import hashlib
import json
import os
import random
import re
import time
from collections import Counter


TRACK = "B"

PROBLEM_PROFILE = {
