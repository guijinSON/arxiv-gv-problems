+        for tag, pair in zip(pair_tags, pairs):
+            graph = pair[side]
+            profile.append((tag, len(graph[vertex]), _triangle_count_at(graph, vertex)))
+        profiles.append(sorted(profile))
+    return sorted(profiles)
