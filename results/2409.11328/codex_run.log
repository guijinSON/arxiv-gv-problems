   460	def _wl_fingerprint(graph, root=None):
   461	    """A strong cheap relabelling invariant, not a complete GI canonical form."""
   462	    n = len(graph)
   463	    adjacency = [set(row) for row in graph]
   464	    colors = [(int(v == root), len(adjacency[v])) for v in range(n)]
   465	    history = []
   466	    for _ in range(n):
   467	        signatures = [
   468	            (colors[v], tuple(sorted(colors[w] for w in adjacency[v])))
   469	            for v in range(n)
   470	        ]
   471	        palette = {signature: i for i, signature in enumerate(sorted(set(signatures)))}
   472	        new_colors = [palette[signature] for signature in signatures]
   473	        history.append(tuple(sorted(Counter(new_colors).items())))
   474	        if new_colors == colors:
   475	            break
   476	        colors = new_colors
   477	    degrees = [len(row) for row in adjacency]
   478	    triangles = []
   479	    for v in range(n):
   480	        triangles.append(sum(1 for x in adjacency[v] for y in adjacency[v]
   481	                             if x < y and y in adjacency[x]))
   482	    edge_colors = sorted(
   483	        (min(colors[x], colors[y]), max(colors[x], colors[y]))
   484	        for x in range(n) for y in adjacency[x] if x < y
   485	    )
   486	    vertex_data = sorted((colors[v], degrees[v], triangles[v]) for v in range(n))
   487	    return [n, history, vertex_data, edge_colors]
   488	
