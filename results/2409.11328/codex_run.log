+            choices = [
+                other for other in active
+                if other != vertex and other not in adjacency[vertex]
+            ]
+            if not choices:
+                return None
+            rng.shuffle(choices)
+            choices_by_vertex.append((len(choices), vertex, choices))
+        _, vertex, choices = min(choices_by_vertex, key=lambda row: (row[0], row[1]))
