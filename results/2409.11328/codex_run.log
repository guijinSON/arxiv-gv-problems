import random
import gen_2409_11328 as m

def overlay(gs,rng):
 n=len(gs[0]); cand=[]
 for x in range(n):
  for y in range(x+1,n):
   if all(y not in g[x] for g in gs):cand.append((x,y))
 rng.shuffle(cand);d=[0]*n;e=[]
 for x,y in cand:
  if d[x]>=4 or d[y]>=4:continue
  if any(len(g[x])+d[x]+1>n-3 or len(g[y])+d[y]+1>n-3 for g in gs):continue
  e.append((x,y));d[x]+=1;d[y]+=1
  if len(e)>=n:break
 return e,d
for n in (14,18,24,31,34,40,42,44):
 vals=[];extra=[]
 for seed in range(30):
  # use valid q4 old build, even n custom
  m._validate_parameters=lambda n,games,profile_graphs: None
  i=m.make_instance(n=n,games=48 if n>14 else 4,profile_graphs=4,seed=10000+n*100+seed)
  gs=[i['pairs'][j]['reference'] for j in range(4)]
  e,d=overlay(gs,random.Random(seed+77))
  good=len(e)>=n
  counts=[]
  for j,g in enumerate(gs):
   a=[set(x) for x in g]
   for x,y in e:a[x].add(y);a[y].add(x)
   gg=[sorted(x) for x in a]
   p=i['pairs'][j]['reference_move']
   good &= m._prop10_winner(gg,p)
   counts.append(sum(m._prop10_winner(gg,v) for v in range(n)))
  vals.append(good);extra.extend(counts)
 print(n,sum(vals),'/',len(vals),'winner counts',min(extra),max(extra),sum(extra)/len(extra))
