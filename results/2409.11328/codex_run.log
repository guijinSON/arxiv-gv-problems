   590	def _attack_cyclic_shift(inst):
   591	    first = inst["pairs"][0]
   592	    wanted = len(first["reference"][first["reference_move"]])
   593	    candidates = [v for v in range(inst["n"]) if len(first["target"][v]) == wanted]
   594	    image = candidates[0] if candidates else 0
   595	    shift = (image - first["reference_move"]) % inst["n"]
   596	    return _encode_vertices(inst, [
   597	        (pair["reference_move"] + shift) % inst["n"] for pair in inst["pairs"]
   598	    ])
