   601	def _attack_random_restart(inst, rng, restarts, valid_sets):
   602	    last = inst["alphabet"][0] * inst["games"]
   603	    for _ in range(restarts):
   604	        last = random_candidate(inst, rng)
   605	        if _candidate_fast(inst, last, valid_sets):
   606	            return last
   607	    return last
