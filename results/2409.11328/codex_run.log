   166	# --- the oracle call --------------------------------------------------------
   167	def _ask_blocking(model, prompt, key):
   168	    """Return (reply_text, http_status, finish_reason, error, empty).
   169	
   170	    Exactly one of reply/error is set.  An empty body is NOT an API error: it is
   171	    flagged via `empty`, and attempt() scores it as an unsolved attempt.  A model
   172	    that spends its whole budget on reasoning and emits nothing did not produce a
   173	    witness under the conditions the pool is measured at, so it consumes its slot
   174	    rather than being redrawn.  The diagnostic is preserved in verify_reason so a
   175	    level hardened this way can still be told apart from one hardened on wrong
   176	    answers -- if ORACLE_MAX_TOKENS is the real constraint, raise it and re-run.
   177	
   178	    Every model in the default pool accepts OpenRouter's normalised `reasoning`
   179	    field, so no per-vendor body mapping is needed.  A model that rejects it is
   180	    reported as an error rather than silently retried without it — dropping the
   181	    effort setting would change what the hardness claim means.
   182	    """
   183	    body = json.dumps({
   184	        "model": model,
   185	        "reasoning": {"effort": ORACLE_EFFORT},
   186	        "messages": [{"role": "user", "content": prompt}],
   187	        "max_tokens": MAX_TOKENS,
   188	    }).encode()
   189	    req = urllib.request.Request(
   190	        ENDPOINT, data=body,
   191	        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
   192	    )
   193	    try:
   194	        with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT,
   195	                                    context=SSL_CONTEXT) as resp:
   196	            status = resp.status
   197	            payload = json.loads(resp.read().decode())
   198	    except urllib.error.HTTPError as e:
   199	        return None, e.code, None, f"http {e.code}: {e.read()[:400].decode('utf-8', 'replace')}", False
   200	    except Exception as e:                                    # noqa: BLE001
   201	        return None, None, None, f"{type(e).__name__}: {e}", False
   202	    try:
   203	        choice = payload["choices"][0]
   204	        text = choice["message"]["content"]
   205	        finish = choice.get("finish_reason") or choice.get("native_finish_reason")
   206	    except (KeyError, IndexError, TypeError):
   207	        return None, status, None, f"unparseable response: {json.dumps(payload)[:400]}", False
   208	    if not (text or "").strip():
   209	        usage = payload.get("usage") or {}
   210	        return None, status, finish, (
   211	            f"empty reply (finish_reason={finish}, usage={json.dumps(usage)[:160]}) — "
   212	            f"the model returned no content, most likely because reasoning consumed "
   213	            f"max_tokens={MAX_TOKENS}; raise ORACLE_MAX_TOKENS"), True
   214	    return text, status, finish, None, False
