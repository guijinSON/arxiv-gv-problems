   408	def verify(inst, answer):
   409	    """Accept every word whose characters are valid Proposition-10 witnesses."""
   410	    if not isinstance(answer, str):
   411	        return False, "answer must be a string in the stated vertex alphabet"
   412	    if not answer:
   413	        return False, "answer is empty"
   414	    expected = inst["games"]
   415	    if len(answer) < expected:
   416	        return False, f"answer has too few symbols: expected {expected}"
   417	    if len(answer) > expected:
   418	        return False, f"answer has too many symbols: expected {expected}"
   419	    alphabet = inst["alphabet"]
   420	    lookup = {symbol: value for value, symbol in enumerate(alphabet)}
   421	    for index, symbol in enumerate(answer):
   422	        if symbol not in lookup:
   423	            if symbol in _ALPHABET:
   424	                return False, f"symbol {index} names a vertex outside 0..{inst['n'] - 1}"
   425	            return False, f"symbol {index} is not in the stated alphabet"
   426	        vertex = lookup[symbol]
   427	        if not _prop10_winner(inst["pairs"][index]["target"], vertex):
   428	            return False, f"entry {index} is not a three-round winning first move"
   429	    return True, "ok"
