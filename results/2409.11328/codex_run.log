   490	def canonical_key(inst):
   491	    """Invariant under pair order and independent vertex renumberings."""
   492	    pair_keys = []
   493	    for pair in inst["pairs"]:
   494	        pair_keys.append([
   495	            _wl_fingerprint(pair["reference"], pair["reference_move"]),
   496	            _wl_fingerprint(pair["target"], None),
   497	        ])
   498	    pair_blobs = sorted(json.dumps(key, separators=(",", ":")) for key in pair_keys)
   499	    payload = json.dumps({"n": inst["n"], "pairs": pair_blobs}, separators=(",", ":"))
   500	    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
