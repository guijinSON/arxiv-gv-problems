+            signature: index
+            for index, signature in enumerate(sorted(set(signatures)))
+        }
+        new_colors = [palette[signature] for signature in signatures]
+        if operations is not None:
+            operations[0] += n
+        rounds += 1
+        if new_colors == colors:
+            break
+        colors = new_colors
+    return colors, rounds
+
