   230	def _relabel_graph(graph, permutation):
   231	    n = len(graph)
   232	    relabeled = [[] for _ in range(n)]
   233	    for old, row in enumerate(graph):
   234	        relabeled[permutation[old]] = sorted(permutation[v] for v in row)
   235	    return relabeled
