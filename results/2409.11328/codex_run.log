   375	def _prop10_winner(graph, vertex, operations=None):
   376	    """Executable form of Proposition 10; graph is assumed simple."""
   377	    n = len(graph)
   378	    if operations is not None:
   379	        operations[0] += n
   380	    if max(len(row) for row in graph) > n - 3:
   381	        return False
   382	    adjacency = [set(row) for row in graph]
   383	    closed = set(adjacency[vertex])
   384	    closed.add(vertex)
   385	    distance_two = set(closed)
   386	    for x in closed:
   387	        if operations is not None:
   388	            operations[0] += len(adjacency[x])
   389	        distance_two.update(adjacency[x])
   390	    outside_closed = set(range(n)) - closed
   391	    far = set(range(n)) - distance_two
   392	    for x in outside_closed:
   393	        misses = 0
   394	        for y in far:
   395	            if operations is not None:
   396	                operations[0] += 1
   397	            # Staller has just selected x, so x itself is already burned.  The
   398	            # proof of Proposition 10 therefore tests the remaining vertices
   399	            # against the closed neighborhood N[x], even though the statement
   400	            # abbreviates this as "x is adjacent to all but at most one".
   401	            if y != x and y not in adjacency[x]:
   402	                misses += 1
   403	                if misses > 1:
   404	                    return False
   405	    return True
   406	
