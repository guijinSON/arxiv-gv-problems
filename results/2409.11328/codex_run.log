def colors(g):
    n=len(g)
    c=[len(row) for row in g]
    for _ in range(n):
        sig=[(c[v], tuple(sorted(c[w] for w in g[v]))) for v in range(n)]
        palette={s:i for i,s in enumerate(sorted(set(sig)))}
        nc=[palette[s] for s in sig]
        if nc==c:
            break
        c=nc
    return c

