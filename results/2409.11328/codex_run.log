   450	def enumerate_all(inst):
   451	    """Count component witnesses exactly, then compose the independent counts."""
   452	    if inst["games"] * inst["n"] > 20_000:
   453	        return None
   454	    total = 1
   455	    for valid in _valid_vertex_sets(inst):
   456	        total *= len(valid)
   457	    return total
