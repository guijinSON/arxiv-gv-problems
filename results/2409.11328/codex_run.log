   680	def selftest():
   681	    report = {
   682	        "paper": "arXiv:2409.11328",
   683	        "track": TRACK,
   684	        "shipping_difficulty": SHIPPING_DIFFICULTY,
   685	        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
   686	    }
   687	
   688	    failures = []
   689	    attempts = 0
   690	    demo_tree_checks = 0
   691	    for preset, parameters in DIFFICULTY.items():
   692	        for seed in (0, 1, 7):
   693	            inst = make_instance(seed=seed, **parameters)
   694	            ok, reason = verify(inst, inst["answer"])
   695	            attempts += 1
   696	            if not ok:
   697	                failures.append({"preset": preset, "seed": seed, "reason": reason})
   698	            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
   699	                failures.append({"preset": preset, "seed": seed,
   700	                                 "reason": "answer is not JSON-native"})
   701	            if preset == "demo":
