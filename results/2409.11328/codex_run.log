+        candidates = []
+        for vertex, color in enumerate(target_colors):
+            operations[0] += 1
+            if color == wanted:
+                candidates.append(vertex)
+        if len(candidates) != 1:
+            return None, {
+                "operations": operations[0],
+                "refinement_rounds": total_rounds,
+            }
+        answer.append(candidates[0])
+    return _encode_vertices(inst, answer), {
+        "operations": operations[0],
+        "refinement_rounds": total_rounds,
+    }
+
