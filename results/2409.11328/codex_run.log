   238	def make_instance(n, seed=0, games=100, profile_graphs=3, **params):
   239	    """Inverse-generate reference games and carry witnesses through relabelling."""
   240	    if params:
   241	        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
   242	    _validate_parameters(n, games, profile_graphs)
   243	    if not _is_int(seed):
   244	        raise ValueError("seed must be an integer")
   245	    rng = random.Random(seed)
   246	
   247	    # The first q graphs are calibration layers.  Their cross-layer degree tuples
   248	    # are required to be unique; this filters an input invariant, not a solution.
   249	    for _ in range(10_000):
   250	        first_moves = [rng.randrange(n) for _ in range(profile_graphs)]
   251	        first_graphs = [
   252	            _one_inverse_graph(n, move, rng) for move in first_moves
   253	        ]
   254	        if len(set(_degree_profiles(first_graphs, profile_graphs))) == n:
   255	            break
   256	    else:
   257	        raise RuntimeError("could not generate unique cross-game degree profiles")
   258	
   259	    reference_moves = list(first_moves)
   260	    reference_graphs = list(first_graphs)
   261	    for _ in range(profile_graphs, games):
   262	        move = rng.randrange(n)
   263	        reference_moves.append(move)
   264	        reference_graphs.append(_one_inverse_graph(n, move, rng))
   265	
   266	    permutation = _derangement(n, rng)
   267	    pairs = []
   268	    answer_symbols = []
   269	    for graph, move in zip(reference_graphs, reference_moves):
   270	        pairs.append({
   271	            "reference": graph,
   272	            "reference_move": move,
   273	            "target": _relabel_graph(graph, permutation),
   274	        })
   275	        answer_symbols.append(_ALPHABET[permutation[move]])
   276	
   277	    edge_count = sum(sum(len(row) for row in graph) // 2 for graph in reference_graphs)
   278	    inst = {
   279	        "paper": "arXiv:2409.11328",
   280	        "family": "transported three-round Burner first moves",
   281	        "n": n,
   282	        "games": games,
   283	        "profile_graphs": profile_graphs,
   284	        "alphabet": _ALPHABET[:n],
   285	        "pairs": pairs,
   286	        "logical_vertices": 2 * games * n,
   287	        "undirected_edges_across_reference_and_target": 2 * edge_count,
   288	        "answer": "".join(answer_symbols),
   289	    }
   290	    return inst
   291	
