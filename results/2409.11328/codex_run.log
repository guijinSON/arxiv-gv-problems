                inst=m.make_instance(n=n,games=48,profile_graphs=q,seed=50000+100*n+seed)
                ok += bool(m.verify(inst,inst['answer'])[0])
                times.append(time.perf_counter()-t)
            except (RuntimeError,AssertionError,ValueError):
                pass
        print({'q':q,'n':n,'built':ok,'mean_sec':round(sum(times)/len(times),4) if times else None})
