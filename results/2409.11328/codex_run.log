+
+def _validate_parameters(n, games, profile_graphs):
+    if not _is_int(n) or not 8 <= n <= len(_ALPHABET):
+        raise ValueError("n must be an integer from 8 through 64")
+    if not _is_int(games) or games < 1 or games > 256:
+        raise ValueError("games must be an integer from 1 through 256")
+    if not _is_int(profile_graphs) or not 1 <= profile_graphs <= games:
+        raise ValueError("profile_graphs must be between 1 and games")
