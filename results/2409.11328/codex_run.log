   549	def _candidate_fast(inst, word, valid_sets):
   550	    if not isinstance(word, str) or len(word) != inst["games"]:
   551	        return False
   552	    lookup = {symbol: value for value, symbol in enumerate(inst["alphabet"])}
   553	    for symbol, valid in zip(word, valid_sets):
   554	        value = lookup.get(symbol)
   555	        if value is None or value not in valid:
   556	            return False
   557	    return True
