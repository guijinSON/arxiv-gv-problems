   560	def _attack_degree_extreme(inst):
   561	    vertices = []
   562	    for pair in inst["pairs"]:
   563	        degrees = [len(row) for row in pair["target"]]
   564	        median = sorted(degrees)[len(degrees) // 2]
   565	        vertices.append(max(range(inst["n"]), key=lambda v: (abs(degrees[v] - median), -v)))
   566	    return _encode_vertices(inst, vertices)
