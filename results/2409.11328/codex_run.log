import time
import gen_2409_11328 as m

def colors(g):
    n=len(g); ops=n
    c=[len(row) for row in g]
    rounds=0
    for _ in range(n):
        sig=[]
        for v in range(n):
            ops += 1 + len(g[v])
            sig.append((c[v], tuple(sorted(c[w] for w in g[v]))))
        palette={s:i for i,s in enumerate(sorted(set(sig)))}
        nc=[palette[s] for s in sig]
        ops += n
        rounds += 1
        if nc==c: break
        c=nc
    return c,ops,rounds

allops=[]; allround=[]; elapsed=[]
for seed in range(8100,8108):
    inst=m.make_instance(seed=seed, **m.DIFFICULTY[m.SHIPPING_DIFFICULTY])
    t=time.perf_counter(); total=0; rounds=0; ans=[]
    for p in inst['pairs']:
        cr,o,r=colors(p['reference']); total+=o; rounds+=r
        ct,o,r=colors(p['target']); total+=o; rounds+=r
        wanted=cr[p['reference_move']]
        total += len(ct)
        cand=[v for v,x in enumerate(ct) if x==wanted]
        ans.append(cand[0] if len(cand)==1 else 0)
    word=''.join(inst['alphabet'][v] for v in ans)
    elapsed.append(time.perf_counter()-t); allops.append(total); allround.append(rounds)
    assert m.verify(inst,word)[0]
print({'operations_mean':sum(allops)//8,'min':min(allops),'max':max(allops),'refinement_rounds_mean':sum(allround)/8,'wall_mean':sum(elapsed)/8})
