   526	def _explicit_game_tree_winner(graph, first_move):
   527	    """Directly audit all of Staller's round-2 replies for a demo cross-check."""
   528	    n = len(graph)
   529	    adjacency = [set(row) for row in graph]
   530	    burned_after_spread_two = {first_move} | adjacency[first_move]
   531	    replies = set(range(n)) - burned_after_spread_two
   532	    if not replies:
   533	        return True
   534	    for reply in replies:
   535	        burned = set(burned_after_spread_two)
   536	        burned.add(reply)
   537	        after_spread_three = set(burned)
   538	        for x in burned:
   539	            after_spread_three.update(adjacency[x])
   540	        if n - len(after_spread_three) > 1:
   541	            return False
   542	    return True
