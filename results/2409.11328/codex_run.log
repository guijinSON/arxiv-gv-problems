   577	    vertices = []
   578	    for pair in inst["pairs"]:
   579	        wanted = len(pair["reference"][pair["reference_move"]])
   580	        candidates = [v for v in range(inst["n"])
   581	                      if len(pair["target"][v]) == wanted]
   582	        vertices.append(candidates[0] if candidates else 0)
   583	    return _encode_vertices(inst, vertices)
