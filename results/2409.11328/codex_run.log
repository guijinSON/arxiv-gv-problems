   217	def ask(model, prompt, key):
   218	    """_ask_blocking under a hard wall-clock deadline.
   219	
   220	    A deadline overrun is reported as an ERROR, not a failure to solve: the model
   221	    never got to answer, so scoring it as unsolved would manufacture hardness out
   222	    of a hung socket.  attempt() redraws against a different vendor.
   223	    """
   224	    box = {}
   225	
   226	    def run():
   227	        try:
   228	            box["v"] = _ask_blocking(model, prompt, key)
   229	        except Exception as e:                                # noqa: BLE001
   230	            box["v"] = (None, None, None, f"{type(e).__name__}: {e}", False)
   231	
   232	    # daemon=True matters: a wedged socket must not keep the interpreter alive at
   233	    # exit, which is exactly what a ThreadPoolExecutor worker would do.
   234	    t = threading.Thread(target=run, daemon=True, name=f"oracle-{model}")
   235	    t.start()
   236	    t.join(TOTAL_DEADLINE)
   237	    if t.is_alive():
   238	        return (None, None, None,
   239	                f"total deadline exceeded: no complete response in {TOTAL_DEADLINE}s",
   240	                False)
   241	    return box.get("v", (None, None, None, "worker produced no result", False))
