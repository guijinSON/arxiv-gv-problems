   503	def escalate(params):
   504	    """Increase the vertex haystack while retaining a 100-symbol witness."""
   505	    current = dict(params)
   506	    n = int(current["n"])
   507	    if n < 17:
   508	        current["n"] = 17
   509	        current["profile_graphs"] = 4
   510	        return current
   511	    if n < 23:
   512	        current["n"] = 23
   513	        current["profile_graphs"] = 3
   514	        return current
   515	    if n < 31:
   516	        current["n"] = 31
   517	        current["profile_graphs"] = 3
   518	        return current
   519	    if n < 33:
   520	        current["n"] = 33
   520	        current["n"] = 33
   521	        current["profile_graphs"] = 3
   522	        return current
   523	    return None
