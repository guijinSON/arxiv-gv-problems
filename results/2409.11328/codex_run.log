            vj = _ALPHABET.index(planted[j])
            if vi != vj and (vj not in valid_sets[i] or vi not in valid_sets[j]):
                swap_pair = (i, j)
                break
        if swap_pair:
            break
    if swap_pair is None:
        raise AssertionError("could not form a rejected swap corruption")
    swapped = list(planted)
