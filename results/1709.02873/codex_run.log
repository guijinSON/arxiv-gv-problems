+    d0, d1 = _base_determinant(q, inst["m"])
+    bound = abs(d0) + q * abs(d1)
+    for term in inst["phases"]:
+        a, b, _ = term["phase"]
+        bound *= abs(a) + q * abs(b)
+    return bound
+
