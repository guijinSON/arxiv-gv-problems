+def _spectral_determinant(q, m):
+    """Mechanical tensor-character evaluation and its ring-step count."""
+    det = (1, 0)
+    steps = 0
+    for frequency in itertools.product(range(q), repeat=m):
+        j = (1, 0)
+        a = (1, 0)
+        for digit in frequency:
