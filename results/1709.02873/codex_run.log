+            "side": side,
+            "position": position,
+            "phase": _phase_triple(q, u, orientation),
+        })
+
+    inst = {
+        "q": q,
+        "m": n,
+        "order": q ** n,
+        "row_map": row_map,
+        "column_map": column_map,
+        "phases": phases,
