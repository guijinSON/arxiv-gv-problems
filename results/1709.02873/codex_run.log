+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer object is empty"
+    if set(answer) != {"minpoly", "interval"}:
+        return False, "answer must contain minpoly and interval only"
+
+    poly = answer["minpoly"]
