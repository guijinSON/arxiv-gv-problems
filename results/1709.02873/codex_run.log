+# Elements a+b*s are pairs (a,b), with s^2=-q.
+def _pair_add(x, y):
+    return (x[0] + y[0], x[1] + y[1])
+
+
+def _pair_neg(x):
+    return (-x[0], -x[1])
+
+
+def _pair_mul(x, y, q):
+    return (x[0] * y[0] - q * x[1] * y[1],
+            x[0] * y[1] + x[1] * y[0])
+
+
+def _pair_s_mul(x, q):
+    return (-q * x[1], x[0])
+
+
+def _pair_pow(x, exponent, q):
