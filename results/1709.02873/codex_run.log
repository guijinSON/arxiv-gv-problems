+        for name, value in _attack_values(inst).items():
+            ok = verify(inst, _answer_for_integer(value))[0]
+            attack_results[name]["successes"] += int(ok)
+            attack_results[name]["attempts"] += 1
+        rrng = random.Random(seed ^ 0xBAD5EED)
+        random_solved = False
+        for _ in range(256):
