+def _spectral_target(inst):
+    base, steps = _spectral_determinant(inst["q"], inst["m"])
+    transformed = _pair_mul(base, _phase_numerator_product(inst), inst["q"])
+    return _total_map_sign(inst) * transformed[0], steps + len(inst["phases"])
