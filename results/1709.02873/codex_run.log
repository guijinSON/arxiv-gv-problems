+    shift = [0] * m
+    for j, k in enumerate(mapping["perm"]):
+        inv = pow(mapping["scale"][j], -1, q)
+        perm[k] = j
+        scale[k] = inv
+        shift[k] = (-inv * mapping["shift"][j]) % q
+    return {"perm": perm, "scale": scale, "shift": shift}
+
