+
+def _random_map(m, q, rng):
+    perm = list(range(m))
+    rng.shuffle(perm)
+    return {
+        "perm": perm,
+        "scale": [rng.randrange(1, q) for _ in range(m)],
+        "shift": [rng.randrange(q) for _ in range(m)],
+    }
+
+
+def _apply_map(mapping, point, q):
+    return [
+        (mapping["scale"][j] * point[mapping["perm"][j]]
+         + mapping["shift"][j]) % q
