+    hint_delta = ((arms["hinted"]["solved"] / arms["hinted"]["attempts"])
+                  - (arms["placebo"]["solved"]
+                     / arms["placebo"]["attempts"]))
+    hinted_hardened = G9_MEASUREMENTS["hinted_verdict"] == "hardened"
+    within_caps = (answer_chars <= 2000 and answer_elements <= 256
+                   and intended_ops <= 300)
