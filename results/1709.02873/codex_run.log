+def _attack_values(inst):
+    q = inst["q"]
+    base = _base_determinant(q, inst["m"])
+    sign = _total_map_sign(inst)
+    phases = inst["phases"]
+    denominator_product = math.prod(t["phase"][2] for t in phases)
