+    poly = answer["minpoly"]
+    if not isinstance(poly, list) or len(poly) != 2:
+        return False, "minpoly must contain exactly two integers"
+    if not all(_is_plain_int(x) for x in poly):
+        return False, "minpoly coefficients must be integers"
+    c0, c1 = poly
