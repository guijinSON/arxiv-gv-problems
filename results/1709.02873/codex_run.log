+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["all_passed"] = all(
+        v.get("pass") is True for k, v in report.items()
+        if k.startswith("G") and isinstance(v, dict)
