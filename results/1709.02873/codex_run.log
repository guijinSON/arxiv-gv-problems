+        "root_lower": "-B from the instance",
+        "root_upper": "B from the instance",
+        "interval_denominator": 2,
+        "atomic_elements": 6,
+    },
+}
+
+STRUCTURAL_HINT = (
+    "The character eigenvalues split by whether each frequency is zero, a "
