+def _phase_triple(q, u, orientation):
+    # (u^2-q + 2u*s)/(u^2+q) has norm one for s^2=-q.
+    a, b, c = u * u - q, orientation * 2 * u, u * u + q
+    g = math.gcd(math.gcd(abs(a), abs(b)), c)
+    return [a // g, b // g, c // g]
