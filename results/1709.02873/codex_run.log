+
+    demo = make_instance(seed=9, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    t0 = time.perf_counter()
+    ref_value, ref_steps = _spectral_target(shipping)
+    ref_wall = time.perf_counter() - t0
+    if ref_value != _target(shipping):
