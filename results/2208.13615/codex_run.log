import random

def triang(n,rng):
    poly=list(range(n)); e=set()
    while len(poly)>3:
        k=rng.randrange(len(poly)); a=poly[(k-1)%len(poly)]; b=poly[(k+1)%len(poly)]
        x,y=sorted((a,b))
        if y-x not in (1,n-1): e.add((x,y))
        poly.pop(k)
    return e

def make(n,seed):
 r=random.Random(seed); pages=[]
 for z in range(2): pages.append(triang(n,r))
