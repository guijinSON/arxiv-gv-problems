+        "directed acyclic graph",
+        "fixed topological spine order",
+        "two-page partition of directed edge intervals",
+    ],
+    "verification_operations": [
+        "exact spine-position comparison",
+        "alternating-endpoint crossing test",
+        "same-page pair rejection",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
