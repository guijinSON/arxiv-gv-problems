\section{\NP-completeness Proof for Planar $st$-Graphs} \label{sec:st-complete}
% ============================================================

\begin{figure}[b]
    \centering
    \includegraphics[page=7]{figures/construction_example.pdf}
    \caption{The incidence graph $G_\phi$ of an instance $\phi$ of {\sc Planar Monotone 3-SAT} with $\phi = c_1 \land c_2 \land c_3$, $c_1=(x_1 \lor x_2 \lor x_3)$, $c_2=(x_3 \lor x_4)$, and $c_3=(\overline{x}_1 \lor \overline{ x}_2 \lor \overline{x}_4)$.}
    \label{fig:pm3sat}
\end{figure}

%Our reduction is from the {\sc Planar Monotone 3-SAT} problem, which is known to be \NP-complete~\cite{DBLP:journals/ijcga/BergK12}, and is defined as follows. 
Let $\phi$ be a Boolean $3$-SAT formula with $n$ variables $x_1,\ldots,x_n$ and $m$ clauses $c_1,\dots,c_m$. %in conjunctive normal form with at most three literals per clause.
A clause of $\phi$ is \emph{positive} (\emph{negative}) if it has only positive (negative) literals. % (i.e., literals $x_i$ for some variable $x_i$), while a \emph{negative clause} is one that only contains negated literals (i.e., literals $\overline{x}_i$ for some variable $x_i$). 
The \emph{incidence graph} $G_\phi$ of $\phi$ is the graph that has \emph{variable vertices} $x_1,\ldots,x_n$, \emph{clause vertices} $c_1,\dots,c_m$, and has an edge $(c_j,x_i)$ for each clause $c_j$ containing $x_i$ or $\overline{x}_i$. 
Note that we use the same notation for variables (clauses) in $\phi$ and variable vertices (clause vertices) in $G_\phi$.
If $\phi$ has clauses with less~than three literals, we introduce parallel edges in $G_\phi$ so that all clause vertices have degree~$3$ in $G_\phi$; see, e.g., the dotted edge $(c_2,x_4)$ in \cref{fig:pm3sat}.
% Since the clauses of $\phi$ are partitioned into positive and negative ones, the clause-vertices of $G_\phi$ are also partitioned into positive and negative. 
%
The formula~$\phi$ is an instance of the \NP-complete {\sc Planar Monotone 3-SAT} problem~\cite{DBLP:journals/ijcga/BergK12} if each clause of $\phi$ is positive or negative, and $G_\phi$ has a plane embedding~$\emb$ to which the edges of a cycle $\mathcal{C}_\phi:= x_1,\ldots,x_n$ can be added %so that $\mathcal{C}_\phi$ 
that separates positive and negative clause vertices. The problem asks whether~$\phi$ is satisfiable. 
% Before presenting our reduction, we describe different gadgets.

Next, we present~gadgets that we are going to use in a reduction from {\sc Planar Monotone 3-SAT} to the problem of deciding whether a given $st$-planar graph admits a $2$-page book embedding.

\paragraph{Double ladder.} A double ladder of even length $\ell$ is defined as follows; see \cref{fig:ladder}. %\footnote{The double ladder can be defined also for odd values of $\ell$; however, in our constructions we always use double ladders of even length.}. 
Its vertex set consists of two sources, $s_1$ and $s_2$, two sinks, $t_1$ and $t_2$, and vertices in $\cup_{i=0}^{\ell}\{u_i,v_i,w_i\}$. Its edge set consists of edges $s_1u_0$, $s_1v_0$, $s_2v_0$, $s_2w_0$, $u_{\ell}t_1$, $v_{\ell}t_1$, $v_{\ell}t_2$, $w_{\ell}t_2$, and $\cup_{i=0}^{\ell-1}\{u_iu_{i+1}, v_iu_{i+1}, v_iv_{i+1}, w_iv_{i+1}, w_iw_{i+1}\}$.

