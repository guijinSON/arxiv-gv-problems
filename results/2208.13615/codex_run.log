import random,time

def triang(n,rng):
 p=list(range(n)); e=set()
 while len(p)>3:
  z=rng.randrange(len(p)); a,b=sorted((p[(z-1)%len(p)],p[(z+1)%len(p)]))
  if b-a not in (1,n-1):e.add((a,b))
  p.pop(z)
 return e

def make(n,seed):
 r=random.Random(seed); e=triang(n,r)|triang(n,r)
 starts=list(range(n-1));r.shuffle(starts)
 # maximal matching starts
 pick=[]; used=set()
 for i in starts:
  if i not in used and i+1 not in used:
   pick.append(i);used|={i,i+1}
  if len(pick)>=n//3:break
 e|={(i,i+1) for i in pick};e.add((0,n-1))
 return sorted(e)

def topo_cuts(edges,cyc):
 n=len(cyc);pos=[0]*n
 for j,v in enumerate(cyc):pos[v]=j
 good=[]
 for r in range(n):
  ok=True
  for u,v in edges:
   if ((pos[u]-r)%n)>=((pos[v]-r)%n):ok=False;break
  if ok:good.append(r)
 return good

def bip(edges,o):
 pos=[0]*len(o)
 for i,v in enumerate(o):pos[v]=i
 adj=[[] for _ in edges]
 for i,(u,v) in enumerate(edges):
  a,b=pos[u],pos[v]
  for j in range(i):
