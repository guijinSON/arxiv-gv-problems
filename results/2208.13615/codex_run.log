 for s in range(len(edges)):
  if col[s]>=0:continue
  col[s]=0;st=[s]
  while st:
   u=st.pop()
   for v in adj[u]:
    if col[v]<0:col[v]=col[u]"'^1;st.append(v)
    elif col[v]==col[u]:return False
 return True
for n,p in ((24,13807),(40,64007),(60,216011)):
