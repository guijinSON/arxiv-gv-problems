diff --git a/gen_2208_13615.py b/gen_2208_13615.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e1171650f69323527740d2f1a529040bf3af174
--- /dev/null
+++ b/gen_2208_13615.py
@@ -0,0 +1,986 @@
+"""Verified problem generator for arXiv:2208.13615.
+
+The paper defines a two-page book embedding of a DAG as a topological spine
+order together with a two-colouring of its edges in which same-colour edges do
+not cross.  This module generates the fixed-spine subproblem: the topological
+order is supplied and the answer is an exact partition of the edge IDs.
+
+Instances are generated by composition.  In a hidden compressed spine, page
+zero receives even-span intervals and page one receives odd-span intervals;
+each interval is admitted only if it does not cross an interval already on its
+page.  Isolated vertices, vertex relabelling, and edge shuffling are then
+structure-preserving transformations.  Thus the answer is never found by
+solving the generated instance.
+
+Only the Python standard library is required.  Importing this module performs
+no file I/O, network access, or printing.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import random
+import re
+import sys
+import time
+from typing import Any
+
+
