import random,time

def crosses(e,f):
 a,b=e;c,d=f
 return (a<c<b<d) or (c<a<d<b)

def make(L,seed):
 rng=random.Random(seed);V=2*L;pages=[[],[]];allset=set()
 # calibration edge each adjacent layer, pseudorandom pos; greedy color against fixed
 bits=[rng.randrange(2) for _ in range(L-1)]
 for i,r in enumerate(bits):
  e=(2*i+r,2*(i+1)+r)
  avail=[p for p in range(2) if not any(crosses(e,f) for f in pages[p])]
  if not avail: print('CALFAIL');break
  p=rng.choice(avail);pages[p].append(e);allset.add(e)
 # include outer edge
 pages[0].append((0,V-1));allset.add((0,V-1))
 # random additions targeted total 3V
