+NOTES = r"""
+Paper reading and exact definition.  Section 2 defines a book embedding by a
+spine order and pages, and says that a DAG's spine order must be topological.
+Theorem 9 explicitly gives the NP witness: guess a vertex order and a partition
+of the edges into two pages, then check topological order and alternating
+endpoints.  This module fixes the first half of that native witness and asks for
+the second; no SAT, geometric surrogate, or convenience reduction is used.
+
+Step 0 and the easy boundary.  The Introduction says page-number one is
+linear-time recognizable, and records FPT algorithms parameterized by vertex
+cover for every k and by treewidth for st-graphs at k=2.  More decisively for
+this promised distribution, once the spine is fixed the crossing graph can be
+built and bipartite-coloured in O(m^2).  Therefore Track A would be false.  At
+the hard preset the explicit reference implementation checks C(112,2)=6,216
+pairs.  The compact route needs at most 292 operations: mark incident vertices,
+compress the displayed spine, and take one span parity per edge.
+
+Construction.  Start with n active spine vertices and all n-1 adjacent forward
+edges.  Add extra directed chords one at a time.  A chord's planted page is the
+parity of its span in the active spine; it is retained only if it does not cross
+an existing chord of that parity and crosses the opposite page.  Hence both
+pages are noncrossing by composition, while the chord crossing graph stays
+connected by construction.  Insert isolated decoy vertices, randomly relabel
+every vertex, and randomly reorder the edge rows.  These transformations
+preserve the certificate.  All chords use the same sampling rule; planted and
+decoy edges are not drawn from separate marginal distributions.
+
+Attacks.  Isolated vertices make parity in the displayed spine wrong.  Random
+labels defeat label-order and endpoint-magnitude rules.  Edge-row shuffling is
+resampled until online first-fit and alternating-row colourings fail.  The
+panel also tests a short-versus-long outlier split and 256 uniform restarts.
+The successful O(m^2) crossing-graph bipartite colouring is reported separately
+as Track B's reference_algorithm, as required.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 1_000_000
+
+
+def _validate_params(
+    n: int, extra_edges: int | None, decoys: int, disclose: str
+) -> tuple[int, int, int, str]:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 6:
+        raise ValueError("n must be an integer at least 6")
+    if extra_edges is None:
+        extra_edges = max(5, n)
+    if (isinstance(extra_edges, bool) or not isinstance(extra_edges, int)
+            or extra_edges < 2):
+        raise ValueError("extra_edges must be an integer at least 2")
+    if isinstance(decoys, bool) or not isinstance(decoys, int) or decoys < 0:
+        raise ValueError("decoys must be a nonnegative integer")
+    if disclose not in {"none", "rule", "pages"}:
+        raise ValueError("disclose must be 'none', 'rule', or 'pages'")
+    if extra_edges > 2 * n - 8:
+        raise ValueError("extra_edges is too large for reliable generation")
+    return n, extra_edges, decoys, disclose
+
+
+def _crosses_positions(e: tuple[int, int], f: tuple[int, int]) -> bool:
+    a, b = e
+    c, d = f
+    return (a < c < b < d) or (c < a < d < b)
+
+
+def _grow_connected_chords(
+    n: int, count: int, rng: random.Random
+) -> tuple[list[tuple[int, int]], list[int]]:
+    """Generate two noncrossing pages whose chord crossing graph is connected."""
+
+    best: tuple[list[tuple[int, int]], list[int]] = ([], [])
+    for _restart in range(80):
+        pages: list[list[tuple[int, int]]] = [[], []]
+        chords: list[tuple[int, int]] = []
+        colours: list[int] = []
+        seen: set[tuple[int, int]] = set()
+        failures = 0
+        while len(chords) < count and failures < 20_000:
+            left = rng.randrange(0, n - 2)
+            right = rng.randrange(left + 2, n)
+            edge = (left, right)
+            page = (right - left) & 1
+            if edge in seen:
+                failures += 1
+                continue
+            if any(_crosses_positions(edge, other) for other in pages[page]):
+                failures += 1
+                continue
+            if chords and not any(
+                _crosses_positions(edge, other) for other in pages[1 - page]
+            ):
+                failures += 1
+                continue
+            pages[page].append(edge)
+            chords.append(edge)
+            colours.append(page)
+            seen.add(edge)
+            failures = 0
+        if len(chords) > len(best[0]):
+            best = (chords, colours)
+        if len(chords) == count:
+            return chords, colours
+    raise RuntimeError(
+        f"could generate only {len(best[0])}/{count} connected chords"
+    )
+
+
+def _crossing_pairs(
+    order: list[int], edges: list[list[int]]
+) -> list[list[int]]:
+    pos = {vertex: i for i, vertex in enumerate(order)}
+    normalized = [(pos[u], pos[v]) for u, v in edges]
+    pairs: list[list[int]] = []
+    for i, edge in enumerate(normalized):
+        for j in range(i):
+            if _crosses_positions(edge, normalized[j]):
+                pairs.append([j, i])
+    return pairs
+
+
+def _colours_to_answer(colours: list[int]) -> list[int]:
+    page_zero = [i for i, colour in enumerate(colours) if colour == 0]
+    page_one = [i for i, colour in enumerate(colours) if colour == 1]
+    return page_zero + [-1] + page_one
+
+
+def _valid_colours(inst: dict, colours: list[int]) -> bool:
+    if len(colours) != inst["m"]:
+        return False
+    return all(colours[i] != colours[j] for i, j in inst["crossings"])
+
+
+def _attack_colourings(inst: dict) -> dict[str, list[int]]:
+    pos = {vertex: i for i, vertex in enumerate(inst["order"])}
+    lengths = [pos[v] - pos[u] for u, v in inst["edges"]]
+    ordered_lengths = sorted(lengths)
+    median = ordered_lengths[len(ordered_lengths) // 2]
+
+    outlier = [int(length > median) for length in lengths]
+    raw_parity = [length & 1 for length in lengths]
+    alternating = [i & 1 for i in range(inst["m"])]
+
+    adjacency: list[list[int]] = [[] for _ in range(inst["m"])]
+    for i, j in inst["crossings"]:
+        adjacency[i].append(j)
+        adjacency[j].append(i)
+    online = [-1] * inst["m"]
+    for edge_id in range(inst["m"]):
+        used = {online[j] for j in adjacency[edge_id]
+                if j < edge_id and online[j] >= 0}
+        if 0 not in used:
+            online[edge_id] = 0
+        elif 1 not in used:
+            online[edge_id] = 1
+        else:
+            # First-fit has failed; retain a total candidate for the verifier.
+            online[edge_id] = 0
+    return {
+        "outlier_short_vs_long": outlier,
+        "greedy_online_first_fit": online,
+        "alternating_input_rows": alternating,
+        "raw_spine_span_parity": raw_parity,
+    }
+
+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    extra_edges: int | None = None,
+    decoys: int = 0,
+    disclose: str = "none",
+) -> dict:
+    """Construct a fixed-spine two-page instance and its known certificate."""
+
+    n, extra_edges, decoys, disclose = _validate_params(
+        n, extra_edges, decoys, disclose
+    )
+    rng = random.Random(seed)
+
+    # The adjacent edges activate every compressed-spine vertex and never cross.
+    base_edges = [(i, i + 1) for i in range(n - 1)]
+    base_colours = [1] * (n - 1)
+
+    # Retry only the random construction choices and cheap attack filters.  The
+    # planted pages are known throughout; no witness search occurs here.
+    for _outer in range(160):
+        chords, chord_colours = _grow_connected_chords(n, extra_edges, rng)
+        core_edges = base_edges + chords
+        core_colours = base_colours + chord_colours
+
+        total_vertices = n + decoys
+        active_positions = sorted(rng.sample(range(total_vertices), n))
+        core_to_position = dict(enumerate(active_positions))
+
+        labels = rng.sample(range(1000, 1000 + 50 * total_vertices), total_vertices)
+        order = list(labels)
+        labelled_edges = [
+            [labels[core_to_position[u]], labels[core_to_position[v]]]
+            for u, v in core_edges
+        ]
+
+        row_order = list(range(len(labelled_edges)))
+        if disclose == "pages":
+            # The easy rung exposes the page split explicitly and keeps each
+            # page contiguous, so the oracle ladder has a genuinely easy start.
+            zeros = [i for i, c in enumerate(core_colours) if c == 0]
+            ones = [i for i, c in enumerate(core_colours) if c == 1]
+            rng.shuffle(zeros)
+            rng.shuffle(ones)
+            row_order = zeros + ones
+        else:
+            rng.shuffle(row_order)
+
+        edges = [labelled_edges[i] for i in row_order]
+        colours = [core_colours[i] for i in row_order]
+        crossings = _crossing_pairs(order, edges)
+        inst = {
+            "n": n,
+            "extra_edges": extra_edges,
+            "decoys": decoys,
+            "disclose": disclose,
+            "order": order,
+            "edges": edges,
+            "m": len(edges),
+            "crossings": crossings,
+            "page_zero_prefix": (
+                sum(1 for colour in colours if colour == 0)
+                if disclose == "pages" else None
+            ),
+            "answer": _colours_to_answer(colours),
+        }
+        if disclose != "none":
+            return inst
+        if all(
+            not _valid_colours(inst, candidate)
+            for candidate in _attack_colourings(inst).values()
+        ):
+            return inst
+    raise RuntimeError("could not defeat the deterministic cheap attacks")
+
+
+def render(inst: dict) -> str:
+    """Render the complete fixed-spine page-partition problem."""
+
+    order_text = " ".join(str(v) for v in inst["order"])
+    edge_text = "\n".join(
+        f"{i}: {u} -> {v}" for i, (u, v) in enumerate(inst["edges"])
+    )
+    clue = ""
+    if inst.get("disclose") == "pages":
+        split = int(inst["page_zero_prefix"])
+        clue = (
+            "\nTraining-rung disclosure: edge IDs 0 through "
+            f"{split - 1} form page 0, and IDs {split} through "
+            f"{inst['m'] - 1} form page 1.\n"
+        )
+    elif inst.get("disclose") == "rule":
+        clue = (
+            "\nTraining-rung disclosure: remove spine vertices incident to no "
+            "edge; in the remaining order, put even-span edges on page 0 and "
+            "odd-span edges on page 1.\n"
+        )
+
+    mode = os.environ.get("GV_HINT_MODE")
+    hint = ""
+    if mode == "structural":
+        hint = "\nHint: " + STRUCTURAL_HINT + "\n"
+    elif mode == "placebo":
+        hint = "\nHint: " + PLACEBO_HINT + "\n"
+
+    return f"""Two-page embedding of a fixed-order DAG
+
+A directed acyclic graph is given together with a fixed topological spine
+order.  The vertices occur from left to right in exactly the displayed order.
+Every listed directed edge points from an earlier vertex to a later vertex.
+
+For edges (a,b) and (c,d), use their positions in the spine order.  They cross
+exactly when their four distinct endpoints alternate: either
+pos(a) < pos(c) < pos(b) < pos(d), or
+pos(c) < pos(a) < pos(d) < pos(b).
+Edges sharing an endpoint do not cross.  Partition all edge IDs into page 0 and
+page 1 so that no two edges on the same page cross.
+
+Number of spine vertices: {len(inst['order'])}
+Number of directed edges: {inst['m']}
+Spine order (left to right):
+{order_text}
+
+Directed edges (0-indexed edge IDs):
+{edge_text}
+{clue}{hint}
+Give your final answer inside <answer></answer> tags as one JSON integer list:
+[the page-0 edge IDs in strictly increasing order, -1, the page-1 edge IDs in
+strictly increasing order].  The separator -1 must occur exactly once, and
+every edge ID from 0 through {inst['m'] - 1} must occur exactly once.  Page
+names may be swapped.
+Example: <answer>[0,2,-1,1,3]</answer>
+Output nothing else inside the tags."""
+
+
+def parse_answer(text: str) -> object | None:
+    """Parse the canonical JSON list from a tagged model response."""
+
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if match is None:
+        return None
+    payload = match.group(1).strip()
+    if payload.startswith("```"):
+        payload = re.sub(r"^```(?:json|python|text)?\s*", "", payload, flags=re.I)
+        payload = re.sub(r"\s*```$", "", payload)
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list):
+        return None
+    if any(isinstance(v, bool) or not isinstance(v, int) for v in value):
+        return None
+    return value
+
+
+def _answer_to_colours(inst: dict, answer: object) -> tuple[list[int] | None, str]:
+    if not isinstance(answer, list):
+        return None, "answer must be a JSON integer list"
+    if not answer:
+        return None, "answer list is empty"
+    if len(answer) != inst["m"] + 1:
+        return None, f"expected exactly {inst['m'] + 1} list entries"
+    if any(isinstance(v, bool) or not isinstance(v, int) for v in answer):
+        return None, "every list entry must be an integer"
+    if any(v < -1 or v >= inst["m"] for v in answer):
+        return None, f"edge ID outside the allowed range -1..{inst['m'] - 1}"
+    if answer.count(-1) != 1:
+        return None, "separator -1 must occur exactly once"
+    edge_ids = [v for v in answer if v != -1]
+    if len(set(edge_ids)) != len(edge_ids):
+        return None, "an edge ID is duplicated"
+    if set(edge_ids) != set(range(inst["m"])):
+        return None, "the partition omits at least one edge ID"
+    separator = answer.index(-1)
+    if answer[:separator] != sorted(answer[:separator]):
+        return None, "page-0 edge IDs are not strictly increasing"
+    if answer[separator + 1:] != sorted(answer[separator + 1:]):
+        return None, "page-1 edge IDs are not strictly increasing"
+    colours = [1] * inst["m"]
+    for edge_id in answer[:separator]:
+        colours[edge_id] = 0
+    return colours, "ok"
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check a proposed page partition without consulting inst['answer']."""
+
+    colours, reason = _answer_to_colours(inst, answer)
+    if colours is None:
+        return False, reason
+    for i, j in inst.get("crossings") or _crossing_pairs(
+        inst["order"], inst["edges"]
+    ):
+        if colours[i] == colours[j]:
+            return False, f"same-page crossing between edge IDs {i} and {j}"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from all canonical two-page edge partitions."""
+
+    colours = [rng.randrange(2) for _ in range(inst["m"])]
+    return _colours_to_answer(colours)
+
+
+def search_space(inst: dict) -> int | None:
+    """Return the exact number of canonical page partitions."""
+
+    return 1 << inst["m"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Brute-force all partitions when the declared cap permits it."""
+
+    space = search_space(inst)
+    if space is None or space > _ENUMERATION_CAP:
+        return None
+    valid = 0
+    for mask in range(space):
+        colours = [(mask >> i) & 1 for i in range(inst["m"])]
+        valid += int(_valid_colours(inst, colours))
+    return valid
+
+
+def _crossing_component_count(inst: dict) -> int:
+    adjacency: list[list[int]] = [[] for _ in range(inst["m"])]
+    for i, j in inst["crossings"]:
+        adjacency[i].append(j)
+        adjacency[j].append(i)
+    seen: set[int] = set()
+    components = 0
+    for start in range(inst["m"]):
+        if start in seen:
+            continue
+        components += 1
+        seen.add(start)
+        stack = [start]
+        while stack:
+            edge_id = stack.pop()
+            for neighbor in adjacency[edge_id]:
+                if neighbor not in seen:
+                    seen.add(neighbor)
+                    stack.append(neighbor)
+    return components
+
+
+def _reference_algorithm(inst: dict) -> tuple[list[int] | None, dict[str, int]]:
+    """Build the crossing graph explicitly and bipartite-colour it."""
+
+    m = inst["m"]
+    pos = {vertex: i for i, vertex in enumerate(inst["order"])}
+    intervals = [(pos[u], pos[v]) for u, v in inst["edges"]]
+    adjacency: list[list[int]] = [[] for _ in range(m)]
+    pair_tests = 0
+    crossing_edges = 0
+    for i in range(m):
+        for j in range(i):
+            pair_tests += 1
+            if _crosses_positions(intervals[i], intervals[j]):
+                adjacency[i].append(j)
+                adjacency[j].append(i)
+                crossing_edges += 1
+
+    colours = [-1] * m
+    bfs_steps = 0
+    for start in range(m):
+        if colours[start] >= 0:
+            continue
+        colours[start] = 0
+        queue = [start]
+        cursor = 0
+        while cursor < len(queue):
+            edge_id = queue[cursor]
+            cursor += 1
+            bfs_steps += 1
+            for neighbor in adjacency[edge_id]:
+                bfs_steps += 1
+                if colours[neighbor] < 0:
+                    colours[neighbor] = colours[edge_id] ^ 1
+                    queue.append(neighbor)
+                elif colours[neighbor] == colours[edge_id]:
+                    return None, {
+                        "pair_tests": pair_tests,
+                        "crossing_edges": crossing_edges,
+                        "bfs_steps": bfs_steps,
+                    }
+    return _colours_to_answer(colours), {
+        "pair_tests": pair_tests,
+        "crossing_edges": crossing_edges,
+        "bfs_steps": bfs_steps,
+    }
+
+
+def _structural_decode(inst: dict) -> list[int]:
+    """Use the compressed-spine parity invariant."""
+
+    incident = {vertex for edge in inst["edges"] for vertex in edge}
+    active = [vertex for vertex in inst["order"] if vertex in incident]
+    rank = {vertex: i for i, vertex in enumerate(active)}
+    colours = [(rank[v] - rank[u]) & 1 for u, v in inst["edges"]]
+    return _colours_to_answer(colours)
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonicalize vertex names and edge-row order through spine positions."""
+
+    position = {vertex: i for i, vertex in enumerate(inst["order"])}
+    normalized_edges = sorted(
+        (position[u], position[v]) for u, v in inst["edges"]
+    )
+    payload = {
+        "spine_vertices": len(inst["order"]),
+        "directed_position_edges": normalized_edges,
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """First enlarge the fixed-witness haystack by adding isolated decoys."""
+
+    current = dict(params)
+    current.pop("_preset", None)
+    n = int(current.get("n", 0))
+    extra = int(current.get("extra_edges", max(5, n)))
+    decoys = int(current.get("decoys", 0))
+    m = n - 1 + extra
+    # The compact route costs at most (n+decoys)+2m.  Grow only the input
+    # haystack while that fixed certificate still fits the 300-operation cap.
+    room = 300 - ((n + decoys) + 2 * m)
+    if room >= 4:
+        current["decoys"] = decoys + min(8, room)
+        current["disclose"] = "none"
+        return current
+    return None
+
+
+def _atom_count(value: Any) -> int:
+    if isinstance(value, dict):
+        return sum(_atom_count(v) for v in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_atom_count(v) for v in value)
+    return 1
+
+
+def _carried_for_edge_permutation(
+    inst: dict, permutation: list[int]
+) -> tuple[dict, list[int]]:
+    colours, reason = _answer_to_colours(inst, inst["answer"])
+    if colours is None:
+        raise AssertionError(reason)
+    changed = dict(inst)
+    changed["edges"] = [inst["edges"][i] for i in permutation]
+    changed_colours = [colours[i] for i in permutation]
+    changed["crossings"] = _crossing_pairs(changed["order"], changed["edges"])
+    changed["answer"] = _colours_to_answer(changed_colours)
+    return changed, changed["answer"]
+
+
+def _relabel_instance(
+    inst: dict, rng: random.Random
+) -> tuple[dict, list[int]]:
+    old = list(inst["order"])
+    new = rng.sample(range(10_000, 10_000 + 100 * len(old)), len(old))
+    mapping = dict(zip(old, new))
+    changed = dict(inst)
+    changed["order"] = [mapping[v] for v in old]
+    changed["edges"] = [[mapping[u], mapping[v]] for u, v in inst["edges"]]
+    changed["crossings"] = _crossing_pairs(changed["order"], changed["edges"])
+    changed["answer"] = list(inst["answer"])
+    return changed, changed["answer"]
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return a JSON-native measured report."""
+
+    report: dict[str, Any] = {
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    g1_failures: list[str] = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in range(5):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                g1_failures.append(f"{preset}/{seed}: {reason}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append(f"{preset}/{seed}: answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": attempts,
+        "failures": g1_failures,
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=314159, **shipping)
+    planted = list(ship["answer"])
+    separator = planted.index(-1)
+    swapped = list(planted)
+    if separator >= 2:
+        swapped[0], swapped[1] = swapped[1], swapped[0]
+    else:
+        swapped[separator + 1], swapped[separator + 2] = (
+            swapped[separator + 2], swapped[separator + 1]
+        )
+    duplicated = list(planted)
+    replace_at = 1 if separator > 1 else separator + 2
+    source_at = 0 if separator > 1 else separator + 1
+    duplicated[replace_at] = duplicated[source_at]
+    out_of_range = list(planted)
+    out_of_range[0] = ship["m"] + 7
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_one": swapped,
+        "duplicate_one": duplicated,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    cases: dict[str, dict[str, Any]] = {}
+    reasons: list[str] = []
+    for name, candidate in corruptions.items():
+        ok, reason = verify(ship, candidate)
+        cases[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": all(case["rejected"] for case in cases.values())
+        and len(set(reasons)) == len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "cases": cases,
+    }
+
+    model_style = (
+        "I checked all alternating endpoint pairs.\n```json\n<answer>"
+        + json.dumps(planted)
+        + "</answer>\n```\nThe two page lists are sorted."
+    )
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("no tagged answer") is None,
+        "parsed_matches": parsed == planted,
+    }
+
+    samples = 200_000
+    sample_rng = random.Random(8675309)
+    hits = 0
+    for _ in range(samples):
+        candidate = random_candidate(ship, sample_rng)
+        hits += int(verify(ship, candidate)[0])
+    observed = hits / samples
+    components = _crossing_component_count(ship)
+    exact_solutions = 1 << components
+    exact_fraction = exact_solutions / search_space(ship)
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6 and exact_fraction < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": observed,
+        "exact_valid_partitions": exact_solutions,
+        "candidate_space": search_space(ship),
+        "exact_probability": exact_fraction,
+        "sampler": "uniform canonical partitions of all edge IDs",
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    attack_names = [
+        "outlier_short_vs_long",
+        "greedy_online_first_fit",
+        "random_restart_256",
+        "raw_spine_span_parity",
+        "alternating_input_rows",
+    ]
+    attack_results = {
+        name: {"successes": 0, "attempts": 8} for name in attack_names
+    }
+    reference_successes = 0
+    reference_times: list[float] = []
+    reference_pair_tests: list[int] = []
+    reference_operations: list[int] = []
+    for seed in range(8):
+        inst = make_instance(seed=12_000 + seed, **shipping)
+        attacks = _attack_colourings(inst)
+        for name, colours in attacks.items():
+            attack_results[name]["successes"] += int(
+                verify(inst, _colours_to_answer(colours))[0]
+            )
+        restart_rng = random.Random(700_000 + seed)
+        restart_solved = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, restart_rng))[0]:
+                restart_solved = True
+                break
+        attack_results["random_restart_256"]["successes"] += int(
+            restart_solved
+        )
+
+        started = time.perf_counter()
+        reference_answer, counts = _reference_algorithm(inst)
+        elapsed = time.perf_counter() - started
+        reference_times.append(elapsed)
+        reference_pair_tests.append(counts["pair_tests"])
+        reference_operations.append(
+            counts["pair_tests"] + counts["bfs_steps"]
+        )
+        reference_successes += int(
+            reference_answer is not None
+            and verify(inst, reference_answer)[0]
+        )
+
+    reference = {
+        "name": "explicit crossing graph plus BFS bipartite colouring",
+        "paper_location": "Theorem 9, NP-membership certificate check",
+        "complexity": "O(m^2) exact endpoint comparisons and O(m+c) BFS",
+        "wall_clock_sec_mean": sum(reference_times) / len(reference_times),
+        "wall_clock_sec_max": max(reference_times),
+        "pair_tests_mean": sum(reference_pair_tests) / len(reference_pair_tests),
+        "pair_tests_max": max(reference_pair_tests),
+        "operations_mean": sum(reference_operations) / len(reference_operations),
+        "operations_max": max(reference_operations),
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    all_attacks_failed = all(
+        result["successes"] == 0 and result["attempts"] >= 8
+        for result in attack_results.values()
+    )
+    report["G5_density_and_baseline"] = {
+        "pass": observed < 1e-6
+        and exact_fraction < 1e-6
+        and demo_count is not None
+        and demo_count >= 1
+        and reference_successes == 8,
+        "shipping_density_hits": hits,
+        "shipping_density_total": samples,
+        "shipping_observed_fraction": observed,
+        "shipping_exact_solution_count": exact_solutions,
+        "shipping_exact_valid_fraction": exact_fraction,
+        "demo_valid_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "baseline_wall_clock_sec_mean": reference["wall_clock_sec_mean"],
+        "baseline_wall_clock_sec_max": reference["wall_clock_sec_max"],
+        "baseline_pair_tests_mean": reference["pair_tests_mean"],
+        "baseline_operations_mean": reference["operations_mean"],
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == 8,
+        "attacks": attack_results,
+        "reference_algorithm": reference,
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] = 2 * int(doubled_params["n"])
+    doubled_params["extra_edges"] = 2 * int(doubled_params["extra_edges"])
+    doubled_params["decoys"] = 2 * int(doubled_params["decoys"])
+    doubled = make_instance(seed=314159, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["m"] > ship["m"]
+        and search_space(doubled) > search_space(ship),
+        "shipping_active_vertices": ship["n"],
+        "doubled_active_vertices": doubled["n"],
+        "shipping_edges": ship["m"],
+        "doubled_edges": doubled["m"],
+        "shipping_space_bits": ship["m"],
+        "doubled_space_bits": doubled["m"],
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    real_transform_checks = 0
+    composed_checks = 0
+    unrelated_keys: list[str] = []
+    g8_failures: list[str] = []
+    for seed in range(20):
+        inst = make_instance(seed=20_000 + seed, **DIFFICULTY["medium"])
+        key = canonical_key(inst)
+        unrelated_keys.append(key)
+
+        relabelled, carried = _relabel_instance(
+            inst, random.Random(30_000 + seed)
+        )
+        if canonical_key(relabelled) == key:
+            invariant_checks += 1
+        else:
+            g8_failures.append(f"vertex relabelling changed key at seed {seed}")
+        if verify(relabelled, carried)[0]:
+            real_transform_checks += 1
+        else:
+            g8_failures.append(f"vertex relabelling rejected witness at seed {seed}")
+
+        permutation = list(range(inst["m"]))
+        random.Random(40_000 + seed).shuffle(permutation)
+        reordered, reordered_answer = _carried_for_edge_permutation(
+            relabelled, permutation
+        )
+        if canonical_key(reordered) == key and verify(
+            reordered, reordered_answer
+        )[0]:
+            composed_checks += 1
+        else:
+            g8_failures.append(f"composed relabel/row reorder failed at seed {seed}")
+
+    distinct = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures and distinct == 20,
+        "invariance_checks": invariant_checks,
+        "real_transformation_checks": real_transform_checks,
+        "composed_transformation_checks": composed_checks,
+        "unrelated_distinct": distinct,
+        "unrelated_attempts": 20,
+        "transformations": [
+            "arbitrary vertex-label permutation carried through spine and edges",
+            "edge-row permutation with the page certificate carried by row",
+            "composition of vertex relabelling and edge-row permutation",
+        ],
+        "failures": g8_failures,
+    }
+
+    answer_blobs = [
+        json.dumps(
+            make_instance(seed=seed, **shipping)["answer"],
+            separators=(",", ":"),
+        )
+        for seed in range(32)
+    ]
+    answer_chars = max(map(len, answer_blobs))
+    answer_tokens = (answer_chars + 3) // 4
+    arms = {
+        name: {
+            "solved": int(G9_MEASUREMENTS[name]["solved"]),
+            "attempts": int(G9_MEASUREMENTS[name]["attempts"]),
+        }
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = (
+        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+        if arms["hinted"]["attempts"] else None
+    )
+    placebo_rate = (
+        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        if arms["placebo"]["attempts"] else None
+    )
+    intended_operations = len(ship["order"]) + 2 * ship["m"]
+    compact_answer = _structural_decode(ship)
+    within_caps = (
+        answer_chars <= 2_000
+        and _atom_count(ship["answer"]) <= 256
+        and intended_operations <= 300
+        and verify(ship, compact_answer)[0]
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": (
+            hinted_rate - placebo_rate
+            if hinted_rate is not None and placebo_rate is not None
+            else None
+        ),
+        "hinted_verdict": G9_MEASUREMENTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": _atom_count(ship["answer"]),
+        "intended_route_operations": intended_operations,
+        "compact_route_verifies": verify(ship, compact_answer)[0],
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [name for name in report if name.startswith("G")]
+    report["all_passed"] = all(bool(report[name].get("pass")) for name in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

