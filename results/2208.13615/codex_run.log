+            restart_solved
+        )
+
+        started = time.perf_counter()
+        reference_answer, counts = _reference_algorithm(inst)
+        elapsed = time.perf_counter() - started
+        reference_times.append(elapsed)
+        reference_pair_tests.append(counts["pair_tests"])
+        reference_operations.append(
+            counts["pair_tests"] + counts["bfs_steps"]
+        )
+        reference_successes += int(
+            reference_answer is not None
+            and verify(inst, reference_answer)[0]
+        )
+
+    reference = {
+        "name": "explicit crossing graph plus BFS bipartite colouring",
+        "paper_location": "Theorem 9, NP-membership certificate check",
+        "complexity": "O(m^2) exact endpoint comparisons and O(m+c) BFS",
+        "wall_clock_sec_mean": sum(reference_times) / len(reference_times),
+        "wall_clock_sec_max": max(reference_times),
+        "pair_tests_mean": sum(reference_pair_tests) / len(reference_pair_tests),
+        "pair_tests_max": max(reference_pair_tests),
+        "operations_mean": sum(reference_operations) / len(reference_operations),
+        "operations_max": max(reference_operations),
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    all_attacks_failed = all(
+        result["successes"] == 0 and result["attempts"] >= 8
+        for result in attack_results.values()
+    )
+    report["G5_density_and_baseline"] = {
+        "pass": observed < 1e-6
+        and exact_fraction < 1e-6
+        and demo_count is not None
+        and demo_count >= 1
+        and reference_successes == 8,
+        "shipping_density_hits": hits,
+        "shipping_density_total": samples,
+        "shipping_observed_fraction": observed,
+        "shipping_exact_solution_count": exact_solutions,
+        "shipping_exact_valid_fraction": exact_fraction,
+        "demo_valid_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "baseline_wall_clock_sec_mean": reference["wall_clock_sec_mean"],
+        "baseline_wall_clock_sec_max": reference["wall_clock_sec_max"],
+        "baseline_pair_tests_mean": reference["pair_tests_mean"],
+        "baseline_operations_mean": reference["operations_mean"],
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == 8,
+        "attacks": attack_results,
+        "reference_algorithm": reference,
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] = 2 * int(doubled_params["n"])
+    doubled_params["extra_edges"] = 2 * int(doubled_params["extra_edges"])
+    doubled_params["decoys"] = 2 * int(doubled_params["decoys"])
+    doubled = make_instance(seed=314159, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["m"] > ship["m"]
+        and search_space(doubled) > search_space(ship),
+        "shipping_active_vertices": ship["n"],
+        "doubled_active_vertices": doubled["n"],
+        "shipping_edges": ship["m"],
+        "doubled_edges": doubled["m"],
+        "shipping_space_bits": ship["m"],
+        "doubled_space_bits": doubled["m"],
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    real_transform_checks = 0
+    composed_checks = 0
+    unrelated_keys: list[str] = []
+    g8_failures: list[str] = []
+    for seed in range(20):
+        inst = make_instance(seed=20_000 + seed, **DIFFICULTY["medium"])
+        key = canonical_key(inst)
+        unrelated_keys.append(key)
+
+        relabelled, carried = _relabel_instance(
+            inst, random.Random(30_000 + seed)
+        )
+        if canonical_key(relabelled) == key:
+            invariant_checks += 1
+        else:
+            g8_failures.append(f"vertex relabelling changed key at seed {seed}")
+        if verify(relabelled, carried)[0]:
+            real_transform_checks += 1
+        else:
+            g8_failures.append(f"vertex relabelling rejected witness at seed {seed}")
+
+        permutation = list(range(inst["m"]))
+        random.Random(40_000 + seed).shuffle(permutation)
+        reordered, reordered_answer = _carried_for_edge_permutation(
+            relabelled, permutation
+        )
+        if canonical_key(reordered) == key and verify(
+            reordered, reordered_answer
+        )[0]:
+            composed_checks += 1
+        else:
+            g8_failures.append(f"composed relabel/row reorder failed at seed {seed}")
+
+    distinct = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures and distinct == 20,
+        "invariance_checks": invariant_checks,
+        "real_transformation_checks": real_transform_checks,
+        "composed_transformation_checks": composed_checks,
+        "unrelated_distinct": distinct,
+        "unrelated_attempts": 20,
+        "transformations": [
+            "arbitrary vertex-label permutation carried through spine and edges",
+            "edge-row permutation with the page certificate carried by row",
+            "composition of vertex relabelling and edge-row permutation",
+        ],
+        "failures": g8_failures,
+    }
+
+    answer_blobs = [
+        json.dumps(
+            make_instance(seed=seed, **shipping)["answer"],
+            separators=(",", ":"),
+        )
+        for seed in range(32)
+    ]
+    answer_chars = max(map(len, answer_blobs))
+    answer_tokens = (answer_chars + 3) // 4
+    arms = {
+        name: {
+            "solved": int(G9_MEASUREMENTS[name]["solved"]),
+            "attempts": int(G9_MEASUREMENTS[name]["attempts"]),
+        }
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = (
+        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+        if arms["hinted"]["attempts"] else None
+    )
+    placebo_rate = (
+        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        if arms["placebo"]["attempts"] else None
+    )
+    intended_operations = len(ship["order"]) + 2 * ship["m"]
+    compact_answer = _structural_decode(ship)
+    within_caps = (
+        answer_chars <= 2_000
+        and _atom_count(ship["answer"]) <= 256
+        and intended_operations <= 300
+        and verify(ship, compact_answer)[0]
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": (
+            hinted_rate - placebo_rate
+            if hinted_rate is not None and placebo_rate is not None
+            else None
+        ),
+        "hinted_verdict": G9_MEASUREMENTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": _atom_count(ship["answer"]),
+        "intended_route_operations": intended_operations,
+        "compact_route_verifies": verify(ship, compact_answer)[0],
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [name for name in report if name.startswith("G")]
+    report["all_passed"] = all(bool(report[name].get("pass")) for name in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

