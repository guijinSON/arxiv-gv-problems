 for i in starts:e.add((i,i+1))
 e.add((0,n-1))
 return sorted(e),pages,starts

def cross(e,f,pos):
 a,b=sorted((pos[e[0]],pos[e[1]])); c,d=sorted((pos[f[0]],pos[f[1]]))
 return (a<c<b<d) or (c<a<d<b)

def valid_order(edges,order):
 pos={v:i for i,v in enumerate(order)}
 if any(pos[u]>=pos[v] for u,v in edges):return False
 adj=[[] for _ in edges]
