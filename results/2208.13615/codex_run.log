+        "page_order": "strictly increasing IDs within each page",
+        "candidate_partitions": "2^m",
+    },
+}
+
+DIFFICULTY = {
+    "demo": {
+        "n": 8, "extra_edges": 5, "decoys": 2,
+        "disclose": "pages",
+    },
+    "easy": {
+        "n": 18, "extra_edges": 12, "decoys": 4,
+        "disclose": "pages",
+    },
+    "medium": {
+        "n": 34, "extra_edges": 30, "decoys": 8,
+        "disclose": "rule",
+    },
+    "hard": {
