   747	def _attack_rhs_vote(inst):
   748	    rows, _ = _extract_parity_rows(inst)
   749	    votes = [[] for _ in range(inst["n"])]
   750	    for triple, rhs in rows:
   751	        for var in triple:
   752	            votes[var].append(rhs)
   753	    return [int(sum(values) * 2 > len(values)) if values else 0
   754	            for values in votes]
