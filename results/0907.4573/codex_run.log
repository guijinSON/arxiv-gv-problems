   357	def parse_answer(text) -> object | None:
   358	    """Extract the last tagged JSON list, tolerating prose and fences."""
   359	    if not isinstance(text, str):
   360	        return None
   361	    matches = _ANSWER_RE.findall(text)
   362	    if not matches:
   363	        return None
   364	    body = matches[-1].strip()
   365	    fenced = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body,
   366	                          flags=re.I | re.S)
   367	    if fenced:
   368	        body = fenced.group(1).strip()
   369	    try:
   370	        value = json.loads(body)
   371	    except (TypeError, ValueError, json.JSONDecodeError):
   372	        return None
   373	    return value if isinstance(value, list) else None
