+                    remaining, rng.random(), var))
+            chosen = min(choices)[2]
+            candidate[chosen] ^= 1
+            for row in incident[chosen]:
+                if row in bad:
+                    bad.remove(row)
+                else:
+                    bad.add(row)
+    return candidate
