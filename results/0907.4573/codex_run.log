   659	def _attack_occurrence_median(inst):
   660	    counts = [0] * inst["n"]
   661	    for clause in inst["clauses"]:
   662	        for lit in clause:
   663	            counts[abs(lit) - 1] += 1
   664	    median = sorted(counts)[len(counts) // 2]
   665	    return [int(value > median) for value in counts]
