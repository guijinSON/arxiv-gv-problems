   423	def random_candidate(inst, rng) -> object:
   424	    """Sample uniformly from the explicit language of n-bit assignments."""
   425	    word = rng.getrandbits(inst["n"])
   426	    return [(word >> i) & 1 for i in range(inst["n"])]
