   179	def _row_support(n, successor, row):
   180	    """The three natural (pre-relabel) columns in a core row."""
   181	    half = n // 2
   182	    if row < half:
   183	        i = row
   184	        return (i, successor[i], half + successor[i])
   185	    i = row - half
   186	    return (half + i, successor[i], half + successor[i])
   187	
   188	
   189	def _parity_clauses(triple, rhs):
   190	    """The four ordinary clauses whose conjunction says xor(triple)=rhs."""
   191	    clauses = []
   192	    for bad in itertools.product((0, 1), repeat=3):
   193	        if (bad[0] ^ bad[1] ^ bad[2]) == rhs:
   194	            continue
   195	        # A positive literal is false at 0; a negative literal is false at 1.
   196	        clauses.append([
   197	            (v + 1) if bit == 0 else -(v + 1)
   198	            for v, bit in zip(triple, bad)
   199	        ])
   200	    return clauses
