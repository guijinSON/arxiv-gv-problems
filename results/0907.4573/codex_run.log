   445	def _clause_bad_tuple(clause):
   446	    """Return (sorted triple, falsifying tuple in sorted variable order)."""
   447	    by_var = {}
   448	    for lit in clause:
   449	        var = abs(lit) - 1
   450	        if var in by_var:
   451	            return None
   452	        by_var[var] = 0 if lit > 0 else 1
   453	    if len(by_var) != 3:
   454	        return None
   455	    triple = tuple(sorted(by_var))
   456	    return triple, tuple(by_var[v] for v in triple)
