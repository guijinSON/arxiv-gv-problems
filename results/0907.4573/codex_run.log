   630	def escalate(params) -> dict | str | None:
   631	    """Use the remaining XOR-operation headroom, then report the route cap."""
   632	    current = dict(params)
   633	    current.pop("_preset", None)
   634	    n = current.get("n")
   635	    decoys = current.get("decoy_rows", 0)
   636	    if not isinstance(n, int) or n < 6 or n % 2:
   637	        return None
   638	    # Grow the haystack without lengthening the answer.  The parity-aware repair
   639	    # attack remains 0/8 through 40 decoy rows, but succeeds on 3/8 already at
   640	    # 48; more consistent constraints create a useful attraction signal.  Thus
   641	    # 40 is the measured ceiling for this fixed-answer-length axis.
   642	    if decoys < 40:
   643	        return {"n": n, "decoy_rows": min(40, decoys + 8)}
   644	    if n < 150:
   645	        return {"n": 150, "decoy_rows": decoys}
   646	    # Any larger core needs >300 XORs after the insight, even though its JSON
   647	    # answer would still fit the character and atom caps.
   648	    return "cap_bound"
