   668	def _unsatisfied_indices(inst, candidate):
   669	    bad = []
   670	    for ci, clause in enumerate(inst["clauses"]):
   671	        if not any((lit > 0 and candidate[abs(lit) - 1] == 1)
   672	                   or (lit < 0 and candidate[abs(lit) - 1] == 0)
   673	                   for lit in clause):
   674	            bad.append(ci)
   675	    return bad
