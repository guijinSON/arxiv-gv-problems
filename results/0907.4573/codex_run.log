+    "Hint: Exact Boolean assignments require careful attention to every literal sign and variable index in the displayed formula."
+)
+
+# Replaced with transcript-derived values after the three oracle runs.  The
+# arms are diagnostics only; G9 pass depends solely on the size/effort caps.
+_G9_EVIDENCE = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
+    },
+    "hinted_verdict": "unavailable: OpenRouter HTTP 403 key limit",
