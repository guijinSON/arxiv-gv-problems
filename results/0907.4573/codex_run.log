   387	def verify(inst, answer) -> tuple[bool, str]:
   388	    """Inspect only the public clauses and candidate, never inst['answer']."""
   389	    if not isinstance(answer, list):
   390	        return False, "answer must be a JSON list"
   391	    n = inst.get("n")
   392	    if not answer:
   393	        return False, "answer is empty"
   394	    if len(answer) < n:
   395	        return False, "assignment is missing %d bit%s" % (
   396	            n - len(answer), "" if n - len(answer) == 1 else "s")
   397	    if len(answer) > n:
   398	        return False, "assignment has %d extra bit%s" % (
   399	            len(answer) - n, "" if len(answer) - n == 1 else "s")
   400	    for i, bit in enumerate(answer, 1):
   401	        if isinstance(bit, bool) or not isinstance(bit, int) or bit not in (0, 1):
   402	            return False, "entry %d is not a Boolean bit" % i
   403	    # Shipping instances ask for all clauses.  Rejecting on the first false
   404	    # clause is exact and keeps the 200k-candidate density measurement cheap.
   405	    if inst["target"] == inst["m"]:
   406	        for ci, clause in enumerate(inst["clauses"], 1):
   407	            if not any(
   408	                (lit > 0 and answer[abs(lit) - 1] == 1)
   409	                or (lit < 0 and answer[abs(lit) - 1] == 0)
   410	                for lit in clause
   411	            ):
   412	                return False, (
   413	                    "threshold missed: clause %d is false, but all %d clauses "
   414	                    "are required" % (ci, inst["target"]))
   415	        return True, "ok"
   416	    satisfied = _satisfied_count(inst, answer)
   417	    if satisfied < inst["target"]:
   418	        return False, "threshold missed: satisfied %d of required %d clauses" % (
   419	            satisfied, inst["target"])
   420	    return True, "ok"
