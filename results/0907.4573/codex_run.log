+
+def _row_support(n, successor, row):
+    """Return the three natural (pre-relabel) columns in one row of A."""
+    half = n // 2
+    if row < half:
+        i = row
+        return (i, successor[i], half + successor[i])
+    i = row - half
+    return (half + i, successor[i], half + successor[i])
+
+
+def _parity_clauses(triple, rhs):
+    """The four exact 3-clauses whose conjunction says xor(triple)=rhs."""
+    clauses = []
+    for bad in itertools.product((0, 1), repeat=3):
+        if (bad[0] ^ bad[1] ^ bad[2]) == rhs:
+            continue
+        clauses.append([
+            (v + 1) if bit == 0 else -(v + 1)
+            for v, bit in zip(triple, bad)
+        ])
+    return clauses
+
+
+def _false_tuple_clause(triple, bad):
+    """A clause false at exactly the supplied three-bit tuple."""
+    return [
+        (v + 1) if bit == 0 else -(v + 1)
+        for v, bit in zip(triple, bad)
+    ]
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate a MAX-3-SAT_tlb instance with a known witness.
+
+    The assignment is sampled before the clauses.  The identity A^2=I proves
+    that the parity core has exactly one solution; the Section 3 conversion
+    carries that certificate to the exact 3-CNF instance.
+    """
+    decoy_pairs = params.pop("decoy_pairs", 0)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(n, bool) or not isinstance(n, int) or n < 6 or n % 2:
+        raise ValueError("n must be an even integer at least 6")
+    if (isinstance(decoy_pairs, bool) or not isinstance(decoy_pairs, int)
+            or decoy_pairs < 0):
+        raise ValueError("decoy_pairs must be a nonnegative integer")
+    max_decoys = (n * (n - 1) * (n - 2)) // 6 - n
+    if decoy_pairs > max_decoys:
+        raise ValueError("too many decoy pairs for distinct variable triples")
+
+    rng = random.Random(seed)
+    half = n // 2
+    cycle = list(range(half))
+    rng.shuffle(cycle)
+    successor = [0] * half
+    for i, here in enumerate(cycle):
+        successor[here] = cycle[(i + 1) % half]
+
+    # Opposite hidden pairs make the two RHS bits associated with a pair
+    # different, providing an intrinsic orientation for canonicalization.
+    natural_answer = [0] * n
+    for i in range(half):
+        bit = rng.randrange(2)
+        natural_answer[i] = bit
+        natural_answer[half + i] = bit ^ 1
+
+    supports = []
+    rhs = []
+    for row in range(n):
+        support = _row_support(n, successor, row)
+        supports.append(support)
+        rhs.append(natural_answer[support[0]]
+                   ^ natural_answer[support[1]]
+                   ^ natural_answer[support[2]])
+
+    old_to_public = list(range(n))
+    rng.shuffle(old_to_public)
+    public_answer = [0] * n
+    for old, new in enumerate(old_to_public):
+        public_answer[new] = natural_answer[old]
+
+    clauses = []
+    core_triples = set()
+    for support, bit in zip(supports, rhs):
+        triple = tuple(old_to_public[v] for v in support)
+        core_triples.add(tuple(sorted(triple)))
+        block = _parity_clauses(triple, bit)
+        for clause in block:
+            rng.shuffle(clause)
+        clauses.extend(block)
+
+    # Every decoy pair forbids complementary tuples, neither of which is the
+    # planted tuple.  Thus both clauses hold and each variable gets one positive
+    # and one negative occurrence from the pair.
+    used_triples = set(core_triples)
+    made = 0
+    while made < decoy_pairs:
+        triple = tuple(sorted(rng.sample(range(n), 3)))
+        if triple in used_triples:
+            continue
+        used_triples.add(triple)
+        planted = tuple(public_answer[v] for v in triple)
+        choices = []
+        for bad in itertools.product((0, 1), repeat=3):
+            complement = tuple(bit ^ 1 for bit in bad)
+            if bad > complement:
+                continue
+            if bad != planted and complement != planted:
+                choices.append((bad, complement))
+        bad, complement = rng.choice(choices)
+        pair = [
+            _false_tuple_clause(triple, bad),
+            _false_tuple_clause(triple, complement),
+        ]
+        for clause in pair:
+            rng.shuffle(clause)
+        clauses.extend(pair)
+        made += 1
+
+    rng.shuffle(clauses)
+    m = len(clauses)
+    k = m
+    return {
+        "r": 3,
+        "n": n,
+        "m": m,
+        "k": k,
+        "threshold": m,
+        "clauses": clauses,
+        "decoy_pairs": decoy_pairs,
+        "answer": public_answer,
+    }
+
+
+def render(inst) -> str:
+    """Render a complete exact MAX-3-SAT-above-lower-bound problem."""
+    n = inst["n"]
+    m = inst["m"]
+    k = inst["k"]
+    lines = [
+        "Find a witness for this exact MAX-3-SAT instance above its tight lower bound.",
+        "",
+        "There are Boolean variables x1 through x%d." % n,
+        "A positive integer j is literal xj; a negative integer -j is NOT xj.",
+        "Each line below is one clause: the OR of its three signed literals.",
+        "The formula is the AND/multiset of all lines; repeated clauses would count",
+        "with multiplicity. Every clause here uses exactly three distinct variables.",
+        "Variable indices and clause numbers are 1-based.",
+        "",
+        "For r=3 and m clauses, the tight random-assignment lower bound is 7m/8.",
+        "The required number is (7m+k)/8. Here m=%d and k=%d, so the" % (m, k),
+        "required number is exactly %d: every clause must be satisfied." % m,
+        "",
+        "Clauses:",
+    ]
+    for i, clause in enumerate(inst["clauses"], 1):
+        lines.append("C%04d: %s" % (i, " ".join("%+d" % x for x in clause)))
+    lines.extend([
+        "",
+        "Your witness must be one JSON list of exactly %d entries in the order" % n,
+        "[x1,x2,...,x%d]. Each entry must be integer 0 (false) or 1 (true);" % n,
+        "order matters and no entry may be omitted or repeated.",
+        "Give your final answer inside <answer></answer> tags.",
+        "Example format: <answer>[0,1,0,1]</answer>",
+        "The example illustrates syntax only and has the wrong length.",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text) -> object | None:
+    """Parse a tagged JSON bit list, tolerating prose and markdown fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    fenced = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body,
+                          flags=re.I | re.S)
+    if fenced:
+        body = fenced.group(1).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, list) else None
+
+
+def _satisfied_count(inst, answer):
+    count = 0
+    for clause in inst["clauses"]:
+        if any((lit > 0 and answer[abs(lit) - 1] == 1)
+               or (lit < 0 and answer[abs(lit) - 1] == 0)
+               for lit in clause):
+            count += 1
+    return count
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check shape and the exact clause threshold without reading inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    n = inst.get("n")
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) < n:
+        return False, "assignment is missing %d bit%s" % (
+            n - len(answer), "" if n - len(answer) == 1 else "s")
+    if len(answer) > n:
+        return False, "assignment has %d extra bit%s" % (
+            len(answer) - n, "" if len(answer) - n == 1 else "s")
+    for i, bit in enumerate(answer, 1):
+        if isinstance(bit, bool) or not isinstance(bit, int) or bit not in (0, 1):
+            return False, "entry %d is not a Boolean bit" % i
+    # All generated instances use k=m, hence threshold=m.  Reject at the first
+    # false clause: this is still the exact threshold test and makes the 200k
+    # structure-aware sample meaningful rather than needlessly expensive.
+    if inst["threshold"] == inst["m"]:
+        for ci, clause in enumerate(inst["clauses"], 1):
+            if not any((lit > 0 and answer[abs(lit) - 1] == 1)
+                       or (lit < 0 and answer[abs(lit) - 1] == 0)
+                       for lit in clause):
+                return False, "clause %d is unsatisfied" % ci
+        return True, "ok"
+    satisfied = _satisfied_count(inst, answer)
+    if 8 * satisfied < 7 * inst["m"] + inst["k"]:
+        return False, "satisfies %d clauses, below the required %d" % (
+            satisfied, inst["threshold"])
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample the exact n-bit certificate language."""
+    return [rng.randrange(2) for _ in range(inst["n"])]
+
+
+def search_space(inst) -> int | None:
+    """Return the number 2^n of syntactically admissible assignments."""
+    return 1 << inst["n"]
+
+
+def enumerate_all(inst) -> int | None:
+    """Brute-force the exact valid-witness count when n <= 20."""
+    n = inst["n"]
+    if n > 20:
+        return None
+    count = 0
+    for mask in range(1 << n):
+        candidate = [(mask >> i) & 1 for i in range(n)]
+        count += int(verify(inst, candidate)[0])
+    return count
+
+
+def _clause_bad_tuple(clause):
+    """Return (sorted support, falsifying tuple in support order)."""
+    by_var = {}
+    for lit in clause:
+        var = abs(lit) - 1
+        if var in by_var:
+            return None
+        by_var[var] = 0 if lit > 0 else 1
+    if len(by_var) != 3:
+        return None
+    triple = tuple(sorted(by_var))
+    return triple, tuple(by_var[v] for v in triple)
+
+
+def _extract_parity_rows(inst):
+    """Extract four-clause parity blocks without consulting the answer."""
+    groups = defaultdict(set)
+    inspections = 0
+    for clause in inst["clauses"]:
+        parsed = _clause_bad_tuple(clause)
+        inspections += len(clause)
+        if parsed is not None:
+            triple, bad = parsed
+            groups[triple].add(bad)
+    rows = []
+    for triple, bads in groups.items():
+        if len(bads) != 4:
+            continue
+        parities = {a ^ b ^ c for a, b, c in bads}
+        if len(parities) == 1:
+            rows.append((triple, next(iter(parities)) ^ 1))
+    return rows, inspections
+
+
+def _gaussian_reference(inst):
+    """Solve extracted parity rows by exact GF(2) elimination; count scalar ops."""
+    n = inst["n"]
+    parity_rows, operations = _extract_parity_rows(inst)
+    packed = []
+    for triple, rhs in parity_rows:
+        mask = 0
+        for col in triple:
+            mask ^= 1 << col
+            operations += 1
+        packed.append(mask | (rhs << n))
+    rank = 0
+    pivot_cols = []
+    for col in range(n):
+        pivot = None
+        for row in range(rank, len(packed)):
+            operations += 1
+            if (packed[row] >> col) & 1:
+                pivot = row
+                break
+        if pivot is None:
+            continue
+        packed[rank], packed[pivot] = packed[pivot], packed[rank]
+        for row in range(len(packed)):
+            if row == rank:
+                continue
+            operations += 1
+            if (packed[row] >> col) & 1:
+                packed[row] ^= packed[rank]
+                operations += n + 1
+        pivot_cols.append(col)
+        rank += 1
+        if rank == len(packed):
+            break
+    if rank < n:
+        return None, operations
+    answer = [0] * n
+    for row_index, col in enumerate(pivot_cols):
+        answer[col] = (packed[row_index] >> n) & 1
+    return answer, operations
+
+
+def _core_coordinates(inst):
+    """Recover intrinsic pair/cycle coordinates for exact canonicalization."""
+    rows, _ = _extract_parity_rows(inst)
+    if len(rows) != inst["n"]:
+        raise ValueError("instance lacks the expected parity core")
+    pair_counts = Counter()
+    for triple, _ in rows:
+        for a, b in itertools.combinations(triple, 2):
+            pair_counts[tuple(sorted((a, b)))] += 1
+    pairs = sorted(pair for pair, count in pair_counts.items() if count == 2)
+    n = inst["n"]
+    if len(pairs) != n // 2 or len({v for p in pairs for v in p}) != n:
+        raise ValueError("parity core does not induce a perfect pairing")
+    pair_of = {}
+    for pid, pair in enumerate(pairs):
+        for v in pair:
+            pair_of[v] = pid
+
+    successor = {}
+    rhs_by_singleton = {}
+    for triple, rhs in rows:
+        grouped = defaultdict(list)
+        for v in triple:
+            grouped[pair_of[v]].append(v)
+        singles = [pid for pid, vs in grouped.items() if len(vs) == 1]
+        doubles = [pid for pid, vs in grouped.items() if len(vs) == 2]
+        if len(singles) != 1 or len(doubles) != 1:
+            raise ValueError("malformed pair incidence")
+        src, dst = singles[0], doubles[0]
+        if src in successor and successor[src] != dst:
+            raise ValueError("inconsistent core successor")
+        successor[src] = dst
+        rhs_by_singleton[grouped[src][0]] = rhs
+
+    side = {}
+    for pair in pairs:
+        bits = sorted((rhs_by_singleton[pair[0]], rhs_by_singleton[pair[1]]))
+        if bits != [0, 1]:
+            raise ValueError("pair lacks intrinsic RHS orientation")
+        for v in pair:
+            side[v] = rhs_by_singleton[v]
+    return pairs, pair_of, successor, side
+
+
+def canonical_key(inst) -> str:
+    """Canonicalize all variable, clause, and within-clause relabellings."""
+    pairs, pair_of, successor, side = _core_coordinates(inst)
+    half = len(pairs)
+    candidates = []
+    for start in range(half):
+        order = []
+        current = start
+        seen = set()
+        while current not in seen:
+            seen.add(current)
+            order.append(current)
+            current = successor[current]
+        if len(order) != half or current != start:
+            raise ValueError("core successor is not one directed cycle")
+        position = {pid: i for i, pid in enumerate(order)}
+        normalized_clauses = []
+        for clause in inst["clauses"]:
+            normalized = []
+            for lit in clause:
+                old = abs(lit) - 1
+                label = 2 * position[pair_of[old]] + side[old] + 1
+                normalized.append(label if lit > 0 else -label)
+            normalized_clauses.append(tuple(sorted(normalized, key=lambda x: abs(x))))
+        normalized_clauses.sort()
+        candidates.append(normalized_clauses)
+    payload = json.dumps(min(candidates), separators=(",", ":"))
+    return "max3sat-tlb-involution-v1:" + hashlib.sha256(payload.encode()).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Grow balanced decoy crowding before lengthening the witness."""
+    current = dict(params)
+    current.pop("_preset", None)
+    n = current.get("n")
+    decoys = current.get("decoy_pairs", 0)
+    if not isinstance(n, int) or n < 6 or n % 2:
+        return None
+    limit = (n * (n - 1) * (n - 2)) // 6 - n
+    harder = min(limit, decoys + n)
+    if harder > decoys:
+        return {"n": n, "decoy_pairs": harder}
+    if n < 120:
+        next_n = min(120, n + 8)
+        return {"n": next_n, "decoy_pairs": min(decoys, next_n * 4)}
+    return "cap_bound"
+
+
+def _attack_signed_occurrence(inst):
+    score = [0] * inst["n"]
+    for clause in inst["clauses"]:
+        for lit in clause:
+            score[abs(lit) - 1] += 1 if lit > 0 else -1
+    return [1 if value > 0 else 0 for value in score]
+
+
+def _attack_public_alternation(inst):
+    return [i & 1 for i in range(inst["n"])]
+
+
+def _unsatisfied_indices(inst, candidate):
+    bad = []
+    for ci, clause in enumerate(inst["clauses"]):
+        if not any((lit > 0 and candidate[abs(lit) - 1] == 1)
+                   or (lit < 0 and candidate[abs(lit) - 1] == 0)
+                   for lit in clause):
+            bad.append(ci)
+    return bad
+
+
+def _attack_greedy_repair(inst):
+    candidate = _attack_signed_occurrence(inst)
+    for _ in range(2 * inst["n"]):
+        bad = _unsatisfied_indices(inst, candidate)
+        if not bad:
+            break
+        clause = inst["clauses"][bad[0]]
+        best = None
+        for lit in clause:
+            var = abs(lit) - 1
+            candidate[var] ^= 1
+            remaining = len(_unsatisfied_indices(inst, candidate))
+            candidate[var] ^= 1
+            trial = (remaining, var)
+            if best is None or trial < best:
+                best = trial
+        candidate[best[1]] ^= 1
+    return candidate
+
+
+def _attack_rhs_vote(inst):
+    rows, _ = _extract_parity_rows(inst)
+    votes = [[] for _ in range(inst["n"])]
+    for triple, rhs in rows:
+        for var in triple:
+            votes[var].append(rhs)
+    return [int(sum(vs) * 2 > len(vs)) if vs else 0 for vs in votes]
+
+
+def _relabel_instance(inst, old_to_new, rng):
+    """Carry a witness through a genuine variable relabelling and reorder input."""
+    n = inst["n"]
+    if sorted(old_to_new) != list(range(n)):
+        raise ValueError("old_to_new must be a permutation")
+    clauses = []
+    for clause in inst["clauses"]:
+        moved = []
+        for lit in clause:
+            new = old_to_new[abs(lit) - 1] + 1
+            moved.append(new if lit > 0 else -new)
+        rng.shuffle(moved)
+        clauses.append(moved)
+    rng.shuffle(clauses)
+    carried = [0] * n
+    for old, new in enumerate(old_to_new):
+        carried[new] = inst["answer"][old]
+    return {
+        "r": 3,
+        "n": n,
+        "m": inst["m"],
+        "k": inst["k"],
+        "threshold": inst["threshold"],
+        "clauses": clauses,
+        "decoy_pairs": inst.get("decoy_pairs", 0),
+        "answer": carried,
+    }
+
+
+def selftest() -> dict:
+    """Run all mandatory gates and return their measurements."""
+    report = {}
+
+    verified = 0
+    attempts = 0
+    for params in DIFFICULTY.values():
+        for seed in (0, 1, 2):
+            inst = make_instance(seed=seed, **params)
+            verified += int(verify(inst, inst["answer"])[0])
+            attempts += 1
+    report["G1_planted_verifies"] = {
+        "pass": verified == attempts,
+        "verified": verified,
+        "attempts": attempts,
+        "generation_route": "inverse generation plus paper-licensed parity-to-CNF conversion",
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=314159, **shipping_params)
+    base = shipping["answer"]
+    swapped = base[:]
+    left = next(i for i, bit in enumerate(swapped) if bit == 0)
+    right = next(i for i, bit in enumerate(swapped) if bit == 1)
+    swapped[left], swapped[right] = swapped[right], swapped[left]
+    corruptions = {
+        "drop": base[:-1],
+        "swap": swapped,
+        "duplicate": base + [base[-1]],
+        "empty": [],
+        "out_of_range": [2] + base[1:],
+    }
+    cases = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
+        cases[name] = {"rejected": not ok, "reason": reason}
+    reasons = {case["reason"] for case in cases.values()}
+    report["G2_rejects_corruption"] = {
+        "pass": all(case["rejected"] for case in cases.values()) and len(reasons) == 5,
+        "cases": cases,
+        "distinct_reasons": len(reasons),
+    }
+
+    encoded = json.dumps(base, separators=(",", ":"))
+    realistic = (
+        "The parity blocks determine the truth values.\n"
+        "<answer>```json\n" + encoded + "\n```</answer>\n"
+        "I checked the threshold exactly."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": (parsed == base and json.loads(json.dumps(base)) == base
+                 and parse_answer("garbage") is None),
+        "parsed_equals_answer": parsed == base,
+        "json_native": json.loads(json.dumps(base)) == base,
+        "garbage_returns_none": parse_answer("garbage") is None,
+    }
+
+    guess_rng = random.Random(8675309)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        guess_hits += int(verify(
+            shipping, random_candidate(shipping, guess_rng))[0])
+    guess_rate = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_total >= 200_000 and guess_rate < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_rate,
+        "candidate_space": search_space(shipping),
+        "prior": "uniform over all exactly-shaped n-bit assignments",
+    }
+
+    t0 = time.perf_counter()
+    reference_answer, reference_ops = _gaussian_reference(shipping)
+    reference_sec = time.perf_counter() - t0
+    reference_ok = (reference_answer is not None
+                    and verify(shipping, reference_answer)[0])
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": (guess_total >= 200_000 and guess_rate < 1e-6
+                 and reference_ok and demo_count == 1),
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_density_fraction": guess_rate,
+        "shipping_exact_enumeration": enumerate_all(shipping),
+        "construction_exact_solution_count": 1,
+        "construction_exact_density": "1/2^%d" % shipping["n"],
+        "demo_exact_solution_count": demo_count,
+        "baseline_algorithm": "XOR-block extraction plus exact GF(2) Gaussian elimination",
+        "baseline_wall_clock_seconds": round(reference_sec, 6),
+        "baseline_scalar_operations": reference_ops,
+        "baseline_verified": reference_ok,
+    }
+
+    attacks = {
+        "outlier_signed_occurrence": {"successes": 0, "attempts": 8},
+        "public_order_alternation": {"successes": 0, "attempts": 8},
+        "greedy_clause_repair_2n": {"successes": 0, "attempts": 8},
+        "random_restart_512": {"successes": 0, "attempts": 8},
+        "xor_rhs_local_vote": {"successes": 0, "attempts": 8},
+    }
+    reference_successes = 0
+    reference_operations = []
+    reference_times = []
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed, **shipping_params)
+        candidates = {
+            "outlier_signed_occurrence": _attack_signed_occurrence(inst),
+            "public_order_alternation": _attack_public_alternation(inst),
+            "greedy_clause_repair_2n": _attack_greedy_repair(inst),
+            "xor_rhs_local_vote": _attack_rhs_vote(inst),
+        }
+        for name, candidate in candidates.items():
+            attacks[name]["successes"] += int(verify(inst, candidate)[0])
+        rrng = random.Random(seed ^ 0x5A17)
+        restart_hit = False
+        for _ in range(512):
+            if verify(inst, random_candidate(inst, rrng))[0]:
+                restart_hit = True
+                break
+        attacks["random_restart_512"]["successes"] += int(restart_hit)
+        rt0 = time.perf_counter()
+        candidate, operations = _gaussian_reference(inst)
+        reference_times.append(time.perf_counter() - rt0)
+        reference_operations.append(operations)
+        reference_successes += int(
+            candidate is not None and verify(inst, candidate)[0])
+    all_failed = all(value["successes"] == 0 and value["attempts"] >= 8
+                     for value in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "XOR-block extraction plus exact GF(2) Gaussian elimination",
+            "complexity": "O(m log m + n^3) exact binary operations",
+            "wall_clock_sec_mean": round(sum(reference_times) / len(reference_times), 6),
+            "wall_clock_sec_max": round(max(reference_times), 6),
+            "operations_mean": round(sum(reference_operations) / len(reference_operations)),
+            "operations_max": max(reference_operations),
+            "solves": "%d/8, as expected" % reference_successes,
+        },
+    }
+
+    doubled = make_instance(
+        n=2 * shipping["n"],
+        decoy_pairs=2 * shipping["decoy_pairs"],
+        seed=2718,
+    )
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": (doubled_ok and doubled["n"] > shipping["n"]
+                 and search_space(doubled) > search_space(shipping)),
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "shipping_clause_count": shipping["m"],
+        "doubled_clause_count": doubled["m"],
+        "doubled_planted_verifies": doubled_ok,
+        "shipping_search_space_bits": shipping["n"],
+        "doubled_search_space_bits": doubled["n"],
+    }
+
+    invariant = 0
+    carried_valid = 0
+    for seed in range(20):
+        inst = make_instance(seed=1000 + seed, **shipping_params)
+        rrng = random.Random(9000 + seed)
+        first = list(range(inst["n"]))
+        second = list(range(inst["n"]))
+        rrng.shuffle(first)
+        rrng.shuffle(second)
+        composed = [second[first[old]] for old in range(inst["n"])]
+        transformed = _relabel_instance(inst, composed, rrng)
+        invariant += int(canonical_key(inst) == canonical_key(transformed))
+        carried_valid += int(verify(transformed, transformed["answer"])[0])
+    unrelated = {
+        canonical_key(make_instance(seed=2000 + seed, **shipping_params))
+        for seed in range(20)
+    }
+    report["G8_canonical_key"] = {
+        "pass": invariant == 20 and carried_valid == 20 and len(unrelated) == 20,
+        "composed_relabellings_invariant": invariant,
+        "carried_witnesses_valid": carried_valid,
+        "unrelated_distinct_keys": len(unrelated),
+        "attempts_each": 20,
+        "normalized_symmetries": [
+            "variable renumbering",
+            "clause reordering",
+            "literal reordering within clauses",
+            "rotation of the intrinsic directed pair cycle",
+        ],
+    }
+
+    answer_chars = 0
+    answer_atoms = 0
+    answer_tokens = 0
+    for seed in range(40):
+        answer = make_instance(seed=3000 + seed, **shipping_params)["answer"]
+        wire = json.dumps(answer, separators=(",", ":"))
+        answer_chars = max(answer_chars, len(wire))
+        answer_atoms = max(answer_atoms, len(answer))
+        answer_tokens = max(answer_tokens, (len(wire) + 3) // 4)
+    intended_ops = 2 * shipping["n"]
+    arms = _G9_EVIDENCE["arms"]
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = (answer_chars <= 2000 and answer_atoms <= 256
+                   and intended_ops <= 300)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": _G9_EVIDENCE["hinted_verdict"],
+        "diagnostic_not_gated": True,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_atoms,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        value.get("pass") for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = shipping_params
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

