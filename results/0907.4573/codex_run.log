   761	be an indicator variable whose value is set as $\delta_C(x)=1$ if $x\in
   762	C$, $\delta_C(x)=-1$ if $\ol{x}\in C$, and $\delta_C(x)=0$ otherwise.
   763	
   764	\begin{lemma}\label{lem:above}
   765	  For each subset $R=\{x_1,\ldots ,x_q\}\subseteq \var(F)$ we have
   766	  $\sat(F)\geq (3m +k_R)/4$ for
   767	  \[
   768	  k_R= \sum_{1\leq i \leq q} (c(x_i)-c(\ol{x_i})) +
   769	  \sum_{1\leq i < j \leq q}
   770	  \big(
   771	 c(x_i\ol{x_j})+c(\ol{x_i}x_j)
   772	  -c(x_ix_j)-c(\ol{x_i}\ol{x_j})
   773	  \big).
   774	\]
   775	\end{lemma}
