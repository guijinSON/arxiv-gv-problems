   678	def _attack_greedy_repair(inst):
   679	    candidate = _attack_literal_majority(inst)
   680	    for _ in range(inst["n"]):
   681	        bad = _unsatisfied_indices(inst, candidate)
   682	        if not bad:
   683	            break
   684	        clause = inst["clauses"][bad[0]]
   685	        best = None
   686	        for lit in clause:
   687	            var = abs(lit) - 1
   688	            candidate[var] ^= 1
   689	            remaining = len(_unsatisfied_indices(inst, candidate))
   690	            candidate[var] ^= 1
   691	            trial = (remaining, var)
   692	            if best is None or trial < best:
   693	                best = trial
   694	        candidate[best[1]] ^= 1
   695	    return candidate
