   203	def make_instance(n, seed=0, **params) -> dict:
   204	    """Inverse-generate a Max-3-SAT-above-average witness instance."""
   205	    decoy_rows = params.pop("decoy_rows", 0)
   206	    if params:
   207	        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
   208	    if isinstance(n, bool) or not isinstance(n, int) or n < 6 or n % 2:
   209	        raise ValueError("n must be an even integer at least 6")
   210	    if (isinstance(decoy_rows, bool) or not isinstance(decoy_rows, int)
   211	            or decoy_rows < 0):
   212	        raise ValueError("decoy_rows must be a nonnegative integer")
   213	    max_decoys = n * (n - 6) // 12
   214	    if decoy_rows > max_decoys:
   215	        raise ValueError("too many decoy rows for the linear-triple packing")
   216	
   217	    rng = random.Random(seed)
   218	    half = n // 2
   219	    cycle = list(range(half))
   220	    rng.shuffle(cycle)
   221	    successor = [0] * half
   222	    for pos, here in enumerate(cycle):
   223	        successor[here] = cycle[(pos + 1) % half]
   224	
   225	    natural_answer = [rng.randrange(2) for _ in range(n)]
   226	    supports = [_row_support(n, successor, row) for row in range(n)]
   227	    rhs = [
   228	        natural_answer[a] ^ natural_answer[b] ^ natural_answer[c]
   229	        for a, b, c in supports
   230	    ]
   231	
   232	    old_to_public = list(range(n))
   233	    rng.shuffle(old_to_public)
   234	    public_answer = [0] * n
   235	    for old, new in enumerate(old_to_public):
   236	        public_answer[new] = natural_answer[old]
   237	
   238	    row_units = []
   239	    core_triples = set()
   240	    # Each parity block is presented contiguously, but block order, clause order,
   241	    # and literal order are random.  In particular, the paired core rows are not
   242	    # adjacent: finding their repeated two-variable supports is the structural
   243	    # recognition task, not a presentation-order clue.
   244	    for support, bit in zip(supports, rhs):
   245	        triple = tuple(old_to_public[v] for v in support)
   246	        core_triples.add(tuple(sorted(triple)))
   247	        block = _parity_clauses(triple, bit)
   248	        for clause in block:
   249	            rng.shuffle(clause)
   250	        rng.shuffle(block)
   251	        row_units.append(block)
   252	
   253	    used_triples = set(core_triples)
   254	    used_pairs = {
   255	        tuple(sorted(pair))
   256	        for triple in core_triples
   257	        for pair in itertools.combinations(triple, 2)
   258	    }
   259	    made = 0
   260	    while made < decoy_rows:
   260	    while made < decoy_rows:
   261	        triple = tuple(sorted(rng.sample(range(n), 3)))
   262	        triple_pairs = {
   263	            tuple(sorted(pair)) for pair in itertools.combinations(triple, 2)
   264	        }
   265	        if triple in used_triples or not triple_pairs.isdisjoint(used_pairs):
   266	            continue
   267	        used_triples.add(triple)
   268	        used_pairs.update(triple_pairs)
