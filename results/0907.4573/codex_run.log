   581	def canonical_key(inst) -> str:
   582	    """A sign-switch and relabelling-invariant WL key of the row hypergraph.
   583	
   584	    Variable polarity switching changes parity right-hand sides but not row
   585	    supports.  Because the core is invertible, all consistent right-hand sides
   586	    on a fixed support hypergraph are related by such a switch.  Stable color
   587	    refinement is the strongest cheap invariant used here; it is deliberately
   588	    not a hash of the seed or rendered statement.
   589	    """
   590	    counts = Counter()
   591	    for clause in inst["clauses"]:
   592	        triple = tuple(sorted(abs(lit) - 1 for lit in clause))
   593	        counts[triple] += 1
   594	    rows = sorted(triple for triple, count in counts.items() if count == 4)
   595	    n = inst["n"]
   596	    incident = [[] for _ in range(n)]
   597	    for rid, triple in enumerate(rows):
   598	        for var in triple:
   599	            incident[var].append(rid)
   600	
   601	    degrees = [len(rs) for rs in incident]
   602	    degree_values = {value: i for i, value in enumerate(sorted(set(degrees)))}
   603	    vcolor = [degree_values[value] for value in degrees]
   604	    rcolor = [0] * len(rows)
   605	    history = []
   606	    for _ in range(2 * n + 2):
   607	        vsig = [(vcolor[v], tuple(sorted(rcolor[r] for r in incident[v])))
   608	                for v in range(n)]
   609	        rsig = [(rcolor[r], tuple(sorted(vcolor[v] for v in rows[r])))
   610	                for r in range(len(rows))]
   611	        vmap = {sig: i for i, sig in enumerate(sorted(set(vsig)))}
   612	        rmap = {sig: i for i, sig in enumerate(sorted(set(rsig)))}
   613	        new_v = [vmap[sig] for sig in vsig]
   614	        new_r = [rmap[sig] for sig in rsig]
   615	        history.append((
   616	            sorted(Counter(new_v).items()),
   617	            sorted(Counter(new_r).items()),
   618	        ))
   619	        if new_v == vcolor and new_r == rcolor:
   620	            vcolor, rcolor = new_v, new_r
   621	            break
   622	        vcolor, rcolor = new_v, new_r
   623	    row_patterns = sorted(tuple(sorted(vcolor[v] for v in triple))
   624	                          for triple in rows)
   625	    payload = json.dumps(
   626	        [n, len(rows), history, row_patterns], separators=(",", ":"))
   627	    return "xor-row-wl-v1:" + hashlib.sha256(payload.encode()).hexdigest()
   628	
