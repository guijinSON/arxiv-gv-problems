   480	def _gaussian_reference(inst):
   481	    """Solve all extracted rows by exact GF(2) RREF and count bit work."""
   482	    n = inst["n"]
   483	    parity_rows, operations = _extract_parity_rows(inst)
   484	    packed = []
   485	    for triple, rhs in parity_rows:
   486	        mask = 0
   487	        for col in triple:
   488	            mask ^= 1 << col
   489	            operations += 1
   490	        packed.append(mask | (rhs << n))
   491	    rank = 0
   492	    pivot_cols = []
   493	    for col in range(n):
   494	        pivot = None
   495	        for row in range(rank, len(packed)):
   496	            operations += 1
   497	            if (packed[row] >> col) & 1:
   498	                pivot = row
   499	                break
   500	        if pivot is None:
   501	            continue
   502	        packed[rank], packed[pivot] = packed[pivot], packed[rank]
   503	        for row in range(len(packed)):
   504	            if row == rank:
   505	                continue
   506	            operations += 1
   507	            if (packed[row] >> col) & 1:
   508	                packed[row] ^= packed[rank]
   509	                operations += n + 1
   510	        pivot_cols.append(col)
   511	        rank += 1
   512	        if rank == n:
   513	            break
   514	    if rank < n:
   515	        return None, operations
   516	    answer = [0] * n
   517	    for row_index, col in enumerate(pivot_cols):
   518	        answer[col] = (packed[row_index] >> n) & 1
   519	    return answer, operations
   520	
