   522	def _core_coordinates(inst):
   523	    """Recover the repeated-pair core from public parity rows."""
   524	    rows, inspections = _extract_parity_rows(inst)
   525	    expected = inst["n"] + inst.get("decoy_rows", 0)
   526	    if len(rows) != expected:
   527	        raise ValueError("instance does not contain the expected parity rows")
   528	    pair_counts = Counter()
   529	    for triple, _ in rows:
   530	        for pair in itertools.combinations(triple, 2):
   531	            pair_counts[tuple(sorted(pair))] += 1
   532	    pairs = sorted(pair for pair, count in pair_counts.items() if count == 2)
   533	    n = inst["n"]
   534	    if len(pairs) != n // 2 or len({v for pair in pairs for v in pair}) != n:
   535	        raise ValueError("parity core does not induce the required perfect pairing")
   536	    pair_of = {}
   537	    for pid, pair in enumerate(pairs):
   538	        for var in pair:
   539	            pair_of[var] = pid
   540	
   541	    distinguished = set(pairs)
   542	    core_rows = [
   543	        (triple, rhs) for triple, rhs in rows
   544	        if any(tuple(sorted(pair)) in distinguished
   545	               for pair in itertools.combinations(triple, 2))
   546	    ]
   547	    if len(core_rows) != n:
   548	        raise ValueError("pair co-degree did not isolate the expected core")
   549	
   550	    successor = {}
   551	    rhs_by_variable = {}
   552	    for triple, rhs in core_rows:
   553	        grouped = defaultdict(list)
   554	        for var in triple:
   555	            grouped[pair_of[var]].append(var)
   556	        singles = [pid for pid, vs in grouped.items() if len(vs) == 1]
   557	        doubles = [pid for pid, vs in grouped.items() if len(vs) == 2]
   558	        if len(singles) != 1 or len(doubles) != 1:
   559	            raise ValueError("malformed pair incidence")
   560	        src, dst = singles[0], doubles[0]
   561	        singleton = grouped[src][0]
   562	        if src in successor and successor[src] != dst:
   563	            raise ValueError("inconsistent core successor")
   564	        successor[src] = dst
   565	        rhs_by_variable[singleton] = rhs
   566	    if len(successor) != n // 2 or len(rhs_by_variable) != n:
   567	        raise ValueError("incomplete core coordinates")
   568	    return pairs, pair_of, successor, rhs_by_variable, inspections
   569	
