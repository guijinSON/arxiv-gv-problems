   757	def _relabel_and_switch(inst, old_to_new, flips, rng):
   758	    """Apply genuine variable renaming and polarity switching symmetries."""
   759	    n = inst["n"]
   760	    if sorted(old_to_new) != list(range(n)) or len(flips) != n:
   761	        raise ValueError("bad relabelling or switch vector")
   762	    clauses = []
   763	    for clause in inst["clauses"]:
   764	        moved = []
   765	        for lit in clause:
   766	            old = abs(lit) - 1
   767	            sign = 1 if lit > 0 else -1
   768	            if flips[old]:
   769	                sign *= -1
   770	            moved.append(sign * (old_to_new[old] + 1))
   771	        rng.shuffle(moved)
   772	        clauses.append(moved)
   773	    rng.shuffle(clauses)
   774	    carried = [0] * n
   775	    for old, new in enumerate(old_to_new):
   776	        carried[new] = inst["answer"][old] ^ flips[old]
   777	    transformed = dict(inst)
   778	    transformed["clauses"] = clauses
   779	    transformed["answer"] = carried
   780	    return transformed
