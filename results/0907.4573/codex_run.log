+def _parity_violations(rows, candidate):
+    return [
+        ri for ri, (triple, rhs) in enumerate(rows)
+        if (candidate[triple[0]] ^ candidate[triple[1]]
+            ^ candidate[triple[2]]) != rhs
+    ]
+
