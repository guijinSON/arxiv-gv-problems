   651	def _attack_literal_majority(inst):
   652	    score = [0] * inst["n"]
   653	    for clause in inst["clauses"]:
   654	        for lit in clause:
   655	            score[abs(lit) - 1] += 1 if lit > 0 else -1
   656	    return [int(value > 0) for value in score]
