+    from gvlib import exact_matrices, rationals
+except ImportError:                 # pragma: no cover - fallback is intentional
+    exact_matrices = rationals = None
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "logic",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "multiset of exact 3-CNF clauses",
+        "Boolean truth assignment",
+    ],
+    "verification_operations": [
+        "Boolean literal evaluation",
+        "exact satisfied-clause count",
+        "integer threshold comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Four clauses on one variable triple encode one parity row, and the "
+        "coupled row operator is an involution, so applying it twice recovers "
+        "the assignment without general MAX-SAT search."
+    ),
+    "hardness_basis": (
+        "Track B: Section 3, Theorem 1 gives an O(m)+2^{O(k^2)} general "
+        "algorithm, while XOR-block extraction and GF(2) elimination solve this "
+        "distribution in O(m log m+n^3), measured at 26,145 scalar operations "
+        "and 0.009457 seconds mean on the hard preset; the involution route uses "
+        "160 binary XORs after the structure is recognized."
+    ),
+    "max_answer_tokens": 41,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
