   519	            grouped[pair_of[var]].append(var)
   520	        singles = [pid for pid, vs in grouped.items() if len(vs) == 1]
   521	        doubles = [pid for pid, vs in grouped.items() if len(vs) == 2]
   522	        if len(singles) != 1 or len(doubles) != 1:
   523	            raise ValueError("malformed pair incidence")
