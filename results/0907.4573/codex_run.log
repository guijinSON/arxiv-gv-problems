   783	def _answer_atom_count(value):
   784	    if isinstance(value, dict):
   785	        return sum(_answer_atom_count(v) for v in value.values())
   786	    if isinstance(value, (list, tuple)):
   787	        return sum(_answer_atom_count(v) for v in value)
   788	    return 1
