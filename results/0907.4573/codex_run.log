   594	def escalate(params) -> dict | str | None:
   595	    """Grow same-format row crowding first; lengthen the witness only later."""
   596	    current = dict(params)
   597	    current.pop("_preset", None)
   598	    n = current.get("n")
   599	    decoys = current.get("decoy_rows", 0)
   600	    if not isinstance(n, int) or n < 6 or n % 2:
   601	        return None
   602	    packing_limit = n * (n - 6) // 12
   603	    useful_limit = min(packing_limit, 4 * n)
   604	    if decoys < useful_limit:
   605	        return {"n": n, "decoy_rows": min(useful_limit, decoys + n)}
