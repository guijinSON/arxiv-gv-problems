   844	        "parsed_equals_answer": parsed == base,
   845	        "json_native": json.loads(json.dumps(base)) == base,
   846	        "garbage_returns_none": parse_answer("not an answer") is None,
   847	    }
   848	
   849	    guess_rng = random.Random(8675309)
   850	    guess_total = 200_000
