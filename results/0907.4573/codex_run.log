python3 - <<'PY'
import importlib.util, json, os, random
p='gen_0907_4573.py'
s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
# Determinism and JSON-native answers across presets/seeds.
for name, params in g.DIFFICULTY.items():
    for seed in range(25):
        a=g.make_instance(seed=seed,**params)
        b=g.make_instance(seed=seed,**params)
        assert a==b, (name,seed,'nondeterministic')
        assert json.loads(json.dumps(a['answer']))==a['answer']
        assert g.verify(a,a['answer'])[0]
        public=dict(a); public.pop('answer')
        assert g.verify(public,a['answer'])[0], (name,seed,'verify read answer')
        compact,ops,_=g._involution_compact_route(a)
        assert compact==a['answer'] and ops==2*a['n']
# Exhaustively prove uniqueness for every supported demo seed in a wider sample.
for seed in range(40):
    inst=g.make_instance(seed=seed,**g.DIFFICULTY['demo'])
    assert g.enumerate_all(inst)==1
# Default render has no hint; opt-in modes append exactly one.
inst=g.make_instance(seed=3,**g.DIFFICULTY['demo'])
os.environ.pop('GV_HINT_MODE',None)
assert g.STRUCTURAL_HINT not in g.render(inst) and g.PLACEBO_HINT not in g.render(inst)
os.environ['GV_HINT_MODE']='structural'; assert g.render(inst).endswith(g.STRUCTURAL_HINT)
os.environ['GV_HINT_MODE']='placebo'; assert g.render(inst).endswith(g.PLACEBO_HINT)
os.environ.pop('GV_HINT_MODE',None)
# Broader cheap-invariant collision and relabelling stress.
params=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
keys=[]
for seed in range(100):
    inst=g.make_instance(seed=50000+seed,**params); keys.append(g.canonical_key(inst))
    rr=random.Random(70000+seed); perm=list(range(inst['n'])); rr.shuffle(perm)
    flips=[rr.randrange(2) for _ in range(inst['n'])]
    moved=g._relabel_and_switch(inst,perm,flips,rr)
    assert g.canonical_key(moved)==keys[-1]
    assert g.verify(moved,moved['answer'])[0]
assert len(set(keys))==100, len(set(keys))
print('targeted_audit_ok presets=4 seeds=100 demo_unique=40 canonical_distinct=100/100')
print('render_chars_hard=',len(g.render(g.make_instance(seed=1,**params))))
