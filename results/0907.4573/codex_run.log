   459	def _extract_parity_rows(inst):
   460	    """Reverse the paper's four-clause expansion exactly."""
   461	    groups = defaultdict(set)
   462	    inspections = 0
   463	    for clause in inst["clauses"]:
   464	        parsed = _clause_bad_tuple(clause)
   465	        inspections += len(clause)
   466	        if parsed is not None:
   467	            triple, bad = parsed
   468	            groups[triple].add(bad)
   469	    rows = []
   470	    for triple, bads in groups.items():
   471	        if len(bads) != 4:
   472	            continue
   473	        parities = {a ^ b ^ c for a, b, c in bads}
   474	        if len(parities) != 1:
   475	            continue
   476	        rows.append((triple, next(iter(parities)) ^ 1))
   477	    return rows, inspections
