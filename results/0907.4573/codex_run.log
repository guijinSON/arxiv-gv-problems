def walksat(inst, seed, restarts=64, flips=20_000):
    rng=random.Random(seed)
    n=inst['n']; cls=inst['clauses']
    for rr in range(restarts):
        a=[rng.randrange(2) for _ in range(n)]
        for st in range(flips//restarts):
            bad=g._unsatisfied_indices(inst,a)
            if not bad: return a,rr,st
            clause=cls[rng.choice(bad)]
            if rng.random()<0.35:
                v=abs(rng.choice(clause))-1
            else:
                trials=[]
                for lit in clause:
                    v=abs(lit)-1; a[v]"'^=1
                    remain=len(g._unsatisfied_indices(inst,a)); a[v]''^=1
                    trials.append((remain,rng.random(),v))
                v=min(trials)[2]
            a[v]''^=1
    return a,None,None

