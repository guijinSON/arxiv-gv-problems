   460	            operations += 1
   461	            if (packed[row] >> col) & 1:
   462	                pivot = row
   463	                break
   464	        if pivot is None:
   465	            continue
   466	        packed[rank], packed[pivot] = packed[pivot], packed[rank]
   467	        for row in range(len(packed)):
   468	            if row == rank:
   469	                continue
   470	            operations += 1
   471	            if (packed[row] >> col) & 1:
   472	                packed[row] ^= packed[rank]
   473	                operations += n + 1
