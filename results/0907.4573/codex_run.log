   433	def enumerate_all(inst) -> int | None:
   434	    """Count exactly only when the full language has at most 2^20 words."""
   435	    n = inst["n"]
   436	    if n > 20:
   437	        return None
   438	    count = 0
   439	    for mask in range(1 << n):
   440	        candidate = [(mask >> i) & 1 for i in range(n)]
   441	        count += int(verify(inst, candidate)[0])
   442	    return count
