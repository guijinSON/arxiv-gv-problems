   545	def canonical_key(inst) -> str:
   546	    """A sign-switch and relabelling-invariant WL key of the row hypergraph.
   547	
   548	    Variable polarity switching changes parity right-hand sides but not row
   549	    supports.  Because the core is invertible, all consistent right-hand sides
   550	    on a fixed support hypergraph are related by such a switch.  Stable color
   551	    refinement is the strongest cheap invariant used here; it is deliberately
   552	    not a hash of the seed or rendered statement.
   553	    """
   554	    counts = Counter()
   555	    for clause in inst["clauses"]:
   556	        triple = tuple(sorted(abs(lit) - 1 for lit in clause))
   557	        counts[triple] += 1
   558	    rows = sorted(triple for triple, count in counts.items() if count == 4)
   559	    n = inst["n"]
   560	    incident = [[] for _ in range(n)]
   561	    for rid, triple in enumerate(rows):
   562	        for var in triple:
   563	            incident[var].append(rid)
   564	
   565	    degrees = [len(rs) for rs in incident]
   566	    degree_values = {value: i for i, value in enumerate(sorted(set(degrees)))}
   567	    vcolor = [degree_values[value] for value in degrees]
   568	    rcolor = [0] * len(rows)
   569	    history = []
   570	    for _ in range(2 * n + 2):
   571	        vsig = [(vcolor[v], tuple(sorted(rcolor[r] for r in incident[v])))
   572	                for v in range(n)]
   573	        rsig = [(rcolor[r], tuple(sorted(vcolor[v] for v in rows[r])))
   574	                for r in range(len(rows))]
   575	        vmap = {sig: i for i, sig in enumerate(sorted(set(vsig)))}
   576	        rmap = {sig: i for i, sig in enumerate(sorted(set(rsig)))}
   577	        new_v = [vmap[sig] for sig in vsig]
   578	        new_r = [rmap[sig] for sig in rsig]
   579	        history.append((
   580	            sorted(Counter(new_v).items()),
   581	            sorted(Counter(new_r).items()),
   582	        ))
   583	        if new_v == vcolor and new_r == rcolor:
   584	            vcolor, rcolor = new_v, new_r
   585	            break
   586	        vcolor, rcolor = new_v, new_r
   587	    row_patterns = sorted(tuple(sorted(vcolor[v] for v in triple))
   588	                          for triple in rows)
   589	    payload = json.dumps(
   590	        [n, len(rows), history, row_patterns], separators=(",", ":"))
   591	    return "xor-row-wl-v1:" + hashlib.sha256(payload.encode()).hexdigest()
