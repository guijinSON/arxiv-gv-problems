   736	def _attack_short_period(inst):
   737	    best = None
   738	    for period in range(1, 7):
   739	        for mask in range(1 << period):
   740	            candidate = [(mask >> (i % period)) & 1 for i in range(inst["n"])]
   741	            trial = (-_satisfied_count(inst, candidate), period, mask, candidate)
   742	            if best is None or trial[:3] < best[:3]:
   743	                best = trial
   744	    return best[3]
