   571	def _involution_compact_route(inst):
   572	    """Use A^2=I to recover the unique assignment in exactly 2n XORs."""
   573	    pairs, pair_of, successor, rhs, inspections = _core_coordinates(inst)
   574	    answer = [0] * inst["n"]
   575	    for var in range(inst["n"]):
   576	        a, b = pairs[successor[pair_of[var]]]
   577	        answer[var] = rhs[var] ^ rhs[a] ^ rhs[b]
   578	    return answer, 2 * inst["n"], inspections
