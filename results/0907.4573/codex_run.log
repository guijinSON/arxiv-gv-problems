   706	def _attack_randomized_parity_repair(inst, rng):
   707	    """A tool-free-style local search after noticing the parity blocks."""
   708	    rows, _ = _extract_parity_rows(inst)
   709	    incident = [[] for _ in range(inst["n"])]
   710	    for row_index, (triple, _) in enumerate(rows):
   711	        for var in triple:
   712	            incident[var].append(row_index)
   713	    for _ in range(32):
   714	        candidate = [rng.randrange(2) for _ in range(inst["n"])]
   715	        bad = set(_parity_violations(rows, candidate))
   716	        for _ in range(8 * inst["n"]):
   717	            if not bad:
   718	                return candidate
   719	            triple, _ = rows[rng.choice(tuple(bad))]
   720	            choices = []
   721	            for var in triple:
   722	                bad_incident = sum(row in bad for row in incident[var])
   723	                remaining = len(bad) + len(incident[var]) - 2 * bad_incident
   724	                choices.append((
   725	                    remaining, rng.random(), var))
   726	            chosen = min(choices)[2]
   727	            candidate[chosen] ^= 1
   728	            for row in incident[chosen]:
   729	                if row in bad:
   730	                    bad.remove(row)
   731	                else:
   732	                    bad.add(row)
   733	    return candidate
