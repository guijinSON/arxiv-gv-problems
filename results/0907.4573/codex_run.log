   347	        "Output nothing else inside the tags.",
   348	    ])
   349	    mode = os.environ.get("GV_HINT_MODE")
   350	    if mode == "structural":
   351	        lines.extend(["", STRUCTURAL_HINT])
   352	    elif mode == "placebo":
   353	        lines.extend(["", PLACEBO_HINT])
