   376	def _satisfied_count(inst, answer):
   377	    count = 0
   378	    for clause in inst["clauses"]:
   379	        count += int(any(
   380	            (lit > 0 and answer[abs(lit) - 1] == 1)
   381	            or (lit < 0 and answer[abs(lit) - 1] == 0)
   382	            for lit in clause
   383	        ))
   384	    return count
