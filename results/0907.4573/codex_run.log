   816	        "drop": base[:-1],
   817	        "swap": swap,
   818	        "duplicate": base + [base[-1]],
   819	        "empty": [],
   820	        "out_of_range": [2] + base[1:],
   821	    }
   822	    corruption_results = {}
   823	    for name, candidate in corruptions.items():
   824	        ok, reason = verify(shipping, candidate)
   825	        corruption_results[name] = {"rejected": not ok, "reason": reason}
   826	    reasons = {result["reason"] for result in corruption_results.values()}
   827	    report["G2_rejects_corruption"] = {
   828	        "pass": (all(item["rejected"] for item in corruption_results.values())
   829	                 and len(reasons) == len(corruption_results)),
   830	        "cases": corruption_results,
   831	        "distinct_reasons": len(reasons),
