# Updated from the harness-owned transcripts after the three runs.  The arms
# are diagnostics only; G9(c)'s output and exact-operation caps are the gate.
_G9_EVIDENCE = {
    "arms": {
        "bare": {"solved": 0, "attempts": 0},
        "hinted": {"solved": 0, "attempts": 0},
