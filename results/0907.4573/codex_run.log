+            for var in triple:
+                bad_incident = sum(row in bad for row in incident[var])
+                remaining = len(bad) + len(incident[var]) - 2 * bad_incident
+                choices.append((
+                    remaining, rng.random(), var))
+            chosen = min(choices)[2]
+            candidate[chosen] ^= 1
+            for row in incident[chosen]:
+                if row in bad:
+                    bad.remove(row)
+                else:
+                    bad.add(row)
+    return candidate
+
