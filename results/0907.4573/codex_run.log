   867	    reference_sec = time.perf_counter() - t0
   868	    reference_ok = (reference_answer is not None
   869	                    and verify(shipping, reference_answer)[0])
   870	    compact_answer, compact_ops, compact_inspections = _involution_compact_route(
   871	        shipping)
