   698	def _parity_violations(rows, candidate):
   699	    return [
   700	        ri for ri, (triple, rhs) in enumerate(rows)
   701	        if (candidate[triple[0]] ^ candidate[triple[1]]
   702	            ^ candidate[triple[2]]) != rhs
   703	    ]
