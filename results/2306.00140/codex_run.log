+        "baseline_operations": baseline["operations"],
+        "baseline_scale_trials": baseline["scale_trials"],
+    }
+
+    # G6: four failing no-tool/generic probes over eight shipping seeds.
+    attack_names = (
+        "raw_moment_outlier",
+        "greedy_zero_shear",
+        "random_restart_256",
+        "scale_one_first_moment_ansatz",
