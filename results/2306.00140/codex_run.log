+    report["G6_adversary_panel"] = {
+        "pass": all_failed,
+        "attacks": results,
+        "reference_algorithm": {
+            "name": "quadratic-residue scale scan with first-moment shear propagation",
+            "complexity": "O(p*d) exact finite-field operations for d observation rows",
+            "wall_clock_sec": baseline["wall_clock_sec"],
+            "operations": baseline["operations"],
+            "scale_trials": baseline["scale_trials"],
+            "solves": "1/1, as expected for Track B",
