+    "easy": {"n": 100_003, "decoys": 1},
+    "medium": {"n": 300_007, "decoys": 1},
+    "hard": {"n": 1_000_003, "decoys": 1},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+STRUCTURAL_HINT: str = (
