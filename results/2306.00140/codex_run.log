+    ),
+    "bounds": {
+        "scale_choices": "(p-1)/2 nonzero quadratic residues modulo instance p",
+        "shear_choices": "p residues 0 through p-1",
+        "generator_images": "two fixed two-coordinate images determined by scale and shear",
+        "atomic_elements": 7,
+    },
+}
+
+DIFFICULTY: dict = {
