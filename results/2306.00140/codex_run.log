+# ---------------------------------------------------------------------------
+# Attacks, measurements, and mandatory gates
+
+
+def _candidate_ok(inst: dict, pair: tuple[int, int]) -> bool:
+    return verify(inst, _answer(*pair))[0]
+
+
+def _attack_raw_moment_outlier(inst: dict) -> bool:
+    row = min(inst["observations"], key=lambda r: (r["sum"], r["sum_sq"], r["b"]))
+    scale = pow(inst["m"], row["sum"] % inst["t"], inst["p"])
+    return _candidate_ok(inst, (scale, row["sum_sq"]))
+
+
+def _attack_greedy_zero_shear(inst: dict) -> bool:
+    score = sum(row["sum_sq"] for row in inst["observations"])
+    scale = pow(inst["m"], score % inst["t"], inst["p"])
+    return _candidate_ok(inst, (scale, 0))
+
+
+def _attack_random_restart(inst: dict, attack_seed: int, restarts: int = 256) -> bool:
+    rng = random.Random(attack_seed)
+    for _ in range(restarts):
+        answer = random_candidate(inst, rng)
+        if verify(inst, answer)[0]:
+            return True
+    return False
+
+
+def _attack_scale_one_ansatz(inst: dict) -> bool:
+    """By-hand ansatz: set u=1, propagate w from each first moment, take least."""
+    p, m = inst["p"], inst["m"]
+    guesses = []
+    for row in inst["observations"]:
+        roles = _roles(row["q"], p)
+        role_sum = sum(roles) % p
+        w = (row["sum"] - role_sum) * pow(4 * row["h"] % p, -1, p) % p
+        guesses.append(w)
+    return _candidate_ok(inst, (1, min(guesses)))
+
+
+def _reference_scan(inst: dict) -> dict:
+    """O(p*d) scale scan with first-moment propagation; succeeds by design."""
+    p, t, m = inst["p"], inst["t"], inst["m"]
+    rows = inst["observations"]
+    start = time.perf_counter()
+    field_operations = 0
+    scale_trials = 0
+    scale = 1
+    found = None
+    for _ in range(t):
+        scale_trials += 1
+        shear_hits: dict[int, int] = {}
+        for row in rows:
+            roles = _roles(row["q"], p)
+            role_sum = sum(roles) % p
+            # Three field operations after row constants are available.
+            shear = ((row["sum"] - scale * role_sum)
+                     * pow(4 * row["h"] % p, -1, p)) % p
+            field_operations += 3
+            _, second = _layer_moments(p, m, scale, shear, row["b"])
+            # Four coordinate constructions, four squares, and their sums.
+            field_operations += 24
+            if second == row["sum_sq"]:
+                shear_hits[shear] = shear_hits.get(shear, 0) + 1
+        for shear, matches in shear_hits.items():
+            if matches >= inst["required_matches"] and _candidate_ok(inst, (scale, shear)):
+                found = (scale, shear)
+                break
+        if found is not None:
+            break
+        scale = scale * m % p
+        field_operations += 1
+    elapsed = time.perf_counter() - start
+    return {
+        "solved": found is not None,
+        "pair": list(found) if found else None,
+        "scale_trials": scale_trials,
+        "operations": field_operations,
+        "wall_clock_sec": elapsed,
+    }
+
+
+def _pow_cost(exponent: int) -> int:
+    if exponent <= 1:
+        return 0
+    return exponent.bit_length() - 1 + exponent.bit_count() - 1
+
+
+def _intended_route_operations(inst: dict) -> int:
+    """Conservative count of field operations for recover/group/check per row."""
+    p, t = inst["p"], inst["t"]
+    per_row = (
+        3                      # centered numerator
+        + 13                   # role sums and centered denominator
+        + 2                    # inversion and multiplication for u^2
+        + _pow_cost((p + 1) // 4)
+        + _pow_cost(t)         # choose the quadratic-residue square root
+        + 5                    # recover shear
+        + 24                   # exact row recheck
+    )
+    # One recovery per row, then comparisons/grouping (not arithmetic).
+    return per_row * len(inst["observations"])
+
+
+def _answer_atoms(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
