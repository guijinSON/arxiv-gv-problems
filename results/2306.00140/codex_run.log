         "hinted_verdict": G9_EVIDENCE.get("hinted_verdict"),
+        "placebo_status": G9_EVIDENCE.get("placebo_status"),
         "answer_chars": answer_chars,
         "answer_tokens": answer_tokens,
         "answer_elements": answer_elements,
