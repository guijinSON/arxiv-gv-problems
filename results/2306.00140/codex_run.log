+    results = {name: {"successes": 0, "attempts": 8} for name in attack_names}
+    for index, seed in enumerate((101, 211, 307, 401, 503, 601, 701, 809)):
+        trial = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        outcomes = {
