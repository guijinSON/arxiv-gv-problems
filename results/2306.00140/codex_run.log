+    "hard": {"n": 1_000_003, "decoys": 1},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+STRUCTURAL_HINT: str = (
+    "Within a fixed nonzero group layer, the centered second moment of the four "
