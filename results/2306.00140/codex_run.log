+    answer_elements = _answer_atoms(answer)
+    intended_operations = _intended_route_operations(inst)
+    arms = G9_EVIDENCE["arms"]
+    hinted_hardened = G9_EVIDENCE.get("hinted_verdict") == "hardened"
+    within_caps = (
