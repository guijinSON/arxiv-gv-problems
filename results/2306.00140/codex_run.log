+
+def _pow_cost(exponent: int) -> int:
+    if exponent <= 1:
+        return 0
+    return exponent.bit_length() - 1 + exponent.bit_count() - 1
+
+
+def _intended_route_operations(inst: dict) -> int:
+    """Conservative count of field operations for recover/group/check per row."""
+    p, t = inst["p"], inst["t"]
+    per_row = (
+        3                      # centered numerator
+        + 13                   # role sums and centered denominator
+        + 2                    # inversion and multiplication for u^2
+        + _pow_cost((p + 1) // 4)
+        + _pow_cost(t)         # choose the quadratic-residue square root
+        + 5                    # recover shear
+        + 24                   # exact row recheck
+    )
+    # One recovery per row, then comparisons/grouping (not arithmetic).
+    return per_row * len(inst["observations"])
+
