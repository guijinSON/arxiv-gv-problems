+    out_of_range["generator_images"]["sigma"] = [inst["p"], 0]
+    corruptions["out_of_range"] = out_of_range
+    reasons = {}
+    for name, corrupted in corruptions.items():
+        ok, reason = verify(inst, corrupted)
