+    ),
+    "bounds": {
+        "scale_choices": "(p-1)/2 nonzero quadratic residues modulo instance p",
+        "shear_choices": "p residues 0 through p-1",
+        "generator_images": "two fixed two-coordinate images determined by scale and shear",
+        "atomic_elements": 7,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 7, "decoys": 0},
+    "easy": {"n": 100_003, "decoys": 1},
+    "medium": {"n": 300_007, "decoys": 1},
+    "hard": {"n": 1_000_003, "decoys": 1},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+STRUCTURAL_HINT: str = (
+    "Within a fixed nonzero group layer, the centered second moment of the four "
+    "first coordinates is invariant under shear."
+)
+PLACEBO_HINT: str = (
+    "Within each displayed modular calculation, keep least nonnegative residues "
