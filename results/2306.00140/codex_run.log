+        "pass": exact_count is not None and exact_count >= 1 and baseline["solved"],
+        "valid_solution_count": exact_count,
+        "candidate_space": space,
+        "solution_density": exact_probability,
+        "baseline_wall_seconds": baseline["wall_clock_sec"],
+        "baseline_operations": baseline["operations"],
+        "baseline_scale_trials": baseline["scale_trials"],
+    }
+
+    # G6: four failing no-tool/generic probes over eight shipping seeds.
