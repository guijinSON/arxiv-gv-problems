+        scale = scale * m % p
+        field_operations += 1
+    elapsed = time.perf_counter() - start
+    return {
+        "solved": found is not None,
+        "pair": list(found) if found else None,
+        "scale_trials": scale_trials,
+        "operations": field_operations,
+        "wall_clock_sec": elapsed,
