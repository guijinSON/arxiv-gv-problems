+            "v": p * t,
+            "k": 2 * (p - 2),
+            "lambda": p - 2,
+            "mu": 4,
+        },
+        "required_matches": 2,
+        "decoys": decoys,
+        "observations": observations,
+        "answer": _answer(*target),
+    }
+
+
