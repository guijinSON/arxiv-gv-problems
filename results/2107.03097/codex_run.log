   661	def _attack_two_decimal_centroid(inst):
   662	    """A by-hand ansatz using only two decimal places of Vieta's centroid."""
   663	    c0, c1, _, _ = inst["coefficients"]
   664	    mean_root = Fraction(-c1, 3 * c0)
   665	    scaled = mean_root * 100
   666	    rounded = (scaled.numerator + scaled.denominator // 2) // scaled.denominator
   667	    coarse = Fraction(rounded, 100)
   668	    (_, _), (y_lo, y_hi) = inst["bounds"]
   669	    y = (y_lo + y_hi) // 2
   670	    x_fraction = coarse * y
   671	    x = (x_fraction.numerator + x_fraction.denominator // 2) // x_fraction.denominator
   672	    return _primitive_near(inst, x, y)
