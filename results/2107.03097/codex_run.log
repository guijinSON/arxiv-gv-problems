   471	def _coprime_rectangle_count(bounds):
   472	    (x_lo, x_hi), (y_lo, y_hi) = bounds
   473	    if min(x_lo, y_lo) <= 0:
   474	        raise ValueError("candidate counting expects positive generated bounds")
   475	    limit = min(x_hi, y_hi)
   476	    mu = _mobius_up_to(limit)
   477	    total = 0
   478	    for divisor in range(1, limit + 1):
   479	        if mu[divisor]:
   480	            count_x = x_hi // divisor - (x_lo - 1) // divisor
   481	            count_y = y_hi // divisor - (y_lo - 1) // divisor
   482	            total += mu[divisor] * count_x * count_y
   483	    return total
   484	
