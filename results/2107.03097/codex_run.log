+    attack_results = {name: {"successes": 0, "attempts": 0}
+                      for name in attack_functions}
+    attack_elapsed = {name: 0 for name in attack_functions}
+    reference_successes = compact_successes = 0
+    reference_elapsed = 0
+    reference_evaluations = []
