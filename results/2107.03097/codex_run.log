   684	def _relabel_instance(inst, swap=False, flip_x=False, flip_y=False):
   685	    """Signed coordinate renaming, carrying the witness and both intervals."""
   686	    sx = -1 if flip_x else 1
   687	    sy = -1 if flip_y else 1
   688	    coefficients = inst["coefficients"]
   689	    transformed = [0] * 4
   690	    if not swap:
   691	        for index, coefficient in enumerate(coefficients):
   692	            transformed[index] = coefficient * sx ** (3 - index) * sy ** index
   693	        x_bounds = sorted(sx * endpoint for endpoint in inst["bounds"][0])
   694	        y_bounds = sorted(sy * endpoint for endpoint in inst["bounds"][1])
   695	        answer = [sx * inst["answer"][0], sy * inst["answer"][1]]
   696	    else:
   697	        for index, coefficient in enumerate(coefficients):
   698	            transformed[3 - index] = (
   699	                coefficient * sy ** (3 - index) * sx ** index
   700	            )
   700	            )
   701	        x_bounds = sorted(sx * endpoint for endpoint in inst["bounds"][1])
   702	        y_bounds = sorted(sy * endpoint for endpoint in inst["bounds"][0])
   703	        answer = [sx * inst["answer"][1], sy * inst["answer"][0]]
   704	    out = dict(inst)
   705	    out["coefficients"] = transformed
   706	    out["bounds"] = [x_bounds, y_bounds]
   707	    out["answer"] = answer
   708	    return out
   709	
