   615	def _attack_box_landmarks(inst):
   616	    """Outlier probe: choose the lowest residual among nine box landmarks."""
   617	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   618	    xs = (x_lo, (x_lo + x_hi) // 2, x_hi)
   619	    ys = (y_lo, (y_lo + y_hi) // 2, y_hi)
   620	    candidates = {
   621	        tuple(_primitive_near(inst, x, y)) for x in xs for y in ys
   622	    }
   623	    return list(min(candidates, key=lambda z: abs(abs(
   624	        _form_value(inst["coefficients"], z[0], z[1])) - 1)))
