   576	def _compact_centroid_solver(inst):
   577	    """Recover the crowded primitive root direction from public coefficients."""
   578	    c0, c1, _, _ = inst["coefficients"]
   579	    if c0 == 0:
   580	        return None, {"exact_operations": 1, "continued_fraction_steps": 0}
   581	    mean_root = Fraction(-c1, 3 * c0)
   582	    max_denominator = max(abs(endpoint) for row in inst["bounds"] for endpoint in row)
   583	    reconstructed, operations, steps = _limit_denominator_counted(
   584	        mean_root, max_denominator
   585	    )
   586	    candidate = [reconstructed.numerator, reconstructed.denominator]
   587	    # Conservatively count centroid setup, endpoint comparisons, candidate
   588	    # extraction, bounds/gcd checks, and the final cubic substitution too.
   589	    operations += 24
   590	    if verify(inst, candidate)[0]:
   591	        return candidate, {
   592	            "exact_operations": operations,
   593	            "continued_fraction_steps": steps,
   594	        }
   595	    return None, {
   596	        "exact_operations": operations,
   597	        "continued_fraction_steps": steps,
   598	    }
