   601	def _primitive_near(inst, x, y):
   602	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   603	    x = min(x_hi, max(x_lo, x))
   604	    y = min(y_hi, max(y_lo, y))
   605	    for radius in range(0, 64):
   606	        offsets = ((radius, 0), (-radius, 0), (0, radius), (0, -radius))
   607	        for dx, dy in offsets:
   608	            xx, yy = x + dx, y + dy
   609	            if (x_lo <= xx <= x_hi and y_lo <= yy <= y_hi
   610	                    and math.gcd(abs(xx), abs(yy)) == 1):
   611	                return [xx, yy]
   612	    return random_candidate(inst, random.Random(x * 1000003 + y))
