   648	def _attack_random_restart(inst, rng, restarts=8_192):
   649	    best = None
   650	    for _ in range(restarts):
   651	        candidate = random_candidate(inst, rng)
   652	        score = abs(abs(_form_value(inst["coefficients"], *candidate)) - 1)
   653	        row = (score, candidate)
   654	        if best is None or row < best:
   655	            best = row
   656	        if score == 0:
   657	            break
   658	    return best[1]
