+            "independent coordinate sign changes",
+            "compositions of renaming and sign changes",
+            "global cubic coefficient sign and gcd normalization",
+        ],
+    }
+
+    answer_chars, answer_tokens = _answer_size(shipping["answer"])
+    arms = {name: dict(G9_RESULTS["arms"][name])
+            for name in ("bare", "hinted", "placebo")}
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = (answer_chars <= 2_000 and len(shipping["answer"]) <= 256
+                   and intended_operations <= 300)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": len(shipping["answer"]),
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2_000, "elements": 256, "operations": 300},
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["pass"] = all(gate.get("pass") is True for gate in gates)
+    report["all_passed"] = report["pass"]
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

codex
The first full self-test passes all nine gates at the initial shipping level. At `easy`, the structure-aware language has 2,553,640 primitive pairs and exactly one theorem-certified answer (density \(3.916\times10^{-7}\)); 200,000 uniform primitive guesses produced zero hits. Four construction-aware heuristics failed on 8/8 seeds each. The exact scan succeeded as expected, averaging 2,151,529 lattice evaluations and 8,637,629 counted operations, versus at most 117 operations for the disclosed centroid/continued-fraction route.

I also strengthened the canonical-key test to cover variable exchange, independent sign changes, global form negation, and their compositions. Next is the required bare four-vendor hardening run; its verdict determines whether `easy` ships or the ladder must move.
