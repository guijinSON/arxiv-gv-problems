+def _fib(index):
+    """Exact fast doubling Fibonacci number."""
+    def pair(k):
+        if k == 0:
+            return 0, 1
+        a, b = pair(k // 2)
+        c = a * ((b << 1) - a)
+        d = a * a + b * b
+        if k & 1:
+            return d, c + d
+        return c, d
+    return pair(index)[0]
