+        "paper_n": 260,
+        "offset_scale": 12,
+        "shear_scale": 6,
+        "scramble": True,
+    },
+    "hard": {
+        "n": 8_193,
+        "paper_n": 300,
+        "offset_scale": 16,
+        "shear_scale": 8,
+        "scramble": True,
+    },
+}
