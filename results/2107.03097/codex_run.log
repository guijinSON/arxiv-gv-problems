+        "offset_scale": params["offset_scale"] + 4,
+        "shear_scale": params["shear_scale"] + 2,
+        "scramble": True,
+    }
+
+
+def _answer_size(answer):
+    encoded = json.dumps(answer, separators=(",", ":"))
+    return len(encoded), (len(encoded) + 3) // 4
