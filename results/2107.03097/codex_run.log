+def _poly_mul(left, right):
+    """Multiply homogeneous binary forms stored by increasing y exponent."""
+    out = [0] * (len(left) + len(right) - 1)
+    for i, a in enumerate(left):
+        for j, b in enumerate(right):
+            out[i + j] += a * b
