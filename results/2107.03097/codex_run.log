+        "cases": corruption_results,
+        "distinct_reasons": distinct_reasons,
+    }
+
+    realistic = (
+        "The primitive pair gives exact value +1.\n<answer>\n```json\n"
+        + json.dumps(shipping["answer"], separators=(",", ":"))
+        + "\n```\n</answer>\n"
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
