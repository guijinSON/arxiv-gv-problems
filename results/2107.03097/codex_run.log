def _is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def _validate_params(n, classes, degree, seed):
    if not _is_int(n) or n < 3:
        raise ValueError("n must be an integer at least 3")
    if not _is_int(classes) or classes < 3:
        raise ValueError("classes must be an integer at least 3")
    if not _is_int(degree) or not 1 <= degree < n:
        raise ValueError("degree must be an integer with 1 <= degree < n")
    if not _is_int(seed):
        raise ValueError("seed must be an integer")


def _regular_pair(n, degree, plant_left, plant_right, rng):
    """A switched regular bipartite graph containing the planted edge.

    It is cheaper and less correlated to sample the regular *nonedges* when the
    compatibility graph is dense.  A long degree-preserving switch chain is run
    subject only to excluding the planted pair from the nonedge graph.  Thus all
    vertices still have exactly the same degree and the planted endpoints are
    not given a special marginal degree or position.
    """
    missing_degree = n - degree
    left_at = [plant_left] + [x for x in range(n) if x != plant_left]
    right_at = [plant_right] + [y for y in range(n) if y != plant_right]
    left_tail = left_at[1:]
    right_tail = right_at[1:]
    rng.shuffle(left_tail)
    rng.shuffle(right_tail)
    left_at = [plant_left] + left_tail
    right_at = [plant_right] + right_tail
    left_coordinate = {vertex: coordinate for coordinate, vertex in enumerate(left_at)}
    # Shift zero is excluded, so the planted pair is an edge of the complement
    # of this missing-edge graph from the start.
    shifts = rng.sample(range(1, n), missing_degree)
    missing = [set() for _ in range(n)]
    for x in range(n):
        coordinate = left_coordinate[x]
        missing[x] = {right_at[(coordinate + shift) % n] for shift in shifts}
    assert plant_right not in missing[plant_left]

    # Mix far beyond the number of missing edges.  The chain stays within simple
    # regular bipartite graphs and never inserts the conditioned planted nonedge.
    for _ in range(3 * n * max(1, missing_degree)):
        a = rng.randrange(n)
        b = rng.randrange(n - 1)
        if b >= a:
            b += 1
        only_a = missing[a] - missing[b]
        only_b = missing[b] - missing[a]
        if a == plant_left:
            only_b.discard(plant_right)
        if b == plant_left:
            only_a.discard(plant_right)
        if not only_a or not only_b:
            continue
        y = rng.choice(sorted(only_a))
        z = rng.choice(sorted(only_b))
        missing[a].remove(y)
        missing[b].remove(z)
        missing[a].add(z)
        missing[b].add(y)

    assert all(len(row) == missing_degree for row in missing)
    missing_column_degrees = [0] * n
    for row in missing:
        for y in row:
            missing_column_degrees[y] += 1
    assert all(value == missing_degree for value in missing_column_degrees)
    assert plant_right not in missing[plant_left]
    return [
        "".join("0" if y in row else "1" for y in range(n))
        for row in missing
    ]


def make_instance(n, seed=0, **params):
    """Inverse-generate a paper-exact MWACT gadget instance.

    The answer (one local representative per colour) is sampled first.  Every
    pairwise compatibility graph is then built around the corresponding forced
    edge.  No ACT assignment, clique, or reconciliation is solved during
    generation.
    """
    classes = params.pop("classes", 18)
    degree = params.pop("degree", max(1, min(n - 1, round(3 * n / 5))))
    if params:
        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
    _validate_params(n, classes, degree, seed)
    rng = random.Random(seed)

    planted_local = [rng.randrange(n) for _ in range(classes)]

    labels = list(range(1, n * classes + 1))
    rng.shuffle(labels)
    colour_lists = []
    cursor = 0
    for _ in range(classes):
        block = labels[cursor:cursor + n]
        cursor += n
        rng.shuffle(block)
        colour_lists.append(block)

    compatibility = []
    for left in range(classes):
        for right in range(left + 1, classes):
            rows = _regular_pair(
                n,
                degree,
                planted_local[left],
                planted_local[right],
                rng,
            )
            compatibility.append({"left": left, "right": right, "rows": rows})

    answer = [
        colour_lists[colour][planted_local[colour]]
        for colour in range(classes)
    ]
    instance = {
        "paper": "arXiv:1705.01240",
        "family": "paper Lemma 3 multicolored-clique to MWACT gadgets",
        "n": n,
        "color_count": classes,
        "cross_degree": degree,
        "colors": colour_lists,
        "compatibility": compatibility,
        "weight_bound": classes * classes + 2 * classes,
        "answer": answer,
    }
    # Derived read-only indexes keep repeated grading and the 200k density audit
    # linear in the number of candidates rather than in the input size.  They are
    # never rendered and carry no information absent from the portable fields.
    instance["_compat_cache"] = {
#!/usr/bin/env python3
"""The LLM hardening loop.  Usage: python3 scripts/harden.py <path to gen_*.py>

This file, not the builder, owns the loop.  The builder writes gen_<id>.py and
runs this; everything about which model is asked, with which seed, and when a
family is declared too easy is decided here.  That is deliberate: a builder that
reports its own hardening result has an obvious incentive not to report a
failure, and a transcript whose schema is chosen per run cannot be validated.

Requires OPENROUTER_API_KEY.  The oracle pool spans four vendors, so a single
OpenAI key is not enough.  Standard library only.
"""

