    inner = len(b)
    cols = len(b[0])
    bt = list(zip(*b))
    return [
        [sum(x * y for x, y in zip(a[i], bt[j])) for j in range(cols)]
        for i in range(rows)
    ]


def _matpow_naive(a: list[list[int]], exponent: int) -> list[list[int]]:
