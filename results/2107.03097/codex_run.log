   711	def canonical_key(inst):
   712	    """Orbit key under x/y renaming, axis signs, and global form sign."""
   713	    forms = []
   714	    for swap in (False, True):
   715	        for flip_x in (False, True):
   716	            for flip_y in (False, True):
   717	                relabelled = _relabel_instance(inst, swap, flip_x, flip_y)
   718	                forms.append(json.dumps([
   719	                    relabelled["bounds"],
   720	                    _sign_normalized_coefficients(relabelled["coefficients"]),
   721	                ], separators=(",", ":")))
   722	    return hashlib.sha256(min(forms).encode("ascii")).hexdigest()
