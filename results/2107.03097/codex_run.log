   361	def render(inst):
   362	    """Render a complete, exact bounded Thue-equation problem."""
   363	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   364	    statement = f"""Find one primitive integer solution of this bounded binary cubic equation.
   365	
   366	A primitive integer solution is an ordered pair (x,y) of ordinary base-10 integers with gcd(|x|,|y|)=1.  It must satisfy the displayed equation exactly; either right-hand sign is allowed.  Multiplication is written with *, and powers have their usual integer meaning.
   367	
   368	Equation:
   369	  {_format_form(inst['coefficients'])} = +1 or -1
   370	
   371	Inclusive coordinate bounds:
   372	  {x_lo} <= x <= {x_hi}
   373	  {y_lo} <= y <= {y_hi}
   374	
   375	Both endpoints are included.  The order matters: the first coordinate is x and the second is y.  No floating-point approximation is accepted.
   376	
   377	Give your final answer inside <answer></answer> tags as a JSON list of exactly two base-10 integers [x,y].
   378	Example: <answer>[3,-17]</answer>
   379	Output nothing else inside the tags."""
   380	    mode = os.environ.get("GV_HINT_MODE")
   381	    if mode == "structural":
   382	        statement += "\n\nHint: " + STRUCTURAL_HINT
   383	    elif mode == "placebo":
   384	        statement += "\n\nHint: " + PLACEBO_HINT
   385	    return statement
