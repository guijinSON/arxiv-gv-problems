   448	@lru_cache(maxsize=64)
   449	def _mobius_up_to(limit):
   450	    mu = [0] * (limit + 1)
   451	    composite = [False] * (limit + 1)
   452	    primes = []
   453	    if limit >= 1:
   454	        mu[1] = 1
   455	    for value in range(2, limit + 1):
   456	        if not composite[value]:
   457	            primes.append(value)
   458	            mu[value] = -1
   459	        for prime in primes:
   460	            product = value * prime
   461	            if product > limit:
   462	                break
   463	            composite[product] = True
   464	            if value % prime == 0:
   465	                mu[product] = 0
   466	                break
   467	            mu[product] = -mu[value]
   468	    return tuple(mu)
