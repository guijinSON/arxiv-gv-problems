+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    payload = matches[-1].strip()
+    fence = re.fullmatch(r"```(?:json|text)?\s*(.*?)\s*```", payload,
+                         flags=re.I | re.S)
+    if fence:
