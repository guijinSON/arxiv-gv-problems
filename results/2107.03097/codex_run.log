   627	def _attack_residual_descent(inst):
   628	    """Greedy in-context coordinate descent from the box centre."""
   629	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   630	    current = _primitive_near(inst, (x_lo + x_hi) // 2, (y_lo + y_hi) // 2)
   631	    for _ in range(48):
   632	        options = [current]
   633	        x, y = current
   634	        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1),
   635	                       (1, 1), (1, -1), (-1, 1), (-1, -1)):
   636	            xx, yy = x + dx, y + dy
   637	            if (x_lo <= xx <= x_hi and y_lo <= yy <= y_hi
   638	                    and math.gcd(abs(xx), abs(yy)) == 1):
   639	                options.append([xx, yy])
   640	        best = min(options, key=lambda z: abs(abs(
   641	            _form_value(inst["coefficients"], z[0], z[1])) - 1))
   642	        if best == current:
   643	            break
   644	        current = best
   645	    return current
