   549	def _limit_denominator_counted(value, max_denominator):
   550	    """Fraction.limit_denominator with an explicit arithmetic-operation count."""
   551	    if value.denominator <= max_denominator:
   552	        return value, 1, 0
   553	    numerator, denominator = value.numerator, value.denominator
   554	    p0, q0, p1, q1 = 0, 1, 1, 0
   555	    operations = 0
   556	    steps = 0
   557	    while True:
   558	        steps += 1
   559	        quotient = numerator // denominator
   560	        q2 = q0 + quotient * q1
   561	        operations += 3
   562	        if q2 > max_denominator:
   563	            break
   564	        p0, q0, p1, q1 = p1, q1, p0 + quotient * p1, q2
   565	        numerator, denominator = denominator, numerator - quotient * denominator
   566	        operations += 4
   567	    k = (max_denominator - q0) // q1
   568	    bound1 = Fraction(p0 + k * p1, q0 + k * q1)
   569	    bound2 = Fraction(p1, q1)
   570	    operations += 7
   571	    if abs(bound2 - value) <= abs(bound1 - value):
   572	        return bound2, operations + 5, steps
   573	    return bound1, operations + 5, steps
