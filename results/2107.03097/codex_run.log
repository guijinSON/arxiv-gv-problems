   388	def parse_answer(text):
   389	    """Extract the last tagged two-integer JSON answer; return None on garbage."""
   390	    if not isinstance(text, str):
   391	        return None
   392	    matches = _ANSWER_RE.findall(text)
   393	    if not matches:
   394	        return None
   395	    payload = matches[-1].strip()
   396	    fence = re.fullmatch(r"```(?:json|text)?\s*(.*?)\s*```", payload,
   397	                         flags=re.I | re.S)
   398	    if fence:
   399	        payload = fence.group(1).strip()
   400	    try:
   401	        value = json.loads(payload)
   402	    except (TypeError, ValueError, json.JSONDecodeError):
   403	        return None
   404	    if (not isinstance(value, list) or len(value) != 2
   405	            or not all(_is_int(item) for item in value)):
   406	        return None
   407	    return value
