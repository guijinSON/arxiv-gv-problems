+@lru_cache(maxsize=64)
+def _mobius_up_to(limit):
+    mu = [0] * (limit + 1)
+    composite = [False] * (limit + 1)
+    primes = []
+    if limit >= 1:
+        mu[1] = 1
+    for value in range(2, limit + 1):
+        if not composite[value]:
+            primes.append(value)
+            mu[value] = -1
+        for prime in primes:
+            product = value * prime
+            if product > limit:
+                break
+            composite[product] = True
+            if value % prime == 0:
+                mu[product] = 0
+                break
+            mu[product] = -mu[value]
