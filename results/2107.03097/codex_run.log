   539	def enumerate_all(inst):
   540	    """Brute-force exact valid-answer count for small rectangles only."""
   541	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   542	    area = (x_hi - x_lo + 1) * (y_hi - y_lo + 1)
   543	    if area > _ENUMERATION_CAP:
   544	        return None
   545	    solutions, _ = _grid_scan(inst, stop_first=False)
   546	    return len(solutions)
