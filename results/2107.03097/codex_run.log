from fractions import Fraction
import random, math

def egcd(a,b):
    if b==0:return a,1,0
    g,x,y=egcd(b,a%b);return g,y,x-(a//b)*y

def mul(p,q):
    r=[0]*(len(p)+len(q)-1)
    for i,x in enumerate(p):
      for j,y in enumerate(q):r[i+j]+=x*y
    return r

def add(p,q,scale=1):
    return [x+scale*y for x,y in zip(p,q)]

def powpoly(p,k):
    r=[1]
    for _ in range(k):r=mul(r,p)
    return r

def fib(n):
    a,b=0,1
    for _ in range(n):a,b=b,a+b
    return a

def build(H,pn,seed):
    rng=random.Random(seed)
    lo=max(2,H//3); hi=max(lo,H*2//3)
    while 1:
      a=rng.randint(lo,hi);c=rng.randint(lo,hi)
      if a"'!=c and math.gcd(a,c)==1:break
    g,x,y=egcd(a,c); d0=x;b0=-y
    k=rng.randint(2*H,4*H)
    b=b0+k*a;d=d0+k*c
    A=(a,b,c,d)
    X=[d,-b];Y=[-c,a]
    F=fib(pn);P=1<<pn
    LF=[X[0]-F*Y[0],X[1]-F*Y[1]]
    LP=[X[0]-P*Y[0],X[1]-P*Y[1]]
    C=add(mul(mul(X,LF),LP),powpoly(Y,3),-1)
    R=[-z for z in mul(mul(X,LF),Y)]
    E=add(mul(mul(X,X),LF),powpoly(Y,3),-1)
    assert C==[P*r+e for r,e in zip(R,E)]
    dom=max(abs(e) for e in E)*2<P
    rr=[]
    for z in C:
      sign=-1 if z<0 else 1
      q,rem=divmod(abs(z),P)
      if 2*rem>P:q+=1
      rr.append(sign*q)
    rec_ok=rr==R
    mu=Fraction(-R[1],3*R[0])
    best=mu.limit_denominator(H)
    val=lambda u,v: sum(C[i]*(u**(3-i))*(v**i) for i in range(4))
    return dict(A=A,Fdigits=len(str(F)),Pdigits=len(str(P)),Cdigits=[len(str(abs(z))) for z in C],dom=dom,ratio=float(P/(2*max(abs(e) for e in E))),rec_ok=rec_ok,best=(best.numerator,best.denominator),target=(a,c),value=val(a,c),swap=val(c,a),muerr=float(Fraction(a,c)-mu),k=k)
for H,pn in [(8,4),(256,120),(1024,200),(4096,300),(4096,260),(4096,240)]:
  print('"'LEVEL',H,pn)
  for s in range(3): print(s,build(H,pn,s))
