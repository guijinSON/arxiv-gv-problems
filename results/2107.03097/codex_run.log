   675	def _sign_normalized_coefficients(coefficients):
   676	    # A common divisor other than one would change the equation |Q|=1, so it
   677	    # is not a relabelling symmetry.  Generated solvable forms are primitive
   678	    # automatically; only the harmless global sign is normalized here.
   679	    out = list(coefficients)
   680	    first = next((value for value in out if value), 1)
   681	    return [-value for value in out] if first < 0 else out
