+                forms.append(json.dumps([
+                    relabelled["bounds"],
+                    _sign_normalized_coefficients(relabelled["coefficients"]),
+                ], separators=(",", ":")))
+    return hashlib.sha256(min(forms).encode("ascii")).hexdigest()
