   437	def random_candidate(inst, rng):
   438	    """Sample uniformly from the stated primitive lattice points."""
   439	    if not isinstance(rng, random.Random):
   440	        raise TypeError("rng must be an instance of random.Random")
   441	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   442	    while True:
   443	        candidate = [rng.randint(x_lo, x_hi), rng.randint(y_lo, y_hi)]
   444	        if math.gcd(abs(candidate[0]), abs(candidate[1])) == 1:
   445	            return candidate
