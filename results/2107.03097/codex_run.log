   352	def _format_form(coefficients):
   353	    monomials = ("x^3", "x^2*y", "x*y^2", "y^3")
   354	    pieces = []
   355	    for coefficient, monomial in zip(coefficients, monomials):
   356	        if coefficient:
   357	            pieces.append(_signed_term(coefficient, monomial, not pieces))
   358	    return "".join(pieces) if pieces else "0"
