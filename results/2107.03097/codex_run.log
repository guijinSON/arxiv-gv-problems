   340	def _signed_term(coefficient, monomial, first=False):
   341	    if coefficient == 0:
   342	        return ""
   343	    magnitude = abs(coefficient)
   344	    body = monomial if magnitude == 1 else f"{magnitude}*{monomial}"
   345	    if not monomial:
   346	        body = str(magnitude)
   347	    if first:
   348	        return ("-" if coefficient < 0 else "") + body
   349	    return (" - " if coefficient < 0 else " + ") + body
