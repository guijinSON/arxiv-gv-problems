   410	def verify(inst, answer):
   411	    """Check only the public bounds and exact cubic identity."""
   412	    if not isinstance(answer, list):
   413	        return False, "answer must be a JSON list"
   414	    if len(answer) == 0:
   415	        return False, "answer is empty"
   416	    if len(answer) == 1:
   417	        return False, "answer has one coordinate; exactly two are required"
   418	    if len(answer) != 2:
   419	        return False, f"answer has {len(answer)} coordinates; exactly two are required"
   420	    if not all(_is_int(value) for value in answer):
   420	    if not all(_is_int(value) for value in answer):
   421	        return False, "both coordinates must be base-10 integers"
   422	    x, y = answer
   423	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   424	    if not x_lo <= x <= x_hi:
   425	        return False, f"x={x} is outside the inclusive interval [{x_lo},{x_hi}]"
   426	    if not y_lo <= y <= y_hi:
   427	        return False, f"y={y} is outside the inclusive interval [{y_lo},{y_hi}]"
   428	    divisor = math.gcd(abs(x), abs(y))
   429	    if divisor != 1:
   430	        return False, f"coordinates are not primitive: gcd(|x|,|y|)={divisor}"
   431	    value = _form_value(inst["coefficients"], x, y)
   432	    if value not in (-1, 1):
   433	        return False, f"exact substitution gives {value}, not +1 or -1"
   434	    return True, "ok"
