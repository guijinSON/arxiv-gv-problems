+    ys = (y_lo, (y_lo + y_hi) // 2, y_hi)
+    candidates = {
+        tuple(_primitive_near(inst, x, y)) for x in xs for y in ys
+    }
+    return list(min(candidates, key=lambda z: abs(abs(
