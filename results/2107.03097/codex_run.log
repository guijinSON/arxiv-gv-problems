   491	def _grid_scan(inst, stop_first=True):
   492	    """Exact O(W^2) reference scan using cubic forward differences in y."""
   493	    (x_lo, x_hi), (y_lo, y_hi) = inst["bounds"]
   494	    c0, c1, c2, c3 = inst["coefficients"]
   495	    solutions = []
   496	    evaluations = operations = x_rows = 0
   497	    for x in range(x_lo, x_hi + 1):
   498	        x_rows += 1
   499	        x2 = x * x
   500	        x3 = x2 * x
   501	        cubic = c3
   502	        quadratic = c2 * x
   503	        linear = c1 * x2
   504	        constant = c0 * x3
   505	        y = y_lo
   506	        y2 = y * y
   507	        y3 = y2 * y
   508	        value = cubic * y3 + quadratic * y2 + linear * y + constant
   509	        delta1 = (cubic * (3 * y2 + 3 * y + 1)
   510	                  + quadratic * (2 * y + 1) + linear)
   511	        delta2 = cubic * (6 * y + 6) + 2 * quadratic
   512	        delta3 = 6 * cubic
   513	        operations += 30
   514	        while y <= y_hi:
   515	            evaluations += 1
   516	            operations += 1
   517	            if value in (-1, 1):
   518	                candidate = [x, y]
   519	                if verify(inst, candidate)[0]:
   520	                    solutions.append(candidate)
   521	                    if stop_first:
   522	                        return solutions, {
   523	                            "lattice_evaluations": evaluations,
   524	                            "exact_operations": operations,
   525	                            "x_rows": x_rows,
   526	                        }
   527	            value += delta1
   528	            delta1 += delta2
   529	            delta2 += delta3
   530	            operations += 3
   531	            y += 1
   532	    return solutions, {
   533	        "lattice_evaluations": evaluations,
   534	        "exact_operations": operations,
   535	        "x_rows": x_rows,
   536	    }
