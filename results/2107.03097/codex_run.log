+def _attack_random_restart(inst, rng, restarts=8_192):
+    best = None
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        score = abs(abs(_form_value(inst["coefficients"], *candidate)) - 1)
+        row = (score, candidate)
+        if best is None or row < best:
+            best = row
+        if score == 0:
