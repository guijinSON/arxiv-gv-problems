+        c_value //= n
+        operations += 2
+        try:
+            b_shift = block["B_code"].index(b_value)
+            c_shift = block["C_code"].index(c_value)
+        except ValueError:
+            return None, operations
+        answer.append(_bits(b_shift, width) + _bits(c_shift, width))
