+      "entries": [0, 1],
+      "max_atomic_elements": 192,
+      "max_blocks": 12,
+      "max_group_order": 256
+    },
+    "description": "A JSON matrix with exactly `blocks` rows and 2*log2(n) binary entries per row.  The first half of row q is the little-endian XOR shift of the second-mode codebook in block q, and the second half is the shift of the third-mode codebook."
+  },
+  "shipping_difficulty": "hard",
+  "shipping_params": {"blocks": 3, "n": 32, "value_bits": 12},
+  "track": "B"
+}

