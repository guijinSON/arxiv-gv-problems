+def _random_linear_images(width, rng):
+    """Images of the standard basis under a random invertible GF(2) map."""
+    images = [1 << bit for bit in range(width)]
+    for _ in range(4 * width + 1):
+        first, second = rng.sample(range(width), 2)
+        if rng.randrange(2):
