+    width = _bit_width(n)
+    answer = []
+    for block in blocks:
+        b = max(range(n), key=lambda x: (abs(block["B_code"][x]), -x))
+        c = max(range(n), key=lambda x: (abs(block["C_code"][x]), -x))
+        answer.append(_bits(b, width) + _bits(c, width))
+    return answer
