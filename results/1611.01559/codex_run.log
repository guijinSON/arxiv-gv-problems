\title[How hard is the tensor rank?]{How hard is the tensor rank?}
%\title[The complexity of tensor rank]{The complexity of tensor rank}
%\title[The complexity of tensor rank]{The complexity of tensor rank: Some problems are harder than NP}

%    Information for first author
\author{Yaroslav Shitov}
%    Address of record for the research reported here
\address{National Research University Higher School of Economics, 20 Myasnitskaya Ulitsa, Moscow, Russia 101000}
\email{yaroslav-shitov@yandex.ru}

