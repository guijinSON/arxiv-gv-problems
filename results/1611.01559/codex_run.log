MOD="$(ls "$D"/gen_*.py 2>/dev/null | head -1)"
[ -n "$MOD" ] || { echo "ERROR: no gen_*.py in $D — nothing to submit."; exit 2; }

# The builder writes these; a result nobody can read or re-check is not a result.
