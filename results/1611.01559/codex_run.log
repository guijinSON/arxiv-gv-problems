+def _affine_matrix(matrix, b_sign, b_offset, c_sign, c_offset):
+    """Apply (1,b)->(1,b_sign*b+b_offset) in the last two modes."""
+    m00, m01 = matrix[0]
+    m10, m11 = matrix[1]
+    return [
+        [m00, c_offset * m00 + c_sign * m01],
+        [
+            b_offset * m00 + b_sign * m10,
+            b_offset * c_offset * m00
+            + b_offset * c_sign * m01
+            + b_sign * c_offset * m10
+            + b_sign * c_sign * m11,
+        ],
+    ]
+
