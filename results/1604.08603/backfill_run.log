/bin/bash -lc "python3 - <<'PY'
import json
import typing
import gen_1604_08603 as g
hints = typing.get_type_hints(g)
assert hints['NATIVE'] is dict
assert hints['DIFFICULTY'] is dict
assert hints['CERTIFICATE_LANGUAGE'] is dict
assert g.NATIVE['domain'] == 'combinatorics'
assert g.NATIVE['core'] == 'exact_cover'
assert g.NATIVE['reduction'] is None
params = {'n': 48, 'claw_fraction': 0.50, 'marked_fraction': 0.25}
assert g.DIFFICULTY[g.SHIPPING_DIFFICULTY] == params
inst = g.make_instance(seed=91, **params)
assert len(inst['edges']) == g.CERTIFICATE_LANGUAGE['bounds']['shipping_edge_ids']
assert len(inst['answer']) == g.CERTIFICATE_LANGUAGE['bounds']['shipping_groups']
assert g.verify(inst, inst['answer']) == (True, 'ok')
with open('selftest_report.json', encoding='utf-8') as f:
    report = json.load(f)
assert report['all_passed']
assert all(v['pass'] for k, v in report.items() if k.startswith('G'))
print('import/declarations/shipping/report: ok')
