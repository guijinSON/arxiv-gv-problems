/bin/bash -lc "python3 - <<'PY'
import json
import typing
import gen_1604_08603 as g
hints = typing.get_type_hints(g)
assert all(hints[name] is dict for name in ('NATIVE', 'DIFFICULTY', 'CERTIFICATE_LANGUAGE'))
params = {'n': 48, 'claw_fraction': 0.50, 'marked_fraction': 0.25}
assert g.SHIPPING_DIFFICULTY == 'hard'
assert g.DIFFICULTY['hard'] == params
inst = g.make_instance(seed=91, **params)
assert (inst['vertex_count'], len(inst['edges']), len(inst['answer'])) == (102, 153, 51)
assert g.verify(inst, inst['answer']) == (True, 'ok')
with open('selftest_report.json', encoding='utf-8') as f:
    report = json.load(f)
assert report['all_passed']
