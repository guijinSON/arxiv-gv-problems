/bin/bash -lc "python3 - <<'PY'
import json
import typing
import gen_1604_08603 as g
with open('selftest_report.json', encoding='utf-8') as f:
    report = json.load(f)
assert report['all_passed']
assert all(report[k]['pass'] for k in report if k.startswith('G'))
assert set(typing.get_type_hints(g)) >= {'NATIVE', 'DIFFICULTY', 'CERTIFICATE_LANGUAGE'}
params = {'n': 48, 'claw_fraction': 0.50, 'marked_fraction': 0.25}
assert g.SHIPPING_DIFFICULTY == 'hard' and g.DIFFICULTY['hard'] == params
inst = g.make_instance(seed=91, **params)
assert (inst['vertex_count'], len(inst['edges']), len(inst['answer'])) == (102, 153, 51)
assert g.verify(inst, inst['answer']) == (True, 'ok')
g5 = report['G5_sparse']
assert g5['density']['hits'] == 0 and g5['density']['sample_size'] == 200000
assert g5['baseline_cost']['total_nodes'] == 1600000
print('final validation: module imports; shipping unchanged; G1-G8 pass')
