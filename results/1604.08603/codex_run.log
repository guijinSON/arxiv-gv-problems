+    within_caps = (
+        answer_chars <= 2_000
+        and answer_elements <= 256
+        and intended_route_operations <= 300
+        and answer_tokens <= 500
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": G9_HINTED_VERDICT == "hardened" and within_caps,
+        "arms": G9_ARM_RESULTS,
+        "hinted_minus_placebo": hinted_minus_placebo,
