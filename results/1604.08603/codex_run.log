            \end{scope}
                \node at (-2,0) {$G':$};
            \draw[->] (3.5,0) -- (5.5,0);
            \begin{scope}[xshift=300pt,rotate=-90]
                \node[vertex,draw,label=above:$v$] at (-1.05,-2.56) (v2) {};
                \node[vertex,draw,label=below:$w$] at (1.05,-2.56) (w2) {};

                
                \draw[gray,very thick,line width=2pt,opacity=.3] (v2) -- ++(135:.5cm)  node {};
                \draw[gray,very thick,line width=2pt,opacity=.3] (v2) -- ++(-135:.5cm)  node {};
                \draw[gray,very thick,line width=2pt,opacity=.3] (w2) -- ++(45:.5cm)  node {};
                \draw[gray,very thick,line width=2pt,opacity=.3] (w2) -- ++(-45:.5cm)  node {};
