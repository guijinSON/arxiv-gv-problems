+        "successes": 0
+      }
+    },
+    "domain_attack": "Algorithm X exact-cover search with minimum-column branching",
+    "pass": true
+  },
+  "G7_scales": {
+    "base_edges": 153,
+    "base_n": 48,
+    "doubled_edges": 306,
+    "doubled_n": 96,
+    "doubled_verify": "ok",
+    "pass": true
+  },
+  "G8_canonical_key": {
+    "distinct_unrelated": 20,
+    "failures": [],
+    "invariance_checks": 60,
+    "key_kind": "multiset of rooted colour-refinement quotients (strong invariant, not complete GI)",
+    "pass": true,
+    "real_transform_verify_checks": 60,
