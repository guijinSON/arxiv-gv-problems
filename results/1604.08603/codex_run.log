+    corruptions["drop_one"] = drop
+    duplicate = [p[:] for p in planted]
+    duplicate[0][1] = duplicate[0][0]
+    corruptions["duplicate"] = duplicate
+    corruptions["empty"] = []
+    out_of_range = [p[:] for p in planted]
+    out_of_range[0][0] = len(inst["edges"]) + 1
