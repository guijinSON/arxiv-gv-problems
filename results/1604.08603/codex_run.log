+            for a in range(3):
+                for b in range(3):
+                    trial = [p[:] for p in planted]
+                    trial[i][a], trial[j][b] = trial[j][b], trial[i][a]
+                    ok, why = verify(inst, trial)
+                    if not ok and why.startswith("invalid_shape"):
