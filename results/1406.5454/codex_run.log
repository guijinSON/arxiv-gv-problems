"""Verified Problem-4 pseudo-key instances from arXiv:0803.0845.

The paper's Problem 4 gives public integers, all but one desired
Euclidean remainders, and an interval for the final remainder.  A witness is a
pseudo-key (divisor) producing a superincreasing remainder sequence.  Instances
here are generated by a composition of integer-valued-polynomial identities:
the adjusted public integers are q*P(i), where the top forward difference of P
is one.  Thus q is known without solving the emitted instance.
"""

from __future__ import annotations

import copy
import hashlib
import json
import math
import os
import random
import re
