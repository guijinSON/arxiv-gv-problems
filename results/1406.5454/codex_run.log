DIFFICULTY = {
    "demo": {"n": 4, "q_bits": 8, "quotient_bits": 10},
    "easy": {"n": 7, "q_bits": 40, "quotient_bits": 80},
    "medium": {"n": 10, "q_bits": 72, "quotient_bits": 256},
