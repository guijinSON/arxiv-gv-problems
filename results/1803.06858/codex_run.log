+NOTES = r"""
+Paper definition. Section 2 defines all graphs as finite undirected simple
+graphs and defines an isomorphism phi by the exact biconditional uv in E(G) iff
+phi(u)phi(v) in E(H).  The same section introduces permutation groups and
+labeling cosets.  Section 5 defines colored coset-hypergraph-isomorphism and
+requires a global bijection to preserve hyperedges, their colors, and every
+specified local permutation coset.  The present direct product of affine
+groups is an explicitly represented permutation group; color classes and
+2-element graph edges are the colored hyperedges.  No graph, SAT, or finite-
+field surrogate replaces the paper's objects.
+
+Step-0 discrimination. Theorem 1 gives an isomorphism test in
+2^(k polylog k) poly(n), and Theorem 2 gives canonization in
+2^O(k^2 log k) poly(n).  Thus a Track-A claim would be false.  Section 6 says
+the algorithm actually computes the complete isomorphism coset.  This is an
+honest Track-B family: the standard allowed-group search succeeds and is
+reported separately, while a solver without tools can compress it only by
+recognizing how centered power sums transform.
+
+Generation. For each color, make_instance samples a nonzero affine multiplier,
+a translation, and a uniform support set S before forming T=aS+b.  The colored
+graph has all edges inside each support set and no other edges, so its tree
+width is support_size-1.  The sampled affine maps are therefore isomorphisms by
+construction.  They are never recovered by solving a generated instance.
+Raw first, second, and third power sums are included as exact redundant graph
+checksums.  Nonzero centered second and third sums are enforced while sampling
+so that their covariant normalization is always defined.
+
+Easy regimes and attacks. Unrestricted isomorphism of these clique-plus-
+isolates graphs is deliberately easy; the task is Section 5's coset-constrained
+isomorphism.  The reference algorithm fixes two source support vertices,
+enumerates their ordered target images, and tests the induced affine map.  The
+cheap panel tries label extremes, sorted-rank matching, translations/reflections,
+and random group elements.  All active vertices in a color have the same
+degree, all inactive vertices have the same degree, and the planted affine
+coefficients are uniform, so no per-vertex statistic marks the plant.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def _is_int(value) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _is_prime(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    d = 3
+    while d * d <= value:
+        if value % d == 0:
+            return False
+        d += 2
+    return True
+
+
+def _next_prime(value: int) -> int:
+    candidate = max(3, value)
+    if candidate % 2 == 0:
+        candidate += 1
+    while not _is_prime(candidate):
+        candidate += 2
+    return candidate
+
+
+def _power_sums(values, p: int) -> list[int]:
+    s1 = s2 = s3 = 0
+    for value in values:
+        x = int(value) % p
+        x2 = x * x % p
+        s1 = (s1 + x) % p
+        s2 = (s2 + x2) % p
+        s3 = (s3 + x2 * x) % p
+    return [s1, s2, s3]
+
+
+def _centered_data_from_sums(sums, size: int, p: int):
+    """Return mean, centered second sum, centered third sum modulo p."""
+    s1, s2, s3 = sums
+    inv_size = pow(size, -1, p)
+    mean = s1 * inv_size % p
+    mean2 = mean * mean % p
+    mean3 = mean2 * mean % p
+    c2 = (s2 - size * mean2) % p
+    c3 = (s3 - 3 * mean * s2 + 2 * size * mean3) % p
+    return mean, c2, c3
+
+
+def _support_is_generic(values, p: int) -> bool:
+    _, c2, c3 = _centered_data_from_sums(_power_sums(values, p), len(values), p)
+    return c2 != 0 and c3 != 0
+
+
+def _validate_params(n, colors, support_size) -> None:
+    if not _is_int(n) or n < 7:
+        raise ValueError("n must be an integer at least 7")
+    if not _is_int(colors) or not 1 <= colors <= 8:
+        raise ValueError("colors must be an integer in the inclusive range 1..8")
+    if not _is_int(support_size) or support_size < 4:
+        raise ValueError("support_size must be an integer at least 4")
+    p = _next_prime(n)
+    if support_size >= p:
+        raise ValueError("support_size must be smaller than the selected prime")
+    if support_size % p == 0:
+        raise ValueError("support_size must be invertible modulo the selected prime")
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Plant blockwise affine graph isomorphisms before constructing targets."""
+    colors = params.pop("colors", 1)
+    support_size = params.pop("support_size", 12)
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    _validate_params(n, colors, support_size)
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+
+    p = _next_prime(n)
+    rng = random.Random(seed)
+    source_supports = []
+    target_supports = []
+    source_sums = []
+    target_sums = []
+    answer = []
+
+    for _color in range(colors):
+        # Conditioning on the two nonzero covariants merely selects a generic
+        # support; it does not search for, or test, an isomorphism.
+        while True:
+            source = sorted(rng.sample(range(p), support_size))
+            if _support_is_generic(source, p):
+                break
+        a = rng.randrange(1, p)
+        b = rng.randrange(p)
+        target = sorted((a * x + b) % p for x in source)
+        source_supports.append(source)
+        target_supports.append(target)
+        source_sums.append(_power_sums(source, p))
+        target_sums.append(_power_sums(target, p))
+        answer.append([a, b])
+
+    return {
+        "family": "blockwise affine colored-graph isomorphism",
+        "prime": p,
+        "colors": colors,
+        "support_size": support_size,
+        "vertex_count": colors * p,
+        "tree_width": support_size - 1,
+        "source_active": source_supports,
+        "target_active": target_supports,
+        "source_power_sums": source_sums,
+        "target_power_sums": target_sums,
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    """Render a self-contained exact constrained-isomorphism problem."""
+    p = inst["prime"]
+    colors = inst["colors"]
+    size = inst["support_size"]
+    rows = []
+    for color in range(colors):
+        src = " ".join(map(str, inst["source_active"][color]))
+        dst = " ".join(map(str, inst["target_active"][color]))
+        ps = " ".join(map(str, inst["source_power_sums"][color]))
+        pt = " ".join(map(str, inst["target_power_sums"][color]))
+        rows.extend([
+            f"color {color} source_active: {src}",
+            f"color {color} target_active: {dst}",
+            f"color {color} source_power_sums: {ps}",
+            f"color {color} target_power_sums: {pt}",
+        ])
+
+    example = "[" + ",".join("[1,0]" for _ in range(colors)) + "]"
+    statement = (
+        "Find an isomorphism between two colored finite simple graphs, subject "
+        "to the stated affine permutation group.\n\n"
+        "Definitions and conventions:\n"
+        f"- Arithmetic is in the prime field F_{p}; every displayed field element "
+        f"is its least nonnegative representative in 0..{p - 1}.\n"
+        f"- The common vertex set is all ordered pairs (i,x), where the color i "
+        f"is in 0..{colors - 1} and x is in 0..{p - 1}. Colors must be preserved.\n"
+        f"- In each graph and each color, the {size} listed active vertices form "
+        "a clique: every two distinct active vertices of that color are adjacent. "
+        "There are no other edges, including no edges between colors.\n"
+        "- For each color i, your map must have the affine form "
+        "(i,x) -> (i,(a_i*x+b_i) mod p), with 1 <= a_i <= p-1 and "
+        "0 <= b_i <= p-1. A nonzero a_i makes this a bijection.\n"
+        "- A valid answer must preserve edges and non-edges exactly. Equivalently, "
+        "for every color it must map the source active set onto the target active "
+        "set; equality is as sets, so displayed order is irrelevant.\n"
+        "- Each power_sums line is redundant exact data [S1,S2,S3], where "
+        "Sr = sum(x^r) mod p over that line's active labels.\n\n"
+        f"prime: {p}\ncolors: {colors}\nsupport_size: {size}\n"
+        f"tree_width_of_each_graph: {inst['tree_width']}\n" + "\n".join(rows) +
+        "\n\nGive your final answer inside <answer></answer> tags as one JSON "
+        f"array of exactly {colors} pairs [[a_0,b_0],...]. Integers must use "
+        "the least nonnegative representatives and no pair may be omitted.\n"
+        f"Example format only: <answer>{example}</answer>\n"
+        "Output nothing else inside the tags."
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text) -> object | None:
+    """Extract exactly one JSON array from answer tags, tolerating fences/prose."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if len(matches) != 1:
+        return None
+    body = matches[0].strip()
+    body = re.sub(r"^```(?:json|python)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check any allowed affine graph isomorphism; never inspect inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array of affine pairs"
+    if not answer:
+        return False, "answer is empty"
+    colors = inst["colors"]
+    if len(answer) != colors:
+        return False, f"wrong number of block maps: expected {colors}, received {len(answer)}"
+    p = inst["prime"]
+    for color, pair in enumerate(answer):
+        if not isinstance(pair, list) or len(pair) != 2:
+            return False, f"block {color}: map must be a two-element JSON array [a,b]"
+        a, b = pair
+        if not _is_int(a) or not _is_int(b):
+            return False, f"block {color}: a and b must both be integers"
+        if not 1 <= a <= p - 1:
+            return False, f"block {color}: multiplier a must be in inclusive range 1..{p - 1}"
+        if not 0 <= b <= p - 1:
+            return False, f"block {color}: translation b must be in inclusive range 0..{p - 1}"
+        mapped = {(a * x + b) % p for x in inst["source_active"][color]}
+        target = set(inst["target_active"][color])
+        if mapped != target:
+            return False, f"block {color}: active vertex set is not mapped onto target active set"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample the full statement-aware direct-product affine group."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    p = inst["prime"]
+    return [[rng.randrange(1, p), rng.randrange(p)] for _ in range(inst["colors"])]
+
+
+def search_space(inst) -> int | None:
+    """Return the exact size of the declared affine certificate language."""
+    p = inst["prime"]
+    return (p * (p - 1)) ** inst["colors"]
+
+
+def _anchor_maps_for_block(source, target, p: int, stop_after_first=False):
+    """Exhaust possible images of two fixed source points.
+
+    Returns (valid maps, candidate count, exact field-operation count).  The
+    counter includes modular additions/subtractions/multiplications and set
+    membership tests, but not Python loop/control overhead.
+    """
+    x0, x1 = source[0], source[1]
+    inv_dx = pow((x1 - x0) % p, -1, p)
+    target_set = set(target)
+    valid = []
+    candidates = 0
+    operations = 1  # one field inversion
+    for y0 in target:
+        for y1 in target:
+            if y0 == y1:
+                continue
+            candidates += 1
+            a = (y1 - y0) * inv_dx % p
+            b = (y0 - a * x0) % p
+            operations += 4
+            good = True
+            for x in source:
+                image = (a * x + b) % p
+                operations += 3  # multiply, add, target-set membership
+                if image not in target_set:
+                    good = False
+                    break
+            if good:
+                valid.append([a, b])
+                if stop_after_first:
+                    return valid, candidates, operations
+    return valid, candidates, operations
+
+
+def _reference_algorithm(inst):
+    """Standard exact two-point anchoring in each allowed affine group."""
+    maps = []
+    candidates = operations = 0
+    for color in range(inst["colors"]):
+        valid, seen, ops = _anchor_maps_for_block(
+            inst["source_active"][color], inst["target_active"][color],
+            inst["prime"], stop_after_first=True,
+        )
+        candidates += seen
+        operations += ops
+        if not valid:
+            return None, candidates, operations
+        maps.append(valid[0])
+    return maps, candidates, operations
+
+
+def enumerate_all(inst) -> int | None:
+    """Count all valid group elements exactly via exhaustive two-point anchors."""
+    total = 1
+    for color in range(inst["colors"]):
+        valid, _, _ = _anchor_maps_for_block(
+            inst["source_active"][color], inst["target_active"][color],
+            inst["prime"], stop_after_first=False,
+        )
+        total *= len({tuple(pair) for pair in valid})
+    return total
+
+
+def _normalized_support(values, p: int):
+    """Complete generic affine-orbit normal form based on centered moments."""
+    sums = _power_sums(values, p)
+    mean, c2, c3 = _centered_data_from_sums(sums, len(values), p)
+    if c2 == 0 or c3 == 0:
+        return None
+    scale = c3 * pow(c2, -1, p) % p
+    inv_scale = pow(scale, -1, p)
+    return tuple(sorted(((x - mean) * inv_scale) % p for x in values))
+
+
+def canonical_key(inst) -> str:
+    """Hash exact affine-normal forms, never the seed or rendered statement."""
+    p = inst["prime"]
+    blocks = []
+    for color in range(inst["colors"]):
+        left = _normalized_support(inst["source_active"][color], p)
+        right = _normalized_support(inst["target_active"][color], p)
+        blocks.append(sorted([left, right]))
+    payload = {
+        "prime": p,
+        "colors": inst["colors"],
+        "support_size": inst["support_size"],
+        "affine_normal_forms": blocks,
+    }
+    raw = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Grow modulus, crowding, and color count without lengthening each map."""
+    n = params.get("n")
+    colors = params.get("colors", 1)
+    support = params.get("support_size", 12)
+    if not all(_is_int(v) for v in (n, colors, support)):
+        return None
+    if colors < 8:
+        colors += 1
+    support = min(192, support + 24)
+    n = 2 * n + 1
+    return {"n": n, "colors": colors, "support_size": support}
+
+
+def _fit_pair(x0, x1, y0, y1, p):
+    if x0 == x1 or y0 == y1:
+        return [1, 0]
+    a = (y1 - y0) * pow((x1 - x0) % p, -1, p) % p
+    return [a, (y0 - a * x0) % p]
+
+
+def _attack_label_extremes(inst):
+    maps = []
+    p = inst["prime"]
+    for source, target in zip(inst["source_active"], inst["target_active"]):
+        maps.append(_fit_pair(min(source), max(source), min(target), max(target), p))
+    return maps
+
+
+def _attack_sorted_first_two(inst):
+    maps = []
+    p = inst["prime"]
+    for source, target in zip(inst["source_active"], inst["target_active"]):
+        maps.append(_fit_pair(source[0], source[1], target[0], target[1], p))
+    return maps
+
+
+def _attack_translation_or_reflection(inst):
+    """Try the obvious a=1, then a=-1, choosing b from first moments."""
+    p = inst["prime"]
+    inv_size = pow(inst["support_size"], -1, p)
+    choices = []
+    for sign in (1, p - 1):
+        maps = []
+        for source_sums, target_sums in zip(
+                inst["source_power_sums"], inst["target_power_sums"]):
+            mean_s = source_sums[0] * inv_size % p
+            mean_t = target_sums[0] * inv_size % p
+            maps.append([sign, (mean_t - sign * mean_s) % p])
+        choices.append(maps)
+    for candidate in choices:
+        if verify(inst, candidate)[0]:
+            return candidate
+    return choices[0]
+
+
+def _affine_relabel_instance(inst, left_maps, right_maps, reorder=False):
+    """Relabel both graph sides and carry the original witness by conjugation."""
+    p = inst["prime"]
+    colors = inst["colors"]
+    if len(left_maps) != colors or len(right_maps) != colors:
+        raise ValueError("one relabeling pair is required per color")
+    out = dict(inst)
+    new_source = []
+    new_target = []
+    carried = []
+    for color in range(colors):
+        u, t = left_maps[color]
+        v, w = right_maps[color]
+        a, b = inst["answer"][color]
+        if not (u % p and v % p):
+            raise ValueError("relabeling multipliers must be nonzero")
+        src = [(u * x + t) % p for x in inst["source_active"][color]]
+        dst = [(v * x + w) % p for x in inst["target_active"][color]]
+        if reorder:
+            src.reverse()
+            shift = color % len(dst)
+            dst = dst[shift:] + dst[:shift]
+        u_inv = pow(u, -1, p)
+        new_a = v * a * u_inv % p
+        new_b = (v * (b - a * u_inv * t) + w) % p
+        new_source.append(src)
+        new_target.append(dst)
+        carried.append([new_a, new_b])
+    out["source_active"] = new_source
+    out["target_active"] = new_target
+    out["source_power_sums"] = [_power_sums(row, p) for row in new_source]
+    out["target_power_sums"] = [_power_sums(row, p) for row in new_target]
+    out["answer"] = carried
+    return out
+
+
+def _swap_sides(inst):
+    p = inst["prime"]
+    out = dict(inst)
+    out["source_active"], out["target_active"] = (
+        [list(row) for row in inst["target_active"]],
+        [list(row) for row in inst["source_active"]],
+    )
+    out["source_power_sums"], out["target_power_sums"] = (
+        [list(row) for row in inst["target_power_sums"]],
+        [list(row) for row in inst["source_power_sums"]],
+    )
+    inverse = []
+    for a, b in inst["answer"]:
+        ai = pow(a, -1, p)
+        inverse.append([ai, (-ai * b) % p])
+    out["answer"] = inverse
+    return out
+
+
+def _answer_atoms(answer) -> int:
+    if isinstance(answer, dict):
+        return sum(_answer_atoms(value) for value in answer.values())
+    if isinstance(answer, (list, tuple)):
+        return sum(_answer_atoms(value) for value in answer)
+    return 1
+
+
+def _power_sum_solver(inst):
+    """The intended compact route, using only the six supplied sums per color."""
+    p = inst["prime"]
+    size = inst["support_size"]
+    maps = []
+    for source_sums, target_sums in zip(
+            inst["source_power_sums"], inst["target_power_sums"]):
+        mean_s, c2_s, c3_s = _centered_data_from_sums(source_sums, size, p)
+        mean_t, c2_t, c3_t = _centered_data_from_sums(target_sums, size, p)
+        # r = C3/C2 transforms as r -> a*r.
+        a = c3_t * c2_s * pow((c2_t * c3_s) % p, -1, p) % p
+        b = (mean_t - a * mean_s) % p
+        maps.append([a, b])
+    return maps
+
+
+def _compact_route_operation_bound(inst) -> int:
+    # Per color: derive two means/c2/c3 triples from the six supplied sums,
+    # form one covariant ratio, then derive b.  Count each modular inverse as
+    # twelve Euclidean divisions at the shipping modulus; this is conservative.
+    return 38 * inst["colors"]
+
+
+def selftest() -> dict:
+    report = {}
+
+    planted_ok = planted_total = 0
+    for _preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 2, 3):
+            inst = make_instance(seed=seed, **params)
+            planted_ok += int(verify(inst, inst["answer"])[0])
+            planted_total += 1
+    report["G1_planted_verifies"] = {
+        "pass": planted_ok == planted_total,
+        "verified": planted_ok,
+        "attempts": planted_total,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=314159, **shipping_params)
+    base = [pair[:] for pair in shipping["answer"]]
+    swapped = [pair[:] for pair in base]
+    swapped[0] = [base[0][1], base[0][0]]
+    duplicated = [pair[:] for pair in base]
+    duplicated[1] = duplicated[0][:]
+    corruptions = {
+        "drop_one": base[:-1],
+        "swap_one": swapped,
+        "duplicate_one": duplicated,
+        "empty": [],
+        "out_of_range": [[shipping["prime"], base[0][1]]] + base[1:],
+    }
+    corruption_results = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
+        corruption_results[name] = {"rejected": not ok, "reason": reason}
+    reasons = {item["reason"] for item in corruption_results.values()}
+    report["G2_rejects_corruption"] = {
+        "pass": all(item["rejected"] for item in corruption_results.values())
+                and len(reasons) == len(corruption_results),
+        "cases": corruption_results,
+        "distinct_reasons": len(reasons),
+    }
+
+    wire = json.dumps(shipping["answer"], separators=(",", ":"))
+    realistic = (
+        "The maps are below.\n<answer>```json\n" + wire
+        + "\n```</answer>\nI checked every color."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == shipping["answer"],
+        "parsed_equals_answer": parsed == shipping["answer"],
+        "json_native": json.loads(json.dumps(shipping["answer"])) == shipping["answer"],
+    }
+
+    guess_rng = random.Random(8675309)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        guess_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
+    guess_probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_total >= 200_000 and guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_probability,
+        "candidate_space": search_space(shipping),
+        "prior": "uniform direct product of all blockwise affine bijections",
+    }
+
+    t0 = time.perf_counter()
+    exact_count = enumerate_all(shipping)
+    count_seconds = time.perf_counter() - t0
+    t0 = time.perf_counter()
+    reference_answer, reference_candidates, reference_ops = _reference_algorithm(shipping)
+    reference_seconds = time.perf_counter() - t0
+    reference_ok = reference_answer is not None and verify(shipping, reference_answer)[0]
+    exact_fraction = exact_count / search_space(shipping)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": exact_fraction < 1e-6 and reference_ok,
+        "shipping_exact_solution_count": exact_count,
+        "shipping_candidate_space": search_space(shipping),
+        "shipping_exact_solution_fraction": exact_fraction,
+        "exact_count_wall_clock_seconds": round(count_seconds, 6),
+        "baseline_wall_clock_seconds": round(reference_seconds, 6),
+        "baseline_candidates": reference_candidates,
+        "baseline_operations": reference_ops,
+        "baseline_algorithm": "two-point anchoring in each affine permutation group",
+    }
+
+    attacks = {
+        "outlier_label_extremes": {"successes": 0, "attempts": 8},
+        "greedy_sorted_first_two": {"successes": 0, "attempts": 8},
+        "random_restart_256": {"successes": 0, "attempts": 8},
+        "translation_or_reflection_ansatz": {"successes": 0, "attempts": 8},
+    }
+    reference_successes = 0
+    reference_times = []
+    reference_operation_counts = []
+    reference_candidate_counts = []
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed, **shipping_params)
+        deterministic = {
+            "outlier_label_extremes": _attack_label_extremes(inst),
+            "greedy_sorted_first_two": _attack_sorted_first_two(inst),
+            "translation_or_reflection_ansatz": _attack_translation_or_reflection(inst),
+        }
+        for name, candidate in deterministic.items():
+            attacks[name]["successes"] += int(verify(inst, candidate)[0])
+        rrng = random.Random(seed ^ 0xA551)
+        random_hit = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, rrng))[0]:
+                random_hit = True
+                break
+        attacks["random_restart_256"]["successes"] += int(random_hit)
+
+        rt0 = time.perf_counter()
+        candidate, seen, ops = _reference_algorithm(inst)
+        reference_times.append(time.perf_counter() - rt0)
+        reference_candidate_counts.append(seen)
+        reference_operation_counts.append(ops)
+        reference_successes += int(candidate is not None and verify(inst, candidate)[0])
+
+    all_failed = all(item["successes"] == 0 and item["attempts"] >= 8
+                     for item in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "exact two-point anchoring in the allowed affine groups",
+            "complexity": "O(colors * support_size^3) exact field operations",
+            "wall_clock_sec_mean": round(sum(reference_times) / len(reference_times), 6),
+            "wall_clock_sec_max": round(max(reference_times), 6),
+            "candidates_mean": round(sum(reference_candidate_counts) / len(reference_candidate_counts)),
+            "candidates_max": max(reference_candidate_counts),
+            "operations_mean": round(sum(reference_operation_counts) / len(reference_operation_counts)),
+            "operations_max": max(reference_operation_counts),
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=2718, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["prime"] > shipping["prime"]
+                and search_space(doubled) > search_space(shipping),
+        "shipping_prime": shipping["prime"],
+        "doubled_prime": doubled["prime"],
+        "shipping_search_space_bits": search_space(shipping).bit_length(),
+        "doubled_search_space_bits": search_space(doubled).bit_length(),
+        "doubled_planted_verifies": doubled_ok,
+    }
+
+    invariant = carried_valid = 0
+    for seed in range(20):
+        inst = make_instance(seed=1000 + seed, **shipping_params)
+        rrng = random.Random(9000 + seed)
+        left = [[rrng.randrange(1, inst["prime"]), rrng.randrange(inst["prime"])]
+                for _ in range(inst["colors"])]
+        right = [[rrng.randrange(1, inst["prime"]), rrng.randrange(inst["prime"])]
+                 for _ in range(inst["colors"])]
+        transformed = _affine_relabel_instance(inst, left, right, reorder=True)
+        transformed = _swap_sides(transformed)
+        invariant += int(canonical_key(inst) == canonical_key(transformed))
+        carried_valid += int(verify(transformed, transformed["answer"])[0])
+    unrelated = {
+        canonical_key(make_instance(seed=2000 + seed, **shipping_params))
+        for seed in range(20)
+    }
+    report["G8_canonical_key"] = {
+        "pass": invariant == 20 and carried_valid == 20 and len(unrelated) == 20,
+        "composed_relabellings_invariant": invariant,
+        "carried_witnesses_valid": carried_valid,
+        "unrelated_distinct_keys": len(unrelated),
+        "attempts_each": 20,
+        "normal_form": "centered-moment affine normalization per colored support",
+    }
+
+    answer_chars = answer_atoms = 0
+    for seed in range(40):
+        answer = make_instance(seed=3000 + seed, **shipping_params)["answer"]
+        answer_chars = max(answer_chars, len(json.dumps(answer, separators=(",", ":"))))
+        answer_atoms = max(answer_atoms, _answer_atoms(answer))
+    answer_tokens = (answer_chars + 3) // 4
+    route_ops = _compact_route_operation_bound(shipping)
+    compact_answer = _power_sum_solver(shipping)
+    compact_ok = verify(shipping, compact_answer)[0]
+    arms = _G9_EVIDENCE["arms"]
+    hinted_rate = (arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+                   if arms["hinted"]["attempts"] else 0.0)
+    placebo_rate = (arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+                    if arms["placebo"]["attempts"] else 0.0)
+    within_caps = (answer_chars <= 2000 and answer_atoms <= 256
+                   and route_ops <= 300 and compact_ok)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": _G9_EVIDENCE["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_atoms,
+        "intended_route_operations": route_ops,
+        "compact_route_verified": compact_ok,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(shipping_params)
+    report["all_passed"] = all(
+        isinstance(value, dict) and value.get("pass")
+        for key, value in report.items() if key.startswith("G")
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
