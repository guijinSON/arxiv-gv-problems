+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Normalize each color class by its centered second and third power "
+        "sums; without that covariance invariant one must search the allowed "
+        "permutation coset."
+    ),
+    "hardness_basis": (
+        "Track B: the standard two-point anchoring algorithm for affine set "
+        "isomorphism is O(c*s^3) exact field operations; at the shipping "
+        "preset it averaged 273,306 operations and 0.053 seconds over eight "
