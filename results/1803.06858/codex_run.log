+    os.path.abspath(__file__)))))
+try:
+    from gvlib import rationals  # noqa: F401  (available, but not needed here)
+except ImportError:                 # pragma: no cover - stdlib fallback is complete
+    rationals = None
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
