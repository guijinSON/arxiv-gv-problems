+"""Verified Track-B generators for constrained bounded-tree-width isomorphism.
+
+The family uses the labeling-coset and colored-hypergraph isomorphism objects
+from Sections 2 and 5 of Grohe--Neuen--Schweitzer--Wiebking,
+"An improved isomorphism test for bounded-tree-width graphs"
+(arXiv:1803.06858).  Each instance consists of two exactly represented colored
+graphs and an allowed direct product of affine permutation groups.  A planted
+group element is sampled before the second graph is constructed.
+
+Only the Python standard library is required.  Importing this module performs
+no file I/O, network access, or printing.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import sys
+import time
+
+
