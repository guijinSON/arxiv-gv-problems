def parse_answer(text: str) -> object | None:
    if not isinstance(text, str):
        return None
    match = _ANSWER_RE.search(text)
    payload = match.group(1).strip() if match else text.strip()
    payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
    payload = re.sub(r"\s*```$", "", payload)
    try:
        value = json.loads(payload)
    except (TypeError, ValueError):
        decoder = json.JSONDecoder()
        for start, char in enumerate(payload):
            if char != "[":
                continue
            try:
                value, _end = decoder.raw_decode(payload[start:])
                break
            except ValueError:
                continue
        else:
            return None
    if not isinstance(value, list):
        return None
    return value


def _answer_shape_reason(answer: object, p: int) -> str | None:
    if not isinstance(answer, list):
        return "answer must be a JSON 2 by 2 matrix"
    if len(answer) != 2:
        return f"answer matrix must have 2 rows, got {len(answer)}"
    for i, row in enumerate(answer):
        if not isinstance(row, list) or len(row) != 2:
            got = len(row) if isinstance(row, list) else "non-list"
            return f"row {i} must have 2 entries, got {got}"
        for j, entry in enumerate(row):
            if isinstance(entry, bool) or not isinstance(entry, int):
                return f"entry ({i},{j}) must be an integer"
            if not 0 <= entry < p:
                return f"entry ({i},{j}) is outside 0..{p - 1}"
    flat = [entry for row in answer for entry in row]
    first = next((entry for entry in flat if entry), None)
    if first != 1:
        return "projective matrix is not normalized: first nonzero entry must be 1"
    if _det(answer, p) == 0:
        return "projective matrix must be invertible"
    return None


def verify(inst: dict, answer: object) -> tuple[bool, str]:
    """Check any normalized projective graph isomorphism; never read the plant."""
    p = inst["p"]
    reason = _answer_shape_reason(answer, p)
    if reason is not None:
        return False, reason
    T = answer  # type: ignore[assignment]
    try:
        transported = _conjugate(T, inst["generator_a"], p)
        forward = _normalize(inst["generator_b"], p)
        backward = _normalize(_mat_inv(inst["generator_b"], p), p)
    except (ValueError, ZeroDivisionError):
        return False, "projective matrix arithmetic failed"
    if transported not in (forward, backward):
        return False, "matrix does not preserve the projective cycle edges"
    return True, "ok"


def random_candidate(inst: dict, rng: random.Random) -> object:
    """Uniformly sample projectivities obeying the obvious hub constraint."""
    return _random_hub_mapping_projectivity(inst, rng)


def search_space(inst: dict) -> int:
    p = inst["p"]
    return p * (p - 1)  # one point-stabilizer coset in PGL(2,p)


def _all_normalized_pgl(p: int):
    for a in range(p):
        for b in range(p):
            for c in range(p):
                for d in range(p):
                    matrix = [[a, b], [c, d]]
                    if _det(matrix, p) and _normalize(matrix, p) == matrix:
                        yield matrix


def enumerate_all(inst: dict) -> int | None:
    if inst["p"] ** 4 > _ENUMERATION_CAP:
        return None
    return sum(1 for candidate in _all_normalized_pgl(inst["p"])
               if verify(inst, candidate)[0])


def canonical_key(inst: dict) -> str:
    """Complete graph-pair invariant for this constructed family."""
    # Each side is exactly a p-wheel with q pendant leaves at its hub. Generator
    # conjugation, reversal, side swapping, and arbitrary vertex relabelling do
    # not change these three structural numbers.
    invariant = [inst["p"], inst["pendant_count"], inst["tree_width"]]
    blob = json.dumps(invariant, separators=(",", ":"))
    return hashlib.sha256(blob.encode("ascii")).hexdigest()


def escalate(params: dict) -> dict | str | None:
    n = params.get("n")
    padding_factor = params.get("padding_factor", 1)
    if (isinstance(n, bool) or not isinstance(n, int)
            or isinstance(padding_factor, bool)
            or not isinstance(padding_factor, int) or padding_factor < 1):
        return None
    sequence = [4194301, 8388607, 2147483647, _P61, _P89, _P127,
                _P521, _P607, _P1279]
    for candidate in sequence:
        if candidate > n:
            return {"n": candidate, "padding_factor": padding_factor}
    # A larger supported modulus would push the four-entry decimal matrix over
    # the character cap.  Merely increasing the succinctly specified pendant
    # count would not make the algebraic task harder, so do not pretend it is a
    # useful fixed-length axis.
    return "cap_bound"


def _reference_graph_algorithm(inst: dict) -> dict:
    """Materialize both explicit graphs, traverse a cycle, and fit its map."""
    p = inst["p"]
    A, B = inst["generator_a"], inst["generator_b"]
    counter = [0]
    started = time.perf_counter()
    succ_a = [_act(A, point, p, counter) for point in range(p + 1)]
    succ_b = [_act(B, point, p, counter) for point in range(p + 1)]
    fixed_a = next(point for point, image in enumerate(succ_a) if point == image)
    fixed_b = next(point for point, image in enumerate(succ_b) if point == image)
    x = next(point for point in range(p + 1) if point != fixed_a)
    y = next(point for point in range(p + 1) if point != fixed_b)
    T = _three_point_projectivity(
        (fixed_a, x, succ_a[x]), (fixed_b, y, succ_b[y]), p, counter
    )
    current_a, current_b = x, y
    for _ in range(p):
        if _act(T, current_a, p, counter) != current_b:
            return {"answer": T, "ok": False, "operations": counter[0],
                    "wall_clock_sec": time.perf_counter() - started}
        current_a = succ_a[current_a]
        current_b = succ_b[current_b]
        counter[0] += 2
    # Account for the hub spokes and pendant leaves only because this reference
    # route explicitly expands the succinct graph before canonizing it.
    counter[0] += p
    checksum = 0
    for index in range(inst["pendant_count"]):
        checksum ^= index & 1
        counter[0] += 1
    elapsed = time.perf_counter() - started
    ok = current_a == x and current_b == y and verify(inst, T)[0]
    return {"answer": T, "ok": ok, "operations": counter[0],
            "wall_clock_sec": elapsed, "read_checksum": checksum}


def _count_atoms(value: object) -> int:
    if isinstance(value, dict):
        return sum(_count_atoms(item) for item in value.values())
    if isinstance(value, list):
        return sum(_count_atoms(item) for item in value)
    return 1


def _scaled_matrix(matrix: list[list[int]], scalar: int, p: int) -> list[list[int]]:
    return [[scalar * entry % p for entry in row] for row in matrix]


def selftest() -> dict:
    report: dict[str, Any] = {}

    # G1: all named presets, several seeds, and JSON-native planted answers.
    g1_ok = True
    g1_instances = 0
    for preset in DIFFICULTY.values():
        for seed in (0, 1, 17, 991):
            inst = make_instance(seed=seed, **preset)
            g1_instances += 1
            g1_ok &= verify(inst, inst["answer"])[0]
            g1_ok &= json.loads(json.dumps(inst["answer"])) == inst["answer"]
    report["G1_planted_verifies"] = {
        "pass": bool(g1_ok),
        "instances": g1_instances,
        "generation_route": (
            "inverse generation: sample C1,C2, then publish their conjugates "
            "and retain T=C2*C1^-1"
        ),
    }

    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
    inst = make_instance(seed=20260905, **ship_params)
    answer = inst["answer"]
    corruptions = {
        "empty": [],
        "drop_one": answer[:1],
        "out_of_range": [[inst["p"], answer[0][1]], answer[1][:]],
        "swap_two": [[answer[0][0], answer[1][0]],
                     [answer[0][1], answer[1][1]]],
        "duplicate": [answer[0][:], answer[0][:]],
    }
    reasons: dict[str, str] = {}
    g2_ok = True
    for name, corrupted in corruptions.items():
        valid, reason = verify(inst, corrupted)
        g2_ok &= not valid
        reasons[name] = reason
    g2_ok &= len(set(reasons.values())) == len(reasons)
    report["G2_rejects_corruption"] = {"pass": bool(g2_ok), "reasons": reasons}

    realistic = (
        "I used the conjugacy invariant.\n```json\n<answer>"
        + json.dumps(answer)
        + "</answer>\n```\n"
    )
    parsed = parse_answer(realistic)
    g3_ok = parsed == answer and parse_answer("no matrix here") is None
    report["G3_round_trip"] = {
        "pass": g3_ok,
        "json_native": json.loads(json.dumps(answer)) == answer,
        "answer_elements": _count_atoms(answer),
    }

    samples = 200_000
    hits = 0
    guess_rng = random.Random(8675309)
    for _ in range(samples):
        hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
    p = inst["p"]
    space = search_space(inst)
    exact_valid = 2 * p
    exact_denominator = p - 1
    g4_probability = 2 / exact_denominator
    report["G4_guess_resistance"] = {
        "pass": hits / samples < 1e-6 and g4_probability < 1e-6,
        "hits": hits,
        "total": samples,
        "empirical_probability": hits / samples,
        "exact_valid_answers": exact_valid,

