We will use the contraction lemma of
Babai~\cite{MR0316298}.
\begin{lem}[Contraction Lemma~\cite{MR0316298}]\label{theo:contractionlemma}
If~$\Gamma$ is a semiregular subgroup of the automorphism group of a graph~$G$ (i.e., the only element of~$\Gamma$ that has fixed points is the identity) then~$G$ has a minor isomorphic to a Cayley graph of~$\Gamma$.
\end{lem}

\begin{lem}\label{lem:minor}
  For $k\geq 1$, let $G$ be a
non-complete $k$-basic graph.
%  Suppose~$\Aut(G)$ has a point-stabilizer~$\Aut(G)_v$ such that~$p\nmid |\Aut(G)_v|$ for an odd prime~$p$.
   If for a prime~$p> k$,  the group $\mathbb{Z}_p^2$ is isomorphic to a
   subgroup of~$\Aut(G)$ then~$G$ has the~$p\times p$ toroidal grid~(i.e., $C_n
   \mathbin{\square} C_n$) as a minor.
\end{lem}

\begin{proof}
Let~$\Gamma$ be a subgroup of~$\Aut(G)$ isomorphic
to~$\mathbb{Z}_p^2$.
Let~$X\coloneqq V(G)\setminus \bigcup_{\gamma\in
  \Gamma} \fix(\gamma)$ be the set of vertices not fixed by any vertex
in~$\Gamma$.
Since $\Gamma$ is Abelian \cref{lem:order:p:fix:clique} implies
that $\bigcup_{\gamma\in\Gamma} \fix(\gamma)$ is a clique.
By assumption $G$ is non-complete and does not have any separating
cliques and therefore~$X$ is nonempty and connected.
Thus,~$\Gamma$ acts semi-regularly on~$X$.
By the contraction lemma (\cref{theo:contractionlemma}),~$X$ has a minor that is a Cayley graph of~$\mathbb{Z}_p^2$. We can assume that the Cayley graph is with respect to a minimal generating set~$\gamma_1,\gamma_2$. 
It suffices now to observe that the Cayley graph of~$\mathbb{Z}_p^2$ with respect to a generating set~$\gamma_1,\gamma_2$ is the toroidal grid.
\end{proof}


Since a $p\times p$-grid has tree width $p$ (a toroidal $p\times p$
even has tree width
either $2p-1$ or $2p-2$
\cite{Kiyomi:2016:TTG:2853242.2853625}),  the previous lemma shows
that the automorphism group of a $k$-basic graph of bounded treewdith
cannot contain $\mathbb{Z}_p^2$ as a subgroup.

% \begin{theo}[\cite{Kiyomi:2016:TTG:2853242.2853625}]\label{theo:toroidal}
% The tree width of the $p\times p$ toroidal grid is
% either $2p-1$ or $2p-2$ for any integer $p\geq 3$.
% \end{theo}
% 
% A combination of Theorem~\ref{theo:autG} and Lemma~\ref{lem:minor},
% together with other technical lemmas proved in the appendix, yields
% the following theorem. which is our main group theoretic result.

A group~$\Delta$ is a \emph{section} of a group~$\Gamma$ if there is a subgroup~$\Gamma'\leq \Gamma$ containing a normal subgroup~$N\trianglelefteq \Gamma'$ such that~$\Delta\cong \Gamma'/N$.
We say $\Gamma$ is $\Delta$-\emph{free}, if $\Delta$ is not a
section of $\Gamma$.
The next question is if $\ZZ_p^2$ could be a section of a group in $\Phi_k$
even for large primes $p>k$. It turns out that for $p>2$, the group $\ZZ_p^2$
has the very special property that it appears as a section, if and only if it is a subgroup.

\begin{lem}\label{lem:section}
If~$\ZZ_p^2$ is a section of a group~$\Gamma$ then~$\ZZ_p^2$ is also a
subgroup of~$\Gamma$ or~$p=2$ and the Sylow-2-groups of~$\Gamma$ are generalized quaternion groups.
\end{lem}

\begin{proof}
Let~$\gamma,\gamma'$ be lifts of two elements that generate~$\ZZ_p^2$.
By taking suitable powers, we can assume that the orders of~$\gamma$ and~$\gamma'$ are powers of~$p$.
By conjugating~$\gamma$ we can assume that they are contained in the
same~Sylow-$p$-group of~$\Gamma$.
We can thus assume that~$\Gamma$ is a~$p$-group.
All Abelian subgroups of~$\Gamma$ are cyclic, otherwise it
contains~$\ZZ_p^2$ and we are done.
By \cite{cartan2016homological}(Cartan, Eilenberg 1999, Theorem 11.6, p. 262)
we conclude that~$\Gamma$ is cyclic or a generalized quaternion group.
The former cannot be since~$\gamma$ and~$\gamma'$ are not powers of one another.
%Neither~$g$ nor~$g'$ is in the center, otherwise we are done.
%Let~$g''$ be an element of the center of the this means that~$g''$ is a power of~$g$ and of~$g$.
\end{proof}

\begin{theo}\label{theo:main-group}
Let $G$ be a graph of tree width $k\geq 2$.
%Let $M_k$ be the set of simple subgroups of $\sym(k)$.
Then every non-Abelian composition factor
of~$\aut(G)$ is alternating or $\ZZ_p^2$-free for all primes $p> k$.
\end{theo}

\begin{proof}
\Cref{theo:autG} shows that $\aut(G)\in\Psi_k$.
By definition of $\Psi_k$ the composition factors of any $\Delta\in\Psi_k$ are
isomorphic to a composition factor of of a member in:
$\Phi_k^{\leq}$ or $\sym(t)$ for some $t\in\NN$.
The composition factors of $\sym(t)$ are alternating.
So we are left to prove the statement for $\Phi_k^{\leq}$ groups.
Let $\Delta\in\Phi_k^{\leq}$.
Then there is $k$-basic graph $G$ of tree width at most $k$
such that $\Delta$ is isomorphic to a subgroup of $\aut(G)$.
Assume for contradiction that
$\Delta$ contains $\ZZ_p^2$ as a composition factor.
Then $\Aut(G)$ contains $\ZZ_p^2$ as a section.
By \cref{lem:section} the group $\aut(G)$ also contains $\ZZ_p^2$ as a
subgroup.
Then by \cref{lem:minor} the graph $G$ contains the
$p\times p$ toroidal grid as a minor or $G$ is the complete graph.
If $G$ has the $p\times p$ toroidal grid as a minor, then
the tree width of $G$ is at least $2p-2>k $
which is a contradiction.
If $G$ is complete, then $\ZZ_p^2$ is a subgroup of
the symmetric group on the vertex set.
In this case the number of vertices is at least $2p$,
but the complete graph on $2p$ vertices has tree width $2p-1>k$
which is again a contradiction.
\end{proof}


For completeness let us mention a converse to the statements presented.


\begin{lem}
Every group~$\Gamma \leq \sym(k)$ is isomorphic to the automorphism group of a
graph of tree width at most~$k$.
\end{lem}

The lemma can be shown by attaching suitable gadgets to a~$k$-clique.
We refer to~\cite{DBLP:conf/swat/OtachiS14}
(Lemma 16 in the arXiv version). 


