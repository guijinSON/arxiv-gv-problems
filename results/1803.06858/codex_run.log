"""Verified Track-B instances of bounded-tree-width graph isomorphism.

Each matrix below acts on the projective line over a prime field.  Its orbit
edges form one p-cycle and one fixed vertex; using the fixed vertex as a hub
gives a wheel with pendant leaves, hence a connected graph of tree width 3.
Two independently relabelled copies are made isomorphic by a projective change
of coordinates sampled before either public edge generator is formed.

The module is deterministic in (n, seed), standard-library-only, silent on
import, and performs no file or network I/O.
"""

from __future__ import annotations

import hashlib
import json
import math
import os
import random
import re
import time
from typing import Any


TRACK = "B"

PROBLEM_PROFILE = {
    "native_domain": "combinatorics",
    "object_regime": "finite_field",
    "computational_core": "graph",
    "certificate_form": "matrix_certificate",
    "native_objects": [
        "connected undirected simple graphs of tree width 3",
        "finite projective line over a prime field",
        "projective 2 by 2 vertex-bijection matrix",
    ],
    "verification_operations": [
        "exact modular matrix multiplication and inversion",
        "projective normalization",
        "exact conjugation of graph edge generators",
        "determinant nonzero test",
    ],
    "domain_essentiality": "native",
    "reduction_kind": "none",
    "reduction": None,
    "reduction_source": "paper_central",
    "intuition_type": "change of variables",
    "intuition_description": (
        "The two enormous wheel rims are generated by conjugate projective "
        "transformations, so a 2 by 2 change of coordinates replaces explicit "
        "graph materialization and traversal."
    ),
    "hardness_basis": (
        "Track B: Theorem 1 and Section 6 give a "
        "2^(k polylog k) poly(N) isomorphism algorithm, polynomial here at "
        "tree width k=3; the O(N log p)-bit audited reference expands the "
        "projective rims and traverses them at the shipping preset in 3,151,396 "
        "counted field operations and 0.509 seconds, while projective conjugacy "
        "uses 65 exact field operations."
    ),
    "max_answer_tokens": 7,
}

NATIVE = {
    "domain": PROBLEM_PROFILE["native_domain"],
    "core": PROBLEM_PROFILE["computational_core"],
    "objects": PROBLEM_PROFILE["native_objects"],
    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
    + PROBLEM_PROFILE["intuition_description"],
    "reduction": PROBLEM_PROFILE["reduction"],
}


# n is a lower bound on the prime cycle length.  For 64-bit n, make_instance
# deterministically takes the first prime p >= n.  The larger named values are
# known Mersenne primes and allow fixed-size-certificate escalation.
_P61 = 2305843009213693951
_P89 = 618970019642690137449562111
_P127 = 170141183460469231731687303715884105727
_P521 = (1 << 521) - 1
_P607 = (1 << 607) - 1
_P1279 = (1 << 1279) - 1
_KNOWN_LARGE_PRIMES = frozenset({_P89, _P127, _P521, _P607, _P1279})

DIFFICULTY = {
    "demo": {"n": 7},
    "easy": {"n": 131071},
    "medium": {"n": 524287},
    "hard": {"n": 2147483647},
}
SHIPPING_DIFFICULTY = "easy"

STRUCTURAL_HINT = (
    "The two cycle edge-generators are conjugate projective transformations "
    "under a change of coordinates."
)
PLACEBO_HINT = (
    "The two graph descriptions use least nonnegative field representatives "
    "for every displayed coordinate."
)

def search_space(inst: dict) -> int:
    p = inst["p"]
    return p * (p * p - 1)  # |PGL(2,p)|


def _all_normalized_pgl(p: int):
    for a in range(p):
        for b in range(p):
            for c in range(p):
                for d in range(p):
                    matrix = [[a, b], [c, d]]
                    if _det(matrix, p) and _normalize(matrix, p) == matrix:
                        yield matrix


def enumerate_all(inst: dict) -> int | None:
    if inst["p"] ** 4 > _ENUMERATION_CAP:
        return None
    return sum(1 for candidate in _all_normalized_pgl(inst["p"])
               if verify(inst, candidate)[0])


def canonical_key(inst: dict) -> str:
    """Complete graph-pair invariant for this constructed family."""
    # Each side is exactly a p-wheel with q pendant leaves at its hub. Generator
    # conjugation, reversal, side swapping, and arbitrary vertex relabelling do
    # not change these three structural numbers.
    invariant = [inst["p"], inst["pendant_count"], inst["tree_width"]]
    blob = json.dumps(invariant, separators=(",", ":"))
    return hashlib.sha256(blob.encode("ascii")).hexdigest()


def escalate(params: dict) -> dict | str | None:
    n = params.get("n")
    padding_factor = params.get("padding_factor", 1)
    if (isinstance(n, bool) or not isinstance(n, int)
            or isinstance(padding_factor, bool)
            or not isinstance(padding_factor, int) or padding_factor < 1):
        return None
    sequence = [131071, 524287, 2147483647, _P61, _P89, _P127,
                _P521, _P607, _P1279]
    for candidate in sequence:
        if candidate > n:
            return {"n": candidate, "padding_factor": padding_factor}
    # A larger supported modulus would push the four-entry decimal matrix over
    # the character cap.  Merely increasing the succinctly specified pendant
    # count would not make the algebraic task harder, so do not pretend it is a
    # useful fixed-length axis.
    return "cap_bound"


def _reference_graph_algorithm(inst: dict) -> dict:
    """Materialize both explicit graphs, traverse a cycle, and fit its map."""
    p = inst["p"]
    A, B = inst["generator_a"], inst["generator_b"]
    counter = [0]
    started = time.perf_counter()
    succ_a = [_act(A, point, p, counter) for point in range(p + 1)]
    succ_b = [_act(B, point, p, counter) for point in range(p + 1)]
    fixed_a = next(point for point, image in enumerate(succ_a) if point == image)
    fixed_b = next(point for point, image in enumerate(succ_b) if point == image)
    x = next(point for point in range(p + 1) if point != fixed_a)
    y = next(point for point in range(p + 1) if point != fixed_b)
    T = _three_point_projectivity(
        (fixed_a, x, succ_a[x]), (fixed_b, y, succ_b[y]), p, counter

