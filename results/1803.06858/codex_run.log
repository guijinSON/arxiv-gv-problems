+)
+
+# Filled after the harness-owned bare/hinted/placebo runs.  The three arms are
+# diagnostic data; only the measured answer/operation caps gate G9.
+_G9_EVIDENCE = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
