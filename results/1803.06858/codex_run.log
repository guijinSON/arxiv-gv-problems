+def _point_to_infinity(point: int, p: int) -> list[list[int]]:
+    """A normalized projectivity sending ``point`` to infinity."""
+    if point == p:
+        return [[1, 0], [0, 1]]
+    return [[0, 1], [1, (-point) % p]]
+
+
+def _random_hub_mapping_projectivity(inst: dict,
+                                      rng: random.Random) -> list[list[int]]:
+    """Uniformly sample the PGL coset mapping A's hub to B's hub."""
+    p = inst["p"]
+    fixed_a = _fixed_point(inst["generator_a"], p)
+    fixed_b = _fixed_point(inst["generator_b"], p)
+    source_coordinates = _point_to_infinity(fixed_a, p)
+    target_coordinates = _point_to_infinity(fixed_b, p)
+    # Every projectivity fixing infinity has one unique representative
+    # [[scale, shift], [0, 1]] with scale != 0.
+    affine = [[rng.randrange(1, p), rng.randrange(p)], [0, 1]]
+    return _normalize(
+        _mat_mul(
+            _mat_mul(_mat_inv(target_coordinates, p), affine, p),
+            source_coordinates,
+            p,
+        ),
+        p,
+    )
