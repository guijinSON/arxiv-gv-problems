% %For any graph $G$ not having $X$ as a minor
% %the automorphism group $\aut(G)$ is Abelian or non-simple
% %or is one of finitely many exceptions.
% %\end{conj}
% \begin{conj}[\cite{MR633647}]
% Let~$\mathcal{C}$ be a graph class excluding a fixed minor. 
% Then there is a finite set of simple groups~$M_{\mathcal{C}}$ such that 
% for every graph $G\in \mathcal{C}$ every non-Abelian composition factor
% of~$\aut(G)$ is alternating or a member~$M_{\mathcal{C}}$.
% \end{conj}

% To investigate this conjecture for graphs of tree width at most~$k$ we first
% argue that it is sufficient to analyze~$k$-improved clique separator free
% graphs of tree width at most $k$.
% We define $\Phi_k$ as the class of groups
% isomorphic to the automorphism group of a (finite) $k$-improved
% graph of tree width at most $k$ that
% does not have any separating cliques.

We need to introduce two further class of groups derived from
$\Phi_k$. We let~$\Phi_k^{\leq}$ be the class of groups that are
isomorphic to a subgroup of some group in~$\Phi_k$.
Note that every subgroup of~$\sym(k)$ is in~$\Phi_k^{\leq}$ since~$\sym(k)$ is
in $\Phi_k$. We let~$\Psi_k$ be the smallest class of groups that
contains $\Phi_k^{\leq}$ and all symmetric groups and is closed under
taking direct products and wreath products.

% with the following properties:
% \begin{itemize}
% \item $\Phi_k^{\leq}\subseteq \Psi_k$ 
% %\item Every subgroup of~$S_k$ is in~$\Psi_k$.
% \item For all~$t\in \NN$ the symmetric group~$\sym(t)$ is in~$\Psi_k$.

% \item If~$\Delta$ and~$\Delta'$ is in~$\Psi_k$ then the direct product~$\Delta\times \Delta'$ is in~$\Psi_k$.
% \item If~$\Delta$ and~$\Delta'$ is in~$\Psi_k$ then the wreath product~$\Delta\wr \Delta'$ is in~$\Psi_k$
% %\item If~$\Delta$ is in~$\Psi_k$ then~$\Delta\wr S_t$ is in~$\Psi_k$ for every~$t\in \mathbb{N}$.

% %\item If~$\Delta$ is in~$\Psi_k$ then for every subgroup~$\Lambda$ of~$S_k$ the group $\Delta\wr \Lambda$ is in~$\Psi_k$.

% \end{itemize}



\begin{theo}\label{theo:autG}
Every automorphism group of a graph of tree width at most~$k$ is in~$\Psi_k$.
\end{theo}

\begin{proof}
 Let~$G$ be a graph of tree width at most~$k$.  If~$G$ is not
  connected then the automorphism group is the direct product of
  wreath products of the automorphism groups of the components with
  symmetric groups. We can thus assume
  that~$G$ is connected.

  Consider the tree decomposition~$(T,\beta)$ of
  the~$k$-improvement~$G^k$ described in Theorem~\ref{theo:cliqueDecomposition}.
  Since the decomposition is automorphism-invariant we
  have~$\Aut(G) = \Aut(G,(T,\beta))$.

  We show the following statement by induction: If~$G$ is a graph with
  a tree decomposition~$(T,\beta)$ satisfying the properties of
  \cref{theo:cliqueDecomposition} and~$S\subseteq \beta(t)$ is a subset of
  the root bag, then~$\Theta =\Aut(G,(T,\beta))_{(S)}$, the point-wise stabilizer
  of~$S$, is in~$\Psi_k$.

First note that the root bag~$t$ of the decomposition is invariant
under~$\Theta$. Consequently, there is an induced homomorphism~$h$
from~$\Theta$ to~$\Theta|_{\beta(t)}$. Note that~$\Theta|_{\beta(t)}$
is a subgroup of $\aut(G[\beta(t)])$
which again is a subgroup of
$\aut(G^k[\beta(t)])$.
By \Cref{lem:imp}(2) the improvement $G^k$
again has tree width at most $k$
and therefore $\Theta|_{\beta(t)}\in \Phi_k^{\leq}$.

Consider the kernel~$\Delta$ of~$h$, the set of automorphism in~$\Theta$ that fix all vertices in~$\beta(t)$. 
Then~$\Theta$ is the wreath product of~$\Delta$ and~$\Theta|_{\beta(t)}$.

Suppose~$t_1,\ldots,t_\ell$ are the children of the root of~$T$. Let~$T_i$ be the decomposition of~$T$ below~$t_i$, and let~$G_i$ be the graph induced by the vertices that appear in bags of~$T_i$.
Call two children~$t_i,t_j$ of~$t$ equivalent, if~$t_i$ and~$t_j$ have the same
adhesion set~$S_i=S_j$ towards~$t$ and there is an isomorphism
from~$(G_i,(T_i,\beta|_{V(T_i)}))$ to~$(G_j,(T_j,\beta|_{V(T_j)}))$ that fixes all vertices in~$S_i$. Let~$r_1,\ldots,r_m$ be the equivalence classes with respect to this relation.

The group~$\Delta$ decomposes naturally into the direct product~$\Delta_1\times\Delta_2\times\ldots \times \Delta_m$ where each~$\Delta_j$ is the group of automorphism fixing~$\beta(t)$ and fixing all vertices outside the equivalence class~$r_j$.

If~$t^j_1,\ldots,t^j_{|r_j|}$ are the children of~$t$ in~$r_j$ then~$\Delta_j$
is the wreath product
of~$\aut(G_{t^j_1},(T_{t^j_1},\beta|_{V(T_{t^j_1})}))_{(S_{t^j_1})}$ with the
symmetric group~$\sym(|r_j|)$.
The group~$\aut(G_{t^j_1},(T_{t^j_1},\beta|_{V(T_{t^j_1})}))_{(S_{t^j_1})}$ is in~$\Psi_k$ by induction on the size of~$T$, which finishes the proof.
\end{proof}


Let us now turn to studying the groups in $\Phi^\le_k$. The results of
the previous section yield the following lemma.

\begin{lem}\label{lem:gammak}
  Let $G$ be a $k$-basic graph of tree width at most $k$.  Let
  $v\in V(G)$ be a vertex with degree at most $k$ in $G$.
  Then~$\aut(G)_v$, the group of automorphism of $G$ that fix $v$, is
  in $\Gammak$.
\end{lem}

\begin{proof}
By \Cref{theo:labelDecomposition} there is a mapping $f$
that assigns every $(G,v)$ a coset-labeled tree decomposition
$(T,\beta,\alpha)$ in an isomorphism invariant way.
The automorphism of $(T,\beta,\alpha)$, written $\aut(T,\beta,\alpha)$, are all
$\sigma\in\sym(V(G))$ such that $(T,\beta,\alpha)^\sigma:=(T,t\mapsto
\beta(t)^\sigma,t\mapsto\alpha(t)^\sigma)$ equals $(T,\beta,\alpha)$ up to
a renaming of the nodes in $V(T)$.

Our first claim is that $\aut(G,v)$ is a subgroup of $\aut(T,\beta,\alpha)$.
Let $\sigma\in\aut(G,v)$ be an arbitrary automorphism.
The construction of $(T,\beta,\alpha)$
from $(G,v)$ is isomorphism-invariant and therefore
$\sigma\in\aut(T,\beta,\alpha)$. More formally,
$(T,\beta,\alpha)^\sigma=f(G,v)^\sigma=f(G^\sigma,v^\sigma)=
f(G,v)=(T,\beta,\alpha)$ holds for any $\sigma\in\aut(G,v)$.
This proves the first claim.

Since $\aut(G,v)\leq\aut(T,\beta,\alpha)$ and $\Gammak$ is closed
under taking subgroups, it remains to show $\aut(T,\beta,\alpha)\in\Gammak$.
We proceed by induction on the number of nodes $n=|T|$ of $T$.

For $n=1$ every automorphism $\sigma$ fixing~$v$
%satisfies $\alpha^\sigma=\alpha$.
preserves $\alpha$.
Since there is only one $t\in T$
we conclude $\alpha(t)^\sigma=\alpha(t)$ or equivalently
$\aut(T,\beta,\alpha)\leq \Delta$, where we write
$\alpha(t)=\Delta\pi$. Now $\alpha(t)\in\gammak$ implies
$\aut(T,\beta,\alpha)\in\Gammak$.

Assume $n>1$ and let $t\in T$ be the root.
We
define a group homomorphism $h:\aut(T,\beta,\alpha)\to\sym(\beta(t))$ by the restriction of $\aut(T,\beta,\alpha)$ to $\beta(t)$. This homomorphism is well defined since~$\beta(t)$ is invariant under automorphisms.
Analogous to the base case one can show that the image of $h$
is in $\Gammak$. 

In general, for a group $\Theta$ and a normal subgroup
$N\trianglelefteq\Theta$
every composition factor of
$\Theta$ is a composition factor
of $N$ or a composition factor of the factor group $\Theta/N$.
%of a group in $\Gammak$ by a group in $\Gammak$ is a group that itself is in
% $\Gammak$,
Therefore, it suffices to show that the kernel of $h$, i.e., the set of
automorphism that fix the root bag pointwise, is in $\Gammak$.
The kernel of $h$ permutes the child-bags of $t$ with common adhesion sets.
Since the direct product of groups in $\Gammak$ is a group that is also in
$\Gammak$, we can restrict our attention to sets of children whose corresponding
subtrees have same adhesion set to the root bag.
Let $\Phi_1,\ldots,\Phi_r$ be the automorphism groups of subtrees rooted at
children of $t$ that all have the same adhesion set.
Notice that by Property \ref{i:4} of our coset-labeled tree decomposition
the number of children of $t$ with common adhesion set is bounded by $k$.

We can define a natural homomorphism into the permutation
group~$\{1,\ldots,r\}$ by considering the permutation of the children. With
similar arguments to before we conclude that it suffices to show the group of
automorphisms fixing the child-decompositions in~$\Gammak$. It thus suffices
to show that each group~$\Phi_i$ is in~$\Gammak$. Since~$\Phi_i$ is the automorphism group of some coset-labeled tree decomposition~$(T_i,\beta_i,\alpha_i)$ that is a subdecomposition of~$(T,\beta,\alpha)$, by induction hypothesis $\Phi_i\in\Gammak$ for each $i\in[r]$.
We conclude that $\aut(T,\beta,\alpha)\in\Gammak$.
\end{proof}

For a permutation~$\gamma\in \Sym(\Omega)$ we denote by~$\fix(\gamma)\coloneqq \{v\in \Omega\mid v^\gamma=v\}$ the set of points fixed by~$\gamma$. For a set of permutations~$S\subseteq \Sym(\Omega)$ we define~$\fix(S)\coloneqq \bigcap_{\gamma\in S}\fix(\gamma)$ as the points fixed by all elements in~$S$.


\begin{lem}\label{lem:order:p:fix:clique}
  For $k\geq 1$, let $G$ be a $k$-basic graph and
  let~$p> k$ be a prime.
  \begin{enumerate}
   \item If~$\gamma\in \Aut(G)$ has order~$p$ then~$\fix(\gamma)$ is a clique.
  \item If~$\gamma,\gamma'\in \Aut(G)$ commute and both have order~$p$ then~$\fix(\gamma)\cup \fix(\gamma')$ is a clique.
  
%  \item If~$\Gamma\leq  \Aut(G)$ is simple group that is not
%  isomorphic to a subgroup of~$\Sym(k-1)$ then there is a
%  connected~$\Gamma$-invariant subgraph~$G'$ of~$G$ on which the
%  induced action of~$\Gamma$ is fixed-point free. Moreover,~$\Aut(G)$
