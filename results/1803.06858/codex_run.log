+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "matrix_certificate",
+    "native_objects": [
+        "connected undirected simple graphs of tree width 3",
+        "finite projective line over a prime field",
+        "projective 2 by 2 vertex-bijection matrix",
+    ],
+    "verification_operations": [
+        "exact modular matrix multiplication and inversion",
+        "projective normalization",
+        "exact conjugation of graph edge generators",
+        "determinant nonzero test",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "The two enormous wheel rims are generated by conjugate projective "
+        "transformations, so a 2 by 2 change of coordinates replaces explicit "
+        "graph materialization and traversal."
+    ),
+    "hardness_basis": (
+        "Track B: Theorem 1 and Section 6 give a "
+        "2^(k polylog k) poly(N) isomorphism algorithm, polynomial here at "
+        "tree width k=3; the O(N log p)-bit audited reference materializes and "
+        "traverses the shipping graphs in at most 3,151,396 counted operations "
+        "and 3.252 seconds, while projective conjugacy uses 65 exact field "
+        "operations."
+    ),
+    "max_answer_tokens": 7,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
