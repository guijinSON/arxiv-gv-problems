+        "shipping_exact_solution_count": exact_count,
+        "shipping_candidate_space": search_space(shipping),
+        "shipping_exact_solution_fraction": exact_fraction,
+        "exact_count_wall_clock_seconds": round(count_seconds, 6),
+        "baseline_wall_clock_seconds": round(reference_seconds, 6),
+        "baseline_candidates": reference_candidates,
+        "baseline_operations": reference_ops,
+        "baseline_algorithm": "two-point anchoring in each affine permutation group",
+    }
+
+    attacks = {
+        "outlier_label_extremes": {"successes": 0, "attempts": 8},
+        "greedy_sorted_first_two": {"successes": 0, "attempts": 8},
+        "random_restart_256": {"successes": 0, "attempts": 8},
+        "translation_or_reflection_ansatz": {"successes": 0, "attempts": 8},
+    }
