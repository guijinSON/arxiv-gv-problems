+            "n": n,
+            "p": p,
+            "isolated_count": isolated_count,
+            "graph_order": p + 1 + isolated_count,
+            "tree_width": 2,
+            "generator_a": generator_a,
+            "generator_b": generator_b,
+            "answer": answer,
