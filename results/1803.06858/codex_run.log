+def _mat_mul(left: list[list[int]], right: list[list[int]], p: int,
+             counter: list[int] | None = None) -> list[list[int]]:
+    if counter is not None:
+        counter[0] += 12  # eight multiplications and four additions
+    return [
+        [
+            (left[i][0] * right[0][j] + left[i][1] * right[1][j]) % p
+            for j in range(2)
+        ]
+        for i in range(2)
+    ]
+
+
+def _mat_inv(matrix: list[list[int]], p: int,
+             counter: list[int] | None = None) -> list[list[int]]:
+    determinant = _det(matrix, p)
+    if determinant == 0:
+        raise ValueError("singular matrix")
+    inv_det = pow(determinant, -1, p)
+    if counter is not None:
+        counter[0] += 7  # determinant, one inversion, four scalar products
+    a, b = matrix[0]
+    c, d = matrix[1]
+    return [[d * inv_det % p, -b * inv_det % p],
+            [-c * inv_det % p, a * inv_det % p]]
+
 
+def _conjugate(change: list[list[int]], matrix: list[list[int]], p: int,
+               counter: list[int] | None = None) -> list[list[int]]:
+    return _normalize(
+        _mat_mul(_mat_mul(change, matrix, p, counter),
+                 _mat_inv(change, p, counter), p, counter),
+        p,
+    )
 
