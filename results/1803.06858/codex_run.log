+def _canonical_triple_map(x: int, y: int, z: int, p: int,
+                          counter: list[int] | None = None) -> list[list[int]]:
+    """Matrix sending the distinct points x,y,z to infinity,0,1."""
+    X = _homogeneous(x, p)
+    Y = _homogeneous(y, p)
+    Z = _homogeneous(z, p)
+    det_xz = (X[0] * Z[1] - X[1] * Z[0]) % p
+    det_yz = (Y[0] * Z[1] - Y[1] * Z[0]) % p
+    if det_xz == 0 or det_yz == 0:
+        raise ValueError("triple points must be distinct")
+    if counter is not None:
+        counter[0] += 12
+    return _normalize([
+        [(-det_xz * Y[1]) % p, (det_xz * Y[0]) % p],
+        [(-det_yz * X[1]) % p, (det_yz * X[0]) % p],
+    ], p)
 
 
