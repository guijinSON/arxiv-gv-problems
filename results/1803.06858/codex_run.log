+def _act(matrix: list[list[int]], point: int, p: int,
+         counter: list[int] | None = None) -> int:
+    """Act on labels 0..p-1, with p denoting the point infinity."""
+    a, b = matrix[0]
+    c, d = matrix[1]
+    if point == p:
+        if c % p == 0:
+            if counter is not None:
+                counter[0] += 1
+            return p
+        if counter is not None:
+            counter[0] += 2
+        return a * pow(c, -1, p) % p
+    numerator = (a * point + b) % p
+    denominator = (c * point + d) % p
+    if counter is not None:
+        counter[0] += 4
+    if denominator == 0:
+        return p
+    if counter is not None:
+        counter[0] += 2
+    return numerator * pow(denominator, -1, p) % p
 
