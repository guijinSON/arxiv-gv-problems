 \end{enumerate}
%  ~$p\geq k$ the set of all vertices in~$V(G)$ that are fixed by some element in~$\Aut(G)$ of order~$p$ forms a clique.
   %  Suppose~$\Aut(G)$ has a an element~$g$ of prime order~$p\geq k$. Then the fixed points of~$g$ form a clique.
\end{lem}

\begin{proof}
%For the first part let~$\Gamma\leq  \Aut(G)$ be a group not not isomorphic to a subgroup of~$\Sym(\{1,\ldots,n-1\})$.
%let~$v\in V(G)$ be a vertex that is not fixed by~$\Gamma$. 
%Note first that the group induced by~$\Gamma$ on the orbit of~$v$ is isomorphic to~$\Gamma$, since~$\Gamma$ is simple.
