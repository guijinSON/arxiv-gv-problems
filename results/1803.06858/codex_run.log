+    "object_regime": "finite_field",
+    "computational_core": "permutation",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "colored finite simple graphs",
+        "direct product of affine permutation groups over a prime field",
+        "graph isomorphism represented by one group element",
+    ],
+    "verification_operations": [
+        "exact modular affine evaluation",
+        "exact color preservation",
+        "exact edge-set comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Normalize each color class by its centered second and third power "
+        "sums; without that covariance invariant one must search the allowed "
+        "permutation coset."
+    ),
+    "hardness_basis": (
+        "Track B: the standard two-point anchoring algorithm for affine set "
+        "isomorphism is O(c*s^3) exact field operations; at the shipping "
+        "preset it averaged 273,306 operations and 0.053 seconds over eight "
+        "seeds, while the centered-power-sum route uses at most 152 exact "
+        "operations once the invariant is recognized."
+    ),
+    "max_answer_tokens": 13,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "Exactly c affine group elements [[a_0,b_0],...,[a_(c-1),b_(c-1)]]. "
+        "For the instance prime p, 1 <= a_i <= p-1 and 0 <= b_i <= p-1; "
+        "the element maps (i,x) to (i,(a_i*x+b_i) mod p)."
+    ),
+    "bounds": {
+        "pair_count": "c, at most 8 in the shipped escalation range",
+        "multiplier": "1..p-1",
+        "translation": "0..p-1",
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 19, "colors": 1, "support_size": 5},
+    "easy": {"n": 503, "colors": 2, "support_size": 32},
