/bin/bash -lc "python3 - <<'PY'
import importlib, json, os
m=importlib.import_module('gen_1803_06858')
assert m.TRACK in {'A','B'}
assert list(m.DIFFICULTY)==['demo','easy','medium','hard']
assert m.SHIPPING_DIFFICULTY=='medium'
p=m.PROBLEM_PROFILE; n=m.NATIVE
assert n['domain']==p['native_domain']
assert n['core']==p['computational_core']
assert n['objects']==p['native_objects']
assert n['reduction']==p['reduction']
for seed in (0,1,4242):
    a=m.make_instance(seed=seed,**m.DIFFICULTY['medium'])
    b=m.make_instance(seed=seed,**m.DIFFICULTY['medium'])
    assert a==b
    assert m.verify(a,a['answer'])==(True,'ok')
    assert json.loads(json.dumps(a['answer']))==a['answer']
    assert m.parse_answer('<answer>'+json.dumps(a['answer'])+'</answer>')==a['answer']
    os.environ.pop('GV_HINT_MODE',None)
    bare=m.render(a)
    assert m.STRUCTURAL_HINT not in bare and m.PLACEBO_HINT not in bare
    os.environ['GV_HINT_MODE']='structural'; assert m.STRUCTURAL_HINT in m.render(a)
    os.environ['GV_HINT_MODE']='placebo'; assert m.PLACEBO_HINT in m.render(a)
os.environ.pop('GV_HINT_MODE',None)
rep=json.load(open('selftest_report.json'))
assert rep['all_passed'] and all(v['pass'] for k,v in rep.items() if k.startswith('G'))
required={'schema_version','model','effort','params','seed','solved','parsed','verify_ok','verify_reason','reply','error','elapsed_sec','http_status','finish_reason','preset','escalation_round'}
for path in ('llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl'):
    rows=[json.loads(x) for x in open(path) if x.strip()]
    assert rows and all(required <= row.keys() for row in rows),path
print('final interface/metadata/transcript checks: pass')
print('bare rows:',sum(1 for _ in open('llm_loop_transcript.jsonl')))
