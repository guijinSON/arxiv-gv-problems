+STRUCTURAL_HINT = (
+    "The two cycle edge-generators are conjugate projective transformations "
+    "under a change of coordinates."
+)
+PLACEBO_HINT = (
+    "The two graph descriptions use least nonnegative field representatives "
+    "for every displayed coordinate."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A normalized invertible 2 by 2 matrix over F_p: four residues in a "
+        "JSON 2 by 2 array, with the first nonzero row-major entry equal to 1. "
+        "Matrices differing by a nonzero scalar denote the same projectivity."
+    ),
+    "bounds": {
+        "rows": 2,
+        "columns": 2,
+        "entries": 4,
+        "entry_min": 0,
+        "entry_max_exclusive": "instance prime p",
+        "normalization": "first nonzero row-major entry is 1",
