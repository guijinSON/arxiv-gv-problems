+    intended_operations = inst["edge_count"]
+    arms = {name: dict(G9_EVIDENCE[name]) for name in ("bare", "hinted", "placebo")}
+    hinted_rate = (
+        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
