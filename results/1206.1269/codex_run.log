+_MULTIPLICITY = 4
+_N_COLORS = 10
+_A = (0, 1, 2, 3)
+_B = (4, 5, 6, 7)
+_ODD_TAIL = (
+    (0, 1, 2, 3),
+    (4, 5, 6, 7),
+    (0, 1, 8, 9),
+    (2, 3, 4, 5),
