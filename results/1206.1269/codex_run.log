+def _parallel_copy_candidate(inst: dict) -> list[int]:
+    candidate = [None] * inst["edge_count"]
+    for bundle in inst["bundles"]:
+        for rank, edge_id in enumerate(sorted(bundle["edges"])):
+            candidate[edge_id] = inst["palette"][rank]
+    return candidate
+
