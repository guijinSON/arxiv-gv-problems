+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": carried_checks,
+        "distinct_unrelated": len(seen_keys),
+        "unrelated_attempts": len(selected),
+        "seeds_examined": seed - 20_000,
+        "failures": g8_failures,
+        "symmetries": [
