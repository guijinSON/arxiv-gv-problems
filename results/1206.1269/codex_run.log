+            return value
+        return None
+    if not re.fullmatch(r"[+-]?\d+(?:\s*(?:,|\s)\s*[+-]?\d+)*", body):
+        return None
+    try:
+        return [int(x) for x in re.findall(r"[+-]?\d+", body)]
+    except ValueError:
