+    }
+
+    # G8: 20 seeds, five real relabellings each, plus unrelated distinctness.
+    invariant_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    keys = []
+    for seed in range(20_000, 20_020):
+        inst = make_instance(seed=seed, **ship_params)
+        key = canonical_key(inst)
