#!/usr/bin/env bash
# Emit dataset instances from a finished module.
# Usage: scripts/emit.sh <arxiv_id> [count] [difficulty]
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
ID="${1:?usage: scripts/emit.sh <arxiv_id> [count] [difficulty]}"
N="${2:-20}"; DIFF="${3:-}"
MOD="$(ls results/$ID/gen_*.py 2>/dev/null | head -1)"
