+    }
+
+    # G7: fixed rates make all recognized exponential axes grow with n.
+    doubled_params = dict(ship_params)
+    doubled_params["n"] *= 2
+    doubled_params["rows"] *= 2
+    doubled_params["weight"] *= 2
