+    "verification_operations": [
+        "exact finite-field dot product",
+        "projective normalization check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "constraint propagation",
+    "intuition_description": (
+        "Two-coordinate projective points encode ratios between normal "
+        "coordinates; following a spanning tree replaces dense elimination."
+    ),
+    "hardness_basis": (
+        "Track B: modular Gaussian elimination on the shipping 192-by-128 "
+        "rank-127 system is O(m n^2); selftest measures its exact field-operation "
+        "count and wall time, while the compact spanning-tree route takes at most "
+        "255 field operations after the ratio invariant is recognized."
+    ),
+    "max_answer_tokens": 353,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
