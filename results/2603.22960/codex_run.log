+        row[v] = (row.get(v, 0) + amount * row.get(u, 0)) % p
+        new_points.append(_sparse_normalize(row, p))
+    out["points"] = new_points
+    normal = list(inst["answer"][0])
+    normal[u] = (normal[u] - amount * normal[v]) % p
+    answer = [_normalise_vector(normal, p)]
+    out["answer"] = answer
+    return out, answer
