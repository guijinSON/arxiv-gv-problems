+        answer_chars = max(answer_chars, len(json.dumps(sample["answer"])))
+        answer_elements = max(answer_elements, _atomic_elements(sample["answer"]))
+    answer_tokens = math.ceil(answer_chars / 4)
+    intended_operations = 2 * (shipping_params["n"] - 1) + 1
+    hinted = G9_ARM_RESULTS["hinted"]
+    placebo = G9_ARM_RESULTS["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": copy.deepcopy(G9_ARM_RESULTS),
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": "diagnostic_pending" if not hinted["attempts"] else (
+            "too_easy" if hinted["solved"] else "hardened"
+        ),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        isinstance(value, dict) and value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G")
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

codex
The first implementation is in place. It inverse-generates a nonzero projective normal, then constructs a connected collection of two-coordinate projective points orthogonal to it; connectedness guarantees rank \(d-1\), so the checker only needs exact modular dot products. I’m now stress-testing the corruption paths, Gaussian reference solver, adversary panel, and genuine change-of-basis invariance.
