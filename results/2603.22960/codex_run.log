+        combined["points"] = list(reversed(combined["points"]))
+        combined, combined_answer = _shear_coordinates(combined, 1, 2, 3)
+        transforms.extend([
+            (permuted, permuted_answer),
+            (sheared, sheared_answer),
+            (combined, combined_answer),
+        ])
