+    "hardness_basis": (
+        "Track B: modular Gaussian elimination on the shipping 192-by-128 "
+        "rank-127 system is O(m n^2); selftest measures its exact field-operation "
+        "count and wall time, while the compact spanning-tree route takes at most "
+        "255 field operations after the ratio invariant is recognized."
+    ),
+    "max_answer_tokens": 353,
+}
