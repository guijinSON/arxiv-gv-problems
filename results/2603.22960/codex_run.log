+        "so entry 0 is 1; n <= 256 and p is a prime below 2^31."
+    ),
+    "bounds": {
+        "rows": 1,
+        "max_columns": 256,
+        "field_bits": 31,
+        "nonzero_entries": True,
+        "first_entry": 1,
+    },
+}
