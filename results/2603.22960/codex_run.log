+def _dense_rows(inst: dict) -> list[list[int]]:
+    n = inst["dimension"]
+    dense = []
+    for point in inst["points"]:
+        row = [0] * n
+        for index, value in point:
+            row[index] = value
+        dense.append(row)
+    return dense
