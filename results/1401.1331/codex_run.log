+                    choices.append(start)
+                    break
+            if not choices:
+                break
+            start = choices[0]
+            starts.append(start)
+            used.update((start, start + q, start + 2 * q))
+        if len(starts) != 3:
+            continue
+        triples = [
+            [[start, 0], [start + q, 0], [start + 2 * q, 0]]
+            for start in starts
