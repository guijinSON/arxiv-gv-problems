+def _compact_decode(inst: dict) -> dict:
+    """Decode through the planted second-difference invariant."""
+    start = time.perf_counter()
+    p = inst["p"]
+    operations = 0
+    answer = None
+    packets_examined = 0
+    for packet_index, packet in enumerate(inst["packets"]):
