+def _corruption_report(inst: dict) -> tuple[bool, dict]:
+    base = copy.deepcopy(inst["answer"])
+    dropped = copy.deepcopy(base)
+    dropped["coefficients"] = dropped["coefficients"][:-1]
+
+    swapped = copy.deepcopy(base)
+    swap_index = next(
+        (i for i in range(1, inst["degree"])
+         if swapped["coefficients"][i] != swapped["coefficients"][i + 1]),
+        1,
+    )
+    swapped["coefficients"][swap_index], swapped["coefficients"][swap_index + 1] = (
+        swapped["coefficients"][swap_index + 1],
+        swapped["coefficients"][swap_index],
+    )
+
+    duplicated = copy.deepcopy(base)
+    duplicated["coefficients"][2] = duplicated["coefficients"][1]
+    if duplicated == base:
+        duplicated["coefficients"][2] = (duplicated["coefficients"][1] + 1) % inst["prime"]
+
+    out_of_range = copy.deepcopy(base)
+    out_of_range["step"] = inst["interval_radius"] + 1
+    variants = {
+        "drop_one": dropped,
+        "swap_two": swapped,
+        "duplicate_one": duplicated,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    results = {}
+    for name, candidate in variants.items():
+        ok, reason = verify(inst, candidate)
+        results[name] = {"rejected": not ok, "reason": reason}
+    reasons = [item["reason"] for item in results.values()]
+    passed = all(item["rejected"] for item in results.values()) and len(set(reasons)) == len(reasons)
+    return passed, results
+
