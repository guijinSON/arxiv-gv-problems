+    "demo": {
+        "n": 3,
+        "degree": 2,
+        "delta": 1,
+        "prime": 1_000_003,
+        "marker": 10,
+        "step_floor": 11,
+    },
+    "easy": {
+        "n": 12,
+        "degree": 5,
+        "delta": 2,
+        "prime": _P61,
+        "marker": 1000,
+        "step_floor": 1009,
+    },
+    "medium": {
+        "n": 20,
+        "degree": 6,
+        "delta": 3,
+        "prime": _P61,
+        "marker": 1000,
+        "step_floor": 1009,
+    },
+    "hard": {
+        "n": 32,
+        "degree": 6,
+        "delta": 4,
+        "prime": _P61,
+        "marker": 1000,
