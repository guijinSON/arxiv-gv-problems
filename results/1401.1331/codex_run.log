+    useful_step = _marker_step(shipping, route_counter)
+    shortcut = _raw_chain_answer(shipping, useful_step, route_counter) if useful_step else None
+    shortcut_ok = shortcut is not None and verify(shipping, shortcut)[0]
+    arms = copy.deepcopy(G9_RESULTS["arms"])
+    hinted_verdict = G9_RESULTS["hinted_verdict"]
+    hinted_attempts = arms.get("hinted", {}).get("attempts", 0)
+    within_caps = answer_chars <= 2_000 and answer_elements <= 256 and intended_ops <= 300
+    report["G9_no_tool_suitability"] = {
