+
+    attack_seeds = (101, 211, 307, 401, 503, 601, 701, 809)
+    attack_names = (
+        "outlier_smallest_value_magnitude",
+        "greedy_smallest_step_constant_noise",
+        "random_restart_256",
+        "obvious_sparse_top_monomial_ansatz",
+    )
+    attack_successes = {name: 0 for name in attack_names}
+    reference_successes = 0
+    reference_operations = 0
+    reference_candidates = 0
+    reference_times = []
+    for seed in attack_seeds:
+        inst = make_instance(seed=seed, **shipping_params)
+        candidates = {
+            "outlier_smallest_value_magnitude": _attack_outlier_magnitude(inst),
+            "greedy_smallest_step_constant_noise": _attack_smallest_step(inst),
+            "obvious_sparse_top_monomial_ansatz": _attack_sparse_monomial(inst),
+        }
+        for name, candidate in candidates.items():
+            attack_successes[name] += int(verify(inst, candidate)[0])
+        rrng = random.Random(seed ^ 0xA5A5A5A5)
+        restart_hit = any(verify(inst, random_candidate(inst, rrng))[0]
+                          for _ in range(256))
