+    coefficients: list[int], step: int, t: int, p: int,
+    counter: list[int] | None = None,
+) -> int:
+    """Evaluate sum_j b_j binom(t/step,j) in F_p exactly."""
+    x = (t % p) * pow(step % p, -1, p) % p
+    choose = 1
+    total = coefficients[0] % p
+    for j in range(1, len(coefficients)):
+        choose = choose * ((x - j + 1) % p) % p
+        choose = choose * pow(j, -1, p) % p
+        total = (total + coefficients[j] * choose) % p
+        if counter is not None:
+            counter[0] += 5
+    return total
+
+
+def _forward_coefficients(values: list[int], p: int,
+                          counter: list[int] | None = None) -> list[int]:
+    """Newton coefficients: b_j is the first j-th forward difference."""
+    row = [value % p for value in values]
+    coefficients = [row[0]]
+    while len(row) > 1:
+        row = [(row[i + 1] - row[i]) % p for i in range(len(row) - 1)]
+        if counter is not None:
+            counter[0] += len(row)
+        coefficients.append(row[0])
+    return coefficients
