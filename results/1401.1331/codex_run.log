+        "delta": 4,
+        "prime": _P127,
+        "marker": 1000,
+        "step_floor": 1009,
+    },
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON object containing one step from the displayed admissible-step "
+        "list and exactly d+1 canonical residues b_0,...,b_d in [0,p-1], "
+        "with b_0=0 and b_d nonzero; it denotes sum b_j*binom(X/step,j)."
+    ),
+    "bounds": {
+        "basis": "scaled falling factorials through the displayed degree d",
+        "step_choices": "the n displayed admissible nonzero steps",
+        "coefficient_range": "0 through p-1",
+        "constant_coefficient": 0,
+        "leading_coefficient": "1 through p-1",
+        "atomic_elements": 8,
