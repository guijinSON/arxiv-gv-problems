+def _solve2(row1: tuple[int, int], rhs1: int,
+            row2: tuple[int, int], rhs2: int, p: int) -> list[int] | None:
+    det = _det2(row1, row2, p)
+    if det == 0:
+        return None
+    inv = pow(det, -1, p)
+    a4 = (rhs1 * row2[1] - rhs2 * row1[1]) * inv % p
+    a3 = (row1[0] * rhs2 - row2[0] * rhs1) * inv % p
+    return [a4, a3]
 
 
