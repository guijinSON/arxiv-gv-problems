print('difficulty',list(g.DIFFICULTY),'shipping',g.SHIPPING_DIFFICULTY,'track',g.TRACK)
i=g.make_instance(seed=42,**g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
print('json_native',json.loads(json.dumps(i['answer']))==i['answer'])
print('default_hint_absent',g.STRUCTURAL_HINT not in g.render(i) and g.PLACEBO_HINT not in g.render(i))
os.environ['GV_HINT_MODE']='structural'; print('structural_once',g.render(i).count(g.STRUCTURAL_HINT))
os.environ['GV_HINT_MODE']='placebo'; print('placebo_once',g.render(i).count(g.PLACEBO_HINT))
os.environ.pop('GV_HINT_MODE',None)
for line in open('llm_loop_transcript.jsonl'):
 r=json.loads(line)
