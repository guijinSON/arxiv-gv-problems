+"""Verified Track-B generator for arXiv:1401.1331.
+
+The task is noisy polynomial interpolation over a prime field on a short
+integer interval.  A certificate writes the recovered polynomial in a scaled
+falling-factorial basis.  Generation samples that certificate first and only
+then forms its noisy evaluations; it never decodes an instance it created.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK: str = "B"
+SHIPPING_DIFFICULTY: str = "easy"
+
+_P61 = 2_305_843_009_213_693_951  # 2^61-1, prime
+_P127 = 170_141_183_460_469_231_731_687_303_715_884_105_727
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "polynomial",
+    "native_objects": [
+        "polynomial over a prime field in a scaled falling-factorial basis",
+        "noisy residues at points of a short integer interval",
+        "circular residue-distance constraints",
+    ],
+    "verification_operations": [
+        "exact finite-field inversion and multiplication",
+        "exact falling-factorial polynomial evaluation",
+        "exact circular residue-distance comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "A common residue class identifies the useful arithmetic progression, "
+        "where changing to the falling-factorial basis turns recovery into a "
+        "short forward-difference table instead of bounded-noise decoding."
+    ),
+    "hardness_basis": (
+        "Track B: Sections 3-4 recover by closest-vector decoding in fixed "
+        "dimension; the exact signed-error decoder used here costs "
+        "O((2*Delta+1)^d*(d^2+Nd)) and at shipping averaged 5,536,390 exact "
+        "operations and 0.51 seconds, while Section 5's forward-difference "
+        "change of variables uses at most 245 exact operations."
+    ),
+    "max_answer_tokens": 39,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
