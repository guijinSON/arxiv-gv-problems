+        starts = []
+        used = set(occupied)
+        for _slot in range(3):
+            choices = []
+            for _ in range(200):
+                start = rng.randint(-h, h - 2 * q)
+                points = {start, start + q, start + 2 * q}
+                if len(points) == 3 and not (points & used):
+                    choices.append(start)
+                    break
+            if not choices:
+                break
+            start = choices[0]
+            starts.append(start)
+            used.update((start, start + q, start + 2 * q))
+        if len(starts) != 3:
+            continue
+        triples = [
+            [[start, 0], [start + q, 0], [start + 2 * q, 0]]
+            for start in starts
