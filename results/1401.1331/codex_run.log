            if (y_bits >> output_bit) & 1:
                rows[output_bit] |= 1 << dimension
        trace_u = inst["trace_mask"]
        trace_v = inst["trace_mask"] << n
        rows.extend([
            trace_u | (t[0] << dimension),
            trace_v | (t[1] << dimension),
        ])
        encoded_answer, used = _solve_binary(rows, dimension)
        operations += used
