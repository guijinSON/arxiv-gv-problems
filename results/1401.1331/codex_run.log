+            for _t, observed, t4, t3 in prepared:
+                sample_checks += 1
+                predicted = (a4 * t4 + a3 * t3) % p
+                residue = (observed - predicted) % p
+                if min(residue, p - residue) > delta:
+                    valid = False
+                    break
