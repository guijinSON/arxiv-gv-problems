+    "object_regime": "finite_field",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "polynomial",
+    "native_objects": [
+        "polynomial over a prime field in a scaled falling-factorial basis",
+        "noisy residues at points of a short integer interval",
+        "circular residue-distance constraints",
+    ],
+    "verification_operations": [
+        "exact finite-field inversion and multiplication",
+        "exact falling-factorial polynomial evaluation",
+        "exact circular residue-distance comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "A common residue class identifies the useful arithmetic progression, "
+        "where changing to the falling-factorial basis turns recovery into a "
+        "short forward-difference table instead of bounded-noise decoding."
+    ),
+    "hardness_basis": (
+        "Track B: Sections 3-4 recover by closest-vector decoding in fixed "
+        "dimension; the exact bounded-noise interpolation reference used here "
+        "costs O((2*Delta+1)^d*(d^2+Nd)) and at the shipping preset is measured "
+        "by selftest, while the Section 5 forward-difference change of variables "
+        "uses at most 245 exact arithmetic operations."
+    ),
+    "max_answer_tokens": 75,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
