+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON object containing one step from the displayed admissible-step "
+        "list and exactly d+1 canonical residues b_0,...,b_d in [0,p-1], "
+        "with b_0=0 and b_d nonzero; it denotes sum b_j*binom(X/step,j)."
+    ),
