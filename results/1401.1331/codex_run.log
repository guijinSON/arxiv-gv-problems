+        reference_times.append(time.perf_counter() - start)
+        reference_operations += operations
+        reference_candidates += tried
+        reference_successes += int(decoded is not None and verify(inst, decoded)[0])
+
+    attacks = {
+        name: {"successes": attack_successes[name], "attempts": len(attack_seeds)}
+        for name in attack_names
