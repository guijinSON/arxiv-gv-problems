-        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
-    _validate_parameters(n, degree, delta, prime, marker, step_floor)
-    if isinstance(seed, bool) or not isinstance(seed, int):
-        raise TypeError("seed must be an integer")
-
-    rng = random.Random(seed)
-    prime_pool = _next_primes(step_floor, max(3 * n, n + 8))
-    rng.shuffle(prime_pool)
-    magnitudes = prime_pool[:n]
-    steps = [magnitude if rng.randrange(2) else -magnitude
-             for magnitude in magnitudes]
-    plant_step = rng.choice(steps)
-
-    # Sample the useful progression's observed residues across the whole field,
-    # all in one class modulo marker.  Inverting the forward-difference identity
-    # constructs the certificate; it is not a recovery search.  Sampling values
-    # first avoids the magnitude outlier created by small, no-wrap coefficients.
-    common_error = rng.randrange(delta + 1)
-    grid_size = (prime - 1 - common_error) // marker
-    for _ in range(10_000):
-        planted_observed = [common_error]
-        planted_observed.extend(
-            common_error + marker * rng.randrange(1, grid_size + 1)
-            for _ in range(degree)
-        )
-        planted_values = [(value - common_error) % prime
-                          for value in planted_observed]
-        coefficients = _forward_coefficients(planted_values, prime)
-        if coefficients[-1] != 0:
-            break
-    else:
-        raise RuntimeError("could not sample a full-degree planted polynomial")
-
-    points = {0}
-    for step in steps:
-        points.update(j * step for j in range(1, degree + 1))
-    if len(points) != 1 + n * degree:
-        raise AssertionError("candidate progressions unexpectedly intersect")
-
-    true_values = {
-        t: _eval_binomial(coefficients, plant_step, t, prime) for t in points
-    }
-    errors = {j * plant_step: common_error for j in range(degree + 1)}
-
-    # Every non-planted chain uses the same per-observation error range.  Reject
-    # only the rare higher-order correlations that would create a second marker
-    # chain or another constant-error shortcut.
-    for step in steps:
-        if step == plant_step:
-            continue
-        chain_points = [j * step for j in range(1, degree + 1)]
-        for _ in range(10_000):
-            trial = [rng.randrange(delta + 1) for _ in chain_points]
-            row_values = [common_error]
-            row_values.extend((true_values[t] + e) % prime
-                              for t, e in zip(chain_points, trial))
-            if (any(e != common_error for e in trial)
-                    and len({value % marker for value in row_values}) > 1):
-                for t, e in zip(chain_points, trial):
-                    errors[t] = e
-                break
-        else:
-            raise RuntimeError("could not decorrelate a decoy progression")
-
-    observations = [[t, (true_values[t] + errors[t]) % prime]
-                    for t in points]
-    rng.shuffle(observations)
-    public_steps = list(steps)
-    rng.shuffle(public_steps)
-    answer = _answer(plant_step, coefficients)
-    instance = {
-        "family": "short_interval_noisy_polynomial",
-        "prime": prime,
-        "interval_radius": degree * max(abs(step) for step in steps),
-        "degree": degree,
-        "delta": delta,
-        "marker": marker,
-        "known_constant": 0,
-        "candidate_steps": public_steps,
-        "observations": observations,
-        "answer": answer,
-    }
-    if _marker_step(instance) != plant_step:
-        raise AssertionError("internal marker invariant failed")
-    return instance
