+def _reordered_instance(inst: dict, rng: random.Random) -> dict:
+    moved = {key: value for key, value in inst.items() if key != "packets"}
+    packets = []
+    for source_packet in inst["packets"]:
+        packet = []
+        for source_triple in source_packet:
