-def _candidate_from_chain(inst: dict, step: int, errors) -> dict:
-    """Interpolate the candidate obtained by correcting one public chain."""
-    obs = _observation_map(inst)
-    corrected = [0]
-    corrected.extend(
-        (obs[j * step] - error) % inst["prime"]
-        for j, error in enumerate(errors, 1)
-    )
-    return _answer(step, _forward_coefficients(corrected, inst["prime"]))
-
-
-def random_candidate(inst: dict, rng: random.Random) -> object:
-    """Sample after enforcing one chain's obvious noise constraints.
-
-    Choosing arbitrary field coefficients would be the naive prior: anyone who
-    has read the statement can instead choose a displayed step, choose one of
-    the 2*Delta+1 allowed corrected values at each of its d nonzero points, and
-    interpolate. Rejection of the negligible degree-drop cases makes this
-    uniform over exactly the finite language counted by ``search_space``.
-    """
-    errors = range(-inst["delta"], inst["delta"] + 1)
-    while True:
-        step = rng.choice(inst["candidate_steps"])
-        candidate = _candidate_from_chain(
-            inst,
-            step,
-            [rng.choice(errors) for _ in range(inst["degree"])],
-        )
-        if candidate["coefficients"][-1] != 0:
-            return candidate
-
-
-def _zero_leading_count(inst: dict, step: int) -> int:
-    """Count allowed anchor-error vectors whose interpolant drops degree.
-
-    The top Newton coefficient is the d-th forward difference. Its dependence
-    on the d signed errors is a short integer weighted sum, so dynamic
-    programming gives the exact count without enumerating all error tuples.
-    """
-    degree = inst["degree"]
-    p = inst["prime"]
-    obs = _observation_map(inst)
-    weights = [(-1 if (degree - j) % 2 else 1) * math.comb(degree, j)
-               for j in range(1, degree + 1)]
-    base = sum(weight * obs[j * step]
-               for j, weight in enumerate(weights, 1)) % p
-    counts = {0: 1}
-    for weight in weights:
-        following = {}
-        for total, multiplicity in counts.items():
-            for error in range(-inst["delta"], inst["delta"] + 1):
-                value = total + weight * error
-                following[value] = following.get(value, 0) + multiplicity
-        counts = following
-    return sum(multiplicity for total, multiplicity in counts.items()
-               if (base - total) % p == 0)
-
-
-def search_space(inst: dict) -> int | None:
-    raw_per_step = (2 * inst["delta"] + 1) ** inst["degree"]
-    return sum(raw_per_step - _zero_leading_count(inst, step)
-               for step in inst["candidate_steps"])
-
-
-def enumerate_all(inst: dict) -> int | None:
-    """Enumerate only truly small declared languages; never hang a caller."""
-    space = search_space(inst)
-    if space is None or space > _ENUMERATION_CAP:
-        return None
-    hits = 0
-    errors = range(-inst["delta"], inst["delta"] + 1)
-    for step in inst["candidate_steps"]:
-        for error_vector in itertools.product(errors, repeat=inst["degree"]):
-            candidate = _candidate_from_chain(inst, step, error_vector)
-            if candidate["coefficients"][-1] != 0:
-                hits += int(verify(inst, candidate)[0])
-    return hits
-
-
-def _canonical_payload(inst: dict, reflect: bool) -> str:
-    sign = -1 if reflect else 1
-    payload = {
-        "family": inst["family"],
-        "prime": inst["prime"],
-        "interval_radius": inst["interval_radius"],
-        "degree": inst["degree"],
-        "delta": inst["delta"],
-        "marker": inst["marker"],
-        "known_constant": inst["known_constant"],
-        "candidate_steps": sorted(sign * value for value in inst["candidate_steps"]),
-        "observations": sorted([sign * t, s] for t, s in inst["observations"]),
-    }
-    return json.dumps(payload, sort_keys=True, separators=(",", ":"))
-
-
-def canonical_key(inst: dict) -> str:
-    """Canonicalize input order and the field-variable reflection X -> -X."""
-    normal = _canonical_payload(inst, False)
-    reflected = _canonical_payload(inst, True)
-    return hashlib.sha256(min(normal, reflected).encode()).hexdigest()
-
-
-def escalate(params: dict) -> dict | str | None:
-    """Grow clue crowding and arithmetic entropy without lengthening the answer."""
-    result = dict(params)
-    result.pop("_preset", None)
-    n = result.get("n", 20)
-    if n < 39:
-        result["n"] = min(39, n + 4)
-        return result
-    if result.get("delta", 3) < 12:
-        result["delta"] = result.get("delta", 3) + 1
-        return result
-    prime = result.get("prime", _P61)
-    if prime == _P61:
-        result["prime"] = _P127
-        return result
-    if prime == _P127:
-        result["prime"] = _P521
-        return result
-    if prime == _P521:
-        result["prime"] = _P607
-        return result
-    if prime == _P607:
-        # The next known Mersenne-prime rung, 2^1279-1, makes six
-        # nonconstant canonical coefficients exceed 2,000 characters.
-        return "cap_bound"
-    return None
-
-
-def _reference_decode(inst: dict) -> tuple[dict | None, int, int]:
-    """Generic exact bounded-noise interpolation on one arbitrary chain.
-
-    This deliberately does not inspect the marker correlation.  It enumerates
-    every signed error allowed at d nonzero samples, constructs the unique
-    Newton polynomial on that chain, and checks all remaining observations.
-    """
-    p = inst["prime"]
-    degree = inst["degree"]
-    delta = inst["delta"]
-    step = inst["candidate_steps"][0]
-    obs = _observation_map(inst)
-    values = [obs[j * step] for j in range(degree + 1)]
-    at_zero = values[0]
-    zero_error = at_zero if at_zero <= delta else at_zero - p
-    if abs(zero_error) > delta:
-        return None, 0, 0
-
-    chain_points = {j * step for j in range(degree + 1)}
-    checks = [row for row in inst["observations"] if row[0] not in chain_points]
-    checks.extend(row for row in inst["observations"] if row[0] in chain_points)
-    operations = 0
-    candidates = 0
-    # A construction-aware adversary tries the generator's nonnegative offsets
-    # before the remaining signs. It is still exhaustive over the public noise
-    # interval and is stronger than a lexicographic signed enumeration here.
-    errors = tuple(range(0, delta + 1)) + tuple(range(-1, -delta - 1, -1))
-    for tail_errors in itertools.product(errors, repeat=degree):
-        candidates += 1
-        corrected = [0]
-        corrected.extend((values[j] - tail_errors[j - 1]) % p
-                         for j in range(1, degree + 1))
-        counter = [0]
-        coefficients = _forward_coefficients(corrected, p, counter)
-        operations += counter[0] + degree
-        if coefficients[-1] == 0:
-            continue
-        good = True
-        for t, observed in checks:
-            counter = [0]
-            value = _eval_binomial(coefficients, step, t, p, counter)
-            operations += counter[0] + 1
-            if _circular_distance(value, observed, p) > delta:
-                good = False
-                break
-        if good:
-            candidate = _answer(step, coefficients)
-            if verify(inst, candidate)[0]:
-                return candidate, operations, candidates
-    return None, operations, candidates
-
-
-def _attack_outlier_magnitude(inst: dict) -> dict:
-    obs = _observation_map(inst)
-    p = inst["prime"]
-    step = min(
-        inst["candidate_steps"],
-        key=lambda r: sum(min(obs[j * r], p - obs[j * r])
-                          for j in range(1, inst["degree"] + 1)),
-    )
-    return _raw_chain_answer(inst, step)
-
-
-def _attack_smallest_step(inst: dict) -> dict:
-    step = min(inst["candidate_steps"], key=lambda value: (abs(value), value))
-    return _raw_chain_answer(inst, step)
-
-
-def _attack_sparse_monomial(inst: dict) -> dict:
-    step = inst["candidate_steps"][0]
-    raw = _raw_chain_answer(inst, step)["coefficients"]
-    coefficients = [0] * (inst["degree"] + 1)
-    coefficients[-1] = raw[-1] or 1
-    return _answer(step, coefficients)
-
-
-def _answer_atoms(value) -> int:
-    if isinstance(value, dict):
-        return sum(_answer_atoms(item) for item in value.values())
-    if isinstance(value, list):
-        return sum(_answer_atoms(item) for item in value)
-    return 1
-
