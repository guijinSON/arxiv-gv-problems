+"""Verified Track-B generator for arXiv:1401.1331.
+
+The task is noisy polynomial interpolation over a prime field on a short
+integer interval.  A certificate writes the recovered polynomial in a scaled
+falling-factorial basis.  Generation samples that certificate first and only
+then forms its noisy evaluations; it never decodes an instance it created.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
