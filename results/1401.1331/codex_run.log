-def escalate(params: dict) -> dict | str | None:
-    """Grow clue crowding and arithmetic entropy without lengthening the answer."""
-    result = dict(params)
-    result.pop("_preset", None)
-    n = result.get("n", 20)
-    if n < 39:
-        result["n"] = min(39, n + 4)
-        return result
-    if result.get("delta", 3) < 12:
-        result["delta"] = result.get("delta", 3) + 1
-        return result
-    prime = result.get("prime", _P61)
-    if prime == _P61:
-        result["prime"] = _P127
-        return result
-    if prime == _P127:
-        result["prime"] = _P521
-        return result
-    if prime == _P521:
-        result["prime"] = _P607
-        return result
-    if prime == _P607:
-        # The next known Mersenne-prime rung, 2^1279-1, makes six
-        # nonconstant canonical coefficients exceed 2,000 characters.
-        return "cap_bound"
-    return None
