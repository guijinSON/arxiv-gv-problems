+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_parameters(n, degree, delta, prime, marker, step_floor)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise TypeError("seed must be an integer")
+
+    rng = random.Random(seed)
+    prime_pool = _next_primes(step_floor, max(3 * n, n + 8))
+    rng.shuffle(prime_pool)
+    magnitudes = prime_pool[:n]
+    steps = [magnitude if rng.randrange(2) else -magnitude
+             for magnitude in magnitudes]
+    plant_step = rng.choice(steps)
+
+    # Sample the useful progression's observed residues across the whole field,
+    # all in one class modulo marker.  Inverting the forward-difference identity
+    # constructs the certificate; it is not a recovery search.  Sampling values
+    # first avoids the magnitude outlier created by small, no-wrap coefficients.
+    common_error = rng.randrange(delta + 1)
+    grid_size = (prime - 1 - common_error) // marker
+    for _ in range(10_000):
+        planted_observed = [common_error]
+        planted_observed.extend(
+            common_error + marker * rng.randrange(1, grid_size + 1)
+            for _ in range(degree)
+        )
+        planted_values = [(value - common_error) % prime
+                          for value in planted_observed]
+        coefficients = _forward_coefficients(planted_values, prime)
+        if coefficients[-1] != 0:
+            break
+    else:
+        raise RuntimeError("could not sample a full-degree planted polynomial")
+
+    points = {0}
+    for step in steps:
+        points.update(j * step for j in range(1, degree + 1))
+    if len(points) != 1 + n * degree:
+        raise AssertionError("candidate progressions unexpectedly intersect")
+
+    true_values = {
+        t: _eval_binomial(coefficients, plant_step, t, prime) for t in points
+    }
+    errors = {j * plant_step: common_error for j in range(degree + 1)}
+
+    # Every non-planted chain uses the same per-observation error range.  Reject
+    # only the rare higher-order correlations that would create a second marker
+    # chain or another constant-error shortcut.
+    for step in steps:
+        if step == plant_step:
+            continue
+        chain_points = [j * step for j in range(1, degree + 1)]
+        for _ in range(10_000):
+            trial = [rng.randrange(delta + 1) for _ in chain_points]
+            row_values = [common_error]
+            row_values.extend((true_values[t] + e) % prime
+                              for t, e in zip(chain_points, trial))
+            if (any(e != common_error for e in trial)
+                    and len({value % marker for value in row_values}) > 1):
+                for t, e in zip(chain_points, trial):
+                    errors[t] = e
+                break
+        else:
+            raise RuntimeError("could not decorrelate a decoy progression")
+
+    observations = [[t, (true_values[t] + errors[t]) % prime]
+                    for t in points]
+    rng.shuffle(observations)
+    public_steps = list(steps)
+    rng.shuffle(public_steps)
+    answer = _answer(plant_step, coefficients)
+    instance = {
+        "family": "short_interval_noisy_polynomial",
+        "prime": prime,
+        "interval_radius": degree * max(abs(step) for step in steps),
+        "degree": degree,
+        "delta": delta,
+        "marker": marker,
+        "known_constant": 0,
+        "candidate_steps": public_steps,
+        "observations": observations,
+        "answer": answer,
+    }
+    if _marker_step(instance) != plant_step:
+        raise AssertionError("internal marker invariant failed")
+    return instance
+
+
+def render(inst: dict) -> str:
+    """Return the complete solver-facing statement."""
+    step_text = ", ".join(str(value) for value in inst["candidate_steps"])
+    observation_text = "\n".join(
+        f"{t} {s}" for t, s in inst["observations"]
+    )
+    statement = f"""Noisy polynomial interpolation over a short interval
+
+Let p = {inst['prime']}, a prime.  The finite field F_p is represented by the
+integers 0 through p-1.  For residues a,b define their circular distance as
+min((a-b) mod p, (b-a) mod p), an integer from 0 through (p-1)/2.
+
+An unknown polynomial f over F_p has exact degree d = {inst['degree']} and
+known constant value f(0)=0.  At every displayed integer t, the displayed
+residue s satisfies circular_distance(f(t),s) <= Delta, where Delta =
+{inst['delta']}.  All t lie in the closed interval
+[-{inst['interval_radius']}, {inst['interval_radius']}].  Points do not repeat.
+
+Return f in one of the following scaled falling-factorial bases.  Choose one
+signed, nonzero step r from this admissible list (order has no significance):
+{step_text}
+
+Your coefficients must be exactly d+1 canonical residues b_0,...,b_d with
+0 <= b_j < p, b_0=0, and b_d != 0.  They denote
+
+    f(X) = sum from j=0 to d of b_j * binom(X/r, j)  in F_p,
+
+where X/r means X times the inverse of r modulo p, binom(Y,0)=1, and
+binom(Y,j)=Y(Y-1)...(Y-j+1)/j! in F_p.  Different admissible steps may give
+different coefficient lists for the same polynomial; any one that meets every
+observation is valid.  The auxiliary integer marker is M = {inst['marker']}.
+
+Observations are lines "t s" in arbitrary order:
+{observation_text}
+
+Give your final answer inside <answer></answer> tags as one JSON object with
+exactly the keys "step" and "coefficients".  Integers are decimal and the
+coefficient list is ordered b_0 through b_d.
+Example: <answer>{{"step": 17, "coefficients": [0, 4, 9]}}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def _json_object_from_text(text: str):
+    decoder = json.JSONDecoder()
+    for index, char in enumerate(text):
+        if char != "{":
+            continue
+        try:
+            value, _ = decoder.raw_decode(text[index:])
+        except (TypeError, ValueError):
+            continue
+        if isinstance(value, dict):
+            return value
+    return None
+
+
+def parse_answer(text) -> object | None:
+    """Extract the JSON certificate from tags, fences, or surrounding prose."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    candidates = [match.group(1)] if match else []
+    candidates.extend(fence.group(1) for fence in _FENCE_RE.finditer(text))
+    candidates.append(text)
+    for candidate in candidates:
+        try:
+            value = json.loads(candidate.strip())
+        except (TypeError, ValueError):
+            value = _json_object_from_text(candidate)
+        if isinstance(value, dict):
+            return value
+    return None
+
+
+def verify(inst: dict, answer) -> tuple[bool, str]:
+    """Check a certificate directly; the planted answer is never consulted."""
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if set(answer) != {"step", "coefficients"}:
+        return False, "answer must contain exactly step and coefficients"
+    step = answer["step"]
+    coefficients = answer["coefficients"]
+    if isinstance(step, bool) or not isinstance(step, int):
+        return False, "step must be an integer"
+    if step not in inst["candidate_steps"]:
+        return False, "step is not in the admissible list"
+    if not isinstance(coefficients, list):
+        return False, "coefficients must be a list"
+    expected = inst["degree"] + 1
+    if len(coefficients) != expected:
+        return False, f"wrong coefficient count: expected {expected}"
+    p = inst["prime"]
+    for index, value in enumerate(coefficients):
+        if isinstance(value, bool) or not isinstance(value, int):
+            return False, f"coefficient {index} is not an integer"
+        if not 0 <= value < p:
+            return False, f"coefficient {index} is outside 0..p-1"
+    if coefficients[0] != inst["known_constant"]:
+        return False, "b_0 must equal the known value f(0)=0"
+    if coefficients[-1] == 0:
+        return False, "b_d must be nonzero because the degree is exactly d"
+    for t, observed in inst["observations"]:
+        candidate = _eval_binomial(coefficients, step, t, p)
+        distance = _circular_distance(candidate, observed, p)
+        if distance > inst["delta"]:
+            return False, (
+                f"sample t={t} has circular error {distance}, exceeding Delta "
+                f"{inst['delta']} (candidate {candidate}, observed {observed})"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from every explicit shape and degree constraint."""
+    p = inst["prime"]
+    degree = inst["degree"]
+    coefficients = [0]
+    coefficients.extend(rng.randrange(p) for _ in range(degree - 1))
+    coefficients.append(rng.randrange(1, p))
+    return _answer(rng.choice(inst["candidate_steps"]), coefficients)
+
+
+def search_space(inst: dict) -> int | None:
+    p = inst["prime"]
+    degree = inst["degree"]
+    return len(inst["candidate_steps"]) * (p ** (degree - 1)) * (p - 1)
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Enumerate only truly small declared languages; never hang a caller."""
+    space = search_space(inst)
+    if space is None or space > _ENUMERATION_CAP:
+        return None
+    hits = 0
+    p = inst["prime"]
+    degree = inst["degree"]
+    for step in inst["candidate_steps"]:
+        for middle in itertools.product(range(p), repeat=max(0, degree - 1)):
+            for leading in range(1, p):
+                candidate = _answer(step, [0, *middle, leading])
+                hits += int(verify(inst, candidate)[0])
+    return hits
+
+
+def _canonical_payload(inst: dict, reflect: bool) -> str:
+    sign = -1 if reflect else 1
+    payload = {
+        "family": inst["family"],
+        "prime": inst["prime"],
+        "interval_radius": inst["interval_radius"],
+        "degree": inst["degree"],
+        "delta": inst["delta"],
+        "marker": inst["marker"],
+        "known_constant": inst["known_constant"],
+        "candidate_steps": sorted(sign * value for value in inst["candidate_steps"]),
+        "observations": sorted([sign * t, s] for t, s in inst["observations"]),
+    }
+    return json.dumps(payload, sort_keys=True, separators=(",", ":"))
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonicalize input order and the field-variable reflection X -> -X."""
+    normal = _canonical_payload(inst, False)
+    reflected = _canonical_payload(inst, True)
+    return hashlib.sha256(min(normal, reflected).encode()).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow clue crowding and arithmetic entropy without lengthening the answer."""
+    result = dict(params)
+    result.pop("_preset", None)
+    n = result.get("n", 20)
+    if n < 38:
+        result["n"] = min(38, n + 4)
+        return result
+    if result.get("prime", _P61) == _P61:
+        result["prime"] = _P127
+        return result
+    if result.get("delta", 3) < 7:
+        result["delta"] = result.get("delta", 3) + 1
+        return result
+    return None
+
+
+def _reference_decode(inst: dict) -> tuple[dict | None, int, int]:
+    """Generic exact bounded-noise interpolation on one arbitrary chain.
+
+    This deliberately does not inspect the marker correlation.  It enumerates
+    every signed error allowed at d nonzero samples, constructs the unique
+    Newton polynomial on that chain, and checks all remaining observations.
+    """
+    p = inst["prime"]
+    degree = inst["degree"]
+    delta = inst["delta"]
+    step = inst["candidate_steps"][0]
+    obs = _observation_map(inst)
+    values = [obs[j * step] for j in range(degree + 1)]
+    at_zero = values[0]
+    zero_error = at_zero if at_zero <= delta else at_zero - p
+    if abs(zero_error) > delta:
+        return None, 0, 0
+
+    chain_points = {j * step for j in range(degree + 1)}
+    checks = [row for row in inst["observations"] if row[0] not in chain_points]
+    checks.extend(row for row in inst["observations"] if row[0] in chain_points)
+    operations = 0
+    candidates = 0
+    errors = range(-delta, delta + 1)
+    for tail_errors in itertools.product(errors, repeat=degree):
+        candidates += 1
+        corrected = [0]
+        corrected.extend((values[j] - tail_errors[j - 1]) % p
+                         for j in range(1, degree + 1))
+        counter = [0]
+        coefficients = _forward_coefficients(corrected, p, counter)
+        operations += counter[0] + degree
+        if coefficients[-1] == 0:
+            continue
+        good = True
+        for t, observed in checks:
+            counter = [0]
+            value = _eval_binomial(coefficients, step, t, p, counter)
+            operations += counter[0] + 1
+            if _circular_distance(value, observed, p) > delta:
+                good = False
+                break
+        if good:
+            candidate = _answer(step, coefficients)
+            if verify(inst, candidate)[0]:
+                return candidate, operations, candidates
+    return None, operations, candidates
+
+
+def _attack_outlier_magnitude(inst: dict) -> dict:
+    obs = _observation_map(inst)
+    p = inst["prime"]
+    step = min(
+        inst["candidate_steps"],
+        key=lambda r: sum(min(obs[j * r], p - obs[j * r])
+                          for j in range(1, inst["degree"] + 1)),
+    )
+    return _raw_chain_answer(inst, step)
+
+
+def _attack_smallest_step(inst: dict) -> dict:
+    step = min(inst["candidate_steps"], key=lambda value: (abs(value), value))
+    return _raw_chain_answer(inst, step)
+
+
+def _attack_sparse_monomial(inst: dict) -> dict:
+    step = inst["candidate_steps"][0]
+    raw = _raw_chain_answer(inst, step)["coefficients"]
+    coefficients = [0] * (inst["degree"] + 1)
+    coefficients[-1] = raw[-1] or 1
+    return _answer(step, coefficients)
+
+
+def _answer_atoms(value) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def _corruption_report(inst: dict) -> tuple[bool, dict]:
+    base = copy.deepcopy(inst["answer"])
+    dropped = copy.deepcopy(base)
+    dropped["coefficients"] = dropped["coefficients"][:-1]
+
+    swapped = copy.deepcopy(base)
+    swap_index = next(
+        (i for i in range(1, inst["degree"])
+         if swapped["coefficients"][i] != swapped["coefficients"][i + 1]),
+        1,
+    )
+    swapped["coefficients"][swap_index], swapped["coefficients"][swap_index + 1] = (
+        swapped["coefficients"][swap_index + 1],
+        swapped["coefficients"][swap_index],
+    )
+
+    duplicated = copy.deepcopy(base)
+    duplicated["coefficients"][2] = duplicated["coefficients"][1]
+    if duplicated == base:
+        duplicated["coefficients"][2] = (duplicated["coefficients"][1] + 1) % inst["prime"]
+
+    out_of_range = copy.deepcopy(base)
+    out_of_range["step"] = inst["interval_radius"] + 1
+    variants = {
+        "drop_one": dropped,
+        "swap_two": swapped,
+        "duplicate_one": duplicated,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    results = {}
+    for name, candidate in variants.items():
+        ok, reason = verify(inst, candidate)
+        results[name] = {"rejected": not ok, "reason": reason}
+    reasons = [item["reason"] for item in results.values()]
+    passed = all(item["rejected"] for item in results.values()) and len(set(reasons)) == len(reasons)
+    return passed, results
+
+
+def selftest() -> dict:
+    """Run all mandatory gates and return a JSON-native measurement report."""
+    report: dict = {
+        "paper": "1401.1331",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    planted_attempts = 0
+    json_roundtrips = 0
+    planted_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            planted_attempts += 1
+            ok, reason = verify(inst, inst["answer"])
+            if not ok:
+                planted_failures.append([preset, seed, reason])
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_roundtrips += 1
+    report["G1_planted_verifies"] = {
+        "pass": not planted_failures and json_roundtrips == planted_attempts,
+        "verified": planted_attempts - len(planted_failures),
+        "attempts": planted_attempts,
+        "json_native_roundtrips": json_roundtrips,
+        "failures": planted_failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=42_424, **shipping_params)
+    corruption_pass, corruption_results = _corruption_report(shipping)
+    report["G2_rejects_corruption"] = {
+        "pass": corruption_pass,
+        "cases": corruption_results,
+    }
+
+    encoded = json.dumps(shipping["answer"], separators=(",", ":"))
+    model_response = (
+        "I used the finite-difference basis.\n```json\n<answer>"
+        + encoded
+        + "</answer>\n```\nThe tagged object is my final result."
+    )
+    parsed = parse_answer(model_response)
+    report["G3_round_trip"] = {
+        "pass": parsed == shipping["answer"] and verify(shipping, parsed)[0],
+        "parsed_equals_answer": parsed == shipping["answer"],
+    }
+
+    guess_total = 200_000
+    guess_hits = 0
+    guess_rng = random.Random(9_917_331)
+    guess_start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
+    guess_wall = time.perf_counter() - guess_start
+    guess_density = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_total >= 200_000 and guess_density < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_fraction": guess_density,
+        "structure_aware_space": search_space(shipping),
+        "wall_clock_sec": round(guess_wall, 6),
+    }
+
+    attack_seeds = (101, 211, 307, 401, 503, 601, 701, 809)
+    attack_names = (
+        "outlier_smallest_value_magnitude",
+        "greedy_smallest_step_constant_noise",
+        "random_restart_256",
+        "obvious_sparse_top_monomial_ansatz",
+    )
+    attack_successes = {name: 0 for name in attack_names}
+    reference_successes = 0
+    reference_operations = 0
+    reference_candidates = 0
+    reference_times = []
+    for seed in attack_seeds:
+        inst = make_instance(seed=seed, **shipping_params)
+        candidates = {
+            "outlier_smallest_value_magnitude": _attack_outlier_magnitude(inst),
+            "greedy_smallest_step_constant_noise": _attack_smallest_step(inst),
+            "obvious_sparse_top_monomial_ansatz": _attack_sparse_monomial(inst),
+        }
+        for name, candidate in candidates.items():
+            attack_successes[name] += int(verify(inst, candidate)[0])
+        rrng = random.Random(seed ^ 0xA5A5A5A5)
+        restart_hit = any(verify(inst, random_candidate(inst, rrng))[0]
+                          for _ in range(256))
+        attack_successes["random_restart_256"] += int(restart_hit)
+
+        start = time.perf_counter()
+        decoded, operations, tried = _reference_decode(inst)
+        reference_times.append(time.perf_counter() - start)
+        reference_operations += operations
+        reference_candidates += tried
+        reference_successes += int(decoded is not None and verify(inst, decoded)[0])
+
+    attacks = {
+        name: {"successes": attack_successes[name], "attempts": len(attack_seeds)}
+        for name in attack_names
+    }
+    all_attacks_failed = all(item["successes"] == 0 for item in attacks.values())
+    reference = {
+        "name": "exact signed-error enumeration plus Newton interpolation",
+        "paper_method": "Sections 3-4 fixed-dimensional closest-vector decoding",
+        "complexity": "O((2*Delta+1)^d*(d^2+N*d)) exact field operations",
+        "wall_clock_sec": round(sum(reference_times), 6),
+        "mean_wall_clock_sec": round(sum(reference_times) / len(reference_times), 6),
+        "operations": reference_operations,
+        "mean_operations": round(reference_operations / len(reference_times), 3),
+        "candidates_tested": reference_candidates,
+        "solves": f"{reference_successes}/{len(attack_seeds)}, as expected",
+    }
+    report["G5_density_and_baseline"] = {
+        "pass": reference_successes == len(attack_seeds) and guess_density < 1e-6,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_valid_fraction": guess_density,
+        "baseline_wall_clock_sec": reference["wall_clock_sec"],
+        "baseline_operations": reference_operations,
+        "baseline_candidates": reference_candidates,
+        "exact_enumeration_count": enumerate_all(shipping),
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == len(attack_seeds),
+        "attacks": attacks,
+        "reference_algorithm": reference,
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=88_001, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": doubled_ok and len(doubled["observations"]) > len(shipping["observations"])
+        and search_space(doubled) > search_space(shipping),
+        "shipping_n": shipping_params["n"],
+        "doubled_n": doubled_params["n"],
+        "shipping_observations": len(shipping["observations"]),
+        "doubled_observations": len(doubled["observations"]),
+        "doubled_planted_verifies": doubled_ok,
+    }
+
+    invariant_checks = 0
+    invariant_passes = 0
+    carried_witness_checks = 0
+    distinct_keys = []
+    for seed in range(20_001, 20_021):
+        inst = make_instance(seed=seed, **shipping_params)
+        key = canonical_key(inst)
+        distinct_keys.append(key)
+
+        reordered = copy.deepcopy(inst)
+        reordered["observations"].reverse()
+        reordered["candidate_steps"].reverse()
+        invariant_checks += 1
+        invariant_passes += int(canonical_key(reordered) == key)
+        carried_witness_checks += int(verify(reordered, inst["answer"])[0])
+
+        reflected = copy.deepcopy(inst)
+        reflected["observations"] = [[-t, s] for t, s in inst["observations"]]
+        reflected["candidate_steps"] = [-step for step in inst["candidate_steps"]]
+        reflected_answer = _answer(-inst["answer"]["step"],
+                                   inst["answer"]["coefficients"])
+        invariant_checks += 1
+        invariant_passes += int(canonical_key(reflected) == key)
+        carried_witness_checks += int(verify(reflected, reflected_answer)[0])
+
+        composed = copy.deepcopy(reflected)
+        composed["observations"].reverse()
+        composed["candidate_steps"].reverse()
+        invariant_checks += 1
+        invariant_passes += int(canonical_key(composed) == key)
+        carried_witness_checks += int(verify(composed, reflected_answer)[0])
+    distinct_count = len(set(distinct_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant_passes == invariant_checks
+        and carried_witness_checks == invariant_checks
+        and distinct_count == len(distinct_keys),
+        "invariance_passes": invariant_passes,
+        "invariance_attempts": invariant_checks,
+        "carried_witness_passes": carried_witness_checks,
+        "carried_witness_attempts": invariant_checks,
+        "distinct_keys": distinct_count,
+        "unrelated_instances": len(distinct_keys),
+        "symmetries": ["input reordering", "X -> -X", "their composition"],
+    }
