+    answer_blob = json.dumps(shipping["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(shipping["answer"])
+    intended_ops = (
+        shipping_params["n"] * (shipping["degree"] + 1)
+        + shipping["degree"] * (shipping["degree"] + 1) // 2
+    )
+    route_counter = [0]
+    useful_step = _marker_step(shipping, route_counter)
+    shortcut = _raw_chain_answer(shipping, useful_step, route_counter) if useful_step else None
+    shortcut_ok = shortcut is not None and verify(shipping, shortcut)[0]
+    arms = copy.deepcopy(G9_RESULTS["arms"])
+    hinted_verdict = G9_RESULTS["hinted_verdict"]
+    hinted_attempts = arms.get("hinted", {}).get("attempts", 0)
+    within_caps = answer_chars <= 2_000 and answer_elements <= 256 and intended_ops <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_verdict == "hardened" and hinted_attempts >= 3
+        and within_caps and shortcut_ok,
+        "arms": arms,
+        "hinted_minus_placebo": (
+            arms.get("hinted", {}).get("solved", 0) / max(1, arms.get("hinted", {}).get("attempts", 0))
+            - arms.get("placebo", {}).get("solved", 0) / max(1, arms.get("placebo", {}).get("attempts", 0))
+        ),
+        "hinted_verdict": hinted_verdict,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "instrumented_shortcut_operations": route_counter[0],
+        "shortcut_verifies": shortcut_ok,
+    }
+
+    gates = [value for key, value in report.items()
+             if key.startswith("G") and isinstance(value, dict)]
+    report["all_passed"] = all(gate.get("pass") is True for gate in gates)
+    return report
