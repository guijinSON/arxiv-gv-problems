+def _attack_single_monomial(inst: dict) -> object:
+    p = inst["p"]
+    last = [0, 0]
+    for t, observed in _flatten_samples(inst)[:12]:
+        t4, t3 = _basis_row(t, p)
+        if t4:
+            last = [observed * pow(t4, -1, p) % p, 0]
+            if verify(inst, last)[0]:
+                return last
+        if t3:
+            last = [0, observed * pow(t3, -1, p) % p]
+            if verify(inst, last)[0]:
+                return last
+    return last
