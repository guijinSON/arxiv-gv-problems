+        rhs1 = (first[1] - error1) % p
+        left_a = rhs1 * row2[1]
+        left_b = row2[0] * rhs1
+        for error2 in range(-delta, delta + 1):
+            candidates += 1
+            rhs2 = (second[1] - error2) % p
+            a4 = (left_a - rhs2 * row1[1]) * det_inv % p
+            a3 = (row1[0] * rhs2 - left_b) * det_inv % p
