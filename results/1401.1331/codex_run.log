+def _draw_packet_points(rng: random.Random, h: int, p: int,
+                        occupied: set[int]) -> list[list[list[int]]]:
+    max_q = max(2, h // 20)
+    for _ in range(10_000):
+        q = rng.randint(1, max_q)
+        starts = []
+        used = set(occupied)
+        for _slot in range(3):
+            choices = []
+            for _ in range(200):
