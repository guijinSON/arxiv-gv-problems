+        "ok": answer is not None and verify(inst, answer)[0],
+        "candidate_error_pairs": candidates,
+        "sample_checks": sample_checks,
+        "operations": operations,
+        "wall_clock_sec": time.perf_counter() - start,
+    }
 
 
