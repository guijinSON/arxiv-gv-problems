s=importlib.util.spec_from_file_location('g',path);g=importlib.util.module_from_spec(s);s.loader.exec_module(g)
assert g.TRACK in {'A','B'}
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.SHIPPING_DIFFICULTY"'!='"'demo'
for name in ('make_instance','render','parse_answer','verify','random_candidate','search_space','enumerate_all','canonical_key','escalate','selftest'):
 assert callable(getattr(g,name))
i=g.make_instance(seed=123,**g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
blob=json.dumps(i['answer'],separators=(',',':'))
assert json.loads(blob)==i['answer']
assert g.parse_answer('prose <answer>'+blob+'</answer> prose')==i['answer']
assert g.verify(i,g.parse_answer('<answer>'+blob+'</answer>'))==(True,'ok')
os.environ.pop('GV_HINT_MODE',None); bare=g.render(i)
os.environ['GV_HINT_MODE']='structural'; hinted=g.render(i)
os.environ['GV_HINT_MODE']='placebo'; placebo=g.render(i)
assert g.STRUCTURAL_HINT not in bare and g.PLACEBO_HINT not in bare
assert hinted.endswith(g.STRUCTURAL_HINT) and placebo.endswith(g.PLACEBO_HINT)
source=open(path).read(); tree=ast.parse(source)
verify_node=next(n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) and n.name=='verify')
verify_src=ast.get_source_segment(source,verify_node)
assert 'inst[\"answer\"]' not in verify_src and \"inst['answer']\" not in verify_src
report=json.load(open('selftest_report.json'))
assert all(v.get('pass') for k,v in report.items() if k.startswith('G') and k"'!='"'G9_no_tool_suitability')
assert report['G9_no_tool_suitability']['pass'] is False
need={'schema_version','model','effort','preset','params','seed','escalation_round','solved','parsed','verify_ok','verify_reason','reply','error','elapsed_sec','http_status','finish_reason'}
for fn in ('llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl'):
 rows=[json.loads(x) for x in open(fn) if x.strip()]
 assert len(rows)==4 and all(need<=set(row) for row in rows)
 assert all(row['solved']=='error' and row['http_status']==403 for row in rows)
print('interface/json/render/verifier/transcript audit: ok')
print('shipping answer:',len(blob),'chars;',g._answer_atoms(i['answer']),'atoms')
print('local gate status: 8 pass, G9 blocked')
