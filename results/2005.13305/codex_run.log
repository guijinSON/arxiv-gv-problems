   152	# --- metadata ---------------------------------------------------------------
   153	def read_meta():
   154	    try:
   155	        with open(META) as f:
   156	            return json.load(f)
   157	    except (OSError, ValueError):
   158	        return {}
   159	
   160	
   161	def update_meta(**fields):
   162	    meta = read_meta()
   163	    meta.update(fields)
   164	    with open(META, "w") as f:
   165	        json.dump(meta, f, indent=1)
