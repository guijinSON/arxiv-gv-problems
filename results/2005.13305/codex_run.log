+def _compact_recover(inst: dict) -> dict:
+    maps = []
+    for layer in inst["layers"]:
+        dimension = 2 * layer["side_bits"]
+        images = []
+        for x in _basis(dimension):
+            value = 0
+            for q in layer["adjacency"][x]:
+                value ^= q
+            images.append(value)
+        maps.append(images)
