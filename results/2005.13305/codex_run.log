+def _parse_maps(inst: dict, answer: object):
+    if not isinstance(answer, dict) or set(answer) != {"maps"}:
+        return None, "answer must be an object with exactly the key 'maps'"
+    maps = answer["maps"]
+    if not isinstance(maps, list) or len(maps) != len(inst["layers"]):
+        return None, f"expected {len(inst['layers'])} map certificates"
+    params = []
+    for i, (layer, images) in enumerate(zip(inst["layers"], maps)):
+        dimension = 2 * layer["side_bits"]
+        parsed, why = _params_from_images(images, dimension)
+        if parsed is None:
+            return None, f"layer {i} {why}"
+        if dimension == 4 and parsed[0] != 0:
+            return None, f"layer {i} must be a translation"
+        if dimension == 6 and parsed[0] == 0:
+            return None, f"layer {i} must have rank-one linear displacement"
+        params.append(parsed)
+    return params, "ok"
