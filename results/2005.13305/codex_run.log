+def _cycle_type(permutation: list[int]) -> tuple[int, ...]:
+    seen = [False] * len(permutation)
+    out = []
+    for start in range(len(permutation)):
+        if seen[start]:
+            continue
+        x = start
+        length = 0
+        while not seen[x]:
+            seen[x] = True
+            length += 1
+            x = permutation[x]
+        out.append(length)
+    return tuple(sorted(out))
