   621	def escalate(params: dict) -> dict | str | None:
   622	    n = params.get("n")
   623	    side_bits = params.get("side_bits", 3)
   624	    if side_bits == 3 and isinstance(n, int) and n < 3:
   625	        return {"n": n + 1, "side_bits": 3}
   626	    return None
   627	
   628	
   629	def _first_neighbor_attack(inst: dict) -> object:
   630	    return {"maps": [[layer["adjacency"][x][0] for x in _basis(2 * layer["side_bits"])] for layer in inst["layers"]]}
   631	
   632	
   633	def _lexicographic_attack(inst: dict) -> object:
   634	    maps = []
   635	    for layer in inst["layers"]:
   636	        dimension = 2 * layer["side_bits"]
   637	        params = (0, 0, 1) if dimension == 4 else (1, 2, 4)
   638	        maps.append(_params_images(params, dimension))
   639	    return {"maps": maps}
   640	
   641	
   642	def _anchor_lex_linear_attack(inst: dict) -> object:
   643	    maps = []
   644	    for layer in inst["layers"]:
   645	        dimension = 2 * layer["side_bits"]
   646	        b = 0
   647	        for q in layer["adjacency"][0]:
   648	            b ^= q
   649	        if dimension == 4:
   650	            maps.append(_params_images((0, 0, b), dimension))
   651	            continue
   652	        chosen = None
   653	        for u in range(1, 1 << dimension):
   654	            for v in range(1, 1 << dimension):
   655	                if not _parity(u & v) and not _parity(v & b) and b not in (0, u):
   656	                    chosen = (u, v, b)
   657	                    break
   658	            if chosen:
   659	                break
   660	        assert chosen is not None
   661	        maps.append(_params_images(chosen, dimension))
   662	    return {"maps": maps}
   663	
   664	
   665	def _reuse_first_attack(inst: dict) -> object:
   666	    exact = _compact_recover(inst)
   667	    return {"maps": [list(exact["maps"][0]) for _ in inst["layers"]]}
   668	
   669	
   670	def _common_affine_relabel(inst: dict, seed: int):
   671	    rng = random.Random(seed)
   672	    dimension = 2 * inst["layers"][0]["side_bits"]
   673	    vertex_count = 1 << dimension
   674	    rows = _random_invertible(dimension, rng)
   675	    offset = rng.randrange(vertex_count)
   676	    relabel, inverse = _affine_table(rows, offset)
   677	    exact = _compact_recover(inst)
   678	    transformed = []
   679	    answers = []
   680	    for layer, images in zip(inst["layers"], exact["maps"]):
   681	        params, why = _params_from_images(images, dimension)
   682	        assert params is not None, why
   683	
   684	        def new_p(x: int) -> int:
   685	            return relabel[_apply_params(params, inverse[x])]
   686	
   687	        adjacency = [[] for _ in range(vertex_count)]
   688	        for old_z, row in enumerate(layer["adjacency"]):
   689	            new_z = relabel[old_z]
   690	            adjacency[new_z] = [relabel[q] for q in row]
   691	            rng.shuffle(adjacency[new_z])
   692	        transformed.append({"side_bits": layer["side_bits"], "adjacency": adjacency})
   693	        answers.append([new_p(x) for x in _basis(dimension)])
   694	    order = list(range(len(transformed)))
   695	    rng.shuffle(order)
   696	    out = {
   697	        "family": inst["family"],
   698	        "layers": [transformed[i] for i in order],
   699	        "answer": {"maps": [answers[i] for i in order]},
   700	    }
   701	    return out, out["answer"]
   702	
   703	
   704	def _corruptions(inst: dict) -> dict[str, object]:
   705	    answer = copy.deepcopy(inst["answer"])
   706	    drop = copy.deepcopy(answer)
   707	    drop["maps"][0].pop()
   708	    swap = copy.deepcopy(answer)
   709	    swap["maps"][0], swap["maps"][1] = swap["maps"][1], swap["maps"][0]
   710	    duplicate = copy.deepcopy(answer)
   711	    duplicate["maps"][0][1] = duplicate["maps"][0][0]
   712	    out_of_range = copy.deepcopy(answer)
   713	    dimension = 2 * inst["layers"][0]["side_bits"]
   714	    out_of_range["maps"][0][0] = 1 << dimension
   715	    return {"drop": drop, "swap": swap, "duplicate": duplicate, "empty": {}, "out_of_range": out_of_range}
   716	
   717	
   718	def _answer_atoms(value: object) -> int:
   719	    if isinstance(value, dict):
   720	        return sum(_answer_atoms(x) for x in value.values())
   721	    if isinstance(value, list):
   722	        return sum(_answer_atoms(x) for x in value)
   723	    return 1
   724	
   725	
   726	def selftest() -> dict:
   727	    report = {}
   728	    checks = json_checks = 0
   729	    for preset, params in DIFFICULTY.items():
   730	        for seed in range(5):
   731	            inst = make_instance(seed=seed, **params)
   732	            ok, why = verify(inst, inst["answer"])
   733	            assert ok, (preset, seed, why)
   734	            checks += 1
   735	            assert json.loads(json.dumps(inst["answer"])) == inst["answer"]
   736	            json_checks += 1
   737	    report["G1_planted_verifies"] = {"pass": True, "checks": checks, "json_native_checks": json_checks}
   738	
   739	    ship = make_instance(seed=37, **DIFFICULTY[SHIPPING_DIFFICULTY])
   740	    reasons = {}
   741	    for name, candidate in _corruptions(ship).items():
   742	        ok, why = verify(ship, candidate)
   743	        assert not ok, (name, why)
   744	        reasons[name] = why
   745	    assert len(set(reasons.values())) == len(reasons), reasons
   746	    report["G2_rejects_corruption"] = {"pass": True, "reasons": reasons}
   747	
   748	    realistic = "Reasoning omitted.\n```json\n<answer>\n" + json.dumps(ship["answer"]) + "\n</answer>\n```\n"
   749	    assert parse_answer(realistic) == ship["answer"]
   750	    assert parse_answer("garbage") is None
   751	    report["G3_round_trip"] = {"pass": True, "prose_and_fence": True}
   752	
   753	    samples = 200_000
   754	    hits = 0
   755	    guess_rng = random.Random(910247)
   756	    for _ in range(samples):
   757	        hits += int(verify(ship, random_candidate(ship, guess_rng))[0])
   758	    density = hits / samples
   759	    assert density < 1e-6
   760	    report["G4_guess_resistance"] = {
     1	#!/usr/bin/env python3
     2	"""The LLM hardening loop.  Usage: python3 scripts/harden.py <path to gen_*.py>
     3	
     4	This file, not the builder, owns the loop.  The builder writes gen_<id>.py and
     5	runs this; everything about which model is asked, with which seed, and when a
     6	family is declared too easy is decided here.  That is deliberate: a builder that
     7	reports its own hardening result has an obvious incentive not to report a
     8	failure, and a transcript whose schema is chosen per run cannot be validated.
     9	
    10	Requires OPENROUTER_API_KEY.  The oracle pool spans four vendors, so a single
    11	OpenAI key is not enough.  Standard library only.
    12	"""
    13	
    14	import importlib.util
    15	import json
    16	import os
    17	import random
    18	import sys
    19	import threading
    20	import time
    21	import ssl
    22	import urllib.error
    23	import urllib.request
    24	
    25	# --- configuration ----------------------------------------------------------
    26	# The oracle pool.  Four vendors at the same price tier as the model this
    27	# replaced (openai/gpt-5.6-terra, $2/$12 per M tokens).  A model is drawn afresh
    28	# for every single call: a family that only defeats one model's blind spots is
    29	# not hard, it is overfitted to.
    30	#
    31	# openai/gpt-5.6-sol is deliberately absent — it is the builder model, and a
    32	# family checked against its own author proves nothing.
    33	# Two-model pool as of 2026-09-05. The property that matters is that no single
    34	# vendor's blind spot can carry a family through, and two vendors still give that.
    35	# ATTEMPTS_PER_PRESET stays 3, so a level is tried three times; with two models one
    36	# is drawn twice, on a DIFFERENT instance seed each time.
    37	DEFAULT_POOL = [
    38	    "openai/gpt-5.6-terra",
    39	    "google/gemini-3.8-flash",
    40	]
    41	ORACLE_POOL = [m.strip() for m in os.environ.get(
    42	    "ORACLE_POOL", ",".join(DEFAULT_POOL)).split(",") if m.strip()]
    43	
    44	ORACLE_EFFORT = os.environ.get("ORACLE_EFFORT", "medium")
    45	ATTEMPTS_PER_PRESET = 3      # distinct models per difficulty level
    46	# Raises of difficulty before the family is given up on.  This was 3, and 7 of the
    47	# 13 too_easy verdicts on disk came from EXHAUSTING IT rather than from the family
    48	# running out of hardness: 1612.03280 stopped at n=149 with escalate() still willing
    49	# to climb to 237 before it would have said cap_bound.  A budget is not a property of
    50	# the paper, so hitting it is now reported as `budget_bound`, not `too_easy` -- see
    51	# the end of main().  The budget still exists because each level costs a full pool
    52	# sweep; it is env-overridable so a park can be re-run with a bigger one.
    53	MAX_ESCALATIONS = int(os.environ.get("ORACLE_MAX_ESCALATIONS", "6"))
    54	MAX_ERROR_RETRIES = 3        # per attempt; API errors do not count as attempts
    55	MAX_TOKENS = int(os.environ.get("ORACLE_MAX_TOKENS", "32000"))
    56	# Reasoning tokens are billed against max_tokens on some vendors, so a budget
    57	# sized for the answer alone comes back HTTP 200 with an empty body — observed
    58	# live at 16000 against claude-sonnet-5 on a 2030-character statement.
    59	REQUEST_TIMEOUT = 900
    60	# urlopen(timeout=) is a per-socket-operation timeout, NOT a total deadline: a
    61	# provider that trickles bytes (or holds a streaming connection open) resets it on
    62	# every read, so a single call can hang indefinitely.  Observed live -- one call
    63	# sat open 44 minutes against a 900s "timeout" and blocked the paper for 74.  The
    64	# request therefore runs on a worker thread under a hard wall-clock deadline.
    65	TOTAL_DEADLINE = int(os.environ.get("ORACLE_TOTAL_DEADLINE", str(REQUEST_TIMEOUT)))
    66	
    67	# The published answer cap (prompts/codex_task.md): <= 2000 chars and <= 256 atoms.
    68	ANSWER_CHAR_CAP  = 2000
    69	ANSWER_ATOM_CAP  = 256
    70	# How close to the cap counts as "the cap is what stopped you". A ladder that has
    71	# already consumed most of the budget had nowhere left to go along the axis it was
    72	# using, whatever escalate() says about the mathematics.
    73	CAP_NEAR_FRACTION = 0.6
    74	
    75	
    76	def _answer_size(mod, params):
    77	    """(atoms, chars) of the serialised planted answer at these parameters.
    78	
    79	    Returns (None, None) if it cannot be measured -- never raises, because this is
    80	    diagnostic and must not be able to fail a run.
    81	    """
    82	    try:
    83	        inst = mod.make_instance(seed=98765, **{k: v for k, v in params.items()
    84	                                                if k != "_preset"})
    85	        ans = inst["answer"]
    86	        blob = json.dumps(ans, default=str)
    87	
    88	        def atoms(a):
    89	            if isinstance(a, dict):  return sum(atoms(v) for v in a.values())
    90	            if isinstance(a, (list, tuple)): return sum(atoms(v) for v in a)
    91	            return 1
    92	        return atoms(ans), len(blob)
    93	    except Exception:                                   # noqa: BLE001
    94	        return None, None
