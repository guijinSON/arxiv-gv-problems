    91	           "question": m.render(inst), "answer": inst["answer"]}
    92	    sp = m.search_space(inst)
    93	    if sp is not None: rec["search_space"] = sp
    94	    # Existing fields keep their order; the profile is appended after them.
    95	    for f in PROFILE_FIELDS:
    96	        rec[f] = profile[f]
    97	    out.append(rec)
    98	
    99	path = f"artifacts/{pid}.jsonl"
   100	with open(path, "w") as f:
   101	    for r in out: f.write(json.dumps(r) + "\n")
   102	print(f"wrote {path}: {len(out)} instances (difficulty={name})"
   103	      + (f"  [{bad} SKIPPED - planted failed!]" if bad else "")
   104	      + (f"  [{dupes} duplicates resampled]" if dupes else ""))
   105	print(f"  profile: domain={profile['native_domain']} core={profile['computational_core']} "
   106	      f"cert={profile['certificate_form']} regime={profile['object_regime']} "
   107	      f"[{profile['core_provenance']}]")
