    29	# re-deriving the labels -- which is how the corpus stayed 68% discrete without
    30	# anyone noticing.  The classifier is scripts/corpus_report.py, imported rather than
    31	# duplicated: two copies of this logic would drift, and then the report and the
    32	# dataset would disagree about what was shipped.
    33	sys.path.insert(0, scripts_dir)
