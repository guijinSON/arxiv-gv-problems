    58	# Seeds are drawn, not counted off from a constant.  A fixed ladder like
    59	# 10_000+i means every run of a paper emits the same instances forever, so an
    60	# easy instance that slips in stays in; drawing them means the dataset is a
    61	# fresh sample each time.  Reproducibility comes from recording, not from
    62	# fixing: the master seed lands in .meta.json and each instance carries its own
    63	# seed in `params`.
    64	META = f"results/{pid}/.meta.json"
    65	try:
    66	    meta = json.load(open(META))
    67	except (OSError, ValueError):
    68	    meta = {}
    69	# Fresh every run.  Set EMIT_MASTER_SEED to deliberately reproduce an earlier
    70	# dataset from the value recorded in .meta.json; never default to the stored one,
    71	# or "random seeds" quietly becomes "the first run's seeds, forever".
    72	master = int(os.environ.get("EMIT_MASTER_SEED") or int.from_bytes(os.urandom(8), "big"))
