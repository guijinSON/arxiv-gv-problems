   207	        finish = choice.get("finish_reason") or choice.get("native_finish_reason")
   208	    except (KeyError, IndexError, TypeError):
   209	        return None, status, None, f"unparseable response: {json.dumps(payload)[:400]}", False
   210	    if not (text or "").strip():
   211	        usage = payload.get("usage") or {}
   212	        return None, status, finish, (
   213	            f"empty reply (finish_reason={finish}, usage={json.dumps(usage)[:160]}) — "
   214	            f"the model returned no content, most likely because reasoning consumed "
   215	            f"max_tokens={MAX_TOKENS}; raise ORACLE_MAX_TOKENS"), True
   216	    return text, status, finish, None, False
   217	
   218	
   219	def ask(model, prompt, key):
   220	    """_ask_blocking under a hard wall-clock deadline.
   221	
   222	    A deadline overrun is reported as an ERROR, not a failure to solve: the model
   223	    never got to answer, so scoring it as unsolved would manufacture hardness out
   224	    of a hung socket.  attempt() redraws against a different vendor.
   225	    """
   226	    box = {}
   227	
   228	    def run():
   229	        try:
   230	            box["v"] = _ask_blocking(model, prompt, key)
   231	        except Exception as e:                                # noqa: BLE001
   232	            box["v"] = (None, None, None, f"{type(e).__name__}: {e}", False)
   233	
   234	    # daemon=True matters: a wedged socket must not keep the interpreter alive at
   235	    # exit, which is exactly what a ThreadPoolExecutor worker would do.
   236	    t = threading.Thread(target=run, daemon=True, name=f"oracle-{model}")
   237	    t.start()
   238	    t.join(TOTAL_DEADLINE)
   239	    if t.is_alive():
   240	        return (None, None, None,
   241	                f"total deadline exceeded: no complete response in {TOTAL_DEADLINE}s",
   242	                False)
   243	    return box.get("v", (None, None, None, "worker produced no result", False))
   244	
   245	
   246	def attempt(mod, model, params, seed, key):
   247	    """One oracle call.  Returns the transcript record for it."""
   248	    inst = mod.make_instance(seed=seed, **params)
   249	    t0 = time.time()
   250	    reply, status, finish, error, empty = ask(model, mod.render(inst), key)
   251	    elapsed = round(time.time() - t0, 2)
   252	
   253	    rec = {
   254	        "schema_version": SCHEMA_VERSION,
   255	        "model": model,
   256	        "effort": ORACLE_EFFORT,
   257	        "params": dict(params),
   258	        "seed": seed,
   259	        "solved": "error",
   260	        "parsed": False,
   261	        "verify_ok": None,
   262	        "verify_reason": None,
   263	        "reply": reply,
   264	        "error": error,
   265	        "elapsed_sec": elapsed,
   266	        "http_status": status,
   267	        "finish_reason": finish,
   268	    }
   269	    if empty:
   270	        # Scored as an unsolved attempt, not an API error: the model returned no
   271	        # witness within its budget.  error stays None so the invariant
   272	        # "error is not None => solved == 'error'" holds.
   273	        rec["solved"] = "failed"
   274	        rec["verify_reason"] = f"empty length-limited response ({error})"
   275	        rec["error"] = None
   276	        return rec
   277	    if error is not None:
   278	        return rec
   279	
   280	    ans = mod.parse_answer(reply)
   281	    rec["parsed"] = ans is not None
   282	    if ans is None:
   283	        # Not an error, and not evidence of hardness either: a reply that
   284	        # visibly contains an answer but does not parse is a renderer bug.
   285	        rec["solved"] = "failed"
   286	        rec["verify_reason"] = "parse_answer returned None"
   287	        return rec
   288	
   289	    ok, why = mod.verify(inst, ans)
   290	    rec["verify_ok"] = bool(ok)
   291	    rec["verify_reason"] = why
   292	    rec["solved"] = "solved" if ok else "failed"
   293	    return rec
   294	
   295	
   296	# --- the loop ---------------------------------------------------------------
   297	def run_level(mod, params, preset, escalation_round, rng, key, out):
   298	    """Ask the pool to solve this difficulty.  Returns True if any model solved it.
   299	
   300	    Draws distinct models where the pool allows, so three failures are three
   301	    vendors failing rather than one vendor failing three times.  A call that
   302	    errors out is redrawn against a different model and does not consume an
   303	    attempt: an API outage must never be recorded as the model failing to solve,
   304	    which is exactly how a hardness claim gets manufactured out of a 500.  An
   305	    empty length-limited reply is NOT an error -- it is scored as a failure and
   306	    consumes its slot (see ask()).
   307	    """
   308	    k = min(ATTEMPTS_PER_PRESET, len(ORACLE_POOL))
   309	    schedule = rng.sample(ORACLE_POOL, k)
   310	    while len(schedule) < ATTEMPTS_PER_PRESET:
   311	        schedule.append(rng.choice(ORACLE_POOL))
   312	
   313	    # A redraw after an error has to keep the level spread across vendors.  One
   314	    # model that reliably errors on a family — a reasoning budget it never
   315	    # escapes at this size, say — would otherwise hand its slot to a vendor that
   316	    # is either already here or queued next, and "three vendors failed" quietly
   317	    # becomes "two vendors failed, one of them twice".  Observed live: at n=80 a
   318	    # sonnet-5 timeout put gpt-5.6-terra in two of three slots.  So a substitute
   319	    # must avoid whoever has spoken AND whoever is still pending.
   320	    spoke = set()
   321	    solved_any = False
   322	    for slot in range(len(schedule)):
   323	        model = schedule[slot]
   324	        pending = set(schedule[slot + 1:])
   325	        tried, rec = 0, None
   326	        while tried <= MAX_ERROR_RETRIES:
   327	            seed = rng.randrange(1, 2**31 - 1)
   328	            if tried == 0:
   329	                use = model
   330	            else:
   331	                fresh = [m for m in ORACLE_POOL if m not in spoke and m not in pending]
   332	                use = rng.choice(fresh or [m for m in ORACLE_POOL if m not in spoke]
   333	                                 or ORACLE_POOL)
   334	            rec = attempt(mod, use, params, seed, key)
   335	            rec["preset"] = preset
   336	            rec["escalation_round"] = escalation_round
   337	            out.write(json.dumps(rec) + "\n")
   338	            out.flush()
   339	            if rec["solved"] != "error":
   340	                spoke.add(use)
   341	                break
   342	            tried += 1
   343	            print(f"  ! {use} errored ({rec['error'][:80]}) — redrawing", file=sys.stderr)
   344	        if rec is None or rec["solved"] == "error":
   345	            sys.exit("ERROR: the oracle pool is unreachable — cannot make a hardness claim.")
   346	        mark = {"solved": "SOLVED", "failed": "failed"}[rec["solved"]]
   347	        print(f"  {rec['model']:38s} seed={rec['seed']:<12d} {mark}", file=sys.stderr)
   348	        if rec["solved"] == "solved":
   349	            solved_any = True
   350	    return solved_any
   351	
   352	
   353	def main():
   354	    if len(sys.argv) != 2:
   355	        sys.exit("usage: python3 scripts/harden.py <path to gen_*.py>")
   356	    key = os.environ.get("OPENROUTER_API_KEY")
   357	    if not key:
   358	        sys.exit("ERROR: OPENROUTER_API_KEY is required — the oracle pool spans four "
   359	                 "vendors, so an OpenAI key alone cannot reach it.")
   360	
   361	    global SSL_CONTEXT
   362	    SSL_CONTEXT = _ssl_context()
   363	
   364	    mod = load_module(sys.argv[1])
   365	
   366	    # One master seed governs every draw below — model choice and instance
   367	    # seeds alike — and is recorded, so a run is reproducible without any seed
   368	    # being fixed in advance.
   369	    master = int(os.environ.get("HARDEN_MASTER_SEED") or
   370	                 int.from_bytes(os.urandom(8), "big"))
   371	    rng = random.Random(master)
   372	    update_meta(schema_version=SCHEMA_VERSION, harden_master_seed=master,
   373	                oracle_pool=ORACLE_POOL, oracle_effort=ORACLE_EFFORT,
   374	                max_escalations=MAX_ESCALATIONS)
   375	
   376	    # `demo` is a hand-scale illustration rung, built to be solvable.  Starting
   377	    # the ladder there would spend one of MAX_ESCALATIONS proving that, so the
   378	    # hardening ladder begins at `easy`.
   379	    ladder = [dict(p, _preset=name) for name, p in mod.DIFFICULTY.items()
   380	              if name != "demo"]
   381	    params = ladder[0]
   382	    rung = 0
   383	    verdict = None
   384	
   385	    with open(TRANSCRIPT, "w") as out:
   386	        axes_moved = set()          # every param key any level transition changed
   387	        prev_call = None
   388	        for escalation_round in range(MAX_ESCALATIONS + 1):
   389	            shown = {k: v for k, v in params.items() if k != "_preset"}
   390	            print(f"[round {escalation_round}] {params.get('_preset')} {shown}", file=sys.stderr)
   391	            call = {k: v for k, v in params.items() if k != "_preset"}
   392	            # Record which dials moved since the previous level. This has to cover
   393	            # the fixed ladder as well as escalate(): 2601.05272 climbed
   394	            # n=64,72,80,84 through its LADDER and only then called escalate(), so
   395	            # counting escalate()'s moves alone would have seen no axis at all.
   396	            if prev_call is not None:
   397	                for _k, _v in call.items():
   398	                    if prev_call.get(_k) != _v:
   399	                        axes_moved.add(_k)
   400	            prev_call = dict(call)
   401	            preset = params.get("_preset", "escalated")
   402	            if not run_level(mod, call, preset, escalation_round, rng, key, out):
   403	                verdict = {"verdict": "hardened", "escalations_used": escalation_round,
   404	                           "shipping_params": call, "preset": preset}
   405	                break
   406	            print("  -> solved; escalating", file=sys.stderr)
   407	
   408	            rung += 1
   409	            if rung < len(ladder):
   410	                params = ladder[rung]
   411	            else:
   412	                nxt = mod.escalate(call)
   413	                # A module may say "I could go harder, but the answer would no
   414	                # longer fit under the cap" by returning the string "cap_bound".
   415	                # That is NOT the same verdict as "this family has no hardness
   416	                # left": the first is a property of our answer format, the second
   417	                # is a property of the paper. Ten rejections were papers whose
   418	                # escalate() stopped at the cap and were then discarded as
   419	                # too_easy -- judged un-writable, not unsuitable.
   420	                if nxt == "cap_bound":
   421	                    verdict = {"verdict": "cap_bound",
   422	                               "escalations_used": escalation_round,
   423	                               "reason": "the family can be made harder, but only by "
   424	                                         "lengthening the answer past the output cap. "
   425	                                         "This is a limit of the answer format, not of "
   426	                                         "the paper -- do not reject it as too_easy."}
   427	                    break
   428	                if nxt is None:
   429	                    # Do not take "None" at face value. cap_bound has been documented
   430	                    # in the escalate() contract and in STEP 0, and builders still
   431	                    # return None when what they mean is "the answer would not fit":
   432	                    # 2601.05272 climbed n=64,72,80,84 and stopped at 249 atoms
   433	                    # against a 256 cap, then reported "the family cannot be made
   434	                    # harder", which was false. Measure it here instead of asking.
   435	                    _atoms, _chars = _answer_size(mod, call)
   436	                    _near = False
   437	                    if _atoms is not None:
   438	                        _near = (_atoms >= CAP_NEAR_FRACTION * ANSWER_ATOM_CAP
   439	                                 or _chars >= CAP_NEAR_FRACTION * ANSWER_CHAR_CAP)
   440	                    _one_dial = len(axes_moved) <= 1
   441	                    if _near or _one_dial:
   442	                        verdict = {
   443	                            "verdict": "cap_bound",
   444	                            "escalations_used": escalation_round,
   445	                            "answer_atoms": _atoms, "answer_chars": _chars,
   446	                            "atom_cap": ANSWER_ATOM_CAP, "char_cap": ANSWER_CHAR_CAP,
   447	                            "axes_moved": sorted(axes_moved),
   448	                            # Two different diagnoses share this verdict, and the
   449	                            # cure differs. "answer_cap": the format genuinely
   450	                            # blocked the ladder -- needs a fixed-length witness.
   451	                            # "single_axis": the ladder only ever turned one dial,
   452	                            # so the family was never actually explored -- often
   453	                            # with a tiny answer and enormous headroom left.
   454	                            "signal": "+".join(
   455	                                x for x in (("answer_cap" if _near else ""),
   456	                                            ("single_axis" if _one_dial else "")) if x),
   457	                            "reason": (
   458	                                "escalate() returned None, but this looks like the ANSWER "
   459	                                "CAP rather than a hardness ceiling"
   460	                                + (f": the answer is already {_atoms} atoms / {_chars} chars "
   461	                                   f"against a {ANSWER_ATOM_CAP}-atom, {ANSWER_CHAR_CAP}-char cap"
   462	                                   if _atoms is not None else "")
   463	                                + (f"; the ladder only ever moved {sorted(axes_moved) or ['nothing']}, "
   464	                                   "so no fixed-answer-length axis was tried"
   465	                                   if _one_dial else "")
   466	                                + ".  PARK this paper -- do not write REJECTED.md.  Harden at "
   467	                                  "fixed answer length instead (bigger ground set with the same "
   468	                                  "witness size, larger modulus, denser decoys, tighter "
   469	                                  "constraints) and re-run."),
   470	                        }
   471	                        break
   472	                    verdict = {"verdict": "too_easy", "escalations_used": escalation_round,
   473	                               "axes_moved": sorted(axes_moved),
   474	                               "answer_atoms": _atoms,
   475	                               "reason": "escalate() returned None — the family cannot be "
   476	                                         "made harder, and the oracle pool still solves it"}
   477	                    break
   478	                params = dict(nxt, _preset="escalated")
   479	        else:
   480	            # The loop ran out of ESCALATIONS, which says nothing about the family
   481	            # until we ask whether it had anywhere left to go.  Ask.
   482	            _atoms, _chars = _answer_size(mod, prev_call or {})
   483	            try:
   484	                _more = mod.escalate(dict(prev_call or {}))
   485	            except Exception:                               # noqa: BLE001
   486	                _more = None
   487	            if _more is not None:
   488	                verdict = {
   489	                    "verdict": "budget_bound",
   490	                    "escalations_used": MAX_ESCALATIONS,
   491	                    "axes_moved": sorted(axes_moved),
   492	                    "answer_atoms": _atoms, "answer_chars": _chars,
   493	                    "next_level": None if _more == "cap_bound" else _more,
   494	                    "escalate_says": "cap_bound" if _more == "cap_bound" else "more levels",
   495	                    "reason": (
   496	                        f"the oracle pool solved every level through {MAX_ESCALATIONS} "
   497	                        f"escalations, but escalate() was STILL WILLING TO CLIMB "
   498	                        f"({'it would next report cap_bound' if _more == 'cap_bound' else _more}). "
   499	                        "The binding constraint was this harness's escalation budget, not "
   500	                        "the paper.  PARK it -- do not write REJECTED.md.  Re-run with "
   501	                        "ORACLE_MAX_ESCALATIONS raised, or ship at a higher preset."),
   502	                }
   503	            else:
   504	                verdict = {"verdict": "too_easy", "escalations_used": MAX_ESCALATIONS,
   505	                           "axes_moved": sorted(axes_moved),
   506	                           "answer_atoms": _atoms, "answer_chars": _chars,
   507	                           "reason": f"the oracle pool solved every level through "
   508	                                     f"{MAX_ESCALATIONS} escalations, and escalate() "
   509	                                     f"has nothing further to offer"}
   510	
   511	    update_meta(harden_verdict=verdict)
   512	    print(json.dumps(verdict, indent=1))
   513	    # 0 hardened / 9 too_easy (give the paper up) / 10 park it -- the paper is fine
   514	    # and the binding constraint is ours: the answer format (cap_bound) or the
   515	    # escalation budget (budget_bound).
   516	    return {"hardened": 0, "cap_bound": 10, "budget_bound": 10}.get(verdict["verdict"], 9)
   517	
   518	
   519	if __name__ == "__main__":
   520	    sys.exit(main())
   287	# G6 must include the domain-standard attack, not only the three generic probes.
   288	# 2408.04743 passed all eight gates AND the four-vendor oracle pool, then fell to a
   289	# spectral attack on 20/20 instances -- the generic outlier/greedy/restart panel is
   290	# blind to what is actually known about the problem class.
   291	g6 = next((v for k, v in gates.items() if k.startswith("G6")), None)
   292	atk = (g6 or {}).get("attacks")
   293	n_atk = len(atk) if isinstance(atk, (dict, list)) else 0
   294	if g6 is not None and not isinstance(atk, (dict, list)):
   295	    print("ERROR: G6 does not report an 'attacks' object.  Report the panel as\n"
   296	          "       {'pass': ..., 'attacks': {name: {'successes': n, 'attempts': m}, ...}}\n"
   297	          "       so the panel can be checked mechanically -- see prompts/codex_task.md, G6.")
   298	    sys.exit(1)
   299	if n_atk and n_atk < 4:
   300	    names = ", ".join(atk) if isinstance(atk, dict) else str(atk)
   301	    print(f"ERROR: G6 reports only {n_atk} attacks ({names}).\n"
   302	          "       The three generic probes are not sufficient on their own: run the\n"
   303	          "       standard algorithm for the problem class too (SAT/ILP/spectral/LLL/\n"
   304	          "       DLX -- see prompts/codex_task.md, G6). If you truly cannot run it,\n"
   305	          "       record it as an attack entry saying so and name it in the README.")
   306	    sys.exit(1)
   307	# The pass flag is self-reported.  Recompute from the numbers that are already on
   308	# disk: a panel that records a successful attack has broken its own family, whatever
   309	# the flag says.  Observed live: 2410.07666 recorded
   310	# random_restart_walksat_32x200n successes=8/8 -- it honestly set pass=false, but
   311	# nothing here would have caught it if it had not.
   312	_wins = []
   313	if isinstance(atk, dict):
   314	    for _name, _res in atk.items():
   315	        _s = _res.get("successes") if isinstance(_res, dict) else None
   316	        _a = _res.get("attempts") if isinstance(_res, dict) else None
   317	        if isinstance(_s, (int, float)) and _s > 0:
   318	            _wins.append(f"{_name} {_s}/{_a}")
   319	if _wins:
   320	    print("ERROR: G6 records a SUCCESSFUL attack: " + "; ".join(_wins) + "\n"
   321	          "       The family is solved by its own adversary panel.  Escalate the\n"
   322	          "       parameters or reject the paper -- do not ship it.")
   323	    sys.exit(1)
   324	print(f"== gates ==\n  {len(gates)} gates pass, G8 canonical_key present, "
   325	      f"G6 panel = {n_atk or 'unknown'} attacks, 0 attack successes")
