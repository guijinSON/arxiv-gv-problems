    98	
    99	def _ssl_context():
   100	    """A context with a CA bundle that actually exists.
   101	
   102	    A python.org build on macOS whose "Install Certificates.command" was never
   103	    run has openssl_cafile pointing at a file that is not there, and every call
   104	    dies with CERTIFICATE_VERIFY_FAILED.  The loop treats that as an API error
   105	    and refuses to make a hardness claim, which is the right failure, but it is
   106	    a failure of the machine and not of the family — so find a usable bundle
   107	    first.  Never fall back to an unverified context: this call carries an API
   108	    key.
   109	    """
   110	    ctx = ssl.create_default_context()
   111	    if ctx.cert_store_stats().get("x509_ca", 0) > 0:
   112	        return ctx
   113	    candidates = [os.environ.get("SSL_CERT_FILE"), "/etc/ssl/cert.pem",
   114	                  "/etc/pki/tls/certs/ca-bundle.crt",
   115	                  "/etc/ssl/certs/ca-certificates.crt"]
   116	    try:
   117	        import certifi
   118	        candidates.append(certifi.where())
   119	    except ImportError:
   120	        pass
   121	    for path in candidates:
   122	        if path and os.path.exists(path):
   123	            try:
   124	                return ssl.create_default_context(cafile=path)
   125	            except Exception:                                 # noqa: BLE001
   126	                continue
   127	    sys.exit("ERROR: no usable CA bundle — TLS verification would fail for every "
   128	             "oracle call. On a python.org build, run the bundled "
   129	             "'Install Certificates.command', or set SSL_CERT_FILE.")
   130	
   131	
   132	SSL_CONTEXT = None
   133	SCHEMA_VERSION = 2
   134	
   135	TRANSCRIPT = "llm_loop_transcript.jsonl"
   136	META = ".meta.json"
   137	
   138	
   139	# --- module loading ---------------------------------------------------------
   140	def load_module(path):
   141	    spec = importlib.util.spec_from_file_location("gen", path)
   142	    mod = importlib.util.module_from_spec(spec)
   143	    spec.loader.exec_module(mod)
   144	    for fn in ("make_instance", "render", "parse_answer", "verify", "escalate"):
   145	        if not callable(getattr(mod, fn, None)):
   146	            sys.exit(f"ERROR: {path} has no callable {fn}() — see prompts/codex_task.md STEP 1")
   147	    if not isinstance(getattr(mod, "DIFFICULTY", None), dict) or not mod.DIFFICULTY:
   148	        sys.exit(f"ERROR: {path} has no non-empty DIFFICULTY dict")
   149	    return mod
