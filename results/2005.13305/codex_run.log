    36	except Exception as e:
    37	    print(f"ERROR: cannot import {scripts_dir}/corpus_report.py ({e}).\n"
    38	          "       emit.sh stamps every record with native_domain / computational_core /\n"
    39	          "       certificate_form / object_regime / domain_essentiality /\n"
    40	          "       reduction_kind / track / core_provenance, and an unlabelled artifact\n"
    41	          "       cannot be sliced later.  Fix the import rather than emitting blind.")
