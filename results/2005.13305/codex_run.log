   546	        if len(closed) != vertex_count:
   547	            return None, {"error": "nonunique child rows"}
   548	        permutation = []
   549	        for x in range(vertex_count):
   550	            row_lookups += 1
   551	            if masks[x] not in closed:
   552	                return None, {"error": "closed-row match failed"}
   553	            permutation.append(closed[masks[x]])
   554	        maps.append([permutation[x] for x in _basis(dimension)])
   555	    return {"maps": maps}, {
   556	        "wall_clock_sec": time.perf_counter() - started,
   557	        "bitset_intersections": intersections,
   558	        "row_hash_lookups": row_lookups,
   559	        "elementary_adjacency_comparisons": elementary,
   560	    }
   561	
   562	
   563	def _cycle_type(permutation: list[int]) -> tuple[int, ...]:
   564	    seen = [False] * len(permutation)
   565	    out = []
   566	    for start in range(len(permutation)):
   567	        if seen[start]:
   568	            continue
   569	        x = start
   570	        length = 0
   571	        while not seen[x]:
   572	            seen[x] = True
   573	            length += 1
   574	            x = permutation[x]
   575	        out.append(length)
   576	    return tuple(sorted(out))
   577	
   578	
   579	def canonical_key(inst: dict) -> str:
   580	    """Strong multiplex invariant, independent of layer and neighbor order."""
   581	    recovered = _compact_recover(inst)
   582	    layer_count = len(inst["layers"])
   583	    vertex_count = len(inst["layers"][0]["adjacency"])
   584	    if any(len(layer["adjacency"]) != vertex_count for layer in inst["layers"]):
   585	        payload = [(len(layer["adjacency"]),) for layer in inst["layers"]]
   586	        return hashlib.sha256(repr(sorted(payload)).encode()).hexdigest()
   587	    sets = [[set(row) for row in layer["adjacency"]] for layer in inst["layers"]]
   588	    full_maps = []
   589	    for layer, images in zip(inst["layers"], recovered["maps"]):
   590	        dimension = 2 * layer["side_bits"]
   591	        parsed, why = _params_from_images(images, dimension)
   592	        if parsed is None:
   593	            raise ValueError(why)
   594	        full_maps.append([_apply_params(parsed, x) for x in range(vertex_count)])
   595	    best = None
   596	    orders = itertools.permutations(range(layer_count)) if layer_count <= 7 else [tuple(range(layer_count))]
   597	    for order in orders:
   598	        edge_hist = [0] * (1 << layer_count)
   599	        local = [[0] * (1 << layer_count) for _ in range(vertex_count)]
   600	        for x in range(vertex_count):
   601	            for y in range(x + 1, vertex_count):
   602	                mask = 0
   603	                for new_bit, old_layer in enumerate(order):
   604	                    if y in sets[old_layer][x]:
   605	                        mask |= 1 << new_bit
   606	                edge_hist[mask] += 1
   607	                local[x][mask] += 1
   608	                local[y][mask] += 1
   609	        product_types = []
   610	        for pos, i in enumerate(order):
   611	            for j in order[pos + 1:]:
   612	                composition = [full_maps[i][full_maps[j][x]] for x in range(vertex_count)]
   613	                product_types.append(_cycle_type(composition))
   614	        signature = (tuple(edge_hist), tuple(sorted(tuple(row) for row in local)), tuple(product_types))
   615	        encoded = repr(signature)
   616	        if best is None or encoded < best:
   617	            best = encoded
   618	    return hashlib.sha256(best.encode()).hexdigest()
   619	
