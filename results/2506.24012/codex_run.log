+def _is_irreducible(modulus: int, n: int) -> bool:
+    """Rabin's exact test for a monic binary polynomial."""
+    if modulus >> n != 1 or modulus & 1 == 0:
+        return False
+    x = 0b10
+    value = x
+    for _ in range(n):
