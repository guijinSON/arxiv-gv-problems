+    modulus = _irreducible_polynomial(degree)
+    rng = random.Random(seed)
+    omega = _subfield_generator(modulus, degree)
+    a = _gf_pow(omega, 1 + rng.randrange(6), modulus, degree)
+
+    # Sample the preimage first.  The core trace is kept nonzero to avoid the
+    # degenerate one-square inversion branch, but the public x remains uniformly
+    # masked by b at the shipping preset.
+    while True:
+        w = rng.getrandbits(degree)
+        if w and _relative_trace(w, n, modulus, degree) != 0:
+            break
