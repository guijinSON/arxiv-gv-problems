+def _attack_drop_trace(inst: dict) -> list[int]:
+    """Wrong by-hand ansatz: solve only a*x^2=y by repeated square roots."""
+    n, modulus = inst["n"], inst["modulus"]
+    a_inv = _e_square(tuple(inst["a"]), modulus, n)
