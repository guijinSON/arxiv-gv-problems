+    a = tuple(inst["a"])
+    y = tuple(inst["target"])
+    counter = {"field_operations": 0}
+    start = time.perf_counter()
 
+    # Trace(y)=(a+1)t^2 in GF(4).  Every nonzero GF(4) inverse is its square.
+    trace_y = _e_trace(y, mask)
+    counter["field_operations"] += 2  # two parity evaluations
