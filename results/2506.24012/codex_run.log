+"""Verified generator for arXiv:2506.24012.
+
+The witness problem is inversion of an affine translate of the permutation
+polynomial a*x^2 + x*Tr(x) from the final example of Section 3.  Elements of
+GF(2^(3n)) are represented exactly as binary polynomials modulo a displayed
+irreducible polynomial.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import random
+import re
+import time
+from functools import lru_cache
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "number_theory",
+    "object_regime": "finite_field",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "polynomial",
+    "native_objects": [
+        "finite field GF(2^(3n)) in a polynomial basis",
+        "permutation polynomial with a relative-trace term",
+        "finite-field polynomial preimage",
+    ],
+    "verification_operations": [
+        "exact GF(2) polynomial multiplication and modular reduction",
+        "exact Frobenius relative trace",
+        "exact substitution and equality comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Translating x by the displayed b exposes the paper's trace-quadratic "
+        "permutation and a trace invariant; without it, one must execute eight "
+        "large binary linear solves."
+    ),
+    "hardness_basis": (
+        "Track B: trace enumeration followed by GF(2) Gaussian elimination is "
+        "O(8N^3) for N=3n and, at shipping n=31 (N=93), costs about 3.4 million "
+        "scalar bit operations; the affine-normalization and q-half-trace route "
+        "uses at most 256 exact field operations."
+    ),
+    "max_answer_tokens": 9,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 1, "affine_mask": 0},
+    "easy": {"n": 7, "affine_mask": 0},
+    "medium": {"n": 19, "affine_mask": 1},
+    "hard": {"n": 31, "affine_mask": 1},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "One nonzero binary polynomial x of degree below N=3n, encoded as a "
+        "fixed-width lowercase hexadecimal bit string in the one-key JSON object "
+        "{\"x\":\"0x...\"}; bit i is the coefficient of z^i."
+    ),
+    "bounds": {
+        "shipping_field_degree": 93,
+        "coefficient_field_order": 2,
+        "max_polynomials": 1,
+        "atomic_elements": 1,
+    },
+}
+
+STRUCTURAL_HINT = (
+    "The normalized variables w=x+b and Y=y+e+a*b^2+b*tau satisfy "
+    "Tr(Y)=(a+1)*Tr(w)^2."
+)
+PLACEBO_HINT = (
+    "The polynomial-basis convention fixes every coefficient, and careful "
+    "reduction modulo the displayed polynomial avoids indexing errors."
+)
+
+# Filled from the three isolated harden.py runs before shipping.  These are
+# diagnostics only; G9(c), not oracle success, is the gate.
+G9_ARM_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+}
+
+NOTES = """\
+Section 2, Proposition 2 supplies the quadratic-form character-sum criterion.
+Section 3, Theorem 5 gives the trace-polynomial characterization, and the final
+example specializes its corollary: for odd n, a*x^2+x*Tr(x) permutes GF(q^n)
+exactly for a in GF(q)^* with a != 1.  This family uses q=8 and carries that map
+through input and output translations.  Recognition/classification is therefore
+easy, but inversion is not a Track-A claim: the reference method enumerates the
+eight possible traces and performs GF(2) elimination.  The low-weight/outlier,
+coordinate-greedy, random-restart, and one-term affine ansatz attacks are tested
+on the shipping distribution.  The planted preimage and all affine masks are
+sampled from the same field representation; no witness is found by search.
+"""
+
+
+# ---------------------------------------------------------------------------
+# Binary-polynomial and finite-field arithmetic
+
+
+def _poly_mod(a: int, modulus: int) -> int:
+    md = modulus.bit_length() - 1
+    while a and a.bit_length() - 1 >= md:
+        a ^= modulus << ((a.bit_length() - 1) - md)
+    return a
+
+
+def _poly_gcd(a: int, b: int) -> int:
+    while b:
+        a, b = b, _poly_mod(a, b)
+    return a
+
+
+def _gf_mul(a: int, b: int, modulus: int, degree: int) -> int:
+    mask = (1 << degree) - 1
+    a &= mask
+    b &= mask
+    out = 0
+    while b:
+        if b & 1:
+            out ^= a
+        b >>= 1
+        a <<= 1
+        if a & (1 << degree):
+            a ^= modulus
+    return out & mask
+
+
+def _gf_square(a: int, modulus: int, degree: int) -> int:
+    expanded = 0
+    i = 0
+    while a:
+        if a & 1:
+            expanded |= 1 << (2 * i)
+        a >>= 1
+        i += 1
+    return _poly_mod(expanded, modulus) & ((1 << degree) - 1)
+
+
+def _gf_pow(a: int, exponent: int, modulus: int, degree: int) -> int:
+    out = 1
+    while exponent:
+        if exponent & 1:
+            out = _gf_mul(out, a, modulus, degree)
+        exponent >>= 1
+        if exponent:
+            a = _gf_square(a, modulus, degree)
+    return out
+
+
+def _frobenius(a: int, steps: int, modulus: int, degree: int) -> int:
+    for _ in range(steps % degree):
+        a = _gf_square(a, modulus, degree)
+    return a
+
+
+def _prime_divisors(v: int) -> list[int]:
+    out = []
+    p = 2
+    while p * p <= v:
+        if v % p == 0:
+            out.append(p)
+            while v % p == 0:
+                v //= p
+        p += 1
+    if v > 1:
+        out.append(v)
+    return out
+
+
+def _is_irreducible(modulus: int, degree: int) -> bool:
+    """Rabin's exact irreducibility test over GF(2)."""
+    x = 2
+    checkpoints = {degree // p for p in _prime_divisors(degree)}
+    power = x
+    for i in range(1, degree + 1):
+        power = _gf_square(power, modulus, degree)
+        if i in checkpoints and _poly_gcd(power ^ x, modulus) != 1:
+            return False
+    return power == x
+
+
+@lru_cache(maxsize=None)
+def _irreducible_polynomial(degree: int) -> int:
+    if degree < 2:
+        raise ValueError("field degree must be at least 2")
+    rng = random.Random(0x250624012 ^ (degree * 0x9E3779B1))
+    while True:
+        middle = rng.getrandbits(degree - 1) << 1
+        candidate = (1 << degree) | middle | 1
+        if _is_irreducible(candidate, degree):
+            return candidate
+
+
+@lru_cache(maxsize=None)
+def _subfield_generator(modulus: int, degree: int) -> int:
+    """Return an element of order 7, hence a generator of the unique GF(8)."""
+    exponent = ((1 << degree) - 1) // 7
+    for candidate in range(2, min(1 << degree, 512)):
+        omega = _gf_pow(candidate, exponent, modulus, degree)
+        if omega not in (0, 1):
+            return omega
+    raise RuntimeError("could not construct the GF(8) subfield")
+
+
+@lru_cache(maxsize=None)
+def _subfield_elements(modulus: int, degree: int) -> tuple[int, ...]:
+    omega = _subfield_generator(modulus, degree)
+    values = {0, 1}
+    cur = 1
+    for _ in range(1, 7):
+        cur = _gf_mul(cur, omega, modulus, degree)
+        values.add(cur)
+    if len(values) != 8:
+        raise AssertionError("GF(8) construction failed")
+    return tuple(sorted(values))
+
+
+def _relative_trace(x: int, n: int, modulus: int, degree: int) -> int:
+    out = x
+    cur = x
+    for _ in range(1, n):
+        cur = _frobenius(cur, 3, modulus, degree)
+        out ^= cur
+    return out
+
+
+def _subfield_inverse(x: int, modulus: int, degree: int) -> int:
+    if x == 0:
+        raise ZeroDivisionError("zero has no inverse")
+    # x^(-1)=x^6 in GF(8): one multiplication after two squarings.
+    x2 = _gf_square(x, modulus, degree)
+    x4 = _gf_square(x2, modulus, degree)
+    return _gf_mul(x2, x4, modulus, degree)
+
+
+def _field_inverse(x: int, modulus: int, degree: int) -> int:
+    if x == 0:
+        raise ZeroDivisionError("zero has no inverse")
+    return _gf_pow(x, (1 << degree) - 2, modulus, degree)
+
+
+def _format_elem(x: int, degree: int) -> str:
+    width = (degree + 3) // 4
+    return "0x" + format(x, f"0{width}x")
+
+
+def _poly_terms(bits: int, variable: str = "z") -> str:
+    terms = []
+    for i in range(bits.bit_length() - 1, -1, -1):
+        if not ((bits >> i) & 1):
+            continue
+        if i == 0:
+            terms.append("1")
+        elif i == 1:
+            terms.append(variable)
+        else:
+            terms.append(f"{variable}^{i}")
+    return " + ".join(terms) if terms else "0"
+
+
+@lru_cache(maxsize=512)
+def _parse_public_values(
+    n_raw,
+    degree_raw,
+    modulus_raw,
+    a_raw,
+    b_raw,
+    tau_raw,
+    e_raw,
+    target_raw,
+) -> tuple[int, int, int, int, int, int, int, int]:
+    """Parse and validate immutable public values once per instance."""
+    n = int(n_raw)
+    degree = int(degree_raw)
+    if degree != 3 * n or n <= 0 or n % 2 != 1:
+        raise ValueError("invalid odd extension degree")
+    modulus = int(modulus_raw, 16)
+    a = int(a_raw, 16)
+    b = int(b_raw, 16)
+    tau = int(tau_raw, 16)
+    e = int(e_raw, 16)
+    target = int(target_raw, 16)
+    limit = 1 << degree
+    if any(v < 0 or v >= limit for v in (a, b, tau, e, target)):
+        raise ValueError("instance coefficient outside field")
+    if modulus.bit_length() - 1 != degree or not (modulus & 1):
+        raise ValueError("invalid field modulus")
+    if a in (0, 1) or _frobenius(a, 3, modulus, degree) != a:
+        raise ValueError("a is not in GF(8)\\{0,1}")
+    if _relative_trace(b, n, modulus, degree) != tau:
+        raise ValueError("tau is not Tr(b)")
+    return n, degree, modulus, a, b, tau, e, target
+
+
+def _parse_public(inst: dict) -> tuple[int, int, int, int, int, int, int, int]:
+    return _parse_public_values(
+        inst["n"],
+        inst["field_degree"],
+        inst["modulus"],
+        inst["a"],
+        inst["b"],
+        inst["tau"],
+        inst["e"],
+        inst["target"],
+    )
+
+
+@lru_cache(maxsize=128)
+def _evaluation_context(
+    n: int, degree: int, modulus: int, a: int, b: int, tau: int
+):
+    trace_columns = tuple(
+        _relative_trace(1 << i, n, modulus, degree) for i in range(degree)
+    )
+    a_square_columns = tuple(
+        _gf_mul(a, _gf_square(1 << i, modulus, degree), modulus, degree)
+        for i in range(degree)
+    )
+    multipliers = {}
+    for t in _subfield_elements(modulus, degree):
+        cols = tuple(_gf_mul(t, 1 << i, modulus, degree) for i in range(degree))
+        multipliers[t] = _chunk_tables(cols, degree)
+    return (
+        _chunk_tables(trace_columns, degree),
+        _chunk_tables(a_square_columns, degree),
+        multipliers,
+        {t: _gf_mul(b, t, modulus, degree) for t in multipliers},
+    )
+
+
+def _chunk_tables(columns: tuple[int, ...], degree: int) -> tuple[tuple[int, ...], ...]:
+    """Compile an exact GF(2)-linear map into eight-bit lookup chunks."""
+    chunks = []
+    for start in range(0, degree, 8):
+        table = [0] * 256
+        available = min(8, degree - start)
+        for value in range(1, 1 << available):
+            low = value & -value
+            table[value] = table[value ^ low] ^ columns[start + low.bit_length() - 1]
+        chunks.append(tuple(table))
+    return tuple(chunks)
+
+
+def _linear_apply(columns: tuple[int, ...], bits: int) -> int:
+    out = 0
+    while bits:
+        low = bits & -bits
+        out ^= columns[low.bit_length() - 1]
+        bits ^= low
+    return out
+
+
+def _table_apply(tables: tuple[tuple[int, ...], ...], bits: int) -> int:
+    out = 0
+    for table in tables:
+        out ^= table[bits & 255]
+        bits >>= 8
+    return out
+
+
+def _evaluate(inst: dict, x: int) -> int:
+    n, degree, modulus, a, b, tau, e, _ = _parse_public(inst)
+    trace_table, a_square_table, multipliers, b_times = _evaluation_context(
+        n, degree, modulus, a, b, tau
+    )
+    t = _table_apply(trace_table, x)
+    return (
+        _table_apply(a_square_table, x)
+        ^ _table_apply(multipliers[t], x)
+        ^ _table_apply(multipliers[tau], x)
+        ^ b_times[t]
+        ^ e
+    )
+
+
+# ---------------------------------------------------------------------------
+# Generator and public contract
+
+
+def make_instance(n: int, seed: int = 0, affine_mask: int = 1, **params) -> dict:
+    """Inverse-generate a preimage problem for a theorem-backed permutation."""
+    del params
+    if not isinstance(n, int) or n <= 0 or n % 2 != 1:
+        raise ValueError("n must be a positive odd integer")
+    if affine_mask not in (0, 1):
+        raise ValueError("affine_mask must be 0 or 1")
+    degree = 3 * n
+    modulus = _irreducible_polynomial(degree)
+    rng = random.Random(seed)
+    omega = _subfield_generator(modulus, degree)
+    a = _gf_pow(omega, 1 + rng.randrange(6), modulus, degree)
+
+    # Sample the preimage first.  The core trace is kept nonzero to avoid the
+    # degenerate one-square inversion branch, but the public x remains uniformly
+    # masked by b at the shipping preset.
+    while True:
+        w = rng.getrandbits(degree)
+        if w and _relative_trace(w, n, modulus, degree) != 0:
+            break
+    if affine_mask:
+        while True:
+            b = rng.getrandbits(degree)
+            x = w ^ b
+            if x != 0:
+                break
+        d = rng.getrandbits(degree)
+    else:
+        b = 0
+        d = 0
+        x = w
+    tau = _relative_trace(b, n, modulus, degree)
+    b2 = _gf_square(b, modulus, degree)
+    e = d ^ _gf_mul(a, b2, modulus, degree) ^ _gf_mul(b, tau, modulus, degree)
+
+    width = (degree + 3) // 4
+    inst = {
+        "family": "affine_trace_quadratic_permutation_preimage",
+        "q": 8,
+        "n": n,
+        "field_degree": degree,
+        "hex_width": width,
+        "modulus": hex(modulus),
+        "a": _format_elem(a, degree),
+        "b": _format_elem(b, degree),
+        "tau": _format_elem(tau, degree),
+        "e": _format_elem(e, degree),
+        "target": "",  # completed after exact evaluation
+        "answer": {"x": _format_elem(x, degree)},
+    }
+    target = _evaluate({**inst, "target": _format_elem(0, degree)}, x)
+    inst["target"] = _format_elem(target, degree)
+    return inst
+
+
+def render(inst: dict) -> str:
+    n, degree, modulus, a, b, tau, e, target = _parse_public(inst)
+    width = (degree + 3) // 4
+    zero_example = "0x" + "0" * width
+    statement = f"""Invert a permutation polynomial over an exact finite field.
+
+Let F = GF(2^{degree}) = GF(2)[z]/(P(z)), where
+P(z) = {_poly_terms(modulus)}.
+The relative base field is the unique GF(8) subfield of F, and n={n} is odd.
+
+Representation: a field element is a lowercase hexadecimal bit string of exactly
+{width} digits after 0x (leading zeroes are mandatory). Bit i is the coefficient
+of z^i. Addition is bitwise XOR; multiplication is polynomial multiplication over
+GF(2), reduced modulo P. Powers and equality are taken in F.
+
+For u in F define the relative trace
+Tr(u) = u + u^8 + u^(8^2) + ... + u^(8^{n - 1}).
+
+The supplied constants are
+a   = {_format_elem(a, degree)}
+b   = {_format_elem(b, degree)}
+tau = {_format_elem(tau, degree)}  (and tau = Tr(b))
+e   = {_format_elem(e, degree)}
+y   = {_format_elem(target, degree)}
+
+They satisfy a^8=a and a is neither 0 nor 1. Define
+Fmap(X) = a*X^2 + X*Tr(X) + tau*X + b*Tr(X) + e.
+For these promised conditions Fmap is a permutation of F. Find its unique nonzero
+preimage x satisfying Fmap(x)=y. No approximation is allowed.
+
+Give your final answer inside <answer></answer> tags as one JSON object with the
+single key \"x\" and a fixed-width hexadecimal polynomial string.
+Example: <answer>{{\"x\":\"{zero_example}\"}}</answer>
+Output nothing else inside the tags."""
+    mode = __import__("os").environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nStructural hint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text) -> object | None:
+    if not isinstance(text, str):
+        return None
+    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    if not blocks:
+        return None
+    payload = blocks[-1].strip()
+    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", payload, re.I | re.S)
+    if fence:
+        payload = fence.group(1).strip()
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError):
+        return None
+    return value
+
+
+def verify(inst: dict, answer) -> tuple[bool, str]:
+    try:
+        _, degree, _, _, _, _, _, target = _parse_public(inst)
+    except Exception as exc:  # instance validity is checked without the answer key
+        return False, f"invalid instance: {exc}"
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if set(answer) != {"x"}:
+        return False, "answer must contain exactly the key 'x'"
+    raw = answer["x"]
+    if not isinstance(raw, str):
+        return False, "x must be a hexadecimal polynomial string"
+    if not raw.startswith("0x"):
+        return False, "x must start with 0x"
+    digits = raw[2:]
+    width = (degree + 3) // 4
+    if len(digits) != width:
+        return False, f"x must contain exactly {width} hexadecimal digits"
+    if not re.fullmatch(r"[0-9a-f]+", digits):
+        return False, "x must use only lowercase hexadecimal digits"
+    x = int(digits, 16)
+    if x >= 1 << degree:
+        return False, f"x has polynomial degree at least {degree}"
+    if x == 0:
+        return False, "x must be nonzero"
+    if _evaluate(inst, x) != target:
+        return False, "candidate does not map to the target y"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    _, degree, _, _, _, _, _, _ = _parse_public(inst)
+    x = rng.randrange(1, 1 << degree)
+    return {"x": _format_elem(x, degree)}
+
+
+def search_space(inst: dict) -> int | None:
+    _, degree, _, _, _, _, _, _ = _parse_public(inst)
+    return (1 << degree) - 1
+
+
+def enumerate_all(inst: dict) -> int | None:
+    _, degree, _, _, _, _, _, _ = _parse_public(inst)
+    if degree > 15:
+        return None
+    hits = 0
+    for x in range(1, 1 << degree):
+        ok, _ = verify(inst, {"x": _format_elem(x, degree)})
+        hits += int(ok)
+    return hits
+
+
+# ---------------------------------------------------------------------------
+# Compact inversion, reference algorithm, attacks, and canonicalisation
+
+
+def _normalized_core(inst: dict) -> tuple[int, int, int]:
+    n, degree, modulus, a, b, tau, e, target = _parse_public(inst)
+    d = e ^ _gf_mul(a, _gf_square(b, modulus, degree), modulus, degree)
+    d ^= _gf_mul(b, tau, modulus, degree)
+    return a, b, target ^ d
+
+
+def _core_inverse(
+    core_target: int, a: int, n: int, modulus: int, degree: int
+) -> tuple[int, int]:
+    """Invert a*w^2+w*Tr(w) by the trace and q-half-trace identities."""
+    ops = 0
+
+    # s=Tr(Y), counting three squarings and one addition per q-Frobenius step.
+    s = core_target
+    cur = core_target
+    for _ in range(1, n):
+        for _ in range(3):
+            cur = _gf_square(cur, modulus, degree)
+            ops += 1
+        s ^= cur
+        ops += 1
+
+    ap1 = a ^ 1
+    ops += 1
+    inv_ap1 = _subfield_inverse(ap1, modulus, degree)
+    ops += 3
+    t2 = _gf_mul(s, inv_ap1, modulus, degree)
+    ops += 1
+    t = _gf_square(_gf_square(t2, modulus, degree), modulus, degree)
+    ops += 2
+    if t == 0:
+        # This branch is not sampled, but keeps the public solver complete.
+        inv_a = _subfield_inverse(a, modulus, degree)
+        ops += 3
+        w2 = _gf_mul(core_target, inv_a, modulus, degree)
+        ops += 1
+        w = _frobenius(w2, degree - 1, modulus, degree)
+        ops += degree - 1
+        return w, ops
+
+    t_squared = _gf_square(t, modulus, degree)
+    ops += 1
+    inv_t_squared = _subfield_inverse(t_squared, modulus, degree)
+    ops += 3
+    c = _gf_mul(a, core_target, modulus, degree)
+    ops += 1
+    c = _gf_mul(c, inv_t_squared, modulus, degree)
+    ops += 1
+    c2 = _gf_square(c, modulus, degree)
+    c4 = _gf_square(c2, modulus, degree)
+    d = c ^ c2 ^ c4
+    ops += 4
+
+    # q-half-trace: H_q(d)=sum d^(q^(2i)).  Its relative trace is zero;
+    # adding a selects the unique Artin-Schreier root with trace a.
+    z0 = d
+    cur = d
+    for _ in range((n - 1) // 2):
+        for _ in range(6):
+            cur = _gf_square(cur, modulus, degree)
+            ops += 1
+        z0 ^= cur
+        ops += 1
+    z = z0 ^ a
+    ops += 1
+    inv_a = _subfield_inverse(a, modulus, degree)
+    ops += 3
+    factor = _gf_mul(t, inv_a, modulus, degree)
+    ops += 1
+    w = _gf_mul(factor, z, modulus, degree)
+    ops += 1
+    return w, ops
+
+
+def _compact_inverse(inst: dict) -> tuple[int, int]:
+    n, degree, modulus, a, b, tau, e, target = _parse_public(inst)
+    # Affine normalization Y=y+d, d=e+a*b^2+b*tau.
+    b2 = _gf_square(b, modulus, degree)
+    ab2 = _gf_mul(a, b2, modulus, degree)
+    bt = _gf_mul(b, tau, modulus, degree)
+    d = e ^ ab2 ^ bt
+    core_target = target ^ d
+    normalization_ops = 6
+    w, core_ops = _core_inverse(core_target, a, n, modulus, degree)
+    return w ^ b, normalization_ops + core_ops + 1
+
+
+def _linear_columns_for_trace(
+    degree: int, modulus: int, a: int, coefficient: int
+) -> tuple[int, ...]:
+    return tuple(
+        _gf_mul(a, _gf_square(1 << j, modulus, degree), modulus, degree)
+        ^ _gf_mul(coefficient, 1 << j, modulus, degree)
+        for j in range(degree)
+    )
+
+
+def _binary_linear_solutions(
+    columns: tuple[int, ...], rhs: int, degree: int
+) -> tuple[list[int], int]:
+    """Solve a binary linear system using packed RREF; report scalar bit cost."""
+    rows = [((rhs >> i) & 1) << degree for i in range(degree)]
+    operations = degree * degree
+    for j, col in enumerate(columns):
+        bits = col
+        while bits:
+            low = bits & -bits
+            rows[low.bit_length() - 1] |= 1 << j
+            bits ^= low
+
+    pivot_cols = []
+    rank = 0
+    for col in range(degree):
+        pivot = None
+        for r in range(rank, degree):
+            operations += 1
+            if (rows[r] >> col) & 1:
+                pivot = r
+                break
+        if pivot is None:
+            continue
+        if pivot != rank:
+            rows[rank], rows[pivot] = rows[pivot], rows[rank]
+            operations += degree + 1
+        for r in range(degree):
+            if r != rank and ((rows[r] >> col) & 1):
+                rows[r] ^= rows[rank]
+                operations += degree + 1
+        pivot_cols.append(col)
+        rank += 1
+        if rank == degree:
+            break
+
+    coeff_mask = (1 << degree) - 1
+    for r in range(rank, degree):
+        if not (rows[r] & coeff_mask) and ((rows[r] >> degree) & 1):
+            return [], operations
+
+    particular = 0
+    for row_index, col in enumerate(pivot_cols):
+        if (rows[row_index] >> degree) & 1:
+            particular |= 1 << col
+    free = [c for c in range(degree) if c not in set(pivot_cols)]
+    if len(free) > 1:
+        # The maps used here have kernel dimension at most one.  Refuse to hide
+        # an unexpected exponential branch behind the reference measurement.
+        raise AssertionError("unexpected reference-system nullity")
+    if not free:
+        return [particular], operations
+    f = free[0]
+    kernel = 1 << f
+    for row_index, col in enumerate(pivot_cols):
+        if (rows[row_index] >> f) & 1:
+            kernel |= 1 << col
+    return [particular, particular ^ kernel], operations
+
+
+def _reference_inverse(inst: dict) -> tuple[int | None, int]:
+    n, degree, modulus, a, b, tau, e, target = _parse_public(inst)
+    operations = 0
+    found = []
+    for t in _subfield_elements(modulus, degree):
+        coefficient = t ^ tau
+        columns = _linear_columns_for_trace(degree, modulus, a, coefficient)
+        rhs = target ^ _gf_mul(b, t, modulus, degree) ^ e
+        candidates, cost = _binary_linear_solutions(columns, rhs, degree)
+        operations += cost + degree * degree
+        for x in candidates:
+            if x and _relative_trace(x, n, modulus, degree) == t:
+                if _evaluate(inst, x) == target:
+                    found.append(x)
+    found = sorted(set(found))
+    return (found[0] if len(found) == 1 else None), operations
+
+
+def _relabel_instance(
+    inst: dict,
+    frobenius_steps: int = 0,
+    input_shift: int = 0,
+    subfield_scale: int = 1,
+    output_shift: int = 0,
+) -> dict:
+    """Carry the instance and answer through genuine field-map symmetries."""
+    n, degree, modulus, a, b, tau, e, target = _parse_public(inst)
+    x = int(inst["answer"]["x"], 16)
+    j = frobenius_steps % degree
+    if j:
+        a = _frobenius(a, j, modulus, degree)
+        b = _frobenius(b, j, modulus, degree)
+        tau = _frobenius(tau, j, modulus, degree)
+        e = _frobenius(e, j, modulus, degree)
+        target = _frobenius(target, j, modulus, degree)
+        x = _frobenius(x, j, modulus, degree)
+    c = subfield_scale
+    if c == 0 or _frobenius(c, 3, modulus, degree) != c:
+        raise ValueError("scale must be a nonzero GF(8) element")
+    inv_c = _subfield_inverse(c, modulus, degree)
+    c_inv2 = _gf_square(inv_c, modulus, degree)
+    a_core, _, core_target = _normalized_core(
+        {
+            **inst,
+            "a": _format_elem(a, degree),
+            "b": _format_elem(b, degree),
+            "tau": _format_elem(tau, degree),
+            "e": _format_elem(e, degree),
+            "target": _format_elem(target, degree),
+        }
+    )
+    del a_core, core_target
+    old_d = e ^ _gf_mul(a, _gf_square(b, modulus, degree), modulus, degree)
+    old_d ^= _gf_mul(b, tau, modulus, degree)
+    new_b = _gf_mul(b ^ input_shift, inv_c, modulus, degree)
+    new_tau = _relative_trace(new_b, n, modulus, degree)
+    new_d = _gf_mul(c_inv2, old_d, modulus, degree) ^ output_shift
+    new_e = new_d ^ _gf_mul(
+        a, _gf_square(new_b, modulus, degree), modulus, degree
+    )
+    new_e ^= _gf_mul(new_b, new_tau, modulus, degree)
+    new_target = _gf_mul(c_inv2, target, modulus, degree) ^ output_shift
+    new_x = _gf_mul(x ^ input_shift, inv_c, modulus, degree)
+    out = dict(inst)
+    out.update(
+        a=_format_elem(a, degree),
+        b=_format_elem(new_b, degree),
+        tau=_format_elem(new_tau, degree),
+        e=_format_elem(new_e, degree),
+        target=_format_elem(new_target, degree),
+        answer={"x": _format_elem(new_x, degree)},
+    )
+    return out
+
+
+def canonical_key(inst: dict) -> str:
+    _, degree, modulus, a, _, _, _, _ = _parse_public(inst)
+    a, _, core_target = _normalized_core(inst)
+    nonzero = [v for v in _subfield_elements(modulus, degree) if v]
+    orbit = []
+    aj = a
+    yj = core_target
+    for _ in range(degree):
+        for c in nonzero:
+            c2 = _gf_square(c, modulus, degree)
+            scaled = _gf_mul(c2, yj, modulus, degree)
+            orbit.append((aj, scaled))
+        aj = _gf_square(aj, modulus, degree)
+        yj = _gf_square(yj, modulus, degree)
+    representative = min(orbit)
+    raw = f"{degree}:{modulus:x}:{representative[0]:x}:{representative[1]:x}"
+    return hashlib.sha256(raw.encode("ascii")).hexdigest()
+
+
+def _attack_sparse_outlier(inst: dict) -> bool:
+    _, degree, _, _, b, _, e, target = _parse_public(inst)
+    candidates = {b, e, target, b ^ target}
+    candidates.update(1 << i for i in range(degree))
+    for x in candidates:
+        if x:
+            ok, _ = verify(inst, {"x": _format_elem(x, degree)})
+            if ok:
+                return True
+    return False
+
+
+def _attack_greedy_bits(inst: dict) -> bool:
+    _, degree, _, _, b, _, _, target = _parse_public(inst)
+    x = target ^ b
+    if x == 0:
+        x = 1
+    score = (_evaluate(inst, x) ^ target).bit_count()
+    for _ in range(2):
+        improved = False
+        for bit in range(degree):
+            candidate = x ^ (1 << bit)
+            if candidate == 0:
+                continue
+            candidate_score = (_evaluate(inst, candidate) ^ target).bit_count()
+            if candidate_score < score:
+                x, score = candidate, candidate_score
+                improved = True
+                if score == 0:
+                    return True
+        if not improved:
+            break
+    return False
+
+
+def _attack_random_restart(inst: dict, seed: int) -> bool:
+    rng = random.Random(seed ^ 0xA771AC)
+    for _ in range(256):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return True
+    return False
+
+
+def _attack_obvious_ansatz(inst: dict) -> bool:
+    n, degree, modulus, a, b, _, _, _ = _parse_public(inst)
+    _, _, core_target = _normalized_core(inst)
+    candidates = {b, core_target ^ b}
+    # Ignore respectively the trace term or the quadratic term after centering.
+    inv_a = _subfield_inverse(a, modulus, degree)
+    square_rhs = _gf_mul(core_target, inv_a, modulus, degree)
+    candidates.add(_frobenius(square_rhs, degree - 1, modulus, degree) ^ b)
+    s = _relative_trace(core_target, n, modulus, degree)
+    inv_ap1 = _subfield_inverse(a ^ 1, modulus, degree)
+    t2 = _gf_mul(s, inv_ap1, modulus, degree)
+    t = _gf_square(_gf_square(t2, modulus, degree), modulus, degree)
+    if t:
+        candidates.add(
+            _gf_mul(core_target, _subfield_inverse(t, modulus, degree), modulus, degree)
+            ^ b
+        )
+    for x in candidates:
+        if x and verify(inst, {"x": _format_elem(x, degree)})[0]:
+            return True
+    return False
+
+
+def escalate(params: dict) -> dict | str | None:
+    p = {k: v for k, v in params.items() if k != "_preset"}
+    if not p.get("affine_mask", 0):
+        p["affine_mask"] = 1
+        return p
+    next_n = int(p["n"]) + 6
+    if next_n % 2 == 0:
+        next_n += 1
+    # n=37 is the largest q-half-trace route within the 300-operation cap.
+    if next_n <= 37:
+        p["n"] = next_n
+        return p
+    return None
+
+
+# ---------------------------------------------------------------------------
+# Mandatory gates
+
+
+def _json_atoms(value) -> int:
+    if isinstance(value, dict):
+        return sum(_json_atoms(v) for v in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_json_atoms(v) for v in value)
+    return 1
+
+
+def selftest() -> dict:
+    report = {"TRACK": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
+
+    g1_checks = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_checks += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": why})
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "checks": g1_checks,
+        "failures": g1_failures,
+    }
+
+    shipping = make_instance(seed=20250624, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    degree = shipping["field_degree"]
+    raw = shipping["answer"]["x"]
+    body = raw[2:]
+    if len(set(body)) > 1:
+        i = next(i for i in range(1, len(body)) if body[i] != body[0])
