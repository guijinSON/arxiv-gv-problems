+    out = dict(inst)
+    out["vertices"] = sorted(new)
+    out["anchors"] = [mapping[v] for v in inst["anchors"]]
+    out["trace_edges"] = edges
+    out["answer"] = [mapping[v] for v in inst["answer"]]
+    return out
