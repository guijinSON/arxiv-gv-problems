+
+    # G1: all named presets, multiple seeds, JSON answers, and an independently
+    # constructed walk whose exact simplified support is the supplied graph.
+    g1_failures = []
+    g1_checks = 0
+    realization_checks = 0
+    for preset, params in DIFFICULTY.items():
