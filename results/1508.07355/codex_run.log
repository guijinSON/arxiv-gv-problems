+            "complexity": "exponential worst case, O(n+m) work per search node",
+            "node_cap_each": 1_000_000,
+            "median_nodes": median_nodes,
+            "total_nodes": sum(row["nodes"] for row in reference_rows),
+            "operations": median_ref_operations,
