+)
+PLACEBO_HINT: str = (
+    "The four anchored labels make the required orientation and starting point unambiguous."
+)
+
+_MODULUS = 1_000_003
+_SELFTEST_SEEDS = tuple(range(8))
+_ENUMERATION_CAP = 100_000
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
