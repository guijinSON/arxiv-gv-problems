+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON list of exactly n distinct displayed integer vertex labels. "
+        "The first four entries equal the four ordered anchors, every displayed "
+        "vertex occurs once, and n is at most 240."
+    ),
+    "bounds": {
+        "length": "n",
