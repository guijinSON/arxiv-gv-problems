+            if transformed["trace_edges"] != original["trace_edges"]:
+                nontrivial_checks += 1
+    report["G8_canonical_key"] = {
+        "pass": not key_failures
+        and invariance_checks == 60
+        and transport_checks == 60
+        and nontrivial_checks >= 40
+        and len(set(unrelated_keys)) == 20,
