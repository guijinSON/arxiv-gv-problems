+    for i, row in enumerate(rows):
+        if row not in candidate_set:
+            return False, f"row_not_displayed:{i}"
+    for i in range(12):
+        for j in range(i):
+            dot = _dot(rows[i], rows[j])
+            if dot not in (-2, 2):
