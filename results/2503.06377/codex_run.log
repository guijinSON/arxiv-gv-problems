+def _compatibility_bits(inst: dict) -> tuple[list[int], int]:
+    candidates = [tuple(row) for row in inst["candidates"]]
+    adjacency = [0] * len(candidates)
+    scalar_operations = 0
+    for i in range(len(candidates)):
+        for j in range(i):
+            dot = 0
+            for x, y in zip(candidates[i], candidates[j]):
+                dot += x * y
+                scalar_operations += 2
+            if abs(dot) == 2:
+                adjacency[i] |= 1 << j
+                adjacency[j] |= 1 << i
