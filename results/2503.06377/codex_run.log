/bin/bash -lc "python3 - <<'PY'
import time
import gen_2503_06377 as m
i=m.make_instance(n=126,seed=20250306377,crowding=1)
# Collapse switching mates; multiplicity weights count displayed answers.
by={}
for row in i['candidates']:
 c=m._line_class(row); by.setdefault(c,[]).append(row)
vs=sorted(by)
adj=[0]*len(vs)
for a in range(len(vs)):
 for b in range(a):
  if m._compatible(vs[a],vs[b]):
   adj[a]|=1<<b; adj[b]|=1<<a
nodes=0
start=time.perf_counter()
def visit(chosen,cands,weight):
 global nodes
 nodes+=1
 need=12-chosen
 if need==0:return weight
 if cands.bit_count()<need:return 0
 total=0
 rem=cands
 while rem:
  bit=rem & -rem; v=bit.bit_length()-1; rem-=bit
  total += visit(chosen+1, rem & adj[v], weight*len(by[vs[v]]))
 return total
count=visit(0,(1<<len(vs))-1,1)
print('classes',len(vs),'answers',count,'nodes',nodes,'seconds',time.perf_counter()-start)
print('space',m.search_space(i),'density',count/m.search_space(i))
