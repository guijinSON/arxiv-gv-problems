import json
import gen_2503_06377 as g
p = g.DIFFICULTY['easy']
a = g.make_instance(seed=123, **p)
b = g.make_instance(seed=123, **p)
assert a == b
stripped = {k:v for k,v in a.items() if k "'!= '"'answer'}
assert g.verify(stripped, a['answer']) == (True, 'ok')
assert g.parse_answer('garbage') is None
assert g.parse_answer('<answer>not-json</answer>') is None
assert json.loads(json.dumps(a['answer'])) == a['answer']
assert g.parse_answer('<answer>'+json.dumps(a['answer'])+'</answer>') == a['answer']
print(json.dumps({
  'deterministic': a == b,
  'verify_without_answer_field': g.verify(stripped, a['answer']),
  'render_chars': len(g.render(a)),
  'answer_chars': len(json.dumps(a['answer'])),
  'candidate_rows': len(a['candidates']),
  'canonical_key': g.canonical_key(a),
}, indent=2))
