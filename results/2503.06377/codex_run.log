+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample a 12-row set from the displayed, shape-valid rows."""
+
+    rows = rng.sample(inst["candidates"], 12)
+    return [list(row) for row in sorted(rows)]
+
+
+def search_space(inst: dict) -> int:
+    """The exact number of 12-subsets sampled by random_candidate."""
+
+    return math.comb(len(inst["candidates"]), 12)
