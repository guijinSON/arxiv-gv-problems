+    symmetries = [
+        list(_conjugate(tuple(symmetry), coordinate_t))
+        for symmetry in inst["symmetries"]
+    ]
+    changed = {
+        "n": inst["n"],
+        "candidates": candidates,
+        "symmetries": symmetries,
+        "answer": answer,
+    }
+    return changed, answer
