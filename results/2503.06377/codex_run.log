+        vertices = [i for i in range(len(adjacency)) if available & (1 << i)]
+        scores = [(adjacency[i] & available).bit_count() for i in vertices]
+        best = max(scores)
+        tied = [i for i, score in zip(vertices, scores) if score == best]
+        if rng is None:
+            vertex = max(tied, key=lambda i: tuple(inst["candidates"][i]))
+        else:
