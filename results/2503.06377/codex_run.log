+# Definition 5.2, converted from the paper's 1-based notation to 0-based sets.
+_I0 = (
+    frozenset((1, 2, 3, 4, 6)),
+    frozenset((1, 2, 3, 5, 7)),
+    frozenset((1, 2, 3, 8, 9)),
+    frozenset((0, 2, 3, 7, 9)),
+    frozenset((0, 2, 3, 4, 8)),
+    frozenset((0, 2, 3, 5, 6)),
+    frozenset((0, 1, 3, 6, 8)),
