+    by_class = {_line_class(row): row for row in candidates}
+    cyclic = inst["symmetries"][1]
+    used: set[tuple[int, ...]] = set()
+    chosen: list[tuple[int, ...]] = []
+    for seed in sorted(candidates):
+        cls = _line_class(seed)
+        if cls in used:
+            continue
+        orbit = []
+        current = cls
+        for _ in range(4):
