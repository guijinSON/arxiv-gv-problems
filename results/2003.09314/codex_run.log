import random,time,statistics

def make(k,t,seed,nonce=0):
 rng=random.Random((seed+1)*1000003+nonce)
 # random positive composition via cutpoints; avoid singleton planted blocks
 while True:
  cuts=sorted(rng.sample(range(2,k-1),t-1)); pts=[0]+cuts+[k]
  if min(pts[i+1]-pts[i] for i in range(t))>=2:break
 L=[pts[i+1]**2-pts[i]**2 for i in range(t)]
 order=list(range(t));rng.shuffle(order); T=[L[i] for i in order]
 groups=[]
 for old in order:
  groups.append(list(range(pts[old],pts[old+1])))
 return T,groups,pts,order

def valid(k,T,groups):return sorted(sum(groups,[]))==list(range(k)) and all(sum(2*r+1 for r in groups[c])==T[c] for c in range(len(T)))

def greedy(k,T,mode):
 rem=T[:];G=[[] for _ in T]
 for r in range(k-1,-1,-1):
  w=2*r+1; opts=[c for c,x in enumerate(rem) if x>=w]
  if not opts:return None
  if mode=='best':c=min(opts,key=lambda z:(rem[z]-w,z))
  elif mode=='largest':c=max(opts,key=lambda z:(rem[z],-z))
  elif mode=='smallest':c=min(opts,key=lambda z:(rem[z],z))
  rem[c]-=w;G[c].append(r)
 return G if not any(rem) else None

def contiguous(k,T):
 # sort components by length and give near-equal blocks by ascending radii
 t=len(T); q,z=divmod(k,t);pts=[0]
 for i in range(t):pts.append(pts[-1]+q+(i<z))
 blocks=[list(range(pts[i],pts[i+1])) for i in range(t)]
 sums=[sum(2*r+1 for r in b) for b in blocks]
 G=[None]*t;used=set()
 for c,x in enumerate(T):
  opts=[i for i,s in enumerate(sums) if s==x and i not in used]
  if not opts:return None
  G[c]=blocks[opts[0]];used.add(opts[0])
 return G

def rr(k,T):
 t=len(T);G=[[r for r in range(k) if r%t==c] for c in range(t)]
 # try matching group sums to targets
 sums=[sum(2*r+1 for r in g) for g in G];out=[None]*t;used=set()
 for c,x in enumerate(T):
  o=[i for i,s in enumerate(sums) if s==x and i not in used]
  if not o:return None
  out[c]=G[o[0]];used.add(o[0])
 return out

def randgreedy(k,T,seed,restarts=64):
 rng=random.Random(seed)
 for _ in range(restarts):
  rem=T[:];G=[[] for _ in T]
  radii=list(range(k));radii.sort(reverse=True)
  for r in radii:
   w=2*r+1;opts=[c for c,x in enumerate(rem) if x>=w]
   if not opts:break
   # random among 3 tightest
   opts.sort(key=lambda c:rem[c]-w);pool=opts[:min(3,len(opts))];c=rng.choice(pool)
   rem[c]-=w;G[c].append(r)
  else:
   if not any(rem):return G
 return None

def solve(k,T,cap):
 weights=list(range(2*k-1,0,-2));memo=set();nodes=ops=0
 def dfs(i,rem):
  nonlocal nodes,ops
  nodes+=1
  if nodes>cap:return False
  if i==k:return [] if not any(rem) else None
  key=(i,rem)
  if key in memo:return None
  w=weights[i];seen=set()
  for c in sorted(range(len(T)),key=lambda z:(rem[z],z)):
   ops+=1
   if rem[c]<w or rem[c] in seen:continue
   seen.add(rem[c]);q=list(rem);q[c]-=w
   z=dfs(i+1,tuple(q))
   if z is False:return False
   if isinstance(z,list):return [c]+z
  memo.add(key);return None
 st=time.perf_counter();z=dfs(0,tuple(T));return z,nodes,ops,time.perf_counter()-st

for k in (37,41,45):
 costs=[]; survivors=[]
 for seed in range(100):
  T,G,pts,o=make(k,5,seed)
  cheap=[]
  for m in ('best','largest','smallest'): 
   z=greedy(k,T,m);cheap.append(z is not None and valid(k,T,z))
  for z in (contiguous(k,T),rr(k,T),randgreedy(k,T,seed,128)):
   cheap.append(z is not None and valid(k,T,z))
  z,n,ops,wall=solve(k,T,100000)
  hard=(z is False)
  costs.append(n)
  if hard and not any(cheap):survivors.append((seed,T,pts,n))
 print(k,'survive',len(survivors),'nodes med/max',statistics.median(costs),max(costs),'first',survivors[:5])
 # full solve first 8 surv
 for row in survivors[:3]:
  z,n,o,w=solve(k,row[1],5000000);print(' full',row[0],n,o,round(w,3),z is not False and z is not None)
