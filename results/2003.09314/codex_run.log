+        "baseline_algorithm": reference["name"],
+        "baseline_total_wall_clock_sec": reference["wall_clock_sec"],
+        "baseline_total_nodes": reference["nodes"],
+        "baseline_total_operations": reference["operations"],
+    }
+
+    ladder = []
