+        "filter_max_nodes": 250_000,
+        "random_restarts": 32,
+    },
+    "medium": {
+        "n": 45,
+        "components": 8,
+        "filter_min_nodes": 15_000,
+        "filter_max_nodes": 500_000,
+        "random_restarts": 64,
