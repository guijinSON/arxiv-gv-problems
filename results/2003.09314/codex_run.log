+def _square_prefix_certificate(inst: dict) -> tuple[list[list[int]] | None, int]:
+    """Recover the telescoping block certificate, using only public data."""
+    lengths = inst["lengths"]
+    t = len(lengths)
+    used: set[int] = set()
+    order: list[tuple[int, int, int]] = []
+    total = 0
+    operations = 0
+    for _ in range(t):
+        matches: list[tuple[int, int]] = []
+        for component, length in enumerate(lengths):
+            if component in used:
