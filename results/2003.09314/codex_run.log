+        "baseline_total_nodes": reference["nodes"],
+        "baseline_total_operations": reference["operations"],
+    }
+
+    ladder = []
+    for name, params in DIFFICULTY.items():
+        sample = make_instance(seed=2, **params)
+        ladder.append(
