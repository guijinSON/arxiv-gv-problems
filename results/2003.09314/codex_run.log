  print(name,'ok',round(time.perf_counter()-t,3),x['selection_attempts'],x['lengths'],x['reference_filter_metrics'],'compact',ops,g.verify(x,c))
 except Exception as e:print(name,'FAIL',round(time.perf_counter()-t,3),type(e).__name__,e)
