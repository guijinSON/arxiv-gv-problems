+    reference = {
+        "name": "memoized fixed-bin path-forest dynamic program",
+        "complexity": "O(k*t*product_c(L_c+1)); polynomial for fixed t",
+        "successes": 0,
+        "attempts": 0,
+        "nodes": 0,
+        "operations": 0,
+        "wall_clock_sec": 0.0,
+        "per_seed": [],
+    }
+    for seed in range(800, 808):
+        current = make_instance(seed=seed, **shipping)
+
