+        "exact integer interval endpoints",
+        "exact component-length sums",
+        "exact graph-distance comparisons within paths",
+        "exact replay of fire-ball coverage",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
