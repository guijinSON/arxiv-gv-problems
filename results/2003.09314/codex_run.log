+    "hinted_verdict": "unavailable_http_403_key_limit",
+    "intended_route_operations": 231,
+    "pass": true,
+    "within_caps": true
+  },
+  "all_passed": true,
+  "shipping_difficulty": "easy",
+  "shipping_params": {
+    "components": 8,
+    "filter_max_nodes": 250000,
+    "filter_min_nodes": 5000,
+    "n": 37,
+    "random_restarts": 32
+  },
+  "track": "B"
+}

