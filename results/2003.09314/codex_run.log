+    },
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Radii congruent modulo t+4 are never split between different components."
+)
+PLACEBO_HINT = (
+    "The component lengths and radius indices reward consistently careful bookkeeping."
+)
+
+CERTIFICATE_LANGUAGE = {
