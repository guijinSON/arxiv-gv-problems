 return adj,N,len(edges)

def dsatur(adj,lim=1000000):
 n=len(adj); C=[-1]*n; nodes=0
 root=max(range(n),key=lambda x:len(adj[x])); C[root]=0
 def rec(done):
  nonlocal nodes
  if done==n:return True
  if nodes>=lim:return False
  nodes+=1
  best=max((v for v in range(n) if C[v]<0),key=lambda v:(len({C[w] for w in adj[v] if C[w]>=0}),len(adj[v])))
  used={C[w] for w in adj[best] if C[w]>=0}
  for cc in range(3):
   if cc not in used:
    C[best]=cc
    if rec(done+1):return True
  C[best]=-1
  return False
 t=time.perf_counter();ok=rec(1);return ok,nodes,time.perf_counter()-t
