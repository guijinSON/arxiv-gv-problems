#!/usr/bin/env bash
# Submit a finished paper.  Usage: scripts/submit.sh <arxiv_id>
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
ID="${1:?usage: scripts/submit.sh <arxiv_id> [--reject]}"
REJECT=""; [ "${2:-}" = "--reject" ] && REJECT=1
D="results/$ID"
