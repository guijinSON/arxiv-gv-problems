def _is_int(value: object) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def _is_prime(n: int) -> bool:
    if n < 2:
        return False
    if n % 2 == 0:
        return n == 2
    d = 3
    while d * d <= n:
        if n % d == 0:
            return False
        d += 2
    return True


def _checked_param(name: str, value: object, low: int, high: int) -> int:
    if not _is_int(value) or not low <= value <= high:
        raise ValueError(f"{name} must be an integer in {low}..{high}")
    return int(value)


def _permutation(n: int, rng: random.Random) -> list[int]:
    values = list(range(n))
    rng.shuffle(values)
    return values


def _cell_lookup(inst: dict) -> dict[int, dict]:
    key = id(inst)
    cached = _CELL_LOOKUP_CACHE.get(key)
    if cached is not None and cached[0] is inst:
        return cached[1]
    result = {cell["id"]: cell for cell in inst["cells"]}
    if len(_CELL_LOOKUP_CACHE) >= 128:
        _CELL_LOOKUP_CACHE.clear()
    _CELL_LOOKUP_CACHE[key] = (inst, result)
    return result


def _field_inverse(value: int, prime: int) -> int:
    """The permutation inverse on F_p, extended by inv(0)=0."""
    value %= prime
    return 0 if value == 0 else pow(value, prime - 2, prime)


def _answer_value(answer: dict, cell: dict, n: int,
                  coordinates: dict) -> int:
    r = coordinates["row_labels"][cell["row"]]
    c = coordinates["column_labels"][cell["column"]]
    z = (r + answer["v"] * c + answer["w"]) % n
    return 1 + (answer["a"] * _field_inverse(z, n) + answer["b"]) % n


def _make_row_signs(cells: list[dict], answer: dict, coordinates: dict, n: int,
def _make_row_signs(cells: list[dict], answer: dict, coordinates: dict, n: int,
                    rng: random.Random) -> list[dict]:
    """Encode sgn(A_pi x) in the paper's upper-triangular pair order."""
    by_row: list[list[dict]] = [[] for _ in range(n)]
    for cell in cells:
        by_row[cell["row"]].append(cell)
    records = []
    for group in range(n):
        ordered = by_row[group][:]
        rng.shuffle(ordered)
        ids = [cell["id"] for cell in ordered]
        values = [_answer_value(answer, cell, n, coordinates) for cell in ordered]
        upper = []
        for i, left in enumerate(values):
            upper.append("".join(
                ">" if left > right else "<" for right in values[i + 1:]
            ))
        records.append({"group": group, "order": ids, "upper": upper})
    rng.shuffle(records)
    return records


def _make_probe_rows(cells: list[dict], probes: list[int], answer: dict,
                     coordinates: dict, n: int, rng: random.Random) -> list[dict]:
    """Redundant full rows for four cells; these keep the compact route writable."""
    lookup = {cell["id"]: cell for cell in cells}
    by_row: dict[int, list[dict]] = {}
    for cell in cells:
        by_row.setdefault(cell["row"], []).append(cell)
    records = []
    for index, cell_id in enumerate(probes):
        probe = lookup[cell_id]
        peers = by_row[probe["row"]][:]
        rng.shuffle(peers)
        values = [_answer_value(answer, cell, n, coordinates) for cell in peers]
        probe_value = _answer_value(answer, probe, n, coordinates)
        records.append({
            "probe": index,
            "cell": cell_id,
            "order": [cell["id"] for cell in peers],
            "signs": "".join(
                "=" if cell["id"] == cell_id
                else ">" if probe_value > value else "<"
                for cell, value in zip(peers, values)
            ),
        })
    return records


def make_instance(n: int, seed: int = 0, **params) -> dict:
    """Inverse-generate a certified generalized-Sudoku comparison instance."""
    n = _checked_param("n", n, 7, 257)
    if not _is_prime(n):
        raise ValueError("n must be a prime at least 7")
    givens = _checked_param("givens", params.pop("givens", 0), 0, n * n)
    if params:
        raise ValueError("unknown parameters: " + ", ".join(sorted(params)))
    if not _is_int(seed):
        raise ValueError("seed must be an integer")
    rng = random.Random(seed)

    # Hidden coordinate -> displayed group ID.
    row_name = _permutation(n, rng)
    column_name = _permutation(n, rng)
    region_name = _permutation(n, rng)
    cell_name = _permutation(n * n, rng)

    # These ranges make the inner form bijective on all three parallel classes
    # and keep b away from the four probe output residues used below.
    answer = {
        "v": rng.randrange(2, n),
        "w": rng.randrange(n),
        "a": rng.randrange(1, n),
        "b": rng.randrange(4, n),
    }

    row_labels = [0] * n
    column_labels = [0] * n
    region_labels = [0] * n
    for coordinate, shown in enumerate(row_name):
        row_labels[shown] = coordinate
    for coordinate, shown in enumerate(column_name):
        column_labels[shown] = coordinate
    for coordinate, shown in enumerate(region_name):
        region_labels[shown] = coordinate
    coordinates = {
        "row_labels": row_labels,
        "column_labels": column_labels,
        "region_labels": region_labels,
    }

    cells = []
    hidden_to_id = {}
    for r in range(n):
        for c in range(n):
            old_id = r * n + c
            cell_id = cell_name[old_id]
            hidden_to_id[(r, c)] = cell_id
            cells.append({
                "id": cell_id,
                "row": row_name[r],
                "column": column_name[c],
                "region": region_name[(r + c) % n],
            })
    rng.shuffle(cells)

    anchors = {
        "origin": hidden_to_id[(0, 0)],
        "row_unit": hidden_to_id[(1, 0)],
        "column_unit": hidden_to_id[(0, 1)],
    }
    anchor_groups = {
        "origin": {
            "row": row_name[0], "column": column_name[0], "region": region_name[0]
        },
        "row_unit": {
            "row": row_name[1], "column": column_name[0], "region": region_name[1]
        },
        "column_unit": {
            "row": row_name[0], "column": column_name[1], "region": region_name[1]
        },
    }

    # Probe i is chosen with hidden column i and represented residue i.  Since
    # b is not 0,1,2,3, its inner argument is nonzero and is determined exactly.
    probes = []
    for represented in range(4):
        c = represented
        z = answer["a"] * _field_inverse(represented - answer["b"], n) % n
        r = (z - answer["v"] * c - answer["w"]) % n
        probes.append(hidden_to_id[(r, c)])

    candidates = [cell for cell in cells
                  if cell["id"] not in set(anchors.values()) | set(probes)]
    rng.shuffle(candidates)
    given_cells = [
        {"cell": cell["id"],
         "value": _answer_value(answer, cell, n, coordinates)}
        for cell in candidates[:givens]
    ]
    given_cells.sort(key=lambda item: item["cell"])

    row_signs = _make_row_signs(cells, answer, coordinates, n, rng)
    probe_rows = _make_probe_rows(cells, probes, answer, coordinates, n, rng)
    return {
        "paper": "arXiv:1210.6343",
        "family": "affine generalized-Sudoku sign reconstruction",
        "n": n,
        "cells": cells,
        "anchors": anchors,
        "anchor_groups": anchor_groups,
        "probes": probes,
        "probe_rows": probe_rows,
        "givens": given_cells,
        "row_signs": row_signs,
        "answer": answer,
    }


def render(inst: dict) -> str:
    """Render a self-contained statement and an exact JSON output contract."""
    n = inst["n"]
    cells = _cell_lookup(inst)
    signs_by_group = {entry["group"]: entry for entry in inst["row_signs"]}
    lines = [
        "Recover a compact exact solution of this generalized Sudoku.",
        "",
        "Definitions and instance semantics.",
        f"There are {n * n} cells and {n} symbols, the integers 1 through {n}.",
        f"Cell IDs and all group IDs are 0-indexed integers from 0 through {n - 1}",
        f"for groups, and 0 through {n * n - 1} for cells.",
        "Each cell belongs to one R (row), one C (column), and one B (region) group.",
        f"Every group has exactly {n} cells. A generalized-Sudoku solution assigns",
        f"each group the complete set {{1,...,{n}}}, with no repeats.",
        "",
        "For every R group, an ORDER and exact upper-triangular comparisons are",
        "supplied. On line i (0-indexed), the sign string compares ORDER[i] with",
        "ORDER[i+1],...,ORDER[n-1], in that order. Thus its length is n-i-1.",
        "'>' means ORDER[i]'s solution value is greater and '<' means smaller.",
        "Together these are exactly the paper's comparison vector sgn(A_pi x).",
        "",
        "The incidence data has a unique normalized coordinate system over the",
        "field of residues modulo n. Write its labels as rlabel[R], clabel[C],",
        "blabel[B]. The named anchors impose: the origin's R,C,B labels are 0;",
        "the row-unit's R and B labels are 1; and the column-unit's C and B labels",
        "are 1. Every cell then obeys blabel[B] = rlabel[R]+clabel[C] modulo n.",
        "You may derive these labels, but you do not output them.",
        "",
        "Your witness must be exactly one JSON object with keys v,w,a,b. They obey",
        "2<=v<n, 0<=w<n, 1<=a<n, and 4<=b<n. For a residue z, define inv(0)=0",
        "and inv(z) as the unique residue q in 1,...,n-1 with z*q=1 modulo n.",
        "The represented cell value is",
        "  1 + ((a*inv(rlabel[R] + v*clabel[C] + w) + b) modulo n).",
        "It must satisfy every displayed comparison, every given, and all three",
        "generalized-Sudoku partitions. Integers are written in ordinary decimal.",
        "",
        "ANCHORS",
        f"origin={inst['anchors']['origin']}",
        f"row_unit={inst['anchors']['row_unit']}",
        f"column_unit={inst['anchors']['column_unit']}",
        "END_ANCHORS",
        "",
        "DISTINGUISHED PROBES (P-index:cell; these add no constraint)",
    ]
    for index, cell_id in enumerate(inst["probes"]):
        lines.append(f"P{index}:{cell_id}")
    lines.extend([
        "END_PROBES",
        "",
        "REDUNDANT PROBE COMPARISON ROWS",
        "Each SIGNS string compares the named probe with every cell in its ORDER;",
        "'=' marks the probe itself. These rows repeat information from the upper",
        "triangles and exist so that four ranks can be read without bulk expansion.",
    ])
    for entry in sorted(inst["probe_rows"], key=lambda item: item["probe"]):
        lines.append(f"P{entry['probe']} CELL {entry['cell']}")
        lines.append("ORDER " + ",".join(str(x) for x in entry["order"]))
        lines.append("SIGNS " + entry["signs"])
    lines.extend([
        "END_PROBE_ROWS",
        "",
        "GIVENS (cell:value; an empty block means there are none)",
    ])
    for given in inst["givens"]:
        lines.append(f"{given['cell']}:{given['value']}")
    lines.extend(["END_GIVENS", "", "CELL PARTITIONS AND ROW COMPARISONS"])
    for group in range(n):
        entry = signs_by_group[group]
        order = entry["order"]
        triples = []
        for cell_id in order:
            cell = cells[cell_id]
            triples.append(f"{cell_id}:{cell['column']}:{cell['region']}")
        lines.append(f"R {group} CELLS cell:C:B " + " ".join(triples))
        lines.append("ORDER " + ",".join(str(cell_id) for cell_id in order))
        for index, (cell_id, suffix) in enumerate(zip(order, entry["upper"])):
            lines.append(f"U{index} {cell_id} {suffix or '-'}")
        lines.append(f"END_R {group}")
    lines.extend([
        "END_INSTANCE",
        "",
        "Give your final answer inside <answer></answer> tags as the JSON object above.",
        "Example syntax (the numbers below are only a format example):",
        '<answer>{"v":2,"w":0,"a":1,"b":4}</answer>',
        "Output nothing else inside the tags.",
    ])
    mode = os.environ.get("GV_HINT_MODE")
    if mode == "structural":
        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
    elif mode == "placebo":
        lines.extend(["", "Hint: " + PLACEBO_HINT])
    return "\n".join(lines)


def parse_answer(text: object) -> object | None:
    """Extract the tagged JSON witness, tolerating prose and Markdown fences."""
    try:
        if not isinstance(text, str):
            return None
        match = _ANSWER_RE.search(text)
        if not match:
            return None
        body = match.group(1).strip()
        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
        body = re.sub(r"\s*```$", "", body).strip()
        value = json.loads(body)
        return value if isinstance(value, dict) else None
    except (TypeError, ValueError, json.JSONDecodeError):
        return None


_ANSWER_KEYS = {"v", "w", "a", "b"}
_COORD_CACHE: dict[int, tuple[dict, dict | None]] = {}
_PROBE_RANK_CACHE: dict[int, tuple[dict, tuple[int | None, ...]]] = {}


def _bounded_cache_put(cache: dict, key: int, value: tuple) -> None:
    if len(cache) >= 128:
        cache.clear()
    cache[key] = value


def _cached_coordinates(inst: dict) -> dict | None:
    key = id(inst)
    cached = _COORD_CACHE.get(key)
    if cached is not None and cached[0] is inst:
        return cached[1]
    result = _coordinate_labels(inst)
    _bounded_cache_put(_COORD_CACHE, key, (inst, result))
    return result


def _cached_probe_ranks(inst: dict) -> tuple[int | None, ...]:
    key = id(inst)
    cached = _PROBE_RANK_CACHE.get(key)
    if cached is not None and cached[0] is inst:
        return cached[1]
    result = tuple(_rank_one(inst, cell_id) for cell_id in inst.get("probes", ()))
    _bounded_cache_put(_PROBE_RANK_CACHE, key, (inst, result))
    return result


def verify(inst: dict, answer: object) -> tuple[bool, str]:
    """Check any compressed witness exactly, without consulting inst['answer']."""
    n = inst["n"]
    if answer == [] or answer == {}:
