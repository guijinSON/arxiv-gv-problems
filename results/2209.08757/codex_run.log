            return False, f"coefficient {key} must be an integer"
    if not 2 <= answer["v"] < n:
        return False, f"coefficient v must lie in 2..{n - 1}"
    if not 0 <= answer["w"] < n:
        return False, f"coefficient w must lie in 0..{n - 1}"
    if not 1 <= answer["a"] < n:
        return False, f"coefficient a must lie in 1..{n - 1}"
    if not 4 <= answer["b"] < n:
        return False, f"coefficient b must lie in 4..{n - 1}"

    coordinates = _cached_coordinates(inst)
    if coordinates is None:
        return False, "instance incidence has no normalized additive coordinates"

    values: dict[int, int] = {}
    cells = _cell_lookup(inst)

    # Named low-rank probes make wrong random coefficients reject in constant
    # expected time.  Their expected ranks are read from the instance signs,
    # never from inst['answer'] or from a construction-only field.
    probe_ranks = _cached_probe_ranks(inst)
    if len(probe_ranks) != 4 or any(rank is None for rank in probe_ranks):
        return False, "instance does not contain four readable probes"
    for index, (cell_id, rank) in enumerate(zip(inst["probes"], probe_ranks)):
        if cell_id not in cells:
            return False, f"probe P{index} names an absent cell"
        if _answer_value(answer, cells[cell_id], n, coordinates) != rank:
            return False, f"probe P{index} has the wrong comparison rank"

    for cell in inst["cells"]:
        values[cell["id"]] = _answer_value(answer, cell, n, coordinates)

    for given in inst["givens"]:
