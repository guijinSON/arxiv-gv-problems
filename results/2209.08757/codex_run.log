+def _conjugacy_invariant(matrix: tuple[int, int, int, int], q: int) -> int:
+    a, _b, _c, d = matrix
+    determinant = _mat_det(matrix, q)
+    return (a + d) ** 2 * pow(determinant, -1, q) % q
