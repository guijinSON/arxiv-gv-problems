+    if len(finite) < 2 or finite[0][0] == finite[1][0]:
+        return None
+    x0, y0 = finite[0]
+    x1, y1 = finite[1]
+    slope = (y1 - y0) * pow((x1 - x0) % q, -1, q) % q
+    if slope == 0:
+        return None
+    intercept = (y0 - slope * x0) % q
+    return _matrix_json(_mat_normalize((slope, intercept, 0, 1), q))
