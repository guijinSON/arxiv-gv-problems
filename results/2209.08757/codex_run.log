+        "unrelated_attempts": 20,
+        "transformations": [
+            "candidate-path reordering",
+            "independent left/right PGL coordinate changes",
+            "exchange of left and right leaf families",
+            "composition of PGL relabelling, side exchange, and reordering",
+        ],
+    }
