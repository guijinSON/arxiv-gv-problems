            and answer[0] == answer[1]):
        return False, "duplicated witness container is not a JSON object"
    if not isinstance(answer, dict):
        return False, "malformed answer: expected one JSON object"
    if set(answer) != _ANSWER_KEYS:
        missing = sorted(_ANSWER_KEYS - set(answer))
        extra = sorted(set(answer) - _ANSWER_KEYS)
        return False, f"malformed answer keys: missing={missing}, extra={extra}"
    for key in ("v", "w", "a", "b"):
