+def _checked_prime(value: object) -> int:
+    if not _is_int(value) or not 5 <= value <= 200_003:
+        raise ValueError("n must be a prime integer in 5..200003")
+    value = int(value)
+    if not _is_prime(value):
+        raise ValueError("n must be prime")
+    return value
