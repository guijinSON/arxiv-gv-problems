import random,time,math

def make(n,k,seed,p):
 rng=random.Random(seed); plant=[rng.randrange(n) for _ in range(k)]
 adj=[[None]*k for _ in range(k)]
 for i in range(k):
  adj[i][i]=[0]*n
 for i in range(k):
  for j in range(i+1,k):
   ai=[0]*n; aj=[0]*n
   for u in range(n):
    bits=0
    for v in range(n):
     if rng.random()<p or (u==plant[i] and v==plant[j]):
      bits|=1<<v; aj[v]|=1<<u
    ai[u]=bits
   adj[i][j]=ai; adj[j][i]=aj
 return plant,adj

def solve(n,k,adj,cap,ordering=True):
 full=(1<<n)-1; nodes=0; assign=[-1]*k
 def rec(domains,left):
  nonlocal nodes
  if not left:return assign[:]
  c=min(left,key=lambda z:domains[z].bit_count())
  bits=domains[c]
  if not bits:return None
  vals=[]
  while bits:
   b=bits&-bits;bits-=b;v=b.bit_length()-1
   score=0
   if ordering:
    for j in left:
     if j"'!=c: score+=(adj[c][j][v]&domains[j]).bit_count()
   vals.append((-score,v))
  vals.sort()
  newleft=[x for x in left if x!=c]
  for _,v in vals:
   nodes+=1
   if nodes>cap:return None
   nd=domains[:]; ok=True
   for j in newleft:
    nd[j]&=adj[c][j][v]
    if not nd[j]:ok=False;break
   if ok:
    assign[c]=v
    r=rec(nd,newleft)
    if r is not None:return r
  assign[c]=-1
  return None
 t=time.perf_counter();ans=rec([full]*k,list(range(k)))
 return ans,nodes,time.perf_counter()-t
for k,n in [(14,64),(15,64),(16,64),(16,48),(16,80)]:
 p=0.9*n**(-2/(k-1))
 print('"'\\n',k,n,p)
 for s in range(8):
  plant,adj=make(n,k,9000+s,p)
  ans,nodes,dt=solve(n,k,adj,2_000_000,True)
  print(s,nodes,round(dt,3),ans==plant,ans is not None)
