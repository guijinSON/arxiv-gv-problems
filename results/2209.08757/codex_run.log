+except ImportError:  # pragma: no cover - this family has a stdlib-only path
+    exact_matrices = rationals = None
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_field",
+    "computational_core": "graph",
