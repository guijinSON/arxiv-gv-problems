+def _is_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _is_prime(n: int) -> bool:
+    if n < 2:
+        return False
+    if n % 2 == 0:
+        return n == 2
+    divisor = 3
+    while divisor * divisor <= n:
+        if n % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(n: int) -> int:
+    candidate = max(5, n)
+    if candidate % 2 == 0:
+        candidate += 1
+    while not _is_prime(candidate):
+        candidate += 2
