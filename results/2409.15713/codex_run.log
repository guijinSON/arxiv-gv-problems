+    if isinstance(weight_sum, bool) or not isinstance(weight_sum, int):
+        raise ValueError("weight_sum must be an integer")
+    if weight_sum < 8 or weight_sum & (weight_sum - 1):
+        raise ValueError("weight_sum must be a power of two at least 8")
+    if weight_sum > 2**precision:
+        raise ValueError("weight_sum must divide the lattice denominator")
+
+    rng = random.Random(seed)
+    selectors = rng.sample(range(n), 3)
