+def _fib_pair(index: int, modulus: int) -> tuple[int, int]:
+    """Return (F_index, F_(index+1)) modulo modulus by fast doubling."""
+    if index < 0:
+        raise ValueError("negative Fibonacci index")
+    a, b = 0, 1
+    for bit in bin(index)[2:]:
+        c = (a * ((2 * b - a) % modulus)) % modulus
+        d = (a * a + b * b) % modulus
+        if bit == "0":
+            a, b = c, d
+        else:
+            a, b = d, (c + d) % modulus
+    return a, b
 
 
