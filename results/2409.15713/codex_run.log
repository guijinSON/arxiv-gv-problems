   489	def selftest() -> dict:
   490	    """Run all mandatory correctness, resistance, scaling, and audit gates."""
   491	    report: dict = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
   492	
   493	    # G1: every preset and several seeds, plus JSON-native answers.
   494	    planted_attempts = 0
   495	    planted_passes = 0
   496	    json_passes = 0
   497	    for preset, params in DIFFICULTY.items():
   498	        for seed in range(4):
   499	            inst = make_instance(seed=seed, **params)
   500	            planted_attempts += 1
   501	            planted_passes += int(verify(inst, inst["answer"])[0])
   502	            json_passes += int(json.loads(json.dumps(inst["answer"])) == inst["answer"])
   503	    report["G1_planted_verifies"] = {
   504	        "pass": planted_passes == planted_attempts == json_passes,
   505	        "verified": planted_passes,
   506	        "attempts": planted_attempts,
   507	        "json_native": json_passes,
   508	    }
   509	
   510	    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
   511	    sample = make_instance(seed=314159, **shipping_params)
   512	    good = sample["answer"]
   513	    corruptions = {}
   514	    corruptions["drop_one"] = good[:-1]
   515	    corruptions["swap_rows"] = [good[1], good[0], good[2]]
   516	    corruptions["duplicate_row"] = [good[0], good[0], good[2]]
   517	    corruptions["empty"] = []
   518	    out_of_range = json.loads(json.dumps(good))
   519	    out_of_range[0][0] = sample["simplex_denominator"] + 1
   520	    out_of_range = sorted(out_of_range)
   521	    corruptions["out_of_range"] = out_of_range
   522	    corruption_reasons = {
   523	        name: verify(sample, value)[1] for name, value in corruptions.items()
   524	    }
   525	    report["G2_rejects_corruption"] = {
   526	        "pass": (
   527	            all(not verify(sample, value)[0] for value in corruptions.values())
   528	            and len(set(corruption_reasons.values())) == len(corruptions)
   529	        ),
   530	        "cases": len(corruptions),
   531	        "reasons": corruption_reasons,
   532	    }
   533	
   534	    encoded = json.dumps(good, separators=(",", ":"))
   535	    response = (
   536	        "I followed the boundary transition.\n\n```text\n"
   537	        f"<answer>{encoded}</answer>\n```\nThat is my final triangle."
   538	    )
   539	    parsed = parse_answer(response)
   540	    report["G3_round_trip"] = {
   541	        "pass": parsed == good and verify(sample, parsed)[0],
   542	        "parsed": parsed == good,
   543	        "surrounding_prose": True,
   544	    }
   545	
   546	    # G4 and the shipping-density part of G5 share the required 200k uniform,
   547	    # structure-aware draws.
   548	    guess_rng = random.Random(8675309)
   549	    guess_total = 200000
   550	    guess_hits = 0
   551	    for _ in range(guess_total):
   552	        guess_hits += int(verify(sample, random_candidate(sample, guess_rng))[0])
   553	    guess_probability = guess_hits / guess_total
   554	    exact_density = 1.0 / search_space(sample)
   555	    report["G4_guess_resistance"] = {
   556	        "pass": guess_probability < 1e-6 and exact_density < 1e-6,
   557	        "hits": guess_hits,
   558	        "total": guess_total,
   559	        "observed_probability": guess_probability,
   560	        "exact_structure_aware_probability": exact_density,
   561	        "structure_aware_space": search_space(sample),
   562	    }
   563	
   564	    t0 = time.perf_counter()
   565	    terminal = _iterated_terminal_state(sample)
   566	    reference_wall = time.perf_counter() - t0
   567	    reference_ok = verify(
   568	        sample, _triangle_for_transition(sample, terminal + 1)
   569	    )[0]
   570	    report["G5_density_and_baseline_cost"] = {
   571	        "pass": reference_ok and exact_density < 1e-6,
   572	        "shipping_sampled_valid_fraction": guess_probability,
   573	        "shipping_density_samples": guess_total,
   574	        "shipping_density_hits": guess_hits,
   575	        "analytic_solution_count": 1,
   576	        "analytic_valid_fraction": exact_density,
   577	        "reference_wall_clock_seconds": reference_wall,
   578	        "reference_operation_count": 2 * sample["horizon"],
   579	        "reference_iterations": sample["horizon"],
   580	    }
   581	
   582	    attack_counts = {
   583	        "outlier_endpoints_midpoint": 0,
   584	        "greedy_one_recurrence_step": 0,
   585	        "linearized_ignore_multiplier": 0,
   586	        "obvious_fixed_point_ansatz": 0,
   587	        "random_restart_256": 0,
   588	    }
   589	    attack_attempts = 8
   590	    reference_successes = 0
   591	    reference_wall_total = 0.0
   592	    for seed in range(100, 100 + attack_attempts):
   593	        inst = make_instance(seed=seed, **shipping_params)
   594	        for name, guesses in _attack_guesses(inst).items():
   595	            solved = any(
   596	                verify(inst, _triangle_for_transition(inst, guess))[0]
   597	                for guess in guesses
   598	            )
   599	            attack_counts[name] += int(solved)
   600	        restart_rng = random.Random(seed ^ 0x5EEDFACE)
   601	        restart_solved = False
   602	        for _ in range(256):
   603	            if verify(inst, random_candidate(inst, restart_rng))[0]:
   604	                restart_solved = True
   605	                break
   606	        attack_counts["random_restart_256"] += int(restart_solved)
   607	
   608	        start = time.perf_counter()
   609	        terminal = _iterated_terminal_state(inst)
   610	        reference_wall_total += time.perf_counter() - start
   611	        reference_successes += int(verify(
   612	            inst, _triangle_for_transition(inst, terminal + 1)
   613	        )[0])
   614	    attacks = {
   615	        name: {"successes": successes, "attempts": attack_attempts}
   616	        for name, successes in attack_counts.items()
   617	    }
