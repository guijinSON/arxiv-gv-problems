+def _attack_guesses(inst: dict) -> dict[str, list[int]]:
+    modulus = inst["grid_total"]
+    a = inst["multiplier"]
+    b = inst["increment"]
+    s0 = inst["initial_state"]
+    horizon = inst["horizon"]
+    fixed = b * pow(1 - a, -1, modulus) % modulus
+    return {
+        "outlier_endpoints_midpoint": [1, (modulus + 1) // 2, modulus],
+        "greedy_one_recurrence_step": [1 + (a * s0 + b) % modulus],
+        "linearized_ignore_multiplier": [1 + (s0 + horizon * b) % modulus],
+        "obvious_fixed_point_ansatz": [1 + fixed],
+    }
 
 
