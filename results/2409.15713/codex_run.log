+def _next_state(inst: dict, state: int, t: int) -> int:
+    """One literal step of the recurrence displayed to the solver."""
+    modulus = inst["recurrence_modulus"]
+    gap = inst["pole_gap"]
+    multiplier = inst["cross_multiplier"]
