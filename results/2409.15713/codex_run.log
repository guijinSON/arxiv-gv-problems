   163	
   164	def _require_int(value, name: str, minimum: int | None = None) -> int:
   165	    if isinstance(value, bool) or not isinstance(value, int):
   166	        raise ValueError(f"{name} must be an integer")
   167	    if minimum is not None and value < minimum:
   168	        raise ValueError(f"{name} must be at least {minimum}")
   169	    return value
   170	
   171	
   172	def _terminal_state(inst: dict) -> int:
   173	    """Evaluate the public affine recurrence by the compact exact identity."""
   174	    modulus = inst["recurrence_modulus"]
   175	    multiplier = inst["multiplier"]
   176	    increment = inst["increment"]
   177	    initial = inst["initial_state"]
   178	    horizon = inst["horizon"]
   179	    fixed = increment * pow(1 - multiplier, -1, modulus) % modulus
   180	    return (fixed + pow(multiplier, horizon, modulus) * (initial - fixed)) % modulus
   181	
   182	
   183	def _iterated_terminal_state(inst: dict) -> int:
   184	    """Reference straight-line evaluation; deliberately does no compression."""
   185	    state = inst["initial_state"]
   186	    a = inst["multiplier"]
   187	    b = inst["increment"]
   188	    modulus = inst["recurrence_modulus"]
   189	    for _ in range(inst["horizon"]):
   190	        state = (a * state + b) % modulus
   191	    return state
   192	
   193	
   194	def _triangle_for_transition(inst: dict, transition: int) -> list[list[int]]:
   195	    """Return the canonical face-straddling triangle at edge ``transition``."""
   196	    total = inst["simplex_denominator"]
   197	    if not 1 <= transition <= inst["recurrence_modulus"]:
   198	        raise ValueError("transition must be in 1,...,recurrence_modulus")
   199	    interior_axis, traversal_axis, remaining_axis = inst["axis_order"]
   200	    low = [0, 0, 0]
   201	    high = [0, 0, 0]
   202	    inward = [0, 0, 0]
   203	    low[interior_axis] = 0
   204	    low[traversal_axis] = transition - 1
   205	    low[remaining_axis] = total - transition + 1
   206	    high[interior_axis] = 0
   207	    high[traversal_axis] = transition
   208	    high[remaining_axis] = total - transition
   209	    inward[interior_axis] = 1
   210	    inward[traversal_axis] = transition - 1
   211	    inward[remaining_axis] = total - transition
   212	    return sorted([low, high, inward])
   213	
   214	
   215	def _color(inst: dict, point: list[int], transition: int | None = None) -> int:
   216	    """Evaluate the exact Sperner coloring; colors are one-based axis indices."""
   217	    interior_axis, traversal_axis, remaining_axis = inst["axis_order"]
   218	    if point[interior_axis] > 0:
   219	        return interior_axis + 1
   220	    if transition is None:
   221	        transition = _terminal_state(inst) + 1
   222	    if point[traversal_axis] < transition:
   223	        return remaining_axis + 1
   224	    return traversal_axis + 1
