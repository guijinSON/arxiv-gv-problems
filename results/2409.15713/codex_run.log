   405	
   406	def canonical_key(inst: dict) -> str:
   407	    """Canonicalize simultaneous coordinate/color relabeling."""
   408	    # The induced coloring, modulo a simultaneous relabeling of its three
   409	    # barycentric coordinates and colors, is determined by M and its transition.
   410	    # This intentionally contains no seed and ignores the randomized axis order.
   411	    payload = [inst["simplex_denominator"], _terminal_state(inst) + 1]
   412	    raw = json.dumps(payload, separators=(",", ":")).encode("ascii")
   413	    return hashlib.sha256(raw).hexdigest()
   414	
   415	
   416	def _compact_operation_count(inst: dict) -> int:
   417	    """Count modular multiplies/adds in fixed-point translation + powering."""
   418	    # Extended Euclid supplies (1-a)^-1.  Conservatively count a quotient, two
   419	    # multiply-subtract remainder/coefficient updates, and their assignments as
   420	    # five exact operations per loop.
   421	    modulus = inst["recurrence_modulus"]
   422	    old_r, r = modulus, (1 - inst["multiplier"]) % modulus
   423	    divisions = 0
   424	    while r:
   425	        old_r, r = r, old_r % r
   426	        divisions += 1
   427	    exponent = inst["horizon"]
   428	    power_ops = max(0, exponent.bit_length() - 1) + max(0, exponent.bit_count() - 1)
   429	    # fixed=b/(1-a), translate, scale, translate back, and add one for T.
   430	    return 5 * divisions + power_ops + 5
   431	
   432	
   433	def escalate(params: dict) -> dict | str | None:
   434	    """Grow circuit length and field entropy while keeping nine answer atoms."""
   435	    horizon = _require_int(params.get("n"), "n", 1)
   436	    bits = _require_int(params.get("bits"), "bits", 2)
   437	    next_bits = {5: 31, 31: 61, 61: 89, 89: 107, 107: 127}.get(bits)
   438	    if next_bits is None:
   439	        return None
   440	    return {"n": horizon * 4 + 1, "bits": next_bits}
   441	
   442	
   443	def _relabel_instance(inst: dict, permutation: tuple[int, int, int]) -> dict:
   444	    """Apply an old-axis -> new-axis relabeling, carrying the witness."""
   445	    transformed = {
   446	        key: json.loads(json.dumps(value))
   447	        for key, value in inst.items()
   448	        if key != "answer"
   449	    }
   450	    transformed["axis_order"] = [permutation[axis] for axis in inst["axis_order"]]
   451	    carried = []
   452	    for row in inst["answer"]:
   453	        new_row = [0, 0, 0]
   454	        for old_axis, value in enumerate(row):
   455	            new_row[permutation[old_axis]] = value
   456	        carried.append(new_row)
   457	    transformed["answer"] = sorted(carried)
   458	    return transformed
   459	
   460	
   461	def _attack_guesses(inst: dict) -> dict[str, list[int]]:
   462	    modulus = inst["recurrence_modulus"]
   463	    a = inst["multiplier"]
   464	    b = inst["increment"]
   465	    s0 = inst["initial_state"]
   466	    horizon = inst["horizon"]
   467	    fixed = b * pow(1 - a, -1, modulus) % modulus
   468	    return {
   469	        "outlier_endpoints_midpoint": [1, (modulus + 1) // 2, modulus],
   470	        "greedy_one_recurrence_step": [1 + (a * s0 + b) % modulus],
   471	        "linearized_ignore_multiplier": [1 + (s0 + horizon * b) % modulus],
   472	        "obvious_fixed_point_ansatz": [1 + fixed],
   473	    }
   474	
   475	
   476	def _answer_chars_and_atoms(answer) -> tuple[int, int]:
   477	    chars = len(json.dumps(answer, separators=(",", ":")))
   478	
   479	    def atoms(value) -> int:
   480	        if isinstance(value, dict):
   481	            return sum(atoms(v) for v in value.values())
   482	        if isinstance(value, list):
   483	            return sum(atoms(v) for v in value)
   484	        return 1
   485	
   486	    return chars, atoms(answer)
