   226	
   227	def make_instance(n: int, seed: int = 0, bits: int = 31, **params) -> dict:
   228	    """Inverse-generate a succinct valid Sperner coloring and its witness."""
   229	    if params:
   230	        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
   231	    horizon = _require_int(n, "n", 1)
   232	    _require_int(seed, "seed")
   233	    bits = _require_int(bits, "bits", 2)
   234	    if bits not in _MERSENNE_PRIME_EXPONENTS:
   235	        raise ValueError("bits must be a supported Mersenne-prime exponent")
   236	
   237	    denominator = 1 << bits
   238	    modulus = denominator - 1
   239	    rng = random.Random(seed)
   240	    target = rng.randrange(modulus)  # sampled before the public circuit exists
   241	    initial = rng.randrange(modulus)
   242	
   243	    # For s_{t+1}=a*s_t+b, solve backwards for b so that s_h=target.
   244	    # The geometric coefficient is nonzero except when a^h=1; resample a in
   245	    # that exceptional case.  No search for a witness occurs here.
   246	    while True:
   247	        multiplier = rng.randrange(2, modulus - 1)
   248	        power = pow(multiplier, horizon, modulus)
   249	        coefficient = (power - 1) * pow(multiplier - 1, -1, modulus) % modulus
   250	        if coefficient != 0:
   251	            break
   252	    increment = (target - power * initial) * pow(coefficient, -1, modulus) % modulus
   253	
   254	    axis_order = [0, 1, 2]
   255	    rng.shuffle(axis_order)
   256	    inst = {
   257	        "family": "succinct 2D approximate Sperner boundary transition",
   258	        "dimension": 2,
   259	        "bits": bits,
   260	        "simplex_denominator": denominator,
   261	        "recurrence_modulus": modulus,
   262	        "horizon": horizon,
   263	        "initial_state": initial,
   264	        "multiplier": multiplier,
   265	        "increment": increment,
   266	        "axis_order": axis_order,
   267	    }
   268	    inst["answer"] = _triangle_for_transition(inst, target + 1)
   269	    return inst
   270	
   271	
   272	def render(inst: dict) -> str:
   273	    total = inst["simplex_denominator"]
   274	    modulus = inst["recurrence_modulus"]
   275	    i, j, k = (axis + 1 for axis in inst["axis_order"])
   276	    statement = f"""SUCCINCT TRICHROMATIC SPERNER TRIANGLE
   277	
   278	The exact witness lattice in the continuous 2-simplex is
   279	    D = {{(x1,x2,x3): each xr >= 0 and x1+x2+x3 = M}},
   280	where M={total}.  Dividing all coordinates by M embeds D in the standard
   281	triangle, and consecutive lattice points are exactly 1/M=2^-{inst['bits']}
   282	apart.  Color numbers and coordinate numbers are both 1-based.
   283	
   284	A coloring is a Sperner coloring when a point may receive color r only if its
   285	coordinate xr is positive.  The coloring below is specified by an exact
   286	integer circuit with prime modulus P={modulus}.  "mod P" always means the
   287	canonical residue in 0,...,P-1.
   288	
   289	Start with s_0={inst['initial_state']} and, for t=0,...,{inst['horizon'] - 1}, set
   290	    s_(t+1) = ({inst['multiplier']}*s_t + {inst['increment']}) mod P.
   291	Let T=1+s_{inst['horizon']} (so 1 <= T <= P).  For x=(x1,x2,x3) in D:
   292	
   293	  * if x{i}>0, set C(x)={i};
   294	  * if x{i}=0 and x{j}<T, set C(x)={k};
   295	  * if x{i}=0 and x{j}>=T, set C(x)={j}.
   296	
   297	This rule is a valid Sperner coloring: every returned color names a positive
   298	coordinate.  Find the face-straddling elementary triangle at which all three
   299	colors occur.  Your answer must be exactly three distinct rows [x1,x2,x3],
   300	listed in lexicographically increasing order.  Two rows must be consecutive
   301	points on the active face x{i}=0, and the third must be their unique adjacent
   302	point with x{i}=1.  Equivalently, every pair of rows differs by at most 1 in
   303	each coordinate.  Repetitions are forbidden and all bounds are inclusive.
   304	
   305	Give your final answer inside <answer></answer> tags as one JSON 3-by-3 integer
   306	matrix.  A syntax example (not necessarily a solution) is
   307	<answer>[[0,0,{total}],[0,1,{total - 1}],[1,0,{total - 1}]]</answer>.
   308	Output nothing else inside the tags."""
   309	    mode = os.environ.get("GV_HINT_MODE")
   310	    if mode == "structural":
   311	        statement += "\n\nHint: " + STRUCTURAL_HINT
   312	    elif mode == "placebo":
   313	        statement += "\n\nHint: " + PLACEBO_HINT
   314	    return statement
   315	
   316	
   317	def parse_answer(text) -> object | None:
   318	    """Parse a tagged JSON matrix, tolerating prose and Markdown around it."""
   319	    if not isinstance(text, str):
   320	        return None
   321	    match = _ANSWER_RE.search(text)
   322	    if match is None:
   323	        return None
   324	    body = match.group(1).strip()
   325	    if body.startswith("```") and body.endswith("```"):
   326	        lines = body.splitlines()
   327	        if len(lines) >= 3:
   328	            body = "\n".join(lines[1:-1]).strip()
   329	    try:
   330	        value = json.loads(body)
   331	    except (TypeError, ValueError):
   332	        return None
   333	    if not isinstance(value, list):
   334	        return None
   335	    return value
