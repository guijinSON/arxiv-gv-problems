+def _relabel_instance(inst: dict, permutation: tuple[int, int, int]) -> dict:
+    """Apply an old-axis -> new-axis relabeling, carrying the witness."""
+    transformed = {
+        key: json.loads(json.dumps(value))
+        for key, value in inst.items()
+        if key != "answer"
