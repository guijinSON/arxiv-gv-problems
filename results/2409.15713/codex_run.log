+        "carried_witness_checks": carried_checks,
+        "distinct_unrelated_keys": len(distinct_keys),
+        "unrelated_instances": 20,
+        "transformations": "all 6 axis/color permutations plus a composition",
+    }
+
+    answer_chars = 0
+    answer_atoms = 0
+    intended_ops = 0
