+def _stdlib_solve(matrix, rhs):
+    """Exact Gauss-Jordan fallback used only when gvlib is unavailable."""
+    n = len(matrix)
+    rows = [list(map(Fraction, matrix[i])) + [Fraction(rhs[i])] for i in range(n)]
+    for column in range(n):
+        pivot = next((r for r in range(column, n) if rows[r][column]), None)
+        if pivot is None:
+            return None
+        rows[column], rows[pivot] = rows[pivot], rows[column]
+        divisor = rows[column][column]
+        rows[column] = [value / divisor for value in rows[column]]
+        for r in range(n):
+            if r == column or rows[r][column] == 0:
+                continue
+            factor = rows[r][column]
+            rows[r] = [a - factor * b for a, b in zip(rows[r], rows[column])]
+    return [rows[i][-1] for i in range(n)]
+
+
+def _solve_z(inst):
+    if exact_matrices is not None:
+        matrix = exact_matrices.matrix(inst["matrix"])
+        return exact_matrices.solve(matrix, inst["rhs"])
+    return _stdlib_solve(inst["matrix"], inst["rhs"])
+
+
+def _selected_solution(inst, solution=None):
+    solution = _solve_z(inst) if solution is None else solution
+    if solution is None or len(solution) != inst["n"]:
+        raise ValueError("the displayed linear system is not uniquely solvable")
+    return [solution[index] for index in inst["selectors"]]
+
+
+def _answer_from_anchor(anchor, source: int, q: int):
+    targets = [j for j in range(3) if j != source]
+    vectors = [list(anchor)]
+    for target in targets:
+        point = list(anchor)
+        point[source] -= 1
+        point[target] += 1
+        vectors.append(point)
+    vectors.sort()
+    return [[_qjson(Fraction(value, q)) for value in point] for point in vectors]
+
+
+def _answer_from_weights(values, q: int):
+    values = [Fraction(value) for value in values]
+    total = sum(values, Fraction(0))
+    if total <= 0 or any(value <= 0 for value in values):
+        return _answer_from_anchor([q // 3, q // 3, q - 2 * (q // 3)], 0, q)
+    exact = [value * q / total for value in values]
+    anchor = [max(1, int(value + Fraction(1, 2))) for value in exact]
+    difference = q - sum(anchor)
+    order = sorted(range(3), key=lambda i: exact[i] - anchor[i], reverse=True)
+    step = 1 if difference > 0 else -1
+    for offset in range(abs(difference)):
+        index = order[offset % 3]
+        if step < 0 and anchor[index] <= 1:
+            index = max(range(3), key=lambda i: anchor[i])
+        anchor[index] += step
+    if min(anchor) <= 0 or sum(anchor) != q:
+        return _answer_from_anchor([q // 3, q // 3, q - 2 * (q // 3)], 0, q)
+    return _answer_from_anchor(anchor, 0, q)
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate a weighted continuous Sperner coloring and its triangle."""
+    precision = params.pop("precision", 24)
+    weight_sum = params.pop("weight_sum", 65_536)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(n, bool) or not isinstance(n, int) or n < 5:
+        raise ValueError("n must be an integer at least 5")
+    if isinstance(precision, bool) or not isinstance(precision, int):
+        raise ValueError("precision must be an integer")
+    if precision < 5 or precision > 512:
+        raise ValueError("precision must lie between 5 and 512")
+    if isinstance(weight_sum, bool) or not isinstance(weight_sum, int):
+        raise ValueError("weight_sum must be an integer")
+    if weight_sum < 8 or weight_sum & (weight_sum - 1):
+        raise ValueError("weight_sum must be a power of two at least 8")
+    if weight_sum > 2**precision:
+        raise ValueError("weight_sum must divide the lattice denominator")
+
+    rng = random.Random(seed)
+    selectors = rng.sample(range(n), 3)
+
+    lower = max(2, weight_sum // 8)
+    upper = weight_sum - 2 * lower
+    while True:
+        first = rng.randrange(lower, upper + 1)
+        second = rng.randrange(lower, upper + 1)
+        third = weight_sum - first - second
+        if lower <= third <= upper:
+            selected_values = [first, second, third]
+            break
+
+    solution = [rng.randrange(11, 997) for _ in range(n)]
+    for index, value in zip(selectors, selected_values):
+        solution[index] = value
+
+    # Nonzero factors make every displayed off-diagonal entry informative.  The
+    # determinant lemma says det(D+uv^T)=det(D)*(1+v^T D^-1 u); resample only
+    # the measure-zero singular case.  The generator never solves its output.
+    while True:
+        diagonal = [rng.randrange(3, 80) * rng.choice((-1, 1)) for _ in range(n)]
+        left = [rng.randrange(2, 23) * rng.choice((-1, 1)) for _ in range(n)]
+        right = [rng.randrange(2, 23) * rng.choice((-1, 1)) for _ in range(n)]
+        determinant_factor = Fraction(1) + sum(
+            (Fraction(right[i] * left[i], diagonal[i]) for i in range(n)),
+            Fraction(0),
+        )
+        if determinant_factor:
+            break
+
+    matrix = [
+        [
+            left[i] * right[j] + (diagonal[i] if i == j else 0)
+            for j in range(n)
+        ]
+        for i in range(n)
+    ]
+    rhs = [sum(matrix[i][j] * solution[j] for j in range(n)) for i in range(n)]
+
+    q = 1 << precision
+    scale = q // weight_sum
+    anchor = [value * scale for value in selected_values]
+    answer = _answer_from_anchor(anchor, 0, q)
+    return {
+        "family": "weighted continuous 2D Sperner balance",
+        "n": n,
+        "precision": precision,
+        "lattice_denominator": q,
+        "weight_sum": weight_sum,
+        "matrix": matrix,
+        "rhs": rhs,
+        "selectors": selectors,
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    rows = [f"  {i}: " + " ".join(map(str, row)) for i, row in enumerate(inst["matrix"])]
+    selectors = ", ".join(map(str, inst["selectors"]))
+    statement = f"""RATIONAL TRICHROMATIC TRIANGLE IN A CONTINUOUS SPERNER COLORING
+
+All indices are 0-based and all arithmetic and comparisons are exact; floating
+point approximations are not allowed.
+
+Let A be the displayed {inst['n']} by {inst['n']} integer matrix, let b be the
+displayed length-{inst['n']} integer vector, and let z be the unique rational
+solution of A z = b.  The three selected entries, in color order 1,2,3, are
+z[{selectors}].  They are promised to be positive.
+
+The continuous 2-simplex is the set of triples x=(x0,x1,x2) of nonnegative
+rationals with x0+x1+x2=1.  Its Sperner color C(x) is the smallest color i in
+{{1,2,3}} maximizing x[i-1]/z[s_i], where (s_1,s_2,s_3) are the selected
+indices listed above.  Thus exact ties go to the smaller color.  A zero
+coordinate can never win against a positive coordinate, so C obeys the Sperner
+boundary rule.
+
+Use the lattice denominator Q=2^{inst['precision']}={inst['lattice_denominator']}.
+Find an elementary lattice triangle whose three colors are distinct.  Such a
+triangle is defined by a positive integer anchor a=(a0,a1,a2) with sum Q and a
+source coordinate s in {{0,1,2}}: its unordered vertices are
+  a/Q,
+  (a-e_s+e_j)/Q,
+  (a-e_s+e_k)/Q,
+where {{j,k}}={{0,1,2}} minus {{s}} and e_i is the i-th unit vector.  Reordering
+the three vertices is allowed; repeats are not.  Every pair then has exact
+l-infinity distance at most 1/Q.
+
+Matrix A (one complete row per line):
+{chr(10).join(rows)}
+
+Vector b:
+  {' '.join(map(str, inst['rhs']))}
+
+Give your final answer inside <answer></answer> tags as one JSON array with
+shape 3 by 3 by 2.  A coordinate num/den is written [num,den] in lowest terms
+with den>0; each group of three coordinates is one simplex point.
+Example format: <answer>[[[1,2],[1,4],[1,4]],[[15,32],[9,32],[1,4]],[[15,32],[1,4],[9,32]]]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text) -> object | None:
+    try:
+        matches = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", str(text), re.I | re.S)
+        if not matches:
+            return None
+        body = matches[-1].strip()
+        for fence in ("~~~", "```"):
+            if body.startswith(fence) and body.endswith(fence):
+                body = re.sub("^" + re.escape(fence) + r"[^\n]*\n?", "", body)
+                body = re.sub(r"\n?" + re.escape(fence) + "$", "", body).strip()
+        value = json.loads(body)
+        return value if isinstance(value, list) else None
+    except Exception:
+        return None
+
+
+def _validate_answer_shape(inst, answer):
+    if answer is None:
+        return None, "answer is absent"
+    if not isinstance(answer, list):
+        return None, "answer must be a JSON list"
+    if not answer:
+        return None, "answer is empty"
+    if len(answer) != 3:
+        return None, "answer must contain exactly three points"
+    points = []
+    for point in answer:
+        if not isinstance(point, list) or len(point) != 3:
+            return None, "each point must contain exactly three coordinates"
+        decoded = []
+        for coordinate in point:
+            try:
+                value = _from_qjson(coordinate)
+            except (TypeError, ValueError, ZeroDivisionError):
+                return None, "every coordinate must be a reduced [numerator,denominator] rational"
+            if value < 0 or value > 1:
+                return None, "a coordinate lies outside the closed interval [0,1]"
+            decoded.append(value)
+        if sum(decoded, Fraction(0)) != 1:
+            return None, "a point does not lie on the simplex"
+        points.append(decoded)
+    if len({tuple(point) for point in points}) != 3:
+        return None, "the three points must be distinct"
+
+    q = inst["lattice_denominator"]
+    scaled = []
+    for point in points:
+        row = []
+        for value in point:
+            product = value * q
+            if product.denominator != 1:
+                return None, "a coordinate is not on the stated Q-lattice"
+            row.append(product.numerator)
+        scaled.append(row)
+    for left, right in itertools.combinations(scaled, 2):
+        if max(abs(a - b) for a, b in zip(left, right)) > 1:
+            return None, "two points exceed the allowed l-infinity distance"
+
+    observed = {tuple(row) for row in scaled}
+    elementary = False
+    for anchor in scaled:
+        if min(anchor) <= 0:
+            continue
+        for source in range(3):
+            expected = {tuple(anchor)}
+            for target in range(3):
+                if target == source:
+                    continue
+                shifted = list(anchor)
+                shifted[source] -= 1
+                shifted[target] += 1
+                expected.add(tuple(shifted))
+            if expected == observed:
+                elementary = True
+                break
+        if elementary:
+            break
+    if not elementary:
+        return None, "points do not form a permitted elementary triangle"
+    return points, "ok"
+
+
+def _color(point, selected_solution):
+    scores = [point[i] / selected_solution[i] for i in range(3)]
+    winner = 0
+    for index in range(1, 3):
+        if scores[index] > scores[winner]:
+            winner = index
+    return winner + 1
+
+
+def _verify_with_selected(inst, answer, selected_solution):
+    points, reason = _validate_answer_shape(inst, answer)
+    if points is None:
+        return False, reason
+    if any(value <= 0 for value in selected_solution):
+        return False, "the instance violates its positive-weight promise"
+    colors = [_color(point, selected_solution) for point in points]
+    if len(set(colors)) != 3:
+        return False, "the elementary triangle is not trichromatic"
+    return True, "ok"
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check any bounded-language trichromatic witness without reading the plant."""
+    try:
+        selected = _selected_solution(inst)
+    except (TypeError, ValueError, ZeroDivisionError):
+        return False, "the displayed linear system is malformed or singular"
+    return _verify_with_selected(inst, answer, selected)
+
+
+def random_candidate(inst, rng: random.Random) -> object:
+    """Uniformly sample positive anchors and source coordinates, not arbitrary triples."""
+    q = inst["lattice_denominator"]
+    cut1, cut2 = sorted(rng.sample(range(1, q), 2))
+    anchor = [cut1, cut2 - cut1, q - cut2]
+    return _answer_from_anchor(anchor, rng.randrange(3), q)
+
+
+def search_space(inst) -> int | None:
+    q = inst["lattice_denominator"]
+    return 3 * math.comb(q - 1, 2)
+
+
+def enumerate_all(inst) -> int | None:
+    q = inst["lattice_denominator"]
+    if q > 64:
+        return None
+    selected = _selected_solution(inst)
+    count = 0
+    for cut1 in range(1, q - 1):
+        for cut2 in range(cut1 + 1, q):
+            anchor = [cut1, cut2 - cut1, q - cut2]
+            for source in range(3):
+                candidate = _answer_from_anchor(anchor, source, q)
+                count += _verify_with_selected(inst, candidate, selected)[0]
+    return count
+
+
+def canonical_key(inst) -> str:
+    """Key the induced coloring, invariant under equation/variable relabelling."""
+    selected = _selected_solution(inst)
+    total = sum(selected, Fraction(0))
+    normalized = [_qjson(value / total) for value in selected]
+    payload = ["weighted-continuous-sperner", inst["precision"], normalized]
+    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    precision = int(params.get("precision", 24))
+    if precision >= 512:
+        return "cap_bound"
+    return {
+        "n": int(params["n"]),
+        "precision": min(512, precision + 16),
+        "weight_sum": int(params.get("weight_sum", 65_536)),
+    }
+
+
+def _gaussian_reference(inst):
+    """Generic exact O(n^3) solver with a transparent arithmetic counter."""
+    n = inst["n"]
+    rows = [list(map(Fraction, inst["matrix"][i])) for i in range(n)]
+    rhs = list(map(Fraction, inst["rhs"]))
+    operations = 0
+    swaps = 0
+    for column in range(n):
+        pivot = next((r for r in range(column, n) if rows[r][column]), None)
+        if pivot is None:
+            return None, {"operations": operations, "row_swaps": swaps}
+        if pivot != column:
+            rows[column], rows[pivot] = rows[pivot], rows[column]
+            rhs[column], rhs[pivot] = rhs[pivot], rhs[column]
+            swaps += 1
+        divisor = rows[column][column]
+        for row in range(column + 1, n):
+            if rows[row][column] == 0:
+                continue
+            factor = rows[row][column] / divisor
+            operations += 1
+            for j in range(column, n):
+                rows[row][j] -= factor * rows[column][j]
+                operations += 2
+            rhs[row] -= factor * rhs[column]
+            operations += 2
+    solution = [Fraction(0)] * n
+    for row in range(n - 1, -1, -1):
+        subtotal = Fraction(0)
+        for column in range(row + 1, n):
+            subtotal += rows[row][column] * solution[column]
+            operations += 2
+        solution[row] = (rhs[row] - subtotal) / rows[row][row]
+        operations += 2
+    selected = [solution[index] for index in inst["selectors"]]
+    return _answer_from_weights(selected, inst["lattice_denominator"]), {
+        "operations": operations,
+        "row_swaps": swaps,
+    }
+
+
+def _recover_rank_one_parts(inst):
+    """Recover D,U,V with A=D+UV^T from off-diagonal entries."""
+    matrix = inst["matrix"]
+    n = inst["n"]
+    operations = 0
+    # Scale V[1]=1. Rows/columns 0,1,2 exist because n>=5.
+    U = [Fraction(0)] * n
+    V = [Fraction(0)] * n
+    V[1] = Fraction(1)
+    for i in range(n):
+        if i != 1:
+            U[i] = Fraction(matrix[i][1])
+    for j in range(n):
+        if j not in (0, 1):
+            V[j] = Fraction(matrix[0][j], matrix[0][1])
+            operations += 1
+    U[1] = Fraction(matrix[1][2]) / V[2]
+    V[0] = Fraction(matrix[2][0]) / U[2]
+    operations += 2
+    D = []
+    for i in range(n):
+        D.append(Fraction(matrix[i][i]) - U[i] * V[i])
+        operations += 2
+    return D, U, V, operations
+
+
+def _compact_rank_one(inst, prefix=None):
+    """Sherman-Morrison route; prefix truncation is the in-context attack."""
+    n = inst["n"]
+    D, U, V, operations = _recover_rank_one_parts(inst)
+    y = []
+    w = []
+    for i in range(n):
+        y.append(Fraction(inst["rhs"][i]) / D[i])
+        w.append(U[i] / D[i])
+        operations += 2
+    limit = n if prefix is None else min(prefix, n)
+    numerator = Fraction(0)
+    denominator = Fraction(1)
+    for i in range(limit):
+        numerator += V[i] * y[i]
+        denominator += V[i] * w[i]
+        operations += 4
+    alpha = numerator / denominator
+    operations += 1
+    selected = []
+    for index in inst["selectors"]:
+        selected.append(y[index] - w[index] * alpha)
+        operations += 2
+    answer = _answer_from_weights(selected, inst["lattice_denominator"])
+    return answer, {"operations": operations, "terms_used": limit}
+
+
+def _attack_diagonal_only(inst):
+    guesses = []
+    for index in inst["selectors"]:
+        divisor = inst["matrix"][index][index]
+        guesses.append(abs(Fraction(inst["rhs"][index], divisor)) if divisor else Fraction(1))
+    return _answer_from_weights(guesses, inst["lattice_denominator"])
+
+
+def _attack_row_sum(inst):
+    guesses = []
+    for index in inst["selectors"]:
+        divisor = sum(inst["matrix"][index])
+        guesses.append(abs(Fraction(inst["rhs"][index], divisor)) if divisor else Fraction(1))
+    return _answer_from_weights(guesses, inst["lattice_denominator"])
+
+
+def _attack_equal_weights(inst):
+    return _answer_from_weights([1, 1, 1], inst["lattice_denominator"])
+
+
+def _attack_random_candidates(inst, rng, restarts=4096, selected=None):
+    selected = _selected_solution(inst) if selected is None else selected
+    last = None
+    for _ in range(restarts):
+        last = random_candidate(inst, rng)
+        if _verify_with_selected(inst, last, selected)[0]:
+            return last
+    return last
+
+
+def _row_permute(inst, permutation):
+    out = copy.deepcopy(inst)
+    out["matrix"] = [inst["matrix"][i][:] for i in permutation]
+    out["rhs"] = [inst["rhs"][i] for i in permutation]
+    return out
+
+
+def _variable_permute(inst, permutation):
+    out = copy.deepcopy(inst)
+    out["matrix"] = [[row[j] for j in permutation] for row in inst["matrix"]]
+    inverse = {old: new for new, old in enumerate(permutation)}
+    out["selectors"] = [inverse[index] for index in inst["selectors"]]
+    return out
+
+
+def _answer_size(answer):
+    encoded = json.dumps(answer, separators=(",", ":"))
+    return {
+        "chars": len(encoded),
+        "tokens": math.ceil(len(encoded) / 4),
+        "elements": 9,
+    }
+
+
+def selftest():
+    report = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
+
+    attempts = 0
+    failures = []
+    json_roundtrips = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                failures.append([preset, seed, reason])
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_roundtrips += 1
+    report["G1_planted_verifies"] = {
+        "pass": not failures and json_roundtrips == attempts,
+        "attempts": attempts,
+        "json_roundtrips": json_roundtrips,
+        "failures": failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=90_210, **ship_params)
+    answer = inst["answer"]
+    corruptions = {
+        "drop": answer[:2],
+        "swap": copy.deepcopy(answer),
+        "duplicate": [answer[0], answer[0], answer[2]],
+        "empty": [],
+        "out_of_range": copy.deepcopy(answer),
+    }
+    corruptions["swap"][0][0], corruptions["swap"][0][1] = (
+        corruptions["swap"][0][1],
+        corruptions["swap"][0][0],
+    )
+    corruptions["out_of_range"][0][0] = [2, 1]
+    corruption_results = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        corruption_results[name] = {"rejected": not ok, "reason": reason}
+    reasons = [entry["reason"] for entry in corruption_results.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(entry["rejected"] for entry in corruption_results.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": corruption_results,
+    }
+
+    realistic = (
+        "Balancing the three exact scores gives the following triangle.\n\n"
+        "```json\n<answer>"
+        + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```"
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and parse_answer("there is no tagged witness") is None,
+        "parsed_matches": parsed == answer,
+        "garbage_returns_none": parse_answer("there is no tagged witness") is None,
+    }
+
+    selected = _selected_solution(inst)
+    samples = 200_000
+    guess_rng = random.Random(0x240915713)
+    hits = 0
+    for _ in range(samples):
+        candidate = random_candidate(inst, guess_rng)
+        hits += _verify_with_selected(inst, candidate, selected)[0]
+    space = search_space(inst)
+    exact_count_upper_bound = 18
+    probability_upper_bound = exact_count_upper_bound / space
+    report["G4_guess_resistance"] = {
+        "pass": hits == 0 and probability_upper_bound < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": hits / samples,
+        "rigorous_probability_upper_bound": probability_upper_bound,
+        "valid_answer_upper_bound": exact_count_upper_bound,
+        "structure_aware_space": space,
+        "sampler": "uniform positive composition anchor and uniform source coordinate",
+    }
+
+    baseline_start = time.perf_counter()
+    baseline = _attack_random_candidates(
+        inst, random.Random(99_173), restarts=4096, selected=selected
+    )
+    baseline_wall = time.perf_counter() - baseline_start
+    demo_count = enumerate_all(make_instance(seed=3, **DIFFICULTY["demo"]))
+    report["G5_density_and_baseline"] = {
+        "pass": hits == 0 and demo_count is not None and demo_count > 0,
+        "shipping_valid_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_observed_solution_fraction": hits / samples,
+        "shipping_solution_fraction_upper_bound": probability_upper_bound,
