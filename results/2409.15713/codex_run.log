   337	
   338	def verify(inst: dict, answer) -> tuple[bool, str]:
   339	    """Check the submitted triangle exactly, without consulting inst['answer']."""
   340	    if not isinstance(answer, list):
   341	        return False, "answer_not_a_list"
   342	    if len(answer) == 0:
   343	        return False, "empty_answer"
   344	    if len(answer) != 3:
   345	        return False, "wrong_row_count"
   346	    if any(not isinstance(row, list) or len(row) != 3 for row in answer):
   347	        return False, "wrong_matrix_shape"
   348	    if any(
   349	        isinstance(value, bool) or not isinstance(value, int)
   350	        for row in answer for value in row
   351	    ):
   352	        return False, "non_integer_coordinate"
   353	    rows = [tuple(row) for row in answer]
   354	    if len(set(rows)) != 3:
   355	        return False, "repeated_point"
   356	    if answer != sorted(answer):
   357	        return False, "rows_not_lexicographic"
   358	
   359	    total = inst["simplex_denominator"]
   360	    if any(value < 0 or value > total for row in answer for value in row):
   361	        return False, "coordinate_out_of_range"
   362	    if any(sum(row) != total for row in answer):
   363	        return False, "wrong_barycentric_sum"
   364	
   365	    interior_axis, traversal_axis, _ = inst["axis_order"]
   366	    face_rows = [row for row in answer if row[interior_axis] == 0]
   367	    inward_rows = [row for row in answer if row[interior_axis] == 1]
   368	    if len(face_rows) != 2 or len(inward_rows) != 1:
   369	        return False, "not_face_straddling_unit_triangle"
   370	    transition = max(row[traversal_axis] for row in face_rows)
   371	    if not 1 <= transition <= inst["recurrence_modulus"]:
   372	        return False, "not_face_straddling_unit_triangle"
   373	    if answer != _triangle_for_transition(inst, transition):
   374	        return False, "not_face_straddling_unit_triangle"
   375	
   376	    actual_transition = _terminal_state(inst) + 1
   377	    colors = {_color(inst, row, actual_transition) for row in answer}
   378	    if len(colors) != 3:
   379	        return False, "not_trichromatic"
   380	    return True, "ok"
   381	
   382	
   383	def random_candidate(inst: dict, rng: random.Random) -> object:
   384	    """Sample uniformly from the structure-aware boundary-triangle language."""
   385	    transition = rng.randrange(1, inst["recurrence_modulus"] + 1)
   386	    return _triangle_for_transition(inst, transition)
   387	
   388	
   389	def search_space(inst: dict) -> int | None:
   390	    """There is one canonical face-straddling candidate per active-face edge."""
   391	    return inst["recurrence_modulus"]
   392	
   393	
   394	def enumerate_all(inst: dict) -> int | None:
   395	    """Brute-force tiny grids only; cap work rather than hiding a large scan."""
   396	    total = inst["recurrence_modulus"]
   397	    if total > 10000:
   398	        return None
   399	    count = 0
   400	    for transition in range(1, total + 1):
   401	        if verify(inst, _triangle_for_transition(inst, transition))[0]:
   402	            count += 1
   403	    return count
