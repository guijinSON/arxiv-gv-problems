+def escalate(params: dict) -> dict | str | None:
+    """Grow circuit length and field entropy while keeping nine answer atoms."""
+    horizon = _require_int(params.get("n"), "n", 1)
+    bits = _require_int(params.get("bits"), "bits", 2)
+    next_bits = {5: 31, 31: 61, 61: 89, 89: 107, 107: 127}.get(bits)
+    if next_bits is None:
+        return None
+    return {"n": horizon * 4 + 1, "bits": next_bits}
 
 
