+def _compact_operation_count(inst: dict) -> int:
+    """Count modular multiplies/adds in fixed-point translation + powering."""
+    # Extended Euclid supplies (1-a)^-1.  Conservatively count a quotient, two
+    # multiply-subtract remainder/coefficient updates, and their assignments as
+    # five exact operations per loop.
+    modulus = inst["recurrence_modulus"]
+    old_r, r = modulus, (1 - inst["multiplier"]) % modulus
+    divisions = 0
+    while r:
+        old_r, r = r, old_r % r
+        divisions += 1
+    exponent = inst["horizon"]
+    power_ops = max(0, exponent.bit_length() - 1) + max(0, exponent.bit_count() - 1)
+    # fixed=b/(1-a), translate, scale, translate back, and add one for T.
+    return 5 * divisions + power_ops + 5
 
 
