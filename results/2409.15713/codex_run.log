+        points.append(decoded)
+    if len({tuple(point) for point in points}) != 3:
+        return None, "the three points must be distinct"
+
+    q = inst["lattice_denominator"]
+    scaled = []
+    for point in points:
+        row = []
+        for value in point:
+            product = value * q
+            if product.denominator != 1:
+                return None, "a coordinate is not on the stated Q-lattice"
+            row.append(product.numerator)
+        scaled.append(row)
+    for left, right in itertools.combinations(scaled, 2):
+        if max(abs(a - b) for a, b in zip(left, right)) > 1:
+            return None, "two points exceed the allowed l-infinity distance"
+
+    observed = {tuple(row) for row in scaled}
+    elementary = False
+    for anchor in scaled:
+        if min(anchor) <= 0:
+            continue
+        for source in range(3):
+            expected = {tuple(anchor)}
+            for target in range(3):
+                if target == source:
+                    continue
+                shifted = list(anchor)
+                shifted[source] -= 1
+                shifted[target] += 1
+                expected.add(tuple(shifted))
+            if expected == observed:
+                elementary = True
+                break
+        if elementary:
+            break
+    if not elementary:
+        return None, "points do not form a permitted elementary triangle"
+    return points, "ok"
+
+
+def _color(point, selected_solution):
+    scores = [point[i] / selected_solution[i] for i in range(3)]
+    winner = 0
+    for index in range(1, 3):
+        if scores[index] > scores[winner]:
+            winner = index
+    return winner + 1
+
+
+def _verify_with_selected(inst, answer, selected_solution):
+    points, reason = _validate_answer_shape(inst, answer)
+    if points is None:
+        return False, reason
+    if any(value <= 0 for value in selected_solution):
+        return False, "the instance violates its positive-weight promise"
+    colors = [_color(point, selected_solution) for point in points]
+    if len(set(colors)) != 3:
+        return False, "the elementary triangle is not trichromatic"
+    return True, "ok"
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check any bounded-language trichromatic witness without reading the plant."""
+    try:
+        selected = _selected_solution(inst)
+    except (TypeError, ValueError, ZeroDivisionError):
+        return False, "the displayed linear system is malformed or singular"
+    return _verify_with_selected(inst, answer, selected)
+
+
+def random_candidate(inst, rng: random.Random) -> object:
+    """Uniformly sample positive anchors and source coordinates, not arbitrary triples."""
+    q = inst["lattice_denominator"]
+    cut1, cut2 = sorted(rng.sample(range(1, q), 2))
+    anchor = [cut1, cut2 - cut1, q - cut2]
+    return _answer_from_anchor(anchor, rng.randrange(3), q)
+
+
+def search_space(inst) -> int | None:
+    q = inst["lattice_denominator"]
+    return 3 * math.comb(q - 1, 2)
+
+
+def enumerate_all(inst) -> int | None:
+    q = inst["lattice_denominator"]
+    if q > 64:
+        return None
+    selected = _selected_solution(inst)
+    count = 0
+    for cut1 in range(1, q - 1):
+        for cut2 in range(cut1 + 1, q):
+            anchor = [cut1, cut2 - cut1, q - cut2]
+            for source in range(3):
+                candidate = _answer_from_anchor(anchor, source, q)
+                count += _verify_with_selected(inst, candidate, selected)[0]
+    return count
+
+
+def canonical_key(inst) -> str:
+    """Key the induced coloring, invariant under equation/variable relabelling."""
+    selected = _selected_solution(inst)
+    total = sum(selected, Fraction(0))
+    normalized = [_qjson(value / total) for value in selected]
+    payload = ["weighted-continuous-sperner", inst["precision"], normalized]
+    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    precision = int(params.get("precision", 24))
+    if precision >= 512:
+        return "cap_bound"
+    return {
+        "n": int(params["n"]),
+        "precision": min(512, precision + 16),
+        "weight_sum": int(params.get("weight_sum", 65_536)),
+    }
+
+
+def _gaussian_reference(inst):
+    """Generic exact O(n^3) solver with a transparent arithmetic counter."""
+    n = inst["n"]
+    rows = [list(map(Fraction, inst["matrix"][i])) for i in range(n)]
+    rhs = list(map(Fraction, inst["rhs"]))
+    operations = 0
+    swaps = 0
+    for column in range(n):
+        pivot = next((r for r in range(column, n) if rows[r][column]), None)
+        if pivot is None:
+            return None, {"operations": operations, "row_swaps": swaps}
+        if pivot != column:
+            rows[column], rows[pivot] = rows[pivot], rows[column]
+            rhs[column], rhs[pivot] = rhs[pivot], rhs[column]
+            swaps += 1
+        divisor = rows[column][column]
+        for row in range(column + 1, n):
+            if rows[row][column] == 0:
+                continue
+            factor = rows[row][column] / divisor
+            operations += 1
+            for j in range(column, n):
+                rows[row][j] -= factor * rows[column][j]
+                operations += 2
+            rhs[row] -= factor * rhs[column]
+            operations += 2
+    solution = [Fraction(0)] * n
+    for row in range(n - 1, -1, -1):
+        subtotal = Fraction(0)
+        for column in range(row + 1, n):
+            subtotal += rows[row][column] * solution[column]
+            operations += 2
+        solution[row] = (rhs[row] - subtotal) / rows[row][row]
+        operations += 2
+    selected = [solution[index] for index in inst["selectors"]]
+    return _answer_from_weights(selected, inst["lattice_denominator"]), {
+        "operations": operations,
+        "row_swaps": swaps,
+    }
+
+
+def _recover_rank_one_parts(inst):
+    """Recover D,U,V with A=D+UV^T from off-diagonal entries."""
+    matrix = inst["matrix"]
+    n = inst["n"]
+    operations = 0
+    # Scale V[1]=1. Rows/columns 0,1,2 exist because n>=5.
+    U = [Fraction(0)] * n
+    V = [Fraction(0)] * n
+    V[1] = Fraction(1)
+    for i in range(n):
+        if i != 1:
+            U[i] = Fraction(matrix[i][1])
+    for j in range(n):
+        if j not in (0, 1):
+            V[j] = Fraction(matrix[0][j], matrix[0][1])
+            operations += 1
+    U[1] = Fraction(matrix[1][2]) / V[2]
+    V[0] = Fraction(matrix[2][0]) / U[2]
+    operations += 2
+    D = []
+    for i in range(n):
+        D.append(Fraction(matrix[i][i]) - U[i] * V[i])
+        operations += 2
+    return D, U, V, operations
+
+
+def _compact_rank_one(inst, prefix=None):
+    """Sherman-Morrison route; prefix truncation is the in-context attack."""
+    n = inst["n"]
+    D, U, V, operations = _recover_rank_one_parts(inst)
+    y = []
+    w = []
+    for i in range(n):
+        y.append(Fraction(inst["rhs"][i]) / D[i])
+        w.append(U[i] / D[i])
+        operations += 2
+    limit = n if prefix is None else min(prefix, n)
+    numerator = Fraction(0)
+    denominator = Fraction(1)
+    for i in range(limit):
+        numerator += V[i] * y[i]
+        denominator += V[i] * w[i]
+        operations += 4
+    alpha = numerator / denominator
+    operations += 1
+    selected = []
+    for index in inst["selectors"]:
+        selected.append(y[index] - w[index] * alpha)
+        operations += 2
+    answer = _answer_from_weights(selected, inst["lattice_denominator"])
+    return answer, {"operations": operations, "terms_used": limit}
+
+
+def _attack_diagonal_only(inst):
+    guesses = []
+    for index in inst["selectors"]:
+        divisor = inst["matrix"][index][index]
+        guesses.append(abs(Fraction(inst["rhs"][index], divisor)) if divisor else Fraction(1))
+    return _answer_from_weights(guesses, inst["lattice_denominator"])
+
+
+def _attack_row_sum(inst):
+    guesses = []
+    for index in inst["selectors"]:
+        divisor = sum(inst["matrix"][index])
+        guesses.append(abs(Fraction(inst["rhs"][index], divisor)) if divisor else Fraction(1))
+    return _answer_from_weights(guesses, inst["lattice_denominator"])
+
+
+def _attack_equal_weights(inst):
+    return _answer_from_weights([1, 1, 1], inst["lattice_denominator"])
+
+
+def _attack_random_candidates(inst, rng, restarts=4096, selected=None):
+    selected = _selected_solution(inst) if selected is None else selected
+    last = None
+    for _ in range(restarts):
+        last = random_candidate(inst, rng)
+        if _verify_with_selected(inst, last, selected)[0]:
+            return last
+    return last
+
+
+def _row_permute(inst, permutation):
+    out = copy.deepcopy(inst)
+    out["matrix"] = [inst["matrix"][i][:] for i in permutation]
+    out["rhs"] = [inst["rhs"][i] for i in permutation]
+    return out
+
+
+def _variable_permute(inst, permutation):
+    out = copy.deepcopy(inst)
+    out["matrix"] = [[row[j] for j in permutation] for row in inst["matrix"]]
+    inverse = {old: new for new, old in enumerate(permutation)}
+    out["selectors"] = [inverse[index] for index in inst["selectors"]]
+    return out
+
+
+def _answer_size(answer):
+    encoded = json.dumps(answer, separators=(",", ":"))
+    return {
+        "chars": len(encoded),
+        "tokens": math.ceil(len(encoded) / 4),
+        "elements": 9,
+    }
+
+
+def selftest():
+    report = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
+
+    attempts = 0
+    failures = []
+    json_roundtrips = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                failures.append([preset, seed, reason])
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_roundtrips += 1
+    report["G1_planted_verifies"] = {
+        "pass": not failures and json_roundtrips == attempts,
+        "attempts": attempts,
+        "json_roundtrips": json_roundtrips,
+        "failures": failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=90_210, **ship_params)
+    answer = inst["answer"]
+    corruptions = {
+        "drop": answer[:2],
+        "swap": copy.deepcopy(answer),
+        "duplicate": [answer[0], answer[0], answer[2]],
+        "empty": [],
+        "out_of_range": copy.deepcopy(answer),
+    }
+    corruptions["swap"][0][0], corruptions["swap"][0][1] = (
+        corruptions["swap"][0][1],
+        corruptions["swap"][0][0],
+    )
+    corruptions["out_of_range"][0][0] = [2, 1]
+    corruption_results = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        corruption_results[name] = {"rejected": not ok, "reason": reason}
+    reasons = [entry["reason"] for entry in corruption_results.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(entry["rejected"] for entry in corruption_results.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": corruption_results,
+    }
+
+    realistic = (
+        "Balancing the three exact scores gives the following triangle.\n\n"
+        "```json\n<answer>"
+        + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```"
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and parse_answer("there is no tagged witness") is None,
+        "parsed_matches": parsed == answer,
+        "garbage_returns_none": parse_answer("there is no tagged witness") is None,
+    }
+
+    selected = _selected_solution(inst)
+    samples = 200_000
+    guess_rng = random.Random(0x240915713)
+    hits = 0
+    for _ in range(samples):
+        candidate = random_candidate(inst, guess_rng)
+        hits += _verify_with_selected(inst, candidate, selected)[0]
+    space = search_space(inst)
+    exact_count_upper_bound = 18
+    probability_upper_bound = exact_count_upper_bound / space
+    report["G4_guess_resistance"] = {
+        "pass": hits == 0 and probability_upper_bound < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": hits / samples,
+        "rigorous_probability_upper_bound": probability_upper_bound,
+        "valid_answer_upper_bound": exact_count_upper_bound,
+        "structure_aware_space": space,
+        "sampler": "uniform positive composition anchor and uniform source coordinate",
+    }
+
+    baseline_start = time.perf_counter()
+    baseline = _attack_random_candidates(
+        inst, random.Random(99_173), restarts=4096, selected=selected
+    )
+    baseline_wall = time.perf_counter() - baseline_start
+    demo_count = enumerate_all(make_instance(seed=3, **DIFFICULTY["demo"]))
+    report["G5_density_and_baseline"] = {
+        "pass": hits == 0 and demo_count is not None and demo_count > 0,
+        "shipping_valid_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_observed_solution_fraction": hits / samples,
+        "shipping_solution_fraction_upper_bound": probability_upper_bound,
+        "demo_exact_solution_count": demo_count,
+        "baseline_wall_seconds": round(baseline_wall, 6),
+        "baseline_random_restart_iterations": 4096,
+        "baseline_found_solution": _verify_with_selected(inst, baseline, selected)[0],
+    }
+
+    attack_results = {
+        "outlier_diagonal_only": {"successes": 0, "attempts": 0},
+        "greedy_row_sum_balance": {"successes": 0, "attempts": 0},
+        "random_restart_4096_triangles": {"successes": 0, "attempts": 0},
+        "in_context_equal_weight_ansatz": {"successes": 0, "attempts": 0},
+        "in_context_partial_rank_one_8": {"successes": 0, "attempts": 0},
+    }
+    reference_successes = 0
+    reference_times = []
+    reference_operations = []
+    compact_successes = 0
+    compact_times = []
+    compact_operations = []
+    for seed in range(3100, 3108):
+        attacked = make_instance(seed=seed, **ship_params)
+        selected_attacked = _selected_solution(attacked)
+        partial, _ = _compact_rank_one(attacked, prefix=8)
+        candidates = {
+            "outlier_diagonal_only": _attack_diagonal_only(attacked),
+            "greedy_row_sum_balance": _attack_row_sum(attacked),
+            "random_restart_4096_triangles": _attack_random_candidates(
+                attacked,
+                random.Random(seed ^ 0xA5A5),
+                restarts=4096,
+                selected=selected_attacked,
+            ),
+            "in_context_equal_weight_ansatz": _attack_equal_weights(attacked),
+            "in_context_partial_rank_one_8": partial,
+        }
+        for name, candidate in candidates.items():
+            attack_results[name]["attempts"] += 1
+            if _verify_with_selected(attacked, candidate, selected_attacked)[0]:
+                attack_results[name]["successes"] += 1
+
+        start = time.perf_counter()
+        reference_answer, stats = _gaussian_reference(attacked)
+        reference_times.append(time.perf_counter() - start)
+        reference_operations.append(stats["operations"])
+        if reference_answer is not None and _verify_with_selected(
+            attacked, reference_answer, selected_attacked
+        )[0]:
+            reference_successes += 1
+
+        start = time.perf_counter()
+        compact_answer, compact_stats = _compact_rank_one(attacked)
+        compact_times.append(time.perf_counter() - start)
+        compact_operations.append(compact_stats["operations"])
+        if _verify_with_selected(attacked, compact_answer, selected_attacked)[0]:
+            compact_successes += 1
+
+    all_failed = all(entry["successes"] == 0 for entry in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8 and compact_successes == 8,
+        "attacks": attack_results,
+        "reference_algorithm": {
+            "name": "generic exact Gaussian elimination",
+            "complexity": "O(n^3) exact rational operations",
+            "median_wall_clock_sec": round(statistics.median(reference_times), 8),
+            "operations": int(statistics.median(reference_operations)),
+            "operation_definition": "exact rational additions, multiplications, and divisions",
+            "solves": f"{reference_successes}/8, as expected",
+        },
+        "compact_route": {
+            "name": "diagonal-plus-rank-one reconstruction and Sherman-Morrison",
+            "complexity": "O(n) exact rational operations",
+            "median_wall_clock_sec": round(statistics.median(compact_times), 8),
+            "operations": int(statistics.median(compact_operations)),
+            "operation_definition": "exact rational additions, multiplications, and divisions",
+            "solves": f"{compact_successes}/8, as expected",
+        },
+    }
+
+    doubled_params = dict(ship_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] == 2 * inst["n"],
+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "shipping_matrix_entries": inst["n"] ** 2,
+        "doubled_matrix_entries": doubled["n"] ** 2,
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    carried_witness_checks = 0
+    invariant_failures = []
+    unrelated_keys = []
+    for offset in range(20):
+        original = make_instance(seed=7000 + offset, **ship_params)
+        rng = random.Random(8000 + offset)
+        row_order = list(range(original["n"]))
+        variable_order = list(range(original["n"]))
+        rng.shuffle(row_order)
+        rng.shuffle(variable_order)
+        transforms = [
+            _row_permute(original, row_order),
+            _variable_permute(original, variable_order),
+            _variable_permute(_row_permute(original, row_order), variable_order),
+        ]
+        original_key = canonical_key(original)
+        for transformed in transforms:
+            invariance_checks += 1
+            if canonical_key(transformed) != original_key:
+                invariant_failures.append([offset, "key changed"])
+            carried_witness_checks += 1
+            if not verify(transformed, original["answer"])[0]:
+                invariant_failures.append([offset, "carried witness failed"])
+        unrelated_keys.append(original_key)
+    report["G8_canonical_key"] = {
+        "pass": not invariant_failures and len(set(unrelated_keys)) == 20,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": carried_witness_checks,
+        "distinct_unrelated_keys": len(set(unrelated_keys)),
+        "unrelated_instances": 20,
+        "symmetries": "equation permutations, variable permutations, and their compositions",
+        "key_basis": "normalized selected solution defining the coloring, never seed or rendering",
+        "failures": invariant_failures,
+    }
+
+    size = _answer_size(answer)
+    intended_operations = int(statistics.median(compact_operations))
+    arms = copy.deepcopy(G9_RESULTS["arms"])
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = hinted["solved"] / max(1, hinted["attempts"])
+    placebo_rate = placebo["solved"] / max(1, placebo["attempts"])
+    report["G9_no_tool_suitability"] = {
+        "pass": G9_RESULTS["hinted_verdict"] == "hardened"
+        and size["chars"] <= 2000
+        and size["elements"] <= 256
+        and intended_operations <= 300,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": size["chars"],
+        "answer_tokens": size["tokens"],
+        "answer_elements": size["elements"],
+        "intended_route_operations": intended_operations,
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(gate.get("pass") for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

