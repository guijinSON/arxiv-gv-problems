+        "dimension": 2,
+        "bits": bits,
+        "simplex_denominator": denominator,
+        "recurrence_modulus": modulus,
+        "horizon": horizon,
+        "initial_state": initial,
+        "multiplier": multiplier,
+        "increment": increment,
+        "axis_order": axis_order,
