   275	def parse_answer(text):
   276	    if not isinstance(text, str):
   277	        return None
   278	    tagged = _ANSWER_TAG.search(text)
   279	    if tagged:
   280	        body = tagged.group(1)
   281	    else:
   282	        fenced = _FENCE_ANYWHERE.search(text)
   283	        if fenced:
   284	            body = fenced.group(1)
   285	        else:
   286	            first, last = text.find("["), text.rfind("]")
   287	            body = text[first:last + 1] if 0 <= first < last else text.strip()
   288	    inner = _FENCE.match(body)
   289	    if inner:
   290	        body = inner.group(1)
   291	    try:
   292	        value = json.loads(body.strip())
   293	    except (TypeError, ValueError):
   294	        return None
   295	    if not isinstance(value, list):
   296	        return None
   297	    for term in value:
   298	        if not (isinstance(term, list) and len(term) == 2
   299	                and isinstance(term[0], list) and len(term[0]) == 2
   300	                and isinstance(term[1], list) and len(term[1]) == 1
   301	                and all(_is_int(v) for v in term[0] + term[1])):
   302	            return None
   303	    return value
