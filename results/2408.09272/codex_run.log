+
+def _contains(intervals, x):
+    for a, b in intervals:
+        if a <= x <= b:
+            return True
+        if x < a:
+            return False
+    return False
+
+
+def _rank_of(intervals, x):
+    rank = 0
+    for a, b in intervals:
+        if x < a:
+            return None
+        if x <= b:
+            return rank + x - a
+        rank += b - a + 1
+    return None
+
