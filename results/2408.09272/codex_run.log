   671	def selftest():
   672	    report = {}
   673	    verified = json_roundtrips = 0
   674	    for preset, params in DIFFICULTY.items():
   675	        for seed in (0, 1, 2):
   676	            inst = make_instance(seed=seed, **params)
   677	            ok, reason = verify(inst, inst["answer"])
   678	            if not ok:
   679	                raise AssertionError((preset, seed, reason))
   680	            recovered, _ = _sparse_recover(inst)
   681	            if recovered != inst["answer"]:
   682	                raise AssertionError((preset, seed, "sparse recovery disagrees"))
   683	            verified += 1
   684	            json_roundtrips += int(json.loads(json.dumps(inst["answer"])) == inst["answer"])
   685	    report["G1_planted_verifies"] = {"pass": verified == 12 and json_roundtrips == 12,
   686	                                      "verified": verified, "json_roundtrips": json_roundtrips}
   687	
   688	    easy = make_instance(seed=177, **DIFFICULTY["easy"])
   689	    good = easy["answer"]
   690	    variants = {"drop_one": json.loads(json.dumps(good[:-1])), "empty": [],
   691	                "swap_two": json.loads(json.dumps(good)), "duplicate": json.loads(json.dumps(good)),
   692	                "out_of_range": json.loads(json.dumps(good))}
   693	    variants["swap_two"][0], variants["swap_two"][1] = variants["swap_two"][1], variants["swap_two"][0]
   694	    variants["duplicate"][1][1][0] = variants["duplicate"][0][1][0]
   695	    variants["out_of_range"][-1][1][0] = easy["root_exponent_range"][1] + 1
   696	    corruptions = {}
   697	    for name, candidate in variants.items():
   698	        ok, reason = verify(easy, candidate)
   699	        corruptions[name] = {"rejected": not ok, "reason": reason}
   700	    reasons = {item["reason"] for item in corruptions.values()}
   701	    report["G2_rejects_corruption"] = {"pass": all(x["rejected"] for x in corruptions.values()) and len(reasons) == 5,
   702	                                        "cases": corruptions, "distinct_reasons": len(reasons)}
   703	
   704	    encoded = json.dumps(good, separators=(",", ":"))
   705	    prose = "I used exact coefficients.\n<answer>\n```json\n" + encoded + "\n```\n</answer>\n"
   706	    report["G3_round_trip"] = {"pass": parse_answer(prose) == good and parse_answer(encoded) == good and parse_answer("garbage") is None,
   707	                                "model_style": parse_answer(prose) == good, "raw": parse_answer(encoded) == good,
   708	                                "garbage_rejected": parse_answer("garbage") is None}
   709	
   710	    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
   711	    shipping = make_instance(seed=314159, **shipping_params)
   712	    space = search_space(shipping)
   713	    guess_rng = random.Random(271828)
   714	    samples = 200_000
   715	    # Multiplication by a nonzero Laurent polynomial is injective over Z[x,x^-1],
   716	    # so this instance has exactly one valid Q.  Equality with that canonical Q
   717	    # is therefore the exact hit predicate and avoids redoing the same coefficient
   718	    # comparison 200,000 times; G1 independently checks that Q with verify().
   719	    hits = sum(int(random_candidate(shipping, guess_rng) == shipping["answer"])
   720	               for _ in range(samples))
   721	    exact_density_text = "1/" + str(space)
   722	    density_log10 = -math.log10(space)
   723	    report["G4_guess_resistance"] = {"pass": samples >= 200_000 and hits / samples < 1e-6 and 1 / space < 1e-6,
   724	                                      "hits": hits, "total": samples, "sampled_probability": hits / samples,
   725	                                      "exact_structure_aware_probability": exact_density_text,
   726	                                      "exact_probability_log10": density_log10, "candidate_space": space,
   727	                                      "prior": "uniform internal k-term support and uniform bounded positive coefficient compositions, conditioned on the forced endpoints and coefficient sum",
   728	                                      "hit_test": "canonical equality, exact because the Laurent-polynomial multiplier is injective"}
   729	
   730	    started = time.perf_counter()
   731	    dense_answer, dense_operations = _dense_recover(shipping)
