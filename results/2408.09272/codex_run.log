   511	def _canonical_payload(inst, reflected=False):
   512	    runs, error = _normalise_runs(inst["level_runs"])
   513	    if error:
   514	        raise ValueError(error)
   515	    if reflected:
   516	        runs = sorted([[-hi, -lo, value] for lo, hi, value in runs])
   517	    shift = runs[0][0]
   518	    normal = [[lo - shift, hi - shift, value] for lo, hi, value in runs]
   519	    return [int(inst["ribbon_length"]), int(inst["term_count"]), int(inst["coefficient_bound"]), normal]
