   306	def verify(inst, answer):
   307	    if not isinstance(answer, list):
   308	        return False, "answer must be a JSON list"
   309	    if not answer:
   310	        return False, "answer is empty"
   311	    expected_terms = int(inst.get("term_count", -1))
   312	    if len(answer) != expected_terms:
   313	        return False, f"wrong term count: expected {expected_terms} nonzero terms"
   314	    parsed = []
   315	    for term in answer:
   316	        if not (isinstance(term, list) and len(term) == 2
   317	                and isinstance(term[0], list) and len(term[0]) == 2
   318	                and isinstance(term[1], list) and len(term[1]) == 1
   319	                and all(_is_int(v) for v in term[0] + term[1])):
   320	            return False, "each term must have exact form [[integer,integer],[integer]]"
   321	        numerator, denominator = term[0]
   322	        exponent = term[1][0]
   323	        if denominator != 1:
   324	            return False, "every coefficient denominator must equal 1"
   325	        if not 1 <= numerator <= int(inst["coefficient_bound"]):
   326	            return False, "coefficient is outside the stated positive bound"
   327	        parsed.append((exponent, numerator))
   328	    exponents = [exponent for exponent, _ in parsed]
   329	    if len(set(exponents)) != len(exponents):
   330	        return False, "duplicate exponent"
   331	    if exponents != sorted(exponents):
   332	        return False, "terms are not sorted by increasing exponent"
   333	    root_range = inst.get("root_exponent_range")
   334	    if not (isinstance(root_range, list) and len(root_range) == 2 and all(_is_int(v) for v in root_range)):
   335	        return False, "instance root range is malformed"
   336	    if any(exponent < root_range[0] or exponent > root_range[1] for exponent in exponents):
   337	        return False, "exponent is outside the inclusive root range"
   338	    try:
   339	        wanted = _cached_run_events(tuple(tuple(run) for run in inst.get("level_runs", [])))
   340	    except (TypeError, ValueError) as error:
   341	        return False, "instance level data are inconsistent: " + str(error)
   342	    ribbon_length = inst.get("ribbon_length")
   343	    if not _is_int(ribbon_length) or ribbon_length < 2:
   344	        return False, "instance ribbon length is malformed"
   345	    obtained = {}
   346	    for exponent, coefficient in parsed:
   347	        _add_event(obtained, exponent, coefficient)
   348	        _add_event(obtained, exponent + ribbon_length, -coefficient)
   349	    if obtained != wanted:
   350	        return False, "polynomial identity does not match the level counts"
   351	    return True, "ok"
