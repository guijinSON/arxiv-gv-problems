    last_intervals = _merge_intervals(slices[-1]["intervals"])
    # Only positions reachable within L steps of the root can matter.
    x0 = inst["target_root"][0]
    L = len(slices)
    for x in range(x0, x0 + L):
        if _contains(last_intervals, x):
            suffix[-1][x] = 1
    for j in range(L - 2, -1, -1):
        intervals = _merge_intervals(slices[j]["intervals"])
        for x in range(x0, x0 + j + 1):
            if _contains(intervals, x):
                c = suffix[j + 1].get(x, 0) + suffix[j + 1].get(x + 1, 0)
                if c:
                    suffix[j][x] = c
    x, y = inst["target_root"]
    path = [[x, y]]
    for j in range(L - 1):
        north = suffix[j + 1].get(x, 0)
        east = suffix[j + 1].get(x + 1, 0)
        total = north + east
        if total <= 0:
            return []
        pick = rng.randrange(total)
        if pick < north:
            y += 1
        else:
            x += 1
        path.append([x, y])
    return path


