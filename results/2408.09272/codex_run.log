+    if reflected:
+        runs = sorted([[-hi, -lo, value] for lo, hi, value in runs])
+    shift = runs[0][0]
+    normal = [[lo - shift, hi - shift, value] for lo, hi, value in runs]
+    return [int(inst["ribbon_length"]), int(inst["term_count"]), int(inst["coefficient_bound"]), normal]
