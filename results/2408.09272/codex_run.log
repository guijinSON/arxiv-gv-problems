   621	def _attack_candidates(inst):
   622	    runs, _ = _normalise_runs(inst["level_runs"])
   623	    events = _events_from_runs(runs)
   624	    ordered = sorted(events.items())
   625	    endpoint_pairing = []
   626	    for exponent, delta in ordered:
   627	        if delta > 0:
   628	            endpoint_pairing.append((exponent, delta))
   629	        else:
   630	            endpoint_pairing.append((exponent - int(inst["ribbon_length"]), -delta))
   631	    return {
   632	        "greedy_positive_boundaries": _attack_candidate(inst, [(e, d) for e, d in ordered if d > 0]),
   633	        "outlier_largest_boundary_jumps": _attack_candidate(inst, sorted(ordered, key=lambda z: (-abs(z[1]), z[0]))),
   634	        "obvious_run_start_ansatz": _attack_candidate(inst, [(lo, c) for lo, _hi, c in runs]),
   635	        "in_context_endpoint_pairing": _attack_candidate(inst, endpoint_pairing),
   636	    }
