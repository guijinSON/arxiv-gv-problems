   576	def _attack_candidate(inst, raw_terms):
   577	    lo, hi, k, bound, total, left_coefficient, right_coefficient = _candidate_constraints(inst)
   578	    chosen = {}
   579	    for exponent, coefficient in raw_terms:
   580	        if lo < exponent < hi and exponent not in chosen:
   581	            chosen[exponent] = max(1, min(bound, abs(int(coefficient)) or 1))
   582	        if len(chosen) == k - 2:
   583	            break
   584	    cursor = lo + 1
   585	    while len(chosen) < k - 2:
   586	        if cursor not in chosen:
   587	            chosen[cursor] = 1
   588	        cursor += 1
   589	
   590	    # Give every attack all constraints stated in the output language.  Repair
   591	    # its guessed internal coefficients to the forced total without changing
   592	    # its chosen support or favoring the planted answer.
   593	    ordered = sorted(chosen.items())
   594	    target = total - left_coefficient - right_coefficient
   595	    delta = target - sum(coefficient for _exponent, coefficient in ordered)
   596	    while delta > 0:
   597	        moved = 0
   598	        for index, (exponent, coefficient) in enumerate(ordered):
   599	            step = min(bound - coefficient, delta)
   600	            ordered[index] = (exponent, coefficient + step)
   601	            delta -= step
   602	            moved += step
   603	            if delta == 0:
   604	                break
   605	        if moved == 0:
   606	            raise AssertionError("cannot repair attack coefficient sum upward")
   607	    while delta < 0:
   608	        moved = 0
   609	        for index, (exponent, coefficient) in enumerate(ordered):
   610	            step = min(coefficient - 1, -delta)
   611	            ordered[index] = (exponent, coefficient - step)
   612	            delta += step
   613	            moved += step
   614	            if delta == 0:
   615	                break
   616	        if moved == 0:
   617	            raise AssertionError("cannot repair attack coefficient sum downward")
   618	    return _answer_from_terms([(lo, left_coefficient), *ordered, (hi, right_coefficient)])
