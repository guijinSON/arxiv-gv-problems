   486	def _dense_recover(inst):
   487	    runs, error = _normalise_runs(inst["level_runs"])
   488	    if error:
   489	        return None, 0
   490	    ribbon_length = int(inst["ribbon_length"])
   491	    first_level, last_level = runs[0][0], runs[-1][1]
   492	    ring = [0] * ribbon_length
   493	    pointer = 0
   494	    previous_sigma = 0
   495	    terms = []
   496	    iterations = 0
   497	    for level in range(first_level, last_level + 1):
   498	        while pointer < len(runs) and level > runs[pointer][1]:
   499	            pointer += 1
   500	        sigma = runs[pointer][2] if pointer < len(runs) and runs[pointer][0] <= level <= runs[pointer][1] else 0
   501	        slot = (level - first_level) % ribbon_length
   502	        tau = sigma - previous_sigma + ring[slot]
   503	        ring[slot] = tau
   504	        if tau:
   505	            terms.append((level, tau))
   506	        previous_sigma = sigma
   507	        iterations += 1
   508	    return _answer_from_terms(terms), iterations * 3
