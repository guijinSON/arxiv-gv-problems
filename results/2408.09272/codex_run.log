   380	@functools.lru_cache(maxsize=128)
   381	def _bounded_composition_table(length, total, bound):
   382	    """Counts of ordered positive bounded compositions, cached for G4 sampling."""
   383	    rows = [[1] + [0] * total]
   384	    for used in range(1, length + 1):
   385	        previous = rows[-1]
   386	        current = [0] * (total + 1)
   387	        for subtotal in range(total + 1):
   388	            current[subtotal] = sum(
   389	                previous[subtotal - value]
   390	                for value in range(1, min(bound, subtotal) + 1)
   391	            )
   392	        rows.append(current)
   393	    return tuple(tuple(row) for row in rows)
   394	
   395	
   396	def _bounded_composition_count(length, total, bound):
   397	    if length < 0 or total < 0:
   398	        return 0
   399	    return _bounded_composition_table(length, total, bound)[length][total]
   400	
   401	
   402	def _sample_bounded_composition(rng, length, total, bound):
   403	    table = _bounded_composition_table(length, total, bound)
   404	    if table[length][total] <= 0:
   405	        raise ValueError("bounded coefficient language is empty")
   406	    answer = []
   407	    # One uniformly sampled rank identifies one uniformly sampled composition;
   408	    # carrying that rank down the DP table avoids dozens of large-integer RNG
   409	    # calls per G4 candidate.
   410	    ticket = rng.randrange(table[length][total])
   411	    for remaining in range(length, 0, -1):
   412	        for value in range(1, bound + 1):
   413	            if not 0 <= total - value < len(table[remaining - 1]):
   414	                continue
   415	            completions = table[remaining - 1][total - value]
   416	            if ticket < completions:
   417	                answer.append(value)
   418	                total -= value
   419	                break
   420	            ticket -= completions
   421	        else:
   422	            raise AssertionError("composition sampler lost its count")
   423	    if total:
   424	        raise AssertionError("composition sampler left a nonzero remainder")
   425	    return answer
