   647	        and [exponent for exponent, _coefficient, _denominator in parsed]
   648	            == sorted({exponent for exponent, _coefficient, _denominator in parsed})
   649	        and parsed[0] == (lo, left_coefficient, 1)
   650	        and parsed[-1] == (hi, right_coefficient, 1)
   651	        and all(lo <= exponent <= hi and denominator == 1 and 1 <= coefficient <= bound
   652	                for exponent, coefficient, denominator in parsed)
   653	        and sum(coefficient for _exponent, coefficient, _denominator in parsed) == total
