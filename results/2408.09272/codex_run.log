   270	_ANSWER_TAG = re.compile(r"<answer\b[^>]*>(.*?)</answer>", re.I | re.S)
   271	_FENCE = re.compile(r"^\s*```(?:json)?\s*(.*?)\s*```\s*$", re.I | re.S)
   272	_FENCE_ANYWHERE = re.compile(r"```(?:json)?\s*(.*?)\s*```", re.I | re.S)
