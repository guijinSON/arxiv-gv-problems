   527	def escalate(params):
   528	    harder = dict(params)
   529	    harder["n"] = int(harder["n"]) * 4 + 1
   530	    harder["terms"] = int(harder.get("terms", 48))
   531	    harder["chains"] = min(harder["terms"] // 3,
   532	                            int(harder.get("chains", 12)) + 1)
   533	    harder["coeff_bound"] = int(harder.get("coeff_bound", 9)) * 2 + 1
   534	    # Atom count stays fixed, but decimal numerals can eventually hit the
   535	    # character cap.  This conservative upper bound stops only at that limit.
   536	    per_term_chars = (12 + len(str(harder["coeff_bound"]))
   537	                       + len(str(-8 * harder["n"])))
   538	    if harder["terms"] * per_term_chars + 1 > 2000:
   539	        return "cap_bound"
   540	    return harder
