   449	def enumerate_all(inst):
   450	    if search_space(inst) > 200_000:
   451	        return None
   452	    lo, hi, k, bound, total, left_coefficient, right_coefficient = _candidate_constraints(inst)
   453	    remaining = total - left_coefficient - right_coefficient
   454	    hits = 0
   455	    for support in itertools.combinations(range(lo + 1, hi), k - 2):
   456	        for coefficients in itertools.product(range(1, bound + 1), repeat=k - 2):
   457	            if sum(coefficients) != remaining:
   458	                continue
   459	            terms = [(lo, left_coefficient), *zip(support, coefficients), (hi, right_coefficient)]
   460	            hits += int(verify(inst, _answer_from_terms(terms))[0])
   461	    return hits
