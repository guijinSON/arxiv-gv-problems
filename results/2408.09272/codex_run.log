   428	def random_candidate(inst, rng):
   429	    lo, hi, k, bound, total, left_coefficient, right_coefficient = _candidate_constraints(inst)
   430	    internal_support = sorted(rng.sample(range(lo + 1, hi), k - 2))
   431	    internal_coefficients = _sample_bounded_composition(
   432	        rng, k - 2, total - left_coefficient - right_coefficient, bound)
   433	    terms = [(lo, left_coefficient)]
   434	    terms.extend(zip(internal_support, internal_coefficients))
   435	    terms.append((hi, right_coefficient))
   436	    return _answer_from_terms(terms)
