   464	def _sparse_recover(inst):
   465	    runs, error = _normalise_runs(inst["level_runs"])
   466	    if error:
   467	        return None, 0
   468	    residual = _events_from_runs(runs)
   469	    ribbon_length = int(inst["ribbon_length"])
   470	    terms = []
   470	    terms = []
   471	    arithmetic_operations = 2 * len(runs)
   472	    guard = 4 * int(inst["term_count"]) + 4 * len(runs) + 10
   473	    while residual and len(terms) <= guard:
   474	        exponent = min(residual)
   475	        coefficient = residual.pop(exponent)
   476	        if coefficient <= 0:
   477	            return None, arithmetic_operations
   478	        terms.append((exponent, coefficient))
   479	        _add_event(residual, exponent + ribbon_length, coefficient)
   480	        arithmetic_operations += 1
   481	    if residual:
   482	        return None, arithmetic_operations
   483	    return _answer_from_terms(terms), arithmetic_operations
