@@ -0,0 +1,905 @@
+"""Verified Track-B generator based on Lemma 1 of arXiv:2408.09272.
+
+The native task is to recover one ribbon from a lattice-square region when all
+root squares are prescribed.  Instances are inverse-generated from a monotone
+family of noncrossing ribbons.  Verification independently applies the paper's
+left-to-right ordering rule; it never consults the planted answer.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "other",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "finite lattice-square region encoded by inclusive level intervals",
+        "prescribed root squares of monotone ribbon tiles",
+    ],
+    "verification_operations": [
+        "exact integer coordinate comparison",
+        "north/east lattice adjacency",
+        "left-to-right rank selection",
+        "exact interval membership",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "A tile keeps its left-to-right rank from one level to the next; without "
+        "that invariant a solver expands and matches every square in every level."
+    ),
+    "hardness_basis": (
+        "Track B: Sheffield's full level-sweep construction, cited in Section 1, "
+        "is O(A); at the hard preset it visits 45,088,768 level cells, while "
+        "rank-selecting the target ribbon takes at most 281 exact comparisons and "
+        "endpoint additions (wall-clock measured in selftest)."
+    ),
+    "max_answer_tokens": 300,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 12, "ribbon_len": 5},
+    "easy": {"n": 65_536, "ribbon_len": 29},
+    "medium": {"n": 262_144, "ribbon_len": 37},
+    "hard": {"n": 1_048_576, "ribbon_len": 43},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "A ribbon's left-to-right rank among the level cells is invariant throughout the level sweep."
+)
+PLACEBO_HINT = (
+    "Careful bookkeeping of all the interval endpoints helps prevent indexing errors in this problem."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list of exactly ribbon_len integer coordinate pairs, beginning at "
+        "the marked root and taking one north-or-east unit step each time; instance "
+        "bounds make this a finite set of at most 2^(ribbon_len-1) paths."
+    ),
+    "bounds": {
+        "max_path_length_at_named_presets": 43,
+        "step_choices": 2,
+        "coordinates": "bounded by the finite rendered region",
+    },
+}
+
+NOTES = """Section 1, Definition 1 fixes ribbons as north/east paths of unit
+squares.  Section 2 fixes levels and the left-of order.  Section 3, Lemma 1 is
+the load-bearing result: prescribed roots determine the tiling by preserving
+left-to-right order between consecutive levels.  Section 1 also identifies the
+easy regime that rules out Track A: Sheffield produces a tiling of a simply
+connected region in time linear in its area, while existence for regions with
+holes is open.  This module therefore declares Track B and asks only for the
+ribbon belonging to one marked prescribed root.  The full reference sweep
+touches width*ribbon_len cells; the compact route rank-selects one interval on
+each level.  Plants and decoys are generated by the same threshold process, and
+the marked root lies in a broad plateau of roots with the same path statistics.
+North-first, east-first, alternating, local-centering, and 256-restart attacks
+are measured in selftest; none uses the rank invariant."""
+
+
+def _merge_intervals(intervals):
+    """Return sorted, disjoint inclusive integer intervals."""
+    data = sorted((int(a), int(b)) for a, b in intervals)
+    out = []
+    for a, b in data:
+        if a > b:
+            raise ValueError("reversed interval")
+        if out and a <= out[-1][1] + 1:
+            out[-1][1] = max(out[-1][1], b)
+        else:
+            out.append([a, b])
+    return out
+
+
+def _intervals_from_thresholds(width, thresholds):
+    """Compress {i + #{t <= i}: 0 <= i < width} into intervals."""
+    multiplicity = {}
+    for q in thresholds:
+        multiplicity[q] = multiplicity.get(q, 0) + 1
+    start = 0
+    shift = 0
+    out = []
+    for q in sorted(multiplicity):
+        if start <= q - 1:
+            out.append([start + shift, q - 1 + shift])
+        shift += multiplicity[q]
+        start = q
+    if start <= width - 1:
+        out.append([start + shift, width - 1 + shift])
+    return out
+
+
+def _translate_intervals(intervals, dx):
+    return [[a + dx, b + dx] for a, b in intervals]
+
+
+def _swap_level_intervals(level, intervals):
+    # At fixed level l=x+y, swapping x and y sends x to l-x.
+    return _merge_intervals([[level - b, level - a] for a, b in intervals])
+
+
+def _word_is_too_obvious(bits):
+    if not bits:
+        return True
+    patterns = [
+        [0] * len(bits),
+        [1] * len(bits),
+        [j % 2 for j in range(len(bits))],
+        [1 - (j % 2) for j in range(len(bits))],
+    ]
+    return any(bits == p for p in patterns)
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a valid prescribed-root ribbon region.
+
+    ``n`` is the number of roots/ribbons (the haystack width), not the ribbon
+    length.  The planted target word is sampled first.  At each step a threshold
+    makes every ribbon below it move north and every ribbon at or above it move
+    east; this preserves strict left-to-right order and therefore composes into
+    a certified tiling.
+    """
+    width = int(n)
+    ribbon_len = int(params.get("ribbon_len", 29))
+    if ribbon_len < 2:
+        raise ValueError("ribbon_len must be at least 2")
+    if width < max(10, 2 * ribbon_len + 2):
+        raise ValueError("n is too small for the requested ribbon length")
+
+    rng = random.Random(seed)
+    lo_rank = max(ribbon_len, (9 * width) // 20)
+    hi_rank = min(width - ribbon_len - 1, (11 * width) // 20)
+    if lo_rank > hi_rank:
+        lo_rank, hi_rank = width // 3, (2 * width) // 3
+    target_rank = rng.randint(lo_rank, hi_rank)
+
+    steps = ribbon_len - 1
+    min_each = max(1, steps // 3)
+    max_east = min(steps - min_each, (2 * steps) // 3)
+    while True:
+        east_count = rng.randint(min_each, max_east)
+        east_slots = set(rng.sample(range(steps), east_count))
+        bits = [1 if j in east_slots else 0 for j in range(steps)]
+        if not _word_is_too_obvious(bits):
+            break
+
+    # Keep every threshold farther than ribbon_len from the marked rank.  Hence
+    # every locally possible N/E path from the marked root remains in the region;
+    # random_candidate can sample the exact structure-aware language uniformly.
+    margin = ribbon_len + 2 if width >= 8 * ribbon_len else 0
+    low_pool = list(range(1 + margin, target_rank - margin))
+    high_pool = list(range(target_rank + margin + 1, width - margin))
+    need_low = sum(bits)
+    need_high = steps - need_low
+    if len(low_pool) < need_low or len(high_pool) < need_high:
+        low_pool = list(range(1, target_rank))
+        high_pool = list(range(target_rank + 1, width))
+    lows = iter(rng.sample(low_pool, need_low))
+    highs = iter(rng.sample(high_pool, need_high))
+    thresholds = [next(lows) if bit else next(highs) for bit in bits]
+
+    dx = rng.randint(-width, width)
+    dy = rng.randint(-width, width)
+    level0 = dx + dy
+    swap_axes = bool(rng.getrandbits(1))
+
+    slices = []
+    prefix = []
+    for j in range(ribbon_len):
+        base = _intervals_from_thresholds(width, prefix)
+        level = level0 + j
+        intervals = _translate_intervals(base, dx)
+        if swap_axes:
+            intervals = _swap_level_intervals(level, intervals)
+        slices.append({"level": level, "intervals": intervals})
+        if j < steps:
+            prefix.append(thresholds[j])
+
+    path = []
+    east_so_far = 0
+    for j in range(ribbon_len):
+        bx = target_rank + east_so_far
+        x, y = dx + bx, dy + j - bx
+        if swap_axes:
+            x, y = y, x
+        path.append([x, y])
+        if j < steps:
+            east_so_far += bits[j]
+
+    return {
+        "ribbon_length": ribbon_len,
+        "width": width,
+        "slices": slices,
+        "target_root": list(path[0]),
+        "answer": path,
+    }
+
+
+def _sorted_slices(inst):
+    return sorted(inst["slices"], key=lambda s: int(s["level"]))
+
+
+def _contains(intervals, x):
+    for a, b in intervals:
+        if a <= x <= b:
+            return True
+        if x < a:
+            return False
+    return False
+
+
+def _rank_of(intervals, x):
+    rank = 0
+    for a, b in intervals:
+        if x < a:
+            return None
+        if x <= b:
+            return rank + x - a
+        rank += b - a + 1
+    return None
+
+
+def _select_rank(intervals, rank):
+    if rank < 0:
+        return None
+    left = rank
+    for a, b in intervals:
+        size = b - a + 1
+        if left < size:
+            return a + left
+        left -= size
+    return None
+
+
+def _target_path(inst):
+    """Independently recover the target via Lemma 1; never read answer."""
+    slices = _sorted_slices(inst)
+    if len(slices) != int(inst["ribbon_length"]):
+        return None
+    root = inst["target_root"]
+    if not (
+        isinstance(root, list)
+        and len(root) == 2
+        and all(isinstance(v, int) and not isinstance(v, bool) for v in root)
+    ):
+        return None
+    if root[0] + root[1] != int(slices[0]["level"]):
+        return None
+    first = _merge_intervals(slices[0]["intervals"])
+    rank = _rank_of(first, root[0])
+    if rank is None:
+        return None
+    path = []
+    expected_level = int(slices[0]["level"])
+    for sl in slices:
+        level = int(sl["level"])
+        if level != expected_level:
+            return None
+        intervals = _merge_intervals(sl["intervals"])
+        x = _select_rank(intervals, rank)
+        if x is None:
+            return None
+        path.append([x, level - x])
+        expected_level += 1
+    return path
+
+
+def _ranked_interval_text(intervals):
+    fields = []
+    r = 0
+    for a, b in _merge_intervals(intervals):
+        end = r + b - a
+        fields.append(f"ranks {r}..{end}: [{a},{b}]")
+        r = end + 1
+    return "; ".join(fields)
+
+
+def render(inst):
+    slices = _sorted_slices(inst)
+    lines = [
+        "TARGET RIBBON IN A PRESCRIBED-ROOT TILING",
+        "",
+        "A lattice square is named by the integer coordinates [x,y] of its lower-left corner.",
+        "Its level is l=x+y. An L-ribbon is exactly L distinct squares beginning at a",
+        "root square and taking one unit step north ([x,y] to [x,y+1]) or east",
+        "([x,y] to [x+1,y]) at every successive level.",
+        "",
+        "The finite region below is specified level by level. On a line for level l,",
+        "each inclusive interval [a,b] means that every square [x,l-x] with a<=x<=b",
+        "belongs to the region. Intervals on the same line are disjoint. The annotations",
+        "'ranks u..v' number those cells from left to right starting at rank 0; they are",
+        "redundant exact indexing aids, not extra cells.",
+        "",
+        f"Ribbon length L: {inst['ribbon_length']}",
+        f"Number of ribbons: {inst['width']}",
+        (
+            "Prescribed roots: every region square on the smallest displayed level, "
+            "and no other square."
+        ),
+        f"Marked root: {json.dumps(inst['target_root'], separators=(',', ':'))}",
+        "",
+        "Region slices:",
+    ]
+    for sl in slices:
+        lines.append(
+            f"level {sl['level']}: " + _ranked_interval_text(sl["intervals"])
+        )
+    lines += [
+        "",
+        "Promise: these prescribed roots determine a valid tiling of the whole region.",
+        "Find the unique L-ribbon in that tiling whose root is the marked root. List all",
+        "L squares in increasing level order, including the root and end square. Coordinates",
+        "are exact integers; order matters; repeats are forbidden; interval endpoints are inclusive.",
+    ]
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines += ["", "Hint: " + STRUCTURAL_HINT]
+    elif mode == "placebo":
+        lines += ["", "Hint: " + PLACEBO_HINT]
+    lines += [
+        "",
+        "Give your final answer inside <answer></answer> tags as a JSON array of [x,y] pairs.",
+        "Example format: <answer>[[2,5],[3,5],[3,6]]</answer>",
+        "Output nothing else inside the tags.",
+    ]
+    return "\n".join(lines)
+
+
+_ANSWER_TAG = re.compile(r"<answer\b[^>]*>(.*?)</answer>", re.I | re.S)
+_FENCE = re.compile(r"^\s*```(?:json)?\s*(.*?)\s*```\s*$", re.I | re.S)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    m = _ANSWER_TAG.search(text)
+    body = m.group(1) if m else text.strip()
+    f = _FENCE.match(body)
+    if f:
+        body = f.group(1)
+    try:
+        value = json.loads(body.strip())
+    except (ValueError, TypeError):
+        return None
+    if not isinstance(value, list):
+        return None
+    for pair in value:
+        if not (
+            isinstance(pair, list)
+            and len(pair) == 2
+            and all(isinstance(v, int) and not isinstance(v, bool) for v in pair)
+        ):
+            return None
+    return value
+
+
+def verify(inst, answer):
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    for pair in answer:
+        if not (
+            isinstance(pair, list)
+            and len(pair) == 2
+            and all(isinstance(v, int) and not isinstance(v, bool) for v in pair)
+        ):
+            return False, "every square must be one integer [x,y] pair"
+    length = int(inst["ribbon_length"])
+    if len(answer) != length:
+        return False, f"wrong path length: expected {length} squares"
+    if answer[0] != inst["target_root"]:
+        return False, "path does not start at the marked root"
+    if len({(x, y) for x, y in answer}) != len(answer):
+        return False, "path repeats a square"
+
+    by_level = {int(s["level"]): _merge_intervals(s["intervals"]) for s in inst["slices"]}
+    for x, y in answer:
+        level = x + y
+        if level not in by_level or not _contains(by_level[level], x):
+            return False, "path contains a square outside the region"
+    for j in range(1, len(answer)):
+        x0, y0 = answer[j - 1]
+        x1, y1 = answer[j]
+        if (x1 - x0, y1 - y0) not in ((0, 1), (1, 0)):
+            return False, f"non-ribbon step at positions {j-1} and {j}"
+
+    expected = _target_path(inst)
+    if expected is None:
+        return False, "instance root data are inconsistent"
+    if answer != expected:
+        return False, "path is not the marked ribbon fixed by left-to-right root order"
+    return True, "ok"
+
+
+def _candidate_counts(inst):
+    """DP counts of all region-contained monotone paths from the target root."""
+    slices = _sorted_slices(inst)
+    root = tuple(inst["target_root"])
+    states = {root[0]: 1}
+    counts_by_level = [states]
+    for sl in slices[1:]:
+        intervals = _merge_intervals(sl["intervals"])
+        nxt = {}
+        for x, count in states.items():
+            for nx in (x, x + 1):
+                if _contains(intervals, nx):
+                    nxt[nx] = nxt.get(nx, 0) + count
+        states = nxt
+        counts_by_level.append(states)
+    return counts_by_level, sum(states.values())
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the exact language of in-region north/east paths."""
+    slices = _sorted_slices(inst)
+    # Backward DP: suffix[j][x] is the number of completions from x on level j.
+    suffix = [{} for _ in slices]
+    last_intervals = _merge_intervals(slices[-1]["intervals"])
+    # Only positions reachable within L steps of the root can matter.
+    x0 = inst["target_root"][0]
+    L = len(slices)
+    for x in range(x0, x0 + L):
+        if _contains(last_intervals, x):
+            suffix[-1][x] = 1
+    for j in range(L - 2, -1, -1):
+        intervals = _merge_intervals(slices[j]["intervals"])
+        for x in range(x0, x0 + j + 1):
+            if _contains(intervals, x):
+                c = suffix[j + 1].get(x, 0) + suffix[j + 1].get(x + 1, 0)
+                if c:
+                    suffix[j][x] = c
+    x, y = inst["target_root"]
+    path = [[x, y]]
+    for j in range(L - 1):
+        north = suffix[j + 1].get(x, 0)
+        east = suffix[j + 1].get(x + 1, 0)
+        total = north + east
+        if total <= 0:
+            return []
+        pick = rng.randrange(total)
+        if pick < north:
+            y += 1
+        else:
+            x += 1
+        path.append([x, y])
+    return path
+
+
+def search_space(inst):
+    return _candidate_counts(inst)[1]
+
+
+def enumerate_all(inst):
+    total = search_space(inst)
+    if total > 200_000:
+        return None
+    length = int(inst["ribbon_length"])
+    hits = 0
+    rootx, rooty = inst["target_root"]
+    for mask in range(1 << (length - 1)):
+        x, y = rootx, rooty
+        path = [[x, y]]
+        for j in range(length - 1):
+            if (mask >> j) & 1:
+                x += 1
+            else:
+                y += 1
+            path.append([x, y])
+        if verify(inst, path)[0]:
+            hits += 1
+    return hits
+
+
+def _canonical_payload(inst, swapped):
+    slices = _sorted_slices(inst)
+    l0 = int(slices[0]["level"])
+    tx, ty = inst["target_root"]
+    rows = []
+    for sl in slices:
+        level = int(sl["level"])
+        intervals = _merge_intervals(sl["intervals"])
+        if swapped:
+            normalized = _merge_intervals(
+                [[level - b - ty, level - a - ty] for a, b in intervals]
+            )
+        else:
+            normalized = [[a - tx, b - tx] for a, b in intervals]
+        rows.append([level - l0, normalized])
+    return [int(inst["ribbon_length"]), int(inst["width"]), rows]
+
+
+def canonical_key(inst):
+    forms = [
+        json.dumps(_canonical_payload(inst, False), separators=(",", ":")),
+        json.dumps(_canonical_payload(inst, True), separators=(",", ":")),
+    ]
+    structural = min(forms).encode("utf-8")
+    return hashlib.sha256(structural).hexdigest()
+
+
+def escalate(params):
+    out = dict(params)
+    out["n"] = int(out["n"]) * 4
+    # The 43-square certificate stays fixed; only the ambient haystack grows.
+    out["ribbon_len"] = min(43, int(out.get("ribbon_len", 43)))
+    return out
+
+
+def _translated(inst, dx, dy):
+    out = {
+        "ribbon_length": inst["ribbon_length"],
+        "width": inst["width"],
+        "target_root": [inst["target_root"][0] + dx, inst["target_root"][1] + dy],
+        "slices": [],
+    }
+    for sl in inst["slices"]:
+        out["slices"].append(
+            {
+                "level": sl["level"] + dx + dy,
+                "intervals": _translate_intervals(sl["intervals"], dx),
+            }
+        )
+    if "answer" in inst:
+        out["answer"] = [[x + dx, y + dy] for x, y in inst["answer"]]
+    return out
+
+
+def _swapped(inst):
+    out = {
+        "ribbon_length": inst["ribbon_length"],
+        "width": inst["width"],
+        "target_root": [inst["target_root"][1], inst["target_root"][0]],
+        "slices": [],
+    }
+    for sl in inst["slices"]:
+        out["slices"].append(
+            {
+                "level": sl["level"],
+                "intervals": _swap_level_intervals(sl["level"], sl["intervals"]),
+            }
+        )
+    if "answer" in inst:
+        out["answer"] = [[y, x] for x, y in inst["answer"]]
+    return out
+
+
+def _reordered(inst, rng):
+    out = {
+        "ribbon_length": inst["ribbon_length"],
+        "width": inst["width"],
+        "target_root": list(inst["target_root"]),
+        "slices": [],
+    }
+    for sl in inst["slices"]:
+        intervals = [list(ab) for ab in sl["intervals"]]
+        rng.shuffle(intervals)
+        out["slices"].append({"level": sl["level"], "intervals": intervals})
+    rng.shuffle(out["slices"])
+    if "answer" in inst:
+        out["answer"] = [list(p) for p in inst["answer"]]
+    return out
+
+
+def _reference_level_sweep(inst):
+    """Actually visit every level cell, as the full reconstruction does."""
+    slices = _sorted_slices(inst)
+    rank = _rank_of(_merge_intervals(slices[0]["intervals"]), inst["target_root"][0])
+    path = []
+    operations = 0
+    for sl in slices:
+        selected = None
+        pos = 0
+        for a, b in _merge_intervals(sl["intervals"]):
+            for x in range(a, b + 1):
+                operations += 1
+                if pos == rank:
+                    selected = x
+                pos += 1
+        path.append([selected, sl["level"] - selected])
+    return path, operations
+
+
+def _path_from_policy(inst, policy):
+    slices = _sorted_slices(inst)
+    x, y = inst["target_root"]
+    out = [[x, y]]
+    for j, sl in enumerate(slices[1:], 1):
+        intervals = _merge_intervals(sl["intervals"])
+        choices = [(x, y + 1), (x + 1, y)]
+        pick = policy(j, choices, intervals)
+        x, y = choices[pick]
+        out.append([x, y])
+    return out
+
+
+def _attack_candidates(inst):
+    def north_first(_j, _choices, _intervals):
+        return 0
+
+    def east_first(_j, _choices, _intervals):
+        return 1
+
+    def alternating(j, _choices, _intervals):
+        return j & 1
+
+    def local_center(_j, choices, intervals):
+        center2 = intervals[0][0] + intervals[-1][1]
+        return min(range(2), key=lambda z: abs(2 * choices[z][0] - center2))
+
+    def widest_interval(_j, choices, intervals):
+        def width_at(x):
+            for a, b in intervals:
+                if a <= x <= b:
+                    return b - a + 1
+            return -1
+        return max(range(2), key=lambda z: width_at(choices[z][0]))
+
+    return {
+        "greedy_north_first": _path_from_policy(inst, north_first),
+        "greedy_east_first": _path_from_policy(inst, east_first),
+        "obvious_alternating_ansatz": _path_from_policy(inst, alternating),
+        "outlier_follow_level_center": _path_from_policy(inst, local_center),
+        "greedy_widest_local_interval": _path_from_policy(inst, widest_interval),
+    }
+
+
+def _intended_operations(inst):
+    # Binary search among the rank-annotated intervals, then one subtraction and
+    # one addition to select the x-coordinate, on every level.
+    total = 0
+    for sl in _sorted_slices(inst):
+        count = max(1, len(_merge_intervals(sl["intervals"])))
+        total += math.ceil(math.log2(count)) + 2
+    return total
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(v) for v in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(v) for v in value)
+    return 1
