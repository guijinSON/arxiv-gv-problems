   354	@functools.lru_cache(maxsize=256)
   355	def _candidate_constraints_cached(raw_runs, root_range, ribbon_length, term_count, coefficient_bound):
   356	    runs, error = _normalise_runs([list(run) for run in raw_runs])
   357	    if error:
   358	        raise ValueError(error)
   359	    lo, hi = root_range
   360	    coefficient_sum, remainder = divmod(
   361	        sum((last - first + 1) * value for first, last, value in runs),
   362	        ribbon_length,
   363	    )
   364	    if remainder:
   365	        raise ValueError("level-count sum is not divisible by the ribbon length")
   366	    return (lo, hi, term_count, coefficient_bound,
   367	            coefficient_sum, runs[0][2], runs[-1][2])
