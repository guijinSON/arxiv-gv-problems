   439	def search_space(inst):
   440	    lo, hi, k, bound, total, left_coefficient, right_coefficient = _candidate_constraints(inst)
   441	    positions = hi - lo + 1
   442	    if positions < k:
   443	        return 0
   444	    coefficient_count = _bounded_composition_count(
   445	        k - 2, total - left_coefficient - right_coefficient, bound)
   446	    return math.comb(positions - 2, k - 2) * coefficient_count
