+    remaining = [q for q in others if q not in first_extra]
+    second_extra = set(rng.sample(remaining, n - 1))
+    first = list(first_extra | {planted_class})
+    second = list(second_extra | {planted_class})
+    rng.shuffle(first)
+    rng.shuffle(second)
+    return first, second
