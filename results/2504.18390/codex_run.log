+        doubled_axis = "choices_per_row"
+    else:
+        doubled_params = dict(shipping_params)
+        doubled_params["panels"] *= 2
+        doubled_axis = "panels"
+    doubled = make_instance(seed=314159, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
