+    seen = set()
+    for unit in _UNITS:
+        square = unit * unit % _MOD
+        if square not in seen:
+            seen.add(square)
+            reps.append(unit)
+    if len(reps) != 50:
+        raise AssertionError("Z_125 should have 50 unit square classes modulo sign")
