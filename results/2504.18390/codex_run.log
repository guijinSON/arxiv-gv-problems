+
+def render(inst):
+    """Render a self-contained cyclic difference-family witness problem."""
+    lines = [
+        "CYCLIC 1-ROTATIONAL UNITAL BASE-FAMILY SELECTION",
+        "",
+        "All finite point labels are residues in Z_125, with addition modulo 125.",
