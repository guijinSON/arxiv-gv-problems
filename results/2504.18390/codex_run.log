+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def _central_moment(block, degree):
+    mean = sum(block) * _INV6 % _MOD
+    return sum(pow((x - mean) % _MOD, degree, _MOD) for x in block) % _MOD
