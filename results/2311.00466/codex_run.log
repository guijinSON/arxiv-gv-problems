+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Edges with the same right-label/left-label ratio modulo q form a "
+        "perfect cover, whereas generic matching treats the incidence list mechanically."
+    ),
+    "hardness_basis": (
+        "Track B: Hopcroft-Karp finds a cover in O(|E| sqrt(|V|)); at shipping "
+        "n=151 and degree=14 it averaged 5,008.5 edge scans and 0.0032 seconds "
+        "over eight seeds, while the multiplier invariant needs 152 exact "
