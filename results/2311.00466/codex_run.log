+    "easy": {"n": 77, "q": _Q, "degree": 10},
+    "medium": {"n": 151, "q": _Q, "degree": 14},
+    "hard": {"n": 231, "q": _Q, "degree": 20},
+}
+SHIPPING_DIFFICULTY = "medium"
