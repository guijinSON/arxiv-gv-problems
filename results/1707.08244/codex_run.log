	\draw (6,-.2) -- (5.65,-.35);
	\draw (6,-.2) -- (6.35,-.35);
	\draw[] (5.5,-.5) circle (.2cm);
	\draw[] (6.5,-.5) circle (.2cm);
	\node at (5.5,-.5) {$c_1$};
	\node at (6.5,-.5) {$c_k$};
