+"""Verified generator for a native subpower-membership search family.
+
+The paper defines SMP(A) for a fixed finite algebra A: given generators and a
+target in a direct power A^m, decide whether the target lies in the generated
+subalgebra.  Here A is the additive cyclic group C_1019.  A witness is a group
+term in collected form, namely one coefficient modulo 1019 per generator.
+
+Generation is inverse.  Distinct field labels a_j define Vandermonde generators
+g_j = (a_j^e)_e.  We first choose an odd arithmetic progression of labels, put
+coefficient one on those generators, and add them to obtain the target.  The
+planted term is therefore known without solving the generated instance.
+
+This is explicitly Track B.  Linear algebra solves every instance efficiently,
+and a construction-aware Newton/Vieta algorithm is faster still.  Both are far
+too arithmetic-heavy for the no-tool setting at the shipping preset; recognizing
+the affine symmetry of the planted labels gives a short exact route.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+_P = 1019  # prime and 3 mod 4, so sqrt(x) = x^255 for quadratic residues
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "direct-power vectors over the fixed cyclic group C_1019",
+        "Vandermonde generator tuples",
+        "a group term represented by its coefficient vector",
+    ],
+    "verification_operations": [
+        "exact modular exponentiation",
+        "exact coordinatewise scalar multiplication and addition modulo 1019",
+        "exact vector comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "The unit-coefficient labels form an odd arithmetic progression, so its "
+        "center and squared step are encoded in the first two power sums; without "
+        "that symmetry one must perform sparse interpolation or linear algebra."
+    ),
+    "hardness_basis": (
+        "Track B: Section 1 states that SMP for finite groups is polynomial-time; "
+        "on this promised Vandermonde distribution the successful Newton/Vieta "
+        "sparse-interpolation reference algorithm costs O(k^2+nk) field operations "
+        "and is measured by selftest at the shipping preset (n=120,k=11) as 2,783 "
+        "exact modular operations, whereas the affine-symmetry route uses at most "
+        "92 exact arithmetic operations and the evaluated solver has no CAS."
+    ),
+    "max_answer_tokens": 61,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+# n grows the coefficient haystack.  k grows the work of the generic sparse
+# recovery while the certificate remains a single n-entry coefficient vector.
+DIFFICULTY = {
+    "demo": {"n": 11, "m": 8, "k": 3},
+    "easy": {"n": 80, "m": 18, "k": 7},
+    "medium": {"n": 120, "m": 28, "k": 11},
+    "hard": {"n": 160, "m": 40, "k": 15},
+}
+
+SHIPPING_DIFFICULTY = "medium"
+
+STRUCTURAL_HINT = (
+    "The unit-coefficient field labels form an odd arithmetic progression "
+    "symmetric about its middle."
+)
+PLACEBO_HINT = (
+    "The modular residue calculations reward consistent indexing and careful "
+    "checks across the coordinates."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list of exactly n coefficients in {0,...,1018}, one per displayed "
+        "generator, with coefficient sum congruent to target coordinate 0.  This "
+        "last condition is free from the statement because every generator has "
+        "coordinate 0 equal to one."
+    ),
+    "bounds": {
+        "length": "instance n (11..1019; shipping 160)",
+        "coefficient_min": 0,
+        "coefficient_max": 1018,
+        "obvious_sum_constraint": "sum(coefficients) == target[exponent 0] mod 1019",
+        "shipping_atomic_elements": 160,
+    },
+}
+
+NOTES = (
+    "Section 1 fixes the exact native definition: for a fixed finite algebra A, "
+    "the input consists of tuples a_1,...,a_n,b in A^m and asks whether b is in "
+    "the subalgebra generated by the a_i. The same section supplies the decisive "
+    "easy regime: SMP for finite groups is polynomial-time, so this module is "
+    "Track B and makes no average-case or Track A claim from Theorem 3.1. Theorem "
+    "3.1 also explains why merely evaluating a planted term establishes membership "
+    "but does not establish distributional hardness. Instances are built by choosing "
+    "a term first and evaluating it. Plant and decoy labels have the same uniform "
+    "marginals; a random permutation erases position. Per-column checksum ranking, "
+    "greedy residual minimization, sparse random restarts, and a center-only "
+    "consecutive-label ansatz are tested and fail. The successful Newton/Vieta "
+    "reference algorithm is reported separately, as Track B requires."
+)
+
+
+# Filled from script-owned transcripts after the three hardening runs.  The arms
+# are diagnostic only; G9's answer/effort caps are the gate.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 1, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
+    "hinted_verdict": "too_easy",
+}
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_FENCE_RE = re.compile(r"```(?:json|text)?\s*(.*?)```", re.I | re.S)
+_G4_SAMPLES = 200_000
+_ATTACK_SEEDS = 8
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _inv(value):
+    value %= _P
+    if value == 0:
+        raise ValueError("zero has no inverse modulo 1019")
+    return pow(value, _P - 2, _P)
+
+
+def _validate(n, m, k):
+    for name, value in (("n", n), ("m", m), ("k", k)):
+        if not _is_int(value):
+            raise ValueError(f"{name} must be an integer")
+    if not 3 <= n <= _P:
+        raise ValueError("n must lie in 3..1019")
+    if not 3 <= k <= min(n, 119) or k % 2 == 0:
+        raise ValueError("k must be odd and lie in 3..min(n,119)")
+    if not k + 1 <= m <= min(n, _P - 1):
+        raise ValueError("m must lie in k+1..min(n,1018)")
+
+
+def _generators(labels, exponents):
+    return [[pow(label, exponent, _P) for exponent in exponents]
+            for label in labels]
+
+
+def _linear_combination(generators, coefficients, m):
+    target = []
+    for coordinate in range(m):
+        total = 0
+        for coefficient, generator in zip(coefficients, generators):
+            total = (total + coefficient * generator[coordinate]) % _P
+        target.append(total)
+    return target
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a native SMP instance and its exact group-term witness."""
+    m = params.pop("m", None)
+    k = params.pop("k", None)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate(n, m, k)
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    half = k // 2
+    center = rng.randrange(_P)
+    # Excluding +/-1 makes the explicit center-plus-consecutive in-context
+    # heuristic a genuine failed attack.  Every planted label remains marginally
+    # uniform because the independently uniform center translates the progression.
+    steps = list(range(2, _P - 1))
+    step = steps[rng.randrange(len(steps))]
+    planted_labels = {
+        (center + offset * step) % _P
+        for offset in range(-half, half + 1)
+    }
+    if len(planted_labels) != k:
+        raise AssertionError("arithmetic progression unexpectedly collided")
+
+    remaining = [value for value in range(_P) if value not in planted_labels]
+    decoys = rng.sample(remaining, n - k)
+    labels = list(planted_labels) + decoys
+    rng.shuffle(labels)
+
+    exponents = list(range(m))
+    generators = _generators(labels, exponents)
+    coefficients = [int(label in planted_labels) for label in labels]
+    target = _linear_combination(generators, coefficients, m)
+
+    return {
+        "modulus": _P,
+        "n": n,
+        "m": m,
+        "exponents": exponents,
+        "labels": labels,
+        "generators": generators,
+        "target": target,
+        "answer": coefficients,
+    }
+
+
+def render(inst):
+    """Render the complete exact problem, with no hint unless requested."""
+    n = inst["n"]
+    m = inst["m"]
+    labels = ", ".join(str(value) for value in inst["labels"])
+    exponents = ", ".join(str(value) for value in inst["exponents"])
+    target = ", ".join(str(value) for value in inst["target"])
+    statement = f"""Subpower membership term over the fixed cyclic group C_1019
+
+C_1019 is the set of residues 0,...,1018 with addition and negation modulo
+1019.  Its direct power C_1019^{m} consists of length-{m} residue vectors, and
+all group operations on these vectors are coordinatewise.
+
+There are {n} generators, indexed 0 through {n - 1}.  Their field labels, in
+generator-index order, are:
+[{labels}]
+
+The coordinate exponents, in coordinate order, are:
+[{exponents}]
+
+Generator j is defined exactly by
+    g_j[r] = (label[j] ** exponent[r]) mod 1019
+for every coordinate index r from 0 through {m - 1}.  In particular, exponent
+zero uses a**0 = 1 even when a=0.  This formula is the complete generator data;
+there are no omitted or approximate values.
+
+The target vector, in the same coordinate order, is:
+[{target}]
+
+Find any coefficient vector c such that
+    target[r] = sum(c[j] * g_j[r] for j=0..{n - 1}) mod 1019
+for every coordinate r.  This is a collected group term witnessing that the
+target belongs to the subalgebra generated by the displayed tuples.
+
+Your answer must be one JSON list of exactly {n} integers.  Entry j is the
+coefficient of generator j and must be in the inclusive range 0..1018.  Order
+therefore matters, coefficients may repeat, and all indexing is zero-based.
+
+Give your final answer inside <answer></answer> tags, as a JSON integer list.
+Example syntax for a four-generator instance: <answer>[0, 1, 0, 1018]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Extract the tagged JSON coefficient vector; return None on any garbage."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    fence = _FENCE_RE.fullmatch(payload)
+    if fence:
+        payload = fence.group(1).strip()
+    try:
+        answer = json.loads(payload)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(answer, list):
+        return None
+    if any(not _is_int(value) for value in answer):
+        return None
+    return answer
+
+
+def verify(inst, answer):
+    """Check any coefficient-term witness exactly, never consulting answer."""
+    if not isinstance(answer, list):
+        return False, "answer_not_a_list"
+    if not answer:
+        return False, "empty_answer"
+    n = inst["n"]
+    if len(answer) < n:
+        return False, f"missing_coefficients_expected_{n}_got_{len(answer)}"
+    if len(answer) > n:
+        return False, f"extra_coefficients_expected_{n}_got_{len(answer)}"
+    for index, coefficient in enumerate(answer):
+        if not _is_int(coefficient):
+            return False, f"coefficient_{index}_not_an_integer"
+        if not 0 <= coefficient < _P:
+            return False, f"coefficient_{index}_out_of_range"
+
+    generators = inst["generators"]
+    for coordinate, expected in enumerate(inst["target"]):
+        actual = 0
+        for index, coefficient in enumerate(answer):
+            actual = (actual + coefficient * generators[index][coordinate]) % _P
+        if actual != expected:
+            exponent = inst["exponents"][coordinate]
+            return False, (
+                f"coordinate_{coordinate}_exponent_{exponent}_mismatch_"
+                f"expected_{expected}_got_{actual}"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample uniformly after enforcing the freely visible exponent-zero sum."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    n = inst["n"]
+    coefficients = [rng.randrange(_P) for _ in range(n - 1)]
+    zero_coordinate = inst["exponents"].index(0)
+    final = (inst["target"][zero_coordinate] - sum(coefficients)) % _P
+    coefficients.append(final)
+    return coefficients
+
+
+def search_space(inst):
+    """Size of the exponent-zero-conditioned coefficient language."""
+    return _P ** (inst["n"] - 1)
+
+
+def enumerate_all(inst):
+    """Brute-force only when the declared space is genuinely tiny."""
+    if search_space(inst) > 200_000:
+        return None
+    count = 0
+    rng_values = range(_P)
+    # This branch is unreachable for supported n, but keeps the function exact.
+    if inst["n"] == 1:
+        for value in rng_values:
+            ok, _ = verify(inst, [value])
+            count += int(ok)
+        return count
+    return None
+
+
+def _power_sums_by_exponent(inst):
+    return dict(zip(inst["exponents"], inst["target"]))
+
+
+def _symmetry_candidate(inst):
+    """The compact route: recover the centered odd progression from p1,p2."""
+    sums = _power_sums_by_exponent(inst)
+    if not all(exponent in sums for exponent in (0, 1, 2)):
+        return None
+    k = sums[0] % _P
+    if not 3 <= k <= 119 or k % 2 == 0 or k > inst["n"]:
+        return None
+    half = k // 2
+    center = sums[1] * _inv(k) % _P
+    squared_offsets = sum(offset * offset for offset in range(-half, half + 1)) % _P
+    if squared_offsets == 0:
+        return None
+    step_squared = (
+        (sums[2] - k * center * center) * _inv(squared_offsets)
+    ) % _P
+    step = pow(step_squared, (_P + 1) // 4, _P)
+    if step * step % _P != step_squared:
+        return None
+    roots = {
+        (center + offset * step) % _P
+        for offset in range(-half, half + 1)
+    }
+    if len(roots) != k:
+        return None
+    label_to_index = {label: index for index, label in enumerate(inst["labels"])}
+    if any(root not in label_to_index for root in roots):
+        return None
+    return [int(label in roots) for label in inst["labels"]]
+
+
+def _newton_vieta_candidate(inst):
+    """Construction-aware reference algorithm, with an exact operation count."""
+    sums = _power_sums_by_exponent(inst)
+    k = sums.get(0, 0) % _P
+    if not 1 <= k < min(inst["m"], _P):
+        return None, 0
+    if any(exponent not in sums for exponent in range(1, k + 1)):
+        return None, 0
+
+    elementary = [1]
+    operations = 0
+    for degree in range(1, k + 1):
+        total = 0
+        for index in range(1, degree + 1):
+            term = elementary[degree - index] * sums[index] % _P
+            operations += 1  # multiplication
+            if index % 2:
+                total = (total + term) % _P
+            else:
+                total = (total - term) % _P
+            operations += 1  # addition/subtraction
+        total = total * _inv(degree) % _P
+        operations += 1
+        elementary.append(total)
+
+    # Monic polynomial with the selected labels as roots.
+    polynomial = [1]
+    for degree in range(1, k + 1):
+        polynomial.append(((-1) ** degree * elementary[degree]) % _P)
+
+    roots = set()
+    for label in inst["labels"]:
+        value = polynomial[0]
+        for coefficient in polynomial[1:]:
+            value = value * label % _P
+            operations += 1
+            value = (value + coefficient) % _P
+            operations += 1
+        if value == 0:
+            roots.add(label)
+    if len(roots) != k:
+        return None, operations
+    return [int(label in roots) for label in inst["labels"]], operations
+
+
+def canonical_key(inst):
+    """Canonicalize generator order, coordinate order, and affine label changes."""
+    candidate = _symmetry_candidate(inst)
+    if candidate is None:
+        # Strong deterministic fallback for malformed/non-family instances.  It is
+        # deliberately structural and contains neither seed nor rendered text.
+        rows = sorted(
+            (tuple(sorted(generator)), coefficient)
+            for generator, coefficient in zip(inst["generators"], [0] * inst["n"])
+        )
+        payload = [inst["modulus"], inst["n"], inst["m"], rows,
+                   sorted(inst["target"])]
+        return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
+
+    selected = {label for label, bit in zip(inst["labels"], candidate) if bit}
+    k = len(selected)
+    center = sum(selected) * _inv(k) % _P
+    centered = {((label - center) % _P) for label in selected}
+    half = k // 2
+
+    valid_steps = []
+    for difference in centered:
+        if difference == 0:
+            continue
+        trial = {
+            offset * difference % _P
+            for offset in range(-half, half + 1)
+        }
+        if trial == centered:
+            valid_steps.append(difference)
+    if not valid_steps:
+        raise ValueError("could not canonicalize the recovered progression")
+
+    forms = []
+    for step in valid_steps:
+        inverse_step = _inv(step)
+        colored_points = sorted(
+            (((label - center) * inverse_step % _P), int(label in selected))
+            for label in inst["labels"]
+        )
+        forms.append(colored_points)
+    canonical_points = min(forms)
+    payload = {
+        "p": _P,
+        "n": inst["n"],
+        "m": inst["m"],
+        "exponents": sorted(inst["exponents"]),
+        "colored_affine_points": canonical_points,
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode()).hexdigest()
+
+
+def escalate(params):
+    """Grow the coefficient haystack and sparse-interpolation work within caps."""
+    current = {key: value for key, value in params.items() if not key.startswith("_")}
+    n = current["n"]
+    m = current["m"]
+    k = current["k"]
+    if n < 256:
+        new_n = min(256, n + 40)
+        new_k = min(99, k + 4)
+        if new_k % 2 == 0:
+            new_k += 1
+        new_m = max(m + 12, new_k + 1)
+        return {"n": new_n, "m": new_m, "k": new_k}
+    if k < 99:
+        new_k = min(99, k + 8)
+        if new_k % 2 == 0:
+            new_k -= 1
+        return {"n": n, "m": max(m + 12, new_k + 1), "k": new_k}
+    # More labels would make the coefficient vector exceed 256 atoms, while a
+    # larger k would push the compact route toward the 300-operation cap.
+    return "cap_bound"
+
+
+def _candidate_from_indices(inst, indices):
+    chosen = set(indices)
+    return [int(index in chosen) for index in range(inst["n"])]
+
+
+def _attack_outlier_checksum(inst):
+    k = inst["target"][inst["exponents"].index(0)] % _P
+    scores = []
+    for index, generator in enumerate(inst["generators"]):
+        checksum = sum((coordinate + 1) * value
+                       for coordinate, value in enumerate(generator[:8])) % _P
+        zero_count = sum(value == 0 for value in generator)
+        scores.append(((zero_count, checksum, inst["labels"][index]), index))
+    indices = [index for _, index in sorted(scores)[:k]]
+    return _candidate_from_indices(inst, indices)
+
+
+def _balanced_residue(value):
+    value %= _P
+    return min(value, _P - value)
+
+
+def _attack_greedy_residual(inst):
+    k = inst["target"][inst["exponents"].index(0)] % _P
+    width = min(6, inst["m"])
+    residual = list(inst["target"][:width])
+    unused = set(range(inst["n"]))
+    chosen = []
+    for _ in range(k):
+        best = min(
+            unused,
+            key=lambda index: (
+                sum(_balanced_residue(residual[r] - inst["generators"][index][r])
+                    for r in range(width)),
+                index,
+            ),
+        )
+        chosen.append(best)
+        unused.remove(best)
+        for coordinate in range(width):
+            residual[coordinate] = (
+                residual[coordinate] - inst["generators"][best][coordinate]
+            ) % _P
+    return _candidate_from_indices(inst, chosen)
+
+
+def _attack_random_restart(inst, seed, restarts=256):
+    rng = random.Random(seed ^ 0x6A09E667)
+    k = inst["target"][inst["exponents"].index(0)] % _P
+    last = None
+    for _ in range(restarts):
+        indices = rng.sample(range(inst["n"]), k)
+        last = _candidate_from_indices(inst, indices)
+        ok, _ = verify(inst, last)
+        if ok:
+            return last
+    return last
+
+
+def _attack_center_consecutive(inst):
+    sums = _power_sums_by_exponent(inst)
+    k = sums[0] % _P
+    center = sums[1] * _inv(k) % _P
+    half = k // 2
+    assumed = {(center + offset) % _P for offset in range(-half, half + 1)}
+    return [int(label in assumed) for label in inst["labels"]]
+
+
+def _permuted_generators(inst, rng):
+    order = list(range(inst["n"]))
+    rng.shuffle(order)
+    transformed = copy.deepcopy(inst)
+    transformed["labels"] = [inst["labels"][old] for old in order]
+    transformed["generators"] = [inst["generators"][old] for old in order]
+    transformed["answer"] = [inst["answer"][old] for old in order]
+    return transformed
+
+
+def _permuted_coordinates(inst, rng):
+    order = list(range(inst["m"]))
+    rng.shuffle(order)
+    transformed = copy.deepcopy(inst)
+    transformed["exponents"] = [inst["exponents"][old] for old in order]
+    transformed["target"] = [inst["target"][old] for old in order]
+    transformed["generators"] = [
+        [generator[old] for old in order]
+        for generator in inst["generators"]
+    ]
+    return transformed
+
+
+def _affine_labels(inst, multiplier, translation):
+    if multiplier % _P == 0:
+        raise ValueError("affine multiplier must be nonzero")
+    transformed = copy.deepcopy(inst)
+    transformed["labels"] = [
+        (multiplier * label + translation) % _P for label in inst["labels"]
+    ]
+    transformed["generators"] = _generators(
+        transformed["labels"], transformed["exponents"]
+    )
+    transformed["target"] = _linear_combination(
+        transformed["generators"], transformed["answer"], transformed["m"]
+    )
+    return transformed
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def selftest():
+    """Run all mandatory deterministic gates and return their measured report."""
+    report = {
+        "paper": "arXiv:1707.08244",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    planted_attempts = 0
+    planted_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17, 104729):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            planted_attempts += 1
+            if not ok:
+                planted_failures.append({"preset": preset, "seed": seed, "reason": reason})
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                planted_failures.append({"preset": preset, "seed": seed,
+                                         "reason": "answer_not_JSON_native"})
+    report["G1_planted_verifies"] = {
+        "pass": not planted_failures,
+        "attempts": planted_attempts,
+        "failures": planted_failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=20260905, **ship_params)
+    answer = inst["answer"]
+    planted_index = answer.index(1)
+    decoy_index = answer.index(0)
+    swapped = list(answer)
+    swapped[planted_index], swapped[decoy_index] = swapped[decoy_index], swapped[planted_index]
+    out_of_range = list(answer)
+    out_of_range[0] = _P
+    corruptions = {
+        "empty": [],
+        "drop_one": answer[:-1],
+        "duplicate_one": answer + [answer[-1]],
+        "out_of_range": out_of_range,
+        "swap_plant_and_decoy": swapped,
+    }
+    corruption_results = {}
+    reasons = []
+    for name, corrupted in corruptions.items():
+        ok, reason = verify(inst, corrupted)
+        corruption_results[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": (
+            all(item["rejected"] for item in corruption_results.values())
+            and len(set(reasons)) == len(reasons)
+        ),
+        "cases": corruption_results,
+        "distinct_reason_count": len(set(reasons)),
+    }
+
+    model_style = (
+        "The coefficients below satisfy each power-sum coordinate.\n\n"
+        "<answer>\n```json\n" + json.dumps(answer) + "\n```\n</answer>\n"
+        "I checked the modular sum."
+    )
+    parsed = parse_answer(model_style)
+    malformed_none = all(parse_answer(text) is None for text in (
+        "no tagged answer", "<answer>not json</answer>",
+        "<answer>{\"x\": 1}</answer>", "<answer>[1, true]</answer>",
+    ))
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and malformed_none,
+        "model_style_round_trip": parsed == answer,
+        "garbage_returns_none": malformed_none,
+    }
+
+    guess_rng = random.Random(8675309)
+    guess_hits = 0
+    guess_started = time.perf_counter()
+    for _ in range(_G4_SAMPLES):
+        candidate = random_candidate(inst, guess_rng)
+        ok, _ = verify(inst, candidate)
+        guess_hits += int(ok)
+    guess_elapsed = time.perf_counter() - guess_started
+    exact_density = _P ** (1 - inst["m"])
+    report["G4_guess_resistance"] = {
+        "pass": guess_hits / _G4_SAMPLES < 1e-6 and exact_density < 1e-6,
+        "hits": guess_hits,
+        "total": _G4_SAMPLES,
+        "observed_probability": guess_hits / _G4_SAMPLES,
+        "exact_probability_from_Vandermonde_rank": exact_density,
+        "candidate_space": search_space(inst),
+        "sampler": "uniform on the freely deducible coefficient-sum hyperplane",
+        "wall_clock_sec": round(guess_elapsed, 6),
+    }
+
+    attack_functions = {
+        "outlier_column_checksum": lambda item, seed: _attack_outlier_checksum(item),
+        "greedy_balanced_residual": lambda item, seed: _attack_greedy_residual(item),
+        "random_restart_256_sparse_terms": (
+            lambda item, seed: _attack_random_restart(item, seed, 256)
+        ),
+        "center_plus_consecutive_labels": lambda item, seed: _attack_center_consecutive(item),
+    }
+    attack_stats = {
+        name: {"successes": 0, "attempts": 0, "wall_clock_sec": 0.0}
+        for name in attack_functions
+    }
+    reference_successes = 0
+    reference_operations = []
+    reference_elapsed = 0.0
+    compact_successes = 0
+    for seed in range(_ATTACK_SEEDS):
+        attack_inst = make_instance(seed=5000 + seed, **ship_params)
+        for name, function in attack_functions.items():
+            started = time.perf_counter()
+            candidate = function(attack_inst, 9000 + seed)
+            elapsed = time.perf_counter() - started
+            ok, _ = verify(attack_inst, candidate)
+            attack_stats[name]["successes"] += int(ok)
+            attack_stats[name]["attempts"] += 1
+            attack_stats[name]["wall_clock_sec"] += elapsed
+
+        started = time.perf_counter()
+        reference, operations = _newton_vieta_candidate(attack_inst)
+        reference_elapsed += time.perf_counter() - started
+        reference_operations.append(operations)
+        if reference is not None:
+            reference_successes += int(verify(attack_inst, reference)[0])
+        compact = _symmetry_candidate(attack_inst)
+        if compact is not None:
+            compact_successes += int(verify(attack_inst, compact)[0])
+
+    for stats in attack_stats.values():
+        stats["wall_clock_sec"] = round(stats["wall_clock_sec"], 6)
+    all_attacks_failed = all(stats["successes"] == 0 for stats in attack_stats.values())
+    reference_algorithm = {
+        "name": "Newton identities plus Vieta root scan",
+        "complexity": "O(k^2 + n*k) exact field operations",
+        "wall_clock_sec": round(reference_elapsed, 6),
+        "wall_clock_scope": f"total over {_ATTACK_SEEDS} shipping instances",
+        "operations": max(reference_operations),
+        "operations_scope": "per shipping instance (maximum measured)",
+        "solves": f"{reference_successes}/{_ATTACK_SEEDS}, as expected",
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == _ATTACK_SEEDS,
+        "attacks": attack_stats,
+        "reference_algorithm": reference_algorithm,
+        "compact_symmetry_route_solves": f"{compact_successes}/{_ATTACK_SEEDS}",
+    }
+
+    report["G5_density_and_baseline"] = {
+        "pass": reference_successes == _ATTACK_SEEDS,
+        "shipping_sampled_density": {
+            "hits": guess_hits,
+            "total": _G4_SAMPLES,
+            "observed_fraction": guess_hits / _G4_SAMPLES,
+        },
+        "exact_valid_solution_count_from_full_row_rank": _P ** (inst["n"] - inst["m"]),
+        "exact_density_in_declared_language": exact_density,
+        "enumerate_all_shipping": enumerate_all(inst),
+        "strongest_baseline": reference_algorithm,
+        "baseline_wall_clock_sec": reference_algorithm["wall_clock_sec"],
+        "baseline_operations": reference_algorithm["operations"],
+    }
+
+    doubled_params = dict(ship_params)
+    doubled_params["n"] *= 2
+    doubled_params["m"] *= 2
+    doubled = make_instance(seed=424242, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    ladder_n = [params["n"] for params in DIFFICULTY.values()]
+    report["G7_scales"] = {
+        "pass": all(left < right for left, right in zip(ladder_n, ladder_n[1:]))
+        and doubled_ok,
+        "preset_n_values": ladder_n,
+        "doubled_params": doubled_params,
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    preserved_checks = 0
+    unrelated_keys = []
+    invariance_failures = []
+    for seed in range(20):
+        base = make_instance(seed=7000 + seed, **ship_params)
+        base_key = canonical_key(base)
+        unrelated_keys.append(base_key)
+        rng = random.Random(8000 + seed)
+        generator_permuted = _permuted_generators(base, rng)
+        coordinate_permuted = _permuted_coordinates(base, rng)
+        multiplier = rng.randrange(1, _P)
+        translation = rng.randrange(_P)
+        affine = _affine_labels(base, multiplier, translation)
+        composed = _permuted_generators(base, rng)
+        composed = _permuted_coordinates(composed, rng)
+        composed = _affine_labels(composed, multiplier, translation)
+        for name, transformed in (
+            ("generator_permutation", generator_permuted),
+            ("coordinate_permutation", coordinate_permuted),
+            ("affine_label_map", affine),
+            ("composed", composed),
+        ):
+            invariant_checks += 1
+            if canonical_key(transformed) != base_key:
+                invariance_failures.append({"seed": seed, "map": name,
+                                            "failure": "key_changed"})
+            ok, reason = verify(transformed, transformed["answer"])
+            preserved_checks += int(ok)
+            if not ok:
+                invariance_failures.append({"seed": seed, "map": name,
+                                            "failure": reason})
+    report["G8_canonical_key"] = {
+        "pass": not invariance_failures and len(set(unrelated_keys)) == 20,
+        "invariance_checks": invariant_checks,
+        "transformation_witnesses_verified": preserved_checks,
+        "unrelated_distinct": len(set(unrelated_keys)),
+        "unrelated_attempts": 20,
+        "transformations": [
+            "generator permutation", "coordinate permutation",
+            "affine label map a -> u*a+t", "composition of all three",
+        ],
+        "failures": invariance_failures,
+    }
+
+    answer_blob = json.dumps(answer, separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(answer)
+    intended_operations = 2 * ship_params["k"] + 70
+    arms = copy.deepcopy(G9_ORACLE_RESULTS)
+    hinted_attempts = arms["hinted"]["attempts"]
+    placebo_attempts = arms["placebo"]["attempts"]
+    hinted_rate = (arms["hinted"]["solved"] / hinted_attempts
+                   if hinted_attempts else 0.0)
+    placebo_rate = (arms["placebo"]["solved"] / placebo_attempts
+                    if placebo_attempts else 0.0)
+    within_caps = (
+        answer_chars <= 2000 and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": {
+            "bare": arms["bare"],
+            "hinted": arms["hinted"],
+            "placebo": arms["placebo"],
+        },
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": arms["hinted_verdict"],
+        "diagnostic_is_not_gated": True,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+    }
+
+    gate_names = [key for key in report if re.match(r"G[1-9]_", key)]
+    report["all_pass"] = all(report[key].get("pass") is True for key in gate_names)
+    report["all_passed"] = report["all_pass"]
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
