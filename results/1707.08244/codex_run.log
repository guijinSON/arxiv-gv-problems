   181	Next we show $\A_\M \models \Sigma$. In order to show this, we will first discuss how to evaluate, in $\A_\M$, an arbitrary linear term in the language $\H$. In the following, we use ``$=$" to denote equality of terms. Let $w(y_1,\dots,y_\ell)$ be any linear term with distinct variables $y_1,\dots, y_\ell$, where $\ell \leq |X|$ and $w$ need not depend on all variables. Since $w$ is a linear term, $w(y_1,\dots, y_\ell) = h(y_{t(1)},\dots, y_{t(k)})$ for some $k$-ary $h \in \H$ and some map $t \colon \{1,\dots, k\} \to \{1,\dots, \ell\}$.
   182	
   183	\begin{claim}\label{eval}
   184	Let $w(y_1,\dots,y_\ell) = h(y_{t(1)},\dots, y_{t(k)})$ be a linear term in the language $\H$ $(\ell \leq |X|)$. If $\overline{a} =(a_1,\dots,a_\ell)\in (A \cup \{0\})^\ell$, then 
   185	\[
   186	w^{\A_{\M}}(a_1,\dots, a_\ell) =
   187	\begin{cases}
   188	a_{j} &\text{if there exist } (x_1,\dots, x_\ell) \in P_{\overline{a}} \text{ and } 1\leq j \leq  \ell \\
   189	    	&\text{such that } \Sigma \vdash w(x_1,\dots,x_\ell) \approx x_j   \\
   190	0 &\text{otherwise. } 
   191	\end{cases}
   192	\]
   193	\end{claim}
   194	\begin{proof} 
   195	\renewcommand{\qedsymbol}{$\blacksquare$}
   196	Let $\overline{a} =(a_1,\dots,a_\ell)\in (A \cup \{0\})^\ell$, and let $\overline{a}_t = (a_{t(1)},\dots,a_{t(k)}) \in (A \cup \{0\})^k $. We first show that the following two conditions on $\overline{a}$ and $\overline{a}_t$ are equivalent:
   197		\begin{enumerate}
   198		\item[(a)] There exist $(x_1, \dots ,x_\ell) \in P_{\overline{a}}$ and $1 \leq j \leq \ell$ such that 
   199		\[
   200		\Sigma \vdash  w(x_1,\dots, x_\ell) \approx x_j.
   201		\]
   202		\item[(b)] There exist $(x_{t(1)}, \dots , x_{t(k)}) \in P_{\overline{a}_t}$ and $1 \leq i \leq k$ such that 
   203		\[
   204		\Sigma \vdash  h(x_{t(1)},\dots,x_{t(k)}) \approx x_{t(i)}.
   205		\]
   206		\end{enumerate}
   207	(a) $\Rightarrow$ (b) If $(x_1, \dots ,x_\ell) \in P_{\overline{a}}$, then $(x_{t(1)}, \dots , x_{t(k)}) \in P_{\overline{a}_t}$. Further,
   208	\begin{align*}
   209	\Sigma \vdash x_j &\approx w(x_1,\dots,x_\ell) \text{ by assumption and entailment property (2)} \\
   210		 &=h(x_{t(1)}, \dots , x_{t(k)}).
   211	\end{align*}
   212	Thus, $\Sigma \vdash h(x_{t(1)}, \dots , x_{t(k)}) \approx x_j$ by entailment property (2). Since $\Sigma$ is consistent, $j = t(i)$ for some $1 \leq i \leq k$. 
   213	
   214	\noindent (b) $\Rightarrow$ (a) Let $\equiv$ denote the equivalence relation on the set $\{1,\dots, \ell\}$ defined by $r \equiv q$ if and only if $a_r = a_q$, and denote the $\equiv$-class of $r \in \{1,\dots,\ell\}$ by $[r]$. Let $T$ be the set of $\equiv$-classes. Since $|T| \leq \ell \leq |X|$ and 
   215	\[
   216	t(q) \equiv t(r) \iff a_{t(q)} = a_{t(r)} \iff x_{t(q)} = x_{t(r)},
   217	\] 
   218	there is a well-defined and one-to-one map $\psi \colon T \to X$ such that $\psi([t(r)]) = x_{t(r)}$ for all numbers of the form $t(r)$ ($1 \leq r \leq k$). For each $s \in \{1,\dots, \ell\}$, define $z_s := \psi([s])$. Then $(z_1,\dots, z_\ell) \in P_{\overline{a}}$, and $x_{t(r)} = \psi([t(r)]) = z_{t(r)}$ for all $1 \leq r \leq k$. We compute
   219	\begin{align*}
   220	\Sigma \vdash x_{t(i)} &\approx  h(x_{t(1)}, \dots, x_{t(k)}) \text{ by assumption and entailment property (2)} \\
   221				&=h(z_{t(1)}, \dots, z_{t(k)}) \\
   222				&= w(z_1,\dots, z_\ell) .
   223	\end{align*}
   224	By entailment property (2), we have $\Sigma \vdash w(z_1,\dots, z_\ell) \approx x_{t(i)}$. Since $x_{t(i)} = z_{t(i)}$, $\Sigma \vdash w(z_1,\dots, z_\ell) \approx z_{t(i)}$, where $1 \leq t(i) \leq \ell$.  This completes the argument that (a) and (b) are equivalent. 
   225	
   226	Now we compute
   227	\begin{align*}
