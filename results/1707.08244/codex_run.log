+        "strongest_baseline": reference_algorithm,
+    }
+
+    doubled_params = dict(ship_params)
+    doubled_params["n"] *= 2
+    doubled_params["m"] *= 2
+    doubled = make_instance(seed=424242, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    ladder_n = [params["n"] for params in DIFFICULTY.values()]
+    report["G7_scales"] = {
+        "pass": all(left < right for left, right in zip(ladder_n, ladder_n[1:]))
+        and doubled_ok,
+        "preset_n_values": ladder_n,
+        "doubled_params": doubled_params,
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    preserved_checks = 0
+    unrelated_keys = []
+    invariance_failures = []
+    for seed in range(20):
+        base = make_instance(seed=7000 + seed, **ship_params)
+        base_key = canonical_key(base)
+        unrelated_keys.append(base_key)
+        rng = random.Random(8000 + seed)
+        generator_permuted = _permuted_generators(base, rng)
+        coordinate_permuted = _permuted_coordinates(base, rng)
+        multiplier = rng.randrange(1, _P)
+        translation = rng.randrange(_P)
+        affine = _affine_labels(base, multiplier, translation)
+        composed = _permuted_generators(base, rng)
+        composed = _permuted_coordinates(composed, rng)
+        composed = _affine_labels(composed, multiplier, translation)
+        for name, transformed in (
+            ("generator_permutation", generator_permuted),
+            ("coordinate_permutation", coordinate_permuted),
+            ("affine_label_map", affine),
+            ("composed", composed),
+        ):
+            invariant_checks += 1
+            if canonical_key(transformed) != base_key:
+                invariance_failures.append({"seed": seed, "map": name,
+                                            "failure": "key_changed"})
+            ok, reason = verify(transformed, transformed["answer"])
+            preserved_checks += int(ok)
+            if not ok:
