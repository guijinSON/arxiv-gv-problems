   231	    				&\text{such that } \Sigma \vdash  h(x_{t(1)},\dots,x_{t(k)}) \approx x_{t(i)}   \\
   232				0 &\text{otherwise }
   233				\end{cases}\\
   234				&=\begin{cases}
   235				a_{j} &\text{if } \exists (x_1,\dots, x_\ell) \in P_{\overline{a}} \text{ and } 1\leq j \leq  \ell \\
   236	    				&\text{such that } \Sigma \vdash w(x_1,\dots,x_\ell) \approx x_j   \\
   237				0 &\text{otherwise, } 
