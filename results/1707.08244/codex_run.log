+            "observed_fraction": guess_hits / _G4_SAMPLES,
+        },
+        "exact_valid_solution_count_from_full_row_rank": _P ** (inst["n"] - inst["m"]),
+        "exact_density_in_declared_language": exact_density,
+        "enumerate_all_shipping": enumerate_all(inst),
