+    m = current["m"]
+    k = current["k"]
+    if n < 256:
+        new_n = min(256, n + 40)
+        new_k = min(99, k + 4)
+        if new_k % 2 == 0:
+            new_k += 1
+        new_m = max(m + 12, new_k + 1)
+        return {"n": new_n, "m": new_m, "k": new_k}
+    if k < 99:
+        new_k = min(99, k + 8)
+        if new_k % 2 == 0:
+            new_k -= 1
+        return {"n": n, "m": max(m + 12, new_k + 1), "k": new_k}
