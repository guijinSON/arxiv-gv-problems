failed = [k for k, v in sorted(gates.items()) if not (isinstance(v, dict) and v.get('pass'))]
assert not failed, failed
assert report['all_passed'] is True

g5 = report['G5_shipping_difficulty']
assert g5['shipping_preset'] == report['shipping_difficulty'] == 'hard'
