+    },
+    "domain_attack": "Algorithm X with minimum-column branching",
+    "pass": true
+  },
+  "G7_scales": {
+    "base_n": 60,
+    "doubled_edges": 2461,
+    "doubled_n": 120,
+    "doubled_vertices": 360,
+    "pass": true,
+    "verify_reason": "ok"
+  },
+  "G8_canonical_key": {
+    "carried_witness_checks": 80,
+    "distinct_unrelated_keys": 20,
+    "failures": [],
+    "invariance_checks": 80,
+    "method": "directed 1-WL refinement, normalized with the converse graph",
+    "pass": true,
+    "transformations": [
+      "arbitrary vertex relabeling plus reversed edge-list order",
+      "global reversal of every arc",
+      "composition of relabeling, reordering, and arc reversal",
+      "edge-list reordering alone"
+    ],
+    "unrelated_keys": 20
+  },
+  "all_passed": true,
+  "shipping_difficulty": "hard",
+  "shipping_params": {
+    "decoy_ratio": 2.0,
+    "n": 60,
+    "screen_nodes": 50000
+  }
+}

