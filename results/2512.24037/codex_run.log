-    rows = _legal_cycles_from_edges(vertex_count, inst["edges"])
-    by_vertex = [[] for _ in range(vertex_count)]
-    for row in rows:
-        for v in row:
-            by_vertex[v].append(row)
-    uncovered = set(range(vertex_count))
-    chosen = []
-    while uncovered:
-        v = min(uncovered)
-        options = [row for row in by_vertex[v] if set(row) <= uncovered]
-        if not options:
