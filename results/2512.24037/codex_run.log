 O=[[i,sig(i,n,a,b),sig(sig(i,n,a,b),n,a,b)] for i in range(n)];R.shuffle(O);E=set()
 for o in O:E|={(o[i],o[(i+1)%3]) for i in range(3)}
 L=1;tries=0
 while L<d and tries<200000:
  tries+=1;p=list(range(n));R.shuffle(p)
