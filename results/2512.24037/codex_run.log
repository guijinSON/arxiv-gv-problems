+def _sigma(v: int, n: int, r0: int, r1: int) -> int:
+    """The hidden fixed-point-free order-three permutation."""
+    block, i = divmod(v, n)
+    if block == 0:
+        return n + (i + r0) % n
+    if block == 1:
+        return 2 * n + (i + r1) % n
+    return (i - r0 - r1) % n
