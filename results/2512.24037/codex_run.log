import random,time

def gen(m,seed,alpha):
 r=random.Random(seed);N=3*m;p=list(range(N));r.shuffle(p)
 arcs=set()
 def add(t, forced=False):
  a,b,c=t
  if r.randrange(2): b,c=c,b
  opts=[((a,b),(b,c),(c,a)),((a,c),(c,b),(b,a))]
  first=opts.pop(0);opts=[first]+opts
  for ee in opts:
   if all((v,u) not in arcs for u,v in ee):
    arcs.update(ee);return True
  return False
 plant=[]
 for i in range(m):
  t=p[3*i:3*i+3];assert add(t,True);plant.append(tuple(t))
 tries=0;added=0
 while added<round(alpha*N) and tries<1000*alpha*N:
  tries+=1;t=r.sample(range(N),3)
  if add(t):added+=1
 return N,arcs
def cycles(N,A):
 out=[set()for _ in range(N)]
 for u,v in A:out[u].add(v)
 E=set()
 for a in range(N):
  for b in out[a]:
   for c in out[b]:
    if a in out[c]:
     cyc=(a,b,c)
     rots=[cyc,cyc[1:]+cyc[:1],cyc[2:]+cyc[:2]]
     E.add(min(rots))
 return list(E)
def solve(N,A,limit=100000):
 E=cycles(N,A);by=[[]for _ in range(N)];em=[]
 for i,e in enumerate(E):
  z=sum(1<<x for x in e);em.append(z)
  for v in e:by[v].append(i)
 allm=(1<<N)-1;nodes=0
 def rec(mask):
  nonlocal nodes
  nodes+=1
  if nodes>limit:return None
  if mask==allm:return True
  rem=allm"'^mask;ops=None
  while rem:
   b=rem&-rem;rem-=b;v=b.bit_length()-1
   o=[i for i in by[v] if not em[i]&mask]
   if not o:return False
   if ops is None or len(o)<len(ops):ops=o
  for i in ops:
   q=rec(mask|em[i])
   if q is None:return None
   if q:return True
  return False
 t=time.time();q=rec(0);return len(E),len(A),nodes,time.time()-t,q
for m in (30,40,60):
 for a in (1.5,2,2.5,3):
  rows=[solve(*gen(m,s,a),limit=50000) for s in range(8)]
  print(m,a,[(x[0],x[2],round(x[3],2),x[4]) for x in rows],flush=True)
