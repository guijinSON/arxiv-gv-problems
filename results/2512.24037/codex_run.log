+        b, c = c, b
+    return ((a, b), (b, c), (c, a))
+
+
+def _legal_cycles_from_edges(vertex_count: int, edges: Any) -> list[tuple[int, int, int]]:
+    """Enumerate unordered vertex triples inducing a directed 3-cycle."""
+    out = [set() for _ in range(vertex_count)]
+    for u, v in edges:
+        out[u].add(v)
