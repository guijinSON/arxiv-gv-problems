import random, statistics, time
n=2048
d=64
p=d/n
k=80
probes=[]
unblocked=[]
times=[]
for seed in range(20):
    rng=random.Random(seed)
    count=0
    free=0
    t=time.perf_counter()
    for _ in range(n):
        blocked=False
        for _ in range(k):
            count += 1
            if rng.random() < p:
                blocked=True
                break
        if not blocked:
            free += 1
    times.append(time.perf_counter()-t)
    probes.append(count)
    unblocked.append(free)
print({
    'n':n,'d':d,'k_each_side':k,'answer_atoms':2*k,
    'probe_mean':statistics.mean(probes),
    'probe_min':min(probes),'probe_max':max(probes),
    'unblocked_mean':statistics.mean(unblocked),
    'unblocked_min':min(unblocked),'unblocked_max':max(unblocked),
    'wall_mean_sec':statistics.mean(times),
    'wall_max_sec':max(times),
})
