+def _shifted_rank(inst, shift: int, stop_after: int | None = None) -> int:
+    matrix = inst["matrix"]
+    p = inst["p"]
+    shifted = []
+    for i, row in enumerate(matrix):
+        shifted.append(
+            [(value + (shift if i == j else 0)) % p for j, value in enumerate(row)]
+        )
+    return _matrix_rank(shifted, p, stop_after=stop_after)
