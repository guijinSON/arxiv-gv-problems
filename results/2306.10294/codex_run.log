+    reasons = [entry["reason"] for entry in g2_results.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(x["rejected"] for x in g2_results.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": g2_results,
+    }
