+def _attack_outlier_diagonal(inst):
+    diagonal = [inst["matrix"][i][i] for i in range(inst["n"])]
+    value = Counter(diagonal).most_common(1)[0][0]
+    return [inst["p"], (-value) % inst["p"]]
