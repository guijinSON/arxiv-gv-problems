+
+    attack_results = {
+        "outlier_diagonal_mode": {"successes": 0, "attempts": 0},
+        "greedy_leading_minor_from_diagonal": {"successes": 0, "attempts": 0},
+        "random_restart_4096_shifts": {"successes": 0, "attempts": 0},
