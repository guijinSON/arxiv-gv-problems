+"""Verified symmetric-MinRank pencil generator for arXiv:2306.10294."""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+from collections import Counter
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
