diff --git a/gen_2306_10294.py b/gen_2306_10294.py
new file mode 100644
index 0000000000000000000000000000000000000000..79f29f7038f23dc03f2616813604a427ccbef771
--- /dev/null
+++ b/gen_2306_10294.py
@@ -0,0 +1,707 @@
+"""Verified symmetric-MinRank pencil generator for arXiv:2306.10294."""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+from collections import Counter
+
+
+TRACK: str = "B"
+
