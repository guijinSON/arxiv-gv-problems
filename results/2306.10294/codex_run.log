+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            hits += 1
+    exact_guess_probability = 1.0 / inst["p"]
+    report["G4_guess_resistance"] = {
+        "pass": hits == 0 and exact_guess_probability < 1e-6,
+        "hits": hits,
