+        "operations and is expected to solve every instance; its measured "
+        "shipping cost is filled from selftest, while a no-tool solver must "
+        "discover the unstated trace-zero invariant and exactly accumulate the "
+        "shipping matrix diagonal."
+    ),
+    "max_answer_tokens": 7,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+# 2^31-1 is prime.  The named non-demo sizes divide p+1, which also keeps the
+# final modular division in the intended trace route especially compact.
+FIELD_PRIME = 2_147_483_647
+
+DIFFICULTY: dict = {
+    "demo": {"n": 7, "p": 101},
+    "easy": {"n": 128, "p": FIELD_PRIME},
