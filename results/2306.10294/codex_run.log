+# These values are replaced only with transcripts produced by scripts/harden.py.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 3},
+        "hinted": {"solved": 0, "attempts": 3},
+        "placebo": {"solved": 0, "attempts": 3},
