+    report["G8_canonical_key"] = {
+        "pass": not invariant_failures and len(set(distinct_keys)) == 20,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": witness_checks,
+        "distinct_unrelated_keys": len(set(distinct_keys)),
