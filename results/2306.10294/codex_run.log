+def _attack_partial_trace(inst, prefix=12):
+    p = inst["p"]
+    count = min(prefix, inst["n"])
+    partial = sum(inst["matrix"][i][i] for i in range(count)) % p
+    return [p, (-partial * pow(count, -1, p)) % p]
+
