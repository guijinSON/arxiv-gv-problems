+        "doubled_upper_triangle_entries": doubled["n"] * (doubled["n"] + 1) // 2,
+        "shipping_reference_operations": inst["n"] + 1,
+        "doubled_reference_operations": doubled["n"] + 1,
+        "doubled_verify_reason": doubled_reason,
