+    planted_shift = rng.randrange(p)
+    residual = _rank_three_residual(n, p, rng)
+    matrix = [[0] * n for _ in range(n)]
+    for i in range(n):
+        for j in range(n):
+            matrix[i][j] = (residual[i][j] - (planted_shift if i == j else 0)) % p
