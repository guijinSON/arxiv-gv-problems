+
+    invariance_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    distinct_keys = []
+    for seed in range(20):
+        original = make_instance(seed=7000 + seed, **ship_params)
+        original_key = canonical_key(original)
+        distinct_keys.append(original_key)
+        rng = random.Random(8000 + seed)
+        permutation = list(range(original["n"]))
