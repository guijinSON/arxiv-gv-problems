+        "operations and is expected to solve every instance; its measured "
+        "shipping cost is filled from selftest, while a no-tool solver must "
+        "discover the unstated trace-zero invariant and exactly accumulate the "
+        "shipping matrix diagonal."
+    ),
+    "max_answer_tokens": 7,
+}
+
+NATIVE: dict = {
