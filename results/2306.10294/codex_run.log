+        return False, "rank exceeds 3 (a leading 4x4 minor is nonzero)"
+    rank = _shifted_rank(inst, shift, stop_after=4)
+    if rank > 3:
+        return False, "rank exceeds 3 after exact elimination"
+    if rank < 3:
+        return False, "rank is below 3"
+    return True, "ok"
