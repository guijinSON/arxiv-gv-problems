+    shift = (-diagonal_sum * pow(inst["n"], -1, p)) % p
+    return [p, shift], {
+        "field_additions": inst["n"] - 1,
+        "field_inversions": 1,
+        "field_multiplications": 1,
+        "exact_operations": inst["n"] + 1,
+    }
