+            return 0
+        if pivot != col:
+            rows[col], rows[pivot] = rows[pivot], rows[col]
+            det = -det
+        value = rows[col][col]
+        det = det * value % p
+        inverse = pow(value, p - 2, p)
+        for row in range(col + 1, 4):
+            factor = rows[row][col] * inverse % p
+            if factor:
+                for j in range(col, 4):
+                    rows[row][j] = (rows[row][j] - factor * rows[col][j]) % p
