+import copy
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+from collections import Counter
+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "The planted rank-three residual has trace zero, so use the matrix trace "
+    "before attempting elimination."
+)
+PLACEBO_HINT: str = (
