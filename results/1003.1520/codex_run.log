from math import factorial
examples = {
 (3,2): ['0011220210','0022110120'],
 (3,3): ['00010021011022202012111221200','00020012022011101021222112100'],
 (4,2): ['00102113230331220','00203221310112330','00301332120223110'],
 (5,2): ['00102112041422430332313440','00203223012133140443424110','00304334023244210114131220','00401441034311320221242330'],
}
for (q,k), words in examples.items():
    all_arcs=[]
    for w in words:
        assert len(w)==q**k+k-1, ((q,k),len(w))
        verts=[w[i:i+k] for i in range(q**k)]
        assert len(set(verts))==q**k
        arcs={(verts[i],verts[(i+1)%len(verts)]) for i in range(len(verts))}
        assert len(arcs)==q**k
        all_arcs.append(arcs)
    for i in range(len(all_arcs)):
        for j in range(i): assert all_arcs[i].isdisjoint(all_arcs[j])
    mu={0:0, **{i:(i+1 if i<q-1 else 1) for i in range(1,q)}}
    for e,w in enumerate(words):
        got=''.join(str((lambda x: x)(int(c))) for c in words[0])
        for _ in range(e): got=''.join(str(mu[int(c)]) for c in got)
        assert got==w
    count=factorial(q)**(q**(k-1))//q**k
    print((q,k),'verified',len(words),'cycles','count',count)

