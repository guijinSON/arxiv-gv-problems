    return "cap_bound"


def _materialize_tournament(inst):
    """Evaluate the displayed Delta rule pair by pair, without its hidden change."""
    p = inst["p"]
    center = inst["center"]
    coordinates = inst["coordinates"]
    connection = set(inst["connection_set"])
