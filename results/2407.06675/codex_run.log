+def _numeric_greedy(inst: dict, objective: str) -> list[list[int]]:
+    branching, length, count, modulus = _validate_instance(inst)
+    answer = []
+    for lane in range(count):
+        target = inst["targets"][lane]
+        state = inst["sources"][lane]
+        path = [state]
+        for layer in range(length):
+            choices = [_successor(inst, lane, layer, state, digit)
+                       for digit in range(branching)]
+            if objective == "minimum":
+                state = min(choices)
+            else:
+                state = min(choices, key=lambda value: (
+                    min((value - target) % modulus, (target - value) % modulus),
+                    value))
+            path.append(state)
+        answer.append(path)
+    return answer
 
