+def escalate(params: dict) -> dict | str | None:
+    """Raise branching at fixed path count and fixed answer length."""
+    result = {key: value for key, value in params.items() if key != "_preset"}
+    branching = int(result.get("n", 5))
+    length = int(result.get("path_length", 8))
+    count = int(result.get("path_count", 4))
+    next_branching = branching + max(2, branching // 2)
+    modulus_digits = len(str(2 * pow(next_branching, length) + 1))
+    estimated_chars = count * (length + 1) * (modulus_digits + 1) + 2 * count + 2
+    if next_branching > 1_000_000 or estimated_chars > 2_000:
+        return "cap_bound"
+    result["n"] = next_branching
+    return result
 
 
