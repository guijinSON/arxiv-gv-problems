+def _compact_route(inst: dict) -> tuple[list[list[int]] | None, int]:
+    """Execute and conservatively count the intended coordinate-change route."""
+    branching, length, count, _ = _validate_instance(inst)
+    answer = []
+    operations = 0
+    limit = pow(branching, length)
+    for lane in range(count):
+        source_coordinate = _coord(inst, lane, 0, inst["sources"][lane])
+        target_coordinate = _coord(inst, lane, length, inst["targets"][lane])
+        operations += 6  # multiply, add, reduce for each endpoint coordinate
+        if source_coordinate != 0 or not 0 <= target_coordinate < limit:
+            return None, operations
+        digits = _decode_base(target_coordinate, branching, length)
+        operations += 2 * length  # one division and remainder per digit
+        if digits is None:
+            return None, operations
+        coordinate = 0
+        states = [inst["sources"][lane]]
+        for layer, digit in enumerate(digits):
+            coordinate = branching * coordinate + digit
+            state = (inst["scale_inverses"][lane][layer + 1]
+                     * (coordinate - inst["shifts"][lane][layer + 1])) % inst["modulus"]
+            operations += 5  # multiply/add coordinate; subtract/multiply/reduce inverse
+            states.append(state)
+        answer.append(states)
+    return answer, operations
 
 
