+def _validate_instance(inst: dict) -> tuple[int, int, int, int]:
+    branching = inst.get("branching")
+    length = inst.get("path_length")
+    count = inst.get("path_count")
+    _validate_params(branching, length, count)
+    modulus = inst.get("modulus")
+    if (isinstance(modulus, bool) or not isinstance(modulus, int)
+            or modulus != 2 * pow(branching, length) + 1):
+        raise ValueError("invalid modulus")
+    for name in ("scales", "scale_inverses", "shifts"):
+        table = inst.get(name)
+        if (not isinstance(table, list) or len(table) != count
+                or any(not isinstance(row, list) or len(row) != length + 1
+                       for row in table)):
+            raise ValueError(f"invalid {name} table shape")
+        if any(isinstance(v, bool) or not isinstance(v, int)
+               or not 0 <= v < modulus for row in table for v in row):
+            raise ValueError(f"invalid {name} table entry")
+    for lane in range(count):
+        for layer in range(length + 1):
+            if (inst["scales"][lane][layer]
+                    * inst["scale_inverses"][lane][layer]) % modulus != 1:
+                raise ValueError("scale inverse is incorrect")
+    for name in ("sources", "targets"):
+        values = inst.get(name)
+        if (not isinstance(values, list) or len(values) != count
+                or any(isinstance(v, bool) or not isinstance(v, int)
+                       or not 0 <= v < modulus for v in values)):
+            raise ValueError(f"invalid {name}")
+    return branching, length, count, modulus
 
 
