+def _validate_instance(inst: dict) -> tuple[int, int, int, int]:
+    branching = inst.get("branching")
+    length = inst.get("path_length")
+    count = inst.get("path_count")
+    _validate_params(branching, length, count)
+    modulus = inst.get("modulus")
+    if (isinstance(modulus, bool) or not isinstance(modulus, int)
+            or modulus != 2 * pow(branching, length) + 1):
