+        candidate += 2
+    return candidate
+
+
+def _z_from_coordinate(x, c, p):
+    centered = (x + c) % p
+    return 0 if centered == 0 else pow(centered, -1, p)
+
+
+def _coordinate_from_z(z, c, p):
+    return (-c) % p if z % p == 0 else (pow(z, -1, p) - c) % p
