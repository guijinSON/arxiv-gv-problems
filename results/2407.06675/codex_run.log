+def _beam_attack(inst: dict, width: int = 32) -> list[list[int]] | None:
+    branching, length, count, modulus = _validate_instance(inst)
+    answer = []
+    for lane in range(count):
+        target = inst["targets"][lane]
+        beam: list[tuple[int, list[int]]] = [
+            (inst["sources"][lane], [inst["sources"][lane]])
+        ]
+        for layer in range(length):
+            candidates: dict[int, list[int]] = {}
+            for state, path in beam:
+                for digit in range(branching):
+                    nxt = _successor(inst, lane, layer, state, digit)
+                    candidates.setdefault(nxt, path + [nxt])
+            ordered = sorted(candidates.items(), key=lambda item: (
+                min((item[0] - target) % modulus,
+                    (target - item[0]) % modulus), item[0]))
+            beam = [(state, path) for state, path in ordered[:width]]
+        found = next((path for state, path in beam if state == target), None)
+        if found is None:
+            return None
+        answer.append(found)
+    return answer
 
 
