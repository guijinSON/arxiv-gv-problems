+        coordinate: vertex for vertex, coordinate in enumerate(inst["coordinates"])
+    }
+    x0 = inst["coordinates"][inst["root"]]
+    candidates = []
+    for step in (1, p - 1):
+        candidate = [
+            coordinate_to_vertex[(x0 + index * step) % p]
+            for index in range(p)
