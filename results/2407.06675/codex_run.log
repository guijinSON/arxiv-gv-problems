+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    try:
+        tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text, re.I | re.S)
+        if tagged:
+            payload = tagged[-1].strip()
+        else:
+            fenced = re.findall(r"```(?:json|text)?\s*(\[[\s\S]*?\])\s*```", text, re.I)
+            if fenced:
+                payload = fenced[-1]
