+def _linear_interpolation_attack(inst: dict) -> list[list[int]]:
+    _, length, count, modulus = _validate_instance(inst)
+    answer = []
+    for lane in range(count):
+        source = inst["sources"][lane]
+        target = inst["targets"][lane]
+        delta = (target - source) % modulus
+        path = [source]
+        for layer in range(1, length):
+            path.append((source + (delta * layer) // length) % modulus)
+        path.append(target)
+        answer.append(path)
+    return answer
 
