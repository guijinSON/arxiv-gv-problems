+def _relabel_instance(inst: dict, witness: list[list[int]], seed: int
+                      ) -> tuple[dict, list[list[int]]]:
+    """Apply lane permutation and independent affine state relabellings."""
+    branching, length, count, modulus = _validate_instance(inst)
+    del branching
+    rng = random.Random(seed)
+    old_lanes = list(range(count))
+    rng.shuffle(old_lanes)
+    transformed = {
+        key: value for key, value in inst.items()
+        if key not in {"scales", "scale_inverses", "shifts",
+                       "sources", "targets", "answer"}
+    }
+    new_scales = []
+    new_inverses = []
+    new_shifts = []
+    new_sources = []
+    new_targets = []
+    carried = []
+    for old_lane in old_lanes:
+        scales_row = []
+        inverses_row = []
+        shifts_row = []
+        relabel_units = []
+        relabel_shifts = []
+        for layer in range(length + 1):
+            unit, unit_inverse = _sample_unit(modulus, rng)
+            shift = rng.randrange(modulus)
+            old_scale = inst["scales"][old_lane][layer]
+            old_inverse = inst["scale_inverses"][old_lane][layer]
+            new_scale = old_scale * unit_inverse % modulus
+            new_shift = (inst["shifts"][old_lane][layer]
+                         - new_scale * shift) % modulus
+            new_inverse = unit * old_inverse % modulus
+            scales_row.append(new_scale)
+            inverses_row.append(new_inverse)
+            shifts_row.append(new_shift)
+            relabel_units.append(unit)
+            relabel_shifts.append(shift)
+        new_scales.append(scales_row)
+        new_inverses.append(inverses_row)
+        new_shifts.append(shifts_row)
+        carried_path = [
+            (relabel_units[layer] * witness[old_lane][layer]
+             + relabel_shifts[layer]) % modulus
+            for layer in range(length + 1)
+        ]
+        carried.append(carried_path)
+        new_sources.append(carried_path[0])
+        new_targets.append(carried_path[-1])
+    transformed["scales"] = new_scales
+    transformed["scale_inverses"] = new_inverses
+    transformed["shifts"] = new_shifts
+    transformed["sources"] = new_sources
+    transformed["targets"] = new_targets
+    # Leave a stale JSON-native answer on purpose: canonical_key and verify must
+    # not obtain the carried witness from this field.
+    transformed["answer"] = [list(row) for row in inst["answer"]]
+    return transformed, carried
+
