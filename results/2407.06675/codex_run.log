+        and arms["placebo"]["attempts"]
+    ):
+        hinted_minus_placebo = (
+            hinted / arms["hinted"]["attempts"]
+            - placebo / arms["placebo"]["attempts"]
+        )
+    within_caps = (
+        len(worst_blob) <= 2000
+        and _answer_atoms(worst_answer) <= 256
