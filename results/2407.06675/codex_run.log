-def enumerate_all(inst):
-    p = inst["p"]
-    if p > 9:
-        return None
-    root = inst["root"]
-    others = [v for v in range(p) if v != root]
-    count = 0
-    for ordering in itertools.permutations(others):
-        if _fast_cycle_valid(inst, [root, *ordering, root]):
-            count += 1
-    return count
