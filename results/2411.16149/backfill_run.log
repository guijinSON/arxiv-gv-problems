/bin/bash -lc "python3 -m py_compile gen_2411_16149.py && python3 - <<'PY'
import itertools
import json
import gen_2411_16149 as g

assert g.DIFFICULTY[g.SHIPPING_DIFFICULTY] == {'n': 144, 'degree': 8}
assert g.NATIVE == {
    'domain': 'combinatorics',
    'core': 'graph',
    'objects': ['oriented graph', 'initial and target independent vertex sets', 'exact move bound'],
    'intuition': 'phase invariants expose a hidden Boolean consistency constraint',
    'reduction': None,
}
assert isinstance(g.CERTIFICATE_LANGUAGE, dict)

class FixedBits:
    def __init__(self, bits):
        self.bits = iter(bits)
    def randrange(self, stop):
        assert stop == 2
        return next(self.bits)

small = g.make_instance(n=9, degree=4, seed=77)
outputs = set()
hits = 0
for bits in itertools.product((0, 1), repeat=small['n']):
    candidate = g.random_candidate(small, FixedBits(bits))
    outputs.add(tuple(map(tuple, candidate)))
    hits += int(g.verify(small, candidate)[0])
assert len(outputs) == g.search_space(small) == 512
assert hits == g.enumerate_all(small) == 14

shipping = g.make_instance(seed=12345, **g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
assert g.verify(shipping, shipping['answer']) == (True, 'ok')
