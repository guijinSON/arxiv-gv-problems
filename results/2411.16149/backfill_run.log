        occupied.add(v)

    target = set(inst["target"])
    if occupied != target:
        missing = sorted(target - occupied)
        extra = sorted(occupied - target)
        return False, f"wrong final configuration: missing {missing[:4]}, extra {extra[:4]}"
    return True, "ok"


