/bin/bash -lc "python3 - <<'PY'
import random,time,itertools,statistics

def instance(n, seed, d):
 r=random.Random(seed); order=list(range(n)); r.shuffle(order)
 E={tuple(sorted((order[i],order[(i+1)%n],order[(i+2)%n]))) for i in range(n)}
 target=n*(d+1)
 while len(E)<target:E.add(tuple(sorted(r.sample(range(n),3))))
 return E

def verify(E,p):
 n=len(p);return len(set(p))==n and all(tuple(sorted((p[i],p[(i+1)%n],p[(i+2)%n]))) in E for i in range(n))

def attack(n,E,budget=200000):
 t=time.perf_counter();ops=0
 cd={}
 for e in E:
  for a,b in itertools.combinations(e,2):cd[a,b]=cd.get((a,b),0)+1;ops+=1
 adj=[[] for _ in range(n)]
 for (a,b),c in cd.items():
  if c>=2:adj[a].append(b);adj[b].append(a)
 nodes=0;used=[0]*n;used[0]=1;path=[0]
 def go():
  nonlocal nodes
  nodes+=1
  if nodes>budget:return None
  if len(path)==n:return path[:] if verify(E,path) else None
  u=path[-1]
  choices=[v for v in adj[u] if not used[v] and (len(path)<2 or tuple(sorted((path[-2],u,v))) in E)]
  choices.sort(key=lambda v:(sum(not used[w] for w in adj[v]),len(adj[v]),v))
  for v in choices:
   used[v]=1;path.append(v);z=go()
   if z:return z
   path.pop();used[v]=0
  return None
 z=go();return bool(z),nodes,ops,time.perf_counter()-t
for n,d in [(120,1),(120,8),(120,16),(120,24),(240,16)]:
 rows=[attack(n,instance(n,s,d)) for s in range(8)]
 print(n,n*(d+1),sum(x[0] for x in rows),statistics.median(x[1] for x in rows),max(x[1] for x in rows),statistics.median(x[3] for x in rows),max(x[3] for x in rows),statistics.median(x[2]+x[1] for x in rows))
