+                 and len(set(distinct_keys)) == 20),
+        "invariant_relabellings": invariant_count,
+        "invariance_attempts": 20,
+        "carried_witnesses_verified": carried_count,
+        "carried_attempts": 20,
+        "distinct_unrelated_keys": len(set(distinct_keys)),
+        "distinctness_attempts": 20,
