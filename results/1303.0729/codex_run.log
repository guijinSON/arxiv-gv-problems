+                restart_solved = True
+                break
+        attempts["random_restart_256"] += 1
+        successes["random_restart_256"] += int(restart_solved)
+
+        reference_answer, operation_count, elapsed = _reference_gaussian(inst)
+        reference_successes += int(verify(inst, reference_answer)[0])
