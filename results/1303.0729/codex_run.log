+    "easy": {"n": 31, "max_height": 3, "scale_bound": 31},
+    "medium": {"n": 47, "max_height": 4, "scale_bound": 63},
+    "hard": {"n": 63, "max_height": 4, "scale_bound": 127},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
