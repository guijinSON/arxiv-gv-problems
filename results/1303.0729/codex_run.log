+def _attack_scale_outlier(inst: dict) -> list:
+    scales = [_row_scale(row) for row in inst["generators"]]
+    median = sorted(scales)[len(scales) // 2]
+    return _candidate_from_heights(
+        inst, [int(scale > median) for scale in scales]
+    )
