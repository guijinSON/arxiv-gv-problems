+def escalate(params: dict) -> dict | str | None:
+    clean = {key: value for key, value in params.items() if not key.startswith("_")}
+    n = int(clean.get("n", 5))
+    maximum = int(clean.get("max_height", 2))
+    bound = int(clean.get("scale_bound", 9))
+    if maximum < 8:
