if graphy and NAT["core"] not in DISCRETE_CORE:
    print(f"ERROR: the solver is handed {sorted(k for k in i if k != 'answer')},\n"
          f"       which is a graph, but NATIVE['core'] says {NAT['core']!r}.\n"
