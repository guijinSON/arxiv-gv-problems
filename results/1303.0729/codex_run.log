  1043	\subsection{Working over $\mathbb{Z}/p^m\mathbb{Z}$} \label{ss:Zmodpm}
  1044	
  1045	While it is sometimes unavoidable to get large coefficients when
  1046	computing a Gr\"obner basis over $\mathbb Q$, these coefficients do
  1047	not always have large $p$-adic valuation.  This motivates working in
  1048	$\mathbb Z/p^m\mathbb Z$ via the method suggested in
  1049	Remark~\ref{r:Zmodpm}.
  1050	
  1051	This requires the following standard subroutine, which details how to
  1052	compute a Gr\"obner basis for $I$ given generators for
  1053	$\inn_{\prec}(\inn_w(I))$.  This is the usual linear algebra for
  1054	reconstructing Gr\"obner bases as in the non-valuation case; we
  1055	include it for completeness.
  1056	
  1057	\begin{algorithm} \label{a:liftingalgo}
  1058	
  1059	\noindent {\bf Input: } Homogeneous generators $\{f_1,\dots,f_l \}$
  1060	for an ideal $I \subseteq \mathbb Q[x_1,\dots,x_n]$.  A weight vector $w \in
  1061	\mathbb R^n$ and a term order $\prec$.  Generators
  1062	$\mathcal I = \{x^{u_1},\dots,x^{u_s} \}$ for $\inn_{\prec}(\inn_w(I))$.
  1063	
  1064	\noindent {\bf Output: } A reduced Gr\"obner basis for $I$ with
  1065	respect to $w$ and $\prec$.
  1066	
  1067	\begin{enumerate}
  1068	
  1069	\item $\mathcal G = \emptyset$.
  1070	
  1071	\item For each degree $d$ of a monomial $x^{u_i} \in \mathcal I$ do:
  1072	
  1073	\begin{enumerate}
  1074	\item Let $h=\dim_{\mathbb Q} I_d$.  Form the $h \times {n+d-1 \choose d}$
  1075	  matrix $A_d$ whose rows are the coefficients of a $\mathbb Q$-basis for
  1076	  $I_d$.  The columns of $A_d$ are indexed by the monomials of degree
  1077	  $d$, and we assume that the monomials in $\inn_{\prec}(\inn_w(I))_d$
  1078	  come first in the ordering.  The rows can be taken to be monomial
  1079	  multiples of the $f_i$.
  1080	\item Let $B_d$ be the result of multiplying $A_d$ by the inverse of
  1081	  the first $h \times h$ submatrix of $A_d$.  This submatrix is
  1082	  invertible by the argument of the proof of
  1083	  Proposition~\ref{proposition.complexity.valbound}.
  1084	\item For each $x^{u_i} \in \mathcal I$ of degree $d$, let $g_i$ be the
  1085	  polynomial corresponding to the row of $B_d$ that contains a $1$ in
  1086	  the column corresponding to $x^{u_i}$.  Add $g_i$ to $\mathcal G$.
  1087	\end{enumerate}
  1088	
  1089	
  1090	\item Output $\mathcal G$.
  1091	
  1092	\end{enumerate}
  1093	
  1094	\end{algorithm}
  1095	
  1096	\begin{proof}[Proof of correctness of algorithm~\ref{a:liftingalgo}]
  1097	The chosen polynomials have the property that no monomial other than
  1098	$x^{u_i}$ lies in $\inn_{\prec}(\inn_w(I))$, so
  1099	$\inn_{\prec}(\inn_w(g_i))=x^{u_i}$.  Thus the initial ideal $\inn_{\prec}(\inn_w(I))$ equals $\langle \inn_{\prec}(\inn_w(g_1)),\dots,\inn_{\prec}(\inn_w(g_r))
  1100	\rangle$, so the output is a reduced Gr\"obner basis as required.
  1101	\end{proof} 
  1102	
  1103	We incorporate this into the following algorithm, which computes a
  1104	Gr\"obner basis modulo $p^m$ for large $m$.
  1105	
  1106	\begin{algorithm} \label{a:modpm}
  1107	\hspace{1cm}\\ \noindent {\bf Input: } A list $\{f_1,\dots,f_l \}$ of homogeneous
  1108	polynomials in $\mathbb Q[x_1,\dots,x_n]$, a prime $p$, a
  1109	weight-vector $w \in \mathbb R^n$, and a term order $\prec$.
  1110	
  1111	\noindent {\bf Output: } A Gr\"obner basis for $\langle f_1,\dots,f_l \rangle$.  
  1112	
  1113	\begin{enumerate}
  1114	
  1115	\item Let $I = \langle f_1,\dots,f_l \rangle$.  Let $f_i^w =
  1116	  f_i(p^{w_1}x_1,\dots,p^{w_n}x_n)$ for $1 \leq i \leq l$.  Clear
  1117	  denominators in the $f_i^w$, and saturate the resulting ideal in
  1118	  $\mathbb Z[x_1,\dots,x_n]$ by $\langle p \rangle$.  Let
  1119	  $\tilde{I}_w$ be the image of this ideal in $\mathbb Z/p^m \mathbb
  1120	  Z[x_1,\dots,x_n]$.
  1121	
  1122	\item Compute $\inn_{\prec}(\inn_0(\tilde{I}_w))$ using
  1123	  Algorithm~\ref{a:Buchberger}. 
  1124	
  1125	\item Lift the resulting initial ideal to a Gr\"obner basis for $I$
  1126	  using Algorithm~\ref{a:liftingalgo}. \label{i:lift}
  1127	
  1128	\end{enumerate}
  1129	
  1130	\end{algorithm}
  1131	
  1132	
  1133	Note that the fact that Algorithm~\ref{a:Buchberger} does compute
  1134	$\inn_{\prec}(\inn_0(\tilde{I}_w))$ follows from Remark~\ref{r:Zmodpm}.
  1135	The following lemma shows that for $m$ sufficiently large this initial
  1136	ideal equals $\inn_{\prec}(\inn_w(I))$, so
  1137	Algorithm~\ref{a:liftingalgo} will terminate with the correct answer.
  1138	
  1139	
  1140	\begin{lemma}\label{prop.modpm.initialidealsequal}
  1141	For $m \gg 0$  Algorithm~\ref{a:modpm} terminates with the correct answer.
  1142	\end{lemma}
  1143	
  1144	\begin{proof}
  1145	We first show that for $m \gg 0$ we have
  1146	$\inn_{\prec}(\inn_0(\tilde{I}_w)) = \inn_{\prec}(\inn_w(I))$.  Note
  1147	that if $f = \sum c_u x^u$ with $c_u \in \mathbb Z$ with $\val(c_u) <
  1148	m$, then the image $\tilde{f}$ of $f$ in $\mathbb Z/p^m \mathbb
  1149	Z[x_1,\dots,x_n]$ satisfies $\inn_{\prec}(\inn_0(\tilde{f}))=
  1150	\inn_{\prec}(\inn_0(f))$.  Let $I_w = \langle f_i^w : 1 \leq i \leq l \rangle \subseteq 
  1151	\mathbb Q[x_1,\dots,x_n]$, so $\inn_w(I) = \inn_0(I_w)$.  By
  1152	Proposition~\ref{proposition.complexity.valbound} there is a bound in
  1153	terms of the absolute value of the coefficients of the generators of
  1154	$I$ on the maximum valuation that occurs in a reduced Gr\"obner basis.
  1155	For $m$ larger than this bound we have $\inn_{\prec}(\inn_w(I))
  1156	\subseteq \inn_{\prec}(\inn_0(\tilde{I}_w))$.
  1157	
  1158	For the reverse inclusion, fix $x^u \in
  1159	\inn_{\prec}(\inn_0(\tilde{I}_w))$.  Choose $f \in \tilde{I}_w$ with
  1160	$\inn_{\prec}(\inn_w(f))=x^u$.  By the definition of $\tilde{I}_w$
  1161	there is $g \in I_w$ with $f =\tilde{g}$.  By construction
  1162	$\inn_0(g)=\inn_0(f)$, so $x^u=\inn_{\prec}(\inn_0(g)) \in
  1163	\inn_{\prec}(\inn_0(I_w)) = \inn_{\prec}(\inn_w(I))$.
  1164	
  1165	In the first step of the algorithm, note that generators of the ideal
  1166	obtained by clearing denominators and saturating by $\langle p
  1167	\rangle$ generate $I_w \cap \mathbb Z_{\langle p \rangle}
  1168	       [x_1,\dots,x_n]$.  Since the image of an ideal $J \subset
  1169	       \mathbb Z[x_1,\dots,x_n]$ in $\mathbb Z/p^m \mathbb Z [x_1,\dots,x_n]$
  1170	       equals the ideal obtained by first taking the image of $J$ in
  1171	       $\mathbb Z_{\langle p \rangle}[x_1,\dots,x_n]$ and then taking
  1172	       the image in $\mathbb Z/p^m \mathbb Z[x_1,\dots,x_n]$ (using
  1173	       that $\mathbb Z_{\langle p \rangle}/\langle p^m \rangle \cong
  1174	       \mathbb Z/p^m \mathbb Z$), $\tilde{I}_w$ is the image of $I_w
  1175	       \cap \mathbb Z[x_1,\dots,x_n]$ in $\mathbb Z/p^m\mathbb
  1176	       Z[x_1,\dots,x_n]$.  The second step computes
  1177	       $\inn_{\prec}(\inn_0(\tilde{I}_w))$ by Remark~\ref{r:Zmodpm}.
  1178	       The equality $\inn_{\prec}(\inn_0(\tilde{I}_w)) =
  1179	       \inn_{\prec}(\inn_w(I))$ then guarantees that we have the
  1180	       correct input for Algorithm~\ref{a:liftingalgo}, so the
  1181	       algorithm terminates correctly.
  1182	\end{proof}
  1183	
  1184	
  1185	The bound on $m$ to guarantee that we are in the situation given in
  1186	Proposition~\ref{proposition.complexity.valbound}, may be ridiculously
  1187	large, and not tight.  If instead one uses an ad hoc choice for $m$,
  1188	step~\ref{i:lift} of Algorithm~\ref{a:modpm} will fail if the bound
  1189	chosen was too low.  We can thus iterate, repeating the computation
  1190	with a larger value of $m$.  This seems often to be the best choice in
  1191	practice.
  1192	
  1193	
  1194	\section{Cardinality}
  1195	\label{s:cardinality}
  1196	
  1197	In this  section we give an example which shows that a $p$-adic
  1198	Gr\"obner basis may be significantly smaller than any standard
  1199	Gr\"obner basis.  This gives another motivation to study such
  1200	Gr\"obner bases.
  1201	
  1202	
  1203	Recall that a monomial ideal $M$ is strongly stable, or Borel fixed,
  1204	if for all $x^u \in M$ with $u_j>0$ and $i<j$ we have $x_i/x_j x^u \in
  1205	M$.  Our construction requires a special case of the following
  1206	elementary lemma.
  1207	
  1208	\begin{lemma} \label{l:Borelfixed}
  1209	Fix degrees $d_1,\dots,d_l$, and let $\mathbb P = \prod_{i=1}^l
  1210	\mathbb P^{{d_i+n-1 \choose d_i}-1}$ be the parameter space for
  1211	sequences of homogeneous polynomials $f_1,\dots,f_l \subset
  1212	K[x_1,\dots,x_n]$ of degrees $d_1,\dots,d_l$, where $K$ has
  1213	characteristic zero.  Then there is a Zariski-open set $U \subseteq
  1214	\mathbb P$ for which if $p \in U$ then the ideal $I= \langle
  1215	f_1,\dots,f_l \rangle$ generated by the polynomials corresponding to
  1216	$p$ has the property that $\inn_{\prec}(I)$ is strongly stable for all
  1217	term orders $\prec$.  There are points in $U$ with any prescribed
  1218	valuations.
  1219	\end{lemma}
  1220	
  1221	\begin{proof}
  1222	Fix a term order $\prec$.  Note that $G = \mathrm{PGL}(n,K)$ acts on
  1223	$\mathbb P$ by change of coordinates on each factor.  There is a
  1224	nonempty open set $V \subset G \times \mathbb P$ for which
  1225	$\inn_{\prec}(gI)$ is constant for all $(g,p) \in V$.  Denote this
  1226	  initial ideal by $M_{\prec}$.  The existence of this open set $V$
  1227	  follows from the theory of comprehensive Gr\"obner
  1228	  bases~\cite{Weispfenning}.  For a fixed $p \in \mathbb P$, there is
  1229	  an open set $V' \subset G$ for which the initial ideal
  1230	  $\inn_{\prec}(gI)$ equals the generic initial ideal
  1231	  $\gin_{\prec}(I)$, which is strongly stable; see for
  1232	  example~\cite[Theorem 15.23]{Eisenbud}.  By considering any $p \in
  1233	  \mathbb P$ for which there is some $g \in G$ with $(g, p) \in V$, we
  1234	  see that the initial ideal $M_{\prec}$ is strongly stable.
  1235	
  1236	Since $V$ is open in $G \times \mathbb P$, the set $U_{\prec}=\{
  1237	p \in \mathbb P : (\id,p) \in V \}$ is open in $\mathbb P$,
  1238	and $\inn_{\prec}(I) = M_{\prec}$ for all $p \in U_{\prec}$.
  1239	The group $G$ acts on $G \times \mathbb P$ by $h \cdot (g, p) =
  1240	(gh^{-1}, hp) $.  Note that the set $V \subset
  1241	G \times \mathbb P$ is invariant under this action.  This means that
  1242	the set $U_{\prec}$ is nonempty, as given any $(g,p) \in V$, we also have $(\id,g^{-1}p) \in V$.    If $M_{\prec} = M_{\prec'}$ for two
  1243	different term orders $\prec, \prec'$, then we can take $U_{\prec} =
  1244	U_{\prec'}$, as the two term orders agree on the initial terms of a
  1245	reduced Gr\"obner basis of any $I=I(p)$ with $p \in U_{\prec}$.
  1246	The first part of the lemma then follows from the observation that the
  1247	Hilbert functions of all initial ideals $M_{\prec}$ agree and there
  1248	are only a finite number of strongly stable ideals with a given
  1249	Hilbert function, so there are only a finite number of open sets
  1250	$U_{\prec}$ to intersect to obtain an open set $U \subset \mathbb P$ with
  1251	$\inn_{\prec}(I)$ strongly stable for any $p \in U$ and any
  1252	term order $\prec$.
  1253	
  1254	Since $U \subset \mathbb P$ is open, so is its intersection with an
  1255	affine chart $\mathbb A^{\sum_{i=1}^l {d_i+n-1 \choose d_i}-l}$.  This open set 
  1256	contains the complement of a hypersurface $V(f)$ where $f \in
  1257	K[x_1,\dots,x_N]$ for $N= \sum_{i=1}^l {d_i+n-1 \choose d_i}-l$.  We now
  1258	show by induction on $N$ that the valuations of a point outside $V(f)$
  1259	can be prescribed.  When $N=1$, $V(f)$ is a finite set, so the base
  1260	case follows from the fact that there are infinitely many elements of
  1261	$K$ with a given valuation.  Now assume that the claim is true for
  1262	smaller $N$, and write $f =gx_1^m+ $ lower order terms, where $g \in
  1263	K[x_2,\dots,x_N]$.  Then by induction there is $x'=(x_2,\dots,x_N)$
  1264	with $g(x') \neq 0$ and with $\val(x')$ prescribed.  By the base case
  1265	there is $x_1$ with prescribed valuation for which the univariate
  1266	polynomial $f(x_1,x')$ is nonzero.  Then $(x_1,x') \in U$ is the
  1267	desired point.
  1268	\end{proof}
  1269	
  1270	The other ingredient needed for the construction is the notion of a
  1271	Stanley decomposition for a monomial ideal $M \subseteq
  1272	K[x_1,\dots,x_n]$.  For $\sigma \subseteq \{1,\dots,n \}$ and a
  1273	monomial $x^u$ we denote by $(x^u,\sigma)$ the set of monomials
  1274	$\{x^{u+v} : v_i=0 \text{ for } i \not \in \sigma \}$.  A Stanley
  1275	decomposition for $M$ is a union $\{ (x^{u_i},\sigma_i) : 1 \leq i
  1276	\leq s\}$ such that every monomial in $M$ lies in a unique set
  1277	$(x^{u_i},\sigma_i)$.  The key fact about Stanley decompositions is
  1278	that the Hilbert function $\dim_{K} I_t$ of $I$ is the sum
  1279	$\sum_{i=1}^s {t-|u_i|+|\sigma_i|-1 \choose |\sigma_i|}$.
  1280	
  1281	
  1282	\begin{theorem}
  1283	Fix an even integer $d=2e$.  Let $I=\langle f,g \rangle \subseteq
  1284	\mathbb Q[x_1,x_2,x_3]$ be two generic polynomials of degree $d$ where
  1285	every coefficient of $f$ except $x_1^d$ and every coefficient of $g$
  1286	except $x_2^{e}x_3^{e}$ has positive $2$-adic valuation, and the
  1287	remaining two coefficients have valuation zero.  Then $\inn_0(I) =
  1288	\langle x_1^d,x_2^{e}x_3^{e} \rangle$ with the $2$-adic valuation, but
  1289	any standard initial ideal $\inn_{\prec}(I)$ has at least $1/2(d+3)$
  1290	generators.
  1291	\end{theorem}
  1292	
  1293	\begin{proof}
  1294	Note first that the existence of $f,g$ satisfying these conditions
  1295	follows from Lemma~\ref{l:Borelfixed}, from which it also follows that
  1296	every standard initial ideal $\inn_{\prec}(I)$ is Borel-fixed.  That
  1297	$\{ f,g \}$ is a $2$-adic Gr\"obner basis for $I$ with respect to $w=0$ follows from
  1298	Buchberger's criterion~\ref{B1}.
  1299	
  1300	Fix a term order $\prec$, and let $\inn_{\prec}(I) = \langle
  1301	x^{u_1},\dots,x^{u_s} \rangle$.  Write $\{1,2,3\}=\{i_1,i_2,i_3\}$ so that $x_{i_1} \succ x_{i_2} \succ x_{i_3}$.
  1302	For $u \in \mathbb N^3$, denote by $m(u)$ the index $m(u) = \max(j :
  1303	u_{i_j} \neq 0 ) \in \{1,2,3\}$.  Since $\inn_{\prec}(I)$ is
  1304	Borel-fixed, the decomposition $\{ (x^{u_i}, \{i_{m(u_i)},\dots,i_3 \}) : 1
  1305	\leq i \leq s \}$ is a Stanley decomposition for $\inn_{\prec}(I)$.
  1306	This means that $\dim_{\mathbb Q}(\inn_{\prec}(I)_t) = \sum_{i=1}^s {t - |u_i|
  1307	  + 3-m(u_i) \choose 3-m(u_i) }$.  Without loss of generality we may
  1308	assume that $x^{u_1} =x_{i_1}^d$, and $m(u_i) \geq 2$ for $i \geq 2$.
  1309	Since $I$ is generated in degree $d$, $|u_i| \geq d$ for all $i$.
  1310	Since the Hilbert function of $I$ and any initial ideal (standard or
  1311	$2$-adic) agree, the fact that the $2$-adic initial ideal of $I$ is $\langle x_1^d,
  1312	x_2^{e}x_3^{e} \rangle$ implies that $\dim_{\mathbb Q}(I_t) = 2 {t-d +2 \choose
  1313	  2}$ for $d \leq t < 2d$.  Thus for $d \leq t < 2d$ we have
  1314	\begin{align*}
  1315	2{t-d+2 \choose 2} & = \sum_{i=1}^s {t - |u_i|  + 3-m(u_i) \choose 3-m(u_i) } \\
  1316	& \leq {t -d+2 \choose 2} +(s-1){ t - d + 1 \choose 1} \\
  1317	\end{align*}
  1318	so 
  1319	$$1/2(t-d+2)(t-d+1) \leq (s-1)(t-d+1).$$
  1320	This means that $s \geq 1/2(d+3)$, as required.
  1321	\end{proof}
