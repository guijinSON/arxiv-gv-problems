+                 and search_space(doubled) > space),
+        "base_n": guess_inst["n"],
+        "doubled_n": doubled["n"],
+        "base_space": space,
+        "doubled_space": search_space(doubled),
+        "doubled_planted_verifies": doubled_ok,
+    }
+
+    invariant_count = 0
+    carried_count = 0
+    distinct_keys = []
+    for seed in range(20):
+        inst = make_instance(seed=70_000 + seed, **shipping_params)
+        key = canonical_key(inst)
