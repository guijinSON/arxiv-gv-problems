+            "wall_clock_sec": round(reference_wall, 6),
+            "operations": reference_operations,
+            "average_operations": reference_operations // len(seeds),
+            "solves": f"{reference_successes}/{len(seeds)}, as expected",
+        },
+        "compact_route_audit": {
