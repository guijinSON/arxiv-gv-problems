+      "hinted": {
+        "attempts": 0,
+        "solved": 0
+      },
+      "placebo": {
+        "attempts": 0,
+        "solved": 0
+      }
+    },
+    "hinted_minus_placebo": null,
+    "hinted_verdict": "blocked_by_openrouter_quota",
+    "intended_route_operations": 145,
+    "oracle_results_pending": true,
+    "pass": false,
+    "within_caps": true
+  },
+  "all_passed": false,
+  "shipping_difficulty": "easy",
+  "shipping_params": {
+    "laps": 100003,
+    "n": 36
+  },
+  "track": "B"
+}
+

