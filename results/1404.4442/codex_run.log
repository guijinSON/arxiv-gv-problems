+def _rotate_raw_to_dyck(word: str, shift: int) -> str:
+    rotated = word[shift % len(word) :] + word[: shift % len(word)]
+    height = 0
+    minimum = 0
+    pivot = 0
+    for i, symbol in enumerate(rotated):
+        height += 1 if symbol == "1" else -1
+        if height < minimum:
+            minimum = height
+            pivot = i + 1
+    candidate = rotated[pivot:] + rotated[:pivot]
+    ok, _ = _is_dyck(candidate)
+    return candidate if ok else "10" * (len(word) // 2)
