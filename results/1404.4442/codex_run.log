  \ol{\rev}(\phat_F) &= p_F' \label{eq:rev-phF}
\end{align}
(recall that $\ol{\rev}$ simply mirrors a lattice path with $2n$ steps that ends at $(2n,0)$ along the axis $x=n$).
By induction we also know that
\begin{equation}
\label{eq:ell-r-phF-phL}
  (\ell(\phat_F),r(\phat_F)) = (\ell(\phat_L),r(\phat_L)) \enspace.
\end{equation}
Combining our previous observations we obtain
\begin{equation} \label{eq:pF'}
\begin{split}
  p_F' &\eqByM{\eqref{eq:rev-phF}, \eqref{eq:ell-r-F-partition}} \ol{\rev}\big((\upstep)\circ \ell(\phat_F) \circ(\downstep)\circ r(\phat_F)\big) \\
    &\eqBy{eq:ell-r-phF-phL} \ol{\rev}(r(\phat_L))\circ (\upstep)\circ \ol{\rev}(\ell(\phat_L))\circ (\downstep) \\
    &\eqByM{\eqref{eq:ell-r-pF-pL},\eqref{eq:ell-r-olpL-pL-flipp}} \ell(p_F) \circ (\upstep) \circ r(p_F) \circ (\downstep) \\
    &\eqByM{\eqref{eq:ell-r-pF-pS},\eqref{eq:ell-r-S-partition}} p_S[1,2n] \circ (\downstep) \enspace,
\end{split}
\end{equation}
completing the proof.
\end{proof}

