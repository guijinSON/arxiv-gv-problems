+# Filled from the script-owned oracle transcripts after the three runs.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 1},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "blocked_by_openrouter_quota",
