+def render(inst: dict) -> str:
+    n = inst["n"]
+    facts = {
+        "n": f"Semilength n: {n}",
+        "label": f"Cosmetic query label: {inst['label']}",
+        "start": f"Starting Dyck word p: {inst['start']}",
+        "iterations": f"Requested number of iterations T: {inst['iterations']}",
