+DIFFICULTY = {
+    "demo": {"n": 3, "laps": 2},
+    "easy": {"n": 36, "laps": 100_003},
+    "medium": {"n": 60, "laps": 10_000_019},
+    "hard": {"n": 96, "laps": 100_000_007},
+}
+SHIPPING_DIFFICULTY = "easy"
