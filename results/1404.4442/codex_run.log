+def _completion_count(n: int, ones_used: int, zeros_used: int) -> int:
+    if ones_used == n:
+        return 1
+    total = _completion_count(n, ones_used + 1, zeros_used)
+    if zeros_used < ones_used:
+        total += _completion_count(n, ones_used, zeros_used + 1)
+    return total
+
