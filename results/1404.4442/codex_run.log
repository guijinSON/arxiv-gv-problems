        w=''.join(bits)
        if g._is_dyck(w)[0]: words.append(w)
    for w in words:
        assert g._h(g._g0(w)) == g._g1(g._h(w))
        assert g._h_inverse(g._h(w)) == w
        for t in range(2*n):
            cur=w
            for _ in range(t): cur=g._g0(cur)
