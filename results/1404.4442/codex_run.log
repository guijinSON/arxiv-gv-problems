+def _components(word: str) -> list[str]:
+    parts: list[str] = []
+    height = 0
+    start = 0
+    for i, symbol in enumerate(word):
+        height += 1 if symbol == "1" else -1
+        if height == 0:
+            parts.append(word[start : i + 1])
+            start = i + 1
+    return parts
+
