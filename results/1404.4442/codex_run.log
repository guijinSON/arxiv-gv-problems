+        for name in attack_names
+    }
+    random_stats = {"successes": 0, "attempts": len(seeds), "steps": 0}
+    reference_successes = 0
+    reference_operations = 0
+    reference_started = time.perf_counter()
+    strongest_attack_started = time.perf_counter()
+    for seed in seeds:
