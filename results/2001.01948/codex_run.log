+
+def _build_instance(
+    n: int,
+    seed: int,
+    lag_max: int,
+    radius: int,
+    forced_lag: int | None = None,
+) -> dict:
+    rng = random.Random(seed)
+    rules: list[list[int]] = [[]]
+    states: list[list[int]] = [[0, 0]]
+    sizes = [1]
+    heights = [0]
