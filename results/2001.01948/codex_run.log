+def escalate(params):
+    p = dict(params)
+    n = int(p.get("n", 0))
+    copies = int(p.get("copies", 1))
+    for next_n in (23, 41, 59):
+        if n < next_n:
+            p["n"] = next_n
+            p["copies"] = 1 if next_n < 59 else max(2, copies)
+            return p
+    # Grow the clause/auxiliary haystack while the 59-bit witness and the
+    # 298-operation compact route stay fixed.
+    if copies < 8:
+        p["copies"] = copies + 1
+        return p
+    return "cap_bound"
 
 
