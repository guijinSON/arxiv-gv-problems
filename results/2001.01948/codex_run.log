   428	Then we color the two edges $u_{j_1,0}v_{j_1,0}$ and $u_{j_1,0}w_{j_1,0}$ with 2, and color the edge $v_{j_1,0}w_{j_1,0}$ with 1.
   429	Let $y=u_{j_1,0}$, $z\in \{u_{j_2,0}, v_{j_2,0}, w_{j_2,0}\}$ be two vertices.
   430	Then we can find a conflict-free path $P_{y,z}$ from $y$ to $z$ with color 2 which is the unique color such that edge $u_{j_1,0}v_{j_1,0}$ is in $E(P_{y,z})$.
   431	Let $y=w_{j_1,0}$, $z\in \{u_{j_2,0}, v_{j_2,0}, w_{j_2,0}\}$ be two vertices.
   432	Then we can find a conflict-free path $P_{y,z}$ from $y$ to $z$ with color 2 which is the unique color such that edge $u_{j_1,0}w_{j_1,0}$ is in $E(P_{y,z})$.
   433	Let $y=v_{j_1,0}$, $z\in \{u_{j_2,0}, v_{j_2,0}, w_{j_2,0}\}$ be two vertices.
   434	Then we can find a conflict-free path $P_{y,z}$ from $y$ to $z$ with color 1 which is the unique color such that edge $v_{j_1,0}w_{j_1,0}$ is in $E(P_{y,z})$.
   435	As a result, we have that $cfc(G)=2$. The proof is now complete. \qed
   436	
   437	\end{pf}
   438	
   439	
   440	\section{NP-hardness for the monochromatic connection number}
   441	
   442	In the last section we will deal with the complexity for the monochromatic connection number. The following result
   443	was obtained in \cite{CY}.
   444	
   445	\begin{thm}{\upshape \cite{CY}}\label{mc=m-n+2}
   446	Let $G$ be a connected graph with $n > 3$ vertices and $m$ edges. If $G$
   447	satisfies one of the following conditions, then $mc(G) = m - n + 2$.
   448	\begin{enumerate}
   449	\item $G$ is 4-connected.
   450	\item $G$ is triangle-free.
   451	\item $\Delta(G) < n- \frac{2m-3(n-1)}{n-3}$. In particular, this holds if $\Delta(G) \leq \frac{n+1}{2}$ or $\Delta(G) \leq n - \frac{2m}{2n}$.
   452	\item $diam(G) \geq 3$.
   453	\item $G$ has a cut vertex.
   454	\end{enumerate}
   455	\end{thm}
   456	
   457	Inspired by the concept of a monochromatic path which uses exact one color,
   458	we consider a path using at most $k$ distinct colors. Next, we will use the color-distance as a tool.
   459	Given a positive integer $k$ and a graph $G$, if one asks for an edge-coloring of $G$ satisfying
   460	that for any pair of vertices of $G$ there exists a path in $G$ which uses at most $k$ distinct colors between the two vertices,
   461	then the maximum number of distinct colors for the edge-coloring $G$ is $cc_k(G)$.
   462	We can consider $cc_k(G)$ in an opposite way which counts the total number of ''wasted" colors in the following lemma.
   463	
   464	\begin{lem}\label{Waste}
   465	Let $f$ be an extremal $k$-color connection coloring of $G$. Then each color forms a forest.
   466	For a color $r$, denote by $F_r$ the subgraph induced by the set of edges colored with $r$.
   467	We call $F_r$ the {\it color forest} of the color $r$. A color forest with $m(F_r)$
   468	edges is said to {\it waste} $m(F_r)-1$ colors. Hence, $F_r$ is said to be nontrivial if and only if $m(F_r)-1>0$.
   469	Let $W_k(G)$ be the total number of wasted colors. Then $cc_k(G)=m(G)-W_k(G)$.
   470	\end{lem}
   471	\begin{pf}
   472	We claim that the subgraph $F_r$ induced by the set of edges colored with $r$ is a forest. Assume to the contrary,
   473	there is a cycle in $F_r$. Then it is possible to choose any edge in this cycle and color it with a fresh color
   474	while still maintaining a $k$-color connecting coloring, a contradiction.
   475	
   476	Next, the $k$-color connection number counts the number of distinct color forests.
   477	Hence, we have $cc_k(G)=\sum_c 1 =m(G)- \sum_c (m(F_c)-1)= m(G)-W_k(G)$. \qed
   478	\end{pf}
   479	
   480	\begin{lem}\label{range}
   481	For a connected graph $G$, $0\leq W_k(G)\leq n-1-k$.
   482	\end{lem}
   483	\begin{pf}
   484	By definition, we know that $W_k(G)=0$ if and only if $diam(G)$ is at most $k$.
   485	Let $H$ be a connected induced subgraph of $G$. We can construct a $k$-color connecting coloring
   486	of $G$ by adding $m(G)-m(h)$ new colors to a $k$-color connecting coloring of $H$,
   487	and hence $cc_k(G)\geq cc_k(H)+m(G)-m(H)$. Then we have $W_k(G)\leq W_k(H)$ by Lemma \ref{Waste}.
   488	
   489	Next we consider the upper bound of $W_k(G)$. Let $T$ be a spanning tree of graph $G$.
   490	Then $cc_k(T)$ can be calculated in Section 4. Hence, $m(G)-cc_k(T)$ is an alternative upper bound.
   491	In general, we have $W_k(G)\leq n-1-k$ by our Algorithms \ref{odd} and \ref{even} in next section.
   492	Moreover, $W_k(G)$ achieves its upper bound if and only if $G$ is a path. \qed
   493	\end{pf}
   494	
   495	\begin{lem}\label{NP}
   496	Let $k$ be a positive integer. Given a connected graph $G$ associated with an edge-coloring $f$ on
   497	$n$ vertices, one can decide if $cD(G)\leq k$ in polynomial time.
   498	\end{lem}
   499	\begin{pf}
   500	Let $[l]$ be the color set of $f$. Clearly, $l\leq m(G)$. Next we choose a pair of vertices $v,t$ in $G$ arbitrarily.
   501	Let $C$ be a color set chosen from $[l]$ such that $|C|=k$. In this step, we have exact $\tbinom{l}{k}$ choices.
   502	Since $k$ is a constant and $m(G)\leq n^2$, it follows that we can check each choice in $\mathcal{O}(n^{2k})$ time.
   503	Then we star form a vertex set $S_0=\{v\}$.
   504	If there exist two vertices $u\in S_i$ and $u^\prime\not\in S_i$ such that the edge $uu^\prime$ receives a color $c\in C$,
   505	then $S_{i+1}=S_i\cup u^\prime$ for $i\in[n]$. If there do not exist two vertices $u\in S_i$ and $u^\prime\not\in S_i$ such that the edge $uu^\prime$ receives a color $c\in C$,
   506	then $S_{i+1}=S_i$ for $i\leq n(G)$. In this step, we should check the neighbour of vertex set $S_i$ for each $i\in[n]$. And this can be done in $\mathcal{O}(n^2)$ time.
   507	Since there are at most $\tbinom{n}{2}$ pairs of vertices, one can decide if $cD(G)\leq k$ in $\mathcal{O}(n^{2k+4})$ time. \qed
   508	\end{pf}
   509	
   510	Let $f$ be an extremal $1$-color connection coloring of $G$, then the color forest $F_c$ is a tree,
   511	and the tree is called a color tree $T_c$ in \cite{CY}. However $F_c$ is not always a tree for $k>1$, see Figure \ref{mc1}.
   512	
   513	Next we consider the case when $k=1$.
   514	
   515	Let $u,v$ be two vertices of $G$. If $u,v$ are adjacent, then $cd(u,v)=1$. If $u,v$ are nonadjacent, then we should waste colors to
   516	construct a path that uses only one color between $u$ and $v$. Hence we consider the complement graph $\overline G$.
   517	We say that a color tree $T_c$ connects the edge $uv\in \overline G$ when $u$ and $v$ lie in a same color tree.
   518	
   519	Let $w$ be a vertex of degree $p$ in $\overline G$.
   520	Then there are more than $p$ wasted edges related to $w$. We display the fact in the following lemma.
   521	
   522	\begin{lem}\label{p}
   523	Let $f$ be an extremal 1-color connection coloring of $G$, and the degree of a vertex $w\in \overline G$
   524	be $p$. Then $\sum_{T_c\in S} (m(T_c)-1)\geq p$, in which $S=\{T_c: w\in V(T_c), c\in [l]\}$.
   525	\end{lem}
   526	
   527	\begin{pf}
   528	Let $N[w]$ be the closed neighborhood of vertex $w \in \overline G$,
   529	and $T_c$ be a nontrivial color tree such that it connects some edges
   530	which are adjacent to $w$ in $\overline G$. Clearly, $w\in V(T_c)$ and we have $V(T_c)\nsubseteq N[w]$.
   531	Suppose $V(T_c)\cap N[w]=t$. Then $T_c$ connects $t-1$ edges which are adjacent to $w$.
   532	Since $V(T_c)\geq t+1$, $m(T_c)-1\geq t-1$. Summing up the inequality, and we have $\sum_{T_c\in S} (m(T_c)-1)\geq p$. \qed
   533	\end{pf}
   534	
