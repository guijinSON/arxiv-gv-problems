+    """Use the tight overlap cycle as a second-order GF(2) recurrence."""
+    variables, rhs = _ordered_cycle_data(inst)
+    n = len(variables)
+    y = [0, 0]
+    operations = 2 * n  # decode one representative sign triple per support
+    for i in range(n - 2):
