+        operations += 2
 
+    wrap1 = rhs[n - 2] ^ y[n - 2] ^ y[n - 1] ^ y[0]
+    wrap2 = rhs[n - 1] ^ y[n - 1] ^ y[0] ^ y[1]
+    operations += 6
+    if n % 3 == 2:
+        b = wrap1
+        a = wrap2
+        c = a ^ b
+    elif n % 3 == 1:
+        c = wrap1
+        b = wrap2
+        a = c ^ b
+    else:
+        return None, operations
+    operations += 1
 
