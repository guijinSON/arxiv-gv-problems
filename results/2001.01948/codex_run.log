+}
+
+DIFFICULTY = {
+    "demo": {"n": 4, "doublings": 1, "radius": 1},
+    "easy": {"n": 84, "doublings": 15, "radius": 40},
+    "medium": {"n": 96, "doublings": 16, "radius": 46},
+    "hard": {"n": 112, "doublings": 17, "radius": 54},
+}
+SHIPPING_DIFFICULTY = "easy"
