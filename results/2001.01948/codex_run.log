-object is a tree, two vertices have a unique path. The colour-distance of two
-vertices is the number of distinct colours on that path. A colouring is
-k-colour-connecting when every pair has colour-distance at most k. cc_k(T) is
-the maximum number of distinct edge colours in such a colouring. Here k is the
-odd integer {inst['k']}, and r=(k-1)/2={inst['radius']}.
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    tagged = re.findall(
+        r"<answer\b[^>]*>(.*?)</answer>", text,
+        flags=re.IGNORECASE | re.DOTALL,
+    )
+    bodies = list(reversed(tagged))
+    if not bodies:
+        bodies = list(reversed(re.findall(r"\[[\s\d,+-]*\]", text, re.DOTALL)))
+    for body in bodies:
+        cleaned = body.strip()
+        cleaned = re.sub(r"^```(?:json)?\s*", "", cleaned, flags=re.IGNORECASE)
+        cleaned = re.sub(r"\s*```$", "", cleaned)
+        try:
+            value = json.loads(cleaned)
+        except (TypeError, ValueError):
+            continue
+        if isinstance(value, list):
+            return value
+    return None
 
