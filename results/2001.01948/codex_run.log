+    return {
+        "n": n,
+        "k": 2 * radius + 1,
+        "radius": radius,
+        "root": root,
+        "doublings": doublings,
+        "rules": rules,
+        "expanded_vertices": sizes[root],
+        "expanded_edges": sizes[root] - 1,
+        "height": heights[root],
+        "answer": answer,
