+"""Verified Track-B generator for Algorithm 1 of arXiv:2001.01948.
+
+The paper proves that its bottom-up integer recurrence returns the k-colour
+connection number of a tree when k is odd.  This module presents a tree by a
+finite acyclic grammar of repeated rooted subtrees.  The certificate is the
+algorithm's exact root state and output; the checker recomputes them on the
+grammar, while the expanded tree contains millions of vertices.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "other",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "finite rooted tree given by an acyclic repeated-subtree grammar",
+        "odd-k colour-connection root state",
+    ],
+    "verification_operations": [
+        "exact integer addition",
+        "maximum and equality comparison",
+        "local dynamic-programming recurrence checks",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "All copies generated by one rooted-subtree type have identical Algorithm 1 "
+        "states, so a solver can quotient millions of vertex updates by the finite "
+        "subtree grammar."
+    ),
+    "hardness_basis": (
+        "Track B: Theorem 5.2 proves that Algorithm 1 computes cc_k(T) for odd k "
+        "in O(N) time on an explicit N-vertex tree; over eight shipping seeds the "
+        "expanded reference averaged 6,092,042 vertices, 11,462,459 exact additions, "
+        "and 1.97 seconds, whereas quotienting by repeated subtree type uses 90 "
+        "exact additions."
+    ),
+    "max_answer_tokens": 6,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 4, "lag_max": 2, "radius": 1},
+    "easy": {"n": 40, "lag_max": 5, "radius": 5},
+    "medium": {"n": 42, "lag_max": 5, "radius": 5},
+    "hard": {"n": 44, "lag_max": 5, "radius": 5},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Every occurrence generated by the same named subtree type has the same pair "
+    "of Algorithm 1 states."
+)
+PLACEBO_HINT = (
+    "Keep the type identifiers and the order of the three requested integers fixed "
+    "when writing the final answer."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list [value,root_a,root_b] of three base-10 integers, with "
+        "0 <= root_a < the tree edge count, root_b=r, and "
+        "value=root_a+1."
+    ),
+    "bounds": {
+        "length": 3,
+        "root_a_min": 0,
+        "root_a_max": "expanded edge count minus one",
+        "root_b": "(k-1)/2",
+        "value": "root a-coordinate + 1",
+    },
+}
+
+# Filled from script-owned oracle transcripts after the three runs.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
+}
+
+NOTES = r"""
+Definition and certificate source. Section 1 defines colour-distance as the
+minimum number of distinct colours on a path and cc_k(G) as the maximum number
+of edge colours subject to colour-diameter at most k. Section 5 works directly
+with trees. Lemma 5.1 gives the extremal-colouring structure, Algorithm 1 gives
+the two-integer bottom-up recurrence for odd k, and Theorem 5.2 proves its
+output a(root)+1 is cc_k(T). The returned triple records the exact root state
+and output of that native recurrence.
+
+Step-0 decision and easy regimes. This cannot be Track A: Theorem 5.2 explicitly
+gives an O(N) algorithm, cc_1(T)=1 is stated at the start of Section 5, and the
+paper's general-graph polynomial verifier appears in Lemma 4.4. It is Track B.
+The expanded reference algorithm visits every one of millions of vertices; the
+compact route observes that every fresh copy of a grammar type has the same
+state and evaluates each type once. The exact mechanical and compact costs are
+measured in selftest rather than hidden behind asymptotic notation.
+
+Construction. Type 0 is a leaf. Every later type contains a fresh copy of the
+previous type and, from type 2 onward, a second seed-selected back-reference two
+to five levels behind; the root uses two copies of the previous type. While each
+rule is assembled, its size, height and (a,b)
+state are composed from already certified child types. Thus the answer is known
+by composition of identities; generation never solves a finished instance. The
+two deep root branches put the root on a diameter and satisfy Algorithm 1's
+radius condition.
+
+Attacks and symmetry. The outlier bound, first-child greedy rule, a rule that
+incorrectly deduplicates repeated child types, a recurrence that forgets the
+paper's cutoff, and 256 structure-aware random restarts are required to fail on
+eight shipping seeds. The successful expanded Algorithm 1 is reported separately
+as Track B's reference algorithm. Child order and grammar type names are purely
+presentational; canonical_key recursively hashes the unordered rooted tree and
+is tested under both symmetries and their composition.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_FENCE_RE = re.compile(r"```(?:json|text)?\s*(.*?)```", re.I | re.S)
+_ENUMERATION_CAP = 100_000
+
+
+def _int_at_least(name: str, value: object, low: int) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < low:
+        raise ValueError(f"{name} must be an integer at least {low}")
+    return value
+
+
+def _compose_state(children: list[int], states: list[list[int]], radius: int) -> list[int]:
+    """Compose one Algorithm 1 state from already certified child states."""
+    a_parent = 0
+    b_parent = 0
+    for child in children:
+        a_child, b_child = states[child]
+        if b_child == radius:
+            a_parent += a_child
+            b_parent = radius
+        else:
+            a_parent += a_child + 1
+            b_parent = max(b_parent, b_child + 1)
+    return [a_parent, b_parent]
+
+
+def _build_instance(
+    n: int,
+    seed: int,
+    lag_max: int,
+    radius: int,
+    forced_lag: int | None = None,
+) -> dict:
+    rng = random.Random(seed)
+    rules: list[list[int]] = [[]]
+    states: list[list[int]] = [[0, 0]]
+    sizes = [1]
+    heights = [0]
+
+    for type_id in range(1, n):
+        if type_id == 1:
+            children = [0, 0] if rng.randrange(2) else [0]
+        elif type_id == n - 1:
+            children = [type_id - 1, type_id - 1]
+        else:
+            upper = min(lag_max, type_id)
+            lag = rng.randint(2, upper) if forced_lag is None else min(forced_lag, upper)
+            children = [type_id - 1, type_id - lag]
+        rng.shuffle(children)
+        rules.append(children)
+        sizes.append(1 + sum(sizes[child] for child in children))
+        heights.append(1 + max(heights[child] for child in children))
+        states.append(_compose_state(children, states, radius))
+
+    root = n - 1
+    if len(rules[root]) < 2:
+        raise AssertionError("the generated root must have two diameter branches")
+    if min(heights[c] + 1 for c in rules[root]) < radius:
+        raise AssertionError("root does not satisfy Algorithm 1's radius condition")
+    answer = [states[root][0] + 1, states[root][0], states[root][1]]
+    return {
+        "n": n,
+        "k": 2 * radius + 1,
+        "radius": radius,
+        "root": root,
+        "lag_max": lag_max,
+        "rules": rules,
+        "expanded_vertices": sizes[root],
+        "expanded_edges": sizes[root] - 1,
+        "height": heights[root],
+        "answer": answer,
+    }
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Compose a certified repeated-subtree instance without solving it."""
+    n = _int_at_least("n", n, 4)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+    lag_max = _int_at_least("lag_max", params.pop("lag_max", 5), 2)
+    radius = _int_at_least("radius", params.pop("radius", max(1, (n - 2) // 2)), 1)
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    if lag_max > n - 1:
+        raise ValueError("lag_max must be at most n-1")
+    if radius > n - 2:
+        raise ValueError("radius must be at most n-2")
+    return _build_instance(n, seed, lag_max, radius)
+
+
+def render(inst: dict) -> str:
+    rules = inst["rules"]
+    lines = [f"  {i}: {json.dumps(children, separators=(',', ':'))}" for i, children in enumerate(rules)]
+    statement = f"""Compute a certified odd-k colour-connection number of a compact tree.
+
+A finite rooted tree is specified by the acyclic grammar below. Type 0 is a
+single leaf. An occurrence of any other type i is one new root joined by an edge
+to the root of a FRESH, DISJOINT copy of every child type listed on line i.
+Repeated child identifiers mean repeated fresh copies; their multiplicity matters.
+The order of children does not matter. The whole tree is type {inst['root']}.
+Expanding the grammar gives exactly {inst['expanded_vertices']} vertices and
+{inst['expanded_edges']} edges; this count is supplied only as a check.
+
+An edge-colouring assigns a positive-integer colour to every edge. Because this
+object is a tree, two vertices have a unique path. The colour-distance of two
+vertices is the number of distinct colours on that path. A colouring is
+k-colour-connecting when every pair has colour-distance at most k. cc_k(T) is
+the maximum number of distinct edge colours in such a colouring. Here k is the
+odd integer {inst['k']}, and r=(k-1)/2={inst['radius']}.
+
+For this rooted tree, the paper's Algorithm 1 starts every vertex with state
+(a,b)=(0,0), processes children before parents, and applies one update per child:
+
+* if the child's b equals r, add its a to the parent's a and set parent b=r;
+* otherwise add child a+1 to parent a and replace parent b by
+  max(parent b, child b+1).
+
+Its output is a(root)+1, which Theorem 5.2 proves equals cc_k(T). Although the
+expanded algorithm gives every vertex a state, identical fresh copies of a
+grammar type necessarily finish with identical states.
+
+Grammar (type: child-type list):
+{chr(10).join(lines)}
+
+Return exactly one JSON list [value,root_a,root_b], where root_a and root_b are
+the final state of type {inst['root']} and value=root_a+1=cc_k(T). Every entry is
+a base-10 integer; type identifiers are 0-indexed and repeated children count
+with the multiplicity displayed by the grammar.
+
+Give your final answer inside <answer></answer> tags, as compact JSON.
+Example: <answer>[3,2,1]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: object) -> object | None:
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if match:
+        payload = match.group(1).strip()
+    else:
+        fence = _FENCE_RE.search(text)
+        payload = fence.group(1).strip() if fence else text.strip()
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, (dict, list)) else None
+
+
+def _instance_shape(inst: dict) -> tuple[list[int], list[int]]:
+    """Return exact expanded sizes/heights after validating the grammar DAG."""
+    rules = inst.get("rules")
+    if not isinstance(rules, list) or not rules:
+        raise ValueError("instance grammar is malformed")
+    n = len(rules)
+    visiting: set[int] = set()
+    sizes: list[int | None] = [None] * n
+    heights: list[int | None] = [None] * n
+
+    def visit(type_id: int) -> tuple[int, int]:
+        if not 0 <= type_id < n:
+            raise ValueError("instance has an out-of-range child type")
+        if sizes[type_id] is not None:
+            return int(sizes[type_id]), int(heights[type_id])
+        if type_id in visiting:
+            raise ValueError("instance grammar contains a cycle")
+        visiting.add(type_id)
+        children = rules[type_id]
+        if not isinstance(children, list) or any(
+            isinstance(c, bool) or not isinstance(c, int) for c in children
+        ):
+            raise ValueError("instance child list is malformed")
+        child_shapes = [visit(c) for c in children]
+        visiting.remove(type_id)
+        sizes[type_id] = 1 + sum(s for s, _ in child_shapes)
+        heights[type_id] = 0 if not children else 1 + max(h for _, h in child_shapes)
+        return int(sizes[type_id]), int(heights[type_id])
+
+    for i in range(n):
+        visit(i)
+    return [int(x) for x in sizes], [int(x) for x in heights]
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Recompute the exact root state without consulting inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer list is empty"
+    if len(answer) != 3:
+        return False, "answer must contain exactly three integers"
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in answer):
+        return False, "all three answer entries must be integers"
+    value, root_a, root_b = answer
+    rules = inst.get("rules")
+    if not isinstance(rules, list):
+        return False, "instance grammar is malformed"
+    try:
+        sizes, heights = _instance_shape(inst)
+    except ValueError as exc:
+        return False, str(exc)
+    radius = inst.get("radius")
+    root = inst.get("root")
+    if isinstance(radius, bool) or not isinstance(radius, int) or radius < 1:
+        return False, "instance radius is malformed"
+    if isinstance(root, bool) or not isinstance(root, int) or not 0 <= root < len(rules):
+        return False, "instance root is malformed"
+    if inst.get("k") != 2 * radius + 1:
+        return False, "instance k is inconsistent with its radius"
+    if inst.get("expanded_vertices") != sizes[root] or inst.get("expanded_edges") != sizes[root] - 1:
+        return False, "instance expansion count is inconsistent with its grammar"
+    if not 1 <= value <= sizes[root] - 1:
+        return False, "value is outside the possible edge-colour range"
+    if not 0 <= root_a < sizes[root] - 1:
+        return False, "root a-coordinate is outside its declared bound"
+    if not 0 <= root_b <= radius:
+        return False, "root b-coordinate is outside its declared bound"
+    if value != root_a + 1:
+        return False, "value is not the root a-coordinate plus one"
+    memo: dict[int, list[int]] = {}
+
+    def state(type_id: int) -> list[int]:
+        if type_id not in memo:
+            child_states = [state(c) for c in rules[type_id]]
+            local = [0, 0]
+            for a_child, b_child in child_states:
+                if b_child == radius:
+                    local[0] += a_child
+                    local[1] = radius
+                else:
+                    local[0] += a_child + 1
+                    local[1] = max(local[1], b_child + 1)
+            memo[type_id] = local
+        return memo[type_id]
+
+    expected_a, expected_b = state(root)
+    if root_a != expected_a:
+        return False, "root a-coordinate does not match Algorithm 1"
+    if root_b != expected_b:
+        return False, "root b-coordinate does not match Algorithm 1"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    edge_count = inst["expanded_edges"]
+    root_a = rng.randrange(edge_count)
+    return [root_a + 1, root_a, inst["radius"]]
+
+
+def search_space(inst: dict) -> int:
+    return inst["expanded_edges"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    total = search_space(inst)
+    if total > _ENUMERATION_CAP:
+        return None
+    count = 0
+    for root_a in range(inst["expanded_edges"]):
+        count += int(verify(inst, [root_a + 1, root_a, inst["radius"]])[0])
+    return count
+
+
+def _canonical_digest(inst: dict) -> str:
+    rules = inst["rules"]
+    root = inst["root"]
+    memo: dict[int, bytes] = {}
+    visiting: set[int] = set()
+
+    def digest(type_id: int) -> bytes:
+        if type_id in memo:
+            return memo[type_id]
+        if type_id in visiting:
+            raise ValueError("cyclic grammar")
+        visiting.add(type_id)
+        children = sorted(digest(c) for c in rules[type_id])
+        payload = b"L" if not children else b"N" + b"".join(children)
+        result = hashlib.sha256(payload).digest()
+        visiting.remove(type_id)
+        memo[type_id] = result
+        return result
+
+    return digest(root).hex()
+
+
+def canonical_key(inst: dict) -> str:
+    return f"odd-k={inst['k']}|rooted-tree={_canonical_digest(inst)}"
+
+
+def escalate(params: dict) -> dict | str | None:
+    harder = {k: v for k, v in params.items() if not k.startswith("_")}
+    lag_max = int(harder.get("lag_max", 5))
+    if lag_max <= 2:
+        return None
+    harder["lag_max"] = lag_max - 1
+    return harder
+
+
+def _compact_table(inst: dict, mode: str = "correct") -> list[list[int]]:
+    """Build attack/reference states without reading the planted answer."""
+    rules = inst["rules"]
+    radius = inst["radius"]
+    states: list[list[int]] = []
+    sizes, heights = _instance_shape(inst)
+    for i, children in enumerate(rules):
+        if not children:
+            states.append([0, 0])
+            continue
+        chosen = list(children)
+        if mode == "first_child":
+            chosen = chosen[:1]
+        elif mode == "deduplicate":
+            chosen = list(dict.fromkeys(chosen))
+        if mode == "edge_bound":
+            states.append([sizes[i] - 1, min(heights[i], radius)])
+            continue
+        if mode == "no_cutoff":
+            a_value = sum(states[c][0] + 1 for c in chosen)
+            b_value = min(radius, max(states[c][1] + 1 for c in chosen))
+            states.append([a_value, b_value])
+            continue
+        states.append(_compose_state(chosen, states, radius))
+    return states
+
+
+def _compact_states(inst: dict, mode: str = "correct") -> list[int]:
+    states = _compact_table(inst, mode)
+    root_a, root_b = states[inst["root"]]
+    return [root_a + 1, root_a, root_b]
+
+
+def _compact_operation_count(inst: dict) -> int:
+    states = _compact_table(inst)
+    radius = inst["radius"]
+    operations = 1  # a(root)+1
+    for children in inst["rules"]:
+        for child in children:
+            operations += 1  # accumulate a_child (or a_child+1)
+            if states[child][1] != radius:
+                operations += 1  # the +1 in a_child+1
+    return operations
+
+
+def _expanded_reference(inst: dict) -> tuple[dict, dict]:
+    """Run paper Algorithm 1 once per occurrence, deliberately without memoization."""
+    rules = inst["rules"]
+    radius = inst["radius"]
+    observed: list[list[int] | None] = [None] * len(rules)
+    nodes = 0
+    arithmetic = 1
+
+    def visit(type_id: int) -> tuple[int, int]:
+        nonlocal nodes, arithmetic
+        nodes += 1
+        a_value = 0
+        b_value = 0
+        for child in rules[type_id]:
+            a_child, b_child = visit(child)
+            arithmetic += 1
+            if b_child == radius:
+                a_value += a_child
+                b_value = radius
+            else:
+                arithmetic += 1
+                a_value += a_child + 1
+                b_value = max(b_value, b_child + 1)
+        row = [a_value, b_value]
+        if observed[type_id] is None:
+            observed[type_id] = row
+        elif observed[type_id] != row:
+            raise AssertionError("identical subtree occurrences acquired different states")
+        return a_value, b_value
+
+    root_a, root_b = visit(inst["root"])
+    answer = [root_a + 1, root_a, root_b]
+    return answer, {"expanded_vertices": nodes, "arithmetic_operations": arithmetic}
+
+
+def _relabel(inst: dict, permutation: list[int], reverse_children: bool) -> dict:
+    n = len(inst["rules"])
+    transformed = json.loads(json.dumps(inst))
+    new_rules: list[list[int] | None] = [None] * n
+    for old in range(n):
+        children = [permutation[c] for c in inst["rules"][old]]
+        if reverse_children:
+            children.reverse()
+        new_rules[permutation[old]] = children
+    transformed["rules"] = [list(x) for x in new_rules]
+    transformed["root"] = permutation[inst["root"]]
+    transformed["answer"] = list(inst["answer"])
+    return transformed
+
+
+def _transform_variants(inst: dict, seed: int) -> list[dict]:
+    n = len(inst["rules"])
+    identity = list(range(n))
+    rng = random.Random(seed)
+    permutation = list(range(n))
+    rng.shuffle(permutation)
+    return [
+        _relabel(inst, identity, True),
+        _relabel(inst, permutation, False),
+        _relabel(inst, permutation, True),
+    ]
+
+
+def _attack_candidates(inst: dict, seed: int) -> dict[str, list[object]]:
+    rng = random.Random(seed ^ 0x200101948)
+    return {
+        "outlier_subtree_edge_bound": [_compact_states(inst, "edge_bound")],
+        "greedy_first_child": [_compact_states(inst, "first_child")],
+        "by_hand_deduplicate_repeated_types": [_compact_states(inst, "deduplicate")],
+        "paper_recurrence_without_cutoff": [_compact_states(inst, "no_cutoff")],
+        "random_restart_256": [random_candidate(inst, rng) for _ in range(256)],
+    }
+
+
+def _worst_case_answer_size(params: dict) -> tuple[int, int]:
+    plain = {k: v for k, v in params.items() if not k.startswith("_")}
+    instances = [
+        _build_instance(plain["n"], bit, plain["lag_max"], plain["radius"], forced_lag=lag)
+        for lag in (2, plain["lag_max"])
+        for bit in (0, 1)
+    ]
+    lengths = [len(json.dumps(x["answer"], separators=(",", ":"))) for x in instances]
+    chars = max(lengths)
+    return chars, math.ceil(chars / 4)
+
+
+def selftest() -> dict:
+    report: dict[str, object] = {}
+
+    planted_checks = 0
+    json_checks = 0
+    planted_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            planted_checks += int(ok)
+            json_checks += int(json.loads(json.dumps(inst["answer"])) == inst["answer"])
+            if not ok:
+                planted_failures.append([preset, seed, why])
+    report["G1_planted_verifies"] = {
+        "pass": planted_checks == 12 and json_checks == 12,
+        "verified": planted_checks,
+        "attempts": 12,
+        "json_native_round_trips": json_checks,
+        "failures": planted_failures,
+    }
+
+    shipping = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    inst = make_instance(seed=19, **shipping)
+    answer = json.loads(json.dumps(inst["answer"]))
+    drop = answer[:-1]
+    swapped = [answer[2], answer[1], answer[0]]
+    duplicated = [answer[0], answer[0], answer[2]]
+    out_of_range = [inst["expanded_edges"] + 1, answer[1], answer[2]]
+    corruptions = {
+        "drop": drop,
+        "swap": swapped,
+        "duplicate": duplicated,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    cases = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        cases[name] = {"rejected": not ok, "reason": why}
+    reasons = [case["reason"] for case in cases.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(case["rejected"] for case in cases.values()) and len(set(reasons)) == 5,
+        "cases": cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    response = (
+        "The repeated subtrees give this root state.\n```json\n<answer>"
+        + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```\nThe first entry is the requested colour count."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_equals_answer": parsed == answer,
+    }
+
+    guess_rng = random.Random(0x200101948)
+    guess_total = 200_000
+    guess_hits = 0
+    start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
+    guess_seconds = time.perf_counter() - start
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_fraction,
+        "candidate_space_bits": search_space(inst).bit_length(),
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    attack_names = [
+        "outlier_subtree_edge_bound",
+        "greedy_first_child",
+        "by_hand_deduplicate_repeated_types",
+        "paper_recurrence_without_cutoff",
+        "random_restart_256",
+    ]
+    successes = {name: 0 for name in attack_names}
+    attack_seconds = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    compact_successes = 0
+    reference_seconds = 0.0
+    reference_operations = 0
+    reference_vertices = 0
+    for seed in range(101, 109):
+        trial = make_instance(seed=seed, **shipping)
+        candidates = _attack_candidates(trial, seed)
+        for name in attack_names:
+            start = time.perf_counter()
+            won = any(verify(trial, candidate)[0] for candidate in candidates[name])
+            attack_seconds[name] += time.perf_counter() - start
+            successes[name] += int(won)
+        start = time.perf_counter()
+        recovered, counts = _expanded_reference(trial)
+        reference_seconds += time.perf_counter() - start
+        reference_successes += int(verify(trial, recovered)[0])
+        reference_operations += counts["arithmetic_operations"]
+        reference_vertices += counts["expanded_vertices"]
+        compact_successes += int(verify(trial, _compact_states(trial))[0])
+
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_seconds[name], 6),
+        }
+        for name in attack_names
+    }
+    reference = {
+        "name": "paper Algorithm 1 on every vertex of the expanded tree",
+        "complexity": "O(N) exact vertex/edge updates",
+        "wall_clock_sec": round(reference_seconds / 8, 6),
+        "operations": reference_operations // 8,
+        "expanded_vertices": reference_vertices // 8,
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    all_failed = all(value == 0 for value in successes.values())
+    compact_operations = _compact_operation_count(inst)
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8 and compact_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": reference,
+        "intended_compact_route": {
+            "name": "quotient Algorithm 1 by repeated rooted-subtree type",
+            "solves": f"{compact_successes}/8",
+            "operations": compact_operations,
+        },
+    }
+
+    demo_count = enumerate_all(make_instance(seed=3, **DIFFICULTY["demo"]))
+    strongest_name = "random_restart_256"
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_fraction < 1e-6
+        and demo_count == 1
+        and all_failed
+        and reference_successes == 8,
+        "shipping_sample_hits": guess_hits,
+        "shipping_sample_total": guess_total,
+        "shipping_solution_density": guess_fraction,
+        "exact_solution_count": 1,
+        "exact_density": f"1/{search_space(inst)}",
+        "demo_exact_solution_count_by_enumeration": demo_count,
+        "baseline_attack": strongest_name,
+        "baseline_attack_wall_clock_sec": round(attack_seconds[strongest_name] / 8, 6),
+        "baseline_attack_iterations": 256,
+        "reference_wall_clock_sec": reference["wall_clock_sec"],
+        "reference_operation_count": reference["operations"],
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] *= 2
+    start = time.perf_counter()
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_build = time.perf_counter() - start
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    ladder = [DIFFICULTY[name]["n"] for name in DIFFICULTY]
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["expanded_vertices"] > inst["expanded_vertices"]
+        and search_space(doubled) > search_space(inst)
+        and ladder == sorted(ladder)
+        and len(set(ladder)) == len(ladder),
+        "shipping_n": inst["n"],
+        "shipping_expanded_vertices": inst["expanded_vertices"],
+        "doubled_n": doubled["n"],
+        "doubled_expanded_vertices": doubled["expanded_vertices"],
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_why,
+    }
+
+    invariant_count = 0
+    real_transform_count = 0
+    unrelated_keys = []
+    for seed in range(201, 221):
+        original = make_instance(seed=seed, **shipping)
+        key = canonical_key(original)
+        for transformed in _transform_variants(original, seed ^ 0x5A5A):
+            invariant_count += int(key == canonical_key(transformed))
+            real_transform_count += int(verify(transformed, transformed["answer"])[0])
+        unrelated_keys.append(key)
+    distinct_count = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant_count == 60 and real_transform_count == 60 and distinct_count == 20,
+        "invariant_relabellings": invariant_count,
+        "real_transformations_verified": real_transform_count,
+        "unrelated_distinct_keys": distinct_count,
+        "unrelated_attempts": 20,
+        "transformations": [
+            "child-list reordering",
+            "grammar type-ID permutation with carried state rows",
+            "composition of child reordering and type-ID permutation",
+        ],
+    }
+
+    encoded_answer = json.dumps(inst["answer"], separators=(",", ":"))
+    answer_chars = len(encoded_answer)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = len(inst["answer"])
+    worst_chars, worst_tokens = _worst_case_answer_size(shipping)
+    arms = {name: dict(G9_ORACLE_RESULTS[name]) for name in ("bare", "hinted", "placebo")}
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = (
+        worst_chars <= 2_000
+        and answer_elements <= 256
+        and compact_operations <= 300
+        and PROBLEM_PROFILE["max_answer_tokens"] == worst_tokens
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": G9_ORACLE_RESULTS["hinted_verdict"] == "hardened" and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "worst_case_answer_chars": worst_chars,
+        "worst_case_answer_tokens": worst_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": compact_operations,
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(value.get("pass") is True for value in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
