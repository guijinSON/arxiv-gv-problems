   539	}
   540	\caption{The nontrivial color tree $T_c$ is a path on four vertices or six vertices.}
   541	\label{mc23}
   542	\end{center}
   543	\end{figure}
   544	
   545	
   546	\begin{figure}[htbp]
   547	\centering
   548	\includegraphics[width=0.5\textwidth]{1mc.eps}
   549	\caption{$cc_5(G)=13$ and the color forest $F_1$ consists of 3 components.}
   550	\label{mc1}
   551	\end{figure}
   552	
   553	
   554	\begin{figure}[htbp]
   555	\vspace{-2cm}
   556	\centering
   557	\includegraphics[width=1\textwidth]{4mc.eps}
   558	\vspace{-10cm}
   559	\caption{The variable $x_i$ is positive in clause $c_j$ for some $j\in[m]$.}
