+def _assign_occurrence_slots(clauses, q, rng):
+    occurrences = {variable: [] for variable in range(1, q + 1)}
+    for ci, clause in enumerate(clauses):
+        for li, literal in enumerate(clause):
+            occurrences[abs(literal)].append((ci, li))
