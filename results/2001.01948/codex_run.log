import contextlib, importlib, io, json, os
buf=io.StringIO()
with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
    g=importlib.import_module('gen_2001_01948')
assert buf.getvalue()==''
p=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
a=g.make_instance(seed=4242,**p)
b=g.make_instance(seed=4242,**p)
assert {k:v for k,v in a.items() if not k.startswith('_')} == {k:v for k,v in b.items() if not k.startswith('_')}
assert json.loads(json.dumps(a['answer'])) == a['answer']
assert g.verify(a,a['answer']) == (True,'ok')
assert g.parse_answer('prose "'```json'"\\n<answer>'+json.dumps(a['answer'])+'</answer>\\n"'```'"') == a['answer']
base=g.render(a)
os.environ['GV_HINT_MODE']='structural'; hinted=g.render(a)
os.environ['GV_HINT_MODE']='placebo'; placebo=g.render(a)
os.environ.pop('GV_HINT_MODE')
assert g.STRUCTURAL_HINT not in base and g.PLACEBO_HINT not in base
assert hinted.endswith(g.STRUCTURAL_HINT) and placebo.endswith(g.PLACEBO_HINT)
report=json.load(open('selftest_report.json'))
assert report['all_passed']
for path in ['gen_2001_01948.py','README.md','selftest_report.json','llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl']:
    assert os.path.getsize(path)>0, path
print('interface/determinism/deliverables: ok')
print('answer chars/atoms:',report['G9_no_tool_suitability']['answer_chars'],report['G9_no_tool_suitability']['answer_elements'])
print('oracle evidence ready:',report['G9_no_tool_suitability']['oracle_evidence_ready'])
