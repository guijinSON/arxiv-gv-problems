+
+def _coarse_block_attack(inst: dict) -> list[int]:
+    """Guess the unmixed 2x2 construction's complementary matching."""
+    side = inst["width"]
+    total = side * side
+    forced = set(map(tuple, inst["forced"]))
+    chosen = set()
+    matched = set()
+    preferred = []
+    fallback = []
+    for r in range(side):
+        for c in range(side):
+            v = _vid(r, c, side)
+            if c + 1 < side:
+                e = _edge(v, v + 1)
+                (preferred if r % 2 == 0 else fallback).append(e)
+            if r + 1 < side:
+                e = _edge(v, v + side)
