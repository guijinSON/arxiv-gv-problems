+        "drop_one": planted[:-1],
+        "duplicate": [planted[0], planted[0]] + planted[2:],
+        "out_of_range": [inst["height"] * inst["width"]] + planted[1:],
+    }
+    swapped = None
+    for i in range(1, min(len(planted), 20)):
+        trial = planted[:]
+        trial[i], trial[(i + 1) % len(trial)] = trial[(i + 1) % len(trial)], trial[i]
+        ok, why = verify(inst, trial)
