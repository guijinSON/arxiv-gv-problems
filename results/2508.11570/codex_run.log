/bin/bash -lc "python3 - <<'PY'
import random,time
import gen_2508_11570 as g

def matching(inst,rng):
 s=inst['width'];N=s*s;F={g._edge(*e) for e in inst['forced']}
 B=[v for v in range(N) if sum(divmod(v,s))%2==0];rng.shuffle(B)
 O=[[] for _ in range(N)]
 for v in B:
  r,c=divmod(v,s)
  for nr,nc in ((r-1,c),(r,c-1),(r,c+1),(r+1,c)):
   if 0<=nr<s and 0<=nc<s and g._edge(v,nr*s+nc) not in F:O[v].append(nr*s+nc)
  rng.shuffle(O[v])
 W=[-1]*N;seen=[0]*N;st=0
 def aug(v):
  for u in O[v]:
   if seen[u]==st:continue
   seen[u]=st
   if W[u]<0 or aug(W[u]):W[u]=v;return True
  return False
 for v in B:
  st+=1
  if not aug(v):raise RuntimeError
 return {g._edge(u,v) for u,v in enumerate(W) if v>=0}

def comps(edges,N):
 A=g._cycle_adjacency(edges,N);seen=set();k=0
 for x in range(N):
  if x in seen:continue
  k+=1;stack=[x];seen.add(x)
  while stack:
   for y in A[stack.pop()]:
    if y not in seen:seen.add(y);stack.append(y)
 return k

def merge(inst,M,rng):
 s=inst['width'];N=s*s;F={g._edge(*e) for e in inst['forced']}; k=comps(F|M,N); steps=0
 changed=True
 while changed and k>1:
  changed=False;squares=[(r,c) for r in range(s-1) for c in range(s-1)];rng.shuffle(squares)
  for r,c in squares:
   a=r*s+c;b=a+1;d=a+s;e=d+1
   H={g._edge(a,b),g._edge(d,e)};V={g._edge(a,d),g._edge(b,e)}
   if H<=M and not(V&F):old,new=H,V
   elif V<=M and not(H&F):old,new=V,H
   else:continue
   M2=(M-old)|new;k2=comps(F|M2,N)
   if k2<k:M=M2;k=k2;steps+=1;changed=True;break
 return k,steps
for seed in range(3100,3108):
 i=g.make_instance(n=8,seed=seed); solved=0;best=999
 for rr in range(64):
  rng=random.Random(seed*1000+rr);m=matching(i,rng);k,steps=merge(i,m,rng);best=min(best,k);solved+=k==1
 print(seed,'solved',solved,'/64 bestcycles',best)
