r=json.load(open('selftest_report.json'))
print('all',r['all_passed'],'G1',r['G1_planted_verifies']['instances'],'G4',r['G4_guess_resistance']['hits'],r['G4_guess_resistance']['total'])
print('G6',r['G6_adversary_panel']['attacks'])
