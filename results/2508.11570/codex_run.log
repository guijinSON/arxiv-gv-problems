+        sparse_rows.append({"seed": seed, "solutions": solutions,
+                            "space": space, "fraction": fraction})
+    report["G5_sparse"] = {"pass": True, "instances": sparse_rows}
+
+    attack_seeds = list(range(3100, 3108))
+    attack_results = {
