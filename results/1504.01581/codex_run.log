+        columns.append(_poly_to_normal(product, data))
+        # Conservative exact GF(3) scalar-op count for dense polynomial
+        # multiplication/reduction plus the dense coordinate conversion.
+        operations += 6 * n * n
+    matrix = [[columns[column][row] for column in range(n)] for row in range(n)]
+    return matrix, operations
