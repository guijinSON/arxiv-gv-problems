def add(a,b):
 n=max(len(a),len(b)); c=[0]*n
 for i in range(n): c[i]=((a[i] if i<len(a) else 0)+(b[i] if i<len(b) else 0))%3
 while len(c)>1 and c[-1]==0:c.pop()
 return c

def mul(a,b,mod):
 n=len(mod)-1;c=[0]*(len(a)+len(b)-1)
 for i,x in enumerate(a):
  for j,y in enumerate(b): c[i+j]=(c[i+j]+x*y)%3
 for d in range(len(c)-1,n-1,-1):
  x=c[d]
  if x:
   for j in range(n): c[d-n+j]=(c[d-n+j]-x*mod[j])%3
 return c[:n]
def pw(a,e,mod):
 z=[1]
 while e:
  if e&1:z=mul(z,a,mod)
  a=mul(a,a,mod);e//=2
 return z
for n, fh in mods.items():
 mod=list(reversed(fh))
 M=3**n-1; fac=factorint(M)
 for c in range(1,10000):
  a=[];x=c
  for _ in range(n):a.append(x%3);x//=3
  if not a:a=[0]
  if all(pw(a,M//p,mod)"'!=[1]+[0]*(n-1) for p in fac):
   print(n, '"'mod_low',mod,'primitive',a)
   break
 else: print('none',n)
