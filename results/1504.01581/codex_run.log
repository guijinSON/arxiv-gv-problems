+    }
+    attack_seeds = list(range(8100, 8108))
+    for seed in attack_seeds:
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        rng = random.Random(0xA771C + seed)
+        eta, n, h = inst["eta"], inst["n"], inst["h"]
