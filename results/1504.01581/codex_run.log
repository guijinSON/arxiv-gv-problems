+        "wrong_direction_frobenius": _word(_negate(_rotate_right(eta, h))),
+        "off_by_one_shift_ansatz": _word(
+            _negate(_rotate_right(eta, (n - h + 1) % n))
+        ),
+    }
+    found = None
+    for _ in range(256):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
