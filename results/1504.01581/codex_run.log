+    mult_eta, field_ops = _multiplication_matrix_normal(inst["eta"], data)
+    # A maps a0 to eta*a0^(3^h).  Frobenius is a right coordinate shift.
+    operator = [[mult_eta[row][(column + h) % n] for column in range(n)]
+                for row in range(n)]
