+def _trace_gram(data):
+    n = len(data["theta"])
+    first = []
+    for conjugate in data["basis"]:
+        product = _gf_mul(data["theta"], conjugate, data["modulus"])
+        coords = _poly_to_normal(product, data)
+        first.append(data["trace_theta"] * sum(coords) % 3)
+    return [[first[(j - i) % n] for j in range(n)] for i in range(n)]
