from sympy.polys.galoistools import gf_irreducible
from sympy.polys.domains import ZZ
import random
exec(open('/tmp/find_primitive.py').read().split('for n, fh in mods.items():')[0])

def rank(rows):
 rows=[r[:] for r in rows];m=len(rows);n=len(rows[0]);rr=0
 for c in range(n):
  p=next((i for i in range(rr,m) if rows[i][c]),None)
  if p is None:continue
  rows[rr],rows[p]=rows[p],rows[rr]
  if rows[rr][c]==2:rows[rr]=[(2*x)%3 for x in rows[rr]]
  for i in range(rr+1,m):
   if rows[i][c]:
    a=rows[i][c]; rows[i]=[(x-a*y)%3 for x,y in zip(rows[i],rows[rr])]
  rr+=1
  if rr==m:break
 return rr
for n in [128,160,192]:
 fh=gf_irreducible(n,3,ZZ);mod=list(reversed(fh));print('MOD',n,mod,flush=True)
 rng=random.Random(n)
 for trial in range(30):
  a=[rng.randrange(3) for _ in range(n)]
  rows=[];b=a
  for i in range(n):
   rows.append(b);b=pw(b,3,mod)
  rr=rank(rows)
  print('try',n,trial,rr,flush=True)
  if rr==n:
   print('THETA',n,a,flush=True);break
