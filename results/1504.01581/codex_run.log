# hardcoded primitive candidates from prior run; low-order coeff arrays
prims={5:[1,1],48:[1,1],80:[0,1],96:[2,0,1],120:[0,1]}

def rank(rows):
 rows=[r[:] for r in rows];m=len(rows);n=len(rows[0]);rr=0
 for c in range(n):
  p=next((i for i in range(rr,m) if rows[i][c]),None)
  if p is None:continue
  rows[rr],rows[p]=rows[p],rows[rr]
  if rows[rr][c]==2:rows[rr]=[(2*x)%3 for x in rows[rr]]
  for i in range(m):
   if i"'!=rr and rows[i][c]:
    a=rows[i][c]; rows[i]=[(x-a*y)%3 for x,y in zip(rows[i],rows[rr])]
  rr+=1
  if rr==m:break
 return rr
for n in [5,48,80,96,120]:
 mod=list(reversed(mods[n]));g=prims[n]+[0]*(n-len(prims[n]));M=3**n-1
 for e in range(1,1000):
  a=pw(g,e,mod); rows=[];b=a
  for i in range(n):
   rows.append(b); b=pw(b,3,mod)
  if rank(rows)==n:
   print(n,'"'normal_exp',e,'theta_poly',a)
   break
 else:print('none',n)
