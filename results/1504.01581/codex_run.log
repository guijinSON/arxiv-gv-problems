+        answer_coords = _expected_dual_twist(provisional)
+        guesses = [
+            eta,
+            _negate(eta),
+            _negate(_rotate_right(eta, h)),
+            _negate(_rotate_right(eta, (n - h + 1) % n)),
+        ]
