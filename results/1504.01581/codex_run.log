+# Coefficients are low degree first.  Each modulus is irreducible over GF(3),
+# and theta is a checked normal element: (theta, theta^3, ..., theta^(3^(n-1)))
+# is a basis.  These constants only define finite-field coordinates.
+_FIELD_STRINGS = {
+    5: (
