+        "invariance_checks": invariance_checks,
+        "invariance_failures": key_failures,
+        "carried_witness_checks": carried_checks,
+        "unrelated_instances": 20,
+        "distinct_keys": distinct_keys,
+        "symmetries_tested": [
+            "one-step normal-basis Frobenius reindexing",
+            "seed-dependent cyclic reindexing",
+            "composition implicit in arbitrary cyclic shifts",
+        ],
+    }
+
+    answer_chars, answer_tokens = _json_answer_size(shipping["answer"])
+    arms = {name: dict(G9_ORACLE_RESULTS[name])
