+    transformed["normal_element"] = list(theta_prime)
+    transformed["eta"] = _rotate_left(inst["eta"], shift)
+    transformed["answer"] = _rotate_left(list(inst["answer"]), shift)
+    transformed["answer"] = "".join(transformed["answer"])
+    return transformed
