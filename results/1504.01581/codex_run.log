+@functools.lru_cache(maxsize=None)
+def _field_data(n):
+    if n not in _FIELD_STRINGS:
+        raise ValueError("unsupported extension degree; use a declared preset")
+    modulus_word, theta_word = _FIELD_STRINGS[n]
