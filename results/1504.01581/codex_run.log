+        old_basis = _basis_from_normal_element(
+            inst["normal_element"], inst["field_modulus"]
+        )
+        transformed = dict(inst)
+        transformed["normal_element"] = _coords_to_poly(coordinates, old_basis)
+        transformed["eta"] = _matvec(inverse, inst["eta"])
