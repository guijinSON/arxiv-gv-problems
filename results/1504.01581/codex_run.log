+
+def canonical_key(inst):
+    eta = tuple(inst["eta"])
+    rotations = [tuple(_rotate_left(eta, shift)) for shift in range(inst["n"])]
+    canonical_eta = min(rotations)
+    payload = json.dumps(
+        [inst["q"], inst["n"], inst["k"], inst["h"], canonical_eta],
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params):
+    n = int(params["n"])
+    if n == 48:
+        return dict(DIFFICULTY["medium"])
+    if n == 64:
+        return dict(DIFFICULTY["hard"])
+    if n == 80:
