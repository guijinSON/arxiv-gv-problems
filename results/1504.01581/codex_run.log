+    if len(answer) < n:
+        return False, f"answer is too short: expected {n} digits"
+    if len(answer) > n:
+        return False, f"answer is too long: expected {n} digits"
+    if any(ch not in "012" for ch in answer):
+        return False, "answer contains a non-ternary digit"
