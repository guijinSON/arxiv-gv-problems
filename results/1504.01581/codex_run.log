+                         flags=re.IGNORECASE | re.DOTALL)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    fence = re.fullmatch(r"```(?:text|txt)?\s*(.*?)\s*```", body,
+                         flags=re.IGNORECASE | re.DOTALL)
+    if fence:
