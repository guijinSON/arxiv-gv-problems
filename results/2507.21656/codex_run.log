+def _scaled_instance(inst: dict, scalar: int) -> dict:
+    p = inst["prime"]
+    transformed = dict(inst)
+    transformed["matrix"] = [(scalar * x) % p for x in inst["matrix"]]
+    transformed.pop("answer", None)
+    return transformed
