+        "swap_endpoint_order": [[planted[0][1], planted[0][0]]] + planted[1:],
+        "duplicate_pair": [planted[0], planted[0]] + planted[2:],
+        "empty": [],
+        "out_of_range": planted[:-1] + [[planted[-1][0], shipping["prime"] + 1]],
+    }
