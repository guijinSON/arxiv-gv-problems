        "every nonempty index subset has the required shape."
    ),
    "bounds": {
        "min_items": 1,
        "max_items_parameter": "n",
        "max_n": 384,
        "index_min": 0,
        "index_max_parameter": "n-1",
        "repetitions": 0,
    },
}


