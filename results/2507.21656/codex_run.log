import random,time,statistics

def interval_coloring(N):
    colors=[-1]*(N+1)
    lo=1;c=0
    while lo<=N:
        hi=(3*lo+1)//2   # ceil(3lo/2), next band starts here
        for x in range(lo,min(hi,N+1)): colors[x]=c
        lo=hi;c+=1
    return colors,c

def planted(N,seed):
    colors,nc=interval_coloring(N)
    rng=random.Random(seed)
    choices=[]
    for a in range(2,2*N//3+1,2):
        b=3*a//2
        if b<=N and colors[a]"'!=colors[b]: choices.append((a,b))
    a,b=rng.choice(choices)
    colors[b]=colors[a]
    return colors,(a,a,a,b,b),nc

def ratio_attack(colors):
    N=len(colors)-1; ops=0
    for a in range(2,2*N//3+1,2):
        b=3*a//2; ops+=1
        if colors[a]==colors[b]: return (a,a,a,b,b),ops
    return None,ops

for N in (256,4096,16384,65536):
    times=[]; op=[]
    for seed in range(100):
        col,ans,nc=planted(N,seed)
        t=time.perf_counter(); got,o=ratio_attack(col); times.append(time.perf_counter()-t);op.append(o)
        assert 3*got[0]==2*got[3]
    print(N,nc,min(op),round(statistics.median(op),1),max(op),f'"'{statistics.median(times):.8f}',f'{max(times):.8f}')
