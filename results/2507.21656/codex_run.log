+        "shipping_exact_solution_fraction": exact_fraction,
+        "baseline_wall_clock_sec": round(reference_wall, 6),
+        "baseline_operation_count": reference_operations,
+        "baseline_levels_scanned": shipping["prime"] + 1,
+    }
+
+    attack_names = [
