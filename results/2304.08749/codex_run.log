+# Filled from the script-owned oracle runs after hardening.  These defaults are
+# deliberately not presented as fresh evidence by NOTES or README.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
