+    "easy": {"n": 58, "k": 6, "min_q": 10**6, "terms": 4},
+    "medium": {"n": 126, "k": 6, "min_q": 10**8, "terms": 4},
+    "hard": {"n": 250, "k": 6, "min_q": 10**12, "terms": 4},
+}
