We shall now give  Sieve variation of Theorem \ref{main thm} proof of which is omitted as it follows from Lemma \ref{l1pi}, Lemma \ref{l1pi-l1} and the idea of \cite{a.gupta cohen 2018}.
\begin{theorem}{\label{seive}}
    Assume the notations and conditions in Lemma \ref{l1pi-l1}. Let $\delta = 1- \sum_{i=1}^{u} \frac{1}{p_i} -\sum_{i=1}^{v} \frac{1}{q_i} - \sum_{i=1}^{s} \frac{1}{q^{deg(P_i)}} - \sum_{i=1}^{t} \frac{1}{q^{deg(Q_i)}} >0 $ and $\Delta = \frac{u+v+s+t-1}{\delta} +2$. If 
    $$q^{\frac{n}{2}-k_1 -k_2 -2}> Mr_1 r_2 \Delta W(l_1)W(l_2)W(\Tilde{g}_1)W(\Tilde{g}_2),$$
    then $(q,n)\in A_{F,a,b}(r_1,r_2,k_1,k_2) $.
    %$C_{F,a,b}(\frac{q^n -1}{r_1}, %\frac{q^n -1}{r_2}, x^n -1)>0.$
\end{theorem}
