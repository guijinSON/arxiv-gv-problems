+        for exponent in needed_indices
+    )
+    inverse_coeff_operations = inst["terms"] - 1
+    convolution_operations = (
+        (2 * inst["terms"] - 1) * (inst["k"] + 1)
+    )
+    intended_operations = (powering_operations + inverse_coeff_operations
+                           + convolution_operations)
+    arms = {
