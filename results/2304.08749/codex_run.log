+        "empty": {"coefficients": [], "roots": []},
+        "out_of_range": {"coefficients": list(answer["coefficients"]),
+                         "roots": list(answer["roots"][:-1]) + [inst["n"]]},
+    }
+    rejections = {}
+    for name, bad in corruptions.items():
