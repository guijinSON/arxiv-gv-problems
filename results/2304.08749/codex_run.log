+        "real_transformation_verify_checks": real_transform_checks,
+        "distinct_unrelated_keys": len(unrelated_keys),
+        "unrelated_instances": 20,
+        "symmetries": ["simultaneous Frobenius", "common nonzero F_q scaling",
