    Let $\alpha$ and $\beta$ are positive real numbers, we define $A_\alpha$ and $A_{\alpha,\beta}$ as follows:
    $$  A_\alpha = \prod\limits_{\substack{p<2^\alpha\\  p \text{ is prime}}}\frac{2}{\sqrt[\alpha]{p}}\;\;\; \text{and}\;\;\; 
    A_{\alpha,\beta} = \prod\limits_{\substack{p<2^\alpha\\  p \text{ is prime}}}\frac{2}{\sqrt[\alpha+\beta]{p}}.
    $$
    
Following two  Lemmas, Lemma \ref{2n-k1-k2} and \ref{uv} follow from \cite{neumann}.
\begin{lemma}{\label{2n-k1-k2}}
    Suppose $r_1$ and $r_2$ are divisors positive of $q^n -1$, $k_1+k_2 +2 < n/2$ is such that there exist factors $f_1$ and $f_2$ of $x^n -1$ of degrees $k_1 $ and $ k_2$, respectively in $\mathbb{F}_{q}[x]$. Let $(2n-k_1 -k_2)^2 < q$. 
    If $q^{\frac{n}{2} - k_1 -k_2 -2} > Mr_1r_2(2n-k_1-k_2+2)W(\frac{q^n -1}{r_1}) W(\frac{q^n -1}{r_2})$, then $(q,n)\in A_{F,a,b}(r_1,r_2,k_1,k_2) $.
    %there exists an element $\epsilon \in \mathbb{F}_{q^n} $ such that $\epsilon$ is $r_1$- primitive, $k_1$- normal and $F(\epsilon)$ is $r_2$- primitive, $k_2$ -normal in $\mathbb{F}_{q^n}$ with $\operatorname{Tr}_{\mathbb{F}_{q^n}/\mathbb{F}_q}(\epsilon)=a$ and $\operatorname{Tr}_{\mathbb{F}_{q^n}/\mathbb{F}_q}(\epsilon^{-1})=b$, for $a,b \in \mathbb{F}_{q}$.
\end{lemma}

%\begin{proof}
 %   Let $f_1 , f_2$ be factors of $x^n -1$ of degrees $k_1, k_2$ respectively. We will be using seiving variation with $l_i = \frac{q^n -1}{r_i}$ and $g_i$ are divisors of $x^n -1$ such that $\gcd(g_i, \frac{x^n -1}{f_i}) =1$ and any irreducible facotr of $x^n -1$ divides $g_i$ or $\frac{x^n -1}{f_i}$ for $i=1,2$. Let $P_1 , P_2,\dots,P_s$ and $Q_1, Q_2, \dots , Q_t$ be all irreducible polynomials such that $rad(\frac{x^n -1}{f_1}) = P_1\cdot P_2\cdots  P_s$ and $rad(\frac{x^n -1}{f_2}) = Q_1 \cdot Q_2\cdots Q_t$ respectively. Then $\delta = 1- \sum_{i=1}^s \frac{1}{q^{deg P_i}}+ \sum_{i=1}^t \frac{1}{q^{deg Q_i}} \geq 1- \frac{2n-k_1-k_2}{q} \geq \frac{2n-k_1-k_2 -1}{2n-k_1-k_2}>0$. And we have $\Delta = \frac{s+t-1}{\delta} +2 \leq 2n-k_1 -k_2 +2$. Hence, result follows from seiving variation.
%\end{proof}



\begin{lemma}\label{uv}
         Let $r_1$ and $r_2$ are positive divisors of $q^n -1$, $k_1+k_2+2 < n/2$ is such that there exist factors $f_1 $ and $ f_2$ of $x^n -1$ of degrees $k_1 $ and $ k_2$, respectively in $\mathbb{F}_{q}[x]$. Suppose $\alpha > 0 $ be such that $\alpha > \frac{4n}{n-2(k_1 + k_2 +2)}$, and let $d =\frac{2\alpha}{\alpha(n-2(k_1 +k_2 +2))-4n}$. If 
         $$q\geq \min \{ \mathcal{U}, max \{ \mathcal{V}, (2n-k_1 -k_2)^2 \}  \},$$
         then, $(q,n)\in A_{F,a,b}(r_1,r_2,k_1,k_2) $,
         where $\mathcal{U}= (M(r_1r_2)^{1-\frac{1}{\alpha}}2^{2n-k_1-k_2}A_{\alpha}^2)^d$ and $\mathcal{V}= (M(r_1r_2)^{1-\frac{1}{\alpha}}(2n-k_1-k_2+2)A_{\alpha}^2)^d$.
\end{lemma}

