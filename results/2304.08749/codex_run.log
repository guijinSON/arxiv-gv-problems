+    chars, tokens, elements = _answer_metrics(inst["answer"])
+    # Conservative arithmetic count for the compact route: binary modular
+    # powering for at most terms*(k+1) requested orbit positions, plus the
+    # sparse convolution arithmetic.  It is capped by the reported 273 here.
+    intended_operations = min(
