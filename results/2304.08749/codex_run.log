+                              frobenius_power)
+    epsilon = _frobenius_coords(inst["epsilon"], inst["d"], inst["ell"],
+                                frobenius_power)
+    moved["sigma"] = _scale_coords(sigma, scalar, inst["q"])
+    moved["epsilon"] = _scale_coords(epsilon, scalar, inst["q"])
+    moved["answer"] = inst["answer"]
