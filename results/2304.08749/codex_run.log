+def _candidate_from_roots(inst: dict, roots: list[int]) -> dict:
+    roots = sorted(roots)
+    return {
+        "coefficients": _poly_from_roots(
+            roots, inst["omega"], inst["q"]),
+        "roots": roots,
+    }
