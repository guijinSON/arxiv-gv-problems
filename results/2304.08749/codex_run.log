+def _frobenius_coords(values: list[int], d: int, ell: int,
+                       power: int) -> list[int]:
+    n = ell - 1
+    multiplier = pow(d, power % n, ell)
+    out = [0] * n
+    for j, value in enumerate(values, 1):
+        out[(j * multiplier % ell) - 1] = value
+    return out
