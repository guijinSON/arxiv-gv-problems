+    "The displayed exact coefficients reward careful bookkeeping of all the "
+    "variable indices."
+)
+
+
+# Populated after the three authoritative harden.py runs.  These fields are
+# diagnostic only; G9(c)'s size and effort caps are the part that gates.
+G9_EVIDENCE = {
+    "bare": {"solved": None, "attempts": 3},
+    "hinted": {"solved": None, "attempts": 3},
+    "placebo": {"solved": None, "attempts": 3},
+    "hinted_verdict": "pending",
+}
+
+
+NOTES = r"""
+Definition 1 fixes the target object: n homogeneous polynomials in n variables
+have zero resultant exactly when they have a nonzero common root over the
+algebraic closure.  Section 2.2, Theorem 1 fixes the family used here: the
+quadratics x_0^2-x_i^2 plus one weighted linear equation encode Partition and
+remain NP-hard over the integers, even with degree and coefficients bounded by
+2 after the paper's auxiliary-variable construction.
+
+The same section also states an important easy regime: two dense bivariate
+polynomials have a polynomial-size Sylvester matrix.  The introduction notes
+that the finite-field analogue of the Partition reduction is polynomial by
+dynamic programming.  More importantly for this generator, its own integer
+weights are polynomially bounded values of a fixed-degree polynomial, so the
+pseudopolynomial subset-sum dynamic program is polynomial on this distribution.
+That algorithm produces a root certificate mechanically; this is therefore an
+honest Track-B family, not a distributional Track-A claim.
+
+For n=2^m, put epsilon_i=(-1)^popcount(i).  The exponential generating
+function sum_i epsilon_i exp(i*t) factors as product_{j=0}^{m-1}
+(1-exp(2^j*t)), which has a zero of order m at t=0.  Consequently
+sum_i epsilon_i*i^d=0 for every d<m.  Generation samples a positive polynomial
+q of degree d<m, sets the effective weights to q(0),...,q(n-1), and then uses
+an invertible diagonal variable change y_i=r_i*x_i.  The carried root is
+x_0=1 and x_i=epsilon_rank/r_i.  Variable labels, equation order, scale factors,
+and linear-form order are randomised only after this exact certificate exists.
+
+The outlier attack splits the ordered weights by magnitude; the greedy attack
+balances the currently lighter side; random restart samples fully well-formed
+rational roots; alternating and period-four signs test the obvious short-period
+ansatz.  All fail because quartic cancellation needs at least five active binary
+digits.  The domain-standard dynamic program is deliberately not in the failing
+attack panel: Track B expects it to solve, and reports its measured work as the
+reference algorithm.  The canonical key normalises the multiset of effective
+weights; it is invariant under variable relabelling and equation/term reordering,
+but it does not quotient by arbitrary rational changes of basis.
+""".strip()
+
+
+def _plain_int(value: object) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _is_power_of_two(value: int) -> bool:
+    return value > 0 and value & (value - 1) == 0
+
+
+def _poly_value(coefficients: list[int], x: int) -> int:
+    value = 0
+    for coefficient in reversed(coefficients):
+        value = value * x + coefficient
+    return value
+
+
+def _rational_to_json(numerator: int, denominator: int) -> list[int]:
+    if rationals is not None:
+        return rationals.to_json([numerator, denominator])
+    common = math.gcd(numerator, denominator)
+    numerator //= common
+    denominator //= common
+    if denominator < 0:
+        numerator, denominator = -numerator, -denominator
+    return [numerator, denominator]
+
+
+def _rational_vector_from_json(answer: object):
+    if rationals is not None:
+        return rationals.vector_from_json(answer)
+    from fractions import Fraction
+
+    if not isinstance(answer, list):
+        raise TypeError("expected a list of rational pairs")
+    values = []
+    for pair in answer:
+        if (
+            not isinstance(pair, list)
+            or len(pair) != 2
+            or not all(_plain_int(entry) for entry in pair)
+            or pair[1] == 0
+        ):
+            raise ValueError("each rational must be [integer, nonzero integer]")
+        values.append(Fraction(pair[0], pair[1]))
+    return values
+
+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    degree: int = 4,
+    coefficient_bound: int = 99,
+    scale_bound: int = 31,
+    scramble_terms: bool = True,
+    **params,
+) -> dict:
+    """Build a square homogeneous system and carry its root by construction."""
+
+    if params:
+        raise ValueError("unknown parameters: " + ", ".join(sorted(params)))
+    if not _plain_int(n) or n < 8 or not _is_power_of_two(n):
+        raise ValueError("n must be a power of two at least 8")
+    moment_order = n.bit_length() - 1
+    if (
+        not _plain_int(degree)
+        or degree < 1
+        or degree >= moment_order
+    ):
+        raise ValueError("degree must satisfy 1 <= degree < log2(n)")
+    if not _plain_int(coefficient_bound) or coefficient_bound < 3:
+        raise ValueError("coefficient_bound must be an integer at least 3")
+    if not _plain_int(scale_bound) or scale_bound < 2:
+        raise ValueError("scale_bound must be an integer at least 2")
+    if not isinstance(scramble_terms, bool):
+        raise ValueError("scramble_terms must be boolean")
+
+    rng = random.Random(seed)
+    lower = max(1, coefficient_bound // 2)
+    # A monic leading term controls bit growth while the lower coefficients
+    # provide many canonical non-isomorphic instances.
+    generating_coefficients = [
+        rng.randint(lower, coefficient_bound) for _ in range(degree)
+    ] + [1]
+    ordered_effective_weights = [
+        _poly_value(generating_coefficients, rank) for rank in range(n)
+    ]
+    if any(
+        ordered_effective_weights[i] >= ordered_effective_weights[i + 1]
+        for i in range(n - 1)
+    ):
+        raise AssertionError("positive polynomial coefficients must be increasing")
+
+    rank_to_variable = list(range(n))
+    rng.shuffle(rank_to_variable)
+    scales = [0] * n
+    effective_weights = [0] * n
+    signs = [0] * n
+    for rank, variable in enumerate(rank_to_variable):
+        scale = rng.randint(2, scale_bound)
+        scales[variable] = scale
+        effective_weights[variable] = ordered_effective_weights[rank]
+        signs[variable] = 1 if rank.bit_count() % 2 == 0 else -1
+
+    linear_coefficients = [
+        effective_weights[i] * scales[i] for i in range(n)
+    ]
+    quadratic_order = list(range(n))
+    rng.shuffle(quadratic_order)
+    linear_order = list(range(n))
+    if scramble_terms:
+        rng.shuffle(linear_order)
+    else:
+        linear_order.sort(key=lambda i: effective_weights[i])
+
+    answer = [[1, 1]] + [
+        _rational_to_json(signs[i], scales[i]) for i in range(n)
+    ]
+    return {
+        "paper": "arXiv:1210.1451",
+        "family": "diagonally transformed Theorem-1 resultant system",
+        "n": n,
+        "n_variables": n + 1,
+        "n_polynomials": n + 1,
+        "degree": degree,
+        "coefficient_bound": coefficient_bound,
+        "scale_bound": scale_bound,
+        "scramble_terms": scramble_terms,
+        "scales": scales,
+        "linear_coefficients": linear_coefficients,
+        "quadratic_order": quadratic_order,
+        "linear_order": linear_order,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render the complete exact common-root problem seen by a solver."""
+
+    n = inst["n"]
+    lines = [
+        "Find a normalized rational common root of a square homogeneous polynomial system.",
+        "",
+        "Definitions.",
+        "A polynomial is homogeneous when every monomial in it has the same total degree.",
+        "A common root makes every displayed polynomial exactly zero. A projective root is nonzero and is unchanged by multiplying all coordinates by the same nonzero scalar.",
+        f"This instance has {n + 1} variables x0,x1,...,x{n} and {n + 1} homogeneous polynomials over the rationals.",
+        "Your witness must use the normalization x0=1, so it is an ordinary rational vector rather than a projective equivalence class.",
+        "",
+        "Quadratic polynomials (their printed order has no mathematical significance):",
+    ]
+    for variable in inst["quadratic_order"]:
+        scale = inst["scales"][variable]
+        lines.append(
+            f"Q{variable + 1}: x0^2 - {scale * scale}*x{variable + 1}^2 = 0"
+        )
+
+    terms = [
+        f"{inst['linear_coefficients'][variable]}*x{variable + 1}"
+        for variable in inst["linear_order"]
+    ]
+    lines.extend(
+        [
+            "",
+            "The final homogeneous linear polynomial is:",
+            "L: " + " + ".join(terms) + " = 0",
+            "",
+            f"Return exactly {n + 1} rationals in variable order x0,x1,...,x{n}.",
+            "Write each rational in lowest terms as num/den with a positive denominator; order matters and repeated coordinate values are allowed.",
+            "All equalities are exact: decimal approximations are not accepted.",
+            "Give your final answer inside <answer></answer> tags, as a comma-separated rational vector.",
+            "Example syntax: <answer>1/1, -1/2, 1/3</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: object) -> object | None:
+    """Parse a tagged rational vector, tolerating prose and Markdown fences."""
+
+    if not isinstance(text, str):
+        return None
+    try:
+        match = re.search(
+            r"<answer>(.*?)</answer>", text, flags=re.IGNORECASE | re.DOTALL
+        )
+        if match is None:
+            return None
+        body = match.group(1).strip()
+        body = re.sub(r"^```(?:json|text|python)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body).strip()
+        if not body:
+            return []
+
+        if body.startswith("["):
+            raw = json.loads(body)
+            values = _rational_vector_from_json(raw)
+            return [
+                _rational_to_json(value.numerator, value.denominator)
+                for value in values
+            ]
+
+        tokens = [token.strip() for token in body.split(",")]
+        if not tokens or any(not token for token in tokens):
+            return None
+        output = []
+        for token in tokens:
+            if rationals is not None:
+                value = rationals.parse_rational(token)
+            else:
+                from fractions import Fraction
+
+                if re.fullmatch(r"[+-]?\d+\s*/\s*[+-]?\d+", token):
+                    numerator, denominator = token.replace(" ", "").split("/")
+                    if int(denominator) == 0:
+                        return None
+                    value = Fraction(int(numerator), int(denominator))
+                else:
+                    value = None
+            if value is None:
+                return None
+            output.append(_rational_to_json(value.numerator, value.denominator))
+        return output
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any normalized rational common root by exact substitution."""
+
+    n = inst["n"]
+    if not isinstance(answer, list):
+        return False, "malformed answer: expected a list of rational pairs"
+    if not answer:
+        return False, "empty answer: expected a normalized rational vector"
+    if len(answer) < n + 1:
+        return False, f"too short: expected {n + 1} coordinates, got {len(answer)}"
+    if len(answer) > n + 1:
+        return False, f"too long: expected {n + 1} coordinates, got {len(answer)}"
+    try:
+        values = _rational_vector_from_json(answer)
+    except (TypeError, ValueError, ZeroDivisionError) as exc:
+        return False, "malformed rational coordinate: " + str(exc)
+
+    if values[0] != 1:
+        return False, "normalization failed: x0 must equal exactly 1"
+    x0_squared = values[0] * values[0]
+    for variable, scale in enumerate(inst["scales"]):
+        coordinate = values[variable + 1]
+        if abs(coordinate) > 1:
+            return False, f"out of range: x{variable + 1} has absolute value above 1"
+        residual = x0_squared - scale * scale * coordinate * coordinate
+        if residual != 0:
+            return False, f"quadratic Q{variable + 1} has nonzero residual {residual}"
+
+    linear_residual = sum(
+        coefficient * values[variable + 1]
+        for variable, coefficient in enumerate(inst["linear_coefficients"])
+    )
+    if linear_residual != 0:
+        return False, f"linear polynomial L has nonzero residual {linear_residual}"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from every immediately feasible quadratic-root choice."""
+
+    return [[1, 1]] + [
+        [-1 if rng.getrandbits(1) else 1, scale]
+        for scale in inst["scales"]
+    ]
+
+
+def search_space(inst: dict) -> int | None:
+    """Return the exact cardinality of the bounded rational witness language."""
+
+    return 1 << inst["n"]
+
+
+def _effective_weights(inst: dict) -> list[int]:
+    weights = []
+    for coefficient, scale in zip(
+        inst["linear_coefficients"], inst["scales"]
+    ):
+        if coefficient % scale:
+            raise ValueError("linear coefficient is not divisible by its scale")
+        weights.append(coefficient // scale)
+    return weights
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count all normalized roots exactly by capped meet-in-the-middle search."""
+
+    n = inst["n"]
+    if n > 36:
+        return None
+    weights = _effective_weights(inst)
+    split = n // 2
+
+    left_sums = [0]
+    for weight in weights[:split]:
+        left_sums += [subtotal + weight for subtotal in left_sums]
+    right_sums = [0]
+    for weight in weights[split:]:
+        right_sums += [subtotal + weight for subtotal in right_sums]
+    right_counts = Counter(right_sums)
+    target, parity = divmod(sum(weights), 2)
+    if parity:
+        return 0
+    return sum(right_counts.get(target - subtotal, 0) for subtotal in left_sums)
+
+
+def canonical_key(inst: dict) -> str:
+    """Hash a relabelling-invariant normalized multiset of effective weights."""
+
+    weights = sorted(_effective_weights(inst))
+    common = 0
+    for weight in weights:
+        common = math.gcd(common, weight)
+    normalised = [weight // common for weight in weights]
+    payload = json.dumps(
+        {"family": "theorem1_diagonal", "weights": normalised},
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Increase mechanical work, preferring fixed answer length after n=32."""
+
+    harder = {key: value for key, value in params.items() if key != "_preset"}
+    if harder["n"] < 32:
+        harder["n"] *= 2
+        harder["degree"] = min(
+            harder["degree"] + 1, harder["n"].bit_length() - 2
+        )
+        harder["scramble_terms"] = True
+        return harder
+
+    # These dials increase exact DP bit width and obscure the diagonal change
+    # while leaving the rational vector at the same 2*(n+1) atomic elements.
+    harder["coefficient_bound"] *= 4
+    harder["scale_bound"] *= 2
+    harder["scramble_terms"] = True
+    if harder["coefficient_bound"] > 10**9:
+        return None
+    return harder
+
+
+def _answer_from_signs(inst: dict, signs: list[int]) -> list[list[int]]:
+    return [[1, 1]] + [
+        _rational_to_json(sign, scale)
+        for sign, scale in zip(signs, inst["scales"])
+    ]
+
+
+def _attack_outlier_magnitude(inst: dict) -> object:
+    weights = _effective_weights(inst)
+    order = sorted(range(inst["n"]), key=lambda i: weights[i])
+    signs = [-1] * inst["n"]
+    for variable in order[inst["n"] // 2 :]:
+        signs[variable] = 1
+    return _answer_from_signs(inst, signs)
+
+
+def _attack_greedy_largest_first(inst: dict) -> object:
+    weights = _effective_weights(inst)
+    plus_total = 0
+    minus_total = 0
+    signs = [0] * inst["n"]
+    for variable in sorted(range(inst["n"]), key=lambda i: -weights[i]):
+        if plus_total <= minus_total:
+            signs[variable] = 1
+            plus_total += weights[variable]
+        else:
+            signs[variable] = -1
+            minus_total += weights[variable]
+    return _answer_from_signs(inst, signs)
+
+
+def _attack_rank_pattern(inst: dict, period: int) -> object:
+    weights = _effective_weights(inst)
+    order = sorted(range(inst["n"]), key=lambda i: weights[i])
+    signs = [0] * inst["n"]
+    for rank, variable in enumerate(order):
+        if period == 2:
+            signs[variable] = 1 if rank % 2 == 0 else -1
+        else:
+            signs[variable] = 1 if rank % 4 in (0, 3) else -1
+    return _answer_from_signs(inst, signs)
+
+
+def _attack_random_restart(
+    inst: dict, rng: random.Random, restarts: int
+) -> tuple[object, int]:
+    candidate = random_candidate(inst, rng)
+    for attempt in range(1, restarts + 1):
+        if attempt > 1:
+            candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate, attempt
+    return candidate, restarts
+
+
+def _reference_subset_sum(inst: dict) -> tuple[object | None, dict]:
+    """Exact bitset DP with predecessor rows, followed by witness recovery."""
+
+    weights = _effective_weights(inst)
+    total = sum(weights)
+    if total % 2:
+        return None, {
+            "target": None,
+            "scalar_state_updates": 0,
+            "bitset_word_updates": 0,
+        }
+    target = total // 2
+    mask = (1 << (target + 1)) - 1
+    reachable = 1
+    before = []
+    for weight in weights:
+        before.append(reachable)
+        reachable = (reachable | (reachable << weight)) & mask
+    stats = {
+        "target": target,
+        "scalar_state_updates": len(weights) * (target + 1),
+        "bitset_word_updates": len(weights) * ((target + 64) // 64),
+    }
+    if not ((reachable >> target) & 1):
+        return None, stats
+
+    chosen = [False] * len(weights)
+    remainder = target
+    for index in range(len(weights) - 1, -1, -1):
+        if (before[index] >> remainder) & 1:
+            continue
+        chosen[index] = True
+        remainder -= weights[index]
+    if remainder != 0:
+        return None, stats
+    signs = [1 if selected else -1 for selected in chosen]
+    return _answer_from_signs(inst, signs), stats
+
+
+def _answer_text(answer: list[list[int]]) -> str:
+    return ", ".join(f"{numerator}/{denominator}" for numerator, denominator in answer)
+
+
+def _atomic_elements(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_atomic_elements(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_atomic_elements(item) for item in value)
+    return 1
+
+
+def _relabel_instance(
+    inst: dict, permutation: list[int], reverse_orders: bool
+) -> tuple[dict, object]:
+    """Relabel x_1,...,x_n and carry the rational root through the map."""
+
+    n = inst["n"]
+    transformed = dict(inst)
+    scales = [0] * n
+    coefficients = [0] * n
+    carried = [None] * (n + 1)
+    carried[0] = list(inst["answer"][0])
+    for old, new in enumerate(permutation):
+        scales[new] = inst["scales"][old]
+        coefficients[new] = inst["linear_coefficients"][old]
+        carried[new + 1] = list(inst["answer"][old + 1])
+    transformed["scales"] = scales
+    transformed["linear_coefficients"] = coefficients
+    transformed["quadratic_order"] = [
+        permutation[old] for old in inst["quadratic_order"]
+    ]
+    transformed["linear_order"] = [
+        permutation[old] for old in inst["linear_order"]
+    ]
+    if reverse_orders:
+        transformed["quadratic_order"].reverse()
+        transformed["linear_order"].reverse()
+    transformed["answer"] = carried
+    return transformed, carried
+
+
+def selftest() -> dict:
+    """Run every mandatory correctness, resistance, scale, and format gate."""
+
+    report: dict = {
+        "paper": "arXiv:1210.1451",
+        "family": "Prouhet-certified square homogeneous resultant systems",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    # G1: all presets, several seeds, exact verification and JSON round-trip.
+    g1_failures = []
+    g1_checks = 0
+    for preset, parameters in DIFFICULTY.items():
+        for seed in range(4):
+            inst = make_instance(seed=seed, **parameters)
+            ok, reason = verify(inst, inst["answer"])
+            json_native = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            g1_checks += 1
+            if not ok or not json_native:
+                g1_failures.append(
+                    {
+                        "preset": preset,
+                        "seed": seed,
+                        "verify": reason,
+                        "json_native": json_native,
+                    }
+                )
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "checks": g1_checks,
+        "failures": g1_failures,
+    }
+
+    shipping = make_instance(seed=12345, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = shipping["answer"]
+
+    # G2: five qualitatively different corruptions and five distinct reasons.
+    drop_one = [list(pair) for pair in planted[:-1]]
+    duplicate = [list(pair) for pair in planted] + [list(planted[-1])]
+    out_of_range = [list(pair) for pair in planted]
+    out_of_range[1] = [2, 1]
+    swap_two = [list(pair) for pair in planted]
+    pair_to_swap = None
+    for i in range(1, len(planted)):
+        for j in range(i + 1, len(planted)):
+            if abs(_rational_vector_from_json([planted[i]])[0]) != abs(
+                _rational_vector_from_json([planted[j]])[0]
+            ):
+                pair_to_swap = (i, j)
+                break
+        if pair_to_swap is not None:
+            break
+    if pair_to_swap is None:
+        pair_to_swap = (1, 2)
+    i, j = pair_to_swap
+    swap_two[i], swap_two[j] = swap_two[j], swap_two[i]
+    corruptions = {
+        "drop_one": drop_one,
+        "swap_two": swap_two,
+        "duplicate_coordinate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    reasons = {name: verify(shipping, value)[1] for name, value in corruptions.items()}
+    rejected = sum(not verify(shipping, value)[0] for value in corruptions.values())
+    report["G2_rejects_corruption"] = {
+        "pass": rejected == len(corruptions) and len(set(reasons.values())) == len(reasons),
+        "attempts": len(corruptions),
+        "rejected": rejected,
+        "distinct_reasons": len(set(reasons.values())) == len(reasons),
+        "reasons": reasons,
+    }
+
+    # G3: realistic response with prose and a fenced answer inside the tags.
+    model_style = (
+        "The cancellation follows from the binary parity character.\n\n"
+        "<answer>\n```text\n"
+        + _answer_text(planted)
+        + "\n```\n</answer>\n"
+        "The vector is normalized by x0=1."
+    )
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and verify(shipping, parsed)[0],
+        "surrounding_prose_and_fence": True,
+        "round_trip_equal": parsed == planted,
+    }
+
+    # G4: uniform over every sign choice left after reading the quadratics.
+    guess_inst = make_instance(seed=271828, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    guess_rng = random.Random(314159)
+    guess_trials = 200_000
+    guess_hits = 0
+    for _ in range(guess_trials):
+        guess_hits += int(verify(guess_inst, random_candidate(guess_inst, guess_rng))[0])
+    observed = guess_hits / guess_trials
+    exact_count = enumerate_all(guess_inst)
+    exact_density = (
+        exact_count / search_space(guess_inst) if exact_count is not None else None
+    )
+    report["G4_guess_resistance"] = {
+        "pass": guess_trials >= 200_000
+        and exact_density is not None
+        and exact_density < 1e-6,
+        "hits": guess_hits,
+        "total": guess_trials,
+        "observed_probability": observed,
+        "exact_probability": exact_density,
+        "candidate_space": search_space(guess_inst),
+        "prior": "uniform over the 2^n normalized rational roots of the quadratics",
+    }
+
+    # G5: exact shipping density plus the measured strongest failing attack.
+    baseline_rng = random.Random(1618033)
+    baseline_start = time.perf_counter()
+    baseline_candidate, baseline_checks = _attack_random_restart(
+        guess_inst, baseline_rng, 4096
+    )
+    baseline_seconds = time.perf_counter() - baseline_start
+    baseline_success = verify(guess_inst, baseline_candidate)[0]
+    report["G5_density_and_baseline"] = {
+        "pass": exact_count is not None and exact_density is not None and not baseline_success,
+        "shipping_preset": SHIPPING_DIFFICULTY,
+        "shipping_seed": 271828,
+        "exact_valid_answer_count": exact_count,
+        "candidate_space": search_space(guess_inst),
+        "solution_fraction": exact_density,
+        "sampled_density_hits": guess_hits,
+        "sampled_density_total": guess_trials,
+        "baseline_attack": "uniform random restart over quadratic-feasible roots",
+        "baseline_success": baseline_success,
+        "baseline_candidate_checks": baseline_checks,
+        "baseline_wall_seconds": baseline_seconds,
+    }
+
+    # G6: four failing in-context attacks; DP is the successful Track-B reference.
+    attack_totals = {
+        "outlier_top_half_by_effective_weight": 0,
+        "greedy_largest_first_balance": 0,
+        "random_restart_4096": 0,
+        "alternating_sorted_ansatz": 0,
+        "period_four_sorted_ansatz": 0,
+    }
+    reference_rows = []
+    reference_seconds = 0
+    reference_words = 0
+    reference_scalar = 0
+    reference_successes = 0
+    for offset in range(8):
+        seed = 10000 + offset
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        attack_candidates = {
+            "outlier_top_half_by_effective_weight": _attack_outlier_magnitude(inst),
+            "greedy_largest_first_balance": _attack_greedy_largest_first(inst),
+            "alternating_sorted_ansatz": _attack_rank_pattern(inst, 2),
+            "period_four_sorted_ansatz": _attack_rank_pattern(inst, 4),
+        }
+        random_attack, _ = _attack_random_restart(
+            inst, random.Random(50000 + offset), 4096
+        )
+        attack_candidates["random_restart_4096"] = random_attack
+        for name, candidate in attack_candidates.items():
+            attack_totals[name] += int(verify(inst, candidate)[0])
+
+        start = time.perf_counter()
+        reference_answer, stats = _reference_subset_sum(inst)
+        elapsed = time.perf_counter() - start
+        solved = reference_answer is not None and verify(inst, reference_answer)[0]
+        reference_successes += int(solved)
+        reference_seconds += elapsed
+        reference_words += stats["bitset_word_updates"]
+        reference_scalar += stats["scalar_state_updates"]
+        reference_rows.append(
+            {
+                "seed": seed,
+                "solved": solved,
+                "target": stats["target"],
+                "bitset_word_updates": stats["bitset_word_updates"],
+                "wall_seconds": elapsed,
+            }
+        )
+    attacks = {
+        name: {"successes": successes, "attempts": 8}
+        for name, successes in attack_totals.items()
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(result["successes"] == 0 for result in attacks.values())
+        and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "exact subset-sum dynamic programming with bitset rows",
+            "complexity": "O(nW) scalar states, O(nW/64) 64-bit word updates",
+            "solves": f"{reference_successes}/8, as expected",
+            "operations": reference_words,
+            "operation_unit": "estimated 64-bit bitset-word updates across eight hard instances",
+            "scalar_state_updates": reference_scalar,
+            "wall_clock_sec": reference_seconds,
+            "per_seed": reference_rows,
+        },
+    }
+
+    # G7: double n while retaining the same degree and exact verifier.
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=424242, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] == 2 * shipping["n"],
+        "original_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "verify_reason": doubled_reason,
+        "answer_atoms_before": _atomic_elements(shipping["answer"]),
+        "answer_atoms_after": _atomic_elements(doubled["answer"]),
+    }
+
+    # G8: arbitrary variable permutation, order reversal, and their composition.
+    g8_failures = []
+    invariance_checks = 0
+    transformation_checks = 0
+    unrelated_keys = []
+    for offset in range(20):
+        inst = make_instance(seed=20000 + offset, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        base_key = canonical_key(inst)
+        unrelated_keys.append(base_key)
+        rng = random.Random(30000 + offset)
+        permutation = list(range(inst["n"]))
+        rng.shuffle(permutation)
+        identity = list(range(inst["n"]))
+        transformations = [
+            _relabel_instance(inst, permutation, False),
+            _relabel_instance(inst, identity, True),
+            _relabel_instance(inst, permutation, True),
+        ]
+        for index, (transformed, carried) in enumerate(transformations):
+            invariance_checks += 1
+            transformation_checks += 1
+            if canonical_key(transformed) != base_key:
+                g8_failures.append(
+                    {"seed": 20000 + offset, "transformation": index, "kind": "key"}
+                )
+            ok, reason = verify(transformed, carried)
+            if not ok:
+                g8_failures.append(
+                    {
+                        "seed": 20000 + offset,
+                        "transformation": index,
+                        "kind": "carried witness",
+                        "reason": reason,
+                    }
+                )
+    distinct = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures and distinct == 20,
+        "invariance_checks": invariance_checks,
+        "real_transformation_checks": transformation_checks,
+        "distinct_unrelated_keys": distinct,
+        "unrelated_attempts": 20,
+        "failures": g8_failures,
+        "caveat": "complete for variable relabelling and input reordering, not arbitrary GL(Q) changes of basis",
+    }
+
+    # G9(a,b) are recorded diagnostics; only the exact size/effort caps gate.
+    answer_blob = json.dumps(shipping["answer"])
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _atomic_elements(shipping["answer"])
+    intended_operations = 255
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    hinted = G9_EVIDENCE["hinted"]["solved"]
+    placebo = G9_EVIDENCE["placebo"]["solved"]
+    hinted_minus_placebo = (
+        None
+        if hinted is None or placebo is None
+        else hinted / G9_EVIDENCE["hinted"]["attempts"]
+        - placebo / G9_EVIDENCE["placebo"]["attempts"]
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": {
+            "bare": dict(G9_EVIDENCE["bare"]),
+            "hinted": dict(G9_EVIDENCE["hinted"]),
+            "placebo": dict(G9_EVIDENCE["placebo"]),
+        },
+        "hinted_minus_placebo": hinted_minus_placebo,
+        "hinted_verdict": G9_EVIDENCE["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [
+        value
+        for key, value in report.items()
+        if key.startswith("G") and key[1:2].isdigit()
+    ]
+    report["all_passed"] = all(gate.get("pass") is True for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

