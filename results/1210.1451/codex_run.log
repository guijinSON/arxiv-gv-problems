+def _karmarkar_karp_candidate(inst):
+    heap = []
+    serial = 0
+    for index, coefficient in enumerate(inst["coefficients"]):
+        vector = {index: 1}
+        heapq.heappush(heap, (-abs(coefficient), serial, vector))
+        serial += 1
+    while len(heap) > 1:
