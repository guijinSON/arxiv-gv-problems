+            merged[index] = -sign
+        heapq.heappush(heap, (-((-neg_a) - (-neg_b)), serial, merged))
+        serial += 1
+    identity = [0] * inst["n"]
+    for index, sign in heap[0][2].items():
+        identity[index] = sign
+    return _candidate_from_identity_signs(inst, identity)
 
 
