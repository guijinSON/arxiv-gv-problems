+STRUCTURAL_HINT = (
+    "Equal quadratic scales expose low-degree effective-coefficient blocks with "
+    "a binary digit-parity symmetry."
+)
+PLACEBO_HINT = (
+    "The displayed exact coefficients reward careful bookkeeping of all the "
+    "variable indices."
+)
+
