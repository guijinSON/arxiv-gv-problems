+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A normalized rational vector [x_0,...,x_n] with x_0=1 and, for "
+        "each displayed quadratic x_0^2-r_i^2*x_i^2, canonical coordinate "
+        "x_i in {[-1,r_i],[1,r_i]}.  Thus all denominators and coordinate "
+        "heights are fixed by the instance and the language has exactly 2^n "
+        "members."
+    ),
+    "bounds": {
+        "vector_length": "n+1",
+        "normalization": "x_0=[1,1]",
+        "coordinate_choices": 2,
+        "coordinate_numerators": [-1, 1],
+        "coordinate_denominators": "the positive r_i printed in the instance",
+        "rational_encoding": "[numerator, denominator] in lowest terms",
+    },
+}
+
+
+DIFFICULTY = {
