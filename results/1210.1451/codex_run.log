+        "square homogeneous polynomial system over Q",
+        "normalized rational projective common root",
+    ],
+    "verification_operations": [
+        "exact rational substitution into homogeneous quadratics",
+        "exact rational evaluation of a homogeneous linear form",
+        "exact equality to zero",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": _REDUCTION_CITATION,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "Recognize the binary digit-parity symmetry that annihilates all "
+        "low-degree moments of an ordered coefficient sequence; without it, "
+        "one must solve the induced equal-subset-sum instance."
