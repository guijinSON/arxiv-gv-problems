/bin/bash -lc "python3 - <<'PY'
import time
NBASE=84
# cubic quotient = cycle plus antipodal matching; expand each quotient vertex to a triangle
nbrs=[[(u-1)%NBASE,(u+1)%NBASE,(u+NBASE//2)%NBASE] for u in range(NBASE)]
port={(u,v):3*u+i for u,vs in enumerate(nbrs) for i,v in enumerate(vs)}
adj=[set() for _ in range(3*NBASE)]
for u in range(NBASE):
    tri=[3*u+i for i in range(3)]
    for i in range(3):
        for j in range(i+1,3):
            adj[tri[i]].add(tri[j]); adj[tri[j]].add(tri[i])
for u in range(NBASE):
    for v in nbrs[u]:
        if u<v:
            a,b=port[u,v],port[v,u]
            adj[a].add(b); adj[b].add(a)

def local_certificate_pass():
    unseen=set(range(3*NBASE)); blocks=[]; pair_tests=0
    while unseen:
        v=min(unseen); ns=list(adj[v]); tri=None
        for i in range(3):
            for j in range(i+1,3):
                pair_tests += 1
                if ns[j] in adj[ns[i]]:
                    tri=(v,ns[i],ns[j]); break
            if tri: break
        blocks.append(tri); unseen.difference_update(tri)
    # The known antipodal quotient matching chooses one port from each block.
    black=[]; selections=0
    for u in range(NBASE):
        black.append(port[u,(u+NBASE//2)%NBASE]); selections += 1
    # Exact neighborhood verification.
    colors=set(black); checks=0
    for v in range(3*NBASE):
        seen_b=seen_w=False
        for w in adj[v]:
            checks += 1
            if w in colors: seen_b=True
            else: seen_w=True
        assert seen_b and seen_w
    return pair_tests,selections,checks
assert local_certificate_pass()==(84,84,756)
t0=time.perf_counter()
for _ in range(20000): local_certificate_pass()
elapsed=time.perf_counter()-t0
print({'vertices':3*NBASE,'triangle_blocks':NBASE,'pair_tests':84,'certificate_selections':84,'verification_neighbor_checks':756,'certificate_route_operations_excluding_verification':168,'mean_wall_clock_sec':elapsed/20000})
