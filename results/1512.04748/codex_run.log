+        "doubled_vertices": doubled["vertex_count"],
+        "build_wall_sec": round(doubled_build, 6),
+        "verify_reason": doubled_why,
+    }
+
+    invariant_checks = 0
+    carried_checks = 0
+    distinct_keys = []
+    g8_failures = []
+    g8_params = dict(DIFFICULTY["easy"])
+    for seed in range(20):
