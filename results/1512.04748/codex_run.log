+        "for the L-free cubic regime; the executable bounded-decoy C4-factor "
+        "reference algorithm runs in O(V*Delta^3 + 2^d*V), where d is the number "
+        "of non-factor 4-cycles.  Shipping measurements are filled by selftest: "
+        "the compact route uses at most 5 operations per recovered square."
+    ),
+    "max_answer_tokens": 117,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
