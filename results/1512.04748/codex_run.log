+    # model.  The generous deterministic cap protects malformed extreme params.
+    for attempt in range(200_000):
+        rng.shuffle(vertices)
+        matching = []
+        admissible = True
+        for i in range(0, vertex_count, 2):
+            u, v = vertices[i], vertices[i + 1]
+            if u // 4 == v // 4:
