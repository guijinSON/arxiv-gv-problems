+        "vertex_count": n,
+        "decoy_cycles": inst["decoy_cycles"],
+        "label_bound": 20_000_000,
+        "vertex_order": new_labels,
+        "neighbors": neighbors,
+        "sampling_attempts": inst["sampling_attempts"],
+        "answer": answer,
+    }
