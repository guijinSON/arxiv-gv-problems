+    hidden_colors = [0] * (4 * n)
+    rotations = []
+    for block in range(n):
+        rotation = rng.randrange(4)
+        rotations.append(rotation)
+        hidden_colors[4 * block + rotation] = 1
+        hidden_colors[4 * block + (rotation + 1) % 4] = 1
+
+    adjacency, _matching, sampling_attempts = _sample_matching(
+        n, decoy_cycles, rng
+    )
