+def _attack_cycle_incidence(inst):
+    adjacency = [set(row) for row in inst["neighbors"]]
+    incidence = [0] * len(adjacency)
+    for cycle in _four_cycles(adjacency):
+        for v in cycle:
+            incidence[v] += 1
+    return [
