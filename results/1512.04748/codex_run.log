+    n = inst["vertex_count"]
+    colors = [None] * n
+    for start in range(n):
+        if colors[start] is not None:
+            continue
+        colors[start] = 0
+        queue = [start]
+        cursor = 0
+        while cursor < len(queue):
+            u = queue[cursor]
+            cursor += 1
