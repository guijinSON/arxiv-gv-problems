+        "vertex_count": 4 * n,
+        "decoy_cycles": decoy_cycles,
+        "label_bound": label_bound,
+        "vertex_order": vertex_order,
+        "neighbors": neighbors,
+        "sampling_attempts": sampling_attempts,
+        "answer": answer,
+    }
