import random

def cycles4(B,match):
 n=4*B; adj=[set() for _ in range(n)]
 for b in range(B):
  for p in range(4):
   u=4*b+p; v=4*b+(p+1)%4; adj[u].add(v); adj[v].add(u)
 for u,v in match: adj[u].add(v);adj[v].add(u)
 cyc=set()
 for u in range(n):
  for v in range(u+1,n):
   com=adj[u]&adj[v]
   if len(com)>=2:
    cc=sorted(com)
    for i in range(len(cc)):
     for j in range(i+1,len(cc)):
      cyc.add(tuple(sorted((u,v,cc[i],cc[j]))))
 return cyc

def sample(B,rng):
 vs=list(range(4*B))
 for tries in range(100000):
  rng.shuffle(vs); M=[]; ok=True
  for i in range(0,len(vs),2):
   u,v=vs[i],vs[i+1]
   if u//4==v//4:ok=False;break
   M.append((u,v))
  if not ok:continue
  # conn
  adj=[set() for _ in range(B)]
  for u,v in M: adj[u//4].add(v//4);adj[v//4].add(u//4)
  seen={0}; st=[0]
  while st:
   x=st.pop()
   for y in adj[x]-seen:seen.add(y);st.append(y)
  if len(seen)<B:continue
  c=cycles4(B,M)
  base={tuple(range(4*b,4*b+4)) for b in range(B)}
  if c==base:return tries+1,M
 return None,None
for B in range(2,16):
 vals=[]
 for s in range(10):
  t,_=sample(B,random.Random(s));vals.append(t)
 print(B,vals)
