+        "prior": "uniform over all length-V bit lists, exactly the stated language",
+        "wall_clock_sec": round(guess_wall, 6),
+    }
+
+    attack_names = [
+        "outlier_cycle_incidence",
+        "label_parity",
+        "display_period_0011",
+        "bfs_parity",
+        "greedy_one_pass",
+        "random_greedy_restart_64",
+    ]
+    attacks = {
+        name: {"successes": 0, "attempts": 0, "wall_clock_sec": 0.0}
