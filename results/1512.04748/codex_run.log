+        if colors[start] is not None:
+            continue
+        colors[start] = 0
+        queue = [start]
+        cursor = 0
+        while cursor < len(queue):
+            u = queue[cursor]
+            cursor += 1
+            for v in inst["neighbors"][u]:
+                if colors[v] is None:
+                    colors[v] = 1 - colors[u]
