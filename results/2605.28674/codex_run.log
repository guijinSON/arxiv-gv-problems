%   &=\frac{1}{2}(x_1^3+x_1x_2^2-2x_1x_3^2)^2 + (x_1^2x_3-x_3^3)^2 - \frac{1}{2}(x_1^4-x_2^4-2x_1^2x_3^2+2x_2^2x_3^2)x_1^2.
% \end{aligned} 
