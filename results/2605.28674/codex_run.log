\[g_{d}(x)-g_{d-d'}(x)=\sum_{k=(d-d')/2+1}^{d/2}\|x\|_2^{2k},\]
and
\[\begin{aligned}
   g_{d'}(x)(1+g_{d-d'}(x))-g_d(x)&=g_{d'}(x)+\left(g_{d'-2}(x)+\|x\|_2^{d'}\right)g_{d-d'}(x)-g_d(x)\\
