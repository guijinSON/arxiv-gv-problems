+    "Hint: Compare the modular differences between the two nonhub neighbors "
+    "of every clique vertex."
+)
+PLACEBO_HINT = (
+    "Hint: Check the vertex identifiers carefully when reading each listed "
+    "cross-neighborhood."
+)
