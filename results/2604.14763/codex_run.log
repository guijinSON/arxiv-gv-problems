%By Claim \ref{C1},  $N_G(u_i)\cap N_G(u_j)=\emptyset$ for any $1\le i\ne j\le|I|$.
% and $K''=K\setminus \bigcup_{i=1}^{|I|}N_G(u_i)$.
%Suppose that $E'\ne \emptyset$ or $K''\ne \emptyset$.




Suppose that $d_G(u_2)\ge 2$.  Let $E'$ be a set of edges of $G$  incident to $u_2$ except one edge. Let $K'=\{w: wu_2\in E'\}$. Let $G'=G-E'+\{u_1w: w\in K'\}$. Note that $G'$ is claw-free and as $d_{G'}(u_2)=1$, it is not Hamiltonian.
By Lemma
\ref{perron},  we have $\rho(G')>\rho(G)$, which is a contradiction. Thus  $d_G(u_2)=1$ and so
$d_G(u_2)=\dots=d_G(u_{|I|})=1$.


We claim that $K\setminus \bigcup_{i=1}^{|I|}N_G(u_i)=\emptyset$, as otherwise, for a vertex $w\in K\setminus \bigcup_{i=1}^{|I|}N_G(u_i)$, we have by Lemma \ref{addedges} that $\rho(G+u_1w)>\rho(G)$, which is a contradiction, as $G+u_1w$ is claw-free and non-Hamiltonian.

Therefore,
$G\cong G_{n,|I|}$.
\end{proof}



