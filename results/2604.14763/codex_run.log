+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "K_{1,4}-free split graph",
+        "explicit clique/independent-set split partition",
+        "Hamiltonian cycle",
+    ],
+    "verification_operations": [
+        "vertex-set equality",
+        "exact graph-edge lookup",
+        "cyclic adjacency check",
+    ],
