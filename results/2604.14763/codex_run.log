+        "greedy_lowest_label_matching": {"successes": 0, "attempts": 0},
+        "random_cycle_walk_256": {"successes": 0, "attempts": 0, "nodes": 0},
+        "smallest_modular_difference_ansatz": {"successes": 0, "attempts": 0},
+    }
+    reference_successes = 0
