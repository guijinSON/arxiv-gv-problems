+        offset = rng.randrange(n)
+        secret = rng.randrange(1, n - 1)
+        secret_word = _bitstring(secret, width)
+        target_character = _apply_binary_matrix(affine_rows, secret) ^ offset
+        if (
+            secret_word != secret_word[::-1]
+            and target_character != 0
+            and _apply_binary_matrix(affine_rows, secret) != secret
+        ):
+            break
+
+    prefix = [left_token] + [alphabet[rng.randrange(4)] for _ in range(padding)]
+    suffix = [alphabet[rng.randrange(4)] for _ in range(padding)] + [right_token]
+    word_length = len(prefix) + width + len(suffix)
+    candidate_words = []
+    used: set[tuple[str, ...]] = set()
+    for value in range(n):
+        bits = _bitstring(value, width)
+        middle = [one_token if bit == "1" else zero_token for bit in bits]
+        word = tuple(prefix + middle + suffix)
+        candidate_words.append(word)
+        used.add(word)
+
+    auxiliary_words = []
+    while len(auxiliary_words) < n:
+        word = _random_word(word_length, alphabet, rng)
+        if word not in used:
+            used.add(word)
+            auxiliary_words.append(word)
+
+    monomials = []
+    for value in range(n):
+        label = _bitstring(value, width)
+        monomials.append({
+            "word": list(candidate_words[value]),
+            "kind": "candidate",
+            "label": label,
+        })
+        monomials.append({
+            "word": list(auxiliary_words[value]),
+            "kind": "auxiliary",
+            "label": label,
+        })
+    column_order = list(range(2 * n))
+    rng.shuffle(column_order)
+    monomials = [monomials[index] for index in column_order]
+
+    minimum = 1 << (coefficient_bits - 1)
+    maximum = (1 << coefficient_bits) - 1
+    rows = []
+    for z in range(n):
+        scale = rng.randrange(minimum, maximum + 1)
+        if scale % 2 == 0:
+            scale = scale + 1 if scale < maximum else scale - 1
+        natural_signs = []
+        for value in range(n):
+            character = _apply_binary_matrix(affine_rows, value) ^ offset
+            sign = -1 if _parity(z & character) else 1
+            natural_signs.extend((sign, -sign))
+        signs = [natural_signs[index] for index in column_order]
+        rows.append({
+            "label": _bitstring(z, width),
+            "scale": scale,
+            "signs": "".join("+" if sign == 1 else "-" for sign in signs),
+        })
+    rng.shuffle(rows)
+
+    certificate_signs = [
+        -1 if _parity(z & target_character) else 1 for z in range(n)
+    ]
+    answer = {
+        "x": secret_word,
+        "signs_hex": _hex_from_signs(certificate_signs),
+    }
+    c_word = list(auxiliary_words[secret])
+    return {
+        "family": "homogeneous noncommutative ideal element",
+        "field": "Q",
+        "n": n,
+        "bit_width": width,
+        "coefficient_bits": coefficient_bits,
+        "padding": padding,
+        "variables": list(alphabet),
+        "bit_tokens": {"0": zero_token, "1": one_token},
+        "prefix": prefix,
+        "suffix": suffix,
+        "word_length": word_length,
+        "target_c": c_word,
+        "monomials": monomials,
+        "generators": rows,
+        "answer": answer,
+    }
+
+
+def _word_text(word: list[str] | tuple[str, ...]) -> str:
+    return " ".join(word)
+
+
+def render(inst: dict) -> str:
+    """Render a complete fixed-degree ideal-search problem."""
+    n = inst["n"]
+    width = inst["bit_width"]
+    lines = [
+        "Homogeneous noncommutative ideal certificate over Q",
+        "",
+        "Work in the free associative algebra Q<"
+        + ",".join(inst["variables"])
+        + ">. A monomial is an ordered word: variables do not commute. All",
+        f"displayed monomials have length {inst['word_length']}. Let I be the two-sided ideal",
+        "generated by the polynomials G_z below. Because all requested terms have",
+        "that same length, the displayed scalar combination is a literal ideal-membership witness.",
+        "",
+        f"A candidate x is a binary string of exactly {width} bits. Bits are read left",
+        "to right as coordinates 0,1,...; 0 denotes variable "
+        + inst["bit_tokens"]["0"]
+        + " and 1 denotes variable "
+        + inst["bit_tokens"]["1"]
+        + ". Define",
+        "  M(x) = ("
+        + _word_text(inst["prefix"])
+        + ") [variables encoded by x] ("
+        + _word_text(inst["suffix"])
+        + ").",
+        "The fixed target monomial is",
+        "  C = " + _word_text(inst["target_c"]),
+        "",
+        "The monomial basis is indexed below. The annotations M(x) and C are only",
+        "labels; every listed item is an ordinary noncommutative monomial.",
+    ]
+    target_tuple = tuple(inst["target_c"])
+    for index, monomial in enumerate(inst["monomials"]):
+        annotation = ""
+        if monomial["kind"] == "candidate":
+            annotation = f"  [M({monomial['label']})]"
+        if tuple(monomial["word"]) == target_tuple:
+            annotation += "  [C]"
+        lines.append(f"  {index:03d}: {_word_text(monomial['word'])}{annotation}")
+
+    lines.extend([
+        "",
+        "Each generator line has the form 'row_label scale sign_string'. If the j-th",
+        "character of sign_string is + (respectively -), the coefficient of basis",
+        "monomial j in G_z is +scale (respectively -scale). No term is omitted.",
+        "Row labels are binary coordinate strings in the same left-to-right convention.",
+    ])
+    for row in inst["generators"]:
+        lines.append(f"  {row['label']} {row['scale']} {row['signs']}")
+
+    example_x = "0" * width
+    example_hex = "0" * (n // 4)
+    lines.extend([
+        "",
+        "Find x and certify that M(x)-C is in I. Your certificate chooses one exact",
+        "rational coefficient for every generator. Put the n coefficient-sign bits in",
+        f"row-label numeric order z=0,...,{n - 1}; a label b0...b{width - 1} has numeric",
+        "value sum_i b_i*2^i. Encode + as bit 0 and - as bit 1, concatenate those n",
+        f"bits, and pack them big-endian into exactly {n // 4} hexadecimal digits.",
+        "If sigma_z is the decoded sign and scale_z is the displayed row scale, the",
+        "identity that your answer must make true is exactly",
+        "  (1/n) * sum_z (sigma_z / scale_z) G_z = M(x) - C.",
+        "All sums and coefficients are over Q; there is no modular arithmetic.",
+        "",
+        "Give your final answer inside <answer></answer> tags as one JSON object",
+        'with exactly the string fields "x" and "signs_hex".',
+        f'<answer>{{"x":"{example_x}","signs_hex":"{example_hex}"}}</answer>',
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the tagged JSON object, tolerating prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    body = match.group(1).strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.IGNORECASE)
+        body = re.sub(r"\s*```$", "", body).strip()
+    try:
+        answer = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(answer, dict):
+        return answer
+    return answer
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check the compressed rational combination by exact coefficient expansion."""
+    if not isinstance(answer, dict):
+        return False, "answer must be one JSON object"
+    if set(answer) != {"x", "signs_hex"}:
+        return False, "answer must have exactly the fields x and signs_hex"
+    x = answer["x"]
+    signs_hex = answer["signs_hex"]
+    width = inst["bit_width"]
+    n = inst["n"]
+    if not isinstance(x, str) or len(x) != width:
+        return False, f"x must contain exactly {width} bits"
+    if any(char not in "01" for char in x):
+        return False, "x contains a symbol outside the binary alphabet"
+    if not isinstance(signs_hex, str) or len(signs_hex) != n // 4:
+        return False, f"signs_hex must contain exactly {n // 4} hexadecimal digits"
+    if re.fullmatch(r"[0-9a-fA-F]+", signs_hex) is None:
+        return False, "signs_hex contains a non-hexadecimal character"
+    sigma = _signs_from_hex(signs_hex, n)
+    candidate_column = _column_index(inst, "candidate", x)
+    c_column = next(
+        (i for i, monomial in enumerate(inst["monomials"])
+         if monomial["word"] == inst["target_c"]),
+        None,
+    )
+    if candidate_column is None or c_column is None:
+        return False, "instance has no indexed candidate or target column"
+    rows = _rows_in_label_order(inst)
+
+    # Necessary exact coefficient tests make random-candidate measurement cheap.
+    # dot(sigma, candidate_column)=n with +/-1 entries iff the vectors agree.
+    for z, row in enumerate(rows):
+        column_sign = 1 if row["signs"][candidate_column] == "+" else -1
+        if sigma[z] != column_sign:
+            return False, "certificate does not give coefficient +1 to M(x)"
+    for z, row in enumerate(rows):
+        column_sign = 1 if row["signs"][c_column] == "+" else -1
+        if sigma[z] != -column_sign:
+            return False, "chosen monomial is not the antipodal partner of C"
+
+    # Expand every monomial coefficient. Row scales cancel symbolically in the
+    # mandated coefficient sigma_z/(n*scale_z), leaving exact integer sums.
+    totals = [0] * len(inst["monomials"])
+    for z, row in enumerate(rows):
+        sign = sigma[z]
+        for column, char in enumerate(row["signs"]):
+            totals[column] += sign if char == "+" else -sign
+    for column, total in enumerate(totals):
+        expected = n if column == candidate_column else (-n if column == c_column else 0)
+        if total != expected:
+            return False, f"expanded identity fails at monomial index {column}"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the stated word and n-bit coefficient-sign language."""
+    n = inst["n"]
+    width = inst["bit_width"]
+    return {
+        "x": _bitstring(rng.randrange(n), width),
+        "signs_hex": format(rng.getrandbits(n), f"0{n // 4}x"),
+    }
+
+
+def search_space(inst: dict) -> int:
+    """The exact size n*2^n of the bounded, structure-aware language."""
+    n = inst["n"]
+    return n * (1 << n)
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Brute-force the tiny preset only, with an explicit work cap."""
+    n = inst["n"]
+    if search_space(inst) > 200_000:
+        return None
+    count = 0
+    width = inst["bit_width"]
+    for value in range(n):
+        x = _bitstring(value, width)
+        for mask in range(1 << n):
+            candidate = {
+                "x": x,
+                "signs_hex": format(mask, f"0{n // 4}x"),
+            }
+            count += int(verify(inst, candidate)[0])
+    return count
+
+
+def _canonical_payload(inst: dict, token_map: dict[str, str]) -> str:
+    rows = _rows_in_label_order(inst)
+    transformed_columns = []
+    for column, monomial in enumerate(inst["monomials"]):
+        word = tuple(token_map[token] for token in monomial["word"])
+        vector = tuple(
+            row["scale"] * (1 if row["signs"][column] == "+" else -1)
+            for row in rows
+        )
+        transformed_columns.append((word, vector))
+    transformed_columns.sort()
+    payload = {
+        "field": inst["field"],
+        "prefix": [token_map[token] for token in inst["prefix"]],
+        "suffix": [token_map[token] for token in inst["suffix"]],
+        "bit_tokens": {
+            bit: token_map[token] for bit, token in inst["bit_tokens"].items()
+        },
+        "target_c": [token_map[token] for token in inst["target_c"]],
+        "row_labels": [row["label"] for row in rows],
+        "columns": [[list(word), list(vector)] for word, vector in transformed_columns],
+    }
+    return json.dumps(payload, separators=(",", ":"), sort_keys=True)
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonicalize input order and all four free-variable renamings."""
+    present = tuple(sorted(inst["variables"]))
+    best = None
+    canonical_names = tuple(sorted(_TOKENS))
+    for image in itertools.permutations(canonical_names):
+        token_map = dict(zip(present, image))
+        payload = _canonical_payload(inst, token_map)
+        if best is None or payload < best:
+            best = payload
+    return hashlib.sha256(best.encode("utf-8")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow coefficient height and word camouflage while the witness stays fixed."""
+    p = {key: value for key, value in params.items() if key != "_preset"}
+    n = int(p.get("n", 128))
+    coefficient_bits = int(p.get("coefficient_bits", 24))
+    padding = int(p.get("padding", 3))
+    if padding < 24 or coefficient_bits < 96:
+        p["padding"] = min(24, padding + 4)
+        p["coefficient_bits"] = min(96, coefficient_bits + 12)
+        return p
+    # Doubling n would require n+log2(n)>256 logical answer atoms. At this
+    # point the fixed-length axes above are exhausted, so the output cap binds.
+    if 2 * n + (2 * n).bit_length() - 1 > 256:
+        return "cap_bound"
+    p["n"] = 2 * n
+    return p
+
+
+def _candidate_answer_from_column(inst: dict, label: str) -> dict:
+    column = _column_index(inst, "candidate", label)
+    rows = _rows_in_label_order(inst)
+    signs = [1 if row["signs"][column] == "+" else -1 for row in rows]
+    return {"x": label, "signs_hex": _hex_from_signs(signs)}
+
+
+def _reference_antipodal_scan(inst: dict) -> tuple[dict | None, int]:
+    """Successful O(n^2) Track-B reference algorithm."""
+    rows = _rows_in_label_order(inst)
+    c_column = next(
+        i for i, monomial in enumerate(inst["monomials"])
+        if monomial["word"] == inst["target_c"]
+    )
+    c_vector = [1 if row["signs"][c_column] == "+" else -1 for row in rows]
+    operations = 0
+    best_label = None
+    best_correlation = None
+    for monomial_index, monomial in enumerate(inst["monomials"]):
+        if monomial["kind"] != "candidate":
+            continue
+        correlation = 0
+        for row_index, row in enumerate(rows):
+            sign = 1 if row["signs"][monomial_index] == "+" else -1
+            correlation += sign * c_vector[row_index]
+            operations += 2
+        if best_correlation is None or correlation < best_correlation:
+            best_correlation = correlation
+            best_label = monomial["label"]
+        operations += 1
+    if best_correlation != -inst["n"]:
+        return None, operations
+    return _candidate_answer_from_column(inst, best_label), operations
+
+
+def _outlier_column_sum(inst: dict) -> dict:
+    rows = _rows_in_label_order(inst)
+    best = None
+    for index, monomial in enumerate(inst["monomials"]):
+        if monomial["kind"] != "candidate":
+            continue
+        score = abs(sum(1 if row["signs"][index] == "+" else -1 for row in rows))
+        item = (score, monomial["label"])
+        if best is None or item > best:
+            best = item
+    return _candidate_answer_from_column(inst, best[1])
+
+
+def _identity_affine_ansatz(inst: dict) -> dict:
+    rows = _rows_in_label_order(inst)
+    width = inst["bit_width"]
+
+    def character_of(column: int, negate: bool = False) -> int:
+        base = 1 if rows[0]["signs"][column] == "+" else -1
+        if negate:
+            base = -base
+        value = 0
+        by_value = {_word_value(row["label"]): row for row in rows}
+        for i in range(width):
+            sign = 1 if by_value[1 << i]["signs"][column] == "+" else -1
+            if negate:
+                sign = -sign
+            if sign != base:
+                value |= 1 << i
+        return value
+
+    zero_column = _column_index(inst, "candidate", "0" * width)
+    c_column = next(
+        i for i, monomial in enumerate(inst["monomials"])
+        if monomial["word"] == inst["target_c"]
+    )
+    offset = character_of(zero_column)
+    target_character = character_of(c_column, negate=True)
+    guessed = target_character ^ offset  # assumes the hidden linear part is I
+    signs = [-1 if _parity(z & target_character) else 1 for z in range(inst["n"])]
+    return {
+        "x": _bitstring(guessed, width),
+        "signs_hex": _hex_from_signs(signs),
+    }
+
+
+def _random_restart(inst: dict, rng: random.Random, restarts: int) -> tuple[bool, int]:
+    for step in range(1, restarts + 1):
+        if verify(inst, random_candidate(inst, rng))[0]:
+            return True, step
+    return False, restarts
+
+
+def _reorder_instance(inst: dict, rng: random.Random) -> dict:
+    moved = json.loads(json.dumps(inst))
+    order = list(range(len(moved["monomials"])))
+    rng.shuffle(order)
+    moved["monomials"] = [moved["monomials"][i] for i in order]
+    for row in moved["generators"]:
+        row["signs"] = "".join(row["signs"][i] for i in order)
+    rng.shuffle(moved["generators"])
+    return moved
+
+
+def _rename_variables(inst: dict, permutation: tuple[str, ...]) -> dict:
+    moved = json.loads(json.dumps(inst))
+    mapping = dict(zip(_TOKENS, permutation))
+
+    def rename_word(word: list[str]) -> list[str]:
+        return [mapping[token] for token in word]
+
+    moved["variables"] = [mapping[token] for token in moved["variables"]]
+    moved["bit_tokens"] = {
+        bit: mapping[token] for bit, token in moved["bit_tokens"].items()
+    }
+    moved["prefix"] = rename_word(moved["prefix"])
+    moved["suffix"] = rename_word(moved["suffix"])
+    moved["target_c"] = rename_word(moved["target_c"])
+    for monomial in moved["monomials"]:
+        monomial["word"] = rename_word(monomial["word"])
+    return moved
+
+
+def _answer_metrics(inst: dict, answer: object) -> tuple[int, int, int]:
+    encoded = json.dumps(answer, separators=(",", ":"))
+    logical_atoms = inst["n"] + inst["bit_width"]
+    return len(encoded), math.ceil(len(encoded) / 4), logical_atoms
+
+
+def _intended_operations(inst: dict) -> int:
+    d = inst["bit_width"]
+    # Read d+2 character signatures on 0 and the d unit rows, derive/solve the
+    # affine map with packed GF(2) rows, and write n/4 hexadecimal sign digits.
+    return (d + 2) * (d + 1) + d * (d + 1) + d + inst["n"] // 4
+
+
+def selftest() -> dict:
+    """Run all mandatory correctness, resistance, scale, and symmetry gates."""
+    report: dict = {
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    g1_failures = []
+    g1_attempts = 0
+    for preset, parameters in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            instance = make_instance(seed=seed, **parameters)
+            ok, reason = verify(instance, instance["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append(f"{preset}/{seed}: {reason}")
+            try:
+                restored = json.loads(json.dumps(instance["answer"]))
+            except (TypeError, ValueError) as exc:
+                g1_failures.append(f"{preset}/{seed}: JSON error {exc}")
+            else:
+                if restored != instance["answer"]:
+                    g1_failures.append(f"{preset}/{seed}: JSON changed answer")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=123, **shipping)
+    planted = ship["answer"]
+    differing = next(
+        i for i in range(len(planted["x"]) - 1)
+        if planted["x"][i] != planted["x"][i + 1]
+    )
+    swapped_x = list(planted["x"])
+    swapped_x[differing], swapped_x[differing + 1] = swapped_x[differing + 1], swapped_x[differing]
+    corruptions = {
+        "drop": {"x": planted["x"]},
+        "swap": {"x": "".join(swapped_x), "signs_hex": planted["signs_hex"]},
+        "duplicate": {"x": planted["x"] + planted["x"][-1], "signs_hex": planted["signs_hex"]},
+        "empty": [],
+        "out_of_range": {"x": "2" + planted["x"][1:], "signs_hex": planted["signs_hex"]},
+    }
+    corruption_results = {}
+    for name, candidate in corruptions.items():
+        accepted, reason = verify(ship, candidate)
+        corruption_results[name] = {"accepted": accepted, "reason": reason}
+    reasons = [entry["reason"] for entry in corruption_results.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(not entry["accepted"] for entry in corruption_results.values()) and len(set(reasons)) == 5,
+        "cases": corruption_results,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    compact_answer = json.dumps(planted, separators=(",", ":"))
+    realistic = (
+        "The coefficient character is antipodal to C.\n```json\n"
+        f"<answer>\n{compact_answer}\n</answer>\n```\n"
+        "The tags contain the requested exact certificate."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and verify(ship, parsed)[0],
+        "parsed_matches": parsed == planted,
+        "realistic_wrapper": True,
+    }
+
+    guess_rng = random.Random(0x211012933)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_t0 = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(ship, random_candidate(ship, guess_rng))[0])
+    guess_elapsed = time.perf_counter() - guess_t0
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_fraction": guess_fraction,
+        "candidate_space": search_space(ship),
+        "exact_solution_fraction": 1 / search_space(ship),
+        "sampling_prior": "uniform binary word and uniform n-bit sign certificate",
+        "wall_clock_sec": round(guess_elapsed, 6),
+    }
+
+    attack_names = (
+        "outlier_normalized_column_sum",
+        "greedy_lexicographic_word",
+        "random_restart_256",
+        "obvious_identity_affine_ansatz",
+    )
+    attack_stats = {
+        name: {"successes": 0, "attempts": 0, "steps": 0, "wall_clock_sec": 0.0}
+        for name in attack_names
+    }
+    reference_successes = 0
+    reference_operations = 0
+    reference_wall = 0.0
+    for seed in range(800, 808):
+        instance = make_instance(seed=seed, **shipping)
+
+        t0 = time.perf_counter()
+        candidate = _outlier_column_sum(instance)
+        elapsed = time.perf_counter() - t0
+        stat = attack_stats["outlier_normalized_column_sum"]
+        stat["attempts"] += 1
+        stat["successes"] += int(verify(instance, candidate)[0])
+        stat["steps"] += instance["n"] ** 2
+        stat["wall_clock_sec"] += elapsed
+
+        t0 = time.perf_counter()
+        candidate = _candidate_answer_from_column(instance, "0" * instance["bit_width"])
+        elapsed = time.perf_counter() - t0
+        stat = attack_stats["greedy_lexicographic_word"]
+        stat["attempts"] += 1
+        stat["successes"] += int(verify(instance, candidate)[0])
+        stat["steps"] += instance["n"]
+        stat["wall_clock_sec"] += elapsed
+
+        t0 = time.perf_counter()
+        success, steps = _random_restart(instance, random.Random(seed ^ 0xA551), 256)
+        elapsed = time.perf_counter() - t0
+        stat = attack_stats["random_restart_256"]
+        stat["attempts"] += 1
+        stat["successes"] += int(success)
+        stat["steps"] += steps
+        stat["wall_clock_sec"] += elapsed
+
+        t0 = time.perf_counter()
+        candidate = _identity_affine_ansatz(instance)
+        elapsed = time.perf_counter() - t0
+        stat = attack_stats["obvious_identity_affine_ansatz"]
+        stat["attempts"] += 1
+        stat["successes"] += int(verify(instance, candidate)[0])
+        stat["steps"] += (instance["bit_width"] + 2) * (instance["bit_width"] + 1)
+        stat["wall_clock_sec"] += elapsed
+
+        t0 = time.perf_counter()
+        solution, operations = _reference_antipodal_scan(instance)
+        elapsed = time.perf_counter() - t0
+        reference_wall += elapsed
+        reference_operations += operations
+        reference_successes += int(solution is not None and verify(instance, solution)[0])
+
+    for stat in attack_stats.values():
+        stat["wall_clock_sec"] = round(stat["wall_clock_sec"], 6)
+    all_failed = all(stat["successes"] == 0 for stat in attack_stats.values())
+    reference_average = reference_operations // 8
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attack_stats,
+        "reference_algorithm": {
+            "name": "antipodal coefficient-column scan (stronger than generic exact elimination here)",
+            "complexity": "O(n^2) exact sign operations; generic homogeneous coefficient elimination is O(n^3)",
+            "wall_clock_sec": round(reference_wall, 6),
+            "operations": reference_operations,
+            "average_operations_per_instance": reference_average,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    demo = make_instance(seed=123, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    strongest_failing = max(attack_stats.items(), key=lambda item: item[1]["steps"])
+    report["G5_density_and_baseline"] = {
+        "pass": demo_count == 1 and reference_successes == 8,
+        "shipping_certified_solution_count": 1,
+        "shipping_exact_solution_fraction": 1 / search_space(ship),
+        "shipping_sampled_valid_hits": guess_hits,
+        "shipping_sampled_valid_total": guess_total,
+        "shipping_sampled_density": guess_fraction,
+        "demo_bruteforce_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "reference_algorithm_wall_clock_sec": round(reference_wall, 6),
+        "reference_algorithm_operations": reference_operations,
+        "reference_average_operations_per_instance": reference_average,
+        "strongest_failing_attack": strongest_failing[0],
+        "strongest_failing_attack_wall_clock_sec": strongest_failing[1]["wall_clock_sec"],
+        "strongest_failing_attack_steps": strongest_failing[1]["steps"],
+    }
+
+    ladder_spaces = [
+        search_space(make_instance(seed=7, **parameters))
+        for parameters in DIFFICULTY.values()
+    ]
+    doubled = make_instance(
+        n=2 * shipping["n"],
+        coefficient_bits=shipping["coefficient_bits"],
+        padding=shipping["padding"],
+        seed=909,
+    )
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    next_parameters = escalate(shipping)
+    fixed_answer_length = (
+        isinstance(next_parameters, dict)
+        and next_parameters["n"] == shipping["n"]
+    )
+    report["G7_scales"] = {
+        "pass": ladder_spaces == sorted(set(ladder_spaces)) and doubled_ok and fixed_answer_length,
+        "preset_candidate_spaces": dict(zip(DIFFICULTY, ladder_spaces)),
+        "doubled_n": doubled["n"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+        "fixed_length_escalation": next_parameters,
+    }
+
+    invariant_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    unrelated_keys = []
+    for seed in range(20):
+        instance = make_instance(n=16, coefficient_bits=8, padding=1, seed=20_000 + seed)
+        base_key = canonical_key(instance)
+        unrelated_keys.append(base_key)
+        rng = random.Random(30_000 + seed)
+        reordered = _reorder_instance(instance, rng)
+        permutation = list(_TOKENS)
+        rng.shuffle(permutation)
+        renamed = _rename_variables(instance, tuple(permutation))
+        composed = _rename_variables(reordered, tuple(permutation))
+        for number, moved in enumerate((reordered, renamed, composed)):
+            invariant_checks += 1
+            if canonical_key(moved) != base_key:
+                invariant_failures.append(f"key/{seed}/{number}")
+            witness_checks += 1
+            if not verify(moved, instance["answer"])[0]:
+                invariant_failures.append(f"witness/{seed}/{number}")
+    distinct_keys = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": not invariant_failures and distinct_keys == 20,
+        "invariance_checks": invariant_checks,
+        "carried_witness_checks": witness_checks,
+        "invariance_failures": invariant_failures,
+        "unrelated_instances": 20,
+        "distinct_keys": distinct_keys,
+        "transformations": [
+            "arbitrary generator reordering and monomial-column reordering",
+            "every tested free-variable renaming",
+            "composition of input reorderings with a free-variable renaming",
+        ],
+    }
+
+    chars, tokens, elements = _answer_metrics(ship, ship["answer"])
+    intended_operations = _intended_operations(ship)
+    arms = {name: dict(G9_ORACLE_RESULTS[name]) for name in ("bare", "hinted", "placebo")}
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = (
+        chars <= 2_000
+        and elements <= 256
+        and intended_operations <= 300
+        and PROBLEM_PROFILE["max_answer_tokens"] >= tokens
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": G9_ORACLE_RESULTS["hinted_verdict"] == "hardened" and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": chars,
+        "answer_tokens": tokens,
+        "answer_elements": elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(gate.get("pass") is True for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

