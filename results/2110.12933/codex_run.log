+def _rename_variables(inst: dict, permutation: tuple[str, ...]) -> dict:
+    moved = json.loads(json.dumps(inst))
+    mapping = dict(zip(_TOKENS, permutation))
+
+    def rename_word(word: list[str]) -> list[str]:
+        return [mapping[token] for token in word]
