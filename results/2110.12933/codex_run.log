+    "demo": {"n": 4, "coefficient_bits": 3, "padding": 0},
+    "easy": {"n": 32, "coefficient_bits": 8, "padding": 1},
+    "medium": {"n": 64, "coefficient_bits": 16, "padding": 2},
+    "hard": {"n": 128, "coefficient_bits": 24, "padding": 3},
+}
+SHIPPING_DIFFICULTY = "medium"
+
+STRUCTURAL_HINT = (
+    "Hint: The normalized generator columns are Walsh characters whose labels "
+    "and the candidate words share one affine map over F2."
+)
+PLACEBO_HINT = (
+    "Hint: Keep the row labels and monomial indices aligned while checking all "
+    "of the displayed coefficient signs."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON object {x, signs_hex}: x is one of the n binary words of "
+        "length log2(n), and signs_hex is exactly n bits packed into n/4 "
+        "hexadecimal digits.  Its bits choose the signs of rational "
+        "coefficients +/-1/(n*row_scale) in row-label order."
+    ),
+    "bounds": {
+        "shipping_x_choices": 128,
+        "shipping_x_bits": 7,
+        "shipping_sign_bits": 128,
+        "shipping_hex_digits": 32,
+        "shipping_coefficient_bits": 24,
