+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Recognize normalized coefficient columns as Walsh characters related "
+        "to candidate words by one hidden affine map over F2; without that "
+        "change of variables one must compare or eliminate dense columns."
+    ),
+    "hardness_basis": (
+        "Track B: fixed-degree coefficient matching gives exact Gaussian "
+        "elimination in O(n^3), while the strongest reference scan exploits "
+        "antipodal coefficient columns in O(n^2); at shipping n=128 it uses "
+        "32,896 exact sign operations per instance (wall-clock measured in "
