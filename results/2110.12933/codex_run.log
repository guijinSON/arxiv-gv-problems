+"""Affine-Walsh homogeneous ideal witnesses for arXiv:2110.12933.
+
+The paper studies how to find noncommutative polynomials of prescribed form in
+ideals.  This module gives homogeneous generators of a two-sided ideal in a
+free algebra over Q and asks for a monomial x together with a compressed exact
+linear-combination certificate for L*x*R-C.  Generation is inverse: the
+monomial and its Walsh character are selected before the generators exist.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
