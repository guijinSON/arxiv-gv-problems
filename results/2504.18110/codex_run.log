+    "intuition_description": (
+        "Transport the paper's equality of two vector sums through hidden "
+        "pairwise changes of generators instead of eliminating the full matrix."
+    ),
+    "hardness_basis": (
+        "Track B: exact rational RREF is an O(m^3) reference algorithm; at the "
+        "shipping preset its measured operation and wall-clock costs are recorded "
+        "in selftest_report.json, while the pair-invariant route uses at most 281 "
+        "exact operations and must be recognized and executed without tools."
+    ),
+    "max_answer_tokens": 160,
+}
+
+NATIVE: dict = {
