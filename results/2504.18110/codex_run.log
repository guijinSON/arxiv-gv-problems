+        "alternating_public_order": {"successes": 0, "attempts": 8},
+        "greedy_row_cancellation": {"successes": 0, "attempts": 8},
+        "random_restart_256": {"successes": 0, "attempts": 8},
+        "pair_local_norm_without_sign_alignment": {"successes": 0, "attempts": 8},
