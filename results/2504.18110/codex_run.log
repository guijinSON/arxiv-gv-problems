+def _block_product(left, right, n, diagonal):
+    """Return T_left^t D T_right or T_left^t H T_right."""
+    a, b, c, d = left
+    e, f, g, h = right
+    if diagonal:
+        # D = [[n,1],[1,n]].
+        return (
+            (n * a * e + a * g + c * e + n * c * g,
+             n * a * f + a * h + c * f + n * c * h),
+            (n * b * e + b * g + d * e + n * d * g,
+             n * b * f + b * h + d * f + n * d * h),
