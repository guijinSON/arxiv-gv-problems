+def _mixing_library():
+    """Small unimodular maps whose transported signed slice is nontrivial."""
+    out = []
+    for a, b, c, d in itertools.product(range(-2, 3), repeat=4):
+        det = a * d - b * c
+        if abs(det) != 1:
+            continue
+        # T^{-1} (1,-1)^t, integral because det is +/-1.
+        x = (d + b) // det
+        y = (-c - a) // det
+        if x == 0 or y == 0 or max(abs(x), abs(y)) > _BOUND:
+            continue
