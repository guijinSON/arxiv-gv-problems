+    "demo": {"n": 2},
+    "easy": {"n": 32},
+    "medium": {"n": 40},
+    "hard": {"n": 48},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT: str = (
+    "Hint: Use each listed pair's local Gram norm, then align its sign against one anchor pair."
+)
