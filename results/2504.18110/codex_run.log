+        attacks["random_restart_256"]["successes"] += int(random_hit)
+        rt0 = time.perf_counter()
+        answer, ops = _rref_reference(inst)
+        ref_seconds.append(time.perf_counter() - rt0)
+        ref_operations.append(ops)
