+
+def enumerate_all(inst) -> int | None:
+    """Brute-force the declared language only when its raw cube is small."""
+    m = inst["dimension"]
+    B = inst["coefficient_bound"]
+    if (2 * B + 1) ** m > 100_000:
+        return None
+    count = 0
+    for values in itertools.product(range(-B, B + 1), repeat=m):
+        if not any(values):
+            continue
+        g = 0
+        for value in values:
+            g = math.gcd(g, abs(value))
