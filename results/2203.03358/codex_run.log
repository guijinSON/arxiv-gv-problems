+    answer_elements = _answer_atoms(shipping["answer"])
+    answer_tokens = math.ceil(answer_chars / 4)
+    # Read one image-of-infinity per frame.  Since c is constructed as +/-1,
+    # each needs at most one negation; include two comparisons per group.
+    intended_ops = 3 * shipping["groups"]
+    arms = json.loads(json.dumps(G9_EVIDENCE))
