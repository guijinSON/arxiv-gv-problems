+    transformed = {
+        **{k: v for k, v in inst.items() if k not in {"constraint_edges", "answer"}},
+        "constraint_edges": edges,
+    }
+    carried = []
+    for old, t in inst["answer"]:
+        new_t = p if t == p else (t + label_shifts[old]) % p
+        carried.append([old_to_new[old], new_t])
