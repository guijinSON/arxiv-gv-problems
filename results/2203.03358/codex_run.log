+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "succinct IC-WCOL(1) graph",
+        "partial vertex ordering",
+        "projective-line compatibility graph",
+    ],
+    "verification_operations": [
