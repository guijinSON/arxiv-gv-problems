+# Script-owned oracle runs replace these placeholders before the final report.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 1, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
