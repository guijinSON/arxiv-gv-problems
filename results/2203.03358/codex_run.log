\begin{lemma}
  \label{lemma:nopaththrougS}
  Consider an extendable subordering~$L_S$ with free vertices~$T$.
  Assume that there is a full right extension $L^\prime$ of~$L_S$ with $\wreach_r(G,L^\prime)\le k$.
  For each vertex $u\in T$, let $X_{L^\prime}(u)=\{v\in T\mid v\prec_{L^\prime} u\}$ be
  the vertices that are placed between~$S$ and~$u$ w.r.t.\ $L^\prime$.
  If $\wreach_r(G,L^\prime,u)\cap X_{L^\prime}(u)=\emptyset$, then each path of length at most~$r$ between~$u$ and a vertex in $X_{L^\prime}(u)$ goes through~$S$.
\end{lemma}
\begin{proof}
  Assume to the contrary that there is a path $P$ of length at most~$r$ between~$u$ and a vertex in $X_{L^\prime}(u)$ that does not go through~$S$.
  Consider the leftmost (w.r.t.~$L^\prime$) vertex~$x$ on this path.
  Since there is a path from~$u$ to $x$ of length at most~$r$ that does not go left of $x$, $x$ has to be in $\wreach_r(G,L^\prime,u)\cap X_{L^\prime}(u)$, yielding a contraction.
\end{proof}
