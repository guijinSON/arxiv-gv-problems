+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 3.1, Theorem 3.1: the paper's polynomial reduction from "
+        "Independent Set to IC-WCOL(r), specialized to r=1 and k=2"
+    ),
