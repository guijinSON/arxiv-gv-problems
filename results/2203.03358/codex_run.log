diff --git a/gen_2203_03358.py b/gen_2203_03358.py
new file mode 100644
index 0000000000000000000000000000000000000000..1a0ba9b9c8dcd63116ae12701cfa8037555a8f38
--- /dev/null
+++ b/gen_2203_03358.py
@@ -0,0 +1,1077 @@
+"""Verified IC-WCOL(1) instances from arXiv:2203.03358.
+
