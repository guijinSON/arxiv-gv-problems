+def _random_restart_attack(inst: dict, rng: random.Random,
+                           restarts: int = 512) -> object:
+    edges = _edge_set(inst)
+    last: object = {"kind": "table", "image": list(range(int(inst["n"])))}
+    for _ in range(restarts):
