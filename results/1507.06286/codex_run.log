import importlib.util, json, random
s=importlib.util.spec_from_file_location('g','gen_1507_06286.py'); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
for n in (8,16,32):
 i=g.make_instance(n,seed=1)
 assert g.verify(i,i['answer'])[0]
print('defaults_ok')
for seed in range(100):
 i=g.make_instance(seed=seed,**g.DIFFICULTY['hard'])
