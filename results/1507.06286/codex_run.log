+    return a, tuple(rows), d
+
+
+def _rule_edges(n: int, r: int, s: int,
+                rule: tuple[int, tuple[int, ...], int]) -> set[tuple[int, int]]:
+    a, row_tuple, d = rule
+    rows = list(row_tuple)
