+        changed, carried = _relabel_instance(inst, random.Random(30_000 + seed))
+        if canonical_key(changed) == key:
+            invariant += 1
+        else:
+            g8_failures.append(f"vertex relabelling changed key at seed {seed}")
+        if verify(changed, carried)[0]:
