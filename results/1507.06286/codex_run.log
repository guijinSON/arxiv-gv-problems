+                       ) -> tuple[int, tuple[int, ...], int]:
+    a = rng.randrange(1, 1 << r)
+    rows: list[int] = []
+    for _ in range(s):
+        while True:
+            row = rng.randrange(1 << r)
+            if _parity(row & a) == 0:
+                rows.append(row)
+                break
