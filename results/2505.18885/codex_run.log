def _strip_code_fence(body: str) -> str:
    body = body.strip()
    if not (body.startswith("```") and body.endswith("```")):
        return body
    lines = body.splitlines()
    if len(lines) < 2:
        return body
    return "\n".join(lines[1:-1]).strip()


