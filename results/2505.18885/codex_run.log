+    answer_tokens = math.ceil(answer_chars / 4)
+    worst_chars = 2 + (inst["n"] - 1) + sum(
+        len(str(index)) + 1 for index in range(1, inst["n"] + 1)
+    )
+    worst_tokens = math.ceil(worst_chars / 4)
+    elements = len(answer)
+    operations = inst["n"] // 2
+    arms = {name: dict(_ORACLE_EVIDENCE[name])
