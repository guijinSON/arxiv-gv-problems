+    "Clause-Linked-Planar-Exactly-3-Bounded-3-SAT is carried to a legal "
+    "two-colouring of the variable, clause, and link gadgets"
+)
+
+PROBLEM_PROFILE = {
+    "native_domain": "logic",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
