+DIFFICULTY = {
+    "demo": {"n": 2},
+    "easy": {"n": 60},
+    "medium": {"n": 126},
+    "hard": {"n": 240},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Truth is invariant under multiplication by nonzero squares in the "
