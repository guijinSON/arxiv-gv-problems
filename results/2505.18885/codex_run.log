+        "A JSON list of exactly n signed variable IDs in increasing absolute-ID "
+        "order: +i assigns variable i true and -i assigns it false."
+    ),
+    "bounds": {
+        "length": "n",
+        "absolute_id_min": 1,
+        "absolute_id_max": "n",
+        "sign_choices_per_entry": 2,
