+def _is_prime(value):
+    if isinstance(value, bool) or not isinstance(value, int) or value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _validate_n(n):
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise ValueError("n must be an integer")
