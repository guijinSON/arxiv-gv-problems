dupes = len(keys) - len(set(keys))
if dupes:
    print(f"  {dupes} duplicate instance(s) out of {len(keys)} — isomorphic problems in "
          f"the dataset"); sys.exit(1)
print(f"  {len(set(keys))}/{len(keys)} distinct canonical keys")
