import random

def gen(N, seed):
 r=random.Random(seed); m=N//2; verts=list(range(N));r.shuffle(verts);A=verts[:m];B=verts[m:];edges=set()
 for S in (A,B):
  P=S[:];r.shuffle(P);edges.update(tuple(sorted((P[i],P[i+1]))) for i in range(m-1))
 for tries in range(10000):
  E=[]
  for _ in range(3): Q=B[:];r.shuffle(Q);E += list(zip(A,Q))
  if len(set(E))==3*m:break
 edges.update(tuple(sorted(e)) for e in E);adj=[set() for _ in range(N)]
 for u,v in edges:adj[u].add(v);adj[v].add(u)
 ans=[0]*N
 for x in B:ans[x]=1
 return adj,ans

def valid(adj,c):
 for v in range(len(c)):
  if sum(c[w]==c[v] for w in adj[v])>2:return False
 seen=set()
 for s in range(len(c)):
  if s in seen:continue
  col=c[s]; stack=[(s,-1)]
  while stack:
   v,p=stack.pop()
   if v in seen:return False
   seen.add(v)
   for w in adj[v]:
    if c[w]==col and w"'!=p:stack.append((w,v))
 return True

def attack(adj,seed,restarts=256):
 r=random.Random(seed);N=len(adj)
 for z in range(restarts):
  c=[r.randrange(2) for _ in range(N)]
  order=list(range(N))
  for p in range(20):
   r.shuffle(order);moves=0
   for v in order:
    same=sum(c[w]==c[v] for w in adj[v])
    if same>len(adj[v])//2:
     c[v]''^=1;moves+=1
   if not moves:break
  if valid(adj,c):return True,z,p
 return False,None,None
for N in [80,120,160,200,240]:
 print('"'N',N,flush=True)
 for s in range(3):
  a,x=gen(N,s); print(s,valid(a,x),attack(a,100+s),flush=True)
