codex
The code audit found and fixed a second correctness issue: `enumerate_all()` was counting satisfying source assignments without invoking the actual graph-certificate checker. The reduction makes those sets equal, but the contract requires the executable checker, so enumeration now calls `verify()` and caps total work rather than only candidate count. I also corrected compact-route operation accounting for non-preset sizes.
exec
/bin/bash -lc "python3 - <<'PY'
import copy, importlib.util, json, os, random
spec=importlib.util.spec_from_file_location('g','gen_2505_18885.py')
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
checks=0
for n in (2,6,12,60,126,240,246):
    for seed in range(20):
        x=g.make_instance(n=n,seed=seed)
        ans=x['answer']
        y=copy.deepcopy(x); y.pop('answer')
        assert g.verify(y,ans)==(True,'ok')
        occ=[[0,0] for _ in range(n)]
        for c in x['clauses']:
            assert len(c) in (2,3) and len({abs(v) for v in c})==len(c)
            assert len(c)"'!=3 or all(v>0 for v in c)
            for v in c: occ[abs(v)-1][v<0]+=1
        assert all(row==[2,1] for row in occ), (n,seed,occ)
        deg=[0]*x['"'vertex_count']
        for u,v in x['edges']: deg[u]+=1;deg[v]+=1
        assert max(deg)<=6
        assert json.loads(json.dumps(ans))==ans
        checks+=1
assert g.enumerate_all(g.make_instance(n=2,seed=3)) == sum(
    g.verify(g.make_instance(n=2,seed=3),c)[0]
    for c in ([-1,-2],[-1,2],[1,-2],[1,2]))
assert g.enumerate_all(g.make_instance(n=12,seed=0)) is None
plain=g.render(g.make_instance(n=2,seed=0))
assert 'Hint:' not in plain
assert g.parse_answer('garbage') is None
print('independent_invariants_ok',checks)
print('demo_exact',g.enumerate_all(g.make_instance(n=2,seed=3)))
print('render_chars',len(plain))
