+        "greedy_minimum_translation": lambda inst, seed: _greedy_minimum_attack(inst),
+        "single_edge_extrapolation": lambda inst, seed: _single_edge_extrapolation_attack(inst),
+        "small_slope_scan_16": lambda inst, seed: _small_slope_scan_attack(inst, 16),
+        "random_restart_256": lambda inst, seed: _random_restart_attack(inst, seed, 256),
+    }
+    attack_results = {
