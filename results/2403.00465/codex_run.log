+    standard_seconds = time.perf_counter() - start
+    standard_ok = standard_days is not None and _verify_explicit_days(ship, standard_days)
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_exact = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": reference_ok and standard_ok and _G4_SAMPLES >= 200_000 and demo_exact is not None,
+        "shipping_density_hits": hits,
