+) -> tuple[dict, dict]:
+    """Apply one named symmetry, or their full composition, carrying the witness."""
+    modes = {
+        "row_order", "neighbour_order", "affine_coordinates",
+        "bipartition_swap", "day_permutation", "composed",
+    }
+    if mode not in modes:
+        raise ValueError("unknown G8 transformation mode")
+    out = copy.deepcopy(inst)
+    carried = copy.deepcopy(answer)
