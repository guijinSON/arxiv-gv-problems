+        "row_comparisons": 0,
+    }
+    compact_successes = 0
+    compact_total_ops = 0
+    standard_successes = 0
+    standard_total_seconds = 0.0
+    standard_totals = {
+        "operations": 0,
+        "edge_scans": 0,
+        "queue_pops": 0,
+        "augmentations": 0,
+    }
+    for seed in range(_ATTACK_SEEDS):
+        inst = make_instance(seed=90_000 + seed, **shipping_params)
+        for name, attack in attack_fns.items():
+            candidate = attack(inst, 700_000 + seed)
+            if verify(inst, candidate)[0]:
+                attack_results[name]["successes"] += 1
+        t0 = time.perf_counter()
+        candidate, ops = _reference_algorithm(inst)
+        reference_total_seconds += time.perf_counter() - t0
+        for key in reference_totals:
+            reference_totals[key] += ops[key]
+        if candidate is not None and verify(inst, candidate)[0]:
+            reference_successes += 1
+        t0 = time.perf_counter()
+        days, domain_ops = _domain_standard_algorithm(inst)
+        standard_total_seconds += time.perf_counter() - t0
+        for key in standard_totals:
+            standard_totals[key] += domain_ops[key]
+        if days is not None and _verify_explicit_days(inst, days):
+            standard_successes += 1
+        compact_candidate, compact_ops = _compact_rule(inst)
+        compact_total_ops += compact_ops["total_operations"]
+        if verify(inst, compact_candidate)[0]:
+            compact_successes += 1
+    all_failed = all(result["successes"] == 0 for result in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": (
+            all_failed
