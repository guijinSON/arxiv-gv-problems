+        "domain_standard_operations": standard_ops["operations"],
+        "domain_standard_edge_scans": standard_ops["edge_scans"],
+        "domain_standard_solved": standard_ok,
+    }
+
+    attack_fns = {
+        "outlier_identity_residue": lambda inst, seed: _identity_residue_attack(inst),
+        "greedy_minimum_translation": lambda inst, seed: _greedy_minimum_attack(inst),
+        "single_edge_extrapolation": lambda inst, seed: _single_edge_extrapolation_attack(inst),
+        "small_slope_scan_16": lambda inst, seed: _small_slope_scan_attack(inst, 16),
+        "random_restart_256": lambda inst, seed: _random_restart_attack(inst, seed, 256),
+    }
+    attack_results = {
+        name: {"successes": 0, "attempts": _ATTACK_SEEDS}
+        for name in attack_fns
+    }
+    reference_successes = 0
+    reference_total_seconds = 0.0
+    reference_totals = {
+        "operations": 0,
+        "slopes_tested": 0,
+        "residual_evaluations": 0,
+        "row_comparisons": 0,
+    }
+    compact_successes = 0
+    compact_total_ops = 0
+    standard_successes = 0
+    standard_total_seconds = 0.0
+    standard_totals = {
+        "operations": 0,
+        "edge_scans": 0,
+        "queue_pops": 0,
+        "augmentations": 0,
+    }
+    for seed in range(_ATTACK_SEEDS):
+        inst = make_instance(seed=90_000 + seed, **shipping_params)
+        for name, attack in attack_fns.items():
+            candidate = attack(inst, 700_000 + seed)
+            if verify(inst, candidate)[0]:
+                attack_results[name]["successes"] += 1
+        t0 = time.perf_counter()
+        candidate, ops = _reference_algorithm(inst)
+        reference_total_seconds += time.perf_counter() - t0
+        for key in reference_totals:
+            reference_totals[key] += ops[key]
+        if candidate is not None and verify(inst, candidate)[0]:
+            reference_successes += 1
+        t0 = time.perf_counter()
+        days, domain_ops = _domain_standard_algorithm(inst)
+        standard_total_seconds += time.perf_counter() - t0
+        for key in standard_totals:
+            standard_totals[key] += domain_ops[key]
+        if days is not None and _verify_explicit_days(inst, days):
+            standard_successes += 1
+        compact_candidate, compact_ops = _compact_rule(inst)
+        compact_total_ops += compact_ops["total_operations"]
+        if verify(inst, compact_candidate)[0]:
+            compact_successes += 1
+    all_failed = all(result["successes"] == 0 for result in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": (
+            all_failed
+            and reference_successes == _ATTACK_SEEDS
+            and standard_successes == _ATTACK_SEEDS
+            and compact_successes == _ATTACK_SEEDS
+        ),
+        "attacks": attack_results,
+        "reference_algorithm": {
+            "name": "repeated Hopcroft--Karp perfect-matching extraction",
+            "complexity": "O(d*E*sqrt(V)) worst-case",
+            "wall_clock_sec": round(standard_total_seconds / _ATTACK_SEEDS, 6),
+            "operations": standard_totals["operations"] // _ATTACK_SEEDS,
+            "edge_scans": standard_totals["edge_scans"] // _ATTACK_SEEDS,
+            "queue_pops": standard_totals["queue_pops"] // _ATTACK_SEEDS,
+            "augmentations": standard_totals["augmentations"] // _ATTACK_SEEDS,
+            "solves": f"{standard_successes}/{_ATTACK_SEEDS}, as expected",
+        },
+        "certificate_recovery_algorithm": {
+            "name": "exhaustive affine-slope recovery with row-set comparison",
+            "complexity": "O(q^2*d*log d) worst-case exact",
+            "wall_clock_sec": round(reference_total_seconds / _ATTACK_SEEDS, 6),
+            "operations": reference_totals["operations"] // _ATTACK_SEEDS,
+            "slopes_tested": reference_totals["slopes_tested"] // _ATTACK_SEEDS,
+            "residual_evaluations": reference_totals["residual_evaluations"] // _ATTACK_SEEDS,
+            "row_comparisons": reference_totals["row_comparisons"] // _ATTACK_SEEDS,
+            "solves": f"{reference_successes}/{_ATTACK_SEEDS}, as expected",
+        },
+        "intended_compact_route": {
+            "name": "two-row neighbour-sum invariant",
+            "operations": compact_total_ops // _ATTACK_SEEDS,
+            "solves": f"{compact_successes}/{_ATTACK_SEEDS}, as expected",
+        },
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] = 2 * shipping_params["n"] + 1
+    t0 = time.perf_counter()
+    doubled = make_instance(seed=314159, **doubled_params)
+    doubled_build = time.perf_counter() - t0
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    escalated_params = escalate(shipping_params)
+    escalated_ok = False
+    if isinstance(escalated_params, dict):
+        escalated = make_instance(seed=271828, **escalated_params)
+        escalated_ok = verify(escalated, escalated["answer"])[0]
+    report["G7_scales"] = {
+        "pass": doubled_ok and escalated_ok and doubled["q"] > ship["q"],
+        "shipping_q": ship["q"],
+        "shipping_edges": ship["edge_count"],
+        "doubled_q": doubled["q"],
+        "doubled_edges": doubled["edge_count"],
+        "doubled_build_seconds": round(doubled_build, 6),
+        "doubled_verified": doubled_ok,
+        "answer_atoms_before": _answer_atoms(ship["answer"]),
+        "answer_atoms_after": _answer_atoms(doubled["answer"]),
+        "fixed_shape_escalation": escalated_params,
+        "escalated_verified": escalated_ok,
+    }
+
+    invariance = 0
+    carried = 0
+    keys = []
+    for seed in range(20):
+        inst = make_instance(seed=400_000 + seed, **shipping_params)
+        key = canonical_key(inst)
+        transformed, transformed_answer = _transform_for_g8(inst, inst["answer"], 500_000 + seed)
+        if canonical_key(transformed) == key:
+            invariance += 1
+        if verify(transformed, transformed_answer)[0]:
+            carried += 1
+        keys.append(key)
+    distinct = len(set(keys))
+    report["G8_canonical_key"] = {
+        "pass": invariance == 20 and carried == 20 and distinct == 20,
+        "invariance_passed": invariance,
+        "invariance_attempts": 20,
+        "carried_witnesses_verified": carried,
+        "carried_witness_attempts": 20,
+        "unrelated_distinct": distinct,
+        "unrelated_attempts": 20,
+        "transformations": [
+            "input-row permutation",
+            "neighbour-order permutation",
+            "independent affine residue-coordinate changes",
+            "bipartition swap",
+            "day permutation",
+        ],
+    }
+
+    answer_blob = json.dumps(ship["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _answer_atoms(ship["answer"])
+    _compact_candidate, compact_ops = _compact_rule(ship)
+    intended_ops = compact_ops["total_operations"]
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [
+        value for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    ]
+    report["all_passed"] = all(gate.get("pass") is True for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

