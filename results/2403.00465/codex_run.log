+
+    transform_modes = [
+        "row_order",
+        "neighbour_order",
+        "affine_coordinates",
+        "bipartition_swap",
+        "day_permutation",
+        "composed",
+    ]
+    invariance = 0
+    carried = 0
+    transform_attempts = 0
+    keys = []
+    for seed in range(20):
