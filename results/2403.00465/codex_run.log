+def _mul_linear(poly: list[int], root: int, p: int) -> list[int]:
+    """Return poly(z)*(z-root), coefficients in increasing degree."""
+    out = [0] * (len(poly) + 1)
+    for i, value in enumerate(poly):
+        out[i] = (out[i] - root * value) % p
+        out[i + 1] = (out[i + 1] + value) % p
+    return out
 
 
