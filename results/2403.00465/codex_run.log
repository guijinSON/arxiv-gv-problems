+def _reference_root_scan(inst: dict) -> dict:
+    """Successful mechanical Track-B algorithm with an operation counter."""
+    n, p = inst["n"], inst["p"]
+    rows = inst["coefficient_rows"]
+    operations = 0
+    inv_n = pow(n, -1, p)
+    slope = (-rows[n][1] * inv_n) % p
+    operations += 2
+    q = [rows[k][0] % p for k in range(n + 1)]
+    roots = []
+    for value in range(p):
+        total = 0
+        for coefficient in reversed(q):
+            total = (total * value + coefficient) % p
+            operations += 2
+        if total == 0:
+            roots.append(value)
+    root_set = set(roots)
+    candidate = None
+    if len(roots) == n:
+        for start in roots:
+            if candidate is not None:
+                break
+            for second in roots:
+                if second == start:
+                    continue
+                step = (second - start) % p
+                operations += 1
+                values = set()
+                current = start
+                for _ in range(n):
+                    values.add(current)
+                    current = (current + step) % p
+                    operations += 1
