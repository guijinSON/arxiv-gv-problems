+
+    transform_modes = [
+        "row_order",
+        "neighbour_order",
+        "affine_coordinates",
+        "bipartition_swap",
+        "day_permutation",
+        "composed",
+    ]
+    invariance = 0
+    carried = 0
+    transform_attempts = 0
+    keys = []
+    for seed in range(20):
+        inst = make_instance(seed=400_000 + seed, **shipping_params)
+        key = canonical_key(inst)
+        for mode_index, mode in enumerate(transform_modes):
+            transformed, transformed_answer = _transform_for_g8(
+                inst, inst["answer"], 500_000 + 100 * seed + mode_index, mode
+            )
+            transform_attempts += 1
+            if canonical_key(transformed) == key:
+                invariance += 1
+            if verify(transformed, transformed_answer)[0]:
+                carried += 1
+        keys.append(key)
+    distinct = len(set(keys))
+    report["G8_canonical_key"] = {
+        "pass": (
+            invariance == transform_attempts
+            and carried == transform_attempts
+            and distinct == 20
+        ),
+        "invariance_passed": invariance,
+        "invariance_attempts": transform_attempts,
+        "carried_witnesses_verified": carried,
+        "carried_witness_attempts": transform_attempts,
+        "unrelated_distinct": distinct,
+        "unrelated_attempts": 20,
+        "transformations": transform_modes,
+        "coverage": "each named symmetry and their full composition over 20 seeds",
+    }
+
+    answer_blob = json.dumps(ship["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _answer_atoms(ship["answer"])
+    _compact_candidate, compact_ops = _compact_rule(ship)
+    intended_ops = compact_ops["total_operations"]
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [
+        value for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    ]
+    report["all_passed"] = all(gate.get("pass") is True for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
