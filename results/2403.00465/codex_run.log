+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Expand and exactly check any affine schedule; never consult answer."""
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if set(answer) != {"rules"}:
+        return False, "answer must contain exactly the rules field"
+    rules = answer["rules"]
+    if not isinstance(rules, list) or len(rules) != inst["panel_count"]:
+        return False, f"rules must contain exactly {inst['panel_count']} panel rules"
+    for index, (panel, rule) in enumerate(zip(inst["panels"], rules)):
+        ok, reason = _verify_panel(inst["q"], inst["degree"], panel, rule)
+        if not ok:
+            return False, f"panel {index}: {reason}"
+    return True, "ok"
+
