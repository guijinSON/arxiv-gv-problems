"""Verified affine schedules for unweighted Polyamorous Scheduling.

The family uses the exact equivalence in Section 5, Proposition 5.1 of
arXiv:2403.00465: an unweighted schedule of heat d is a proper d-edge
colouring.  Generation samples an affine factorisation first and emits the
resulting regular bipartite polycule.  The answer is a compact symbolic
periodic schedule, not an edge list discovered by solving the emitted graph.

Generation is deterministic in ``(n, seed, params)``.  The module is standard
library only, performs no file I/O, and prints nothing on import.
"""

from __future__ import annotations

import copy
import hashlib
import itertools
import json
import math
import os
import random
import re
import time
from collections import deque
from typing import Any


TRACK = "B"

PROBLEM_PROFILE = {
    "native_domain": "combinatorics",
    "object_regime": "finite_discrete",
    "computational_core": "graph",
    "certificate_form": "exact_symbolic",
    "native_objects": [
        "unweighted bipartite polycule",
        "periodic schedule of matchings",
        "affine congruence schedule rule",
    ],
    "verification_operations": [
        "exact modular evaluation",
        "matching incidence scan",
        "cyclic recurrence-time comparison",
    ],
    "domain_essentiality": "native",
    "reduction_kind": "paper_licensed",
    "reduction": (
        "Lemma 2.1 and Section 5, Proposition 5.1 (Unweighted OPS = edge "
        "coloring): a proper d-edge-colouring is exactly a period-d "
        "unweighted schedule of heat d, equivalently a frequency-d DPS schedule"
    ),
    "reduction_source": "paper_central",
    "intuition_type": "invariant",
    "intuition_description": (
        "The sum of the right-neighbour residues is affine in the left "
        "residue; without recognizing that invariant, a solver must test "
        "many possible modular slopes or execute an edge-colouring routine."
    ),
    "hardness_basis": (
        "Track B: at shipping p=5,q=211,d=8, repeated Hopcroft--Karp "
        "perfect-matching extraction (O(p*d*E*sqrt(V))) averaged 178,542 "
        "operations/0.133 s and exhaustive affine recovery "
        "(O(p*q^2*d*log d)) averaged 20,255 operations/0.027 s over eight "
        "seeds, versus 244 operations for the neighbour-sum invariant."
    ),
    "max_answer_tokens": 84,
}

NATIVE = {
    "domain": PROBLEM_PROFILE["native_domain"],
    "core": PROBLEM_PROFILE["computational_core"],
    "objects": list(PROBLEM_PROFILE["native_objects"]),
    "intuition": (
        PROBLEM_PROFILE["intuition_type"]
        + ": "
        + PROBLEM_PROFILE["intuition_description"]
    ),
    "reduction": PROBLEM_PROFILE["reduction"],
}

DIFFICULTY = {
    "demo": {"n": 5, "degree": 2, "panels": 1},
    "easy": {"n": 101, "degree": 5, "panels": 4},
    "medium": {"n": 151, "degree": 7, "panels": 5},
    "hard": {"n": 211, "degree": 8, "panels": 5},
}
SHIPPING_DIFFICULTY = "hard"

STRUCTURAL_HINT = (
    "Across left vertices, the sum of the right-neighbour labels is an affine "
    "function modulo q."
)
PLACEBO_HINT = (
    "Across all vertices, careful bookkeeping of the labels and day order is "
    "important here."
)

CERTIFICATE_LANGUAGE = {
    "description": (
        "A JSON object with one rule {period:d,a:a,offsets:[b_0,...]} per "
        "panel; period is fixed to d, 1<=a<q, and each offsets list is an "
        "ordered list of d distinct integers in 0..q-1.  Day j contains "
        "exactly edges with y-a*x=b_j modulo q."
    ),
    "bounds": {
        "period": "instance degree d",
        "slope_min": 1,
        "slope_max": "q-1",
        "offset_count": "d",
        "offset_min": 0,
        "offset_max": "q-1",
        "offsets_distinct": True,
        "rule_count": "instance panel count",
    },
}

NOTES = r"""
Step 0.  Section 1.1 (Formal Problem Statement) fixes DPS as an undirected
frequency-labelled graph whose daily edge sets are matchings and whose every
length-f(e) window contains e.  Section 1.1 notes that finite periodic schedules
exist whenever schedules exist, but Section 4 gives only a single-exponential
configuration-graph decision algorithm and places the general problem in
PSPACE; short NP certificates are not known.  Those facts make an arbitrary
planted deadline graph unsafe.

The chosen object comes from Section 5, Proposition 5.1.  In an unweighted OPS
instance a heat-d schedule exists exactly when the graph is d-edge-colourable.
By Lemma 2.1, the same period-d colouring is a DPS schedule when every
frequency is d.  The
paper's hardness theorem comes from 3-regular chromatic index, but it is only a
worst-case statement and says nothing about this generated distribution.
Bipartite edge colouring is polynomial, and this affine subfamily is easier
still, so declaring Track A would be false.  This module is explicitly Track B.

Certificate production.  In every disjoint panel choose a prime q, a nonzero
slope a, and d distinct offsets B before emitting any edge.  For every x in
Z/qZ emit the d edges L_x--R_(a*x+b), b in B.  For a fixed b this is a perfect
matching because a is nonzero; the d matchings partition all edges.  Combining
the same-numbered matching from each disjoint panel gives a period-d schedule
meeting every frequency-d deadline.  Generation therefore knows the symbolic
schedule by inverse generation.  The verifier independently expands every
rule, checks exact edge coverage and matching incidence, and checks the
recurrence bound.  It never reads answer.

Easy and mechanical routes.  Misra--Gries gives a polynomial (Delta+1)-edge
colouring for general graphs, and regular bipartite graphs admit exact Delta
edge colourings by repeated perfect matching extraction.  For the certificate
language used here, a direct exhaustive algorithm derives the offset set from
one row for each of q-1 slopes and compares rows until one works.  Its measured
cost is the Track-B reference baseline.  The compact route instead observes
sum N(x)=d*a*x+sum(B) mod q; two displayed rows determine a, after which one
row determines B.

Adversaries.  Slopes 1 and the first small slopes are excluded from the planted
distribution; endpoint order is independently shuffled; the first edges of
the first two rows use different offsets; and the first two row minima are
chosen not to align under the true translation.  Thus identity residues,
single-edge extrapolation, a greedy minimum-neighbour translation, a small
slope scan, and uniform bounded random restarts all fail in the audited panel.
All graph edges still come from one distribution--there are no planted-edge
and decoy-edge populations.

Canonicalization.  Coordinates are part of the symbolic scheduling instance,
while row order, neighbour order, affine changes of the left and right residue
coordinates, swapping the bipartition, permuting panels, and permuting days are presentation
symmetries.  The key recovers the offset set from graph data (not answer), then
normalizes it under every affine map b -> u*b+t.  G8 composes all of the named
symmetries and carries the witness through them.
""".strip()


_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
_ENUMERATION_CAP = 300_000
_G4_SAMPLES = 200_000
_ATTACK_SEEDS = 8

# Populated after the script-owned bare/hinted/placebo runs.  The arms are
# diagnostic only; G9(c)'s output and operation caps are the gate.
G9_ORACLE_RESULTS = {
    "bare": {"solved": 0, "attempts": 0, "error_attempts": 4},
        "answer_atoms_after": _answer_atoms(doubled["answer"]),
        "fixed_shape_escalation": escalated_params,
        "escalated_verified": escalated_ok,
    }

    transform_modes = [
        "row_order",
        "neighbour_order",
        "affine_coordinates",
        "bipartition_swap",
        "day_permutation",
        "panel_order",
        "composed",
    ]
    invariance = 0
    carried = 0
    transform_attempts = 0
    keys = []
    for seed in range(20):
        inst = make_instance(seed=400_000 + seed, **shipping_params)
        key = canonical_key(inst)
        for mode_index, mode in enumerate(transform_modes):
            transformed, transformed_answer = _transform_for_g8(
                inst, inst["answer"], 500_000 + 100 * seed + mode_index, mode
            )
            transform_attempts += 1
            if canonical_key(transformed) == key:
                invariance += 1
            if verify(transformed, transformed_answer)[0]:
                carried += 1
        keys.append(key)
    distinct = len(set(keys))
    report["G8_canonical_key"] = {
        "pass": (
            invariance == transform_attempts
            and carried == transform_attempts
            and distinct == 20
        ),
        "invariance_passed": invariance,
        "invariance_attempts": transform_attempts,
        "carried_witnesses_verified": carried,
        "carried_witness_attempts": transform_attempts,
        "unrelated_distinct": distinct,
        "unrelated_attempts": 20,
        "transformations": transform_modes,
        "coverage": "each named symmetry and their full composition over 20 seeds",
    }

    answer_blob = json.dumps(ship["answer"], separators=(",", ":"))
    answer_chars = len(answer_blob)
    answer_tokens = (answer_chars + 3) // 4
    answer_elements = _answer_atoms(ship["answer"])
    _compact_candidate, compact_ops = _compact_rule(ship)
    intended_ops = compact_ops["total_operations"]
    arms = {
        name: dict(G9_ORACLE_RESULTS[name])
        for name in ("bare", "hinted", "placebo")
    }
    if arms["hinted"]["attempts"] and arms["placebo"]["attempts"]:
        hinted_minus_placebo = (
            arms["hinted"]["solved"] / arms["hinted"]["attempts"]
            - arms["placebo"]["solved"] / arms["placebo"]["attempts"]
        )
    else:
        hinted_minus_placebo = None
    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
    report["G9_no_tool_suitability"] = {
        "pass": within_caps,
        "arms": arms,
        "hinted_minus_placebo": hinted_minus_placebo,
        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
        "answer_chars": answer_chars,
        "answer_tokens": answer_tokens,
        "answer_elements": answer_elements,
        "worst_case_answer_chars": 336,
        "worst_case_answer_tokens": 84,
        "intended_route_operations": intended_ops,
        "caps": {"chars": 2000, "elements": 256, "operations": 300},
    }

    gates = [
        value for key, value in report.items()
        if key.startswith("G") and isinstance(value, dict)
    ]
    report["all_passed"] = all(gate.get("pass") is True for gate in gates)
    return report


if __name__ == "__main__":
    print(json.dumps(selftest(), indent=2, sort_keys=True))

