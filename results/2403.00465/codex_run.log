+def escalate(params: dict) -> dict | str | None:
+    """Grow the residue ground set while keeping d+2 answer atoms fixed."""
+    out = {key: value for key, value in params.items() if key != "_preset"}
+    current = int(out.get("n", 101))
+    out["n"] = 2 * current + 1
+    return out
