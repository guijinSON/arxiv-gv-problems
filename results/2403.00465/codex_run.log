+    dropped["rules"].pop()
+    corruptions.append(("drop", dropped))
+    swapped = copy.deepcopy(ship["answer"])
+    swapped["rules"][0]["period"], swapped["rules"][0]["a"] = (
+        swapped["rules"][0]["a"], swapped["rules"][0]["period"]
+    )
+    corruptions.append(("swap", swapped))
