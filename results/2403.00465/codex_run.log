+    reference_successes = 0
+    reference_total_seconds = 0.0
+    reference_totals = {
+        "operations": 0,
+        "slopes_tested": 0,
+        "residual_evaluations": 0,
+        "row_comparisons": 0,
+    }
+    compact_successes = 0
+    compact_total_ops = 0
+    standard_successes = 0
+    standard_total_seconds = 0.0
+    standard_totals = {
+        "operations": 0,
+        "edge_scans": 0,
+        "queue_pops": 0,
+        "augmentations": 0,
+    }
+    for seed in range(_ATTACK_SEEDS):
+        inst = make_instance(seed=90_000 + seed, **shipping_params)
+        for name, attack in attack_fns.items():
+            candidate = attack(inst, 700_000 + seed)
+            if verify(inst, candidate)[0]:
+                attack_results[name]["successes"] += 1
+        t0 = time.perf_counter()
+        candidate, ops = _reference_algorithm(inst)
+        reference_total_seconds += time.perf_counter() - t0
+        for key in reference_totals:
+            reference_totals[key] += ops[key]
+        if candidate is not None and verify(inst, candidate)[0]:
+            reference_successes += 1
+        t0 = time.perf_counter()
+        days, domain_ops = _domain_standard_algorithm(inst)
+        standard_total_seconds += time.perf_counter() - t0
+        for key in standard_totals:
+            standard_totals[key] += domain_ops[key]
+        if days is not None and _verify_explicit_days(inst, days):
+            standard_successes += 1
+        compact_candidate, compact_ops = _compact_rule(inst)
+        compact_total_ops += compact_ops["total_operations"]
+        if verify(inst, compact_candidate)[0]:
+            compact_successes += 1
+    all_failed = all(result["successes"] == 0 for result in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": (
+            all_failed
+            and reference_successes == _ATTACK_SEEDS
+            and standard_successes == _ATTACK_SEEDS
+            and compact_successes == _ATTACK_SEEDS
+        ),
+        "attacks": attack_results,
+        "reference_algorithm": {
+            "name": "repeated Hopcroft--Karp perfect-matching extraction",
+            "complexity": "O(d*E*sqrt(V)) worst-case",
+            "wall_clock_sec": round(standard_total_seconds / _ATTACK_SEEDS, 6),
+            "operations": standard_totals["operations"] // _ATTACK_SEEDS,
+            "edge_scans": standard_totals["edge_scans"] // _ATTACK_SEEDS,
+            "queue_pops": standard_totals["queue_pops"] // _ATTACK_SEEDS,
+            "augmentations": standard_totals["augmentations"] // _ATTACK_SEEDS,
+            "solves": f"{standard_successes}/{_ATTACK_SEEDS}, as expected",
+        },
+        "certificate_recovery_algorithm": {
+            "name": "exhaustive affine-slope recovery with row-set comparison",
+            "complexity": "O(q^2*d*log d) worst-case exact",
+            "wall_clock_sec": round(reference_total_seconds / _ATTACK_SEEDS, 6),
+            "operations": reference_totals["operations"] // _ATTACK_SEEDS,
+            "slopes_tested": reference_totals["slopes_tested"] // _ATTACK_SEEDS,
+            "residual_evaluations": reference_totals["residual_evaluations"] // _ATTACK_SEEDS,
+            "row_comparisons": reference_totals["row_comparisons"] // _ATTACK_SEEDS,
+            "solves": f"{reference_successes}/{_ATTACK_SEEDS}, as expected",
+        },
+        "intended_compact_route": {
