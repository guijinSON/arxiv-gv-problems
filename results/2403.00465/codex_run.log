def _minimum_translation_slope(q: int, row0: dict, row1: dict) -> int:
    dx = (row1["x"] - row0["x"]) % q
    dy = (min(row1["neighbors"]) - min(row0["neighbors"])) % q
    return dy * _inverse(dx, q) % q


def _make_panel(q: int, degree: int, rng: random.Random) -> tuple[dict, dict]:
    """Build one component after its affine schedule rule has been sampled."""
    # Avoid only the explicitly audited tiny-slope ansatz at non-demo sizes.
    slope_low = 33 if q > 67 else 2
    slope = rng.randrange(slope_low, q - 1)
    offsets = rng.sample(range(1, q), degree)

    # Row order is presentation only.  Put a pair first for which aligning the
    # numerical minima is not the true group translation.
    x_order = list(range(q))
    rng.shuffle(x_order)
    first = x_order[0]
    partner_index = None
    first_row_sorted = {
        "x": first,
        "neighbors": _neighbors(q, degree, slope, offsets, first),
    }
    for index in range(1, len(x_order)):
        second = x_order[index]
        second_row_sorted = {
            "x": second,
            "neighbors": _neighbors(q, degree, slope, offsets, second),
        }
        if _minimum_translation_slope(q, first_row_sorted, second_row_sorted) != slope:
            partner_index = index
            break
    if partner_index is None:  # impossible for the supported nontrivial sets
        raise RuntimeError("could not choose a non-greedy row presentation")
    x_order[1], x_order[partner_index] = x_order[partner_index], x_order[1]

    rows = []
    first_offset_used = None
    for position, x in enumerate(x_order):
        order = list(offsets)
        rng.shuffle(order)
        if position == 0:
            first_offset_used = order[0]
        elif position == 1 and order[0] == first_offset_used:
            order[0], order[1] = order[1], order[0]
        rows.append({
            "x": x,
            "neighbors": _neighbors(q, degree, slope, order, x),
        })

    answer_offsets = list(offsets)
    rng.shuffle(answer_offsets)
    return {
        "rows": rows,
        "edge_count": q * degree,
    }, {
        "period": degree,
        "a": slope,
        "offsets": answer_offsets,
    }


def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
    """Inverse-generate disjoint regular bipartite components and witnesses."""
    if isinstance(n, bool) or not isinstance(n, int) or n < 5:
        raise ValueError("n must be an integer at least 5")
    if isinstance(seed, bool) or not isinstance(seed, int):
        raise ValueError("seed must be an integer")
    degree = params.pop("degree", 6)
    panel_count = params.pop("panels", 4)
    if params:
        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
    q = _next_prime(n)
    if isinstance(degree, bool) or not isinstance(degree, int):
        raise ValueError("degree must be an integer")
    if degree < 2 or degree >= q - 1 or degree > 12:
        raise ValueError("degree must lie in 2..min(12,q-2)")
    if isinstance(panel_count, bool) or not isinstance(panel_count, int) or not (1 <= panel_count <= 6):
        raise ValueError("panels must be an integer in 1..6")
    rng = random.Random(seed)
    built = [_make_panel(q, degree, rng) for _ in range(panel_count)]
    panels = [panel for panel, _rule in built]
    rules = [rule for _panel, rule in built]
    return {
        "paper": "2403.00465",
        "problem": "affine unweighted polyamorous schedule",
        "requested_n": n,
        "q": q,
        "degree": degree,
        "panel_count": panel_count,
        "period": degree,
        "frequency": degree,
        "edge_count": panel_count * q * degree,
        "panels": panels,
        "answer": {"rules": rules},
    }


def render(inst: dict) -> str:
