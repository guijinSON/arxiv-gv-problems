        \node[graph node] (H) at (-0.707, -1.707) {H};

        \path[-] (A) edge[std, C2] (B);
        \path[-] (B) edge[std, C3] (C);
        \path[-] (H) edge[std, C1] (G);
        \path[-] (A) edge[std, C3] (H);
        \path[-] (C) edge[std, C2] (E);
        \path[-] (C) edge[std, C1] (D);
