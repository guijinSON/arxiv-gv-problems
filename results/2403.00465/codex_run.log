+    partner_index = None
+    first_row_sorted = {
+        "x": first,
+        "neighbors": _neighbors(q, degree, slope, offsets, first),
+    }
+    for index in range(1, len(x_order)):
+        second = x_order[index]
+        second_row_sorted = {
+            "x": second,
+            "neighbors": _neighbors(q, degree, slope, offsets, second),
+        }
+        if _minimum_translation_slope(q, first_row_sorted, second_row_sorted) != slope:
+            partner_index = index
+            break
+    if partner_index is None:  # impossible for the supported nontrivial sets
+        raise RuntimeError("could not choose a non-greedy row presentation")
+    x_order[1], x_order[partner_index] = x_order[partner_index], x_order[1]
+
+    rows = []
+    first_offset_used = None
+    for position, x in enumerate(x_order):
+        order = list(offsets)
+        rng.shuffle(order)
+        if position == 0:
+            first_offset_used = order[0]
+        elif position == 1 and order[0] == first_offset_used:
+            order[0], order[1] = order[1], order[0]
+        rows.append({
+            "x": x,
+            "neighbors": _neighbors(q, degree, slope, order, x),
+        })
+
+    answer_offsets = list(offsets)
+    rng.shuffle(answer_offsets)
+    return {
+        "paper": "2403.00465",
+        "problem": "affine unweighted polyamorous schedule",
+        "requested_n": n,
+        "q": q,
+        "degree": degree,
+        "period": degree,
+        "frequency": degree,
+        "edge_count": q * degree,
+        "rows": rows,
+        "answer": {
+            "period": degree,
+            "a": slope,
+            "offsets": answer_offsets,
+        },
+    }
+
+
+def render(inst: dict) -> str:
+    q = inst["q"]
+    degree = inst["degree"]
+    lines = [
+        "Find a compact periodic schedule for an unweighted polyamorous polycule.",
+        "",
+        f"There are two sets of people L_x and R_y, where x,y are the residues 0,...,{q - 1} modulo the prime q={q}.",
+        "A relationship is one listed pair L_x--R_y.  No other relationships exist.",
+        f"Every relationship has frequency {degree}: in every {degree} consecutive days, including windows crossing the period boundary, it must be scheduled at least once.",
+        "A day's meetings are legal exactly when no person occurs in two relationships that day (the relationships form a matching).",
+        f"Your schedule must have period exactly {degree}; day numbers are 0,...,{degree - 1} and then repeat forever.",
+        "",
+        "Relationships, given as one adjacency row per left person (row order and neighbour order carry no meaning):",
+    ]
+    for row in inst["rows"]:
+        neighbors = " ".join(f"R_{y}" for y in row["neighbors"])
+        lines.append(f"  L_{row['x']}: {neighbors}")
+    lines.extend([
+        "",
+        "Return the schedule as one affine congruence rule in JSON:",
+        f"  {{\"period\":{degree},\"a\":a,\"offsets\":[b_0,...,b_{degree - 1}]}}",
+        f"Here a is an integer in 1..{q - 1}; the offsets are exactly {degree} distinct integers in 0..{q - 1}, and their order is significant only as the numbering of days.",
+        "On every day congruent to j modulo period, your rule schedules exactly the listed relationships L_x--R_y satisfying y-a*x = b_j (mod q).",
+        "The rule is valid only if these days partition every listed relationship, every day is a matching, and every frequency bound is met.  Ordinary integer representatives in the stated inclusive ranges are required; no repeats or omitted offsets are allowed.",
+        "",
+        "Give your final answer inside <answer></answer> tags, as the JSON object just specified.",
+        f"Example format: <answer>{{\"period\":{degree},\"a\":1,\"offsets\":[{','.join(str(i) for i in range(degree))}]}}</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: object) -> object | None:
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    body = match.group(1).strip()
+    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
+    if fence:
+        body = fence.group(1).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Expand and exactly check any affine schedule; never consult answer."""
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if set(answer) != {"period", "a", "offsets"}:
+        return False, "answer must contain exactly period, a, and offsets"
+    q = inst["q"]
+    degree = inst["degree"]
+    period = answer["period"]
+    if isinstance(period, bool) or not isinstance(period, int) or period != degree:
+        return False, f"period must equal {degree}"
+    slope = answer["a"]
+    if isinstance(slope, bool) or not isinstance(slope, int) or not (1 <= slope < q):
+        return False, f"a must be an integer in 1..{q - 1}"
+    offsets = answer["offsets"]
+    if not isinstance(offsets, list) or len(offsets) != degree:
+        return False, f"offsets must contain exactly {degree} integers"
+    if any(isinstance(v, bool) or not isinstance(v, int) or not (0 <= v < q) for v in offsets):
+        return False, f"every offset must be an integer in 0..{q - 1}"
+    if len(set(offsets)) != degree:
+        return False, "offsets must be pairwise distinct"
+
+    offset_to_day = {value: day for day, value in enumerate(offsets)}
+    seen_x = set()
+    right_seen = [set() for _ in range(degree)]
+    edge_total = 0
+    for row in inst["rows"]:
+        x = row.get("x")
+        neighbors = row.get("neighbors")
+        if not isinstance(x, int) or not (0 <= x < q) or x in seen_x:
+            return False, "instance has malformed or repeated left labels"
+        seen_x.add(x)
+        if not isinstance(neighbors, list) or len(neighbors) != degree or len(set(neighbors)) != degree:
+            return False, f"instance row L_{x} is not degree {degree}"
+        row_days = set()
+        for y in neighbors:
+            if not isinstance(y, int) or not (0 <= y < q):
+                return False, f"instance row L_{x} has an invalid right label"
+            residue = (y - slope * x) % q
+            if residue not in offset_to_day:
+                return False, f"affine rule omits relationship L_{x}--R_{y}"
+            day = offset_to_day[residue]
+            if day in row_days:
+                return False, f"day {day} repeats left person L_{x}"
+            if y in right_seen[day]:
+                return False, f"day {day} repeats right person R_{y}"
+            row_days.add(day)
+            right_seen[day].add(y)
+            edge_total += 1
+        if len(row_days) != degree:
+            return False, f"row L_{x} is not partitioned among all days"
+    if len(seen_x) != q or edge_total != inst["edge_count"]:
+        return False, "affine rule does not cover the complete instance"
+    if any(len(day_right) != q for day_right in right_seen):
+        return False, "at least one day is not a perfect matching"
+    # Every edge occurs exactly once per period=frequency, so every closed
+    # cyclic window of that many consecutive days contains it.
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    q = inst["q"]
+    degree = inst["degree"]
+    return {
+        "period": degree,
+        "a": rng.randrange(1, q),
+        "offsets": rng.sample(range(q), degree),
+    }
+
+
+def search_space(inst: dict) -> int:
+    q = inst["q"]
+    degree = inst["degree"]
+    ordered_offsets = 1
+    for i in range(degree):
+        ordered_offsets *= q - i
+    return (q - 1) * ordered_offsets
+
+
+def enumerate_all(inst: dict) -> int | None:
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    q = inst["q"]
+    degree = inst["degree"]
+    count = 0
+    for slope in range(1, q):
+        for offsets in itertools.permutations(range(q), degree):
+            candidate = {"period": degree, "a": slope, "offsets": list(offsets)}
+            if verify(inst, candidate)[0]:
+                count += 1
+    return count
+
+
+def _compact_rule(inst: dict) -> tuple[dict, dict[str, int]]:
+    """Use the intended two-row sum invariant, with operation accounting."""
+    q = inst["q"]
+    degree = inst["degree"]
+    row0, row1 = inst["rows"][:2]
+    sum0 = sum(row0["neighbors"]) % q
+    sum1 = sum(row1["neighbors"]) % q
+    denominator = degree * ((row1["x"] - row0["x"]) % q) % q
+    inverse, divisions = _inverse_counted(denominator, q)
+    slope = (sum1 - sum0) * inverse % q
+    offsets = sorted((y - slope * row0["x"]) % q for y in row0["neighbors"])
+    arithmetic = 2 * (degree - 1) + 5 + 3 * degree
+    return {"period": degree, "a": slope, "offsets": offsets}, {
+        "arithmetic_operations": arithmetic,
+        "euclidean_divisions": divisions,
+        "total_operations": arithmetic + divisions,
+    }
+
+
+def _reference_algorithm(inst: dict) -> tuple[object | None, dict[str, int]]:
+    """Promise-oblivious exhaustive recovery over every nonzero slope."""
+    q = inst["q"]
+    degree = inst["degree"]
+    rows = inst["rows"]
+    residual_evaluations = 0
+    row_comparisons = 0
+    slopes_tested = 0
+    for slope in range(1, q):
+        slopes_tested += 1
+        first = tuple(sorted((y - slope * rows[0]["x"]) % q for y in rows[0]["neighbors"]))
+        residual_evaluations += degree
+        matched = True
+        for row in rows[1:]:
+            residues = tuple(sorted((y - slope * row["x"]) % q for y in row["neighbors"]))
+            residual_evaluations += degree
+            row_comparisons += 1
+            if residues != first:
+                matched = False
+                break
+        if matched:
+            candidate = {"period": degree, "a": slope, "offsets": list(first)}
+            if verify(inst, candidate)[0]:
+                return candidate, {
+                    "slopes_tested": slopes_tested,
+                    "residual_evaluations": residual_evaluations,
+                    "row_comparisons": row_comparisons,
+                    "operations": residual_evaluations + row_comparisons,
+                }
+    return None, {
+        "slopes_tested": slopes_tested,
+        "residual_evaluations": residual_evaluations,
+        "row_comparisons": row_comparisons,
+        "operations": residual_evaluations + row_comparisons,
+    }
+
+
+def _rule_from_slope(inst: dict, slope: int) -> dict:
+    q = inst["q"]
+    degree = inst["degree"]
+    row = inst["rows"][0]
+    offsets = sorted((y - slope * row["x"]) % q for y in row["neighbors"])
+    return {"period": degree, "a": slope, "offsets": offsets}
+
+
+def _identity_residue_attack(inst: dict) -> dict:
+    return _rule_from_slope(inst, 1)
+
+
+def _single_edge_extrapolation_attack(inst: dict) -> dict:
+    q = inst["q"]
+    row0, row1 = inst["rows"][:2]
+    dx = (row1["x"] - row0["x"]) % q
+    dy = (row1["neighbors"][0] - row0["neighbors"][0]) % q
+    slope = dy * _inverse(dx, q) % q
+    if slope == 0:
+        slope = 1
+    return _rule_from_slope(inst, slope)
+
+
+def _greedy_minimum_attack(inst: dict) -> dict:
+    q = inst["q"]
+    slope = _minimum_translation_slope(q, inst["rows"][0], inst["rows"][1])
+    if slope == 0:
+        slope = 1
+    return _rule_from_slope(inst, slope)
+
+
+def _small_slope_scan_attack(inst: dict, limit: int = 16) -> dict:
+    last = _rule_from_slope(inst, 1)
+    for slope in range(1, min(inst["q"], limit + 1)):
+        last = _rule_from_slope(inst, slope)
+        if verify(inst, last)[0]:
+            return last
+    return last
+
+
+def _random_restart_attack(inst: dict, seed: int, restarts: int = 256) -> object:
+    rng = random.Random(seed)
+    last = None
+    for _ in range(restarts):
+        last = random_candidate(inst, rng)
+        if verify(inst, last)[0]:
+            return last
+    return last
+
+
+def _recover_offsets(inst: dict) -> tuple[int, list[int]]:
+    candidate, _ = _compact_rule(inst)
+    return candidate["a"], sorted(candidate["offsets"])
+
+
+def _canonical_offset_orbit(q: int, offsets: list[int]) -> tuple[int, ...]:
+    best = None
+    for scale in range(1, q):
+        scaled = [(scale * value) % q for value in offsets]
+        for anchor in scaled:
+            candidate = tuple(sorted((value - anchor) % q for value in scaled))
+            if best is None or candidate < best:
+                best = candidate
+    if best is None:
+        raise ValueError("empty offset set")
+    return best
+
+
+def canonical_key(inst: dict) -> str:
+    """Normalize graph data under all declared coordinate relabellings."""
+    _slope, offsets = _recover_offsets(inst)
+    payload = [
+        inst["q"],
+        inst["degree"],
+        list(_canonical_offset_orbit(inst["q"], offsets)),
+    ]
+    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode("ascii")).hexdigest()
+
+
+def _transform_for_g8(inst: dict, answer: dict, seed: int) -> tuple[dict, dict]:
+    """Compose affine coordinate changes, optional side swap, and reorderings."""
+    out = copy.deepcopy(inst)
+    carried = copy.deepcopy(answer)
+    rng = random.Random(seed)
+    q = out["q"]
+    u = rng.randrange(1, q)
+    v = rng.randrange(1, q)
+    s = rng.randrange(q)
+    t = rng.randrange(q)
+    new_rows = []
+    for row in out["rows"]:
+        new_rows.append({
+            "x": (u * row["x"] + s) % q,
+            "neighbors": [(v * y + t) % q for y in row["neighbors"]],
+        })
+    a2 = v * carried["a"] * _inverse(u, q) % q
+    b2 = [(v * b + t - a2 * s) % q for b in carried["offsets"]]
+    carried = {"period": out["degree"], "a": a2, "offsets": b2}
+
+    if seed % 2:
+        swapped = {y: [] for y in range(q)}
+        for row in new_rows:
+            for y in row["neighbors"]:
+                swapped[y].append(row["x"])
+        new_rows = [{"x": y, "neighbors": xs} for y, xs in swapped.items()]
+        inv_a = _inverse(carried["a"], q)
+        carried = {
+            "period": out["degree"],
+            "a": inv_a,
+            "offsets": [(-inv_a * b) % q for b in carried["offsets"]],
+        }
+
+    rng.shuffle(new_rows)
+    for row in new_rows:
+        rng.shuffle(row["neighbors"])
+    rng.shuffle(carried["offsets"])
+    out["rows"] = new_rows
+    return out, carried
+
+
