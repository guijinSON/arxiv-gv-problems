+def _unit_step_candidate(inst: dict) -> dict:
+    n, p = inst["n"], inst["p"]
+    rows = inst["coefficient_rows"]
+    inv_n = pow(n, -1, p)
+    slope = (-rows[n][1] * inv_n) % p
+    root_sum = (-rows[n - 1][0]) % p
+    start = (root_sum - n * (n - 1) // 2) * inv_n % p
+    return _candidate_from_values(slope, start, 1)
 
 
