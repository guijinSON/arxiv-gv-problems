[ $? -eq 0 ] || { echo "SUBMIT BLOCKED — fix the module first."; exit 3; }

rm -f "$D/.orkey" "$D/.task.md" "$D/.runner.sh"; rm -rf "$D/__pycache__"
echo "== emitting sample instances =="
