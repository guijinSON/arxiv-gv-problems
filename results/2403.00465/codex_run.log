+        for start in roots:
+            if candidate is not None:
+                break
+            for second in roots:
+                if second == start:
+                    continue
+                step = (second - start) % p
+                operations += 1
+                values = set()
+                current = start
+                for _ in range(n):
+                    values.add(current)
