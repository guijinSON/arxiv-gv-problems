+"""Verified affine schedules for unweighted Polyamorous Scheduling.
+
+The family uses the exact equivalence in Section 5, Proposition 5.1 of
+arXiv:2403.00465: an unweighted schedule of heat d is a proper d-edge
+colouring.  Generation samples an affine factorisation first and emits the
+resulting regular bipartite polycule.  The answer is a compact symbolic
+periodic schedule, not an edge list discovered by solving the emitted graph.
+
+Generation is deterministic in ``(n, seed, params)``.  The module is standard
+library only, performs no file I/O, and prints nothing on import.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import deque
+from typing import Any
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "unweighted bipartite polycule",
+        "periodic schedule of matchings",
+        "affine congruence schedule rule",
+    ],
+    "verification_operations": [
+        "exact modular evaluation",
+        "matching incidence scan",
+        "cyclic recurrence-time comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Lemma 2.1 and Section 5, Proposition 5.1 (Unweighted OPS = edge "
+        "coloring): a proper d-edge-colouring is exactly a period-d "
+        "unweighted schedule of heat d, equivalently a frequency-d DPS schedule"
+    ),
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The sum of the right-neighbour residues is affine in the left "
+        "residue; without recognizing that invariant, a solver must test "
+        "many possible modular slopes or execute an edge-colouring routine."
+    ),
+    "hardness_basis": (
+        "Track B: at shipping p=5,q=211,d=8, repeated Hopcroft--Karp "
+        "perfect-matching extraction (O(p*d*E*sqrt(V))) averaged 178,542 "
+        "operations/0.240 s and exhaustive affine recovery "
+        "(O(p*q^2*d*log d)) averaged 20,255 operations/0.063 s over eight "
+        "seeds, versus 244 operations for the neighbour-sum invariant."
+    ),
+    "max_answer_tokens": 84,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
