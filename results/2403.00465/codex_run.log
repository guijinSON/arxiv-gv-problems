        return False, f"period must equal {degree}"
    slope = answer["a"]
    if isinstance(slope, bool) or not isinstance(slope, int) or not (1 <= slope < q):
        return False, f"a must be an integer in 1..{q - 1}"
    offsets = answer["offsets"]
    if not isinstance(offsets, list) or len(offsets) != degree:
        return False, f"offsets must contain exactly {degree} integers"
    if any(isinstance(v, bool) or not isinstance(v, int) or not (0 <= v < q) for v in offsets):
        return False, f"every offset must be an integer in 0..{q - 1}"
    if len(set(offsets)) != degree:
        return False, "offsets must be pairwise distinct"

    offset_to_day = {value: day for day, value in enumerate(offsets)}
    seen_x = set()
    right_seen = [set() for _ in range(degree)]
    edge_total = 0
    for row in panel["rows"]:
        x = row.get("x")
        neighbors = row.get("neighbors")
        if not isinstance(x, int) or not (0 <= x < q) or x in seen_x:
            return False, "instance has malformed or repeated left labels"
        seen_x.add(x)
        if not isinstance(neighbors, list) or len(neighbors) != degree or len(set(neighbors)) != degree:
            return False, f"instance row L_{x} is not degree {degree}"
        row_days = set()
        for y in neighbors:
            if not isinstance(y, int) or not (0 <= y < q):
                return False, f"instance row L_{x} has an invalid right label"
            residue = (y - slope * x) % q
            if residue not in offset_to_day:
                return False, f"affine rule omits relationship L_{x}--R_{y}"
            day = offset_to_day[residue]
            if day in row_days:
                return False, f"day {day} repeats left person L_{x}"
            if y in right_seen[day]:
                return False, f"day {day} repeats right person R_{y}"
            row_days.add(day)
            right_seen[day].add(y)
            edge_total += 1
        if len(row_days) != degree:
            return False, f"row L_{x} is not partitioned among all days"
    if len(seen_x) != q or edge_total != panel["edge_count"]:
        return False, "affine rule does not cover the complete panel"
    if any(len(day_right) != q for day_right in right_seen):
        return False, "at least one day is not a perfect matching"
    # Every edge occurs exactly once per period=frequency, so every closed
    # cyclic window of that many consecutive days contains it.
    return True, "ok"


def verify(inst: dict, answer: object) -> tuple[bool, str]:
    """Expand and exactly check any affine schedule; never consult answer."""
    if not isinstance(answer, dict):
        return False, "answer must be a JSON object"
    if set(answer) != {"rules"}:
        return False, "answer must contain exactly the rules field"
    rules = answer["rules"]
    if not isinstance(rules, list) or len(rules) != inst["panel_count"]:
        return False, f"rules must contain exactly {inst['panel_count']} panel rules"
    for index, (panel, rule) in enumerate(zip(inst["panels"], rules)):
        ok, reason = _verify_panel(inst["q"], inst["degree"], panel, rule)
        if not ok:
            return False, f"panel {index}: {reason}"
    return True, "ok"


def random_candidate(inst: dict, rng: random.Random) -> object:
    q = inst["q"]
    degree = inst["degree"]
    return {"rules": [
        {
            "period": degree,
            "a": rng.randrange(1, q),
            "offsets": rng.sample(range(q), degree),
        }
        for _ in range(inst["panel_count"])
    ]}


def search_space(inst: dict) -> int:
    q = inst["q"]
    degree = inst["degree"]
    ordered_offsets = 1
    for i in range(degree):
        ordered_offsets *= q - i
    return ((q - 1) * ordered_offsets) ** inst["panel_count"]


def enumerate_all(inst: dict) -> int | None:
    if search_space(inst) > _ENUMERATION_CAP:
        return None
    q = inst["q"]
    degree = inst["degree"]
    rules = []
    for slope in range(1, q):
        for offsets in itertools.permutations(range(q), degree):
            rules.append({"period": degree, "a": slope, "offsets": list(offsets)})
    count = 0
    for combination in itertools.product(rules, repeat=inst["panel_count"]):
        if verify(inst, {"rules": list(combination)})[0]:
                count += 1
    return count


def _panel_view(inst: dict, panel: dict) -> dict:
    return {
        "q": inst["q"],
        "degree": inst["degree"],
        "edge_count": panel["edge_count"],
        "rows": panel["rows"],
    }


def _compact_panel(inst: dict) -> tuple[dict, dict[str, int]]:
    """Use the intended two-row sum invariant, with operation accounting."""
    q = inst["q"]
    degree = inst["degree"]
    row0, row1 = inst["rows"][:2]
    sum0 = sum(row0["neighbors"]) % q
    sum1 = sum(row1["neighbors"]) % q
    denominator = degree * ((row1["x"] - row0["x"]) % q) % q
    inverse, divisions = _inverse_counted(denominator, q)
    slope = (sum1 - sum0) * inverse % q
    offsets = sorted((y - slope * row0["x"]) % q for y in row0["neighbors"])
    arithmetic = 2 * (degree - 1) + 5 + 3 * degree
    return {"period": degree, "a": slope, "offsets": offsets}, {
        "arithmetic_operations": arithmetic,
        "euclidean_divisions": divisions,
        "total_operations": arithmetic + divisions,
    }


def _reference_panel(inst: dict) -> tuple[object | None, dict[str, int]]:
    """Promise-oblivious exhaustive recovery over every nonzero slope."""
    q = inst["q"]
    degree = inst["degree"]
    rows = inst["rows"]
    residual_evaluations = 0
    row_comparisons = 0
    slopes_tested = 0
    for slope in range(1, q):
        slopes_tested += 1
        first = tuple(sorted((y - slope * rows[0]["x"]) % q for y in rows[0]["neighbors"]))
        residual_evaluations += degree
        matched = True
        for row in rows[1:]:
            residues = tuple(sorted((y - slope * row["x"]) % q for y in row["neighbors"]))
            residual_evaluations += degree
            row_comparisons += 1
            if residues != first:
                matched = False
                break
        if matched:
            candidate = {"period": degree, "a": slope, "offsets": list(first)}
            if verify(inst, candidate)[0]:
                return candidate, {
                    "slopes_tested": slopes_tested,
                    "residual_evaluations": residual_evaluations,
                    "row_comparisons": row_comparisons,
                    "operations": residual_evaluations + row_comparisons,
                }
    return None, {
        "slopes_tested": slopes_tested,
        "residual_evaluations": residual_evaluations,
        "row_comparisons": row_comparisons,
        "operations": residual_evaluations + row_comparisons,
    }


def _verify_explicit_panel(inst: dict, days: list[list[tuple[int, int]]]) -> bool:
    """Internal exact check for the domain-standard edge-colouring baseline."""
    if len(days) != inst["degree"]:
        return False
    expected = {
        (row["x"], y)
        for row in inst["rows"]
        for y in row["neighbors"]
    }
    used = set()
    for day in days:
        left = set()
        right = set()
        for edge in day:
            if edge not in expected or edge in used:
                return False
            x, y = edge
            if x in left or y in right:
                return False
            left.add(x)
            right.add(y)
            used.add(edge)
        if len(day) != inst["q"]:
            return False
    return used == expected


def _domain_standard_panel(inst: dict) -> tuple[list[list[tuple[int, int]]] | None, dict[str, int]]:
    """Delta-edge-colour a regular bipartite graph via perfect matchings."""
    q = inst["q"]
    remaining = {
        row["x"]: set(row["neighbors"])
        for row in inst["rows"]
    }
    days = []
    edge_scans = 0
    queue_pops = 0
    augmentations = 0

    for _day in range(inst["degree"]):
        adjacency = {x: sorted(neighbors) for x, neighbors in remaining.items()}
        pair_u = {x: None for x in range(q)}
        pair_v = {y: None for y in range(q)}
        distance = {}

        def bfs() -> bool:
            nonlocal edge_scans, queue_pops
            queue = deque()
            for x in range(q):
                if pair_u[x] is None:
                    distance[x] = 0
                    queue.append(x)
                else:
                    distance[x] = q + 1
            found = False
            while queue:
                x = queue.popleft()
                queue_pops += 1
                for y in adjacency[x]:
                    edge_scans += 1
                    partner = pair_v[y]
                    if partner is None:
                        found = True
                    elif distance.get(partner, q + 1) == q + 1:
                        distance[partner] = distance[x] + 1
                        queue.append(partner)
            return found

        def dfs(x: int) -> bool:
            nonlocal edge_scans
            for y in adjacency[x]:
                edge_scans += 1
                partner = pair_v[y]
                if partner is None or (
                    distance.get(partner, q + 1) == distance[x] + 1
                    and dfs(partner)
                ):
                    pair_u[x] = y
                    pair_v[y] = x
                    return True
            distance[x] = q + 1
            return False

        while bfs():
            progress = 0
            for x in range(q):
                if pair_u[x] is None and dfs(x):
                    progress += 1
                    augmentations += 1
            if progress == 0:
                break
        if any(pair_u[x] is None for x in range(q)):
            return None, {
                "edge_scans": edge_scans,
                "queue_pops": queue_pops,
                "augmentations": augmentations,
                "operations": edge_scans + queue_pops + augmentations,
            }
        matching = [(x, pair_u[x]) for x in range(q)]
        days.append(matching)
        for x, y in matching:
            remaining[x].remove(y)

    return days, {
        "edge_scans": edge_scans,
        "queue_pops": queue_pops,
        "augmentations": augmentations,
        "operations": edge_scans + queue_pops + augmentations,
    }


def _compact_rule(inst: dict) -> tuple[dict, dict[str, int]]:
    rules = []
    totals = {"arithmetic_operations": 0, "euclidean_divisions": 0, "total_operations": 0}
    for panel in inst["panels"]:
        rule, ops = _compact_panel(_panel_view(inst, panel))
        rules.append(rule)
        for key in totals:
            totals[key] += ops[key]
    return {"rules": rules}, totals


def _reference_algorithm(inst: dict) -> tuple[object | None, dict[str, int]]:
    rules = []
    totals = {"slopes_tested": 0, "residual_evaluations": 0, "row_comparisons": 0, "operations": 0}
    for panel in inst["panels"]:
        rule, ops = _reference_panel(_panel_view(inst, panel))
        for key in totals:
            totals[key] += ops[key]
        if rule is None:
            return None, totals
        rules.append(rule)
    return {"rules": rules}, totals


def _verify_explicit_days(inst: dict, panel_days: list[list[list[tuple[int, int]]]]) -> bool:
    return (
        isinstance(panel_days, list)
        and len(panel_days) == inst["panel_count"]
        and all(
            _verify_explicit_panel(_panel_view(inst, panel), days)
            for panel, days in zip(inst["panels"], panel_days)
        )
    )


def _domain_standard_algorithm(inst: dict) -> tuple[list[list[list[tuple[int, int]]]] | None, dict[str, int]]:
    panel_days = []
    totals = {"edge_scans": 0, "queue_pops": 0, "augmentations": 0, "operations": 0}
    for panel in inst["panels"]:
        days, ops = _domain_standard_panel(_panel_view(inst, panel))
        for key in totals:
            totals[key] += ops[key]
        if days is None:
            return None, totals
        panel_days.append(days)
    return panel_days, totals


def _panel_rule_from_slope(inst: dict, slope: int) -> dict:
    q = inst["q"]
    degree = inst["degree"]
    row = inst["rows"][0]
    offsets = sorted((y - slope * row["x"]) % q for y in row["neighbors"])
    return {"period": degree, "a": slope, "offsets": offsets}


def _identity_residue_attack(inst: dict) -> dict:
    return {"rules": [
        _panel_rule_from_slope(_panel_view(inst, panel), 1)
        for panel in inst["panels"]
    ]}


def _single_edge_extrapolation_attack(inst: dict) -> dict:
    q = inst["q"]
    rules = []
    for panel in inst["panels"]:
        row0, row1 = panel["rows"][:2]
        dx = (row1["x"] - row0["x"]) % q
        dy = (row1["neighbors"][0] - row0["neighbors"][0]) % q
        slope = dy * _inverse(dx, q) % q
        if slope == 0:
            slope = 1
        rules.append(_panel_rule_from_slope(_panel_view(inst, panel), slope))
    return {"rules": rules}


def _greedy_minimum_attack(inst: dict) -> dict:
    q = inst["q"]
    rules = []
    for panel in inst["panels"]:
        slope = _minimum_translation_slope(q, panel["rows"][0], panel["rows"][1])
        if slope == 0:
            slope = 1
        rules.append(_panel_rule_from_slope(_panel_view(inst, panel), slope))
    return {"rules": rules}


def _small_slope_scan_attack(inst: dict, limit: int = 16) -> dict:
    rules = []
    for panel in inst["panels"]:
        view = _panel_view(inst, panel)
        last = _panel_rule_from_slope(view, 1)
        for slope in range(1, min(inst["q"], limit + 1)):
            last = _panel_rule_from_slope(view, slope)
            if _verify_panel(inst["q"], inst["degree"], panel, last)[0]:
                break
        rules.append(last)
    return {"rules": rules}


def _random_restart_attack(inst: dict, seed: int, restarts: int = 256) -> object:
    rng = random.Random(seed)
    last = None
    for _ in range(restarts):
        last = random_candidate(inst, rng)
        if verify(inst, last)[0]:
            return last
    return last


def _recover_offsets(inst: dict, panel: dict) -> tuple[int, list[int]]:
    candidate, _ = _compact_panel(_panel_view(inst, panel))
    return candidate["a"], sorted(candidate["offsets"])


def _canonical_offset_orbit(q: int, offsets: list[int]) -> tuple[int, ...]:
    best = None
    for scale in range(1, q):
        scaled = [(scale * value) % q for value in offsets]
        for anchor in scaled:
            candidate = tuple(sorted((value - anchor) % q for value in scaled))
            if best is None or candidate < best:
                best = candidate
    if best is None:
        raise ValueError("empty offset set")
    return best


def canonical_key(inst: dict) -> str:
    """Normalize graph data under all declared coordinate relabellings."""
    _slope, offsets = _recover_offsets(inst)
    payload = [
        inst["q"],
        inst["degree"],
        list(_canonical_offset_orbit(inst["q"], offsets)),
    ]
    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode("ascii")).hexdigest()


def _transform_for_g8(
def _transform_for_g8(
    inst: dict, answer: dict, seed: int, mode: str = "composed"
) -> tuple[dict, dict]:
    """Apply one named symmetry, or their full composition, carrying the witness."""
    modes = {
        "row_order", "neighbour_order", "affine_coordinates",
        "bipartition_swap", "day_permutation", "composed",
    }
    if mode not in modes:
        raise ValueError("unknown G8 transformation mode")
    out = copy.deepcopy(inst)
    carried = copy.deepcopy(answer)
    rng = random.Random(seed)
    q = out["q"]
    new_rows = copy.deepcopy(out["rows"])

    if mode in {"affine_coordinates", "composed"}:
        u = rng.randrange(1, q)
        v = rng.randrange(1, q)
        s = rng.randrange(q)
        t = rng.randrange(q)
        if u == v == 1 and s == t == 0:
            t = 1
        new_rows = [{
            "x": (u * row["x"] + s) % q,
            "neighbors": [(v * y + t) % q for y in row["neighbors"]],
        } for row in new_rows]
        a2 = v * carried["a"] * _inverse(u, q) % q
        b2 = [(v * b + t - a2 * s) % q for b in carried["offsets"]]
        carried = {"period": out["degree"], "a": a2, "offsets": b2}

    if mode in {"bipartition_swap", "composed"}:
        swapped = {y: [] for y in range(q)}
        for row in new_rows:
            for y in row["neighbors"]:
                swapped[y].append(row["x"])
        new_rows = [{"x": y, "neighbors": xs} for y, xs in swapped.items()]
        inv_a = _inverse(carried["a"], q)
        carried = {
            "period": out["degree"],
            "a": inv_a,
            "offsets": [(-inv_a * b) % q for b in carried["offsets"]],
        }

    if mode in {"row_order", "composed"}:
        rng.shuffle(new_rows)
        if new_rows == out["rows"]:
            new_rows.reverse()
    if mode in {"neighbour_order", "composed"}:
        for row in new_rows:
            rng.shuffle(row["neighbors"])
        if new_rows and new_rows[0]["neighbors"] == out["rows"][0]["neighbors"]:
            new_rows[0]["neighbors"].reverse()
    if mode in {"day_permutation", "composed"}:
        rng.shuffle(carried["offsets"])
        if carried["offsets"] == answer["offsets"]:
            carried["offsets"] = carried["offsets"][1:] + carried["offsets"][:1]
    out["rows"] = new_rows
    return out, carried


def escalate(params: dict) -> dict | str | None:
    """Grow the residue ground set while keeping d+2 answer atoms fixed."""
    out = {key: value for key, value in params.items() if key != "_preset"}
    current = int(out.get("n", 101))
    out["n"] = 2 * current + 1
    return out


def _answer_atoms(value: object) -> int:
    if isinstance(value, dict):
        return sum(_answer_atoms(item) for item in value.values())
    if isinstance(value, list):
        return sum(_answer_atoms(item) for item in value)
    return 1


def selftest() -> dict:
    """Run gates G1--G9 and return a fully JSON-native measurement report."""
    report: dict[str, Any] = {
        "paper": "2403.00465",
        "track": TRACK,
        "shipping_difficulty": SHIPPING_DIFFICULTY,
        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
    }

    g1_verified = 0
    g1_json = 0
    g1_attempts = 0
    for _preset, params in DIFFICULTY.items():
        for seed in range(4):
            inst = make_instance(seed=seed, **params)
            g1_attempts += 1
            if verify(inst, inst["answer"])[0]:
                g1_verified += 1
            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
                g1_json += 1
    report["G1_planted_verifies"] = {
        "pass": g1_verified == g1_attempts and g1_json == g1_attempts,
        "verified": g1_verified,
        "attempts": g1_attempts,
        "json_roundtrips": g1_json,
    }

    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
    ship = make_instance(seed=20260905, **shipping_params)

    corruptions = []
    corruptions.append(("empty", []))
    dropped = copy.deepcopy(ship["answer"])
    dropped["offsets"].pop()
    corruptions.append(("drop", dropped))
    swapped = copy.deepcopy(ship["answer"])
    swapped["period"], swapped["a"] = swapped["a"], swapped["period"]
    corruptions.append(("swap", swapped))
    duplicated = copy.deepcopy(ship["answer"])
    duplicated["offsets"][-1] = duplicated["offsets"][0]
    corruptions.append(("duplicate", duplicated))
    out_of_range = copy.deepcopy(ship["answer"])
    out_of_range["offsets"][0] = ship["q"]
    corruptions.append(("out_of_range", out_of_range))
    cases = {}
    for name, candidate in corruptions:
        ok, reason = verify(ship, candidate)
        cases[name] = {"rejected": not ok, "reason": reason}
    distinct_reasons = len({case["reason"] for case in cases.values()})
    report["G2_rejects_corruption"] = {
        "pass": all(case["rejected"] for case in cases.values()) and distinct_reasons == len(cases),
        "rejected": sum(case["rejected"] for case in cases.values()),
        "attempts": len(cases),
        "distinct_reasons": distinct_reasons,
        "cases": cases,
    }

    body = json.dumps(ship["answer"], separators=(",", ":"))
    replies = [
        f"I found the modular factorisation.\n<answer>{body}</answer>\nDone.",
        f"Result follows:\n<answer>```json\n{body}\n```</answer>",
        f"prose <answer>   {body}   </answer> more prose",
    ]
    parsed = sum(parse_answer(reply) == ship["answer"] for reply in replies)
    garbage_none = parse_answer("there is no tagged JSON here") is None
    report["G3_round_trip"] = {
        "pass": parsed == len(replies) and garbage_none,
        "parsed": parsed,
        "attempts": len(replies),
        "garbage_rejected": garbage_none,
    }

    guess_rng = random.Random(0x240300465)
    hits = 0
    start = time.perf_counter()
    for _ in range(_G4_SAMPLES):
        if verify(ship, random_candidate(ship, guess_rng))[0]:
            hits += 1
    guess_seconds = time.perf_counter() - start
    probability = hits / _G4_SAMPLES
    report["G4_guess_resistance"] = {
        "pass": probability < 1e-6,
        "hits": hits,
        "total": _G4_SAMPLES,
        "observed_probability": probability,
        "search_space": search_space(ship),
        "sampling_seconds": round(guess_seconds, 6),
        "prior": "uniform over nonzero slopes and ordered distinct offset lists",
    }

    start = time.perf_counter()
    reference_answer, reference_ops = _reference_algorithm(ship)
    reference_seconds = time.perf_counter() - start
    reference_ok = reference_answer is not None and verify(ship, reference_answer)[0]
    start = time.perf_counter()
    standard_days, standard_ops = _domain_standard_algorithm(ship)
    standard_seconds = time.perf_counter() - start
    standard_ok = standard_days is not None and _verify_explicit_days(ship, standard_days)
    demo = make_instance(seed=0, **DIFFICULTY["demo"])
    demo_exact = enumerate_all(demo)
    report["G5_density_and_baseline"] = {
        "pass": reference_ok and standard_ok and _G4_SAMPLES >= 200_000 and demo_exact is not None,
        "shipping_density_hits": hits,
        "shipping_density_samples": _G4_SAMPLES,
        "shipping_density_estimate": probability,
        "shipping_exact_count": None,
        "demo_exact_valid_answers": demo_exact,
        "demo_candidate_space": search_space(demo),
        "baseline_wall_seconds": round(reference_seconds, 6),
        "baseline_operations": reference_ops["operations"],
        "baseline_slopes_tested": reference_ops["slopes_tested"],
        "baseline_residual_evaluations": reference_ops["residual_evaluations"],
        "baseline_row_comparisons": reference_ops["row_comparisons"],
        "baseline_solved": reference_ok,
        "domain_standard_wall_seconds": round(standard_seconds, 6),
        "domain_standard_operations": standard_ops["operations"],
        "domain_standard_edge_scans": standard_ops["edge_scans"],
        "domain_standard_solved": standard_ok,
    }

    attack_fns = {
        "outlier_identity_residue": lambda inst, seed: _identity_residue_attack(inst),
        "greedy_minimum_translation": lambda inst, seed: _greedy_minimum_attack(inst),
        "single_edge_extrapolation": lambda inst, seed: _single_edge_extrapolation_attack(inst),
        "small_slope_scan_16": lambda inst, seed: _small_slope_scan_attack(inst, 16),
        "random_restart_256": lambda inst, seed: _random_restart_attack(inst, seed, 256),
    }
    attack_results = {
        name: {"successes": 0, "attempts": _ATTACK_SEEDS}
        for name in attack_fns
    }
    reference_successes = 0
    reference_total_seconds = 0.0
    reference_totals = {
        "operations": 0,
        "slopes_tested": 0,
        "residual_evaluations": 0,
        "row_comparisons": 0,
    }
    compact_successes = 0
    compact_total_ops = 0
    standard_successes = 0
    standard_total_seconds = 0.0
    standard_totals = {
        "operations": 0,
        "edge_scans": 0,
        "queue_pops": 0,
        "augmentations": 0,
    }
    for seed in range(_ATTACK_SEEDS):
        inst = make_instance(seed=90_000 + seed, **shipping_params)
        for name, attack in attack_fns.items():
            candidate = attack(inst, 700_000 + seed)
            if verify(inst, candidate)[0]:
                attack_results[name]["successes"] += 1
        t0 = time.perf_counter()
        candidate, ops = _reference_algorithm(inst)
        reference_total_seconds += time.perf_counter() - t0
        for key in reference_totals:
            reference_totals[key] += ops[key]
        if candidate is not None and verify(inst, candidate)[0]:
            reference_successes += 1
        t0 = time.perf_counter()
        days, domain_ops = _domain_standard_algorithm(inst)
        standard_total_seconds += time.perf_counter() - t0
        for key in standard_totals:
            standard_totals[key] += domain_ops[key]
        if days is not None and _verify_explicit_days(inst, days):
            standard_successes += 1
        compact_candidate, compact_ops = _compact_rule(inst)
        compact_total_ops += compact_ops["total_operations"]
        if verify(inst, compact_candidate)[0]:
            compact_successes += 1
    all_failed = all(result["successes"] == 0 for result in attack_results.values())
    report["G6_adversary_panel"] = {
        "pass": (
            all_failed
            and reference_successes == _ATTACK_SEEDS
            and standard_successes == _ATTACK_SEEDS
            and compact_successes == _ATTACK_SEEDS
        ),
        "attacks": attack_results,
        "reference_algorithm": {
            "name": "repeated Hopcroft--Karp perfect-matching extraction",
            "complexity": "O(d*E*sqrt(V)) worst-case",
            "wall_clock_sec": round(standard_total_seconds / _ATTACK_SEEDS, 6),
            "operations": standard_totals["operations"] // _ATTACK_SEEDS,
            "edge_scans": standard_totals["edge_scans"] // _ATTACK_SEEDS,
            "queue_pops": standard_totals["queue_pops"] // _ATTACK_SEEDS,
            "augmentations": standard_totals["augmentations"] // _ATTACK_SEEDS,
            "solves": f"{standard_successes}/{_ATTACK_SEEDS}, as expected",
        },
        "certificate_recovery_algorithm": {
            "name": "exhaustive affine-slope recovery with row-set comparison",
            "complexity": "O(q^2*d*log d) worst-case exact",
            "wall_clock_sec": round(reference_total_seconds / _ATTACK_SEEDS, 6),
            "operations": reference_totals["operations"] // _ATTACK_SEEDS,
            "slopes_tested": reference_totals["slopes_tested"] // _ATTACK_SEEDS,
