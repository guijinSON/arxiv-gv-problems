+def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
+    """Inverse-generate disjoint regular bipartite components and witnesses."""
+    if isinstance(n, bool) or not isinstance(n, int) or n < 5:
+        raise ValueError("n must be an integer at least 5")
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+    degree = params.pop("degree", 6)
+    panel_count = params.pop("panels", 4)
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    q = _next_prime(n)
+    if isinstance(degree, bool) or not isinstance(degree, int):
+        raise ValueError("degree must be an integer")
+    if degree < 2 or degree >= q - 1 or degree > 12:
+        raise ValueError("degree must lie in 2..min(12,q-2)")
+    if isinstance(panel_count, bool) or not isinstance(panel_count, int) or not (1 <= panel_count <= 6):
+        raise ValueError("panels must be an integer in 1..6")
+    rng = random.Random(seed)
+    built = [_make_panel(q, degree, rng) for _ in range(panel_count)]
+    panels = [panel for panel, _rule in built]
+    rules = [rule for _panel, rule in built]
