+    low = 1 << (inst["modulus_bits"] - 1)
+    high = 1 << inst["modulus_bits"]
+    valid = 0
+    for weights in _iter_weights(inst["coefficient_bound"]):
+        modulus = abs(sum(w * total for w, total in zip(weights, sums)))
+        if not low <= modulus < high:
+            continue
