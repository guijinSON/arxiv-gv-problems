+    values = [value for value in range(-bound, bound + 1) if value]
+    while True:
+        a, b, c = rng.sample(values, 3)
+        d = -(a + b + c)
+        weights = (a, b, c, d)
+        if _weight_is_well_formed(weights, bound):
+            return list(weights)
