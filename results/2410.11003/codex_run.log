+    doubled_build_seconds = time.perf_counter() - start
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok,
+        "base_part_size": shipping["part_size"],
+        "doubled_part_size": doubled["part_size"],
