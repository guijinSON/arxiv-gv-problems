+        guess_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
+    guess_seconds = time.perf_counter() - t0
+    guess_probability = guess_hits / _G4_SAMPLES
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": guess_hits,
