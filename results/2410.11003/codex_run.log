+    for seed in range(20):
+        inst = make_instance(seed=110_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(inst)
+        distinct_keys.append(key)
+        relabel_rng = random.Random(120_000 + seed)
+        part_order = list(range(_PARTS))
