+        "d": d,
+        "m": len(constraints),
+        "degrees": sorted(degrees),
+        "pair_multiplicities": sorted(pair_counts.values()),
+        "relations": sorted(relation_profiles),
+        "variable_colors": sorted(var_colors),
+        "constraint_colors": sorted(con_colors),
