+        "family": "one_forced_model_RB_binary_CSP",
+        "n": n,
+        "d": d,
+        "k": 2,
+        "alpha": [3, 5],
+        "tightness_p": [1, 2],
+        "density_r": [density_milli, 1000],
+        "constraint_count": m,
+        "permitted_tuples_per_constraint": permitted_count,
+        "constraints": constraints,
+        "answer": sigma,
+    }
+
+
+def render(inst: dict) -> str:
