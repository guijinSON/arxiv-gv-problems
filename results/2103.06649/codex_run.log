+        "random_restart_min_conflicts_16x6n": {"successes": 0, "attempts": 0, "iterations": 0},
+        "standard_MAC_MRV_LCV_5000_nodes": {"successes": 0, "attempts": 0, "nodes": 0, "wall_clock_sec": 0.0},
+    }
