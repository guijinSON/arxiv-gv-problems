+        new = 0
+        source_values = old
+        table = support_tables[ci][0 if source == left else 1]
+        while source_values:
+            bit = source_values & -source_values
+            value = bit.bit_length() - 1
+            source_values -= bit
+            if table[value] & domains[target]:
