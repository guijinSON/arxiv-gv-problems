+DIFFICULTY = {
+    "demo": {"n": 4, "density_milli": 800, "domain_offset": 0},
+    "easy": {"n": 100, "density_milli": 840, "domain_offset": 0},
+    "medium": {"n": 120, "density_milli": 845, "domain_offset": 0},
