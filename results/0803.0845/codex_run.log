+}
+
+DIFFICULTY = {
+    "demo": {"n": 4, "q_bits": 8, "quotient_bits": 10},
+    "easy": {"n": 7, "q_bits": 40, "quotient_bits": 80},
+    "medium": {"n": 10, "q_bits": 72, "quotient_bits": 256},
+    "hard": {"n": 13, "q_bits": 104, "quotient_bits": 768},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON object {q,last_remainder}. q is an integer in the stated "
+        "half-open q interval, and last_remainder is the uniquely determined "
+        "Euclidean remainder of the final public integer modulo q."
+    ),
+    "bounds": {
+        "fields": 2,
+        "q_bits_at_named_presets_at_most": 104,
+        "last_remainder_rule": "0 <= r < q and r = final_public_integer mod q",
+    },
+}
+
+STRUCTURAL_HINT = (
+    "Order the adjusted public integers by their stated remainders and inspect "
+    "their highest forward difference."
+)
+PLACEBO_HINT = (
+    "Keep careful track of the stated bounds and the distinction between each "
+    "public integer and its remainder."
+)
+
+# Populated with actual oracle measurements after STEP 4.  Zero attempts is an
+# explicit diagnostic-pending value, not fabricated evidence.
+_G9_ARMS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+}
+
+NOTES = """
+The exact definition is Problem 4 in Section 4.2, "Finding a pseudo-key is as
+difficult as factorising an integer": the first s-1 Euclidean remainders are
+given, the last is constrained to a closed interval, and the answer is one
+pseudo-key.  Section 2's low-density discussion and Section 5.3's LLL analysis
+identify easy knapsack/ciphertext regimes, but Problem 4 itself exposes known
+remainders and is naturally attacked by a GCD.  Consequently this module is
+Track B, not Track A.  Its adjusted values q*P(i) are built in the binomial
+polynomial basis with top coefficient one, so their highest forward difference
+is q.  This is a composition-of-identities certificate, never the result of
+solving the emitted instance.  The per-equation scale probe, smallest-legal-q
+greedy scan, random restarts, a truncated by-hand GCD, and a finite difference
+in the deliberately shuffled order all fail.  Full Euclid succeeds and is
+reported separately as the reference algorithm, as Track B requires.
+""".strip()
+
+
+def _binomial_polynomial_values(coefficients: list[int], count: int) -> list[int]:
+    """Evaluate sum_k coefficients[k] * binomial(i,k), exactly."""
+
+    values = []
+    for i in range(count):
+        value = 0
+        choose = 1
+        for k, coefficient in enumerate(coefficients):
+            if k > i:
+                break
+            if k:
+                choose = choose * (i - k + 1) // k
+            value += coefficient * choose
+        values.append(value)
+    return values
+
+
+def _superincreasing_prefix(count: int, rng: random.Random) -> list[int]:
+    values: list[int] = []
+    total = 0
+    for _ in range(count):
+        value = total + rng.randint(1, 3)
+        values.append(value)
+        total += value
+    return values
+
+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    q_bits: int = 104,
+    quotient_bits: int = 768,
+    **params,
+) -> dict:
+    """Construct a native Problem-4 instance and its pseudo-key certificate.
+
+    There are n public integers.  The exact remainders of the first n-1 are
+    supplied.  The quotient sequence is sampled first in the binomial basis;
+    its (n-2)-nd forward difference is one.  Multiplication by a sampled q then
+    makes that forward difference exactly q.  No instance is solved.
+    """
+
+    del params
+    if not isinstance(n, int) or n < 4:
+        raise ValueError("n must be an integer at least 4")
+    if not isinstance(q_bits, int) or q_bits < max(8, n + 2):
+        raise ValueError("q_bits must be an integer large enough for the remainders")
+    if not isinstance(quotient_bits, int) or quotient_bits < 8:
+        raise ValueError("quotient_bits must be an integer at least 8")
+
+    rng = random.Random(seed)
+    q_lower = 1 << (q_bits - 1)
+    q_upper = 1 << q_bits
+    q = rng.randrange(q_lower, q_upper)
+    if q % 2 == 0:
+        q += 1
+    if q >= q_upper:
+        q -= 2
+
+    exact_count = n - 1
+    degree = exact_count - 1
+    remainders = _superincreasing_prefix(exact_count, rng)
+    prefix_sum = sum(remainders)
+    interval_low = prefix_sum + 1
+    interval_width = max(2, prefix_sum // 3)
+    interval_high = interval_low + interval_width  # closed endpoint
+    last_remainder = rng.randint(interval_low, interval_high)
+    if prefix_sum + last_remainder >= q:
+        raise ValueError("q_bits is too small for this n's superincreasing sequence")
+
+    base = 1 << quotient_bits
+    # Random lower-order coefficients hide the invariant.  The large positive
+    # constant dominates every signed lower term on i=0,...,degree.
+    coefficients = [0] * (degree + 1)
+    coefficients[0] = rng.randrange(4 * base * (1 << degree), 5 * base * (1 << degree))
+    for k in range(1, degree):
+        coefficient = rng.randrange(-base + 1, base)
+        coefficients[k] = coefficient if coefficient else 1
+    coefficients[degree] = 1
+    quotients = _binomial_polynomial_values(coefficients, exact_count)
+    if min(quotients) <= 0:
+        raise AssertionError("positive-offset construction failed")
+
+    exact_pairs = [
+        [q * quotient + remainder, remainder]
+        for quotient, remainder in zip(quotients, remainders)
+    ]
+    rng.shuffle(exact_pairs)
+    last_quotient = rng.randrange(4 * base * (1 << degree), 5 * base * (1 << degree))
+    last_public_integer = q * last_quotient + last_remainder
+
+    return {
+        "paper": "arXiv:0803.0845",
+        "family": "Problem 4 pseudo-key from prescribed Euclidean remainders",
+        "n": n,
+        "q_bits": q_bits,
+        "quotient_bits": quotient_bits,
+        "q_interval": [q_lower, q_upper],
+        "exact_pairs": exact_pairs,
+        "last_public_integer": last_public_integer,
+        "last_remainder_interval": [interval_low, interval_high],
+        "answer": {"q": q, "last_remainder": last_remainder},
+    }
+
+
+def render(inst: dict) -> str:
+    q_lower, q_upper = inst["q_interval"]
+    a, b = inst["last_remainder_interval"]
+    lines = [
+        "Find one pseudo-key for this Euclidean-remainder instance.",
+        "",
+        "Definitions and conditions.",
+        "For positive integers w and q, the Euclidean remainder w mod q is the unique r with 0 <= r < q and w = qv + r for an integer v.",
+        "A finite positive sequence is superincreasing if, after sorting it increasingly, every term is strictly greater than the sum of all earlier terms.",
+        f"Your pseudo-key q must lie in the half-open interval [{q_lower}, {q_upper}).",
+        "For every exact pair (w,r) below, it must satisfy w mod q = r.",
+        f"For the final public integer, its remainder R must lie in the CLOSED interval [{a}, {b}].",
+        "All the exact remainders together with R must be superincreasing, and their total sum must be strictly less than q.",
+        "The order in which the exact pairs are printed has no mathematical significance.",
+        "",
+        "Exact (public integer w, required remainder r) pairs:",
+    ]
+    for w, remainder in inst["exact_pairs"]:
+        lines.append(f"  {w} , {remainder}")
+    lines.extend(
+        [
+            "",
+            f"Final public integer: {inst['last_public_integer']}",
+            f"Closed interval for its remainder: [{a}, {b}]",
+            "",
+            "Give your final answer inside <answer></answer> tags as exactly one JSON object with decimal integers q and last_remainder.",
+            'Example: <answer>{"q": 173, "last_remainder": 19}</answer>',
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    try:
+        match = re.search(r"<answer>(.*?)</answer>", text, re.IGNORECASE | re.DOTALL)
+        if match is None:
+            return None
+        body = match.group(1).strip()
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.IGNORECASE)
+        body = re.sub(r"\s*```$", "", body).strip()
+        value = json.loads(body)
+        if not isinstance(value, dict):
+            return None
+        if set(value) != {"q", "last_remainder"}:
+            return None
+        if any(isinstance(value[key], bool) or not isinstance(value[key], int) for key in value):
+            return None
+        return {"q": value["q"], "last_remainder": value["last_remainder"]}
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    if not isinstance(answer, dict):
+        return False, "malformed certificate: expected one JSON object"
+    if not answer:
+        return False, "empty certificate: q and last_remainder are required"
+    required = {"q", "last_remainder"}
+    missing = required - set(answer)
+    if missing:
+        return False, "missing certificate field: " + sorted(missing)[0]
+    extras = set(answer) - required
+    if extras:
+        return False, "unexpected certificate field: " + sorted(extras)[0]
+    q = answer["q"]
+    reported_last = answer["last_remainder"]
+    if isinstance(q, bool) or not isinstance(q, int):
+        return False, "q must be an integer"
+    if isinstance(reported_last, bool) or not isinstance(reported_last, int):
+        return False, "last_remainder must be an integer"
+
+    q_lower, q_upper = inst["q_interval"]
+    if q < q_lower and reported_last >= q_lower:
+        return False, "certificate fields appear swapped"
+    if q == reported_last and q >= q_lower:
+        return False, "certificate fields appear duplicated"
+    if not q_lower <= q < q_upper:
+        return False, "candidate q is outside the stated half-open interval"
+
+    known_remainders = []
+    for index, pair in enumerate(inst["exact_pairs"]):
+        if not isinstance(pair, list) or len(pair) != 2:
+            return False, "malformed instance pair"
+        w, required_remainder = pair
+        if not 0 <= required_remainder < q:
+            return False, f"stated remainder at pair {index} is not in [0,q)"
+        if w % q != required_remainder:
+            return False, f"exact remainder mismatch at pair {index}"
+        known_remainders.append(required_remainder)
+
+    actual_last = inst["last_public_integer"] % q
+    if reported_last != actual_last:
+        return False, "reported last_remainder does not equal the exact Euclidean remainder"
+    low, high = inst["last_remainder_interval"]
+    if not low <= actual_last <= high:
+        return False, "final remainder is outside the stated closed interval"
+
+    ordered = sorted(known_remainders + [actual_last])
+    running_sum = 0
+    for index, remainder in enumerate(ordered):
+        if remainder <= running_sum:
+            return False, f"remainders are not superincreasing at sorted position {index}"
+        running_sum += remainder
+    if running_sum >= q:
+        return False, "sum of all remainders is not strictly less than q"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    q_lower, q_upper = inst["q_interval"]
+    q = rng.randrange(q_lower, q_upper)
+    return {
+        "q": q,
+        "last_remainder": inst["last_public_integer"] % q,
+    }
+
+
+def search_space(inst: dict) -> int | None:
+    q_lower, q_upper = inst["q_interval"]
+    return q_upper - q_lower
+
+
+def enumerate_all(inst: dict) -> int | None:
+    size = search_space(inst)
+    if size is None or size > 1_000_000:
+        return None
+    q_lower, q_upper = inst["q_interval"]
+    count = 0
+    for q in range(q_lower, q_upper):
+        candidate = {"q": q, "last_remainder": inst["last_public_integer"] % q}
+        count += int(verify(inst, candidate)[0])
+    return count
+
+
+def _canonical_payload(inst: dict) -> dict:
+    return {
+        "q_interval": list(inst["q_interval"]),
+        "exact_pairs": sorted([list(pair) for pair in inst["exact_pairs"]]),
+        "last_public_integer": inst["last_public_integer"],
+        "last_remainder_interval": list(inst["last_remainder_interval"]),
+    }
+
+
+def canonical_key(inst: dict) -> str:
+    payload = json.dumps(_canonical_payload(inst), sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    harder = {k: v for k, v in params.items() if k != "_preset"}
+    n = int(harder.get("n", 13))
+    q_bits = int(harder.get("q_bits", 104))
+    quotient_bits = int(harder.get("quotient_bits", 768))
+    if 2 * (n + 2 - 2) + 1 > 300 or q_bits + 48 > 6400:
+        return "cap_bound"
+    # The quotient height is the main fixed-answer-length axis; n adds more
+    # equations/decoys, while q_bits expands the bounded answer space mildly.
+    harder["n"] = n + 2
+    harder["q_bits"] = q_bits + 48
+    harder["quotient_bits"] = quotient_bits + max(256, quotient_bits // 2)
+    return harder
+
+
+def _candidate(q: int, inst: dict) -> dict:
+    return {"q": q, "last_remainder": inst["last_public_integer"] % q} if q > 0 else {
+        "q": q,
+        "last_remainder": 0,
+    }
+
+
+def _finite_difference_candidate(inst: dict, sort_by_remainder: bool) -> dict:
+    pairs = [list(pair) for pair in inst["exact_pairs"]]
+    if sort_by_remainder:
+        pairs.sort(key=lambda pair: pair[1])
+    adjusted = [w - remainder for w, remainder in pairs]
+    degree = len(adjusted) - 1
+    value = sum(
+        (-1 if (degree - i) % 2 else 1) * math.comb(degree, i) * adjusted[i]
+        for i in range(degree + 1)
+    )
+    return _candidate(abs(value), inst)
+
+
+def _truncated_gcd_candidate(inst: dict, steps: int = 8) -> dict:
+    adjusted = [w - remainder for w, remainder in inst["exact_pairs"]]
+    a, b = adjusted[0], adjusted[1]
+    for _ in range(steps):
+        if b == 0:
+            break
+        a, b = b, a % b
+    return _candidate(abs(a if b == 0 else b), inst)
+
+
+def _greedy_candidate(inst: dict, budget: int = 64) -> tuple[dict, int]:
+    q_lower, q_upper = inst["q_interval"]
+    tested = 0
+    for q in range(q_lower, min(q_upper, q_lower + budget)):
+        tested += 1
+        candidate = _candidate(q, inst)
+        if verify(inst, candidate)[0]:
+            return candidate, tested
+    return _candidate(q_lower, inst), tested
+
+
+def _gcd_reference(inst: dict) -> tuple[dict, dict]:
+    adjusted = [w - remainder for w, remainder in inst["exact_pairs"]]
+    g = 0
+    divisions = 0
+    bit_operation_proxy = 0
+    for value in adjusted:
+        a, b = abs(g), abs(value)
+        while b:
+            divisions += 1
+            bit_operation_proxy += max(1, a.bit_length()) * max(1, b.bit_length())
+            a, b = b, a % b
+        g = a
+    return _candidate(g, inst), {
+        "euclidean_divisions": divisions,
+        "bit_operation_proxy": bit_operation_proxy,
+    }
+
+
+def _reordered(inst: dict, order: list[int]) -> dict:
+    transformed = copy.deepcopy(inst)
+    transformed["exact_pairs"] = [copy.deepcopy(inst["exact_pairs"][i]) for i in order]
+    return transformed
+
+
+def _atomic_elements(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_atomic_elements(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_atomic_elements(item) for item in value)
+    return 1
+
+
+def selftest() -> dict:
+    report: dict = {
+        "paper": "arXiv:0803.0845",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    g1_successes = 0
+    g1_attempts = 0
+    json_roundtrips = 0
+    identity_checks = 0
+    gcd_uniqueness_checks = 0
+    for preset, parameters in DIFFICULTY.items():
+        for seed in range(5):
+            inst = make_instance(seed=seed, **parameters)
+            g1_attempts += 1
+            g1_successes += int(verify(inst, inst["answer"])[0])
+            json_roundtrips += int(json.loads(json.dumps(inst["answer"])) == inst["answer"])
+            identity_checks += int(
+                _finite_difference_candidate(inst, sort_by_remainder=True) == inst["answer"]
+            )
+            gcd_uniqueness_checks += int(_gcd_reference(inst)[0] == inst["answer"])
+    report["G1_planted_verifies"] = {
+        "pass": g1_successes == g1_attempts
+        and json_roundtrips == g1_attempts
+        and identity_checks == g1_attempts
+        and gcd_uniqueness_checks == g1_attempts,
+        "successes": g1_successes,
+        "attempts": g1_attempts,
+        "json_native_roundtrips": json_roundtrips,
+        "finite_difference_identity_checks": identity_checks,
+        "gcd_uniqueness_checks": gcd_uniqueness_checks,
+    }
+
+    shipping = make_instance(seed=271828, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    answer = shipping["answer"]
+    corruptions = {
+        "drop": {"q": answer["q"]},
+        "swap": {"q": answer["last_remainder"], "last_remainder": answer["q"]},
+        "duplicate": {
+            "q": answer["q"],
+            "last_remainder": answer["last_remainder"],
+            "duplicate_q": answer["q"],
+        },
+        "empty": {},
+        "out_of_range": {
+            "q": shipping["q_interval"][0] - 1,
+            "last_remainder": 0,
+        },
+    }
+    cases = {}
+    for name, corrupted in corruptions.items():
+        ok, reason = verify(shipping, corrupted)
+        cases[name] = {"rejected": not ok, "reason": reason}
+    reasons = [case["reason"] for case in cases.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(case["rejected"] for case in cases.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    realistic = (
+        "The adjusted equations share the following divisor.\n```json\n<answer>\n"
+        + json.dumps(answer, separators=(",", ":"))
+        + "\n</answer>\n```\nThis also gives the final Euclidean remainder."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer
+        and parse_answer("no tagged answer") is None
+        and parse_answer("<answer>{bad json}</answer>") is None,
+        "realistic_response_recovered": parsed == answer,
+        "garbage_returns_none": parse_answer("garbage") is None,
+    }
+
+    guess_rng = random.Random(0x08030845)
+    sample_total = 200_000
+    sample_hits = 0
+    for _ in range(sample_total):
+        sample_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
+    empirical_probability = sample_hits / sample_total
+    report["G4_guess_resistance"] = {
+        "pass": sample_total >= 200_000 and empirical_probability < 1e-6,
+        "hits": sample_hits,
+        "total": sample_total,
+        "empirical_probability": empirical_probability,
+        "candidate_space": search_space(shipping),
+        "exact_valid_count": 1,
+        "exact_probability": 1.0 / search_space(shipping),
+        "prior": (
+            "uniform q over the stated half-open interval; last_remainder is "
+            "recomputed, so the sampler enforces the answer's freely deducible field"
+        ),
+    }
+
+    attack_names = [
+        "single_equation_scale_outlier",
+        "greedy_smallest_legal_q_64",
+        "random_restart_256",
+        "truncated_by_hand_euclid_8",
+        "finite_difference_without_ordering",
+    ]
+    attacks = {name: {"successes": 0, "attempts": 0} for name in attack_names}
+    reference_instances = []
+    reference_successes = 0
+    reference_divisions = 0
+    reference_bit_proxy = 0
+    reference_elapsed = 0.0
+
+    for seed in range(8100, 8108):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        q_lower, _ = inst["q_interval"]
+        # Per-equation scale contains no distinguished planted equation.  This
+        # cheap probe uses the bit length of the smallest adjusted equation.
+        adjusted = [w - r for w, r in inst["exact_pairs"]]
+        scale_guess = q_lower + (min(adjusted).bit_length() % 257)
+        candidates = {
+            "single_equation_scale_outlier": _candidate(scale_guess, inst),
+            "truncated_by_hand_euclid_8": _truncated_gcd_candidate(inst, 8),
+            "finite_difference_without_ordering": _finite_difference_candidate(
+                inst, sort_by_remainder=False
+            ),
+        }
+        greedy, _ = _greedy_candidate(inst, 64)
+        candidates["greedy_smallest_legal_q_64"] = greedy
+        for name, candidate in candidates.items():
+            attacks[name]["attempts"] += 1
+            attacks[name]["successes"] += int(verify(inst, candidate)[0])
+
+        restart_rng = random.Random(seed ^ 0xA5A50803)
+        restart_solved = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, restart_rng))[0]:
+                restart_solved = True
+                break
+        attacks["random_restart_256"]["attempts"] += 1
+        attacks["random_restart_256"]["successes"] += int(restart_solved)
+
+        started = time.perf_counter()
+        reference_answer, cost = _gcd_reference(inst)
+        elapsed = time.perf_counter() - started
+        solved = verify(inst, reference_answer)[0]
+        reference_successes += int(solved)
+        reference_divisions += cost["euclidean_divisions"]
+        reference_bit_proxy += cost["bit_operation_proxy"]
+        reference_elapsed += elapsed
+        reference_instances.append(
+            {
+                "seed": seed,
+                "solved": solved,
+                "wall_clock_sec": round(elapsed, 6),
+                **cost,
+            }
+        )
+
+    demo_count = enumerate_all(make_instance(seed=0, **DIFFICULTY["demo"]))
+    report["G5_density_and_baseline"] = {
+        "pass": empirical_probability < 1e-6
+        and reference_successes == 8
+        and demo_count == 1,
+        "shipping_sampled_solution_hits": sample_hits,
+        "shipping_sampled_solution_total": sample_total,
+        "shipping_sampled_solution_fraction": empirical_probability,
+        "shipping_exact_valid_certificate_count": 1,
+        "shipping_exact_solution_fraction": 1.0 / search_space(shipping),
+        "strongest_attack_wall_sec": round(reference_elapsed, 6),
+        "strongest_attack_euclidean_divisions": reference_divisions,
+        "strongest_attack_bit_operation_proxy": reference_bit_proxy,
+        "strongest_attack_solved_instances": reference_successes,
+        "demo_exact_valid_certificate_count": demo_count,
+    }
+    reference_algorithm = {
+        "name": "multi-integer Euclidean GCD on every w-r",
+        "complexity": "O(n L^2) bit operations with schoolbook integer arithmetic",
+        "wall_clock_sec": round(reference_elapsed, 6),
+        "mean_wall_clock_sec": round(reference_elapsed / 8, 6),
+        "operations": reference_bit_proxy,
+        "euclidean_divisions": reference_divisions,
+        "mean_euclidean_divisions": reference_divisions / 8,
+        "solves": f"{reference_successes}/8, as expected",
+        "instances": reference_instances,
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(result["successes"] == 0 for result in attacks.values()),
+        "attacks": attacks,
+        "reference_algorithm": reference_algorithm,
+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=314159, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["n"] == 2 * shipping["n"]
+        and _atomic_elements(doubled["answer"]) == _atomic_elements(answer),
+        "base_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "base_adjusted_integer_bits_max": max(
+            (w - r).bit_length() for w, r in shipping["exact_pairs"]
+        ),
+        "doubled_adjusted_integer_bits_max": max(
+            (w - r).bit_length() for w, r in doubled["exact_pairs"]
+        ),
+        "base_answer_elements": _atomic_elements(answer),
+        "doubled_answer_elements": _atomic_elements(doubled["answer"]),
+        "doubled_planted_verifies": doubled_ok,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    unrelated_keys: set[str] = set()
+    g8_ok = True
+    for offset in range(20):
+        seed = 90000 + offset
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(inst)
+        unrelated_keys.add(key)
+        size = len(inst["exact_pairs"])
+        random_order = list(range(size))
+        random.Random(seed ^ 0xC0FFEE).shuffle(random_order)
+        reverse_order = list(reversed(range(size)))
+        composed_order = [reverse_order[i] for i in random_order]
+        for order in (random_order, reverse_order, composed_order):
+            transformed = _reordered(inst, order)
+            invariance_checks += 1
+            g8_ok = g8_ok and canonical_key(transformed) == key
+            carried_checks += 1
+            g8_ok = g8_ok and verify(transformed, answer=inst["answer"])[0]
+    report["G8_canonical_key"] = {
+        "pass": g8_ok and len(unrelated_keys) == 20,
+        "invariance_checks": invariance_checks,
+        "carried_certificate_checks": carried_checks,
+        "unrelated_distinct_keys": len(unrelated_keys),
+        "unrelated_instances": 20,
+        "symmetries_tested": [
+            "arbitrary reorder of exact equations",
+            "reversal of exact equations",
+            "composition of arbitrary reorder and reversal",
+        ],
+    }
+
+    # Exact worst case over every seed at this preset: q has its largest
+    # permitted value, and choosing increment 3 at each prefix step maximizes
+    # the final closed interval endpoint.
+    max_prefix_sum = 3 * ((1 << (shipping["n"] - 1)) - 1)
+    max_last_remainder = max_prefix_sum + 1 + max_prefix_sum // 3
+    max_width_answer = {
+        "q": shipping["q_interval"][1] - 1,
+        "last_remainder": max_last_remainder,
+    }
+    answer_blob = json.dumps(max_width_answer, separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _atomic_elements(max_width_answer)
+    intended_operations = 2 * (shipping["n"] - 2) + 1
+    hinted = _G9_ARMS["hinted"]
+    placebo = _G9_ARMS["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_operations <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": copy.deepcopy(_G9_ARMS),
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": (
+            "hardened"
+            if hinted["attempts"] and hinted["solved"] == 0
+            else "diagnostic_pending"
+        ),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [
+        value
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict) and "pass" in value
+    ]
+    report["all_passed"] = all(gate["pass"] for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=False))
