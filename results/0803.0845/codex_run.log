+def escalate(params: dict) -> dict | str | None:
+    harder = {k: v for k, v in params.items() if k != "_preset"}
+    n = int(harder.get("n", 13))
+    q_bits = int(harder.get("q_bits", 104))
+    quotient_bits = int(harder.get("quotient_bits", 768))
+    if 2 * (n + 2 - 2) + 1 > 300 or q_bits + 48 > 6400:
+        return "cap_bound"
