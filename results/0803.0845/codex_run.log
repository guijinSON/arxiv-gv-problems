+except ImportError:  # The family itself remains standard-library-only.
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "number_theory",
+    "object_regime": "integer_lattice",
+    "computational_core": "other",
