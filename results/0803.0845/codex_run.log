+    "object_regime": "integer_lattice",
+    "computational_core": "other",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "Euclidean division equations over the integers",
+        "superincreasing remainder sequence",
+    ],
+    "verification_operations": [
+        "exact integer remainder",
+        "exact integer comparison",
+        "sorting and exact integer summation",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "After ordering the known-remainder equations by their remainders, the "
+        "adjusted public integers have a highest forward difference equal to the "
+        "pseudo-key; without this invariant one executes multi-precision GCD."
+    ),
+    "hardness_basis": (
+        "Track B: Euclid's multi-integer GCD algorithm solves the shipping "
+        "distribution in O(n L^2) schoolbook bit operations; the measured "
+        "shipping panel averaged 481 Euclidean divisions per instance (3,848 "
+        "over eight instances; 1,100,876,215 bit-operation proxy units and "
+        "about 0.001 s total on the builder host), whereas the compact "
