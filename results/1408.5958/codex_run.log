+
+STRUCTURAL_HINT = (
+    "After the exceptional coefficient in each equation is aligned with its "
+    "variable, subtracting one common diagonal shift leaves a rank-one matrix."
+)
+PLACEBO_HINT = (
+    "Careful organization of the equations and consistent indexing will help "
+    "avoid arithmetic and transcription mistakes in the final vector."
+)
