   258	%\vspace{-1eX}
   259	\begin{theorem}\label{thm:pw}
   260	An ILP instance $A\vec{x}=\vec{b}$ with $n$ variables is 
   261	feasible if and only if 
   262	there exists a graph $G \in {\mathcal G}[A\vec{x}=\vec{b}]$ 
   263	of path-width bounded by $2n$.
   264	%\vspace{-1eX}
   265	\end{theorem}
