   268	
   269	%\vspace{-1eX}
   270	\begin{corollary}\label{cor:pw}
   271	An ILP instance $A\vec{x}=\vec{b}$ with $n$ variables is
   272	feasible if and only if the first order formula $\Phi[A\vec{x}=\vec{b}]$ is
   273	satisfiable 
   274	on the class of graphs with path-width $2n$.
   275	%\vspace{-1eX}
   276	\end{corollary}
