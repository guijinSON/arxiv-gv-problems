+    "bounds": {
+        "array_length": 3,
+        "entry_interval": "inclusive [inst['lower'], inst['upper']]",
+        "parity": "odd",
+        "distinct": True,
+        "role_order": "inst['answer_order']",
+    },
+}
+
+
+STRUCTURAL_HINT = (
+    "The semiperimeter deficiencies place the ratio equation on the paper's "
