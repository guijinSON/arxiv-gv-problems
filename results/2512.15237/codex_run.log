+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the tagged JSON triple, tolerating prose and Markdown fences."""
+
+    try:
