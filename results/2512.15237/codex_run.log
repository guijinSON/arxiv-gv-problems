   722	In Section~\ref{sec:triangles} we intend to find not only one triangle, but an infinite family of triangles for a given rational value of $N=R/r$ for which the rank of $\mathcal{E}_N$ is positive.
   723	To do so, we first notice that the condition~\eqref{condition} in Theorem~\ref{th:2} can be transformed into a nicer form. 
   724	\begin{thm}
   725		\label{th:3}
   726		A rational triangle with rational quotient $R/r=N>1/4$ exists  if and only if $\mathcal{E}_N$ has a rational non-torsion point  $(u,v)$ such that 
   727		\begin{equation}\label{eq-13'}1-4N < u < 0 \quad \text{or} \quad u > 1.\end{equation}
   728		In this case, the sides are given by
   729		$$f=\frac{s}{2x}(A_1-\sqrt{B}), \ g=sx, \ h=\frac{s}{2x}(A_2+\sqrt{B}),$$
   730		where $$x=-\frac{4N(v+2Nu)}{(u-1)(u+4N-1)}$$ and $0<s\in\Q$.
   731	\end{thm}
   732	\begin{proof}
   733		We first note that the curve $\mathcal{E}_N$ intersects $u$-axis in the points
   734		$$u_1=0, \ u_2=-2N^2-2N+1-2N\sqrt{N(N+2)}, \ u_3=-2N^2-2N+1+2N\sqrt{N(N+2)},$$
   735	see Figure~\ref{fig2}.
   736		According to~\eqref{eq-x}, we observe that if $x=0$, then $v=-2Nu$ and if $x=1$, then 
   737		$$v=-\frac{u^2+2(4N^2+2N-1)u-(4N-1)}{4N}.$$ 
   738	Hence the region of points $(u,v)$ satisfying condition~\eqref{condition} is the green region
   739	between the two curves
   740	\begin{align*}
   741	c_1:\ v&= -2Nu,\\	
   742	c_2:\ v&=	-\frac{u^2+2(4N^2+2N-1)u-(4N-1)}{4N}.
   743	\end{align*}
   744	The three curves $c_1,c_2$, and $\mathcal{E}_N$ meet in the torsion points
   745	$$
   746	T_6^-=(1 - 4N, -2N (1 - 4N))\text{ and } T_3^-=(1, -2N), \text{ an inflection point of $\mathcal{E}_N$}.
   747	$$
   748	The curves $c_2$ and $\mathcal{E}_N$ actually have a common tangent in $T_6^-$. Moreover, $c_1$ and $\mathcal{E}_N$ meet in $T_2=(0,0)$.
   749	Hence $\mathcal{E}_N$ crosses the boundary of the green region only in $T_6^-,T_3^-$, and in the origin.
   750	It follows that exactly the points $(u,v)$ on $\mathcal{E}_N$ with $1 - 4n<u<1$ or $u>1$ satisfy condition~\eqref{condition}.
