+    by_role["f"], by_role["h"] = by_role["h"], by_role["f"]
+    corruptions["swap_distinguished"] = [
+        by_role[name] for name in shipping["answer_order"]
+    ]
+    reasons = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(shipping, candidate)
