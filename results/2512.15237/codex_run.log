   761		$$u_{-}<u_2<0, \ 0< u_{+} < u_3<1.$$
   762		%, and we have $u_2<x_1<0$ as well.
   763		
   764	    Now, the condition~\eqref{condition} reduces to:
   765		\begin{equation}
   766			\label{II}
   767			\frac{v-v_0}{(u-1)(u+4N-1)}<0, \ \text{and} \  \frac{v-v_1}{(u-1)(u+4N-1)}>0.
   768		\end{equation}
   769		
   770		\begin{itemize}
   771			\item [1.] $\underline{u_2 < u < 1-4N}$. In this case, $u-1<0$ and $u+4N-1<0$. So, by \eqref{II}, we must have 
   772			$$v<v_0, \ v>v_1,$$ 
   773			which do not have points on common with $\mathcal{E}_N$ on $(u_1,1-4N)$. So, this case is ruled out.
   774			
   775			\item [2.] $\underline{1-4N < u < 0}$. In this case, $u-1<0$ and $u+4N-1>0$, and hence
   776			$$v>v_0, \ v<v_1,$$
   777			which have points on common with $\mathcal{E}_N$ on $(1-4N,0)$. So, in this case we may have real-life triangles.
   778			
   779			\item [3.] $\underline{u_3 < u < 1}$. In this case, $u-1<0$ and $u-1+4N>0$, and hence 
   780			$$v>v_0, \ v<v_1,$$
   781			which do not have points on common with $\mathcal{E}_N$ on $(u_3,1)$. So, this case is ruled out.
   782			
   783			\item [4.] $\underline{u > 1}$. In this case, $u-1>0$ and $u-1+4N>0$ and hence,
   784			$$v<v_0, \ v>v_1,$$
   785			which have points on common with $\mathcal{E}_N$ on $(1,\infty)$. So, this case may have real-life triangles.
   786		\end{itemize} 
