+    "easy": {"n": 256, "lower_eighths": 7},
+    "medium": {"n": 320, "lower_eighths": 6},
+    "hard": {"n": 384, "lower_eighths": 4},
+}
+SHIPPING_DIFFICULTY = "easy"
