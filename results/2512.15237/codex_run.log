   883	\section{The cases $N=m^2\pm 1$}\label{sec-3}
   884	The previous section suggests that if $N>1/4$ is a positive rational number for which the rank of $\mathcal{E}_N$ is positive, we may be able to construct integer triangles with $R/r=N$.
   885	So we are facing two problems: Find  rational numbers $N>1/4$ for which the rank of $\mathcal{E}_N$ is positive, and find rational points on such
   886	curves that satisfy condition~\eqref{eq-13'}.
   887	In Section~\ref{sec:triangles} we will show that whenever $\mathcal{E}_N$ has positive rank, the curve has infinitely many rational points satisfying condition~\eqref{eq-13'},
   888	and that these points lead to infinitely many non-similar integer triangles with $R/r=N$. 
   889	In this section we first show that for each $N=m^2\pm 1>1/4$, $m\in\Q$, the rank of $\mathcal{E}_N$ is positive.
   890	We provide explicit formulas for the sides $f,g,h$ of integer triangles with $R/r=N\in\Q$.   
   891	
   892	\begin{thm}
   893	    \label{th:4}
   894	   % We have
   895	    \begin{itemize}
   896	    	\item [(i)] If $N=m^2+1$ for a rational number $m>1$ the rank of $\mathcal{E}_N$ is positive with a non-torsion point 
   897	    	$$P=\Bigl(\frac{1}{m^2}, \frac{3m^2+1}{m^3}\Bigr)$$
   898	    	such that the point 
   899	    	\begin{multline*}
   900	    		-P-T_6^+=\Bigl(-\frac{(4m^2+3)(m+1)^2}{(2m^2-m+1)^2}, \\ \frac{2(m+1)(4m^2+3)(m^2+1)(2m^3+m^2+2m-1)}{(2m^2-m+1)^3}\Bigr)
   901	    	\end{multline*}
   902	    	leads to the triangle 
   903	    	$$f=(m-1)(2m^2+m+1)^2, \ g=(m+1)(2m^2-m+1)^2, \ h=4m(m^2+1).$$
   904	    	
   905	    	\item[(ii)] If $N=m^2-1>1/4$  for a rational number $m>1$ the rank of $\mathcal{E}_N$ is positive with a non-torsion point 
   906	    	$$P=\Bigl(\frac{1}{m^2}, \frac{m^2-1}{m^3}\Bigr)$$
   907	    	such that the point
   908	    	$$-P-T_6^+=\Bigl(-\frac{4m^2-5}{(2m-1)^2}, \frac{2(m-1)(4m^2-5)(2m^2+m+1)}{(2m-1)^3}\Bigr)$$
   909	    	 leads to the triangle 
   910	    	$$f=(m-1)(2m+1)^2, \ g=(m+1)(2m-1)^2, \ h=4m.$$
   911	    \end{itemize}    
   912	    %Moreover, a geometric description shows that for each case we have infinitely many triangles.  
   913	\end{thm}
   914	\begin{proof}
   915	(i) By enforcing $u=N-1$ on $\mathcal{E}_N$, the expression $N-1$ must be a square, say $m^2$ for some rational number $m$. 
   916	Then, $N=m^2+1$ and the corresponding elliptic curve $\mathcal{E}_N$ owns the rational non-torsion  point
   917	$$P=\Bigl(\frac{1}{m^2}, \frac{3m^2+1}{m^3}\Bigr).$$
   918	By the addition law, we compute 
   919	\begin{multline*}
   920		-P-T_6^+=\Bigl(-\frac{(4m^2+3)(m+1)^2}{(2m^2-m+1)^2}, \\ \frac{2(m+1)(4m^2+3)(m^2+1)(2m^3+m^2+2m-1)}{(2m^2-m+1)^3}\Bigr).
   921	\end{multline*}
   922	By taking 
   923	%$$u=-\frac{(4m^2+3)(m+1)^2}{(2m^2-m+1)^2}, \  v=\frac{2(m+1)(4m^2+3)(m^2+1)(2m^3+m^2+2m-1)}{(2m^2-m+1)^3},$$
   924	%\dc{instead we can write ``By taking $(u,v)=-P-T_6^+$".}
   925	$(u,v)=-P-T_6^+$
   926	we observe that condition~\eqref{eq-13'} holds, hence by Theorem~\ref{th:1} we get 
   927	$$f=(m-1)(2m^2+m+1)^2, \ g=(m+1)(2m^2-m+1)^2, \ h=4m(m^2+1).$$
   928	(ii) In a similar fashion, by enforcing $u=N+1$ on $\mathcal{E}_N$, the expression $N+1$ must be a square, say $m^2$ for some rational number $m$. 
   929	Then, $N=m^2-1$ and the corresponding elliptic curve $\mathcal{E}_N$ owns the rational non-torsion  point
   930	$$P=\Bigl(\frac{1}{m^2}, \frac{m^2-1}{m^3}\Bigr).$$
   931	By the addition law, we compute 
   932	$$-P-T_6^+=\Bigl(-\frac{4m^2-5}{(2m-1)^2}, \frac{2(m-1)(4m^2-5)(2m^2+m+1)}{(2m-1)^3}\Bigr).$$
   933	By taking 
   934	%$$u=-\frac{4m^2-5}{(2m-1)^2}, \quad v= \frac{2(m-1)(4m^2-5)(2m^2+m+1)}{(2m-1)^3},$$
   935	$(u,v)=-P-T_6^+$
   936	we observe that  condition~\eqref{eq-13'} holds, hence by Theorem~\ref{th:1} we get 
   937	$$f=(m-1)(2m+1)^2, \ g=(m+1)(2m-1)^2, \ h=4m.$$
