+    all_failed = all(data["successes"] == 0 for data in attack_data.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and len(attack_data) >= 4,
+        "attacks": attack_data,
+        "domain_standard_attack": "elliptic_rational_height_128",
