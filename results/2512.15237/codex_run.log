import math, random, time

def direct(P,Q):
    a=math.isqrt(P+Q); b=math.isqrt(Q)
    if a*a "'!= P+Q or b*b != Q: return None
    F=(a-b)*(2*a+b)**2
    G=(a+b)*(2*a-b)**2
    H=4*a*b*b
    d=math.gcd(math.gcd(F,G),H)
    return (F//d,G//d,H//d)
# N=(a''^2-b''^2)/b''^2, with odd coprime a,b; no reduction needed.
r=random.Random(251215237); cases=[]
while len(cases)<10000:
 b=r.getrandbits(255)|(1<<254)|1
 a=(b+r.getrandbits(253))|1
 if math.gcd(a,b)==1:
  cases.append((a*a-b*b,b*b))
t=time.perf_counter()
for P,Q in cases: direct(P,Q)
elapsed=time.perf_counter()-t
print('"'cases',len(cases),'total_sec',elapsed,'per_instance_sec',elapsed/len(cases))
print('formula_exact_ops_conservative',18)
