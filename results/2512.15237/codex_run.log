   517	\section{The triangle inequalities}\label{sec-4}
   518	\begin{comment}
   519	\dc{Can this section (and maybe the next section) be rewritten even better?} \cb{How?}
   520	\end{comment}
   521	To simplify the notation, we will use the following abbreviations
   522	$$
   523	\begin{aligned}
   524		A_1&:=-x^2-2(2N-1)x+4N, & A_3&:=x^2-4Nx+4N, \\ 
   525		A_2&:=-x^2+2(2N+1)x-4N, & A_4&:=x^2+4Nx-4N, 
   526	\end{aligned}
   527	$$
   528	and 
   529	$$B:=x^4+4(2N-1)x^3+4(4N^2-2N+1)x^2-32N^2x+16N^2.$$
   530	The following theorem now provides information on the rational points on $\CN$  which correspond to real triangles.
   531	\begin{thm}
   532		\label{th:1}
   533		A rational triangle with rational quotient $R/r=N>1/4$ exists  if and only if $\CN$ has a rational point $(x,y)$ such that $0<x<1$. In this case, the sides of the triangle are given by
   534		$$f=\frac{s}{2x}(A_1-\sqrt{B}), \ g=sx, \ h=\frac{s}{2x}(A_2+\sqrt{B}),$$
   535		for $0<s\in\Q$.
   536	\end{thm}
   537	\begin{proof}
   538	Let $f,g,h$ be sides of a rational triangle with $R/r=N$. Then, as we have seen in Section~\ref{sec-2}, $(x,y)$ must be a rational point on $\CN$.
   539	From $g=sx$ in~\eqref{6}, we infer that $x>0$. On the other hand, we have from the triangle inequality
   540	$$
   541	0<f-g+h\ \ \iff\ \  2g<f+g+h\ \ \iff\ \ x=\frac gs=\frac{2g}{f+g+h}<1.
   542	$$
   543	For the opposite direction, assume we have a rational point $(x,y)$ on $\CN$ with $0<x<1$. We may also assume that $y>0$.
   544	For $g=sx$, equation~\eqref{6} has the following roots for $f$:
   545	$$f_{\pm}=\frac{s}{2x} (A_1\pm \sqrt{B}).$$
   546	Note that by \eqref{8}, $0<\sqrt{B}=y\in\Q$.  
   547	
   548	By $h_\mp=2s-f_\pm-g$, we get the following two values:
   549	$$h_{\mp}=\frac{s}{2x}(A_2\mp \sqrt{B}),$$
   550	and hence
   551	\begin{align}
   552		f_\pm+g-h_\mp&=\frac{s}{x}(A_3\pm \sqrt{B}), \nonumber \\
   553		f_\pm+h_\mp-g&=-2s(x-1), \label{x<1}\\
   554		g+h_\mp-f_\pm&=\frac{s}{x}(A_4\mp \sqrt{B}). \nonumber
   555	\end{align}
   556	%By the second formula of \eqref{x<1} and the triangle inequality, one must have $x<1$. On the other hand $g=sx$ implies $x>0$, since $g>0$. Hence we always must have $0<x<1$. 
   557	%Note that we look for real-life triangles.
   558	
   559	We observe that
   560	$$B-A_2^2=16Nx(x-1)^2>0 \Longrightarrow B>A_2^2 \Longrightarrow \sqrt{B}>A_2 \Longrightarrow h_{-}<0.$$
   561	Hence, the root $f=f_{+}$ does not lead to a triangle. So, we will take $f=f_{-}$ and $h=h_+$. In this case, we have the following. 
   562	\begin{comment}
   563	\dc{Can the following items and text be
   564		rephrased better in shape and writing? If needed/possible, we can also shorten some
   565		places?}
   566	\cb{How?}
   567	\end{comment}
   568	\begin{itemize}
   569		\item Since $N>0$ and $0<x<1$, we have $A_1>0$. Then
   570		$$
   571		\begin{aligned}
   572			f>0 & \Longleftrightarrow A_1-\sqrt{B}>0 \Longleftrightarrow A_1>\sqrt{B}\\
   573			& \Longleftrightarrow A_1^2>B  \Longleftrightarrow A_1^2-B=-16Nx(x-1)>0,
   574		\end{aligned}
   575		$$
   576		which is the case. 
   577		\item %$h=h_{+}>0$ since we have:
   578		%$$
   579		%\begin{aligned}
   580		%	B>A_2^2 & \Longrightarrow (\sqrt{B}-A_2)(\sqrt{B}+A_2)>0\\
   581		%	& \Longrightarrow \sqrt{B}-A_2>0, \sqrt{B}+A_2>0 \ \text{or} \  \sqrt{B}-A_2<0, \sqrt{B}+A_2<0.
   582		%\end{aligned}
   583		%$$
   584		%But the second case cannot happen, otherwise $0<\sqrt{B}<A_2$ which gives $B-A_2^2<0$, a contradiction. Therefore, the first case happens and hence $h_{+}>0$.  
   585		%%% Simpler:
   586		Since $B>A_2^2$, it follows that $h=h_+>0$.
   587		\item Trivially, we have $g=sx>0$.
   588		\end{itemize}
   589		 It remains to check that $f,g,h$ satisfy the triangle inequalities.
   590		\begin{itemize}
   591		\item Since $N>0$ and $0<x<1$, we have $A_3>0$. Then we have
   592		$$
   593		\begin{aligned}
   594			f+g-h>0 & \Longleftrightarrow A_3-\sqrt{B}>0 \Longleftrightarrow A_3>\sqrt{B}\\
   595			& \Longleftrightarrow A_3^2>B  \Longleftrightarrow A_3^2-B=-4x^2(x-1)(4N-1)>0,
   596		\end{aligned}
   597		$$
   598		which is the case. 
   599		\item To show $g+h-f>0$ it is enough to show that $A_4+\sqrt{B}>0$. We have:
   600		$$
   601		\begin{aligned}
   602			B-A_4^2&=-4x^2(x-1)>0  \Longrightarrow (\sqrt{B}-A_4)(\sqrt{B}+A_4)>0\\
   603			& \Longrightarrow \sqrt{B}-A_4>0, \sqrt{B}+A_4>0 \ \text{or} \  \sqrt{B}-A_4<0, \sqrt{B}+A_4<0.
   604		\end{aligned}
   605		$$
   606		But the second case cannot happen, since then $0<\sqrt{B}<A_4$ implies $B-A_4^2<0$, a contradiction. Therefore, the first case happens and hence $g+h-f>0$.
   607		\item Finally, we have $f+h-g>0$ by~\eqref{x<1}.
   608	\end{itemize}
   609	\end{proof}
   610	We can carry over the previous result from $\CN$ to the elliptic curve $\mathcal{E}_N$.
   611	\begin{thm}
   612		\label{th:2}
   613		A rational triangle with rational quotient $R/r=N>1/4$ exists  if and only if $\mathcal{E}_N$ has a rational non-torsion point
   614		 $(u,v)$ such that 
   615		\begin{equation}
   616			\label{condition}
   617			0<-\frac{4N(v+2Nu)}{(u-1)(u+4N-1)}<1.
   618		\end{equation}
   619		In this case, the sides are given by
   620		$$f=\frac{s}{2x}(A_1-\sqrt{B}), \ g=sx, \ h=\frac{s}{2x}(A_2+\sqrt{B}),$$
   621		where $$x=-\frac{4N(v+2Nu)}{(u-1)(u+4N-1)}$$ and $0<s\in\Q$.
   622	\end{thm}
