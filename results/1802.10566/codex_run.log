+        ),
+        "offsets_per_pair": DIFFICULTY[SHIPPING_DIFFICULTY]["offsets_per_pair"],
+    }
+    doubled = make_instance(seed=23, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
