+def _compact_survivors(relations, k: int, modulus: int):
+    """Triangle-supported offsets, exploiting the cyclic encoding."""
+    survivors = {}
+    for i in range(k):
+        for j in range(i + 1, k):
+            keep = []
+            for delta in relations[i, j]:
+                supported_everywhere = True
