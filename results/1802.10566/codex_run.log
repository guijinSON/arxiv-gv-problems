import random,time

def off(D,i,j,m):return D[i,j] if i<j else [(-x)%m for x in D[j,i]]
def compatible(D,x,m):
 return all((x[j]-x[i])%m in D[i,j] for i in range(len(x)) for j in range(i+1,len(x)))
def anchor(D,k,m,d):
 out=[];ops=0
 for a in D[0,1]:
  x=[0,a];ok=True
  for i in range(2,k):
   vals=[]
   B=set(D[1,i])
   for b in D[0,i]:
    ops+=1
    if (b-a)%m in B:vals.append(b)
   if len(vals)"'!=1:ok=False;break
   x.append(vals[0])
  if ok and compatible(D,x,m):out.append(x)
 return out,ops
def survok(D,s,k,m):
 for i in range(k):
  for j in range(i+1,k):
   keep=[]
   for delta in D[i,j]:
    good=True
    for h in range(k):
     if h in (i,j):continue
     B=set(off(D,h,j,m))
     if not any((delta-a)%m in B for a in off(D,i,h,m)):
      good=False;break
    if good:keep.append(delta)
   if keep != [(s[j]-s[i])%m]:return False
 return True
def run(k,m,d,seed,maxtries=10000):
 r=random.Random(seed);t=time.time()
 for tr in range(1,maxtries+1):
  s=[r.randrange(m) for _ in range(k)];D={}
  for i in range(k):
   for j in range(i+1,k):
    vals={(s[j]-s[i])%m}
    while len(vals)<d:vals.add(r.randrange(m))
    vals=list(vals);r.shuffle(vals);D[i,j]=vals
  want=[(v-s[0])%m for v in s]
  got,_=anchor(D,k,m,d)
  if got==[want] and survok(D,s,k,m):return tr,time.time()-t
 return None,time.time()-t
for p in [(4,11,2),(8,43,3),(10,67,3),(12,97,4)]:
 print(p,[run(*p,s)[0] for s in range(20)])
