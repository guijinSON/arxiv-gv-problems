+    reasons = {row["reason"] for row in rejected.values()}
+    report["G2_rejects_corruption"] = {
+        "pass": all(row["rejected"] for row in rejected.values()) and len(reasons) == 5,
+        "cases": rejected,
+        "distinct_reasons": len(reasons),
