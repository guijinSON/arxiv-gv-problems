+            ze = ("ZE", i, a, j, b)
+            xi = ("X", i, a, j)
+            xj = ("X", j, b, i)
+            add(r1, zij, 1)
+            add(zij, ze, 1)
+            add(ze, xi, 1)
+            add(ze, xj, 1)
