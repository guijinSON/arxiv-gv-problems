+    report["G1_planted_verifies"] = {
+        "pass": verified == 12,
+        "verified": verified,
+        "attempts": 12,
+        "failures": failures,
+    }
+
+    ship = make_instance(seed=3, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = ship["answer"]
+    swapped = planted[:]
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    corruptions = {
+        "drop": planted[:-1],
+        "swap": swapped,
+        "duplicate": [planted[0], planted[0]] + planted[2:],
+        "empty": [],
+        "out_of_range": [-1] + planted[1:],
