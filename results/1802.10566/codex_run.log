+        gauges = [rng.randrange(modulus) for _ in range(k)]
+        relations = {}
+        for i in range(k):
+            for j in range(i + 1, k):
+                planted = (gauges[j] - gauges[i]) % modulus
+                values = {planted}
+                while len(values) < width:
+                    values.add(rng.randrange(modulus))
