+def _reference_algorithm(inst: dict):
+    """Generic candidate-pair path consistency, without cyclic compression."""
+    start = time.perf_counter()
+    k, modulus = inst["k"], inst["modulus"]
+    relations = _relation_map(inst)
+    relation_sets = {
+        (i, j): set(_offsets(relations, i, j, modulus))
+        for i in range(k) for j in range(k) if i != j
+    }
+    retained = {}
+    operations = 0
+    for i in range(k):
+        for j in range(i + 1, k):
+            pair_survivors = set()
+            for left_value in range(modulus):
+                for delta in relations[i, j]:
+                    right_value = (left_value + delta) % modulus
+                    supported_everywhere = True
+                    for h in range(k):
