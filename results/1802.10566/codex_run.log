+            for delta in relations[i, j]:
+                supported_everywhere = True
+                for h in range(k):
+                    if h == i or h == j:
+                        continue
+                    right_offsets = set(_offsets(relations, h, j, modulus))
+                    support = False
+                    for left_offset in _offsets(relations, i, h, modulus):
+                        operations += 1
