+    attacks = {
+        name: [_globalize(inst, values)] if len(values) == inst["k"] else [[]]
+        for name, values in local.items()
+    }
+    attacks["random_restart_256"] = [
+        random_candidate(inst, rng) for _ in range(256)
+    ]
+    return attacks
+
