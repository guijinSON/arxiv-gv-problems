+    triangles = []
+    for i in range(k):
+        for j in range(i + 1, k):
+            for h in range(j + 1, k):
+                histogram = {}
+                for left in relations[i, j]:
+                    for right in relations[j, h]:
+                        for direct in relations[i, h]:
+                            residue = (left + right - direct) % modulus
+                            histogram[residue] = histogram.get(residue, 0) + 1
