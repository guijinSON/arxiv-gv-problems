+    "demo": {"n": 4, "modulus": 11, "offsets_per_pair": 2},
+    "easy": {"n": 8, "modulus": 43, "offsets_per_pair": 3},
+    "medium": {"n": 10, "modulus": 67, "offsets_per_pair": 3},
+    "hard": {"n": 12, "modulus": 97, "offsets_per_pair": 4},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
