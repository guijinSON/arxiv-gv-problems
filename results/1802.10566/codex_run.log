+def escalate(params) -> dict | str | None:
+    """Grow the candidate universe while leaving the witness length fixed."""
+    harder = dict(params)
+    current = int(harder.get("modulus", 97))
+    harder["modulus"] = _next_prime((3 * current) // 2 + 1)
+    harder["offsets_per_pair"] = int(harder.get("offsets_per_pair", 4))
+    harder["n"] = int(harder.get("n", 12))
+    return harder
