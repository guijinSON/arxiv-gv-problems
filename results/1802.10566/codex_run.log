+    for i in range(k):
+        a = values[i]
+        yi = ("Y", i)
+        yv = ("YV", i, a)
+        add(r2, yi, 1)
+        add(yi, yv, 1)
+        for j in range(k):
+            if i == j:
+                continue
+            xij = ("X", i, a, j)
+            lij = ("L", i, j)
