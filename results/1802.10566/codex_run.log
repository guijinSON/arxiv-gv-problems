+def enumerate_all(inst) -> int | None:
+    """Brute-force the bounded blueprint language only when it is small."""
+    if search_space(inst) > 250_000:
+        return None
+    count = 0
+    k, modulus = inst["k"], inst["modulus"]
+    for values in itertools.product(range(modulus), repeat=k):
+        count += int(_compatible_locals(inst, list(values)))
+    return count
