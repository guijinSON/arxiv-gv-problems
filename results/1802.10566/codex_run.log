                dot += matrix[row][col] * residual[row]
                ops += 2
            choices.append((abs(dot), -col, col))
        support.append(max(choices)[2])
        support.sort()
        local = [0]
        candidate = _restricted_fit(inst, support, local)
        ops += local[0]
