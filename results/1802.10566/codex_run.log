+                isinstance(value, list)
+                and all(isinstance(x, int) and not isinstance(x, bool) for x in value)
+            ):
+                return value
+            return None
+        if not re.fullmatch(r"-?\d+(?:\s*,\s*-?\d+)*", body):
+            return None
+        return [int(part.strip()) for part in body.split(",")]
