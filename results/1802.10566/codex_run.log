import random,time

def build(k,m,d,seed):
 r=random.Random(seed);s=[r.randrange(m) for _ in range(k)];D={}
 for i in range(k):
  for j in range(i+1,k):
   v={(s[j]-s[i])%m}
   while len(v)<d:v.add(r.randrange(m))
   D[i,j]=sorted(v)
 return s,D

def os(D,i,j,m):return D[i,j] if i<j else [(-x)%m for x in D[j,i]]
def ref(k,m,d,D):
 t=time.perf_counter();ops=0;surv={}
 for i in range(k):
  for j in range(i+1,k):
   keep=set()
   for x in range(m):
    for delta in D[i,j]:
     y=(x+delta)%m;good=True
     for h in range(k):
      if h in (i,j):continue
      A=set(os(D,i,h,m)); B=set(os(D,h,j,m))
      support=False
      for z in range(m):
       ops+=1
       if (z-x)%m in A and (y-z)%m in B:
        support=True;break
      if not support:good=False;break
     if good:keep.add(delta)
   surv[i,j]=keep
 return ops,time.perf_counter()-t,surv
s,D=build(12,47,4,0)
print(ref(12,47,4,D)[:2])
