+def _reference_algorithm(inst: dict):
+    """Generic candidate-pair path consistency, without cyclic compression."""
+    start = time.perf_counter()
+    k, modulus = inst["k"], inst["modulus"]
+    relations = _relation_map(inst)
+    relation_sets = {
+        (i, j): set(_offsets(relations, i, j, modulus))
+        for i in range(k) for j in range(k) if i != j
+    }
+    retained = {}
+    operations = 0
+    for i in range(k):
+        for j in range(i + 1, k):
+            pair_survivors = set()
+            for left_value in range(modulus):
+                for delta in relations[i, j]:
+                    right_value = (left_value + delta) % modulus
+                    supported_everywhere = True
+                    for h in range(k):
+                        if h == i or h == j:
+                            continue
+                        support = False
+                        for middle_value in range(modulus):
+                            operations += 1
+                            if (
+                                (middle_value - left_value) % modulus
+                                in relation_sets[i, h]
+                                and (right_value - middle_value) % modulus
+                                in relation_sets[h, j]
+                            ):
+                                support = True
+                                break
+                        if not support:
+                            supported_everywhere = False
+                            break
+                    if supported_everywhere:
+                        pair_survivors.add((left_value, right_value))
+            retained[i, j] = pair_survivors
+
+    values = [0]
+    for j in range(1, k):
+        choices = sorted(
+            right for left, right in retained[0, j] if left == 0
+        )
+        if len(choices) != 1:
+            return None, time.perf_counter() - start, operations
+        values.append(choices[0])
+    answer = [i * modulus + values[i] for i in range(k)]
+    return answer, time.perf_counter() - start, operations
+
