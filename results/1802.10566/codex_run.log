+                if (value - first) % modulus in allowed_from_one:
+                    choices.append(value)
+            if len(choices) != 1:
+                viable = False
+                break
+            values.append(choices[0])
+        if viable:
+            if all(
+                (values[j] - values[i]) % modulus in relations[i, j]
+                for i in range(k) for j in range(i + 1, k)
+            ):
