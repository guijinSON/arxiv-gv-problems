+        "structure_aware": True,
+        "language_size": search_space(density_inst),
+        "sampling_wall_sec": round(density_wall, 6),
+    }
+
+    attack_successes = {}
+    reference_successes = 0
+    reference_times = []
+    reference_operations = []
+    for seed in range(8):
