+def random_candidate(inst, rng) -> object:
+    """Sample one in-range candidate from each explicitly stated color group."""
+    modulus = inst["modulus"]
+    return [i * modulus + rng.randrange(modulus) for i in range(inst["k"])]
+
+
+def search_space(inst) -> int | None:
+    return inst["modulus"] ** inst["k"]
+
+
+def enumerate_all(inst) -> int | None:
+    """Brute-force the bounded blueprint language only when it is small."""
+    if search_space(inst) > 250_000:
+        return None
+    count = 0
+    k, modulus = inst["k"], inst["modulus"]
+    for values in itertools.product(range(modulus), repeat=k):
+        count += int(_compatible_locals(inst, list(values)))
+    return count
+
