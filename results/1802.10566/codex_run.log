    chosen = sorted(range(inst["n"]), key=lambda j: (abs(partial[j]), -j),
                    reverse=True)[:inst["k"]]
    pool = _coefficient_values(inst["coeff_num"], inst["coeff_den"])
    label_to_display = {tuple(label): j for j, label in enumerate(inst["atom_labels"])}
    terms = []
