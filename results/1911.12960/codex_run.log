   444	\begin{theorem}\label{theoMOLS}
   445	Suppose that
   446	\begin{itemize} \item $M_2\subset M_1\subset M$ is a super
   447	$MDS(2,5,p)$ code, \item $D$ is an $MDS(2,5,q)$ code, \item $E$ is
   448	an $MDS(2,5,q_1-q)$ code on alphabet $A$,\item $F$ is an
   449	$MDS(2,5,q_1)$ code with $4$-$A$-hole,\item  $G$ is an
   450	$MDS(2,5,q_1)$ code with $5$-$A$-hole, where $|A|=q_1-q$.
   451	\end{itemize}
   452	 Then
   453	 the set $C=E\cup (M_2\times_A G) \cup ((M_1\setminus M_2)\times_A F)\cup
   454	((M\setminus M_1)\times D)$ is an $MDS(2,5,(p-1)q+q_1)$ code.
   455	\end{theorem}
   456	\begin{proof}
   457	By the hypotheses of the theorem for any $y\in G$ there exist three
   458	$i\in \{1,\dots,5\}$ such that $y_i\not \in A$. Since code distance
   459	of $M_2$ equals $5$, for any $x,x'\in M_2$ all coordinates are
   460	different. Consequently, if $(x,y)\neq (x',y')$ then $\pi_A(x,y)\neq
   461	\pi_A(x',y')$ for $x,x'\in M_2$ and $y,y'\in G$. Therefore
   462	$|M_2\times_A G|=|M_2\times G|=|M_2||G|$. By the same way we can
   463	prove that $|M_2\times_A F|=|M_2||F|$ and $|M_1\times_A
   464	F|=|M_1||F|$. Then it holds
   465	$$|C|=|E|+|M_2||G|+(|M_1|-|M_2|)|F|+(|M|-|M_1|)|D|=$$
   466	$$(q_1-q)^3+p(q_1^3-(q_1-q)^3)+(p^2-p)(q^3+3q^2(q_1-q))+
   467	(p^3-p^2)q^3=(pq+q_1-q)^3.$$ The code distance of $X\times Y$ is the
   468	minimum of the code distances of $X$ and $Y$. If elements of $Y$
   469	contains not more than $k$ symbols from $A$ then $\rho(X\times_A
   470	Y)\geq \min(\rho(X)-k,\rho(Y))$. Hence the interior distances of the
   471	codes $E$, $M_2\times_A G$, $(M_1\setminus M_2)\times_A F)$ and
   472	$(M\setminus M_1)\times D$ are not less than $3$ by the hypotheses
   473	of the theorem. The distance between codes $(M\setminus M_1)\times
   474	D$ and $E$ equals $5$. The distance between $(M\setminus M_1)\times
   475	D$ and $(M_1\setminus M_2)\times_A F$ (or $M_2\times_A G$) is not
   476	less than the distance between $(M\setminus M_1)\times D$ and
   477	$(M_1\setminus M_2)\times F$ (or $M_2\times G$). This distance is
   478	not less than the distance between $M\setminus M_1$ and
   479	$M_1\setminus M_2$ (or $M_2$), i.\,e., it is not less than the code
   480	distance of $M$.
   481	
   482	We have that $U_2(E)\cap F=U_2(E)\cap G=\varnothing$ by the
   483	definition of a code with $j$-$A$-hole. Thus the distance between
   484	$E$ and  $(M_1\setminus M_2)\times_A F$ (or $M_2\times_A G$) is not
   485	less than the distance between  $E$ and  $F$ or $G$, i.\,e., it is
   486	not less than $3$.
   487	
   488	The distance between  $M_1\setminus M_2$ and $M_2$ is equal to $4$.
   489	Take $(x_0,x_1,x_2,x_3,x_4)$ from $M_1\setminus M_2$.
   490	%$(x_0,x'_1,x'_2,x'_3,x'_4)\in M_2$ where $x'_i\neq x_i$ for $i=1,2,3,4$. Then
   491	Each element of $(x_0,x_1,x_2,x_3,x_4)\times_A F$ contains not more
   492	than one symbol from $A$. Consequently, the distance between
   493	$(x_0,x_1,x_2,x_3,x_4)\times_A F$ and $M_2\times_A G$ is not less
   494	than $4-1=3$.
   495	
   496	By the Singleton bound (Proposition \ref{proNM5})  $C$ is an MDS
   497	code.
   498	\end{proof}
   499	
   500	It is easy to see that the MDS code $C$  constructed by using the
   501	theorem above contains subcodes of orders $q$ and $q_1$. These
   502	subcodes  are $\overline{x}\times D$, where $\overline{x}\in
   503	M\setminus M_1$, and $E\cup (\overline{x}\times_A G)$, where
   504	$\overline{x}\in M_2$.
   505	
   506	
   507	
   508	\begin{proposition}\label{proMOLS}
   509	Let $k\leq p$ and  $i\in \{1,\dots,k\}$. Suppose
   510	\begin{itemize} \item $M$ is an  $MDS(2,5,p)$ code that
   511	contains $k$ disjoint $MDS(3,5,p)$ codes $C_i$,\item $D$ is an
   512	$MDS(2,5,q)$ code,\item $F_i$  is an $MDS(2,5,q_1)$ code over
   513	alphabet $Q_q\cup A_i$ with $4$-$A_i$-hole, where $|A_i|=q_1-q$,
   514	$A_i\cap A_j=\varnothing$ if $i\neq j$.\end{itemize}
   515	 Then
   516	 the set $S=(\bigcup_{i=1}^k C_i\times_{A_i} F_i)\cup ((M\setminus \bigcup_{i=1}^k C_i)\times D)$
   517	 is an $MDS(2,5,(p-k)q+kq_1)$ code with $4$-$B$-hole, where $B=\bigcup_{i=1}^k A_i$.
   518	\end{proposition}
   519	\begin{proof}
   520	By the hypotheses of the proposition for any $y\in F_i$ there exists

