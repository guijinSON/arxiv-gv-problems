from itertools import combinations
L={1,3,4,5,10,14,18,21,25,36,45,60,100,147,150,175,196,225,245,252,300,315,350,882,980,1050,1470,1575,1764,2940,7350,14700}
pos=[0,1,2,3,4,6,7,8,9,10]
def cf(n):
 n=abs(n)
 p=2;r=1
 while p*p<=n:
  e=0
  while n%p==0:n//=p;e+=1
  r*=p**(e%3)
  p+=1
 if n>1:r*=n
 return r
for t in combinations(pos,3):
 r,s,u=t
 D=cf((s-u)*(u-r)*(r-s))
 if D in L: print(t,D)
