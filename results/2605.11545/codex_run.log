+        "preset_candidate_spaces": dict(zip(DIFFICULTY, ladder_spaces)),
+        "doubled_n": doubled["n"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+    }
+
+    # G8: arbitrary row/column relabellings and their composition over 20 seeds.
+    invariant_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    unrelated_keys = []
