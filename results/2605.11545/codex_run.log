+            if r == pivot_row:
+                continue
+            factor = aug[r][column]
+            if not factor:
+                continue
+            for j in range(column, n + 1):
+                aug[r][j] = (aug[r][j] - factor * aug[pivot_row][j]) % _P
+                operations += 2
