+    residual = [(-value) % _P for value in inst["rhs"]]
+    steps = 0
+    for _ in range(passes):
+        changed = False
+        for j in range(n):
+            old_score = sum(value == 0 for value in residual)
+            sign = 1 if vector[j] == 0 else -1
