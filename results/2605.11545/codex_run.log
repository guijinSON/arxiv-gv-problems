+
+    # G1: every named preset, several independent seeds, including JSON safety.
+    g1_attempts = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
