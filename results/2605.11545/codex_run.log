+
+def escalate(params: dict) -> dict | None:
+    """Increase n while the compact route remains under the 300-operation cap."""
+    if not isinstance(params, dict) or set(params) != {"n"}:
+        return None
+    n = params["n"]
+    if not isinstance(n, int) or n >= 145:
+        return None
