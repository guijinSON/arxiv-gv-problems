+    if len(answer) != n:
+        return False, f"wrong length: expected {n}, got {len(answer)}"
+    for j, char in enumerate(answer):
+        if char not in "01":
+            return False, f"non-binary character at position {j}"
+    vector = [ord(char) - 48 for char in answer]
+    for i, (row, target) in enumerate(
