+    bits = []
+    for j in range(n):
+        score = sum(
+            signed(inst["coefficient_matrix"][i][j]) * signed(inst["rhs"][i])
+            for i in range(n)
+        )
+        bits.append("1" if score > 0 else "0")
+    return "".join(bits)
