+def _choose_shift(n: int, rng: random.Random) -> int:
+    choices = [s for s in range(1, n) if math.gcd(s, n) == 1]
+    if not choices:
+        raise ValueError("n has no nonzero coprime cyclic shift")
+    return rng.choice(choices)
