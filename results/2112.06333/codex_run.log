+                    a_to_c.setdefault(av, set()).add(cv)
+                for bv, cv in cb:
+                    b_to_c.setdefault(bv, set()).add(cv)
+                c_to_b = {}
+                for bv, cvs in b_to_c.items():
+                    for cv in cvs:
+                        c_to_b.setdefault(cv, set()).add(bv)
+                for av, cvs in a_to_c.items():
