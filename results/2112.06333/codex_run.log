+    # G8: vertex relabelling, edge reordering, color symmetry, compositions.
+    invariant_checks = 0
+    real_transform_checks = 0
+    unrelated_keys = []
+    g8_failures = []
+    for seed in range(9200, 9220):
+        base = make_instance(seed=seed, **shipping)
