+    n = inst["num_vertices"]
+    q = inst["num_colors"]
+    adj = _adjacency(inst)
+    best = None
+    best_bad = math.inf
+    for _ in range(restarts):
+        colors = [rng.randrange(q) for _ in range(n)]
