+        seen = {u}
+        frontier = {u}
+        layers = []
+        while frontier:
+            nxt = set()
+            for v in frontier:
+                nxt.update(adj[v])
+            nxt.difference_update(seen)
+            if not nxt:
+                break
+            layers.append(len(nxt))
+            seen.update(nxt)
+            frontier = nxt
