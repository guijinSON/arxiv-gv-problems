+    n = inst["n"]
+    m = inst["clause_count"]
+    length = 2 * n + m
+    edges = []
+
+    for i in range(length + 1):
+        u, v = f"a{2 * i}", f"a{2 * i + 1}"
+        edges.extend(((u, v), (u, v)))
+    for i in range(1, length + 1):
+        edges.append((f"a{2 * i - 1}", f"a{2 * i}"))
+    for i in range(1, n + 1):
+        edges.extend(
+            (
+                (f"a{2 * i - 1}", f"y{i}"),
+                (f"y{i}", f"a{2 * i}"),
+            )
+        )
+    for j in range(1, m + 1):
+        offset = n + j
+        edges.extend(
+            (
+                (f"a{2 * offset - 1}", f"C{j}"),
+                (f"C{j}", f"a{2 * offset}"),
+            )
+        )
+    for i in range(1, n + 1):
+        offset = n + m + i
+        edges.extend(
+            (
+                (f"a{2 * offset - 1}", f"z{i}"),
+                (f"z{i}", f"a{2 * offset}"),
+            )
+        )
