def escalate(params):
    """Tighten constraints first, then grow n up to the 256-atom cap."""

    n = int(params.get("n", 150))
    degree = int(params.get("degree", 6))
    if degree < 8:
        return {"n": n, "degree": 8}
    harder = n + 18
    if harder > 252:
        return "cap_bound"
    while (harder * degree) % 6:
        harder += 1
    if harder > 252:
        return "cap_bound"
    return {"n": harder, "degree": degree}


