        "nodes": 0,
        "node_limit": node_limit,
        "clause_inspections": 0,
        "propagations": 0,
        "limit_reached": False,
    }

    def solve(assignment):
        stats["nodes"] += 1
        if stats["nodes"] > node_limit:
            raise _DPLLLimit
        assignment = assignment[:]

