assert g.verify(demo,demo['answer'][:-1])==(False,'wrong length: expected 6 entries, got 5')
worst=json.dumps([-(i+1) for i in range(174)],separators=(',',':'))
assert len(worst)==rep['G9_no_tool_suitability']['answer_chars']==763
print('final audit: PASS')
print('gates:', ', '.join(k for k in rep if k.startswith('G')))
print('bare oracle:', [(r['model'],r['seed'],r['verify_reason']) for r in rows])
