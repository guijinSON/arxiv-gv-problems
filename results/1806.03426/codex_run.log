+    "medium": {"n": 174, "degree": 6},
+    "hard": {"n": 198, "degree": 6},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Each clause vertex records whether its three incident literal choices occupy "
