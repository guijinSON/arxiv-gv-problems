+    order = ["a0"]
+    last_middle = len(middle)
+    for position, vertex in enumerate(middle, 1):
+        order.append(f"a{2 * position - 1}")
+        if position == 1:
+            order.extend(early)
+        order.append(vertex)
+        if position == last_middle:
+            order.extend(late)
+        order.append(f"a{2 * position}")
+    order.append(f"a{2 * last_middle + 1}")
+    return order
