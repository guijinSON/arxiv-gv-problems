   410	\section{Upper bound for $c$}\label{sekcija_upper_c}
   411	
   412	The goal of this section is to prove an upper bound for $c$ in terms of $a_2$ and $b$ and to prove one lower bound for $a_2$ in terms of $a_1$.
   413	\begin{theorem}\label{tm5.1}
   414	    Assume that $\{a_1,b,c,d\}$ and $\{a_2,b,c,d\}$ are $D(4)$-quadruples with $a_1<a_2<b<c<d$. Then the following hold:
   415	    \begin{enumerate}[1)]
   416	        \item $a_2>2a_1$;
   417	        \item $0.25a_1^2b^3 < c < 0.25a_2^2b^3$.
   418	    \end{enumerate}
   419	\end{theorem}
   420	
   421	We begin by improving \cite[Theorem 1.2]{mbtap1}.
   422	
   423	\begin{theorem}  \label{tm5.2}
   424	    If $\{a_1,b,c\}$ and $\{a_2,b,c\}$ are $D(4)$-triples with $a_1<a_2<b<c\leq 0.25a_1^2b^3$, then $\{a_1,a_2,b,c\}$ is a $D(4)$-quadruple.
   425	\end{theorem}
   426	\begin{proof}
   427	   This statement and the proof are the same as \cite[Theorem 1.2]{mbtap1} with the assumption $c\leq 0.25b^3$ replaced by $c \leq 0.25a_1^2b^3$. 
   428	\end{proof}
   429	
   430	Since \cite[Theorem 1]{nas2} holds, Theorem \ref{tm5.2} has the following corollary, which proves the first inequality of the second statement in Theorem \ref{tm5.1}.
   431	
   432	\begin{cor}\label{cor: donja na c i d}
   433	If $\{a_1,b,c,d\}$ and $\{a_2,b,c,d\}$ are $D(4)$-quadruples with $a_1<a_2<b<c<d$, then $c>0.25a_1^2b^3$ and $d>0.25a_1^2c^3$.
   434	\end{cor}
   435	\begin{proof}
   436	    First, assume that $c \leq 0.25a_1^2b^3$. By using the previous theorem on $D(4)$-triples $\{a_1,b,c\}$ and $\{a_2,b,c\}$  we get that $\{a_1,a_2,b,c\}$ is a $D(4)$-quadruple, so $\{a_1,a_2,b,c,d\}$ is a $D(4)$-quintuple, which cannot hold. For the second statement, assume that $d \leq 0.25a_1^2c^3$.\ By using the previous theorem on $\{a_1,c,d\}$ and $\{a_2,c,d\}$ we get that $\{a_1,a_2,c,d  \}$ is a $D(4)$-quadruple, so $\{a_1,a_2,b,c,d \}$ is a $D(4)$-quintuple, which is a contradiction.
   437	\end{proof}
   438	
   439	The proof of Corollary \ref{cor: nereg} now easily follows.
   440	
   441	\begin{proof}[Proof of Corollary \ref{cor: nereg}]
   442	Notice that since $a_ibc+4c>r_is_it$ we have $d_+(a_i,b,c) < a_ibc + 4c$. On the other hand, since $c>0.25a_1^2b^3$, we have 
   443	$$d>0.25a_1^2c^3>0.25a_1^2(0.25a_1^2b^3)^2c>0.25^3a_1^6b^4a_2bc.$$
   444	So, by using the fact that $b>10^5$ it is easy to see that $d>d_+(a_2,b,c)>d_+(a_1,b,c)$.
   445	\end{proof}
   446	
   447	
   448	
   449	\begin{proof}[Proof of Theorem \ref{tm5.1}]
   450	\emph{1)} Assume that $a_2\leq 2a_1$.
   451	By Corollary \ref{cor: donja na c i d} we know $c>0.25a_1^2b^3$. We can use Theorem \ref{tm: gornje_ograde} since $a_1'=4a_1$, $b>10^5$, $b>a_2>a_2-a_1\geq 2$, hence 
   452	$$N=a_1a_2c>\frac{0.25}{8}10^5a_1'a_2^2(a_2-a_1)^2>396.59a_1'a_2^2(a_2-a_1)^2.$$
