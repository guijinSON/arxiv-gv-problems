   257	\end{proof}
   258	
   259	
   260	From \cite[Lemma 2.6]{mbt} we know that a regular quadruple is obtained as a solution of $z=v_m=w_n$ for $m,n\leq 2$. Moreover, \cite[Lemma 2.10]{mbt} together with \cite[Theorem 1.3]{mbt} gives us the next lower bound for $n$ and $m$.
   261	\begin{lemma}\label{lema: n vece 7}
   262	If $v_m=w_n$ has a solution for $m>2$, then $6\leq m \leq  2n + 1$ and $n \geq 7$.
   263	\end{lemma}
   264	
   265	\begin{lemma}[{\cite[Lemma 2.9]{mbt}}]\label{lemma: epsilon}
   266	    Assume that $z=v_m=w_n$ has a solution for some integers $m$ and $n$. If $c>b^{\varepsilon}$, $b>10^5$, $1 \leq \varepsilon < 12$, then 
   267	    $$ m < \frac{\varepsilon+1}{0.999\varepsilon}n + 1.5 - 0.4\frac{\varepsilon+1}{0.999\epsilon}.$$
   268	\end{lemma}
   269	The next lemma gives us a lower bound for index $n$ in terms of elements $b$ and $c$ and will be used throughout the paper in combination with Lemma \ref{lemma: gornja_n_1}. 
   270	\begin{lemma}\label{lema: donja na n u terminima b i c}
   271	    Assume that $c>\max\{0.56b^3,0.001a_2^2b^2\}$ and $b>10^5$. If $z=v_m=w_n$ has a solution for some integers $m$ and $n$ with $n\geq 4$, then $m\equiv n\ (\bmod \ 2)$ and $n>0.09226b^{-1/2}c^{1/4}$ for odd $n$ and $n>0.340134b^{-1/2}c^{1/2}$ for even $n$.
   272	\end{lemma}
   273	
   274	\begin{proof}
   275	    As in the proof of \cite[Lemma 3.1]{mbt} we know that $m\equiv n \ (\bmod \ 2)$. 
   276	
   277	    First, if $m$ and $n$ are even, we consider the case $z_0=z_1=\pm 2$. Since $c>0.56b^3>b^{2.94}$, we have $\varepsilon=2.94$ in Lemma \ref{lemma: epsilon} which yields
   278	    $m<1.3415n+0.97.$
   279	From Lemma \ref{lema: n vece 7} we have $n\geq 8$ so we can take
   280	$m<1.47n.$
   281	These observations are applied to \cite[Lemma 4.1]{mbt} with parameters $L=1.47$, $\rho=1$, $a_0=3$, $b_0=10^5$, $c_0=0.56\cdot10^{15}$ (Note that Lemma requires $\rho>1$, but the same holds for $\rho=1$). We get 
   282	$m>0.499997b^{-1/2}c^{1/2},$
   283	hence
   284	$$n>0.340134b^{-1/2}c^{1/2}.$$
   285	
   286	Second, we consider the case when $m$ and $n$ are odd. From Lemma \ref{lema: n vece 7} we have $n\leq m$ and $n\geq 7$ so we can, similarly as before, take
   287	$m<1.48n.$
   288	
   289	From the proof of \cite[Lemma 13]{fil_xy4} we know that the congruences 
   290	\begin{align}
   291	    \pm 2t(a_2 m(m+1)-bn(n+1))& \equiv 2r_2s_2(n-m)\ (\bmod \ c),\label{cong: prva_nep}\\
   292	    \pm 2s_2(a_2 m(m+1)-bn(n+1))& \equiv 2r_2t(n-m)\ (\bmod \ c)\nonumber,
   293	\end{align}
   294	hold. Since $s_2t\equiv 16\ (\bmod \ c)$ after multiplying both sides of these congruences we see that we have
   295	\begin{equation}\label{eqn:congruence_neparni}
   296	    64(a_2m(m+1)-bn(n+1))^2\equiv 64r_2^2(m-n)^2\ (\bmod \ c).
   297	\end{equation}
   298	Assume to the contrary, that $n\leq 0.09226b^{-1/2}c^{1/4}$. 
   299	
   300	If we show that 
   301	$$|a_2m(m+1)-bn(n+1)|+r_2(m-n)<\frac{c^{1/2}}{64},$$
   302	then we know that (\ref{eqn:congruence_neparni}) is an equality.  First, let us assume that $bn(n +1)\geq a_2m(m+1)$. Then, since $r_2<b$ we have
   303	\begin{align*}
   304	    bn(n+1)-&a_2m(m+1)+r_2(m-n)\\
   305	    &<bn^2+bn+0.48r_2n-a_2m(m+1)\\
   306	    &<bn^2+0.96bn<1.5bn^2.
   307	\end{align*}
   308	And since we assumed $n\leq 0.09226b^{-1/2}c^{1/4}$ we have $1.5n^2<0.0128c^{1/2}<1/64\cdot c^{1/2}$. 
   309	
   310	Now, assume that $bn(n +1)< a_2m(m+1)$. Then
   311	\begin{align*}
   312	    a_2m(m+1)-&bn(n+1)+r_2(m-n)\\
   313	    &<1.48a_2n(1.48n+1)-bn(n+1)+r_2\cdot 0.48 n\\
   314	    &<n^2(2.1904a_2-b)+n(1.48a_2-b)+0.481n\sqrt{a_2 b}.
   315	\end{align*}
   316	Since $a_2<b<c^{1/3}$ and $0.56\cdot10^{15}<c$ and $n\leq 0.09226b^{-1/2}c^{1/4}$ we further have,
   317	\begin{align*}
   318	    a_2m(m+1)-&bn(n+1)+r_2(m-n)<\\
   319	    &<(1.1904\cdot 0.09226^2+0.961\cdot 0.09226\cdot 10^{-15/12}\cdot 0.56^{-1/6})c^{1/2}\\
   320	    &<1/64c^{1/2}.
   321	\end{align*}
   322	So, congruence (\ref{eqn:congruence_neparni}) is an equality, which yields
   323	\begin{equation}\label{eqn: jdkost_iz_kong}
   324	    |a_2m(m+1)-bn(n+1)|=r_2(m-n).
   325	\end{equation}
   326	After inserting that in congruence (\ref{cong: prva_nep}) we get
   327	\begin{equation}\label{eqn: cong_2}
   328	2r_2(m-n)(\pm t+s_2)\equiv 0\ (\bmod \ c).
   329	\end{equation}
   330	Since $n\leq 0.09226b^{-1/2}c^{1/4}$ and $c^{1/4}>0.1778\sqrt{ab}$, inequality
   331	\begin{align*}
   332	    2r_2(m-n)|\pm t+s_2|&<0.96nr_2\cdot 2t\\
   333	    &<1.92n\cdot 1.0002\sqrt{a_2 b}\cdot 1.00001\sqrt{bc}<c,
   334	\end{align*}
   335	asserts that (\ref{eqn: cong_2}) is also an equality:
   336	$$2r_2(m-n)(\pm t+s_2)= 0.$$
   337	So, either $t=s_2$ or $m=n$. From $t=s_2$, we would have $b=a_2$, which cannot hold. If $m=n$, from (\ref{eqn: jdkost_iz_kong}) we would also get $a_2=b$, a contradiction. 
   338	
   339	This implies that our assumption was wrong and $n>0.09226b^{-1/2}c^{1/4}$. 
   340	\end{proof}
   341	
   342	Let us consider the first step of constructing $D(4)$-pairs $\{a_1,b\}$ and $\{a_2,b\}$ when $a_1$ and $a_2$ are given integers. We have that $b=(r_1^2-4)/a_1$, where $r_1$ is a solution to the equation 
   343	$$r_1^2a_2-r_2^2a_1=4(a_2-a_1),$$
   344	with unknowns $(r_1,r_2)$. We can rewrite this equation and observe
   345	\begin{equation}\label{eq:pellova_konacno}
   346	(r_1a_2)^2-r_2^2(a_1a_2)=4a_2(a_2-a_1).
   347	\end{equation}
   348	If $a_1a_2$ is a perfect square, this is the equation of a form
   349	\begin{equation}\label{eq:razlika_kv}(r_1a_2)^2-(r_2\sqrt{a_1a_2})^2=4a_2(a_2-a_1)\end{equation}
   350	which has only finitely many solutions for each pair $\{a_1,a_2\}$. 
   351	
   352	On the other hand, if $a_1a_2$ isn't a perfect square, (\ref{eq:pellova_konacno}) is a Pellian equation whose solutions can be easily described for any fixed pair $\{a_1,a_2\}$. 
   353	
   354	If we are extending $D(4)$-pairs $\{a_1,b\}$ and $\{a_2,b\}$ to $D(4)$-triples $\{a_1,b,c\}$ and $\{a_2,b,c\}$ we have a very similar problem to solve. The element $c$ is equal to $(s_1^2-4)/a_1$ where $s_1$ is obtained from equation (\ref{eq:pellova_konacno}) or (\ref{eq:razlika_kv}) in which $(r_1,r_2)$ is replaced by $(s_1,s_2)$. Thus, both $b$ and $c$ are elements of the solution sequences of the Pellian equation (\ref{eq:pellova_konacno}) or elements of the set of finitely many solutions of equation (\ref{eq:razlika_kv}).
   355	
   356	In most of our proofs, we'll be dealing with finitely many remaining pairs $\{a_1,a_2\}$ with known upper (and lower) bounds for the elements $b$ and $c$. This means to complete the proof, it will be sufficient to search for elements of solution sequences that also satisfy some given bounds.
   357	
   358	
   359	\section{Note on applying Lemma \ref{lemma: gornja_n_1}}\label{sekcija_treca}
   360	
   361	Let $\{a_1,b,c,d\}$ and $\{a_2,b,c,d\}$ be such $D(4)$-quadruples that the assumptions made in Theorem \ref{tm: gornje_ograde} and Lemma \ref{gornje_ograde3} hold, i.e. that Lemma \ref{lemma: gornja_n_1} holds. Let us assume that $a_1,a_2$ and $b$ are fixed values and consider the function
   362	$$
   363	\varphi(c)=
   364	\frac{8\log(8.4034 \cdot 10^{13} a_1^{1/2}(a_1')^{1/2}a_2^2c)\log(0.20533a_1^{1/2}a_2^{1/2}(a_2-a_1)^{-1}c)}{\log(bc)\log(0.01685a_1(a_1')^{-1}a_2^{-1}(a_2-a_1)^{-2}c)}.$$
   365	In many cases, when using Lemma \ref{lemma: gornja_n_1}, it is useful to demonstrate that this function decreases with respect to
   366	 $c$  for the observed values of 
   367	 $c$. This allows us to obtain an upper bound for $\varphi(c)$ when we replace $c$ with its lower bound (usually the lower bound is expressed in terms of $a_1$, $a_2$ and/or $b$).
   368	
   369	Since $a_2>a_1\geq 1$, it can easily be seen that $$0.20533a_1^{1/2}a_2^{1/2}(a_2-a_1)^{-1}>0.01685a_1(a_1')^{-1}a_2^{-1}(a_2-a_1)^{-2}$$ so
   370	$$\varphi_1(c)=\frac{\log(0.20533a_1^{1/2}a_2^{1/2}(a_2-a_1)^{-1}c)}{\log(0.01685a_1(a_1')^{-1}a_2^{-1}(a_2-a_1)^{-2}c)}>1$$
   371	and $\varphi_1(c)$ is decreasing in $c$. 
   372	
   373	Our goal is to reach the same conclusion regarding
   374	$$\varphi_2(c)=\frac{\log(8.4034 \cdot 10^{13} a_1^{1/2}(a_1')^{1/2}a_2^2c)}{\log(bc)},$$
   375	i.e. we need to show that $b<8.4034 \cdot 10^{13}a_1^{1/2}(a_1')^{1/2}a_2^2$. Hence, if both $\varphi_1(c)$ and $\varphi_2(c)$ are decreasing and both $\varphi_1(c)>0$ and $\varphi_2(c)>0$ it implies that $\varphi(c)$ is decreasing in $c$. 
   376	
   377	Since \cite[Theorem 1.2]{mbtap1} states that $c>0.25b^3$ and $0.25b^3>0.25\cdot 10^5a_2^2$ it is easy to see that all arguments of logarithms in the expression for $\varphi(c)$ are greater than $1$ except maybe $0.01685a_1(a_1')^{-1}a_2^{-1}(a_2-a_1)^{-2}c$. So, we must check that 
   378	\begin{equation}\label{ineq:provjera za c}
   379	c>(0.01685a_1(a_1')^{-1}a_2^{-1}(a_2-a_1)^{-2})^{-1}=0.01685^{-1}a_1^{-1}a_1'a_2(a_2-a_1)^2
   380	\end{equation}
   381	holds to conclude that $\varphi(c)$ is decreasing in $c$.
   382	
   383	Let us first prove that $b\geq 8.4034 \cdot 10^{13}a_1^{1/2}(a_1')^{1/2}a_2^2$ cannot hold. 
   384	
   385	\begin{lemma}\label{lemma: gornja an b}
   386	     Assume that $\{a_1,b,c,d\}$ and $\{a_2,b,c,d\}$ are $D(4)$-quadruples with $a_1<a_2<b<c<d$. Then 
   387	     $$b< 8.4034 \cdot 10^{13}a_1^{1/2}(a_1')^{1/2}a_2^2.$$
   388	\end{lemma}
   389	\begin{proof}
   390	Let us assume to the contrary,  
   391	$b>8.4034 \cdot 10^{13}a_1^{1/2}(a_1')^{1/2}a_2^2.$ 
   392	Since $c>0.25a_1^2b^3$, we also have
   393	\begin{equation}c>1.186\cdot 10^{42}a_1^5a_2^6\label{jdba_donja_c}
   394	\end{equation}
   395	for both options $a_1'\in\{4a_1,4(a_2-a_1)\}$. Observe that 
   396	\begin{align*}8.4034\cdot 10^{13}a_1^{1/2}(a_1')^{1/2}a_2^2&<1.681\cdot 10^{14}\cdot a_2^3,\\
   397	0.20533a_1^{1/2}a_2^{1/2}(a_2-a_1)^{-1}&<0.102665\cdot a_2,\\
   398	0.01685a_1(a_1')^{-1}a_2^{-1}(a_2-a_1)^{-2}&>0.0042125\cdot a_2^{-4}.\end{align*}
   399	Now, from Lemma \ref{lemma: gornja_n_1} we have
   400	$$n<\frac{\log(1.681\cdot 10^{14}\cdot a_2^3c)\log(0.102665\cdot a_2c)}{\log(2.376\cdot 10^{14}\cdot a_2^2c)\log(0.0042125\cdot a_2^{-4}c)}.$$
   401	The right-hand side of this inequality is decreasing in $c$, so we can use (\ref{jdba_donja_c}), $n>0.09226(c/b^2)^{1/4}$ and $c/b^2>0.25a_1^2b\geq 0.25b>4.2\cdot 10^{13}\cdot a_2^2$ in the previous inequality. We get that it cannot hold for $a_2>1$.
   402	\end{proof}
   403	
   404	We have the following corollary from these observations and Lemma \ref{lemma: gornja an b}.
   405	\begin{cor}\label{cor: primjena leme 3.4}
   406	   Let $\{a_1,b,c,d\}$ and $\{a_2,b,c,d\}$ be $D(4)$-quadruples such that the assumptions of Lemma \ref{lemma: gornja_n_1} hold. If $c>0.01685^{-1}a_1^{-1}a_1'a_2(a_2-a_1)^2$, then the function $\varphi(c)$ is decreasing in $c$.
   407	\end{cor}
