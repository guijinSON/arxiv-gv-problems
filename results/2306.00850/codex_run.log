   459	 8.4034\cdot 10^{13}a_1^{1/2}(a_1')^{1/2}a_2^2c&<1.68068\cdot 10^{14}a_2^3c,\\
   460	 0.20533a_1^{1/2}a_2^{1/2}(a_2-a_1)^{-1}c&<0.102665a_2c,\\
   461	 0.01685a_1(a_1')^{-1}a_2^{-1}(a_2-a_1)^{-2}c&>0.01685a_2^{-3}c.
