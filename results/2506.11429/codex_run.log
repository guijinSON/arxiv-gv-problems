and\\
\indent If \  $Q_{1\phantom{-}}=Q_{2\phantom{-}}=Q_{3\phantom{-}}=Q_5=0$, then $Q_7 Q_{0\phantom{-}}^2=-Q_4^2 Q_{-1}(1-Q_0^2/4)$.\\
\indent If \ $Q_{0\phantom{-}}=Q_{1\phantom{-}}=Q_{2\phantom{-}}=Q_4=0$, then $Q_6 Q_{-1}^2=-Q_3^2 Q_{-2}$.\\
