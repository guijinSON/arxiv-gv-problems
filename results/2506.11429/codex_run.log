\end{equation}
Then it follows that
\begin{equation}
\begin{aligned}
&W_{10}=\prod _{i=1}^2 \prod _{j=1}^5 \left(a_i-b_j\right)\:,\\
&W_{11}=(a_1+a_2)\cdot W_{10}\:,\\
