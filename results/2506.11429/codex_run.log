g6 = next((v for k, v in gates.items() if k.startswith("G6")), None)
atk = (g6 or {}).get("attacks")
n_atk = len(atk) if isinstance(atk, (dict, list)) else 0
if g6 is not None and not isinstance(atk, (dict, list)):
