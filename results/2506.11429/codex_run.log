+def _pair_features(pair, degree, counter):
+    """Centered even moments that determine pair sums through odd degree."""
+    delta = pair[1] - pair[0]
+    delta2 = delta * delta
+    counter["operations"] += 2
+    features = [delta2]
+    power = delta2
+    for _exponent in range(4, degree, 2):
