+"""Verified Prouhet--Tarry--Escott problem generator for arXiv:2506.11429.
+
+The generator samples a weighted Boolean cube first.  The even- and odd-parity
+subset sums have identical power sums below the cube dimension.  A positive
+integer affine map and a random permutation then hide that construction.  The
+planted PTE half is therefore known by composition of identities, never by
+solving the emitted instance.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "number_theory",
+    "object_regime": "integer_lattice",
+    "computational_core": "subset_sum",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "finite set of non-negative integers",
+        "two equal-cardinality integer arrays with equal power sums",
+    ],
+    "verification_operations": [
+        "exact integer membership and cardinality checks",
+        "exact integer exponentiation",
+        "exact comparison of four pairs of power sums",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Recognize an affine image of a Boolean subset-sum cube and use subset "
+        "parity, whose signed moments vanish below the cube dimension; otherwise "
+        "search balanced subsets against several simultaneous moment targets."
+    ),
+    "hardness_basis": (
+        "Track B: a balanced meet-in-the-middle search on cardinality and four "
+        "power sums runs in O(4*2^(N/2)) time and O(2^(N/2)) memory; at the "
+        "easy shipping preset the included exact implementation used at most "
+        "645,448 counted operations in at most 0.425068 seconds across eight measured seeds, "
+        "whereas affine normalization and Boolean-cube reconstruction take fewer "
+        "than 300 exact arithmetic operations but require seeing the invariant."
+    ),
+    "max_answer_tokens": 128,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+# n is the bit length of the hidden subset-sum generators.  scale_bits is an
+# independent fixed-answer-length hardness dial: together they determine the
+# exact-integer size without changing the 16-number witness at non-demo levels.
+DIFFICULTY = {
+    "demo": {"n": 5, "dimension": 3, "scale_bits": 4},
+    "easy": {"n": 48, "dimension": 5, "scale_bits": 48},
+    "medium": {"n": 72, "dimension": 5, "scale_bits": 80},
+    "hard": {"n": 96, "dimension": 5, "scale_bits": 112},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "After an affine normalization, the numbers form a Boolean subset-sum cube "
+    "whose two subset-parity classes have matching low-order moments."
+)
+PLACEBO_HINT = (
+    "Careful organization of the displayed integers helps avoid transcription "
+    "errors while comparing the required low-order moments."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An unordered JSON array containing exactly half of the distinct integers "
+        "displayed in the instance; no value may repeat, and the other half is its "
+        "set complement."
+    ),
+    "bounds": {
+        "max_pool_size": 32,
+        "max_answer_elements": 16,
+        "max_value_bits": 512,
+        "values_must_come_from_instance": True,
+        "repetitions": False,
+        "order_matters": False,
+    },
+}
+
+NOTES = (
+    "Section 1.1 fixes the native PTE definition: two distinct integer arrays of "
+    "the same size have equal sums of k-th powers for k=1,...,degree. The same "
+    "section states Prouhet's existence result for every degree and explicitly "
+    "proves that a common integer dilation and translation preserve a solution. "
+    "It also identifies the small easy boundary m<=degree (no non-trivial "
+    "solution), while Chapter 6 gives a computer-search process rather than a "
+    "hardness theorem. Accordingly this family is Track B, not Track A. The "
+    "weighted Boolean-cube identity is built directly: the signed exponential "
+    "generating function is the product of (1-exp(w_i*t)), so its first d-1 "
+    "moments vanish. The witness is transported through the paper's affine map "
+    "and a permutation. Both parity classes use the same integer distribution "
+    "and there are no decoys. The adversary panel tests magnitude outliers, "
+    "largest-first balancing, sorted alternation, and structure-aware random "
+    "restarts; the successful meet-in-the-middle reference algorithm is reported "
+    "separately, as Track B requires."
+)
+
+# Filled from the three independent harden.py runs before release.  The harness
+# owns the transcript files; this small summary lets selftest expose G9.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
+    "hinted_verdict": "pending",
+}
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _valid_parameters(n, dimension, scale_bits):
+    return (
+        _is_int(n)
+        and _is_int(dimension)
+        and _is_int(scale_bits)
+        and 5 <= n <= 256
+        and 3 <= dimension <= 5
+        and 4 <= scale_bits <= 256
+        and n >= dimension + 1
+    )
+
+
+def _subset_sums(weights):
+    sums = [0]
+    masks = [0]
+    for bit, weight in enumerate(weights):
+        old_sums = list(sums)
+        old_masks = list(masks)
+        sums.extend(value + weight for value in old_sums)
+        masks.extend(mask | (1 << bit) for mask in old_masks)
+    return sums, masks
+
+
+def _sample_weights(rng, n, dimension):
+    """Sample positive n-bit weights with gcd one and distinct subset sums."""
+    low, high = 1 << (n - 1), 1 << n
+    for _attempt in range(10000):
+        weights = [rng.randrange(low, high) for _ in range(dimension)]
+        if math.gcd(*weights) != 1:
+            continue
+        sums, _masks = _subset_sums(weights)
+        if len(set(sums)) == 1 << dimension:
+            return weights
+    raise RuntimeError("could not sample dissociated coprime weights")
+
+
+def make_instance(n, seed=0, dimension=5, scale_bits=48, **params):
+    """Construct a PTE instance from a known weighted Prouhet identity.
+
+    The certificate exists before the visible values do: even- and odd-parity
+    subsets of d weights have equal moments through degree d-1.  Construction
+    then composes this identity with an integer affine map and a permutation.
+    """
+    if params:
+        raise ValueError("unsupported parameters: " + ", ".join(sorted(params)))
+    if not _valid_parameters(n, dimension, scale_bits):
+        raise ValueError("need 5<=n<=256, 3<=dimension<=5, and 4<=scale_bits<=256")
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    weights = _sample_weights(rng, n, dimension)
+    raw_sums, masks = _subset_sums(weights)
+
+    scale = rng.randrange(1 << (scale_bits - 1), 1 << scale_bits)
+    shift_bits = n + scale_bits
+    shift = rng.randrange(1 << (shift_bits - 1), 1 << shift_bits)
+    tagged = [
+        (scale * raw, mask)
+        for raw, mask in zip(raw_sums, masks)
+    ]
+    tagged = [(value + shift, mask) for value, mask in tagged]
+    rng.shuffle(tagged)
+
+    values = [value for value, _mask in tagged]
+    answer = sorted(
+        value for value, mask in tagged if mask.bit_count() % 2 == 0
+    )
+    return {
+        "degree": dimension - 1,
+        "side_size": 1 << (dimension - 1),
+        "values": values,
+        "n_bits": n,
+        "scale_bits": scale_bits,
+        "answer": answer,
+    }
+
+
+def _decode_instance(inst):
+    if not isinstance(inst, dict):
+        return None
+    degree = inst.get("degree")
+    side_size = inst.get("side_size")
+    values = inst.get("values")
+    if (
+        not _is_int(degree)
+        or not 2 <= degree <= 4
+        or not _is_int(side_size)
+        or side_size != 1 << degree
+        or not isinstance(values, list)
+        or len(values) != 2 * side_size
+        or any(not _is_int(value) or value < 0 for value in values)
+        or len(set(values)) != len(values)
+    ):
+        return None
+    return degree, side_size, values
+
+
+def render(inst):
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        raise ValueError("malformed instance")
+    degree, side_size, values = decoded
+    rows = "\n".join(f"  {index}: {value}" for index, value in enumerate(values, 1))
+    statement = f"""Balanced Prouhet--Tarry--Escott witness
+
+Below are {len(values)} distinct non-negative integers. Choose exactly {side_size}
+of the displayed VALUES. Call your chosen set A and let B be the set complement
+among all displayed values. For every exponent k = 1, 2, ..., {degree}, the exact
+integer power sums must agree:
+
+    sum(a**k for a in A) = sum(b**k for b in B).
+
+The labels before the colons are only row numbers and are not part of the values.
+Order in A does not matter. Repetition is forbidden, all {side_size} submitted
+integers must occur in the display, and B contains every displayed integer not in
+A. Arithmetic is over ordinary integers with no rounding or modulus.
+
+Displayed integers:
+{rows}
+
+Give your final answer inside <answer></answer> tags as one JSON array of exactly
+{side_size} displayed integer values. Example: <answer>[12, 37, 105]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Parse the tagged JSON array, tolerating prose and markdown fences."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\s*>(.*?)</answer\s*>", text, flags=re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, flags=re.I | re.S)
+    if fence:
+        body = fence.group(1).strip()
+    try:
+        answer = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(answer, list) or any(not _is_int(value) for value in answer):
+        return None
+    return answer
+
+
+def verify(inst, answer):
+    """Check any submitted PTE half by exact substitution; never use the plant."""
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        return False, "malformed instance"
+    degree, side_size, values = decoded
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if not answer:
+        return False, "answer is empty"
+    if any(not _is_int(value) for value in answer):
+        return False, "every answer entry must be an integer"
+    if len(answer) != side_size:
+        return False, f"answer has {len(answer)} entries; expected exactly {side_size}"
+    if len(set(answer)) != len(answer):
+        return False, "answer repeats a value"
+    pool = set(values)
+    outside = [value for value in answer if value not in pool]
+    if outside:
+        return False, f"answer value {outside[0]} is not in the displayed set"
+
+    chosen = set(answer)
+    other = pool - chosen
+    for exponent in range(1, degree + 1):
+        left = sum(pow(value, exponent) for value in chosen)
+        right = sum(pow(value, exponent) for value in other)
+        if left != right:
+            return False, f"power {exponent} sums differ by {left - right}"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample a correctly-sized half of the displayed integers."""
+    decoded = _decode_instance(inst)
+    if decoded is None or not isinstance(rng, random.Random):
+        raise ValueError("need a valid instance and random.Random")
+    _degree, side_size, values = decoded
+    return sorted(rng.sample(values, side_size))
+
+
+def search_space(inst):
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        raise ValueError("malformed instance")
+    _degree, side_size, values = decoded
+    return math.comb(len(values), side_size)
+
+
+def enumerate_all(inst):
+    """Count all witnesses exactly only when at most 200,000 candidates exist."""
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        raise ValueError("malformed instance")
+    _degree, side_size, values = decoded
+    if search_space(inst) > 200000:
+        return None
+    count = 0
+    for candidate in itertools.combinations(values, side_size):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def _gcd_counted(values):
+    result = 0
+    remainders = 0
+    for value in values:
+        a, b = abs(result), abs(value)
+        while b:
+            a, b = b, a % b
+            remainders += 1
+        result = a
+    return result, remainders
+
+
+def _compact_cube_recover(inst):
+    """Recover a parity half from the visible affine cube, with operation count."""
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        return None, {"operations": 0, "reason": "malformed instance"}
+    degree, side_size, values = decoded
+    dimension = degree + 1
+    shift = min(values)
+    differences = [value - shift for value in values]
+    scale, remainder_ops = _gcd_counted(differences)
+    if scale <= 0:
+        return None, {"operations": 0, "reason": "zero affine scale"}
+    normalized = [difference // scale for difference in differences]
+
+    ordered = sorted(normalized)
+    sum_to_mask = {0: 0}
+    additions = 0
+    for bit in range(dimension):
+        unexplained = next((value for value in ordered if value not in sum_to_mask), None)
+        if unexplained is None:
+            return None, {"operations": 0, "reason": "cube dimension collapsed"}
+        additions_here = {
+            subtotal + unexplained: mask | (1 << bit)
+            for subtotal, mask in list(sum_to_mask.items())
+        }
+        additions += len(sum_to_mask)
+        if set(additions_here) & set(sum_to_mask):
+            return None, {"operations": 0, "reason": "non-dissociated cube"}
+        sum_to_mask.update(additions_here)
+    if set(sum_to_mask) != set(normalized) or len(sum_to_mask) != 2 * side_size:
+        return None, {"operations": 0, "reason": "not a complete subset-sum cube"}
+
+    answer = sorted(
+        value
+        for value, norm in zip(values, normalized)
+        if sum_to_mask[norm].bit_count() % 2 == 0
+    )
+    # Exact arithmetic only: one subtraction and division per value, every
+    # Euclidean remainder, and every subset-sum addition. Comparisons/lookups are
+    # deliberately not described as arithmetic operations.
+    operations = len(values) + remainder_ops + len(values) + additions
+    ok, reason = verify(inst, answer)
+    return (answer if ok else None), {
+        "operations": operations,
+        "subtractions": len(values),
+        "euclidean_remainders": remainder_ops,
+        "exact_divisions": len(values),
+        "subset_sum_additions": additions,
+        "reason": reason,
+    }
+
+
+def _moment_vectors(values, degree, counter):
+    vectors = []
+    for value in values:
+        row = []
+        power = 1
+        for _exponent in range(1, degree + 1):
+            power *= value
+            counter["operations"] += 1
+            row.append(power)
+        vectors.append(tuple(row))
+    return vectors
+
+
+def _mitm_reference(inst):
+    """Generic balanced multi-moment meet-in-the-middle solver.
+
+    This intentionally knows nothing about affine cubes or the planted answer.
+    It is the successful Track B reference algorithm, not an adversary failure.
+    """
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        return None, {"operations": 0, "lookups": 0, "wall_clock_sec": 0.0}
+    degree, side_size, values = decoded
+    if len(values) > 40:
+        return None, {"operations": 0, "lookups": 0, "wall_clock_sec": 0.0}
+    start = time.perf_counter()
+    counter = {"operations": 0}
+    moments = _moment_vectors(values, degree, counter)
+    targets = []
+    for exponent in range(degree):
+        total = sum(row[exponent] for row in moments)
+        if total % 2:
+            return None, {
+                "operations": counter["operations"],
+                "lookups": 0,
+                "wall_clock_sec": time.perf_counter() - start,
+            }
+        targets.append(total // 2)
+
+    split = len(values) // 2
+    right_moments = moments[split:]
+    right_size = len(right_moments)
+    right_states = [(0,) * (degree + 1)] * (1 << right_size)
+    right_index = {}
+    zero = (0,) * (degree + 1)
+    right_states[0] = zero
+    right_index[zero] = 0
+    for mask in range(1, 1 << right_size):
+        bit_value = mask & -mask
+        bit = bit_value.bit_length() - 1
+        previous = right_states[mask ^ bit_value]
+        row = right_moments[bit]
+        state = (previous[0] + 1,) + tuple(
+            previous[index + 1] + row[index] for index in range(degree)
+        )
+        counter["operations"] += degree + 1
+        right_states[mask] = state
+        right_index.setdefault(state, mask)
+
+    left_moments = moments[:split]
+    left_states = [(0,) * (degree + 1)] * (1 << split)
+    lookups = 0
+    for mask in range(1 << split):
+        if mask:
+            bit_value = mask & -mask
+            bit = bit_value.bit_length() - 1
+            previous = left_states[mask ^ bit_value]
+            row = left_moments[bit]
+            state = (previous[0] + 1,) + tuple(
+                previous[index + 1] + row[index] for index in range(degree)
+            )
+            counter["operations"] += degree + 1
+            left_states[mask] = state
+        else:
+            state = left_states[0]
+        needed = (side_size - state[0],) + tuple(
+            targets[index] - state[index + 1] for index in range(degree)
+        )
+        counter["operations"] += degree + 1
+        lookups += 1
+        right_mask = right_index.get(needed)
+        if right_mask is None:
+            continue
+        answer = [
+            values[index]
+            for index in range(split)
+            if mask & (1 << index)
+        ]
+        answer.extend(
+            values[split + index]
+            for index in range(right_size)
+            if right_mask & (1 << index)
+        )
+        answer.sort()
+        if verify(inst, answer)[0]:
+            return answer, {
+                "operations": counter["operations"],
+                "lookups": lookups,
+                "right_states": 1 << right_size,
+                "wall_clock_sec": time.perf_counter() - start,
+            }
+    return None, {
+        "operations": counter["operations"],
+        "lookups": lookups,
+        "right_states": 1 << right_size,
+        "wall_clock_sec": time.perf_counter() - start,
+    }
+
+
+def _outlier_extremes(inst):
+    _degree, side_size, values = _decode_instance(inst)
+    ordered = sorted(values)
+    half = side_size // 2
+    return sorted(ordered[:half] + ordered[-(side_size - half):])
+
+
+def _greedy_largest_first(inst):
+    _degree, side_size, values = _decode_instance(inst)
+    left, right = [], []
+    left_sum = right_sum = 0
+    for value in sorted(values, reverse=True):
+        if len(left) >= side_size:
+            right.append(value)
+            right_sum += value
+        elif len(right) >= side_size:
+            left.append(value)
+            left_sum += value
+        elif left_sum <= right_sum:
+            left.append(value)
+            left_sum += value
+        else:
+            right.append(value)
+            right_sum += value
+    return sorted(left)
+
+
+def _sorted_alternation(inst):
+    _degree, _side_size, values = _decode_instance(inst)
+    return sorted(values)[::2]
+
+
+def canonical_key(inst):
+    """Canonicalize input order, integral affine maps, and global reflection."""
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        raise ValueError("malformed instance")
+    degree, side_size, values = decoded
+    minimum = min(values)
+    differences = [value - minimum for value in values]
+    scale = math.gcd(*differences)
+    if scale <= 0:
+        raise ValueError("degenerate affine scale")
+    normalized = sorted(value // scale for value in differences)
+    maximum = normalized[-1]
+    reflected = sorted(maximum - value for value in normalized)
+    canonical = min(normalized, reflected)
+    payload = json.dumps(
+        {"degree": degree, "side_size": side_size, "values": canonical},
+        separators=(",", ":"),
+    ).encode()
+    return hashlib.sha256(payload).hexdigest()
+
+
+def escalate(params):
+    """Increase two fixed-answer-length bit-size dials until characters bind."""
+    if not isinstance(params, dict):
+        raise ValueError("params must be a dict")
+    n = params.get("n")
+    dimension = params.get("dimension", 5)
+    scale_bits = params.get("scale_bits")
+    if not _valid_parameters(n, dimension, scale_bits):
+        raise ValueError("malformed parameters")
+    if dimension < 5:
+        return {"n": max(48, n + 8), "dimension": 5, "scale_bits": max(48, scale_bits + 8)}
+    # A one-sided 16-value answer stays below 2,000 characters until the two
+    # bit lengths total roughly 380.  Stop conservatively before crossing it.
+    if n + scale_bits + 56 > 360:
+        return "cap_bound"
+    return {"n": n + 24, "dimension": dimension, "scale_bits": scale_bits + 32}
+
+
+def _transform_instance(inst, multiplier, translation, permutation=None):
+    decoded = _decode_instance(inst)
+    if decoded is None or not _is_int(multiplier) or multiplier == 0 or not _is_int(translation):
+        raise ValueError("bad transformation")
+    _degree, _side_size, values = decoded
+    transformed = [multiplier * value + translation for value in values]
+    transformed_answer = [multiplier * value + translation for value in inst["answer"]]
+    if min(transformed) < 0:
+        raise ValueError("transformation left the non-negative regime")
+    if permutation is not None:
+        if sorted(permutation) != list(range(len(values))):
+            raise ValueError("bad permutation")
+        transformed = [transformed[index] for index in permutation]
+    return {
+        "degree": inst["degree"],
+        "side_size": inst["side_size"],
+        "values": transformed,
+        "n_bits": inst.get("n_bits"),
+        "scale_bits": inst.get("scale_bits"),
+        "answer": sorted(transformed_answer),
+    }
+
+
+def _answer_atom_count(answer):
+    if isinstance(answer, dict):
+        return sum(_answer_atom_count(value) for value in answer.values())
+    if isinstance(answer, (list, tuple)):
+        return sum(_answer_atom_count(value) for value in answer)
+    return 1
+
+
+def selftest():
+    """Run correctness, resistance, scaling, canonicalization, and G9 gates."""
+    report = {}
+
+    # G1: every preset, several unrelated seeds; also enforce JSON-native answers.
+    g1_failures = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 271828):
+            inst = make_instance(seed=seed, **params)
+            g1_attempts += 1
+            ok, reason = verify(inst, inst["answer"])
+            json_ok = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            if not ok or not json_ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": reason, "json": json_ok})
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=424242, **shipping)
+    answer = list(inst["answer"])
+    unchosen = sorted(set(inst["values"]) - set(answer))
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": sorted(answer[1:] + [unchosen[0]]),
+        "duplicate": answer[:-1] + [answer[0]],
+        "empty": [],
+        "out_of_range": answer[:-1] + [max(inst["values"]) + 1],
+    }
+    cases = {}
+    reasons = []
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        cases[name] = {"rejected": not ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": all(case["rejected"] for case in cases.values()) and len(set(reasons)) == len(reasons),
+        "cases": cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    model_style = (
+        "I checked the four exact moment equations. My final witness is:\n"
+        "<answer>\n```json\n" + json.dumps(answer) + "\n```\n</answer>\n"
+        "The complement is the other displayed half."
+    )
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_equals_answer": parsed == answer,
+    }
+
+    # G4/G5 shipping density: one structure-aware sample reused for both gates.
+    guess_rng = random.Random(8675309)
+    guess_total = 200000
+    guess_hits = 0
+    guess_start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
+    guess_elapsed = time.perf_counter() - guess_start
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_fraction,
+        "search_space": search_space(inst),
+        "sampling_prior": "uniform over all correctly-sized halves of the displayed set",
+        "wall_clock_sec": round(guess_elapsed, 6),
+    }
+
+    # G6: four failed no-tool attacks and a separately successful Track B solver.
+    attack_counts = {
+        "outlier_extreme_magnitudes": 0,
+        "greedy_largest_first_balance": 0,
+        "random_restart_256_balanced_halves": 0,
+        "by_hand_sorted_alternation": 0,
+    }
+    attack_times = {name: 0.0 for name in attack_counts}
+    reference_operations = []
+    reference_times = []
+    reference_successes = 0
+    compact_operations = []
+    compact_successes = 0
+    attempts = 8
+    for trial in range(attempts):
+        trial_inst = make_instance(seed=10000 + trial, **shipping)
+        for name, function in (
+            ("outlier_extreme_magnitudes", _outlier_extremes),
+            ("greedy_largest_first_balance", _greedy_largest_first),
+            ("by_hand_sorted_alternation", _sorted_alternation),
+        ):
+            started = time.perf_counter()
+            candidate = function(trial_inst)
+            attack_times[name] += time.perf_counter() - started
+            attack_counts[name] += int(verify(trial_inst, candidate)[0])
+
+        started = time.perf_counter()
+        restart_rng = random.Random(20000 + trial)
+        restart_solved = False
+        for _ in range(256):
+            if verify(trial_inst, random_candidate(trial_inst, restart_rng))[0]:
+                restart_solved = True
+                break
+        attack_times["random_restart_256_balanced_halves"] += time.perf_counter() - started
+        attack_counts["random_restart_256_balanced_halves"] += int(restart_solved)
+
+        reference, reference_stats = _mitm_reference(trial_inst)
+        reference_ok = reference is not None and verify(trial_inst, reference)[0]
+        reference_successes += int(reference_ok)
+        reference_operations.append(reference_stats["operations"])
+        reference_times.append(reference_stats["wall_clock_sec"])
+
+        compact, compact_stats = _compact_cube_recover(trial_inst)
+        compact_ok = compact is not None and verify(trial_inst, compact)[0]
+        compact_successes += int(compact_ok)
+        compact_operations.append(compact_stats["operations"])
+
+    attacks = {
+        name: {
+            "successes": attack_counts[name],
+            "attempts": attempts,
+            "wall_clock_sec": round(attack_times[name], 6),
+        }
+        for name in attack_counts
+    }
+    panel_pass = all(entry["successes"] == 0 for entry in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": panel_pass and reference_successes == attempts and compact_successes == attempts,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "balanced meet-in-the-middle on cardinality and four moment sums",
+            "complexity": "O(degree * 2^(N/2)) exact time and O(2^(N/2)) memory",
+            "wall_clock_sec": round(max(reference_times), 6),
+            "mean_wall_clock_sec": round(sum(reference_times) / len(reference_times), 6),
+            "operations": max(reference_operations),
+            "solves": f"{reference_successes}/{attempts}, as expected",
+        },
+        "compact_route": {
+            "name": "affine normalization and Boolean subset-sum cube reconstruction",
+            "max_operations": max(compact_operations),
+            "solves": f"{compact_successes}/{attempts}",
+        },
+    }
+
+    demo_inst = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo_inst)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": (
+            guess_fraction < 1e-6
+            and demo_count is not None
+            and reference_successes == attempts
+            and max(compact_operations) <= 300
+        ),
+        "shipping_sample_hits": guess_hits,
+        "shipping_sample_total": guess_total,
+        "shipping_solution_density": guess_fraction,
+        "shipping_candidate_space": search_space(inst),
+        "demo_exact_solution_count": demo_count,
+        "baseline_attack_wall_clock_sec": round(attack_times["random_restart_256_balanced_halves"], 6),
+        "baseline_attack_iterations": 256 * attempts,
+        "reference_wall_clock_sec": round(max(reference_times), 6),
+        "reference_operation_count": max(reference_operations),
+        "compact_route_max_operations": max(compact_operations),
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] *= 2
+    doubled_start = time.perf_counter()
+    doubled = make_instance(seed=31337, **doubled_params)
+    doubled_build = time.perf_counter() - doubled_start
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled_params["n"] > shipping["n"],
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled_params["n"],
+        "answer_elements_unchanged": len(doubled["answer"]) == len(inst["answer"]),
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariance_total = invariance_passed = 0
+    carried_total = carried_passed = 0
+    for seed in range(20):
+        base = make_instance(seed=30000 + seed, **shipping)
+        base_key = canonical_key(base)
+        rng = random.Random(40000 + seed)
+        permutation = list(range(len(base["values"])))
+        rng.shuffle(permutation)
+        positive_u = rng.randrange(2, 100)
+        positive_t = rng.randrange(0, 100000)
+        reflection_t = positive_u * max(base["values"]) + rng.randrange(0, 100000)
+        transformed = [
+            _transform_instance(base, 1, 0, permutation),
+            _transform_instance(base, positive_u, positive_t),
+            _transform_instance(base, positive_u, positive_t, permutation),
+            _transform_instance(base, -positive_u, reflection_t),
+            _transform_instance(base, -positive_u, reflection_t, permutation),
+        ]
+        for variant in transformed:
+            invariance_total += 1
+            carried_total += 1
+            invariance_passed += int(canonical_key(variant) == base_key)
+            carried_passed += int(verify(variant, variant["answer"])[0])
+
+    unrelated_keys = {
+        canonical_key(make_instance(seed=50000 + seed, **shipping))
+        for seed in range(20)
+    }
+    report["G8_canonical_key"] = {
+        "pass": (
+            invariance_passed == invariance_total
+            and carried_passed == carried_total
+            and len(unrelated_keys) == 20
+        ),
+        "invariance_checks_passed": invariance_passed,
+        "invariance_checks_total": invariance_total,
+        "carried_certificate_checks_passed": carried_passed,
+        "carried_certificate_checks_total": carried_total,
+        "unrelated_distinct": len(unrelated_keys),
+        "unrelated_total": 20,
+        "symmetries_tested": [
+            "input permutation",
+            "positive integral affine map",
+            "global reflection",
+            "each affine map composed with input permutation",
+        ],
+    }
+
+    answer_blob = json.dumps(inst["answer"])
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _answer_atom_count(inst["answer"])
+    intended_ops = max(compact_operations)
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    hinted_hardened = G9_ORACLE_RESULTS.get("hinted_verdict") == "hardened"
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_hardened and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS.get("hinted_verdict"),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "within_caps": within_caps,
+    }
+
+    gate_values = [
+        value for key, value in report.items()
+        if key.startswith("G") and key[1:2].isdigit()
+    ]
+    report["all_passed"] = all(value.get("pass") for value in gate_values)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=False))

