\end{vmatrix},\quad
&W_{11}=
\begin{vmatrix}
 S_5 & S_4 \\
 S_7 & S_6 \\
\end{vmatrix},\quad
&W_{12}=
\begin{vmatrix}
 S_6 & S_5 \\
 S_7 & S_6 \\
\end{vmatrix}.\\
