\indent If \ $Q_{-1}=Q_{0\phantom{-}}=Q_{1\phantom{-}}=Q_3=0$, then $Q_2 Q_7=2 Q_4 Q_5$.\\
\indent If \ $Q_{-2}=Q_{-1}=Q_{0\phantom{-}}=Q_2=0$, then $Q_1 Q_6=2 Q_3 Q_4+ Q_1^3 Q_4/12$.\\
