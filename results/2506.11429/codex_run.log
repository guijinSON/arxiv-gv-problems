& S_4=(P_4+S_1 P_3+S_2 P_2+S_3 P_1)/4\\
& S_5=(P_5+S_1 P_4+S_2 P_3+S_3 P_2+S_4 P_1)/5\\
& S_6=(P_6+S_1 P_5+S_2 P_4+S_3 P_3+S_4 P_2+S_5 P_1)/6\\
& S_7=(P_7+S_1 P_6+S_2 P_5+S_3 P_4+S_4 P_3+S_5 P_2+S_6 P_1)/7\\
\end{aligned}
\end{equation}
Furthermore, define
\begin{equation}
\begin{aligned}
&W_{10}=
\begin{vmatrix}
 S_5 & S_4 \\
