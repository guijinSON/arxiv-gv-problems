(h = 1, 3, 4)
\end{aligned}
\end{equation}
has a non-trivial real solution, then $j = 2$.
\end{corollary}
\begin{proof}[Proof Idea]
Based on \eqref{identityP40}, when $P_1$, $P_3$, and $P_4$ are certain values, $P_2$ can take at most two distinct real values. Therefore, $j = 2$. Consequently, there is no ideal solution chain of length $j \geq 3$ for the type $(h = 1, 3, 4)$.
\end{proof}

\begin{corollary}\label{corollaryh234}
If
\begin{equation}
\label{equationh234}
\begin{aligned}
a_{11}^h + a_{12}^h + a_{13}^h &= a_{21}^h + a_{22}^h + a_{23}^h = \dots = a_{j1}^h + a_{j2}^h + a_{j3}^h, \\
(h&=2,3,4)
