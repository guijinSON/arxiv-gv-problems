def direct(i,a):
 vals=i['values']; A=[x for x,c in zip(vals,a) if c=='A']; B=[x for x,c in zip(vals,a) if c=='B']
 if len(A)"'!=i['"'side_size']: return False
 C=min(vals)+max(vals); d=dict(zip(vals,a))
