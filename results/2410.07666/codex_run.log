+    base = make_instance(seed=777, **ship)
+    doubled_params = dict(ship)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=777, **doubled_params)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
