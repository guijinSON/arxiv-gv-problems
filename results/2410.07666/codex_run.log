+        "pass": probability < 1e-6,
+        "hits": hits,
+        "total": total,
+        "empirical_probability": probability,
+        "prior": "uniform over 2^n complete assignments; token syntax and uniqueness enforced",
+        "naive_semantic_space": search_space(guess_inst),
+    }
