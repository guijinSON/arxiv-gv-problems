+                and search_space(doubled) == search_space(base) ** 2,
+        "base_n": base["n"],
+        "doubled_n": doubled["n"],
+        "base_clauses": len(base["clauses"]),
+        "doubled_clauses": len(doubled["clauses"]),
+        "doubled_planted_verify": doubled_why,
