s=importlib.util.spec_from_file_location('g','gen_2410_07666.py');g=importlib.util.module_from_spec(s);s.loader.exec_module(g)
def walk(inst,seed,restarts=32,steps_factor=50):
 n=inst['n'];cs=inst['clauses'];inc=[[] for _ in range(n)]
 for j,c in enumerate(cs):
  for v,_ in c:inc[v].append(j)
 rng=random.Random(seed)
 def bad(c,b):
  a=b[c[0][0]]"'^c[0][1];d=b[c[1][0]]''^c[1][1];e=b[c[2][0]]''^c[2][1];return a==d==e
 for _ in range(restarts):
  b=[rng.randrange(2) for _ in range(n)];viol={j for j,c in enumerate(cs) if bad(c,b)}
  for __ in range(steps_factor*n):
   if not viol:return b
   j=rng.choice(tuple(viol));vs=[v for v,_ in cs[j]]
   if rng.random()<.1:v=rng.choice(vs)
   else:
    q=[]
    for v in vs:
     before=sum(k in viol for k in inc[v]);b[v]''^=1;after=sum(bad(cs[k],b) for k in inc[v]);b[v]''^=1;q.append((after-before,v))
    z=min(x for x,_ in q);v=rng.choice([v for x,v in q if x==z])
   b[v]''^=1
   for k in inc[v]:
    if bad(cs[k],b):viol.add(k)
    else:viol.discard(k)
 return None
for d in (7,8,9,10,12,14,16,20):
 for n in (192,384):
  suc=0;t=time.time()
