+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the last well-formed delimited signed-integer list."""
+    if not isinstance(text, str):
+        return None
+    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text,
+                        flags=re.IGNORECASE | re.DOTALL)
