+def _recover_hidden_basis(form):
+    """Recover P from form(0)=P^T P for upper-unitriangular P."""
+
+    constant = [[form[i][j].get(0, 0) for j in range(3)] for i in range(3)]
+    if constant[0][0] != 1:
