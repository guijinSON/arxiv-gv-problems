+    return _clean(out)
+
+
+def _p_eval(p, x, modulus=None):
+    if modulus is None:
+        return sum(c * pow(x, e) for e, c in p.items())
+    return sum((c % modulus) * pow(x, e, modulus) for e, c in p.items()) % modulus
+
+
+def _p_to_input(p):
+    return [[c, e] for e, c in sorted(p.items())]
+
