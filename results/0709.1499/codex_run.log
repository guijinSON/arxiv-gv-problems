+    one = {0: 1}
+    if [M[i][i] for i in range(3)] != [one, one, one]:
+        raise ValueError("recovered form is not unitriangular")
+    if any(M[i][j] for i in range(3) for j in range(i)):
+        raise ValueError("recovered form is not unitriangular")
+    return M[0][1], M[0][2], M[1][2]
