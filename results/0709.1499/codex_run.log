+    P, Pinv, (p, q, r) = _recover_hidden_basis(form)
+    left, op1 = _mat_mul_count(_mat_transpose(Pinv), form)
+    M, op2 = _mat_mul_count(left, Pinv)
+    a, b, c = M[0][1], M[0][2], M[1][2]
+    R = _formula_R(a, b, c)
+    left, op3 = _mat_mul_count(Pinv, R)
+    X, op4 = _mat_mul_count(left, P)
