+"""Verified generator from arXiv:0709.1499, Section 2.
+
+The paper writes down the (up to scale) infinitesimal automorphism R of the
+upper-unitriangular matrix M(a,b,c).  It explicitly allows a,b,c to lie in an
+arbitrary commutative ring.  This generator substitutes sparse polynomials in
+Z[x] for a,b,c and asks for the normalized polynomial matrix R(x).
+
+Generation composes the displayed polynomial identity with a substitution; it
+never solves the generated coefficient-matching system.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "rational_exact",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "matrix_certificate",
+    "native_objects": [
+        "upper-unitriangular 3 by 3 matrix over Z[x]",
+        "polynomial infinitesimal automorphism matrix",
+    ],
+    "verification_operations": [
+        "exact sparse-polynomial multiplication over Z",
+        "exact polynomial coefficient comparison",
+        "matrix transpose and multiplication",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Treat the three displayed polynomials as the abstract entries a, b, c, "
+        "derive the universal 3 by 3 identity once, and only then substitute; "
+        "without that abstraction one faces a large coefficient-matching system."
+    ),
+    "hardness_basis": (
+        "Track B: generic coefficient matching can be performed exactly by "
+        "evaluation, 9-variable modular elimination, and interpolation in "
+        "O(D*9^3+9D^2) field operations for output degree D=3n; at the shipping "
+        "preset the measured operation count and wall-clock time are recorded by "
+        "selftest, whereas the universal Section 2 identity needs fewer than 300 "
+        "sparse coefficient operations after the change of variables is noticed."
+    ),
+    "max_answer_tokens": 500,
+}
+
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
