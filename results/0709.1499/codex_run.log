+def _underlying_parameters(inst):
+    form = _matrix_from_input(inst["form"])
+    if inst.get("n") == 0:
+        return form[0][1], form[0][2], form[1][2]
+    _, Pinv, _ = _recover_hidden_basis(form)
+    M = _mat_mul(_mat_mul(_mat_transpose(Pinv), form), Pinv)
