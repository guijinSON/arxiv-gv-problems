python3 - <<'PY'
import json, os
import gen_0709_1499 as g
required=('make_instance','render','parse_answer','verify','random_candidate','search_space','enumerate_all','canonical_key','escalate','selftest')
print('interface',all(callable(getattr(g,n,None)) for n in required))
print('track_profile',g.TRACK,g.PROBLEM_PROFILE['domain_essentiality'],g.PROBLEM_PROFILE['reduction_kind'],g.PROBLEM_PROFILE['max_answer_tokens'])
print('difficulty_order',list(g.DIFFICULTY),'shipping',g.SHIPPING_DIFFICULTY)
for seed in range(20):
 i=g.make_instance(seed=seed,**g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
 assert g.verify(i,i['answer'])[0]
 assert json.loads(json.dumps(i['answer']))==i['answer']
 assert g.parse_answer('text <answer>'+g._answer_text(i['answer'])+'</answer> text')==i['answer']
print('shipping_20','ok')
print('distinct_keys',len({g.canonical_key(g.make_instance(seed=s,**g.DIFFICULTY['easy'])) for s in range(20)}))
print('demo_count',g.enumerate_all(g.make_instance(seed=0,**g.DIFFICULTY['demo'])))
rep=json.load(open('selftest_report.json'))
print('gates',[(k,v['pass']) for k,v in rep.items() if k.startswith('G') and k[1:2].isdigit()])
meta=json.load(open('.meta.json'))
