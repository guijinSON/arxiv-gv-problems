+
+def _formula_R(a, b, c):
+    """The polynomial matrix displayed in Section 2 of the paper."""
+
+    a2 = _p_mul(a, a)
+    b2 = _p_mul(b, b)
+    c2 = _p_mul(c, c)
+    ab = _p_mul(a, b)
+    ac = _p_mul(a, c)
+    bc = _p_mul(b, c)
+    abc = _p_mul(ab, c)
