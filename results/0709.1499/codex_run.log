+
+def _p_add(*polys):
+    out = {}
+    for p in polys:
+        for e, c in p.items():
+            out[e] = out.get(e, 0) + c
+            if out[e] == 0:
+                del out[e]
+    return out
+
+
+def _p_scale(p, k):
+    return _clean({e: k * c for e, c in p.items()})
