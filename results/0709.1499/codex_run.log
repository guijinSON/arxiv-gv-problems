+    "bounds": {
+        "matrix_rows": 3,
+        "matrix_columns": 3,
+        "variables": 1,
+        "max_degree": "D=3n",
+        "coefficient_height": "instance value H",
+        "total_nonzero_terms": "instance value K",
+        "fixed_normalization_entry": "R[1][1]=c^2-a^2",
+    },
+}
+
+
+DIFFICULTY = {
+    "demo": {"n": 0, "terms": 1, "input_coeff_bound": 2},
+    "easy": {"n": 40, "terms": 2, "input_coeff_bound": 7},
+    "medium": {"n": 70, "terms": 2, "input_coeff_bound": 8},
+    "hard": {"n": 100, "terms": 2, "input_coeff_bound": 9},
+}
