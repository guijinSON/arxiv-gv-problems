   \end{array}\right) \]
\[ C = \left(\begin{array}{ccc}
     1 & 0 & 0\\
     0 & 1 & 0\\
     1 & 0 & 1
   \end{array}\right), \]

\[ D = \left(\begin{array}{cccccc}
     1 &  &  & 0 &  & 0\\
     0 &  &  & a c &  & 0\\
     0 &  &  & 0 &  & a c (a c - b)
   \end{array}\right), \]


then $T = A B C D.$ Moreover
\[ A^{- 1} = - \frac{1}{(a c - b)^2 } \left(\begin{array}{ccc}
     - c (a c - b) & - (a c - b)^2  & - a (a c - b)\\
     - a & 0 & c\\
     c & 0 & a - c (a c - b)
   \end{array}\right) \]

\[ = \frac{1}{(a c - b)^2} F K L, \]


where
\[ F = \left(\begin{array}{ccccc}
