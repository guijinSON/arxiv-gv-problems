+    operations = 0
+    for i in range(3):
+        for j in range(3):
+            pieces = []
+            for k in range(3):
+                product, used = _p_mul_count(A[i][k], B[k][j])
+                operations += used
+                pieces.append(product)
+            total = {}
+            for piece in pieces:
+                for exponent, coefficient in piece.items():
+                    if exponent in total:
+                        operations += 1
+                    total[exponent] = total.get(exponent, 0) + coefficient
