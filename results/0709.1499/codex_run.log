+def _p_mul_count(p, q):
+    out = {}
+    operations = 0
+    for e, a in p.items():
+        for f, b in q.items():
+            operations += 1
+            if e + f in out:
+                operations += 1
+            out[e + f] = out.get(e + f, 0) + a * b
+    return _clean(out), operations
