+    gram = _mat_mul(_mat_transpose(P), P)
+    expected = _constant_matrix(constant)
+    if gram != expected:
+        raise ValueError("constant coefficient is not the required Gram matrix")
+    return P, _upper_basis_inverse(p, q, r), (p, q, r)
+
