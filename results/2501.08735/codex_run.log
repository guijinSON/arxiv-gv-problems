@@ -0,0 +1,969 @@
+"""Verified Perfect Matching Cut generator for arXiv:2501.08735.
+
+The paper identifies perfect matching cuts with perfect red-blue colourings
+(Observation 1) and gives a polynomial algorithm on bipartite graphs of
+diameter at most three (Theorem 9).  This module inverse-generates regular
+diameter-three graphs with a hidden perfect red-blue colouring.  The answer is
+the red vertex set; verification checks the definition directly and never
+consults the planted answer.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import deque
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "regular bipartite graph of diameter at most 3",
+        "perfect red-blue vertex colouring",
+        "perfect matching cut",
+    ],
+    "verification_operations": [
+        "finite-set validation",
+        "exact per-vertex bichromatic degree count",
+        "exact edge-cut scan",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Within either displayed bipartition side, vertices in the same hidden "
+        "colour block have many common neighbours while vertices in opposite "
+        "blocks have at most two; without this invariant one faces the paper's "
+        "general branching algorithm."
+    ),
+    "hardness_basis": (
+        "Track B: Section 3, Theorem 9 gives a polynomial perfect-colouring "
+        "algorithm with O(N^4) Phase-1 branches on diameter-3 bipartite graphs; "
+        "the shipping preset's measured reference branch count, primitive "
+        "checks, and wall time are reported by selftest, whereas the compact "
+        "route uses at most 2N-1 common-neighbour cardinalities after noticing "
+        "the hidden-block invariant."
+    ),
+    "max_answer_tokens": 64,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 5, "omissions": 1},
+    "easy": {"n": 12, "omissions": 2},
+    "medium": {"n": 18, "omissions": 5},
+    "hard": {"n": 24, "omissions": 9},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+STRUCTURAL_HINT: str = (
+    "Hint: On each bipartition side, common-neighbour counts separate two hidden colour blocks."
+)
+PLACEBO_HINT: str = (
+    "Hint: On each bipartition side, careful bookkeeping prevents vertex-label mistakes."
+)
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A strictly increasing JSON list of exactly N/2 distinct vertex labels "
+        "from 0 through N-1, containing vertex 0; it denotes the red side of "
+        "the colouring and its complement is blue."
+    ),
+    "bounds": {
+        "length": "exactly N/2",
+        "entry_min": 0,
+        "entry_max": "N-1",
+        "strictly_increasing": True,
+        "must_contain": 0,
+        "candidate_count": "binomial(N-1,N/2-1)",
+    },
+}
+
+NOTES: str = r"""
+Section 2 fixes the exact object: a red-blue colouring uses both colours and is
+perfect when every vertex has exactly one neighbour of the other colour.
+Observation 1 says this is equivalent to a perfect matching cut.  Section 3,
+Theorem 9 is the decisive easy-case result: Perfect Matching Cut is polynomial
+on bipartite graphs of diameter at most 3, using O(N^4) Phase-1 branches plus
+colour processing.  Hence this module is explicitly Track B, not a Track-A
+claim.  The NP-completeness regime in Theorem 19 starts at bipartite radius 4
+(its construction has diameter at most 8), and does not justify average-case
+hardness for a naively planted distribution.
+
+Generation samples the red/blue partition first.  Four equally sized latent
+blocks L0,L1,R0,R1 are used.  L0-R0 and L1-R1 contain all edges except several
+mixed regular omission relations; L0-R1 and L1-R0 are perfect matchings.  The
+two omission relations are disjoint after transposition.  Consequently every
+vertex has the same degree, every vertex has exactly one bichromatic neighbour,
+and every pair of vertices on one bipartition side has a common neighbour.  The
+last fact proves diameter at most 3.  A global random relabelling hides all four
+blocks, and the planted red set is carried through that relabelling.  No cut
+algorithm is run during generation.
+
+The degree outlier attack is neutralized by exact regularity.  The bipartition
+ansatz fails because it makes every edge bichromatic.  A densest-prefix greedy
+rule and a one-edge propagation ansatz are tested after label randomization, as
+are structure-aware random restarts.  The successful Theorem-9-style reference
+algorithm is reported separately, as Track B requires.  Escalation first raises
+the number of mixed omission matchings at fixed answer length; only after that
+axis is exhausted does it enlarge the graph, and it reports cap_bound before
+the 256-atom certificate limit would be crossed.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_GUESS_SAMPLES = 200_000
+
+# Filled from the harness-owned transcripts after the three arms are run.
+_G9_EVIDENCE = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
+    },
+    "hinted_verdict": "not yet measured",
+}
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_params(n, omissions, seed):
+    if not _is_int(n) or n < 5:
+        raise ValueError("n must be an integer at least 5")
+    if not _is_int(omissions) or omissions < 1:
+        raise ValueError("omissions must be a positive integer")
+    if 2 * omissions > n - 3:
+        raise ValueError("need 2*omissions <= n-3")
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+
+
+def _switch_relation(relation, forbidden, rng, rounds):
+    """Mix a regular bipartite relation by degree-preserving two-switches."""
+    n = len(relation)
+    for _ in range(rounds):
+        a = rng.randrange(n)
+        b = rng.randrange(n - 1)
+        if b >= a:
+            b += 1
+        only_a = relation[a] - relation[b]
+        only_b = relation[b] - relation[a]
+        if not only_a or not only_b:
+            continue
+        y = rng.choice(sorted(only_a))
+        z = rng.choice(sorted(only_b))
+        if z in forbidden[a] or y in forbidden[b]:
+            continue
+        relation[a].remove(y)
+        relation[b].remove(z)
+        relation[a].add(z)
+        relation[b].add(y)
+
+
+def _omission_relations(n, omissions, rng):
+    """Return disjoint regular relations A and B on [n] x [n].
+
+    A(i,j) means L0_i--R0_j is absent.  B(i,j) means
+    L1_j--R1_i is absent.  Their disjointness ensures that L0_i and L1_j
+    retain at least one of their two possible common neighbours.
+    """
+    shifts = rng.sample(range(n), 2 * omissions)
+    first = shifts[:omissions]
+    second = shifts[omissions:]
+    a = [{(i + shift) % n for shift in first} for i in range(n)]
+    b = [{(i + shift) % n for shift in second} for i in range(n)]
+    rounds = 20 * n * omissions
+    _switch_relation(a, b, rng, rounds)
+    _switch_relation(b, a, rng, rounds)
+    assert all(len(row) == omissions for row in a + b)
+    assert all(a[i].isdisjoint(b[i]) for i in range(n))
+    column_a = [0] * n
+    column_b = [0] * n
+    for i in range(n):
+        for j in a[i]:
+            column_a[j] += 1
+        for j in b[i]:
+            column_b[j] += 1
+    assert all(x == omissions for x in column_a + column_b)
+    return a, b
+
+
+def make_instance(n, seed=0, omissions=1, **params) -> dict:
+    """Inverse-generate a regular diameter-3 graph and its perfect colouring."""
+    if params:
+        raise TypeError("unexpected parameters: " + ", ".join(sorted(params)))
+    _validate_params(n, omissions, seed)
+    rng = random.Random(seed)
+    absent_0, absent_1_transpose = _omission_relations(n, omissions, rng)
+
+    # Natural labels: L0,L1,R0,R1.  Red is L0 union R0.
+    l0 = range(0, n)
+    l1 = range(n, 2 * n)
+    r0 = range(2 * n, 3 * n)
+    r1 = range(3 * n, 4 * n)
+    edges = []
+    for i in range(n):
+        for j in range(n):
+            if j not in absent_0[i]:
+                edges.append((i, 2 * n + j))
+            # B(i,j) records absence of L1_j--R1_i.
+            if j not in absent_1_transpose[i]:
+                edges.append((n + j, 3 * n + i))
+        edges.append((i, 3 * n + i))
+        edges.append((n + i, 2 * n + i))
+
+    total = 4 * n
+    old_to_new = list(range(total))
+    rng.shuffle(old_to_new)
+    left_set = {old_to_new[v] for v in itertools.chain(l0, l1)}
+    right_set = {old_to_new[v] for v in itertools.chain(r0, r1)}
+    moved_edges = []
+    for u, v in edges:
+        u2, v2 = old_to_new[u], old_to_new[v]
+        if u2 in right_set:
+            u2, v2 = v2, u2
+        moved_edges.append([u2, v2])
+    moved_edges.sort()
+
+    red = {old_to_new[v] for v in itertools.chain(range(n), range(2 * n, 3 * n))}
+    if 0 not in red:
+        red = set(range(total)) - red
+    answer = sorted(red)
+    inst = {
+        "vertex_count": total,
+        "block_size": n,
+        "omissions": omissions,
+        "degree": n - omissions + 1,
+        "left": sorted(left_set),
+        "right": sorted(right_set),
+        "edges": moved_edges,
+        "answer": answer,
+    }
+    return inst
+
+
+def _adjacency(inst):
+    count = inst["vertex_count"]
+    adj = [set() for _ in range(count)]
+    for edge in inst["edges"]:
+        if not isinstance(edge, list) or len(edge) != 2:
+            continue
+        u, v = edge
+        if _is_int(u) and _is_int(v) and 0 <= u < count and 0 <= v < count:
+            adj[u].add(v)
+            adj[v].add(u)
+    return adj
+
+
+def render(inst) -> str:
+    """Render a self-contained statement with the graph inline."""
+    adj = _adjacency(inst)
+    rows = "\n".join(
+        f"  {u}: " + ", ".join(str(v) for v in sorted(adj[u]))
+        for u in inst["left"]
+    )
+    statement = f"""Perfect matching cut in a bounded-diameter bipartite graph
+
+The graph below is finite, simple, undirected, regular, and bipartite.  Its
+vertices are the integers 0 through {inst['vertex_count'] - 1}.  The displayed
+bipartition is L and R.  Each adjacency row is given only for its vertex in L;
+an entry `u: v1, v2` means the undirected edges {{u,v1}} and {{u,v2}}.  There
+are no other edges.
+
+A red-blue colouring assigns every vertex one of the two colours and uses both
+colours.  It is perfect when every vertex has exactly one neighbour of the
+other colour.  Equivalently, the bichromatic edges form both a perfect matching
+and an edge cut; this is a perfect matching cut.
+
+Find a perfect red-blue colouring.  Submit the red vertex set.  To remove the
+irrelevant global colour swap, red must contain vertex 0.  A perfect colouring
+has equally many red and blue vertices, so your answer must contain exactly
+{inst['vertex_count'] // 2} distinct labels.  Write them as one strictly
+increasing JSON list.  Labels are 0-indexed; repetitions and labels outside
+0..{inst['vertex_count'] - 1} are forbidden.  The blue set is the complement.
+
+N = {inst['vertex_count']}
+regular degree = {inst['degree']}
+L = {json.dumps(inst['left'], separators=(',', ':'))}
+R = {json.dumps(inst['right'], separators=(',', ':'))}
+Adjacency rows for L:
+{rows}
+
+Give your final answer inside <answer></answer> tags, as a JSON list of the red
+vertex labels in strictly increasing order.
+Example: <answer>[0, 3, 5]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Extract the last tagged JSON list, tolerating prose and code fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
+    if fence:
+        body = fence.group(1).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(value, list) or not all(_is_int(x) for x in value):
+        return None
+    return value
+
+
+def verify(inst, answer):
+    """Check a candidate perfect colouring directly; never read inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    if not all(_is_int(v) for v in answer):
+        return False, "vertex labels must be integers"
+    total = inst.get("vertex_count")
+    if any(v < 0 or v >= total for v in answer):
+        return False, "vertex label out of range"
+    if len(set(answer)) != len(answer):
+        return False, "vertex labels must be distinct"
+    if answer != sorted(answer):
+        return False, "vertex labels must be strictly increasing"
+    if len(answer) != total // 2:
+        return False, f"expected exactly {total // 2} red vertices"
+    if answer[0] != 0:
+        return False, "vertex 0 must be red"
+
+    red = set(answer)
+    adj = _adjacency(inst)
+    for v in range(total):
+        opposite = 0
+        v_red = v in red
+        for w in adj[v]:
+            if (w in red) != v_red:
+                opposite += 1
+                if opposite > 1:
+                    return False, f"vertex {v} has more than one opposite-colour neighbour"
+        if opposite == 0:
+            return False, f"vertex {v} has no opposite-colour neighbour"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the balanced, oriented certificate language."""
+    total = inst["vertex_count"]
+    chosen = rng.sample(range(1, total), total // 2 - 1)
+    return [0] + sorted(chosen)
+
+
+def search_space(inst):
+    """Count all balanced colour sets containing 0."""
+    total = inst["vertex_count"]
+    return math.comb(total - 1, total // 2 - 1)
+
+
+def enumerate_all(inst):
+    """Count valid certificates exactly when at most 200,000 candidates exist."""
+    total = inst["vertex_count"]
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    count = 0
+    for tail in itertools.combinations(range(1, total), total // 2 - 1):
+        count += int(verify(inst, [0] + list(tail))[0])
+    return count
+
+
+def _bipartition_from_graph(inst):
+    adj = _adjacency(inst)
+    total = inst["vertex_count"]
+    colour = [-1] * total
+    for start in range(total):
+        if colour[start] != -1:
+            continue
+        colour[start] = 0
+        queue = deque([start])
+        while queue:
+            v = queue.popleft()
+            for w in adj[v]:
+                if colour[w] == -1:
+                    colour[w] = colour[v] ^ 1
+                    queue.append(w)
+                elif colour[w] == colour[v]:
+                    return None
+    return ([v for v in range(total) if colour[v] == 0],
+            [v for v in range(total) if colour[v] == 1])
+
+
+def canonical_key(inst):
+    """A relabelling-invariant common-neighbour signature of the graph."""
+    sides = _bipartition_from_graph(inst)
+    if sides is None:
+        return "nonbipartite"
+    adj = _adjacency(inst)
+    vertex_signatures = []
+    side_signatures = []
+    for side in sides:
+        local = []
+        for v in side:
+            sig = sorted(len(adj[v] & adj[w]) for w in side if w != v)
+            local.append(tuple(sig))
+            vertex_signatures.append(tuple(sig))
+        side_signatures.append(tuple(sorted(local)))
+    payload = {
+        "N": inst["vertex_count"],
+        "degrees": sorted(len(row) for row in adj),
+        "sides": sorted(side_signatures),
+        "vertices": sorted(vertex_signatures),
+    }
+    raw = json.dumps(payload, separators=(",", ":"), sort_keys=True)
+    return hashlib.sha256(raw.encode()).hexdigest()
+
+
+def escalate(params):
+    """Increase omission crowding first, then graph size, respecting answer caps."""
+    n = int(params["n"])
+    omissions = int(params.get("omissions", 1))
+    maximum = (n - 3) // 2
+    if omissions < maximum:
+        return {"n": n, "omissions": min(maximum, omissions + 2)}
+    new_n = n + 8
+    if 2 * new_n > 256:
+        return "cap_bound"
+    return {"n": new_n, "omissions": max(1, (new_n - 5) // 2)}
