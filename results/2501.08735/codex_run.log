  nodes+=1
  if nodes>cap:return None
  if all(x>=0 for x in A):return A[:]
  # max incidence in unresolved
  x=max((i for i,v in enumerate(A) if v<0),key=lambda i:sum(any(A[y]<0 for y in C[j]) for j in inc[i]))
  snap=A[:]
