def gen(n,a,seed):
 r=random.Random(seed); plant=[0]*(n//2)+[1]*(n-n//2);r.shuffle(plant);C=[];seen=set()
 while len(C)<int(a*n):
  t=tuple(sorted(r.sample(range(n),3)))
  if t in seen or plant[t[0]]==plant[t[1]]==plant[t[2]]:continue
  seen.add(t);C.append(t)
 return plant,C

def dpll(n,C,cap=2_000_000):
 inc=[[]for _ in range(n)]
 for j,c in enumerate(C):
  for x in c:inc[x].append(j)
 A=[-1]*n; nodes=0
 def prop(queue):
  while queue:
   x=queue.pop()
   for j in inc[x]:
    c=C[j]; vals=[A[y] for y in c]; assigned=[v for v in vals if v>=0]
    if len(assigned)==3:
     if assigned[0]==assigned[1]==assigned[2]:return False
    elif len(assigned)==2 and assigned[0]==assigned[1]:
     z=next(y for y in c if A[y]<0); want=1-assigned[0]
     if A[z]>=0 and A[z]"'!=want:return False
     if A[z]<0:A[z]=want;queue.append(z)
  return True
 def rec():
