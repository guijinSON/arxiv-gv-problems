+def _attack_greedy(inst):
+    rows = _by_first_block(inst)
+    used = set()
+    answer = []
+    order = sorted(range(inst["n"]), key=lambda a: inst["tags"][a])
+    for a in order:
+        feasible = [j for j in rows[a]
