+def _relabel_instance(inst, item_map, set_order, rng):
+    item_count = 3 * inst["n"]
+    if sorted(item_map) != list(range(item_count)):
+        raise ValueError("item_map is not a permutation")
+    if sorted(set_order) != list(range(inst["m"])):
+        raise ValueError("set_order is not a permutation")
+    weights = [0] * item_count
+    for old, new in enumerate(item_map):
+        weights[new] = inst["weights"][old]
+    sets, old_to_new_set = [], [0] * inst["m"]
+    for new_index, old_index in enumerate(set_order):
+        row = [item_map[item] for item in inst["sets"][old_index]]
+        rng.shuffle(row)
+        sets.append(row)
+        old_to_new_set[old_index] = new_index
+    out = dict(inst)
+    out["weights"] = weights
+    out["sets"] = sets
+    out["answer"] = sorted(old_to_new_set[index] for index in inst["answer"])
+    return out
 
 
