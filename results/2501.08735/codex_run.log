+def _fill_shape(inst, chosen):
+    unique, seen = [], set()
+    for value in chosen:
+        if _is_int(value) and 0 <= value < inst["m"] and value not in seen:
+            unique.append(value)
+            seen.add(value)
+            if len(unique) == inst["n"]:
+                break
+    for value in range(inst["m"]):
+        if len(unique) == inst["n"]:
+            break
+        if value not in seen:
+            unique.append(value)
+            seen.add(value)
+    return sorted(unique)
