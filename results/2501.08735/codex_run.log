+def _graph_diameter(inst):
+    adj = _adjacency(inst)
+    total = inst["vertex_count"]
+    diameter = 0
+    for source in range(total):
+        distance = [-1] * total
+        distance[source] = 0
+        queue = deque([source])
+        while queue:
+            v = queue.popleft()
+            for w in adj[v]:
+                if distance[w] == -1:
+                    distance[w] = distance[v] + 1
+                    queue.append(w)
+        if -1 in distance:
+            return math.inf
+        diameter = max(diameter, max(distance))
+    return diameter
