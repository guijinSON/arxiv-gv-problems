+def _attack_frequency_outlier(inst):
+    degrees = [0] * (3 * inst["n"])
+    for row in inst["sets"]:
+        for item in row:
+            degrees[item] += 1
+    scored = [(sum(degrees[item] for item in row), index)
+              for index, row in enumerate(inst["sets"])]
+    return sorted(index for _, index in sorted(scored)[:inst["n"]])
+
+
+def _attack_band_rank_zip(inst):
+    low, centre, high = _bands(inst)
+    low.sort(key=lambda i: (inst["weights"][i], i))
+    centre.sort(key=lambda i: (inst["weights"][i], i))
+    high.sort(key=lambda i: (inst["weights"][i], i), reverse=True)
+    lookup = {tuple(sorted(row)): index for index, row in enumerate(inst["sets"])}
+    chosen = []
+    for i in range(inst["n"]):
+        index = lookup.get(tuple(sorted((low[i], centre[i], high[i]))))
+        if index is not None:
+            chosen.append(index)
+    return _fill_shape(inst, chosen)
 
 
