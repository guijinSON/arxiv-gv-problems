import random,time,statistics

def gen(q,degree,seed):
 r=random.Random(seed); U=list(range(3*q));r.shuffle(U)
 sets=[tuple(sorted(U[3*i:3*i+3])) for i in range(q)]
 seen=set(sets)
 while len(sets)<q*degree:
  s=tuple(sorted(r.sample(range(3*q),3)))
  if s not in seen: seen.add(s);sets.append(s)
 r.shuffle(sets)
 return sets

def solve(q,S,cap=2_000_000):
 by=[[]for _ in range(3*q)]
 for j,s in enumerate(S):
  for x in s:by[x].append(j)
 avail=set(range(len(S))); uncovered=set(range(3*q)); nodes=0; sol=[]
 def rec():
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  if not uncovered:return list(sol)
  x=min(uncovered,key=lambda z:sum(j in avail for j in by[z]))
  cand=[j for j in by[x] if j in avail]
  for j in cand:
   s=S[j]
   if not set(s)<=uncovered:continue
   removed=[]
   cov=[]
   for y in s:
    uncovered.remove(y);cov.append(y)
    for h in by[y]:
     if h in avail:avail.remove(h);removed.append(h)
   sol.append(j); out=rec()
   if out is not None:return out
   sol.pop()
   for h in removed:avail.add(h)
   for y in cov:uncovered.add(y)
  return False
 out=rec();return nodes,out
