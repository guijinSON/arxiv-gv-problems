+def _residue_decoder(inst):
+    """Efficient Track-B algorithm once the affine invariant is known."""
+    started = time.perf_counter()
+    q = math.isqrt(inst["target"] // 12)
+    operations = 2
+    if q * q != inst["target"] // 12:
+        return None, {"operations": operations,
+                      "wall_clock_sec": time.perf_counter() - started}
+    low, centre, high = _bands(inst)
+    low_by_tag, centre_by_tag, high_by_residue = {}, {}, {}
+    for item in low:
+        low_by_tag[inst["weights"][item] % q] = item
+        operations += 1
+    for item in centre:
+        centre_by_tag[inst["weights"][item] % q] = item
+        operations += 1
+    for item in high:
+        high_by_residue[inst["weights"][item] % q] = item
+        operations += 1
+    lookup = {tuple(sorted(row)): index for index, row in enumerate(inst["sets"])}
+    answer = []
+    for tag in sorted(low_by_tag):
+        operations += 3
+        triple = tuple(sorted((low_by_tag[tag], centre_by_tag[tag],
+                               high_by_residue[(-2 * tag) % q])))
+        index = lookup.get(triple)
+        if index is None:
+            return None, {"operations": operations,
+                          "wall_clock_sec": time.perf_counter() - started}
+        answer.append(index)
+    return sorted(answer), {"operations": operations,
+                            "wall_clock_sec": time.perf_counter() - started}
 
 
