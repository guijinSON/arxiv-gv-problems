  nonlocal nodes,ops
  nodes+=1
  if nodes>cap:return None
  if left==0:return True
  cands=None
  for z in range(3*q):
   if uncovered[z]:
    cc=[]
    for j in by[z]:ops+=1;cc += [j] if avail[j] else []
