+def _attack_greedy_rarest(inst):
+    item_count = 3 * inst["n"]
+    by_item = [[] for _ in range(item_count)]
+    for index, row in enumerate(inst["sets"]):
+        for item in row:
+            by_item[item].append(index)
+    unused, chosen = set(range(item_count)), []
+    while unused and len(chosen) < inst["n"]:
+        item = min(unused, key=lambda x: (len(by_item[x]), x))
+        options = []
+        for index in by_item[item]:
+            row = inst["sets"][index]
+            if all(x in unused for x in row):
+                options.append((sum(len(by_item[x]) for x in row), index))
+        if not options:
+            break
+        _, index = min(options)
+        chosen.append(index)
+        unused.difference_update(inst["sets"][index])
+    return _fill_shape(inst, chosen)
+
+
