-    operations = 0
-    for v, c in initial.items():
-        if colour[v] not in (-1, c):
-            return None, operations
-        colour[v] = c
-    changed = True
-    while changed:
-        changed = False
-        forced = {}
-        for v in range(total):
-            red = blue = unknown = 0
-            for w in adj[v]:
-                operations += 1
