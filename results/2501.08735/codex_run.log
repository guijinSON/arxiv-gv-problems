+def _selection_is_cover(inst, answer):
+    if len(answer) != inst["n"] or len(set(answer)) != len(answer):
+        return False
+    if any(isinstance(j, bool) or not isinstance(j, int)
+           or j < 0 or j >= len(inst["triples"]) for j in answer):
