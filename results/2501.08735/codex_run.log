+    units = [u for u in range(1, n) if math.gcd(u, n) == 1]
+    forms = []
+    for anchor_x, anchor_y in signatures:
+        translated = [((x - anchor_x) % n, (y - anchor_y) % n)
+                      for x, y in signatures]
+        for unit in units:
+            scaled = sorted(((unit * x) % n, (unit * y) % n)
+                            for x, y in translated)
