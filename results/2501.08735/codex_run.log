import random,time,statistics

def gen(q,r,seed):
 R=random.Random(seed); S=[]
 for l in range(r):
  p=list(range(q));z=list(range(q));R.shuffle(p);R.shuffle(z)
  for a in range(q):S.append((a,q+p[a],2*q+z[a],l))
 R.shuffle(S);return S

def solve(q,S,cap=5_000_000):
 by=[[]for _ in range(3*q)]
 for j,s in enumerate(S):
  for x in s[:3]:by[x].append(j)
 avail=[True]*len(S); uncovered=[True]*(3*q); n_un=3*q; nodes=0; scans=0; sol=[]
 def rec(n_un):
  nonlocal nodes,scans
  nodes+=1
  if nodes>cap:return None
  if n_un==0:return list(sol)
  x=-1;bc=10**9
  for z in range(3*q):
   if uncovered[z]:
    c=0
    for j in by[z]:scans+=1;c+=avail[j]
    if c<bc:bc=c;x=z
  if bc==0:return False
  for j in by[x]:
   if not avail[j]:continue
   ss=S[j][:3]
   if not all(uncovered[y] for y in ss):continue
   removed=[]
   for y in ss:
    uncovered[y]=False
    for h in by[y]:
     if avail[h]:avail[h]=False;removed.append(h)
   sol.append(j);out=rec(n_un-3)
   if out is None or out is not False:return out
   sol.pop()
   for h in removed:avail[h]=True
   for y in ss:uncovered[y]=True
  return False
 out=rec(n_un);return nodes,scans,out
for q in [30,40,50,60,70,80]:
 for rr in [4,6,8,10,12,16]:
  vals=[]; times=[]
  for seed in range(4):
   S=gen(q,rr,seed);t=time.perf_counter();nodes,scans,out=solve(q,S);times.append(time.perf_counter()-t);vals.append(nodes)
  print(q,rr,vals,'t',round(statistics.median(times),3))
