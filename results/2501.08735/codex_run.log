+    # Swap the B and C copies.  This is a genuine hypergraph/graph isomorphism,
+    # not merely an input reorder, and exercises the coordinate swap normalized
+    # by canonical_key.
+    tags = tags[:n] + tags[2 * n:3 * n] + tags[n:2 * n]
