import random,time

def gen(q,r,seed):
 R=random.Random(seed); S=[]
 shifts=R.sample(range(q),r);shifts2=R.sample(range(q),r)
 # translations (easier structure), shuffle IDs
 for l,(s,t) in enumerate(zip(shifts,shifts2)):
  for a in range(q):S.append((a,q+(a+s)%q,2*q+(a+t)%q,l))
 R.shuffle(S);return S

def solve(q,S,cap=100_000):
 by=[[]for _ in range(3*q)]
 for j,s in enumerate(S):
  for x in s[:3]:by[x].append(j)
 avail=[True]*len(S); uncovered=[True]*(3*q); nodes=0; ops=0
