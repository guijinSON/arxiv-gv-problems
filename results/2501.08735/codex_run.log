+def _canonical_signatures(inst):
+    n = inst["n"]
+    tags = inst["tags"]
+    signatures = {
+        ((tags[b] - tags[a]) % n, (tags[c] - tags[a]) % n)
+        for a, b, c in inst["triples"]
