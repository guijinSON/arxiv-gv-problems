+def _raw_instance(n, q, noise_span, seed, nonce):
+    rng = random.Random(_mix_seed(seed, nonce))
+    q2 = q * q
+    target = 12 * q2
+    records = []
+    for tag in range(n):
+        u = rng.randint(1, noise_span)
+        v = rng.randint(1, noise_span)
+        low = 3 * q2 + q * u + tag
+        centre = 4 * q2 + q * v + tag
+        high = target - low - centre
+        records.extend(((low, tag, 0), (centre, tag, 1), (high, tag, 2)))
+    rng.shuffle(records)
+    weights = [row[0] for row in records]
+    tags = [row[1] for row in records]
+    roles = [row[2] for row in records]
+    sets = _all_exact_triples(weights, target, roles)
+    rng.shuffle(sets)
+    set_to_index = {triple: index for index, triple in enumerate(sets)}
+    by_tag = {}
+    for item, tag in enumerate(tags):
+        by_tag.setdefault(tag, []).append(item)
+    planted_triples = [tuple(sorted(by_tag[tag])) for tag in range(n)]
+    answer = sorted(set_to_index[triple] for triple in planted_triples)
+    m = len(sets)
+    return {
+        "paper": "arXiv:2501.08735",
