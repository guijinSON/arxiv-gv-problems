+"""Verified Perfect Matching Cut generator for arXiv:2501.08735.
+
+The paper identifies perfect matching cuts with perfect red-blue colourings
+(Observation 1) and gives a polynomial algorithm on bipartite graphs of
+diameter at most three (Theorem 9).  This module inverse-generates regular
+diameter-three graphs with a hidden perfect red-blue colouring.  The answer is
+the red vertex set; verification checks the definition directly and never
+consults the planted answer.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import deque
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "regular bipartite graph of diameter at most 3",
+        "perfect red-blue vertex colouring",
+        "perfect matching cut",
+    ],
+    "verification_operations": [
+        "finite-set validation",
+        "exact per-vertex bichromatic degree count",
+        "exact edge-cut scan",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Within either displayed bipartition side, vertices in the same hidden "
+        "colour block have many common neighbours while vertices in opposite "
+        "blocks have at most two; without this invariant one faces the paper's "
+        "general branching algorithm."
+    ),
+    "hardness_basis": (
+        "Track B: Section 3, Theorem 9 gives a polynomial perfect-colouring "
+        "algorithm with O(N^4) Phase-1 branches on diameter-3 bipartite graphs; "
+        "the shipping preset's measured reference branch count, primitive "
+        "checks, and wall time are reported by selftest, whereas the compact "
+        "route uses at most 2N-1 common-neighbour cardinalities after noticing "
+        "the hidden-block invariant."
+    ),
+    "max_answer_tokens": 64,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 5, "omissions": 1},
+    "easy": {"n": 12, "omissions": 2},
+    "medium": {"n": 18, "omissions": 5},
+    "hard": {"n": 24, "omissions": 9},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+STRUCTURAL_HINT: str = (
+    "Hint: On each bipartition side, common-neighbour counts separate two hidden colour blocks."
+)
+PLACEBO_HINT: str = (
+    "Hint: On each bipartition side, careful bookkeeping prevents vertex-label mistakes."
+)
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A strictly increasing JSON list of exactly N/2 distinct vertex labels "
+        "from 0 through N-1, containing vertex 0; it denotes the red side of "
+        "the colouring and its complement is blue."
+    ),
+    "bounds": {
+        "length": "exactly N/2",
+        "entry_min": 0,
+        "entry_max": "N-1",
+        "strictly_increasing": True,
+        "must_contain": 0,
+        "candidate_count": "binomial(N-1,N/2-1)",
+    },
+}
+
+NOTES: str = r"""
+Section 2 fixes the exact object: a red-blue colouring uses both colours and is
+perfect when every vertex has exactly one neighbour of the other colour.
+Observation 1 says this is equivalent to a perfect matching cut.  Section 3,
+Theorem 9 is the decisive easy-case result: Perfect Matching Cut is polynomial
+on bipartite graphs of diameter at most 3, using O(N^4) Phase-1 branches plus
+colour processing.  Hence this module is explicitly Track B, not a Track-A
+claim.  The NP-completeness regime in Theorem 19 starts at bipartite radius 4
+(its construction has diameter at most 8), and does not justify average-case
+hardness for a naively planted distribution.
+
+Generation samples the red/blue partition first.  Four equally sized latent
+blocks L0,L1,R0,R1 are used.  L0-R0 and L1-R1 contain all edges except several
+mixed regular omission relations; L0-R1 and L1-R0 are perfect matchings.  The
+two omission relations are disjoint after transposition.  Consequently every
+vertex has the same degree, every vertex has exactly one bichromatic neighbour,
+and every pair of vertices on one bipartition side has a common neighbour.  The
+last fact proves diameter at most 3.  A global random relabelling hides all four
+blocks, and the planted red set is carried through that relabelling.  No cut
+algorithm is run during generation.
+
+The degree outlier attack is neutralized by exact regularity.  The bipartition
+ansatz fails because it makes every edge bichromatic.  A densest-prefix greedy
+rule and a one-edge propagation ansatz are tested after label randomization, as
+are structure-aware random restarts.  The successful Theorem-9-style reference
+algorithm is reported separately, as Track B requires.  Escalation first raises
+the number of mixed omission matchings at fixed answer length; only after that
+axis is exhausted does it enlarge the graph, and it reports cap_bound before
+the 256-atom certificate limit would be crossed.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_GUESS_SAMPLES = 200_000
+
+# Filled from the harness-owned transcripts after the three arms are run.
+_G9_EVIDENCE = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
+    },
+    "hinted_verdict": "not yet measured",
+}
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_params(n, omissions, seed):
+    if not _is_int(n) or n < 5:
+        raise ValueError("n must be an integer at least 5")
+    if not _is_int(omissions) or omissions < 1:
+        raise ValueError("omissions must be a positive integer")
+    if 2 * omissions > n - 3:
+        raise ValueError("need 2*omissions <= n-3")
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+
+
+def _switch_relation(relation, forbidden, rng, rounds):
+    """Mix a regular bipartite relation by degree-preserving two-switches."""
+    n = len(relation)
+    for _ in range(rounds):
+        a = rng.randrange(n)
+        b = rng.randrange(n - 1)
+        if b >= a:
+            b += 1
+        only_a = relation[a] - relation[b]
+        only_b = relation[b] - relation[a]
+        if not only_a or not only_b:
+            continue
+        y = rng.choice(sorted(only_a))
+        z = rng.choice(sorted(only_b))
+        if z in forbidden[a] or y in forbidden[b]:
+            continue
+        relation[a].remove(y)
+        relation[b].remove(z)
+        relation[a].add(z)
+        relation[b].add(y)
+
+
+def _omission_relations(n, omissions, rng):
+    """Return disjoint regular relations A and B on [n] x [n].
+
+    A(i,j) means L0_i--R0_j is absent.  B(i,j) means
+    L1_j--R1_i is absent.  Their disjointness ensures that L0_i and L1_j
+    retain at least one of their two possible common neighbours.
+    """
+    shifts = rng.sample(range(n), 2 * omissions)
+    first = shifts[:omissions]
+    second = shifts[omissions:]
+    a = [{(i + shift) % n for shift in first} for i in range(n)]
+    b = [{(i + shift) % n for shift in second} for i in range(n)]
+    rounds = 20 * n * omissions
+    _switch_relation(a, b, rng, rounds)
+    _switch_relation(b, a, rng, rounds)
+    assert all(len(row) == omissions for row in a + b)
+    assert all(a[i].isdisjoint(b[i]) for i in range(n))
+    column_a = [0] * n
+    column_b = [0] * n
+    for i in range(n):
+        for j in a[i]:
+            column_a[j] += 1
+        for j in b[i]:
+            column_b[j] += 1
+    assert all(x == omissions for x in column_a + column_b)
+    return a, b
+
+
+def make_instance(n, seed=0, omissions=1, **params) -> dict:
+    """Inverse-generate a regular diameter-3 graph and its perfect colouring."""
+    if params:
+        raise TypeError("unexpected parameters: " + ", ".join(sorted(params)))
+    _validate_params(n, omissions, seed)
+    rng = random.Random(seed)
+    absent_0, absent_1_transpose = _omission_relations(n, omissions, rng)
+
+    # Natural labels: L0,L1,R0,R1.  Red is L0 union R0.
+    l0 = range(0, n)
+    l1 = range(n, 2 * n)
+    r0 = range(2 * n, 3 * n)
+    r1 = range(3 * n, 4 * n)
+    edges = []
+    for i in range(n):
+        for j in range(n):
+            if j not in absent_0[i]:
+                edges.append((i, 2 * n + j))
+            # B(i,j) records absence of L1_j--R1_i.
+            if j not in absent_1_transpose[i]:
+                edges.append((n + j, 3 * n + i))
+        edges.append((i, 3 * n + i))
+        edges.append((n + i, 2 * n + i))
+
+    total = 4 * n
+    old_to_new = list(range(total))
+    rng.shuffle(old_to_new)
+    left_set = {old_to_new[v] for v in itertools.chain(l0, l1)}
+    right_set = {old_to_new[v] for v in itertools.chain(r0, r1)}
+    moved_edges = []
+    for u, v in edges:
+        u2, v2 = old_to_new[u], old_to_new[v]
+        if u2 in right_set:
+            u2, v2 = v2, u2
+        moved_edges.append([u2, v2])
+    moved_edges.sort()
+
+    red = {old_to_new[v] for v in itertools.chain(range(n), range(2 * n, 3 * n))}
+    if 0 not in red:
+        red = set(range(total)) - red
+    answer = sorted(red)
+    inst = {
+        "vertex_count": total,
+        "block_size": n,
+        "omissions": omissions,
+        "degree": n - omissions + 1,
+        "left": sorted(left_set),
+        "right": sorted(right_set),
+        "edges": moved_edges,
+        "answer": answer,
+    }
+    return inst
+
+
+def _adjacency(inst):
+    count = inst["vertex_count"]
+    adj = [set() for _ in range(count)]
+    for edge in inst["edges"]:
+        if not isinstance(edge, list) or len(edge) != 2:
+            continue
+        u, v = edge
+        if _is_int(u) and _is_int(v) and 0 <= u < count and 0 <= v < count:
+            adj[u].add(v)
+            adj[v].add(u)
+    return adj
+
+
+def render(inst) -> str:
+    """Render a self-contained statement with the graph inline."""
+    adj = _adjacency(inst)
+    rows = "\n".join(
+        f"  {u}: " + ", ".join(str(v) for v in sorted(adj[u]))
+        for u in inst["left"]
+    )
+    statement = f"""Perfect matching cut in a bounded-diameter bipartite graph
+
+The graph below is finite, simple, undirected, regular, and bipartite.  Its
+vertices are the integers 0 through {inst['vertex_count'] - 1}.  The displayed
+bipartition is L and R.  Each adjacency row is given only for its vertex in L;
+an entry `u: v1, v2` means the undirected edges {{u,v1}} and {{u,v2}}.  There
+are no other edges.
+
+A red-blue colouring assigns every vertex one of the two colours and uses both
+colours.  It is perfect when every vertex has exactly one neighbour of the
+other colour.  Equivalently, the bichromatic edges form both a perfect matching
+and an edge cut; this is a perfect matching cut.
+
+Find a perfect red-blue colouring.  Submit the red vertex set.  To remove the
+irrelevant global colour swap, red must contain vertex 0.  A perfect colouring
+has equally many red and blue vertices, so your answer must contain exactly
+{inst['vertex_count'] // 2} distinct labels.  Write them as one strictly
+increasing JSON list.  Labels are 0-indexed; repetitions and labels outside
+0..{inst['vertex_count'] - 1} are forbidden.  The blue set is the complement.
+
+N = {inst['vertex_count']}
+regular degree = {inst['degree']}
+L = {json.dumps(inst['left'], separators=(',', ':'))}
+R = {json.dumps(inst['right'], separators=(',', ':'))}
+Adjacency rows for L:
+{rows}
+
+Give your final answer inside <answer></answer> tags, as a JSON list of the red
+vertex labels in strictly increasing order.
+Example: <answer>[0, 3, 5]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Extract the last tagged JSON list, tolerating prose and code fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
+    if fence:
+        body = fence.group(1).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(value, list) or not all(_is_int(x) for x in value):
+        return None
+    return value
+
+
+def verify(inst, answer):
+    """Check a candidate perfect colouring directly; never read inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    if not all(_is_int(v) for v in answer):
+        return False, "vertex labels must be integers"
+    total = inst.get("vertex_count")
+    if any(v < 0 or v >= total for v in answer):
+        return False, "vertex label out of range"
+    if len(set(answer)) != len(answer):
+        return False, "vertex labels must be distinct"
+    if answer != sorted(answer):
+        return False, "vertex labels must be strictly increasing"
+    if len(answer) != total // 2:
+        return False, f"expected exactly {total // 2} red vertices"
+    if answer[0] != 0:
+        return False, "vertex 0 must be red"
+
+    red = set(answer)
+    adj = _adjacency(inst)
+    for v in range(total):
+        opposite = 0
+        v_red = v in red
+        for w in adj[v]:
+            if (w in red) != v_red:
+                opposite += 1
+                if opposite > 1:
+                    return False, f"vertex {v} has more than one opposite-colour neighbour"
+        if opposite == 0:
+            return False, f"vertex {v} has no opposite-colour neighbour"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the balanced, oriented certificate language."""
+    total = inst["vertex_count"]
+    chosen = rng.sample(range(1, total), total // 2 - 1)
+    return [0] + sorted(chosen)
+
+
+def search_space(inst):
+    """Count all balanced colour sets containing 0."""
+    total = inst["vertex_count"]
+    return math.comb(total - 1, total // 2 - 1)
+
+
+def enumerate_all(inst):
+    """Count valid certificates exactly when at most 200,000 candidates exist."""
+    total = inst["vertex_count"]
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    count = 0
+    for tail in itertools.combinations(range(1, total), total // 2 - 1):
+        count += int(verify(inst, [0] + list(tail))[0])
+    return count
+
+
+def _bipartition_from_graph(inst):
+    adj = _adjacency(inst)
+    total = inst["vertex_count"]
+    colour = [-1] * total
+    for start in range(total):
+        if colour[start] != -1:
+            continue
+        colour[start] = 0
+        queue = deque([start])
+        while queue:
+            v = queue.popleft()
+            for w in adj[v]:
+                if colour[w] == -1:
+                    colour[w] = colour[v] ^ 1
+                    queue.append(w)
+                elif colour[w] == colour[v]:
+                    return None
+    return ([v for v in range(total) if colour[v] == 0],
+            [v for v in range(total) if colour[v] == 1])
+
+
+def canonical_key(inst):
+    """A relabelling-invariant common-neighbour signature of the graph."""
+    sides = _bipartition_from_graph(inst)
+    if sides is None:
+        return "nonbipartite"
+    adj = _adjacency(inst)
+    vertex_signatures = []
+    side_signatures = []
+    for side in sides:
+        local = []
+        for v in side:
+            sig = sorted(len(adj[v] & adj[w]) for w in side if w != v)
+            local.append(tuple(sig))
+            vertex_signatures.append(tuple(sig))
+        side_signatures.append(tuple(sorted(local)))
+    payload = {
+        "N": inst["vertex_count"],
+        "degrees": sorted(len(row) for row in adj),
+        "sides": sorted(side_signatures),
+        "vertices": sorted(vertex_signatures),
+    }
+    raw = json.dumps(payload, separators=(",", ":"), sort_keys=True)
+    return hashlib.sha256(raw.encode()).hexdigest()
+
+
+def escalate(params):
+    """Increase omission crowding first, then graph size, respecting answer caps."""
+    n = int(params["n"])
+    omissions = int(params.get("omissions", 1))
+    maximum = (n - 3) // 2
+    if omissions < maximum:
+        return {"n": n, "omissions": min(maximum, omissions + 2)}
+    new_n = n + 8
+    if 2 * new_n > 256:
+        return "cap_bound"
+    return {"n": new_n, "omissions": max(1, (new_n - 5) // 2)}
+
+
+def _structural_reference(inst):
+    """Exact hidden-block recovery by all common-neighbour comparisons."""
+    t0 = time.perf_counter()
+    sides = _bipartition_from_graph(inst)
+    if sides is None:
+        return None, {"operations": 0, "wall_clock_sec": time.perf_counter() - t0}
+    adj = _adjacency(inst)
+    operations = 0
+    blocks = []
+    for side in sides:
+        unseen = set(side)
+        local_blocks = []
+        while unseen:
+            start = min(unseen)
+            component = {start}
+            queue = [start]
+            unseen.remove(start)
+            while queue:
+                v = queue.pop()
+                for w in list(unseen):
+                    operations += min(len(adj[v]), len(adj[w]))
+                    if len(adj[v] & adj[w]) > 2:
+                        unseen.remove(w)
+                        component.add(w)
+                        queue.append(w)
+            local_blocks.append(component)
+        if len(local_blocks) != 2:
+            return None, {"operations": operations,
+                          "wall_clock_sec": time.perf_counter() - t0}
+        blocks.append(local_blocks)
+
+    first_side = 0 if 0 in set(sides[0]) else 1
+    other_side = 1 - first_side
+    start_block = next(block for block in blocks[first_side] if 0 in block)
+    edge_counts = []
+    for block in blocks[other_side]:
+        count = 0
+        for v in start_block:
+            operations += len(adj[v])
+            count += len(adj[v] & block)
+        edge_counts.append((count, block))
+    mate = max(edge_counts, key=lambda item: item[0])[1]
+    answer = sorted(start_block | mate)
+    return answer, {
+        "operations": operations,
+        "common_neighbour_comparisons": sum(
+            len(side) * (len(side) - 1) // 2 for side in sides
+        ),
+        "wall_clock_sec": time.perf_counter() - t0,
+    }
+
+
+def _propagate_perfect(inst, initial):
+    """Apply the paper's R1--R4 rules for d=1 to fixed initial colours."""
+    total = inst["vertex_count"]
+    adj = _adjacency(inst)
+    colour = [-1] * total
+    operations = 0
+    for v, c in initial.items():
+        if colour[v] not in (-1, c):
+            return None, operations
+        colour[v] = c
+    changed = True
+    while changed:
+        changed = False
+        forced = {}
+        for v in range(total):
+            red = blue = unknown = 0
+            for w in adj[v]:
+                operations += 1
+                if colour[w] == 0:
+                    red += 1
+                elif colour[w] == 1:
+                    blue += 1
+                else:
+                    unknown += 1
+            if colour[v] != -1:
+                opposite = blue if colour[v] == 0 else red
+                if opposite > 1 or (unknown == 0 and opposite != 1):
+                    return None, operations
+                continue
+            choices = set()
+            if red >= 2:
+                choices.add(0)
+            if blue >= 2:
+                choices.add(1)
+            if red >= 2 and blue >= 2:
+                return None, operations
+            for w in adj[v]:
+                if colour[w] == -1:
+                    continue
+                cw = colour[w]
+                for x in adj[w]:
+                    operations += 1
+                    if colour[x] == 1 - cw:
+                        choices.add(cw)
+                        break
+            if len(choices) > 1:
+                return None, operations
+            if choices:
+                forced[v] = next(iter(choices))
+        for v, c in forced.items():
+            if colour[v] == -1:
+                colour[v] = c
+                changed = True
+            elif colour[v] != c:
+                return None, operations
+    if any(c == -1 for c in colour):
+        return None, operations
+    red_set = [v for v, c in enumerate(colour) if c == 0]
+    if 0 not in red_set:
+        red_set = [v for v, c in enumerate(colour) if c == 1]
+    red_set.sort()
+    if verify(inst, red_set)[0]:
+        return red_set, operations
+    return None, operations
+
+
+def _theorem9_reference(inst, branch_cap=None):
+    """Run Theorem 9's Phase-1 edge-pair branching with R1--R4 processing.
+
+    If a residual uncoloured set remains, the exact structural routine supplies
+    the polynomial completion for this generated distribution.  The branch scan
+    itself does not inspect the planted answer.
+    """
+    t0 = time.perf_counter()
+    left = set(inst["left"])
+    oriented = []
+    for u, v in inst["edges"]:
+        oriented.append((u, v) if u in left else (v, u))
+    branches = 0
+    operations = 0
+    for a in range(len(oriented)):
+        u1, v1 = oriented[a]
+        for b in range(a + 1, len(oriented)):
+            u2, v2 = oriented[b]
+            if u1 == u2 or v1 == v2:
+                continue
+            for flip in (0, 1):
+                branches += 1
+                first = flip
+                candidate, used = _propagate_perfect(
+                    inst, {u1: first, v1: 1 - first,
+                           u2: 1 - first, v2: first})
+                operations += used
+                if candidate is not None:
+                    return candidate, {
+                        "branches": branches,
+                        "operations": operations,
+                        "wall_clock_sec": time.perf_counter() - t0,
+                        "completion": "R1-R4 propagation",
+                    }
+                if branch_cap is not None and branches >= branch_cap:
+                    return None, {
+                        "branches": branches,
+                        "operations": operations,
+                        "wall_clock_sec": time.perf_counter() - t0,
+                        "completion": "branch cap reached",
+                    }
+    candidate, stats = _structural_reference(inst)
+    return candidate, {
+        "branches": branches,
+        "operations": operations + stats["operations"],
+        "wall_clock_sec": time.perf_counter() - t0,
+        "completion": "exact common-neighbour completion",
+    }
+
+
+def _attack_degree_prefix(inst):
+    adj = _adjacency(inst)
+    total = inst["vertex_count"]
+    ordered = sorted(range(total), key=lambda v: (-len(adj[v]), v))
+    picked = set(ordered[:total // 2])
+    if 0 not in picked:
+        picked.remove(max(picked))
+        picked.add(0)
+    return sorted(picked)
+
+
+def _attack_bipartition(inst):
+    side = inst["left"] if 0 in set(inst["left"]) else inst["right"]
+    return sorted(side)
+
+
+def _attack_densest_prefix(inst):
+    adj = _adjacency(inst)
+    total = inst["vertex_count"]
+    chosen = {0}
+    while len(chosen) < total // 2:
+        remaining = (v for v in range(total) if v not in chosen)
+        best = max(remaining, key=lambda v: (len(adj[v] & chosen), -v))
+        chosen.add(best)
+    return sorted(chosen)
+
+
+def _attack_single_edge(inst):
+    u, v = min(tuple(sorted(edge)) for edge in inst["edges"])
+    candidate, _ = _propagate_perfect(inst, {u: 0, v: 1})
+    if candidate is not None:
+        return candidate
+    # An explicit, exactly shaped fallback rather than returning malformed data.
+    total = inst["vertex_count"]
+    picked = {0, v if u == 0 else u}
+    for x in range(total):
+        if len(picked) == total // 2:
+            break
+        picked.add(x)
+    return sorted(picked)
+
+
+def _relabel_instance(inst, old_to_new, rng):
+    total = inst["vertex_count"]
+    left = sorted(old_to_new[v] for v in inst["left"])
+    right = sorted(old_to_new[v] for v in inst["right"])
+    left_set = set(left)
+    edges = []
+    for u, v in inst["edges"]:
+        a, b = old_to_new[u], old_to_new[v]
+        if a not in left_set:
+            a, b = b, a
+        edges.append([a, b])
+    rng.shuffle(edges)
+    carried = {old_to_new[v] for v in inst["answer"]}
+    if 0 not in carried:
+        carried = set(range(total)) - carried
+    return {
+        "vertex_count": total,
+        "block_size": inst["block_size"],
+        "omissions": inst["omissions"],
+        "degree": inst["degree"],
+        "left": left,
+        "right": right,
+        "edges": edges,
+        "answer": sorted(carried),
+    }
+
+
+def _graph_diameter(inst):
+    adj = _adjacency(inst)
+    total = inst["vertex_count"]
+    diameter = 0
+    for source in range(total):
+        distance = [-1] * total
+        distance[source] = 0
+        queue = deque([source])
+        while queue:
+            v = queue.popleft()
+            for w in adj[v]:
+                if distance[w] == -1:
+                    distance[w] = distance[v] + 1
+                    queue.append(w)
+        if -1 in distance:
+            return math.inf
+        diameter = max(diameter, max(distance))
+    return diameter
+
+
+def selftest() -> dict:
+    """Run every mandatory gate and return all measured evidence."""
+    report = {}
+
+    verified = 0
+    structural = 0
+    attempts = 0
+    maximum_diameter = 0
+    for params in DIFFICULTY.values():
+        for seed in (0, 1, 2):
+            inst = make_instance(seed=seed, **params)
+            ok = verify(inst, inst["answer"])[0]
+            verified += int(ok)
+            candidate, _ = _structural_reference(inst)
+            structural += int(candidate is not None and verify(inst, candidate)[0])
+            maximum_diameter = max(maximum_diameter, _graph_diameter(inst))
+            attempts += 1
+    report["G1_planted_verifies"] = {
+        "pass": verified == attempts and structural == attempts and maximum_diameter <= 3,
+        "verified": verified,
+        "structural_recovery_verified": structural,
+        "diameter_max": maximum_diameter,
+        "attempts": attempts,
+        "generation_route": "inverse generation followed by vertex relabelling",
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=314159, **shipping_params)
+    base = shipping["answer"]
+    blue = sorted(set(range(shipping["vertex_count"])) - set(base))
+    swap_red = next(v for v in base if v != 0)
+    swapped = sorted((set(base) - {swap_red}) | {blue[0]})
+    duplicate = base[:]
+    duplicate[-1] = duplicate[-2]
+    corruptions = {
+        "drop": base[:-1],
+        "swap": swapped,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": base[:-1] + [shipping["vertex_count"]],
+    }
+    cases = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
+        cases[name] = {"rejected": not ok, "reason": reason}
+    reasons = {row["reason"] for row in cases.values()}
+    report["G2_rejects_corruption"] = {
+        "pass": all(row["rejected"] for row in cases.values()) and len(reasons) == 5,
+        "cases": cases,
+        "distinct_reasons": len(reasons),
+    }
+
+    wire = json.dumps(base, separators=(",", ":"))
+    model_style = (
+        "The common-neighbour classes give the cut.\n"
+        "<answer>```json\n" + wire + "\n```</answer>\n"
+        "The complement is blue."
+    )
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": (parsed == base and json.loads(json.dumps(base)) == base
+                 and parse_answer("not an answer") is None),
+        "parsed_equals_answer": parsed == base,
+        "json_native": json.loads(json.dumps(base)) == base,
+        "garbage_returns_none": parse_answer("not an answer") is None,
+    }
+
+    guess_rng = random.Random(8675309)
+    guess_hits = 0
+    for _ in range(_GUESS_SAMPLES):
+        guess_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
+    guess_fraction = guess_hits / _GUESS_SAMPLES
+    report["G4_guess_resistance"] = {
+        "pass": _GUESS_SAMPLES >= 200_000 and guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": _GUESS_SAMPLES,
+        "observed_probability": guess_fraction,
+        "candidate_space": search_space(shipping),
+        "prior": "uniform balanced red sets containing vertex 0",
+    }
+
+    reference, reference_stats = _theorem9_reference(shipping)
+    reference_ok = reference is not None and verify(shipping, reference)[0]
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": (guess_fraction < 1e-6 and reference_ok
+                 and isinstance(demo_count, int) and demo_count >= 1),
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": _GUESS_SAMPLES,
+        "shipping_density_fraction": guess_fraction,
+        "shipping_exact_enumeration": enumerate_all(shipping),
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "baseline_algorithm": "Theorem 9 Phase-1 edge-pair branching with R1-R4",
+        "baseline_wall_clock_seconds": round(reference_stats["wall_clock_sec"], 6),
+        "baseline_branches": reference_stats["branches"],
+        "baseline_primitive_checks": reference_stats["operations"],
+        "baseline_verified": reference_ok,
+        "baseline_completion": reference_stats["completion"],
+    }
+
+    attacks = {
+        "outlier_equal_degree_prefix": {"successes": 0, "attempts": 8},
+        "greedy_densest_prefix": {"successes": 0, "attempts": 8},
+        "random_restart_512": {"successes": 0, "attempts": 8},
+        "bipartition_as_colour_ansatz": {"successes": 0, "attempts": 8},
+        "single_edge_propagation_ansatz": {"successes": 0, "attempts": 8},
+    }
+    ref_successes = 0
+    ref_times = []
+    ref_branches = []
+    ref_operations = []
+    all_regular = True
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed, **shipping_params)
+        adj = _adjacency(inst)
+        all_regular = all_regular and len({len(row) for row in adj}) == 1
+        candidates = {
+            "outlier_equal_degree_prefix": _attack_degree_prefix(inst),
+            "greedy_densest_prefix": _attack_densest_prefix(inst),
+            "bipartition_as_colour_ansatz": _attack_bipartition(inst),
+            "single_edge_propagation_ansatz": _attack_single_edge(inst),
+        }
+        for name, candidate in candidates.items():
+            attacks[name]["successes"] += int(verify(inst, candidate)[0])
+        rrng = random.Random(seed ^ 0x5A17)
+        restart_hit = False
+        for _ in range(512):
+            if verify(inst, random_candidate(inst, rrng))[0]:
+                restart_hit = True
+                break
+        attacks["random_restart_512"]["successes"] += int(restart_hit)
+
+        candidate, stats = _theorem9_reference(inst)
+        ref_successes += int(candidate is not None and verify(inst, candidate)[0])
+        ref_times.append(stats["wall_clock_sec"])
+        ref_branches.append(stats["branches"])
+        ref_operations.append(stats["operations"])
+    all_failed = all(row["successes"] == 0 and row["attempts"] >= 8
+                     for row in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and ref_successes == 8 and all_regular,
+        "attacks": attacks,
+        "all_shipping_graphs_regular": all_regular,
+        "reference_algorithm": {
+            "name": "Theorem 9 Phase-1 edge-pair branching with R1-R4",
+            "complexity": "O(N^4) branches, each polynomial, on the paper's full diameter-3 class",
+            "wall_clock_sec_mean": round(sum(ref_times) / len(ref_times), 6),
+            "wall_clock_sec_max": round(max(ref_times), 6),
+            "branches_mean": round(sum(ref_branches) / len(ref_branches)),
+            "branches_max": max(ref_branches),
+            "operations_mean": round(sum(ref_operations) / len(ref_operations)),
+            "operations_max": max(ref_operations),
+            "solves": f"{ref_successes}/8, as expected",
+        },
+    }
+
+    doubled = make_instance(
+        n=2 * shipping_params["n"],
+        omissions=2 * shipping_params["omissions"],
+        seed=2718,
+    )
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": (doubled_ok and doubled["vertex_count"] > shipping["vertex_count"]
+                 and search_space(doubled) > search_space(shipping)),
+        "shipping_vertices": shipping["vertex_count"],
+        "doubled_vertices": doubled["vertex_count"],
+        "shipping_edges": len(shipping["edges"]),
+        "doubled_edges": len(doubled["edges"]),
+        "doubled_planted_verifies": doubled_ok,
+        "shipping_search_space_bits": round(math.log2(search_space(shipping)), 3),
+        "doubled_search_space_bits": round(math.log2(search_space(doubled)), 3),
+    }
+
+    invariant = 0
+    carried_valid = 0
+    for seed in range(20):
+        inst = make_instance(seed=1000 + seed, **shipping_params)
+        rrng = random.Random(9000 + seed)
+        first = list(range(inst["vertex_count"]))
+        second = list(range(inst["vertex_count"]))
+        rrng.shuffle(first)
+        rrng.shuffle(second)
+        composed = [second[first[v]] for v in range(inst["vertex_count"])]
+        transformed = _relabel_instance(inst, composed, rrng)
+        invariant += int(canonical_key(inst) == canonical_key(transformed))
+        carried_valid += int(verify(transformed, transformed["answer"])[0])
+    unrelated = {
+        canonical_key(make_instance(seed=2000 + seed, **shipping_params))
+        for seed in range(20)
+    }
+    report["G8_canonical_key"] = {
+        "pass": invariant == 20 and carried_valid == 20 and len(unrelated) == 20,
+        "composed_relabellings_invariant": invariant,
+        "carried_witnesses_valid": carried_valid,
+        "unrelated_distinct_keys": len(unrelated),
+        "attempts_each": 20,
+        "normalized_symmetries": [
+            "arbitrary vertex relabelling",
+            "bipartition-side swap induced by relabelling",
+            "edge-list reordering",
+            "left/right list reordering",
+        ],
+    }
+
+    answer_chars = answer_atoms = answer_tokens = 0
+    for seed in range(40):
+        answer = make_instance(seed=3000 + seed, **shipping_params)["answer"]
+        encoded = json.dumps(answer, separators=(",", ":"))
+        answer_chars = max(answer_chars, len(encoded))
+        answer_atoms = max(answer_atoms, len(answer))
+        answer_tokens = max(answer_tokens, (len(encoded) + 3) // 4)
+    intended_operations = 2 * shipping["vertex_count"] - 1
+    arms = _G9_EVIDENCE["arms"]
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = (answer_chars <= 2000 and answer_atoms <= 256
+                   and intended_operations <= 300)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": round(hinted_rate - placebo_rate, 6),
+        "hinted_verdict": _G9_EVIDENCE["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_atoms,
+        "intended_route_operations": intended_operations,
+        "operation_model": "one common-neighbour cardinality or block edge-count per operation",
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(shipping_params)
+    report["all_pass"] = all(
+        row.get("pass") is True for key, row in report.items()
+        if key.startswith("G") and isinstance(row, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

