%\left.  \alpha_1= \alpha_2+\cdots+\alpha_k, \  \Lambda^{-\alpha_1}_1,\Lambda^{\alpha_2}_2,\ldots,\Lambda^{\alpha_k}_k \in   \Pi_X  \text{ and }  \rho(\Lambda^{-\alpha_1}_1)\geq \rho(\Lambda^{\alpha_h}_h) \text{ for } h=2,\ldots,k  \right\}.
%$$


