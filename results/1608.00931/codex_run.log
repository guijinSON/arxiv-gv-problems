+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_count": search_space(demo),
+        "baseline_wall_seconds": restart_elapsed,
+        "baseline_iterations": restart_iterations,
+        "baseline_attack": "random_restart_two_swap_24x160 across 8 seeds",
+    }
+
