+    left_size = 1 << len(left_weights)
+    left_sums = [0] * left_size
+    left_counts = bytearray(left_size)
+    left_table: dict[tuple[int, int], int] = {(0, 0): 0}
+    operations = 0
+    for mask in range(1, left_size):
