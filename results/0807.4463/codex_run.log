import random, math, time
Q=997

def make(n,seed):
 r=random.Random(seed); d=math.ceil(29*n/41)
 S=[]
 for z in range(3): S.append({0,*r.sample(range(1,n),d-1)})
 ps=[]
 for c in range(3):
  rows=[(Q*r.randrange(1<<30,1<<31)+t,t) for t in range(n)]; r.shuffle(rows); ps.append(rows)
 co=[[t for _,t in row] for row in ps]
 E=[]
 for (x,y),s in zip(((0,1),(0,2),(1,2)),S):
  E.append([[((co[y][j]-co[x][i])%n in s) for j in range(n)] for i in range(n)])
 return r,ps,E

def valid(E,B,C):
 return all(E[0][a][B[a]] and E[1][a][C[a]] and E[2][B[a]][C[a]] for a in range(len(B)))

def lex(E):
 n=len(E[0]); ub=set(range(n));uc=set(range(n));B=[];C=[]
 for a in range(n):
  found=None
  for b in sorted(ub):
   if not E[0][a][b]:continue
   for c in sorted(uc):
    if E[1][a][c] and E[2][b][c]:found=(b,c);break
   if found:break
  if not found:return None
  b,c=found;B.append(b);C.append(c);ub.remove(b);uc.remove(c)
 return B,C

def randgreedy(E,rng,restarts=256):
 n=len(E[0])
 for rr in range(restarts):
  order=list(range(n));rng.shuffle(order);ub=set(range(n));uc=set(range(n));bb=[0]*n;cc=[0]*n;ok=True
  for a in order:
   pairs=[(b,c) for b in ub if E[0][a][b] for c in uc if E[1][a][c] and E[2][b][c]]
   if not pairs:ok=False;break
   b,c=rng.choice(pairs);bb[a]=b;cc[a]=c;ub.remove(b);uc.remove(c)
  if ok:return bb,cc,rr+1
 return None
