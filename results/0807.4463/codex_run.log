+    "demo": {"n": 5, "tag_bits": 3, "degree_extra": 0},
+    "easy": {"n": 83, "tag_bits": 48, "degree_extra": 4},
+    "medium": {"n": 89, "tag_bits": 72, "degree_extra": 2},
+    "hard": {"n": 97, "tag_bits": 96, "degree_extra": 0},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
