+    distinct_reasons = len({row["reason"] for row in rejection_reasons.values()})
+    report["G2_rejects_corruption"] = {
+        "pass": all(row["rejected"] for row in rejection_reasons.values())
+        and distinct_reasons == len(rejection_reasons),
