+        "The arrays use zero-based indices."
+    )
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted,
+        "parsed_equals_answer": parsed == planted,
+    }
+
+    # G4 and the shipping density component of G5.
+    guess_rng = random.Random(445566)
