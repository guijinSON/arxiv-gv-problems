def alg(E,seed=0,cap=1000000):
 n=len(E[0]);ops=0
 cand=[]
 for a in range(n):
  rr=[]
  for b in range(n):
   for c in range(n):
    ops+=3
    if E[0][a][b] and E[1][a][c] and E[2][b][c]:rr.append((b,c))
  random.Random((seed+1)*1000003+a).shuffle(rr);cand.append(rr)
