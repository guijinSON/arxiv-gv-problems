+        tags: list[list[int]] = []
+        lo = 1 << (tag_bits - 1)
+        hi = (1 << tag_bits) - 1
+        for _part in range(3):
+            records = [(_Q * rng.randint(lo, hi) + t, t) for t in range(n)]
+            rng.shuffle(records)
