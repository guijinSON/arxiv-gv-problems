+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON object with keys B and C, each an arbitrary permutation of "
+        "0..n-1; the two permutations encode one B- and one C-vertex for every "
+        "A-vertex."
