+        "tag_bits": tag_bits,
+        "degree_extra": degree_extra,
+        "tags": tags,
+        "adjacency": matrices,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render a self-contained exact triangle-factor problem."""
+    n = inst["n"]
+    tags = inst["tags"]
+    matrices = inst["adjacency"]
+    lines = [
+        "Triangle factor in a dense balanced tripartite graph",
