  for i,d in enumerate(dom):
   c=d.bit_count()
   if 1<c<bc:v=i;bc=c
  if v<0:return 1
  x=dom[v]
  while x:
   bit=x&-x;x-=bit;nd=dom[:];nd[v]=bit
   if dfs(nd):return 1
  return None
 t=time.time()
 try:r=dfs(dom);status=bool(r)
 except TimeoutError:status='"'limit'
 return status,nodes,time.time()-t
for q,d in [(8,6),(8,9),(8,12),(12,6),(12,9),(12,12),(18,6),(18,9),(18,12)]:
