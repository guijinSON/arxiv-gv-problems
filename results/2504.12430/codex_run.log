+        "pass": guess_rate < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "p_hat": guess_rate,
+        "threshold": 1e-6,
+        "prior": "independent uniform choice among the ten valid 2-subsets at every named vertex",
+        "structure_enforced": [
+            "exactly one record per vertex",
+            "two distinct colors per record",
