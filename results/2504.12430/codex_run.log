+def escalate(params: dict) -> dict | None:
+    """Grow the same constant-degree CSP; return None past the practical window."""
+
+    n = params.get("n")
+    if isinstance(n, bool) or not isinstance(n, int) or n < 1:
+        return None
+    if n >= 30:
+        return None
+    return {"n": n + 6}
