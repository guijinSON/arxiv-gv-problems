+
+def _reorder_instance(inst: dict, rng: random.Random) -> dict:
+    transformed = dict(inst)
+    edges = list(inst["edges"])
+    rng.shuffle(edges)
+    transformed["edges"] = [
+        (v, u) if rng.randrange(2) else (u, v) for u, v in edges
+    ]
