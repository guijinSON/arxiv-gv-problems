ALL=(1<<10)-1
ADJMASK=[sum(1<<x for x in row) for row in g.TARGET_ADJ]

def sample(q,d,seed):
 rng=random.Random(seed); labs=[c for c in range(10) for _ in range(q)];rng.shuffle(labs); classes=[[v for v,x in enumerate(labs) if x==c] for c in range(10)]; N=10*q; per=d*q//3
 assert d*q%3==0
 for attempt in range(20000):
  buckets={}
  for c,vs in enumerate(classes):
   st=[v for v in vs for _ in range(d)];rng.shuffle(st);ns=list(g.TARGET_ADJ[c]);rng.shuffle(ns)
   for j,z in enumerate(ns):buckets[c,z]=st[j*per:(j+1)*per]
  edges=[]
  for a,b in g.TARGET_EDGES:
   l=buckets[a,b][:];r=buckets[b,a][:];rng.shuffle(l);rng.shuffle(r);edges += [g._norm_edge(u,v) for u,v in zip(l,r)]
  if len(set(edges))<len(edges):continue
