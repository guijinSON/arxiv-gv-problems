+    out_of_range[0][1] = 6
+    return {
+        "drop_one": answer[:-1],
+        "swap_two_color_sets": swapped,
+        "duplicate_vertex": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
