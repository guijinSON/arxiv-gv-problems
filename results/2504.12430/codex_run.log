+
+    # G4: candidates already obey record shape, full vertex coverage, range, and
+    # two-distinct-colors.  This is the solver-aware 10^|V| prior, not raw JSON.
+    guess_rng = random.Random(99_991)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
