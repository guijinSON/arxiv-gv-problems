+
+def _attack_random_permutations(
+    inst: dict, rng: random.Random, attempts: int = 512
+) -> list[int] | None:
+    for _ in range(attempts):
+        candidate = random_candidate(inst, rng)
+        if _order_valid_rows(inst["transitions"], candidate):
+            return candidate
+    return None
