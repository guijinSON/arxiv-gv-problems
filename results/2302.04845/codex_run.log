+def _reference_algorithm(inst: dict) -> tuple[list[int] | None, dict]:
+    """Polynomial exhaustive bounded-modulus recognition and exact validation."""
+    t0 = time.perf_counter()
+    n = inst["n"]
+    blocks = inst["blocks"]
