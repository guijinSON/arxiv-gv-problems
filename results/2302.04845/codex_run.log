+        p["tag_bits"] = min(224, p["tag_bits"] + 32)
+        p["degree"] = max(2, p["degree"] - 1)
+        return p
+    if p["degree"] > 2:
+        p["degree"] -= 1
+        return p
+    if p.get("n", 0) < 144:
+        p["n"] = min(144, p.get("n", 0) + 12)
+        if p["n"] % 2:
+            p["n"] += 1
+        return p
