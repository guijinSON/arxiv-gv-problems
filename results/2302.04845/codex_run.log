        "drop_one": {"B": planted["B"][:-1], "C": planted["C"][:]},
        "duplicate": {"B": [planted["B"][0]] + planted["B"][:-1],
                      "C": planted["C"][:]},
        "out_of_range": {"B": [inst["n"]] + planted["B"][1:],
