+def _validate_parameters(n: int, seed: int, degree: int, q: int, tag_bits: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int) or not (6 <= n <= 256):
+        raise ValueError("n must be an integer in 6..256")
