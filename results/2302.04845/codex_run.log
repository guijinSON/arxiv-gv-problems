        q=math.gcd(q, abs(b['tags'][0]-b['tags'][2])); gcd_calls+=1
    residues=[b['tags'][0] % q for b in inst['blocks']]
    order=sorted(range(inst['n']), key=lambda i:(residues[i],i))
    ok=g.verify(inst, order)[0]
    times.append(time.perf_counter()-t); oks += ok
print({'tag_gcd_solves':f'{oks}/32','median_sec':sorted(times)[len(times)//2],
       'max_sec':max(times),'gcd_calls':gcd_calls,'mod_reductions':inst['n'],
       'edge_checks':inst['n'],'primitive_count_excluding_sort':gcd_calls+2*inst['n']})

# Original triage: planted directed cycle + independent p=1/2 decoys, then
# generic DFS with least-onward-degree ordering. This is the fixed-block
# transition subproblem used by the attempted generator.
def dense_instance(n, seed, pnum=1, pden=2):
    rng=random.Random(seed)
    cyc=list(range(n)); rng.shuffle(cyc)
    rows=[[False]*n for _ in range(n)]
    for i in range(n): rows[cyc[i]][cyc[(i+1)%n]]=True
    for i in range(n):
        for j in range(n):
            if i"'!=j and rng.randrange(pden)<pnum: rows[i][j]=True
    return rows

def dfs_cycle(rows, cap=100000):
    n=len(rows); out=[[j for j,x in enumerate(r) if x] for r in rows]
    path=[0]; used={0}; nodes=0; trials=0
    def dfs(u):
        nonlocal nodes,trials
        nodes+=1
        if nodes>cap:return False
        if len(path)==n:return rows[u][path[0]]
        choices=[v for v in out[u] if v not in used]
        choices.sort(key=lambda v:sum(w not in used for w in out[v]))
        for v in choices:
            trials+=1; used.add(v); path.append(v)
            if dfs(v): return True
            path.pop();used.remove(v)
        return False
    t=time.perf_counter(); ok=dfs(0); dt=time.perf_counter()-t
    return ok,nodes,trials,dt
