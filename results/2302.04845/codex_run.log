+def _attack_visual_tags(inst: dict) -> list[list[int] | None]:
+    blocks = inst["blocks"]
+    return [
+        _rank_order(blocks, lambda b: b["tags"][0]),
+        _rank_order(blocks, lambda b: b["tags"][0] % 10_000),
+    ]
