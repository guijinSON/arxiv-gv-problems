+    # Rational unit v on x+y+z=-1.  Hence <v,Pv>=0.  The height makes the
+    # printed coordinates mechanically unpleasant without changing geometry.
+    base = 1 << coord_bits
+    tq = base + rng.randrange(1, max(2, base // 3))
+    tp = base + rng.randrange(1, max(2, base // 3))
