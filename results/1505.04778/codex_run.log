+def _attack_nearest_seed(inst: dict) -> dict:
+    unused = set(range(len(inst["points"])))
+    groups = []
+    while unused:
+        seed = min(unused)
+        block = sorted(unused, key=lambda i: (_point_dist2(
+            inst["points"][seed], inst["points"][i]), i))[:inst["n"]]
+        groups.append(block)
+        unused.difference_update(block)
