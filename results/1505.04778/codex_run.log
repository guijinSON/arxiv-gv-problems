+    out["points"] = [inst["points"][old][:] for old in new_to_old]
+    carried = {"clusters": _canonical_clusters(
+        [[old_to_new[i] for i in group] for group in inst["answer"]["clusters"]])}
+    out["answer"] = carried
+    return out, carried
