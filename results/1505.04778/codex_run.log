+    "easy": {"n": 8, "coord_bits": 10, "radius_bits": 10},
+    "medium": {"n": 8, "coord_bits": 20, "radius_bits": 20},
+    "hard": {"n": 8, "coord_bits": 36, "radius_bits": 36},
