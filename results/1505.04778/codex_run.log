+            "greedy_nearest_seed": _attack_nearest_seed(x),
+        }
+        for name, candidate in fixed.items():
+            ok, _ = verify(x, candidate)
+            attack_counts[name][0] += int(ok)
+            attack_counts[name][1] += 1
