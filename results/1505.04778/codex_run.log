+def random_candidate(inst: dict, rng: random.Random) -> object:
+    order = list(range(len(inst["points"])))
+    rng.shuffle(order)
+    n = inst["n"]
+    return {"clusters": _canonical_clusters(
+        [order[a * n:(a + 1) * n] for a in range(3)])}
