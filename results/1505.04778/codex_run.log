+    assert len(set(reasons.values())) == len(reasons), reasons
+    report["G2_rejects_corruption"] = {"pass": True, "rejected": len(reasons),
+                                        "distinct_reasons": len(set(reasons.values())),
+                                        "reasons": reasons}
