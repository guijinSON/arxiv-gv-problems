+def _isometric_instance(inst: dict, perm: tuple[int, ...],
+                        signs: tuple[int, ...], shift: tuple[int, ...]) -> dict:
+    out = dict(inst)
+    dimension = inst["dimension"]
+    out["points"] = [[signs[j] * p[perm[j]] + shift[j] for j in range(dimension)]
+                     for p in inst["points"]]
