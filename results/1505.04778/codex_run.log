+def enumerate_all(inst: dict) -> int | None:
+    if search_space(inst) > 50_000:
+        return None
+    count = 0
+    for groups in _balanced_partitions(tuple(range(len(inst["points"]))),
+                                       inst["n"], inst["k"]):
+        ok, _ = verify(inst, {"clusters": _canonical_clusters(groups)})
+        count += int(ok)
+    return count
