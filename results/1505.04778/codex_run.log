+    return {
+        "n": n,
+        "k": 3,
+        "dimension": 4,
+        "points": shuffled,
+        "answer": answer,
+        "construction": {
+            "coord_bits": coord_bits,
+            "radius_bits": radius_bits,
+            "cleared_denominator_digits": len(str(scale)),
+        },
+    }
