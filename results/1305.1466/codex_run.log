   170	_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
   171	_FENCE_RE = re.compile(r"```(?:json|text)?\s*(.*?)```", re.I | re.S)
