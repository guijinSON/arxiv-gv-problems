   173	
   174	def _is_prime(value: int) -> bool:
   175	    if value < 2:
   176	        return False
   177	    if value % 2 == 0:
   178	        return value == 2
   179	    limit = math.isqrt(value)
   180	    divisor = 3
   181	    while divisor <= limit:
   182	        if value % divisor == 0:
   183	            return False
   184	        divisor += 2
   185	    return True
   186	
   187	
   188	def _next_prime(value: int) -> int:
   189	    value = max(5, int(value))
   190	    if value % 2 == 0:
   191	        value += 1
   192	    while not _is_prime(value):
   193	        value += 2
   194	    return value
   195	
   196	
   197	def _inverse_mod(value: int, modulus: int) -> int:
   198	    old_r, r = value % modulus, modulus
   199	    old_s, s = 1, 0
   200	    while r:
   201	        quotient = old_r // r
   202	        old_r, r = r, old_r - quotient * r
   203	        old_s, s = s, old_s - quotient * s
   204	    if old_r != 1:
   205	        raise ValueError("value is not invertible")
   206	    return old_s % modulus
   207	
   208	
   209	def _choose_slope(p: int, rng: random.Random) -> int:
   210	    forbidden = {1, p - 1, 2 % p, (-2) % p} if p >= 11 else set()
   211	    choices = [value for value in range(1, p) if value not in forbidden]
   212	    return rng.choice(choices)
   213	
   214	
   215	def _answer_from_affine(p: int, slope: int, offset: int) -> list[int]:
   216	    inverse = _inverse_mod(slope, p)
   217	    first = (-offset * inverse) % p
   218	    answer = []
   219	    colour = first
   220	    for _ in range(p):
   221	        answer.append(colour)
   222	        colour = (colour + inverse) % p
   223	    return answer
   224	
   225	
   226	def _rows(inst: dict) -> list[set[int]]:
   227	    p = int(inst["p"])
   228	    raw = inst.get("core_incidence")
   229	    if not isinstance(raw, list) or len(raw) != p:
   230	        raise ValueError("malformed incidence family")
   231	    rows = []
   232	    for row in raw:
   233	        if not isinstance(row, list):
   234	            raise ValueError("malformed incidence row")
   235	        parsed = set()
   236	        for edge in row:
   237	            if isinstance(edge, bool) or not isinstance(edge, int) or not 0 <= edge < p:
   238	                raise ValueError("core-edge index outside range")
   239	            parsed.add(edge)
   240	        if len(parsed) != len(row):
   241	            raise ValueError("duplicate core edge within a colour class")
   242	        rows.append(parsed)
   243	    return rows
   244	
   245	
   246	def _short_affine_candidates(
   247	    rows: list[set[int]] | list[list[int]], checked_rows: int = 6
   248	) -> set[tuple[int, int]]:
   249	    p = len(rows)
   250	    stop = min(p, checked_rows)
   251	    candidates: set[tuple[int, int]] = set()
   252	    for offset in rows[0]:
   253	        for second in rows[1]:
   254	            slope = (second - offset) % p
   255	            if slope == 0:
   256	                continue
   257	            predicted = second
   258	            good = True
   259	            for colour in range(2, stop):
   260	                predicted = (predicted + slope) % p
   261	                if predicted not in rows[colour]:
   262	                    good = False
   263	                    break
   264	            if good:
   265	                candidates.add((slope, offset))
   266	    return candidates
   267	
