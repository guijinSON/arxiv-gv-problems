   694	def _relabeled_instance(
   695	    inst: dict,
   696	    colour_map: list[int] | None = None,
   697	    edge_map: list[int] | None = None,
   698	) -> dict:
   699	    """Carry the instance and witness through genuine relabellings."""
   700	    p = int(inst["p"])
   701	    if colour_map is None:
   702	        colour_map = list(range(p))
   703	    if edge_map is None:
   704	        edge_map = list(range(p))
   705	    transformed_rows: list[list[int] | None] = [None] * p
   706	    for old_colour, row in enumerate(inst["core_incidence"]):
   707	        transformed_rows[colour_map[old_colour]] = [edge_map[edge] for edge in reversed(row)]
   708	    answer = [-1] * p
   709	    for old_edge, old_colour in enumerate(inst["answer"]):
   710	        answer[edge_map[old_edge]] = colour_map[old_colour]
   711	    return {
   712	        "paper": inst["paper"],
   713	        "requested_n": inst["requested_n"],
   714	        "p": p,
   715	        "class_size": inst["class_size"],
   716	        "width": inst["width"],
   717	        "padding_per_class": inst["padding_per_class"],
   718	        "core_incidence": [row for row in transformed_rows if row is not None],
   719	        "display_order": [colour_map[c] for c in reversed(inst["display_order"])],
   720	        "answer": answer,
   721	    }
