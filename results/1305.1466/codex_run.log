   325	    """Render the complete standalone rainbow-matching certification task."""
   326	    p = int(inst["p"])
   327	    width = int(inst["width"])
   328	    class_size = int(inst["class_size"])
   329	    padding = int(inst["padding_per_class"])
   330	    lines = [
   331	        "Certify a displayed full rainbow matching",
   332	        "",
   333	        "A matching is a set of graph edges with no shared endpoint. A full rainbow",
   334	        "matching for colour classes F_0,...,F_{p-1} is a matching of p edges that",
   335	        "uses exactly one edge from every F_c. An edge may belong to several F_c;",
   336	        "the certificate must specify which distinct colour is assigned to each edge.",
   337	        "",
   338	        f"Here p={p}. The graph is bipartite. Its displayed core vertices are",
   339	        f"L_0,...,L_{p-1} on the left and R_0,...,R_{p-1} on the right.",
   340	        f"For 0 <= t < {p}, B_t is the edge (L_t,R_t). Thus",
   341	        "R={B_0,...,B_(p-1)} is already a p-edge matching.",
   342	        "",
   343	        f"There are p colour classes. Every F_c is itself a matching of exactly",
   344	        f"floor(5p/3)={class_size} edges. The row for F_c below lists the {width}",
   345	        "core indices t for which B_t belongs to F_c.",
   346	        f"In addition, F_c contains exactly {padding} private padding edges",
   347	        "(X_(c,j),Y_(c,j)) for j=0,...,padding-1. All X_(c,j) and Y_(c,j)",
   348	        "are vertices different from every core vertex and from private vertices",
   349	        "with another pair (c,j). These padding edges make the stated class size",
   350	        "exact; they are not edges of the displayed matching R.",
   351	        "The order of rows and the order of indices within a row have no meaning.",
   352	        "",
   353	        "Core incidences:",
   354	    ]
   355	    for colour in inst["display_order"]:
   356	        items = " ".join(str(edge) for edge in inst["core_incidence"][colour])
   357	        lines.append(f"  F_{colour}: {items}")
   358	    mode = os.environ.get("GV_HINT_MODE")
   359	    if mode == "structural":
   360	        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
   361	    elif mode == "placebo":
   362	        lines.extend(["", "Hint: " + PLACEBO_HINT])
   363	    lines.extend(
   364	        [
   365	            "",
   366	            "Assign every edge of R to a different colour class containing it. This",
   367	            "assignment certifies that the displayed R is a full rainbow matching.",
   368	            "",
   369	            f"Give your final answer inside <answer></answer> tags as one JSON array of exactly {p} integers.",
   370	            "Array entry t is the colour c assigned to B_t; the array must be a",
   371	            f"permutation of all integers 0,...,{p-1}. Indices are 0-based, both",
   372	            "bounds are inclusive, and no colour may repeat.",
   373	            "Example format: <answer>[2,0,1]</answer>",
   374	            "Output nothing else inside the tags.",
   375	        ]
   376	    )
   377	    return "\n".join(lines)
