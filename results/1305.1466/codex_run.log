   590	def _hopcroft_karp(inst: dict) -> tuple[list[int] | None, dict[str, int]]:
   591	    """Find an incidence perfect matching and count exact edge scans."""
   592	    rows = _rows(inst)
   593	    adjacency = _eligible_by_edge(rows)
   594	    p = len(rows)
   595	    pair_left = [-1] * p
   596	    pair_right = [-1] * p
   597	    distance = [0] * p
   598	    counters = {"edge_scans": 0, "bfs_rounds": 0, "augmentations": 0}
   599	
   600	    def bfs() -> bool:
   601	        counters["bfs_rounds"] += 1
   602	        queue = []
   603	        for left in range(p):
   604	            if pair_left[left] < 0:
   605	                distance[left] = 0
   606	                queue.append(left)
   607	            else:
   608	                distance[left] = -1
   609	        found = False
   610	        head = 0
   611	        while head < len(queue):
   612	            left = queue[head]
   613	            head += 1
   614	            for right in adjacency[left]:
   615	                counters["edge_scans"] += 1
   616	                other = pair_right[right]
   617	                if other < 0:
   618	                    found = True
   619	                elif distance[other] < 0:
   620	                    distance[other] = distance[left] + 1
   621	                    queue.append(other)
   622	        return found
   623	
   624	    def dfs(left: int) -> bool:
   625	        for right in adjacency[left]:
   626	            counters["edge_scans"] += 1
   627	            other = pair_right[right]
   628	            if other < 0 or (
   629	                distance[other] == distance[left] + 1 and dfs(other)
   630	            ):
   631	                pair_left[left] = right
   632	                pair_right[right] = left
   633	                return True
   634	        distance[left] = -1
   635	        return False
   636	
   637	    matching = 0
   638	    while bfs():
   639	        for left in range(p):
   640	            if pair_left[left] < 0 and dfs(left):
   641	                matching += 1
   642	                counters["augmentations"] += 1
   643	    if matching != p:
   644	        return None, counters
   645	    return pair_left, counters
   646	
