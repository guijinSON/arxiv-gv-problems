   461	
   462	def _wl_signature(inst: dict) -> tuple:
   463	    """A relabelling-invariant signature of the core incidence graph."""
   464	    rows = _rows(inst)
   465	    p = len(rows)
   466	    columns = [set() for _ in range(p)]
   467	    for colour, row in enumerate(rows):
   468	        for edge in row:
   469	            columns[edge].add(colour)
   470	
   471	    left_colours = [0] * p
   472	    right_colours = [1] * p
   473	    for _ in range(8):
   474	        signatures = []
   475	        for colour, row in enumerate(rows):
   476	            signatures.append(
   477	                (0, left_colours[colour], tuple(sorted(right_colours[e] for e in row)))
   478	            )
   479	        for edge, column in enumerate(columns):
   480	            signatures.append(
   481	                (1, right_colours[edge], tuple(sorted(left_colours[c] for c in column)))
   482	            )
   483	        palette = {sig: index for index, sig in enumerate(sorted(set(signatures)))}
   484	        new_left = [palette[sig] for sig in signatures[:p]]
   485	        new_right = [palette[sig] for sig in signatures[p:]]
   486	        left_colours, right_colours = new_left, new_right
   487	
   488	    row_profiles = sorted(
   489	        (left_colours[c], tuple(sorted(right_colours[e] for e in row)))
   490	        for c, row in enumerate(rows)
   491	    )
   492	    column_profiles = sorted(
   493	        (right_colours[e], tuple(sorted(left_colours[c] for c in column)))
   494	        for e, column in enumerate(columns)
   495	    )
   496	    edge_profiles = sorted(
   497	        (left_colours[c], right_colours[e])
   498	        for c, row in enumerate(rows)
   499	        for e in row
   500	    )
   501	    return (
   502	        p,
   503	        int(inst["width"]),
   504	        int(inst["class_size"]),
   505	        tuple(row_profiles),
   506	        tuple(column_profiles),
   507	        tuple(edge_profiles),
   508	    )
   509	
   510	
   511	def canonical_key(inst: dict) -> str:
   512	    """Hash a strong WL invariant, never the seed or rendered statement."""
   513	    blob = json.dumps(_wl_signature(inst), separators=(",", ":"))
   514	    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
