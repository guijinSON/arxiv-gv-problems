   724	def _answer_size(answer) -> tuple[int, int, int]:
   725	    blob = json.dumps(answer, separators=(",", ":"))
   726	
   727	    def atoms(value) -> int:
   728	        if isinstance(value, dict):
   729	            return sum(atoms(item) for item in value.values())
   730	        if isinstance(value, (list, tuple)):
   731	            return sum(atoms(item) for item in value)
   732	        return 1
   733	
   734	    return len(blob), math.ceil(len(blob) / 4), atoms(answer)
