   648	def _compact_affine_route(inst: dict) -> tuple[list[int] | None, int]:
   649	    """Execute and count the intended affine change of variables."""
   650	    rows = _rows(inst)
   651	    p = len(rows)
   652	    survivors: set[tuple[int, int]] = set()
   653	    operations = 0
   654	    for offset in rows[0]:
   655	        for second in rows[1]:
   656	            slope = (second - offset) % p
   657	            operations += 1
   658	            if slope == 0:
   659	                continue
   660	            predicted = second
   661	            good = True
   662	            for colour in range(2, min(p, 6)):
   663	                predicted = (predicted + slope) % p
   664	                operations += 1
   665	                if predicted not in rows[colour]:
   666	                    good = False
   667	                    break
   668	            if good:
   669	                survivors.add((slope, offset))
   670	    if len(survivors) != 1:
   671	        return None, operations
   672	    slope, offset = next(iter(survivors))
   673	
   674	    old_r, r = slope, p
   675	    old_s, s = 1, 0
   676	    while r:
   677	        quotient = old_r // r
   678	        operations += 1
   679	        old_r, r = r, old_r - quotient * r
   680	        old_s, s = s, old_s - quotient * s
   681	        operations += 4
   682	    inverse = old_s % p
   683	    operations += 1
   684	    colour = (-offset * inverse) % p
   685	    operations += 2
   686	    answer = []
   687	    for _ in range(p):
   688	        answer.append(colour)
   689	        colour = (colour + inverse) % p
   690	        operations += 1
   691	    return answer, operations
   692	
