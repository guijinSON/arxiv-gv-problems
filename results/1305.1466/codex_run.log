   578	def _obvious_affine_attack(inst: dict) -> list[int] | None:
   579	    p = int(inst["p"])
   580	    rows = _rows(inst)
   581	    for slope in (1, p - 1, 2 % p, (-2) % p):
   582	        if slope == 0:
   583	            continue
   584	        for offset in range(p):
   585	            if all((slope * colour + offset) % p in rows[colour] for colour in range(p)):
