   269	def make_instance(n: int, seed: int = 0, **params) -> dict:
   270	    """Inverse-generate a full-rainbow certificate for a displayed matching."""
   271	    rng = random.Random(seed)
   272	    if isinstance(n, bool) or not isinstance(n, int) or n < 5:
   273	        raise ValueError("n must be an integer at least 5")
   274	    width = params.pop("width", 4)
   275	    if params:
   276	        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
   277	    if isinstance(width, bool) or not isinstance(width, int):
   278	        raise ValueError("width must be an integer")
   279	
   280	    p = _next_prime(n)
   281	    if not 1 <= width <= min(8, p - 1):
   282	        raise ValueError("width must lie between 1 and min(8,p-1)")
   283	    class_size = (5 * p) // 3
   284	    padding = class_size - width
   285	
   286	    # The certificate is complete before any decoy or display order is drawn.
   287	    slope = _choose_slope(p, rng)
   288	    offset = rng.randrange(p)
   289	    answer = _answer_from_affine(p, slope, offset)
   290	
   291	    # Make the compact route concrete: in the first six labelled rows, the
   292	    # planted affine line is the unique surviving affine explanation.  This is
   293	    # rejection sampling around a certificate already held by construction.
   294	    for _construction_attempt in range(10_000):
   295	        incidence = []
   296	        for colour in range(p):
   297	            planted = (slope * colour + offset) % p
   298	            row = {planted}
   299	            while len(row) < width:
   300	                row.add(rng.randrange(p))
   301	            displayed = list(row)
   302	            rng.shuffle(displayed)
   303	            incidence.append(displayed)
   304	        if p < 6 or _short_affine_candidates(incidence) == {(slope, offset)}:
   305	            break
   306	    else:
   307	        raise RuntimeError("could not expose a unique affine certificate")
   308	
   309	    display_order = list(range(p))
   310	    rng.shuffle(display_order)
   311	    return {
   312	        "paper": "arXiv:1305.1466",
   313	        "requested_n": n,
   314	        "p": p,
   315	        "class_size": class_size,
   316	        "width": width,
   317	        "padding_per_class": padding,
   318	        "core_incidence": incidence,
   319	        "display_order": display_order,
   320	        "answer": answer,
   321	    }
   322	
