   517	def escalate(params: dict) -> dict | str | None:
   518	    """Increase decoy crowding first, then p while the answer remains writable."""
   519	    n = int(params.get("n", 79))
   520	    width = int(params.get("width", 4))
   521	    harder = dict(params)
   522	    if width < 8:
   523	        harder["width"] = min(8, width + 2)
   524	        harder["n"] = n
   525	        return harder
   526	    p = _next_prime(n)
   527	    if p < 167:
   528	        harder["n"] = _next_prime(p + 10)
   529	        harder["width"] = width
   530	        return harder
   531	    return "cap_bound"
   532	
