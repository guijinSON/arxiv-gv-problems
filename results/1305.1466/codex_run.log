+# Filled from the script-owned hardening transcripts after the three runs.
+# These are diagnostics only; G9 passes exactly when the size/effort caps pass.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
