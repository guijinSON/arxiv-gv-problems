   439	def random_candidate(inst: dict, rng: random.Random) -> object:
   440	    """Sample uniformly from the statement-implied permutation language."""
   441	    candidate = list(range(int(inst["p"])))
   442	    rng.shuffle(candidate)
   443	    return candidate
