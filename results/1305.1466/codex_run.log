   446	def search_space(inst: dict) -> int | None:
   447	    """Return the exact size p! of the bounded certificate language."""
   448	    return math.factorial(int(inst["p"]))
   449	
   450	
   451	def enumerate_all(inst: dict) -> int | None:
   452	    """Count valid certificates when p! is at most 100,000."""
   453	    p = int(inst["p"])
   454	    if math.factorial(p) > 100_000:
   455	        return None
   456	    return sum(
   457	        int(verify(inst, list(candidate))[0])
   458	        for candidate in itertools.permutations(range(p))
   459	    )
