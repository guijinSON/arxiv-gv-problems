   380	def parse_answer(text) -> object | None:
   381	    """Extract the JSON permutation from prose, markdown fences, and whitespace."""
   382	    if not isinstance(text, str):
   383	        return None
   384	    matches = _ANSWER_RE.findall(text)
   385	    if not matches:
   386	        for fenced in _FENCE_RE.findall(text):
   387	            matches.extend(_ANSWER_RE.findall(fenced))
   388	    if not matches:
   389	        return None
   390	    try:
   391	        value = json.loads(matches[-1].strip())
   392	    except (TypeError, ValueError):
   393	        return None
   394	    if not isinstance(value, list):
   395	        return None
   396	    if any(isinstance(item, bool) or not isinstance(item, int) for item in value):
   397	        return None
   398	    return value
   399	
   400	
   401	def verify(inst: dict, answer) -> tuple[bool, str]:
   402	    """Check any valid incidence bijection without consulting ``inst['answer']``."""
   403	    if answer == []:
   404	        return False, "answer is empty"
   405	    if not isinstance(answer, list):
   406	        return False, "answer must be a JSON array"
   407	    p = int(inst.get("p", -1))
   408	    if len(answer) != p:
   409	        return False, f"expected exactly {p} colours, got {len(answer)}"
   410	    for position, colour in enumerate(answer):
   411	        if isinstance(colour, bool) or not isinstance(colour, int):
   412	            return False, f"colour at position {position} is not an integer"
   413	        if not 0 <= colour < p:
   414	            return False, f"colour at position {position} is outside 0..{p-1}"
   415	    if len(set(answer)) != p:
   416	        return False, "colours do not form a bijection: a colour is repeated or missing"
   417	
   418	    try:
   419	        rows = _rows(inst)
   420	    except (KeyError, TypeError, ValueError) as exc:
   421	        return False, f"malformed instance: {exc}"
   422	    expected_size = (5 * p) // 3
   423	    if inst.get("class_size") != expected_size:
   424	        return False, "malformed instance: colour-class size is not floor(5p/3)"
   425	    if inst.get("padding_per_class") != expected_size - int(inst.get("width", -1)):
   426	        return False, "malformed instance: padding count is inconsistent"
   427	    if any(len(row) != int(inst["width"]) for row in rows):
   428	        return False, "malformed instance: a core-incidence row has wrong size"
   429	
   430	    # B_t=(L_t,R_t), so using every t exactly once is an exact endpoint check.
   431	    if len({("L", t) for t in range(p)}) != p or len({("R", t) for t in range(p)}) != p:
   432	        return False, "malformed instance: displayed R is not a matching"
   433	    for edge_index, colour in enumerate(answer):
   434	        if edge_index not in rows[colour]:
   435	            return False, f"edge B_{edge_index} is not present in F_{colour}"
   436	    return True, "ok"
   437	
