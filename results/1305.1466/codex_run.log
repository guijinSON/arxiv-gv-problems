   534	def _eligible_by_edge(rows: list[set[int]]) -> list[list[int]]:
   535	    p = len(rows)
   536	    eligible = [[] for _ in range(p)]
   537	    for colour, row in enumerate(rows):
   538	        for edge in row:
   539	            eligible[edge].append(colour)
   540	    for choices in eligible:
   541	        choices.sort()
   542	    return eligible
   543	
   544	
   545	def _greedy_fixed(
   546	    rows: list[set[int]],
   547	    *,
   548	    rng: random.Random | None = None,
   549	    outlier_scores: list[int] | None = None,
   550	) -> list[int] | None:
   551	    eligible = _eligible_by_edge(rows)
   552	    used: set[int] = set()
   553	    answer = [-1] * len(rows)
   554	    for edge in range(len(rows)):
   555	        choices = [colour for colour in eligible[edge] if colour not in used]
   556	        if not choices:
   557	            return None
   558	        if rng is not None:
   559	            colour = rng.choice(choices)
   560	        elif outlier_scores is not None:
   561	            colour = min(choices, key=lambda c: (outlier_scores[c], c))
   562	        else:
   563	            colour = min(choices)
   564	        answer[edge] = colour
