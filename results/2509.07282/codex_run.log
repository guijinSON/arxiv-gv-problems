+)
+
+_TEMPLATES = {
+    0: (
+        "WHEN THE {0} {1} {2} THE {3} {4}, EVERY PERSON IN THE ROOM BECAME QUIET.",
+        "ALTHOUGH A {0} {1} {2} THE {3} {4}, NOBODY DOUBTED THE FINAL REPORT.",
+        "BEFORE SUNSET, THE {0} {1} {2} EACH {3} {4} WITH GREAT CARE.",
+    ),
+    1: (
