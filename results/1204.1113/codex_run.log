+        "pass": parsed == planted and parse_answer("no certificate here") is None,
+        "parsed": parsed,
+        "garbage_returns_none": parse_answer("no certificate here") is None,
+    }
+
+    guess_total = 200000
+    guess_hits = 0
+    guess_rng = random.Random(12041113)
