+        "swap": planted[::-1],
+        "duplicate": planted + planted[-1:],
+        "empty": [],
+        "out_of_range": [shipping["limb_base"], planted[1]],
+    }
+    cases = {}
+    reasons = set()
+    for name, candidate in corruptions.items():
