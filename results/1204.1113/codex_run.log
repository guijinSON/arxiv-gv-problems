+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=0, **shipping_params)
+    planted = shipping["answer"]
+    corruptions = {
+        "drop": planted[:1],
+        "swap": planted[::-1],
+        "duplicate": planted + planted[-1:],
+        "empty": [],
+        "out_of_range": [shipping["limb_base"], planted[1]],
+    }
