+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=31, **doubled_params)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    _answer, doubled_operations = _reference_algorithm(doubled)
+    report["G7_scales"] = {
