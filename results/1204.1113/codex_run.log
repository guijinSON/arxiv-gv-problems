+        unit_rng = random.Random(5000 + seed)
+        unit = _sample_unit(unit_rng, inst["p"] - 1)
+        exponent_shift = (7919 * seed + 104729) % (inst["p"] - 1)
+        root = _decode_root(inst["answer"], inst["limb_base"])
