+        inst["terms"], key=lambda pair: abs(pair[0] - p // 2))
+    del coefficient
+    if math.gcd(exponent, modulus) != 1:
+        return _encode_root(0, inst["limb_base"])
+    candidate = pow(3, pow(exponent, -1, modulus), p)
+    return _encode_root(candidate, inst["limb_base"])
