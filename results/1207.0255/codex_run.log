p=g.DIFFICULTY['hard']; t=time.perf_counter(); keys=set(); max_nonce=0
for seed in range(200):
 a=g.make_instance(seed=seed,**p); b=g.make_instance(seed=seed,**p)
 assert a==b
 assert json.loads(json.dumps(a['answer']))==a['answer']
 assert g.verify({k:v for k,v in a.items() if k"'!='"'answer'},a['answer'])==(True,'ok')
 M=a['target']; assert sum(a['sizes'])==a['n']*M
 assert all(M//4 < x < M//2 for x in a['sizes'])
 assert [len(x) for x in g._bands(a)]==[a['n']]*3
 ref,ops,nodes,cands=g._reference_algorithm_x(a); assert g.verify(a,ref)[0]
 keys.add(g.canonical_key(a)); max_nonce=max(max_nonce,a['selection_attempts'])
assert len(keys)==200
inst=g.make_instance(seed=9,**g.DIFFICULTY['demo'])
assert g.enumerate_all(inst)==72
for n in range(2,8):
