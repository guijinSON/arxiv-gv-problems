   166	# --- the oracle call --------------------------------------------------------
   167	def _ask_blocking(model, prompt, key):
   168	    """Return (reply_text, http_status, finish_reason, error, empty).
   169	
   170	    Exactly one of reply/error is set.  An empty body is NOT an API error: it is
   171	    flagged via `empty`, and attempt() scores it as an unsolved attempt.  A model
   172	    that spends its whole budget on reasoning and emits nothing did not produce a
   173	    witness under the conditions the pool is measured at, so it consumes its slot
   174	    rather than being redrawn.  The diagnostic is preserved in verify_reason so a
   175	    level hardened this way can still be told apart from one hardened on wrong
   176	    answers -- if ORACLE_MAX_TOKENS is the real constraint, raise it and re-run.
   177	
   178	    Every model in the default pool accepts OpenRouter's normalised `reasoning`
   179	    field, so no per-vendor body mapping is needed.  A model that rejects it is
   180	    reported as an error rather than silently retried without it — dropping the
   181	    effort setting would change what the hardness claim means.
   182	    """
   183	    body = json.dumps({
   184	        "model": model,
   185	        "reasoning": {"effort": ORACLE_EFFORT},
   186	        "messages": [{"role": "user", "content": prompt}],
   187	        "max_tokens": MAX_TOKENS,
   188	    }).encode()
   189	    req = urllib.request.Request(
   190	        ENDPOINT, data=body,
   191	        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
   192	    )
   193	    try:
   194	        with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT,
   195	                                    context=SSL_CONTEXT) as resp:
   196	            status = resp.status
   197	            payload = json.loads(resp.read().decode())
   198	    except urllib.error.HTTPError as e:
   199	        return None, e.code, None, f"http {e.code}: {e.read()[:400].decode('utf-8', 'replace')}", False
   200	    except Exception as e:                                    # noqa: BLE001
   201	        return None, None, None, f"{type(e).__name__}: {e}", False
   202	    try:
   203	        choice = payload["choices"][0]
   204	        text = choice["message"]["content"]
   205	        finish = choice.get("finish_reason") or choice.get("native_finish_reason")
   206	    except (KeyError, IndexError, TypeError):
   207	        return None, status, None, f"unparseable response: {json.dumps(payload)[:400]}", False
   208	    if not (text or "").strip():
   209	        usage = payload.get("usage") or {}
   210	        return None, status, finish, (
   211	            f"empty reply (finish_reason={finish}, usage={json.dumps(usage)[:160]}) — "
   212	            f"the model returned no content, most likely because reasoning consumed "
   213	            f"max_tokens={MAX_TOKENS}; raise ORACLE_MAX_TOKENS"), True
   214	    return text, status, finish, None, False
   215	
   216	
   217	def ask(model, prompt, key):
   218	    """_ask_blocking under a hard wall-clock deadline.
   219	
   220	    A deadline overrun is reported as an ERROR, not a failure to solve: the model
   221	    never got to answer, so scoring it as unsolved would manufacture hardness out
   222	    of a hung socket.  attempt() redraws against a different vendor.
   223	    """
   224	    box = {}
   225	
   226	    def run():
   227	        try:
   228	            box["v"] = _ask_blocking(model, prompt, key)
   229	        except Exception as e:                                # noqa: BLE001
   230	            box["v"] = (None, None, None, f"{type(e).__name__}: {e}", False)
   231	
   232	    # daemon=True matters: a wedged socket must not keep the interpreter alive at
   233	    # exit, which is exactly what a ThreadPoolExecutor worker would do.
   234	    t = threading.Thread(target=run, daemon=True, name=f"oracle-{model}")
   235	    t.start()
   236	    t.join(TOTAL_DEADLINE)
   237	    if t.is_alive():
   238	        return (None, None, None,
   239	                f"total deadline exceeded: no complete response in {TOTAL_DEADLINE}s",
   240	                False)
   241	    return box.get("v", (None, None, None, "worker produced no result", False))
   242	
   243	
   244	def attempt(mod, model, params, seed, key):
   245	    """One oracle call.  Returns the transcript record for it."""
   246	    inst = mod.make_instance(seed=seed, **params)
   247	    t0 = time.time()
   248	    reply, status, finish, error, empty = ask(model, mod.render(inst), key)
   249	    elapsed = round(time.time() - t0, 2)
   250	
   251	    rec = {
   252	        "schema_version": SCHEMA_VERSION,
   253	        "model": model,
   254	        "effort": ORACLE_EFFORT,
   255	        "params": dict(params),
   256	        "seed": seed,
   257	        "solved": "error",
   258	        "parsed": False,
   259	        "verify_ok": None,
   260	        "verify_reason": None,
   261	        "reply": reply,
   262	        "error": error,
   263	        "elapsed_sec": elapsed,
   264	        "http_status": status,
   265	        "finish_reason": finish,
   266	    }
   267	    if empty:
   268	        # Scored as an unsolved attempt, not an API error: the model returned no
   269	        # witness within its budget.  error stays None so the invariant
   270	        # "error is not None => solved == 'error'" holds.
   271	        rec["solved"] = "failed"
   272	        rec["verify_reason"] = f"empty length-limited response ({error})"
   273	        rec["error"] = None
   274	        return rec
   275	    if error is not None:
   276	        return rec
   277	
   278	    ans = mod.parse_answer(reply)
   279	    rec["parsed"] = ans is not None
   280	    if ans is None:
   281	        # Not an error, and not evidence of hardness either: a reply that
   282	        # visibly contains an answer but does not parse is a renderer bug.
   283	        rec["solved"] = "failed"
   284	        rec["verify_reason"] = "parse_answer returned None"
   285	        return rec
   286	
   287	    ok, why = mod.verify(inst, ans)
   288	    rec["verify_ok"] = bool(ok)
   289	    rec["verify_reason"] = why
   290	    rec["solved"] = "solved" if ok else "failed"
   291	    return rec
   292	
   293	
   294	# --- the loop ---------------------------------------------------------------
   295	def run_level(mod, params, preset, escalation_round, rng, key, out):
   296	    """Ask the pool to solve this difficulty.  Returns True if any model solved it.
   297	
   298	    Draws distinct models where the pool allows, so three failures are three
   299	    vendors failing rather than one vendor failing three times.  A call that
   300	    errors out is redrawn against a different model and does not consume an
   301	    attempt: an API outage must never be recorded as the model failing to solve,
   302	    which is exactly how a hardness claim gets manufactured out of a 500.  An
   303	    empty length-limited reply is NOT an error -- it is scored as a failure and
   304	    consumes its slot (see ask()).
   305	    """
   306	    k = min(ATTEMPTS_PER_PRESET, len(ORACLE_POOL))
   307	    schedule = rng.sample(ORACLE_POOL, k)
   308	    while len(schedule) < ATTEMPTS_PER_PRESET:
   309	        schedule.append(rng.choice(ORACLE_POOL))
   310	
   311	    # A redraw after an error has to keep the level spread across vendors.  One
   312	    # model that reliably errors on a family — a reasoning budget it never
   313	    # escapes at this size, say — would otherwise hand its slot to a vendor that
   314	    # is either already here or queued next, and "three vendors failed" quietly
   315	    # becomes "two vendors failed, one of them twice".  Observed live: at n=80 a
   316	    # sonnet-5 timeout put gpt-5.6-terra in two of three slots.  So a substitute
   317	    # must avoid whoever has spoken AND whoever is still pending.
   318	    spoke = set()
   319	    solved_any = False
   320	    for slot in range(len(schedule)):
   321	        model = schedule[slot]
   322	        pending = set(schedule[slot + 1:])
   323	        tried, rec = 0, None
   324	        while tried <= MAX_ERROR_RETRIES:
   325	            seed = rng.randrange(1, 2**31 - 1)
   326	            if tried == 0:
   327	                use = model
   328	            else:
   329	                fresh = [m for m in ORACLE_POOL if m not in spoke and m not in pending]
   330	                use = rng.choice(fresh or [m for m in ORACLE_POOL if m not in spoke]
   331	                                 or ORACLE_POOL)
   332	            rec = attempt(mod, use, params, seed, key)
   333	            rec["preset"] = preset
   334	            rec["escalation_round"] = escalation_round
   335	            out.write(json.dumps(rec) + "\n")
   336	            out.flush()
   337	            if rec["solved"] != "error":
   338	                spoke.add(use)
   339	                break
   340	            tried += 1
   341	            print(f"  ! {use} errored ({rec['error'][:80]}) — redrawing", file=sys.stderr)
   342	        if rec is None or rec["solved"] == "error":
   343	            sys.exit("ERROR: the oracle pool is unreachable — cannot make a hardness claim.")
   344	        mark = {"solved": "SOLVED", "failed": "failed"}[rec["solved"]]
   345	        print(f"  {rec['model']:38s} seed={rec['seed']:<12d} {mark}", file=sys.stderr)
   346	        if rec["solved"] == "solved":
   347	            solved_any = True
   348	    return solved_any
   349	
