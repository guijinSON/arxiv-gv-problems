     1	#!/usr/bin/env python3
     2	"""The LLM hardening loop.  Usage: python3 scripts/harden.py <path to gen_*.py>
     3	
     4	This file, not the builder, owns the loop.  The builder writes gen_<id>.py and
     5	runs this; everything about which model is asked, with which seed, and when a
     6	family is declared too easy is decided here.  That is deliberate: a builder that
     7	reports its own hardening result has an obvious incentive not to report a
     8	failure, and a transcript whose schema is chosen per run cannot be validated.
     9	
    10	Requires OPENROUTER_API_KEY.  The oracle pool spans four vendors, so a single
    11	OpenAI key is not enough.  Standard library only.
    12	"""
    13	
    14	import importlib.util
    15	import json
    16	import os
    17	import random
    18	import sys
    19	import threading
    20	import time
    21	import ssl
    22	import urllib.error
    23	import urllib.request
    24	
    25	# --- configuration ----------------------------------------------------------
    26	# The oracle pool.  Four vendors at the same price tier as the model this
    27	# replaced (openai/gpt-5.6-terra, $2/$12 per M tokens).  A model is drawn afresh
    28	# for every single call: a family that only defeats one model's blind spots is
    29	# not hard, it is overfitted to.
    30	#
    31	# openai/gpt-5.6-sol is deliberately absent — it is the builder model, and a
    32	# family checked against its own author proves nothing.
    33	DEFAULT_POOL = [
    34	    "openai/gpt-5.6-terra",
    35	    "anthropic/claude-sonnet-5",
    36	    "google/gemini-3.1-pro-preview",
    37	    "x-ai/grok-4.6",
    38	]
    39	ORACLE_POOL = [m.strip() for m in os.environ.get(
    40	    "ORACLE_POOL", ",".join(DEFAULT_POOL)).split(",") if m.strip()]
    41	
    42	ORACLE_EFFORT = os.environ.get("ORACLE_EFFORT", "medium")
    43	ATTEMPTS_PER_PRESET = 3      # distinct models per difficulty level
    44	# Raises of difficulty before the family is given up on.  This was 3, and 7 of the
    45	# 13 too_easy verdicts on disk came from EXHAUSTING IT rather than from the family
    46	# running out of hardness: 1612.03280 stopped at n=149 with escalate() still willing
    47	# to climb to 237 before it would have said cap_bound.  A budget is not a property of
    48	# the paper, so hitting it is now reported as `budget_bound`, not `too_easy` -- see
    49	# the end of main().  The budget still exists because each level costs a full pool
    50	# sweep; it is env-overridable so a park can be re-run with a bigger one.
    51	MAX_ESCALATIONS = int(os.environ.get("ORACLE_MAX_ESCALATIONS", "6"))
    52	MAX_ERROR_RETRIES = 3        # per attempt; API errors do not count as attempts
    53	MAX_TOKENS = int(os.environ.get("ORACLE_MAX_TOKENS", "32000"))
    54	# Reasoning tokens are billed against max_tokens on some vendors, so a budget
    55	# sized for the answer alone comes back HTTP 200 with an empty body — observed
    56	# live at 16000 against claude-sonnet-5 on a 2030-character statement.
    57	REQUEST_TIMEOUT = 900
    58	# urlopen(timeout=) is a per-socket-operation timeout, NOT a total deadline: a
    59	# provider that trickles bytes (or holds a streaming connection open) resets it on
    60	# every read, so a single call can hang indefinitely.  Observed live -- one call
    61	# sat open 44 minutes against a 900s "timeout" and blocked the paper for 74.  The
    62	# request therefore runs on a worker thread under a hard wall-clock deadline.
    63	TOTAL_DEADLINE = int(os.environ.get("ORACLE_TOTAL_DEADLINE", str(REQUEST_TIMEOUT)))
    64	
    65	# The published answer cap (prompts/codex_task.md): <= 2000 chars and <= 256 atoms.
    66	ANSWER_CHAR_CAP  = 2000
    67	ANSWER_ATOM_CAP  = 256
    68	# How close to the cap counts as "the cap is what stopped you". A ladder that has
    69	# already consumed most of the budget had nowhere left to go along the axis it was
    70	# using, whatever escalate() says about the mathematics.
    71	CAP_NEAR_FRACTION = 0.6
