+    for gap in range(inst["n"]):
+        components = slots[3 * gap : 3 * gap + 3]
+        total = sum(inst["sizes"][component] for component in components)
+        if total != inst["target"]:
+            return False, (
+                f"capacity mismatch: gap {gap} receives total span {total}, "
+                f"not M={inst['target']}"
+            )
