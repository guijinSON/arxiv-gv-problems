The documentation and measured report now match the shipping preset. I’m doing a final contract audit: deterministic generation, JSON-native answers, hint isolation, exact verifier round-trip, transcript schemas, profile/legacy consistency, and cross-file metric agreement.
exec
/bin/bash -lc "sed -n '1,260p' ../../scripts/emit.sh
rg -n \"PROBLEM_PROFILE|TRACK|SHIPPING_DIFFICULTY|G9|canonical_key|CERTIFICATE_LANGUAGE\" ../../scripts/submit.sh | sed -n '1,220p'
python3 - <<'PY'
import ast, importlib.util, json, os
from pathlib import Path
p=Path('gen_1207_0255.py')
spec=importlib.util.spec_from_file_location('g',p)
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.TRACK in ('A','B') and g.SHIPPING_DIFFICULTY=='medium'
assert g.NATIVE['domain']==g.PROBLEM_PROFILE['native_domain']
assert g.NATIVE['core']==g.PROBLEM_PROFILE['computational_core']
assert g.NATIVE['objects']==g.PROBLEM_PROFILE['native_objects']
assert g.NATIVE['reduction']==g.PROBLEM_PROFILE['reduction']
a=g.make_instance(seed=314159,**g.DIFFICULTY['medium'])
b=g.make_instance(seed=314159,**g.DIFFICULTY['medium'])
assert a==b
assert json.loads(json.dumps(a['answer']))==a['answer']
assert g.verify(a,a['answer'])==(True,'ok')
wrapped='prose\\n"'```json'"\\n'+json.dumps(a['answer'])+'\\n"'```'"\\nmore'
assert g.parse_answer(wrapped)==a['answer']
base=g.render(a)
os.environ['GV_HINT_MODE']='structural'; structural=g.render(a)
os.environ['GV_HINT_MODE']='placebo'; placebo=g.render(a)
os.environ.pop('GV_HINT_MODE')
assert base==g.render(a)
