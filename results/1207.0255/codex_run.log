import random,statistics,time

def gen(k,R,seed):
 r=random.Random(seed)
 x=[r.randrange(R) for _ in range(k)]; y=[r.randrange(R) for _ in range(k)]
 p=list(range(k));r.shuffle(p)
 z=[x[i]+y[p[i]] for i in range(k)]
 # permute each side independent, retain plant triples by values positions
 # duplicates okay identities remain distinct
 r.shuffle(x);r.shuffle(y);r.shuffle(z)
 return x,y,z

def edges(x,y,z):
 dz={}
 for k,v in enumerate(z):dz.setdefault(v,[]).append(k)
 return [(i,j,h) for i,a in enumerate(x) for j,b in enumerate(y) for h in dz.get(a+b,[])]

def solve(k,es,cap=200000):
 bx=[[] for _ in range(k)];by=[[] for _ in range(k)];bz=[[] for _ in range(k)]
 for ei,e in enumerate(es):
  bx[e[0]].append(ei);by[e[1]].append(ei);bz[e[2]].append(ei)
 ux=[0]*k;uy=[0]*k;uz=[0]*k;nodes=0
 def good(e):return not ux[e[0]] and not uy[e[1]] and not uz[e[2]]
 def rec(left):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  if left==0:return True
  opts=None
  for u,arr in [(u,bx[u]) for u in range(k) if not ux[u]]+[(u,by[u]) for u in range(k) if not uy[u]]+[(u,bz[u]) for u in range(k) if not uz[u]]:
   o=[ei for ei in arr if good(es[ei])]
   if not o:return False
   if opts is None or len(o)<len(opts): opts=o
  for ei in opts:
   i,j,h=es[ei];ux[i]=uy[j]=uz[h]=1
   q=rec(left-1)
   ux[i]=uy[j]=uz[h]=0
   if q is not False:return q
  return False
 return rec(k),nodes
for k in [16,20,24,28,32,40]:
 for R in [k*2,k*4,k*8,k*12,k*k//3,k*k//2]:
  ns=[];ec=[];caps=0
  for seed in range(8):
   e=edges(*gen(k,R,seed)); s,n=solve(k,e);ns.append(n);ec.append(len(e));caps += s is None
  print('kR',k,R,'edges',int(statistics.median(ec)),'nodes med/max',statistics.median(ns),max(ns),'caps',caps,flush=True)
