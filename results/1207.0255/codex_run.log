 return vals,ans

def triples(vals,n,q):
 q2=q*q
 X=[i for i,x in enumerate(vals) if x<3500*q2//1000]
 Y=[i for i,x in enumerate(vals) if 3500*q2//1000<=x<4500*q2//1000]
