+    ],
+    "verification_operations": [
+        "exact modular subtraction",
+        "edge-set membership",
+        "exact clique check",
+        "exact closed-neighborhood domination check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Recognize each allowed cross-part difference set as a cyclic translate "
+        "of its audit baseline and recover the translations from first moments; "
+        "without this invariant one must search a crowded colored-clique CSP."
+    ),
+    "hardness_basis": (
+        "Track B: Theorem 7 gives a fixed-k matrix-multiplication algorithm for "
+        "Dominating Clique; the executable exact colored-clique DFS used here has "
+        "worst-case O(k^2 q^(k-1)) cost after fixing the global translation and, "
+        "at the provisional hard preset q=211,k=8, averages about 690,000 exact "
+        "edge probes over eight seeds, while the first-moment route uses fewer "
