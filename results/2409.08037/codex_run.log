   528	def _compact_cycle_reference(inst):
   529	    """Solve the tight cycle using one recurrence, not generic elimination."""
   530	    variables, rhs = _ordered_cycle_data(inst)
   531	    n = len(variables)
   532	    # Particular solution with y_0=y_1=0 for all non-wrapping equations.
   533	    y = [0, 0]
   534	    operations = 0
   535	    for i in range(n - 2):
   536	        y.append(rhs[i] ^ y[i] ^ y[i + 1])
   537	        operations += 2
   538	
   539	    wrap1 = rhs[n - 2] ^ y[n - 2] ^ y[n - 1] ^ y[0]
   540	    wrap2 = rhs[n - 1] ^ y[n - 1] ^ y[0] ^ y[1]
   541	    operations += 6
   542	    if n % 3 == 2:
   543	        b = wrap1
   544	        a = wrap2
   545	        c = a ^ b
   546	    elif n % 3 == 1:
   547	        c = wrap1
   548	        b = wrap2
   549	        a = c ^ b
   550	    else:
   551	        return None, operations
   552	    operations += 1
   553	
   554	    homogeneous = (a, b, c)
   555	    cycle_bits = []
   556	    for i, particular in enumerate(y):
   557	        cycle_bits.append(particular ^ homogeneous[i % 3])
   558	        operations += 1
   559	    assignment = [0] * n
   560	    for variable, bit in zip(variables, cycle_bits):
   561	        assignment[variable] = bit
   562	    return _assignment_to_rows(inst, assignment), operations
