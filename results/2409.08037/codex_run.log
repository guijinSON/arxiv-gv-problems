+        for name, candidate in candidates.items():
+            if candidate is not None and verify(inst, candidate)[0]:
+                attack_results[name]["successes"] += 1
+    attack_wall = time.perf_counter() - attack_started
+    all_failed = all(row["successes"] == 0 for row in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed,
+        "attacks": attack_results,
+        "failing_panel_wall_clock_sec": round(attack_wall, 6),
+        "candidate_degree_spread_within_each_part": 0,
+        "reference_algorithm": {
+            "name": "exact color-ordered dominating-clique DFS",
+            "complexity": "O(k^2*q^(k-1)) worst case after translation fixing",
+            "wall_clock_sec": round(reference_wall, 6),
+            "operations": reference_probes,
+            "nodes": sum(row["nodes"] for row in reference_rows),
