/bin/bash -lc "python3 - <<'PY'
import importlib.util,time
s=importlib.util.spec_from_file_location('g','gen_2409_08037.py');g=importlib.util.module_from_spec(s);s.loader.exec_module(g)

def dpll(inst):
 c=inst['clauses']; n=inst['n']; ops=nodes=0
 def rec(a):
  nonlocal ops,nodes
  nodes+=1
  a=a[:]
  while True:
   changed=False
   for clause in c:
    sat=False; unk=[]
    for lit in clause:
     ops+=1
     v=abs(lit)-1
     if a[v] is None: unk.append(lit)
     elif a[v]==(lit>0): sat=True; break
    if sat: continue
    if not unk:return None
    if len(unk)==1:
     lit=unk[0];v=abs(lit)-1; val=int(lit>0)
     if a[v] is not None and a[v]"'!=val:return None
     if a[v] is None:a[v]=val;changed=True;ops+=1
   if not changed:break
  try:v=a.index(None)
  except ValueError:return a
  for val in (0,1):
   b=a[:];b[v]=val;ops+=1
   z=rec(b)
   if z is not None:return z
  return None
 return rec([None]*n),nodes,ops

p=g.DIFFICULTY['"'hard']
for seed in range(100,108):
 i=g.make_instance(seed=seed,**p);t=time.perf_counter();a,nodes,ops=dpll(i);dt=time.perf_counter()-t
 ans=g._assignment_to_rows(i,a) if a else None
 print(seed,'ok',bool(ans and g.verify(i,ans)[0]),'nodes',nodes,'literal_ops',ops,'sec',round(dt,6))
