+def _assignment_to_rows(inst, assignment):
+    answer = []
+    for group in inst["groups"]:
+        wanted = [assignment[v] for v in group["variables"]]
+        try:
+            answer.append(group["rows"].index(wanted))
+        except ValueError:
+            return None
+    return answer
