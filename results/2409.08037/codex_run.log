+    scores = [0] * inst["n"]
+    for clause in inst["clauses"]:
+        for literal in clause:
+            scores[abs(literal) - 1] += 1 if literal > 0 else -1
+    assignment = [1 if score > 0 else 0 for score in scores]
+    return _assignment_to_rows(inst, assignment)
