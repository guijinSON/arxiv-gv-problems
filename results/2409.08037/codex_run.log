+def _ordered_cycle_data(inst):
+    equations = _extract_equations(inst)
+    edge_order = _cycle_equation_order(equations)
+    variables = []
+    for i, edge in enumerate(edge_order):
+        leaving = set(edge) - set(edge_order[(i + 1) % len(edge_order)])
+        if len(leaving) != 1:
