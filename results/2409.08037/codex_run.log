   584	def canonical_key(inst):
   585	    """Canonicalise row/group/coordinate order and the tight-cycle dihedral action."""
   586	    variables, _ = _ordered_cycle_data(inst)
   587	    group_of = {}
   588	    for gi, group in enumerate(inst["groups"]):
   589	        for variable in group["variables"]:
   590	            group_of[variable] = gi
   591	    sequence = [group_of[v] for v in variables]
   592	    candidates = []
   593	    for oriented in (sequence, list(reversed(sequence))):
   594	        for shift in range(len(oriented)):
   595	            rotated = oriented[shift:] + oriented[:shift]
   596	            candidates.append(_normalise_labels(rotated))
   597	    canonical_partition = min(candidates)
   598	    payload = {
   599	        "n": inst["n"],
   600	        "r": inst["r"],
   601	        "copies": inst["copies"],
   602	        "partition": canonical_partition,
   603	    }
   604	    return hashlib.sha256(
   605	        json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
   606	    ).hexdigest()
