+def _gaussian_reference(inst):
+    """Generic exact linear algebra after recovering the parity quartets."""
+    equations = _extract_equations(inst)
+    n = inst["n"]
+    rows = []
+    for variables, rhs in equations.items():
+        row = 0
+        for variable in variables:
+            row |= 1 << variable
+        row |= rhs << n
+        rows.append(row)
 
