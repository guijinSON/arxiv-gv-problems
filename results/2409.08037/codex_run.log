+                    variable = abs(literal) - 1
+                    value = int(literal > 0)
+                    if assignment[variable] is None:
+                        assignment[variable] = value
+                        operations += 1
+                        changed = True
+                    elif assignment[variable] != value:
+                        return None
+            if not changed:
