   645	def _attack_literal_majority(inst):
   646	    scores = [0] * inst["n"]
   647	    for clause in inst["clauses"]:
   648	        for literal in clause:
   649	            scores[abs(literal) - 1] += 1 if literal > 0 else -1
   650	    assignment = [1 if score > 0 else 0 for score in scores]
   651	    return _assignment_to_rows(inst, assignment)
