+            "solves": f"{compact_successes}/8",
+        },
+    }
+
+    doubled_n = shipping_params["n"] * 2
+    if doubled_n % 3 == 0:
+        doubled_n += 1
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] = doubled_n
