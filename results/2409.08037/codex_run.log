+            g1_attempts += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": reason})
+            try:
+                assert json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            except (AssertionError, TypeError, ValueError) as exc:
+                g1_failures.append({"preset": preset, "seed": seed,
