inst=g.make_instance(seed=2026,**g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
ans=inst['answer']; print('json_native',json.loads(json.dumps(ans))==ans)
reply='Some reasoning.\\n"'```json'"\\n<answer>'+json.dumps(ans)+'</answer>\\n"'```'"'
parsed=g.parse_answer(reply); print('roundtrip',parsed==ans,'verify',g.verify(inst,parsed))
print('search_space',g.search_space(inst),'answer_chars',len(json.dumps(ans,separators=(',',':'))))
r=json.load(open('selftest_report.json'))
print('report_all_passed',r['all_passed'],'oracle_ready',r['G9_no_tool_suitability']['oracle_evidence_ready'])
for name in ('gen_2409_08037.py','selftest_report.json','llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl','README.md'):
    print(name,os.path.getsize(name))
