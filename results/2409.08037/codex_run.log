+def _answer_size(answer):
+    blob = json.dumps(answer, separators=(",", ":"))
+    atoms = len(answer)
+    # Conservative corpus convention: roughly two tokens per integer plus brackets.
+    tokens = 2 * atoms + 2
+    return len(blob), tokens, atoms
