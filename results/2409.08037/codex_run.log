+
+    def recurse(assignment):
+        nonlocal operations, nodes
+        nodes += 1
+        assignment = list(assignment)
+        while True:
+            changed = False
+            for clause in clauses:
+                satisfied = False
+                unknown = []
+                for literal in clause:
+                    operations += 1  # one literal inspection
+                    variable = abs(literal) - 1
+                    value = assignment[variable]
