+"""Verified generator for cyclic Dominating Clique instances.
+
+The native problem is the paper's Dominating k-Clique problem (Section 4.1):
+find k vertices that induce a clique and dominate every graph vertex.  Candidate
+parts and redundant forcing groups follow the construction in Appendix C.
+
+Generation is inverse.  Hidden part potentials and a global translate are
+sampled first.  Every cross-part difference set is then translated so that the
+chosen vertices are adjacent.  The forcing groups and within-part cliques make
+that planted clique dominate the graph.  No clique search is run by generation.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import sys
+import time
