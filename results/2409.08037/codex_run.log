+    0,
+    os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))),
+)
+try:
+    from gvlib import exact_matrices, rationals  # noqa: F401
+except ImportError:
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
