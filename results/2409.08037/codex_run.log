+    doubled = make_instance(seed=8181, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    scale_elapsed = time.perf_counter() - scale_start
+    escalated = escalate(shipping_params)
+    report["G7_scales"] = {
