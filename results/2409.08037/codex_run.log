   728	    swap = None
   729	    for i in range(len(answer)):
   730	        for j in range(i + 1, len(answer)):
   731	            if answer[i] == answer[j]:
   732	                continue
   733	            candidate = list(answer)
   734	            candidate[i], candidate[j] = candidate[j], candidate[i]
   735	            ok, reason = verify(inst, candidate)
   736	            if not ok and reason not in used_reasons:
   737	                swap = candidate
   738	                break
   739	        if swap is not None:
   740	            break
   741	    if swap is None:
