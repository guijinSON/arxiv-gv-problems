   464	        if len(leaving) != 1:
   465	            raise ValueError("consecutive equations do not have one leaving variable")
   466	        variables.append(next(iter(leaving)))
   467	    for i, edge in enumerate(edge_order):
   468	        expected = {variables[i], variables[(i + 1) % len(variables)],
   469	                    variables[(i + 2) % len(variables)]}
   470	        if set(edge) != expected:
   471	            raise ValueError("recovered variable order is not a tight cycle")
   472	    rhs = [equations[edge] for edge in edge_order]
   473	    return variables, rhs
