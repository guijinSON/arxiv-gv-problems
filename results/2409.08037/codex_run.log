+NOTES = (
+    "Section 1 and Section 4 fix the exact definition: an H-dominating set S "
+    "dominates the graph in the closed-neighborhood sense and G[S] must be "
+    "isomorphic to H.  This module takes H=K_k.  Appendix C, especially the "
+    "proof at lines corresponding to its forcing construction, uses candidate "
+    "classes X_i, within-class cliques, and more than k redundant neighbors R_i "
+    "to force one chosen vertex from every class; this module uses those same "
+    "native graph objects directly.  Theorem 7 is the STEP-0 easy-result: for "
+    "fixed k>=5 it solves Dominating k-Clique by clique enumeration and matrix "
+    "multiplication, so a Track A claim would be false.  Track B measures the "
+    "gap between exact colored-clique search and the hidden cyclic-translation "
+    "invariant.  Potentials and the witness are sampled before edges.  Every "
+    "candidate in a part has identical degree, and global translation makes all "
+    "q candidates occur in planted solution orbits.  Independent baseline sets "
+    "remove the common-set greedy leak.  The panel tests degree ties, raw-equal "
+    "residues, greedy extension, random restarts, and a deliberately incomplete "
+    "checksum ansatz; the successful standard DFS is reported separately."
+)
+
+
+# Filled from script-owned runs after the module passes its internal gates.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
