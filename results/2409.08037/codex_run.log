+    for clause in inst["clauses"]:
+        key = tuple(sorted(abs(literal) - 1 for literal in clause))
+        false_bits = {abs(literal) - 1: (0 if literal > 0 else 1)
+                      for literal in clause}
+        wrong_parity = 0
