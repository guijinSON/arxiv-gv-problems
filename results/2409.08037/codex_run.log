   584	    sequence = [group_of[v] for v in variables]
   585	    candidates = []
   586	    for oriented in (sequence, list(reversed(sequence))):
   587	        for shift in range(len(oriented)):
   588	            rotated = oriented[shift:] + oriented[:shift]
   589	            candidates.append(_normalise_labels(rotated))
