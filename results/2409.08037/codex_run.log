+def _attack_outlier(inst):
+    # Choose the row with most zero coordinates in each set.
+    answer = []
+    width = len(inst["clauses"])
+    for vectors in inst["vectors"]:
+        answer.append(min(range(len(vectors)),
+                          key=lambda i: (vectors[i].bit_count(), i)))
+    return answer
