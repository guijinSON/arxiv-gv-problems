   633	
   634	def _attack_greedy(inst):
   635	    remaining = (1 << len(inst["clauses"])) - 1
   636	    answer = []
   637	    for vectors in inst["vectors"]:
   638	        chosen = min(range(len(vectors)),
   639	                     key=lambda i: ((remaining & vectors[i]).bit_count(), i))
   640	        answer.append(chosen)
   641	        remaining &= vectors[chosen]
   642	    return answer
   643	
