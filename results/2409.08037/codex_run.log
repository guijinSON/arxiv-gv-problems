   718	            if not ok and reason not in used_reasons:
   719	                duplicate = candidate
   720	                used_reasons.add(reason)
   721	                break
   722	        if duplicate is not None:
   723	            break
   724	    if duplicate is None:
   725	        duplicate = answer + [answer[0]]
   726	    corruptions["duplicate_one_element"] = duplicate
