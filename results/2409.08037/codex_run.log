+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled_params["crowding"] += 1
+    doubled = make_instance(seed=616161, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["q"] > shipping["q"]
+        and search_space(doubled) > search_space(shipping),
+        "shipping_q": shipping["q"],
+        "doubled_q": doubled["q"],
+        "shipping_space_bits": search_space(shipping).bit_length(),
+        "doubled_space_bits": search_space(doubled).bit_length(),
+        "doubled_planted_verifies": doubled_ok,
+        "answer_pairs_shipping": shipping["k"],
+        "answer_pairs_doubled": doubled["k"],
+    }
+
+    invariance_checks = 0
+    real_transform_checks = 0
+    invariant_failures = []
+    keys = []
+    # Smaller instances exercise the identical symmetry group while keeping the
+    # 20-seed canonical audit quick.
+    g8_params = {
+        "n": 31, "k": 5, "decoy_num": 1, "decoy_den": 4,
+        "crowding": 0, "force_span": 50,
+    }
+    for seed in range(20):
+        inst = make_instance(seed=120000 + seed, **g8_params)
+        key = canonical_key(inst)
+        keys.append(key)
