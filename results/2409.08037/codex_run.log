+            "random_restart_256": _attack_random_restart(
+                inst, random.Random(88000 + seed), 256
+            ),
+            "raw_checksum_difference_ansatz": (
+                _attack_raw_checksum_difference(inst)
+            ),
+        }
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(inst, candidate)[0]:
+                attack_results[name]["successes"] += 1
+    attack_wall = time.perf_counter() - attack_started
+    all_failed = all(row["successes"] == 0 for row in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed,
