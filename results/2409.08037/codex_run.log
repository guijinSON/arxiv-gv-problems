path='gen_2409_08037.py'
spec=importlib.util.spec_from_file_location('g',path); g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
required=['TRACK','PROBLEM_PROFILE','NATIVE','DIFFICULTY','SHIPPING_DIFFICULTY','STRUCTURAL_HINT','PLACEBO_HINT','CERTIFICATE_LANGUAGE','NOTES','make_instance','render','parse_answer','verify','random_candidate','search_space','enumerate_all','canonical_key','escalate','selftest']
print('missing',[x for x in required if not hasattr(g,x)])
