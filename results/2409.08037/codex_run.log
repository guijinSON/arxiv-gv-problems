+
+def _reorder_instance(inst, rng):
+    transformed = copy.deepcopy(inst)
+    rng.shuffle(transformed["parts"])
+    rng.shuffle(transformed["constraints"])
+    for row in transformed["constraints"]:
+        rng.shuffle(row["allowed"])
+    return transformed
+
+
+def _relabel_parts(inst, rng):
+    transformed = copy.deepcopy(inst)
+    old = [row["label"] for row in transformed["parts"]]
+    new = [f"Z{value}" for value in rng.sample(range(10000, 99999), len(old))]
+    rename = dict(zip(old, new))
+    for row in transformed["parts"]:
+        row["label"] = rename[row["label"]]
+    for row in transformed["constraints"]:
+        row["lo"] = rename[row["lo"]]
+        row["hi"] = rename[row["hi"]]
+    transformed["answer"] = sorted(
+        [[rename[label], residue] for label, residue in transformed["answer"]]
+    )
+    return transformed
+
+
+def _affine_relabel(inst, rng):
+    transformed = copy.deepcopy(inst)
+    q = transformed["q"]
+    multiplier = rng.randrange(1, q)
+    translations = {
+        row["label"]: rng.randrange(q) for row in transformed["parts"]
+    }
+    for row in transformed["constraints"]:
+        delta = translations[row["hi"]] - translations[row["lo"]]
+        row["allowed"] = [
+            (multiplier * value + delta) % q for value in row["allowed"]
+        ]
+        row["reference_sum"] = multiplier * row["reference_sum"] % q
+        row["allowed_sum"] = sum(row["allowed"]) % q
+    transformed["answer"] = sorted([
+        [label, (multiplier * residue + translations[label]) % q]
+        for label, residue in transformed["answer"]
+    ])
+    return transformed
+
