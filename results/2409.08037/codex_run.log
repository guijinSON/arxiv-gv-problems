   487	    equations = _extract_equations(inst)
   488	    n = inst["n"]
   489	    rows = []
   490	    for variables, rhs in equations.items():
   491	        row = 0
   492	        for variable in variables:
   493	            row |= 1 << variable
   494	        row |= rhs << n
   495	        rows.append(row)
   496	
   497	    # Four Boolean operations decode each clause's parity and four more build
   498	    # each equation bitset.  This deliberately counts preprocessing rather than
   499	    # presenting elimination alone as the full mechanical cost.
   500	    operations = 4 * len(inst["clauses"]) + 4 * len(equations)
   501	    pivot_row = 0
   502	    pivots = []
   503	    for column in range(n):
   504	        operations += max(0, len(rows) - pivot_row)  # pivot-bit inspections
   505	        found = next((r for r in range(pivot_row, len(rows))
   506	                      if (rows[r] >> column) & 1), None)
   507	        if found is None:
   508	            continue
   509	        if found != pivot_row:
   510	            rows[pivot_row], rows[found] = rows[found], rows[pivot_row]
   511	            operations += 1
   512	        for r in range(len(rows)):
   513	            operations += 1
   514	            if r != pivot_row and ((rows[r] >> column) & 1):
   515	                rows[r] ^= rows[pivot_row]
   516	                operations += n + 1  # scalar Boolean XORs represented by the bitset op
   517	        pivots.append(column)
   518	        pivot_row += 1
   519	        if pivot_row == len(rows):
   520	            break
   521	    if len(pivots) != n:
   522	        return None, operations
   523	    assignment = [0] * n
   524	    for r, column in enumerate(pivots):
   525	        assignment[column] = (rows[r] >> n) & 1
   526	    return _assignment_to_rows(inst, assignment), operations
