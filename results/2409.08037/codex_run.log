   602	def escalate(params):
   603	    p = dict(params)
   604	    # The compact recurrence costs 3n+3 bit operations, so n=97 is the final
   605	    # harder point below G9's 300-operation ceiling.  Raising block_bits at the
   606	    # same time keeps the number of output row indices from growing.
   607	    if int(p.get("n", 0)) < 97:
