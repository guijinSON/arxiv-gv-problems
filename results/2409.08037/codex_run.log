+        "reference_algorithm": {
+            "name": "exact color-ordered dominating-clique DFS",
+            "complexity": "O(k^2*q^(k-1)) worst case after translation fixing",
+            "wall_clock_sec": round(reference_wall, 6),
+            "operations": reference_probes,
