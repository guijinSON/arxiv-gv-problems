   487	def _gaussian_reference(inst):
   488	    """Generic exact linear algebra after recovering the parity quartets."""
   489	    equations = _extract_equations(inst)
   490	    n = inst["n"]
   491	    rows = []
   492	    for variables, rhs in equations.items():
   493	        row = 0
   494	        for variable in variables:
   495	            row |= 1 << variable
   496	        row |= rhs << n
   497	        rows.append(row)
   498	
   499	    operations = 0
   500	    pivot_row = 0
   501	    pivots = []
   502	    for column in range(n):
   503	        operations += max(0, len(rows) - pivot_row)  # pivot-bit inspections
   504	        found = next((r for r in range(pivot_row, len(rows))
   505	                      if (rows[r] >> column) & 1), None)
   506	        if found is None:
   507	            continue
   508	        if found != pivot_row:
   509	            rows[pivot_row], rows[found] = rows[found], rows[pivot_row]
   510	            operations += 1
   511	        for r in range(len(rows)):
   512	            operations += 1
   513	            if r != pivot_row and ((rows[r] >> column) & 1):
   514	                rows[r] ^= rows[pivot_row]
   515	                operations += n + 1  # scalar Boolean XORs represented by the bitset op
   516	        pivots.append(column)
   517	        pivot_row += 1
   518	        if pivot_row == len(rows):
   519	            break
   520	    if len(pivots) != n:
   521	        return None, operations
   522	    assignment = [0] * n
   523	    for r, column in enumerate(pivots):
   524	        assignment[column] = (rows[r] >> n) & 1
   525	    return _assignment_to_rows(inst, assignment), operations
