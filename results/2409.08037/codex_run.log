import random,time

def inst(q,k,d,seed):
 r=random.Random(seed)
 B={0}
 while len(B)<d:B.add(r.randrange(q))
 B=sorted(B)
 h=[r.randrange(q) for _ in range(k)]
 A={}
 for i in range(k):
  for j in range(i+1,k):
   c=(h[j]-h[i])%q
   A[i,j]={ (c+b)%q for b in B }
 return B,h,A

def solve(q,k,A,limit=100_000_000):
 chosen=[0]; probes=0; nodes=1
 def rec(i):
  nonlocal probes,nodes
  if i==k:return list(chosen)
  for x in range(q):
   good=True
   for j,y in enumerate(chosen):
    probes+=1
    if (x-y)%q not in A[j,i]: good=False;break
   if good:
    chosen.append(x);nodes+=1
    z=rec(i+1)
    if z:return z
    chosen.pop()
   if probes>=limit:return None
  return None
