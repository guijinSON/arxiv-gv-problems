+    },
+    "medium": {
+        "n": 173, "k": 8, "decoy_num": 1, "decoy_den": 4,
+        "crowding": 0, "force_span": 150,
+    },
+    "hard": {
+        "n": 211, "k": 8, "decoy_num": 1, "decoy_den": 4,
+        "crowding": 0, "force_span": 180,
+    },
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Each allowed cross-part difference set is a cyclic translate of a baseline "
+    "whose modular first moment is its displayed reference checksum."
+)
+PLACEBO_HINT = (
+    "Check every part label and modular residue carefully before submitting the "
