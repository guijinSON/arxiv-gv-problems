   625	def _attack_outlier(inst):
   626	    # Choose the row with most zero coordinates in each set.
   627	    answer = []
   628	    for vectors in inst["vectors"]:
   629	        answer.append(min(range(len(vectors)),
   630	                          key=lambda i: (vectors[i].bit_count(), i)))
   631	    return answer
