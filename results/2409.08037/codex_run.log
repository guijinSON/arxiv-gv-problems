+def _attack_greedy(inst):
+    remaining = (1 << len(inst["clauses"])) - 1
+    answer = []
+    for vectors in inst["vectors"]:
+        chosen = min(range(len(vectors)),
+                     key=lambda i: ((remaining & vectors[i]).bit_count(), i))
+        answer.append(chosen)
+        remaining &= vectors[chosen]
+    return answer
