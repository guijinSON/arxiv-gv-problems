+
+def _is_prime(value):
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(value):
+    candidate = max(3, int(value))
+    if candidate % 2 == 0:
+        candidate += 1
+    while not _is_prime(candidate):
+        candidate += 2
+    return candidate
+
+
+def _constraint_map(inst):
+    return {
+        frozenset((row["lo"], row["hi"])): row
+        for row in inst["constraints"]
+    }
+
+
+def _part_map(inst):
+    return {row["label"]: row for row in inst["parts"]}
+
+
+def _oriented_pair(inst, left_label, right_label):
+    parts = _part_map(inst)
+    left_force = parts[left_label]["forcing_vertices"]
+    right_force = parts[right_label]["forcing_vertices"]
+    if left_force < right_force:
+        return left_label, right_label, False
+    return right_label, left_label, True
+
+
+def _candidate_adjacent(inst, left_label, left_x, right_label, right_x):
+    if left_label == right_label:
+        return left_x != right_x
+    lo, hi, reversed_order = _oriented_pair(inst, left_label, right_label)
+    row = _constraint_map(inst).get(frozenset((lo, hi)))
+    if row is None:
+        return False
+    if reversed_order:
+        lo_x, hi_x = right_x, left_x
+    else:
+        lo_x, hi_x = left_x, right_x
+    return (hi_x - lo_x) % inst["q"] in set(row["allowed"])
+
+
+def make_instance(
+    n,
+    seed=0,
+    k=8,
+    decoy_num=1,
+    decoy_den=4,
+    crowding=0,
+    force_span=180,
+    **params,
+):
+    """Inverse-generate a dominating clique before constructing the graph."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(n, bool) or not isinstance(n, int) or n < 5:
+        raise ValueError("n must be an integer at least 5")
+    if isinstance(k, bool) or not isinstance(k, int) or not 3 <= k <= 32:
+        raise ValueError("k must be an integer in [3,32]")
+    if not all(isinstance(x, int) and not isinstance(x, bool)
+               for x in (decoy_num, decoy_den, crowding, force_span)):
+        raise ValueError("density and forcing parameters must be integers")
+    if not (0 < decoy_num < decoy_den) or crowding < 0:
+        raise ValueError("require 0 < decoy_num < decoy_den and crowding >= 0")
+    if force_span < k:
+        raise ValueError("force_span must be at least k")
+
+    q = _next_prime(n)
+    base_size = (q * decoy_num + decoy_den - 1) // decoy_den + crowding
+    base_size = min(q - 1, max(2, base_size))
+    rng = random.Random(seed)
+
+    # Labels are deliberately unrelated to the structural ordering, which is
+    # determined by the distinct forcing-group sizes.
+    label_numbers = rng.sample(range(1000, 10000), k)
+    labels = [f"P{value}" for value in label_numbers]
+    force_offsets = rng.sample(range(force_span), k)
+    parts = [
+        {
+            "label": label,
+            "forcing_vertices": k + 1 + force_offsets[index],
+        }
+        for index, label in enumerate(labels)
+    ]
+    # Guarantee distinct structural roles even when a caller supplies a tiny
+    # span equal to k.
+    assert len({row["forcing_vertices"] for row in parts}) == k
+    parts_by_force = sorted(parts, key=lambda row: row["forcing_vertices"])
+
+    potentials = {row["label"]: rng.randrange(q) for row in parts}
+    global_translate = rng.randrange(q)
+    planted_by_label = {
+        label: (potentials[label] + global_translate) % q for label in labels
+    }
+
+    constraints = []
+    for i, low_part in enumerate(parts_by_force):
+        for high_part in parts_by_force[i + 1:]:
+            lo, hi = low_part["label"], high_part["label"]
+            baseline = [0]
+            baseline.extend(rng.sample(range(1, q), base_size - 1))
+            shift = (potentials[hi] - potentials[lo]) % q
+            allowed = sorted((value + shift) % q for value in baseline)
+            constraints.append({
+                "lo": lo,
+                "hi": hi,
+                "allowed": allowed,
+                "reference_sum": sum(baseline) % q,
+                "allowed_sum": sum(allowed) % q,
+            })
+    rng.shuffle(parts)
+    rng.shuffle(constraints)
+
+    answer = sorted(
+        [[label, planted_by_label[label]] for label in labels],
+        key=lambda pair: pair[0],
+    )
+    graph_vertices = k * q + sum(row["forcing_vertices"] for row in parts)
+    graph_edges = (
+        k * q * (q - 1) // 2
+        + sum(q * len(row["allowed"]) for row in constraints)
+        + q * sum(row["forcing_vertices"] for row in parts)
+    )
+    return {
+        "family": "cyclic dominating clique",
+        "q": q,
+        "k": k,
+        "base_size": base_size,
+        "parts": parts,
+        "constraints": constraints,
+        "graph_vertices": graph_vertices,
+        "graph_edges": graph_edges,
+        "answer": answer,
+    }
+
+
+def render(inst):
+    q, k = inst["q"], inst["k"]
+    parts = sorted(inst["parts"], key=lambda row: row["label"])
+    constraints = sorted(
+        inst["constraints"],
+        key=lambda row: (
+            _part_map(inst)[row["lo"]]["forcing_vertices"],
+            _part_map(inst)[row["hi"]]["forcing_vertices"],
+        ),
+    )
+    lines = [
+        "DOMINATING CLIQUE IN A CYCLICALLY SPECIFIED GRAPH",
+        "",
+        f"The modulus is the prime q={q}.  The target size is k={k}.",
+        f"The graph has {inst['graph_vertices']} vertices and {inst['graph_edges']} edges.",
+        "All residues below are the integers 0,...,q-1, with arithmetic modulo q.",
+        "",
+        "Candidate vertices and forcing vertices:",
+        "For every displayed part label L there are q candidate vertices (L,x),",
+        "one for each residue x, and the stated number f_L of forcing vertices",
+        "r(L,0),...,r(L,f_L-1). Candidate vertices in the same part form a",
+        "clique. Every forcing vertex r(L,t) is adjacent to every candidate",
+        "(L,x), and to no other vertex. There are no other within-part edges.",
+        "",
+        "Parts (input order is irrelevant):",
+    ]
+    for row in parts:
+        lines.append(
+            f"  {row['label']}: forcing_vertices={row['forcing_vertices']}"
+        )
+    lines.extend([
+        "",
+        "Cross-part edges:",
+        "Each row is oriented lo -> hi. A candidate (lo,a) is adjacent to",
+        "(hi,b) exactly when (b-a) mod q belongs to that row's allowed set.",
+        "The row also carries two exact audit checksums modulo q. They are",
+        "auxiliary input data; the graph itself is defined only by allowed.",
+    ])
+    for row in constraints:
+        allowed = ",".join(str(value) for value in row["allowed"])
+        lines.append(
+            f"  {row['lo']} -> {row['hi']}: allowed=[{allowed}]; "
+            f"reference_sum={row['reference_sum']}; "
+            f"allowed_sum={row['allowed_sum']}"
+        )
+    lines.extend([
+        "",
+        "A set S dominates the graph when every vertex is either in S or adjacent",
+        "to a vertex of S. Find exactly k candidate vertices that are pairwise",
+        "adjacent and dominate every graph vertex. Because every forcing group has",
+        "more than k vertices and has neighbors only in its own candidate part, any",
+        "valid answer necessarily contains exactly one candidate from every part.",
+        "",
+        "Output a JSON array of exactly k [part_label,residue] pairs, one per part,",
+        "sorted lexicographically by part_label. Repeats are forbidden; residues",
+        "are inclusive from 0 through q-1. The order within each pair is label first.",
+        "",
+        "Give your final answer inside <answer></answer> tags in that exact JSON format.",
+        'Example syntax: <answer>[["P1234",0],["P5678",4]]</answer>',
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def _looks_like_answer(value):
+    return (
+        isinstance(value, list)
+        and all(
+            isinstance(pair, list)
+            and len(pair) == 2
+            and isinstance(pair[0], str)
+            and isinstance(pair[1], int)
+            and not isinstance(pair[1], bool)
+            for pair in value
+        )
+    )
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    bodies = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    fenced = re.findall(r"```(?:json)?\s*(.*?)```", text, re.I | re.S)
+    candidates = bodies + fenced
+    decoder = json.JSONDecoder()
+    # Also tolerate a bare JSON array surrounded by ordinary prose.
+    for match in re.finditer(r"\[", text):
+        try:
+            value, _ = decoder.raw_decode(text[match.start():])
+            if _looks_like_answer(value):
+                return value
+        except (ValueError, TypeError):
+            pass
+    for body in candidates:
+        try:
+            value = json.loads(body.strip())
+        except (ValueError, TypeError):
+            continue
+        if _looks_like_answer(value):
+            return value
+    return None
+
+
+def verify(inst, answer):
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    k, q = inst["k"], inst["q"]
+    if len(answer) != k:
+        return False, f"wrong length: expected {k} vertices"
+    normalized = []
+    for index, pair in enumerate(answer):
+        if not isinstance(pair, list) or len(pair) != 2:
+            return False, f"entry {index} must be [part_label,residue]"
+        label, residue = pair
+        if not isinstance(label, str):
+            return False, f"entry {index} has a non-string part label"
+        if isinstance(residue, bool) or not isinstance(residue, int):
+            return False, f"entry {index} has a non-integer residue"
+        normalized.append((label, residue))
+    if len(set(normalized)) != k:
+        return False, "duplicate vertex"
+    labels = [label for label, _ in normalized]
+    if len(set(labels)) != k:
+        return False, "duplicate candidate part"
+    part_labels = set(_part_map(inst))
+    unknown = [label for label in labels if label not in part_labels]
+    if unknown:
+        return False, f"unknown part label: {unknown[0]}"
+    for label, residue in normalized:
+        if not 0 <= residue < q:
+            return False, f"residue out of range in part {label}"
+    if labels != sorted(labels):
+        return False, "vertices must be sorted by part label"
+    if set(labels) != part_labels:
+        return False, "answer must contain exactly one vertex from every part"
+
+    for i, (left_label, left_x) in enumerate(normalized):
+        for right_label, right_x in normalized[i + 1:]:
+            if not _candidate_adjacent(
+                inst, left_label, left_x, right_label, right_x
+            ):
+                return False, (
+                    "not a clique: nonedge between "
+                    f"({left_label},{left_x}) and ({right_label},{right_x})"
+                )
+
+    # Exact closed-neighborhood verification over the compressed vertex classes.
+    # Every candidate part has a selected member; its within-part clique covers all
+    # other candidates and the selected member covers itself.  Every forcing group
+    # is adjacent to that same selected candidate.  We still inspect every class
+    # and its declared cardinality instead of trusting generation provenance.
+    chosen = dict(normalized)
+    for part in inst["parts"]:
+        label = part["label"]
+        if label not in chosen:
+            return False, f"candidate part {label} is not dominated"
+        if part["forcing_vertices"] <= k:
+            return False, f"malformed forcing group for part {label}"
+        if not 0 <= chosen[label] < q:
+            return False, f"candidate part {label} is not dominated"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    return sorted(
+        [[row["label"], rng.randrange(inst["q"])] for row in inst["parts"]],
+        key=lambda pair: pair[0],
+    )
+
+
+def search_space(inst):
+    return inst["q"] ** inst["k"]
+
+
+def _valid_residue_tuple(inst, ordered_parts, residues, maps=None):
+    maps = maps or _constraint_map(inst)
+    for i, left in enumerate(ordered_parts):
+        for j in range(i + 1, len(ordered_parts)):
+            right = ordered_parts[j]
+            row = maps[frozenset((left["label"], right["label"]))]
+            if (residues[j] - residues[i]) % inst["q"] not in set(row["allowed"]):
+                return False
+    return True
+
+
+def enumerate_all(inst):
+    q, k = inst["q"], inst["k"]
+    # Difference-defined edges have a global translation automorphism.  Fixing
+    # the first residue to zero divides the exact enumeration by q.
+    reduced_space = q ** (k - 1)
+    if reduced_space > 2_000_000:
+        return None
+    parts = sorted(inst["parts"], key=lambda row: row["forcing_vertices"])
+    maps = _constraint_map(inst)
+    count = 0
+    for tail in itertools.product(range(q), repeat=k - 1):
+        if _valid_residue_tuple(inst, parts, (0,) + tail, maps):
+            count += 1
+    return q * count
+
+
+def _difference_histogram(values, q):
+    present = set(values)
+    return tuple(
+        sum(1 for value in present if (value + delta) % q in present)
+        for delta in range(q)
+    )
+
+
+def canonical_key(inst):
+    """Strong cheap invariant under represented graph relabellings.
+
+    It uses cross-part difference autocorrelations, which discard independent
+    cyclic translations of every candidate part.  Minimizing their joint orbit
+    under multiplication by every nonzero residue also discards global affine
+    rescaling.  Structural forcing sizes order the otherwise renamed parts.
+    """
+    q = inst["q"]
+    parts = _part_map(inst)
+    ordered_constraints = sorted(
+        inst["constraints"],
+        key=lambda row: (
+            parts[row["lo"]]["forcing_vertices"],
+            parts[row["hi"]]["forcing_vertices"],
+        ),
+    )
+    histograms = [
+        _difference_histogram(row["allowed"], q)
+        for row in ordered_constraints
+    ]
+    best = None
+    for multiplier in range(1, q):
+        candidate = tuple(
+            value
+            for hist in histograms
+            for residue in range(q)
+            for value in (hist[(multiplier * residue) % q],)
+        )
+        if best is None or candidate < best:
+            best = candidate
+    payload = {
+        "q": q,
+        "k": inst["k"],
+        "forcing": sorted(row["forcing_vertices"] for row in inst["parts"]),
+        "difference_autocorrelations": best,
+    }
+    raw = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params):
+    current = dict(params)
+    current.pop("_preset", None)
+    if "n" not in current:
+        return None
+    if current["n"] >= 1800:
+        return None
+    # Both changes grow the haystack while k, hence witness length, stays fixed:
+    # more residues and one more regular decoy difference per cross-part row.
+    current["n"] = int(math.ceil(current["n"] * 1.38))
+    current["crowding"] = int(current.get("crowding", 0)) + 1
+    current["force_span"] = int(current.get("force_span", 4 * current["k"])) + 17
+    return current
+
+
+def _mod_inverse_counted(value, modulus):
+    old_r, r = value % modulus, modulus
+    old_s, s = 1, 0
+    divisions = 0
+    while r:
+        quotient = old_r // r
+        old_r, r = r, old_r - quotient * r
+        old_s, s = s, old_s - quotient * s
+        divisions += 1
+    if old_r != 1:
+        raise ValueError("noninvertible value")
+    return old_s % modulus, divisions
+
+
+def _compact_solve(inst):
+    parts = sorted(inst["parts"], key=lambda row: row["forcing_vertices"])
+    anchor = parts[0]["label"]
+    q, d = inst["q"], inst["base_size"]
+    inverse, divisions = _mod_inverse_counted(d, q)
+    rows = _constraint_map(inst)
+    residues = {anchor: 0}
+    operations = divisions
+    for part in parts[1:]:
+        row = rows[frozenset((anchor, part["label"]))]
+        # The anchor has the least forcing count and is row["lo"].
+        residues[part["label"]] = (
+            (row["allowed_sum"] - row["reference_sum"]) * inverse
+        ) % q
+        operations += 3
+    answer = sorted([[label, value] for label, value in residues.items()])
+    operations += 2 * inst["k"] + inst["k"] * (inst["k"] - 1) // 2
+    return answer, operations
+
+
+def _reference_solve(inst):
+    """Exact color-ordered clique DFS; returns witness and measured work."""
+    parts = sorted(inst["parts"], key=lambda row: row["forcing_vertices"])
+    q = inst["q"]
+    maps = _constraint_map(inst)
+    allowed = {key: set(row["allowed"]) for key, row in maps.items()}
+    chosen = [0]  # Global translation symmetry permits this normalization.
+    nodes = 1
+    probes = 0
+    residue_trials = 0
+
+    def visit(depth):
+        nonlocal nodes, probes, residue_trials
+        if depth == len(parts):
+            return list(chosen)
+        current = parts[depth]
+        for residue in range(q):
+            residue_trials += 1
+            good = True
+            for earlier_index, earlier_residue in enumerate(chosen):
+                earlier = parts[earlier_index]
+                row = maps[frozenset((earlier["label"], current["label"]))]
+                probes += 1
+                if (residue - earlier_residue) % q not in allowed[
+                    frozenset((earlier["label"], current["label"]))
+                ]:
+                    good = False
+                    break
+            if good:
+                chosen.append(residue)
+                nodes += 1
+                result = visit(depth + 1)
+                if result is not None:
+                    return result
+                chosen.pop()
+        return None
+
+    started = time.perf_counter()
+    residues = visit(1)
+    elapsed = time.perf_counter() - started
+    if residues is None:
+        return None, {
+            "nodes": nodes, "edge_probes": probes,
+            "residue_trials": residue_trials, "wall_clock_sec": elapsed,
+        }
+    answer = sorted(
+        [[part["label"], residue] for part, residue in zip(parts, residues)]
+    )
+    return answer, {
+        "nodes": nodes,
+        "edge_probes": probes,
+        "residue_trials": residue_trials,
+        "wall_clock_sec": elapsed,
+    }
+
+
+def _attack_outlier_degree(inst):
+    # Every residue in a fixed part has exactly the same degree, so the attack's
+    # deterministic tie-break is residue zero.
+    return sorted([[part["label"], 0] for part in inst["parts"]])
+
+
+def _attack_greedy(inst):
+    parts = sorted(inst["parts"], key=lambda row: row["forcing_vertices"])
+    maps = _constraint_map(inst)
+    allowed = {key: set(row["allowed"]) for key, row in maps.items()}
+    chosen = [0]
+    for depth in range(1, len(parts)):
+        current = parts[depth]
+        for residue in range(inst["q"]):
+            if all(
+                (residue - chosen[index]) % inst["q"] in allowed[
+                    frozenset((parts[index]["label"], current["label"]))
+                ]
+                for index in range(depth)
+            ):
+                chosen.append(residue)
+                break
+        else:
+            return None
+    return sorted(
+        [[part["label"], residue] for part, residue in zip(parts, chosen)]
+    )
+
+
+def _attack_raw_checksum_difference(inst):
+    parts = sorted(inst["parts"], key=lambda row: row["forcing_vertices"])
+    anchor = parts[0]["label"]
+    rows = _constraint_map(inst)
+    residues = {anchor: 0}
+    for part in parts[1:]:
+        row = rows[frozenset((anchor, part["label"]))]
+        # Deliberately omits division by the set cardinality.
+        residues[part["label"]] = (
+            row["allowed_sum"] - row["reference_sum"]
+        ) % inst["q"]
+    return sorted([[label, value] for label, value in residues.items()])
+
+
+def _attack_random_restart(inst, rng, restarts=256):
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate
+    return None
+
+
+def _reorder_instance(inst, rng):
+    transformed = copy.deepcopy(inst)
+    rng.shuffle(transformed["parts"])
+    rng.shuffle(transformed["constraints"])
+    for row in transformed["constraints"]:
+        rng.shuffle(row["allowed"])
+    return transformed
+
+
+def _relabel_parts(inst, rng):
+    transformed = copy.deepcopy(inst)
+    old = [row["label"] for row in transformed["parts"]]
+    new = [f"Z{value}" for value in rng.sample(range(10000, 99999), len(old))]
+    rename = dict(zip(old, new))
+    for row in transformed["parts"]:
+        row["label"] = rename[row["label"]]
+    for row in transformed["constraints"]:
+        row["lo"] = rename[row["lo"]]
+        row["hi"] = rename[row["hi"]]
+    transformed["answer"] = sorted(
+        [[rename[label], residue] for label, residue in transformed["answer"]]
+    )
+    return transformed
+
+
+def _affine_relabel(inst, rng):
+    transformed = copy.deepcopy(inst)
+    q = transformed["q"]
+    multiplier = rng.randrange(1, q)
+    translations = {
+        row["label"]: rng.randrange(q) for row in transformed["parts"]
+    }
+    for row in transformed["constraints"]:
+        delta = translations[row["hi"]] - translations[row["lo"]]
+        row["allowed"] = [
+            (multiplier * value + delta) % q for value in row["allowed"]
+        ]
+        row["reference_sum"] = multiplier * row["reference_sum"] % q
+        row["allowed_sum"] = sum(row["allowed"]) % q
+    transformed["answer"] = sorted([
+        [label, (multiplier * residue + translations[label]) % q]
+        for label, residue in transformed["answer"]
+    ])
+    return transformed
+
+
+def _atomic_elements(value):
+    if isinstance(value, dict):
+        return sum(_atomic_elements(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_atomic_elements(item) for item in value)
+    return 1
+
