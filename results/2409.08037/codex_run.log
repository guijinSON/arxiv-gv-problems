+    )
+    attack_results = {
+        name: {"successes": 0, "attempts": 8} for name in attack_names
+    }
+    attack_started = time.perf_counter()
+    for seed in range(8):
+        inst = make_instance(seed=73000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        candidates = {
+            "outlier_degree_tie_break": _attack_outlier_degree(inst),
