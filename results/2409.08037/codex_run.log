   577	def canonical_key(inst):
   578	    """Canonicalise row/group/coordinate order and the tight-cycle dihedral action."""
   579	    variables, _ = _ordered_cycle_data(inst)
   580	    group_of = {}
   581	    for gi, group in enumerate(inst["groups"]):
