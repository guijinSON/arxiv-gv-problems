   528	
   529	def _compact_cycle_reference(inst):
   530	    """Solve the tight cycle using one recurrence, not generic elimination.
   531	
   532	    Once the parity-quartet invariant has been recognized, one representative
   533	    clause fixes each right-hand side: it is the parity of the clause's three
   534	    positive-sign bits, requiring two XORs.  The operation counter includes
   535	    those 2n XORs as well as the recurrence and homogeneous correction.
   536	    """
   537	    variables, rhs = _ordered_cycle_data(inst)
   538	    n = len(variables)
   539	    # Particular solution with y_0=y_1=0 for all non-wrapping equations.
   540	    y = [0, 0]
   541	    operations = 2 * n
   542	    for i in range(n - 2):
   543	        y.append(rhs[i] ^ y[i] ^ y[i + 1])
   544	        operations += 2
   545	
   546	    wrap1 = rhs[n - 2] ^ y[n - 2] ^ y[n - 1] ^ y[0]
   547	    wrap2 = rhs[n - 1] ^ y[n - 1] ^ y[0] ^ y[1]
   548	    operations += 6
   549	    if n % 3 == 2:
   550	        b = wrap1
   551	        a = wrap2
   552	        c = a ^ b
   553	    elif n % 3 == 1:
   554	        c = wrap1
   555	        b = wrap2
   556	        a = c ^ b
   557	    else:
   558	        return None, operations
   559	    operations += 1
   560	
   561	    homogeneous = (a, b, c)
   562	    cycle_bits = []
   563	    for i, particular in enumerate(y):
   564	        cycle_bits.append(particular ^ homogeneous[i % 3])
   565	        operations += 1
   566	    assignment = [0] * n
   567	    for variable, bit in zip(variables, cycle_bits):
   568	        assignment[variable] = bit
   569	    return _assignment_to_rows(inst, assignment), operations
   570	
   571	
   572	def _normalise_labels(sequence):
   573	    mapping = {}
   574	    next_label = 0
   575	    out = []
   576	    for item in sequence:
   577	        if item not in mapping:
   578	            mapping[item] = next_label
   579	            next_label += 1
   580	        out.append(mapping[item])
   581	    return tuple(out)
   582	
