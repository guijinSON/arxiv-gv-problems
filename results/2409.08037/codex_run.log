   609	def escalate(params):
   610	    p = dict(params)
   611	    # Including RHS decoding, the compact route costs 5n+3 bit operations.
   612	    # The named ladder grows n while raising block_bits so the witness remains
   613	    # about twelve indices long.  n=59 is the last supported point below G9's
   614	    # 300-operation no-tool ceiling.
   615	    n = int(p.get("n", 0))
   616	    for next_n, next_block_bits in ((23, 2), (41, 4), (59, 5)):
   617	        if n < next_n:
   618	            p["n"] = next_n
   619	            p["block_bits"] = next_block_bits
   620	            p["copies"] = 1
   621	            return p
   622	    return "cap_bound"
