+
+def _matmul(
+    left: list[list[int]], right: list[list[int]], field: _Field
+) -> list[list[int]]:
+    rows = len(left)
+    middle = len(right)
+    cols = len(right[0])
+    out = [[0] * cols for _ in range(rows)]
+    mul = field.mul
+    for i in range(rows):
+        target = out[i]
+        for t in range(middle):
+            scalar = left[i][t]
+            if scalar:
+                source = right[t]
+                products = mul[scalar]
