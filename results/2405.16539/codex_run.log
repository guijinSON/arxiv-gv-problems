+_ENUMERATION_CAP = 50_000
+_GUESS_SAMPLES = 200_000
+_ATTACK_SEEDS = tuple(range(81_000, 81_008))
+_G9_ARMS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
