+def _random_invertible(size: int, rng: random.Random, field: _Field) -> list[list[int]]:
+    while True:
+        matrix = [[rng.randrange(field.q) for _ in range(size)] for _ in range(size)]
+        if _matrix_rank(matrix, field) == size:
+            return matrix
