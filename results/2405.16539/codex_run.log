+def _prime_divisors(value: int) -> list[int]:
+    out = []
+    p = 2
+    n = value
+    while p * p <= n:
+        if n % p == 0:
+            out.append(p)
+            while n % p == 0:
+                n //= p
+        p += 1
+    if n > 1:
+        out.append(n)
+    return out
+
