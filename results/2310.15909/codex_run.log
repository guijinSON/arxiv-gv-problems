+def _attack_degree_order(inst: dict) -> object:
+    degree = [0] * inst["n"]
+    for edge in inst["edges"]:
+        for v in edge:
+            degree[v] += 1
+    order = sorted(range(inst["n"]), key=lambda v: (degree[v], v))
+    return _partition_from_order(inst, order)
