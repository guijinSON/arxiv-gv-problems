+        if key not in {"residue_of_vertex", "center_vertex", "companion_vertex",
+                       "edges", "answer"}
+    }
+    out.update({
+        "residue_of_vertex": residues,
+        "center_vertex": old_to_new[inst["center_vertex"]],
+        "companion_vertex": old_to_new[inst["companion_vertex"]],
+        "edges": edges,
+        "answer": answer,
+    })
+    return out, answer
 
 
