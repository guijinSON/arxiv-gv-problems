+# Replaced with script-owned evidence after the three hardening runs.  Zero
+# attempts cannot accidentally masquerade as a successful oracle gate.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
