+            if candidate is not None and verify(attacked, candidate)[0]:
+                attacks[name]["successes"] += 1
+    all_failed = all(
+        result["successes"] == 0 and result["attempts"] >= 8
+        for result in attacks.values()
+    )
+    report["G6_adversary_panel"] = {
+        "pass": all_failed,
+        "attacks": attacks,
+        "domain_standard_attack": "projective_embedding_dpll_50000",
+        "dpll_nodes": dpll_nodes,
+        "dpll_constraint_checks": dpll_checks,
+        "dpll_wall_clock_sec": [round(value, 6) for value in dpll_seconds],
+    }
+
+    scale_params = escalate(ship_params)
