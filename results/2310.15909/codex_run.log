+def _pow_counted(base: int, exponent: int, modulus: int) -> tuple[int, int]:
+    result = 1
+    operations = 0
+    while exponent:
+        if exponent & 1:
+            result = (result * base) % modulus
+            operations += 1
+        exponent >>= 1
+        if exponent:
+            base = (base * base) % modulus
+            operations += 1
+    return result, operations
 
 
