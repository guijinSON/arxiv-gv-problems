import importlib.util, time
spec=importlib.util.spec_from_file_location('g','gen_2310_15909.py'); g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
inst=g.make_instance(seed=0, **g.DIFFICULTY['hard'])
n=inst['n']; edges=[tuple(e) for e in inst['edges']]; inc=[[] for _ in range(n)]
for ei,e in enumerate(edges):
    for v in e: inc[v].append(ei)
target=inst['part_sizes']; nodes=0; deadline=time.perf_counter()+20

def solve(dom):
    global nodes
    nodes += 1
    if nodes % 1000 == 0 and time.perf_counter()>deadline: raise TimeoutError
    # fixed point GAC + global cardinality
    while True:
        changed=False
        counts=[sum(d==(1<<c) for d in dom) for c in range(4)]
        poss=[sum(bool(d&(1<<c)) for d in dom) for c in range(4)]
        for c in range(4):
            if counts[c] > target[c] or poss[c] < target[c]: return None
            if counts[c] == target[c]:
                bit=1<<c
                for v,d in enumerate(dom):
                    if d"'!=bit and d&bit:
                        nd=d&~bit
                        if not nd:return None
                        dom[v]=nd; changed=True
            elif poss[c] == target[c]:
                bit=1<<c
                for v,d in enumerate(dom):
                    if d&bit and d!=bit: dom[v]=bit; changed=True
        for a,b,c in edges:
            vs=(a,b,c)
            ds=(dom[a],dom[b],dom[c])
            for j,v in enumerate(vs):
                d=ds[j]; nd=0
                others=[k for k in range(3) if k!=j]
                for cv in range(4):
                    if not d&(1<<cv): continue
                    supported=False
                    for c1 in range(4):
                        if not ds[others[0]]&(1<<c1): continue
                        for c2 in range(4):
                            if ds[others[1]]&(1<<c2):
                                cc=[None,None,None]; cc[j]=cv; cc[others[0]]=c1; cc[others[1]]=c2
                                if g._allowed_pattern(cc): supported=True; break
                        if supported: break
