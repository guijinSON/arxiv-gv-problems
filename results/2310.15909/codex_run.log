+    if not 1 <= scale < p:
+        raise ValueError("scale must be nonzero modulo p")
+    out = dict(inst)
+    out["residue_of_vertex"] = [
+        (scale * residue + shift) % p for residue in inst["residue_of_vertex"]
+    ]
+    return out
 
 
