def _is_prime(value: int) -> bool:
    if value < 2:
        return False
    if value % 2 == 0:
        return value == 2
    limit = math.isqrt(value)
    return all(value % divisor for divisor in range(3, limit + 1, 2))


def _validate_params(n: int, q: int, blocks: int) -> None:
    for name, value in (("n", n), ("q", q), ("blocks", blocks)):
        if isinstance(value, bool) or not isinstance(value, int):
            raise ValueError(f"{name} must be an integer")
    if not _is_prime(q) or q < 5 or q % 3 != 2:
        raise ValueError("q must be a prime at least 5 with q congruent to 2 mod 3")
    if q > CERTIFICATE_LANGUAGE["bounds"]["max_modulus"]:
        raise ValueError("q exceeds the certificate-language modulus bound")
    if not 1 <= blocks <= CERTIFICATE_LANGUAGE["bounds"]["max_polynomials"]:
        raise ValueError("blocks must be in 1..4")
    if n < blocks * q + 2:
        raise ValueError("n must leave two anchors and q active curves per block")


def _poly_from_parameters(a: int, shift: int, offset: int, q: int) -> list:
    """Canonical JSON polynomial for a*(x+shift)^3+offset over F_q."""
    coefficients = [
        (a * pow(shift, 3, q) + offset) % q,
        (3 * a * shift * shift) % q,
        (3 * a * shift) % q,
        a % q,
    ]
    return [[coefficient, [degree]]
            for degree, coefficient in enumerate(coefficients)]


def _coefficients(poly: list) -> list[int]:
    return [term[0] for term in poly]


def _poly_eval(poly: list, x: int, q: int) -> int:
    c0, c1, c2, c3 = _coefficients(poly)
    return (c0 + x * (c1 + x * (c2 + x * c3))) % q


def make_instance(n: int, seed: int = 0, q: int = 29,
                  blocks: int = 4) -> dict:
    """Build a shortest flip interval and its polynomial certificate first."""
    _validate_params(n, q, blocks)
    rng = random.Random(seed)

    ground_order = list(range(n))
    rng.shuffle(ground_order)
    anchor_a, anchor_b = ground_order[:2]
    move_count = q * blocks
    active = ground_order[2:2 + move_count]


