+def _partition_from_order(inst: dict, ordered_free: list[int]) -> list[list[int]]:
+    n = inst["n"]
+    s = (n - 1) // 4
+    anchors = {inst["center_vertex"], inst["companion_vertex"]}
+    seen = set(anchors)
