+        "candidate_prior": "uniform over all n! host-vertex permutations",
+        "search_space": search_space(inst),
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    baseline_start = time.perf_counter()
+    baseline_answer, baseline_stats = _attack_dpll(inst, 50_000)
+    baseline_wall = time.perf_counter() - baseline_start
+    baseline_solved = bool(
+        baseline_answer is not None and verify(inst, baseline_answer)[0]
