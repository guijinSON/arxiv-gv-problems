+        relabel = list(range(original["n"]))
+        transform_rng.shuffle(relabel)
+        transformed = _transform_instance(original, relabel)
+        assert canonical_key(transformed) == original_key
+        invariant_trials += 1
+        ok, reason = verify(transformed, transformed["answer"])
+        assert ok, reason
+        carried_trials += 1
+
+        reordered = _transform_instance(original, list(range(original["n"])), True)
+        assert canonical_key(reordered) == original_key
+        invariant_trials += 1
+        ok, reason = verify(reordered, original["answer"])
+        assert ok, reason
+        carried_trials += 1
+
+        second = list(range(original["n"]))
+        transform_rng.shuffle(second)
+        composed_map = [second[relabel[old]] for old in range(original["n"])]
+        composed = _transform_instance(original, composed_map, True)
+        assert canonical_key(composed) == original_key
+        invariant_trials += 1
+        ok, reason = verify(composed, composed["answer"])
+        assert ok, reason
+        carried_trials += 1
+    distinct_keys = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": distinct_keys == 20,
+        "invariant_relabellings": invariant_trials,
+        "valid_carried_witnesses": carried_trials,
+        "distinct_unrelated": distinct_keys,
+        "unrelated_attempts": 20,
+        "transformations": [
+            "arbitrary host-vertex relabelling",
+            "arbitrary forbidden-triple input reordering",
+            "composition of relabelling and input reordering",
+        ],
+        "key_kind": (
