+    n = int(params.get("n", 0))
+    edge_factor = int(params.get("edge_factor", 8))
+    for candidate in (37, 109, 229):
+        if candidate > n:
+            return {"n": candidate, "edge_factor": edge_factor}
+    # The next admissible prime is 277; its partition has 277 atomic elements.
+    return "cap_bound"
 
 
