@@ -0,0 +1,992 @@
+"""Verified dense Steiner-system embedding generator for arXiv:2310.15909.
+
+The paper studies Steiner triple systems contained in dense 3-uniform
+hypergraphs.  This module samples a relabelled projective binary Steiner triple
+system first, then builds a dense host around it by adding balanced forbidden
+parallel classes that never delete a planted block.  The answer is the vertex
+permutation carrying the fixed projective system into the host.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import Counter
+
+
+TRACK: str = "A"
+
+STRUCTURAL_HINT: str = (
+    "The required blocks are the zero-sum triples of a binary vector space, "
+    "whose incidence is invariant under every invertible binary change of basis."
+)
+PLACEBO_HINT: str = (
+    "The required blocks contain many repeated vertex labels, so careful "
+    "bookkeeping is important when writing the final vertex permutation."
+)
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "dense 3-uniform hypergraph",
+        "projective binary Steiner triple system",
+        "vertex relabelling permutation",
+    ],
+    "verification_operations": [
+        "expand binary zero-sum triples by XOR",
+        "exact hyperedge membership lookup",
+        "exact pair-incidence counting",
+        "permutation range and uniqueness checks",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "Use the GL(m,2) symmetry of the projective Steiner system to normalize "
+        "the embedding search; without it the solver faces an unstructured "
+        "permutation CSP with hundreds of coupled triple constraints."
+    ),
+    "hardness_basis": (
+        "Track A: Corollary 1.9 gives the dense minimum-codegree regime; shipping "
+        "uses n=63 and delta_2(H)>=57>((3+sqrt(57))/12+0.02)n, while the generated "
+        "distribution has no known efficient exact embedding method and the "
+        "measured symmetry-normalized DPLL baseline exhausts 50000 search nodes "
+        "on every adversary seed (wall-clock and constraint checks are in G5)."
+    ),
+    "max_answer_tokens": 45,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 7, "rounds": 0, "pair_cap": 0},
+    "easy": {"n": 15, "rounds": 12, "pair_cap": 3},
+    "medium": {"n": 31, "rounds": 48, "pair_cap": 5},
+    "hard": {"n": 63, "rounds": 90, "pair_cap": 4},
+}
+
+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON array containing each host vertex 0,...,n-1 exactly once; entry "
+        "x-1 is the image of nonzero binary vector x, for x=1,...,n."
+    ),
+    "bounds": {
+        "max_atomic_elements": 255,
+        "max_vertex_exclusive": 255,
+        "distinct": True,
+        "ordered": True,
+    },
+}
+
+NOTES: str = r"""
+Step 0 and paper grounding. Section 1.1 defines an STS as an (n,3,2,1)
+design: every pair occurs in exactly one triple, and n is 1 or 3 modulo 6.
+Question 1.1 asks for an STS contained in a 3-uniform host. Theorem 1.2 and
+Corollary 1.9 prove existence above ((3+sqrt(57))/12+epsilon)n minimum
+codegree for sufficiently large admissible n. Section 1.4 and the proof in
+Section 6 show what produces the paper's existential witness: fractional
+matchings, a pseudorandom hypergraph matching theorem, iterative cover-down,
+and absorbers. This is not a short explicit formula or a polynomial-time
+certificate extraction algorithm. Proposition 1.7 identifies the 3n/4
+parity obstruction below the conjectured threshold. The paper gives no FPT or
+polynomial exact STS-search algorithm.
+
+Generation and certificate. The generator samples a random vertex permutation
+first. The fixed blocks {x,y,x XOR y} on the nonzero vectors of F_2^m form a
+Steiner triple system, and their images are the certificate. Forbidden triples
+are subsequently sampled as vertex-balanced parallel classes, subject to a
+per-pair cap and never selecting a planted block. Thus generation never solves
+the produced embedding instance. The cap gives delta_2(H)>=n-2-pair_cap;
+at shipping this is 57, which lies above the paper's displayed 0.879...+0.02
+coefficient (the theorem's unknown finite n0 is not claimed for n=63; the
+plant itself proves existence at every generated size).
+
+Hardness triage. An unrestricted explicit STS witness is quadratic in n and
+violates the answer cap at useful sizes. Dense hosts also contain many
+unstructured STSs, so the module asks for a relabelled projective STS and uses
+its n-entry permutation as an exact encoding. The standard attack is a
+subhypergraph-isomorphism/permutation-CSP DPLL: it fixes two images using the
+GL(m,2) automorphism group, chooses the template point with most completed
+constraints, and propagates forbidden triples. The measured bounded run is
+reported rather than hidden. Vertex degree, greedy, random-restart, spectral,
+and this domain-standard DPLL attack are all tested. The planted and forbidden
+objects are vertex-balanced; hardness comes from the number of coupled block
+constraints, not a degree or position outlier.
+"""
+
+
+# Replaced only from transcripts written by scripts/harden.py.
+G9_ORACLE_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 3},
+        "hinted": {"solved": 0, "attempts": 3},
+        "placebo": {"solved": 0, "attempts": 3},
+    },
+    "hinted_verdict": "hardened",
+}
+
+
+def _valid_order(n: int) -> bool:
+    """The supported orders are 2^m-1 with m>=3."""
+    return n >= 7 and ((n + 1) & n) == 0
+
+
+def _template_triples(n: int):
+    """The projective binary STS, with public point indices 0,...,n-1."""
+    triples = []
+    for x in range(1, n + 1):
+        for y in range(x + 1, n + 1):
+            z = x ^ y
+            if y < z <= n:
+                triples.append((x - 1, y - 1, z - 1))
+    return triples
+
+
+def _mapped_blocks(n: int, permutation):
+    for x, y, z in _template_triples(n):
+        yield tuple(sorted((permutation[x], permutation[y], permutation[z])))
+
+
+def _sample_parallel_class(
+    n: int,
+    rng: random.Random,
+    protected,
+    forbidden,
+    pair_counts,
+    pair_cap: int,
+    participation,
+):
+    """Sample one disjoint triple matching without touching protected blocks."""
+
+    def valid(a, b, c):
+        triple = tuple(sorted((a, b, c)))
+        if triple in protected or triple in forbidden:
+            return False
+        return all(
+            pair_counts[u][v] < pair_cap
+            for u, v in ((a, b), (a, c), (b, c))
+        )
+
+    for _restart in range(200):
+        available = list(range(n))
+        if n % 3 == 1:
+            maximum = max(participation[v] for v in available)
+            leave_choices = [v for v in available if participation[v] == maximum]
+            leftover = rng.choice(leave_choices)
+            available.remove(leftover)
+        rng.shuffle(available)
+
+        def extend(vertices):
+            if not vertices:
+                return []
+            a = vertices[0]
+            rest = vertices[1:]
+            candidates = list(itertools.combinations(rest, 2))
+            rng.shuffle(candidates)
+            # Constraints are deliberately sparse; a bounded randomized branch
+            # list avoids pathological work while retaining deterministic output.
+            for b, c in candidates[: min(160, len(candidates))]:
+                if not valid(a, b, c):
+                    continue
+                removed = {b, c}
+                tail = [v for v in rest if v not in removed]
+                suffix = extend(tail)
+                if suffix is not None:
+                    return [tuple(sorted((a, b, c)))] + suffix
+            return None
+
+        result = extend(available)
+        if result is not None:
+            return result
+    raise RuntimeError("could not construct a balanced forbidden parallel class")
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate a dense host around a known projective STS embedding."""
+    rounds = params.pop("rounds", None)
+    pair_cap = params.pop("pair_cap", None)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(n, bool) or not isinstance(n, int) or not _valid_order(n):
+        raise ValueError("n must equal 2^m-1 for an integer m>=3")
+    if rounds is None:
+        rounds = max(1, (3 * n) // 2)
+    if pair_cap is None:
+        pair_cap = max(1, math.ceil(2 * rounds / (n - 1)) + 2)
+    if (
+        isinstance(rounds, bool)
+        or not isinstance(rounds, int)
+        or rounds < 0
+        or isinstance(pair_cap, bool)
+        or not isinstance(pair_cap, int)
+        or pair_cap < 0
+    ):
+        raise ValueError("rounds and pair_cap must be nonnegative integers")
+    if rounds and pair_cap == 0:
+        raise ValueError("positive rounds require positive pair_cap")
+
+    rng = random.Random(seed)
+    answer = list(range(n))
+    rng.shuffle(answer)
+    planted = set(_mapped_blocks(n, answer))
+
+    forbidden = set()
+    pair_counts = [[0] * n for _ in range(n)]
+    participation = [0] * n
+    round_sizes = []
+    for _ in range(rounds):
+        parallel = _sample_parallel_class(
+            n,
+            rng,
+            planted,
+            forbidden,
+            pair_counts,
+            pair_cap,
+            participation,
+        )
+        round_sizes.append(len(parallel))
+        for a, b, c in parallel:
+            forbidden.add((a, b, c))
+            participation[a] += 1
+            participation[b] += 1
+            participation[c] += 1
+            for u, v in ((a, b), (a, c), (b, c)):
+                pair_counts[u][v] += 1
+                pair_counts[v][u] += 1
+
+    maximum_missing = max(
+        (pair_counts[u][v] for u in range(n) for v in range(u + 1, n)),
+        default=0,
+    )
+    return {
+        "family": "projective Steiner triple system in a dense 3-graph",
+        "n": n,
+        "dimension": (n + 1).bit_length() - 1,
+        "rounds": rounds,
+        "pair_cap": pair_cap,
+        "round_sizes": round_sizes,
+        "forbidden": [list(t) for t in sorted(forbidden)],
+        "minimum_codegree": n - 2 - maximum_missing,
+        "answer": answer,
+    }
+
+
+def _answer_text(answer) -> str:
+    return ", ".join(str(value) for value in answer)
+
+
+def render(inst) -> str:
+    triples = "\n".join(
+        f"  {a},{b},{c}" for a, b, c in inst["forbidden"]
+    )
+    statement = f"""PROJECTIVE STEINER TRIPLE SYSTEM IN A DENSE 3-GRAPH
+
+A 3-uniform hypergraph has vertices and unordered 3-element hyperedges. This
+instance has host vertices 0,...,{inst['n'] - 1}. Every 3-element subset is a
+host hyperedge except the explicitly listed forbidden triples below. Order
+inside a triple is irrelevant, and the list is exhaustive.
+
+A Steiner triple system (STS) is a collection of triples in which every
+unordered pair of distinct vertices occurs in exactly one triple.
+
+The template points are the nonzero {inst['dimension']}-bit vectors, encoded by
+the integers x=1,...,{inst['n']}. Its template blocks are exactly
+{{x,y,x XOR y}}: include one block for each 1 <= x < y <= {inst['n']} for which
+y < (x XOR y). Here XOR is bitwise exclusive-or on the ordinary binary
+representations. These {inst['n'] * (inst['n'] - 1) // 6} blocks form the fixed
+projective binary STS.
+
+Find a permutation p of the host vertices such that every mapped template
+block is a host hyperedge. Entry p[x-1] is the host image of template point x.
+Thus p must have exactly {inst['n']} integers, contain every integer from 0 to
+{inst['n'] - 1} exactly once, and preserve every required block. The host has
+minimum pair-codegree {inst['minimum_codegree']}: every host pair has at least
+that many possible third vertices.
+
+Forbidden host triples ({len(inst['forbidden'])} total):
+{triples if triples else '  (none)'}
+
+Give your final answer inside <answer></answer> tags as exactly {inst['n']}
+comma-separated base-10 integers, with no brackets. Example format:
+<answer>{_answer_text(list(range(inst['n'])))}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text) -> object | None:
+    try:
+        matches = re.findall(
+            r"<answer\b[^>]*>(.*?)</answer\s*>", str(text), re.I | re.S
+        )
+        if not matches:
+            return None
+        body = matches[-1].strip()
+        for fence in ("~~~", "`" * 3):
+            if body.startswith(fence) and body.endswith(fence):
+                body = re.sub(
+                    "^" + re.escape(fence) + r"[^\n]*\n?", "", body
+                )
+                body = re.sub(
+                    r"\n?" + re.escape(fence) + "$", "", body
+                ).strip()
+        if body.startswith("[") and body.endswith("]"):
+            parsed = json.loads(body)
+            if not isinstance(parsed, list):
+                return None
+            return parsed if all(type(x) is int for x in parsed) else None
+        pieces = [piece.strip() for piece in body.split(",")]
+        if not pieces or any(not re.fullmatch(r"[+-]?\d+", x) for x in pieces):
+            return None
+        return [int(piece) for piece in pieces]
+    except Exception:
+        return None
+
+
+def _instance_forbidden_set(inst):
+    return {tuple(triple) for triple in inst["forbidden"]}
+
+
+def _candidate_valid_fast(inst, answer, forbidden=None) -> bool:
+    n = inst["n"]
+    if not isinstance(answer, list) or len(answer) != n:
+        return False
+    if any(type(x) is not int or x < 0 or x >= n for x in answer):
+        return False
+    if len(set(answer)) != n:
+        return False
+    if forbidden is None:
+        forbidden = _instance_forbidden_set(inst)
+    return all(block not in forbidden for block in _mapped_blocks(n, answer))
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    n = inst["n"]
+    if answer is None:
+        return False, "answer is absent"
+    if not isinstance(answer, list):
+        return False, "answer must be a list"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) != n:
+        return False, f"answer length is {len(answer)}, expected {n}"
+    if any(type(value) is not int for value in answer):
+        return False, "every image must be an integer"
+    if any(value < 0 or value >= n for value in answer):
+        return False, "an image is outside the host-vertex range"
+    if len(set(answer)) != n:
+        return False, "the images repeat a host vertex"
+
+    forbidden = set()
+    pair_missing = [[0] * n for _ in range(n)]
+    for raw in inst["forbidden"]:
+        if (
+            not isinstance(raw, list)
+            or len(raw) != 3
+            or any(type(value) is not int for value in raw)
+            or not (0 <= raw[0] < raw[1] < raw[2] < n)
+        ):
+            return False, "instance contains a malformed forbidden triple"
+        triple = tuple(raw)
+        if triple in forbidden:
+            return False, "instance repeats a forbidden triple"
+        forbidden.add(triple)
+        a, b, c = triple
+        for u, v in ((a, b), (a, c), (b, c)):
+            pair_missing[u][v] += 1
+            pair_missing[v][u] += 1
+            if pair_missing[u][v] > inst["pair_cap"]:
+                return False, "instance violates its per-pair deletion cap"
+
+    pair_coverage = [[0] * n for _ in range(n)]
+    blocks = list(_mapped_blocks(n, answer))
+    expected_blocks = n * (n - 1) // 6
+    if len(blocks) != expected_blocks:
+        return False, "template expansion has the wrong number of blocks"
+    for block in blocks:
+        if block in forbidden:
+            return False, f"mapped template block {block} is forbidden"
+        a, b, c = block
+        for u, v in ((a, b), (a, c), (b, c)):
+            pair_coverage[u][v] += 1
+            pair_coverage[v][u] += 1
+    for u in range(n):
+        for v in range(u + 1, n):
+            if pair_coverage[u][v] != 1:
+                return False, f"host pair ({u},{v}) is covered {pair_coverage[u][v]} times"
+    return True, "ok"
+
+
+def random_candidate(inst, rng: random.Random) -> object:
+    candidate = list(range(inst["n"]))
+    rng.shuffle(candidate)
+    return candidate
+
+
+def search_space(inst) -> int | None:
+    return math.factorial(inst["n"])
+
+
+def enumerate_all(inst) -> int | None:
+    if inst["n"] > 8:
+        return None
+    forbidden = _instance_forbidden_set(inst)
+    return sum(
+        _candidate_valid_fast(inst, list(candidate), forbidden)
+        for candidate in itertools.permutations(range(inst["n"]))
+    )
+
+
+def _pair_count_matrix(inst):
+    n = inst["n"]
+    counts = [[0] * n for _ in range(n)]
+    for a, b, c in inst["forbidden"]:
+        for u, v in ((a, b), (a, c), (b, c)):
+            counts[u][v] += 1
+            counts[v][u] += 1
+    return counts
+
+
+def canonical_key(inst) -> str:
+    """A strong relabelling invariant, not a complete isomorphism canonicalizer."""
+    n = inst["n"]
+    counts = _pair_count_matrix(inst)
+    links = [set() for _ in range(n)]
+    for a, b, c in inst["forbidden"]:
+        links[a].add((b, c))
+        links[b].add(tuple(sorted((a, c))))
+        links[c].add((a, b))
+    local_signatures = []
+    for vertex in range(n):
+        degree_profile = sorted(counts[vertex][u] for u in range(n) if u != vertex)
+        adjacency = [set() for _ in range(n)]
+        for a, b in links[vertex]:
+            adjacency[a].add(b)
+            adjacency[b].add(a)
+        triangles = 0
+        common_hist = Counter()
+        others = [u for u in range(n) if u != vertex]
+        for i, u in enumerate(others):
+            for v in others[i + 1 :]:
+                common = len(adjacency[u] & adjacency[v])
+                common_hist[common] += 1
+                if v in adjacency[u]:
+                    triangles += common
+        local_signatures.append(
+            [
+                degree_profile,
+                triangles // 3,
+                sorted([value, count] for value, count in common_hist.items()),
+            ]
+        )
+    local_signatures.sort(key=lambda item: json.dumps(item, separators=(",", ":")))
+    payload = [
+        "dense-projective-sts-embedding-v1",
+        n,
+        inst["pair_cap"],
+        len(inst["forbidden"]),
+        local_signatures,
+    ]
+    raw = json.dumps(payload, separators=(",", ":")).encode("ascii")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    n = int(params["n"])
+    if n >= 255:
+        return "cap_bound"
+    new_n = 2 * n + 1
+    if new_n > 255:
+        return "cap_bound"
+    if new_n == 127:
+        return {"n": 127, "rounds": 180, "pair_cap": 8}
+    if new_n == 255:
+        return {"n": 255, "rounds": 360, "pair_cap": 20}
+    return {
+        "n": new_n,
+        "rounds": max(1, 3 * new_n // 2),
+        "pair_cap": max(4, math.ceil(3 * new_n / (new_n - 1)) + 4),
+    }
+
+
+def _attack_outlier_degree(inst):
+    degree = [0] * inst["n"]
+    for triple in inst["forbidden"]:
+        for vertex in triple:
+            degree[vertex] += 1
+    return sorted(range(inst["n"]), key=lambda vertex: (degree[vertex], vertex))
+
+
+def _consistent_image(var, image, mapping, forbidden, constraints_by_var, counter=None):
+    for triple in constraints_by_var[var]:
+        others = [point for point in triple if point != var]
+        if mapping[others[0]] != -1 and mapping[others[1]] != -1:
+            if counter is not None:
+                counter["constraint_checks"] += 1
+            block = tuple(sorted((image, mapping[others[0]], mapping[others[1]])))
+            if block in forbidden:
+                return False
+    return True
+
+
+def _attack_greedy(inst):
+    n = inst["n"]
+    constraints_by_var = [[] for _ in range(n)]
+    for triple in _template_triples(n):
+        for point in triple:
+            constraints_by_var[point].append(triple)
+    forbidden = _instance_forbidden_set(inst)
+    mapping = [-1] * n
+    used = set()
+    for var in range(n):
+        choice = next(
+            (
+                image
+                for image in range(n)
+                if image not in used
+                and _consistent_image(
+                    var, image, mapping, forbidden, constraints_by_var
+                )
+            ),
+            None,
+        )
+        if choice is None:
+            remaining = [image for image in range(n) if image not in used]
+            for tail_var, image in zip(
+                (point for point in range(var, n) if mapping[point] == -1),
+                remaining,
+            ):
+                mapping[tail_var] = image
+            return mapping
+        mapping[var] = choice
+        used.add(choice)
+    return mapping
+
+
+def _attack_random_restart(inst, rng, restarts=256):
+    forbidden = _instance_forbidden_set(inst)
+    last = list(range(inst["n"]))
+    for _ in range(restarts):
+        last = random_candidate(inst, rng)
+        if _candidate_valid_fast(inst, last, forbidden):
+            return last
+    return last
+
+
+def _attack_spectral(inst):
+    n = inst["n"]
+    matrix = _pair_count_matrix(inst)
+    vector = [1.0 if index % 2 == 0 else -1.0 for index in range(n)]
+    mean = sum(vector) / n
+    vector = [value - mean for value in vector]
+    for _ in range(24):
+        nxt = [sum(matrix[i][j] * vector[j] for j in range(n)) for i in range(n)]
+        mean = sum(nxt) / n
+        nxt = [value - mean for value in nxt]
+        norm = math.sqrt(sum(value * value for value in nxt)) or 1.0
+        vector = [value / norm for value in nxt]
+    host_order = sorted(range(n), key=lambda vertex: (vector[vertex], vertex))
+    template_order = sorted(
+        range(n), key=lambda point: ((point + 1).bit_count(), point)
+    )
+    mapping = [-1] * n
+    for point, host in zip(template_order, host_order):
+        mapping[point] = host
+    return mapping
+
+
+def _attack_dpll(inst, node_budget=50_000):
+    """Symmetry-normalized permutation-CSP search with completed-triple MRV."""
+    n = inst["n"]
+    triples = _template_triples(n)
+    constraints_by_var = [[] for _ in range(n)]
+    for triple in triples:
+        for point in triple:
+            constraints_by_var[point].append(triple)
+    forbidden = _instance_forbidden_set(inst)
+    mapping = [-1] * n
+    used = [False] * n
+    stats = {"nodes": 0, "constraint_checks": 0, "budget": node_budget}
+
+    # Any ordered pair of distinct projective points is taken to any other by
+    # GL(m,2), so every embedding has an equivalent representative with these
+    # two images. This is a real symmetry reduction, not a planted-answer clue.
+    mapping[0] = 0
+    mapping[1] = 1
+    used[0] = used[1] = True
+
+    def variable_score(var):
+        complete = 0
+        partial = 0
+        for triple in constraints_by_var[var]:
+            assigned = sum(mapping[point] != -1 for point in triple if point != var)
+            complete += assigned == 2
+            partial += assigned == 1
+        return complete, partial, -var
+
+    def search(depth):
+        if stats["nodes"] >= node_budget:
+            return None
+        if depth == n:
+            return mapping[:]
+        unassigned = [point for point in range(n) if mapping[point] == -1]
+        var = max(unassigned, key=variable_score)
+        candidates = []
+        for image in range(n):
+            if used[image]:
+                continue
+            if _consistent_image(
+                var,
+                image,
+                mapping,
+                forbidden,
+                constraints_by_var,
+                stats,
+            ):
+                candidates.append(image)
+        # A cheap least-constraining tie-break: balanced parallel classes make
+        # this intentionally almost flat, which is part of the attack test.
+        pair_counts = _pair_count_matrix(inst) if depth < 4 else None
+        if pair_counts is not None:
+            assigned_images = [value for value in mapping if value != -1]
+            candidates.sort(
+                key=lambda image: (
+                    sum(pair_counts[image][other] for other in assigned_images),
+                    image,
+                )
+            )
+        for image in candidates:
+            stats["nodes"] += 1
+            mapping[var] = image
+            used[image] = True
+            result = search(depth + 1)
+            if result is not None:
+                return result
+            used[image] = False
+            mapping[var] = -1
+            if stats["nodes"] >= node_budget:
+                break
+        return None
+
+    result = search(2)
+    stats["exhausted_budget"] = stats["nodes"] >= node_budget and result is None
+    return result, stats
+
+
+def _transform_instance(inst, old_to_new, reverse_input=False):
+    out = copy.deepcopy(inst)
+    transformed = []
+    for triple in inst["forbidden"]:
+        transformed.append(sorted(old_to_new[vertex] for vertex in triple))
+    transformed.sort()
+    if reverse_input:
+        transformed.reverse()
+    out["forbidden"] = transformed
+    out["answer"] = [old_to_new[vertex] for vertex in inst["answer"]]
+    return out
+
+
+def _answer_metrics(answer):
+    blob = json.dumps(answer, separators=(",", ":"))
+    return len(blob), math.ceil(len(blob) / 4), len(answer)
+
+
+def selftest():
+    report = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
+
+    g1_attempts = 0
+    g1_failures = []
+    json_roundtrips = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append([preset, seed, reason])
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_roundtrips += 1
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures and json_roundtrips == g1_attempts,
+        "attempts": g1_attempts,
+        "json_roundtrips": json_roundtrips,
+        "failures": g1_failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=90210, **ship_params)
+    answer = inst["answer"]
+    swap_answer = None
+    for i in range(inst["n"]):
+        for j in range(i + 1, inst["n"]):
+            trial = answer[:]
+            trial[i], trial[j] = trial[j], trial[i]
+            if not verify(inst, trial)[0]:
+                swap_answer = trial
+                break
+        if swap_answer is not None:
+            break
+    corruptions = {
+        "empty": [],
+        "drop": answer[:-1],
+        "swap": swap_answer,
+        "duplicate": answer[:-1] + [answer[0]],
+        "out_of_range": answer[:-1] + [inst["n"]],
+    }
+    rejection_reasons = {}
+    for name, corruption in corruptions.items():
+        ok, reason = verify(inst, corruption)
+        if ok:
+            rejection_reasons[name] = "ACCEPTED"
+        else:
+            rejection_reasons[name] = reason
+    g2_pass = (
+        all(reason != "ACCEPTED" for reason in rejection_reasons.values())
+        and len(set(rejection_reasons.values())) == len(rejection_reasons)
+    )
+    report["G2_rejects_corruption"] = {
+        "pass": g2_pass,
+        "reasons": rejection_reasons,
+        "distinct_reasons": len(set(rejection_reasons.values())),
+    }
+
+    realistic = (
+        "I used the binary-vector incidence.\n\n```text\n<answer>\n"
+        + _answer_text(answer)
+        + "\n</answer>\n```\n"
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and parse_answer("no tagged answer") is None,
+        "realistic_response": parsed == answer,
+        "garbage_returns_none": parse_answer("no tagged answer") is None,
+    }
+
+    guess_trials = 200_000
+    guess_hits = 0
+    guess_rng = random.Random(0x231015909)
+    forbidden = _instance_forbidden_set(inst)
+    for _ in range(guess_trials):
