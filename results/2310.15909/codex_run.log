+required sizes = [4,3,3,3]
+marked vertices in V0 = 8, 1
+vertex:residue =
+0:1 1:10 2:9 3:5 4:11 5:2 6:3 7:7 8:8 9:4 10:0 11:12 12:6
+
+hyperedges =
+0 1 6
