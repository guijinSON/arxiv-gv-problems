+def _gl2() -> list[tuple[int, int, int, int]]:
+    return [
+        (a, b, c, d)
+        for a in range(2)
+        for b in range(2)
+        for c in range(2)
+        for d in range(2)
+        if (a * d - b * c) & 1
+    ]
