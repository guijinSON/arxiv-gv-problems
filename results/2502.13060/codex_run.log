+            (rows, list(range(inst["columns"])), gl[0]),
+            (list(range(inst["n"])), columns, gl[0]),
+            (list(range(inst["n"])), list(range(inst["columns"])), gl[(offset + 1) % len(gl)]),
+            (rows, columns, gl[(offset + 2) % len(gl)]),
