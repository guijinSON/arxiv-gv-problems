+    for _attempt in range(10_000):
+        vector = _balanced_bits(columns, rng)
+        h0 = _balanced_bits(columns, rng)
+        h1 = _balanced_bits(columns, rng)
+        if h0 == h1:
+            continue
+        H = [h0, h1]
