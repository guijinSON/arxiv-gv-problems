+def _transform_h(code: int, q: tuple[int, int, int, int]) -> int:
+    # Q^-1 = [[d,b],[c,a]] over F_2 for det(Q)=1.
+    a, b, c, d = q
+    x, y = code & 1, (code >> 1) & 1
+    return (d * x ^ b * y) | ((c * x ^ a * y) << 1)
