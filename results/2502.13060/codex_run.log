+
+def render(inst: dict) -> str:
+    """Render the complete finite-field problem and its output grammar."""
+    lines = [
+        "TRAPDOORED BINARY MATRIX-VECTOR PRODUCT",
+        "",
+        "All arithmetic is over F_2: addition is XOR and multiplication is AND.",
