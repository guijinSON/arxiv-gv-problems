+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "dense matrix over F_2",
+        "LPN-style trapdoor factorization M = L H + S",
+        "binary column vector",
