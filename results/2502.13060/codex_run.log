+            "",
+            "H rows (row 0 first):",
+        ]
+    )
+    lines.extend(f"{i}: {row}" for i, row in enumerate(inst["H"]))
+    lines.extend(
+        [
+            "",
+            "S_support:",
+            " ".join(map(str, inst["S_support"])),
+            "",
+            "Input column vector v:",
