NOTES = """\
Section 1 fixes the native witness: a supertree S displays T when contracting
edges of S restricted to T's leaves yields T.  The same section states both
the general NP-completeness result and the FPT algorithm parameterized by the
number of input trees, so a small fixed profile cannot support Track A.  It
also licenses representing a tree by its splits.  Section 3, Theorem 7
(cuts_equal_compatibility in the source) characterizes compatible profiles by
complete pairwise-parallel legal minimal cuts.  Section 4 defines edge splits,
states pairwise split compatibility, invokes the Splits Equivalence Theorem,
and proves in Lemma 8 that the induced compatible split system yields a
compatible supertree.

This module uses the paper's trees and splits directly, with no non-phylogenetic
surrogate.  It chooses an affine caterpillar order first and carries its
exact splits into a balanced profile.  Every input has the same number of
splits and every planted split has the same frequency.  The leaf-score attack
tests per-taxon outliers; single-tree refinement tests the obvious greedy
completion; the numeric caterpillar tests a by-hand ansatz; and 256 uniform
binary-tree restarts test blind guessing.  Newick keeps the native tree witness
short enough to type without naming internal vertices.  The split-union method is
disclosed separately as the Track-B reference algorithm and is expected to
succeed.
"""


def _edge(a, b):
    if a == b:
        raise ValueError("a tree edge cannot be a loop")
    return [a, b] if a < b else [b, a]


def _sorted_edges(edges):
    return sorted((_edge(int(a), int(b)) for a, b in edges), key=lambda e: (e[0], e[1]))


def _caterpillar_edges(order):
    """Return the binary caterpillar whose leaf order is ``order``."""
    n = len(order)
    if n < 4:
        raise ValueError("a nontrivial binary caterpillar needs at least 4 leaves")
    spine = list(range(n, 2 * n - 2))
    edges = [
        _edge(order[0], spine[0]),
        _edge(order[1], spine[0]),
        _edge(order[-2], spine[-1]),
        _edge(order[-1], spine[-1]),
    ]
    for i in range(len(spine) - 1):
        edges.append(_edge(spine[i], spine[i + 1]))
    for leaf_index in range(2, n - 2):
        edges.append(_edge(order[leaf_index], spine[leaf_index - 1]))
    return _sorted_edges(edges)


def _caterpillar_newick(order):
    """Encode the binary caterpillar in unrooted Newick notation."""
    if len(order) < 4:
        raise ValueError("a nontrivial binary caterpillar needs at least 4 leaves")
    tail = f"({order[-2]},{order[-1]})"
    for leaf in reversed(order[2:-2]):
        tail = f"({leaf},{tail})"
    return f"({order[0]},{order[1]},{tail});"


def _adjacency_to_newick(adjacency, n, root=None, rng=None):
    """Serialize an unrooted binary adjacency structure, without branch lengths."""
    internal = [v for v in range(n, len(adjacency)) if adjacency[v]]
    if not internal:
        raise ValueError("tree has no internal vertex")
    root = internal[0] if root is None else root
    if root not in internal:
        raise ValueError("Newick root must be an internal vertex")

    def visit(vertex, parent):
        if vertex < n:
            return str(vertex)
        parts = [visit(child, vertex) for child in adjacency[vertex]
                 if child != parent]
        if rng is None:
            parts.sort()
        else:
            rng.shuffle(parts)
        return "(" + ",".join(parts) + ")"

    return visit(root, -1) + ";"


def _parse_newick(answer, n):
    """Parse the module's exact, branch-length-free unrooted Newick grammar."""
    if not isinstance(answer, str):
        return False, "answer must be a Newick string", None
    if not answer.strip():
        return False, "answer is empty", None

    class NewickFailure(Exception):
        pass

    text = answer
    position = 0
    next_internal = n
    adjacency = {leaf: set() for leaf in range(n)}
    seen_taxa = set()
    arities = {}

    def skip_space():
        nonlocal position
        while position < len(text) and text[position].isspace():
            position += 1

    def connect(a, b):
        adjacency.setdefault(a, set()).add(b)
        adjacency.setdefault(b, set()).add(a)

    def parse_node():
        nonlocal position, next_internal
        skip_space()
        if position >= len(text):
            raise NewickFailure("malformed Newick: unexpected end of input")
        if text[position] == "(":
            position += 1
            children = [parse_node()]
            while True:
                skip_space()
                if position >= len(text):
                    raise NewickFailure("malformed Newick: missing ')'")
                if text[position] == ",":
                    position += 1
                    children.append(parse_node())
                    continue
                if text[position] == ")":
                    position += 1
                    break
                raise NewickFailure(
                    f"malformed Newick: expected ',' or ')' at character {position}"
                )
            vertex = next_internal
            next_internal += 1
            adjacency[vertex] = set()
            arities[vertex] = len(children)
            for child in children:
                connect(vertex, child)
            return vertex
        if not text[position].isdigit():
            raise NewickFailure(
                f"malformed Newick: expected a taxon at character {position}"
            )
        end = position + 1
        while end < len(text) and text[end].isdigit():
            end += 1
        taxon = int(text[position:end])
        position = end
        if not 0 <= taxon < n:
            raise NewickFailure(f"taxon {taxon} is outside 0..{n - 1}")
        if taxon in seen_taxa:
            raise NewickFailure(f"taxon {taxon} appears more than once")
        seen_taxa.add(taxon)
        return taxon

    try:
        root = parse_node()
        skip_space()
        if position >= len(text) or text[position] != ";":
            raise NewickFailure("malformed Newick: missing final semicolon")
        position += 1
        skip_space()
        if position != len(text):
            raise NewickFailure(
                f"malformed Newick: trailing text at character {position}"
            )
        if root < n:
            raise NewickFailure("the Newick root must be an internal group")
        if len(seen_taxa) != n:
            raise NewickFailure(
                f"wrong taxon count: expected {n}, got {len(seen_taxa)}"
            )
        if arities.get(root) != 3:
            raise NewickFailure(
                f"outer Newick group has arity {arities.get(root)}, not 3"
            )
        for vertex, arity in arities.items():
            if vertex != root and arity != 2:
                raise NewickFailure(
                    f"an inner Newick group has arity {arity}, not 2"
                )
        if len(arities) != n - 2:
            raise NewickFailure(
                f"wrong internal-group count: expected {n - 2}, got {len(arities)}"
            )
    except NewickFailure as exc:
        return False, str(exc), None

    packed = [sorted(adjacency.get(v, ())) for v in range(next_internal)]
    for leaf in range(n):
        if len(packed[leaf]) != 1:
            return False, f"taxon {leaf} has degree {len(packed[leaf])}, not 1", None
    for vertex in range(n, next_internal):
        if len(packed[vertex]) != 3:
            return False, (
                f"internal vertex {vertex - n + 1} has degree "
                f"{len(packed[vertex])}, not 3"
            ), None
    return True, "ok", packed


def _normalize_mask(mask, n):
    full = (1 << n) - 1
    other = full ^ mask
    left_size = mask.bit_count()
    right_size = n - left_size
    if left_size < right_size:
        return mask
    if right_size < left_size:
        return other
    return min(mask, other)


