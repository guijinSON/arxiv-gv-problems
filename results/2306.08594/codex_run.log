   553	def escalate(params):
   554	    """Enlarge value haystacks without lengthening the witness."""
   555	    p = {k: v for k, v in params.items() if k != "_preset"}
   556	    q = p["n"] + 2
   557	    groups = p["groups"]
   558	    # A round contributes groups/3 constraint rows.  Never let escalation make
   559	    # the compact row-check route exceed the 300-operation G9(c) cap.
   560	    max_rounds = (300 - groups) * 3 // groups
   561	    rounds = min(
   562	        max_rounds,
   563	        max(p["rounds"], math.ceil(1.6 * (q - 1))),
   564	    )
   565	    if q > 64 or groups > 240 or rounds > 120:
   566	        return "cap_bound" if groups + 3 > 256 else None
   567	    p["n"] = q
   568	    p["groups"] = groups
   569	    p["rounds"] = rounds
   570	    p["dpll_node_budget"] = min(20_000_000, p["dpll_node_budget"] * 2)
   571	    return p
