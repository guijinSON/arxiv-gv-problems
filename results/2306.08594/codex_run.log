+def _attack_exact_dpll(inst, node_budget=None):
+    """Standard complete q-ary DPLL if the node cap is removed."""
+    if node_budget is None:
+        node_budget = inst["dpll_node_budget"]
+    q = inst["value_count"]
+    local_constraints = _local_masks(inst)
+    full = (1 << q) - 1
+    nodes = 0
+    exhausted = False
