   523	def canonical_key(inst):
   524	    """Strong relabelling invariant from pairwise clause intersections.
   525	
   526	    It ignores public ground labels, group order, value order, constraint order,
   527	    and the orientation of every complementary clause pair.  It is intentionally
   528	    documented as a strong invariant, not a complete hypergraph canonizer.
   529	    """
   530	    pairs = _constraint_global_sets(inst)
   531	    histogram = Counter()
   532	    for i, (a0, a1, scope_a) in enumerate(pairs):
   533	        for b0, b1, scope_b in pairs[i + 1:]:
   534	            intersections = sorted((
   535	                len(a0 & b0), len(a0 & b1),
   536	                len(a1 & b0), len(a1 & b1),
   537	            ))
   538	            histogram[(len(scope_a & scope_b), *intersections)] += 1
   539	    payload = {
   540	        "g": inst["group_count"],
   541	        "q": inst["value_count"],
   542	        "c": len(pairs),
   543	        "pair_intersections": [
   544	            [list(signature), count]
   545	            for signature, count in sorted(histogram.items())
   546	        ],
   547	    }
   548	    return hashlib.sha256(
   549	        json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
   550	    ).hexdigest()
