import importlib.util,itertools,collections
s=importlib.util.spec_from_file_location('g','gen_2306_08594.py');g=importlib.util.module_from_spec(s);s.loader.exec_module(g)

def bfs_check(I,a):
 pos,why=g._decode_candidate(I,a)
 if pos is None:return False
 chosen,fam=g._all_set_memberships(I,pos)
 verts=['a','b','c']+I['ground_order']+[f'{z}_{j}' for j in range(I['set_count']) for z in 'PQ']
 A={v:[] for v in verts}
 for x in I['ground_order']:A['a'].append(x)
 A['b'].append(I['ground_order'][0])
 for x,y in zip(I['ground_order'],I['ground_order'][1:]):A[x].append(y)
 A['c'] += ['P_0','Q_0']
 for j,F in enumerate(fam):
  A[f'P_{j}'].append(f'Q_{j}')
  if j+1<I['set_count']:
   A[f'P_{j}'] += [f'P_{j+1}',f'Q_{j+1}'];A[f'Q_{j}'] += [f'P_{j+1}',f'Q_{j+1}']
  for x in I['ground_order']:
   A[x].append(f'P_{j}')
   if x not in F:A[x].append(f'Q_{j}')
 R=['a','b','c']+chosen; sig={}
 for w in R:
  d={w:0};Q=collections.deque([w])
  while Q:
   u=Q.popleft()
   for v in A[u]:
    if v not in d:d[v]=d[u]+1;Q.append(v)
  for v in verts:
   if v not in R:sig.setdefault(v,[]).append(d.get(v))
 return len({tuple(x) for x in sig.values()})==len(sig)
for seed in range(12):
 I=g.make_instance(seed=seed,**g.DIFFICULTY['demo'])
 for p in itertools.product(range(I['value_count']),repeat=I['group_count']):
  a=g._positions_to_answer(I,p)
  v=g.verify(I,a)[0];b=bfs_check(I,a)
  assert v==b,(seed,p,v,b,g.verify(I,a))
print('independent explicit-BFS equivalence: 96/96 candidates')
