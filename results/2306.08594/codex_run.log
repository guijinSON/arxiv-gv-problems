+            return False
+        choices = [
+            (domain.bit_count(), i)
+            for i, domain in enumerate(domains)
+            if domain & (domain - 1)
+        ]
+        if not choices:
+            positions = [domain.bit_length() - 1 for domain in domains]
+            if _first_violated_constraint(inst, positions) is None:
