   586	def _attack_frequency_outlier(inst):
   587	    # Every value occurs in its group set and exactly once in each complementary
   588	    # pair touching its group, so all scores tie by construction.
   589	    frequency = Counter()
   590	    for group in inst["groups"]:
   591	        frequency.update(group)
   592	    for plus, minus, _scope in _constraint_global_sets(inst):
   593	        frequency.update(plus)
   594	        frequency.update(minus)
   595	    positions = []
   596	    for group in inst["groups"]:
   597	        best = max(range(len(group)), key=lambda j: (frequency[group[j]], -group[j]))
   598	        positions.append(best)
   599	    return _positions_to_answer(inst, positions)
