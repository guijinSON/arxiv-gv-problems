+"""Verified problem generator for arXiv:2306.08594.
+
+The paper proves Directed Metric Dimension NP-complete on DAGs by a direct
+reduction from Hitting Set (Theorem 2).  This module uses that exact reduction.
+It inverse-generates a Hitting Set instance from a planted cyclic 3-XOR
+solution, exposes the resulting DAG by its compact defining data, and asks for
+the paper's normalized minimum resolving set.
+
+Only the Python standard library is required.  Importing this module performs
+no I/O, network access, global random sampling, or printing.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import sys
+import time
+from collections import Counter, defaultdict, deque
+from typing import Any
+
+
+# Keep the repository helpers reachable when harden.py is run from this
+# directory.  This family needs no helper, so the fallback remains complete.
