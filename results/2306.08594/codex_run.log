-"""Verified problem generator for arXiv:2306.08594.
+#!/usr/bin/env python3
+"""Verified directed-metric-dimension instances from arXiv:2306.08594.
 
-The paper proves Directed Metric Dimension NP-complete on DAGs by a direct
-reduction from Hitting Set (Theorem 2).  This module uses that exact reduction.
-It inverse-generates a Hitting Set instance from a planted cyclic 3-XOR
-solution, exposes the resulting DAG by its compact defining data, and asks for
-the paper's normalized minimum resolving set.
-
-Only the Python standard library is required.  Importing this module performs
-no I/O, network access, global random sampling, or printing.
+The generator inverse-builds a balanced Hitting Set instance with a known
+transversal, then applies the exact DAG construction in the proof of the
+paper's NP-completeness theorem.  The chosen ground elements, together with
+the three mandatory source vertices, are therefore a directed resolving set
+by construction.  Generation never searches the emitted graph for a witness.
 """
 
 from __future__ import annotations
 
+import copy
 import hashlib
+import itertools
 import json
 import math
 import os
 import random
 import re
