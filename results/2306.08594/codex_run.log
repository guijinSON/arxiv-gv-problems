   349	def parse_answer(text):
   350	    """Extract the tagged JSON list while tolerating prose and fences."""
   351	    if not isinstance(text, str):
   352	        return None
   353	    matches = _ANSWER_RE.findall(text)
   354	    if not matches:
   355	        return None
   356	    body = matches[-1].strip()
   357	    fence = _FENCE_RE.match(body)
   358	    if fence:
   359	        body = fence.group(1).strip()
   360	    try:
   361	        value = json.loads(body)
   362	    except (TypeError, ValueError, json.JSONDecodeError):
   363	        return None
   364	    return value if isinstance(value, list) else None
