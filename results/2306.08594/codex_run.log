+def escalate(params):
+    """Enlarge value haystacks first, then periodically grow the witness."""
+    p = {k: v for k, v in params.items() if k != "_preset"}
+    q = p["n"] + 2
+    groups = p["groups"]
+    # Keep answer length fixed through q=16.  Thereafter grow the Hitting Set
+    # parameter as well, avoiding a fixed-k/FPT easy regime indefinitely.
+    if q > 16:
+        groups += 3
+    rounds = max(p["rounds"] + 3, math.ceil(1.6 * (q - 1)))
+    if q > 64 or groups > 240 or rounds > 120:
+        return "cap_bound" if groups + 3 > 256 else None
+    p["n"] = q
+    p["groups"] = groups
+    p["rounds"] = rounds
+    p["dpll_node_budget"] = min(20_000_000, p["dpll_node_budget"] * 2)
+    return p
 
 
