+        for group_index, plus in zip(constraint["groups"], constraint["plus"]):
+            mask = 0
+            for label in plus:
+                mask |= 1 << maps[group_index][label]
+            masks.append(mask)
+        local.append((tuple(constraint["groups"]), tuple(masks), qmask))
+    return local
 
 
