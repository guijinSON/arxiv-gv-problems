   702	def _propagate_domains(domains, local_constraints):
   703	    changed = True
   704	    while changed:
   705	        changed = False
   706	        for groups, masks, qmask in local_constraints:
   707	            possible = []
   708	            for group_index, mask in zip(groups, masks):
   709	                domain = domains[group_index]
   710	                bits = 0
   711	                if domain & (qmask ^ mask):
   712	                    bits |= 1
   713	                if domain & mask:
   714	                    bits |= 2
   715	                possible.append(bits)
   716	            if 0 in possible:
   717	                return False
   718	            # If all three are forced to the same Boolean side, NAE fails.
   719	            if possible[0] == possible[1] == possible[2] and possible[0] in (1, 2):
   720	                return False
   721	            for j in range(3):
   722	                other = [possible[x] for x in range(3) if x != j]
   723	                if other[0] == other[1] and other[0] in (1, 2):
   724	                    allowed = masks[j] if other[0] == 1 else (qmask ^ masks[j])
   725	                    group_index = groups[j]
   726	                    new_domain = domains[group_index] & allowed
   727	                    if not new_domain:
   728	                        return False
   729	                    if new_domain != domains[group_index]:
   730	                        domains[group_index] = new_domain
   731	                        changed = True
   732	    return True
