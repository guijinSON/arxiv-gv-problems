   622	def _attack_greedy(inst):
   623	    # Assign groups once in their public order, minimizing violations among the
   624	    # constraints that become fully assigned at that step; never backtrack.
   625	    q = inst["value_count"]
   626	    positions = [None] * inst["group_count"]
   627	    by_group = [[] for _ in range(inst["group_count"])]
   628	    for constraint in inst["constraints"]:
   629	        for group_index in constraint["groups"]:
   630	            by_group[group_index].append(constraint)
   631	    for group_index in range(inst["group_count"]):
   632	        scored = []
   633	        for value in range(q):
   634	            positions[group_index] = value
   635	            bad = 0
   636	            for constraint in by_group[group_index]:
   637	                if all(positions[x] is not None for x in constraint["groups"]):
   638	                    bits = _constraint_bits(inst, positions, constraint)
   639	                    bad += int(bits[0] == bits[1] == bits[2])
   640	            scored.append((bad, value))
   641	        positions[group_index] = min(scored)[1]
   642	    return _positions_to_answer(inst, positions)
