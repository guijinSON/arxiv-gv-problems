+def _propagate_domains(domains, local_constraints):
+    changed = True
+    while changed:
+        changed = False
+        for groups, masks, qmask in local_constraints:
+            possible = []
+            for group_index, mask in zip(groups, masks):
+                domain = domains[group_index]
+                bits = 0
+                if domain & (qmask ^ mask):
+                    bits |= 1
+                if domain & mask:
