   602	def _violation_count(inst, positions):
   603	    return sum(
   604	        1
   605	        for constraint in inst["constraints"]
   606	        if (lambda bits: bits[0] == bits[1] == bits[2])(
   607	            _constraint_bits(inst, positions, constraint)
   608	        )
   609	    )
   610	
   611	
   612	def _local_violation_count(local_constraints, positions):
   613	    bad = 0
   614	    for groups, masks, _qmask in local_constraints:
   615	        b0 = (masks[0] >> positions[groups[0]]) & 1
   616	        b1 = (masks[1] >> positions[groups[1]]) & 1
   617	        b2 = (masks[2] >> positions[groups[2]]) & 1
   618	        bad += int(b0 == b1 == b2)
   619	    return bad
