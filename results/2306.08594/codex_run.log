+    os.path.abspath(__file__)))))
+try:
+    from gvlib import exact_matrices, rationals  # noqa: F401
+except ImportError:  # pragma: no cover - the stdlib implementation is complete
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "linear_algebra",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "a Hitting Set family of two- and three-element subsets",
+        "the directed acyclic graph in the proof of Theorem 2",
+        "a normalized minimum directed resolving set",
+    ],
+    "verification_operations": [
+        "set membership and disjoint-pair checks",
+        "exact evaluation of the Theorem 2 distance signatures",
+        "minimum-size lower bound from disjoint two-element sets",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 0.3, Theorem 2: the paper's Hitting Set to Directed Metric "
+        "Dimension reduction for DAGs"
+    ),
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Four ternary sets on the same three choice pairs are one GF(2) "
+        "parity equation, and their supports form a tight cycle; without this "
+        "change of variables one searches the exponentially large hitting-set "
+        "language or performs general elimination."
