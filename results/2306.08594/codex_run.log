+        return "cap_bound" if groups + 3 > 256 else None
+    p["n"] = q
+    p["groups"] = groups
+    p["rounds"] = rounds
+    p["dpll_node_budget"] = min(20_000_000, p["dpll_node_budget"] * 2)
+    return p
 
 
