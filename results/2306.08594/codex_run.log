+def _local_masks(inst):
+    maps = [
+        {label: position for position, label in enumerate(group)}
+        for group in inst["groups"]
+    ]
+    local = []
+    qmask = (1 << inst["value_count"]) - 1
+    for constraint in inst["constraints"]:
