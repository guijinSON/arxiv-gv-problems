+
+NOTES = r"""
+Paper definition.  Definition 1 in Section 0.1.1 fixes the directed convention:
+w resolves u,v using distances FROM w, undefined distances do not compare, and
+membership of w in {u,v} resolves the pair directly.  Section 0.3, Theorem 2,
+fixes the reduction used here.  Its three indegree-zero vertices are forced;
+the x-vertices distinguish the pair C_j,C'_j exactly when x lies in C_j.
+
+Step 0 and track.  Theorem 1 and the BottomUp/Merge tables make minimum directed
+resolving sets of strongly connected directed co-graphs computable in linear
+time, so the prior proposal to plant a hard co-graph resolving set cannot be a
+Track-A family.  Theorem 2 is the hard regime: Directed Metric Dimension is
+NP-complete even for DAGs.  This module stays in the precise image of that
+paper-central reduction.  The generated subdistribution nevertheless has an
+efficient GF(2) algorithm, so it is declared Track B.  The standard certificate
+producer is Gaussian elimination, not hidden as a hardness claim.
+
+Generation.  A random answer and a random cyclic ordering of the variables are
+sampled first.  Consecutive triples in that cyclic order define a square cyclic
+3-XOR system; n is never divisible by 3, so its homogeneous recurrence has only
+the zero solution and the planted answer is unique.  Each parity equation is
+compiled into its four falsifying ternary clauses, each variable contributes
+one disjoint two-element choice set, and ground labels plus all input orders are
+randomized while the certificate is carried through.  Extra equations, when
+requested by escalate(), use uniformly random unused triples and the same
+parity encoding.  No finished instance is solved during generation.
+
+Mechanical and compact costs.  Grouping the four ternary sets recovers a binary
+linear system and dense Gaussian elimination solves it in O(q*n^2), O(n^3) on
+the square presets.  The measured scalar count is recorded by selftest.  The
+compact route recognizes the tight support cycle, expresses the recurrence in
+terms of two starting bits, uses the two wraparound equations, and propagates;
+at shipping size this is bounded by 3n+12=222 bit operations.
+
+Attack defenses.  In every four-clause parity block each literal occurs exactly
+twice, so per-literal frequency is identically balanced and planted/other
+literal labels have the same marginal distribution.  The cycle order, ground
+labels, pair order, set order, and within-set order are independently shuffled.
+Selftest measures a frequency outlier probe, greedy marginal coverage, 256
+structure-aware random restarts, and a branch-free one-pass repair heuristic.
+The successful Gaussian algorithm is reported separately, as Track B requires.
+
+Canonicalization.  Arbitrary ground relabeling, pair reordering, family-set
+reordering, and within-set reordering are genuine symmetries.  Exact canonical
+labeling of the associated incidence structure is a graph-isomorphism problem;
+the key therefore uses an invariant Weisfeiler--Leman refinement fingerprint.
+The selftest checks the symmetries and carried witnesses over twenty seeds and
+checks twenty unrelated instances for distinct keys.  WL collisions remain a
+documented theoretical caveat rather than being concealed by hashing the seed.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 1_000_000
+_NONMONO_N = "n must not be divisible by 3 (the cyclic system would be singular)"
+
+
+def _xor_clause_sets(support: tuple[int, int, int], rhs: int) -> list[list[int]]:
+    """Four Hitting Set clauses whose common solutions have XOR equal to rhs."""
+    out: list[list[int]] = []
+    for mask in range(8):
+        forbidden = ((mask >> 0) & 1, (mask >> 1) & 1, (mask >> 2) & 1)
+        if (forbidden[0] ^ forbidden[1] ^ forbidden[2]) == rhs:
+            continue
+        # A clause is unhit exactly on this forbidden assignment.  Therefore
+        # it contains, for each variable, the opposite choice.
+        out.append([
+            2 * variable + (1 - bit)
+            for variable, bit in zip(support, forbidden)
+        ])
+    return out
+
+
+def _maximum_equations(variable_count: int) -> int:
+    return math.comb(variable_count, 3)
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Inverse-generate a certified Theorem-2 DAG instance.
+
+    ``n`` is the number of binary choice pairs and cyclic core equations.
+    ``extra_equations`` grows the equation haystack without lengthening the
+    answer.  The square core is full rank whenever n is not divisible by 3.
+    """
+    extra_equations = params.pop("extra_equations", 0)
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    if isinstance(n, bool) or not isinstance(n, int) or n < 5:
+        raise ValueError("n must be an integer at least 5")
+    if n % 3 == 0:
+        raise ValueError(_NONMONO_N)
+    if (isinstance(extra_equations, bool) or
+            not isinstance(extra_equations, int) or extra_equations < 0):
+        raise ValueError("extra_equations must be a nonnegative integer")
+    if n + extra_equations > _maximum_equations(n):
+        raise ValueError("too many equations for distinct three-variable supports")
+
+    rng = random.Random(seed)
+    planted = [rng.randrange(2) for _ in range(n)]
+    cycle = list(range(n))
+    rng.shuffle(cycle)
+
+    supports: list[tuple[int, int, int]] = []
+    used: set[tuple[int, int, int]] = set()
+    for i in range(n):
+        support = tuple(sorted((cycle[i], cycle[(i + 1) % n],
+                                cycle[(i + 2) % n])))
+        if support in used:  # impossible for n>=5, retained as a sanity check
+            raise AssertionError("cyclic supports unexpectedly repeated")
+        used.add(support)
+        supports.append(support)
+    while len(supports) < n + extra_equations:
+        support = tuple(sorted(rng.sample(range(n), 3)))
+        if support not in used:
+            used.add(support)
+            supports.append(support)
+
+    choice_pairs = [[2 * i, 2 * i + 1] for i in range(n)]
+    ternary_sets: list[list[int]] = []
+    for support in supports:
+        rhs = planted[support[0]] ^ planted[support[1]] ^ planted[support[2]]
+        clauses = _xor_clause_sets(support, rhs)
+        for clause in clauses:
+            rng.shuffle(clause)
+        ternary_sets.extend(clauses)
+
+    # Carry everything through a uniformly random ground relabeling.
+    labels = list(range(2 * n))
+    rng.shuffle(labels)
+    relabel = {old: labels[old] for old in range(2 * n)}
+    pairs = [[relabel[x] for x in pair] for pair in choice_pairs]
+    sets = [[relabel[x] for x in subset]
+            for subset in choice_pairs + ternary_sets]
+    for pair in pairs:
+        rng.shuffle(pair)
+    for subset in sets:
+        rng.shuffle(subset)
+    rng.shuffle(pairs)
+    rng.shuffle(sets)
+    answer = sorted(relabel[2 * i + planted[i]] for i in range(n))
+
+    return {
+        "family": "theorem2_dag_cyclic_xor_hitting_v1",
+        "n": n,
+        "variable_count": n,
+        "equation_count": n + extra_equations,
+        "extra_equations": extra_equations,
+        "ground_size": 2 * n,
+        "pairs": pairs,
+        "sets": sets,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Return the complete self-contained problem seen by a solver."""
+    v = inst["variable_count"]
+    family_count = len(inst["sets"])
+    set_lines = "\n".join(
+        f"S{index}: " + " ".join(str(x) for x in subset)
+        for index, subset in enumerate(inst["sets"])
+    )
+    pair_lines = "\n".join(
+        f"P{index}: {pair[0]} {pair[1]}"
+        for index, pair in enumerate(inst["pairs"])
+    )
+    statement = f"""MINIMUM DIRECTED RESOLVING SET IN A THEOREM-2 DAG
+
+A directed path's length is its number of edges.  The directed distance from
+w to u is the shortest such length and is undefined when no directed path
+exists.  A vertex w resolves distinct vertices u and z when w is one of them,
+or when both directed distances from w are defined and unequal.  A resolving
+set resolves every pair of vertices.
+
+The following finite set family defines a directed acyclic graph G exactly.
+The ground elements are the integers 0 through {2 * v - 1}.  The family has
+{family_count} indexed subsets S0,...,S{family_count - 1}, displayed below.
+G has source vertices A,B,C; ground vertices X0,...,X{2 * v - 1}; and, for
+each Sj, vertices Lj and Rj.  Its complete directed edge set is:
+
+  * A -> Xi for every ground element i;
+  * B -> X0, and Xi -> X(i+1) for 0 <= i < {2 * v - 1};
+  * C -> L0 and C -> R0;
+  * Lj -> Rj for every 0 <= j < {family_count};
+  * all four edges from {{Lj,Rj}} to {{L(j+1),R(j+1)}} for
+    0 <= j < {family_count - 1};
+  * Xi -> Lj for every i,j; and
+  * Xi -> Rj exactly when i is NOT a member of Sj.
+
+There are no other edges.  This compact rule is the graph; no edge is implicit
+beyond the bullets above.
+
+Find a normalized minimum resolving set.  It must contain A,B,C and exactly
+{v} ground vertices.  The ground vertices must choose exactly one element from
+each disjoint choice pair below.  Equivalently, output their {v} integer labels.
+Every displayed family subset Sj must contain at least one chosen label.  These
+conditions make {{A,B,C}} together with the chosen Xi resolve G: A,B,C resolve
+all pairs except each Lj,Rj pair, and a chosen Xi resolves Lj,Rj exactly when
+i belongs to Sj.  The disjoint choice pairs also certify that fewer than {v}
+ground choices cannot meet every pair subset.
+
+Choice pairs (their order and the order inside each pair carry no meaning):
+{pair_lines}
+
+Family subsets (a two-element line is one of the same choice-pair constraints;
+all subset orderings carry no meaning):
+{set_lines}
+
+The answer is a JSON list of exactly {v} distinct integer labels.  It must be
+strictly increasing, choose exactly one label from every choice pair, and use
+only the inclusive range 0 through {2 * v - 1}.  Repeats are forbidden.
+
+Give your final answer inside <answer></answer> tags as that JSON list.
+Example of the required syntax only: <answer>[0, 3, 4]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def _decode_list(body: str) -> object | None:
+    body = body.strip()
+    if body.startswith("```") and body.endswith("```"):
+        lines = body.splitlines()[1:]
+        if lines and lines[-1].strip() == "```":
+            lines.pop()
+        body = "\n".join(lines).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, MemoryError, RecursionError):
+        return None
+    return value if isinstance(value, list) else None
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract a tagged JSON list, tolerating prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    for body in reversed(_ANSWER_RE.findall(text)):
+        value = _decode_list(body)
+        if value is not None:
+            return value
+    decoder = json.JSONDecoder()
+    for match in reversed(list(re.finditer(r"\[", text))):
+        try:
+            value, _ = decoder.raw_decode(text[match.start():])
+        except (TypeError, ValueError, MemoryError, RecursionError):
+            continue
+        if isinstance(value, list):
+            return value
+    return None
+
+
+def _pair_data(inst: dict) -> tuple[list[tuple[int, int]], dict[int, tuple[int, int]]]:
+    pairs = sorted(tuple(sorted(pair)) for pair in inst["pairs"])
+    element_map: dict[int, tuple[int, int]] = {}
+    for variable, pair in enumerate(pairs):
+        if len(pair) != 2 or pair[0] == pair[1]:
+            raise ValueError("malformed choice pair")
+        for side, element in enumerate(pair):
+            if element in element_map:
+                raise ValueError("choice pairs are not disjoint")
+            element_map[element] = (variable, side)
+    return pairs, element_map
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any normalized minimum witness; never inspect inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer must not be empty"
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in answer):
+        return False, "every selected ground label must be an ordinary integer"
+    ground_size = inst["ground_size"]
+    if any(x < 0 or x >= ground_size for x in answer):
+        return False, f"a selected label is outside the inclusive range 0..{ground_size - 1}"
+    if len(set(answer)) != len(answer):
+        return False, "selected ground labels must be distinct"
+    v = inst["variable_count"]
+    if len(answer) != v:
+        return False, f"answer must contain exactly {v} ground labels"
+    if any(answer[i] >= answer[i + 1] for i in range(len(answer) - 1)):
+        return False, "answer labels must be in strictly increasing order"
+
+    selected = set(answer)
+    try:
+        pairs, element_map = _pair_data(inst)
+    except (KeyError, TypeError, ValueError) as exc:
+        return False, f"malformed instance choice pairs: {exc}"
+    if set(element_map) != set(range(ground_size)):
+        return False, "instance choice pairs do not partition the ground labels"
+    if any((pair[0] in selected) + (pair[1] in selected) != 1 for pair in pairs):
+        return False, "answer must choose exactly one label from every choice pair"
+    for index, subset in enumerate(inst["sets"]):
+        if not any(element in selected for element in subset):
+            return False, (
+                f"family subset S{index} is unhit, so the corresponding "
+                f"vertices L{index} and R{index} have identical signatures"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the structure-aware 2^v one-per-pair language."""
+    pairs, _ = _pair_data(inst)
+    return sorted(pair[rng.randrange(2)] for pair in pairs)
+
+
+def _sampled_guess_hits(inst: dict, rng: random.Random, total: int) -> int:
+    """Fast exact batch form of repeated random_candidate+verify calls.
+
+    Each mask is uniform on precisely the same one-choice-per-pair language as
+    ``random_candidate``.  The parity equations are reconstructed from the
+    public sets once instead of rebuilding pair maps 200,000 times.
+    """
+    rows, rhs_values, _ = _equations_from_sets(inst)
+    row_masks = []
+    for row in rows:
+        mask = 0
+        for column, coefficient in enumerate(row):
+            if coefficient:
+                mask |= 1 << column
+        row_masks.append(mask)
+    hits = 0
+    width = inst["variable_count"]
+    for _ in range(total):
+        candidate_mask = rng.getrandbits(width)
+        hits += int(all(((candidate_mask & row).bit_count() & 1) == rhs
+                        for row, rhs in zip(row_masks, rhs_values)))
+    return hits
+
+
+def search_space(inst: dict) -> int:
+    """There are exactly two choices for every disjoint displayed pair."""
+    return 1 << inst["variable_count"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Brute-force the bounded language only when it is safely small."""
+    v = inst["variable_count"]
+    if (1 << v) > _ENUMERATION_CAP:
+        return None
+    pairs, _ = _pair_data(inst)
+    count = 0
+    for mask in range(1 << v):
+        answer = sorted(pair[(mask >> i) & 1] for i, pair in enumerate(pairs))
+        count += int(verify(inst, answer)[0])
+    return count
+
+
+def _equations_from_sets(inst: dict) -> tuple[list[list[int]], list[int], int]:
+    """Recover Ax=b over GF(2) solely from the displayed set system."""
+    pairs, element_map = _pair_data(inst)
+    groups: dict[
+        tuple[int, int, int], list[tuple[tuple[int, int, int], ...]]
+    ] = defaultdict(list)
+    scan_ops = 0
+    for subset in inst["sets"]:
+        if len(subset) != 3:
+            continue
+        decoded = tuple(sorted(
+            (element_map[element][0], element_map[element][1], element)
+            for element in subset
+        ))
+        support = tuple(variable for variable, _side, _element in decoded)
+        if len(set(support)) != 3:
+            raise ValueError("ternary set repeats a choice pair")
+        groups[support].append(decoded)
+        scan_ops += 3
+
+    rows: list[list[int]] = []
+    rhs_values: list[int] = []
+    for support, clauses in groups.items():
+        if len(clauses) % 4 != 0:
+            raise ValueError("a three-pair support does not have clause blocks of four")
+        satisfying: list[tuple[int, int, int]] = []
+        for mask in range(8):
+            bits = tuple((mask >> i) & 1 for i in range(3))
+            selected = {pairs[support[i]][bits[i]] for i in range(3)}
+            if all(any(element in selected
+                       for _variable, _side, element in clause)
+                   for clause in clauses):
+                satisfying.append(bits)
+            scan_ops += len(clauses)
+        parities = {a ^ b ^ c for a, b, c in satisfying}
+        if len(satisfying) != 4 or len(parities) != 1:
+            raise ValueError("ternary clauses do not encode one parity equation")
+        row = [0] * len(pairs)
+        for variable in support:
+            row[variable] = 1
+        rows.append(row)
+        rhs_values.append(next(iter(parities)))
+    return rows, rhs_values, scan_ops
+
+
+def _gaussian_reference(inst: dict) -> dict:
+    """Domain-standard exact solver, deliberately scalar for cost accounting."""
+    t0 = time.perf_counter()
+    try:
+        rows, rhs_values, operations = _equations_from_sets(inst)
+        v = inst["variable_count"]
+        matrix = [row + [rhs] for row, rhs in zip(rows, rhs_values)]
+        rank = 0
+        pivots: list[int] = []
+        for column in range(v):
+            pivot = None
+            for r in range(rank, len(matrix)):
+                operations += 1
+                if matrix[r][column]:
+                    pivot = r
+                    break
+            if pivot is None:
+                continue
+            matrix[rank], matrix[pivot] = matrix[pivot], matrix[rank]
+            for r in range(rank + 1, len(matrix)):
+                operations += 1
+                if matrix[r][column]:
+                    for c in range(column, v + 1):
+                        matrix[r][c] ^= matrix[rank][c]
+                        operations += 1
+            pivots.append(column)
+            rank += 1
+        for r in range(rank, len(matrix)):
+            operations += v + 1
+            if not any(matrix[r][:v]) and matrix[r][v]:
+                return {"success": False, "answer": None, "rank": rank,
+                        "operations": operations,
+                        "wall_clock_sec": time.perf_counter() - t0,
+                        "reason": "inconsistent recovered parity system"}
+        if rank != v:
+            return {"success": False, "answer": None, "rank": rank,
+                    "operations": operations,
+                    "wall_clock_sec": time.perf_counter() - t0,
+                    "reason": "recovered parity system is not full rank"}
+        solution = [0] * v
+        for r in range(rank - 1, -1, -1):
+            column = pivots[r]
+            value = matrix[r][v]
+            for c in range(column + 1, v):
+                value ^= matrix[r][c] & solution[c]
+                operations += 2
+            solution[column] = value
+        pairs, _ = _pair_data(inst)
+        answer = sorted(pairs[i][solution[i]] for i in range(v))
+        ok, reason = verify(inst, answer)
+        return {"success": ok, "answer": answer if ok else None, "rank": rank,
+                "operations": operations,
+                "wall_clock_sec": time.perf_counter() - t0, "reason": reason}
+    except (KeyError, TypeError, ValueError) as exc:
+        return {"success": False, "answer": None, "rank": 0,
+                "operations": 0, "wall_clock_sec": time.perf_counter() - t0,
+                "reason": f"decode failed: {exc}"}
+
+
+def _frequency_attack(inst: dict) -> list[int]:
+    counts = Counter(element for subset in inst["sets"] if len(subset) == 3
+                     for element in subset)
+    pairs, _ = _pair_data(inst)
+    return sorted(max(pair, key=lambda x: (counts[x], -x)) for pair in pairs)
+
+
+def _greedy_coverage_attack(inst: dict) -> list[int]:
+    pairs, _ = _pair_data(inst)
+    remaining = set(range(len(inst["sets"])))
+    selected: list[int] = []
+    ordered = sorted(
+        pairs,
+        key=lambda pair: -sum(pair[0] in subset or pair[1] in subset
+                              for subset in inst["sets"]),
+    )
+    for pair in ordered:
+        scores = [sum(element in inst["sets"][j] for j in remaining)
+                  for element in pair]
+        choice = pair[0] if scores[0] >= scores[1] else pair[1]
+        selected.append(choice)
+        remaining = {j for j in remaining if choice not in inst["sets"][j]}
+    return sorted(selected)
+
+
+def _one_pass_repair_attack(inst: dict) -> list[int]:
+    """Branch-free in-context heuristic: repair each first-seen unhit set once."""
+    pairs, element_map = _pair_data(inst)
+    chosen = {pair[0] for pair in pairs}
+    for subset in inst["sets"]:
+        if any(element in chosen for element in subset):
+            continue
+        candidates = []
+        for element in subset:
+            variable, _ = element_map[element]
+            old = pairs[variable][0] if pairs[variable][0] in chosen else pairs[variable][1]
+            # Prefer a flip that destroys the fewest currently singly hit sets.
+            damage = sum(
+                old in other and sum(x in chosen for x in other) == 1
+                for other in inst["sets"]
+            )
+            candidates.append((damage, element, old))
+        _, new, old = min(candidates)
+        chosen.remove(old)
+        chosen.add(new)
+    return sorted(chosen)
+
+
+def _wl_fingerprint(inst: dict) -> str:
+    """Strong cheap isomorphism invariant for the pair/set incidence structure."""
+    ground = inst["ground_size"]
+    sets = inst["sets"]
+    pair_nodes = [("p", i) for i in range(len(inst["pairs"]))]
+    set_nodes = [("s", i) for i in range(len(sets))]
+    element_nodes = [("e", i) for i in range(ground)]
+    nodes = element_nodes + pair_nodes + set_nodes
+    adjacency: dict[tuple[str, int], list[tuple[str, tuple[str, int]]]] = {
+        node: [] for node in nodes
+    }
+    for i, pair in enumerate(inst["pairs"]):
+        pnode = ("p", i)
+        for element in pair:
+            enode = ("e", element)
+            adjacency[pnode].append(("pair", enode))
+            adjacency[enode].append(("pair", pnode))
+    for i, subset in enumerate(sets):
+        snode = ("s", i)
+        for element in subset:
+            enode = ("e", element)
+            adjacency[snode].append(("inc", enode))
+            adjacency[enode].append(("inc", snode))
+    colors: dict[tuple[str, int], int] = {}
+    initial = {}
+    for node in nodes:
+        kind = node[0]
+        initial[node] = (kind, len(adjacency[node]))
+    palette = {signature: index for index, signature in
+               enumerate(sorted(set(initial.values()), key=repr))}
+    colors = {node: palette[signature] for node, signature in initial.items()}
+    for _ in range(len(nodes)):
+        signatures = {
+            node: (colors[node], tuple(sorted((edge, colors[other])
+                                              for edge, other in adjacency[node])))
+            for node in nodes
+        }
+        palette = {signature: index for index, signature in
+                   enumerate(sorted(set(signatures.values()), key=repr))}
+        new_colors = {node: palette[signature]
+                      for node, signature in signatures.items()}
+        if all(new_colors[node] == colors[node] for node in nodes):
+            colors = new_colors
+            break
+        colors = new_colors
+    records = sorted(
+        (node[0], colors[node], tuple(sorted((edge, colors[other])
+                                             for edge, other in adjacency[node])))
+        for node in nodes
+    )
+    return hashlib.sha256(json.dumps(records, separators=(",", ":")).encode()).hexdigest()
+
+
+def canonical_key(inst: dict) -> str:
+    """Relabeling-invariant WL key; never hashes seed, render, or answer."""
+    return "theorem2-wl-v1:" + _wl_fingerprint(inst)
+
+
+def _transformed_instance(inst: dict, seed: int) -> tuple[dict, list[int]]:
+    """Apply every declared input symmetry and carry the witness."""
+    rng = random.Random(seed)
+    ground = inst["ground_size"]
+    order = list(range(ground))
+    rng.shuffle(order)
+    mapping = {old: new for old, new in enumerate(order)}
+    changed = {k: v for k, v in inst.items() if k not in ("pairs", "sets", "answer")}
+    pairs = [[mapping[x] for x in pair] for pair in inst["pairs"]]
+    sets = [[mapping[x] for x in subset] for subset in inst["sets"]]
+    for pair in pairs:
+        rng.shuffle(pair)
+    for subset in sets:
+        rng.shuffle(subset)
+    rng.shuffle(pairs)
+    rng.shuffle(sets)
+    answer = sorted(mapping[x] for x in inst["answer"])
+    changed["pairs"] = pairs
+    changed["sets"] = sets
+    changed["answer"] = answer
+    return changed, answer
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow equation camouflage first, leaving the 70-label witness fixed."""
+    current = dict(params)
+    n = int(current.get("n", 70))
+    extra = int(current.get("extra_equations", 0))
+    if n < 70:
+        next_n = min(70, n + max(6, n // 4))
+        while next_n % 3 == 0:
+            next_n += 1
+        current["n"] = next_n
+        current["extra_equations"] = extra
+        return current
+    increment = max(70, extra or 70)
+    next_extra = extra + increment
+    if n + next_extra <= min(_maximum_equations(n), 1120):
+        current["extra_equations"] = next_extra
+        return current
+    return None
+
+
+def _answer_metrics(answer: object) -> tuple[int, int, int]:
+    wire = json.dumps(answer, separators=(",", ":"))
+    return len(wire), math.ceil(len(wire) / 4), len(answer)
+
+
+def selftest() -> dict:
+    """Run all nine mandatory gates and return their measured evidence."""
+    report: dict[str, Any] = {
+        "paper": "arXiv:2306.08594",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    failures = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                failures.append({"preset": preset, "seed": seed, "reason": reason})
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append({"preset": preset, "seed": seed,
+                                 "reason": "answer is not JSON-native"})
+    report["G1_planted_verifies"] = {
+        "pass": not failures, "attempts": attempts, "failures": failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=20260905, **ship_params)
+    original = list(inst["answer"])
+    swapped_order = list(original)
+    swapped_order[0], swapped_order[1] = swapped_order[1], swapped_order[0]
+    duplicated = list(original)
+    duplicated[1] = duplicated[0]
+    pairs, element_map = _pair_data(inst)
+    flipped = list(original)
+    old = flipped[0]
+    variable, _ = element_map[old]
+    flipped[0] = pairs[variable][0] if old == pairs[variable][1] else pairs[variable][1]
+    flipped.sort()
+    corruptions = {
+        "drop_one": verify(inst, original[:-1]),
+        "swap_order": verify(inst, swapped_order),
+        "duplicate_one": verify(inst, duplicated),
+        "empty": verify(inst, []),
+        "out_of_range": verify(inst, original[:-1] + [inst["ground_size"]]),
+        "flip_one_choice": verify(inst, flipped),
+    }
+    reasons = [reason for ok, reason in corruptions.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(not ok for ok, _ in corruptions.values())
+                and len(set(reasons)) == len(reasons),
+        "cases": {name: {"rejected": not result[0], "reason": result[1]}
+                  for name, result in corruptions.items()},
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    wire = json.dumps(original, separators=(",", ":"))
+    parsed = parse_answer(
+        "The parity blocks give the following set.\n```json\n"
+        f"<answer>{wire}</answer>\n```\nI checked every displayed subset."
+    )
+    report["G3_round_trip"] = {
+        "pass": parsed == original,
+        "surrounding_prose_and_markdown_fence": True,
+        "json_round_trip": parsed == original,
+    }
+
+    guess_rng = random.Random(0x230608594)
+    guess_total = 200_000
+    hits = 0
+    t0 = time.perf_counter()
+    hits = _sampled_guess_hits(inst, guess_rng, guess_total)
+    guess_seconds = time.perf_counter() - t0
+    space = search_space(inst)
+    report["G4_guess_resistance"] = {
+        "pass": hits / guess_total < 1e-6,
+        "hits": hits,
+        "total": guess_total,
+        "empirical_probability": hits / guess_total,
+        "candidate_space": space,
+        "candidate_space_log10": math.log10(space),
+        "prior": (
+            "uniform over the exact one-label-per-disjoint-pair language, with "
+            "range, length, uniqueness, and sorting enforced before sampling"
+        ),
+        "sampling_wall_seconds": guess_seconds,
+    }
+
+    baseline = _gaussian_reference(inst)
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": hits / guess_total < 1e-6 and demo_count == 1
+                and baseline["success"],
+        "shipping_observed_valid_fraction": hits / guess_total,
+        "shipping_density_sample_count": guess_total,
+        "shipping_valid_hits": hits,
+        "shipping_candidate_space": space,
+        "enumerate_all_shipping": None,
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "strongest_attack": "exact GF(2) Gaussian elimination",
+        "strongest_attack_wall_seconds": baseline["wall_clock_sec"],
+        "strongest_attack_operations": baseline["operations"],
+        "strongest_attack_rank": baseline["rank"],
+        "strongest_attack_success": baseline["success"],
+    }
+
+    attack_names = [
+        "outlier_literal_frequency",
+        "greedy_marginal_coverage",
+        "random_restart_256_structure_aware",
+        "one_pass_unhit_set_repair",
+    ]
+    successes = {name: 0 for name in attack_names}
+    references = []
+    for seed in range(100, 108):
+        trial = make_instance(seed=seed, **ship_params)
+        successes["outlier_literal_frequency"] += int(
+            verify(trial, _frequency_attack(trial))[0]
+        )
+        successes["greedy_marginal_coverage"] += int(
+            verify(trial, _greedy_coverage_attack(trial))[0]
+        )
+        rrng = random.Random(seed ^ 0xA11CE)
+        restart_hit = any(
+            verify(trial, random_candidate(trial, rrng))[0] for _ in range(256)
+        )
+        successes["random_restart_256_structure_aware"] += int(restart_hit)
+        successes["one_pass_unhit_set_repair"] += int(
+            verify(trial, _one_pass_repair_attack(trial))[0]
+        )
+        references.append(_gaussian_reference(trial))
+    all_failed = all(value == 0 for value in successes.values())
+    all_reference_solved = all(result["success"] for result in references)
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and all_reference_solved,
