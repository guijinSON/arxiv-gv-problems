   367	def _decode_candidate(inst, answer):
   368	    """Return local value positions, or an exact public failure reason."""
   369	    if not isinstance(answer, list):
   370	        return None, "answer must be a JSON list"
   371	    if not answer:
   372	        return None, "answer is empty"
   373	    expected = inst["group_count"] + 3
   374	    if len(answer) != expected:
   375	        return None, f"wrong answer length: expected {expected}, got {len(answer)}"
   376	    if answer[:3] != ["a", "b", "c"]:
   377	        return None, 'the mandatory prefix must be ["a","b","c"]'
   378	    tail = answer[3:]
   379	    if len(set(tail)) != len(tail):
   380	        return None, "ground vertex labels must be distinct"
   381	
   382	    positions = []
   383	    for i, label in enumerate(tail):
   384	        if not _is_int(label) or not 1 <= label <= inst["ground_count"]:
   385	            return None, f"entry {i + 3} is not an integer ground vertex"
   386	        if inst["label_group"][label] != i:
   387	            return None, f"entry {i + 3} does not belong to required group G_{i}"
   388	        positions.append(inst["label_position"][label])
   389	    return positions, "ok"
