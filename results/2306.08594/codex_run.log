+                if other[0] == other[1] and other[0] in (1, 2):
+                    allowed = masks[j] if other[0] == 1 else (qmask ^ masks[j])
+                    group_index = groups[j]
+                    new_domain = domains[group_index] & allowed
+                    if not new_domain:
+                        return False
