+            "wall_clock_sec": sum(x["wall_clock_sec"] for x in references),
+            "operations": sum(x["operations"] for x in references),
+            "per_instance_operations_min": min(x["operations"] for x in references),
+            "per_instance_operations_max": max(x["operations"] for x in references),
+            "solves": f"{sum(int(x['success']) for x in references)}/8, as expected",
+        },
+    }
+
+    doubled_params = dict(ship_params)
+    doubled_params["extra_equations"] = (
+        ship_params["n"] + 2 * ship_params["extra_equations"]
+    )
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["equation_count"] == 2 * inst["equation_count"],
+        "base_size_parameter_equations": inst["equation_count"],
+        "doubled_size_parameter_equations": doubled["equation_count"],
+        "answer_elements_unchanged": len(doubled["answer"]) == len(original),
+        "base_render_chars": len(render(inst)),
+        "doubled_render_chars": len(render(doubled)),
+        "doubled_verify": doubled_reason,
+    }
+
+    invariance_checks = 0
+    witness_checks = 0
+    for seed in range(20):
+        base = make_instance(n=13, extra_equations=4, seed=seed)
+        changed, carried = _transformed_instance(base, seed ^ 0xC0110)
+        invariance_checks += int(canonical_key(base) == canonical_key(changed))
+        witness_checks += int(verify(changed, carried)[0])
+        changed2, carried2 = _transformed_instance(changed, seed ^ 0xB04AD)
+        invariance_checks += int(canonical_key(base) == canonical_key(changed2))
+        witness_checks += int(verify(changed2, carried2)[0])
+    keys = {canonical_key(make_instance(n=13, extra_equations=4,
+                                        seed=1000 + seed))
+            for seed in range(20)}
+    report["G8_canonical_key"] = {
+        "pass": invariance_checks == 40 and witness_checks == 40 and len(keys) == 20,
+        "invariance_checks": invariance_checks,
+        "invariance_attempts": 40,
+        "transformed_witness_checks": witness_checks,
