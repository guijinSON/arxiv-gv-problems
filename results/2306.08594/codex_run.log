    "intuition": PROBLEM_PROFILE["intuition_type"] + ": " + PROBLEM_PROFILE["intuition_description"],
    "reduction": PROBLEM_PROFILE["reduction"],
}

# n is not divisible by 3, so the cyclic window matrix is nonsingular over GF(2).
DIFFICULTY = {
