   645	def _attack_min_conflicts(inst, rng, restarts=64, steps_per_restart=None):
   646	    q = inst["value_count"]
   647	    g = inst["group_count"]
   648	    if steps_per_restart is None:
   649	        steps_per_restart = 20 * g
   650	    constraints = inst["constraints"]
   651	    local_constraints = _local_masks(inst)
   652	    by_group = [[] for _ in range(g)]
   653	    for local in local_constraints:
   654	        for group_index in local[0]:
   655	            by_group[group_index].append(local)
   656	    for _ in range(restarts):
   657	        positions = [rng.randrange(q) for _ in range(g)]
   658	        for _step in range(steps_per_restart):
   659	            violated = [
   660	                constraint
   661	                for constraint in constraints
   662	                if (lambda bits: bits[0] == bits[1] == bits[2])(
   663	                    _constraint_bits(inst, positions, constraint)
   664	                )
   665	            ]
   666	            if not violated:
   667	                return _positions_to_answer(inst, positions)
   668	            constraint = rng.choice(violated)
   669	            group_index = rng.choice(constraint["groups"])
   670	            scores = []
   671	            for value in range(q):
   672	                old = positions[group_index]
   673	                positions[group_index] = value
   674	                scores.append((
   675	                    _local_violation_count(by_group[group_index], positions),
   676	                    rng.random(),
   677	                    value,
   678	                ))
   679	                positions[group_index] = old
   680	            positions[group_index] = min(scores)[2]
   681	    return _positions_to_answer(inst, positions)
