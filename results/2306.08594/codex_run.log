+def _violation_count(inst, positions):
+    return sum(
+        1
+        for constraint in inst["constraints"]
+        if (lambda bits: bits[0] == bits[1] == bits[2])(
+            _constraint_bits(inst, positions, constraint)
+        )
+    )
