+            scores = []
+            for value in range(q):
+                old = positions[group_index]
+                positions[group_index] = value
+                scores.append((_violation_count(inst, positions), rng.random(), value))
+                positions[group_index] = old
+            positions[group_index] = min(scores)[2]
