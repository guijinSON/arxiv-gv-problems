    print("SHIPPING_DIFFICULTY FAIL: must be easy, medium or hard (never demo):",
          repr(getattr(m,"SHIPPING_DIFFICULTY",None))); sys.exit(1)
i=m.make_instance(**D[m.SHIPPING_DIFFICULTY], seed=0)
ok,why=m.verify(i, i["answer"])
