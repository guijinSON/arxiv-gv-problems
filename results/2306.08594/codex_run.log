   748	        nonlocal nodes, exhausted, solution
   749	        if nodes >= node_budget:
   750	            exhausted = True
   751	            return False
   752	        nodes += 1
   753	        domains = list(domains)
   754	        if not _propagate_domains(domains, local_constraints):
   755	            return False
   756	        choices = [
   757	            (domain.bit_count(), i)
   758	            for i, domain in enumerate(domains)
