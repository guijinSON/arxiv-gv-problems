   684	def _local_masks(inst):
   685	    maps = [
   686	        {label: position for position, label in enumerate(group)}
   687	        for group in inst["groups"]
   688	    ]
   689	    local = []
   690	    qmask = (1 << inst["value_count"]) - 1
   691	    for constraint in inst["constraints"]:
   692	        masks = []
   693	        for group_index, plus in zip(constraint["groups"], constraint["plus"]):
   694	            mask = 0
   695	            for label in plus:
   696	                mask |= 1 << maps[group_index][label]
   697	            masks.append(mask)
   698	        local.append((tuple(constraint["groups"]), tuple(masks), qmask))
   699	    return local
