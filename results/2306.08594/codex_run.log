+                    bits = _constraint_bits(inst, positions, constraint)
+                    bad += int(bits[0] == bits[1] == bits[2])
+            scored.append((bad, value))
+        positions[group_index] = min(scored)[1]
+    return _positions_to_answer(inst, positions)
 
 
