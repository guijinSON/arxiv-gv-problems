+def _attack_min_conflicts(inst, rng, restarts=8, steps_per_restart=None):
+    q = inst["value_count"]
+    g = inst["group_count"]
+    if steps_per_restart is None:
+        steps_per_restart = 2 * g
+    constraints = inst["constraints"]
+    local_constraints = _local_masks(inst)
+    for _ in range(restarts):
