+        "greedy_orbit_values_as_coefficients": [_poly_terms(greedy_values)],
+        "unscaled_fermat_ansatz": [_poly_terms(unscaled)],
+        "by_hand_linear_ansatz": [_poly_terms(linear)],
+        "random_restart_256": restarts,
