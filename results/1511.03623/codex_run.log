+
+def _worst_case_answer(inst: dict) -> object:
+    p = inst["p"]
+    return [[p - 1, [exponent]] for exponent in range(p - 1)]
+
+
+def _intended_operations(inst: dict) -> int:
+    p = inst["p"]
+    # mu=lambda*a; one multiplication per coefficient; one negation for odd e.
+    return 1 + (p - 1) + (p - 1) // 2
