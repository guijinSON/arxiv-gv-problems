+    p = inst["p"]
+    scale = inst["orbit_scale"]
+    shift = inst["orbit_shift"]
+    target = inst["target"]
+    values: dict[int, int] = {}
+
+    def orbit_value(ell: int) -> int:
+        if ell not in values:
+            z_value = (scale * ell + shift) % p
+            values[ell] = _evaluate(coefficients, z_value, p)
+        return values[ell]
