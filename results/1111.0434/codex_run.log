+    cycles = 0
+    for start in range(len(permutation)):
+        if seen[start]:
+            continue
+        cycles += 1
+        at = start
+        while not seen[at]:
+            seen[at] = True
+            at = permutation[at] - 1
+    return (len(permutation) - cycles) & 1
