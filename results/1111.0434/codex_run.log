+        "word of prefix reversals",
+        "rank breakpoints",
+    ],
+    "verification_operations": [
+        "exact prefix reversal replay",
+        "integer comparison",
+        "permutation parity check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
