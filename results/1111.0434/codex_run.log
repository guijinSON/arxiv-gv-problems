+
+# Filled after the three script-owned oracle runs.  These are diagnostics under
+# the current protocol; only the answer/operation caps gate G9.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _rank_permutation(stack):
+    """Return the 1..n rank of each distinct displayed pancake size."""
+    ordered = sorted(stack)
+    if len(set(ordered)) != len(ordered):
+        raise ValueError("pancake sizes must be distinct")
+    rank = {value: i + 1 for i, value in enumerate(ordered)}
+    return [rank[value] for value in stack]
+
+
+def _breakpoint_count(permutation):
+    """The paper's db: internal non-adjacencies plus a wrong bottom rank."""
+    if not permutation:
+        return 0
+    return sum(
+        abs(left - right) != 1
+        for left, right in zip(permutation, permutation[1:])
+    ) + (permutation[-1] != len(permutation))
+
+
+def _breakpoint_delta(permutation, length):
+    """Change in db caused by one prefix reversal, in O(1)."""
+    n = len(permutation)
+    if length == n:
+        return int(permutation[0] != n) - int(permutation[-1] != n)
+    old_boundary = abs(permutation[length - 1] - permutation[length]) != 1
+    new_boundary = abs(permutation[0] - permutation[length]) != 1
+    return int(new_boundary) - int(old_boundary)
+
+
+def _draw_scramble(n, max_flips, target_breakpoints, neutral_weight, rng):
+    """Compose a reduced +1/0-breakpoint word without solving any instance."""
+    for _attempt in range(128):
+        permutation = list(range(1, n + 1))
+        word = []
+        remaining = {1: target_breakpoints, 0: max_flips - target_breakpoints}
+
+        for _step in range(max_flips):
+            available = {}
+            for change in (0, 1):
+                if remaining[change] == 0:
+                    continue
+                choices = [
+                    length
+                    for length in range(2, n + 1)
+                    if (not word or length != word[-1])
+                    and _breakpoint_delta(permutation, length) == change
+                ]
+                if choices:
+                    available[change] = choices
+
+            if not available:
+                break
+
+            weights = {
+                change: remaining[change]
+                * (neutral_weight if change == 0 else 1)
+                for change in available
+            }
+            ticket = rng.randrange(sum(weights.values()))
+            chosen_change = None
+            for change in sorted(available):
+                if ticket < weights[change]:
+                    chosen_change = change
+                    break
+                ticket -= weights[change]
+            assert chosen_change is not None
+
+            length = rng.choice(available[chosen_change])
+            permutation[:length] = reversed(permutation[:length])
+            word.append(length)
+            remaining[chosen_change] -= 1
+        else:
+            if remaining == {0: 0, 1: 0}:
+                assert _breakpoint_count(permutation) == target_breakpoints
+                return permutation, list(reversed(word))
+
+    raise RuntimeError("could not draw the prescribed inverse prefix-reversal walk")
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a bounded sorting word, then hide ranks as exact sizes."""
+    max_flips = params.pop("max_flips", n)
+    target_breakpoints = params.pop("target_breakpoints", max(2, 2 * n // 3))
+    neutral_weight = params.pop("neutral_weight", 1)
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    for name, value in (
+        ("n", n),
+        ("max_flips", max_flips),
+        ("target_breakpoints", target_breakpoints),
+        ("neutral_weight", neutral_weight),
+    ):
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise TypeError(f"{name} must be an integer")
+    if n < 4:
+        raise ValueError("n must be at least 4")
+    if not 2 <= target_breakpoints <= max_flips:
+        raise ValueError("require 2 <= target_breakpoints <= max_flips")
+    if target_breakpoints >= n:
+        raise ValueError("target_breakpoints must be smaller than n")
+    if max_flips > 240:
+        raise ValueError("max_flips exceeds this family's writable-answer limit")
+    if neutral_weight < 1:
+        raise ValueError("neutral_weight must be positive")
+
+    rng = random.Random(seed)
+    rank_stack, answer = _draw_scramble(
+        n, max_flips, target_breakpoints, neutral_weight, rng
+    )
+
+    # Any strictly increasing replacement of ranks is the same physical stack.
+    # Independent random gaps prevent raw magnitude gaps from marking flip cuts.
+    sizes_by_rank = []
+    value = rng.randrange(-1_000_000, 1_000_001)
+    for _ in range(n):
+        value += rng.randrange(2, 20)
+        sizes_by_rank.append(value)
+    stack = [sizes_by_rank[rank - 1] for rank in rank_stack]
+
+    return {
+        "n": n,
+        "stack": stack,
+        "max_flips": max_flips,
+        "breakpoints": target_breakpoints,
+        "neutral_weight": neutral_weight,
+        "answer": answer,
+    }
+
+
+def render(inst):
+    """Return the complete standalone statement and output contract."""
+    stack = ", ".join(map(str, inst["stack"]))
+    hint = ""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        hint = "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        hint = "\n\nHint: " + PLACEBO_HINT
+
+    return f"""Bounded pancake sorting by prefix reversals
+
+A stack contains {inst['n']} pancakes of distinct integer sizes.  It is written
+from top to bottom.  A prefix reversal of length k reverses exactly the first k
+pancakes; k is an integer and 2 <= k <= {inst['n']}.  The goal is the unique
+increasing top-to-bottom order (smallest pancake first).
+
+Find a sequence of at most {inst['max_flips']} prefix reversals that sorts this
+stack.  Consecutive reversals must have different lengths; immediate duplicate
+flips are forbidden.  Apply the listed lengths from left to right.  Repeated
+lengths are otherwise allowed, and order matters.
+
+For clarity, the rank of a pancake is its position after sorting, from rank 1
+(smallest) through rank {inst['n']} (largest).  A rank breakpoint is either an
+adjacent pair whose ranks do not differ by 1, or the bottom position when the
+bottom pancake does not have rank {inst['n']}.  This stack has exactly
+{inst['breakpoints']} rank breakpoints, so no sorting sequence can use fewer
+than {inst['breakpoints']} flips.
+
+Initial stack, top to bottom:
+[{stack}]
+{hint}
+
+Give your final answer inside <answer></answer> tags, as one JSON-style
+comma-separated list of between {inst['breakpoints']} and {inst['max_flips']}
+integer prefix lengths, in execution order.
+Example of the syntax: <answer>[4, 7, 3]</answer>
+Output nothing else inside the tags."""
+
+
+_ANSWER_RE = re.compile(
+    r"<answer\b[^>]*>(.*?)</answer\s*>", re.IGNORECASE | re.DOTALL
+)
+_RAW_LIST_RE = re.compile(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*")
+
+
+def parse_answer(text):
+    """Parse the last tagged integer list, tolerating prose and code fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```") and body.endswith("```"):
+        lines = body.splitlines()
+        if len(lines) < 2:
+            return None
+        body = "\n".join(lines[1:-1]).strip()
+    try:
+        if body.startswith("[") and body.endswith("]"):
+            value = json.loads(body)
+        elif _RAW_LIST_RE.fullmatch(body):
+            value = [int(part.strip()) for part in body.split(",")]
+        else:
+            return None
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(value, list):
+        return None
+    if any(isinstance(item, bool) or not isinstance(item, int) for item in value):
+        return None
+    return value
+
+
+def _flip_parity(length):
+    """Parity of reversing length items: C(length,2) modulo two."""
+    return (length * (length - 1) // 2) & 1
+
+
+def _permutation_parity(permutation):
+    seen = [False] * len(permutation)
+    cycles = 0
+    for start in range(len(permutation)):
+        if seen[start]:
+            continue
+        cycles += 1
+        at = start
+        while not seen[at]:
+            seen[at] = True
+            at = permutation[at] - 1
+    return (len(permutation) - cycles) & 1
+
+
+def verify(inst, answer):
+    """Replay any legal candidate word; never consult inst['answer']."""
+    if not isinstance(answer, (list, tuple)):
+        return False, "answer must be a list of prefix lengths"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) < inst["breakpoints"]:
+        return False, "fewer flips than the rank-breakpoint lower bound"
+    if len(answer) > inst["max_flips"]:
+        return False, "too many prefix reversals"
+    if any(isinstance(length, bool) or not isinstance(length, int) for length in answer):
+        return False, "every prefix length must be an integer"
+    if any(length < 2 or length > inst["n"] for length in answer):
+        return False, f"a prefix length is outside 2..{inst['n']}"
+    if any(left == right for left, right in zip(answer, answer[1:])):
+        return False, "consecutive prefix lengths must differ"
+
+    permutation = _rank_permutation(inst["stack"])
+    needed_parity = _permutation_parity(permutation)
+    supplied_parity = 0
+    for length in answer:
+        supplied_parity ^= _flip_parity(length)
+    if supplied_parity != needed_parity:
+        return False, "wrong total reversal parity"
+
+    work = list(inst["stack"])
+    for length in answer:
+        work[:length] = reversed(work[:length])
+    target = sorted(work)
+    if work != target:
+        mismatch = next(i for i, (got, want) in enumerate(zip(work, target)) if got != want)
+        return (
+            False,
+            f"sequence does not sort: first mismatch at position {mismatch}",
+        )
+    return True, "ok"
+
+
+@functools.lru_cache(maxsize=None)
+def _flip_catalog(n):
+    even = tuple(length for length in range(2, n + 1) if _flip_parity(length) == 0)
+    odd = tuple(length for length in range(2, n + 1) if _flip_parity(length) == 1)
+    return even, odd
+
+
+@functools.lru_cache(maxsize=None)
+def _suffix_count(n, remaining, previous_category, needed_parity):
+    """Count reduced parity-constrained suffixes after a previous flip class."""
+    if remaining == 0:
+        return int(needed_parity == 0)
+    catalogs = _flip_catalog(n)
+    total = 0
+    for category in (0, 1):
+        choices = len(catalogs[category]) - int(previous_category == category)
+        if choices:
+            total += choices * _suffix_count(
+                n, remaining - 1, category, needed_parity ^ category
+            )
+    return total
+
+
+def search_space(inst):
+    """Exact size of the structure-aware bounded certificate language."""
+    parity = _permutation_parity(_rank_permutation(inst["stack"]))
+    return sum(
+        _suffix_count(inst["n"], length, 2, parity)
+        for length in range(inst["breakpoints"], inst["max_flips"] + 1)
+    )
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample reduced words obeying bounds and the forced parity."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    n = inst["n"]
+    parity = _permutation_parity(_rank_permutation(inst["stack"]))
+    weighted_lengths = [
+        (length, _suffix_count(n, length, 2, parity))
+        for length in range(inst["breakpoints"], inst["max_flips"] + 1)
+    ]
+    ticket = rng.randrange(sum(count for _, count in weighted_lengths))
+    length = None
+    for candidate_length, count in weighted_lengths:
+        if ticket < count:
+            length = candidate_length
+            break
+        ticket -= count
+    assert length is not None
+
+    word = []
+    previous_category = 2
+    needed = parity
+    catalogs = _flip_catalog(n)
+    for position in range(length):
+        remaining = length - position - 1
+        category_weights = []
+        for category in (0, 1):
+            count_choices = len(catalogs[category]) - int(
+                previous_category == category
+            )
+            weight = count_choices * _suffix_count(
+                n, remaining, category, needed ^ category
+            )
+            category_weights.append(weight)
+        ticket = rng.randrange(sum(category_weights))
+        category = 0 if ticket < category_weights[0] else 1
+        choices = catalogs[category]
+        chosen = rng.choice(choices)
+        while word and chosen == word[-1]:
+            chosen = rng.choice(choices)
+        word.append(chosen)
+        previous_category = category
+        needed ^= category
+    assert needed == 0
+    return word
+
+
+def enumerate_all(inst):
+    """Count valid witnesses exactly only when a capped raw enumeration fits."""
+    n = inst["n"]
+    raw = sum(
+        (n - 1) ** length
+        for length in range(inst["breakpoints"], inst["max_flips"] + 1)
+    )
+    if raw > 250_000:
+        return None
+    count = 0
+    for length in range(inst["breakpoints"], inst["max_flips"] + 1):
+        for word in itertools.product(range(2, n + 1), repeat=length):
+            if any(a == b for a, b in zip(word, word[1:])):
+                continue
+            ok, _ = verify(inst, word)
+            count += int(ok)
+    return count
+
+
+def canonical_key(inst):
+    """Rank-normal form, invariant under every order-preserving size relabeling."""
+    payload = {
+        "rank_stack": _rank_permutation(inst["stack"]),
+        "max_flips": inst["max_flips"],
+        "breakpoints": inst["breakpoints"],
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(blob).hexdigest()
+
+
+def escalate(params):
+    """Increase branching/crowding first while keeping the 80-flip answer fixed."""
+    harder = dict(params)
+    n = int(harder["n"])
+    max_flips = int(harder["max_flips"])
+    target = int(harder["target_breakpoints"])
+    weight = int(harder.get("neutral_weight", 1))
+
+    if max_flips < 80:
+        # Named rungs normally consume this axis before escalate is called.
+        new_max = min(80, max_flips + 10)
+        harder["max_flips"] = new_max
+        harder["n"] = max(n + 12, new_max)
+        harder["target_breakpoints"] = min(
+            harder["n"] - 1, target + max(4, (new_max - max_flips) // 2)
+        )
+        harder["neutral_weight"] = weight + 1
+        return harder
+    if n < 420:
+        # Fixed-length axes: more possible cut locations and earlier neutral
+        # mixing enlarge the haystack without lengthening the certificate.
+        harder["n"] = min(420, math.ceil(n * 1.45))
+        harder["neutral_weight"] = weight + 1
+        return harder
+    if target > 36:
+        # More slack admits more non-improving branches, still at 80 outputs.
+        harder["target_breakpoints"] = target - 2
+        harder["neutral_weight"] = weight + 1
+        return harder
+    return "cap_bound"
+
+
+def _normalise_for_attack(inst):
+    return _rank_permutation(inst["stack"])
+
+
+def _attack_boundary_gap(inst):
+    """Greedily choose a locally best flip, breaking ties by displayed gap."""
+    permutation = _normalise_for_attack(inst)
+    displayed = list(inst["stack"])
+    goal = list(range(1, inst["n"] + 1))
+    path = []
+    while len(path) < inst["max_flips"] and permutation != goal:
+        remaining_after = inst["max_flips"] - len(path) - 1
+        candidates = []
+        for length in range(2, inst["n"] + 1):
+            if path and path[-1] == length:
+                continue
+            delta = _breakpoint_delta(permutation, length)
+            if _breakpoint_count(permutation) + delta > remaining_after:
+                continue
+            gap = (
+                abs(displayed[length - 1] - displayed[length])
+                if length < inst["n"]
+                else 0
+            )
+            candidates.append((delta, -gap, length))
+        if not candidates:
+            break
+        _, _, length = min(candidates)
+        permutation[:length] = reversed(permutation[:length])
+        displayed[:length] = reversed(displayed[:length])
+        path.append(length)
+    return path
+
+
+def _attack_largest_first(inst):
+    """The elementary polynomial pancake-sort algorithm."""
+    permutation = _normalise_for_attack(inst)
+    path = []
+    for wanted in range(inst["n"], 1, -1):
+        position = permutation.index(wanted)
+        if position == wanted - 1:
+            continue
+        if position:
+            permutation[: position + 1] = reversed(permutation[: position + 1])
+            path.append(position + 1)
+        permutation[:wanted] = reversed(permutation[:wanted])
+        path.append(wanted)
+    return path
+
+
+def _attack_random_restarts(inst, seed, restarts=64):
+    """Randomized breakpoint-aware walks under the advertised length bound."""
+    rng = random.Random(seed)
+    start = _normalise_for_attack(inst)
+    goal = list(range(1, inst["n"] + 1))
+    for _ in range(restarts):
+        permutation = list(start)
+        path = []
+        for _step in range(inst["max_flips"]):
+            if permutation == goal:
+                return path
+            remaining_after = inst["max_flips"] - len(path) - 1
+            current_b = _breakpoint_count(permutation)
+            moves = []
+            for length in range(2, inst["n"] + 1):
+                if path and path[-1] == length:
+                    continue
+                delta = _breakpoint_delta(permutation, length)
+                if current_b + delta <= remaining_after:
+                    moves.append((delta, rng.random(), length))
+            if not moves:
+                break
+            moves.sort()
+            width = max(2, len(moves) // 8)
+            _, _, length = rng.choice(moves[:width])
+            permutation[:length] = reversed(permutation[:length])
+            path.append(length)
+        if permutation == goal:
+            return path
+    return None
+
+
+def _ida_breakpoint(inst, node_cap=200_000):
+    """IDA* with the paper's breakpoint lower bound and transposition pruning."""
+    start = tuple(_normalise_for_attack(inst))
+    goal = tuple(range(1, inst["n"] + 1))
+    initial_b = _breakpoint_count(start)
+    nodes = 0
+    exhausted = False
+    found_depth = None
+
+    def visit(state, breakpoints, remaining, previous, seen):
+        nonlocal nodes, exhausted
+        nodes += 1
+        if nodes > node_cap:
+            exhausted = True
+            return None
+        if state == goal:
+            return []
+        if remaining == 0 or breakpoints > remaining:
+            return None
+        key = (state, previous)
+        if seen.get(key, -1) >= remaining:
+            return None
+        seen[key] = remaining
+
+        moves = []
+        state_list = list(state)
+        for length in range(2, inst["n"] + 1):
+            if length == previous:
+                continue
+            delta = _breakpoint_delta(state_list, length)
+            if breakpoints + delta <= remaining - 1:
+                moves.append((delta, length))
+        moves.sort()
+        for delta, length in moves:
+            child = tuple(reversed(state[:length])) + state[length:]
+            suffix = visit(
+                child, breakpoints + delta, remaining - 1, length, seen
+            )
+            if suffix is not None:
+                return [length] + suffix
+            if exhausted:
+                return None
+        return None
+
+    path = None
