+    word = []
+    while len(word) < inst["breakpoints"]:
+        choices = _efficient_lengths(permutation, word[-1] if word else 0)
+        if not choices:
+            break
+        length = rng.choice(choices)
+        permutation[:length] = reversed(permutation[:length])
+        word.append(length)
+    if len(word) == inst["breakpoints"]:
