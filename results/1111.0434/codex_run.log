+
+
+@functools.lru_cache(maxsize=None)
+def _flip_catalog(n):
+    even = tuple(length for length in range(2, n + 1) if _flip_parity(length) == 0)
+    odd = tuple(length for length in range(2, n + 1) if _flip_parity(length) == 1)
+    return even, odd
+
+
+@functools.lru_cache(maxsize=None)
+def _suffix_count(n, remaining, previous_category, needed_parity):
+    """Count reduced parity-constrained suffixes after a previous flip class."""
+    if remaining == 0:
+        return int(needed_parity == 0)
+    catalogs = _flip_catalog(n)
+    total = 0
+    for category in (0, 1):
+        choices = len(catalogs[category]) - int(previous_category == category)
+        if choices:
+            total += choices * _suffix_count(
+                n, remaining - 1, category, needed_parity ^ category
+            )
+    return total
+
+
+def search_space(inst):
+    """Exact size of the structure-aware bounded certificate language."""
+    parity = inst.get("permutation_parity")
+    if parity is None:
+        parity = _permutation_parity(_rank_permutation(inst["stack"]))
+    return sum(
+        _suffix_count(inst["n"], length, 2, parity)
+        for length in range(inst["breakpoints"], inst["max_flips"] + 1)
+    )
+
+
+def random_candidate(inst, rng):
+    """Sample a solver-prior word obeying bounds, reduction, and forced parity.
+
+    Length is uniform over the explicitly allowed interval rather than weighted
+    by the number of words at each length.  That deliberately gives the short,
+    potentially easier witnesses much more mass than uniform sampling from the
+    union would, so it is conservative for the guessing gate.
+    """
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    n = inst["n"]
+    parity = inst.get("permutation_parity")
+    if parity is None:
+        parity = _permutation_parity(_rank_permutation(inst["stack"]))
+    while True:
+        length = rng.randint(inst["breakpoints"], inst["max_flips"])
+        # One big uniform draw encodes the whole reduced word.  The first digit
+        # has radix n-1; each later digit has radix n-2 and indexes all symbols
+        # except its predecessor.  This is exactly uniform at the chosen length
+        # and is much cheaper than making one RNG call per symbol.
+        encoded = rng.randrange((n - 1) * (n - 2) ** (length - 1))
+        first_digit, encoded = encoded % (n - 1), encoded // (n - 1)
+        word = [first_digit + 2]
+        for _ in range(1, length):
+            digit, encoded = encoded % (n - 2), encoded // (n - 2)
+            chosen = digit + 2
+            if chosen >= word[-1]:
+                chosen += 1
+            word.append(chosen)
+        supplied = 0
+        for chosen in word:
+            supplied ^= _flip_parity(chosen)
+        if supplied == parity:
+            return word
