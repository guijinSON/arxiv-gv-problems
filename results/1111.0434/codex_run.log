+        wanted = _flip_parity(word[-1]) ^ 1
+        replacements = [
+            value
+            for value in _flip_catalog(inst["n"])[wanted]
+            if len(word) == 1 or value != word[-2]
+        ]
+        word[-1] = rng.choice(replacements)
+    return word
