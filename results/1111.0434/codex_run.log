This is a direct application of Property~\ref{prop:variable}.a on variable $(\nu_{r+1},V_{r+1},D_{r+1})$, using sequences:
\begin{align*}
 X&=\row{
\nu_{r+2},\ldots,\nu_l,
\gamma_1,\ldots,\gamma_k,
V_1',\ldots,V_r'} \\
Y&=\row{
V_{r+2},\ldots,V_l,
\Gamma_1,\ldots,\Gamma_k,
D_1,\ldots,D_l,
\Delta_1,\ldots,\Delta_k}
\end{align*}
\end{proof}

