+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A nonempty reduced word of between db(stack) and max_flips prefix "
+        "lengths; every length is an integer in [2,n], adjacent lengths differ, "
+        "and the xor of reversal parities equals the stack permutation parity."
+    ),
+    "bounds": {
