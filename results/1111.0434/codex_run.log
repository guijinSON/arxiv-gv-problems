\subprop b \mbox{If } a,c\in O ,\mbox{ then }\ \ \fstackrow{ \Gamma^2\n Y\n
 \Delta\n Z\n \biglambda{C}{O}{I} } 
&\path &
\fstackrow{Y \n \ident{p+1}{p+62}\n Z\n \biglambda{C}{O-\{a,c\}}{I\cup\{a,c\}} } \\
\subprop c \mbox{If } a,b\in O ,\mbox{ then }\ \ \fstackrow{ \Gamma^3\n Y\n
 \Delta\n Z\n \biglambda{C}{O}{I} } 
&\path &
\fstackrow{Y \n \ident{p+1}{p+62}\n Z\n \biglambda{C}{O-\{a,b\}}{I\cup\{a,b\}} } 
\end{eqnarray*}
\end{property}

