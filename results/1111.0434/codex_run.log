+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+# n is the number of pancakes.  max_flips bounds the witness length, and
+# target_breakpoints fixes the paper's elementary lower bound.  neutral_weight
+# crowds breakpoint-preserving moves earlier in the inverse walk without making
+# the answer longer.
+DIFFICULTY = {
+    "demo": {
+        "n": 6,
+        "max_flips": 5,
+        "target_breakpoints": 3,
+        "neutral_weight": 1,
+    },
+    "easy": {
+        "n": 60,
+        "max_flips": 60,
+        "target_breakpoints": 40,
+        "neutral_weight": 1,
+    },
+    "medium": {
+        "n": 70,
+        "max_flips": 70,
+        "target_breakpoints": 45,
+        "neutral_weight": 2,
+    },
+    "hard": {
+        "n": 80,
+        "max_flips": 80,
+        "target_breakpoints": 50,
+        "neutral_weight": 3,
+    },
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The useful invariant is the rank-breakpoint count, and a bounded route may "
+    "contain both count-preserving and count-decreasing prefix reversals."
+)
+
+PLACEBO_HINT = (
+    "The useful discipline is careful indexing, and a submitted route must list "
