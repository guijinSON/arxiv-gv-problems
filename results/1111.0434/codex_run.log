+def _ida_breakpoint(inst, node_cap=50_000):
+    """IDA* with the paper's breakpoint lower bound and transposition pruning."""
+    start = tuple(_normalise_for_attack(inst))
+    goal = tuple(range(1, inst["n"] + 1))
+    initial_b = _breakpoint_count(start)
+    nodes = 0
+    exhausted = False
+    found_depth = None
+
+    def visit(state, breakpoints, remaining, previous, seen):
+        nonlocal nodes, exhausted
+        nodes += 1
+        if nodes > node_cap:
+            exhausted = True
+            return None
+        if state == goal:
+            return []
+        if remaining == 0 or breakpoints > remaining:
+            return None
+        key = (state, previous)
+        if seen.get(key, -1) >= remaining:
+            return None
+        seen[key] = remaining
+
+        moves = []
+        state_list = list(state)
+        for length in range(2, inst["n"] + 1):
+            if length == previous:
+                continue
+            delta = _breakpoint_delta(state_list, length)
+            if breakpoints + delta <= remaining - 1:
+                moves.append((delta, length))
+        moves.sort()
+        for delta, length in moves:
+            child = tuple(reversed(state[:length])) + state[length:]
+            suffix = visit(
+                child, breakpoints + delta, remaining - 1, length, seen
+            )
+            if suffix is not None:
+                return [length] + suffix
+            if exhausted:
+                return None
+        return None
+
+    path = None
+    for depth in range(initial_b, inst["max_flips"] + 1):
+        path = visit(start, initial_b, depth, 0, {})
+        if path is not None:
+            found_depth = depth
+            break
+        if exhausted:
+            break
+    return {
+        "path": path,
+        "nodes": min(nodes, node_cap),
+        "exhausted": exhausted,
+        "found_depth": found_depth,
+    }
