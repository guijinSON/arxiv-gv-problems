\\
\subprop b&
\row{V^1\n X\n D \n Y \n \biglambda{C}{O}{I}} \path
\row{X\n \ident{p+1}{p+31} \n Y \n \biglambda{C-N}{O\cup N}{I}} 
\\
\subprop c&
\row{V^2\n X\n D \n Y \n \biglambda{C}{O}{I}} \path
\row{X\n \ident{p+1}{p+31} \n Y \n \biglambda{C-P}{O\cup P}{I}} 
\end{align*}
}

\end{property}

