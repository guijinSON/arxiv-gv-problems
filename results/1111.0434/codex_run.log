import importlib.util,pathlib,time,sys
sys.setrecursionlimit(3000)
spec=importlib.util.spec_from_file_location('g',pathlib.Path('gen_1111_0434.py'))
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
def moves(state, prev):
 h=state[0]; n=len(state); out=[]
 for v in (h-1,h+1):
  if 1<=v<=n:
   pos=state.index(v)
   if pos and abs(state[pos-1]-v)"'!=1 and pos!=prev: out.append(pos)
 if h==n and state[-1]!=n and n!=prev: out.append(n)
 return out

def solve(inst, cap):
 start=tuple(inst['"'rank_stack']); n=len(start); nodes=0; seen={}; goal=tuple(range(1,n+1)); path=[]
 def dfs(s, prev):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return False
  if s==goal:return True
  key=(s,prev)
  if key in seen:return False
  seen[key]=1
  for r in moves(s,prev):
   c=tuple(reversed(s[:r]))+s[r:]
   path.append(r)
   if dfs(c,r):return True
   path.pop()
   if nodes>cap:return False
  return False
 ok=dfs(start,0); return ok,nodes,list(path)
for cap in (50000,200000,1000000):
 print('cap',cap,flush=True)
 for seed in range(4):
  inst=g.make_instance(n=245,seed=50000+seed,max_flips=240,target_breakpoints=240,neutral_weight=1)
  t=time.perf_counter(); ok,nodes,path=solve(inst,cap); print(seed,ok,nodes,round(time.perf_counter()-t,3),len(path),flush=True)
