+                if current_b + delta <= remaining_after:
+                    moves.append((delta, rng.random(), length))
+            if not moves:
+                break
+            moves.sort()
+            width = max(2, len(moves) // 8)
+            _, _, length = rng.choice(moves[:width])
+            permutation[:length] = reversed(permutation[:length])
+            path.append(length)
+        if permutation == goal:
