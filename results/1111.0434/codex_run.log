+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Track the breakpoint budget while allowing both breakpoint-removing "
+        "and breakpoint-preserving flips; purely efficient routes and ordinary "
+        "largest-first pancake sorting miss the bounded witness."
+    ),
+    "hardness_basis": (
+        "Track A: Theorem 19 proves NP-hardness for unsigned MIN-SBPR and even "
+        "for the breakpoint-tight decision regime; the shipping preset uses "
+        "random reduced bounded routes on n=60 with 60 allowed flips and 40 "
+        "rank breakpoints, while selftest measures breakpoint-IDA* to its node "
+        "cap on eight independent shipping instances."
+    ),
+    "max_answer_tokens": 121,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
