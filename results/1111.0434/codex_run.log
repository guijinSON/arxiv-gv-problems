+def make_instance(n, seed=0, **params):
+    """Inverse-generate a bounded sorting word, then hide ranks as exact sizes."""
+    max_flips = params.pop("max_flips", n)
+    target_breakpoints = params.pop("target_breakpoints", max(2, 2 * n // 3))
+    neutral_weight = params.pop("neutral_weight", 1)
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    for name, value in (
+        ("n", n),
+        ("max_flips", max_flips),
+        ("target_breakpoints", target_breakpoints),
+        ("neutral_weight", neutral_weight),
