+    ),
+    "hardness_basis": (
+        "Track A: Lemma 1.1 at d=2, k=d+1 guarantees connectivity, but the paper "
+        "says its construction may be exponential and a polynomial bound is open; "
+        "the shipping 10x10 grid has treewidth 10, maximum degree 4, and average "
+        "degree 3.6, outside Theorems 0.1--0.3, while bounded bidirectional "
+        "component-beam search exhausts its measured budget."
+    ),
+    "max_answer_tokens": 64,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": " + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {
