-def _reference_from_inst(inst):
-    order = [v - 1 for v in inst["elimination_order"]]
-    moves, final, counter = _paper_algorithm_raw(
-        inst["n"],
-        inst["k"],
-        [tuple(e) for e in inst["G_edges"]],
-        [tuple(e) for e in inst["H_edges"]],
-        order,
-        inst["start_coloring"],
-        with_counter=True,
-    )
-    padded = _pad_with_canceling_pairs(moves, final, inst["required_moves"])
-    if padded is None:
-        return moves, final, counter
-    return padded, final, counter
