+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "Exactly s ordered pairs [v,c]. At each step v is in 1..n and c is one "
+        "of the two colors different from v's current color; the pair swaps the "
+        "current bichromatic component containing v."
