+def _grid_shape(n):
+    if not isinstance(n, int) or isinstance(n, bool) or n < 9:
+        return 0, 0
+    rows = math.isqrt(n)
+    while rows >= 2 and n % rows:
+        rows -= 1
+    return rows, n // rows
+
+
+def _validate_params(n, burn_in, moves, min_hamming, max_route_vertices, attack_width, attack_nodes):
