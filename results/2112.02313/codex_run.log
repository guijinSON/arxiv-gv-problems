+except ImportError:  # pragma: no cover - this module remains stdlib-only
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "graph G",
+        "chordal completion H",
+        "perfect-elimination order",
+        "proper vertex coloring",
+        "Kempe-change sequence",
+    ],
+    "verification_operations": [
+        "exact bichromatic connected-component traversal",
+        "integer color swap",
+        "edgewise proper-coloring comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "In a perfect-elimination order the later neighbors of every vertex "
+        "form a clique, which lets missing completion edges be imposed without "
+        "disturbing edges already imposed; without this invariant one must "
+        "track many evolving bichromatic components."
+    ),
+    "hardness_basis": (
+        "Track B: Section 6 Algorithm 3 constructs a witness in "
+        "O(treewidth*n^4) time; final shipping measurements are inserted after "
+        "selftest, while the elimination-order route stays below 300 exact "
+        "decisions and component checks."
+    ),
+    "max_answer_tokens": 128,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+# The non-demo rungs keep the answer ceiling fixed and grow the graph/deletion
+# haystack.  max_moves is a language bound, not a requested planted length.
+DIFFICULTY = {
+    "demo": {
+        "n": 5,
+        "width": 2,
+        "active": 1,
+        "decoy_num": 0,
+        "decoy_den": 1,
+        "min_moves": 1,
+        "max_moves": 5,
+    },
+    "easy": {
+        "n": 24,
+        "width": 3,
+        "active": 4,
+        "decoy_num": 1,
+        "decoy_den": 5,
+        "min_moves": 6,
+        "max_moves": 16,
+    },
+    "medium": {
+        "n": 40,
+        "width": 3,
+        "active": 4,
+        "decoy_num": 2,
+        "decoy_den": 5,
+        "min_moves": 6,
+        "max_moves": 16,
+    },
+    "hard": {
+        "n": 64,
+        "width": 4,
+        "active": 5,
+        "decoy_num": 1,
+        "decoy_den": 2,
+        "min_moves": 6,
+        "max_moves": 16,
