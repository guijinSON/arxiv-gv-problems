+    invariant_count = 0
+    real_count = 0
+    unrelated_keys = []
+    key_params = DIFFICULTY["easy"]
+    for seed in range(201, 221):
+        original = make_instance(seed=seed, **key_params)
+        original_key = canonical_key(original)
+        rng = random.Random(seed ^ 0xA5A5)
+        vp = list(range(original["n"]))
