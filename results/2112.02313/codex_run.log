+def escalate(params):
+    """Grow the grid and attack budget while holding the 16-move answer fixed."""
+    p = {key: value for key, value in params.items() if key != "_preset"}
+    n = p.get("n", 36)
+    side = math.isqrt(n)
+    next_side = side + 2 if side * side == n else side + 1
+    next_n = next_side * next_side
+    if next_n > CERTIFICATE_LANGUAGE["bounds"]["max_vertex"]:
+        return None
+    p["n"] = next_n
+    p["burn_in"] = 4 * next_n
+    p["min_hamming"] = min(next_n - 1, max(p.get("min_hamming", 0) + 8, (3 * next_n) // 5))
+    p["max_route_vertices"] = min(284, max(p.get("max_route_vertices", 0), 260))
+    p["attack_width"] = min(160, p.get("attack_width", 64) + 16)
+    p["attack_nodes"] = min(200_000, p.get("attack_nodes", 35_000) + 25_000)
+    p["moves"] = 16
+    return p
+
