+
+def _components_inside(adj, vertices, counter=None):
+    allowed = set(vertices)
+    result = []
+    while allowed:
+        start = min(allowed)
+        allowed.remove(start)
+        comp = [start]
+        stack = [start]
+        while stack:
+            v = stack.pop()
+            for u in adj[v]:
+                if counter is not None:
+                    counter["edge_scans"] += 1
+                if u in allowed:
+                    allowed.remove(u)
+                    comp.append(u)
+                    stack.append(u)
