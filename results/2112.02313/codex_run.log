+def _grid_edges(rows, cols):
+    edges = []
+    for i in range(rows):
+        for j in range(cols):
+            v = i * cols + j
+            if i + 1 < rows:
+                edges.append((v, v + cols))
+            if j + 1 < cols:
+                edges.append((v, v + 1))
