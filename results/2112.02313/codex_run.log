+    colors = list(start)
+    moves = []
+    counter = {
+        "edge_scans": 0,
+        "neighbor_tests": 0,
+        "color_writes": 0,
+        "missing_edges": len(missing),
+        "abstract_kempe_changes": 0,
+        "g_kempe_changes": 0,
+    }
