+                generated += 1
+                if generated > node_budget:
+                    stats = {
+                        "expanded_states": expanded,
+                        "generated_successors": generated,
+                        "stored_states": len(f_parent) + len(b_parent),
+                        "max_forward_depth": max_f,
+                        "max_backward_depth": max_b,
+                        "budget_hit": True,
+                    }
