+    for u, v in h_edges:
+        if start[u] == start[v]:
+            continue
+        if decoy_num and rng.randrange(decoy_den) < decoy_num:
+            continue
+        g_edges.append((u, v))
+    if not g_edges:
+        return None
+
+    # Hide the construction order behind a vertex permutation and a global color
+    # permutation.  The valid PEO itself remains part of the theorem's input.
+    label = list(range(n))
+    rng.shuffle(label)
+    color_perm = list(range(1, k + 1))
+    rng.shuffle(color_perm)
+    cmap = {c: color_perm[c - 1] for c in range(1, k + 1)}
+
+    def map_edges(edges):
+        result = [_edge(label[u], label[v]) for u, v in edges]
+        rng.shuffle(result)
+        return result
+
+    h2 = map_edges(h_edges)
+    g2 = map_edges(g_edges)
+    order2 = [label[v] for v in order]
+    start2 = [0] * n
+    base2 = [0] * n
+    for old in range(n):
+        start2[label[old]] = cmap[start[old]]
+        base2[label[old]] = cmap[base[old]]
+    return {
+        "n": n,
+        "k": k,
+        "width": width,
+        "g_edges": g2,
+        "h_edges": h2,
+        "order": order2,
+        "start": start2,
+        "base": base2,
+    }
+
+
+def make_instance(
+    n,
+    seed=0,
+    width=3,
+    active=4,
+    decoy_num=1,
+    decoy_den=5,
+    min_moves=6,
+    max_moves=16,
+    **params,
+):
+    """Construct a Section-6 instance and its certificate via Algorithm 3."""
+    _validate_params(n, width, active, decoy_num, decoy_den, min_moves, max_moves)
+    if not isinstance(seed, int) or isinstance(seed, bool):
+        raise ValueError("seed must be an integer")
+    rng = random.Random(seed)
+    for attempt in range(2000):
+        built = _build_attempt(n, width, active, decoy_num, decoy_den, rng)
+        if built is None:
+            continue
+        try:
+            moves, final, counter = _paper_algorithm_raw(
+                n,
+                built["k"],
+                built["g_edges"],
+                built["h_edges"],
+                built["order"],
+                built["start"],
+                with_counter=True,
+            )
+        except AssertionError:
+            continue
+        if min_moves <= len(moves) <= max_moves:
+            answer = moves
+            if json.loads(json.dumps(answer)) != answer:
+                raise AssertionError("answer is not JSON-native")
+            instance = {
+                "family": "chordal_completion_kempe_sequence",
+                "n": n,
+                "k": built["k"],
+                "treewidth": width,
+                "G_edges": [list(e) for e in built["g_edges"]],
+                "H_edges": [list(e) for e in built["h_edges"]],
+                "elimination_order": [v + 1 for v in built["order"]],
+                "start_coloring": built["start"],
+                "required_moves": len(moves),
+                "answer": answer,
+                "construction_attempt": attempt,
+                "reference_operations": (
+                    counter["edge_scans"] + counter["neighbor_tests"] + counter["color_writes"]
+                ),
+            }
+            # Keep only instances on which the paper's inner-loop machinery is
+            # genuinely needed.  This conditions the distribution on four
+            # cheap local rules failing; it never searches for the witness,
+            # which was already produced above by the theorem-backed algorithm.
+            if n > 5:
+                easy_policies = ("outlier", "first_conflict", "template", "one_pass")
+                if any(
+                    verify(instance, _candidate_by_policy(instance, policy, seed + attempt))[0]
+                    for policy in easy_policies
+                ):
+                    continue
+            return instance
+    raise RuntimeError("could not construct an instance inside the fixed move bound")
+
+
+def render(inst):
+    n = inst["n"]
+    k = inst["k"]
+    g_edges = sorted(inst["G_edges"])
+    h_edges = sorted(inst["H_edges"])
+    lines = [
+        "Find a bounded Kempe-change sequence that extends a coloring to a chordal completion.",
+        "",
+        f"Vertices are the integers 1 through {n}. Colors are 1 through {k}.",
+        "Both G and H are undirected simple graphs on those vertices; every edge [u,v]",
+        "has distinct endpoints, and edge order has no meaning. G is a subgraph of H.",
+        "The displayed vertex order is a perfect-elimination order of H: for each",
+        "vertex, its neighbors appearing later in the order form a clique. Thus H is",
+        f"chordal with treewidth {inst['treewidth']}. The starting list is a proper",
+        "coloring of G, but it need not be proper for the extra edges of H.",
+        "",
+        "A move [v,c] is interpreted in the CURRENT coloring, not the starting one.",
+        "It requires c to differ from the current color a of v. In G, take the entire",
+        "connected component containing v in the subgraph induced by vertices whose",
+        "current colors are a or c, and simultaneously swap a and c on that component.",
+        "This is one Kempe change. Components and colors are recomputed after every move.",
+        "",
+        f"G edges ({len(g_edges)}):",
+        json.dumps(g_edges, separators=(",", ":")),
+        f"H edges ({len(h_edges)}):",
+        json.dumps(h_edges, separators=(",", ":")),
+        "Perfect-elimination order, earliest to latest:",
+        json.dumps(inst["elimination_order"], separators=(",", ":")),
+        "Starting coloring [color(1),...,color(n)]:",
+        json.dumps(inst["start_coloring"], separators=(",", ":")),
+        "",
+        f"Return exactly {inst['required_moves']} moves. After replaying them in G, the",
+        "final coloring must be proper for every edge of H. The answer is a JSON list",
+        "of [vertex,color] pairs; order matters, repeats are allowed, and indexing is",
+        "1-based. No final coloring should be included.",
+        "",
+        "Give your final answer inside <answer></answer> tags, as the JSON list just specified.",
+        "Example syntax: <answer>[[3,2],[7,1]]</answer>",
+        "Output nothing else inside the tags.",
+    ]
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list):
+        return None
+    return value
+
+
+def verify(inst, answer):
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list of moves"
+    if not answer:
+        return False, "answer must not be empty"
+    expected = inst["required_moves"]
+    if len(answer) < expected:
+        return False, f"too few moves: got {len(answer)}, expected exactly {expected}"
+    if len(answer) > expected:
+        return False, f"too many moves: got {len(answer)}, expected exactly {expected}"
+    n = inst["n"]
+    k = inst["k"]
+    g_edges = [tuple(e) for e in inst["G_edges"]]
+    g_adj = _adjacency(n, g_edges)
+    colors = list(inst["start_coloring"])
+    for index, move in enumerate(answer, 1):
+        if not isinstance(move, list) or len(move) != 2:
+            return False, f"move {index} must be a two-element JSON list [vertex,color]"
+        v, c = move
+        if not isinstance(v, int) or isinstance(v, bool):
+            return False, f"move {index} vertex must be an integer"
+        if not 1 <= v <= n:
+            return False, f"move {index} vertex {v} is outside 1..{n}"
+        if not isinstance(c, int) or isinstance(c, bool):
+            return False, f"move {index} color must be an integer"
+        if not 1 <= c <= k:
+            return False, f"move {index} target color {c} is outside 1..{k}"
+        u = v - 1
+        if colors[u] == c:
+            return False, f"move {index} is trivial because vertex {v} already has color {c}"
+        _apply_move(g_adj, colors, u, c)
+    for u, v in inst["H_edges"]:
+        if colors[u] == colors[v]:
+            return (
+                False,
+                f"final coloring conflicts on H edge [{u + 1},{v + 1}] with color {colors[u]}",
+            )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    n = inst["n"]
+    k = inst["k"]
+    g_adj = _adjacency(n, [tuple(e) for e in inst["G_edges"]])
+    colors = list(inst["start_coloring"])
+    answer = []
+    for _ in range(inst["required_moves"]):
+        v = rng.randrange(n)
+        choices = [c for c in range(1, k + 1) if c != colors[v]]
+        c = choices[rng.randrange(len(choices))]
+        answer.append([v + 1, c])
+        _apply_move(g_adj, colors, v, c)
+    return answer
+
+
+def search_space(inst):
+    return (inst["n"] * (inst["k"] - 1)) ** inst["required_moves"]
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    n = inst["n"]
+    k = inst["k"]
+    steps = inst["required_moves"]
+    g_adj = _adjacency(n, [tuple(e) for e in inst["G_edges"]])
+    h_edges = [tuple(e) for e in inst["H_edges"]]
+    valid = 0
+
+    def visit(depth, colors):
+        nonlocal valid
+        if depth == steps:
+            if all(colors[u] != colors[v] for u, v in h_edges):
+                valid += 1
+            return
+        for v in range(n):
+            for c in range(1, k + 1):
+                if c == colors[v]:
+                    continue
+                nxt = list(colors)
+                _apply_move(g_adj, nxt, v, c)
+                visit(depth + 1, nxt)
+
+    visit(0, list(inst["start_coloring"]))
+    return valid
+
+
+def _wl_key(inst):
+    """Strong cheap invariant of the colored two-edge-relation structure."""
+    n, k = inst["n"], inst["k"]
+    total = n + k
+    rel = [[] for _ in range(total)]
+    gset = {_edge(*e) for e in inst["G_edges"]}
+    hset = {_edge(*e) for e in inst["H_edges"]}
+    for u, v in hset:
+        kind = "G" if (u, v) in gset else "F"
+        rel[u].append((kind, v))
+        rel[v].append((kind, u))
+    for v, c in enumerate(inst["start_coloring"]):
+        node = n + c - 1
+        rel[v].append(("C", node))
+        rel[node].append(("C", v))
+    labels = ["V"] * n + ["K"] * k
+    for _ in range(total + 1):
+        sigs = []
+        for v in range(total):
+            neighborhood = sorted((kind, labels[u]) for kind, u in rel[v])
+            sigs.append((labels[v], tuple(neighborhood)))
+        palette = {sig: str(i) for i, sig in enumerate(sorted(set(sigs)))}
+        new = [palette[sig] for sig in sigs]
+        if new == labels:
+            break
+        labels = new
+    histogram = sorted((lab, labels.count(lab)) for lab in set(labels))
+    relation_counts = {}
+    for v in range(total):
+        for kind, u in rel[v]:
+            if v < u:
+                pair = tuple(sorted((labels[v], labels[u])))
+                key = (kind,) + pair
+                relation_counts[key] = relation_counts.get(key, 0) + 1
+    payload = [
+        inst["required_moves"],
+        histogram,
+        sorted((list(key), value) for key, value in relation_counts.items()),
+    ]
+    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
+
+
+def canonical_key(inst):
+    return _wl_key(inst)
+
+
+def escalate(params):
+    p = {k: v for k, v in params.items() if k != "_preset"}
+    n = p.get("n", 24)
+    width = p.get("width", 3)
+    decoy_num = p.get("decoy_num", 1)
+    decoy_den = p.get("decoy_den", 5)
+    if n < 320:
+        p["n"] = min(320, max(n + 16, (3 * n) // 2))
+        if decoy_num + 1 < decoy_den:
+            p["decoy_num"] = decoy_num + 1
+        elif width < 7:
+            p["width"] = width + 1
+            p["decoy_num"] = max(1, decoy_den // 2)
+        return p
+    if decoy_num + 1 < decoy_den:
+        p["decoy_num"] = decoy_num + 1
+        return p
+    if width < 7:
+        p["width"] = width + 1
+        p["decoy_num"] = max(1, decoy_den // 2)
+        return p
+    return None
+
+
+def _reference_from_inst(inst):
+    order = [v - 1 for v in inst["elimination_order"]]
+    return _paper_algorithm_raw(
+        inst["n"],
+        inst["k"],
+        [tuple(e) for e in inst["G_edges"]],
+        [tuple(e) for e in inst["H_edges"]],
+        order,
+        inst["start_coloring"],
+        with_counter=True,
+    )
+
+
+def _candidate_by_policy(inst, policy, seed):
+    """Run a deliberately local policy for exactly the requested move count."""
+    rng = random.Random(seed)
+    n, k = inst["n"], inst["k"]
+    g_adj = _adjacency(n, [tuple(e) for e in inst["G_edges"]])
+    h_adj = _adjacency(n, [tuple(e) for e in inst["H_edges"]])
+    h_edges = [tuple(e) for e in inst["H_edges"]]
+    colors = list(inst["start_coloring"])
+    order = [v - 1 for v in inst["elimination_order"]]
+    pos = {v: i for i, v in enumerate(order)}
+    base = _forced_coloring(n, k, h_adj, order)
+    # Align the forced template's color names to the start on the latest clique.
+    mapping = {}
+    for v in reversed(order):
+        mapping.setdefault(base[v], colors[v])
+        if len(mapping) == k:
+            break
+    target = [mapping.get(c, c) for c in base]
+    initial_bad = [v for v in order if colors[v] != target[v]]
+    moves = []
+
+    for step in range(inst["required_moves"]):
+        conflicts = [(u, v) for u, v in h_edges if colors[u] == colors[v]]
+        if policy == "random":
+            v = rng.randrange(n)
+            choices = [c for c in range(1, k + 1) if c != colors[v]]
+            c = rng.choice(choices)
+        elif policy == "outlier":
+            score = [sum(colors[v] == colors[u] for u in h_adj[v]) for v in range(n)]
+            v = min(range(n), key=lambda x: (-score[x], x))
+            choices = [c for c in range(1, k + 1) if c != colors[v]]
+            c = min(choices, key=lambda x: (sum(colors[u] == x for u in h_adj[v]), x))
+        elif policy == "first_conflict" and conflicts:
+            u, v2 = min(conflicts, key=lambda e: (min(pos[e[0]], pos[e[1]]), max(pos[e[0]], pos[e[1]])))
+            v = u if pos[u] < pos[v2] else v2
+            used = {colors[x] for x in h_adj[v] if pos[x] > pos[v]}
+            choices = [c for c in range(1, k + 1) if c != colors[v]]
+            c = next((x for x in choices if x not in used), choices[0])
+        elif policy == "template":
+            bad = [v for v in order if colors[v] != target[v]]
+            v = bad[0] if bad else order[step % n]
+            c = target[v]
+            if c == colors[v]:
+                c = 1 + (c % k)
+        elif policy == "one_pass":
+            v = initial_bad[step % len(initial_bad)] if initial_bad else order[step % n]
+            c = target[v]
+            if c == colors[v]:
+                c = 1 + (c % k)
+        else:
+            v = order[step % n]
+            c = 1 + (colors[v] % k)
+        moves.append([v + 1, c])
+        _apply_move(g_adj, colors, v, c)
+    return moves
+
+
+def _attack_candidates(inst, seed):
+    candidates = {
+        "outlier_conflict_degree": [_candidate_by_policy(inst, "outlier", seed)],
+        "greedy_first_missing_conflict": [_candidate_by_policy(inst, "first_conflict", seed)],
+        "direct_forced_template": [_candidate_by_policy(inst, "template", seed)],
+        "by_hand_one_pass_elimination": [_candidate_by_policy(inst, "one_pass", seed)],
+        "random_restart_64": [],
+    }
+    for restart in range(64):
+        candidates["random_restart_64"].append(
+            _candidate_by_policy(inst, "random", seed * 1009 + restart)
+        )
+    return candidates
+
+
+def _relabel(inst, vertex_perm=None, color_perm=None, reverse_edges=False):
+    n, k = inst["n"], inst["k"]
+    vp = vertex_perm or list(range(n))
+    cp = color_perm or list(range(1, k + 1))
+    cmap = {c: cp[c - 1] for c in range(1, k + 1)}
+    out = copy.deepcopy(inst)
+    for key in ("G_edges", "H_edges"):
+        out[key] = [[vp[u], vp[v]] for u, v in inst[key]]
+        if reverse_edges:
+            out[key].reverse()
+    order0 = [v - 1 for v in inst["elimination_order"]]
+    out["elimination_order"] = [vp[v] + 1 for v in order0]
+    out["start_coloring"] = [0] * n
+    for old in range(n):
+        out["start_coloring"][vp[old]] = cmap[inst["start_coloring"][old]]
+    out["answer"] = [[vp[v - 1] + 1, cmap[c]] for v, c in inst["answer"]]
+    return out
+
+
+def _corruptions(inst):
+    answer = copy.deepcopy(inst["answer"])
+    cases = {
+        "drop": answer[:-1],
+        "duplicate": answer + [copy.deepcopy(answer[-1])],
+        "empty": [],
+        "out_of_range": copy.deepcopy(answer),
+    }
+    cases["out_of_range"][0][0] = 0
+    swap = None
+    for i in range(len(answer)):
+        for j in range(i + 1, len(answer)):
+            trial = copy.deepcopy(answer)
+            trial[i], trial[j] = trial[j], trial[i]
+            if not verify(inst, trial)[0]:
+                swap = trial
+                break
+        if swap is not None:
+            break
+    if swap is None:
+        swap = copy.deepcopy(answer)
+        swap[0][0], swap[0][1] = swap[0][1], swap[0][0]
+    cases["swap"] = swap
+    return cases
+
+
+def selftest():
+    report = {}
+
+    failures = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 19):
+            inst = make_instance(seed=seed, **params)
+            attempts += 1
+            ok, why = verify(inst, inst["answer"])
+            if not ok:
+                failures.append({"preset": preset, "seed": seed, "reason": why})
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append({"preset": preset, "seed": seed, "reason": "answer not JSON-native"})
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "attempts": attempts,
+        "failures": failures,
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=314159, **shipping)
+    corruption_results = {}
+    reasons = []
+    for name, bad in _corruptions(inst).items():
+        ok, why = verify(inst, bad)
+        corruption_results[name] = {"rejected": not ok, "reason": why}
+        reasons.append(why)
+    report["G2_rejects_corruption"] = {
+        "pass": all(x["rejected"] for x in corruption_results.values()) and len(set(reasons)) == 5,
+        "distinct_reasons": len(set(reasons)),
+        "cases": corruption_results,
+    }
+
+    response = (
+        "I used the elimination-order clique invariant.\n```json\n"
+        + "<answer>\n"
+        + json.dumps(inst["answer"])
+        + "\n</answer>\n```\nThe sequence is above."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == inst["answer"] and parse_answer("garbage") is None,
+        "parsed_equals_answer": parsed == inst["answer"],
+        "garbage_returns_none": parse_answer("garbage") is None,
+    }
+
+    guess_rng = random.Random(8675309)
+    guess_total = 200_000
+    guess_hits = 0
+    t0 = time.perf_counter()
+    for _ in range(guess_total):
+        candidate = random_candidate(inst, guess_rng)
+        if verify(inst, candidate)[0]:
+            guess_hits += 1
+    guess_seconds = time.perf_counter() - t0
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_fraction,
+        "candidate_space": search_space(inst),
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    attack_names = list(_attack_candidates(inst, 0))
+    successes = {name: 0 for name in attack_names}
+    attack_seconds = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    reference_seconds = 0.0
+    reference_operations = 0
+    reference_moves = 0
+    for seed in range(101, 109):
+        trial = make_instance(seed=seed, **shipping)
+        candidates = _attack_candidates(trial, seed)
+        for name in attack_names:
+            start = time.perf_counter()
+            won = any(verify(trial, candidate)[0] for candidate in candidates[name])
+            attack_seconds[name] += time.perf_counter() - start
+            successes[name] += int(won)
+        start = time.perf_counter()
+        moves, final, counts = _reference_from_inst(trial)
+        reference_seconds += time.perf_counter() - start
+        reference_successes += int(verify(trial, moves)[0])
+        reference_operations += counts["edge_scans"] + counts["neighbor_tests"] + counts["color_writes"]
+        reference_moves += len(moves)
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_seconds[name], 6),
+        }
+        for name in attack_names
+    }
+    reference = {
+        "name": "Section 6 Algorithm 3 on the supplied chordal completion",
+        "complexity": "O(treewidth*n^4) time (paper Claim 3)",
+        "wall_clock_sec": round(reference_seconds / 8, 6),
+        "operations": reference_operations // 8,
+        "mean_output_moves": round(reference_moves / 8, 3),
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    all_failed = all(value == 0 for value in successes.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": reference,
+    }
+
+    demo = make_instance(seed=3, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_fraction < 1e-6 and all_failed and reference_successes == 8,
+        "shipping_sample_hits": guess_hits,
+        "shipping_sample_total": guess_total,
+        "shipping_solution_density": guess_fraction,
+        "demo_n": demo["n"],
+        "demo_required_moves": demo["required_moves"],
+        "demo_exact_solution_count": demo_count,
+        "baseline_attack_wall_clock_sec": round(attack_seconds["random_restart_64"] / 8, 6),
+        "baseline_attack_iterations": 64,
+        "reference_wall_clock_sec": reference["wall_clock_sec"],
+        "reference_operation_count": reference["operations"],
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] *= 2
+    t0 = time.perf_counter()
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_build = time.perf_counter() - t0
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    sizes = [DIFFICULTY[name]["n"] for name in DIFFICULTY]
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["n"] == 2 * inst["n"]
+        and len(render(doubled)) > len(render(inst))
+        and sizes == sorted(sizes)
+        and len(set(sizes)) == 4
+        and doubled["required_moves"] <= shipping["max_moves"],
+        "shipping_n": inst["n"],
+        "shipping_required_moves": inst["required_moves"],
+        "doubled_n": doubled["n"],
+        "doubled_required_moves": doubled["required_moves"],
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_why,
+        "candidate_space_shipping": search_space(inst),
+        "candidate_space_doubled": search_space(doubled),
+    }
+
+    invariant = 0
+    real = 0
+    unrelated = []
+    for seed in range(201, 221):
+        original = make_instance(seed=seed, **shipping)
+        key = canonical_key(original)
+        vrng = random.Random(seed ^ 0xA5A5)
+        vp = list(range(original["n"]))
+        vrng.shuffle(vp)
+        cp = list(range(1, original["k"] + 1))
+        vrng.shuffle(cp)
+        variants = [
+            _relabel(original, vertex_perm=vp),
+            _relabel(original, color_perm=cp),
+            _relabel(original, reverse_edges=True),
+            _relabel(original, vertex_perm=vp, color_perm=cp),
+            _relabel(original, vertex_perm=vp, reverse_edges=True),
+            _relabel(original, color_perm=cp, reverse_edges=True),
+            _relabel(original, vertex_perm=vp, color_perm=cp, reverse_edges=True),
+        ]
+        for variant in variants:
+            invariant += int(canonical_key(variant) == key)
+            real += int(verify(variant, variant["answer"])[0])
+        unrelated.append(key)
+    distinct = len(set(unrelated))
+    report["G8_canonical_key"] = {
+        "pass": invariant == 140 and real == 140 and distinct == 20,
+        "invariant_relabellings": invariant,
+        "real_transformations_verified": real,
+        "unrelated_distinct_keys": distinct,
+        "unrelated_attempts": 20,
+        "transformations": [
+            "arbitrary vertex permutation",
+            "global color permutation",
+            "G/H edge-list reordering",
+            "all compositions",
+        ],
+    }
+
+    answer_blob = json.dumps(inst["answer"], separators=(",", ":"))
+    answer_elements = 2 * len(inst["answer"])
+    intended_ops = inst["n"] + 3 * inst["required_moves"]
+    arms = {
+        "bare": dict(G9_ORACLE_RESULTS["bare"]),
+        "hinted": dict(G9_ORACLE_RESULTS["hinted"]),
+        "placebo": dict(G9_ORACLE_RESULTS["placebo"]),
+    }
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    report["G9_no_tool_suitability"] = {
+        "pass": len(answer_blob) <= 2000 and answer_elements <= 256 and intended_ops <= 300,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": len(answer_blob),
+        "answer_tokens": (len(answer_blob) + 3) // 4,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["certificate_language"] = CERTIFICATE_LANGUAGE
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and key[1:2].isdigit()
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

