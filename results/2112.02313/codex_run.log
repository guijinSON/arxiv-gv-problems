+PLACEBO_HINT = (
+    "Keep the vertex labels and current colors carefully aligned while "
+    "checking each proposed change."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list of exactly the displayed number s of ordered pairs "
+        "[v,c].  Vertices are 1..n; colors are 1..k; at every step c must "
+        "differ from v's current color.  The pair applies the Kempe change on "
+        "the current bichromatic component containing v."
+    ),
+    "bounds": {
+        "max_moves": 16,
+        "atoms_per_move": 2,
+        "max_atomic_elements": 32,
+        "max_vertex": 512,
+        "max_colors": 9,
+    },
+}
+
+NOTES = (
+    "Section 2 fixes the exact definitions of proper k-coloring, Kempe chain, "
+    "Kempe change, chordal graph, and treewidth. Proposition 2.2 is the easy "
+    "chordal case and explicitly has a linear-time construction. Section 6, "
+    "Theorem 1.3, Proposition 6.1, Algorithm 3, and Claims 1-3 give the native "
+    "completion problem used here, a sequence bound O(treewidth*n^2), and the "
+    "reference running time O(treewidth*n^4). Thus Track A would be false. "
+    "The generator constructs a maximal bounded-treewidth chordal H, deletes "
+    "edges to obtain G, and runs Algorithm 3 to retain instances whose exact "
+    "witness fits one fixed 16-move language. Vertex labels, color names, edge "
+    "order, and the choice of deleted proper-color decoys are randomized. The "
+    "G6 panel tests conflict-degree outliers, first-conflict greedy repair, "
+    "direct recovery of H's forced color template, a one-pass elimination "
+    "ansatz, and random restarts; the successful paper algorithm is reported "
+    "separately as required for Track B."
+)
+
+# Filled from isolated harden.py runs before shipping.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _validate_params(n, width, active, decoy_num, decoy_den, min_moves, max_moves):
+    vals = (n, width, active, decoy_num, decoy_den, min_moves, max_moves)
+    if any(not isinstance(x, int) or isinstance(x, bool) for x in vals):
+        raise ValueError("all parameters must be integers")
+    if not (2 <= width < n):
+        raise ValueError("width must satisfy 2 <= width < n")
+    if not (1 <= active <= n - width - 1):
+        raise ValueError("active must be between 1 and n-width-1")
+    if not (1 <= decoy_den and 0 <= decoy_num < decoy_den):
+        raise ValueError("decoy density must satisfy 0 <= numerator < denominator")
+    if not (1 <= min_moves <= max_moves <= CERTIFICATE_LANGUAGE["bounds"]["max_moves"]):
+        raise ValueError("move bounds are outside the certificate language")
+    if n > CERTIFICATE_LANGUAGE["bounds"]["max_vertex"]:
+        raise ValueError("n exceeds the certificate-language vertex bound")
+    if width + 1 > CERTIFICATE_LANGUAGE["bounds"]["max_colors"]:
+        raise ValueError("too many colors for the certificate language")
+
+
+def _edge(u, v):
+    return (u, v) if u < v else (v, u)
+
+
+def _adjacency(n, edges):
+    adj = [[] for _ in range(n)]
+    for u, v in edges:
+        adj[u].append(v)
+        adj[v].append(u)
+    for row in adj:
+        row.sort()
+    return adj
+
+
+def _random_ktree(n, width, rng):
+    """Return a maximal width-tree and one PEO, both on temporary labels."""
+    base = list(range(n - width - 1, n))
+    edges = {_edge(u, v) for u, v in itertools.combinations(base, 2)}
+    cliques = [tuple(c) for c in itertools.combinations(base, width)]
+    seen = set(cliques)
+    for v in range(n - width - 2, -1, -1):
+        chosen = cliques[rng.randrange(len(cliques))]
+        for u in chosen:
+            edges.add(_edge(u, v))
+        for omitted in range(width):
+            new_clique = tuple(sorted((v,) + chosen[:omitted] + chosen[omitted + 1 :]))
+            if new_clique not in seen:
+                seen.add(new_clique)
+                cliques.append(new_clique)
+    return sorted(edges), list(range(n))
+
+
+def _forced_coloring(n, k, h_adj, order):
+    """Greedy H-coloring backwards along a PEO; maximality makes it forced."""
+    pos = {v: i for i, v in enumerate(order)}
+    colors = [0] * n
+    for v in reversed(order):
+        used = {colors[u] for u in h_adj[v] if pos[u] > pos[v] and colors[u]}
+        colors[v] = next(c for c in range(1, k + 1) if c not in used)
+    return colors
+
+
+def _component(adj, colors, start, other, counter=None):
+    a = colors[start]
+    if other == a:
+        return [start]
+    allowed = {a, other}
+    seen = {start}
+    stack = [start]
+    while stack:
+        v = stack.pop()
+        for u in adj[v]:
+            if counter is not None:
+                counter["edge_scans"] += 1
+            if u not in seen and colors[u] in allowed:
+                seen.add(u)
+                stack.append(u)
+    return sorted(seen)
+
+
+def _apply_move(adj, colors, vertex, target, counter=None):
+    old = colors[vertex]
+    comp = _component(adj, colors, vertex, target, counter)
+    for u in comp:
+        colors[u] = target if colors[u] == old else old
+        if counter is not None:
+            counter["color_writes"] += 1
+    return comp
+
+
+def _components_inside(adj, vertices, counter=None):
+    allowed = set(vertices)
+    result = []
+    while allowed:
+        start = min(allowed)
+        allowed.remove(start)
+        comp = [start]
+        stack = [start]
+        while stack:
+            v = stack.pop()
+            for u in adj[v]:
+                if counter is not None:
+                    counter["edge_scans"] += 1
+                if u in allowed:
+                    allowed.remove(u)
+                    comp.append(u)
+                    stack.append(u)
+        result.append(sorted(comp))
+    result.sort(key=lambda c: c[0])
+    return result
+
+
+def _paper_algorithm_raw(n, k, g_edges, h_edges, order, start, with_counter=False):
+    """Section 6 Algorithm 3, expanded from current graph to changes in G."""
+    g_adj = _adjacency(n, g_edges)
+    current_edges = set(g_edges)
+    current_adj = _adjacency(n, current_edges)
+    h_adj = _adjacency(n, h_edges)
+    h_set = set(h_edges)
+    pos = {v: i for i, v in enumerate(order)}
+    missing = sorted(
+        h_set - current_edges,
+        key=lambda e: (min(pos[e[0]], pos[e[1]]), max(pos[e[0]], pos[e[1]])),
+    )
+    colors = list(start)
+    moves = []
+    counter = {
+        "edge_scans": 0,
+        "neighbor_tests": 0,
+        "color_writes": 0,
+        "missing_edges": len(missing),
+        "abstract_kempe_changes": 0,
+        "g_kempe_changes": 0,
+    }
+
+    def simulate_tilde_move(anchor, target):
+        old = colors[anchor]
+        chain = _component(current_adj, colors, anchor, target, counter)
+        pieces = _components_inside(g_adj, chain, counter)
+        counter["abstract_kempe_changes"] += 1
+        for piece in pieces:
+            root = min(piece)
+            other = target if colors[root] == old else old
+            actual = _apply_move(g_adj, colors, root, other, counter)
+            if actual != piece:
+                raise AssertionError("G-component simulation disagrees with tilde chain")
+            moves.append([root + 1, other])
+            counter["g_kempe_changes"] += 1
+
+    for edge in missing:
+        u, v = edge
+        if pos[u] > pos[v]:
+            u, v = v, u
+        if colors[u] == colors[v]:
+            later_closed = {u}
+            for x in h_adj[u]:
+                counter["neighbor_tests"] += 1
+                if pos[x] > pos[u]:
+                    later_closed.add(x)
+            used = {colors[x] for x in later_closed}
+            c = next(color for color in range(1, k + 1) if color not in used)
+
+            common_lower = []
+            neighbors_v = set(current_adj[v])
+            for x in current_adj[u]:
+                counter["neighbor_tests"] += 1
+                if pos[x] < pos[u] and x in neighbors_v:
+                    common_lower.append(x)
+            common_lower.sort(key=lambda x: pos[x], reverse=True)
+            for x in common_lower:
+                if colors[x] == c:
+                    later = {x}
+                    for y in current_adj[x]:
+                        counter["neighbor_tests"] += 1
+                        if pos[y] > pos[x]:
+                            later.add(y)
+                    used_x = {colors[y] for y in later}
+                    c_x = next(color for color in range(1, k + 1) if color not in used_x)
+                    simulate_tilde_move(x, c_x)
+            simulate_tilde_move(u, c)
+
+        current_edges.add(edge)
+        current_adj[u].append(v)
+        current_adj[v].append(u)
+        current_adj[u].sort()
+        current_adj[v].sort()
+        if colors[u] == colors[v]:
+            raise AssertionError(
+                "paper loop invariant failed while adding edge "
+                f"{edge}, positions {(pos[u], pos[v])}, colors {(colors[u], colors[v])}"
+            )
+
+    if any(colors[u] == colors[v] for u, v in h_edges):
+        raise AssertionError("paper algorithm did not produce an H-coloring")
+    return moves, colors, counter if with_counter else None
+
+
+def _independent_active_vertices(n, h_adj, order, count, rng):
+    # Deliberately allow adjacent active vertices.  Independent corruptions made
+    # every repair commute, so the obvious first-conflict rule was the paper
+    # algorithm with all of its difficult inner-loop cases compiled away.
+    candidates = list(order[: n - max(3, len(order) // 8)])
+    if len(candidates) < count:
+        return None
+    return rng.sample(candidates, count)
+
+
+def _build_attempt(n, width, active, decoy_num, decoy_den, rng):
+    k = width + 1
+    h_edges, order = _random_ktree(n, width, rng)
+    h_adj = _adjacency(n, h_edges)
+    base = _forced_coloring(n, k, h_adj, order)
+    start = list(base)
+    actives = _independent_active_vertices(n, h_adj, order, active, rng)
+    if actives is None:
+        return None
+    for v in actives:
+        choices = [c for c in range(1, k + 1) if c != base[v]]
+        start[v] = choices[rng.randrange(len(choices))]
+
+    # Every monochromatic H-edge must be absent for start to color G properly.
+    # Differently colored missing edges are independently drawn decoys.
+    g_edges = []
+    for u, v in h_edges:
+        if start[u] == start[v]:
+            continue
+        if decoy_num and rng.randrange(decoy_den) < decoy_num:
+            continue
+        g_edges.append((u, v))
+    if not g_edges:
+        return None
+
+    # Hide the construction order behind a vertex permutation and a global color
+    # permutation.  The valid PEO itself remains part of the theorem's input.
+    label = list(range(n))
+    rng.shuffle(label)
+    color_perm = list(range(1, k + 1))
+    rng.shuffle(color_perm)
+    cmap = {c: color_perm[c - 1] for c in range(1, k + 1)}
+
+    def map_edges(edges):
+        result = [_edge(label[u], label[v]) for u, v in edges]
+        rng.shuffle(result)
+        return result
+
+    h2 = map_edges(h_edges)
+    g2 = map_edges(g_edges)
+    order2 = [label[v] for v in order]
+    start2 = [0] * n
+    base2 = [0] * n
+    for old in range(n):
+        start2[label[old]] = cmap[start[old]]
+        base2[label[old]] = cmap[base[old]]
+    return {
+        "n": n,
+        "k": k,
+        "width": width,
+        "g_edges": g2,
+        "h_edges": h2,
+        "order": order2,
+        "start": start2,
+        "base": base2,
+    }
+
+
+def make_instance(
+    n,
+    seed=0,
+    width=3,
+    active=4,
+    decoy_num=1,
+    decoy_den=5,
+    min_moves=6,
+    max_moves=16,
+    **params,
+):
+    """Construct a Section-6 instance and its certificate via Algorithm 3."""
+    _validate_params(n, width, active, decoy_num, decoy_den, min_moves, max_moves)
+    if not isinstance(seed, int) or isinstance(seed, bool):
+        raise ValueError("seed must be an integer")
+    rng = random.Random(seed)
+    for attempt in range(2000):
+        built = _build_attempt(n, width, active, decoy_num, decoy_den, rng)
+        if built is None:
+            continue
+        try:
+            moves, final, counter = _paper_algorithm_raw(
+                n,
+                built["k"],
+                built["g_edges"],
+                built["h_edges"],
+                built["order"],
+                built["start"],
+                with_counter=True,
+            )
+        except AssertionError:
+            continue
+        if min_moves <= len(moves) <= max_moves:
+            answer = moves
+            if json.loads(json.dumps(answer)) != answer:
+                raise AssertionError("answer is not JSON-native")
+            instance = {
+                "family": "chordal_completion_kempe_sequence",
+                "n": n,
+                "k": built["k"],
+                "treewidth": width,
+                "G_edges": [list(e) for e in built["g_edges"]],
+                "H_edges": [list(e) for e in built["h_edges"]],
+                "elimination_order": [v + 1 for v in built["order"]],
+                "start_coloring": built["start"],
+                "required_moves": len(moves),
+                "answer": answer,
+                "construction_attempt": attempt,
+                "reference_operations": (
+                    counter["edge_scans"] + counter["neighbor_tests"] + counter["color_writes"]
+                ),
+            }
+            # Keep only instances on which the paper's inner-loop machinery is
+            # genuinely needed.  This conditions the distribution on four
+            # cheap local rules failing; it never searches for the witness,
+            # which was already produced above by the theorem-backed algorithm.
+            if n > 5:
+                easy_policies = ("outlier", "first_conflict", "template", "one_pass")
+                if any(
+                    verify(instance, _candidate_by_policy(instance, policy, seed + attempt))[0]
+                    for policy in easy_policies
+                ):
+                    continue
+            return instance
+    raise RuntimeError("could not construct an instance inside the fixed move bound")
+
+
+def render(inst):
+    n = inst["n"]
+    k = inst["k"]
+    g_edges = sorted(inst["G_edges"])
+    h_edges = sorted(inst["H_edges"])
+    lines = [
+        "Find a bounded Kempe-change sequence that extends a coloring to a chordal completion.",
+        "",
+        f"Vertices are the integers 1 through {n}. Colors are 1 through {k}.",
+        "Both G and H are undirected simple graphs on those vertices; every edge [u,v]",
+        "has distinct endpoints, and edge order has no meaning. G is a subgraph of H.",
+        "The displayed vertex order is a perfect-elimination order of H: for each",
+        "vertex, its neighbors appearing later in the order form a clique. Thus H is",
+        f"chordal with treewidth {inst['treewidth']}. The starting list is a proper",
+        "coloring of G, but it need not be proper for the extra edges of H.",
+        "",
+        "A move [v,c] is interpreted in the CURRENT coloring, not the starting one.",
+        "It requires c to differ from the current color a of v. In G, take the entire",
+        "connected component containing v in the subgraph induced by vertices whose",
+        "current colors are a or c, and simultaneously swap a and c on that component.",
+        "This is one Kempe change. Components and colors are recomputed after every move.",
+        "",
+        f"G edges ({len(g_edges)}):",
+        json.dumps(g_edges, separators=(",", ":")),
+        f"H edges ({len(h_edges)}):",
+        json.dumps(h_edges, separators=(",", ":")),
+        "Perfect-elimination order, earliest to latest:",
+        json.dumps(inst["elimination_order"], separators=(",", ":")),
+        "Starting coloring [color(1),...,color(n)]:",
+        json.dumps(inst["start_coloring"], separators=(",", ":")),
+        "",
+        f"Return exactly {inst['required_moves']} moves. After replaying them in G, the",
+        "final coloring must be proper for every edge of H. The answer is a JSON list",
+        "of [vertex,color] pairs; order matters, repeats are allowed, and indexing is",
+        "1-based. No final coloring should be included.",
+        "",
+        "Give your final answer inside <answer></answer> tags, as the JSON list just specified.",
+        "Example syntax: <answer>[[3,2],[7,1]]</answer>",
+        "Output nothing else inside the tags.",
+    ]
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list):
+        return None
+    return value
+
+
+def verify(inst, answer):
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list of moves"
+    if not answer:
+        return False, "answer must not be empty"
+    expected = inst["required_moves"]
+    if len(answer) < expected:
+        return False, f"too few moves: got {len(answer)}, expected exactly {expected}"
+    if len(answer) > expected:
+        return False, f"too many moves: got {len(answer)}, expected exactly {expected}"
+    n = inst["n"]
+    k = inst["k"]
+    g_edges = [tuple(e) for e in inst["G_edges"]]
+    g_adj = _adjacency(n, g_edges)
+    colors = list(inst["start_coloring"])
+    for index, move in enumerate(answer, 1):
+        if not isinstance(move, list) or len(move) != 2:
+            return False, f"move {index} must be a two-element JSON list [vertex,color]"
+        v, c = move
+        if not isinstance(v, int) or isinstance(v, bool):
+            return False, f"move {index} vertex must be an integer"
+        if not 1 <= v <= n:
+            return False, f"move {index} vertex {v} is outside 1..{n}"
+        if not isinstance(c, int) or isinstance(c, bool):
+            return False, f"move {index} color must be an integer"
+        if not 1 <= c <= k:
+            return False, f"move {index} target color {c} is outside 1..{k}"
+        u = v - 1
+        if colors[u] == c:
+            return False, f"move {index} is trivial because vertex {v} already has color {c}"
+        _apply_move(g_adj, colors, u, c)
+    for u, v in inst["H_edges"]:
+        if colors[u] == colors[v]:
+            return (
+                False,
+                f"final coloring conflicts on H edge [{u + 1},{v + 1}] with color {colors[u]}",
+            )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    n = inst["n"]
+    k = inst["k"]
+    g_adj = _adjacency(n, [tuple(e) for e in inst["G_edges"]])
+    colors = list(inst["start_coloring"])
+    answer = []
+    for _ in range(inst["required_moves"]):
+        v = rng.randrange(n)
+        choices = [c for c in range(1, k + 1) if c != colors[v]]
+        c = choices[rng.randrange(len(choices))]
+        answer.append([v + 1, c])
+        _apply_move(g_adj, colors, v, c)
+    return answer
+
+
+def search_space(inst):
+    return (inst["n"] * (inst["k"] - 1)) ** inst["required_moves"]
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    n = inst["n"]
+    k = inst["k"]
+    steps = inst["required_moves"]
+    g_adj = _adjacency(n, [tuple(e) for e in inst["G_edges"]])
+    h_edges = [tuple(e) for e in inst["H_edges"]]
+    valid = 0
+
+    def visit(depth, colors):
+        nonlocal valid
+        if depth == steps:
+            if all(colors[u] != colors[v] for u, v in h_edges):
+                valid += 1
+            return
+        for v in range(n):
+            for c in range(1, k + 1):
+                if c == colors[v]:
+                    continue
+                nxt = list(colors)
+                _apply_move(g_adj, nxt, v, c)
+                visit(depth + 1, nxt)
+
+    visit(0, list(inst["start_coloring"]))
+    return valid
+
+
+def _wl_key(inst):
+    """Strong cheap invariant of the colored two-edge-relation structure."""
+    n, k = inst["n"], inst["k"]
+    total = n + k
+    rel = [[] for _ in range(total)]
+    gset = {_edge(*e) for e in inst["G_edges"]}
+    hset = {_edge(*e) for e in inst["H_edges"]}
+    for u, v in hset:
+        kind = "G" if (u, v) in gset else "F"
+        rel[u].append((kind, v))
+        rel[v].append((kind, u))
+    for v, c in enumerate(inst["start_coloring"]):
+        node = n + c - 1
+        rel[v].append(("C", node))
+        rel[node].append(("C", v))
+    labels = ["V"] * n + ["K"] * k
+    for _ in range(total + 1):
+        sigs = []
+        for v in range(total):
+            neighborhood = sorted((kind, labels[u]) for kind, u in rel[v])
+            sigs.append((labels[v], tuple(neighborhood)))
+        palette = {sig: str(i) for i, sig in enumerate(sorted(set(sigs)))}
+        new = [palette[sig] for sig in sigs]
+        if new == labels:
+            break
+        labels = new
+    histogram = sorted((lab, labels.count(lab)) for lab in set(labels))
+    relation_counts = {}
+    for v in range(total):
+        for kind, u in rel[v]:
+            if v < u:
+                pair = tuple(sorted((labels[v], labels[u])))
+                key = (kind,) + pair
+                relation_counts[key] = relation_counts.get(key, 0) + 1
+    payload = [
+        inst["required_moves"],
+        histogram,
+        sorted((list(key), value) for key, value in relation_counts.items()),
+    ]
+    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
+
+
+def canonical_key(inst):
+    return _wl_key(inst)
+
+
+def escalate(params):
+    p = {k: v for k, v in params.items() if k != "_preset"}
+    n = p.get("n", 24)
+    width = p.get("width", 3)
+    decoy_num = p.get("decoy_num", 1)
+    decoy_den = p.get("decoy_den", 5)
+    if n < 320:
+        p["n"] = min(320, max(n + 16, (3 * n) // 2))
+        if decoy_num + 1 < decoy_den:
+            p["decoy_num"] = decoy_num + 1
+        elif width < 7:
+            p["width"] = width + 1
+            p["decoy_num"] = max(1, decoy_den // 2)
+        return p
+    if decoy_num + 1 < decoy_den:
+        p["decoy_num"] = decoy_num + 1
+        return p
+    if width < 7:
+        p["width"] = width + 1
+        p["decoy_num"] = max(1, decoy_den // 2)
+        return p
+    return None
+
+
+def _reference_from_inst(inst):
+    order = [v - 1 for v in inst["elimination_order"]]
+    return _paper_algorithm_raw(
+        inst["n"],
+        inst["k"],
+        [tuple(e) for e in inst["G_edges"]],
+        [tuple(e) for e in inst["H_edges"]],
+        order,
+        inst["start_coloring"],
+        with_counter=True,
+    )
+
+
+def _candidate_by_policy(inst, policy, seed):
+    """Run a deliberately local policy for exactly the requested move count."""
+    rng = random.Random(seed)
+    n, k = inst["n"], inst["k"]
+    g_adj = _adjacency(n, [tuple(e) for e in inst["G_edges"]])
+    h_adj = _adjacency(n, [tuple(e) for e in inst["H_edges"]])
+    h_edges = [tuple(e) for e in inst["H_edges"]]
+    colors = list(inst["start_coloring"])
+    order = [v - 1 for v in inst["elimination_order"]]
+    pos = {v: i for i, v in enumerate(order)}
+    base = _forced_coloring(n, k, h_adj, order)
+    # Align the forced template's color names to the start on the latest clique.
+    mapping = {}
+    for v in reversed(order):
+        mapping.setdefault(base[v], colors[v])
+        if len(mapping) == k:
+            break
+    target = [mapping.get(c, c) for c in base]
+    initial_bad = [v for v in order if colors[v] != target[v]]
+    moves = []
+
+    for step in range(inst["required_moves"]):
+        conflicts = [(u, v) for u, v in h_edges if colors[u] == colors[v]]
+        if policy == "random":
+            v = rng.randrange(n)
+            choices = [c for c in range(1, k + 1) if c != colors[v]]
+            c = rng.choice(choices)
+        elif policy == "outlier":
+            score = [sum(colors[v] == colors[u] for u in h_adj[v]) for v in range(n)]
+            v = min(range(n), key=lambda x: (-score[x], x))
+            choices = [c for c in range(1, k + 1) if c != colors[v]]
+            c = min(choices, key=lambda x: (sum(colors[u] == x for u in h_adj[v]), x))
+        elif policy == "first_conflict" and conflicts:
+            u, v2 = min(conflicts, key=lambda e: (min(pos[e[0]], pos[e[1]]), max(pos[e[0]], pos[e[1]])))
+            v = u if pos[u] < pos[v2] else v2
+            used = {colors[x] for x in h_adj[v] if pos[x] > pos[v]}
+            choices = [c for c in range(1, k + 1) if c != colors[v]]
+            c = next((x for x in choices if x not in used), choices[0])
+        elif policy == "template":
+            bad = [v for v in order if colors[v] != target[v]]
+            v = bad[0] if bad else order[step % n]
+            c = target[v]
+            if c == colors[v]:
+                c = 1 + (c % k)
+        elif policy == "one_pass":
+            v = initial_bad[step % len(initial_bad)] if initial_bad else order[step % n]
+            c = target[v]
+            if c == colors[v]:
+                c = 1 + (c % k)
+        else:
+            v = order[step % n]
+            c = 1 + (colors[v] % k)
+        moves.append([v + 1, c])
+        _apply_move(g_adj, colors, v, c)
+    return moves
+
+
+def _attack_candidates(inst, seed):
+    candidates = {
+        "outlier_conflict_degree": [_candidate_by_policy(inst, "outlier", seed)],
+        "greedy_first_missing_conflict": [_candidate_by_policy(inst, "first_conflict", seed)],
+        "direct_forced_template": [_candidate_by_policy(inst, "template", seed)],
+        "by_hand_one_pass_elimination": [_candidate_by_policy(inst, "one_pass", seed)],
+        "random_restart_64": [],
+    }
+    for restart in range(64):
+        candidates["random_restart_64"].append(
+            _candidate_by_policy(inst, "random", seed * 1009 + restart)
+        )
+    return candidates
+
+
+def _relabel(inst, vertex_perm=None, color_perm=None, reverse_edges=False):
+    n, k = inst["n"], inst["k"]
+    vp = vertex_perm or list(range(n))
+    cp = color_perm or list(range(1, k + 1))
+    cmap = {c: cp[c - 1] for c in range(1, k + 1)}
+    out = copy.deepcopy(inst)
+    for key in ("G_edges", "H_edges"):
+        out[key] = [[vp[u], vp[v]] for u, v in inst[key]]
+        if reverse_edges:
+            out[key].reverse()
+    order0 = [v - 1 for v in inst["elimination_order"]]
+    out["elimination_order"] = [vp[v] + 1 for v in order0]
+    out["start_coloring"] = [0] * n
+    for old in range(n):
+        out["start_coloring"][vp[old]] = cmap[inst["start_coloring"][old]]
+    out["answer"] = [[vp[v - 1] + 1, cmap[c]] for v, c in inst["answer"]]
+    return out
+
+
+def _corruptions(inst):
+    answer = copy.deepcopy(inst["answer"])
+    cases = {
+        "drop": answer[:-1],
+        "duplicate": answer + [copy.deepcopy(answer[-1])],
+        "empty": [],
+        "out_of_range": copy.deepcopy(answer),
+    }
+    cases["out_of_range"][0][0] = 0
+    swap = None
+    for i in range(len(answer)):
+        for j in range(i + 1, len(answer)):
+            trial = copy.deepcopy(answer)
+            trial[i], trial[j] = trial[j], trial[i]
+            if not verify(inst, trial)[0]:
+                swap = trial
+                break
+        if swap is not None:
+            break
+    if swap is None:
+        swap = copy.deepcopy(answer)
+        swap[0][0], swap[0][1] = swap[0][1], swap[0][0]
+    cases["swap"] = swap
+    return cases
+
+
+def selftest():
