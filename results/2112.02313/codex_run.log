+        old_at_anchor = current[move[0] - 1]
+        path.append((move, old_at_anchor))
+        current = nxt
+    if current != goal:
+        return None
+    if not reverse:
+        return [move for move, _old in path]
+    return [[move[0], old] for move, old in reversed(path)]
