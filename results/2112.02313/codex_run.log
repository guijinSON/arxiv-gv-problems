+def _random_restart_path(inst, restarts=16):
+    adj = _adjacency(inst["n"], [tuple(e) for e in inst["edges"]])
+    goal = tuple(inst["target_coloring"])
+    rng = random.Random(int(canonical_key(inst)[:16], 16) ^ 0x5EED)
