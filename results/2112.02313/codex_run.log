+
+def _component(adj, colors, start, other, counter=None):
+    old = colors[start]
+    seen = {start}
+    stack = [start]
+    while stack:
+        v = stack.pop()
+        for u in adj[v]:
+            if counter is not None:
+                counter["edge_scans"] += 1
+            if u not in seen and colors[u] in (old, other):
+                seen.add(u)
+                stack.append(u)
+    return sorted(seen)
