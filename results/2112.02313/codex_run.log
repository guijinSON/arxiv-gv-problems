+        "shipping_sample_total": guess_total,
+        "shipping_solution_density": guess_fraction,
+        "demo_n": demo["n"],
+        "demo_exact_solution_count": enumerate_all(demo),
+        "baseline_attack_wall_clock_sec": round(seconds["bidirectional_component_beam"] / 8, 6),
