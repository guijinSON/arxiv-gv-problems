+            _nxt, move, _vertices = first
+            inverse = [move[0], start[move[0] - 1]]
+            path = ([move, inverse] * (gap // 2)) + path
+        return path
+
+    while f_frontier and b_frontier and max_f + max_b < inst["required_moves"]:
