-def render(inst):
-    n = inst["n"]
-    k = inst["k"]
-    g_edges = sorted([[u + 1, v + 1] for u, v in inst["G_edges"]])
-    h_edges = sorted([[u + 1, v + 1] for u, v in inst["H_edges"]])
-    lines = [
-        "Find a bounded Kempe-change sequence that extends a coloring to a chordal completion.",
-        "",
-        f"Vertices are the integers 1 through {n}. Colors are 1 through {k}.",
-        "Both G and H are undirected simple graphs on those vertices; every edge [u,v]",
-        "has distinct endpoints, and edge order has no meaning. G is a subgraph of H.",
-        "The displayed vertex order is a perfect-elimination order of H: for each",
-        "vertex, its neighbors appearing later in the order form a clique. Thus H is",
-        f"chordal with treewidth {inst['treewidth']}. The starting list is a proper",
-        "coloring of G, but it need not be proper for the extra edges of H.",
-        "",
-        "A move [v,c] is interpreted in the CURRENT coloring, not the starting one.",
-        "It requires c to differ from the current color a of v. In G, take the entire",
-        "connected component containing v in the subgraph induced by vertices whose",
-        "current colors are a or c, and simultaneously swap a and c on that component.",
-        "This is one Kempe change. Components and colors are recomputed after every move.",
-        "",
-        f"G edges ({len(g_edges)}):",
-        json.dumps(g_edges, separators=(",", ":")),
-        f"H edges ({len(h_edges)}):",
-        json.dumps(h_edges, separators=(",", ":")),
-        "Perfect-elimination order, earliest to latest:",
-        json.dumps(inst["elimination_order"], separators=(",", ":")),
-        "Starting coloring [color(1),...,color(n)]:",
-        json.dumps(inst["start_coloring"], separators=(",", ":")),
-        "",
-        f"Return exactly {inst['required_moves']} moves. After replaying them in G, the",
-        "final coloring must be proper for every edge of H. The answer is a JSON list",
-        "of [vertex,color] pairs; order matters, repeats are allowed, and indexing is",
-        "1-based. No final coloring should be included.",
-        "",
-        "Give your final answer inside <answer></answer> tags, as the JSON list just specified.",
-        "Example syntax: <answer>[[3,2],[7,1]]</answer>",
-        "Output nothing else inside the tags.",
-    ]
-    mode = os.environ.get("GV_HINT_MODE")
-    if mode == "structural":
-        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
-    elif mode == "placebo":
-        lines.extend(["", "Hint: " + PLACEBO_HINT])
-    return "\n".join(lines)
-
-
-def parse_answer(text):
-    if not isinstance(text, str):
-        return None
-    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
-    if not matches:
-        return None
-    body = matches[-1].strip()
-    body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
-    body = re.sub(r"\s*```$", "", body)
-    try:
-        value = json.loads(body)
-    except (TypeError, ValueError):
-        return None
-    if not isinstance(value, list):
-        return None
-    return value
-
-
-def verify(inst, answer):
-    if not isinstance(answer, list):
-        return False, "answer must be a JSON list of moves"
-    if not answer:
-        return False, "answer must not be empty"
-    expected = inst["required_moves"]
-    if len(answer) < expected:
-        return False, f"too few moves: got {len(answer)}, expected exactly {expected}"
-    if len(answer) > expected:
-        return False, f"too many moves: got {len(answer)}, expected exactly {expected}"
-    n = inst["n"]
-    k = inst["k"]
-    g_edges = [tuple(e) for e in inst["G_edges"]]
-    g_adj = _instance_g_adjacency(inst)
-    colors = list(inst["start_coloring"])
-    for index, move in enumerate(answer, 1):
-        if not isinstance(move, list) or len(move) != 2:
-            return False, f"move {index} must be a two-element JSON list [vertex,color]"
-        v, c = move
-        if not isinstance(v, int) or isinstance(v, bool):
-            return False, f"move {index} vertex must be an integer"
-        if not 1 <= v <= n:
-            return False, f"move {index} vertex {v} is outside 1..{n}"
-        if not isinstance(c, int) or isinstance(c, bool):
-            return False, f"move {index} color must be an integer"
-        if not 1 <= c <= k:
-            return False, f"move {index} target color {c} is outside 1..{k}"
-        u = v - 1
-        if colors[u] == c:
-            return False, f"move {index} is trivial because vertex {v} already has color {c}"
-        _apply_move(g_adj, colors, u, c)
-    for u, v in inst["H_edges"]:
-        if colors[u] == colors[v]:
-            return (
-                False,
-                f"final coloring conflicts on H edge [{u + 1},{v + 1}] with color {colors[u]}",
-            )
-    return True, "ok"
-
-
-def random_candidate(inst, rng):
-    if not isinstance(rng, random.Random):
-        raise TypeError("rng must be random.Random")
-    n = inst["n"]
-    k = inst["k"]
-    g_adj = _instance_g_adjacency(inst)
-    colors = list(inst["start_coloring"])
-    answer = []
-    for _ in range(inst["required_moves"]):
-        v = rng.randrange(n)
-        choices = [c for c in range(1, k + 1) if c != colors[v]]
-        c = choices[rng.randrange(len(choices))]
-        answer.append([v + 1, c])
-        _apply_move(g_adj, colors, v, c)
-    return answer
-
-
-def search_space(inst):
-    return (inst["n"] * (inst["k"] - 1)) ** inst["required_moves"]
-
-
-def enumerate_all(inst):
-    space = search_space(inst)
-    if space > 200_000:
-        return None
-    n = inst["n"]
-    k = inst["k"]
-    steps = inst["required_moves"]
-    g_adj = _adjacency(n, [tuple(e) for e in inst["G_edges"]])
-    h_edges = [tuple(e) for e in inst["H_edges"]]
-    valid = 0
-
-    def visit(depth, colors):
-        nonlocal valid
-        if depth == steps:
-            if all(colors[u] != colors[v] for u, v in h_edges):
-                valid += 1
-            return
-        for v in range(n):
-            for c in range(1, k + 1):
-                if c == colors[v]:
-                    continue
-                nxt = list(colors)
-                _apply_move(g_adj, nxt, v, c)
-                visit(depth + 1, nxt)
-
-    visit(0, list(inst["start_coloring"]))
-    return valid
-
-
-def _wl_key(inst):
-    """Strong cheap invariant of the colored two-edge-relation structure."""
-    n, k = inst["n"], inst["k"]
-    total = n + k
-    rel = [[] for _ in range(total)]
-    gset = {_edge(*e) for e in inst["G_edges"]}
-    hset = {_edge(*e) for e in inst["H_edges"]}
-    for u, v in hset:
-        kind = "G" if (u, v) in gset else "F"
-        rel[u].append((kind, v))
-        rel[v].append((kind, u))
-    for v, c in enumerate(inst["start_coloring"]):
-        node = n + c - 1
-        rel[v].append(("C", node))
-        rel[node].append(("C", v))
-    labels = ["V"] * n + ["K"] * k
-    for _ in range(total + 1):
-        sigs = []
-        for v in range(total):
-            neighborhood = sorted((kind, labels[u]) for kind, u in rel[v])
-            sigs.append((labels[v], tuple(neighborhood)))
-        palette = {sig: str(i) for i, sig in enumerate(sorted(set(sigs)))}
-        new = [palette[sig] for sig in sigs]
-        if new == labels:
-            break
-        labels = new
-    histogram = sorted((lab, labels.count(lab)) for lab in set(labels))
-    relation_counts = {}
-    for v in range(total):
-        for kind, u in rel[v]:
-            if v < u:
-                pair = tuple(sorted((labels[v], labels[u])))
-                key = (kind,) + pair
-                relation_counts[key] = relation_counts.get(key, 0) + 1
-    payload = [
-        inst["required_moves"],
-        histogram,
-        sorted((list(key), value) for key, value in relation_counts.items()),
-    ]
-    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
-
-
-def canonical_key(inst):
-    return _wl_key(inst)
-
-
-def escalate(params):
-    p = {k: v for k, v in params.items() if k != "_preset"}
-    n = p.get("n", 24)
-    width = p.get("width", 3)
-    decoy_num = p.get("decoy_num", 1)
-    decoy_den = p.get("decoy_den", 5)
-    if n < 320:
-        p["n"] = min(320, max(n + 16, (3 * n) // 2))
-        if decoy_num + 1 < decoy_den:
-            p["decoy_num"] = decoy_num + 1
-        elif width < 7:
-            p["width"] = width + 1
-            p["decoy_num"] = max(1, decoy_den // 2)
-        return p
-    if decoy_num + 1 < decoy_den:
-        p["decoy_num"] = decoy_num + 1
-        return p
-    if width < 7:
-        p["width"] = width + 1
-        p["decoy_num"] = max(1, decoy_den // 2)
-        return p
-    return None
