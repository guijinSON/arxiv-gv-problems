+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "In the displayed perfect-elimination order, every vertex's later "
+    "neighbors form a clique whose used colors constrain each missing edge."
+)
+PLACEBO_HINT = (
+    "Keep the vertex labels and current colors carefully aligned while "
