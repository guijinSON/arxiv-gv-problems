+    if rows < 3:
+        raise ValueError("n must factor into two dimensions of at least 3")
+    if not 1 <= moves <= CERTIFICATE_LANGUAGE["bounds"]["moves"]:
+        raise ValueError("moves exceeds the certificate-language bound")
