+"""Verified Track-B generator from arXiv:2112.02313.
+
+The native task is the constructive core of Section 6, Proposition 6.1 and
+Algorithm 3.  The solver receives a graph G, a chordal completion H, a perfect
+elimination order of H, and a proper coloring of G.  It must give a bounded
+sequence of Kempe changes in G whose final coloring is proper for H.
+
+Every answer is checked by exact graph traversal and replay.  Instances are
+generated with the paper's constructive algorithm itself, so the certificate
+is theorem-backed rather than found by an unreported search.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import itertools
+import json
+import os
+import random
+import re
+import sys
+import time
+
+
+sys.path.insert(
+    0,
