+        "edgewise proper-coloring comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "In a perfect-elimination order the later neighbors of every vertex "
+        "form a clique, which lets missing completion edges be imposed without "
+        "disturbing edges already imposed; without this invariant one must "
+        "track many evolving bichromatic components."
+    ),
+    "hardness_basis": (
+        "Track B: Section 6 Algorithm 3 constructs a witness in "
+        "O(treewidth*n^4) time; final shipping measurements are inserted after "
