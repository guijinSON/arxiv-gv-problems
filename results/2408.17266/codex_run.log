+    p_hat = hits / total
+    report["G4_guess_resistance"] = {
+        "pass": p_hat < 1e-6,
+        "hits": hits,
+        "total": total,
+        "p_hat": p_hat,
+        "prior": "uniform over q distinct indices from m; all stated 0/1 and cardinality structure enforced",
+        "candidate_space": search_space(inst),
