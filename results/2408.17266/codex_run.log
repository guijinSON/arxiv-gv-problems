+      "duplicate": {"reason": "duplicate index: variable 5 is listed more than once", "rejected": true},
+      "empty": {"reason": "empty answer: expected 54 selected variable indices", "rejected": true},
+      "out_of_range": {"reason": "out of range: variable index 379 is not in 1..378", "rejected": true},
+      "replace_one": {"reason": "equation mismatch: the selected coefficients do not sum to b", "rejected": true}
+    },
