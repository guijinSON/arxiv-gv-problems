+    "doubled_n": 108,
+    "doubled_space": 18596726483036073495116022117210327595462408750460373225048061251326471624391039619190006527344868452127423716609931688232135572924250,
+    "pass": true,
+    "planted_ok": true,
+    "shipping_n": 54,
+    "shipping_space": 1240379056388287922828116256325306120627855133480882302879376020250,
+    "verify_reason": "ok"
+  },
+  "G8_canonical_key": {
+    "carried_witness_verified": 60,
+    "distinct_unrelated_keys": 20,
+    "invariance_checks": 60,
+    "invariant_transformations": ["variable reorder", "ground-set permutation", "composition"],
+    "key_basis": "incidence hypergraph pair-codegrees plus 8 rounds of relabelling-invariant refinement",
+    "pass": true,
