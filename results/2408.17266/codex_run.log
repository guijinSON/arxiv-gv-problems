+    panel = _attack_panel(shipping, list(range(8)))
+    report["G6_adversary_panel"] = {
+        "pass": all(row["solved"] == 0 for row in panel.values()),
+        "shipping_preset": SHIPPING_DIFFICULTY,
+        "attacks": panel,
+    }
+
+    doubled_params = dict(shipping)
