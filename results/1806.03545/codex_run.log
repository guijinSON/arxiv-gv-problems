+    left = Fraction(-bound - 1)
+    right = Fraction(bound + 1)
+    left_variations, used = _sturm_sign_changes_counted(sequence, left)
+    operations += used
+    right_variations, used = _sturm_sign_changes_counted(sequence, right)
