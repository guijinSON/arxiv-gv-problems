/bin/bash -lc "python3 - <<'PY'
import json, time
n=15
a=(17,23)
b=(19,29)
reps=200_000
t0=time.perf_counter()
for _ in range(reps):
    answer=[]
    for k,ak in enumerate(a):
        for l,bl in enumerate(b):
            component=[]
            for i in range(n+1):
                row=[0,0,0,0]
                row[k]=ak*i
                row[2+l]=bl*(n-i)
                component.append(row)
            answer.append(component)
elapsed=time.perf_counter()-t0
print(json.dumps({
    \"n\": n,
    \"components\": len(answer),
    \"monomial_generators\": sum(map(len, answer)),
    \"atomic_exponents\": sum(len(row) for c in answer for row in c),
    \"json_chars\": len(json.dumps(answer, separators=(\",\", \":\"))),
    \"ideal_products\": 4*(n+1),
    \"ideal_sums\": 4*n,
    \"intersections\": 3,
    \"abstract_total\": 4*(n+1)+4*n+3,
    \"scalar_products\": 2*4*(n+1),
    \"mean_sec\": elapsed/reps,
    \"repetitions\": reps
}, indent=2))
PY" in /home/gson/gvrepo/results/1806.03545
 succeeded in 4482ms:
