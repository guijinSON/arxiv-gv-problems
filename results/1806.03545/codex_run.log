+def _sturm_one_integer_root(coeffs: list[int], bound: int) -> tuple[int, int]:
+    """Find one promised simple integer root by exact Sturm bisection."""
+    if gv_roots is None:
+        raise RuntimeError("gvlib.roots is unavailable")
