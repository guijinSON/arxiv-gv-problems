    f = _shift_coefficients(f, shift_x)
    g = _shift_coefficients(g, shift_y)
    root_x, root_y = _extract_answer_roots(inst["answer"])
    root_x = sign_x * root_x + shift_x
    root_y = sign_y * root_y + shift_y
