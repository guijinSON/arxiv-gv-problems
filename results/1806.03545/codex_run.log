+        operations += 2 * len(polynomial)
+        if midpoint_value == 0:
+            if midpoint.denominator != 1:
+                raise ValueError("a promised integer root is nonintegral")
+            return midpoint.numerator, operations
+        if (midpoint_value > 0) == (left_value > 0):
