+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            hits += 1
+    guess_elapsed = time.perf_counter() - guess_start
+    probability = hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": probability < 1e-6,
+        "hits": hits,
+        "total": guess_total,
+        "empirical_probability": probability,
