+def _sturm_sign_changes_counted(sequence: list[list[Fraction]],
+                                value: Fraction) -> tuple[int, int]:
+    """Return the Sturm sign-change count and exact Horner operation count."""
+    if gv_roots is None:
+        raise RuntimeError("gvlib.roots is unavailable")
+    previous = 0
+    changes = 0
+    operations = 0
