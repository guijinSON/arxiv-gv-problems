import random,time,collections
R=(1,1,2,2)
def construct(n,seed):
    rng=random.Random(seed)
    p=list(range(n)); rng.shuffle(p)
    inv=[0]*n; ops=0
    for x,y in enumerate(p): inv[y]=x; ops+=1
    col=[0]*(2*n)
    for x in range(n): col[x]=0 if x%2==0 else 1; ops+=2
    for y in range(n):
        if y%2==0: col[n+y]=2 if (y//2)%2==0 else 3; ops+=4
        else: col[n+y]=0 if inv[y]%2==1 else 1; ops+=3
    return p,col,ops

def verify(n,p,c):
    N=2*n; adj=[[] for _ in range(N)]
    for i in range(n):
        adj[i].extend(((i-1)%n,(i+1)%n,n+p[i]))
        adj[n+i].extend((n+(i-1)%n,n+(i+1)%n))
    for i,y in enumerate(p): adj[n+y].append(i)
    for s in range(N):
        q=collections.deque([(s,0)]); seen={s}
        while q:
            v,d=q.popleft()
            if d==R[c[s]]: continue
            for w in adj[v]:
                if w not in seen:
                    if c[w]==c[s]: return False
                    seen.add(w); q.append((w,d+1))
    return True
p,c,ops=construct(128,7)
print('verified',verify(128,p,c),'counted_certificate_operations',ops,'answer_atoms',len(c))
for n in (16,32,64,128):
    t=time.perf_counter(); reps=20000
    for seed in range(reps): construct(n,seed)
    dt=time.perf_counter()-t
    _,_,ops=construct(n,0)
    print(n,ops,round(dt/reps*1e6,3),'microseconds_per_certificate')
