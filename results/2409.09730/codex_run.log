+    encoded = json.dumps(answer, separators=(",", ":"))
+    elements = (
+        len(answer[0])
+        if isinstance(answer, list) and len(answer) == 1
+        else 0
+    )
+    return len(encoded), math.ceil(len(encoded) / 4), elements
