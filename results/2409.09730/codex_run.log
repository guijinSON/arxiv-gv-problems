+def _inverse_two_tap(size: int, p: int, rho: list[int]) -> list[list[int]]:
+    """Return (I + 3P_rho)^-1 using a finite geometric identity."""
+    ratio = (-_TAP) % p
+    denominator = (1 - pow(ratio, size, p)) % p
+    if denominator == 0:
+        raise ValueError("I + 3P is singular for these parameters")
