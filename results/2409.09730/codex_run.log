+        for point in inst["frame_points"]:
+            coefficient = point["coordinates"][column]
+            if coefficient:
+                proposal = (
+                    -point["coordinates"][norm]
+                    * pow(coefficient, p - 2, p)
+                ) % p
+                counts[proposal] = counts.get(proposal, 0) + 1
