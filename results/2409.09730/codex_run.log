+                counts.items(), key=lambda item: (-item[1], item[0])
+            )
+            current = sum(value == 0 for value in residual)
+            if delta and gain > current:
+                row[column] = (row[column] + delta) % p
+                residual = [
+                    (
+                        residual[i]
+                        + delta * point["coordinates"][column]
+                    ) % p
+                    for i, point in enumerate(points)
+                ]
