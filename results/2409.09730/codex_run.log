+    matrix = [[0] * size for _ in range(size)]
+    for row in range(size):
+        column = row
+        coefficient = scale
+        for _ in range(size):
+            matrix[row][column] = coefficient
+            coefficient = coefficient * ratio % p
+            column = rho[column]
