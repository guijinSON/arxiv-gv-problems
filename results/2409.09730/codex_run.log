+    """Raise field entropy at fixed answer length before approaching any cap."""
+    if not isinstance(params, dict) or set(params) != {"n", "p"}:
+        return None
+    n = params["n"]
+    p = params["p"]
+    if n == 96 and p == 65537:
+        return {"n": 96, "p": 1_000_003}
+    if n == 96 and p == 1_000_003:
