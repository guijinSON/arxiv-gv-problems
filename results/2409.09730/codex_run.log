+            "label": inverse[point["label"]],
+            "coordinates": [
+                point["coordinates"][order[j]] for j in range(n)
+            ],
+        }
+        for point in inst["frame_points"]
+    ]
+    moved["answer"] = [[inst["answer"][0][order[j]] for j in range(n)]]
+    return moved
