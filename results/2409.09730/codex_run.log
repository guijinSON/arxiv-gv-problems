+def _last_column_by_label(inst: dict) -> list[int]:
+    n = inst["dimension"]
+    norm = inst["normalization_coordinate"]
+    values = [0] * n
+    for point in inst["frame_points"]:
+        values[point["label"]] = point["coordinates"][norm]
+    values[norm] = 0
+    return values
