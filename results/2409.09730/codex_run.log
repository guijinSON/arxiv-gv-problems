+
+def _gaussian_normal(inst: dict) -> tuple[list[list[int]] | None, int]:
+    """Generic modular elimination for the normalized nullspace."""
+    n = inst["dimension"]
+    p = inst["field_prime"]
+    norm = inst["normalization_coordinate"]
+    variables = [j for j in range(n) if j != norm]
+    aug = []
