+def _cycle_apply(inst: dict, values: list[int], steps: int = 1) -> list[int]:
+    rho = inst["cycle"]
+    norm = inst["normalization_coordinate"]
+    result = list(values)
+    for _ in range(steps):
+        previous = result
+        result = [0] * len(values)
+        for i in range(len(values)):
