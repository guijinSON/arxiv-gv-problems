+    if total is None or total > 200_000:
+        return None
+    n = inst["dimension"]
+    p = inst["field_prime"]
+    norm = inst["normalization_coordinate"]
+    active = [j for j in range(n) if j != norm]
+    row = [0] * n
+    row[norm] = 1
+    count = 0
+    for code in range(total):
+        value = code
+        for j in active:
+            row[j] = value % p
+            value //= p
+        count += int(verify(inst, [list(row)])[0])
+    return count
