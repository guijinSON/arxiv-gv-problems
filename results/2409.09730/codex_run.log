+    }
+
+    # G6: four failing no-tool attacks; elimination is separate for Track B.
+    attack_names = (
+        "outlier_one_column_fit",
+        "greedy_coordinate_repair",
+        "random_restart_256",
+        "obvious_cycle_ansatz",
