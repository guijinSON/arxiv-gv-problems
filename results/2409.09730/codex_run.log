+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON 1-by-n matrix [[h_0,...,h_(n-1)]] over GF(p), with every "
+        "entry in 0,...,p-1 and the stated normalization coordinate equal to 1."
