+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any normalized hyperplane covector by exact incidence tests."""
+    n = inst["dimension"]
+    p = inst["field_prime"]
+    norm = inst["normalization_coordinate"]
+    if not isinstance(answer, list):
