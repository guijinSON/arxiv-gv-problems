+    "bounds": {
+        "rows": 1,
+        "columns": "n",
+        "entry_min": 0,
+        "entry_max": "p-1",
+        "normalization_entry": 1,
+        "candidate_count": "p^(n-1)",
+        "max_shipping_rows": 1,
+        "max_shipping_columns": 72,
+        "max_shipping_prime": 4099,
