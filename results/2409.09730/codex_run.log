+
+    compact_answer = json.dumps(ship["answer"], separators=(",", ":"))
+    realistic = (
+        "The normal was obtained after modular reduction.\n```json\n"
+        f"<answer>\n{compact_answer}\n</answer>\n```\n"
+        "The tagged object is the requested one-row matrix."
