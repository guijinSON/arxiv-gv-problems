+    # G8: coordinates, point order, and projective representatives are labels.
+    invariant_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    unrelated_keys = []
+    for seed in range(20):
+        inst = make_instance(n=25, p=257, seed=20_000 + seed)
+        base_key = canonical_key(inst)
+        unrelated_keys.append(base_key)
