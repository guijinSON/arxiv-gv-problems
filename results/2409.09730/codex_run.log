+    }
+
+    # G4: candidates already satisfy all syntactic and normalization rules.
+    guess_rng = random.Random(0x240909730)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_t0 = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(
+            verify(ship, random_candidate(ship, guess_rng))[0]
