+    row[norm] = 1
+    points = inst["frame_points"]
+    residual = [point["coordinates"][norm] % p for point in points]
+    steps = 0
+    for _ in range(passes):
+        changed = False
+        for column in range(n):
+            if column == norm:
+                continue
