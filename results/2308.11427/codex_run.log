+        "swap": [answer[1], answer[0]] + answer[2:],
+        "duplicate": [answer[0], [answer[1][0], answer[0][1]]] + answer[2:],
+        "empty": [],
+        "out_of_range": [[answer[0][0], shipping["n"]]] + answer[1:],
+    }
+    rejection_reasons = {}
