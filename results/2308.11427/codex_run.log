    """Grow the ambient coefficient table at fixed six-term certificate length."""
    result = dict(params)
    factors = int(result.get("factors", 3))
    n = int(result.get("n", 8))
    if n < 256:
        result["n"] = min(256, n * 2)
        return result
    if factors < 384:
        result["factors"] = min(384, factors * 2)
        return result
    return None


