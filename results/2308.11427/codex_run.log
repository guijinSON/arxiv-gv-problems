+def random_candidate(inst: dict[str, Any], rng: random.Random) -> object:
+    """Sample uniformly from the statement-aware three-scalar certificate language."""
+    lambdas = [rng.randrange(1, inst["modulus"]) for _ in range(_BRANCHES)]
+    return _candidate_from_lambdas(inst, lambdas)
