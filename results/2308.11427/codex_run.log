/bin/bash -lc "python3 - <<'PY'
import importlib.util, itertools
s=importlib.util.spec_from_file_location('g','gen_2308_11427.py')
g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
for seed in range(8):
    inst=g.make_instance(seed=seed, **g.DIFFICULTY['demo'])
    p=inst['modulus']; coeff=[0]*inst['n']
    for branch in inst['branches']:
        rows=branch['dense_factors']
        for picks in itertools.product(range(inst['n']), repeat=len(rows)):
            left=1
            for row,j in zip(rows,picks): left=left*row[j]%p
            for tail,c in branch['terminal']:
                coeff[tail]=(coeff[tail]+left*c)%p
    brute=[[c,j] for j,c in enumerate(coeff) if c]
    assert brute == inst['answer'], (seed, brute, inst['answer'])
print('naive expansion agrees on 8 demo seeds')
