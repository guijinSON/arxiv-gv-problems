+        "doubled_n": doubled["n"],
+        "base_dense_coefficients": _BRANCHES * (shipping["degree"] - 1) * shipping["n"],
+        "doubled_dense_coefficients": _BRANCHES * (doubled["degree"] - 1) * doubled["n"],
+        "base_answer_terms": len(shipping["answer"]),
