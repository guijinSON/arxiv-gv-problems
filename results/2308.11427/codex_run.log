+        "pass": empirical < 1e-6,
+        "hits": sample_hits,
+        "total": sample_total,
+        "empirical_probability": empirical,
+        "candidate_space": search_space(shipping),
+        "exact_probability": 1.0 / search_space(shipping),
+        "prior": "uniform over three independent nonzero branch scalars; all stated shape and proportionality constraints enforced",
+    }
+
+    attack_stats = {
+        name: {"successes": 0, "attempts": 0}
+        for name in list(_attack_candidates(shipping)) + ["random_restart_256"]
