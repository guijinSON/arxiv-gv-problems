params = m.DIFFICULTY[m.SHIPPING_DIFFICULTY]
k1 = m.canonical_key(m.make_instance(**params, seed=4242))
k2 = m.canonical_key(m.make_instance(**params, seed=4242))
if not isinstance(k1,str) or k1 != k2:
