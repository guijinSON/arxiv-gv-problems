+def _permute_dense_coordinates(inst: dict[str, Any], seed: int) -> dict[str, Any]:
+    """Apply independent theorem-backed reassignments in nonfinal factors.
+
+    Corollary 3.6 makes a nonfinal linear factor act only through the sum of
+    its coefficients.  These are therefore genuine normal-form-preserving
+    symmetries of this problem family, although they are not global generator
+    relabellings.
+    """
+    rng = random.Random(seed)
+    transformed = {
+        key: value for key, value in inst.items() if key not in ("branches", "answer")
+    }
+    branches = []
+    for branch in inst["branches"]:
+        rows = [_shuffle_copy(row, rng) for row in branch["dense_factors"]]
+        branches.append(
+            {
+                "dense_factors": rows,
+                "terminal": [list(term) for term in branch["terminal"]],
+            }
+        )
+    transformed["branches"] = branches
+    transformed["answer"] = [list(term) for term in inst["answer"]]
+    return transformed
