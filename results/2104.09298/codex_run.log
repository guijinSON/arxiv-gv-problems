def ev(c,m):
 r=Fraction()
 for a in c:r=r*m+a
 return r
def sol(m):
 x=[(m-1)*ev(F[0],m),(m+1)*ev(F[0],-m),(m+1)**2*ev(F[1],-m),-(m-1)**2*ev(F[1],m)]
 y=[(m-1)*ev(F[2],m),(m+1)*ev(F[2],-m),-(m-1)*ev(F[3],m),-(m+1)*ev(F[3],-m)]
 for inds in ((('x',0),('x',1),('y',2),('y',3)),(('x',2),('x',3),('y',0),('y',1))):
  vals=[x[i] if z=='x' else y[i] for z,i in inds]
  L=1
  for v in vals:L=lcm(L,v.denominator)
  ints=[v.numerator*(L//v.denominator) for v in vals]
  g=0
  for v in ints:g=gcd(g,abs(v))
  mul=Fraction(L,g)
  for z,i in inds:
