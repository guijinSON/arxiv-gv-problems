+    (1, 7, 29, 44, 122, 98, 202, 92, 133, 15, 25),
+    (5, 21, 29, 202, 109, 755, 173, 1388, 23, 1259, -177, 426, -137, 45, -25),
+    (1, 6, 8, 57, 46, 184, 92, 294, 89, 202, 20, 25),
