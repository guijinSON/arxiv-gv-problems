+def canonical_key(inst) -> str:
+    """Canonicalize pair order, factor order, and the two sides of equality."""
+    def pair_key(pair):
+        if pair is None:
+            return ("missing", 0, 0)
+        a, b = sorted(pair)
+        return ("known", a, b)
