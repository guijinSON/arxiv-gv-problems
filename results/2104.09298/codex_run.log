-    # Equation (2.3): x-pair 1 and y-pair 2 use k1; x-pair 2 and
-    # y-pair 1 use k2.
-    pair_scales = (scales[0], scales[1], scales[1], scales[0])
-    entries = []
-    planted = None
-    for index, (pair, scale) in enumerate(zip(base_pairs, pair_scales)):
