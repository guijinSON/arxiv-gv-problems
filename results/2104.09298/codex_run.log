+def escalate(params) -> dict | str:
+    """Double the bounded haystack and crowd the fixed two-integer witness."""
+    p = dict(params)
+    p.pop("_preset", None)
+    p["n"] = int(p["n"]) * 2
+    p["crowding"] = min(95, int(p.get("crowding", 70)) + 2)
