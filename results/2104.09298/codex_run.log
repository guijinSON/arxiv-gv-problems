+            base_bound = max(abs(pair[0]), abs(pair[1]))
+            lo = (crowding * n + 100 * base_bound - 1) // (100 * base_bound)
+            hi = (95 * n) // (100 * base_bound)
+            if max(1, lo) <= hi:
