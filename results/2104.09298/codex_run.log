+
+def _required_fifth_sum(inst) -> int:
+    sides = inst["sides"]
+    missing = [(i, j) for i in range(2) for j in range(2)
+               if sides[i][j] is None]
+    if len(missing) != 1:
+        raise ValueError("instance must have one missing pair")
