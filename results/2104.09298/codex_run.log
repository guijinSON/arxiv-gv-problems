+def _equation_holds(sides) -> bool:
+    if any(pair is None for side in sides for pair in side):
+        return False
+    return (_pair_fifth_sum(sides[0][0]) * _pair_fifth_sum(sides[0][1])
+            == _pair_fifth_sum(sides[1][0]) * _pair_fifth_sum(sides[1][1]))
