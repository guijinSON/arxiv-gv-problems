-    n = int(n)
-    crowding = int(params.get("crowding", 70))
-    if n < 1:
-        raise ValueError("n must be a positive integer")
-    if n == 1:
-        return _demo_instance()
-    if not 1 <= crowding <= 95:
-        raise ValueError("crowding must lie in 1..95")
