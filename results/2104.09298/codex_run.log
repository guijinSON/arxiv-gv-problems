+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=20260905, **shipping_params)
+    p, q = inst["answer"]
+    corruptions = {
+        "drop_one": [p],
+        "swap": [q, p],
+        "duplicate": [p, p],
+        "empty": [],
+        "out_of_range": [p, inst["bound"] + 1],
+    }
+    corruption_results = {}
+    reasons = []
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
