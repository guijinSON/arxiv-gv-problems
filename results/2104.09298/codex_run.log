-    values = [
-        (m - 1) * f(0, m),
-        (m + 1) * f(0, -m),
-        (m + 1) ** 2 * f(1, -m),
-        -(m - 1) ** 2 * f(1, m),
-        (m - 1) * f(2, m),
-        (m + 1) * f(2, -m),
-        -(m - 1) * f(3, m),
-        -(m + 1) * f(3, -m),
