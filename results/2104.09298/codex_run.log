-def _demo_instance() -> dict:
-    # Section 3's first explicitly listed solution of (3.1), embedded in (1.1)
-    # by the factor 0^5+1^5=1.  Its three-element candidate space is hand-scale.
-    return {
-        "paper": "2104.09298",
-        "bound": 1,
-        "sides": [
-            [[-1, 8], [21, 25]],
-            [[109, 213], None],
-        ],
-        "answer": [0, 1],
