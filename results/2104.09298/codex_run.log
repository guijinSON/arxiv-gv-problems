+def _attack_balanced_consecutive(inst):
+    """The no-tool ansatz that the two missing integers are nearly equal."""
+    target = _required_fifth_sum(inst)
+    half = target // 2
+    center, _ = _exact_fifth_root(half)
+    if center is None:
