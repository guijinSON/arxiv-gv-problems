+def _permute_vertices(inst, old_to_new):
+    n = inst["n_vertices"]
+    if sorted(old_to_new) != list(range(n)):
+        raise ValueError("old_to_new must be a vertex permutation")
+    out = dict(inst)
+    out["target_cycle"] = [old_to_new[v] for v in inst["target_cycle"]]
+    return out
