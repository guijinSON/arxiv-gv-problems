+    def dfs(u):
+        nonlocal operations
+        for v in adjacency[u]:
+            operations += 1
+            mate = pair_v[v]
+            if mate < 0 or (dist[mate] == dist[u] + 1 and dfs(mate)):
+                pair_u[u] = v
+                pair_v[v] = u
+                return True
+        dist[u] = -1
+        return False
+
+    while bfs():
+        progress = 0
+        for u in range(k):
+            if pair_u[u] < 0 and dfs(u):
+                progress += 1
+        if not progress:
+            break
