import random, math

def trial(seed,k=48,n=2048,d=24):
 r=random.Random(seed)
 ar=r.choice([x for x in range(1,k) if math.gcd(x,k)==1]); br=r.randrange(k)
 ag=r.randrange(1,n,2); bg=r.randrange(n)
 inv=pow(ag,-1,n)
 active=[((q-bg)*inv)%n for q in range(k)]
 def rc(j): return (ar*j+br)%k
 def q(i): return (ag*i+bg)%n
 def ok(j,i): return q(i)<k and (q(i)-rc(j))%k<d
 # greedy j order, min index
 unused=set(active); ans=[]
 for j in range(k):
  opts=[i for i in unused if ok(j,i)]
  if not opts:return False,ar,br,ag,bg
  i=min(opts);unused.remove(i);ans.append(i)
 return all(ok(j,i) for j,i in enumerate(ans)),ar,br,ag,bg

