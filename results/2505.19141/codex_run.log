+def _affine_multiset_normal_form(values, modulus):
+    """Canonicalize a residue multiset under x -> u*x+c, u != 0."""
+    residues = [value % modulus for value in values]
+    support = sorted(set(residues))
+    if len(support) <= 1:
+        return [0] * len(residues)
+    best = None
+    for origin in support:
+        for unit_point in support:
+            if unit_point == origin:
+                continue
+            inverse = pow((unit_point - origin) % modulus, -1, modulus)
+            normalized = sorted(
+                (value - origin) * inverse % modulus for value in residues
+            )
+            if best is None or normalized < best:
+                best = normalized
+    return best
