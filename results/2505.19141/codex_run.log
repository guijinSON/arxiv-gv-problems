+    guess_rng = random.Random(0x250519141)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_start = time.perf_counter()
+    for _ in range(guess_total):
+        candidate = random_candidate(shipping, guess_rng)
+        guess_hits += int(verify(shipping, candidate)[0])
+    guess_seconds = time.perf_counter() - guess_start
+    guess_rate = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_total >= 200_000 and guess_rate < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_rate,
+        "exact_probability_numerator": 1,
+        "exact_probability_denominator": search_space(shipping),
+        "candidate_space": search_space(shipping),
+        "sampling_wall_clock_seconds": round(guess_seconds, 6),
+        "prior": "uniform over all length-k canonical residue tuples",
+    }
+
+    baseline_start = time.perf_counter()
+    reference_answer, reference_operations = _gauss_jordan_reference(shipping)
+    baseline_seconds = time.perf_counter() - baseline_start
+    reference_ok = reference_answer is not None and verify(shipping, reference_answer)[0]
+    compact_answer, compact_operations = _compact_route(shipping)
+    compact_ok = compact_answer is not None and verify(shipping, compact_answer)[0]
+    restart_rng = random.Random(0xB4511E)
+    restart_start = time.perf_counter()
+    restart_hit = False
+    for _ in range(256):
+        if verify(shipping, random_candidate(shipping, restart_rng))[0]:
+            restart_hit = True
+            break
+    restart_seconds = time.perf_counter() - restart_start
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_rate < 1e-6 and reference_ok and compact_ok and not restart_hit
+        and enumerate_all(demo) == 1,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_density_fraction": guess_rate,
+        "shipping_exact_solution_count_by_invertibility": 1,
+        "shipping_exact_enumeration": enumerate_all(shipping),
+        "demo_exact_solution_count": enumerate_all(demo),
+        "demo_candidate_space": search_space(demo),
+        "baseline_algorithm": "exact modular Gauss-Jordan elimination",
+        "baseline_wall_clock_seconds": round(baseline_seconds, 6),
+        "baseline_field_operations": reference_operations,
+        "baseline_verified": reference_ok,
+        "compact_route_field_operations": compact_operations,
+        "compact_route_verified": compact_ok,
+        "strongest_failing_attack": "256 structure-aware uniform restarts",
+        "strongest_attack_restarts": 256,
+        "strongest_attack_wall_clock_seconds": round(restart_seconds, 6),
+        "strongest_attack_succeeded": restart_hit,
+    }
+
+    attacks = {
+        "outlier_diagonal_coordinate": {"successes": 0, "attempts": 8},
+        "greedy_one_pass_coordinate": {"successes": 0, "attempts": 8},
+        "random_restart_256": {"successes": 0, "attempts": 8},
+        "in_context_target_equals_exponents": {"successes": 0, "attempts": 8},
+        "constant_average_ansatz": {"successes": 0, "attempts": 8},
+    }
+    reference_successes = 0
+    reference_times = []
+    reference_counts = []
+    attack_times = []
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        attack_start = time.perf_counter()
