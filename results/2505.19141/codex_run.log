+        "A list of exactly k canonical exponent residues z_0,...,z_{k-1}; "
+        "each entry is an integer in [0,p-1].  The module action has period p, "
+        "so these residues represent all integer exponent classes."
+    ),
+    "bounds": {
+        "max_exponents": 256,
+        "min_residue": 0,
+        "max_modulus": 2_147_483_647,
+        "max_atomic_elements": 256,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "modulus": 11},
+    "easy": {"n": 12, "modulus": 101},
+    "medium": {"n": 32, "modulus": 10_007},
+    "hard": {"n": 64, "modulus": 1_000_003},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT: str = (
+    "Hint: The dense action block is circulant, and its cyclic kernel is a wrapped geometric progression."
+)
