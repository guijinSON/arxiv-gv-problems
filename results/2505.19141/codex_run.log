def _mat_vec(matrix, vector, modulus):
    return [
        sum(coefficient * value for coefficient, value in zip(row, vector)) % modulus
        for row in matrix
    ]


def _build_circulant(k, modulus, ratio, shift):
    powers = [1]
    for _ in range(1, k):
        powers.append(powers[-1] * ratio % modulus)
    normalizer = pow((1 - pow(ratio, k, modulus)) % modulus, -1, modulus)
    kernel = [normalizer * powers[(d + shift) % k] % modulus for d in range(k)]
    return [
        [kernel[(row - column) % k] for column in range(k)]
        for row in range(k)
    ]


def make_instance(n, seed=0, **params) -> dict:
    """Inverse-generate a bounded S-unit equation and its exponent witness."""
    if not _is_int(n) or not 3 <= n <= CERTIFICATE_LANGUAGE["bounds"]["max_exponents"]:
        raise ValueError("n must be an integer from 3 through 256")
    if not _is_int(seed):
        raise ValueError("seed must be an integer")
    modulus = params.pop("modulus", 1_000_003)
    if params:
        raise TypeError("unknown make_instance parameters: " + ", ".join(sorted(params)))
    if (
        not _is_int(modulus)
        or modulus > CERTIFICATE_LANGUAGE["bounds"]["max_modulus"]
        or not _is_prime(modulus)
        or modulus <= n
    ):
        raise ValueError("modulus must be a prime greater than n and at most 2147483647")

    rng = random.Random(seed)
    # Small ratios keep the post-insight route executable without a calculator.
    # Filtering these public construction parameters never tests or repairs the
    # independently sampled certificate below.
    valid_ratios = [ratio for ratio in range(2, 10) if pow(ratio, n, modulus) != 1]
    if not valid_ratios:
        raise ValueError("no admissible small geometric ratio for these parameters")
    ratio = valid_ratios[rng.randrange(len(valid_ratios))]
    shift = rng.randrange(n)
    matrix = _build_circulant(n, modulus, ratio, shift)
    answer = [rng.randrange(modulus) for _ in range(n)]
    target = _mat_vec(matrix, answer, modulus)
    return {
        "family": "bounded_s_unit_square_zero_shear",
        "p": modulus,
        "k": n,
        "U": matrix,
        "target_top": target,
        "answer": answer,
    }


def render(inst) -> str:
    p = inst["p"]
    k = inst["k"]
    rows = "\n".join(
        f"  {index}: " + " ".join(str(value) for value in row)
        for index, row in enumerate(inst["U"])
    )
    target = " ".join(str(value) for value in inst["target_top"])
    example = ", ".join("0" for _ in range(k))
    statement = f"""Bounded S-unit equation in a finite module

All coordinates and all matrix arithmetic below are in the finite field F_p,
where p = {p}; write each field element as its canonical integer from 0 to {p - 1}.

Let M = F_p^k direct-sum F_p^k with k = {k}.  Write an element as (a | b),
where a and b are length-k column vectors.  Let the invertible Laurent generator
X act on M by

    X(a | b) = (a + U b | b).

Its inverse is X^(-1)(a | b) = (a - U b | b), so integer powers of X are
well-defined.  Rows and columns are indexed from 0.  The matrix U is:
{rows}

For i=0,...,{k - 1}, let e_i be the length-k vector with a 1 in coordinate i
and 0 elsewhere, and let s_i = (0 | e_i).  Let 1 denote the length-k all-ones
vector.  The target module element is b = (t | 1), where

        ),
        "hinted_verdict": evidence["hinted_verdict"],
        "answer_chars": answer_chars,
        "answer_tokens": answer_tokens,
        "answer_elements": answer_elements,
        "intended_route_operations": compact_operations,
        "within_caps": within_caps,
        "evidence_complete": all(
            arms[name]["attempts"] >= 3 for name in ("bare", "hinted", "placebo")
        ),
        "caps": {"chars": 2000, "elements": 256, "operations": 300},
    }

    report["track"] = TRACK
    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
    report["shipping_params"] = DIFFICULTY[SHIPPING_DIFFICULTY]
    report["certificate_language"] = CERTIFICATE_LANGUAGE
    report["all_passed"] = all(
        value.get("pass", False)
        for key, value in report.items()
        if key.startswith("G") and key[1:2].isdigit()
    )
    return report


