+
+def _build_circulant(k, modulus, ratio, shift):
+    powers = [1]
+    for _ in range(1, k):
+        powers.append(powers[-1] * ratio % modulus)
+    normalizer = pow((1 - pow(ratio, k, modulus)) % modulus, -1, modulus)
+    kernel = [normalizer * powers[(d + shift) % k] % modulus for d in range(k)]
+    return [
+        [kernel[(row - column) % k] for column in range(k)]
+        for row in range(k)
+    ]
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate a bounded S-unit equation and its exponent witness."""
+    if not _is_int(n) or not 3 <= n <= CERTIFICATE_LANGUAGE["bounds"]["max_exponents"]:
+        raise ValueError("n must be an integer from 3 through 256")
+    if not _is_int(seed):
