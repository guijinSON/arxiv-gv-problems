+
+def render(inst) -> str:
+    p = inst["p"]
+    k = inst["k"]
+    rows = "\n".join(
+        f"  {index}: " + " ".join(str(value) for value in row)
+        for index, row in enumerate(inst["U"])
+    )
+    target = " ".join(str(value) for value in inst["target_top"])
+    example = ", ".join("0" for _ in range(k))
+    statement = f"""Bounded S-unit equation in a finite module
+
+All coordinates and all matrix arithmetic below are in the finite field F_p,
+where p = {p}; write each field element as its canonical integer from 0 to {p - 1}.
+
+Let M = F_p^k direct-sum F_p^k with k = {k}.  Write an element as (a | b),
+where a and b are length-k column vectors.  Let the invertible Laurent generator
+X act on M by
+
+    X(a | b) = (a + U b | b).
+
+Its inverse is X^(-1)(a | b) = (a - U b | b), so integer powers of X are
+well-defined.  Rows and columns are indexed from 0.  The matrix U is:
+{rows}
+
+For i=0,...,{k - 1}, let e_i be the length-k vector with a 1 in coordinate i
+and 0 elsewhere, and let m_i = (0 | e_i).  Let 1 denote the length-k all-ones
+vector.  The target module element is m_0 = (t | 1), where
+
+    t = {target}
+
+Find exactly {k} integers z_0,...,z_{k - 1}, each in the inclusive range
+0 <= z_i < {p}, such that the following S-unit equation holds in M:
+
+    X^(z_0)m_0 + X^(z_1)m_1 + ... + X^(z_{k - 1})m_{k - 1} = (t | 1).
+
+In the displayed sum, the symbols m_0,...,m_{k - 1} refer to the standard
+bottom-basis vectors just defined; the right-hand target (t | 1) is not one of
+those summands.  Order matters, repetitions are allowed, and exponents are
+reported as their canonical residues modulo p.
+
+Give your final answer inside <answer></answer> tags, as the {k} base-10
+integers in order, separated by commas.
+Example format: <answer>{example}</answer>
+Output nothing else inside the tags."""
