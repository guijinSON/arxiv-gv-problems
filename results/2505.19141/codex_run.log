+    rhs = inst["target"][1:]
+    aug = [list(row) + [value] for row, value in zip(inst["action_columns"], rhs)]
+    field_operations = 0
+    euclidean_divisions = 0
+    row_swaps = 0
+    for col in range(n):
+        pivot = next((r for r in range(col, n) if aug[r][col] % p), None)
+        if pivot is None:
+            return None, {
