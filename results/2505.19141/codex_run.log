            preset_checks += 1
            presets_ok &= verify(inst, inst["answer"])[0]
            json_checks += int(json.loads(json.dumps(inst["answer"])) == inst["answer"])
    report["G1_planted_verifies"] = {
        "pass": presets_ok and preset_checks == 16 and json_checks == 16,
        "checks": preset_checks,
        "json_native_checks": json_checks,
        "presets": list(DIFFICULTY),
    }

    shipping = make_instance(seed=20260905, **DIFFICULTY[SHIPPING_DIFFICULTY])
    base = shipping["answer"]
    first_distinct = next(index for index in range(1, shipping["k"]) if base[index] != base[0])
    swapped = list(base)
    swapped[0], swapped[first_distinct] = swapped[first_distinct], swapped[0]
    duplicated = list(base)
    duplicated[first_distinct] = duplicated[0]
    corruptions = {
        "drop_one": base[:-1],
        "swap_two": swapped,
        "duplicate_one": duplicated,
        "empty": [],
        "out_of_range": base[:-1] + [shipping["p"]],
    }
    reasons = {}
    for name, candidate in corruptions.items():
        ok, reason = verify(shipping, candidate)
        reasons[name] = {"rejected": not ok, "reason": reason}
    report["G2_rejects_corruption"] = {
        "pass": all(item["rejected"] for item in reasons.values())
        and len({item["reason"] for item in reasons.values()}) == len(reasons),
        "corruptions": reasons,
        "distinct_reason_count": len({item["reason"] for item in reasons.values()}),
    }

    wire = ", ".join(str(value) for value in base)
    realistic = (
        "I used the module coordinates modulo p.\n"
        f"```text\n<answer>{wire}</answer>\n```\n"
        "The order is the stated summand order."
    )
    parsed = parse_answer(realistic)
    report["G3_round_trip"] = {
        "pass": parsed == base and json.loads(json.dumps(base)) == base,
        "parsed_equals_answer": parsed == base,
        "json_native": json.loads(json.dumps(base)) == base,
        "garbage_returns_none": parse_answer("no delimited answer here") is None,
    }

    guess_rng = random.Random(0x250519141)
    guess_total = 200_000
    guess_hits = 0
    guess_start = time.perf_counter()
    for _ in range(guess_total):
        candidate = random_candidate(shipping, guess_rng)
        guess_hits += int(verify(shipping, candidate)[0])
    guess_seconds = time.perf_counter() - guess_start
    guess_rate = guess_hits / guess_total

