+        "doubled_n": doubled["k"],
+        "shipping_matrix_entries": shipping["k"] ** 2,
+        "doubled_matrix_entries": doubled["k"] ** 2,
+        "shipping_search_space_bits": search_space(shipping).bit_length(),
+        "doubled_search_space_bits": search_space(doubled).bit_length(),
