+            return parsed
+        return None
+    if not body or not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
+        return None
+    try:
+        return [int(piece.strip()) for piece in body.split(",")]
+    except ValueError:
+        return None
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    if answer is None:
+        return False, "answer is absent"
+    if not isinstance(answer, list):
+        return False, "answer must be a list of exponent residues"
+    if not answer:
+        return False, "answer list is empty"
+    k = inst["k"]
+    p = inst["p"]
+    if len(answer) != k:
+        return False, f"expected exactly {k} exponents, got {len(answer)}"
+    for index, value in enumerate(answer):
+        if not _is_int(value):
+            return False, f"exponent {index} is not an integer"
+        if not 0 <= value < p:
+            return False, f"exponent {index} is outside the inclusive range 0..{p - 1}"
+    for row_index, (row, expected) in enumerate(zip(inst["U"], inst["target_top"])):
+        actual = sum(coefficient * value for coefficient, value in zip(row, answer)) % p
+        if actual != expected:
+            return False, (
+                f"module equation fails at top coordinate {row_index}: "
+                f"got {actual}, expected {expected}"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample the exact shape/range-constrained certificate language."""
+    return [rng.randrange(inst["p"]) for _ in range(inst["k"])]
+
+
+def search_space(inst) -> int | None:
+    return inst["p"] ** inst["k"]
+
+
+def enumerate_all(inst) -> int | None:
+    size = search_space(inst)
+    if size is None or size > _ENUMERATION_CAP:
+        return None
+    count = 0
+    for candidate in itertools.product(range(inst["p"]), repeat=inst["k"]):
+        count += int(verify(inst, list(candidate))[0])
+    return count
+
+
+def canonical_key(inst) -> str:
+    """A cheap invariant under independent row and column relabellings.
+
+    Full bipartite matrix canonisation would be graph-isomorphism-like.  The
+    sorted row/target signatures and column multisets are a stronger cheap
+    invariant than an entry multiset, while remaining invariant under every
+    coordinate and summand permutation.
+    """
+    row_signatures = sorted(
+        (inst["target_top"][row], tuple(sorted(inst["U"][row])))
+        for row in range(inst["k"])
+    )
+    column_signatures = sorted(
+        tuple(sorted(inst["U"][row][column] for row in range(inst["k"])))
+        for column in range(inst["k"])
+    )
+    payload = {
+        "p": inst["p"],
+        "k": inst["k"],
+        "rows": row_signatures,
+        "columns": column_signatures,
+    }
+    blob = json.dumps(payload, separators=(",", ":"), sort_keys=True)
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params) -> dict | str | None:
+    """Raise coefficient entropy first, then witness length up to the G9 cap."""
+    harder = dict(params)
+    current_prime = harder.get("modulus", 1_000_003)
+    for prime in _ESCALATION_PRIMES:
+        if prime > current_prime:
+            harder["modulus"] = prime
+            return harder
+    current_n = harder.get("n", 64)
+    if current_n < 96:
+        harder["n"] = 96
+        return harder
+    if current_n < 128:
+        harder["n"] = 128
+        return harder
+    return "cap_bound"
+
+
+def _gauss_jordan_reference(inst):
+    """Solve U z=t exactly and return (answer, counted field operations)."""
+    p = inst["p"]
+    k = inst["k"]
+    augmented = [
+        [value % p for value in row] + [rhs % p]
+        for row, rhs in zip(inst["U"], inst["target_top"])
+    ]
+    operations = 0
+    for column in range(k):
+        pivot = next((row for row in range(column, k) if augmented[row][column]), None)
+        if pivot is None:
+            return None, operations
+        if pivot != column:
+            augmented[column], augmented[pivot] = augmented[pivot], augmented[column]
+        inverse = pow(augmented[column][column], -1, p)
+        operations += 1
+        for entry in range(column, k + 1):
+            augmented[column][entry] = augmented[column][entry] * inverse % p
+            operations += 1
+        for row in range(k):
+            if row == column:
+                continue
+            factor = augmented[row][column]
+            if factor == 0:
+                continue
+            for entry in range(column, k + 1):
+                augmented[row][entry] = (
+                    augmented[row][entry] - factor * augmented[column][entry]
+                ) % p
+                operations += 2
+    return [augmented[row][k] for row in range(k)], operations
+
+
+def _compact_route(inst):
+    """Recognize and apply the wrapped-geometric cyclic first difference."""
+    p = inst["p"]
+    k = inst["k"]
+    kernel = [inst["U"][row][0] for row in range(k)]
+    operations = 0
+    ratios = []
+    for edge in range(3):
+        inverse = pow(kernel[edge], -1, p)
+        ratios.append(kernel[(edge + 1) % k] * inverse % p)
+        operations += 2
+    ratio = max(set(ratios), key=ratios.count)
+    wrap = None
+    for edge in range(k):
+        difference = (kernel[(edge + 1) % k] - ratio * kernel[edge]) % p
+        operations += 2
+        if difference:
+            if wrap is not None:
+                return None, operations
+            wrap = edge
+            if difference != 1:
+                return None, operations
+    if wrap is None:
+        return None, operations
+    answer = [0] * k
+    target = inst["target_top"]
+    for row in range(k):
+        value = (target[(row + 1) % k] - ratio * target[row]) % p
+        operations += 2
+        answer[(row - wrap) % k] = value
+    return answer, operations
+
+
+def _attack_diagonal(inst):
+    p = inst["p"]
+    return [
+        inst["target_top"][index] * pow(inst["U"][index][index], -1, p) % p
+        for index in range(inst["k"])
+    ]
+
+
+def _attack_greedy(inst):
+    p = inst["p"]
+    k = inst["k"]
+    candidate = [0] * k
+    for column in range(k):
+        residual = inst["target_top"][column]
+        residual -= sum(
+            inst["U"][column][prior] * candidate[prior]
+            for prior in range(column)
+        )
+        candidate[column] = residual * pow(inst["U"][column][column], -1, p) % p
+    return candidate
+
+
+def _attack_target_as_answer(inst):
+    return list(inst["target_top"])
+
+
+def _attack_constant(inst):
+    value = sum(inst["target_top"]) * pow(inst["k"], -1, inst["p"]) % inst["p"]
+    return [value] * inst["k"]
+
+
+def _relabel(inst, row_permutation, column_permutation):
+    k = inst["k"]
+    transformed = {
+        "family": inst["family"],
+        "p": inst["p"],
+        "k": k,
+        "U": [
+            [inst["U"][row_permutation[row]][column_permutation[column]] for column in range(k)]
+            for row in range(k)
+        ],
+        "target_top": [inst["target_top"][row_permutation[row]] for row in range(k)],
+        "answer": [inst["answer"][column_permutation[column]] for column in range(k)],
+    }
+    return transformed
+
+
+def _answer_atoms(answer):
+    if isinstance(answer, dict):
+        return sum(_answer_atoms(value) for value in answer.values())
+    if isinstance(answer, (list, tuple)):
+        return sum(_answer_atoms(value) for value in answer)
+    return 1
+
+
+def selftest() -> dict:
+    report = {}
+    presets_ok = True
+    preset_checks = 0
+    json_checks = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7, 29):
+            inst = make_instance(seed=seed, **params)
+            preset_checks += 1
+            presets_ok &= verify(inst, inst["answer"])[0]
+            json_checks += int(json.loads(json.dumps(inst["answer"])) == inst["answer"])
+    report["G1_planted_verifies"] = {
+        "pass": presets_ok and preset_checks == 16 and json_checks == 16,
+        "checks": preset_checks,
+        "json_native_checks": json_checks,
+        "presets": list(DIFFICULTY),
+    }
+
+    shipping = make_instance(seed=20260905, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    base = shipping["answer"]
+    first_distinct = next(index for index in range(1, shipping["k"]) if base[index] != base[0])
+    swapped = list(base)
+    swapped[0], swapped[first_distinct] = swapped[first_distinct], swapped[0]
+    duplicated = list(base)
+    duplicated[first_distinct] = duplicated[0]
+    corruptions = {
+        "drop_one": base[:-1],
+        "swap_two": swapped,
+        "duplicate_one": duplicated,
+        "empty": [],
+        "out_of_range": base[:-1] + [shipping["p"]],
+    }
+    reasons = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
+        reasons[name] = {"rejected": not ok, "reason": reason}
+    report["G2_rejects_corruption"] = {
+        "pass": all(item["rejected"] for item in reasons.values())
+        and len({item["reason"] for item in reasons.values()}) == len(reasons),
+        "corruptions": reasons,
+        "distinct_reason_count": len({item["reason"] for item in reasons.values()}),
+    }
+
+    wire = ", ".join(str(value) for value in base)
+    realistic = (
+        "I used the module coordinates modulo p.\n"
+        f"```text\n<answer>{wire}</answer>\n```\n"
+        "The order is the stated summand order."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == base and json.loads(json.dumps(base)) == base,
+        "parsed_equals_answer": parsed == base,
+        "json_native": json.loads(json.dumps(base)) == base,
+        "garbage_returns_none": parse_answer("no delimited answer here") is None,
+    }
+
+    guess_rng = random.Random(0x250519141)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_start = time.perf_counter()
+    for _ in range(guess_total):
+        candidate = random_candidate(shipping, guess_rng)
+        guess_hits += int(verify(shipping, candidate)[0])
+    guess_seconds = time.perf_counter() - guess_start
+    guess_rate = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_total >= 200_000 and guess_rate < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_rate,
+        "exact_probability_numerator": 1,
+        "exact_probability_denominator": search_space(shipping),
+        "candidate_space": search_space(shipping),
+        "sampling_wall_clock_seconds": round(guess_seconds, 6),
+        "prior": "uniform over all length-k canonical residue tuples",
+    }
+
+    baseline_start = time.perf_counter()
+    reference_answer, reference_operations = _gauss_jordan_reference(shipping)
+    baseline_seconds = time.perf_counter() - baseline_start
+    reference_ok = reference_answer is not None and verify(shipping, reference_answer)[0]
+    compact_answer, compact_operations = _compact_route(shipping)
+    compact_ok = compact_answer is not None and verify(shipping, compact_answer)[0]
+    restart_rng = random.Random(0xB4511E)
+    restart_start = time.perf_counter()
+    restart_hit = False
+    for _ in range(256):
+        if verify(shipping, random_candidate(shipping, restart_rng))[0]:
+            restart_hit = True
+            break
+    restart_seconds = time.perf_counter() - restart_start
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_rate < 1e-6 and reference_ok and compact_ok and not restart_hit
+        and enumerate_all(demo) == 1,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_density_fraction": guess_rate,
+        "shipping_exact_solution_count_by_invertibility": 1,
+        "shipping_exact_enumeration": enumerate_all(shipping),
+        "demo_exact_solution_count": enumerate_all(demo),
+        "demo_candidate_space": search_space(demo),
+        "baseline_algorithm": "exact modular Gauss-Jordan elimination",
+        "baseline_wall_clock_seconds": round(baseline_seconds, 6),
+        "baseline_field_operations": reference_operations,
+        "baseline_verified": reference_ok,
+        "compact_route_field_operations": compact_operations,
+        "compact_route_verified": compact_ok,
+        "strongest_failing_attack": "256 structure-aware uniform restarts",
+        "strongest_attack_restarts": 256,
+        "strongest_attack_wall_clock_seconds": round(restart_seconds, 6),
+        "strongest_attack_succeeded": restart_hit,
+    }
+
+    attacks = {
+        "outlier_diagonal_coordinate": {"successes": 0, "attempts": 8},
+        "greedy_one_pass_coordinate": {"successes": 0, "attempts": 8},
+        "random_restart_256": {"successes": 0, "attempts": 8},
+        "in_context_target_equals_exponents": {"successes": 0, "attempts": 8},
+        "constant_average_ansatz": {"successes": 0, "attempts": 8},
+    }
+    reference_successes = 0
+    reference_times = []
+    reference_counts = []
+    attack_times = []
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        attack_start = time.perf_counter()
+        direct_candidates = {
+            "outlier_diagonal_coordinate": _attack_diagonal(inst),
+            "greedy_one_pass_coordinate": _attack_greedy(inst),
+            "in_context_target_equals_exponents": _attack_target_as_answer(inst),
+            "constant_average_ansatz": _attack_constant(inst),
+        }
+        for name, candidate in direct_candidates.items():
+            attacks[name]["successes"] += int(verify(inst, candidate)[0])
+        attack_rng = random.Random(seed ^ 0xA77AC)
+        hit = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, attack_rng))[0]:
+                hit = True
+                break
+        attacks["random_restart_256"]["successes"] += int(hit)
+        attack_times.append(time.perf_counter() - attack_start)
+
+        reference_start = time.perf_counter()
+        recovered, operations = _gauss_jordan_reference(inst)
+        reference_times.append(time.perf_counter() - reference_start)
+        reference_counts.append(operations)
+        reference_successes += int(recovered is not None and verify(inst, recovered)[0])
+    all_failed = all(
+        result["successes"] == 0 and result["attempts"] >= 8
+        for result in attacks.values()
+    )
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attacks,
+        "strongest_failing_attack_wall_clock_sec_mean": round(sum(attack_times) / 8, 6),
+        "reference_algorithm": {
+            "name": "exact modular Gauss-Jordan elimination",
+            "complexity": "O(k^3) finite-field operations",
+            "wall_clock_sec_mean": round(sum(reference_times) / 8, 6),
+            "wall_clock_sec_max": round(max(reference_times), 6),
+            "operations_mean": round(sum(reference_counts) / 8),
+            "operations_max": max(reference_counts),
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    doubled = make_instance(
+        n=2 * DIFFICULTY[SHIPPING_DIFFICULTY]["n"],
+        modulus=DIFFICULTY[SHIPPING_DIFFICULTY]["modulus"],
+        seed=2718,
+    )
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["k"] == 2 * shipping["k"]
+        and search_space(doubled) > search_space(shipping),
+        "shipping_n": shipping["k"],
+        "doubled_n": doubled["k"],
+        "shipping_matrix_entries": shipping["k"] ** 2,
+        "doubled_matrix_entries": doubled["k"] ** 2,
+        "shipping_search_space_bits": search_space(shipping).bit_length(),
+        "doubled_search_space_bits": search_space(doubled).bit_length(),
+        "doubled_planted_verifies": doubled_ok,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    changed_serializations = 0
+    transformations_per_seed = 3
+    for seed in range(20):
+        inst = make_instance(seed=1000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(inst)
+        rng = random.Random(9000 + seed)
+        identity = list(range(inst["k"]))
+        row_perm = list(identity)
+        col_perm = list(identity)
+        rng.shuffle(row_perm)
+        rng.shuffle(col_perm)
+        transformations = [
+            (row_perm, identity),
+            (identity, col_perm),
+            (row_perm, col_perm),
+        ]
+        original_blob = json.dumps(
+            [inst["U"], inst["target_top"]], separators=(",", ":")
+        )
+        for rows, columns in transformations:
+            transformed = _relabel(inst, rows, columns)
+            invariance_checks += int(canonical_key(transformed) == key)
+            carried_checks += int(verify(transformed, transformed["answer"])[0])
+            transformed_blob = json.dumps(
+                [transformed["U"], transformed["target_top"]], separators=(",", ":")
+            )
+            changed_serializations += int(transformed_blob != original_blob)
+    unrelated = [
+        canonical_key(make_instance(seed=2000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY]))
+        for seed in range(20)
+    ]
+    attempted = 20 * transformations_per_seed
+    report["G8_canonical_key"] = {
+        "pass": invariance_checks == attempted and carried_checks == attempted
+        and changed_serializations == attempted and len(set(unrelated)) == 20,
+        "transformations": [
+            "module top-coordinate permutation",
+            "S-unit summand/unknown permutation",
+            "both transformations composed",
+        ],
+        "invariance_checks_passed": invariance_checks,
+        "invariance_checks_attempted": attempted,
+        "carried_witness_checks_passed": carried_checks,
+        "carried_witness_checks_attempted": attempted,
+        "changed_serializations": changed_serializations,
+        "unrelated_distinct_keys": len(set(unrelated)),
+        "unrelated_attempts": len(unrelated),
+        "key_kind": "hash of row/column-permutation-invariant structural signatures",
+    }
+
+    answer_blobs = [
+        json.dumps(
+            make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])["answer"],
+            separators=(",", ":"),
+        )
+        for seed in range(20)
+    ]
+    answer_chars = max(map(len, answer_blobs))
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(shipping["answer"])
+    evidence = _G9_EVIDENCE or {
+        "arms": {
+            "bare": {"solved": 0, "attempts": 0},
+            "hinted": {"solved": 0, "attempts": 0},
+            "placebo": {"solved": 0, "attempts": 0},
+        },
+        "hinted_verdict": "pending",
+    }
+    arms = evidence["arms"]
+    hinted_rate = (
+        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+        if arms["hinted"]["attempts"] else None
+    )
+    placebo_rate = (
+        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        if arms["placebo"]["attempts"] else None
+    )
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and compact_operations <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": (
+            hinted_rate - placebo_rate
+            if hinted_rate is not None and placebo_rate is not None else None
+        ),
+        "hinted_verdict": evidence["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": compact_operations,
+        "within_caps": within_caps,
+        "evidence_complete": all(
+            arms[name]["attempts"] >= 3 for name in ("bare", "hinted", "placebo")
+        ),
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = DIFFICULTY[SHIPPING_DIFFICULTY]
+    report["certificate_language"] = CERTIFICATE_LANGUAGE
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and key[1:2].isdigit()
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

diff --git a/gen_2505_19141.py b/gen_2505_19141.py
new file mode 100644
index 0000000000000000000000000000000000000000..ae6036fa7c7963a6a61a81e857356384841f6bd9
--- /dev/null
+++ b/gen_2505_19141.py
@@ -0,0 +1,834 @@
+"""Native S-unit equations over finite modules for arXiv:2505.19141.
+
+The paper studies equations in which Laurent monomials act on elements of a
+finitely presented module.  Here the module is M = F_p^k + F_p^k and the one
+Laurent generator X acts by a square-zero shear
+
+    X(a, b) = (a + U b, b).
+
+For the standard bottom-basis vectors m_i, the equation
+sum_i X**z_i m_i = (t, 1) is exactly U z = t modulo p.  The generator samples
+z first and constructs t, so it never solves a generated instance.  U is a
+dense wrapped-geometric circulant.  Generic modular Gaussian elimination is
+the honest Track-B reference algorithm; recognizing the circulant invariant
+turns its inverse into one cyclic first difference.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "finite-dimensional module over F_p[X^{+1},X^{-1}]",
+        "invertible matrix action of the Laurent generator X",
+        "module vectors in F_p^k direct-sum F_p^k",
+        "integer exponent tuple",
+    ],
+    "verification_operations": [
+        "exact modular monomial-action substitution",
+        "exact finite-field vector addition",
+        "coordinatewise equality in the presented module",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "A dense circulant action has a wrapped-geometric kernel, so one cyclic "
+        "first difference inverts it; without recognizing this invariant a solver "
+        "faces a dense modular linear system."
+    ),
+    "hardness_basis": (
+        "Track B: Gauss-Jordan elimination over F_p solves the promised family in "
+        "O(k^3) field operations; at the hard preset (k=64, p=1000003) the exact "
+        "reference implementation measured 17689 field operations and 0.0141 "
+        "seconds mean over eight shipping seeds, while the wrapped-geometric "
+        "first-difference route uses at most 266 field operations and must be "
+        "recognized and executed without tools."
+    ),
+    "max_answer_tokens": 112,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A list of exactly k canonical exponent residues z_0,...,z_{k-1}; "
+        "each entry is an integer in [0,p-1].  The module action has period p, "
+        "so these residues represent all integer exponent classes."
+    ),
+    "bounds": {
+        "max_exponents": 256,
+        "min_residue": 0,
+        "max_modulus": 2_147_483_647,
+        "max_atomic_elements": 256,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "modulus": 11},
+    "easy": {"n": 12, "modulus": 101},
+    "medium": {"n": 32, "modulus": 10_007},
+    "hard": {"n": 64, "modulus": 1_000_003},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT: str = (
+    "Hint: The dense action block is circulant, and its cyclic kernel is a wrapped geometric progression."
+)
+PLACEBO_HINT: str = (
+    "Hint: The dense action table rewards careful attention to the modular arithmetic and coordinate indexing."
