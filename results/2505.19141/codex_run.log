+
+def escalate(params) -> dict | str | None:
+    """Raise coefficient entropy first, then witness length up to the G9 cap."""
+    harder = dict(params)
+    current_prime = harder.get("modulus", 1_000_003)
+    for prime in _ESCALATION_PRIMES:
+        if prime > current_prime:
+            harder["modulus"] = prime
+            return harder
