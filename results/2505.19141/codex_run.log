index 0000000000000000000000000000000000000000..1a4f51f38307dda06149568fd3e1b3d4c4f9e560
--- /dev/null
+++ b/gen_2505_19141.py
@@ -0,0 +1,879 @@
+"""Native S-unit equations over finite modules for arXiv:2505.19141.
+
+The paper studies equations in which Laurent monomials act on elements of a
+finitely presented module.  Here the module is M = F_p^k + F_p^k and the one
+Laurent generator X acts by a square-zero shear
+
+    X(a, b) = (a + U b, b).
+
+For the standard bottom-basis vectors m_i, the equation
+sum_i X**z_i m_i = (t, 1) is exactly U z = t modulo p.  The generator samples
+z first and constructs t, so it never solves a generated instance.  U is a
+dense wrapped-geometric circulant.  Generic modular Gaussian elimination is
+the honest Track-B reference algorithm; recognizing the circulant invariant
+turns its inverse into one cyclic first difference.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "finite-dimensional module over F_p[X^{+1},X^{-1}]",
+        "invertible matrix action of the Laurent generator X",
+        "module vectors in F_p^k direct-sum F_p^k",
+        "integer exponent tuple",
+    ],
+    "verification_operations": [
+        "exact modular monomial-action substitution",
+        "exact finite-field vector addition",
+        "coordinatewise equality in the presented module",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "A dense circulant action has a wrapped-geometric kernel, so one cyclic "
+        "first difference inverts it; without recognizing this invariant a solver "
+        "faces a dense modular linear system."
+    ),
+    "hardness_basis": (
+        "Track B: Gauss-Jordan elimination over F_p solves the promised family in "
+        "O(k^3) field operations; at the hard preset (k=64, p=1000003) the exact "
+        "reference implementation measured 30219 field operations and 0.002143 "
+        "seconds mean over eight shipping seeds in the recorded final selftest, "
+        "while the wrapped-geometric "
+        "first-difference route uses at most 280 field operations and must be "
+        "recognized and executed without tools."
+    ),
+    "max_answer_tokens": 112,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A list of exactly k canonical exponent residues z_0,...,z_{k-1}; "
+        "each entry is an integer in [0,p-1].  The module action has period p, "
+        "so these residues represent all integer exponent classes."
+    ),
+    "bounds": {
+        "max_exponents": 256,
+        "min_residue": 0,
+        "max_modulus": 2_147_483_647,
+        "max_atomic_elements": 256,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "modulus": 11},
+    "easy": {"n": 12, "modulus": 101},
+    "medium": {"n": 32, "modulus": 10_007},
+    "hard": {"n": 64, "modulus": 1_000_003},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT: str = (
+    "Hint: The dense action block is circulant, and its cyclic kernel is a wrapped geometric progression."
+)
+PLACEBO_HINT: str = (
+    "Hint: The dense action table rewards careful attention to the modular arithmetic and coordinate indexing."
+)
+
+# These are scored attempts, not HTTP calls: all three script-owned runs stopped
+# on four quota errors before an oracle answer, so no error is counted as a model
+# failure.  The diagnostic is separate from G9's remaining size/effort gate.
+_G9_EVIDENCE = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0, "error_calls": 4},
+        "hinted": {"solved": 0, "attempts": 0, "error_calls": 4},
+        "placebo": {"solved": 0, "attempts": 0, "error_calls": 4},
