+        return {"n": min(42, n + 4), "field": "m31"}
+    next_field = {"m31": "m61", "m61": "m89", "m89": "m127"}.get(field)
+    if next_field is not None:
+        return {"n": n, "field": next_field}
+    if field == "m127":
+        return "cap_bound"
+    return None
 
