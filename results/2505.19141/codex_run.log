+        "sampling_wall_clock_seconds": round(guess_seconds, 6),
+        "prior": "uniform over all length-k canonical residue tuples",
+    }
+
+    baseline_start = time.perf_counter()
+    reference_answer, reference_operations = _gauss_jordan_reference(shipping)
+    baseline_seconds = time.perf_counter() - baseline_start
+    reference_ok = reference_answer is not None and verify(shipping, reference_answer)[0]
+    compact_answer, compact_operations = _compact_route(shipping)
+    compact_ok = compact_answer is not None and verify(shipping, compact_answer)[0]
+    restart_rng = random.Random(0xB4511E)
+    restart_start = time.perf_counter()
+    restart_hit = False
+    for _ in range(256):
+        if verify(shipping, random_candidate(shipping, restart_rng))[0]:
+            restart_hit = True
+            break
+    restart_seconds = time.perf_counter() - restart_start
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
