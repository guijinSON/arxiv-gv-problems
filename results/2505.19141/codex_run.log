+        "A list of exactly k canonical exponent residues z_0,...,z_{k-1}; "
+        "each entry is an integer in [0,p-1].  The module action has period p, "
+        "so these residues represent all integer exponent classes."
+    ),
+    "bounds": {
+        "max_exponents": 256,
+        "min_residue": 0,
+        "max_modulus": 2_147_483_647,
+        "max_atomic_elements": 256,
+    },
+}
