+    if (
+        not _is_int(modulus)
+        or modulus > CERTIFICATE_LANGUAGE["bounds"]["max_modulus"]
+        or not _is_prime(modulus)
+        or modulus <= n
+    ):
+        raise ValueError("modulus must be a prime greater than n and at most 2147483647")
