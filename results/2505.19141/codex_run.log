+def _inverse_counted(a, p):
+    a %= p
+    if a == 0:
+        raise ZeroDivisionError("zero has no inverse")
+    old_r, r = a, p
+    old_s, s = 1, 0
+    divisions = 0
+    while r:
+        quotient = old_r // r
+        old_r, r = r, old_r - quotient * r
+        old_s, s = s, old_s - quotient * s
+        divisions += 1
+    if old_r != 1:
+        raise ZeroDivisionError("element is not invertible")
+    return old_s % p, divisions
 
