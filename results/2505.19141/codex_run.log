+def canonical_key(inst) -> str:
+    """A cheap invariant under independent row and column relabellings.
+
+    Full bipartite matrix canonisation would be graph-isomorphism-like.  The
+    sorted row/target signatures and column multisets are a stronger cheap
+    invariant than an entry multiset, while remaining invariant under every
+    coordinate and summand permutation.
+    """
+    row_signatures = sorted(
+        (inst["target_top"][row], tuple(sorted(inst["U"][row])))
+        for row in range(inst["k"])
+    )
+    column_signatures = sorted(
+        tuple(sorted(inst["U"][row][column] for row in range(inst["k"])))
+        for column in range(inst["k"])
+    )
+    payload = {
+        "p": inst["p"],
+        "k": inst["k"],
+        "rows": row_signatures,
+        "columns": column_signatures,
+    }
+    blob = json.dumps(payload, separators=(",", ":"), sort_keys=True)
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
