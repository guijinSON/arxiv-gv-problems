+def _gauss_jordan_reference(inst):
+    """Solve U z=t exactly and return (answer, counted field operations)."""
+    p = inst["p"]
+    k = inst["k"]
+    augmented = [
+        [value % p for value in row] + [rhs % p]
+        for row, rhs in zip(inst["U"], inst["target_top"])
+    ]
+    operations = 0
+    for column in range(k):
+        pivot = next((row for row in range(column, k) if augmented[row][column]), None)
+        if pivot is None:
+            return None, operations
+        if pivot != column:
+            augmented[column], augmented[pivot] = augmented[pivot], augmented[column]
+        inverse = pow(augmented[column][column], -1, p)
+        operations += 1
+        for entry in range(column, k + 1):
+            augmented[column][entry] = augmented[column][entry] * inverse % p
+            operations += 1
+        for row in range(k):
+            if row == column:
+                continue
+            factor = augmented[row][column]
+            if factor == 0:
+                continue
+            for entry in range(column, k + 1):
+                augmented[row][entry] = (
+                    augmented[row][entry] - factor * augmented[column][entry]
+                ) % p
+                operations += 2
+    return [augmented[row][k] for row in range(k)], operations
+
+
+def _compact_route(inst):
+    """Recognize and apply the wrapped-geometric cyclic first difference."""
+    p = inst["p"]
+    k = inst["k"]
+    kernel = [inst["U"][row][0] for row in range(k)]
+    operations = 0
+    ratios = []
+    for edge in range(3):
+        inverse = pow(kernel[edge], -1, p)
+        ratios.append(kernel[(edge + 1) % k] * inverse % p)
+        operations += 2
+    ratio = max(set(ratios), key=ratios.count)
+    wrap = None
+    for edge in range(k):
+        difference = (kernel[(edge + 1) % k] - ratio * kernel[edge]) % p
+        operations += 2
+        if difference:
+            if wrap is not None:
+                return None, operations
+            wrap = edge
+            if difference != 1:
+                return None, operations
+    if wrap is None:
+        return None, operations
+    answer = [0] * k
+    target = inst["target_top"]
+    for row in range(k):
+        value = (target[(row + 1) % k] - ratio * target[row]) % p
+        operations += 2
+        answer[(row - wrap) % k] = value
+    return answer, operations
+
