+            "outlier_diagonal_coordinate": _attack_diagonal(inst),
+            "greedy_one_pass_coordinate": _attack_greedy(inst),
+            "in_context_target_equals_exponents": _attack_target_as_answer(inst),
+            "constant_average_ansatz": _attack_constant(inst),
+        }
+        for name, candidate in direct_candidates.items():
+            attacks[name]["successes"] += int(verify(inst, candidate)[0])
+        attack_rng = random.Random(seed ^ 0xA77AC)
+        hit = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, attack_rng))[0]:
+                hit = True
+                break
+        attacks["random_restart_256"]["successes"] += int(hit)
+        attack_times.append(time.perf_counter() - attack_start)
+
+        reference_start = time.perf_counter()
+        recovered, operations = _gauss_jordan_reference(inst)
+        reference_times.append(time.perf_counter() - reference_start)
+        reference_counts.append(operations)
+        reference_successes += int(recovered is not None and verify(inst, recovered)[0])
+    all_failed = all(
+        result["successes"] == 0 and result["attempts"] >= 8
+        for result in attacks.values()
+    )
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attacks,
+        "strongest_failing_attack_wall_clock_sec_mean": round(sum(attack_times) / 8, 6),
+        "reference_algorithm": {
+            "name": "exact modular Gauss-Jordan elimination",
+            "complexity": "O(k^3) finite-field operations",
+            "wall_clock_sec_mean": round(sum(reference_times) / 8, 6),
+            "wall_clock_sec_max": round(max(reference_times), 6),
+            "operations_mean": round(sum(reference_counts) / 8),
+            "operations_max": max(reference_counts),
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    doubled = make_instance(
+        n=2 * DIFFICULTY[SHIPPING_DIFFICULTY]["n"],
+        modulus=DIFFICULTY[SHIPPING_DIFFICULTY]["modulus"],
+        seed=2718,
+    )
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["k"] == 2 * shipping["k"]
+        and search_space(doubled) > search_space(shipping),
+        "shipping_n": shipping["k"],
+        "doubled_n": doubled["k"],
+        "shipping_matrix_entries": shipping["k"] ** 2,
+        "doubled_matrix_entries": doubled["k"] ** 2,
+        "shipping_search_space_bits": search_space(shipping).bit_length(),
+        "doubled_search_space_bits": search_space(doubled).bit_length(),
+        "doubled_planted_verifies": doubled_ok,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    changed_serializations = 0
+    transformations_per_seed = 4
+    for seed in range(20):
+        inst = make_instance(seed=1000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(inst)
+        rng = random.Random(9000 + seed)
+        identity = list(range(inst["k"]))
+        row_perm = list(identity)
+        col_perm = list(identity)
+        rng.shuffle(row_perm)
+        rng.shuffle(col_perm)
+        scale = rng.randrange(1, inst["p"])
+        shear = rng.randrange(inst["p"])
+        permuted_rows = _relabel(inst, row_perm, identity)
+        permuted_columns = _relabel(inst, identity, col_perm)
+        basis_changed = _top_basis_change(inst, scale, shear)
+        composed = _top_basis_change(
+            _relabel(inst, row_perm, col_perm), scale, shear
+        )
+        transformations = [permuted_rows, permuted_columns, basis_changed, composed]
+        original_blob = json.dumps(
+            [inst["U"], inst["target_top"]], separators=(",", ":")
+        )
+        for transformed in transformations:
+            invariance_checks += int(canonical_key(transformed) == key)
+            carried_checks += int(verify(transformed, transformed["answer"])[0])
+            transformed_blob = json.dumps(
+                [transformed["U"], transformed["target_top"]], separators=(",", ":")
+            )
+            changed_serializations += int(transformed_blob != original_blob)
+    unrelated = [
+        canonical_key(make_instance(seed=2000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY]))
+        for seed in range(20)
+    ]
+    attempted = 20 * transformations_per_seed
+    report["G8_canonical_key"] = {
+        "pass": invariance_checks == attempted and carried_checks == attempted
+        and changed_serializations == attempted and len(set(unrelated)) == 20,
+        "transformations": [
+            "module top-coordinate permutation",
+            "S-unit summand/unknown permutation",
+            "invertible elementary change of top-module basis",
+            "all transformations composed",
+        ],
+        "invariance_checks_passed": invariance_checks,
+        "invariance_checks_attempted": attempted,
+        "carried_witness_checks_passed": carried_checks,
+        "carried_witness_checks_attempted": attempted,
+        "changed_serializations": changed_serializations,
+        "unrelated_distinct_keys": len(set(unrelated)),
+        "unrelated_attempts": len(unrelated),
+        "key_kind": "hash of the exact reduced [I|z] normal form modulo summand permutation",
+    }
+
+    answer_blobs = [
+        json.dumps(
+            make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])["answer"],
+            separators=(",", ":"),
+        )
+        for seed in range(20)
+    ]
+    answer_chars = max(map(len, answer_blobs))
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(shipping["answer"])
+    evidence = _G9_EVIDENCE or {
+        "arms": {
+            "bare": {"solved": 0, "attempts": 0},
+            "hinted": {"solved": 0, "attempts": 0},
+            "placebo": {"solved": 0, "attempts": 0},
+        },
+        "hinted_verdict": "pending",
+    }
+    arms = evidence["arms"]
+    hinted_rate = (
+        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+        if arms["hinted"]["attempts"] else None
+    )
+    placebo_rate = (
+        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        if arms["placebo"]["attempts"] else None
+    )
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and compact_operations <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": (
+            hinted_rate - placebo_rate
+            if hinted_rate is not None and placebo_rate is not None else None
+        ),
+        "hinted_verdict": evidence["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": compact_operations,
+        "within_caps": within_caps,
+        "evidence_complete": all(
+            arms[name]["attempts"] >= 3 for name in ("bare", "hinted", "placebo")
+        ),
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = DIFFICULTY[SHIPPING_DIFFICULTY]
+    report["certificate_language"] = CERTIFICATE_LANGUAGE
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and key[1:2].isdigit()
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
