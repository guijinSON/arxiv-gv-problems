+def _rank_one_factors(inst):
+    """Recover factors of A-I from the public matrix, not generator secrets."""
+    p, matrix, n = inst["p"], inst["action_columns"], inst["n"]
+    b00 = (matrix[0][0] - 1) % p
+    inv_b00 = _inverse(b00, p)
+    left = [
