+def canonical_key(inst):
+    """Canonicalize module-basis changes and Laurent-generator relabellings.
 
+    Left multiplication by any invertible module-basis matrix leaves the unique
+    exponent vector unchanged; a generator relabelling permutes it.  Reducing
+    the augmented action matrix and sorting the recovered residues is therefore
+    an exact normal form for the transformations audited in G8.  This function
+    solves from public data and never reads inst['answer'].
+    """
