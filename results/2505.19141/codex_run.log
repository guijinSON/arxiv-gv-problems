           \node[accepting, state, minimum size=14pt] (1) at (2,0) {};
           \path[->] (0) edge [loop above] node [align=center]  {$0$} (0)
           (0) edge [above] node [align=center]  {$1$} (1);
        \end{tikzpicture}}
        \vspace{-0.3cm}
        \caption{An automaton for $\{2^k \mid k \in \N\}$.}
        \label{fig:pow2}
    \end{minipage}
    \hfill
