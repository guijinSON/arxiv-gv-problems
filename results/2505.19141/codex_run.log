+def _check_module_laws(inst, seed):
+    """Spot-check invertibility and commutation of the displayed actions."""
+    rng = random.Random(seed)
+    n, p = inst["n"], inst["p"]
+    vector = [rng.randrange(p) for _ in range(n + 1)]
