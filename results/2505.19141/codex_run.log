+def _is_mersenne_prime(exponent):
+    """Lucas-Lehmer test, exact for a Mersenne number 2^exponent-1."""
+    if exponent == 2:
+        return True
+    if not _is_prime_64(exponent):
+        return False
+    modulus = (1 << exponent) - 1
+    state = 4
+    for _ in range(exponent - 2):
+        state = (state * state - 2) % modulus
+    return state == 0
 
 
