+    "description": "A list of exactly k canonical exponent residues z_0,...,z_{k-1}; each entry is an integer in [0,p-1].  The module action has period p, so these residues represent all integer exponent classes."
+  },
+  "shipping_difficulty": "hard",
+  "shipping_params": {
+    "modulus": 1000003,
+    "n": 64
+  },
+  "track": "B"
+}

