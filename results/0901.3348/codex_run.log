/bin/bash -lc "python3 - <<'PY'
import importlib.util, random, math, time
s=importlib.util.spec_from_file_location('g','gen_0901_3348.py'); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
for n,k in [(288,13),(288,14),(320,14),(361,15),(384,15)]:
    t=time.time(); counts={'outlier':0,'greedy':0,'restart':0}
    for seed in range(800,824):
        inst=g.make_instance(n=n,k=k,seed=seed)
        counts['outlier'] += g.verify(inst,g._outlier_attack(inst))[0]
        a=g._greedy_attack(inst); counts['greedy'] += a is not None and g.verify(inst,a)[0]
        a=g._restart_attack(inst,random.Random(seed "'^ 0xA5A5A5A5),256)
        counts['"'restart'] += a is not None and g.verify(inst,a)[0]
    false=math.comb(n,k)*2**(-math.comb(k,2))
    print((n,k),'k/sqrt',round(k/math.sqrt(n),3),'false_cliques',round(false,5),counts,'sec',round(time.time()-t,2))
