+        "vertex_count": n,
+        "clique_size": k,
+        "edge_probability": [edge_num, edge_den],
+        "edges": edges,
+        # Internal O(1) checker index.  ``edges`` remains the portable problem
+        # data; emitters serialize the rendered question rather than this set.
+        "edge_lookup": frozenset(edges),
+        "answer": answer,
