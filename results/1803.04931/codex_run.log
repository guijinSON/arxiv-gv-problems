+            return False, reason
+        parsed.append(item)
+    supports = [item[1] for item in parsed]
+    if len(set(supports)) != 3:
+        return False, "polynomial monomial supports must be distinct"
+    expected = []
+    for term in _canonical_polynomial(a, b, c):
