+            "name": "Shanks baby-step/giant-step discrete logarithm in GF(2^D)",
+            "complexity": "O(2^(D/2)) exact field operations and O(2^(D/2)) stored elements",
+            "wall_clock_sec": round(reference_wall, 6),
