from math import isqrt

def factors(n):
    out=[]; d=2
    while d*d<=n:
        if n%d==0:
            out.append(d)
            while n%d==0:n//=d
        d+=1 if d==2 else 2
    if n>1:out.append(n)
    return out

def mul(a,b,mod,d):
    r=0
    while b:
        if b&1:r"'^=a
        b>>=1
        a<<=1
        if a>>d:a''^=mod
    return r

def pw(a,n,mod,d):
    r=1
    while n:
        if n&1:r=mul(r,a,mod,d)
        a=mul(a,a,mod,d);n//=2
    return r

def primitive(d,s):
    mod=(1<<d)|(1<<s)|1; N=(1<<d)-1
    if pw(2,1<<d,mod,d)!=2:return False
    # irreducible via x''^(2''^(d/q)) != x for primes q | d
    for q in factors(d):
        if pw(2,1<<(d//q),mod,d)==2:return False
    return all(pw(2,N//q,mod,d)!=1 for q in factors(N))
