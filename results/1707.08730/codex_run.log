+
+STRUCTURAL_HINT: str = (
+    "Modulo 997, the six desired weights occupy one common residue class."
+)
+PLACEBO_HINT: str = (
+    "Across the list, the six desired weights require careful exact arithmetic."
+)
+
+PROBLEM_PROFILE: dict = {
