    # to guess later which rules it was checked against.
    print(f"  schema_version={ver} (legacy, pre-harden.py) — {len(rows)} calls, not re-validated")
    sys.exit(0)

NEED = {"schema_version","model","effort","preset","params","seed","escalation_round",
