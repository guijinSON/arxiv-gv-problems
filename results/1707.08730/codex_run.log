+def escalate(params) -> dict | str | None:
+    out = dict(params)
+    n = int(out["n"])
+    k = int(out.get("k", 6))
+    quotient_bits = int(out.get("quotient_bits", 56))
+    if n < 270:
+        out["n"] = min(270, n + 60)
+        if out["n"] % k:
+            out["n"] += k - out["n"] % k
+    else:
+        # The witness remains six indices; only the coefficient entropy grows.
+        out["quotient_bits"] = quotient_bits + 32
+    return out
