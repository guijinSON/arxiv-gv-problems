+def _compact_residue_solver(inst, modulus: int):
+    """Construction-aware route, disclosed for Track B measurement."""
+    inverse_k = pow(inst["k"], -1, modulus)
+    wanted = (inst["target"] % modulus) * inverse_k % modulus
