+    forward = (
+        forward_target // scale,
+        tuple(sorted(value // scale for value in forward_weights)),
+    )
+    reflected = (
+        reflected_target // scale,
+        tuple(sorted(value // scale for value in reflected_weights)),
+    )
+    return min(forward, reflected)
