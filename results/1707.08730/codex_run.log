+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Recognize that the six selected weights share a hidden residue class; "
+        "without that invariant, generic meet-in-the-middle 6SUM enumerates triples."
+    ),
+    "hardness_basis": (
+        "Track B: standard meet-in-the-middle 6SUM is Theta(n^3) time and memory "
+        "and uses a measured 2,040,862 primitive operations in 0.224 seconds at "
+        "shipping n=150; the common-residue route uses 158 exact arithmetic "
+        "operations, but a no-tool solver must discover the modulus and execute "
+        "150 reductions of 66-bit integers."
+    ),
+    "max_answer_tokens": 6,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
