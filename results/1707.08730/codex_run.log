+    "easy": {"n": 150, "k": 6, "modulus": 997, "quotient_bits": 56},
+    "medium": {"n": 210, "k": 6, "modulus": 997, "quotient_bits": 72},
+    "hard": {"n": 270, "k": 6, "modulus": 997, "quotient_bits": 88},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
