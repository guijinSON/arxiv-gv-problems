+    rng = random.Random(seed)
+    bucket_count = n // k
+    residues = rng.sample(range(modulus), bucket_count)
+    planted_bucket = rng.randrange(bucket_count)
+    low = 1 << (quotient_bits - 1)
+    high = 1 << quotient_bits
