+    usable = [indices for indices in buckets.values() if len(indices) >= inst["k"]]
+    if not usable:
+        return list(range(inst["k"]))
+    best = min(
+        usable,
+        key=lambda indices: abs(
+            sum(inst["weights"][index] for index in indices[: inst["k"]]) - inst["target"]
+        ),
+    )
