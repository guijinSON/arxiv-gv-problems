+    "suffix ansatz are measured separately and fail at the shipping preset."
+)
+
+
+# Replaced only after the corresponding scripts/harden.py runs have produced
+# transcripts. Keeping this explicit prevents a missing oracle run from masquerading
+# as a passed G9 gate.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
