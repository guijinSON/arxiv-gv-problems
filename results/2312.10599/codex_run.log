# Exact integer and polynomial helpers


def _prime_divisors(value: int) -> list[int]:
    out: list[int] = []
    d = 2
    while d * d <= value:
        if value % d == 0:
            out.append(d)
            while value % d == 0:
                value //= d
        d = 3 if d == 2 else d + 2
    if value > 1:
        out.append(value)
    return out


def _is_prime(value: int) -> bool:
    """Deterministic Miller--Rabin on the 64-bit range used here."""
