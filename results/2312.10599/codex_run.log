+def _add_balanced_incidence(edges: set[tuple[int, int]], sources: list[int],
+                            targets: list[int], degree: int,
+                            rng: random.Random) -> None:
+    """Give every source `degree` distinct targets and balance target loads."""
+    if not targets or len(sources) % len(targets):
+        raise ValueError("balanced incidence requires divisibility")
+    used = {u: set() for u in sources}
+    copies = len(sources) // len(targets)
+    for _ in range(degree):
+        slots = [v for v in targets for _ in range(copies)]
+        for _attempt in range(10_000):
+            rng.shuffle(slots)
+            if all(slots[i] not in used[u] for i, u in enumerate(sources)):
+                break
+        else:  # pragma: no cover - parameter validation keeps this remote
+            raise RuntimeError("could not sample balanced simple incidences")
+        for u, v in zip(sources, slots):
+            used[u].add(v)
+            _add_edge(edges, u, v)
+
+
+def _add_random_regular_bipartite(edges: set[tuple[int, int]], left: list[int],
+                                  right: list[int], degree: int,
+                                  rng: random.Random) -> None:
+    """Add a simple degree-regular bipartite graph via random matchings.
+
+    Each round finds a randomized perfect matching in the complement of the
+    edges used by earlier rounds.  Thus the result is exactly regular without
+    importing a matching package or exposing a cyclic construction.
+    """
+    if len(left) != len(right) or degree < 0 or degree >= len(left):
+        raise ValueError("invalid regular bipartite dimensions")
+    used = {u: set() for u in left}
+    for _ in range(degree):
+        match_right: dict[int, int] = {}
+        order = list(left)
+        rng.shuffle(order)
+
+        def augment(u: int, seen: set[int]) -> bool:
+            options = [v for v in right if v not in used[u]]
+            rng.shuffle(options)
+            for v in options:
+                if v in seen:
+                    continue
+                seen.add(v)
+                if v not in match_right or augment(match_right[v], seen):
+                    match_right[v] = u
+                    return True
+            return False
+
+        if not all(augment(u, set()) for u in order):  # pragma: no cover
+            raise RuntimeError("regular-complement matching unexpectedly failed")
+        for v, u in match_right.items():
+            used[u].add(v)
+            _add_edge(edges, u, v)
+
+
