/bin/bash -lc "python3 -m py_compile gen_2312_10599.py && python3 - <<'PY'
import itertools, json, os
import gen_2312_10599 as m
p=m.DIFFICULTY['demo']
a=m.make_instance(seed=0,**p)
b=m.make_instance(seed=0,**p)
assert a==b
assert json.loads(json.dumps(a['answer']))==a['answer']
assert 'Hint:' not in m.render(a)
os.environ['GV_HINT_MODE']='structural'; assert m.STRUCTURAL_HINT in m.render(a)
os.environ['GV_HINT_MODE']='placebo'; assert m.PLACEBO_HINT in m.render(a)
os.environ.pop('GV_HINT_MODE')
# Independent brute-force semantics for the demo: compute every minimum cover
# directly, then compare every allowed X to verify().
V=range(a['vertex_count']); edges=[tuple(e) for e in a['edges']]
covers=[]
for size in range(a['vertex_count']+1):
    for comb in itertools.combinations(V,size):
        s=set(comb)
        if all(u in s or v in s for u,v in edges): covers.append(s)
    if covers: break
checked=0
for size in range(1,a['k']+1):
    for comb in itertools.combinations(a['core_vertices'],size):
        semantic=sum(set(comb).isdisjoint(C) for C in covers)==1
        local=m.verify(a,list(comb))[0]
        assert semantic==local,(comb,semantic,local)
        checked+=1
print(json.dumps({'syntax':'ok','deterministic':True,'json_native':True,
                  'hint_isolation':True,'minimum_cover_size':len(next(iter(covers))),
                  'minimum_cover_count':len(covers),'witnesses_cross_checked':checked}))
