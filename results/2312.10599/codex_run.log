  i=rng.randrange(len(el));j=rng.randrange(len(el));a,b=el[i];c,d=el[j]
  if i==j or a==c or b==d or (a,d) in E or (c,b) in E:continue
  E.remove((a,b));E.remove((c,d));E.add((a,d));E.add((c,b));el[i]=(a,d);el[j]=(c,b)
 return E

def make(seed):
 n=240;k=16;d=20;rng=random.Random(seed);s=120;h=8;L=list(range(s));R=list(range(s,n));DL=set(rng.sample(L,h));DR=set(rng.sample(R,h));OL=[x for x in L if x not in DL];OR=[x for x in R if x not in DR];rl=[3]*24+[1]*88;rr=rl.copy();rng.shuffle(rl);rng.shuffle(rr);E=br(sorted(DL),OR,[d]*h,rr,rng)|br(OL,sorted(DR),rl,[d]*h,rng)|br(OL,OR,[d-x for x in rl],[d-x for x in rr],rng);EE=set()
 for a,b in E:g._add_edge(EE,a,b)
 P=[]
 for v in range(n):g._add_edge(EE,v,n+v);P.append((v,n+v))
 lab=list(range(2*n));rng.shuffle(lab);mp=dict(enumerate(lab));return {'vertex_count':2*n,'core_n':n,'k':k,'core_vertices':sorted(mp[v] for v in range(n)),'private_pairs':[list(x) for x in sorted((mp[a],mp[b]) for a,b in P)],'edges':[list(x) for x in sorted((min(mp[a],mp[b]),max(mp[a],mp[b])) for a,b in EE)],'answer':sorted(mp[v] for v in DL|DR)}

def attack(inst,seed,restarts=64):
 vs,adj=g._core_adjacency(inst);L,R=g._bipartition(vs,adj);h=8;rng=random.Random(seed)
 def side(X,Y):
  yi={v:i for i,v in enumerate(Y)};N=[[yi[v] for v in adj[u]] for u in X]
  def counts(S):
   a=[0]*len(Y)
   for i in S:
    for j in N[i]:a[j]+=1
   return a
  def score(c):
   hist=[0]*(h+1)
   for z in c:hist[z]+=1
