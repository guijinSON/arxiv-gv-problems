+                        changed = (current - removed_cost
+                                   + sum(common[added][other]
+                                         for other in selected
+                                         if other != removed))
+                        if changed < best:
+                            best = changed
+                            moves = [(removed, added)]
+                        elif changed == best and changed < current:
+                            moves.append((removed, added))
