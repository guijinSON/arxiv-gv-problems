+# Filled from the script-owned runs after STEP 4 and the two G9 scratch runs.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
