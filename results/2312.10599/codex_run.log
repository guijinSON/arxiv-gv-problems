+                or leaf < 0 or leaf >= vertex_count or leaf in core_set
+                or u in paired or leaf in leaves):
+            return False, "private pairs are not a one-to-one core/leaf pairing"
+        paired[u] = leaf
+        leaves.add(leaf)
