import random,time,math
import gen_2312_10599 as g

def br(L,R,dl,dr,rng,sw=20):
 rem=dict(zip(R,dr));E=set();o=list(zip(L,dl));rng.shuffle(o);o.sort(key=lambda x:x[1],reverse=True)
 for u,d in o:
  q=list(R);rng.shuffle(q);q.sort(key=lambda v:rem[v],reverse=True)
  for v in q[:d]:E.add((u,v));rem[v]-=1
