+DIFFICULTY: dict = {
+    "demo": {"n": 8, "k": 2, "plant_degree": 1},
+    "easy": {"n": 64, "k": 12, "plant_degree": 2},
+    "medium": {"n": 96, "k": 12, "plant_degree": 2},
+    "hard": {"n": 128, "k": 12, "plant_degree": 2},
+}
