+            "nodes_mean": sum(row["nodes"] for row in exact_costs) / 8,
+            "wall_clock_sec_total": sum(row["wall_clock_sec"] for row in exact_costs),
+            "wall_clock_sec_mean": sum(row["wall_clock_sec"] for row in exact_costs) / 8,
