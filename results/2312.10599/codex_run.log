+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    doubled_seconds = time.perf_counter() - started
+    spaces = [search_space(make_instance(seed=9, **params))
+              for name, params in DIFFICULTY.items() if name != "demo"]
+    report["G7_scales"] = {
