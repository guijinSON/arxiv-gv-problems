+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A strictly increasing JSON list of between 1 and k distinct vertex "
+        "labels, all from the displayed core W.  It denotes vertices forbidden "
+        "from the minimum vertex cover."
