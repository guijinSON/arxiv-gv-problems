+    "easy": {"n": 160, "k": 10, "plant_degree": 1},
+    "medium": {"n": 208, "k": 12, "plant_degree": 1},
+    "hard": {"n": 264, "k": 14, "plant_degree": 1},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "In the hidden bipartition, the target is a balanced all-zero cross-block "
+    "whose closed neighborhoods cover every core vertex."
+)
