+    invariant = True
+    invariance_checks = 0
+    transform_checks = 0
+    for seed in range(20):
+        trial = make_instance(seed=10_000 + seed, **ship_params)
+        key = canonical_key(trial)
+        for salt in (seed + 1, 1000 + seed, 2000 + seed):
