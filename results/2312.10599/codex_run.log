+def escalate(params: dict) -> dict | str | None:
+    """Grow the core while keeping the certificate length fixed."""
+    nxt = dict(params)
+    n = int(nxt.get("n", 64))
+    if n >= 512:
+        return None
+    nxt["n"] = min(512, ((3 * n // 2 + 1) // 2) * 2)
+    return nxt
