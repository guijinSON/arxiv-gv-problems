import random,time

def gen(h,seed):
 r=random.Random(seed); q=3*h;p=list(range(q));r.shuffle(p);plant=[tuple(sorted(p[i:i+3])) for i in range(0,q,3)];forbidden=set(plant)
 while True:
  st=[];seen=set();copies=[x for x in range(q) for _ in range(2)];r.shuffle(copies)
  for i in range(0,len(copies),3):
   t=tuple(sorted(copies[i:i+3]))
   if len(set(t))<3 or t in forbidden or t in seen:break
   st.append(t);seen.add(t)
  else:
   sets=plant+st;r.shuffle(sets);return sets

def solve(sets,q,cap=5000):
 inc=[[] for _ in range(q)]
 for j,s in enumerate(sets):
  for x in s:inc[x].append(j)
 used=[False]*q;nodes=0
 def rec(d):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return False
  if 3*d==q:return True
  opts=None
  for x in range(q):
   if not used[x]:
    oo=[j for j in inc[x] if all(not used[y] for y in sets[j])]
    if not oo:return False
    if opts is None or len(oo)<len(opts):opts=oo
  for j in opts:
   for x in sets[j]:used[x]=True
   if rec(d+1):return True
   for x in sets[j]:used[x]=False
  return False
 ok=rec(0);return ok,nodes
for h in [160,180,200,220]:
 vals=[];t=time.time()
 for seed in range(20):
