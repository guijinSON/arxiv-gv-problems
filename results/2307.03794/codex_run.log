+
+STRUCTURAL_HINT = (
+    "The scalar labels on the improving edges fall into layers with a conserved sum modulo q."
+)
+PLACEBO_HINT = (
+    "The displayed labels on the improving edges reward careful comparison across all rows."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A length-n permutation of the n displayed better-house codes 0 through "
+        "n-1, in displayed agent order; this incorporates the obvious requirements "
+        "that every agent receive one house and no house be repeated."
