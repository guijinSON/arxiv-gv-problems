+# of the improvement graph, while scale raises the arithmetic label height.
+DIFFICULTY = {
+    "demo": {"n": 5, "layer_count": 2, "scale": 3},
+    "easy": {"n": 80, "layer_count": 4, "scale": 101},
+    "medium": {"n": 150, "layer_count": 5, "scale": 1009},
