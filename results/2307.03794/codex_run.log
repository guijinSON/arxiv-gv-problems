+    ]
+    # Keep lines readable without changing the input ordering.
+    width = 10
+    for start in range(0, n, width):
+        lines.append("  " + " ".join(catalog[start:start + width]))
+    lines.extend(["", "Strict preference lists (0-indexed agent codes):"])
+    for i, (scalar, row) in enumerate(zip(
+        inst["agent_scalars"], inst["better_preferences"]
+    )):
+        preferred = " > ".join(f"B{code}" for code in row)
+        lines.append(f"  A{i}[z={scalar}]: {preferred} > C{i} [current]")
+    lines.extend([
+        "",
+        f"Output exactly {n} integers in fixed agent order A0,A1,...,A{n-1}.",
+        "Entry i is the code j of the better house Bj assigned to Ai. Codes are",
+        f"0-indexed integers from 0 through {n-1}; order matters by agent, every",
+        "code must occur exactly once, and repeats are forbidden.",
+        "",
+        "Give your final answer inside <answer></answer> tags as comma-separated integers.",
+        "Example syntax: <answer>2, 0, 1</answer>",
+        "Output nothing else inside the tags.",
