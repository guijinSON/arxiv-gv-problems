+    from gvlib import exact_matrices, rationals  # noqa: F401
+except ImportError:  # pragma: no cover - graceful standalone fallback
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "house-allocation agents with strict incomplete preference lists",
+        "a displayed current matching",
+        "an alternative agent-to-house matching",
+        "the improvement graph induced by the current matching",
+    ],
+    "verification_operations": [
+        "integer range and distinctness checks",
+        "exact preference-list membership",
+        "exact comparison with the current assignment",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The scalar labels on every improving edge belong to conserved modular-"
+        "sum layers; without recognizing a common layer, one must find a perfect "
+        "matching in the shuffled improvement graph."
+    ),
+    "hardness_basis": (
+        "Track B: Section 4.1, Observation 2 and Corollary 3 give Hopcroft-Karp "
+        "in O(sqrt(n)*m); repeated local shipping runs used 36,422 edge scans over "
+        "eight fixed seeds and roughly 0.02--0.05 seconds total, while the compact "
