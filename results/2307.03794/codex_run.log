import random,time

def gen(h,seed):
 r=random.Random(seed); q=3*h
 p=list(range(q)); r.shuffle(p); plant=[tuple(sorted(p[i:i+3])) for i in range(0,q,3)]; forbidden=set(plant)
 for tries in range(100000):
  st=[]; seen=set(); copies=[x for x in range(q) for _ in range(2)]; r.shuffle(copies); ok=True
  for i in range(0,len(copies),3):
   t=tuple(sorted(copies[i:i+3]))
   if len(set(t))<3 or t in forbidden or t in seen: ok=False; break
   st.append(t); seen.add(t)
  if ok:
   sets=plant+st; r.shuffle(sets); return sets,tries
 raise Exception

def solve(sets,q,cap=2000000):
 inc=[[] for _ in range(q)]
 for j,s in enumerate(sets):
  for x in s: inc[x].append(j)
 nodes=0; used=[False]*q
 def rec(depth):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return False
  if depth*3==q:return True
  opts=None
  for x in range(q):
   if not used[x]:
    oo=[]
    for j in inc[x]:
     a,b,c=sets[j]
     if not used[a] and not used[b] and not used[c]:oo.append(j)
    if not oo:return False
    if opts is None or len(oo)<len(opts):opts=oo
  for j in opts:
   s=sets[j]
   for x in s:used[x]=True
   if rec(depth+1):return True
   for x in s:used[x]=False
  return False
 ok=rec(0);return ok,nodes
for h in [120,160,200]:
 for seed in range(4):
  t=time.time();s,tr=gen(h,seed);tg=time.time()-t;t=time.time();ok,n=solve(s,3*h);ts=time.time()-t
  print(h,seed,'g',round(tg,2),tr,'solve',ok,n,round(ts,2))
