+)
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_SELFTEST_SEEDS = tuple(range(8))
+_GUESS_SAMPLES = 200_000
+
+# Populated after the three script-owned hardening runs.  The diagnostic is not
+# a gate; G9(c)'s answer and operation caps are the only G9 pass condition.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_params(n, seed, layer_count, scale):
+    if not _is_int(n) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    if not _is_int(seed):
+        raise ValueError("seed must be an integer")
+    if not _is_int(layer_count) or not 2 <= layer_count < n:
+        raise ValueError("layer_count must be an integer with 2 <= layer_count < n")
+    if not _is_int(scale) or scale < 1:
+        raise ValueError("scale must be a positive integer")
+
+
+def make_instance(n, seed=0, layer_count=4, scale=101, **params):
+    """Compose equal-distribution cyclic matching layers before shuffling names.
+
+    Let agent and house coordinates be i,j in Z_n.  A sampled layer s contains
+    every edge i--j with i+j=s mod n, hence it is a perfect matching.  All
+    layers use the same construction; choosing the first sampled layer as the
+    retained certificate does not make its edges locally distinguishable.
+    """
+    _validate_params(n, seed, layer_count, scale)
+    rng = random.Random(seed)
+    modulus = n * scale
+    agent_offset = rng.randrange(scale)
+    house_offset = rng.randrange(scale)
+
+    # Random house codes B0,...,B(n-1) conceal the cyclic coordinate order.
+    raw_house_scalars = [house_offset + j * scale for j in range(n)]
+    rng.shuffle(raw_house_scalars)
+    house_scalars = raw_house_scalars
+    scalar_to_house = {scalar: code for code, scalar in enumerate(house_scalars)}
+    house_order = list(range(n))
+    rng.shuffle(house_order)
+
+    agent_scalars = [agent_offset + i * scale for i in range(n)]
+    rng.shuffle(agent_scalars)
+    shifts = rng.sample(range(n), layer_count)
+    planted_shift = shifts[0]
+    planted_constant = (
+        agent_offset + house_offset + planted_shift * scale
+    ) % modulus
+
+    better_preferences = []
+    answer = []
+    for scalar in agent_scalars:
+        row = []
+        for shift in shifts:
+            conserved = (agent_offset + house_offset + shift * scale) % modulus
+            target_scalar = (conserved - scalar) % modulus
+            row.append(scalar_to_house[target_scalar])
+        rng.shuffle(row)
+        better_preferences.append(row)
+        answer.append(scalar_to_house[(planted_constant - scalar) % modulus])
+
+    return {
+        "n": n,
+        "k": n,
+        "modulus": modulus,
+        "scale": scale,
+        "agent_scalars": agent_scalars,
+        "house_scalars": house_scalars,
+        "house_order": house_order,
+        "better_preferences": better_preferences,
+        "current_matching": [f"C{i}" for i in range(n)],
+        "answer": answer,
+    }
+
+
+def render(inst):
+    """Render the complete native house-allocation counterexample task."""
+    n = inst["n"]
+    lines = [
+        "HOUSE ALLOCATION: CERTIFY FAILURE OF n-STABILITY",
+        "",
+        f"There are {n} agents A0,...,A{n-1}.  The objects are {n} better-house",
+        f"codes B0,...,B{n-1} and {n} private current objects C0,...,C{n-1}.",
+        "A matching assigns at most one acceptable object to each agent and uses",
+        "each object at most once. Preference lists below are strict and run from",
+        "best to worst; being unmatched is worse than every listed object.",
+        "",
+        "The displayed current matching M assigns Ai to Ci for every i.  Agent Ai",
+        "strictly prefers another matching M' to M exactly when M' assigns Ai an",
+        "object appearing to the left of Ci in Ai's preference list.",
+        "",
+        "For this problem, a matching is k-stable when no alternative matching is",
+        "strictly preferred by at least k agents. Here k=n, so certify that M is",
+        "not n-stable by giving an alternative matching preferred by every agent.",
+        "",
+        f"The scalar z attached to each A and B label is instance data in Z_q, with q={inst['modulus']}.",
+        "All modular arithmetic uses the representatives 0,...,q-1. The B code,",
+        "not its scalar z, is what must be written in the answer.",
+        "",
+        "Better-house catalog (catalog order has no significance):",
+    ]
+    catalog = [
+        f"B{code}[z={inst['house_scalars'][code]}]" for code in inst["house_order"]
+    ]
+    # Keep lines readable without changing the input ordering.
+    width = 10
+    for start in range(0, n, width):
+        lines.append("  " + " ".join(catalog[start:start + width]))
+    lines.extend(["", "Strict preference lists (0-indexed agent codes):"])
+    for i, (scalar, row) in enumerate(zip(
+        inst["agent_scalars"], inst["better_preferences"]
+    )):
+        preferred = " > ".join(f"B{code}" for code in row)
+        lines.append(f"  A{i}[z={scalar}]: {preferred} > C{i} [current]")
+    lines.extend([
+        "",
+        f"Output exactly {n} integers in fixed agent order A0,A1,...,A{n-1}.",
+        "Entry i is the code j of the better house Bj assigned to Ai. Codes are",
+        f"0-indexed integers from 0 through {n-1}; order matters by agent, every",
+        "code must occur exactly once, and repeats are forbidden.",
+        "",
+        "Give your final answer inside <answer></answer> tags as comma-separated integers.",
+        "Example syntax: <answer>2, 0, 1</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    """Extract the last delimited integer list, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    blocks = _ANSWER_RE.findall(text)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    if body.startswith("[") and body.endswith("]"):
+        body = body[1:-1].strip()
+    if not body:
+        return []
+    if not re.fullmatch(r"(?:B\s*)?[+-]?\d+(?:\s*,\s*(?:B\s*)?[+-]?\d+)*", body, re.I):
+        return None
+    try:
+        return [int(re.sub(r"^[Bb]\s*", "", token.strip())) for token in body.split(",")]
+    except (TypeError, ValueError):
+        return None
+
+
+def verify(inst, answer):
+    """Check the proposed Pareto-improving matching exactly, without the plant."""
+    if not isinstance(answer, list):
+        return False, "answer must be a list of better-house codes"
+    n = inst["n"]
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) < n:
+        return False, f"too few assignments: expected {n}, got {len(answer)}"
+    if len(answer) > n:
+        return False, f"too many assignments: expected {n}, got {len(answer)}"
+    for i, code in enumerate(answer):
+        if not _is_int(code) or not 0 <= code < n:
+            return False, f"entry {i} is not a displayed better-house code"
+    if len(set(answer)) != n:
+        return False, "matching constraint is violated by a repeated house"
+    for agent, code in enumerate(answer):
+        if code not in inst["better_preferences"][agent]:
+            return False, f"agent A{agent} does not prefer house B{code} to its current object"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the permutation space implied by the output contract."""
+    candidate = list(range(inst["n"]))
+    rng.shuffle(candidate)
+    return candidate
+
+
+def search_space(inst):
+    return math.factorial(inst["n"])
+
+
+def enumerate_all(inst):
+    """Count all witnesses only when exhaustive permutation search is capped."""
+    if search_space(inst) > 1_000_000:
+        return None
+    return sum(
+        verify(inst, list(candidate))[0]
+        for candidate in itertools.permutations(range(inst["n"]))
+    )
+
+
+def _normalised_shift_set(inst):
+    """Recover the cyclic layer set from instance data, never from the answer."""
+    n = inst["n"]
+    scale = inst["scale"]
+    agent_offset = inst["agent_scalars"][0] % scale
+    house_offset = inst["house_scalars"][0] % scale
+    expected = None
+    for scalar, row in zip(inst["agent_scalars"], inst["better_preferences"]):
+        i = (scalar - agent_offset) // scale
+        shifts = tuple(sorted(
+            (i + (inst["house_scalars"][code] - house_offset) // scale) % n
+            for code in row
+        ))
+        if expected is None:
+            expected = shifts
+        elif shifts != expected:
+            raise ValueError("instance is not a union of common cyclic layers")
+    return expected or ()
+
+
+def canonical_key(inst):
+    """Canonicalize the layer set under affine coordinate relabellings of Z_n.
+
+    Agent codes, house codes, catalog order, preference order, coordinate
+    translations, and simultaneous multiplication by a unit are all removed.
+    """
+    n = inst["n"]
+    shifts = _normalised_shift_set(inst)
+    best = None
+    for unit in range(n):
+        if math.gcd(unit, n) != 1:
+            continue
+        multiplied = [(unit * shift) % n for shift in shifts]
+        for translation in range(n):
+            candidate = tuple(sorted((value + translation) % n for value in multiplied))
+            if best is None or candidate < best:
+                best = candidate
+    payload = [n, list(best or ())]
+    blob = json.dumps(payload, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params):
+    """Increase decoy crowding and label height at fixed answer length."""
+    p = {key: value for key, value in params.items() if key != "_preset"}
+    n = int(p["n"])
+    layers = int(p.get("layer_count", 6))
+    scale = int(p.get("scale", 4001))
+    p["n"] = n
+    p["layer_count"] = min(n - 1, layers + 2)
+    p["scale"] = scale * 10 + 1
+    return p
+
+
+def _hopcroft_karp_reference(inst):
+    """Paper-standard maximum matching with exact operation counters."""
+    n = inst["n"]
+    adjacency = inst["better_preferences"]
+    pair_agent = [-1] * n
+    pair_house = [-1] * n
+    distance = [0] * n
+    counts = {
+        "edge_scans": 0,
+        "bfs_rounds": 0,
+        "dfs_calls": 0,
+        "augmentations": 0,
+    }
+
+    def bfs():
+        counts["bfs_rounds"] += 1
+        queue = deque()
+        found = False
+        for agent in range(n):
+            if pair_agent[agent] < 0:
+                distance[agent] = 0
+                queue.append(agent)
+            else:
+                distance[agent] = -1
+        while queue:
+            agent = queue.popleft()
+            for house in adjacency[agent]:
+                counts["edge_scans"] += 1
+                other = pair_house[house]
+                if other < 0:
+                    found = True
+                elif distance[other] < 0:
+                    distance[other] = distance[agent] + 1
+                    queue.append(other)
+        return found
+
+    def dfs(agent):
+        counts["dfs_calls"] += 1
+        for house in adjacency[agent]:
+            counts["edge_scans"] += 1
+            other = pair_house[house]
+            if other < 0 or (
+                distance[other] == distance[agent] + 1 and dfs(other)
+            ):
+                pair_agent[agent] = house
+                pair_house[house] = agent
+                return True
+        distance[agent] = -1
+        return False
+
+    while bfs():
+        progress = False
+        for agent in range(n):
+            if pair_agent[agent] < 0 and dfs(agent):
+                counts["augmentations"] += 1
+                progress = True
+        if not progress:
+            break
+    if any(house < 0 for house in pair_agent):
+        return None, counts
+    return pair_agent, counts
+
+
+def _compact_conserved_sum(inst):
+    """Recover one whole matching layer from the first displayed improving edge."""
+    q = inst["modulus"]
+    first_house = inst["better_preferences"][0][0]
+    constant = (
+        inst["agent_scalars"][0] + inst["house_scalars"][first_house]
+    ) % q
+    scalar_to_house = {
+        scalar: code for code, scalar in enumerate(inst["house_scalars"])
+    }
+    answer = []
+    for scalar in inst["agent_scalars"]:
+        target = (constant - scalar) % q
+        code = scalar_to_house.get(target, -1)
+        answer.append(code)
+    return answer, inst["n"] + 1
+
+
+def _attack_row_extreme(inst, largest=False):
+    return [
+        (max(row) if largest else min(row))
+        for row in inst["better_preferences"]
+    ]
+
+
+def _attack_first_listed(inst):
+    return [row[0] for row in inst["better_preferences"]]
+
+
+def _attack_scalar_nearest(inst):
+    q = inst["modulus"]
+    answer = []
+    for scalar, row in zip(inst["agent_scalars"], inst["better_preferences"]):
+        answer.append(min(
+            row,
+            key=lambda code: (
+                min(
+                    (inst["house_scalars"][code] - scalar) % q,
+                    (scalar - inst["house_scalars"][code]) % q,
+                ),
+                code,
+            ),
+        ))
+    return answer
+
+
+def _attack_constant_difference(inst):
+    """Try the obvious but wrong modular ansatz y-x=d."""
+    n = inst["n"]
+    scale = inst["scale"]
+    agent_offset = inst["agent_scalars"][0] % scale
+    house_offset = inst["house_scalars"][0] % scale
+    agent_coordinates = [
+        (scalar - agent_offset) // scale for scalar in inst["agent_scalars"]
+    ]
+    house_coordinates = [
+        (scalar - house_offset) // scale for scalar in inst["house_scalars"]
+    ]
+    coordinate_to_house = {
+        coordinate: code for code, coordinate in enumerate(house_coordinates)
+    }
+    first_i = agent_coordinates[0]
+    differences = [
+        (house_coordinates[code] - first_i) % n
+        for code in inst["better_preferences"][0]
+    ]
+
+    def support(difference):
+        return sum(
+            coordinate_to_house[(i + difference) % n] in row
+            for i, row in zip(agent_coordinates, inst["better_preferences"])
+        )
+
+    best = max(differences, key=lambda value: (support(value), -value))
+    answer = []
+    for i, row in zip(agent_coordinates, inst["better_preferences"]):
+        proposed = coordinate_to_house[(i + best) % n]
+        answer.append(proposed if proposed in row else row[0])
+    return answer
+
+
+def _attack_greedy(inst, rng=None, attempts=1):
+    """Assign an unused preferred house row by row, without augmenting paths."""
+    n = inst["n"]
+    last = _attack_first_listed(inst)
+    for _ in range(attempts):
+        order = list(range(n))
+        if rng is not None:
+            rng.shuffle(order)
+        used = set()
+        answer = [None] * n
+        for agent in order:
+            choices = [
+                house for house in inst["better_preferences"][agent]
+                if house not in used
+            ]
+            if not choices:
+                break
+            house = rng.choice(choices) if rng is not None else choices[0]
+            answer[agent] = house
+            used.add(house)
+        else:
+            if verify(inst, answer)[0]:
+                return answer, True
+        last = [
+            answer[i] if answer[i] is not None else inst["better_preferences"][i][0]
+            for i in range(n)
+        ]
+    return last, False
+
+
+def _transform_instance(
+    inst,
+    agent_map=None,
+    house_map=None,
+    row_orders=None,
+    catalog_order=None,
+):
+    """Apply arbitrary code and presentation relabellings, carrying the witness."""
+    n = inst["n"]
+    agent_map = list(range(n)) if agent_map is None else list(agent_map)
+    house_map = list(range(n)) if house_map is None else list(house_map)
+    if row_orders is None:
+        row_orders = [list(range(len(row))) for row in inst["better_preferences"]]
+
+    agent_scalars = [None] * n
+    rows = [None] * n
+    answer = [None] * n
+    house_scalars = [None] * n
+    for old_house, new_house in enumerate(house_map):
+        house_scalars[new_house] = inst["house_scalars"][old_house]
+    for old_agent, new_agent in enumerate(agent_map):
+        agent_scalars[new_agent] = inst["agent_scalars"][old_agent]
