   235	    marks[0:2] = b"\x00\x00"
   236	    for p in range(2, math.isqrt(limit) + 1):
   237	        if marks[p]:
   238	            start = p * p
   239	            marks[start:limit + 1:p] = b"\x00" * (((limit - start) // p) + 1)
   240	    return [p for p in range(2, limit + 1) if marks[p]]
