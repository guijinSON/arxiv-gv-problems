+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("unrelated prose") is None,
+        "parsed": parsed,
+    }
+
+    samples = 250_000
+    sample_rng = random.Random(8675309)
+    hits = 0
+    for _ in range(samples):
