+def escalate(params: dict) -> dict | str | None:
+    current = {k: v for k, v in params.items() if k != "_preset"}
+    n = int(current.get("n", 0))
+    if n < 39_000:
+        current["n"] = min(39_000, n + 4_000)
+        return current
