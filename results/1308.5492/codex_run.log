   409	def parse_answer(text: Any) -> object | None:
   410	    if not isinstance(text, str):
   411	        return None
   412	    tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
   413	                        flags=re.IGNORECASE | re.DOTALL)
   414	    payloads = list(reversed(tagged))
   415	    if not payloads:
   416	        fenced = re.findall(r"```(?:json|text)?\s*(.*?)```", text,
   417	                            flags=re.IGNORECASE | re.DOTALL)
   418	        payloads.extend(reversed(fenced))
   419	        payloads.append(text)
   420	    for payload in payloads:
   421	        cleaned = payload.strip()
   422	        try:
   423	            if cleaned.startswith("[") and cleaned.endswith("]"):
   424	                value = json.loads(cleaned)
