   558	def _nearest_distinct(primes: list[int], targets: list[int]) -> list[int]:
   559	    chosen: list[int] = []
   560	    for target in targets:
   561	        index = bisect.bisect_left(primes, target)
   562	        options = []
   563	        for j in range(max(0, index - 3), min(len(primes), index + 4)):
   564	            if primes[j] not in chosen:
   565	                options.append(primes[j])
   566	        if not options:
   567	            options = [p for p in primes if p not in chosen]
   568	        chosen.append(min(options, key=lambda p: (abs(p - target), p)))
   569	    return sorted(chosen)
