   439	def verify(inst: dict, answer: object) -> tuple[bool, str]:
   440	    """Check any valid witness using only instance data and exact arithmetic."""
   441	    if not isinstance(answer, list):
   442	        return False, "answer must be a list of four integers"
   443	    if len(answer) != 4:
   444	        return False, f"expected exactly 4 primes, got {len(answer)}"
   445	    if any(isinstance(v, bool) or not isinstance(v, int) for v in answer):
   446	        return False, "all four entries must be base-10 integers"
   447	    if len(set(answer)) != 4:
   448	        return False, "the four primes must be pairwise distinct"
   449	    if any(answer[i] >= answer[i + 1] for i in range(3)):
   450	        return False, "the four primes must be in strictly increasing order"
   451	    lower = int(inst["prime_lower"])
   452	    upper = int(inst["prime_upper"])
   453	    for index, value in enumerate(answer):
   454	        if value < lower or value > upper:
   455	            return False, f"entry {index} is outside the inclusive prime interval"
   456	    for index, value in enumerate(answer):
   457	        if not _is_prime(value):
   458	            return False, f"entry {index} is not prime"
   459	    exponents = inst.get("power_exponents")
   460	    if not (isinstance(exponents, list) and len(exponents) == 46
   461	            and all(isinstance(e, int) and not isinstance(e, bool) and e >= 0
   462	                    for e in exponents)):
   463	        return False, "instance has a malformed exponent list"
   464	    power_total = sum(1 << e for e in exponents)
   465	    if power_total != inst.get("power_total"):
   466	        return False, "instance power checksum is inconsistent"
   467	    prime_total = sum(value * value for value in answer)
   468	    if prime_total + power_total != inst.get("target"):
   469	        return False, "the four prime squares and 46 powers do not sum to N"
   470	    return True, "ok"
