   572	def _attack_candidates(inst: dict, restart_seed: int) -> dict[str, list[int] | None]:
   573	    primes = inst["_prime_pool"]
   574	    lower, upper = inst["prime_lower"], inst["prime_upper"]
   575	    width = upper - lower
   576	    attacks: dict[str, list[int] | None] = {}
   577	
   578	    quartiles = [lower + width * k // 5 for k in range(1, 5)]
   579	    attacks["outlier_interval_quartiles"] = _nearest_distinct(primes, quartiles)
   580	
   581	    remaining = inst["prime_square_target"]
   582	    available = list(primes)
   583	    greedy: list[int] = []
   584	    for slots_left in range(4, 0, -1):
   585	        target = math.isqrt(max(0, remaining // slots_left))
   586	        pick = _nearest_distinct(available, [target])[0]
   587	        greedy.append(pick)
   588	        available.remove(pick)
   589	        remaining -= pick * pick
   590	    attacks["greedy_equal_residual"] = sorted(greedy)
   591	
   592	    center = math.isqrt(inst["prime_square_target"] // 4)
   593	    center_index = bisect.bisect_left(primes, center)
   594	    consecutive_hit = None
   595	    for start in range(max(0, center_index - 40),
   596	                       min(len(primes) - 3, center_index + 41)):
   597	        candidate = primes[start:start + 4]
   598	        if _fast_valid(inst, candidate):
   599	            consecutive_hit = candidate
   600	            break
   601	    attacks["consecutive_prime_windows_80"] = consecutive_hit
   602	
   603	    by_hand_hit = None
   604	    target = inst["prime_square_target"]
   605	    for slot in range(1, 9):
   606	        gap = _WHEEL * slot
   607	        radicand = target - 5 * gap * gap
   608	        if radicand < 0:
   609	            continue
   610	        centered = math.isqrt(radicand)
   611	        if centered * centered != radicand or (centered - 3 * gap) % 2:
   612	            continue
   613	        start = (centered - 3 * gap) // 2
   614	        candidate = [start + k * gap for k in range(4)]
   615	        if verify(inst, candidate)[0]:
   616	            by_hand_hit = candidate
   617	            break
   618	    attacks["by_hand_ap_first_8_wheel_steps"] = by_hand_hit
   619	
   620	    rng = random.Random(restart_seed)
   621	    random_hit = None
   622	    for _ in range(512):
   623	        candidate = random_candidate(inst, rng)
   624	        if _fast_valid(inst, candidate):
   625	            random_hit = candidate
   626	            break
   627	    attacks["random_restart_512"] = random_hit
   628	    return attacks
