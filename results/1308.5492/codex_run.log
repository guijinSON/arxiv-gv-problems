   194	def _is_prime(value: int) -> bool:
   195	    """Deterministic Miller-Rabin for every unsigned 64-bit integer."""
   196	    if isinstance(value, bool) or not isinstance(value, int) or value < 2:
   197	        return False
   198	    for prime in _SMALL_PRIMES:
   199	        if value % prime == 0:
   200	            return value == prime
   201	    if value >= 1 << 64:
   202	        # Current presets never enter this branch.  Trial division is exact and
   203	        # keeps verify honest if a caller supplies a larger candidate.
   204	        limit = math.isqrt(value)
   205	        divisor = 41
   206	        while divisor <= limit:
   207	            if value % divisor == 0:
   208	                return False
   209	            divisor += 2
   210	        return True
   211	    odd_part = value - 1
   212	    twos = 0
   213	    while odd_part % 2 == 0:
   214	        twos += 1
   215	        odd_part //= 2
   216	    for base in _MR_BASES_64:
   217	        if base % value == 0:
   218	            continue
   219	        x = pow(base, odd_part, value)
   220	        if x in (1, value - 1):
   221	            continue
   222	        for _ in range(twos - 1):
   223	            x = x * x % value
   224	            if x == value - 1:
   225	                break
   226	        else:
   227	            return False
   228	    return True
