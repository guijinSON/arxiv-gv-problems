+    denominator = 2 * lower
+    offset_low = -((-(residual - 4 * width * width)) // denominator)
+    offset_high = residual // denominator
+    offset_low = max(0, offset_low)
+    offset_high = min(4 * width, offset_high)
+    return 4 * lower + offset_low, 4 * lower + offset_high
