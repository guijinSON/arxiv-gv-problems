   529	def canonical_key(inst: dict) -> str:
   530	    normal_form = {
   531	        "target": int(inst["target"]),
   532	        "prime_interval": [int(inst["prime_lower"]), int(inst["prime_upper"])],
   533	        "power_exponents": sorted(int(e) for e in inst["power_exponents"]),
   534	    }
   535	    blob = json.dumps(normal_form, sort_keys=True, separators=(",", ":"))
   536	    return hashlib.sha256(blob.encode("ascii")).hexdigest()
