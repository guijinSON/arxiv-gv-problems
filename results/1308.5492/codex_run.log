 print({'seed':seed,'lo':i['prime_lower'],'primes':i['prime_count'],'sum_width':b[1]-b[0]+1,'space':sp,'valid':cnt,'build':round(build,3),'ref_s':round(elapsed,3),'ops':cost['operations'],'pairs':cost['pair_visits'],'attacks':attacks})
