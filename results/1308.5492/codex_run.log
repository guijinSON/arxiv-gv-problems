   631	def _reference_four_sum(inst: dict) -> tuple[list[int] | None, dict[str, int]]:
   632	    """Segmented-sieve + incremental pair hash, independent of the plant."""
   633	    primes = inst["_prime_pool"]
   634	    count = len(primes)
   635	    squares = [p * p for p in primes]
   636	    target = inst["prime_square_target"]
   637	    table: dict[int, int | list[int]] = {}
   638	    operations = count
   639	    pair_visits = 0
   640	    for j in range(1, count):
   641	        square_j = squares[j]
   642	        for i in range(j):
   643	            total = squares[i] + square_j
   644	            complement = target - total
   645	            pair_visits += 1
   646	            operations += 3
   647	            previous = table.get(complement)
   648	            if previous is not None:
   649	                codes = previous if isinstance(previous, list) else [previous]
   650	                for code in codes:
   651	                    a, b = divmod(code, count)
   652	                    operations += 1
   653	                    if len({a, b, i, j}) == 4:
   654	                        answer = sorted((primes[a], primes[b], primes[i], primes[j]))
   655	                        if verify(inst, answer)[0]:
   656	                            return answer, {
   657	                                "operations": operations,
   658	                                "pair_visits": pair_visits,
   659	                                "stored_pair_sums": len(table),
   660	                            }

