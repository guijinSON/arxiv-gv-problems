   490	def _pair_table_count(inst: dict) -> int:
   491	    """Count exact increasing solutions; caller caps the candidate count."""
   492	    primes = inst["_prime_pool"]
   493	    target = inst["prime_square_target"]
   494	    groups: dict[int, list[tuple[int, int]]] = {}
   495	    for j in range(1, len(primes)):
   496	        square_j = primes[j] * primes[j]
   497	        for i in range(j):
   498	            total = primes[i] * primes[i] + square_j
   499	            groups.setdefault(total, []).append((i, j))
   500	    partitions = 0
   501	    for total, pairs in groups.items():
   502	        complement = target - total
   503	        other = groups.get(complement)
   504	        if other is None or total > complement:
   505	            continue
   506	        if total < complement:
   507	            for a, b in pairs:
   508	                for c, d in other:
   509	                    if len({a, b, c, d}) == 4:
   510	                        partitions += 1
   511	        else:
   512	            for left in range(len(pairs)):
   513	                a, b = pairs[left]
   514	                for right in range(left + 1, len(pairs)):
   515	                    c, d = pairs[right]
   516	                    if len({a, b, c, d}) == 4:
   517	                        partitions += 1
   518	    if partitions % 3:
   519	        raise AssertionError("four-sum partition count was not divisible by three")
   520	    return partitions // 3
   521	
   522	
   523	def enumerate_all(inst: dict) -> int | None:
   524	    if int(inst.get("prime_count", 10**9)) > 180:
   525	        return None
   526	    return _pair_table_count(inst)
