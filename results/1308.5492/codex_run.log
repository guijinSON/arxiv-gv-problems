   539	def escalate(params: dict) -> dict | str | None:
   540	    current = {k: v for k, v in params.items() if k != "_preset"}
   541	    n = int(current.get("n", 0))
   542	    if n < 39_000:
   543	        current["n"] = min(39_000, n + 4_000)
   544	        # Move the plant farther beyond the hand-scale AP guesses and widen the
   545	        # hidden gap distribution while the four-number answer stays fixed.
   546	        current["min_gap_slot"] = min(
   547	            int(current["gap_slots"]), int(current["min_gap_slot"]) + 2
   548	        )
   549	        supported = current["n"] // (3 * _WHEEL)
   550	        current["gap_slots"] = min(supported, int(current["gap_slots"]) + 4)
   551	        return current
   552	    # Larger intervals push the compact AP scan beyond the 300-operation cap.
   553	    # Raising only the integer magnitude shrinks the prime pool and is not a
   554	    # monotone hardness axis, so no honest further escalation is available.
   555	    return None
