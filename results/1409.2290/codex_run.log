   603	        "drop": ans[:-1],
   604	        "swap": swapped,
   605	        "duplicate": ans + [ans[-1]],
   606	        "empty": [],
   607	        "out_of_range": out_of_range,
   608	    }
   609	    rejected = {}
   610	    for name, bad in corruptions.items():
   611	        ok, why = verify(ship, bad)
   612	        rejected[name] = {"rejected": not ok, "reason": why}
   613	    distinct_reasons = len({v["reason"] for v in rejected.values()})
   614	    report["G2_rejects_corruption"] = {
   615	        "pass": all(v["rejected"] for v in rejected.values()) and distinct_reasons == 5,
   616	        "cases": rejected,
   617	        "distinct_reasons": distinct_reasons,
