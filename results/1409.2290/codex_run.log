/bin/bash -lc "python3 -m py_compile gen_1409_2290.py && python3 gen_1409_2290.py > selftest_report.json && python3 -m json.tool selftest_report.json >/dev/null && python3 - <<'PY'
import importlib.util, json, os, random
p='gen_1409_2290.py'
s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.TRACK in ('A','B')
for name,params in g.DIFFICULTY.items():
    a=g.make_instance(seed=123,**params); b=g.make_instance(seed=123,**params)
    assert a==b
    assert json.loads(json.dumps(a['answer']))==a['answer']
    raw='preface\\n"'```json'"\\n<answer>'+json.dumps(a['answer'])+'</answer>\\n"'```'"\\nafter'
    assert g.parse_answer(raw)==a['answer']
    assert g.verify(a,g.parse_answer(raw))==(True,'ok')
    old=os.environ.pop('GV_HINT_MODE',None)
    bare=g.render(a)
    os.environ['GV_HINT_MODE']='structural'; hinted=g.render(a)
    os.environ['GV_HINT_MODE']='placebo'; placebo=g.render(a)
    if old is None: os.environ.pop('GV_HINT_MODE',None)
    else: os.environ['GV_HINT_MODE']=old
    assert g.STRUCTURAL_HINT not in bare and g.PLACEBO_HINT not in bare
    assert g.STRUCTURAL_HINT in hinted and g.PLACEBO_HINT in placebo
print('module_contract_ok')
print(json.dumps(json.load(open('selftest_report.json')),indent=2,sort_keys=True))
