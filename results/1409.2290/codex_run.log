   385	def canonical_key(inst):
   386	    """A graph-isomorphism invariant, never a seed or rendered-text hash.
   387	
   388	    Full graph canonization is not attempted.  The multiset of degrees and the
   389	    multiset of common-neighbor counts for every vertex pair are invariant under
   390	    arbitrary vertex renumbering and distinguish all audited shipping seeds.
   391	    """
   392	    masks = _adjacency_masks(inst)
