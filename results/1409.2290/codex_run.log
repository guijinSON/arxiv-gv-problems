   357	def random_candidate(inst, rng):
   358	    mask = rng.getrandbits(inst["n"] - 1)
   359	    switches = [0] + [(mask >> i) & 1 for i in range(inst["n"] - 1)]
   360	    return _candidate_from_switches(switches)
   361	
   362	
   363	def search_space(inst):
   364	    return 1 << (inst["n"] - 1)
   365	
   366	
   367	def enumerate_all(inst):
   368	    n = inst["n"]
   369	    space = 1 << (n - 1)
   370	    if space > 1_000_000:
   371	        return None
   372	    count = 0
   373	    for mask in range(space):
   374	        switches = [0] + [(mask >> (i - 1)) & 1 for i in range(1, n)]
   375	        count += int(_is_exact_witness(inst, _candidate_from_switches(switches)))
   376	    return count
