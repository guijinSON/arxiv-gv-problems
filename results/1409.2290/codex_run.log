   290	def parse_answer(text):
   291	    if not isinstance(text, str):
   292	        return None
   293	    match = re.search(r"<answer\s*>(.*?)</answer\s*>", text,
   294	                      flags=re.IGNORECASE | re.DOTALL)
   295	    if not match:
   296	        return None
   297	    payload = match.group(1).strip()
   298	    payload = re.sub(r"^```(?:json|text)?\s*|\s*```$", "", payload,
   299	                     flags=re.IGNORECASE | re.DOTALL).strip()
   300	    try:
   301	        value = json.loads(payload)
   302	    except (TypeError, ValueError, json.JSONDecodeError):
   303	        return None
   304	    return value if isinstance(value, list) else None
