   620	    response = (
   621	        "The signs give the normalized eigendirection.\n```json\n"
   622	        "<answer>" + json.dumps(ans) + "</answer>\n```\n"
   623	        "The opposite global sign was excluded by the first coordinate."
   624	    )
   625	    parsed = parse_answer(response)
   626	    json_native = json.loads(json.dumps(ans)) == ans
   627	    report["G3_round_trip"] = {
   628	        "pass": parsed == ans and json_native,
   629	        "parsed_matches": parsed == ans,
   630	        "json_native": json_native,
   631	    }
   632	
   633	    density_inst = make_instance(seed=11, **DIFFICULTY[SHIPPING_DIFFICULTY])
   634	    target, _ = _compact_certificate(density_inst)
   635	    density_rng = random.Random(0x14092290)
   636	    samples = 200_000
   637	    hits = 0
   638	    start = time.perf_counter()
   639	    for _ in range(samples):
   640	        hits += int(random_candidate(density_inst, density_rng) == target)
   641	    density_wall = time.perf_counter() - start
   642	    observed = hits / samples
   643	    report["G4_guess_resistance"] = {
