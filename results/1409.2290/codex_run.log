   593	    ans = ship["answer"]
   594	    swapped = ans[:]
   595	    # Swap entries from different fibres with opposite signs; this necessarily
   596	    # breaks at least one antipodal fibre without changing the length/alphabet.
   597	    pair = next((i, j) for i in range(2, len(ans)) for j in range(i + 1, len(ans))
   598	                if i // 2 != j // 2 and ans[i] != ans[j])
   599	    swapped[pair[0]], swapped[pair[1]] = swapped[pair[1]], swapped[pair[0]]
   600	    out_of_range = ans[:]
   601	    out_of_range[2] = 2
