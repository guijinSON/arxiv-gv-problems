   164	def make_instance(n, seed=0, **params) -> dict:
   165	    """Construct a certified equitable two-community graph by inverse generation.
   166	
   167	    ``n`` is the odd number of vertex fibres; the graph has 2n vertices.  The
   168	    switching gauge (and hence the answer) is sampled first.  Offset signs and
   169	    lift twists are then assembled around it, so no recovery algorithm is run.
   170	    """
   171	    n = int(n)
   172	    t = int(params.get("negative_offsets", max(1, (n - 3) // 8)))
   173	    _validate_parameters(n, t)
   174	    rng = random.Random(seed)
   175	    half = (n - 1) // 2
   176	    negative = set(rng.sample(range(1, half + 1), t))
   177	
   178	    # A global flip is the same partition, so fix the first gauge bit to zero.
   179	    switches = [0] + [rng.randrange(2) for _ in range(n - 1)]
   180	    tables = []
   181	    for g in range(1, half + 1):
   182	        template_twist = int(g in negative)
   183	        bits = [
   184	            template_twist ^ switches[i] ^ switches[(i + g) % n]
   185	            for i in range(n)
   186	        ]
   187	        tables.append({"offset": g, "twists": "".join(map(str, bits))})
   188	
   189	    return {
   190	        "paper": "1409.2290",
   191	        "n": n,
   192	        "vertex_count": 2 * n,
   193	        "degree": n - 1,
   194	        "negative_offsets": t,
   195	        "eigenvalue": n - 1 - 4 * t,
   196	        "twist_tables": tables,
   197	        "answer": _candidate_from_switches(switches),
   198	    }
   199	
   200	
   201	def _tables_by_offset(inst) -> dict[int, str]:
   202	    return {int(row["offset"]): row["twists"] for row in inst["twist_tables"]}
   203	
   204	
   205	def _twist_between(inst, i: int, j: int) -> int:
   206	    """Twist on the undirected base edge {i,j}, queried in either direction."""
   207	    n = inst["n"]
   208	    half = (n - 1) // 2
   209	    rows = _tables_by_offset(inst)
   210	    d = (j - i) % n
   211	    if not 1 <= d < n:
   212	        raise ValueError("base vertices must be distinct")
   213	    if d <= half:
   214	        return int(rows[d][i])
   215	    g = n - d
   216	    return int(rows[g][j])
   217	
   218	
   219	def _adjacency_masks(inst) -> list[int]:
   220	    n = inst["n"]
   221	    total = 2 * n
   222	    masks = [0] * total
   223	    for row in inst["twist_tables"]:
   224	        g = int(row["offset"])
   225	        bits = row["twists"]
   226	        if len(bits) != n or any(ch not in "01" for ch in bits):
   227	            raise ValueError("malformed twist table")
   228	        for i, ch in enumerate(bits):
   229	            j = (i + g) % n
   230	            twist = int(ch)
   231	            for b in (0, 1):
   232	                u = 2 * i + b
   233	                v = 2 * j + (b ^ twist)
   234	                masks[u] |= 1 << v
   235	                masks[v] |= 1 << u
   236	    return masks
   237	
   238	
   239	def _adjacency_lists(inst) -> list[list[int]]:
   240	    rows = []
   241	    for mask in _adjacency_masks(inst):
   242	        nbrs = []
   243	        while mask:
   244	            low = mask & -mask
   245	            nbrs.append(low.bit_length() - 1)
   246	            mask ^= low
   247	        rows.append(nbrs)
   248	    return rows
   249	
