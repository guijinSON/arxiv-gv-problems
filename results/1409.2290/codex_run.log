import gen_1409_2290 as g
for n in (5,7,11,13,17):
 half=(n-1)//2
 for t in sorted({1,max(1,half//2),half}):
  if t>half: continue
  for seed in range(5):
   i=g.make_instance(n,seed=seed,negative_offsets=t)
   count=g.enumerate_all(i)
   if count "'!= 1:
    raise SystemExit((n,t,seed,count))
print('"'small-prime uniqueness: 55/55 exact enumerations have one normalized witness')
for preset,p in g.DIFFICULTY.items():
 for seed in (0,1,7,99):
  a=g.make_instance(seed=seed,**p)
  b=g.make_instance(seed=seed,**p)
  assert a==b
  assert g.parse_answer('<answer>'+__import__('json').dumps(a['answer'])+'</answer>')==a['answer']
  assert g.verify(a,a['answer'])==(True,'ok')
print('determinism/round-trip/verify: 16/16')
