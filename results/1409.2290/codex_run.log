   399	    # the graph.  Include it so that the same graph paired with a different target
   400	    # cannot be over-collapsed to the same key.
   401	    structural = [len(masks), int(inst["eigenvalue"]), degrees, common]
   402	    blob = json.dumps(structural, separators=(",", ":"), sort_keys=True)
