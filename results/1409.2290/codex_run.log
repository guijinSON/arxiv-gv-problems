   480	def _attack_candidates(inst, rng):
   481	    n = inst["n"]
   482	    degree = inst["degree"]
   483	
   484	    # Per-fibre twist count: an outlier statistic analogous to degree sorting.
   485	    twist_degrees = []
   486	    for i in range(n):
   487	        twist_degrees.append(sum(_twist_between(inst, i, j)
   488	                                 for j in range(n) if j != i))
   489	    outlier_bits = [int(v > degree / 2) for v in twist_degrees]
   490	    anchor = outlier_bits[0]
   491	    outlier_bits = [b ^ anchor for b in outlier_bits]
   492	
   493	    # Greedy assumes every direct edge from fibre 0 is within-community.  Every
   494	    # generated instance has at least one negative offset, so this makes errors.
   495	    greedy_bits = [0] + [_twist_between(inst, 0, i) for i in range(1, n)]
   496	
   497	    alternating_bits = [i & 1 for i in range(n)]
   498	    random_tries = [random_candidate(inst, rng) for _ in range(256)]
   499	    return {
   500	        "outlier_twist_degree": [_candidate_from_switches(outlier_bits)],
   501	        "greedy_direct_anchor": [_candidate_from_switches(greedy_bits)],
   502	        "alternating_index_ansatz": [_candidate_from_switches(alternating_bits)],
   503	        "random_restart_256": random_tries,
   504	    }
   505	
   506	
   507	def _reorder_tables(inst, rng):
   508	    out = {k: v for k, v in inst.items() if k not in ("twist_tables", "answer")}
   509	    rows = [dict(row) for row in inst["twist_tables"]]
   510	    rng.shuffle(rows)
   511	    out["twist_tables"] = rows
   512	    out["answer"] = inst["answer"][:]
   513	    return out
