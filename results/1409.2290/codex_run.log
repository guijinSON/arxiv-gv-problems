   190	def make_instance(n, seed=0, **params) -> dict:
   191	    """Construct a certified equitable two-community graph by inverse generation.
   192	
   193	    ``n`` is the odd number of vertex fibres; the graph has 2n vertices.  The
   194	    switching gauge (and hence the answer) is sampled first.  Offset signs and
   195	    lift twists are then assembled around it, so no recovery algorithm is run.
   196	    """
   197	    n = int(n)
   198	    t = int(params.get("negative_offsets", max(1, (n - 1) // 4)))
   199	    _validate_parameters(n, t)
   200	    rng = random.Random(seed)
   201	    half = (n - 1) // 2
   202	    negative = set(rng.sample(range(1, half + 1), t))
   203	
   204	    # A global flip is the same partition, so fix the first gauge bit to zero.
   205	    switches = [0] + [rng.randrange(2) for _ in range(n - 1)]
   206	    tables = []
   207	    for g in range(1, half + 1):
   208	        template_twist = int(g in negative)
   209	        bits = [
   210	            template_twist ^ switches[i] ^ switches[(i + g) % n]
   211	            for i in range(n)
   212	        ]
   213	        tables.append({"offset": g, "twists": "".join(map(str, bits))})
   214	
   215	    return {
   216	        "paper": "1409.2290",
   217	        "n": n,
   218	        "vertex_count": 2 * n,
   219	        "degree": n - 1,
   220	        "negative_offsets": t,
   221	        "eigenvalue": n - 1 - 4 * t,
   222	        "twist_tables": tables,
   223	        # This redundant exact checksum lets the compact route spend its budget
   224	        # on recovering the answer rather than recomputing a displayed row parity.
   225	        "calibration_offset": 1,
   226	        "calibration_parity": sum(map(int, tables[0]["twists"])) & 1,
   227	        "answer": _candidate_from_switches(switches),
   228	    }
