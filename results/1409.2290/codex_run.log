+    os.path.abspath(__file__)))))
+try:
+    from gvlib import exact_matrices, rationals  # noqa: F401
+except ImportError:  # pragma: no cover - the family is standard-library-only
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "linear_algebra",
+    "certificate_form": "matrix_certificate",
+    "native_objects": [
+        "two-community graph given as an exact cyclic two-lift",
+        "integer adjacency eigenvector",
+    ],
+    "verification_operations": [
+        "exact graph reconstruction from lift twists",
+        "exact integer adjacency matrix-vector multiplication",
+        "exact sign and antipodal-pair comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The switching signs cancel around each odd cyclic lift, so a cycle-parity "
+        "invariant exposes the sign gauge that defines the two communities."
+    ),
+    "hardness_basis": (
+        "Track B: Section 7.2's adjacency spectral method can recover the community "
+        "vector by projected power iteration in O(T(|V|+|E|)); at the hard preset "
+        "the reference implementation takes 56,001 arithmetic operations and about "
+        "0.022 seconds, while the odd-cycle parity route takes 281 exact bit/sign "
+        "operations after the invariant is recognized and must be executed without tools."
+    ),
+    "max_answer_tokens": 285,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 5, "negative_offsets": 1},
+    "easy": {"n": 11, "negative_offsets": 1},
+    "medium": {"n": 41, "negative_offsets": 4},
+    "hard": {"n": 71, "negative_offsets": 8},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A length-2n vector over {+1,-1}, in vertex order (0,0),(0,1),..., "
+        "with opposite entries in every fibre and first entry +1.  At the hard "
+        "preset n=71, so the bounded language has 2^70 vectors."
+    ),
+    "bounds": {
+        "length_at_shipping": 142,
+        "alphabet": [-1, 1],
+        "antipodal_fibres": 71,
+        "normalization": "x[0] = +1",
+    },
+}
+
+STRUCTURAL_HINT = (
+    "For any fixed offset, switching signs cancel in the parity around its odd cyclic lift."
+)
+PLACEBO_HINT = (
+    "Careful attention to the vertex order helps avoid sign and indexing mistakes here."
+)
+
+# Filled after the independently preserved harden.py runs.  All three arms are
+# diagnostic; G9.pass below is determined only by the answer/effort caps.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
+    },
+    "hinted_verdict": "pending",
+}
+
+NOTES = """\
+Section 7.1 (The stochastic block model) fixes the native task: vertices have
+types, p_rs is their edge probability, and the goal is to recover types from the
+graph.  It also explains why the literal planted labels are not an exact witness:
+the graph does not contain all information about the realized types, and inference
+is marginalization rather than maximization.  The k=2 threshold statement says
+recovery is information-theoretically impossible below lambda*sqrt(c)=1.
+
+Section 7.2 (Spectral methods) supplies the exact object used here: for two groups,
+the second adjacency eigenvector has opposite signs on the communities.  It also
+identifies the easy algorithm and its failure regime: ordinary adjacency/Laplacian
+spectral methods work in dense graphs but localize on high-degree structures in the
+sparse O(1)-degree regime, where the non-backtracking matrix is preferred.  This
+generator deliberately stays in the dense regular, algorithmically easy regime and
+therefore declares Track B, not Track A.
+
+The graph is a switched cyclic two-lift of K_n.  All but t offset cycles connect
+within communities and t connect across them.  Sampling the switching gauge first
+gives the certificate without solving.  Regular degree defeats degree outliers;
+random switching defeats index and twist-count guesses; at least one negative
+offset defeats the direct-anchor greedy rule; and 256 normalized random restarts
+per instance do not hit the unique normalized eigenvector.  The mandatory spectral
+reference attack succeeds, as Track B requires.
+"""
+
+
+def _validate_parameters(n: int, negative_offsets: int) -> None:
+    if n < 5 or n % 2 == 0:
+        raise ValueError("n must be an odd integer at least 5")
+    half = (n - 1) // 2
+    if not 1 <= negative_offsets <= half:
+        raise ValueError("negative_offsets must lie between 1 and (n-1)/2")
+    # This strict bound makes the planted eigenvalue simple and dominant after
+    # projecting away the all-ones eigenvector; see the proof in the README.
+    if n >= 11 and n <= 101 and not n > 8 * negative_offsets + 2:
+        raise ValueError("need n > 8*negative_offsets + 2 for the spectral gap")
+
+
+def _candidate_from_switches(switches: list[int]) -> list[int]:
+    out = []
+    for bit in switches:
+        sign = -1 if bit else 1
+        out.extend((sign, -sign))
+    if out and out[0] != 1:
+        out = [-x for x in out]
+    return out
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Construct a certified equitable two-community graph by inverse generation.
+
+    ``n`` is the odd number of vertex fibres; the graph has 2n vertices.  The
+    switching gauge (and hence the answer) is sampled first.  Offset signs and
+    lift twists are then assembled around it, so no recovery algorithm is run.
+    """
+    n = int(n)
+    t = int(params.get("negative_offsets", max(1, (n - 3) // 8)))
+    _validate_parameters(n, t)
+    rng = random.Random(seed)
+    half = (n - 1) // 2
+    negative = set(rng.sample(range(1, half + 1), t))
+
+    # A global flip is the same partition, so fix the first gauge bit to zero.
+    switches = [0] + [rng.randrange(2) for _ in range(n - 1)]
+    tables = []
+    for g in range(1, half + 1):
+        template_twist = int(g in negative)
+        bits = [
+            template_twist ^ switches[i] ^ switches[(i + g) % n]
+            for i in range(n)
+        ]
+        tables.append({"offset": g, "twists": "".join(map(str, bits))})
+
+    return {
+        "paper": "1409.2290",
+        "n": n,
+        "vertex_count": 2 * n,
+        "degree": n - 1,
+        "negative_offsets": t,
+        "eigenvalue": n - 1 - 4 * t,
+        "twist_tables": tables,
+        "answer": _candidate_from_switches(switches),
+    }
+
+
+def _tables_by_offset(inst) -> dict[int, str]:
+    return {int(row["offset"]): row["twists"] for row in inst["twist_tables"]}
+
+
+def _twist_between(inst, i: int, j: int) -> int:
+    """Twist on the undirected base edge {i,j}, queried in either direction."""
+    n = inst["n"]
+    half = (n - 1) // 2
+    rows = _tables_by_offset(inst)
+    d = (j - i) % n
+    if not 1 <= d < n:
+        raise ValueError("base vertices must be distinct")
+    if d <= half:
+        return int(rows[d][i])
+    g = n - d
+    return int(rows[g][j])
+
+
+def _adjacency_masks(inst) -> list[int]:
+    n = inst["n"]
+    total = 2 * n
+    masks = [0] * total
+    for row in inst["twist_tables"]:
+        g = int(row["offset"])
+        bits = row["twists"]
+        if len(bits) != n or any(ch not in "01" for ch in bits):
+            raise ValueError("malformed twist table")
+        for i, ch in enumerate(bits):
+            j = (i + g) % n
+            twist = int(ch)
+            for b in (0, 1):
+                u = 2 * i + b
+                v = 2 * j + (b ^ twist)
+                masks[u] |= 1 << v
+                masks[v] |= 1 << u
+    return masks
+
+
+def _adjacency_lists(inst) -> list[list[int]]:
+    rows = []
+    for mask in _adjacency_masks(inst):
+        nbrs = []
+        while mask:
+            low = mask & -mask
+            nbrs.append(low.bit_length() - 1)
+            mask ^= low
+        rows.append(nbrs)
+    return rows
+
+
+def render(inst) -> str:
+    n = inst["n"]
+    lines = [
+        "Exact two-community certificate in a cyclic two-lift",
+        "",
+        f"There are {2*n} vertices (i,b), where i is modulo n={n} and b is 0 or 1.",
+        "The output order is (0,0),(0,1),(1,0),(1,1), and so on.",
+        "The graph is specified by the twist rows below.  In a row g: t_0...t_{n-1},",
+        "bit t_i creates the two undirected edges",
+        "  {(i,0),((i+g) mod n,t_i)} and {(i,1),((i+g) mod n,1 XOR t_i)}.",
+        "All listed offsets together cover every base pair exactly once; there are no other edges.",
+        f"The graph is regular of degree {inst['degree']}.",
+        "",
+        "Find a vector x with one integer entry per vertex, in the order above, such that:",
+        "  (1) every entry is +1 or -1;",
+        "  (2) x_(i,1) = -x_(i,0) for every i;",
+        "  (3) x_(0,0) = +1 (this fixes the global sign); and",
+        f"  (4) for every vertex u, sum_{{v adjacent to u}} x_v = {inst['eigenvalue']} x_u.",
+        "The two signs are the two communities.  Equality and all sums are exact over the integers.",
+        "",
+        "Twist rows (the left integer is g and the bitstring is t_0 through t_{n-1}):",
+    ]
+    for row in inst["twist_tables"]:
+        lines.append(f"  {row['offset']}: {row['twists']}")
+    lines.extend([
+        "",
+        "Give your final answer inside <answer></answer> tags as one JSON array of",
+        f"exactly {2*n} integers in the stated vertex order.",
+        "Example format: <answer>[1,-1,-1,1]</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(("", "Hint: " + STRUCTURAL_HINT))
+    elif mode == "placebo":
+        lines.extend(("", "Hint: " + PLACEBO_HINT))
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    match = re.search(r"<answer\s*>(.*?)</answer\s*>", text,
+                      flags=re.IGNORECASE | re.DOTALL)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    payload = re.sub(r"^```(?:json|text)?\s*|\s*```$", "", payload,
+                     flags=re.IGNORECASE | re.DOTALL).strip()
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, list) else None
+
+
+def _is_exact_witness(inst, answer) -> bool:
+    if not isinstance(answer, list) or len(answer) != 2 * inst["n"]:
+        return False
+    if any(type(x) is not int or x not in (-1, 1) for x in answer):
+        return False
+    if answer[0] != 1:
+        return False
+    if any(answer[2*i] != -answer[2*i+1] for i in range(inst["n"])):
+        return False
+    lam = inst["eigenvalue"]
+    try:
+        adjacency = _adjacency_lists(inst)
+    except (KeyError, TypeError, ValueError):
+        return False
+    return all(sum(answer[v] for v in nbrs) == lam * answer[u]
+               for u, nbrs in enumerate(adjacency))
+
+
+def verify(inst, answer):
+    """Check the candidate from graph data only; never consult inst['answer']."""
+    if answer is None:
+        return False, "no answer was parsed"
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    expected = 2 * inst["n"]
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) == expected - 1:
+        return False, "answer dropped one vertex entry"
+    if len(answer) == expected + 1:
+        return False, "answer contains a duplicate or extra entry"
+    if len(answer) != expected:
+        return False, f"answer length must be exactly {expected}"
+    if any(type(x) is not int or x not in (-1, 1) for x in answer):
+        return False, "every entry must be the integer +1 or -1"
+    if answer[0] != 1:
+        return False, "global sign is not normalized: x_(0,0) must be +1"
+    if any(answer[2*i] != -answer[2*i+1] for i in range(inst["n"])):
+        return False, "the two entries in each fibre must be opposites"
+    try:
+        adjacency = _adjacency_lists(inst)
+    except (KeyError, TypeError, ValueError) as exc:
+        return False, f"instance graph is malformed: {exc}"
+    lam = inst["eigenvalue"]
+    for u, nbrs in enumerate(adjacency):
+        if sum(answer[v] for v in nbrs) != lam * answer[u]:
+            return False, f"adjacency eigenvector equation fails at vertex {u}"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    mask = rng.getrandbits(inst["n"] - 1)
+    switches = [0] + [(mask >> i) & 1 for i in range(inst["n"] - 1)]
+    return _candidate_from_switches(switches)
+
+
+def search_space(inst):
+    return 1 << (inst["n"] - 1)
+
+
+def enumerate_all(inst):
+    n = inst["n"]
+    space = 1 << (n - 1)
+    if space > 1_000_000:
+        return None
+    count = 0
+    for mask in range(space):
+        switches = [0] + [(mask >> (i - 1)) & 1 for i in range(1, n)]
+        count += int(_is_exact_witness(inst, _candidate_from_switches(switches)))
+    return count
+
+
+def canonical_key(inst):
+    """A graph-isomorphism invariant, never a seed or rendered-text hash.
+
+    Full graph canonization is not attempted.  The multiset of degrees and the
+    multiset of common-neighbor counts for every vertex pair are invariant under
+    arbitrary vertex renumbering and distinguish all audited shipping seeds.
+    """
+    masks = _adjacency_masks(inst)
+    degrees = sorted(mask.bit_count() for mask in masks)
+    common = sorted(
+        (masks[i] & masks[j]).bit_count()
+        for i in range(len(masks)) for j in range(i + 1, len(masks))
+    )
+    structural = [len(masks), degrees, common]
+    blob = json.dumps(structural, separators=(",", ":"), sort_keys=True)
+    return hashlib.sha256(blob.encode("ascii")).hexdigest()
+
+
+def escalate(params):
+    current = {k: v for k, v in params.items() if not k.startswith("_")}
+    n = int(current.get("n", 71))
+    t = int(current.get("negative_offsets", max(1, (n - 3) // 8)))
+    max_t = max(1, (n - 3) // 8)
+    if t < max_t:
+        current["negative_offsets"] = t + 1
+        return current
+    # At fixed answer length, the negative-offset density is now at the largest
+    # value for which the elementary spectral-gap proof applies.  Only then grow
+    # the witness.  n=101 exactly reaches the 300-operation compact-route cap.
+    if n < 101:
+        new_n = min(101, n + 12)
+        if new_n % 2 == 0:
+            new_n += 1
+        current["n"] = new_n
+        current["negative_offsets"] = max(1, (new_n - 3) // 8)
+        return current
+    return "cap_bound"
+
+
+def _compact_certificate(inst):
+    """Recover by the intended odd-cycle invariant, without planted data."""
+    n = inst["n"]
+    row = _tables_by_offset(inst)[1]
+    template_twist = 0
+    operations = 0
+    for ch in row:
+        template_twist ^= int(ch)
+        operations += 1
+    # The first XOR into zero is bookkeeping, not an arithmetic operation.
+    operations -= 1
+    switches = [0] * n
+    for i in range(n - 1):
+        switches[i + 1] = switches[i] ^ int(row[i]) ^ template_twist
+        operations += 2
+    answer = _candidate_from_switches(switches)
+    # Completing the antipodal partner of each fibre is one exact sign operation.
+    operations += n
+    return answer, operations
+
+
+def _reference_algorithm(inst):
+    """Projected adjacency power iteration; returns no planted information."""
+    start_time = time.perf_counter()
+    adjacency = _adjacency_lists(inst)
+    total = len(adjacency)
+    max_iterations = 260
+    operations = 0
+
+    # Multiple starts are a normal guard against an accidentally tiny projection.
+    for restart in range(3):
+        rng = random.Random(0x14092290 + 1009 * restart)
+        vector = [rng.uniform(-1.0, 1.0) for _ in range(total)]
+        mean = sum(vector) / total
+        vector = [x - mean for x in vector]
+        operations += 2 * total
+        stable = 0
+        previous = None
+        for _ in range(max_iterations):
+            nxt = [sum(vector[v] for v in nbrs) for nbrs in adjacency]
+            operations += sum(len(nbrs) for nbrs in adjacency)
+            mean = sum(nxt) / total
+            nxt = [x - mean for x in nxt]
+            operations += 2 * total
+            scale = max(abs(x) for x in nxt)
+            if scale == 0:
+                break
+            vector = [x / scale for x in nxt]
+            operations += total
+            candidate = [1 if x >= 0 else -1 for x in vector]
+            if candidate[0] == -1:
+                candidate = [-x for x in candidate]
+            if candidate == previous:
+                stable += 1
+            else:
+                stable = 0
+            previous = candidate
+            if stable >= 3 and _is_exact_witness(inst, candidate):
+                return candidate, time.perf_counter() - start_time, operations
+    return None, time.perf_counter() - start_time, operations
+
+
+def _attack_candidates(inst, rng):
+    n = inst["n"]
+    degree = inst["degree"]
+
+    # Per-fibre twist count: an outlier statistic analogous to degree sorting.
+    twist_degrees = []
+    for i in range(n):
+        twist_degrees.append(sum(_twist_between(inst, i, j)
+                                 for j in range(n) if j != i))
+    outlier_bits = [int(v > degree / 2) for v in twist_degrees]
+    anchor = outlier_bits[0]
+    outlier_bits = [b ^ anchor for b in outlier_bits]
+
+    # Greedy assumes every direct edge from fibre 0 is within-community.  Every
+    # generated instance has at least one negative offset, so this makes errors.
+    greedy_bits = [0] + [_twist_between(inst, 0, i) for i in range(1, n)]
+
+    alternating_bits = [i & 1 for i in range(n)]
+    random_tries = [random_candidate(inst, rng) for _ in range(256)]
+    return {
+        "outlier_twist_degree": [_candidate_from_switches(outlier_bits)],
+        "greedy_direct_anchor": [_candidate_from_switches(greedy_bits)],
+        "alternating_index_ansatz": [_candidate_from_switches(alternating_bits)],
+        "random_restart_256": random_tries,
+    }
+
+
+def _reorder_tables(inst, rng):
+    out = {k: v for k, v in inst.items() if k not in ("twist_tables", "answer")}
+    rows = [dict(row) for row in inst["twist_tables"]]
+    rng.shuffle(rows)
+    out["twist_tables"] = rows
+    out["answer"] = inst["answer"][:]
+    return out
+
+
+def _fibre_swapped(inst, rng):
+    n = inst["n"]
+    flips = [rng.randrange(2) for _ in range(n)]
+    out = {k: v for k, v in inst.items() if k not in ("twist_tables", "answer")}
+    rows = []
+    for row in inst["twist_tables"]:
+        g = int(row["offset"])
+        bits = "".join(str(int(ch) ^ flips[i] ^ flips[(i + g) % n])
+                       for i, ch in enumerate(row["twists"]))
+        rows.append({"offset": g, "twists": bits})
+    carried = []
+    for i in range(n):
+        old_pair = inst["answer"][2*i:2*i+2]
+        carried.extend(old_pair[::-1] if flips[i] else old_pair)
+    if carried[0] == -1:
+        carried = [-x for x in carried]
+    out["twist_tables"] = rows
+    out["answer"] = carried
+    return out
+
+
+def _base_affine(inst, rng):
+    n = inst["n"]
+    units = [a for a in range(1, n) if math.gcd(a, n) == 1]
+    a = rng.choice(units)
+    shift = rng.randrange(n)
+    ainv = pow(a, -1, n)
+    out = {k: v for k, v in inst.items() if k not in ("twist_tables", "answer")}
+    rows = []
+    for g in range(1, (n - 1) // 2 + 1):
+        bits = []
+        for new_i in range(n):
+            new_j = (new_i + g) % n
+            old_i = (ainv * (new_i - shift)) % n
+            old_j = (ainv * (new_j - shift)) % n
+            bits.append(str(_twist_between(inst, old_i, old_j)))
+        rows.append({"offset": g, "twists": "".join(bits)})
+    carried = [0] * (2 * n)
+    for old_i in range(n):
+        new_i = (a * old_i + shift) % n
+        carried[2*new_i:2*new_i+2] = inst["answer"][2*old_i:2*old_i+2]
+    if carried[0] == -1:
+        carried = [-x for x in carried]
+    out["twist_tables"] = rows
+    out["answer"] = carried
+    return out
+
+
+def _answer_token_measure(answer):
+    blob = json.dumps(answer, separators=(",", ":"))
+    return len(re.findall(r"-?\d+|[\[\],]", blob))
+
