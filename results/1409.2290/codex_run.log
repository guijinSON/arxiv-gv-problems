   306	
   307	def _is_exact_witness(inst, answer) -> bool:
   308	    if not isinstance(answer, list) or len(answer) != 2 * inst["n"]:
   309	        return False
   310	    if any(type(x) is not int or x not in (-1, 1) for x in answer):
   311	        return False
   312	    if answer[0] != 1:
   313	        return False
   314	    if any(answer[2*i] != -answer[2*i+1] for i in range(inst["n"])):
   315	        return False
   316	    lam = inst["eigenvalue"]
   317	    try:
   318	        adjacency = _adjacency_lists(inst)
   319	    except (KeyError, TypeError, ValueError):
   320	        return False
   321	    return all(sum(answer[v] for v in nbrs) == lam * answer[u]
   322	               for u, nbrs in enumerate(adjacency))
   323	
   324	
   325	def verify(inst, answer):
   326	    """Check the candidate from graph data only; never consult inst['answer']."""
   327	    if answer is None:
   328	        return False, "no answer was parsed"
   329	    if not isinstance(answer, list):
   330	        return False, "answer must be a JSON array"
   331	    expected = 2 * inst["n"]
   332	    if not answer:
   333	        return False, "answer is empty"
   334	    if len(answer) == expected - 1:
   335	        return False, "answer dropped one vertex entry"
   336	    if len(answer) == expected + 1:
   337	        return False, "answer contains a duplicate or extra entry"
   338	    if len(answer) != expected:
   339	        return False, f"answer length must be exactly {expected}"
   340	    if any(type(x) is not int or x not in (-1, 1) for x in answer):
   341	        return False, "every entry must be the integer +1 or -1"
   342	    if answer[0] != 1:
   343	        return False, "global sign is not normalized: x_(0,0) must be +1"
   344	    if any(answer[2*i] != -answer[2*i+1] for i in range(inst["n"])):
   345	        return False, "the two entries in each fibre must be opposites"
   346	    try:
   347	        adjacency = _adjacency_lists(inst)
   348	    except (KeyError, TypeError, ValueError) as exc:
   349	        return False, f"instance graph is malformed: {exc}"
   350	    lam = inst["eigenvalue"]
   351	    for u, nbrs in enumerate(adjacency):
   352	        if sum(answer[v] for v in nbrs) != lam * answer[u]:
   353	            return False, f"adjacency eigenvector equation fails at vertex {u}"
   354	    return True, "ok"
   355	
