   447	def _reference_algorithm(inst):
   448	    """Projected adjacency power iteration; returns no planted information."""
   449	    start_time = time.perf_counter()
   450	    adjacency = _adjacency_lists(inst)
   451	    total = len(adjacency)
   452	    max_iterations = 260
   453	    operations = 0
   454	
   455	    # Multiple starts are a normal guard against an accidentally tiny projection.
   456	    for restart in range(3):
   457	        rng = random.Random(0x14092290 + 1009 * restart)
   458	        vector = [rng.uniform(-1.0, 1.0) for _ in range(total)]
   459	        mean = sum(vector) / total
   460	        vector = [x - mean for x in vector]
   461	        operations += 2 * total
   462	        stable = 0
   463	        previous = None
   464	        for _ in range(max_iterations):
   465	            nxt = [sum(vector[v] for v in nbrs) for nbrs in adjacency]
   466	            operations += sum(len(nbrs) for nbrs in adjacency)
   467	            mean = sum(nxt) / total
   468	            nxt = [x - mean for x in nxt]
   469	            operations += 2 * total
   470	            scale = max(abs(x) for x in nxt)
   471	            if scale == 0:
   472	                break
   473	            vector = [x / scale for x in nxt]
   474	            operations += total
   475	            candidate = [1 if x >= 0 else -1 for x in vector]
   476	            if candidate[0] == -1:
   477	                candidate = [-x for x in candidate]
   478	            if candidate == previous:
   479	                stable += 1
   480	            else:
   481	                stable = 0
   482	            previous = candidate
   483	            if stable >= 3 and _is_exact_witness(inst, candidate):
   484	                return candidate, time.perf_counter() - start_time, operations
   485	    return None, time.perf_counter() - start_time, operations
