   397	def escalate(params):
   398	    current = {k: v for k, v in params.items() if not k.startswith("_")}
   399	    n = int(current.get("n", 71))
   400	    t = int(current.get("negative_offsets", max(1, (n - 3) // 8)))
   401	    max_t = max(1, (n - 3) // 8)
   402	    if t < max_t:
   403	        current["negative_offsets"] = t + 1
   404	        return current
   405	    # At fixed answer length, the negative-offset density is now at the largest
   406	    # value for which the elementary spectral-gap proof applies.  Only then grow
   407	    # the witness.  n=101 exactly reaches the 300-operation compact-route cap.
   408	    if n < 101:
   409	        new_n = min(101, n + 12)
   410	        if new_n % 2 == 0:
   411	            new_n += 1
   412	        current["n"] = new_n
   413	        current["negative_offsets"] = max(1, (new_n - 3) // 8)
   414	        return current
   415	    return "cap_bound"
