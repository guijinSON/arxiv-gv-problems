   537	def _base_affine(inst, rng):
   538	    n = inst["n"]
   539	    units = [a for a in range(1, n) if math.gcd(a, n) == 1]
   540	    a = rng.choice(units)
   541	    shift = rng.randrange(n)
   542	    ainv = pow(a, -1, n)
   543	    out = {k: v for k, v in inst.items() if k not in ("twist_tables", "answer")}
   544	    rows = []
   545	    for g in range(1, (n - 1) // 2 + 1):
   546	        bits = []
   547	        for new_i in range(n):
   548	            new_j = (new_i + g) % n
   549	            old_i = (ainv * (new_i - shift)) % n
   550	            old_j = (ainv * (new_j - shift)) % n
   551	            bits.append(str(_twist_between(inst, old_i, old_j)))
   552	        rows.append({"offset": g, "twists": "".join(bits)})
   553	    carried = [0] * (2 * n)
   554	    for old_i in range(n):
   555	        new_i = (a * old_i + shift) % n
   556	        carried[2*new_i:2*new_i+2] = inst["answer"][2*old_i:2*old_i+2]
   557	    if carried[0] == -1:
   558	        carried = [-x for x in carried]
   559	    out["twist_tables"] = rows
   560	    out["answer"] = carried
   561	    return out
