   362	def verify(inst, answer):
   363	    """Check the candidate from graph data only; never consult inst['answer']."""
   364	    if answer is None:
   365	        return False, "no answer was parsed"
   366	    if not isinstance(answer, list):
   367	        return False, "answer must be a JSON array"
   368	    expected = inst["n"]
   369	    if not answer:
   370	        return False, "answer is empty"
   371	    if len(answer) == expected - 1:
   372	        return False, "answer dropped one vertex entry"
   373	    if len(answer) == expected + 1:
   374	        return False, "answer contains a duplicate or extra entry"
   375	    if len(answer) != expected:
   376	        return False, f"answer length must be exactly {expected}"
   377	    if any(type(x) is not int or x not in (0, 1) for x in answer):
   378	        return False, "every entry must be the integer bit 0 or 1"
   379	    if answer[0] != 0:
   380	        return False, "global community swap is not normalized: c_0 must be 0"
   381	    try:
   382	        adjacency = _adjacency_lists(inst)
   383	    except (KeyError, TypeError, ValueError) as exc:
   384	        return False, f"instance graph is malformed: {exc}"
   385	    lam = inst["eigenvalue"]
   386	    vector = _expanded_vector(answer)
   387	    for u, nbrs in enumerate(adjacency):
   388	        if sum(vector[v] for v in nbrs) != lam * vector[u]:
   389	            return False, f"adjacency eigenvector equation fails at vertex {u}"
   390	    return True, "ok"
