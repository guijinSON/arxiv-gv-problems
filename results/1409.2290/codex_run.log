/bin/bash -lc "python3 - <<'PY'
import contextlib, importlib.util, io, json, os
buf=io.StringIO()
with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
    s=importlib.util.spec_from_file_location('g','gen_1409_2290.py')
    g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
assert buf.getvalue()==''
assert g.TRACK=='B'
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.SHIPPING_DIFFICULTY=='hard'
verified=0
for params in g.DIFFICULTY.values():
    for seed in (0,1,7):
        verified += g.verify(g.make_instance(seed=seed,**params),g.make_instance(seed=seed,**params)['answer'])[0]
assert verified==12
p=dict(g.DIFFICULTY['hard'])
p1=g.escalate(p); p2=g.escalate(p1); p3=g.escalate(p2)
assert p1=={'n':73,'negative_offsets':8}
assert p2=={'n':75,'negative_offsets':9}
assert p3=='cap_bound'
assert g._compact_certificate(g.make_instance(seed=2,**p2))[1]==297
rep=json.load(open('selftest_report.json'))
assert rep['all_passed'] and rep['G5_density_and_baseline']['baseline_wall_clock_sec']==0.028276
