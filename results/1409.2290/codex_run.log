   418	def _compact_certificate(inst):
   419	    """Recover by the intended odd-cycle invariant, without planted data."""
   420	    n = inst["n"]
   421	    row = _tables_by_offset(inst)[1]
   422	    template_twist = 0
   423	    operations = 0
   424	    for ch in row:
   425	        template_twist ^= int(ch)
   426	        operations += 1
   427	    # The first XOR into zero is bookkeeping, not an arithmetic operation.
   428	    operations -= 1
   429	    switches = [0] * n
   430	    for i in range(n - 1):
   431	        switches[i + 1] = switches[i] ^ int(row[i]) ^ template_twist
   432	        operations += 2
   433	    answer = _candidate_from_switches(switches)
   434	    # Completing the antipodal partner of each fibre is one exact sign operation.
   435	    operations += n
   436	    return answer, operations
   437	
   438	
   439	def _reference_algorithm(inst):
   440	    """Projected adjacency power iteration; returns no planted information."""
   441	    start_time = time.perf_counter()
   442	    adjacency = _adjacency_lists(inst)
   443	    total = len(adjacency)
   444	    max_iterations = 260
   445	    operations = 0
   446	
   447	    # Multiple starts are a normal guard against an accidentally tiny projection.
   448	    for restart in range(3):
   449	        rng = random.Random(0x14092290 + 1009 * restart)
   450	        vector = [rng.uniform(-1.0, 1.0) for _ in range(total)]
   451	        mean = sum(vector) / total
   452	        vector = [x - mean for x in vector]
   453	        operations += 2 * total
   454	        stable = 0
   455	        previous = None
   456	        for _ in range(max_iterations):
   457	            nxt = [sum(vector[v] for v in nbrs) for nbrs in adjacency]
   458	            operations += sum(len(nbrs) for nbrs in adjacency)
   459	            mean = sum(nxt) / total
   460	            nxt = [x - mean for x in nxt]
   461	            operations += 2 * total
   462	            scale = max(abs(x) for x in nxt)
   463	            if scale == 0:
   464	                break
   465	            vector = [x / scale for x in nxt]
   466	            operations += total
   467	            candidate = [1 if x >= 0 else -1 for x in vector]
   468	            if candidate[0] == -1:
   469	                candidate = [-x for x in candidate]
   470	            if candidate == previous:
   471	                stable += 1
   472	            else:
   473	                stable = 0
   474	            previous = candidate
   475	            if stable >= 3 and _is_exact_witness(inst, candidate):
   476	                return candidate, time.perf_counter() - start_time, operations
   477	    return None, time.perf_counter() - start_time, operations
   478	
