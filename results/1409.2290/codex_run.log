   251	def render(inst) -> str:
   252	    n = inst["n"]
   253	    lines = [
   254	        "Exact two-community certificate in a cyclic two-lift",
   255	        "",
   256	        f"There are {2*n} vertices (i,b), where i is modulo n={n} and b is 0 or 1.",
   257	        "The output order is (0,0),(0,1),(1,0),(1,1), and so on.",
   258	        "The graph is specified by the twist rows below.  In a row g: t_0...t_{n-1},",
   259	        "bit t_i creates the two undirected edges",
   260	        "  {(i,0),((i+g) mod n,t_i)} and {(i,1),((i+g) mod n,1 XOR t_i)}.",
   261	        "All listed offsets together cover every base pair exactly once; there are no other edges.",
   262	        f"The graph is regular of degree {inst['degree']}.",
   263	        "",
   264	        "Find a vector x with one integer entry per vertex, in the order above, such that:",
   265	        "  (1) every entry is +1 or -1;",
   266	        "  (2) x_(i,1) = -x_(i,0) for every i;",
   267	        "  (3) x_(0,0) = +1 (this fixes the global sign); and",
   268	        f"  (4) for every vertex u, sum_{{v adjacent to u}} x_v = {inst['eigenvalue']} x_u.",
   269	        "The two signs are the two communities.  Equality and all sums are exact over the integers.",
   270	        "",
   271	        "Twist rows (the left integer is g and the bitstring is t_0 through t_{n-1}):",
   272	    ]
   273	    for row in inst["twist_tables"]:
   274	        lines.append(f"  {row['offset']}: {row['twists']}")
   275	    lines.extend([
   276	        "",
   277	        "Give your final answer inside <answer></answer> tags as one JSON array of",
   278	        f"exactly {2*n} integers in the stated vertex order.",
   279	        "Example format: <answer>[1,-1,-1,1]</answer>",
   280	        "Output nothing else inside the tags.",
   281	    ])
   282	    mode = os.environ.get("GV_HINT_MODE")
   283	    if mode == "structural":
   284	        lines.extend(("", "Hint: " + STRUCTURAL_HINT))
   285	    elif mode == "placebo":
   286	        lines.extend(("", "Hint: " + PLACEBO_HINT))
   287	    return "\n".join(lines)
