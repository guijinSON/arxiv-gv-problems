   345	def _is_exact_witness(inst, answer) -> bool:
   346	    if not isinstance(answer, list) or len(answer) != inst["n"]:
   347	        return False
   348	    if any(type(x) is not int or x not in (0, 1) for x in answer):
   349	        return False
   350	    if answer[0] != 0:
   351	        return False
   352	    vector = _expanded_vector(answer)
   353	    lam = inst["eigenvalue"]
   354	    try:
   355	        adjacency = _adjacency_lists(inst)
   356	    except (KeyError, TypeError, ValueError):
   357	        return False
   358	    return all(sum(vector[v] for v in nbrs) == lam * vector[u]
   359	               for u, nbrs in enumerate(adjacency))
