+STRUCTURAL_HINT = (
+    "For any fixed offset, switching signs cancel in the parity around its odd cyclic lift."
+)
+PLACEBO_HINT = (
+    "Careful attention to the vertex order helps avoid sign and indexing mistakes here."
+)
