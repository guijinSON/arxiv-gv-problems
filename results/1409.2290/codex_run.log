def gen(r,t,seed):
 rng=random.Random(seed); H=set(rng.sample(range(1,(r-1)//2+1),t)); s=[0]+[rng.randrange(2) for _ in range(r-1)]
 tabs=[]
 for g in range(1,(r-1)//2+1):
  neg=int(g in H)
  tabs.append((g,[neg"'^s[i]''^s[(i+g)%r] for i in range(r)]))
 return tabs

def adj(r,tabs):
 n=2*r; a=[0]*n
 for g,bits in tabs:
  for i,tw in enumerate(bits):
   j=(i+g)%r
   for b in range(2):
    u=2*i+b; v=2*j+(b''^tw)
    a[u]|=1<<v;a[v]|=1<<u
 return a

def inv(r,tabs):
