+    # breaks at least one antipodal fibre without changing the length/alphabet.
+    pair = next((i, j) for i in range(2, len(ans)) for j in range(i + 1, len(ans))
+                if i // 2 != j // 2 and ans[i] != ans[j])
+    swapped[pair[0]], swapped[pair[1]] = swapped[pair[1]], swapped[pair[0]]
+    out_of_range = ans[:]
+    out_of_range[2] = 2
+    corruptions = {
+        "drop": ans[:-1],
+        "swap": swapped,
+        "duplicate": ans + [ans[-1]],
+        "empty": [],
+        "out_of_range": out_of_range,
