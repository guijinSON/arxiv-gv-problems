   516	def _fibre_swapped(inst, rng):
   517	    n = inst["n"]
   518	    flips = [rng.randrange(2) for _ in range(n)]
   519	    out = {k: v for k, v in inst.items() if k not in ("twist_tables", "answer")}
   520	    rows = []
   521	    for row in inst["twist_tables"]:
   522	        g = int(row["offset"])
   523	        bits = "".join(str(int(ch) ^ flips[i] ^ flips[(i + g) % n])
   524	                       for i, ch in enumerate(row["twists"]))
   525	        rows.append({"offset": g, "twists": bits})
   526	    carried = []
   527	    for i in range(n):
   528	        old_pair = inst["answer"][2*i:2*i+2]
   529	        carried.extend(old_pair[::-1] if flips[i] else old_pair)
   530	    if carried[0] == -1:
   531	        carried = [-x for x in carried]
   532	    out["twist_tables"] = rows
   533	    out["answer"] = carried
   534	    return out
