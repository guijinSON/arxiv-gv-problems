   379	def canonical_key(inst):
   380	    """A graph-isomorphism invariant, never a seed or rendered-text hash.
   381	
   382	    Full graph canonization is not attempted.  The multiset of degrees and the
   383	    multiset of common-neighbor counts for every vertex pair are invariant under
   384	    arbitrary vertex renumbering and distinguish all audited shipping seeds.
   385	    """
   386	    masks = _adjacency_masks(inst)
   387	    degrees = sorted(mask.bit_count() for mask in masks)
   388	    common = sorted(
   389	        (masks[i] & masks[j]).bit_count()
   390	        for i in range(len(masks)) for j in range(i + 1, len(masks))
   391	    )
   392	    structural = [len(masks), degrees, common]
   393	    blob = json.dumps(structural, separators=(",", ":"), sort_keys=True)
   394	    return hashlib.sha256(blob.encode("ascii")).hexdigest()
   395	
