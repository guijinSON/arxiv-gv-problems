+    "medium": {"n": 252, "regular_degree": 9, "switch_rounds": 75},
+    "hard": {"n": 252, "regular_degree": 9, "switch_rounds": 100},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+STRUCTURAL_HINT: str = (
+    "Each five-vertex gadget contains two overlapping four-vertex "
