+)
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A word of exactly n symbols from {1,2,3,4}, in port-index order, "
+        "with symbol 0 fixed to 1 and the stated anchor-neighbour symbol "
+        "fixed to 2."
