+def _validate_params(n: int, regular_degree: int, switch_rounds: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 8 or n % 4:
+        raise ValueError("n must be an integer multiple of 4 and at least 8")
