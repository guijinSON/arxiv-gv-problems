+def _undirected_adjacency(n: int, arcs: list[list[int]]) -> list[set[int]]:
+    adjacency = [set() for _ in range(n)]
+    for u, v in arcs:
+        adjacency[u].add(v)
+        adjacency[v].add(u)
+    return adjacency
