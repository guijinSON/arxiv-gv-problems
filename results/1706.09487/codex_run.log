+    }
+
+    demo_inst = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo_inst)
+
+    attack_names = None
+    attack_successes = {}
+    attack_attempts = {}
+    attack_candidate_count = 0
+    attack_started = time.perf_counter()
+    for seed in range(_ATTACK_SEEDS):
