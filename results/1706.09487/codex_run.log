+            for name, (ok, why) in corruption_results.items()
+        },
+    }
+
+    wire = json.dumps(answer, separators=(",", ":"))
+    parsed = parse_answer(
+        "The retained component meets the strict degree bound.\n```json\n"
+        + "<answer>\n"
+        + wire
+        + "\n</answer>\n```\n"
