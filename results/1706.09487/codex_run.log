+
+    g8_failures = []
+    invariance_checks = 0
+    carried_checks = 0
+    unrelated_keys = []
+    distinct_primes = []
+    for seed in range(20):
+        base = make_instance(seed=seed, **shipping)
+        base_key = canonical_key(base)
+        unrelated_keys.append(base_key)
+        distinct_primes.append(base["p"])
