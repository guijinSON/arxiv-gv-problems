+    total_edges = fibre_count * s * (s - 1) // 2
+    deleted_edges = total_edges - internal_edges
+    if deleted_edges > inst["edge_budget"]:
+        return False, f"compressed deletion set has {deleted_edges} edges, exceeding k"
+    return True, "ok"
