+        "elapsed_sec": guess_elapsed,
+    }
+
+    demo_inst = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo_inst)
+
+    attack_names = None
+    attack_successes = {}
+    attack_attempts = {}
+    attack_candidate_count = 0
