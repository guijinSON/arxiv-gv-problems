+# These are diagnostics, not local gates.  They are replaced after the three
+# script-owned oracle runs; zero attempts means simply "not run yet".
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
