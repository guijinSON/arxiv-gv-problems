+            invariance_checks += 1
+            if canonical_key(variant) != base_key:
+                g8_failures.append([seed, "canonical key changed"])
+            carried_checks += 1
+            if not verify(variant, carried)[0]:
+                g8_failures.append([seed, "carried witness failed"])
