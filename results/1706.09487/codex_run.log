+def _affine_variant(inst, rng):
+    p = inst["p"]
+    multiplier = rng.randrange(1, p)
+    new_shift = rng.randrange(p)
+
+    def carry(value):
+        return (
+            new_shift + multiplier * (value - inst["shift"])
+        ) % p
