+    }
+
+    scale_inst = make_instance(seed=23, **shipping)
+    doubled_params = dict(shipping)
+    doubled_params["n"] *= 2
+    doubled_params["spread"] *= 2
+    doubled = make_instance(seed=23, **doubled_params)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
