+        "vertices": inst["p"] - 1,
+        "component_count": (inst["p"] - 1) // inst["s"],
+        "component_type": ["complete", inst["s"]],
+        "marked_seed_orbit": "unique",
+        "addition_count": inst["additional_vertices"],
+        "edge_budget": inst["edge_budget"],
+    }
