+    candidates = {
+        "outlier_equal_degree_small_label": [_fill_candidate(inst, smallest)],
+        "greedy_nearest_seed_labels": [_fill_candidate(inst, nearest)],
+        "by_hand_additive_quotient_step": [_fill_candidate(inst, additive)],
