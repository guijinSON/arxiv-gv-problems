+            "solves": f"{reference_successes}/8, as expected on Track B",
+            "paper_generic_bound": (
+                "Theorem 4: 2^{O(sqrt(k) log k)} for Seeded Highly "
+                "Connected Edge Deletion after Theorem 5's kernel"
+            ),
+        },
+    }
+
+    scale_inst = make_instance(seed=23, **shipping)
