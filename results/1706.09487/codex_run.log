+        "attacks": attacks_report,
+        "reference_algorithm": {
+            "name": "exhaustive exact power-residue component scan",
+            "complexity": "O(p log s) exact modular operations",
+            "wall_clock_sec_mean": reference_mean_time,
+            "operations_mean": reference_mean_ops,
