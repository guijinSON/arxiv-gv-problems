+        "shipping_vertices": scale_inst["vertex_count"],
+        "doubled_n": doubled_params["n"],
+        "doubled_vertices": doubled["vertex_count"],
+        "answer_elements_both": len(doubled["answer"]),
+        "doubled_verification": doubled_why,
+    }
+
+    g8_failures = []
+    invariance_checks = 0
+    carried_checks = 0
+    unrelated_keys = []
+    distinct_primes = []
+    for seed in range(20):
