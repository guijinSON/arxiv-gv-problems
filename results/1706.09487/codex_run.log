+
+    guess_total = _G4_SAMPLES
+    guess_hits = 0
+    guess_rng = random.Random(0x170609487)
+    guess_inst = make_instance(seed=314_159, **shipping)
+    guess_started = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(
