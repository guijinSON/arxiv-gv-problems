+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "finite undirected graph specified by an exact adjacency rule",
+        "seeded vertex set",
+        "highly connected induced component",
+        "compressed edge-deletion set",
+    ],
+    "verification_operations": [
