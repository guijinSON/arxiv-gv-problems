+def _coverage_masks(inst: dict) -> list[int]:
+    adjacency = _adjacency(inst)
+    masks: list[int] = []
+    for source in range(inst["n"]):
+        seen = {source}
+        frontier = [source]
+        for _ in range(inst["r"]):
+            next_frontier = []
+            for vertex in frontier:
+                for neighbor in adjacency[vertex]:
+                    if neighbor not in seen:
+                        seen.add(neighbor)
