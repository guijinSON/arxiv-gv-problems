+def _rooted_tree_code(adjacency: list[list[int]], root: int, blocked: int = -1) -> str:
+    parent = {root: blocked}
+    order = [root]
+    for vertex in order:
+        for neighbor in adjacency[vertex]:
+            if neighbor != parent[vertex]:
+                parent[neighbor] = vertex
+                order.append(neighbor)
