+        layer = len(leaves)
+        remaining -= layer
+        for _ in range(layer):
+            leaf = leaves.popleft()
+            for neighbor in adjacency[leaf]:
+                degree[neighbor] -= 1
+                if degree[neighbor] == 1:
+                    leaves.append(neighbor)
+    return sorted(leaves)
+
