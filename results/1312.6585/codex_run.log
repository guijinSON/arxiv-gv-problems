+"""Generator/verifier for a Track-B r-Dominating Set family.
+
+The native problem is Definition/Section 4 of arXiv:1312.6585.  Instances are
+outerplanar unicyclic graphs: every cycle vertex has one or more private leaves.
+The cycle is labelled by one orbit of a fractional-linear transformation over a
+prime field.  The planted certificate is obtained by composition of that orbit,
+never by solving the generated graph.
+"""
+
+from __future__ import annotations
+
+import ast
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import Counter, deque
+from functools import lru_cache
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "K4-minor-free unicyclic graph",
+        "graph-distance radius",
+        "vertex subset",
+    ],
+    "verification_operations": [
+        "integer cardinality and distinctness checks",
+        "multi-source breadth-first search",
+        "exact graph-distance comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "The labelled cycle is one orbit of a fractional-linear map over a prime "
+        "field; recognizing that map permits a matrix-power jump, whereas the "
+        "mechanical method must peel and traverse the displayed graph."
+    ),
+    "hardness_basis": (
+        "Track B: Section 4.1's dynamic-programming viewpoint applies, but this "
+        "unicyclic subclass also has an O(|V|+|E|) leaf-peeling/cycle-traversal "
+        "algorithm; at the hard preset it averaged 11,795 instrumented "
+        "adjacency/queue steps (0.119 s over eight runs here), while the fractional-linear "
+        "shortcut uses at most 290 exact arithmetic operations."
+    ),
+    "max_answer_tokens": 11,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON array of exactly k distinct cycle-vertex labels.  This is the "
+        "canonicalized representative language: any at-most-k dominating set can "
+        "replace a pendant leaf by its cycle parent and can be padded on the cycle."
+    ),
+    "bounds": {
+        "length": "instance k (4 in demo, 10 otherwise; always <=256)",
+        "entry_min": 0,
+        "entry_max": "p, where the cycle labels are 0,...,p",
+        "distinct": True,
+        "order": "ignored by verify; emitted candidates are sorted",
+    },
+}
+
+DIFFICULTY = {
+    "demo": {"n": 2, "k": 4, "leaf_crowding": 1},
+    "easy": {"n": 3, "k": 10, "leaf_crowding": 1},
+    "medium": {"n": 10, "k": 10, "leaf_crowding": 2},
+    "hard": {"n": 24, "k": 10, "leaf_crowding": 3},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "On the cycle core, each label's two neighbors are its images under one "
+    "fractional-linear map over the prime field and that map's inverse."
+)
+PLACEBO_HINT = (
+    "This problem rewards careful bookkeeping because both the vertex labels "
+    "and the ordering of the supplied data are easy to misread."
+)
+
+# Filled from the separately owned harden.py runs after the three arms complete.
+G9_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
+}
+
+NOTES = """\
+Paper reading.  Section 4 fixes the exact witness: S is a vertex subset of size at
+most k and every vertex outside S must have graph distance at most r from S.
+Lemma 5 is the executable certifying-language statement, and Theorem 3 gives the
+constructive linear kernel on H-minor-free graphs for fixed apex H.  Proposition 3
+and Theorem 3 are preprocessing results, not algorithms that output a dominating
+set.  Section 4.1 nevertheless makes the easy bounded-treewidth regime explicit
+through its (2r+1)^t table, and the generated graphs have treewidth two.  Therefore
+this is Track B, not a Track-A hardness claim.
+
+Construction.  A full projective-line orbit over F_p supplies a cycle of length
+k(2r-1).  One to 1+leaf_crowding private leaves are attached independently to
+every cycle vertex.  Taking every (2r-1)-st orbit point r-dominates the graph.  The
+private leaves also prove that k is minimum: for k cycle choices the cyclic gaps
+must all be at most 2r-1, and their sum is k(2r-1), so every gap is exact.
+
+Attacks.  Optional leaves are sampled independently of the planted phase, so the
+degree/outlier rule sees the same distribution at planted and non-planted cycle
+vertices.  Iterative maximum-coverage greedy, 256 structure-aware random restarts,
+and affine progressions in the numeric labels are all tested over eight seeds.
+The successful linear-time reference algorithm is disclosed separately, as Track B
+requires: peel degree-one vertices, traverse the residual cycle, and take every
+(2r-1)-st vertex.
+"""
+
+
+def _is_prime(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+@lru_cache(maxsize=None)
+def _choose_radius(target: int, k: int) -> tuple[int, int]:
+    """Return r>=target and prime p=k(2r-1)-1."""
+    radius = max(2, int(target))
+    while True:
+        prime = k * (2 * radius - 1) - 1
+        if _is_prime(prime):
+            return radius, prime
+        radius += 1
+
+
+def _mat_mul(left, right, p):
+    return (
+        (
+            (left[0][0] * right[0][0] + left[0][1] * right[1][0]) % p,
+            (left[0][0] * right[0][1] + left[0][1] * right[1][1]) % p,
+        ),
+        (
+            (left[1][0] * right[0][0] + left[1][1] * right[1][0]) % p,
+            (left[1][0] * right[0][1] + left[1][1] * right[1][1]) % p,
+        ),
+    )
+
+
+def _mat_inverse(matrix, p):
+    a, b = matrix[0]
+    c, d = matrix[1]
+    inv_det = pow((a * d - b * c) % p, -1, p)
+    return (
+        ((d * inv_det) % p, (-b * inv_det) % p),
+        ((-c * inv_det) % p, (a * inv_det) % p),
+    )
+
+
+def _mat_pow(matrix, exponent, p):
+    result = ((1, 0), (0, 1))
+    base = matrix
+    while exponent:
+        if exponent & 1:
+            result = _mat_mul(result, base, p)
+        exponent //= 2
+        if exponent:
+            base = _mat_mul(base, base, p)
+    return result
+
+
+def _mobius(matrix, x, p):
+    """Act on P^1(F_p), representing infinity by the integer p."""
+    a, b = matrix[0]
+    c, d = matrix[1]
+    if x == p:
+        return p if c == 0 else (a * pow(c, -1, p)) % p
+    numerator = (a * x + b) % p
+    denominator = (c * x + d) % p
+    return p if denominator == 0 else (numerator * pow(denominator, -1, p)) % p
+
+
+def _orbit(matrix, p):
+    result = []
+    seen = set()
+    value = p
+    while value not in seen:
+        seen.add(value)
+        result.append(value)
+        value = _mobius(matrix, value, p)
+    return result, value
+
+
+@lru_cache(maxsize=None)
+def _base_full_cycle(p):
+    nonsquare = next(
+        q for q in range(2, p) if pow(q, (p - 1) // 2, p) == p - 1
+    )
+    for trace in range(p):
+        matrix = ((0, (-nonsquare) % p), (1, trace))
+        orbit, end = _orbit(matrix, p)
+        if end == p and len(orbit) == p + 1:
+            return matrix
+    raise RuntimeError("could not construct a full projective-line cycle")
+
+
+def _random_conjugate(base, p, rng):
+    while True:
+        change = (
+            (rng.randrange(p), rng.randrange(p)),
+            (rng.randrange(p), rng.randrange(p)),
+        )
+        if (change[0][0] * change[1][1] - change[0][1] * change[1][0]) % p:
+            break
+    return _mat_mul(_mat_mul(change, base, p), _mat_inverse(change, p), p)
+
+
+def make_instance(n, seed=0, **params):
+    """Construct a certified r-dominating instance by orbit composition.
+
+    Here n is a target radius.  Increasing it increases the cycle and the amount
+    of displayed graph data while k, and hence answer length, stays fixed.
+    """
+    k = int(params.get("k", 16))
+    crowding = int(params.get("leaf_crowding", 1))
+    if k < 2 or k > 256 or k % 2:
+        raise ValueError("k must be an even integer in [2,256]")
+    if int(n) < 2:
+        raise ValueError("n must be at least 2")
+    if crowding < 1 or crowding > 8:
+        raise ValueError("leaf_crowding must be in [1,8]")
+
+    rng = random.Random(seed)
+    radius, prime = _choose_radius(int(n), k)
+    cycle_size = prime + 1
+    stride = 2 * radius - 1
+    assert cycle_size == k * stride
+
+    transformation = _random_conjugate(_base_full_cycle(prime), prime, rng)
+    cycle_order, end = _orbit(transformation, prime)
+    if end != prime or len(cycle_order) != cycle_size:
+        raise AssertionError("conjugation did not preserve the full orbit")
+
+    core_neighbors = [set() for _ in range(cycle_size)]
+    edges = []
+    for index, vertex in enumerate(cycle_order):
+        other = cycle_order[(index + 1) % cycle_size]
+        edge = (min(vertex, other), max(vertex, other))
+        edges.append(edge)
+        core_neighbors[vertex].add(other)
+        core_neighbors[other].add(vertex)
+
+    leaf_counts = [1 + rng.randrange(crowding + 1) for _ in range(cycle_size)]
+    next_leaf = cycle_size
+    for parent, count in enumerate(leaf_counts):
+        for _ in range(count):
+            edges.append((parent, next_leaf))
+            next_leaf += 1
+
+    rng.shuffle(edges)
+    offset = rng.randrange(stride)
+    answer = sorted(cycle_order[(offset + j * stride) % cycle_size] for j in range(k))
+
+    return {
+        "family": "r-dominating-set",
+        "n_vertices": next_leaf,
+        "r": radius,
+        "k": k,
+        "field_prime": prime,
+        "cycle_neighbors": [sorted(pair) for pair in core_neighbors],
+        "leaf_counts": leaf_counts,
+        "leaf_crowding": crowding,
+        "edges": [list(edge) for edge in edges],
+        "answer": answer,
+    }
+
+
+def _adjacency(inst):
+    n_vertices = inst.get("n_vertices")
+    if not isinstance(n_vertices, int) or n_vertices < 1:
+        return None
+    adjacency = [set() for _ in range(n_vertices)]
+    for edge in inst.get("edges", []):
+        if (
+            not isinstance(edge, (list, tuple))
+            or len(edge) != 2
+            or not all(isinstance(x, int) and not isinstance(x, bool) for x in edge)
+        ):
+            return None
+        u, v = edge
+        if not (0 <= u < n_vertices and 0 <= v < n_vertices) or u == v:
+            return None
+        adjacency[u].add(v)
+        adjacency[v].add(u)
+    return adjacency
+
+
+def render(inst):
+    prime = inst["field_prime"]
+    neighbors = "\n".join(
+        f"{vertex}: {pair[0]} {pair[1]}"
+        for vertex, pair in enumerate(inst["cycle_neighbors"])
+    )
+    counts = " ".join(str(value) for value in inst["leaf_counts"])
+    statement = f"""Find an r-dominating set in the following finite undirected graph.
+
+A set S of vertices is r-dominating if every vertex not in S has a path of at
+most r edges to some vertex in S.  Paths and distances are in the undirected
+graph.  Vertex labels are 0-based integers, and a path of zero edges is allowed
+from a chosen vertex to itself.
+
+Instance parameters:
+  number of vertices N = {inst['n_vertices']}
+  distance radius r = {inst['r']}
+  maximum permitted size k = {inst['k']}
+
+The graph is specified exactly as follows.  The cycle vertices are 0,...,{prime};
+{prime} is also a prime modulus used only in their labels.  The table below gives
+the two unordered cycle-neighbors of every cycle vertex; thus every cycle edge
+appears twice in the table.
+
+{neighbors}
+
+Every cycle vertex also has private pendant leaves (degree-one neighbors).  In
+increasing order of their parent 0,...,{prime}, the leaf counts are:
+{counts}
+
+The leaves are labelled consecutively from {prime + 1}: first all leaves of parent
+0, then all leaves of parent 1, and so on.  There are no other edges.  This rule
+and the cycle-neighbor table define all vertices 0,...,{inst['n_vertices'] - 1}.
+
+Return any set S of at most {inst['k']} distinct vertex labels that r-dominates the
+whole graph.  Order does not matter.  Use a JSON array of decimal integers with no
+repetitions.
+
+Give your final answer inside <answer></answer> tags, as a JSON integer array.
+Example: <answer>[0, 3, 7]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    bodies = tagged[-1:] if tagged else []
+    if not bodies:
+        fenced = re.findall(r"```(?:json)?\s*(.*?)```", text, flags=re.I | re.S)
+        bodies.extend(fenced[-1:])
+    if not bodies:
+        bracketed = re.findall(r"\[[^\[\]]*\]", text, flags=re.S)
+        bodies.extend(bracketed[-1:])
+    for body in bodies:
+        body = body.strip()
+        values = None
+        for loader in (json.loads, ast.literal_eval):
+            try:
+                values = loader(body)
+                break
+            except (ValueError, SyntaxError, TypeError, json.JSONDecodeError):
+                continue
+        if values is None and re.fullmatch(r"\s*-?\d+(?:\s*,\s*-?\d+)*\s*", body):
+            values = [int(piece.strip()) for piece in body.split(",")]
+        if (
+            isinstance(values, list)
+            and all(isinstance(x, int) and not isinstance(x, bool) for x in values)
+        ):
+            return values
+    return None
+
+
+def verify(inst, answer):
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if not answer:
+        return False, "answer is empty"
+    if any(not isinstance(x, int) or isinstance(x, bool) for x in answer):
+        return False, "every vertex label must be an integer"
+    if len(answer) != len(set(answer)):
+        return False, "vertex labels must be distinct"
+    if len(answer) > inst.get("k", -1):
+        return False, f"answer has {len(answer)} vertices, exceeding k={inst.get('k')}"
+    n_vertices = inst.get("n_vertices", 0)
+    bad = next((x for x in answer if not 0 <= x < n_vertices), None)
+    if bad is not None:
+        return False, f"vertex label {bad} is outside 0,...,{n_vertices - 1}"
+    adjacency = _adjacency(inst)
+    if adjacency is None:
+        return False, "instance graph is malformed"
+
+    distance = [-1] * n_vertices
+    queue = deque()
+    for vertex in answer:
+        distance[vertex] = 0
+        queue.append(vertex)
+    radius = inst.get("r", -1)
+    while queue:
+        vertex = queue.popleft()
+        if distance[vertex] == radius:
+            continue
+        for other in adjacency[vertex]:
+            if distance[other] == -1:
+                distance[other] = distance[vertex] + 1
+                queue.append(other)
+    undominated = next((v for v, d in enumerate(distance) if d == -1), None)
+    if undominated is not None:
+        return False, f"vertex {undominated} is farther than r={radius} from the set"
+    return True, "ok"
+
+
+def _two_core(adjacency, with_operations=False):
+    degree = [len(row) for row in adjacency]
+    queue = deque(i for i, value in enumerate(degree) if value <= 1)
+    removed = [False] * len(adjacency)
+    operations = len(adjacency) + sum(degree)
+    while queue:
+        vertex = queue.popleft()
+        operations += 1
+        if removed[vertex]:
+            continue
+        removed[vertex] = True
+        for other in adjacency[vertex]:
+            operations += 1
+            if not removed[other]:
+                degree[other] -= 1
+                if degree[other] == 1:
+                    queue.append(other)
+    core = {i for i, gone in enumerate(removed) if not gone}
+    return (core, operations) if with_operations else core
+
+
+def _cycle_order_from_graph(inst, with_operations=False):
+    adjacency = _adjacency(inst)
+    if adjacency is None:
+        raise ValueError("malformed graph")
+    if with_operations:
+        core, operations = _two_core(adjacency, True)
+    else:
+        core = _two_core(adjacency)
+        operations = 0
+    if len(core) < 3:
+        raise ValueError("graph has no cycle core")
+    start = min(core)
+    core_neighbors = sorted(adjacency[start] & core)
+    if len(core_neighbors) != 2:
+        raise ValueError("2-core is not a cycle")
+    previous, current = start, core_neighbors[0]
+    order = [start]
+    while current != start:
+        order.append(current)
+        nxt = [v for v in adjacency[current] if v in core and v != previous]
+        operations += len(adjacency[current]) + 2
+        if len(nxt) != 1:
+            raise ValueError("2-core is not a simple cycle")
+        previous, current = current, nxt[0]
+        if len(order) > len(core):
+            raise ValueError("cycle traversal did not close")
+    if len(order) != len(core):
+        raise ValueError("cycle traversal omitted core vertices")
+    return (order, operations) if with_operations else order
+
+
+def random_candidate(inst, rng):
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    cycle_size = inst["field_prime"] + 1
+    return sorted(rng.sample(range(cycle_size), inst["k"]))
+
+
+def search_space(inst):
+    cycle_size = inst["field_prime"] + 1
+    k = inst["k"]
+    return math.comb(cycle_size, k)
+
+
+def _fast_core_candidate(inst, candidate, cycle_order=None, position=None):
+    if not isinstance(candidate, list) or len(candidate) != inst["k"]:
+        return False
+    if len(set(candidate)) != len(candidate):
+        return False
+    cycle_order = cycle_order or _cycle_order_from_graph(inst)
+    if position is None:
+        position = {vertex: index for index, vertex in enumerate(cycle_order)}
+    if any(vertex not in position for vertex in candidate):
+        return False
+    positions = sorted(position[vertex] for vertex in candidate)
+    gaps = [positions[i + 1] - positions[i] for i in range(len(positions) - 1)]
+    gaps.append(len(cycle_order) + positions[0] - positions[-1])
+    return max(gaps) <= 2 * inst["r"] - 1
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 1_000_000:
+        return None
+    order = _cycle_order_from_graph(inst)
+    count = 0
+    for candidate in itertools.combinations(range(inst["field_prime"] + 1), inst["k"]):
+        if _fast_core_candidate(inst, list(candidate), order):
+            count += 1
+    return count
+
+
+def _least_rotation(sequence):
+    """Booth's algorithm for the lexicographically least tuple rotation."""
+    seq = tuple(sequence)
+    size = len(seq)
+    doubled = seq + seq
+    i, j, offset = 0, 1, 0
+    while i < size and j < size and offset < size:
+        left, right = doubled[i + offset], doubled[j + offset]
+        if left == right:
+            offset += 1
+            continue
+        if left > right:
+            i = i + offset + 1
+            if i <= j:
+                i = j + 1
+        else:
+            j = j + offset + 1
+            if j <= i:
+                j = i + 1
+        offset = 0
+    start = min(i, j)
+    return doubled[start : start + size]
+
+
+def canonical_key(inst):
+    adjacency = _adjacency(inst)
+    if adjacency is None:
+        return "malformed"
+    order = _cycle_order_from_graph(inst)
+    core = set(order)
+    tags = [sum(1 for other in adjacency[v] if other not in core) for v in order]
+    forward = _least_rotation(tags)
+    backward = _least_rotation(reversed(tags))
+    canonical = min(forward, backward)
+    payload = json.dumps(
+        [inst.get("r"), inst.get("k"), len(order), canonical],
+        separators=(",", ":"),
+    )
+    return "unicyclic-rdom:" + hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params):
+    harder = dict(params)
+    harder["n"] = max(int(params.get("n", 2)) + 1, int(params.get("n", 2)) * 2)
+    harder["leaf_crowding"] = min(8, int(params.get("leaf_crowding", 1)) + 1)
+    harder["k"] = int(params.get("k", 16))
+    return harder
+
+
+def _reference_algorithm(inst):
+    order, operations = _cycle_order_from_graph(inst, True)
+    stride = 2 * inst["r"] - 1
+    candidate = sorted(order[::stride])
+    operations += len(candidate) + len(order)
+    return candidate, operations
+
+
+def _fit_three_images(image_infinity, image_zero, image_one, p):
+    """Möbius matrix sending infinity, 0, 1 to the three given points."""
+    images = (image_infinity, image_zero, image_one)
+    if len(set(images)) != 3:
+        return None
+    if image_infinity == p:
+        # c=0,d=1,b=image_zero,a+b=image_one.
+        return (((image_one - image_zero) % p, image_zero), (0, 1))
+    if image_zero == p:
+        # d=0,c=1,a=image_infinity,a+b=image_one.
+        return ((image_infinity, (image_one - image_infinity) % p), (1, 0))
+    if image_one == p:
+        # c=-1,d=1,b=image_zero,-a=image_infinity.
+        return (((-image_infinity) % p, image_zero), ((-1) % p, 1))
+    denominator = (image_infinity - image_one) % p
+    if denominator == 0:
+        return None
+    c = ((image_one - image_zero) * pow(denominator, -1, p)) % p
+    a = (image_infinity * c) % p
+    return ((a, image_zero), (c, 1))
+
+
+def _shortcut_algorithm(inst):
+    """Recover the hidden recurrence from a few rows and jump by a matrix power."""
+    p = inst["field_prime"]
+    table = inst["cycle_neighbors"]
+    # Either global direction is valid.  Fix one neighbor of infinity, then only
+    # four orientation combinations for 0 and 1 remain.
+    image_infinity = table[p][0]
+    recovered = None
+    fits_tried = 0
+    # Five total domain points (infinity, 0, 1, 2, 3) make this exact: a wrong
+    # Möbius map can agree with f on at most two points and with f^-1 on at most
+    # two points, so membership in {f(x),f^-1(x)} at all five forces f or f^-1.
+    tests = [x for x in (2, 3) if x <= p]
+    for image_zero in table[0]:
+        for image_one in table[1]:
+            fits_tried += 1
+            matrix = _fit_three_images(image_infinity, image_zero, image_one, p)
+            if matrix is None:
+                continue
+            if all(_mobius(matrix, x, p) in table[x] for x in tests):
+                recovered = matrix
+                break
+        if recovered is not None:
+            break
+    if recovered is None:
+        return [], 10_000
+    jump = _mat_pow(recovered, 2 * inst["r"] - 1, p)
+    value = p
+    answer = []
+    for _ in range(inst["k"]):
+        answer.append(value)
+        value = _mobius(jump, value, p)
+    # Conservative field-operation accounting: each attempted three-point fit
+    # plus one validation row, every scalar operation in the 2x2 binary power,
+    # and every scalar operation in the k projective actions.
+    exponent = 2 * inst["r"] - 1
+    matrix_products = max(0, exponent.bit_length() - 1) + exponent.bit_count()
+    operations = (
+        10 + (7 + 8 * len(tests)) * fits_tried
+        + 12 * matrix_products + 8 * inst["k"]
+    )
+    return sorted(answer), operations
+
+
+def _closed_ball(adjacency, source, radius):
+    distance = {source: 0}
+    queue = deque([source])
+    while queue:
+        vertex = queue.popleft()
+        if distance[vertex] == radius:
+            continue
+        for other in adjacency[vertex]:
+            if other not in distance:
+                distance[other] = distance[vertex] + 1
+                queue.append(other)
+    return set(distance)
+
+
+def _attack_outlier(inst):
+    adjacency = _adjacency(inst)
+    core = _two_core(adjacency)
+    ranked = sorted(core, key=lambda v: (-len(adjacency[v]), v))
+    return sorted(ranked[: inst["k"]]), len(core)
+
+
+def _attack_greedy(inst):
+    adjacency = _adjacency(inst)
+    core = sorted(_two_core(adjacency))
+    balls = {vertex: _closed_ball(adjacency, vertex, inst["r"]) for vertex in core}
+    uncovered = set(range(inst["n_vertices"]))
+    chosen = []
+    operations = 0
+    for _ in range(inst["k"]):
+        remaining = [vertex for vertex in core if vertex not in chosen]
+        best = max(remaining, key=lambda v: (len(balls[v] & uncovered), -v))
+        operations += len(remaining)
+        chosen.append(best)
+        uncovered.difference_update(balls[best])
+        if not uncovered:
+            break
+    return sorted(chosen), operations
+
+
+def _attack_random_restart(inst, seed):
+    rng = random.Random(seed ^ 0x5A17C9)
+    order = _cycle_order_from_graph(inst)
+    position = {vertex: index for index, vertex in enumerate(order)}
+    for attempt in range(256):
+        candidate = random_candidate(inst, rng)
+        if _fast_core_candidate(inst, candidate, order, position=position):
+            return candidate, attempt + 1
+    return [], 256
+
+
+def _attack_affine(inst):
+    modulus = inst["field_prime"] + 1
+    k = inst["k"]
+    differences = Counter()
+    for vertex, pair in enumerate(inst["cycle_neighbors"]):
+        for other in pair:
+            difference = (other - vertex) % modulus
+            if difference:
+                differences[min(difference, modulus - difference)] += 1
+    steps = [step for step, _ in differences.most_common(16)]
+    steps.extend([1, 2, 3, 5, 7, 11])
+    attempts = 0
+    order = _cycle_order_from_graph(inst)
+    position = {vertex: index for index, vertex in enumerate(order)}
+    for step in dict.fromkeys(steps):
+        for start in range(min(modulus, 32)):
+            candidate = sorted({(start + j * step) % modulus for j in range(k)})
+            attempts += 1
+            if len(candidate) == k and _fast_core_candidate(
+                inst, candidate, order, position=position
+            ):
+                return candidate, attempts
+    return [], attempts
+
+
+def _relabel_instance(inst, permutation, edge_rng=None):
+    transformed = dict(inst)
+    edges = [[permutation[u], permutation[v]] for u, v in inst["edges"]]
+    if edge_rng is not None:
+        for edge in edges:
+            if edge_rng.getrandbits(1):
+                edge.reverse()
+        edge_rng.shuffle(edges)
+    transformed["edges"] = edges
+    transformed["answer"] = [permutation[v] for v in inst["answer"]]
+    # The compact construction tables are deliberately not used by verify or
+    # canonical_key; they need not survive an arbitrary graph relabelling.
+    return transformed
+
+
+def _corruption_results(inst):
+    answer = list(inst["answer"])
+    results = {}
+    variants = {
+        "drop_one": answer[:-1],
+        "duplicate_one": [answer[0], answer[0]] + answer[2:],
+        "empty": [],
+        "out_of_range": [inst["n_vertices"]] + answer[1:],
+    }
+    used_reasons = set()
+    for name, candidate in variants.items():
+        ok, reason = verify(inst, candidate)
+        results[name] = {"rejected": not ok, "reason": reason}
+        used_reasons.add(reason)
+
+    swapped = None
+    answer_set = set(answer)
+    for replacement in range(inst["n_vertices"]):
+        if replacement in answer_set:
+            continue
+        candidate = [replacement] + answer[1:]
+        ok, reason = verify(inst, candidate)
+        if not ok and reason not in used_reasons:
+            swapped = (candidate, reason)
+            break
+    if swapped is None:
+        results["swap_one"] = {"rejected": False, "reason": "no rejecting swap found"}
+    else:
+        results["swap_one"] = {"rejected": True, "reason": swapped[1]}
+    return results
+
+
+def _adversary_panel(params):
+    names = (
+        "outlier_high_degree",
+        "greedy_maximum_new_coverage",
+        "random_restart_256",
+        "affine_label_progression",
+    )
+    results = {
+        name: {"successes": 0, "attempts": 8, "nodes": 0, "wall_clock_sec": 0.0}
+        for name in names
+    }
+    reference_successes = 0
+    reference_operations = 0
+    reference_wall = 0.0
+    for seed in range(501, 509):
+        inst = make_instance(seed=seed, **params)
+        attacks = (
+            ("outlier_high_degree", lambda: _attack_outlier(inst)),
+            ("greedy_maximum_new_coverage", lambda: _attack_greedy(inst)),
+            ("random_restart_256", lambda: _attack_random_restart(inst, seed)),
+            ("affine_label_progression", lambda: _attack_affine(inst)),
+        )
+        for name, attack in attacks:
+            started = time.perf_counter()
+            candidate, nodes = attack()
+            elapsed = time.perf_counter() - started
+            ok = bool(candidate) and verify(inst, candidate)[0]
+            results[name]["successes"] += int(ok)
+            results[name]["nodes"] += nodes
+            results[name]["wall_clock_sec"] += elapsed
+
+        started = time.perf_counter()
+        candidate, operations = _reference_algorithm(inst)
+        reference_wall += time.perf_counter() - started
+        reference_operations += operations
+        reference_successes += int(verify(inst, candidate)[0])
+
+    for result in results.values():
+        result["wall_clock_sec"] = round(result["wall_clock_sec"], 6)
+    return {
+        "pass": all(result["successes"] == 0 for result in results.values()),
+        "attacks": results,
+        "reference_algorithm": {
+            "name": "2-core leaf peeling followed by residual-cycle traversal",
+            "complexity": "O(|V|+|E|) exact graph operations",
+            "wall_clock_sec": round(reference_wall, 6),
+            "operations": reference_operations,
+            "attempts": 8,
+            "successes": reference_successes,
+            "solves": f"{reference_successes}/8, as expected on Track B",
+        },
+    }
