import math

def prime(x):
 if x<2:return False
 if x%2==0:return x==2
 d=3
 while d*d<=x:
  if x%d==0:return False
  d+=2
 return True

def nextp(target,k):
 p=max(3,target-1)
 while True:
  if (p+1)%k==0 and ((p+1)//k)%2==1 and prime(p):return p
  p+=1

def mob(x,p,t):
 # A [[0,-1],[1,t]], x -> -1/(x+t); infinity -> 0; denominator zero -> infinity represented p
 if x==p:return 0
 den=(x+t)%p
 if den==0:return p
 return (-pow(den,-1,p))%p

def find(p):
 for t in range(p):
  x=p; seen=[]; ss=set()
  while x not in ss:
   ss.add(x); seen.append(x); x=mob(x,p,t)
  if x==p and len(seen)==p+1:return t
 return None
for target in [12,64,128,256,512,1024,2048,4096,8192]:
 k=4 if target==12 else 16
 p=nextp(target,k)
 t=find(p)
 print(target,k,p,p+1,(p+1)//k,t)
