+def escalate(params: dict) -> dict | str | None:
+    """Double the decoy haystack while keeping r, k, and witness length fixed."""
 
+    current = dict(params)
+    n = current.get("n")
+    r = current.get("r", 8)
+    k = current.get("k", 16)
+    if not isinstance(n, int):
+        return None
+    next_n = n * 2
