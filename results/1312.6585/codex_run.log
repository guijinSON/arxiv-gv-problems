+def _attack_greedy_coverage(inst: dict, masks: list[int]) -> list[int]:
+    chosen: list[int] = []
+    available = set(range(inst["n"]))
+    covered = 0
+    for _ in range(inst["k"]):
+        best = min(
+            available,
+            key=lambda v: (-(masks[v] & ~covered).bit_count(), v),
