+    transformation = _random_conjugate(_base_full_cycle(prime), prime, rng)
+    cycle_order, end = _orbit(transformation, prime)
+    if end != prime or len(cycle_order) != cycle_size:
+        raise AssertionError("conjugation did not preserve the full orbit")
