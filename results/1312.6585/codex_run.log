+def _tree_centers(adjacency: list[list[int]]) -> list[int]:
+    n = len(adjacency)
+    if n <= 2:
+        return list(range(n))
+    degree = [len(row) for row in adjacency]
+    leaves = deque(v for v, d in enumerate(degree) if d <= 1)
+    remaining = n
+    while remaining > 2:
+        layer = len(leaves)
