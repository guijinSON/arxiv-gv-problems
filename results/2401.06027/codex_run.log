import random

def gen(n,seed):
 r=random.Random(seed)
 cyc=[(i,(i+1)%n) for i in range(n)]
 while 1:
  a=list(range(n));r.shuffle(a); M=[];ok=1
  while a:
   u=a.pop(); choices=[v for v in a if v not in ((u-1)%n,(u+1)%n)]
   if not choices:ok=0;break
   v=r.choice(choices);a.remove(v);M.append((u,v))
  if ok:break
 lab=list(range(n));r.shuffle(lab)
 E={tuple(sorted((lab[u],lab[v]))) for u,v in cyc+M}
 adj=[[] for _ in range(n)]
 for u,v in E:adj[u].append(v);adj[v].append(u)
 for a in adj:a.sort()
 return adj

def valid(adj,p): return len(p)==len(adj) and len(set(p))==len(p) and all(p[(i+1)%len(p)] in adj[p[i]] for i in range(len(p)))

def greedy(adj):
 n=len(adj)
 for start in range(n):
  for first in adj[start]:
   p=[start,first]; used=set(p)
   while len(p)<n:
    ch=[v for v in adj[p[-1]] if v not in used]
    if not ch:break
    ch.sort(key=lambda v:(sum(w not in used for w in adj[v]),v))
    v=ch[0];used.add(v);p.append(v)
   if valid(adj,p):return p

def rr(adj,r,restarts):
 n=len(adj)
 for _ in range(restarts):
  s=r.randrange(n);p=[s];u={s}
  while len(p)<n:
   ch=[v for v in adj[p[-1]] if v not in u]
   if not ch:break
   # weighted most constrained first (inverse onward)
   vals=[sum(w not in u or w==s for w in adj[v]) for v in ch]
   weights=[4**(3-x) for x in vals]
   x=r.randrange(sum(weights)); acc=0
   for v,w in zip(ch,weights):
    acc+=w
    if x<acc:break
   p.append(v);u.add(v)
  if valid(adj,p):return p
for n in [24,32,40,48,64,80,120]:
 gr=rrs=0
 for seed in range(100):
  a=gen(n,seed)
  gr+=greedy(a)"'!=None
  rrs+=rr(a,random.Random(10000+seed),500)!=None
 print(n,'"'greedy',gr,'random500',rrs)
