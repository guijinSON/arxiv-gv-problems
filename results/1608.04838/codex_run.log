+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+        "doubled_build_and_verify_seconds": doubled_wall,
+    }
+
+    invariance_checks = 0
+    real_checks = 0
+    distinct_keys = []
+    for seed in range(20):
+        # Canonicalization depends on the syndrome configuration, not on the
