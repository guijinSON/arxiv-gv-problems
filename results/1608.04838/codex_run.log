+    "easy": {"n": 28, "rank": 11, "target_count": 6},
+    "medium": {"n": 52, "rank": 15, "target_count": 14},
+    "hard": {"n": 80, "rank": 16, "target_count": 18},
+}
+SHIPPING_DIFFICULTY = "hard"
