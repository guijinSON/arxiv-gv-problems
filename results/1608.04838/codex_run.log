+    moved_s = tuple(_permute(value, q) for value in s)
+    d = inst["n"]
+    out["S"] = {
+        "V1": [_bits(moved_s[0], d), _bits(moved_s[1], d)],
+        "V2": _bits(moved_s[2], d),
+        "V3": _bits(moved_s[3], d),
+    }
