   508	
   509	
   510	
   511	Let $L\subseteq V(H')-V(M_1\cup M_2)$ be a legal $k$-set such that $|L \cap ( A' - V(M_0') - V(M_1) - V(M_2) )| = l$.
   512	For $i\in [k]$, let $W_i'' := W_i' - V(M_2) -L$ and $A_i'' := A_i'- V(M_0') - V(M_1) - V(M_2) -L$. 
   513	Since $|L \cap A_i| = 1$, 
   514	\begin{align*}\label{size-A1''}
   515	|A_i''| 
   516	&\geq |A_i'| - |M_0'| - |M_1| - |M_2| - 1 \\ 
   517	&\geq \lceil (1/k - \varepsilon)n \rceil - k(\varepsilon n  + 1) - k(\varepsilon + \gamma)n - k(\varepsilon + \gamma)n - 1 \\
   518	&> (1/k - 4k \varepsilon)n.
   519	\end{align*}
   520	
   521	
   522	Let  $n'' := |W_1''| + |A_1''|$, and $H'' :=H'-L- V(M_1) - V(M_2)$.
   523	Then by Claim 4, $(k-1)\sum_{i=1}^k |A_i''|=\sum_{i=1}^k |W_i''|$, which gives 
   524	$k \sum_{i=1}^k |A_i''| = \sum_{i=1}^k (|W_1''| + |A_1''|) = kn''$; so 
   525	$$\sum_{i=1}^k |A_i''|=n''.$$ 
   526	Hence, for $i \in [k]$, 
   527	$$|W_i''| = n'' - |A_i''| = \sum_{j \in [k] - \{i\}} |A_j''|.$$
   528	Therefore, 
   529	$V(H'')$ admits a partition $F_1,\ldots,F_k$, such that
   530	$F_i\cap V_i=A_i''$ for $i\in [k]$ and, for any $j\in [k]-\{i\}$,
   531	$F_i\cap V_j\subseteq  W_i''$ and
   532	$|F_i\cap V_j|=|A_i''|$. Note that $H[F_i]$ is a $k$-partite $k$-graph with partition classes
   533	$F_1\cap V_1, \ldots, F_1\cap V_k$. 
   534	
   535	\medskip
   536	
   537	If, for all $i\in [k]$, $H[F_i]$ has a perfect matching, say $M_i'$, then
   538	$M_0' \cup M_1 \cup M_2 \cup (\bigcup_{i=0}^k M_i')$ is a perfect matching in $H-L$, showing 
   539	that $\nu(H)\ge n-1$. 
   540	
   541	Thus,  it suffices to show, without loss of generality, that $H[F_1]$
   542	contains a perfect matching.  We  use Lemma~\ref{Phk}; so we need to  bound
   543	$d_{H[F_1]}(x)$ and $d_{H[F_1]}(S)$ for $x\in A_1''$ and legal $(k-1)$-sets
   544	$S\subseteq \bigcup_{j=2}^k(F_1\cap V_j) $.
   545	
   546	\medskip
   547	
   548	Let $x\in A_1''$. Since $A_1'' \subseteq A_1$, the number of legal
   549	$(k-1)$-subsets of $W$ not forming an edge with $x$ is at most
   550	$$({\lceil}(1-1/k-\gamma)n{\rceil})^{k-1}-((1-1/k-\gamma)^{k-1}-\varepsilon)n^{k-1}{<1.1}\varepsilon n^{k-1}.$$
   551	Note that the number of legal $(k-1)$-subsets of $\bigcup_{j=2}^k(F_1\cap V_j)$ 
   552	containing at least one vertex  from $L \cup V(M_0') \cup V(M_1) \cup V(M_2)$ is at most
   553	$$(|L| + |V(M_0')| + |V(M_1)| + |V(M_2)| )|A_1''|^{k-2} \leq 4k(\varepsilon + \gamma)n|A_1''|^{k-2}.$$
   554	Hence,
   555	$$d_{F_1}(x)
   556	\geq |A_1''|^{k-1} - 4k(\varepsilon + \gamma)n|A_1''|^{k-2} - {1.1}\varepsilon n^{k-1} \geq 0.9 |A_1''|^{k-1},$$
   557	where the last inequality holds because 
   558	$ \lceil (1/k - \varepsilon)n \rceil > |A_1''|> (1/k - 4k \varepsilon)n$, 
   559	 $0<\gamma <
   560	\varepsilon<1/(100k^3)$, and $\varepsilon < \frac{1}{100} (1/k-4k \varepsilon)^{k-1}$.
   561	
   562	
   563	
   564	
   565	
   566	
   567	On the other hand, for any legal $(k-1)$-set $S\subseteq \bigcup_{j=2}^k(F_1\cap V_j) $ and
   568	large $n$,
   569	we have
   570	$$d_{F_1}(S) \geq n/k- |M_0'| - |M_1| - |M_2| - 1 \geq n/k- k(\varepsilon n + 1)- 2k(\varepsilon+\gamma )n - 1
   571	> (1-4k^2\varepsilon)(n/k).$$
