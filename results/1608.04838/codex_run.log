   343	    d = inst["n"]
   344	    if not isinstance(answer, list) or len(answer) != 3:
   345	        return None
   346	    if any(
   347	        not isinstance(row, str)
   348	        or len(row) != d
   349	        or re.fullmatch(r"[01]+", row) is None
   350	        for row in answer
   351	    ):
   352	        return None
   353	    return tuple(int(row[::-1], 2) for row in answer)  # type: ignore[return-value]
   354	
   355	
   356	def _make_full_rank_rows(d: int, rank: int, rng: random.Random) -> list[int]:
   357	    # [I | random] is full-row-rank by construction.  Column permutation and
   358	    # invertible row additions hide the systematic coordinates without a search.
   359	    rows = []
   360	    for i in range(rank):
   361	        tail = rng.getrandbits(d - rank) << rank
   362	        rows.append((1 << i) | tail)
   363	    coordinate_order = list(range(d))
   364	    rng.shuffle(coordinate_order)
   365	    rows = [_permute(row, coordinate_order) for row in rows]
   366	    for _ in range(8 * rank):
   367	        i = rng.randrange(rank)
   368	        j = rng.randrange(rank - 1)
   369	        if j >= i:
   370	            j += 1
   371	        rows[i] ^= rows[j]
   372	    return rows
   373	
   374	
   375	def _planted_values(
   376	    s_values: tuple[int, int, int, int], permutations: list[list[int]]
   377	) -> tuple[int, int, int]:
   378	    a, aa, b, c = s_values
   379	    p1, p2, p3 = permutations
   380	    ty = _permute(aa, p1) ^ _permute(c, p3)
   381	    tz = _permute(a, p1) ^ _permute(b, p2)
   382	    tx = ty ^ tz
   383	    return _unpermute(tx, p1), _unpermute(ty, p2), _unpermute(tz, p3)
   384	
   385	
   386	def make_instance(n: int, seed: int = 0, **params) -> dict:
   387	    """Construct a certified S-absorbing edge by composing XOR identities."""
   388	    d = int(n)
   389	    rank = int(params.pop("rank", max(2, min(16, d - 2))))
   390	    target_count = int(params.pop("target_count", 18))
   391	    if params:
   392	        raise TypeError(f"unknown parameters: {sorted(params)}")
   393	    if d < 4:
   394	        raise ValueError("n (the binary-vector dimension) must be at least 4")
   395	    if not (1 <= rank < d):
   396	        raise ValueError("rank must satisfy 1 <= rank < n")
   397	    if not (1 <= target_count <= (1 << rank)):
   398	        raise ValueError("target_count must be in 1..2^rank")
   399	
   400	    rng = random.Random(seed)
   401	    rows = _make_full_rank_rows(d, rank, rng)
   402	    targets = {0}
   403	    while len(targets) < target_count:
   404	        targets.add(rng.randrange(1, 1 << rank))
   405	    target_values = list(targets)
   406	    rng.shuffle(target_values)
   407	
   408	    shifts = rng.sample(range(d), 3)
   409	    permutations = [[(j + shift) % d for j in range(d)] for shift in shifts]
   410	
   411	    limit = 1 << d
   412	    for _ in range(1000):
   413	        a = rng.randrange(limit)
   414	        aa = rng.randrange(limit)
   415	        if aa == a:
   416	            continue
   417	        b = rng.randrange(limit)
   418	        c = rng.randrange(limit)
   419	        planted = _planted_values((a, aa, b, c), permutations)
   420	        x, y, z = planted
   421	        if x not in (a, aa) and y != b and z != c:
   422	            break
   423	    else:
   424	        raise RuntimeError("could not draw a disjoint planted absorber")
   425	
   426	    answer = [_bit_string_value(value, d) for value in planted]
   427	    return {
   428	        "paper": "arXiv:1608.04838",
   429	        "family": "S-absorbing edge in a 3-partite 3-graph",
   430	        "n": d,
   431	        "rank": rank,
   432	        "target_count": target_count,
   433	        "part_size": 1 << d,
   434	        "minimum_legal_codegree": target_count << (d - rank),
   435	        "matrix": [_bits(row, d) for row in rows],
   436	        "permutations": permutations,
   437	        "targets": [_bits(value, rank) for value in target_values],
   438	        "S": {
   439	            "V1": [_bits(a, d), _bits(aa, d)],
   440	            "V2": _bits(b, d),
   441	            "V3": _bits(c, d),
   442	        },
   443	        "answer": answer,
   444	    }
   445	
