+def _apply_translation(inst: dict, t1: int, t2: int) -> dict:
+    out = json.loads(json.dumps(inst))
+    p1, p2, p3 = inst["permutations"]
+    t3 = _unpermute(_permute(t1, p1) ^ _permute(t2, p2), p3)
+    a, aa, b, c = _vectors(inst)
