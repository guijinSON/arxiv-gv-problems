+def _swap_named_objects(inst: dict) -> dict:
+    out = json.loads(json.dumps(inst))
+    out["S"]["V1"].reverse()
+    out["S"]["V2"], out["S"]["V3"] = out["S"]["V3"], out["S"]["V2"]
+    out["permutations"][1], out["permutations"][2] = (
+        out["permutations"][2], out["permutations"][1]
