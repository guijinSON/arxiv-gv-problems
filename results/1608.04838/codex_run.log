   451	Suppose we have constructed a matching $R_j$  in $H'-V(M_1)$, for some integer $j\ge 0$, such that 
   452	\begin{align*} %\label{M2-ind1}
   453	\Delta_j:=(k-1) \sum_{i=1}^k |A_i'-V(M_1)-V(R_j)| -\sum_{i=1}^k |W_i'-V(R_j)| \ge 0 
   454	\end{align*}
   455	
   456	If for some $l\in [k-1]$
   457	\begin{align*} 
   458	(k-1) \left(\sum_{i=1}^k |A_i'-V(M_1)-V(R_j)|-l\right) = \left(\sum_{i=1}^k |W_i'-V(R_j)|\right)-(k-l),
