+    y = next(v for v in range(8) if v != b)
+    p1, p2, p3 = inst["permutations"]
+    delta = _permute(a ^ aa, p1)
+    z = _unpermute(_permute(x, p1) ^ _permute(y, p2) ^ delta, p3)
+    if z == c:
