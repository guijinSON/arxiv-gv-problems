+    degree = m << (2 * d - rank)
+    codegree = m << (d - rank)
+    a, aa, b, c = _vectors(inst)
+    forbidden_triples = int(_is_edge(inst, a, b, c)) + int(_is_edge(inst, aa, b, c))
+    return total - 4 * degree + 5 * codegree - forbidden_triples
