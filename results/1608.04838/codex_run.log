+def _attack_raw_xor(inst: dict) -> object:
+    d = inst["n"]
+    a, aa, b, c = _vectors(inst)
+    # The right identity in the wrong (unpermuted) coordinate system.
+    y = aa ^ c
+    z = a ^ b
+    x = y ^ z
+    if x in (a, aa):
+        x ^= 1
+    if y == b:
+        y ^= 2
+    if z == c:
+        z ^= 4
+    return [_bit_string_value(x, d), _bit_string_value(y, d), _bit_string_value(z, d)]
