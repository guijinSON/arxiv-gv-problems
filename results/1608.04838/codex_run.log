+    if rank < d - 2:
+        next_rank = min(d - 2, max(rank + 8, (3 * rank) // 2))
+        return {"n": d, "rank": next_rank, "target_count": target_count}
+    # Only after the fixed-length axis is exhausted use the remaining atom cap.
+    if d < 84:
+        next_d = 84
+        return {
