+    rng = random.Random(seed)
+    rows = _make_full_rank_rows(d, rank, rng)
+    targets = {0}
+    while len(targets) < target_count:
+        targets.add(rng.randrange(1, 1 << rank))
+    target_values = list(targets)
+    rng.shuffle(target_values)
