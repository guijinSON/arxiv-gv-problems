    57	\begin{abstract}
    58	
    59	The minimum co-degree threshold  for a perfect matching in a
    60	$k$-graph with $n$ vertices was determined by R\" odl, Ruci\'nski and Szemer\'edi
    61	for the case when $n\equiv 0\pmod k$. Recently,  Han
    62	resolved the remaining cases when $n \not\equiv 0\pmod k$, establishing a conjecture of R\" odl, Ruci\'nski and
    63	Szemer\'edi. In this paper, we determine the minimum co-degree
    64	threshold  for almost perfect matchings in $k$-partite $k$-graphs,  answering a question of R\"odl and Ruci\'nski.
    65	
    66	
    67	\end{abstract}
    68	
    69	\section{Introduction}
    70	
    71	
    72	 A {\it hypergraph} $H$
    73	consists of a vertex set $V(H)$ and an edge set $E(H)$ whose members
    74	are subsets of $V(H)$. 
    75	A \emph{matching} in  $H$ is a subset of $E(H)$ consisting
    76	of pairwise disjoint edges.  We use  $\nu(H)$  to denote the maximum size of a matching in  $H$.
    77	A subset $I\subseteq V(H)$ is {\it independent} in $H$ if  $H[I]$, the induced
    78	subhypergraph of $H$ on set $I$, contains no edge.
    79	
    80	
    81	
    82	Let $k$ be a positive integer and $[k] := \{1,2,...,k\}$.
    83	For a set $S$, let ${S\choose k}:=\{T\subseteq S: |T|=k\}$.
    84	A hypergraph $H$ is {\it $k$-uniform} if $E(H)\subseteq {V(H)\choose k}$, and a $k$-uniform hypergraph is also
    85	called a {\it $k$-graph}.
    86	Let $H$ be a $k$-graph. 
    87	For $l\in [k-1]$ and $S\in {V(H)\choose l}$, the {\it neighborhood}
    88	of $S$ in $H$ is the set $N_H(S):=\{ U\in {V(H)\choose k-l} : S \cup U \in E(H)\}$.
    89	The {\it degree} of $S$ in $H$ is $d_H(S):=|N_H(S)|$. The  {\it minimum $l$-degree} of $H$, denoted by $\delta_l(H)$,  is
    90	the minimum degree over  all $l$-subsets of $V(H)$. $\delta_{k-1}(H)$ is also called the  minimum \emph{co-degree}  of $H$.
    91	
    92	The minimum co-degree threshold  for a perfect matching in an
    93	$n$-vertex $k$-graph for $n\equiv 0\pmod k$ and large $n$ was determined by R\" odl, Ruci\'nski and Szemer\'edi
    94	\cite{RRS09}.
    95	This threshold function is $n/2-k+C$, where $C \in \{3/2, 2, 5/2, 3\}$, depending
    96	on the parity of $n$ and $k$.
    97	When $n \not\equiv 0\pmod k$, Han \cite{Han15}
    98	determined that $\lfloor n/k \rfloor$ is the minimum co-degree threshold 
    99	for an almost perfect matching in an $n$-vertex $k$-graph, by settling a conjecture in \cite{RRS09}.
   100	Note that when $k \geq 3$ there is a gap between the threshold for a perfect matching and the threshold for an almost perfect matching.
   101	There has been a lot of work on $l$-degree conditions for large matchings, and 
   102	we refer the reader to \cite{TZ12,TZ13} and references therein.
   103	
   104	
   105	
   106	
   107	Let $k$ be a positive integer.
   108	A hypergraph $H$ is a {\it $k$-partite $k$-graph} if $V(H)$ admits a
   109	partition $V_1,...,V_k$ such that $|e \cap V_i| = 1$ for all $e \in
   110	E(H)$ and $i \in [k]$. The sets $V_1,\ldots, V_k$ are called {\it partition classes}.
   111	Let $H$ be a $k$-partite $k$-graph with partition classes $V_1,...,V_k$.
   112	A set $S\subseteq V(H)$ is  {\it legal} if $|S \cap V_i| \leq 1$ for $i \in [k]$.
   113	The  {\it minimum $l$-degree} of $H$, denoted by $\delta_l(H)$,  is
   114	the minimum degree over  all legal $l$-subsets of $V(H)$. $\delta_{k-1}(H)$ is also called the  minimum \emph{co-degree}  of $H$.
   115	
   116	%The minimum co-degree threshold  for a perfect matching in a
   117	%$k$-graph was determined by R\" odl, Ruci\'nski and Szemer\'edi
   118	%\cite{RRS09} and {\color{black}Han \cite{Han15}}. R\" odl, Ruci\'nski and Szemer\'edi
   119	%did the case for $n\equiv 0\pmod k$ and large $n$, and Han did the
   120	%remaining cases by establishing a conjecture in \cite{RRS09}.
   121	
   122	
   123	
   124	
   125	
   126	
   127	 K\"uhn and Osthus \cite{Kuh06} showed that  the minimum co-degree
   128	 threshold for a perfect matching in a $k$-partite $k$-graph with $n$
   129	 vertices in each part is between $n/2$ and
   130	 $n/2+\sqrt{2n\log n}$.
   131	Aharoni, Georgakopoulos and Spr\" ussel \cite{AGS09} obtained the
   132	following stronger result: Let $H$ be a $k$-partite $k$-graph with
   133	partition classes $V_1,\ldots,V_k$, each of size $n$. If $d_H(f) >
   134	n/2$ for every legal
   135	$(k-1)$-set $f$ contained in $V(H) - V_1$, and if $d_H(g)\geq n/2$
   136	for every legal $(k-1)$-set $g$ contained in $V(H)-V_2$,
   137	then $H$ has a perfect matching.
   138	
   139	
   140	For almost perfect matchings in $k$-partitie $k$-graphs, K\"uhn and Osthus \cite{Kuh06}  showed
   141	the following: Let $H$ be a $k$-partite $k$-graph with partition
   142	classes $V_1,\ldots,V_k $, each of size $n$. If
   143	$\delta_{k-1}(H)\geq n/k$, then $\nu(H)\ge n-(k-2)$.
   144	R\"odl and Ruc\'inski \cite{Rod09} asked the following question: Is it
   145	true that, for every $k$-partite $k$-graph $H$ with $n$ vertices in
   146	each partition class,  if $\delta_{k-1}(H) \geq n/k$ then $\nu(H)\ge n-1$?
   147	In this paper, we answer this question in the affirmative (for large
   148	$n$) by proving the following result.
   149	\begin{theorem}
   150	\label{main}
   151	Let $k \geq 3$ be an integer and let $H$ be a $k$-partite $k$-graph with $n$ vertices in each partition class.
   152	Suppose $n$ is sufficiently large.
   153	If $\delta_{k-1}(H) \geq n/k$, then $\nu(H)\ge n-1$.
   154	\end{theorem}
   155	
   156	
   157	The bound $\delta_{k-1}(H) \geq n/k$ in Theorem~\ref{main} is best possible.
   158	To see this, let $V_1,\ldots, V_k$ be pairwise disjoint sets with $|V_i| = n$ for all $i \in [k]$, 
   159	and let $U_i \subseteq V_i$ for $i \in [k]$ such that $|U_i| = \lfloor (n-1)/k \rfloor$.
   160	Let $H_0$ be the $k$-partite $k$-graph with partition classes $V_1, ..., V_k$
   161	such that, for each legal $k$-set $e$,  $e \in E(H_0)$ if and only if $|e \cap (\bigcup_{i = 1}^k U_i)| \geq 1$.
   162	Clearly, $\delta_{k-1}(H_0) \geq \lfloor (n-1)/k \rfloor$ for large enough $n$.
   163	However, if $n \not\equiv 1 \pmod k$, then $\nu(H_0) \leq |U| = k \cdot \lfloor \frac{n-1}{k} \rfloor < n - 1$.
   164	We remark that for $n \equiv 1 \pmod k$, Han, Zang and Zhao \cite{HZZ} later showed 
   165	that $\lfloor n/k \rfloor$ is the right threshold for $\nu(H)\ge n-1$.  
   166	
   167	
   168	Our proof of Theorem~\ref{main} will be carried out in two steps, similar to the
   169	argument in \cite{Han15}, by considering 
   170	whether or not $H$ contains a large independent set.
   171	In Section 2, we prove Theorem~\ref{main} for the 
   172	case when $H$ has a large independent set, see Lemma~\ref{extremal}.    In Section 3, we prove
   173	Theorem~\ref{main} for the case when $H$ does not contain a large
   174	independent set, see Lemma~\ref{non-extremal}. Theorem~\ref{main} is 
   175	an immediate consequence of Lemmas~\ref{extremal} and \ref{non-extremal}.
   176	
   177	
   178	
   179	
   180	\section{Hypergraphs with large independent sets}
   181	
   182	In this section, we prove Theorem \ref{main} for the case when $H$ contains a large independent set.
   183	We need a result of Pikhurko \cite{Pik08}.
   184	
   185	\begin{lemma}\label{Phk}
   186	Let $k \geq  2$ be an integer and  $l\in [k-1]$, let $\alpha>0$ be a constant and $n$ be a
   187	sufficiently large integer.
   188	 Let $H$ be a $k$-partite $k$-graph
   189	with partition classes $V_1,\ldots,V_k$ and assume  $|V_i|=n$ for $i\in
   190	[k]$. If, for every legal $l$-set $S\subseteq  V_1 \cup \cdots \cup V_l$ and
   191	every legal $(k-l)$-set $S'\subseteq  V_{l+1} \cup \cdots \cup V_k$,
   192	\[
   193	\frac{d_H(S)}{n^{k-l}}+\frac{d_{H}(S')}{n^{l}}>1+\alpha,
   194	\]
   195	then $H$ contains a perfect matching.
   196	\end{lemma}
   197	
   198	
   199	First, we prove a bound on $\nu(H)$ by slightly weakening the lower bound condition on $\delta_{k-1}(H)$.
   200	This lemma is essentially the same as Theorem 11 in \cite{Kuh06}.
   201	
   202	\begin{lemma}\label{small-degree}
   203	Let $n>0,k>0,r\ge 0$ be integers with $n\geq kr+(k-1)$. Let $H$ be  a $k$-partite
   204	$k$-graph with partition classes $V_1,\ldots,V_k$ and let
   205	$|V_i| = n$ for $i \in [k]$. If $\delta_{k-1}(H)\geq r$ then
   206	$\nu(H)\ge kr$.
   207	\end{lemma}
   208	
   209	\pf Let $M$ be a maximum matching in $H$. If $|M|\ge
   210	kr$ then $\nu(H)\ge kr$. We may thus assume $|M|<kr$.
   211	Hence, for  $i\in [k]$,
   212	\[
   213	|V_i-V(M)| = n - |M| \geq n - kr + 1 \geq (k-1)+1 = k.
   214	\]
   215	So there exist $k$ pairwise vertex-disjoint legal $(k-1)$-subsets of $V(H)$, denoted as $f_1,\ldots f_k$, such that for $i\in [k]$, 
   216	$$f_i\subseteq \bigcup_{j\in [k]-\{i\}}(V_j-V(M)).$$
   217	Since $M$ is maximum,  $N_H(f_i)\subseteq V(M)$ for $i\in [k]$.
   218	
   219	Since $H$ is a $k$-partite $k$-graph,
   220	$N_H(f_i)\cap N_H(f_j)=\emptyset$  for all $i,j\in [k]$ with $i\neq j$.
   221	Hence, since $\delta_{k-1}(H)\geq r$,
   222	$|\bigcup_{i\in [k]}N_H(f_i)|\geq kr.$
   223	Since $|M|<kr$, it follows from the Pigeonhole principle that there
   224	exist  $e\in M$ and distinct  $f_i,f_j$ such that $N_H(f_i)\cap
   225	e\neq\emptyset$ and $N_H(f_j)\cap e \neq \emptyset$.
   226	Let  $v_i\in N_H(f_i)\cap e$ and $v_j\in N_H(f_j)\cap e$. Then
   227	$v_i\neq v_j$ (as $i\ne j$) and,
   228	hence, $(M-\{e\})\cup \{f_i\cup \{v_i\},f_j\cup\{v_j\}\}$ is a  matching in
   229	$H$ whose size is larger than $|M|=\nu(H)$, a contradiction. \qed
   230	
   231	
   232	
   233	\medskip
   234	
   235	
   236	We now prove Theorem~\ref{main} for the case when $H$ has a large independent set. For
   237	convenience, we adopt  the following concept which is a $k$-partite
   238	version of a concept in \cite{Han15}.
   239	For $0 \leq \gamma < 1$, a $k$-partite $k$-graph $H$ with $n$ vertices in
   240	each partition class is \textit{$\gamma$-extremal} if $H$ contains an
   241	independent set $W$
   242	with at least $(1-\gamma)(k-1)n/k = (1 - 1/k - \gamma + \gamma/k)n$ vertices in each partition class.
   243	
   244	
   245	
   246	
   247	
   248	\begin{lemma}
   249	\label{extremal}
   250	Let $n,k$ be positive integers with $k\ge 3$ and  $n$  sufficiently large. Let
   251	$\gamma,\varepsilon $ be sufficiently small real numbers such that
   252	 $0<\gamma\ll \varepsilon < 1/(100k^3)$, $\gamma (1-1/k-\gamma)^{k-1} < \varepsilon^2$, and $\varepsilon < (1/k-4k \varepsilon)^{k-1}/100$.
   253	Let $H$ be a $k$-partite $k$-graph with  partition classes
   254	$V_1,\ldots,V_k$ such that $|V_i| = n$ for $i \in [k]$ and $H$ is $\gamma$-extremal.
   255	If $\delta_{k-1}(H)\geq n/k$, then $\nu(H)\ge n-1$.
   256	\end{lemma}
   257	
   258	\pf Since $H$ is $\gamma$-extremal,
   259	 there exists an independent set $W$ in $H$ such that $|W\cap
   260	 V_i| \geq {\lceil}(1-1/k-\gamma)n {\rceil}$ for $i\in [k]$.
   261	 So we choose $W$ such that  
   262	   $|W\cap
   263	 V_i|={\lceil}(1-1/k-\gamma)n{\rceil}$ for $i\in [k]$, and let  $W_i=W\cap V_i$. 
   264	Then for $i\in [k]$, $|V_i - W_i| = n - {\lceil}(1-1/k-\gamma)n{\rceil}$; so 
   265	$$  (1/k + \gamma)n-1 =n - (1-1/k-\gamma)n -1 \le |V_i - W_i| \leq n - (1-1/k-\gamma)n = (1/k + \gamma)n.$$ 
   266	
   267	For $i\in [k]$, let 
   268	\[
   269	A_i := \{x\in V_i-W_i\ : \ e_H(x,W)\geq \left((1-1/k-\gamma)^{k-1}-\varepsilon\right)n^{k-1}\},
   270	\]
   271	where  $e_H(x,W)$ denotes the number of edges of $H$ containing $x$
   272	and contained in $W\cup \{x\}$.
   273	We proceed by proving four claims. First we give a lower bound on $|A_i|$ for $i\in [k]$.
   274	
   275	\medskip
   276	
   277	\textit{Claim 1. } $|A_i|\geq (1/k-\varepsilon)n$ for $i\in [k]$.
   278	
   279	For, suppose this is not true and, without loss of generality, assume $|A_1| < (1/k-\varepsilon)n$.
   280	Then $|V_1-W_1|-|A_1|\ge (1/k+\gamma)n{-1}-(1/k-{\varepsilon})n=(\varepsilon+\gamma)n{-1}$.
   281	By definition of $A_1$, for each  $x\in V_1-W_1-A_1$,
   282	$e_H(x,W) < \left((1-1/k-\gamma)^{k-1}-\varepsilon\right)n^{k-1}.$
   283	Hence,
   284	\begin{align*}
   285	\sum_{x\in V_1-W_1}e_H(x,W)
   286	&\leq |A_1| \lceil (1-1/k-\gamma)n \rceil ^{k-1}+|V_1-W_1-A_1|\left((1-1/k-\gamma)^{k-1}-\varepsilon\right)n^{k-1}\\
   287	&\leq |V_1 - W_1| \lceil (1-1/k-\gamma)n \rceil ^{k-1} - |V_1-W_1-A_1|\varepsilon n^{k-1}\\
   288	&\le  (1/k+\gamma)n\lceil (1-1/k-\gamma)n \rceil ^{k-1}-((\varepsilon+\gamma)n{-1}) \varepsilon n^{k-1}\\
   289	&=(1/k)n \lceil (1-1/k-\gamma) n \rceil ^{k-1} + (\gamma (1-1/k-\gamma)^{k-1} -
   290	  \varepsilon^2-\varepsilon \gamma )n^k + o(n^k)\\
   291	&< (n/k) \lceil (1-1/k-\gamma) n \rceil ^{k-1},
   292	\end{align*}
   293	%{-\varepsilon}/n
   294	where the last inequality holds since $\gamma (1-1/k-\gamma)^{k-1} <
   295	\varepsilon^2$ and $n$ is large.
   296	
   297	On the other hand, since $\delta_{k-1}(H)\geq n/k$ and $W$ is independent,
   298	\begin{align*}
   299	\sum_{x\in V_1-W_1}e_H(x,W)
   300	&= \sum_{ \text{legal } (k-1)\text{-set } S\subseteq  \bigcup_{i=2}^kW_i}d_H(S) \\
   301	&\geq \sum_{ \text{legal } (k-1)\text{-set } S\subseteq \bigcup_{i=2}^kW_i}\delta_{k-1}(H) \\
   302	&\geq (n/k) \lceil (1-1/k-\gamma) n \rceil ^{k-1},
   303	\end{align*}
   304	a contradiction. \ensuremath{\blacksquare}
   305	
   306	\medskip
   307	
   308	Therefore, for $i\in [k]$, we {\color{black}can} choose $A_i'\subseteq A_i$ such that
   309	$|A_i'|=\lceil(1/k-\varepsilon)n\rceil$. Let $A'=\bigcup_{i=1}^k A_i'$.
   310	Then $H-A'$ is a $k$-partite $k$-graph with
   311	$n-\lceil(1/k-\varepsilon)n\rceil$ vertices in each partition
   312	class.
   313	Let $$r=\lceil n/k \rceil-\lceil(1/k-\varepsilon)n\rceil.$$
   314	Then $$1\leq r \leq (n/k + 1) - (1/k-\varepsilon)n  = \varepsilon n +
   315	1.$$
   316	% So for large $n$,  we have
   317	%\[
   318	%r\leq \frac{n'-(k-1)}{k}.
   319	%\]
   320	Since $\delta_{k-1}(H) \geq n/k$ and
   321	$|A_i'|=\lceil(1/k-\varepsilon)n\rceil$,  $$\delta_{k-1}(H-A')\geq \lceil n/k \rceil-\lceil(1/k-\varepsilon)n\rceil =r.$$
   322	
   323	
   324	\medskip
   325	
   326	\textit{Claim 2. } There exists a matching $M_0'$ in $H-A'$ such that $|M_0'| \leq k(\varepsilon n + 1)$ and $n' := |V_1| - |M_0'| = k|A_1'|$.
   327	
   328	By Lemma \ref{small-degree}, $H-A'$ contains a matching of size at
   329	least $kr$, say  $M_0$. Write $n=mk+s$ with $1\le s\le k$.
   330	Choose $M_0'\subseteq M_0$ such that
   331	  $|M_0'|=k(r-1)+s$.
   332	Then $|M_0'| \leq k(r-1)+k = kr \leq k(\varepsilon n +1)$, and
   333	\begin{align*}
   334	n'=n-|M_0'|=n-k(r-1)-s
   335	=n-k\left(\lceil n/k\rceil-\lceil(1/k-\varepsilon)n\rceil\right)-s+k
   336	=k\lceil(1/k-\varepsilon)n\rceil.
   337	\end{align*}
   338	Hence, $n'=k|A_1'|$. 
   339	\ensuremath{\blacksquare}
   340	%where the last equality holds because $n=mk+s$ and $1\le s\le k$.
   341	
   342	\medskip
   343	
   344	Let $H' := H-V(M_0')$.
   345	% and $n':=|V_1|-|M_0'|$. We have $n'\equiv 0\pmod k$.
   346	Then $H'$ is a $k$-partite $k$-graph with $n'$ vertices in each partition class.
   347	Let $D_i :=V_i-A_i'-W_i-V(M_0')$ for $i \in [k]$, and let $D = \cup_{i = 1}^k D_i$. Note that for $i\in [k]$, 
   348	$$|D_i|\le |V_i-W_i|-|A_i'|\le (1/k+\gamma)n-(1/k-\varepsilon)n= (\varepsilon+\gamma)n.$$
   349	%and $|D| \leq k(\varepsilon+\gamma)n$.
   350	
   351	
   352	\medskip
   353	
   354	\textit{Claim 3. } There exists a matching $M_1$ in $H'$ such that $D \subseteq V(M_1)$, each edge of $M_1$ contains at least one vertex from $D$, and each edge of $M_1$ contains at most one vertex from $A'$. In particular, $|M_1| \leq |D| \leq k(\varepsilon+\gamma)n$.
   355	
   356	
   357	We construct such a matching greedily, by starting with the empty matching $F_0 = \emptyset$.
   358	Suppose for some $i \geq 0$, we have constructed a matching $F_i$ such that each edge of $F_i$ contains at least one vertex from $D$ and at most one vertex from $A'$.
   359	
   360	We may assume $D \not \subseteq V(F_i)$; for, otherwise, $F_i$ gives
   361	the desired matching $M_1$ for Claim 3. Let $v \in D - V(F_i)$. Then
   362	$v \in D_j$ for some $j\in [k]$ and, without loss of generality,
   363	assume $j \in [k - 1]$.
   364	
   365	Since $|F_i| < |D| \leq k(\varepsilon + \gamma)n$ (by construction) and
   366	$|V_l-V(M_0')|=k|A_l'|$ (by Claim 2) for $l\in [k]$, we have, for $l\in [k]$,
   367	$$|V_l - V(M_0') - A_l' - V(F_i)| = k|A_l'| - |A_l'| - |F_i| = (k-1)\lceil(1/k-\varepsilon)n\rceil  - k(\varepsilon+\gamma)n > 0.$$
   368	Thus, let $v_l \in V_l - V(M_0') - A_l' - V(F_i)$ for $l\in [k]-\{j,j+1\}$.
   369	
   370	
   371	Since $\delta_{k-1}(H) \geq n/k$ and $|M_0'| \leq k(\varepsilon n + 1)$ (by Claim 2), we have
   372	$$d_{H' - V(F_i)}(\{v\} \cup  \{v_l: l \in [k] - \{j, j+1\}\} ) \geq n/k - k(\varepsilon n + 1) - k(\varepsilon+\gamma)n > n/(2k) > 0 $$
   373	as $\varepsilon <1/(100k^3)$ and $n$ is sufficiently large. 
   374	Thus there exists a vertex $v_{j+1} \in V_{j+1} - V(M_0') - V(F_i)$ such that $e_{i+1} := \{v\} \cup \{v_l: l \in [k] - \{j\}\} \in E(H)$.
   375	Clearly, $\{v\} \subseteq e_{i+1}\cap D$ and $e_{i+1}\cap A'\subseteq\{v_{j+1}\}$. 
   376	
   377	Let $F_{i+1} := F_i \cup \{e_{i+1}\}$.
   378	Then, each edge of $F_{i+1}$ uses at least one vertex from $D$ and at most one vertex from $A'$. 
   379	We may continue this process until we obtain a matching $F_t$ in $H'$ such that $D\subseteq V(F_t)$, each edge of $F_t$ 
   380	uses at least one vertex from $D$,  and each edge of $F_t$ uses at most one vertex from $A'$. 
   381	
   382	Clearly, $t \leq k(\varepsilon+\gamma)n$ as $|D| \leq k(\varepsilon+\gamma)n$.
   383	So $M_1 := F_t$ is the desired matching. \ensuremath{\blacksquare}
   384	
   385	\medskip
   386	
   387	Let $W_i' := W_i - V(M_0') - V(M_1)$ for $i \in [k]$. 
   388	
   389	\medskip
   390	
   391	\textit{Claim 4. } There exist  $l\in [k-1]$  and matching $M_2$ in $H' - V(M_1)$ such that $|M_2|\le |M_1|$ and
   392	 %every edge of $M_2$ contains at least two vertices of $\cup_{i=1}^k(A_i'-V(M_1))$,
   393	%\begin{align}\label{M2-u2}
   394	$$ (k-1) \left(\sum_{i=1}^k |A_i'-V(M_1)-V(M_2)|-l\right)= \left(\sum_{i=1}^k |W_i'-V(M_2)|\right)-(k-l).$$
   395	%\end{align}
   396	
   397	%************************************
   398	
   399	%We show that there exists a matching $M_2$ in $H' - V(M_1)$ and $l\in [k-1]$ such that $|M_2|\le |M_1|$ and both (\ref{M2-u2}) and the following hold.
   400	%\begin{align*}\label{M2-up}
   401	%\sum_{i=1}^k |W_i'-V(M_2)| \le (k-1) \sum_{i=1}^k |A_i'-V(M_1)-V(M_2)|, 
   402	%\end{align*}
   403	
   404	
   405	Since $|V_i - V(M_0')| = k |A_i'|$ (by Claim 2), $|V_i - V(M_0') - A_i'| = (k-1)|A_i'|$.
   406	So $(k-1) \sum_{i = 1}^k |A_i'| = \sum_{i = 1}^k |V_i - V(M_0') -
   407	A_i'|$.  
   408	Moreover, since each edge of $M_1$ contains
   409	at most one vertex of $A'=\cup_{i=1}^k A_i'$,  $(k-1) \sum_{i=1}^k |A_i' \cap V(M_1)| =  (k-1) |A' \cap V(M_1)| \leq |(V(H) - V(M_0') - A') \cap V(M_1)| = \sum_{i=1}^k |(V_i - V(M_0') - A_i') \cap V(M_1)|$.
   410	Thus, 
   411	\begin{equation*}\label{sum-M2-up}
   412	\begin{split}
   413	(k-1)\sum_{i=1}^k |A_i'-V(M_1)|  &= (k-1) \sum_{i=1}^k (|A_i'| - |A_i' \cap V(M_1)|) \\
   414	&= (k-1) \sum_{i=1}^k |A_i'| -(k-1)\sum_{i=1}^k|A_i'\cap V(M_1)|\\
   415	&\geq \left(\sum_{i=1}^k|V_i-V(M_0')-A_i'|\right) - \left( \sum_{i=1}^k |(V_i - V(M_0') - A_i') \cap V(M_1)| \right)\\
   416	&= \sum_{i=1}^k|V_i-V(M_0')-A_i'-V(M_1)|.
   417	\end{split}
   418	\end{equation*}
   419	
   420	
   421	
   422	
   423	%\begin{align}\label{sum-M2-up}
   424	%(k-1)\sum_{i=1}^k |A_i'-V(M_1)|\ge \sum_{i=1}^k|V_i-V(M_0')-A_i'-V(M_1)|.
   425	%\end{align}
   426	Recall that $D_i\subseteq V(M_1)$; so we have 
   427	%\begin{align*}%\label{sum-M2-eq}
   428	$W_i'= V_i-V(M_0')-A_i'-V(M_1).$
   429	%\end{align*}
   430	Therefore,  we get 
   431	\begin{align*}%\label{Ai-more}
   432	(k-1)\sum_{i=1}^k |A_i'-V(M_1)|\ge \sum_{i=1}^k |W_i'|
   433	\end{align*}
   434	%We pick such a matching $M_2$ by greedily.
   435	
   436	We now construct the desired matching $M_2$ greedily, starting with the empty matching $R_0 = \emptyset$. 
   437	By the above expression, we have  
   438	% by (\ref{Ai-more}),
   439	\begin{align*}
   440	\Delta_0:= (k-1) \sum_{i=1}^k |A_i'-V(M_1)-V(R_0)|-\sum_{i=1}^k |W_i'-V(R_0)| \ge 0.
   441	\end{align*}
   442	Moreover, since $(k-1) \sum_{i = 1}^k |A_i'| = \sum_{i = 1}^k |V_i - V(M_0') -
   443	A_i'|$, 
   444	$$\Delta_0 \le \sum_{i=1}^k |V(M_1)\cap V_i| \le k|M_1|.$$
   445	%\begin{eqnarray*}
   446	%\Delta_0&=&\sum_{i=1}^k|V_i-V(M_0')-A_i'| -\sum_{i=1}^k |W_i'|\\
   447	%&=&\sum_{i=1}^k|V_i-V(M_0')-A_i'-W_i'|\\
