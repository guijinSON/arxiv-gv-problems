   490	\end{equation*}
   491	%$$d_{H' - V(M_1) - V(R_j)}(\{v_1, ..., v_{k-1}\}) \geq \delta_{k-1}(H' - V(M_1) - V(R_j)) \geq n/k - k(\varepsilon n + 1) - k(\varepsilon + \gamma)n - k(\varepsilon + \gamma)n > 1.$$
   492	Hence, there exists $v_k \in V_k - V(M_0') - V(M_1) - V(R_j)$ such that $e_{j+1} := \{v_1,v_2,...,v_k\} \in E(H' - V(M_1) - V(R_j))$.
