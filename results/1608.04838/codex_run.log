+def _random_invertible_rows(rank: int, rng: random.Random) -> list[int]:
+    rows = [1 << i for i in range(rank)]
+    for _ in range(8 * rank):
+        i = rng.randrange(rank)
+        j = rng.randrange(rank - 1)
+        if j >= i:
+            j += 1
+        rows[i] ^= rows[j]
+    return rows
