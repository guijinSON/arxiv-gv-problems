+        final = 0
+        for value in chosen:
+            final ^= value
+        if final != distinguished and final not in chosen:
+            targets = list(chosen) + [final, distinguished]
+            rng.shuffle(targets)
+            return targets
+    raise RuntimeError("could not compose a distinct target set with the required XOR")
