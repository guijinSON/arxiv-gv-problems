+        "sampling_wall_seconds": sample_wall,
+    }
+
+    reference_successes = 0
+    reference_operations = 0
+    reference_start = time.perf_counter()
+    for seed in range(8):
+        inst = make_instance(seed=10_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
