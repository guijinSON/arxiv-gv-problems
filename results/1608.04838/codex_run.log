+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Construct a certified S-absorbing edge by composing XOR identities."""
+    d = int(n)
+    rank = int(params.pop("rank", max(2, min(16, d - 2))))
+    target_count = int(params.pop("target_count", 18))
