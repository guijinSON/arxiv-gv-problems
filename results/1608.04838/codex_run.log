   574	\[
   575	\frac{d_{F_1}(x)}{({\color{black}|A_1''|)}^{k-1}}+\frac{d_{F_1}(S)}{|A_1''|}
   576	\geq 0.9+\frac{d_{F_1}(S)}{n/k}>0.9+(1-4k^2\varepsilon)>3/2,
