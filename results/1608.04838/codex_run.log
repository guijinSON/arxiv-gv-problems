+def _make_targets(rank: int, count: int, distinguished: int, rng: random.Random) -> list[int]:
+    """Compose a target set T with distinguished in T and XOR(T)=distinguished."""
+    limit = 1 << rank
+    for _ in range(10_000):
+        chosen: set[int] = set()
+        while len(chosen) < count - 2:
