+_KEY_CACHE: dict[tuple, str] = {}
+_PERM_TABLE_CACHE: dict[tuple[int, ...], tuple[tuple[int, ...], ...]] = {}
+_INVERSE_PERM_CACHE: dict[tuple[int, ...], tuple[int, ...]] = {}
