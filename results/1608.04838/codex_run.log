+    return _ROWS_CACHE[key]  # type: ignore[return-value]
+
+
+def _vectors(inst: dict) -> tuple[int, int, int, int]:
+    cached = _OBJECT_CACHE.get(id(inst))
+    if cached is not None and cached[0] is inst and cached[3]:
+        return cached[3]
