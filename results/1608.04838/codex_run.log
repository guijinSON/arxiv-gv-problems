codex
The hardening service is currently refusing every vendor call with OpenRouter HTTP 403 “Key limit exceeded,” so no scored oracle attempt or hardened verdict can be produced in this environment. I’m preserving those genuine script-generated error transcripts and finishing the local verification and documentation; I won’t misreport the API failure as model hardness evidence.
exec
/bin/bash -lc "python3 - <<'PY'
import copy, json, os, random
import gen_1608_04838 as g
p=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
i=g.make_instance(seed=123456,**p)
a=copy.deepcopy(i['answer'])
del i['answer']
assert g.verify(i,a)==(True,'ok')
ref,ops=g._reference_algorithm(i)
assert g.verify(i,ref)==(True,'ok')
assert json.loads(json.dumps(a))==a
assert g.parse_answer('prose\\n<answer>"'```json'"\\n'+json.dumps(a)+'\\n"'```</answer>'"\\nmore')==a
assert g.parse_answer('garbage') is None
k1=g.canonical_key(i); k2=g.canonical_key(i); assert k1==k2
for mode,count in [(None,0),('structural',1),('placebo',1)]:
    if mode is None: os.environ.pop('GV_HINT_MODE',None)
    else: os.environ['GV_HINT_MODE']=mode
    statement=g.render(i)
    assert statement.count('Hint:')==count
    assert '<answer></answer>' in statement
    assert statement.endswith('Output nothing else inside the tags.')
print('independent_verify_without_answer=ok')
print('reference_verify=ok operations=',ops)
print('parse_and_json_roundtrip=ok')
print('canonical_determinism=ok',k1)
print('hint_lengths=',len(g.STRUCTURAL_HINT),len(g.PLACEBO_HINT))
print('answer_chars=',len(json.dumps(a,separators=(',',':'))),'atoms=',len(a))
