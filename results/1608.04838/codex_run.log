+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON 3-by-d binary matrix [x,y,z], one GF(2)^d vertex from each "
+        "labeled part, required up front to be disjoint from S and to be an edge."
+    ),
+    "bounds": {
+        "rows": 3,
+        "columns": "exactly the instance dimension d=n",
+        "entries": [0, 1],
+        "structural_constraints": "disjoint from S and already a hyperedge",
+    },
+}
