   483	\begin{split}
   484	d_{H' - V(M_1) - V(R_j)}(\{v_1, ..., v_{k-1}\})
   485	&\geq \delta_{k-1}(H' - V(M_1) - V(R_j)) \\
   486	&\geq n/k - |M_0'| - |M_1| - |R_j| \\
   487	&\geq n/k - k(\varepsilon n + 1) - k(\varepsilon + \gamma)n - k(\varepsilon + \gamma)n \\
   488	&> 1.
