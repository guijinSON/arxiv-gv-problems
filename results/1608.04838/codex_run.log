+    for functional in range(1 << inst["rank"]):
+        target_weight = sum(
+            (functional & target).bit_count() & 1 for target in targets
+        )
+        delta_bit = (functional & delta_a).bit_count() & 1
+        affine_bit = (functional & affine_s).bit_count() & 1
+        # Swapping a and a' sends affine_s to affine_s xor delta_a.  When
+        # delta_bit is one, the unordered pair of evaluations is always {0,1}.
+        affine_orbit = affine_bit if delta_bit == 0 else 2
+        histogram[(target_weight, delta_bit, affine_orbit)] += 1
+    payload = (inst["n"], inst["rank"], inst["target_count"], sorted(histogram.items()))
+    digest = hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
+    _KEY_CACHE[cache_key] = digest
+    return (digest,)
