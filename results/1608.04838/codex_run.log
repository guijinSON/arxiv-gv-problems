+    }
+
+    attacks = {
+        "outlier_minimum_hamming_weight": {"successes": 0, "attempts": 8},
+        "greedy_complete_lowest_edge": {"successes": 0, "attempts": 8},
+        "random_restart_256_edges": {"successes": 0, "attempts": 8},
+        "by_hand_raw_coordinate_xor": {"successes": 0, "attempts": 8},
+    }
+    for seed in range(8):
