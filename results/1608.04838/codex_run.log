+    out["S"] = {
+        "V1": [_bits(a ^ t1, d), _bits(aa ^ t1, d)],
+        "V2": _bits(b ^ t2, d),
+        "V3": _bits(c ^ t3, d),
+    }
+    answer_values = _candidate_ints(inst, inst["answer"])
+    moved = (
+        answer_values[0] ^ t1,
+        answer_values[1] ^ t2,
+        answer_values[2] ^ t3,
+    )
+    out["answer"] = [_bits(value, d) for value in moved]
+    return out
