   568	    rank = len(rows)
   569	    work = rows[:]
   570	    transform = [1 << i for i in range(rank)]
   571	    pivots = []
   572	    operations = 0
   573	    pivot_row = 0
   574	    for column in range(d):
   575	        pivot = next((i for i in range(pivot_row, rank) if (work[i] >> column) & 1), None)
