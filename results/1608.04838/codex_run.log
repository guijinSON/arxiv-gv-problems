+
+def _from_bits(row: object) -> int | None:
+    if not isinstance(row, list):
+        return None
+    value = 0
+    for i, bit in enumerate(row):
+        if not isinstance(bit, int) or isinstance(bit, bool) or bit not in (0, 1):
+            return None
+        value |= bit << i
+    return value
