   585	\section{Hypergraphs without large independent sets}
   586	
   587	In this section, we prove Theorem \ref{main} for the case when $H$
   588	does not contain large independent sets.
   589	First, we consider the case when
   590	the minimum co-degree is slightly below $n/k$.
   591	
   592	\begin{lemma}
   593	\label{almost-matching-non-extremal-new}
   594	Let $\beta$ be a constant with $0 < \beta < 1/2k^2$ and let $k>0$ be an integer.
   595	Let $H$ be a  $k$-partite $k$-graph with partition classes  $V_1,\ldots,V_k$ such that $|V_i| = n$ for $i \in [k]$.
   596	Suppose $\delta_{k-1}(H) > (1-\beta) (n/k)$ and $H$ is not $(k^2\beta)$-extremal.
   597	Then $\nu(H)\ge n-k^2$.
   598	\end{lemma}
   599	
   600	
   601	\pf Let $M:=\{e_1,e_2,...,e_m\}$ be a maximum matching in $H$; so
   602	$m=\nu(H)$.
   603	Let $U := V(H) - V(M)$. We may assume $m<n-k^2$. Then  $|U\cap V_i|
   604	> k^2$ for $i\in [k]$. By the maximality of
   605	$|M|$,  $U$ is independent in $H$.
   606	Thus, there exist $k^2$ pairwise disjoint legal sets $A_i^j\in {U\choose
   607	  k-1}$, $i,j \in [ k]$, such that $A_i^j \cap V_j =
   608	\emptyset$.
   609	For $j \in [k]$, let  $$C_j:=\{v \in V_j : A_i^j \cup \{v\} \in E(H)
   610	\mbox{ for some } i\in [k]\}$$
   611	and $$D_j: =\{v \in V_j : A_i^j
   612	\cup \{v\} \in E(H) \mbox{ for all $i\in [k]$}\}.$$
   613	 Clearly,  $D_j \subseteq C_j$ for $j \in [k]$.
   614	Let $C= \bigcup_{j \in [k]} C_j$ and $D= \bigcup_{j \in [k]} D_j$.
   615	
   616	
   617	We claim that for $i\in [m]$, $|C\cap e_i|\leq 1$.
   618	For, otherwise, suppose  $|C \cap e_l| \geq 2$ for some $l\in [m]$.
   619	Let $x,y \in C\cap e_l$ be distinct.
   620	By definition of $C$, there exist sets $A_{i_x}^{j_x}$ and
   621	$A_{i_y}^{j_y}$ such that $A_{i_x}^{j_x} \cup \{x\} \in E(H)$ and
   622	$A_{i_y}^{j_y} \cup \{y\} \in E(H)$. Since $x,y\in e_l$ are distinct,
   623	$A_{i_x}^{j_x}\ne A_{i_y}^{j_y}$; so $A_{i_x}^{j_x}\cap A_{i_y}^{j_y}=\emptyset$.
   624	Hence, $(M -\{ e_l\}) \cup \{A_{i_x}^{j_x} \cup \{x\}, A_{i_y}^{j_y}
   625	\cup \{y\} \}$ is a  matching in $H$, whose size is larger than
   626	$|M|=\nu(H)$, a contradiction.
   627	
   628	
   629	
   630	
   631	Since $\delta_{k-1}(H) > (1-\beta) (n/k)$, $|C_j| > (1-\beta)(n/k)$
   632	for $j \in [k]$. Hence, for any $l\in [k]$, $$\sum_{j=1}^k|C_j|>(k-1)(1-\beta)(n/k)+|C_l|.$$
   633	On the other hand, since $|C\cap e_j|\le 1$ and $C_j\cap U=\emptyset$
   634	for $j\in [m]$ (as $U$ is independent), $$\sum_{j=1}^k |C_j|\leq m< n - k^2 <
   635	n.$$
   636	Therefore, for $l\in [k]$,
   637	$$|C_l|<n-(k-1)(1-\beta)(n/k)=(1+(k-1)\beta )(n/k).$$
   638	
   639	
   640	Now we derive  a lower bound on $|D_j|$ for $j \in [k]$.
   641	Since $\delta_{k-1}(H) > (1-\beta) (n/k)$, % and $U$ is independent (so $N(A_i^j)\subseteq V(M)\cap V_j$),
   642	\begin{align*}
   643	\sum_{i=1}^k d_H(A_i^j)> k(1-\beta)(n/k)
   644	\end{align*}
   645	for $j \in [k]$.
   646	On the other hand, for $j\in [k]$, $$\sum_{i=1}^k d_H(A_i^j)\leq
   647	k|D_j|+(k-1)(|C_j|-|D_j|)=|D_j|+(k-1)|C_j|.$$
   648	Since $|C_j|<(1+(k-1)\beta )(n/k)$, we have for $j\in [k]$,  $$\sum_{i=1}^k d_H(A_i^j)< |D_j|+(k-1)(1+(k-1)\beta )(n/k).$$
   649	Thus, for $j\in [k]$,
   650	\[
   651	|D_j|> k(1-\beta)(n/k)-(k-1)(1+(k-1)\beta )(n/k)> (1-k^2\beta)(n/k).
   652	\]
   653	
   654	
   655	Let $V_D := \bigcup_{i\in [m],e_i \cap D \neq \emptyset}e_i$.
   656	Then, since $|D \cap e_i| \leq 1$ for $i \in [m]$,
   657	$$|(V_D \cap V_j) - D_j| \geq \sum_{i \in [k] - \{j\}} |D_i| > (k-1)(1-k^2\beta) (n/k)=(1-k^2\beta) (k-1)(n/k)$$
   658	 for $j \in [k]$.
   659	Since $H$ is not $(k^2\beta)$-extremal (recall this definition from
   660	the paragraph preceding Lemma~\ref{extremal}, $H[V_D - D]$ contains at least one edge, say $e_0$.
   661	Let $e_{m_1}, ...,e_{m_l}$ be the edges  in $M$ intersecting
   662	$e_0$, where  $l\in [k]$. For each $s\in [l]$, since $e_{m_s}\cap e_0\ne \emptyset$
   663	and $e_0\subseteq V_D-D$, $e_{m_s}\cap e_0\subseteq V_D-D$, which, together with the definition of $V_D$, implies $e_{m_s}\cap D\ne \emptyset$. So
   664	let $v_{m_s}\in e_{m_s} \cap D$ for  $s \in [l]$.
   665	
   666	Since $l\le k$,
   667	$|\{v_{m_1},\ldots, v_{m_l}\}\cap V_j|\le k$  for $j\in [k]$. Hence, it follows from the  definition of $D$ that
   668	there exist pairwise distinct (hence, disjoint) $A_{i_1}^{j_1},A_{i_2}^{j_2},...,A_{i_l}^{j_l}$ such that $A_{i_s}^{j_s} \cup \{v_{m_s}\} \in E(H)$ for $s \in [l]$.
   669	Therefore, $(M - \{e_{m_s}:s\in [l]\}) \cup \{A_{i_s}^{j_s} \cup
   670	\{v_{m_s}\}: s\in [l]\} \cup \{e_0\}$ is a matching in $H$ whose size
   671	is larger than $|M|=\nu(H)$, a contradiction.
   672	\qed
   673	
   674	\medskip
   675	
   676	
   677	Next, we introduce a convenient concept which we will use to augment a
   678	matching. Let $H$ be a $k$-partite $k$-graph with  partition classes
   679	$V_1,\ldots,V_k$ such that $|V_i| = n$ for $i \in [k]$. A set $S\in
   680	{V(H)\choose k+1}$ is said to be of \textit{type $j$} if $|S\cap V_j|=2$ and
   681	$|S\cap V_i|=1$ for $i\in [k]-\{j\}$. For a set $S$ of type $j$, an edge $e\in E(H)$ is said to
   682	be {\it $S$-absorbing} if the following holds: there exist $r \in [k]
   683	- \{j\}$ and $v\in S\cap V_j$ such that $e \cap S = \emptyset$, $S_e:=(S-\{v\}-V_r)\cup (e\cap
   684	V_r)\in E(H)$ and $e_S:=(e-V_j-V_r)\cup \{v\}\cup (S\cap V_r)\in
   685	E(H)$.
   686	
   687	Note that if $M$ is a matching in $G$ and $e\in M$ is $S$-absorbing
   688	for some $S$ of type $j$ such that $S \cap V(M)  =\emptyset$ then
   689	$(M-\{e\})\cup \{S_e,e_S\}$ is also a matching in $H$.
   690	
   691	
   692	We now show that minimum co-degree conditions on three types of legal
   693	$(k-1)$-sets will guarantee many $S$-absorbing edges for a set $S$ of type $j$.
   694	
   695	\begin{lemma}
   696	\label{absorbing-counting}
   697	Let $c$ be a real number with $0<c<1$, let  $k,n$ be integers with $k\ge 3$ and $n$ sufficiently large, and
   698	let $H$ be a $k$-partite $k$-graph with partition classes
   699	$V_1,\ldots,V_k$ such that $|V_i| = n$ for $i \in [k]$.
   700	%Let $c>0$ be a constant and suppose $n$ is sufficiently large.
   701	Let $r,s,t\in [k]$ be distinct and assume $\delta_{k-1}(e) \geq cn$ for any  legal
   702	$e\subseteq  \bigcup_{j \in [k] - \{i\} } V_j$ for $i \in \{r,s,t\}$.
   703	Then for any  $S$ of type $j$ with $j\in
   704	\{r,s,t\}$, the number of $S$-absorbing edges in $H$  is at least $c^3n^k/2$.
   705	\end{lemma}
   706	
   707	\pf
   708	Without loss of generality, we may assume that $j=s=1$, $r=2$ and $t=k$.
   709	Let $S = \{v_1,v_2,\ldots,v_k,{\color{black}v_1'}\}$ such that ${\color{black}v_1'\in V_1}$ and $v_i\in
   710	V_i$ for $i\in [k]$. So $S$ is a set of type $j=1$. We count
   711	$S$-absorbing edges $\{u_1,\ldots, u_k\}$ by choosing vertices
   712	$u_i\in V_i$ for $i\in [k]$.
   713	
   714	
   715	First, we choose $u_i \in V_i - \{v_i\}$ for $i\in [k]-\{1,2,k\}$
   716	arbitrarily. So the number of choices for $\{u_i: in [k]-\{1,2,k\}$ is $(n-1)^{k-3}$.
   717	
   718	Note that  $\delta_{k-1}(e) \geq cn$ for any legal
   719	$e\subseteq \bigcup_{j \in [k] - \{k\} } V_j$. Hence, for a given choice
   720	of  $\{u_i: in [k]-\{1,2,k\}$ is $(n-1)^{k-3}$, we have at least $cn - 1$ choices of $u_k \in V_k - \{v_k\}$ such
   721	that $\{v_1',v_2,u_3,\ldots,u_k\} \in E(H)$. 
   722	
   723	
   724	Since $\delta_{k-1}(e) \geq cn$ for any legal   $e\subseteq \bigcup_{j \in [k] - \{2\} } V_j$,
   725	we have at least  $cn - 1$
   726	choices for $u_2 \in V_2 - \{v_2\}$ such that
   727	$\{v_1,u_2,v_3, \ldots,v_k\} \in E(H)$.
   728	
   729	Again, note that $\delta_{k-1}(e) \geq cn$ for any legal $e \subseteq\bigcup_{j \in [k] - \{1\} }
   730	V_j$. So for a given choice of $\{u_2,\ldots, u_k\}$, we have at least $cn - 2$ choices for $u_1 \in V_1 -
   731	\{v_1,v_1'\}$ such that $\{u_1,u_2,\ldots,u_k\} \in E(H)$.
   732	
   733	It is easy to verify that each $\{u_1,u_2,u_3,\ldots,u_k\}$ chosen above is $S$-absorbing.
   734	Therefore, the number of $S$-absorbing edges in $H$ is at least $$(cn -
   735	1)^2(cn - 2)(n-1)^{k-3},$$ 
   736	which is at least  $c^3n^k/2$ for large $n$.
   737	\qed
   738	
   739	\medskip
   740	
   741	
   742	We need Chernoff bounds in the lemma below, whose proof can be found in \cite{mitzenmacher}.
   743	
   744	\begin{lemma}
   745	\label{chernoff}
   746	Suppose $X_1, ..., X_n$ are independent random variables taking values in $\{0, 1\}$. Let $X$ denote their sum and $\mu = \mathbb{E}[X]$ denote the expected value of $X$. Then for any $0 < \delta \leq 1$,
   747	$$\mathbb{P}[X \leq (1-\delta) \mu] < e^{-\frac{\delta^2 \mu}{2}}$$
   748	\end{lemma}
   749	
   750	
   751	
   752	Analogous to Fact 2.3 in \cite{Rod09},
   753	we prove a stronger version of the absorbing lemma for $k$-partite $k$-graphs.
   754	
   755	
   756	\begin{lemma}
   757	\label{absorbing}
   758	For any constant $c > 0$, there exists an integer  $n_0 > 0$ with the following
   759	property: If $H$ is a $k$-partite $k$-graph with partition classes
   760	$V_1,\ldots,V_k$ such that $|V_i| = n \geq n_0$ (for $i \in [k]$) and
   761	 $\delta_{k-1}(H) \geq cn$,
   762	then
   763	there is a matching $M'$ in $H$ such that $|M'|\le (32/c^3)(k+2)\log n$ and,
   764	 for any $j\in [k]$ and any set $S$ of type $j$, at least
   765	 $4(k+2)\log n$ edges in $M'$ are $S$-absorbing.
   766	\end{lemma}
   767	
   768	
   769	
   770	\pf Let $C = 32(k+2)/c^3$. Form the set $M'\subseteq E(H)$ by
   771	choosing each edge of $H$  independently and  uniformly at random with probability $p = (C/2) n^{-k} \log n $.
   772	Thus, $\mathbb{E}[|M'|] =|E(H)|p\le n^k p = (C/2) \log n$.
   773	
   774	The number of ordered intersecting pairs of edges in $E(H)$ is at most
   775	$n^k (k n^{k-1})=kn^{2k-1}$; so
   776	the expected number of ordered intersecting pairs of edges in $M'$ is at most $$kn^{2k-1} p^2 = kC^2 \log^2 n/(4n) = o(1).$$
   777	By Markov's inequality, with probability strictly larger than $1/3$, $M'$ is a matching of size at most $C \log n$.
   778	
   779	For a set $S$ of type $j$ with $j\in [k]$, let $X_S$ denote the number of $S$-absorbing edges in $M'$.
   780	Then by Lemma \ref{absorbing-counting}, we have
   781	$$\mathbb{E}[X_S] \geq (c^3n^k/2) p = 8(k+2)\log n.$$
   782	By Lemma~\ref{chernoff},
   783	$$\mathbb{P}[X_S \leq \ \mathbb{E}[X_S] /2] \leq \exp(-
   784	\mathbb{E}[X_S]/8) = \exp(-(k+2)\log n) = n^{-(k+2)}.$$
   785	
   786	Since there are at most $kn^{k+1}$ sets $S$ of type $j$ for all $j\in
   787	[k]$, it follows from union bound that,  with probability strictly larger than $1/4$,
   788	 $X_S\ge \mathbb{E}[X_S]/2 \geq 4(k+2)\log n$  for all sets
   789	 $S$ of type $j$ and for all $j\in [k]$. Thus, the desired $M'$
   790	 exists.
   791	\qed
   792	
   793	
   794	\medskip
   795	
   796	We now prove Theorem~\ref{main} for the case when $H$ does not
   797	have  large independent sets. Recall the definition of
   798	$\gamma$-extremal from the paragraph preceding Lemma~\ref{extremal}.
   799	
   800	\begin{lemma}

