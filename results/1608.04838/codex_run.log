+    return _TARGET_CACHE[key]  # type: ignore[return-value]
+
+
+def _cache_instance(
+    inst: dict,
+    rows: tuple[int, ...] | None = None,
+    targets: tuple[int, ...] | None = None,
+    s_values: tuple[int, int, int, int] | None = None,
