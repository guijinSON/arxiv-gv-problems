+    "easy": {"n": 28, "rank": 11, "target_count": 7},
+    "medium": {"n": 52, "rank": 15, "target_count": 17},
+    "hard": {"n": 80, "rank": 16, "target_count": 17},
+}
+SHIPPING_DIFFICULTY = "hard"
+
