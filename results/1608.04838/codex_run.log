+    shifts = rng.sample(range(d), 3)
+    permutations = [[(j + shift) % d for j in range(d)] for shift in shifts]
+
+    limit = 1 << d
+    for _ in range(1000):
+        a = rng.randrange(limit)
+        aa = rng.randrange(limit)
+        if aa == a:
+            continue
+        b = rng.randrange(limit)
+        c = rng.randrange(limit)
