+    out["permutations"][1], out["permutations"][2] = (
+        out["permutations"][2], out["permutations"][1]
+    )
+    out["answer"][1], out["answer"][2] = out["answer"][2], out["answer"][1]
+    out["targets"].reverse()
+    return out
