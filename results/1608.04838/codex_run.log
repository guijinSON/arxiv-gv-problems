   462	So we may assume that  for each $l\in [k-1]$,
   463	\begin{align*} %\label{M2-ind2}
   464	f(l) := 
   465	(k-1) \sum_{i=1}^k |A_i'-V(M_1)-V(R_j)| - \sum_{i=1}^k |W_i'-V(R_j)| -k(l-1) =\Delta_l-k(l-1)\ne 0.
   466	\end{align*}
   467	%Let $f(l): = (k-1) (\sum_{i=1}^k |A_i'-V(M_1)-V(R_j)|-l) - \sum_{i=1}^k |W_i'-V(R_j)| + (k-l).$
   468	%for any integer $l$, 
   469	Note that $f(l) \equiv 0 \pmod k$, since $f(l)$ can be written as
   470	$$k (\sum_{i=1}^k |A_i'-V(M_1)-V(R_j)| ) - \sum_{i=1}^k (|A_i'-V(M_1)-V(R_j)| + |W_i'-V(R_j)|) - k(l-1),$$
   471	and $|A_i'-V(M_1)-V(R_j)| + |W_i'-V(R_j)|$ are the same for all  $i \in [k]$.
   472	Moreover, $f(l+1)=f(l)-k$ for all integers $l$. 
