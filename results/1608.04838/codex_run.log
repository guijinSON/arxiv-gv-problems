+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_operations <= 300
+    arms = {name: dict(G9_ORACLE_RESULTS[name]) for name in ("bare", "hinted", "placebo")}
+    hinted_attempts = arms["hinted"]["attempts"]
