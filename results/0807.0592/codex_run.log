    #                  monomial basis, rational coefficients with |num|,|den| < 2^32"
    #  "bounds":      the numeric bounds that make it finite, e.g.
    #                 {"n_squares": 6, "max_degree": 4, "basis": 45, "coeff_bits": 32}}
