+        "candidate_prior": "uniform over every k!-multiple in [0, falling(|E|,k)]",
+    }
+
+    reference_times = []
+    reference_operations = []
+    reference_divisions = []
+    for seed in range(8):
+        inst = make_instance(seed=10_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        started = time.perf_counter()
