+    report["G8_canonical_key"] = {
+        "pass": (
+            invariant_checks == 60
+            and carried_witness_checks == 20
+            and len(keys) == 20
+        ),
+        "invariance_checks": invariant_checks,
+        "relabelled_witness_checks": carried_witness_checks,
+        "unrelated_seeds": len(distinct_seeds),
+        "distinct_keys": len(keys),
+        "transformations": [
