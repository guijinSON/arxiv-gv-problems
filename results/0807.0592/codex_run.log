+    arms = G9_RESULTS["arms"]
+    hinted_verdict = G9_RESULTS["hinted_verdict"]
+    within_caps = (
+        len(answer_blob) <= 2000
+        and _answer_atoms(shipping["answer"]) <= 256
+        and compact_operations <= 300
