def _validate_params(n: int, chains: int, side: int, spacing_span: int) -> None:
    vals = (n, chains, side, spacing_span)
    if any(isinstance(v, bool) or not isinstance(v, int) for v in vals):
        raise ValueError("n, chains, side, and spacing_span must be integers")
    if n < 7:
        raise ValueError("n must be at least 7")
    if chains < 2 or 3 * chains > n:
        raise ValueError("chains must be at least 2 and leave at least 3 flaps per chain")
    if side < 4:
        raise ValueError("side must be at least 4")
    available = side - (side // 2 + 1)
    if spacing_span < 1 or spacing_span > available + 1:
        raise ValueError("spacing_span does not fit strictly between side/2 and side")


def _composition(n: int, chains: int, rng: random.Random) -> list[int]:
    """A random composition with every part at least three."""
    lengths = [3] * chains
    for _ in range(n - 3 * chains):
        lengths[rng.randrange(chains)] += 1
    rng.shuffle(lengths)
    return lengths


def _coprime_step(n: int, rng: random.Random) -> int:
    while True:
        step = rng.randrange(1, n)
        if math.gcd(step, n) == 1:
            return step


def make_instance(
    n: int,
    seed: int = 0,
    chains: int = 8,
    side: int = 10,
    spacing_span: int = 4,
    **params: Any,
) -> dict:
    """Inverse-generate a native flaps-and-flips sequence instance.

    The affine answer permutation is sampled first.  Consecutive segments of
    it are then realized as disjoint integer-coordinate edge-gadget chains.
    """
    if params:
        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
    _validate_params(n, chains, side, spacing_span)
    rng = random.Random(seed)

    step = _coprime_step(n, rng)
    offset = rng.randrange(n)
    answer = [(offset + step * i) % n for i in range(n)]
    lengths = _composition(n, chains, rng)

    directions = ["R", "L"] + [rng.choice(("R", "L")) for _ in range(chains - 2)]
    rng.shuffle(directions)
    # Keep both orientations present so a single global-coordinate sort is
    # never accidentally a valid witness.
    if len(set(directions)) != 2:
        directions[0], directions[1] = "R", "L"

    global_x = rng.randrange(-7 * n, 7 * n + 1)
    global_y = rng.randrange(-7 * n, 7 * n + 1)
    min_spacing = side // 2 + 1
    max_spacing = min(side - 1, min_spacing + spacing_span - 1)

    flaps: list[dict[str, int | str]] = []
    cursor = 0
    first_pair: list[dict[str, int | str]] | None = None
    for row, (length, start_side) in enumerate(zip(lengths, directions)):
        spacings = [rng.randint(min_spacing, max_spacing) for _ in range(length - 1)]
        xs = [global_x + rng.randrange(-2 * n, 2 * n + 1)]
        for gap in spacings:
            xs.append(xs[-1] + gap)
        y = global_y + row * (3 * side)
        ordered_xs = xs if start_side == "R" else list(reversed(xs))
        target_side = "L" if start_side == "R" else "R"
        row_flaps = []
        for j, x in enumerate(ordered_xs):
            row_flaps.append({
                "label": answer[cursor + j],
                "x": x,
                "y": y,
                "start": start_side,
                "target": target_side,
            })
        if first_pair is None:
            first_pair = row_flaps[:2]
        flaps.extend(row_flaps)
        cursor += length

    assert first_pair is not None and cursor == n
    clue_labels = {int(f["label"]) for f in first_pair}
    tail = [f for f in flaps if int(f["label"]) not in clue_labels]
    rng.shuffle(tail)
    shown = [dict(first_pair[0]), dict(first_pair[1])] + [dict(f) for f in tail]

    return {
        "n": n,
        "side": side,
        "label_modulus": n,
        "flaps": shown,
        "answer": answer,
    }


