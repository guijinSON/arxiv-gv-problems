+        "random_certificate_restart_256": {"successes": 0, "attempts": 8},
+    }
+    for seed in range(8):
+        inst = make_instance(seed=20_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        target, _metrics = _reference_count(inst)
