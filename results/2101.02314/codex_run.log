+    rng = random.Random(seed)
+    flat_basis = _independent_basis(width, _FLAT_DIMENSION, rng)
+    linear_flat = set(_span(flat_basis))
+    if len(linear_flat) != _SUMMANDS:
+        raise AssertionError("internal affine-flat construction failed")
