+
+
+def _candidate_coefficient(mask_signs, decoded, left, right):
+    difference = left ^ right
+    return mask_signs[left] * mask_signs[right] * sum(
+        scale * scale * _character(frequency, difference)
+        for frequency, scale in decoded
+    )
+
