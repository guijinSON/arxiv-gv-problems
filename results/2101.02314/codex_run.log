+
+def _random_linear_rows(width, rng):
+    rows = [1 << i for i in range(width)]
+    for _ in range(4 * width):
+        left, right = rng.sample(range(width), 2)
+        if rng.randrange(2):
+            rows[left], rows[right] = rows[right], rows[left]
+        else:
+            rows[left] ^= rows[right]
+    return rows
+
