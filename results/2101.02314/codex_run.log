+        "magnitudes expose an annihilator subspace; without that invariant one "
+        "must perform a full Walsh recovery or the paper's Gram/SDP computation."
+    ),
+    "hardness_basis": (
+        "Track B: Section 5.5 gives coefficient-matching semidefinite "
+        "optimization; the faster reference algorithm for this signed "
+        "translation-invariant subfamily is an exact Walsh-Hadamard recovery in "
+        "O(N log N), measured at shipping N=128 below by selftest, whereas the "
+        "annihilator shortcut stays below 300 exact operations."
+    ),
+    "max_answer_tokens": 120,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 8, "scale_max": 9},
+    "easy": {"n": 32, "scale_max": 10_000},
+    "medium": {"n": 64, "scale_max": 100_000},
+    "hard": {"n": 128, "scale_max": 1_000_000},
+}
