+        ],
+        "by_hand_low_hamming_weight": [
+            _answer_from_parts(mask, low_weight, special, scale, width)
+        ],
+        "obvious_nearest_frequency_ansatz": [
+            _answer_from_parts(mask, near_special, special, scale, width)
