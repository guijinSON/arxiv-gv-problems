+        "mask": "".join("+" if value == 1 else "-" for value in mask_signs),
+        "summands": [
+            {"frequency": _bits(frequency, width), "scale": scale}
+            for frequency, scale in decoded
+        ],
+    }
+    return answer, operations
+
