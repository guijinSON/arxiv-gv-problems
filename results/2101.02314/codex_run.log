+        "summands": [
+            {"frequency": _bits(freq, inst["bit_dimension"]), "scale": scale}
+            for freq, scale in sorted(decoded)
+        ],
+    }
+    out = dict(inst)
+    out["coefficients"] = coefficients
+    out["answer"] = carried
+    return out, carried
