+def _rref_basis(vectors):
+    pivots = {}
+    operations = 0
+    for original in vectors:
+        value = original
+        while value:
+            pivot = value.bit_length() - 1
+            if pivot in pivots:
+                value ^= pivots[pivot]
+                operations += 1
+            else:
