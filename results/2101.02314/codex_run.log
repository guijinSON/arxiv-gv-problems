+        "optimization; the faster reference algorithm for this signed "
+        "translation-invariant subfamily is an exact Walsh-Hadamard recovery in "
+        "O(N log N), measured at shipping N=128 below by selftest, whereas the "
+        "annihilator shortcut stays below 300 exact operations."
+    ),
+    "max_answer_tokens": 120,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
