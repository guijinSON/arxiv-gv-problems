+    "hinted_minus_placebo": 0.0,
+    "hinted_verdict": "hardened",
+    "answer_chars": 428,
+    "answer_tokens": 107,
+    "answer_elements": 192,
+    "intended_route_operations": 179
+  },
+  "all_passed": true
+}

