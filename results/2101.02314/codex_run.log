+
+STRUCTURAL_HINT = (
+    "The signed XOR-difference kernel has a two-level magnitude pattern on an "
+    "annihilator subspace."
+)
+PLACEBO_HINT = (
+    "The dense coefficient table rewards careful tracking of every binary label "
+    "and sign."
+)
+
