+def _rref_basis(vectors):
+    pivots = {}
+    operations = 0
+    for original in vectors:
+        value = original
+        while value:
+            pivot = value.bit_length() - 1
+            if pivot in pivots:
+                value ^= pivots[pivot]
+                operations += 1
+            else:
+                pivots[pivot] = value
+                break
+    for pivot in sorted(pivots):
+        row = pivots[pivot]
+        for other in list(pivots):
+            if other != pivot and (pivots[other] >> pivot) & 1:
+                pivots[other] ^= row
+                operations += 1
+    return pivots, operations
+
