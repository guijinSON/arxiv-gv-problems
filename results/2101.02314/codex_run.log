+# Patched only from script-owned hardening transcripts.  The default values are
+# conservative failures, so an unrun module cannot claim the external G9 gate.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 1, "attempts": 3},
+    "hinted": {"solved": 1, "attempts": 3},
