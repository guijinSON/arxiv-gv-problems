+        "structure_aware_space": search_space(guess_inst),
+        "elapsed_sec": guess_elapsed,
+    }
+
+    demo_inst = make_instance(seed=3, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo_inst)
+
+    attack_names = None
+    attack_successes = {}
+    attack_attempts = {}
+    attack_start = time.perf_counter()
