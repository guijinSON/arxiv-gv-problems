+    for left in labels:
+        row = []
+        for right in labels:
+            difference = left ^ right
+            value = sum(
+                weight * weight * _character(freq, difference)
+                for freq, weight in weights.items()
+            )
+            row.append(mask_signs[left] * mask_signs[right] * value)
+        coefficients.append(row)
