+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 8, "scale_max": 9},
+    "easy": {"n": 32, "scale_max": 10_000},
+    "medium": {"n": 64, "scale_max": 100_000},
+    "hard": {"n": 128, "scale_max": 1_000_000},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
