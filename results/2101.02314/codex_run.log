+        "family": "signed Walsh sum of hermitian rational squares",
+        "n": n,
+        "bit_dimension": width,
+        "scale_max": scale_max,
+        "labels": [_bits(label, width) for label in labels],
+        "coefficients": coefficients,
+        "answer": answer,
+    }
+
+
