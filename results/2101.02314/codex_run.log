+        "doubled_verification": doubled_reason,
+    }
+
+    invariant_checks = 0
+    carried_checks = 0
+    invariant_failures = []
+    distinct_keys = []
+    for seed in range(20):
+        base = make_instance(seed=30_000 + seed, **shipping)
+        base_key = canonical_key(base)
