import random,time

def graph(n,seed):
 r=random.Random(seed)
 cyc=list(range(n)); r.shuffle(cyc)
 adj=[set() for _ in range(n)]
 for i,u in enumerate(cyc):
  v=cyc[(i+1)%n]; adj[u].add(v);adj[v].add(u)
 # random perfect matching by retries
 for retry in range(10000):
  rem=list(range(n));r.shuffle(rem); pairs=list(zip(rem[::2],rem[1::2]))
  if all(v not in adj[u] for u,v in pairs): break
 else: raise RuntimeError
 for u,v in pairs:adj[u].add(v);adj[v].add(u)
 return adj

def solve(adj,cap=1000000):
 n=len(adj);nodes=0
 # start every vertex; DFS with dynamic smallest onward degree
 for s in range(n):
  used=[False]*n;used[s]=1;path=[s]
  def dfs(u):
   nonlocal nodes
   nodes+=1
   if nodes>=cap:return None
   if len(path)==n:return path[:]
   cand=[v for v in adj[u] if not used[v]]
   cand.sort(key=lambda v:sum(not used[w] for w in adj[v]))
   for v in cand:
    used[v]=1;path.append(v)
    got=dfs(v)
    if got:return got
    path.pop();used[v]=0
   return None
  got=dfs(s)
  if got:return got,nodes
  if nodes>=cap:break
 return None,nodes
for n in (64,128,240):
 print('n',n)
 for seed in range(8):
  a=graph(n,seed);t=time.perf_counter();p,nodes=solve(a);dt=time.perf_counter()-t
  print(seed,bool(p),nodes,round(dt,4))
