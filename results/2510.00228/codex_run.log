+        },
+        "demo_exact_valid_answers": demo_count,
+        "demo_search_space": search_space(demo),
+        "strongest_attack": {
+            "name": "perfect-matching enumeration with connected-complement test",
+            "wall_clock_sec": round(matching_wall, 6),
+            "nodes": matching_nodes,
+            "attempts": len(attack_seeds),
+            "successes": successes["perfect_matching_complement_200k"],
+        },
