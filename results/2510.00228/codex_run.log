+            guess_hits += 1
+    density_wall = time.perf_counter() - start
+    observed = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
