+
+    response = (
+        "I used the diameter-two antipodal condition and checked every step.\n\n"
+        "```json\n<answer>\n"
+        + json.dumps(planted)
+        + "\n</answer>\n```\nThe list contains each vertex once."
+    )
+    parsed = parse_answer(response)
