import random

def gen(n,seed):
 r=random.Random(seed);m=n//2;U=list(range(m));V=list(range(m,2*m))
 E={(i,m+i) for i in range(m)}|{(i+1 if i+1<m else 0,m+i) for i in range(m)}
 while 1:
  p=list(range(m));r.shuffle(p)
  if all(p[i] not in (i,(i-1)%m) for i in range(m)):break
 E|={(i,m+p[i]) for i in range(m)}
 lab=list(range(n));r.shuffle(lab)
 U2=[lab[x] for x in U];V2=[lab[x] for x in V]
 E2={tuple(sorted((lab[u],lab[v]))) for u,v in E}
 adj=[[] for _ in range(n)]
 for u,v in E2:adj[u].append(v);adj[v].append(u)
 for a in adj:a.sort()
 return adj,U2,V2,E2

def matching(adj,U):
 mr={};ops=0
 for u in sorted(U):
  seen=set()
  def go(x):
   nonlocal ops
   for v in adj[x]:
    ops+=1
    if v in seen:continue
    seen.add(v)
    if v not in mr or go(mr[v]):mr[v]=x;return True
   return False
  if not go(u):return None,ops
 return {tuple(sorted((u,v))) for v,u in mr.items()},ops

def compcycle(adj,M):
 n=len(adj);B=[[v for v in adj[u] if tuple(sorted((u,v))) not in M] for u in range(n)]
 o=[0];prev=-1;u=0
 while 1:
  x=B[u][0] if B[u][0]"'!=prev else B[u][1]
  if x==0:return len(o)==n
  if x in o:return False
  o.append(x);prev,u=u,x
for n in (120,160,200,240):
 print('"'n',n)
 for s in range(20):
  a,U,V,E=gen(n,s);M,ops=matching(a,U);print(int(compcycle(a,M)),end='')
 print()
