import random,time

def gen(n,seed):
 r=random.Random(seed); U=list(range(0,n,2)); V=list(range(1,n,2))
 edges={tuple(sorted((i,(i+1)%n))) for i in range(n)}
 for tries in range(10000):
  pv=V[:];r.shuffle(pv)
  if all(tuple(sorted((u,v))) not in edges for u,v in zip(U,pv)):break
 edges|={tuple(sorted(x)) for x in zip(U,pv)}
 adj=[[] for _ in range(n)]
 for u,v in edges:adj[u].append(v);adj[v].append(u)
 perm=list(range(n));r.shuffle(perm)
 adj2=[[] for _ in range(n)]
 for u in range(n):
  for v in adj[u]:adj2[perm[u]].append(perm[v])
 return adj2

def greedy(adj,rng):
 n=len(adj);s=rng.randrange(n);path=[s];used={s}
 while len(path)<n:
  cand=[v for v in adj[path[-1]] if v not in used]
  if not cand:return None
  # Warnsdorff random ties
  vals=[];best=99
  for v in cand:
   z=sum(w not in used for w in adj[v])
   if z<best:vals=[v];best=z
   elif z==best:vals.append(v)
  v=rng.choice(vals);path.append(v);used.add(v)
 return path
for n in (80,120,160,240):
 print('n',n,flush=True)
 for s in range(8):
  a=gen(n,s);rr=random.Random(1000+s);t=time.perf_counter();hits=0
  for _ in range(256):hits+=greedy(a,rr) is not None
  print(s,hits,round(time.perf_counter()-t,3),flush=True)
