+        elapsed = time.perf_counter() - start
+        matching_wall += elapsed
+        matching_nodes += nodes
+        matching_per_seed_nodes.append(nodes)
+        if _valid_if_any(attack_inst, candidate):
+            successes["perfect_matching_complement_200k"] += 1
+
+    attacks = {
