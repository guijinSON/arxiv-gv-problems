+        "doubled_n": doubled["n"],
+        "build_and_verify_sec": round(time.perf_counter() - start, 6),
+        "verify_reason": doubled_why,
+    }
+
+    invariance_checks = 0
+    transport_checks = 0
+    nontrivial = 0
+    unrelated_keys = []
