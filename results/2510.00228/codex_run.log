import random,time

def gen(n,seed):
 r=random.Random(seed); U=list(range(0,n,2)); V=list(range(1,n,2))
 edges={tuple(sorted((i,(i+1)%n))) for i in range(n)}
 # random derangement matching avoiding cycle neighbors
 for tries in range(10000):
  pv=V[:];r.shuffle(pv)
  if all(tuple(sorted((u,v))) not in edges for u,v in zip(U,pv)):break
 else: raise Exception
 edges|={tuple(sorted(x)) for x in zip(U,pv)}
 adj=[[] for _ in range(n)]
 for u,v in edges:adj[u].append(v);adj[v].append(u)
 perm=list(range(n));r.shuffle(perm)
 adj2=[[] for _ in range(n)]
 for u in range(n):
  for v in adj[u]:adj2[perm[u]].append(perm[v])
 return adj2

def solve(adj,cap=1000000):
 n=len(adj);nodes=0
 # attempt each endpoint start low degree all same
 def dfs(path,used):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  if len(path)==n:return path
  u=path[-1]
  cand=[v for v in adj[u] if not (used>>v)&1]
  cand.sort(key=lambda v:sum(not (used>>w)&1 for w in adj[v]))
  for v in cand:
   rr=dfs(path+[v],used|1<<v)
   if rr:return rr
  return None
 for s in range(n):
  rr=dfs([s],1<<s)
  if rr:return rr,nodes
 return None,nodes
for n in (80,120,160,240):
 print('n',n)
 for s in range(8):
  a=gen(n,s);t=time.perf_counter();p,nodes=solve(a,200000);dt=time.perf_counter()-t
  print(s,bool(p),nodes,round(dt,4))
