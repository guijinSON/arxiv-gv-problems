def attack(I,seed,restarts=256,budget=200000):
 A=I['antipodal_adjacency'];n=I['n'];rng=random.Random(seed);nodes=0
 for r in range(restarts):
  matched=[False]*n;chosen=[];stop=False
  def visit():
   nonlocal nodes,stop
   nodes+=1
   if nodes>budget:stop=True;return None
   us=[u for u in range(n) if not matched[u]]
   if not us:return chosen[:]
   vals=[(sum(not matched[v] for v in A[u]),u) for u in us];m=min(x for x,u in vals);cands=[u for x,u in vals if x==m];u=rng.choice(cands)
   ns=[v for v in A[u] if not matched[v]];rng.shuffle(ns)
   for v in ns:
