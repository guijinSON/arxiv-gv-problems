+            v = ordered[j]
+            if (u - v) % n in (1, n - 1):
+                continue
+            weight = count(a + 1, j) * count(j + 1, b)
+            if weight:
+                choices.append((j, weight))
+                total += weight
+        ticket = rng.randrange(total)
+        for j, weight in choices:
+            if ticket < weight:
+                return (
+                    [(u, ordered[j])]
+                    + draw(a + 1, j)
+                    + draw(j + 1, b)
+                )
+            ticket -= weight
