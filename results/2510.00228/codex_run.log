+        if (b - a) % 2:
+            return 0
+        u = ordered[a]
+        total = 0
+        for j in range(a + 1, b, 2):
+            v = ordered[j]
+            if (u - v) % n in (1, n - 1):
+                continue
+            total += count(a + 1, j) * count(j + 1, b)
+        return total
+
+    def draw(a: int, b: int) -> list[tuple[int, int]]:
+        if a == b:
+            return []
+        u = ordered[a]
