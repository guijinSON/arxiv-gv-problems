+    attack_seeds = list(range(9100, 9108))
+    successes = {
+        "degree_then_label_outlier": 0,
+        "greedy_least_onward": 0,
+        "random_restart_256": 0,
+        "spectral_cycle_seriation": 0,
+        "hamilton_path_dfs_100k": 0,
