p='/home/gson/gvrepo/results/0909.4692/gen_0909_4692.py';s=importlib.util.spec_from_file_location('g',p);g=importlib.util.module_from_spec(s);s.loader.exec_module(g)
def lift(base):
 n=base['n']; E=set()
 for u,v in base['host_edges']:
  E.add(tuple(sorted((u,n+v))));E.add(tuple(sorted((v,n+u))))
 u,v=base['answer'][0],base['answer'][1]
 E.remove(tuple(sorted((u,n+v))));E.remove(tuple(sorted((v,n+u))))
 E.add(tuple(sorted((u,n+u))));E.add(tuple(sorted((v,n+v))))
 # derive planted path by just trace 2factor corresponding base answer edges after switch
 plant_edges=set()
 cyc=base['answer']
 for i,u0 in enumerate(cyc):
  v0=cyc[(i+1)%n]
  if {u0,v0}=={u,v}:continue
  plant_edges.add(tuple(sorted((u0,n+v0))));plant_edges.add(tuple(sorted((v0,n+u0))))
 plant_edges.add(tuple(sorted((u,n+u))));plant_edges.add(tuple(sorted((v,n+v))))
 adj=[[] for _ in range(2*n)]
 for x,y in plant_edges:adj[x].append(y);adj[y].append(x)
 order=[0];prev=-1;cur=0
 while 1:
  nxt=adj[cur][0] if adj[cur][0]"'!=prev else adj[cur][1]
  if nxt==0:break
  order.append(nxt);prev,cur=cur,nxt
 assert len(order)==2*n
 return {'"'n':2*n,'host_edges':[list(e) for e in E]},order
for N in (40,60,80,100,120):
 print('base',N,'lift',2*N,flush=True)
 for seed in range(8):
  b=g.make_instance(N,seed);i,a=lift(b);t=time.perf_counter();z,nodes=g._attack_matching_complement(i,node_budget=20000);dt=time.perf_counter()-t
  print(seed,z is not None,nodes,round(dt,3),flush=True)
