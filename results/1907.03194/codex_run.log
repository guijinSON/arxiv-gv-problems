# n is the size of the residue pool, not the graph-design order p.
DIFFICULTY = {
    "demo": {"n": 12, "order": 73, "marker_count": 5},
    "easy": {"n": 35, "order": 217, "marker_count": 8},
    "medium": {"n": 80, "order": 577, "marker_count": 11},
