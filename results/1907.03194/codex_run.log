+    all_failed = all(stat["successes"] == 0 for stat in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "full row-relative offset histogram",
