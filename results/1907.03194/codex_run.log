+    if not 2 <= n < modulus:
+        raise ValueError("n must satisfy 2 <= n < 2^v-1")
+    if not 0 <= blocker_count <= min(row_count - 1, n - 1):
+        raise ValueError("blocker_count is outside its supported range")
