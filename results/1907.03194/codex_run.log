+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=123, **shipping_params)
+    answer = ship["answer"]
+
+    # Find two ordinary corruptions with distinct row-specific reasons.
+    swap_answer = None
+    swap_positions = None
+    swap_reason = None
