+    directed_differences: set[int] = set()
+    incident: set[int] = set()
+    for difference, start in rows:
+        end = (start + difference) % modulus
+        for exponent in range(v):
+            scale = 1 << exponent
+            left = (scale * start) % modulus
+            right = (scale * end) % modulus
