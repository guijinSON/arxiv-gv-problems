+                {
+                    "seed": seed,
+                    "frobenius_exponent": exponent,
+                    "translation": translation,
+                    "key_invariant": same_key,
+                    "carried_verify": carried_ok,
+                    "carried_reason": carried_reason,
+                }
+            )
+    report["G8_canonical_key"] = {
