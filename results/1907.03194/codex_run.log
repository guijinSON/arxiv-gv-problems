+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+# n is the number of candidate starts in every Frobenius-difference row.
+DIFFICULTY = {
+    "demo": {
+        "n": 3,
+        "v": 5,
+        "blocker_count": 2,
+        "marker_count": 3,
+        "marked_true": 2,
+    },
+    "easy": {
+        "n": 10,
