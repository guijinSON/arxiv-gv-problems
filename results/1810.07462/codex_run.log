+def make_instance(n, seed=0, k=None, head_levels=4, **params):
+    """Inverse-generate exact bases and known disjoint transversal bases."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if k is None:
+        k = max(1, n // 3)
