+def random_candidate(inst, rng):
+    n, k = inst["n"], inst["k"]
+    columns = [sorted(rng.sample(range(n), k))]
+    columns.extend(rng.sample(range(n), k) for _ in range(1, n))
+    return [[columns[color][base] for color in range(n)] for base in range(k)]
