+    guess_elapsed = time.perf_counter() - started
+    density = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": density < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": density,
