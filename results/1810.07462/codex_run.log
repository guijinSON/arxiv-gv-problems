+        "1-factorization runs in O(n^3+kn) time and is measured in selftest at the "
+        "shipping preset; the affine quotient route uses at most 260 exact "
+        "arithmetic operations there."
+    ),
+    "max_answer_tokens": 128,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
