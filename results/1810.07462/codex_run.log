+# Filled from script-owned transcripts after the oracle runs. These are
+# diagnostics only; G9 gates the size/effort caps.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
