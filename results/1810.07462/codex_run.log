+    coordinates = list(range(n))
+    rng.shuffle(coordinates)
+    for row in new_bases:
+        for index, vector in enumerate(row):
+            changed = [vector[coordinates[q]] for q in range(n)]
+            if n >= 2:
+                changed[0] += changed[1]
+            row[index] = changed
