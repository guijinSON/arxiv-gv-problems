+def escalate(params):
+    n, k = params["n"], params.get("k", max(1, params["n"] // 3))
+    levels = params.get("head_levels", 4)
+    if n < 24:
+        next_n = min(24, n + 3)
+        next_k = min(10, k + 2, next_n)
+        return {"n": next_n, "k": next_k,
+                "head_levels": max(3, levels - 1)}
