+    for target_offset in range(k):
+        chosen = []
+        for color in range(n):
+            target_direction = (color + target_offset) % n
+            slot = (inverse_step *
+                    (target_direction - drift * color - offset)) % n
+            chosen.append(slot)
+        planted.append(chosen)
