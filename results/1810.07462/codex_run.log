+
+    doubled = make_instance(n=2 * shipping["n"], k=shipping["k"],
+                            head_levels=shipping["head_levels"], seed=991)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
