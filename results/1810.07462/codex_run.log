+        "original_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "fixed_k": doubled["k"],
+        "doubled_vector_count": doubled["n"] ** 2,
+        "verify_reason": doubled_reason,
+    }
+
+    invariant_checks = carried_checks = 0
+    key_failures = []
+    for seed in range(20):
