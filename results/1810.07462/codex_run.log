+def _attack_head_magnitude(inst):
+    columns = []
+    for row in inst["bases"]:
+        ordered = sorted(range(inst["n"]),
+                         key=lambda slot: (abs(row[slot][0]), row[slot][0], slot))
+        columns.append(ordered[:inst["k"]])
+    return _candidate_from_columns(columns)
