+        for vector in row:
+            if not isinstance(vector, list) or len(vector) != n:
+                return None
+            tail = [coordinate for coordinate in range(1, n) if vector[coordinate]]
+            if tail and (len(tail) != 1 or vector[tail[0]] != 1):
