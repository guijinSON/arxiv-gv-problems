+        representatives = remaining
+        groups.append(tuple(sorted(counts[vector] for vector in group)))
+    invariant = [n, k, counts[anchor], sorted(groups)]
+    return hashlib.sha256(json.dumps(invariant, separators=(",", ":")).encode()).hexdigest()
