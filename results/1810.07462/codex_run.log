+                                 "reason": reason})
+        else:
+            carried_checks += 1
+    unrelated_keys = [canonical_key(make_instance(seed=90000 + seed,
+                                                   **DIFFICULTY[SHIPPING_DIFFICULTY]))
+                      for seed in range(20)]
+    distinct_count = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
