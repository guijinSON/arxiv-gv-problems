+            for coordinate, value in enumerate(vector):
+                tests += 1
+                if coordinate != head and value:
+                    tail.append(coordinate)
+            direction = tail[0] if len(tail) == 1 else head
+            by_direction[direction] = slot
+        lookup.append(by_direction)
