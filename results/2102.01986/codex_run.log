import time,random
import gen_2102_01986 as g

def sums(ds, M):
 out=[(0,0)]
 for i,d in enumerate(ds): out += [((s+d)%M,m|(1<<i)) for s,m in out]
 return out

def attack(inst, trials=12):
 closure,totals=g._branch_totals(inst); M=inst['modulus']; b=inst['modulus_bits']; n=inst['n']; size=n//4
 ds=[(y-x)%M for x,y in totals]; base=(closure+sum(x for x,_ in totals))%M; D=(inst['target']-base)%M
 groups=[sums(ds[i*size:(i+1)*size],M) for i in range(4)]
 r=b//3; lowmod=1<<r; lowmask=lowmod-1; M2=1<<(b-r)
 buckets=[]
 for group in groups:
  d={}
  for s,m in group:d.setdefault(s&lowmask,[]).append((s,m))
  buckets.append(d)
 rng=random.Random(0); cs=[0]+[rng.randrange(lowmod) for _ in range(trials-1)]
 for c in cs:
  A=[]
  for s0,m0 in groups[0]:
   for s1,m1 in buckets[1].get((c-s0)&lowmask,()):
    pair=(s0+s1)%M
    A.append((pair>>r,m0,m1))
  dlow=(D-c)&lowmask; carry=(c+dlow-(D&lowmask))//lowmod
  B={}
  for s2,m2 in groups[2]:
   for s3,m3 in buckets[3].get((dlow-s2)&lowmask,()):
    pair=(s2+s3)%M
    B.setdefault(pair>>r,(m2,m3))
  Dhi=D>>r
  for hi,m0,m1 in A:
   want=(Dhi-carry-hi)%M2
   if want in B:
    m2,m3=B[want]; masks=(m0,m1,m2,m3); bits=[]
    for mask in masks:bits += [(mask>>i)&1 for i in range(size)]
    cand=g._cycle_from_bits(inst,bits)
    if g.verify(inst,cand)[0]:return cand
 return None
for seed in range(3100,3108):
 i=g.make_instance(seed=seed,**g.DIFFICULTY['standard']); t=time.time();a=attack(i)
 print(seed,bool(a),f'{time.time()-t:.3f}s')
