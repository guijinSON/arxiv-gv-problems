/bin/bash -lc "python3 - <<'PY'
import time
import gen_2102_01986 as g

def sums(ds, M):
    out=[(0,0)]
    for i,d in enumerate(ds):
        out += [((s+d)%M, mask|(1<<i)) for s,mask in out]
    return out

def attack(inst):
    closure, totals=g._branch_totals(inst)
    M=inst['modulus']; n=inst['n']; b=inst['modulus_bits']
    ds=[(y-x)%M for x,y in totals]
    base=(closure+sum(x for x,_ in totals))%M
    D=(inst['target']-base)%M
    assert n==64 and b==48
    groups=[sums(ds[i*16:(i+1)*16],M) for i in range(4)]
    r=16; lowmask=(1<<r)-1; M2=1<<(b-r)
    bucket1={}
    for s,m in groups[1]: bucket1.setdefault(s&lowmask,[]).append((s,m))
    A=[]
    for s0,m0 in groups[0]:
        for s1,m1 in bucket1.get((-s0)&lowmask,()):
            pair=(s0+s1)%M
            A.append((pair>>r,m0,m1))
    bucket3={}
    for s,m in groups[3]: bucket3.setdefault(s&lowmask,[]).append((s,m))
    B={}
    Dlow=D&lowmask
    for s2,m2 in groups[2]:
        for s3,m3 in bucket3.get((Dlow-s2)&lowmask,()):
            pair=(s2+s3)%M
            high=((pair-Dlow)%M)>>r
            B.setdefault(high,(m2,m3))
    Dhigh=D>>r
    for high,m0,m1 in A:
        want=(Dhigh-high)%M2
        if want in B:
            m2,m3=B[want]
            masks=[m0,m1,m2,m3]
            bits=[]
            for mask in masks: bits += [(mask>>i)&1 for i in range(16)]
            cand=g._cycle_from_bits(inst,bits)
            if g.verify(inst,cand)[0]: return cand,len(A),len(B)
    return None,len(A),len(B)

for seed in range(3100,3103):
    inst=g.make_instance(seed=seed,**g.DIFFICULTY['standard'])
    t=time.time(); ans,a,b=attack(inst); dt=time.time()-t
    print(seed, bool(ans), f'{dt:.3f}s',a,b,g.verify(inst,ans) if ans else None)
