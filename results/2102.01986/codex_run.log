+        "structure_aware_fraction": 9.5367431640625e-07,
+        "naive_cycle_space": 59856127576131168461559908033875359335131652397968916480000000000,
+        "naive_fraction": 1.67067272891668e-65
+      }
+    ]
+  },
+  "G6_adversary_panel": {
+    "pass": true,
+    "attacks": {
+      "per_branch_numeric_outlier": {
+        "solved": 0,
+        "trials": 8
+      },
+      "deterministic_residual_greedy": {
+        "solved": 0,
+        "trials": 8
+      },
+      "random_restart_one_flip_64x256": {
+        "solved": 0,
+        "trials": 8
+      }
+    }
+  },
+  "G7_scales": {
+    "pass": true,
+    "base_n": 64,
+    "base_modulus_bits": 48,
+    "doubled_n": 128,
+    "doubled_modulus_bits": 96,
+    "planted_verifies": true
+  },
+  "G8_canonical_key": {
+    "pass": true,
+    "invariance_checks": 80,
+    "real_transform_checks": 80,
+    "original_answer_transform_checks": 20,
+    "distinct_unrelated": 20,
+    "unrelated_total": 20,
+    "symmetries": "vertex renumbering, edge order/orientation, per-stage branch swap, affine x->u*x+t for odd u, and compositions"
+  },
+  "all_passed": true
+}

