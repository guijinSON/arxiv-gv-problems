--- /dev/null
+++ b/selftest_report.json
@@ -0,0 +1,105 @@
+{
+  "G1_planted_verifies": {
+    "pass": true,
+    "instances": 12
+  },
+  "G2_rejects_corruption": {
+    "pass": true,
