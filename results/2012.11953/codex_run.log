import random, math, time, statistics
N=120; C=8.0; TRIALS=100

def gen(seed):
    rng=random.Random(seed)
    cyc=list(range(N)); rng.shuffle(cyc)
    edges={tuple(sorted((cyc[i],cyc[(i+1)%N]))) for i in range(N)}
    q=C*math.log(N)/N
    for u in range(N):
        for v in range(u+1,N):
            if (u,v) not in edges and rng.random()<q: edges.add((u,v))
    return edges

def solve(edges,seed):
    rng=random.Random(seed "'^ 0x9e3779b9)
    adj=[[] for _ in range(N)]
    for u,v in edges: adj[u].append(v);adj[v].append(u)
    for a in adj:rng.shuffle(a)
    used={0}; path=[0]; states=0; scans=0
    def rec(v):
        nonlocal states,scans
        states += 1
        if states>2_000_000:return None
        if len(path)==N:
            scans += len(adj[v])
            return path[:] if 0 in adj[v] else None
        scans += len(adj[v])
        cand=[w for w in adj[v] if w not in used]
        decorated=[]
        for w in cand:
            scans += len(adj[w])
            onward=sum(z not in used for z in adj[w])
            decorated.append((onward,rng.random(),w))
        decorated.sort()
        for _,__,w in decorated:
            used.add(w);path.append(w)
            out=rec(w)
            if out:return out
            path.pop();used.remove(w)
        return None
    t=time.perf_counter(); ans=rec(0); dt=time.perf_counter()-t
    return ans,states,scans,dt
rows=[]
for s in range(TRIALS):
    e=gen(s); a,st,sc,dt=solve(e,s);rows.append((a is not None,st,sc,dt,len(e)))
print('"'n',N,'q',C*math.log(N)/N,'solved',sum(x[0] for x in rows),'attempts',TRIALS)
for idx,name in [(1,'states'),(2,'adjacency_tests'),(3,'wall_sec'),(4,'edges')]:
 vals=[x[idx] for x in rows]
 print(name,'median',statistics.median(vals),'mean',statistics.mean(vals),'max',max(vals),'total',sum(vals))
