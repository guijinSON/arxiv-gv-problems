import random, math, time, statistics

def gen(n, seed, c=3.0):
    r=random.Random(seed); p=list(range(n)); r.shuffle(p)
    E={tuple(sorted((p[i],p[(i+1)%n]))) for i in range(n)}
    q=min(.9,c*math.log(n)/n)
    for u in range(n):
      for v in range(u+1,n):
        if (u,v) not in E and r.random()<q:E.add((u,v))
    return E,r

def dfs_ham(n,E,r,cap=10_000_000):
    A=[[] for _ in range(n)]
    for u,v in E:A[u].append(v);A[v].append(u)
    for x in A:r.shuffle(x)
    path=[0]; used=1; nodes=0
    def rec(v):
      nonlocal used,nodes
      nodes+=1
      if nodes>cap:return None
      if len(path)==n:return path[:] if 0 in A[v] else None
      # prefer onward low residual degree
      cand=[w for w in A[v] if not (used>>w)&1]
      cand.sort(key=lambda w: sum(1 for z in A[w] if not (used>>z)&1)+r.random())
      for w in cand:
        # no remaining vertex stranded after adding w
        used |= 1<<w; path.append(w)
        out=rec(w)
        if out:return out
        path.pop(); used "'^= 1<<w
      return None
    ans=rec(0)
    return ans,nodes
for n in [48,64,96,120,128]:
  vals=[]; ok=0;t=time.perf_counter()
  for s in range(20):
    E,r=gen(n,s)
    a,nodes=dfs_ham(n,E,r)
    ok += a is not None
    vals.append(nodes)
  dt=time.perf_counter()-t
  print(n,ok,'"'nodes median',statistics.median(vals),'max',max(vals),'wall',round(dt,4),'edges',len(E))
