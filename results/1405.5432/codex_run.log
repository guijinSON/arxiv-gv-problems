import time

def span2_basis_pairs(d):
    seen={}
    for a in range(1,1<<d):
        for b in range(a+1,1<<d):
            if b "'!= a:
                key=tuple(sorted((a,b,a''^b)))
                seen.setdefault(key,(a,b))
    return list(seen.values())

def construct(v):
    d=v-1
    b1=[]
    for a in range(1,1<<d):
        x=1; y=a<<1
        b1.append((1<<(x-1))|(1<<(y-1))|(1<<((x''^y)-1)))
    b2=[]
    for a,b in span2_basis_pairs(d):
        for fa in range(2):
            for fb in range(2):
                x=(a<<1)|fa; y=(b<<1)|fb
                b2.append((1<<(x-1))|(1<<(y-1))|(1<<((x''^y)-1)))
    return sorted(b1+b2)
for v in (4,5,6):
    out=construct(v)
    start=time.perf_counter()
    reps=10000 if v<6 else 1000
    for _ in range(reps): construct(v)
    elapsed=(time.perf_counter()-start)/reps
    import json
    payload=json.dumps(out,separators=('"',',':'))
    print({'v':v,'blocks':len(out),'atoms':len(out),'chars':len(payload),'mean_sec':elapsed,'distinct':len(set(out))})
