/bin/bash -lc "python3 - <<'PY'
import random,time,math

def gen(n,k,ratio,seed):
 r=random.Random(seed); a=[r.randrange(2) for _ in range(n)]; cs=[]
 for _ in range(round(ratio*n)):
  vs=[r.randrange(n) for _ in range(k)]
  while True:
   # lit tuple (var, required value)
   req=[r.randrange(2) for _ in range(k)]
   if any(a[v]==b for v,b in zip(vs,req)): break
  # remove tautologies/repeats semantically for solver
  d={}
  taut=False
  for v,b in zip(vs,req):
   if v in d and d[v]"'!=b: taut=True
   d[v]=b
  if not taut: cs.append(tuple(d.items()))
 return a,cs

def solve(n,cs,cap=200000):
 nodes=0; deadline=time.monotonic()+10
 occ=[0]*n
 for c in cs:
  for v,b in c: occ[v]+=1
 def rec(assign):
  nonlocal nodes
  nodes+=1
  if nodes>cap or time.monotonic()>deadline: raise TimeoutError
  while 1:
   unit=None; allsat=True
   for c in cs:
    sat=False; u=[]
    for v,b in c:
     x=assign[v]
     if x<0:u.append((v,b))
     elif x==b:sat=True;break
    if sat:continue
    allsat=False
    if not u:return None
    if len(u)==1:unit=u[0];break
   if allsat:return assign
   if unit:
    v,b=unit
    if assign[v]>=0 and assign[v]!=b:return None
    assign[v]=b;continue
   break
  # max occurrence in unresolved clauses; phase by literal majority
  score={}
  for c in cs:
   if any(assign[v]==b for v,b in c):continue
   for v,b in c:
    if assign[v]<0:
     z=score.setdefault(v,[0,0]);z[b]+=1
  v=max(score,key=lambda x:sum(score[x]))
  pref=1 if score[v][1]>=score[v][0] else 0
  for b in (pref,1-pref):
   aa=assign.copy();aa[v]=b
   z=rec(aa)
   if z is not None:return z
  return None
 try:
  z=rec([-1]*n);return z,nodes,False
 except TimeoutError:return None,nodes,True

for k,ratio in [(3,4.267),(4,9.93),(5,21.1)]:
 for n in [64,96,128,160,192,256]:
  vals=[]
  for seed in range(4):
   a,c=gen(n,k,ratio,seed); t=time.monotonic(); z,nodes,to=solve(n,c); vals.append((nodes,round(time.monotonic()-t,3),to, bool(z)))
  print(k,n,vals)
