+def _source_sweep_attack(inst: dict) -> list[int]:
+    matrix = inst["matrix"]
+    special = _unique_global_source(matrix)
+    if special is None:
+        special = 0
+    others = sorted(
+        (v for v in range(4) if v != special),
+        key=lambda v: (sum(matrix[v]), v),
+        reverse=True,
+    )
+    return _repeat_order([special] + others, inst["target_length"])
