+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_started = time.perf_counter()
+    demo_count = enumerate_all(demo)
+    demo_seconds = time.perf_counter() - demo_started
+    baseline_started = time.perf_counter()
+    baseline_candidate, baseline_operations = _largest_incidence_greedy(inst)
+    baseline_ok = _is_target_cycle_by_uniqueness(inst, baseline_candidate)
