+    relabelling = list(range(4))
+    rng.shuffle(relabeling := relabelling)
+    matrix, cycle = _permute_instance(matrix, cycle, relabeling)
+    return {
+        "matrix": matrix,
+        "target_length": len(cycle),
+        "size_parameter": n,
+        "answer": cycle,
+    }
