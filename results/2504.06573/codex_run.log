+        ),
+        "attacks": attack_results,
+        "reference_algorithm": {
+            "name": "rank-three unique-descent reconstruction plus source order",
+            "paper_basis": "Lemma 3.11 and the proof of Theorem 4.27",
+            "complexity": "O(L*r^3) exact integer operations, r=4",
