+def _random_restart_attack(
+    inst: dict, rng: random.Random, restarts: int
+) -> tuple[list[int], int]:
+    last: list[int] = []
+    operations = 0
+    for _ in range(restarts):
+        last = random_candidate(inst, rng)
+        operations += len(last)
+        # Theorem 4.27 gives exactly the two orientations at this length; this
+        # equality prefilter is used only by the diagnostic attack, never by verify.
+        planted = inst["answer"]
+        if last == planted or last == list(reversed(planted)):
+            return last, operations
+    return last, operations
