+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Replay a candidate exactly.  The planted answer is never consulted."""
+
+    if answer == []:
+        return False, "answer must be a nonempty list"
+    if not isinstance(answer, list):
