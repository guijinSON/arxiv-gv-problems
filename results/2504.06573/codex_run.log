+    }
+
+    attack_results = {
+        "outlier_incident_sum_order": {"successes": 0, "attempts": 0},
+        "greedy_largest_incidence": {"successes": 0, "attempts": 0},
+        "random_restart_4096": {"successes": 0, "attempts": 0},
