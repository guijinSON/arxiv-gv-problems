+def _reduce_word(word: list[int]) -> list[int]:
+    stack: list[int] = []
+    for vertex in word:
+        if stack and stack[-1] == vertex:
+            stack.pop()
+        else:
+            stack.append(vertex)
+    return stack
+
+
+def _is_acyclic(matrix: list[list[int]]) -> bool:
+    size = len(matrix)
+    indegree = [0] * size
+    outgoing = [[] for _ in range(size)]
+    for i in range(size):
+        for j in range(i + 1, size):
+            if matrix[i][j] > 0:
+                outgoing[i].append(j)
+                indegree[j] += 1
+            elif matrix[i][j] < 0:
+                outgoing[j].append(i)
+                indegree[i] += 1
+    queue = [i for i, degree in enumerate(indegree) if degree == 0]
+    seen = 0
+    while queue:
+        vertex = queue.pop()
+        seen += 1
+        for target in outgoing[vertex]:
+            indegree[target] -= 1
+            if indegree[target] == 0:
+                queue.append(target)
+    return seen == size
+
