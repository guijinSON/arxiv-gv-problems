+    # same length while the mechanical exact-arithmetic route becomes costlier.
+    if n < 10**18:
+        return {"n": 10 * n + 7, "repetitions": repetitions}
+    if repetitions < 63:
+        return {"n": n, "repetitions": repetitions + 1}
+    return "cap_bound"
