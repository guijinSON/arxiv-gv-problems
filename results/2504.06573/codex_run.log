+def _unique_global_source(matrix: list[list[int]]) -> int | None:
+    sources = [
+        i
+        for i in range(len(matrix))
+        if all(matrix[i][j] > 0 for j in range(len(matrix)) if j != i)
+    ]
+    return sources[0] if len(sources) == 1 else None
