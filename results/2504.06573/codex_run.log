+def _repeat_order(order: list[int], length: int) -> list[int]:
+    if len(order) < 2:
+        order = [0, 1, 2, 3]
+    word: list[int] = []
+    index = 0
+    while len(word) < length:
+        value = order[index % len(order)]
+        index += 1
+        if word and word[-1] == value:
+            continue
+        word.append(value)
+    return word
+
