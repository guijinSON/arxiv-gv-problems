+def _outlier_attack(inst: dict) -> list[int]:
+    matrix = inst["matrix"]
+    order = sorted(
+        range(4),
+        key=lambda v: (-sum(abs(x) for x in matrix[v]), v),
+    )
+    return _repeat_order(order, inst["target_length"])
