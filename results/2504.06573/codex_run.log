+
+def _mutate_counted(
+    matrix: list[list[int]], vertex: int
+) -> tuple[list[list[int]], int]:
+    """Mutation plus a conservative scalar-arithmetic operation count."""
+
+    size = len(matrix)
+    result = [[0] * size for _ in range(size)]
+    operations = 0
+    for i in range(size):
+        for j in range(i + 1, size):
