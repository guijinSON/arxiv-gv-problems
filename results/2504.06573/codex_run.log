+    parsed = parse_answer(model_reply)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer,
+        "parsed": parsed,
+        "surrounding_prose_and_fence": True,
+    }
+
+    guess_rng = random.Random(314159265)
+    guess_total = 200_000
+    guess_hits = 0
+    reverse_answer = list(reversed(answer))
+    for _ in range(guess_total):
