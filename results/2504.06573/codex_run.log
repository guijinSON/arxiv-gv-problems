import importlib.util,itertools
s=importlib.util.spec_from_file_location('g','gen_2504_06573.py');g=importlib.util.module_from_spec(s);s.loader.exec_module(g)
for reps in (1,2,3,4):
 bad=[]; total=0
 for a,b,c in itertools.product(range(2,11), repeat=3):
  base=[[0,a,c],[-a,0,b],[-c,-b,0]]
  for endpoint in (0,2):
   total+=1
   con=[1,endpoint]*reps; h=g._replay(base,con)
   m=[[0]*4 for _ in range(4)]
