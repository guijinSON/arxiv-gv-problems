+        "original_n": shipping_params["n"],
+        "doubled_n": 2 * shipping_params["n"],
+        "coefficient_height_increases": True,
+        "answer_atoms_before": _answer_atoms(answer),
+        "answer_atoms_after": _answer_atoms(doubled["answer"]),
