+                negative = max(-matrix[i][vertex], 0) * max(
+                    -matrix[vertex][j], 0
+                )
+                value = matrix[i][j] + positive - negative
+                operations += 6
+            result[i][j] = value
+            result[j][i] = -value
+    return result, operations
