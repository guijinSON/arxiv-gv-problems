    for j in range(3):m[i][j]=h[i][j]
   for v,w in enumerate((2,3,4)):m[3][v]=w;m[v][3]=-w
   cyc=[3]+list(reversed(con))+[0,1,2]+con
   inst={'matrix':m,'target_length':len(cyc),'answer':cyc}
   got=g._compact_reconstruction(inst)
   if got"'!=cyc: bad.append((a,b,c,endpoint,got))
 print('"'reps',reps,'bad',len(bad),'of',total,'first',bad[:5])
