+        "by_hand_pure_light_edge_alternation": {"successes": 0, "attempts": 0},
+        "source_sweep_repeat": {"successes": 0, "attempts": 0},
+    }
+    reference_successes = 0
+    reference_operations = 0
+    reference_trials = 0
+    compact_successes = 0
+    reference_per_seed = []
+    reference_started = time.perf_counter()
+    for offset in range(8):
+        seed = 10_000 + offset
