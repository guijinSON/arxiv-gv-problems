+        "real_transformation_checks": transformation_checks,
+        "distinct_unrelated_keys": distinct_count,
+        "unrelated_attempts": 20,
+        "failures": invariance_failures,
+        "canonization": "exact over all 24 relabellings and global reversal",
+    }
