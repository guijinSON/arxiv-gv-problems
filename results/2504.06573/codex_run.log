+def _is_target_cycle_by_uniqueness(inst: dict, candidate: list[int]) -> bool:
+    """Classify an attack output using Theorem 4.27's exact uniqueness.
+
+    This is only a selftest accelerator.  The public checker does not use the
+    planted answer or the theorem: it always performs exact mutation replay.
+    """
+
+    planted = inst["answer"]
+    return candidate == planted or candidate == list(reversed(planted))
+
+
+def _find_swap_corruption(inst: dict) -> list[int]:
+    answer = inst["answer"]
+    for i in range(len(answer)):
+        for j in range(i + 1, len(answer)):
+            candidate = answer[:]
+            candidate[i], candidate[j] = candidate[j], candidate[i]
+            if candidate == answer:
+                continue
+            if any(candidate[k] == candidate[k - 1] for k in range(1, len(candidate))):
+                continue
+            if verify(inst, candidate)[1] == "exact replay does not return to the displayed matrix":
+                return candidate
+    raise AssertionError("could not construct a clean swap corruption")
