+            "source_sweep_repeat": _source_sweep_attack(trial),
+        }
+        for name, candidate in attacks.items():
+            attack_results[name]["attempts"] += 1
+            attack_results[name]["successes"] += int(
+                _is_target_cycle_by_uniqueness(trial, candidate)
