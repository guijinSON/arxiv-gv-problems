+DIFFICULTY = {
+    "demo": {"n": 3, "repetitions": 1},
+    "easy": {"n": 101, "repetitions": 20},
+    "medium": {"n": 1009, "repetitions": 40},
+    "hard": {"n": 10007, "repetitions": 60},
+}
