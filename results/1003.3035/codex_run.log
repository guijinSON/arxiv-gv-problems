+    if not _is_power_of_two(n) or n < 4 or n > 64:
+        raise ValueError("n must be a power of two between 4 and 64")
+    if scale_floor is None:
+        scale_floor = n + 1
+    if (not isinstance(scale_floor, int) or isinstance(scale_floor, bool)
+            or scale_floor < 1):
