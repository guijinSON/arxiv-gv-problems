+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "rational_exact",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
