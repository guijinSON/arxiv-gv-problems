+        "shipping n=32 preset the implemented reference algorithm solves 8/8 "
+        "instances using 2,211,872 exact-operation slots in 0.0 seconds "
+        "(median, updated by selftest), whereas the Walsh insight uses 255 "
+        "small exact operations."
+    ),
+    "max_answer_tokens": 100,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
