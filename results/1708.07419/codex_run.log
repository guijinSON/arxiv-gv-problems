+def _recover_t_from_rhs(inst):
+    modulus = inst["field_modulus"]
+    rhs = inst["rhs_coefficients"]
+    t = [rhs[0]]
+    for i in range(1, inst["n"]):
+        t.append((rhs[i] - t[-1]) % modulus)
+    return t
