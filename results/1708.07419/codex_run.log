+        "coefficient_bound": bound,
+        "generators": ["a", "b"],
+        "terms": _canonical_terms(steps, m),
+        "matrix": matrix,
+        "target": [[m, 2 * steps, 1], [m + 2 * steps, 0, -1]],
+        "answer": [[x, 1] for x in solution],
