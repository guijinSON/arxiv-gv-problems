def _prime_divisors(v):
    out = []
    p = 2
    while p * p <= v:
        if v % p == 0:
            out.append(p)
            while v % p == 0:
                v //= p
        p += 1
    if v > 1:
        out.append(v)
    return out


def _poly2_mod(a, modulus):
    md = modulus.bit_length() - 1
    while a and a.bit_length() - 1 >= md:
        a ^= modulus << (a.bit_length() - 1 - md)
    return a


def _poly2_gcd(a, b):
    while b:
        a, b = b, _poly2_mod(a, b)
    return a


