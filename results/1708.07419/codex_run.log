+    # If M=I+scale*u*v^T and v^T u=0, M^{-1}=I-scale*u*v^T.
+    c = _target_coefficients(k)
+    solution = [c[i] - scale * u[i] * t for i in range(k)]
+    bound = scale * k + 2
+    assert all(abs(x) <= bound for x in solution)
