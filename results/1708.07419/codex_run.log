+def _attack_outlier_singleton(inst):
+    """Guess each coefficient from the modal one-variable row explanation."""
+    modulus = inst["field_modulus"]
+    t = _recover_t_from_rhs(inst)
+    guess = []
+    for j in range(inst["n"]):
