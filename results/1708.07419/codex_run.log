+def _inverse_counted(value, modulus):
+    exponent = modulus - 2
+    result = 1
+    base = value % modulus
+    operations = 0
+    while exponent:
+        if exponent & 1:
+            result = result * base % modulus
+            operations += 1
+        exponent >>= 1
