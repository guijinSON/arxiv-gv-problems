    try:
        matches = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", str(text),
                             re.I | re.S)
        if not matches:
            return None
        body = matches[-1].strip()
        body = re.sub(r"^```(?:text|json)?\s*", "", body, flags=re.I)

