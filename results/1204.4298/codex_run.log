+        "pass": not key_failures and distinct_count == 20,
+        "invariant_relabellings": invariant_checks,
+        "carried_witnesses_valid": carried_checks,
+        "unrelated_distinct_keys": distinct_count,
+        "unrelated_attempts": 20,
