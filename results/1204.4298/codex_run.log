+def _det(a, b, p):
+    return (a[0] * b[1] - a[1] * b[0]) % p
+
+
+def _draw_nonzero_vector(p, rng):
+    while True:
+        vector = (rng.randrange(p), rng.randrange(p))
+        if vector != (0, 0):
+            return vector
+
+
+def _draw_frame(p, rng):
