+    placebo_rate = (arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+                    if arms["placebo"]["attempts"] else 0.0)
+    within_caps = (answer_chars <= 2000 and answer_elements <= 256 and
+                   intended_operations <= 300)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS.get("hinted_verdict", "unrun"),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {
+            "answer_chars": 2000,
+            "answer_elements": 256,
+            "intended_route_operations": 300,
+        },
+    }
+
+    report["pass"] = all(
+        value.get("pass", False) for key, value in report.items()
+        if key.startswith("G") and key[1:2].isdigit()
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

codex
Rejected honestly: no acceptable family from [arXiv:1204.4298](https://arxiv.org/abs/1204.4298) clears H.

- Track A fails because Theorem 1 and Example 2 construct the rainbow coloring efficiently.
- Track B fails because the visible endpoint/twin attack recovers the affine certificate on 8/8 shipping instances.
- The bare oracle loop solved every admissible rung and returned `too_easy`.
- G and V passed; structured guessing produced 0/200,000 hits.

Artifacts:

- [REJECTED.md](/home/gson/gvrepo/results/1204.4298/REJECTED.md)
