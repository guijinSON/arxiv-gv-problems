+def _projective(vector, p):
+    if vector == (0, 0):
+        return vector
+    if vector[0]:
+        inverse = pow(vector[0], p - 2, p)
+    else:
+        inverse = pow(vector[1], p - 2, p)
+    return _scale(inverse, vector, p)
