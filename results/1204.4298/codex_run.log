+
+def _add(a, b, p):
+    return ((a[0] + b[0]) % p, (a[1] + b[1]) % p)
+
+
+def _sub(a, b, p):
+    return ((a[0] - b[0]) % p, (a[1] - b[1]) % p)
+
+
+def _scale(k, a, p):
+    return ((k * a[0]) % p, (k * a[1]) % p)
+
