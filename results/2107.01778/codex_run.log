+        for variant in (
+            _relabeled_instance(original, variable_order,
+                                list(range(len(original["equations"]))),
+                                [False] * len(original["equations"])),
+            _relabeled_instance(original, list(range(original["n"])),
+                                equation_order,
+                                [False] * len(original["equations"])),
+            transformed,
