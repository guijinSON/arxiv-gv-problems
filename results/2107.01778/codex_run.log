   342	def parse_answer(text):
   343	    """Parse a tagged comma-separated exact rational vector, never raising."""
   344	    if not isinstance(text, str):
   345	        return None
   346	    match = _TAG_RE.search(text)
   347	    if not match:
   348	        return None
   349	    body = match.group(1).strip()
   350	    body = re.sub(r"^```(?:json|text)?\s*", "", body, flags=re.I)
   351	    body = re.sub(r"\s*```$", "", body)
   352	    if not body:
   353	        return []
   354	    parts = [part.strip() for part in body.split(",")]
   355	    if any(not part for part in parts):
   356	        return None
   357	    out = []
   358	    try:
   359	        for part in parts:
   360	            if rationals is not None:
   361	                value = rationals.parse_rational(part)
   362	                if value is None:
   363	                    return None
   364	            else:
   365	                value = _q(part)
   366	            out.append(_q_json(value))
   367	    except (TypeError, ValueError, ZeroDivisionError):
   368	        return None
   369	    return out
