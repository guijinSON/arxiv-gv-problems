   204	@lru_cache(maxsize=64)
   205	def _allowed_values(height, max_denominator):
   206	    values = []
   207	    for den in range(1, max_denominator + 1):
   208	        for num in range(-height, height + 1):
   209	            if num and math.gcd(abs(num), den) == 1:
   210	                values.append(Fraction(num, den))
   211	    values.sort()
   212	    return tuple(values)
   213	
   214	
   215	def _dot(row, vector):
   216	    return sum((Fraction(a) * x for a, x in zip(row, vector)), Fraction(0))
   217	
   218	
   219	def _random_row(rng, n, bound):
   220	    while True:
   221	        row = [rng.randint(-bound, bound) for _ in range(n)]
   222	        if any(row):
   223	            return row
   224	
   225	
   226	def _changed_value(rng, old, bound):
   227	    choices = [v for v in range(-bound, bound + 1) if abs(v - old) >= 2]
   228	    return rng.choice(choices)
   229	
   230	
   231	def make_instance(n, seed=0, pair_decoys=0, height=30,
   232	                  max_denominator=7, coefficient_bound=11, **params):
   233	    """Inverse-generate an exact linear TVCSP instance and its zero witness."""
   234	    del params
   235	    for name, value, minimum in (
   236	        ("n", n, 2),
   237	        ("pair_decoys", pair_decoys, 0),
   238	        ("height", height, 1),
   239	        ("max_denominator", max_denominator, 1),
   240	        ("coefficient_bound", coefficient_bound, 2),
   241	    ):
   242	        if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
   243	            raise ValueError("%s must be an integer >= %d" % (name, minimum))
   244	
   245	    rng = random.Random(seed)
   246	    language = _allowed_values(height, max_denominator)
   247	    if len(language) < n:
   248	        raise ValueError("certificate language has fewer than n distinct rationals")
   249	
   250	    planted = rng.sample(language, n)
   251	    pair_specs = [(j,) for j in rng.sample(range(n), n)]
   252	    for _ in range(pair_decoys):
   253	        pair_specs.append(tuple(sorted(rng.sample(range(n), 2))))
   254	    rng.shuffle(pair_specs)
   255	
   256	    bases = []
   257	    modified = []
   258	    for changed in pair_specs:
   259	        # Reject the measure-zero-looking b=0 cases so equation orientation has
   260	        # a column-permutation-invariant canonical sign chosen from b alone.
   261	        while True:
   262	            row = _random_row(rng, n, coefficient_bound)
   263	            row2 = row[:]
   264	            for j in changed:
   265	                row2[j] = _changed_value(rng, row[j], coefficient_bound)
   266	            b1 = _dot(row, planted)
   267	            b2 = _dot(row2, planted)
   268	            if b1 != 0 and b2 != 0:
   269	                break
   270	        bases.append({"a": row, "b": _q_json(b1)})
   271	        modified.append({"a": row2, "b": _q_json(b2)})
   272	
   273	    # Positionwise comparison of the two equal-length blocks is the intended
   274	    # compact route.  The pair types are deliberately not stored in the instance.
   275	    equations = bases + modified
   276	    return {
   277	        "family": "linear_tropical_minimax_zero",
   278	        "n": n,
   279	        "pair_decoys": pair_decoys,
   280	        "height": height,
   281	        "max_denominator": max_denominator,
   282	        "coefficient_bound": coefficient_bound,
   283	        "equations": equations,
   284	        "answer": [_q_json(x) for x in planted],
   285	    }
