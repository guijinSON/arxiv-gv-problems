   182	        m = re.fullmatch(r"\s*([+-]?\d+)(?:\s*/\s*([+-]?\d+))?\s*", value)
   183	        if not m:
   184	            raise ValueError("malformed rational literal")
   185	        den = int(m.group(2) or "1")
   186	        if den == 0:
   187	            raise ValueError("zero denominator")
   188	        return Fraction(int(m.group(1)), den)
   189	    raise TypeError("unsupported rational type")
