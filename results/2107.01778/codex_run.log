+    ordered_values = sorted(allowed, key=lambda x: (abs(x), x))[:inst["n"]]
+    answer = [None] * inst["n"]
+    for j, value in zip(sorted(range(inst["n"]), key=lambda j: scores[j]), ordered_values):
+        answer[j] = _q_json(value)
+    return answer
