   191	
   192	def _q_json(value):
   193	    value = _q(value)
   194	    return [value.numerator, value.denominator]
   195	
   196	
   197	def _q_text(value):
   198	    value = _q(value)
   199	    if value.denominator == 1:
   200	        return str(value.numerator)
   201	    return "%d/%d" % (value.numerator, value.denominator)
