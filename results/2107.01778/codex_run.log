+        "shipping_n": ship["n"],
+        "doubled_n": doubled["n"],
+        "shipping_equations": len(ship["equations"]),
+        "doubled_equations": len(doubled["equations"]),
+        "doubled_reason": doubled_why,
+    }
+
+    invariant_checks = 0
+    transform_validity = 0
+    keys = []
