\title{Finding $d$-Cuts in Probe $H$-Free Graphs}

\titlerunning{Finding $d$-Cuts in Probe $H$-Free Graphs}


\author{Konrad K. Dabrowski\inst{1}\orcidID{0000-0001-9515-6945} 
\and Tala Eagling-Vose\inst{2}\orcidID{0009-0008-0346-7032}
