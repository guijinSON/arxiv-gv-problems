spec=importlib.util.spec_from_file_location('g','gen_2505_22351.py')
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
params=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
counts={k:0 for k in ['plant','reference','compact','spectral','degree','greedy','restart','sparse']}
t0=time.perf_counter()
for seed in range(200):
    a=g.make_instance(seed=seed,**params)
    g._assert_instance_structure(a)
    counts['plant'] += g.verify(a,a['answer'])[0]
    r,_=g._reference_min_cut_and_fit(a); counts['reference'] += r is not None and g.verify(a,r)[0]
    r,_=g._compact_kernel_route(a); counts['compact'] += r is not None and g.verify(a,r)[0]
    r,_=g._spectral_bisection_and_fit(a); counts['spectral'] += r is not None and g.verify(a,r)[0]
    counts['degree'] += g.verify(a,g._attack_degree_outlier(a))[0]
    counts['greedy'] += g.verify(a,g._attack_one_sweep_greedy(a))[0]
    counts['restart'] += g.verify(a,g._attack_random_restart(a,seed+123456))[0]
    r,_=g._attack_sparse_ansatz(a); counts['sparse'] += g.verify(a,r)[0]
for seed in range(20):
    a=g.make_instance(seed=seed,**params)
    b=g.make_instance(seed=seed,**params)
    assert a==b
    assert json.loads(json.dumps(a['answer']))==a['answer']
print(json.dumps({'instances':200,'success_counts':counts,'deterministic_checks':20,'wall_sec':time.perf_counter()-t0},sort_keys=True))
