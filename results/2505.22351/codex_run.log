+            "verified": reference_ok,
+        },
+    }
+    if not report["G5_density_and_baseline"]["pass"]:
+        raise AssertionError("G5 failed")
+
+    attack_results = {
+        "equal_degree_outlier": {"successes": 0, "attempts": 8},
