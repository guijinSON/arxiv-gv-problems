/bin/bash -lc "python3 - <<'PY'
import importlib.util, json, os
p='gen_2505_22351.py'; s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
checks=0
for preset, params in g.DIFFICULTY.items():
    for seed in range(50):
        a=g.make_instance(seed=seed, **params)
        b=g.make_instance(seed=seed, **params)
        assert a == b
        g._assert_instance_structure(a)
        witness=a['answer']; public=dict(a); public.pop('answer')
        assert g.verify(public,witness)==(True,'ok')
        assert json.loads(json.dumps(witness))==witness
        checks += 1
ship=g.make_instance(seed=987654321, **g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
wire='<answer>'+g._answer_text(ship['answer'])+'</answer>'
assert g.parse_answer('prose\\n"'```'"\\n'+wire+'\\n"'```'"\\n')==ship['answer']
old=os.environ.pop('GV_HINT_MODE',None)
try:
    text=g.render(ship)
    assert g.STRUCTURAL_HINT not in text and g.PLACEBO_HINT not in text
finally:
    if old is not None: os.environ['GV_HINT_MODE']=old
print({'deterministic_structural_certificate_checks':checks,'default_render_has_no_hint':True,'round_trip':True})
