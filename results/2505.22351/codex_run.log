+
+def _build_once(
+    n: int,
+    label_bits: int,
+    cut_size: int,
+    degree: int,
+    rng: random.Random,
+) -> dict:
+    coefficient_mask, constant = _sample_function(label_bits, rng)
+    pivot = (coefficient_mask & -coefficient_mask).bit_length() - 1
+    used: set[int] = set()
