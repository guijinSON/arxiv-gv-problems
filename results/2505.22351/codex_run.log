+        u = label_to_vertex[left_a_cross[i]]
+        v = label_to_vertex[right_b_cross[j]]
+        edges.add((min(u, v), max(u, v)))
+    for i, j in enumerate(b_to_a or []):
+        u = label_to_vertex[left_b_cross[i]]
+        v = label_to_vertex[right_a_cross[j]]
+        edges.add((min(u, v), max(u, v)))
