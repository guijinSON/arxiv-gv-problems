+# Filled from the script-owned hardening runs.  The diagnostic arms never gate
+# G9; only the answer and intended-route caps do.
+G9_EVIDENCE = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
