+    def atoms(value):
+        if isinstance(value, dict):
+            return sum(atoms(item) for item in value.values())
+        if isinstance(value, list):
+            return sum(atoms(item) for item in value)
+        return 1
+
+    return {
+        "chars": len(encoded),
+        "tokens": math.ceil(len(encoded) / 4),
+        "elements": atoms(answer),
+    }
