+
+def _is_prime(x: int) -> bool:
+    if x < 2:
+        return False
+    if x % 2 == 0:
+        return x == 2
+    d = 3
+    while d * d <= x:
+        if x % d == 0:
+            return False
+        d += 2
+    return True
+
+
+def _prime_pool(start: int, count: int) -> list[int]:
+    out: list[int] = []
+    x = max(3, start)
+    if x % 2 == 0:
+        x += 1
+    while len(out) < count:
+        if _is_prime(x):
+            out.append(x)
+        x += 2
+    return out
+
+
+def _unrank_combination(size: int, choose: int, rank: int) -> list[int]:
+    """Lexicographically unrank a choose-subset of range(size)."""
+
+    if not (0 <= choose <= size):
+        raise ValueError("records must lie between 1 and pool")
+    total = math.comb(size, choose)
+    if not (0 <= rank < total):
+        raise ValueError("combination rank out of range")
+    result: list[int] = []
+    low = 0
+    for remaining in range(choose, 0, -1):
+        for value in range(low, size):
+            tail = math.comb(size - value - 1, remaining - 1)
+            if rank < tail:
+                result.append(value)
+                low = value + 1
+                break
+            rank -= tail
+    return result
+
+
+def _target_for(q: int, alternate: bool) -> int:
+    if q % 4 == 1:
+        return -3 if alternate else 5
+    return 1 if alternate else 9
+
+
+def _design_lambda(q: int, target: int) -> int:
+    """Examples 2.3 and 2.4, with q+1 the conference order."""
+
+    if q % 4 == 1:
+        m = (q - 1) // 4  # q+1 = 4m+2
+        if target == 5:
+            return 3 * m
+        if target == -3:
+            return m - 1
+    elif q % 4 == 3:
+        m = (q + 1) // 4  # q+1 = 4m
+        if target == 9:
+            return m
+        if target == 1:
+            return 3 * (m - 1)
+    raise ValueError("target is not a 4-minor class for this conference parity")
+
+
+def _block_count(q: int, target: int) -> int:
+    # Each block contains C(4,3)=4 triples; every triple occurs lambda times.
+    numerator = _design_lambda(q, target) * math.comb(q + 1, 3)
+    if numerator % 4:
+        raise ArithmeticError("nonintegral incidence count")
+    return numerator // 4
+
+
+def _expected_counts(inst: dict) -> list[int]:
+    return [_block_count(int(rec["q"]), int(rec["target"])) for rec in inst["records"]]
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Make a theorem-backed collection of determinant-defined design questions.
+
+    No principal minors are searched while generating the certificate.  The answer
+    is carried from Examples 2.3/2.4 and the standard triple-block incidence identity.
+    """
+
+    records = int(params.pop("records", 8))
+    pool_size = int(params.pop("pool", max(records, records + 4)))
+    if params:
+        raise TypeError(f"unknown parameters: {sorted(params)}")
+    if n < 3:
+        n = 3
+    if not (1 <= records <= pool_size <= 40):
+        raise ValueError("require 1 <= records <= pool <= 40")
+
+    rng = random.Random(seed)
+    primes = _prime_pool(n, pool_size)
+    n_choices = math.comb(pool_size, records)
+    variant_base = 1 << records
+    code = int(seed) % (n_choices * variant_base)
+    combination_rank, variant_mask = divmod(code, variant_base)
+    selected = _unrank_combination(pool_size, records, combination_rank)
+
+    data = []
+    for position, prime_index in enumerate(selected):
+        q = primes[prime_index]
+        target = _target_for(q, bool((variant_mask >> position) & 1))
+        data.append(
+            {
+                "q": q,
+                "target": target,
+                "u": rng.randrange(1, q),
+                "t": rng.randrange(q),
+                "switch_r": rng.randrange(1, q),
+                "switch_s": rng.randrange(q),
+                "switch_infinity": rng.choice([-1, 1]),
+            }
+        )
+
+    rng.shuffle(data)
+    inst = {
+        "paper": "arXiv:2402.17528",
+        "family": "block counts in transformed Paley conference 3-designs",
+        "n": n,
+        "records_requested": records,
+        "prime_pool_size": pool_size,
+        "records": data,
+    }
+    inst["answer"] = _expected_counts(inst)
+    return inst
+
+
+def render(inst: dict) -> str:
+    lines = [
+        "Compute exact block counts in determinant-defined Paley conference hypergraphs.",
+        "",
+        "Definitions (everything below is over ordinary integers unless 'mod q' is written).",
+        "Each record has an odd prime q and vertex set V={infinity,0,1,...,q-1}.",
+        "For finite z, call z a nonzero quadratic residue mod q when z is congruent to x^2 mod q for some x in {1,...,q-1}.",
+        "Define the base q+1 by q+1 matrix C, with ordered rows and columns indexed by V:",
+        "  C[x,x]=0.",
+        "  For distinct finite x,y: C[x,y]=-1 if (x-y) mod q is a nonzero quadratic residue, and C[x,y]=+1 otherwise.",
+        "  C[infinity,x]=-1 for finite x. If q mod 4=1 then C[x,infinity]=-1; if q mod 4=3 then C[x,infinity]=+1.",
+        "For that record define phi(infinity)=infinity and phi(x)=(u*x+t) mod q for finite x.",
+        "Define e(infinity)=switch_infinity. For finite x, e(x)=-1 when ((switch_r*x+switch_s) mod q) < floor(q/2), and e(x)=+1 otherwise.",
+        "The handed matrix is A[x,y]=e(x)*C[phi(x),phi(y)]*e(y). Thus A is specified exactly, without floating point arithmetic.",
+        "",
+        "A 4-block is an unordered set B of four distinct vertices whose 4 by 4 principal submatrix A[B] has determinant equal to target.",
+        "For every record, report the total number of its 4-blocks. Counts are in the listed record order.",
+        "Vertex order inside a block is irrelevant; endpoints and inequalities above are inclusive exactly as written.",
+        "",
+        "Records (index: q, target, u, t, switch_r, switch_s, switch_infinity):",
+    ]
+    for idx, rec in enumerate(inst["records"]):
+        lines.append(
+            f"{idx}: {rec['q']}, {rec['target']}, {rec['u']}, {rec['t']}, "
+            f"{rec['switch_r']}, {rec['switch_s']}, {rec['switch_infinity']}"
+        )
+    lines.extend(
+        [
+            "",
+            "Give your final answer inside <answer></answer> tags, as one JSON array of nonnegative decimal integers, one per record in listed order.",
+            "Example: <answer>[15, 28, 66]</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    try:
+        match = re.search(r"<answer>(.*?)</answer>", text, re.IGNORECASE | re.DOTALL)
+        if not match:
+            return None
+        body = match.group(1).strip()
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.IGNORECASE)
+        body = re.sub(r"\s*```$", "", body).strip()
+        value = json.loads(body)
+        if not isinstance(value, list):
+            return None
+        if not all(isinstance(x, int) and not isinstance(x, bool) for x in value):
+            return None
+        return value
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+
+
+def _validate_instance_records(inst: dict) -> tuple[bool, str]:
+    records = inst.get("records")
+    if not isinstance(records, list) or not records:
+        return False, "instance has no records"
+    for idx, rec in enumerate(records):
+        if not isinstance(rec, dict):
+            return False, f"instance record {idx} is malformed"
+        needed = {"q", "target", "u", "t", "switch_r", "switch_s", "switch_infinity"}
+        if not needed.issubset(rec):
+            return False, f"instance record {idx} is incomplete"
+        q = rec["q"]
+        if not isinstance(q, int) or not _is_prime(q) or q == 2:
+            return False, f"instance record {idx} has non-prime q"
+        if not (1 <= rec["u"] < q and 0 <= rec["t"] < q):
+            return False, f"instance record {idx} has invalid affine relabelling"
+        if not (1 <= rec["switch_r"] < q and 0 <= rec["switch_s"] < q):
+            return False, f"instance record {idx} has invalid switching rule"
+        if rec["switch_infinity"] not in (-1, 1):
+            return False, f"instance record {idx} has invalid infinity sign"
+        if rec["target"] not in ((-3, 5) if q % 4 == 1 else (1, 9)):
+            return False, f"instance record {idx} has invalid target"
+    return True, "ok"
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    valid, reason = _validate_instance_records(inst)
+    if not valid:
+        return False, reason
+    if not isinstance(answer, list):
+        return False, "malformed answer: expected a JSON array"
+    expected_len = len(inst["records"])
+    if len(answer) != expected_len:
+        return False, f"length mismatch: expected {expected_len}, got {len(answer)}"
+    for idx, value in enumerate(answer):
+        if not isinstance(value, int) or isinstance(value, bool):
+            return False, f"entry {idx} is not an integer"
+        upper = math.comb(inst["records"][idx]["q"] + 1, 4)
+        if value < 0 or value > upper:
+            return False, f"entry {idx} out of range [0,{upper}]"
+    expected = _expected_counts(inst)
+    for idx, (got, want) in enumerate(zip(answer, expected)):
+        if got != want:
+            return False, f"entry {idx} incorrect"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    # Shape and each obvious counting bound are enforced before sampling.
+    return [rng.randrange(math.comb(rec["q"] + 1, 4) + 1) for rec in inst["records"]]
+
+
+def search_space(inst: dict) -> int | None:
+    product = 1
+    for rec in inst["records"]:
+        product *= math.comb(rec["q"] + 1, 4) + 1
+    return product
+
+
+def enumerate_all(inst: dict) -> int | None:
+    bounds = [math.comb(rec["q"] + 1, 4) + 1 for rec in inst["records"]]
+    space = math.prod(bounds)
+    if space > 100_000:
+        return None
+    hits = 0
+    for candidate in itertools.product(*(range(bound) for bound in bounds)):
+        if verify(inst, list(candidate))[0]:
+            hits += 1
+    return hits
+
+
+def canonical_key(inst: dict) -> str:
+    # The count problem is unchanged by record order, affine vertex relabelling,
+    # and diagonal +/-1 congruence.  q and target are the surviving invariants.
+    core = sorted((int(rec["q"]), int(rec["target"])) for rec in inst["records"])
+    payload = json.dumps(core, separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | None:
+    n = int(params["n"])
+    records = int(params.get("records", 8))
+    pool_size = int(params.get("pool", records + 4))
+    if records >= 28:
+        return None
+    return {
+        "n": n + 16,
+        "records": min(28, records + 4),
+        "pool": min(36, max(pool_size + 6, records + 6)),
+    }
+
+
+def _base_conference(q: int) -> list[list[int]]:
+    residues = {x * x % q for x in range(1, q)}
+    v = q + 1
+    matrix = [[0] * v for _ in range(v)]
+    infinity = q
+    for x in range(q):
+        for y in range(x + 1, q):
+            value = -1 if (x - y) % q in residues else 1
+            matrix[x][y] = value
+            matrix[y][x] = value if q % 4 == 1 else -value
+        matrix[infinity][x] = -1
+        matrix[x][infinity] = -1 if q % 4 == 1 else 1
+    return matrix
+
+
+def _exhaustive_counts(q: int) -> tuple[dict[int, int], int]:
+    """Reference algorithm: classify every 4x4 principal minor exactly."""
+
+    matrix = _base_conference(q)
+    symmetric = q % 4 == 1
+    counts: dict[int, int] = {}
+    tested = 0
+    for i, j, k, ell in itertools.combinations(range(q + 1), 4):
+        a = matrix[i][j]
+        b = matrix[i][k]
+        c = matrix[i][ell]
+        d = matrix[j][k]
+        e = matrix[j][ell]
+        f = matrix[k][ell]
+        if symmetric:
+            determinant = 3 - 2 * (a * b * e * f + a * c * d * f + b * c * d * e)
+        else:
+            pfaffian = a * f - b * e + c * d
+            determinant = pfaffian * pfaffian
+        counts[determinant] = counts.get(determinant, 0) + 1
+        tested += 1
+    return counts, tested
+
+
+def _attack_endpoint(inst: dict) -> list[int]:
+    return [0 if abs(rec["target"]) < 5 else math.comb(rec["q"] + 1, 4) for rec in inst["records"]]
+
+
+def _attack_half_density(inst: dict) -> list[int]:
+    return [math.comb(rec["q"] + 1, 4) // 2 for rec in inst["records"]]
+
+
+def _attack_linear_in_q(inst: dict) -> list[int]:
+    return [rec["q"] * (rec["q"] + 1) for rec in inst["records"]]
+
+
+def _answer_metrics(answer: list[int]) -> tuple[int, int, int]:
+    encoded = json.dumps(answer, separators=(",", ":"))
+    chars = len(encoded)
+    tokens = max(1, (chars + 3) // 4)
+    return chars, tokens, len(answer)
+
+
+def _g8_transform(inst: dict, mode: str) -> dict:
+    transformed = {k: v for k, v in inst.items() if k not in ("records", "answer")}
+    records = [dict(rec) for rec in inst["records"]]
+    answer = list(inst["answer"])
+    if mode in ("affine", "composed"):
+        for rec in records:
+            q = rec["q"]
+            rec["u"] = (rec["u"] * 2) % q or 1
+            rec["t"] = (rec["t"] + 1) % q
+    if mode in ("switch", "composed"):
+        for rec in records:
+            q = rec["q"]
+            rec["switch_r"] = (rec["switch_r"] + 1) % q or 1
+            rec["switch_s"] = (rec["switch_s"] + 2) % q
+            rec["switch_infinity"] *= -1
+    if mode in ("reorder", "composed"):
+        order = list(reversed(range(len(records))))
+        records = [records[i] for i in order]
+        answer = [answer[i] for i in order]
+    transformed["records"] = records
+    transformed["answer"] = answer
+    return transformed
+
+
+# Filled from the required, script-owned G9 runs after hardening.  Keeping these
+# values explicit makes selftest deterministic and prevents it from reading files.
+G9_EVIDENCE = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
+    },
+    "hinted_verdict": "pending",
+}
+
+
+def selftest() -> dict:
+    report: dict[str, object] = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
+
+    # G1: every preset, four independent seeds.
+    planted_failures = []
+    planted_tested = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17, 101):
+            inst = make_instance(seed=seed, **params)
+            planted_tested += 1
+            ok, why = verify(inst, inst["answer"])
+            if not ok:
+                planted_failures.append({"preset": preset, "seed": seed, "reason": why})
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                planted_failures.append({"preset": preset, "seed": seed, "reason": "answer not JSON-native"})
+    report["G1_planted_verifies"] = {
+        "pass": not planted_failures,
+        "tested": planted_tested,
+        "failures": planted_failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    base = make_instance(seed=0, **shipping_params)
+    answer = list(base["answer"])
+    distinct_indices = [i for i in range(1, len(answer)) if answer[i] != answer[0]]
+    j = distinct_indices[0]
+    k = distinct_indices[-1]
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": [answer[j] if i == 0 else answer[0] if i == j else x for i, x in enumerate(answer)],
+        "duplicate": [answer[0] if i == k else x for i, x in enumerate(answer)],
+        "empty": [],
+        "out_of_range": [math.comb(base["records"][0]["q"] + 1, 4) + 1] + answer[1:],
+    }
+    corruption_results = {}
+    reasons = []
+    for name, candidate in corruptions.items():
+        ok, why = verify(base, candidate)
+        corruption_results[name] = {"rejected": not ok, "reason": why}
+        reasons.append(why)
+    report["G2_rejects_corruption"] = {
+        "pass": all(item["rejected"] for item in corruption_results.values()) and len(set(reasons)) == len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "corruptions": corruption_results,
+    }
+
+    model_style = "I used the incidence identity.\n```json\n<answer>" + json.dumps(answer) + "</answer>\n```"
+    parsed = parse_answer(model_style)
+    garbage_cases = ["", "[1,2]", "<answer>not json</answer>", "<answer>[true]</answer>"]
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and all(parse_answer(x) is None for x in garbage_cases),
+        "model_style_round_trip": parsed == answer,
+        "garbage_rejected": sum(parse_answer(x) is None for x in garbage_cases),
+    }
+
+    # G4/G5 share a shipping-preset, structure-aware sample.
+    guess_rng = random.Random(240217528)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        if verify(base, random_candidate(base, guess_rng))[0]:
+            guess_hits += 1
+    guess_probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_probability,
+        "certificate_space": search_space(base),
+        "sampling_prior": "independent uniform integers within each exact counting bound",
+    }
+
+    # Benchmark a real shipping instance selecting the largest primes in the pool.
+    # Then fill the few remaining q-values so the same exact table can solve the
+    # eight varied G6 instances without repeating work.
+    pool_primes = _prime_pool(shipping_params["n"], shipping_params["pool"])
+    worst_rank = math.comb(shipping_params["pool"], shipping_params["records"]) - 1
+    worst_seed = worst_rank * (1 << shipping_params["records"])
+    benchmark_inst = make_instance(seed=worst_seed, **shipping_params)
+    benchmark_primes = sorted({rec["q"] for rec in benchmark_inst["records"]})
+    start = time.perf_counter()
+    reference_table: dict[int, dict[int, int]] = {}
+    baseline_minors = 0
+    baseline_operations = 0
+    for q in benchmark_primes:
+        counts, tested = _exhaustive_counts(q)
+        reference_table[q] = counts
+        baseline_minors += tested
+        baseline_operations += tested * (13 if q % 4 == 1 else 6)
+    baseline_seconds = time.perf_counter() - start
+
+    panel_start = time.perf_counter()
+    reference_minors = baseline_minors
+    reference_operations = baseline_operations
+    for q in pool_primes:
+        if q in reference_table:
+            continue
+        counts, tested = _exhaustive_counts(q)
+        reference_table[q] = counts
+        reference_minors += tested
+        reference_operations += tested * (13 if q % 4 == 1 else 6)
+    reference_seconds = baseline_seconds + (time.perf_counter() - panel_start)
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_exact = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": demo_exact is not None and guess_total >= 200_000 and reference_minors > 1_000_000,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_total": guess_total,
+        "shipping_density_estimate": guess_probability,
+        "demo_exact_valid_answer_count": demo_exact,
+        "baseline_wall_clock_seconds": round(baseline_seconds, 6),
+        "baseline_principal_minors": baseline_minors,
+        "baseline_arithmetic_operations": baseline_operations,
+        "baseline_seed": worst_seed,
+        "baseline_scope": "one valid hard-preset instance selecting the largest primes in its pool",
+    }
+
+    panel_seeds = []
+    n_combos = math.comb(shipping_params["pool"], shipping_params["records"])
+    stride = max(1, n_combos // 8)
+    variant_base = 1 << shipping_params["records"]
+    for i in range(8):
+        panel_seeds.append((i * stride) * variant_base + i)
+
+    attack_successes = {
+        "outlier_endpoint": 0,
+        "greedy_half_density": 0,
+        "random_restart_256": 0,
+        "in_context_linear_in_q": 0,
+    }
+    reference_successes = 0
+    for seed in panel_seeds:
+        inst = make_instance(seed=seed, **shipping_params)
+        candidates = {
+            "outlier_endpoint": _attack_endpoint(inst),
+            "greedy_half_density": _attack_half_density(inst),
+            "in_context_linear_in_q": _attack_linear_in_q(inst),
+        }
+        rr_rng = random.Random(seed ^ 0x240217528)
+        random_solved = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, rr_rng))[0]:
+                random_solved = True
+                break
+        if random_solved:
+            attack_successes["random_restart_256"] += 1
+        for name, candidate in candidates.items():
+            if verify(inst, candidate)[0]:
+                attack_successes[name] += 1
+        reference_answer = [reference_table[rec["q"]][rec["target"]] for rec in inst["records"]]
+        if verify(inst, reference_answer)[0]:
+            reference_successes += 1
+
+    attacks = {
+        name: {"successes": successes, "attempts": 8}
+        for name, successes in attack_successes.items()
+    }
+    all_attacks_failed = all(item["successes"] == 0 for item in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "exhaustive exact classification of every 4x4 principal minor",
+            "complexity": "O(sum_j (q_j+1)^4) exact integer operations",
+            "wall_clock_sec": round(reference_seconds, 6),
+            "operations": reference_operations,
+            "principal_minors": reference_minors,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=7, **doubled_params)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    base_max_q = max(rec["q"] for rec in base["records"])
+    doubled_min_q = min(rec["q"] for rec in doubled["records"])
+    base_cost = sum(math.comb(rec["q"] + 1, 4) for rec in base["records"])
+    doubled_cost = sum(math.comb(rec["q"] + 1, 4) for rec in doubled["records"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled_cost > base_cost,
+        "base_max_q": base_max_q,
+        "doubled_min_q": doubled_min_q,
+        "base_reference_minor_tests": base_cost,
+        "doubled_reference_minor_tests": doubled_cost,
+        "doubled_planted_verifies": doubled_ok,
+        "reason": doubled_why,
+    }
+
+    invariant_checks = 0
+    transformed_verify_checks = 0
+    g8_ok = True
+    for seed in range(20):
+        inst = make_instance(seed=seed, **shipping_params)
+        key = canonical_key(inst)
+        for mode in ("reorder", "affine", "switch", "composed"):
+            transformed = _g8_transform(inst, mode)
+            invariant_checks += 1
+            if canonical_key(transformed) != key:
+                g8_ok = False
+            ok, _ = verify(transformed, transformed["answer"])
+            transformed_verify_checks += 1
+            if not ok:
+                g8_ok = False
+        unchanged = _g8_transform(inst, "switch")
+        ok, _ = verify(unchanged, inst["answer"])
+        transformed_verify_checks += 1
+        if not ok:
+            g8_ok = False
+    unrelated_keys = [canonical_key(make_instance(seed=seed, **shipping_params)) for seed in range(20)]
+    distinct_keys = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": g8_ok and distinct_keys == 20,
+        "invariance_checks": invariant_checks,
+        "transformed_witness_checks": transformed_verify_checks,
+        "distinct_unrelated_keys": distinct_keys,
+        "unrelated_instances": 20,
+        "ignored_symmetries": ["record order", "affine vertex relabelling", "diagonal sign congruence"],
+    }
+
+    answer_chars, answer_tokens, answer_elements = _answer_metrics(benchmark_inst["answer"])
+    intended_ops = 8 * len(base["records"])
+    arms = G9_EVIDENCE["arms"]
+    hinted = arms["hinted"]
