+def _attack_diagonal_only(inst):
+    v, d = inst["v"], inst["diagonal"]
+    return _certificate(v, -math.comb(v, 3) * d**3, math.comb(v, 4) * d**4)
+
+
+def _attack_greedy_first_row(inst):
+    matrix = _expand_matrix(inst)
+    v = inst["v"]
+    effective = sum(matrix[0])
+    return _certificate(
