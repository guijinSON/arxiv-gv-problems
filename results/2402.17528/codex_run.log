+"""Verified problem generator for arXiv:2402.17528.
+
+The paper turns principal-minor classes of conference matrices into 3-designs.
+This module asks for exact block counts in several independently transformed
+Paley conference matrices.  It is a Track B task: exhaustive 4-subset testing
+is efficient but mechanically large, while the paper's design parameters and
+one incidence double count give a short exact route.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "Paley conference matrices over prime fields",
+        "determinant-defined 4-uniform hypergraphs",
+    ],
+    "verification_operations": [
+        "exact primality and congruence checks",
+        "exact integer binomial evaluation",
+        "3-design triple-block incidence double count",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Discard determinant-preserving relabellings and sign switchings, use the "
+        "conference-matrix 3-design parameter, and double-count triples in blocks "
+        "instead of enumerating principal minors."
+    ),
+    "hardness_basis": (
+        "Track B: exhaustive classification of all 4x4 principal minors costs "
+        "O(sum_j (q_j+1)^4); at the hard shipping preset the measured reference "
+        "run tests 34,530,140 minors (about 4 seconds on this host), whereas the "
+        "Theorem 2.2 / Examples 2.3-2.4 route takes at most 96 small exact-integer "
+        "operations after recognizing the invariant."
+    ),
+    "max_answer_tokens": 40,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 3, "records": 1, "pool": 1},
+    "easy": {"n": 5, "records": 3, "pool": 6},
+    "medium": {"n": 13, "records": 7, "pool": 12},
+    "hard": {"n": 37, "records": 12, "pool": 18},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Exploit invariance under vertex relabelling and diagonal sign congruence, then "
+    "use the conference-matrix 3-design parameters and double-count triples inside blocks."
+)
+
+PLACEBO_HINT = (
+    "Track every modular convention and ordered matrix entry carefully, then check "
+    "each requested block count before committing to the final JSON array."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON array of at most 32 nonnegative integers; entry j is bounded above "
+        "by C(q_j+1,4), the number of eligible 4-subsets in record j."
+    ),
+    "bounds": {
+        "max_entries": 32,
+        "min_value": 0,
+        "max_value_bits": 128,
+        "per_entry_upper_bound": "C(q_j+1,4)",
+    },
+}
+
+NOTES = (
+    "Section 1.4 fixes H_A(v,k,a) as the k-subsets indexing principal submatrices "
+    "of determinant a. Theorem 2.2 supplies the design criterion and its incidence "
+    "parameter. Section 2.2, especially Examples 2.3 and 2.4, gives the exact "
+    "3-design parameters for symmetric and skew-symmetric conference matrices; "
+    "Table 1 and Table 2 identify the two possible 4x4 principal minors. Remark "
+    "2.6 is the explicit easy regime avoided by not using two-eigenvalue Seidel "
+    "matrices with an eigenvalue of multiplicity one, where the resulting design "
+    "is trivial. Seeded affine relabellings and diagonal sign congruences carry all "
+    "principal minors unchanged. The outlier, half-density, random-restart, and "
+    "linear-in-q guesses are defeated by mixing both conference parities and both "
+    "minor classes from the same prime pool. The honest reference algorithm still "
+    "succeeds by enumerating every 4-subset; it is reported separately because this "
+    "is Track B."
+)
+
+
+def _is_prime(x: int) -> bool:
+    if x < 2:
+        return False
+    if x % 2 == 0:
+        return x == 2
+    d = 3
+    while d * d <= x:
+        if x % d == 0:
+            return False
+        d += 2
+    return True
+
+
+def _prime_pool(start: int, count: int) -> list[int]:
+    out: list[int] = []
+    x = max(3, start)
+    if x % 2 == 0:
+        x += 1
+    while len(out) < count:
+        if _is_prime(x):
+            out.append(x)
+        x += 2
+    return out
+
+
+def _unrank_combination(size: int, choose: int, rank: int) -> list[int]:
+    """Lexicographically unrank a choose-subset of range(size)."""
+
+    if not (0 <= choose <= size):
+        raise ValueError("records must lie between 1 and pool")
+    total = math.comb(size, choose)
+    if not (0 <= rank < total):
+        raise ValueError("combination rank out of range")
+    result: list[int] = []
+    low = 0
+    for remaining in range(choose, 0, -1):
+        for value in range(low, size):
+            tail = math.comb(size - value - 1, remaining - 1)
+            if rank < tail:
+                result.append(value)
+                low = value + 1
+                break
+            rank -= tail
+    return result
+
+
+def _target_for(q: int, alternate: bool) -> int:
+    if q % 4 == 1:
+        return -3 if alternate else 5
+    return 1 if alternate else 9
+
+
+def _design_lambda(q: int, target: int) -> int:
+    """Examples 2.3 and 2.4, with q+1 the conference order."""
+
+    if q % 4 == 1:
+        m = (q - 1) // 4  # q+1 = 4m+2
+        if target == 5:
+            return 3 * m
+        if target == -3:
+            return m - 1
+    elif q % 4 == 3:
+        m = (q + 1) // 4  # q+1 = 4m
+        if target == 9:
+            return m
+        if target == 1:
+            return 3 * (m - 1)
+    raise ValueError("target is not a 4-minor class for this conference parity")
+
+
+def _block_count(q: int, target: int) -> int:
+    # Each block contains C(4,3)=4 triples; every triple occurs lambda times.
+    numerator = _design_lambda(q, target) * math.comb(q + 1, 3)
+    if numerator % 4:
+        raise ArithmeticError("nonintegral incidence count")
+    return numerator // 4
+
+
+def _expected_counts(inst: dict) -> list[int]:
+    return [_block_count(int(rec["q"]), int(rec["target"])) for rec in inst["records"]]
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Make a theorem-backed collection of determinant-defined design questions.
+
+    No principal minors are searched while generating the certificate.  The answer
+    is carried from Examples 2.3/2.4 and the standard triple-block incidence identity.
+    """
+
+    records = int(params.pop("records", 8))
