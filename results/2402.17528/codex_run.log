        $D_S(k)$ & $\{-2,2\}$ & $\{-3,5\}$  \\
        % $D_{S+I}(k)$ & $\{-4,0\}$ & $\{-16,0\}$ \\
    \end{tabular}
    \caption{The $k\times k$ principal minors of $S+\varepsilon I$ where $S$ is a symmetric Seidel matrix of order $n \geqslant k$ and $\varepsilon = \pm 1$.}
