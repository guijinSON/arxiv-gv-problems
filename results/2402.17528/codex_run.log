+    hinted_attempts = arms["hinted"]["attempts"]
+    placebo_attempts = arms["placebo"]["attempts"]
+    hinted_rate = arms["hinted"]["solved"] / hinted_attempts if hinted_attempts else 0
+    placebo_rate = (
