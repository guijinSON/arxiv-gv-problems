+
+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "A simultaneous signed permutation preserves the spectrum, and the underlying "
+    "skew conference matrix obeys a quadratic matrix identity."
+)
+PLACEBO_HINT: str = (
