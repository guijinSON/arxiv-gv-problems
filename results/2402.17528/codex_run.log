    rng.shuffle(order)
    inverse = [0] * m
    for new, old in enumerate(order):
        inverse[old] = new
    matrix = [[natural[order[i]][order[j]] for j in range(m)] for i in range(m)]
    coeffs = [natural_answer[old] for old in order]
    pairs = [[inverse[2 * i], inverse[2 * i + 1]] for i in range(n)]
