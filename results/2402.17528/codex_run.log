+        "q": inst["q"],
+        "diagonal": inst["diagonal"],
+        "scale": inst["scale"],
+        "degrees": [inst["v"] - 3, inst["v"] - 4],
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("ascii")
