from itertools import combinations
from time import perf_counter

def primes(base, count):
 out=[]; x=max(3,base|1)
 while len(out)<count:
  ok=all(x%d for d in range(3,int(x**.5)+1,2))
  if ok:out.append(x)
  x+=2
 return out

def bench(qs):
 total=0;t=perf_counter()
 for q in qs:
  R={x*x%q for x in range(1,q)}
  v=q+1
  M=[[0]*v for _ in range(v)]
  for x in range(q):
   for y in range(x+1,q):
    xy=-1 if (x-y)%q in R else 1
    M[x][y]=xy
    M[y][x]=xy if q%4==1 else -xy
   M[q][x]=-1
   M[x][q]=-1 if q%4==1 else 1
  c={}
  sym=q%4==1
  for i,j,k,l in combinations(range(v),4):
   a=M[i][j]; b=M[i][k]; cc=M[i][l]; d=M[j][k]; e=M[j][l]; f=M[k][l]
   if sym:
    det=3-2*(a*b*e*f+a*cc*d*f+b*cc*d*e)
   else:
    pf=a*f-b*e+cc*d;det=pf*pf
   c[det]=c.get(det,0)+1
