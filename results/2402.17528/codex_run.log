+
+
+def _validate_instance(inst):
+    q = inst.get("q")
+    v = inst.get("v")
+    if not _is_int(q) or not _is_int(v) or v != q + 1:
+        return False, "instance order parameters are malformed"
+    if q % 4 != 3 or not _is_prime_64(q):
