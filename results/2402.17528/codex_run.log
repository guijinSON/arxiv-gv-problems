+    v = inst["v"]
+    square = [[0] * v for _ in range(v)]
+    for i in range(v):
+        row_i = matrix[i]
+        out_i = square[i]
+        for k in range(v):
+            left = row_i[k]
+            row_k = matrix[k]
+            for j in range(v):
+                out_i[j] += left * row_k[j]
