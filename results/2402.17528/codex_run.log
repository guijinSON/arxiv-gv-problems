\begin{theorem}\label{thm:signedcube}
Let $d$ be a positive integer with $d\geqslant 2$ and set $A = S_d$. 
Then, for each $a \in \{0,1\}$, the hypergraph $\mathfrak H_{A}(2^d,4,a)$
is a $\operatorname{PBIBD}(2^d,4;\lambda_1^{(a)},\ldots,\lambda_d^{(a)})$ on $\mathcal H(d)$ where 
\begin{align*}
    \lambda_1^{(a)} &= (1-a)\binom{2^d}{4}+(2a-1)(d^2+d(2^{d-1}-5-a)+3+a); \\
    \lambda_2^{(a)} &= (1-a)\binom{2^d}{4}+(2a-1)(d^2-3-a); \\
    \lambda_i^{(a)} &=(1-a)\binom{2^d}{4} + (2a-1)d^2, \text{ for each }i \in \{3,\dots,d\}.
\end{align*}
\end{theorem}
