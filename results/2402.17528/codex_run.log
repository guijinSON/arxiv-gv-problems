+
+
+def parse_answer(text) -> object | None:
+    """Parse the last tagged JSON value, tolerating prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
