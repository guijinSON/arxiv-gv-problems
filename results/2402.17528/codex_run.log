+    "easy": {"n": 127, "coeff_bits": 27},
+    "medium": {"n": 179, "coeff_bits": 34},
+    "hard": {"n": 251, "coeff_bits": 41},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A two-term univariate polynomial fragment in canonical JSON form: each "
