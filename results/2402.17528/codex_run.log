+    for i in range(v):
+        matrix[i][i] = diagonal
+        for j in range(i + 1, v):
+            value = (
+                scale
+                * eps[i]
+                * eps[j]
+                * _base_conference_entry(pi[i], pi[j], q, residues)
+            )
+            matrix[i][j] = value
+            matrix[j][i] = -value
+    return matrix
+
+
+def _reference_trace_newton(inst):
+    """Generic O(v^3) trace/Newton coefficient algorithm for the expanded B."""
