&=\begin{cases}
x(x^2-d)^{v-1}&\text{ if }|\alpha|=1,\\ 
(x^2-1)(x^2-d)^{v-2}&\text{ if }|\alpha|=2\text{ and }\alpha\in\tilde{R}_1,
\\ 
x^2(x^2-d)^{v-2}&\text{ if }|\alpha|=2\text{ and }\alpha\in\tilde{R}_2\cup \tilde{R}_3.
\end{cases}\label{eq:bgw}
\end{align}  
