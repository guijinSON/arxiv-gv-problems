+    c3, c4 = _coefficient_values(inst["q"], inst["diagonal"], inst["scale"])
+    if numerators[0] != c3:
+        return False, "the x^(v-3) coefficient is incorrect"
+    if numerators[1] != c4:
+        return False, "the x^(v-4) coefficient is incorrect"
