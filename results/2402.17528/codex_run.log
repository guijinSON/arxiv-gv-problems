+def _coefficient_bounds_values(v: int, diagonal: int, scale: int):
+    magnitude = max(abs(diagonal), abs(scale))
+    b3 = 6 * math.comb(v, 3) * magnitude**3
+    b4 = 16 * math.comb(v, 4) * magnitude**4
