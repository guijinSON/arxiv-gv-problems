+        "by selftest at 4,276,112 scalar operations and about 0.09 seconds, whereas "
+        "the quadratic-identity factor expansion uses at most 30 exact arithmetic "
+        "operations."
+    ),
+    "max_answer_tokens": 25,
+}
+
+NATIVE: dict = {
