+    drop.pop()
+    swapped = [copy.deepcopy(answer[1]), copy.deepcopy(answer[0])]
+    duplicate = copy.deepcopy(answer) + [copy.deepcopy(answer[0])]
+    out_of_range = copy.deepcopy(answer)
