+    "object_regime": "rational_exact",
+    "computational_core": "linear_algebra",
+    "certificate_form": "polynomial",
+    "native_objects": [
+        "signed-permuted shifted Paley conference matrix over Z",
+        "characteristic polynomial over Z[x]",
+    ],
+    "verification_operations": [
