+
+def _compact_certificate(inst):
+    c3, c4 = _coefficient_values(inst["q"], inst["diagonal"], inst["scale"])
+    return _certificate(inst["v"], c3, c4), {
+        "exact_operations": 30,
+        "factor": "((x-diagonal)^2 + q*scale^2)^((q+1)/2)",
