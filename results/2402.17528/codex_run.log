+
+def _legendre_table(q: int):
+    table = bytearray(q)
+    for value in range(1, (q + 1) // 2):
+        table[value * value % q] = 1
+    return table
+
+
+def _base_conference_entry(left: int, right: int, q: int, residues) -> int:
+    if left == right:
+        return 0
+    if left == q:
+        return -1
+    if right == q:
+        return 1
+    return -1 if residues[(left - right) % q] else 1
