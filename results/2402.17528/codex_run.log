+        "wall_clock_sec": time.perf_counter() - started,
+        "exact_operations": (
+            residue_operations
+            + entry_operations
+            + square_operations
+            + trace_operations
+            + newton_operations
+        ),
+        "matrix_order": v,
+    }
+
+
+def _attack_diagonal_only(inst):
+    v, d = inst["v"], inst["diagonal"]
