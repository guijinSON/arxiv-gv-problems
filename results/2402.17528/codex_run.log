+
+def _worst_answer_size(params):
+    q = _prime_at_least(int(params["n"]))
+    bits = int(params.get("coeff_bits", 27))
+    maximum = (1 << bits) - 1
+    c3, c4 = _coefficient_values(q, maximum, maximum)
+    return _answer_size(_certificate(q + 1, c3, c4))
