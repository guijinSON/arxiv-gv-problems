+        "n": n,
+        "q": q,
+        "v": v,
+        "coeff_bits": coeff_bits,
+        "diagonal": diagonal,
+        "scale": scale,
+        "permutation": permutation,
+        "switches": switches,
+        "bound3": bound3,
+        "bound4": bound4,
+        "answer": _certificate(v, c3, c4),
