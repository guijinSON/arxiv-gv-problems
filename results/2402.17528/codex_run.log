+    trial_inst = make_instance(seed=98765, **trial)
+    answer_chars = len(json.dumps(trial_inst["answer"], separators=(",", ":")))
+    if answer_chars > 2000:
+        return "cap_bound"
+    if next_n == current_n and next_bits == current_bits:
+        return "cap_bound"
+    return trial
