+def _expand_matrix(inst):
+    """Expand B exactly, deliberately without using its spectral shortcut."""
+    q, v = inst["q"], inst["v"]
+    residues = _legendre_table(q)
+    pi = inst["permutation"]
+    eps = inst["switches"]
