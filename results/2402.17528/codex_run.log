+        "parsed_equals_answer": parsed == answer,
+        "garbage_returns_none": parse_answer("garbage without tags") is None,
+    }
+
+    samples = 200_000
+    sample_rng = random.Random(0x240217528)
+    hits = 0
+    for _ in range(samples):
