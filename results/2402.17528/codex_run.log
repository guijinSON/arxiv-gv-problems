+        "greedy_first_row_effective_root": {"successes": 0, "attempts": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0},
+        "in_context_unscaled_quadratic_ansatz": {"successes": 0, "attempts": 0},
+    }
