+def _attack_unscaled_quadratic(inst):
+    """Obvious by-hand ansatz: use eigenvalues d +/- i*u, omitting q."""
+    c3, c4 = _coefficient_values(1, inst["diagonal"], inst["scale"])
+    return _certificate(inst["v"], c3, c4)
