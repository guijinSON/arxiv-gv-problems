+    a = -2 * diagonal
+    b = diagonal * diagonal + q * scale * scale
+    c3 = math.comb(m, 3) * a**3 + m * (m - 1) * a * b
+    c4 = (
+        math.comb(m, 4) * a**4
+        + m * math.comb(m - 1, 2) * a * a * b
+        + math.comb(m, 2) * b * b
+    )
+    return c3, c4
+
+
+def _certificate(v: int, c3: int, c4: int):
+    return [
+        [[c3, 1], [v - 3]],
+        [[c4, 1], [v - 4]],
+    ]
