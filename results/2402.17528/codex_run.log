    \label{tab:charSkew3}
\end{table}
It is clear from Table~\ref{tab:charSkew3} that $\left |C_S\left (\binom{[4n]}{i},4 \right )\right | = 1$ and $\left |C_{S+I}\left (\binom{[4n]}{i},5\right )\right | = 1$ for each $j \in \{0,1,2,3\}$.
