+
+def random_candidate(inst, rng) -> object:
+    """Sample the exact signed, bounded, fixed-support certificate language."""
+    c3 = -rng.randint(1, inst["bound3"])
+    c4 = rng.randint(0, inst["bound4"])
+    return _certificate(inst["v"], c3, c4)
