%     \centering
%     \begin{tabular}{c|c|c}
%           $k$ & $a$ & $\lambda$ \\
%         \hline
%          $3$ & $0$ & $(3n-8)/4$ \\
%         $3$ & $-4\varepsilon$ & $n/4$ \\
%         $4$ & $0$ & $(7n^2-24n+16)/16$ \\
%         $4$ & $-16$ & $n^2/16$ \\
%         % $S+I$ & $5$ & $16$ & $3(n-1)(n-2)$ \\
%         % $S+I$ & $5$ & $32$ & $5n(n-1)$ \\
%     \end{tabular}
%     % \caption{By Theorem~\ref{thm:des}, the hypergraph $\mathfrak H_{A}(v,k,a)$ is a $3$-$(4n,k,\lambda)$ design.}
%     \caption{The $2$-$(n,k,\lambda)$ designs $\mathfrak H_{S+\varepsilon I}(n,k,a)$ of Example~\ref{ex:graphHadamard}.}
%     \label{tab:graphHadamard}
% \end{table}

Note that, in order for $\lambda$ to be an integer, $n$ must be a multiple of $4$.
Various infinite families of graphical Hadamard matrices are known to exist.
We refer the reader to \cite{BrouwerBlokhuis60} for details.
\end{example}

