+        "p-splitter subset of the ground set",
+    ],
+    "verification_operations": [
+        "exact set membership",
+        "exact intersection cardinality",
+        "integer comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
