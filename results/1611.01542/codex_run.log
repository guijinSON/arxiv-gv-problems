+def _algorithm_x_reference(
+    inst: dict, node_limit: int = 500_000
+) -> tuple[list[int] | None, int]:
+    """Domain-standard exact-cover search with minimum-column branching.
+
+    Bit masks implement Algorithm X's cover/delete steps exactly.  Returning
+    ``None`` at the explicit node cap is a failed attack, never a certificate.
+    """
+
+    labels = list(inst["universe"])
+    label_index = {label: i for i, label in enumerate(labels)}
+    row_count = len(inst["sets"])
+    label_count = len(labels)
+
+    row_label_masks = [0] * row_count
+    for row_index, row in enumerate(inst["sets"]):
+        for label in row:
+            row_label_masks[row_index] |= 1 << label_index[label]
+
+    label_row_masks = [0] * label_count
+    for row_index, row in enumerate(inst["sets"]):
+        for label in row:
+            label_row_masks[label_index[label]] |= 1 << row_index
+
+    conflict_masks = [0] * label_count
+    for label_i, covered_rows in enumerate(label_row_masks):
+        pending = covered_rows
+        while pending:
+            bit = pending & -pending
+            row_index = bit.bit_length() - 1
+            pending -= bit
+            conflict_masks[label_i] |= row_label_masks[row_index]
+
+    nodes = 0
+
+    def search(uncovered: int, available: int, chosen: list[int]) -> list[int] | bool | None:
+        nonlocal nodes
+        nodes += 1
+        if nodes > node_limit:
+            return None
+        if not uncovered:
+            return chosen
+
+        pending = uncovered
+        best_options = 0
+        best_count = label_count + 1
+        while pending:
+            bit = pending & -pending
+            row_index = bit.bit_length() - 1
+            pending -= bit
+            options = row_label_masks[row_index] & available
+            count = options.bit_count()
+            if count == 0:
+                return False
+            if count < best_count:
+                best_count = count
+                best_options = options
+
+        options = best_options
+        while options:
+            bit = options & -options
+            label_i = bit.bit_length() - 1
+            options -= bit
+            result = search(
+                uncovered & ~label_row_masks[label_i],
+                available & ~conflict_masks[label_i],
+                chosen + [labels[label_i]],
+            )
+            if result is None:
+                return None
+            if result is not False:
+                return result
+        return False
+
+    result = search((1 << row_count) - 1, (1 << label_count) - 1, [])
+    if isinstance(result, list):
+        return sorted(result), nodes
+    return None, nodes
+
+
+def _first_pair_progression(inst: dict) -> list[int]:
+    labels = inst["universe"]
+    start, second = labels[0], labels[1]
+    step = (second - start) % inst["prime"]
+    return sorted((start + i * step) % inst["prime"] for i in range(inst["n"]))
+
+
+def _answer_sizes(answer: object) -> tuple[int, int, int]:
+    # Match emit.sh's ordinary json.dumps serialization, including separators.
+    blob = json.dumps(answer)
+
+    def atoms(value: object) -> int:
+        if isinstance(value, dict):
+            return sum(atoms(v) for v in value.values())
+        if isinstance(value, (list, tuple)):
+            return sum(atoms(v) for v in value)
+        return 1
 
