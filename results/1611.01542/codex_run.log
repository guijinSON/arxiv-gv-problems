+    "native_objects": [
+        "finite subsets of a labelled binary-vector universe",
+        "a common XOR translation",
+        "an affine parity-defined splitter",
+    ],
+    "verification_operations": [
+        "exact XOR translation of set elements",
+        "exact set-membership comparison",
+        "exact GF(2) inner product",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "All sets have the same fixed-point-free XOR translation, so an affine "
+        "parity functional that flips under that translation chooses one element "
+        "from every translation pair; without the symmetry one searches set "
+        "stabilizers element by element."
+    ),
+    # Updated after the script-owned oracle run fixes the shipping preset.  The
+    # numerical values are measured by selftest over eight shipping instances.
+    "hardness_basis": (
+        "Track B: anchored XOR-stabilizer search is O(m*s^2) in the worst case "
+        "for m sets of size s and is measured at the shipping preset in G5/G6; "
+        "the compact route intersects the two anchored difference lists in at "
+        "most 2*s+1 exact XOR/parity operations, which is not realistically "
+        "executable without scratch tools on the displayed decimal data."
+    ),
+    "max_answer_tokens": 24,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
