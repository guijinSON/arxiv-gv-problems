def gen(k,q,d,seed):
 r=random.Random(seed); V=k*q
 plant=[]; verts=list(range(V));r.shuffle(verts)
 for i in range(k):plant.append(tuple(sorted(verts[i*q:(i+1)*q])))
 for attempt in range(10000):
  st=[v for v in range(V) for _ in range(d-1)];r.shuffle(st)
  dec=[tuple(sorted(st[i:i+q])) for i in range(0,len(st),q)]
  edges=plant+dec
  if all(len(set(e))==q for e in dec) and len(set(dec))==len(dec) and not set(dec)&set(plant):break
 else:raise ValueError('fail')
 perm=list(range(V));r.shuffle(perm); edges=[tuple(sorted(perm[x] for x in e)) for e in edges]
 order=list(range(len(edges)));r.shuffle(order); inv={old:new for new,old in enumerate(order)};edges=[edges[i] for i in order]
 ans={inv[i] for i in range(k)}
 return V,edges,ans

def verify(edges,V,cand):
 cov=[0]*V
 for i in cand:
  for v in edges[i]:cov[v]+=1
 return all(x==1 for x in cov)

def algx(edges,V,cap=1000000,branch='first'):
 inc=[[] for _ in range(V)]
 for i,e in enumerate(edges):
  for v in e:inc[v].append(i)
 nodes=0
 def rec(uncovered,avail,sol):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return 'cap'
  if not uncovered:return sol
  best=min(uncovered,key=lambda v:sum(e in avail for e in inc[v]))
  opts=[e for e in inc[best] if e in avail]
  if not opts:return None
  if branch=='impact':opts.sort(key=lambda ei:-sum(len(inc[v]) for v in edges[ei]))
  for ei in opts:
   touched=set(edges[ei]); bad=set()
   for v in touched:bad.update(inc[v])
   r=rec(uncovered-touched,avail-bad,sol+[ei])
   if r=='cap':return r
   if r is not None:return r
  return None
 t=time.perf_counter();s=rec(set(range(V)),set(range(len(edges))),[]);return s,nodes,time.perf_counter()-t

def greedy(edges,V,tries=1,seed=1):
 rr=random.Random(seed);inc=[[] for _ in range(V)]
 for i,e in enumerate(edges):
  for v in e:inc[v].append(i)
 for z in range(tries):
  unc=set(range(V));av=set(range(len(edges)));sol=[]
  while unc:
   v=min(unc,key=lambda x:sum(e in av for e in inc[x]));op=[e for e in inc[v] if e in av]
   if not op:break
   rr.shuffle(op);ei=op[0];sol.append(ei);t=set(edges[ei]);bad=set()
   for x in t:bad.update(inc[x])
   unc-=t;av-=bad
  if not unc:return sol
 return None

