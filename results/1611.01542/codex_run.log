import random,time,math

def gen(N, alpha, seed, w=4):
    rng=random.Random(seed); k=N//w
    planted=set(rng.sample(range(N),k)); un=[i for i in range(N) if i not in planted]
    clauses=[]; seen=set()
    while len(clauses)<round(alpha*N):
        c=tuple(sorted([rng.choice(tuple(planted))]+rng.sample(un,w-1)))
        if c not in seen: seen.add(c); clauses.append(c)
    perm=list(range(N)); rng.shuffle(perm)
    clauses=[tuple(perm[x] for x in c) for c in clauses]
    ans={perm[x] for x in planted}
    rng.shuffle(clauses)
    return clauses,ans,k

def verify(cand,clauses,k):
    return len(cand)==k and all(sum(x in cand for x in c)==1 for c in clauses)

def dpll(clauses,N,k,cap=200000):
  occ=[[] for _ in range(N)]
  for ci,c in enumerate(clauses):
    for v in c: occ[v].append(ci)
  nodes=0
  def prop(a):
    while True:
      ch=False; ones=sum(x==1 for x in a); us=[i for i,x in enumerate(a) if x<0]
      if ones>k or ones+len(us)<k:return None
      if ones==k:
       for i in us:a[i]=0;ch=True
      elif ones+len(us)==k:
       for i in us:a[i]=1;ch=True
      for c in clauses:
       s=sum(a[v]==1 for v in c); uu=[v for v in c if a[v]<0]
       if s>1 or s==0 and not uu:return None
       if s==1:
        for v in uu:a[v]=0;ch=True
       elif len(uu)==1:a[uu[0]]=1;ch=True
      if not ch:return a
  def rec(a):
    nonlocal nodes
    nodes+=1
    if nodes>cap:return 'cap'
    a=prop(a)
    if a is None:return None
    if all(x>=0 for x in a):return a
    scores=[]
    for v,x in enumerate(a):
      if x<0:
       score=sum(1 for ci in occ[v] if not any(a[z]==1 for z in clauses[ci]))
       scores.append((score,v))
    v=max(scores)[1]
    for val in (1,0):
      b=a[:];b[v]=val;r=rec(b)
      if r=='cap':return r
      if r is not None:return r
    return None
  t=time.perf_counter(); sol=rec([-1]*N);return sol,nodes,time.perf_counter()-t

def outliers(clauses,N,k):
 d=[0]*N
 for c in clauses:
  for v in c:d[v]+=1
 lo=set(sorted(range(N),key=lambda x:(d[x],x))[:k])
 hi=set(sorted(range(N),key=lambda x:(-d[x],x))[:k])
 return lo,hi

def spectral(clauses,N,k,it=200):
 # centered cooccurrence off diag, use lowest eigenvector by power on shift dmax I-A
 adj=[{} for _ in range(N)]
 for c in clauses:
  for i in range(len(c)):
   for j in range(i+1,len(c)):
    a,b=c[i],c[j];adj[a][b]=adj[a].get(b,0)+1;adj[b][a]=adj[b].get(a,0)+1
 # power largest abs centered adjacency; test tails of vector for plant
 rng=random.Random(99); x=[rng.random()-.5 for _ in range(N)]
 for _ in range(it):
  mean=sum(x)/N
  y=[sum(w*(x[j]-mean) for j,w in adj[i].items()) for i in range(N)]
  ym=sum(y)/N;y=[v-ym for v in y];norm=math.sqrt(sum(v*v for v in y))
  if not norm:break
  x=[v/norm for v in y]
 return set(sorted(range(N),key=lambda i:x[i])[:k]),set(sorted(range(N),key=lambda i:-x[i])[:k])

for N in (48,64,80,96,112,128):
 for alpha in (.5,.65,.75,.85,.95):
  stats=[];sp=0;out=0
  for seed in range(4):
   cs,ans,k=gen(N,alpha,seed)
   sol,nodes,sec=dpll(cs,N,k,100000)
   ok=sol not in (None,'cap')
   l,h=outliers(cs,N,k);out+=verify(l,cs,k) or verify(h,cs,k)
   sl,sh=spectral(cs,N,k);sp+=verify(sl,cs,k) or verify(sh,cs,k)
   stats.append((nodes, round(sec,3),ok,sol=='cap'))
  print(N,alpha,stats,'spec',sp,'out',out)
 print()
