+        "hinted_verdict": _G9_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": inst["n"] - 1,
+        "caps_pass": within_caps,
