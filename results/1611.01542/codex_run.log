+        "Track B: exhaustive modular-progression detection solves every shipping "
+        "instance in O((dn)^2 n), measured at 1,592,000 modular advances, while "
+        "the domain-standard Algorithm X exact-cover search is also measured in "
+        "G5/G6; recognizing the planted start and step leaves 39 modular additions. "
+        "Theorem 2.1 supplies the general p-SPLIT context, not an average-case claim "
+        "for this planted distribution."
+    ),
+    "max_answer_tokens": 80,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
