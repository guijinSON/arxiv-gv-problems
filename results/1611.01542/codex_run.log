import random,time,statistics

def gen(n,d,seed):
 r=random.Random(seed); k=n//3; plant=set(r.sample(range(n),k)); P=[x for x in plant for _ in range(d)];N=[x for x in range(n) if x not in plant for _ in range(d)]
 for z in range(1000):
  r.shuffle(P);r.shuffle(N); cs=[];seen=set()
  for i,p in enumerate(P):
   a,b=N[2*i:2*i+2];t=tuple(sorted((p,a,b)))
   if a==b or t in seen:break
   seen.add(t);cs.append(t)
  else:return cs,plant
 raise Exception

def solve(n,cs,limit):
 occ=[[] for _ in range(n)]
 for ci,c in enumerate(cs):
  for v in c:occ[v].append(ci)
 a=[-1]*n; nodes=0
 def prop(q):
  while q:
   v=q.pop()
   for ci in occ[v]:
    c=cs[ci];nt=sum(a[x]==1 for x in c);un=[x for x in c if a[x]<0]
    if nt>1 or nt==0 and not un:return False
    if nt==1:
     for x in un:a[x]=0;q.append(x)
    elif len(un)==1:a[un[0]]=1;q.append(un[0])
  return True
 def rec():
  nonlocal nodes
  nodes+=1
  if nodes>limit:return None
  if all(x>=0 for x in a):return a.copy()
  # choose var from shortest unresolved constraint, max degree tie
  cand=None;score=None
  for c in cs:
   un=[v for v in c if a[v]<0]
   if un:
    sc=(len(un),-sum(len(occ[v]) for v in un))
    if score is None or sc<score:score=sc;cand=max(un,key=lambda v:len(occ[v]))
  snap=a.copy()
  for val in (0,1):
   a[cand]=val
   if prop([cand]):
    z=rec()
    if z is not False:return z
   a[:]=snap
  return False
 t=time.perf_counter();z=rec();return z,nodes,time.perf_counter()-t
for n in (300,450,600):
