import gen_1611_01542 as g,time

def dlx(inst,limit=2_000_000):
 cols=g._column_rows(inst); R=len(inst['sets']); allm=(1<<R)-1
 lm={lab:sum(1<<r for r in rs) for lab,rs in cols.items()}
 byrow=[[] for _ in range(R)]
 for lab,rs in cols.items():
  for r in rs:byrow[r].append(lab)
 nodes=0
 def rec(cov,sol):
  nonlocal nodes
  nodes+=1
  if nodes>limit:return None
  if cov==allm:return sol
  # row w/fewest compatible columns
  best=None;opts=None
  unc=allm"'^cov
  while unc:
   b=unc&-unc;r=b.bit_length()-1;unc-=b
   oo=[x for x in byrow[r] if not(lm[x]&cov)]
   if not oo:return False
   if opts is None or len(oo)<len(opts):best=r;opts=oo
  for x in opts:
   z=rec(cov|lm[x],sol+[x])
   if z is None:return None
   if z is not False:return z
  return False
 st=time.perf_counter();z=rec(0,[]);return z,nodes,time.perf_counter()-st
