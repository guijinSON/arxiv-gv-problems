+"""Verified generator for XOR-periodic set-splitting instances.
+
+The native objects are the finite set systems of arXiv:1611.01542.  Every
+generated Venn region is assembled from pairs {x, x XOR t}; Lemma 4.1 (the
+Reduction Lemma) therefore supplies a splitter by construction.  The answer is
+a short exact description of that splitter, not an enumeration of half of a
+2**n-element universe.
+
+This module is deterministic for (n, seed, params), uses only the standard
+library, and performs no file I/O or printing at import time.
+"""
+
+from __future__ import annotations
+
+import bisect
+import hashlib
+import itertools
+import json
+import math
+import random
+import re
+import time
+from collections import Counter
+from typing import Any
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "linear_algebra",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "finite subsets of a labelled binary-vector universe",
+        "a common XOR translation",
+        "an affine parity-defined splitter",
+    ],
+    "verification_operations": [
+        "exact XOR translation of set elements",
+        "exact set-membership comparison",
+        "exact GF(2) inner product",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "All sets have the same fixed-point-free XOR translation, so an affine "
+        "parity functional that flips under that translation chooses one element "
+        "from every translation pair; without the symmetry one searches set "
+        "stabilizers element by element."
+    ),
+    # Updated after the script-owned oracle run fixes the shipping preset.  The
+    # numerical values are measured by selftest over eight shipping instances.
+    "hardness_basis": (
+        "Track B: anchored XOR-stabilizer search is O(m*s^2) in the worst case "
+        "for m sets of size s and is measured at the shipping preset in G5/G6; "
+        "the compact route intersects the two anchored difference lists in at "
+        "most 2*s+1 exact XOR/parity operations, which is not realistically "
+        "executable without scratch tools on the displayed decimal data."
+    ),
+    "max_answer_tokens": 24,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON array [t,a,b] of three integers: nonzero n-bit XOR translation "
+        "t, n-bit parity mask a with parity(a AND t)=1, and affine bit b in {0,1}."
+    ),
+    "bounds": {
+        "array_length": 3,
+        "translation_minimum": 1,
+        "translation_maximum": "2^n-1",
+        "selector_minimum": 0,
+        "selector_maximum": "2^n-1",
+        "phase_values": [0, 1],
+        "selector_translation_inner_product": 1,
+    },
+}
+
+DIFFICULTY = {
+    "demo": {"n": 8, "set_count": 3, "pairs_per_set": 3, "pool_orbits": 12},
+    "easy": {"n": 24, "set_count": 40, "pairs_per_set": 20, "pool_orbits": 80},
+    "medium": {"n": 28, "set_count": 80, "pairs_per_set": 28, "pool_orbits": 168},
+    "hard": {"n": 32, "set_count": 128, "pairs_per_set": 32, "pool_orbits": 256},
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Every displayed set has the same fixed-point-free XOR-translation symmetry in its n-bit labels."
+)
+PLACEBO_HINT = (
+    "The decimal labels and fixed set sizes reward careful bookkeeping throughout the calculation."
+)
+
+# Filled from the script-owned transcripts after the three arms have run.
+G9_MEASUREMENTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+NOTES = r"""
+Definition. Section 1 defines a 1/2-splitter S by the exact conditions
+|S intersect B_i| in {floor(|B_i|/2), ceil(|B_i|/2)}.  All generated sets have
+even size, so the target here is exactly half.  Section 4, Lemma 4.1 (the
+Reduction Lemma), is the construction theorem: adding an even number of
+elements to any Venn region preserves splittability, with the proof choosing
+half of the new elements in every region.  Our two elements x and x XOR t have
+identical incidence columns, hence lie in the same Venn region.  The affine
+parity selector chooses exactly one from each such pair.
+
+Step-0 algorithm question. Theorem 2.1 proves general p-SPLIT NP-complete for
+every fixed 0<p<1, but it does not prove this inverse-generated distribution
+hard.  Indeed this distribution has an efficient exact method: anchor one
+element of a set, try its XOR differences to the other elements, and validate
+each candidate translation against all sets.  This is reported as the
+successful Track B reference algorithm, never as a failing Track A attack.
+The compact route uses the fact that the anchored-difference lists of the first
+two displayed sets have exactly one common nonzero value; their intersection
+costs 2s XORs instead of validating candidates throughout the full instance.
+
+Easy regimes. Section 3 proves every collection of at most two sets is
+p-splittable and characterizes collections of at most three sets.  Section 4
+classifies the four-set 1/2 case (with its stated computer-check caveat), and
+Theorem 4.5 shows that sufficiently populated multiplicity-one Venn regions
+force splittability.  The module avoids claiming complexity hardness from any
+of these results and uses at least 24 sets outside the hand-scale demo.
+
+Planting defenses. The hidden translation has even, non-extreme Hamming weight.
+Every displayed set is a uniform sample of whole translation orbits from the
+same random pool; there is no distinguished planted element.  Each set is
+checked during construction to have stabilizer exactly {0,t}, and the first
+two anchored difference lists are checked to intersect only in {0,t}.  Lists
+are sorted, and the translation is rejected if it equals the first adjacent
+difference or the extrema difference.  The adversary panel tests degree
+outliers, adjacent/extrema XORs, whole-set XOR, half-balanced bits, and random
+translation restarts.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def _validate_params(n: int, set_count: int, pairs_per_set: int,
+                     pool_orbits: int) -> None:
+    vals = (n, set_count, pairs_per_set, pool_orbits)
+    if any(type(v) is not int for v in vals):
+        raise ValueError("all parameters must be integers")
+    if not (6 <= n <= 128):
+        raise ValueError("n must lie in 6..128")
+    if set_count < 2:
+        raise ValueError("set_count must be at least 2")
+    if pairs_per_set < 3 or pairs_per_set > pool_orbits:
+        raise ValueError("pairs_per_set must lie in 3..pool_orbits")
+    if pool_orbits >= (1 << (n - 1)):
+        raise ValueError("pool_orbits is too large for the quotient universe")
+
+
+def _parity(x: int) -> int:
+    return x.bit_count() & 1
+
+
+def _preserves_hash(row: list[int], translation: int) -> bool:
+    lookup = set(row)
+    return all((x ^ translation) in lookup for x in row)
+
+
+def _preserves_sorted(row: list[int], translation: int) -> bool:
+    for x in row:
+        y = x ^ translation
+        pos = bisect.bisect_left(row, y)
+        if pos == len(row) or row[pos] != y:
+            return False
+    return True
+
+
+def _stabilizers(row: list[int]) -> set[int]:
+    """All XOR translations preserving a nonempty finite row.
+
+    A stabilizer must send row[0] to another member, so these candidates are
+    complete; this bounded construction check never discovers the planted t.
+    """
+    anchor = row[0]
+    return {anchor ^ y for y in row if _preserves_hash(row, anchor ^ y)}
+
+
+def _anchored_differences(row: list[int]) -> set[int]:
+    return {row[0] ^ y for y in row}
+
+
+def _make_orbit_pool(n: int, translation: int, count: int,
+                     rng: random.Random) -> list[tuple[int, int]]:
+    mask = (1 << n) - 1
+    seen: set[int] = set()
+    out = []
+    while len(out) < count:
+        x = rng.getrandbits(n) & mask
+        y = x ^ translation
+        representative = min(x, y)
+        if representative in seen:
+            continue
+        seen.add(representative)
+        out.append((representative, representative ^ translation))
+    return out
+
+
+def _sample_row(pool: list[tuple[int, int]], pairs_per_set: int,
+                translation: int, rng: random.Random) -> list[int]:
+    for _ in range(20_000):
+        orbit_ids = rng.sample(range(len(pool)), pairs_per_set)
+        row = sorted(itertools.chain.from_iterable(pool[i] for i in orbit_ids))
+        if _stabilizers(row) != {0, translation}:
+            continue
+        if row[0] ^ row[1] == translation:
+            continue
+        if row[0] ^ row[-1] == translation:
+            continue
+        # Defeat the tempting but incomplete inference that precisely the bit
+        # positions balanced in one row must be the translation support.
+        half_mask = 0
+        half = len(row) // 2
+        n = max(row).bit_length()
+        for bit in range(n):
+            if sum((x >> bit) & 1 for x in row) == half:
+                half_mask |= 1 << bit
+        if pairs_per_set % 2 == 0 and half_mask == translation:
+            continue
+        return row
+    raise RuntimeError("could not sample a row with a unique planted stabilizer")
+
+
+def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
+    """Inverse-generate an exactly splittable finite set system.
+
+    ``n`` is the number of bits in every ground-element label, so the ambient
+    universe is 0..2**n-1.  Difficulty grows with n and with the number/size of
+    displayed sets while the submitted certificate remains three integers.
+    """
+    set_count = params.pop("set_count", 24)
+    pairs_per_set = params.pop("pairs_per_set", 16)
+    pool_orbits = params.pop("pool_orbits", max(4 * pairs_per_set, 64))
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    _validate_params(n, set_count, pairs_per_set, pool_orbits)
+
+    rng = random.Random(seed)
+    low_weight = max(2, n // 3)
+    high_weight = min(n - 2, (2 * n) // 3)
+    while True:
+        translation = rng.getrandbits(n)
+        weight = translation.bit_count()
+        if translation and low_weight <= weight <= high_weight and weight % 2 == 0:
+            break
+
+    while True:
+        selector = rng.getrandbits(n)
+        if _parity(selector & translation) == 1:
+            break
+    phase = rng.getrandbits(1)
+
+    pool = _make_orbit_pool(n, translation, pool_orbits, rng)
+    rows: list[list[int]] = []
+    rows.append(_sample_row(pool, pairs_per_set, translation, rng))
+    for row_index in range(1, set_count):
+        for _ in range(20_000):
+            candidate = _sample_row(pool, pairs_per_set, translation, rng)
+            if row_index == 1:
+                common = (_anchored_differences(rows[0])
+                          & _anchored_differences(candidate))
+                if common != {0, translation}:
+                    continue
+            if candidate not in rows:
+                rows.append(candidate)
+                break
+        else:
+            raise RuntimeError("could not complete the set collection")
+
+    return {
+        "n": n,
+        "set_count": set_count,
+        "pairs_per_set": pairs_per_set,
+        "pool_orbits": pool_orbits,
+        "sets": rows,
+        "answer": [translation, selector, phase],
+    }
+
+
+def render(inst: dict) -> str:
+    """Render a complete problem statement, with hints off by default."""
+    n = int(inst["n"])
+    rows = inst["sets"]
+    lines = "\n".join(f"B{i} = " + " ".join(map(str, row))
+                      for i, row in enumerate(rows))
+    statement = f"""XOR-PERIODIC SET SPLITTER
+
+The ambient universe is every integer from 0 through {2 ** n - 1}, inclusive.
+Interpret each integer by its unique {n}-bit binary expansion (leading zeroes
+included).  XOR means bitwise exclusive-or on those {n} bits, AND means
+bitwise conjunction, and parity(z) is the number of 1-bits of z modulo 2.
+
+Below are {len(rows)} finite sets B0,...,B{len(rows) - 1}.  Every line lists all
+members of that set once, in increasing order.  A 1/2-splitter is a subset S
+of the ambient universe satisfying |S intersect Bi| = |Bi|/2 for every i.
+All displayed set sizes are even, so there is no rounding ambiguity.
+
+Submit a symbolic splitter as exactly three decimal integers [t,a,b].  They
+must obey 1 <= t < 2^{n}, 0 <= a < 2^{n}, b in {{0,1}}, and parity(a AND t)=1.
+They define the concrete subset
+
+    S = {{x in 0..2^{n}-1 : parity(a AND x) = b}}.
+
+For the certificate to be valid, XOR by t must permute every displayed set:
+for every i and every x in Bi, x XOR t must also be in Bi.  These conditions
+make XOR by t pair the members of each Bi while the parity rule selects exactly
+one member of each pair, so S is a 1/2-splitter.  A valid certificate is
+guaranteed to exist; any valid [t,a,b] is accepted.
+
+SETS
+{lines}
+
+Give your final answer inside <answer></answer> tags, as one JSON array of
+exactly three decimal integers [t,a,b].
+Example of syntax only: <answer>[37, 8, 1]</answer>
+Output nothing else inside the tags."""
+    mode = __import__("os").environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the last tagged JSON triple, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    for body in reversed(_ANSWER_RE.findall(text)):
+        body = body.strip()
+        if body.startswith("```") and body.endswith("```"):
+            parts = body.splitlines()
+            if len(parts) >= 3:
+                body = "\n".join(parts[1:-1]).strip()
+        try:
+            value = json.loads(body)
+        except (ValueError, TypeError):
+            continue
+        if isinstance(value, list) and all(type(x) is int for x in value):
+            return value
+    return None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any symbolic splitter without consulting ``inst['answer']``."""
+    n = inst.get("n")
+    rows = inst.get("sets")
+    if type(n) is not int or not isinstance(rows, list) or not rows:
+        return False, "invalid instance"
+    if not isinstance(answer, list):
+        return False, "answer is not a JSON array"
+    if not answer:
+        return False, "answer array is empty"
+    if len(answer) != 3:
+        return False, f"wrong array length: expected 3, got {len(answer)}"
+    if any(type(x) is not int for x in answer):
+        return False, "all three entries must be integers"
+    translation, selector, phase = answer
+    bound = 1 << n
+    if not (0 <= translation < bound and 0 <= selector < bound):
+        return False, f"translation and selector must lie in 0..{bound - 1}"
+    if translation == 0:
+        return False, "translation must be nonzero"
+    if phase not in (0, 1):
+        return False, "phase must be 0 or 1"
+    if _parity(selector & translation) != 1:
+        return False, "selector does not flip under the translation"
+    for i, row in enumerate(rows):
+        if not isinstance(row, list) or not row:
+            return False, f"invalid instance set B{i}"
+        if not _preserves_sorted(row, translation):
+            return False, f"translation does not preserve set B{i}"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly after enforcing the stated dot-product constraint."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    n = int(inst["n"])
+    translation = rng.randrange(1, 1 << n)
+    while True:
+        selector = rng.getrandbits(n)
+        if _parity(selector & translation) == 1:
+            break
+    return [translation, selector, rng.getrandbits(1)]
+
+
+def search_space(inst: dict) -> int | None:
+    """Exact size of the bounded, structure-aware certificate language."""
+    n = int(inst["n"])
+    return ((1 << n) - 1) * (1 << n)
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count valid certificates exactly when at most 100,000 exist."""
+    total = search_space(inst)
+    if total is None or total > 100_000:
+        return None
+    count = 0
+    rng_n = 1 << int(inst["n"])
+    for translation in range(1, rng_n):
+        if not all(_preserves_sorted(row, translation) for row in inst["sets"]):
+            continue
+        for selector in range(rng_n):
+            if _parity(selector & translation) == 1:
+                count += 2
+    return count
+
+
+def _active_degree_histogram(inst: dict) -> list[tuple[int, int]]:
+    degrees = Counter(x for row in inst["sets"] for x in row)
+    return sorted(Counter(degrees.values()).items())
+
+
+def canonical_key(inst: dict) -> str:
+    """Strong incidence invariant under set, element, and affine relabelling."""
+    row_sets = [set(row) for row in inst["sets"]]
+    profiles = []
+    for i, row in enumerate(row_sets):
+        profiles.append(sorted(len(row & other) for j, other in enumerate(row_sets)
+                               if i != j))
+    payload = {
+        "n": int(inst["n"]),
+        "sizes": sorted(map(len, row_sets)),
+        "intersection_profiles": sorted(profiles),
+        "element_degree_histogram": _active_degree_histogram(inst),
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(raw.encode()).hexdigest()
+
+
+def _apply_linear(columns: list[int], value: int) -> int:
+    out = 0
+    bit = 0
+    while value:
+        if value & 1:
+            out ^= columns[bit]
+        bit += 1
+        value >>= 1
+    return out
+
+
+def _inverse_rows(columns: list[int], n: int) -> list[int]:
+    rows = []
+    for r in range(n):
+        left = sum((((columns[c] >> r) & 1) << c) for c in range(n))
+        rows.append(left | (1 << (n + r)))
+    for col in range(n):
+        pivot = next(r for r in range(col, n) if (rows[r] >> col) & 1)
+        rows[col], rows[pivot] = rows[pivot], rows[col]
+        for r in range(n):
+            if r != col and ((rows[r] >> col) & 1):
+                rows[r] ^= rows[col]
+    mask = (1 << n) - 1
+    return [(row >> n) & mask for row in rows]
+
+
+def _random_linear_map(n: int, rng: random.Random) -> list[int]:
+    columns = [1 << i for i in range(n)]
+    for _ in range(4 * n):
+        i, j = rng.sample(range(n), 2)
+        if rng.getrandbits(1):
+            columns[i], columns[j] = columns[j], columns[i]
+        else:
+            columns[j] ^= columns[i]
+    return columns
+
+
+def _transform_for_g8(inst: dict, seed: int) -> tuple[dict, list[int]]:
+    rng = random.Random(seed)
+    n = int(inst["n"])
+    columns = _random_linear_map(n, rng)
+    inv_rows = _inverse_rows(columns, n)
+    shift = rng.getrandbits(n)
+    transformed_rows = [sorted(_apply_linear(columns, x) ^ shift for x in row)
+                        for row in inst["sets"]]
+    rng.shuffle(transformed_rows)
+
+    translation, selector, phase = inst["answer"]
+    new_translation = _apply_linear(columns, translation)
+    # selector' = selector^T L^-1, assembled one output coefficient at a time.
+    new_selector = 0
+    for j in range(n):
+        coeff = 0
+        for i in range(n):
+            coeff ^= ((selector >> i) & 1) & ((inv_rows[i] >> j) & 1)
+        new_selector |= coeff << j
+    new_phase = phase ^ _parity(new_selector & shift)
+    carried = [new_translation, new_selector, new_phase]
+    out = {
+        "n": n,
+        "set_count": int(inst["set_count"]),
+        "pairs_per_set": int(inst["pairs_per_set"]),
+        "pool_orbits": int(inst["pool_orbits"]),
+        "sets": transformed_rows,
+        "answer": carried,
+    }
+    return out, carried
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow the checked haystack while retaining a three-integer witness."""
+    out = {k: v for k, v in params.items() if k != "_preset"}
+    n = int(out.get("n", 20))
+    if n >= 120:
+        return None
+    out["n"] = min(120, n + 8)
+    out["set_count"] = min(256, max(32, int(out.get("set_count", 24)) * 2))
+    out["pairs_per_set"] = min(48, max(16, int(out.get("pairs_per_set", 16)) + 4))
+    out["pool_orbits"] = max(int(out.get("pool_orbits", 64)),
+                              4 * int(out["pairs_per_set"]))
+    return out
+
+
+def _candidate_for_translation(inst: dict, translation: int) -> list[int]:
+    if translation <= 0 or translation >= (1 << int(inst["n"])):
+        return [translation, 0, 0]
+    selector = translation & -translation
+    return [translation, selector, 0]
+
+
+def _attack_candidates(inst: dict, rng: random.Random) -> dict[str, object]:
+    first = inst["sets"][0]
+    degrees = Counter(x for row in inst["sets"] for x in row)
+    ordered = sorted(degrees, key=lambda x: (-degrees[x], x))
+    outlier_t = ordered[0] ^ ordered[-1] if len(ordered) > 1 else 0
+    adjacent_t = first[0] ^ first[1]
+    extrema_t = first[0] ^ first[-1]
+    whole_t = 0
+    for x in first:
+        whole_t ^= x
+    half_t = 0
+    half = len(first) // 2
+    for bit in range(int(inst["n"])):
+        if sum((x >> bit) & 1 for x in first) == half:
+            half_t |= 1 << bit
+
+    restart = None
+    for _ in range(256):
+        cand_t = rng.randrange(1, 1 << int(inst["n"]))
+        cand = _candidate_for_translation(inst, cand_t)
+        if verify(inst, cand)[0]:
+            restart = cand
+            break
+    if restart is None:
+        restart = _candidate_for_translation(inst, 1)
+    return {
+        "outlier_incidence_degree": _candidate_for_translation(inst, outlier_t),
+        "greedy_first_adjacent_xor": _candidate_for_translation(inst, adjacent_t),
+        "whole_set_xor_ansatz": _candidate_for_translation(inst, whole_t),
+        "in_context_half_balanced_bits": _candidate_for_translation(inst, half_t),
+        "extrema_xor": _candidate_for_translation(inst, extrema_t),
+        "random_translation_restart_256": restart,
+    }
+
+
+def _reference_algorithm(inst: dict) -> tuple[list[int] | None, dict]:
+    """Exact anchored stabilizer search, with auditable operation counts."""
+    start = time.perf_counter()
+    first = inst["sets"][0]
+    anchor = first[0]
+    operations = 0
+    candidates = []
+    for y in first[1:]:
+        candidates.append(anchor ^ y)
+        operations += 1
+    for translation in candidates:
+        valid = True
+        for row in inst["sets"]:
+            lookup = set(row)
+            operations += len(row)  # exact hash-table insertions
+            for x in row:
+                operations += 2  # one XOR and one membership comparison
+                if (x ^ translation) not in lookup:
+                    valid = False
+                    break
+            if not valid:
+                break
+        if valid:
+            answer = _candidate_for_translation(inst, translation)
+            return answer, {
+                "wall_clock_sec": time.perf_counter() - start,
+                "operations": operations,
+                "candidates_tested": candidates.index(translation) + 1,
+            }
+    return None, {
+        "wall_clock_sec": time.perf_counter() - start,
+        "operations": operations,
+        "candidates_tested": len(candidates),
+    }
+
+
+def _answer_size(answer: object) -> tuple[int, int, int]:
+    blob = json.dumps(answer, separators=(",", ":"))
+    atoms = len(answer) if isinstance(answer, list) else 1
+    return len(blob), (len(blob) + 3) // 4, atoms
+
+
+def selftest() -> dict:
+    report: dict[str, Any] = {
+        "paper": "1611.01542",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    failures = []
+    checks = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 2, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            json_ok = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            checks += 1
+            if not ok or not json_ok:
+                failures.append({"preset": preset, "seed": seed, "reason": why})
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "checks": checks,
+        "failures": failures,
+        "answers_json_native": not failures,
+    }
+
+    ship = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = list(ship["answer"])
+    corruptions = {
+        "drop": planted[:-1],
+        "swap": [planted[1], planted[0], planted[2]],
+        "duplicate": [planted[0], planted[0], planted[2]],
+        "empty": [],
+        "out_of_range": [1 << int(ship["n"]), planted[1], planted[2]],
+    }
+    reasons = {name: verify(ship, candidate)[1]
+               for name, candidate in corruptions.items()}
+    rejected = all(not verify(ship, candidate)[0]
+                   for candidate in corruptions.values())
+    report["G2_rejects_corruption"] = {
+        "pass": rejected and len(set(reasons.values())) == len(corruptions),
+        "reasons": reasons,
+        "distinct_reasons": len(set(reasons.values())),
+    }
+
+    realistic = ("I used the common translation.\n```json\n<answer>"
+                 + json.dumps(planted) + "</answer>\n```\n")
