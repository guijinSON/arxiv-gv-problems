import gen_1611_01542 as g,time

def ax(inst,limit=500000):
 labels=inst['universe']; idx={x:i for i,x in enumerate(labels)}; R=len(inst['sets']); L=len(labels)
 rlm=[0]*R
 for r,row in enumerate(inst['sets']):
  for x in row:rlm[r]|=1<<idx[x]
 crm=[0]*L
 for r,row in enumerate(inst['sets']):
  for x in row:crm[idx[x]]|=1<<r
 conf=[0]*L
 for l in range(L):
  u=crm[l]
  while u:
   b=u&-u;r=b.bit_length()-1;u-=b;conf[l]|=rlm[r]
 nodes=0
 def rec(un,avail,sol):
  nonlocal nodes
  nodes+=1
  if nodes>limit:return None
  if not un:return sol
  u=un; bestmask=0;bc=10**9
  while u:
   b=u&-u;r=b.bit_length()-1;u-=b;opts=rlm[r]&avail;c=opts.bit_count()
   if c==0:return False
   if c<bc:bc=c;bestmask=opts
  opts=bestmask
  while opts:
   b=opts&-opts;l=b.bit_length()-1;opts-=b
   z=rec(un&~crm[l],avail&~conf[l],sol+[labels[l]])
   if z is None:return None
   if z is not False:return z
  return False
 st=time.perf_counter();z=rec((1<<R)-1,(1<<L)-1,[]);return z,nodes,time.perf_counter()-st
for seed in range(8):
 i=g.make_instance(seed=10000+seed,**g.DIFFICULTY['easy']);z,no,t=ax(i);print(seed,isinstance(z,list),no,round(t,4),g.verify(i,sorted(z))[0] if isinstance(z,list) else None,flush=True)
