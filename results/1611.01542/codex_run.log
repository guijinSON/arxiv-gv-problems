+def _is_cover_fast(inst: dict, answer: list[int], columns: dict[int, tuple[int, int, int]] | None = None) -> bool:
+    if len(answer) != inst["n"] or len(set(answer)) != len(answer):
+        return False
+    if columns is None:
+        columns = _column_rows(inst)
+    covered = 0
