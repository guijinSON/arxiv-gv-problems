+def _attack_smaller_branch(inst, rng):
+    signature = _cover_signature(inst)
+    values = [0] * len(PRIME_BASIS)
+    for selected, other in signature:
+        values[PRIME_BASIS.index(min(selected, other))] += 1
+    return values
