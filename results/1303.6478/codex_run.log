   790	def _normalize_counts(values, n):
   791	    values = [max(0, min(n, int(x))) for x in values[:len(PRIME_BASIS)]]
   792	    values += [0] * (len(PRIME_BASIS) - len(values))
   793	    total = sum(values)
   794	    if total > n:
   795	        for i in range(len(values) - 1, -1, -1):
   796	            take = min(values[i], total - n)
   797	            values[i] -= take
   798	            total -= take
   799	    elif total < n:
   800	        for i in range(len(values)):
   801	            take = min(n - values[i], n - total)
   802	            values[i] += take
   803	            total += take
   804	            if total == n:
   805	                break
   806	    return values
