+def _attack_random_restart(inst, rng, restarts):
+    ok, _, _, target = _analyze_instance(inst)
+    if not ok:
+        return _attack_uniform(inst, rng)
+    candidate = None
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if candidate == target:
+            return candidate
+    return candidate
