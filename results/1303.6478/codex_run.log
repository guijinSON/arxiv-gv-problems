   809	def _valuation_counts(value):
   810	    value = abs(value)
   811	    counts = []
   812	    for prime in PRIME_BASIS:
   813	        count = 0
   814	        while value and value % prime == 0:
   815	            value //= prime
   816	            count += 1
   817	        counts.append(count)
   818	    return counts
