   883	def _reference_algorithm(inst):
   884	    start = time.perf_counter()
   885	    determinant, stats = _bareiss_det(inst["cycle_closure_minor"], with_stats=True)
   886	    value = abs(determinant)
   887	    counts, factor_ops = [], 0
   888	    for prime in PRIME_BASIS:
   889	        exponent = 0
   890	        while value % prime == 0:
   891	            value //= prime
   892	            exponent += 1
   893	            factor_ops += 2
   894	        factor_ops += 1
   895	        counts.append(exponent)
   896	    elapsed = time.perf_counter() - start
   897	    stats["factor_trial_operations"] = factor_ops
   898	    stats["total_exact_operations"] = stats["arithmetic_updates"] + factor_ops
   899	    stats["unfactored_remainder"] = value
   900	    stats["elapsed_sec"] = elapsed
