   466	def _connected(vertices, bounded_edges):
   467	    if not vertices:
   468	        return False
   469	    adjacency = {v: [] for v in vertices}
   470	    for edge in bounded_edges:
   471	        adjacency[edge["a"]].append(edge["b"])
   472	        adjacency[edge["b"]].append(edge["a"])
   473	    seen, stack = set(), [next(iter(vertices))]
   474	    while stack:
   475	        v = stack.pop()
   476	        if v in seen:
   477	            continue
   478	        seen.add(v)
   479	        stack.extend(adjacency[v])
   480	    return seen == set(vertices)
