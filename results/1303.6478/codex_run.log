   453	def _is_prime(value):
   454	    if not _is_int(value) or value < 2:
   455	        return False
   456	    if value % 2 == 0:
   457	        return value == 2
   458	    d = 3
   459	    while d * d <= value:
   460	        if value % d == 0:
   461	            return False
   462	        d += 2
   463	    return True
