   483	def _tree_check(vertex_ids, edges):
   484	    if len(edges) != len(vertex_ids) - 1:
   485	        return False
   486	    parent = {v: v for v in vertex_ids}
   487	
   488	    def find(x):
   489	        while parent[x] != x:
   490	            parent[x] = parent[parent[x]]
   491	            x = parent[x]
   492	        return x
   493	
   494	    for edge in edges:
   495	        a, b = find(edge["a"]), find(edge["b"])
   496	        if a == b:
   497	            return False
   498	        parent[a] = b
   499	    return len({find(v) for v in vertex_ids}) == 1
