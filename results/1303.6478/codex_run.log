   632	def _analyze_instance(inst):
   633	    entry = _ANALYSIS_CACHE.get(id(inst))
   634	    if entry is not None and entry[0] is inst:
   635	        return entry[1]
   636	    ok, reason, weights = _validate_cover(inst)
   637	    if not ok:
   638	        result = (False, reason, None, None)
   639	    else:
   640	        matrix = inst.get("cycle_closure_minor")
   641	        try:
   642	            determinant = abs(_bareiss_det(matrix))
   643	        except (TypeError, ValueError, ZeroDivisionError):
   644	            result = (False, "malformed cycle-closure matrix", None, None)
   645	        else:
   646	            expected = math.prod(weights)
   647	            if determinant != expected:
   648	                result = (False, "matrix is not the promised co-tree closure minor", None, None)
   649	            else:
   650	                exponents = [weights.count(p) for p in PRIME_BASIS]
   651	                result = (True, "ok", determinant, exponents)
   652	    if len(_ANALYSIS_CACHE) >= 256:
   653	        _ANALYSIS_CACHE.pop(next(iter(_ANALYSIS_CACHE)))
   654	    _ANALYSIS_CACHE[id(inst)] = (inst, result)
   655	    return result
