   720	def _cover_signature(inst):
   721	    """Recover the rooted diamond chain without trusting storage order/IDs."""
   722	    vertices = {v["id"]: v for v in inst["vertices"]}
   723	    bounded = [e for e in inst["edges"] if e["b"] is not None]
   724	    adjacency = {v: [] for v in vertices}
   725	    for edge in bounded:
   726	        adjacency[edge["a"]].append(edge)
   727	        adjacency[edge["b"]].append(edge)
   728	    centers = [v for v in vertices.values() if v["target"] == "c"]
   729	    if len(centers) != 1:
   730	        raise ValueError("not one rooted cover")
   731	    previous = centers[0]["id"]
   732	    candidates = adjacency[previous]
   733	    if len(candidates) != 1:
   734	        raise ValueError("center does not start one chain")
   735	    edge = candidates[0]
   736	    split = edge["b"] if edge["a"] == previous else edge["a"]
   737	    signature = []
   738	    seen = {edge["id"]}
   739	    while True:
   740	        forward = [e for e in adjacency[split] if e["id"] not in seen]
   741	        if len(forward) != 2:
   742	            raise ValueError("not a diamond split")
   743	        endpoints = []
   744	        for branch in forward:
   745	            endpoints.append(branch["b"] if branch["a"] == split else branch["a"])
   746	        if endpoints[0] != endpoints[1]:
   747	            raise ValueError("diamond branches do not rejoin")
   748	        merge = endpoints[0]
   749	        selected = [e for e in forward if e.get("cotree")]
   750	        unselected = [e for e in forward if not e.get("cotree")]
   751	        if len(selected) != 1 or len(unselected) != 1:
   752	            raise ValueError("diamond co-tree choice is invalid")
   753	        signature.append((selected[0]["weight"], unselected[0]["weight"]))
   754	        seen.update(e["id"] for e in forward)
   755	        onward = [e for e in adjacency[merge] if e["id"] not in seen]
   756	        if not onward:
   757	            break
   758	        if len(onward) != 1:
   759	            raise ValueError("diamond chain branches")
   760	        trunk = onward[0]
   761	        seen.add(trunk["id"])
   762	        split = trunk["b"] if trunk["a"] == merge else trunk["a"]
   763	    return signature
   764	
