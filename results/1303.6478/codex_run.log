   658	def verify(inst, answer):
   659	    """Accept every bounded prime-exponent witness equal to the exact minor."""
   660	    if answer is None:
   661	        return False, "answer is absent"
   662	    if not isinstance(answer, list):
   663	        return False, "answer must be a JSON list"
   664	    if not answer:
   665	        return False, "exponent vector is empty"
   666	    expected_len = len(PRIME_BASIS)
   667	    if len(answer) != expected_len:
   668	        return False, f"expected {expected_len} exponents, got {len(answer)}"
   669	    if any(not _is_int(x) for x in answer):
   670	        return False, "every exponent must be an integer"
   671	    n = inst.get("n") if isinstance(inst, dict) else None
   672	    if not _is_int(n):
   673	        return False, "instance has no valid n"
   674	    if any(x < 0 or x > n for x in answer):
   675	        return False, f"every exponent must lie in 0..{n}"
   676	    if sum(answer) != n:
   677	        return False, f"exponents must sum to {n}"
   678	    ok, reason, determinant, _ = _analyze_instance(inst)
   679	    if not ok:
   680	        return False, reason
   681	    candidate = math.prod(pow(p, exponent) for p, exponent in zip(PRIME_BASIS, answer))
   682	    if candidate != determinant:
   683	        return False, "prime-exponent factorization does not equal abs(det(M))"
   684	    return True, "ok"
