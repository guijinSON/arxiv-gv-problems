   871	def _attack_random_restart(inst, rng, restarts):
   872	    ok, _, _, target = _analyze_instance(inst)
   873	    if not ok:
   874	        return _attack_uniform(inst, rng)
   875	    candidate = None
   876	    for _ in range(restarts):
   877	        candidate = random_candidate(inst, rng)
   878	        if candidate == target:
   879	            return candidate
   880	    return candidate
