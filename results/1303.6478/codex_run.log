   502	def _validate_cover(inst):
   503	    """Validate the native tropical object and return its selected weights."""
   504	    try:
   505	        n = inst["n"]
   506	        if not _is_int(n) or n < 1 or inst["degree"] != DEGREE:
   507	            return False, "invalid size or degree", None
   508	        if inst["prime_basis"] != list(PRIME_BASIS):
   509	            return False, "invalid prime basis", None
   510	        vertices, edges = inst["vertices"], inst["edges"]
   511	        if not isinstance(vertices, list) or not isinstance(edges, list):
   512	            return False, "vertices and edges must be lists", None
   513	        by_id = {}
   514	        for vertex in vertices:
   515	            vid = vertex.get("id")
   516	            if not _is_int(vid) or vid in by_id:
   517	                return False, "vertex identifiers must be distinct integers", None
   518	            if vertex.get("target") not in ("c", "u"):
   519	                return False, "invalid vertex target", None
   520	            _q_value(vertex.get("position"))
   520	            _q_value(vertex.get("position"))
   521	            if not _is_int(vertex.get("genus")) or vertex["genus"] < 0:
   522	                return False, "invalid vertex genus", None
   523	            if (not isinstance(vertex.get("labels"), list)
   524	                    or any(not _is_int(x) or x < 1 for x in vertex["labels"])):
   525	                return False, "invalid vertex labels", None
   526	            by_id[vid] = vertex
   527	        centers = [v for v in vertices if v["target"] == "c"]
   528	        if len(centers) != 1:
   529	            return False, "the cover must have one vertex above c", None
   530	
   531	        edge_ids, bounded, incidence = set(), [], {v: [] for v in by_id}
   532	        profiles = {"u": [], "v": [], "w": []}
   533	        for edge in edges:
   534	            eid = edge.get("id")
   535	            if not _is_int(eid) or eid in edge_ids:
   536	                return False, "edge identifiers must be distinct integers", None
   537	            edge_ids.add(eid)
   538	            a, b, ray, weight = edge.get("a"), edge.get("b"), edge.get("ray"), edge.get("weight")
   539	            if a not in by_id or (b is not None and b not in by_id) or a == b:
   540	                return False, "invalid edge endpoint", None
   541	            if ray not in profiles or not _is_int(weight) or weight <= 0:
   542	                return False, "invalid edge ray or weight", None
   543	            incidence[a].append(edge)
   544	            if b is None:
   545	                if edge.get("length") is not None or edge.get("cotree"):
   546	                    return False, "an end must be infinite and cannot be a co-tree edge", None
   547	                profiles[ray].append(weight)
   548	            else:
   549	                incidence[b].append(edge)
   550	                bounded.append(edge)
   551	                if ray != "u":
   552	                    return False, "every bounded edge must map to u", None
   553	                ln, ld = _q_value(edge.get("length"))
   554	                if ln <= 0:
   555	                    return False, "bounded lengths must be positive", None
   556	                pa = by_id[a]["position"]
   557	                pb = by_id[b]["position"]
   558	                delta_num = abs(pa[0] * pb[1] - pb[0] * pa[1])
   559	                delta_den = pa[1] * pb[1]
   560	                if weight * ln * delta_den != ld * delta_num:
   561	                    return False, "slope times length does not equal target distance", None
   562	
   563	        if not _connected(by_id, bounded):
   564	            return False, "source graph is disconnected", None
   565	        labels, rh_sum = [], 0
   566	        for vid, vertex in by_id.items():
   567	            groups = {}
   568	            for edge in incidence[vid]:
   569	                if vertex["target"] == "c":
   570	                    direction = edge["ray"]
   571	                else:
   572	                    if edge["ray"] != "u":
   573	                        return False, "a ray vertex has an edge on the wrong target ray", None
   574	                    if edge["b"] is None:
   575	                        direction = "right"
   576	                    else:
   577	                        other = edge["b"] if edge["a"] == vid else edge["a"]
   578	                        p, q = vertex["position"], by_id[other]["position"]
   579	                        cmp = q[0] * p[1] - p[0] * q[1]
   580	                        if cmp == 0:
   581	                            return False, "an edge has equal target endpoints", None
   582	                        direction = "right" if cmp > 0 else "left"
   583	                groups[direction] = groups.get(direction, 0) + edge["weight"]
   584	            required = ("u", "v", "w") if vertex["target"] == "c" else ("left", "right")
   585	            if set(groups) != set(required) or len(set(groups.values())) != 1:
   586	                return False, "tropical balancing fails", None
   587	            local_degree = next(iter(groups.values()))
   588	            target_valence = 3 if vertex["target"] == "c" else 2
   589	            rh = len(incidence[vid]) + 2 * vertex["genus"] - 2 - local_degree * (target_valence - 2)
   590	            if rh < 0 or len(vertex["labels"]) != rh:
   591	                return False, "Riemann-Hurwitz number or label count fails", None
   592	            if vertex["target"] == "c" and rh != 0:
   593	                return False, "the center vertex is not trivalent-type (RH zero)", None
   594	            if vertex["target"] != "c" and (len(incidence[vid]) != 3 or vertex["genus"] != 0 or rh != 1):
   595	                return False, "a moving vertex is not trivalent genus zero", None
   596	            labels.extend(vertex["labels"])
   597	            rh_sum += rh
   598	        if sorted(labels) != list(range(1, rh_sum + 1)):
   599	            return False, "labels are not exactly 1 through the total RH number", None
   600	
   601	        cycle_rank = len(bounded) - len(vertices) + 1
   602	        if cycle_rank != n:
   603	            return False, "cycle rank does not equal n", None
   604	        source_genus = cycle_rank + sum(v["genus"] for v in vertices)
   605	        if source_genus != inst["genus"]:
   606	            return False, "source genus is inconsistent", None
   607	        expected_profile = {key: sorted(value) for key, value in inst["ramification_profile"].items()}
   608	        if {key: sorted(value) for key, value in profiles.items()} != expected_profile:
   609	            return False, "ramification profile is inconsistent", None
   610	        if any(sum(values) != DEGREE for values in profiles.values()):
   611	            return False, "end weights do not have the stated degree", None
   612	
   613	        cotree = [e for e in bounded if e.get("cotree") is True]
   614	        tree = [e for e in bounded if e.get("cotree") is False]
   615	        if [e["id"] for e in tree] != inst["spanning_tree_edges"]:
   616	            return False, "spanning-tree edge list is inconsistent", None
   617	        if [e["id"] for e in cotree] != inst["cotree_edges"]:
   618	            return False, "co-tree edge list is inconsistent", None
   619	        if len(cotree) != n or not _tree_check(set(by_id), tree):
   620	            return False, "the stated complement is not a spanning tree", None
   621	        weights = [e["weight"] for e in cotree]
   622	        if any(weight not in PRIME_BASIS for weight in weights):
   623	            return False, "a co-tree weight is outside the prime basis", None
   624	        return True, "ok", weights
   625	    except (KeyError, TypeError, ValueError, AttributeError):
   626	        return False, "malformed tropical-cover instance", None
