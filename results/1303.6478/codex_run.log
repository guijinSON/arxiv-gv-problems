   766	def canonical_key(inst):
   767	    payload = {
   768	        "degree": inst["degree"],
   769	        "profile": inst["ramification_profile"],
   770	        "rooted_diamonds": _cover_signature(inst),
   771	    }
   772	    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
   773	    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
