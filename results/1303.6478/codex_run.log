   776	def escalate(params):
   777	    params = dict(params)
   778	    n = params.get("n")
   779	    mix_bound = params.get("mix_bound", 1)
   780	    _validate_params(n, mix_bound)
   781	    # The 12-entry witness is independent of n, so there is always another
   782	    # fixed-answer-length hardness step available.  Grow both the matrix and,
   783	    # until its documented cap, the coefficient-mixing range; neither change
   784	    # lengthens the answer.
   785	    params["n"] = n + 64
   786	    params["mix_bound"] = min(16, mix_bound + 1)
   787	    return params
