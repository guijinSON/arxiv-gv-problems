)


PRIME_PAIRS = ((7, 53), (13, 47), (17, 43), (19, 41), (23, 37), (29, 31))
PRIME_BASIS = tuple(sorted(p for pair in PRIME_PAIRS for p in pair))
DEGREE = 60

CERTIFICATE_LANGUAGE = {
