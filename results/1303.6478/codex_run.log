   840	def _attack_row_contents(inst, rng):
   841	    product = 1
   842	    for row in inst["cycle_closure_minor"]:
   843	        content = 0
   844	        for value in row:
   845	            content = math.gcd(content, abs(value))
   846	        product *= max(1, content)
