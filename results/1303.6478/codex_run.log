   687	def random_candidate(inst, rng):
   688	    """Sample a uniform weak composition of n into 12 bounded exponents."""
   689	    if not isinstance(rng, random.Random):
   690	        raise TypeError("rng must be random.Random")
   691	    n, k = inst["n"], len(PRIME_BASIS)
   692	    bars = sorted(rng.sample(range(n + k - 1), k - 1))
   693	    positions = [-1] + bars + [n + k - 1]
   694	    return [positions[i + 1] - positions[i] - 1 for i in range(k)]
   695	
   696	
   697	def search_space(inst):
   698	    return math.comb(inst["n"] + len(PRIME_BASIS) - 1, len(PRIME_BASIS) - 1)
   699	
   700	
   701	def enumerate_all(inst):
   702	    space = search_space(inst)
   703	    if space > 100_000:
   704	        return None
   705	    n, k, count = inst["n"], len(PRIME_BASIS), 0
   706	
   707	    def visit(prefix, remaining, slots):
   708	        nonlocal count
   709	        if slots == 1:
   710	            candidate = prefix + [remaining]
   711	            count += int(verify(inst, candidate)[0])
   712	            return
   713	        for value in range(remaining + 1):
   714	            visit(prefix + [value], remaining - value, slots - 1)
   715	
   716	    visit([], n, k)
   717	    return count
