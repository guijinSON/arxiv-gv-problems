   415	def _bareiss_det(matrix, with_stats=False):
   416	    """Exact fraction-free determinant and a transparent arithmetic count."""
   417	    if not isinstance(matrix, list) or not matrix:
   418	        raise ValueError("matrix must be nonempty")
   419	    n = len(matrix)
   420	    if any(not isinstance(row, list) or len(row) != n for row in matrix):
   421	        raise ValueError("matrix must be square")
   422	    if any(not _is_int(x) for row in matrix for x in row):
   423	        raise ValueError("matrix entries must be integers")
   424	    if n == 1:
   425	        return (matrix[0][0], {"arithmetic_updates": 0, "row_swaps": 0}) if with_stats else matrix[0][0]
   426	    M = [row[:] for row in matrix]
   427	    sign, previous, updates, swaps = 1, 1, 0, 0
   428	    for k in range(n - 1):
   429	        if M[k][k] == 0:
   430	            pivot = next((r for r in range(k + 1, n) if M[r][k]), None)
   431	            if pivot is None:
   432	                result = 0
   433	                stats = {"arithmetic_updates": updates, "row_swaps": swaps}
   434	                return (result, stats) if with_stats else result
   435	            M[k], M[pivot] = M[pivot], M[k]
   436	            sign = -sign
   437	            swaps += 1
   438	        pivot_value = M[k][k]
   439	        for i in range(k + 1, n):
   440	            mik = M[i][k]
   441	            row_i = M[i]
   442	            row_k = M[k]
   443	            for j in range(k + 1, n):
   444	                row_i[j] = (row_i[j] * pivot_value - mik * row_k[j]) // previous
   445	                updates += 4  # two products, one subtraction, one exact division
   446	            row_i[k] = 0
   447	        previous = pivot_value
   448	    result = sign * M[-1][-1]
   449	    stats = {"arithmetic_updates": updates, "row_swaps": swaps}
   450	    return (result, stats) if with_stats else result
   451	
