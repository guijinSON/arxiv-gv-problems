   393	def parse_answer(text):
   394	    """Extract the tagged JSON exponent vector; never raise on malformed text."""
   395	    if not isinstance(text, str):
   396	        return None
   397	    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text,
   398	                         flags=re.IGNORECASE | re.DOTALL)
   399	    if not matches:
   400	        return None
   401	    payload = matches[-1].strip()
   402	    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", payload,
   403	                         flags=re.IGNORECASE | re.DOTALL)
   404	    if fence:
   405	        payload = fence.group(1).strip()
   406	    try:
   407	        value = json.loads(payload)
   408	    except (TypeError, ValueError, json.JSONDecodeError):
   409	        return None
   410	    if not isinstance(value, list) or any(not _is_int(x) for x in value):
   411	        return None
   412	    return value
