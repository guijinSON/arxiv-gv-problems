+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_G4_SAMPLES = 200_000
+_ATTACK_SEEDS = 8
+_ENUMERATION_CAP = 10_000
