+    if sign != expected["sign"]:
+        return False, "quadratic Gauss-factor sign is incorrect"
+    for i, (got, want) in enumerate(zip(phases, expected["phases"])):
+        if got != want:
+            return False, f"overlap phase mismatch at query {i}"
+    return True, "ok"
