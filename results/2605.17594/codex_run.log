+def _recover_rank_one_parameters(inst: dict) -> tuple[int, int]:
+    """Cheap construction-aware recovery used by attacks, never by verify."""
+    r = inst["reference_vector"]
+    qmat = inst["quadratic_matrix"]
+    nz = [i for i, value in enumerate(r) if value]
+    i, j = nz[0], nz[1]
+    mu = qmat[i][j] * _inv3(r[i] * r[j]) % 3
+    lam = (qmat[i][i] - mu * r[i] * r[i]) % 3
+    return lam, mu
+
+
+def _rank_one_sign(inst: dict) -> int:
+    lam, mu = _recover_rank_one_parameters(inst)
+    den = (lam + mu * inst["reference_norm_mod3"]) % 3
+    det = pow(lam, inst["dimension"] - 1, 3) * den % 3
+    return 1 if det == 1 else -1
+
