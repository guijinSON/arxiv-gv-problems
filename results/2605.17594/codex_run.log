+DIFFICULTY = {
+    "demo": {"n": 3, "queries": 3, "changes": 1},
+    "easy": {"n": 24, "queries": 13, "changes": 1},
+    "medium": {"n": 48, "queries": 13, "changes": 1},
+    "hard": {"n": 96, "queries": 13, "changes": 1},
