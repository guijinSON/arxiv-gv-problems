+    # G9(a,b) are diagnostics; only the explicit answer/effort caps gate.
+    answer_blob = json.dumps(ship["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
