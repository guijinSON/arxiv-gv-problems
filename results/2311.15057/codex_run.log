        "pass": not g8_errors and distinct == 20,
        "invariance_checks": invariance_checks,
        "real_transform_checks": real_transform_checks,
        "unrelated_distinct": distinct,
        "unrelated_total": 20,
        "transformations": [
            "source coordinate/component permutations",
