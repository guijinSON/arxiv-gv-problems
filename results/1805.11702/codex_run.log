+        _binary_add(d, _binary_scale(_binary_mul(b, c, p), -inv3, p), p),
+        _binary_scale(_binary_pow(b, 3, p), 2 * inv27, p),
+        p,
+    )
+    return _binary_add(
+        _binary_scale(_binary_pow(depressed_p, 3, p), -4, p),
+        _binary_scale(_binary_pow(depressed_q, 2, p), -27, p),
