+def _upow(a: list[int], exponent: int, p: int) -> list[int]:
+    result = [1]
+    base = a[:]
+    power = exponent
+    while power:
+        if power & 1:
+            result = _umul(result, base, p)
+        power >>= 1
+        if power:
+            base = _umul(base, base, p)
+    return result
 
 
