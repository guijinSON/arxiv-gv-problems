-def selftest() -> dict:
-    report: dict = {
-        "track": TRACK,
-        "shipping_difficulty": SHIPPING_DIFFICULTY,
-        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
-    }
-
-    g1_failures = []
-    attempts = 0
-    for preset, params in DIFFICULTY.items():
-        for seed in (0, 1, 17):
-            inst = make_instance(seed=seed, **params)
-            ok, reason = verify(inst, inst["answer"])
-            attempts += 1
-            if not ok:
-                g1_failures.append(f"{preset}/{seed}: {reason}")
-            try:
-                copied = json.loads(json.dumps(inst["answer"]))
-            except (TypeError, ValueError) as exc:
-                g1_failures.append(f"{preset}/{seed}: JSON {exc}")
-            else:
-                if copied != inst["answer"]:
-                    g1_failures.append(f"{preset}/{seed}: JSON changed answer")
-    report["G1_planted_verifies"] = {
-        "pass": not g1_failures,
-        "attempts": attempts,
-        "failures": g1_failures,
-    }
-
-    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
-    shipping = make_instance(seed=123, **shipping_params)
-    answer = shipping["answer"]
-    swapped = None
-    for i in range(4):
-        for j in range(i + 1, 4):
-            trial = {
-                "plane": list(answer["plane"]),
-                "contact_cubic": list(answer["contact_cubic"]),
-            }
-            trial["contact_cubic"][i], trial["contact_cubic"][j] = (
-                trial["contact_cubic"][j], trial["contact_cubic"][i]
-            )
-            ok, reason = verify(shipping, trial)
-            if not ok and reason not in {
-                "answer_keys",
-                "plane_shape",
-                "contact_cubic_shape",
-                "coefficient_range",
-            }:
-                swapped = trial
-                break
-        if swapped is not None:
-            break
-    if swapped is None:
-        swapped = {
-            "plane": list(answer["plane"]),
-            "contact_cubic": list(reversed(answer["contact_cubic"])),
-        }
-    corruptions = {
-        "drop": {
-            "plane": answer["plane"][:-1],
-            "contact_cubic": list(answer["contact_cubic"]),
-        },
-        "swap": swapped,
-        "duplicate": {
-            "plane": list(answer["plane"]),
-            "contact_cubic": answer["contact_cubic"] + [answer["contact_cubic"][0]],
-        },
-        "empty": {},
-        "out_of_range": {
-            "plane": [shipping["p"]] + answer["plane"][1:],
-            "contact_cubic": list(answer["contact_cubic"]),
-        },
-    }
-    corruption_results = {}
-    for name, candidate in corruptions.items():
-        ok, reason = verify(shipping, candidate)
-        corruption_results[name] = {"accepted": ok, "reason": reason}
-    reasons = [entry["reason"] for entry in corruption_results.values()]
-    report["G2_rejects_corruption"] = {
-        "pass": (
-            all(not entry["accepted"] for entry in corruption_results.values())
