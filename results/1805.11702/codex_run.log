+    )
+    report["G7_scales"] = {
+        "pass": (
+            list(preset_costs.values()) == sorted(set(preset_costs.values()))
+            and doubled_ok
+            and fixed_atoms
+        ),
+        "preset_plane_chart_sizes": preset_costs,
