   700	def _format_monomials(monomials: list[tuple[int, ...]]) -> str:
   701	    names = []
   702	    for mon in monomials:
   703	        factors = []
   704	        for index, exponent in enumerate(mon):
   705	            if exponent == 1:
   706	                factors.append(f"x{index}")
   707	            elif exponent > 1:
   708	                factors.append(f"x{index}^{exponent}")
   709	        names.append("*".join(factors) if factors else "1")
   710	    return "[" + ", ".join(names) + "]"
