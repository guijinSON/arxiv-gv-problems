-def _transform_instance(inst: dict, change: list[list[int]], qscale: int, gscale: int) -> dict:
-    p = inst["p"]
-    inverse = _inverse_mod(change, p)
-    assert inverse is not None
-    moved = dict(inst)
-    moved["quadric"] = [
-        qscale * value % p
-        for value in _linear_substitute(inst["quadric"], 2, inverse, p)
-    ]
-    moved["cubic"] = [
-        gscale * value % p
-        for value in _linear_substitute(inst["cubic"], 3, inverse, p)
-    ]
-    moved["cone_map"] = _matmul(change, inst["cone_map"], p)
-    moved["pullback_profile"] = _pullback_profile(
-        moved["cubic"], moved["cone_map"], p
-    )
-    plane = _normalize_projective(
-        _rowmul(inst["answer"]["plane"], inverse, p), p
-    )
-    assert plane is not None
-    moved["answer"] = {
-        "plane": plane,
-        "contact_cubic": list(inst["answer"]["contact_cubic"]),
-    }
-    return moved
-
