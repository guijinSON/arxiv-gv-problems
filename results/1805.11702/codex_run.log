-def _random_invertible(size: int, p: int, rng: random.Random) -> list[list[int]]:
-    while True:
-        matrix = [[rng.randrange(p) for _ in range(size)] for _ in range(size)]
-        if _inverse_mod(matrix, p) is not None:
-            return matrix
