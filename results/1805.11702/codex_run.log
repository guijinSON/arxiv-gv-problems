   794	def verify(inst: dict, answer: object) -> tuple[bool, str]:
   795	    """Check a tritangent certificate by exact substitution; never use answer."""
   796	    if not isinstance(answer, dict):
   797	        return False, "answer_not_object"
   798	    if set(answer) != {"plane", "contact_cubic"}:
   799	        return False, "answer_keys"
   800	    p = inst.get("p")
   801	    if not isinstance(p, int) or not _is_prime(p) or p <= 3:
   802	        return False, "invalid_instance_field"
   803	    plane_ok, plane_reason = _valid_coeff_vector(answer["plane"], p, 4)
   804	    if not plane_ok:
   805	        return False, {
   806	            "shape": "plane_shape",
   807	            "type": "coefficient_type",
   808	            "range": "coefficient_range",
   809	        }[plane_reason]
   810	    root_ok, root_reason = _valid_coeff_vector(answer["contact_cubic"], p, 4)
   811	    if not root_ok:
   812	        return False, {
   813	            "shape": "contact_cubic_shape",
   814	            "type": "contact_coefficient_type",
   815	            "range": "contact_coefficient_range",
   816	        }[root_reason]
   817	    plane = answer["plane"]
   818	    root = answer["contact_cubic"]
   819	    if _normalize_projective(plane, p) != plane:
   820	        return False, "plane_not_normalized"
   821	    if _normalize_projective(root, p) != root:
   822	        return False, "contact_not_normalized"
   823	    if _binary_cubic_discriminant(root, p) == 0:
   824	        return False, "contact_not_squarefree"
   825	    cone_map = inst.get("cone_map")
   826	    if (
   827	        not isinstance(cone_map, list)
   828	        or len(cone_map) != 4
   829	        or any(not isinstance(row, list) or len(row) != 4 for row in cone_map)
   830	        or _inverse_mod(cone_map, p) is None
   831	    ):
   832	        return False, "invalid_instance_cone_map"
   833	    quadric = inst.get("quadric")
   834	    cubic = inst.get("cubic")
   835	    if (
   836	        not isinstance(quadric, list)
   837	        or len(quadric) != len(_MONOMIALS_2)
   838	        or not isinstance(cubic, list)
   839	        or len(cubic) != len(_MONOMIALS_3)
   840	        or any(not isinstance(value, int) or isinstance(value, bool) for value in quadric + cubic)
   841	        or any(value < 0 or value >= p for value in quadric + cubic)
   842	    ):
   843	        return False, "invalid_instance_polynomials"
   844	    if not _cached_cone_check(
   845	        p, tuple(quadric), tuple(tuple(row) for row in cone_map)
   846	    ):
   847	        return False, "cone_map_does_not_parametrize_quadric"
   848	    h = _rowmul(plane, cone_map, p)
   849	    if h[3] == 0:
   850	        return False, "plane_through_vertex"
   851	    inv = pow(h[3], p - 2, p)
   852	    q = [h[i] * inv % p for i in range(3)]
   853	    profile = inst.get("pullback_profile")
   854	    if not (
   855	        isinstance(profile, list)
   856	        and [len(part) for part in profile] == [7, 5, 3, 1]
   857	    ):
   858	        profile = _pullback_profile(inst["cubic"], cone_map, p)
   859	    sextic = _restricted_sextic(profile, q, p)
   860	    square = _binary_cubic_square(root, p)
   861	    if not _projectively_equal(sextic, square, p):
   862	        return False, "not_tritangent_identity"
   863	    return True, "ok"
