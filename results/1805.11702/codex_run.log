+        "strongest_failing_attack_steps": strongest[1]["steps"],
+    }
+
+    preset_costs = {
+        name: _next_prime(params["n"]) ** 3 for name, params in DIFFICULTY.items()
+    }
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=909, **doubled_params)
