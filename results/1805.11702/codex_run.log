+        "strongest_failing_attack": strongest[0],
+        "strongest_failing_attack_wall_clock_sec": strongest[1]["wall_clock_sec"],
+        "strongest_failing_attack_steps": strongest[1]["steps"],
+    }
+
+    preset_costs = {
