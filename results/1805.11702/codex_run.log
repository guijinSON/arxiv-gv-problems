+    if len(_ugcd(divisor, _uderivative(divisor, p), p)) != 1:
+        return False
+    square = _umul(divisor, divisor, p)
+    quotient, remainder = _udivmod(affine, square, p)
+    return remainder == [0] and len(quotient) == 1 and quotient[0] != 0
 
 
