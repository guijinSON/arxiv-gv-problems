+STRUCTURAL_HINT = (
+    "The second polar of the cubic in the cone's vertex direction is an "
+    "intrinsic trace section."
+)
+PLACEBO_HINT = (
+    "The modular representatives and projective normalizations should be "
+    "handled consistently throughout."
+)
