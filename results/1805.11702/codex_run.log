+            "solves": f"{reference_successes}/{_ATTACK_SEEDS}, as expected",
+        },
+        "compact_route": {
+            "name": "quadric-vertex kernel plus second polar",
+            "operations_per_instance": 238,
+            "solves": f"{compact_successes}/{_ATTACK_SEEDS}, as expected",
+        },
+    }
+
+    strongest = max(attacks.items(), key=lambda item: item[1]["wall_clock_sec"])
+    report["G5_density_and_baseline"] = {
+        "pass": (
+            exact_count >= 1
+            and scan_cert is not None
+            and verify(shipping, scan_cert)[0]
+            and reference_successes == _ATTACK_SEEDS
