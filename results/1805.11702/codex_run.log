+    0,
+    os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))),
+)
+try:
+    from gvlib import sparse_poly  # noqa: F401
+except ImportError:  # pragma: no cover - this family remains stdlib-only
+    sparse_poly = None
