+    b = _binary_scale(f2, inv_lead, p)
+    c = _binary_scale(f1, inv_lead, p)
+    d = _binary_scale(f0, inv_lead, p)
+    inv3 = pow(3, -1, p)
+    inv27 = pow(27, -1, p)
+    depressed_p = _binary_add(c, _binary_scale(_binary_mul(b, b, p), -inv3, p), p)
