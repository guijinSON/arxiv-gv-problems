+    fixed_atoms = (
+        escalated is not None
+        and _answer_metrics(escalated["answer"])[2] == _answer_metrics(answer)[2]
+    )
+    report["G7_scales"] = {
+        "pass": (
+            list(preset_costs.values()) == sorted(set(preset_costs.values()))
+            and doubled_ok
+            and fixed_atoms
+        ),
+        "preset_plane_chart_sizes": preset_costs,
+        "doubled_n": doubled["n"],
+        "doubled_prime": doubled["p"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+        "escalated_params": harder,
+        "escalation_keeps_answer_atoms": fixed_atoms,
+    }
+
+    invariant_checks = 0
+    witness_checks = 0
+    key_failures = []
+    distinct_keys = []
+    for seed in range(20):
+        inst = make_instance(seed=1_200 + seed, **shipping_params)
+        distinct_keys.append(canonical_key(inst))
+        rng = random.Random(7_000 + seed)
+        first_change = _random_invertible(4, inst["p"], rng)
+        second_change = _random_invertible(4, inst["p"], rng)
+        moved = _transform_instance(
+            inst,
+            first_change,
+            rng.randrange(1, inst["p"]),
+            rng.randrange(1, inst["p"]),
+        )
+        moved = _transform_instance(
+            moved,
+            second_change,
+            rng.randrange(1, inst["p"]),
+            rng.randrange(1, inst["p"]),
+        )
+        invariant_checks += 1
+        if canonical_key(moved) != canonical_key(inst):
+            key_failures.append(f"seed {seed}: ambient/projective invariance")
+        witness_checks += 1
+        if not verify(moved, moved["answer"])[0]:
+            key_failures.append(f"seed {seed}: carried witness failed")
+    distinct_count = len(set(distinct_keys))
+    report["G8_canonical_key"] = {
+        "pass": (
+            not key_failures
+            and invariant_checks >= 20
+            and witness_checks >= 20
+            and distinct_count == 20
+        ),
+        "invariance_checks": invariant_checks,
+        "carried_witness_checks": witness_checks,
+        "unrelated_instances": 20,
+        "distinct_keys": distinct_count,
+        "failures": key_failures,
+        "invariances": [
+            "arbitrary ambient PGL(4,F_p) coordinate changes",
+            "independent nonzero rescaling of Q and G",
+            "composition of two such transformations",
+        ],
+    }
+
+    answer_chars, answer_tokens, answer_elements = _answer_metrics(answer)
+    arms = {
+        name: {
+            "solved": int(G9_ORACLE_RESULTS.get(name, {}).get("solved", 0)),
+            "attempts": int(G9_ORACLE_RESULTS.get(name, {}).get("attempts", 0)),
+        }
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    hinted_verdict = G9_ORACLE_RESULTS.get("hinted_verdict", "not_run")
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and 238 <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_verdict == "hardened" and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": hinted_verdict,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": 238,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        isinstance(value, dict) and value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G") and key[1:2].isdigit()
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

