   983	def _outlier_coordinate_attack(inst: dict) -> object:
   984	    p = inst["p"]
   985	    candidates = []
   986	    for i in range(4):
   987	        plane = [1 if j == i else 0 for j in range(4)]
   988	        h = _rowmul(plane, inst["cone_map"], p)
   989	        if h[3] == 0:
   990	            continue
   991	        inv = pow(h[3], p - 2, p)
   992	        q = [h[j] * inv % p for j in range(3)]
   993	        sextic = _restricted_sextic(inst["pullback_profile"], q, p)
   994	        # A cheap outlier score: count zero coefficients and palindromic matches.
   995	        score = sum(value == 0 for value in sextic) + sum(
   996	            sextic[j] == sextic[6 - j] for j in range(3)
   997	        )
   998	        candidates.append((score, plane, q))
   999	    if not candidates:
  1000	        return _fallback_certificate(inst)
  1001	    _, plane, q = max(candidates, key=lambda item: item[0])
  1002	    cert = _certificate_from_q(inst, q)
  1003	    return cert if cert is not None else _fallback_certificate(inst, plane)
