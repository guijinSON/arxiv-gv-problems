+def _poly_gradient(poly: Poly, point: list[int], p: int) -> list[int]:
+    gradient = [0, 0, 0, 0]
+    for exp, coeff in poly.items():
+        for variable in range(4):
+            if exp[variable] == 0:
+                continue
+            value = coeff * exp[variable]
+            for i, power in enumerate(exp):
+                adjusted = power - (1 if i == variable else 0)
