+def _curve_discriminant(inst: dict) -> list[int]:
+    """Binary discriminant of the monic cubic obtained on the quadric cone."""
+    p = inst["p"]
+    f0, f1, f2, f3 = [list(form) for form in _weighted_forms(inst)]
+    if len(f3) != 1 or f3[0] == 0:
