-def escalate(params: dict) -> dict | str | None:
-    harder = dict(params)
-    current = int(harder.get("n", 7))
-    if current >= 1_000_003:
-        return "cap_bound"
-    harder["n"] = current * 2 + 1
-    harder["scramble"] = True
-    harder.pop("prime", None)
-    return harder
