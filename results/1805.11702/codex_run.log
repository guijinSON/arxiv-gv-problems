+def _binary_derivative(coeffs: list[int], s_order: int, t_order: int, p: int) -> list[int]:
+    """Mixed derivative of a binary form, indexed by the remaining t exponent."""
+    degree = len(coeffs) - 1
+    out_degree = degree - s_order - t_order
+    if out_degree < 0:
