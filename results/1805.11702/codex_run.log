-def random_candidate(inst: dict, rng: random.Random) -> object:
-    """Uniform structural candidate: affine plane chart times squarefree cubics."""
-    p = inst["p"]
-    q = [rng.randrange(p) for _ in range(3)]
-    h = q + [1]
-    inverse = _inverse_mod(inst["cone_map"], p)
-    assert inverse is not None
-    plane = _normalize_projective(_rowmul(h, inverse, p), p)
-    assert plane is not None
-    return {
-        "plane": plane,
-        "contact_cubic": _random_squarefree_cubic(p, rng),
-    }
