+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "One canonically normalized nonzero linear form [h0,h1,h2,h3] over "
+        "GF(p): entries are integers in 0..p-1 and the first nonzero entry is 1."
+    ),
+    "bounds": {
