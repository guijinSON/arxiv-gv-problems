-        return []
-    out = [0] * (len(a) + len(b) - 1)
-    for i, av in enumerate(a):
-        if av:
-            for j, bv in enumerate(b):
-                if bv:
-                    out[i + j] = (out[i + j] + av * bv) % p
-    return out
-
-
-def _poly_pow(a: list[int], exponent: int, p: int) -> list[int]:
-    out = [1]
-    base = list(a)
-    while exponent:
-        if exponent & 1:
-            out = _poly_mul(out, base, p)
-        exponent >>= 1
-        if exponent:
-            base = _poly_mul(base, base, p)
-    return out
