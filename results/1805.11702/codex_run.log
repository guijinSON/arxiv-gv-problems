+        guess_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
+    guess_wall = time.perf_counter() - guess_start
+
+    scan_start = time.perf_counter()
+    scan_cert, exact_count, scan_tested = _scan_tritangents(
+        shipping, stop_after_first=False
+    )
+    scan_wall = time.perf_counter() - scan_start
+    exact_fraction = exact_count / search_space(shipping)
+    report["G4_guess_resistance"] = {
+        "pass": guess_hits / _G4_SAMPLES < 1e-6 and exact_fraction < 1e-6,
