-def _compact_route(inst: dict) -> tuple[dict | None, dict[str, int]]:
-    p = inst["p"]
-    vertex = _kernel_vector(_quadric_matrix(inst["quadric"], p), p)
-    if vertex is None:
-        return None, {"field_operations": 96}
-    plane = _normalize_projective(_directional_second_polar(inst["cubic"], vertex, p), p)
-    if plane is None:
-        return None, {"field_operations": 206}
-    h = _rowmul(plane, inst["cone_map"], p)
-    if h[3] == 0:
-        return None, {"field_operations": 222}
-    inv = pow(h[3], p - 2, p)
-    q = [h[i] * inv % p for i in range(3)]
-    root = _recover_square_root(_restricted_sextic(inst["pullback_profile"], q, p), p)
-    cert = None if root is None else {"plane": plane, "contact_cubic": root}
-    return cert, {"field_operations": 238}
-
-
-def _fallback_certificate(inst: dict, plane: list[int] | None = None) -> dict:
-    p = inst["p"]
-    if plane is None:
-        plane = _plane_from_q(inst, [0, 0, 0])
-    root = _normalize_projective([1, 0, 0, 1], p)
-    assert root is not None
-    if _binary_cubic_discriminant(root, p) == 0:
-        root = _random_squarefree_cubic(p, random.Random(1))
-    return {"plane": plane, "contact_cubic": root}
-
-
-def _outlier_coordinate_attack(inst: dict) -> object:
-    p = inst["p"]
-    candidates = []
-    for i in range(4):
-        plane = [1 if j == i else 0 for j in range(4)]
-        h = _rowmul(plane, inst["cone_map"], p)
-        if h[3] == 0:
-            continue
-        inv = pow(h[3], p - 2, p)
-        q = [h[j] * inv % p for j in range(3)]
-        sextic = _restricted_sextic(inst["pullback_profile"], q, p)
-        # A cheap outlier score: count zero coefficients and palindromic matches.
-        score = sum(value == 0 for value in sextic) + sum(
-            sextic[j] == sextic[6 - j] for j in range(3)
-        )
-        candidates.append((score, plane, q))
-    if not candidates:
-        return _fallback_certificate(inst)
-    _, plane, q = max(candidates, key=lambda item: item[0])
-    cert = _certificate_from_q(inst, q)
-    return cert if cert is not None else _fallback_certificate(inst, plane)
-
-
-def _greedy_zero_fibre_attack(inst: dict) -> object:
-    cert = _certificate_from_q(inst, [0, 0, 0])
-    return cert if cert is not None else _fallback_certificate(inst)
-
-
-def _random_restart_attack(inst: dict, rng: random.Random, restarts: int = 256) -> tuple[object, int]:
-    p = inst["p"]
-    for attempt in range(1, restarts + 1):
-        q = [rng.randrange(p) for _ in range(3)]
-        cert = _certificate_from_q(inst, q)
-        if cert is not None:
-            return cert, attempt
-    return _fallback_certificate(inst), restarts
-
-
-def _coordinate_hessian_attack(inst: dict) -> tuple[object, int]:
-    p = inst["p"]
-    for i in range(4):
-        direction = [1 if j == i else 0 for j in range(4)]
-        plane = _normalize_projective(
-            _directional_second_polar(inst["cubic"], direction, p), p
-        )
-        if plane is None:
-            continue
-        h = _rowmul(plane, inst["cone_map"], p)
-        if h[3] == 0:
-            continue
-        inv = pow(h[3], p - 2, p)
-        q = [h[j] * inv % p for j in range(3)]
-        cert = _certificate_from_q(inst, q)
-        if cert is not None:
-            return cert, i + 1
-    return _fallback_certificate(inst), 4
-
-
-def _transform_instance(inst: dict, change: list[list[int]], qscale: int, gscale: int) -> dict:
-    p = inst["p"]
-    inverse = _inverse_mod(change, p)
-    assert inverse is not None
-    moved = dict(inst)
-    moved["quadric"] = [
-        qscale * value % p
-        for value in _linear_substitute(inst["quadric"], 2, inverse, p)
-    ]
-    moved["cubic"] = [
-        gscale * value % p
-        for value in _linear_substitute(inst["cubic"], 3, inverse, p)
-    ]
-    moved["cone_map"] = _matmul(change, inst["cone_map"], p)
-    moved["pullback_profile"] = _pullback_profile(
-        moved["cubic"], moved["cone_map"], p
-    )
-    plane = _normalize_projective(
-        _rowmul(inst["answer"]["plane"], inverse, p), p
-    )
-    assert plane is not None
-    moved["answer"] = {
-        "plane": plane,
-        "contact_cubic": list(inst["answer"]["contact_cubic"]),
-    }
-    return moved
-
-
-def _answer_metrics(answer: object) -> tuple[int, int, int]:
-    blob = json.dumps(answer, separators=(",", ":"))
-    atoms = 0
-
-    def walk(value: object) -> None:
-        nonlocal atoms
-        if isinstance(value, dict):
-            for child in value.values():
-                walk(child)
-        elif isinstance(value, list):
-            for child in value:
-                walk(child)
-        else:
-            atoms += 1
-
-    walk(answer)
-    return len(blob), math.ceil(len(blob) / 4), atoms
-
