+    while True:
+        a, b, c, d = [rng.randrange(p) for _ in range(4)]
+        if (a * d - b * c) % p:
+            break
+    shift = [rng.randrange(p) for _ in range(3)]
+    scale = rng.randrange(1, p)
+    return [
+        [a * a % p, 2 * a * b % p, b * b % p, 0],
+        [a * c % p, (a * d + b * c) % p, b * d % p, 0],
+        [c * c % p, 2 * c * d % p, d * d % p, 0],
+        [shift[0], shift[1], shift[2], scale],
+    ]
