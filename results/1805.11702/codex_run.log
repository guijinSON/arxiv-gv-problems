-def _format_monomials(monomials: list[tuple[int, ...]]) -> str:
-    names = []
-    for mon in monomials:
-        factors = []
-        for index, exponent in enumerate(mon):
-            if exponent == 1:
-                factors.append(f"x{index}")
-            elif exponent > 1:
-                factors.append(f"x{index}^{exponent}")
-        names.append("*".join(factors) if factors else "1")
-    return "[" + ", ".join(names) + "]"
-
-
-def render(inst: dict) -> str:
-    """Render the complete exact finite-field tritangent problem."""
-    p = inst["p"]
-    statement = f"""Find a tritangent plane to a space sextic on a quadric cone.
-
-All arithmetic is in the finite field F_{p}; write each residue as its unique
-integer in 0,...,{p - 1}.  Projective vectors are normalized by making their
-first nonzero coefficient equal to 1.
-
-Let x=(x0,x1,x2,x3) be homogeneous coordinates on projective 3-space.  The
-curve C is the common zero set of a quadratic Q and a cubic G.  Coefficient
-vectors below use these monomial orders:
-
-degree 2: {_format_monomials(_MONOMIALS_2)}
-degree 3: {_format_monomials(_MONOMIALS_3)}
-
-Q coefficients: {json.dumps(inst['quadric'], separators=(',', ':'))}
-G coefficients: {json.dumps(inst['cubic'], separators=(',', ':'))}
-
-The following invertible 4 by 4 matrix P gives a fixed parametrization of the
-quadric cone.  For z=(s^2,s*t,t^2,w)^T, set x=P*z:
-P = {json.dumps(inst['cone_map'], separators=(',', ':'))}
-
-A candidate plane has equation l0*x0+l1*x1+l2*x2+l3*x3=0.  Put
-h=(h0,h1,h2,h3)=l*P.  The plane must not contain the cone vertex, so h3 is
-nonzero.  Its fixed conic parametrization is
-
-  phi_l(s,t) = P*(h3*s^2, h3*s*t, h3*t^2,
-                    -(h0*s^2+h1*s*t+h2*t^2))^T.
-
-The plane is a tritangent for this task exactly when there is a squarefree
-binary cubic R=r0*s^3+r1*s^2*t+r2*s*t^2+r3*t^3 such that the binary sextic
-G(phi_l(s,t)) is a nonzero scalar multiple of R(s,t)^2 in F_{p}[s,t].
-"Squarefree" means that R has three distinct projective roots over the
-algebraic closure; equivalently its usual cubic discriminant is nonzero.
-Thus the plane meets C in exactly three double contact points.  Planes through
-the vertex are excluded because they give the vanishing even theta
-characteristic rather than an odd tritangent.
-
-Return one certificate as strict JSON with exactly the keys "plane" and
-"contact_cubic".  Each value is a normalized list of exactly four residues,
-giving (l0,l1,l2,l3) and (r0,r1,r2,r3), respectively.
-
-Give your final answer inside <answer></answer> tags, as
-<answer>{{"plane":[1,0,0,0],"contact_cubic":[1,0,0,1]}}</answer>
-Output nothing else inside the tags."""
-    mode = os.environ.get("GV_HINT_MODE")
-    if mode == "structural":
-        statement += "\n\n" + STRUCTURAL_HINT
-    elif mode == "placebo":
-        statement += "\n\n" + PLACEBO_HINT
-    return statement
-
-
-def parse_answer(text: str) -> object | None:
-    """Parse strict JSON from the last answer-tag block; never raise."""
-    if not isinstance(text, str):
-        return None
-    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text, flags=re.I | re.S)
-    if not matches:
-        return None
-    payload = matches[-1].strip()
-    payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
-    payload = re.sub(r"\s*```$", "", payload)
-    try:
-        answer = json.loads(payload)
-    except (TypeError, ValueError, json.JSONDecodeError):
-        return None
-    return answer
-
-
-def _valid_coeff_vector(value: object, p: int, length: int) -> tuple[bool, str]:
-    if not isinstance(value, list) or len(value) != length:
-        return False, "shape"
-    if any(not isinstance(item, int) or isinstance(item, bool) for item in value):
-        return False, "type"
-    if any(item < 0 or item >= p for item in value):
-        return False, "range"
-    return True, "ok"
-
-
-def verify(inst: dict, answer: object) -> tuple[bool, str]:
-    """Check a tritangent certificate by exact substitution; never use answer."""
-    if not isinstance(answer, dict):
-        return False, "answer_not_object"
-    if set(answer) != {"plane", "contact_cubic"}:
-        return False, "answer_keys"
-    p = inst.get("p")
-    if not isinstance(p, int) or not _is_prime(p) or p <= 3:
-        return False, "invalid_instance_field"
-    plane_ok, plane_reason = _valid_coeff_vector(answer["plane"], p, 4)
-    if not plane_ok:
-        return False, {
-            "shape": "plane_shape",
-            "type": "coefficient_type",
-            "range": "coefficient_range",
-        }[plane_reason]
-    root_ok, root_reason = _valid_coeff_vector(answer["contact_cubic"], p, 4)
-    if not root_ok:
-        return False, {
-            "shape": "contact_cubic_shape",
-            "type": "contact_coefficient_type",
-            "range": "contact_coefficient_range",
-        }[root_reason]
-    plane = answer["plane"]
-    root = answer["contact_cubic"]
-    if _normalize_projective(plane, p) != plane:
-        return False, "plane_not_normalized"
-    if _normalize_projective(root, p) != root:
-        return False, "contact_not_normalized"
-    if _binary_cubic_discriminant(root, p) == 0:
-        return False, "contact_not_squarefree"
-    cone_map = inst.get("cone_map")
-    if (
-        not isinstance(cone_map, list)
-        or len(cone_map) != 4
-        or any(not isinstance(row, list) or len(row) != 4 for row in cone_map)
-        or _inverse_mod(cone_map, p) is None
-    ):
-        return False, "invalid_instance_cone_map"
-    quadric = inst.get("quadric")
-    cubic = inst.get("cubic")
-    if (
-        not isinstance(quadric, list)
-        or len(quadric) != len(_MONOMIALS_2)
-        or not isinstance(cubic, list)
-        or len(cubic) != len(_MONOMIALS_3)
-        or any(not isinstance(value, int) or isinstance(value, bool) for value in quadric + cubic)
-        or any(value < 0 or value >= p for value in quadric + cubic)
-    ):
-        return False, "invalid_instance_polynomials"
-    if not _cached_cone_check(
-        p, tuple(quadric), tuple(tuple(row) for row in cone_map)
-    ):
-        return False, "cone_map_does_not_parametrize_quadric"
-    h = _rowmul(plane, cone_map, p)
-    if h[3] == 0:
-        return False, "plane_through_vertex"
-    inv = pow(h[3], p - 2, p)
-    q = [h[i] * inv % p for i in range(3)]
-    # Recompute from the public Q/G/P data.  ``pullback_profile`` is only a
-    # generator-side cache and is deliberately not trusted by the checker.
-    profile = _pullback_profile(cubic, cone_map, p)
-    sextic = _restricted_sextic(profile, q, p)
-    square = _binary_cubic_square(root, p)
-    if not _projectively_equal(sextic, square, p):
-        return False, "not_tritangent_identity"
-    return True, "ok"
-
-
-def random_candidate(inst: dict, rng: random.Random) -> object:
-    """Uniform structural candidate: affine plane chart times squarefree cubics."""
-    p = inst["p"]
-    q = [rng.randrange(p) for _ in range(3)]
-    h = q + [1]
-    inverse = _inverse_mod(inst["cone_map"], p)
-    assert inverse is not None
-    plane = _normalize_projective(_rowmul(h, inverse, p), p)
-    assert plane is not None
-    return {
-        "plane": plane,
-        "contact_cubic": _random_squarefree_cubic(p, rng),
-    }
-
-
-def search_space(inst: dict) -> int:
-    p = inst["p"]
-    return p**3 * (p**3 - p)
-
-
-def _plane_from_q(inst: dict, q: list[int]) -> list[int]:
-    p = inst["p"]
-    inverse = _inverse_mod(inst["cone_map"], p)
-    assert inverse is not None
-    plane = _normalize_projective(_rowmul([x % p for x in q] + [1], inverse, p), p)
-    assert plane is not None
-    return plane
-
-
-def _certificate_from_q(inst: dict, q: list[int]) -> dict | None:
-    root = _recover_square_root(_restricted_sextic(inst["pullback_profile"], q, inst["p"]), inst["p"])
-    if root is None:
-        return None
-    return {"plane": _plane_from_q(inst, q), "contact_cubic": root}
-
-
-def _scan_tritangents(inst: dict, stop_after_first: bool) -> tuple[dict | None, int, int]:
-    p = inst["p"]
-    first: dict | None = None
-    count = 0
-    tested = 0
-    for q0 in range(p):
-        for q1 in range(p):
-            for q2 in range(p):
-                tested += 1
-                cert = _certificate_from_q(inst, [q0, q1, q2])
-                if cert is not None:
-                    count += 1
-                    if first is None:
-                        first = cert
-                    if stop_after_first:
-                        return first, count, tested
-    return first, count, tested
-
-
-def enumerate_all(inst: dict) -> int | None:
-    if inst["p"] > 70:
-        return None
-    return _scan_tritangents(inst, stop_after_first=False)[1]
-
-
-def canonical_key(inst: dict) -> str:
-    """Ambient-coordinate invariant via the supplied cone parametrisation."""
-    p = inst["p"]
-    profile = _pullback_profile(inst["cubic"], inst["cone_map"], p)
-    flat = [value for part in profile for value in part]
-    normalized = _normalize_projective(flat, p)
-    if normalized is None:
-        normalized = flat
-    payload = json.dumps([p, normalized], separators=(",", ":"))
-    return hashlib.sha256(payload.encode()).hexdigest()
-
-
-def escalate(params: dict) -> dict | str | None:
-    harder = dict(params)
-    current = int(harder.get("n", 7))
-    if current >= 1_000_003:
-        return "cap_bound"
-    harder["n"] = current * 2 + 1
-    harder["scramble"] = True
-    harder.pop("prime", None)
-    return harder
-
