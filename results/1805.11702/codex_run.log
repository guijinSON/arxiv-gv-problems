+def _matrix_inverse(matrix: list[list[int]], p: int) -> list[list[int]] | None:
+    n = len(matrix)
+    work = [
+        [matrix[i][j] % p for j in range(n)]
+        + [1 if i == j else 0 for j in range(n)]
+        for i in range(n)
