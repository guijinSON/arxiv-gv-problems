-def verify(inst: dict, answer: object) -> tuple[bool, str]:
-    """Check a tritangent certificate by exact substitution; never use answer."""
-    if not isinstance(answer, dict):
-        return False, "answer_not_object"
-    if set(answer) != {"plane", "contact_cubic"}:
-        return False, "answer_keys"
-    p = inst.get("p")
-    if not isinstance(p, int) or not _is_prime(p) or p <= 3:
-        return False, "invalid_instance_field"
-    plane_ok, plane_reason = _valid_coeff_vector(answer["plane"], p, 4)
-    if not plane_ok:
-        return False, {
-            "shape": "plane_shape",
-            "type": "coefficient_type",
-            "range": "coefficient_range",
-        }[plane_reason]
-    root_ok, root_reason = _valid_coeff_vector(answer["contact_cubic"], p, 4)
-    if not root_ok:
-        return False, {
-            "shape": "contact_cubic_shape",
-            "type": "contact_coefficient_type",
-            "range": "contact_coefficient_range",
-        }[root_reason]
-    plane = answer["plane"]
-    root = answer["contact_cubic"]
-    if _normalize_projective(plane, p) != plane:
-        return False, "plane_not_normalized"
-    if _normalize_projective(root, p) != root:
-        return False, "contact_not_normalized"
-    if _binary_cubic_discriminant(root, p) == 0:
-        return False, "contact_not_squarefree"
-    cone_map = inst.get("cone_map")
-    if (
-        not isinstance(cone_map, list)
-        or len(cone_map) != 4
-        or any(not isinstance(row, list) or len(row) != 4 for row in cone_map)
-        or _inverse_mod(cone_map, p) is None
-    ):
-        return False, "invalid_instance_cone_map"
-    quadric = inst.get("quadric")
-    cubic = inst.get("cubic")
-    if (
-        not isinstance(quadric, list)
-        or len(quadric) != len(_MONOMIALS_2)
-        or not isinstance(cubic, list)
-        or len(cubic) != len(_MONOMIALS_3)
-        or any(not isinstance(value, int) or isinstance(value, bool) for value in quadric + cubic)
-        or any(value < 0 or value >= p for value in quadric + cubic)
-    ):
-        return False, "invalid_instance_polynomials"
-    if not _cached_cone_check(
-        p, tuple(quadric), tuple(tuple(row) for row in cone_map)
-    ):
-        return False, "cone_map_does_not_parametrize_quadric"
-    h = _rowmul(plane, cone_map, p)
-    if h[3] == 0:
-        return False, "plane_through_vertex"
-    inv = pow(h[3], p - 2, p)
-    q = [h[i] * inv % p for i in range(3)]
-    # Recompute from the public Q/G/P data.  ``pullback_profile`` is only a
-    # generator-side cache and is deliberately not trusted by the checker.
-    profile = _pullback_profile(cubic, cone_map, p)
-    sextic = _restricted_sextic(profile, q, p)
-    square = _binary_cubic_square(root, p)
-    if not _projectively_equal(sextic, square, p):
-        return False, "not_tritangent_identity"
-    return True, "ok"
-
