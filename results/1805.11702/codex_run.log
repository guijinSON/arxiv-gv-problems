+def _resultant(f: list[int], g: list[int], p: int) -> int:
+    """Resultant of ascending-coefficient univariate polynomials."""
+    while len(f) > 1 and f[-1] % p == 0:
+        f = f[:-1]
+    while len(g) > 1 and g[-1] % p == 0:
+        g = g[:-1]
+    m, n = len(f) - 1, len(g) - 1
+    if m < 0 or n < 0:
+        return 0
+    fd, gd = list(reversed(f)), list(reversed(g))
+    size = m + n
+    sylvester: list[list[int]] = []
+    for shift in range(n):
+        sylvester.append([0] * shift + fd + [0] * (n - 1 - shift))
+    for shift in range(m):
+        sylvester.append([0] * shift + gd + [0] * (m - 1 - shift))
