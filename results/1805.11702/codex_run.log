+
+def _vector_to_poly(coeffs: list[int], degree: int) -> dict[tuple[int, ...], int]:
+    mons = _MONOMIALS_2 if degree == 2 else _MONOMIALS_3
+    return {mon: coeff for mon, coeff in zip(mons, coeffs) if coeff}
+
+
+def _poly_to_vector(poly: dict[tuple[int, ...], int], degree: int, p: int) -> list[int]:
+    mons = _MONOMIALS_2 if degree == 2 else _MONOMIALS_3
+    return [poly.get(mon, 0) % p for mon in mons]
+
+
+def _sparse_mul(
+    a: dict[tuple[int, ...], int],
+    b: dict[tuple[int, ...], int],
+    p: int,
+) -> dict[tuple[int, ...], int]:
+    out: dict[tuple[int, ...], int] = {}
+    for ma, ca in a.items():
+        for mb, cb in b.items():
+            mon = tuple(x + y for x, y in zip(ma, mb))
+            out[mon] = (out.get(mon, 0) + ca * cb) % p
