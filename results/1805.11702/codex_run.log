   939	def escalate(params: dict) -> dict | str | None:
   940	    harder = dict(params)
   941	    current = int(harder.get("n", 7))
   942	    if current >= 1_000_003:
   943	        return "cap_bound"
   944	    harder["n"] = current * 2 + 1
   945	    harder["scramble"] = True
   946	    harder.pop("prime", None)
   947	    return harder
