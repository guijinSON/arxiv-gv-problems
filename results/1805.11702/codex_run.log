-
-# ---------------------------------------------------------------------------
-# Small exact finite-field and polynomial routines
-
-
-def _is_prime(value: int) -> bool:
-    if value < 2:
-        return False
-    if value % 2 == 0:
-        return value == 2
-    d = 3
-    while d * d <= value:
-        if value % d == 0:
-            return False
-        d += 2
-    return True
-
-
-def _next_prime(value: int) -> int:
-    value = max(7, int(value))
-    if value % 2 == 0:
-        value += 1
-    while not _is_prime(value):
-        value += 2
-    return value
-
-
-def _monomials(degree: int, variables: int = 4) -> list[tuple[int, ...]]:
-    out: list[tuple[int, ...]] = []
-
-    def rec(prefix: list[int], left: int, slots: int) -> None:
-        if slots == 1:
-            out.append(tuple(prefix + [left]))
-            return
-        for exponent in range(left, -1, -1):
-            rec(prefix + [exponent], left - exponent, slots - 1)
-
-    rec([], degree, variables)
-    return out
-
-
-_MONOMIALS_2 = _monomials(2)
-_MONOMIALS_3 = _monomials(3)
-
-
-def _poly_add(a: list[int], b: list[int], p: int) -> list[int]:
-    size = max(len(a), len(b))
-    return [
-        ((a[i] if i < len(a) else 0) + (b[i] if i < len(b) else 0)) % p
-        for i in range(size)
-    ]
-
-
-def _poly_mul(a: list[int], b: list[int], p: int) -> list[int]:
-    if not a or not b:
-        return []
-    out = [0] * (len(a) + len(b) - 1)
-    for i, av in enumerate(a):
-        if av:
-            for j, bv in enumerate(b):
-                if bv:
-                    out[i + j] = (out[i + j] + av * bv) % p
-    return out
-
-
-def _poly_pow(a: list[int], exponent: int, p: int) -> list[int]:
-    out = [1]
-    base = list(a)
-    while exponent:
-        if exponent & 1:
-            out = _poly_mul(out, base, p)
-        exponent >>= 1
-        if exponent:
-            base = _poly_mul(base, base, p)
-    return out
-
-
-def _det_mod(matrix: list[list[int]], p: int) -> int:
-    if not matrix:
-        return 1
-    a = [[entry % p for entry in row] for row in matrix]
-    det = 1
-    n = len(a)
-    for col in range(n):
-        pivot = next((row for row in range(col, n) if a[row][col]), None)
-        if pivot is None:
-            return 0
-        if pivot != col:
-            a[col], a[pivot] = a[pivot], a[col]
-            det = -det
-        pv = a[col][col]
-        det = det * pv % p
-        inv = pow(pv, p - 2, p)
-        for row in range(col + 1, n):
-            if a[row][col]:
-                factor = a[row][col] * inv % p
-                for j in range(col, n):
-                    a[row][j] = (a[row][j] - factor * a[col][j]) % p
-    return det % p
-
-
-def _inverse_mod(matrix: list[list[int]], p: int) -> list[list[int]] | None:
-    n = len(matrix)
-    if n == 0 or any(len(row) != n for row in matrix):
-        return None
-    a = [
-        [entry % p for entry in row]
-        + [1 if i == j else 0 for j in range(n)]
-        for i, row in enumerate(matrix)
-    ]
-    for col in range(n):
-        pivot = next((row for row in range(col, n) if a[row][col]), None)
-        if pivot is None:
-            return None
-        a[col], a[pivot] = a[pivot], a[col]
-        inv = pow(a[col][col], p - 2, p)
-        a[col] = [(value * inv) % p for value in a[col]]
-        for row in range(n):
-            if row != col and a[row][col]:
-                factor = a[row][col]
-                a[row] = [
-                    (a[row][j] - factor * a[col][j]) % p for j in range(2 * n)
-                ]
-    return [row[n:] for row in a]
-
-
-def _matmul(a: list[list[int]], b: list[list[int]], p: int) -> list[list[int]]:
-    return [
-        [sum(a[i][k] * b[k][j] for k in range(len(b))) % p for j in range(len(b[0]))]
-        for i in range(len(a))
-    ]
-
-
-def _rowmul(row: list[int], matrix: list[list[int]], p: int) -> list[int]:
-    return [sum(row[k] * matrix[k][j] for k in range(len(row))) % p for j in range(len(matrix[0]))]
-
-
-def _matvec(matrix: list[list[int]], vector: list[int], p: int) -> list[int]:
-    return [sum(row[j] * vector[j] for j in range(len(vector))) % p for row in matrix]
-
-
-def _normalize_projective(vector: list[int], p: int) -> list[int] | None:
-    values = [value % p for value in vector]
-    pivot = next((value for value in values if value), None)
-    if pivot is None:
-        return None
-    inv = pow(pivot, p - 2, p)
-    return [(value * inv) % p for value in values]
-
-
-def _random_invertible(size: int, p: int, rng: random.Random) -> list[list[int]]:
-    while True:
-        matrix = [[rng.randrange(p) for _ in range(size)] for _ in range(size)]
-        if _inverse_mod(matrix, p) is not None:
-            return matrix
-
-
-def _resultant(f: list[int], g: list[int], p: int) -> int:
-    """Resultant of ascending-coefficient univariate polynomials."""
-    while len(f) > 1 and f[-1] % p == 0:
-        f = f[:-1]
-    while len(g) > 1 and g[-1] % p == 0:
-        g = g[:-1]
-    m, n = len(f) - 1, len(g) - 1
-    if m < 0 or n < 0:
-        return 0
-    fd, gd = list(reversed(f)), list(reversed(g))
-    size = m + n
-    sylvester: list[list[int]] = []
-    for shift in range(n):
-        sylvester.append([0] * shift + fd + [0] * (n - 1 - shift))
-    for shift in range(m):
-        sylvester.append([0] * shift + gd + [0] * (m - 1 - shift))
-    return _det_mod(sylvester, p) if size else 1
-
-
-def _vector_to_poly(coeffs: list[int], degree: int) -> dict[tuple[int, ...], int]:
-    mons = _MONOMIALS_2 if degree == 2 else _MONOMIALS_3
-    return {mon: coeff for mon, coeff in zip(mons, coeffs) if coeff}
-
-
-def _poly_to_vector(poly: dict[tuple[int, ...], int], degree: int, p: int) -> list[int]:
-    mons = _MONOMIALS_2 if degree == 2 else _MONOMIALS_3
-    return [poly.get(mon, 0) % p for mon in mons]
-
-
-def _sparse_mul(
-    a: dict[tuple[int, ...], int],
-    b: dict[tuple[int, ...], int],
-    p: int,
-) -> dict[tuple[int, ...], int]:
-    out: dict[tuple[int, ...], int] = {}
-    for ma, ca in a.items():
-        for mb, cb in b.items():
-            mon = tuple(x + y for x, y in zip(ma, mb))
-            out[mon] = (out.get(mon, 0) + ca * cb) % p
-    return {mon: coeff for mon, coeff in out.items() if coeff}
-
-
-def _linear_substitute(
-    coeffs: list[int], degree: int, transform: list[list[int]], p: int
-) -> list[int]:
-    """Return f(transform*y) in the fixed homogeneous monomial order."""
-    mons = _MONOMIALS_2 if degree == 2 else _MONOMIALS_3
-    linear = []
-    for row in transform:
-        linear.append(
-            {
-                tuple(1 if i == j else 0 for i in range(4)): value % p
-                for j, value in enumerate(row)
-                if value % p
-            }
-        )
-    out: dict[tuple[int, ...], int] = {}
-    one = {(0, 0, 0, 0): 1}
-    for mon, coefficient in zip(mons, coeffs):
-        if not coefficient:
-            continue
-        term = one
-        for variable, exponent in enumerate(mon):
-            for _ in range(exponent):
-                term = _sparse_mul(term, linear[variable], p)
-        for exponent, value in term.items():
-            out[exponent] = (out.get(exponent, 0) + coefficient * value) % p
-    return _poly_to_vector(out, degree, p)
-
-
-def _binary_cubic_discriminant(coeffs: list[int], p: int) -> int:
-    a, b, c, d = coeffs
-    return (
-        b * b * c * c
-        - 4 * a * c * c * c
-        - 4 * b * b * b * d
-        - 27 * a * a * d * d
-        + 18 * a * b * c * d
-    ) % p
-
-
-def _binary_cubic_square(coeffs: list[int], p: int) -> list[int]:
-    return _poly_mul(coeffs, coeffs, p)
-
-
-def _projectively_equal(a: list[int], b: list[int], p: int) -> bool:
-    na = _normalize_projective(a, p)
-    nb = _normalize_projective(b, p)
-    return na is not None and na == nb
-
-
-def _recover_square_root(sextic: list[int], p: int) -> list[int] | None:
-    """Recover normalized R if sextic is a nonzero scalar times R^2."""
-    first = next((i for i, value in enumerate(sextic) if value % p), None)
-    if first is None or first % 2 or first > 6:
-        return None
-    pivot = first // 2
-    root = [0, 0, 0, 0]
-    root[pivot] = 1
-    scale = sextic[first] % p
-    inv_two_scale = pow((2 * scale) % p, p - 2, p)
-    for offset in range(1, 4 - pivot):
-        index = first + offset
-        known = 0
-        for i in range(pivot + 1, pivot + offset):
-            j = index - i
-            if pivot < j < pivot + offset:
-                known = (known + root[i] * root[j]) % p
-        root[pivot + offset] = ((sextic[index] - scale * known) * inv_two_scale) % p
-    square = _binary_cubic_square(root, p)
-    if not _projectively_equal(sextic, square, p):
-        return None
-    root = _normalize_projective(root, p)
-    if root is None or _binary_cubic_discriminant(root, p) == 0:
-        return None
-    return root
-
-
-def _random_squarefree_cubic(p: int, rng: random.Random) -> list[int]:
-    while True:
-        raw = [rng.randrange(p) for _ in range(4)]
-        normalized = _normalize_projective(raw, p)
-        if normalized is not None and _binary_cubic_discriminant(normalized, p):
-            return normalized
-
-
-def _base_quadric_vector(p: int) -> list[int]:
-    poly = {(0, 2, 0, 0): 1, (1, 0, 1, 0): -1 % p}
-    return _poly_to_vector(poly, 2, p)
-
-
-@lru_cache(maxsize=512)
-def _cached_cone_check(
-    p: int, quadric: tuple[int, ...], cone_rows: tuple[tuple[int, ...], ...]
-) -> bool:
-    pulled = _linear_substitute(
-        list(quadric), 2, [list(row) for row in cone_rows], p
-    )
-    return _projectively_equal(pulled, _base_quadric_vector(p), p)
-
-
-def _base_cubic_vector(a: int, b: int, p: int) -> list[int]:
-    # R=s^3+b*s*t^2+a*t^3.  The chosen representatives below restrict on
-    # x1^2=x0*x2 to R^2.
-    poly = {
-        (3, 0, 0, 0): 1,
-        (2, 0, 1, 0): 2 * b,
-        (0, 3, 0, 0): 2 * a,
-        (1, 0, 2, 0): b * b,
-        (0, 1, 2, 0): 2 * a * b,
-        (0, 0, 3, 0): a * a,
-        (0, 0, 2, 1): 1,
-        (0, 0, 0, 3): 1,
-    }
-    return _poly_to_vector(poly, 3, p)
-
-
-def _smooth_parameters(p: int, rng: random.Random, demo: bool) -> tuple[int, int]:
-    if demo:
-        return 1, 0
-    for _ in range(10_000):
-        a, b = rng.randrange(p), rng.randrange(p)
-        r = [a, b, 0, 1]  # ascending coefficients of z^3+b*z+a
-        rp = [b, 0, 3]
-        if _resultant(r, rp, p) == 0:
-            continue
-        r4 = _poly_pow(r, 4, p)
-        obstruction = [(27 * value) % p for value in r4]
-        obstruction[0] = (obstruction[0] + 4) % p
-        if _resultant(rp, obstruction, p):
-            return a, b
-    raise RuntimeError("could not sample smooth base parameters")
-
-
-def _cone_automorphism(p: int, rng: random.Random) -> tuple[list[list[int]], list[int]]:
-    gl2 = _random_invertible(2, p, rng)
-    u0, u1 = gl2[0]
-    v0, v1 = gl2[1]
-    lam = rng.randrange(1, p)
-    q0, q1, q2 = (rng.randrange(p) for _ in range(3))
-    matrix = [
-        [u0 * u0 % p, 2 * u0 * u1 % p, u1 * u1 % p, 0],
-        [u0 * v0 % p, (u0 * v1 + u1 * v0) % p, u1 * v1 % p, 0],
-        [v0 * v0 % p, 2 * v0 * v1 % p, v1 * v1 % p, 0],
-        [q0, q1, q2, lam],
-    ]
-    return matrix, [u0, u1, v0, v1]
-
-
-def _contact_cubic(a: int, b: int, gl2_data: list[int], p: int) -> list[int]:
-    u0, u1, v0, v1 = gl2_data
-    u = [u0, u1]
-    v = [v0, v1]
-    u3 = _poly_pow(u, 3, p)
-    uv2 = _poly_mul(u, _poly_pow(v, 2, p), p)
-    v3 = _poly_pow(v, 3, p)
-    out = [
-        (u3[i] + b * uv2[i] + a * v3[i]) % p for i in range(4)
-    ]
-    normalized = _normalize_projective(out, p)
-    if normalized is None:
-        raise RuntimeError("zero contact cubic")
-    return normalized
-
-
-def _pullback_profile(cubic: list[int], cone_map: list[list[int]], p: int) -> list[list[int]]:
-    """Coefficients of G(P[s^2,st,t^2,w]), grouped by w degree 0..3."""
-    pulled = _linear_substitute(cubic, 3, cone_map, p)
-    groups = [[0] * (7 - 2 * wdeg) for wdeg in range(4)]
-    for mon, coefficient in zip(_MONOMIALS_3, pulled):
-        if not coefficient:
-            continue
-        e0, e1, e2, ew = mon
-        s_degree = 2 * e0 + e1
-        binary_degree = 6 - 2 * ew
-        t_degree = binary_degree - s_degree
-        if 0 <= t_degree < len(groups[ew]):
-            groups[ew][t_degree] = (groups[ew][t_degree] + coefficient) % p
-    return groups
-
-
-def _restricted_sextic(profile: list[list[int]], q: list[int], p: int) -> list[int]:
-    # Substitute w=-q(s,t) in B0+B1*w+B2*w^2+B3*w^3.
-    q2 = _poly_mul(q, q, p)
-    q3 = _poly_mul(q2, q, p)
-    terms = [
-        profile[0],
-        [(-value) % p for value in _poly_mul(profile[1], q, p)],
-        _poly_mul(profile[2], q2, p),
-        [(-value) % p for value in _poly_mul(profile[3], q3, p)],
-    ]
-    out = [0] * 7
-    for term in terms:
-        for i, value in enumerate(term):
-            out[i] = (out[i] + value) % p
-    return out
-
-
-def _directional_second_polar(cubic: list[int], direction: list[int], p: int) -> list[int]:
-    """Coefficients of D_direction^2(G), a linear form."""
-    result = [0, 0, 0, 0]
-    for mon, coefficient in zip(_MONOMIALS_3, cubic):
-        if not coefficient:
-            continue
-        for i in range(4):
-            if mon[i] == 0 or direction[i] == 0:
-                continue
-            after_i = list(mon)
-            after_i[i] -= 1
-            ci = coefficient * mon[i] * direction[i]
-            for j in range(4):
-                if after_i[j] == 0 or direction[j] == 0:
-                    continue
-                after = list(after_i)
-                after[j] -= 1
-                if sum(after) != 1:
-                    continue
-                variable = after.index(1)
-                value = ci * after_i[j] * direction[j]
-                result[variable] = (result[variable] + value) % p
-    return result
-
-
-def _quadric_matrix(coeffs: list[int], p: int) -> list[list[int]]:
-    """Symmetric A with x^T A x=Q(x), using inv(2) off diagonal."""
-    inv2 = pow(2, p - 2, p)
-    matrix = [[0] * 4 for _ in range(4)]
-    for mon, coefficient in zip(_MONOMIALS_2, coeffs):
-        indices = [i for i, exponent in enumerate(mon) for _ in range(exponent)]
-        i, j = indices
-        if i == j:
-            matrix[i][i] = (matrix[i][i] + coefficient) % p
-        else:
-            value = coefficient * inv2 % p
-            matrix[i][j] = (matrix[i][j] + value) % p
-            matrix[j][i] = (matrix[j][i] + value) % p
-    return matrix
-
-
-def _kernel_vector(matrix: list[list[int]], p: int) -> list[int] | None:
-    a = [[value % p for value in row] for row in matrix]
-    rows, cols = len(a), len(a[0])
-    pivots: list[int] = []
-    row = 0
-    for col in range(cols):
-        pivot = next((r for r in range(row, rows) if a[r][col]), None)
-        if pivot is None:
-            continue
-        a[row], a[pivot] = a[pivot], a[row]
-        inv = pow(a[row][col], p - 2, p)
-        a[row] = [value * inv % p for value in a[row]]
-        for r in range(rows):
-            if r != row and a[r][col]:
-                factor = a[r][col]
-                a[r] = [(a[r][j] - factor * a[row][j]) % p for j in range(cols)]
-        pivots.append(col)
-        row += 1
-        if row == rows:
-            break
-    free = [col for col in range(cols) if col not in pivots]
-    if len(free) != 1:
-        return None
-    vector = [0] * cols
-    vector[free[0]] = 1
-    for r in range(len(pivots) - 1, -1, -1):
-        col = pivots[r]
-        vector[col] = -sum(a[r][j] * vector[j] for j in free) % p
-    return _normalize_projective(vector, p)
