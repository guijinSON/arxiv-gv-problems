-
-def canonical_key(inst: dict) -> str:
-    """Ambient-coordinate invariant via the supplied cone parametrisation."""
-    p = inst["p"]
-    profile = _pullback_profile(inst["cubic"], inst["cone_map"], p)
-    flat = [value for part in profile for value in part]
-    normalized = _normalize_projective(flat, p)
-    if normalized is None:
-        normalized = flat
-    payload = json.dumps([p, normalized], separators=(",", ":"))
-    return hashlib.sha256(payload.encode()).hexdigest()
-
