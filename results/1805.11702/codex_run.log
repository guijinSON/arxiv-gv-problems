+def escalate(params: dict):
+    harder = dict(params)
+    current = _next_prime(harder.get("modulus", harder.get("n", 101)))
+    if current >= 8191:
+        return "cap_bound"
+    harder["n"] = _next_prime(2 * current + 1)
+    harder.pop("modulus", None)
+    return harder
