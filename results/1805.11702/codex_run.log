   972	def _fallback_certificate(inst: dict, plane: list[int] | None = None) -> dict:
   973	    p = inst["p"]
   974	    if plane is None:
   975	        plane = _plane_from_q(inst, [0, 0, 0])
   976	    root = _normalize_projective([1, 0, 0, 1], p)
   977	    assert root is not None
   978	    if _binary_cubic_discriminant(root, p) == 0:
   979	        root = _random_squarefree_cubic(p, random.Random(1))
   980	    return {"plane": plane, "contact_cubic": root}
