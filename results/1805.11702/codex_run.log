+def _uadd(a: list[int], b: list[int], p: int) -> list[int]:
+    out = [0] * max(len(a), len(b))
+    for i, value in enumerate(a):
+        out[i] = (out[i] + value) % p
+    for i, value in enumerate(b):
+        out[i] = (out[i] + value) % p
+    return _trim(out, p)
