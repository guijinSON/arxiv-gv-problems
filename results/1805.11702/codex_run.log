   954	def _compact_route(inst: dict) -> tuple[dict | None, dict[str, int]]:
   955	    p = inst["p"]
   956	    vertex = _kernel_vector(_quadric_matrix(inst["quadric"], p), p)
   957	    if vertex is None:
   958	        return None, {"field_operations": 96}
   959	    plane = _normalize_projective(_directional_second_polar(inst["cubic"], vertex, p), p)
   960	    if plane is None:
   961	        return None, {"field_operations": 206}
   962	    h = _rowmul(plane, inst["cone_map"], p)
   963	    if h[3] == 0:
   964	        return None, {"field_operations": 222}
   965	    inv = pow(h[3], p - 2, p)
   966	    q = [h[i] * inv % p for i in range(3)]
   967	    root = _recover_square_root(_restricted_sextic(inst["pullback_profile"], q, p), p)
   968	    cert = None if root is None else {"plane": plane, "contact_cubic": root}
   969	    return cert, {"field_operations": 238}
