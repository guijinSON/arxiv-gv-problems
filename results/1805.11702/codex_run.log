-def _is_prime(value: int) -> bool:
-    if value < 2:
-        return False
-    if value % 2 == 0:
-        return value == 2
-    d = 3
-    while d * d <= value:
-        if value % d == 0:
-            return False
-        d += 2
-    return True
-
-
-def _next_prime(value: int) -> int:
-    value = max(7, int(value))
-    if value % 2 == 0:
-        value += 1
-    while not _is_prime(value):
-        value += 2
-    return value
-
-
-def _monomials(degree: int, variables: int = 4) -> list[tuple[int, ...]]:
-    out: list[tuple[int, ...]] = []
-
-    def rec(prefix: list[int], left: int, slots: int) -> None:
-        if slots == 1:
-            out.append(tuple(prefix + [left]))
-            return
-        for exponent in range(left, -1, -1):
-            rec(prefix + [exponent], left - exponent, slots - 1)
-
-    rec([], degree, variables)
-    return out
-
-
-_MONOMIALS_2 = _monomials(2)
-_MONOMIALS_3 = _monomials(3)
-
-
-def _poly_add(a: list[int], b: list[int], p: int) -> list[int]:
-    size = max(len(a), len(b))
-    return [
-        ((a[i] if i < len(a) else 0) + (b[i] if i < len(b) else 0)) % p
-        for i in range(size)
-    ]
-
-
-def _poly_mul(a: list[int], b: list[int], p: int) -> list[int]:
-    if not a or not b:
-        return []
-    out = [0] * (len(a) + len(b) - 1)
-    for i, av in enumerate(a):
-        if av:
-            for j, bv in enumerate(b):
-                if bv:
-                    out[i + j] = (out[i + j] + av * bv) % p
-    return out
-
-
-def _poly_pow(a: list[int], exponent: int, p: int) -> list[int]:
-    out = [1]
-    base = list(a)
-    while exponent:
-        if exponent & 1:
-            out = _poly_mul(out, base, p)
-        exponent >>= 1
-        if exponent:
-            base = _poly_mul(base, base, p)
-    return out
-
-
-def _det_mod(matrix: list[list[int]], p: int) -> int:
-    if not matrix:
-        return 1
-    a = [[entry % p for entry in row] for row in matrix]
-    det = 1
-    n = len(a)
-    for col in range(n):
-        pivot = next((row for row in range(col, n) if a[row][col]), None)
-        if pivot is None:
-            return 0
-        if pivot != col:
-            a[col], a[pivot] = a[pivot], a[col]
-            det = -det
-        pv = a[col][col]
-        det = det * pv % p
-        inv = pow(pv, p - 2, p)
-        for row in range(col + 1, n):
-            if a[row][col]:
-                factor = a[row][col] * inv % p
-                for j in range(col, n):
-                    a[row][j] = (a[row][j] - factor * a[col][j]) % p
-    return det % p
-
-
-def _inverse_mod(matrix: list[list[int]], p: int) -> list[list[int]] | None:
-    n = len(matrix)
-    if n == 0 or any(len(row) != n for row in matrix):
-        return None
-    a = [
-        [entry % p for entry in row]
-        + [1 if i == j else 0 for j in range(n)]
-        for i, row in enumerate(matrix)
-    ]
-    for col in range(n):
-        pivot = next((row for row in range(col, n) if a[row][col]), None)
-        if pivot is None:
-            return None
-        a[col], a[pivot] = a[pivot], a[col]
-        inv = pow(a[col][col], p - 2, p)
-        a[col] = [(value * inv) % p for value in a[col]]
-        for row in range(n):
-            if row != col and a[row][col]:
-                factor = a[row][col]
-                a[row] = [
-                    (a[row][j] - factor * a[col][j]) % p for j in range(2 * n)
-                ]
-    return [row[n:] for row in a]
-
-
-def _matmul(a: list[list[int]], b: list[list[int]], p: int) -> list[list[int]]:
-    return [
-        [sum(a[i][k] * b[k][j] for k in range(len(b))) % p for j in range(len(b[0]))]
-        for i in range(len(a))
-    ]
-
-
-def _rowmul(row: list[int], matrix: list[list[int]], p: int) -> list[int]:
-    return [sum(row[k] * matrix[k][j] for k in range(len(row))) % p for j in range(len(matrix[0]))]
-
-
-def _matvec(matrix: list[list[int]], vector: list[int], p: int) -> list[int]:
-    return [sum(row[j] * vector[j] for j in range(len(vector))) % p for row in matrix]
-
-
-def _normalize_projective(vector: list[int], p: int) -> list[int] | None:
-    values = [value % p for value in vector]
-    pivot = next((value for value in values if value), None)
-    if pivot is None:
-        return None
-    inv = pow(pivot, p - 2, p)
-    return [(value * inv) % p for value in values]
-
