   784	def _valid_coeff_vector(value: object, p: int, length: int) -> tuple[bool, str]:
   785	    if not isinstance(value, list) or len(value) != length:
   786	        return False, "shape"
   787	    if any(not isinstance(item, int) or isinstance(item, bool) for item in value):
   788	        return False, "type"
   789	    if any(item < 0 or item >= p for item in value):
   790	        return False, "range"
   791	    return True, "ok"
