  1051	        gscale * value % p
  1052	        for value in _linear_substitute(inst["cubic"], 3, inverse, p)
  1053	    ]
  1054	    moved["cone_map"] = _matmul(change, inst["cone_map"], p)
  1055	    moved["pullback_profile"] = _pullback_profile(
  1056	        moved["cubic"], moved["cone_map"], p
  1057	    )
  1058	    plane = _normalize_projective(
  1059	        _rowmul(inst["answer"]["plane"], inverse, p), p
  1060	    )
  1061	    assert plane is not None
  1062	    moved["answer"] = {
  1063	        "plane": plane,
  1064	        "contact_cubic": list(inst["answer"]["contact_cubic"]),
  1065	    }
  1066	    return moved
