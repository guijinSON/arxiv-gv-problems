-def random_candidate(inst: dict, rng: random.Random) -> object:
-    """Uniform structural candidate: affine plane chart times squarefree cubics."""
-    p = inst["p"]
-    q = [rng.randrange(p) for _ in range(3)]
-    h = q + [1]
-    inverse = _inverse_mod(inst["cone_map"], p)
-    assert inverse is not None
-    plane = _normalize_projective(_rowmul(h, inverse, p), p)
-    assert plane is not None
-    return {
-        "plane": plane,
-        "contact_cubic": _random_squarefree_cubic(p, rng),
-    }
-
-
-def search_space(inst: dict) -> int:
-    p = inst["p"]
-    return p**3 * (p**3 - p)
-
-
-def _plane_from_q(inst: dict, q: list[int]) -> list[int]:
-    p = inst["p"]
-    inverse = _inverse_mod(inst["cone_map"], p)
-    assert inverse is not None
-    plane = _normalize_projective(_rowmul([x % p for x in q] + [1], inverse, p), p)
-    assert plane is not None
-    return plane
-
-
-def _certificate_from_q(inst: dict, q: list[int]) -> dict | None:
-    root = _recover_square_root(_restricted_sextic(inst["pullback_profile"], q, inst["p"]), inst["p"])
-    if root is None:
-        return None
-    return {"plane": _plane_from_q(inst, q), "contact_cubic": root}
-
-
-def _scan_tritangents(inst: dict, stop_after_first: bool) -> tuple[dict | None, int, int]:
-    p = inst["p"]
-    first: dict | None = None
-    count = 0
-    tested = 0
-    for q0 in range(p):
-        for q1 in range(p):
-            for q2 in range(p):
-                tested += 1
-                cert = _certificate_from_q(inst, [q0, q1, q2])
-                if cert is not None:
-                    count += 1
-                    if first is None:
-                        first = cert
-                    if stop_after_first:
-                        return first, count, tested
-    return first, count, tested
-
-
-def enumerate_all(inst: dict) -> int | None:
-    if inst["p"] > 70:
-        return None
-    return _scan_tritangents(inst, stop_after_first=False)[1]
-
-
-def canonical_key(inst: dict) -> str:
-    """Ambient-coordinate invariant via the supplied cone parametrisation."""
-    p = inst["p"]
-    profile = _pullback_profile(inst["cubic"], inst["cone_map"], p)
-    flat = [value for part in profile for value in part]
-    normalized = _normalize_projective(flat, p)
-    if normalized is None:
-        normalized = flat
-    payload = json.dumps([p, normalized], separators=(",", ":"))
-    return hashlib.sha256(payload.encode()).hexdigest()
