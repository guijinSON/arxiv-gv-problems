+        for direction in itertools.chain(((1, value) for value in range(p)), ((0, 1),)):
+            if _binary_eval(coeffs, *direction, p):
+                nonroots.append(direction)
+                if len(nonroots) >= 8:
+                    break
+        pair = None
+        for v in nonroots:
+            for w in nonroots:
+                if (v[0] * w[1] - v[1] * w[0]) % p:
+                    pair = (v, w)
+                    break
+            if pair:
