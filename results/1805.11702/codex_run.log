-def _valid_coeff_vector(value: object, p: int, length: int) -> tuple[bool, str]:
-    if not isinstance(value, list) or len(value) != length:
-        return False, "shape"
-    if any(not isinstance(item, int) or isinstance(item, bool) for item in value):
-        return False, "type"
-    if any(item < 0 or item >= p for item in value):
-        return False, "range"
-    return True, "ok"
-
