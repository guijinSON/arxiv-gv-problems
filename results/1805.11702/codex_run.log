+"""Verified tritangent-plane generators for arXiv:1805.11702.
+
+The paper studies a smooth degree-six curve C=V(Q,G) in projective 3-space
+and its tritangent planes.  This module stays in those native objects.  It
+inverse-generates a smooth sextic on a quadric cone together with one odd
+tritangent, then carries the curve, a cone parametrisation, and the contact
+divisor through independently sampled projective coordinate changes.
+
+The family is Track B.  Exhausting the finite affine chart of planes costs
+Theta(p^3) exact square tests.  On this distribution there is a compact
+geometric route: the second polar of G in the singular-vertex direction is
+the planted tritangent.  That route is deliberately not used by the
+generator to solve an instance; the certificate is carried from the seed
+identity before the public coordinates are assembled.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "geometry",
+    "object_regime": "finite_field",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "polynomial",
+    "native_objects": [
+        "rank-three quadric in projective 3-space",
+        "cubic surface cutting out a smooth space sextic",
+        "projective tritangent plane",
+        "binary cubic contact divisor",
+    ],
+    "verification_operations": [
+        "finite-field matrix multiplication",
+        "exact polynomial substitution",
+        "binary polynomial squaring",
+        "cubic discriminant comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Recognize the vertex-direction second polar of the cubic as a "
+        "distinguished plane; without that invariant, one scans the p^3 "
+        "planes not containing the cone vertex and tests sextic squares."
+    ),
+    "hardness_basis": (
+        "Track B: Algorithm 3.1 of Celik--Kulkarni--Ren--Sayyary Namin "
+        "finds tritangents by exact elimination; the finite-field reference "
+        "specialization here exhausts p^3 planes and performs O(p^3) "
+        "constant-degree field operations, with the measured shipping cost "
+        "recorded by selftest, whereas the vertex-polar invariant recovers "
+        "the witness in at most 238 exact field operations once recognized."
+    ),
+    "max_answer_tokens": 30,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 7, "scramble": False},
+    "easy": {"n": 29, "scramble": True},
+    "medium": {"n": 47, "scramble": True},
+    "hard": {"n": 67, "scramble": True},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Hint: The cubic's second polar in the quadric cone's singular-vertex "
+    "direction is a distinguished plane form."
+)
+PLACEBO_HINT = (
+    "Hint: The coefficient tables use fixed monomial orders and every "
+    "displayed calculation is modulo the stated prime."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON object with a normalized four-coefficient projective plane "
+        "not containing the cone vertex and a normalized squarefree binary "
+        "cubic. Coefficients lie in F_p, are represented by integers "
+        "0,...,p-1, and the first nonzero coefficient of each vector is 1."
+    ),
+    "bounds": {
+        "plane_coefficients": 4,
+        "contact_cubic_coefficients": 4,
+        "coefficient_range": "0 <= c < p",
+        "plane_candidates": "p^3",
+        "squarefree_binary_cubic_candidates": "p^3-p",
