-def _is_prime(value: int) -> bool:
-    if value < 2:
-        return False
-    if value % 2 == 0:
-        return value == 2
-    d = 3
-    while d * d <= value:
-        if value % d == 0:
-            return False
-        d += 2
-    return True
-
-
-def _next_prime(value: int) -> int:
-    value = max(7, int(value))
-    if value % 2 == 0:
-        value += 1
-    while not _is_prime(value):
-        value += 2
-    return value
