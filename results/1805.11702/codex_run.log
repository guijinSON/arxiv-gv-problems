+
+        start = time.perf_counter()
+        candidate, _, tested = _scan_tritangents(inst, stop_after_first=True)
+        elapsed = time.perf_counter() - start
+        reference_wall += elapsed
+        reference_tested += tested
+        reference_successes += int(
+            candidate is not None and verify(inst, candidate)[0]
+        )
+
+        compact, _ = _compact_route(inst)
+        compact_successes += int(compact is not None and verify(inst, compact)[0])
+
+    for stat in attacks.values():
+        stat["wall_clock_sec"] = round(stat["wall_clock_sec"], 6)
+    all_failed = all(stat["successes"] == 0 for stat in attacks.values())
+    reference_operations = reference_tested * 160
+    report["G6_adversary_panel"] = {
+        "pass": (
