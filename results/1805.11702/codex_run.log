   927	def canonical_key(inst: dict) -> str:
   928	    """Ambient-coordinate invariant via the supplied cone parametrisation."""
   929	    p = inst["p"]
   930	    profile = _pullback_profile(inst["cubic"], inst["cone_map"], p)
   931	    flat = [value for part in profile for value in part]
   932	    normalized = _normalize_projective(flat, p)
   933	    if normalized is None:
   934	        normalized = flat
   935	    payload = json.dumps([p, normalized], separators=(",", ":"))
   936	    return hashlib.sha256(payload.encode()).hexdigest()
