   767	def parse_answer(text: str) -> object | None:
   768	    """Parse strict JSON from the last answer-tag block; never raise."""
   769	    if not isinstance(text, str):
   770	        return None
   771	    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text, flags=re.I | re.S)
   772	    if not matches:
   773	        return None
   774	    payload = matches[-1].strip()
   775	    payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
   776	    payload = re.sub(r"\s*```$", "", payload)
   777	    try:
   778	        answer = json.loads(payload)
   779	    except (TypeError, ValueError, json.JSONDecodeError):
   780	        return None
   781	    return answer
