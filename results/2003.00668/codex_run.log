\begin{IEEEproof}
We will use an argument similar to the proof of the Gilbert-Varshamov bound for stabilizer codes
\cite{calderbank97}.
Let $\mathrm{Sp}(q,n)$ be the symplectic group over  $\mathbf{F}_q^{2n}$ \cite[Section 3]{grove02} and  $A(\ell,c)$ the set of $\mathbf{F}_q$-linear spaces $V \subseteq \mathbf{F}_q^{2n}$ such that $\dim V = \ell$ and $$\dim V - \dim \left(V^\ps\cap V \right)= 2c.$$
For $\vec{0} \neq \vec{e} \in \mathbf{F}_q^{2n}$, define
\[
B(\ell,c,\vec{e})
= \left\{ V\in A(\ell,c) \mid \vec{e} \in V^\ps \setminus (V^\ps\cap V) \right\}.
\]
Taking into account that the symplectic group acts transitively on $\mathbf{F}_q^{2n} \setminus \{\vec{0}\}$ \cite{aschbacher00,grove02}, it holds that for nonzero $\vec{e}_1$, $\vec{e}_2 \in \mathbf{F}_q^{2n}$, there exists $M \in \mathrm{Sp}(q,n)$ such that $\vec{e}_1 M= \vec{e}_2$, and, for $V_1, V_2 \in A(\ell,c)$, there exists $M \in \mathrm{Sp}(q,n)$ such that $V_1 M= V_2$.

Therefore for nonzero elements $\vec{e}_1, \vec{e}_2 \in \mathbf{F}_q^{2n}$ with $\vec{e}_1 M_1 = \vec{e}_2 \; \left(M_1 \in \mathrm{Sp}(q,n)\right)$ and some fixed linear space $V_1 \in A(\ell,c)$, we have the following chain of equalities:
\begin{eqnarray*}
  &&  \mathrm{card} (B(\ell, c, \vec{e}_1)) \\
  &=& \mathrm{card}(\{ V \in A(\ell,c) \mid \vec{e}_1 \in V^\ps \setminus (V^\ps\cap V) \}) \\
  &=& \mathrm{card}(\{ V_1 M  \mid \vec{e}_1 \in V_1^\ps M \setminus (V_1^\ps M \cap V_1 M), \\
  && M  \in \mathrm{Sp}(q,n) \})\\
  &=& \mathrm{card} (\{V_1 M  M_1^{-1}  \mid \vec{e}_1 \in V_1^\ps M  M_1^{-1} \setminus\\&& (V_1^\ps M  M_1^{-1}\cap V_1 M  M_1^{-1}), M  \in \mathrm{Sp}(q,n) \})\\
  &=& \mathrm{card}(\{ V_1 M \mid \vec{e}_1 M_1 \in V_1^\ps M \setminus (V_1^\ps M \cap V_1 M),\\&& M  \in \mathrm{Sp}(q,n) \} )\\
  &=& \mathrm{card}(\{ V_1 M  \mid \vec{e}_2 \in V_1^\ps M \setminus (V_1^\ps M\cap V_1 M),\\&& M  \in \mathrm{Sp}(q,n) \} )\\
  &=& \mathrm{card}(\{ V \in A(\ell,c) \mid \vec{e}_2 \in V^\ps \setminus (V^\ps\cap V) \} ) \\
  &=& \mathrm{card}(B(\ell, c, \vec{e}_2)),
\end{eqnarray*}
where $\mathrm{card}$ denotes the cardinality of a set.

For each $V \in A(\ell,c)$, the number of vectors $\vec{e}$ in $\mathbf{F}_q^{2n}$ such that
$\vec{e} \in V^\ps \setminus (V^\ps\cap V)$ is $$\mathrm{card}(V^\ps)-\mathrm{card}\left(V^\ps\cap V\right)=q^{2n-\ell}-q^{\ell-2c}.$$
The number of pairs $(\vec{e}$, $V)$ such that $\vec{0} \neq
\vec{e} \in V^\ps \setminus (V^\ps\cap V)$ is
\[
  \sum_{\vec{0} \neq \vec{e}\in \mathbf{F}_q^{2n}} \mathrm{card}\left(B(\ell,c,\vec{e})\right) = \mathrm{card}\left(A(\ell,c)\right) \left(q^{2n-\ell}-q^{\ell-2c}\right),
  \]
  which implies
  \begin{equation}
    \frac{\mathrm{card}\left(B(\ell,c,\vec{e})\right)}{\mathrm{card}\left(A(\ell,c)\right)} = \frac{q^{2n-\ell}-q^{\ell-2c}}{q^{2n}-1}.
    \label{eq101}
  \end{equation}
If there exists $V \in A(\ell,c)$
such that $V \notin B(\ell,c,\vec{e})$
for all nonzero vectors $\vec{e}=(\vec{e}_x|\vec{e}_z)$ such that
$0 \leq w_H(\vec{e}_x) \leq d_x-1$ and $0 \leq w_H(\vec{e}_z) \leq d_z-1$,
then there will exist $V$ with the desired properties.
The number of nonzero vectors $\vec{e}=(\vec{e}_x|\vec{e}_z)$ such that
$0 \leq w_H(\vec{e}_x) \leq d_x-1$ and $0 \leq w_H(\vec{e}_z) \leq d_z-1$
is given by
\begin{equation}
  \sum_{i=0}^{d_x - 1}
         {n \choose i}(q-1)^i \times
         \sum_{j=0}^{d_z - 1}
         {n \choose i}(q-1)^j - 1. \label{eq103}
\end{equation}
By combining Equations (\ref{eq101}) and (\ref{eq103}),  we see that Inequality (\ref{eqgv}) is a sufficient condition
for ensuring the existence of a code $C$ as in our statement. This ends the proof.
\end{IEEEproof}

In the coding theory,
asymptotic optimality has been investigated \cite{handbookcoding},
as long code length is sometimes required for higher error correction
capability. By following an argument similar to
\cite{matsumotouematsu01}, one can easily deduce an asymptotic version
of Theorem \ref{thm:main} as follows:
\begin{corollary}
  Let $L$, $\delta_x$, $\delta_z$ and $\lambda$  be real numbers such that $0\leq
  L \leq 1+\lambda$,
$0 \leq \delta_x < 1/2$,
$0 \leq \delta_z < 1/2$, and $0\leq \lambda \leq L/2$. Let $h(x) :=  -x \log_q x -(1- x) \log_q (1-x)$  be the $q$-ary entropy function. For $n$ sufficiently large, the inequality
  \begin{equation}
    h(\delta_x) + \delta_x \log_q (q-1) +
    h(\delta_z) + \delta_z \log_q (q-1)<  L, \label{eq104}\\
  \end{equation}
implies the existence of a code
  $C  \subseteq
  \mathbf{F}_q^{2n}$ over $\mathbf{F}_q$ such that
   $\dim C = \lceil nL \rceil$,
  $\dim C - \dim (C^\ps\cap C) = \lceil 2n\lambda\rceil$,
  and for any $\vec{v}_x$ and $\vec{v}_z$ with
$w_H(\vec{v}_x) \leq n \delta_x-1$ and $w_H(\vec{v}_z) \leq n\delta_z-1$
we have $(\vec{v}_x$, $\vec{v}_z) \notin
\left(C^\ps \setminus (C\cap C^\ps) \right)$. 
This means that
there exists
$[[n, n(1-L+\lambda), n\delta_z/n\delta_x; n\lambda]]_q$ EAQECC.
\end{corollary}


\section{Comparison between the Proposed and the Conventional Bounds}\label{sec3}
In this section we compare our proposed bound Theorem \ref{thm:main}
with the conventional one:
\begin{theorem}\label{thm:galindo} \cite{galindo20}
  Consider positive integer numbers $n, k_1, k_2, d_z,$ $d_x$ and $c$ such that $k_1 \leq n$, $k_2 \leq n$ and
\[
k_1 +k_2-n \leq c \leq \min \{k_1, k_2\},
\]
which satisfy the following inequality
\begin{eqnarray}
&&\frac{q^{n-k_1} - q^{k_2 - c}}{q^n-1} \sum_{i=1}^{d_z-1} {n \choose i}(q-1)^i \nonumber\\ +
  &&\frac{q^{n-k_2} - q^{k_1 - c}}{q^n-1}\sum_{i=1}^{d_x-1} {n \choose i}(q-1)^i < 1,
  \label{eq1001}
\end{eqnarray}
then there exists an $[[n,n-k_1-k_2+c,d_z/d_x;c]]_q$ asymmetric EAQECC.
\end{theorem}
The parameter $\ell$ in Theorem \ref{thm:main} corresponds to
$k_1 + k_2$ in Theorem \ref{thm:galindo}.

In order to compare Theorems \ref{thm:main} and \ref{thm:galindo},
we choose the same $q$, $n$, $c$, and $\ell = k_1 + k_2$
from each line in Table 1 of \cite{galindo20}.
For a tuple of $q$, $n$, $c$ and $\ell = k_1 + k_2$,
they \cite[Section VI]{galindo20} also introduced the set $P$
in order to quantify the maximum possible distances for a given parameters
$q$, $n$, $c$, and $\ell = k_1 + k_2$ with which existence of a quantum code
is ensured by a version of Gilbert-Varshamov bounds.
Specifically, for fixed values $(q,n,k_1,k_2,c)$ (or $(q,n,\ell=k_1+k_2,c)$),
we consider the set $P_{\mathrm{old}}$ (or $P_{\mathrm{new}}$)
of pairs $(d_1,d_2)$ of Z-minimum and X-minimum distances of asymmetric EAQECCs such that $(d_1,d_2)$  satisfies
the inequality (\ref{eq1001}) (or the inequality (\ref{eqgv}))
but either $(d_1+1,d_2)$ or $(d_1,d_2+1)$ violates
the inequality (\ref{eq1001}) (or the inequality (\ref{eqgv})),
respectively.
If for any $(d_1, d_2) \in P_{\mathrm{old}}$ there exists
$(d'_1, d'_2) \in P_{\mathrm{new}}$ such that $d_1 \leq d'_1$ and $d_2 \leq d'_2$,
then we can say that the proposed Theorem \ref{thm:main}
\emph{improves} Theorem \ref{thm:galindo}.
In Table \ref{tab1}, we see that it is actually the case.


\section{Conclusion}\label{sec4}

