   762	
   763	def _transvection_rescaled(inst, rng):
   764	    """Use T_(alpha,v)=T_(alpha/s^2,s*v) for every listed map."""
   765	    out = {k: v for k, v in inst.items() if k not in ("answer", "transvections")}
   766	    q = inst["q"]
   767	    trans = []
   768	    for t in inst["transvections"]:
   769	        s = rng.randrange(1, q)
   770	        sinv = _inv(s, q)
   771	        trans.append({
   772	            "alpha": t["alpha"] * sinv * sinv % q,
   773	            "x": [s * v % q for v in t["x"]],
   774	            "z": [s * v % q for v in t["z"]],
   775	        })
   776	    out["transvections"] = trans
   777	    out["answer"] = inst["answer"][:]
   778	    return out
