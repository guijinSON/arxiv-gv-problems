+    # G8: row permutations, qudit permutations, affine evaluation changes, and
+    # their composition.  Each key comparison is structural, never seed-based.
+    invariant_checks = 0
+    transformed_verified = 0
+    keys = []
+    for seed in range(40, 60):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        rng = random.Random(123_000 + seed)
+        row = _row_permuted(inst, rng)
