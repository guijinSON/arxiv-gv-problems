/bin/bash -lc "python3 - <<'PY'
import gen_2003_00668 as g

def rank(a,q):
    a=[r[:] for r in a]; r=0
    for c in range(len(a[0])):
        p=next((i for i in range(r,len(a)) if a[i][c]%q),None)
        if p is None: continue
        a[r],a[p]=a[p],a[r]
        z=pow(a[r][c],q-2,q)
        a[r]=[v*z%q for v in a[r]]
        for i in range(len(a)):
            if i"'!=r and a[i][c]:
                f=a[i][c]; a[i]=[(x-f*y)%q for x,y in zip(a[i],a[r])]
        r+=1
    return r
checks=0
for name,p in g.DIFFICULTY.items():
    for seed in (2,5,9):
        inst=g.make_instance(seed=seed,**p)
        hx,hz=g._materialize_h(inst)
        gram=g._generic_gram(inst,hx,hz)
        assert rank(gram,inst['"'q']) == inst['ell']-1
        ans=inst['answer']
        assert all(sum(ans[i]*gram[i][j] for i in range(inst['ell']))%inst['q']==0 for j in range(inst['ell']))
        checks+=1
print('independent Gram rank/kernel checks:',checks)
