+    reasons = {v["reason"] for v in rejected.values()}
+    report["G2_rejects_corruption"] = {
+        "pass": all(v["rejected"] for v in rejected.values()) and len(reasons) == 5,
+        "cases": rejected, "distinct_reasons": len(reasons),
