   725	def _row_rescaled(inst, rng):
   726	    """Apply independent nonzero scalings to the displayed H rows."""
   727	    out = {k: v for k, v in inst.items() if k != "answer"}
   728	    q = inst["q"]
   729	    scales = [rng.randrange(1, q) for _ in range(inst["ell"])]
   730	    out["row_multipliers"] = [
   731	        d * s % q for d, s in zip(inst["row_multipliers"], scales)
   732	    ]
   733	    carried = [
   734	        a * _inv(s, q) % q for a, s in zip(inst["answer"], scales)
   735	    ]
   736	    out["answer"] = _normalize_full(carried, q)
   737	    return out
