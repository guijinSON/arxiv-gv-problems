+
+def _compact_vector(x, z) -> str:
+    terms = []
+    for i, a in enumerate(x):
+        if a:
+            terms.append(f"X{i}:{a}")
+    for i, a in enumerate(z):
+        if a:
+            terms.append(f"Z{i}:{a}")
+    return " ".join(terms) if terms else "0"
+
+
