   707	def _qudit_permuted(inst, rng):
   708	    out = {k: v for k, v in inst.items() if k not in ("answer", "transvections")}
   709	    perm = list(range(inst["n"]))  # old coordinate -> new coordinate
   710	    rng.shuffle(perm)
   711	    out["base_positions"] = [perm[p] for p in inst["base_positions"]]
   712	    trans = []
   713	    for t in inst["transvections"]:
   714	        vx = [0] * inst["n"]
   715	        vz = [0] * inst["n"]
   716	        for old, new in enumerate(perm):
   717	            vx[new] = t["x"][old]
   718	            vz[new] = t["z"][old]
   719	        trans.append({"alpha": t["alpha"], "x": vx, "z": vz})
   720	    out["transvections"] = trans
   721	    out["answer"] = inst["answer"][:]
   722	    return out
