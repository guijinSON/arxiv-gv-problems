+    ans = ship["answer"]
+    swap = ans[:]
+    pair = next(((i, j) for i in range(1, len(ans))
+                 for j in range(i + 1, len(ans)) if ans[i] != ans[j]), (1, 2))
+    swap[pair[0]], swap[pair[1]] = swap[pair[1]], swap[pair[0]]
+    corruptions = {
+        "drop": ans[:-1],
+        "swap": swap,
+        "duplicate": ans + [ans[-1]],
+        "empty": [],
