   752	def _hyperbolic_pairs_permuted(inst, rng):
   753	    """Reorder canonical hyperbolic pairs without changing their span."""
   754	    out = {k: v for k, v in inst.items() if k != "answer"}
   755	    pairs = inst["base_positions"][:-1]
   756	    perm = list(range(len(pairs)))
   757	    rng.shuffle(perm)
   758	    out["base_positions"] = [pairs[i] for i in perm] + [inst["base_positions"][-1]]
   759	    out["answer"] = inst["answer"][:]
   760	    return out
