   781	def _answer_token_measure(answer):
   782	    # A conservative lexical count: every integer and punctuation mark is an
   783	    # atomic token.  This overestimates common BPE tokenizers for these values.
   784	    blob = json.dumps(answer)
   785	    return len(re.findall(r"\d+|[\[\],-]", blob))
