   148	
   149	def _inv(a: int, q: int) -> int:
   150	    """Multiplicative inverse in the prime field F_q."""
   151	    return pow(a % q, q - 2, q)
   152	
   153	
   154	def _is_prime(q: int) -> bool:
   155	    if q < 2:
   156	        return False
   157	    if q % 2 == 0:
   158	        return q == 2
   159	    d = 3
   160	    while d * d <= q:
   161	        if q % d == 0:
   162	            return False
   163	        d += 2
   164	    return True
   165	
   166	
   167	def _symp_xy(ux, uz, vx, vz, q: int) -> int:
   168	    return sum((a * d - b * c) for a, b, c, d in zip(ux, uz, vx, vz)) % q
   169	
   170	
   171	def _signed_binomial_row(m: int, q: int) -> list[int]:
   172	    """Return ((-1)^k binom(m,k))_k modulo q, using O(m) work."""
   173	    out = [1]
   174	    for k in range(m):
   175	        nxt = (-out[-1] * (m - k) * _inv(k + 1, q)) % q
   176	        out.append(nxt)
   177	    return out
