+            vx[(radical_position + 1) % n] = 1
+        trans.append({"alpha": rng.randrange(1, q), "x": vx, "z": vz})
+
+    origin = rng.randrange(q)
+    step = rng.randrange(1, q)
+    progression_positions = list(range(ell))
+    rng.shuffle(progression_positions)
