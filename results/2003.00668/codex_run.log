+        alpha, vx, vz = t["alpha"], t["x"], t["z"]
+        for i in range(ell):
+            s = alpha * _symp_xy(bx[i], bz[i], vx, vz, q) % q
+            if s:
+                bx[i] = [(a + s * b) % q for a, b in zip(bx[i], vx)]
+                bz[i] = [(a + s * b) % q for a, b in zip(bz[i], vz)]
+    return bx, bz
