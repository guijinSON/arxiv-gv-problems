import gen_2003_00668 as g
assert list(g.DIFFICULTY) == ['demo','easy','medium','hard']
assert g.TRACK == 'B' and g.SHIPPING_DIFFICULTY == 'hard'
for name,p in g.DIFFICULTY.items():
    for seed in range(10):
        a=g.make_instance(seed=seed, **p)
        b=g.make_instance(seed=seed, **p)
        assert a == b
        original=a['answer'][:]
        assert g.verify(a, original) == (True,'ok')
        a['answer']=[0]*a['ell']
        assert g.verify(a, original) == (True,'ok')
        assert json.loads(json.dumps(original)) == original
        assert g.parse_answer('prose\\n"'```json'"\\n<answer>'+json.dumps(original)+'</answer>\\n"'```'"') == original
ship=g.make_instance(seed=0, **g.DIFFICULTY['hard'])
assert len(g.render(ship)) > 1000
nxt=g.escalate(g.DIFFICULTY['hard'])
assert nxt['n'] > g.DIFFICULTY['hard']['n'] and len(g.make_instance(seed=0, **nxt)['answer']) == len(ship['answer'])
rep=json.load(open('selftest_report.json'))
assert rep['all_passed'] and all(v['pass'] for k,v in rep.items() if k.startswith('G'))
assert rep['G9_no_tool_suitability']['arms_complete'] is False
assert rep['G9_no_tool_suitability']['hinted_minus_placebo'] is None
print('compile/json/interface/fuzz: ok')
print('hard_render_chars:', len(g.render(ship)))
print('search_space_bits:', g.search_space(ship).bit_length())
print('report_gates:', sum(k.startswith('G') for k in rep))
