+def _inv(a: int, q: int) -> int:
+    """Multiplicative inverse in the prime field F_q."""
+    return pow(a % q, q - 2, q)
+
+
+def _is_prime(q: int) -> bool:
+    if q < 2:
+        return False
+    if q % 2 == 0:
+        return q == 2
+    d = 3
+    while d * d <= q:
+        if q % d == 0:
+            return False
+        d += 2
+    return True
+
+
+def _symp_xy(ux, uz, vx, vz, q: int) -> int:
+    return sum((a * d - b * c) for a, b, c, d in zip(ux, uz, vx, vz)) % q
