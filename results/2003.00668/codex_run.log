+
+def enumerate_all(inst):
+    size = search_space(inst)
+    if size > 200_000:
+        return None
+    hits = 0
+    symbols = range(1, inst["q"])
+    for tail in itertools.product(symbols, repeat=inst["ell"] - 1):
+        ok, _ = verify(inst, [1, *tail])
+        hits += int(ok)
+    return hits
