   740	def _affine_evaluation_changed(inst, rng):
   741	    out = {k: v for k, v in inst.items() if k != "answer"}
   742	    q = inst["q"]
   743	    u = rng.randrange(1, q)
   744	    t = rng.randrange(q)
   745	    out["evaluation_origin"] = (u * inst["evaluation_origin"] + t) % q
   746	    out["evaluation_step"] = u * inst["evaluation_step"] % q
   747	    out["evaluation_points"] = [(u * x + t) % q for x in inst["evaluation_points"]]
   748	    out["answer"] = inst["answer"][:]
   749	    return out
