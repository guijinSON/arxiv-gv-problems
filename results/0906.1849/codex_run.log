+except ImportError:                 # pragma: no cover - fallback is intentional
+    exact_matrices = rationals = None
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "logic",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
