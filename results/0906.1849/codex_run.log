+    answer = [0] * inst["n"]
+    for var in range(inst["n"]):
+        a, b = pairs[successor[pair_of[var]]]
+        answer[var] = rhs[var] ^ rhs[a] ^ rhs[b]
+    literal_inspections = sum(len(clause) for clause in inst["clauses"])
+    return answer, 2 * inst["n"], literal_inspections
