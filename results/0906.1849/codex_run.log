+    for pair in pairs:
+        bits = sorted((rhs_by_singleton[pair[0]], rhs_by_singleton[pair[1]]))
+        if bits != [0, 1]:
+            raise ValueError("pair lacks its intrinsic 0/1 orientation")
+        for v in pair:
