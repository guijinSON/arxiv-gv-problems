+        "alphabet": [0, 1],
+        "maximum_shipping_length": 80,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 6, "decoy_pairs": 0},
+    "easy": {"n": 24, "decoy_pairs": 24},
+    "medium": {"n": 48, "decoy_pairs": 96},
+    "hard": {"n": 80, "decoy_pairs": 240},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT: str = (
+    "Hint: Four clauses sharing a variable triple encode parity rows whose coefficient operator is an involution over GF(2)."
+)
