+    for old, new in enumerate(old_to_new):
+        carried[new] = inst["answer"][old]
+    return {
+        "n": n,
+        "clauses": clauses,
+        "decoy_pairs": inst.get("decoy_pairs", 0),
+        "answer": carried,
+    }
+
+
+def _answer_atom_count(answer):
+    return len(answer) if isinstance(answer, list) else 0
