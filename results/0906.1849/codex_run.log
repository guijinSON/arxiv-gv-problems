+def canonical_key(inst) -> str:
+    """Canonicalize variable, clause, and within-clause relabellings exactly."""
+    pairs, pair_of, successor, side = _core_coordinates(inst)
+    half = len(pairs)
+    candidates = []
+    for start in range(half):
+        order = []
+        cur = start
+        seen = set()
+        while cur not in seen:
+            seen.add(cur)
+            order.append(cur)
+            cur = successor[cur]
+        if len(order) != half or cur != start:
+            raise ValueError("core successor is not one directed cycle")
