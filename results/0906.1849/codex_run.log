+        for r in range(len(packed)):
+            if r == rank:
+                continue
+            operations += 1
+            if (packed[r] >> col) & 1:
+                packed[r] ^= packed[rank]
+                operations += n + 1   # scalar GF(2) XORs represented by this word XOR
