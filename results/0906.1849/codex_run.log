+    base = shipping["answer"]
+    swap = base[:]
+    left = next(i for i, bit in enumerate(swap) if bit == 0)
+    right = next(i for i, bit in enumerate(swap) if bit == 1)
+    swap[left], swap[right] = swap[right], swap[left]
+    corruptions = {
