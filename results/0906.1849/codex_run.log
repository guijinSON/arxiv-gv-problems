import gen_0906_1849 as g, time
for name,p in g.DIFFICULTY.items():
  t=time.perf_counter(); vals=[]
  for s in range(100):
    i=g.make_instance(seed=s,**p)
    a,ops,scans=g._involution_compact_route(i)
    assert a==i['answer']
    assert g.verify(i,a)==(True,'ok')
    r,go=g._gaussian_reference(i)
    assert r==a
