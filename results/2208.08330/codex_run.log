+        proposed = [tuple(sorted((left[i], perm[i]))) for i in range(len(left))]
+        if all(edge not in edges for edge in proposed):
+            edges.update(proposed)
+            return
+    raise RuntimeError("could not draw an edge-disjoint perfect matching")
