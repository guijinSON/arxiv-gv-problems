+DIFFICULTY = {
+    "demo": {"n": 10, "matchings": 1, "extra_rounds": 0},
+    "easy": {"n": 120, "matchings": 3, "extra_rounds": 0},
+    "medium": {"n": 160, "matchings": 3, "extra_rounds": 0},
+    "hard": {"n": 200, "matchings": 3, "extra_rounds": 0},
+}
