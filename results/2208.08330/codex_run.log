import random,time

def gen(n=160,k=5,r=3,extra=0,seed=0):
 q=random.Random(seed); lab=list(range(n));q.shuffle(lab);s=n//k;groups=[lab[i*s:(i+1)*s] for i in range(k)];E=set()
 def matching(a,b):
  A=groups[a];B=groups[b]
  for tries in range(100):
   P=B[:];q.shuffle(P);pairs=[tuple(sorted((A[i],P[i]))) for i in range(s)]
   if not any(x in E for x in pairs):E.update(pairs);return
  raise Exception
 for a in range(k):
  for b in range(a+1,k):
   for _ in range(r):matching(a,b)
 for t in range(extra):
  cyc=list(range(k));q.shuffle(cyc)
  for i in range(k):matching(cyc[i],cyc[(i+1)%k])
 adj=[set() for _ in range(n)]
 for a,b in E:adj[a].add(b);adj[b].add(a)
 col=[0]*n
 for z,g in enumerate(groups):
  for v in g:col[v]=z
 return adj,col

def dsatur(adj,k,cap=250000,balanced=True):
 n=len(adj);quota=n//k;c=[-1]*n;sat=[set() for _ in range(n)];used=[0]*k;nodes=0;cut=False
 def rec(left):
  nonlocal nodes,cut
  nodes+=1
  if nodes>cap:cut=True;return None
  if left==0:return c[:]
  v=max((i for i,x in enumerate(c) if x<0),key=lambda i:(len(sat[i]),len(adj[i]),-i))
  opts=[x for x in range(k) if x not in sat[v] and used[x]<quota]
