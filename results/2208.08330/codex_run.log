+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_minus_placebo,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "operation_accounting": (
+            "one class assignment per original vertex plus five color-name choices "
+            "after recognizing the latent decomposition"
+        ),
+    }
+
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G")
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

The shipping module, all measured reports, bare hardening evidence, both G9 diagnostic transcripts, and README are complete and internally consistent.
