+    swapped = list(planted)
+    swapped[edge_u], swapped[edge_v] = swapped[edge_v], swapped[edge_u]
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_one": swapped,
+        "duplicate": planted + [planted[0]],
