+        "baseline_wall_seconds_average": round(
+            sum(x["wall_seconds"] for x in dsatur_stats) / 8, 6
+        ),
+        "baseline_wall_seconds_max": round(
+            max(x["wall_seconds"] for x in dsatur_stats), 6
