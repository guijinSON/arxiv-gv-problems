   398	    if len(answer) != n:
   399	        return False, f"expected exactly {n} exponents, got {len(answer)}"
   400	    for i, x in enumerate(answer):
   401	        if isinstance(x, bool) or not isinstance(x, int):
   402	            return False, f"entry {i} is not an integer"
   403	        if not 0 <= x < q:
   404	            return False, f"entry {i}={x} is outside the inclusive range 0..{q-1}"
   405	
   406	    matrix = inst["base_log_matrix"]
   407	    target = inst["target_logs"]
   408	    if inst.get("_fast_rank_one"):
   409	        v = [matrix[0][i] if i != 0 else matrix[1][0] for i in range(n)]
   410	        shift = _dot(v, answer, q)
   411	        got = [(answer[j] + shift) % q for j in range(n)]
   412	    else:
   413	        got = _full_product_logs(matrix, answer, q)
   414	    for j, (actual, expected) in enumerate(zip(got, target)):
   415	        if actual != expected:
   416	            return False, (
   417	                f"coordinate {j} mismatch: product log is {actual}, "
   418	                f"target log is {expected}"
   419	            )
