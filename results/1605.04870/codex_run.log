+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "decomposition",
+    "intuition_description": (
+        "Treat the bases as independent coordinates of a direct-product subgroup, "
+        "rather than collapsing them to powers of one generator; without that "
+        "decomposition the exponent vector is an exponentially large generic search."
+    ),
+    "hardness_basis": (
+        "Track A: Theorem 1 excludes the one-base collapse when the common order "
+        "is q and the exponents are pairwise distinct; in the shipping t=4, "
+        "61-bit-q regime, the paper's Section 4 exhaustive estimate is q^3, while "
