+    rng.shuffle(permutation)
+    bases = [bases[index] for index in permutation]
+    exponents = [exponents[index] for index in permutation]
+
+    # Construction-only assertions: no private factor is returned or rendered.
+    assert all(pow(base, q, modulus) == 1 and base != 1 for base in bases)
+    assert _modular_product(bases, exponents, modulus) == target
+    assert len(set(exponents)) == t
+
+    return {
+        "n": n,
+        "t": t,
+        "q": q,
+        "factor_bits": factor_bits,
+        "modulus": modulus,
+        "bases": bases,
+        "target": target,
+        "label": f"query-{rng.randrange(10**9):09d}",
+        "presentation_order": list(range(t)),
+        "answer": exponents,
+    }
+
+
+def render(inst: dict) -> str:
+    order = inst.get("presentation_order", list(range(inst["t"])))
+    base_lines = "\n".join(
+        f"  g_{index + 1} = {inst['bases'][index]}" for index in order
+    )
+    statement = f"""t-multiple discrete logarithm over a composite modulus
+
+All arithmetic below is exact integer arithmetic. Let multiplication modulo N
+be the group operation. The displayed elements g_1,...,g_t are promised to be
+units of common prime order q. They are independent: no non-identity power of
+one g_i belongs to the subgroup generated by the other bases. Consequently,
+every element of their generated subgroup has one unique exponent-coordinate
+vector with coordinates in 0..q-1.
+
+For this instance:
+  t = {inst['t']}
+  q = {inst['q']}
+  N = {inst['modulus']}
+  beta = {inst['target']}
+The bases, identified by their 1-based subscripts, are:
+{base_lines}
+
+Find the ordered exponent vector [k_1,...,k_t] satisfying
+
+  (g_1^k_1 * g_2^k_2 * ... * g_t^k_t) mod N = beta.
+
+For this promised subfamily, every k_i is in the inclusive interval 1..q-1
+and the t coordinates are pairwise distinct. Order matters, repetitions are
+forbidden, and coordinate i always belongs to g_i regardless of the order in
+which the base lines were printed.
+
+Give your final answer inside <answer></answer> tags as exactly t comma-separated
+base-10 integers, with no brackets. Example for t={inst['t']}:
+<answer>{', '.join(f'k_{i + 1}' for i in range(inst['t']))}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def _parse_payload(payload: str) -> list[int] | None:
+    payload = payload.strip()
+    if not payload:
+        return None
+    if payload.startswith("[") and payload.endswith("]"):
+        try:
+            value = json.loads(payload)
+        except (TypeError, ValueError):
+            return None
+        if isinstance(value, list) and all(
+            isinstance(item, int) and not isinstance(item, bool) for item in value
+        ):
+            return value
+        return None
+    parts = [part.strip() for part in payload.split(",")]
+    if not parts or any(not re.fullmatch(r"[+-]?\d+", part) for part in parts):
+        return None
+    try:
+        return [int(part) for part in parts]
+    except ValueError:
+        return None
+
+
+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    tagged = _ANSWER_RE.search(text)
+    if tagged:
+        return _parse_payload(tagged.group(1))
+    fenced = _FENCE_RE.search(text)
+    if fenced:
+        return _parse_payload(fenced.group(1))
+    # Tolerate a bare JSON list, but do not harvest arbitrary numbers from prose.
+    stripped = text.strip()
+    if stripped.startswith("[") and stripped.endswith("]"):
+        return _parse_payload(stripped)
+    return None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    if not isinstance(answer, list):
+        return False, "answer must be a list of integer coordinates"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) != inst["t"]:
+        return False, f"wrong coordinate count: expected {inst['t']}"
+    if any(isinstance(value, bool) or not isinstance(value, int) for value in answer):
+        return False, "every coordinate must be an integer"
+    if any(value < 1 or value >= inst["q"] for value in answer):
+        return False, "a coordinate lies outside the inclusive range 1..q-1"
+    if len(set(answer)) != len(answer):
+        return False, "coordinates are not pairwise distinct"
+    product = _modular_product(inst["bases"], answer, inst["modulus"])
+    if product != inst["target"]:
+        return False, "modular product does not equal beta"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    return rng.sample(range(1, inst["q"]), inst["t"])
+
+
+def search_space(inst: dict) -> int:
+    return math.perm(inst["q"] - 1, inst["t"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space > _ENUMERATION_CAP:
+        return None
+    count = 0
+    for candidate in itertools.permutations(range(1, inst["q"]), inst["t"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def _canonical_profile(inst: dict) -> dict:
+    """Cheap invariants under base reorder and common nonzero powering."""
+    modulus = inst["modulus"]
+    bases = inst["bases"]
+    # In q-torsion, common powering by a unit preserves exactly which CRT
+    # coordinates make two elements equal; their difference gcd records that.
+    base_one_gcds = sorted(math.gcd(base - 1, modulus) for base in bases)
+    pair_gcds = sorted(
+        math.gcd(bases[i] - bases[j], modulus)
+        for i in range(len(bases))
+        for j in range(i)
+    )
+    target_gcds = sorted(math.gcd(inst["target"] - base, modulus) for base in bases)
+    return {
+        "N": modulus,
+        "q": inst["q"],
+        "t": inst["t"],
+        "base_one_gcds": base_one_gcds,
+        "pair_gcds": pair_gcds,
+        "target_gcds": target_gcds,
+        "target_one_gcd": math.gcd(inst["target"] - 1, modulus),
+    }
+
+
+def canonical_key(inst: dict) -> str:
+    payload = json.dumps(_canonical_profile(inst), sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    current = int(params["n"])
+    t = int(params.get("t", 4))
+    next_n = current + 2
+    # Binary square-and-multiply after the structural choice needs at most
+    # t*(n+1) exact group multiplications. Respect G9's effort cap.
+    if t * (next_n + 1) > 300:
+        return "cap_bound"
+    return {"n": next_n, "t": t, "factor_bits": 2 * next_n - 2}
+
+
+def _outlier_rank_candidate(inst: dict) -> list[int]:
+    order = sorted(range(inst["t"]), key=lambda i: inst["bases"][i])
+    candidate = [0] * inst["t"]
+    for rank, index in enumerate(order, 1):
+        candidate[index] = rank * inst["q"] // (inst["t"] + 1)
+    return candidate
+
+
+def _greedy_residue_candidate(inst: dict) -> tuple[list[int], int]:
+    q = inst["q"]
+    trials = sorted({
+        1, 2, 3, 5, 8, 13, q // 5, q // 4, q // 3,
+        q // 2, 2 * q // 3, 3 * q // 4, q - 2, q - 1,
+    })
+    trials = [value for value in trials if 1 <= value < q]
+    chosen: list[int] = []
+    partial = 1
+    operations = 0
+    for base in inst["bases"]:
+        scored = []
+        for exponent in trials:
+            if exponent in chosen:
+                continue
+            residue = partial * pow(base, exponent, inst["modulus"]) % inst["modulus"]
+            distance = abs(residue - inst["target"])
+            distance = min(distance, inst["modulus"] - distance)
+            scored.append((distance, exponent, residue))
+            operations += 1
+        _, exponent, partial = min(scored)
+        chosen.append(exponent)
+    return chosen, operations
+
+
+def _random_restart_attack(
+    inst: dict, rng: random.Random, restarts: int = 256
+) -> tuple[list[int] | None, int]:
+    for attempt in range(1, restarts + 1):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate, attempt
+    return None, restarts
+
+
+def _diagonal_collapse_attack(
+    inst: dict, rng: random.Random, budget: int = 2_048
+) -> tuple[list[int] | None, int]:
+    diagonal_base = math.prod(inst["bases"]) % inst["modulus"]
+    for step in range(1, budget + 1):
+        exponent = rng.randrange(1, inst["q"])
+        if pow(diagonal_base, exponent, inst["modulus"]) == inst["target"]:
+            candidate = [exponent] * inst["t"]
+            return candidate if verify(inst, candidate)[0] else None, step
+    return None, budget
+
+
+def _mitm_attack(
+    inst: dict, rng: random.Random, budget: int = _MITM_BUDGET
+) -> tuple[list[int] | None, int]:
+    """Capped generalized baby-step/giant-step for the t=4 coordinate DLP."""
+    split = inst["t"] // 2
+    left_bases = inst["bases"][:split]
+    right_bases = inst["bases"][split:]
+    table: dict[int, tuple[int, ...]] = {}
+    operations = 0
+    for _ in range(budget):
+        values = tuple(rng.sample(range(1, inst["q"]), split))
+        residue = _modular_product(left_bases, list(values), inst["modulus"])
+        table.setdefault(residue, values)
+        operations += 1
+    for _ in range(budget):
+        values = tuple(rng.sample(range(1, inst["q"]), inst["t"] - split))
+        residue = _modular_product(right_bases, list(values), inst["modulus"])
+        need = inst["target"] * pow(residue, -1, inst["modulus"]) % inst["modulus"]
+        operations += 1
+        if need in table:
+            candidate = list(table[need] + values)
+            if len(set(candidate)) == inst["t"] and verify(inst, candidate)[0]:
+                return candidate, operations
+    return None, operations
+
+
+def _coordinate_gcd_attack(
+    inst: dict, rng: random.Random, budget: int = _GCD_BUDGET
+) -> tuple[list[int] | None, int, int]:
+    """Search for a hidden CRT-coordinate collision, the construction-aware route."""
+    factors_found = 0
+    for step in range(1, budget + 1):
+        i, j = rng.sample(range(inst["t"]), 2)
+        a = rng.randrange(1, inst["q"])
+        b = rng.randrange(1, inst["q"])
+        left = pow(inst["bases"][i], a, inst["modulus"])
+        right = pow(inst["bases"][j], b, inst["modulus"])
+        divisor = math.gcd(left - right, inst["modulus"])
+        if 1 < divisor < inst["modulus"]:
+            factors_found += 1
+            # A factor alone is not an exponent witness. Completing the attack
+            # still needs order-q discrete logarithms, which exceed this cap.
+    return None, budget, factors_found
+
+
+def _transform_instance(
+    inst: dict, permutation: list[int] | None = None, power: int | None = None
+) -> tuple[dict, list[int]]:
+    changed = {
+        key: (value[:] if isinstance(value, list) else value)
+        for key, value in inst.items()
+        if key != "answer"
+    }
+    carried = inst["answer"][:]
+    if power is not None:
+        changed["bases"] = [pow(base, power, inst["modulus"]) for base in changed["bases"]]
+        changed["target"] = pow(changed["target"], power, inst["modulus"])
+    if permutation is not None:
+        changed["bases"] = [changed["bases"][i] for i in permutation]
+        carried = [carried[i] for i in permutation]
+        changed["presentation_order"] = list(range(inst["t"]))
+    changed["answer"] = carried
+    return changed, carried
+
+
+def _answer_atoms(answer: object) -> int:
+    if isinstance(answer, dict):
+        return sum(_answer_atoms(value) for value in answer.values())
+    if isinstance(answer, list):
+        return sum(_answer_atoms(value) for value in answer)
+    return 1
+
+
+def selftest() -> dict:
+    report: dict[str, object] = {"track": TRACK}
+
+    # G1: every preset, three seeds; make_instance's private assertions audit
+    # Pocklington-backed construction while verify uses only public instance data.
+    g1_failures: list[str] = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            g1_attempts += 1
+            ok, reason = verify(inst, inst["answer"])
+            if not ok:
+                g1_failures.append(f"{preset}/{seed}: {reason}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append(f"{preset}/{seed}: answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+        "generation_route": "inverse generation with recursive Pocklington primes",
+    }
+
+    shipping = make_instance(seed=2026, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    answer = shipping["answer"]
+    swapped = answer[:]
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    duplicate = answer[:]
+    duplicate[1] = duplicate[0]
+    out_of_range = answer[:]
+    out_of_range[0] = shipping["q"]
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": swapped,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    cases = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
+        cases[name] = {"accepted": ok, "reason": reason}
+    distinct_reasons = len({case["reason"] for case in cases.values()})
+    report["G2_rejects_corruption"] = {
+        "pass": all(not case["accepted"] for case in cases.values())
+        and distinct_reasons == len(cases),
+        "distinct_reasons": distinct_reasons,
+        "cases": cases,
+    }
+
+    csv_answer = ", ".join(map(str, answer))
+    wrapped = f"I used the direct-product coordinates.\n<answer>{csv_answer}</answer>\nDone."
+    fenced = f"My final tuple is:\n```json\n{json.dumps(answer)}\n```"
+    report["G3_round_trip"] = {
+        "pass": parse_answer(wrapped) == answer
+        and parse_answer(fenced) == answer
+        and parse_answer("no usable witness here") is None,
+        "tagged_prose_matches": parse_answer(wrapped) == answer,
+        "fenced_json_matches": parse_answer(fenced) == answer,
+        "garbage_returns_none": parse_answer("no usable witness here") is None,
+    }
+
+    # G4 uses the real checker for all 200k structure-aware samples.
+    guess_total = 200_000
+    guess_hits = 0
+    guess_rng = random.Random(0x160504870)
+    guess_started = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
+    guess_wall = time.perf_counter() - guess_started
+    space = search_space(shipping)
+    exact_fraction = 1.0 / space
+    report["G4_guess_resistance"] = {
+        "pass": guess_hits / guess_total < 1e-6 and exact_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_fraction": guess_hits / guess_total,
+        "exact_fraction": exact_fraction,
+        "candidate_space": space,
+        "sampling_prior": "uniform over ordered distinct nonzero q-coordinates",
+        "wall_clock_sec": round(guess_wall, 6),
+    }
+
+    attack_seeds = list(range(800, 808))
+    attack_stats = {
+        "outlier_base_magnitude_rank": {"successes": 0, "attempts": 0, "operations": 0},
+        "greedy_nearest_residue": {"successes": 0, "attempts": 0, "operations": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0, "operations": 0},
+        "diagonal_one_base_collapse_2048": {"successes": 0, "attempts": 0, "operations": 0},
+        "generic_meet_in_middle_4096": {"successes": 0, "attempts": 0, "operations": 0},
+        "coordinate_collision_gcd_4096": {
+            "successes": 0, "attempts": 0, "operations": 0, "factors_found": 0
+        },
+    }
+    attack_wall = {name: 0.0 for name in attack_stats}
+    for seed in attack_seeds:
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        rng = random.Random(seed ^ 0x5A17C0DE)
+
+        started = time.perf_counter()
+        candidate = _outlier_rank_candidate(inst)
+        elapsed = time.perf_counter() - started
+        stat = attack_stats["outlier_base_magnitude_rank"]
+        stat["attempts"] += 1
+        stat["operations"] += inst["t"]
+        stat["successes"] += int(verify(inst, candidate)[0])
+        attack_wall["outlier_base_magnitude_rank"] += elapsed
+
+        started = time.perf_counter()
+        candidate, operations = _greedy_residue_candidate(inst)
+        elapsed = time.perf_counter() - started
+        stat = attack_stats["greedy_nearest_residue"]
+        stat["attempts"] += 1
+        stat["operations"] += operations
+        stat["successes"] += int(verify(inst, candidate)[0])
+        attack_wall["greedy_nearest_residue"] += elapsed
+
+        started = time.perf_counter()
+        candidate, operations = _random_restart_attack(inst, rng)
+        elapsed = time.perf_counter() - started
+        stat = attack_stats["random_restart_256"]
+        stat["attempts"] += 1
+        stat["operations"] += operations
+        stat["successes"] += int(candidate is not None and verify(inst, candidate)[0])
+        attack_wall["random_restart_256"] += elapsed
+
+        started = time.perf_counter()
+        candidate, operations = _diagonal_collapse_attack(inst, rng)
+        elapsed = time.perf_counter() - started
+        stat = attack_stats["diagonal_one_base_collapse_2048"]
+        stat["attempts"] += 1
+        stat["operations"] += operations
+        stat["successes"] += int(candidate is not None and verify(inst, candidate)[0])
+        attack_wall["diagonal_one_base_collapse_2048"] += elapsed
+
+        started = time.perf_counter()
+        candidate, operations = _mitm_attack(inst, rng)
+        elapsed = time.perf_counter() - started
+        stat = attack_stats["generic_meet_in_middle_4096"]
+        stat["attempts"] += 1
+        stat["operations"] += operations
+        stat["successes"] += int(candidate is not None and verify(inst, candidate)[0])
+        attack_wall["generic_meet_in_middle_4096"] += elapsed
+
+        started = time.perf_counter()
+        candidate, operations, factors = _coordinate_gcd_attack(inst, rng)
+        elapsed = time.perf_counter() - started
+        stat = attack_stats["coordinate_collision_gcd_4096"]
+        stat["attempts"] += 1
+        stat["operations"] += operations
+        stat["factors_found"] += factors
+        stat["successes"] += int(candidate is not None and verify(inst, candidate)[0])
+        attack_wall["coordinate_collision_gcd_4096"] += elapsed
+
+    for name, stat in attack_stats.items():
+        stat["wall_clock_sec"] = round(attack_wall[name], 6)
+    all_failed = all(stat["successes"] == 0 for stat in attack_stats.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and len(attack_stats) >= 4,
+        "attacks": attack_stats,
+        "standard_algorithm": (
+            "generic meet-in-the-middle, O(q^(t/2)) time/memory; complemented by "
+            "the composite-modulus coordinate-collision gcd attack, Theta(q) trials"
+        ),
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    strongest = attack_stats["generic_meet_in_middle_4096"]
+    report["G5_density_and_baseline"] = {
+        "pass": demo_count == 1 and guess_hits / guess_total < 1e-6 and all_failed,
+        "shipping_certified_solution_count": 1,
+        "shipping_exact_solution_fraction": exact_fraction,
+        "shipping_sampled_valid_hits": guess_hits,
+        "shipping_sampled_valid_total": guess_total,
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "strongest_attack_nodes": strongest["operations"],
+        "strongest_attack_wall_clock_sec": strongest["wall_clock_sec"],
+        "strongest_attack_attempts": strongest["attempts"],
+        "strongest_attack_successes": strongest["successes"],
+    }
+
+    ship_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params = dict(ship_params)
+    doubled_params["n"] *= 2
+    doubled_params["factor_bits"] = 2 * doubled_params["n"] - 2
+    scale_started = time.perf_counter()
+    doubled = make_instance(seed=99, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    preset_spaces = {
+        name: search_space(make_instance(seed=3, **params))
+        for name, params in DIFFICULTY.items()
+    }
+    ordered_spaces = list(preset_spaces.values())
+    report["G7_scales"] = {
+        "pass": doubled_ok and all(a < b for a, b in zip(ordered_spaces, ordered_spaces[1:])),
+        "preset_candidate_spaces": preset_spaces,
+        "base_n": ship_params["n"],
+        "doubled_n": doubled_params["n"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+        "doubled_build_and_verify_sec": round(time.perf_counter() - scale_started, 6),
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    nontrivial_changes = 0
+    failures: list[str] = []
+    unrelated_keys: set[str] = set()
+    for seed in range(20):
