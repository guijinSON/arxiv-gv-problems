   421	    for j, (p, h, expected_residue) in enumerate(zip(
   422	            inst["prime_factors"], inst["coordinate_roots"],
   423	            inst["target_residues"])):
   424	        exponent = sum(matrix[j][i] * answer[i] for i in range(n)) % q
   425	        residue = pow(h, exponent, p)
   426	        if residue != expected_residue:
   427	            return False, (
   428	                f"CRT residue {j} mismatch: product is {residue}, "
   429	                f"target is {expected_residue}"
   430	            )
   431	    return True, "ok"
