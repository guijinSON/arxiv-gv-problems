+def _outlier_rank_candidate(inst: dict) -> list[int]:
+    order = sorted(range(inst["t"]), key=lambda i: inst["bases"][i])
+    candidate = [0] * inst["t"]
+    for rank, index in enumerate(order, 1):
+        candidate[index] = rank * inst["q"] // (inst["t"] + 1)
+    return candidate
+
+
+def _greedy_residue_candidate(inst: dict) -> tuple[list[int], int]:
+    q = inst["q"]
+    trials = sorted({
+        1, 2, 3, 5, 8, 13, q // 5, q // 4, q // 3,
+        q // 2, 2 * q // 3, 3 * q // 4, q - 2, q - 1,
+    })
+    trials = [value for value in trials if 1 <= value < q]
+    chosen: list[int] = []
+    partial = 1
+    operations = 0
+    for base in inst["bases"]:
+        scored = []
+        for exponent in trials:
+            if exponent in chosen:
+                continue
+            residue = partial * pow(base, exponent, inst["modulus"]) % inst["modulus"]
+            distance = abs(residue - inst["target"])
+            distance = min(distance, inst["modulus"] - distance)
+            scored.append((distance, exponent, residue))
+            operations += 1
+        _, exponent, partial = min(scored)
+        chosen.append(exponent)
+    return chosen, operations
+
