+    """Generate a proven prime p of `bits` bits with q | p-1 and q > sqrt(p)."""
+    low_r = ((1 << (bits - 1)) - 1) // (2 * q) + 1
+    high_r = ((1 << bits) - 2) // (2 * q)
+    if low_r > high_r:
+        raise ValueError("factor_bits is incompatible with q")
+    for _ in range(200_000):
