+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "q": 11, "cofactor_start": 20},
+    "easy": {"n": 30, "q": 1009, "cofactor_start": 2000},
+    "medium": {"n": 52, "q": 5003, "cofactor_start": 4000},
+    "hard": {"n": 74, "q": 10007, "cofactor_start": 8000},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Subtracting the identity from the displayed base-log matrix leaves a "
