+def _canonical_records(inst: dict) -> list[list[int]]:
+    """Canonical paired row/column records under independent relabelling."""
+    matrix = inst["base_log_matrix"]
+    n = inst["n"]
+    modes = []
+    exceptional_rows = []
+    for c in range(n):
+        counts: dict[int, int] = {}
+        for r in range(n):
+            z = matrix[r][c]
+            counts[z] = counts.get(z, 0) + 1
+        mode, multiplicity = max(counts.items(), key=lambda item: item[1])
+        if multiplicity != n - 1:
+            raise ValueError("matrix is outside the promised relabelling orbit")
+        exceptions = [r for r in range(n) if matrix[r][c] != mode]
+        if len(exceptions) != 1 or matrix[exceptions[0]][c] != (mode + 1) % inst["q"]:
+            raise ValueError("matrix has no unique rank-one-plus-permutation form")
+        modes.append(mode)
+        exceptional_rows.append(exceptions[0])
+    if sorted(exceptional_rows) != list(range(n)):
+        raise ValueError("exceptional entries do not form a permutation")
+    column_for_row = [0] * n
+    for c, r in enumerate(exceptional_rows):
+        column_for_row[r] = c
+    records = []
+    for r in range(n):
+        c = column_for_row[r]
+        records.append([
+            inst["prime_factors"][r],
+            inst["coordinate_roots"][r],
+            inst["target_logs"][r],
+            inst["target_residues"][r],
+            modes[c],
+        ])
+    return sorted(records)
