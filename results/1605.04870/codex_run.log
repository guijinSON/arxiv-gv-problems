+@lru_cache(maxsize=32)
+def _coordinate_system(n: int, q: int, cofactor_start: int) -> tuple:
+    """Return n exact (p,h) pairs with h of order q modulo prime p."""
+    pairs = []
+    c = cofactor_start + (cofactor_start & 1)
+    while len(pairs) < n:
+        p = c * q + 1
+        if _is_prime(p):
+            h = 1
+            a = 2
+            while h == 1:
+                h = pow(a, c, p)
+                a += 1
+            if pow(h, q, p) == 1:
+                pairs.append((p, h))
+        c += 2
+    return tuple(pairs)
+
+
+def _dot(a: list[int], b: list[int], q: int) -> int:
+    return sum(x * y for x, y in zip(a, b)) % q
+
+
+def _random_shift_values(y: list[int], q: int, count: int = 64) -> set[int]:
+    seed = 0x160504870
+    for i, z in enumerate(y[:16]):
+        seed = (seed * 1000003 + (i + 1) * z) & ((1 << 64) - 1)
+    rng = random.Random(seed)
+    return {rng.randrange(q) for _ in range(min(count, q))}
+
+
+def _full_product_logs(matrix: list[list[int]], k: list[int], q: int) -> list[int]:
+    return [sum(a * x for a, x in zip(row, k)) % q for row in matrix]
+
+
+def _attack_diagonal_data(matrix: list[list[int]], y: list[int], q: int) -> list[int]:
+    out = []
+    for i, row in enumerate(matrix):
+        d = row[i]
+        out.append(y[i] * pow(d, -1, q) % q if d else 0)
+    return out
+
+
+def _attack_greedy_data(matrix: list[list[int]], y: list[int], q: int) -> list[int]:
+    n = len(y)
+    out = [0] * n
+    for i in range(n):
+        rhs = (y[i] - sum(matrix[i][j] * out[j] for j in range(i))) % q
+        d = matrix[i][i]
+        out[i] = rhs * pow(d, -1, q) % q if d else 0
+    return out
+
+
+def make_instance(n: int, seed: int = 0, q: int = 10007,
+                  cofactor_start: int = 8000, **params) -> dict:
+    """Inverse-generate a unique t-MDLP witness and its CRT group instance."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_params(n, q, cofactor_start)
+    rng = random.Random(seed)
+    coords = _coordinate_system(n, q, cofactor_start)
+
+    while True:
+        v = [rng.randrange(q) for _ in range(n)]
+        denominator = (1 + sum(v)) % q
+        if denominator == 0:
+            continue
+        matrix = [
+            [(v[i] + (1 if i == j else 0)) % q for i in range(n)]
+            for j in range(n)
+        ]
+        k = rng.sample(range(q), n)
+        shift = _dot(v, k, q)
+        if shift == 0:
+            continue
+        y = [(k_i + shift) % q for k_i in k]
+        if shift in _random_shift_values(y, q):
+            continue
+        if _attack_diagonal_data(matrix, y, q) == k:
+            continue
+        if _attack_greedy_data(matrix, y, q) == k:
+            continue
+        average = sum(y) * pow(n, -1, q) % q
+        if [(z - average) % q for z in y] == k:
+            continue
+        break
+
+    primes = [p for p, _ in coords]
+    roots = [h for _, h in coords]
+    target_residues = [pow(h, e, p) for p, h, e in zip(primes, roots, y)]
+    return {
+        "n": n,
+        "q": q,
+        "cofactor_start": cofactor_start,
+        "modulus_N": math.prod(primes),
+        "prime_factors": primes,
+        "coordinate_roots": roots,
+        "base_log_matrix": matrix,
+        "target_logs": y,
+        "target_residues": target_residues,
+        "answer": list(k),
+        "_fast_rank_one": True,
+    }
+
+
+def render(inst: dict) -> str:
+    n = inst["n"]
+    q = inst["q"]
+    factor_rows = "\n".join(
+        f"  {j}: p={p}, h={h}, target residue={r}"
+        for j, (p, h, r) in enumerate(zip(
+            inst["prime_factors"], inst["coordinate_roots"],
+            inst["target_residues"]))
+    )
+    matrix_rows = "\n".join(
+        f"  row {j}: " + " ".join(map(str, row))
+        for j, row in enumerate(inst["base_log_matrix"])
+    )
+    target = " ".join(map(str, inst["target_logs"]))
+    statement = f"""t-MULTIPLE DISCRETE LOGARITHM IN EXACT CRT COORDINATES
+
+All indices are 0-based. Let q={q}, a prime, and let
+N={inst['modulus_N']} be the product of the n={n} distinct primes printed
+below. For coordinate j, h_j is a unit of exact order q modulo p_j.
+
+An exponent-coordinate vector e=(e_0,...,e_{{n-1}}) over F_q represents the
+unique unit x modulo N satisfying x = h_j^e_j (mod p_j) for every j. Thus
+multiplication of represented group elements adds their coordinate vectors
+modulo q. This is an exact CRT representation, not floating-point data.
+
+The n modular bases g_0,...,g_{{n-1}} are given by the COLUMNS of the matrix A
+below: A[j][i] is the exponent of h_j in the jth CRT residue of g_i. The
+target beta has the displayed log-coordinate vector y and the independently
+displayed residues. The bases are promised to be independent elements of
+order q, so exactly one bounded exponent tuple exists.
+
+CRT components:
+{factor_rows}
+
+Base-log matrix A over F_q (n rows, n entries per row):
+{matrix_rows}
+
+Target log-coordinate vector y:
+  {target}
+
+Find the unique ordered list [k_0,...,k_{{n-1}}] with every k_i an integer in
+the inclusive range 0 through q-1 such that
+
+    g_0^k_0 * g_1^k_1 * ... * g_{{n-1}}^k_{{n-1}} = beta (mod N).
+
+Equivalently, your list must satisfy A k = y over F_q. Order matters; repeats
+are allowed. Give your final answer inside <answer></answer> tags as one JSON
+list of exactly {n} base-10 integers. Example syntax for a three-entry answer:
+<answer>[3, 1, 4]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
+                        flags=re.IGNORECASE | re.DOTALL)
+    candidates = list(reversed(blocks))
+    if not candidates:
+        fenced = re.findall(r"```(?:json)?\s*(\[[\s\S]*?\])\s*```", text,
+                            flags=re.IGNORECASE)
+        candidates.extend(reversed(fenced))
+    for raw in candidates:
+        try:
+            value = json.loads(raw.strip())
+        except (TypeError, ValueError):
+            continue
+        if (isinstance(value, list)
+                and all(isinstance(x, int) and not isinstance(x, bool)
+                        for x in value)):
+            return value
+    return None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    n = inst["n"]
+    q = inst["q"]
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer list is empty"
+    if len(answer) != n:
+        return False, f"expected exactly {n} exponents, got {len(answer)}"
+    for i, x in enumerate(answer):
+        if isinstance(x, bool) or not isinstance(x, int):
+            return False, f"entry {i} is not an integer"
+        if not 0 <= x < q:
+            return False, f"entry {i}={x} is outside the inclusive range 0..{q-1}"
+
+    matrix = inst["base_log_matrix"]
+    target = inst["target_logs"]
+    if inst.get("_fast_rank_one"):
+        v = [matrix[0][i] if i != 0 else matrix[1][0] for i in range(n)]
+        shift = _dot(v, answer, q)
+        got = [(answer[j] + shift) % q for j in range(n)]
+    else:
+        got = _full_product_logs(matrix, answer, q)
+    for j, (actual, expected) in enumerate(zip(got, target)):
+        if actual != expected:
+            return False, (
+                f"coordinate {j} mismatch: product log is {actual}, "
+                f"target log is {expected}"
+            )
+
+    for j, (p, h, expected_residue) in enumerate(zip(
+            inst["prime_factors"], inst["coordinate_roots"],
+            inst["target_residues"])):
+        exponent = sum(matrix[j][i] * answer[i] for i in range(n)) % q
+        residue = pow(h, exponent, p)
+        if residue != expected_residue:
+            return False, (
+                f"CRT residue {j} mismatch: product is {residue}, "
+                f"target is {expected_residue}"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    return [rng.randrange(inst["q"]) for _ in range(inst["n"])]
+
+
+def search_space(inst: dict) -> int | None:
+    return inst["q"] ** inst["n"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space is None or space > 100_000:
+        return None
+    count = 0
+    for candidate in itertools.product(range(inst["q"]), repeat=inst["n"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def _canonical_records(inst: dict) -> list[list[int]]:
+    """Canonical paired row/column records under independent relabelling."""
+    matrix = inst["base_log_matrix"]
+    n = inst["n"]
+    modes = []
+    exceptional_rows = []
+    for c in range(n):
+        counts: dict[int, int] = {}
+        for r in range(n):
+            z = matrix[r][c]
+            counts[z] = counts.get(z, 0) + 1
+        mode, multiplicity = max(counts.items(), key=lambda item: item[1])
+        if multiplicity != n - 1:
+            raise ValueError("matrix is outside the promised relabelling orbit")
+        exceptions = [r for r in range(n) if matrix[r][c] != mode]
+        if len(exceptions) != 1 or matrix[exceptions[0]][c] != (mode + 1) % inst["q"]:
+            raise ValueError("matrix has no unique rank-one-plus-permutation form")
+        modes.append(mode)
+        exceptional_rows.append(exceptions[0])
+    if sorted(exceptional_rows) != list(range(n)):
+        raise ValueError("exceptional entries do not form a permutation")
+    column_for_row = [0] * n
+    for c, r in enumerate(exceptional_rows):
+        column_for_row[r] = c
+    records = []
+    for r in range(n):
+        c = column_for_row[r]
+        records.append([
+            inst["prime_factors"][r],
+            inst["coordinate_roots"][r],
+            inst["target_logs"][r],
+            inst["target_residues"][r],
+            modes[c],
+        ])
+    return sorted(records)
+
+
+def canonical_key(inst: dict) -> str:
+    payload = {
+        "q": inst["q"],
+        "N": inst["modulus_N"],
+        "records": _canonical_records(inst),
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _relabel_instance(inst: dict, row_order: list[int],
+                      column_order: list[int]) -> tuple[dict, list[int]]:
+    n = inst["n"]
+    if sorted(row_order) != list(range(n)) or sorted(column_order) != list(range(n)):
+        raise ValueError("orders must be permutations")
+    moved = {
+        "n": n,
+        "q": inst["q"],
+        "cofactor_start": inst["cofactor_start"],
+        "modulus_N": inst["modulus_N"],
+        "prime_factors": [inst["prime_factors"][r] for r in row_order],
+        "coordinate_roots": [inst["coordinate_roots"][r] for r in row_order],
+        "base_log_matrix": [
+            [inst["base_log_matrix"][r][c] for c in column_order]
+            for r in row_order
+        ],
+        "target_logs": [inst["target_logs"][r] for r in row_order],
+        "target_residues": [inst["target_residues"][r] for r in row_order],
+        "answer": [inst["answer"][c] for c in column_order],
+        "_fast_rank_one": False,
+    }
+    return moved, list(moved["answer"])
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Increase field/modulus size while keeping the exponent tuple length fixed."""
+    n = int(params["n"])
+    q = int(params["q"])
+    cofactor_start = int(params.get("cofactor_start", 8000))
+    new_q = _next_prime(4 * q + 1)
+    new_cofactor = 2 * cofactor_start
+    worst_chars = 2 + n * (len(str(new_q - 1)) + 2)
+    if worst_chars > 1900 or new_q * (4 * new_cofactor + 100000) >= 2**64:
+        return "cap_bound"
+    harder = dict(params)
+    harder["q"] = new_q
+    harder["cofactor_start"] = new_cofactor
+    return harder
+
+
+def _reference_gauss(inst: dict) -> dict:
+    q = inst["q"]
+    n = inst["n"]
+    aug = [list(row) + [rhs] for row, rhs in zip(
+        inst["base_log_matrix"], inst["target_logs"])]
+    operations = 0
+    t0 = time.perf_counter()
+    for col in range(n):
+        pivot = next((r for r in range(col, n) if aug[r][col] % q), None)
+        if pivot is None:
+            return {"ok": False, "answer": None,
+                    "operations": operations,
+                    "wall_clock_sec": time.perf_counter() - t0}
+        if pivot != col:
+            aug[col], aug[pivot] = aug[pivot], aug[col]
+        inv = pow(aug[col][col], -1, q)
+        operations += 1
+        for j in range(col, n + 1):
+            aug[col][j] = aug[col][j] * inv % q
+            operations += 1
+        for r in range(n):
+            if r == col or aug[r][col] % q == 0:
+                continue
+            factor = aug[r][col]
+            for j in range(col, n + 1):
+                aug[r][j] = (aug[r][j] - factor * aug[col][j]) % q
+                operations += 2
+    answer = [aug[i][n] % q for i in range(n)]
+    elapsed = time.perf_counter() - t0
+    return {
+        "ok": verify(inst, answer)[0],
+        "answer": answer,
+        "operations": operations,
+        "wall_clock_sec": elapsed,
+    }
+
+
+def _attack_target(inst: dict) -> list[int]:
+    return list(inst["target_logs"])
+
+
+def _attack_column_outlier(inst: dict) -> list[int]:
+    """Use each column's repeated-value statistic as a direct correction."""
+    matrix = inst["base_log_matrix"]
+    q = inst["q"]
+    n = inst["n"]
+    modes = []
+    for c in range(n):
+        counts: dict[int, int] = {}
+        for r in range(n):
+            z = matrix[r][c]
+            counts[z] = counts.get(z, 0) + 1
+        modes.append(max(counts.items(), key=lambda item: item[1])[0])
+    return [(inst["target_logs"][i] - modes[i]) % q for i in range(n)]
+
+
+def _attack_diagonal(inst: dict) -> list[int]:
+    return _attack_diagonal_data(
+        inst["base_log_matrix"], inst["target_logs"], inst["q"])
+
+
+def _attack_greedy(inst: dict) -> list[int]:
+    return _attack_greedy_data(
+        inst["base_log_matrix"], inst["target_logs"], inst["q"])
+
+
+def _attack_average(inst: dict) -> list[int]:
+    q = inst["q"]
+    c = sum(inst["target_logs"]) * pow(inst["n"], -1, q) % q
+    return [(z - c) % q for z in inst["target_logs"]]
+
+
+def _attack_random_scalar(inst: dict) -> tuple[bool, int]:
+    tries = _random_shift_values(inst["target_logs"], inst["q"])
+    for c in tries:
+        candidate = [(z - c) % inst["q"] for z in inst["target_logs"]]
+        if verify(inst, candidate)[0]:
+            return True, len(tries) * inst["n"]
+    return False, len(tries) * inst["n"]
+
+
+def _answer_metrics(answer: object) -> tuple[int, int, int]:
+    wire = json.dumps(answer)
+    return (len(wire), math.ceil(len(wire) / 4),
+            len(answer) if isinstance(answer, list) else 0)
+
+
+def selftest() -> dict:
+    report: dict = {}
+
+    failures = []
+    attempts = 0
+    for name, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            attempts += 1
+            if not ok:
+                failures.append({"preset": name, "seed": seed, "reason": why})
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append({"preset": name, "seed": seed,
+                                 "reason": "answer is not JSON-native"})
+    report["G1_planted_verifies"] = {
+        "pass": not failures, "attempts": attempts, "failures": failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=20260905, **ship_params)
+    original = inst["answer"]
+    corruptions = {}
+    corruptions["empty"] = verify(inst, [])
+    corruptions["drop_one"] = verify(inst, original[:-1])
+    bad = list(original)
+    bad[0], bad[1] = bad[1], bad[0]
+    corruptions["swap_two"] = verify(inst, bad)
+    bad = list(original)
+    bad[1] = bad[0]
+    corruptions["duplicate_entry"] = verify(inst, bad)
+    bad = list(original)
+    bad[0] = inst["q"]
+    corruptions["out_of_range"] = verify(inst, bad)
+    reasons = [why for ok, why in corruptions.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(not ok for ok, _ in corruptions.values())
+                and len(set(reasons)) == len(reasons),
+        "cases": {name: {"rejected": not result[0], "reason": result[1]}
+                  for name, result in corruptions.items()},
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    wire = json.dumps(original, separators=(",", ":"))
+    parsed = parse_answer(
+        "The rank-one calculation gives the following.\n```json\n<answer>"
+        + wire + "</answer>\n```\nI checked it in every CRT coordinate."
+    )
+    report["G3_round_trip"] = {
+        "pass": parsed == original,
+        "surrounding_prose_and_fence": True,
+        "json_round_trip": parsed == original,
+    }
+
+    guess_rng = random.Random(0x160504870)
+    guess_total = 200_000
+    hits = 0
+    t_guess = time.perf_counter()
+    for _ in range(guess_total):
+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            hits += 1
+    guess_elapsed = time.perf_counter() - t_guess
+    report["G4_guess_resistance"] = {
+        "pass": hits / guess_total < 1e-6,
+        "hits": hits,
+        "total": guess_total,
+        "empirical_probability": hits / guess_total,
+        "exact_probability": f"1/{search_space(inst)}",
+        "prior": "uniform over all n-tuples in F_q^n, exactly the stated language",
+        "candidate_space_bits": search_space(inst).bit_length(),
+        "sampling_wall_seconds": guess_elapsed,
+    }
+
+    baseline = _reference_gauss(inst)
+    attack_clock = time.perf_counter()
+    _baseline_attack_won, baseline_attack_operations = _attack_random_scalar(inst)
+    baseline_attack_wall = time.perf_counter() - attack_clock
+    demo_count = enumerate_all(make_instance(seed=0, **DIFFICULTY["demo"]))
+    report["G5_density_and_baseline"] = {
+        "pass": baseline["ok"] and hits == 0 and demo_count == 1,
+        "shipping_observed_valid_fraction": hits / guess_total,
+        "shipping_density_sample_count": guess_total,
+        "shipping_valid_hits": hits,
+        "reference_wall_seconds": baseline["wall_clock_sec"],
+        "reference_operation_count": baseline["operations"],
+        "reference_success_count": int(baseline["ok"]),
+        "strongest_failing_attack_budget": baseline_attack_operations,
+        "strongest_failing_attack_wall_seconds": baseline_attack_wall,
+        "demo_exact_solution_count": demo_count,
+        "shipping_candidate_space_bits": search_space(inst).bit_length(),
+        "enumerate_all_shipping": None,
+    }
+
+    attack_counts = {
+        "outlier_repeated_column_value": 0,
+        "target_as_exponents": 0,
+        "greedy_diagonal_only": 0,
+        "greedy_forward_substitution": 0,
+        "random_restart_64_scalar_shifts": 0,
+        "in_context_average_shift_ansatz": 0,
+    }
+    references = []
+    random_restart_operations = 0
+    random_restart_wall = 0.0
+    for seed in range(100, 108):
+        trial = make_instance(seed=seed, **ship_params)
+        if verify(trial, _attack_column_outlier(trial))[0]:
+            attack_counts["outlier_repeated_column_value"] += 1
+        if verify(trial, _attack_target(trial))[0]:
+            attack_counts["target_as_exponents"] += 1
+        if verify(trial, _attack_diagonal(trial))[0]:
+            attack_counts["greedy_diagonal_only"] += 1
+        if verify(trial, _attack_greedy(trial))[0]:
+            attack_counts["greedy_forward_substitution"] += 1
+        attack_clock = time.perf_counter()
+        won, operations = _attack_random_scalar(trial)
+        random_restart_wall += time.perf_counter() - attack_clock
+        random_restart_operations += operations
+        if won:
+            attack_counts["random_restart_64_scalar_shifts"] += 1
+        if verify(trial, _attack_average(trial))[0]:
+            attack_counts["in_context_average_shift_ansatz"] += 1
+        references.append(_reference_gauss(trial))
+    ref_successes = sum(int(run["ok"]) for run in references)
+    all_failed = all(count == 0 for count in attack_counts.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and ref_successes == 8,
+        "attacks": {
+            name: {"successes": count, "attempts": 8}
+            for name, count in attack_counts.items()
+        },
+        "strongest_failing_attack_operations": random_restart_operations,
+        "strongest_failing_attack_wall_seconds": random_restart_wall,
+        "reference_algorithm": {
+            "name": "dense Gauss-Jordan elimination over F_q",
+            "complexity": "O(n^3) exact field operations",
+            "wall_clock_sec": sum(run["wall_clock_sec"] for run in references),
+            "mean_wall_clock_sec": (
+                sum(run["wall_clock_sec"] for run in references) / 8
+            ),
+            "operations": sum(run["operations"] for run in references),
+            "mean_operations": sum(run["operations"] for run in references) // 8,
+            "solves": f"{ref_successes}/8, as expected",
+        },
+    }
+
+    doubled = make_instance(
+        n=2 * ship_params["n"], q=ship_params["q"],
+        cofactor_start=ship_params["cofactor_start"], seed=77)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok,
+        "base_n": ship_params["n"],
+        "doubled_n": doubled["n"],
+        "doubled_verify": doubled_why,
+        "dense_elimination_cost_ratio": 8,
+    }
+
+    invariance_checks = 0
+    witness_checks = 0
+    for seed in range(20):
+        small = make_instance(n=12, q=101, cofactor_start=200, seed=seed)
+        rng = random.Random(seed ^ 0xC4108)
+        rows = list(range(12)); rng.shuffle(rows)
+        cols = list(range(12)); rng.shuffle(cols)
+        rows2 = list(range(12)); rng.shuffle(rows2)
+        cols2 = list(range(12)); rng.shuffle(cols2)
+        transforms = [
+            (rows, list(range(12))),
+            (list(range(12)), cols),
+            (rows, cols),
+            ([rows[rows2[i]] for i in range(12)],
+             [cols[cols2[i]] for i in range(12)]),
+        ]
+        for row_order, col_order in transforms:
+            moved, carried = _relabel_instance(small, row_order, col_order)
+            invariance_checks += int(canonical_key(moved) == canonical_key(small))
+            witness_checks += int(verify(moved, carried)[0])
+    unrelated = {
+        canonical_key(make_instance(n=12, q=101, cofactor_start=200, seed=seed))
+        for seed in range(1000, 1020)
+    }
+    report["G8_canonical_key"] = {
+        "pass": invariance_checks == 80 and witness_checks == 80
+                and len(unrelated) == 20,
+        "invariance_checks": invariance_checks,
+        "transformed_witness_checks": witness_checks,
+        "unrelated_distinct": len(unrelated),
+        "unrelated_attempts": 20,
+        "transformations": (
+            "arbitrary CRT-coordinate relabelling, arbitrary generator "
+            "reordering, and two independent compositions"
+        ),
+    }
+
+    sizes = [
+        _answer_metrics(make_instance(seed=seed, **ship_params)["answer"])
+        for seed in range(256)
+    ]
+    chars, tokens, elements = max(sizes, key=lambda item: item[0])
+    intended_ops = 4 * inst["n"]
+    evidence = G9_EVIDENCE
+    hinted_pass = evidence["hinted_verdict"] == "hardened"
+    within_caps = chars <= 2000 and elements <= 256 and intended_ops <= 300
+    hinted_attempts = evidence["hinted"]["attempts"]
+    placebo_attempts = evidence["placebo"]["attempts"]
+    hinted_rate = (evidence["hinted"]["solved"] / hinted_attempts
+                   if hinted_attempts else 0.0)
+    placebo_rate = (evidence["placebo"]["solved"] / placebo_attempts
+                    if placebo_attempts else 0.0)
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_pass and within_caps,
+        "arms": {
+            "bare": dict(evidence["bare"]),
+            "hinted": dict(evidence["hinted"]),
+            "placebo": dict(evidence["placebo"]),
+        },
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": evidence["hinted_verdict"],
+        "answer_chars": chars,
+        "answer_tokens": tokens,
+        "answer_elements": elements,
+        "answer_size_sample_count": len(sizes),
+        "intended_route_operations": intended_ops,
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(ship_params)
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=False))

