+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 3, "t": 2, "factor_bits": 6},
+    "easy": {"n": 61, "t": 4, "factor_bits": 120},
+    "medium": {"n": 67, "t": 4, "factor_bits": 132},
+    "hard": {"n": 71, "t": 4, "factor_bits": 140},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+# Scratch hardening arms set this so their copied module has one non-demo rung.
+if os.environ.get("GV_ONLY_SHIPPING") == "1":
+    DIFFICULTY = {"easy": dict(DIFFICULTY[SHIPPING_DIFFICULTY])}
+
+STRUCTURAL_HINT = (
+    "Hint: The common order q makes the bases independent coordinates of a "
+    "direct-product subgroup, not powers of one shared generator."
+)
+PLACEBO_HINT = (
+    "Hint: Careful handling of the stated bounds and coordinate order helps avoid "
