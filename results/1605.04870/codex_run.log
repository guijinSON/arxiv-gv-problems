+        stat["attempts"] += 1
+        stat["operations"] += operations
+        stat["successes"] += int(candidate is not None and verify(inst, candidate)[0])
+        attack_wall["generic_meet_in_middle_4096"] += elapsed
+
+        started = time.perf_counter()
+        candidate, operations, factors = _coordinate_gcd_attack(inst, rng)
+        elapsed = time.perf_counter() - started
+        stat = attack_stats["coordinate_collision_gcd_4096"]
+        stat["attempts"] += 1
+        stat["operations"] += operations
+        stat["factors_found"] += factors
+        stat["successes"] += int(candidate is not None and verify(inst, candidate)[0])
+        attack_wall["coordinate_collision_gcd_4096"] += elapsed
+
+    for name, stat in attack_stats.items():
+        stat["wall_clock_sec"] = round(attack_wall[name], 6)
+    all_failed = all(stat["successes"] == 0 for stat in attack_stats.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and len(attack_stats) >= 4,
+        "attacks": attack_stats,
+        "standard_algorithm": (
+            "generic meet-in-the-middle, O(q^(t/2)) time/memory; complemented by "
+            "the composite-modulus coordinate-collision gcd attack, Theta(q) trials"
+        ),
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    strongest = attack_stats["generic_meet_in_middle_4096"]
+    report["G5_density_and_baseline"] = {
+        "pass": demo_count == 1 and guess_hits / guess_total < 1e-6 and all_failed,
+        "shipping_certified_solution_count": 1,
+        "shipping_exact_solution_fraction": exact_fraction,
+        "shipping_sampled_valid_hits": guess_hits,
+        "shipping_sampled_valid_total": guess_total,
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "strongest_attack_nodes": strongest["operations"],
+        "strongest_attack_wall_clock_sec": strongest["wall_clock_sec"],
+        "strongest_attack_attempts": strongest["attempts"],
+        "strongest_attack_successes": strongest["successes"],
+    }
+
+    ship_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params = dict(ship_params)
+    doubled_params["n"] *= 2
+    doubled_params["factor_bits"] = 2 * doubled_params["n"] - 2
