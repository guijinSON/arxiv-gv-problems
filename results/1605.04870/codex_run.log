+    if isinstance(n, bool) or not isinstance(n, int) or n < 2:
+        raise ValueError("n must be an integer at least 2")
+    if isinstance(q, bool) or not isinstance(q, int) or q <= n or not _is_prime(q):
+        raise ValueError("q must be a prime integer greater than n")
+    if (isinstance(cofactor_start, bool) or not isinstance(cofactor_start, int)
+            or cofactor_start < 2):
+        raise ValueError("cofactor_start must be an integer at least 2")
+    if q * (4 * cofactor_start + 100000) >= 2**64:
+        raise ValueError("parameters exceed the deterministic primality range")
+
