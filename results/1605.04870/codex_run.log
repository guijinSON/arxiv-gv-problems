+            "complexity": "O(n^3) exact field operations",
+            "wall_clock_sec": sum(run["wall_clock_sec"] for run in references),
+            "mean_wall_clock_sec": (
+                sum(run["wall_clock_sec"] for run in references) / 8
+            ),
+            "operations": sum(run["operations"] for run in references),
+            "mean_operations": sum(run["operations"] for run in references) // 8,
+            "solves": f"{ref_successes}/8, as expected",
+        },
+    }
+
+    doubled = make_instance(
+        n=2 * ship_params["n"], q=ship_params["q"],
+        cofactor_start=ship_params["cofactor_start"], seed=77)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok,
+        "base_n": ship_params["n"],
+        "doubled_n": doubled["n"],
+        "doubled_verify": doubled_why,
+        "dense_elimination_cost_ratio": 8,
+    }
+
+    invariance_checks = 0
+    witness_checks = 0
+    for seed in range(20):
+        small = make_instance(n=12, q=101, cofactor_start=200, seed=seed)
+        rng = random.Random(seed ^ 0xC4108)
+        rows = list(range(12)); rng.shuffle(rows)
+        cols = list(range(12)); rng.shuffle(cols)
+        rows2 = list(range(12)); rng.shuffle(rows2)
+        cols2 = list(range(12)); rng.shuffle(cols2)
+        transforms = [
+            (rows, list(range(12))),
+            (list(range(12)), cols),
+            (rows, cols),
+            ([rows[rows2[i]] for i in range(12)],
+             [cols[cols2[i]] for i in range(12)]),
