+@lru_cache(maxsize=32)
+def _coordinate_system(n: int, q: int, cofactor_start: int) -> tuple:
+    """Return n exact (p,h) pairs with h of order q modulo prime p."""
+    pairs = []
+    c = cofactor_start + (cofactor_start & 1)
+    while len(pairs) < n:
+        p = c * q + 1
+        if _is_prime(p):
+            h = 1
+            a = 2
+            while h == 1:
+                h = pow(a, c, p)
+                a += 1
+            if pow(h, q, p) == 1:
+                pairs.append((p, h))
+        c += 2
+    return tuple(pairs)
 
 
