+    )
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = max(_answer_atoms(value) for value in size_answers)
+    intended_operations = shipping["t"] * (shipping["n"] + 1)
+    hinted = G9_ORACLE_RESULTS["hinted"]
+    placebo = G9_ORACLE_RESULTS["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else None
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else None
+    within_caps = (
+        answer_chars <= 2_000
+        and answer_tokens <= 500
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": G9_HINTED_VERDICT == "hardened" and within_caps,
+        "arms": {name: dict(value) for name, value in G9_ORACLE_RESULTS.items()},
+        "hinted_minus_placebo": (
+            hinted_rate - placebo_rate
+            if hinted_rate is not None and placebo_rate is not None
+            else None
+        ),
+        "hinted_verdict": G9_HINTED_VERDICT,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "operation_definition": (
+            "upper bound of t*(n+1) exact group multiplications to check a proposed "
+            "coordinate witness by binary modular exponentiation"
+        ),
+        "within_caps": within_caps,
+        "oracle_results_pending": G9_HINTED_VERDICT != "hardened",
+    }
+
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    report["all_passed"] = all(
+        isinstance(value, dict) and value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G") and key[1:2].isdigit()
+    )
+    return report
