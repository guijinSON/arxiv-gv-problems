@lru_cache(maxsize=32)
def _coordinate_system(n: int, q: int, cofactor_start: int) -> tuple:
    """Return n exact (p,h) pairs with h of order q modulo prime p."""
    pairs = []
    c = cofactor_start + (cofactor_start & 1)
    while len(pairs) < n:
        p = c * q + 1
        if _is_prime(p):
            h = 1
            a = 2
            while h == 1:
                h = pow(a, c, p)
                a += 1
            if pow(h, q, p) == 1:
                pairs.append((p, h))
        c += 2
    return tuple(pairs)


def _dot(a: list[int], b: list[int], q: int) -> int:
    return sum(x * y for x, y in zip(a, b)) % q


def _random_shift_values(y: list[int], q: int, count: int = 64) -> set[int]:
    seed = 0x160504870
    for i, z in enumerate(y[:16]):
        seed = (seed * 1000003 + (i + 1) * z) & ((1 << 64) - 1)
    rng = random.Random(seed)
    return {rng.randrange(q) for _ in range(min(count, q))}


def _full_product_logs(matrix: list[list[int]], k: list[int], q: int) -> list[int]:
    return [sum(a * x for a, x in zip(row, k)) % q for row in matrix]


def _avoids_easy_projections(matrix: list[list[int]], k: list[int], q: int) -> bool:
    """Enforce the non-projection regime discussed in Section 4, Theorem 2.

    In CRT row j, beta equals g_i**k_i exactly when the contribution of all
    other bases is zero.  Excluding that equality for every (j,i) prevents a
    coordinate from directly exposing one exponent and a smaller MDLP.
    """
    y = _full_product_logs(matrix, k, q)
    return all(
        (y[j] - matrix[j][i] * k[i]) % q != 0
        for j in range(len(matrix))
        for i in range(len(k))
    )


def _attack_diagonal_data(matrix: list[list[int]], y: list[int], q: int) -> list[int]:
    out = []
    for i, row in enumerate(matrix):
        d = row[i]
        out.append(y[i] * pow(d, -1, q) % q if d else 0)
    return out


def _attack_greedy_data(matrix: list[list[int]], y: list[int], q: int) -> list[int]:
    n = len(y)
    out = [0] * n
    for i in range(n):
        rhs = (y[i] - sum(matrix[i][j] * out[j] for j in range(i))) % q
        d = matrix[i][i]
        out[i] = rhs * pow(d, -1, q) % q if d else 0
    return out


def make_instance(n: int, seed: int = 0, q: int = 10007,
                  cofactor_start: int = 8000, **params) -> dict:
    """Inverse-generate a unique t-MDLP witness and its CRT group instance."""
    if params:
        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
    _validate_params(n, q, cofactor_start)
    rng = random.Random(seed)
    coords = _coordinate_system(n, q, cofactor_start)

    while True:
        v = [rng.randrange(q) for _ in range(n)]
        denominator = (1 + sum(v)) % q
        if denominator == 0:
            continue
        matrix = [
            [(v[i] + (1 if i == j else 0)) % q for i in range(n)]
            for j in range(n)
        ]
        k = rng.sample(range(q), n)
        if not _avoids_easy_projections(matrix, k, q):
            continue
        shift = _dot(v, k, q)
        if shift == 0:
            continue
        y = [(k_i + shift) % q for k_i in k]
        if shift in _random_shift_values(y, q):
            continue
        if _attack_diagonal_data(matrix, y, q) == k:
            continue
        if _attack_greedy_data(matrix, y, q) == k:
            continue
        average = sum(y) * pow(n, -1, q) % q
        if [(z - average) % q for z in y] == k:
            continue
        break

    primes = [p for p, _ in coords]
    roots = [h for _, h in coords]
    target_residues = [pow(h, e, p) for p, h, e in zip(primes, roots, y)]
    return {
        "n": n,
        "q": q,
        "cofactor_start": cofactor_start,
        "modulus_N": math.prod(primes),
        "prime_factors": primes,
        "coordinate_roots": roots,
        "base_log_matrix": matrix,
        "target_logs": y,
        "target_residues": target_residues,
        "answer": list(k),
        "_fast_rank_one": True,
    }


def render(inst: dict) -> str:
    n = inst["n"]
    q = inst["q"]
    factor_rows = "\n".join(
        f"  {j}: p={p}, h={h}, target residue={r}"
        for j, (p, h, r) in enumerate(zip(
            inst["prime_factors"], inst["coordinate_roots"],
            inst["target_residues"]))
    )
    matrix_rows = "\n".join(
        f"  row {j}: " + " ".join(map(str, row))
        for j, row in enumerate(inst["base_log_matrix"])
    )
    target = " ".join(map(str, inst["target_logs"]))
    statement = f"""t-MULTIPLE DISCRETE LOGARITHM IN EXACT CRT COORDINATES

All indices are 0-based. Let q={q}, a prime, and let
N={inst['modulus_N']} be the product of the n={n} distinct primes printed
below. For coordinate j, h_j is a unit of exact order q modulo p_j.

An exponent-coordinate vector e=(e_0,...,e_{{n-1}}) over F_q represents the
unique unit x modulo N satisfying x = h_j^e_j (mod p_j) for every j. Thus
multiplication of represented group elements adds their coordinate vectors
modulo q. This is an exact CRT representation, not floating-point data.

The n modular bases g_0,...,g_{{n-1}} are given by the COLUMNS of the matrix A
below: A[j][i] is the exponent of h_j in the jth CRT residue of g_i. The
target beta has the displayed log-coordinate vector y and the independently
displayed residues. The bases are promised to be independent elements of
order q, so exactly one bounded exponent tuple exists.

CRT components:
{factor_rows}

Base-log matrix A over F_q (n rows, n entries per row):
{matrix_rows}

Target log-coordinate vector y:
  {target}

Find the unique ordered list [k_0,...,k_{{n-1}}] with every k_i an integer in
the inclusive range 0 through q-1 such that

    g_0^k_0 * g_1^k_1 * ... * g_{{n-1}}^k_{{n-1}} = beta (mod N).

Equivalently, your list must satisfy A k = y over F_q. Order matters; repeats
are allowed. Give your final answer inside <answer></answer> tags as one JSON
list of exactly {n} base-10 integers. Example syntax for a three-entry answer:
<answer>[3, 1, 4]</answer>
Output nothing else inside the tags."""
    mode = os.environ.get("GV_HINT_MODE")
    if mode == "structural":
        statement += "\n\nHint: " + STRUCTURAL_HINT
    elif mode == "placebo":
        statement += "\n\nHint: " + PLACEBO_HINT
    return statement


def parse_answer(text: str) -> object | None:
def parse_answer(text: str) -> object | None:
    if not isinstance(text, str):
        return None
    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
                        flags=re.IGNORECASE | re.DOTALL)
    candidates = list(reversed(blocks))
    if not candidates:
        fenced = re.findall(r"```(?:json)?\s*(\[[\s\S]*?\])\s*```", text,
                            flags=re.IGNORECASE)
        candidates.extend(reversed(fenced))
    for raw in candidates:
        try:
            value = json.loads(raw.strip())
        except (TypeError, ValueError):
            continue
        if (isinstance(value, list)
                and all(isinstance(x, int) and not isinstance(x, bool)
                        for x in value)):
            return value
    return None


def verify(inst: dict, answer: object) -> tuple[bool, str]:
    n = inst["n"]
    q = inst["q"]
    if not isinstance(answer, list):
        return False, "answer must be a JSON list"
    if not answer:
        return False, "answer list is empty"
    if len(answer) != n:
        return False, f"expected exactly {n} exponents, got {len(answer)}"
    for i, x in enumerate(answer):
        if isinstance(x, bool) or not isinstance(x, int):
            return False, f"entry {i} is not an integer"
        if not 0 <= x < q:
            return False, f"entry {i}={x} is outside the inclusive range 0..{q-1}"

    matrix = inst["base_log_matrix"]
    target = inst["target_logs"]
    for j, (row, expected) in enumerate(zip(matrix, target)):
        actual = sum(a * x for a, x in zip(row, answer)) % q
        if actual != expected:
            return False, (
                f"coordinate {j} mismatch: product log is {actual}, "
                f"target log is {expected}"
            )

    for j, (p, h, expected_residue) in enumerate(zip(
            inst["prime_factors"], inst["coordinate_roots"],
            inst["target_residues"])):
        exponent = sum(matrix[j][i] * answer[i] for i in range(n)) % q
        residue = pow(h, exponent, p)
        if residue != expected_residue:
            return False, (
                f"CRT residue {j} mismatch: product is {residue}, "
                f"target is {expected_residue}"
            )
    return True, "ok"


def random_candidate(inst: dict, rng: random.Random) -> object:
    return [rng.randrange(inst["q"]) for _ in range(inst["n"])]


def search_space(inst: dict) -> int | None:
    return inst["q"] ** inst["n"]


def enumerate_all(inst: dict) -> int | None:
    space = search_space(inst)
    if space is None or space > 100_000:
        return None
    count = 0
    for candidate in itertools.product(range(inst["q"]), repeat=inst["n"]):
        if verify(inst, list(candidate))[0]:
            count += 1
    return count


def _canonical_group_payload(inst: dict) -> dict:
    """Canonicalize the represented group elements, not their log encoding.

    Sorting CRT components by their distinct primes removes row labels.  Each
    modular base becomes its full vector of actual residues in that order;
    sorting those vectors removes generator labels.  Changing a coordinate
    root h_j to another generator of the same order-q subgroup, while scaling
    that log row inversely, leaves these actual residues unchanged.
    """
    row_order = sorted(range(inst["n"]), key=inst["prime_factors"].__getitem__)
    components = [
        [inst["prime_factors"][r], inst["target_residues"][r]]
        for r in row_order
    ]
    bases = []
    for c in range(inst["n"]):
        bases.append([
            pow(inst["coordinate_roots"][r],
                inst["base_log_matrix"][r][c],
                inst["prime_factors"][r])
            for r in row_order
        ])
    return {"components": components, "bases": sorted(bases)}


def canonical_key(inst: dict) -> str:
    payload = {
        "q": inst["q"],
        "N": inst["modulus_N"],
        "group": _canonical_group_payload(inst),
    }
    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(raw).hexdigest()


def _relabel_instance(inst: dict, row_order: list[int],
                      column_order: list[int]) -> tuple[dict, list[int]]:
    n = inst["n"]
    if sorted(row_order) != list(range(n)) or sorted(column_order) != list(range(n)):
        raise ValueError("orders must be permutations")
    moved = {
        "n": n,
        "q": inst["q"],
        "cofactor_start": inst["cofactor_start"],
        "modulus_N": inst["modulus_N"],
        "prime_factors": [inst["prime_factors"][r] for r in row_order],
        "coordinate_roots": [inst["coordinate_roots"][r] for r in row_order],
        "base_log_matrix": [
            [inst["base_log_matrix"][r][c] for c in column_order]
            for r in row_order
        ],
        "target_logs": [inst["target_logs"][r] for r in row_order],
        "target_residues": [inst["target_residues"][r] for r in row_order],
        "answer": [inst["answer"][c] for c in column_order],
        "_fast_rank_one": False,
    }
    return moved, list(moved["answer"])


def _rebase_coordinates(inst: dict, scales: list[int]) -> tuple[dict, list[int]]:
    """Change each displayed order-q coordinate root without changing g_i/beta."""
    n = inst["n"]
    q = inst["q"]
    if len(scales) != n or any(not 1 <= u < q for u in scales):
        raise ValueError("each coordinate scale must be nonzero in F_q")
    inverses = [pow(u, -1, q) for u in scales]
    moved = {
        "n": n,
        "q": q,
        "cofactor_start": inst["cofactor_start"],
        "modulus_N": inst["modulus_N"],
        "prime_factors": list(inst["prime_factors"]),
        "coordinate_roots": [
            pow(h, u, p) for h, u, p in zip(
                inst["coordinate_roots"], scales, inst["prime_factors"])
        ],
        "base_log_matrix": [
            [(z * inverses[r]) % q for z in row]
            for r, row in enumerate(inst["base_log_matrix"])
        ],
        "target_logs": [
            (z * inverses[r]) % q for r, z in enumerate(inst["target_logs"])
        ],
        "target_residues": list(inst["target_residues"]),
        "answer": list(inst["answer"]),
        "_fast_rank_one": False,
    }
    return moved, list(moved["answer"])


def escalate(params: dict) -> dict | str | None:
    """Increase field/modulus size while keeping the exponent tuple length fixed."""
    n = int(params["n"])
    q = int(params["q"])
    cofactor_start = int(params.get("cofactor_start", 8000))
    new_q = _next_prime(4 * q + 1)
    new_cofactor = 2 * cofactor_start
    worst_chars = 2 + n * (len(str(new_q - 1)) + 2)
    if worst_chars > 1900 or new_q * (4 * new_cofactor + 100000) >= 2**64:
        return "cap_bound"
    harder = dict(params)
    harder["q"] = new_q

