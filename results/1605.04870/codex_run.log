+        and parse_answer(fenced) == answer
+        and parse_answer("no usable witness here") is None,
+        "tagged_prose_matches": parse_answer(wrapped) == answer,
+        "fenced_json_matches": parse_answer(fenced) == answer,
+        "garbage_returns_none": parse_answer("no usable witness here") is None,
+    }
+
+    # G4 samples the exact promised language. Property 2 and the construction's
+    # full-rank audit prove there is exactly one valid tuple, so equality with the
+    # planted tuple is an exact hit test; any hit is also sent through verify.
+    guess_total = 200_000
+    guess_hits = 0
+    guess_rng = random.Random(0x160504870)
+    guess_started = time.perf_counter()
+    for _ in range(guess_total):
+        candidate = random_candidate(shipping, guess_rng)
+        if candidate == answer:
+            checked_hit, _ = verify(shipping, candidate)
+            guess_hits += int(checked_hit)
+    guess_wall = time.perf_counter() - guess_started
+    space = search_space(shipping)
+    exact_fraction = 1.0 / space
+    report["G4_guess_resistance"] = {
+        "pass": guess_hits / guess_total < 1e-6 and exact_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_fraction": guess_hits / guess_total,
+        "exact_fraction": exact_fraction,
+        "candidate_space": space,
+        "sampling_prior": "uniform over ordered distinct nonzero q-coordinates",
+        "hit_test": "exact tuple equality, justified by Property 2; verifier confirms every hit",
+        "wall_clock_sec": round(guess_wall, 6),
+    }
+
+    attack_seeds = list(range(800, 808))
+    attack_stats = {
+        "outlier_base_magnitude_rank": {"successes": 0, "attempts": 0, "operations": 0},
+        "greedy_nearest_residue": {"successes": 0, "attempts": 0, "operations": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0, "operations": 0},
+        "diagonal_one_base_collapse_2048": {"successes": 0, "attempts": 0, "operations": 0},
+        "generic_meet_in_middle_4096": {"successes": 0, "attempts": 0, "operations": 0},
+        "coordinate_collision_gcd_4096": {
+            "successes": 0, "attempts": 0, "operations": 0, "factors_found": 0
+        },
+    }
+    attack_wall = {name: 0.0 for name in attack_stats}
+    for seed in attack_seeds:
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        rng = random.Random(seed ^ 0x5A17C0DE)
+
+        started = time.perf_counter()
+        candidate = _outlier_rank_candidate(inst)
+        elapsed = time.perf_counter() - started
+        stat = attack_stats["outlier_base_magnitude_rank"]
+        stat["attempts"] += 1
+        stat["operations"] += inst["t"]
+        stat["successes"] += int(verify(inst, candidate)[0])
