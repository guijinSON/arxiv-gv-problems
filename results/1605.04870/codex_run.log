+def _miller_rabin_filter(value: int) -> bool:
+    """A composite filter only; Pocklington supplies the actual proof."""
+    if value < 2:
+        return False
+    for prime in _SMALL_PRIMES:
+        if value == prime:
+            return True
+        if value % prime == 0:
+            return False
+    d = value - 1
+    s = 0
