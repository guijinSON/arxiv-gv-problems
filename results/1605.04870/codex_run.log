+def _outlier_rank_candidate(inst: dict) -> list[int]:
+    order = sorted(range(inst["t"]), key=lambda i: inst["bases"][i])
+    candidate = [0] * inst["t"]
+    for rank, index in enumerate(order, 1):
+        candidate[index] = rank * inst["q"] // (inst["t"] + 1)
+    return candidate
