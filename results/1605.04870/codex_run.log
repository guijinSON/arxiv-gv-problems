+        "hits": hits,
+        "total": guess_total,
+        "empirical_probability": hits / guess_total,
+        "exact_probability": f"1/{search_space(inst)}",
+        "prior": "uniform over all n-tuples in F_q^n, exactly the stated language",
+        "candidate_space_bits": search_space(inst).bit_length(),
+        "sampling_wall_seconds": guess_elapsed,
+    }
+
+    baseline = _reference_gauss(inst)
+    attack_clock = time.perf_counter()
+    _baseline_attack_won, baseline_attack_operations = _attack_random_scalar(inst)
+    baseline_attack_wall = time.perf_counter() - attack_clock
+    demo_count = enumerate_all(make_instance(seed=0, **DIFFICULTY["demo"]))
+    report["G5_density_and_baseline"] = {
+        "pass": baseline["ok"] and hits == 0 and demo_count == 1,
+        "shipping_observed_valid_fraction": hits / guess_total,
+        "shipping_density_sample_count": guess_total,
+        "shipping_valid_hits": hits,
+        "reference_wall_seconds": baseline["wall_clock_sec"],
+        "reference_operation_count": baseline["operations"],
+        "reference_success_count": int(baseline["ok"]),
+        "strongest_failing_attack_budget": baseline_attack_operations,
+        "strongest_failing_attack_wall_seconds": baseline_attack_wall,
+        "demo_exact_solution_count": demo_count,
+        "shipping_candidate_space_bits": search_space(inst).bit_length(),
+        "enumerate_all_shipping": None,
+    }
+
+    attack_counts = {
+        "outlier_repeated_column_value": 0,
+        "target_as_exponents": 0,
+        "greedy_diagonal_only": 0,
+        "greedy_forward_substitution": 0,
+        "random_restart_64_scalar_shifts": 0,
+        "in_context_average_shift_ansatz": 0,
+    }
+    references = []
+    random_restart_operations = 0
+    random_restart_wall = 0.0
+    for seed in range(100, 108):
+        trial = make_instance(seed=seed, **ship_params)
+        if verify(trial, _attack_column_outlier(trial))[0]:
+            attack_counts["outlier_repeated_column_value"] += 1
+        if verify(trial, _attack_target(trial))[0]:
+            attack_counts["target_as_exponents"] += 1
+        if verify(trial, _attack_diagonal(trial))[0]:
+            attack_counts["greedy_diagonal_only"] += 1
+        if verify(trial, _attack_greedy(trial))[0]:
+            attack_counts["greedy_forward_substitution"] += 1
+        attack_clock = time.perf_counter()
+        won, operations = _attack_random_scalar(trial)
+        random_restart_wall += time.perf_counter() - attack_clock
+        random_restart_operations += operations
+        if won:
+            attack_counts["random_restart_64_scalar_shifts"] += 1
+        if verify(trial, _attack_average(trial))[0]:
+            attack_counts["in_context_average_shift_ansatz"] += 1
+        references.append(_reference_gauss(trial))
+    ref_successes = sum(int(run["ok"]) for run in references)
+    all_failed = all(count == 0 for count in attack_counts.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and ref_successes == 8,
