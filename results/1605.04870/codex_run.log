+def _rank_mod(matrix: list[list[int]], modulus: int) -> int:
+    work = [row[:] for row in matrix]
+    rows = len(work)
+    columns = len(work[0]) if rows else 0
+    rank = 0
+    for column in range(columns):
+        pivot = next((r for r in range(rank, rows) if work[r][column] % modulus), None)
+        if pivot is None:
+            continue
+        work[rank], work[pivot] = work[pivot], work[rank]
+        inverse = pow(work[rank][column] % modulus, -1, modulus)
+        work[rank] = [(entry * inverse) % modulus for entry in work[rank]]
+        for row in range(rows):
+            if row == rank:
+                continue
+            scale = work[row][column] % modulus
+            if scale:
+                work[row] = [
+                    (a - scale * b) % modulus
+                    for a, b in zip(work[row], work[rank])
+                ]
+        rank += 1
+        if rank == rows:
+            break
+    return rank
