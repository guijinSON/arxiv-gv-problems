+        "transformations": [
+            "base permutation with coordinate transport",
+            "common nonzero-power group automorphism",
+            "composition of permutation and common powering",
+        ],
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": carried_checks,
+        "nontrivial_transformations": nontrivial_changes,
+        "unrelated_instances": 20,
+        "distinct_keys": len(unrelated_keys),
+        "failures": failures,
+        "key_caveat": "strong cheap ambient/CRT-equality invariant, not complete isomorphism",
+    }
+
+    size_answers = [
+        make_instance(seed=30_000 + seed, **ship_params)["answer"] for seed in range(32)
+    ]
+    answer_chars = max(
