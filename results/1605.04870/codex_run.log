/bin/bash -lc "while pgrep -f '"'^python3 gen_1605_04870.py$'"' >/dev/null; do sleep 3; done; echo finished; wc -c /tmp/selftest_pre.json; python3 - <<'PY'
import json
r=json.load(open('/tmp/selftest_pre.json'))
for k,v in r.items():
