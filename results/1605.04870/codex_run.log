+def _provable_prime(bits: int, rng: random.Random) -> tuple[int, list[tuple[int, int]]]:
+    """Generate an exact prime and its recursive Pocklington (n, witness) chain."""
+    if bits < 2:
+        raise ValueError("prime bit length must be at least 2")
