+DIFFICULTY = {
+    "demo": {"n": 8, "window": 2, "field": "toy"},
+    "easy": {"n": 512, "window": 20, "field": "goldilocks"},
+    "medium": {"n": 1024, "window": 20, "field": "goldilocks"},
+    "hard": {"n": 2048, "window": 20, "field": "goldilocks"},
