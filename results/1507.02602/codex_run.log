+
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_seconds[name], 6),
+        }
+        for name in attack_names
+    }
+    reference_operations = 4 * inst["n"] + 9
+    compact_operations = 5 * inst["window"] + 9
+    reference_algorithm = {
