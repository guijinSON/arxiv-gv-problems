+        for seed in (0, 1, 19):
+            instance = make_instance(seed=seed, **params)
+            ok, _ = verify(instance, instance["answer"])
+            g1_attempts += 1
+            g1_successes += int(ok)
+            json_native &= json.loads(json.dumps(instance["answer"])) == instance["answer"]
+    prime_checks = {
+        name: _is_prime_64(data["p"]) for name, data in _FIELDS.items()
