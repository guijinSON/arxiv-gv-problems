+    phase = a_scale * b_scale % p
+    short_at_omega = _horner(short_polynomial, omega, p)
+    short_at_inverse = _horner(short_polynomial, omega_inverse, p)
+    left_constant = (
+        phase * (n % p) * ((omega - 1) % p) * short_at_omega
+    ) % p
+    right_constant = (
+        -phase
+        * (n % p)
+        * ((omega_inverse - 1) % p)
+        * short_at_inverse
+    ) % p
+
