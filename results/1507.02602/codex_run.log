+        "verified": g1_successes,
+        "attempts": g1_attempts,
+        "answer_json_native": json_native,
+        "field_prime_checks": prime_checks,
+    }
+
+    shipping_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    inst = make_instance(seed=12_345, **shipping_params)
