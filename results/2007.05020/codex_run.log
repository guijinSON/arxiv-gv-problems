+        "valid_carried_witnesses": carried_trials,
+        "carried_attempts": 40,
+        "distinct_unrelated": distinct_keys,
+        "unrelated_attempts": len(unrelated_keys),
+        "key_kind": "common-neighbor/class-profile invariant, never seed/render/answer",
+    }
