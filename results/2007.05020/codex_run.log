+    guess_hits = 0
+    guess_started = time.perf_counter()
+    for _ in range(guess_total):
+        candidate = random_candidate(shipping, guess_rng)
+        mask = 0
+        for label in candidate:
+            mask |= 1 << position[label]
+        valid = True
+        for label in candidate:
+            if adjacency[position[label]] & mask:
+                valid = False
+                break
