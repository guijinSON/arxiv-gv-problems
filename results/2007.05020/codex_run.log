+            "complexity": "O(n) exact modular arithmetic",
+            "mean_wall_clock_sec": round(reference_seconds / attempts, 6),
+            "operations": max(reference_operations_seen),
+            "solves": f"{reference_successes}/{attempts}, as expected",
+        },
