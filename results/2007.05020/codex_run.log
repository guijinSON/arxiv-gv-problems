+    "easy": {"n": 22, "pool_size": 28, "degree": 20, "mix_rounds": 9},
+    "medium": {"n": 24, "pool_size": 32, "degree": 23, "mix_rounds": 10},
+    "hard": {"n": 24, "pool_size": 40, "degree": 29, "mix_rounds": 11},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
