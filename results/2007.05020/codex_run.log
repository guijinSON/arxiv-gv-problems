+
+def _validate_parameters(n: int, degree: int) -> None:
+    if type(n) is not int or n < 28 or n > 896 or n % 7:
+        raise ValueError("n must be a multiple of 7 in [28, 896]")
+    if not _is_prime(n + 1):
+        raise ValueError("n+1 must be prime")
