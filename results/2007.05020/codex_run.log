+    answer_tokens = 2 * answer_atoms + 2
+    intended_operations = math.comb(inst["n"], 2)
+    within_caps = (
+        answer_chars <= 2000
+        and answer_atoms <= 256
+        and intended_operations <= 300
+    )
+    arms = {key: dict(_ORACLE_EVIDENCE[key]) for key in ("bare", "hinted", "placebo")}
+    hinted_rate = (
