+        "structure_aware_space": search_space(shipping),
+        "candidate_prior": "uniform over all exact-2n/7 subsets of public labels",
+        "elapsed_sec": round(guess_elapsed, 6),
+    }
+
+    baseline_started = time.perf_counter()
