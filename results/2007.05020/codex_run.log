+    for record in inst["pair_alliances"]:
+        i, j = record["i"], record["j"]
+        rows = list(record["rows"])
+        adj[i][j] = rows
+        adj[j][i] = _columns(rows, q)
+    return adj
+
+
+def _labels_from_answer(inst: dict, answer: list[int]) -> list[int]:
+    q = inst["pool_size"]
