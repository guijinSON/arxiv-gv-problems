+        )
+        if canonical_key(composed) == original_key:
+            invariant_trials += 1
+        if verify(composed, composed["answer"])[0]:
+            carried_trials += 1
+    distinct_keys = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": (
