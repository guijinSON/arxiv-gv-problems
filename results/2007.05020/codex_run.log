+            new_assigned[c] = value
+            new_domains[c] = 1 << value
+            feasible = True
+            for d in unassigned:
+                if d == c:
+                    continue
+                new_domains[d] &= adj[c][d][value]  # type: ignore[index]
+                if not new_domains[d]:
