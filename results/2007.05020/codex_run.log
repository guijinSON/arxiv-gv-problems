+STRUCTURAL_HINT = (
+    "The useful signal is in intersections of compatibility neighborhoods "
+    "across several pools, not in any single hero's degree."
+)
+PLACEBO_HINT = (
+    "The useful information is encoded in hexadecimal rows across several "
