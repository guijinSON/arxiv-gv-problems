+        if arms["placebo"]["attempts"] else 0.0
+    )
+    hinted_hardened = _ORACLE_EVIDENCE["hinted_verdict"] == "hardened"
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_hardened and within_caps,
