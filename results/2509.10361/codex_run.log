--- /dev/null
+++ b/selftest_report.json
@@ -0,0 +1,102 @@
+{
+  "G1_planted_verifies": {
+    "checks": 8,
+    "failures": [],
+    "pass": true
+  },
+  "G2_rejects_corruption": {
+    "cases": {
