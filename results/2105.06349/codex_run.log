+    first = order[0]
+    last = order[-1]
+    start_edge = _edge(("p", first, 0), ("p", first, 1))
+    finish_edge = _edge(("q", last, 0), ("q", last, 1))
+    edges.add(start_edge)
+    edges.add(finish_edge)
