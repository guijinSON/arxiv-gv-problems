            "step": step,
            "eid": equation_ids[step],
            "z": wire_map[z],
            "a": wire_map[a],
            "b": wire_map[b],
            "rhs": rhs,
            "codes": _forbidden_codes(rhs, rng),
        })

    checks = []
    half = n // 2
    for i in range(n):
        a = current[i]
        b = current[(i + 1) % n]
        c = current[(i + half) % n]
        rhs = values[a] ^ values[b] ^ values[c]
        checks.append({
            "eid": equation_ids[gates + i],
            "a": wire_map[a],

