+        "family": "Lemma-4 claw-free 2-Disjoint Connected Subgraphs",
+        "n_inputs": n,
+        "n_variables": variable_count,
+        "gate_count": gates,
+        "inputs": [wire_map[i] for i in range(n)],
+        "gates": gate_records,
