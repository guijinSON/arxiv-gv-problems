+    one = next(i for i, bit in enumerate(answer) if bit == 1)
+    swapped = list(answer)
+    swapped[zero], swapped[one] = swapped[one], swapped[zero]
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": swapped,
+        "duplicate": answer + [answer[0]],
+        "empty": [],
+        "out_of_range": answer[:3] + [2] + answer[4:],
+    }
+    rejected = {}
+    for name, candidate in corruptions.items():
