+def _forbidden_codes(rhs, rng):
+    codes = [
+        f"{a}{b}{c}"
+        for a in (0, 1)
+        for b in (0, 1)
+        for c in (0, 1)
+        if (a ^ b ^ c) != rhs
+    ]
+    rng.shuffle(codes)
+    return codes
