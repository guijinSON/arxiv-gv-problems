+        for sign in (0, 1):
+            p = ("p", variable, sign)
+            q = ("q", variable, sign)
+            occurrences = sorted(rails[(variable, sign)], key=lambda x: (x[2], x[3]))
+            chain = [p] + occurrences + [q]
+            chain_edges = []
+            for left, right in zip(chain, chain[1:]):
+                item = _edge(left, right)
+                edges.add(item)
+                chain_edges.append(item)
