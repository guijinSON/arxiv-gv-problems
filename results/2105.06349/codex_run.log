def verify(inst, answer):
    """Check L a=b exactly over F_2; never consult inst['answer']."""
    try:
        k = inst["dimension"]
        if isinstance(k, bool) or not isinstance(k, int) or k < 1:
            return False, "malformed instance dimension"
        rows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
        rhs_text = inst["repeated_column"]
        if not isinstance(rhs_text, str) or len(rhs_text) != k:
            return False, f"instance b must be a {k}-bit string"
        rhs = _bits_from_string(rhs_text)
    except (KeyError, TypeError, ValueError) as exc:
        return False, "malformed instance: " + str(exc)
    bits, reason = _pack_candidate(answer, k)
    if reason is not None:
        return False, reason
    for i, row in enumerate(rows):
        got = (row & bits).bit_count() & 1
        expected = (rhs >> i) & 1
        if got != expected:
            return False, (
                f"equation row {i} fails: dot product is {got}, expected {expected}"
            )
    return True, "ok"


def random_candidate(inst, rng):
    """Uniformly sample the stated k-by-1 binary-matrix language."""
    k = inst["dimension"]
    return [[rng.randrange(2)] for _ in range(k)]


def search_space(inst):
    return 1 << inst["dimension"]


def enumerate_all(inst):
    k = inst["dimension"]
    if k > 20:
        return None
    count = 0
    for bits in range(1 << k):
        candidate = [[(bits >> i) & 1] for i in range(k)]
        count += int(verify(inst, candidate)[0])
    return count


def _wl_label(tag, payload):
    raw = json.dumps([tag, payload], separators=(",", ":"), sort_keys=True)
    return hashlib.sha256(raw.encode("ascii")).hexdigest()


def canonical_key(inst):
    """Cheap bipartite-graph invariant under equation and variable relabelling.

    Rows are coloured by their rhs bit, columns by their role.  Six rounds of
    exact colour refinement, followed by the colour-pair edge multiset, is a
    strong invariant.  It need not decide arbitrary bipartite isomorphism; that
    limitation is recorded in README.md.
    """
    k = inst["dimension"]
    rows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
    rhs = _bits_from_string(inst["repeated_column"])
    rlabels = [_wl_label("row", (rhs >> i) & 1) for i in range(k)]
    clabels = [_wl_label("column", 0) for _ in range(k)]
    for _ in range(6):
        new_rows = []
        for i, row in enumerate(rows):
            counts = Counter(clabels[j] for j in range(k) if (row >> j) & 1)
            new_rows.append(_wl_label("row", [rlabels[i], sorted(counts.items())]))
        new_cols = []
        for j in range(k):
            counts = Counter(rlabels[i] for i, row in enumerate(rows)
                             if (row >> j) & 1)
            new_cols.append(_wl_label("column", [clabels[j], sorted(counts.items())]))
        rlabels, clabels = new_rows, new_cols
    edge_types = Counter(
        (rlabels[i], clabels[j])
        for i, row in enumerate(rows)
        for j in range(k)
        if (row >> j) & 1
    )
    payload = [sorted(rlabels), sorted(clabels), sorted(
        [a, b, count] for (a, b), count in edge_types.items()
    )]
    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()


def escalate(params):
    """First crowd the masks at fixed answer length, then respect the effort cap."""
    out = {key: value for key, value in params.items() if key != "_preset"}
    n = out["n"]
    k = (n - 2) // 2
    weight = out.get("mask_weight", k // 2)
    if weight < k // 2:
        out["mask_weight"] = min(k // 2, weight + max(1, k // 16))
        return out
    # Increasing k beyond 64 makes the worst-case compact rank-two route exceed
    # the 300 exact-operation G9 cap; increasing rank does the same sooner.
    return "cap_bound"


def _base_generator_rows(k):
    rows = []
    for block in range(k // 4):
        for text in _G8:
            rows.append(_bits_from_string(text) << (8 * block))
    return rows


def _public_extension_rows(inst):
    """Reconstruct the displayed [L G1 | b | b] rows as integers."""
    k = inst["dimension"]
    lrows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
    grows = _base_generator_rows(k)
    rhs = _bits_from_string(inst["repeated_column"])
    out = []
    for i, lrow in enumerate(lrows):
        base = 0
        for j in range(k):
            if (lrow >> j) & 1:
                base ^= grows[j]
        bit = (rhs >> i) & 1
        out.append(base | (bit << (2 * k)) | (bit << (2 * k + 1)))
    return out


def _gaussian_reference(inst):
    """Ordinary exact Gaussian elimination, with bit-operation accounting."""
    k = inst["dimension"]
    rows = [list(map(int, row)) + [int(inst["repeated_column"][i])]
            for i, row in enumerate(inst["row_basis_matrix"])]
    operations = 0
    comparisons = 0
    for col in range(k):
        pivot = None
        for i in range(col, k):
            comparisons += 1
            if rows[i][col]:
                pivot = i
                break
        if pivot is None:
            return None, {"bit_operations": operations, "pivot_tests": comparisons}
        if pivot != col:
            rows[col], rows[pivot] = rows[pivot], rows[col]
        for i in range(col + 1, k):
            comparisons += 1
            if rows[i][col]:
                for j in range(col, k + 1):
                    rows[i][j] ^= rows[col][j]
                    operations += 1
    answer = [0] * k
    for i in range(k - 1, -1, -1):
        value = rows[i][k]
        for j in range(i + 1, k):
            value ^= rows[i][j] & answer[j]
            operations += 2
        answer[i] = value
    return [[bit] for bit in answer], {
        "bit_operations": operations,
        "pivot_tests": comparisons,
    }


def _compact_solve(inst):
    """Exploit L^(-1)=L and reuse the <=3 nonzero row offsets of L-I."""
    k = inst["dimension"]
    rows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
    rhs = _bits_from_string(inst["repeated_column"])
    diffs = [row ^ (1 << i) for i, row in enumerate(rows)]
    parity = {diff: ((diff & rhs).bit_count() & 1) for diff in set(diffs)}
    bits = rhs
    for i, diff in enumerate(diffs):
        if parity[diff]:
            bits ^= 1 << i
    return [[(bits >> i) & 1] for i in range(k)]


def _candidate(bits, k):
    return [[(bits >> i) & 1] for i in range(k)]


def _attack_candidates(inst, seed):
    k = inst["dimension"]
    rows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
    rhs = _bits_from_string(inst["repeated_column"])

    col_weights = [sum((row >> j) & 1 for row in rows) for j in range(k)]
    median = sorted(col_weights)[k // 2]
    outlier = sum((col_weights[j] > median) << j for j in range(k))

    residual = rhs
    greedy = 0
    for j in range(k):
        col = sum(((row >> j) & 1) << i for i, row in enumerate(rows))
        if (residual ^ col).bit_count() < residual.bit_count():
            residual ^= col
            greedy |= 1 << j

    diffs = [row ^ (1 << i) for i, row in enumerate(rows)]
    nonzero = [d for d in diffs if d]
    common = Counter(nonzero).most_common(1)[0][0] if nonzero else 0
    rank_one = rhs
    if (common & rhs).bit_count() & 1:
        for i, diff in enumerate(diffs):
            if diff == common:
                rank_one ^= 1 << i

    rng = random.Random(seed ^ 0x10125464)
    restarts = [_candidate(rng.getrandbits(k), k) for _ in range(256)]
    return {
        "outlier_column_weight_threshold": [_candidate(outlier, k)],
        "greedy_left_to_right_residual": [_candidate(greedy, k)],
        "diagonal_identity_ansatz": [_candidate(rhs, k)],
        "by_hand_rank_one_offset_ansatz": [_candidate(rank_one, k)],
        "random_restart_256": restarts,
    }


def _relabel_variants(inst, seed):
    k = inst["dimension"]
    rng = random.Random(seed)
    row_perm = list(range(k))
    col_perm = list(range(k))
    rng.shuffle(row_perm)
    rng.shuffle(col_perm)

    def transformed(do_rows, do_cols):
        rows = list(inst["row_basis_matrix"])
        rhs = inst["repeated_column"]
        answer = [list(row) for row in inst["answer"]]
        if do_cols:
            rows = ["".join(row[j] for j in col_perm) for row in rows]
            answer = [answer[j] for j in col_perm]
        if do_rows:
            rows = [rows[i] for i in row_perm]
            rhs = "".join(rhs[i] for i in row_perm)
        out = dict(inst)
        out["row_basis_matrix"] = rows
        out["repeated_column"] = rhs
        out["answer"] = answer
        return out

    return [transformed(True, False), transformed(False, True), transformed(True, True)]


def _answer_atoms(value):
    if isinstance(value, dict):
        return sum(_answer_atoms(item) for item in value.values())
    if isinstance(value, list):
        return sum(_answer_atoms(item) for item in value)
    return 1


def selftest():
    report = {}
    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]

    g1_failures = []
    g1_attempts = 0
    for preset, params in DIFFICULTY.items():
        for seed in (0, 1, 7):
            inst = make_instance(seed=seed, **params)
            ok, why = verify(inst, inst["answer"])
            g1_attempts += 1
            if not ok:
                g1_failures.append([preset, seed, why])
            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
                g1_failures.append([preset, seed, "answer is not JSON-native"])
            k = inst["dimension"]
            lrows = _cached_public_rows(tuple(inst["row_basis_matrix"]), k)
            if _rank_vectors(lrows, k) != k:
                g1_failures.append([preset, seed, "row-basis matrix is singular"])
            # Execute the code certificate: the public rows have rank k and zero
            # pairwise inner products, hence span a self-orthogonal k-space.
            hrows = _public_extension_rows(inst)
            if _rank_vectors(hrows, inst["code_length"]) != k:
                g1_failures.append([preset, seed, "public generator loses rank"])
            if any((x & y).bit_count() & 1 for x in hrows for y in hrows):
                g1_failures.append([preset, seed, "public generator is not self-orthogonal"])
    report["G1_planted_verifies"] = {
        "pass": not g1_failures,
        "attempts": g1_attempts,
        "failures": g1_failures,
        "construction_checks": "full rank and all public generator inner products zero",
    }

    inst = make_instance(seed=19, **shipping_params)
