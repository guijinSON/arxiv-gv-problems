+    "hard": {"n": 32, "gates": 160},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+
+STRUCTURAL_HINT = (
+    "The first-to-second wire maps in the CHECK rows form one cyclic parity "
+    "operator, with each third wire at the antipodal position."
+)
+PLACEBO_HINT = (
