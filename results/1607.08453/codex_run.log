+            "max_wall_clock_sec": max(reference_seconds),
+            "mean_operations": sum(reference_operations) / len(reference_operations),
+            "max_operations": max(reference_operations),
+        },
+    }
+
+    doubled = dict(shipping_params)
+    doubled["n"] *= 2
