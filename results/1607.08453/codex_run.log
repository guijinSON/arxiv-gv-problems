+# s in [n,n+2*spread].  The witness always remains six integers.
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "spread": 0, "chain_len": 2},
+    "easy": {"n": 100_001, "spread": 10_000, "chain_len": 10},
+    "medium": {"n": 1_000_001, "spread": 100_000, "chain_len": 14},
+    "hard": {"n": 10_000_001, "spread": 1_000_000, "chain_len": 18},
+}
