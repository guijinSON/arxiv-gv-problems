 def escalate(params: dict) -> dict | str | None:
     """Grow both factor orders and decoder crowding at fixed witness length."""
+    if len(DIFFICULTY) == 1:  # isolated G9 shipping-arm copy
+        return None
     try:
         n = int(params["n"])
         spread = int(params.get("spread", 0))
