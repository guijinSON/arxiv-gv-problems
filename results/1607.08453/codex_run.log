+                 and rate < 1e-6 and not baseline_ok and reference["ok"]),
+        "shipping_valid_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_density_estimate": rate,
+        "demo_exact_valid_count": demo_count,
