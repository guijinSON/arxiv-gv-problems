+        "invariance_attempts": 80,
+        "carried_witness_successes": carried_checks,
+        "carried_witness_attempts": 80,
+        "unrelated_distinct_keys": distinct,
+        "unrelated_attempts": 20,
+        "symmetries_tested": [
