@@ -93,10 +93,7 @@
 # n is the minimum odd block length.  Each factor has 3s vertices for an odd
 # s in [n,n+2*spread].  The witness always remains six integers.
 DIFFICULTY: dict = {
-    "demo": {"n": 3, "spread": 0, "chain_len": 2},
