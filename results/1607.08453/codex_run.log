+
+
+def _encode(factor: dict, coordinate: int) -> int:
+    value = coordinate % factor["order"]
+    modulus = factor["order"]
+    for _multiplier, shift, inverse in reversed(factor["stages"]):
+        value = (inverse * (value - shift)) % modulus
+    return value
+
