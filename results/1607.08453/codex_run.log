+    baseline_wall = time.perf_counter() - baseline_start
+    baseline_ok = verify(inst, baseline)[0]
+    reference = _reference_scan(inst)
+    report["G5_density_and_baseline"] = {
+        "pass": (demo_count is not None and demo_count >= 1
