+    }
+
+    doubled = dict(shipping_params)
+    doubled["n"] *= 2
+    doubled_inst = make_instance(seed=314159, **doubled)
+    harder = escalate(shipping_params)
+    report["G7_scales"] = {
+        "pass": (verify(doubled_inst, doubled_inst["answer"])[0]
+                 and doubled_inst["factors"][0]["order"]
