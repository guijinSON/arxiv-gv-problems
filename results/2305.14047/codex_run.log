+            for row in inverse:
+                row[i], row[j] = row[j], row[i]
+        elif kind == 1:
+            i = rng.randrange(size)
+            factor = rng.randrange(1, q)
+            inv_factor = pow(factor, -1, q)
+            matrix[i] = [factor * value % q for value in matrix[i]]
+            for row in inverse:
+                row[i] = row[i] * inv_factor % q
+        else:
+            i, j = rng.sample(range(size), 2)
+            factor = rng.randrange(1, q)
