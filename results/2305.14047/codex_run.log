+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 12, "k": 5},
+    "easy": {"n": 384, "k": 21},
+    "medium": {"n": 512, "k": 21},
+    "hard": {"n": 768, "k": 21},
+}
