-    first = next(index for index, value in enumerate(syndrome) if value)
-    residue = syndrome[first]
-    if min(residue, q - residue) > inst["thresholds"][first]:
-        return False
-    hole = _dot(inst["holes"], syndrome, q)
-    return leading != hole
