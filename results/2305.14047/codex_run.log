import itertools
import gen_2305_14047 as g
for q,n in [(3,2),(5,3),(7,3)]:
    inst=g.make_instance(n=n,q=q,seed=123)
    verts=list(itertools.product(range(q),repeat=n))
    degrees=[]
    for x in verts:
        deg=0
        for y in verts:
            delta=[(a-b)%q for a,b in zip(x,y)]
            adjacent=g._adjacent_difference(inst,delta)
            reverse=g._adjacent_difference(inst,[(-z)%q for z in delta])
            assert adjacent == reverse
            deg += adjacent
        degrees.append(deg)
    assert len(set(degrees)) == 1
    assert g.verify(inst,inst['answer']) == (True,'ok')
    b,v=inst['answer']
    line={tuple((b[i]+t*v[i])%q for i in range(n)) for t in range(q)}
    for y in verts:
        if y not in line:
            assert any(not g._adjacent_difference(inst,[(y[i]-x[i])%q for i in range(n)]) for x in line)
    good=0
    for raw in range(1,q**n):
        v=g._encode_vector(raw,n,q)
        p=next(i for i,x in enumerate(v) if x)
        if v[p] == 1:
            good += g.verify(inst,[[0]*n,v])[0]
    assert good == 1
    print(q,n,len(verts),degrees[0],good)
print('exact small-graph checks passed')
