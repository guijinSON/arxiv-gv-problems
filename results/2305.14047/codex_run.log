+        if operation == 0 and size > 2:
+            i, j = rng.sample(range(1, size), 2)
+            rows[i], rows[j] = rows[j], rows[i]
+        elif operation == 1:
+            i = rng.randrange(1, size)
+            factor = rng.randrange(1, q)
+            rows[i] = [(entry + factor * base) % q
+                       for entry, base in zip(rows[i], rows[0])]
+        elif size > 2:
+            i, j = rng.sample(range(1, size), 2)
+            factor = rng.randrange(1, q)
