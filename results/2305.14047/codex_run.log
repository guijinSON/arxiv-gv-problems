import importlib.util,itertools,random
spec=importlib.util.spec_from_file_location('g','gen_2305_14047.py')
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
for q,n in [(3,2),(5,3),(7,3)]:
  inst=g.make_instance(n=n,q=q,seed=123)
  verts=list(itertools.product(range(q),repeat=n))
  degrees=[]
  for x in verts:
    deg=0
    for y in verts:
      delta=[(a-b)%q for a,b in zip(x,y)]
      a=g._adjacent_difference(inst,delta)
      rev=g._adjacent_difference(inst,[(-z)%q for z in delta])
      assert a==rev
      deg+=a
    degrees.append(deg)
  assert len(set(degrees))==1
  answer=inst['answer']; assert g.verify(inst,answer)==(True,'ok')
  b,v=answer
  line={tuple((b[i]+t*v[i])%q for i in range(n)) for t in range(q)}
  assert len(line)==q
  for y in verts:
    if y in line: continue
    assert any(not g._adjacent_difference(inst,[(y[i]-x[i])%q for i in range(n)]) for x in line)
  directions=0; good=0
  for raw in range(1,q**n):
    v=g._encode_vector(raw,n,q)
    p=next(i for i,x in enumerate(v) if x)
    if v[p]"'!=1: continue
    directions+=1
    good+=g.verify(inst,[[0]*n,v])[0]
  assert good==1
  print({'"'q':q,'n':n,'vertices':len(verts),'regular_degree':degrees[0],'directions':directions,'valid_directions':good})
print('exact small-instance graph checks passed')
