+def _multiply_by_linear(quotient, root, q):
+    """Coefficient list of (X-root)*quotient(X)."""
+    product = [0] * (len(quotient) + 1)
+    for index, coefficient in enumerate(quotient):
+        product[index] = (product[index] - root * coefficient) % q
