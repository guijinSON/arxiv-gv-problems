import importlib.util,itertools
spec=importlib.util.spec_from_file_location('g','gen_2305_14047.py')
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
for q,n in [(3,2),(5,3),(7,3)]:
  inst=g.make_instance(n=n,q=q,seed=123)
  verts=list(itertools.product(range(q),repeat=n))
  degrees=[]
  for x in verts:
    deg=0
    for y in verts:
      delta=[(a-b)%q for a,b in zip(x,y)]
      a=g._adjacent_difference(inst,delta)
