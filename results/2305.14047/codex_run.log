+def _threshold_vector(n, q, seed):
+    half_bound = (q - 3) // 2
+    if half_bound == 0:
+        return [0] * (n - 1)
+    radix = half_bound + 1
+    code = seed % (radix ** (n - 1))
+    thresholds = []
+    for _ in range(n - 1):
+        thresholds.append(code % radix)
+        code //= radix
+    return thresholds
 
