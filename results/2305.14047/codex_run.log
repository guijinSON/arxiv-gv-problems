+def _root_reference(inst):
+    """Compact Track-B algorithm: scan roots of the first polynomial row."""
+    q = inst["q"]
+    coefficients = inst["constraints"][0]
+    operations = 0
+    for root in range(q):
+        value = coefficients[-1]
+        for coefficient in reversed(coefficients[:-1]):
+            value = (value * root + coefficient) % q
+            operations += 2
+        if value == 0:
+            direction = [1]
+            for _ in range(1, inst["n"]):
+                direction.append(direction[-1] * root % q)
+                operations += 1
+            candidate = [[0] * inst["n"], direction]
+            if verify(inst, candidate)[0]:
+                return candidate, operations, root + 1
+    return None, operations, q
 
 
