+def _sample_root_free_quotient(length, q, rng):
+    """Sample Q with Q(0)=1 and no root in F_q (normally full degree)."""
+    if length == 1:
+        return [1]
+    # A nonconstant linear polynomial over a field always has a root.  Keep a
