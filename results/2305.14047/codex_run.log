   302	        return False
   303	    leading, syndrome = _transformed_difference(inst, difference)
   304	    if not any(syndrome):
   305	        return True
   306	    first = next(index for index, value in enumerate(syndrome) if value)
   307	    residue = syndrome[first]
   308	    if min(residue, q - residue) > inst["thresholds"][first]:
   309	        return False
   310	    hole = _dot(inst["holes"], syndrome, q)
   311	    return leading != hole
   312	
   313	
   314	def _canonical_line(base, direction, q):
   315	    nonzero = [index for index, value in enumerate(direction) if value % q]
   316	    if not nonzero:
   317	        return None
   318	    pivot = nonzero[0]
   319	    scale = pow(direction[pivot] % q, -1, q)
   320	    normalized = [value * scale % q for value in direction]
   321	    shift = base[pivot] % q
   322	    canonical_base = [(value - shift * step) % q
   323	                      for value, step in zip(base, normalized)]
   324	    return [canonical_base, normalized]
