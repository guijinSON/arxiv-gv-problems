import random, math, time

def gen(n,k,seed,pout_num=1,pout_den=2):
 r=random.Random(seed); H=set(r.sample(range(n),k)); hi=list(H); r.shuffle(hi)
 adj=[0]*n
 def edge(i,j): adj[i]|=1<<j; adj[j]|=1<<i
 for a,b in zip(hi,hi[1:]+hi[:1]): pass
 # complete minus cycle
 cyc=set()
 for a,b in zip(hi,hi[1:]+hi[:1]):cyc.add(tuple(sorted((a,b))))
 for ii,a in enumerate(hi):
  for b in hi[ii+1:]:
   if tuple(sorted((a,b))) not in cyc: edge(a,b)
 d_in=k-3
 # solve expected-degree balance exactly
 # q=(pout*(n-k-1)-d_in)/(n-2k)
 qnum=pout_num*(n-k-1)-d_in*pout_den; qden=pout_den*(n-2*k)
 O=[v for v in range(n) if v not in H]
 for ai,a in enumerate(O):
  for b in O[ai+1:]:
   if r.randrange(pout_den)<pout_num: edge(a,b)
 for a in H:
  for b in O:
   if r.randrange(qden)<qnum: edge(a,b)
 return adj,sorted(H),(qnum,qden)

def verify(adj,S,k,t):
 if len(S)"'!=k or len(set(S))<k:return False
 mask=sum(1<<v for v in S)
 return all((adj[v]&mask).bit_count()>=t for v in S)

def greedy(adj,k,t,mode=0):
 n=len(adj)
 deg=[x.bit_count() for x in adj]
 tri=[]
 for v in range(n):
  s=0; m=adj[v]
  while m:
   b=m&-m;u=b.bit_length()-1;s+=(adj[u]&m).bit_count();m-=b
  tri.append(s)
 for init in ([max(range(n),key=lambda v:deg[v])],[max(range(n),key=lambda v:tri[v])]):
  S=init[:]
  while len(S)<k:
   sm=sum(1<<v for v in S)
   cand=[v for v in range(n) if not sm>>v&1]
   v=max(cand,key=lambda x:((adj[x]&sm).bit_count(), sum((adj[x]>>u)&1 for u in range(n) if u not in S)*0+deg[x]))
   S.append(v)
  if verify(adj,S,k,t):return S
 return None

def random_restart(adj,k,t,seed,R=256):
 r=random.Random(seed); n=len(adj)
 for _ in range(R):
  S=[r.randrange(n)]
  while len(S)<k:
   sm=sum(1<<v for v in S)
   cand=[v for v in range(n) if not sm>>v&1]
   # randomized among top quartile scores
   vals=[((adj[v]&sm).bit_count(),v) for v in cand];mx=max(a for a,v in vals)
   top=[v for a,v in vals if a>=mx-(1 if len(S)>4 else 0)]
   S.append(r.choice(top))
  if verify(adj,S,k,t):return S
 return None

def spectral(adj,k,t,iters=40):
 n=len(adj); deg=[a.bit_count() for a in adj]; p=sum(deg)/(n*(n-1))
 r=random.Random(99); x=[r.random()-.5 for _ in range(n)];mu=sum(x)/n;x=[z-mu for z in x]
 for _ in range(iters):
  sx=sum(x)
  y=[]
  for i in range(n):
   s=0.;m=adj[i]
   while m:
    b=m&-m;j=b.bit_length()-1;s+=x[j];m-=b
   # center A-p(J-I)
   y.append(s-p*(sx-x[i]))
  mu=sum(y)/n;y=[z-mu for z in y];norm=sum(z*z for z in y)**.5
  if not norm:break
  x=[z/norm for z in y]
 for rev in (True,False):
  S=sorted(range(n),key=lambda i:x[i],reverse=rev)[:k]
  if verify(adj,S,k,t):return S
 return None

for n in [96,128,160,192,256]:
 k=15;t=12
 print('"'n',n)
 for name,fn in [('greedy',lambda a,s:greedy(a,k,t)),('restart',lambda a,s:random_restart(a,k,t,s)),('spectral',lambda a,s:spectral(a,k,t))]:
  suc=0; ts=[]
  for seed in range(8):
   a,H,q=gen(n,k,seed); st=time.perf_counter();z=fn(a,seed);ts.append(time.perf_counter()-st);suc+=z is not None
  print(name,suc,'time',sum(ts), 'q',q)
