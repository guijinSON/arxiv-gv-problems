        degInCS[i]=0;
        degInS[i]=0;
        G_index[i]=0;
        G_record[i]=0;
        G_temp[i]=0;
    }

    size_p=std::ceil(gamma*(size_bound-1));
        if(quiete!=0)
    	in.open("./output");

}

FastQC::~FastQC(){
    delete []degInCS;
    delete []degInS;
    in.close();
}

