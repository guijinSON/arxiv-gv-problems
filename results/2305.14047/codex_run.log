+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": "
+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 12, "k": 5},
+    "easy": {"n": 384, "k": 21},
+    "medium": {"n": 512, "k": 21},
+    "hard": {"n": 768, "k": 21},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "An unordered set of exactly k distinct 0-based vertex indices from "
+        "an n-vertex graph, serialized as an increasing JSON-native integer list."
+    ),
+    "bounds": {
+        "answer_vertices": 21,
+        "shipping_ground_set": 384,
+        "distinct": True,
+        "index_min": 0,
+        "index_max_shipping": 383,
+    },
+}
+
+NOTES: str = (
+    "Section 2.1 fixes the exact object: every subgraph is induced, a "
+    "gamma-quasi-clique is connected, and every internal degree is at least "
+    "ceil(gamma*(|H|-1)); the paper restricts gamma to at least 1/2. Section "
+    "2.1 also states that determining whether a quasi-clique is maximal is "
+    "NP-hard. Section 4.5 confirms that checking every one-vertex extension "
+    "is only a necessary maximality condition, so this generator deliberately "
+    "asks for one large quasi-clique rather than falsely certifying maximality. "
+    "Theorem 1 gives FastQC's exponential bound, and Section 6 reports that "
+    "dense graphs weaken degree pruning. The plant is sampled before any "
+    "background edge. It is K_k with a random Hamiltonian cycle deleted, so "
+    "each planted vertex has exactly k-3 neighbors and the certificate follows "
+    "by construction. Cross-edge probability is calibrated to equalize the "
+    "expected total degrees of planted and background vertices. The adversary "
+    "panel tests degree/triangle outliers, greedy growth, 256 randomized "
+    "restarts, a construction-aware complement-cycle swap hill climb, centered "
