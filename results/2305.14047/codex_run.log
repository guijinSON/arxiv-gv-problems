\ifx \CR\undefined
appendix for simplicity).
\else
technical report~\cite{TR} for simplicity).
\fi
%
%\min\{\tau(\omega d), \tau(\omega/\gamma+1)\}=\min\{\lfloor\omega d (1-\gamma)+\gamma \rfloor, \lfloor \omega(1-\gamma)/\gamma +1 \rfloor\}$  
%
%since (1) any branch $B$ has $S$ not empty and thus $\tau(\sigma(B))= \min\{\tau(|S\cup C|),\tau(d_{min}(B)/\gamma+1)\}$ based on Equation~(\ref{eq:fun_sigma}), (2) $|S\cup C|\leq \omega d$ since the size of a graph $G_i$ is bounded by $\omega d$, (3) $d_{min}(B)\leq \omega$ since $S$ must include a vertex $v_i$ ($1\leq i \leq n$) and thus $d_{min}(B)\leq \delta(v_i,S\cup C)\leq \delta(v_i,V_i)\leq \omega$ based on the property of degeneracy ordering, and thus (4) $\tau(\sigma(B))\leq k$.
