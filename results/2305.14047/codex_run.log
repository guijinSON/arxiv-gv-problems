import random,time,sys
sys.setrecursionlimit(10000)

def gen(n,k,seed):
 r=random.Random(seed);H=set(r.sample(range(n),k));hi=list(H);r.shuffle(hi);a=[0]*n
 def e(i,j):a[i]|=1<<j;a[j]|=1<<i
 cyc={tuple(sorted(x)) for x in zip(hi,hi[1:]+hi[:1])}
 for i,x in enumerate(hi):
  for y in hi[i+1:]:
   if tuple(sorted((x,y))) not in cyc:e(x,y)
 di=k-3;qn=n-k-1-2*di;qd=2*(n-2*k);O=[x for x in range(n) if x not in H]
 for i,x in enumerate(O):
  for y in O[i+1:]:
   if r.randrange(2)==0:e(x,y)
 for x in H:
  for y in O:
   if r.randrange(qd)<qn:e(x,y)
 return a,H

def bnb(a,k,r,cap):
 n=len(a);full=(1<<n)-1;nodes=0;sol=None
 deg=[x.bit_count() for x in a]
 def rec(S,C):
  nonlocal nodes,sol
  nodes+=1
  if nodes>cap:return False
  # propagate fixed vertices and infeasible candidates
  while True:
   if S.bit_count()>k or S.bit_count()+C.bit_count()<k:return False
   changed=False
   sm=S
   while sm:
    b=sm&-sm;v=b.bit_length()-1;sm-=b
    bad=((S"'^b)&~a[v]).bit_count()
    if bad>r:return False
    if bad==r:
     nc=C&a[v]
     if nc!=C:C=nc;changed=True
   cm=C;drop=0
   while cm:
    b=cm&-cm;v=b.bit_length()-1;cm-=b
    if (S&~a[v]).bit_count()>r:drop|=b
   if drop:C&=~drop;changed=True
   if not changed:break
  if S.bit_count()==k:sol=[i for i in range(n) if S>>i&1];return True
  if not C:return False
  # choose candidate most connected to current and remaining
  cm=C;best=None;bv=None
  while cm:
   b=cm&-cm;v=b.bit_length()-1;cm-=b
   key=((S&a[v]).bit_count(),(C&a[v]).bit_count(),deg[v])
   if best is None or key>best:best=key;bv=v
  bit=1<<bv
  if rec(S|bit,C''^bit):return True
  return rec(S,C''^bit)
 ok=rec(0,full)
 return ok,nodes,sol
for n in [128,160,192,256]:
 print('"'n',n)
 for cap in [100000,1000000]:
  su=0;nn=[];tt=0
  for seed in range(3):
