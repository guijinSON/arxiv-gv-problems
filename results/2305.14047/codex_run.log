   273	\noindent\textbf{Condition C2.} 
   274	% Recall the definition of QC which 
   275	% % typically depicts the relation between 
   276	% {\cheng essentially imposes a constraint on}
   277	% the degree of each vertex inside {wrt} the size of graph. 
   278	% We can redefine it under SD space in terms of $x$-axis $|H|$ and $y$-axis $\Delta(H)$. 
   279	% In particular, we observe that for those QCs that share the same size $x$ (i.e., $|H|=x$), each of them has the maximum number of disconnections of each vertex at most $\tau(x)$ (i.e., $\Delta(H)\leq \tau(x)$). Here, $\tau(x)$ is a function defined as below.
   280	% \begin{equation}
   281	%     \tau(x)=\lfloor (1-\gamma)\cdot x+\gamma \rfloor.
   282	% \end{equation}
   283	Recall that for a QC $G[H]$, each vertex $v$ in $G[H]$ has the number of its connections within $G[H]$ \emph{at least} $\lceil\gamma \cdot (|H| - 1)\rceil$ by definition, i.e., 
   284	\begin{equation}
   285	\forall v,~~\delta(v, H) \ge \lceil\gamma \cdot (|H| - 1)\rceil
   286	\label{eq:connections} 
   287	\end{equation}
   288	Equivalently, each vertex $v$ has the number of its disconnections within $G[H]$, which is equal to $|H| - \delta(v, H)$, \emph{at most} $|H| - \lceil\gamma \cdot (|H| - 1)\rceil$, i.e., 
   289	\begin{equation}
   290	\forall v,~~\overline{\delta}(v, H) \le |H| - \lceil\gamma \cdot (|H| - 1)\rceil = \lfloor(1-\gamma) \cdot |H| + \gamma\rfloor
   291	\label{eq:disconnections} 
   292	\end{equation}
   293	Equation~(\ref{eq:disconnections}) implies that the maximum number of disconnections of a vertex in $G[H]$ is also \emph{at most} $\lfloor(1-\gamma) \cdot |H| + \gamma\rfloor$, i.e., 
   294	\begin{equation}
   295	\Delta(H) \le \lfloor(1-\gamma) \cdot |H| + \gamma\rfloor
   296	\label{eq:max-disconnections} 
   297	\end{equation}
   298	%
   299	Equation~(\ref{eq:max-disconnections}) essentially says that the point of any QC $G[H]$ in the SD space is \emph{below} the curve representing the following function $\tau(x)$ {\cheng inclusively}.
   300	\begin{equation}
   301	\tau(x) := \lfloor(1-\gamma) \cdot x + \gamma\rfloor
   302	\label{eq:tau-x} 
   303	\end{equation}
   304	% Note that $\Delta(H)$ and $|H|$ Equation~(\ref{eq:max-disconnections}) correspond to the $y$ and $x$ coordinates in the SD space, respectively.
   305	We note that $\tau(x)$ corresponds to a piece-wise {\cheng and non-decreasing} function and each piece is a horizontal line segment with the left endpoint being included and the right endpoint being excluded. An illustration of $\tau(x)$ is in Figure~\ref{fig:SD_Exp1}(b).
   306	%
   307	Based on Equation~(\ref{eq:max-disconnections}) and Equation~(\ref{eq:tau-x}), we deduce the following lemma.
   308	
   309	% Formally, we summarize the observation in the following lemma.
   310	\begin{lemma}
   311	\label{lemma:TD_Property2}
   312	    A graph $G[H]$ {\cheng is} a QC iff  $\Delta(H) \leq \tau (|H|) $.
   313	\end{lemma}
