+            drop = 0
+            while bits:
+                bit = bits & -bits
+                bits -= bit
+                v = bit.bit_length() - 1
+                if (selected & ~adjacency[v]).bit_count() > missing_budget:
+                    drop |= bit
+            if drop:
+                candidates &= ~drop
+                changed = True
+            if not changed:
