+def _spectral_attack(inst, attack_seed, iterations=30):
+    """Centered-adjacency power iteration with three elementary roundings."""
+    adjacency = inst["adjacency"]
+    n, k = inst["n"], inst["k"]
+    density = sum(row.bit_count() for row in adjacency) / (n * (n - 1))
+    rng = random.Random(attack_seed ^ 0x67E2C4D5)
+    vector = [rng.random() - 0.5 for _ in range(n)]
+    mean = sum(vector) / n
+    vector = [value - mean for value in vector]
+    for _ in range(iterations):
+        vector_sum = sum(vector)
+        product = []
+        for v, row in enumerate(adjacency):
+            value = 0.0
+            bits = row
+            while bits:
+                bit = bits & -bits
+                bits -= bit
+                value += vector[bit.bit_length() - 1]
+            product.append(value - density * (vector_sum - vector[v]))
+        mean = sum(product) / n
+        product = [value - mean for value in product]
+        norm = math.sqrt(sum(value * value for value in product))
+        if norm == 0.0:
+            break
+        vector = [value / norm for value in product]
+    orders = [
+        sorted(range(n), key=lambda v: (vector[v], v), reverse=True),
+        sorted(range(n), key=lambda v: (vector[v], v)),
+        sorted(range(n), key=lambda v: (abs(vector[v]), v), reverse=True),
+    ]
+    for order in orders:
+        candidate = sorted(order[:k])
+        if verify(inst, candidate)[0]:
