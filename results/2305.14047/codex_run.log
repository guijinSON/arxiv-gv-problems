+def _threshold_vector(n, q, seed):
+    half_bound = (q - 3) // 2
+    if half_bound == 0:
+        return [0] * (n - 1)
+    code = seed % (half_bound ** (n - 1))
+    thresholds = []
+    for _ in range(n - 1):
+        thresholds.append(1 + code % half_bound)
+        code //= half_bound
+    return thresholds
 
