def _ceil_fraction(num, den):
    return (num + den - 1) // den


def _validate_parameters(n, k):
    if isinstance(n, bool) or not isinstance(n, int):
        raise TypeError("n must be an integer")
    if isinstance(k, bool) or not isinstance(k, int):
        raise TypeError("k must be an integer")
    if k < 5:
        raise ValueError("k must be at least 5 so gamma is at least 1/2")
    if n <= 2 * k:
        raise ValueError("n must be greater than 2*k")
    # The degree-balancing cross probability is positive exactly in this range.
    if n <= 3 * k - 5:
        raise ValueError("n must be greater than 3*k-5")


def _add_edge(adjacency, u, v):
    adjacency[u] |= 1 << v
    adjacency[v] |= 1 << u


def make_instance(n, seed=0, k=21, **params) -> dict:
    """Inverse-generate an exact-size gamma-quasi-clique certificate.

    The answer is sampled first.  Its induced graph is K_k minus a cycle, so
    every witness vertex has internal degree k-3.  All other edges are drawn
    only after the certificate is known.
    """
    if params:
        unknown = ", ".join(sorted(params))
        raise TypeError(f"unknown parameters: {unknown}")
    _validate_parameters(n, k)
    rng = random.Random(seed)

    answer = sorted(rng.sample(range(n), k))
    planted = set(answer)
    cycle = list(answer)
    rng.shuffle(cycle)
    adjacency = [0] * n

    missing_cycle_edges = {
        tuple(sorted((u, v)))
        for u, v in zip(cycle, cycle[1:] + cycle[:1])
    }
    }
    for pos, u in enumerate(answer):
        for v in answer[pos + 1:]:
            if (u, v) not in missing_cycle_edges:
                _add_edge(adjacency, u, v)

    outside = [v for v in range(n) if v not in planted]
    for pos, u in enumerate(outside):
        for v in outside[pos + 1:]:
            if rng.randrange(2) == 0:
                _add_edge(adjacency, u, v)

    # Balance expected total degree.  If p_out=1/2 and d_in=k-3, solve
    # d_in + q(n-k) = p_out(n-k-1) + q*k for q.
    cross_num = n - 3 * k + 5
    cross_den = 2 * (n - 2 * k)
    common = math.gcd(cross_num, cross_den)
    cross_num //= common
    cross_den //= common
    for u in answer:
        for v in outside:
            if rng.randrange(cross_den) < cross_num:
                _add_edge(adjacency, u, v)

    gamma_num = k - 3
    gamma_den = k - 1
    common = math.gcd(gamma_num, gamma_den)
    gamma_num //= common
    gamma_den //= common
    return {
        "n": n,
        "k": k,
        "gamma": [gamma_num, gamma_den],
        "adjacency": adjacency,
        "answer": answer,
    }


def _render_graph(inst):
    n = inst["n"]
    adjacency = inst["adjacency"]
    if n <= 32:
        rows = []
        for v, mask in enumerate(adjacency):
            neighbors = [str(u) for u in range(n) if (mask >> u) & 1]
            rows.append(f"{v}: " + " ".join(neighbors))
        return (
            "Adjacency lists follow; each undirected edge consequently appears "
            "in both endpoint rows:\n" + "\n".join(rows)
        )
    width = (n + 3) // 4
    rows = [f"{v}: {mask:0{width}x}" for v, mask in enumerate(adjacency)]
    return (
        "Adjacency is given by one hexadecimal bit row per vertex. In row v, "
        "the rightmost hexadecimal digit contains bits 0..3, and bit j is 1 "
        "exactly when {v,j} is an edge. Leading zeroes are significant only as "
        "padding; every self-bit is 0 and symmetry is exact.\n" + "\n".join(rows)
    )


def render(inst) -> str:
    """Render a self-contained exact quasi-clique search problem."""
    n = inst["n"]
    k = inst["k"]
    gamma_num, gamma_den = inst["gamma"]
    threshold = _ceil_fraction(gamma_num * (k - 1), gamma_den)
    text = f"""Find a large induced gamma-quasi-clique.

The graph is finite, simple, undirected, and unweighted, with vertices numbered
0 through {n - 1}. For a vertex set H, the induced graph G[H] contains exactly
the edges whose two endpoints both lie in H. Here gamma={gamma_num}/{gamma_den}.
A gamma-quasi-clique H is connected and every vertex of H has at least
ceil(gamma*(|H|-1)) neighbors inside H.

Return exactly {k} distinct vertices. Thus every returned vertex must have at
least ceil(({gamma_num}/{gamma_den})*({k}-1)) = {threshold} neighbors among the
other returned vertices. Vertex order in the answer does not matter. Repeated
or out-of-range indices are invalid. All indexing is 0-based.

{_render_graph(inst)}

Give your final answer inside <answer></answer> tags as exactly {k}
comma-separated decimal vertex indices.
Example format for a five-vertex instance: <answer>0, 3, 7, 8, 11</answer>
Output nothing else inside the tags."""
    mode = os.environ.get("GV_HINT_MODE")
    if mode == "structural":
        text += "\n\nHint: " + STRUCTURAL_HINT
    elif mode == "placebo":
        text += "\n\nHint: " + PLACEBO_HINT
    return text


def parse_answer(text) -> object | None:
    """Parse tagged comma-separated integers, tolerating surrounding prose."""
    if not isinstance(text, str):
        return None
    tagged = re.findall(
        r"<answer\s*>(.*?)</answer\s*>", text, flags=re.IGNORECASE | re.DOTALL
    )
    if tagged:
        body = tagged[-1].strip()
    else:
        fenced = re.findall(r"```(?:json)?\s*(\[[^`]*\])\s*```", text,
                            flags=re.IGNORECASE | re.DOTALL)
        if fenced:
            body = fenced[-1].strip()
        else:
            bracketed = re.findall(r"\[[\s\d,+-]*\]", text)
            if not bracketed:
                return None
            body = bracketed[-1].strip()
    if not body:
        return []
    if body.startswith("["):
        try:
            value = json.loads(body)
        except (ValueError, TypeError):
            return None
        if not isinstance(value, list):
            return None
        if any(isinstance(v, bool) or not isinstance(v, int) for v in value):
            return None
        return value
    parts = [piece.strip() for piece in body.split(",")]
    if not parts or any(not re.fullmatch(r"[+-]?\d+", piece) for piece in parts):
        return None
    try:
        return [int(piece) for piece in parts]
    except ValueError:
        return None


def verify(inst, answer) -> tuple[bool, str]:
    """Verify any exact-size induced gamma-quasi-clique, never the plant."""
    if not isinstance(answer, list):
        return False, "answer must be a list of vertex indices"
    if len(answer) == 0:
        return False, "answer is empty"
    k = inst["k"]
    if len(answer) != k:
        return False, f"wrong size: expected {k} vertices, got {len(answer)}"
    if any(isinstance(v, bool) or not isinstance(v, int) for v in answer):
        return False, "every vertex index must be an integer"
    if len(set(answer)) != len(answer):
        return False, "vertices must be distinct"
    n = inst["n"]
    if any(v < 0 or v >= n for v in answer):
        return False, f"vertex index outside the inclusive range 0..{n - 1}"

    selected = 0
    for v in answer:
        selected |= 1 << v
    gamma_num, gamma_den = inst["gamma"]
    threshold = _ceil_fraction(gamma_num * (k - 1), gamma_den)
    adjacency = inst["adjacency"]
    degrees = [(adjacency[v] & selected).bit_count() for v in answer]
    if min(degrees) < threshold:
        bad = answer[degrees.index(min(degrees))]
        return False, (
            f"induced-degree threshold violated at vertex {bad}: "
            f"degree {min(degrees)} < {threshold}"
        )

    seen = 1 << answer[0]
    frontier = seen
    while frontier:
        neighbors = 0
        bits = frontier
        while bits:
            bit = bits & -bits
            bits -= bit
            neighbors |= adjacency[bit.bit_length() - 1]
        frontier = neighbors & selected & ~seen
        seen |= frontier
    if (seen & selected).bit_count() != k:
        return False, "the induced subgraph is disconnected"
    return True, "ok"


def random_candidate(inst, rng) -> object:
    """Uniformly sample the exact-size subset a statement-aware solver searches."""
    return sorted(rng.sample(range(inst["n"]), inst["k"]))


def search_space(inst) -> int | None:
    return math.comb(inst["n"], inst["k"])


def enumerate_all(inst) -> int | None:
    space = search_space(inst)
    if space is None or space > _ENUMERATION_CAP:
        return None
    count = 0
    for candidate in itertools.combinations(range(inst["n"]), inst["k"]):
        if verify(inst, list(candidate))[0]:
            count += 1
    return count


def _wl_payload(inst):
    """A strong cheap isomorphism invariant, not a full GI canonical form."""
    adjacency = inst["adjacency"]
    n = inst["n"]
    colors = [mask.bit_count() for mask in adjacency]
    for _ in range(4):
        signatures = []
        for v, mask in enumerate(adjacency):
            neighbor_colors = []
            bits = mask
            while bits:
                bit = bits & -bits
                bits -= bit
                neighbor_colors.append(colors[bit.bit_length() - 1])
            signatures.append((colors[v], tuple(sorted(neighbor_colors))))
        palette = {signature: idx for idx, signature in
                   enumerate(sorted(set(signatures)))}
        new_colors = [palette[signature] for signature in signatures]
        if new_colors == colors:
            break
        colors = new_colors

    class_count = max(colors, default=-1) + 1
    sizes = [0] * class_count
    for color in colors:
        sizes[color] += 1
    quotient = [[0] * class_count for _ in range(class_count)]
    for u in range(n):
        bits = adjacency[u] & ~((1 << (u + 1)) - 1)
        while bits:
            bit = bits & -bits
            bits -= bit
            v = bit.bit_length() - 1
            a, b = colors[u], colors[v]
            if a > b:
                a, b = b, a
            quotient[a][b] += 1
    return [n, inst["k"], inst["gamma"], sizes, quotient]


def canonical_key(inst) -> str:
    payload = json.dumps(_wl_payload(inst), separators=(",", ":"),
                         sort_keys=True).encode()
    return hashlib.sha256(payload).hexdigest()


def escalate(params) -> dict | str | None:
    n = params.get("n")
    k = params.get("k", 21)
    if not isinstance(n, int) or not isinstance(k, int):
        return None
    harder = max(n + 1, (3 * n + 1) // 2)
    return {"n": harder, "k": k}


# ---------------------------------------------------------------------------
# Adversarial attacks used by selftest.


def _triangle_scores(adjacency):
    scores = []
    for v, row in enumerate(adjacency):
        total = 0
        bits = row
        while bits:
            bit = bits & -bits
            bits -= bit
            total += (row & adjacency[bit.bit_length() - 1]).bit_count()
        scores.append(total // 2)
    return scores


def _outlier_attack(inst, triangle_scores=None):
    n, k = inst["n"], inst["k"]
    adjacency = inst["adjacency"]
    degrees = [row.bit_count() for row in adjacency]
    triangles = triangle_scores if triangle_scores is not None else _triangle_scores(adjacency)
    cluster = [
        (2 * triangles[v] / (degrees[v] * (degrees[v] - 1)))
        if degrees[v] > 1 else 0.0
        for v in range(n)
    ]
    for values in (degrees, triangles, cluster):
        for reverse in (True, False):
            candidate = sorted(sorted(range(n), key=lambda v: (values[v], v),
                                      reverse=reverse)[:k])
            if verify(inst, candidate)[0]:
                return candidate
    return None


def _greedy_attack(inst, triangle_scores=None):
    n, k = inst["n"], inst["k"]
    adjacency = inst["adjacency"]
    degrees = [row.bit_count() for row in adjacency]
    triangles = triangle_scores if triangle_scores is not None else _triangle_scores(adjacency)
    starts = [
        max(range(n), key=lambda v: (degrees[v], v)),
        max(range(n), key=lambda v: (triangles[v], v)),
        min(range(n), key=lambda v: (degrees[v], v)),
    ]
    ]
    for start in starts:
        chosen = [start]
        mask = 1 << start
        while len(chosen) < k:
            candidates = [v for v in range(n) if not ((mask >> v) & 1)]
            v = max(candidates, key=lambda u: (
                (adjacency[u] & mask).bit_count(), triangles[u], degrees[u], -u
            ))
            chosen.append(v)
            mask |= 1 << v
        candidate = sorted(chosen)
        if verify(inst, candidate)[0]:
            return candidate
    return None


def _random_restart_attack(inst, attack_seed, restarts=256):
    n, k = inst["n"], inst["k"]
    adjacency = inst["adjacency"]
    rng = random.Random(attack_seed ^ 0xA5D36B91)
    degrees = [row.bit_count() for row in adjacency]
    for _ in range(restarts):
        chosen = [rng.randrange(n)]
        mask = 1 << chosen[0]
        while len(chosen) < k:
            scored = []
            best = -1
            for v in range(n):
                if (mask >> v) & 1:
                    continue
                score = (adjacency[v] & mask).bit_count()
                best = max(best, score)
                scored.append((score, v))
            pool = [v for score, v in scored if score >= best - 1]
            # Degree is only a weak tie bias; the restart remains stochastic.
            sample_size = min(12, len(pool))
            sampled = rng.sample(pool, sample_size)
            v = max(sampled, key=lambda u: (degrees[u], rng.random()))
            chosen.append(v)
            mask |= 1 << v
        candidate = sorted(chosen)
        if verify(inst, candidate)[0]:
            return candidate
    return None


def _dense_swap_attack(
    inst,
    attack_seed,
    restarts=_DENSE_SWAP_RESTARTS,
    steps=_DENSE_SWAP_STEPS,
):
    """Strong swap search for a dense k-set, with random two-vertex kicks.

    This construction-aware attack targets exactly the signal introduced by
    planting K_k minus a cycle.  It is deliberately much stronger than a plain
    greedy growth rule: it examines ``restarts * steps`` candidate swaps and
    checks every feasible set it reaches.
    """
    n, k = inst["n"], inst["k"]
    adjacency = inst["adjacency"]
    rng = random.Random(attack_seed ^ 0x91AC7E)
    for _ in range(restarts):
        chosen = set(rng.sample(range(n), k))
        mask = sum(1 << vertex for vertex in chosen)
        edge_count = sum(
            (adjacency[vertex] & mask).bit_count() for vertex in chosen
        ) // 2
        for step in range(steps):
            candidate = sorted(chosen)
            if verify(inst, candidate)[0]:
                return candidate

            degree_pairs = [
                ((adjacency[vertex] & mask).bit_count(), vertex)
                for vertex in chosen
            ]
            least = min(degree for degree, _ in degree_pairs)
            slack = 1 if step % 7 == 6 else 0
            removable = [
                vertex for degree, vertex in degree_pairs
                if degree <= least + slack
            ]
            removed = rng.choice(removable)
            base_mask = mask ^ (1 << removed)
            removed_degree = (adjacency[removed] & base_mask).bit_count()
            best_degree = -1
            best_additions = []
            for vertex in range(n):
                if (base_mask >> vertex) & 1:
                    continue
                degree = (adjacency[vertex] & base_mask).bit_count()
                if degree > best_degree:
                    best_degree = degree
                    best_additions = [vertex]
                elif degree == best_degree:
                    best_additions.append(vertex)
            replacement = rng.choice(best_additions)
            new_edge_count = edge_count - removed_degree + best_degree
            if (new_edge_count > edge_count
                    or (new_edge_count == edge_count and rng.random() < 0.25)):
                chosen.remove(removed)
                chosen.add(replacement)
                mask = base_mask | (1 << replacement)
                edge_count = new_edge_count
            elif step % 10 == 9:
                # Escape dense local optima with a two-vertex perturbation.
                for _ in range(2):
                    kicked = rng.choice(tuple(chosen))
                    chosen.remove(kicked)
                    mask ^= 1 << kicked
                    replacement = rng.choice([
                        vertex for vertex in range(n)
                        if not ((mask >> vertex) & 1)
                    ])
                    chosen.add(replacement)
                    mask |= 1 << replacement
                edge_count = sum(
                    (adjacency[vertex] & mask).bit_count()
                    for vertex in chosen
                ) // 2
        candidate = sorted(chosen)
        if verify(inst, candidate)[0]:
            return candidate
    return None


def _spectral_attack(inst, attack_seed, iterations=30):
    """Centered-adjacency power iteration with three elementary roundings."""
    adjacency = inst["adjacency"]
    n, k = inst["n"], inst["k"]
    density = sum(row.bit_count() for row in adjacency) / (n * (n - 1))
    rng = random.Random(attack_seed ^ 0x67E2C4D5)
    vector = [rng.random() - 0.5 for _ in range(n)]
    mean = sum(vector) / n
    vector = [value - mean for value in vector]
    for _ in range(iterations):
        vector_sum = sum(vector)
        product = []
        for v, row in enumerate(adjacency):
            value = 0.0
            bits = row
            while bits:
                bit = bits & -bits
                bits -= bit
                value += vector[bit.bit_length() - 1]
            product.append(value - density * (vector_sum - vector[v]))
        mean = sum(product) / n
        product = [value - mean for value in product]
        norm = math.sqrt(sum(value * value for value in product))
        if norm == 0.0:
            break
        vector = [value / norm for value in product]
    orders = [
        sorted(range(n), key=lambda v: (vector[v], v), reverse=True),
        sorted(range(n), key=lambda v: (vector[v], v)),
        sorted(range(n), key=lambda v: (abs(vector[v]), v), reverse=True),
    ]
    for order in orders:
        candidate = sorted(order[:k])
        if verify(inst, candidate)[0]:
            return candidate
    return None


def _branch_and_bound_attack(inst, node_cap=_BNB_NODE_CAP):
    """Exact fixed-deficiency search, stopped at a disclosed node budget."""
    adjacency = inst["adjacency"]
    n, k = inst["n"], inst["k"]
    gamma_num, gamma_den = inst["gamma"]
    threshold = _ceil_fraction(gamma_num * (k - 1), gamma_den)
    missing_budget = k - 1 - threshold
    degrees = [row.bit_count() for row in adjacency]
    nodes = 0
    solution = None

    def recurse(selected, candidates):
        nonlocal nodes, solution
        nodes += 1
        if nodes > node_cap:
            return False
        while True:
            selected_size = selected.bit_count()
            if selected_size > k or selected_size + candidates.bit_count() < k:
                return False
            changed = False
            bits = selected
            while bits:
                bit = bits & -bits
                bits -= bit
                v = bit.bit_length() - 1
                missing = ((selected ^ bit) & ~adjacency[v]).bit_count()
                if missing > missing_budget:
                    return False
                if missing == missing_budget:
                    reduced = candidates & adjacency[v]
                    if reduced != candidates:
                        candidates = reduced
                        changed = True
            bits = candidates
            drop = 0
            while bits:
                bit = bits & -bits
                bits -= bit
                v = bit.bit_length() - 1
                if (selected & ~adjacency[v]).bit_count() > missing_budget:
                    drop |= bit
            if drop:
                candidates &= ~drop
                changed = True
            if not changed:
                break

        if selected.bit_count() == k:
            solution = [v for v in range(n) if (selected >> v) & 1]
            return True
        if not candidates:
            return False
        bits = candidates
        best_key = None
        pivot = None
        while bits:
            bit = bits & -bits
            bits -= bit
            v = bit.bit_length() - 1
            key = ((adjacency[v] & selected).bit_count(),
                   (adjacency[v] & candidates).bit_count(), degrees[v], -v)
            if best_key is None or key > best_key:
                best_key, pivot = key, v
        pivot_bit = 1 << pivot
        if recurse(selected | pivot_bit, candidates ^ pivot_bit):
            return True
        return recurse(selected, candidates ^ pivot_bit)

    solved = recurse(0, (1 << n) - 1)
    return solution if solved else None, nodes, nodes > node_cap


def _relabel_instance(inst, old_to_new):
    n = inst["n"]
    if sorted(old_to_new) != list(range(n)):
        raise ValueError("old_to_new must be a permutation")
    adjacency = [0] * n
    for old_u, row in enumerate(inst["adjacency"]):
        new_u = old_to_new[old_u]
        bits = row
        while bits:
            bit = bits & -bits
            bits -= bit
            old_v = bit.bit_length() - 1
            adjacency[new_u] |= 1 << old_to_new[old_v]
    return {
        "n": n,
        "k": inst["k"],
        "gamma": list(inst["gamma"]),
        "adjacency": adjacency,
        "answer": sorted(old_to_new[v] for v in inst["answer"]),
    }


def _atomic_elements(value):
    if isinstance(value, dict):
        return sum(_atomic_elements(item) for item in value.values())
    if isinstance(value, (list, tuple)):
        return sum(_atomic_elements(item) for item in value)
    return 1


def selftest() -> dict:
    report = {}
    failures = []
    json_roundtrips = 0
    for preset, params in DIFFICULTY.items():
        for seed in (0, 1, 17):
            inst = make_instance(seed=seed, **params)
            ok, reason = verify(inst, inst["answer"])
            if not ok:
                failures.append({"preset": preset, "seed": seed,
                                 "reason": reason})
            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
                json_roundtrips += 1
    report["G1_planted_verifies"] = {
        "pass": not failures and json_roundtrips == 12,
        "attempts": 12,
        "failures": failures,
        "json_roundtrips": json_roundtrips,
    }

    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
    inst = make_instance(seed=101, **shipping_params)
    answer = list(inst["answer"])
    outside = next(v for v in range(inst["n"]) if v not in set(answer))
    swapped = list(answer)
    swapped[0] = outside
    corruptions = {
        "drop": answer[:-1],
        "swap_one": swapped,
        "duplicate": answer[:-1] + [answer[0]],
        "empty": [],
        "out_of_range": answer[:-1] + [inst["n"]],
    }
    cases = {}
    reasons = []
    for name, candidate in corruptions.items():
        ok, reason = verify(inst, candidate)
        cases[name] = {"rejected": not ok, "reason": reason}
        reasons.append(reason)
    report["G2_rejects_corruption"] = {
        "pass": all(case["rejected"] for case in cases.values())
        and len(set(reasons)) == len(reasons),
        "cases": cases,
        "distinct_reasons": len(set(reasons)),
    }

    model_response = (
        "I checked the induced degrees carefully.\n```text\n"
        "Final result follows.\n```\n<answer>"
        + ", ".join(map(str, answer)) + "</answer>\n"
    )
    parsed = parse_answer(model_response)
    report["G3_round_trip"] = {
        "pass": parsed == answer and parse_answer("no usable witness here") is None,
        "parsed_matches": parsed == answer,
        "garbage_returns_none": parse_answer("no usable witness here") is None,
    }

    guess_rng = random.Random(0x230514047)
    guess_total = 200_000
    guess_hits = 0
    for _ in range(guess_total):
        if verify(inst, random_candidate(inst, guess_rng))[0]:
            guess_hits += 1
    space = search_space(inst)
    report["G4_guess_resistance"] = {
        "pass": guess_hits / guess_total < 1e-6,
        "hits": guess_hits,
        "total": guess_total,
        "observed_probability": guess_hits / guess_total,
        "structure_aware_space": space,
        "sampler": "uniform over all exactly-k distinct vertex subsets",
    }

    demo = make_instance(seed=0, **DIFFICULTY["demo"])
    demo_count = enumerate_all(demo)

    attack_names = (
        "outlier_degree_triangle",
        "greedy_dense_growth",
        "random_restart_256",
        "dense_swap_256x60",
        "spectral_centered_power",
        "fixed_deficiency_bnb_250k",
    )
    attack_successes = {name: 0 for name in attack_names}
    bnb_nodes = []
    bnb_times = []
    attack_attempts = 8
    for seed in range(attack_attempts):
        attacked = make_instance(seed=10_000 + seed, **shipping_params)
        triangles = _triangle_scores(attacked["adjacency"])
        if _outlier_attack(attacked, triangles) is not None:
            attack_successes["outlier_degree_triangle"] += 1
        if _greedy_attack(attacked, triangles) is not None:
            attack_successes["greedy_dense_growth"] += 1
        if _random_restart_attack(attacked, seed) is not None:
            attack_successes["random_restart_256"] += 1
        if _dense_swap_attack(attacked, seed) is not None:
            attack_successes["dense_swap_256x60"] += 1
        if _spectral_attack(attacked, seed) is not None:
            attack_successes["spectral_centered_power"] += 1
        started = time.perf_counter()
        candidate, nodes, capped = _branch_and_bound_attack(attacked)
        bnb_times.append(time.perf_counter() - started)
        bnb_nodes.append(nodes)
        if candidate is not None and verify(attacked, candidate)[0]:
            attack_successes["fixed_deficiency_bnb_250k"] += 1

    median_nodes = int(statistics.median(bnb_nodes))
    median_wall = statistics.median(bnb_times)
    report["G5_density_and_baseline"] = {
        "pass": isinstance(demo_count, int) and demo_count > 0,
        "shipping_density_hits": guess_hits,
        "shipping_density_samples": guess_total,
        "shipping_sampled_solution_fraction": guess_hits / guess_total,
        "shipping_certificate_space": space,
        "demo_exact_solution_count": demo_count,
        "demo_n": demo["n"],
        "strongest_attack": "exact fixed-deficiency branch-and-bound",
        "baseline_node_cap": _BNB_NODE_CAP,
        "baseline_median_nodes": median_nodes,
        "baseline_median_wall_seconds": median_wall,
        "baseline_seed_times_seconds": bnb_times,
    }
    attacks = {
        name: {"successes": attack_successes[name], "attempts": attack_attempts}
        for name in attack_names
    }
    report["G6_adversary_panel"] = {
        "pass": all(result["successes"] == 0 for result in attacks.values()),
        "attacks": attacks,
        "standard_algorithm": {
            "name": "exact fixed-deficiency branch-and-bound",
            "node_cap_per_instance": _BNB_NODE_CAP,
            "median_nodes": median_nodes,
            "median_wall_clock_sec": median_wall,
            "capped_runs": sum(nodes > _BNB_NODE_CAP for nodes in bnb_nodes),
        },
        "paper_reference_algorithm_external": _OFFICIAL_DCFASTQC_BENCHMARK,
        "stronger_local_search_external": _STRONGER_DENSE_SWAP_BENCHMARK,
    }

    doubled_params = dict(shipping_params)
    doubled_params["n"] *= 2
    doubled = make_instance(seed=2026, **doubled_params)
    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
    report["G7_scales"] = {
        "pass": doubled_ok and search_space(doubled) > space,
        "shipping_n": inst["n"],
        "doubled_n": doubled["n"],
        "shipping_space_bits": space.bit_length(),
        "doubled_space_bits": search_space(doubled).bit_length(),
        "doubled_verify_reason": doubled_reason,
    }

    invariance_checks = 0
    carried_checks = 0
    # Relabelling a random dense graph is graph-isomorphism-hard in general.
    # Exercise the same generator and all family symmetries at a smaller valid
    # n so this mandatory structural test does not dominate selftest runtime.
    canonical_params = {"n": 128, "k": 21}
    for seed in range(20):
        original = make_instance(seed=30_000 + seed, **canonical_params)
        base_key = canonical_key(original)
        n = original["n"]
        rng = random.Random(40_000 + seed)
        random_perm = list(range(n))
        rng.shuffle(random_perm)
        reverse_perm = list(reversed(range(n)))
        shift = 1 + seed % (n - 1)
        shift_perm = [(v + shift) % n for v in range(n)]
        composed = [reverse_perm[random_perm[v]] for v in range(n)]
        for permutation in (random_perm, reverse_perm, shift_perm, composed):
            transformed = _relabel_instance(original, permutation)
            invariance_checks += canonical_key(transformed) == base_key
            carried_checks += verify(transformed, transformed["answer"])[0]
    unrelated_keys = {
        canonical_key(make_instance(seed=50_000 + seed, **canonical_params))
        for seed in range(20)
    }
    report["G8_canonical_key"] = {
        "pass": invariance_checks == 80 and carried_checks == 80
        and len(unrelated_keys) == 20,
        "invariance_checks": invariance_checks,
        "carried_witness_checks": carried_checks,
        "unrelated_attempts": 20,
        "unrelated_distinct": len(unrelated_keys),
        "test_parameters": canonical_params,
        "transformations": [
            "arbitrary random vertex permutation",
            "vertex-order reversal",
            "cyclic vertex renumbering",
            "composed random permutation and reversal",
        ],
        "key_basis": "four-round 1-WL color quotient with class edge counts",
    }

    compact_answer = json.dumps(inst["answer"], separators=(",", ":"))
    answer_chars = len(compact_answer)
    answer_elements = _atomic_elements(inst["answer"])
    answer_tokens = math.ceil(answer_chars / 4)
    intended_ops = math.comb(inst["k"], 2) + 3 * inst["k"]
    arms = G9_RESULTS["arms"]
    hinted_attempts = arms["hinted"]["attempts"]
    placebo_attempts = arms["placebo"]["attempts"]
    hinted_rate = arms["hinted"]["solved"] / hinted_attempts if hinted_attempts else 0.0
    placebo_rate = arms["placebo"]["solved"] / placebo_attempts if placebo_attempts else 0.0
    within_caps = (answer_chars <= 2000 and answer_elements <= 256
                   and intended_ops <= 300)
    report["G9_no_tool_suitability"] = {
        "pass": within_caps,
        "arms": arms,
        "hinted_minus_placebo": hinted_rate - placebo_rate,
        "hinted_verdict": G9_RESULTS["hinted_verdict"],
        "answer_chars": answer_chars,
        "answer_tokens": answer_tokens,
        "answer_elements": answer_elements,
        "intended_route_operations": intended_ops,
        "operation_definition": (
            "one complement-edge inspection, degree comparison, or connectivity step"
        ),
    }

    report["all_passed"] = all(
        value.get("pass", False) for key, value in report.items()
        if key.startswith("G")
    )
    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
    report["track"] = TRACK
    return report


if __name__ == "__main__":
    print(json.dumps(selftest(), indent=2, sort_keys=True))

