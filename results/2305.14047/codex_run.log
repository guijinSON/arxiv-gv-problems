+def _mechanical_reference(inst):
+    """Solve one constraint, then enumerate its normalized projective points.
+
+    This is the measured mechanical route.  It uses no planted polynomial
+    pattern: after fixing direction[0]=1, it enumerates the middle coordinates
+    and solves the first displayed linear equation for the final coordinate.
+    The construction guarantees the sought direction has this normalization.
+    """
+    q, n = inst["q"], inst["n"]
+    first = inst["constraints"][0]
+    inverse_last = pow(first[-1], -1, q)
+    candidates = 0
+    operations = 0
+    for middle in itertools.product(range(q), repeat=n - 2):
+        prefix = (1,) + middle
+        partial = 0
+        for coefficient, value in zip(first[:-1], prefix):
+            partial = (partial + coefficient * value) % q
+            operations += 2
+        last = -partial * inverse_last % q
+        operations += 1
+        direction = list(prefix) + [last]
+        candidates += 1
+        survives = True
+        for row in inst["constraints"][1:]:
+            value = 0
+            for coefficient, coordinate in zip(row, direction):
+                value = (value + coefficient * coordinate) % q
+                operations += 2
+            if value:
+                survives = False
+                break
+        if survives:
+            answer = [[0] * n, direction]
+            if verify(inst, answer)[0]:
+                return answer, operations, candidates
+    return None, operations, candidates
 
 
