   966	\begin{algorithm}[t]
   967	\small
   968	\caption{{\cheng A new branch-and-bound algorithm}: \texttt{FastQC}}
   969	\label{alg:FastQC}
   970	\KwIn{A graph $G=(V,E)$, $0.5 \leq \gamma\leq 1$, and $\theta>0$}
   971	% \KwOut{A superset of {\CHENG the set containing} all MQCs}
   972	\KwOut{{\chengrr A set of QCs that includes} all MQCs}
   973	\texttt{FastQC-Rec}$(\emptyset,V,\emptyset)$;\\
   974	%\setcounter{AlgoLine}{0}
   975	\SetKwBlock{Enum}{Procedure \texttt{FastQC-Rec}$(S,C,D)$}{}
   976	%\SetKwBlock{update}{Procedure \texttt{Update}$(S,C)$}{}
   977	\Enum{
   978	    \tcc{Progressively refining\&re-checking (Sec.~\ref{subsec:progressively_RR})}
   979	    \Repeat{no vertices can be removed from the candidate set $C$}{
   980	        %$(|H_u(B)|,k_u(B))\leftarrow$ compute according to Lemma~\ref{lemma:tight_bound}\;
   981	        \If{$\Delta(S)>\tau(\sigma(B))$ (Condition C1\&C2 is not satisfied)}{\textbf{return} false\;}
   982	        Refine $B$ via Refinement Rule (1) and (2)\;
