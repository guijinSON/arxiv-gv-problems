+        return [1, 0]
+    while True:
+        coefficients = [1]
+        coefficients.extend(rng.randrange(q) for _ in range(length - 2))
+        coefficients.append(rng.randrange(1, q))
+        if all(_poly_eval(coefficients, value, q) != 0
