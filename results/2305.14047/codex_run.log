import importlib.util,json,pathlib,re,random
p=pathlib.Path('gen_2305_14047.py')
s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
for preset,params in g.DIFFICULTY.items():
 for seed in (0,1,17):
  inst=g.make_instance(seed=seed,**params)
  assert g.verify(inst,inst['answer'])==(True,'ok')
  assert json.loads(json.dumps(inst['answer']))==inst['answer']
ship=g.make_instance(seed=101,**g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
for solver in (g._mechanical_reference,g._root_reference):
 ans,ops,_=solver(ship); assert g.verify(ship,ans)==(True,'ok'); print(solver.__name__,ops)
raw='<answer>'+json.dumps(ship['answer'],separators=(',',':'))+'</answer>'
assert g.parse_answer('prose\\n"'```json'"\\n'+raw+'\\n"'```'"')==ship['answer']
readme=pathlib.Path('README.md').read_text()
block=re.search(r'"'```text'"\\n(.*?)\\n"'```'"',readme,re.S).group(1)
demo=g.render(g.make_instance(seed=0,**g.DIFFICULTY['demo']))
print('demo_render_exact', block==demo)
if block"'!=demo:
 import difflib
 print('"''.join(difflib.unified_diff(block.splitlines(True),demo.splitlines(True))))
report=json.load(open('selftest_report.json'))
assert report['all_passed'] and all(v['pass'] for k,v in report.items() if k.startswith('G'))
for name in ['llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl']:
 rows=[json.loads(x) for x in open(name) if x.strip()]
 assert len(rows)==4 and all(x['http_status']==403 and x['error'] for x in rows)
 print(name,sorted({x['model'] for x in rows}))
print('final targeted checks passed')
