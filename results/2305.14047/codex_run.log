+            if row == column:
+                continue
+            factor = augmented[row][column] % q
+            if factor:
+                augmented[row] = [(value - factor * source) % q
+                                  for value, source in
+                                  zip(augmented[row], augmented[column])]
+    return [row[size:] for row in augmented]
