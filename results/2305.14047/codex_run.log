+def _invert_matrix(matrix, q):
+    """Gauss-Jordan inverse used only to carry G8 relabellings."""
+    size = len(matrix)
+    augmented = [list(row) + [1 if i == j else 0 for j in range(size)]
+                 for i, row in enumerate(matrix)]
+    for column in range(size):
