+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "constraint propagation",
+    "intuition_description": (
+        "Use the paper's disconnection view: at the shipping threshold every "
+        "chosen vertex has at most two non-neighbors, while an unguided solver "
+        "must search an enormous family of vertex subsets."
+    ),
+    "hardness_basis": (
+        "Track A: Section 2.1 states NP-hardness and Theorem 1 gives FastQC "
+        "time O(n*d*alpha_k^n); in the generated gamma=9/10, theta=21, "
+        "dense degree-balanced n=384 regime, a 250000-node FastQC-style exact "
+        "branch-and-bound search is capped after a measured median 2.84 seconds "
