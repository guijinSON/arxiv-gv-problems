+    if isinstance(q, bool) or not isinstance(q, int):
+        raise TypeError("q must be an integer prime")
+    if n < 2:
+        raise ValueError("n must be at least 2")
+    if q < 3 or q % 2 == 0 or not _is_prime(q):
+        raise ValueError("q must be an odd prime")
