+def _transformed_difference(inst, difference):
+    q = inst["q"]
+    leading = _dot(inst["leading_form"], difference, q)
+    syndrome = [_dot(row, difference, q)
+                for row in inst["constraints"]]
+    return leading, syndrome
+
