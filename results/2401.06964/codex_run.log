   573	def _recover_center_scale(inst, spec):
   574	    prime = inst["p"]
   575	    k = inst["k"]
   576	    s1, s2, s3 = inst["moments"][:3]
   577	    center = s1 * pow(k, -1, prime) % prime
   578	    center2 = center * center % prime
   579	    center3 = center2 * center % prime
   580	    t2 = (s2 - 2 * center * s1 + k * center2) % prime
   581	    t3 = (s3 - 3 * center * s2 + 3 * center2 * s1 - k * center3) % prime
   582	    c2, c3 = _template_constants(spec, prime)
   583	    denominator = t2 * c3 % prime
   584	    if not denominator:
   585	        return None
   586	    scale = t3 * c2 * pow(denominator, -1, prime) % prime
   587	    return center, scale
