+        "pass": verify(doubled, doubled["answer"])[0]
+        and verify(escalated, escalated["answer"])[0]
+        and doubled["p"] > inst["p"]
+        and len(doubled["answer"]) == len(inst["answer"]),
+        "shipping_n": shipping_params["n"],
+        "shipping_field_p": inst["p"],
