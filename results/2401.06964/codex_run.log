   499	def canonical_key(inst):
   500	    """Affine-invariant key from the complete normalized moment sequence."""
   501	    prime = inst["p"]
   502	    _center, centered = _centered_moments(inst)
   503	    z2, z3 = centered[2], centered[3]
   504	    if z2 and z3:
   505	        inverse_scale = z2 * pow(z3, -1, prime) % prime
   506	        invariant = [
   507	            centered[degree] * pow(inverse_scale, degree, prime) % prime
   508	            for degree in range(2, inst["k"] + 1)
   509	        ]
   510	        payload = [prime, inst["k"], invariant]
   511	    else:
   512	        # Generated instances never use this branch.  It remains deterministic
   513	        # and avoids pretending a singular normalization is affine-complete.
   514	        payload = [prime, inst["k"], "singular", centered[2:]]
   515	    blob = json.dumps(payload, separators=(",", ":"))
   516	    return hashlib.sha256(blob.encode("ascii")).hexdigest()
