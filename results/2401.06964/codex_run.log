+    swapped = list(answer)
+    swapped[0] = replacement
+    duplicated = list(answer)
+    duplicated[-1] = duplicated[0]
+    corruptions = {
+        "drop_one": answer[:-1],
+        "swap_one": swapped,
+        "duplicate_one": duplicated,
