-    prime = inst["p"]
-    k = inst["k"]
-    rows = "\n".join(
-        f"  i={degree}: b_i={target}"
-        for degree, target in zip(inst["exponents"], inst["moments"])
-    )
-    text = f"""Moment subset sum over a prime field
