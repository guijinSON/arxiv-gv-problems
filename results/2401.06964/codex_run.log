-_TEMPLATES = {
-    "demo": ((8, 1), (4, -2)),
-    "two": ((16, 1), (8, -2)),
-    "three": ((8, 1), (8, 2), (8, -3)),
-    "six": ((4, 1), (4, 2), (4, 3), (4, 4), (4, 5), (4, -15)),
