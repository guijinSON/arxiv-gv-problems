   482	def _centered_moments(inst):
   483	    prime = inst["p"]
   484	    k = inst["k"]
   485	    raw = [k] + list(inst["moments"])
   486	    center = raw[1] * pow(k, -1, prime) % prime
   487	    centered = [k, 0]
   488	    for degree in range(2, k + 1):
   489	        value = sum(
   490	            math.comb(degree, power)
   491	            * pow(-center, degree - power, prime)
   492	            * raw[power]
   493	            for power in range(degree + 1)
   494	        ) % prime
   495	        centered.append(value)
   496	    return center, centered
