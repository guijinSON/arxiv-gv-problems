   461	def search_space(inst):
   462	    """Number of k-subsets with the prescribed first moment."""
   463	    # Translation by t adds k*t to the subset sum.  Since k<p, multiplication
   464	    # by k permutes F_p, so the p possible sums receive equal-sized fibres.
   465	    return math.comb(inst["p"], inst["k"]) // inst["p"]
