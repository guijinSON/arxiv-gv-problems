+        for key in ("bare", "hinted", "placebo")
+    }
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    difference = None
+    if hinted["attempts"] and placebo["attempts"]:
+        difference = (
+            hinted["solved"] / hinted["attempts"]
+            - placebo["solved"] / placebo["attempts"]
