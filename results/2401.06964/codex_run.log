+    ),
+)
+try:
+    from gvlib import exact_matrices, rationals
+except ImportError:  # The finite-field implementation below is stdlib-only.
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "number_theory",
