+DIFFICULTY = {
+    "demo": {"n": 97, "template": "demo"},
+    "easy": {"n": 12_289, "template": "two"},
+    "medium": {"n": 65_537, "template": "three"},
+    "hard": {"n": 786_433, "template": "six"},
+}
