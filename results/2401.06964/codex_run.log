+
+# Filled from the harness-owned transcripts after the three arms run.
+G9_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "blocked_external_openrouter_403",
