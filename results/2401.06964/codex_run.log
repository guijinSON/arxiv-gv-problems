%& \geq \sum_{i=0}^{\lfloor \frac{k}{p}\rfloor} \, \, \sum_{\underset{\tau\in D_k(i,l+i)}{1 \leq l \leq 2m}} (-1)^{k-l}C(\tau) q^{l-m}  -q^m k! \\ \notag
%=& \sum_{i=0}^{\lfloor \frac{k}{p}\rfloor} \frac{(-1)^i}{q^i}\, \, \sum_{\underset{\tau\in D_k(i,j)}{i+1 \leq j \leq 2m+i}} (-1)^{k-j}C(\tau) q^{j-m} -q^m k! \\ \notag
%& \geq -\sum_{i=0}^{\lfloor \frac{k}{p}\rfloor} \sum_{\underset{\tau\in D_k(i,j)}{i+1 \leq j \leq 2m+i}} (-1)^{k-j} C(\tau)q^{j-m}-2d_m q^m k!.
