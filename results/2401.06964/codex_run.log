+        "A k-element subset of F_p, serialized as a comma-separated list of k "
+        "distinct canonical residues in 0..p-1; order is immaterial."
+    ),
+    "bounds": {
+        "elements": "k",
+        "entry_min": 0,
+        "entry_max": "p-1",
+        "distinct": True,
+        "candidate_count": "binomial(p,k)",
