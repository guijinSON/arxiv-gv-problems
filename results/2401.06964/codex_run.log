+    candidate = n + ((1 - n) % 16)
+    if candidate < n:
+        candidate += 16
+    while not _is_prime(candidate):
+        candidate += 16
+    if candidate not in _FIELD_CACHE:
+        _FIELD_CACHE[candidate] = _primitive_root(candidate)
+    return candidate, _FIELD_CACHE[candidate]
