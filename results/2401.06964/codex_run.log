   420	def verify(inst, answer):
   421	    """Check any submitted subset directly; never consult inst['answer']."""
   422	    if answer is None or answer == []:
   423	        return False, "answer is empty"
   424	    if not isinstance(answer, list):
   425	        return False, "answer must be a list of integers"
   426	    if len(answer) != inst["k"]:
   427	        return False, f"expected exactly {inst['k']} elements"
   428	    if any(not _is_int(value) for value in answer):
   429	        return False, "every element must be an integer"
   430	    prime = inst["p"]
   431	    if any(value < 0 or value >= prime for value in answer):
   432	        return False, f"an element lies outside 0..{prime - 1}"
   433	    if len(set(answer)) != len(answer):
   434	        return False, "elements must be distinct"
   435	    for degree, target in zip(inst["exponents"], inst["moments"]):
   436	        observed = sum(pow(value, degree, prime) for value in answer) % prime
   437	        if observed != target:
   438	            return False, f"moment {degree} mismatch: got {observed}, expected {target}"
   439	    return True, "ok"
