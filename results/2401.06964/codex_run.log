+        "doubled_build_seconds": round(doubled_build, 6),
+        "answer_atoms_before": _answer_atoms(inst["answer"]),
+        "answer_atoms_after": _answer_atoms(doubled["answer"]),
+        "fixed_answer_escalation": harder,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    key_failures = []
+    unrelated_keys = []
+    deterministic_keys = 0
