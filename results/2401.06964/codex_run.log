   534	def _newton_root_scan(inst):
   535	    """Reference solver: Newton identities, then exhaustive root evaluation."""
   536	    prime = inst["p"]
   537	    k = inst["k"]
   538	    powers = [0] + list(inst["moments"])
   539	    elementary = [1]
   540	    operations = 0
   541	    for degree in range(1, k + 1):
   542	        total = 0
   543	        for power in range(1, degree + 1):
   544	            term = elementary[degree - power] * powers[power]
   545	            total += term if power % 2 else -term
   546	            operations += 2
   547	        elementary.append(total * pow(degree, -1, prime) % prime)
   548	        operations += 1
   549	    coefficients = [1]
   550	    for degree in range(1, k + 1):
   551	        coefficients.append(((-1) ** degree * elementary[degree]) % prime)
   552	    roots = []
   553	    for value in range(prime):
   554	        evaluated = coefficients[0]
   555	        for coefficient in coefficients[1:]:
   556	            evaluated = (evaluated * value + coefficient) % prime
   557	            operations += 2
   558	        if evaluated == 0:
   559	            roots.append(value)
   560	    return roots, {
   561	        "operations": operations,
   562	        "field_elements_scanned": prime,
   563	        "newton_convolution_terms": k * (k + 1) // 2,
   564	    }
