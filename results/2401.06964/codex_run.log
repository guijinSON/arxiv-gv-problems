   442	def random_candidate(inst, rng):
   443	    """Uniformly sample k-subsets already satisfying the first moment.
   444	
   445	    Draw k-1 distinct residues and force the last.  Conditional on the forced
   446	    residue being new, every valid unordered subset has exactly k! preimages,
   447	    so rejection sampling is uniform over the structure-aware language.
   448	    """
   449	    if not isinstance(rng, random.Random):
   450	        raise TypeError("rng must be random.Random")
   451	    prime = inst["p"]
   452	    count = inst["k"] - 1
   453	    target = inst["moments"][0]
   454	    while True:
   455	        prefix = rng.sample(range(prime), count)
   456	        final = (target - sum(prefix)) % prime
   457	        if final not in prefix:
   458	            return sorted(prefix + [final])
