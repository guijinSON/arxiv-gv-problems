+        "answer_atoms_after": _answer_atoms(doubled["answer"]),
+        "fixed_answer_escalation": harder,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    key_failures = []
+    unrelated_keys = []
+    deterministic_keys = 0
+    for seed in range(20):
