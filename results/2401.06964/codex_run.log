+    if recovered is None:
+        return None
+    center, scale = recovered
+    prime = inst["p"]
+    values = []
+    for order, shift in spec:
+        origin = (center + shift * scale) % prime
+        values.extend((origin + offset) % prime for offset in range(order))
+    if len(set(values)) != inst["k"]:
+        return None
+    return sorted(values)
