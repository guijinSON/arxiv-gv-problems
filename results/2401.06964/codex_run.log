   468	def enumerate_all(inst):
   469	    """Brute-force count only when the actual candidate space is safely tiny."""
   470	    space = search_space(inst)
   471	    if space > 100_000:
   472	        return None
   473	    # No named preset reaches this branch, but it keeps the API exact for any
   474	    # future genuinely small supported field.
   475	    import itertools
   476	    return sum(
   477	        verify(inst, list(candidate))[0]
   478	        for candidate in itertools.combinations(range(inst["p"]), inst["k"])
