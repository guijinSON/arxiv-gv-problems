+def random_candidate(inst, rng):
+    """Sample uniformly from the obvious language of k-subsets of F_p."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be random.Random")
+    return sorted(rng.sample(range(inst["p"]), inst["k"]))
