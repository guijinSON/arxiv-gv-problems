+    "computational_core": "subset_sum",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "prime finite field F_p",
+        "power-moment vector over F_p",
+        "k-element subset of F_p",
+    ],
+    "verification_operations": [
