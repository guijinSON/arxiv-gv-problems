+    # case for 48 rows of 63-bit values.
+    answer_tokens = (sum(math.ceil(len(str(row[0])) / 3) + 1
+                         for row in inst["answer"])
+                     + 2 * inst["k"] + 1)
     answer_elements = _atoms(inst["answer"])
     intended_operations = 3 * inst["k"]
     arms = {
