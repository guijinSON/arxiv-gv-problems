+        keys.append(base_key)
+
+        reversed_inst = dict(base)
+        reversed_inst["entries"] = list(reversed(base["entries"]))
+        reversed_inst["answer"] = list(reversed(base["answer"]))
+
+        conjugated = dict(base)
+        conjugated["entries"] = [
