+def selftest() -> dict:
+    report: dict = {}
+
+    # G1: all named rungs, several seeds, JSON-native answers.
+    failures = []
+    checks = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 19):
+            inst = make_instance(seed=seed, **params)
+            checks += 1
+            ok, why = verify(inst, inst["answer"])
+            if not ok:
+                failures.append(f"{preset}/seed={seed}: {why}")
