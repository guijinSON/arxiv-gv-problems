def escalate(params: dict) -> dict | str | None:
    n = int(params["n"])
    k = int(params.get("k", 32))
    if n < 126:
        return {"n": min(126, max(n + 3, n * 2)), "k": k}
    if k < 64:
        return {"n": n, "k": min(64, k + 8)}
    return "cap_bound"


