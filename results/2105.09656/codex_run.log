+    corruptions["swap_two"] = swapped
+    duplicated = json.loads(json.dumps(planted))
+    duplicated[plus_i] = list(duplicated[minus_i])
+    corruptions["duplicate_one"] = duplicated
+    corruptions["empty"] = []
+    outside = json.loads(json.dumps(planted))
