        reference_seconds += time.perf_counter() - t0
        reference_successes += int(verify(attack_inst, ref)[0])
    attacks = {
        name: {"successes": successes, "attempts": attempts}
        for name, successes in attack_counts.items()
    }
    report["G6_adversary_panel"] = {
        "pass": all(v["successes"] == 0 for v in attacks.values()),
        "attacks": attacks,
        "reference_algorithm": {
            "name": "left-to-right binary exponentiation in each quadratic field",
            "complexity": "O(k log p) exact F_(p^2) multiplications",
            "wall_clock_sec": reference_seconds,
            "mean_wall_clock_sec": reference_seconds / attempts,
            "operations": reference_counter.exact_operations,
            "field_multiplications": reference_counter.field_multiplications,
            "mean_exact_operations": reference_counter.exact_operations // attempts,
            "solves": f"{reference_successes}/{attempts}, as expected",
        },
    }

    # G7: n increases hardness up to the deterministic 63-bit primality ceiling.
    # At that ceiling, double total size through the independent batch dimension.
    lower_n = max(4, shipping_params["n"] // 2)
    lower = make_instance(n=lower_n, k=shipping_params["k"], seed=76)
    lower_ok, lower_why = verify(lower, lower["answer"])
    doubled_k = min(96, shipping_params["k"] * 2)
    doubled = make_instance(n=shipping_params["n"], k=doubled_k, seed=77)
    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
    report["G7_scales"] = {
        "pass": (lower_ok and doubled_ok
                 and lower_n < shipping_params["n"]
                 and doubled["k"] == 2 * inst["k"]),
        "lower_n": lower_n,
        "lower_verify": lower_why,
        "shipping_n": shipping_params["n"],
        "doubled_n": doubled["n"],
        "base_rows": inst["k"],
        "doubled_rows": doubled["k"],
        "doubled_verify": doubled_why,
        "reference_exponent_bit_growth": shipping_params["n"] / lower_n,
        "total_batch_growth": doubled["k"] / inst["k"],
    }

