+def _theorem_sign(p: int) -> int:
+    """Proposition 4.8: return the integer representative +1 or -1."""
+    residue = p % 16
+    if residue == 13:
+        return 1
+    if residue == 5:
+        return -1
+    raise ValueError("Proposition 4.8 applies only for p == 5 or 13 (mod 16)")
