+    "hardness_basis": (
+        "Track B: binary exponentiation evaluates the batch in O(k log p) "
+        "quadratic-field multiplications; at the shipping preset the exact "
+        "reference cost and wall time are measured by selftest, whereas the "
+        "Appendix-A residue invariant reduces the route to at most 3k exact "
+        "residue and affine operations, which fits in context only if the "
+        "invariant is found."
+    ),
+    "max_answer_tokens": 300,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON matrix with exactly k rows [a,b]; row i is an arbitrary "
+        "element a+bH of F_{p_i^2}, with 0 <= a,b < p_i."
