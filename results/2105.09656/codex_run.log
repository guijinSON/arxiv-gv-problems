+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                failures.append(f"{preset}/seed={seed}: answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": not failures, "checks": checks, "failures": failures,
+    }
