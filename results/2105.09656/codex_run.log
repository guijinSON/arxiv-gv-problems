+
+    # G6: four failing no-tool attacks; standard exponentiation is separate.
+    attack_counts = {
+        "outlier_smaller_encoded_branch": 0,
+        "greedy_all_plus_branch": 0,
+        "random_restart_256_pm_branches": 0,
+        "by_hand_root_sign_ansatz": 0,
