+DIFFICULTY: dict = {
+    "demo": {"n": 4, "k": 2},
+    "easy": {"n": 31, "k": 32},
+    "medium": {"n": 43, "k": 32},
+    "hard": {"n": 59, "k": 32},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The value of each cyclotomic expression is controlled by its prime's "
+    "residue class modulo 16 and not by the displayed choice of root."
