+def _is_int(value: Any) -> bool:
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _is_prime(p: int) -> bool:
+    if p < 2:
+        return False
+    if p % 2 == 0:
+        return p == 2
+    q = 3
+    while q * q <= p:
+        if p % q == 0:
+            return False
+        q += 2
+    return True
