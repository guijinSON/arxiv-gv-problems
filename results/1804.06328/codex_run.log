   351	def main():
   352	    if len(sys.argv) != 2:
   353	        sys.exit("usage: python3 scripts/harden.py <path to gen_*.py>")
   354	    key = os.environ.get("OPENROUTER_API_KEY")
   355	    if not key:
   356	        sys.exit("ERROR: OPENROUTER_API_KEY is required — the oracle pool spans four "
   357	                 "vendors, so an OpenAI key alone cannot reach it.")
   358	
   359	    global SSL_CONTEXT
   360	    SSL_CONTEXT = _ssl_context()
   361	
   362	    mod = load_module(sys.argv[1])
   363	
   364	    # One master seed governs every draw below — model choice and instance
   365	    # seeds alike — and is recorded, so a run is reproducible without any seed
   366	    # being fixed in advance.
   367	    master = int(os.environ.get("HARDEN_MASTER_SEED") or
   368	                 int.from_bytes(os.urandom(8), "big"))
   369	    rng = random.Random(master)
   370	    update_meta(schema_version=SCHEMA_VERSION, harden_master_seed=master,
   371	                oracle_pool=ORACLE_POOL, oracle_effort=ORACLE_EFFORT,
   372	                max_escalations=MAX_ESCALATIONS)
   373	
   374	    # `demo` is a hand-scale illustration rung, built to be solvable.  Starting
   375	    # the ladder there would spend one of MAX_ESCALATIONS proving that, so the
   376	    # hardening ladder begins at `easy`.
   377	    ladder = [dict(p, _preset=name) for name, p in mod.DIFFICULTY.items()
   378	              if name != "demo"]
   379	    params = ladder[0]
   380	    rung = 0
   381	    verdict = None
   382	
   383	    with open(TRANSCRIPT, "w") as out:
   384	        axes_moved = set()          # every param key any level transition changed
   385	        prev_call = None
   386	        for escalation_round in range(MAX_ESCALATIONS + 1):
   387	            shown = {k: v for k, v in params.items() if k != "_preset"}
   388	            print(f"[round {escalation_round}] {params.get('_preset')} {shown}", file=sys.stderr)
   389	            call = {k: v for k, v in params.items() if k != "_preset"}
   390	            # Record which dials moved since the previous level. This has to cover
   391	            # the fixed ladder as well as escalate(): 2601.05272 climbed
   392	            # n=64,72,80,84 through its LADDER and only then called escalate(), so
   393	            # counting escalate()'s moves alone would have seen no axis at all.
   394	            if prev_call is not None:
   395	                for _k, _v in call.items():
   396	                    if prev_call.get(_k) != _v:
   397	                        axes_moved.add(_k)
   398	            prev_call = dict(call)
   399	            preset = params.get("_preset", "escalated")
   400	            if not run_level(mod, call, preset, escalation_round, rng, key, out):
   401	                verdict = {"verdict": "hardened", "escalations_used": escalation_round,
   402	                           "shipping_params": call, "preset": preset}
   403	                break
   404	            print("  -> solved; escalating", file=sys.stderr)
   405	
   406	            rung += 1
   407	            if rung < len(ladder):
   408	                params = ladder[rung]
   409	            else:
   410	                nxt = mod.escalate(call)
   411	                # A module may say "I could go harder, but the answer would no
   412	                # longer fit under the cap" by returning the string "cap_bound".
   413	                # That is NOT the same verdict as "this family has no hardness
   414	                # left": the first is a property of our answer format, the second
   415	                # is a property of the paper. Ten rejections were papers whose
   416	                # escalate() stopped at the cap and were then discarded as
   417	                # too_easy -- judged un-writable, not unsuitable.
   418	                if nxt == "cap_bound":
   419	                    verdict = {"verdict": "cap_bound",
   420	                               "escalations_used": escalation_round,
   421	                               "reason": "the family can be made harder, but only by "
   422	                                         "lengthening the answer past the output cap. "
   423	                                         "This is a limit of the answer format, not of "
   424	                                         "the paper -- do not reject it as too_easy."}
   425	                    break
   426	                if nxt is None:
   427	                    # Do not take "None" at face value. cap_bound has been documented
   428	                    # in the escalate() contract and in STEP 0, and builders still
   429	                    # return None when what they mean is "the answer would not fit":
   430	                    # 2601.05272 climbed n=64,72,80,84 and stopped at 249 atoms
   431	                    # against a 256 cap, then reported "the family cannot be made
   432	                    # harder", which was false. Measure it here instead of asking.
   433	                    _atoms, _chars = _answer_size(mod, call)
   434	                    _near = False
   435	                    if _atoms is not None:
   436	                        _near = (_atoms >= CAP_NEAR_FRACTION * ANSWER_ATOM_CAP
   437	                                 or _chars >= CAP_NEAR_FRACTION * ANSWER_CHAR_CAP)
   438	                    _one_dial = len(axes_moved) <= 1
   439	                    if _near or _one_dial:
   440	                        verdict = {
   441	                            "verdict": "cap_bound",
   442	                            "escalations_used": escalation_round,
   443	                            "answer_atoms": _atoms, "answer_chars": _chars,
   444	                            "atom_cap": ANSWER_ATOM_CAP, "char_cap": ANSWER_CHAR_CAP,
   445	                            "axes_moved": sorted(axes_moved),
   446	                            # Two different diagnoses share this verdict, and the
   447	                            # cure differs. "answer_cap": the format genuinely
   448	                            # blocked the ladder -- needs a fixed-length witness.
   449	                            # "single_axis": the ladder only ever turned one dial,
   450	                            # so the family was never actually explored -- often
   451	                            # with a tiny answer and enormous headroom left.
   452	                            "signal": "+".join(
   453	                                x for x in (("answer_cap" if _near else ""),
   454	                                            ("single_axis" if _one_dial else "")) if x),
   455	                            "reason": (
   456	                                "escalate() returned None, but this looks like the ANSWER "
   457	                                "CAP rather than a hardness ceiling"
   458	                                + (f": the answer is already {_atoms} atoms / {_chars} chars "
   459	                                   f"against a {ANSWER_ATOM_CAP}-atom, {ANSWER_CHAR_CAP}-char cap"
   460	                                   if _atoms is not None else "")
   461	                                + (f"; the ladder only ever moved {sorted(axes_moved) or ['nothing']}, "
   462	                                   "so no fixed-answer-length axis was tried"
   463	                                   if _one_dial else "")
   464	                                + ".  PARK this paper -- do not write REJECTED.md.  Harden at "
   465	                                  "fixed answer length instead (bigger ground set with the same "
   466	                                  "witness size, larger modulus, denser decoys, tighter "
   467	                                  "constraints) and re-run."),
   468	                        }
   469	                        break
   470	                    verdict = {"verdict": "too_easy", "escalations_used": escalation_round,
   471	                               "axes_moved": sorted(axes_moved),
   472	                               "answer_atoms": _atoms,
   473	                               "reason": "escalate() returned None — the family cannot be "
   474	                                         "made harder, and the oracle pool still solves it"}
   475	                    break
   476	                params = dict(nxt, _preset="escalated")
   477	        else:
   478	            # The loop ran out of ESCALATIONS, which says nothing about the family
   479	            # until we ask whether it had anywhere left to go.  Ask.
   480	            _atoms, _chars = _answer_size(mod, prev_call or {})
   481	            try:
   482	                _more = mod.escalate(dict(prev_call or {}))
   483	            except Exception:                               # noqa: BLE001
   484	                _more = None
   485	            if _more is not None:
   486	                verdict = {
   487	                    "verdict": "budget_bound",
   488	                    "escalations_used": MAX_ESCALATIONS,
   489	                    "axes_moved": sorted(axes_moved),
   490	                    "answer_atoms": _atoms, "answer_chars": _chars,
   491	                    "next_level": None if _more == "cap_bound" else _more,
   492	                    "escalate_says": "cap_bound" if _more == "cap_bound" else "more levels",
   493	                    "reason": (
   494	                        f"the oracle pool solved every level through {MAX_ESCALATIONS} "
   495	                        f"escalations, but escalate() was STILL WILLING TO CLIMB "
   496	                        f"({'it would next report cap_bound' if _more == 'cap_bound' else _more}). "
   497	                        "The binding constraint was this harness's escalation budget, not "
   498	                        "the paper.  PARK it -- do not write REJECTED.md.  Re-run with "
   499	                        "ORACLE_MAX_ESCALATIONS raised, or ship at a higher preset."),
   500	                }
   501	            else:
   502	                verdict = {"verdict": "too_easy", "escalations_used": MAX_ESCALATIONS,
   503	                           "axes_moved": sorted(axes_moved),
   504	                           "answer_atoms": _atoms, "answer_chars": _chars,
   505	                           "reason": f"the oracle pool solved every level through "
   506	                                     f"{MAX_ESCALATIONS} escalations, and escalate() "
   507	                                     f"has nothing further to offer"}
   508	
   509	    update_meta(harden_verdict=verdict)
   510	    print(json.dumps(verdict, indent=1))
   511	    # 0 hardened / 9 too_easy (give the paper up) / 10 park it -- the paper is fine
   512	    # and the binding constraint is ours: the answer format (cap_bound) or the
   513	    # escalation budget (budget_bound).
   514	    return {"hardened": 0, "cap_bound": 10, "budget_bound": 10}.get(verdict["verdict"], 9)
