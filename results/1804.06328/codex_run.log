+DIFFICULTY = {
+    "demo": {"n": 2, "p": 11},
+    "easy": {"n": 24, "p": 101},
+    "medium": {"n": 54, "p": 503},
+    "hard": {"n": 90, "p": 997},
+}
+SHIPPING_DIFFICULTY = "hard"
