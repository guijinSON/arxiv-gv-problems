   296	
   297	def parse_answer(text: Any) -> object | None:
   298	    if not isinstance(text, str):
   299	        return None
   300	    bodies = _ANSWER_RE.findall(text)
   301	    if not bodies:
   302	        return None
   303	    for body in reversed(bodies):
   304	        cleaned = body.strip()
   305	        if cleaned.startswith("```") and cleaned.endswith("```"):
   306	            cleaned = re.sub(r"^```(?:json)?\s*", "", cleaned, flags=re.I)
   307	            cleaned = re.sub(r"\s*```$", "", cleaned)
   308	        try:
   309	            value = json.loads(cleaned)
   310	        except (TypeError, ValueError):
   311	            continue
   312	        if isinstance(value, dict):
   313	            return value
   314	    return None
   315	
   316	
   317	def _check_vector(name: str, value: Any, n: int, p: int) -> tuple[bool, str]:
   318	    if not isinstance(value, list):
   319	        return False, f"{name} must be a list"
   320	    if len(value) != n:
   321	        return False, f"{name} must have length {n}, got {len(value)}"
   322	    for i, x in enumerate(value):
   323	        if not _is_int(x):
   324	            return False, f"{name}[{i}] must be an integer"
   325	        if not 1 <= x < p:
   326	            return False, f"{name}[{i}] is outside the nonzero range 1..{p - 1}"
   327	    return True, "ok"
   328	
   329	
   330	def verify(inst: dict, answer: Any) -> tuple[bool, str]:
   331	    """Check the normalized factor and B*A^T=I; never consult inst['answer']."""
   332	    if not isinstance(answer, dict) or not answer:
   333	        return False, "answer must be a nonempty JSON object"
   334	    if set(answer) != {"alpha", "left", "right"}:
   335	        return False, "answer must have exactly alpha, left, and right"
   336	    p = inst["p"]
   337	    n = inst["dimension"]
   338	    a = inst["automorphism"]
   339	    alpha = answer["alpha"]
   340	    if not _is_int(alpha) or not 1 <= alpha < p:
   341	        return False, f"alpha is outside the nonzero range 1..{p - 1}"
   342	    ok, reason = _check_vector("left", answer["left"], n, p)
   343	    if not ok:
   344	        return ok, reason
   345	    ok, reason = _check_vector("right", answer["right"], n, p)
   346	    if not ok:
   347	        return ok, reason
   348	    left = answer["left"]
   349	    right = answer["right"]
   350	    pivot = (a[0][0] - 1) % p
   351	    if left[0] != 1:
   352	        return False, "normalization fails: left[0] must equal 1"
   353	    if right[0] != pivot:
   354	        return False, "normalization fails: right[0] must equal A[0][0]-1"
   355	
   356	    # If B=I+alpha*l*r^T, then (B A^T)_ij is
   357	    # A[j][i] + alpha*l[i]*(row_j(A) dot r).  This checks the full matrix
   358	    # identity exactly in O(n^2), with early rejection for random guesses.
   359	    for j, row in enumerate(a):
   360	        w = sum(row[k] * right[k] for k in range(n)) % p
   361	        for i in range(n):
   362	            got = (a[j][i] + alpha * left[i] * w) % p
   363	            want = 1 if i == j else 0
   364	            if got != want:
   365	                return False, f"inverse identity fails at row {i}, column {j}"
   366	    return True, "ok"
   367	
   368	
   369	def random_candidate(inst: dict, rng: random.Random) -> object:
   370	    """Uniformly sample the exact normalized, all-nonzero certificate grammar."""
   371	    p = inst["p"]
   372	    n = inst["dimension"]
   373	    pivot = (inst["automorphism"][0][0] - 1) % p
   374	    return {
   375	        "alpha": rng.randrange(1, p),
   376	        "left": [1] + [rng.randrange(1, p) for _ in range(n - 1)],
   377	        "right": [pivot] + [rng.randrange(1, p) for _ in range(n - 1)],
   378	    }
   379	
   380	
   381	def search_space(inst: dict) -> int:
   382	    # alpha and the 2(n-1) unnormalized vector entries are independently free.
   383	    return (inst["p"] - 1) ** (2 * inst["dimension"] - 1)
   384	
   385	
   386	def enumerate_all(inst: dict) -> int | None:
   387	    """Brute-force the exact grammar only when its full size is safely small."""
   388	    space = search_space(inst)
   389	    if space > _ENUMERATION_CAP:
   390	        return None
   391	    p = inst["p"]
   392	    n = inst["dimension"]
   393	    pivot = (inst["automorphism"][0][0] - 1) % p
   394	    count = 0
   395	    # The only supported enumerable preset has n=2.  Keep the generic guard so
   396	    # an unexpected parameter cannot hang this routine.
   397	    if n != 2:
   398	        return None
   399	    for alpha in range(1, p):
   400	        for l1 in range(1, p):
   401	            for r1 in range(1, p):
   402	                candidate = {
   403	                    "alpha": alpha,
   404	                    "left": [1, l1],
   405	                    "right": [pivot, r1],
   406	                }
   407	                if verify(inst, candidate)[0]:
   408	                    count += 1
   409	    return count
   410	
   411	
   412	def canonical_key(inst: dict) -> str:
   413	    """A similarity invariant for the generated rank-one automorphisms."""
   414	    p = inst["p"]
   415	    n = inst["dimension"]
   416	    a = inst["automorphism"]
   417	    trace_update = (sum(a[i][i] for i in range(n)) - n) % p
   418	    # I+uv^T with nonzero v^T u is diagonalizable with eigenvalues 1 and
   419	    # 1+v^T u; hence (p,n,trace_update) is complete under general similarity
   420	    # for generated instances.  It is also invariant under transpose.
   421	    return f"Fp={p}|dimension={n}|rank1_trace={trace_update}"
   422	
   423	
   424	def escalate(params: dict) -> dict | str | None:
   425	    """Raise field entropy at fixed certificate length before approaching caps."""
   426	    q = dict(params)
   427	    q.pop("_preset", None)
   428	    p = q.get("p")
   429	    if not _is_int(p):
   430	        return None
   431	    next_prime = {
   432	        101: 503,
   433	        503: 997,
   434	        997: 10007,
   435	        10007: 100003,
   436	        100003: 1000003,
   437	        1000003: 10000019,
   438	        10000019: 100000007,
   439	        100000007: 1000000007,
   440	    }.get(p)
   441	    if next_prime is None:
   442	        return "cap_bound"
   443	    q["p"] = next_prime
   444	    return q
