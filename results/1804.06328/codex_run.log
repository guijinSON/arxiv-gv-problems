   585	
   586	def _answer_atoms(value: Any) -> int:
   587	    if isinstance(value, dict):
   588	        return sum(_answer_atoms(v) for v in value.values())
   589	    if isinstance(value, list):
   590	        return sum(_answer_atoms(v) for v in value)
   591	    return 1
