+    "hardness_basis": (
+        "Track B: automatic rank-one validation followed by the "
+        "Sherman--Morrison inverse-adjoint formula is O(n^2) and uses 24,484 "
+        "exact field operations (0.026 seconds measured) at shipping n=90, whereas "
+        "noticing the outer-product structure reduces the unaided route to "
+        "272 exact field operations; the reference algorithm succeeds by design."
+    ),
+    "max_answer_tokens": 190,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
