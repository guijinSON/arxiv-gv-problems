   446	
   447	def _reference_algorithm(inst: dict) -> tuple[dict | None, int]:
   448	    """Validate rank one exhaustively, then apply Sherman--Morrison."""
   449	    p = inst["p"]
   450	    n = inst["dimension"]
   451	    a = inst["automorphism"]
   452	    operations = 0
   453	    r = []
   454	    for i in range(n):
   455	        row = []
   456	        for j in range(n):
   457	            row.append((a[i][j] - (1 if i == j else 0)) % p)
   458	            operations += 1
   459	        r.append(row)
   460	    pivot = r[0][0]
   461	    if pivot == 0:
   462	        return None, operations
   463	    for i in range(n):
   464	        for j in range(n):
   465	            lhs = r[i][j] * pivot % p
   466	            rhs = r[i][0] * r[0][j] % p
   467	            operations += 2
   468	            if lhs != rhs:
   469	                return None, operations
   470	    pivot_inv = _inv(pivot, p)
   471	    operations += 1
   472	    left = [x * pivot_inv % p for x in r[0]]
   473	    operations += n
   474	    right = [r[i][0] for i in range(n)]
   475	    trace_update = 0
   476	    for i in range(n):
   477	        trace_update = (trace_update + r[i][i]) % p
   478	        operations += 1
   479	    denom = (1 + trace_update) % p
   480	    operations += 1
   481	    if denom == 0:
   482	        return None, operations
   483	    alpha = (-_inv(denom, p)) % p
   484	    operations += 2
   485	    return {"alpha": alpha, "left": left, "right": right}, operations
   486	
   487	
   488	def _compact_operations(inst: dict) -> int:
   489	    # n diagonal subtractions, n-1 trace additions, n-1 row normalizations,
   490	    # two inversions, one scalar addition, and one negation.
   491	    n = inst["dimension"]
   492	    return n + (n - 1) + (n - 1) + 2 + 1 + 1
   493	
   494	
   495	def _attack_candidates(inst: dict, rng: random.Random) -> dict[str, list[Any]]:
   496	    p = inst["p"]
   497	    n = inst["dimension"]
   498	    a = inst["automorphism"]
   499	    pivot = (a[0][0] - 1) % p
   500	    pivot_inv = _inv(pivot, p)
   501	    left = [((a[0][j] - (1 if j == 0 else 0)) * pivot_inv) % p
   502	            for j in range(n)]
   503	    right = [(a[i][0] - (1 if i == 0 else 0)) % p for i in range(n)]
   504	    local_alpha = (-_inv(1 + pivot, p)) % p
   505	    attacks: dict[str, list[Any]] = {
   506	        "outlier_top_left_only": [
   507	            {"alpha": local_alpha, "left": left, "right": right}
   508	        ],
   509	        "greedy_transpose": [
   510	            {"alpha": 1, "left": left, "right": right}
   511	        ],
   512	        "first_order_neumann_ansatz": [
   513	            {"alpha": p - 1, "left": left, "right": right}
   514	        ],
   515	        "random_restart_256": [random_candidate(inst, rng) for _ in range(256)],
   516	    }
   517	    return attacks
   518	
   519	
   520	def _relabel_instance(inst: dict, rng: random.Random,
   521	                      do_transpose: bool) -> tuple[dict, list[list[int]]]:
   522	    """Apply monomial and shear basis changes; carry the dense dual witness."""
   523	    p = inst["p"]
   524	    n = inst["dimension"]
   525	    a = inst["automorphism"]
   526	    b = _expand_answer(inst["answer"], p)
   527	    perm = list(range(n))
   528	    rng.shuffle(perm)
   529	    scales = [rng.randrange(1, p) for _ in range(n)]
   530	    inv_scales = [_inv(x, p) for x in scales]
   531	    aprime = [[scales[i] * a[perm[i]][perm[j]] * inv_scales[j] % p
   532	               for j in range(n)] for i in range(n)]
   533	    # For A'=C A C^-1, B'=C^-T B C^T.
   534	    bprime = [[inv_scales[i] * b[perm[i]][perm[j]] * scales[j] % p
   535	               for j in range(n)] for i in range(n)]
   536	
   537	    # Compose with C=I+t*E_ab, whose inverse is I-t*E_ab.  This is a genuine
   538	    # non-monomial basis change.  Retry t only to remain inside the declared
   539	    # all-nonzero factor language after relabelling.
   540	    a_idx, b_idx = rng.sample(range(n), 2)
   541	    for _ in range(p):
   542	        t = rng.randrange(1, p)
   543	        a2 = [row[:] for row in aprime]
   544	        a2[a_idx] = [(a2[a_idx][j] + t * a2[b_idx][j]) % p
   545	                     for j in range(n)]
   546	        for i in range(n):
   547	            a2[i][b_idx] = (a2[i][b_idx] - t * a2[i][a_idx]) % p
   548	        if all((a2[i][j] - (1 if i == j else 0)) % p
   549	               for i in range(n) for j in range(n)):
   550	            # B2=C^-T*B*C^T: row b -= t*row a, then col a += t*col b.
   551	            b2 = [row[:] for row in bprime]
   552	            b2[b_idx] = [(b2[b_idx][j] - t * b2[a_idx][j]) % p
   553	                         for j in range(n)]
   554	            for i in range(n):
   555	                b2[i][a_idx] = (b2[i][a_idx] + t * b2[i][b_idx]) % p
   556	            aprime, bprime = a2, b2
   557	            break
   558	    else:
   559	        raise AssertionError("could not find a dense shear relabelling")
   560	    if do_transpose:
   561	        aprime = _transpose(aprime)
   562	        bprime = _transpose(bprime)
   563	    changed = copy.deepcopy(inst)
   564	    changed["automorphism"] = aprime
   565	    changed.pop("answer", None)
   566	    return changed, bprime
   567	
   568	
   569	def _encode_dense_witness(inst: dict, b: list[list[int]]) -> dict:
   570	    """Normalize a carried dense B without using the instance's planted answer."""
   571	    p = inst["p"]
   572	    n = inst["dimension"]
   573	    a = inst["automorphism"]
   574	    pivot = (a[0][0] - 1) % p
   575	    m00 = (b[0][0] - 1) % p
   576	    alpha = m00 * _inv(pivot, p) % p
   577	    m00_inv = _inv(m00, p)
   578	    alpha_inv = _inv(alpha, p)
   579	    left = [((b[i][0] - (1 if i == 0 else 0)) * m00_inv) % p
   580	            for i in range(n)]
   581	    right = [((b[0][j] - (1 if j == 0 else 0)) * alpha_inv) % p
   582	             for j in range(n)]
   583	    return {"alpha": alpha, "left": left, "right": right}
