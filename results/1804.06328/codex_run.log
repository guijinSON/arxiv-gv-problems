   913	\section{Even set: a new model}\label{sec4}
   914	
   915	
   916	The constructions in the last section suggest the close connection between primitive formally dual sets and the RDS-related structures. A natural question is the exact relation between a primitive formally dual set and an $(n,n,n,1)$-RDS. In this section we answer this question by proposing the concept of even sets as a new model for the study of formally dual sets, which includes RDSs and GRDSs as special cases. As we shall see, even sets provide more structural information about primitive formally dual sets. In addition, we shed some new light on Conjecture~\ref{conj-main}, by observing its connection to the nonexistence result of RDSs in cyclic groups.
   917	
   918	\subsection{Even set and formally dual set}
   919	
   920	%Note that we are going to use the {\it additive} notation for the group $G$ below. More precisely, for the group $G=\Z_{n_1}\times\Z_{n_2}\times\cdots\times\Z_{n_t}$ and $y=(y_1,y_2,\ldots,y_t) \in G$, we write
   921	%$$
   922	%iy=(iy_1,iy_2,\ldots,iy_t),
   923	%$$
   924	%where $i$ is an integer.
   925	
   926	
   927	We first propose the concept of even sets.
   928	
   929	\begin{definition}\label{def-evenset}
   930	Let $G$ be a group and $H_i$ be a subgroup of $G$ for each $1 \le i \le r$. Let $S$ be a subset of $G$, satisfying
   931	\begin{equation}\label{eqn-Sdecom}
   932	SS^{(-1)} = \sum_{i=1}^r \lambda_i H_i,
   933	\end{equation}
   934	where $\la_i$ is a nonzero integer for each $1 \le i \le r$. Then $S$ is called an even set with respect to $H_i$, $1 \le i \le r$. Moreover, if $r$ is the smallest integer such that a decomposition \eqref{eqn-Sdecom} holds, we call $r$ the rank of the even set $S$.
   935	\end{definition}
   936	
   937	We remark that Definition~\ref{def-evenset} covers many well-studied configurations as special cases.
   938	
   939	\begin{example}
   940	Let $D$ be a $(v,k,\la)$ difference set in a group $G$, satisfying $1 < k < v$. By Definition~\ref{def-DS}, we have
   941	$$
   942	DD^{(-1)}=k+\la (G-1)=(k-\la) + \la G.
   943	$$
   944	Note that $k > \la$ and $\la>0$. Therefore, $D$ is a rank two even set in $G$, with respect to subgroups $\{1\}$ and $G$.
   945	\end{example}
   946	
   947	\begin{example}\label{exam-RDS}
   948	Let $R$ be an $(m,n,k,\la)$-RDS in a group $G$ relative to $N$ with $n>1$ and $k>1$. By Definition~\ref{def-RDS}, we have
   949	$$
   950	RR^{(-1)}=k+\la (G-N)=k-\la N+\la G,
   951	$$
   952	where $\la>0$ and $N \ne \{1\}$, $N \ne G$. Thus, $R$ is a rank three even set in $G$, with respect to subgroups $\{1\}$, $N$ and $G$.
   953	\end{example}
   954	
   955	\begin{example}
   956	Let $R=\GR(p^t,s)$ and let $S$ be a GRDS in $R \times R$ relative to $\{R_i \times (p^i) \mid 0 \le i \le t\}$. By Definition~\ref{def-GRDS}, we have
   957	$$
   958	SS^{(-1)}=\sum_{i=0}^t p^{is} (R_i \times (p^i)).
   959	$$
   960	For $0 \le i,j \le t$, we know that $(p^i) \times (p^j)$ is a subgroup of $R \times R$. Note that $(p^0)=(1)=R$ and define $(p^{t+1})=\es$. Since
   961	\begin{align*}
   962	&SS^{(-1)}\\
   963	=&\sum_{i=0}^t p^{is} (R_i \times (p^i))=\sum_{i=0}^t (p^{is} ((p^i) \times (p^i))-p^{is} ((p^{i+1}) \times (p^i))) \\
   964	=&p^{ts} ((p^t) \times (p^t))-p^{(t-1)s} ((p^t) \times (p^{t-1}))+p^{(t-1)s} ((p^{t-1}) \times (p^{t-1}))-\cdots-(p) \times R+R \times R,
   965	\end{align*}
   966	$S$ is an even set of rank $2t+1$ in $R \times R$, with respect to a chain of subgroups
   967	$$
   968	\{(0,0)\}=(p^t) \times (p^t) \lneqq (p^t) \times (p^{t-1}) \lneqq (p^{t-1}) \times (p^{t-1}) \lneqq \cdots \lneqq (p) \times R \lneqq R \times R.
   969	$$
   970	\end{example}
   971	
   972	For $y \in G$ of order $l$, it generates a cyclic group $\lan y \ran$ of order $l$. We define the \emph{orbit} generated by $y$ as
   973	$$
   974	\orb(y)=\{ y^i \mid i \in \Zl^* \},
   975	$$
   976	where $\Zl^*$ is the set of multiplicative units in $\Zl$. Namely, $\orb(y)$ consists of all elements in $\lan y \ran$ having the same order as $y$. The following proposition presents an alternative description of even sets, for which we give a sketch of proof.
   977	
   978	\begin{proposition}\label{prop-orbit}
   979	Let $S$ be a subset of a group $G$. Then $S$ is an even set in $G$ if and only if for each $y \in \{SS^{(-1)}\}$, the weight enumerator $\nu_S$ is constant on $\orb(y)$. Equivalently, $S$ is an even set in $G$ if and only if the multiset $[SS^{(-1)}]$ is a union of orbits in $G$.
   980	\end{proposition}
   981	\begin{proof}[Sketch of proof]
   982	For $x, y \in G$, define a relation $x \sim y$ if $x \in \orb(y)$. It is routine to verify that this relation is an equivalence relation. Thus, the group $G$ and each subgroup of $G$, can be partitioned into a disjoint union of orbits.
   983	
   984	If $S$ is an even set in $G$, then $SS^{(-1)}=\sum_{i}\la_iH_i$, where the $H_i$'s are subgroups of $G$. Since each $H_i$ can be partitioned into a disjoint union of orbits, then $[SS^{(-1)}]$ is a union of orbits. Thus, for each $y \in \{SS^{(-1)}\}$, we know that $\nu_S$ is constant on $\orb(y)$.
   985	
   986	Conversely, if $\nu_S$ is constant on $\orb(y)$ for each $y \in \{SS^{(-1)}\}$, then $[SS^{(-1)}]$ is a union of orbits. For each orbit $\orb(y)$, by the inclusion and exclusion theorem, we can see that $\orb(y)=\sum_{i}\mu_iL_i$, where $L_i$ is a subgroup of $\lan y \ran$. Consequently, $SS^{(-1)}$ can be decomposed into a summation of subgroups of $G$ and therefore, $S$ is an even set in $G$.
   987	\end{proof}
   988	
   989	In order to build the connection between formally dual sets and even sets, we need Lemma~\ref{lem-char}. Each $i \in \Zl^*$ corresponds to a Galois automorphism $\sig_i \in \Gal(\Q(\zl)/\Q)$, where $\sig_i(\zl)=\zl^i$ and $\zl$ is a primitive $l$-th root of unity. Recall that for each $\chi_y \in \wh{G}$, we have a natural projection $\rho: G \rightarrow G/\ker \chi_y$. The character $\chi_y$ induces a character $\wti{\chi_y}$ of $G/\ker \chi_y$, satisfying $\wti{\chi_y}(\rho(g))=\chi_y(g)$ for each $g \in G$.
   990	
   991	\begin{lemma}\label{lem-char}
   992	Let $G$ be a group and $y \in G$ of order $l$. Let $\De$ be an isomorphism from $G$ to $\wh{G}$, such that $\De(g)=\chi_g$ for each $g \in G$. Let $\rho: G \rightarrow G/\ker \chi_y$ be the natural projection. Then
   993	\begin{itemize}
   994	\item[(1)] $\chi_y$ is a character of order $l$. For each $i \in \Zl^*$ and $g \in G$, we have $\sig_i(\chi_y(g))=\chi_{y}(g^i)$.
   995	\item[(2)] $\wti{\chi_y}$ has order $l$ and generates the character group $\wh{G/\ker \chi_y}$, which is isomorphic to $\Zl$. For each $i \in \Zl^*$ and $h \in G/\ker \chi_y$, we have $\sig_i(\wti{\chi_{y}}(h))=\wti{\chi_{y}}(h^i)$.
   996	\end{itemize}
   997	\end{lemma}
   998	\begin{proof}
   999	(1) Since $\De$ is a group isomorphism, $\chi_y$ has order $l$. For each $i \in \Zl^*$ and $g \in G$, we have
  1000	$$
  1001	\sig_i(\chi_y(g))=\chi_y^i(g)=\chi_{y}(g^i).
  1002	$$
  1003	
  1004	(2) By the definition of $\wti{\chi_y}$, we can easily see that $\wti{\chi_y}$ has order $l$. Note that $\chi_y: G \rightarrow \{\zl^j \mid 0 \le j \le l-1\}$ is an epimorphism. Therefore, $G/ \ker \chi_y \cong \{\zl^j \mid 0\le j \le l-1\} \cong \Z_l$. Consequently, the character group $\wh{G/\ker \chi_y}$ is isomorphic to $\Zl$ and has a generator $\wti{\chi_y}$. For each $i \in \Zl^*$ and $h \in G$, we have
  1005	    $\sig_i(\wti{\chi_y}(h))=\wti{\chi_{y}}^i(h)=\wti{\chi_{y}}(h^i)$.
  1006	\end{proof}
  1007	
  1008	Let $S$ and $T$ be a formally dual pair in $G$. By Remark~\ref{rem-def}(3), $|\chi(S)|^2$ and $|\chi(T)|^2$ are integers for each $\chi \in \wh{G}$. The following proposition extends Proposition~\ref{prop-non}(3).
  1009	
  1010	\begin{proposition}\label{prop-decom}
  1011	Let $S$ be a subset of a group $G$, such that $|\chi(S)|^2$ is an integer for each $\chi \in \wh{G}$. Let $y \in G$ be an element of order $l$. Then the following holds:
  1012	\begin{itemize}
  1013	\item[(1)] For each $i \in \Z_l^*$, we have $|\chi_y(S^{(i)})|^2=|\chi_y(S)|^2$.
  1014	\item[(2)] Furthermore, suppose $S$ and $T$ form a formally dual pair in $G$. Then for each $i \in \Z_l^*$, we have $\nu_S(y^i)=\nu_S(y)$ and $\nu_T(y^i)=\nu_T(y)$.
  1015	\end{itemize}
  1016	\end{proposition}
  1017	\begin{proof}
  1018	(1) By Lemma~\ref{lem-char}(1), $\chi_y$ has order $l$. For each $i \in \Zl^*$, we have
  1019	\begin{align*}
  1020	|\chi_y(S)|^2&=\sig_i(|\chi_y(S)|^2)=\sig_i(\chi_y(S))\sig_i(\ol{\chi_y(S)})\\
  1021	             &=\sig_i(\chi_y(S))\ol{\sig_i(\chi_y(S))}=\chi_{y}^i(S)\ol{\chi_{y}^i(S)}=\chi_{y}(S^{(i)})\ol{\chi_{y}(S^{(i)})}=|\chi_{y}(S^{(i)})|^2.
  1022	\end{align*}
  1023	%Thus, for each $i \in \Zl^*$, we have
  1024	%\begin{equation}\label{eqn-chareq}
  1025	%|\chi_{iy}(S)|^2=|\chi_y(S)|^2.
  1026	%\end{equation}
  1027	
  1028	(2) Let $\De$ be the isomorphisms from $G$ to $\wh{G}$, such that $\De(g)=\chi_g$ for each $g \in G$. For each $y \in G$ of order $l$ and each $i \in \Zl^*$, note that $\chi_{y^i}=\De(y^i)=\De(y)^i=\chi_y^i$. Applying (1), we have
  1029	$$
  1030	|\chi_{y^i}(S)|^2=|\chi_y^i(S)|^2=|\chi_y(S^{(i)})|^2=|\chi_y(S)|^2.
  1031	$$
  1032	By formal duality and \eqref{eqn-def}, for each $y \in G$ of order $l$ and $i \in \Zl^*$, we have $\nu_T(y^i)=\nu_T(y)$. Interchanging the roles of $S$ and $T$, for each $y \in G$ of order $l$ and $i \in \Zl^*$, we have $\nu_S(y^i)=\nu_S(y)$.
  1033	\end{proof}
  1034	
  1035	
  1036	As an immediate consequence of Proposition~\ref{prop-orbit} and Proposition~\ref{prop-decom}(2), we have the following corollary.
  1037	
  1038	\begin{corollary}\label{cor-formaleven}
  1039	Each formally dual set is an even set.
  1040	\end{corollary}
  1041	
  1042	We define the \emph{rank} of a formally dual set to be its rank as an even set. In the sense of Definition~\ref{def-equiv}, two equivalent formally dual sets have the same rank. If $S$ is a formally dual set in $G$, which is an even set with respect to subgroups $H_i$, $1 \le i \le r$, then we call $S$ a formally dual set in $G$ with respect to subgroups $H_i$, $1 \le i \le r$.
  1043	
  1044	The following proposition describes a necessary and sufficient condition for a pair of even sets being formally dual.
  1045	
  1046	\begin{theorem}\label{thm-convertion}
  1047	Let $G$ be a group. The following two statements are equivalent.
  1048	\begin{itemize}
  1049	\item[(1)] $S$ and $T$ form a formally dual pair in $G$.
  1050	\item[(2)] $S$ and $T$ are even sets of rank $r$, such that
  1051	\begin{equation}\label{eqn-SSinv}
  1052	SS^{(-1)}=\sum_{i=1}^r \lambda_i H_i
  1053	\end{equation}
  1054	and
  1055	\begin{equation}\label{eqn-TTinv}
  1056	TT^{(-1)}=\sum_{i=1}^{r} \wti{\lambda_i} \wti{H_i},
  1057	\end{equation}
  1058	where $H_i$, $1 \le i \le r$, are subgroups of $G$ and $\wti{\la_i}=\frac{\lambda_i|G||H_i|}{|S|^3}$, for each $1 \le i \le r$.
  1059	\end{itemize}
  1060	\end{theorem}
  1061	\begin{proof}
  1062	We first prove that (1) implies (2). Since $S$ and $T$ form a formally dual pair, then by Corollary~\ref{cor-formaleven}, $S$ and $T$ are both even sets. Suppose $S$ has rank $r$, then we can assume
  1063	$$
  1064	SS^{(-1)}=\sum_{i=1}^r \lambda_i H_i,
  1065	$$
  1066	where $H_i$, $1 \le i \le r$, are subgroups of $G$ and $\la_i$, $1 \le i \le r$, are nonzero. Note that for each $1 \le i \le r$,
  1067	\begin{equation}\label{eqn-ortho}
  1068	\chi_y(H_i)=\begin{cases}
  1069	                 |H_i| & \mbox{if $y \in \wti{H_i}$,}\\
  1070	                  0    & \mbox{otherwise.}
  1071	            \end{cases}
  1072	\end{equation}
  1073	For each $y \in G$, we define a subset $I_y \subset \{1,2,\ldots,r\}$, such that $y \in \big(\bigcap_{i \in I_y} \wti{H_i}\big) \sm \big(\bigcup_{j \notin I_y} \wti{H_j}\big)$. Combining \eqref{eqn-def}, \eqref{eqn-SSinv} and \eqref{eqn-ortho}, we have
  1074	$$
  1075	\nu_T(y)=\frac{|T|}{|S|^2}|\chi_y(S)|^2 =\frac{|G|}{|S|^3}\sum_{i=1}^r \lambda_i \chi_y(H_i)=\frac{|G|}{|S|^3}\sum_{i \in I_y} \lambda_i|H_i|=\sum_{i \in I_y} \wti{\la_i},
  1076	$$
  1077	which implies
  1078	$$
  1079	TT^{(-1)}=\sum_{i=1}^{r} \wti{\lambda_i} \wti{H_i}.
  1080	$$
  1081	Thus, the rank of $T$ is no more than $r$. By interchanging the roles of $S$ and $T$, we can see the ranks of $S$ and $T$ are both $r$.
  1082	
  1083	Conversely, assume (2) holds. An analogous argument shows that (2) implies (1).
  1084	\end{proof}
  1085	
  1086	\begin{remark}
  1087	Let $S$ and $T$ be a formally dual pair in $G$. By Remark~\ref{rem-def}(2), $SS^{(-1)}$ determines $TT^{(-1)}$, and vice versa. Based on the concept of even sets, \eqref{eqn-SSinv} and \eqref{eqn-TTinv} provide an explicit description about how $SS^{(-1)}$ and $TT^{(-1)}$ interact.
  1088	\end{remark}
  1089	
  1090	The following lemma describes more structural restrictions on a primitive formally dual set.
  1091	
  1092	\begin{lemma}\label{lem-prieven}
  1093	Let $S$ and $T$ be a primitive formally dual pair in $G$, such that $SS^{(-1)}=\sum_{i=1}^r \lambda_i H_i$, where $H_i$ is a subgroup of $G$ for each $1 \le i \le r$. Then we have
  1094	\begin{itemize}
  1095	\item[(1)] The group generated by $H_1, H_2, \ldots, H_r$ is $G$.
  1096	\item[(2)] $\bigcap_{i=1}^r H_i= \{1\}$.
  1097	\item[(3)] $\sum_{i=1}^r\la_i=|S|$ and $\sum_{i=1}^r\la_i|H_i|=|S|^2$
  1098	\end{itemize}
  1099	\end{lemma}
  1100	\begin{proof}
  1101	(1) Let $H$ be the group generated by $H_1, H_2, \ldots, H_r$. Assume $H$ is a proper subgroup of $G$. Since
  1102	$$
  1103	\{SS^{(-1)}\} \subset H,
  1104	$$
  1105	for each nonprincipal $\chi \in \wh{G}$, which is principal on $H$, we have $|\chi(S)|^2=|S|^2$. By Lemma~\ref{lem-priset}, $S$ is not a primitive subset, which is a contradiction.
  1106	
  1107	(2) By Theorem~\ref{thm-convertion}, we have
  1108	$$
  1109	TT^{(-1)}=\sum_{i=1}^{r} \wti{\lambda_i} \wti{H_i},
  1110	$$
  1111	where $\wti{\la_i}=\frac{\lambda_i|G||H_i|}{|S|^3}$, for each $1 \le i \le r$. Since the group generated by $H_1, H_2, \ldots, H_r$ is the whole group $G$, by definition of $\wti{H_i}$, we have $\bigcap_{i=1}^r \wti{H_i}=\{1\}$. By interchanging the roles of $S$ and $T$, we conclude that $\bigcap_{i=1}^r H_i= \{1\}$.
  1112	
  1113	(3) Note that $|S|=[SS^{(-1)}]_1=\sum_{i=1}^r\la_i$ and $|S|^2=|[SS^{(-1)}]|=\sum_{i=1}^r\la_i|H_i|$, the conclusion follows.
  1114	\end{proof}
  1115	
  1116	For a primitive formally dual set with respect to a chain of subgroups, we can derive much more detailed information.
  1117	
  1118	\begin{proposition}\label{prop-chain}
  1119	Let $S$ and $T$ be a primitive formally dual pair in $G$. Let $S$ be a primitive formally dual set in $G$, with respect to a chain of subgroups $H_1 \lneqq H_2 \lneqq \cdots \lneqq H_r$. Then $T$ is a primitive formally dual set in $G$, with respect to a chain of subgroups $\wti{H_r} \lneqq \wti{H_{r}}_{-1} \lneqq \cdots \lneqq \wti{H_1}$. We write $SS^{(-1)}=\sum_{i=1}^r \lambda_i H_i$ and $TT^{(-1)}=\sum_{i=1}^r \wti{\la_i} \wti{H_i}$. Furthermore, the following holds.
  1120	\begin{itemize}
  1121	\item[(1)] $H_1=\wti{H_r}= \{1\}$ and $H_r=\wti{H_1}=G$.
  1122	\item[(2)] For each $2 \le l \le r$, we have $0 \le \sum_{i=l}^r\la_i < |S|$. For each $1 \le l \le r-1$, we have $ 0 \le \sum_{i=1}^l\la_i|H_i| < |S|^2$. Moreover,
  1123	$$
  1124	\la_1=|S|, \quad \la_r=1, \quad |S| \Big| \la_i|H_i|, \; \forall 1 \le i \le r.
  1125	$$
  1126	\item[(3)] For each $1 \le l \le r-1$, we have $0 \le \sum_{i=1}^l\wti{\la_i} < |T|$. For each $2 \le l \le r$, we have $0 \le \sum_{i=l}^r\wti{\la_i}|\wti{H_i}| < |T|^2$. Moreover,
  1127	$$
  1128	\wti{\la_1}=1, \quad \wti{\la_r}=|T|, \quad |T| \Big| \wti{\la_i}|\wti{H_i}|, \; \forall 1 \le i \le r.
  1129	$$
  1130	\item[(4)] $|G|$ is a square and $|S|=|T|=\sqrt{|G|}$.
  1131	\end{itemize}
  1132	\end{proposition}
  1133	\begin{proof}
  1134	(1) Note that $H_1 \lneqq H_2 \lneqq \cdots \lneqq H_r$ and $\wti{H_r} \lneqq \wti{H_{r}}_{-1} \lneqq \cdots \lneqq \wti{H_1}$. Then the conclusion follows from Lemma~\ref{lem-prieven}(1)(2).
  1135	
  1136	Now we proceed to prove (2) and (4). For $2 \le l \le r$, choose $g \in H_l$ such that $g \notin H_{l-1}$. Together with the primitivity of $S$, we have $0 \le [SS^{(-1)}]_g=\sum_{i=l}^r \la_i < |S|$. For $1 \le l \le r-1$, let $\chi \in \wh{G}$ be a character which is principal on $H_l$ and nonprincipal on $H_{l+1}$. Together with the primitivity of $S$, we have $0 \le |\chi(S)|^2=\sum_{i=1}^l\la_i|H_i| < |S|^2$. Thus, we have proved the first two statements of (2), which imply that $1 \le \la_1, \la_r \le |S|$. By interchanging the roles of $S$ and $T$, we have $1 \le \wti{\la_1}, \wti{\la_r} \le |T|$. Recall that $\wti{\la_i}=\frac{\la_i|G||H_i|}{|S|^3}$ for each $1 \le i \le r$. We have
  1137	$$
  1138	1 \leq \wti{\la_1} = \frac{\la_1|G||H_1|}{|S|^3}=\frac{\la_1|G|}{|S|^3} \leq \frac{|G|}{|S|^2}
  1139	$$
  1140	and
  1141	$$
  1142	1 \leq \la_r = \frac{\wti{\la_r}|S|^3}{|G||H_r|}=\frac{\wti{\la_r}|S|^3}{|G|^2} \leq \frac{|S|^2}{|G|},
  1143	$$
  1144	which implies $\la_1=|S|$, $\la_r=1$ and $|G|=|S|^2$. Together with $|G|=|S||T|$, we have $|G|$ is a square and $|S|=|T|=\sqrt{|G|}$. Since $\wti{\la_i}=\frac{\la_i|G||H_i|}{|S|^3}=\frac{\la_i|H_i|}{|S|}$, we have $|S| \Big| \la_i|H_i|$, for each $1 \le i \le r$.
  1145	
  1146	(3) can be proved in a similar manner as above.
  1147	\end{proof}
  1148	
  1149	\begin{remark}\label{rem-equalsize}
  1150	%An interesting phenomenon is that every \emph{known} primitive formally dual pair lives in a group with square order, and the two subsets have equal size. Proposition~\ref{prop-chain}(4) shows that this must be the case when the primitive formally dual set is with respect to a chain of subgroups.
  1151	We observe that Proposition~\ref{prop-chain}(4) still holds under a weaker condition:
  1152	\begin{equation}\label{eqn-weaker}
  1153	H_1=\{1\}, \quad H_r=G, \quad |\bigcap_{i=2}^r H_i|>1.
  1154	\end{equation}
  1155	Note that we have a chain of subgroups $H_1 \lneqq H_2 \lneqq \cdots \lneqq H_r$ in Proposition~\ref{prop-chain}, which implies \eqref{eqn-weaker}. Moreover, the primitive formally dual pairs derived in Theorems~\ref{thm-RDS} and~\ref{thm-GRDS} fit into the model of Proposition~\ref{prop-chain}. On the other hand, the primitive formally dual pairs in Theorem~\ref{thm-SHDS} seem to be more complicated.
  1156	\end{remark}
