+
+
+def _conjugate_monomial(inst: dict, rng: random.Random,
+                        do_transpose: bool) -> tuple[dict, list[list[int]]]:
+    """Apply a basis relabeling and carry the dense inverse-adjoint witness."""
+    p = inst["p"]
+    n = inst["dimension"]
+    a = inst["automorphism"]
+    b = _expand_answer(inst["answer"], p)
+    perm = list(range(n))
+    rng.shuffle(perm)
