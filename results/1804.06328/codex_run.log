   244	def attempt(mod, model, params, seed, key):
   245	    """One oracle call.  Returns the transcript record for it."""
   246	    inst = mod.make_instance(seed=seed, **params)
   247	    t0 = time.time()
   248	    reply, status, finish, error, empty = ask(model, mod.render(inst), key)
   249	    elapsed = round(time.time() - t0, 2)
   250	
   251	    rec = {
   252	        "schema_version": SCHEMA_VERSION,
   253	        "model": model,
   254	        "effort": ORACLE_EFFORT,
   255	        "params": dict(params),
   256	        "seed": seed,
   257	        "solved": "error",
   258	        "parsed": False,
   259	        "verify_ok": None,
   260	        "verify_reason": None,
   261	        "reply": reply,
   262	        "error": error,
   263	        "elapsed_sec": elapsed,
   264	        "http_status": status,
   265	        "finish_reason": finish,
   266	    }
   267	    if empty:
   268	        # Scored as an unsolved attempt, not an API error: the model returned no
   269	        # witness within its budget.  error stays None so the invariant
   270	        # "error is not None => solved == 'error'" holds.
   271	        rec["solved"] = "failed"
   272	        rec["verify_reason"] = f"empty length-limited response ({error})"
   273	        rec["error"] = None
   274	        return rec
   275	    if error is not None:
   276	        return rec
   277	
   278	    ans = mod.parse_answer(reply)
   279	    rec["parsed"] = ans is not None
   280	    if ans is None:
   281	        # Not an error, and not evidence of hardness either: a reply that
   282	        # visibly contains an answer but does not parse is a renderer bug.
   283	        rec["solved"] = "failed"
   284	        rec["verify_reason"] = "parse_answer returned None"
   285	        return rec
   286	
   287	    ok, why = mod.verify(inst, ans)
   288	    rec["verify_ok"] = bool(ok)
   289	    rec["verify_reason"] = why
   290	    rec["solved"] = "solved" if ok else "failed"
   291	    return rec
   292	
