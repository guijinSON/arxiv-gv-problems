+    # visible in the emitted matrix's first row and column.
+    v0_inv = _inv(v[0], p)
+    left = [(x * v0_inv) % p for x in v]
+    right = [(v[0] * x) % p for x in u]
+    alpha = (-_inv(1 + wanted_trace, p)) % p
+    answer = {"alpha": alpha, "left": left, "right": right}
