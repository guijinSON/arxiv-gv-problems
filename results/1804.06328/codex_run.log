   880	|\chi_{a,b}(S)|^2=\begin{cases}
   881	  q^2 & \mbox{if $a=b=0$,} \\
   882	  \frac{q^2+q}{4} & \mbox{if $a+\al b=0$ or $a+\be b=0$,} \\
   883	  q & \mbox{if $a+\al b \in D^*,a+\be b \in D^{*(-1)}$ or $a+\al b \in D^{*(-1)},a+\be b \in D^{*}$,} \\
