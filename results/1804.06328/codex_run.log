  1158	
  1159	
  1160	
  1161	\subsection{Primitive formally dual sets with small rank}\label{sec:fd_small_rank}
  1162	
  1163	In this subsection we focus on primitive formally dual sets with small rank. We give a characterization of primitive formally dual sets with rank at most three. In particular, the rank three case reveals the relation between a primitive formally dual set and an $(n,n,n,1)$-RDS.
  1164	
  1165	Let $S$ be a primitive formally dual set in $G$, with respect to $H_i$, $1 \le i \le r$. The following definition provides a crucial viewpoint on the relation among the subgroups $H_i$.
  1166	
  1167	\begin{definition}
  1168	Let $H_i$, $1 \le i \le r$, be a collection of subgroups in $G$. A subgroup $H_j$ is called maximal, if it is not a subgroup of any other $H_i$. A subgroup $H_j$ is called minimal, if it does not contain any other $H_i$ as a subgroup.
  1169	\end{definition}
  1170	
  1171	The concept of maximal or minimal subgroups reveals more structural information about primitive formally dual sets.
  1172	
  1173	\begin{lemma}\label{lem-twomaximal}
  1174	Let $S$ be a primitive formally dual set in $G$, with respect to $H_i$, $1 \le i \le r$. Then $H_i$, $1 \le i \le r$, do not have exactly two maximal subgroups or exactly two minimal subgroups.
  1175	\end{lemma}
  1176	\begin{proof}
  1177	Suppose otherwise that $H_1,H_2$ are exactly the two maximal subgroups among $H_i$, $1 \le i \le r$. Thus, for each $s_1,s_2 \in S$, we must have $s_1s_2^{-1} \in H_1 \cup H_2$. Given a $z \in S$, we claim that there exist $x\in S$ such that $ xz^{-1} \in H_1 \sm H_2$. Suppose otherwise, that $xz^{-1} \in H_2$ for each $x \in S$, then $S$ is contained in the coset $zH_2$ and $S$ is not primitive. Similarly, we can show that there must be $y\in S$ such that $zy^{-1} \in H_2 \sm H_1$. However, we have
  1178	$$
  1179	xy^{-1} = (xz^{-1})(zy^{-1}) \notin H_1\cup H_2,
  1180	$$
  1181	which yields a contradiction.
  1182	
  1183	Suppose otherwise that $H_1,H_2$ are exactly the two minimal subgroups among $H_i$, $1 \le i \le r$. Let $S$ and $T$ be a primitive formally dual pair in $G$. By Theorem~\ref{thm-convertion}, $T$ is a primitive formally dual set in $G$, with respect to $\wti{H_i}$, $1 \le i \le r$. which contains exactly two maximal subgroups $\wti{H_1}, \wti{H_2}$. This leads to a contradiction against the above conclusion.
  1184	\end{proof}
  1185	
  1186	We shall see that it is easy to characterize primitive formally dual sets of rank one and two.
  1187	
  1188	\begin{theorem}
  1189	The only primitive formally dual set of rank one is $\{1\}$ in the trivial group $G = \{1\}$.
  1190	\end{theorem}
  1191	\begin{proof}
  1192	Let $S$ be a primitive formally dual set of rank one in $G$, with respect to $H$, satisfying $SS^{(-1)} = \la H$. By Lemma~\ref{lem-prieven}(1)(2), we have $H=G=\{1\}$. Thus, $S=\{1\}$.
  1193	\end{proof}
  1194	
  1195	\begin{theorem}
  1196	There exists no primitive formally dual set of rank two.
  1197	\end{theorem}
  1198	\begin{proof}
  1199	Let $S$ be a primitive formally dual set of rank two in $G$, with respect to $H_1,H_2$. By Lemma~\ref{lem-twomaximal}, $H_1$ and $H_2$ must form a chain, say, $H_1 \lneqq H_2$. By Proposition~\ref{prop-chain}(1)(2), we have $H_1=\{1\}$, $H_2=G$ and
  1200	$$
  1201	SS^{(-1)}=|S|+G.
  1202	$$
  1203	This is impossible since the coefficients of $1$ on both sides do not match.
  1204	\end{proof}
  1205	
  1206	Now we proceed to consider the characterization of rank three primitive formally dual sets. Let $S$ be a formally dual set of rank $r$ in $G$, with respect to $H_i$, $1 \le i \le r$. Let $I$ be a subset of $\{1,2,\ldots,r\}$, define
  1207	\begin{equation}\label{eqn-defSI}
  1208	S_I=S \bigcap \Big(\bigcap_{i \in I}H_i\Big) \sm \Big(\bigcup_{j \notin I} H_j\Big).
  1209	\end{equation}
  1210	To simplify our notation, for instance, we may simply use $S_{12}$ to represent the set $S_{\{1,2\}}$. The following is a preparatory lemma.
  1211	
  1212	\begin{lemma}\label{lem-rankthree}
  1213	Let $S$ be an even set of rank three, with respect to three subgroups $H_1, H_2, H_3$, so that each of $H_t$, $1 \le t \le 3$, is maximal. Let $SS^{(-1)}=\sum_{t=1}^3 \la_tH_t$ and $\{i,j,l\}=\{1,2,3\}$. Then we have the following.
  1214	\begin{itemize}
  1215	\item[(1)] One of $S_i$ and $S_{jl}$ is empty.
  1216	\item[(2)] Suppose $S_i \ne \es$. Then for $x,y \in S_j$, we have $xy^{-1} \in H_j \cap H_l$. Moreover, if $S_1$, $S_2$ and $S_3$ are all nonempty, then $|S_1|=|S_2|=|S_3|=1$.
  1217	\item[(3)] Suppose $S_i,S_j \ne \es$ and $S_l=\es$. Then
  1218	\begin{equation}\label{eqn-SIprop}
  1219	\begin{aligned}
  1220	&\{S_i+S_i^{(-1)}\} \subset H_i \sm (H_j \cup H_l), \quad \{S_{ij}+S_{ij}^{(-1)}\} \subset (H_i \cap H_j) \sm \{1\}, \\
  1221	&\{S_iS_i^{(-1)}\} \subset H_i \cap H_l, \quad \{S_{ij}S_{ij}^{(-1)}\} \subset H_i \cap H_j, \\
  1222	&\{S_iS_j^{(-1)}+S_jS_i^{(-1)}\} \subset H_l \sm (H_i \cup H_j), \\
  1223	&\{S_iS_{ij}^{(-1)}+S_{ij}S_i^{(-1)}\} \subset H_i \sm H_j=((H_i \cap H_l) \sm \{1\}) \cup (H_i \sm (H_j \cup H_l)). \\
  1224	\end{aligned}
  1225	\end{equation}
  1226	Moreover, for each $z \in H_l \sm (H_i \cup H_j)$, we have $[S_iS_j^{(-1)}]_z \le 1$.
