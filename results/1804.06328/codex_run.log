+            {"alpha": local_alpha, "left": left, "right": right}
+        ],
+        "greedy_transpose": [
+            {"alpha": 1, "left": left, "right": right}
+        ],
+        "first_order_neumann_ansatz": [
+            {"alpha": p - 1, "left": left, "right": right}
+        ],
+        "random_restart_256": [random_candidate(inst, rng) for _ in range(256)],
+    }
