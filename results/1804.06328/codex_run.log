   468	\subsection{Construction from relative difference sets}
   469	
   470	We observe that the primitive formally dual sets $S$ and $T$ in Proposition~\ref{prop-con}(3), are simply some well-studied configuration called relative difference sets (RDSs). Next, we introduce some basic knowledge about RDSs.  For a more detailed treatment, please refer to \cite{Pott95}.
   471	
   472	\begin{definition}\label{def-RDS}
   473	Let $G$ be a group of order $mn$ and $N$ be a subgroup of order $n$. A $k$-subset $R \subset G$ is an $(m,n,k,\la)$ relative difference set in $G$ relative to $N$, if
   474	$$
   475	RR^{(-1)}=k+\la(G-N).
   476	$$
   477	Equivalently, $R \subset G$ is an $(m,n,k,\la)$ relative difference set in $G$, if
   478	$$
   479	|\chi(R)|^2=\begin{cases}
   480	  k^2 & \mbox{if $\chi$ is principal,} \\
   481	  k-\la n & \mbox{if $\chi$ is nonprincipal, but principal on $N$,} \\
   482	  k &\mbox{if $\chi$ is nonprincipal on $N$.}
   483	\end{cases}
   484	$$
   485	\end{definition}
   486	
   487	We notice that the primitive formally dual sets $S$ and $T$ in Proposition~\ref{prop-con}(3), are both $(p,p,p,1)$-RDSs in $\Z_p \times \Z_p$. Therefore, we are particularly interested in $(n,n,n,1)$-RDSs, which have been intensively studied.
   488	
   489	\begin{proposition}
   490	Let $R$ be an $(n,n,n,1)$-RDS in a group $G$ relative to a subgroup $N$.
   491	\begin{itemize}
   492	\item[(1)] {\rm \cite[Result 5.4.1]{Pott95}} If $n$ is even, then $n=2^m$, the group $G$ is isomorphic to $\Z_4^m$ and $N$ is isomorphic to $2\Z_4^m$.
   493	\item[(2)] {\rm \cite[Theorem 1.1]{BJS}} If $n$ is odd, then $n=p^m$ for some odd prime $p$.
   494	\end{itemize}
   495	\end{proposition}
   496	
   497	We observe that when $p$ is odd, all \emph{known} $(p^m,p^m,p^m,1)$-RDSs live in the elementary abelian group $\Zp^{2m}$. Below, we give two examples of $(n,n,n,1)$-RDSs. Note that the definition of Teichm\"uller set can be found at the beginning of the next subsection.
   498	
   499	\begin{example}\label{exam-RDScon}
   500	\quad
   501	\begin{itemize}
   502	\item[(1)] {\rm \cite[Theorem 1(b)]{BD}} Let $R$ be the Galois ring $\GR(4,m)$, whose additive group is $\Z_4^m$. Let $\cT$ be the Teichm\"uller set of $R$. Then $\cT$ is a $(2^m,2^m,2^m,1)$-RDS in $\Z_4^m$ relative to $2\Z_4^m$.
   503	\item[(2)] {\rm \cite[Theorem 3.13]{Pott16}} Let $H_1$ and $H_2$ be two groups. A function $f:H_1 \rightarrow H_2$ is \emph{planar}, if the mapping $f(ax)f(x)^{-1}$ is bijective for each nonidentity $a$. Let $p$ be an odd prime. Let $G$ be the elementary abelian group $\Z_p^{2m}$ and $H$ be a subgroup of $G$ isomorphic to $\Z_p^m$. Let $f$ be a planar function from $H$ to $H$. Then, $\{(x,f(x)) \mid x \in \Z_{p^m}\}$ is a $(p^m,p^m,p^m,1)$-RDS in $G=H \times H$ relative to $\{0\} \times H$. We regard the elementary abelian group $\Z_p^m$ as the additive group of the finite field $\Fpm$, the multiplication among elements of $\Z_p^m$ is well-defined. Note that $f(x)=x^2$ is a planar function from $\Z_p^m$ to $\Z_p^m$. Hence, $\{(x,x^2) \mid x \in \Z_p^m\}$ is a $(p^m,p^m,p^m,1)$-RDS in $\Z_p^m \times \Z_p^m$ relative to $\{0\}\times \Z_p^m$.
   504	\end{itemize}
   505	\end{example}
   506	
   507	\begin{remark}
   508	\quad
   509	\begin{itemize}
   510	\item[(1)] Example~\ref{exam-RDScon}(1) has been generalized in \cite{Zhou} using planar functions over characteristic $2$.
   511	\item[(2)] The above examples can be rephrased using the language of presemifields (see \cite[Construction 8.8]{Pott16}). There are many known presemifields which produce numerous $(n,n,n,1)$-RDSs \cite{Kan}, \cite[Sections 8.2, 8.3]{Pott16}.
   512	\end{itemize}
   513	\end{remark}
   514	
   515	
   516	Let $\De: G \rightarrow \wh{G}$ be an isomorphism with $\De(y)=\chi_y$ for each $y \in G$. Recall that for each subgroup $N$ of $G$, the subgroup $\wti{N}=\{y \in G \mid \mbox{$\chi_y$ principal on $N$}\}$. Thus, we have $y=1$ if and only if $\chi_y$ is principal on $G$, the element $y \in \wti{N} \setminus \{1\}$ if and only if $\chi_y$ is nonprincipal, but principal on $N$, the element $y \in G \sm \wti{N}$ if and only if $\chi_y$ is not principal on $N$. Now, we are ready to extend the construction in Proposition~\ref{prop-con}(3) from the viewpoint of RDSs.
   517	
   518	
   519	\begin{theorem}\label{thm-RDS}
   520	Let $S$ be an $(n,n,n,1)$-RDS in $G$ relative to $N$. Then $S$ and $T$ form a primitive formally dual pair in $G$, if and only if \,$T$ is an $(n,n,n,1)$-RDS in $G$ relative to $\wti{N}$. More concretely,
   521	\begin{itemize}
   522	\item[(1)] When $n$ is even, let $S$ and $T$ be two $(2^m,2^m,2^m,1)$-RDSs in $\Z_4^m$ relative to $2\Z_4^m$. Then $S$ and $T$ form a primitive formally dual pair in $\Z_4^m$. In particular, let $R$ be the Galois ring $\GR(4,m)$ and $\cT$ be the Teichm\"uller set of $R$. Then $S=\cT$ and $T=\cT$ form a primitive formally dual pair in $\Z_4^m$.
   523	\item[(2)] When $n$ is odd, $H=\Z_p^m$. Let $f_1$ and $f_2$ be two planar functions from $H$ to $H$. Then, $S=\{(x,f_1(x)) \mid x \in H\}$ and $T=\{(f_2(x),x) \mid x \in H\}$  form a primitive formally dual pair in $\Z_p^{2m}$.
   524	\end{itemize}
   525	\end{theorem}
   526	\begin{proof}
   527	Since $S$ is an $(n,n,n,1)$-RDS in $G$ relative to $N$, by definition,
   528	$$
   529	|\chi_y(S)|^2=\begin{cases}
   530	  n^2 & \mbox{if $y=0$,} \\
   531	  0  & \mbox{if $y \in \wti{N} \sm \{0\}$,} \\
   532	  n  & \mbox{if $y \in G \sm \wti{N}$.}
   533	\end{cases}
   534	$$
   535	By Proposition~\ref{prop-non}(1), we have $|T|=n$. By Definition~\ref{def-iso}, $S$ and $T$ form a formally dual pair if and only if
   536	$$
   537	\nu_T(y)=\begin{cases}
   538	  n & \mbox{if $y=0$,} \\
   539	  0  & \mbox{if $y \in \wti{N} \sm \{0\}$,} \\
   540	  1  & \mbox{if $y \in G \sm \wti{N}$,}
   541	\end{cases}
   542	$$
   543	which means that $T$ is an $(n,n,n,1)$-RDS in $G$ relative to $\wti{N}$. Since both $S$ and $T$ are RDSs, each of them cannot be contained in a coset of a proper subgroup of $G$. Thus, $S$ and $T$ form a primitive formally dual pair and therefore, the necessary and sufficient condition is proved.
   544	
   545	When $n$ is even, we choose $G=\Z_4^m$. Let $S$ be a $(2^m,2^m,2^m,1)$-RDS in $G$ relative to $N=2\Z_4^{m}$. For $y \in \Z_4^m$, define a character $\chi_y(a)=(\sqrt{-1})^{y\cdot a}$ for each $a \in \Z_4^m$, where $\cdot$ represents the usual inner product in $\Z_4^m$. Let $\De: y \mapsto \chi_y$ be a group isomorphism from $G$ to $\wh{G}$. Then, we have $\wti{N}=\wti{N}(\De)=2\Z_4^m$. Note that $T$ is a $(2^m,2^m,2^m,1)$-RDS in $G$ relative to $\wti{N}=2\Z_4^{m}$. Then, $S$ and $T$ form a primitive formally dual pair in $\Z_4^m$. In particular, by Example~\ref{exam-RDScon}(1), we can choose $S=T=\cT$.
   546	
   547	When $n$ is odd, we choose $G=\Z_p^{2m}$, such that $G=H \times H$. By Example~\ref{exam-RDScon}(2), $S$ is a $(p^m,p^m,p^m,1)$-RDS in $G$ relative to $N=\{0\} \times H$. Each $y \in \Z_p^{2m}$ can be written as $y=(y_1,y_2) \in \Z_p^m \times \Z_p^m$. For $y=(y_1,y_2) \in \Z_p^m \times \Z_p^m$, define a character $\chi_{y_1,y_2}(a_1,a_2)=\zp^{y_1 \cdot a_1+y_2 \cdot a_2}$ for each $(a_1,a_2) \in \Z_p^m \times \Z_p^m$, where $\zp$ is a primitive $p$-th root of unity and $\cdot$ represents the usual inner product in $\Z_p^m$. Let $\De^{\pr}: (y_1,y_2) \mapsto \chi_{y_1,y_2}$ be a group isomorphism from $G$ to $\wh{G}$. Then, we have $\wti{N}=\wti{N}(\De^{\pr})=H \times \{0\}$. Note that by Example~\ref{exam-RDScon}(2), $T$ is a $(p^m,p^m,p^m,1)$-RDS in $G$ relative to $\wti{N}=H \times \{0\}$. Then $S$ and $T$ form a primitive formally dual pair in $\Z_p^{2m}$.
   548	\end{proof}
   549	
   550	\begin{remark}
   551	\quad
   552	\begin{itemize}
   553	\item[(1)] Let $p$ be an odd prime. By Example~\ref{exam-RDScon}(2), $f(x)=x^2$ is a planar function from $\Z_p$ to $\Z_p$. Applying Theorem~\ref{thm-RDS}(2), we recover the primitive formally dual pairs in Proposition~\ref{prop-con}(3).
   554	\item[(2)] Theorem~\ref{thm-RDS} indicates that given an $(n,n,n,1)$-RDS $S$ in $G$ relative to $N$, every $(n,n,n,1)$-RDS $T$ in $G$ relative to $\wti{N}$ can be used to form a primitive formally dual pair in $G$. We note there are many inequivalent $(n,n,n,1)$-RDS (see \cite{Kan} and \cite[Sections 8.2, 8.3]{Pott16}). Consequently, given a primitive formally dual set $S$, there can be more than one primitive formally dual sets $T$, which are pairwise inequivalent, so that $S$ and $T$ form a primitive formally dual pair in $G$.
   555	\end{itemize}
   556	\end{remark}
   557	
   558	The following two examples show that by applying the product construction to $(n,n,n,1)$-RDSs and products of the TITO configurations, we can obtain many inequivalent primitive formally dual pairs in one group.
   559	
   560	\begin{example}
   561	Let $m \ge 2$. We aim to show that there are at least $m+1$ inequivalent primitive formally dual pairs in $G=\Z_4^m$. Write $m=m_1+m_2$, where $0 \le m_1, m_2 \le m$. Let $S_1=T_1$ be a product of $m_1$ copies of the TITO configuration in $\Z_4^{m_1}$ and $S_2=T_2$ be a $(2^{m_2},2^{m_2},2^{m_2},1)$-RDS in $\Z_4^{m_2}$. Then by the product construction, $S_1 \times S_2$ and $T_1 \times T_2$ form a formally dual pair in $\Z_4^m=\Z_4^{m_1} \times \Z_4^{m_2}$, such that
   562	$$
   563	\{|\chi(S_1 \times S_2)|^2 \mid \chi \in \wh{G}\}=\{|\chi(T_1 \times T_2)|^2 \mid \chi \in \wh{G}\}=\{0,2^{m+s},2^{m+m_2+s} \mid 0 \le s \le m_1\}.
   564	$$
   565	Since the multiplicity of $4^m$ is $1$, by Lemma~\ref{lem-priset}, $S_1 \times S_2$ and $T_1 \times T_2$ form a primitive formally dual pair in $G$. Moreover, since the multiplicity of $0$ is equal to $4^m-3^{m_1}(4^{m_2}-2^{m_2}+1)$, distinct choices of $0 \le m_1 \le m$ yield distinct character spectra of $S_1 \times S_2$ and $T_1 \times T_2$. Thus, there are at least $m+1$ inequivalent primitive formally dual pairs in $\Z_4^m$.
   566	\end{example}
   567	
   568	\begin{example}
   569	Let $p$ be an odd prime and $m \ge 2$. We aim to show that there are at least $\lf \frac{m}{2} \rf+1$ inequivalent primitive formally dual pairs in $G=\Z_p^{2m}$. Write $m=m_1+m_2$, where $0 \le m_1 \le m_2 \le m$. Let $S_1=T_1$ be a $(p^{m_1},p^{m_1},p^{m_1},1)$-RDS in $\Z_p^{2m_1}$ and $S_2=T_2$ be a $(p^{m_2},p^{m_2},p^{m_2},1)$-RDS in $\Z_p^{2m_2}$. Then by the product construction, $S_1 \times S_2$ and $T_1 \times T_2$ form a formally dual pair in $\Z_p^{2m}=\Z_p^{2m_1} \times \Z_p^{2m_2}$, such that
   570	$$
   571	\{|\chi(S_1 \times S_2)|^2 \mid \chi \in \wh{G}\}=\{|\chi(T_1 \times T_2)|^2 \mid \chi \in \wh{G}\}=\{0,p^{m},p^{m+m_1},p^{m+m_2},p^{2m}\}.
   572	$$
   573	Since the multiplicity of $p^{2m}$ is equal to $1$, by Lemma~\ref{lem-priset}, $S_1 \times S_2$ and $T_1 \times T_2$ form a primitive formally dual pair in $G$. Moreover, distinct choices of $0 \le m_1 \le \lf \frac{m}{2} \rf$ yield distinct character spectra of $S_1 \times S_2$ and $T_1 \times T_2$. Thus, there are at least $\lf \frac{m}{2} \rf+1$ inequivalent primitive formally dual pairs in $\Zp^{2m}$.
   574	\end{example}
   575	
   576	\subsection{Construction from generalized relative difference sets}
   577	
   578	In this subsection, we aim to extend the construction in Proposition \ref{prop-con}(4). Although the primitive formally dual sets in that construction are not RDSs any more, we realize they are indeed some natural extensions of RDSs. Next, we introduce the concept of generalized relative difference sets (GRDSs), which live in the products of Galois rings. For this purpose, we first recall some basic facts about Galois rings. For a more detailed treatment, please refer to \cite[Chapter 14]{Wan}.
   579	
   580	Let $p$ be a prime and $t$ be a positive integer. Let $f \in \Z_{p^t}[x]$ be a monic polynomial of degree $s$ such that the image of $f$ under the natural projection $\Z_{p^t}[x] \rightarrow \Zp[x]$ is irreducible over $\Zp$. Then the quotient ring $\Z_{p^t}[x]/(f(x))$ is called a Galois ring of characteristic $p^t$ and rank $s$, denoted by $\GR(p^t,s)$. For $0 \le i \le t$, define $(p^i)=p^i\GR(p^t,s)$. The Galois ring $\GR(p^t,s)$ contains a chain of principal ideals $\{0\}=(p^t) \subset (p^{t-1}) \subset \cdots \subset (p) \subset \GR(p^t,s)$. In this section, we always use $R$ to denote the Galois ring $\GR(p^t,s)$. For $0 \le i \le t-1$, define $R_i=(p^i) \sm (p^{i+1})$, and $R_t=\{0\}$. Then $\{R_i \mid 0 \le i \le t\}$ forms a partition of $R$. For each $a \in R$, define $v_p(a)=i$, if $a \in R_i$, where $0 \le i \le t$.
   581	
   582	The group of units $R_0$ contains a unique cyclic subgroup of order $p^s-1$, which is denoted by $\cT^*$. The Teichm\"uller set of $R$ is $\cT=\cT^* \cup \{0\}$. Each $x \in R$ can be uniquely expressed as $x=\sum_{i=0}^{t-1} p^ix_i$, where $x_i \in \cT$ for each $0 \le i \le t-1$. The Frobenius automorphism $\sig$ of the Galois ring $R$ is defined to be
   583	\begin{align*}
   584	\sig: R &\rightarrow R, \\
   585	        \sum_{i=0}^{t-1} p^i x_i &\mapsto \sum_{i=0}^{t-1} p^i x_i^p,
   586	\end{align*}
   587	where $x_i \in \cT$ for each $0 \le i \le t-1$. For each $x \in R$, the trace function from $R$ to $\Z_{p^t}$ is defined as
   588	$$
   589	\Tr(x)=\sum_{i=0}^{s-1} \sig^{i}(x).
   590	$$
   591	
   592	For each $a \in R$, we can define a character $\chi_a$ from the additive group of $R$ to the multiplicative group of the complex field $\C$, such that $\chi_a(x)=\zpt^{\Tr(ax)}$ for each $x \in R$, where $\zpt$ is a primitive $p^t$-th root of unity. Moreover, the set $\{\chi_a \mid a \in R \}$ contains all characters of $R$. For $0 \le i \le t$, it is easy to see that
   593	\begin{equation}\label{eqn-GR1}
   594	\chi_a((p^i))=\begin{cases}
   595	  p^{(t-i)s} & \mbox{if $v_p(a) \ge t-i$,} \\
   596	  0          & \mbox{if $v_p(a) \le t-i-1$.}
   597	\end{cases}
   598	\end{equation}
   599	Consequently, for $0 \le i \le t-1$,
   600	\begin{equation}\label{eqn-GR2}
   601	\chi_a(R_i)=\begin{cases}
   602	  p^{(t-i)s}-p^{(t-i-1)s} & \mbox{if $v_p(a) \ge t-i$,} \\
   603	  -p^{(t-i-1)s} & \mbox{if $v_p(a)=t-i-1$,} \\
   604	  0          & \mbox{if $v_p(a) < t-i-1$,}
   605	\end{cases}
   606	\end{equation}
   607	and $\chi_a(R_t)=1$.
   608	
   609	Now we are ready to define the generalized relative difference sets.
   610	
   611	\begin{definition}\label{def-GRDS}
   612	Let $R=\GR(p^t,s)$ and $G=R\times R$. A set $S \subset G$ is a generalized relative difference set in $G$ relative to $\{R_i \times (p^i) \mid 0 \le i \le t\}$, if
   613	$$
   614	\nu_{S}((a,b))=\begin{cases}
   615	  p^{v_p(a)s} & \mbox{if $v_p(a) \le v_p(b)$,} \\
   616	  0           & \mbox{if $v_p(a) > v_p(b)$.}
   617	\end{cases}
   618	$$
   619	Equivalently,
   620	$$
   621	SS^{(-1)}=\sum_{i=0}^t p^{is} (R_i \times (p^i)).
   622	$$
   623	A set $T \subset G$ is a generalized relative difference set in $G$ relative to $\{(p^i) \times R_i \mid 0 \le i \le t\}$, if
   624	$$
   625	\nu_{T}((a,b))=\begin{cases}
   626	  p^{v_p(b)s} & \mbox{if $v_p(a) \ge v_p(b)$,} \\
   627	  0           & \mbox{if $v_p(a) < v_p(b)$.}
   628	\end{cases}
   629	$$
   630	Equivalently,
   631	$$
   632	TT^{(-1)}=\sum_{i=0}^t p^{is} ((p^i) \times R_i).
   633	$$
   634	\end{definition}
   635	
   636	Let $R=\GR(p^t,s)$ and $G=R \times R$. Below, we also use $R$ and $R \times R$ to represent their additive groups. For $(a,b) \in R \times R$, we can define a character $\chi_{a,b}$ from $R \times R$ to the multiplicative group of the complex field $\C$, such that $\chi_{a,b}((x,y))=\zpt^{\Tr(ax+by)}$ for each $(x,y) \in R \times R$, where $\zpt$ is a primitive $p^t$-th root of unity. Indeed, $\{\chi_{a,b} \mid a,b \in R\}$ is the set of all characters of $R \times R$.  Define a group isomorphism $\De: R \times R \rightarrow \wh{R \times R}$, which satisfies $\De((a,b))=\chi_{a,b}$ for each $(a,b) \in R \times R$. Throughout the rest of this subsection, we always implicitly use this isomorphism in our construction. The following proposition describes GRDSs from the viewpoint of their character values.
   637	
   638	\begin{proposition}\label{prop-GRDSchar}
   639	Let $R=\GR(p^t,s)$ and $G=R\times R$. A set $S \subset G$ is a GRDS in $G$ relative to $\{R_i \times (p^i) \mid 0 \le i \le t\}$, if and only if
   640	$$
   641	|\chi_{a,b}(S)|^2=\begin{cases}
   642	  p^{(t+v_p(b))s} & \mbox{if $v_p(a) \ge v_p(b)$,} \\
   643	  0               & \mbox{if $v_p(a) < v_p(b)$.}
   644	\end{cases}
   645	$$
   646	A set $T \subset G$ is a GRDS in $G$ relative to $\{(p^i) \times R_i \mid 0 \le i \le t\}$, if and only if
   647	$$
   648	|\chi_{a,b}(T)|^2=\begin{cases}
   649	  p^{(t+v_p(a))s} & \mbox{if $v_p(a) \le v_p(b)$,} \\
   650	  0               & \mbox{if $v_p(a) > v_p(b)$.}
   651	\end{cases}
   652	$$
   653	\end{proposition}
   654	\begin{proof}
   655	It suffices to prove the first equation since the second one is analogous. By Definition~\ref{def-GRDS},
   656	$$
   657	SS^{(-1)}=\sum_{i=0}^t p^{is} (R_i \times (p^i)).
   658	$$
   659	Therefore,
   660	$$
   661	|\chi_{a,b}(S)|^2=\sum_{i=0}^t p^{is}\chi_a(R_i)\chi_b((p^i))=p^{ts}+\sum_{i=0}^{t-1} p^{is} \chi_a(R_i)\chi_b((p^i)).
   662	$$
   663	To compute $|\chi_{a,b}(S)|^2$, we are going to use \eqref{eqn-GR1} and \eqref{eqn-GR2} frequently below.
   664	
   665	If $v_p(a) \ge v_p(b)$, then
   666	\begin{align*}
   667	|\chi_{a,b}(S)|^2&=p^{ts}+\sum_{i=t-v_p(b)}^{t-1} p^{is} \chi_a(R_i)\chi_b((p^i)) \\
   668	                 &=p^{ts}+\sum_{i=t-v_p(b)}^{t-1} p^{is} (p^{(t-i)s}-p^{(t-i-1)s}) p^{(t-i)s} \\
   669	                 &=p^{(t+v_p(b))s}.
   670	\end{align*}
   671	
   672	If $v_p(a)<v_p(b)$, then
   673	\begin{align*}
   674	|\chi_{a,b}(S)|^2&=p^{ts}+\sum_{i=t-v_p(a)-1}^{t-1} p^{is} \chi_a(R_i)\chi_b((p^i)) \\
   675	                 %&=p^{ts}+\sum_{i=t-v_p(a)-1}^{t-1} p^{is} \chi_a(R_i)\chi_b((p^i)) \\
   676	                 &=p^{ts}+p^{(t-v_p(a)-1)s}(-p^{v_p(a)s})p^{(v_p(a)+1)s}+\sum_{i=t-v_p(a)}^{t-1} p^{is}(p^{(t-i)s}-p^{(t-i-1)s})p^{(t-i)s} \\
   677	                 &=p^{ts}+p^{ts}(-p^{v_p(a)s})+p^{ts}(p^{v_p(a)s}-1) \\
   678	                 &=0.
   679	\end{align*}
   680	Therefore,
   681	$$
   682	|\chi_{a,b}(S)|^2=\begin{cases}
   683	  p^{(t+v_p(b))s} & \mbox{if $v_p(a) \ge v_p(b)$,} \\
   684	  0               & \mbox{if $v_p(a) < v_p(b)$.}
   685	\end{cases}
   686	$$
   687	\end{proof}
   688	
   689	Now we are ready to extend the construction in Proposition~\ref{prop-con}(4) from the viewpoint of GRDSs.
   690	
   691	\begin{theorem}\label{thm-GRDS}
   692	Let $R=\GR(p^t,s)$ and $G=R\times R$. Let $S$ be a GRDS in $G$ relative to $\{R_i \times (p^i) \mid 0 \le i \le t\}$. Then $S$ and $T$ form a primitive formally dual pair in $G$ if and only if $T$ is a GRDS in $G$ relative to $\{(p^i) \times R_i \mid 0 \le i \le t\}$. Moreover, $T$ can be chosen as $T=\{(x,y) \in G \mid (y,x) \in S\}$.
   693	\end{theorem}
   694	\begin{proof}
   695	By Proposition~\ref{prop-GRDSchar}, we have
   696	$$
   697	|\chi_{a,b}(S)|^2=\begin{cases}
   698	  p^{(t+v_p(b))s} & \mbox{if $v_p(a) \ge v_p(b)$,} \\
   699	  0               & \mbox{if $v_p(a) < v_p(b)$.}
   700	\end{cases}
   701	$$
   702	By Definition~\ref{def-iso}, $S$ and $T$ form a formally dual pair in $G$ if and only if
   703	\begin{equation}\label{eqn-T}
   704	\nu_T((a,b))=\begin{cases}
   705	  p^{v_p(b)s} & \mbox{if $v_p(a) \ge v_p(b)$,} \\
   706	  0           & \mbox{if $v_p(a) < v_p(b)$.}
   707	\end{cases}
   708	\end{equation}
   709	which, by Definition~\ref{def-GRDS}, says that $T$ is a GRDS in $G$ relative to $\{(p^i) \times R_i \mid 0 \le i \le t\}$. Since both $S$ and $T$ are GRDSs, each of them cannot be contained in a coset of a proper subgroup of $G$. Thus, $S$ and $T$ form a primitive formally dual pair. Note that $S$ satisfies
   710	\begin{equation}\label{eqn-S}
   711	\nu_{S}((a,b))=\begin{cases}
   712	  p^{v_p(a)s} & \mbox{if $v_p(a) \le v_p(b)$,} \\
   713	  0           & \mbox{if $v_p(a) > v_p(b)$.}
   714	\end{cases}
   715	\end{equation}
   716	Comparing \eqref{eqn-T} and \eqref{eqn-S}, we can choose $T$ as $T=\{(x,y) \in G \mid (y,x) \in S\}$.
   717	\end{proof}
   718	
   719	Let $p$ be an odd prime and $R=\GR(p^t,s)$. The following proposition shows that there exists a GRDS in $R \times R$.
   720	\begin{proposition}\label{prop-square}
   721	Let $p$ be an odd prime. Let $R=\GR(p^t,s)$ be a Galois ring and $G=R \times R$. Then $S=\{(x,x^2) \mid x \in R\}$ is a GRDS in $G$ relative to $\{R_i \times (p^i) \mid 0 \le i \le t\}$.
   722	\end{proposition}
   723	\begin{proof}
   724	For $(a,b) \in G$,
   725	\begin{align*}
   726	|\chi_{a,b}(S)|^2&=\sum_{x \in R} \zpt^{\Tr(ax+bx^2)}\sum_{y \in R} \zpt^{-\Tr(ay+by^2)} \\
   727	                 &=\sum_{y,z \in R} \zpt^{\Tr(a(y+z)+b(y+z)^2-ay-by^2)} \\
   728	                 &=\sum_{z \in R} \zpt^{\Tr(az+bz^2)}\sum_{y \in R} \zpt^{\Tr(2byz)}.
   729	\end{align*}
   730	
   731	If $b \ne 0$, then
   732	$$
   733	|\chi_{a,b}(S)|^2=p^{ts} \sum_{z \in (p^{t-v_p(b)})} \zpt^{\Tr(az+bz^2)}.
   734	$$
   735	Note that $bz^2=0$ for each $z \in (p^{t-v_p(b)})$. Therefore,
   736	\begin{align*}
   737	|\chi_{a,b}(S)|^2&=p^{ts} \sum_{z \in (p^{t-v_p(b)})} \zpt^{\Tr(az)} \\
   738	                 &=\begin{cases}
   739	                   p^{(t+v_p(b))s} & \mbox{if $v_p(a) \ge v_p(b)$,} \\
   740	                   0               & \mbox{if $v_p(a) < v_p(b)$.}
   741	                 \end{cases}
   742	\end{align*}
   743	If $b=0$, i.e., $v_p(b)=t$, then
   744	$$
   745	|\chi_{a,b}(S)|^2=p^{ts} \sum_{z \in R} \zpt^{\Tr(az)}=\begin{cases}
   746	                   p^{2ts} & \mbox{if $v_p(a)=t$,} \\
   747	                   0               & \mbox{if $v_p(a) < t$.}
   748	                 \end{cases}
   749	$$
   750	Consequently,
   751	$$
   752	|\chi_{a,b}(S)|^2=\begin{cases}
   753	                   p^{(t+v_p(b))s} & \mbox{if $v_p(a) \ge v_p(b)$,} \\
   754	                   0               & \mbox{if $v_p(a) < v_p(b)$.}
   755	                 \end{cases}
   756	$$
   757	By Proposition~\ref{prop-GRDSchar}, $S$ is a GRDS in $G$ relative to $\{R_i \times (p^i) \mid 0 \le i \le t\}$.
   758	\end{proof}
   759	
   760	Combining Theorem~\ref{thm-GRDS} and Proposition~\ref{prop-square}, we have the following corollary.
   761	
   762	\begin{corollary}\label{cor-GRDS}
   763	Let $p$ be an odd prime. Let $R=\GR(p^t,s)$ be a Galois ring and $G=R \times R$. Let $S=\{(x,x^2) \mid x \in R\}$ and $T=\{(x^2,x) \mid x \in R\}$. Then $S$ and $T$ form a primitive formally dual pair in $G$.
   764	\end{corollary}
   765	
   766	\begin{remark}
   767	\quad
   768	\begin{itemize}
   769	\item[(1)] Applying Corollary~\ref{cor-GRDS} with $s=1$, we reproduce the primitive formally dual pairs of Proposition~\ref{prop-con}(4), which live in $\Z_{p^t} \times \Z_{p^t}$.
   770	\item[(2)] In Proposition~\ref{prop-square}, if $p=2$, then $S$ is not a GRDS in $G$.
   771	\end{itemize}
   772	\end{remark}
   773	
   774	\subsection{Construction from skew Hadamard difference sets}
   775	
   776	The following is a construction related to skew Hadamard difference sets. We first give a brief account about skew Hadamard difference sets. For a more detailed treatment, please refer to \cite[Chapter VI, Section 8]{BJL}.
   777	
   778	\begin{definition}\label{def-DS}
   779	Let $G$ be a group of order $v$. A $k$-subset $D$ of $G$ is a $(v,k,\lambda)$ difference set in $G$, if
   780	$$
   781	DD^{(-1)}=k+\la(G-1).
   782	$$
   783	A difference set $D$ in a group $G$ is a skew Hadamard difference set, if $1$, $D$, $D^{(-1)}$ form a partition of $G$.
   784	\end{definition}
   785	
   786	We mention some known results about skew Hadamard difference sets as follows.
   787	
   788	\begin{proposition}{\rm\cite[Chapter VI, Theorem 8.7]{BJL}, \cite[Lemma 2.5, Corollary 2.7]{WH}} \label{prop-SHDS}
   789	Let $D$ be a skew Hadamard difference set in an abelian group $G$ of order $v$. Then $D$ is a $(v,\frac{v-1}{2},\frac{v-3}{4})$ difference set in $G$, where $v$ is a prime power congruent to $3$ modulo $4$. Moreover, $D^{(-1)}$ is also a skew Hadamard difference set in $G$. For each nonprincipal character $\chi$ of $G$, we have
   790	$$
   791	(\chi(D),\chi(D^{(-1)})) \in \left\{\left(\frac{-1+\sqrt{-v}}{2},\frac{-1-\sqrt{-v}}{2}\right), \left(\frac{-1-\sqrt{-v}}{2},\frac{-1+\sqrt{-v}}{2}\right)\right\}.
   792	$$
   793	Moreover, $\big\{\chi \in \wh{G} \mid \chi(D)=\frac{-1+\sqrt{-v}}{2}\big\}$ is a skew Hadamard difference set in the character group $\wh{G}$.
   794	\end{proposition}
   795	
   796	There are many known constructions of skew Hadamard difference sets in the elementary abelian group $\Zp^m$, where $p$ is an odd prime and $p^m \equiv 3 \pmod 4$. For each $a \in \Zp^m$, define $\chi_a(x)=\zp^{a\cdot x}$ for each $x \in \Zp^m$, where $a\cdot x$ is the usual inner product in $\Zp^m$ and $\zp$ is the $p$-th root of unity. Then, $\{\chi_a \mid a \in \Zp^m\}$ is the set of all characters of $\Zp^m$. Define the {\it dual set} of $D$ as
   797	$$
   798	D^*=\left\{ a \in \Zp^m \mid \chi_a(D)=\frac{-1+\sqrt{-v}}{2} \right\}.
   799	$$
   800	By Proposition~\ref{prop-SHDS}, the dual set $D^*$ is a skew Hadamard difference set in $\Zp^m$.
   801	
   802	Based on the definition of skew Hadamard difference sets $D$ and $D^*$, the following lemma follows easily:
   803	
   804	\begin{lemma}\label{lem-SHDSchar}
   805	Let $D$ be a skew Hadamard difference set in $\Zp^m$. Set $v=p^m$. For each nonzero $a,b \in \Zp^m$, we have
   806	$$
   807	\setlength{\jot}{5pt}
   808	\chi_a(D)\chi_b(D)=
   809	\left\{\begin{aligned}
   810	  &\frac{1-2\sqrt{-v}-v}{4} & \mbox{if $a,b \in D^*$,} \\
   811	  &\frac{v+1}{4}            & \mbox{if $a \in D^*, b \in D^{*(-1)}$,} \\
   812	  &\frac{1+2\sqrt{-v}-v}{4} & \mbox{if $a,b \in D^{*(-1)}$.}
   813	\end{aligned}\right.
   814	$$
   815	\end{lemma}
   816	
   817	For $a \in \Zp^m$ and $\al \in \Zp$, we have $\chi_{a}(\al x)=\chi_{\al a}(x)$ for each $x \in \Zp^m$. Moreover, for $a,b \in \Zp^m$, we have $\chi_{a+b}(x)=\chi_a(x)\chi_b(x)$ for each $x \in \Zp^m$. For $a,b \in \Zp^m$, we know that $\chi_{a,b}$ is defined to be a character of $\Zp^m \times \Zp^m$, where $\chi_{a,b}(x,y)=\chi_a(x)\chi_b(y)$ for each $x,y \in \Zp^m$. Define a group isomorphism $\De: \Zp^m \times \Zp^m \rightarrow \wh{\Zp^m \times \Zp^m}$, which satisfies $\De((a,b))=\chi_{a,b}$ for each $(a,b) \in \Zp^m \times \Zp^m$. Throughout the rest of this subsection, we always implicitly use this isomorphism in our construction. Now, we are ready to describe our construction.
   818	
   819	
   820	\begin{theorem}\label{thm-SHDS}
   821	Let $p^m \equiv 3 \pmod{4}$ be a prime power. Let $D$ be a skew Hadamard difference set in $\Zp^m$ and $G=\Zp^m \times \Zp^m$. Suppose $\al$ and $\be$ are nonzero elements of $\Zp$ with $\al \ne \be$. Define
   822	$$
   823	S=(0,0)+\sum_{x \in D} (x,\al x)+\sum_{x \in D^{(-1)}} (x, \be x)
   824	$$
   825	and
   826	$$
   827	T=(0,0)+\sum_{x \in D^*} (\frac{\al}{\al-\be}x,\frac{1}{\be-\al} x)+\sum_{x \in D^{*(-1)}} (\frac{\be}{\al-\be}x, \frac{1}{\be-\al} x).
   828	$$
   829	Then $S$ and $T$ form a primitive formally dual pair in $G$.
   830	\end{theorem}
   831	\begin{proof}
   832	Let ${\Zp^m}^*$ be the set of nonzero elements in $\Zp^m$ and $q=p^m$. Since $D$ is a skew Hadamard difference set and $D^*$ is the dual set of $D$, by Proposition~\ref{prop-SHDS},
   833	$$
   834	DD^{(-1)}=D^*D^{*(-1)}=\frac{q-1}{2} \cdot 0+\frac{q-3}{4}{\Zp^m}^*.
   835	$$
   836	Employing the above equation, it is routine to verify that
   837	\begin{align*}
   838	SS^{(-1)}=&q(0,0)+\frac{q+1}{4}\sum_{x \ne 0} (x,\al x)+\frac{q+1}{4}\sum_{x \ne 0} (x,\be x)+\sum_{\substack{x \in D \\ y \in D^{(-1)}}} (x-y,\al x-\be y) \\
   839	        &+\sum_{\substack{x \in D \\ y \in D^{(-1)}}} (y-x,\be y-\al x)
   840	\end{align*}
   841	and
   842	\begin{align*}
   843	TT^{(-1)}=&q(0,0)+\frac{q+1}{4}\sum_{x \ne 0} (\frac{\al}{\al-\be}x,\frac{1}{\be-\al} x)+\frac{q+1}{4}\sum_{x \ne 0} (\frac{\be}{\al-\be}x,\frac{1}{\be-\al} x) \\
   844	        &+\sum_{\substack{x \in D^* \\ y \in D^{*(-1)}}} (\frac{\al x-\be y}{\al-\be},\frac{x-y}{\be-\al})+\sum_{\substack{x \in D^* \\ y \in D^{*(-1)}}} (\frac{\be y-\al x}{\al-\be},\frac{y-x}{\be-\al}).
   845	\end{align*}
   846	Consequently,
   847	$$
   848	\nu_T((a,b))=\begin{cases}
   849	  q & \mbox{if $a=b=0$,} \\
   850	  \frac{q+1}{4} & \mbox{if $a+\al b=0$ or $a+\be b=0$,} \\
   851	  1 & \mbox{if $a+\al b \in D^*,a+\be b \in D^{*(-1)}$ or $a+\al b \in D^{*(-1)},a+\be b \in D^{*}$,} \\
   852	  0 & \mbox{if $a+\al b \in D^*,a+\be b \in D^{*}$ or $a+\al b \in D^{*(-1)},a+\be b \in D^{*(-1)}$.}
   853	\end{cases}
   854	$$
   855	
   856	On the other hand, for each $a,b \in \Zp^m$, recall that $\chi_{a+b}(x)=\chi_a(x)\chi_b(x)$ for each $x \in \Zp^m$. Then, we have
   857	\begin{align*}
   858	|\chi_{a,b}(S)|^2=&q+\frac{q+1}{4} \chi_{a+\al b}({\Zp^m}^*)+\frac{q+1}{4} \chi_{a+\be b}({\Zp^m}^*)\\ &+\chi_{a+\al b}(D)\chi_{a+\be b}(D)+\chi_{-(a+\al b)}(D)\chi_{-(a+\be b)}(D).
   859	\end{align*}
   860	Below, we are going to use Lemma~\ref{lem-SHDSchar} frequently.
   861	
   862	If $a+\al b=0$, then $a+\be b \ne 0$ and
   863	$$
   864	|\chi_{a,b}(S)|^2=q+\frac{q+1}{4}(q-1)+\frac{q+1}{4}(-1)+\frac{q-1}{2}\chi_{a+\be b}({\Zp^m}^*)=\frac{q^2+q}{4}.
   865	$$
   866	Similarly, if $a+\be b=0$, we also have
   867	$$
   868	|\chi_{a,b}(S)|^2=\frac{q^2+q}{4}.
   869	$$
   870	If $a+\al b \in D^*$, $a+\be b \in D^{*(-1)}$ or $a+\al b \in D^{*(-1)}$, $a+\be b \in D^{*}$, then
   871	$$
   872	|\chi_{a,b}(S)|^2=q-\frac{q+1}{4}-\frac{q+1}{4}+2\frac{(q+1)}{4}=q.
   873	$$
   874	If $a+\al b,a+\be b \in D^*$, or $a+\al b,a+\be b \in D^{*(-1)}$, then
   875	$$
   876	|\chi_{a,b}(S)|^2=q-\frac{q+1}{4}-\frac{q+1}{4}+\frac{(1-2\sqrt{-q}-q)}{4}+\frac{(1+2\sqrt{-q}-q)}{4}=0.
   877	$$
   878	Therefore,
   879	$$
   880	|\chi_{a,b}(S)|^2=\begin{cases}

