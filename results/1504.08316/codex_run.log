+    parsed = parse_answer(realistic)
+    fenced = parse_answer("Result:\n```json\n" + json.dumps(answer) + "\n```")
+    report["G3_round_trip"] = {
+        "pass": (
+            parsed == answer
+            and fenced == answer
+            and verify(ship, parsed)[0]
