+def _attack_random_restart(
+    inst: dict,
+    rng: random.Random,
+    restarts: int = 32,
+    passes: int = 2,
+) -> tuple[bool, int]:
+    """Random-restart coordinate ascent, a mild generic CSP heuristic."""
+    trials = 0
+    for _ in range(restarts):
+        bits = [rng.randrange(2) for _ in range(inst["n"])]
+        score = _satisfied_count(inst, bits)
+        if score == len(inst["constraints"]):
+            return True, trials
+        for _ in range(passes):
+            changed = False
+            order = list(range(inst["n"]))
+            rng.shuffle(order)
+            for variable in order:
+                bits[variable] ^= 1
+                proposed = _satisfied_count(inst, bits)
+                trials += len(inst["constraints"])
+                if proposed > score:
+                    score = proposed
+                    changed = True
+                    if score == len(inst["constraints"]):
+                        return True, trials
+                else:
+                    bits[variable] ^= 1
+            if not changed:
+                break
+    return False, trials
