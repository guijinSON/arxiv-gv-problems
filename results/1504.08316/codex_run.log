from gen_2306_10294 import DIFFICULTY, make_instance, parse_answer, verify

inst = make_instance(seed=7, **DIFFICULTY["medium"])
candidate = parse_answer("<answer>2147483647, 123</answer>")
ok, reason = verify(inst, candidate)
~~~

