for n,d in [(71,500),(83,600),(89,700),(95,1000),(98,1400)]:
    succ=0; nodes=[]; ops=[]
    for seed in range(800,820):
        x=g.make_instance(n=n,decoys=d,seed=seed)
        a,_=g._attack_greedy(x)
        succ += g.verify(x,a)[0]
        if seed<808:
            _,o,k=g._compact_cycle_solve(x); nodes.append(k); ops.append(o)
    print(n,d,'greedy',succ,'/20','nodes',sum(nodes)//len(nodes),'maxnodes',max(nodes),'ops',ops[0])
