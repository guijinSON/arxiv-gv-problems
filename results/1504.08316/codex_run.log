+
+    ladder_n = [params["n"] for params in DIFFICULTY.values()]
+    ladder_constraints = [params["n"] + params["decoys"] for params in DIFFICULTY.values()]
+    doubled_n = 2 * ship["n"]
+    if doubled_n % 3 == 0:
