+def _attack_left_to_right(inst: dict) -> tuple[list[int], int]:
+    """Commit the last unassigned variable of each usable equation, no revision."""
+    bits: list[int | None] = [None] * inst["n"]
+    steps = 0
+    for constraint in inst["constraints"]:
+        unknown = [v for v in constraint["vars"] if bits[v] is None]
+        if len(unknown) != 1:
+            continue
+        value = constraint["rhs"]
+        for variable in constraint["vars"]:
+            if variable != unknown[0]:
+                value ^= int(bits[variable])
+                steps += 1
+        bits[unknown[0]] = value
+    completed = [0 if value is None else value for value in bits]
+    return _signed_answer(completed), steps
+
+
+def _transform_instance(
+    inst: dict,
+    old_to_new: list[int],
+    complemented_old: set[int],
+    rng: random.Random,
+) -> dict:
+    """Apply a variable relabelling, coordinate flips, and input reorder."""
+    n = inst["n"]
+    old_bits, reason = _bits_from_answer(inst, inst["answer"])
+    if old_bits is None:
+        raise AssertionError(reason)
+    new_bits = [0] * n
+    for old, new in enumerate(old_to_new):
+        new_bits[new] = old_bits[old] ^ int(old in complemented_old)
+
+    constraints = []
+    for constraint in inst["constraints"]:
+        rhs = constraint["rhs"]
+        for old in constraint["vars"]:
+            rhs ^= int(old in complemented_old)
+        variables = [old_to_new[old] for old in constraint["vars"]]
+        rng.shuffle(variables)
+        constraints.append({"vars": variables, "rhs": rhs})
+    rng.shuffle(constraints)
+
+    moved = copy.deepcopy(inst)
+    moved["constraints"] = constraints
+    moved["answer"] = _signed_answer(new_bits)
+    return moved
+
