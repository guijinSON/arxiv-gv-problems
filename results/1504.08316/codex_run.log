+def _attack_random_restart(inst: dict, rng: random.Random, restarts: int = 256) -> tuple[bool, int]:
+    for attempt in range(1, restarts + 1):
+        if verify(inst, random_candidate(inst, rng))[0]:
+            return True, attempt
+    return False, restarts
