+        "exact_fraction": 2.0 ** (-ship["n"]),
+        "candidate_space": search_space(ship),
+        "sampling_prior": "uniform over canonical complete Boolean assignments",
+        "wall_clock_sec": round(guess_wall, 6),
+    }
+
+    attack_names = (
