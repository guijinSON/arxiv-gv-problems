+
+    invariant_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    unrelated_keys = []
+    for seed in range(20):
+        inst = make_instance(n=29, decoys=50, seed=20_000 + seed)
+        base_key = canonical_key(inst)
+        unrelated_keys.append(base_key)
