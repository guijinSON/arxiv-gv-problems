+# Adversarial attacks used by selftest
+
+def _centered(value, p):
+    value %= p
+    return value if value <= p // 2 else value - p
+
+
+def _outlier_attack(inst):
+    """Select the half with the largest marginal correlation to the target."""
+    p = inst["p"]
+    target = [_centered(x, p) for x in inst["offset"]]
+    scored = []
+    for i, vector in enumerate(inst["coefficients"]):
+        centered = [_centered(x, p) for x in vector]
+        score = sum(a * b for a, b in zip(centered, target))
+        scored.append((score, i))
+    chosen = {i for _, i in sorted(scored, reverse=True)[:inst["m"] // 2]}
+    return [int(i in chosen) for i in range(inst["m"])]
+
+
+def _greedy_residual_attack(inst):
+    """Construction-aware greedy search constrained to balanced witnesses."""
+    p = inst["p"]
+    residual = list(inst["offset"])
+    available = set(range(inst["m"]))
+    chosen = set()
+    for _ in range(inst["m"] // 2):
+        best = None
+        for i in available:
+            trial = _sub(residual, inst["coefficients"][i], p)
+            score = sum(_centered(x, p) ** 2 for x in trial)
+            key = (score, i)
+            if best is None or key < best[0]:
+                best = (key, i, trial)
+        _, index, residual = best
+        chosen.add(index)
+        available.remove(index)
+    return [int(i in chosen) for i in range(inst["m"])]
