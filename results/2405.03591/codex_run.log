+# ---------------------------------------------------------------------------
+# Mandatory gates
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def _apply_coordinate_map(inst, matrix):
+    transformed = copy.deepcopy(inst)
+    p = inst["p"]
+    transformed["coefficients"] = [
+        _mat_vec(matrix, vector, p) for vector in inst["coefficients"]
+    ]
+    for key in ("rhs", "baseline", "offset"):
+        transformed[key] = _mat_vec(matrix, inst[key], p)
+    return transformed
+
+
+def _permute_variables(inst, permutation):
+    transformed = copy.deepcopy(inst)
+    transformed["coefficients"] = [
+        inst["coefficients"][old] for old in permutation
+    ]
+    transformed["answer"] = [inst["answer"][old] for old in permutation]
+    return transformed
+
+
+def _elementary_basis_map(n, p, seed):
+    rng = random.Random(seed)
+    matrix = [[int(i == j) for j in range(n)] for i in range(n)]
+    if n >= 2:
+        a, b = rng.sample(range(n), 2)
+        matrix[a], matrix[b] = matrix[b], matrix[a]
+        scalar = rng.randrange(1, p)
+        matrix[a] = [(scalar * x) % p for x in matrix[a]]
+        shear = rng.randrange(1, p)
+        matrix[b] = [(x + shear * y) % p
+                     for x, y in zip(matrix[b], matrix[a])]
+    return matrix
+
