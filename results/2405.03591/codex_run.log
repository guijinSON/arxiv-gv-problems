+        if bit:
+            for j in range(n):
+                total[j] += vector[j]
+    return [value % p for value in total]
+
+
+def _native_group_lhs(inst, answer):
+    """Evaluate the vector part of the displayed spherical product directly."""
+    p = inst["p"]
+    n = inst["n"]
+    total = [0] * n
+    # Section 1.4's conjugation formula gives
+    # z_i^-1 (v_i,1) z_i = ((1+x_i)v_i,1) for the two allowed z_i.
+    for bit, vector in zip(answer, inst["coefficients"]):
+        multiplier = 1 + bit
+        for j in range(n):
+            total[j] += multiplier * vector[j]
+    return [value % p for value in total], 1
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    """Check any valid binary group-equation witness; never read inst['answer']."""
+    if answer is None:
+        return False, "answer is absent"
+    if not isinstance(answer, list):
+        return False, "answer must be a list of bits"
+    if not answer:
+        return False, "answer is empty"
+    m = inst["m"]
+    if len(answer) < m:
+        return False, f"answer has fewer than {m} bits"
+    if len(answer) > m:
+        return False, f"answer has more than {m} bits"
+    if any(isinstance(bit, bool) or not isinstance(bit, int) for bit in answer):
+        return False, "every bit must be an integer"
+    if any(bit not in (0, 1) for bit in answer):
+        return False, "every entry must be 0 or 1"
+    if _sub(inst["rhs"], inst["baseline"], inst["p"]) != inst["offset"]:
+        return False, "the instance's redundant offset checksum is inconsistent"
+    if _native_group_lhs(inst, answer) != (inst["rhs"], inst["rhs_scalar"]):
+        return False, "the constrained spherical equation is not satisfied"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample the statement's complete binary certificate language."""
+    mask = rng.getrandbits(inst["m"])
+    return [(mask >> i) & 1 for i in range(inst["m"])]
+
+
+def search_space(inst) -> int | None:
+    return 1 << inst["m"]
+
+
+def enumerate_all(inst) -> int | None:
+    m = inst["m"]
+    if m > 22:
+        return None
+    count = 0
+    for mask in range(1 << m):
+        candidate = [(mask >> i) & 1 for i in range(m)]
+        count += int(_equation_sum(inst, candidate) == inst["offset"])
+    return count
+
+
+# ---------------------------------------------------------------------------
+# A structural, relabelling-invariant canonical key
+
+def _det_mod(matrix, p):
+    a = [[x % p for x in row] for row in matrix]
+    result = 1
+    for col in range(len(a)):
+        pivot = next((row for row in range(col, len(a)) if a[row][col]), None)
+        if pivot is None:
+            return 0
+        if pivot != col:
+            a[pivot], a[col] = a[col], a[pivot]
+            result = -result
+        value = a[col][col] % p
+        result = result * value % p
+        inverse = pow(value, -1, p)
+        for row in range(col + 1, len(a)):
+            factor = a[row][col] * inverse % p
+            if factor:
+                for j in range(col, len(a)):
+                    a[row][j] = (a[row][j] - factor * a[col][j]) % p
+    return result % p
+
+
+def _gram_sum(inst):
+    n = inst["n"]
+    p = inst["p"]
+    gram = [[0] * n for _ in range(n)]
+    for vector in inst["coefficients"]:
+        for i in range(n):
+            for j in range(n):
+                gram[i][j] = (gram[i][j] + vector[i] * vector[j]) % p
+    return gram
+
+
+def _add_outer(matrix, vector, p):
+    return [[(matrix[i][j] + vector[i] * vector[j]) % p
+             for j in range(len(matrix))]
+            for i in range(len(matrix))]
+
+
+def canonical_key(inst) -> str:
+    """A strong cheap invariant under variable order and change of basis.
+
+    If coefficient columns are permuted, their Gram sum and ordinary sum do not
+    change.  Under an invertible coordinate map T, every determinant below is
+    multiplied by det(T)^2.  Projective normalization removes that factor.
+    This is an invariant rather than a complete isomorphism test; see README.
+    """
+    p = inst["p"]
+    gram = _gram_sum(inst)
+    base = [sum(vector[j] for vector in inst["coefficients"]) % p
+            for j in range(inst["n"])]
+    rhs = list(inst["rhs"])
+    offset = _sub(rhs, base, p)
+    matrices = [
+        gram,
+        _add_outer(gram, base, p),
+        _add_outer(gram, rhs, p),
+        _add_outer(gram, offset, p),
+        _add_outer(_add_outer(gram, base, p), offset, p),
+    ]
+    values = [_det_mod(matrix, p) for matrix in matrices]
+    pivot = next((value for value in values if value), None)
+    if pivot is None:
+        # This rare singular case deliberately over-collapses rather than break
+        # invariance.  The caveat is explicit and the sampled diversity gate
+        # exercises the overwhelmingly typical nonsingular branch.
+        normalized = [0] * len(values)
+    else:
+        inverse = pow(pivot, -1, p)
+        normalized = [value * inverse % p for value in values]
+    return json.dumps(
+        [inst["n"], inst["m"], p, normalized], separators=(",", ":")
+    )
+
+
+def escalate(params) -> dict | str | None:
+    """Raise modulus entropy at fixed witness length before admitting the cap."""
+    harder = dict(params)
+    factor = int(harder.get("modulus_factor", 4))
+    n = int(harder["n"])
+    m = int(harder.get("m") or _default_m(n))
+    # Keep n log_2(p) < m so the escalation remains in Theorem 5.2's band.
+    proposed = factor * 2
+    estimated_p = proposed * m * n ** 4
+    if n * math.log2(estimated_p) < m:
+        harder["modulus_factor"] = proposed
+        return harder
+    # A longer bit string would continue the theorem-backed schedule, but the
+    # present format caps answers at 256 atoms.
+    return "cap_bound"
+
+
+# ---------------------------------------------------------------------------
+# Adversarial attacks used by selftest
+
+def _centered(value, p):
+    value %= p
+    return value if value <= p // 2 else value - p
+
+
+def _outlier_attack(inst):
+    """Select the half with the largest marginal correlation to the target."""
+    p = inst["p"]
+    target = [_centered(x, p) for x in inst["offset"]]
+    scored = []
+    for i, vector in enumerate(inst["coefficients"]):
+        centered = [_centered(x, p) for x in vector]
+        score = sum(a * b for a, b in zip(centered, target))
+        scored.append((score, i))
+    chosen = {i for _, i in sorted(scored, reverse=True)[:inst["m"] // 2]}
+    return [int(i in chosen) for i in range(inst["m"])]
+
+
+def _greedy_residual_attack(inst):
+    """Construction-aware greedy search constrained to balanced witnesses."""
+    p = inst["p"]
+    residual = list(inst["offset"])
+    available = set(range(inst["m"]))
+    chosen = set()
+    for _ in range(inst["m"] // 2):
+        best = None
+        for i in available:
+            trial = _sub(residual, inst["coefficients"][i], p)
+            score = sum(_centered(x, p) ** 2 for x in trial)
+            key = (score, i)
+            if best is None or key < best[0]:
+                best = (key, i, trial)
+        _, index, residual = best
+        chosen.add(index)
+        available.remove(index)
+    return [int(i in chosen) for i in range(inst["m"])]
+
+
+def _random_restart_attack(inst, seed, restarts=512):
+    """Try balanced random preimages, using the generator-aware weight prior."""
+    rng = random.Random(seed)
+    m = inst["m"]
+    for _ in range(restarts):
+        chosen = set(rng.sample(range(m), m // 2))
+        candidate = [int(i in chosen) for i in range(m)]
+        if _equation_sum(inst, candidate) == inst["offset"]:
+            return candidate, restarts
+    return None, restarts
+
+
+def _lll_reduce(basis, delta=0.75, max_steps=500_000):
+    """Complete floating-point LLL with exact integer row operations.
+
+    Candidate vectors are always checked by exact modular arithmetic.  Floating
+    point is used only to guide basis reduction, as in practical LLL attacks.
+    """
+    rows = [row[:] for row in basis]
+    m = len(rows)
+    width = len(rows[0])
+    star = [[float(x) for x in row] for row in rows]
+    mu = [[0.0] * m for _ in range(m)]
+    norm = [0.0] * m
+    for i in range(m):
+        for j in range(i):
+            mu[i][j] = sum(rows[i][z] * star[j][z]
+                           for z in range(width)) / norm[j]
+            q = mu[i][j]
+            star[i] = [star[i][z] - q * star[j][z]
+                       for z in range(width)]
+        norm[i] = sum(x * x for x in star[i])
+
+    k = 1
+    steps = swaps = reductions = 0
+
+    def reduce_row(i, j):
+        nonlocal reductions
+        multiple = math.floor(mu[i][j] + 0.5)
+        if not multiple:
+            return
+        rows[i] = [a - multiple * b for a, b in zip(rows[i], rows[j])]
+        for z in range(j):
+            mu[i][z] -= multiple * mu[j][z]
+        mu[i][j] -= multiple
+        reductions += 1
+
+    while k < m and steps < max_steps:
+        steps += 1
+        if abs(mu[k][k - 1]) > 0.5:
+            reduce_row(k, k - 1)
+        if norm[k] >= (delta - mu[k][k - 1] ** 2) * norm[k - 1]:
+            for j in range(k - 2, -1, -1):
+                if abs(mu[k][j]) > 0.5:
+                    reduce_row(k, j)
+            k += 1
+            continue
+
+        nu = mu[k][k - 1]
+        alpha = norm[k] + nu * nu * norm[k - 1]
+        if not alpha or not math.isfinite(alpha):
+            break
+        beta = norm[k - 1] / alpha
+        mu[k][k - 1] = nu * beta
+        norm[k] *= beta
+        norm[k - 1] = alpha
+        rows[k], rows[k - 1] = rows[k - 1], rows[k]
+        mu[k][:k - 1], mu[k - 1][:k - 1] = (
+            mu[k - 1][:k - 1], mu[k][:k - 1]
+        )
+        for i in range(k + 1, m):
+            old = mu[i][k]
+            mu[i][k] = mu[i][k - 1] - nu * old
+            mu[i][k - 1] = mu[k][k - 1] * mu[i][k] + old
+        swaps += 1
+        k = max(k - 1, 1)
+    return rows, {
+        "iterations": steps,
+        "swaps": swaps,
+        "row_reductions": reductions,
+        "completed": k == m,
+    }
+
+
+def _lll_basis(inst, equation_scale, weight_scale, embedding_scale=1):
+    m = inst["m"]
+    n = inst["n"]
+    p = inst["p"]
+    has_weight = weight_scale > 0
+    width = m + n + int(has_weight) + 1
+    basis = []
+    for i, vector in enumerate(inst["coefficients"]):
+        row = [0] * width
+        row[i] = 2
+        for j in range(n):
+            row[m + j] = equation_scale * vector[j]
+        if has_weight:
+            row[m + n] = weight_scale
+        basis.append(row)
+    for j in range(n):
+        row = [0] * width
+        row[m + j] = equation_scale * p
+        basis.append(row)
+    target = (
+        [1] * m
+        + [equation_scale * value for value in inst["offset"]]
+        + ([weight_scale * (m // 2)] if has_weight else [])
+        + [embedding_scale]
+    )
+    basis.append(target)
+    return basis
+
+
+def _extract_lll_candidate(inst, reduced):
+    m = inst["m"]
+    for row in reduced:
+        for sign in (1, -1):
+            vector = [sign * x for x in row]
+            if abs(vector[-1]) != 1:
+                continue
+            if not all(abs(x) == 1 for x in vector[:m]):
+                continue
+            if any(vector[m:-1]):
+                continue
+            candidate = [(x + 1) // 2 for x in vector[:m]]
+            if _equation_sum(inst, candidate) == inst["offset"]:
+                return candidate
+    return None
+
+
+def _lll_embedding_attack(inst):
+    """Sweep ordinary and construction-aware Kannan/LLL embeddings."""
+    configurations = [
+        (8, 0, 0.75),
+        (16, 0, 0.99),
+        (8, 8, 0.75),
+        (16, 8, 0.75),
+        (16, 16, 0.99),
+        (32, 16, 0.99),
+    ]
+    aggregate = {
+        "configurations": len(configurations),
+        "iterations": 0,
+        "swaps": 0,
+        "row_reductions": 0,
+        "completed_reductions": 0,
+    }
+    started = time.perf_counter()
+    for equation_scale, weight_scale, delta in configurations:
+        basis = _lll_basis(inst, equation_scale, weight_scale)
+        reduced, metrics = _lll_reduce(basis, delta=delta)
+        for key in ("iterations", "swaps", "row_reductions"):
+            aggregate[key] += metrics[key]
+        aggregate["completed_reductions"] += int(metrics["completed"])
+        candidate = _extract_lll_candidate(inst, reduced)
+        if candidate is not None:
+            aggregate["wall_clock_sec"] = time.perf_counter() - started
+            return candidate, aggregate
+    aggregate["wall_clock_sec"] = time.perf_counter() - started
+    return None, aggregate
+
+
+# ---------------------------------------------------------------------------
+# Mandatory gates
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def _apply_coordinate_map(inst, matrix):
+    transformed = copy.deepcopy(inst)
+    p = inst["p"]
+    transformed["coefficients"] = [
+        _mat_vec(matrix, vector, p) for vector in inst["coefficients"]
+    ]
+    for key in ("rhs", "baseline", "offset"):
+        transformed[key] = _mat_vec(matrix, inst[key], p)
+    return transformed
+
+
+def _permute_variables(inst, permutation):
+    transformed = copy.deepcopy(inst)
+    transformed["coefficients"] = [
+        inst["coefficients"][old] for old in permutation
+    ]
+    transformed["answer"] = [inst["answer"][old] for old in permutation]
+    return transformed
+
+
+def _elementary_basis_map(n, p, seed):
+    rng = random.Random(seed)
+    matrix = [[int(i == j) for j in range(n)] for i in range(n)]
+    if n >= 2:
+        a, b = rng.sample(range(n), 2)
+        matrix[a], matrix[b] = matrix[b], matrix[a]
+        scalar = rng.randrange(1, p)
+        matrix[a] = [(scalar * x) % p for x in matrix[a]]
+        shear = rng.randrange(1, p)
+        matrix[b] = [(x + shear * y) % p
+                     for x, y in zip(matrix[b], matrix[a])]
+    return matrix
+
+
+def selftest() -> dict:
+    report = {
+        "paper": "2405.03591",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": DIFFICULTY[SHIPPING_DIFFICULTY],
+    }
+
+    # G1: all named presets, multiple seeds, exact verification and JSON safety.
+    planted_checks = json_checks = 0
+    planted_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            planted_checks += 1
+            if not ok:
+                planted_failures.append([preset, seed, reason])
+            json_checks += int(
+                json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            )
+    report["G1_planted_verifies"] = {
+        "pass": not planted_failures and json_checks == planted_checks,
+        "verified": planted_checks - len(planted_failures),
+        "attempts": planted_checks,
+        "json_round_trips": json_checks,
+        "failures": planted_failures,
+    }
+
+    # G2: five materially different corruptions and five distinct diagnostics.
+    inst = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    answer = inst["answer"]
+    left = next(i for i, bit in enumerate(answer) if bit == 0)
+    right = next(i for i, bit in enumerate(answer) if bit == 1)
+    swapped = answer[:]
+    swapped[left], swapped[right] = swapped[right], swapped[left]
+    corruptions = {
+        "drop_one": answer[:-1],
+        "swap_zero_and_one": swapped,
+        "duplicate_one": answer + [answer[-1]],
+        "empty": [],
+        "out_of_range_symbol": [2] + answer[1:],
+    }
+    rejected = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        rejected[name] = {"rejected": not ok, "reason": reason}
+    reasons = [item["reason"] for item in rejected.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": (all(item["rejected"] for item in rejected.values())
+                 and len(set(reasons)) == len(reasons)),
+        "cases": rejected,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    # G3: the exact public wire format amid realistic prose and a JSON fallback.
+    bit_text = _bits_text(answer)
+    prose = (
+        "I reduced the conjugations coordinate by coordinate.\n\n"
+        "```text\n<answer>\n" + bit_text + "\n</answer>\n```\n"
+        "The product now equals the stated right-hand side."
+    )
+    parsed = parse_answer(prose)
+    parsed_json = parse_answer(
+        "Result:\n<answer>```json\n" + json.dumps(answer) +
+        "\n```</answer>"
+    )
+    report["G3_round_trip"] = {
+        "pass": (parsed == answer and parsed_json == answer
+                 and parse_answer("no certificate here") is None),
+        "tagged_bitstring": parsed == answer,
+        "tagged_json": parsed_json == answer,
+        "garbage_is_none": parse_answer("no certificate here") is None,
+    }
+
+    # G4 and the shipping-density part of G5 share one 200k exact sample.
+    shipping = make_instance(seed=20260905,
+                             **DIFFICULTY[SHIPPING_DIFFICULTY])
+    sample_rng = random.Random(0x240503591)
+    samples = 200_000
+    hits = 0
+    started = time.perf_counter()
+    for _ in range(samples):
+        candidate = random_candidate(shipping, sample_rng)
+        hits += int(_equation_sum(shipping, candidate) == shipping["offset"])
+    sampling_sec = time.perf_counter() - started
+    report["G4_guess_resistance"] = {
+        "pass": hits / samples < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "empirical_probability": hits / samples,
+        "structure_aware_space": search_space(shipping),
+        "prior": "uniform over every length-m binary string allowed by the statement",
+        "wall_clock_sec": sampling_sec,
+    }
+
+    # G6: attacks that know the balanced planting prior, plus standard LLL.
+    attack_seeds = list(range(1000, 1008))
+    successes = {
+        "outlier_target_correlation": 0,
+        "greedy_centered_residual": 0,
+        "balanced_random_restart_512": 0,
+        "kannan_embedding_lll_sweep": 0,
+    }
+    lll_metrics = []
+    for seed in attack_seeds:
+        attacked = make_instance(seed=seed,
+                                 **DIFFICULTY[SHIPPING_DIFFICULTY])
+        candidates = {
+            "outlier_target_correlation": _outlier_attack(attacked),
+            "greedy_centered_residual": _greedy_residual_attack(attacked),
+        }
+        restart, _ = _random_restart_attack(attacked, seed ^ 0xA5A5A5A5)
+        candidates["balanced_random_restart_512"] = restart
+        lattice, metrics = _lll_embedding_attack(attacked)
+        candidates["kannan_embedding_lll_sweep"] = lattice
+        lll_metrics.append(metrics)
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(attacked, candidate)[0]:
+                successes[name] += 1
+    attacks = {
+        name: {"successes": count, "attempts": len(attack_seeds)}
+        for name, count in successes.items()
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(result["successes"] == 0 for result in attacks.values()),
+        "attacks": attacks,
+        "standard_algorithm": (
+            "Kannan closest-vector embedding with a construction-aware exact "
+            "weight coordinate, followed by six complete LLL reductions"
+        ),
+        "lll_total_iterations": sum(x["iterations"] for x in lll_metrics),
+        "lll_total_row_reductions": sum(x["row_reductions"] for x in lll_metrics),
+        "lll_completed_reductions": sum(
+            x["completed_reductions"] for x in lll_metrics
+        ),
+        "lll_wall_clock_sec": sum(x["wall_clock_sec"] for x in lll_metrics),
+    }
+
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    exact_demo_solutions = enumerate_all(demo)
+    strongest = max(lll_metrics, key=lambda x: x["wall_clock_sec"])
+    entropy_bits = math.log2(math.comb(shipping["m"], shipping["m"] // 2))
+    output_bits = shipping["n"] * math.log2(shipping["p"])
+    distance_bound = 0.5 * 2 ** ((output_bits - entropy_bits) / 2)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": (exact_demo_solutions is not None and hits / samples < 1e-6
+                 and report["G6_adversary_panel"]["pass"]),
+        "shipping_solution_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_empirical_solution_fraction": hits / samples,
+        "demo_exact_solution_count": exact_demo_solutions,
+        "demo_candidate_count": search_space(demo),
+        "baseline_wall_clock_sec": strongest["wall_clock_sec"],
+        "baseline_lll_iterations": strongest["iterations"],
+        "baseline_lll_row_reductions": strongest["row_reductions"],
+        "baseline_configurations": strongest["configurations"],
+        "baseline_successes": 0,
+        "balanced_source_entropy_bits": entropy_bits,
+        "public_output_bits": output_bits,
+        "leftover_hash_distance_upper_bound": distance_bound,
+    }
+
+    # G7: double the theorem's main parameter using the default schedule.
+    doubled_n = 2 * DIFFICULTY[SHIPPING_DIFFICULTY]["n"]
+    doubled = make_instance(n=doubled_n, seed=271828)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": (doubled_ok and doubled["m"] > shipping["m"]
+                 and search_space(doubled) > search_space(shipping)),
+        "shipping_n": shipping["n"],
+        "shipping_m": shipping["m"],
+        "doubled_n": doubled["n"],
+        "doubled_m": doubled["m"],
+        "doubled_verified": doubled_ok,
+        "reason": doubled_reason,
+        "doubled_search_space_bits": doubled["m"],
+    }
+
+    # G8: variable permutations, coordinate changes, and their compositions.
+    invariant_checks = carried_checks = 0
+    invariant_failures = []
+    unrelated_keys = []
+    for seed in range(20):
+        original = make_instance(seed=4000 + seed,
+                                 **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(original)
+        unrelated_keys.append(key)
+        rng = random.Random(9000 + seed)
+        permutation = list(range(original["m"]))
+        rng.shuffle(permutation)
+        permuted = _permute_variables(original, permutation)
+        matrix = _elementary_basis_map(original["n"], original["p"],
+                                       12000 + seed)
+        rebased = _apply_coordinate_map(original, matrix)
+        composed = _apply_coordinate_map(permuted, matrix)
+        reversed_vars = _permute_variables(original,
+                                            list(reversed(range(original["m"]))))
+        for label, transformed in (
+            ("permutation", permuted),
+            ("basis", rebased),
+            ("composition", composed),
+            ("reversal", reversed_vars),
+        ):
+            invariant_checks += 1
+            carried_checks += 1
+            if canonical_key(transformed) != key:
+                invariant_failures.append([seed, label, "key changed"])
+            ok, reason = verify(transformed, transformed["answer"])
+            if not ok:
+                invariant_failures.append([seed, label, reason])
+    distinct = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": (not invariant_failures and distinct == len(unrelated_keys)),
+        "invariance_checks": invariant_checks,
+        "invariance_passed": invariant_checks - sum(
+            1 for x in invariant_failures if x[2] == "key changed"
+        ),
+        "carried_witness_checks": carried_checks,
+        "carried_witness_passed": carried_checks - sum(
+            1 for x in invariant_failures if x[2] != "key changed"
+        ),
+        "unrelated_distinct": distinct,
+        "unrelated_attempts": len(unrelated_keys),
+        "failures": invariant_failures,
+        "invariant": (
+            "projectively normalized determinants of Gram-sum rank-one updates"
+        ),
+    }
+
+    answer_blob = json.dumps(shipping["answer"])
+    answer_tokens = math.ceil(len(answer_blob) / 4)
+    answer_elements = _answer_atoms(shipping["answer"])
+    intended_ops = shipping["n"] * sum(shipping["answer"])
+    caps_ok = (len(answer_blob) <= 2000 and answer_elements <= 256
+               and intended_ops <= 300)
+    arms = copy.deepcopy(G9_RESULTS["arms"])
+    hinted_attempts = arms["hinted"]["attempts"]
+    placebo_attempts = arms["placebo"]["attempts"]
+    hinted_rate = (arms["hinted"]["solved"] / hinted_attempts
+                   if hinted_attempts else None)
+    placebo_rate = (arms["placebo"]["solved"] / placebo_attempts
+                    if placebo_attempts else None)
+    difference = (hinted_rate - placebo_rate
+                  if hinted_rate is not None and placebo_rate is not None
+                  else None)
+    report["G9_no_tool_suitability"] = {
+        "pass": caps_ok,
+        "arms": arms,
+        "hinted_minus_placebo": difference,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": len(answer_blob),
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "intended_route": (
+            "after the binary-conjugation reduction is recognized, add the "
+            "selected coefficient vectors and compare with RHS-BASELINE"
+        ),
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gate_values = [value for key, value in report.items()
+                   if key.startswith("G") and key[1:2].isdigit()]
+    report["all_passed"] = all(value.get("pass") for value in gate_values)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

