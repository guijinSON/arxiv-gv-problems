+        steps += 1
+        if abs(mu[k][k - 1]) > 0.5:
+            reduce_row(k, k - 1)
+        if norm[k] >= (delta - mu[k][k - 1] ** 2) * norm[k - 1]:
+            for j in range(k - 2, -1, -1):
+                if abs(mu[k][j]) > 0.5:
+                    reduce_row(k, j)
+            k += 1
+            continue
