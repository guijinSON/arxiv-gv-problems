+        raise ZeroDivisionError("zero has no inverse")
+    old_r, r = value, modulus
+    old_s, s = 1, 0
+    divisions = 0
+    while r:
+        quotient = old_r // r
+        old_r, r = r, old_r - quotient * r
+        old_s, s = s, old_s - quotient * s
+        divisions += 1
+    if old_r != 1:
+        raise ZeroDivisionError("value is not invertible")
