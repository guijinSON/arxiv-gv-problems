+# ---------------------------------------------------------------------------
+# Adversarial attacks used by selftest
+
+def _centered(value, p):
+    value %= p
+    return value if value <= p // 2 else value - p
+
+
+def _outlier_attack(inst):
+    """Select the half with the largest marginal correlation to the target."""
+    p = inst["p"]
+    target = [_centered(x, p) for x in inst["offset"]]
+    scored = []
+    for i, vector in enumerate(inst["coefficients"]):
+        centered = [_centered(x, p) for x in vector]
+        score = sum(a * b for a, b in zip(centered, target))
+        scored.append((score, i))
+    chosen = {i for _, i in sorted(scored, reverse=True)[:inst["m"] // 2]}
+    return [int(i in chosen) for i in range(inst["m"])]
+
+
+def _greedy_residual_attack(inst):
+    """Construction-aware greedy search constrained to balanced witnesses."""
+    p = inst["p"]
+    residual = list(inst["offset"])
+    available = set(range(inst["m"]))
+    chosen = set()
+    for _ in range(inst["m"] // 2):
+        best = None
+        for i in available:
+            trial = _sub(residual, inst["coefficients"][i], p)
+            score = sum(_centered(x, p) ** 2 for x in trial)
+            key = (score, i)
+            if best is None or key < best[0]:
+                best = (key, i, trial)
+        _, index, residual = best
+        chosen.add(index)
+        available.remove(index)
+    return [int(i in chosen) for i in range(inst["m"])]
+
+
+def _random_restart_attack(inst, seed, restarts=512):
+    """Try balanced random preimages, using the generator-aware weight prior."""
+    rng = random.Random(seed)
+    m = inst["m"]
+    for _ in range(restarts):
+        chosen = set(rng.sample(range(m), m // 2))
+        candidate = [int(i in chosen) for i in range(m)]
+        if _equation_sum(inst, candidate) == inst["offset"]:
+            return candidate, restarts
+    return None, restarts
+
+
+def _lll_reduce(basis, delta=0.75, max_steps=500_000):
+    """Complete floating-point LLL with exact integer row operations.
+
+    Candidate vectors are always checked by exact modular arithmetic.  Floating
+    point is used only to guide basis reduction, as in practical LLL attacks.
+    """
+    rows = [row[:] for row in basis]
+    m = len(rows)
+    width = len(rows[0])
+    star = [[float(x) for x in row] for row in rows]
+    mu = [[0.0] * m for _ in range(m)]
+    norm = [0.0] * m
+    for i in range(m):
+        for j in range(i):
+            mu[i][j] = sum(rows[i][z] * star[j][z]
+                           for z in range(width)) / norm[j]
+            q = mu[i][j]
+            star[i] = [star[i][z] - q * star[j][z]
+                       for z in range(width)]
+        norm[i] = sum(x * x for x in star[i])
+
+    k = 1
+    steps = swaps = reductions = 0
+
+    def reduce_row(i, j):
+        nonlocal reductions
+        multiple = math.floor(mu[i][j] + 0.5)
+        if not multiple:
+            return
+        rows[i] = [a - multiple * b for a, b in zip(rows[i], rows[j])]
+        for z in range(j):
+            mu[i][z] -= multiple * mu[j][z]
+        mu[i][j] -= multiple
+        reductions += 1
+
+    while k < m and steps < max_steps:
+        steps += 1
+        if abs(mu[k][k - 1]) > 0.5:
+            reduce_row(k, k - 1)
+        if norm[k] >= (delta - mu[k][k - 1] ** 2) * norm[k - 1]:
+            for j in range(k - 2, -1, -1):
+                if abs(mu[k][j]) > 0.5:
+                    reduce_row(k, j)
+            k += 1
+            continue
+
+        nu = mu[k][k - 1]
+        alpha = norm[k] + nu * nu * norm[k - 1]
+        if not alpha or not math.isfinite(alpha):
+            break
+        beta = norm[k - 1] / alpha
+        mu[k][k - 1] = nu * beta
+        norm[k] *= beta
+        norm[k - 1] = alpha
+        rows[k], rows[k - 1] = rows[k - 1], rows[k]
+        mu[k][:k - 1], mu[k - 1][:k - 1] = (
+            mu[k - 1][:k - 1], mu[k][:k - 1]
+        )
+        for i in range(k + 1, m):
+            old = mu[i][k]
+            mu[i][k] = mu[i][k - 1] - nu * old
+            mu[i][k - 1] = mu[k][k - 1] * mu[i][k] + old
+        swaps += 1
+        k = max(k - 1, 1)
+    return rows, {
+        "iterations": steps,
+        "swaps": swaps,
+        "row_reductions": reductions,
+        "completed": k == m,
+    }
+
+
+def _lll_basis(inst, equation_scale, weight_scale, embedding_scale=1):
+    m = inst["m"]
+    n = inst["n"]
+    p = inst["p"]
+    has_weight = weight_scale > 0
+    width = m + n + int(has_weight) + 1
+    basis = []
+    for i, vector in enumerate(inst["coefficients"]):
+        row = [0] * width
+        row[i] = 2
+        for j in range(n):
+            row[m + j] = equation_scale * vector[j]
+        if has_weight:
+            row[m + n] = weight_scale
+        basis.append(row)
+    for j in range(n):
+        row = [0] * width
+        row[m + j] = equation_scale * p
+        basis.append(row)
+    target = (
+        [1] * m
+        + [equation_scale * value for value in inst["offset"]]
+        + ([weight_scale * (m // 2)] if has_weight else [])
+        + [embedding_scale]
+    )
+    basis.append(target)
+    return basis
+
+
+def _extract_lll_candidate(inst, reduced):
+    m = inst["m"]
+    for row in reduced:
+        for sign in (1, -1):
+            vector = [sign * x for x in row]
+            if abs(vector[-1]) != 1:
+                continue
+            if not all(abs(x) == 1 for x in vector[:m]):
+                continue
+            if any(vector[m:-1]):
+                continue
+            candidate = [(x + 1) // 2 for x in vector[:m]]
+            if _equation_sum(inst, candidate) == inst["offset"]:
+                return candidate
+    return None
+
+
+def _lll_embedding_attack(inst):
+    """Sweep ordinary and construction-aware Kannan/LLL embeddings."""
+    configurations = [
+        (8, 0, 0.75),
+        (16, 0, 0.99),
+        (8, 8, 0.75),
+        (16, 8, 0.75),
+        (16, 16, 0.99),
+        (32, 16, 0.99),
+    ]
+    aggregate = {
+        "configurations": len(configurations),
+        "iterations": 0,
+        "swaps": 0,
+        "row_reductions": 0,
+        "completed_reductions": 0,
+    }
+    started = time.perf_counter()
+    for equation_scale, weight_scale, delta in configurations:
+        basis = _lll_basis(inst, equation_scale, weight_scale)
+        reduced, metrics = _lll_reduce(basis, delta=delta)
+        for key in ("iterations", "swaps", "row_reductions"):
+            aggregate[key] += metrics[key]
+        aggregate["completed_reductions"] += int(metrics["completed"])
+        candidate = _extract_lll_candidate(inst, reduced)
+        if candidate is not None:
+            aggregate["wall_clock_sec"] = time.perf_counter() - started
+            return candidate, aggregate
+    aggregate["wall_clock_sec"] = time.perf_counter() - started
+    return None, aggregate
+
