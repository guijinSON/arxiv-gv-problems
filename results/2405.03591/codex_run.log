+def _lll_reduce(basis, delta=0.75, max_steps=500_000):
+    """Complete floating-point LLL with exact integer row operations.
+
+    Candidate vectors are always checked by exact modular arithmetic.  Floating
+    point is used only to guide basis reduction, as in practical LLL attacks.
+    """
+    rows = [row[:] for row in basis]
+    m = len(rows)
+    width = len(rows[0])
+    star = [[float(x) for x in row] for row in rows]
+    mu = [[0.0] * m for _ in range(m)]
+    norm = [0.0] * m
+    for i in range(m):
+        for j in range(i):
+            mu[i][j] = sum(rows[i][z] * star[j][z]
+                           for z in range(width)) / norm[j]
+            q = mu[i][j]
+            star[i] = [star[i][z] - q * star[j][z]
+                       for z in range(width)]
+        norm[i] = sum(x * x for x in star[i])
+
+    k = 1
+    steps = swaps = reductions = 0
+
+    def reduce_row(i, j):
+        nonlocal reductions
+        multiple = math.floor(mu[i][j] + 0.5)
+        if not multiple:
+            return
+        rows[i] = [a - multiple * b for a, b in zip(rows[i], rows[j])]
+        for z in range(j):
+            mu[i][z] -= multiple * mu[j][z]
+        mu[i][j] -= multiple
+        reductions += 1
+
