+def _random_restart_attack(inst, seed, restarts=512):
+    """Try balanced random preimages, using the generator-aware weight prior."""
+    rng = random.Random(seed)
+    m = inst["m"]
+    for _ in range(restarts):
+        chosen = set(rng.sample(range(m), m // 2))
+        candidate = [int(i in chosen) for i in range(m)]
+        if _equation_sum(inst, candidate) == inst["offset"]:
+            return candidate, restarts
