+def _pow_counted(base, exponent, modulus):
+    """Binary modular exponentiation returning (value, modular multiplies)."""
+    result = 1
+    base %= modulus
+    count = 0
+    while exponent:
+        if exponent & 1:
+            result = result * base % modulus
+            count += 1
+        exponent >>= 1
+        if exponent:
+            base = base * base % modulus
+            count += 1
+    return result, count
 
