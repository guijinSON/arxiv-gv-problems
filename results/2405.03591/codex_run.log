+DIFFICULTY: dict = {
+    "demo": {"n": 2, "m": 6, "modulus_factor": 4},
+    "easy": {"n": 3, "m": 64, "modulus_factor": 4},
+    "medium": {"n": 4, "m": 88, "modulus_factor": 4},
+    "hard": {"n": 5, "m": 120, "modulus_factor": 4},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A binary string x_0...x_(m-1), represented in JSON as a list of exactly "
+        "m integers from {0,1}.  Bit x_i selects the allowed conjugator "
+        "z_i=(zero,1) when x_i=0 and z_i=(zero,2^{-1}) when x_i=1."
+    ),
