+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "semidirect-product group G_{p,d} = Z_p^d ⋊ Z_p^*",
+        "spherical equation with parametrically specified group coefficients",
+        "one-support assignment of group conjugators",
