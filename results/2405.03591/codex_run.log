+        lattice, metrics = _lll_embedding_attack(attacked)
+        candidates["kannan_embedding_lll_sweep"] = lattice
+        lll_metrics.append(metrics)
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(attacked, candidate)[0]:
+                successes[name] += 1
+    attacks = {
+        name: {"successes": count, "attempts": len(attack_seeds)}
+        for name, count in successes.items()
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(result["successes"] == 0 for result in attacks.values()),
+        "attacks": attacks,
+        "standard_algorithm": (
+            "Kannan closest-vector embedding with a construction-aware exact "
+            "weight coordinate, followed by six complete LLL reductions"
+        ),
+        "lll_total_iterations": sum(x["iterations"] for x in lll_metrics),
+        "lll_total_row_reductions": sum(x["row_reductions"] for x in lll_metrics),
+        "lll_completed_reductions": sum(
+            x["completed_reductions"] for x in lll_metrics
+        ),
+        "lll_wall_clock_sec": sum(x["wall_clock_sec"] for x in lll_metrics),
+    }
+
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    exact_demo_solutions = enumerate_all(demo)
+    strongest = max(lll_metrics, key=lambda x: x["wall_clock_sec"])
+    entropy_bits = math.log2(math.comb(shipping["m"], shipping["m"] // 2))
+    output_bits = shipping["n"] * math.log2(shipping["p"])
+    distance_bound = 0.5 * 2 ** ((output_bits - entropy_bits) / 2)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": (exact_demo_solutions is not None and hits / samples < 1e-6
+                 and report["G6_adversary_panel"]["pass"]),
+        "shipping_solution_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_empirical_solution_fraction": hits / samples,
+        "demo_exact_solution_count": exact_demo_solutions,
+        "demo_candidate_count": search_space(demo),
+        "baseline_wall_clock_sec": strongest["wall_clock_sec"],
+        "baseline_lll_iterations": strongest["iterations"],
+        "baseline_lll_row_reductions": strongest["row_reductions"],
+        "baseline_configurations": strongest["configurations"],
+        "baseline_successes": 0,
+        "balanced_source_entropy_bits": entropy_bits,
+        "public_output_bits": output_bits,
+        "leftover_hash_distance_upper_bound": distance_bound,
+    }
+
+    # G7: double the theorem's main parameter using the default schedule.
+    doubled_n = 2 * DIFFICULTY[SHIPPING_DIFFICULTY]["n"]
+    doubled = make_instance(n=doubled_n, seed=271828)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": (doubled_ok and doubled["m"] > shipping["m"]
+                 and search_space(doubled) > search_space(shipping)),
+        "shipping_n": shipping["n"],
+        "shipping_m": shipping["m"],
+        "doubled_n": doubled["n"],
+        "doubled_m": doubled["m"],
+        "doubled_verified": doubled_ok,
+        "reason": doubled_reason,
+        "doubled_search_space_bits": doubled["m"],
+    }
+
+    # G8: variable permutations, coordinate changes, and their compositions.
+    invariant_checks = carried_checks = 0
+    invariant_failures = []
+    unrelated_keys = []
+    for seed in range(20):
+        original = make_instance(seed=4000 + seed,
+                                 **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(original)
+        unrelated_keys.append(key)
+        rng = random.Random(9000 + seed)
+        permutation = list(range(original["m"]))
+        rng.shuffle(permutation)
+        permuted = _permute_variables(original, permutation)
+        matrix = _elementary_basis_map(original["n"], original["p"],
+                                       12000 + seed)
+        rebased = _apply_coordinate_map(original, matrix)
+        composed = _apply_coordinate_map(permuted, matrix)
+        reversed_vars = _permute_variables(original,
+                                            list(reversed(range(original["m"]))))
+        for label, transformed in (
+            ("permutation", permuted),
+            ("basis", rebased),
+            ("composition", composed),
+            ("reversal", reversed_vars),
+        ):
+            invariant_checks += 1
+            carried_checks += 1
+            if canonical_key(transformed) != key:
+                invariant_failures.append([seed, label, "key changed"])
+            ok, reason = verify(transformed, transformed["answer"])
+            if not ok:
+                invariant_failures.append([seed, label, reason])
+    distinct = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": (not invariant_failures and distinct == len(unrelated_keys)),
+        "invariance_checks": invariant_checks,
+        "invariance_passed": invariant_checks - sum(
+            1 for x in invariant_failures if x[2] == "key changed"
+        ),
+        "carried_witness_checks": carried_checks,
+        "carried_witness_passed": carried_checks - sum(
+            1 for x in invariant_failures if x[2] != "key changed"
+        ),
+        "unrelated_distinct": distinct,
+        "unrelated_attempts": len(unrelated_keys),
+        "failures": invariant_failures,
+        "invariant": (
+            "projectively normalized determinants of Gram-sum rank-one updates"
+        ),
+    }
+
+    answer_blob = json.dumps(shipping["answer"])
+    answer_tokens = math.ceil(len(answer_blob) / 4)
+    answer_elements = _answer_atoms(shipping["answer"])
+    intended_ops = shipping["n"] * sum(shipping["answer"])
+    caps_ok = (len(answer_blob) <= 2000 and answer_elements <= 256
+               and intended_ops <= 300)
+    arms = copy.deepcopy(G9_RESULTS["arms"])
+    hinted_attempts = arms["hinted"]["attempts"]
+    placebo_attempts = arms["placebo"]["attempts"]
+    hinted_rate = (arms["hinted"]["solved"] / hinted_attempts
+                   if hinted_attempts else None)
+    placebo_rate = (arms["placebo"]["solved"] / placebo_attempts
+                    if placebo_attempts else None)
+    difference = (hinted_rate - placebo_rate
+                  if hinted_rate is not None and placebo_rate is not None
+                  else None)
+    report["G9_no_tool_suitability"] = {
+        "pass": caps_ok,
+        "arms": arms,
+        "hinted_minus_placebo": difference,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": len(answer_blob),
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "intended_route": (
+            "after the binary-conjugation reduction is recognized, add the "
+            "selected coefficient vectors and compare with RHS-BASELINE"
+        ),
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gate_values = [value for key, value in report.items()
+                   if key.startswith("G") and key[1:2].isdigit()]
+    report["all_passed"] = all(value.get("pass") for value in gate_values)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

