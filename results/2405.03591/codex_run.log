+def _group_mul(g, h, p):
+    """Multiply (vector, scalar) pairs in F_p^n semidirect F_p^*."""
+    gv, ga = g
+    hv, ha = h
+    return (_add(gv, _scale(ga, hv, p), p), ga * ha % p)
