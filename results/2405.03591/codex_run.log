+
+def _elementary_basis_map(n, p, seed):
+    rng = random.Random(seed)
+    matrix = [[int(i == j) for j in range(n)] for i in range(n)]
+    if n >= 2:
+        a, b = rng.sample(range(n), 2)
+        matrix[a], matrix[b] = matrix[b], matrix[a]
+        scalar = rng.randrange(1, p)
+        matrix[a] = [(scalar * x) % p for x in matrix[a]]
+        shear = rng.randrange(1, p)
+        matrix[b] = [(x + shear * y) % p
+                     for x, y in zip(matrix[b], matrix[a])]
+    return matrix
