+    """Exact modular inverse, rejecting zero and nonunits."""
+    value %= modulus
+    if value == 0:
+        raise ZeroDivisionError("zero has no inverse")
+    old_r, r = value, modulus
+    old_s, s = 1, 0
+    while r:
