+        "one allowed group conjugator for each binary choice",
+    ],
+    "verification_operations": [
+        "exact finite-field scalar multiplication",
+        "exact finite-field vector addition",
+        "exact evaluation of the spherical group equation",
+    ],
+    "domain_essentiality": "licensed_reduction",
