+    stop = len(labels) if limit is None else min(limit, len(labels))
+    rows: list[int] = []
+    xor_ops = 0
+    for v in range(stop):
+        value = labels[v]
+        for w in adj[v]:
+            value ^= labels[w]
+            xor_ops += 1
+        rows.append(value)
+    return rows, xor_ops
