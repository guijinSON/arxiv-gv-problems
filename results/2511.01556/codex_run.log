+        keys.append(key)
+        rng = random.Random(7000 + seed)
+        vp = list(range(sample["n"]))
+        rng.shuffle(vp)
+        cp = list(range(sample["coordinate_bits"]))
+        rng.shuffle(cp)
+        translation = rng.randrange(1 << sample["coordinate_bits"])
+        variants = [
