+                    inst["coordinate_bits"],
+                )
+                for bit in range(2)
+            ] if is_cover else []
+            if is_cover and all(fit is not None for fit in affine_fits):
+                quotient_signatures = trial_signatures
+                break
+        if quotient_signatures is None:
