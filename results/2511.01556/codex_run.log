+DIFFICULTY = {
+    "demo": {"n": 8, "coordinate_bits": 4},
+    "easy": {"n": 96, "coordinate_bits": 16},
+    "medium": {"n": 192, "coordinate_bits": 16},
+    "hard": {"n": 384, "coordinate_bits": 16},
+}
+SHIPPING_DIFFICULTY = "medium"
