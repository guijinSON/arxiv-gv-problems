+STRUCTURAL_HINT = (
+    "XOR the three endpoint-difference vectors incident to a vertex: the two "
+    "projection rows span the nullspace of those local signatures."
+)
+PLACEBO_HINT = (
+    "Track the vertex coordinates and edge indices carefully: the requested "
