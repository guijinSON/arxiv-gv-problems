+            "complexity": "O(n*d^2+d^3) scalar bit operations",
+            "wall_clock_sec_8": baseline_seconds,
+            "operations_8": baseline_ops,
+            "max_operations_one_instance": max(reference_operations),
+            "solves": "8/8, as expected for Track B",
+        },
