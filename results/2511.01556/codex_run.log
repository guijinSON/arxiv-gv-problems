            bad["matrix"][row][col] ^= 1
            if not verify(inst, bad)[0]:
                corruptions["single_bit_flip"] = bad
                break
        if "single_bit_flip" in corruptions:
            break
    reasons = {}
    for name, bad in corruptions.items():
        ok, reason = verify(inst, bad)
        assert not ok, (name, reason)

