+    answer = {
+        "matrix": [_mask_to_row(row0, d), _mask_to_row(row1, d)],
+        "offset": [offset & 1, (offset >> 1) & 1],
+    }
+    return {
+        "family": "affine_K4_cover_removable_set",
+        "paper_basis": _PAPER_CITATION,
+        "n": n,
+        "coordinate_bits": d,
+        "probe_vertices": probe,
+        "labels": labels,
+        "edges": [list(edge) for edge in edges],
+        "answer": answer,
+    }
+
