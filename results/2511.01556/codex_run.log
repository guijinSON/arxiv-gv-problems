+        return sum(_answer_elements(v) for v in value.values())
+    if isinstance(value, list):
+        return sum(_answer_elements(v) for v in value)
+    return 1
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return machine-readable measured evidence."""
+    report: dict[str, Any] = {}
