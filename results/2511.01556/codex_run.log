+                difference = tuple(
+                    (signatures[j][k] - signatures[i][k]) % prime
+                    for k in range(4)
+                )
+                clustering_ops += 4
+                pivot = next((k for k, value in enumerate(difference)
+                              if value), None)
+                if pivot is None:
+                    continue
+                inverse = pow(difference[pivot], prime - 2, prime)
+                direction = tuple((value * inverse) % prime
