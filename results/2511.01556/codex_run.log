 i=m.make_instance(**r['params']);assert m.verify(i,r['answer'])==(True,'ok')
print('final_audit_ok','render_chars',len(m.render(inst)),'answer_chars',len(json.dumps(inst['answer'],separators=(',',':'))),'search_space',m.search_space(inst))
