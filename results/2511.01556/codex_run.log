+                clustering_ops += 6
+            trial_distinct = sorted(set(trial_signatures))
+            if (len(trial_distinct) != 4
+                    or any(trial_signatures.count(value) != n // 4
+                           for value in trial_distinct)):
+                continue
+            trial_class_of = {
