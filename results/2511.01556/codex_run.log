+def render(inst: dict) -> str:
+    """Render a self-contained graph-cover and removable-flow problem."""
+    n = inst["n"]
+    d = inst["coordinate_bits"]
+    vertex_rows = "\n".join(
+        f"{i}: {x:0{d}b}" for i, x in enumerate(inst["labels"])
+    )
