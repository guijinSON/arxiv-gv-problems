import itertools, random

def product_adj(factors):
    verts=list(itertools.product(*[range(len(a)) for a in factors]))
    A=[]
    for x in verts:
        row=[]
        for j,y in enumerate(verts):
            if x "'!= y and all(x[i]==y[i] or y[i] in factors[i][x[i]] for i in range(len(factors))):
                row.append(j)
        A.append(row)
    return verts,A

def closure(A,S,r):
    I=set(S)
    while True:
        new={v for v,row in enumerate(A) if v not in I and sum(u in I for u in row)>=r}
        if not new:return I
        I |= new

rng=random.Random(230706623)
checked=0
for k in (2,3,4):
    for trial in range(8):
        factors=[]; edges=[]
        for i in range(k):
            q=rng.randint(2,4)
            a=[set() for _ in range(q)]
            for v in range(1,q):
                u=rng.randrange(v); a[u].add(v); a[v].add(u)
            for u in range(q):
                for v in range(u+1,q):
                    if rng.random()<.2:a[u].add(v);a[v].add(u)
            factors.append(a)
            edges.append(next((u,v) for u in range(q) for v in a[u] if u<v))
        verts,A=product_adj(factors); index={v:i for i,v in enumerate(verts)}
        maxr=2**(k-1)
        r=rng.randint(2,maxr)
        cube=list(itertools.product(*[(u,v) for u,v in edges]))
        S=[index[x] for x in cube[:r]]
        assert len(closure(A,S,r))==len(verts)
        checked+=1
print({'"'small_random_theorem_instances_verified':checked,'representative_k':6,'representative_r':16,'edge_selections':6,'coordinate_emissions':96,'total':102})
