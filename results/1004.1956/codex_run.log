+    )
+    domain_baseline = attacks["subset_dp_beam_256"]
+    report["G5_density_and_baseline"] = {
+        "pass": guess_hits == 0 and demo_count is not None and demo_count > 0 and all_failed,
+        "shipping_sampled_valid_hits": guess_hits,
