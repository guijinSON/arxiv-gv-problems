+        row["attempts"] += 1
+        row["successes"] += int(verify(current, candidate)[0])
+        row["operations"] += operations
+        row["wall_clock_sec"] += elapsed
+
+        start = time.perf_counter()
+        candidate, operations = _random_restart_attack(
+            current, random.Random(seed ^ 0xC1AC1E)
