+            all(not row["accepted"] for row in corruption_results.values())
+            and len(set(reasons)) == len(reasons)
+        ),
+        "cases": corruption_results,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    body = ", ".join(str(value) for value in answer)
+    realistic = (
