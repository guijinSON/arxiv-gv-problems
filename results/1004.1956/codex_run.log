+        "random_restart_adjacent_hillclimb_32",
+        "spectral_skew_adjacency",
+        "subset_dp_beam_256",
+    )
+    attacks = {
+        name: {
+            "successes": 0,
+            "attempts": 0,
+            "operations": 0,
+            "states": 0,
+            "wall_clock_sec": 0.0,
+        }
+        for name in attack_names
+    }
+    for seed in range(800, 808):
