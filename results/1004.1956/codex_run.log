+            for name, row in zip(DIFFICULTY, ladder)
+        },
+        "fixed_length_escalation": harder_fixed,
+        "doubled_params": doubled_params,
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    unrelated_keys = []
+    for seed in range(20):
