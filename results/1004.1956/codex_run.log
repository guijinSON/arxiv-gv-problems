def ok(order,cs):
 p={v:i for i,v in enumerate(order)}
 return all(((p[b]-p[a])%len(order) < (p[c]-p[a])%len(order)) for a,b,c in cs)

def score(order,cs):
 p={v:i for i,v in enumerate(order)}
 return sum((p[b]-p[a])%len(order) < (p[c]-p[a])%len(order) for a,b,c in cs)

def arcs(n,cs):
 A=[[0]*n for _ in range(n)]
 for a,b,c in cs:A[a][b]+=1;A[b][c]+=1;A[c][a]+=1
 return A

def spectral(n,cs):
 A=arcs(n,cs)
 v=[complex(math.cos(2*math.pi*(i+.37)/n),math.sin(2*math.pi*(i+.37)/n)) for i in range(n)]
 for _ in range(200):
  w=[]
  for i in range(n):
   s=0j
   for j in range(n):s += 1j*(A[i][j]-A[j][i])*v[j]
   w.append(s)
  norm=math.sqrt(sum(abs(x)**2 for x in w));v=[x/norm for x in w]
 cand=sorted(range(n),key=lambda i:cmath.phase(v[i]))
 k=cand.index(0); cand=cand[k:]+cand[:k]
 rev=[0]+list(reversed(cand[1:]))
 return max((cand,rev),key=lambda x:score(x,cs))

def greedy_insertion(n,cs,rng=None):
 seq=[0]
 rem=list(range(1,n))
 if rng:rng.shuffle(rem)
 else:
  # random deterministic
  pass
 for x in rem:
  best=None
  for j in range(1,len(seq)+1):
   c=seq[:j]+[x]+seq[j:]; val=score(c,[t for t in cs if all(y in c for y in t)])
