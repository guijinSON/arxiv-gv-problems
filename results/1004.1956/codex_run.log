+
+    attack_names = (
+        "outlier_tuple_role",
+        "greedy_arc_insertion",
+        "random_restart_adjacent_hillclimb_32",
+        "spectral_skew_adjacency",
+        "subset_dp_beam_256",
+    )
+    attacks = {
+        name: {
+            "successes": 0,
+            "attempts": 0,
