+        for j in range(i + 1, len(answer)):
+            trial = list(answer)
+            trial[i], trial[j] = trial[j], trial[i]
+            if verify(ship, trial)[1].startswith("constraint row"):
+                swapped = trial
+                break
+        if swapped is not None:
