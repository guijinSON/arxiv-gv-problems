+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 6, "rounds": 3},
+    "easy": {"n": 48, "rounds": 10},
+    "medium": {"n": 48, "rounds": 11},
+    "hard": {"n": 60, "rounds": 12},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+STRUCTURAL_HINT: str = (
+    "Each oriented triple is a directed 3-cycle, and its accepted cyclic "
