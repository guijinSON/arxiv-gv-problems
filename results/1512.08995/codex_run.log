+
+def escalate(params: dict) -> dict | str | None:
+    """First erase more planting structure at fixed n, then approach atom cap."""
+    if not isinstance(params, dict):
+        return None
+    n = params.get("n")
+    degree = params.get("pair_degree", 3)
