+        )
+        assert canonical_key(transformed) == original_key
+        invariant_trials += 1
+        ok, reason = verify(transformed, transformed["answer"])
+        assert ok, reason
+        carried_trials += 1
+        # Compose with a second independent relabeling.
+        second = list(range(small["n"]))
