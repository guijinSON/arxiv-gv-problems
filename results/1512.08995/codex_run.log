+            pos2 = rng.randrange(len(rows2))
+            edge1, edge2 = rows1[pos1], rows2[pos2]
+            x1, y = _oriented(edge1, center, class_size)
+            x2, z = _oriented(edge2, center, class_size)
+            if x1 == x2:
+                continue
+            new1 = _canon_edge(x2, y)  # remains in key1
+            new2 = _canon_edge(x1, z)  # remains in key2
+            if new1 in edges or new2 in edges:
+                continue
+            edges.remove(edge1)
+            edges.remove(edge2)
+            edges.add(new1)
+            edges.add(new2)
+            rows1[pos1] = new1
+            rows2[pos2] = new2
+            break
+        else:
