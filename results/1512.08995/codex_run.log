import gen_1512_08995 as m,time
import numpy as np
from scipy.optimize import milp, LinearConstraint, Bounds
from scipy.sparse import lil_matrix
p=m.DIFFICULTY['hard']
for seed in range(4600,4608):
 i=m.make_instance(seed=seed,**p);n=i['n'];ed=i['base_edges'];rows=n+3*len(ed)+2
 A=lil_matrix((rows,3*n));lb=np.full(rows,-np.inf);ub=np.full(rows,np.inf);r=0
 for v in range(n):A[r,3*v:3*v+3]=1;lb[r]=ub[r]=1;r+=1
 for u,v in ed:
  for c in range(3):A[r,3*u+c]=A[r,3*v+c]=1;ub[r]=1;r+=1
 A[r,0]=1;lb[r]=ub[r]=1;r+=1;A[r,3*i['anchor_neighbor']+1]=1;lb[r]=ub[r]=1
 t=time.perf_counter();res=milp(np.zeros(3*n),integrality=np.ones(3*n),bounds=Bounds(0,1),constraints=LinearConstraint(A.tocsr(),lb,ub),options={'time_limit':30});dt=time.perf_counter()-t
 ans=''.join(str(np.argmax(res.x[3*v:3*v+3])+1) for v in range(n)) if res.x is not None else None
 ok=bool(ans and m.verify(i,ans)[0])
 print(seed,ok,round(dt,3),getattr(res,'mip_node_count',None),flush=True)
