+    hinted_still_hardened = _ORACLE_EVIDENCE["hinted_verdict"] == "hardened"
+    arms = {key: dict(_ORACLE_EVIDENCE[key])
+            for key in ("bare", "hinted", "placebo")}
+    hinted_rate = (arms["hinted"]["solved"] / arms["hinted"]["attempts"]
