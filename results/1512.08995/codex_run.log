+
+
+def _switch_layers(edges: set[tuple[int, int]],
+                   pair_edges: dict[tuple[int, int], list[tuple[int, int]]],
+                   class_size: int, switch_rounds: int,
+                   rng: random.Random) -> None:
+    """Destroy exact layers while preserving degrees and planted colors."""
+    target = switch_rounds * class_size
+    for _ in range(target):
