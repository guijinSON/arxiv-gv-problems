+        )
+        candidates[attack_names[2]] = candidate
+        attack_costs[attack_names[2]] += operations
+        candidate, operations = _nonbacktracking_spectral_attack(
+            current, random.Random(seed ^ 0x5A5A5A5A)
+        )
+        candidates[attack_names[3]] = candidate
