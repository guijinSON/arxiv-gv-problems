+    corruptions = {
+        "empty": "",
+        "drop_one": answer[:-1],
+        "swap_normalizers": "".join(swapped),
+        "duplicate_across_conflict": "".join(duplicated),
+        "out_of_range": answer[:-1] + "4",
+    }
+    reasons = {}
+    for name, bad in corruptions.items():
+        ok, reason = verify(inst, bad)
