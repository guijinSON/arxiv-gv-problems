+        rows = list(range(inst["row_count"]))
+        columns = list(range(inst["n"]))
+        rng.shuffle(rows)
+        rng.shuffle(columns)
+        identity_rows = list(range(inst["row_count"]))
+        identity_columns = list(range(inst["n"]))
+        variants = (
