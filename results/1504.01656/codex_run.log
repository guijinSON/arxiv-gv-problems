                    \fancyhead[CE]{\slshape 
    TIGHT SIZE-DEGREE BOUNDS FOR SUMS-OF-SQUARES PROOFS}
  \fancyhead[CO]{\slshape \nouppercase{\leftmark}}
  \fancyfoot[C]{\thepage}
  
            \setlength{\headheight}{13.6pt}
