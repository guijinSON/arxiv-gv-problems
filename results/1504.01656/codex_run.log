+
+def _obvious_walsh_ansatz(inst: dict) -> tuple[bool, int]:
+    bits = inst["label_bits"]
+    masks = [0] + [1 << bit for bit in range(bits)] + [(1 << bits) - 1]
+    candidates = []
+    for mask in masks:
