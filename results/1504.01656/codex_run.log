+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_MODULUS = 1_000_000_007
+_G4_SAMPLES = 200_000
+_ATTACK_SEEDS = 8
