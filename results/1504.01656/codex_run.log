+    ]
+    moved["coefficients"] = [
+        [inst["coefficients"][row][column] for column in column_order]
+        for row in row_order
+    ]
+    moved["constant_terms"] = [inst["constant_terms"][row] for row in row_order]
+    moved["answer"] = [inst["answer"][row] for row in row_order]
+    return moved
