+        "n": n,
+        "label_bits": label_bits,
+        "row_count": row_count,
+        "coeff_bound": coeff_bound,
+        "row_labels": labels,
+        "coefficients": coefficients,
+        "constant_terms": [1] * row_count,
+        "answer": answer,
+    }
