+    "easy": {"n": 96, "label_bits": 5, "coeff_bound": 7},
+    "medium": {"n": 256, "label_bits": 5, "coeff_bound": 11},
+    "hard": {"n": 640, "label_bits": 5, "coeff_bound": 17},
+}
+SHIPPING_DIFFICULTY = "hard"
