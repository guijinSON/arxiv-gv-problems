+def _trinomial_data(n, degree, modulus, parameter):
+    field_order = 1 << degree
+    middle = 1 << (n + 1)
+    third_coefficient = _gf_pow(
+        parameter, field_order - middle - 2, degree, modulus
+    )
+    return middle, third_coefficient
