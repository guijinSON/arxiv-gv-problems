+                "scaling_then_frobenius",
+                _frobenius_relabelling(_scale_relabelling(inst, scale), frobenius_steps),
+            ),
+        ]
+        original_key = canonical_key(inst)
+        for name, changed in transformed:
+            invariance_checks += 1
