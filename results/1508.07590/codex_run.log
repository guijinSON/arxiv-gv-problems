+    "easy": {"n": 5},       # GF(2^11)
+    "medium": {"n": 7},     # GF(2^15)
+    "hard": {"n": 10},      # GF(2^21), P(random witness)=1/(2^21-1)
+}
+SHIPPING_DIFFICULTY = "hard"
