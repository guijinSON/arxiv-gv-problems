+# Primitive trinomials for the named presets and the size-doubled G7 instance.
+# Dynamic levels use a deterministically found irreducible polynomial instead.
+_MODULUS_OVERRIDES = {
+    5: (1 << 5) | (1 << 2) | 1,
+    11: (1 << 11) | (1 << 2) | 1,
+    15: (1 << 15) | (1 << 1) | 1,
+    21: (1 << 21) | (1 << 2) | 1,
+    25: (1 << 25) | (1 << 3) | 1,
+    29: (1 << 29) | (1 << 2) | 1,
+    33: (1 << 33) | (1 << 13) | 1,
+    35: (1 << 35) | (1 << 2) | 1,
+    39: (1 << 39) | (1 << 4) | 1,
+    41: (1 << 41) | (1 << 3) | 1,
+    47: (1 << 47) | (1 << 5) | 1,
+    49: (1 << 49) | (1 << 9) | 1,
+}
