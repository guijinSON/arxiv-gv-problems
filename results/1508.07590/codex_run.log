+    value = int(encoded, 16)
+    if value >= (1 << degree):
+        return None, f"polynomial has a nonzero coefficient above degree {degree - 1}"
+    if value == 0:
+        return None, "the statement implies that the preimage is nonzero"
+    return value, "ok"
