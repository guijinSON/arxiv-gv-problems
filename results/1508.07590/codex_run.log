+# remains inside the theorem's parameter regime and squares the exponent length.
+DIFFICULTY = {
+    "demo": {"n": 2},       # GF(2^5), genuinely hand-scale
+    "easy": {"n": 10},      # GF(2^21), first rung satisfying G4
+    "medium": {"n": 14},    # GF(2^29)
+    "hard": {"n": 19},      # GF(2^39)
