+| medium | 2303 | No | residue 309,443,415,866,133,646,273,747 |
+| hard | 3301 | No | residue 162,497,905,910,669,544,707,911,118,252,299,301,957 |
+| hard | 3302 | No | residue 121,520,429,258,210,065,720,537,623,958,128,756,504 |
