+        for name, rows in attack_rows.items()
+    }
+    report["gates"]["G6_adversary_panel"] = {
+        "passed": len(attack_rows) >= 3 and all(attack_pass.values()),
+        "seeds_per_attack": 8,
+        "attack_passed": attack_pass,
