+
+    # G7: larger n enlarges n! and the doubled instance still verifies.
+    before = make_instance(n=29, k=11, seed=771)
+    doubled = make_instance(n=58, k=11, seed=771)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
