+        "drop": planted[:-1],
+        "swap": swap,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": planted[:-1] + [small["n"]],
+    }
+    corruption_results = {}
+    reasons = []
+    for name, value in corruptions.items():
+        ok, reason = verify(small, value)
