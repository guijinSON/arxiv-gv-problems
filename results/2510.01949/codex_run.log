+    if not answer:
+        return False, "answer is empty"
+    if len(answer) < n:
+        return False, f"answer has fewer than {n} entries"
+    if len(answer) > n:
+        return False, f"answer has more than {n} entries"
+    if any(type(value) is not int for value in answer):
