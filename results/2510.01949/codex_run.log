+        transformed = [
+            _relabel_instance(inst, left1, right1, identity_order, False),
+            _relabel_instance(inst, list(range(inst["n"])),
+                              list(range(inst["n"])), order1, False),
+            _relabel_instance(inst, left1, right1, order1, True),
