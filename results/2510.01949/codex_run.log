+        answer = _inverse(answer)
+    transformed = [rows[index] for index in reorder]
+    transformed_answer = answer
+    return {
+        "n": n,
+        "k": inst["k"],
+        "matchings": transformed,
+        "_inverse_matchings": [_inverse(row) for row in transformed],
+        "answer": transformed_answer,
+    }
