import random,time

def isprime(n):
 for d in range(2,int(n**.5)+1):
  if n%d==0:return False
 return n>1

def inst(m,k,seed):
 rng=random.Random(seed)
 al=list(range(m)); be=list(range(m)); rng.shuffle(al); rng.shuffle(be)
 # displayed left x corresponds hidden al[x]; right display inverse be? be[h] is display
 ial=[0]*m
 for x,h in enumerate(al): ial[x]=h
 # match shift a: hidden right=hidden left+a, display be[...]
 S=[0,1,2,m-1]
 rem=[a for a in range(4,m-1) if a"'!=3]
 rng.shuffle(rem); S+=rem[:k-4]
 # first two fixed 0,1; rest random order
 rest=S[2:];rng.shuffle(rest);S=S[:2]+rest
 P=[]
 for a in S:
  P.append([be[(ial[x]+a)%m] for x in range(m)])
 target=[be[(ial[x]+3)%m] for x in range(m)]
 return P,target,S

def valid(P,a):
 m=len(a)
 if sorted(a)!=list(range(m)):return False
 for p in P:
  inv=[0]*m
  for x,r in enumerate(p):inv[r]=x
  q=[inv[a[x]] for x in range(m)]
  seen=set();x=0
  while x not in seen:
   seen.add(x);x=q[x]
  if x!=0 or len(seen)!=m:return False
 return True

def dfs(P, maxnodes=10000000):
 m=len(P[0]); k=len(P)
 inv=[]
 for p in P:
  q=[0]*m
  for x,r in enumerate(p):q[r]=x
  inv.append(q)
 nxt=[[-1]*m for _ in range(k)]
 prv=[[-1]*m for _ in range(k)]
 ans=[-1]*m; used=[False]*m;nodes=0
 # dynamic choose next smallest x. random right order numeric
 def closes(i,x,y,depth):
  # adding x->y. since x unassigned and y has no pred. closes iff path from y reaches x
  z=y
  while z!=-1:
   if z==x:return depth+1<m
   z=nxt[i][z]
  return False
 def rec(depth):
  nonlocal nodes
  if nodes>=maxnodes:return False
  if depth==m:return True
  x=depth
  # candidate rights sorted; exclude p_i[x] immediate fixed point automatically closes 1
  for r in range(m):
   if used[r]:continue
   nodes+=1
   ys=[inv[i][r] for i in range(k)]
   if any(prv[i][ys[i]]!=-1 or closes(i,x,ys[i],depth) for i in range(k)):continue
   ans[x]=r;used[r]=True
   for i,y in enumerate(ys):nxt[i][x]=y;prv[i][y]=x
   if rec(depth+1):return True
   for i,y in enumerate(ys):nxt[i][x]=-1;prv[i][y]=-1
   used[r]=False;ans[x]=-1
  return False
 t=time.perf_counter();ok=rec(0);return ok,ans,nodes,time.perf_counter()-t
for m in [17,23,29,37,43,53,59]:
 for k in [5,6,7]:
  vals=[]
  for s in range(3):
   P,t,S=inst(m,k,s)
   ok,a,nodes,tm=dfs(P,2000000)
   vals.append((ok,nodes,round(tm,3),valid(P,a) if ok else False))
  print(m,k,vals)
