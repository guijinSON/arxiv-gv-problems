+        reference_wall += elapsed
+
+    attack_wall = time.perf_counter() - attack_started
+    all_attacks_failed = all(value["successes"] == 0 for value in attacks.values())
+    all_reference_solved = all(run["solved"] for run in reference_runs)
+    reference_algorithm = {
