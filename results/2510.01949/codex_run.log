+        "outlier_row_avoidance": {"successes": 0, "attempts": 0},
+        "greedy_cycle_avoid_no_backtracking": {"successes": 0, "attempts": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0,
+                               "candidates": 0},
+        "in_context_one_step_extrapolation": {"successes": 0, "attempts": 0,
+                                               "candidates": 0},
