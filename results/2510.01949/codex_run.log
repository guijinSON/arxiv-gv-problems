+# n is the size of each bipartition.  make_instance advances it to the next
+# odd prime.  k is the number of constraints; it grows the haystack without
+# changing the answer shape for a fixed n.
+DIFFICULTY = {
+    "demo": {"n": 7, "k": 4},
+    "easy": {"n": 29, "k": 11},
+    "medium": {"n": 43, "k": 13},
