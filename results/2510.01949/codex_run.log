+def _is_prime(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    d = 3
+    while d * d <= value:
+        if value % d == 0:
+            return False
+        d += 2
+    return True
+
+
+def _next_odd_prime(value: int) -> int:
+    q = max(7, int(value))
+    if q % 2 == 0:
+        q += 1
+    while not _is_prime(q):
+        q += 2
+    return q
+
+
+def _inverse(perm: list[int]) -> list[int]:
+    out = [0] * len(perm)
+    for i, value in enumerate(perm):
+        out[value] = i
+    return out
