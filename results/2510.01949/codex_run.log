+
+
+def _compact_candidate(inst: dict) -> tuple[list[int], int]:
+    """Five-pass route using the lexicographically canonical consecutive pair."""
+    n = inst["n"]
+    a, b = sorted(inst["matchings"])[:2]
+    inv_a = _inverse(a)
+    tau = [inv_a[value] for value in b]
+    tau2 = [tau[tau[x]] for x in range(n)]
+    tau3 = [tau[tau2[x]] for x in range(n)]
+    candidate = [a[tau3[x]] for x in range(n)]
