+def escalate(params: dict) -> dict | str | None:
+    n = _next_odd_prime(int(params.get("n", 59)))
+    k = int(params.get("k", 15))
+    if k + 4 <= n - 1:
+        return {"n": n, "k": k + 4}
+    # Increasing n past 59 makes the five-pass intended route exceed 300 exact
