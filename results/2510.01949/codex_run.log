+def _relabel_instance(inst: dict, left_old_to_new: list[int],
+                      right_old_to_new: list[int], reorder: list[int],
+                      swap_sides: bool = False) -> dict:
+    n = inst["n"]
+    transformed = []
+    transformed_answer = None
