+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def _is_prime(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    d = 3
+    while d * d <= value:
+        if value % d == 0:
+            return False
+        d += 2
+    return True
+
+
+def _next_odd_prime(value: int) -> int:
+    q = max(7, int(value))
+    if q % 2 == 0:
+        q += 1
+    while not _is_prime(q):
+        q += 2
+    return q
+
+
+def _inverse(perm: list[int]) -> list[int]:
+    out = [0] * len(perm)
+    for i, value in enumerate(perm):
+        out[value] = i
+    return out
+
+
+def _is_one_cycle_relative(candidate: list[int], inv_matching: list[int]) -> bool:
+    """Whether x -> inv_matching[candidate[x]] is one spanning cycle."""
+    n = len(candidate)
+    current = 0
+    for steps in range(1, n + 1):
+        current = inv_matching[candidate[current]]
+        if current == 0:
+            return steps == n
+    return False
+
+
+def make_instance(n: int, seed: int = 0, k: int = 15, **params) -> dict:
+    """Inverse-generate compatible permutation matchings over a hidden Z_p.
+
+    The answer is the translation with normalized exponent 3.  Exponents -1
+    and 2 are included as decoys, so one-step extrapolation from the two
+    canonical generators merely reproduces a supplied (hence invalid) matching.
+    """
+    size = _next_odd_prime(n)
+    k = int(k)
+    if not 4 <= k <= size - 1:
+        raise ValueError("k must satisfy 4 <= k <= p-1")
+
+    rng = random.Random(seed)
+    left_hidden = list(range(size))
+    right_label = list(range(size))
+    rng.shuffle(left_hidden)
+    rng.shuffle(right_label)
+
+    right_hidden = _inverse(right_label)
+    h0 = left_hidden[0]
+    # a0 and a1 make the first displayed values of their matching arrays 0 and
+    # 1.  Their difference delta is nonzero, and normalized exponent e means
+    # translation a0 + e*delta.
+    a0 = (right_hidden[0] - h0) % size
+    a1 = (right_hidden[1] - h0) % size
+    delta = (a1 - a0) % size
+
+    normalized = {0, 1, 2, size - 1}
+    pool = [e for e in range(size) if e not in normalized and e != 3]
+    rng.shuffle(pool)
+    normalized.update(pool[: k - 4])
+
+    def matching(exponent: int) -> list[int]:
+        shift = (a0 + exponent * delta) % size
+        return [right_label[(left_hidden[x] + shift) % size]
+                for x in range(size)]
+
+    matchings = sorted((matching(e) for e in normalized))
+    answer = matching(3)
+    inverse_matchings = [_inverse(p) for p in matchings]
+    return {
+        "n": size,
+        "k": k,
+        "matchings": matchings,
+        "_inverse_matchings": inverse_matchings,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
