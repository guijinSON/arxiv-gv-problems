+        left1 = list(range(inst["n"]))
+        right1 = list(range(inst["n"]))
+        left2 = list(range(inst["n"]))
+        right2 = list(range(inst["n"]))
+        order1 = list(range(inst["k"]))
+        order2 = list(range(inst["k"]))
