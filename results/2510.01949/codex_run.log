+def _is_prime(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    d = 3
+    while d * d <= value:
+        if value % d == 0:
+            return False
+        d += 2
+    return True
+
+
+def _next_odd_prime(value: int) -> int:
+    q = max(7, int(value))
+    if q % 2 == 0:
+        q += 1
+    while not _is_prime(q):
+        q += 2
+    return q
+
+
+def _inverse(perm: list[int]) -> list[int]:
+    out = [0] * len(perm)
+    for i, value in enumerate(perm):
+        out[value] = i
+    return out
+
+
+def _is_one_cycle_relative(candidate: list[int], inv_matching: list[int]) -> bool:
+    """Whether x -> inv_matching[candidate[x]] is one spanning cycle."""
+    n = len(candidate)
+    current = 0
+    for steps in range(1, n + 1):
+        current = inv_matching[candidate[current]]
+        if current == 0:
+            return steps == n
+    return False
