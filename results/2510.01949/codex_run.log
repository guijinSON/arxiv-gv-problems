+    rng = random.Random(seed)
+    left_hidden = list(range(size))
+    right_label = list(range(size))
+    rng.shuffle(left_hidden)
+    rng.shuffle(right_label)
+
+    indices = list(range(size))
+    rng.shuffle(indices)
