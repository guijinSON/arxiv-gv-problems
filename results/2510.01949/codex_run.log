+                candidate = tuple(base[current[x]] for x in range(n))
+                operations += n
+                power_to_matching.append(candidate)
+                signature_to_power[candidate] = exponent
+                current = [tau[current[x]] for x in range(n)]
+                operations += n
+
+            operations += len(matchings)
