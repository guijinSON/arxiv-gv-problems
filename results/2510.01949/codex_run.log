+            attacks["outlier_row_avoidance"]["successes"] += 1
+
+        candidate = _greedy_cycle_avoid_attack(inst)
+        attacks["greedy_cycle_avoid_no_backtracking"]["attempts"] += 1
+        if candidate is not None and verify(inst, candidate)[0]:
