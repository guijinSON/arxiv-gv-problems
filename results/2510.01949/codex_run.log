+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    ship = make_instance(seed=251001949, **ship_params)
+
+    # G4 and shipping density for G5 use the exact stated permutation prior.
+    guess_rng = random.Random(40401949)
