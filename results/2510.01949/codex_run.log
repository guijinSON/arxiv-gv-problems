        "failures": failures,
    }

    # G2: required corruptions, each forced to a different validation branch.
    small = make_instance(seed=314159, **DIFFICULTY["easy"])
    planted = small["answer"]
    swap = planted[:]
    j = swap.index(small["matchings"][0][0])
    swap[0], swap[j] = swap[j], swap[0]
    duplicate = planted[:]
    duplicate[0] = duplicate[1]
    corruptions = {
        "drop": planted[:-1],
        "swap": swap,
        "duplicate": duplicate,
        "empty": [],
