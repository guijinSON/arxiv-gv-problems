+    swapped = _find_swap_corruption(inst)
+    duplicate = [list(group) for group in inst["answer"]]
+    duplicate[0][0] = duplicate[0][1]
+    out_of_range = [list(group) for group in inst["answer"]]
+    out_of_range[0][0] = inst["n"]
+    corruptions = {
