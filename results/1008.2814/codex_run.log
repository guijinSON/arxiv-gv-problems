+                 and fraction < 0.001),
+        "control_n": tiny["n"],
+        "control_k": tiny["k"],
+        "control_clique_size": tiny["clique_size"],
+        "enumerated_solutions": tiny_count,
+        "structure_aware_search_space": tiny_space,
+        "solution_fraction": fraction,
