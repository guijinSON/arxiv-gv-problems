+    # G8: vertex labels, displayed row order, answer order, and compositions.
+    modes = ("vertex_relabel", "row_reorder", "answer_reorder", "combined")
+    invariance_checks = 0
+    real_transform_checks = 0
+    failures = []
+    unrelated_keys = []
+    for seed in range(20):
