+        "base_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "base_clique_size": inst["clique_size"],
+        "doubled_clique_size": doubled["clique_size"],
+        "base_search_space": search_space(inst),
+        "doubled_search_space": search_space(doubled),
