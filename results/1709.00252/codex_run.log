+    placebo_attempts = ev["placebo"]["attempts"]
+    hinted_rate = ev["hinted"]["solved"] / hinted_attempts if hinted_attempts else 0.0
+    placebo_rate = ev["placebo"]["solved"] / placebo_attempts if placebo_attempts else 0.0
+    within_caps = chars <= 2000 and elements <= 256 and intended_ops <= 300
+    report["G9_no_tool_suitability"] = {
