+    match = re.search(r"<answer\b[^>]*>(.*?)</answer>", text,
+                      flags=re.IGNORECASE | re.DOTALL)
+    if not match:
+        return None
+    body = match.group(1).strip()
+    body = re.sub(r"^```(?:json|text)?\s*", "", body, flags=re.IGNORECASE)
