+STRUCTURAL_HINT = (
+    "Boundary domains are characterized by gray-edge type and interior domains "
+    "by the rarity of their compatible color continuations."
+)
+PLACEBO_HINT = (
+    "Careful bookkeeping of tile numbers and clockwise quarter-turns helps "
+    "avoid transcription errors in the final board."
+)
