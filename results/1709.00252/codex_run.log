+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Gray-edge types fix the boundary domains, while rare compatible color "
+    "continuations are the most constrained interior domains."
+)
+PLACEBO_HINT = (
+    "Careful bookkeeping of tile numbers and clockwise quarter-turns helps "
+    "avoid transcription errors in the final board."
+)
