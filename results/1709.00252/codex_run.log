    74	def _answer_size(mod, params):
    75	    """(atoms, chars) of the serialised planted answer at these parameters.
    76	
    77	    Returns (None, None) if it cannot be measured -- never raises, because this is
    78	    diagnostic and must not be able to fail a run.
    79	    """
    80	    try:
    81	        inst = mod.make_instance(seed=98765, **{k: v for k, v in params.items()
    82	                                                if k != "_preset"})
    83	        ans = inst["answer"]
    84	        blob = json.dumps(ans, default=str)
    85	
    86	        def atoms(a):
    87	            if isinstance(a, dict):  return sum(atoms(v) for v in a.values())
    88	            if isinstance(a, (list, tuple)): return sum(atoms(v) for v in a)
    89	            return 1
    90	        return atoms(ans), len(blob)
    91	    except Exception:                                   # noqa: BLE001
    92	        return None, None
    93	
    94	ENDPOINT = "https://openrouter.ai/api/v1/chat/completions"
    95	
    96	
    97	def _ssl_context():
    98	    """A context with a CA bundle that actually exists.
    99	
   100	    A python.org build on macOS whose "Install Certificates.command" was never
   101	    run has openssl_cafile pointing at a file that is not there, and every call
   102	    dies with CERTIFICATE_VERIFY_FAILED.  The loop treats that as an API error
   103	    and refuses to make a hardness claim, which is the right failure, but it is
   104	    a failure of the machine and not of the family — so find a usable bundle
   105	    first.  Never fall back to an unverified context: this call carries an API
   106	    key.
   107	    """
   108	    ctx = ssl.create_default_context()
   109	    if ctx.cert_store_stats().get("x509_ca", 0) > 0:
   110	        return ctx
   111	    candidates = [os.environ.get("SSL_CERT_FILE"), "/etc/ssl/cert.pem",
   112	                  "/etc/pki/tls/certs/ca-bundle.crt",
   113	                  "/etc/ssl/certs/ca-certificates.crt"]
   114	    try:
   115	        import certifi
   116	        candidates.append(certifi.where())
   117	    except ImportError:
   118	        pass
   119	    for path in candidates:
   120	        if path and os.path.exists(path):
   121	            try:
   122	                return ssl.create_default_context(cafile=path)
   123	            except Exception:                                 # noqa: BLE001
   124	                continue
   125	    sys.exit("ERROR: no usable CA bundle — TLS verification would fail for every "
   126	             "oracle call. On a python.org build, run the bundled "
   127	             "'Install Certificates.command', or set SSL_CERT_FILE.")
   128	
   129	
   130	SSL_CONTEXT = None
   131	SCHEMA_VERSION = 2
   132	
   133	TRANSCRIPT = "llm_loop_transcript.jsonl"
   134	META = ".meta.json"
   135	
   136	
   137	# --- module loading ---------------------------------------------------------
   138	def load_module(path):
   139	    spec = importlib.util.spec_from_file_location("gen", path)
   140	    mod = importlib.util.module_from_spec(spec)
   141	    spec.loader.exec_module(mod)
   142	    for fn in ("make_instance", "render", "parse_answer", "verify", "escalate"):
   143	        if not callable(getattr(mod, fn, None)):
   144	            sys.exit(f"ERROR: {path} has no callable {fn}() — see prompts/codex_task.md STEP 1")
   145	    if not isinstance(getattr(mod, "DIFFICULTY", None), dict) or not mod.DIFFICULTY:
   146	        sys.exit(f"ERROR: {path} has no non-empty DIFFICULTY dict")
   147	    return mod
   148	
