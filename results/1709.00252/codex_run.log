def attack(inst,budget=1_000_000):
 n=inst['n']; total=n*n; by=g._oriented_options(inst); freq=Counter(x for t in inst['tiles'] for x in t if x)
 for opts in by.values(): opts.sort(key=lambda x:(freq.get(x[2][1],0)+freq.get(x[2][2],0),x[0],x[1]))
 board=[None]*total; used=[False]*total; ans=[0]*total; nodes=backs=0; exhausted=False; t0=time.perf_counter()
 def opts(pos):
  r,c=divmod(pos,n); top=0 if r==0 else board[pos-n][2]; left=0 if c==0 else board[pos-1][1]
  for tid,turn,sides in by.get((top,left),[]):
   if used[tid]:continue
   if (sides[1]==0)"'!=(c==n-1) or (sides[2]==0)!=(r==n-1):continue
   yield tid,turn,sides
 def viable_neighbor(pos,sides):
  r,c=divmod(pos,n)
  # right position top is available only if its up assigned (it is for row-major except top row)
  if c<n-1:
   rp=pos+1; rtop=0 if r==0 else board[rp-n][2]
   ok=False
   for tid,turn,ss in by.get((rtop,sides[1]),[]):
    if not used[tid] and (ss[1]==0)==(c+1==n-1) and (ss[2]==0)==(r==n-1):ok=True;break
   if not ok:return False
  # below position can test left only if below-left assigned (only when c>0), else scan all by top among any left? 
  if r<n-1:
   bp=pos+n
   if c==0:
    bleft=0
   else:
    bleft=board[bp-1][1] if board[bp-1] is not None else None
   if bleft is not None:
    ok=False
    for tid,turn,ss in by.get((sides[2],bleft),[]):
     if not used[tid] and (ss[1]==0)==(c==n-1) and (ss[2]==0)==(r+1==n-1):ok=True;break
    if not ok:return False
