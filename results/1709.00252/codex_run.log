   166	# --- the oracle call --------------------------------------------------------
   167	def _ask_blocking(model, prompt, key):
   168	    """Return (reply_text, http_status, finish_reason, error, empty).
   169	
   170	    Exactly one of reply/error is set.  An empty body is NOT an API error: it is
   171	    flagged via `empty`, and attempt() scores it as an unsolved attempt.  A model
   172	    that spends its whole budget on reasoning and emits nothing did not produce a
   173	    witness under the conditions the pool is measured at, so it consumes its slot
   174	    rather than being redrawn.  The diagnostic is preserved in verify_reason so a
   175	    level hardened this way can still be told apart from one hardened on wrong
   176	    answers -- if ORACLE_MAX_TOKENS is the real constraint, raise it and re-run.
   177	
   178	    Every model in the default pool accepts OpenRouter's normalised `reasoning`
   179	    field, so no per-vendor body mapping is needed.  A model that rejects it is
   180	    reported as an error rather than silently retried without it — dropping the
   181	    effort setting would change what the hardness claim means.
   182	    """
   183	    body = json.dumps({
   184	        "model": model,
   185	        "reasoning": {"effort": ORACLE_EFFORT},
   186	        "messages": [{"role": "user", "content": prompt}],
   187	        "max_tokens": MAX_TOKENS,
   188	    }).encode()
   189	    req = urllib.request.Request(
   190	        ENDPOINT, data=body,
   191	        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
   192	    )
   193	    try:
   194	        with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT,
   195	                                    context=SSL_CONTEXT) as resp:
   196	            status = resp.status
   197	            payload = json.loads(resp.read().decode())
   198	    except urllib.error.HTTPError as e:
   199	        return None, e.code, None, f"http {e.code}: {e.read()[:400].decode('utf-8', 'replace')}", False
   200	    except Exception as e:                                    # noqa: BLE001
   201	        return None, None, None, f"{type(e).__name__}: {e}", False
   202	    try:
   203	        choice = payload["choices"][0]
   204	        text = choice["message"]["content"]
   205	        finish = choice.get("finish_reason") or choice.get("native_finish_reason")
   206	    except (KeyError, IndexError, TypeError):
   207	        return None, status, None, f"unparseable response: {json.dumps(payload)[:400]}", False
   208	    if not (text or "").strip():
   209	        usage = payload.get("usage") or {}
   210	        return None, status, finish, (
   211	            f"empty reply (finish_reason={finish}, usage={json.dumps(usage)[:160]}) — "
   212	            f"the model returned no content, most likely because reasoning consumed "
   213	            f"max_tokens={MAX_TOKENS}; raise ORACLE_MAX_TOKENS"), True
   214	    return text, status, finish, None, False
   215	
   216	
   217	def ask(model, prompt, key):
   218	    """_ask_blocking under a hard wall-clock deadline.
   219	
   220	    A deadline overrun is reported as an ERROR, not a failure to solve: the model
   221	    never got to answer, so scoring it as unsolved would manufacture hardness out
   222	    of a hung socket.  attempt() redraws against a different vendor.
   223	    """
   224	    box = {}
   225	
   226	    def run():
   227	        try:
   228	            box["v"] = _ask_blocking(model, prompt, key)
   229	        except Exception as e:                                # noqa: BLE001
   230	            box["v"] = (None, None, None, f"{type(e).__name__}: {e}", False)
   231	
   232	    # daemon=True matters: a wedged socket must not keep the interpreter alive at
   233	    # exit, which is exactly what a ThreadPoolExecutor worker would do.
   234	    t = threading.Thread(target=run, daemon=True, name=f"oracle-{model}")
   235	    t.start()
   236	    t.join(TOTAL_DEADLINE)
   237	    if t.is_alive():
   238	        return (None, None, None,
   239	                f"total deadline exceeded: no complete response in {TOTAL_DEADLINE}s",
   240	                False)
   241	    return box.get("v", (None, None, None, "worker produced no result", False))
   242	
   243	
   244	def attempt(mod, model, params, seed, key):
   245	    """One oracle call.  Returns the transcript record for it."""
   246	    inst = mod.make_instance(seed=seed, **params)
   247	    t0 = time.time()
   248	    reply, status, finish, error, empty = ask(model, mod.render(inst), key)
   249	    elapsed = round(time.time() - t0, 2)
   250	
   251	    rec = {
   252	        "schema_version": SCHEMA_VERSION,
   253	        "model": model,
   254	        "effort": ORACLE_EFFORT,
   255	        "params": dict(params),
   256	        "seed": seed,
   257	        "solved": "error",
   258	        "parsed": False,
   259	        "verify_ok": None,
   260	        "verify_reason": None,
   260	        "verify_reason": None,
   261	        "reply": reply,
   262	        "error": error,
   263	        "elapsed_sec": elapsed,
   264	        "http_status": status,
   265	        "finish_reason": finish,
   266	    }
   267	    if empty:
   268	        # Scored as an unsolved attempt, not an API error: the model returned no
   269	        # witness within its budget.  error stays None so the invariant
   270	        # "error is not None => solved == 'error'" holds.
   271	        rec["solved"] = "failed"
   272	        rec["verify_reason"] = f"empty length-limited response ({error})"
   273	        rec["error"] = None
   274	        return rec
   275	    if error is not None:
   276	        return rec
   277	
   278	    ans = mod.parse_answer(reply)
   279	    rec["parsed"] = ans is not None
   280	    if ans is None:
   281	        # Not an error, and not evidence of hardness either: a reply that
   282	        # visibly contains an answer but does not parse is a renderer bug.
   283	        rec["solved"] = "failed"
   284	        rec["verify_reason"] = "parse_answer returned None"
   285	        return rec
   286	
   287	    ok, why = mod.verify(inst, ans)
   288	    rec["verify_ok"] = bool(ok)
   289	    rec["verify_reason"] = why
   290	    rec["solved"] = "solved" if ok else "failed"
   291	    return rec
   292	
   293	
   294	# --- the loop ---------------------------------------------------------------
   295	def run_level(mod, params, preset, escalation_round, rng, key, out):
   296	    """Ask the pool to solve this difficulty.  Returns True if any model solved it.
   297	
   298	    Draws distinct models where the pool allows, so three failures are three
   299	    vendors failing rather than one vendor failing three times.  A call that
   300	    errors out is redrawn against a different model and does not consume an
   301	    attempt: an API outage must never be recorded as the model failing to solve,
   302	    which is exactly how a hardness claim gets manufactured out of a 500.  An
   303	    empty length-limited reply is NOT an error -- it is scored as a failure and
   304	    consumes its slot (see ask()).
   305	    """
   306	    k = min(ATTEMPTS_PER_PRESET, len(ORACLE_POOL))
   307	    schedule = rng.sample(ORACLE_POOL, k)
   308	    while len(schedule) < ATTEMPTS_PER_PRESET:
   309	        schedule.append(rng.choice(ORACLE_POOL))
   310	
   311	    # A redraw after an error has to keep the level spread across vendors.  One
   312	    # model that reliably errors on a family — a reasoning budget it never
   313	    # escapes at this size, say — would otherwise hand its slot to a vendor that
   314	    # is either already here or queued next, and "three vendors failed" quietly
   315	    # becomes "two vendors failed, one of them twice".  Observed live: at n=80 a
   316	    # sonnet-5 timeout put gpt-5.6-terra in two of three slots.  So a substitute
   317	    # must avoid whoever has spoken AND whoever is still pending.
   318	    spoke = set()
   319	    solved_any = False
   320	    for slot in range(len(schedule)):
   321	        model = schedule[slot]
   322	        pending = set(schedule[slot + 1:])
   323	        tried, rec = 0, None
   324	        while tried <= MAX_ERROR_RETRIES:
   325	            seed = rng.randrange(1, 2**31 - 1)
   326	            if tried == 0:
   327	                use = model
   328	            else:
   329	                fresh = [m for m in ORACLE_POOL if m not in spoke and m not in pending]
   330	                use = rng.choice(fresh or [m for m in ORACLE_POOL if m not in spoke]
   331	                                 or ORACLE_POOL)
   332	            rec = attempt(mod, use, params, seed, key)
   333	            rec["preset"] = preset
   334	            rec["escalation_round"] = escalation_round
   335	            out.write(json.dumps(rec) + "\n")
   336	            out.flush()
   337	            if rec["solved"] != "error":
   338	                spoke.add(use)
   339	                break
   340	            tried += 1
   341	            print(f"  ! {use} errored ({rec['error'][:80]}) — redrawing", file=sys.stderr)
   342	        if rec is None or rec["solved"] == "error":
   343	            sys.exit("ERROR: the oracle pool is unreachable — cannot make a hardness claim.")
   344	        mark = {"solved": "SOLVED", "failed": "failed"}[rec["solved"]]
   345	        print(f"  {rec['model']:38s} seed={rec['seed']:<12d} {mark}", file=sys.stderr)
   346	        if rec["solved"] == "solved":
   347	            solved_any = True
   348	    return solved_any
   349	
   350	
   351	def main():
   352	    if len(sys.argv) != 2:
   353	        sys.exit("usage: python3 scripts/harden.py <path to gen_*.py>")
   354	    key = os.environ.get("OPENROUTER_API_KEY")
   355	    if not key:
   356	        sys.exit("ERROR: OPENROUTER_API_KEY is required — the oracle pool spans four "
   357	                 "vendors, so an OpenAI key alone cannot reach it.")
   358	
   359	    global SSL_CONTEXT
   360	    SSL_CONTEXT = _ssl_context()
   361	
   362	    mod = load_module(sys.argv[1])
   363	
   364	    # One master seed governs every draw below — model choice and instance
   365	    # seeds alike — and is recorded, so a run is reproducible without any seed
   366	    # being fixed in advance.
   367	    master = int(os.environ.get("HARDEN_MASTER_SEED") or
   368	                 int.from_bytes(os.urandom(8), "big"))
   369	    rng = random.Random(master)
   370	    update_meta(schema_version=SCHEMA_VERSION, harden_master_seed=master,
   371	                oracle_pool=ORACLE_POOL, oracle_effort=ORACLE_EFFORT,
   372	                max_escalations=MAX_ESCALATIONS)
   373	
   374	    # `demo` is a hand-scale illustration rung, built to be solvable.  Starting
   375	    # the ladder there would spend one of MAX_ESCALATIONS proving that, so the
   376	    # hardening ladder begins at `easy`.
   377	    ladder = [dict(p, _preset=name) for name, p in mod.DIFFICULTY.items()
   378	              if name != "demo"]
   379	    params = ladder[0]
   380	    rung = 0
   381	    verdict = None
   382	
   383	    with open(TRANSCRIPT, "w") as out:
   384	        axes_moved = set()          # every param key any level transition changed
   385	        prev_call = None
   386	        for escalation_round in range(MAX_ESCALATIONS + 1):
   387	            shown = {k: v for k, v in params.items() if k != "_preset"}
   388	            print(f"[round {escalation_round}] {params.get('_preset')} {shown}", file=sys.stderr)
   389	            call = {k: v for k, v in params.items() if k != "_preset"}
   390	            # Record which dials moved since the previous level. This has to cover
   391	            # the fixed ladder as well as escalate(): 2601.05272 climbed
   392	            # n=64,72,80,84 through its LADDER and only then called escalate(), so
   393	            # counting escalate()'s moves alone would have seen no axis at all.
   394	            if prev_call is not None:
   395	                for _k, _v in call.items():
   396	                    if prev_call.get(_k) != _v:
   397	                        axes_moved.add(_k)
   398	            prev_call = dict(call)
   399	            preset = params.get("_preset", "escalated")
   400	            if not run_level(mod, call, preset, escalation_round, rng, key, out):
   401	                verdict = {"verdict": "hardened", "escalations_used": escalation_round,
   402	                           "shipping_params": call, "preset": preset}
   403	                break
   404	            print("  -> solved; escalating", file=sys.stderr)
   405	
   406	            rung += 1
   407	            if rung < len(ladder):
   408	                params = ladder[rung]
   409	            else:
   410	                nxt = mod.escalate(call)
   411	                # A module may say "I could go harder, but the answer would no
   412	                # longer fit under the cap" by returning the string "cap_bound".
   413	                # That is NOT the same verdict as "this family has no hardness
   414	                # left": the first is a property of our answer format, the second
   415	                # is a property of the paper. Ten rejections were papers whose
   416	                # escalate() stopped at the cap and were then discarded as
   417	                # too_easy -- judged un-writable, not unsuitable.
   418	                if nxt == "cap_bound":
   419	                    verdict = {"verdict": "cap_bound",
   420	                               "escalations_used": escalation_round,
   421	                               "reason": "the family can be made harder, but only by "
   422	                                         "lengthening the answer past the output cap. "
   423	                                         "This is a limit of the answer format, not of "
   424	                                         "the paper -- do not reject it as too_easy."}
   425	                    break
   426	                if nxt is None:
   427	                    # Do not take "None" at face value. cap_bound has been documented
   428	                    # in the escalate() contract and in STEP 0, and builders still
   429	                    # return None when what they mean is "the answer would not fit":
   430	                    # 2601.05272 climbed n=64,72,80,84 and stopped at 249 atoms
   431	                    # against a 256 cap, then reported "the family cannot be made
   432	                    # harder", which was false. Measure it here instead of asking.
   433	                    _atoms, _chars = _answer_size(mod, call)
   434	                    _near = False
   435	                    if _atoms is not None:
   436	                        _near = (_atoms >= CAP_NEAR_FRACTION * ANSWER_ATOM_CAP
   437	                                 or _chars >= CAP_NEAR_FRACTION * ANSWER_CHAR_CAP)
   438	                    _one_dial = len(axes_moved) <= 1
   439	                    if _near or _one_dial:
   440	                        verdict = {
   441	                            "verdict": "cap_bound",
   442	                            "escalations_used": escalation_round,
   443	                            "answer_atoms": _atoms, "answer_chars": _chars,
   444	                            "atom_cap": ANSWER_ATOM_CAP, "char_cap": ANSWER_CHAR_CAP,
   445	                            "axes_moved": sorted(axes_moved),
   446	                            # Two different diagnoses share this verdict, and the
   447	                            # cure differs. "answer_cap": the format genuinely
   448	                            # blocked the ladder -- needs a fixed-length witness.
   449	                            # "single_axis": the ladder only ever turned one dial,
   450	                            # so the family was never actually explored -- often
   451	                            # with a tiny answer and enormous headroom left.
   452	                            "signal": "+".join(
   453	                                x for x in (("answer_cap" if _near else ""),
   454	                                            ("single_axis" if _one_dial else "")) if x),
   455	                            "reason": (
   456	                                "escalate() returned None, but this looks like the ANSWER "
   457	                                "CAP rather than a hardness ceiling"
   458	                                + (f": the answer is already {_atoms} atoms / {_chars} chars "
   459	                                   f"against a {ANSWER_ATOM_CAP}-atom, {ANSWER_CHAR_CAP}-char cap"
   460	                                   if _atoms is not None else "")
   461	                                + (f"; the ladder only ever moved {sorted(axes_moved) or ['nothing']}, "
   462	                                   "so no fixed-answer-length axis was tried"
   463	                                   if _one_dial else "")
   464	                                + ".  PARK this paper -- do not write REJECTED.md.  Harden at "
   465	                                  "fixed answer length instead (bigger ground set with the same "
   466	                                  "witness size, larger modulus, denser decoys, tighter "
   467	                                  "constraints) and re-run."),
   468	                        }
   469	                        break
   470	                    verdict = {"verdict": "too_easy", "escalations_used": escalation_round,
   471	                               "axes_moved": sorted(axes_moved),
   472	                               "answer_atoms": _atoms,
   473	                               "reason": "escalate() returned None — the family cannot be "
   474	                                         "made harder, and the oracle pool still solves it"}
   475	                    break
   476	                params = dict(nxt, _preset="escalated")
   477	        else:
   478	            # The loop ran out of ESCALATIONS, which says nothing about the family
   479	            # until we ask whether it had anywhere left to go.  Ask.
   480	            _atoms, _chars = _answer_size(mod, prev_call or {})
   481	            try:
   482	                _more = mod.escalate(dict(prev_call or {}))
   483	            except Exception:                               # noqa: BLE001
   484	                _more = None
   485	            if _more is not None:
   486	                verdict = {
   487	                    "verdict": "budget_bound",
   488	                    "escalations_used": MAX_ESCALATIONS,
   489	                    "axes_moved": sorted(axes_moved),
   490	                    "answer_atoms": _atoms, "answer_chars": _chars,
   491	                    "next_level": None if _more == "cap_bound" else _more,
   492	                    "escalate_says": "cap_bound" if _more == "cap_bound" else "more levels",
   493	                    "reason": (
   494	                        f"the oracle pool solved every level through {MAX_ESCALATIONS} "
   495	                        f"escalations, but escalate() was STILL WILLING TO CLIMB "
   496	                        f"({'it would next report cap_bound' if _more == 'cap_bound' else _more}). "
   497	                        "The binding constraint was this harness's escalation budget, not "
   498	                        "the paper.  PARK it -- do not write REJECTED.md.  Re-run with "
   499	                        "ORACLE_MAX_ESCALATIONS raised, or ship at a higher preset."),
   500	                }
   501	            else:
   502	                verdict = {"verdict": "too_easy", "escalations_used": MAX_ESCALATIONS,
   503	                           "axes_moved": sorted(axes_moved),
   504	                           "answer_atoms": _atoms, "answer_chars": _chars,
   505	                           "reason": f"the oracle pool solved every level through "
   506	                                     f"{MAX_ESCALATIONS} escalations, and escalate() "
   507	                                     f"has nothing further to offer"}
   508	
   509	    update_meta(harden_verdict=verdict)
   510	    print(json.dumps(verdict, indent=1))
   511	    # 0 hardened / 9 too_easy (give the paper up) / 10 park it -- the paper is fine
   512	    # and the binding constraint is ours: the answer format (cap_bound) or the
   513	    # escalation budget (budget_bound).
   514	    return {"hardened": 0, "cap_bound": 10, "budget_bound": 10}.get(verdict["verdict"], 9)
   515	
