   if nodes>=budget:exhausted=True;return False
   nodes+=1;used[tid]=True;board[pos]=ss;ans[pos]=4*tid+turn
   if viable_neighbor(pos,ss) and dfs(pos+1):return True
   used[tid]=False;board[pos]=None;backs+=1
   if exhausted:return False
  return False
 sol=dfs(0);return sol,nodes,time.perf_counter()-t0,exhausted
for n,c in [(7,7),(8,7),(9,7),(10,8),(12,10),(14,11)]:
