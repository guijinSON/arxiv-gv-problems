   642	        old, rotation = divmod(code, 4)
   643	        new = old_to_new[old]
   644	        carried.append(4 * new + ((rotation - turns[new]) % 4))
   645	    changed = {k: v for k, v in inst.items()
   646	               if k not in ("tiles", "answer") and not k.startswith("_")}
   647	    changed["tiles"] = new_tiles
   648	    changed["answer"] = carried
   649	    return changed, carried
