   150	# --- metadata ---------------------------------------------------------------
   151	def read_meta():
   152	    try:
   153	        with open(META) as f:
   154	            return json.load(f)
   155	    except (OSError, ValueError):
   156	        return {}
   157	
   158	
   159	def update_meta(**fields):
   160	    meta = read_meta()
   161	    meta.update(fields)
   162	    with open(META, "w") as f:
   163	        json.dump(meta, f, indent=1)
