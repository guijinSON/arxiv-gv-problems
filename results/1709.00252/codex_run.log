+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": ev["hinted_verdict"],
+        "answer_chars": chars,
+        "answer_tokens": tokens,
+        "answer_elements": elements,
+        "answer_size_sample_count": len(metrics),
+        "intended_route_operations": intended_ops,
+        "intended_route_operation_definition": (
+            "one constrained tile selection per board cell after propagation "
+            "has exposed the viable continuation"
+        ),
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(ship_params)
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=False))

codex
The first prototype is promising but the initial “standard attack” budget was too cheap to be meaningful: it failed after only 0.08 seconds. I raised the audit substantially in a calibration run. A chronological CSP/DPLL solver with forward checking exhausted 5,000,000 branches on each of eight independent 14×14 instances, taking roughly 3.2–5.7 seconds per instance and finding no witness. This is the baseline scale I’ll record; the smaller 100,000-node result would not support a hardness claim.
