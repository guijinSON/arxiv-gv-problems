+DIFFICULTY = {
+    "demo": {"n": 2, "colors": 3, "dpll_nodes": 2_000},
+    "easy": {"n": 7, "colors": 7, "dpll_nodes": 25_000},
+    "medium": {"n": 10, "colors": 9, "dpll_nodes": 50_000},
