+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A row-major list of exactly n^2 oriented-tile codes.  Code 4*t+r "
+        "uses 0-indexed tile t exactly once with clockwise rotation r in "
