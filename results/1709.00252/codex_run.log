s=importlib.util.spec_from_file_location('g','gen_1709_00252.py');g=importlib.util.module_from_spec(s);s.loader.exec_module(g)

def mrv(inst,budget=500000):
 n=inst['n'];N=n*n
 oriented=[]
 for tid,tile in enumerate(inst['tiles']):
  seen=set()
  for turn in range(4):
   ss=tuple(g._rotate(tile,turn))
   if ss not in seen:seen.add(ss);oriented.append((tid,turn,ss))
 posbase=[]
 for p in range(N):
  out=g._outward_sides(n,p)
  posbase.append([o for o in oriented if g._zero_sides(o[2])==out])
 board=[None]*N; used=[False]*N; ans=[0]*N;nodes=backs=0;ex=False;t0=time.perf_counter()
 neigh=[]
 for p in range(N):
  r,c=divmod(p,n); z=[]
  if r:z.append((p-n,0,2))
  if c<n-1:z.append((p+1,1,3))
  if r<n-1:z.append((p+n,2,0))
  if c:z.append((p-1,3,1))
  neigh.append(z)
 def candidates(p,stop=None):
  z=[]
  for o in posbase[p]:
   tid,turn,ss=o
   if used[tid]:continue
   if all(board[q] is None or ss[side]==board[q][oside] for q,side,oside in neigh[p]):
    z.append(o)
    if stop and len(z)>=stop:return z
  return z
 def pick():
  # frontier first, count exact; fail fast
  best=None;bestcand=None;bestscore=None
  for p in range(N):
   if board[p] is not None:continue
   adj=sum(board[q] is not None for q,_,_ in neigh[p])
   if not adj:continue
   cs=candidates(p, None if bestcand is None else len(bestcand)+1)
   if not cs:return p,[]
   score=(-adj,len(cs),p)
   if bestscore is None or score<bestscore:best=p;bestcand=cs;bestscore=score
  if best is not None:return best,bestcand
  # initial corner with smallest tile id symmetry
  p=0;cs=candidates(p);m=min(x[0] for x in cs);return p,[x for x in cs if x[0]==m]
 def dfs(depth):
  nonlocal nodes,backs,ex
  if depth==N:return True
  p,cs=pick()
  for tid,turn,ss in cs:
   if nodes>=budget:ex=True;return False
   nodes+=1;used[tid]=True;board[p]=ss;ans[p]=4*tid+turn
   viable=True
   for q,_,_ in neigh[p]:
    if board[q] is None and not candidates(q,1):viable=False;break
   if viable and dfs(depth+1):return True
   used[tid]=False;board[p]=None;backs+=1
   if ex:return False
  return False
 sol=dfs(0);return sol,nodes,time.perf_counter()-t0,ex,(g.verify(inst,ans)[0] if sol else False)
for n,c in [(5,5),(6,6),(7,7),(8,7),(9,7),(10,8),(12,10),(14,11)]:
 out=mrv(g.make_instance(n=n,colors=c,dpll_nodes=1,seed=20260905),200000)
 print(n,c,out)
