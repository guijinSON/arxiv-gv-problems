   505	def parse_answer(text: str) -> object | None:
   506	    """Parse the last tagged JSON array, tolerating prose and fences."""
   507	    if not isinstance(text, str):
   508	        return None
   509	    matches = _ANSWER_RE.findall(text)
   510	    if not matches:
   511	        return None
   512	    body = matches[-1].strip()
   513	    if body.startswith("```"):
   514	        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
   515	        body = re.sub(r"\s*```$", "", body)
   516	    try:
   517	        value = json.loads(body)
   518	    except (ValueError, TypeError):
   519	        if re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+){2}", body):
   520	            try:
   521	                value = [int(x.strip()) for x in body.split(",")]
   522	            except ValueError:
   523	                return None
   524	        else:
   525	            return None
   526	    return value
