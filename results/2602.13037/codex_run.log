+
+def _fast_rule_check(inst: dict, rule: object,
+                     counter: list[int] | None = None) -> bool:
+    if not (isinstance(rule, list) and len(rule) == 3 and
+            all(isinstance(x, int) and not isinstance(x, bool) for x in rule)):
+        return False
