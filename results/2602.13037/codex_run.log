+DIFFICULTY = {
+    "demo": {"n": 6, "q": 11},
+    "easy": {"n": 90, "q": 101},
+    "medium": {"n": 600, "q": 503},
+    "hard": {"n": 2400, "q": 1009},
+}
+SHIPPING_DIFFICULTY = "hard"
