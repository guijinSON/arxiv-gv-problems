+def enumerate_all(inst: dict) -> int | None:
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    q = inst["q"]
+    count = 0
+    for a in range(q):
+        for b in range(q):
+            if a == b == 0:
+                continue
+            for d in range(q):
+                if _fast_rule_check(inst, [a, b, d]):
+                    count += 1
+    return count
