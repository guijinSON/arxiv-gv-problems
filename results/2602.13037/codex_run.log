   529	def _expanded_target(inst: dict, colors: dict[int, int]) -> tuple[list[tuple[int, int]],
   530	                                                                   list[tuple[int, int]]]:
   531	    """Return (kind,color) per vertex and every edge of the actual target H."""
   532	    n = inst["n"]
   533	    assignments: list[tuple[int, int]] = [(-1, -1)] * (9 * n)
   534	    for v in range(n):
   535	        assignments[v] = (1, colors[v])
   536	        assignments[n + v] = (1, (colors[v] + 1) % 3)       # u(v)
   537	        assignments[2 * n + v] = (2, 0)                     # x(v)
   538	        for j in range(2):
   539	            for r in range(3):
   540	                assignments[3 * n + 6 * v + 3 * j + r] = (1, r)
   541	
   542	    edges: list[tuple[int, int]] = [(int(u), int(v)) for u, v in inst["base_edges"]]
   543	    for v in range(n):
   544	        u_node, x_node = n + v, 2 * n + v
   545	        edges.append((v, u_node))
   546	        edges.append((u_node, x_node))
   547	        for j in range(2):
   548	            triple = [3 * n + 6 * v + 3 * j + r for r in range(3)]
   549	            edges.extend((x_node, t) for t in triple)
   550	            edges.extend((triple[r], triple[s]) for r in range(3) for s in range(r + 1, 3))
   551	    return assignments, edges
