+DIFFICULTY = {
+    "demo": {"n": 6, "q": 11},
+    "easy": {"n": 90, "q": 101},
+    "medium": {"n": 600, "q": 503},
+    "hard": {"n": 2400, "q": 1009},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The shared triangles carry one three-color phase whose coordinate classes "
+    "are three parallel affine fibers."
+)
+PLACEBO_HINT = (
+    "The listed triangles require careful attention to the stated finite-field "
+    "and indexing conventions."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "Exactly three base-10 integers [a,b,d] with 0<=a,b,d<q and "
+        "(a,b)!=(0,0), representing C(X,Y)=(aX+bY+d) mod q."
+    ),
+    "bounds": {
+        "coefficients": 3,
+        "coefficient_min": 0,
+        "coefficient_max": "q-1",
+        "linear_part_nonzero": True,
