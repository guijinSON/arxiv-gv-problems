import importlib.util, json, pathlib, random
p=pathlib.Path('gen_2602_13037.py')
spec=importlib.util.spec_from_file_location('g',p)
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.TRACK in ('A','B')
