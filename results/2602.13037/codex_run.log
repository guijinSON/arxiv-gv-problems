+def _distance_signature(inst: dict) -> tuple:
+    graph, reason = _graph_from_edges(inst["vertex_count"], inst["edges"])
+    if graph is None:
+        raise ValueError(reason)
+    profiles = []
+    for start in graph:
+        dist = {start: 0}
