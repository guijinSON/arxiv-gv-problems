+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the stated nonzero-linear affine certificate language."""
+    q = inst["q"]
+    while True:
+        a, b = rng.randrange(q), rng.randrange(q)
+        if a != 0 or b != 0:
+            return [a, b, rng.randrange(q)]
