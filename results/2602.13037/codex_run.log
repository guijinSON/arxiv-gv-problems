+        key = canonical_key(original)
+        keys.append(key)
+        changed = _affine_transform_instance(_relabel_instance(original, g8_rng), g8_rng)
+        if canonical_key(changed) == key:
+            invariant += 1
+        if verify(changed, changed["answer"])[0]:
