+        "shipping_density_hits": hits,
+        "shipping_density_samples": _G4_SAMPLES,
+        "shipping_density_fraction": probability,
+        "shipping_density_wall_sec": round(density_wall, 6),
+        "demo_exact_solution_count": exact_demo_count,
