+        "drop_one": ans[:-1],
+        "swap_two": [ans[1], ans[0], ans[2]],
+        "duplicate_one": ans + [ans[0]],
+        "empty": [],
+        "out_of_range": [inst["q"], ans[1], ans[2]],
