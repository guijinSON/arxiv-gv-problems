+
+def _build_once(n: int, q: int, seed: int, nonce: int) -> dict:
+    rng = random.Random((seed * 0x9E3779B185EBCA87 + nonce * 0xC2B2AE3D27D4EB4F
+                         + n * 65537 + q) & ((1 << 128) - 1))
