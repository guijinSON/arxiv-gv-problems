+    for seed in range(_ATTACK_SEEDS):
+        current = make_instance(seed=1000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        candidates = {
+            "outlier_extreme_triangle": _outlier_attack(current),
+            "greedy_lowest_label": _greedy_attack(current),
