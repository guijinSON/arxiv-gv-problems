+    b = ((dx1 * dv2 - dx2 * dv1) * inv) % q
+    d = (v0 - a * x0 - b * y0) % q
+    if counter is not None:
+        counter[0] += 11
+    return [a, b, d]
+
+
+def _evaluate(rule: list[int], point: tuple[int, int], q: int,
+              counter: list[int] | None = None) -> int:
+    if counter is not None:
+        counter[0] += 5
+    return (rule[0] * point[0] + rule[1] * point[1] + rule[2]) % q
