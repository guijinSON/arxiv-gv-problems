+def _cube_edge_classes(vertices: set[int], edges: set[tuple[int, int]]) -> list[set[tuple[int, int]]] | None:
+    if len(vertices) != 8 or len(edges) != 12:
+        return None
+    deg = {v: 0 for v in vertices}
+    for u, v in edges:
+        if u not in vertices or v not in vertices or u == v:
+            return None
+        deg[u] += 1
+        deg[v] += 1
