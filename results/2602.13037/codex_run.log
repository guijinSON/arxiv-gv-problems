+        "pass": parsed == ans,
+        "parsed": parsed,
+    }
+
+    # G4 and shipping-density half of G5 share the required 200k exact samples.
+    ship = make_instance(seed=424242, **DIFFICULTY[SHIPPING_DIFFICULTY])
