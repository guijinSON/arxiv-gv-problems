+    dx1, dy1 = (p1[0] - p0[0]) % q, (p1[1] - p0[1]) % q
+    dx2, dy2 = (p2[0] - p0[0]) % q, (p2[1] - p0[1]) % q
+    det = (dx1 * dy2 - dx2 * dy1) % q
+    inv = pow(det, -1, q)
+    out = []
+    for v in order:
+        dx, dy = (coords[v][0] - p0[0]) % q, (coords[v][1] - p0[1]) % q
+        alpha = ((dx * dy2 - dx2 * dy) * inv) % q
+        beta = ((dx1 * dy - dx * dy1) * inv) % q
+        out.append((alpha, beta))
+    return tuple(out)
