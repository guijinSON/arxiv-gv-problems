+    x_used = [0, 0, 0]
+    records: list[list[int]] = []
+    points_by_position: list[tuple[int, int]] = []
+    for i in range(n):
+        color = phase_values[i % 3]
+        x = x_pool[color][x_used[color]]
+        x_used[color] += 1
