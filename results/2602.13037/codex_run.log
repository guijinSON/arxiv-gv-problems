+    if next_q is None or n >= 20000:
+        return None
+    new_n = min(20000, max(n + 1, n * 2))
+    while math.ceil(new_n / 3) > next_q:
+        next_q = next((p for p in _PRIMES if p > next_q), None)
+        if next_q is None:
+            return None
+    current["n"] = new_n
+    current["q"] = next_q
