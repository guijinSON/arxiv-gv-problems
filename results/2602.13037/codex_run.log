+    # G3: exact round trip through realistic prose and a fenced answer.
+    wrapped = "I used the shared phase.\n<answer>```json\n" + json.dumps(ans) + "\n```</answer>\nDone."
+    parsed = parse_answer(wrapped)
+    report["G3_round_trip"] = {
