+_G4_SAMPLES = 200_000
+_ATTACK_SEEDS = 8
+_RANDOM_RESTARTS = 4096
+_ENUMERATION_CAP = 300_000
+_ANCHOR_RULE_CACHE: dict[int, tuple[dict, tuple[tuple[int, int, int], ...]]] = {}
