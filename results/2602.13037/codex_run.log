+    a, b, d = inst["answer"]
+    inv_det = pow(det, -1, q)
+    ap = ((a * m11 - b * m10) * inv_det) % q
+    bp = ((-a * m01 + b * m00) * inv_det) % q
+    dp = (d - ap * tx - bp * ty) % q
