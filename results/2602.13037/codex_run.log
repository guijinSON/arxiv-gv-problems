+def _affine_transform_instance(inst: dict, rng: random.Random) -> dict:
+    out = copy.deepcopy(inst)
+    q = inst["q"]
+    while True:
+        m00, m01, m10, m11 = [rng.randrange(q) for _ in range(4)]
+        det = (m00 * m11 - m01 * m10) % q
+        if det:
