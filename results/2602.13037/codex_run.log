   583	        adj[v].add(u)
   584	        if assignments[u] == assignments[v]:
   585	            kind = "distance-1" if assignments[u][0] == 1 else "distance-2"
   586	            return False, f"target edge {u}-{v} repeats a {kind} color"
   587	    square_vertices = [i for i, item in enumerate(assignments) if item[0] == 2]
   588	    for x in square_vertices:
   589	        for middle in adj[x]:
   590	            for y in adj[middle]:
   591	                if y != x and assignments[y] == assignments[x]:
   592	                    return False, f"target vertices {x} and {y} repeat S within distance 2"
   593	    return True, "ok"
   594	
   595	
   596	def random_candidate(inst: dict, rng: random.Random) -> object:
   597	    """Uniformly sample the stated nonzero-linear affine certificate language."""
   598	    q = inst["q"]
   599	    while True:
   600	        a, b = rng.randrange(q), rng.randrange(q)
   601	        if a != 0 or b != 0:
   602	            return [a, b, rng.randrange(q)]
   603	
   604	
   605	def search_space(inst: dict) -> int:
   606	    q = inst["q"]
   607	    return (q * q - 1) * q
   608	
   609	
   610	def enumerate_all(inst: dict) -> int | None:
   611	    if search_space(inst) > _ENUMERATION_CAP:
   612	        return None
   613	    q = inst["q"]
   614	    count = 0
   615	    for a in range(q):
   616	        for b in range(q):
   617	            if a == b == 0:
   618	                continue
   619	            for d in range(q):
   620	                if _fast_rule_check(inst, [a, b, d]):
   621	                    count += 1
   622	    return count
   623	
   624	
   625	def _chain_orders(inst: dict) -> list[list[int]]:
   626	    n = inst["n"]
   627	    adj = _adjacency(n, inst["base_edges"])
   628	    endpoints = [v for v in range(n) if len(adj[v]) == 2]
   629	    if len(endpoints) != 2:
   630	        raise ValueError("base graph is not a path square")
   650	    coords = _coords_dict(inst)
   651	    p0, p1, p2 = (coords[v] for v in order[:3])
   652	    dx1, dy1 = (p1[0] - p0[0]) % q, (p1[1] - p0[1]) % q
   653	    dx2, dy2 = (p2[0] - p0[0]) % q, (p2[1] - p0[1]) % q
   654	    det = (dx1 * dy2 - dx2 * dy1) % q
   655	    inv = pow(det, -1, q)
   656	    out = []
   657	    for v in order:
   658	        dx, dy = (coords[v][0] - p0[0]) % q, (coords[v][1] - p0[1]) % q
   659	        alpha = ((dx * dy2 - dx2 * dy) * inv) % q
   660	        beta = ((dx1 * dy - dx * dy1) * inv) % q
   661	        out.append((alpha, beta))
   662	    return tuple(out)
   663	
   664	
   665	def canonical_key(inst: dict) -> str:
   666	    """Affine- and relabelling-invariant key for generated path-square instances."""
   667	    signatures = [_affine_frame_signature(inst, order) for order in _chain_orders(inst)]
   668	    payload = json.dumps([inst["q"], min(signatures)], separators=(",", ":"))
   669	    return hashlib.sha256(payload.encode()).hexdigest()
   670	
   671	
   672	def escalate(params: dict) -> dict | str | None:
   673	    """Grow graph size and the coefficient haystack while the answer stays length 3."""
   674	    current = {k: v for k, v in params.items() if k != "_preset"}
   675	    n = int(current.get("n", 90))
   676	    q = int(current.get("q", 101))
   677	    next_q = next((p for p in _PRIMES if p > q), None)
   678	    if next_q is None or n >= 20000:
   679	        return None
   680	    new_n = min(20000, max(n + 1, n * 2))
   681	    while math.ceil(new_n / 3) > next_q:
   682	        next_q = next((p for p in _PRIMES if p > next_q), None)
   683	        if next_q is None:
   684	            return None
   685	    current["n"] = new_n
   686	    current["q"] = next_q
   687	    return current
   688	
   689	
   690	def _reference_algorithm(inst: dict) -> tuple[list[int] | None, int]:
   691	    """Try the six anchor colorings, interpolate, and exactly scan the target."""
   692	    counter = [0]
   693	    coords = _coords_dict(inst)
   694	    ids = list(inst["anchor_triangle"])
   695	    points = [coords[v] for v in ids]
   696	    for values_tuple in itertools.permutations(range(3)):
   697	        counter[0] += 1
   698	        rule = _interpolate(points, list(values_tuple), inst["q"], counter)
   699	        if rule is None or not _fast_rule_check(inst, rule, counter):
   700	            continue
   701	        ok, _ = verify(inst, rule)
   702	        # Count the explicit target construction and edge/distance-two scan.
   703	        counter[0] += inst["target_vertex_count"] + inst["target_edge_count"] + 14 * inst["n"]
   704	        if ok:
   705	            return rule, counter[0]
   706	    return None, counter[0]
   707	
   708	
   709	def _relabel_instance(inst: dict, rng: random.Random) -> dict:
   710	    out = copy.deepcopy(inst)
   711	    labels = list(range(inst["n"]))
   712	    rng.shuffle(labels)
   713	    mapping = {old: labels[old] for old in range(inst["n"])}
   714	    out["base_vertices"] = [[mapping[v], x, y] for v, x, y in inst["base_vertices"]]
   715	    out["base_edges"] = [[min(mapping[u], mapping[v]), max(mapping[u], mapping[v])]
   716	                         for u, v in inst["base_edges"]]
   717	    out["anchor_triangle"] = [mapping[v] for v in inst["anchor_triangle"]]
   718	    out["probe_vertices"] = [mapping[v] for v in inst["probe_vertices"]]
   719	    rng.shuffle(out["base_vertices"])
   720	    rng.shuffle(out["base_edges"])
   721	    rng.shuffle(out["anchor_triangle"])
   722	    return out
   723	
   724	
   725	def _affine_transform_instance(inst: dict, rng: random.Random) -> dict:
   726	    out = copy.deepcopy(inst)
   727	    q = inst["q"]
   728	    while True:
   729	        m00, m01, m10, m11 = [rng.randrange(q) for _ in range(4)]
   730	        det = (m00 * m11 - m01 * m10) % q
   731	        if det:
   732	            break
   733	    tx, ty = rng.randrange(q), rng.randrange(q)
   734	    transformed = []
   735	    for v, x, y in inst["base_vertices"]:
   736	        xp = (m00 * x + m01 * y + tx) % q
   737	        yp = (m10 * x + m11 * y + ty) % q
   738	        transformed.append([v, xp, yp])
   739	    out["base_vertices"] = transformed
   740	
   741	    a, b, d = inst["answer"]
   742	    inv_det = pow(det, -1, q)
   743	    ap = ((a * m11 - b * m10) * inv_det) % q
   744	    bp = ((-a * m01 + b * m00) * inv_det) % q
   745	    dp = (d - ap * tx - bp * ty) % q
   746	    out["answer"] = [ap, bp, dp]
   747	    return out
   748	
   749	
   750	def _answer_metrics(answer: object) -> tuple[int, int, int]:
   751	    blob = json.dumps(answer, separators=(",", ":"))
   752	    atoms = len(answer) if isinstance(answer, list) else 1
   753	    return len(blob), math.ceil(len(blob) / 4), atoms
