+    for p_out in sorted(adj[p]):
+        for q_out in sorted(adj[q]):
+            if p_out == q_out:
+                continue
+            cut = {_norm_edge(p, p_out), _norm_edge(q, q_out)}
+            component = {p}
+            queue = deque([p])
+            while queue and len(component) <= 8:
