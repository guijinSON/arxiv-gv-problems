+def _relabel_instance(inst: dict, rng: random.Random) -> tuple[dict, object]:
+    labels = list(range(inst["vertex_count"]))
+    rng.shuffle(labels)
+    mapping = {old: labels[old] for old in range(inst["vertex_count"])}
+    edges = [
