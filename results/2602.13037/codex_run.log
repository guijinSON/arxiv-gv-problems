+_PRIMES = [11, 101, 503, 1009, 10007, 100003, 1000003, 10000019,
+           100000007, 1000000007, 2147483647]
+_G4_SAMPLES = 200_000
+_ATTACK_SEEDS = 8
+_RANDOM_RESTARTS = 4096
+_ENUMERATION_CAP = 300_000
