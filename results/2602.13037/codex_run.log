+def _find_exposed_patches(
+    adj: dict[int, set[int]], counter: dict[str, int] | None = None
+) -> list[set[int]]:
+    """Find 8-vertex sides of two-edge cuts using edge deletion + bridge DFS."""
+    if counter is None:
+        counter = {"operations": 0}
+    vertices = sorted(adj)
+    edges = _all_core_edges(adj)
+    found: set[frozenset[int]] = set()
+
+    for banned in edges:
+        tin: dict[int, int] = {}
+        tout: dict[int, int] = {}
+        low: dict[int, int] = {}
+        parent: dict[int, int | None] = {}
+        timer = 0
+        bridges: list[tuple[int, int]] = []
+
+        def dfs(u: int, par: int | None) -> None:
+            nonlocal timer
+            parent[u] = par
+            tin[u] = low[u] = timer
+            timer += 1
+            for v in adj[u]:
+                counter["operations"] += 1
+                if _norm_edge(u, v) == banned:
+                    continue
+                if v == par:
+                    continue
+                if v in tin:
+                    low[u] = min(low[u], tin[v])
+                else:
+                    dfs(v, u)
+                    low[u] = min(low[u], low[v])
+                    if low[v] > tin[u]:
+                        bridges.append((u, v))
+            tout[u] = timer - 1
+
+        dfs(vertices[0], None)
+        if len(tin) != len(vertices):
             continue
