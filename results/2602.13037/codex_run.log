+    transformed = []
+    for v, x, y in inst["base_vertices"]:
+        xp = (m00 * x + m01 * y + tx) % q
+        yp = (m10 * x + m11 * y + ty) % q
+        transformed.append([v, xp, yp])
+    out["base_vertices"] = transformed
