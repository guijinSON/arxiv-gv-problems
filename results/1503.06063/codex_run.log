+
+def _xor_clauses(variables, rhs):
+    """The four 3-clauses exactly equivalent to xor(variables) == rhs."""
+    out = []
+    for bits in itertools.product((0, 1), repeat=3):
+        if (bits[0] ^ bits[1] ^ bits[2]) == rhs:
+            continue
