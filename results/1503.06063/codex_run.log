+    parent = [-1] * vertex_count
+    depth = [-1] * vertex_count
+    parent[0] = 0
+    depth[0] = 0
+    queue = deque([0])
+    while queue:
+        here = queue.popleft()
+        for there in adjacency[here]:
+            if depth[there] < 0:
+                depth[there] = depth[here] + 1
+                parent[there] = here
