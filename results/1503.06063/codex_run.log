+    for old, bit in enumerate(inst["answer"]):
+        answer[permutation[old]] = bit ^ int(polarity)
+    return {
+        "n": n,
+        "copies": inst["copies"],
+        "stretch": 4,
+        "diameter_bound": 5,
+        "clauses": clauses,
+        "answer": answer,
