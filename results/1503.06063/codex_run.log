+def _attack_outlier(inst):
+    positive = [0] * inst["n"]
+    negative = [0] * inst["n"]
+    for clause in inst["clauses"]:
+        for literal in clause:
+            (positive if literal > 0 else negative)[abs(literal) - 1] += 1
+    return [int(positive[i] > negative[i]) for i in range(inst["n"])]
