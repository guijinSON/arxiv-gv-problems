+            pair_counts[tuple(sorted(pair))] += 1
+    adjacency = {v: [] for v in range(inst["n"])}
+    for (a, b), count in pair_counts.items():
+        if count == 2:
+            adjacency[a].append(b)
+            adjacency[b].append(a)
