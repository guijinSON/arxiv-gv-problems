        eligible = []
        for i in range(len(trees)):
            ep = endpoints[i]
            inside = ep & set(W)
            outside = ep - set(W)
            if len(ep) == 1 and len(inside) == 1:          # Type 1
                if len(W) == 1:                           # Method 4
