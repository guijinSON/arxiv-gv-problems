+
+
+STRUCTURAL_HINT = (
+    "Clauses with the same three variables form parity quartets whose triple "
+    "overlaps carry a single hidden cyclic order."
+)
+PLACEBO_HINT = (
+    "Clauses with repeated variable names deserve careful bookkeeping because "
