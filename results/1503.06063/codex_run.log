+        for row in range(6):
+            source = variables[row // 2] if row % 2 == 0 else occurrences[row // 2]
+            for col in range(8):
+                if _MATRIX[row][col]:
+                    graph.add(_edge(source, qverts[col]))
+
+        for left, right in zip(qverts, qverts[1:]):
+            graph.add(_edge(left, right))
+
