+# Filled from script-owned transcripts after the three hardening runs.  Until
+# then selftest honestly leaves G9(b) pending rather than manufacturing evidence.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
+}
