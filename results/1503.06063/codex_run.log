+    parent_dsu = list(range(vertex_count))
+
+    def find(x):
+        while parent_dsu[x] != x:
+            parent_dsu[x] = parent_dsu[parent_dsu[x]]
+            x = parent_dsu[x]
+        return x
+
+    for a, b in tree:
+        ra, rb = find(a), find(b)
+        if ra == rb:
+            return False, "expanded certificate contains a cycle"
+        parent_dsu[ra] = rb
