+            "complexity": "O(m log m + n^3) exact Boolean operations",
+            "wall_clock_sec": round(ref_sec, 6),
+            "operations": max(ref_operations),
+            "solves": f"{8 - ref_failures}/8, as expected",
+        },
+        "intended_compact_route": {
