+    all_failed = all(item["successes"] == 0 for item in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and ref_failures == 0 and compact_failures == 0,
+        "attacks": attack_results,
+        "reference_algorithm": {
