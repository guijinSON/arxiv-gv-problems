+    inst = make_instance(seed=42, **params)
+    answer = inst["answer"]
+    unequal = next((i for i in range(1, len(answer)) if answer[i] != answer[0]), 1)
+    swapped = list(answer)
+    swapped[0], swapped[unequal] = swapped[unequal], swapped[0]
+    corruptions = {
+        "drop_one_element": answer[:-1],
