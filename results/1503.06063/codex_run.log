+        "pass": not transform_failures and invariant == 80 and real == 80
+                and len(set(unrelated)) == 20,
+        "transformations": [
+            "variable renaming",
+            "indexed-clause reordering",
+            "global literal polarity with carried assignment",
+            "their composition",
