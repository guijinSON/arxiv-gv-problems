+
+def random_candidate(inst, rng):
+    return [rng.randrange(2) for _ in range(inst["n"])]
+
+
+def search_space(inst):
+    return 1 << inst["n"]
+
+
+def enumerate_all(inst):
+    n = inst["n"]
+    if n > 20:
