+
+def _distance(a, b, parent, depth):
+    distance = 0
+    while depth[a] > depth[b]:
+        a = parent[a]
+        distance += 1
+    while depth[b] > depth[a]:
+        b = parent[b]
+        distance += 1
+    while a != b:
+        a = parent[a]
+        b = parent[b]
+        distance += 2
+    return distance
