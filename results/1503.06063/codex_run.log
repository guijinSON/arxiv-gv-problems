+            sign = 1 if literal > 0 else -1
+            if polarity:
+                sign *= -1
+            changed.append(sign * (permutation[abs(literal) - 1] + 1))
+        clauses.append(changed)
+    if reorder:
+        rng.shuffle(clauses)
+    answer = [0] * n
+    for old, bit in enumerate(inst["answer"]):
+        answer[permutation[old]] = bit ^ int(polarity)
+    return {
+        "n": n,
+        "copies": inst["copies"],
+        "stretch": 4,
+        "diameter_bound": 5,
+        "clauses": clauses,
+        "answer": answer,
+    }
+
