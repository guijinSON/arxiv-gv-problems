+    for clause in inst["clauses"]:
+        changed = []
+        for literal in clause:
+            sign = 1 if literal > 0 else -1
+            if polarity:
+                sign *= -1
+            changed.append(sign * (permutation[abs(literal) - 1] + 1))
+        clauses.append(changed)
+    if reorder:
+        rng.shuffle(clauses)
