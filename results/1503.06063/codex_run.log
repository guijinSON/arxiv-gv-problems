+        "shipping_exact_density_from_full_rank": 1 / search_space(inst),
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "demo_exact_solution_fraction": demo_count / search_space(demo),
