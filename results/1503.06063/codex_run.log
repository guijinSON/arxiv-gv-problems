+def _answer_metrics(answer):
+    blob = json.dumps(answer)
+    atoms = len(answer)
+    # Conservative token proxy for a comma-separated list of one-digit atoms.
+    tokens = math.ceil(len(blob) / 2)
+    return len(blob), tokens, atoms
+
