+            raise ValueError("not a three-distinct-variable clause")
+        key = tuple(sorted(abs(x) - 1 for x in clause))
+        signs = {}
+        for literal in clause:
+            signs[abs(literal) - 1] = 1 if literal > 0 else -1
+        groups[key].append(tuple(signs[v] for v in key))
+
