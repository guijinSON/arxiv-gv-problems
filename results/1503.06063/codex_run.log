+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+# n is the number of Boolean variables.  ``copies`` adds indistinguishable
+# clause-gadget crowding without lengthening the witness.
+DIFFICULTY = {
