+    bad_clause = _first_false_clause(inst, answer)
+    if bad_clause is not None:
+        return False, f"clause {bad_clause} is false under the certificate"
+
+    try:
+        vertex_count, graph, tree = _build_graph_and_tree(inst, answer)
