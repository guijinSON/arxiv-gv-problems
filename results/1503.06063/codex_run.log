+        "doubled_graph_vertices": 6 + doubled_n + 11 * len(doubled["clauses"]),
+        "doubled_build_and_verify_sec": round(time.perf_counter() - doubled_t0, 6),
+        "doubled_verify_reason": doubled_why,
+        "escalation_after_shipping": escalate(params),
