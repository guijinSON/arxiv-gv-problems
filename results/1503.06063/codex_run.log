+    assignment = [0] * inst["n"]
+    for i in range(inst["n"] - 2):
+        key = frozenset((i, i + 1, i + 2))
+        if key in rhs:
+            assignment[i + 2] = assignment[i] ^ assignment[i + 1] ^ rhs[key]
+    return assignment
