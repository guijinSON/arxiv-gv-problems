+def _relabel_instance(inst, rng, reorder_base=False):
+    vcount = inst["variable_count"]
+    perm = list(range(vcount))
+    rng.shuffle(perm)
+    clauses = []
+    order = list(range(len(inst["clauses"])))
+    rng.shuffle(order)
+    for old_ci in order:
+        clause = inst["clauses"][old_ci]
+        shift = rng.randrange(3)
+        clause = clause[shift:] + clause[:shift]
+        clauses.append([[perm[v], neg] for v, neg in clause])
+    old_bits = {v: inst["answer"][i] for i, v in enumerate(inst["base_variables"])}
+    base_variables = [perm[v] for v in inst["base_variables"]]
+    if reorder_base:
+        rng.shuffle(base_variables)
+    else:
+        base_variables.sort()
+    carried = "".join(old_bits[perm.index(v)] for v in base_variables)
+    out = {
+        "family": inst["family"],
+        "n": inst["n"],
+        "presentation_rounds": inst["presentation_rounds"],
+        "variable_count": vcount,
+        "fixed_zero": perm[inst["fixed_zero"]],
+        "base_variables": base_variables,
+        "clauses": clauses,
+        "matrix_dimension": inst["matrix_dimension"],
+        "threshold": list(inst["threshold"]),
+        "answer": carried,
+    }
+    return out
+
+
+def _answer_metrics(answer):
+    encoded = json.dumps(answer, separators=(",", ":"))
+    return len(encoded), math.ceil(len(encoded) / 4), 1
