+    answer_chars = max(x[0] for x in metrics)
+    answer_tokens = max(x[1] for x in metrics)
+    answer_elements = max(x[2] for x in metrics)
+    intended_operations = 6 * (shipping_params["n"] - 2) + 16
+    arms = {name: dict(G9_ORACLE_RESULTS[name])
+            for name in ("bare", "hinted", "placebo")}
+    hinted_attempts = max(1, arms["hinted"]["attempts"])
+    placebo_attempts = max(1, arms["placebo"]["attempts"])
+    hinted_rate = arms["hinted"]["solved"] / hinted_attempts
+    placebo_rate = arms["placebo"]["solved"] / placebo_attempts
+    within_caps = (answer_chars <= 2000 and answer_elements <= 256
+                   and intended_operations <= 300)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
