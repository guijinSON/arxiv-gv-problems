+
+# A clause is a list of three [variable, negated] pairs.  A literal has value
+# assignment[variable] XOR negated, so [v, 0] is y_v and [v, 1] is not y_v.
+
+
+def _nae(values):
+    return not (values[0] == values[1] == values[2])
+
+
+def _validate_params(n, presentation_rounds):
+    if isinstance(n, bool) or not isinstance(n, int) or n < 5:
+        raise ValueError("n must be an integer at least 5")
+    if n % 3 == 0:
+        raise ValueError("n must not be divisible by 3")
+    if isinstance(presentation_rounds, bool) or not isinstance(presentation_rounds, int):
+        raise ValueError("presentation_rounds must be an integer")
+    if not 1 <= presentation_rounds <= 20:
+        raise ValueError("presentation_rounds must be between 1 and 20")
+
+
+def _xor_to_nae(base_values):
+    """Return unpermuted clauses, F id, auxiliary values, and xor rows.
+
+    A parity equation is four ordinary 3-CNF clauses.  Each ordinary clause
+    (a or b or c), interpreted relative to F=0, becomes
+        NAE(a,b,z) and NAE(not z,c,F).
+    The equivalence is checked exhaustively in selftest.
+    """
+    n = len(base_values)
+    fixed = n
+    next_var = n + 1
+    clauses = []
+    full_assignment = {i: int(base_values[i]) for i in range(n)}
+    full_assignment[fixed] = 0
+    xor_rows = []
+
+    for i in range(n):
+        support = (i, (i + 1) % n, (i + 2) % n)
+        rhs = base_values[support[0]] ^ base_values[support[1]] ^ base_values[support[2]]
+        xor_rows.append((support, rhs))
+        for forbidden in itertools.product((0, 1), repeat=3):
+            if forbidden[0] ^ forbidden[1] ^ forbidden[2] == rhs:
+                continue
+            # Literal [x, forbidden_bit] is false exactly on the forbidden bit.
+            ordinary = [[support[t], forbidden[t]] for t in range(3)]
+            aux = next_var
+            next_var += 1
+            c1 = [ordinary[0], ordinary[1], [aux, 0]]
+            c2 = [[aux, 1], ordinary[2], [fixed, 0]]
+            choices = []
+            for bit in (0, 1):
+                trial = dict(full_assignment)
+                trial[aux] = bit
+                vals1 = [trial[v] ^ neg for v, neg in c1]
+                vals2 = [trial[v] ^ neg for v, neg in c2]
+                if _nae(vals1) and _nae(vals2):
+                    choices.append(bit)
+            if not choices:
+                raise AssertionError("3-CNF to NAE encoding lost a satisfying clause")
+            full_assignment[aux] = choices[0]
+            clauses.extend((c1, c2))
+    return clauses, fixed, full_assignment, xor_rows, next_var
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate a parity witness and carry it through Section 3.
+
+    The answer is sampled first.  No search or solver is called during
+    generation.  ``n`` is the number of base variables and therefore the
+    logarithm of the structure-aware candidate space.
+    """
+    presentation_rounds = params.pop("presentation_rounds", 2)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_params(n, presentation_rounds)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    base_values = [rng.randrange(2) for _ in range(n)]
+    clauses, fixed, full_assignment, _, variable_count = _xor_to_nae(base_values)
+
+    # Relabel every NAE variable, not just the base variables.  Repeating the
+    # independent presentation shuffle makes no semantic change but ensures the
+    # presentation_rounds dial is real and deterministic.
+    old_to_new = list(range(variable_count))
+    for _ in range(presentation_rounds):
+        rng.shuffle(old_to_new)
+    presented = []
+    for clause in clauses:
+        rotated = list(clause)
+        shift = rng.randrange(3)
+        rotated = rotated[shift:] + rotated[:shift]
+        presented.append([[old_to_new[v], neg] for v, neg in rotated])
+    rng.shuffle(presented)
+
+    base_map = {old_to_new[i]: base_values[i] for i in range(n)}
+    base_variables = sorted(base_map)
+    answer = "".join(str(base_map[v]) for v in base_variables)
+    fixed_presented = old_to_new[fixed]
+    clause_count = len(presented)
+    matrix_dimension = 2 * variable_count + 3 * clause_count
+    epsilon = Fraction(1, 100 * matrix_dimension * matrix_dimension)
+    threshold = Fraction(3, 2) - epsilon / 8
+
+    inst = {
+        "family": "paper Section 3 signed-matrix reduction",
+        "n": n,
+        "presentation_rounds": presentation_rounds,
+        "variable_count": variable_count,
+        "fixed_zero": fixed_presented,
+        "base_variables": base_variables,
+        "clauses": presented,
+        "matrix_dimension": matrix_dimension,
+        "threshold": [threshold.numerator, threshold.denominator],
+        "answer": answer,
+    }
+    return inst
+
+
+def _literal_text(literal):
+    var, neg = literal
+    return ("-" if neg else "+") + f"y{var}"
+
+
+def render(inst) -> str:
+    """Render the complete implicit sparse matrix problem and output format."""
+    vcount = inst["variable_count"]
+    clauses = inst["clauses"]
+    q = inst["matrix_dimension"]
+    kn, kd = inst["threshold"]
+    base = ", ".join(f"y{x}" for x in inst["base_variables"])
+    clause_lines = []
+    for ci, clause in enumerate(clauses):
+        clause_lines.append(
+            f"  c{ci}: (" + ", ".join(_literal_text(x) for x in clause) + ")"
+        )
+
+    statement = f"""Certified rank-one approximation of a sparse signed matrix
+
+For a bit y in {{0,1}}, the positive literal +y has value y and the negative
+literal -y has value 1-y.  A triple is NAE (not-all-equal) when its three
+literal values contain at least one 0 and at least one 1.  Variable
+y{inst['fixed_zero']} is fixed to 0.
+
+There are {vcount} Boolean variables y0,...,y{vcount - 1}.  Submit values only
+for the following {inst['n']} base variables, in exactly this displayed order:
+  {base}
+Every other non-fixed variable is an auxiliary.  Each auxiliary occurs in one
+pair of clauses and may be chosen locally after the base bits are fixed.
+
+The {len(clauses)} NAE clauses are:
+{chr(10).join(clause_lines)}
+
+These clauses define an exact q-by-q integer matrix M, q={q}, as follows.  This
+is a sparse inline definition; every entry not assigned below is 0.
+
+* For Boolean variable ya, define vertices P(a)=2a and N(a)=2a+1.
+* For clause ct and position h in {{0,1,2}}, define O(t,h)=2*{vcount}+3t+h.
+* M[i,i]=2 for every i from 0 through {q - 1}.
+* For every a, M[P(a),N(a)]=M[N(a),P(a)]=-1.
+* If position h of clause t is +ya, set both entries between O(t,h) and N(a)
+  to -1.  If it is -ya, set both entries between O(t,h) and P(a) to -1.
+* For each t, use directed edges O(t,0)->O(t,1), O(t,1)->O(t,2), and
+  O(t,2)->O(t,0).  For every directed edge r->s, set M[r,s]=-1 and M[s,r]=1.
+
+No pair receives two conflicting rules.  The threshold is the exact rational
+k={kn}/{kd}.  Your base bits must extend to all auxiliaries so that every NAE
+clause holds.  The checker then applies the above matrix construction, reverses
+each directed edge whose endpoint bits differ, topologically orders the result,
+constructs explicit rational vectors u,v, and checks exactly that
+max(i,j) |M[i,j]-u[i]*v[j]| <= k.  Thus the submitted bits are a compressed,
+executable certificate for a rank-one approximation; no floating point is used.
+
+The answer is one string of exactly {inst['n']} characters from {{0,1}}.  Bit
+position 0 is the value of the first displayed base variable, and so on.
+Order matters and there are no separators.
+
+Give your final answer inside <answer></answer> tags, as that binary string.
+Example format only: <answer>{'01' * (inst['n'] // 2) + ('0' if inst['n'] % 2 else '')}</answer>
+Output nothing else inside the tags."""
+
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Extract one tagged binary string; return None on all malformed input."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\s*>(.*?)</answer\s*>", text,
+                         flags=re.IGNORECASE | re.DOTALL)
+    if len(matches) != 1:
+        return None
+    body = matches[0].strip()
+    body = re.sub(r"^```(?:text)?\s*", "", body, flags=re.IGNORECASE)
+    body = re.sub(r"\s*```$", "", body).strip()
+    if len(body) >= 2 and body[0] == body[-1] == '"':
+        try:
+            body = json.loads(body)
+        except (TypeError, ValueError):
+            return None
+    if not isinstance(body, str) or not re.fullmatch(r"[01]+", body):
+        return None
+    return body
+
+
+_DECODE_CACHE = {}
+
+
+def _decode_xor_uncached(inst):
+    """Decode parity rows using only the displayed NAE clauses."""
+    base_set = set(inst["base_variables"])
+    fixed = inst["fixed_zero"]
+    clauses = inst["clauses"]
+    by_var = defaultdict(list)
+    for ci, clause in enumerate(clauses):
+        for var, neg in clause:
+            by_var[var].append(ci)
+    aux_vars = set(range(inst["variable_count"])) - base_set - {fixed}
+    ordinary = []
+    for aux in aux_vars:
+        incident = by_var[aux]
+        if len(incident) != 2:
+            raise ValueError("an auxiliary does not occur in exactly two clauses")
+        pair = [clauses[i] for i in incident]
+        first = next((c for c in pair if all(v != fixed for v, _ in c)), None)
+        second = next((c for c in pair if any(v == fixed for v, _ in c)), None)
+        if first is None or second is None:
+            raise ValueError("could not pair the auxiliary clauses")
+        first_base = [(v, neg) for v, neg in first if v in base_set]
+        second_base = [(v, neg) for v, neg in second if v in base_set]
+        aux_first = [(v, neg) for v, neg in first if v == aux]
+        aux_second = [(v, neg) for v, neg in second if v == aux]
+        if (len(first_base), len(second_base), aux_first, aux_second) != (
+                2, 1, [(aux, 0)], [(aux, 1)]):
+            raise ValueError("auxiliary pair is not the declared encoding")
+        ordinary.append(first_base + second_base)
+
+    groups = defaultdict(list)
+    for clause in ordinary:
+        support = tuple(sorted(v for v, _ in clause))
+        if len(set(support)) != 3:
+            raise ValueError("an encoded parity support is not three distinct variables")
+        pattern = tuple(next(neg for v, neg in clause if v == x) for x in support)
+        groups[support].append(pattern)
+
+    rows = []
+    for support, patterns in groups.items():
+        if len(patterns) != 4 or len(set(patterns)) != 4:
+            raise ValueError("a parity support does not contain four CNF clauses")
+        parities = {a ^ b ^ c for a, b, c in patterns}
+        if len(parities) != 1:
+            raise ValueError("forbidden patterns do not have one parity")
+        rhs = 1 ^ next(iter(parities))
+        rows.append((support, rhs))
+    if len(rows) != inst["n"]:
+        raise ValueError("decoded parity row count is wrong")
+    rows.sort()
+    return tuple(rows)
+
+
+def _decode_xor(inst):
+    key = id(inst)
+    cached = _DECODE_CACHE.get(key)
+    marker = id(inst["clauses"])
+    if cached is not None and cached[0] == marker:
+        return cached[1]
+    rows = _decode_xor_uncached(inst)
+    if len(_DECODE_CACHE) > 128:
+        _DECODE_CACHE.clear()
+    _DECODE_CACHE[key] = (marker, rows)
+    return rows
+
+
+def _base_assignment(inst, answer):
+    return {var: int(answer[i]) for i, var in enumerate(inst["base_variables"])}
+
+
+def _base_satisfies_xor(inst, assignment):
+    for support, rhs in _decode_xor(inst):
+        if assignment[support[0]] ^ assignment[support[1]] ^ assignment[support[2]] != rhs:
+            return False
+    return True
+
+
+def _extend_assignment(inst, base_assignment):
+    """Choose each degree-two auxiliary locally; no global search is used."""
+    assignment = dict(base_assignment)
+    assignment[inst["fixed_zero"]] = 0
+    base_set = set(inst["base_variables"])
+    fixed = inst["fixed_zero"]
+    by_aux = defaultdict(list)
+    for clause in inst["clauses"]:
+        for var, _ in clause:
+            if var not in base_set and var != fixed:
+                by_aux[var].append(clause)
+    for aux in sorted(by_aux):
+        choices = []
+        for bit in (0, 1):
+            assignment[aux] = bit
+            if all(_nae([assignment[v] ^ neg for v, neg in clause])
+                   for clause in by_aux[aux]):
+                choices.append(bit)
+        if not choices:
+            return None
+        assignment[aux] = choices[0]
+    for clause in inst["clauses"]:
+        if not _nae([assignment[v] ^ neg for v, neg in clause]):
+            return None
+    return assignment
+
+
+def _graph_certificate(inst, assignment):
+    """Return switching signs, reverse-topological positions, D pairs, edges."""
+    vcount = inst["variable_count"]
+    clauses = inst["clauses"]
+    q = inst["matrix_dimension"]
+    colors = [0] * q
+    d_pairs = []
+    edges = []
+
+    for var in range(vcount):
+        p, n = 2 * var, 2 * var + 1
+        colors[p] = assignment[var]
+        colors[n] = 1 - assignment[var]
+        d_pairs.append((p, n))
+    offset = 2 * vcount
+    for ci, clause in enumerate(clauses):
+        occ = [offset + 3 * ci + h for h in range(3)]
+        for h, (var, neg) in enumerate(clause):
+            literal_value = assignment[var] ^ neg
+            colors[occ[h]] = literal_value
+            opposite_vertex = 2 * var + (1 if neg == 0 else 0)
+            d_pairs.append((occ[h], opposite_vertex))
+        edges.extend(((occ[0], occ[1]), (occ[1], occ[2]), (occ[2], occ[0])))
+
+    switched = []
+    for a, b in edges:
+        switched.append((b, a) if colors[a] != colors[b] else (a, b))
+    outgoing = [[] for _ in range(q)]
+    indegree = [0] * q
+    for a, b in switched:
+        outgoing[a].append(b)
+        indegree[b] += 1
+    ready = [i for i in range(q) if indegree[i] == 0]
+    ready.sort(reverse=True)
+    topological = []
+    while ready:
+        a = ready.pop()
+        topological.append(a)
+        for b in outgoing[a]:
+            indegree[b] -= 1
+            if indegree[b] == 0:
+                ready.append(b)
+                ready.sort(reverse=True)
+    if len(topological) != q:
+        return None
+    # Paper Observation 1 uses a>b along an edge; reverse source-first order.
+    position = [0] * q
+    for rank, vertex in enumerate(topological):
+        position[vertex] = q - 1 - rank
+    signs = [1 if color == 0 else -1 for color in colors]
+    return signs, position, d_pairs, edges
+
+
+def _factor_vectors(inst, signs, position):
+    q = inst["matrix_dimension"]
+    epsilon = Fraction(1, 100 * q * q)
+    u, v = [], []
+    for i in range(q):
+        t = position[i]
+        positive_u = 1 - t * epsilon
+        positive_v = Fraction(1, 2) + Fraction(t, 2) * epsilon + epsilon / 4
+        u.append(signs[i] * positive_u)
+        v.append(signs[i] * positive_v)
+    return u, v
+
+
+def _matrix_certificate_ok(inst, assignment):
+    graph = _graph_certificate(inst, assignment)
+    if graph is None:
+        return False, "switched directed graph contains a cycle"
+    signs, position, d_pairs, edges = graph
+    u, v = _factor_vectors(inst, signs, position)
+    k = Fraction(*inst["threshold"])
+    q = inst["matrix_dimension"]
+
+    for i in range(q):
+        if abs(Fraction(2) - u[i] * v[i]) > k:
+            return False, f"diagonal matrix entry {i} exceeds the error bound"
+    for a, b in d_pairs:
+        if abs(Fraction(-1) - u[a] * v[b]) > k:
+            return False, "a symmetric -1 entry exceeds the error bound"
+        if abs(Fraction(-1) - u[b] * v[a]) > k:
+            return False, "the reverse symmetric -1 entry exceeds the error bound"
+    for a, b in edges:
+        if abs(Fraction(-1) - u[a] * v[b]) > k:
+            return False, "a directed -1 entry exceeds the error bound"
+        if abs(Fraction(1) - u[b] * v[a]) > k:
+            return False, "a directed +1 entry exceeds the error bound"
+
+    # Every remaining entry is exactly zero.  This exact product bound checks
+    # all of them at once and is stronger than enumerating q^2 sparse zeros.
+    if max(abs(x) for x in u) * max(abs(x) for x in v) > k:
+        return False, "an unlisted zero entry could exceed the error bound"
+    return True, "ok"
+
+
+def verify(inst, answer):
+    """Verify any submitted base assignment; never consult inst['answer']."""
+    if not isinstance(answer, str):
+        return False, "answer must be a binary string"
+    if answer == "":
+        return False, "answer string is empty"
+    n = inst["n"]
+    if len(answer) < n:
+        return False, f"bit string is too short: expected {n}, got {len(answer)}"
+    if len(answer) > n:
+        return False, f"bit string is too long: expected {n}, got {len(answer)}"
+    if not re.fullmatch(r"[01]+", answer):
+        return False, "answer contains a character outside {0,1}"
+    assignment = _base_assignment(inst, answer)
+    try:
+        if not _base_satisfies_xor(inst, assignment):
+            return False, "base assignment violates a decoded parity equation"
+    except (KeyError, ValueError) as exc:
+        return False, "malformed instance encoding: " + str(exc)
+    extended = _extend_assignment(inst, assignment)
+    if extended is None:
+        return False, "base assignment has no local NAE auxiliary extension"
+    return _matrix_certificate_ok(inst, extended)
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the exact n-bit, fixed-reference language."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    return format(rng.getrandbits(inst["n"]), f"0{inst['n']}b")
+
+
+def search_space(inst):
+    return 1 << inst["n"]
+
+
+def enumerate_all(inst):
+    n = inst["n"]
+    if n > 16:
+        return None
+    count = 0
+    for value in range(1 << n):
+        candidate = format(value, f"0{n}b")
+        count += int(verify(inst, candidate)[0])
+    return count
+
+
+def _canonical_cycle_bits(inst):
+    rows = _decode_xor(inst)
+    pair_count = Counter()
+    rhs_by_support = {}
+    for support, rhs in rows:
+        rhs_by_support[frozenset(support)] = rhs
+        for pair in itertools.combinations(support, 2):
+            pair_count[tuple(sorted(pair))] += 1
+    adjacency = defaultdict(list)
+    for (a, b), count in pair_count.items():
+        if count == 2:
+            adjacency[a].append(b)
+            adjacency[b].append(a)
+    vertices = sorted(inst["base_variables"])
+    if any(len(adjacency[v]) != 2 for v in vertices):
+        raise ValueError("decoded supports do not form one cycle")
+    candidates = []
+    for start in vertices:
+        for second in adjacency[start]:
+            seq = [start, second]
+            while len(seq) < len(vertices):
+                prev, cur = seq[-2], seq[-1]
+                nxt = adjacency[cur][0] if adjacency[cur][0] != prev else adjacency[cur][1]
+                if nxt == start:
+                    break
+                seq.append(nxt)
+            if len(seq) != len(vertices):
+                continue
+            bits = []
+            for i in range(len(seq)):
+                support = frozenset((seq[i], seq[(i + 1) % len(seq)],
+                                     seq[(i + 2) % len(seq)]))
+                bits.append(str(rhs_by_support[support]))
+            candidates.append("".join(bits))
+    if not candidates:
+        raise ValueError("could not canonically traverse support cycle")
+    return min(candidates)
+
+
+def canonical_key(inst):
+    payload = {
+        "family": "cyclic-xor-to-nae-to-M",
+        "n": inst["n"],
+        "cycle_rhs": _canonical_cycle_bits(inst),
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(raw.encode("utf-8")).hexdigest()
