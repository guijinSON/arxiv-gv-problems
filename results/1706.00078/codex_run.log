+        "demo_candidate_space": search_space(demo),
+        "baseline_wall_clock_sec_mean": mean_seconds,
+        "baseline_row_xors_mean": mean_row_xors,
+        "baseline_scalar_bit_operations_mean": mean_scalar,
+    }
