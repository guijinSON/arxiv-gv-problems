def parse_answer(text):
    """Extract one tagged binary string; return None on all malformed input."""
    if not isinstance(text, str):
        return None
    matches = re.findall(r"<answer\s*>(.*?)</answer\s*>", text,
                         flags=re.IGNORECASE | re.DOTALL)
    if len(matches) != 1:
        return None
    body = matches[0].strip()
    body = re.sub(r"^```(?:text)?\s*", "", body, flags=re.IGNORECASE)
    body = re.sub(r"\s*```$", "", body).strip()
    if len(body) >= 2 and body[0] == body[-1] == '"':
        try:
            body = json.loads(body)
        except (TypeError, ValueError):
            return None
    if not isinstance(body, str) or not re.fullmatch(r"[01]+", body):
        return None
    return body


_DECODE_CACHE = {}


def _decode_xor_uncached(inst):
    """Decode parity rows using only the displayed NAE clauses."""
    base_set = set(inst["base_variables"])
    fixed = inst["fixed_zero"]
    clauses = inst["clauses"]
    by_var = defaultdict(list)
    for ci, clause in enumerate(clauses):
        for var, neg in clause:
            by_var[var].append(ci)
    aux_vars = set(range(inst["variable_count"])) - base_set - {fixed}
    ordinary = []
    for aux in aux_vars:
        incident = by_var[aux]
        if len(incident) != 2:
            raise ValueError("an auxiliary does not occur in exactly two clauses")
        pair = [clauses[i] for i in incident]
        first = next((c for c in pair if all(v != fixed for v, _ in c)), None)
        second = next((c for c in pair if any(v == fixed for v, _ in c)), None)
        if first is None or second is None:
            raise ValueError("could not pair the auxiliary clauses")
        first_base = [(v, neg) for v, neg in first if v in base_set]
        second_base = [(v, neg) for v, neg in second if v in base_set]
        aux_first = [(v, neg) for v, neg in first if v == aux]
        aux_second = [(v, neg) for v, neg in second if v == aux]
        if (len(first_base) != 2 or len(second_base) != 1
                or len(aux_first) != 1 or len(aux_second) != 1
                or aux_first[0][1] == aux_second[0][1]):
            raise ValueError("auxiliary pair is not the declared encoding")
        ordinary.append(first_base + second_base)

    groups = defaultdict(list)
    for clause in ordinary:
        support = tuple(sorted(v for v, _ in clause))
        if len(set(support)) != 3:
            raise ValueError("an encoded parity support is not three distinct variables")
        pattern = tuple(next(neg for v, neg in clause if v == x) for x in support)
        groups[support].append(pattern)

    rows = []
    for support, patterns in groups.items():
        if len(patterns) != 4 or len(set(patterns)) != 4:
            raise ValueError("a parity support does not contain four CNF clauses")
        parities = {a ^ b ^ c for a, b, c in patterns}
        if len(parities) != 1:
            raise ValueError("forbidden patterns do not have one parity")
        rhs = 1 ^ next(iter(parities))
        rows.append((support, rhs))
    if len(rows) != inst["xor_row_count"]:
        raise ValueError("decoded parity row count is wrong")
    rows.sort()
    return tuple(rows)


def _decode_xor(inst):
    key = id(inst)
    cached = _DECODE_CACHE.get(key)
    marker = id(inst["clauses"])
    if cached is not None and cached[0] == marker:
        return cached[1]
    rows = _decode_xor_uncached(inst)
    if len(_DECODE_CACHE) > 128:
        _DECODE_CACHE.clear()
    _DECODE_CACHE[key] = (marker, rows)
    return rows


def _base_assignment(inst, answer):
    return {var: int(answer[i]) for i, var in enumerate(inst["base_variables"])}


def _base_satisfies_xor(inst, assignment):
    for support, rhs in _decode_xor(inst):
        if assignment[support[0]] ^ assignment[support[1]] ^ assignment[support[2]] != rhs:
            return False
    return True


def _extend_assignment(inst, base_assignment):
    """Choose each degree-two auxiliary locally; no global search is used."""
    assignment = dict(base_assignment)
    assignment[inst["fixed_zero"]] = 0
    base_set = set(inst["base_variables"])
    fixed = inst["fixed_zero"]
    by_aux = defaultdict(list)
    for clause in inst["clauses"]:
        for var, _ in clause:
            if var not in base_set and var != fixed:
                by_aux[var].append(clause)
    for aux in sorted(by_aux):
        choices = []
        for bit in (0, 1):
            assignment[aux] = bit
            if all(_nae([assignment[v] ^ neg for v, neg in clause])
                   for clause in by_aux[aux]):
                choices.append(bit)
        if not choices:
            return None
        assignment[aux] = choices[0]
    for clause in inst["clauses"]:
        if not _nae([assignment[v] ^ neg for v, neg in clause]):
            return None
    return assignment


