+def _attack_dpll_unit(inst, node_budget=2048):
+    """Bounded, dependency-free DPLL with native NAE unit propagation."""
+    clauses = inst["clauses"]
+    occurrence = [0] * inst["variable_count"]
+    for clause in clauses:
+        for var, _ in clause:
+            occurrence[var] += 1
