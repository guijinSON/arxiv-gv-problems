+def _make_xor_rows(base_values, rng, decoys):
+    """Make a full-rank cyclic backbone plus seed-dependent parity supports.
+
+    Every added support has three previously unused variable pairs.  Thus the
+    pairs occurring twice are exactly the adjacent pairs of the cyclic
+    backbone.  Added rows are constraints, not fake clauses: their right-hand
+    sides are evaluated on the already sampled witness.  The backbone alone is
+    nonsingular because its length is not divisible by three.
+    """
+    n = len(base_values)
+    supports = [(i, (i + 1) % n, (i + 2) % n) for i in range(n)]
+    used_pairs = {
+        tuple(sorted(pair))
+        for support in supports
+        for pair in itertools.combinations(support, 2)
+    }
+    if decoys == 0:
+        return [
+            (support,
+             base_values[support[0]] ^ base_values[support[1]] ^ base_values[support[2]])
+            for support in supports
+        ]
+    candidates = list(itertools.combinations(range(n), 3))
+    rng.shuffle(candidates)
+    for support in candidates:
+        pairs = {tuple(sorted(pair)) for pair in itertools.combinations(support, 2)}
+        if pairs.isdisjoint(used_pairs):
+            supports.append(support)
+            used_pairs.update(pairs)
+            if len(supports) == n + decoys:
+                break
+    if len(supports) != n + decoys:
+        raise ValueError("too many decoy supports for this n")
+    return [
+        (support,
+         base_values[support[0]] ^ base_values[support[1]] ^ base_values[support[2]])
+        for support in supports
+    ]
 
 
