print('build',time.perf_counter()-t,'q',i['matrix_dimension'],'eq',len(i['equations']),'ternary',i['xor_row_count'],'clauses',len(i['clauses']),'render',len(g.render(i)),'answer',len(i['answer']))
t=time.perf_counter(); print('verify',g.verify(i,i['answer']),'sec',time.perf_counter()-t)
a,s=g._compact_recurrence(i);print('compact',s,g.verify(i,a))
