+    constants[0] = 0
+    current = 0
+    xor_operations = 0
+    for _ in range(n - 1):
+        nxt = (current + 3) % n
+        if constants[nxt] is not None:
+            raise ValueError("step-three recurrence closed before visiting the cycle")
+        constants[nxt] = constants[current] ^ rhs[current] ^ rhs[(current + 1) % n]
+        xor_operations += 2
