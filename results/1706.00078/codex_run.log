+def _validate_params(n, decoys):
+    if isinstance(n, bool) or not isinstance(n, int) or n < 8:
+        raise ValueError("n must be an integer at least 8")
+    if n % 2 or n % 3 == 0:
+        raise ValueError("n must be even and not divisible by 3")
