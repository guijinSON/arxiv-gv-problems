from fractions import Fraction
import random, math

def noise(rng,m,n,cycles,minp):
  unit=max(1,minp//24)
  for tr in range(100):
    E=[[0]*n for _ in range(m)]
    for _ in range(cycles):
      i,k=rng.sample(range(m),2); j,l=rng.sample(range(n),2)
      t=0
      while not t:t=rng.randint(-unit,unit)
      E[i][j]+=t;E[k][l]+=t;E[i][l]-=t;E[k][j]-=t
    q=max(abs(x) for row in E for x in row)
    if minp//8<=q<minp*9//20:return E,q
  return None,None

def make(seed,m=10,n=13,bits=12):
 r=random.Random(seed);lo=1<<(bits-1);hi=(1<<bits)-1
 a=[r.randint(lo,hi) for _ in range(m)];b=[r.randint(lo,hi) for _ in range(n)]
 E,k=noise(r,m,n,4*m*n,min(a)*min(b))
 return [[a[i]*b[j]+E[i][j] for j in range(n)] for i in range(m)],k,a,b

