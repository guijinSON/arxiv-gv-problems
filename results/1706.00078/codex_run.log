   if (wrong[0]''^wrong[1]''^wrong[2])==b:continue
   lits=list(zip(vs,wrong));z=nv;nv+=1
   cla.append((lits[0],lits[1],(z,0)))
   cla.append(((z,1),lits[2],(F,0)))
 perm=list(range(nv));r.shuffle(perm)
 pcl=[tuple((perm[v],s) for v,s in c) for c in cla];r.shuffle(pcl)
