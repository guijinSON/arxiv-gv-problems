+        xor_operations += 1
+    global_xor = values[0]
+    for i in range(1, n):
+        global_xor ^= values[i]
+        xor_operations += 1
+    z_values = [value ^ global_xor for value in values]
+    xor_operations += n
+    by_variable = {seq[i]: z_values[i] for i in range(n)}
+    answer = "".join(str(by_variable[v]) for v in inst["base_variables"])
+    return answer, {"xor_operations": xor_operations}
