codex
The easy DPLL behavior is intrinsic to the sparse recurrence encoding, so adding decoys cannot rescue it. There is still one paper-faithful Track B route worth testing before rejection: apply the involution \(x_i=z_i\oplus\bigoplus_j z_j\), which turns each cyclic 3-XOR into a dense complement-of-three equation. The compact inverse stays under 300 XORs, while ordinary NAE unit propagation should lose its short path. I’m prototyping that attack gap before committing to a rewrite.
exec
/bin/bash -lc "python3 -u - <<'PY'
import gen_1706_00078 as g, random, time

def trial(n,seed):
 rng=random.Random(seed); z=[rng.randrange(2) for _ in range(n)]
 dense=[]
 for i in range(n):
  miss={i,(i+1)%n,(i+2)%n}; support=[j for j in range(n) if j not in miss]
  dense.append((support, sum(z[j] for j in support)%2))
 vals=list(z); triples=[]
 for support,rhs in dense:
  if len(support)==3: triples.append((tuple(support),rhs)); continue
  prev=len(vals); vals.append(z[support[0]]"'^z[support[1]])
  triples.append(((support[0],support[1],prev),0))
  for k in range(2,len(support)-2):
   nxt=len(vals); vals.append(vals[prev]''^z[support[k]])
   triples.append(((prev,support[k],nxt),0)); prev=nxt
  triples.append(((prev,support[-2],support[-1]),rhs))
 clauses,fixed,full,vc=g._xor_to_nae(vals,triples)
 fake={'"'clauses':clauses,'variable_count':vc,'fixed_zero':fixed,'base_variables':list(range(n)),'n':n}
 t=time.perf_counter(); a,st=g._attack_dpll_unit(fake,node_budget=2048)
 return st,round(time.perf_counter()-t,3)
for n in (14,20,26,32,38):
 if n%2 or n%3==0: continue
 out=[]
 for s in range(8): out.append(trial(n,100+s))
 print(n,out,flush=True)
