        omitted = sorted(set(range(inst["n"])) - set(equation["vars"]))
        missing_text = ", ".join(f"y{x}" for x in omitted)
        equation_lines.append(
            f"  e{ei}: omit {{{missing_text}}}; XOR of all other base bits = "
            f"{equation['rhs']}"
