def _relabel_instance(inst, rng, reorder_base=False, flip_polarities=False):
    vcount = inst["variable_count"]
    perm = list(range(vcount))
    rng.shuffle(perm)
    flips = [rng.randrange(2) if flip_polarities else 0 for _ in range(vcount)]
    flips[inst["fixed_zero"]] = 0
    clauses = []
    order = list(range(len(inst["clauses"])))
    rng.shuffle(order)
    for old_ci in order:
        clause = inst["clauses"][old_ci]
        shift = rng.randrange(3)
        clause = clause[shift:] + clause[:shift]
        clauses.append([[perm[v], neg ^ flips[v]] for v, neg in clause])
    old_bits = {v: inst["answer"][i] for i, v in enumerate(inst["base_variables"])}
    base_variables = [perm[v] for v in inst["base_variables"]]
    if reorder_base:
        rng.shuffle(base_variables)
    else:
        base_variables.sort()
    old_for_new = {perm[old]: old for old in range(vcount)}
    carried = "".join(
        str(int(old_bits[old_for_new[v]]) ^ flips[old_for_new[v]])
        for v in base_variables
    )
    out = {
        "family": inst["family"],
        "n": inst["n"],
        "decoys": inst["decoys"],
        "xor_row_count": inst["xor_row_count"],
        "variable_count": vcount,
        "fixed_zero": perm[inst["fixed_zero"]],
        "base_variables": base_variables,
        "clauses": clauses,
        "matrix_dimension": inst["matrix_dimension"],
        "threshold": list(inst["threshold"]),
        "answer": carried,
    }
    return out


def _answer_metrics(answer):
    encoded = json.dumps(answer, separators=(",", ":"))
    return len(encoded), math.ceil(len(encoded) / 4), len(answer)


