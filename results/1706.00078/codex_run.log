# A clause is a list of three [variable, negated] pairs.  A literal has value
# assignment[variable] XOR negated, so [v, 0] is y_v and [v, 1] is not y_v.


def _nae(values):
    return not (values[0] == values[1] == values[2])


def _validate_params(n, presentation_rounds):
    if isinstance(n, bool) or not isinstance(n, int) or n < 5:
        raise ValueError("n must be an integer at least 5")
    if n % 3 == 0:
        raise ValueError("n must not be divisible by 3")
    if isinstance(presentation_rounds, bool) or not isinstance(presentation_rounds, int):
        raise ValueError("presentation_rounds must be an integer")
    if not 1 <= presentation_rounds <= 20:
        raise ValueError("presentation_rounds must be between 1 and 20")


def _xor_to_nae(base_values):
    """Return unpermuted clauses, F id, auxiliary values, and xor rows.

    A parity equation is four ordinary 3-CNF clauses.  Each ordinary clause
    (a or b or c), interpreted relative to F=0, becomes
        NAE(a,b,z) and NAE(not z,c,F).
    The equivalence is checked exhaustively in selftest.
    """
    n = len(base_values)
    fixed = n
    next_var = n + 1
    clauses = []
    full_assignment = {i: int(base_values[i]) for i in range(n)}
    full_assignment[fixed] = 0
    xor_rows = []

    for i in range(n):
        support = (i, (i + 1) % n, (i + 2) % n)
        rhs = base_values[support[0]] ^ base_values[support[1]] ^ base_values[support[2]]
        xor_rows.append((support, rhs))
        for forbidden in itertools.product((0, 1), repeat=3):
            if forbidden[0] ^ forbidden[1] ^ forbidden[2] == rhs:
                continue
            # Literal [x, forbidden_bit] is false exactly on the forbidden bit.
            ordinary = [[support[t], forbidden[t]] for t in range(3)]
            aux = next_var
            next_var += 1
            c1 = [ordinary[0], ordinary[1], [aux, 0]]
            c2 = [[aux, 1], ordinary[2], [fixed, 0]]
            choices = []
            for bit in (0, 1):
                trial = dict(full_assignment)
                trial[aux] = bit
                vals1 = [trial[v] ^ neg for v, neg in c1]
                vals2 = [trial[v] ^ neg for v, neg in c2]
                if _nae(vals1) and _nae(vals2):
                    choices.append(bit)
            if not choices:
                raise AssertionError("3-CNF to NAE encoding lost a satisfying clause")
            full_assignment[aux] = choices[0]
            clauses.extend((c1, c2))
    return clauses, fixed, full_assignment, xor_rows, next_var


def make_instance(n, seed=0, **params) -> dict:
    """Inverse-generate a parity witness and carry it through Section 3.

    The answer is sampled first.  No search or solver is called during
    generation.  ``n`` is the number of base variables and therefore the
    logarithm of the structure-aware candidate space.
    """
    presentation_rounds = params.pop("presentation_rounds", 2)
    if params:
        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
    _validate_params(n, presentation_rounds)
    if isinstance(seed, bool) or not isinstance(seed, int):
        raise ValueError("seed must be an integer")

    rng = random.Random(seed)
    base_values = [rng.randrange(2) for _ in range(n)]
    clauses, fixed, full_assignment, _, variable_count = _xor_to_nae(base_values)

    # Relabel every NAE variable, not just the base variables.  Repeating the
    # independent presentation shuffle makes no semantic change but ensures the
    # presentation_rounds dial is real and deterministic.
    old_to_new = list(range(variable_count))
    for _ in range(presentation_rounds):
        rng.shuffle(old_to_new)
    presented = []
    for clause in clauses:
        rotated = list(clause)
        shift = rng.randrange(3)
        rotated = rotated[shift:] + rotated[:shift]
        presented.append([[old_to_new[v], neg] for v, neg in rotated])
    rng.shuffle(presented)

    base_map = {old_to_new[i]: base_values[i] for i in range(n)}
    base_variables = sorted(base_map)
    answer = "".join(str(base_map[v]) for v in base_variables)
    fixed_presented = old_to_new[fixed]
    clause_count = len(presented)
    matrix_dimension = 2 * variable_count + 3 * clause_count
    epsilon = Fraction(1, 100 * matrix_dimension * matrix_dimension)
    threshold = Fraction(3, 2) - epsilon / 8

    inst = {
        "family": "paper Section 3 signed-matrix reduction",
        "n": n,
        "presentation_rounds": presentation_rounds,
        "variable_count": variable_count,
        "fixed_zero": fixed_presented,
        "base_variables": base_variables,
        "clauses": presented,
        "matrix_dimension": matrix_dimension,
        "threshold": [threshold.numerator, threshold.denominator],
        "answer": answer,
# Low-rank infinity-norm approximation generator

This is a **Track B** generator based on Gillis and Shitov, [*Low-Rank Matrix Approximation in the Infinity Norm*](https://arxiv.org/abs/1706.00078). It is a paper-licensed reduction family: the solver reasons about a NAE-3SAT encoding that defines the paper's sparse signed matrix, while the checker constructs and verifies rational rank-one factors. It should be counted as logic/reduction coverage, not as an unqualified native numerical-optimization family.

| profile field | value |
|---|---|
| native domain | `logic` |
| object regime | `rational_exact` |
| computational core | `csp_sat` |
| certificate form | `exact_symbolic` binary string |
| intuition | reduction recognition |
| domain essentiality | `licensed_reduction` |
| reduction | Section 3, Lemma 1 and Theorem 2 |

## What the problem is

The solver receives a shuffled NAE-3SAT formula and an exact sparse definition of the matrix \(M(G,D)\) used in Section 3. It must give the bits of designated base variables. The checker extends the degree-two auxiliaries locally, applies the paper's edge-switching construction, topologically sorts the switched graph, constructs explicit rational vectors \(u,v\), and checks \(\max_{ij}|M_{ij}-u_i v_j|\le k\) with `Fraction` arithmetic. The submitted bit string is therefore a finite executable witness, not a claim that the checker accepts by appealing to the theorem.

Generation is inverse. It samples the base bit vector first, forms the cyclic system

```text
x[i] XOR x[i+1] XOR x[i+2] = b[i]       (indices modulo n),
```

compiles each parity equation to four 3-CNF clauses, each 3-CNF clause to two NAE clauses, and finally applies the paper's matrix reduction. Since `n` is never divisible by 3, the cyclic system is nonsingular over GF(2), so the planted base assignment is unique.

## Why Track B

The paper's Theorem 3 proves NP-completeness of rank-one infinity-norm approximation, using Theorem 2's signed-matrix reduction. Its hard construction has only the diagonal entries above the threshold, so the threshold graph has the maximum number of components—the opposite of Theorem 1's polynomial `d=O(log n)` regime. Lemma 1 and Corollary 1 also show why the initially suggested nonnegative/quantized rank-one planting is unsuitable: known signs reduce the task to polynomial linear feasibility, and nonnegative matrices are polynomial-time.

This generated distribution is **not** claimed structurally hard. An efficient algorithm exists: pair the degree-two NAE auxiliaries, recover four forbidden assignments on every three-variable support, decode the GF(2) equations, and run Gaussian elimination. At shipping size, exact bit-packed RREF solved 8/8 instances in 0.00636 seconds mean time, using 305 mean row XORs = 14,664 mean scalar bit operations (maximum 18,336). The compact route recognizes that supports form one cycle and evaluates a second-order recurrence; its measured operation budget is 286 XORs. The benchmark is the gap between discovering that representation and mechanically eliminating the displayed encoding.

## Worked `demo` example

For `make_instance(n=5, seed=0, presentation_rounds=1)`, `render` returns:

