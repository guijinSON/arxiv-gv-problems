  assert g.verify(i,i['answer'])==(True,'ok')
  assert json.loads(json.dumps(i['answer']))==i['answer']
  checks+=1
logical=0
for vals in itertools.product((0,1),repeat=4):
 target=len(set(vals))>1
 reduced=any(g._nae((vals[0],vals[1],z)) and g._nae((1-z,vals[2],vals[3])) for z in (0,1))
 assert target==reduced; logical+=1
print({'G1_checks':checks,'logical_checks':logical,'pass':True})
