+    def propagate(values):
+        changed = True
+        while changed:
+            changed = False
+            for clause in clauses:
+                known = []
+                missing = []
+                for var, neg in clause:
+                    if values[var] < 0:
+                        missing.append((var, neg))
+                    else:
+                        known.append(values[var] ^ neg)
+                if not missing:
+                    if known[0] == known[1] == known[2]:
+                        return False
+                elif len(missing) == 1 and len(known) == 2 and known[0] == known[1]:
+                    var, neg = missing[0]
