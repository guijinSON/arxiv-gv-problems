+        for row in out["rows"]:
+            row["left"] = mapping[row["left"]]
+        out["left_vertices"] = sorted(mapping.values())
+        out["I"] = sorted(mapping[x] for x in out["I"])
+        out["minimum_vertex_cover"]["S_X"] = sorted(
+            mapping[x] for x in out["minimum_vertex_cover"]["S_X"]
+        )
