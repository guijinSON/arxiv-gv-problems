+    "easy": {"n": 61, "degree": 8},
+    "medium": {"n": 89, "degree": 10},
+    "hard": {"n": 127, "degree": 12},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
