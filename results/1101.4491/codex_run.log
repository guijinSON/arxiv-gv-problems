params=g.DIFFICULTY['hard']

def random_greedy(inst,rng,reorder_rows=False):
    idx=list(range(inst['n']))
    if reorder_rows:
        rng.shuffle(idx)
    used=set(); ans=[None]*inst['n']
    for i in idx:
        opts=[y for y in inst['rows'][i]['neighbors'] if y not in used]
