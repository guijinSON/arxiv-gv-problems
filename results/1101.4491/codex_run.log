+def escalate(params):
+    """First add same-marginal decoys at fixed answer length, then grow n."""
+    n = int(params["n"])
+    degree = int(params.get("degree", 8))
+    if degree < 20:
+        return {"n": n, "degree": min(20, degree + 2)}
+    if n + 22 <= 237:
+        return {"n": n + 22, "degree": degree}
+    return "cap_bound"
