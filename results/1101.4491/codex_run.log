+                depth > 0 and augment(displaced, seen, depth - 1)
+            ):
+                mate[value] = position
+                answer[position] = value
+                return True
+        return False
+
+    for position in order:
+        if not augment(position, set(), max_depth):
+            return None, scans
+    return answer, scans
