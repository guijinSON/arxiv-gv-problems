+        for row in out["rows"]:
+            row["neighbors"] = [mapping[y] for y in row["neighbors"]]
+        out["right_vertices"] = sorted(mapping.values())
+        out["minimum_vertex_cover"]["S_Y"] = sorted(
+            mapping[y] for y in out["minimum_vertex_cover"]["S_Y"]
+        )
