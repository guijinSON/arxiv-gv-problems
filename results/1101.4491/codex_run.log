+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 1_000_000:
+        return None
+    count = 0
+    for candidate in itertools.permutations(inst["right_vertices"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
