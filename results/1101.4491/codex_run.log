+def _randomized_greedy_candidate(inst, rng):
+    """Try a random row order, always respecting edges and distinctness."""
+    order = list(range(inst["n"]))
+    rng.shuffle(order)
+    used = set()
+    answer = [None] * inst["n"]
+    for position in order:
+        choices = [
+            value
