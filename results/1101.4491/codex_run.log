+    answer = []
+    for row in inst["rows"]:
+        available = [y for y in sorted(row["neighbors"]) if y not in used]
+        chosen = available[0] if available else min(row["neighbors"])
+        answer.append(chosen)
+        used.add(chosen)
+    return answer
