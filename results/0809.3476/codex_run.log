import ast, importlib.util, itertools, json, pathlib, random
p=pathlib.Path('gen_0809_3476.py')
spec=importlib.util.spec_from_file_location('g',p)
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
# Independent coefficient recurrence from xi=1+sum x_j xi"'^(2j-1), truncated
# For a multiset of distinct types, brute preorder slots over all permutations.
def brute(lengths):
    inc={j:2*(j-1) for j in lengths}
    total=0
    # internal nodes are distinguishable by their unique degrees; count valid
    # prefixes of internal/leaf symbols, final leaf forced.
    R=sum(j-1 for j in lengths)
    leaves=2*R+1
    symbols=list(lengths)+[0]*leaves
    # only tiny cases
    seen=set(itertools.permutations(symbols))
    for w in seen:
        slots=1; ok=True
        for x in w:
            if slots<=0: ok=False; break
            slots-=1
            if x: slots += 2*x-1
        total += ok and slots==0
    return total
for lengths in ([2,3],[2,4],[3,4],[2,3,4]):
    inst={'"'factor_lengths':list(lengths)}
    expected=g._count_from_identity(list(lengths))
    dp,ops=g._reference_prefix_dp(inst)
    print(lengths, expected, dp, 'agree', expected==dp)
# Verify never consults answer.
inst=g.make_instance(seed=9, **g.DIFFICULTY['hard'])
cert=inst['answer']; inst2=dict(inst); inst2['answer']={'product':[2]}
print('verify_independent', g.verify(inst2,cert))
print('roundtrip', g.parse_answer('prose\\n"'```json'"\\n<answer>'+json.dumps(cert)+'</answer>\\n"'```'"'))
print('deterministic', g.make_instance(seed=9, **g.DIFFICULTY['hard'])==inst)
print('hint_default_absent', 'Hint:' not in g.render(inst))
