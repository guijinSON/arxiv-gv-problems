+        "swap_two": {"product": [planted[1], planted[0], *planted[2:]]},
+        "duplicate": {"product": [planted[0], planted[0], *planted[2:]]},
+        "out_of_range": {"product": [*planted[:-1], upper + 1]},
+        "wrong_product": {"product": [*planted[:-1], planted[-1] + 1]},
