import itertools, math

def compose(left,right,n):
    # left after right, mappings 1..n
    return tuple(left[right[i]-1] for i in range(n))
def cyc(s,n):
    p=list(range(1,n+1))
    for a,b in zip(s,s[1:]+s[:1]): p[a-1]=b
    return tuple(p)
def disjoint(a,b): return set(a).isdisjoint(b)
def canon(seq):
    # Lexicographically minimal topological order preserving every noncommuting pair's order.
    # Small brute closure under adjacent disjoint swaps is independent and exact.
    seen={seq}; todo=[seq]
    while todo:
      q=todo.pop()
      for i in range(len(q)-1):
       if disjoint(q[i],q[i+1]):
        z=q[:i]+(q[i+1],q[i])+q[i+2:]
        if z not in seen: seen.add(z);todo.append(z)
    return min(seen)
for lengths in ([2,3],[2,4],[3,4],[2,3,4]):
 n=1+sum(j-1 for j in lengths)
 target=tuple(list(range(2,n+1))+[1])
 pools=[list(itertools.combinations(range(1,n+1),j)) for j in lengths]
 classes=set(); sequences=0
 for facs in itertools.product(*pools):
