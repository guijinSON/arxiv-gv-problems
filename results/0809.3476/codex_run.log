+        "base_n": hard["n"],
+        "doubled_n": doubled_params["n"],
+        "base_space": search_space(base),
+        "doubled_space": search_space(doubled),
+        "base_answer_elements": len(base["answer"]["product"]),
+        "doubled_answer_elements": len(doubled["answer"]["product"]),
