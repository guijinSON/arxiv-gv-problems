+        "greedy_smallest_factors": {"product": list(range(2, k + 2))},
+        "independent_open_slots": {"value": (2 * rank + 1) ** k},
+        "shifted_rising_product": {
+            "product": list(range(2 * rank + 1, 2 * rank + m))
+        },
+    }
