\title{On inequivalent factorizations of a cycle}

\author{G Berkolaiko$^1$, J M Harrison$^{2}$, M Novaes$^3$\\~\\
  %% \address{
  \small $^1$ Department of Mathematics, Texas A\&M University,\\
