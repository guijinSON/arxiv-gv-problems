+        "paper": "0809.3476",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    # G1: construction and JSON nativeness over the whole ladder.
+    g1_checks = 0
+    g1_failures: list[str] = []
