+    inst = make_instance(seed=19, **shipping)
+    answer = inst["answer"]
+    dropped = answer[:-1]
+    swapped = list(answer)
+    swapped[0] = _replacement_vertex(inst)
+    duplicated = list(answer)
+    duplicated[-1] = duplicated[0]
+    corruptions = {
+        "drop": dropped,
+        "swap_one": swapped,
+        "duplicate": duplicated,
