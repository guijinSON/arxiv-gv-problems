+def _reference_residue_scan(inst):
+    """Formula-aware mechanical algorithm; it intentionally scans every vertex."""
+    p = inst["p"]
+    s = inst["s"]
+    a = inst["a"]
+    query = inst["query"]
+    target, operations = _small_power_counted((query - a) % p, s, p)
+    found = []
+    for vertex in range(p):
+        if vertex in (a, query):
