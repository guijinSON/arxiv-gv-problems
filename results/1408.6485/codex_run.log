+def _mod_power_counted(base, exponent, modulus):
+    result = 1
+    base %= modulus
+    operations = 0
+    while exponent:
+        if exponent & 1:
+            result = result * base % modulus
+            operations += 1
+        exponent >>= 1
+        if exponent:
+            base = base * base % modulus
+            operations += 1
+    return result, operations
