+    for base in (2, 325, 9_375, 28_178, 450_775, 9_780_504, 1_795_265_022):
+        if base % value == 0:
+            continue
+        x = pow(base, d, value)
+        if x in (1, value - 1):
+            continue
+        for _ in range(power - 1):
+            x = x * x % value
+            if x == value - 1:
+                break
