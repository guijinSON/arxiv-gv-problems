+    result = 1
+    operations = 0
+    for _ in range(exponent.bit_length() - 1, -1, -1):
+        result = result * result % modulus
+        operations += 1
+        if exponent >> _ & 1:
+            result = result * base % modulus
+            operations += 1
+    return result, operations
