+def _answer_by_composition(p, s, generator, a, query):
+    """Carry the planted fibre through the root-of-unity identity."""
+    zeta = pow(generator, (p - 1) // s, p)
+    delta = (query - a) % p
+    roots = []
+    multiplier = zeta
+    for _ in range(1, s):
