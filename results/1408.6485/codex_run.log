+
+def escalate(params):
+    """Grow the modulus at fixed seven-vertex witness length."""
+    n = params.get("n")
+    s = params.get("s", 8)
+    if isinstance(n, bool) or not isinstance(n, int):
+        return None
+    return {"n": n * 8, "s": s}
