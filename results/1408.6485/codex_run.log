+        "finite-field modular exponentiation",
+        "exact equality of neighborhood fibres",
+        "integer range and distinctness checks",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
