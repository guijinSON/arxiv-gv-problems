+def _format_example(inst):
+    target = _power(inst, inst["query"])
+    values = []
+    for value in range(inst["p"]):
+        if value in (inst["a"], inst["query"]):
+            continue
+        if _power(inst, value) == target:
+            continue
+        values.append(value)
+        if len(values) == inst["s"] - 1:
+            break
+    return values
