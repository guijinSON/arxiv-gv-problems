+def _primitive_root(prime, rng):
+    factors = _prime_factors(prime - 1)
+    while True:
+        candidate = rng.randrange(2, prime)
+        if all(pow(candidate, (prime - 1) // factor, prime) != 1 for factor in factors):
+            return candidate
