   653	        "pairwise_quadratic_cancellation"
   654	    ][0]
   655	    failing_ok = not any(verify(inst, candidate)[0] for candidate in failing_candidates)
   656	    failing_sec = time.perf_counter() - failing_start
   657	    report["G5_density_baseline"] = {
   658	        "pass": demo_count == 1 and ref_ok and failing_ok,
   659	        "shipping_density_hits": guess_hits,
   660	        "shipping_density_total": guess_total,

