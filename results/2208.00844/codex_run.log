+        "shipping_density_total": guess_total,
+        "shipping_density_fraction": guess_fraction,
+        "demo_exact_solution_count": demo_count,
+        "reference_wall_clock_sec": round(ref_sec, 6),
+        "reference_modular_operations": ref_ops,
