   640	        "total": guess_total,
   641	        "fraction": guess_fraction,
   642	        "candidate_space": search_space(inst),
   643	        "wall_clock_sec": round(guess_sec, 6),
   644	    }
   645	    assert report["G4_guess_resistance"]["pass"]
   646	
   647	    demo = make_instance(**DIFFICULTY["demo"])
   648	    demo_count = enumerate_all(demo)
   649	    recovered, ref_ops, ref_sec = _row_elimination_reference(inst)
   650	    ref_ok = recovered is not None and verify(inst, recovered)[0]
   651	    failing_start = time.perf_counter()
