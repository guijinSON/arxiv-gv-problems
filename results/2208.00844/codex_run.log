+        anchor = by_label[label]["q"][0] % p
+        if not anchor:
+            return None, 0
+        anchor_inverses[label] = pow(anchor, p - 2, p)
+        normalized_constants[label] = by_label[label]["c"] * anchor_inverses[label] % p
