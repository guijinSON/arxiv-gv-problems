+    while width < m:
+        for start in range(0, m, 2 * width):
+            for j in range(start, start + width):
+                u, v = transformed[j], transformed[j + width]
+                transformed[j] = (u + v) % p
+                transformed[j + width] = (u - v) % p
+        width *= 2
+    point = []
+    bits = int(math.log2(m))
+    for variable in range(n):
