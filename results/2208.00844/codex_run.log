+def _walsh_compact_route(inst):
+    """Execute the intended normalized Walsh shortcut without using the answer."""
+    p = inst["modulus"]
+    n = inst["n"]
+    m = inst["equation_count"]
+    by_label = {eq["label"]: eq for eq in inst["equations"]}
