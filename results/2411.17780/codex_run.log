import math, time

def is_prime(n):
    if n < 2: return False
    if n % 2 == 0: return n == 2
    d=3
    while d*d<=n:
        if n%d==0:return False
        d+=2
    return True

def prime_power(n):
    if is_prime(n): return True
    for s in range(2,int(math.sqrt(n))+1):
        if is_prime(s):
            x=s*s
            while x<n:x*=s
            if x==n:return True
    return False
vals=[]
for k in range(2,10000):
    if (k-1)%10==0 and prime_power(k) and is_prime((k+1)//2) and k%2==1:
        vals.append((k,(k+1)//2,10*((k+1)//2)))
print(vals[:12])

p=31
# A synthetic ten-orbit voltage table satisfying the paper's only lifting input:
# two distinct shifts on each edge of the fixed quotient 10-cycle.
choices=[(i % p,(i+7)%p) for i in range(10)]
def lift_choice():
    picked=[x[0] for x in choices]
    total=0
    for x in picked: total=(total+x)%p
    if total==0:
        picked[0]=choices[0][1]
        total=sum(picked)%p
    return picked,total
assert lift_choice()[1]
N=1_000_000
start=time.perf_counter()
for _ in range(N):lift_choice()
elapsed=time.perf_counter()-start
print({'runs':N,'seconds':elapsed,'microseconds_per_run':elapsed*1e6/N,'result':lift_choice()})
