+def _closed_form(inst: dict) -> list[int]:
+    """Compute the endpoint ratio from instance fields, never from answer."""
+    layers = inst["layer_map"]["modulus"]
+    c0, c1, c2 = inst["slope_coefficients"]
+    sum_t = layers * (layers - 1) // 2
