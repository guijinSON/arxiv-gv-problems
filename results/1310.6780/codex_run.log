+def _layer_data(inst: dict) -> tuple[list[int], list[int]]:
+    count = inst["layer_map"]["modulus"]
+    multiplier = inst["layer_map"]["multiplier"]
+    offset = inst["layer_map"]["offset"]
+    c0, c1, c2 = inst["slope_coefficients"]
