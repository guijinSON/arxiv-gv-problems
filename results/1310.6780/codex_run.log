+def _reference_direct_product(inst: dict) -> tuple[list[int], int]:
+    """Exact O(L*m) factor generation with blind whole-factor cancellation."""
+    m = inst["edge_rank_map"]["modulus"]
+    a = inst["edge_rank_map"]["multiplier"]
