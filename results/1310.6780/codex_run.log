+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures, "attempts": g1_attempts, "failures": g1_failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=24681357, **shipping_params)
