assert re.search(r'mechanical|operations|seconds',note,re.I)
assert re.search(r'compact route|Track B',note,re.I)
rows=[json.loads(x) for x in open('llm_loop_transcript.jsonl') if x.strip()]
solved=[x for x in rows if x.get('solved')=='solved']
