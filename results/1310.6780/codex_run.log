+G9_MEASUREMENTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not run: OpenRouter key total limit exceeded",
+    "placebo_verdict": "not run: OpenRouter key total limit exceeded",
