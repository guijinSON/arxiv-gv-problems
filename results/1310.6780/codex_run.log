+{
+  "G1_planted_verifies": {
+    "attempts": 16,
+    "failures": [],
+    "pass": true
+  },
+  "G2_rejects_corruption": {
+    "cases": {
+      "drop_one": {
+        "reason": "expected 4 lane fractions",
+        "rejected": true
+      },
+      "duplicate_one": {
+        "reason": "lane numerators must be distinct",
+        "rejected": true
+      },
+      "empty": {
+        "reason": "certificate is empty",
+        "rejected": true
+      },
+      "out_of_range": {
+        "reason": "lane 0 numerator is outside the certificate bound",
+        "rejected": true
