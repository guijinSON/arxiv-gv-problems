 succeeded in 0ms:
   140	endpoint restarts, and the tempting but wrong use of endpoints in displayed
   141	edge order. The successful full exact product is reported separately as the
   142	Track-B reference algorithm.
   143	""".strip()
   144	
   145	
   146	# Program opcodes.  Each operation is a bijection of range(modulus).
   147	# 0: cyclic shift; 1: transposition; 2: full reversal; 3: reverse each block;
   148	# 4: transpose a (modulus/divisor)-by-divisor row-major grid;
   149	# 5: rotate each block.
   150	_SHIFT, _SWAP, _REVERSE, _BLOCK_REVERSE, _TRANSPOSE, _BLOCK_ROTATE = range(6)
   151	
   152	
   153	def _divisors(value: int) -> list[int]:
   154	    out = []
   155	    d = 2
   156	    while d * d <= value:
   157	        if value % d == 0:
   158	            out.append(d)
   159	            if d * d != value:
   160	                out.append(value // d)
   161	        d += 1
   162	    return sorted(out)
   163	
   164	
   165	def _make_program(modulus: int, rounds: int, rng: random.Random) -> list[list[int]]:
   166	    """Sample a composition of manifestly reversible index operations."""
   167	    divisors = _divisors(modulus)
   168	    program: list[list[int]] = []
   169	    for _ in range(rounds):
   170	        choices = [_SHIFT, _SWAP, _REVERSE]
   171	        if divisors:
   172	            choices.extend((_BLOCK_REVERSE, _TRANSPOSE, _BLOCK_ROTATE))
   173	        op = rng.choice(choices)
   174	        if op == _SHIFT:
   175	            program.append([op, rng.randrange(1, modulus)])
   176	        elif op == _SWAP:
   177	            a = rng.randrange(modulus)
   178	            b = rng.randrange(modulus - 1)
   179	            if b >= a:
   180	                b += 1
