import random,itertools,statistics,time

def make(d,N,seed):
 r=random.Random(seed); L=1<<d
 cols=list(range(L));r.shuffle(cols)
 rows=[[ (x>>j)&1 for x in cols] for j in range(d)]
 for _ in range(N-d):
  a=[0]*(L//2)+[1]*(L//2);r.shuffle(a);rows.append(a)
 p=list(range(N));r.shuffle(p);rows=[rows[i] for i in p]
 secret=[REDACTED_SECRET] for i in range(d))
 return rows,secret

def dfs(rows,d,limit=1000000):
 L=1<<d;n=len(rows);nodes=0
 def rec(start,sel,traces):
  nonlocal nodes
  if len(sel)==d:return sel
  need=d-len(sel)-1;cap=1<<need;target=1<<(len(sel)+1)
  for i in range(start,n-need):
   nodes+=1
   if nodes>limit:return None
   nt=[(x<<1)|b for x,b in zip(traces,rows[i])]
   counts=[0]*target
   for x in nt: counts[x]+=1
   if any(x"'!=cap for x in counts):continue
   z=rec(i+1,sel+[i],nt)
   if z:return z
  return None
 st=time.time();ans=rec(0,[],[0]*L)
 return nodes,ans,time.time()-st
