+        "base_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "doubled_concepts": len(doubled["concepts"]),
+        "build_and_verify_sec": round(time.perf_counter() - scale_start, 6),
+    }
+
+    invariance_checks = 0
+    transformation_checks = 0
+    base_keys = []
+    for seed in range(20):
+        inst = make_instance(seed=10_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(inst)
+        base_keys.append(key)
+        rng = random.Random(50_000 + seed)
+
+        row_only = dict(inst)
+        row_only["concepts"] = list(inst["concepts"])
+        rng.shuffle(row_only["concepts"])
+        row_only.pop("_column_masks_cache", None)
+        invariance_checks += int(canonical_key(row_only) == key)
+        transformation_checks += int(verify(row_only, inst["answer"])[0])
+
+        permutation = list(range(inst["n"]))
