/bin/bash -c for d in /proc/[0-9]*; do c=$(readlink "$d/cwd" 2>/dev/null || true); if [ "$c" = "$PWD" ]; then tr '\0' ' ' < "$d/cmdline" 2>/dev/null; echo " PID=${d##*/}"; fi; done  PID=2142687
