+        column_only, carried = _permute_columns(inst, permutation)
+        invariance_checks += int(canonical_key(column_only) == key)
+        transformation_checks += int(verify(column_only, carried)[0])
+
+        composed = dict(column_only)
+        composed["concepts"] = list(column_only["concepts"])
+        rng.shuffle(composed["concepts"])
