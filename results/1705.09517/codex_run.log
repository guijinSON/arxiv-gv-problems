def _rank_gf2(rows: list[int], width: int) -> int:
    work = list(rows)
    rank = 0
    for bit in range(width):
        pivot = None
        for j in range(rank, len(work)):
            if (work[j] >> bit) & 1:
                pivot = j
                break
        if pivot is None:
            continue
        work[rank], work[pivot] = work[pivot], work[rank]
        for j in range(rank + 1, len(work)):
            if (work[j] >> bit) & 1:
                work[j] ^= work[rank]
        rank += 1
    return rank


