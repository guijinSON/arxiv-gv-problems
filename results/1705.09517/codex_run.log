+        invariance_checks += int(canonical_key(column_only) == key)
+        transformation_checks += int(verify(column_only, carried)[0])
+
+        composed = dict(column_only)
+        composed["concepts"] = list(column_only["concepts"])
+        rng.shuffle(composed["concepts"])
+        composed.pop("_column_masks_cache", None)
+        invariance_checks += int(canonical_key(composed) == key)
+        transformation_checks += int(verify(composed, carried)[0])
+    distinct_keys = len(set(base_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariance_checks == 60
+        and transformation_checks == 60
+        and distinct_keys == 20,
+        "invariance_checks_passed": invariance_checks,
+        "invariance_checks_total": 60,
+        "transformed_witness_checks_passed": transformation_checks,
+        "transformed_witness_checks_total": 60,
+        "distinct_unrelated_keys": distinct_keys,
+        "unrelated_instances": 20,
+        "invariant": "multiset of exact 3-column projection cell-count histograms",
+    }
+
+    answer_blob = json.dumps(shipping["answer"])
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(shipping["answer"])
+    route_operations = 2 * shipping["n"]
+    hinted = G9_RESULTS["hinted"]
+    placebo = G9_RESULTS["placebo"]
+    arms_measured = bool(hinted["attempts"] and placebo["attempts"])
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else None
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else None
+    report["G9_no_tool_suitability"] = {
+        "pass": answer_chars <= 2000 and answer_elements <= 256 and route_operations <= 300,
+        "arms": G9_RESULTS,
+        "hinted_minus_placebo": (
