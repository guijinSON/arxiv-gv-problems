git diff --cached --quiet 2>/dev/null || git commit -q --amend --no-edit 2>/dev/null
git push -q origin main && echo "SUBMITTED $ID" || {
  echo "push failed — run: git pull --rebase origin main && git push origin main"; exit 4; }

