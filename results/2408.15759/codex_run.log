+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "rational_exact",
+    "computational_core": "telescoping",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "weighted Scorza divisor classes in the numerical cycle ring N(C^n)",
+        "a zero-dimensional intersection product on a genus-three curve product",
+        "a two-term rational exponential expression",
+    ],
+    "verification_operations": [
+        "exact rational reduction and multiplication",
+        "exact integer exponentiation",
+        "exact equality of rational intersection numbers",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The scalar weights are a shuffled gauge chain whose reduced prime labels "
+        "balance between numerators and denominators, leaving only two endpoints; "
+        "without this invariant one must accumulate every large rational weight."
+    ),
+    "hardness_basis": (
+        "Track B: Section 4, Lemma 4.5 gives the unweighted Scorza-class identity; "
+        "the disclosed exact Fraction accumulation is O(n) and at shipping n=256 "
+        "uses 1,284 counted arithmetic primitives and averaged 0.00027 seconds "
+        "over eight shipping instances, "
+        "whereas balanced-label cancellation leaves only the final four arithmetic "
+        "operations once the invariant is seen."
+    ),
+    "max_answer_tokens": 31,
+}
+
+NATIVE = {
