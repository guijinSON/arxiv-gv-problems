+    attack_times = {name: 0.0 for name in attack_names}
+    for i, candidate_inst in enumerate(attack_instances):
+        probes = {
+            "outlier_largest_single_scale": lambda: _attack_largest_scale(candidate_inst),
+            "greedy_printed_endpoint_cancellation": lambda: _attack_printed_endpoints(candidate_inst),
+            "by_hand_unweighted_scorza_ansatz": lambda: _attack_unweighted(candidate_inst),
+        }
+        for name, probe in probes.items():
+            start = time.perf_counter(); candidate = probe(); attack_times[name] += time.perf_counter() - start
+            attacks[name]["successes"] += verify(candidate_inst, candidate)[0]
+        rrng = random.Random(70000 + i)
+        candidate_expected = _intersection_value(candidate_inst)
+        start = time.perf_counter()
