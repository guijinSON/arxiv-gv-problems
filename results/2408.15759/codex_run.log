+    ops = []
+    for kind in types:
+        if kind == "xor":
+            ops.append({"op": kind, "constant": rng.randrange(n)})
+        elif kind == "affine":
+            ops.append({
+                "op": kind,
+                "multiplier": rng.randrange(1, n, 2),
+                "offset": rng.randrange(n),
+            })
+        else:
+            ops.append({"op": kind, "shift": rng.randrange(1, bits)})
+    return ops
