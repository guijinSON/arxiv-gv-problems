+def _cycle_sequence(inst):
+    n = inst["n"]
+    by_edge = {}
+    for factor in inst["factors"]:
+        edge = tuple(sorted(factor["edge"]))
+        if edge in by_edge:
+            raise ValueError("duplicate cycle edge")
+        by_edge[edge] = _reduced_pair(factor["scale"])
+    expected = {_edge(i + 1, ((i + 1) % n) + 1) for i in range(n)}
+    if set(by_edge) != expected:
+        raise ValueError("factor edges do not form the labelled n-cycle")
+    return tuple(by_edge[_edge(i + 1, ((i + 1) % n) + 1)] for i in range(n))
+
+
+def _canonical_dihedral(sequence):
+    sequence = tuple(sequence)
+    n = len(sequence)
+    variants = []
+    reverse = tuple(reversed(sequence))
+    for seq in (sequence, reverse):
+        variants.extend(seq[k:] + seq[:k] for k in range(n))
+    return min(variants)
