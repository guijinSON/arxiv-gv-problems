+def _render_operation(number, operation, n, bits):
+    kind = operation["op"]
+    if kind == "xor":
+        rule = f"x := x XOR {operation['constant']}"
+    elif kind == "affine":
+        rule = (f"x := ({operation['multiplier']}*x + {operation['offset']}) "
+                f"mod {n}")
