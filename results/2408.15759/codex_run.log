+def _generate_mixer(rng, n, rounds):
+    bits = n.bit_length() - 1
+    types = _operation_types(rounds)
+    rng.shuffle(types)
+    ops = []
+    for kind in types:
+        if kind == "xor":
+            ops.append({"op": kind, "constant": rng.randrange(n)})
+        elif kind == "affine":
+            ops.append({
