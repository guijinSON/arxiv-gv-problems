+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not run",
+}
+
+NOTES = """\
+Section 2 fixes a heptagon as seven ordered projective lines and its adjoint as
+the quartic through the fourteen nonconsecutive intersections.  The main
+Theorem 5.5 counts the generic inverse fibre, but neither it nor Proposition
+3.2 supplies a scalable exact inverse algorithm.  A planted rational heptagon
+would therefore support neither a distributional Track-A claim nor an honest
+measured Track-B reference algorithm, so that initial route was not used.
+
+The family instead uses the paper's own Section 4 objects.  Equation (4.2)
+gives [S(eta)]=2*x_1+2*x_2+Delta and Lemma 4.5 proves that the cyclic top
+intersection on C^n is 2*3^n-6.  Multiplying the individual divisor classes by
+rational scalars multiplies the top intersection by their product.  The module
+chooses a chain of distinct primes first, makes consecutive prime ratios,
+attaches those ratios to randomly permuted cycle edges, multiplies numerator
+and denominator of every displayed ratio by a presentation mask, and carries
+the known endpoint quotient into the two-term symbolic certificate.
+
+This is Track B.  Exact rational accumulation followed by Lemma 4.5 is a fully
+disclosed O(n) algorithm and is reported as the reference algorithm.  The
+compact route cancels each explicitly shared mask and balances prime labels globally.
+The edge order and printed order are independently scrambled, so printed-end
+greedy cancellation fails; masks defeat raw-frequency and magnitude outliers;
+the unweighted Scorza ansatz fails because endpoint primes are distinct; and
+bounded random symbolic expressions miss throughout the measured panel.
+"""
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _sieve(limit):
+    flags = bytearray(b"\x01") * (limit + 1)
+    if limit >= 0:
+        flags[0] = 0
+    if limit >= 1:
+        flags[1] = 0
+    for p in range(2, math.isqrt(limit) + 1):
+        if flags[p]:
+            start = p * p
+            flags[start:limit + 1:p] = b"\x00" * (((limit - start) // p) + 1)
+    return [i for i, flag in enumerate(flags) if flag]
+
+
+@lru_cache(maxsize=None)
+def _prime_pool(bits):
+    low = 1 << max(1, bits - 1)
+    high = 1 << (bits + 1)
+    return tuple(p for p in _sieve(high - 1) if p >= low)
+
+
+def _language_bounds(n, prime_bits):
+    coefficient = max(40_000 * n, 8 * (1 << (prime_bits + 1)))
+    denominator = max(4_000 * n, 1 << (prime_bits + 1))
+    if coefficient > GLOBAL_COEFF_BOUND or denominator > GLOBAL_DEN_BOUND:
+        raise ValueError("certificate bounds exceed the declared global language")
+    return coefficient, denominator
+
+
+def _scale_fraction(scale):
+    nf = scale["numerator_factors"]
+    df = scale["denominator_factors"]
+    return Fraction(nf[0] * nf[1], df[0] * df[1])
+
+
+def _reduced_pair(scale):
+    value = _scale_fraction(scale)
+    return value.numerator, value.denominator
+
+
+def _rat_json(value):
+    value = Fraction(value)
+    return [value.numerator, value.denominator]
+
+
+def _make_expression(weight, n):
+    weight = Fraction(weight)
+    return {
+        "terms": [
+            {
+                "coefficient": _rat_json(2 * weight),
+                "base": 3,
+                "exponent": n,
+            },
+            {
+                "coefficient": _rat_json(-6 * weight),
+                "base": 1,
+                "exponent": n,
+            },
+        ]
+    }
+
+
+def _edge(a, b):
+    return (a, b) if a < b else (b, a)
+
+
+def make_instance(n, seed=0, **params):
+    """Build weighted Scorza classes and carry Lemma 4.5 through their scalars."""
+    prime_bits = params.pop("prime_bits", 12)
+    mask_bits = params.pop("mask_bits", 8)
+    if params:
+        raise ValueError("unknown parameters: " + ", ".join(sorted(params)))
+    if not _is_int(n) or not 3 <= n <= MAX_N:
+        raise ValueError(f"n must be an integer in 3..{MAX_N}")
+    if not _is_int(prime_bits) or not 3 <= prime_bits <= MAX_PRIME_BITS:
+        raise ValueError(f"prime_bits must be in 3..{MAX_PRIME_BITS}")
+    if not _is_int(mask_bits) or not 1 <= mask_bits <= MAX_MASK_BITS:
+        raise ValueError(f"mask_bits must be in 1..{MAX_MASK_BITS}")
+
+    pool = _prime_pool(prime_bits)
+    if len(pool) < n + 1:
+        raise ValueError("prime_bits is too small to supply n+1 distinct labels")
+    rng = random.Random(seed)
+    labels = rng.sample(pool, n + 1)
+
+    # The reduced weights telescope to labels[-1]/labels[0].  Their attachment
+    # to cycle edges and their printed order are independently scrambled.
+    raw_scales = []
+    for i in range(n):
+        if mask_bits == 1:
+            mask = 1
+        else:
+            mask = rng.randrange(1 << (mask_bits - 1), 1 << mask_bits)
+        raw_scales.append({
+            "numerator_factors": [labels[i + 1], mask],
+            "denominator_factors": [labels[i], mask],
+        })
+    rng.shuffle(raw_scales)
+
+    factors = []
+    for i, scale in enumerate(raw_scales):
+        a, b = i + 1, ((i + 1) % n) + 1
+        factors.append({"edge": list(_edge(a, b)), "scale": scale})
+    rng.shuffle(factors)
+
+    coeff_bound, den_bound = _language_bounds(n, prime_bits)
+    weight = Fraction(labels[-1], labels[0])
+    answer = _make_expression(weight, n)
+    for term in answer["terms"]:
+        if abs(term["coefficient"][0]) > coeff_bound:
+            raise ValueError("planted numerator exceeds the instance language")
+        if term["coefficient"][1] > den_bound:
+            raise ValueError("planted denominator exceeds the instance language")
+
+    return {
+        "paper": "2408.15759",
+        "n": n,
+        "genus": 3,
+        "prime_bits": prime_bits,
+        "mask_bits": mask_bits,
+        "factors": factors,
+        "language": {
+            "coefficient_abs_bound": coeff_bound,
+            "denominator_bound": den_bound,
+            "base_bound": MAX_BASE,
+            "exponent": n,
+        },
+        "answer": answer,
+    }
+
+
+def render(inst):
+    factor_lines = "\n".join(
+        f"  edge {f['edge'][0]}-{f['edge'][1]} : scale "
+        f"({f['scale']['numerator_factors'][0]}*{f['scale']['numerator_factors'][1]})/"
+        f"({f['scale']['denominator_factors'][0]}*{f['scale']['denominator_factors'][1]})"
+        for f in inst["factors"]
+    )
+    cb = inst["language"]["coefficient_abs_bound"]
+    db = inst["language"]["denominator_bound"]
+    n = inst["n"]
+    statement = f"""Compute an exact weighted Scorza-class intersection number.
+
+Let C be a smooth complete curve of genus 3.  In the numerical cycle ring of
+C^{n}, x_i is the pullback of the class of a point from coordinate i, and
+Delta_ij is the pullback of the diagonal from coordinates i and j.  Indices
+are 1-based.  For every cycle edge {{i,j}}, define the Scorza divisor class
+
+    S_ij = 2*x_i + 2*x_j + Delta_ij.
+
+The exact rules used for products are: degree(x_1*...*x_n)=1; x_i^2=0;
+x_i*Delta_ij=x_i*x_j; a connected tree of distinct Delta factors is its
+small-diagonal class; and a connected cycle of Delta factors has degree
+-(2g-2)=-4.  Products over disconnected components multiply, and degree is
+linear over rational coefficients.  These rules completely determine the
+top-degree product below.
+
+For every edge of the n-cycle 1-2-...-{n}-1, one rational scale s_ij is listed.
+Each exact scale is displayed as (p*m)/(q*m), with its two integer numerator
+factors and two integer denominator factors exposed; it need not be multiplied
+out or written in lowest terms.  Factor order is irrelevant and the rows are
+deliberately not in cyclic order.  Compute
+
+    I = product over cycle edges {{i,j}} of (s_ij * S_ij)
+
+as a rational number.
+
+Complete weighted factor list:
+{factor_lines}
+
+Represent I by exactly two distinct ordered exponential terms.  A term
+{{"coefficient":[a,b],"base":c,"exponent":e}} means the exact rational
+(a/b)*c^e.  The two terms are added.  In term 0 require 1 <= a <= {cb} and
+2 <= c <= {MAX_BASE}; in term 1 require -{cb} <= a <= -1 and c=1.  In both,
+1 <= b <= {db} and e must equal n={n}.  All bounds are inclusive,
+coefficients may be unreduced, and this term order is required.
+
+Give your final answer inside <answer></answer> tags as one JSON object with
+the sole key "terms" and exactly two term objects in the format above.
+Example: <answer>{{"terms":[{{"coefficient":[2,1],"base":3,"exponent":{n}}},{{"coefficient":[-6,1],"base":1,"exponent":{n}}}]}}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    tagged = re.search(r"<answer\b[^>]*>(.*?)</answer>", text,
+                       flags=re.IGNORECASE | re.DOTALL)
+    candidates = [tagged.group(1)] if tagged else []
+    candidates.extend(re.findall(r"```(?:json)?\s*(\{.*?\})\s*```", text,
+                                 flags=re.IGNORECASE | re.DOTALL))
+    if not candidates:
+        start, end = text.find("{"), text.rfind("}")
+        if 0 <= start < end:
+            candidates.append(text[start:end + 1])
+    for blob in candidates:
+        try:
+            value = json.loads(blob.strip())
+        except (TypeError, ValueError):
+            continue
+        if isinstance(value, dict):
+            return value
+    return None
+
+
+def _answer_shape(inst, answer):
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer object is empty"
+    if set(answer) != {"terms"}:
+        return False, "answer must have the sole key 'terms'"
+    terms = answer["terms"]
+    if not isinstance(terms, list):
+        return False, "terms must be a JSON list"
+    if not terms:
+        return False, "term list is empty"
+    if len(terms) != 2:
+        return False, "term list must contain exactly two terms"
+    if terms[0] == terms[1]:
+        return False, "the two term objects must be distinct"
+    cb = inst["language"]["coefficient_abs_bound"]
+    db = inst["language"]["denominator_bound"]
+    for i, term in enumerate(terms):
+        if not isinstance(term, dict) or set(term) != {"coefficient", "base", "exponent"}:
+            return False, f"term {i} must have coefficient, base, and exponent"
+        coef = term["coefficient"]
+        if not isinstance(coef, list) or len(coef) != 2 or not all(_is_int(x) for x in coef):
+            return False, f"term {i} coefficient must be [integer,integer]"
+        if abs(coef[0]) > cb:
+            return False, f"term {i} numerator is outside the inclusive bound"
+        if not 1 <= coef[1] <= db:
+            return False, f"term {i} denominator is outside the inclusive bound"
+        if i == 0 and coef[0] <= 0:
+            return False, "term 0 numerator must be positive"
+        if i == 1 and coef[0] >= 0:
+            return False, "term 1 numerator must be negative"
+        if i == 0 and (not _is_int(term["base"]) or not 2 <= term["base"] <= MAX_BASE):
+            return False, f"term 0 base is outside 2..{MAX_BASE}"
+        if i == 1 and term["base"] != 1:
+            return False, "term 1 base must equal 1"
+        if term["exponent"] != inst["n"] or not _is_int(term["exponent"]):
+            return False, f"term {i} exponent must equal n={inst['n']}"
+    return True, "ok"
+
+
+def _expression_value(inst, answer):
+    total = Fraction(0)
+    for term in answer["terms"]:
+        coef = Fraction(term["coefficient"][0], term["coefficient"][1])
+        total += coef * pow(term["base"], term["exponent"])
+    return total
+
+
+def _intersection_value(inst):
+    weight = Fraction(1)
+    for factor in inst["factors"]:
+        weight *= _scale_fraction(factor["scale"])
+    return weight * (2 * pow(3, inst["n"]) - 6)
+
+
+def verify(inst, answer):
+    ok, reason = _answer_shape(inst, answer)
+    if not ok:
+        return False, reason
+    try:
+        value = _expression_value(inst, answer)
+        expected = _intersection_value(inst)
+    except (ArithmeticError, OverflowError, TypeError, ValueError):
+        return False, "answer could not be evaluated exactly"
+    if value != expected:
+        return False, "two-term expression does not equal the weighted intersection"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    cb = inst["language"]["coefficient_abs_bound"]
+    db = inst["language"]["denominator_bound"]
+    return {"terms": [
+        {
+            "coefficient": [rng.randint(1, cb), rng.randint(1, db)],
+            "base": rng.randint(2, MAX_BASE),
+            "exponent": inst["n"],
+        },
+        {
+            "coefficient": [-rng.randint(1, cb), rng.randint(1, db)],
+            "base": 1,
+            "exponent": inst["n"],
+        },
+    ]}
+
+
+def search_space(inst):
+    cb = inst["language"]["coefficient_abs_bound"]
+    db = inst["language"]["denominator_bound"]
+    first = cb * db * (MAX_BASE - 1)
+    second = cb * db
+    return first * second
+
+
+def enumerate_all(inst):
+    # The smallest declared symbolic language is already far above the cap.
+    if search_space(inst) > 1_000_000:
+        return None
+    count = 0
+    rng = random.Random(0)
