+        elif kind == "xorshift_left":
+            x ^= (x << operation["shift"]) & mask
+            primitive_count += 3
+        elif kind == "rotate_left":
+            shift = operation["shift"]
+            x = ((x << shift) & mask) | (x >> (bits - shift))
+            primitive_count += 4
+        else:
+            raise ValueError("unknown mixer operation")
+    return (x, primitive_count) if count else x
