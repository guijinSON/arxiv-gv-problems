+
+if os.environ.get("GV_G9_SINGLE") == "1":
+    DIFFICULTY = {SHIPPING_DIFFICULTY: dict(DIFFICULTY[SHIPPING_DIFFICULTY])}
+
+
+STRUCTURAL_HINT = (
+    "Across the reduced scales, every internal prime label has balanced numerator "
+    "and denominator multiplicity, while only the two endpoint labels are unbalanced."
+)
+PLACEBO_HINT = (
+    "Across the displayed scales, keep every numerator paired with its denominator "
+    "and preserve all indices when writing the required two-term expression."
+)
+
+MAX_N = 512
+MAX_PRIME_BITS = 20
+MAX_MASK_BITS = 24
+MAX_BASE = 9
+GLOBAL_COEFF_BOUND = 100_000_000
+GLOBAL_DEN_BOUND = 4_000_000
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON object with exactly two distinct ordered exponential terms.  Each "
+        "term is {coefficient:[num,den],base:b,exponent:n}; den is positive, the "
+        "instance gives inclusive numerator/denominator bounds, and the exponent "
+        "is exactly the displayed n.  Term 0 has positive numerator and base 2..9; "
+        "term 1 has negative numerator and base 1.  Terms are added and rational "
+        "coefficients may be unreduced."
+    ),
+    "bounds": {
