+        rule = f"x := x XOR ((x << {operation['shift']}) AND {n - 1})"
+    elif kind == "rotate_left":
+        rule = f"x := ROTL_{bits}(x,{operation['shift']})"
+    else:
+        raise ValueError("unknown mixer operation")
+    return f"  {number}. {rule}"
