+
+    attack_instances = [make_instance(seed=1000 + i, **shipping_params) for i in range(8)]
+    reference_results = []
+    compact_results = []
+    for candidate_inst in attack_instances:
+        start = time.perf_counter()
+        candidate, ops = _reference_solve(candidate_inst)
+        elapsed = time.perf_counter() - start
+        reference_results.append((verify(candidate_inst, candidate)[0], ops, elapsed))
+        start = time.perf_counter()
+        candidate, ops = _compact_solve(candidate_inst)
+        elapsed = time.perf_counter() - start
