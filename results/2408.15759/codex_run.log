+def _apply_mixer(value, n, ops, count=False):
+    mask = n - 1
+    bits = n.bit_length() - 1
+    x = value
+    primitive_count = 0
+    for operation in ops:
+        kind = operation["op"]
+        if kind == "xor":
+            x ^= operation["constant"]
+            primitive_count += 1
+        elif kind == "affine":
