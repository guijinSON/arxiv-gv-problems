+            "positive denominators already enforced",
+        ],
+        "wall_clock_sec": round(guess_elapsed, 6),
+    }
+
+    attack_instances = [make_instance(seed=1000 + i, **shipping_params) for i in range(8)]
+    reference_results = []
+    compact_results = []
+    for candidate_inst in attack_instances:
