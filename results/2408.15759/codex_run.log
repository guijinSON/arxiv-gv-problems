+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    tagged = re.search(r"<answer\b[^>]*>(.*?)</answer>", text,
+                       flags=re.IGNORECASE | re.DOTALL)
+    candidates = [tagged.group(1)] if tagged else []
+    candidates.extend(re.findall(r"```(?:json)?\s*(\{.*?\})\s*```", text,
+                                 flags=re.IGNORECASE | re.DOTALL))
+    if not candidates:
+        start, end = text.find("{"), text.rfind("}")
+        if 0 <= start < end:
+            candidates.append(text[start:end + 1])
+    for blob in candidates:
+        try:
+            value = json.loads(blob.strip())
+        except (TypeError, ValueError):
+            continue
+        if isinstance(value, dict):
+            return value
+    return None
+
+
+def _answer_shape(inst, answer):
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer object is empty"
+    if set(answer) != {"terms"}:
+        return False, "answer must have the sole key 'terms'"
+    terms = answer["terms"]
+    if not isinstance(terms, list):
+        return False, "terms must be a JSON list"
+    if not terms:
+        return False, "term list is empty"
+    if len(terms) != 2:
+        return False, "term list must contain exactly two terms"
+    if terms[0] == terms[1]:
+        return False, "the two term objects must be distinct"
+    cb = inst["language"]["coefficient_abs_bound"]
+    db = inst["language"]["denominator_bound"]
+    for i, term in enumerate(terms):
+        if not isinstance(term, dict) or set(term) != {"coefficient", "base", "exponent"}:
+            return False, f"term {i} must have coefficient, base, and exponent"
+        coef = term["coefficient"]
+        if not isinstance(coef, list) or len(coef) != 2 or not all(_is_int(x) for x in coef):
+            return False, f"term {i} coefficient must be [integer,integer]"
+        if abs(coef[0]) > cb:
+            return False, f"term {i} numerator is outside the inclusive bound"
+        if not 1 <= coef[1] <= db:
+            return False, f"term {i} denominator is outside the inclusive bound"
+        if i == 0 and coef[0] <= 0:
+            return False, "term 0 numerator must be positive"
+        if i == 1 and coef[0] >= 0:
+            return False, "term 1 numerator must be negative"
+        if i == 0 and (not _is_int(term["base"]) or not 2 <= term["base"] <= MAX_BASE):
+            return False, f"term 0 base is outside 2..{MAX_BASE}"
+        if i == 1 and term["base"] != 1:
+            return False, "term 1 base must equal 1"
+        if term["exponent"] != inst["n"] or not _is_int(term["exponent"]):
+            return False, f"term {i} exponent must equal n={inst['n']}"
+    return True, "ok"
+
+
+def _expression_value(inst, answer):
+    total = Fraction(0)
+    for term in answer["terms"]:
+        coef = Fraction(term["coefficient"][0], term["coefficient"][1])
+        total += coef * pow(term["base"], term["exponent"])
+    return total
+
+
+def _intersection_value(inst):
+    weight = Fraction(1)
+    for factor in inst["factors"]:
+        weight *= _scale_fraction(factor["scale"])
+    return weight * (2 * pow(3, inst["n"]) - 6)
+
+
+def verify(inst, answer):
+    ok, reason = _answer_shape(inst, answer)
+    if not ok:
+        return False, reason
+    try:
+        value = _expression_value(inst, answer)
+        expected = _intersection_value(inst)
+    except (ArithmeticError, OverflowError, TypeError, ValueError):
+        return False, "answer could not be evaluated exactly"
+    if value != expected:
+        return False, "two-term expression does not equal the weighted intersection"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    cb = inst["language"]["coefficient_abs_bound"]
+    db = inst["language"]["denominator_bound"]
+    return {"terms": [
+        {
+            "coefficient": [rng.randint(1, cb), rng.randint(1, db)],
+            "base": rng.randint(2, MAX_BASE),
+            "exponent": inst["n"],
+        },
+        {
+            "coefficient": [-rng.randint(1, cb), rng.randint(1, db)],
+            "base": 1,
+            "exponent": inst["n"],
+        },
+    ]}
+
+
+def search_space(inst):
+    cb = inst["language"]["coefficient_abs_bound"]
+    db = inst["language"]["denominator_bound"]
+    first = cb * db * (MAX_BASE - 1)
+    second = cb * db
+    return first * second
+
+
+def enumerate_all(inst):
+    # The smallest declared symbolic language is already far above the cap.
+    if search_space(inst) > 1_000_000:
+        return None
+    count = 0
+    rng = random.Random(0)
+    # This branch is retained for completeness if the language is ever reduced.
+    seen = set()
+    while len(seen) < search_space(inst):
+        candidate = random_candidate(inst, rng)
+        blob = json.dumps(candidate, sort_keys=True, separators=(",", ":"))
+        if blob in seen:
+            continue
+        seen.add(blob)
+        count += verify(inst, candidate)[0]
+    return count
+
+
+def _cycle_sequence(inst):
+    n = inst["n"]
+    by_edge = {}
+    for factor in inst["factors"]:
+        edge = tuple(sorted(factor["edge"]))
+        if edge in by_edge:
+            raise ValueError("duplicate cycle edge")
+        by_edge[edge] = _reduced_pair(factor["scale"])
+    expected = {_edge(i + 1, ((i + 1) % n) + 1) for i in range(n)}
+    if set(by_edge) != expected:
+        raise ValueError("factor edges do not form the labelled n-cycle")
+    return tuple(by_edge[_edge(i + 1, ((i + 1) % n) + 1)] for i in range(n))
+
+
+def _canonical_dihedral(sequence):
+    sequence = tuple(sequence)
+    n = len(sequence)
+    variants = []
+    reverse = tuple(reversed(sequence))
+    for seq in (sequence, reverse):
+        variants.extend(seq[k:] + seq[:k] for k in range(n))
+    return min(variants)
+
+
+def canonical_key(inst):
+    canonical = _canonical_dihedral(_cycle_sequence(inst))
+    payload = json.dumps({"n": inst["n"], "weights": canonical},
+                         sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(payload.encode()).hexdigest()
+
+
+def _relabel_instance(inst, rotation=0, reflect=False, reorder_seed=None):
+    n = inst["n"]
+
+    def mapped(label):
+        zero = label - 1
+        if reflect:
+            zero = -zero
+        return ((zero + rotation) % n) + 1
+
+    out = json.loads(json.dumps(inst))
+    for factor in out["factors"]:
+        factor["edge"] = list(_edge(mapped(factor["edge"][0]),
+                                     mapped(factor["edge"][1])))
+    if reorder_seed is not None:
+        random.Random(reorder_seed).shuffle(out["factors"])
+    return out
+
+
+def _reference_solve(inst):
+    """O(n) exact accumulation, the disclosed efficient Track-B algorithm."""
+    weight = Fraction(1)
+    operations = 0
+    for factor in inst["factors"]:
+        weight *= _scale_fraction(factor["scale"])
+        # two displayed products, numerator/denominator accumulation, and gcd.
+        operations += 5
+    operations += 4  # two scalar multiplications and the two-term construction
+    return _make_expression(weight, inst["n"]), operations
+
+
+def _compact_solve(inst):
+    """Cancel exposed masks and balance labels; only the final four ops are arithmetic."""
+    balance = Counter()
+    operations = 0
+    for factor in inst["factors"]:
+        scale = factor["scale"]
+        if (len(scale["numerator_factors"]) != 2
+                or len(scale["denominator_factors"]) != 2
+                or scale["numerator_factors"][1] != scale["denominator_factors"][1]):
+            return None, operations
+        num = scale["numerator_factors"][0]
+        den = scale["denominator_factors"][0]
+        balance[num] += 1
+        balance[den] -= 1
+    positive = [p for p, multiplicity in balance.items() if multiplicity == 1]
+    negative = [p for p, multiplicity in balance.items() if multiplicity == -1]
+    if len(positive) != 1 or len(negative) != 1 or any(abs(v) > 1 for v in balance.values()):
+        return None, operations
+    operations += 4
+    return _make_expression(Fraction(positive[0], negative[0]), inst["n"]), operations
+
+
+def _attack_unweighted(inst):
+    return _make_expression(Fraction(1), inst["n"])
+
+
+def _attack_printed_endpoints(inst):
+    first = inst["factors"][0]["scale"]
+    last = inst["factors"][-1]["scale"]
+    return _make_expression(Fraction(last["numerator_factors"][0],
+                                     first["denominator_factors"][0]), inst["n"])
