+def _compact_mobius_recovery(inst: dict) -> tuple[list[int], int]:
+    """Recover the secret through the hidden singleton/pair evaluation identity."""
+    by_label = {
+        label: (feature, response) for label, feature, response in inst["samples"]
+    }
