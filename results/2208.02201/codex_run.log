   179	
   180	def _gf2_rank(columns: list[int]) -> int:
   181	    """Rank of bit-packed column vectors over F_2."""
   182	    basis: dict[int, int] = {}
   183	    for value in columns:
   184	        x = value
   185	        while x:
   186	            pivot = x.bit_length() - 1
   187	            if pivot in basis:
   188	                x ^= basis[pivot]
   189	            else:
   190	                basis[pivot] = x
   191	                break
   192	    return len(basis)
   193	
   194	
   195	def _random_full_rank_columns(n: int, rows: int, rng: random.Random) -> tuple[list[int], int]:
   196	    """Uniform rejection sampling from full-row-rank binary matrices."""
   197	    for attempt in range(1, 10_001):
   198	        columns = [rng.getrandbits(rows) for _ in range(n)]
   199	        if _gf2_rank(columns) == rows:
   200	            return columns, attempt
   201	    raise RuntimeError("could not sample a full-rank binary matrix")
   202	
   203	
   204	def make_instance(
   205	    n: int,
   206	    seed: int = 0,
   207	    k: int | None = None,
   208	    weight: int | None = None,
   209	    **params: Any,
   210	) -> dict:
   211	    """Inverse-generate a random full-distance syndrome-decoding instance."""
   212	    if params:
   213	        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
   214	    if k is None:
   215	        k = n // 4
   216	    if weight is None:
   217	        weight = (2145 * n + 5000) // 10_000
   218	    for name, value in (("n", n), ("k", k), ("weight", weight), ("seed", seed)):
   219	        if isinstance(value, bool) or not isinstance(value, int):
   220	            raise ValueError(f"{name} must be an integer")
   221	    if n < 4:
   222	        raise ValueError("n must be at least 4")
   223	    if not 1 <= k < n:
   224	        raise ValueError("k must satisfy 1 <= k < n")
   225	    rows = n - k
   226	    if not 1 <= weight <= rows:
   227	        raise ValueError("weight must satisfy 1 <= weight <= n-k")
   228	
   229	    rng = random.Random(seed)
   230	    columns, matrix_attempts = _random_full_rank_columns(n, rows, rng)
   231	    support = sorted(rng.sample(range(n), weight))
   232	    syndrome = 0
   233	    for index in support:
   234	        syndrome ^= columns[index]
   235	
   236	    return {
   237	        "family": "full-distance decoding of a random binary linear code",
   238	        "paper": "arXiv:2208.02201",
   239	        "n": n,
   240	        "k": k,
   241	        "rows": rows,
   242	        "weight": weight,
   243	        "columns": columns,
   244	        "syndrome": syndrome,
   245	        "hex_width": (rows + 3) // 4,
   246	        "matrix_sampling_attempts": matrix_attempts,
   247	        "answer": support,
   248	    }
