   251	def render(inst: dict) -> str:
   252	    """Render the complete exact decoding problem and output contract."""
   253	    width = inst["hex_width"]
   254	    column_lines = "\n".join(
   255	        f"{index}: {value:0{width}x}"
   256	        for index, value in enumerate(inst["columns"])
   257	    )
   258	    statement = f"""Fixed-weight binary syndrome decoding
   259	
   260	All arithmetic is over the binary field F_2, so vector addition is bitwise xor.
   261	The parity-check matrix H has {inst['rows']} rows and {inst['n']} columns and
   262	defines a binary linear [n,k]=[{inst['n']},{inst['k']}] code as its null space.
   263	
   264	Each column below is one vector in F_2^{inst['rows']}, written as exactly
   265	{width} hexadecimal digits.  Leading zeroes are significant padding.  Row 0 is
   266	the least-significant bit, row 1 the next bit, and so on; equivalently, you may
   267	xor the hexadecimal integers directly.
   268	
   269	Find a binary error vector e of Hamming weight exactly {inst['weight']} such that
   270	H e^T equals the displayed syndrome.  Output its support: exactly
   271	{inst['weight']} distinct column indices whose xor is the syndrome.
   272	
   273	Indices are zero-based from 0 through {inst['n'] - 1}, inclusive.  Repeats are
   274	forbidden, order does not change the mathematical support, and the required
   275	serialization is strictly increasing order.  Every datum is exact.
   276	
   277	n: {inst['n']}
   278	k: {inst['k']}
   279	number of parity-check rows: {inst['rows']}
   280	required Hamming weight: {inst['weight']}
   281	syndrome (hex): {inst['syndrome']:0{width}x}
   282	columns of H (zero-based index: fixed-width hex vector):
   283	{column_lines}
   284	
   285	Give your final answer inside <answer></answer> tags as one JSON list of exactly
   286	{inst['weight']} strictly increasing integers.
   287	Example format: <answer>[0, 3, 9]</answer>
   288	Output nothing else inside the tags."""
   289	    mode = os.environ.get("GV_HINT_MODE")
   290	    if mode == "structural":
   291	        statement += "\n\n" + STRUCTURAL_HINT
   292	    elif mode == "placebo":
   293	        statement += "\n\n" + PLACEBO_HINT
   294	    return statement
