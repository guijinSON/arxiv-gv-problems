+"""Verified full-distance syndrome-decoding instances from arXiv:2208.02201.
+
+Carrier--Debris-Alazard--Meyer-Hilfiger--Tillich study decoding a
+random binary linear code, including its reduction to Learning Parity with
+Noise.  Problem 1.1 is equivalently the exact witness problem used here:
+given a full-rank parity-check matrix H, a syndrome s, and a weight t, find
+an error e of Hamming weight t such that H e^T = s^T over F_2.
+
+The generator samples H and the support of e first and derives s by xor.  It
+therefore knows a certificate by inverse generation and never decodes the
+instance it emits.  All public data and all verification arithmetic are exact.
+The module is deterministic in (n, seed, params), standard-library-only, and
+silent on import.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+from typing import Any
+
+
+TRACK = "A"
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "full-rank binary parity-check matrix",
+        "binary syndrome",
+        "fixed-weight binary error vector",
+    ],
+    "verification_operations": [
+        "exact xor of vectors over F_2",
+        "exact Hamming-weight check",
+        "exact syndrome comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "duality",
+    "intuition_description": (
+        "Low-weight dual codewords expose biased parity equations about a block "
+        "of the hidden error; without enough useful dual checks one falls back "
+        "to exponential information-set decoding."
+    ),
+    "hardness_basis": (
+        "Track A: Problem 1.1 and Section 1.1 place random-code decoding at "
+        "tau=delta_GV(R), while Proposition 10 gives an exponential RLPN "
+        "complexity exponent in that regime; shipping uses R=1/4, n=192, "
+        "t=41, where the measured 512-trial Prange attack and its exact xor "
+        "count are reported in G5 (support containment alone has expected "
+        "cost C(192,41)/C(144,41) about 2^19.5 trials)."
+    ),
+    "max_answer_tokens": 42,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 12, "k": 3, "weight": 2},
+    "easy": {"n": 192, "k": 48, "weight": 41},
+    "medium": {"n": 256, "k": 64, "weight": 55},
+    "hard": {"n": 320, "k": 80, "weight": 69},
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Low-weight dual codewords expose biased parity equations about a selected "
+    "coordinate block of the hidden error."
+)
+PLACEBO_HINT = (
+    "The hexadecimal vectors use least-significant-bit row order, so consistent "
+    "indexing and careful transcription matter."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A strictly increasing JSON list of exactly t distinct zero-based "
+        "indices from 0 through n-1; it is the support of a weight-t binary error."
+    ),
+    "bounds": {
+        "binary_entries": 1,
+        "strictly_increasing": 1,
+        "max_support_size_named_ladder": 69,
+        "max_index_exclusive_named_ladder": 320,
+    },
+}
+
+# Filled from the script-owned hardening transcripts after the three oracle arms.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
+}
+
+NOTES = r"""
+Definition and native objects.  Problem 1.1 and Section 1.1 define binary
+linear-code decoding and immediately rewrite it as fixed-weight syndrome
+decoding: for a full-rank (n-k)-by-n parity-check matrix H and syndrome s,
+find e with |e|=t and H e^T=s^T.  The module hands the solver exactly H (by
+its columns), s, and t.  The hexadecimal representation is only lossless bit
+packing of vectors in F_2^(n-k), not a reduction or discretised analogue.
+
+What produces the certificate.  A uniform full-rank binary matrix is obtained
+by rejection sampling uniform matrices until their exact F_2 rank is n-k.
+Independently, a uniform t-subset is sampled as the support of e.  The syndrome
+is the xor of those columns, so certificate construction costs t vector xors.
+No decoder, Fourier transform, collision search, or information-set search is
+run during generation.
+
+Hard and easy regimes.  Section 1.1 says random codes near the
+Gilbert--Varshamov relative distance delta_GV=h^{-1}(1-R) typically have only
+one decoding solution, whereas above it there are exponentially many.  It also
+states that known generic decoders become polynomial when
+(1-R)/2 <= tau <= (1+R)/2.  The non-demo presets use R=1/4 and
+tau approximately 0.2145=delta_GV(1/4), far below the polynomial band beginning
+at 0.375.  Section 4.1 gives a simple RLPN scale near 2^(k/2), and Propositions
+8--10 analyze exponential RLPN exponents at tau=delta_GV(R).  The paper's
+correctness analysis depends on Assumption 3.1; Conjecture 3.3 weakens that
+model without changing the asymptotic exponent.  This is therefore an
+average-distribution Track A benchmark, not a theorem that P differs from NP.
+
+Step-0 cost comparison.  At shipping size the exact Prange support-containment
+odds are C(144,41)/C(192,41), so even before the invertibility penalty the
+expected number of information sets is about 2^19.5.  Multiplying by the
+limiting probability that a random binary 144-by-144 matrix is invertible gives
+roughly 2.5 million trials.  The paper's simple low-rate RLPN discussion has
+scale 2^(k/2)=2^24.  There is no compact route that is shorter than decoding a
+uniform instance, so the family is not a Track B compression puzzle.
+
+Attacks.  The support is uniform and independent of H, so plant and decoy
+columns have exactly the same marginal distribution.  The outlier attack uses
+column Hamming weight, greedy repeatedly minimizes the residual Hamming weight,
+and random restart samples only legal t-subsets.  The domain attack is Prange
+information-set decoding: choose n-k columns, solve the exact binary system,
+and accept only a weight-t solution.  It is capped at 512 measured trials per
+seed; full RLPN/BJMM/May--Ozerov implementations are outside the standard
+library and are disclosed as README caveats rather than silently claimed run.
+
+Canonicalization.  Arbitrary coordinate renumbering permutes columns and
+carries support indices through the inverse permutation.  canonical_key sorts
+the exact column multiset and retains the syndrome and code parameters.
+selftest checks direct permutations, compositions, carried witnesses, and
+unrelated seeds.  It does not canonicalize arbitrary invertible row-basis
+changes of (H,s), whose combination with column equivalence is the binary code
+equivalence problem; this limitation is explicit in the README.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 250_000
+_PRANGE_TRIALS = 512
+
+
+def _gf2_rank(columns: list[int]) -> int:
+    """Rank of bit-packed column vectors over F_2."""
+    basis: dict[int, int] = {}
+    for value in columns:
+        x = value
+        while x:
+            pivot = x.bit_length() - 1
+            if pivot in basis:
+                x ^= basis[pivot]
+            else:
+                basis[pivot] = x
+                break
+    return len(basis)
+
+
+def _random_full_rank_columns(n: int, rows: int, rng: random.Random) -> tuple[list[int], int]:
+    """Uniform rejection sampling from full-row-rank binary matrices."""
+    for attempt in range(1, 10_001):
+        columns = [rng.getrandbits(rows) for _ in range(n)]
+        if _gf2_rank(columns) == rows:
+            return columns, attempt
+    raise RuntimeError("could not sample a full-rank binary matrix")
+
+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    k: int | None = None,
+    weight: int | None = None,
+    **params: Any,
+) -> dict:
+    """Inverse-generate a random full-distance syndrome-decoding instance."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if k is None:
+        k = n // 4
+    if weight is None:
+        weight = (2145 * n + 5000) // 10_000
+    for name, value in (("n", n), ("k", k), ("weight", weight), ("seed", seed)):
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise ValueError(f"{name} must be an integer")
+    if n < 4:
+        raise ValueError("n must be at least 4")
+    if not 1 <= k < n:
+        raise ValueError("k must satisfy 1 <= k < n")
+    rows = n - k
+    if not 1 <= weight <= rows:
+        raise ValueError("weight must satisfy 1 <= weight <= n-k")
+
+    rng = random.Random(seed)
+    columns, matrix_attempts = _random_full_rank_columns(n, rows, rng)
+    support = sorted(rng.sample(range(n), weight))
+    syndrome = 0
+    for index in support:
+        syndrome ^= columns[index]
+
+    return {
+        "family": "full-distance decoding of a random binary linear code",
+        "paper": "arXiv:2208.02201",
+        "n": n,
+        "k": k,
+        "rows": rows,
+        "weight": weight,
+        "columns": columns,
+        "syndrome": syndrome,
+        "hex_width": (rows + 3) // 4,
+        "matrix_sampling_attempts": matrix_attempts,
+        "answer": support,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render the complete exact decoding problem and output contract."""
+    width = inst["hex_width"]
+    column_lines = "\n".join(
+        f"{index}: {value:0{width}x}"
+        for index, value in enumerate(inst["columns"])
+    )
+    statement = f"""Fixed-weight binary syndrome decoding
+
+All arithmetic is over the binary field F_2, so vector addition is bitwise xor.
+The parity-check matrix H has {inst['rows']} rows and {inst['n']} columns and
+defines a binary linear [n,k]=[{inst['n']},{inst['k']}] code as its null space.
+
+Each column below is one vector in F_2^{inst['rows']}, written as exactly
+{width} hexadecimal digits.  Leading zeroes are significant padding.  Row 0 is
+the least-significant bit, row 1 the next bit, and so on; equivalently, you may
+xor the hexadecimal integers directly.
+
+Find a binary error vector e of Hamming weight exactly {inst['weight']} such that
+H e^T equals the displayed syndrome.  Output its support: exactly
+{inst['weight']} distinct column indices whose xor is the syndrome.
+
+Indices are zero-based from 0 through {inst['n'] - 1}, inclusive.  Repeats are
+forbidden, order does not change the mathematical support, and the required
+serialization is strictly increasing order.  Every datum is exact.
+
+n: {inst['n']}
+k: {inst['k']}
+number of parity-check rows: {inst['rows']}
+required Hamming weight: {inst['weight']}
+syndrome (hex): {inst['syndrome']:0{width}x}
+columns of H (zero-based index: fixed-width hex vector):
+{column_lines}
+
+Give your final answer inside <answer></answer> tags as one JSON list of exactly
+{inst['weight']} strictly increasing integers.
+Example format: <answer>[0, 3, 9]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: object) -> object | None:
+    """Extract the last tagged JSON integer list, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
+    if fence:
+        body = fence.group(1).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list):
+        return None
+    if any(isinstance(item, bool) or not isinstance(item, int) for item in value):
+        return None
+    return value
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any valid weight-t error support; never consult inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    if any(isinstance(index, bool) or not isinstance(index, int) for index in answer):
+        return False, "every support entry must be an integer"
+    if len(set(answer)) != len(answer):
+        return False, "repeated indices are not allowed"
+    if any(index < 0 or index >= inst["n"] for index in answer):
+        return False, f"support index must lie in 0..{inst['n'] - 1}"
+    if answer != sorted(answer):
+        return False, "indices must be in strictly increasing order"
+    if len(answer) != inst["weight"]:
+        return False, f"support must contain exactly {inst['weight']} indices"
+
+    syndrome = 0
+    for index in answer:
+        syndrome ^= inst["columns"][index]
+    if syndrome != inst["syndrome"]:
+        return False, "selected columns do not xor to the syndrome"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the full legal fixed-weight support language."""
+    return sorted(rng.sample(range(inst["n"]), inst["weight"]))
+
+
+def search_space(inst: dict) -> int:
+    """Count all legal fixed-weight binary supports exactly."""
+    return math.comb(inst["n"], inst["weight"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count every valid witness exactly when the legal language is small."""
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    valid = 0
+    for combo in itertools.combinations(range(inst["n"]), inst["weight"]):
+        syndrome = 0
+        for index in combo:
+            syndrome ^= inst["columns"][index]
+        valid += int(syndrome == inst["syndrome"])
+    return valid
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonicalize arbitrary coordinate/column renumberings."""
+    payload = {
+        "n": inst["n"],
+        "k": inst["k"],
+        "rows": inst["rows"],
+        "weight": inst["weight"],
+        "syndrome": inst["syndrome"],
+        "columns": sorted(inst["columns"]),
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Stay at R=1/4 and the GV relative weight while enlarging the code."""
+    clean = {key: value for key, value in params.items() if key != "_preset"}
+    n = int(clean["n"])
+    next_n = n + 64
+    next_k = next_n // 4
+    next_weight = (2145 * next_n + 5000) // 10_000
+    if next_weight > 256:
+        return "cap_bound"
+    return {"n": next_n, "k": next_k, "weight": next_weight}
+
+
+def _outlier_column_weight_attack(inst: dict) -> list[int]:
+    """Choose the columns whose weights are most atypical for a random vector."""
+    twice_rows = 2 * inst["rows"]
+    ranked = sorted(
+        range(inst["n"]),
+        key=lambda index: (
+            -abs(2 * inst["columns"][index].bit_count() - twice_rows // 2),
+            index,
+        ),
+    )
+    return sorted(ranked[: inst["weight"]])
+
+
+def _greedy_residual_attack(inst: dict) -> list[int]:
+    """Repeatedly choose the column making the residual lightest."""
+    residual = inst["syndrome"]
+    available = set(range(inst["n"]))
+    chosen: list[int] = []
+    for _ in range(inst["weight"]):
+        best = min(
+            available,
+            key=lambda index: ((residual ^ inst["columns"][index]).bit_count(), index),
+        )
+        available.remove(best)
+        chosen.append(best)
+        residual ^= inst["columns"][best]
+    return sorted(chosen)
+
+
+def _random_restart_attack(inst: dict, seed: int, restarts: int = 512) -> list[int] | None:
+    rng = random.Random(seed ^ 0x220802201)
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate
+    return None
+
+
+def _solve_selected_columns(
+    columns: list[int], syndrome: int, rows: int
+) -> tuple[int | None, int]:
+    """Solve xor_j x_j*columns[j]=syndrome; return coefficient mask and xor count."""
+    if len(columns) != rows:
+        raise ValueError("selected column set must be square")
+    basis_value = [0] * rows
+    basis_combo = [0] * rows
+    xor_operations = 0
+    for index, column in enumerate(columns):
+        value = column
+        combo = 1 << index
+        while value:
+            pivot = value.bit_length() - 1
+            if basis_value[pivot]:
+                value ^= basis_value[pivot]
+                combo ^= basis_combo[pivot]
+                xor_operations += 2
+            else:
+                basis_value[pivot] = value
+                basis_combo[pivot] = combo
+                break
+        if value == 0:
+            return None, xor_operations
+
+    value = syndrome
+    combo = 0
+    while value:
+        pivot = value.bit_length() - 1
+        if not basis_value[pivot]:
+            return None, xor_operations
+        value ^= basis_value[pivot]
+        combo ^= basis_combo[pivot]
+        xor_operations += 2
+    return combo, xor_operations
+
+
+def _prange_information_set_attack(
+    inst: dict, seed: int, trials: int = _PRANGE_TRIALS
+) -> tuple[list[int] | None, int, int, float]:
+    """Classical Prange ISD, stopped after an explicit measured trial budget."""
+    started = time.perf_counter()
+    rng = random.Random(seed ^ 0x5052414E4745)
+    xor_operations = 0
+    for trial in range(1, trials + 1):
+        selected = rng.sample(range(inst["n"]), inst["rows"])
+        coefficient_mask, cost = _solve_selected_columns(
+            [inst["columns"][index] for index in selected],
+            inst["syndrome"],
+            inst["rows"],
+        )
+        xor_operations += cost
+        if coefficient_mask is None or coefficient_mask.bit_count() != inst["weight"]:
+            continue
+        candidate = sorted(
+            selected[j]
+            for j in range(inst["rows"])
+            if (coefficient_mask >> j) & 1
+        )
+        if verify(inst, candidate)[0]:
+            return candidate, trial, xor_operations, time.perf_counter() - started
+    return None, trials, xor_operations, time.perf_counter() - started
+
+
+def _permute_instance(inst: dict, permutation: list[int]) -> dict:
+    """Apply new-position -> old-position relabelling and carry the support."""
+    if sorted(permutation) != list(range(inst["n"])):
+        raise ValueError("not a coordinate permutation")
+    inverse = [0] * inst["n"]
+    for new, old in enumerate(permutation):
+        inverse[old] = new
+    transformed = dict(inst)
+    transformed["columns"] = [inst["columns"][old] for old in permutation]
+    transformed["answer"] = sorted(inverse[index] for index in inst["answer"])
+    return transformed
+
+
+def _answer_atoms(answer: object) -> int:
+    if isinstance(answer, dict):
+        return sum(_answer_atoms(value) for value in answer.values())
+    if isinstance(answer, list):
+        return sum(_answer_atoms(value) for value in answer)
+    return 1
+
+
+def _worst_case_answer_chars(n: int, weight: int) -> int:
+    answer = list(range(n - weight, n))
+    return len(json.dumps(answer, separators=(",", ":")))
+
+
+def selftest() -> dict:
+    """Run all mandatory construction, hardness, diversity, and size gates."""
+    report: dict[str, object] = {}
+
+    # G1: every named rung, multiple seeds, plus JSON-native answers.
+    g1_failures = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17, 2025):
+            instance = make_instance(seed=seed, **params)
+            ok, reason = verify(instance, instance["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append([preset, seed, reason])
+            if json.loads(json.dumps(instance["answer"])) != instance["answer"]:
+                g1_failures.append([preset, seed, "answer is not JSON-native"])
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=271828, **shipping_params)
+
+    # G2: syntactically different corruptions must reach five distinct reasons.
+    base = list(inst["answer"])
+    swapped = list(base)
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    duplicate = list(base)
+    duplicate[1] = duplicate[0]
+    outside = list(base)
+    outside[-1] = inst["n"]
+    corruptions = {
+        "drop_one": base[:-1],
+        "swap_adjacent": swapped,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": outside,
+    }
+    g2_cases = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        g2_cases[name] = {"rejected": not ok, "reason": reason}
+    reasons = [case["reason"] for case in g2_cases.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(case["rejected"] for case in g2_cases.values())
+        and len(set(reasons)) == 5,
+        "cases": g2_cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    # G3: realistic prose plus a markdown fence inside the required tags.
+    answer_blob = json.dumps(inst["answer"], separators=(",", ":"))
+    response = (
+        "I treated each column as one vector over F_2 and checked the xor.\n"
+        f"<answer>```json\n{answer_blob}\n```</answer>\n"
+        "The list is zero-based and increasing."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == inst["answer"] and verify(inst, parsed)[0],
+        "parsed_exactly": parsed == inst["answer"],
+    }
+
+    # G4/G5: density at the shipping preset under the legal fixed-weight prior.
+    samples = 200_000
+    sample_rng = random.Random(0x220802201)
+    hits = 0
+    density_started = time.perf_counter()
+    for _ in range(samples):
+        if verify(inst, random_candidate(inst, sample_rng))[0]:
+            hits += 1
+    density_elapsed = time.perf_counter() - density_started
+    observed_probability = hits / samples
+    report["G4_guess_resistance"] = {
+        "pass": observed_probability < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": observed_probability,
+        "structure_aware": True,
+        "candidate_space": str(search_space(inst)),
+        "candidate_space_bits": round(math.log2(search_space(inst)), 6),
+        "wall_clock_sec": round(density_elapsed, 6),
+    }
+
+    demo_inst = make_instance(seed=11, **DIFFICULTY["demo"])
+    demo_solution_count = enumerate_all(demo_inst)
+
+    baseline_records = []
+    baseline_successes = 0
+    for seed in range(8):
+        attack_inst = make_instance(seed=10_000 + seed, **shipping_params)
+        candidate, trials, xor_operations, elapsed = _prange_information_set_attack(
+            attack_inst, seed
+        )
+        solved = candidate is not None and verify(attack_inst, candidate)[0]
+        baseline_successes += int(solved)
+        baseline_records.append(
+            {
+                "seed": 10_000 + seed,
+                "solved": solved,
+                "trials": trials,
+                "xor_operations": xor_operations,
+                "wall_clock_sec": round(elapsed, 6),
+            }
+        )
+
+    trial_values = [record["trials"] for record in baseline_records]
+    operation_values = [record["xor_operations"] for record in baseline_records]
+    time_values = [record["wall_clock_sec"] for record in baseline_records]
+    containment_odds = math.comb(inst["n"], inst["weight"]) / math.comb(
+        inst["rows"], inst["weight"]
+    )
+    invertible_probability = math.prod(
+        1.0 - 2.0 ** (-j) for j in range(1, inst["rows"] + 1)
+    )
+    report["G5_density_and_baseline_cost"] = {
+        "pass": observed_probability < 1e-6
+        and baseline_successes == 0
+        and demo_solution_count is not None,
+        "shipping_density_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_observed_fraction": observed_probability,
+        "exact_demo_solution_count": demo_solution_count,
+        "exact_demo_candidate_space": search_space(demo_inst),
+        "baseline_attack": "classical Prange information-set decoding",
+        "baseline_successes": baseline_successes,
+        "baseline_attempts": 8,
+        "baseline_trials_median": int(statistics.median(trial_values)),
+        "baseline_xor_operations_median": int(statistics.median(operation_values)),
+        "baseline_wall_clock_sec_median": round(statistics.median(time_values), 6),
+        "baseline_wall_clock_sec_max": round(max(time_values), 6),
+        "prange_support_containment_expected_trials": round(containment_odds, 3),
+        "random_square_invertible_probability": round(invertible_probability, 9),
+        "prange_estimated_trials_with_invertibility": round(
+            containment_odds / invertible_probability, 3
+        ),
+        "paper_simple_rlpn_scale_2_pow_k_over_2": 2 ** (inst["k"] // 2),
+        "records": baseline_records,
+    }
+
+    # G6: three construction-aware probes and the domain-standard Prange attack.
+    attack_results = {
+        "outlier_column_hamming_weight": {"successes": 0, "attempts": 8},
+        "greedy_residual_hamming_weight": {"successes": 0, "attempts": 8},
+        "random_restart_512": {"successes": 0, "attempts": 8},
+        "prange_information_set_512": {
+            "successes": baseline_successes,
+            "attempts": 8,
+        },
+    }
+    for seed in range(8):
+        attack_inst = make_instance(seed=10_000 + seed, **shipping_params)
+        candidates = {
+            "outlier_column_hamming_weight": _outlier_column_weight_attack(attack_inst),
+            "greedy_residual_hamming_weight": _greedy_residual_attack(attack_inst),
+            "random_restart_512": _random_restart_attack(attack_inst, seed),
+        }
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(attack_inst, candidate)[0]:
+                attack_results[name]["successes"] += 1
+    all_failed = all(result["successes"] == 0 for result in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed,
+        "attacks": attack_results,
+        "domain_attack_trial_cap_per_seed": _PRANGE_TRIALS,
+        "domain_attack_note": (
+            "Classical Prange ISD is exact but capped; full RLPN/BJMM/May-Ozerov "
+            "implementations were not available in the standard-library harness."
+        ),
+    }
+
+    doubled_n = 2 * inst["n"]
+    doubled_params = {
+        "n": doubled_n,
+        "k": doubled_n // 4,
+        "weight": (2145 * doubled_n + 5000) // 10_000,
+    }
+    doubled = make_instance(seed=314159, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["n"] == 2 * inst["n"]
+        and search_space(doubled) > search_space(inst),
+        "base_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "base_weight": inst["weight"],
+        "doubled_weight": doubled["weight"],
+        "base_search_bits": round(math.log2(search_space(inst)), 6),
+        "doubled_search_bits": round(math.log2(search_space(doubled)), 6),
+        "doubled_verification": doubled_reason,
+        "escalation_axes": ["n", "k", "weight"],
+    }
+
+    direct_invariance = 0
+    composed_invariance = 0
+    direct_carried = 0
+    composed_carried = 0
+    unrelated_keys = []
+    for seed in range(20):
+        original = make_instance(seed=30_000 + seed, **shipping_params)
+        original_key = canonical_key(original)
+        unrelated_keys.append(original_key)
+
+        first = list(range(original["n"]))
+        random.Random(seed ^ 0xC0FFEE).shuffle(first)
+        transformed = _permute_instance(original, first)
+        direct_invariance += int(canonical_key(transformed) == original_key)
+        direct_carried += int(verify(transformed, transformed["answer"])[0])
+
+        second = list(range(original["n"]))
+        random.Random(seed ^ 0xBAD5EED).shuffle(second)
+        composed = _permute_instance(transformed, second)
+        composed_invariance += int(canonical_key(composed) == original_key)
+        composed_carried += int(verify(composed, composed["answer"])[0])
+
+    distinct_keys = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": direct_invariance == 20
+        and composed_invariance == 20
+        and direct_carried == 20
+        and composed_carried == 20
+        and distinct_keys == 20,
+        "direct_relabelling_invariance": direct_invariance,
+        "composed_relabelling_invariance": composed_invariance,
+        "direct_valid_carried_witnesses": direct_carried,
+        "composed_valid_carried_witnesses": composed_carried,
+        "distinct_unrelated_keys": distinct_keys,
+        "unrelated_attempts": 20,
+        "key_kind": "sorted exact column multiset plus syndrome and code parameters",
+    }
+
+    answer_chars = len(json.dumps(inst["answer"], separators=(",", ":")))
+    answer_elements = _answer_atoms(inst["answer"])
+    answer_tokens = math.ceil(answer_chars / 4)
+    worst_case_chars = _worst_case_answer_chars(inst["n"], inst["weight"])
+    worst_case_tokens = math.ceil(worst_case_chars / 4)
+    # Once a support is found, reading each index and xoring its packed vector
+    # costs at most two elementary exact operations per entry, plus comparison.
+    intended_operations = 2 * inst["weight"] + 1
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted_attempts = arms["hinted"].get("attempts", 0)
+    placebo_attempts = arms["placebo"].get("attempts", 0)
+    hinted_rate = (
+        arms["hinted"].get("solved", 0) / hinted_attempts if hinted_attempts else 0.0
+    )
+    placebo_rate = (
+        arms["placebo"].get("solved", 0) / placebo_attempts if placebo_attempts else 0.0
+    )
+    within_caps = (
+        answer_chars <= 2_000
+        and answer_elements <= 256
+        and intended_operations <= 300
+        and worst_case_tokens <= PROBLEM_PROFILE["max_answer_tokens"]
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS.get("hinted_verdict", "pending"),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "worst_case_answer_chars": worst_case_chars,
+        "measured_worst_case_answer_tokens": worst_case_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        value.get("pass") is True
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
