+def _permute_features(inst: dict, permutation: list[int]) -> dict:
+    dimension = inst["secret_dimension"]
+    if sorted(permutation) != list(range(dimension)):
+        raise ValueError("not a feature permutation")
+    transformed = dict(inst)
+    transformed["samples"] = [
