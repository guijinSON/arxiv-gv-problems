+    "pass": true,
+    "unrelated_attempts": 20
+  },
+  "G9_no_tool_suitability": {
+    "answer_chars": 142,
+    "answer_elements": 41,
+    "answer_tokens": 36,
+    "arms": {
+      "bare": {
+        "attempts": 0,
+        "solved": 0
+      },
+      "hinted": {
+        "attempts": 0,
+        "solved": 0
+      },
+      "placebo": {
+        "attempts": 0,
+        "solved": 0
+      }
+    },
+    "caps": {
+      "chars": 2000,
+      "elements": 256,
+      "operations": 300
+    },
+    "hinted_minus_placebo": 0.0,
+    "hinted_verdict": "pending",
+    "intended_route_operations": 83,
+    "measured_worst_case_answer_tokens": 42,
+    "pass": true,
+    "within_caps": true,
+    "worst_case_answer_chars": 165
+  },
+  "all_passed": true
+}

