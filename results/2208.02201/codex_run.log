   318	
   319	def verify(inst: dict, answer: object) -> tuple[bool, str]:
   320	    """Check any valid weight-t error support; never consult inst['answer']."""
   321	    if not isinstance(answer, list):
   322	        return False, "answer must be a JSON list"
   323	    if not answer:
   324	        return False, "answer is empty"
   325	    if any(isinstance(index, bool) or not isinstance(index, int) for index in answer):
   326	        return False, "every support entry must be an integer"
   327	    if len(set(answer)) != len(answer):
   328	        return False, "repeated indices are not allowed"
   329	    if any(index < 0 or index >= inst["n"] for index in answer):
   330	        return False, f"support index must lie in 0..{inst['n'] - 1}"
   331	    if answer != sorted(answer):
   332	        return False, "indices must be in strictly increasing order"
   333	    if len(answer) != inst["weight"]:
   334	        return False, f"support must contain exactly {inst['weight']} indices"
   335	
   336	    syndrome = 0
   337	    for index in answer:
   338	        syndrome ^= inst["columns"][index]
   339	    if syndrome != inst["syndrome"]:
   340	        return False, "selected columns do not xor to the syndrome"
   341	    return True, "ok"
