+    duplicate = list(base)
+    duplicate[1] = duplicate[0]
+    outside = list(base)
+    outside[-1] = inst["n"]
+    corruptions = {
+        "drop_one": base[:-1],
+        "swap_adjacent": swapped,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": outside,
