   297	def parse_answer(text: object) -> object | None:
   298	    """Extract the last tagged JSON integer list, tolerating prose and fences."""
   299	    if not isinstance(text, str):
   300	        return None
   301	    matches = _ANSWER_RE.findall(text)
   302	    if not matches:
   303	        return None
   304	    body = matches[-1].strip()
   305	    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
   306	    if fence:
   307	        body = fence.group(1).strip()
   308	    try:
   309	        value = json.loads(body)
   310	    except (TypeError, ValueError):
   311	        return None
   312	    if not isinstance(value, list):
   313	        return None
   314	    if any(isinstance(item, bool) or not isinstance(item, int) for item in value):
   315	        return None
   316	    return value
