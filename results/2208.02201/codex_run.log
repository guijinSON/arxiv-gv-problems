   344	def random_candidate(inst: dict, rng: random.Random) -> object:
   345	    """Uniformly sample the full legal fixed-weight support language."""
   346	    return sorted(rng.sample(range(inst["n"]), inst["weight"]))
   347	
   348	
   349	def search_space(inst: dict) -> int:
   350	    """Count all legal fixed-weight binary supports exactly."""
   351	    return math.comb(inst["n"], inst["weight"])
   352	
   353	
   354	def enumerate_all(inst: dict) -> int | None:
   355	    """Count every valid witness exactly when the legal language is small."""
   356	    if search_space(inst) > _ENUMERATION_CAP:
   357	        return None
   358	    valid = 0
   359	    for combo in itertools.combinations(range(inst["n"]), inst["weight"]):
   360	        syndrome = 0
   361	        for index in combo:
   362	            syndrome ^= inst["columns"][index]
   363	        valid += int(syndrome == inst["syndrome"])
   364	    return valid
