import importlib.util, json, os
p='gen_2208_02201.py'
s=importlib.util.spec_from_file_location('m',p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
assert m.TRACK in ('A','B')
assert list(m.DIFFICULTY)==['demo','easy','medium','hard']
assert m.SHIPPING_DIFFICULTY"'!='"'demo'
inst=m.make_instance(seed=4242,**m.DIFFICULTY[m.SHIPPING_DIFFICULTY])
assert m.verify(inst,inst['answer'])==(True,'ok')
assert json.loads(json.dumps(inst['answer']))==inst['answer']
assert m.parse_answer('<answer>'+json.dumps(inst['answer'])+'</answer>')==inst['answer']
assert m.canonical_key(inst)==m.canonical_key(m.make_instance(seed=4242,**m.DIFFICULTY[m.SHIPPING_DIFFICULTY]))
r=json.load(open('selftest_report.json'))
assert r['all_passed'] and all(v.get('pass') for k,v in r.items() if k.startswith('G'))
assert len(r['G6_adversary_panel']['attacks'])>=4
assert all(v['successes']==0 and v['attempts']>=8 for v in r['G6_adversary_panel']['attacks'].values())
print('static/interface/report checks: pass')
print('render chars:',len(m.render(inst)),'answer chars:',len(json.dumps(inst['answer'],separators=(',',':'))))
