+            (
+                row
+                for row in range(pivot_row, len(augmented))
+                if (augmented[row] >> column) & 1
+            ),
+            None,
+        )
+        if found is None:
+            return None
+        augmented[pivot_row], augmented[found] = augmented[found], augmented[pivot_row]
