   381	def escalate(params: dict) -> dict | str | None:
   382	    """Stay at R=1/4 and the GV relative weight while enlarging the code."""
   383	    clean = {key: value for key, value in params.items() if key != "_preset"}
   384	    n = int(clean["n"])
   385	    next_n = n + 64
   386	    next_k = next_n // 4
   387	    next_weight = (2145 * next_n + 5000) // 10_000
   388	    if next_weight > 256:
   389	        return "cap_bound"
   390	    return {"n": next_n, "k": next_k, "weight": next_weight}
