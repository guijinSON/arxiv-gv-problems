+            feature, response = by_label[(1 << i) | (1 << j)]
+            quadratic_feature = feature ^ singleton_features[i]
+            quadratic_feature ^= singleton_features[j]
+            coefficient = response ^ singleton_responses[i]
+            coefficient ^= singleton_responses[j]
+            operations += 4
