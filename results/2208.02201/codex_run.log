+def _permute_bits(value: int, permutation: list[int]) -> int:
+    """Apply permutation[new position] = old position."""
+    result = 0
+    for new, old in enumerate(permutation):
+        if (value >> old) & 1:
+            result |= 1 << new
+    return result
 
 
