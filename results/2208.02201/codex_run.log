   392	
   393	def _outlier_column_weight_attack(inst: dict) -> list[int]:
   394	    """Choose the columns whose weights are most atypical for a random vector."""
   395	    ranked = sorted(
   396	        range(inst["n"]),
   397	        key=lambda index: (
   398	            -abs(2 * inst["columns"][index].bit_count() - inst["rows"]),
   399	            index,
   400	        ),
   401	    )
   402	    return sorted(ranked[: inst["weight"]])
   403	
   404	
   405	def _greedy_residual_attack(inst: dict) -> list[int]:
   406	    """Repeatedly choose the column making the residual lightest."""
   407	    residual = inst["syndrome"]
   408	    available = set(range(inst["n"]))
   409	    chosen: list[int] = []
   410	    for _ in range(inst["weight"]):
   411	        best = min(
   412	            available,
   413	            key=lambda index: ((residual ^ inst["columns"][index]).bit_count(), index),
   414	        )
   415	        available.remove(best)
   416	        chosen.append(best)
   417	        residual ^= inst["columns"][best]
   418	    return sorted(chosen)
   419	
   420	
   421	def _random_restart_attack(inst: dict, seed: int, restarts: int = 512) -> list[int] | None:
   422	    rng = random.Random(seed ^ 0x220802201)
   423	    for _ in range(restarts):
   424	        candidate = random_candidate(inst, rng)
   425	        if verify(inst, candidate)[0]:
   426	            return candidate
   427	    return None
