-        "full-rank binary parity-check matrix",
-        "binary syndrome",
-        "target Hamming weight",
+        "labeled LPN samples over F_2",
+        "binary secret vector",
+        "exact noise Hamming weight",
     ],
     "verification_operations": [
-        "exact xor of vectors over F_2",
-        "exact Hamming-weight check",
-        "exact syndrome comparison",
+        "exact parity inner product over F_2",
+        "exact xor of binary sample columns",
+        "exact Hamming-distance comparison",
     ],
     "domain_essentiality": "native",
     "reduction_kind": "none",
     "reduction": None,
     "reduction_source": "paper_central",
-    "intuition_type": "duality",
