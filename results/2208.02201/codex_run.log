+        if residual == inst["noise_weight"]:
+            return (
+                _support_from_mask(gray, inst["secret_dimension"]),
+                ordinal,
+                operations,
+                time.perf_counter() - started,
+            )
+        previous_gray = gray
+    return None, search_space(inst), operations, time.perf_counter() - started
