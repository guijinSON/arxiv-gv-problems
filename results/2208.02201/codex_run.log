+def _monomial_vector(x: int, m: int) -> int:
+    """Evaluations of x_i and x_i*x_j (i<j), packed in canonical order."""
+    value = 0
+    for i in range(m):
+        if (x >> i) & 1:
+            value |= 1 << i
+    position = m
+    for i in range(m):
+        for j in range(i + 1, m):
+            if ((x >> i) & 1) and ((x >> j) & 1):
+                value |= 1 << position
+            position += 1
+    return value
 
 
