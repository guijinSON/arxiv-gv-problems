   429	
   430	def _solve_selected_columns(
   431	    columns: list[int], syndrome: int, rows: int
   432	) -> tuple[int | None, int]:
   433	    """Solve xor_j x_j*columns[j]=syndrome; return coefficient mask and xor count."""
   434	    if len(columns) != rows:
   435	        raise ValueError("selected column set must be square")
   436	    basis_value = [0] * rows
   437	    basis_combo = [0] * rows
   438	    xor_operations = 0
   439	    for index, column in enumerate(columns):
   440	        value = column
   441	        combo = 1 << index
   442	        while value:
   443	            pivot = value.bit_length() - 1
   444	            if basis_value[pivot]:
   445	                value ^= basis_value[pivot]
   446	                combo ^= basis_combo[pivot]
   447	                xor_operations += 2
   448	            else:
   449	                basis_value[pivot] = value
   450	                basis_combo[pivot] = combo
   451	                break
   452	        if value == 0:
   453	            return None, xor_operations
   454	
   455	    value = syndrome
   456	    combo = 0
   457	    while value:
   458	        pivot = value.bit_length() - 1
   459	        if not basis_value[pivot]:
   460	            return None, xor_operations
   461	        value ^= basis_value[pivot]
   462	        combo ^= basis_combo[pivot]
   463	        xor_operations += 2
   464	    return combo, xor_operations
   465	
   466	
   467	def _prange_information_set_attack(
   468	    inst: dict, seed: int, trials: int = _PRANGE_TRIALS
   469	) -> tuple[list[int] | None, int, int, float]:
   470	    """Classical Prange ISD, stopped after an explicit measured trial budget."""
   471	    started = time.perf_counter()
   472	    rng = random.Random(seed ^ 0x5052414E4745)
   473	    xor_operations = 0
   474	    for trial in range(1, trials + 1):
   475	        selected = rng.sample(range(inst["n"]), inst["rows"])
   476	        coefficient_mask, cost = _solve_selected_columns(
   477	            [inst["columns"][index] for index in selected],
   478	            inst["syndrome"],
   479	            inst["rows"],
   480	        )
   481	        xor_operations += cost
   482	        if coefficient_mask is None or coefficient_mask.bit_count() != inst["weight"]:
   483	            continue
   484	        candidate = sorted(
   485	            selected[j]
   486	            for j in range(inst["rows"])
   487	            if (coefficient_mask >> j) & 1
   488	        )
   489	        if verify(inst, candidate)[0]:
   490	            return candidate, trial, xor_operations, time.perf_counter() - started
   491	    return None, trials, xor_operations, time.perf_counter() - started
