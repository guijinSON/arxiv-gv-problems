   367	def canonical_key(inst: dict) -> str:
   368	    """Canonicalize arbitrary coordinate/column renumberings."""
   369	    payload = {
   370	        "n": inst["n"],
   371	        "k": inst["k"],
   372	        "rows": inst["rows"],
   373	        "weight": inst["weight"],
   374	        "syndrome": inst["syndrome"],
   375	        "columns": sorted(inst["columns"]),
   376	    }
   377	    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
   378	    return hashlib.sha256(blob.encode("ascii")).hexdigest()
