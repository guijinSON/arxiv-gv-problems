+def _solve_square_rows(rows: list[tuple[int, int]], dimension: int) -> int | None:
+    augmented = [feature | (rhs << dimension) for feature, rhs in rows]
+    pivot_row = 0
+    for column in range(dimension):
+        found = next(
+            (
+                row
+                for row in range(pivot_row, len(augmented))
