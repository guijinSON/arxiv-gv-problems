+        "multiplier": multiplier,
+        "state0": state0,
+        "h_polynomials": h_polynomials,
+        "generators": generators,
+        "base_terms": base_terms,
+        "target_coefficients": _coefficients_json(coefficient_map),
+        "answer_bound": answer_bound,
+        "answer": answer,
+    }
