+4c_{1020}c_{1002}c_{0201}c_{0111}^2+4c_{1101}c_{1002}c_{0120}c_{0111}^2-c_{1101}c_{1011}c_{0111}^3-2c_{1110}c_{1002}c_{0111}^3+c_{2001}c_{0111}^4 \\
+8c_{1011}c_{1002}c_{0210}c_{0120}c_{0102} +4c_{1011}^2c_{0201}c_{0120}c_{0102}-16c_{1101}c_{1002}c_{0120}^2c_{0102} -4c_{1011}^2c_{0210}c_{0111}c_{0102} \\ -8c_{1020}c_{1002}c_{0210}c_{0111}c_{0102}-4c_{1020}c_{1011}c_{0201}c_{0111}c_{0102} 
