+def search_space(inst) -> int | None:
+    """Exact size of the structure-aware bounded certificate language."""
+    form_count = (2 * inst["answer_bound"] + 1) ** 3
+    result = 1
+    for offset in range(5):
+        result *= form_count - offset
+    return result
