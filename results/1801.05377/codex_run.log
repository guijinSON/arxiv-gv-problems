+        form = term["form"]
+        for exponent in _EXPONENTS:
+            multinomial = factorial3
+            value = weight
+            for coordinate, degree in zip(form, exponent):
+                multinomial //= math.factorial(degree)
+                if degree:
+                    value *= coordinate ** degree
+            coefficients[exponent] += multinomial * value
