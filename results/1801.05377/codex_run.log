+    os.path.abspath(__file__)))))
+try:
+    from gvlib import exact_matrices, rationals, sparse_poly
+except ImportError:                 # pragma: no cover - supported fallback
+    exact_matrices = rationals = sparse_poly = None
+
+
+TRACK: str = "B"
+
