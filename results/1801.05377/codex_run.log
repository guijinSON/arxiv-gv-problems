+    product = _product_from_deltas(generators, deltas)
+    answer = _normalise_terms(base_terms, product)
+    coefficient_map = _expand_terms(answer)
+    answer_bound = max(abs(value) for term in answer
+                       for value in term["form"][1:]) + 2
