+def escalate(params) -> dict | str | None:
+    """Double the coordinate-chain haystack while the answer stays five forms."""
+    required = {"n", "modulus", "base_bound", "h_bound"}
+    clean = {key: value for key, value in params.items() if key != "_preset"}
+    if set(clean) != required:
+        return None
+    harder = dict(clean)
+    harder["n"] = 2 * clean["n"]
+    if harder["n"] > (1 << 28):
+        return None
+    return harder
