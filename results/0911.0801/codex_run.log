+def _raw_affine_ansatz_attack(inst: dict) -> list[int]:
+    """Fit affine maps in the displayed rather than the latent labels."""
+    q = inst["domain_size"]
+    roots = []
+    for _a, _b, _c, f1, f2, f3 in _directed_cycles(inst):
+        t1, t2, t3 = f1[0], f2[0], f3[0]
+        s1 = (f1[1] - t1) % q
+        s2 = (f2[1] - t2) % q
+        s3 = (f3[1] - t3) % q
+        slope = (s3 * s2 * s1) % q
+        intercept = (s3 * ((s2 * t1 + t2) % q) + t3) % q
+        root = _one_congruence_root((1 - slope) % q, intercept, q)
+        roots.append(0 if root is None else root)
+    return _candidate_from_roots(inst, roots)
 
