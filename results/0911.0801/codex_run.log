+        variables = tuple(item[1] for item in ordered)
+        required = tuple(item[2] for item in ordered)
+        key = tuple(sorted(variables))
+        negative_parity = ((required[0] == 2) ^ (required[1] == 2) ^ (required[2] == 2))
