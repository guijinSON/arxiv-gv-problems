+def _validate_params(n: int, domain_size: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise ValueError("n must be an integer")
+    if isinstance(domain_size, bool) or not isinstance(domain_size, int):
+        raise ValueError("domain_size must be an integer")
+    if not 1 <= n <= CERTIFICATE_LANGUAGE["bounds"]["max_components"]:
+        raise ValueError("n must be in 1..85")
+    if not 16 <= domain_size <= CERTIFICATE_LANGUAGE["bounds"]["max_domain_size"]:
+        raise ValueError("domain_size must be in 16..16384")
+    if domain_size & (domain_size - 1):
