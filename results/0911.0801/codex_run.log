+def _affine_image(slope: int, intercept: int, modulus: int) -> list[int]:
+    """Conjugate x -> slope*x+intercept by the fixed twist involution."""
+    return [
+        _twist((slope * _twist(x, modulus) + intercept) % modulus, modulus)
+        for x in range(modulus)
+    ]
 
