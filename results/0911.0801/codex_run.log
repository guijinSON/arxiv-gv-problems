+        return False
+    bits = 0
+    for index, value in enumerate(candidate):
+        if value == 1:
+            bits |= 1 << index
+        elif value != 2:
+            return False
+    return all(((bits & mask).bit_count() & 1) == rhs for mask, rhs in masks)
 
 
