+def _make_component(modulus: int, rng: random.Random) -> tuple[list[dict], list[int]]:
+    """Build one triangle and its certificate entirely by identities."""
+    while True:
+        root = rng.randrange(modulus)
+        s1 = rng.randrange(1, modulus, 2)
+        s2 = rng.randrange(1, modulus, 2)
+        product = (s2 * s1) % modulus
+        s3 = (-pow(product, -1, modulus)) % modulus
+        t1 = rng.randrange(modulus)
+        t2 = rng.randrange(modulus)
+        t3 = (2 * root - s3 * ((s2 * t1 + t2) % modulus)) % modulus
+        maps = [
+            _affine_image(s1, t1, modulus),
+            _affine_image(s2, t2, modulus),
+            _affine_image(s3, t3, modulus),
+        ]
+        # This rejects only accidental loss of the intended obfuscation; it
+        # does not search for a satisfying assignment.
+        if all(not _is_raw_affine(image, modulus) for image in maps):
+            break
+
+    latent_b = (s1 * root + t1) % modulus
+    latent_c = (s2 * latent_b + t2) % modulus
