+        negative_parity = ((required[0] == 2) ^ (required[1] == 2) ^ (required[2] == 2))
+        rhs = 1 ^ int(negative_parity)
+        false_bits_by_variable = {v: int(req == 2) for v, req in zip(variables, required)}
