+        a, b, c = vertices
+        f_ab = _map_between(edges, a, b)
+        f_bc = _map_between(edges, b, c)
+        f_ca = _map_between(edges, c, a)
+        monodromy = [f_ca[f_bc[f_ab[x]]] for x in range(q)]
+        component_signatures.append((
+            tuple(edge_types), tuple(sorted(word_types)), _cycle_type(monodromy)
+        ))
