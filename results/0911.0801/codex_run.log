/bin/bash -lc "sed -n '1,260p' ../../scripts/emit.sh; python3 - <<'PY'
import ast, hashlib, importlib.util, io, json, os, contextlib
path='gen_0911_0801.py'
buf=io.StringIO()
with contextlib.redirect_stdout(buf):
 spec=importlib.util.spec_from_file_location('g',path); g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
assert buf.getvalue()==''
p=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
a=g.make_instance(seed=123,**p); b=g.make_instance(seed=123,**p)
assert a==b
assert g.verify(a,a['answer'])==(True,'ok')
assert g.parse_answer('<answer>'+json.dumps(a['answer'])+'</answer>')==a['answer']
