-def _mac_dpll(inst: dict, node_budget: int) -> tuple[list[int] | None, int, int, str]:
-    """Exact DPLL with maintained arc consistency and MRV branching."""
-    n = inst["n"]
-    q = inst["domain_size"]
-    incident, constraints = _incident_data(inst)
-    reverse_support = []
-    for _u, _v, rows in constraints:
-        rev = [0] * q
-        for a, mask in enumerate(rows):
-            for b in range(q):
-                if (mask >> b) & 1:
-                    rev[b] |= 1 << a
-        reverse_support.append(rev)
-    nodes = 0
-    operations = 0
-    exhausted = False
-
-    def propagate(domains: list[int], queue: list[int]) -> bool:
-        nonlocal operations
-        while queue:
-            x = queue.pop()
-            for j in incident[x]:
-                u, v, rows = constraints[j]
-                allowed = 0
-                if x == u:
-                    mask = domains[u]
-                    for a in range(q):
-                        operations += 1
-                        if (mask >> a) & 1:
-                            allowed |= rows[a]
-                    y = v
-                else:
-                    mask = domains[v]
-                    rev = reverse_support[j]
-                    for b in range(q):
-                        operations += 1
-                        if (mask >> b) & 1:
-                            allowed |= rev[b]
-                    y = u
-                narrowed = domains[y] & allowed
-                if not narrowed:
-                    return False
-                if narrowed != domains[y]:
-                    domains[y] = narrowed
-                    queue.append(y)
-        return True
-
-    def recurse(domains: list[int]) -> list[int] | None:
-        nonlocal nodes, exhausted, operations
-        nodes += 1
-        if nodes > node_budget:
-            exhausted = True
-            return None
-        choice = -1
-        best_size = q + 1
-        best_degree = -1
-        for x, mask in enumerate(domains):
-            size = mask.bit_count()
-            if 1 < size < best_size or (
-                size == best_size and size > 1 and len(incident[x]) > best_degree
-            ):
-                choice = x
-                best_size = size
-                best_degree = len(incident[x])
-        if choice < 0:
-            candidate = [mask.bit_length() - 1 for mask in domains]
-            return candidate if verify(inst, candidate)[0] else None
-
-        # Least-constraining-value ordering is a standard CSP heuristic.
-        value_scores = []
-        for value in range(q):
-            if not (domains[choice] >> value) & 1:
-                continue
-            support = 0
-            for j in incident[choice]:
-                u, v, rows = constraints[j]
-                other = v if choice == u else u
-                if choice == u:
-                    support += (rows[value] & domains[other]).bit_count()
-                else:
-                    support += (reverse_support[j][value] & domains[other]).bit_count()
-                operations += 1
-            value_scores.append((-support, value))
-        for _negative_support, value in sorted(value_scores):
-            child = domains[:]
-            child[choice] = 1 << value
-            if propagate(child, [choice]):
-                result = recurse(child)
-                if result is not None:
-                    return result
-                if exhausted:
-                    return None
-        return None
-
-    result = recurse([(1 << q) - 1] * n)
-    status = "solved" if result is not None else ("node_budget" if exhausted else "unsatisfiable")
-    return result, nodes, operations, status
-
-
-def _transpose_rows(rows: list[int], q: int) -> list[int]:
-    transposed = [0] * q
-    for a, mask in enumerate(rows):
-        for b in range(q):
-            if (mask >> b) & 1:
-                transposed[b] |= 1 << a
-    return transposed
-
