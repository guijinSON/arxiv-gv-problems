+def _recover_affine(image: list[int], modulus: int) -> tuple[int, int, int]:
+    """Recover latent slope/intercept and a conservative word-operation count."""
+    out0 = image[0]  # twist(0)
+    out1 = image[1 ^ (modulus // 2)]  # twist(1)
+    intercept = _twist(out0, modulus)
+    at_one = _twist(out1, modulus)
+    slope = (at_one - intercept) % modulus
+    # 2 lookups + two residue-test/high-bit-toggle transforms + subtraction.
+    return slope, intercept, 9
 
 
