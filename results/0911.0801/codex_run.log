-                else:
-                    vals = [z / total for z in vals]
-                new_messages[(x, excluded)] = vals
-        messages = new_messages
-    answer = []
-    # Recompute final factor-to-variable messages once.
-    incoming = {}
-    for j, (u, v, rows) in enumerate(constraints):
-        from_u = messages[(u, j)]
-        from_v = messages[(v, j)]
-        to_v = [0.0] * q
-        to_u = [0.0] * q
-        for a in range(q):
-            for b in range(q):
-                operations += 2
-                if (rows[a] >> b) & 1:
-                    to_v[b] += from_u[a]
-                    to_u[a] += from_v[b]
-        incoming[(j, v)] = to_v
-        incoming[(j, u)] = to_u
-    for x in range(n):
-        vals = [1.0] * q
-        for j in incident[x]:
