+            if len(choices) != 1:
+                raise ValueError("pair-overlap core is not a simple cycle")
+            nxt = next(iter(choices))
+            if nxt == start:
+                break
+            if nxt in order:
+                raise ValueError("pair-overlap cycle closes too early")
+            order.append(nxt)
+        if len(order) != len(core) or start not in adjacency[order[-1]]:
