+def _boundary_probe_attack(inst: dict) -> list[int] | None:
+    """Try four conspicuous roots independently in every component."""
+    q = inst["domain_size"]
+    chosen = []
+    for _a, _b, _c, f_ab, f_bc, f_ca in _directed_cycles(inst):
+        found = None
+        for root in (0, 1, q // 2, q - 1):
+            if f_ca[f_bc[f_ab[root]]] == root:
+                found = root
+                break
+        if found is None:
+            return None
+        chosen.append(found)
+    return _candidate_from_roots(inst, chosen)
