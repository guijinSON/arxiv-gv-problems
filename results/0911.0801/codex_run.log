+def _directed_cycles(inst: dict) -> list[tuple[int, int, int, list[int], list[int], list[int]]]:
+    """Return components as a->b->c->a, canonically rooted at min vertex."""
+    outgoing: dict[int, tuple[int, list[int]]] = {}
+    incoming: dict[int, int] = {}
+    for constraint in inst["constraints"]:
+        u, v = constraint["scope"]
+        if u in outgoing or v in incoming:
+            raise ValueError("instance is not a disjoint union of directed cycles")
+        outgoing[u] = (v, constraint["image"])
+        incoming[v] = u
+    if len(outgoing) != inst["variable_count"]:
+        raise ValueError("a variable is missing an outgoing constraint")
+    unseen = set(range(inst["variable_count"]))
+    cycles = []
+    while unseen:
+        a = min(unseen)
+        b, f_ab = outgoing[a]
+        c, f_bc = outgoing[b]
+        back, f_ca = outgoing[c]
+        if back != a or len({a, b, c}) != 3:
+            raise ValueError("a component is not a directed triangle")
+        unseen.difference_update((a, b, c))
+        cycles.append((a, b, c, f_ab, f_bc, f_ca))
+    return cycles
+
+
+def _candidate_from_roots(inst: dict, roots: list[int]) -> list[int]:
+    cycles = _directed_cycles(inst)
+    if len(roots) != len(cycles):
+        raise ValueError("wrong number of component roots")
+    answer = [0] * inst["variable_count"]
+    for root, (a, b, c, f_ab, f_bc, _f_ca) in zip(roots, cycles):
+        answer[a] = root
+        answer[b] = f_ab[root]
+        answer[c] = f_bc[answer[b]]
+    return answer
+
