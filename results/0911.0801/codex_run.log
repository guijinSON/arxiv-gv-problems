+def _find_duplicate_corruption(inst: dict, avoided_reason: str = "") -> list[int]:
+    """Replace one entry by a duplicate while preserving the required length."""
+    answer = inst["answer"][:]
+    for source in range(len(answer)):
+        for target in range(len(answer)):
+            if source == target or answer[source] == answer[target]:
+                continue
+            candidate = answer[:]
+            candidate[target] = answer[source]
+            ok, reason = verify(inst, candidate)
+            if not ok and reason != avoided_reason:
+                return candidate
+    raise AssertionError("could not make a rejected duplicate corruption")
+
