+def _recover_xor_equations(inst: dict) -> tuple[list[tuple[tuple[str, str, str], int]], int]:
+    """Recover XOR rows from relation tables and selector neighborhoods."""
+    groups, error = _selector_descriptions(inst)
+    if error:
