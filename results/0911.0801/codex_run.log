+def _canonical_invariant(inst: dict) -> dict:
+    component_signatures = []
+    q = inst["domain_size"]
+    for vertices, edges in _undirected_components(inst):
+        if len(vertices) != 3 or len(edges) != 3:
+            raise ValueError("canonical form expects triangle components")
+        maps = [c["image"] for c in edges]
+        edge_types = sorted(_cycle_type(image) for image in maps)
+        # Cycle types of the individual maps alone can collide for affine
+        # permutations.  The multiset of all signed two-map words remains
+        # invariant under edge permutation, simultaneous domain conjugation,
+        # and reversal of every scope, while sharply separating unrelated
+        # relation systems.
+        signed_maps = maps + [_invert_image(image) for image in maps]
+        word_types = []
+        for first in signed_maps:
+            for second in signed_maps:
+                word_types.append(_cycle_type(
+                    [second[first[x]] for x in range(q)]
+                ))
+        a, b, c = vertices
+        f_ab = _map_between(edges, a, b)
+        f_bc = _map_between(edges, b, c)
+        f_ca = _map_between(edges, c, a)
+        monodromy = [f_ca[f_bc[f_ab[x]]] for x in range(q)]
+        component_signatures.append((
+            tuple(edge_types), tuple(sorted(word_types)), _cycle_type(monodromy)
+        ))
+    return {"q": q, "components": sorted(component_signatures)}
