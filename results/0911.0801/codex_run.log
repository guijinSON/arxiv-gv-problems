+def _map_between(edges: list[dict], u: int, v: int) -> list[int]:
+    for constraint in edges:
+        a, b = constraint["scope"]
+        if (a, b) == (u, v):
+            return constraint["image"]
+        if (a, b) == (v, u):
+            return _invert_image(constraint["image"])
+    raise ValueError("component is missing an edge")
