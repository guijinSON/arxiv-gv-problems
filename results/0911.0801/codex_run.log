+    y_targets = ([f"Q{value:07d}" for value in
+                  rng.sample(range(9_000_000), len(old_y))]
+                 if "selector" in modes else old_y)
+    rename = dict(zip(old_x + old_y, x_targets + y_targets))
 
+    relation_names = list(out["relations"])
+    new_relation_names = (
