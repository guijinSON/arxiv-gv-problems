    _axes |= set(re.findall(r"\bp(?:arams)?\[[\"']([a-z_][a-z0-9_]*)[\"']\]", _esc))
    _axes.discard("_preset")
    if _axes and _axes <= {"n"} and "cap_bound" not in _esc:
