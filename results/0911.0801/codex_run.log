index 0000000000000000000000000000000000000000..3b700fa280bb2dfe4c343ca056707fc63b10413a
--- /dev/null
+++ b/gen_0911_0801.py
@@ -0,0 +1,1032 @@
+"""Balanced-table binary CSP generator grounded in arXiv:0911.0801.
+
+The paper defines CSP instances as variables, a common domain, and explicitly
+listed allowed tuples (Definition 2.1), then proves an ETH lower bound for
+bounded-arity classes of unbounded width (Theorems 1.2 and 7.1).  This module
+inverse-generates a satisfying assignment and binary relation tables around it.
+Every table is biregular, so the planted value has exactly the same one-edge
+support statistics as every decoy value.
+
+Generation never solves an instance.  Verification is an exact scan of table
+membership.  The module is deterministic in (n, seed, params), uses only the
+standard library, performs no file or network I/O, and is silent on import.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from typing import Any
+
+
+TRACK = "A"
+
+PROBLEM_PROFILE = {
+    "native_domain": "logic",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "finite-domain CSP variables",
+        "binary constraint relations represented by exact row bitsets",
+    ],
+    "verification_operations": [
+        "integer range comparison",
+        "exact allowed-tuple membership by bit lookup",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "constraint propagation",
+    "intuition_description": (
+        "Only cycle consistency distinguishes the satisfying values because "
+        "every individual relation has identical row and column degrees; "
+        "without propagating coupled domains, local frequencies give no clue."
+    ),
+    "hardness_basis": (
+        "Track A: Theorem 1.2 covers bounded-arity CSP classes of unbounded "
+        "treewidth (and Theorem 7.1 strengthens this using unbounded submodular "
+        "width); shipping uses binary constraints on a sparse, growing-width "
+        "random-core regime with q=16 and balanced density 1/2, for which no "
+        "efficient algorithm is known on this generated distribution, and G5 "
+        "reports the measured MAC/DPLL node and wall-clock cost."
+    ),
+    # Compact JSON is at most 217 characters for 72 values in 0..15; this
+    # conservative four-characters/token conversion rounds upward.
+    "max_answer_tokens": 55,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 6, "domain_size": 4, "relation_degree": 2,
+             "edge_multiplier": 2},
+    "easy": {"n": 72, "domain_size": 16, "relation_degree": 8,
+             "edge_multiplier": 5},
+    "medium": {"n": 96, "domain_size": 16, "relation_degree": 8,
+               "edge_multiplier": 5},
+    "hard": {"n": 128, "domain_size": 16, "relation_degree": 8,
+             "edge_multiplier": 5},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The satisfying values are distinguished only by consistency around cycles; "
+    "each individual relation has perfectly equal row and column degrees."
+)
+PLACEBO_HINT = (
+    "The satisfying values should be checked carefully across the displayed "
+    "constraints; each relation uses a compact row-bitset representation."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON array of exactly n integers, one value in 0..q-1 for each "
+        "variable in index order; q <= 32 and n <= 512."
+    ),
+    "bounds": {
+        "max_variables": 512,
+        "max_domain_size": 32,
+        "min_value": 0,
+        "max_value": 31,
+    },
+}
+
+NOTES = r"""
+Paper grounding and Step 0.  Definition 2.1 fixes the exact object used here:
+a CSP instance is (V,D,C), every constraint is a scope plus an allowed relation,
+and a solution is a function V -> D whose tuple belongs to every relation.  The
+paper explicitly assumes relations are represented by listing allowed tuples.
+For a fixed binary domain, the row-bitsets rendered here are merely that same
+table representation with each row's listed set encoded losslessly as bits.
+
+The easy and hard regimes.  Section 4, especially Theorem 4.1, gives an FPT
+algorithm for bounded submodular width by consistency enforcement, uniform
+splitting, and adaptive tree decompositions.  Theorem 1.1 says that for bounded
+arity, bounded treewidth is the tractable structural boundary (subject to the
+stated parameterized-complexity assumption); Theorem 1.2 gives the sharper ETH
+lower bound.  Theorem 7.1 gives the paper's unbounded-submodular-width ETH lower
+bound.  Our sparse graph core grows with n and is not a bounded-width family.
+The theorem is worst-case evidence only: it does not prove this inverse-planted
+distribution hard.  The distributional claim is therefore limited to the
+explicit adversary measurements in selftest and the external oracle transcript.
+
+What produces the certificate.  The assignment is sampled first.  For every
+constraint, independent random row and column permutations hide a circulant
+biregular relation, and the permitted shifts include the planted pair.  Thus the
+certificate is known before the instance exists.  No CSP, SAT, treewidth,
+consistency, or search algorithm runs during generation.
+
+Attack resistance.  Every row and every column of every q-by-q relation has
+exactly relation_degree allowed tuples, so support-count and degree outliers tie
+on every value.  Variable order and constraint order are randomized by the seed.
+The greedy attack uses assigned-neighbor compatibility, min-conflicts uses local
+repair, and loopy belief propagation tests whether small biases amplify through
+cycles.  The domain-standard attack is exact DPLL with maintained arc
+consistency and a measured node cap.  Plants and decoys are not sampled as two
+different tuple populations: after marginalizing over the uniformly sampled
+plant value, every value label has the same local distribution.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 1_000_000
+_PANEL_NODE_BUDGET = 2_000
+_BASELINE_NODE_BUDGET = 5_000
+_ORACLE_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _validate_params(n: int, domain_size: int, relation_degree: int,
+                     edge_multiplier: int) -> None:
+    values = (n, domain_size, relation_degree, edge_multiplier)
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in values):
+        raise ValueError("n, domain_size, relation_degree, and edge_multiplier must be integers")
+    if not 4 <= n <= CERTIFICATE_LANGUAGE["bounds"]["max_variables"]:
+        raise ValueError("n must be in 4..512")
+    if not 4 <= domain_size <= CERTIFICATE_LANGUAGE["bounds"]["max_domain_size"]:
+        raise ValueError("domain_size must be in 4..32")
+    if not 1 <= relation_degree < domain_size:
+        raise ValueError("relation_degree must be in 1..domain_size-1")
+    if not 2 <= edge_multiplier:
+        raise ValueError("edge_multiplier must be at least 2")
+    if edge_multiplier * n > n * (n - 1) // 2:
+        raise ValueError("too many constraints requested for a simple binary scope graph")
+
+
+def _permutation_sending_to_zero(size: int, distinguished: int,
+                                 rng: random.Random) -> list[int]:
+    """A uniform permutation p conditional on p[distinguished] == 0."""
+    rest = [x for x in range(size) if x != distinguished]
+    rng.shuffle(rest)
+    p = [0] * size
+    p[distinguished] = 0
+    for label, value in enumerate(rest, 1):
+        p[value] = label
+    return p
+
+
+def _relation_rows(size: int, degree: int, planted_left: int,
+                   planted_right: int, rng: random.Random) -> list[int]:
+    """Make a biregular relation of row/column degree ``degree``.
+
+    Independent private permutations hide a circulant bipartite graph.  Shift
+    zero is included, so the two values mapped to zero form an allowed pair.
+    """
+    left = _permutation_sending_to_zero(size, planted_left, rng)
+    right = _permutation_sending_to_zero(size, planted_right, rng)
+    shifts = {0}
+    shifts.update(rng.sample(range(1, size), degree - 1))
+    rows = [0] * size
+    for a in range(size):
+        mask = 0
+        for b in range(size):
+            if (right[b] - left[a]) % size in shifts:
+                mask |= 1 << b
+        rows[a] = mask
+    return rows
+
+
+def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
+    """Inverse-generate a finite-domain binary CSP with a known assignment."""
+    unknown = set(params) - {"domain_size", "relation_degree", "edge_multiplier"}
+    if unknown:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(unknown)))
+    domain_size = params.get("domain_size", 16)
+    relation_degree = params.get("relation_degree", domain_size // 2)
+    edge_multiplier = params.get("edge_multiplier", 5)
+    _validate_params(n, domain_size, relation_degree, edge_multiplier)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    planted = [rng.randrange(domain_size) for _ in range(n)]
+
+    # A Hamiltonian cycle prevents isolated pieces.  Remaining scopes are drawn
+    # uniformly without replacement; their order is shuffled before relations
+    # are sampled so index order carries no construction phase information.
+    edges: set[tuple[int, int]] = set()
+    cycle_order = list(range(n))
+    rng.shuffle(cycle_order)
+    for i, u in enumerate(cycle_order):
+        v = cycle_order[(i + 1) % n]
+        edges.add((u, v) if u < v else (v, u))
+    target = edge_multiplier * n
+    while len(edges) < target:
+        u, v = rng.sample(range(n), 2)
+        edges.add((u, v) if u < v else (v, u))
+    edge_list = list(edges)
+    rng.shuffle(edge_list)
+
+    constraints = []
+    for u, v in edge_list:
+        rows = _relation_rows(domain_size, relation_degree,
+                              planted[u], planted[v], rng)
+        constraints.append({"scope": [u, v], "rows": rows})
+    rng.shuffle(constraints)
+    return {
+        "n": n,
+        "domain_size": domain_size,
+        "relation_degree": relation_degree,
+        "edge_multiplier": edge_multiplier,
+        "constraints": constraints,
+        "answer": planted,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render a complete, standalone CSP statement and exact output contract."""
+    n = inst["n"]
+    q = inst["domain_size"]
+    degree = inst["relation_degree"]
+    width = (q + 3) // 4
+    lines = [
+        "Balanced-table binary constraint satisfaction",
+        "",
+        f"There are {n} variables x0,...,x{n - 1}.  Each variable must receive",
+        f"one integer from the common domain D = {{0,1,...,{q - 1}}}.",
+        "",
+        "A binary constraint Cj has a scope (xu,xv) and an allowed relation.",
+        "Its relation is displayed as one hexadecimal bit mask for each possible",
+        "value a of xu, in order a=0,1,... .  Bit b of row mask a is 1 exactly",
+        "when the ordered pair (a,b) is allowed for (xu,xv).  The least",
+        "significant bit is bit 0; leading zeroes are significant only as padding.",
+        f"Every displayed relation has exactly {degree} set bits in every row and",
+        f"exactly {degree} set bits in every column.  A complete assignment is",
+        "valid iff its ordered value pair is allowed by every constraint.",
+        "Constraint order has no mathematical significance.",
+        "",
+        "Constraints (identifier: left right : row masks for left values 0 upward):",
+    ]
+    for j, constraint in enumerate(inst["constraints"]):
+        u, v = constraint["scope"]
+        masks = " ".join(f"{row:0{width}x}" for row in constraint["rows"])
+        lines.append(f"C{j}: x{u} x{v} : {masks}")
+    lines.extend([
+        "",
+        f"Return exactly {n} integers in variable order x0 through x{n - 1},",
+        f"each inclusively between 0 and {q - 1}.  Repetitions are allowed; the",
+        "array order is fixed and is not a set or a permutation.",
+        "",
+        "Give your final answer inside <answer></answer> tags, as a JSON array",
+        "of decimal integers with no ellipsis.",
+        "Syntax-only example: <answer>[0, 1, 2]</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract a JSON integer array from tagged solver output; never raise."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list):
+        return None
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in value):
+        return None
+    return value
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any assignment by exact tuple membership; never inspect the plant."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if not answer:
+        return False, "assignment must not be empty"
+    n = inst["n"]
+    if len(answer) < n:
+        return False, f"assignment has {n - len(answer)} missing entries"
+    if len(answer) > n:
+        return False, f"assignment has {len(answer) - n} extra entries"
+    q = inst["domain_size"]
+    for i, value in enumerate(answer):
+        if isinstance(value, bool) or not isinstance(value, int):
+            return False, f"value at position {i} is not an integer"
+        if not 0 <= value < q:
+            return False, f"value at position {i} is outside 0..{q - 1}"
+    for j, constraint in enumerate(inst["constraints"]):
+        u, v = constraint["scope"]
+        if not (constraint["rows"][answer[u]] >> answer[v]) & 1:
+            return False, (
+                f"constraint C{j} on (x{u},x{v}) rejects "
+                f"({answer[u]},{answer[v]})"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from the statement-aware space D^n."""
+    return [rng.randrange(inst["domain_size"]) for _ in range(inst["n"])]
+
+
+def search_space(inst: dict) -> int | None:
+    """The exact size of the bounded assignment language for this instance."""
+    return inst["domain_size"] ** inst["n"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count all solutions exactly when D^n is below a strict work cap."""
+    space = search_space(inst)
+    if space is None or space > _ENUMERATION_CAP:
+        return None
+    count = 0
+    q = inst["domain_size"]
+    for candidate in itertools.product(range(q), repeat=inst["n"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def _graph_invariant(inst: dict) -> dict:
+    """A relabeling-invariant fingerprint of the primal graph.
+
+    It is intentionally derived from structure rather than seed or rendering.
+    Color refinement is not a complete isomorphism canonical form, but random
+    sparse cores are separated reliably; this limitation is stated in README.
+    """
+    n = inst["n"]
+    adj = [set() for _ in range(n)]
+    for constraint in inst["constraints"]:
+        u, v = constraint["scope"]
+        adj[u].add(v)
+        adj[v].add(u)
+    degrees = [len(x) for x in adj]
+    colors = degrees[:]
+    for _ in range(6):
+        signatures = [(colors[v], tuple(sorted(colors[w] for w in adj[v])))
+                      for v in range(n)]
+        palette = {sig: i for i, sig in enumerate(sorted(set(signatures)))}
+        new_colors = [palette[sig] for sig in signatures]
+        if new_colors == colors:
+            break
+        colors = new_colors
+    edge_common = []
+    edge_color_pairs = []
+    for u in range(n):
+        for v in adj[u]:
+            if u < v:
+                edge_common.append(len(adj[u] & adj[v]))
+                edge_color_pairs.append(tuple(sorted((colors[u], colors[v]))))
+    triangle_at = []
+    for u in range(n):
+        twice = sum(len(adj[v] & adj[u]) for v in adj[u])
+        triangle_at.append(twice // 2)
+    class_sizes: dict[int, int] = {}
+    for color in colors:
+        class_sizes[color] = class_sizes.get(color, 0) + 1
+    return {
+        "n": n,
+        "m": sum(degrees) // 2,
+        "degree_sequence": sorted(degrees),
+        "triangle_profile": sorted(triangle_at),
+        "edge_common_neighbors": sorted(edge_common),
+        "refinement_classes": sorted(class_sizes.values()),
+        "refined_edge_pairs": sorted(edge_color_pairs),
+    }
+
+
+def canonical_key(inst: dict) -> str:
+    """Return a deterministic cheap invariant under CSP relabelings."""
+    payload = json.dumps(_graph_invariant(inst), sort_keys=True,
+                         separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Raise branching entropy first, then density, before lengthening output."""
+    p = {k: v for k, v in params.items() if k != "_preset"}
+    q = int(p.get("domain_size", 16))
+    if q < 24:
+        q += 2
+        p["domain_size"] = q
+        p["relation_degree"] = q // 2
+        return p
+    if int(p.get("edge_multiplier", 5)) < 7:
+        p["edge_multiplier"] = int(p.get("edge_multiplier", 5)) + 1
+        return p
+    if int(p.get("n", 0)) < 256:
+        p["n"] = min(256, int(p["n"]) + 32)
+        return p
+    return "cap_bound"
+
+
+def _incident_data(inst: dict) -> tuple[list[list[int]], list[tuple[int, int, list[int]]]]:
+    n = inst["n"]
+    incident = [[] for _ in range(n)]
+    constraints = []
+    for j, constraint in enumerate(inst["constraints"]):
+        u, v = constraint["scope"]
+        rows = constraint["rows"]
+        constraints.append((u, v, rows))
+        incident[u].append(j)
+        incident[v].append(j)
+    return incident, constraints
+
+
+def _outlier_attack(inst: dict) -> list[int]:
+    """Choose each value with greatest one-edge support (ties lexicographic)."""
+    q = inst["domain_size"]
+    incident, constraints = _incident_data(inst)
+    answer = []
+    for x in range(inst["n"]):
+        score = [0] * q
+        for j in incident[x]:
+            u, v, rows = constraints[j]
+            if x == u:
+                for a in range(q):
+                    score[a] += rows[a].bit_count()
+            else:
+                for b in range(q):
+                    score[b] += sum((rows[a] >> b) & 1 for a in range(q))
+        answer.append(max(range(q), key=lambda a: (score[a], -a)))
+    return answer
+
+
+def _greedy_attack(inst: dict) -> list[int]:
+    """Highest-degree first, maximizing compatibility with assigned neighbors."""
+    n = inst["n"]
+    q = inst["domain_size"]
+    incident, constraints = _incident_data(inst)
+    order = sorted(range(n), key=lambda x: (-len(incident[x]), x))
+    answer = [-1] * n
+    for x in order:
+        scores = [0] * q
+        for value in range(q):
+            for j in incident[x]:
+                u, v, rows = constraints[j]
+                other = v if x == u else u
+                if answer[other] < 0:
+                    continue
+                allowed = ((rows[value] >> answer[other]) & 1) if x == u else (
+                    (rows[answer[other]] >> value) & 1
+                )
+                scores[value] += allowed
+        answer[x] = max(range(q), key=lambda a: (scores[a], -a))
+    return answer
+
+
+def _min_conflicts_attack(inst: dict, rng: random.Random,
+                          restarts: int = 8, steps: int = 400) -> tuple[list[int] | None, int]:
+    n = inst["n"]
+    q = inst["domain_size"]
+    incident, constraints = _incident_data(inst)
+    operations = 0
+    for _ in range(restarts):
+        answer = [rng.randrange(q) for _ in range(n)]
+        for _step in range(steps):
+            violated = []
+            for j, (u, v, rows) in enumerate(constraints):
+                operations += 1
+                if not (rows[answer[u]] >> answer[v]) & 1:
+                    violated.append(j)
+            if not violated:
+                return answer, operations
+            j = rng.choice(violated)
+            u, v, _rows = constraints[j]
+            x = u if rng.randrange(2) == 0 else v
+            best_values = []
+            best_bad = len(incident[x]) + 1
+            old = answer[x]
+            for value in range(q):
+                answer[x] = value
+                bad = 0
+                for k in incident[x]:
+                    a, b, rows = constraints[k]
+                    operations += 1
+                    if not (rows[answer[a]] >> answer[b]) & 1:
+                        bad += 1
+                if bad < best_bad:
+                    best_bad = bad
+                    best_values = [value]
+                elif bad == best_bad:
+                    best_values.append(value)
+            answer[x] = rng.choice(best_values) if best_values else old
+    return None, operations
+
+
+def _belief_propagation_attack(inst: dict, iterations: int = 8) -> tuple[list[int], int]:
+    """Loopy sum-product from deterministic tiny nonuniform messages."""
+    n = inst["n"]
+    q = inst["domain_size"]
+    incident, constraints = _incident_data(inst)
+    messages: dict[tuple[int, int], list[float]] = {}
+    for j, (u, v, _rows) in enumerate(constraints):
+        for x in (u, v):
+            raw = [1.0 + (((x + 1) * (a + 3) * 2654435761 + j) % 17) * 1e-4
+                   for a in range(q)]
+            total = sum(raw)
+            messages[(x, j)] = [z / total for z in raw]
+    operations = 0
+    for _ in range(iterations):
+        incoming: dict[tuple[int, int], list[float]] = {}
+        for j, (u, v, rows) in enumerate(constraints):
+            from_u = messages[(u, j)]
+            from_v = messages[(v, j)]
+            to_v = [0.0] * q
+            to_u = [0.0] * q
+            for a in range(q):
+                mask = rows[a]
+                for b in range(q):
+                    operations += 2
+                    if (mask >> b) & 1:
+                        to_v[b] += from_u[a]
+                        to_u[a] += from_v[b]
+            incoming[(j, v)] = to_v
+            incoming[(j, u)] = to_u
+        new_messages = {}
+        for x in range(n):
+            for excluded in incident[x]:
+                vals = [1.0] * q
+                for j in incident[x]:
+                    if j == excluded:
+                        continue
+                    inc = incoming[(j, x)]
+                    for a in range(q):
+                        vals[a] *= max(inc[a], 1e-300)
+                        operations += 1
+                total = sum(vals)
+                if not math.isfinite(total) or total == 0.0:
+                    vals = [1.0 / q] * q
+                else:
+                    vals = [z / total for z in vals]
+                new_messages[(x, excluded)] = vals
+        messages = new_messages
+    answer = []
+    # Recompute final factor-to-variable messages once.
+    incoming = {}
+    for j, (u, v, rows) in enumerate(constraints):
+        from_u = messages[(u, j)]
+        from_v = messages[(v, j)]
+        to_v = [0.0] * q
+        to_u = [0.0] * q
+        for a in range(q):
+            for b in range(q):
+                operations += 2
+                if (rows[a] >> b) & 1:
+                    to_v[b] += from_u[a]
+                    to_u[a] += from_v[b]
+        incoming[(j, v)] = to_v
+        incoming[(j, u)] = to_u
+    for x in range(n):
+        vals = [1.0] * q
+        for j in incident[x]:
+            inc = incoming[(j, x)]
+            for a in range(q):
+                vals[a] *= max(inc[a], 1e-300)
+                operations += 1
+        answer.append(max(range(q), key=lambda a: (vals[a], -a)))
+    return answer, operations
+
+
+def _mac_dpll(inst: dict, node_budget: int) -> tuple[list[int] | None, int, int, str]:
+    """Exact DPLL with maintained arc consistency and MRV branching."""
+    n = inst["n"]
+    q = inst["domain_size"]
+    incident, constraints = _incident_data(inst)
+    reverse_support = []
+    for _u, _v, rows in constraints:
+        rev = [0] * q
+        for a, mask in enumerate(rows):
+            for b in range(q):
+                if (mask >> b) & 1:
+                    rev[b] |= 1 << a
+        reverse_support.append(rev)
+    nodes = 0
+    operations = 0
+    exhausted = False
+
+    def propagate(domains: list[int], queue: list[int]) -> bool:
+        nonlocal operations
+        while queue:
+            x = queue.pop()
+            for j in incident[x]:
+                u, v, rows = constraints[j]
+                allowed = 0
+                if x == u:
+                    mask = domains[u]
+                    for a in range(q):
+                        operations += 1
+                        if (mask >> a) & 1:
+                            allowed |= rows[a]
+                    y = v
+                else:
+                    mask = domains[v]
+                    rev = reverse_support[j]
+                    for b in range(q):
+                        operations += 1
+                        if (mask >> b) & 1:
+                            allowed |= rev[b]
+                    y = u
+                narrowed = domains[y] & allowed
+                if not narrowed:
+                    return False
+                if narrowed != domains[y]:
+                    domains[y] = narrowed
+                    queue.append(y)
+        return True
+
+    def recurse(domains: list[int]) -> list[int] | None:
+        nonlocal nodes, exhausted, operations
+        nodes += 1
+        if nodes > node_budget:
+            exhausted = True
+            return None
+        choice = -1
+        best_size = q + 1
+        best_degree = -1
+        for x, mask in enumerate(domains):
+            size = mask.bit_count()
+            if 1 < size < best_size or (
+                size == best_size and size > 1 and len(incident[x]) > best_degree
+            ):
+                choice = x
+                best_size = size
+                best_degree = len(incident[x])
+        if choice < 0:
+            candidate = [mask.bit_length() - 1 for mask in domains]
+            return candidate if verify(inst, candidate)[0] else None
+
+        # Least-constraining-value ordering is a standard CSP heuristic.
+        value_scores = []
+        for value in range(q):
+            if not (domains[choice] >> value) & 1:
+                continue
+            support = 0
+            for j in incident[choice]:
+                u, v, rows = constraints[j]
+                other = v if choice == u else u
+                if choice == u:
+                    support += (rows[value] & domains[other]).bit_count()
+                else:
+                    support += (reverse_support[j][value] & domains[other]).bit_count()
+                operations += 1
+            value_scores.append((-support, value))
+        for _negative_support, value in sorted(value_scores):
+            child = domains[:]
+            child[choice] = 1 << value
+            if propagate(child, [choice]):
+                result = recurse(child)
+                if result is not None:
+                    return result
+                if exhausted:
+                    return None
+        return None
+
+    result = recurse([(1 << q) - 1] * n)
+    status = "solved" if result is not None else ("node_budget" if exhausted else "unsatisfiable")
+    return result, nodes, operations, status
+
+
+def _transpose_rows(rows: list[int], q: int) -> list[int]:
+    transposed = [0] * q
+    for a, mask in enumerate(rows):
+        for b in range(q):
+            if (mask >> b) & 1:
+                transposed[b] |= 1 << a
+    return transposed
+
+
+def _relabel_instance(inst: dict, vertex_perm: list[int],
+                      value_perms: list[list[int]] | None = None,
+                      reverse_constraints: bool = False) -> dict:
+    """Carry an instance and its witness through true CSP isomorphisms."""
+    n = inst["n"]
+    q = inst["domain_size"]
+    if value_perms is None:
+        value_perms = [list(range(q)) for _ in range(n)]
+    answer = [0] * n
+    for old in range(n):
+        answer[vertex_perm[old]] = value_perms[old][inst["answer"][old]]
+    transformed = []
+    for constraint in inst["constraints"]:
+        old_u, old_v = constraint["scope"]
+        rows = [0] * q
+        for a, mask in enumerate(constraint["rows"]):
+            for b in range(q):
+                if (mask >> b) & 1:
+                    rows[value_perms[old_u][a]] |= 1 << value_perms[old_v][b]
+        u, v = vertex_perm[old_u], vertex_perm[old_v]
+        if u > v:
+            u, v = v, u
+            rows = _transpose_rows(rows, q)
+        transformed.append({"scope": [u, v], "rows": rows})
+    if reverse_constraints:
+        transformed.reverse()
+    return {
+        "n": n,
+        "domain_size": q,
+        "relation_degree": inst["relation_degree"],
+        "edge_multiplier": inst["edge_multiplier"],
+        "constraints": transformed,
+        "answer": answer,
+    }
+
+
+def _answer_atoms(answer: object) -> int:
+    if isinstance(answer, dict):
+        return sum(_answer_atoms(v) for v in answer.values())
+    if isinstance(answer, list):
+        return sum(_answer_atoms(v) for v in answer)
+    return 1
+
+
+def _find_swap_corruption(inst: dict) -> list[int]:
+    answer = inst["answer"][:]
+    n = len(answer)
+    for i in range(n):
+        for j in range(i + 1, n):
+            if answer[i] == answer[j]:
+                continue
+            candidate = answer[:]
+            candidate[i], candidate[j] = candidate[j], candidate[i]
+            if not verify(inst, candidate)[0]:
+                return candidate
+    raise AssertionError("could not create a rejected swap corruption")
+
+
+def selftest() -> dict:
+    """Run and report all mandatory gates with measured quantities."""
+    report: dict[str, Any] = {}
+
+    # G1: every preset, several independent seeds, plus JSON-native answers.
+    g1_instances = 0
+    for params in DIFFICULTY.values():
+        for seed in (0, 1, 17, 991):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            assert ok, reason
+            assert json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            g1_instances += 1
+    report["G1_planted_verifies"] = {
+        "pass": True,
+        "instances": g1_instances,
+        "generation_route": "inverse generation",
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=20260905, **shipping_params)
+
+    # G2: five distinct malformed/corrupted cases and distinct diagnostics.
+    plant = shipping["answer"]
+    corruptions = {
+        "drop_one": plant[:-1],
+        "swap_two": _find_swap_corruption(shipping),
+        "duplicate_one": plant + [plant[-1]],
+        "empty": [],
+        "out_of_range": [shipping["domain_size"]] + plant[1:],
+    }
+    reasons = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
+        assert not ok, name
+        reasons[name] = reason
+    assert len(set(reasons.values())) == len(reasons)
+    report["G2_rejects_corruption"] = {
+        "pass": True,
+        "reasons": reasons,
+    }
+
+    # G3: realistic tagged prose/markdown response and exact round trip.
+    wire = json.dumps(plant)
+    response = "I checked every relation.\n```text\nfinal follows\n```\n<answer>\n" + wire + "\n</answer>\n"
+    parsed = parse_answer(response)
+    assert parsed == plant
+    report["G3_round_trip"] = {
+        "pass": True,
+        "json_native": json.loads(json.dumps(plant)) == plant,
+        "answer_elements": _answer_atoms(plant),
+    }
+
+    # G4/G5 shipping density.  Uniform D^n already includes every shape/range
+    # rule a reader can enforce without using a constraint.
+    guess_rng = random.Random(0x91_11_0801)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        candidate = random_candidate(shipping, guess_rng)
+        if verify(shipping, candidate)[0]:
+            guess_hits += 1
+    guess_probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "empirical_probability": guess_probability,
+        "structure_aware_space": search_space(shipping),
+        "prior": "uniform over the exact declared array D^n",
+    }
+
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    assert isinstance(demo_count, int) and demo_count >= 1
+    start = time.perf_counter()
+    baseline_answer, baseline_nodes, baseline_ops, baseline_status = _mac_dpll(
+        shipping, _BASELINE_NODE_BUDGET
+    )
+    baseline_wall = time.perf_counter() - start
+    baseline_solved = baseline_answer is not None and verify(shipping, baseline_answer)[0]
+    report["G5_density_and_baseline"] = {
+        "pass": guess_probability < 1e-6 and not baseline_solved,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_density_estimate": guess_probability,
+        "demo_exact_solution_count": demo_count,
+        "demo_n": demo["n"],
+        "baseline_algorithm": "MAC/DPLL with MRV and least-constraining values",
+        "baseline_node_budget": _BASELINE_NODE_BUDGET,
+        "baseline_nodes": baseline_nodes,
+        "baseline_operations": baseline_ops,
+        "baseline_wall_seconds": round(baseline_wall, 6),
+        "baseline_status": baseline_status,
+        "baseline_solved": baseline_solved,
+    }
+
+    # G6: eight fresh shipping seeds per attack.  A successful attack is fatal.
+    attack_names = [
+        "balanced_support_outlier",
+        "greedy_high_degree",
+        "min_conflicts_8x400",
+        "loopy_belief_propagation_8",
+        "exact_mac_dpll_2k_nodes",
+    ]
+    attack_stats = {
+        name: {"successes": 0, "attempts": 8, "operations_or_nodes": 0}
+        for name in attack_names
+    }
+    for seed in range(3100, 3108):
+        inst = make_instance(seed=seed, **shipping_params)
+
+        candidate = _outlier_attack(inst)
+        attack_stats[attack_names[0]]["successes"] += int(verify(inst, candidate)[0])
+        attack_stats[attack_names[0]]["operations_or_nodes"] += (
+            2 * len(inst["constraints"]) * inst["domain_size"]
+        )
+
+        candidate = _greedy_attack(inst)
+        attack_stats[attack_names[1]]["successes"] += int(verify(inst, candidate)[0])
+        attack_stats[attack_names[1]]["operations_or_nodes"] += sum(
+            1 for _ in inst["constraints"]
+        ) * inst["domain_size"]
+
+        candidate, operations = _min_conflicts_attack(
+            inst, random.Random(seed ^ 0xC5C5), 8, 400
+        )
+        attack_stats[attack_names[2]]["operations_or_nodes"] += operations
+        attack_stats[attack_names[2]]["successes"] += int(
+            candidate is not None and verify(inst, candidate)[0]
+        )
+
+        candidate, operations = _belief_propagation_attack(inst, 8)
+        attack_stats[attack_names[3]]["operations_or_nodes"] += operations
+        attack_stats[attack_names[3]]["successes"] += int(verify(inst, candidate)[0])
+
+        candidate, nodes, operations, _status = _mac_dpll(inst, _PANEL_NODE_BUDGET)
+        attack_stats[attack_names[4]]["operations_or_nodes"] += max(nodes, operations)
+        attack_stats[attack_names[4]]["successes"] += int(
+            candidate is not None and verify(inst, candidate)[0]
+        )
+    all_failed = all(v["successes"] == 0 for v in attack_stats.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed,
+        "attacks": attack_stats,
+        "domain_standard_attack": "exact_mac_dpll_2k_nodes",
+        "construction_aware_attack": "loopy_belief_propagation_8",
+    }
+
+    # G7: n really scales the CSP, and a doubled instance still constructs.
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=707, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    assert doubled_ok, doubled_reason
+    escalated = escalate(shipping_params)
+    assert isinstance(escalated, dict)
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] > shipping["n"],
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "doubled_constraints": len(doubled["constraints"]),
+        "escalated_params": escalated,
+    }
+
+    # G8: variable relabeling, input order, local domain renaming, and their
+    # compositions are genuine isomorphisms.  Carry witnesses through each.
+    invariant_count = 0
+    valid_carried = 0
+    for seed in range(20):
+        base = make_instance(seed=8000 + seed, **DIFFICULTY["easy"])
+        rng = random.Random(9000 + seed)
+        vertex_perm = list(range(base["n"]))
+        rng.shuffle(vertex_perm)
+        value_perms = []
+        for _ in range(base["n"]):
+            p = list(range(base["domain_size"]))
+            rng.shuffle(p)
+            value_perms.append(p)
+        transformed = _relabel_instance(base, vertex_perm, value_perms, True)
+        assert canonical_key(base) == canonical_key(transformed)
+        invariant_count += 1
+        if verify(transformed, transformed["answer"])[0]:
+            valid_carried += 1
+
+        identity = list(range(base["n"]))
+        reordered = _relabel_instance(base, identity, None, True)
+        assert canonical_key(base) == canonical_key(reordered)
+        invariant_count += 1
+        if verify(reordered, base["answer"])[0]:
+            valid_carried += 1
+    unrelated_keys = {
+        canonical_key(make_instance(seed=12000 + seed, **DIFFICULTY["easy"]))
+        for seed in range(20)
+    }
+    report["G8_canonical_key"] = {
+        "pass": invariant_count == 40 and valid_carried == 40
+                and len(unrelated_keys) == 20,
+        "invariant_relabelings": invariant_count,
+        "valid_carried_witnesses": valid_carried,
+        "distinct_unrelated": len(unrelated_keys),
+        "unrelated_attempts": 20,
+        "key_kind": "primal-graph refinement/cycle invariant, then SHA-256",
+    }
+
+    # G9(a,b) are diagnostics populated after script-owned oracle runs.  Only
+    # exact answer/route caps gate.  One post-insight operation is counted per
+    # output value and per relation lookup needed to check the witness.
+    answer_blob = json.dumps(plant, separators=(",", ":"))
+    answer_elements = _answer_atoms(plant)
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    # The direct checker scans all constraints, but after the cycle-consistency
+    # insight a solver need only write n values.  G9's intended-route cap counts
+    # construction of the answer, not the independent verifier's audit.
+    intended_ops = shipping["n"]
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    hinted_attempts = _ORACLE_EVIDENCE["hinted"]["attempts"]
+    placebo_attempts = _ORACLE_EVIDENCE["placebo"]["attempts"]
+    hinted_rate = (_ORACLE_EVIDENCE["hinted"]["solved"] / hinted_attempts
+                   if hinted_attempts else 0.0)
+    placebo_rate = (_ORACLE_EVIDENCE["placebo"]["solved"] / placebo_attempts
+                    if placebo_attempts else 0.0)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": {
+            "bare": dict(_ORACLE_EVIDENCE["bare"]),
+            "hinted": dict(_ORACLE_EVIDENCE["hinted"]),
+            "placebo": dict(_ORACLE_EVIDENCE["placebo"]),
+        },
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": _ORACLE_EVIDENCE["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+        "within_caps": within_caps,
+    }
+
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G")
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

diff --git a/gen_0911_0801.py b/gen_0911_0801.py
new file mode 100644
index 0000000000000000000000000000000000000000..3b700fa280bb2dfe4c343ca056707fc63b10413a
--- /dev/null
+++ b/gen_0911_0801.py
@@ -0,0 +1,1032 @@
+"""Balanced-table binary CSP generator grounded in arXiv:0911.0801.
+
+The paper defines CSP instances as variables, a common domain, and explicitly
+listed allowed tuples (Definition 2.1), then proves an ETH lower bound for
+bounded-arity classes of unbounded width (Theorems 1.2 and 7.1).  This module
+inverse-generates a satisfying assignment and binary relation tables around it.
+Every table is biregular, so the planted value has exactly the same one-edge
+support statistics as every decoy value.
+
+Generation never solves an instance.  Verification is an exact scan of table
+membership.  The module is deterministic in (n, seed, params), uses only the
+standard library, performs no file or network I/O, and is silent on import.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from typing import Any
+
+
+TRACK = "A"
+
+PROBLEM_PROFILE = {
+    "native_domain": "logic",
+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "finite-domain CSP variables",
+        "binary constraint relations represented by exact row bitsets",
+    ],
+    "verification_operations": [
+        "integer range comparison",
+        "exact allowed-tuple membership by bit lookup",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "constraint propagation",
+    "intuition_description": (
+        "Only cycle consistency distinguishes the satisfying values because "
+        "every individual relation has identical row and column degrees; "
+        "without propagating coupled domains, local frequencies give no clue."
+    ),
+    "hardness_basis": (
+        "Track A: Theorem 1.2 covers bounded-arity CSP classes of unbounded "
+        "treewidth (and Theorem 7.1 strengthens this using unbounded submodular "
+        "width); shipping uses binary constraints on a sparse, growing-width "
+        "random-core regime with q=16 and balanced density 1/2, for which no "
+        "efficient algorithm is known on this generated distribution, and G5 "
+        "reports the measured MAC/DPLL node and wall-clock cost."
+    ),
+    # Compact JSON is at most 217 characters for 72 values in 0..15; this
+    # conservative four-characters/token conversion rounds upward.
+    "max_answer_tokens": 55,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 6, "domain_size": 4, "relation_degree": 2,
+             "edge_multiplier": 2},
+    "easy": {"n": 72, "domain_size": 16, "relation_degree": 8,
+             "edge_multiplier": 5},
+    "medium": {"n": 96, "domain_size": 16, "relation_degree": 8,
+               "edge_multiplier": 5},
+    "hard": {"n": 128, "domain_size": 16, "relation_degree": 8,
+             "edge_multiplier": 5},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The satisfying values are distinguished only by consistency around cycles; "
+    "each individual relation has perfectly equal row and column degrees."
+)
+PLACEBO_HINT = (
+    "The satisfying values should be checked carefully across the displayed "
+    "constraints; each relation uses a compact row-bitset representation."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON array of exactly n integers, one value in 0..q-1 for each "
+        "variable in index order; q <= 32 and n <= 512."
+    ),
+    "bounds": {
+        "max_variables": 512,
+        "max_domain_size": 32,
+        "min_value": 0,
+        "max_value": 31,
+    },
+}
+
+NOTES = r"""
+Paper grounding and Step 0.  Definition 2.1 fixes the exact object used here:
+a CSP instance is (V,D,C), every constraint is a scope plus an allowed relation,
+and a solution is a function V -> D whose tuple belongs to every relation.  The
+paper explicitly assumes relations are represented by listing allowed tuples.
+For a fixed binary domain, the row-bitsets rendered here are merely that same
+table representation with each row's listed set encoded losslessly as bits.
+
+The easy and hard regimes.  Section 4, especially Theorem 4.1, gives an FPT
+algorithm for bounded submodular width by consistency enforcement, uniform
+splitting, and adaptive tree decompositions.  Theorem 1.1 says that for bounded
+arity, bounded treewidth is the tractable structural boundary (subject to the
+stated parameterized-complexity assumption); Theorem 1.2 gives the sharper ETH
+lower bound.  Theorem 7.1 gives the paper's unbounded-submodular-width ETH lower
+bound.  Our sparse graph core grows with n and is not a bounded-width family.
+The theorem is worst-case evidence only: it does not prove this inverse-planted
+distribution hard.  The distributional claim is therefore limited to the
+explicit adversary measurements in selftest and the external oracle transcript.
+
+What produces the certificate.  The assignment is sampled first.  For every
+constraint, independent random row and column permutations hide a circulant
+biregular relation, and the permitted shifts include the planted pair.  Thus the
+certificate is known before the instance exists.  No CSP, SAT, treewidth,
+consistency, or search algorithm runs during generation.
+
+Attack resistance.  Every row and every column of every q-by-q relation has
+exactly relation_degree allowed tuples, so support-count and degree outliers tie
+on every value.  Variable order and constraint order are randomized by the seed.
+The greedy attack uses assigned-neighbor compatibility, min-conflicts uses local
+repair, and loopy belief propagation tests whether small biases amplify through
+cycles.  The domain-standard attack is exact DPLL with maintained arc
+consistency and a measured node cap.  Plants and decoys are not sampled as two
+different tuple populations: after marginalizing over the uniformly sampled
+plant value, every value label has the same local distribution.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 1_000_000
+_PANEL_NODE_BUDGET = 2_000
+_BASELINE_NODE_BUDGET = 5_000
+_ORACLE_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _validate_params(n: int, domain_size: int, relation_degree: int,
+                     edge_multiplier: int) -> None:
+    values = (n, domain_size, relation_degree, edge_multiplier)
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in values):
+        raise ValueError("n, domain_size, relation_degree, and edge_multiplier must be integers")
+    if not 4 <= n <= CERTIFICATE_LANGUAGE["bounds"]["max_variables"]:
+        raise ValueError("n must be in 4..512")
+    if not 4 <= domain_size <= CERTIFICATE_LANGUAGE["bounds"]["max_domain_size"]:
+        raise ValueError("domain_size must be in 4..32")
+    if not 1 <= relation_degree < domain_size:
+        raise ValueError("relation_degree must be in 1..domain_size-1")
+    if not 2 <= edge_multiplier:
+        raise ValueError("edge_multiplier must be at least 2")
+    if edge_multiplier * n > n * (n - 1) // 2:
+        raise ValueError("too many constraints requested for a simple binary scope graph")
+
+
+def _permutation_sending_to_zero(size: int, distinguished: int,
+                                 rng: random.Random) -> list[int]:
+    """A uniform permutation p conditional on p[distinguished] == 0."""
+    rest = [x for x in range(size) if x != distinguished]
+    rng.shuffle(rest)
+    p = [0] * size
+    p[distinguished] = 0
+    for label, value in enumerate(rest, 1):
+        p[value] = label
+    return p
+
+
+def _relation_rows(size: int, degree: int, planted_left: int,
+                   planted_right: int, rng: random.Random) -> list[int]:
+    """Make a biregular relation of row/column degree ``degree``.
+
+    Independent private permutations hide a circulant bipartite graph.  Shift
+    zero is included, so the two values mapped to zero form an allowed pair.
+    """
+    left = _permutation_sending_to_zero(size, planted_left, rng)
+    right = _permutation_sending_to_zero(size, planted_right, rng)
+    shifts = {0}
+    shifts.update(rng.sample(range(1, size), degree - 1))
+    rows = [0] * size
+    for a in range(size):
+        mask = 0
+        for b in range(size):
+            if (right[b] - left[a]) % size in shifts:
+                mask |= 1 << b
+        rows[a] = mask
+    return rows
+
+
+def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
+    """Inverse-generate a finite-domain binary CSP with a known assignment."""
+    unknown = set(params) - {"domain_size", "relation_degree", "edge_multiplier"}
+    if unknown:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(unknown)))
+    domain_size = params.get("domain_size", 16)
+    relation_degree = params.get("relation_degree", domain_size // 2)
+    edge_multiplier = params.get("edge_multiplier", 5)
+    _validate_params(n, domain_size, relation_degree, edge_multiplier)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    planted = [rng.randrange(domain_size) for _ in range(n)]
+
+    # A Hamiltonian cycle prevents isolated pieces.  Remaining scopes are drawn
+    # uniformly without replacement; their order is shuffled before relations
+    # are sampled so index order carries no construction phase information.
+    edges: set[tuple[int, int]] = set()
+    cycle_order = list(range(n))
+    rng.shuffle(cycle_order)
+    for i, u in enumerate(cycle_order):
+        v = cycle_order[(i + 1) % n]
+        edges.add((u, v) if u < v else (v, u))
+    target = edge_multiplier * n
+    while len(edges) < target:
+        u, v = rng.sample(range(n), 2)
+        edges.add((u, v) if u < v else (v, u))
+    edge_list = list(edges)
+    rng.shuffle(edge_list)
+
+    constraints = []
+    for u, v in edge_list:
+        rows = _relation_rows(domain_size, relation_degree,
+                              planted[u], planted[v], rng)
+        constraints.append({"scope": [u, v], "rows": rows})
+    rng.shuffle(constraints)
+    return {
+        "n": n,
+        "domain_size": domain_size,
+        "relation_degree": relation_degree,
+        "edge_multiplier": edge_multiplier,
+        "constraints": constraints,
+        "answer": planted,
+    }
+
+
+def render(inst: dict) -> str:
+    """Render a complete, standalone CSP statement and exact output contract."""
+    n = inst["n"]
+    q = inst["domain_size"]
+    degree = inst["relation_degree"]
+    width = (q + 3) // 4
+    lines = [
+        "Balanced-table binary constraint satisfaction",
+        "",
+        f"There are {n} variables x0,...,x{n - 1}.  Each variable must receive",
+        f"one integer from the common domain D = {{0,1,...,{q - 1}}}.",
+        "",
+        "A binary constraint Cj has a scope (xu,xv) and an allowed relation.",
+        "Its relation is displayed as one hexadecimal bit mask for each possible",
+        "value a of xu, in order a=0,1,... .  Bit b of row mask a is 1 exactly",
+        "when the ordered pair (a,b) is allowed for (xu,xv).  The least",
+        "significant bit is bit 0; leading zeroes are significant only as padding.",
+        f"Every displayed relation has exactly {degree} set bits in every row and",
+        f"exactly {degree} set bits in every column.  A complete assignment is",
+        "valid iff its ordered value pair is allowed by every constraint.",
+        "Constraint order has no mathematical significance.",
+        "",
+        "Constraints (identifier: left right : row masks for left values 0 upward):",
+    ]
+    for j, constraint in enumerate(inst["constraints"]):
+        u, v = constraint["scope"]
+        masks = " ".join(f"{row:0{width}x}" for row in constraint["rows"])
+        lines.append(f"C{j}: x{u} x{v} : {masks}")
+    lines.extend([
+        "",
+        f"Return exactly {n} integers in variable order x0 through x{n - 1},",
+        f"each inclusively between 0 and {q - 1}.  Repetitions are allowed; the",
+        "array order is fixed and is not a set or a permutation.",
+        "",
+        "Give your final answer inside <answer></answer> tags, as a JSON array",
+        "of decimal integers with no ellipsis.",
+        "Syntax-only example: <answer>[0, 1, 2]</answer>",
+        "Output nothing else inside the tags.",
+    ])
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract a JSON integer array from tagged solver output; never raise."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list):
+        return None
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in value):
+        return None
+    return value
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any assignment by exact tuple membership; never inspect the plant."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if not answer:
+        return False, "assignment must not be empty"
+    n = inst["n"]
+    if len(answer) < n:
+        return False, f"assignment has {n - len(answer)} missing entries"
+    if len(answer) > n:
+        return False, f"assignment has {len(answer) - n} extra entries"
+    q = inst["domain_size"]
+    for i, value in enumerate(answer):
+        if isinstance(value, bool) or not isinstance(value, int):
+            return False, f"value at position {i} is not an integer"
+        if not 0 <= value < q:
+            return False, f"value at position {i} is outside 0..{q - 1}"
+    for j, constraint in enumerate(inst["constraints"]):
+        u, v = constraint["scope"]
+        if not (constraint["rows"][answer[u]] >> answer[v]) & 1:
+            return False, (
+                f"constraint C{j} on (x{u},x{v}) rejects "
+                f"({answer[u]},{answer[v]})"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from the statement-aware space D^n."""
+    return [rng.randrange(inst["domain_size"]) for _ in range(inst["n"])]
+
+
+def search_space(inst: dict) -> int | None:
+    """The exact size of the bounded assignment language for this instance."""
+    return inst["domain_size"] ** inst["n"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count all solutions exactly when D^n is below a strict work cap."""
+    space = search_space(inst)
+    if space is None or space > _ENUMERATION_CAP:
+        return None
+    count = 0
+    q = inst["domain_size"]
+    for candidate in itertools.product(range(q), repeat=inst["n"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def _graph_invariant(inst: dict) -> dict:
+    """A relabeling-invariant fingerprint of the primal graph.
+
+    It is intentionally derived from structure rather than seed or rendering.
+    Color refinement is not a complete isomorphism canonical form, but random
+    sparse cores are separated reliably; this limitation is stated in README.
+    """
+    n = inst["n"]
+    adj = [set() for _ in range(n)]
+    for constraint in inst["constraints"]:
+        u, v = constraint["scope"]
+        adj[u].add(v)
+        adj[v].add(u)
+    degrees = [len(x) for x in adj]
+    colors = degrees[:]
+    for _ in range(6):
+        signatures = [(colors[v], tuple(sorted(colors[w] for w in adj[v])))
+                      for v in range(n)]
+        palette = {sig: i for i, sig in enumerate(sorted(set(signatures)))}
+        new_colors = [palette[sig] for sig in signatures]
+        if new_colors == colors:
+            break
+        colors = new_colors
+    edge_common = []
+    edge_color_pairs = []
+    for u in range(n):
+        for v in adj[u]:
+            if u < v:
+                edge_common.append(len(adj[u] & adj[v]))
+                edge_color_pairs.append(tuple(sorted((colors[u], colors[v]))))
+    triangle_at = []
+    for u in range(n):
+        twice = sum(len(adj[v] & adj[u]) for v in adj[u])
+        triangle_at.append(twice // 2)
+    class_sizes: dict[int, int] = {}
+    for color in colors:
+        class_sizes[color] = class_sizes.get(color, 0) + 1
+    return {
+        "n": n,
+        "m": sum(degrees) // 2,
+        "degree_sequence": sorted(degrees),
+        "triangle_profile": sorted(triangle_at),
+        "edge_common_neighbors": sorted(edge_common),
+        "refinement_classes": sorted(class_sizes.values()),
+        "refined_edge_pairs": sorted(edge_color_pairs),
+    }
+
+
+def canonical_key(inst: dict) -> str:
+    """Return a deterministic cheap invariant under CSP relabelings."""
+    payload = json.dumps(_graph_invariant(inst), sort_keys=True,
+                         separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Raise branching entropy first, then density, before lengthening output."""
+    p = {k: v for k, v in params.items() if k != "_preset"}
+    q = int(p.get("domain_size", 16))
+    if q < 24:
+        q += 2
+        p["domain_size"] = q
+        p["relation_degree"] = q // 2
+        return p
+    if int(p.get("edge_multiplier", 5)) < 7:
+        p["edge_multiplier"] = int(p.get("edge_multiplier", 5)) + 1
+        return p
+    if int(p.get("n", 0)) < 256:
+        p["n"] = min(256, int(p["n"]) + 32)
+        return p
+    return "cap_bound"
+
+
+def _incident_data(inst: dict) -> tuple[list[list[int]], list[tuple[int, int, list[int]]]]:
+    n = inst["n"]
+    incident = [[] for _ in range(n)]
+    constraints = []
+    for j, constraint in enumerate(inst["constraints"]):
+        u, v = constraint["scope"]
+        rows = constraint["rows"]
+        constraints.append((u, v, rows))
+        incident[u].append(j)
+        incident[v].append(j)
+    return incident, constraints
+
+
+def _outlier_attack(inst: dict) -> list[int]:
+    """Choose each value with greatest one-edge support (ties lexicographic)."""
+    q = inst["domain_size"]
+    incident, constraints = _incident_data(inst)
+    answer = []
+    for x in range(inst["n"]):
+        score = [0] * q
+        for j in incident[x]:
+            u, v, rows = constraints[j]
+            if x == u:
+                for a in range(q):
+                    score[a] += rows[a].bit_count()
+            else:
+                for b in range(q):
+                    score[b] += sum((rows[a] >> b) & 1 for a in range(q))
+        answer.append(max(range(q), key=lambda a: (score[a], -a)))
+    return answer
+
+
+def _greedy_attack(inst: dict) -> list[int]:
+    """Highest-degree first, maximizing compatibility with assigned neighbors."""
+    n = inst["n"]
+    q = inst["domain_size"]
+    incident, constraints = _incident_data(inst)
+    order = sorted(range(n), key=lambda x: (-len(incident[x]), x))
+    answer = [-1] * n
+    for x in order:
+        scores = [0] * q
+        for value in range(q):
+            for j in incident[x]:
+                u, v, rows = constraints[j]
+                other = v if x == u else u
+                if answer[other] < 0:
+                    continue
+                allowed = ((rows[value] >> answer[other]) & 1) if x == u else (
+                    (rows[answer[other]] >> value) & 1
+                )
+                scores[value] += allowed
+        answer[x] = max(range(q), key=lambda a: (scores[a], -a))
+    return answer
+
+
+def _min_conflicts_attack(inst: dict, rng: random.Random,
+                          restarts: int = 8, steps: int = 400) -> tuple[list[int] | None, int]:
+    n = inst["n"]
+    q = inst["domain_size"]
+    incident, constraints = _incident_data(inst)
+    operations = 0
+    for _ in range(restarts):
+        answer = [rng.randrange(q) for _ in range(n)]
+        for _step in range(steps):
+            violated = []
+            for j, (u, v, rows) in enumerate(constraints):
+                operations += 1
+                if not (rows[answer[u]] >> answer[v]) & 1:
+                    violated.append(j)
+            if not violated:
+                return answer, operations
+            j = rng.choice(violated)
+            u, v, _rows = constraints[j]
+            x = u if rng.randrange(2) == 0 else v
+            best_values = []
+            best_bad = len(incident[x]) + 1
+            old = answer[x]
+            for value in range(q):
+                answer[x] = value
+                bad = 0
+                for k in incident[x]:
+                    a, b, rows = constraints[k]
+                    operations += 1
+                    if not (rows[answer[a]] >> answer[b]) & 1:
+                        bad += 1
+                if bad < best_bad:
+                    best_bad = bad
+                    best_values = [value]
+                elif bad == best_bad:
+                    best_values.append(value)
+            answer[x] = rng.choice(best_values) if best_values else old
+    return None, operations
+
+
+def _belief_propagation_attack(inst: dict, iterations: int = 8) -> tuple[list[int], int]:
+    """Loopy sum-product from deterministic tiny nonuniform messages."""
+    n = inst["n"]
+    q = inst["domain_size"]
+    incident, constraints = _incident_data(inst)
+    messages: dict[tuple[int, int], list[float]] = {}
+    for j, (u, v, _rows) in enumerate(constraints):
+        for x in (u, v):
+            raw = [1.0 + (((x + 1) * (a + 3) * 2654435761 + j) % 17) * 1e-4
+                   for a in range(q)]
+            total = sum(raw)
+            messages[(x, j)] = [z / total for z in raw]
+    operations = 0
+    for _ in range(iterations):
+        incoming: dict[tuple[int, int], list[float]] = {}
+        for j, (u, v, rows) in enumerate(constraints):
+            from_u = messages[(u, j)]
+            from_v = messages[(v, j)]
+            to_v = [0.0] * q
+            to_u = [0.0] * q
+            for a in range(q):
+                mask = rows[a]
+                for b in range(q):
+                    operations += 2
+                    if (mask >> b) & 1:
+                        to_v[b] += from_u[a]
+                        to_u[a] += from_v[b]
+            incoming[(j, v)] = to_v
+            incoming[(j, u)] = to_u
+        new_messages = {}
+        for x in range(n):
+            for excluded in incident[x]:
+                vals = [1.0] * q
+                for j in incident[x]:
+                    if j == excluded:
+                        continue
+                    inc = incoming[(j, x)]
+                    for a in range(q):
+                        vals[a] *= max(inc[a], 1e-300)
+                        operations += 1
+                total = sum(vals)
+                if not math.isfinite(total) or total == 0.0:
+                    vals = [1.0 / q] * q
+                else:
+                    vals = [z / total for z in vals]
+                new_messages[(x, excluded)] = vals
+        messages = new_messages
+    answer = []
+    # Recompute final factor-to-variable messages once.
+    incoming = {}
+    for j, (u, v, rows) in enumerate(constraints):
+        from_u = messages[(u, j)]
+        from_v = messages[(v, j)]
+        to_v = [0.0] * q
+        to_u = [0.0] * q
+        for a in range(q):
+            for b in range(q):
+                operations += 2
+                if (rows[a] >> b) & 1:
+                    to_v[b] += from_u[a]
+                    to_u[a] += from_v[b]
+        incoming[(j, v)] = to_v
+        incoming[(j, u)] = to_u
+    for x in range(n):
+        vals = [1.0] * q
+        for j in incident[x]:
+            inc = incoming[(j, x)]
+            for a in range(q):
+                vals[a] *= max(inc[a], 1e-300)
+                operations += 1
+        answer.append(max(range(q), key=lambda a: (vals[a], -a)))
+    return answer, operations
+
+
+def _mac_dpll(inst: dict, node_budget: int) -> tuple[list[int] | None, int, int, str]:
+    """Exact DPLL with maintained arc consistency and MRV branching."""
+    n = inst["n"]
+    q = inst["domain_size"]
+    incident, constraints = _incident_data(inst)
+    reverse_support = []
+    for _u, _v, rows in constraints:
+        rev = [0] * q
+        for a, mask in enumerate(rows):
+            for b in range(q):
+                if (mask >> b) & 1:
+                    rev[b] |= 1 << a
+        reverse_support.append(rev)
+    nodes = 0
+    operations = 0
+    exhausted = False
+
+    def propagate(domains: list[int], queue: list[int]) -> bool:
+        nonlocal operations
+        while queue:
+            x = queue.pop()
+            for j in incident[x]:
+                u, v, rows = constraints[j]
+                allowed = 0
+                if x == u:
+                    mask = domains[u]
+                    for a in range(q):
+                        operations += 1
+                        if (mask >> a) & 1:
+                            allowed |= rows[a]
+                    y = v
+                else:
+                    mask = domains[v]
+                    rev = reverse_support[j]
+                    for b in range(q):
+                        operations += 1
+                        if (mask >> b) & 1:
+                            allowed |= rev[b]
+                    y = u
+                narrowed = domains[y] & allowed
+                if not narrowed:
+                    return False
+                if narrowed != domains[y]:
+                    domains[y] = narrowed
+                    queue.append(y)
+        return True
+
+    def recurse(domains: list[int]) -> list[int] | None:
+        nonlocal nodes, exhausted, operations
+        nodes += 1
+        if nodes > node_budget:
+            exhausted = True
+            return None
+        choice = -1
+        best_size = q + 1
+        best_degree = -1
+        for x, mask in enumerate(domains):
+            size = mask.bit_count()
+            if 1 < size < best_size or (
+                size == best_size and size > 1 and len(incident[x]) > best_degree
+            ):
+                choice = x
+                best_size = size
+                best_degree = len(incident[x])
+        if choice < 0:
+            candidate = [mask.bit_length() - 1 for mask in domains]
+            return candidate if verify(inst, candidate)[0] else None
+
+        # Least-constraining-value ordering is a standard CSP heuristic.
+        value_scores = []
+        for value in range(q):
+            if not (domains[choice] >> value) & 1:
+                continue
+            support = 0
+            for j in incident[choice]:
+                u, v, rows = constraints[j]
+                other = v if choice == u else u
+                if choice == u:
+                    support += (rows[value] & domains[other]).bit_count()
+                else:
+                    support += (reverse_support[j][value] & domains[other]).bit_count()
+                operations += 1
+            value_scores.append((-support, value))
+        for _negative_support, value in sorted(value_scores):
+            child = domains[:]
+            child[choice] = 1 << value
+            if propagate(child, [choice]):
+                result = recurse(child)
+                if result is not None:
+                    return result
+                if exhausted:
+                    return None
+        return None
+
+    result = recurse([(1 << q) - 1] * n)
+    status = "solved" if result is not None else ("node_budget" if exhausted else "unsatisfiable")
+    return result, nodes, operations, status
+
+
+def _transpose_rows(rows: list[int], q: int) -> list[int]:
+    transposed = [0] * q
+    for a, mask in enumerate(rows):
+        for b in range(q):
+            if (mask >> b) & 1:
+                transposed[b] |= 1 << a
+    return transposed
+
+
+def _relabel_instance(inst: dict, vertex_perm: list[int],
+                      value_perms: list[list[int]] | None = None,
+                      reverse_constraints: bool = False) -> dict:
+    """Carry an instance and its witness through true CSP isomorphisms."""
+    n = inst["n"]
+    q = inst["domain_size"]
+    if value_perms is None:
+        value_perms = [list(range(q)) for _ in range(n)]
+    answer = [0] * n
+    for old in range(n):
+        answer[vertex_perm[old]] = value_perms[old][inst["answer"][old]]
+    transformed = []
+    for constraint in inst["constraints"]:
+        old_u, old_v = constraint["scope"]
+        rows = [0] * q
+        for a, mask in enumerate(constraint["rows"]):
+            for b in range(q):
+                if (mask >> b) & 1:
+                    rows[value_perms[old_u][a]] |= 1 << value_perms[old_v][b]
+        u, v = vertex_perm[old_u], vertex_perm[old_v]
+        if u > v:
+            u, v = v, u
+            rows = _transpose_rows(rows, q)
+        transformed.append({"scope": [u, v], "rows": rows})
+    if reverse_constraints:
+        transformed.reverse()
+    return {
+        "n": n,
+        "domain_size": q,
+        "relation_degree": inst["relation_degree"],
+        "edge_multiplier": inst["edge_multiplier"],
+        "constraints": transformed,
+        "answer": answer,
+    }
+
+
+def _answer_atoms(answer: object) -> int:
+    if isinstance(answer, dict):
+        return sum(_answer_atoms(v) for v in answer.values())
+    if isinstance(answer, list):
+        return sum(_answer_atoms(v) for v in answer)
+    return 1
+
+
+def _find_swap_corruption(inst: dict) -> list[int]:
+    answer = inst["answer"][:]
+    n = len(answer)
+    for i in range(n):
+        for j in range(i + 1, n):
+            if answer[i] == answer[j]:
+                continue
+            candidate = answer[:]
+            candidate[i], candidate[j] = candidate[j], candidate[i]
+            if not verify(inst, candidate)[0]:
+                return candidate
+    raise AssertionError("could not create a rejected swap corruption")
+
+
+def selftest() -> dict:
+    """Run and report all mandatory gates with measured quantities."""
+    report: dict[str, Any] = {}
+
+    # G1: every preset, several independent seeds, plus JSON-native answers.
+    g1_instances = 0
+    for params in DIFFICULTY.values():
+        for seed in (0, 1, 17, 991):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            assert ok, reason
+            assert json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            g1_instances += 1
+    report["G1_planted_verifies"] = {
+        "pass": True,
+        "instances": g1_instances,
+        "generation_route": "inverse generation",
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=20260905, **shipping_params)
+
+    # G2: five distinct malformed/corrupted cases and distinct diagnostics.
