+def _one_congruence_root(a: int, b: int, modulus: int) -> int | None:
+    """Return one solution of a*x=b mod modulus, if it exists."""
+    g = math.gcd(a, modulus)
+    if b % g:
         return None
+    reduced_modulus = modulus // g
+    if reduced_modulus == 1:
+        return 0
+    return ((b // g) * pow((a // g) % reduced_modulus, -1,
+                           reduced_modulus)) % reduced_modulus
 
