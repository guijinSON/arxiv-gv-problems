-            from_u = messages[(u, j)]
-            from_v = messages[(v, j)]
-            to_v = [0.0] * q
-            to_u = [0.0] * q
-            for a in range(q):
-                mask = rows[a]
-                for b in range(q):
-                    operations += 2
-                    if (mask >> b) & 1:
-                        to_v[b] += from_u[a]
-                        to_u[a] += from_v[b]
-            incoming[(j, v)] = to_v
-            incoming[(j, u)] = to_u
-        new_messages = {}
-        for x in range(n):
-            for excluded in incident[x]:
-                vals = [1.0] * q
-                for j in incident[x]:
