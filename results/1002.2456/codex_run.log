+def _terms_from_dense(coefficients: list[int], rng: random.Random | None = None) -> list[list[int]]:
+    terms = [
+        [coefficient, exponent]
+        for exponent, coefficient in enumerate(coefficients)
+        if coefficient
+    ]
+    if rng is not None:
+        rng.shuffle(terms)
+    return terms
