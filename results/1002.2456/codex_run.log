+    "easy": {"n": 79, "modulus": 1_000_003, "field": 36_000_109},
+    "medium": {"n": 113, "modulus": 2_000_003, "field": 24_000_037},
+    "hard": {"n": 149, "modulus": 4_000_037, "field": 56_000_519},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+STRUCTURAL_HINT: str = (
+    "Under a common root multiplier, each polynomial coefficient is a "
+    "homogeneous quantity whose weight is its distance below the leading term."
+)
+PLACEBO_HINT: str = (
+    "Keep the two finite fields and the direction of the coordinate convention "
+    "separate while checking the displayed coefficients."
+)
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON object with root_multiplier a and coordinate_multiplier b, both "
+        "integers in [1,p-1], constrained by a*b == 1 modulo p."
