+    try:
+        source = _dense_from_terms(inst, "source_terms")
+        target = _dense_from_terms(inst, "target_terms")
+    except (KeyError, TypeError, ValueError) as exc:
+        return False, f"malformed instance polynomial: {exc}"
+    degree = inst["degree"]
+    power = pow(root_multiplier, degree, modulus)
+    for exponent in range(degree + 1):
+        expected = source[exponent] * power % modulus
+        if target[exponent] != expected:
+            return False, f"polynomial identity fails at exponent {exponent}"
+        power = power * coordinate_multiplier % modulus
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the structurally valid multiplier language."""
+    modulus = inst["modulus"]
+    root_multiplier = rng.randrange(1, modulus)
+    return {
+        "root_multiplier": root_multiplier,
+        "coordinate_multiplier": pow(root_multiplier, -1, modulus),
+    }
+
+
+def search_space(inst: dict) -> int | None:
+    return inst["modulus"] - 1
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Brute-force exact valid-witness count only when the language is small."""
+    if search_space(inst) > 10_000:
+        return None
+    count = 0
+    for root_multiplier in range(1, inst["modulus"]):
+        candidate = {
+            "root_multiplier": root_multiplier,
+            "coordinate_multiplier": pow(root_multiplier, -1, inst["modulus"]),
+        }
+        count += int(verify(inst, candidate)[0])
+    return count
+
+
+def _inverse_with_count(value: int, modulus: int) -> tuple[int, int]:
+    old_r, r = value, modulus
+    old_s, s = 1, 0
+    divisions = 0
+    while r:
+        quotient = old_r // r
+        old_r, r = r, old_r - quotient * r
+        old_s, s = s, old_s - quotient * s
+        divisions += 1
+    if old_r != 1:
+        raise ValueError("value is not invertible")
+    return old_s % modulus, divisions
+
+
+def _pow_with_count(base: int, exponent: int, modulus: int) -> tuple[int, int]:
+    result = 1
+    factor = base % modulus
+    multiplications = 0
+    while exponent:
+        if exponent & 1:
+            result = result * factor % modulus
+            multiplications += 1
+        exponent >>= 1
+        if exponent:
+            factor = factor * factor % modulus
+            multiplications += 1
+    return result, multiplications
+
+
+def _compact_recover(inst: dict) -> tuple[dict, dict]:
+    """The intended homogeneous constant-coefficient shortcut."""
+    source = _dense_from_terms(inst, "source_terms")
+    target = _dense_from_terms(inst, "target_terms")
+    modulus = inst["modulus"]
+    degree = inst["degree"]
+    source_inverse, div1 = _inverse_with_count(source[0], modulus)
+    ratio = target[0] * source_inverse % modulus
+    exponent_inverse, div2 = _inverse_with_count(degree, modulus - 1)
+    root_multiplier, muls = _pow_with_count(ratio, exponent_inverse, modulus)
+    coordinate_multiplier, div3 = _inverse_with_count(root_multiplier, modulus)
+    operations = div1 + 1 + div2 + muls + div3
+    return {
+        "root_multiplier": root_multiplier,
+        "coordinate_multiplier": coordinate_multiplier,
+    }, {
+        "operations": operations,
+        "euclidean_divisions": div1 + div2 + div3,
+        "modular_multiplications": muls + 1,
+        "coefficient_lookups": 2,
+    }
+
+
+def _reference_enumeration(inst: dict) -> tuple[dict | None, dict]:
+    """Section III multiplier enumeration, using its fastest scalar filter."""
+    source = _dense_from_terms(inst, "source_terms")
+    target = _dense_from_terms(inst, "target_terms")
+    modulus = inst["modulus"]
+    degree = inst["degree"]
+    source_inverse, divisions = _inverse_with_count(source[0], modulus)
+    ratio = target[0] * source_inverse % modulus
+    muls_per_power = max(0, degree.bit_length() - 1) + max(0, degree.bit_count() - 1)
+    tested = 0
+    for candidate in range(1, modulus):
+        tested += 1
+        if pow(candidate, degree, modulus) != ratio:
+            continue
+        answer = {
+            "root_multiplier": candidate,
+            "coordinate_multiplier": pow(candidate, -1, modulus),
+        }
+        if verify(inst, answer)[0]:
+            return answer, {
+                "candidates_tested": tested,
+                "operations": divisions + 1 + tested * muls_per_power + degree + 1,
+                "power_multiplications_per_candidate": muls_per_power,
+            }
+    return None, {
+        "candidates_tested": tested,
+        "operations": divisions + 1 + tested * muls_per_power,
+        "power_multiplications_per_candidate": muls_per_power,
+    }
+
+
+def _candidate_from_root(inst: dict, value: int) -> dict | None:
+    modulus = inst["modulus"]
+    value %= modulus
+    if value == 0:
+        return None
+    return {
+        "root_multiplier": value,
+        "coordinate_multiplier": pow(value, -1, modulus),
+    }
+
+
+def _attack_largest_coefficient(inst: dict) -> tuple[dict | None, int]:
+    source = _dense_from_terms(inst, "source_terms")
+    target = _dense_from_terms(inst, "target_terms")
+    modulus = inst["modulus"]
+    exponent = max(range(inst["degree"]), key=lambda j: min(source[j], modulus - source[j]))
+    if source[exponent] == 0:
+        return None, inst["degree"]
+    guess = target[exponent] * pow(source[exponent], -1, modulus) % modulus
+    return _candidate_from_root(inst, guess), inst["degree"] + 2
+
+
+def _attack_first_ratio(inst: dict) -> tuple[dict | None, int]:
+    source = _dense_from_terms(inst, "source_terms")
+    target = _dense_from_terms(inst, "target_terms")
+    modulus = inst["modulus"]
+    operations = 0
+    for exponent in range(inst["degree"] - 1, -1, -1):
+        operations += 1
+        if source[exponent] and target[exponent]:
+            guess = target[exponent] * pow(source[exponent], -1, modulus) % modulus
+            return _candidate_from_root(inst, guess), operations + 2
+    return None, operations
+
+
+def _attack_random_restart(inst: dict, seed: int, restarts: int = 256) -> tuple[dict | None, int]:
+    rng = random.Random(0xC0DE0000 + seed)
+    operations = 0
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        ok, _reason = verify(inst, candidate)
+        operations += inst["degree"] + 1
+        if ok:
+            return candidate, operations
+    return None, operations
+
+
+def _attack_constant_as_linear(inst: dict) -> tuple[dict | None, int]:
+    source = _dense_from_terms(inst, "source_terms")
+    target = _dense_from_terms(inst, "target_terms")
+    modulus = inst["modulus"]
+    guess = target[0] * pow(source[0], -1, modulus) % modulus
+    return _candidate_from_root(inst, guess), 3
+
+
+def _canonical_dense_pair(inst: dict, swap: bool = False) -> tuple[tuple[int, ...], tuple[int, ...]]:
+    first = _dense_from_terms(inst, "target_terms" if swap else "source_terms")
+    second = _dense_from_terms(inst, "source_terms" if swap else "target_terms")
+    modulus = inst["modulus"]
+    degree = inst["degree"]
+    inverse_constant = pow(first[0], -1, modulus)
+    inverse_degree = pow(degree, -1, modulus - 1)
+    normalizer = pow(inverse_constant, inverse_degree, modulus)
+
+    def scale(poly: list[int]) -> tuple[int, ...]:
+        return tuple(
+            coefficient * pow(normalizer, degree - exponent, modulus) % modulus
+            for exponent, coefficient in enumerate(poly)
+        )
+
+    return scale(first), scale(second)
+
+
+def canonical_key(inst: dict) -> str:
+    """Complete normal form for term order, common exponent scaling, and swap."""
+    forward = _canonical_dense_pair(inst, False)
+    backward = _canonical_dense_pair(inst, True)
+    canonical = min(forward, backward)
+    payload = json.dumps(
+        [inst["modulus"], inst["alphabet_field"], inst["degree"], canonical],
+        separators=(",", ":"),
+    ).encode()
+    return hashlib.sha256(payload).hexdigest()
+
+
+_ESCALATION_FIELDS = {
+    31: 311,
+    1_000_003: 36_000_109,
+    2_000_003: 24_000_037,
+    4_000_037: 56_000_519,
+    8_000_009: 432_000_487,
+    16_000_057: 288_001_027,
+    32_000_011: 1_280_000_441,
+    64_000_031: 384_000_187,
+}
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow modulus and coefficient table while the two-integer witness stays fixed."""
+    try:
+        modulus = int(params["modulus"])
+        n = int(params["n"])
+    except (KeyError, TypeError, ValueError):
+        return None
+    moduli = list(_ESCALATION_FIELDS)
+    if modulus not in _ESCALATION_FIELDS:
+        return None
+    index = moduli.index(modulus)
+    if index + 1 >= len(moduli):
+        return None
+    harder_modulus = moduli[index + 1]
+    # Keep the post-insight check below 300 operations even at the last rung.
+    harder_n = min(247, n + max(20, n // 4))
+    return {
+        "n": harder_n,
+        "modulus": harder_modulus,
+        "field": _ESCALATION_FIELDS[harder_modulus],
+    }
+
+
+def _reorder_terms(inst: dict, rng: random.Random) -> dict:
+    out = dict(inst)
+    out["source_terms"] = [list(term) for term in inst["source_terms"]]
+    out["target_terms"] = [list(term) for term in inst["target_terms"]]
+    rng.shuffle(out["source_terms"])
+    rng.shuffle(out["target_terms"])
+    out["answer"] = dict(inst["answer"])
+    return out
+
+
+def _scale_exponents(inst: dict, scale: int) -> dict:
+    modulus = inst["modulus"]
+    degree = inst["degree"]
+    if not 1 <= scale < modulus:
+        raise ValueError("scale must be a nonzero canonical residue")
+    out = dict(inst)
+    for which in ("source_terms", "target_terms"):
+        dense = _dense_from_terms(inst, which)
+        moved = [
+            coefficient * pow(scale, degree - exponent, modulus) % modulus
+            for exponent, coefficient in enumerate(dense)
+        ]
+        out[which] = _terms_from_dense(moved)
+    out["answer"] = dict(inst["answer"])
+    return out
+
+
+def _swap_codes(inst: dict) -> dict:
+    out = dict(inst)
+    out["source_terms"] = [list(term) for term in inst["target_terms"]]
+    out["target_terms"] = [list(term) for term in inst["source_terms"]]
+    out["answer"] = {
+        "root_multiplier": inst["answer"]["coordinate_multiplier"],
+        "coordinate_multiplier": inst["answer"]["root_multiplier"],
+    }
+    return out
+
+
+def _answer_atoms(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def selftest() -> dict:
+    report: dict = {}
+
+    failures = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 19):
+            attempts += 1
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            json_ok = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            compact, _stats = _compact_recover(inst)
+            if not (ok and json_ok and verify(inst, compact)[0]):
+                failures.append(
+                    {"preset": preset, "seed": seed, "reason": reason, "json": json_ok}
+                )
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "attempts": attempts,
+        "failures": failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=424242, **shipping_params)
+    answer = dict(inst["answer"])
+    corruptions = {
+        "drop": {"root_multiplier": answer["root_multiplier"]},
+        "swap": {
+            "root_multiplier": answer["coordinate_multiplier"],
+            "coordinate_multiplier": answer["root_multiplier"],
+        },
+        "duplicate": {
+            "root_multiplier": answer["root_multiplier"],
+            "coordinate_multiplier": answer["root_multiplier"],
+        },
+        "empty": {},
+        "out_of_range": {
+            "root_multiplier": inst["modulus"],
+            "coordinate_multiplier": answer["coordinate_multiplier"],
+        },
+    }
+    corruption_cases = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        corruption_cases[name] = {"accepted": ok, "reason": reason}
+    reasons = [case["reason"] for case in corruption_cases.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(not case["accepted"] for case in corruption_cases.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": corruption_cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    encoded = json.dumps(answer, separators=(",", ":"))
+    realistic = (
+        "The constant term has the required weight.\n"
+        "```text\nintermediate arithmetic omitted\n```\n"
+        f"<answer>```json\n{encoded}\n```</answer>\n"
+        "This also fixes the coordinate direction."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and parse_answer("garbage") is None,
+        "parsed_matches": parsed == answer,
+        "garbage_returns_none": parse_answer("garbage") is None,
+    }
+
+    rng = random.Random(0x10022456)
+    total = 200_000
+    hits = 0
+    started = time.perf_counter()
+    for _ in range(total):
+        hits += int(verify(inst, random_candidate(inst, rng))[0])
+    guess_wall = time.perf_counter() - started
+    density = hits / total
+    report["G4_guess_resistance"] = {
+        "pass": density < 1e-6,
+        "hits": hits,
+        "total": total,
+        "observed_fraction": density,
+        "candidate_space": search_space(inst),
+        "sampling_prior": (
+            "uniform root multiplier in F_p^*, with its inverse filled in exactly"
+        ),
+        "wall_clock_sec": round(guess_wall, 6),
+    }
+
+    attack_specs = {
+        "outlier_largest_coefficient": lambda obj, seed: _attack_largest_coefficient(obj),
+        "greedy_first_nonzero_ratio": lambda obj, seed: _attack_first_ratio(obj),
+        "random_restart_256": lambda obj, seed: _attack_random_restart(obj, seed, 256),
+        "constant_coefficient_as_linear": lambda obj, seed: _attack_constant_as_linear(obj),
+    }
+    attack_results = {
+        name: {"successes": 0, "attempts": 0, "operations": 0, "wall_clock_sec": 0.0}
+        for name in attack_specs
+    }
+    reference_successes = 0
+    reference_operations = 0
+    reference_candidates = 0
+    reference_wall = 0.0
+    compact_operations = 0
+    compact_wall = 0.0
+    for seed in range(8):
+        attack_inst = make_instance(seed=10_000 + seed, **shipping_params)
+        for name, attack in attack_specs.items():
+            started = time.perf_counter()
+            candidate, operations = attack(attack_inst, seed)
+            elapsed = time.perf_counter() - started
+            success = candidate is not None and verify(attack_inst, candidate)[0]
+            result = attack_results[name]
+            result["successes"] += int(success)
+            result["attempts"] += 1
+            result["operations"] += operations
+            result["wall_clock_sec"] += elapsed
+
+        started = time.perf_counter()
+        recovered, stats = _reference_enumeration(attack_inst)
+        reference_wall += time.perf_counter() - started
+        reference_successes += int(recovered is not None and verify(attack_inst, recovered)[0])
+        reference_operations += stats["operations"]
+        reference_candidates += stats["candidates_tested"]
+
+        started = time.perf_counter()
+        compact, compact_stats = _compact_recover(attack_inst)
+        compact_wall += time.perf_counter() - started
+        compact_operations = max(compact_operations, compact_stats["operations"])
+        if not verify(attack_inst, compact)[0]:
+            failures.append({"compact_seed": seed})
+
+    for result in attack_results.values():
+        result["wall_clock_sec"] = round(result["wall_clock_sec"], 6)
+    all_failed = all(
+        result["successes"] == 0 and result["attempts"] >= 8
+        for result in attack_results.values()
+    )
+    reference = {
+        "name": "Section III multiplier enumeration with constant-coefficient filter",
+        "complexity": "O(p log k + k) exact modular operations in the worst case",
+        "wall_clock_sec": round(reference_wall, 6),
+        "operations": reference_operations,
+        "candidates_tested": reference_candidates,
+        "mean_operations_per_instance": reference_operations / 8,
+        "mean_candidates_per_instance": reference_candidates / 8,
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8 and not failures,
+        "attacks": attack_results,
+        "reference_algorithm": reference,
+        "in_context_attack": "constant_coefficient_as_linear",
+    }
+
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    strongest_name, strongest = max(
+        attack_results.items(), key=lambda item: item[1]["operations"]
+    )
+    report["G5_density_and_baseline"] = {
+        "pass": hits == 0 and demo_count == 1 and reference_successes == 8,
+        "shipping_candidate_space": search_space(inst),
+        "shipping_sampled_valid_hits": hits,
+        "shipping_sampled_valid_total": total,
+        "shipping_sampled_density": density,
+        "mathematical_shipping_solution_count": 1,
+        "uniqueness_reason": "gcd(degree,p-1)=1 makes kth powering bijective",
+        "demo_candidate_count": search_space(demo),
+        "demo_exact_solution_count": demo_count,
+        "strongest_failing_attack": strongest_name,
+        "strongest_failing_attack_operations": strongest["operations"],
+        "strongest_failing_attack_wall_clock_sec": strongest["wall_clock_sec"],
+        "reference_algorithm": reference,
+        "compact_route_max_operations": compact_operations,
+        "compact_route_wall_clock_sec": round(compact_wall, 6),
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] = 2 * shipping_params["n"]
+    doubled = make_instance(seed=91, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["degree"] > 2 * inst["degree"],
+        "shipping_requested_n": inst["requested_n"],
+        "shipping_degree": inst["degree"],
+        "shipping_nonzero_terms": len(inst["source_terms"]) + len(inst["target_terms"]),
+        "doubled_params": doubled_params,
+        "doubled_degree": doubled["degree"],
+        "doubled_nonzero_terms": len(doubled["source_terms"]) + len(doubled["target_terms"]),
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
+        "answer_elements_unchanged": _answer_atoms(doubled["answer"]) == _answer_atoms(inst["answer"]),
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    invariance_failures = []
+    distinct = set()
+    for seed in range(20):
+        base = make_instance(seed=30_000 + seed, **shipping_params)
+        base_key = canonical_key(base)
+        distinct.add(base_key)
+        scale = 2 + (seed * 7919) % (base["modulus"] - 3)
+        reordered = _reorder_terms(base, random.Random(seed))
+        scaled = _scale_exponents(base, scale)
+        swapped = _swap_codes(base)
+        composed = _swap_codes(
+            _reorder_terms(_scale_exponents(base, scale), random.Random(100 + seed))
+        )
+        for name, transformed in (
+            ("term_reordering", reordered),
+            ("common_primitive-root_relabelling", scaled),
+            ("source_target_swap", swapped),
+            ("composed_relabel_reorder_swap", composed),
+        ):
+            invariance_checks += 1
+            if canonical_key(transformed) != base_key:
+                invariance_failures.append({"seed": seed, "transform": name, "kind": "key"})
+            carried_checks += 1
+            if not verify(transformed, transformed["answer"])[0]:
+                invariance_failures.append(
+                    {"seed": seed, "transform": name, "kind": "carried_witness"}
+                )
+    report["G8_canonical_key"] = {
+        "pass": not invariance_failures and len(distinct) == 20,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": carried_checks,
+        "invariance_failures": invariance_failures,
+        "unrelated_instances": 20,
+        "distinct_keys": len(distinct),
+        "transformations": [
+            "polynomial-term reordering",
+            "common change of primitive pth root",
+            "source/target swap with inverse witness",
+            "composition of all three",
+        ],
+        "key_strength": "complete for the declared presentation symmetries",
+    }
+
+    answer_blob = json.dumps(inst["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_elements = _answer_atoms(inst["answer"])
+    answer_tokens = math.ceil(answer_chars / 4)
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and compact_operations <= 300
+    )
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name]) for name in ("bare", "hinted", "placebo")
+    }
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": (
+            arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+            - arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+        ),
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": compact_operations,
+        "within_caps": within_caps,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(shipping_params)
+    report["all_passed"] = all(
+        gate.get("pass", True)
+        for name, gate in report.items()
+        if name.startswith("G") and isinstance(gate, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

diff --git a/gen_1002_2456.py b/gen_1002_2456.py
new file mode 100644
index 0000000000000000000000000000000000000000..f5a1c0db20d38dc4e92bbd3c65cb32c1b730a100
--- /dev/null
+++ b/gen_1002_2456.py
@@ -0,0 +1,1018 @@
+"""Verified cyclic-code multiplier-equivalence generator for arXiv:1002.2456.
+
+Section III of Guenda's paper reduces permutation equivalence of prime-length
+cyclic codes to equivalence by a coordinate multiplier.  This module describes
+each code by a lossless polynomial encoding of its defining zero exponents.
+It samples a defining set and multiplier first, transports the set, and emits
+the two polynomials.  Thus the certificate is carried through a known code
+equivalence; no generated instance is solved to obtain it.
+
+The answer is an exact symbolic multiplier and its inverse.  Verification is
+the finite-field polynomial identity
+
+    D_B(z) = a^k D_A(z/a),
+
+which also proves that coordinate multiplier i -> a^{-1} i carries code A to
+code B under the convention fixed in render().
+"""
+
