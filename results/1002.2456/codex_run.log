+        attack_stats["uniform_random_restart_256"]["successes"] += int(restart_ok)
+        attack_stats["uniform_random_restart_256"]["attempts"] += 1
+
+        start = time.perf_counter()
+        found, operations = _reference_algorithm(inst)
