+def _dense_from_terms(inst: dict, which: str) -> list[int]:
+    degree = inst["degree"]
+    modulus = inst["modulus"]
+    terms = inst[which]
+    dense = [0] * (degree + 1)
+    if not isinstance(terms, list):
+        raise ValueError(f"{which} is not a term list")
+    seen = set()
+    for term in terms:
+        if (
+            not isinstance(term, list)
+            or len(term) != 2
+            or any(isinstance(v, bool) or not isinstance(v, int) for v in term)
+        ):
+            raise ValueError(f"{which} contains a malformed term")
+        coefficient, exponent = term
+        if not 0 <= exponent <= degree or exponent in seen:
+            raise ValueError(f"{which} contains a duplicate or invalid exponent")
+        if not 0 < coefficient < modulus:
+            raise ValueError(f"{which} coefficients must be canonical nonzero residues")
