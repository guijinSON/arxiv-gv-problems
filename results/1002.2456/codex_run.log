+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Transform a known cyclic code by a sampled coordinate multiplier."""
+    if set(params) != {"modulus", "field"}:
+        unknown = sorted(set(params) - {"modulus", "field"})
+        missing = sorted({"modulus", "field"} - set(params))
+        detail = []
