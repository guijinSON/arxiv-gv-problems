_ENUMERATION_CAP = 50_000
_PARAMETER_CACHE: dict[tuple[int, int, int], tuple[int, int, int]] = {}
_VERIFY_CACHE: dict[
    tuple[int, int, tuple[int, ...], tuple[int, ...]],
