+except ImportError:  # The construction below remains standard-library-only.
+    exact_matrices = rationals = None
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "prime-length cyclic codes over a finite field",
+        "defining zero-exponent polynomials over the prime coordinate field",
+        "coordinate multiplier in the affine permutation group",
+    ],
+    "verification_operations": [
+        "exact modular inversion",
+        "finite-field monomial scaling",
+        "exact polynomial coefficient comparison",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section III, opening multiplier criterion (prime length has "
+        "gcd(p,phi(p))=1, so code equivalence is multiplier equivalence)"
+    ),
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Recognize that scaling every defining exponent makes the coefficient "
+        "of z^j homogeneous of weight k-j; without that invariant one enumerates "
+        "the paper's full multiplier set."
+    ),
+    "hardness_basis": (
+        "Track B: Section III's multiplier test enumerates F_p^* and costs "
+        "O(p log k+k) modular operations with the constant-coefficient filter; "
+        "shipping measurements are filled by selftest (about five million "
+        "modular multiplications per instance), while the homogeneous-coefficient "
+        "route takes fewer than 100 exact operations once noticed."
