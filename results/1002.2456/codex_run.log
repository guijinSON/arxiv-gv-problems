+
+
+def escalate(params: dict[str, Any]) -> dict[str, Any] | str | None:
+    try:
+        n = int(params["n"])
+        order = int(params["orbit_order"])
+        count = int(params["orbit_count"])
+    except (KeyError, TypeError, ValueError):
+        return None
