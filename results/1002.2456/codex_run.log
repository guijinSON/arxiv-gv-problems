+def _sample_zero_sum_roots(
+    degree: int, modulus: int, rng: random.Random
+) -> list[int]:
+    """Uniform k-subset sampler conditioned on distinct, nonzero, zero sum."""
+    for _ in range(10_000):
+        prefix = rng.sample(range(1, modulus), degree - 1)
+        last = (-sum(prefix)) % modulus
