+def _validate_parameters(n: int, modulus: int, field: int) -> int:
+    for name, value in (("n", n), ("modulus", modulus), ("field", field)):
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise TypeError(f"{name} must be an integer")
+    if n < 3:
+        raise ValueError("n must be at least 3")
+    if not _is_prime(modulus) or modulus <= 2:
+        raise ValueError("modulus must be an odd prime")
+    if not _is_prime(field) or field % modulus != 1:
+        raise ValueError("field must be prime and congruent to 1 modulo modulus")
+    degree = _degree_at_least(n, modulus)
+    if degree >= modulus - 1:
+        raise ValueError("the defining-set degree must be below modulus-1")
+    return degree
