+        "defining zero-exponent polynomials over the prime coordinate field",
+        "coordinate multiplier in the affine permutation group",
+    ],
+    "verification_operations": [
+        "exact modular inversion",
+        "finite-field monomial scaling",
+        "exact polynomial coefficient comparison",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
