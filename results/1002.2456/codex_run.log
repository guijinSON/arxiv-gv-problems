+def _poly_from_roots(roots: list[int], modulus: int) -> list[int]:
+    """Ascending dense coefficients of prod(z-root) over F_modulus."""
+    coefficients = [1]
+    for root in roots:
+        grown = [0] * (len(coefficients) + 1)
+        for exponent, coefficient in enumerate(coefficients):
+            grown[exponent] = (
+                grown[exponent] - root * coefficient
+            ) % modulus
+            grown[exponent + 1] = (
+                grown[exponent + 1] + coefficient
+            ) % modulus
+        coefficients = grown
+    return coefficients
