+
+def render(inst: dict) -> str:
+    """Render a self-contained cyclic-code multiplier problem."""
+    modulus = inst["modulus"]
+    field = inst["alphabet_field"]
+    degree = inst["degree"]
+    hint = ""
+    mode = os.environ.get("GV_HINT_MODE")
