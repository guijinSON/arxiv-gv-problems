+    steps = 0
+    coefficient_xors = 0
+    db = _poly_degree(b)
+    weight = b.bit_count()
+    while a and _poly_degree(a) >= db:
+        shift = _poly_degree(a) - db
+        quotient ^= 1 << shift
+        a ^= b << shift
+        steps += 1
+        coefficient_xors += weight
