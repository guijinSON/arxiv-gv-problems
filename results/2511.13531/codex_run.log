+
+def _poly_mul(a: int, b: int) -> int:
+    out = 0
+    while b:
+        if b & 1:
+            out ^= a
+        a <<= 1
+        b >>= 1
+    return out
+
+
+def _poly_divmod(a: int, b: int) -> tuple[int, int]:
+    if b <= 0:
+        raise ZeroDivisionError("zero polynomial")
+    quotient = 0
+    db = _poly_degree(b)
+    while a and _poly_degree(a) >= db:
+        shift = _poly_degree(a) - db
+        quotient ^= 1 << shift
+        a ^= b << shift
+    return quotient, a
+
