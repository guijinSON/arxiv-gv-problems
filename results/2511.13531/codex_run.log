+        "swap_one_label": {**planted, "encoding": "lsb0-hex"},
+        "duplicate_vector": {**planted, "vector": [planted["vector"], planted["vector"]]},
+        "empty": {},
+        "out_of_range_length": {**planted, "n": planted["n"] + 1},
