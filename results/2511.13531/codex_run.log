+            "complexity": "O(n^2) GF(2) coefficient operations",
+            "wall_clock_sec": round(reference_seconds, 6),
+            "mean_wall_clock_sec": round(reference_seconds / 8, 6),
+            "word_xor_steps": reference_word_steps,
