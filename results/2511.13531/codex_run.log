+            "total_work": total_work,
+            "wall_seconds": round(time.perf_counter() - t0, 6),
+        }
+
+    reference_successes = 0
+    reference_seconds = 0.0
+    reference_word_steps = 0
+    reference_coefficient_xors = 0
+    for seed in range(8):
