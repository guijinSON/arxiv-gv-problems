+}
+
+DIFFICULTY = {
+    "demo": {"n": 14, "degree": 3, "blocks": 0},
+    "easy": {"n": 62, "degree": 5, "blocks": 1},
+    "medium": {"n": 254, "degree": 7, "blocks": 4},
+    "hard": {"n": 510, "degree": 8, "blocks": 8},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
