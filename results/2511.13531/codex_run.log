+# A primitive binary polynomial for each rung. Its reciprocal product is
+# self-reciprocal and divides x^(2^degree-1)+1.
+_PRIMITIVE = {
+    3: 0b1011,       # x^3 + x + 1
+    5: 0b100101,     # x^5 + x^2 + 1
+    7: 0b10000011,   # x^7 + x + 1
+    8: 0x11D,        # x^8 + x^4 + x^3 + x^2 + 1
