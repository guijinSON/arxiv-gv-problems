+    seen = set()
+    for bits in candidates:
+        bits &= (1 << n) - 1
+        if not bits or bits in seen:
+            continue
+        seen.add(bits)
+        tested += 1
+        if _candidate_ok(inst, bits):
+            return bits, tested
+    return None, tested
