+
+
+def _candidate_ok(inst: dict, bits: int | None) -> bool:
+    return bool(bits) and _kernel_syndrome(inst, bits) == 0
+
+
+def _attack_outlier_degree(inst: dict, rng: random.Random):
+    del rng
