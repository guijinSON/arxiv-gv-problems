+def _rotate_right(mask: int, shift: int, n: int) -> int:
+    shift %= n
+    if shift == 0:
+        return mask
+    low = mask & ((1 << shift) - 1)
+    return (mask >> shift) | (low << (n - shift))
+
+
+def _kernel_syndrome(inst: dict, vector: int) -> int:
+    syndrome = 0
+    n = inst["n"]
+    for offset in inst["connection_offsets"]:
