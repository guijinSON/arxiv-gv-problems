+def _reciprocal_factors(degree: int) -> list[int]:
+    """Products p*p* for non-self-reciprocal irreducibles of given degree."""
+    if degree not in _PRIMITIVE:
+        raise ValueError("degree must be one of 3, 6, 7, 8")
