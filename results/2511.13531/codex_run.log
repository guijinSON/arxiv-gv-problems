+    arms = {
+        key: dict(G9_RESULTS[key]) for key in ("bare", "hinted", "placebo")
+    }
+    hinted_attempts = arms["hinted"]["attempts"]
+    hinted_still_hardened = (
+        G9_RESULTS["hinted_verdict"] == "hardened"
