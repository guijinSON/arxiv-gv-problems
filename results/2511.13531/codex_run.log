+    next_blocks = int(p.get("blocks", 0)) + 4
+    if _hex_width(next_n) + 90 > 2000:
+        return "cap_bound"
+    p["n"] = next_n
+    p["blocks"] = next_blocks
+    return p
+
+
+def _carried_answer(answer: dict, n: int, unit: int, shift: int) -> dict:
