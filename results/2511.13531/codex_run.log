+
+def _unit_multipliers(n: int) -> list[int]:
+    return [u for u in range(1, n) if math.gcd(u, n) == 1]
+
+
+def canonical_key(inst: dict) -> str:
+    n = inst["n"]
+    offsets = inst["connection_offsets"]
+    candidates = []
+    for unit in _unit_multipliers(n):
+        value = 0
+        for d in offsets:
+            value |= 1 << ((unit * d) % n)
+        candidates.append(value)
