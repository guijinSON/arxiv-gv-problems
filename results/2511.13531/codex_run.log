+
+
+def _poly_gcd_cost(a: int, b: int) -> tuple[int, int, int]:
+    word_steps = 0
+    coefficient_xors = 0
+    while b:
+        _, remainder, steps, xors = _poly_divmod_cost(a, b)
+        word_steps += steps
+        coefficient_xors += xors
+        a, b = b, remainder
+    return a, word_steps, coefficient_xors
