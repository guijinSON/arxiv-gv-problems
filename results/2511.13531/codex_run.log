+def _select_shifts(n: int, degree: int, blocks: int,
+                   rng: random.Random) -> list[int]:
+    half = n // 2
+    q_degree = 2 * degree
+    upper = half - 3 * degree - 1
+    if blocks == 0:
+        return []
+    candidates = list(range(1, upper + 1))
+    rng.shuffle(candidates)
