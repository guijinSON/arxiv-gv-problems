import json, os, sys
D = sys.argv[1]
try:
    meta = json.load(open(os.path.join(D, ".meta.json")))
except (OSError, ValueError):
    meta = {}
ver = meta.get("schema_version", 1)
rows = [json.loads(l) for l in open(os.path.join(D, "llm_loop_transcript.jsonl")) if l.strip()]

