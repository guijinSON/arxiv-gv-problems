import json, random, statistics, time
import sympy as s
from fractions import Fraction
x=s.symbols('x')

def params(t):
    t=s.Integer(t)
    c=-(t**6+2*t**5+4*t**4+8*t**3+9*t**2+4*t+1)/(4*t**2*(t+1)**2)
    roots=[
      (t**3+2*t**2+t+1)/(2*t*(t+1)),
      (t**3-t-1)/(2*t*(t+1)),
      -(t**3+2*t**2+3*t+1)/(2*t*(t+1)),
    ]
    return c,roots

def phi3(c):
    f1=x*x+c
    f2=s.expand(f1*f1+c)
    f3=s.expand(f2*f2+c)
    return s.Poly(s.cancel((f3-x)/(f1-x)),x,domain=s.QQ)

rng=random.Random(150907098)
for bits in (16,32,64,96,128,160,192):
    times=[]; chars=[]; cbits=[]; ok=True
    for j in range(8):
        t=rng.getrandbits(bits-1) | (1 << (bits-1)) | 1
        c,roots=params(t)
        p=phi3(c)
        st=time.perf_counter(); fac=s.factor_list(p.as_expr()); times.append(time.perf_counter()-st)
        linear=sum(e for q,e in fac[1] if s.Poly(q,x).degree()==1)
        if linear<3: ok=False
        ans=[]
        for q in roots:
            q=s.cancel(q)
            ans.append([int(s.numer(q)),int(s.denom(q))])
        chars.append(len(json.dumps(ans,separators=(',',':'))))
        cbits.append(max(abs(int(s.numer(c))).bit_length(),int(s.denom(c)).bit_length()))
    print(json.dumps({
      't_bits':bits,'runs':len(times),'factor_median_sec':round(statistics.median(times),6),
      'factor_max_sec':round(max(times),6),'answer_chars_median':statistics.median(chars),
      'answer_chars_max':max(chars),'c_height_bits_median':statistics.median(cbits),'all_factored':ok
    }))

# Count straight-line exact field ops for Prop 4.1(c), using a tiny counter.
class C:
    n=0
    def __init__(self,v): self.v=Fraction(v)
    def _o(self,o): return o if isinstance(o,C) else C(o)
    def __add__(self,o): C.n+=1; return C(self.v+self._o(o).v)
    __radd__=__add__
    def __sub__(self,o): C.n+=1; return C(self.v-self._o(o).v)
    def __rsub__(self,o): C.n+=1; return C(self._o(o).v-self.v)
    def __mul__(self,o): C.n+=1; return C(self.v*self._o(o).v)
    __rmul__=__mul__
    def __truediv__(self,o): C.n+=1; return C(self.v/self._o(o).v)
    def __neg__(self): return C(-self.v)

t=C(7); one=C(1)
t2=t*t; t3=t2*t; t4=t3*t; t5=t4*t; t6=t5*t
tp=t+one; den=2*t*tp
a=(t3+2*t2+t+one)/den
b=(t3-t-one)/den
d=-(t3+2*t2+3*t+one)/den
c=-(t6+2*t5+4*t4+8*t3+9*t2+4*t+one)/(4*t2*tp*tp)
# Verify the cycle by three substitutions, counting each square+add.
y=a
for _ in range(3): y=y*y+c
print(json.dumps({'paper_formula_plus_three_iterate_checks_exact_field_ops':C.n,'verified':y.v==a.v}))
