+        "verify_reason": larger_reason,
+    }
+
+    invariance_checks = carried_checks = 0
+    key_failures = []
+    for seed in range(20):
+        inst = make_instance(seed=9000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(inst)
