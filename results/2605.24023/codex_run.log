+
+    strongest = max(attack_elapsed, key=attack_elapsed.get)
+    per_seed_work = {
+        "balanced_incidence_outlier": 2 * shipping["n"],
+        "paper_style_pairwise_greedy": shipping["n"] * (shipping["n"] + 1),
