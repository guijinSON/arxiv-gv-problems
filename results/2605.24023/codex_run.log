+        "low_period_by_hand_ansatz": lambda inst, rng: _attack_low_period_ansatz(inst),
+        "numeric_step_one_recurrence": lambda inst, rng: _attack_step_one_recurrence(inst),
+    }
+    attack_results = {name: {"successes": 0, "attempts": 0}
