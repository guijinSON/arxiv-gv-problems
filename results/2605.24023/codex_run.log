import random,time

def make(k,mult,seed):
 r=random.Random(seed); n=3*k
 u=list(range(n));r.shuffle(u)
 rows=[tuple(sorted(u[3*i:3*i+3])) for i in range(k)]
 seen=set(rows)
 while len(rows)<int(k*mult):
  t=tuple(sorted(r.sample(range(n),3)))
  if t not in seen:seen.add(t);rows.append(t)
 r.shuffle(rows)
 return n,rows

def solve(n,rows,cap=1000000):
 cols=[[] for _ in range(n)]
 for i,row in enumerate(rows):
  for c in row:cols[c].append(i)
 active_rows=set(range(len(rows))); uncovered=set(range(n));nodes=0
 def rec():
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  if not uncovered:return []
  c=min(uncovered,key=lambda x:sum(i in active_rows for i in cols[x]))
  opts=[i for i in cols[c] if i in active_rows]
  if not opts:return False
  for i in opts:
   row=rows[i]
   conflict=set()
   for x in row:
    for q in cols[x]:
     if q in active_rows: conflict.add(q)
   oldu=[]
   for x in row:
    if x in uncovered:uncovered.remove(x);oldu.append(x)
   active_rows.difference_update(conflict)
   ans=rec()
   active_rows.update(conflict)
   uncovered.update(oldu)
   if ans is None:return None
   if ans is not False:return [i]+ans
  return False
 t=time.perf_counter();ans=rec();return ans,nodes,time.perf_counter()-t
for k in [20,30,40,60,80,100]:
 for mult in [2,3,4,5,6,8]:
  vals=[]
  for s in range(3):
   n,rows=make(k,mult,s);a,nodes,dt=solve(n,rows,2000000);vals.append((nodes,round(dt,3),a is not None))
  print(k,mult,vals)
