+                    for right in range(left + 1, len(planted))
+                    if planted[left] != planted[right] and
+                    int(planted[:left] + planted[right] + planted[left + 1:right] +
+                        planted[left] + planted[right + 1:], 16) < (1 << shipping["n"])),
