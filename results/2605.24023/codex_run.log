+                                     "reason": "carried witness failed"})
+    unrelated = [canonical_key(make_instance(
+        seed=20000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY]
+    )) for seed in range(20)]
+    distinct_keys = len(set(unrelated))
