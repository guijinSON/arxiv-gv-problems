   for x in row:uncovered[x]=True
   for q in conf:active[q]=True
   if ans is None:return None
   if ans is not False:return [i]+ans
  return False
 t=time.perf_counter();ans=rec(left);return nodes,time.perf_counter()-t,ans is not None
for k in [20,30,40,60]:
 for mult in [2,3,4,5]:
