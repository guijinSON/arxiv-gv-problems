+        "demo_exact_valid_answers": enumerate_all(
+            make_instance(seed=3, **DIFFICULTY["demo"])
+        ),
+    }
+
+    doubled_n = 2 * DIFFICULTY[SHIPPING_DIFFICULTY]["n"]
+    while doubled_n % 3 == 0:
