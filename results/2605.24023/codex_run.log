+    gaussian_successes = dpll_successes = compact_successes = 0
+    gaussian_elapsed = dpll_elapsed = 0.0
+    gaussian_operations, gaussian_xors = [], []
+    dpll_evaluations, dpll_nodes, dpll_decisions = [], [], []
+    for seed in attack_seeds:
