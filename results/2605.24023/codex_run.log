import random,time

def make(k,mult,seed):
 r=random.Random(seed); n=3*k; u=list(range(n));r.shuffle(u)
 rows=[tuple(sorted(u[3*i:3*i+3])) for i in range(k)];seen=set(rows)
 while len(rows)<int(k*mult):
  t=tuple(sorted(r.sample(range(n),3)))
  if t not in seen:seen.add(t);rows.append(t)
 r.shuffle(rows);return n,rows

def solve(n,rows,cap=200000):
 cols=[[] for _ in range(n)]
 for i,row in enumerate(rows):
  for c in row:cols[c].append(i)
 active=[True]*len(rows);uncovered=[True]*n;left=n;nodes=0
 def rec(left):
