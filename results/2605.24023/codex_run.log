+
+    realistic = (
+        "I checked all private and repeated directions.\n<answer>\n```text\n" +
+        planted + "\n```\n</answer>\nThe leading zero, if any, is retained."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
