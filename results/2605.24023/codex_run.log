+# Filled from script-owned transcripts after the three oracle runs.  Since
+# 2026-09-05 these arms are diagnostics; G9 gates only the exact size/effort caps.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 1, "attempts": 3},
