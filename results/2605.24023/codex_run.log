+            "relation_to_paper": (
+                "dependency-free exact integer-feasibility stand-in; the paper uses "
+                "MILP branch-and-cut with LP bounds"
+            ),
+            "complexity": "O(2^n * z) worst case",
+            "wall_clock_sec_total_8": round(dpll_elapsed, 6),
