+        "Gauss-Jordan elimination costs O((n+d)n^2) and measured 185,237 scalar "
+        "operations (0.0034 s mean over eight seeds) at shipping n=58,d=180; "
+        "the cyclic cancellation route uses at most 298 exact operations."
+    ),
+    "max_answer_tokens": 5,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": PROBLEM_PROFILE["intuition_type"] + ": " + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
