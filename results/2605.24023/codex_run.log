/bin/bash -lc "python3 -m py_compile gen_2605_24023.py && python3 gen_2605_24023.py > selftest_report.json && python3 - <<'PY'
import importlib.util, io, json, os, random, sys
from contextlib import redirect_stdout, redirect_stderr
buf_out, buf_err = io.StringIO(), io.StringIO()
with redirect_stdout(buf_out), redirect_stderr(buf_err):
    spec=importlib.util.spec_from_file_location('g','gen_2605_24023.py')
    g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
assert not buf_out.getvalue() and not buf_err.getvalue()
r=json.load(open('selftest_report.json'))
assert r['pass'] and r['all_passed']
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.TRACK in ('A','B') and g.SHIPPING_DIFFICULTY=='hard'
assert g.PROBLEM_PROFILE['reduction'] is None and g.NATIVE['reduction'] is None
for seed in range(20):
    inst=g.make_instance(seed=30000+seed, **g.DIFFICULTY['hard'])
    assert g.verify(inst,inst['answer'])==(True,'ok')
    assert json.loads(json.dumps(inst['answer']))==inst['answer']
