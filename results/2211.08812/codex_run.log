import random

def bip(rd,cd,r):
 rem=rd[:]; out=[0]*len(rd); cols=list(enumerate(cd));r.shuffle(cols);cols.sort(key=lambda z:z[1],reverse=True)
 for j,d in cols:
  rows=list(range(len(rem)));r.shuffle(rows);rows.sort(key=lambda i:rem[i],reverse=True)
  assert not d or rem[rows[d-1]]>0
  for i in rows[:d]:out[i]|=1<<j;rem[i]-=1
 assert not any(rem)
 return out

def build(B,d,N,h,seed):
 r=random.Random(seed); q,rem=divmod(N*h,d);cd=[q]*(d-rem)+[q+1]*rem;r.shuffle(cd);sel=bip([h]*N,cd,r);low=(B-1)//2;low-=low%2; rows=[0]*N
 for j in range(d):
  rd=[low+2*((sel[i]>>j)&1) for i in range(N)]; total=sum(rd);q2,rem2=divmod(total,B); cd2=[q2]*(B-rem2)+[q2+1]*rem2;r.shuffle(cd2);assert max(cd2)<=N//2,(j,max(cd2),N//2,total); local=bip(rd,cd2,r)
  for i,m in enumerate(local):
   for b in range(B):
    if m>>b&1:rows[i]|=1<<(b*d+j)
 assert len(set(rows))==N
 return d*low+2*h
for c in [(3,4,11,1),(9,16,43,2),(9,32,83,6),(9,64,163,14),(9,64,323,14),(9,64,643,14),(9,64,1283,14)]:
 for s in range(100): t=build(*c,s)
 print('ok',c,t)
