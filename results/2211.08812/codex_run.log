/bin/bash -lc "python3 - <<'PY'
import importlib.util, json, os, random, sys
p='gen_2211_08812.py'
s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.SHIPPING_DIFFICULTY in ('easy','medium','hard')
for name,params in g.DIFFICULTY.items():
    for seed in range(8):
        a=g.make_instance(seed=seed,**params)
        b=g.make_instance(seed=seed,**params)
        assert a==b
        assert json.loads(json.dumps(a['answer']))==a['answer']
        assert g.verify(a,a['answer'])==(True,'ok')
        tagged='Prose\\n"'```'"\\n<answer>'+a['answer']+'</answer>\\n"'```'"'
        assert g.parse_answer(tagged)==a['answer']
print('determinism/JSON/roundtrip/G1: 32/32')
sys.path.insert(0,os.path.abspath('../../scripts'))
import corpus_report
ship=g.make_instance(seed=1,**g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
profile=corpus_report.profile_for_module(g,ship,family='designs and codes')
print('profile:',json.dumps(profile,sort_keys=True))
# In-memory emit-shaped record proves json.dumps compatibility without writing artifacts.
rec={'paper':'2211.08812','params':{**g.DIFFICULTY['hard'],'seed':1},'question':g.render(ship),'answer':ship['answer'],'search_space':g.search_space(ship)}
blob=json.dumps(rec)
print('emit-shaped JSON bytes:',len(blob.encode()))
print('canonical distinct:',len({g.canonical_key(g.make_instance(seed=s,**g.DIFFICULTY['hard'])) for s in range(40)}),'/40')
