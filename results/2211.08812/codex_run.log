   457	
   458	def canonical_key(inst: dict) -> str:
   459	    """Strong cheap Hamming-metric invariant, independent of output ordering."""
   460	    outputs = inst["outputs"]
   461	    profiles = []
   462	    for word in outputs:
   463	        profiles.append(sorted((word ^ other).bit_count() for other in outputs))
   464	    form = [inst["n"], inst["t"], len(outputs), sorted(profiles)]
   465	    payload = json.dumps(form, separators=(",", ":"))
   466	    return hashlib.sha256(payload.encode("ascii")).hexdigest()
   467	
   468	
   469	def escalate(params: dict) -> dict | str | None:
   470	    """Grow the channel haystack at fixed 255-bit answer length."""
   471	    if not isinstance(params, dict):
   472	        return None
   473	    n = params.get("n")
   474	    channels = params.get("channels")
   475	    t = params.get("t")
   476	    if not all(isinstance(v, int) and not isinstance(v, bool)
   477	               for v in (n, channels, t)):
   478	        return None
   479	    out = dict(params)
   480	    if n < 255:
   481	        out.update({"n": 255, "channels": 43, "t": 9})
   482	        return out
   483	    if channels < 83:
   484	        out["channels"] = 83
   485	        return out
   486	    if channels < 163:
   487	        out["channels"] = 163
   488	        return out
   489	    if channels < 263:
   490	        out["channels"] = 263
   491	        return out
   492	    return None
   493	
   494	
   495	def _decode_one_error(word: int, n: int) -> int:
   496	    syndrome = _syndrome_dense(word, n)
   497	    if syndrome:
   498	        word ^= 1 << (syndrome - 1)
   499	    return word
   500	
   501	
   502	def _reference_majority(inst: dict) -> tuple[str, int]:
   503	    """Section 6 majority followed by standard one-error Hamming decoding."""
   504	    majority = 0
   505	    operations = 0
   506	    threshold = inst["channels"] // 2
   507	    for coordinate in range(inst["n"]):
   508	        ones = 0
   509	        for received in inst["outputs"]:
   510	            ones += (received >> coordinate) & 1
   511	            operations += 1
   512	        if ones > threshold:
   513	            majority |= 1 << coordinate
   514	    decoded = _decode_one_error(majority, inst["n"])
   515	    operations += 3 * inst["r"] + 1
   516	    return _format_word(decoded, inst["n"]), operations
   517	
   518	
   519	def _compact_xor_decode(inst: dict) -> tuple[str, int]:
   520	    """Composition shortcut: global XOR, r parity reductions, one correction."""
   521	    aggregate = 0
   522	    for received in inst["outputs"]:
   523	        aggregate ^= received
   524	    decoded = _decode_one_error(aggregate, inst["n"])
   525	    operations = inst["channels"] + 3 * inst["r"] + 1
   526	    return _format_word(decoded, inst["n"]), operations
   527	
   528	
   529	def _raw_weight_outlier(inst: dict) -> str:
   530	    target = min(
   531	        inst["outputs"],
   532	        key=lambda word: (word.bit_count(), word),
   533	    )
   534	    return _format_word(_decode_one_error(target, inst["n"]), inst["n"])
   535	
   536	
   537	def _medoid_attack(inst: dict) -> str:
   538	    outputs = inst["outputs"]
   539	    target = min(
   540	        outputs,
   541	        key=lambda word: (
   542	            sum((word ^ other).bit_count() for other in outputs),
   543	            word,
   544	        ),
   545	    )
   546	    return _format_word(_decode_one_error(target, inst["n"]), inst["n"])
   547	
   548	
   549	def _random_restart_attack(inst: dict, rng: random.Random,
   550	                           restarts: int = 256) -> tuple[str, int]:
   551	    last = random_candidate(inst, rng)
   552	    for iteration in range(1, restarts + 1):
   553	        last = random_candidate(inst, rng)
   554	        if verify(inst, last)[0]:
   555	            return last, iteration
   556	    return last, restarts
   557	
   558	
   559	def _xor_only_attack(inst: dict) -> str:
   560	    aggregate = 0
   561	    for received in inst["outputs"]:
   562	        aggregate ^= received
   563	    return _format_word(aggregate, inst["n"])
   564	
   565	
   566	def _majority_theorem_lhs(inst: dict) -> int:
   567	    counts = []
   568	    for coordinate in range(inst["n"]):
   569	        ones = sum((word >> coordinate) & 1 for word in inst["outputs"])
   570	        counts.append(min(ones, inst["channels"] - ones))
   571	    counts.sort(reverse=True)
   572	    return sum(inst["channels"] - m for m in counts[:2]) + sum(counts[2:])
   573	
   574	
   575	def _rotate_label(coordinate: int, r: int) -> int:
   576	    return ((coordinate << 1) & ((1 << r) - 1)) | (coordinate >> (r - 1))
   577	
   578	
   579	def _coordinate_automorphism(word: int, n: int) -> int:
   580	    r = _r_for_length(n)
   581	    transformed = 0
   582	    rest = word
   583	    while rest:
   584	        bit = rest & -rest
   585	        old = bit.bit_length()
   586	        new = _rotate_label(old, r)
   587	        transformed |= 1 << (new - 1)
   588	        rest ^= bit
   589	    return transformed
   590	
   591	
   592	def _transform_instance(inst: dict, *, reorder: list[int] | None = None,
   593	                        translate: int = 0, automate: bool = False) -> dict:
   594	    """Carry the instance and answer through true Hamming-code symmetries."""
   595	    if _syndrome_sparse(translate):
   596	        raise ValueError("translation must be a Hamming codeword")
   597	    n = inst["n"]
   598	
   599	    def carry(word: int) -> int:
   600	        value = word ^ translate
   601	        return _coordinate_automorphism(value, n) if automate else value
   602	
   603	    outputs = [carry(word) for word in inst["outputs"]]
   604	    if reorder is not None:
   605	        if sorted(reorder) != list(range(len(outputs))):
   606	            raise ValueError("reorder must be a permutation of output rows")
   607	        outputs = [outputs[i] for i in reorder]
   608	    answer_word = carry(int(inst["answer"], 16))
   609	    transformed = dict(inst)
   610	    transformed["outputs"] = outputs
   611	    transformed["answer"] = _format_word(answer_word, n)
   612	    return transformed
   613	
   614	
   615	def _find_radius_corruption(inst: dict) -> str:
   616	    original = int(inst["answer"], 16)
   617	    n = inst["n"]
   618	    for a in range(1, min(n, 32) + 1):
   619	        for b in range(a + 1, min(n, 63) + 1):
   620	            c = a ^ b
   620	            c = a ^ b
   621	            if not (1 <= c <= n) or c in (a, b):
   622	                continue
   623	            other = original ^ (1 << (a - 1)) ^ (1 << (b - 1)) ^ (1 << (c - 1))
   624	            candidate = _format_word(other, n)
   625	            ok, reason = verify(inst, candidate)
   626	            if not ok and reason.startswith("word exceeds radius"):
   627	                return candidate
   628	    raise AssertionError("could not make an in-code radius corruption")
