-_ANSWER_RE = re.compile(r"<answer\b[^>]*>\s*(?:0x)?([0-9a-fA-F]+)\s*</answer\s*>", re.I | re.S)
-_HEX_RE = re.compile(r"^[0-9a-fA-F]+$")
-_ENUMERATION_CAP = 65_536
