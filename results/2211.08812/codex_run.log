print('demo answer:',i['answer'],g.verify(i,i['answer']))
print('render default hint absent:',g.STRUCTURAL_HINT not in g.render(i) and g.PLACEBO_HINT not in g.render(i))
print('structural hint present:',g.STRUCTURAL_HINT in (lambda:None).__repr__() if False else g.STRUCTURAL_HINT in (os.environ.__setitem__('GV_HINT_MODE','structural') or g.render(i)))
os.environ.pop('GV_HINT_MODE',None)
