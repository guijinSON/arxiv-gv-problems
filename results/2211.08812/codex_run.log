+def _coordinate_automorphism(word: int, n: int) -> int:
+    r = _r_for_length(n)
+    transformed = 0
+    rest = word
+    while rest:
+        bit = rest & -rest
+        old = bit.bit_length()
+        new = _rotate_label(old, r)
+        transformed |= 1 << (new - 1)
+        rest ^= bit
+    return transformed
