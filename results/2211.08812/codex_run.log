/bin/bash -lc "python3 - <<'PY'
import random
import gen_2211_08812 as g
for name, params in g.DIFFICULTY.items():
    seen=set()
    wins={\"weight\":0,\"medoid\":0,\"plurality\":0,\"partial\":0}
    for seed in range(200):
        inst=g.make_instance(seed=seed,**params)
        assert g.verify(inst,inst['answer'])[0]
        assert g._compact_prefix_xor(inst)[0] == inst['answer']
        assert g._reference_payload_majority(inst)[0] == inst['answer']
        assert g._majority_theorem_lhs(inst)>inst['t']*inst['channels']
        seen.add(g.canonical_key(inst))
        if name "'!= '"'demo':
            wins['weight'] += g.verify(inst,g._raw_weight_outlier(inst))[0]
            wins['medoid'] += g.verify(inst,g._medoid_attack(inst))[0]
            wins['plurality'] += g.verify(inst,g._hex_plurality_attack(inst))[0]
            wins['partial'] += g.verify(inst,g._three_row_xor_attack(inst))[0]
    print(name, 'keys',len(seen),'attacks',wins)
params=dict(g.DIFFICULTY['hard'])
for level in range(6):
    params=g.escalate(params)
    inst=g.make_instance(seed=900+level,**params)
    assert g.verify(inst,inst['answer'])[0]
    assert g._compact_prefix_xor(inst)[0] == inst['answer']
    print('escalated',level+1,params['n'],params['t'],len(g.render(inst)))
