-def parse_answer(text: object) -> object | None:
-    """Extract one tagged fixed-width-looking hexadecimal word."""
-    if not isinstance(text, str):
-        return None
-    matches = _ANSWER_RE.findall(text)
-    if len(matches) != 1:
-        return None
-    return matches[0].lower()
