+    "token_measure": "conservative one-token-per-character upper bound",
+    "caps": {
+      "chars": 2000,
+      "tokens": 500,
+      "elements": 256,
+      "operations": 300
+    }
+  },
+  "all_passed": true,
+  "external_hardening_complete": false
+}

