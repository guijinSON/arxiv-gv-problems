+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_count": search_space(demo),
+        "baseline_attack": "Section 6 coordinatewise majority plus Hamming decoding",
+        "baseline_wall_seconds_8_instances": reference_elapsed,
