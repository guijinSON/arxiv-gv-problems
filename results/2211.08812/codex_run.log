   421	def random_candidate(inst: dict, rng: random.Random) -> object:
   422	    """Uniformly sample the statement-implied Hamming-code candidate space."""
   423	    if not isinstance(rng, random.Random):
   424	        raise TypeError("rng must be an instance of random.Random")
   425	    return _format_word(_uniform_codeword(inst["n"], rng), inst["n"])
   426	
   427	
   428	def search_space(inst: dict) -> int | None:
   429	    """Exact number 2^(n-r) of words in the declared Hamming code."""
   430	    return 1 << (inst["n"] - inst["r"])
   431	
   432	
   433	def enumerate_all(inst: dict) -> int | None:
   434	    """Count all valid codewords only when the full code is safely small."""
   435	    space = search_space(inst)
   436	    if space is None or space > _ENUMERATION_CAP:
   437	        return None
   438	    data_coordinates = [
   439	        i for i in range(1, inst["n"] + 1) if i & (i - 1)
   440	    ]
   441	    hits = 0
   442	    for payload in range(space):
   443	        word = 0
   444	        for bit_index, coordinate in enumerate(data_coordinates):
   445	            if payload & (1 << bit_index):
   446	                word |= 1 << (coordinate - 1)
   447	        syndrome = _syndrome_sparse(word)
   448	        parity = 1
   449	        while parity <= inst["n"]:
   450	            if syndrome & parity:
   451	                word |= 1 << (parity - 1)
   452	            parity <<= 1
   453	        if verify(inst, _format_word(word, inst["n"]))[0]:
   454	            hits += 1
   455	    return hits
