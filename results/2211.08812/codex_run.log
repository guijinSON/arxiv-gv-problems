+def _weight_three_witness(n: int, payload_nibbles: int) -> int:
+    """Exhibit a weight-three codeword, proving the subcode has e=1."""
+    mask = _payload_mask(n, payload_nibbles)
+    coordinates = [
+        coordinate for coordinate in range(1, n + 1)
+        if mask & (1 << (coordinate - 1))
+    ]
+    for left_index, left in enumerate(coordinates):
+        for right in coordinates[left_index + 1:]:
+            parity = left ^ right
+            if 1 <= parity <= n and not parity & (parity - 1):
+                word = (
+                    (1 << (left - 1))
+                    | (1 << (right - 1))
+                    | (1 << (parity - 1))
+                )
+                if _syndrome_sparse(word) == 0:
+                    return word
