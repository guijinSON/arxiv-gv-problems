import importlib.util, json
s=importlib.util.spec_from_file_location('g','gen_2211_08812.py'); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
checks=0
for name,p in g.DIFFICULTY.items():
 keys=set()
 for seed in range(500):
  a=g.make_instance(seed=seed,**p); b=g.make_instance(seed=seed,**p)
  assert a==b
  assert g.verify(a,a['answer'])==(True,'ok')
  assert len(set(a['outputs']))==a['channels']
  assert all((y"'^int(a['"'answer'],16)).bit_count()==a['t'] for y in a['outputs'])
  counts=[sum((y>>j)&1 for y in a['outputs']) for j in range(a['n'])]
  x=int(a['answer'],16)
  errors=[c if not ((x>>j)&1) else a['channels']-c for j,c in enumerate(counts)]
  assert max(errors)*2<a['channels']
  assert sum(d&1 for d in errors)==1
  keys.add(g.canonical_key(a)); checks+=1
 assert len(keys)==500,(name,len(keys))
 print(name,'500 deterministic instances and keys passed')
print('total',checks)
