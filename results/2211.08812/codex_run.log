/bin/bash -lc "python3 - <<'PY'
import random

def bip(rd, cd, rng):
    rem=rd[:]; out=[0]*len(rd)
    cols=list(enumerate(cd)); rng.shuffle(cols); cols.sort(key=lambda z:z[1],reverse=True)
    for j,d in cols:
      rows=list(range(len(rem))); rng.shuffle(rows); rows.sort(key=lambda i:rem[i],reverse=True)
      pick=rows[:d]
      if d and (len(pick)<d or rem[pick[-1]]<=0): raise ValueError(('failcol',j,d,rem))
      for i in pick: out[i]|=1<<j; rem[i]-=1
    if any(rem): raise ValueError(('rem',rem))
    return out

def build(B,d,N,h,seed):
 rng=random.Random(seed)
 colsel=[N*h//d]*(d-(N*h%d))+[N*h//d+1]*(N*h%d)
 rng.shuffle(colsel)
 selects=bip([h]*N,colsel,rng)
 low=(B-1)//2
 if low%2: low-=1
 rows=[0]*N
 for logical in range(d):
   rdeg=[low+2*((selects[i]>>logical)&1) for i in range(N)]
   total=sum(rdeg); base,extra=divmod(total,B)
   cdeg=[base]*(B-extra)+[base+1]*extra; rng.shuffle(cdeg)
   assert max(cdeg)<=N//2,(B,d,N,h,logical,max(cdeg),N//2,total)
   local=bip(rdeg,cdeg,rng)
   for i,bmask in enumerate(local):
     for block in range(B):
       if bmask>>block&1: rows[i]|=1<<(block*d+logical)
 t=d*low+2*h
 assert all(x.bit_count()==t for x in rows)
 assert len(set(rows))==N
 for logical in range(d):
   assert all(sum((rows[i]>>(block*d+logical))&1 for i in range(N))<=N//2 for block in range(B))
   assert all(sum((rows[i]>>(block*d+logical))&1 for block in range(B))%2==0 for i in range(N))
 return rows,t
