+            guess_hits += 1
+    guess_density = guess_hits / guess_total
+    assert guess_density < 1e-6, (guess_hits, guess_total)
+    report["G4_guess_resistance"] = {
+        "pass": True,
+        "hits": guess_hits,
+        "total": guess_total,
