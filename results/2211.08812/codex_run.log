+    remaining = list(row_degrees)
+    rows = [0] * len(row_degrees)
+    columns = list(enumerate(column_degrees))
+    rng.shuffle(columns)
+    columns.sort(key=lambda item: item[1], reverse=True)
+    for column, degree in columns:
+        order = list(range(len(rows)))
