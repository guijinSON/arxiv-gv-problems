+"""Verified generators for Levenshtein sequence reconstruction instances.
+
+The native objects are binary words, a one-error-correcting Hamming code, and
+distinct channel outputs in Hamming balls, exactly as in arXiv:2211.08812.
+Generation is inverse: sample the transmitted codeword first, then compose
+constant-weight channel-error identities whose total XOR is a singleton.
+"""
+
+from __future__ import annotations
+
+import functools
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
