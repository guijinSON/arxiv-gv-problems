-def render(inst: dict) -> str:
-    """Render the complete self-contained problem statement."""
-    n = inst["n"]
-    r = inst["r"]
-    width = _width(n)
-    rows = "\n".join(
-        f"  {i + 1}: {_format_word(word, n)}"
-        for i, word in enumerate(inst["outputs"])
