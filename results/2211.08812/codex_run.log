+    assert parse_answer("<answer>not hexadecimal</answer>") is None
+    assert parse_answer("<answer>0</answer><answer>1</answer>") is None
+    report["G3_round_trip"] = {
+        "pass": True,
+        "json_native": True,
+        "answer_hex_digits": len(answer),
+    }
