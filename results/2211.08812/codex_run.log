+    "native_objects": [
+        "binary Hamming code",
+        "distinct received words in binary Hamming space",
+    ],
+    "verification_operations": [
+        "GF(2) parity-check syndrome",
+        "exact bitwise XOR",
+        "exact Hamming-distance comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "A global XOR cancellation compresses all channel outputs to a word one "
+        "Hamming error from the answer; without it one performs the paper's "
+        "coordinate-by-coordinate majority scan."
+    ),
+    "hardness_basis": (
+        "Track B: Section 6 states that majority reconstruction is optimal-time "
+        "Theta(Nn); at shipping n=255 and N=43 it inspects 10,965 channel bits "
+        "and solves 8/8 instances, while the composed XOR-and-syndrome route uses "
+        "at most 68 exact word operations (wall-clock measurements are in G5/G6)."
+    ),
+    "max_answer_tokens": 66,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
