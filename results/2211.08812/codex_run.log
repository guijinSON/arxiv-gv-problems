   376	
   377	def parse_answer(text: object) -> object | None:
   378	    """Extract one tagged fixed-width-looking hexadecimal word."""
   379	    if not isinstance(text, str):
   380	        return None
   381	    matches = _ANSWER_RE.findall(text)
   382	    if len(matches) != 1:
   383	        return None
   384	    return matches[0].lower()
   385	
   386	
   387	def _answer_to_word(inst: dict, answer: object) -> tuple[int | None, str | None]:
   388	    width = _width(inst["n"])
   389	    if not isinstance(answer, str) or not answer:
   390	        return None, "answer must be a nonempty hexadecimal string"
   391	    if not _HEX_RE.fullmatch(answer):
   392	        return None, "answer contains a non-hexadecimal character"
   393	    if len(answer) < width:
   394	        return None, f"hexadecimal answer is too short ({len(answer)}<{width})"
   395	    if len(answer) > width:
   396	        return None, f"hexadecimal answer is too long ({len(answer)}>{width})"
   397	    word = int(answer, 16)
   398	    if word >= 1 << inst["n"]:
   399	        return None, f"value has a 1 outside coordinates 1..{inst['n']}"
   400	    return word, None
   401	
   402	
   403	def verify(inst: dict, answer: object) -> tuple[bool, str]:
   404	    """Check any candidate codeword directly; never inspect inst['answer']."""
   405	    word, error = _answer_to_word(inst, answer)
   406	    if error is not None or word is None:
   407	        return False, error or "malformed answer"
   408	    syndrome = _syndrome_dense(word, inst["n"])
   409	    if syndrome:
   410	        return False, f"word is not in the Hamming code (syndrome {syndrome})"
   411	    for index, received in enumerate(inst["outputs"], 1):
   412	        distance = (word ^ received).bit_count()
   413	        if distance > inst["t"]:
   414	            return False, (
   415	                f"word exceeds radius {inst['t']} at channel {index} "
   416	                f"(distance {distance})"
   417	            )
   418	    return True, "ok"
   419	
