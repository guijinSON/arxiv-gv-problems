\begin{corollary}\label{YB raja e-error l=2COR}
Let $n\geq  n(e,\ell,b)$, $b\geq\max\{3t,4e+4\}$ and $\ell\geq2$. If $$N\geq N'=\sum_{i_1,i_2,i_3,i_4}\binom{n-3e-3}{i_1}\binom{e+1}{i_2}\binom{e+1}{i_3}\binom{e+1}{i_4}+1$$ for \begin{itemize}
\item $0\leq i_1\leq \ell-1$,
\item $0\leq i_4\leq \ell-1-i_1$, 
\item $0\leq i_3\leq \ell-1-i_1$ and 
\item $i_1+i_3+i_4-(\ell-1)\leq i_2\leq \ell-1-i_1-|i_4-i_3|$,
\end{itemize}  then $\mathcal{L}\leq2$ for any $e$-error-correcting code $C$ and value $N'$ is equal to the lower bound obtained in Theorem \ref{YB raja l=2}.
\end{corollary}
