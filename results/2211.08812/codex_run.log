+def _balanced_degrees(total: int, count: int, rng: random.Random) -> list[int]:
+    base, extra = divmod(total, count)
+    degrees = [base] * (count - extra) + [base + 1] * extra
+    rng.shuffle(degrees)
+    return degrees
 
 
