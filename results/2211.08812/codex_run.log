+def _bipartite_rows(row_degrees: list[int], column_degrees: list[int],
+                    rng: random.Random) -> list[int]:
+    """Random-tie Havel-Hakimi realization of a bipartite degree sequence."""
+    if sum(row_degrees) != sum(column_degrees):
