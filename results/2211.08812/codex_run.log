   329	def render(inst: dict) -> str:
   330	    """Render the complete self-contained problem statement."""
   331	    n = inst["n"]
   332	    r = inst["r"]
   333	    width = _width(n)
   334	    rows = "\n".join(
   335	        f"  {i + 1}: {_format_word(word, n)}"
   336	        for i, word in enumerate(inst["outputs"])
   337	    )
   338	    text = f"""Levenshtein sequence reconstruction over GF(2)
   339	
   340	A binary word has n={n} coordinates b_1,...,b_n.  It is written as exactly
   341	{width} hexadecimal digits, including leading zeroes and without a 0x prefix,
   342	using the integer convention value=sum(b_i*2^(i-1)).  Thus coordinate 1 is the
   343	least significant bit.  Hexadecimal is only a compact exact notation for the
   344	binary word.
   345	
   346	For two words u and v, their Hamming distance d(u,v) is the number of 1 bits in
   347	u XOR v.  Let C be the binary Hamming code with parity-check columns equal to
   348	the nonzero {r}-bit coordinate labels 1,...,{n}.  Explicitly, c belongs to C if
   349	and only if the bitwise XOR of every 1-based index i for which c_i=1 is zero.
   350	This code has minimum distance 3 and corrects one substitution error (e=1).
   351	
   352	An unknown transmitted codeword x in C was sent through N={inst['channels']}
   353	channels.  The N outputs below are distinct, and every output differs from x in
   354	at most t={inst['t']} coordinates (so ell=t-e={inst['ell']}).  The numbered lines
   355	are an unordered set; their displayed order and line numbers carry no meaning.
   356	
   357	Received words:
   358	{rows}
   359	
   360	Find any codeword c in C satisfying d(c,y)<=t for every displayed received word
   361	y.  Equality at distance t is allowed.  The answer is one fixed-width
   362	{width}-digit hexadecimal word; letter case is ignored, repeats are not an
   363	additional notion, and no coordinate may lie outside 1..{n}.
   364	
   365	Give your final answer inside <answer></answer> tags, as exactly {width}
   366	hexadecimal digits with no 0x prefix.
   367	Example format: <answer>{'0' * (width - 1)}1</answer>
   368	Output nothing else inside the tags."""
   369	    mode = os.environ.get("GV_HINT_MODE")
   370	    if mode == "structural":
   371	        text += "\n\nHint: " + STRUCTURAL_HINT
   372	    elif mode == "placebo":
   373	        text += "\n\nHint: " + PLACEBO_HINT
   374	    return text
