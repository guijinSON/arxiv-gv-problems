        tree = ast.parse(open(f, encoding="utf-8", errors="ignore").read())
    except Exception:
        continue
    for n in ast.walk(tree):
        if isinstance(n, ast.Assign):
            for t in n.targets:
                if isinstance(t, ast.Name) and t.id == "STRUCTURAL_HINT":
                    try:
                        hint = " ".join(str(ast.literal_eval(n.value)).split())
                    except Exception:
                        pass
    if hint:
