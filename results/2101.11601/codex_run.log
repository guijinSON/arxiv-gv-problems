import random, time, statistics

def instance(n, seed, layers):
    rng=random.Random(seed)
    cycles=[]; used=set()
    for j in range(layers):
        for _ in range(10000):
            order=list(range(n)); rng.shuffle(order)
            arcs={(order[i],order[(i+1)%n]) for i in range(n)}
            if not (arcs & used):
                cycles.append(order); used |= arcs; break
        else: raise RuntimeError
    s=cycles[0][0]
    adj=[[] for _ in range(n)]
    for u,v in used: adj[u].append(v)
    for row in adj: rng.shuffle(row)
    return s, adj

def attack(s, adj, cap=2_000_000):
    n=len(adj); used=[False]*n; path=[s]; used[s]=True
    nodes=0; probes=0
    def dfs(u):
        nonlocal nodes, probes
        nodes += 1
        if nodes>cap: return False
        if len(path)==n: return True
        cand=[]
        for v in adj[u]:
            probes += 1
            if not used[v]:
                onward=0
                for w in adj[v]:
                    probes += 1
                    onward += not used[w]
                cand.append((onward,v))
        cand.sort()
        for _,v in cand:
            used[v]=True; path.append(v)
            if dfs(v): return True
            path.pop(); used[v]=False
        return False
    t=time.perf_counter(); ok=dfs(s); elapsed=time.perf_counter()-t
    return ok,nodes,probes,elapsed

for layers in (2,3,4,6,8):
    rows=[]
    for seed in range(20):
        s,a=instance(256,10000+seed,layers)
        rows.append(attack(s,a))
    succ=sum(x[0] for x in rows)
    print(layers, succ, 'nodes_med',statistics.median(x[1] for x in rows),'nodes_max',max(x[1] for x in rows),'probes_med',statistics.median(x[2] for x in rows),'sec_med',statistics.median(x[3] for x in rows),'sec_max',max(x[3] for x in rows))
