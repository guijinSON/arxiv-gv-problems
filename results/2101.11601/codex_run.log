import random,time,statistics

def instance(n,seed,layers):
 r=random.Random(seed); used=set()
 for _ in range(layers):
  while True:
   p=list(range(n)); r.shuffle(p); es={(p[i],p[(i+1)%n]) for i in range(n)}
   if not es&used: used|=es; break
