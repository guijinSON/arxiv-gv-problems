  nonlocal probes
  opts=adj[u][:];rng.shuffle(opts)
  for v in opts:
   probes+=1
   if seen[v]:continue
   seen[v]=1
   if mt[v]<0 or aug(mt[v],seen):mt[v]=u;return True
  return False
