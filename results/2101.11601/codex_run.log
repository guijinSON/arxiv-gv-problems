    used = set()
    planted = None
    for layer in range(layers):
        while True:
            order = list(range(n))
            rng.shuffle(order)
            arcs = {(order[i], order[(i + 1) % n]) for i in range(n)}
            if not arcs & used:
                used |= arcs
                if planted is None:
                    planted = order
                break
    adjacency = [[] for _ in range(n)]
    for u, v in used:
        adjacency[u].append(v)
    for row in adjacency:
        rng.shuffle(row)
    return planted[0], adjacency

def randomized_matching(adjacency, rng):
    n = len(adjacency)
    matched_tail = [-1] * n
    probes = 0
    order = list(range(n))
    rng.shuffle(order)
    def augment(u, seen):
        nonlocal probes
        choices = adjacency[u][:]
        rng.shuffle(choices)
        for v in choices:
            probes += 1
            if seen[v]:
                continue
            seen[v] = True
            if matched_tail[v] < 0 or augment(matched_tail[v], seen):
                matched_tail[v] = u
                return True
        return False
    for u in order:
        if not augment(u, [False] * n):
            return None, probes
    successor = [-1] * n
    for v, u in enumerate(matched_tail):
        successor[u] = v
    return successor, probes

def is_one_cycle(successor):
    x = 0
    for i in range(len(successor)):
        x = successor[x]
        if x == 0:
            return i == len(successor) - 1
    return False

def attack(adjacency, seed, limit=1000):
    rng = random.Random(seed)
    probes = 0
    started = time.perf_counter()
    for attempt in range(1, limit + 1):
        successor, used_probes = randomized_matching(adjacency, rng)
        probes += used_probes
        if successor is not None and is_one_cycle(successor):
            return {\"solved\": True, \"matchings\": attempt, \"arc_probes\": probes,
                    \"wall_clock_sec\": time.perf_counter() - started}
    return {\"solved\": False, \"matchings\": limit, \"arc_probes\": probes,
            \"wall_clock_sec\": time.perf_counter() - started}

rows = []
for i in range(20):
    start, adjacency = make_instance(256, 10000 + i)
    row = attack(adjacency, 20000 + i)
    row[\"seed\"] = 10000 + i
    rows.append(row)
summary = {
    \"n\": 256,
    \"degree\": 4,
    \"successes\": sum(row[\"solved\"] for row in rows),
    \"attempts\": len(rows),
    \"matching_trials_median\": statistics.median(row[\"matchings\"] for row in rows),
    \"matching_trials_max\": max(row[\"matchings\"] for row in rows),
    \"arc_probes_median\": statistics.median(row[\"arc_probes\"] for row in rows),
    \"arc_probes_max\": max(row[\"arc_probes\"] for row in rows),
    \"wall_clock_total_sec\": sum(row[\"wall_clock_sec\"] for row in rows),
    \"wall_clock_median_sec\": statistics.median(row[\"wall_clock_sec\"] for row in rows),
    \"wall_clock_max_sec\": max(row[\"wall_clock_sec\"] for row in rows),
}
print(json.dumps(summary, indent=2))
print(json.dumps(rows, indent=2))
