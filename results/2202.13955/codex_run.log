+def _attack_column_majority(inst: dict, rng: random.Random) -> list[int]:
+    del rng
+    labels = inst["labels"]
+    threshold = len(labels) / 2
+    return [
+        int(sum((label >> bit) & 1 for label in labels) > threshold)
+        for bit in range(inst["dimension"])
+    ]
