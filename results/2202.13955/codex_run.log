+        "in O(m d^2) bit operations; at the hard preset (d=96,m=174) it "
+        "measured a median 815,912 counted bit operations and 0.015 seconds "
+        "over eight seeds, whereas the XOR route uses 211 exact word/bit "
+        "operations."
+    ),
+    "max_answer_tokens": 49,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
