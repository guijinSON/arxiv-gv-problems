+    guess_seconds = time.perf_counter() - start
+    probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": probability,
+        "language_size": search_space(shipping),
