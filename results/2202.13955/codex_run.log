import importlib.util, time
spec=importlib.util.spec_from_file_location('g','gen_2202_13955.py')
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
inst=g.make_instance(seed=0,**g.DIFFICULTY['demo'])
N=inst['source_vertices']; m=len(inst['edges']); pp=inst['paper']
next_id=0
def block(size):
    global next_id
    out=list(range(next_id,next_id+size)); next_id+=size; return out
V=[]
for i in range(N):
    V.append({'Kp':block(pp['q']),'Kpp':block(pp['q']),'Sp':block(pp['p']),'Spp':block(pp['p'])})
E=[]
for j in range(m):
    E.append({'Kp':block(pp['q_edge']),'Kpp':block(pp['q_edge']),'Sp':block(pp['p_edge']),'Spp':block(pp['p_edge'])})
links={}
for j,(u,v) in enumerate(inst['edges']):
    for x in (u,v): links[(x,j)]=(block(1)[0],block(1)[0])
pi=[]; pip=[]
edge_rank={e:r for r,e in enumerate(inst['edge_order'])}
vertex_rank={v:r for r,v in enumerate(inst['vertex_order'])}
for i in inst['vertex_order']:
    inc=sorted((j for j,e in enumerate(inst['edges']) if i in e),key=edge_rank.get)
    C=[x for j in inc for x in links[(i,j)]]
    b=V[i]
    pi += b['Kp']+b['Sp']+b['Spp']+C+b['Kpp']
    pip += b['Sp']+b['Kpp'][::-1]+b['Kp'][::-1]+b['Spp']
for j in inst['edge_order']:
    u,v=inst['edges'][j]
    if vertex_rank[u]>vertex_rank[v]:u,v=v,u
    b=E[j]
    pi += b['Sp']+b['Kpp'][::-1]+b['Kp'][::-1]+b['Spp']
    pip += b['Kp']+list(links[(v,j)])[::-1]+b['Sp']+list(links[(u,j)])[::-1]+b['Spp']+b['Kpp']
assert len(pi)==len(pip)==next_id==pp['expanded_vertices'],(len(pi),len(pip),next_id,pp['expanded_vertices'])
assert len(set(pi))==next_id and len(set(pip))==next_id
pos=[0]*next_id
for k,x in enumerate(pip):pos[x]=k

def colors(answer):
    mask=sum(b<<i for i,b in enumerate(answer))
    side=[(mask & lab).bit_count()&1 for lab in inst['labels']]
    c=[0]*next_id
    for i,b in enumerate(V):
        s=side[i]
        for name in ('Kp','Spp'): 
            for x in b[name]: c[x]=s
        for name in ('Kpp','Sp'):
            for x in b[name]: c[x]=1-s
    for (i,j),pair in links.items():
        for x in pair:c[x]=side[i]
    for j,b in enumerate(E):
        u,v=inst['edges'][j]
        if vertex_rank[u]>vertex_rank[v]:u,v=v,u
        s=side[u]
        for name in ('Kp','Spp'):
            for x in b[name]:c[x]=s
        for name in ('Kpp','Sp'):
            for x in b[name]:c[x]=1-s
    return c,side

def crossing(c):
    size=next_id
    bits=[[0]*(size+1) for _ in range(2)]
    totals=[0,0]
    out=0
    for x in pi:
        p=pos[x]; other=1-c[x]
        acc=0; q=p+1
        while q:
            acc+=bits[other][q];q-=q&-q
        out += totals[other]-acc
