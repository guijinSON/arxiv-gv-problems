+    vertex_rank = {vertex: rank for rank, vertex in enumerate(vertex_order)}
+    edge_rank = {edge_id: rank for rank, edge_id in enumerate(edge_order)}
+
+    pi_links: list[tuple[int, int, int]] = []
+    for vertex in vertex_order:
