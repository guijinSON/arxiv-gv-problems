+    crossed_source_edges = _crossing_score(inst, mask)
+    paper = inst["paper"]
+    return (
+        paper["alpha_1"]
+        + paper["alpha_2"]
+        + 2 * paper["q_edge"] * crossed_source_edges
+        + _link_link_crossings(inst, mask)
+    )
+
+
