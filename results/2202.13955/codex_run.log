+def _attack_outlier_coordinate(inst: dict, rng: random.Random) -> list[int]:
+    del rng
+    d = inst["dimension"]
+    best = max(range(d), key=lambda bit: (_crossing_score(inst, 1 << bit), -bit))
+    return [int(bit == best) for bit in range(d)]
+
