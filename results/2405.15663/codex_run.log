+    body = re.sub(r"\s*```$", "", body)
+    try:
+        answer = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        match = re.fullmatch(
+            r"(?:component\s*)?([+-]?\d+)\s*[,;:]\s*([+-]?\d+)\s*/\s*([+-]?\d+)",
+            body,
