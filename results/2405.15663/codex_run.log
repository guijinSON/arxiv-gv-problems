+
+def _sample_targets(rng, prime, target_size):
+    values = list(range(1, prime))
+    while True:
+        targets = sorted(rng.sample(values, target_size))
+        characters = {_legendre(value, prime) for value in targets}
+        if target_size == 1 or characters == {-1, 1}:
+            return targets
