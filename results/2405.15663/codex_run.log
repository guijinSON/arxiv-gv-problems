+            target_size * prime ** (dimension - 2)
+            + restricted_sign
+            * guessed_sum
+            * prime ** ((dimension - 2) // 2)
+        )
+        guessed_value = Fraction(guessed_internal, degree)
+        extrapolated.append(
+            {
+                "component": index,
+                "rho": [guessed_value.numerator, guessed_value.denominator],
+            }
+        )
+    greedy = [min(extrapolated, key=lambda item: Fraction(*item["rho"]))]
