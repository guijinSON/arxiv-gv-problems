+    uniform = [
+        {"component": 0, "rho": [1, prime]},
+    ]
+
+    total_degree = sum(degree for degree, _internal in counts)
+    total_internal = sum(internal for _degree, internal in counts)
+    aggregate = Fraction(total_internal, total_degree)
+    aggregate_ansatz = [
