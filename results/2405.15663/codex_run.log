+        colour_offset = (
+            colour_scalar * colour_offset + rng.randrange(prime)
+        ) % prime
+        transformed_components.append(
+            {
+                "linear_forms": forms,
+                "coefficients": coefficients,
+                "targets": targets,
+                "colour_coordinate": colour_coordinate,
+                "colour_offset": colour_offset,
+            }
