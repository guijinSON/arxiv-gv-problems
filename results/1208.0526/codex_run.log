def _is_prime(x: int) -> bool:
    if x < 2:
        return False
    if x % 2 == 0:
        return x == 2
    f = 3
    while f * f <= x:
        if x % f == 0:
            return False
        f += 2
    return True


def _next_prime(x: int) -> int:
    q = max(3, x | 1)
    while not _is_prime(q):
        q += 2
    return q


