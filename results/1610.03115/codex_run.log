+DIFFICULTY = {
+    "demo": {"n": 3, "component_max": 3},
+    "easy": {"n": 24, "component_max": 8},
+    "medium": {"n": 96, "component_max": 13},
+    "hard": {"n": 249, "component_max": 17},
+}
