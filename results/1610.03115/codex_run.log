+  "G1_planted_verifies": {
+    "cases": [
+      {"ok": true, "preset": "demo", "reason": "ok", "seed": 0},
+      {"ok": true, "preset": "demo", "reason": "ok", "seed": 1},
+      {"ok": true, "preset": "demo", "reason": "ok", "seed": 7},
+      {"ok": true, "preset": "demo", "reason": "ok", "seed": 19},
+      {"ok": true, "preset": "easy", "reason": "ok", "seed": 0},
+      {"ok": true, "preset": "easy", "reason": "ok", "seed": 1},
+      {"ok": true, "preset": "easy", "reason": "ok", "seed": 7},
