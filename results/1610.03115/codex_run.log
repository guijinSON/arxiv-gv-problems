\section{Nordhaus-Gaddum sum bounds for power domination}\label{sNGsum}

\item $G$ or $\Gc$ is not super-$\lambda$.\vspace{-3pt}
\een
If $n\ge 24$, then $\pd (G)+ \pd (\Gc)\leq \lf {n\over 4}\rf+2$, and 
  $\pd (G)+ \pd (\Gc)\leq \lf {n\over 4}\rf+3$ for $n\le 23$. 
\end{thm}
\begin{proof}
By Corollary \ref{pdle2}, $\pd (G)\leq 2$ or $\pd (\Gc)\leq 2$. 
Assume without loss of generality that $\pd (G)\leq 2$. Applying Theorem \ref{domn4} to $\Gc$,   
$\pd (\Gc)\leq \lf {n\over 4}\rf$ for $n\ge 24$ and $ \pd (\Gc)\leq \lf {n\over 4}\rf+1$ for $n\le 23$. %,  so $\pd (G)+ \pd (\Gc)\leq \lf {n\over 4}\rf+3$ (and $\pd (G)+ \pd (\Gc)\leq \lf {n\over 4}\rf+2$ if $n\ge 28$).
\end{proof}

