+      "compositions of relabelling and reordering",
+      "necklace component reordering and reversal (captured by component lengths)"
+    ],
+    "unrelated_instances": 20,
+    "valid_transformation_checks": 80
+  },
+  "G9_no_tool_suitability": {
+    "answer_chars": 1225,
+    "answer_elements": 249,
+    "answer_tokens": 307,
+    "arms": {
+      "bare": {"attempts": 0, "solved": 0},
+      "hinted": {"attempts": 0, "solved": 0},
+      "placebo": {"attempts": 0, "solved": 0}
+    },
+    "caps": {"chars": 2000, "elements": 256, "operations": 300, "tokens": 500},
+    "hinted_minus_placebo": 0.0,
+    "hinted_verdict": "not_yet_measured",
+    "intended_route_operations": 261,
+    "pass": true
+  },
+  "all_passed": true
+}

