+SHIPPING_DIFFICULTY = "hard"
+
+# Populated after the three isolated harness runs.  These are diagnostics;
+# only the answer/route caps are gated.
+G9_ARM_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
