\begin{thm}\label{domn4} {\rm\cite{HV06, MV14}}
Suppose $G$ is a graph of order $n$ with $\diam(G)=2$.  If $n\ge 24$, then $\gamma(G)\le \lf \frac n 4\rf$, and $\gamma(G)\le \lf \frac n 4\rf+1$ for $n\le 23$.
\end{thm}

\begin{rem}\label{twins}  Let $G$ be a graph.  Suppose $W$ is a set of at least two vertices such that no vertex outside $W$ is adjacent to exactly one vertex in  $W$.  
Then every power dominating set $S$ must contain either a neighbor of $W$ or a vertex in $W$, because no  vertex outside of $W$ can force a vertex in $W$ unless  all but one  of the vertices in $W$ have already been power dominated.
