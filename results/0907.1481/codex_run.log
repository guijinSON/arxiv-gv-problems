index 0000000000000000000000000000000000000000..5e1faed5f81375d88c6724f471df3fa1c5cf7233
--- /dev/null
+++ b/gen_0907_1481.py
@@ -0,0 +1,1026 @@
+"""Self-contained generator for Latin intercalates (arXiv:0907.1481).
+
+The paper's native objects are retained: an instance is an implicitly represented
+Latin square and a witness is a pair of four-entry partial Latin squares forming a
+Latin bitrade.  Generation starts with an intercalate in the back-circulant square,
+optionally switches other cell-disjoint intercalates, and carries the witness
+through independent row, column, and symbol permutations.  It never searches for
+a trade in the Latin square it has built.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "other",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "Latin square given by an exact quasigroup operation",
+        "four-entry partial Latin square",
+        "Latin bitrade and its disjoint mate",
+    ],
+    "verification_operations": [
+        "exact evaluation of a finite quasigroup operation",
+        "partial-Latin row and column uniqueness checks",
+        "exact row and column symbol-multiset comparison",
+        "finite set disjointness",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "In the hidden cyclic coordinates, adding half the order to a row and "
+        "to a column preserves a two-symbol rectangle; without recognizing this "
+        "invariant one must mechanically inspect candidate rectangles."
+    ),
+    "hardness_basis": (
+        "Track B: tabulate-and-index inversion of the displayed row and column "
+        "permutations solves the task in O(qr) Feistel rounds (q is the order and "
+        "r the displayed round count); at shipping q=4096, r=8, seed 271828, it "
+        "took 0.005219 seconds and 65,632 Feistel-round evaluations (about 262,528 "
