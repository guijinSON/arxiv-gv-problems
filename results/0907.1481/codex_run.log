+"""Self-contained generator for Latin intercalates (arXiv:0907.1481).
+
+The paper's native objects are retained: an instance is an implicitly represented
+Latin square and a witness is a pair of four-entry partial Latin squares forming a
+Latin bitrade.  Generation starts with an intercalate in the back-circulant square,
+optionally switches other cell-disjoint intercalates, and carries the witness
+through independent row, column, and symbol permutations.  It never searches for
+a trade in the Latin square it has built.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "other",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "Latin square given by an exact quasigroup operation",
+        "four-entry partial Latin square",
+        "Latin bitrade and its disjoint mate",
+    ],
+    "verification_operations": [
+        "exact evaluation of a finite quasigroup operation",
+        "partial-Latin row and column uniqueness checks",
+        "exact row and column symbol-multiset comparison",
+        "finite set disjointness",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "In the hidden cyclic coordinates, adding half the order to a row and "
+        "to a column preserves a two-symbol rectangle; without recognizing this "
+        "invariant one must mechanically inspect candidate rectangles."
+    ),
+    "hardness_basis": (
+        "Track B: tabulate-and-index inversion of the displayed row and column "
+        "permutations solves the task in O(qr) Feistel rounds (q is the order and "
+        "r the displayed round count); at the shipping preset, seed 271828, the "
+        "measured cost is filled in by selftest and recorded in selftest_report.json, "
+        "whereas the half-order invariant gives a route of at most 205 exact operations."
+    ),
+    "max_answer_tokens": 96,
+}
+
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON object with keys trade and mate.  Each value is a list of four "
+        "[row,column,symbol] triples.  The trade is the operation's four entries "
+        "on a choice of two distinct rows and two distinct columns; the mate is "
+        "the unique row-wise swap candidate.  Thus the bounded structure-aware "
+        "language has one candidate per unordered row-pair/column-pair."
+    ),
+    "bounds": {
+        "partial_squares": 2,
+        "entries_per_partial_square": 4,
+        "integers_per_entry": 3,
+        "integer_range": "0..q-1",
+        "candidate_count": "binom(q,2)^2",
+    },
+}
+
+
+DIFFICULTY = {
+    "demo": {"n": 4, "rounds": 2, "switch_count": 2},
+    "easy": {"n": 12, "rounds": 8, "switch_count": 32},
+    "medium": {"n": 14, "rounds": 8, "switch_count": 64},
+    "hard": {"n": 16, "rounds": 8, "switch_count": 96},
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+
+STRUCTURAL_HINT = (
+    "In the internal cyclic coordinates, pairs separated by half the order form "
+    "two-symbol rectangles even across the listed switches."
+)
