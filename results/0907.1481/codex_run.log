+def _sample_even_switches(rng, q, pair_count):
+    """Choose two corners in every distinct quarter-orbit."""
+    quarter = q // 4
+    if pair_count > quarter * quarter:
+        raise ValueError("too many switch-pair orbits")
+    orbits = set()
+    while len(orbits) < pair_count:
