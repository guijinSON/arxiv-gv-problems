+def canonical_key(inst):
+    """Affine/isotopy-invariant fingerprint of the internal switch configuration.
+
+    External row, column and symbol relabellings live entirely in the map chains
+    and are intentionally ignored.  The histogram below is invariant under
+    cyclic translations, a common odd multiplier, signs, and row/column transpose.
+    It is a deliberately cheap invariant, not a complete Latin-square isotopy test.
+    """
+
+    q = inst["order"]
+    half = q // 2
+    points = sorted(set(map(tuple, inst["switches"])))
+
+    def oriented(swapped):
+        pairs = {}
+        for index, first in enumerate(points):
+            for second in points[index + 1:]:
+                dx = _v2_mod_power_two(second[0] - first[0], half)
+                dy = _v2_mod_power_two(second[1] - first[1], half)
+                key = (dy, dx) if swapped else (dx, dy)
+                pairs[key] = pairs.get(key, 0) + 1
+        row_counts = {}
+        column_counts = {}
+        for x, y in points:
+            row_counts[x] = row_counts.get(x, 0) + 1
+            column_counts[y] = column_counts.get(y, 0) + 1
+        first_counts = sorted(column_counts.values() if swapped else row_counts.values())
+        second_counts = sorted(row_counts.values() if swapped else column_counts.values())
+        return {
+            "first_multiplicities": first_counts,
+            "second_multiplicities": second_counts,
+            "pair_valuations": [[a, b, count]
+                                for (a, b), count in sorted(pairs.items())],
+        }
+
+    alternatives = [oriented(False), oriented(True)]
+    normalized = min(alternatives, key=lambda x: json.dumps(x, sort_keys=True))
+    payload = {
+        "order": q,
+        "switch_count": len(points),
+        "affine_invariant": normalized,
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(blob).hexdigest()
+
+
