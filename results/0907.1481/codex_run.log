+            operations += 1
+            if (rows[row] >> column) & 1:
+                pivot = row
+                break
+        if pivot is None:
+            raise ValueError("singular relabelling map")
+        if pivot != column:
+            rows[column], rows[pivot] = rows[pivot], rows[column]
+            operations += 1
+        for row in range(bits):
