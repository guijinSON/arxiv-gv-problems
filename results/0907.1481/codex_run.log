2915, 3024, 3135, 3248, 3363, 3480, 3599, 3720, 3843, 3968, 4095,
4224, 4355, 4488, 4623, 4760, 4899, 5040, 5183, 5328, 5475, 5624,
5775, 5928, 6083, 6240, 6399, 6560, 6723, 6888, 7055, 7224, 7395, 7568,
