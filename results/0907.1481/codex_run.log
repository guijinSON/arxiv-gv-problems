    In B_q every half-order row pair and half-order column pair gives an
    intercalate, contributing (q/2)^2.  Switching cells can add quarter-order
    rectangles.  The switch coordinates split into 2x2 orbits under adding
    q/4 to either coordinate; an orbit contributes eight extra rectangles iff
    it has odd switch parity.  The two equality equations rule out every other
    row/column difference.  External map chains are bijections and do not alter
    the count.
    """

    q = inst["order"]
    half = q // 2
    quarter = q // 4
    parity = {}
    for x, y in _switch_set(inst):
        orbit = (x % quarter, y % quarter)
        parity[orbit] = parity.get(orbit, 0) ^ 1
    return half * half + 8 * sum(parity.values())


def _rectangle_valid(inst, answer):
    try:
        entries = answer["trade"]
        rows = sorted({triple[0] for triple in entries})
        columns = sorted({triple[1] for triple in entries})
        if len(rows) != 2 or len(columns) != 2:
            return False
        switches = _switch_set(inst)
        a = _entry(inst, rows[0], columns[0], switches)
        b = _entry(inst, rows[0], columns[1], switches)
        c = _entry(inst, rows[1], columns[0], switches)
        d = _entry(inst, rows[1], columns[1], switches)
        return a == d and b == c and a != b
    except (KeyError, TypeError, ValueError):
        return False


def enumerate_all(inst):
    q = inst["order"]
    if q > 32:
        return None
    count = 0
    for rows in itertools.combinations(range(q), 2):
        for columns in itertools.combinations(range(q), 2):
            if _rectangle_valid(inst, _answer_for_rectangle(inst, rows, columns)):
                count += 1
    return count


def _v2_mod_power_two(value, modulus):
    value %= modulus
    if value == 0:
        return modulus.bit_length() - 1
    return (value & -value).bit_length() - 1


def canonical_key(inst):
    """Affine/isotopy-invariant fingerprint of the internal switch configuration.

    External row, column and symbol relabellings live entirely in the map chains
    and are intentionally ignored.  The histogram below is invariant under
    cyclic translations, a common odd multiplier, signs, and row/column transpose.
    It is a deliberately cheap invariant, not a complete Latin-square isotopy test.
    """

    q = inst["order"]
    half = q // 2
    points = sorted(set(map(tuple, inst["switches"])))

    def oriented(swapped):
        pairs = {}
        for index, first in enumerate(points):
            for second in points[index + 1:]:
                dx = _v2_mod_power_two(second[0] - first[0], half)
                dy = _v2_mod_power_two(second[1] - first[1], half)
                key = (dy, dx) if swapped else (dx, dy)
                pairs[key] = pairs.get(key, 0) + 1
        row_counts = {}
        column_counts = {}
        for x, y in points:
            row_counts[x] = row_counts.get(x, 0) + 1
            column_counts[y] = column_counts.get(y, 0) + 1
        first_counts = sorted(column_counts.values() if swapped else row_counts.values())
        second_counts = sorted(row_counts.values() if swapped else column_counts.values())
        return {
            "first_multiplicities": first_counts,
            "second_multiplicities": second_counts,
            "pair_valuations": [[a, b, count]
                                for (a, b), count in sorted(pairs.items())],
        }

    alternatives = [oriented(False), oriented(True)]
    normalized = min(alternatives, key=lambda x: json.dumps(x, sort_keys=True))
    payload = {
        "order": q,
        "switch_count": len(points),
        "affine_invariant": normalized,
    }
    blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(blob).hexdigest()


def escalate(params):
    harder = dict(params)
    harder["n"] = int(harder.get("n", 12)) + 2
    # More independently switched native trades add instance crowding and
    # diversity without lengthening the four-entry answer.
    harder["switch_count"] = int(harder.get("switch_count", 32)) + 32
    return harder


def _map_answer(answer, row_fn, column_fn, symbol_fn):
    result = {}
    for name in ("trade", "mate"):
        result[name] = [
            [row_fn(row), column_fn(column), symbol_fn(symbol)]
            for row, column, symbol in answer[name]
        ]
    return result


def _external_relabel(inst, rng):
    """Apply independent public row/column/symbol Feistel relabellings."""

    result = _copy_json(inst)
    bits = inst["bits"]
    hr = _new_feistel(rng, bits, 3)
    hc = _new_feistel(rng, bits, 3)
    hs = _new_feistel(rng, bits, 3)
    inv_hr = dict(hr, inverse=True)
    inv_hc = dict(hc, inverse=True)
    result["row_map"] = [inv_hr] + result["row_map"]
    result["column_map"] = [inv_hc] + result["column_map"]
    result["symbol_map"] = result["symbol_map"] + [hs]
    result["answer"] = _map_answer(
        inst["answer"],
        lambda x: _component(x, hr, bits),
        lambda x: _component(x, hc, bits),
        lambda x: _component(x, hs, bits),
    )
    return result


def _internal_affine_representative(inst, multiplier, row_offset, column_offset):
    """Change hidden cyclic coordinates without changing the public square."""

    result = _copy_json(inst)
    bits = inst["bits"]
    q = inst["order"]
    if multiplier % 2 != 1:
        raise ValueError("the cyclic multiplier must be odd")
    row_affine = {"type": "affine", "multiplier": multiplier,
                  "offset": row_offset % q}
    column_affine = {"type": "affine", "multiplier": multiplier,
                     "offset": column_offset % q}
    symbol_inverse = {
        "type": "affine", "multiplier": multiplier,
        "offset": (row_offset + column_offset) % q, "inverse": True,
    }
    result["row_map"] = result["row_map"] + [row_affine]
    result["column_map"] = result["column_map"] + [column_affine]
    result["symbol_map"] = [symbol_inverse] + result["symbol_map"]
    half = q // 2
    result["switches"] = [
        [(multiplier * x + row_offset) % half,
         (multiplier * y + column_offset) % half]
        for x, y in result["switches"]
    ]
    return result


def _transpose_instance(inst):
    result = _copy_json(inst)
    result["row_map"], result["column_map"] = (
        result["column_map"], result["row_map"]
    )
    result["switches"] = [[y, x] for x, y in result["switches"]]
    result["answer"] = _map_answer(
        result["answer"], lambda x: x, lambda x: x, lambda x: x
    )
    for name in ("trade", "mate"):
        result["answer"][name] = [
            [column, row, symbol]
            for row, column, symbol in result["answer"][name]
        ]
    return result


def _reference_tabulate(inst):
    """O(qr) reference algorithm; returns witness and primitive operation count."""

    q = inst["order"]
    bits = inst["bits"]
    half = q // 2
    row_inverse = [0] * q
    column_inverse = [0] * q
    round_evaluations = 0
    for public in range(q):
        row_inverse[_chain(public, inst["row_map"], bits)] = public
        column_inverse[_chain(public, inst["column_map"], bits)] = public
        round_evaluations += sum(len(component.get("rounds", []))
                                 for component in inst["row_map"])
        round_evaluations += sum(len(component.get("rounds", []))
                                 for component in inst["column_map"])
    rows = [row_inverse[0], row_inverse[half]]
    columns = [column_inverse[0], column_inverse[half]]
    answer = _answer_for_rectangle(inst, rows, columns)
    # Four exact operation evaluations, each traversing three generated maps.
    round_evaluations += 4 * sum(
        len(component.get("rounds", []))
        for key in ("row_map", "column_map", "symbol_map")
        for component in inst[key]
    )
    return answer, round_evaluations


def _attack_small_labels(inst):
    return _answer_for_rectangle(inst, [0, 1], [0, 1])


def _attack_visible_half_shift(inst):
    half = inst["order"] // 2
    return _answer_for_rectangle(inst, [0, half], [0, half])


def _attack_first_switch_as_public(inst):
    half = inst["order"] // 2
    if inst["switches"]:
        x, y = inst["switches"][0]
    else:
        x = y = 0
    return _answer_for_rectangle(inst, [x, x + half], [y, y + half])


def _attack_random_restart(inst, seed, restarts=256):
    rng = random.Random(seed)
    candidate = _attack_small_labels(inst)
    for _ in range(restarts):
        candidate = random_candidate(inst, rng)
        if _rectangle_valid(inst, candidate):
            return candidate
    return candidate


def _answer_atoms(value):
    if isinstance(value, dict):
        return sum(_answer_atoms(item) for item in value.values())
    if isinstance(value, list):
        return sum(_answer_atoms(item) for item in value)
    return 1


def _sample_density(inst, total, seed):
    rng = random.Random(seed)
    hits = 0
    for index in range(total):
        candidate = random_candidate(inst, rng)
        valid = _rectangle_valid(inst, candidate)
        if index < 3 or valid:
            checker_valid = verify(inst, candidate)[0]
            if checker_valid != valid:
                raise AssertionError("fast rectangle test disagrees with verify")
        hits += int(valid)
    return hits


def selftest():
    report = {}

    # G1: all four presets, several independent seeds.
    g1_failures = []
    g1_attempts = 0
    for preset, params in DIFFICULTY.items():
        for seed in (0, 1, 17):
            inst = make_instance(seed=seed, **params)
            g1_attempts += 1
            ok, reason = verify(inst, inst["answer"])
            if not ok:
                g1_failures.append([preset, seed, reason])
            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
                g1_failures.append([preset, seed, "answer is not JSON-native"])
    report["G1_planted_verifies"] = {
        "pass": not g1_failures,
        "attempts": g1_attempts,
        "failures": g1_failures,
    }

    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
    inst = make_instance(seed=271828, **shipping_params)
    answer = _copy_json(inst["answer"])

    # G2: deliberately route each corruption through a different exact check.
    corruptions = {}
    dropped = _copy_json(answer)
    dropped["trade"].pop()
    corruptions["drop_one"] = verify(inst, dropped)
    swapped = _copy_json(answer)
    swapped["trade"][0][2], swapped["trade"][1][2] = (
        swapped["trade"][1][2], swapped["trade"][0][2]
    )
    corruptions["swap_symbols"] = verify(inst, swapped)
    duplicated = _copy_json(answer)
    duplicated["trade"][1] = list(duplicated["trade"][0])
    corruptions["duplicate_cell"] = verify(inst, duplicated)
    corruptions["empty"] = verify(inst, {})
    out_of_range = _copy_json(answer)
    out_of_range["mate"][0][2] = inst["order"]
    corruptions["out_of_range"] = verify(inst, out_of_range)
    reasons = [reason for ok, reason in corruptions.values()]
    report["G2_rejects_corruption"] = {
        "pass": all(not ok for ok, _ in corruptions.values())
        and len(set(reasons)) == len(reasons),
        "cases": {name: {"accepted": ok, "reason": reason}
                  for name, (ok, reason) in corruptions.items()},
        "distinct_reasons": len(set(reasons)),
    }

    # G3: realistic prose and a fenced payload both round-trip.
    payload = json.dumps(answer, separators=(",", ":"))
    prose = "I used the two-symbol rectangle invariant.\n<answer>\n" + payload + (
        "\n</answer>\nThe entries are in row-major order."
    )
    fenced = "Result:\n```json\n" + payload + "\n```"
    parsed_prose = parse_answer(prose)
    parsed_fenced = parse_answer(fenced)
    report["G3_round_trip"] = {
        "pass": parsed_prose == answer and parsed_fenced == answer,
        "prose": parsed_prose == answer,
        "markdown_fence": parsed_fenced == answer,
    }

    # G4 and G5 density at the actual shipping preset.
    sample_total = 200_000
    density_inst = make_instance(seed=314159, **shipping_params)
    density_started = time.perf_counter()
    density_hits = _sample_density(density_inst, sample_total, 161803)
    density_wall = time.perf_counter() - density_started
    guess_probability = density_hits / sample_total
    exact_valid = _exact_intercalate_count(density_inst)
    exact_probability = exact_valid / search_space(density_inst)
    report["G4_guess_resistance"] = {
        "pass": guess_probability < 1e-6 and exact_probability < 1e-6,
        "hits": density_hits,
        "total": sample_total,
        "observed_probability": guess_probability,
        "exact_valid_answers_by_switch_parity_identity": exact_valid,
        "exact_probability": exact_probability,
        "candidate_space": str(search_space(density_inst)),
        "sampling_prior": "uniform unordered row-pair and unordered column-pair",
    }

    demo_inst = make_instance(seed=0, **DIFFICULTY["demo"])
    demo_count = enumerate_all(demo_inst)
    reference_started = time.perf_counter()
    reference_answer, reference_operations = _reference_tabulate(inst)
    reference_wall = time.perf_counter() - reference_started
    reference_ok, reference_reason = verify(inst, reference_answer)
    report["G5_density_and_baseline"] = {
        "pass": density_hits >= 0 and reference_ok,
        "shipping_density": {
            "preset": SHIPPING_DIFFICULTY,
            "seed": 314159,
            "hits": density_hits,
            "samples": sample_total,
            "observed_fraction": guess_probability,
            "wall_clock_sec": round(density_wall, 6),
        },
        "shipping_exact_count_by_identity": exact_valid,
        "shipping_exact_fraction": exact_probability,
        "demo_exact_valid_answers": demo_count,
        "demo_candidate_space": search_space(demo_inst),
        "strongest_baseline": {
            "name": "tabulate-and-index permutation inversion",
            "seed": 271828,
            "wall_clock_sec": round(reference_wall, 6),
            "feistel_round_evaluations": reference_operations,
            "verify": reference_reason,
        },
    }

    # G6: four no-tool attacks must all fail; the Track B algorithm is separate.
    attack_functions = {
        "outlier_first_switch_as_public": lambda x, s: _attack_first_switch_as_public(x),
        "greedy_smallest_labels": lambda x, s: _attack_small_labels(x),
        "visible_half_shift": lambda x, s: _attack_visible_half_shift(x),
        "random_restart_256": lambda x, s: _attack_random_restart(x, 10_000 + s),
    }
    attack_results = {
        name: {"successes": 0, "attempts": 0}
        for name in attack_functions
    }
    reference_successes = 0
    reference_attempts = 0
    reference_ops_total = 0
    reference_wall_total = 0.0
    for seed in range(8):
        attack_inst = make_instance(seed=seed, **shipping_params)
        for name, attack in attack_functions.items():
            candidate = attack(attack_inst, seed)
            success = verify(attack_inst, candidate)[0]
            attack_results[name]["successes"] += int(success)
            attack_results[name]["attempts"] += 1
        started = time.perf_counter()
        candidate, operations = _reference_tabulate(attack_inst)
        reference_wall_total += time.perf_counter() - started
        reference_ops_total += operations
        reference_attempts += 1
        reference_successes += int(verify(attack_inst, candidate)[0])
    all_failed = all(result["successes"] == 0
                     for result in attack_results.values())
    report["G6_adversary_panel"] = {
        "pass": all_failed and reference_successes == reference_attempts,
        "attacks": attack_results,
        "reference_algorithm": {
            "name": "tabulate-and-index permutation inversion",
            "complexity": "O(q*r) Feistel rounds and O(q) memory",
            "wall_clock_sec": round(reference_wall_total, 6),
            "operations": reference_ops_total,
            "per_instance_operations": reference_ops_total // reference_attempts,
            "solves": f"{reference_successes}/{reference_attempts}, as expected",
        },
    }

    # G7: n increases the ambient order while the certificate stays at 24 atoms.
    doubled_params = dict(shipping_params)
    doubled_params["n"] = shipping_params["n"] + 2
    doubled_params["switch_count"] *= 2
    doubled = make_instance(seed=12345, **doubled_params)
    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
    report["G7_scales"] = {
        "pass": doubled_ok and doubled["order"] > inst["order"]
        and _answer_atoms(doubled["answer"]) == _answer_atoms(answer),
        "shipping_order": inst["order"],
        "larger_order": doubled["order"],
        "shipping_space_bits": search_space(inst).bit_length(),
        "larger_space_bits": search_space(doubled).bit_length(),
        "answer_atoms_each": _answer_atoms(answer),
        "larger_verify": doubled_reason,
    }

    # G8: external isotopy, internal affine coordinates, transpose, and composition.
    invariant_checks = 0
    carried_checks = 0
    distinct_keys = []
    g8_failures = []
    for seed in range(20):
        base = make_instance(seed=seed + 500, **shipping_params)
        base_key = canonical_key(base)
        distinct_keys.append(base_key)
        rng = random.Random(seed + 9000)
        external = _external_relabel(base, rng)
        odd = rng.randrange(1, base["order"], 2)
        internal = _internal_affine_representative(
            base, odd, rng.randrange(base["order"]), rng.randrange(base["order"])
        )
        transposed = _transpose_instance(base)
        composed = _transpose_instance(_external_relabel(internal, rng))
        reordered = _copy_json(base)
        rng.shuffle(reordered["switches"])
        for label, transformed in (
            ("external", external), ("internal_affine", internal),
            ("transpose", transposed), ("composed", composed),
            ("reordered_switches", reordered),
        ):
            invariant_checks += 1
            if canonical_key(transformed) != base_key:
                g8_failures.append([seed, label, "key changed"])
            carried_checks += 1
            ok, reason = verify(transformed, transformed["answer"])
            if not ok:
                g8_failures.append([seed, label, reason])
    distinct_count = len(set(distinct_keys))
    report["G8_canonical_key"] = {
        "pass": not g8_failures and distinct_count == 20,
        "invariance_checks": invariant_checks,
        "carried_witness_checks": carried_checks,
        "distinct_unrelated": distinct_count,
        "unrelated_attempts": 20,
        "failures": g8_failures,
        "invariances": [
            "independent public row/column/symbol relabelling",
            "common-odd-multiplier cyclic affine coordinate change",
            "row/column transpose",
            "compositions and switch-list reorderings",
        ],
    }

    answer_blob = json.dumps(answer, separators=(",", ":"))
    answer_chars = len(answer_blob)
    answer_tokens = math.ceil(answer_chars / 4)
    answer_elements = _answer_atoms(answer)
    # Six map evaluations (two row inverses, two column inverses, two symbol
    # forwards), four primitive arithmetic/bit operations per Feistel round,
    # plus 13 comparisons, additions, membership checks, and assembly steps.
    intended_operations = 6 * shipping_params["rounds"] * 4 + 13
    within_caps = (answer_chars <= 2000 and answer_elements <= 256
                   and intended_operations <= 300)
    bare = G9_ORACLE_RESULTS["bare"]
    hinted = G9_ORACLE_RESULTS["hinted"]
    placebo = G9_ORACLE_RESULTS["placebo"]
    difference = None
    if isinstance(hinted["solved"], int) and isinstance(placebo["solved"], int):
        difference = (hinted["solved"] / hinted["attempts"]
                      - placebo["solved"] / placebo["attempts"])
    report["G9_no_tool_suitability"] = {
        "pass": within_caps,
        "arms": {"bare": dict(bare), "hinted": dict(hinted),
                 "placebo": dict(placebo)},
        "hinted_minus_placebo": difference,
        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
        "answer_chars": answer_chars,
        "answer_tokens": answer_tokens,
        "answer_elements": answer_elements,
        "intended_route_operations": intended_operations,
        "caps_only_are_gated": True,
    }

    report["pass"] = all(
        gate.get("pass", False)
        for name, gate in report.items()
        if name.startswith("G")
    )
    return report


