+            if component.get("type") != "xorshift":
+                continue
+            distance = component["shift"]
+            per_iteration = 3 if component["direction"] == "left" else 2
+            while distance < inst["bits"]:
+                operations += per_iteration
+                distance *= 2
+    return operations + 8
