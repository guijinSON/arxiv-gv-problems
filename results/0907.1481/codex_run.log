+def _copy_json(value):
+    return json.loads(json.dumps(value))
+
+
+def _feistel(value, rounds, bits, inverse=False):
+    """Balanced Feistel permutation of 0..2**bits-1."""
+
+    half_bits = bits // 2
+    half = 1 << half_bits
+    mask = half - 1
+    left, right = divmod(value, half)
+    if not inverse:
+        for a, b in rounds:
+            left, right = right, left ^ ((a * right + b) & mask)
+    else:
+        for a, b in reversed(rounds):
+            left, right = right ^ ((a * left + b) & mask), left
+    return left * half + right
+
+
+def _component(value, component, bits):
+    kind = component.get("type")
+    inverse = bool(component.get("inverse", False))
+    q = 1 << bits
+    if kind == "feistel":
+        return _feistel(value, component["rounds"], bits, inverse)
+    if kind == "affine":
+        multiplier = component["multiplier"]
+        offset = component["offset"]
+        if inverse:
+            return ((value - offset) * pow(multiplier, -1, q)) % q
+        return (multiplier * value + offset) % q
+    raise ValueError("unknown map component")
+
+
+def _chain(value, components, bits):
+    for component in components:
+        value = _component(value, component, bits)
+    return value
+
+
+def _inverse_chain(value, components, bits):
+    for component in reversed(components):
+        inverse = dict(component)
+        inverse["inverse"] = not bool(component.get("inverse", False))
+        value = _component(value, inverse, bits)
+    return value
+
+
+def _switch_set(inst):
+    return {tuple(pair) for pair in inst["switches"]}
+
+
+def _internal_entry(inst, x, y, switches=None):
+    q = inst["order"]
+    half = q // 2
+    if switches is None:
+        switches = _switch_set(inst)
+    z = (x + y) % q
+    if (x % half, y % half) in switches:
+        z = (z + half) % q
+    return z
+
+
+def _entry(inst, row, column, switches=None):
+    bits = inst["bits"]
+    x = _chain(row, inst["row_map"], bits)
+    y = _chain(column, inst["column_map"], bits)
+    z = _internal_entry(inst, x, y, switches)
+    return _chain(z, inst["symbol_map"], bits)
+
+
+def _answer_for_rectangle(inst, rows, columns):
+    rows = sorted(rows)
+    columns = sorted(columns)
+    switches = _switch_set(inst)
+    r0, r1 = rows
+    c0, c1 = columns
+    a = _entry(inst, r0, c0, switches)
+    b = _entry(inst, r0, c1, switches)
+    c = _entry(inst, r1, c0, switches)
+    d = _entry(inst, r1, c1, switches)
+    trade = [
+        [r0, c0, a], [r0, c1, b],
+        [r1, c0, c], [r1, c1, d],
+    ]
+    mate = [
+        [r0, c0, b], [r0, c1, a],
+        [r1, c0, d], [r1, c1, c],
+    ]
+    return {"trade": trade, "mate": mate}
+
+
+def _new_feistel(rng, bits, round_count):
+    half = 1 << (bits // 2)
+    return {
+        "type": "feistel",
+        "rounds": [[rng.randrange(half) | 1, rng.randrange(half)]
+                   for _ in range(round_count)],
+    }
+
+
+def make_instance(n, seed=0, **params):
+    """Construct a relabelled Latin square and a known size-four bitrade.
+
+    ``n`` is the even bit length, so the square order is ``2**n``.  The answer
+    is sampled first in cyclic coordinates and carried through all subsequent
+    structure-preserving operations.
+    """
+
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4 or n % 2:
+        raise ValueError("n must be an even integer at least 4")
+    round_count = params.pop("rounds", 8)
+    switch_count = params.pop("switch_count", 0)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if (isinstance(round_count, bool) or not isinstance(round_count, int)
+            or not 1 <= round_count <= 12):
+        raise ValueError("rounds must be an integer in 1..12")
+    if (isinstance(switch_count, bool) or not isinstance(switch_count, int)
+            or switch_count < 0):
+        raise ValueError("switch_count must be a nonnegative integer")
+
+    q = 1 << n
+    half = q // 2
+    if switch_count > half * half:
+        raise ValueError("too many switch blocks")
+    rng = random.Random(seed)
+
+    # Inverse generation: select a valid internal rectangle before maps or
+    # decoys exist.  Every (x,x+q/2) x (y,y+q/2) rectangle is an intercalate.
+    planted_x = rng.randrange(half)
+    planted_y = rng.randrange(half)
+
+    switch_indices = rng.sample(range(half * half), switch_count)
+    switches = [[index // half, index % half] for index in switch_indices]
+    rng.shuffle(switches)
+
+    row_map = [_new_feistel(rng, n, round_count)]
+    column_map = [_new_feistel(rng, n, round_count)]
+    symbol_map = [_new_feistel(rng, n, round_count)]
+
+    skeleton = {
+        "bits": n,
+        "order": q,
+        "rounds": round_count,
+        "row_map": row_map,
+        "column_map": column_map,
+        "symbol_map": symbol_map,
+        "switches": switches,
+    }
+    rows = [
+        _inverse_chain(planted_x, row_map, n),
+        _inverse_chain(planted_x + half, row_map, n),
+    ]
+    columns = [
+        _inverse_chain(planted_y, column_map, n),
+        _inverse_chain(planted_y + half, column_map, n),
+    ]
+    skeleton["answer"] = _answer_for_rectangle(skeleton, rows, columns)
+    return skeleton
+
+
+def _format_chain(name, chain):
+    return f"  {name} = " + json.dumps(chain, separators=(",", ":"))
+
+
