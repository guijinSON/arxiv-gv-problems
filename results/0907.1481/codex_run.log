+    "verification_operations": [
+        "exact evaluation of a finite quasigroup operation",
+        "partial-Latin row and column uniqueness checks",
+        "exact row and column symbol-multiset comparison",
+        "finite set disjointness",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "In the hidden cyclic coordinates, adding half the order to a row and "
+        "to a column preserves a two-symbol rectangle; without recognizing this "
+        "invariant one must mechanically inspect candidate rectangles."
+    ),
+    "hardness_basis": (
+        "Track B: tabulate-and-index inversion of the displayed row and column "
+        "permutations solves the task in O(qr) Feistel rounds (q is the order and "
+        "r the displayed round count); at the shipping preset, seed 271828, the "
+        "measured cost is filled in by selftest and recorded in selftest_report.json, "
+        "whereas the half-order invariant gives a route of at most 205 exact operations."
+    ),
+    "max_answer_tokens": 96,
+}
+
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
