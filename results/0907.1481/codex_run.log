4 &  4 &5 &0 &1 &2 &3 \\
5 &  1 &0 &2 &5 &3 &4
\end{array}
\qquad
%T^{\opb} \subset
L^{\opb} = 
\begin{array}{c|cccccc}
\opb & 0 & 1 & 2 & 3 & 4 & 5 \\
\hline
0 & 0 &3 &1 &2 &4 &5 \\

