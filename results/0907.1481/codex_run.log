def nonempty_intersection(x):
    assert(len(x) > 1);

    r = trades[x[0]]
    for i in range(1, len(x)):
        r = r & trades[x[i]]

    return r > 0

def trade_to_shape(B):
    n = B.nrows()

    s = []

    for r in range(B.nrows()):
        for c in range(B.ncols()):
            if B[r, c] >= 0:
                s.append(r*n + c)
        
    return s

def trade_to_int(B):
    """
    Convert a trade to an integer, where the i-th bit is 1 if and only
    if the i-th cell in B is filled (in row-major form).
    """

    B_int = long(0)
    x = long(1)

    for r in range(B.nrows()):
        for c in range(B.ncols()):
            if B[r, c] >= 0:
                B_int = B_int | x
        
            x = x << 1; 

    assert B_int > 0
    return B_int

def is_minimal(T1, T2):
    """
    A bitrade (T1, T2) is minimal if for any 
    """

    _, t1, t2, t3 = tau123(T1, T2)
    t1 = PermutationGroupElement(t1)
    t2 = PermutationGroupElement(t2)

    G = PermutationGroup([t1, t2])

    return len(G.orbits()) == 1

def facets(skip_list, result):
    if len(skip_list) == len(trades): return

    this_face = []

    # Check if trades-skip_list is a facet.
    i = 0
    while skip_list.has_key(i):
        i += 1

    assert i < len(trades)

    r = trades[i]
    this_face.append(i)
    i += 1

    while i < len(trades):
        if skip_list.has_key(i):
            i += 1
            continue

        r &= trades[i]

        if r == 0: break

        this_face.append(i)
        i += 1

    # If it is, we're done here.
    if r > 0:
        result.append(this_face)

        # add all subfaces
        for j in this_face:
            skip2 = copy.copy(skip_list)
            skip2[j] = True
            facets(skip2, result)
    else: # Otherwise, check all sub-faces.
        for j in range(max(skip_list)+1, len(trades)):
            if not skip_list.has_key(j):
                skip2 = copy.copy(skip_list)
                skip2[j] = True
                facets(skip2, result)

