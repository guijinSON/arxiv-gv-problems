+        for input_bit, column in enumerate(columns):
+            operations += 1
+            if (column >> output_bit) & 1:
+                coefficients |= 1 << input_bit
+                operations += 1
+        rows.append(coefficients | (((target >> output_bit) & 1) << bits))
+    for column in range(bits):
+        pivot = None
