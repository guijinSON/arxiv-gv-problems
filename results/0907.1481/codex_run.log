+        "demo_exact_valid_answers": demo_count,
+        "demo_candidate_space": search_space(demo_inst),
+        "strongest_baseline": {
+            "name": "tabulate-and-index permutation inversion",
+            "seed": 271828,
+            "wall_clock_sec": round(reference_wall, 6),
+            "feistel_round_evaluations": reference_operations,
+            "verify": reference_reason,
+        },
+    }
+
+    # G6: four no-tool attacks must all fail; the Track B algorithm is separate.
+    attack_functions = {
+        "outlier_first_switch_as_public": lambda x, s: _attack_first_switch_as_public(x),
+        "greedy_smallest_labels": lambda x, s: _attack_small_labels(x),
+        "visible_half_shift": lambda x, s: _attack_visible_half_shift(x),
+        "random_restart_256": lambda x, s: _attack_random_restart(x, 10_000 + s),
+    }
+    attack_results = {
+        name: {"successes": 0, "attempts": 0}
+        for name in attack_functions
+    }
