+def _small_latin_check(inst):
+    q = inst["order"]
+    if q > 32:
+        return True
+    switches, target = _switch_set(inst), set(range(q))
+    return (all({_entry(inst, r, c, switches) for c in range(q)} == target
+                for r in range(q))
+            and all({_entry(inst, r, c, switches) for r in range(q)} == target
+                    for c in range(q)))
 
 
