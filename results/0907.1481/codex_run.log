+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text, re.I | re.S)
+    candidates = list(reversed(tagged))
+    candidates.extend(reversed(re.findall(
+        r"```(?:json)?\s*([\s\S]*?)\s*```", text, re.I
+    )))
+    candidates.append(text)
+    decoder = json.JSONDecoder()
+    for candidate in candidates:
+        starts = [0] if candidate.lstrip().startswith("{") else []
+        starts.extend(index for index, char in enumerate(candidate) if char == "{")
+        for start in starts:
+            try:
+                value, _ = decoder.raw_decode(candidate.lstrip() if start == 0
+                                              else candidate[start:])
+            except (TypeError, ValueError, json.JSONDecodeError):
+                continue
+            if isinstance(value, dict) and set(value) == {"trade", "mate"}:
+                return value
+    return None
+
+
+def _triples(value, name, q):
+    if not isinstance(value, list):
+        return None, f"{name} must be a JSON list"
+    if len(value) != 4:
+        return None, f"{name} must contain exactly four triples"
+    result = []
+    for triple in value:
+        if not isinstance(triple, list) or len(triple) != 3:
+            return None, f"{name} contains a malformed triple"
+        if any(isinstance(x, bool) or not isinstance(x, int) for x in triple):
+            return None, f"{name} contains a noninteger label"
+        if any(x < 0 or x >= q for x in triple):
+            return None, f"{name} contains an out-of-range label"
+        result.append(tuple(triple))
+    return result, "ok"
+
+
+def _partial_latin(entries):
+    row_symbols = set()
+    column_symbols = set()
+    for row, column, symbol in entries:
+        if (row, symbol) in row_symbols:
+            return False
+        if (column, symbol) in column_symbols:
+            return False
+        row_symbols.add((row, symbol))
+        column_symbols.add((column, symbol))
+    return True
+
+
+def verify(inst, answer):
+    if not isinstance(answer, dict) or set(answer) != {"trade", "mate"}:
+        return False, "answer must be an object with exactly trade and mate keys"
+    q = inst.get("order")
+    if isinstance(q, bool) or not isinstance(q, int) or q < 2:
+        return False, "malformed instance order"
+    trade, reason = _triples(answer["trade"], "trade", q)
+    if trade is None:
+        return False, reason
+    mate, reason = _triples(answer["mate"], "mate", q)
+    if mate is None:
+        return False, reason
+
+    trade_cells = [(r, c) for r, c, _ in trade]
+    mate_cells = [(r, c) for r, c, _ in mate]
+    if len(set(trade_cells)) != 4:
+        return False, "trade repeats an occupied cell"
+    if len(set(mate_cells)) != 4:
+        return False, "mate repeats an occupied cell"
+    if set(trade_cells) != set(mate_cells):
+        return False, "trade and mate have different occupied cells"
+    rows = {r for r, _, _ in trade}
+    columns = {c for _, c, _ in trade}
+    if len(rows) != 2 or len(columns) != 2 or set(trade_cells) != {
+            (r, c) for r in rows for c in columns}:
+        return False, "support is not a complete two-row by two-column rectangle"
+    if not _partial_latin(trade):
+        return False, "trade is not a partial Latin square"
+    if not _partial_latin(mate):
+        return False, "mate is not a partial Latin square"
+
+    switches = _switch_set(inst)
+    trade_by_cell = {(r, c): s for r, c, s in trade}
+    mate_by_cell = {(r, c): s for r, c, s in mate}
+    for (row, column), symbol in trade_by_cell.items():
+        if symbol != _entry(inst, row, column, switches):
+            return False, "a trade entry disagrees with the Latin-square operation"
+        if symbol == mate_by_cell[(row, column)]:
+            return False, "trade and mate are not disjoint in every occupied cell"
+
+    for row in rows:
+        left = {s for r, _, s in trade if r == row}
+        right = {s for r, _, s in mate if r == row}
+        if left != right:
+            return False, "a row has different symbol sets in trade and mate"
+    for column in columns:
+        left = {s for _, c, s in trade if c == column}
+        right = {s for _, c, s in mate if c == column}
+        if left != right:
+            return False, "a column has different symbol sets in trade and mate"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    q = inst["order"]
+    rows = sorted(rng.sample(range(q), 2))
+    columns = sorted(rng.sample(range(q), 2))
+    return _answer_for_rectangle(inst, rows, columns)
+
+
+def search_space(inst):
+    rectangles = math.comb(inst["order"], 2)
+    return rectangles * rectangles
+
+
+def _rectangle_valid(inst, answer):
+    try:
+        entries = answer["trade"]
+        rows = sorted({triple[0] for triple in entries})
+        columns = sorted({triple[1] for triple in entries})
+        if len(rows) != 2 or len(columns) != 2:
+            return False
+        switches = _switch_set(inst)
+        a = _entry(inst, rows[0], columns[0], switches)
+        b = _entry(inst, rows[0], columns[1], switches)
+        c = _entry(inst, rows[1], columns[0], switches)
+        d = _entry(inst, rows[1], columns[1], switches)
+        return a == d and b == c and a != b
+    except (KeyError, TypeError, ValueError):
+        return False
+
+
+def enumerate_all(inst):
+    q = inst["order"]
+    if q > 32:
+        return None
+    count = 0
+    for rows in itertools.combinations(range(q), 2):
+        for columns in itertools.combinations(range(q), 2):
+            if _rectangle_valid(inst, _answer_for_rectangle(inst, rows, columns)):
+                count += 1
+    return count
+
+
+def _v2_mod_power_two(value, modulus):
+    value %= modulus
+    if value == 0:
+        return modulus.bit_length() - 1
+    return (value & -value).bit_length() - 1
+
+
+def canonical_key(inst):
+    """Affine/isotopy-invariant fingerprint of the internal switch configuration.
+
+    External row, column and symbol relabellings live entirely in the map chains
+    and are intentionally ignored.  The histogram below is invariant under
+    cyclic translations, a common odd multiplier, signs, and row/column transpose.
+    It is a deliberately cheap invariant, not a complete Latin-square isotopy test.
+    """
+
+    q = inst["order"]
+    half = q // 2
+    points = sorted(set(map(tuple, inst["switches"])))
+
+    def oriented(swapped):
+        pairs = {}
+        for index, first in enumerate(points):
+            for second in points[index + 1:]:
+                dx = _v2_mod_power_two(second[0] - first[0], half)
+                dy = _v2_mod_power_two(second[1] - first[1], half)
+                key = (dy, dx) if swapped else (dx, dy)
+                pairs[key] = pairs.get(key, 0) + 1
+        row_counts = {}
+        column_counts = {}
+        for x, y in points:
+            row_counts[x] = row_counts.get(x, 0) + 1
+            column_counts[y] = column_counts.get(y, 0) + 1
+        first_counts = sorted(column_counts.values() if swapped else row_counts.values())
+        second_counts = sorted(row_counts.values() if swapped else column_counts.values())
+        return {
+            "first_multiplicities": first_counts,
+            "second_multiplicities": second_counts,
+            "pair_valuations": [[a, b, count]
+                                for (a, b), count in sorted(pairs.items())],
+        }
+
+    alternatives = [oriented(False), oriented(True)]
+    normalized = min(alternatives, key=lambda x: json.dumps(x, sort_keys=True))
+    payload = {
+        "order": q,
+        "switch_count": len(points),
+        "affine_invariant": normalized,
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(blob).hexdigest()
+
+
+def escalate(params):
+    harder = dict(params)
+    harder["n"] = int(harder.get("n", 12)) + 2
+    # More independently switched native trades add instance crowding and
+    # diversity without lengthening the four-entry answer.
+    harder["switch_count"] = int(harder.get("switch_count", 32)) + 32
+    return harder
+
+
+def _map_answer(answer, row_fn, column_fn, symbol_fn):
+    result = {}
+    for name in ("trade", "mate"):
+        result[name] = [
+            [row_fn(row), column_fn(column), symbol_fn(symbol)]
+            for row, column, symbol in answer[name]
+        ]
+    return result
+
+
+def _external_relabel(inst, rng):
+    """Apply independent public row/column/symbol Feistel relabellings."""
+
+    result = _copy_json(inst)
+    bits = inst["bits"]
+    hr = _new_feistel(rng, bits, 3)
+    hc = _new_feistel(rng, bits, 3)
+    hs = _new_feistel(rng, bits, 3)
+    inv_hr = dict(hr, inverse=True)
+    inv_hc = dict(hc, inverse=True)
+    result["row_map"] = [inv_hr] + result["row_map"]
+    result["column_map"] = [inv_hc] + result["column_map"]
+    result["symbol_map"] = result["symbol_map"] + [hs]
+    result["answer"] = _map_answer(
+        inst["answer"],
+        lambda x: _component(x, hr, bits),
+        lambda x: _component(x, hc, bits),
+        lambda x: _component(x, hs, bits),
+    )
+    return result
+
+
+def _internal_affine_representative(inst, multiplier, row_offset, column_offset):
+    """Change hidden cyclic coordinates without changing the public square."""
+
+    result = _copy_json(inst)
+    bits = inst["bits"]
+    q = inst["order"]
+    if multiplier % 2 != 1:
+        raise ValueError("the cyclic multiplier must be odd")
+    row_affine = {"type": "affine", "multiplier": multiplier,
+                  "offset": row_offset % q}
+    column_affine = {"type": "affine", "multiplier": multiplier,
+                     "offset": column_offset % q}
+    symbol_inverse = {
+        "type": "affine", "multiplier": multiplier,
+        "offset": (row_offset + column_offset) % q, "inverse": True,
+    }
+    result["row_map"] = result["row_map"] + [row_affine]
+    result["column_map"] = result["column_map"] + [column_affine]
+    result["symbol_map"] = [symbol_inverse] + result["symbol_map"]
+    half = q // 2
+    result["switches"] = [
+        [(multiplier * x + row_offset) % half,
+         (multiplier * y + column_offset) % half]
+        for x, y in result["switches"]
+    ]
+    return result
+
+
+def _transpose_instance(inst):
+    result = _copy_json(inst)
+    result["row_map"], result["column_map"] = (
+        result["column_map"], result["row_map"]
+    )
+    result["switches"] = [[y, x] for x, y in result["switches"]]
+    result["answer"] = _map_answer(
+        result["answer"], lambda x: x, lambda x: x, lambda x: x
+    )
+    for name in ("trade", "mate"):
+        result["answer"][name] = [
+            [column, row, symbol]
+            for row, column, symbol in result["answer"][name]
+        ]
+    return result
+
+
+def _reference_tabulate(inst):
+    """O(qr) reference algorithm; returns witness and primitive operation count."""
+
+    q = inst["order"]
+    bits = inst["bits"]
+    half = q // 2
+    row_inverse = [0] * q
+    column_inverse = [0] * q
+    round_evaluations = 0
+    for public in range(q):
+        row_inverse[_chain(public, inst["row_map"], bits)] = public
+        column_inverse[_chain(public, inst["column_map"], bits)] = public
+        round_evaluations += sum(len(component.get("rounds", []))
+                                 for component in inst["row_map"])
+        round_evaluations += sum(len(component.get("rounds", []))
+                                 for component in inst["column_map"])
+    rows = [row_inverse[0], row_inverse[half]]
+    columns = [column_inverse[0], column_inverse[half]]
+    answer = _answer_for_rectangle(inst, rows, columns)
+    # Four exact operation evaluations, each traversing three generated maps.
+    round_evaluations += 4 * sum(
+        len(component.get("rounds", []))
+        for key in ("row_map", "column_map", "symbol_map")
+        for component in inst[key]
+    )
+    return answer, round_evaluations
+
+
+def _attack_small_labels(inst):
+    return _answer_for_rectangle(inst, [0, 1], [0, 1])
+
+
+def _attack_visible_half_shift(inst):
+    half = inst["order"] // 2
+    return _answer_for_rectangle(inst, [0, half], [0, half])
+
+
+def _attack_first_switch_as_public(inst):
+    half = inst["order"] // 2
+    if inst["switches"]:
+        x, y = inst["switches"][0]
+    else:
+        x = y = 0
+    return _answer_for_rectangle(inst, [x, x + half], [y, y + half])
+
+
+def _attack_random_restart(inst, seed, restarts=256):
+    rng = random.Random(seed)
+    candidate = _attack_small_labels(inst)
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if _rectangle_valid(inst, candidate):
+            return candidate
+    return candidate
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def _sample_density(inst, total, seed):
+    rng = random.Random(seed)
+    hits = 0
+    for index in range(total):
+        candidate = random_candidate(inst, rng)
+        valid = _rectangle_valid(inst, candidate)
+        if index < 3 or valid:
+            checker_valid = verify(inst, candidate)[0]
+            if checker_valid != valid:
+                raise AssertionError("fast rectangle test disagrees with verify")
+        hits += int(valid)
+    return hits
+
+
