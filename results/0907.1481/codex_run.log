def is_intercalate(L, r1, c1, r2, c2):
    if L[r1, c1] != L[r2, c2]: return False
    if L[r1, c2] != L[r2, c1]: return False
    return True

def intercalate_homology(L, name):
    n = L.nrows()

    intercalates = []

    for r1 in range(n):
        for c1 in range(n):
            for r2 in range(r1+1, n):
                for c2 in range(c1+1, n):
                    if is_intercalate(L, r1, c1, r2, c2):
                        intercalates.append([1 + r1*n + c1, 1 + r1*n + c2, 1 + r2*n + c1, 1 + r2*n + c2])

    complex = gap(intercalates)

    assert str(gap.IsSimplicialComplex(complex)) == 'true'

    print
    print r"\begin{verbatim}"
    print name
    print "intercalate homology:", gap.SimplicialHomology(complex)
    print r"\end{verbatim}"

