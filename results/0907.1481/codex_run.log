-def _attack_random_restart(inst, seed, restarts=256):
-    rng = random.Random(seed)
-    candidate = _attack_small_labels(inst)
-    for _ in range(restarts):
-        candidate = random_candidate(inst, rng)
-        if _rectangle_valid(inst, candidate):
-            return candidate
-    return candidate
