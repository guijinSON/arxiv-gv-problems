+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+
+STRUCTURAL_HINT = (
+    "In the internal cyclic coordinates, pairs separated by half the order form "
+    "two-symbol rectangles even across the listed switches."
+)
+PLACEBO_HINT = (
