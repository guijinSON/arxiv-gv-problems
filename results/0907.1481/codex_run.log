+        "candidate_space": str(search_space(density_inst)),
+        "sampling_prior": "uniform unordered row-pair and unordered column-pair",
+    }
+
+    demo_inst = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo_inst)
+    reference_started = time.perf_counter()
+    reference_answer, reference_operations = _reference_tabulate(inst)
+    reference_wall = time.perf_counter() - reference_started
+    reference_ok, reference_reason = verify(inst, reference_answer)
+    report["G5_density_and_baseline"] = {
+        "pass": density_hits >= 0 and reference_ok,
+        "shipping_density": {
