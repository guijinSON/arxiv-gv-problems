        \item if $i,j \notin L$, then $\alpha(L) = \alpha'(L)$ and $\beta(L) = \beta'(L)$,
        \item if $\{ i,j \} \cap L \neq \varnothing$ and $L \neq L^{\sigma'}_{i,j}$, then $\alpha(L) = \beta(L) = 0$,
