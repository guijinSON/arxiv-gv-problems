+    "doubled_planted_reason": "ok",
+    "doubled_search_bits": 2218,
+    "doubled_vertices": 2376,
+    "pass": true
+  },
+  "G8_canonical_key": {
+    "distinct_unrelated": 20,
+    "failures": [],
+    "invariance_checks": 60,
+    "invariant": "triangle-enriched stabilized WL color/edge histogram",
+    "pass": true,
