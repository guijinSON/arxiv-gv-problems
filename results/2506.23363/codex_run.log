        \item if $i,j \notin L$, then $\alpha(L) = \alpha'(L)$ and $\beta(L) = \beta'(L)$,
        \item if $i \notin L$ and $j \in L$, then it holds that
        \begin{itemize}
            \item $\alpha(L) = \alpha'(L) + \alpha'(L \cup \{i\}) + \alpha'(L \cup \{i\} \setminus \{j\})$,
            \item $\beta(L) = \beta'(L) + \beta'(L \cup \{i\}) + \beta'(L \cup \{i\} \setminus \{j\})$.
