        \DP_H[k,\sigma] = \sum_{\sigma' \in g^{-1}_{i,j}(\sigma)} \DP_{H'}[k,\sigma'].
    \end{equation}
    If $g^{-1}_{i,j}(\sigma) = \varnothing$ we set $\DP_H[k,\sigma] = 0$.
    Notice that computing $g^{-1}_{i,j}(\sigma)$ requires $n^{\bO(2^\cw)}$ time,
    thus by \cref{eq:cw:join} we can fill the table $\DP_H[\cdot,\cdot]$ in time $n^{\bO(2^\cw)}$.


    \begin{claim}\label{claim:cw:join}
        Let $H = \eta_{i,j}(H')$.
        Assume that for $k \in [0,n]$ and $\sigma \in \Sigma$,
        $\DP_{H'}[k,\sigma]$ is equal to the number of subsets of
        $V(H')$ of size $k$ and $H'$-signature $\sigma$.
        Then it holds that $\DP_H[k,\sigma]$ is equal to the number of subsets of
        $V(H)$ of size $k$ and $H$-signature $\sigma$.
    \end{claim}

    \begin{claimproof}
        Observe that $V(H) = V(H')$, each vertex has the same label in both $H$ and $H'$,
        and $E(H) = E(H') \cup \setdef{uv}{u \in \lab^{-1}_{H'}(i), v \in \lab^{-1}_{H'}(j)}$.
