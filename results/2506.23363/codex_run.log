+    "pass": true
+  },
+  "G8_canonical_key": {
+    "distinct_unrelated": 20,
+    "failures": [],
+    "invariance_checks": 60,
+    "invariant": "triangle-enriched stabilized WL color/edge histogram",
+    "pass": true,
+    "transformed_witness_checks": 20,
+    "unrelated_total": 20
+  },
+  "all_passed": true,
+  "shipping_difficulty": "medium"
+}

