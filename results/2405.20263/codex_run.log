+        "reference_verify_reason": ref_why,
+    }
+
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_solutions == _ATTACK_SEEDS,
+        "attacks": attack_results,
+        "reference_algorithm": {
