+    if not 0 <= decoys <= max_cycles:
+        raise ValueError(f"decoys must lie in 0..{max_cycles} for n={n}")
+    if not 1 <= local_restarts <= 128:
+        raise ValueError("local_restarts must lie in 1..128")
