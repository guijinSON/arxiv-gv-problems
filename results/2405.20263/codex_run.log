+)
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An n-by-n JSON matrix A of bits: A[i][i]=0 and, for i!=j, exactly one "
+        "of A[i][j], A[j][i] is 1; A[i][j]=1 means the arc i->j.  Thus the "
