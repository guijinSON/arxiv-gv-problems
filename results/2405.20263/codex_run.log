+        "greedy_one_pass": {"successes": 0, "attempts": 0,
+                             "iterations": 0, "wall_clock_sec": 0},
+        "random_restart_local_repair": {"successes": 0, "attempts": 0,
+                                         "iterations": 0, "wall_clock_sec": 0},
+        "by_hand_transitive_score_ansatz": {"successes": 0, "attempts": 0,
+                                             "iterations": 0, "wall_clock_sec": 0},
+    }
+    reference_solutions = 0
