+
+def _random_tournament(n, rng):
+    A = [[0] * n for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            bit = rng.randrange(2)
+            A[i][j] = bit
+            A[j][i] = 1 - bit
