+def _attack_transitive_score(inst):
+    marginal, steps = _attack_marginal(inst)
+    scores = [sum(row) for row in marginal]
+    order = sorted(range(inst["n"]), key=lambda v: (scores[v], v), reverse=True)
+    rank = {v: i for i, v in enumerate(order)}
+    A = [[0] * inst["n"] for _ in range(inst["n"])]
+    for i in range(inst["n"]):
+        for j in range(i + 1, inst["n"]):
+            A[i][j] = int(rank[i] < rank[j])
+            A[j][i] = 1 - A[i][j]
+    return A, steps + inst["n"] * (inst["n"] - 1) // 2
