+        "doubled_n": doubled_inst["n"],
+        "shipping_edge_variables": ship["n"] * (ship["n"] - 1) // 2,
+        "doubled_edge_variables": doubled_inst["n"] * (doubled_inst["n"] - 1) // 2,
+        "verify_reason": doubled_why,
