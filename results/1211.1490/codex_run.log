+    new_bits = [0] * n
+    for old, new in enumerate(permutation):
+        new_bits[new] = old_bits[old]
+    transformed = copy.deepcopy(inst)
+    transformed["clauses"] = clauses
+    transformed["answer"] = _bits_to_answer(new_bits)
+    return transformed
