+    }
+
+    attack_results = {
+        "outlier_signed_literal_frequency": {"successes": 0, "attempts": 0},
+        "greedy_single_variable_improvement": {"successes": 0, "attempts": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0},
