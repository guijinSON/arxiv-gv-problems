+    duplicate = answer[:]
+    duplicate[1] = duplicate[0]
+    swapped = answer[:]
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    out_of_range = answer[:]
+    out_of_range[0] = 4 * inst["n"] + 5 * len(inst["clauses"])
+    corruptions = {
+        "drop": drop,
+        "swap": swapped,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    cases = {}
