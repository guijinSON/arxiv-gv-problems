+
+def _vid(i: int, kind: int) -> int:
+    """Variable point ID: kind 0=a, 1=T, 2=F, 3=b."""
+    return 4 * i + kind
+
+
+def _cid(n: int, j: int, kind: int) -> int:
+    """Clause point ID: kind 0=c, 1=p1, 2=p2, 3=p3, 4=d."""
+    return 4 * n + 5 * j + kind
