+    n = len(edges)
+    variable_cycle = []
+    for i, edge in enumerate(edges):
+        dropped = edge - edges[(i + 1) % n]
+        if len(dropped) != 1:
+            raise ValueError("successive XOR triples must drop one variable")
+        variable_cycle.append(next(iter(dropped)))
+    for i, edge in enumerate(edges):
