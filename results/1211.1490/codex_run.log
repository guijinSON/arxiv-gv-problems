+def _attack_low_period_ansatz(inst):
+    n = inst["n"]
+    best = None
+    best_score = -1
+    for period in range(1, 9):
+        for mask in range(1 << period):
+            bits = [(mask >> (i % period)) & 1 for i in range(n)]
+            score = _equation_score(inst, bits)
+            if score > best_score:
+                best, best_score = _bits_to_answer(bits), score
+    return best
