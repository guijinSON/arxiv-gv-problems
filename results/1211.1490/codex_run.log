+    rhs = [equations[edge] for edge in edges]
+    particular = [0, 0]
+    exact_operations = 0
+    for i in range(n - 2):
+        particular.append(rhs[i] ^ particular[i] ^ particular[i + 1])
+        exact_operations += 2
