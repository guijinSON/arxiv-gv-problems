+def _attack_coordinate_greedy(inst):
+    bits = _answer_to_bits_fast(_attack_signed_frequency(inst))
+    score = _equation_score(inst, bits)
+    for i in range(inst["n"]):
+        bits[i] ^= 1
+        trial = _equation_score(inst, bits)
+        if trial > score:
+            score = trial
+        else:
+            bits[i] ^= 1
+    return _bits_to_answer(bits)
