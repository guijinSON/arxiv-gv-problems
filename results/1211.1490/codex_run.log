+
+    doubled_n = 2 * inst["n"]
+    while doubled_n % 3 == 0:
+        doubled_n += 1
+    doubled = make_instance(n=doubled_n, seed=77)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] >= 2 * inst["n"],
