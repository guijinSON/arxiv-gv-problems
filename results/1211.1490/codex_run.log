+    best = None
+    best_score = -1
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        bits = _answer_to_bits_fast(candidate)
+        score = _equation_score(inst, bits)
+        if score > best_score:
+            best, best_score = candidate, score
+        if score == inst["n"]:
+            return candidate
+    return best
