+DIFFICULTY: dict = {
+    "demo": {"n": 5},
+    "easy": {"n": 65},
+    "medium": {"n": 77},
+    "hard": {"n": 89},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "An ordered list of n point IDs. Entry i is exactly T_i=4i+1 or "
+        "F_i=4i+2; it compactly specifies the variable vertices of the completed "
+        "stabbing polygon."
+    ),
+    "bounds": {
