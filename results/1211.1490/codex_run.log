+        "greedy_single_variable_improvement": {"successes": 0, "attempts": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0},
+        "in_context_low_period_ansatz": {"successes": 0, "attempts": 0},
+    }
+    reference_successes = 0
+    reference_times = []
+    reference_operations = []
+    reference_tests = []
