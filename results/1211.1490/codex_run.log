+        "in_context_low_period_ansatz": {"successes": 0, "attempts": 0},
+    }
+    reference_successes = 0
+    reference_times = []
+    reference_operations = []
+    reference_tests = []
+    compact_successes = 0
+    compact_times = []
+    compact_operations = []
+    for seed in range(3100, 3108):
