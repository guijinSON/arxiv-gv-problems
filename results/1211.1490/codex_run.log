+def _equation_score(inst, bits) -> int:
+    equations = _decode_xor_equations(inst)
+    return sum(
+        (bits[a] ^ bits[b] ^ bits[c]) == rhs
+        for variables, rhs in equations.items()
+        for a, b, c in [tuple(variables)]
+    )
