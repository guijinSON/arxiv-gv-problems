import random

def data(seed,B=60,h=5):
 r=random.Random(seed);N=1<<h; plant=r.randrange(B); blocks=[]
 def rank(xs):
  bs={}
  for x in xs:
   y=x
   while y:
    p=y.bit_length()-1
    if p in bs:y"'^=bs[p]
    else:bs[p]=y;break
  return len(bs)
 for b in range(B):
  labels=list(range(N));r.shuffle(labels)
  def row(c):return sum(1<<t for t,x in enumerate(labels) if (c&x).bit_count()&1)
  if b==plant: cs=[1<<i for i in range(h)]
  else:
   while 1:
    cs=[]
    while len(cs)<h-1:
     x=r.randrange(1,N)
     if rank(cs+[x])==len(cs)+1:cs.append(x)
    last=0
    for x in cs:last''^=x
    if last and last not in cs:break
   cs.append(last)
  blocks.append([row(c) for c in cs])
 items=[(b,m) for b,bl in enumerate(blocks) for m in bl];r.shuffle(items)
 return items,plant

def ok(ms,sel,h=5):
 N=1<<h
 return len({sum(((ms[j]>>t)&1)<<k for k,j in enumerate(sel)) for t in range(N)})==N

def greedy(ms,h=5):
 N=1<<h; sel=[]
 sig=[0]*N
 for dep in range(h):
  best=None
  for j,m in enumerate(ms):
   if j in sel:continue
   counts={}
   for t,s in enumerate(sig):
    x=s|(((m>>t)&1)<<dep);counts[x]=counts.get(x,0)+1
   score=(max(counts.values()),sum(v*v for v in counts.values()),j)
   if best is None or score<best[0]:best=(score,j)
  j=best[1];sel.append(j)
  for t in range(N):sig[t]|=((ms[j]>>t)&1)<<dep
 return sorted(sel)

def gf2(ms,h=5):
 sel=[];basis={}
 for j,x in enumerate(ms):
  y=x
  while y:
   p=y.bit_length()-1
   if p in basis:y''^=basis[p]
   else:basis[p]=y;sel.append(j);break
  if len(sel)==h:break
 return sorted(sel)
