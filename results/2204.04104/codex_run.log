+    distinct = len(set(keys))
+    report["G8_canonical_key"] = {
+        "pass": not canonical_failures and distinct == len(keys),
+        "invariance_checks": invariant_checks,
+        "carried_witness_checks": carried_checks,
+        "unrelated_instances": len(keys),
