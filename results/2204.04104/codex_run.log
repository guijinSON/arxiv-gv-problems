+def _digit_count(modulus: int, base: int) -> int:
+    count = 1
+    capacity = base
+    while capacity < modulus:
+        capacity *= base
+        count += 1
+    return count
+
+
+def _base_digits(value: int, base: int, count: int) -> list[int]:
+    digits = []
+    for _ in range(count):
+        digits.append(value % base)
+        value //= base
+    return digits
+
