+        counter["seeds_tested"] += 1
+        query = _query_word(inst, seed, counter)
+        seen = set()
+        diagnostic = True
+        for row in inst["targets"]:
+            response = _feedback(query, row["word"])
+            counter["feedback_calls"] += 1
+            counter["feedback_coordinate_comparisons"] += d
+            if response in seen:
+                diagnostic = False
+                break
+            seen.add(response)
+        if diagnostic:
+            candidate = {
