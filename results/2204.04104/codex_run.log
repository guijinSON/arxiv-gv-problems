+def _reference_algorithm(inst: dict) -> dict:
+    """Literal g=2 query enumeration using exact feedback partitions."""
+    counter = {
+        "seeds_tested": 0,
+        "feedback_calls": 0,
+        "feedback_coordinate_comparisons": 0,
+        "chain_arithmetic_operations": 0,
+        "power_multiplications": 0,
