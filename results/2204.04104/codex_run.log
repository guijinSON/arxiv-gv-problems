+    ``n`` is the number of five-query tag classes, the fixed-length haystack
+    axis.  Exactly one class has full joint rank.  The others have identical
+    balanced one-query and pairwise statistics but one parity dependency.
+    """
+    if not isinstance(n, int) or isinstance(n, bool) or n < 2:
+        raise ValueError("n must be an integer at least 2")
