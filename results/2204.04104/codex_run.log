+def _chain_value(inst: dict, seed: int, counter: dict | None = None) -> int:
+    value = seed
+    modulus = inst["seed_modulus"]
+    for multiplier, offset in inst["affine_chain"]:
+        value = (multiplier * value + offset) % modulus
+        if counter is not None:
