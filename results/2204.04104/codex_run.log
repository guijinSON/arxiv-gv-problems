+def _gf2_rank(values):
+    """Rank of small nonnegative integers viewed as GF(2) row vectors."""
+    pivots = {}
+    for value in values:
+        x = value
+        while x:
+            pivot = x.bit_length() - 1
+            if pivot in pivots:
+                x ^= pivots[pivot]
+            else:
+                pivots[pivot] = x
+                break
+    return len(pivots)
