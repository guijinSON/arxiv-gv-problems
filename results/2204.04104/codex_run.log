+                answer = candidate
+                break
+    wall = time.perf_counter() - start
+    if answer is None:
+        return {"ok": False, "reason": "no strategy found", "answer": None,
+                "wall_clock_sec": wall, "counter": counter}
+    ok, reason = verify(inst, answer)
+    return {"ok": ok, "reason": reason, "answer": answer,
+            "wall_clock_sec": wall, "counter": counter}
 
 
