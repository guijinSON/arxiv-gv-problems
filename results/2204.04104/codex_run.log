+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 3, "h": 3},
+    "easy": {"n": 15, "h": 5},
+    "medium": {"n": 36, "h": 5},
+    "hard": {"n": 60, "h": 5},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A strictly increasing JSON list of exactly h distinct diagnostic-word "
+        "IDs from 0 through q-1, where q=n*h.  The list is the fixed query "
+        "spine of the strategy; feedback determines the final target guess."
+    ),
