+    response = [0] * len(guess)
+    unmatched_target: dict[tuple[int, int], int] = {}
+    for i, (g, w) in enumerate(zip(guess, target)):
+        if g == w:
+            response[i] = 2
+        else:
+            symbol = (i, w)
