+            value = (multiplier * value + offset) % modulus
+        multiplier = rng.randrange(1, modulus)
+        offset = (-multiplier * value) % modulus
+        chain.append([multiplier, offset])
+        if (_terminal_only_guess(chain, modulus) != secret
