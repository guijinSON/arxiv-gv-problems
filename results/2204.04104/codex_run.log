+}
+
+DIFFICULTY = {
+    "demo": {"n": 3, "h": 3},
+    "easy": {"n": 15, "h": 5},
+    "medium": {"n": 36, "h": 5},
+    "hard": {"n": 60, "h": 5},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A strictly increasing JSON list of exactly h distinct diagnostic-word "
+        "IDs from 0 through q-1, where q=n*h.  The list is the fixed query "
+        "spine of the strategy; feedback determines the final target guess."
+    ),
+    "bounds": {
+        "query_count_at_shipping": 300,
+        "query_ids_in_answer": 5,
+        "minimum_id": 0,
+        "maximum_id_at_shipping": 299,
+    },
+}
+
+STRUCTURAL_HINT = (
+    "Within each tag class, dependence of the five balanced cuts is visible in their bitwise-XOR parity."
+)
+PLACEBO_HINT = (
+    "Keep the query identifiers and least-significant-bit convention consistent while checking the cuts."
+)
+
+# Filled after the two isolated diagnostic harness runs.  These numbers are
+# recorded by selftest but never used by verify or generation.
+G9_ARM_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+}
+
+NOTES = (
+    "Definition 2.1 fixes (alphabet, dimension, dictionary, target list, game "
+    "length), Definition 2.2 fixes repeated-letter feedback, and Definition "
+    "2.6 plus Corollary 2.9 make a strategy tree an exact polynomial witness. "
+    "Theorem 3.1 is the easy-regime warning: fixed game length is solvable in "
+    "|WI|^{O(g)}, so this family is Track B, never Track A.  Section 4, Lemma "
+    "4.2 supplies the graph-incidence words and the zero-response spine: a "
+    "dominating query either is the target, identifies an adjacent target by "
+    "its unique edge coordinate, or returns zero.  Every query mask is balanced "
+    "and every same-tag pair has the same intersection, defeating degree/green-"
+    "count outliers and pairwise statistics.  Random query order defeats display "
+    "order; dependent near-miss blocks defeat the obvious per-tag ansatz; mixed "
+    "block permutations defeat greedy refinement and GF(2) row-rank guesses."
+)
+
+
+def _gf2_rank(values):
+    """Rank of small nonnegative integers viewed as GF(2) row vectors."""
+    pivots = {}
+    for value in values:
+        x = value
+        while x:
+            pivot = x.bit_length() - 1
+            if pivot in pivots:
+                x ^= pivots[pivot]
+            else:
+                pivots[pivot] = x
+                break
+    return len(pivots)
+
+
+def _linear_mask(labels, coefficient):
+    """Targets on which the GF(2) linear form is one, as an integer bit set."""
+    mask = 0
+    for target, label in enumerate(labels):
+        if (coefficient & label).bit_count() & 1:
+            mask |= 1 << target
+    return mask
+
+
+def _dependent_coefficients(h, rng):
+    """h distinct nonzero, pairwise-independent rows of total XOR zero."""
+    limit = 1 << h
+    while True:
+        rows = []
+        while len(rows) < h - 1:
+            candidate = rng.randrange(1, limit)
+            if _gf2_rank(rows + [candidate]) == len(rows) + 1:
+                rows.append(candidate)
+        last = 0
+        for row in rows:
+            last ^= row
+        if last and last not in rows:
+            return rows + [last]
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a graph-incidence Wordle instance and its strategy spine.
+
+    ``n`` is the number of five-query tag classes, the fixed-length haystack
+    axis.  Exactly one class has full joint rank.  The others have identical
+    balanced one-query and pairwise statistics but one parity dependency.
+    """
+    if not isinstance(n, int) or isinstance(n, bool) or n < 2:
+        raise ValueError("n must be an integer at least 2")
+    h = params.get("h", 5)
+    if not isinstance(h, int) or isinstance(h, bool) or not 3 <= h <= 6:
+        raise ValueError("h must be an integer from 3 through 6")
+
+    rng = random.Random(seed)
+    target_count = 1 << h
+    planted_tag = rng.randrange(n)
+    tagged_masks = []
+
+    for tag in range(n):
+        labels = list(range(target_count))
+        rng.shuffle(labels)
+        if tag == planted_tag:
+            coefficients = [1 << bit for bit in range(h)]
+        else:
+            coefficients = _dependent_coefficients(h, rng)
+        block = [_linear_mask(labels, coefficient)
+                 for coefficient in coefficients]
+        tagged_masks.extend((tag, mask) for mask in block)
+
+    # Dictionary order is semantically irrelevant and deliberately carries no
+    # hint.  render() groups by the native tag coordinate while retaining IDs.
+    rng.shuffle(tagged_masks)
+    query_tags = [tag for tag, _ in tagged_masks]
+    query_masks = [mask for _, mask in tagged_masks]
+    answer = sorted(index for index, tag in enumerate(query_tags)
+                    if tag == planted_tag)
+
+    query_count = len(query_masks)
+    pair_vertices = math.comb(target_count, 2)
+    graph_vertices = query_count + pair_vertices
+    clique_edges = math.comb(query_count, 2)
+    # Every balanced cut separates (N/2)^2 unordered target pairs.
+    incidence_edges = query_count * (target_count // 2) ** 2
+    edge_coordinates = clique_edges + incidence_edges
+
+    return {
+        "n": n,
+        "h": h,
+        "target_count": target_count,
+        "query_count": query_count,
+        "query_tags": query_tags,
+        "query_masks": query_masks,
+        "graph_vertices": graph_vertices,
+        "pair_vertices": pair_vertices,
+        "edge_coordinates": edge_coordinates,
+        "dimension": edge_coordinates + n,
+        "game_length": h + 1,
+        "answer": answer,
+    }
+
+
+def _group_lines(inst):
+    width = max(1, (inst["target_count"] + 3) // 4)
+    groups = {}
+    for query_id, (tag, mask) in enumerate(zip(inst["query_tags"],
+                                                inst["query_masks"])):
+        groups.setdefault(tag, []).append((query_id, mask))
+    lines = []
+    for tag in sorted(groups):
+        entries = "  ".join(
+            f"Q{query_id}=0x{mask:0{width}x}"
+            for query_id, mask in sorted(groups[tag])
+        )
+        lines.append(f"tag Z{tag}:  {entries}")
+    return "\n".join(lines)
+
+
+def render(inst):
+    """Render the complete implicit Wordle instance and certificate contract."""
+    statement = f"""GENERALIZED WORDLE STRATEGY CERTIFICATE
+
+This is the exact generalized Wordle model below.  A response digit is 2 when
+the guessed and target symbols agree in that coordinate, 1 when the guessed
+symbol occurs in another still-unmatched target coordinate (using occurrences
+from left to right), and 0 otherwise.  A strategy wins only by guessing the
+target word, and must do so for every possible target within the game length.
+
+Parameters: h={inst['h']}, game length={inst['game_length']}, diagnostic words
+q={inst['query_count']}, latent labels={inst['target_count']}, graph-word
+vertices={inst['graph_vertices']}, word dimension={inst['dimension']}.
+
+Here is a finite implicit description of every word; it is the incidence-word
+construction of the problem itself, not an adjacency oracle.  Form a graph with
+diagnostic vertices Q0,...,Q{inst['query_count'] - 1} and pair vertices P(a,b)
+for every 0 <= a < b < {inst['target_count']}.  All Q vertices are mutually
+adjacent.  Qj is adjacent to P(a,b) exactly when bits a and b of Qj's mask
+differ.  There are no edges between pair vertices.  Give every graph edge one
+coordinate and one private edge symbol.  The word for vertex v contains that
+edge symbol in the edge's coordinate when v is incident to it, and otherwise
+contains v's private symbol.  Thus two different vertex words have a nonzero
+response exactly when their vertices are adjacent, and the unique green edge
+coordinate names the other endpoint.
+
+There is also one tag coordinate per displayed tag.  Each Q word has symbol Zk
+in tag coordinate k when displayed under tag Zk and private symbols in all
+other tag coordinates; pair-vertex words use private symbols in all tag
+coordinates.  Symbols named private are distinct from every other symbol.
+These tag coordinates never create a nonzero response against a pair vertex.
+The allowed dictionary and target list are both all graph-vertex words.
+
+A hexadecimal mask has {inst['target_count']} bits.  Bit 0 is the rightmost
+(least significant) bit.  A 1 at bit a means that Qj separates latent label a
+from every label at a 0 bit.  The data are:
+
+{_group_lines(inst)}
+
+Find exactly {inst['h']} distinct diagnostic IDs.  They must be written in
+strictly increasing order.  Guess those Q words in that order.  If a response
+is nonzero, its graph-edge coordinate identifies the target and the strategy
+guesses that target next.  Otherwise continue down the zero-response spine.
+Your IDs are valid exactly when every pair of latent labels is separated by at
+least one selected mask; this makes the Q vertices a dominating set, so the
+strategy wins against every target in at most {inst['game_length']} guesses.
+
+Give your final answer inside <answer></answer> tags, as one JSON list of
+exactly {inst['h']} strictly increasing 0-indexed diagnostic IDs.
+Example: <answer>[3,17,42,88,105]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Parse the delimited JSON list, tolerating prose and Markdown around it."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\s*>(.*?)</answer\s*>", text,
+                         flags=re.IGNORECASE | re.DOTALL)
+    if not matches:
+        return None
+    payload = matches[-1].strip()
+    payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.IGNORECASE)
+    payload = re.sub(r"\s*```$", "", payload)
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, list):
+        return None
+    if any(not isinstance(x, int) or isinstance(x, bool) for x in value):
+        return None
+    return value
+
+
+def _separates_all(inst, query_ids):
+    """Return (valid, first collision) using exact feedback signatures."""
+    signatures = {}
+    for target in range(inst["target_count"]):
+        signature = 0
+        for response_bit, query_id in enumerate(query_ids):
+            signature |= ((inst["query_masks"][query_id] >> target) & 1) \
+                         << response_bit
+        if signature in signatures:
+            return False, (signatures[signature], target)
+        signatures[signature] = target
+    return True, None
+
+
+def verify(inst, answer):
+    """Check any bounded diagnostic spine, never consulting inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer list must not be empty"
+    if any(not isinstance(x, int) or isinstance(x, bool) for x in answer):
+        return False, "every query id must be an integer"
+    if len(answer) != inst["h"]:
+        return False, f"expected exactly {inst['h']} query ids"
+    if len(set(answer)) != len(answer):
+        return False, "query ids must be distinct"
+    if any(x < 0 or x >= inst["query_count"] for x in answer):
+        return False, "query id out of range"
+    if answer != sorted(answer):
+        return False, "query ids must be strictly increasing"
+
+    separated, collision = _separates_all(inst, answer)
+    if not separated:
+        a, b = collision
+        return False, (
+            f"latent labels {a} and {b} have identical zero/nonzero feedback "
+            "histories"
+        )
+
+    # Exact replay of the paper's graph-incidence strategy:
+    # * every Q target is the first query itself or a clique neighbor;
+    # * P(a,b) is adjacent to a selected Q exactly when its mask separates a,b.
+    # In either adjacency case the private edge coordinate names the target, so
+    # one final exact guess succeeds.  The separation loop above checked every
+    # pair vertex, and the list length plus final guess is game_length.
+    if len(answer) + 1 > inst["game_length"]:
+        return False, "strategy exceeds the game length"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the stated, structure-aware h-subset language."""
+    return sorted(rng.sample(range(inst["query_count"]), inst["h"]))
+
+
+def search_space(inst):
+    return math.comb(inst["query_count"], inst["h"])
+
+
+def enumerate_all(inst):
+    """Count every valid bounded certificate when at most 200,000 exist."""
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    return sum(1 for candidate in itertools.combinations(
+        range(inst["query_count"]), inst["h"]
+    ) if verify(inst, list(candidate))[0])
+
+
+def _joint_histogram(masks, target_count):
+    counts = [0] * (1 << len(masks))
+    for target in range(target_count):
+        signature = 0
+        for bit, mask in enumerate(masks):
+            signature |= ((mask >> target) & 1) << bit
+        counts[signature] += 1
+    return sorted(counts)
+
+
+def canonical_key(inst):
+    """Strong cheap invariant under target, query, and tag relabelling.
+
+    Full isomorphism of this colored set system is not attempted.  The key uses
+    every within-tag joint histogram and every between-tag 25-intersection edge
+    label, then takes a relabelling-invariant multiset of incident profiles.
+    """
+    groups = {}
+    for mask, tag in zip(inst["query_masks"], inst["query_tags"]):
+        groups.setdefault(tag, []).append(mask)
+    tags = list(groups)
+    edge_labels = {}
+    for left_pos, left in enumerate(tags):
+        for right in tags[left_pos + 1:]:
+            label = tuple(sorted(
+                (a & b).bit_count()
+                for a in groups[left] for b in groups[right]
+            ))
+            edge_labels[frozenset((left, right))] = label
+
+    block_profiles = []
+    for tag in tags:
+        self_profile = tuple(_joint_histogram(groups[tag],
+                                              inst["target_count"]))
+        incident = sorted(edge_labels[frozenset((tag, other))]
+                          for other in tags if other != tag)
+        block_profiles.append((self_profile, tuple(incident)))
+    structural = [inst["h"], inst["target_count"],
+                  sorted(block_profiles)]
+    blob = json.dumps(structural, separators=(",", ":")).encode("ascii")
+    return hashlib.sha256(blob).hexdigest()
+
+
+def escalate(params):
+    """Grow tag-class decoys while the h-query witness stays fixed."""
+    n = int(params.get("n", 0))
+    h = int(params.get("h", 5))
+    if n < 72:
+        return {"n": min(72, max(n + 1, math.ceil(n * 1.4))), "h": h}
+    if n == 72:
+        return {"n": 73, "h": h}
+    # The tag-parity route costs 4*n+h XOR/output operations.  n=74 would
+    # require 301, so the no-tool operation cap, not the mathematics, binds.
+    return "cap_bound"
+
+
+def reference_algorithm(inst):
+    """Exact balanced-partition backtracking, independent of the planted tags.
+
+    This is the fixed-g specialization of the paper's Section 3 recursion.  It
+    searches query IDs only; at depth r, a viable partial strategy must split
+    the latent labels into 2^r equally sized feedback classes.
+    """
+    started = time.perf_counter()
+    target_count = inst["target_count"]
+    full = (1 << target_count) - 1
+    masks = inst["query_masks"]
+    h = inst["h"]
+    nodes = 0
+    candidate_tests = 0
+    cell_tests = 0
+    target_classifications = 0
+
+    def search(start, depth, cells, chosen):
+        nonlocal nodes, candidate_tests, cell_tests, target_classifications
+        nodes += 1
+        if depth == h:
+            return list(chosen)
+        need = h - depth
+        for query_id in range(start, len(masks) - need + 1):
+            candidate_tests += 1
+            mask = masks[query_id]
+            children = []
+            for cell in cells:
+                cell_tests += 1
+                target_classifications += cell.bit_count()
+                one = cell & mask
+                zero = cell ^ one
+                if one.bit_count() != zero.bit_count():
+                    break
+                children.extend((zero, one))
+            else:
+                found = search(query_id + 1, depth + 1, children,
+                               chosen + (query_id,))
+                if found is not None:
+                    return found
+        return None
+
+    answer = search(0, 0, [full], ())
+    wall = time.perf_counter() - started
+    # Two exact bucket updates per classified target, two popcounts and a
+    # comparison per cell, plus loop/accounting per candidate.
+    operation_slots = (2 * target_classifications + 3 * cell_tests
+                       + candidate_tests)
+    return {
+        "answer": answer,
+        "nodes": nodes,
+        "candidate_tests": candidate_tests,
+        "target_classifications": target_classifications,
+        "operations": operation_slots,
+        "wall_clock_sec": wall,
+    }
+
+
+def _attack_greedy(inst):
+    """Greedily minimize the largest/current feedback bucket."""
+    started = time.perf_counter()
+    signatures = [0] * inst["target_count"]
+    chosen = []
+    operations = 0
+    for depth in range(inst["h"]):
+        best = None
+        for query_id, mask in enumerate(inst["query_masks"]):
+            if query_id in chosen:
+                continue
+            counts = {}
+            for target, old in enumerate(signatures):
+                new = old | (((mask >> target) & 1) << depth)
+                counts[new] = counts.get(new, 0) + 1
+                operations += 1
+            score = (max(counts.values()), sum(x * x for x in counts.values()),
+                     query_id)
+            if best is None or score < best[0]:
+                best = (score, query_id)
+        chosen.append(best[1])
+        mask = inst["query_masks"][best[1]]
+        for target in range(inst["target_count"]):
+            signatures[target] |= ((mask >> target) & 1) << depth
+            operations += 1
+    return sorted(chosen), operations, time.perf_counter() - started
+
+
+def _attack_gf2_row_rank(inst):
+    """The tempting but insufficient raw incidence-row rank heuristic."""
+    chosen = []
+    for query_id, mask in enumerate(inst["query_masks"]):
+        if _gf2_rank([inst["query_masks"][j] for j in chosen] + [mask]) \
+                > len(chosen):
+            chosen.append(query_id)
+        if len(chosen) == inst["h"]:
+            break
+    if len(chosen) < inst["h"]:
+        chosen.extend(j for j in range(inst["query_count"])
+                      if j not in chosen)
+    return sorted(chosen[:inst["h"]])
+
+
+def _attack_pairwise_tag(inst):
+    """Use only same-tag pairwise balance, then a deterministic checksum tie."""
+    groups = {}
+    for query_id, tag in enumerate(inst["query_tags"]):
+        groups.setdefault(tag, []).append(query_id)
+    scored = []
+    for tag, query_ids in groups.items():
+        intersections = [
+            (inst["query_masks"][a] & inst["query_masks"][b]).bit_count()
+            for a, b in itertools.combinations(query_ids, 2)
+        ]
+        pair_error = sum(abs(x - inst["target_count"] // 4)
+                         for x in intersections)
+        checksum = sum(inst["query_masks"][j] for j in query_ids)
+        scored.append((pair_error, checksum, tag, sorted(query_ids)))
+    return min(scored)[3]
+
+
+def _relabel_instance(inst, target_old_to_new=None, query_old_to_new=None,
+                      tag_old_to_new=None):
+    """Carry an instance and its witness through represented Wordle relabellings."""
+    target_count = inst["target_count"]
+    query_count = inst["query_count"]
+    n = inst["n"]
+    if target_old_to_new is None:
+        target_old_to_new = list(range(target_count))
+    if query_old_to_new is None:
+        query_old_to_new = list(range(query_count))
+    if tag_old_to_new is None:
+        tag_old_to_new = list(range(n))
+
+    new_masks = [0] * query_count
+    new_tags = [0] * query_count
+    for old_query, (old_mask, old_tag) in enumerate(zip(
+            inst["query_masks"], inst["query_tags"])):
+        transformed_mask = 0
+        for old_target in range(target_count):
+            if (old_mask >> old_target) & 1:
+                transformed_mask |= 1 << target_old_to_new[old_target]
+        new_query = query_old_to_new[old_query]
+        new_masks[new_query] = transformed_mask
+        new_tags[new_query] = tag_old_to_new[old_tag]
+
+    carried_answer = sorted(query_old_to_new[x] for x in inst["answer"])
+    changed = dict(inst)
+    changed["query_masks"] = new_masks
+    changed["query_tags"] = new_tags
+    changed["answer"] = carried_answer
+    return changed
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(v) for v in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(v) for v in value)
+    return 1
+
+
+def selftest():
+    report = {}
+
+    # G1: every named rung and three unrelated seeds.
+    g1_cases = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_cases += 1
+            if not ok:
+                g1_failures.append([preset, seed, reason])
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "cases": g1_cases,
+        "failures": g1_failures,
+    }
+
+    shipping = make_instance(seed=314159,
+                             **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = shipping["answer"]
+    variants = {
+        "drop_one": planted[:-1],
+        "empty": [],
+    }
+    swapped = list(planted)
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    variants["swap_two"] = swapped
+    duplicated = list(planted)
+    duplicated[0] = duplicated[1]
+    variants["duplicate"] = duplicated
+    out_of_range = list(planted)
+    out_of_range[-1] = shipping["query_count"]
+    variants["out_of_range"] = out_of_range
+    corruptions = {}
+    for name, candidate in variants.items():
+        ok, reason = verify(shipping, candidate)
+        corruptions[name] = {"rejected": not ok, "reason": reason}
+    reasons = [entry["reason"] for entry in corruptions.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": (all(entry["rejected"] for entry in corruptions.values())
+                 and len(set(reasons)) == len(reasons)),
+        "corruptions": corruptions,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    encoded = json.dumps(planted, separators=(",", ":"))
+    realistic = (
+        "The five cuts give distinct feedback histories.\n```json\n"
+        f"<answer>{encoded}</answer>\n```\n"
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": (parsed == planted and verify(shipping, parsed)[0]
+                 and json.loads(json.dumps(planted)) == planted),
+        "prose_and_fence_tolerated": parsed == planted,
+        "json_native": json.loads(json.dumps(planted)) == planted,
+    }
+
+    # G4 and G5 share the shipping-preset density sample.
+    sample_rng = random.Random(20260905)
+    sample_total = 200_000
+    sample_hits = 0
+    sample_started = time.perf_counter()
+    for _ in range(sample_total):
+        if verify(shipping, random_candidate(shipping, sample_rng))[0]:
+            sample_hits += 1
+    sample_wall = time.perf_counter() - sample_started
+    observed_density = sample_hits / sample_total
+    report["G4_guess_resistance"] = {
+        "pass": observed_density < 1e-6,
+        "hits": sample_hits,
+        "total": sample_total,
+        "observed_probability": observed_density,
+        "structure_aware": True,
+        "candidate_space": search_space(shipping),
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_solution_count = enumerate_all(demo)
+
+    attack_results = {
+        "outlier_degree_green_count": {"successes": 0, "attempts": 8},
+        "greedy_partition_refinement": {"successes": 0, "attempts": 8},
+        "random_restart_256": {"successes": 0, "attempts": 8},
+        "gf2_incidence_row_rank": {"successes": 0, "attempts": 8},
+        "same_tag_pairwise_balance": {"successes": 0, "attempts": 8},
+    }
+    greedy_operations = 0
+    greedy_wall = 0.0
+    restart_candidates = 0
+    restart_started = time.perf_counter()
+    reference_successes = 0
+    reference_operations = []
+    reference_walls = []
+    reference_nodes = []
+
+    for seed in range(800, 808):
+        inst = make_instance(seed=seed,
+                             **DIFFICULTY[SHIPPING_DIFFICULTY])
+
+        # All diagnostic vertices have the same degree and green frequency;
+        # deterministic tie-breaking therefore selects the first h IDs.
+        outlier = list(range(inst["h"]))
+        if verify(inst, outlier)[0]:
+            attack_results["outlier_degree_green_count"]["successes"] += 1
+
+        greedy, ops, wall = _attack_greedy(inst)
+        greedy_operations += ops
+        greedy_wall += wall
+        if verify(inst, greedy)[0]:
+            attack_results["greedy_partition_refinement"]["successes"] += 1
+
+        rrng = random.Random(seed ^ 0x51A7)
+        restart_solved = False
+        for _ in range(256):
+            restart_candidates += 1
+            if verify(inst, random_candidate(inst, rrng))[0]:
+                restart_solved = True
+                break
+        if restart_solved:
+            attack_results["random_restart_256"]["successes"] += 1
+
+        if verify(inst, _attack_gf2_row_rank(inst))[0]:
+            attack_results["gf2_incidence_row_rank"]["successes"] += 1
+        if verify(inst, _attack_pairwise_tag(inst))[0]:
+            attack_results["same_tag_pairwise_balance"]["successes"] += 1
+
+        recovered = reference_algorithm(inst)
+        reference_operations.append(recovered["operations"])
+        reference_walls.append(recovered["wall_clock_sec"])
+        reference_nodes.append(recovered["nodes"])
+        if (recovered["answer"] is not None
+                and verify(inst, recovered["answer"])[0]):
+            reference_successes += 1
+
+    restart_wall = time.perf_counter() - restart_started
+    attack_results["greedy_partition_refinement"].update({
+        "operations": greedy_operations,
+        "wall_clock_sec": round(greedy_wall, 6),
+    })
+    attack_results["random_restart_256"].update({
+        "candidates": restart_candidates,
+        "wall_clock_sec": round(restart_wall, 6),
+    })
+    all_attacks_failed = all(result["successes"] == 0
+                             for result in attack_results.values())
+    median_ref_ops = int(statistics.median(reference_operations))
+    median_ref_wall = statistics.median(reference_walls)
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == 8,
+        "attacks": attack_results,
+        "reference_algorithm": {
+            "name": "balanced-partition backtracking (Section 3 specialization)",
+            "complexity": "O(q^h * 2^h) exact operations for fixed h",
+            "wall_clock_sec_median": round(median_ref_wall, 6),
+            "wall_clock_sec_total": round(sum(reference_walls), 6),
+            "operations_median": median_ref_ops,
+            "nodes_median": int(statistics.median(reference_nodes)),
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    report["G5_density_and_baseline"] = {
+        "pass": observed_density < 1e-6 and all_attacks_failed,
+        "shipping_density_hits": sample_hits,
+        "shipping_density_total": sample_total,
+        "shipping_density_estimate": observed_density,
+        "shipping_candidate_space": search_space(shipping),
+        "demo_exact_solution_count": demo_solution_count,
+        "demo_candidate_space": search_space(demo),
+        "strongest_failing_attack": "greedy_partition_refinement",
+        "strongest_failing_attack_operations": greedy_operations,
+        "strongest_failing_attack_wall_sec": round(greedy_wall, 6),
+        "guess_sampling_wall_sec": round(sample_wall, 6),
+    }
+
+    doubled = make_instance(n=2 * DIFFICULTY[SHIPPING_DIFFICULTY]["n"],
+                            h=DIFFICULTY[SHIPPING_DIFFICULTY]["h"],
+                            seed=271828)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": (doubled_ok
+                 and doubled["query_count"] > shipping["query_count"]
+                 and len(doubled["answer"]) == len(planted)),
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "shipping_query_count": shipping["query_count"],
+        "doubled_query_count": doubled["query_count"],
+        "shipping_answer_elements": len(planted),
+        "doubled_answer_elements": len(doubled["answer"]),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    transformed_valid = 0
+    unrelated_keys = []
+    for seed in range(20):
+        inst = make_instance(seed=1000 + seed,
+                             **DIFFICULTY[SHIPPING_DIFFICULTY])
+        original_key = canonical_key(inst)
+        unrelated_keys.append(original_key)
+        relabel_rng = random.Random(9000 + seed)
+        target_perm = list(range(inst["target_count"]))
+        query_perm = list(range(inst["query_count"]))
+        tag_perm = list(range(inst["n"]))
+        relabel_rng.shuffle(target_perm)
+        relabel_rng.shuffle(query_perm)
+        relabel_rng.shuffle(tag_perm)
+        changed_instances = [
+            _relabel_instance(inst, target_old_to_new=target_perm),
+            _relabel_instance(inst, query_old_to_new=query_perm,
+                              tag_old_to_new=tag_perm),
+            _relabel_instance(inst, target_old_to_new=target_perm,
+                              query_old_to_new=query_perm,
+                              tag_old_to_new=tag_perm),
+        ]
+        for changed in changed_instances:
+            invariant_checks += 1
+            if canonical_key(changed) == original_key \
+                    and verify(changed, changed["answer"])[0]:
+                transformed_valid += 1
+    report["G8_canonical_key"] = {
+        "pass": (transformed_valid == invariant_checks
+                 and len(set(unrelated_keys)) == 20),
+        "invariance_checks": invariant_checks,
+        "transformed_instances_valid": transformed_valid,
+        "unrelated_distinct": len(set(unrelated_keys)),
+        "unrelated_attempts": 20,
+        "transformations": [
+            "latent-target permutation",
+            "query/coordinate and tag relabelling",
+            "composition of both relabellings",
+        ],
+    }
+
+    answer_chars = 0
+    answer_atoms = 0
+    for seed in range(20):
+        answer = make_instance(seed=5000 + seed,
+                               **DIFFICULTY[SHIPPING_DIFFICULTY])["answer"]
+        answer_chars = max(answer_chars,
+                           len(json.dumps(answer, separators=(",", ":"))))
+        answer_atoms = max(answer_atoms, _answer_atoms(answer))
+    answer_tokens = math.ceil(answer_chars / 4)
+    intended_operations = (shipping["h"] - 1) * shipping["n"] \
+                          + shipping["h"]
+    arms = json.loads(json.dumps(G9_ARM_RESULTS))
+    hinted_rate = (arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+                   if arms["hinted"]["attempts"] else 0.0)
+    placebo_rate = (arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+                    if arms["placebo"]["attempts"] else 0.0)
+    within_caps = (answer_chars <= 2000 and answer_atoms <= 256
+                   and intended_operations <= 300)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": (
+            "not_run" if not arms["hinted"]["attempts"]
+            else ("too_easy" if arms["hinted"]["solved"] else "hardened")
+        ),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_atoms,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        value.get("pass") for key, value in report.items()
+        if key.startswith("G")
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

