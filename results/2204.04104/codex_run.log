+def _next_table(inst: dict, seed: int) -> list[int]:
+    p = inst["target_modulus"]
+    residue = seed % p
+    row_for_x = {row["x"]: index for index, row in enumerate(inst["targets"])}
+    result = []
+    for spec in inst["positions"]:
+        if spec["kind"] == "active":
+            result.append(row_for_x[(spec["index"] + residue) % p])
+        else:
+            result.append(-1)
+    return result
+
