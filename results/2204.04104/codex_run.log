+                           for i in permutation]
+    for row_index, row in enumerate(inst["targets"]):
+        moved["targets"][row_index]["word"] = [row["word"][i]
+                                                   for i in permutation]
+    moved["answer"]["query"] = [inst["answer"]["query"][i]
