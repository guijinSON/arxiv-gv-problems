+        raise ValueError("the affine chain needs at least two rounds")
+    if rounds > 80:
+        raise ValueError("rounds above 80 exceed the intended-route budget")
+    if modulus <= 128:
+        secret_floor = 64
+    else:
+        secret_floor = 64
+    rng = random.Random(seed)
+
