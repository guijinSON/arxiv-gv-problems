     for p in basis:y=min(y,y"'^p)
     if y:
      basis.append(y);basis.sort(reverse=True);cs.append(x)
    fifth=cs[0]''^cs[1]''^cs[2]''^cs[3]
    if fifth and fifth not in cs:break
   cs.append(fifth)
