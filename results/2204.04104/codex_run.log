def masks_for(seed,B=60,h=5):
 r=random.Random(seed); N=1<<h; blocks=[]
 plant=r.randrange(B)
 for b in range(B):
  labels=list(range(N));r.shuffle(labels)
  def row(c):
   return sum(1<<t for t,x in enumerate(labels) if (c&x).bit_count()&1)
  if b==plant: cs=[1<<i for i in range(h)]
  else:
   # random 4 independent coefficient vectors, fifth xor all
   while 1:
    cs=[]; basis=[]
