+def _unweighted_guess(chain: list[list[int]], modulus: int) -> int:
+    multiplier = 1
+    offset = 0
+    for a, b in chain:
+        multiplier = multiplier * a % modulus
+        offset = (offset + b) % modulus
+    return (-offset * pow(multiplier, -1, modulus)) % modulus
