+        "operations": greedy_operations,
+        "wall_clock_sec": round(greedy_wall, 6),
+    })
+    attack_results["random_restart_256"].update({
+        "candidates": restart_candidates,
+        "wall_clock_sec": round(restart_wall, 6),
+    })
