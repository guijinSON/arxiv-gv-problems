+            "lexicographically_first_factor_triangle": _lexicographic_triangle_attack(target),
+            "greedy_minimum_row_overlap": _greedy_overlap_attack(target),
+            "anchor_plus_next_numeric_labels": _anchor_numeric_attack(target),
+        }
