+    report["G2_rejects_corruption"] = {"pass": True, "reasons": reasons}
+
+    response = (
+        "The two factor projections are central triangles.\n```json\n<answer>"
+        + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```\nAll coordinates are zero-based."
