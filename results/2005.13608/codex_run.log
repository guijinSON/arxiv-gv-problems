/bin/bash -lc "python3 -m py_compile gen_2005_13608.py && python3 - <<'PY'
import gen_2005_13608 as g
checked=0
for name,p in g.DIFFICULTY.items():
    for seed in (0,1,17,99):
        inst=g.make_instance(seed=seed,**p)
        ok,why=g.verify(inst,inst['answer'])
        assert ok,(name,seed,why)
        checked += 1
print('G1 recheck:',checked,'/',checked)
params=dict(g.DIFFICULTY['hard'])
steps=0
while True:
    nxt=g.escalate(params)
    if not isinstance(nxt,dict):
        print('escalate terminal:',repr(nxt),'after',steps,'harder levels')
        break
    params=nxt; steps+=1
print('terminal params:',params)
