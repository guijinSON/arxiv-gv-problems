+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "regular graph given by exact bipartite non-neighbour masks",
+        "direct product of the factor graph with itself",
