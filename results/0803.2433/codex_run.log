+
+    attack_names = [
+        "outlier_endpoint_degree",
+        "greedy_proper_input_order",
+        "greedy_acyclic_input_order",
+        "periodic_edge_list_ansatz",
+        "random_restart_8",
+    ]
+    attack_successes = {name: 0 for name in attack_names}
