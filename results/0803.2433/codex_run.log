   745	def _canonical_role_pattern(n: int, roles: list[tuple[str, int]]) -> tuple[tuple[str, int], ...]:
   746	    forms = []
   747	    for swap in (False, True):
   748	        for reflect in (False, True):
   749	            transformed = []
   750	            for kind, index in roles:
   751	                new_kind = kind
   752	                new_index = index
   753	                if swap and kind in ("T", "B"):
   754	                    new_kind = "B" if kind == "T" else "T"
   755	                if reflect:
   756	                    if new_kind in ("T", "B"):
   757	                        new_index = (-new_index - 1) % n
   758	                    else:
   759	                        new_index = (-new_index) % n
   760	                transformed.append((new_kind, new_index))
   761	            forms.append(tuple(sorted(transformed, key=_role_key)))
   762	    return min(forms)
