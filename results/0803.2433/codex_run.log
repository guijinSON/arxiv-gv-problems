+DIFFICULTY = {
+    "demo": {"n": 4, "subdivisions": 0},
+    "easy": {"n": 72, "subdivisions": 8},
+    "medium": {"n": 76, "subdivisions": 10},
+    "hard": {"n": 80, "subdivisions": 12},
