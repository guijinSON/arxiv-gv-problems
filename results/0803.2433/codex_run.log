   807	def _greedy(inst: dict, *, acyclic: bool, rng: random.Random | None = None, order_mode: str = "input") -> list[int] | None:
   808	    checked = _validated_graph(inst)
   809	    if checked[0] is None:
   810	        return None
   811	    _, edges, incident = checked  # type: ignore[assignment]
   812	    answer = [-1] * len(edges)
   813	    order = list(range(len(edges)))
   814	    if order_mode == "degree":
   815	        order.sort(key=lambda j: (-len(incident[edges[j][0]]) - len(incident[edges[j][1]]), j))
   816	    if rng is not None:
   817	        rng.shuffle(order)
   818	    for edge_id in order:
   819	        choices = list(range(4))
   820	        if rng is not None:
   821	            rng.shuffle(choices)
   822	        for colour in choices:
   823	            if _partial_can_add(edges, incident, answer, edge_id, colour, acyclic):
   824	                answer[edge_id] = colour
   825	                break
   826	        if answer[edge_id] < 0:
   827	            return None
   828	    return answer
