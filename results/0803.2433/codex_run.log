            final_colours.extend([colour, anchor_colour])
            final_tokens.extend([("anchor", 0), ("anchor", 1)])
        elif j == x_index + 1:
            final_edges.append((2 * n, n))
            final_colours.append(colour)
            final_tokens.append(("anchor", 2))
