   661	def _enumerate_base_proper(n: int):
   662	    """Yield all proper base colourings; used only by the demo control."""
   663	    if n > 4:
   664	        return
   665	    for end_top in range(4):
   666	        for end_bottom in range(4):
   667	            for x_colour in range(4):
   668	                for y_colour in range(4):
   669	                    if x_colour == y_colour:
   670	                        continue
   671	                    for top_zero in range(4):
   672	                        if len({end_top, top_zero, x_colour}) < 3:
   673	                            continue
   674	                        for bottom_zero in range(4):
   675	                            if len({end_bottom, bottom_zero, y_colour}) < 3:
   676	                                continue
   677	                            top = [top_zero]
   678	                            bottom = [bottom_zero]
   679	                            rungs: dict[int, int] = {}
   680	
   681	                            def rec(i: int, previous_top: int, previous_bottom: int):
   682	                                if i == n - 1:
   683	                                    if end_top == previous_top or end_bottom == previous_bottom:
   684	                                        return
   685	                                    for rung_colour in range(4):
   686	                                        if rung_colour in (previous_top, end_top, previous_bottom, end_bottom):
   687	                                            continue
   688	                                        top.append(end_top)
   689	                                        bottom.append(end_bottom)
   690	                                        rungs[i] = rung_colour
   691	                                        result = {("T", j): top[j] for j in range(n)}
   692	                                        result.update({("B", j): bottom[j] for j in range(n)})
   693	                                        result.update({("R", j): rungs[j] for j in range(1, n)})
   694	                                        result[("X", 0)] = x_colour
   695	                                        result[("Y", 0)] = y_colour
   696	                                        yield result
   697	                                        top.pop()
   698	                                        bottom.pop()
   699	                                    return
   700	                                for next_top in range(4):
   701	                                    if next_top == previous_top:
   702	                                        continue
   703	                                    for next_bottom in range(4):
   704	                                        if next_bottom == previous_bottom:
   705	                                            continue
   706	                                        for rung_colour in range(4):
   707	                                            if rung_colour in (previous_top, next_top, previous_bottom, next_bottom):
   708	                                                continue
   709	                                            top.append(next_top)
   710	                                            bottom.append(next_bottom)
   711	                                            rungs[i] = rung_colour
   712	                                            yield from rec(i + 1, next_top, next_bottom)
   713	                                            top.pop()
   714	                                            bottom.pop()
   715	
   716	                            yield from rec(1, top_zero, bottom_zero)
