  _,_,j,cs=min(cand)
  for c in cs:
   col[j]=c
   if rec(done+1):return True
   col[j]=-1
  return False
 assert rec(0)
 out={}
 for (u,v,k,i),c in zip(E,col):out[(k,i)]=c
 return nodes, ''.join(map(str,[out['T',i] for i in range(L)])),''.join(map(str,[out['B',i] for i in range(L)])),''.join(map(str,[out['R',i] for i in range(1,L)])),out['X',0],out['Y',0]
for L in range(4,21):
 try:print(L,solve(L))
 except Exception as e:print('FAIL',L,e)
