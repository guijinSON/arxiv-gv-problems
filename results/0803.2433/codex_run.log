   590	def random_candidate(inst: dict, rng: random.Random) -> object:
   591	    """Uniform proper base colouring plus unbiased local subdivision lifts."""
   592	    n = inst["n"]
   593	    base = _sample_base_proper(n, rng)
   594	    tokens = [tuple(token) for token in inst["_tokens"]]
   595	    # The distinguished anchor path has colours X, q, Y.
   596	    x_colour = base[("X", 0)]
   597	    y_colour = base[("Y", 0)]
   598	    middle_choices = [c for c in range(4) if c not in (x_colour, y_colour)]
   599	    anchor_middle = rng.choice(middle_choices)
   600	
   601	    selected = [tuple(role) for role in inst["_subdivision_pattern"]]
   602	    lift: dict[tuple[str, int], dict[int, int]] = {}
   603	    # Reconstruct the canonical prism incidence colours.  For an edge role,
   604	    # each endpoint has two other incident core colours.
   605	    for kind, index in selected:
   606	        role = (str(kind), int(index))
   607	        if kind == "T":
   608	            endpoints = (index, (index + 1) % n)
   609	        elif kind == "B":
   610	            endpoints = (n + index, n + (index + 1) % n)
   611	        else:
   612	            endpoints = (index, n + index)
   613	        edge_colour = base[role]
   614	        endpoint_spares: dict[int, int] = {}
   615	        for vertex in endpoints:
   616	            if vertex < n:
   617	                i = vertex
   618	                incident_roles = [("T", (i - 1) % n), ("T", i)]
   619	                if i != 0:
   620	                    incident_roles.append(("R", i))
   620	                    incident_roles.append(("R", i))
   621	                else:
   622	                    incident_roles.append(("X", 0))
   623	            else:
   624	                i = vertex - n
   625	                incident_roles = [("B", (i - 1) % n), ("B", i)]
   626	                if i != 0:
   627	                    incident_roles.append(("R", i))
   628	                else:
   629	                    incident_roles.append(("Y", 0))
   630	            other = {base[r] for r in incident_roles if r != role}
   631	            choices = [c for c in range(4) if c != edge_colour and c not in other]
   632	            if len(choices) != 1:
   633	                raise AssertionError("proper cubic base must expose one spare")
   634	            endpoint_spares[vertex] = choices[0]
   635	        keep_endpoint = endpoints[rng.randrange(2)]
   636	        other_endpoint = endpoints[1] if keep_endpoint == endpoints[0] else endpoints[0]
   637	        lift[role] = {
   638	            keep_endpoint: edge_colour,
   639	            other_endpoint: endpoint_spares[other_endpoint],
   640	        }
   641	
   642	    answer: list[int] = []
   643	    for token in tokens:
   644	        if token[0] == "base":
   645	            answer.append(base[(str(token[1]), int(token[2]))])
   646	        elif token[0] == "anchor":
   647	            answer.append((x_colour, anchor_middle, y_colour)[int(token[1])])
   648	        elif token[0] == "sub":
   649	            role = (str(token[1]), int(token[2]))
   650	            answer.append(lift[role][int(token[3])])
   651	        else:
   652	            raise AssertionError("unknown hidden edge token")
   653	    return answer
