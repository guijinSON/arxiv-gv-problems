   537	def _weighted_choice(options: list[tuple[tuple[int, ...], int]] | tuple[tuple[tuple[int, ...], int], ...], total: int, rng: random.Random) -> tuple[int, ...]:
   538	    pick = rng.randrange(total)
   539	    for value, weight in options:
   540	        if pick < weight:
   541	            return value
   542	        pick -= weight
   543	    raise AssertionError("weighted choice exhausted")
