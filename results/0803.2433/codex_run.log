    # First turn the distinguished rung path 0--middle--n into a unique
    # length-three path 0--anchor--middle--n.
    anchor = 2 * n + 1
    final_edges: list[tuple[int, int]] = []
    final_colours: list[int] = []
    final_tokens: list[tuple] = []
    x_index = len(old_edges) - 2
