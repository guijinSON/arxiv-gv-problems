 for j,(u,v,*_) in enumerate(E): inc[u].append(j);inc[v].append(j)
 # order dynamic most constraints, but fixed start edges
 col=[-1]*len(E)
 nodes=0
 def ok_edge(j,c):
  u,v,*_=E[j]
