+    "native_objects": [
+        "finite simple connected non-regular subcubic graph",
+        "acyclic edge-colouring with four colours",
+    ],
+    "verification_operations": [
+        "incident-edge colour comparison",
+        "two-colour union-find cycle detection",
+    ],
