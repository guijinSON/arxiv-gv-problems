   395	def _validated_graph(inst: dict) -> tuple[int, list[tuple[int, int]], list[list[int]]] | tuple[None, str, None]:
   396	    vertex_count = inst.get("vertex_count")
   397	    raw_edges = inst.get("edges")
   398	    if isinstance(vertex_count, bool) or not isinstance(vertex_count, int) or vertex_count < 1:
   399	        return None, "instance vertex count is malformed", None
   400	    if not isinstance(raw_edges, list):
   401	        return None, "instance edge list is malformed", None
   402	    edges: list[tuple[int, int]] = []
   403	    seen: set[tuple[int, int]] = set()
   404	    incident = [[] for _ in range(vertex_count)]
   405	    for j, edge in enumerate(raw_edges):
   406	        if (not isinstance(edge, list) or len(edge) != 2
   407	                or any(isinstance(x, bool) or not isinstance(x, int) for x in edge)):
   408	            return None, f"instance edge {j} is malformed", None
   409	        u, v = edge
   410	        if not (0 <= u < vertex_count and 0 <= v < vertex_count) or u == v:
   411	            return None, f"instance edge {j} has invalid endpoints", None
   412	        norm = _norm_edge(u, v)
   413	        if norm in seen:
   414	            return None, "instance has a repeated edge", None
   415	        seen.add(norm)
   416	        edges.append(norm)
   417	        incident[u].append(j)
   418	        incident[v].append(j)
   419	    return vertex_count, edges, incident
