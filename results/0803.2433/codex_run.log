   546	def _sample_base_proper(n: int, rng: random.Random) -> dict[tuple[str, int], int]:
   547	    total, starts = _proper_tables(n)
   548	    suffix = _SUFFIX_REGISTRY[n]
   549	    end_top, end_bottom, x_colour, y_colour, previous_top, previous_bottom = _weighted_choice(starts, total, rng)
   550	    top = [previous_top]
   551	    bottom = [previous_bottom]
   552	    rungs: dict[int, int] = {}
   553	    for i in range(1, n - 1):
   554	        options: list[tuple[tuple[int, ...], int]] = []
   555	        option_total = 0
   556	        for next_top in range(4):
   557	            if next_top == previous_top:
   558	                continue
   559	            for next_bottom in range(4):
   560	                if next_bottom == previous_bottom:
   561	                    continue
   562	                weight = suffix(i + 1, next_top, next_bottom, end_top, end_bottom)  # type: ignore[operator]
   563	                if not weight:
   564	                    continue
   565	                for rung_colour in range(4):
   566	                    if rung_colour in (previous_top, next_top, previous_bottom, next_bottom):
   567	                        continue
   568	                    options.append(((next_top, next_bottom, rung_colour), weight))
   569	                    option_total += weight
   570	        next_top, next_bottom, rung_colour = _weighted_choice(options, option_total, rng)
   571	        top.append(next_top)
   572	        bottom.append(next_bottom)
   573	        rungs[i] = rung_colour
   574	        previous_top, previous_bottom = next_top, next_bottom
   575	    final_rungs = [
   576	        colour for colour in range(4)
   577	        if colour not in (previous_top, end_top, previous_bottom, end_bottom)
   578	    ]
   579	    rungs[n - 1] = rng.choice(final_rungs)
   580	    top.append(end_top)
   581	    bottom.append(end_bottom)
   582	    result = {("T", i): top[i] for i in range(n)}
   583	    result.update({("B", i): bottom[i] for i in range(n)})
   584	    result.update({("R", i): rungs[i] for i in range(1, n)})
   585	    result[("X", 0)] = x_colour
   586	    result[("Y", 0)] = y_colour
   587	    return result
