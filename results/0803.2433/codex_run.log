   481	def _proper_tables(n: int) -> tuple[int, tuple[tuple[tuple[int, ...], int], ...]]:
   482	    """Count initial states for uniform proper-colouring sampling."""
   483	    colours = range(4)
   484	
   485	    @lru_cache(maxsize=None)
   486	    def suffix(i: int, previous_top: int, previous_bottom: int, end_top: int, end_bottom: int) -> int:
   487	        if i == n - 1:
   488	            if end_top == previous_top or end_bottom == previous_bottom:
   489	                return 0
   490	            return 4 - len({previous_top, end_top, previous_bottom, end_bottom})
   491	        total = 0
   492	        for next_top in colours:
   493	            if next_top == previous_top:
   494	                continue
   495	            for next_bottom in colours:
   496	                if next_bottom == previous_bottom:
   497	                    continue
   498	                rung_choices = 4 - len({previous_top, next_top, previous_bottom, next_bottom})
   499	                if rung_choices:
   500	                    total += rung_choices * suffix(
   501	                        i + 1, next_top, next_bottom, end_top, end_bottom
   502	                    )
   503	        return total
   504	
   505	    # Keep the nested cache callable through a registry used by the sampler.
   506	    _SUFFIX_REGISTRY[n] = suffix
   507	    starts: list[tuple[tuple[int, ...], int]] = []
   508	    total = 0
   509	    for end_top in colours:
   510	        for end_bottom in colours:
   511	            for x_colour in colours:
   512	                for y_colour in colours:
   513	                    if x_colour == y_colour:
   514	                        continue
   515	                    for top_zero in colours:
   516	                        if len({end_top, top_zero, x_colour}) < 3:
   517	                            continue
   518	                        for bottom_zero in colours:
   519	                            if len({end_bottom, bottom_zero, y_colour}) < 3:
   520	                                continue
   521	                            weight = suffix(
   522	                                1, top_zero, bottom_zero, end_top, end_bottom
   523	                            )
   524	                            if weight:
   525	                                state = (
   526	                                    end_top, end_bottom, x_colour, y_colour,
   527	                                    top_zero, bottom_zero,
   528	                                )
   529	                                starts.append((state, weight))
   530	                                total += weight
   531	    return total, tuple(starts)
