+def escalate(params: dict) -> dict | str | None:
+    n = int(params.get("n", 4))
+    subdivisions = int(params.get("subdivisions", 0))
+    if 3 * (n + 4) + 2 + (subdivisions + 2) <= 256:
+        return {"n": n + 4, "subdivisions": subdivisions + 2}
+    return "cap_bound"
