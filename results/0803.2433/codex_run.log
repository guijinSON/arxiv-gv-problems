   833	    checked = _validated_graph(inst)
   834	    if checked[0] is None:
   835	        return None, {"nodes": 0, "candidate_checks": 0, "path_vertices": 0}
   836	    _, edges, incident = checked  # type: ignore[assignment]
   837	    answer = [-1] * len(edges)
   838	    counts = {"nodes": 0, "candidate_checks": 0, "path_vertices": 0}
   839	
   840	    # Colour symmetry permits fixing one arbitrary edge to colour zero.
