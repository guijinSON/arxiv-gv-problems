   776	def _partial_can_add(edges: list[tuple[int, int]], incident: list[list[int]], colours: list[int], edge_id: int, colour: int, acyclic: bool, counts: dict[str, int] | None = None) -> bool:
   777	    if counts is not None:
   778	        counts["candidate_checks"] += 1
   779	    u, v = edges[edge_id]
   780	    for other in incident[u] + incident[v]:
   781	        if colours[other] == colour:
   782	            return False
   783	    if not acyclic:
   784	        return True
   785	    for second in range(4):
   786	        if second == colour:
   787	            continue
   788	        stack = [u]
   789	        seen = {u}
   790	        while stack:
   791	            current = stack.pop()
   792	            if counts is not None:
   793	                counts["path_vertices"] += 1
   794	            for other in incident[current]:
   795	                if colours[other] not in (colour, second):
   796	                    continue
   797	                a, b = edges[other]
   798	                nxt = b if a == current else a
   799	                if nxt not in seen:
   800	                    seen.add(nxt)
   801	                    stack.append(nxt)
   802	        if v in seen:
   803	            return False
   804	    return True
