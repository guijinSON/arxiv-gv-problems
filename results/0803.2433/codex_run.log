   765	def canonical_key(inst: dict) -> str:
   766	    roles = [(str(a), int(b)) for a, b in inst["_subdivision_pattern"]]
   767	    payload = {
   768	        "family": "anchored_subdivided_prism",
   769	        "n": int(inst["n"]),
   770	        "pattern": _canonical_role_pattern(int(inst["n"]), roles),
   771	    }
   772	    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
   773	    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
