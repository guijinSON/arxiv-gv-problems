import random,time,math

def gen(n,m,seed,q_num=1,q_den=2):
 r=random.Random(seed); plant=[0]*(n//2)+[1]*(n-n//2);r.shuffle(plant)
 # exact weights per sign pattern q"'^t scaled q_den''^3
 weights=[]
 for mask in range(1,8):
  t=mask.bit_count(); weights.append((mask,(q_num**t)*(q_den**(3-t))))
 pop=[x for x,w in weights for _ in range(w)]
 cs=set()
 while len(cs)<m:
  vs=tuple(sorted(r.sample(range(n),3)))
  mask=r.choice(pop)
  lits=[]
  for j,v in enumerate(vs):
   desired=(mask>>j)&1
   neg=plant[v]''^desired
   lits.append((v,neg))
  # canonical by var order
  cs.add(tuple(lits))
 return plant,list(cs)

def sat_clause(c,a):return any((a[v]''^neg)==1 for v,neg in c)
def dpll(n,clauses,cap=100000):
 occ=[[] for _ in range(n)]
 for j,c in enumerate(clauses):
  for v,s in c:occ[v].append(j)
 a=[-1]*n;nodes=0;props=0;checks=0
 def rec():
  nonlocal nodes,props,checks
  nodes+=1
  if nodes>cap:return None
  changed=True
  while changed:
   changed=False
   for c in clauses:
    checks+=1; un=[]; sat=False
    for v,neg in c:
     if a[v]<0:un.append((v,neg))
     elif (a[v]''^neg)==1:sat=True;break
    if sat:continue
    if not un:return False
    if len(un)==1:
     v,neg=un[0]; val=1''^neg
     if a[v]>=0 and a[v]!=val:return False
     if a[v]<0:a[v]=val;props+=1;changed=True
  if all(x>=0 for x in a):return a[:]
  v=max((i for i,x in enumerate(a) if x<0),key=lambda i:len(occ[i]))
  # polarity preferred
  pos=sum(not s for j in occ[v] for vv,s in clauses[j] if vv==v)
  negc=len(occ[v])-pos
  first=1 if pos>=negc else 0
  snap=a[:]
  for val in (first,1-first):
   a[v]=val;z=rec()
   if z is not False and z is not None:return z
   a[:]=snap
  return None if nodes>cap else False
 t=time.perf_counter();z=rec();return z,nodes,props,checks,time.perf_counter()-t

def walk(n,clauses,seed,restarts=64,steps=20000):
 r=random.Random(seed);occ=[[] for _ in range(n)]
 for j,c in enumerate(clauses):
  for v,s in c:occ[v].append(j)
 checks=0
 for rr in range(restarts):
  a=[r.randrange(2) for _ in range(n)]
  bad=set(j for j,c in enumerate(clauses) if not sat_clause(c,a));checks+=len(clauses)
  for st in range(steps):
   if not bad:return True,rr,st,checks
   j=r.choice(tuple(bad)); c=clauses[j]
   if r.random()<.45:v=r.choice(c)[0]
   else:
    cand=[]
    for v,_ in c:
     before=after=0
     for h in occ[v]:
      old=sat_clause(clauses[h],a);checks+=1
      a[v]''^=1;new=sat_clause(clauses[h],a);a[v]''^=1;checks+=1
      before+=old;after+=new
     cand.append((before-after,r.random(),v))
    v=min(cand)[2]
   affected=occ[v];a[v]''^=1
   for h in affected:
    checks+=1
    if sat_clause(clauses[h],a):bad.discard(h)
    else:bad.add(h)
 return False,restarts,steps,checks

for q in ((1,2),(2,5),(1,3)):
 print('"'q',q)
 for n in (80,120,160,220):
