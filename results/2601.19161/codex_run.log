$b_{1}  b_{2}  b_{3} \;b_{4}  b_{5}  b_{6} \;b_{7}  b_{8}  b_{9} $& 0  & 0  & 0  & 0  & 0  & 0  & 0  & 0  \\
$\textcolor{blue}{ b_{4} }  b_{2}  b_{3} \;\textcolor{blue}{ b_{7} }  b_{5}  b_{6} \;\textcolor{blue}{ b_{1} }  b_{8}  b_{9} $& 0  & 0  & 0  & 0  & 0  & 0  & 0  & 0  \\
