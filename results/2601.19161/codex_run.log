$b_{5}  b_{6}  b_{4} \;b_{8}  b_{9}  b_{7} \;\textcolor{blue}{ b_{2} }  \textcolor{blue}{ b_{3} }  \textcolor{blue}{ b_{1} } $& 0  & 0  & 0  & 0  & 0  & 0  & 0  & 0  \\
$\textcolor{blue}{ b_{2} }  b_{6}  b_{4} \;\textcolor{blue}{ b_{5} }  b_{9}  b_{7} \;\textcolor{blue}{ b_{8} }  b_{3}  b_{1} $& 3  & 2  & 2  & 1  & 2  & 1  & 1  & 0  \\
$b_{2}  \textcolor{blue}{ b_{3} }  b_{4} \;b_{5}  \textcolor{blue}{ b_{6} }  b_{7} \;b_{8}  \textcolor{blue}{ b_{9} }  b_{1} $& 6  & 4  & 4  & 2  & 4  & 2  & 2  & 0  \\
$b_{2}  b_{3}  \textcolor{blue}{ b_{1} } \;b_{5}  b_{6}  \textcolor{blue}{ b_{4} } \;b_{8}  b_{9}  \textcolor{blue}{ b_{7} } $& 9  & 6  & 6  & 3  & 6  & 3  & 3  & 0  \\
