+
+def random_candidate(inst, rng):
+    """Sample uniformly from the fully constrained language GF(q)^n."""
+    return [rng.randrange(inst["q"]) for _ in range(inst["n"])]
+
+
+def search_space(inst):
+    return inst["q"] ** inst["n"]
