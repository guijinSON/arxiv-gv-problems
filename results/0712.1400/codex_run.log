+    duplicate_j = next(
+        i for i in range(len(answer) - 1, 0, -1) if answer[i] != answer[0]
+    )
+    swapped = list(answer)
+    swapped[0], swapped[swap_j] = swapped[swap_j], swapped[0]
+    duplicated = list(answer)
+    duplicated[duplicate_j] = answer[0]
