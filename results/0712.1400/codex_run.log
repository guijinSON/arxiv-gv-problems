+    strongest inexpensive invariant needed for this generated distribution.
+    """
+    matrix, rhs, q = inst["matrix"], inst["rhs"], inst["q"]
+    row_signatures = sorted(
+        [int(rhs[i]), sorted(int(x) for x in row)]
+        for i, row in enumerate(matrix)
