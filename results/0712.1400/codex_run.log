+        0,
+        1,
+        q - 1,
+        rhs[0],
+        sum(rhs) % q,
+        min(rhs),
+        max(rhs),
+        sum(matrix[i][i] for i in range(n)) % q,
+    ]
+    small_scalar = [
+        [(rhs[i] - left[i] * scalar) % q for i in range(n)]
+        for scalar in trial_scalars
+    ]
