+    report["G2_rejects_corruption"] = {
+        "pass": (all(v["rejected"] for v in rejection_reasons.values())
+                 and len(reason_classes) == len(corruptions)),
+        "cases": rejection_reasons,
+        "distinct_reason_classes": len(reason_classes),
