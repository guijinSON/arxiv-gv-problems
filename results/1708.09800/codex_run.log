+
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    reference_times = []
+    reference_operations = []
+    reference_successes = 0
+    for seed in range(8):
+        sample = make_instance(seed=10_000 + seed,
