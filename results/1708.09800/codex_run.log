+        "parsed_pivots": (len(parsed.get("pivots", []))
+                           if isinstance(parsed, dict) else None),
+    }
+
+    guess_rng = random.Random(2718281828)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
