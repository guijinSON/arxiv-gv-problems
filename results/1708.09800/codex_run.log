+def _attack_static_max_pairs(inst):
+    a = inst["matrix"]
+    n = inst["n"]
+    pairs = [(i, j) for i in range(n) for j in range(i + 1, n)
+             if a[i][j] == _HIGH]
+    pairs.sort(key=lambda ij: (min(ij), max(ij)))
+    out = []
+    used = set()
+    for i, j in pairs:
