+    n = inst["n"]
+    pairs = [(i, j) for i in range(n) for j in range(i + 1, n)
+             if a[i][j] == _HIGH]
+    pairs.sort(key=lambda ij: (min(ij), max(ij)))
+    out = []
+    used = set()
+    for i, j in pairs:
+        if i not in used and j not in used:
+            out.extend([i, j])
+            used.update((i, j))
