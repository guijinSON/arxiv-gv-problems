+
+def _pair(i, j):
+    return (i, j) if i < j else (j, i)
+
+
+def _answer_from_path(path):
+    """Alternating endpoints, with the last 4/5 in the base-case order."""
+    out = []
+    lo, hi = 0, len(path) - 1
+    while lo <= hi:
+        out.append(path[lo])
+        lo += 1
+        if lo <= hi:
+            out.append(path[hi])
+            hi -= 1
+    return out
