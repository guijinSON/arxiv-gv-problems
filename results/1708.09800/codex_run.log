+def _sparse_column(items):
+    """Canonical sparse vector; zero is omitted from mathematical support."""
+    return {i: value for i, value in items if value != 0}
+
+
+def _base_columns(inst, r):
+    a = inst["matrix"]
+    top = inst["incline_top"]
