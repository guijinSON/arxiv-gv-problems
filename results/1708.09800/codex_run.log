+            _sparse_column([(x2, top), (x3, a[x2][x3])]),
+            _sparse_column([(x3, top), (x4, a[x3][x4])]),
+            _sparse_column([(x1, a[x1][x4]), (x2, a[x2][x4]), (x4, top)]),
