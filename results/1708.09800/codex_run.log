+def _attack_outlier_static(inst):
+    a = inst["matrix"]
+    n = inst["n"]
+    order = sorted(range(n), key=lambda i: (
+        sum(a[i][j] == 0 for j in range(n) if j != i),
+        -sum(a[i][j] == _HIGH for j in range(n) if j != i),
+        sum(a[i]),
+        i,
+    ))
+    return _plan_from_order(order)
