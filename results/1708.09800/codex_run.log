+        return False, (
+            f"base_max: A[{u},{v}]={a[u][v]}, but the base row maximum is {row_max}"
+        )
+    global_min = min(a[x][y] for q, x in enumerate(remaining)
+                     for y in remaining[q + 1:])
+    if a[u][w] != global_min:
+        return False, (
+            f"base_min: A[{u},{w}]={a[u][w]}, but the base minimum is {global_min}"
+        )
+    return True, "ok"
