+    atoms = sum(len(pivot) for pivot in answer["pivots"]) + len(answer["base"])
+    # Conservative token count for small integer list syntax without a tokenizer.
+    tokens = 2 * atoms + 2
+    return len(blob), tokens, atoms
+
