+def _plan_from_order(order):
+    """Turn a heuristic total order into a structurally well-formed plan."""
+    remaining = list(order)
+    pivots = []
+    while len(remaining) > 5:
+        pivots.append(remaining[:3])
+        remaining = remaining[2:]
