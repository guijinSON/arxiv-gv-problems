+        return None
+    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text, flags=re.I | re.S)
+    for raw in reversed(blocks):
+        value = raw.strip()
+        value = re.sub(r"^```(?:json)?\s*", "", value, flags=re.I)
+        value = re.sub(r"\s*```$", "", value)
+        try:
