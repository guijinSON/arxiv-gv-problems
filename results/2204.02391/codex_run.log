def _odd_at_least(value):
    return value if value % 2 else value + 1


def _pell_pair(exponent):
    """Return A,B with A+B*sqrt(7)=(8+3*sqrt(7))**exponent."""
    a, b = 1, 0
    x, y = 8, 3
    e = exponent
    while e:
        if e & 1:
            a, b = a * x + 7 * b * y, a * y + b * x
        x, y = x * x + 7 * y * y, 2 * x * y
        e //= 2
    return a, b


