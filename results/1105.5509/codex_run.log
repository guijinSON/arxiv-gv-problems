+
+def _matrix_rank_mod(matrix, p):
+    if not matrix:
+        return 0
+    a = [[x % p for x in row] for row in matrix]
+    rows, cols = len(a), len(a[0])
+    rank = 0
+    for col in range(cols):
+        pivot = next((r for r in range(rank, rows) if a[r][col]), None)
+        if pivot is None:
