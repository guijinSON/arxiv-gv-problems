+)
+
+# Replaced only after successful harness-owned measurements.  Zero attempts and
+# the explicit unavailable verdict keep an infrastructure failure from being
+# misreported as oracle hardness.
+_G9_EVIDENCE = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
