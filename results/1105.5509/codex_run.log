+    pair = next(((a, b) for a in positions for b in positions
+                 if a < b and base[a[0]][a[1]] != base[b[0]][b[1]]), None)
+    if pair is not None:
+        a, b = pair
+        swapped[a[0]][a[1]], swapped[b[0]][b[1]] = (
