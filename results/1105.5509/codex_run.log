            ops += 1
            if j:
                total = (total + product) % p
                ops += 1
            else:
                total = product
        shifts.append(total)
    decoded = []
    for row in ordered:
        decoded.append([(row[col] - shifts[col]) % p for col in range(_TAILS)])
        ops += _TAILS
    return decoded, ops


def _monomial_data(n):
    """Return exponent vectors for x_i^2, a*b, and c*d."""
    width = n + 4
    leading = []
    for i in range(n):
