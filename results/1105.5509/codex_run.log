        exp[i] = 2
        leading.append(tuple(exp))
    ab = [0] * width
    ab[n] = ab[n + 1] = 1
    cd = [0] * width
    cd[n + 2] = cd[n + 3] = 1
    return leading, (tuple(ab), tuple(cd))


