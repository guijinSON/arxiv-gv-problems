+        attack_rows["bounded_backtracking"]["solved"] += int(exact is not None)
+        attack_rows["bounded_backtracking"]["nodes"].append(nodes)
+    report["G6_adversary_panel"] = {
+        "pass": all(row["solved"] == 0 for row in attack_rows.values()),
+        "attacks": attack_rows,
+    }
