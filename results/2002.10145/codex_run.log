+    # G2: five corruption modes, five distinct diagnostics.
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_two": _find_rejected_swap(inst),
+        "duplicate_one": planted + [planted[-1]],
+        "empty": [],
+        "out_of_range": planted[:],
+    }
