import random,time

def ch(x,y): return -1 if (x&y).bit_count()&1 else 1

def make(n,q,seed):
 r=random.Random(seed); bits=n.bit_length()-1; high=bits-q
 p=1 << (q+r.randrange(high))
 missing={p|z for z in range(1<<q)}
 known=[y for y in range(n) if y not in missing]
 signs={y:(1 if y==0 else r.choice((-1,1))) for y in known}
 g=[-1]*(1<<q)
 for z in r.sample(range(1<<q),1<<(q-1)):g[z]=1
 tags=list(range(n));r.shuffle(tags)
 rows=[]; anchors={}
 for lab,x in enumerate(tags):
  rows.append([signs[y]*ch(x,y) for y in known])
  if x < (1<<q):anchors[lab]=g[x]
 ans=[g[x&((1<<q)-1)]*ch(x,p) for x in tags]
 return rows,anchors,ans,p,tags

def verify(rows,anchors,a):
 n=len(a)
 return sum(a)==0 and all(a[i]==v for i,v in anchors.items()) and all(sum(a[i]*rows[i][j] for i in range(n))==0 for j in range(len(rows[0])))

def solve(rows,anchors,mod=1000003):
 n=len(rows); w=len(rows[0]); A=[]
 for j in range(w):A.append([rows[i][j]%mod for i in range(n)]+[0])
 for i,v in anchors.items():
  row=[0]*(n+1);row[i]=1;row[n]=v%mod;A.append(row)
 ops=0;t=time.perf_counter()
 for c in range(n):
  piv=next(i for i in range(c,n) if A[i][c])
  A[c],A[piv]=A[piv],A[c]
  inv=pow(A[c][c],mod-2,mod);ops+=3*mod.bit_length()
  for k in range(c,n+1):A[c][k]=A[c][k]*inv%mod;ops+=1
  for i in range(n):
   if i==c:continue
   f=A[i][c]
   if f:
    for k in range(c,n+1):A[i][k]=(A[i][k]-f*A[c][k])%mod;ops+=2
 sol=[1 if A[i][n]==1 else -1 if A[i][n]==mod-1 else 0 for i in range(n)]
 return sol,ops,time.perf_counter()-t
for n,q in [(8,1),(32,3),(64,4),(128,5)]:
 rows,anchors,ans,p,tags=make(n,q,7)
 print(n,len(rows[0]),len(anchors),sum(ans),verify(rows,anchors,ans),p)
 sol,ops,sec=solve(rows,anchors)
 print(' ref',verify(rows,anchors,sol),ops,round(sec,3),sol==ans)
