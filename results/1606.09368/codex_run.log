+def _translate_tags(inst: dict, translation: int) -> dict:
+    """Translate every row tag; implicit column signs absorb the characters."""
+    out = _copy_public_instance(inst)
+    for row in out["rows"]:
+        row["tag"] ^= translation
+    return out
