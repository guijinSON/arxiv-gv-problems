+
+def _validate_params(n: int, missing_count: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise ValueError("n must be an integer")
+    if n < 4 or n > 256 or n & (n - 1):
+        raise ValueError("n must be a power of two in 4..256")
+    if isinstance(missing_count, bool) or not isinstance(missing_count, int):
+        raise ValueError("missing_count must be an integer")
+    # Frequency 0 is retained as the unity column and frequency 1 is retained
+    # so that the obvious alternating-sign ansatz is a guaranteed non-answer.
+    if missing_count < 1 or missing_count > n - 2:
+        raise ValueError("missing_count must lie in 1..n-2")
+
+
+def _character(row_label: int, frequency: int) -> int:
+    return -1 if (row_label & frequency).bit_count() & 1 else 1
+
+
+def _choose_display_order(known: list[int], rng: random.Random) -> list[int]:
+    """Shuffle known frequencies while making first-pair product a non-answer."""
+    nonzero = [value for value in known if value]
+    pairs = [
+        (left, right)
+        for left in nonzero
+        for right in nonzero
+        if left < right and (left ^ right) in known and (left ^ right) != 0
+    ]
+    if not pairs:
+        # Only the tiny demo can approach this branch; using the unity column
+        # still makes the first product a visible (hence invalid) column.
+        first, second = 0, nonzero[0]
+    else:
+        first, second = rng.choice(pairs)
+    rest = [value for value in known if value not in (first, second)]
+    rng.shuffle(rest)
+    return [first, second] + rest
+
+
+def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
+    """Delete columns from a transformed Sylvester matrix, carrying one witness."""
+    unknown = set(params) - {"missing_count"}
+    if unknown:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(unknown)))
+    missing_count = params.get("missing_count", max(1, int(math.log2(n)) - 1))
+    _validate_params(n, missing_count)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+
+    rng = random.Random(seed)
+    missing = sorted(rng.sample(range(2, n), missing_count))
+    missing_set = set(missing)
+    known = [frequency for frequency in range(n) if frequency not in missing_set]
+    displayed = _choose_display_order(known, rng)
+
+    # Independent column negation is one of the equivalence operations listed
+    # immediately after Lemma 1.  The unity column stays +1 to preserve the
+    # paper's seminormalization convention.
+    signs = {frequency: (1 if frequency == 0 else rng.choice((-1, 1)))
+             for frequency in displayed}
+    rows = []
+    for label in range(n):
+        rows.append({
+            "label": label,
+            "signs": [signs[freq] * _character(label, freq)
+                      for freq in displayed],
+        })
+    rng.shuffle(rows)
+
+    target = rng.choice(missing)
+    answer = [_character(label, target) for label in range(n)]
+    return {
+        "family": "seminormalized_hadamard_vector_completion",
+        "n": n,
+        "missing_count": missing_count,
+        "label_bits": int(math.log2(n)),
+        "rows": rows,
+        "answer": answer,
+    }
+
+
