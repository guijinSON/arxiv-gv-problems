+
+DIFFICULTY = {
+    "demo": {"n": 4, "missing_count": 1},
+    "easy": {"n": 32, "missing_count": 4},
+    "medium": {"n": 64, "missing_count": 6},
+    "hard": {"n": 128, "missing_count": 8},
+}
