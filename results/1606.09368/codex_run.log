+            (_relabel_instance(base, row_order=row_order), base["answer"]),
+            (_relabel_instance(base, column_order=column_order), base["answer"]),
+            (_relabel_instance(base, row_order=row_order,
+                               column_order=column_order), base["answer"]),
+            (_negate_display_columns(base, negated_columns), base["answer"]),
+            (renumbered, renumbered_answer),
