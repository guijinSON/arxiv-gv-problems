+"""Verified seminormalized-Hadamard completion instances for arXiv:1606.09368.
+
+The paper builds a seminormalized Hadamard matrix by selecting balanced
+``{+1,-1}`` columns that remain mutually orthogonal.  This module presents one
+such intermediate stage: an unordered collection of mutually orthogonal
+columns, including the all-ones column, and asks for one more balanced column.
+
+Generation is a certificate-carrying transformation.  A Sylvester matrix from
+Equation (3) and Lemma 1 is built first, several nonconstant columns are
+deleted, the remaining columns are independently signed and permuted, and the
+rows are permuted.  One deleted column is retained as the planted answer.
+Verification never uses it: it checks the candidate alphabet, balance, and all
+integer inner products directly.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import sys
+import time
+from collections import Counter
+from typing import Any
+
+
+sys.path.insert(
+    0,
