+    out = _copy_public_instance(inst)
+    out["column_ids"] = [_permute_bits(value, permutation)
+                         for value in out["column_ids"]]
+    for row in out["rows"]:
+        row["tag"] = _permute_bits(row["tag"], permutation)
+    return out
