+def _algorithm_x(inst: dict, node_cap: int = 2_000_000) -> tuple[list[list[int]] | None, dict]:
+    rows, by_cell = _placement_index(inst)
+    uncovered = {tuple(p) for p in inst["free_cells"]}
+    picked: list[int] = []
+    stats = {
