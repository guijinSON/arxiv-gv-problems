+        return None
+    full = {(x0 + dx, y0 + dy) for dx, dy in _CORNERS}
+    missing = full - points
+    if len(missing) != 1:
+        return None
+    miss = next(iter(missing))
+    return [x0, y0, _CORNERS.index((miss[0] - x0, miss[1] - y0))]
