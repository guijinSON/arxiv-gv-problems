+        "carried_witness_checks": carried_checks,
+        "unrelated_instances": 20,
+        "distinct_keys": distinct,
+        "transformations": [
+            "arbitrary input-cell reordering",
+            "all eight square-lattice dihedral symmetries",
+            "global integer translation",
