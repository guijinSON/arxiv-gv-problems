+def canonical_key(inst: dict) -> str:
+    cells = {tuple(p) for p in inst["free_cells"]}
+    canonical = min(_normal_forms(cells))
+    payload = json.dumps(canonical, separators=(",", ":"))
+    return hashlib.sha256(payload.encode()).hexdigest()
