+        return ()
+    anchors = set()
+    for x, y in cells:
+        for dx, dy in _CORNERS:
+            anchors.add((x - dx, y - dy))
+    rows = []
+    for x, y in sorted(anchors):
+        for missing in range(4):
+            row = [x, y, missing]
+            if _tile_cells(row) <= cells:
+                rows.append(row)
+    return tuple(tuple(row) for row in rows)
