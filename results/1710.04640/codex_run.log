+        return None
+    count = 0
+    nodes = 0
+    cap = 2_000_000
+
+    def dfs(uncovered: set[tuple[int, int]]) -> None:
+        nonlocal count, nodes
+        nodes += 1
+        if nodes > cap:
+            return
+        if not uncovered:
+            count += 1
+            return
+        cell = min(
+            uncovered,
+            key=lambda p: sum(_tile_cells(rows[i]) <= uncovered for i in by_cell[p]),
+        )
+        for index in by_cell[cell]:
+            covered = _tile_cells(rows[index])
+            if covered <= uncovered:
