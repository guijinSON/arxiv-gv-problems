+    rng.shuffle(transformed_answer)
+    out = dict(inst)
+    out["free_cells"] = free
+    out["answer"] = transformed_answer
+    radial = max(abs(2 * x + 1) + abs(2 * y + 1) for x, y in transformed_cells)
+    out["diamond_order"] = (radial + 1) // 2 + 3
