+
+def _tile_cells(row: list[int] | tuple[int, int, int]) -> frozenset[tuple[int, int]]:
+    x, y, missing = row
+    return frozenset(
+        (x + dx, y + dy)
+        for code, (dx, dy) in enumerate(_CORNERS)
+        if code != missing
