+        "drop_element": [planted[0][:-1]] + [row[:] for row in planted[1:]],
+        "duplicate": [planted[0][:], planted[0][:]] + [row[:] for row in planted[2:]],
+        "out_of_range": [[planted[0][0], planted[0][1], 4]]
