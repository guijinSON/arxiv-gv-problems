+        p["screen_restarts"] = min(256, max(64, 2 * restarts))
+        return p
+    if exceptions < min(12, n // 4):
+        p["exceptions"] = exceptions + 1
+        p["screen_restarts"] = min(512, max(128, 2 * restarts))
+        return p
+    if 3 * (n + 4) <= 256:
