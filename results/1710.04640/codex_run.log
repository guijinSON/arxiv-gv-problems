+    phases = []
+    for ox, oy in itertools.product(range(2), repeat=2):
+        groups: dict[tuple[int, int], set[tuple[int, int]]] = {}
+        for x, y in cells:
+            groups.setdefault(((x - ox) // 2, (y - oy) // 2), set()).add((x, y))
+            operations += 1
