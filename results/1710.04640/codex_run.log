+
+def _mix_seed(seed: int, nonce: int) -> int:
+    x = (int(seed) & ((1 << 128) - 1)) ^ 0x171004640A5A5A5A5
+    x ^= (nonce + 1) * 0x9E3779B97F4A7C15
+    x ^= x >> 30
+    x *= 0xBF58476D1CE4E5B9
+    x ^= x >> 27
+    return x & ((1 << 128) - 1)
