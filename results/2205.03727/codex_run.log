    20	\begin{multicols}{2}
    21	    \begin{SDP}[Primal]
    22			\label{sdp:primal_repeat}
    23			\[ \min \sum_{\set{i,j} \in E} 2\inprod{\mathbf{x}_i,\mathbf{x}_j}  \]
    24			\subjectto
    25			\begin{align}
    26				\label{eq:sdp11}
    27				&\sum_{i \in V}{\norm{\mathbf{x}_i}^2} = 1\\
    28				\label{eq:sdp21}
