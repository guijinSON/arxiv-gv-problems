    42				&\,\,\,\,\,\,\,\,\,\,\,\,\,\,\,\,\,\,\,   \,\,\,\,\,\, +\sum_{\set{i,j} \in E}B_{ij}\paren{\one_{ij} + \one_{ji}} \\
