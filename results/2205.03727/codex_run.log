def _decode_graph(code: tuple[int, ...]) -> list[list[int]]:
    edges: list[list[int]] = []
    for i, value in enumerate(code):
        bits = format(value, f"0{11 - i}b")
        for offset, bit in enumerate(bits, start=1):
            if bit == "1":
