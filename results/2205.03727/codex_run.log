<p id="Thmtheorem23.p1.1" class="ltx_p"><span id="Thmtheorem23.p1.1.1" class="ltx_text ltx_font_italic">For <math id="Thmtheorem23.p1.m1" class="ltx_Math" alttext="0\leqslant B_{ij}\leqslant t,\,\forall(i,j)\in\left(S\times\left(V\setminus S\right)\right)\cup\left(\left(V\setminus S\right)\times S\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>⩽</mo><msub><mi>B</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>⩽</mo><mi>t</mi></mrow><mo rspace="0.337em">,</mo><mrow><mrow><mo>∀</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>(</mo><mrow><mi>V</mi><mo>∖</mo><mi>S</mi></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo>∪</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><mi>V</mi><mo>∖</mo><mi>S</mi></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">×</mo><mi>S</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">0\leqslant B_{ij}\leqslant t,\,\forall(i,j)\in\left(S\times\left(V\setminus S\right)\right)\cup\left(\left(V\setminus S\right)\times S\right)</annotation></semantics></math> and <math id="Thmtheorem23.p1.m2" class="ltx_Math" alttext="B_{ij}=0,\forall(i,j)\in\left(S\times S\right)\cup\left(\left(V\setminus S\right)\times\left(V\setminus S\right)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mrow><mo>∀</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></mrow><mo>)</mo></mrow><mo>∪</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><mi>V</mi><mo>∖</mo><mi>S</mi></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo>(</mo><mrow><mi>V</mi><mo>∖</mo><mi>S</mi></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{ij}=0,\forall(i,j)\in\left(S\times S\right)\cup\left(\left(V\setminus S\right)\times\left(V\setminus S\right)\right)</annotation></semantics></math> we have that <math id="Thmtheorem23.p1.m3" class="ltx_Math" alttext="\left\lVert B\right\rVert_{2}\leqslant 2t\sqrt{k\left(n-k\right)}\,." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mi>B</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>⩽</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>k</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\left\lVert B\right\rVert_{2}\leqslant 2t\sqrt{k\left(n-k\right)}\,.</annotation></semantics></math></span></p>
