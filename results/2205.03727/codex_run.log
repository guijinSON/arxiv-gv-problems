    68	\begin{align}\label{eq:B_matrix}
    69	    B=B_{S \times S} + B_{S \times \paren{V \setminus S}} + B_{\paren{V \setminus S} \times S} + B_{\paren{V \setminus S} \times \paren{V \setminus S}} = B_{S \times \paren{V \setminus S}} + B_{\paren{V \setminus S} \times S} \mper
    70	\end{align}
    71	We will next show that under the assumption about existence of such $B_{ij}$'s, how we can proceed towards satisfying the optimality conditions for dual. 
    72	
    73	\begin{fact} \label{fact:eigenvec_basic}
    74	Given $T$ to be some set of orthonormal eigenvectors of a symmetric matrix $M$ labeled as 
    75	\begin{align*}
    76	    T= \set{\mathbf{u}^{\paren{1}},\mathbf{u}^{\paren{2}},\hdots,\mathbf{u}^{\paren{n}}} ,
    77	\end{align*}
    78	to show that $M \succeq 0$ it is sufficient to show that ${\mathbf{u}^T}M{\mathbf{u}} \geq 0, \forall \mathbf{u} \in T$.
    79	\end{fact}
    80	
    81	\begin{lemma}\label{lem:dual_matrix_psd}
    82	For $n,k,d, p$ satisfying  $\lambda_{\min}\paren{A_{\paren{V \setminus S} \times \paren{V \setminus S}}-p\one_{V\setminus S}\one_{V \setminus S}^T} \geq - \tau $, $k \geq \paren{\ffrac{512}{\alpha p^{\ffrac{7}{2}}}}\sqrt{n \log n}$, $\gamma \geq \ffrac{1}{2}+\alpha$ and for choice of $\tau = \paren{\ffrac{d\paren{1/2-\alpha}}{\paren{1/2+\alpha}}}$ where
    83	$p \geq 5\paren{\ffrac{\paren{\log k}}{\gamma^4 k}}^{\ffrac{1}{6}}$ and if there exists a $B$ satisfying equation \prettyref{eq:eigenvector_row} such that $\norm{B} \leq \ffrac{896\sqrt{n\paren{\log k}}}{p^{\ffrac{5}{2}}}$, with high probability (over the randomness of the input) the dual matrix $Y \succeq 0$.
    84	Additionally, if the graph is connected, we have that $\lambda_2\paren{Y}>0$.
    85	\end{lemma}
    86	
    87	\begin{proof}
    88	We will proceed using \prettyref{fact:eigenvec_basic} and show that  $\mathbf{u}^T Y \mathbf{u} \geq 0$, 
    89	for all eigenvectors $\mathbf{u} \in T$ of the dual matrix $Y$
    90	with high probability (over the randomness of the input).
    91	We start with the vectors in the set $P_{-\tau}$ which are now also eigenvectors of $Y$ (after padding them with $0$'s). These are already orthonormal since $A_{S \times S}$ is symmetric. Also these eigenvectors have eigenvalue $d+ \lambda_l \geq 0$ and therefore,
    92	\begin{align*}
    93	  {\mathbf{v}^{\paren{l}}}^T Y {\mathbf{v}^{\paren{l}}} = \inprod{\mathbf{v}^{\paren{l}},Y \mathbf{v}^{\paren{l}}} = \paren{d+\lambda_l} \norm{\mathbf{v}^{\paren{l}}}^2 \geq 0,\quad  \forall \, \mathbf{v}^{\paren{l}} \in P_{-\tau} \mper
    94	\end{align*}
    95	
    96	Since the dual matrix $Y$ is symmetric, we can extend the set of vectors $P_{-\tau}$ to a complete orthonormal set of $n$ eigenvectors.
    97	We include an eigenvector $\mathbf{x} \in T \setminus P_{-\tau}$ if $\inprod{\mathbf{x},\mathbf{v}^{(l)}}=0,\forall \mathbf{v}^{(l)} \in P_{-\tau}$. Since $\mathbf{v}^{(l)}_i=0$ for all $i \notin S$, this also implies that
    98	$\inprod{\mathbf{x}_S,\mathbf{v}^{\paren{l}}}=0, \forall \, \mathbf{v}^{\paren{l}} \in P_{-\tau}$ and hence for such a vector $\mathbf{x} \in T \setminus P_{-\tau}$ we have,
    99	\begin{align} \label{eq:qf_term1}
   100	    \mathbf{x}^T A_{S \times S}\mathbf{x} = \mathbf{x}_{S}^T A_{S \times S} \mathbf{x}_S \geq -\tau\norm{\mathbf{x}_{S}}^2 \mper
   101	\end{align}
   102	for $\tau \geq 0$. Now we examine the quadratic form (w.r.t the dual matrix) for such vectors $\mathbf{x}$ in the subspace formed by vectors of the set $T \setminus P_{-\tau}$,
   103	\begin{align*}
   104	    \hspace{-1em}\mathbf{x}^T Y \mathbf{x} 
   105	    &= \mathbf{x}^T\paren{A_{S \times S} + A_{V \setminus S \times V \setminus S} + p\paren{\one\one^T-\one_{S}\one_{S}^T - \one_{V\setminus S}\one_{V\setminus S}^T} + R + dI + B} \mathbf{x}\\
   106	    &\geq \mathbf{x}_S^T\paren{A_{S \times S} -p\one_S\one_{S}^T}\mathbf{x}_S 
   107	    + \mathbf{x}_{V\setminus S}^T\paren{A_{\paren{V\setminus S} \times \paren{V \setminus S}} -p{\one_{V\setminus S}\one_{V \setminus S}^T}}\mathbf{x}_{V \setminus S} \\
   108	    &\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+ \paren{d-\norm{R}-\norm{B}}\norm{\mathbf{x}}^2\\
   109	    &\geq \underbrace{\mathbf{x}_S^T\paren{A_{S \times S} -p\one_S\one_{S}^T}\mathbf{x}_S}_{=T_1}
   110	    + \lambda_{\min}\underbrace{\paren{A_{\paren{V \setminus S} \times \paren{V \setminus S}}-p\one_{V \setminus S}\one_{V \setminus S}^T}}_{=T_2}\norm{\mathbf{x}_{{V \setminus S}}}^2\\
   111	    \numberthis \label{eq:quadratic_form}
   112	   &\qquad\qquad\qquad\qquad\qquad\qquad\qquad\qquad+ \underbrace{\paren{d-\norm{R}-\norm{B}}}_{=T_3} \norm{\mathbf{x}}^2 \mper
   113	\end{align*}
   114	
   115	We start by considering the term $T_1$. We already argue in equation \prettyref{eq:qf_term1} that the term $\mathbf{x}_S^TA_{S \times S}\mathbf{x}_S \geq -\tau$. The $-p\one_S\one_S^T$ term shifts only the $\one_S$ eigenvector of $A_{S \times S}$ and the corresponding eigenvalue is $d-pk$. Now as long as $d-pk \geq -\tau$, we have that the first term is at least $-\tau\norm{\mathbf{x}_S}^2$.
   116	
   117	Next, we consider the term $T_2$. By our assumption on the smallest eigenvalue of $A_{\paren{V \setminus S} \times \paren{V \setminus S}}-p\one_{V \setminus S}\one_{V\setminus S}^T$ we have that,
   118	\begin{align} \label{eq:quadratic_form_p1}
   119	   \mathbf{x}_{V \setminus S}^T\paren{A_{\paren{V \setminus S} \times \paren{V \setminus S}}-p\one_{V \setminus S}\one_{V \setminus S}^T}\mathbf{x}_{V \setminus S} \nonumber
   120	   &\geq \lambda_{\min}\paren{A_{\paren{V \setminus S} \times \paren{V \setminus S}}}\norm{\mathbf{x}_{V\setminus S}}^2\\
   121	   &\geq -\tau\norm{\mathbf{x}_{V \setminus S}}^2 \mper
   122	\end{align}
   123	\noindent
   124	Therefore using equations \prettyref{eq:qf_term1}, \prettyref{eq:quadratic_form} and \prettyref{eq:quadratic_form_p1} we obtain that,
   125	\begin{align}\label{eq:qf_non_positive}
   126	    \mathbf{x}^TY\mathbf{x} \geq \paren{d-\norm{R}-\norm{B}}\norm{\mathbf{x}}^2 -\tau\norm{\mathbf{x}_S}^2 - \tau\norm{\mathbf{x}_{V \setminus S}}^2= \paren{d-\tau-\norm{R}-\norm{B}}\norm{\mathbf{x}}^2 \mper
   127	\end{align}
   128	
   129	We recall that $\norm{R} \leq 2\sqrt{n}$ (\prettyref{claim:random_matrix_norm}) and for our choice of $\tau$ and for 
   130	$B$ satisfying equation \prettyref{eq:eigenvector_row} for each $\mathbf{v}^{(l)} \in P_{-\tau}$ such that
   131	$\norm{B} \leq \ffrac{896\sqrt{n(\log k)}}{p^{\ffrac{5}{2}}}$, in the regimes of $k,n,p$ as stated, we have that,
   132	\begin{align*}
   133	    d-\tau = d\paren{1-\dfrac{1/2-\alpha}{1/2+\alpha}} = \dfrac{2\alpha d}{1/2+\alpha} = \frac{2\alpha\gamma pk}{1/2+\alpha} \geq 2\alpha pk \geq \dfrac{1024}{p^{\ffrac{5}{2}}}\sqrt{n\log n} > \norm{B}+\norm{R} \mper
   134	\end{align*}
   135	Therefore, we obtain that $\mathbf{x}^TY\mathbf{x} \geq 0$ in equation \prettyref{eq:qf_non_positive} and the dual matrix $Y \succeq 0$.
   136	
   137	Now we consider the scenario when the planted bipartite graph is connected.
   138	For eigenvectors $\mathbf{v}^{(l)}\notin P_{-\tau}$, it follows from discussion above and equation \prettyref{eq:qf_non_positive} that the quadratic form is strictly positive.
   139	Next, we consider the eigenvectors  $\mathbf{v}^{(l)} \in P_{-\tau}$ having eigenvalue $d+\lambda_l$.
   140	If the planted bipartite graph is connected, it follows from basic spectral graph theory that the vector $\one_{S_1}-\one_{S_2}$ is the only eigenvector of $A_{S \times S}$ with eigenvalue $-d$.
   141	Therefore, in our construction it is the only eigenvector of $Y$ with eigenvalue $0$.
   142	Therefore we have that $\lambda_2(Y)>0$.
   143	\end{proof}
   144	\noindent
   145	We next present the algorithm based on the guarantees provided by \prettyref{lem:dual_matrix_psd} as,
   146	
   147	\RestyleAlgo{ruled}
   148	\begin{minipage}{\linewidth}
   149	\hspace{-1.75em}
   150		\begin{algorithm}[H]
   151			\caption{}
   152			\label{alg:two}
   153			\begin{algorithmic}[1]
   154				\REQUIRE $G=(V, E)$ sampled as per \prettyref{def:semi-random_model} ($d = \gamma pk, \gamma \geq \ffrac{2}{3}$).
   155				\ENSURE The set of vertices in planted bipartite graph $\mathcal{S}$ (with high probability).
   156				\STATE Solve \prettyref{sdp:primal}.
   157				\STATE Return $\mathcal{S} = \set{i : \norm{\mathbf{x}_i} > 0}$
   158			\end{algorithmic}
   159		\end{algorithm}
   160	\end{minipage}
   161	
   162	\subsection{Setting dual variables using Farkas' Lemma}
   163	\label{sec:dual_feasible}
   164	Now we are left with the task of showing that equation \prettyref{eq:eigenvector_row} indeed has a solution. Also, as discussed in the proof overview \prettyref{sec:proof_overview} (formally in \prettyref{sec:optimal_dual_construction}), we want the dual solution to satisfy the constraint $\norm{B} = \bigO_{p}\paren{\sqrt{n\log k}}$.  \prettyref{lem:dual_matrix_psd} shows that we are done provided there exists a choice of dual variables $B$ which satisfies this constraint. Turns out, this constraint is implied if $B_{ij} \leq t = \bigO_{p}\paren{\sqrt{\ffrac{\log k}{k}}}$ as shown below.
   165	
   166	\begin{lemma}\label{lem:entrywise_bound_general}
   167	For $0 \leq B_{ij} \leq t, \,\forall (i,j) \in \paren{S \times \paren{V \setminus S}} \cup \paren{\paren{V \setminus S} \times S}$ and $B_{ij}=0,\forall (i,j) \in \paren{S \times S} \cup \paren{\paren{V \setminus S} \times \paren{V \setminus S}}$  we have that $\norm{B}_2 \leq 2t\sqrt{k\paren{n-k}} \mper$ 
   168	\end{lemma}
   169	\begin{proof}
   170	\begin{align*}
   171	    \norm{B}_2 
   172	    &\leq \norm{B_{S,\paren{V\setminus S}}}_2 + \norm{B_{\paren{V\setminus S},S}}_2 = 2 \norm{B_{S,\paren{V\setminus S}}}_2 \leq 2\norm{B_{S,V \setminus S}}_F \\ &=2\sqrt{\sum_{i \in S, j \in V \setminus S}B_{ij}^2}  \leq 2t\sqrt{k\paren{n-k}} \mper
   173	\end{align*}
   174	\end{proof}
   175	
   176	\begin{corollary} \label{cor:entrywise_bound}
   177	If each of the dual variable $B_{ij}, \forall (i,j) \in \paren{S \times \paren{V \setminus S}} \cup \paren{\paren{V \setminus S} \times S}$ satisfies $B_{ij} \leq \paren{56L_{-\tau}/p^{\ffrac{3}{2}}}\sqrt{\ffrac{\paren{\log k}}{\gamma k}}$  we have that $\norm{B}_2 \leq \paren{\ffrac{896}{p^{\ffrac{5}{2}}}}\sqrt{n\log k}$.
   178	\end{corollary}
   179	\begin{proof}
   180	We already argue in discussion preceding equation \prettyref{eq:B_matrix}  that $B_{ij}=0,\forall (i,j) \in \paren{S \times S} \cup \paren{\paren{V \setminus S} \times \paren{ V \setminus S}}$.
   181	Using \prettyref{lem:entrywise_bound_general} and setting $t=\paren{56L_{-\tau}/p^{\ffrac{3}{2}}}\sqrt{\ffrac{\paren{\log k}}{\gamma k}}$ we have,
   182	\begin{align*}
   183	    \norm{B}_2 \leq 2t\sqrt{k\paren{n-k}} \leq \dfrac{112L_{-\tau}}{p^{\ffrac{3}{2}}\sqrt{\gamma}}\sqrt{n\log k} \mper
   184	\end{align*}
   185	From \prettyref{fact:threshold_rank} we have that, $L_{-\tau} \leq  \ffrac{\gamma pk^2}{{2\tau}^2}$. Our choice of $\tau$ in \prettyref{lem:dual_matrix_psd} is such that $\tau \geq d/2$. This is because we chose $\tau = \ffrac{(0.5-\alpha)d}{(0.5 + \alpha)}$ where $\alpha \in (0,1/6]$. Hence,
   186	\begin{align*}
   187	    \norm{B}_2 &\leq \frac{112L_{-\tau}}{p^{3/2}\sqrt{\gamma}}\sqrt{n \log k} \leq \frac{112 \gamma pk^2}{2\tau^2p^{3/2}\sqrt{\gamma}}\sqrt{n \log k} \leq \frac{224\sqrt{\gamma}k^2}{\sqrt{p}d^2}\sqrt{n\log k}\\
   188	    &= \frac{224\sqrt{\gamma}k^2}{\sqrt{p}(\gamma pk)^2}\sqrt{n \log k} = \frac{224}{p^{5/2}}.\frac{1}{\gamma^{3/2}}\sqrt{n \log k} \leq \frac{896}{p^{5/2}}\sqrt{n \log k}
   189	\end{align*}
   190	where the last inequality follows from the fact that $\gamma \geq 0.5 + \alpha \geq 0.5$.
   480	\end{align*}
   481	We wish that the term $6\sqrt{\ffrac{{L_{-\tau}}^2\paren{\log k}}{d}} \leq \ffrac{p}{8}$, since solving for $ \sum_{i \in \mathcal{N}}{\inprod{\mathbf{y},\mathbf{w}^{\paren{i}}}}$ in equation \prettyref{eq:bound_second_term} then gives us that,
   482	\begin{align*}
   483	    \sum_{i \in \mathcal{N}}{\inprod{\mathbf{y},\mathbf{w}^{\paren{i}}}} \leq -\dfrac{p}{16}\sqrt{\dfrac{d}{L_{-\tau}}}  \text{ and we are done.}
   484	\end{align*}
   485	\noindent
   486	To show that the term $6\sqrt{\ffrac{{L_{-\tau}}^2\paren{\log k}}{d}} \leq \ffrac{p}{8}$, we start with a lower bound on $p$ as $p \geq 6\paren{\ffrac{\log k}{\gamma^3k}}^{1/5}$ and take powers on both side to get $p^5 \geq \frac{7776 \log k}{\gamma^3 k}$ which implies,
   487	\begin{align*}
   488	    p^2 &\geq \paren{\frac{7776}{\gamma^3p^3}}\frac{\log k}{k} =1944\paren{\frac{\gamma pk^2}{2(\gamma pk/2)^2}}^2 \frac{\log k}{\gamma pk} = 1944 \paren{\frac{\gamma pk^2}{2(d/2)^2}}^2\frac{\log k}{d} \paren{\text{Use } d=\gamma pk}\\
   489	    \numberthis\label{eq:calculatint_p}
   490	    &\geq 1944\paren{\frac{\gamma pk^2}{2\tau^2}}^2\frac{\log k}{d} \geq 1944L_{-\tau}^2\frac{\log k}{d} > \frac{384L_{-\tau}^2\log k}{d} \paren{\text{Use $\tau \geq \frac{d}{2}$ and \prettyref{fact:threshold_rank}}.}
   491	\end{align*}
   492	We note that the lower bound we assumed on $p$ is subsumed by the bound from \prettyref{lem:matrix_concentration_bound}.
   493	Taking square root in equation \prettyref{eq:calculatint_p} we indeed get that $6\sqrt{\ffrac{{L_{-\tau}}^2\paren{\log k}}{d}} \leq \ffrac{p}{8}$.
   494	\end{proof}
   495	
   496	
   497	
   498	
   499	\subsection{Action of Adversary} \label{sec:adversary_action}
   500	We recall that in \prettyref{step:adversary} of our model construction (\prettyref{def:semi-random_model}), we allow a monotone adversary to arbitrarily add edges between two vertices of $\paren{V \setminus S} \times \paren{V \setminus S}$. Here, we argue that despite the action of an adversary, our \prettyref{alg:two} still returns the planted set $S$. To show this, we use the argument from the work \cite{FK01} to recover the planted set $S$ under the action of adversary. 
   501	
   502	\begin{lemma} \label{lem:handle_adversary}
   503	Let $G$ be the graph obtained at end of \prettyref{step:rest_of_graph} and $\tilde G$ be the graph obtained after action of adversary on $G$ as per \prettyref{step:adversary}. Let $\OPT$ denote the cost of optimal solution, then we have $\OPT\paren{\tilde G} = \OPT\paren{G}$ and the solution in equation \prettyref{eq:integral} is the unique optimal solution.
   504	\end{lemma}
   505	\begin{proof}
   506	We start by writing out an exact formulation of the problem as an integer quadratic program,
   507	\begin{mybox}
   508	        \begin{QP}
   509			\label{qp:original_formulation}
   510	\[ \min \sum_{\set{i,j} \in E} x_ix_j\]
   511			\subjectto
   512			\begin{align}
   513				\label{eq:qp1}
   514				&\sum_{i \in V}x_i^2 = 1\\
   515				\label{eq:qp2}
   516				&x_ix_j\leq 0 &\forall \set{i,j} \in E\\
   517				&x_i^2 \in \set{0,1/k}
   518				\mper
   519			\end{align}
   520			\end{QP}
   521	\end{mybox}
   522	
   523	\noindent
   524	We denote by $\mathsf{QPOPT}\paren{G}$ to be the minimum objective value to \prettyref{qp:original_formulation}. Now since this is an exact formulation for our problem we have that, $\OPT\paren{G} = \mathsf{QPOPT}\paren{G}$. Note that \prettyref{sdp:primal} is a relaxation to \prettyref{qp:original_formulation} and hence, \begin{align} \label{eq:relate_optimals}
   525	\SDPOPT\paren{G} \leq \OPT\paren{G} = \mathsf{QPOPT}\paren{G} \mper
   526	\end{align}
   527	
   528	
   529	We will prove our claim by induction on the number of edges added by adversary in \prettyref{step:adversary}. 
   530	We consider the base case first and let $G'$ to be the graph obtained after adding an edge to $G$. Since the integral solution \prettyref{eq:integral} is still a feasible solution to \prettyref{qp:original_formulation} for $G'$, using equality in equation \prettyref{eq:relate_optimals} we have that,
   531	\begin{align*}
   532	    \OPT\paren{G'} = \mathsf{QPOPT}\paren{G'} \leq -d \mper
   533	\end{align*}
   534	Also using inequality in equation \prettyref{eq:relate_optimals} we have that,
   535	\begin{align*}
   536	    -d-\frac{1}{k} \leq \SDPOPT\paren{G'} \leq \OPT\paren{G'},
   537	\end{align*}
   538	where first inequality follows from the fact that a solution of value strictly smaller than $-d-\frac{1}{k}$ to $\SDPOPT\paren{G'}$ would imply a solution of value strictly smaller that $-d$ to $\SDPOPT\paren{G}$. This is because if remove back the added edge from $G'$, the objective value falls by at most $1/k$ (due to the SDP constraint \prettyref{eq:sdp3}). Therefore we have that,
   539	\begin{align*}
   540	    -d-\frac{1}{k} \leq \OPT\paren{G'} \leq -d \mper
   541	\end{align*}
   542	Now since $\OPT\paren{G'}$ only takes values in steps of $1/k$, it can either be $-d$ or $-d-\frac{1}{k}$. However if $\OPT\paren{G'}=-d-\frac{1}{k}$, then $\SDPOPT\paren{G'} \leq -d-\frac{1}{k}$ and once we remove the edge back from $G'$ to obtain $G$, the SDP solution is still a feasible solution to $G$ with value less than or equal to $-d$. However this solution is different from the integral solution $\mathbf{g}\mathbf{g}^T$ since for the solution $\mathbf{g}\mathbf{g}^T$, $\SDPOPT\paren{G'}$ would have been $-d$ as well. Therefore, we have obtained a new solution to our \prettyref{sdp:primal}. However as argued in \prettyref{fact:optimality_conditions}, our SDP can only have a unique solution. Therefore we have that $\OPT\paren{G'}=-d=\OPT\paren{G}$.
   543	
   544	
   545	\noindent
   546	This contradiction above also proves that the SDP solution to $G'$ has to be $\mathbf{g}\mathbf{g}^T$ since otherwise we again get a new solution to \prettyref{sdp:primal} and a contradiction to \prettyref{fact:optimality_conditions} for $G$.
   547	
   548	
   549	\noindent
   550	Now $\tilde G$ is obtained by a sequence of such operations on $G$ and the argument above holds for each such operation, and therefore,
   551	\begin{align*}
   552	    \OPT\paren{G} = \OPT\paren{G'} = \hdots = \OPT\paren{\tilde G} \mper
   553	\end{align*}
   554	\end{proof}
   555	
   556	We have now established everything we require to prove \prettyref{thm:arbitrary_formal}. We put it all together in the proof below.
   557	\begin{proof}[Proof of \prettyref{thm:arbitrary_formal}]
   558	For $\gamma \geq \ffrac{2}{3}$, we show in \prettyref{prop:farkas_apply} that for range of $p \geq 5\paren{\ffrac{\paren{\log k}}{\gamma^4 k}}^{\ffrac{1}{6}}$ and choice of $t = \paren{\ffrac{56L_{-\tau}}{p^{\ffrac{3}{2}}}}\paren{\sqrt{\ffrac{\log k}{\gamma k}}}$ with high probability (over the randomness of the input), the \prettyref{lp:primal} has a solution. As argued in \prettyref{cor:entrywise_bound} this already implies that $\norm{B}_2 \leq \paren{896/p^{\ffrac{5}{2}}}\sqrt{n \log k}$.  
   559	Given this bound on $\norm{B}_2$, \prettyref{lem:dual_matrix_psd} guarantees that the \prettyref{alg:two} returns the planted set $S$ with high probability (over the randomness of the input).
   560	
   561	As argued in \prettyref{lem:handle_adversary}, the solution due to SDP remains optimal even after action of monotone adversary as per \prettyref{step:adversary} in \prettyref{def:semi-random_model}. Therefore \prettyref{alg:two} still return the planted set $S$.
   562	\end{proof}
   455	\paragraph*{Showing existence of a solution to \prettyref{lp:primal_overview}.}
   456	Now, we look at two cases; the first case where the negative terms dominate the summand in equation \prettyref{eq:farkas_no_solution_proof_overview}, then we use the eigenvector structure that $\norm{\mathbf{w}^{\paren{i}}} \leq \ffrac{2}{\sqrt{d}}$ and we are done; for the other case where the positive terms dominate, we relate the positive terms to the negative terms again using the bound we obtained from the eigenvector structure $\norm{\sum_{i \in N(j)}\mathbf{w}^{\paren{i}}} =\bigO_{p}\paren{\sqrt{\log k}}$. 
   457	
   458	Therefore, we argue in \prettyref{lem:farkas_condition_second_term}, that we can upper bound the second term by $-\Omega_{p}\paren{\sqrt{k}}$.
   459	Therefore using these bounds we show in \prettyref{prop:farkas_apply}, that for a choice of $t$ as we obtained above of $t=\bigO_{p}{\paren{\sqrt{\ffrac{\log k}{k}}}}$, equation \prettyref{eq:farkas_no_solution_proof_overview} does not hold. As discussed earlier this implies that the there exists a dual such that conditions (1)-(4), equation \prettyref{eq:eigenvector_row_proof_overview} and $\norm{B}_2=\tilde\bigO\paren{pk}$ holds which further implies that the primal SDP is feasible. Further, if the graph is connected; the  \textit{signed indicator vector}  would be the only eigenvector with eigenvalue $-d$ (after padding to make these the eigenvectors of $Y$), this would be the only eigenvector of $Y$ with eigenvalue $0$. Using \prettyref{fact:optimality_conditions}, this implies that the proposed integral solution in equation \prettyref{eq:integral} is the only integral solution and hence Cholesky Decomposition of our SDP matrix returns the \textit{signed indicator vector} and thus our planted set.
   460	
   461	\subsubsection{Low degree regimes} \label{sec:low_degree_regimes}
   462	The discussion above about SDP holds only where $d = \gamma pk $ where $\gamma \geq 2/3$. Note that this covers our interesting regimes when $d \approx pk$ where the problem is non-trivial. The other case where $d \leq \ffrac{2pk}{3}$, can actually be trivially solved for $k=\Omega_{p}\paren{\sqrt{n \log n}}$ using a degree counting argument along the lines of \cite{Kuc95} as we discuss below.
   463	
   464	Now we consider the regimes when $d = \gamma pk$ with $\gamma \leq \ffrac{2}{3}$. We show that a simple algorithm that collects the bottom $k$ degrees of the graph will work in these regimes since the vertices in $S$ will have smaller degrees compared to vertices in $V \setminus S$.
   465	
   466	\RestyleAlgo{ruled}
   467	\begin{minipage}{\linewidth}
   468	\hspace{-1.75em}
   469		\begin{algorithm}[H]
   470			\caption{}
   471			\label{alg:three}
   472			\begin{algorithmic}[1]
   473			\setlength{\algomargin}{1pt}
   474				\REQUIRE $G=(V, E)$, sampled as per \prettyref{def:planted_model} with adversary as per \prettyref{step:adversary}.
   475				\ENSURE The set of vertices in planted bipartite graph (with high probability) ${S}$.
   476				\STATE Sort the degrees of the vertices in $G$.
   477				\STATE Return $\mathcal{S}$ be the set of bottom $k$ degrees after sorting..
   478			\end{algorithmic}
   479		\end{algorithm}
   480	\end{minipage}
   481	
   482	\begin{lemma} \label{lem:low_degree_proof}
   483	For $k \geq 6\sqrt{\ffrac{6n\log n}{p}}$, \prettyref{alg:three} returns the planted set $S$ with high probability (over the randomness of the input).
   484	\end{lemma}
   485	\begin{proof}
   486	For a vertex $v \in S$ the expected degree is $d+p(n-k)$. We note that this is smaller than $pn$ since $d \leq 2pk/3$. We can upper bound the degree of $v$ (denoted $d(v)$), with high probability (over the randomness of the input) using \prettyref{fact:chernoff_upper} as,
   487	\begin{align*}
   488	    \Pr{d(v) \geq d + p(n-k)+\sqrt{6pn\log n}} \leq  \exp\paren{\frac{-pn(\sqrt{6\log n}/\sqrt{pn})^2}{3}}
   489	    =\frac{1}{n^2}.
   490	\end{align*}
   491	Using a union bound over all $v \in S$, we have that for an any $v \in S$,
   492	\begin{align*}
   493	    \Pr{d(v) \geq d + p(n-k)+\sqrt{6pn\log n}} \leq  \frac{1}{n}.
   494	\end{align*}
   495	Therefore we have with high probability (over the randomness of the input) that $d(v) \leq d+p(n-k) + \sqrt{6pn \log n}$. Similarly for a vertex $v' \notin S$ the degree can be lower bounded with high probability (over the randomness of the input) using \prettyref{fact:chernoff_lower} as,
   496	\begin{align*}
   497	    \Pr{d(v') \leq pn - \sqrt{6pn\log n}} \leq  \exp\paren{\frac{-pn(\sqrt{6\log n}/\sqrt{pn})^2}{2}}=\exp\paren{-3\log n}=\frac{1}{n^3}.
   498	\end{align*}
   499	Now using a union bound over all $ v'\notin S$, we have with high probability (over the randomness of the input) that $d(v') \geq pn - \sqrt{6pn \log n}$. Therefore, with high probability (over the randomness of the input), the degrees differ by, 
   500	\begin{align} \label{eq:degree_concentrate}
   501	    d(v')-d(v) \geq pk-d - 2\sqrt{6pn\log n} \geq \dfrac{pk}{3} - 2\sqrt{6n\log n} \mper
   502	\end{align}
   503	where we have used $d \leq 2pk/3$.
   504	It is also evident from equation \prettyref{eq:degree_concentrate} that for $k \geq 6\sqrt{\ffrac{6n\log n}{p}}$, with high probability (over the randomness of the input), the degree for a vertex $v \in S$ is smaller than degree of any vertex $v' \notin S$.
   505	\end{proof}
   506	
   507	\subsubsection{Action of Adversary}
   508	\label{sec:adversary_proof_overview}
   509	Finally, the action of adversary (allowed to add edges in $\paren{V \setminus S} \times \paren{V \setminus S}$ for $d \geq 2pk/3$) is discussed in \prettyref{sec:adversary_action}.
   510	We show that the inductive argument given by \cite{FK01} also works for our case.
   511	This argument also extends to the semi-random model in \prettyref{def:threshold_rank}.
   512	
   513	For $d \leq 2pk/3$ regimes, \prettyref{alg:three} continues to return the planted set, since the action of adversary only amplifies the difference of degree for a vertex $v \in S$ and vertices $v' \notin S$.
   514	This argument does not extend to the semi-random model in \prettyref{def:threshold_rank}.
     1	\section{Omitted proofs}
     2	
     3	\subsection{Computing the dual of \prettyref{sdp:primal}}
     4	\label{app:lagrangian_calculation}
     5	We compute the dual by writing SDP in matrix form as,
     6	\begin{mybox}
     7			\begin{SDP}
     8			\label{sdp:aprimal}
     9			\[ \min \inprod{A,X}  \]
    10			\subjectto
    11			\begin{align}
    12				&\inprod{I,X} = 1\\
    13				&\inprod{\one_{ij},X} \leq 0 & \forall \set{i,j} \in E\\
    14				&\inprod{\one_{ji},X} \leq 0 & \forall \set{i,j} \in E\\
    15				&k\inprod{D_i,X} \leq 1 & \forall i \in V\\
    16				&X \succeq 0\mper
    17			\end{align}
    18			\end{SDP}
    19		\end{mybox}
    20	
    21	\noindent	
    22	and we compute the Lagrangian associated with \prettyref{sdp:aprimal} as,
    23	\begin{align*}
    24	    \hspace{-1em}
    25	    \mathcal{L}\paren{X,B,Y,\beta} 
    26	    &= \inprod{A,X} + \beta(1-\inprod{I,X}) + \sum_{i \in V}\gamma_i\paren{k\inprod{D_i,X}-1}\\
    27	    &+ \sum_{\set{i,j}\in E}{B_{ij}\inprod{\one_{ij},X}} + \sum_{\set{i,j}\in E}{B_{ji}\inprod{\one_{ji},X}} - \inprod{Y,X}\\
    28	    &=\inprod{A-\beta I+k\sum_{i \in V}\gamma_iD_i+B-Y,X} + \beta-\sum_{i \in V}\gamma_i
    29	\end{align*}
    30	where $\beta$ is unconstrained Lagrange dual variable for the equality constraint and  $B$ is the matrix of non-negative Lagrange variables $B_{ij}$'s and $B_{ji}$'s for the inequality constraints and $Y$ is a p.s.d Lagrange dual matrix variable . We then compute the corresponding Lagrange dual function as,
    31	\begin{align*}
    32	    g\paren{Y,B,\beta} = \inf_{X \succeq 0}{\mathcal{L}\paren{X,B,Y,\beta}} = 
    33	    \begin{cases}
    34	    \beta - \sum\limits_{i \in V}\gamma_i \text{ \quad\quad if } A-\beta I + k\sum\limits_{i \in V}\gamma_iD_i + B - Y = 0\\
    35	    -\infty \text{ \,\,\,\quad\quad\qquad otherwise}
    36	    \end{cases}
    37	\end{align*}
    38	Therefore we obtain the dual SDP program as described in \prettyref{sdp:dual}
    39	
    40	\subsection{Proof of \prettyref{fact:farkas_variant} }
    41	\begin{proof}\label{app:farkas_variant_proof}
    42	The first system of equations $\set{\mathbf{x}:C\mathbf{x}=\mathbf{f}, \mathbf{0} \leq \mathbf{x} \leq \mathbf{u}}$ can equivalently be written using slack variables $\mathbf{x}'$ as the system of equations  $\set{C\mathbf{x}=\mathbf{f}, \mathbf{x}+\mathbf{x}'=\mathbf{u},\mathbf{x} \geq 0,\mathbf{x}' \geq 0}$. We can rewrite the latter system of equations in the standard $\set{\tilde C\tilde{\mathbf{x}}= \tilde{\mathbf{f}},\tilde{\mathbf{x}}\geq 0}$ form by writing the system of equations as,
    43	\begin{align*}
    44	    \begin{bmatrix}
    45	    C & 0\\
    46	    I & I
    47	    \end{bmatrix}
    48	    \begin{bmatrix}
    49	    \mathbf{x}\\
    50	    \mathbf{x}'
    51	    \end{bmatrix}= 
    52	    \begin{bmatrix}
    53	    \mathbf{f}\\
    54	    \mathbf{u}
    55	    \end{bmatrix}
    56	\end{align*}
    57	where the matrix is $\tilde{C}$ and $\tilde{\mathbf{x}} = \begin{bmatrix}
    58	\mathbf{x} &\mathbf{x}'
    59	\end{bmatrix}^T$ and $\tilde{\mathbf{f}} = \begin{bmatrix}
    60	\mathbf{f} &\mathbf{u}
    61	\end{bmatrix}^T$.
    62	Now using standard variant of Farkas' Lemma the corresponding dual system is $\set{\tilde{C}^T\tilde{\mathbf{y}} \geq 0, \tilde{\mathbf{f}}^T\tilde{\mathbf{y}}<0}$ where $\tilde{\mathbf{y}} = \begin{bmatrix}
    63	\mathbf{y} &\mathbf{z}
    64	\end{bmatrix}^T$.
    65	We can rewrite the constraint $\tilde{C}^T\tilde{\mathbf{y}}^T \geq 0$ of the dual system as,
    66	\begin{align*}
    67	    \begin{bmatrix}
    68	    C & 0\\
    69	    I & I
    70	    \end{bmatrix}^T
    71	    \begin{bmatrix}
    72	    \mathbf{y}\\
    73	    \mathbf{z}
    74	    \end{bmatrix} =
    75	    \begin{bmatrix}
    76	    C^T & I\\
    77	    0 & I
    78	    \end{bmatrix}
    79	    \begin{bmatrix}
    80	    \mathbf{y}\\
    81	    \mathbf{z}
    82	    \end{bmatrix} =
    83	    \begin{bmatrix}
    84	    {C^T\mathbf{y}+\mathbf{z}}\\
    85	    \mathbf{z}
    86	    \end{bmatrix}
    87	    \geq 0
    88	\end{align*}
    89	and we get the constraints that $\mathbf{z} \geq 0$ and $C^T\mathbf{y}+\mathbf{z} \geq 0$ as in \prettyref{fact:farkas_variant}. Next, we consider the dual constraint $\tilde{\mathbf{f}}^T\tilde{\mathbf{y}}<0$  and we can rewrite it as
    90	\begin{align*}
    91	    \begin{bmatrix}
    92	    \mathbf{f}&
    93	    \mathbf{u}
    94	    \end{bmatrix}
    95	    \begin{bmatrix}
    96	    \mathbf{y}\\
    97	    \mathbf{z}
    98	    \end{bmatrix} <0
    99	\end{align*}
   100	which gives the constraint $\mathbf{f}^T\mathbf{y}+ \mathbf{u}^T\mathbf{z}<0$ from \prettyref{fact:farkas_variant}.
   101	Therefore, we obtain the second system of equations 
   102	$\set{\mathbf{y}:C^T\mathbf{y} + \mathbf{z}  \geq 0,\mathbf{f}^T\mathbf{y} + \mathbf{u}^T\mathbf{z}<0,\mathbf{y} \in \mathbb{R}^{L_{-\tau}},\mathbf{z} \geq 0} \mper$
   103	
   104	
   105	Now, that we show that these are dual systems, using the standard variant of Farkas' Lemma (refer Chapter 5,\cite{BV04}) we have that only one of these system of equations has a solution. 
   106	\end{proof}
   107	
   108	
   109	\subsection{Proof of \prettyref{fact:optimality_conditions}}
   110	\label{app:sdp_complementary_slackness}
   111	\begin{proof}
   112	First we argue that $X$ has to be a rank one matrix. We consider a proof by contradiction and let $X = \sum\limits_{i=1}^{n}\lambda_i \mathbf{v}_i\mathbf{v}_i^T$ where $\lambda_i \geq 0$ (since $X \succeq 0$) and $\mathbf{v}_{i}$'s are orthonormal. By complementary slackness we have,
   113	\begin{align}
   114	    X\cdot Y = 0 \implies \sum_{i=1}^{n} \lambda_i \mathbf{v}_i^TY\mathbf{v}_i = 0 \mper
   115	\end{align}
   116	Since $Y \succeq 0$, we have $\mathbf{v}_i^TY\mathbf{v}_i \geq 0,\lambda_i \geq 0, \forall i \in [n]$ and hence $\lambda_i\mathbf{v}_i^TY\mathbf{v}_i=0,\forall i \in [n]$.
   117	Since $Y \succeq 0$, we have $Y=C^TC$ for some C and whenever $\lambda_i \neq 0$, it implies that $\mathbf{v}_i^TY\mathbf{v}_i = \mathbf{v}_i^TC^TC\mathbf{v}_i = \inprod{C\mathbf{v}_i,C\mathbf{v}_i}=\norm{C\mathbf{v}_i}^2=0$ and hence $C\mathbf{v}_i=0$. Now, $Y\mathbf{v}_i =C^T(C\mathbf{v}_i)= 0$ and hence $\mathbf{v}_i \in \mathsf{nullity}(Y)$. Now for sake of contradiction we consider $\mathsf{rank}(X) \geq 2$, then we have some $\lambda_i,\lambda_j \neq 0$ and therefore $\mathbf{v}_i,\mathbf{v}_j \in \mathsf{nullspace}(Y)$. Since $\mathbf{v}^{(i)},\mathbf{v}^{(j)}$ are orthonormal we have $\mathsf{nullity}(Y) \geq 2$. Using rank-nullity theorem we get $\mathsf{rank}(Y) = n- \mathsf{nullity}(Y) \leq n-2$.
   118	This contradicts the fact that $\mathsf{rank}(Y)=n-1$.
   119	
   120	Also, $X=\mathbf{g}\mathbf{g}^T$ is the unique solution since otherwise if there is some other rank one solution (say $X=\mathbf{h}\mathbf{h}^T$), any convex combination of these has the same objective value and gives us an optimal (in objective function value) rank two solution.
   121	\end{proof}
   122	
   123	
   124	\subsection{Proof of \prettyref{fact:matrix_expt}}
   125	\begin{proof} \label{app:matrix_expt}
   126	By our definition of $M$ we have that,
   127	\begin{align*}
   128	    M_{rr}= \sum_{i \in N(j)}\paren{{\mathbf{w}^{\paren{i}}{\mathbf{w}^{\paren{i}}}^T}}_{rr} =  \sum_{i \in N(j)}\paren{w^{\paren{i}}_r}^2 
   129	\end{align*}
   130	and taking expectation over the choice of random edges $i \in N(j)$ we obtain,
   131	\begin{align*}
   132	    \E\Brac{M_{rr}} = \E\Brac{ \sum_{i \in S}\one_{i \in N(j)}\paren{w^{\paren{i}}_r}^2} = \sum_{i \in S}{\E\Brac{\one_{i \in N(j)}\paren{w^{\paren{i}}_r}^2}}
   133	\end{align*}
   134	where $\one_{i \in N(j)}$ is an indicator random variable for the edge $\set{i,j}$ and takes the value $1$ with probability $p$ and $0$ with probability $1-p$. Therefore,
   135	\begin{align*}
   136	    \E\Brac{M_{rr}} = \sum_{i \in S}{\E\Brac{\one_{i \in N(j)}\paren{w^{\paren{i}}_r}^2}} = p\sum_{i \in S}{\paren{w^{\paren{i}}_r}^2} = p\sum_{i \in S}{\paren{v^{\paren{r}}_i}^2} = p\norm{\mathbf{v}^{\paren{r}}}^2 = p
   137	    \mper
   138	\end{align*}
   139	Similarly we obtain $\E\Brac{M_{rs}}$ for $r\neq s$ as
   140	\begin{align*}
   141	    \E\Brac{M_{rs}} 
   142	    &= \E\Brac{\sum_{i \in N(j)}w^{\paren{i}}_rw^{\paren{i}}_s} = \E\Brac{\sum_{i \in S}\one_{i \in N(j)}w^{\paren{i}}_rw^{\paren{i}}_s} = \sum_{i \in S}\E\Brac{\one_{i \in N(j)}w^{\paren{i}}_rw^{\paren{i}}_s}\\ 
   143	    &= p\sum_{i \in S}w^{\paren{i}}_rw^{\paren{i}}_s = p\sum_{i \in S}v^{\paren{r}}_iv^{\paren{s}}_i = p\inprod{\mathbf{v}^{\paren{r}},\mathbf{v}^{\paren{s}}}=0
   144	    \mper
   145	\end{align*}
   146	\end{proof}
   147	
   148	
   149	\section{Standard concentration inequalities}
   150	
   151	\begin{fact}[Hoeffding Bound, Theorem 4.14 - \cite{MU18}]
   152	\label{fact:hoeffding_bound}
   153	Let $X_1,\hdots,X_n$ be independent random variables with $\E\Brac{X_i}=\mu_i$ and $\Pr{a_i \leq X_i \leq b_i}=1$ for constants $a_i$ and $b_i$. Then,
   154	\begin{align*}
   155	    \Pr{\abs{\sum_{i=1}^n{X_i} - \sum_{i=1}^n{\mu_i}}\geq \e} \leq 2\exp\paren{\dfrac{-2\e^2}{\sum_{i=1}^n{\paren{b_i-a_i}^2}}}
   156	\end{align*}
   157	\end{fact}
   158	
   159	\begin{fact}[Chernoff bound (Multiplicative); Theorem 4.5 (Part 2) - \cite{MU18}]
   160		\label{fact:chernoff_lower}
   161		Let $X_1, X_2, \hdots, X_n$ be i.i.d. bernoulli variables and $X=\sum_{i=1}^nX_i$ such that $\mu = \E[X]$. Then for any $\delta \in (0, 1)$,
   162		\[
   163		\ProbOp\left[{\sum_{i=1}^{n} X_i} \leq  (1-\delta) \mu \right] \leq \exp\paren{-\dfrac{\mu\delta^2}{2}}\mper
   164		\]
   165	\end{fact}
   166	
   167	\begin{fact}[Chernoff bound (Multiplicative); Theorem 4.4 (Part 2) - \cite{MU18}]
   168		\label{fact:chernoff_upper}
   169		Let $X_1, X_2, \hdots, X_n$ be i.i.d. bernoulli variables and $X=\sum_{i=1}^nX_i$ such that $\mu = \E[X]$. Then for any $\delta \in (0, 1)$,
   170		\[
   171		\ProbOp\left[{\sum_{i=1}^{n} X_i} \geq  (1+\delta) \mu \right] \leq \exp\paren{-\dfrac{\mu\delta^2}{3}}\mper
   172		\]
   173	\end{fact}
