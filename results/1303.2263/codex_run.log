+DIFFICULTY = {
+    "demo": {"n": 4, "layers": 1, "components": 3},
+    "easy": {"n": 16, "layers": 6, "components": 12},
+    "medium": {"n": 17, "layers": 8, "components": 14},
+    "hard": {"n": 18, "layers": 10, "components": 16},
+}
