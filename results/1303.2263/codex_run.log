+    lines.extend(_format_layers("A(x)", inst["left_mixers"], width))
+    lines.extend(["", "Right word map B(y):"])
+    lines.extend(_format_layers("B(y)", inst["right_mixers"], width))
+    lines.extend(
+        [
+            "",
