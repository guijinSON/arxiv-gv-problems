+)
+PLACEBO_HINT = (
+    "Every displayed finite-field coordinate deserves careful attention when checking the requested embedding."
+)
+
+DIFFICULTY = {
+    "demo": {"n": 7, "m": 2, "layers": 1},
+    "easy": {"n": 2027, "m": 8, "layers": 7},
+    "medium": {"n": 4057, "m": 8, "layers": 8},
+    "hard": {"n": 8117, "m": 8, "layers": 8},
+}
