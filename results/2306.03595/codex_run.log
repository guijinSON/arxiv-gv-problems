+        attack_counts["greedy_local_window_64"] += int(_attack_greedy_window(attack_inst))
+        attack_counts["random_restart_256"] += int(_attack_random_restart(attack_inst, seed))
+        attack_counts["in_context_last_layer_inverse"] += int(
