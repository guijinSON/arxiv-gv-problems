+        zp = _add(_apply_matrix(matrix, z, p), delta_shift, p)
+        yp = _add(xp, zp, p)
+        cp = _perm(zp, inst["layers"], p)
+        new_left.append([xp[0], xp[1]])
+        new_colours.append([cp[0], cp[1]])
+        new_answer.append([yp[0], yp[1]])
