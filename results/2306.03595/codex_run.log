+def _edge_holds(
+    left: tuple[int, int],
+    right: tuple[int, int],
+    colour: tuple[int, int],
+    layers: list[list[int]],
+    p: int,
+) -> bool:
+    return _perm(_sub(right, left, p), layers, p) == colour
