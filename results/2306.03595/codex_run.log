+def _apply_matrix(
+    matrix: tuple[tuple[int, int], tuple[int, int]],
+    vector: tuple[int, int],
+    p: int,
+) -> tuple[int, int]:
+    return (
+        (matrix[0][0] * vector[0] + matrix[0][1] * vector[1]) % p,
+        (matrix[1][0] * vector[0] + matrix[1][1] * vector[1]) % p,
+    )
