+        sample_hits += int(verify(inst, random_candidate(inst, sample_rng))[0])
+    sample_elapsed = time.perf_counter() - start
+    report["G4_guess_resistance"] = {
+        "pass": sample_hits / sample_total < 1e-6,
+        "hits": sample_hits,
