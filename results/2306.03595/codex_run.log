+DIFFICULTY = {
+    "demo": {"n": 7, "m": 2, "layers": 1},
+    "easy": {"n": 101, "m": 6, "layers": 3},
+    "medium": {"n": 251, "m": 8, "layers": 4},
+    "hard": {"n": 499, "m": 8, "layers": 5},
+}
