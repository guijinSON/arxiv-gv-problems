+
+def _compact_solve(inst: dict) -> list[list[int]]:
+    p = inst["p"]
+    answer = []
+    for x, c in zip(inst["left_images"], inst["required_colours"]):
+        delta = _inverse_perm(tuple(c), inst["layers"], p)
+        y = _add(tuple(x), delta, p)
+        answer.append([y[0], y[1]])
+    return answer
