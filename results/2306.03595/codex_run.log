+    doubled_inst = make_instance(seed=2718, **doubled)
+    doubled_ok, doubled_why = verify(doubled_inst, doubled_inst["answer"])
+    doubled_elapsed = time.perf_counter() - doubled_start
+    report["G7_scales"] = {
