+        inst["subset_size"],
+        _cross_ratio_profile(inst["A"], inst["M"]),
+    ]
+    encoded = json.dumps(payload, separators=(",", ":")).encode("ascii")
+    return hashlib.sha256(encoded).hexdigest()
 
