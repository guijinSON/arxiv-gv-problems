+
+
+TRACK = "B"
+H = 11
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "polynomial",
+    "native_objects": [
+        "degree-11 finite field over a prime field",
+        "the Bose--Chowla affine line {beta+v : v in F_p}",
+        "a target field element represented in the power basis",
+        "eleven monic linear factor polynomials over F_p",
+    ],
+    "verification_operations": [
+        "exact modular polynomial multiplication",
+        "leading-term cancellation against a monic irreducible degree-11 polynomial",
+        "exact coefficient and normal-form comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Centering the reconstructed degree-11 polynomial exposes reflection "
+        "symmetry among its linear factors; without it one must perform general "
+        "finite-field factorization."
+    ),
+    "hardness_basis": (
+        "Track B: Section 3 reduces recovery to factoring a split degree-11 "
+        "polynomial, and "
+        "Cantor--Zassenhaus does this in expected polynomial time in log(p); "
+        "the bundled reference implementation's measured shipping cost is "
+        "reported by selftest, while the centered-polynomial route uses 47 "
