+# only the exact answer/operation caps are gated by the current submitter.
+G9_EVIDENCE = {
+    "bare": {"solved": None, "attempts": 0, "service_errors": 4},
+    "hinted": {"solved": None, "attempts": 0, "service_errors": 4},
