+        # but keeps the reference algorithm total on every promised input.
+        for x in range(prime):
+            value = 0
+            for coefficient in reversed(part):
+                value = (value * x + coefficient) % prime
+                operations[0] += 2
+            if value == 0:
+                factor = [(-x) % prime, 1]
+                quotient, remainder = _divmod_poly(
+                    part, factor, prime, operations
+                )
+                if remainder == [0]:
+                    split(factor)
+                    split(quotient)
+                    return
