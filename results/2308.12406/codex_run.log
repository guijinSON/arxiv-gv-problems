+    s = 0
+    while q % 2 == 0:
+        q //= 2
+        s += 1
+    z = 2
+    while pow(z, (prime - 1) // 2, prime) != prime - 1:
+        z += 1
+    m = s
+    c = pow(z, q, prime)
+    t = pow(value, q, prime)
+    r = pow(value, (q + 1) // 2, prime)
