+def _trim(poly: list[int], prime: int) -> list[int]:
+    out = [value % prime for value in poly]
+    while len(out) > 1 and out[-1] == 0:
+        out.pop()
+    return out
+
+
+def _mul(a: list[int], b: list[int], prime: int) -> list[int]:
+    out = [0] * (len(a) + len(b) - 1)
+    for i, av in enumerate(a):
+        for j, bv in enumerate(b):
+            out[i + j] = (out[i + j] + av * bv) % prime
+    return _trim(out, prime)
+
+
+def _divmod_poly(a: list[int], b: list[int], prime: int,
+                 operations: list[int] | None = None):
+    dividend = _trim(a, prime)
+    divisor = _trim(b, prime)
+    if divisor == [0]:
+        raise ZeroDivisionError("polynomial division by zero")
+    if len(dividend) < len(divisor):
+        return [0], dividend
+    quotient = [0] * (len(dividend) - len(divisor) + 1)
+    inverse = pow(divisor[-1], -1, prime)
+    if operations is not None:
+        operations[0] += 2 * prime.bit_length()
+    while dividend != [0] and len(dividend) >= len(divisor):
+        shift = len(dividend) - len(divisor)
+        factor = dividend[-1] * inverse % prime
+        quotient[shift] = factor
+        if operations is not None:
+            operations[0] += 1
+        for j, coefficient in enumerate(divisor):
+            dividend[shift + j] = (
+                dividend[shift + j] - factor * coefficient
+            ) % prime
+            if operations is not None:
+                operations[0] += 2
+        dividend = _trim(dividend, prime)
+    return _trim(quotient, prime), dividend
