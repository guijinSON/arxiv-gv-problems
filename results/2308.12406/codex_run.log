+def _mod_sqrt(value: int, prime: int) -> int:
+    value %= prime
+    if value == 0:
+        return 0
+    if pow(value, (prime - 1) // 2, prime) != 1:
+        raise ValueError("not a square")
+    if prime % 4 == 3:
+        return pow(value, (prime + 1) // 4, prime)
+    q = prime - 1
+    s = 0
+    while q % 2 == 0:
+        q //= 2
+        s += 1
+    z = 2
+    while pow(z, (prime - 1) // 2, prime) != prime - 1:
+        z += 1
+    m = s
+    c = pow(z, q, prime)
+    t = pow(value, q, prime)
+    r = pow(value, (q + 1) // 2, prime)
+    while t != 1:
+        i = 1
+        tt = t * t % prime
+        while tt != 1:
+            tt = tt * tt % prime
+            i += 1
+        b = pow(c, 1 << (m - i - 1), prime)
+        r = r * b % prime
+        t = t * b * b % prime
+        c = b * b % prime
+        m = i
+    return r
