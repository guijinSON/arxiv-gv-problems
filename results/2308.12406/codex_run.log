+    result = [1]
+    power = _mod_poly(base, modulus, prime, operations)
+    while exponent:
+        if exponent & 1:
+            result = _mul_mod(result, power, modulus, prime, operations)
+        exponent >>= 1
+        if exponent:
+            power = _mul_mod(power, power, modulus, prime, operations)
+    return result
+
+
+def _gcd_poly(a: list[int], b: list[int], prime: int,
+              operations: list[int]) -> list[int]:
+    left, right = _trim(a, prime), _trim(b, prime)
+    while right != [0]:
+        left, right = right, _divmod_poly(left, right, prime, operations)[1]
+    inverse = pow(left[-1], -1, prime)
+    operations[0] += 2 * prime.bit_length()
+    return _trim([(value * inverse) % prime for value in left], prime)
+
+
+def _sub_constant(poly: list[int], value: int, prime: int) -> list[int]:
+    out = list(poly)
+    out[0] = (out[0] - value) % prime
+    return _trim(out, prime)
+
+
+def _factor_split_polynomial(poly: list[int], prime: int):
+    """General Cantor--Zassenhaus factorization; no planted structure used."""
+    operations = [0]
+    restarts = [0]
+    digest = hashlib.sha256(json.dumps([prime, poly]).encode()).digest()
+    rng = random.Random(int.from_bytes(digest[:8], "big"))
+    roots: list[int] = []
+
+    def split(part: list[int]) -> None:
+        part = _trim(part, prime)
+        degree = len(part) - 1
+        if degree == 0:
+            return
+        if degree == 1:
+            inverse = pow(part[1], -1, prime)
+            operations[0] += 2 * prime.bit_length() + 1
+            roots.append((-part[0] * inverse) % prime)
+            return
+        for _ in range(64):
+            restarts[0] += 1
+            shift = rng.randrange(prime)
+            linear = [shift, 1]
+            direct = _gcd_poly(part, linear, prime, operations)
+            if 0 < len(direct) - 1 < degree:
+                quotient, remainder = _divmod_poly(
+                    part, direct, prime, operations
+                )
+                if remainder != [0]:
+                    raise RuntimeError("nonexact factor division")
+                split(direct)
+                split(quotient)
+                return
+            powered = _pow_mod(
+                linear, (prime - 1) // 2, part, prime, operations
+            )
+            for sign in (1, -1):
+                candidate = _gcd_poly(
+                    part, _sub_constant(powered, sign, prime),
+                    prime, operations
+                )
+                candidate_degree = len(candidate) - 1
+                if 0 < candidate_degree < degree:
+                    quotient, remainder = _divmod_poly(
+                        part, candidate, prime, operations
+                    )
+                    if remainder != [0]:
+                        raise RuntimeError("nonexact factor division")
+                    split(candidate)
+                    split(quotient)
+                    return
+        # Defensive fallback.  It is not reached on the generated instances,
+        # but keeps the reference algorithm total on every promised input.
+        for x in range(prime):
+            value = 0
+            for coefficient in reversed(part):
+                value = (value * x + coefficient) % prime
+                operations[0] += 2
+            if value == 0:
+                factor = [(-x) % prime, 1]
+                quotient, remainder = _divmod_poly(
+                    part, factor, prime, operations
+                )
+                if remainder == [0]:
+                    split(factor)
+                    split(quotient)
+                    return
+        raise RuntimeError("promised split polynomial did not split")
+
+    split(poly)
+    constants = sorted((-root) % prime for root in roots)
+    return [[value, 1] for value in constants], operations[0], restarts[0]
+
+
+def _mod_sqrt(value: int, prime: int) -> int:
+    value %= prime
+    if value == 0:
+        return 0
+    if pow(value, (prime - 1) // 2, prime) != 1:
+        raise ValueError("not a square")
+    if prime % 4 == 3:
+        return pow(value, (prime + 1) // 4, prime)
+    q = prime - 1
+    s = 0
+    while q % 2 == 0:
+        q //= 2
+        s += 1
+    z = 2
+    while pow(z, (prime - 1) // 2, prime) != prime - 1:
+        z += 1
+    m = s
+    c = pow(z, q, prime)
+    t = pow(value, q, prime)
+    r = pow(value, (q + 1) // 2, prime)
+    while t != 1:
+        i = 1
+        tt = t * t % prime
+        while tt != 1:
+            tt = tt * tt % prime
+            i += 1
+        b = pow(c, 1 << (m - i - 1), prime)
+        r = r * b % prime
+        t = t * b * b % prime
+        c = b * b % prime
+        m = i
+    return r
+
+
+def _affine_poly(poly: list[int], scale: int, shift: int,
+                 prime: int) -> list[int]:
+    """Return scale^d f((x-shift)/scale), preserving monicity."""
+    degree = len(poly) - 1
+    out = [0] * (degree + 1)
+    for i, coefficient in enumerate(poly):
+        multiplier = coefficient * pow(scale, degree - i, prime)
+        for j in range(i + 1):
+            term = (multiplier * math.comb(i, j)
+                    * pow(-shift, i - j, prime))
+            out[j] = (out[j] + term) % prime
+    return _trim(out, prime)
+
+
+# ---------------------------------------------------------------------------
+# Required public interface
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate a unique Bose--Chowla 11-fold product."""
+    prime_span = params.pop("prime_span", max(0, n // 2))
+    max_step = params.pop("max_step", max(2, math.isqrt(max(7, n)) // 2))
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    values = {"n": n, "seed": seed, "prime_span": prime_span,
+              "max_step": max_step}
+    for name, value in values.items():
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise ValueError(f"{name} must be an integer")
+    if n < 23:
+        raise ValueError("n must be at least 23")
+    if prime_span < 0:
+        raise ValueError("prime_span must be nonnegative")
+    if max_step < 2:
+        raise ValueError("max_step must be at least 2")
+
+    prime = _select_prime(n, seed, prime_span)
+    primitive = _primitive_root(prime)
+    # x^H-primitive is irreducible: H is prime, p=1 mod H, and a primitive
+    # element is not an H-th power.  Thus beta has degree exactly H.
+    modulus = [(-primitive) % prime] + [0] * (H - 1) + [1]
+    rng = random.Random(seed)
+    center = rng.randrange(prime)
+    step_limit = min(max_step, math.isqrt(prime - 1))
+    if step_limit < 2:
+        raise ValueError("parameters leave no nontrivial reflected progression")
+    step = rng.randint(2, step_limit)
+
+    # Compose P(x)=product_{r=-5}^5 (x+c+d*r) directly from sampled
+    # factors rather than factoring the public polynomial.
+    offsets = range(-(H // 2), H // 2 + 1)
+    constants = sorted((center + step * offset) % prime for offset in offsets)
+    product = [1]
+    for value in constants:
+        product = _mul(product, [value, 1], prime)
+    target = [
+        (product[i] - modulus[i]) % prime for i in range(H)
+    ]
+    answer = [[value, 1] for value in constants]
+    return {
+        "p": prime,
+        "h": H,
+        "modulus": modulus,
+        "target": target,
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    p = inst["p"]
+    h = inst["h"]
+    modulus = inst["modulus"]
+    target = inst["target"]
+    example = "[" + ",".join("[0,1]" for _ in range(h)) + "]"
+    statement = f"""Bose--Chowla {h}-fold product decoding over a finite field
+
+Let F_p be the integers modulo the prime p={p}.  Work in the degree-{h} field
+K=F_p[z]/(m(z)).  Coefficient lists below are in ascending degree order:
+
+    m coefficients = {json.dumps(modulus, separators=(",", ":"))}
+
+Thus polynomial coefficients are reduced modulo p and z^{h} is replaced using
+m(z)=0.  Every element of K has a unique length-{h} coefficient list.
+
+Consider the p field elements S={{z+v : v in F_p}}.  The displayed modulus is
+irreducible, so z has algebraic degree {h}.  Consequently, two products of {h}
+members of S are equal only when their {h} v-values agree as multisets:
+subtracting the two monic degree-{h} polynomials cancels the leading term, and
+a nonzero polynomial of degree below {h} cannot vanish at z.
+
+The target element T has ascending power-basis coefficients
+
+    T coefficients = {json.dumps(target, separators=(",", ":"))}
+
+and it is promised that T is the product of exactly {h} members of S.  Find
+that multiset.  Repetitions are allowed.  Encode each monic
+linear factor z+v by the ascending coefficient list [v,1], using the canonical
+integer 0<=v<p.  Return exactly {h} such lists, sorted by nondecreasing v.
+
+Give your final answer inside <answer></answer> tags, as a JSON array of exactly
+{h} [v,1] lists.  Format example: <answer>{example}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body)
+    try:
+        answer = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return answer
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    h = inst["h"]
+    if len(answer) != h:
+        return False, f"need exactly {h} factors, got {len(answer)}"
+    p = inst["p"]
+    constants = []
+    for index, factor in enumerate(answer):
+        if not isinstance(factor, list) or len(factor) != 2:
+            return False, f"factor {index} must be a two-coefficient list"
+        if any(isinstance(value, bool) or not isinstance(value, int)
+               for value in factor):
+            return False, f"factor {index} coefficients must be integers"
+        if factor[1] != 1:
+            return False, f"factor {index} is not monic linear"
+        if not 0 <= factor[0] < p:
+            return False, f"factor {index} constant is outside [0,p)"
+        constants.append(factor[0])
+    if constants != sorted(constants):
+        return False, "factors must be sorted by constant coefficient"
+
+    product = [1]
+    for factor in answer:
+        product = _mul(product, factor, p)
+    # Both product and m are monic of degree h, so product mod m equals target
+    # exactly when product=m+target coefficient by coefficient.
+    if product != _problem_poly(inst):
+        return False, "factor product does not equal the target in K"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample the stated space of h unordered factors."""
+    p = inst["p"]
+    h = inst["h"]
+    bars = sorted(rng.sample(range(p + h - 1), h))
+    constants = [bars[i] - i for i in range(h)]
+    return [[value, 1] for value in constants]
+
+
+def search_space(inst) -> int | None:
+    return math.comb(inst["p"] + inst["h"] - 1, inst["h"])
+
+
+def enumerate_all(inst) -> int | None:
+    space = search_space(inst)
+    if space is None or space > 100_000:
+        return None
+    count = 0
+    for constants in itertools.combinations_with_replacement(
+            range(inst["p"]), inst["h"]):
+        answer = [[value, 1] for value in constants]
+        if verify(inst, answer)[0]:
+            count += 1
+    return count
+
+
+def _problem_poly(inst) -> list[int]:
+    p = inst["p"]
+    return [
+        (inst["target"][i] + inst["modulus"][i]) % p
+        for i in range(inst["h"])
+    ] + [1]
+
+
+def _normalized_modulus(inst, step: int) -> tuple[int, ...]:
+    """Normalize the centered arithmetic progression to fixed unit spacing."""
+    p = inst["p"]
+    h = inst["h"]
+    product = _problem_poly(inst)
+    center = product[h - 1] * pow(h, -1, p) % p
+    raw = [0] * (h + 1)
+    # step^-h m(step*y-center)
+    inverse_power = pow(pow(step, h, p), -1, p)
+    for i, coefficient in enumerate(inst["modulus"]):
+        for j in range(i + 1):
+            term = (coefficient * math.comb(i, j) * pow(step, j, p)
+                    * pow(-center, i - j, p))
+            raw[j] = (raw[j] + term) % p
+    return tuple(value * inverse_power % p for value in raw)
+
+
+def canonical_key(inst) -> str:
+    """Affine-coordinate invariant of the pair (modulus, target polynomial)."""
+    p = inst["p"]
+    h = inst["h"]
+    product = _problem_poly(inst)
+    center = product[h - 1] * pow(h, -1, p) % p
+    e2 = -(sum(offset * offset for offset in range(-(h // 2), h // 2 + 1)) // 2)
+    step_square = ((product[h - 2] - math.comb(h, 2) * center * center)
+                   * pow(e2, -1, p)) % p
+    step = _mod_sqrt(step_square, p)
+    first = _normalized_modulus(inst, step)
+    second = _normalized_modulus(inst, (-step) % p)
+    normalized = min(first, second)
+    return json.dumps([p, list(normalized)], separators=(",", ":"))
+
+
+def escalate(params) -> dict | str | None:
+    out = dict(params)
+    out.pop("_preset", None)
+    n = int(out.get("n", 1009))
+    span = int(out.get("prime_span", max(1, n // 2)))
+    step = int(out.get("max_step", max(2, math.isqrt(n) // 2)))
+    out["n"] = n * 2 + 1
+    out["prime_span"] = max(span * 2, n)
+    out["max_step"] = min(max(2, step * 2), math.isqrt(out["n"]))
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Relabellings, attacks, and mandatory gates
+
+
+def _affine_relabel(inst, scale: int, shift: int):
+    """Represent beta'=scale*beta+shift and scale all h factors."""
+    p = inst["p"]
+    h = inst["h"]
+    scale %= p
+    shift %= p
+    if scale == 0:
+        raise ValueError("scale must be nonzero")
+    modulus = _affine_poly(inst["modulus"], scale, shift, p)
+    product = _affine_poly(_problem_poly(inst), scale, shift, p)
+    target = [(product[i] - modulus[i]) % p for i in range(h)]
+    carried = sorted(
+        (((scale * factor[0] - shift) % p), 1)
+        for factor in inst["answer"]
+    )
+    return {"p": p, "h": h, "modulus": modulus, "target": target,
+            "answer": [list(factor) for factor in carried]}
+
+
+def _attack_outlier(inst):
+    p = inst["p"]
+    h = inst["h"]
+    raw = inst["target"] + inst["modulus"][:h]
+    constants = sorted({value % p for value in raw})[:h]
+    if len(constants) < h:
+        return None
+    return [[value, 1] for value in constants]
+
+
+def _attack_greedy_first(inst):
+    return [[value, 1] for value in range(inst["h"])]
+
+
+def _attack_adjacent_center(inst):
+    p = inst["p"]
+    h = inst["h"]
+    center = _problem_poly(inst)[h - 1] * pow(h, -1, p) % p
+    constants = sorted(
+        (center + offset) % p
+        for offset in range(-(h // 2), h // 2 + 1)
+    )
+    return [[value, 1] for value in constants]
+
+
+def _compact_factor(inst):
+    """The intended reflected-factor route, included only for gate checking."""
+    p = inst["p"]
+    h = inst["h"]
+    product = _problem_poly(inst)
+    center = product[h - 1] * pow(h, -1, p) % p
+    e2 = -(sum(offset * offset for offset in range(-(h // 2), h // 2 + 1)) // 2)
+    step_square = ((product[h - 2] - math.comb(h, 2) * center * center)
+                   * pow(e2, -1, p)) % p
+    step = math.isqrt(step_square)
+    if step * step != step_square:
+        return None
+    constants = sorted(
+        (center + step * offset) % p
+        for offset in range(-(h // 2), h // 2 + 1)
+    )
+    return [[value, 1] for value in constants]
+
+
+def _run_reference(inst):
+    start = time.perf_counter()
+    answer, operations, restarts = _factor_split_polynomial(
+        _problem_poly(inst), inst["p"]
+    )
+    elapsed = time.perf_counter() - start
+    return answer, operations, restarts, elapsed
+
+
+def _atom_count(value) -> int:
+    if isinstance(value, dict):
+        return sum(_atom_count(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_atom_count(item) for item in value)
+    return 1
+
+
+def selftest() -> dict:
+    report: dict = {}
+
+    checked = 0
+    json_native = True
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            if not ok:
+                raise AssertionError(f"G1 {preset}/{seed}: {reason}")
+            checked += 1
+            json_native &= json.loads(json.dumps(inst["answer"])) == inst["answer"]
+    report["G1_planted_verifies"] = {
+        "pass": checked == 12 and json_native,
+        "instances_checked": checked,
+        "json_native": json_native,
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    good = demo["answer"]
+    corruptions = {
+        "drop": good[:-1],
+        "swap": [good[1], good[0]] + good[2:],
+        "duplicate": [good[0], good[0]] + good[2:],
+        "empty": [],
+        "out_of_range": [[demo["p"], 1]] + good[1:],
+    }
+    rejection_reasons = {}
+    for name, answer in corruptions.items():
+        ok, reason = verify(demo, answer)
+        if ok:
+            raise AssertionError(f"G2 accepted {name}")
+        rejection_reasons[name] = reason
+    report["G2_rejects_corruption"] = {
+        "pass": len(set(rejection_reasons.values())) == len(rejection_reasons),
+        "reasons": rejection_reasons,
+    }
+
+    wire = json.dumps(good, separators=(",", ":"))
+    realistic = (
+        "I reconstructed the degree-11 polynomial and checked its factors.\n\n"
+        "```json\n<answer>" + wire + "</answer>\n```\n"
+        "The coefficients are canonical residues."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == good,
+        "model_style_response_parsed": parsed == good,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=20260905, **shipping_params)
+    samples = 200_000
+    rng = random.Random(0xB053)
+    hits = 0
+    for _ in range(samples):
+        hits += int(verify(shipping, random_candidate(shipping, rng))[0])
+    guess_probability = hits / samples
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": guess_probability,
+        "structure_aware_space": search_space(shipping),
+    }
+
+    exact_demo_count = enumerate_all(demo)
+    reference_rows = []
+    reference_successes = 0
+    attack_counts = {
+        "raw_coefficient_outlier": 0,
+        "greedy_first_eleven_residues": 0,
+        "random_restart_256": 0,
+        "by_hand_adjacent_center_ansatz": 0,
+    }
+    attempts = 8
+    for seed in range(800, 800 + attempts):
+        inst = make_instance(seed=seed, **shipping_params)
+        for name, candidate in (
+            ("raw_coefficient_outlier", _attack_outlier(inst)),
+            ("greedy_first_eleven_residues", _attack_greedy_first(inst)),
+            ("by_hand_adjacent_center_ansatz", _attack_adjacent_center(inst)),
+        ):
+            if candidate is not None and verify(inst, candidate)[0]:
+                attack_counts[name] += 1
+        attack_rng = random.Random(seed ^ 0xBAD5EED)
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, attack_rng))[0]:
+                attack_counts["random_restart_256"] += 1
+                break
+        answer, operations, restarts, elapsed = _run_reference(inst)
+        solved = verify(inst, answer)[0]
+        reference_successes += int(solved)
+        reference_rows.append((operations, restarts, elapsed))
+
+    operation_values = [row[0] for row in reference_rows]
+    restart_values = [row[1] for row in reference_rows]
+    elapsed_values = [row[2] for row in reference_rows]
+    mean_operations = sum(operation_values) / attempts
+    mean_elapsed = sum(elapsed_values) / attempts
+    report["G5_density_and_baseline_cost"] = {
+        "pass": (guess_probability < 1e-6
+                 and reference_successes == attempts),
+        "shipping_density_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_density_estimate": guess_probability,
+        "demo_valid_answer_count_exact": exact_demo_count,
+        "baseline_wall_seconds_mean": mean_elapsed,
+        "baseline_wall_seconds_max": max(elapsed_values),
+        "baseline_operation_count_mean": mean_operations,
+        "baseline_operation_count_max": max(operation_values),
+        "baseline_restarts_mean": sum(restart_values) / attempts,
+    }
+
+    attacks = {
+        name: {"successes": successes, "attempts": attempts}
+        for name, successes in attack_counts.items()
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(row["successes"] == 0 for row in attacks.values()),
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "Cantor--Zassenhaus equal-degree factorization",
+            "complexity": "expected polynomial time in degree and log(p)",
+            "wall_clock_sec_mean": mean_elapsed,
+            "wall_clock_sec_max": max(elapsed_values),
+            "operations_mean": mean_operations,
+            "operations_max": max(operation_values),
+            "restarts_mean": sum(restart_values) / attempts,
+            "solves": f"{reference_successes}/{attempts}, as expected",
+        },
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] *= 2
+    doubled_params["prime_span"] *= 2
+    doubled_params["max_step"] *= 2
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": doubled_ok and search_space(doubled) > search_space(shipping),
+        "shipping_prime": shipping["p"],
+        "doubled_prime": doubled["p"],
+        "shipping_search_space": search_space(shipping),
+        "doubled_search_space": search_space(doubled),
+        "doubled_planted_verifies": doubled_ok,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    keys = []
+    for seed in range(1200, 1220):
+        inst = make_instance(seed=seed, **shipping_params)
+        p = inst["p"]
+        first = _affine_relabel(inst, 2 % p, (seed * 7) % p)
