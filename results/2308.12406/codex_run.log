+def _affine_relabel(
+    inst: dict, unit: int, shift: int, reverse_inputs: bool = False
+) -> tuple[dict, list[int]]:
+    """Apply the same affine coordinate relabelling and carry the witness."""
+
+    modulus = inst["M"]
