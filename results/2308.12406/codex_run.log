    operation_values = [row[0] for row in reference_rows]
    restart_values = [row[1] for row in reference_rows]
    elapsed_values = [row[2] for row in reference_rows]
    mean_operations = sum(operation_values) / attempts
    mean_elapsed = sum(elapsed_values) / attempts
    report["G5_density_and_baseline_cost"] = {
        "pass": (guess_probability < 1e-6 and exact_demo_count == 1
                 and reference_successes == attempts),
        "shipping_density_hits": hits,
        "shipping_density_samples": samples,
        "shipping_density_estimate": guess_probability,
        "demo_valid_answer_count_exact": exact_demo_count,
        "baseline_wall_seconds_mean": mean_elapsed,
        "baseline_wall_seconds_max": max(elapsed_values),
        "baseline_operation_count_mean": mean_operations,
        "baseline_operation_count_max": max(operation_values),
        "baseline_restarts_mean": sum(restart_values) / attempts,
    }

    attacks = {
        name: {"successes": successes, "attempts": attempts}
        for name, successes in attack_counts.items()
    }
    report["G6_adversary_panel"] = {
        "pass": all(row["successes"] == 0 for row in attacks.values()),
        "attacks": attacks,
        "reference_algorithm": {
            "name": "Cantor--Zassenhaus equal-degree factorization",
            "complexity": "expected polynomial time in degree and log(p)",
            "wall_clock_sec_mean": mean_elapsed,
            "wall_clock_sec_max": max(elapsed_values),
            "operations_mean": mean_operations,
            "operations_max": max(operation_values),
            "restarts_mean": sum(restart_values) / attempts,
            "solves": f"{reference_successes}/{attempts}, as expected",
        },
    }

    doubled_params = dict(shipping_params)
    doubled_params["n"] *= 2
    doubled_params["prime_span"] *= 2
    doubled_params["max_step"] *= 2
    doubled = make_instance(seed=77, **doubled_params)
    doubled_ok = verify(doubled, doubled["answer"])[0]
    report["G7_scales"] = {
        "pass": doubled_ok and search_space(doubled) > search_space(shipping),
        "shipping_prime": shipping["p"],
        "doubled_prime": doubled["p"],
        "shipping_search_space": search_space(shipping),
        "doubled_search_space": search_space(doubled),
        "doubled_planted_verifies": doubled_ok,
    }

    invariance_checks = 0
    carried_checks = 0
    keys = []
    for seed in range(1200, 1220):
        inst = make_instance(seed=seed, **shipping_params)
        p = inst["p"]
        first = _affine_relabel(inst, 2 % p, (seed * 7) % p)
        second = _affine_relabel(first, 3 % p, (seed * 11 + 1) % p)
        base_key = canonical_key(inst)
        for transformed in (first, second):
            invariance_checks += 1
            if canonical_key(transformed) != base_key:
                raise AssertionError("G8 affine invariance failed")
            carried_checks += 1
            if not verify(transformed, transformed["answer"])[0]:
                raise AssertionError("G8 carried answer failed")
        keys.append(base_key)
    distinct = len(set(keys))
    report["G8_canonical_key"] = {
        "pass": invariance_checks == 40 and carried_checks == 40 and distinct == 20,
        "invariance_checks": invariance_checks,
        "real_transformation_checks": carried_checks,
        "unrelated_instances": 20,
        "distinct_keys": distinct,
        "symmetries_tested": "affine beta-coordinate changes and compositions",
    }

    sizes = []
    compact_checks = 0
    for seed in range(20):
        sized_inst = make_instance(seed=seed, **shipping_params)
        answer = sized_inst["answer"]
        blob = json.dumps(answer, separators=(",", ":"))
        sizes.append((len(blob), _atom_count(answer)))
        compact = _compact_factor(sized_inst)
        compact_checks += int(compact is not None
                              and verify(sized_inst, compact)[0])
    answer_chars = max(row[0] for row in sizes)
    answer_elements = max(row[1] for row in sizes)
    answer_tokens = math.ceil(answer_chars / 4)
    bare = G9_EVIDENCE["bare"]
    hinted = G9_EVIDENCE["hinted"]
    placebo = G9_EVIDENCE["placebo"]
    hinted_rate = (hinted["solved"] / hinted["attempts"]
                   if hinted["attempts"] else 0.0)
    placebo_rate = (placebo["solved"] / placebo["attempts"]
                    if placebo["attempts"] else 0.0)
    within_caps = answer_chars <= 2000 and answer_elements <= 256 and 14 <= 300
    report["G9_no_tool_suitability"] = {
        "pass": within_caps,
        "arms": {"bare": bare, "hinted": hinted, "placebo": placebo},
        "hinted_minus_placebo": hinted_rate - placebo_rate,
        "hinted_verdict": G9_EVIDENCE["hinted_verdict"],
        "answer_chars": answer_chars,
        "answer_tokens": answer_tokens,
        "answer_elements": answer_elements,
        "intended_route_operations": 14,
        "compact_route_checks": compact_checks,
        "caps": {"chars": 2000, "elements": 256, "operations": 300},
    }

    report["all_passed"] = all(
        value.get("pass", False) for key, value in report.items()
        if key.startswith("G")
    )
    return report


if __name__ == "__main__":
    print(json.dumps(selftest(), indent=2, sort_keys=True))

