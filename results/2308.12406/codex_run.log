+        "A sorted JSON array of exactly three monic linear polynomials over "
+        "F_p.  A factor z+v is encoded by its ascending coefficient list "
+        "[v,1], with 0<=v<p.  Repeated factors are allowed."
+    ),
+    "bounds": {
+        "number_of_factors": 3,
+        "degree_of_each_factor": 1,
+        "constant_coefficient_range": "0 through p-1",
+        "leading_coefficient": 1,
+        "ordering": "nondecreasing constant coefficient",
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 7, "prime_span": 0, "max_step": 2},
+    "easy": {"n": 1009, "prime_span": 5000, "max_step": 20},
+    "medium": {"n": 100003, "prime_span": 500000, "max_step": 200},
+    "hard": {"n": 1000003, "prime_span": 5000000, "max_step": 1000},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
