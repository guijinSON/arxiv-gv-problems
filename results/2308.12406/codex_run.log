+    prime = _select_prime(n, seed, prime_span)
+    primitive = _primitive_root(prime)
+    # x^3-primitive is irreducible because p=1 mod 3 and a primitive element
+    # is not a cube.  Thus beta has degree exactly three.
+    modulus = [(-primitive) % prime, 0, 0, 1]
+    rng = random.Random(seed)
+    center = rng.randrange(prime)
+    step_limit = min(max_step, math.isqrt(prime - 1))
+    if step_limit < 2:
+        raise ValueError("parameters leave no nontrivial reflected triple")
+    step = rng.randint(2, step_limit)
+
+    # P(x)=(x+c)^3-d^2(x+c)=product(x+v).  Compose the target
+    # directly rather than factoring a public polynomial.
+    c, d2 = center, step * step
+    product = [
+        (c * c * c - c * d2) % prime,
+        (3 * c * c - d2) % prime,
+        (3 * c) % prime,
+        1,
+    ]
+    target = [
+        (product[i] - modulus[i]) % prime for i in range(3)
+    ]
+    constants = sorted(((c - step) % prime, c, (c + step) % prime))
+    answer = [[value, 1] for value in constants]
+    return {
+        "p": prime,
+        "modulus": modulus,
+        "target": target,
+        "answer": answer,
+    }
