+except ImportError:                 # pragma: no cover - supported fallback
+    exact_matrices = rationals = None
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "polynomial_identity",
+    "certificate_form": "polynomial",
+    "native_objects": [
+        "cubic finite field over a prime field",
+        "the Bose--Chowla affine line {beta+v : v in F_p}",
+        "a target field element represented in the power basis",
+        "three monic linear factor polynomials over F_p",
+    ],
+    "verification_operations": [
+        "exact modular polynomial multiplication",
+        "leading-term cancellation against a monic irreducible cubic",
+        "exact coefficient and normal-form comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Centering the reconstructed monic cubic exposes reflection symmetry "
+        "among its three linear factors; without it one must factor a cubic "
+        "over a large prime field."
+    ),
+    "hardness_basis": (
+        "Track B: Section 3 reduces recovery to factoring a split cubic, and "
+        "Cantor--Zassenhaus does this in expected polynomial time in log(p); "
+        "at the initial shipping preset the bundled implementation uses 2,619 "
+        "exact base-field operations on average (3,878 maximum over 8 instances) "
+        "in 0.0041 seconds mean wall time, while the centered-cubic route uses "
+        "14 exact operations after the symmetry is noticed."
+    ),
+    "max_answer_tokens": 7,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
