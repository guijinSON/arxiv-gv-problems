+    carried = [inverse, (-inverse * s) % modulus]
+    changed = dict(inst)
+    changed["A"] = list(reversed(inst["B"]))
+    changed["B"] = list(reversed(inst["A"]))
+    changed["answer"] = carried
+    return changed, carried
+
+
