import math, random, time

def factors(n):
 out=[]; d=2
 while d*d<=n:
  if n%d==0:
   out.append(d)
   while n%d==0:n//=d
  d += 1 if d==2 else 2
 if n>1:out.append(n)
 return out

def mul(u,v,q,c):
 w=[0]*5
 for i,x in enumerate(u):
  for j,y in enumerate(v): w[i+j]=(w[i+j]+x*y)%q
 for deg in (4,3):
  z=w[deg]%q
  for j in range(3): w[deg-3+j]=(w[deg-3+j]-z*c[j])%q
 return tuple(w[:3])
def pw(u,e,q,c):
 r=(1,0,0)
 while e:
  if e&1:r=mul(r,u,q,c)
  u=mul(u,u,q,c);e//=2
 return r

def primitive(q):
 M=q**3-1; fs=factors(M); x=(0,1,0); one=(1,0,0)
 rr=random.Random(q);t=time.perf_counter();tests=0;irr=0
 while 1:
  c=(rr.randrange(1,q),rr.randrange(q),rr.randrange(q));tests+=1
  if any((a*a*a+c[2]*a*a+c[1]*a+c[0])%q==0 for a in range(q)): continue
  irr+=1
  if all(pw(x,M//r,q,c)"'!=one for r in fs):
   print('"'q',q,'poly',c,'tests',tests,'irr',irr,'time',time.perf_counter()-t,'factors',fs,flush=True)
   return c

def bose(q,c):
 M=q**3-1; x=(0,1,0); cur=(1,0,0); out=[]
 for a in range(M):
  if cur[1]==1 and cur[2]==0:out.append(a)
  cur=mul(cur,x,q,c)
 assert cur==(1,0,0) and len(out)==q,(cur,len(out))
 return out

def moments(A,M):
 k=len(A); mu=sum(A)*pow(k,-1,M)%M
 cs=[]
 for r in range(2,4):cs.append(sum(pow((a-mu)%M,r,M) for a in A)%M)
 return mu,cs
for q,k in [(5,3),(11,9),(23,17),(47,25),(97,25)]:
 c=primitive(q);t=time.perf_counter();S=bose(q,c);print('bose time',time.perf_counter()-t,'first',S[:5],flush=True)
 rng=random.Random(0); attempts=0
 while 1:
  attempts+=1; A=sorted(rng.sample(S,k));mu,cs=moments(A,q**3-1)
  if math.gcd(cs[0],q**3-1)==1 and math.gcd(cs[1],q**3-1)==1:break
