+            ("raw_coefficient_outlier", _attack_outlier(inst)),
+            ("greedy_first_eleven_residues", _attack_greedy_first(inst)),
+            ("by_hand_adjacent_center_ansatz", _attack_adjacent_center(inst)),
+        ):
+            if candidate is not None and verify(inst, candidate)[0]:
+                attack_counts[name] += 1
+        attack_rng = random.Random(seed ^ 0xBAD5EED)
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, attack_rng))[0]:
+                attack_counts["random_restart_256"] += 1
+                break
+        answer, operations, restarts, elapsed = _run_reference(inst)
+        solved = verify(inst, answer)[0]
+        reference_successes += int(solved)
+        reference_rows.append((operations, restarts, elapsed))
+
+    operation_values = [row[0] for row in reference_rows]
+    restart_values = [row[1] for row in reference_rows]
+    elapsed_values = [row[2] for row in reference_rows]
+    mean_operations = sum(operation_values) / attempts
+    mean_elapsed = sum(elapsed_values) / attempts
+    report["G5_density_and_baseline_cost"] = {
+        "pass": (guess_probability < 1e-6
+                 and reference_successes == attempts),
+        "shipping_density_hits": hits,
+        "shipping_density_samples": samples,
