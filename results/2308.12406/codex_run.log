+# ---------------------------------------------------------------------------
+# Required public interface
+
+
+def make_instance(n, seed=0, **params) -> dict:
+    """Inverse-generate a unique Bose--Chowla triple product."""
+    prime_span = params.pop("prime_span", max(0, n // 2))
+    max_step = params.pop("max_step", max(2, math.isqrt(max(7, n)) // 2))
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    values = {"n": n, "seed": seed, "prime_span": prime_span,
+              "max_step": max_step}
+    for name, value in values.items():
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise ValueError(f"{name} must be an integer")
+    if n < 7:
+        raise ValueError("n must be at least 7")
+    if prime_span < 0:
+        raise ValueError("prime_span must be nonnegative")
+    if max_step < 2:
+        raise ValueError("max_step must be at least 2")
