+    # factors rather than factoring the public polynomial.
+    offsets = range(-(H // 2), H // 2 + 1)
+    constants = sorted((center + step * offset) % prime for offset in offsets)
+    product = [1]
+    for value in constants:
+        product = _mul(product, [value, 1], prime)
+    target = [
+        (product[i] - modulus[i]) % prime for i in range(H)
+    ]
+    answer = [[value, 1] for value in constants]
+    return {
+        "p": prime,
+        "h": H,
+        "modulus": modulus,
+        "target": target,
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    p = inst["p"]
+    h = inst["h"]
+    modulus = inst["modulus"]
+    target = inst["target"]
+    example = "[" + ",".join("[0,1]" for _ in range(h)) + "]"
+    statement = f"""Bose--Chowla {h}-fold product decoding over a finite field
+
+Let F_p be the integers modulo the prime p={p}.  Work in the degree-{h} field
+K=F_p[z]/(m(z)).  Coefficient lists below are in ascending degree order:
+
+    m coefficients = {json.dumps(modulus, separators=(",", ":"))}
+
+Thus polynomial coefficients are reduced modulo p and z^{h} is replaced using
+m(z)=0.  Every element of K has a unique length-{h} coefficient list.
+
+Consider the p field elements S={{z+v : v in F_p}}.  The displayed modulus is
+irreducible, so z has algebraic degree {h}.  Consequently, two products of {h}
+members of S are equal only when their {h} v-values agree as multisets:
+subtracting the two monic degree-{h} polynomials cancels the leading term, and
+a nonzero polynomial of degree below {h} cannot vanish at z.
+
+The target element T has ascending power-basis coefficients
+
+    T coefficients = {json.dumps(target, separators=(",", ":"))}
+
+and it is promised that T is the product of exactly {h} members of S.  Find
+that multiset.  Repetitions are allowed.  Encode each monic
+linear factor z+v by the ascending coefficient list [v,1], using the canonical
+integer 0<=v<p.  Return exactly {h} such lists, sorted by nondecreasing v.
+
+Give your final answer inside <answer></answer> tags, as a JSON array of exactly
+{h} [v,1] lists.  Format example: <answer>{example}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body)
+    try:
+        answer = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return answer
+
+
+def verify(inst, answer) -> tuple[bool, str]:
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    h = inst["h"]
+    if len(answer) != h:
+        return False, f"need exactly {h} factors, got {len(answer)}"
+    p = inst["p"]
+    constants = []
+    for index, factor in enumerate(answer):
+        if not isinstance(factor, list) or len(factor) != 2:
+            return False, f"factor {index} must be a two-coefficient list"
+        if any(isinstance(value, bool) or not isinstance(value, int)
+               for value in factor):
+            return False, f"factor {index} coefficients must be integers"
+        if factor[1] != 1:
+            return False, f"factor {index} is not monic linear"
+        if not 0 <= factor[0] < p:
+            return False, f"factor {index} constant is outside [0,p)"
+        constants.append(factor[0])
+    if constants != sorted(constants):
+        return False, "factors must be sorted by constant coefficient"
+
+    product = [1]
+    for factor in answer:
+        product = _mul(product, factor, p)
+    # Both product and m are monic of degree h, so product mod m equals target
+    # exactly when product=m+target coefficient by coefficient.
+    if product != _problem_poly(inst):
+        return False, "factor product does not equal the target in K"
+    return True, "ok"
+
+
+def random_candidate(inst, rng) -> object:
+    """Uniformly sample the stated space of h unordered factors."""
+    p = inst["p"]
+    h = inst["h"]
+    bars = sorted(rng.sample(range(p + h - 1), h))
+    constants = [bars[i] - i for i in range(h)]
+    return [[value, 1] for value in constants]
+
+
+def search_space(inst) -> int | None:
+    return math.comb(inst["p"] + inst["h"] - 1, inst["h"])
+
+
+def enumerate_all(inst) -> int | None:
+    space = search_space(inst)
+    if space is None or space > 100_000:
+        return None
+    count = 0
+    for constants in itertools.combinations_with_replacement(
+            range(inst["p"]), inst["h"]):
+        answer = [[value, 1] for value in constants]
+        if verify(inst, answer)[0]:
+            count += 1
+    return count
+
+
+def _problem_poly(inst) -> list[int]:
+    p = inst["p"]
+    return [
+        (inst["target"][i] + inst["modulus"][i]) % p
+        for i in range(inst["h"])
+    ] + [1]
+
+
+def _normalized_modulus(inst, step: int) -> tuple[int, ...]:
+    """Normalize the centered arithmetic progression to fixed unit spacing."""
+    p = inst["p"]
+    h = inst["h"]
+    product = _problem_poly(inst)
+    center = product[h - 1] * pow(h, -1, p) % p
+    raw = [0] * (h + 1)
+    # step^-h m(step*y-center)
+    inverse_power = pow(pow(step, h, p), -1, p)
+    for i, coefficient in enumerate(inst["modulus"]):
+        for j in range(i + 1):
+            term = (coefficient * math.comb(i, j) * pow(step, j, p)
+                    * pow(-center, i - j, p))
+            raw[j] = (raw[j] + term) % p
+    return tuple(value * inverse_power % p for value in raw)
+
+
+def canonical_key(inst) -> str:
+    """Affine-coordinate invariant of the pair (modulus, target polynomial)."""
+    p = inst["p"]
+    h = inst["h"]
+    product = _problem_poly(inst)
+    center = product[h - 1] * pow(h, -1, p) % p
+    e2 = -(sum(offset * offset for offset in range(-(h // 2), h // 2 + 1)) // 2)
+    step_square = ((product[h - 2] - math.comb(h, 2) * center * center)
+                   * pow(e2, -1, p)) % p
+    step = _mod_sqrt(step_square, p)
+    first = _normalized_modulus(inst, step)
+    second = _normalized_modulus(inst, (-step) % p)
+    normalized = min(first, second)
+    return json.dumps([p, list(normalized)], separators=(",", ":"))
+
+
+def escalate(params) -> dict | str | None:
+    out = dict(params)
+    out.pop("_preset", None)
+    n = int(out.get("n", 1009))
+    span = int(out.get("prime_span", max(1, n // 2)))
+    step = int(out.get("max_step", max(2, math.isqrt(n) // 2)))
+    out["n"] = n * 2 + 1
+    out["prime_span"] = max(span * 2, n)
+    out["max_step"] = min(max(2, step * 2), math.isqrt(out["n"]))
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Relabellings, attacks, and mandatory gates
+
+
+def _affine_relabel(inst, scale: int, shift: int):
+    """Represent beta'=scale*beta+shift and scale all h factors."""
+    p = inst["p"]
+    h = inst["h"]
+    scale %= p
+    shift %= p
+    if scale == 0:
+        raise ValueError("scale must be nonzero")
+    modulus = _affine_poly(inst["modulus"], scale, shift, p)
+    product = _affine_poly(_problem_poly(inst), scale, shift, p)
+    target = [(product[i] - modulus[i]) % p for i in range(h)]
+    carried = sorted(
+        (((scale * factor[0] - shift) % p), 1)
+        for factor in inst["answer"]
+    )
+    return {"p": p, "h": h, "modulus": modulus, "target": target,
+            "answer": [list(factor) for factor in carried]}
+
+
+def _attack_outlier(inst):
+    p = inst["p"]
+    h = inst["h"]
+    raw = inst["target"] + inst["modulus"][:h]
+    constants = sorted({value % p for value in raw})[:h]
+    if len(constants) < h:
+        return None
+    return [[value, 1] for value in constants]
+
+
+def _attack_greedy_first(inst):
+    return [[value, 1] for value in range(inst["h"])]
+
+
+def _attack_adjacent_center(inst):
+    p = inst["p"]
+    h = inst["h"]
+    center = _problem_poly(inst)[h - 1] * pow(h, -1, p) % p
+    constants = sorted(
+        (center + offset) % p
+        for offset in range(-(h // 2), h // 2 + 1)
+    )
+    return [[value, 1] for value in constants]
+
+
+def _compact_factor(inst):
+    """The intended reflected-factor route, included only for gate checking."""
+    p = inst["p"]
+    h = inst["h"]
+    product = _problem_poly(inst)
+    center = product[h - 1] * pow(h, -1, p) % p
+    e2 = -(sum(offset * offset for offset in range(-(h // 2), h // 2 + 1)) // 2)
+    step_square = ((product[h - 2] - math.comb(h, 2) * center * center)
+                   * pow(e2, -1, p)) % p
+    step = math.isqrt(step_square)
+    if step * step != step_square:
+        return None
+    constants = sorted(
+        (center + step * offset) % p
+        for offset in range(-(h // 2), h // 2 + 1)
+    )
+    return [[value, 1] for value in constants]
+
+
+def _run_reference(inst):
+    start = time.perf_counter()
+    answer, operations, restarts = _factor_split_polynomial(
+        _problem_poly(inst), inst["p"]
+    )
+    elapsed = time.perf_counter() - start
+    return answer, operations, restarts, elapsed
+
+
+def _atom_count(value) -> int:
+    if isinstance(value, dict):
+        return sum(_atom_count(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_atom_count(item) for item in value)
+    return 1
+
