+        "entry_min": 0,
+        "entry_max": "M-1",
+        "multiplier_constraint": "gcd(d,M)=1 and d mod R = 1 mod R",
+        "shift_constraint": "0 <= s < M",
+        "candidate_count": "phi(L)*M where M=L*R and gcd(L,R)=1",
+    },
+}
