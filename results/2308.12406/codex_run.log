+    changed = dict(inst)
+    changed_A = [(unit * value + shift) % modulus for value in inst["A"]]
+    changed_B = [(unit * value + shift) % modulus for value in inst["B"]]
+    if reverse_inputs:
+        changed_A.reverse()
+        changed_B.reverse()
+    changed["A"] = changed_A
+    changed["B"] = changed_B
+    carried_s = (unit * s + (1 - d) * shift) % modulus
+    carried = [d, carried_s]
+    changed["answer"] = carried
+    return changed, carried
 
