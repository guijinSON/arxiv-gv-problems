+        "exact modular three-term-sum collision check",
+        "greatest-common-divisor unit check",
+        "exact modular affine image comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
