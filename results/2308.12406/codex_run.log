+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == good,
+        "model_style_response_parsed": parsed == good,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=20260905, **shipping_params)
+    samples = 200_000
+    rng = random.Random(0xB053)
+    hits = 0
+    for _ in range(samples):
+        hits += int(verify(shipping, random_candidate(shipping, rng))[0])
+    guess_probability = hits / samples
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": guess_probability,
+        "structure_aware_space": search_space(shipping),
+    }
+
+    exact_demo_count = enumerate_all(demo)
+    reference_rows = []
+    reference_successes = 0
+    attack_counts = {
+        "raw_coefficient_outlier": 0,
+        "greedy_first_eleven_residues": 0,
+        "random_restart_256": 0,
+        "by_hand_adjacent_center_ansatz": 0,
+    }
+    attempts = 8
+    for seed in range(800, 800 + attempts):
+        inst = make_instance(seed=seed, **shipping_params)
+        for name, candidate in (
+            ("raw_coefficient_outlier", _attack_outlier(inst)),
+            ("greedy_first_eleven_residues", _attack_greedy_first(inst)),
+            ("by_hand_adjacent_center_ansatz", _attack_adjacent_center(inst)),
+        ):
+            if candidate is not None and verify(inst, candidate)[0]:
+                attack_counts[name] += 1
+        attack_rng = random.Random(seed ^ 0xBAD5EED)
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, attack_rng))[0]:
