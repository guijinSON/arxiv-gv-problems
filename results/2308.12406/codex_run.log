+def random_candidate(inst, rng) -> object:
+    """Uniformly sample the stated space of three unordered factors."""
+    p = inst["p"]
+    bars = sorted(rng.sample(range(p + 2), 3))
+    constants = [bars[i] - i for i in range(3)]
+    return [[value, 1] for value in constants]
