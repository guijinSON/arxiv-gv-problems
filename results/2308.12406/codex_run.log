+def _candidate_from_pairs(
+    inst: dict, a0: int, a1: int, b0: int, b1: int
+) -> list[int] | None:
+    modulus = inst["M"]
+    difference = (a1 - a0) % modulus
+    if a0 == a1 or b0 == b1 or math.gcd(difference, modulus) != 1:
+        return None
+    d = ((b1 - b0) * pow(difference, -1, modulus)) % modulus
+    s = (b0 - d * a0) % modulus
+    return [d, s]
 
 
