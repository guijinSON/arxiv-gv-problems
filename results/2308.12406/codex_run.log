+            if operations is not None:
+                operations[0] += 2
+        dividend = _trim(dividend, prime)
+    return _trim(quotient, prime), dividend
+
+
+def _mod_poly(a: list[int], modulus: list[int], prime: int,
+              operations: list[int] | None = None) -> list[int]:
+    return _divmod_poly(a, modulus, prime, operations)[1]
+
+
+def _mul_mod(a: list[int], b: list[int], modulus: list[int], prime: int,
+             operations: list[int]) -> list[int]:
+    raw = [0] * (len(a) + len(b) - 1)
+    for i, av in enumerate(a):
+        for j, bv in enumerate(b):
+            raw[i + j] = (raw[i + j] + av * bv) % prime
+            operations[0] += 2
