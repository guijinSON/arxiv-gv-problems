+"""Verified generators for a Bose--Chowla product-decoding problem.
+
+Section 3 of O'Bryant, arXiv:2308.12406, proves that the q elements
+``beta + v`` (v in F_q) have unique h-fold products when beta has degree h.
+Here h=3.  The generator samples three factors first, multiplies them, and
+asks for the unique factor certificate.  It never factors its public cubic.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
