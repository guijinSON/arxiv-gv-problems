+def _canonical_cycle(cycle):
+    """Canonicalize a permutation up to rotation and reversal."""
+    if not cycle:
+        return []
+    at = cycle.index(0)
+    out = list(cycle[at:]) + list(cycle[:at])
+    if len(out) > 2 and out[1] > out[-1]:
+        out = [out[0]] + list(reversed(out[1:]))
+    return out
