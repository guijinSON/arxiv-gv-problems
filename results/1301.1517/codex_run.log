+        inst = make_instance(seed=seed, **params)
+        started = time.perf_counter()
+        candidate, count = _reference_two_core(inst)
+        elapsed.append(time.perf_counter() - started)
+        operations.append(count)
+        if candidate is not None and verify(inst, candidate)[0]:
+            reference_successes += 1
+    reference = {
+        "name": "degree-one leaf stripping followed by 2-core traversal",
+        "complexity": "O(|V|+|E|)",
+        "wall_clock_sec_mean": sum(elapsed) / len(elapsed),
+        "wall_clock_sec_max": max(elapsed),
+        "operations_mean": sum(operations) / len(operations),
+        "operations_max": max(operations),
