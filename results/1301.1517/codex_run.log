+    for _ in range(restarts):
+        first = list(rng.choice(inst["terminals"]))
+        path = [first]
+        used = {_point_key(first)}
+        while len(path) < length:
+            choices = [
+                v
+                for v in inst["adjacency"][_point_key(path[-1])]
+                if _point_key(v) not in used
+            ]
+            if not choices:
+                break
+            nxt = list(rng.choice(choices))
+            path.append(nxt)
