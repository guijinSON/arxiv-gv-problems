+        (colors[v], profiles[v], tuple(sorted(colors[w] for w in adjacency[v])))
+        for v in range(n)
+    )
+    edge_colors = sorted(
+        (min(colors[u], colors[v]), max(colors[u], colors[v]))
+        for u in range(n) for v in adjacency[u] if u < v
