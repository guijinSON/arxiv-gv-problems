+        "outlier_degree_three": lambda inst, rng: _attack_degree_outlier(inst),
+        "greedy_high_degree": lambda inst, rng: _attack_greedy(inst),
+        "random_self_avoiding_walk_128": (
+            lambda inst, rng: _attack_random_walk(inst, rng, 128)
+        ),
+        "in_context_affine_tag_ansatz": (
+            lambda inst, rng: _attack_affine_ansatz(inst)
+        ),
+    }
+    results = {}
+    for name, attack in attack_fns.items():
+        successes = 0
+        for seed in seeds:
+            inst = make_instance(seed=seed, **params)
+            candidate = attack(inst, random.Random(900_000 + seed))
+            if candidate is not None and verify(inst, candidate)[0]:
+                successes += 1
+        results[name] = {"successes": successes, "attempts": len(seeds)}
+
+    reference_successes = 0
