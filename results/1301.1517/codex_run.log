+            "wall_clock_sec_for_8": round(reference_seconds, 6),
+            "operations_for_8": reference_operations,
+            "solves": f"{reference_successes}/8, as expected on Track B",
+        },
+    }
+
+    doubled_params = dict(shipping_params)
