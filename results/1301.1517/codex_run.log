+        "wall_clock_sec_max": max(elapsed),
+        "operations_mean": sum(operations) / len(operations),
+        "operations_max": max(operations),
+        "successes": reference_successes,
+        "attempts": len(seeds),
+        "solves": f"{reference_successes}/{len(seeds)}, as expected",
+    }
+    return results, reference
 
 
