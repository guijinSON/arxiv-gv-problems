+# edges, hence four vertices to the displayed line graph and to the answer.
+DIFFICULTY = {
+    "demo": {"n": 6, "decoy_cycles": 0},
+    "easy": {"n": 36, "decoy_cycles": 6},
+    "medium": {"n": 40, "decoy_cycles": 6},
+    "hard": {"n": 44, "decoy_cycles": 7},
+}
+SHIPPING_DIFFICULTY = "easy"
+
