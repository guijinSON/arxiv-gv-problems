+    stack = [(0, None)]
+    reversed_edges = []
+    while stack:
+        vertex = stack[-1][0]
+        while work[vertex] and work[vertex][-1][0] in used:
+            work[vertex].pop()
+            operations += 1
+        if work[vertex]:
+            edge, other = work[vertex].pop()
+            operations += 1
+            if edge in used:
