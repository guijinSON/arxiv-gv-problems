def _point_key(point: list[int] | tuple[int, int]) -> str:
    return f"{point[0]},{point[1]}"


def _point_tuple(point: list[int] | tuple[int, int]) -> tuple[int, int]:
    return int(point[0]), int(point[1])


def _norm_edge(
    u: list[int] | tuple[int, int], v: list[int] | tuple[int, int]
) -> tuple[tuple[int, int], tuple[int, int]]:
    a, b = _point_tuple(u), _point_tuple(v)
    return (a, b) if a < b else (b, a)


def _is_prime(value: int) -> bool:
    if value < 2:
        return False
    if value % 2 == 0:
        return value == 2
    d = 3
    while d * d <= value:
        if value % d == 0:
            return False
        d += 2
    return True


def _next_prime(value: int) -> int:
    candidate = max(3, value | 1)
    while not _is_prime(candidate):
        candidate += 2
    return candidate
