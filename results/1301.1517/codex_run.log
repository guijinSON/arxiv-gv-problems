    "easy": {"n": 36, "decoy_cycles": 6},
    "medium": {"n": 40, "decoy_cycles": 6},
    "hard": {"n": 44, "decoy_cycles": 7},
}
SHIPPING_DIFFICULTY = "medium"

STRUCTURAL_HINT = (
