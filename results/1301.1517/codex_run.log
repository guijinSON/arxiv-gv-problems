+            "by_hand_high_onward_degree": _greedy_walk(inst, rng, "high_onward"),
+            "input_order_ansatz": _attack_input_order(inst, rng),
+        }
+        for name, candidate in candidates.items():
+            attacks[name]["attempts"] += 1
