+def _corruptions(inst: dict) -> dict[str, object]:
+    answer = copy.deepcopy(inst["answer"])
+    swapped = None
+    for i in range(len(answer)):
+        for j in range(i + 1, len(answer)):
+            candidate = copy.deepcopy(answer)
+            candidate[i], candidate[j] = candidate[j], candidate[i]
+            if not verify(inst, candidate)[0]:
+                swapped = candidate
+                break
+        if swapped is not None:
+            break
+    duplicate = copy.deepcopy(answer)
+    duplicate[-1] = list(duplicate[0])
+    out_of_range = copy.deepcopy(answer)
+    out_of_range[0] = [inst["field_prime"], 0]
+    return {
+        "drop_one": answer[:-1],
+        "swap_two": swapped,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
 
 
