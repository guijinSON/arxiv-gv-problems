+def _attack_greedy(inst: dict) -> object | None:
+    length = inst["cycle_length"]
+    terminal_keys = {_point_key(v) for v in inst["terminals"]}
+    for first in inst["terminals"]:
+        path = [list(first)]
+        used = {_point_key(first)}
+        while len(path) < length:
+            choices = [
+                v
+                for v in inst["adjacency"][_point_key(path[-1])]
+                if _point_key(v) not in used
+            ]
+            if not choices:
+                break
+            choices.sort(
+                key=lambda v: (-len(inst["adjacency"][_point_key(v)]), v)
+            )
+            nxt = choices[0]
+            path.append(list(nxt))
+            used.add(_point_key(nxt))
+        if len(path) == length and terminal_keys <= used and verify(inst, path)[0]:
+            return path
+    return None
+
+
+def _attack_random_walk(
