+def _attack_affine_ansatz(inst: dict) -> object | None:
+    """The obvious but wrong no-tool guess: terminal tags lie on a line."""
+
+    p = inst["field_prime"]
+    ordered = sorted(inst["terminals"])
+    x0, y0 = ordered[0]
+    x1, y1 = next((x, y) for x, y in ordered[1:] if x != x0)
+    slope = (y1 - y0) * pow((x1 - x0) % p, -1, p) % p
+    intercept = (y0 - slope * x0) % p
+    available = {_point_key(v): v for v in inst["vertices"]}
+    answer = []
+    for x in range(inst["cycle_length"]):
+        point = [x, (slope * x + intercept) % p]
+        if _point_key(point) not in available:
+            return None
+        answer.append(point)
+    return answer
 
 
