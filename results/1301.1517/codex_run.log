+def _greedy_walk(inst, rng, rule):
+    data, _ = _instance_data(inst)
+    n, adjacency = data
+    path = [0]
+    used = {0}
+    while len(path) < n:
+        choices = [v for v in adjacency[path[-1]] if v not in used]
+        if not choices:
+            return None
