+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
+}
+
+
+def _validate_n(n):
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4:
+        raise ValueError("n must be an integer at least 4")
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a target-2 unit-profit BMKP allocation.
+
+    Two independently sampled permutations give the two item weights assigned
+    to each knapsack.  The capacities are their sums, so the certificate is
+    known before the visible item and knapsack labels are shuffled.
+    """
+    del params
+    _validate_n(n)
+    rng = random.Random(seed)
+
+    first = list(range(1, n + 1))
+    second = list(range(1, n + 1))
+    rng.shuffle(first)
+    rng.shuffle(second)
+
+    # Shuffle the mathematical knapsacks before drawing irrelevant item labels.
+    # Thus label randomisation cannot accidentally choose an easy branch order
+    # for the exact-cover core.
+    weight_pairs = list(zip(first, second))
+    rng.shuffle(weight_pairs)
+
+    # Token (weight, copy) identifies the two physically distinct items.
+    tokens = [(weight, copy) for weight in range(1, n + 1) for copy in (0, 1)]
+    rng.shuffle(tokens)
+    token_to_id = {token: item_id for item_id, token in enumerate(tokens)}
+    item_weights = [weight for weight, _copy in tokens]
+
+    planted = []
+    for a, b in weight_pairs:
+        planted.append({
+            "capacity": a + b,
+            "bundle": sorted([token_to_id[(a, 0)], token_to_id[(b, 1)]]),
+        })
+    capacities = [row["capacity"] for row in planted]
+    answer = [row["bundle"] for row in planted]
+    t = 2 * n + 1
+    source_u = [t - capacity for capacity in capacities]
+    return {
+        "paper": "arXiv:2605.05233",
+        "family": "unit-profit bottleneck multiple knapsack at target 2",
+        "n": n,
+        "seed": seed,
+        "item_weights": item_weights,
+        "item_profits": [1] * (2 * n),
+        "capacities": capacities,
+        "target_profit": 2,
+        # These record that the instance is literally in Section 6's image.
+        # render() need not expose them: they are derivable from the capacities.
+        "rn3dm_t": t,
+        "rn3dm_u": source_u,
+        "answer": answer,
+    }
+
+
+def render(inst):
+    n = inst["n"]
+    weights = json.dumps(inst["item_weights"], separators=(",", ":"))
+    capacities = json.dumps(inst["capacities"], separators=(",", ":"))
+    lines = [
+        "Find a target-2 allocation for this bottleneck multiple knapsack instance.",
+        "",
+        "Definitions and conventions.",
+        f"There are {2 * n} distinct items, with IDs 0 through {2 * n - 1}, and {n} knapsacks, with IDs 0 through {n - 1}.",
+        "Item i has integer weight W[i] and profit 1. Each item may be used at most once.",
+        "Knapsack j has integer capacity B[j]. Its assigned items must have total weight at most B[j].",
+        "The profit of a knapsack is the sum of its item profits. A target-2 allocation gives every knapsack profit at least 2.",
+        "For this instance your witness must give exactly two distinct item IDs to each knapsack and must use every item exactly once.",
+        "Bundle order follows knapsack order: entry j is the bundle for knapsack j. The two IDs inside a bundle are unordered; either order is accepted.",
+        "All indexing is 0-based. Capacity bounds are inclusive. Repeated item IDs are forbidden.",
+        "",
+        f"W = {weights}",
+        f"B = {capacities}",
+        "",
+        "Give your final answer inside <answer></answer> tags, as a JSON list of exactly n two-integer lists.",
+        "Example for three knapsacks: <answer>[[3,17],[0,5],[2,9]]</answer>",
+        "Output nothing else inside the tags.",
+    ]
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    try:
+        match = re.search(
+            r"<answer>(.*?)</answer>", str(text),
+            flags=re.IGNORECASE | re.DOTALL,
+        )
+        if not match:
+            return None
+        body = match.group(1).strip()
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.IGNORECASE)
+        body = re.sub(r"\s*```$", "", body).strip()
+        value = json.loads(body)
+        return value
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+
+
+def verify(inst, answer):
+    n = inst["n"]
+    if answer == []:
+        return False, "empty answer: expected one two-item bundle per knapsack"
+    if not isinstance(answer, list):
+        return False, "malformed: expected a JSON list of bundles"
+    if len(answer) != n:
+        return False, f"wrong bundle count: expected {n}, got {len(answer)}"
+
+    flat = []
+    for j, bundle in enumerate(answer):
+        if not isinstance(bundle, list) or len(bundle) != 2:
+            return False, f"wrong bundle shape: knapsack {j} needs exactly two item IDs"
+        for item_id in bundle:
+            if isinstance(item_id, bool) or not isinstance(item_id, int):
+                return False, f"non-integer item ID in knapsack {j}"
+            if item_id < 0 or item_id >= 2 * n:
+                return False, f"out-of-range item ID {item_id} in knapsack {j}"
+            flat.append(item_id)
+
+    seen = set()
+    for item_id in flat:
+        if item_id in seen:
+            return False, f"reused item ID {item_id}"
+        seen.add(item_id)
+    if len(seen) != 2 * n:
+        return False, "not all items are used exactly once"
+
+    weights = inst["item_weights"]
+    profits = inst["item_profits"]
+    for j, (a, b) in enumerate(answer):
+        load = weights[a] + weights[b]
+        if load > inst["capacities"][j]:
+            return False, (
+                f"capacity exceeded at knapsack {j}: "
+                f"load {load} > {inst['capacities'][j]}"
+            )
+        profit = profits[a] + profits[b]
+        if profit < inst["target_profit"]:
+            return False, f"profit target missed at knapsack {j}"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    ids = list(range(2 * inst["n"]))
+    rng.shuffle(ids)
+    return [sorted(ids[2 * j:2 * j + 2]) for j in range(inst["n"])]
+
+
+def search_space(inst):
+    n = inst["n"]
+    # Ordered knapsacks, unordered pair within each knapsack, distinct item IDs.
+    return math.factorial(2 * n) // (2 ** n)
+
+
+def enumerate_all(inst):
+    """Exact count in CERTIFICATE_LANGUAGE, capped before combinatorial blow-up."""
+    n = inst["n"]
+    if search_space(inst) > 2_000_000:
+        return None
+    weights = inst["item_weights"]
+    capacities = inst["capacities"]
+    count = 0
+
+    def visit(j, remaining):
+        nonlocal count
+        if j == n:
+            count += 1
+            return
+        remaining = tuple(remaining)
+        for q in range(1, len(remaining)):
+            a, b = remaining[0], remaining[q]
+            if weights[a] + weights[b] != capacities[j]:
+                continue
+            visit(j + 1, remaining[1:q] + remaining[q + 1:])
+        # The smallest remaining ID need not be in the current bin, so cover all
+        # pairs, not just pairs involving it.
+        for p in range(1, len(remaining)):
+            for q in range(p + 1, len(remaining)):
+                a, b = remaining[p], remaining[q]
+                if weights[a] + weights[b] != capacities[j]:
+                    continue
+                rest = remaining[:p] + remaining[p + 1:q] + remaining[q + 1:]
+                visit(j + 1, rest)
+
+    visit(0, tuple(range(2 * n)))
+    return count
+
+
+def canonical_key(inst):
+    """Invariant under item relabelling and knapsack relabelling."""
+    item_types = sorted(zip(inst["item_weights"], inst["item_profits"]))
+    payload = [
+        inst["target_profit"],
+        item_types,
+        sorted(inst["capacities"]),
+    ]
+    raw = json.dumps(payload, separators=(",", ":"))
+    return hashlib.sha256(raw.encode("ascii")).hexdigest()
