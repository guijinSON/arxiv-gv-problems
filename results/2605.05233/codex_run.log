-def make_instance(n, seed=0, **params):
-    """Inverse-generate a target-2 unit-profit BMKP allocation.
-
-    Two independently sampled permutations give the two item weights assigned
-    to each knapsack.  The capacities are their sums, so the certificate is
-    known before the visible item and knapsack labels are shuffled.
-    """
-    del params
-    _validate_n(n)
-    rng = random.Random(seed)
-
-    first = list(range(1, n + 1))
-    second = list(range(1, n + 1))
-    rng.shuffle(first)
-    rng.shuffle(second)
-
-    # Shuffle the mathematical knapsacks before drawing irrelevant item labels.
-    # Thus label randomisation cannot accidentally choose an easy branch order
-    # for the exact-cover core.
-    weight_pairs = list(zip(first, second))
-    rng.shuffle(weight_pairs)
-
-    # Token (weight, copy) identifies the two physically distinct items.
-    tokens = [(weight, copy) for weight in range(1, n + 1) for copy in (0, 1)]
-    rng.shuffle(tokens)
-    token_to_id = {token: item_id for item_id, token in enumerate(tokens)}
-    item_weights = [weight for weight, _copy in tokens]
-
-    planted = []
-    for a, b in weight_pairs:
-        planted.append({
-            "capacity": a + b,
-            "bundle": sorted([token_to_id[(a, 0)], token_to_id[(b, 1)]]),
-        })
-    capacities = [row["capacity"] for row in planted]
-    answer = [row["bundle"] for row in planted]
-    t = 2 * n + 1
-    source_u = [t - capacity for capacity in capacities]
-    return {
-        "paper": "arXiv:2605.05233",
-        "family": "unit-profit bottleneck multiple knapsack at target 2",
-        "n": n,
-        "seed": seed,
-        "item_weights": item_weights,
-        "item_profits": [1] * (2 * n),
-        "capacities": capacities,
-        "target_profit": 2,
-        # These record that the instance is literally in Section 6's image.
-        # render() need not expose them: they are derivable from the capacities.
-        "rn3dm_t": t,
-        "rn3dm_u": source_u,
-        "answer": answer,
-    }
-
-
-def render(inst):
-    n = inst["n"]
-    weights = json.dumps(inst["item_weights"], separators=(",", ":"))
-    capacities = json.dumps(inst["capacities"], separators=(",", ":"))
-    lines = [
-        "Find a target-2 allocation for this bottleneck multiple knapsack instance.",
-        "",
-        "Definitions and conventions.",
-        f"There are {2 * n} distinct items, with IDs 0 through {2 * n - 1}, and {n} knapsacks, with IDs 0 through {n - 1}.",
-        "Item i has integer weight W[i] and profit 1. Each item may be used at most once.",
-        "Knapsack j has integer capacity B[j]. Its assigned items must have total weight at most B[j].",
-        "The profit of a knapsack is the sum of its item profits. A target-2 allocation gives every knapsack profit at least 2.",
-        "For this instance your witness must give exactly two distinct item IDs to each knapsack and must use every item exactly once.",
-        "Bundle order follows knapsack order: entry j is the bundle for knapsack j. The two IDs inside a bundle are unordered; either order is accepted.",
-        "All indexing is 0-based. Capacity bounds are inclusive. Repeated item IDs are forbidden.",
-        "",
-        f"W = {weights}",
-        f"B = {capacities}",
-        "",
-        "Give your final answer inside <answer></answer> tags, as a JSON list of exactly n two-integer lists.",
-        "Example for three knapsacks: <answer>[[3,17],[0,5],[2,9]]</answer>",
-        "Output nothing else inside the tags.",
-    ]
-    mode = os.environ.get("GV_HINT_MODE")
-    if mode == "structural":
-        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
-    elif mode == "placebo":
-        lines.extend(["", "Hint: " + PLACEBO_HINT])
-    return "\n".join(lines)
-
-
-def parse_answer(text):
-    try:
-        match = re.search(
-            r"<answer>(.*?)</answer>", str(text),
-            flags=re.IGNORECASE | re.DOTALL,
-        )
-        if not match:
-            return None
-        body = match.group(1).strip()
-        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.IGNORECASE)
-        body = re.sub(r"\s*```$", "", body).strip()
-        value = json.loads(body)
-        return value
-    except (TypeError, ValueError, json.JSONDecodeError):
-        return None
-
-
-def verify(inst, answer):
-    n = inst["n"]
-    if answer == []:
-        return False, "empty answer: expected one two-item bundle per knapsack"
-    if not isinstance(answer, list):
-        return False, "malformed: expected a JSON list of bundles"
-    if len(answer) != n:
-        return False, f"wrong bundle count: expected {n}, got {len(answer)}"
-
-    flat = []
-    for j, bundle in enumerate(answer):
-        if not isinstance(bundle, list) or len(bundle) != 2:
-            return False, f"wrong bundle shape: knapsack {j} needs exactly two item IDs"
-        for item_id in bundle:
-            if isinstance(item_id, bool) or not isinstance(item_id, int):
-                return False, f"non-integer item ID in knapsack {j}"
-            if item_id < 0 or item_id >= 2 * n:
-                return False, f"out-of-range item ID {item_id} in knapsack {j}"
-            flat.append(item_id)
-
-    seen = set()
-    for item_id in flat:
-        if item_id in seen:
-            return False, f"reused item ID {item_id}"
-        seen.add(item_id)
-    if len(seen) != 2 * n:
-        return False, "not all items are used exactly once"
-
-    weights = inst["item_weights"]
-    profits = inst["item_profits"]
-    for j, (a, b) in enumerate(answer):
-        load = weights[a] + weights[b]
-        if load > inst["capacities"][j]:
-            return False, (
-                f"capacity exceeded at knapsack {j}: "
-                f"load {load} > {inst['capacities'][j]}"
-            )
-        profit = profits[a] + profits[b]
-        if profit < inst["target_profit"]:
-            return False, f"profit target missed at knapsack {j}"
-    return True, "ok"
-
-
-def random_candidate(inst, rng):
-    ids = list(range(2 * inst["n"]))
-    rng.shuffle(ids)
-    return [sorted(ids[2 * j:2 * j + 2]) for j in range(inst["n"])]
-
-
-def search_space(inst):
-    n = inst["n"]
-    # Ordered knapsacks, unordered pair within each knapsack, distinct item IDs.
-    return math.factorial(2 * n) // (2 ** n)
-
-
-def enumerate_all(inst):
-    """Exact count in CERTIFICATE_LANGUAGE, capped before combinatorial blow-up."""
-    n = inst["n"]
-    if search_space(inst) > 2_000_000:
-        return None
-    weights = inst["item_weights"]
-    capacities = inst["capacities"]
-    count = 0
-
-    def visit(j, remaining):
-        nonlocal count
-        if j == n:
-            count += 1
-            return
-        remaining = tuple(remaining)
-        for q in range(1, len(remaining)):
-            a, b = remaining[0], remaining[q]
-            if weights[a] + weights[b] != capacities[j]:
-                continue
-            visit(j + 1, remaining[1:q] + remaining[q + 1:])
-        # The smallest remaining ID need not be in the current bin, so cover all
-        # pairs, not just pairs involving it.
-        for p in range(1, len(remaining)):
-            for q in range(p + 1, len(remaining)):
-                a, b = remaining[p], remaining[q]
-                if weights[a] + weights[b] != capacities[j]:
-                    continue
-                rest = remaining[:p] + remaining[p + 1:q] + remaining[q + 1:]
-                visit(j + 1, rest)
-
-    visit(0, tuple(range(2 * n)))
-    return count
-
-
-def canonical_key(inst):
-    """Invariant under item relabelling and knapsack relabelling."""
-    item_types = sorted(zip(inst["item_weights"], inst["item_profits"]))
-    payload = [
-        inst["target_profit"],
-        item_types,
-        sorted(inst["capacities"]),
-    ]
-    raw = json.dumps(payload, separators=(",", ":"))
-    return hashlib.sha256(raw.encode("ascii")).hexdigest()
-
-
-def escalate(params):
-    n = params.get("n", 120)
-    if n < 126:
-        out = dict(params)
-        out["n"] = min(126, max(n + 16, math.ceil(1.35 * n)))
-        return out
-    # Every native target-2 witness uses 2n atomic IDs; n=126 is already at 252
-    # of the 256 allowed atoms. No certificate-preserving fixed-length dial is
-    # available in this exact two-copy construction.
-    return "cap_bound"
-
-
-# ---------------------------------------------------------------------------
-# Attacks and measurements.
-
-def _weight_pools(inst):
-    pools = [[] for _ in range(inst["n"] + 1)]
-    for item_id, weight in enumerate(inst["item_weights"]):
-        pools[weight].append(item_id)
-    return pools
-
-
-def _ids_from_weight_pairs(inst, pairs):
-    if pairs is None or len(pairs) != inst["n"]:
-        return None
-    pools = _weight_pools(inst)
-    out = []
-    for pair in pairs:
-        bundle = []
-        for weight in pair:
-            if weight < 1 or weight >= len(pools) or not pools[weight]:
-                return None
-            bundle.append(pools[weight].pop())
-        out.append(sorted(bundle))
-    return out
-
-
-def _available_pairs(capacity, counts, n):
-    out = []
-    for a in range(max(1, capacity - n), capacity // 2 + 1):
-        b = capacity - a
-        if b > n:
-            continue
-        if a == b:
-            if counts[a] >= 2:
-                out.append((a, b))
-        elif counts[a] and counts[b]:
-            out.append((a, b))
-    return out
-
-
-def _greedy_weights(inst, pair_order="balanced", choose_mrv=False):
-    n = inst["n"]
-    counts = [0] + [2] * n
-    remaining_bins = list(range(n))
-    answer = [None] * n
-    while remaining_bins:
-        choices = []
-        for j in remaining_bins:
-            pairs = _available_pairs(inst["capacities"][j], counts, n)
-            if not pairs:
-                return None
-            choices.append((len(pairs), j, pairs))
-        if choose_mrv:
-            _size, j, pairs = min(choices, key=lambda z: (z[0], z[1]))
-        else:
-            _size, j, pairs = choices[0]
-        if pair_order == "balanced":
-            a, b = min(pairs, key=lambda z: (z[1] - z[0], z[0]))
-        elif pair_order == "extreme":
-            a, b = min(pairs, key=lambda z: (z[0], z[1]))
-        else:
-            a, b = pairs[0]
-        counts[a] -= 1
-        counts[b] -= 1
-        answer[j] = (a, b)
-        remaining_bins.remove(j)
-    return _ids_from_weight_pairs(inst, answer)
-
-
-def _input_order_attack(inst):
-    ids = list(range(2 * inst["n"]))
-    return [ids[2 * j:2 * j + 2] for j in range(inst["n"])]
-
-
-def _random_restart_attack(inst, rng, restarts=64):
-    n = inst["n"]
-    explored = 0
-    for _ in range(restarts):
-        counts = [0] + [2] * n
-        remaining_bins = list(range(n))
-        pairs_by_bin = [None] * n
-        while remaining_bins:
-            domains = []
-            for j in remaining_bins:
-                pairs = _available_pairs(inst["capacities"][j], counts, n)
-                if not pairs:
-                    domains = []
-                    break
-                domains.append((len(pairs), j, pairs))
-            if not domains:
-                break
-            width = min(row[0] for row in domains)
-            tight = [row for row in domains if row[0] == width]
-            _size, j, pairs = rng.choice(tight)
-            a, b = rng.choice(pairs)
-            counts[a] -= 1
-            counts[b] -= 1
-            pairs_by_bin[j] = (a, b)
-            remaining_bins.remove(j)
-            explored += 1
-        else:
-            candidate = _ids_from_weight_pairs(inst, pairs_by_bin)
-            if candidate is not None and verify(inst, candidate)[0]:
-                return candidate, {"restarts": restarts, "nodes": explored}
-    return None, {"restarts": restarts, "nodes": explored}
-
-
-def _exact_cover_mrv(inst, node_budget=200_000):
-    """Standard depth-first exact-cover/CP search with MRV propagation."""
-    n = inst["n"]
-    counts = [0] + [2] * n
-    capacities = list(inst["capacities"])
-    bin_ids = list(range(n))
-    chosen = [None] * n
-    nodes = 0
-    cutoff = False
-
-    def dfs(depth):
-        nonlocal nodes, cutoff
-        nodes += 1
-        if nodes > node_budget:
-            cutoff = True
-            return False
-        if depth == n:
-            return True
-        best_pairs = None
-        best_at = None
-        for at in range(depth, n):
-            pairs = _available_pairs(capacities[at], counts, n)
-            if not pairs:
-                return False
-            if best_pairs is None or len(pairs) < len(best_pairs):
-                best_pairs = pairs
-                best_at = at
-        capacities[depth], capacities[best_at] = capacities[best_at], capacities[depth]
-        bin_ids[depth], bin_ids[best_at] = bin_ids[best_at], bin_ids[depth]
-        original_bin = bin_ids[depth]
-        for a, b in best_pairs:
-            counts[a] -= 1
-            counts[b] -= 1
-            chosen[original_bin] = (a, b)
-            if dfs(depth + 1):
-                return True
-            counts[a] += 1
-            counts[b] += 1
-            if cutoff:
-                break
-        capacities[depth], capacities[best_at] = capacities[best_at], capacities[depth]
-        bin_ids[depth], bin_ids[best_at] = bin_ids[best_at], bin_ids[depth]
-        return False
-
-    solved = dfs(0)
-    candidate = _ids_from_weight_pairs(inst, chosen) if solved else None
-    return candidate, {"nodes": nodes, "cutoff": cutoff}
-
-
-def _answer_atoms(value):
-    if isinstance(value, dict):
-        return sum(_answer_atoms(v) for v in value.values())
-    if isinstance(value, list):
-        return sum(_answer_atoms(v) for v in value)
-    return 1
-
-
-def _relabel_instance(inst, rng, reorder_items=False, reorder_bins=False):
-    n = inst["n"]
-    item_order = list(range(2 * n))
-    bin_order = list(range(n))
-    if reorder_items:
-        rng.shuffle(item_order)
-    if reorder_bins:
-        rng.shuffle(bin_order)
-    old_to_new = [0] * (2 * n)
-    for new, old in enumerate(item_order):
-        old_to_new[old] = new
-    answer = [
-        sorted(old_to_new[item_id] for item_id in inst["answer"][old_bin])
-        for old_bin in bin_order
-    ]
-    capacities = [inst["capacities"][old] for old in bin_order]
-    out = {
-        "paper": inst.get("paper"),
-        "family": inst.get("family"),
-        "n": n,
-        "seed": inst.get("seed"),
-        "item_weights": [inst["item_weights"][old] for old in item_order],
-        "item_profits": [inst["item_profits"][old] for old in item_order],
-        "capacities": capacities,
-        "target_profit": inst["target_profit"],
-        "rn3dm_t": inst["rn3dm_t"],
-        "rn3dm_u": [inst["rn3dm_t"] - c for c in capacities],
-        "answer": answer,
-    }
-    return out
-
-
-def _capacity_breaking_swap(inst):
-    answer = [bundle[:] for bundle in inst["answer"]]
-    weights = inst["item_weights"]
-    for j in range(inst["n"]):
-        for k in range(j + 1, inst["n"]):
-            for x in (0, 1):
-                for y in (0, 1):
-                    bad = [bundle[:] for bundle in answer]
-                    bad[j][x], bad[k][y] = bad[k][y], bad[j][x]
-                    if (weights[bad[j][0]] + weights[bad[j][1]]
-                            > inst["capacities"][j]):
-                        return bad
-                    if (weights[bad[k][0]] + weights[bad[k][1]]
-                            > inst["capacities"][k]):
-                        return bad
-    raise AssertionError("no capacity-breaking cross-bin swap found")
-
-
-def selftest():
-    report = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
-
-    planted_ok = json_ok = attempts = 0
-    for _name, params in DIFFICULTY.items():
-        for seed in (0, 1, 7):
-            inst = make_instance(seed=seed, **params)
-            attempts += 1
-            planted_ok += int(verify(inst, inst["answer"])[0])
-            json_ok += int(json.loads(json.dumps(inst["answer"])) == inst["answer"])
-    report["G1_planted_verifies"] = {
-        "pass": planted_ok == attempts and json_ok == attempts,
-        "verified": planted_ok,
-        "attempts": attempts,
-        "json_native_roundtrips": json_ok,
-    }
-
-    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
-    inst = make_instance(seed=424242, **shipping)
-    answer = inst["answer"]
-    corruptions = {
-        "drop": [answer[0][:-1]] + [b[:] for b in answer[1:]],
-        "swap": _capacity_breaking_swap(inst),
-        "duplicate": [[answer[0][0], answer[0][0]]] + [b[:] for b in answer[1:]],
-        "empty": [],
-        "out_of_range": [[2 * inst["n"], answer[0][1]]] + [b[:] for b in answer[1:]],
-    }
-    rejected = {}
-    for name, candidate in corruptions.items():
-        ok, reason = verify(inst, candidate)
-        rejected[name] = {"rejected": not ok, "reason": reason}
-    reasons = [row["reason"] for row in rejected.values()]
-    report["G2_rejects_corruption"] = {
-        "pass": all(row["rejected"] for row in rejected.values())
-        and len(set(reasons)) == len(reasons),
-        "cases": rejected,
-        "distinct_reasons": len(set(reasons)),
-    }
-
-    realistic = (
-        "The total-weight equality makes each chosen pair exact.\n"
-        "```json\n<answer>" + json.dumps(answer, separators=(",", ":"))
-        + "</answer>\n```\n"
-    )
-    parsed = parse_answer(realistic)
-    report["G3_round_trip"] = {
-        "pass": parsed == answer and parse_answer("no tagged answer") is None,
-        "realistic_response": parsed == answer,
-        "garbage_returns_none": parse_answer("no tagged answer") is None,
-    }
-
-    guess_rng = random.Random(90210)
-    guess_total = 200_000
-    guess_hits = 0
-    t0 = time.perf_counter()
-    for _ in range(guess_total):
-        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
-    guess_seconds = time.perf_counter() - t0
-    guess_fraction = guess_hits / guess_total
-    report["G4_guess_resistance"] = {
-        "pass": guess_fraction < 1e-6,
-        "hits": guess_hits,
-        "total": guess_total,
-        "observed_probability": guess_fraction,
-        "candidate_space": search_space(inst),
-        "wall_clock_sec": round(guess_seconds, 6),
-        "structure_aware_prior": (
-            "uniform allocations using every distinct item exactly once, with "
-            "two items in each indexed knapsack"
-        ),
-    }
-
-    panel_seeds = list(range(8))
-    attack_names = [
-        "outlier_input_order",
-        "greedy_balanced_pair",
-        "random_restart_64",
-        "exact_cover_mrv_200000",
-    ]
-    attacks = {
-        name: {"successes": 0, "attempts": len(panel_seeds)}
