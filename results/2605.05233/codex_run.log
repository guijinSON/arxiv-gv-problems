-def _relabel_instance(inst, rng, reorder_items=False, reorder_bins=False):
-    n = inst["n"]
-    item_order = list(range(2 * n))
-    bin_order = list(range(n))
-    if reorder_items:
-        rng.shuffle(item_order)
-    if reorder_bins:
-        rng.shuffle(bin_order)
-    old_to_new = [0] * (2 * n)
-    for new, old in enumerate(item_order):
-        old_to_new[old] = new
-    answer = [
-        sorted(old_to_new[item_id] for item_id in inst["answer"][old_bin])
-        for old_bin in bin_order
-    ]
-    capacities = [inst["capacities"][old] for old in bin_order]
-    out = {
-        "paper": inst.get("paper"),
-        "family": inst.get("family"),
-        "n": n,
-        "seed": inst.get("seed"),
-        "item_weights": [inst["item_weights"][old] for old in item_order],
-        "item_profits": [inst["item_profits"][old] for old in item_order],
-        "capacities": capacities,
-        "target_profit": inst["target_profit"],
-        "rn3dm_t": inst["rn3dm_t"],
-        "rn3dm_u": [inst["rn3dm_t"] - c for c in capacities],
-        "answer": answer,
-    }
-    return out
-
-
-def _capacity_breaking_swap(inst):
-    answer = [bundle[:] for bundle in inst["answer"]]
-    weights = inst["item_weights"]
-    for j in range(inst["n"]):
-        for k in range(j + 1, inst["n"]):
-            for x in (0, 1):
-                for y in (0, 1):
-                    bad = [bundle[:] for bundle in answer]
-                    bad[j][x], bad[k][y] = bad[k][y], bad[j][x]
-                    if (weights[bad[j][0]] + weights[bad[j][1]]
-                            > inst["capacities"][j]):
-                        return bad
-                    if (weights[bad[k][0]] + weights[bad[k][1]]
-                            > inst["capacities"][k]):
-                        return bad
-    raise AssertionError("no capacity-breaking cross-bin swap found")
