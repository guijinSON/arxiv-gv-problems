+# Filled from the three isolated harden.py runs.  Keeping measurements as module
+# data avoids forbidden file I/O and makes selftest deterministic.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
