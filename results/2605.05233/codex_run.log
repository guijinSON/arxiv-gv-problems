    orbits.append(orb)
print(len(orbits),orbits[:3],{sum(o) for o in orbits})

def gen(q,seed):
  rng=random.Random(seed); obs=orbits[:];rng.shuffle(obs); obs=obs[:q]
  groups=[]
  for orb in obs:
    # random weak composition H into 4 symmetric parts
    cuts=sorted(rng.sample(range(H+3),3))
    hs=[cuts[0],cuts[1]-cuts[0]-1,cuts[2]-cuts[1]-1,H+2-cuts[2]]
    rng.shuffle(hs); rng.shuffle(orb)
    ws=[P*h+r for h,r in zip(hs,orb)]
    assert sum(ws)==P*(H+2)
    groups.append(ws)
  toks=[(w,g) for g,ws in enumerate(groups) for w in ws];rng.shuffle(toks)
  return [w for w,g in toks], [g for w,g in toks]

def one_subset(weights,k,target):
  snaps=[]; dp=[0]*(k+1);dp[0]=1; ops=0; words=0
  snaps.append(tuple(dp))
  mask=(1<<(target+1))-1
  for i,w in enumerate(weights):
    for c in range(min(k,i+1),0,-1):
      ops+=1; words+=(target+64)//64
      dp[c] |= (dp[c-1]<<w)&mask
    snaps.append(tuple(dp))
  if ((dp[k]>>target)&1)==0:return None,(ops,words)
  sel=[];s=target;c=k
  for i in range(len(weights),0,-1):
    if (snaps[i-1][c]>>s)&1: continue
    w=weights[i-1]
    if c and s>=w and ((snaps[i-1][c-1]>>(s-w))&1):
      sel.append(i-1);s-=w;c-=1
    else: return None,(ops,words)
  return sel,(ops,words)

def solve(weights,m=4,restarts=8,seed=0):
  N=len(weights); k=N//m; target=sum(weights)//m
  rng=random.Random(seed); totalops=totalwords=0
  for rr in range(restarts):
    rem=list(range(N)); bins=[]; ok=True
    if rr: rng.shuffle(rem)
    for b in range(m-1):
