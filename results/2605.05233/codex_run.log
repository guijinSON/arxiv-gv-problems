+    from gvlib import exact_matrices, rationals  # noqa: F401
+except ImportError:  # This discrete family remains standard-library-only.
+    exact_matrices = rationals = None
+
+
+TRACK = "A"
+
+PROBLEM_PROFILE = {
+    "native_domain": "optimization",
+    "object_regime": "finite_discrete",
+    "computational_core": "exact_cover",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "unit-profit weighted items",
+        "arbitrary-capacity knapsacks",
+        "item-to-knapsack allocation",
+    ],
+    "verification_operations": [
+        "integer item-usage count",
+        "integer weight addition",
+        "capacity and profit comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 6, Definition 39 and proof of Theorem 3 "
+        "(RN3DM to unit-profit BMKP)"
+    ),
+    "reduction_source": "paper_central",
+    "intuition_type": "constraint propagation",
+    "intuition_description": (
+        "The target and total-weight equality force every capacity inequality "
+        "to be tight, turning allocation into propagation among complementary "
+        "weight pairs; without that observation one searches arbitrary bundles."
+    ),
+    "hardness_basis": (
+        "Track A: Theorem 3 via Section 6's strongly NP-complete RN3DM regime, "
+        "with arbitrary capacities, unit profits, two copies of every weight, "
+        "and target 2; at the n=120 shipping preset the standard MRV exact-cover "
+        "attack is tested for 200,000 nodes on each of eight planted instances."
+    ),
+    # Replaced with the measured worst case after the final self-test.
+    "max_answer_tokens": 330,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 4},
+    "easy": {"n": 32},
+    "medium": {"n": 80},
+    "hard": {"n": 120},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Compare the total item weight with the total capacity: feasibility at "
+    "profit two makes every knapsack's capacity inequality tight."
+)
+PLACEBO_HINT = (
+    "Check the item identifiers and capacity entries carefully, since every "
+    "listed integer participates in the final allocation."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list of n unordered two-item bundles, one for each indexed "
+        "knapsack; every one of the 2n distinct item IDs occurs once.  The "
+        "canonical random-candidate representation sorts the two IDs in each "
+        "bundle."
+    ),
+    "bounds": {
+        "bundles": "n",
+        "items_per_bundle": 2,
+        "item_id_min": 0,
+        "item_id_max": "2n-1",
+        "repetitions": 0,
+    },
+}
+
+NOTES = (
+    "Section 3 fixes BMKP feasibility as disjoint item subsets respecting each "
+    "capacity, and Section 6 (Definition 39 and the proof of Theorem 3) fixes "
+    "the hard unit-profit regime used here: two copies of weights 1 through n, "
+    "n arbitrary capacities, and optimum either one or two. Theorems 1 and 2 "
+    "are the relevant easy-side results: for fixed epsilon they compute only "
+    "2/3-epsilon and 1/2-epsilon approximations, not the exact target-2 "
+    "certificate. Instances are inverse-generated from two independent random "
+    "permutations, after which both item IDs and knapsacks are independently "
+    "relabelled. This makes planted and non-planted feasible pairs use the same "
+    "weight population. Input-order, balanced-pair, randomized-greedy, and the "
+    "standard MRV exact-cover attacks are all measured in selftest()."
+)
