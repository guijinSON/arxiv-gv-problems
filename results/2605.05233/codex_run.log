+    for pos in range(len(weights), 0, -1):
+        if (snapshots[pos - 1][count] >> subtotal) & 1:
+            continue
+        weight = weights[pos - 1]
+        if (count <= 0 or subtotal < weight
+                or not ((snapshots[pos - 1][count - 1]
+                         >> (subtotal - weight)) & 1)):
+            return None, {
