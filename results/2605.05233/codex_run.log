-# ---------------------------------------------------------------------------
-# Attacks and measurements.
-
-def _weight_pools(inst):
-    pools = [[] for _ in range(inst["n"] + 1)]
-    for item_id, weight in enumerate(inst["item_weights"]):
-        pools[weight].append(item_id)
-    return pools
-
-
-def _ids_from_weight_pairs(inst, pairs):
-    if pairs is None or len(pairs) != inst["n"]:
-        return None
-    pools = _weight_pools(inst)
-    out = []
-    for pair in pairs:
-        bundle = []
-        for weight in pair:
-            if weight < 1 or weight >= len(pools) or not pools[weight]:
-                return None
-            bundle.append(pools[weight].pop())
-        out.append(sorted(bundle))
-    return out
-
-
-def _available_pairs(capacity, counts, n):
-    out = []
-    for a in range(max(1, capacity - n), capacity // 2 + 1):
-        b = capacity - a
-        if b > n:
-            continue
-        if a == b:
-            if counts[a] >= 2:
-                out.append((a, b))
-        elif counts[a] and counts[b]:
-            out.append((a, b))
-    return out
-
-
-def _greedy_weights(inst, pair_order="balanced", choose_mrv=False):
-    n = inst["n"]
-    counts = [0] + [2] * n
-    remaining_bins = list(range(n))
-    answer = [None] * n
-    while remaining_bins:
-        choices = []
-        for j in remaining_bins:
-            pairs = _available_pairs(inst["capacities"][j], counts, n)
-            if not pairs:
-                return None
-            choices.append((len(pairs), j, pairs))
-        if choose_mrv:
-            _size, j, pairs = min(choices, key=lambda z: (z[0], z[1]))
-        else:
-            _size, j, pairs = choices[0]
-        if pair_order == "balanced":
-            a, b = min(pairs, key=lambda z: (z[1] - z[0], z[0]))
-        elif pair_order == "extreme":
-            a, b = min(pairs, key=lambda z: (z[0], z[1]))
-        else:
-            a, b = pairs[0]
-        counts[a] -= 1
-        counts[b] -= 1
-        answer[j] = (a, b)
-        remaining_bins.remove(j)
-    return _ids_from_weight_pairs(inst, answer)
-
-
-def _input_order_attack(inst):
-    ids = list(range(2 * inst["n"]))
-    return [ids[2 * j:2 * j + 2] for j in range(inst["n"])]
-
-
-def _random_restart_attack(inst, rng, restarts=64):
-    n = inst["n"]
-    explored = 0
-    for _ in range(restarts):
-        counts = [0] + [2] * n
-        remaining_bins = list(range(n))
-        pairs_by_bin = [None] * n
-        while remaining_bins:
-            domains = []
-            for j in remaining_bins:
-                pairs = _available_pairs(inst["capacities"][j], counts, n)
-                if not pairs:
-                    domains = []
-                    break
-                domains.append((len(pairs), j, pairs))
-            if not domains:
-                break
-            width = min(row[0] for row in domains)
-            tight = [row for row in domains if row[0] == width]
-            _size, j, pairs = rng.choice(tight)
-            a, b = rng.choice(pairs)
-            counts[a] -= 1
-            counts[b] -= 1
-            pairs_by_bin[j] = (a, b)
-            remaining_bins.remove(j)
-            explored += 1
-        else:
-            candidate = _ids_from_weight_pairs(inst, pairs_by_bin)
-            if candidate is not None and verify(inst, candidate)[0]:
-                return candidate, {"restarts": restarts, "nodes": explored}
-    return None, {"restarts": restarts, "nodes": explored}
-
-
-def _exact_cover_mrv(inst, node_budget=200_000):
-    """Standard depth-first exact-cover/CP search with MRV propagation."""
-    n = inst["n"]
-    counts = [0] + [2] * n
-    capacities = list(inst["capacities"])
-    bin_ids = list(range(n))
-    chosen = [None] * n
-    nodes = 0
-    cutoff = False
-
-    def dfs(depth):
-        nonlocal nodes, cutoff
-        nodes += 1
-        if nodes > node_budget:
-            cutoff = True
-            return False
-        if depth == n:
-            return True
-        best_pairs = None
-        best_at = None
-        for at in range(depth, n):
-            pairs = _available_pairs(capacities[at], counts, n)
-            if not pairs:
-                return False
-            if best_pairs is None or len(pairs) < len(best_pairs):
-                best_pairs = pairs
-                best_at = at
-        capacities[depth], capacities[best_at] = capacities[best_at], capacities[depth]
-        bin_ids[depth], bin_ids[best_at] = bin_ids[best_at], bin_ids[depth]
-        original_bin = bin_ids[depth]
-        for a, b in best_pairs:
-            counts[a] -= 1
-            counts[b] -= 1
-            chosen[original_bin] = (a, b)
-            if dfs(depth + 1):
-                return True
-            counts[a] += 1
-            counts[b] += 1
-            if cutoff:
-                break
-        capacities[depth], capacities[best_at] = capacities[best_at], capacities[depth]
-        bin_ids[depth], bin_ids[best_at] = bin_ids[best_at], bin_ids[depth]
-        return False
-
-    solved = dfs(0)
-    candidate = _ids_from_weight_pairs(inst, chosen) if solved else None
-    return candidate, {"nodes": nodes, "cutoff": cutoff}
-
-
-def _answer_atoms(value):
-    if isinstance(value, dict):
-        return sum(_answer_atoms(v) for v in value.values())
-    if isinstance(value, list):
-        return sum(_answer_atoms(v) for v in value)
-    return 1
-
-
-def _relabel_instance(inst, rng, reorder_items=False, reorder_bins=False):
-    n = inst["n"]
-    item_order = list(range(2 * n))
-    bin_order = list(range(n))
-    if reorder_items:
-        rng.shuffle(item_order)
-    if reorder_bins:
-        rng.shuffle(bin_order)
-    old_to_new = [0] * (2 * n)
-    for new, old in enumerate(item_order):
-        old_to_new[old] = new
-    answer = [
-        sorted(old_to_new[item_id] for item_id in inst["answer"][old_bin])
-        for old_bin in bin_order
-    ]
-    capacities = [inst["capacities"][old] for old in bin_order]
-    out = {
-        "paper": inst.get("paper"),
-        "family": inst.get("family"),
-        "n": n,
-        "seed": inst.get("seed"),
-        "item_weights": [inst["item_weights"][old] for old in item_order],
-        "item_profits": [inst["item_profits"][old] for old in item_order],
-        "capacities": capacities,
-        "target_profit": inst["target_profit"],
-        "rn3dm_t": inst["rn3dm_t"],
-        "rn3dm_u": [inst["rn3dm_t"] - c for c in capacities],
-        "answer": answer,
-    }
-    return out
-
-
-def _capacity_breaking_swap(inst):
-    answer = [bundle[:] for bundle in inst["answer"]]
-    weights = inst["item_weights"]
-    for j in range(inst["n"]):
-        for k in range(j + 1, inst["n"]):
-            for x in (0, 1):
-                for y in (0, 1):
-                    bad = [bundle[:] for bundle in answer]
-                    bad[j][x], bad[k][y] = bad[k][y], bad[j][x]
-                    if (weights[bad[j][0]] + weights[bad[j][1]]
-                            > inst["capacities"][j]):
-                        return bad
-                    if (weights[bad[k][0]] + weights[bad[k][1]]
-                            > inst["capacities"][k]):
-                        return bad
-    raise AssertionError("no capacity-breaking cross-bin swap found")
-
-
-def selftest():
-    report = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
-
-    planted_ok = json_ok = attempts = 0
-    for _name, params in DIFFICULTY.items():
-        for seed in (0, 1, 7):
-            inst = make_instance(seed=seed, **params)
-            attempts += 1
-            planted_ok += int(verify(inst, inst["answer"])[0])
-            json_ok += int(json.loads(json.dumps(inst["answer"])) == inst["answer"])
-    report["G1_planted_verifies"] = {
-        "pass": planted_ok == attempts and json_ok == attempts,
-        "verified": planted_ok,
-        "attempts": attempts,
-        "json_native_roundtrips": json_ok,
-    }
-
-    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
-    inst = make_instance(seed=424242, **shipping)
-    answer = inst["answer"]
-    corruptions = {
-        "drop": [answer[0][:-1]] + [b[:] for b in answer[1:]],
-        "swap": _capacity_breaking_swap(inst),
-        "duplicate": [[answer[0][0], answer[0][0]]] + [b[:] for b in answer[1:]],
-        "empty": [],
-        "out_of_range": [[2 * inst["n"], answer[0][1]]] + [b[:] for b in answer[1:]],
-    }
-    rejected = {}
-    for name, candidate in corruptions.items():
-        ok, reason = verify(inst, candidate)
-        rejected[name] = {"rejected": not ok, "reason": reason}
-    reasons = [row["reason"] for row in rejected.values()]
-    report["G2_rejects_corruption"] = {
-        "pass": all(row["rejected"] for row in rejected.values())
-        and len(set(reasons)) == len(reasons),
-        "cases": rejected,
-        "distinct_reasons": len(set(reasons)),
-    }
-
-    realistic = (
-        "The total-weight equality makes each chosen pair exact.\n"
-        "```json\n<answer>" + json.dumps(answer, separators=(",", ":"))
-        + "</answer>\n```\n"
-    )
-    parsed = parse_answer(realistic)
-    report["G3_round_trip"] = {
-        "pass": parsed == answer and parse_answer("no tagged answer") is None,
-        "realistic_response": parsed == answer,
-        "garbage_returns_none": parse_answer("no tagged answer") is None,
-    }
-
-    guess_rng = random.Random(90210)
-    guess_total = 200_000
-    guess_hits = 0
-    t0 = time.perf_counter()
-    for _ in range(guess_total):
-        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
-    guess_seconds = time.perf_counter() - t0
-    guess_fraction = guess_hits / guess_total
-    report["G4_guess_resistance"] = {
-        "pass": guess_fraction < 1e-6,
-        "hits": guess_hits,
-        "total": guess_total,
-        "observed_probability": guess_fraction,
-        "candidate_space": search_space(inst),
-        "wall_clock_sec": round(guess_seconds, 6),
-        "structure_aware_prior": (
-            "uniform allocations using every distinct item exactly once, with "
-            "two items in each indexed knapsack"
-        ),
-    }
-
-    panel_seeds = list(range(8))
-    attack_names = [
-        "outlier_input_order",
-        "greedy_balanced_pair",
-        "random_restart_64",
-        "exact_cover_mrv_200000",
-    ]
-    attacks = {
-        name: {"successes": 0, "attempts": len(panel_seeds)}
-        for name in attack_names
-    }
-    exact_nodes = []
-    exact_times = []
-    random_nodes = []
-    for seed in panel_seeds:
-        z = make_instance(seed=seed, **shipping)
-        candidates = {
-            "outlier_input_order": _input_order_attack(z),
-            "greedy_balanced_pair": _greedy_weights(
-                z, pair_order="balanced", choose_mrv=True
-            ),
-        }
-        random_candidate_answer, random_metrics = _random_restart_attack(
-            z, random.Random(seed ^ 0xBAD5EED), restarts=64
-        )
-        candidates["random_restart_64"] = random_candidate_answer
-        random_nodes.append(random_metrics["nodes"])
-
-        exact_start = time.perf_counter()
-        exact_answer, exact_metrics = _exact_cover_mrv(z, node_budget=200_000)
-        exact_times.append(time.perf_counter() - exact_start)
-        exact_nodes.append(exact_metrics["nodes"])
-        candidates["exact_cover_mrv_200000"] = exact_answer
-
-        for name, candidate in candidates.items():
-            attacks[name]["successes"] += int(verify(z, candidate)[0])
-
-    all_failed = all(row["successes"] == 0 for row in attacks.values())
-    baseline_seconds = sum(exact_times)
-    baseline_nodes = sum(exact_nodes)
-    report["G6_adversary_panel"] = {
-        "pass": all_failed,
-        "attacks": attacks,
-        "domain_standard_attack": {
-            "name": "MRV exact-cover depth-first search",
-            "node_budget_per_instance": 200_000,
-            "nodes_total": baseline_nodes,
-            "median_nodes": int(statistics.median(exact_nodes)),
-            "wall_clock_sec_total": round(baseline_seconds, 6),
-            "median_wall_clock_sec": round(statistics.median(exact_times), 6),
-        },
-        "random_restart_nodes_total": sum(random_nodes),
-    }
-
-    demo = make_instance(seed=3, **DIFFICULTY["demo"])
-    report["G5_density_and_baseline"] = {
-        "pass": guess_fraction < 1e-6 and all_failed and baseline_nodes > 0,
-        "shipping_density_hits": guess_hits,
-        "shipping_density_samples": guess_total,
-        "shipping_density_fraction": guess_fraction,
-        "baseline_wall_clock_seconds": round(baseline_seconds, 6),
-        "baseline_nodes": baseline_nodes,
-        "baseline_node_budget_per_instance": 200_000,
-        "demo_exact_valid_solutions": enumerate_all(demo),
-        "demo_n": demo["n"],
-    }
-
-    doubled = make_instance(n=2 * shipping["n"], seed=31337)
-    doubled_ok = verify(doubled, doubled["answer"])[0]
-    report["G7_scales"] = {
-        "pass": doubled_ok,
-        "shipping_n": shipping["n"],
-        "doubled_n": doubled["n"],
-        "doubled_verifies": doubled_ok,
-        "escalate_from_shipping": escalate(shipping),
-    }
-
-    invariant_ok = preserving_ok = 0
-    unrelated_keys = []
-    key_params = DIFFICULTY["easy"]
-    for seed in range(20):
-        z = make_instance(seed=20_000 + seed, **key_params)
-        key = canonical_key(z)
-        unrelated_keys.append(key)
-        rng = random.Random(30_000 + seed)
-        variants = [
-            _relabel_instance(z, rng, reorder_items=True),
-            _relabel_instance(z, rng, reorder_bins=True),
-            _relabel_instance(z, rng, reorder_items=True, reorder_bins=True),
-        ]
-        for variant in variants:
-            invariant_ok += int(canonical_key(variant) == key)
-            preserving_ok += int(verify(variant, variant["answer"])[0])
-    report["G8_canonical_key"] = {
-        "pass": invariant_ok == 60 and preserving_ok == 60
-        and len(set(unrelated_keys)) == 20,
-        "invariance_passed": invariant_ok,
-        "invariance_attempts": 60,
-        "transform_preservation_passed": preserving_ok,
-        "transform_preservation_attempts": 60,
-        "distinct_keys": len(set(unrelated_keys)),
-        "unrelated_instances": 20,
-        "invariant": "item (weight,profit) multiset plus capacity multiset",
-    }
-
-    blob = json.dumps(answer, separators=(",", ":"))
-    elements = _answer_atoms(answer)
-    tokens = math.ceil(len(blob) / 4)
-    # After the saturation observation, checking the n exact pair sums takes one
-    # addition and one equality comparison per knapsack.
-    intended_operations = 2 * inst["n"]
-    oracle = G9_ORACLE_RESULTS
-    hinted_attempts = oracle["hinted"]["attempts"]
-    hinted_hardened = (
-        hinted_attempts >= 3 and oracle["hinted"]["solved"] == 0
-        and oracle["hinted_verdict"] == "hardened"
-    )
-    within_caps = (
-        len(blob) <= 2000 and elements <= 256
-        and intended_operations <= 300
-    )
-    placebo_rate = (
-        oracle["placebo"]["solved"] / oracle["placebo"]["attempts"]
-        if oracle["placebo"]["attempts"] else None
-    )
-    hinted_rate = (
-        oracle["hinted"]["solved"] / oracle["hinted"]["attempts"]
-        if oracle["hinted"]["attempts"] else None
-    )
-    delta = (
-        hinted_rate - placebo_rate
-        if hinted_rate is not None and placebo_rate is not None else None
-    )
-    report["G9_no_tool_suitability"] = {
-        "pass": hinted_hardened and within_caps,
-        "arms": {
-            "bare": dict(oracle["bare"]),
-            "hinted": dict(oracle["hinted"]),
-            "placebo": dict(oracle["placebo"]),
-        },
-        "hinted_minus_placebo": delta,
-        "hinted_verdict": oracle["hinted_verdict"],
-        "answer_chars": len(blob),
-        "answer_tokens": tokens,
-        "answer_elements": elements,
-        "intended_route_operations": intended_operations,
-        "caps": {"chars": 2000, "elements": 256, "operations": 300},
-        "size_and_effort_caps_pass": within_caps,
-    }
-
-    report["all_passed"] = all(
-        isinstance(value, dict) and value.get("pass")
-        for key, value in report.items()
-        if key.startswith("G") and key[1:2].isdigit()
-    )
-    return report
-
