import random,time

def caps(n,seed):
 r=random.Random(seed);x=list(range(1,n+1));r.shuffle(x);return [x[j]+x[(j+1)%n] for j in range(n)]
def solve(caps0,n,limit=2000000):
 caps=caps0[:];cnt=[0]+[2]*n;nodes=0;cut=False
 def cand(c):
  return [(a,c-a) for a in range(max(1,c-n),c//2+1) if c-a<=n and ((a"'!=c-a and cnt[a] and cnt[c-a]) or (a==c-a and cnt[a]>=2))]
 def rec(d):
  nonlocal nodes,cut
  nodes+=1
  if nodes>limit:cut=True;return False
  if d==n:return True
  best=None;bk=None
  for k in range(d,n):
   cc=cand(caps[k])
   if not cc:return False
   if best is None or len(cc)<len(best):best,bk=cc,k
  caps[d],caps[bk]=caps[bk],caps[d]
  for a,b in best:
   cnt[a]-=1;cnt[b]-=1
   if rec(d+1):return True
   cnt[a]+=1;cnt[b]+=1
   if cut:break
  caps[d],caps[bk]=caps[bk],caps[d]
  return False
 t=time.perf_counter();ok=rec(0);return ok,nodes,time.perf_counter()-t
for s in range(8):
 ok,k,t=solve(caps(127,s),127);print(s,ok,k,round(t,3),flush=True)
