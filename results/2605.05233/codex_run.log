+
+    all_failed = all(row["successes"] == 0 for row in attacks.values())
+    baseline_seconds = sum(exact_times)
+    baseline_nodes = sum(exact_nodes)
+    report["G6_adversary_panel"] = {
+        "pass": all_failed,
+        "attacks": attacks,
+        "domain_standard_attack": {
+            "name": "MRV exact-cover depth-first search",
+            "node_budget_per_instance": 200_000,
+            "nodes_total": baseline_nodes,
