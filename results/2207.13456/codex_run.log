+        "easy_space_bits": search_space(easy).bit_length(),
+        "easy_reference_operations": easy_operations,
+        "easy_reference_wall_clock_sec": round(easy_wall, 6),
+        "shipping_n": ship["k"],
+        "shipping_space_bits": search_space(ship).bit_length(),
