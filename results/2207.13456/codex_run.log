+      "chars": 2000,
+      "elements": 256,
+      "operations": 300
+    },
+    "diagnostic_complete": true,
+    "hinted_minus_placebo": 0.6666666666666666,
+    "hinted_verdict": "too_easy",
+    "intended_route_operations": 160,
+    "pass": true,
+    "within_caps": true
+  },
+  "all_passed": true
+}

