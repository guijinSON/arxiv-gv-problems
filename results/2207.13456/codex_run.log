+        "strongest_failing_attack": "random_restart_256",
+        "failing_attack_candidates": attacks["random_restart_256"]["candidates"],
+        "whole_panel_wall_clock_sec": round(attack_total_wall, 6),
+    }
+
+    # G7: operation-count growth, search-space growth, and a literal doubled-n
+    # instance that still builds and verifies.
+    easy = make_instance(seed=771, **DIFFICULTY["easy"])
+    easy_started = time.perf_counter()
+    easy_reference, easy_operations = _prony_reference(easy)
+    easy_wall = time.perf_counter() - easy_started
+    doubled = make_instance(n=160, p=9601, zeta=6, seed=771)
