+    }
+
+    # G8: affine chart changes, global tensor scaling, support reordering, and
+    # compositions are real symmetries.  Coefficients are carried with points.
+    invariant_checks = 0
+    carried_checks = 0
+    key_failures = []
+    unrelated_keys = []
