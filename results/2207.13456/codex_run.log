+        "One JSON object {\"support\":[a_1,...,a_k]} containing exactly k "
+        "distinct residues in 0,...,p-1; order is immaterial and the support "
+        "denotes the Veronese points (1,a,...,a^(2k-1))."
+    ),
+    "bounds": {
+        "support_size": "k",
+        "entry_range": "0 <= a < p",
+        "all_distinct": True,
+        "candidate_count": "binomial(p,k)",
