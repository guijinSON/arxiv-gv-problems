import math,random,time

def factors(n):
 r=[];d=2
 while d*d<=n:
  if n%d==0:
   r.append(d)
   while n%d==0:n//=d
  d+=1
 if n>1:r.append(n)
 return r

def proot(p):
 fs=factors(p-1)
 return next(g for g in range(2,p) if all(pow(g,(p-1)//q,p)"'!=1 for q in fs))

def make(p,d,seed):
 rng=random.Random(seed); g=proot(p); half=(p-1)//2
 reps=[e for e in range(1,half+1,2) if e != half] # represents ± pair, but if half even? select odd e and inverse
 # actually inverse of e could also be <=half; representative min(e,N-e); odds 1..half excluding self
 rng.shuffle(reps); chosen=reps[:d//2]
 exps=[]
 for e in chosen:exps.extend([e,(p-1-e)%(p-1)])
 M=[pow(g,e,p) for e in exps]
 b=rng.randrange(p)
 verts=[y for y in range(p) if y!=b]
 ix={y:i for i,y in enumerate(verts)}; adj=[0]*len(verts); edges=set()
 for y in verts:
  x=(y-b)%p
  for m in M:
   z=(b+m*x)%p
   if y!=z:edges.add(tuple(sorted((y,z))))
 for u,v in edges:
  ui=ix[u];vi=ix[v]; adj[ui]|=1<<vi;adj[vi]|=1<<ui
 return b,M,verts,adj,edges

def indep(adj,ids):
 bits=0
 for i in ids:
  if adj[i]&bits:return False
  bits|=1<<i
 return True

def greedy(adj,rng=None):
 avail=(1<<len(adj))-1;sel=[]
 while avail:
  vals=[];bb=avail
  while bb:
   lo=bb&-bb;v=lo.bit_length()-1
   vals.append(((adj[v]&avail).bit_count(),rng.random() if rng else v,v));bb''^=lo
  v=min(vals)[2];sel.append(v);avail &= ~(1<<v);avail &= ~adj[v]
 return sel
for p,d in [(59,10),(127,20),(251,64)]:
 print('"'PARAM',p,d,'root',proot(p))
