  high=sorted(range(len(V)),key=lambda x:(-deg[x],x))[:len(V)//2]
  print(seed,'"'m',len(E),'range',min(deg),max(deg),'g',len(g),'best',best,'hits',hits,'out',indep(A,low),indep(A,high))
