+NOTES = r"""
+Paper definition and certificate algorithm.  Section 1 defines elimination of
+an internal DAG vertex: delete it and add every missing arc from an in-neighbor
+to an out-neighbor; its Markowitz cost is indegree times outdegree.  Structural
+Optimal Jacobian Accumulation asks for a permutation of all internal vertices
+whose summed cost is at most k.  Section 3, Theorem 1 proves NP-completeness by
+mapping each Vertex Cover vertex v to five DAG vertices v1,...,v5.  Its forward
+proof gives exactly the four-phase sequence implemented by _compile_sequence.
+The checker does not merely cite that proof: it constructs the DAG and replays
+every arc update and integer cost.
+
+Step-0 easy cases.  Proposition 4 gives an O(2^n n^4) dynamic program (and an
+O(4^n n^3) polynomial-space variant), not a polynomial certificate producer.
+Proposition 2 says false twins may be consecutive, so the generated source
+graphs are relabelled regular graphs and the corresponding internal gadgets are
+not coalesced into large false-twin classes.  The witness-producing operation
+is theorem-backed construction from a cover sampled before the graph, not the
+paper's exponential solver and not a solution of the generated instance.
+
+Generation.  Before any edges exist, choose an independent set W and let its
+complement C be the known cover.  Give every vertex the same total degree d.
+All W stubs go to C; C vertices receive balanced cross degrees, and a randomized
+degree-preserving graph realizes the residual C degrees.  Uniformly relabel all
+vertices.  Planted and nonplanted vertices therefore share the exact same
+degree and label distribution; the unavoidable higher-order planted structure
+is what the spectral and local-cycle attacks explicitly probe.  The final
+source graph is transformed by the paper's central reduction, with C carried
+to the four-phase sequence.  No search is performed while generating.
+
+Attacks.  selftest tests a local cycle-statistic outlier, deterministic greedy
+independent set, 256 randomized greedy restarts, a smallest-eigenvector power
+iteration, and standard exact include/exclude branch-and-bound with a greedy
+matching bound.  Track A ships only if all attacks fail on eight seeds.  The
+exact attack's node and wall-clock budgets are reported rather than hidden.
+
+Canonicalization.  General regular-graph isomorphism is not solved here.  The key
+uses exact closed-walk traces through length eight, plus the graph parameters;
+these are invariant under vertex relabelling and edge ordering and distinguish
+all unrelated instances in the required tests.  Collisions remain possible
+and are disclosed in README.md.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 250_000
+_EXACT_NODE_LIMIT = 10_000
+
+
+def _popcount(value: int) -> int:
+    """Python-3.7-compatible population count."""
+
+    return bin(value).count("1")
+
+
+def _validate_parameters(n: int, independent_size: int, degree: int) -> None:
+    if type(n) is not int or n < 12 or n > 1000:
+        raise ValueError("n must be an integer in [12, 1000]")
+    if type(independent_size) is not int:
+        raise ValueError("independent_size must be an integer")
+    if not (n // 6 <= independent_size < n // 2):
+        raise ValueError("independent_size must lie in [n/6,n/2)")
+    if type(degree) is not int or not (3 <= degree < n - independent_size):
+        raise ValueError("degree must be an integer in [3,n-independent_size)")
+    residual = degree * (n - 2 * independent_size)
+    if residual < 0 or residual % 2:
+        raise ValueError("degree*(n-2*independent_size) must be even")
+
+
+def _weighted_choice(
+    rng: random.Random, candidates: list[int], weights: list[int]
+) -> int:
+    total = sum(weights)
+    point = rng.randrange(total)
+    for candidate, weight in zip(candidates, weights):
+        if point < weight:
+            return candidate
+        point -= weight
+    raise AssertionError("weighted choice fell through")
+
+
+def _randomized_havel_hakimi(
+    vertices: list[int], degrees: dict[int, int], rng: random.Random
+) -> set[tuple[int, int]] | None:
+    """Realize a simple degree sequence, then randomize by edge switches."""
+
+    remaining = dict(degrees)
+    edges: set[tuple[int, int]] = set()
+    while True:
+        positive = [v for v in vertices if remaining[v] > 0]
+        if not positive:
+            break
+        maximum = max(remaining[v] for v in positive)
+        tied = [v for v in positive if remaining[v] == maximum]
+        u = rng.choice(tied)
+        need = remaining[u]
+        candidates = [v for v in positive if v != u and tuple(sorted((u, v))) not in edges]
+        if len(candidates) < need:
+            return None
+        rng.shuffle(candidates)
+        candidates.sort(key=lambda v: remaining[v], reverse=True)
+        chosen = candidates[:need]
+        remaining[u] = 0
+        for v in chosen:
+            if remaining[v] <= 0:
+                return None
+            remaining[v] -= 1
+            edges.add(tuple(sorted((u, v))))
+    if any(remaining.values()):
+        return None
+
+    # Degree-preserving 2-switches remove most Havel-Hakimi ordering signal.
+    edge_list = list(edges)
+    for _ in range(max(100, 30 * len(edge_list))):
+        i, j = rng.sample(range(len(edge_list)), 2)
+        a, b = edge_list[i]
+        c, d = edge_list[j]
+        if rng.randrange(2):
+            c, d = d, c
+        if len({a, b, c, d}) < 4:
+            continue
+        old1, old2 = tuple(sorted((a, b))), tuple(sorted((c, d)))
+        new1, new2 = tuple(sorted((a, d))), tuple(sorted((c, b)))
+        if new1 == new2 or new1 in edges or new2 in edges:
+            continue
+        edges.remove(old1)
+        edges.remove(old2)
+        edges.add(new1)
+        edges.add(new2)
+        edge_list[i], edge_list[j] = new1, new2
+    return edges
+
+
+def _sample_regular_with_independent_set(
+    n: int, independent_size: int, degree: int, rng: random.Random
+) -> tuple[list[list[int]], list[int]]:
+    """Build a simple regular graph around a preselected independent set W.
+
+    Vertices are initially 0..s-1 (W) and s..n-1 (C).  The final random
+    relabelling erases that temporary construction order.
+    """
+
+    s = independent_size
+    c_vertices = list(range(s, n))
+    c_count = n - s
+    cross_total = degree * s
+    cross_floor, cross_extra = divmod(cross_total, c_count)
+    if cross_floor < 1 or cross_floor + int(bool(cross_extra)) >= degree:
+        raise ValueError("parameters do not admit balanced cross degrees")
+
+    for _attempt in range(20_000):
+        # Cross degrees differ by at most one and are assigned randomly in C.
+        cover_order = c_vertices[:]
+        rng.shuffle(cover_order)
+        cross_degree = {v: cross_floor for v in c_vertices}
+        for v in cover_order[:cross_extra]:
+            cross_degree[v] += 1
+        capacity = dict(cross_degree)
+        cross_pairs: list[tuple[int, int]] = []
+        good = True
+        w_order = list(range(s))
+        rng.shuffle(w_order)
+        for w in w_order:
+            chosen: set[int] = set()
+            for _ in range(degree):
+                candidates = [v for v in c_vertices if capacity[v] > 0 and v not in chosen]
+                if not candidates:
+                    good = False
+                    break
+                v = _weighted_choice(rng, candidates, [capacity[x] for x in candidates])
+                chosen.add(v)
+                capacity[v] -= 1
+                cross_pairs.append((w, v))
+            if not good:
+                break
+        if not good or any(capacity.values()):
+            continue
+        neighbors: list[set[int]] = [set() for _ in range(n)]
+        for u, v in cross_pairs:
+            neighbors[u].add(v)
+            neighbors[v].add(u)
+
+        residual_degrees = {v: degree - cross_degree[v] for v in c_vertices}
+        internal_edges = _randomized_havel_hakimi(c_vertices, residual_degrees, rng)
+        if internal_edges is None:
+            continue
+        for u, v in internal_edges:
+            neighbors[u].add(v)
+            neighbors[v].add(u)
+        if any(len(neighbors[v]) != degree for v in range(n)):
+            continue
+
+        # Randomize labels only after both planted and nonplanted vertices have
+        # been assembled; the public instance stores no role bit.
+        permutation = list(range(n))
+        rng.shuffle(permutation)
+        edges = {
+            tuple(sorted((permutation[u] + 1, permutation[v] + 1)))
+            for u in range(n)
+            for v in neighbors[u]
+            if u < v
+        }
+        if len(edges) != degree * n // 2:
+            continue
+        answer = sorted(permutation[v] + 1 for v in range(s, n))
+        edge_rows = [list(edge) for edge in edges]
+        rng.shuffle(edge_rows)
+        return edge_rows, answer
+    raise RuntimeError("could not sample a simple cubic planted graph")
+
+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    *,
+    independent_size: int,
+    degree: int,
+    **params: Any,
+) -> dict:
+    """Construct a theorem-backed SOJA instance without solving it."""
+
+    if params:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(params)))
+    _validate_parameters(n, independent_size, degree)
+    if type(seed) is not int:
+        raise ValueError("seed must be an integer")
+    rng = random.Random(seed)
+    edges, cover = _sample_regular_with_independent_set(
+        n, independent_size, degree, rng
+    )
+    cover_size = n - independent_size
+    source_edge_count = len(edges)
+    threshold = 6 * source_edge_count + 4 * n + cover_size
+    return {
+        "family": "Structural Optimal Jacobian Accumulation via Theorem 1",
+        "n": n,
+        "source_edges": edges,
+        "source_edge_count": source_edge_count,
+        "cover_size": cover_size,
+        "independent_size": independent_size,
+        "degree": degree,
+        "dag_vertex_count": 5 * n,
+        "dag_internal_count": 2 * n,
+        "cost_threshold": threshold,
+        "answer": cover,
+    }
+
+
+def render(inst: dict) -> str:
+    """Return the complete solver-facing statement and exact output grammar."""
+
+    edge_rows = sorted(tuple(edge) for edge in inst["source_edges"])
+    edge_text = "\n".join(f"{u} {v}" for u, v in edge_rows)
+    k = inst["cover_size"]
+    n = inst["n"]
+    example = ", ".join(str(i) for i in range(1, k + 1))
+    statement = f"""STRUCTURAL OPTIMAL JACOBIAN ACCUMULATION — COVER MACRO
+
+The source data below define both an undirected graph G and a directed acyclic
+computational graph D.  G has vertices 1,...,{n}.  Each listed row "u v" is
+one undirected edge {{u,v}}; there are no loops or repeated edges.
+
+For completeness, D is defined exactly as follows.  For each source vertex v,
+create five DAG vertices v.1,v.2,v.3,v.4,v.5.  Vertices v.2 and v.3 are
+internal; v.1,v.4,v.5 are terminals.  Add these six arcs for every v:
+
+    v.1->v.2, v.2->v.3, v.2->v.4,
+    v.2->v.5, v.3->v.4, v.3->v.5.
+
+For every undirected edge {{u,v}} of G, add four more arcs:
+
+    u.1->v.3, u.2->v.3, v.1->u.3, v.2->u.3.
+
+Eliminating an internal DAG vertex x deletes x and all incident arcs, then adds
+every missing arc p->q where p was an in-neighbor and q was an out-neighbor of
+x.  The cost of that elimination is (number of in-neighbors) times (number of
+out-neighbors), measured immediately before deletion.  A total elimination
+sequence eliminates each of the {2*n} internal vertices exactly once; its cost
+is the sum of the individual costs.  The required cost is at most
+{inst['cost_threshold']}.
+
+Use this bounded cover macro for the witness.  Give exactly {k} distinct source
+vertex IDs forming a vertex cover of G: every listed edge must have at least
+one endpoint in your set.  Order does not matter, IDs are 1-indexed integers in
+the inclusive range 1..{n}, and repeats are forbidden.  The checker sorts your
+set C and expands it to this total elimination sequence (each phase is sorted):
+
+    phase 1: v.2 for v in C;
+    phase 2: v.3 for v not in C;
+    phase 3: v.2 for v not in C;
+    phase 4: v.3 for v in C.
+
+It then constructs D and replays all eliminations exactly.  Thus the requested
+object is a compact, deterministic encoding of a concrete total elimination
+sequence, not a request for a numerical optimum.
+
+SOURCE EDGES (one row: u v)
+{edge_text}
+
+Give your final answer inside <answer></answer> tags, as a comma-separated list
+of exactly {k} distinct vertex IDs.
+Example: <answer>{example}</answer>
+The example shows syntax only and is not necessarily a cover.
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the last tagged integer list, tolerating prose and fences."""
+
+    if not isinstance(text, str):
+        return None
+    for raw in reversed(_ANSWER_RE.findall(text)):
+        body = raw.strip()
+        fence = re.fullmatch(r"```(?:json|text)?\s*(.*?)\s*```", body, re.I | re.S)
+        if fence:
+            body = fence.group(1).strip()
+        if body.startswith("[") and body.endswith("]"):
+            try:
+                value = json.loads(body)
+            except (TypeError, ValueError):
+                continue
+            if isinstance(value, list) and all(type(x) is int for x in value):
+                return value
+            continue
+        if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
+            continue
+        try:
+            return [int(piece.strip()) for piece in body.split(",")]
+        except ValueError:
+            continue
+    return None
+
+
+def _normalized_edges(inst: dict) -> list[tuple[int, int]]:
+    return sorted(tuple(sorted(edge)) for edge in inst["source_edges"])
+
+
+def _compile_sequence(inst: dict, cover: set[int]) -> list[int]:
+    """Compile a cover to zero-based internal DAG vertex indices."""
+
+    selected = sorted(cover)
+    outside = [v for v in range(1, inst["n"] + 1) if v not in cover]
+
+    def dag_index(v: int, local: int) -> int:
+        return 5 * (v - 1) + (local - 1)
+
+    return (
+        [dag_index(v, 2) for v in selected]
+        + [dag_index(v, 3) for v in outside]
+        + [dag_index(v, 2) for v in outside]
+        + [dag_index(v, 3) for v in selected]
+    )
+
+
+def _build_dag(inst: dict) -> tuple[list[int], list[int]]:
+    """Return exact incoming/outgoing bitsets for the paper's DAG gadget."""
+
+    total = 5 * inst["n"]
+    incoming = [0] * total
+    outgoing = [0] * total
+
+    def index(v: int, local: int) -> int:
+        return 5 * (v - 1) + (local - 1)
+
+    def add(u: int, v: int) -> None:
+        outgoing[u] |= 1 << v
+        incoming[v] |= 1 << u
+
+    for v in range(1, inst["n"] + 1):
+        v1, v2, v3, v4, v5 = (index(v, j) for j in range(1, 6))
+        add(v1, v2)
+        add(v2, v3)
+        add(v2, v4)
+        add(v2, v5)
+        add(v3, v4)
+        add(v3, v5)
+    for u, v in _normalized_edges(inst):
+        add(index(u, 1), index(v, 3))
+        add(index(u, 2), index(v, 3))
+        add(index(v, 1), index(u, 3))
+        add(index(v, 2), index(u, 3))
+    return incoming, outgoing
+
+
+def _replay_cost(inst: dict, sequence: list[int]) -> tuple[int, str]:
+    incoming, outgoing = _build_dag(inst)
+    total_vertices = len(incoming)
+    active = (1 << total_vertices) - 1
+    cost = 0
+    for step, vertex in enumerate(sequence):
+        if vertex < 0 or vertex >= total_vertices or not ((active >> vertex) & 1):
+            return cost, f"compiled sequence repeats or mislabels a vertex at step {step}"
+        preds = incoming[vertex] & active
+        succs = outgoing[vertex] & active
+        cost += _popcount(preds) * _popcount(succs)
+
+        bits = preds
+        while bits:
+            low = bits & -bits
+            p = low.bit_length() - 1
+            new_succs = succs & ~outgoing[p]
+            outgoing[p] |= succs
+            qbits = new_succs
+            while qbits:
+                qlow = qbits & -qbits
+                q = qlow.bit_length() - 1
+                incoming[q] |= 1 << p
+                qbits ^= qlow
+            outgoing[p] &= ~(1 << vertex)
+            bits ^= low
+        bits = succs
+        while bits:
+            low = bits & -bits
+            q = low.bit_length() - 1
+            incoming[q] &= ~(1 << vertex)
+            bits ^= low
+        incoming[vertex] = 0
+        outgoing[vertex] = 0
+        active &= ~(1 << vertex)
+    return cost, "ok"
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Inspect only the public instance and candidate, then replay the DAG."""
+
+    if not isinstance(answer, list):
+        return False, "answer must be a list of vertex IDs"
+    if not answer:
+        return False, "answer is empty"
+    if any(type(v) is not int for v in answer):
+        return False, "every vertex ID must be an integer"
+    if len(answer) != inst["cover_size"]:
+        return False, f"expected exactly {inst['cover_size']} vertex IDs"
+    if len(set(answer)) != len(answer):
+        return False, "vertex IDs must be distinct"
+    if any(v < 1 or v > inst["n"] for v in answer):
+        return False, f"a vertex ID is outside the inclusive range 1..{inst['n']}"
+    cover = set(answer)
+    for u, v in _normalized_edges(inst):
+        if u not in cover and v not in cover:
+            return False, f"source edge {u}-{v} is uncovered"
+
+    sequence = _compile_sequence(inst, cover)
+    if len(sequence) != inst["dag_internal_count"] or len(set(sequence)) != len(sequence):
+        return False, "cover macro did not compile to every internal vertex exactly once"
+    cost, replay_reason = _replay_cost(inst, sequence)
+    if replay_reason != "ok":
+        return False, replay_reason
+    if cost > inst["cost_threshold"]:
+        return False, (
+            f"compiled elimination cost {cost} exceeds threshold "
+            f"{inst['cost_threshold']}"
+        )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the exact-k subset a statement-aware solver searches."""
+
+    return sorted(rng.sample(range(1, inst["n"] + 1), inst["cover_size"]))
+
+
+def search_space(inst: dict) -> int | None:
+    return math.comb(inst["n"], inst["cover_size"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Count all exact-size cover macros when the subset space is small."""
+
+    if search_space(inst) > _ENUMERATION_CAP:
+        return None
+    count = 0
+    vertices = range(1, inst["n"] + 1)
+    edges = _normalized_edges(inst)
+    for combo in itertools.combinations(vertices, inst["cover_size"]):
+        cover = set(combo)
+        if all(u in cover or v in cover for u, v in edges):
+            count += 1
+    return count
+
+
+def _adjacency_bits(inst: dict) -> list[int]:
+    adjacency = [0] * inst["n"]
+    for u, v in _normalized_edges(inst):
+        u -= 1
+        v -= 1
+        adjacency[u] |= 1 << v
+        adjacency[v] |= 1 << u
+    return adjacency
+
+
+def _closed_walk_traces(inst: dict, max_length: int = 8) -> list[int]:
+    """Exact relabelling invariants trace(A^ell), ell=3..max_length."""
+
+    adjacency = _adjacency_bits(inst)
+    traces = [0] * (max_length + 1)
+    for start in range(inst["n"]):
+        vector = {start: 1}
+        for length in range(1, max_length + 1):
+            nxt: dict[int, int] = {}
+            for vertex, count in vector.items():
+                bits = adjacency[vertex]
+                while bits:
+                    low = bits & -bits
+                    neighbor = low.bit_length() - 1
+                    nxt[neighbor] = nxt.get(neighbor, 0) + count
+                    bits ^= low
+            vector = nxt
+            traces[length] += vector.get(start, 0)
+    return traces[3:]
+
+
+def canonical_key(inst: dict) -> str:
+    """Use strong exact invariants; never include the seed or rendered text."""
+
+    payload = {
+        "n": inst["n"],
+        "m": inst["source_edge_count"],
+        "cover_size": inst["cover_size"],
+        "degree": inst["degree"],
+        "closed_walk_traces_3_through_8": _closed_walk_traces(inst),
+    }
+    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(encoded.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | None:
+    n = params.get("n")
+    s = params.get("independent_size")
+    degree = params.get("degree")
+    if type(n) is not int or type(s) is not int or type(degree) is not int or n >= 480:
+        return None
+    return {"n": n + 60, "independent_size": s + 17, "degree": degree}
+
+
+def _cover_from_independent(inst: dict, independent: list[int]) -> list[int]:
+    chosen = set(independent)
+    return [v for v in range(1, inst["n"] + 1) if v not in chosen]
+
+
+def _independent(inst: dict, vertices: list[int]) -> bool:
+    chosen = set(vertices)
+    return len(chosen) == len(vertices) and all(
+        u not in chosen or v not in chosen for u, v in _normalized_edges(inst)
+    )
+
+
+def _attack_outlier_cycle_score(inst: dict) -> list[int]:
+    """Treat low four-cycle participation as the planted per-vertex signal."""
+
+    adjacency = _adjacency_bits(inst)
+    scores = []
+    for v, bits in enumerate(adjacency):
+        neighbors = [i for i in range(inst["n"]) if (bits >> i) & 1]
+        score = 0
+        for a, b in itertools.combinations(neighbors, 2):
+            score += _popcount(adjacency[a] & adjacency[b]) - 1
+        scores.append((score, v + 1))
+    purported = [v for _score, v in sorted(scores)[: inst["independent_size"]]]
+    return _cover_from_independent(inst, purported)
+
+
+def _greedy_independent(
+    inst: dict, rng: random.Random | None = None
+) -> list[int]:
+    adjacency = _adjacency_bits(inst)
+    available = (1 << inst["n"]) - 1
+    selected: list[int] = []
+    while available:
+        candidates: list[tuple[float, int, int]] = []
+        bits = available
+        while bits:
+            low = bits & -bits
+            v = low.bit_length() - 1
+            degree = _popcount(adjacency[v] & available)
+            tie = rng.random() if rng is not None else float(v)
+            candidates.append((degree, tie, v))
+            bits ^= low
+        _degree, _tie, vertex = min(candidates)
+        selected.append(vertex + 1)
+        available &= ~(1 << vertex)
+        available &= ~adjacency[vertex]
+    return selected
+
+
+def _attack_greedy(inst: dict) -> list[int] | None:
+    independent = _greedy_independent(inst)
+    if len(independent) < inst["independent_size"]:
+        return None
+    return _cover_from_independent(inst, independent[: inst["independent_size"]])
+
+
+def _attack_random_restarts(
+    inst: dict, seed: int, restarts: int = 256
+) -> list[int] | None:
+    rng = random.Random(seed ^ 0x51A7C0DE)
+    target = inst["independent_size"]
+    best: list[int] = []
+    for _ in range(restarts):
+        candidate = _greedy_independent(inst, rng)
+        if len(candidate) > len(best):
+            best = candidate
+        if len(candidate) >= target:
+            subset = sorted(candidate[:target])
+            if _independent(inst, subset):
+                return _cover_from_independent(inst, subset)
+    return None
+
+
+def _attack_spectral(inst: dict) -> list[int] | None:
+    """Power iteration for the smallest adjacency eigenvector, no NumPy."""
+
+    n = inst["n"]
+    adjacency = _adjacency_bits(inst)
+    vector = [math.sin((i + 1) * 1.61803398875) for i in range(n)]
+    mean = sum(vector) / n
+    vector = [x - mean for x in vector]
+    for _ in range(120):
+        # B = dI-A has its largest eigenvalue at the smallest eigenvalue of A.
+        nxt = [0.0] * n
+        for v in range(n):
+            total = float(inst["degree"]) * vector[v]
+            bits = adjacency[v]
+            while bits:
+                low = bits & -bits
+                total -= vector[low.bit_length() - 1]
+                bits ^= low
+            nxt[v] = total
+        norm = math.sqrt(sum(x * x for x in nxt)) or 1.0
+        vector = [x / norm for x in nxt]
+
+    target = inst["independent_size"]
+    for reverse in (False, True):
+        order = sorted(range(n), key=lambda v: vector[v], reverse=reverse)
+        extreme = sorted(v + 1 for v in order[:target])
+        if _independent(inst, extreme):
+            return _cover_from_independent(inst, extreme)
+        greedy: list[int] = []
+        chosen_bits = 0
+        for v in order:
+            if not (adjacency[v] & chosen_bits):
+                greedy.append(v + 1)
+                chosen_bits |= 1 << v
+                if len(greedy) == target:
+                    return _cover_from_independent(inst, sorted(greedy))
+    return None
+
+
+def _greedy_matching_size(adjacency: list[int], available: int) -> int:
+    matching = 0
+    remaining = available
+    while remaining:
+        low = remaining & -remaining
+        v = low.bit_length() - 1
+        partners = adjacency[v] & remaining & ~low
+        if partners:
+            p_low = partners & -partners
+            remaining &= ~p_low
+            matching += 1
+        remaining &= ~low
+    return matching
+
+
+def _attack_exact_branch(
+    inst: dict, node_limit: int = _EXACT_NODE_LIMIT
+) -> tuple[list[int] | None, int, bool]:
+    """Standard exact include/exclude branching for target Independent Set."""
+
+    adjacency = _adjacency_bits(inst)
+    target = inst["independent_size"]
+    all_vertices = (1 << inst["n"]) - 1
+    nodes = 0
+    hit_limit = False
+
+    def search(available: int, selected: list[int]) -> list[int] | None:
+        nonlocal nodes, hit_limit
+        nodes += 1
+        if nodes > node_limit:
+            hit_limit = True
+            return None
+        if len(selected) >= target:
+            return selected[:target]
+        available_count = _popcount(available)
+        if len(selected) + available_count < target:
+            return None
+        # A matching gives a valid lower bound on vertices any cover of the
+        # remaining graph needs, hence an upper bound on the additional IS size.
+        matching_lb = _greedy_matching_size(adjacency, available)
+        if len(selected) + available_count - matching_lb < target:
+            return None
+
+        # A deterministic greedy completion makes this materially stronger than
+        # bare recursion and often solves easy planted instances immediately.
+        greedy_available = available
+        completion: list[int] = []
+        while greedy_available and len(selected) + len(completion) < target:
+            bits = greedy_available
+            best = None
+            while bits:
+                low = bits & -bits
+                v = low.bit_length() - 1
+                degree = _popcount(adjacency[v] & greedy_available)
+                choice = (degree, v)
+                if best is None or choice < best:
+                    best = choice
+                bits ^= low
+            assert best is not None
+            v = best[1]
+            completion.append(v + 1)
+            greedy_available &= ~(1 << v)
+            greedy_available &= ~adjacency[v]
+        if len(selected) + len(completion) >= target:
+            return selected + completion
+
+        # Branch on a maximum-current-degree vertex: include it first, then
+        # exclude it.  Both branches preserve completeness below the node cap.
+        bits = available
+        chosen = -1
+        chosen_degree = -1
+        while bits:
+            low = bits & -bits
+            v = low.bit_length() - 1
+            degree = _popcount(adjacency[v] & available)
+            if degree > chosen_degree:
+                chosen, chosen_degree = v, degree
+            bits ^= low
+        if chosen < 0:
+            return None
+        without_closed = available & ~(1 << chosen) & ~adjacency[chosen]
+        found = search(without_closed, selected + [chosen + 1])
+        if found is not None:
+            return found
+        return search(available & ~(1 << chosen), selected)
+
+    independent = search(all_vertices, [])
+    if independent is None:
+        return None, min(nodes, node_limit), hit_limit
+    independent = sorted(independent[:target])
+    if not _independent(inst, independent):
+        return None, min(nodes, node_limit), hit_limit
+    return _cover_from_independent(inst, independent), min(nodes, node_limit), hit_limit
+
+
+def _relabel_instance(inst: dict, permutation: list[int]) -> dict:
+    """Apply a 1-indexed vertex relabelling and carry the witness through it."""
+
+    transformed = dict(inst)
+    transformed["source_edges"] = [
+        [permutation[u - 1], permutation[v - 1]]
+        for u, v in inst["source_edges"]
+    ]
+    transformed["answer"] = sorted(permutation[v - 1] for v in inst["answer"])
+    return transformed
+
+
+# Filled from the three isolated harden.py runs.  Pending values intentionally
+# keep G9(b), and therefore all_passed, false until real transcripts exist.
+G9_AUDIT = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
+    },
+    "hinted_verdict": "pending",
+}
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return a fully measured, JSON-native report."""
+
+    report: dict[str, Any] = {
+        "paper": "2506.17521",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    g1_failures: list[str] = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 2):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append(f"{preset}/{seed}: {reason}")
+            try:
+                if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                    g1_failures.append(f"{preset}/{seed}: JSON round-trip changed answer")
+            except (TypeError, ValueError) as exc:
+                g1_failures.append(f"{preset}/{seed}: JSON failure {exc}")
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    shipping = make_instance(seed=101, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = shipping["answer"]
+    independent = sorted(set(range(1, shipping["n"] + 1)) - set(planted))
+    replacement_cover_vertex = next(
+        c
+        for c in planted
+        if sum(1 for edge in shipping["source_edges"] if c in edge) >= 2
+    )
+    replacement_independent = next(
+        w
+        for w in independent
+        if all(w not in edge or replacement_cover_vertex not in edge
+               for edge in shipping["source_edges"])
+    )
+    swap_one = planted[:]
+    swap_one[swap_one.index(replacement_cover_vertex)] = replacement_independent
+    corruptions: dict[str, object] = {
+        "drop_one": planted[:-1],
+        "swap_one": swap_one,
+        "duplicate": planted[:-1] + [planted[0]],
+        "empty": [],
+        "out_of_range": planted[:-1] + [shipping["n"] + 1],
+    }
+    reasons: dict[str, str] = {}
+    all_rejected = True
+    for name, candidate in corruptions.items():
+        ok, reason = verify(shipping, candidate)
+        all_rejected &= not ok
+        reasons[name] = reason
+    report["G2_rejects_corruption"] = {
+        "pass": all_rejected and len(set(reasons.values())) == len(reasons),
+        "rejected": sum(reason != "ok" for reason in reasons.values()),
+        "distinct_reasons": len(set(reasons.values())),
+        "reasons": reasons,
+    }
+
+    realistic = (
+        "The complement is independent.\n```text\n<answer>\n"
+        + ", ".join(map(str, planted))
+        + "\n</answer>\n```\nThe macro gives all four phases."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("no tagged witness") is None,
+        "realistic_response_parsed": parsed == planted,
+        "garbage_returns_none": parse_answer("no tagged witness") is None,
+    }
+
+    guess_rng = random.Random(8675309)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_start = time.perf_counter()
+    for _ in range(guess_total):
+        candidate = random_candidate(shipping, guess_rng)
+        # Cover membership is exactly equivalent to verifier success for a
+        # well-shaped macro, and avoids rebuilding a DAG on the vanishingly few
+        # random candidates that pass the graph constraint.
+        candidate_set = set(candidate)
+        if all(
+            u in candidate_set or v in candidate_set
+            for u, v in _normalized_edges(shipping)
+        ):
+            ok, _reason = verify(shipping, candidate)
+            guess_hits += int(ok)
+    guess_elapsed = time.perf_counter() - guess_start
+    report["G4_guess_resistance"] = {
+        "pass": guess_hits / guess_total < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_fraction": guess_hits / guess_total,
+        "structure_aware_space": search_space(shipping),
+        "candidate_prior": "uniform over all exact-cover_size vertex subsets",
+        "elapsed_sec": round(guess_elapsed, 6),
+    }
+
+    baseline_start = time.perf_counter()
+    baseline_answer, baseline_nodes, baseline_limited = _attack_exact_branch(shipping)
+    baseline_wall = time.perf_counter() - baseline_start
+    baseline_success = (
+        baseline_answer is not None and verify(shipping, baseline_answer)[0]
+    )
+    demo = make_instance(seed=101, **DIFFICULTY["demo"])
+    demo_valid = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": guess_hits / guess_total < 1e-6 and not baseline_success,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_sampled_solution_fraction": guess_hits / guess_total,
+        "shipping_exact_solution_count": None,
+        "demo_exact_valid_answers": demo_valid,
+        "demo_candidate_count": search_space(demo),
+        "baseline_name": "exact independent-set include/exclude branch-and-bound",
+        "baseline_wall_clock_sec": round(baseline_wall, 6),
+        "baseline_nodes": baseline_nodes,
+        "baseline_node_limit": _EXACT_NODE_LIMIT,
+        "baseline_hit_limit": baseline_limited,
+        "baseline_success": baseline_success,
+    }
+
+    attack_names = [
+        "outlier_local_cycle_score",
+        "greedy_min_residual_degree",
+        "random_restart_256",
+        "spectral_smallest_eigenvector",
+        "standard_exact_branch_and_bound",
+    ]
+    successes = {name: 0 for name in attack_names}
+    attempts = 8
+    exact_nodes = 0
+    exact_seconds = 0.0
+    exact_limits = 0
+    for seed in range(200, 200 + attempts):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        candidates: dict[str, list[int] | None] = {
+            "outlier_local_cycle_score": _attack_outlier_cycle_score(inst),
+            "greedy_min_residual_degree": _attack_greedy(inst),
+            "random_restart_256": _attack_random_restarts(inst, seed),
+            "spectral_smallest_eigenvector": _attack_spectral(inst),
+        }
+        started = time.perf_counter()
+        exact_candidate, nodes, limited = _attack_exact_branch(inst)
+        exact_seconds += time.perf_counter() - started
+        exact_nodes += nodes
+        exact_limits += int(limited)
+        candidates["standard_exact_branch_and_bound"] = exact_candidate
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(inst, candidate)[0]:
+                successes[name] += 1
+    attacks = {
+        name: {"successes": successes[name], "attempts": attempts}
+        for name in attack_names
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(item["successes"] == 0 for item in attacks.values()),
+        "attacks": attacks,
+        "standard_attack_mean_wall_clock_sec": round(exact_seconds / attempts, 6),
+        "standard_attack_mean_nodes": round(exact_nodes / attempts),
+        "standard_attack_node_limit": _EXACT_NODE_LIMIT,
+        "standard_attack_limits_reached": exact_limits,
+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled_params["independent_size"] *= 2
+    doubled = make_instance(seed=303, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] == 2 * shipping["n"],
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "shipping_candidate_space": search_space(shipping),
+        "doubled_candidate_space": search_space(doubled),
+        "doubled_verification": doubled_reason,
+    }
+
+    invariance_checks = 0
+    preserving_checks = 0
+    g8_failures: list[str] = []
+    unrelated_keys: list[str] = []
+    for seed in range(20):
+        inst = make_instance(seed=1000 + seed, **DIFFICULTY["easy"])
+        key = canonical_key(inst)
+        unrelated_keys.append(key)
+        rng = random.Random(0xCA11 + seed)
+        labels = list(range(1, inst["n"] + 1))
+        rng.shuffle(labels)
+        relabelled = _relabel_instance(inst, labels)
+        reordered = dict(inst)
+        reordered["source_edges"] = [edge[::-1] for edge in reversed(inst["source_edges"])]
+        composed = _relabel_instance(reordered, labels)
+        for index, variant in enumerate((relabelled, reordered, composed)):
+            invariance_checks += 1
+            if canonical_key(variant) != key:
+                g8_failures.append(f"seed {seed} variant {index}: key changed")
+            preserving_checks += 1
+            ok, reason = verify(variant, variant["answer"])
+            if not ok:
+                g8_failures.append(f"seed {seed} variant {index}: {reason}")
+    distinct_count = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures and distinct_count == 20,
+        "invariance_checks": invariance_checks,
+        "preserving_witness_checks": preserving_checks,
+        "distinct_unrelated_keys": distinct_count,
+        "unrelated_instances": 20,
+        "transformations": [
+            "arbitrary vertex relabelling",
+            "edge-row reorder plus endpoint reversal",
+            "their composition",
+        ],
+        "failures": g8_failures,
+    }
+
+    serialized = json.dumps(shipping["answer"], separators=(",", ":"))
+    answer_chars = len(serialized)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = len(shipping["answer"])
+    # The intended insight replaces a 2n-vertex permutation search by taking a
+    # set complement and emitting the macro.  It uses comparisons/set marks,
+    # but no exact arithmetic beyond the n membership/index increments counted.
+    intended_operations = shipping["n"] + 4
+    arms = G9_AUDIT["arms"]
+    hinted_rate = (
+        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
+        if arms["hinted"]["attempts"]
+        else 0.0
+    )
+    placebo_rate = (
+        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
+        if arms["placebo"]["attempts"]
+        else 0.0
+    )
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": G9_AUDIT["hinted_verdict"] == "hardened" and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_AUDIT["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+    }
+
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

