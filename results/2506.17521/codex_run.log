+28->29
+16->25
+12->1
+29->5
+3->15
+22->25
+12->13
+25->0
+24->21
+21->7
+3->17
+16->15
+1->11
+3->9
+28->17
+16->11
+10->17
+1->18
+21->20
+6->15
