+        "graphs with a linear-size hidden cover (so the parameter grows), and "
+        "selftest reports the measured capped-node cost of a standard exact "
+        "branch-and-bound attack on the shipping distribution."
+    ),
+    "max_answer_tokens": 100,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+# In every preset, the source graph is cubic and the planted independent set
+# has size 45% of the vertices.  Thus neither the cover size nor its complement
+# is a fixed parameter.  The construction constraints require 3(n-2s) even.
+DIFFICULTY = {
+    "demo": {"n": 12, "independent_size": 5},
+    "easy": {"n": 80, "independent_size": 36},
+    "medium": {"n": 120, "independent_size": 54},
+    "hard": {"n": 160, "independent_size": 72},
+}
+
+SHIPPING_DIFFICULTY = "hard"
