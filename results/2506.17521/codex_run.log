+def _primitive_root(prime: int) -> int:
+    factors = _prime_factors(prime - 1)
+    for candidate in range(2, prime):
+        if all(
+            pow(candidate, (prime - 1) // factor, prime) != 1
+            for factor in factors
+        ):
+            return candidate
+    raise ValueError("prime has no primitive root")
