+    intended_ops = 2 * ship["n"] + len(ship["label_groups"]) + len(ship["internal"]) // 2
+    # 2q set-translation comparisons + N intercepts + N role placements = 132.
+    arms = {name: dict(G9_ORACLE_RESULTS[name]) for name in ("bare", "hinted", "placebo")}
