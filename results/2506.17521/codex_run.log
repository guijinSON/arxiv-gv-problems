+    "easy": {"n": 11, "degree": 5, "label_decoys": 0},
+    "medium": {"n": 17, "degree": 5, "label_decoys": 1},
+    "hard": {"n": 23, "degree": 5, "label_decoys": 2},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Hint: The coordinate labels of the paired elimination gadgets lie in "
