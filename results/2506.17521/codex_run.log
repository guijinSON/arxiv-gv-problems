+def _prime_factors(value: int) -> list[int]:
+    factors: list[int] = []
+    divisor = 2
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            factors.append(divisor)
+            while value % divisor == 0:
+                value //= divisor
+        divisor += 1
+    if value > 1:
+        factors.append(value)
+    return factors
+
