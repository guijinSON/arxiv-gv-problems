+        ),
+    }
+
+    # G7: double n at fixed degree; certificate language and graph both grow.
+    before = make_instance(n=5, degree=2, label_decoys=0, seed=771)
+    after = make_instance(n=11, degree=2, label_decoys=0, seed=771)
+    g7_ok = (
