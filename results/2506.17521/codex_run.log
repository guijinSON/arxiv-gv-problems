+        "solves": f"{reference_successes}/{len(attack_seeds)}",
+        "paper_generic_algorithm": "Section 5 subset DP, O(2^r r^4)",
+        "paper_generic_shipping_states_lower_bound": 2 ** len(ship["internal"]),
+    }
+    report["G6_adversary_panel"] = {
