 reps=[];seen=set()
 for e in range(1,N,2):
  pair=tuple(sorted((e,N-e)))
  if pair[0]==pair[1] or pair in seen:continue
  seen.add(pair);reps.append(pair[0])
 rng.shuffle(reps); chosen=reps[:d//2]
 exps=[]
 for e in chosen:exps.extend([e,N-e])
 M=[pow(g,e,p) for e in exps];b=rng.randrange(p);V=[y for y in range(p) if y!=b];ix={y:i for i,y in enumerate(V)};A=[0]*len(V);E=set()
 for y in V:
  x=(y-b)%p
  for m in M:E.add(tuple(sorted((y,(b+m*x)%p))))
 for u,v in E:
  ui=ix[u];vi=ix[v];A[ui]|=1<<vi;A[vi]|=1<<ui
 return b,M,V,A,E
