+        v1, v2, v3, v4, v5 = (index(v, j) for j in range(1, 6))
+        add(v1, v2)
+        add(v2, v3)
+        add(v2, v4)
+        add(v2, v5)
+        add(v3, v4)
+        add(v3, v5)
