+    gates = [v for k, v in report.items() if k.startswith("G") and isinstance(v, dict)]
+    report["all_passed"] = all(g.get("pass") is True for g in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

