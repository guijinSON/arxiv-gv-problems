import random
pc=lambda x:bin(x).count('1')
def make(p,avg,seed):
 rng=random.Random(seed);b=rng.randrange(p);W=list({(b+x*x)%p for x in range(1,(p+1)//2)});W.sort();C=[x for x in range(p) if x"'!=b and x not in set(W)];rng.shuffle(W);rng.shuffle(C);E=set();h=len(W)
 # alternating Hamiltonian cycle W_i-C_i-W_{i+1}
 for i in range(h):
  for e in ((W[i],C[i]),(C[i],W[(i+1)%h])):E.add(tuple(sorted(e)))
 prob=max(0,(avg-2)/h)
 for u in W:
  for v in C:
   if rng.random()<prob:E.add(tuple(sorted((u,v))))
 V=[x for x in range(p) if x!=b];ix={x:i for i,x in enumerate(V)};A=[0]*len(V)
 for u,v in E:
  i,j=ix[u],ix[v];A[i]|=1<<j;A[j]|=1<<i
 return b,V,A,E

def indep(A,sel):
 bits=0
 for v in sel:
  if A[v]&bits:return False
  bits|=1<<v
 return True

def greedy(A,rng=None,mode='"'min'):
 av=(1<<len(A))-1;sel=[]
 while av:
  vals=[];bb=av
  while bb:
   lo=bb&-bb;v=lo.bit_length()-1;d=pc(A[v]&av);tie=rng.random() if rng else v
   vals.append((d if mode=='min' else -d,tie,v));bb"'^=lo
  v=min(vals)[2];sel.append(v);av&=~(1<<v);av&=~A[v]
 return sel
for p,avg in [(59,10),(127,14),(251,20),(251,8)]:
 print('"'PARAM',p,avg)
 for seed in range(8):
