+    if type(degree) is not int or not (3 <= degree < cover_size):
+        raise ValueError("degree must be an integer in [3, cover_size)")
+    if degree * (n - 2 * independent_size) % 2:
+        raise ValueError("residual cover degree sum must be even")
 
 
