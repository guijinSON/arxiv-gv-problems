+
+    inst = {
+        "n": n,
+        "degree": degree,
+        "label_decoys": label_decoys,
+        "vertices": dag["vertices"],
+        "internal": dag["internal"],
+        "terminals": dag["terminals"],
+        "arcs": dag["arcs"],
+        "label_groups": label_groups,
+        "threshold": threshold,
+        "answer": answer,
