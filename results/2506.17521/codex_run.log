+}
+
+# Filled only after the three script-owned oracle runs.  The zero-attempt values
+# ensure that a preliminary selftest cannot accidentally claim G9 passed.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
