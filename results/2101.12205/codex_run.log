import random,time,statistics

def instance(r=28,L=9,seed=0):
    rng=random.Random(seed); verts=list(range(r*L)); rng.shuffle(verts)
    edges=[]
    for j in range(r):
        cyc=verts[j*L:(j+1)*L]
        edges.extend(tuple(sorted((cyc[i],cyc[(i+1)%L],cyc[(i+2)%L]))) for i in range(L))
    rng.shuffle(edges)
    return edges

def recover(edges):
    pair={}; inserts=0
    for i,e in enumerate(edges):
        a,b,c=e
        for p in ((a,b),(a,c),(b,c)):
            pair.setdefault(p,[]).append(i); inserts+=1
    adj=[[] for _ in edges]; links=0
    for ids in pair.values():
        if len(ids)==2:
            x,y=ids; adj[x].append(y); adj[y].append(x); links+=1
    seen=set(); cycles=[]; steps=0
    for s in range(len(edges)):
        if s in seen: continue
        comp=[]; prev=-1; cur=s
        while cur not in seen:
            seen.add(cur); comp.append(cur); steps+=1
            ns=adj[cur]
            nxt=ns[0] if ns[0]"'!=prev else ns[1]
            prev,cur=cur,nxt
        cycles.append(comp)
    return cycles,inserts,steps,links

t=[]
