print({'"'edges':len(e),'answer_atoms':28*9,'pair_insertions':ins,'traversal_steps':steps,'primary_operations':ins+steps,'overlap_links':links,'mean_wall_clock_sec':statistics.mean(t),'max_wall_clock_sec':max(t)})
