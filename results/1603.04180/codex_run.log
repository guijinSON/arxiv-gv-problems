+    q = inst["q"]
+    width = inst["width"]
+    new_mixers = [
+        [
+            (add + delta * (j + 1)) % q,
+            key ^ ((delta * (2 * j + 1)) % q),
+            1 + ((rotation + delta + j - 1) % (width - 1)),
+        ]
+        for j, (add, key, rotation) in enumerate(inst["mixers"])
+    ]
+    out = copy.deepcopy(inst)
+    out["mixers"] = new_mixers
