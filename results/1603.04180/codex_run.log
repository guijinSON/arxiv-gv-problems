+def _canonical_terminal_configuration(inst: dict) -> list[list[int]]:
+    q = inst["q"]
+    pairs = inst["terminal_colours"]
+    pivots = sorted({v for pair in pairs for v in pair if v % q})
+    if not pivots:
+        return [[0, 0] for _ in pairs]
+    forms = []
+    for pivot in pivots:
+        inv = pow(pivot, q - 2, q)
+        form = sorted(sorted([(a * inv) % q, (b * inv) % q]) for a, b in pairs)
+        forms.append(form)
+    return min(forms)
 
 
