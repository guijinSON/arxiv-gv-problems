+def _rotl(x: int, amount: int, width: int) -> int:
+    mask = (1 << width) - 1
+    amount %= width
+    return ((x << amount) | (x >> (width - amount))) & mask
+
+
+def _rotr(x: int, amount: int, width: int) -> int:
+    return _rotl(x, width - (amount % width), width)
+
