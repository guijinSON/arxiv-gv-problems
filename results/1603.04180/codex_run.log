+def _transform_scale(inst: dict, scalar: int) -> tuple[dict, list[list[int]]]:
+    q = inst["q"]
+    out = copy.deepcopy(inst)
+    out["terminal_colours"] = [
+        [(scalar * a) % q, (scalar * b) % q]
+        for a, b in inst["terminal_colours"]
+    ]
+    carried = []
+    for pair in inst["answer"]:
+        new_pair = []
+        for vertex in pair:
+            block, residue = divmod(vertex, q)
+            new_colour = scalar * _perm(residue, q, inst["shifts"]) % q
+            new_residue = _inverse_perm(new_colour, q, inst["shifts"])
+            new_pair.append(block * q + new_residue)
+        carried.append(sorted(new_pair))
+    out["answer"] = carried
+    return out, carried
 
