+def _transform_mapping(inst: dict, delta: int) -> tuple[dict, list[list[int]]]:
+    q = inst["q"]
+    new_shifts = [(s + delta * (j + 1)) % q for j, s in enumerate(inst["shifts"])]
+    out = copy.deepcopy(inst)
+    out["shifts"] = new_shifts
+    carried = []
+    for pair in inst["answer"]:
+        new_pair = []
+        for vertex in pair:
+            block, residue = divmod(vertex, q)
+            colour = _perm(residue, q, inst["shifts"])
+            new_residue = _inverse_perm(colour, q, new_shifts)
+            new_pair.append(block * q + new_residue)
+        carried.append(sorted(new_pair))
+    out["answer"] = carried
+    return out, carried
 
 
