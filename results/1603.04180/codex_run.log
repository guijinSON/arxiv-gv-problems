+    q = len(overlaps)
+    for i in range(q):
+        order.extend((overlaps[i], internals[2 * i], internals[2 * i + 1]))
+    edges = []
+    for i in range(q):
+        j = 3 * i
+        edges.append(tuple(sorted((order[j], order[(j + 1) % len(order)],
+                                   order[(j + 2) % len(order)],
+                                   order[(j + 3) % len(order)]))))
+    return order, edges
