+def _route_operations(q: int, m: int, layers: int) -> int:
+    exponent = (2 * q - 1) // 3
+    # Binary exponentiation: one square per remaining bit and one multiply for
+    # each remaining 1-bit.  Add one subtraction per inverse layer, plus three
+    # colour additions/bookkeeping operations per path.
+    pow_mults = max(0, exponent.bit_length() - 1) + max(0, exponent.bit_count() - 1)
