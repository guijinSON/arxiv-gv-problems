+    `n` selects the least prime q>=n with q=2 mod 3.  Difficulty grows through
+    the colour period q while the witness always contains exactly 2m indices.
+    """
 
+    del params
+    if not (1 <= m <= 8):
+        raise ValueError("m must lie between 1 and 8")
+    if not (1 <= layers <= 3):
+        raise ValueError("layers must lie between 1 and 3")
+    q = _next_prime_2mod3(n)
+    theorem_blocks = 2048 * m * q * q
+    if blocks is None:
+        blocks = theorem_blocks
+    blocks = int(blocks)
+    if blocks < 2:
+        raise ValueError("at least two reservoir blocks are required")
+    r = blocks * q
+    if r < 2 * m:
+        raise ValueError("the reservoir is too small for disjoint connectors")
+
+    rng = random.Random(seed)
+    shifts = [rng.randrange(q) for _ in range(layers)]
+
+    used: set[int] = set()
+    answer: list[list[int]] = []
+    targets: set[int] = set()
+    terminal_colours: list[list[int]] = []
+    for _ in range(m):
+        # Sampling the witness first is the certificate-producing step.  Reject
+        # only collisions and degenerate/repeated target colours, not hard cases.
+        for _attempt in range(1000):
+            a = rng.randrange(r)
+            b = rng.randrange(r - 1)
+            if b >= a:
+                b += 1
+            if a in used or b in used:
+                continue
+            target = (_perm(a % q, q, shifts) + _perm(b % q, q, shifts)) % q
+            if target == 0 or target in targets:
+                continue
+            break
+        else:
+            raise RuntimeError("could not sample distinct connector targets")
+        used.update((a, b))
+        targets.add(target)
+        x_colour = rng.randrange(q)
+        y_colour = (-target - x_colour) % q
+        terminal_colours.append([x_colour, y_colour])
+        answer.append(sorted([a, b]))
+
+    eta_den = 2 * q
+    required_r = 32 * 4 * m * eta_den**3
+    theorem_condition = r >= required_r and blocks >= theorem_blocks
+    all_completing_pairs = math.comb(r, 2) // q
+    disjoint_completion_lower_bound = all_completing_pairs - 2 * blocks
+
     return {
+        "paper": "arXiv:1603.04180",
+        "family": "simultaneous reservoir connectors in a 4-uniform hypergraph",
         "k": 4,
         "ell": 1,
