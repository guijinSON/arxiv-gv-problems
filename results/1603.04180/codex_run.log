+def _attack_single_cube(inst: dict) -> list[list[int]]:
+    q = inst["q"]
+    exponent = (2 * q - 1) // 3
+    out = []
+    for i in range(inst["m"]):
+        a = (2 * i) * q
+        need = (_path_target(inst, i) - _reservoir_colour(inst, a)) % q
+        # Reverse only the outermost layer, the most obvious incomplete ansatz.
+        residue = (pow(need, exponent, q) - inst["shifts"][-1]) % q
+        b = (2 * i + 1) * q + residue
+        out.append(sorted([a, b]))
+    return out
 
