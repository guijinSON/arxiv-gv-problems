+def _linear_relation_code(sequence: list[int]) -> list[int]:
+    """Coordinates in the greedily encountered basis, invariant under GL(w,2)."""
 
+    pivots: dict[int, tuple[int, int]] = {}
+    rank = 0
+    code = []
+    for value in sequence:
+        x = value
+        coordinates = 0
