+def _attack_greedy_shortlist(inst: dict, width: int = 32) -> list[list[int]]:
+    q = inst["q"]
+    out = []
+    for i in range(inst["m"]):
+        a = (2 * i) * q
+        target = _path_target(inst, i)
+        best = None
+        for residue in range(min(width, q)):
+            b = (2 * i + 1) * q + residue
+            residual = (target - _reservoir_colour(inst, a) - _reservoir_colour(inst, b)) % q
+            score = min(residual, q - residual)
+            if best is None or score < best[0]:
+                best = (score, b)
+        out.append(sorted([a, best[1]]))
+    return out
 
 
