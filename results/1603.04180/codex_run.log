+def _perm(x: int, q: int, mixers: list[list[int]]) -> int:
+    """A composition of exactly reversible add/rotate/XOR word maps."""
+
+    mask = q - 1
+    width = q.bit_length() - 1
+    z = x & mask
+    for add, key, rotation in mixers:
+        z = (z + add) & mask
+        z = _rotl(z, rotation, width)
+        z ^= key
+    return z
