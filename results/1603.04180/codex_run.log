+            block, residue = divmod(vertex, q)
+            colour = _perm(residue, q, inst["mixers"])
+            new_residue = _inverse_perm(colour, q, new_mixers)
+            new_pair.append(block * q + new_residue)
+        carried.append(sorted(new_pair))
+    out["answer"] = carried
