+def _inverse_perm(y: int, q: int, shifts: list[int]) -> int:
+    # q == 2 (mod 3), hence x -> x^3 is a permutation and this exponent
+    # is the inverse of 3 modulo q-1.
+    cube_root_exponent = (2 * q - 1) // 3
+    z = y % q
+    for shift in reversed(shifts):
+        z = (pow(z, cube_root_exponent, q) - shift) % q
+    return z
 
 
