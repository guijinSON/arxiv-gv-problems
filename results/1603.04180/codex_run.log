+"""Self-contained generator for anchored loose Hamilton cycles.
+
+The native objects and witness convention come from Bastos--Mota--Schacht--
+Schnitzer--Schulenburg, arXiv:1603.04180.  The generator inverse-generates a
+4-uniform Hamilton 1-cycle, composes it with identically shaped random cycle
+layers, and retains the planted cyclic ordering as an exact witness.
+
+Only the Python standard library is used.  No file or network access occurs at
+import time.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "permutation",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "4-uniform hypergraph",
+        "cyclic ordering witnessing a Hamilton 1-cycle",
+    ],
+    "verification_operations": [
+        "exact vertex-set comparison",
+        "exact 4-set membership",
+        "cyclic block indexing",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The four anchored labels initiate a constant-third-finite-difference "
+        "ordering modulo the displayed prime; without recognizing it one faces "
+        "anchored loose-Hamilton-cycle search in a regular hypergraph."
+    ),
+    "hardness_basis": (
+        "Track B: generic anchored fail-first DFS (exponential worst case) solved "
+        "8/8 shipping instances at n=36 with a measured median 146,921 nodes and "
+        "2.22 s, while the disclosed O(n+m) finite-difference route used 114 exact "
+        "operations (median 0.000010 s); Theorem 3 is not used as a hardness claim."
+    ),
+    "max_answer_tokens": 0,  # replaced with the measured shipping value below
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A list of exactly n distinct displayed integer vertex labels, beginning "
+        "with the four displayed anchors and containing every vertex once; labels "
+        "are bounded residues modulo 1,000,003 and n is at most 240."
+    ),
+    "bounds": {
+        "max_vertices": 240,
+        "fixed_prefix": 4,
+        "label_min": 0,
+        "label_max": 1_000_002,
+        "distinct": 1,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 9, "layers": 3},
+    "easy": {"n": 36, "layers": 6},
+    "medium": {"n": 48, "layers": 9},
+    "hard": {"n": 60, "layers": 12},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+STRUCTURAL_HINT: str = (
+    "The anchored vertex labels have constant third finite difference modulo 1000003."
+)
+PLACEBO_HINT: str = (
+    "The anchored vertex labels reward careful checking of the cyclic indexing conventions."
+)
+
+_MODULUS = 1_000_003
+_SELFTEST_SEEDS = tuple(range(8))
+
+# Filled after the three independently owned harden.py runs.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 0},
+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
+    },
+    "hinted_verdict": "not_run",
+}
+
+NOTES: str = (
+    "Section 1 defines a k-uniform hypergraph, an ell-cycle as a cyclic vertex "
+    "ordering whose k-consecutive blocks overlap in exactly ell vertices, and "
+    "Hamiltonian to mean spanning.  Theorem 3 fixes the paper's regime: k>=4, "
+    "1<=ell<k/2, (k-ell)|n, and large minimum (k-2)-degree.  The extremal example "
+    "immediately below Theorem 1 explains the easy obstruction, while Section 2.1 "
+    "shows that the existence proof proceeds by absorption, a reservoir, and path "
+    "tiling; it does not supply a small-instance or average-case hardness theorem. "
+    "Accordingly this is honest Track B and uses the native k=4, ell=1 witness, "
+    "but does not claim to sample Theorem 3's dense threshold distribution.  The "
+    "certificate is sampled first.  Cycle layers are built in triples whose overlap "
+    "roles balance exactly, so all vertices have equal degree; edge order is shuffled. "
+    "The attacks test degree/label outliers, locally cheapest continuation, random "
+    "greedy restarts, and the obvious constant-first-difference ansatz."
+)
+
+
+def _validate_params(n: int, layers: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 9 or n % 3:
+        raise ValueError("n must be an integer multiple of 3 and at least 9")
+    if n > 240:
+        raise ValueError("n must be at most 240 under the certificate-language cap")
+    if isinstance(layers, bool) or not isinstance(layers, int):
+        raise ValueError("layers must be an integer")
+    if layers < 3 or layers % 3:
+        raise ValueError("layers must be a positive multiple of 3 and at least 3")
+
+
+def _cycle_from_overlap_set(
+    overlap: list[int] | tuple[int, ...] | set[int],
+    vertices: list[int],
+    rng: random.Random,
+) -> tuple[list[int], list[tuple[int, int, int, int]]]:
+    """Draw a uniformly shuffled loose cycle with the prescribed overlap vertices."""
+
+    overlaps = list(overlap)
+    internals = [v for v in vertices if v not in set(overlaps)]
+    rng.shuffle(overlaps)
+    rng.shuffle(internals)
+    order: list[int] = []
+    q = len(overlaps)
+    for i in range(q):
+        order.extend((overlaps[i], internals[2 * i], internals[2 * i + 1]))
+    edges = []
+    for i in range(q):
+        j = 3 * i
+        edges.append(tuple(sorted((order[j], order[(j + 1) % len(order)],
+                                   order[(j + 2) % len(order)],
+                                   order[(j + 3) % len(order)]))))
+    return order, edges
+
+
+def _plant_cycle(order: list[int]) -> list[tuple[int, int, int, int]]:
+    n = len(order)
+    return [
+        tuple(sorted((order[j], order[(j + 1) % n], order[(j + 2) % n],
+                      order[(j + 3) % n])))
+        for j in range(0, n, 3)
+    ]
+
+
+def _new_cycle_avoiding_duplicates(
+    overlap: set[int],
+    vertices: list[int],
+    rng: random.Random,
+    used_edges: set[tuple[int, int, int, int]],
+) -> tuple[list[int], list[tuple[int, int, int, int]]]:
+    for _ in range(10_000):
+        order, edges = _cycle_from_overlap_set(overlap, vertices, rng)
+        if len(set(edges)) == len(edges) and not (set(edges) & used_edges):
+            return order, edges
+    raise RuntimeError("could not draw a duplicate-free decoy loose cycle")
+
+
+def _recurrence_values(n: int, rng: random.Random) -> list[int]:
+    """Return n distinct residues with nonzero constant third difference."""
+
+    for _ in range(10_000):
+        values = [rng.randrange(_MODULUS) for _ in range(4)]
+        if len(set(values)) < 4:
+            continue
+        d1 = (values[1] - values[0]) % _MODULUS
+        d1_next = (values[2] - values[1]) % _MODULUS
+        d2 = (d1_next - d1) % _MODULUS
+        d1_third = (values[3] - values[2]) % _MODULUS
+        d2_next = (d1_third - d1_next) % _MODULUS
+        d3 = (d2_next - d2) % _MODULUS
+        if d3 == 0 or d2 == 0 or d1 == 0:
+            continue
+        x = values[-1]
+        first = d1_third
+        second = d2_next
+        while len(values) < n:
+            second = (second + d3) % _MODULUS
+            first = (first + second) % _MODULUS
+            x = (x + first) % _MODULUS
+            values.append(x)
+        if len(set(values)) == n:
+            return values
+    raise RuntimeError("could not draw an injective finite-difference sequence")
+
+
+def make_instance(n: int, seed: int = 0, layers: int = 6, **params) -> dict:
+    """Inverse-generate a 4-uniform hypergraph and a Hamilton 1-cycle witness.
+
+    The certificate is never recovered from the completed instance.  It is chosen
+    first as a uniformly relabelled loose cycle; all later work only adds decoys
+    and a structure-carrying vertex-name bijection.
+    """
+
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_params(n, layers)
+    rng = random.Random(seed)
+    vertices = list(range(n))
+    q = n // 3
+
+    plant_order = list(vertices)
+    rng.shuffle(plant_order)
+    plant_overlap = set(plant_order[::3])
+    plant_edges = _plant_cycle(plant_order)
+    all_edges = list(plant_edges)
+    used_edges = set(plant_edges)
+
+    # Build layers in blocks of three.  In each block every vertex is an overlap
+    # vertex once and an internal vertex twice.  Thus every displayed vertex has
+    # exactly 4*layers/3 incident edges, including the planted layer.
+    complement = [v for v in vertices if v not in plant_overlap]
+    rng.shuffle(complement)
+    first_partition = [plant_overlap, set(complement[:q]), set(complement[q:])]
+    for overlap in first_partition[1:]:
+        _order, edges = _new_cycle_avoiding_duplicates(
+            overlap, vertices, rng, used_edges
+        )
+        all_edges.extend(edges)
+        used_edges.update(edges)
+
+    for _block in range(1, layers // 3):
+        shuffled = list(vertices)
+        rng.shuffle(shuffled)
+        for part in range(3):
+            overlap = set(shuffled[part * q : (part + 1) * q])
+            _order, edges = _new_cycle_avoiding_duplicates(
+                overlap, vertices, rng, used_edges
+            )
+            all_edges.extend(edges)
+            used_edges.update(edges)
+
+    # Map the already chosen certificate order to an injective cubic (Newton-form)
+    # sequence.  This is a relabelling of the native hypergraph, not a surrogate.
+    answer = _recurrence_values(n, rng)
+    label_of = {plant_order[i]: answer[i] for i in range(n)}
+    labelled_edges = [sorted(label_of[v] for v in edge) for edge in all_edges]
+    rng.shuffle(labelled_edges)
+    visible_vertices = sorted(answer)
+
+    return {
+        "k": 4,
+        "ell": 1,
+        "n": n,
+        "layers": layers,
+        "modulus": _MODULUS,
+        "vertices": visible_vertices,
+        "anchors": answer[:4],
+        "edges": labelled_edges,
+        "answer": list(answer),
+    }
+
+
+def render(inst: dict) -> str:
+    vertices = " ".join(map(str, inst["vertices"]))
+    anchors = " ".join(map(str, inst["anchors"]))
+    edge_lines = "\n".join(
+        f"  {i}: " + " ".join(map(str, edge))
+        for i, edge in enumerate(inst["edges"])
+    )
+    hint = ""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        hint = "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        hint = "\n\nHint: " + PLACEBO_HINT
+    return f"""ANCHORED LOOSE HAMILTON CYCLE IN A 4-UNIFORM HYPERGRAPH
+
+A 4-uniform hypergraph consists of a vertex set and hyperedges, each hyperedge
+being an unordered set of exactly four distinct vertices.  A Hamilton 1-cycle is
+a cyclic ordering x[0],...,x[n-1] of every vertex exactly once such that, for
+each i=0,3,6,...,n-3, the unordered set
+
+  {{x[i], x[(i+1) mod n], x[(i+2) mod n], x[(i+3) mod n]}}
+
+is a displayed hyperedge.  Thus consecutive cycle edges share exactly the one
+vertex at their boundary.  Here n={inst['n']}, so the cycle has {inst['n']//3}
+hyperedges.  Indices in this definition are 0-based and all modular indexing of
+x uses modulus n.  Vertex labels themselves are ordinary exact integers in the
+range 0 through {inst['modulus']-1}; {inst['modulus']} is also displayed as an
+instance modulus.  Hyperedge order and the order of labels inside an edge carry
+no meaning.
+
+To remove cyclic rotation and orientation ambiguity, your ordering must begin
+with this exact four-vertex prefix:
+
+  {anchors}
+
+The complete vertex set is:
+
+  {vertices}
+
+The {len(inst['edges'])} hyperedges are:
+
+{edge_lines}
+
+Return exactly {inst['n']} comma-separated integer labels: the anchored cyclic
+ordering, containing each displayed vertex exactly once and no other label.
+Give your final answer inside <answer></answer> tags.
+Syntax-only example: <answer>17, 4, 29</answer>
+Output nothing else inside the tags.{hint}"""
+
+
+def parse_answer(text: str):
+    """Parse the last delimited comma/whitespace-separated integer list."""
+
+    if not isinstance(text, str):
+        return None
+    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    body = re.sub(r"^```(?:json|text)?\s*", "", body, flags=re.I)
+    body = re.sub(r"\s*```$", "", body)
+    if body.startswith("[") and body.endswith("]"):
+        try:
+            obj = json.loads(body)
+        except (ValueError, TypeError):
+            return None
+        if not isinstance(obj, list) or any(
+            isinstance(x, bool) or not isinstance(x, int) for x in obj
+        ):
+            return None
+        return obj
+    if not body:
+        return []
+    pieces = [p for p in re.split(r"[\s,]+", body) if p]
+    if not pieces or any(re.fullmatch(r"[-+]?\d+", p) is None for p in pieces):
+        return None
+    try:
+        return [int(p) for p in pieces]
+    except (ValueError, OverflowError):
+        return None
+
+
+def verify(inst: dict, answer) -> tuple[bool, str]:
+    """Check any anchored Hamilton 1-cycle; never inspect ``inst['answer']``."""
+
+    n = inst["n"]
+    if not isinstance(answer, list):
+        return False, "answer must be a list of integer vertex labels"
+    if len(answer) == 0:
+        return False, "answer is empty"
+    if len(answer) != n:
+        return False, f"wrong length: expected {n}, got {len(answer)}"
+    if any(isinstance(x, bool) or not isinstance(x, int) for x in answer):
+        return False, "every vertex label must be an integer"
+    vertex_set = set(inst["vertices"])
+    unknown = next((x for x in answer if x not in vertex_set), None)
+    if unknown is not None:
+        return False, f"unknown vertex label: {unknown}"
+    if len(set(answer)) != n:
+        return False, "vertex labels must be distinct"
+    if set(answer) != vertex_set:
+        return False, "the ordering must contain every displayed vertex exactly once"
+    if answer[:4] != inst["anchors"]:
+        return False, "the required four-vertex prefix is not respected"
+    edges = {frozenset(edge) for edge in inst["edges"]}
+    for i in range(0, n, 3):
+        block = frozenset(answer[(i + j) % n] for j in range(4))
+        if len(block) != 4 or block not in edges:
+            return False, f"cyclic block starting at position {i} is not a hyperedge"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random):
+    """Uniformly sample the structure-aware language: fixed prefix, permuted rest."""
+
+    rest = [v for v in inst["vertices"] if v not in set(inst["anchors"])]
+    rng.shuffle(rest)
+    return list(inst["anchors"]) + rest
+
+
+def search_space(inst: dict) -> int:
+    return math.factorial(inst["n"] - 4)
+
+
+def enumerate_all(inst: dict):
+    """Count all valid anchored orderings only when at most 9! are possible."""
+
+    if inst["n"] - 4 > 9:
+        return None
+    rest = [v for v in inst["vertices"] if v not in set(inst["anchors"])]
+    count = 0
+    for suffix in itertools.permutations(rest):
+        if verify(inst, list(inst["anchors"]) + list(suffix))[0]:
+            count += 1
+    return count
+
+
+def _wl_key(inst: dict, rounds: int = 10) -> str:
+    """Anchored incidence-graph WL invariant, independent of all input labels."""
+
+    vertices = list(inst["vertices"])
+    pos = {v: i for i, v in enumerate(vertices)}
+    nv = len(vertices)
+    ne = len(inst["edges"])
+    neighbors = [[] for _ in range(nv + ne)]
+    for ei, edge in enumerate(inst["edges"]):
+        enode = nv + ei
+        for v in edge:
+            vnode = pos[v]
+            neighbors[vnode].append(enode)
+            neighbors[enode].append(vnode)
+    anchor_role = {v: i for i, v in enumerate(inst["anchors"])}
+    colors = [
+        (f"anchor:{anchor_role[v]}" if v in anchor_role else "vertex")
+        for v in vertices
+    ] + ["edge"] * ne
+    history = []
+    for _ in range(rounds):
+        colors = [
+            hashlib.sha256(
+                (colors[i] + "|" + "|".join(sorted(colors[j] for j in neighbors[i]))).encode()
+            ).hexdigest()
+            for i in range(nv + ne)
+        ]
+        history.append(hashlib.sha256("|".join(sorted(colors)).encode()).hexdigest())
+    payload = {
+        "n": nv,
+        "m": ne,
+        "incidence_rounds": history,
+        "edge_intersections": sorted(
+            len(set(inst["edges"][i]) & set(inst["edges"][j]))
+            for i in range(ne)
+            for j in range(i + 1, ne)
+            if set(inst["edges"][i]) & set(inst["edges"][j])
+        ),
+    }
+    return hashlib.sha256(json.dumps(payload, sort_keys=True).encode()).hexdigest()
+
+
+def canonical_key(inst: dict) -> str:
+    return _wl_key(inst)
+
+
+def escalate(params: dict):
+    p = {k: v for k, v in params.items() if k != "_preset"}
+    n = int(p["n"])
+    layers = int(p.get("layers", 6))
+    # First crowd the same fixed-length witness with more regular decoy layers.
+    if layers < 24:
+        p["layers"] = layers + 3
+        return p
+    # Only after crowding is exhausted lengthen the witness, still below both caps.
+    if n <= 216:
+        p["n"] = n + 12
+        p["layers"] = 15
+        return p
+    return "cap_bound"
+
+
+def _recurrence_candidate(inst: dict) -> tuple[list[int], int]:
+    a = list(inst["anchors"])
+    p = inst["modulus"]
+    first0 = (a[1] - a[0]) % p
+    first1 = (a[2] - a[1]) % p
+    first2 = (a[3] - a[2]) % p
+    second0 = (first1 - first0) % p
+    second1 = (first2 - first1) % p
+    third = (second1 - second0) % p
+    out = list(a)
+    x = a[-1]
+    first = first2
+    second = second1
+    operations = 6
+    while len(out) < inst["n"]:
+        second = (second + third) % p
+        first = (first + second) % p
+        x = (x + first) % p
+        out.append(x)
+        operations += 3
+    return out, operations
+
+
+def _eligible_options(inst: dict, prefix: list[int]):
+    """List legal one-edge continuations of a partial loose-cycle ordering."""
+
+    n = inst["n"]
+    root = prefix[0]
+    current = prefix[-1]
+    used = set(prefix)
+    depth = (len(prefix) - 1) // 3
+    q = n // 3
+    options = []
+    for edge in inst["edges"]:
+        e = set(edge)
+        if current not in e:
+            continue
+        if depth == q - 1:
+            if root not in e or len(e - used) != 2 or (e & used) != {root, current}:
+                continue
+            new = sorted(e - used)
+            options.append((new, None, edge))
+            continue
+        if root in e or (e & used) != {current}:
+            continue
+        new = list(e - used)
+        for connector in new:
+            internal = sorted(v for v in new if v != connector)
+            options.append((internal + [connector], connector, edge))
+    return options
+
+
+def _greedy_candidate(inst: dict, rng: random.Random | None = None):
+    prefix = list(inst["anchors"])
+    # The first anchored edge is already complete, hence append from its boundary.
+    while len(prefix) < inst["n"]:
+        options = _eligible_options(inst, prefix)
+        if not options:
+            return prefix
+        if rng is not None:
+            choice = rng.choice(options)
+        else:
+            degree = {v: 0 for v in inst["vertices"]}
+            for edge in inst["edges"]:
+                for v in edge:
+                    degree[v] += 1
+            choice = min(
+                options,
+                key=lambda row: (
+                    sum(degree[v] for v in row[0]),
+                    tuple(row[0]),
+                ),
+            )
+        prefix.extend(choice[0])
+    return prefix
+
+
+def _random_restart(inst: dict, rng: random.Random, restarts: int):
+    trials = 0
+    for _ in range(restarts):
+        candidate = list(inst["anchors"])
+        while len(candidate) < inst["n"]:
+            options = _eligible_options(inst, candidate)
+            trials += len(options)
+            if not options:
+                break
+            candidate.extend(rng.choice(options)[0])
+        if verify(inst, candidate)[0]:
+            return candidate, trials
+    return None, trials
+
+
+def _outlier_candidate(inst: dict):
+    degree = {v: 0 for v in inst["vertices"]}
+    for edge in inst["edges"]:
+        for v in edge:
+            degree[v] += 1
+    rest = [v for v in inst["vertices"] if v not in set(inst["anchors"])]
+    rest.sort(key=lambda v: (degree[v], v))
+    return list(inst["anchors"]) + rest
+
+
+def _first_difference_candidate(inst: dict):
+    p = inst["modulus"]
+    anchors = list(inst["anchors"])
+    step = (anchors[1] - anchors[0]) % p
+    seen = set(anchors)
+    out = list(anchors)
+    x = anchors[-1]
+    while len(out) < inst["n"]:
+        x = (x + step) % p
+        if x in set(inst["vertices"]) and x not in seen:
+            out.append(x)
+            seen.add(x)
+        else:
+            break
+    out.extend(sorted(v for v in inst["vertices"] if v not in seen))
+    return out[: inst["n"]]
+
+
+def _dfs_reference(
+    inst: dict, node_limit: int = 2_000_000, rng: random.Random | None = None
+):
+    """Generic anchored loose-cycle DFS, used only as a measured reference."""
+
+    nodes = 0
+    root = inst["anchors"][0]
+    n = inst["n"]
+    q = n // 3
+    edge_sets = [frozenset(edge) for edge in inst["edges"]]
+    by_vertex = {v: [] for v in inst["vertices"]}
+    for edge in edge_sets:
+        for v in edge:
+            by_vertex[v].append(edge)
+
+    def options_for(prefix: list[int]):
+        current = prefix[-1]
+        used = set(prefix)
+        depth = (len(prefix) - 1) // 3
+        rows = []
+        for edge in by_vertex[current]:
+            if depth == q - 1:
+                if root in edge and edge & used == {root, current} and len(edge - used) == 2:
+                    rows.append((sorted(edge - used), None, edge))
+                continue
+            if root in edge or edge & used != {current}:
+                continue
+            new = list(edge - used)
+            for connector in new:
+                rows.append((sorted(v for v in new if v != connector) + [connector],
+                             connector, edge))
+        return rows
+
+    def visit(prefix: list[int]):
+        nonlocal nodes
+        if nodes >= node_limit:
+            return None
+        nodes += 1
+        if len(prefix) == n:
+            return prefix if verify(inst, prefix)[0] else None
+        options = options_for(prefix)
+        # Fail-first: prefer a boundary vertex having fewer currently legal exits.
+        # Incidence lists are precomputed so this measures search nodes, not repeated
+        # whole-instance scans in Python.
+        used = set(prefix)
+        def score(row):
+            connector = row[1]
+            if connector is None:
+                return (0, tuple(row[0]))
+            used_next = used | set(row[0])
+            exits = sum(
+                1 for edge in by_vertex[connector]
+                if root not in edge and edge & used_next == {connector}
+            )
+            return (exits, rng.random()) if rng is not None else (exits, tuple(row[0]))
+        if rng is not None:
+            rng.shuffle(options)
+        options.sort(key=score)
+        for addition, _connector, _edge in options:
+            got = visit(prefix + addition)
+            if got is not None:
+                return got
+            if nodes >= node_limit:
+                break
+        return None
+
+    answer = visit(list(inst["anchors"]))
+    return answer, nodes, nodes >= node_limit and answer is None
+
+
+def _transform_instance(inst: dict, rng: random.Random) -> dict:
+    old = list(inst["vertices"])
+    new = list(old)
+    rng.shuffle(new)
+    mapping = dict(zip(old, new))
+    edges = [[mapping[v] for v in edge] for edge in inst["edges"]]
+    for edge in edges:
+        edge.sort()
+    rng.shuffle(edges)
+    return {
+        "k": inst["k"],
+        "ell": inst["ell"],
+        "n": inst["n"],
+        "layers": inst["layers"],
+        "modulus": inst["modulus"],
+        "vertices": sorted(new),
+        "anchors": [mapping[v] for v in inst["anchors"]],
+        "edges": edges,
+        "answer": [mapping[v] for v in inst["answer"]],
+    }
+
+
+def _answer_metrics(inst: dict) -> tuple[int, int, int]:
+    # Worst decimal width at this fixed modulus, not merely the sampled answer.
+    worst = "[" + ",".join([str(_MODULUS - 1)] * inst["n"]) + "]"
+    chars = len(worst)
+    tokens = math.ceil(chars / 4)
+    return chars, tokens, inst["n"]
+
+
+def selftest() -> dict:
+    report = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
+
+    g1_failures = []
+    g1_checks = 0
+    json_checks = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_checks += 1
+            if not ok:
+                g1_failures.append([preset, seed, reason])
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_checks += 1
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures and json_checks == g1_checks,
+        "checks": g1_checks,
+        "json_roundtrips": json_checks,
+        "failures": g1_failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=90210, **ship_params)
+    answer = list(inst["answer"])
+    swapped = list(answer)
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    duplicate = list(answer)
+    duplicate[-1] = duplicate[-2]
+    corruptions = {
+        "drop_one": answer[:-1],
+        "swap_anchors": swapped,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": answer[:-1] + [_MODULUS + 7],
+    }
+    cases = {}
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        cases[name] = {"rejected": not ok, "reason": reason}
+    reasons = [x["reason"] for x in cases.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(x["rejected"] for x in cases.values()) and len(set(reasons)) == 5,
+        "cases": cases,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    realistic = (
+        "The cyclic blocks have been checked.\n```text\n<answer>\n"
+        + ", ".join(map(str, answer))
+        + "\n</answer>\n```\n"
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and parse_answer("no tagged answer") is None,
+        "parsed_elements": len(parsed) if isinstance(parsed, list) else None,
+        "garbage_returns_none": parse_answer("no tagged answer") is None,
+    }
+
+    samples = 200_000
+    guess_rng = random.Random(0x160304180)
+    hits = 0
+    for _ in range(samples):
+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            hits += 1
+    density = hits / samples
+    report["G4_guess_resistance"] = {
+        "pass": samples >= 200_000 and density < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "hits_over_total": f"{hits}/{samples}",
+        "measured_probability": density,
+        "structure_aware_space": search_space(inst),
+        "sampler": "uniform permutation of all non-anchor vertices after the fixed prefix",
+    }
+
+    baseline_rng = random.Random(991603)
+    t0 = time.perf_counter()
+    baseline_answer, baseline_trials = _random_restart(inst, baseline_rng, 256)
+    baseline_wall = time.perf_counter() - t0
+    demo = make_instance(seed=3, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline"] = {
+        "pass": density < 1e-6 and demo_count is not None and baseline_answer is None,
+        "shipping_valid_hits": hits,
+        "shipping_density_samples": samples,
+        "shipping_observed_solution_fraction": density,
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_count": search_space(demo),
+        "baseline_wall_seconds": round(baseline_wall, 6),
+        "baseline_iterations": baseline_trials,
+        "baseline_attack": "256 random greedy loose-cycle restarts",
+    }
+
+    attacks = {
+        "outlier_degree_then_label": {"successes": 0, "attempts": 0},
+        "greedy_minimum_branch": {"successes": 0, "attempts": 0},
+        "random_restart_64": {"successes": 0, "attempts": 0},
+        "in_context_constant_first_difference": {"successes": 0, "attempts": 0},
+    }
+    recurrence_times = []
+    recurrence_ops = []
+    recurrence_successes = 0
+    dfs_rows = []
+    for seed in range(3100, 3108):
+        attacked = make_instance(seed=seed, **ship_params)
+        candidates = {
+            "outlier_degree_then_label": _outlier_candidate(attacked),
+            "greedy_minimum_branch": _greedy_candidate(attacked),
+            "in_context_constant_first_difference": _first_difference_candidate(attacked),
+        }
+        rr, _trials = _random_restart(attacked, random.Random(seed ^ 0xA5A5), 64)
+        candidates["random_restart_64"] = rr
+        for name, candidate in candidates.items():
+            attacks[name]["attempts"] += 1
+            if candidate is not None and verify(attacked, candidate)[0]:
+                attacks[name]["successes"] += 1
+        start = time.perf_counter()
+        ref, ops = _recurrence_candidate(attacked)
+        recurrence_times.append(time.perf_counter() - start)
+        recurrence_ops.append(ops + attacked["n"] // 3)
+        if verify(attacked, ref)[0]:
+            recurrence_successes += 1
+        # The domain-standard mechanical route is allowed to succeed on Track B;
+        # its cost is the baseline, not a failed attack.
+        ds = time.perf_counter()
+        dfs_answer, dfs_nodes, dfs_capped = _dfs_reference(attacked, 1_000_000)
+        dfs_rows.append({
+            "solved": dfs_answer is not None and verify(attacked, dfs_answer)[0],
+            "nodes": dfs_nodes,
+            "capped": dfs_capped,
+            "wall_seconds": round(time.perf_counter() - ds, 6),
+        })
+    all_failed = all(row["successes"] == 0 for row in attacks.values())
+    dfs_successes = sum(row["solved"] for row in dfs_rows)
+    dfs_median_nodes = int(statistics.median(row["nodes"] for row in dfs_rows))
+    dfs_median_wall = round(
+        statistics.median(row["wall_seconds"] for row in dfs_rows), 6
+    )
+    report["G5_density_and_baseline"].update({
+        "pass": report["G5_density_and_baseline"]["pass"] and dfs_successes == 8,
+        "domain_standard_median_wall_seconds": dfs_median_wall,
+        "domain_standard_median_nodes": dfs_median_nodes,
+        "domain_standard_solved": dfs_successes,
+        "domain_standard_attempts": len(dfs_rows),
+    })
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and recurrence_successes == 8 and dfs_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "anchored loose-cycle depth-first search with fail-first ordering",
+            "complexity": "exponential worst case",
+            "node_cap_each": 1_000_000,
+            "median_nodes": dfs_median_nodes,
+            "median_wall_clock_sec": dfs_median_wall,
+            "solves": f"{dfs_successes}/8, as expected",
+        },
+        "compact_route": {
+            "name": "constant-third-difference reconstruction with exact cycle check",
+            "complexity": "O(n+m) exact modular operations and edge lookups",
+            "median_wall_clock_sec": round(statistics.median(recurrence_times), 8),
+            "median_operations": int(statistics.median(recurrence_ops)),
+            "solves": f"{recurrence_successes}/8, as expected",
+        },
+    }
+
+    doubled = make_instance(
+        n=2 * ship_params["n"], layers=ship_params["layers"], seed=77
+    )
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and search_space(doubled) > search_space(inst),
+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "shipping_space_bits": round(math.log2(search_space(inst)), 3),
+        "doubled_space_bits": round(math.log2(search_space(doubled)), 3),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    real_transform_checks = 0
+    failures = []
+    unrelated = []
+    for seed in range(20):
+        original = make_instance(n=18, layers=6, seed=70_000 + seed)
+        key = canonical_key(original)
+        unrelated.append(key)
+        for variant_id in range(3):
+            transformed = _transform_instance(
+                original, random.Random(80_000 + 10 * seed + variant_id)
+            )
+            invariance_checks += 1
+            if canonical_key(transformed) != key:
+                failures.append([seed, variant_id, "key_changed"])
+            ok, reason = verify(transformed, transformed["answer"])
+            real_transform_checks += 1
+            if not ok:
+                failures.append([seed, variant_id, reason])
+    distinct = len(set(unrelated))
+    report["G8_canonical_key"] = {
+        "pass": not failures and distinct == 20,
+        "invariance_checks": invariance_checks,
+        "real_transformation_checks": real_transform_checks,
+        "distinct_unrelated": distinct,
+        "unrelated_total": 20,
+        "failures": failures,
+        "transformations": "arbitrary vertex renaming composed with hyperedge reorder",
+        "invariant": "10-round anchored WL incidence signature plus edge-intersection multiset",
+    }
+
+    answer_chars, answer_tokens, answer_elements = _answer_metrics(inst)
+    intended_ops = 3 * (inst["n"] - 4) + inst["n"] // 3 + 6
+    arms = json.loads(json.dumps(G9_RESULTS["arms"]))
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    within_caps = (
+        answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        isinstance(value, dict) and value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G")
+    )
+    report["shipping_params"] = dict(ship_params)
+    return report
+
+
+# Set the static profile field from the same worst-case formula used by G9.
+_shipping_probe = {"n": DIFFICULTY[SHIPPING_DIFFICULTY]["n"]}
+_profile_chars = 8 * _shipping_probe["n"] + 1
+PROBLEM_PROFILE["max_answer_tokens"] = math.ceil(_profile_chars / 4)
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

