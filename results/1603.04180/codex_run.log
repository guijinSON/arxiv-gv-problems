+def make_instance(
+    n: int,
+    seed: int = 0,
+    m: int = 4,
+    layers: int = 2,
+    blocks: int | None = None,
+    **params,
+) -> dict:
+    """Inverse-generate simultaneous connectors in a modular 4-graph.
 
-    # Map the already chosen certificate order to an injective cubic (Newton-form)
