+def _transform_blocks(inst: dict) -> tuple[dict, list[list[int]]]:
+    q = inst["q"]
+    blocks = inst["blocks"]
+    out = copy.deepcopy(inst)
+    carried = []
+    for pair in inst["answer"]:
+        new_pair = []
