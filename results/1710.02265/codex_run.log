+def _random_restart_attack(inst: dict, seed: int, restarts: int = 256) -> list[int] | None:
+    rng = random.Random(seed ^ 0x171002265)
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate
+    return None
