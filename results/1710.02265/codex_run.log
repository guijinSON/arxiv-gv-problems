+def _outlier_attack(inst: dict) -> list[int]:
+    """Pick columns with smallest centered L1 norm."""
+    ranked = sorted(
+        range(inst["n"]),
+        key=lambda i: (
+            sum(_centered(value, inst["modulus"]) for value in inst["columns"][i]),
+            i,
+        ),
+    )
+    return sorted(ranked[:inst["weight"]])
