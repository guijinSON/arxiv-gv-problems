-    swapped = list(base)
-    swapped[0], swapped[1] = swapped[1], swapped[0]
-    duplicate = list(base)
-    duplicate[1] = duplicate[0]
-    outside = list(base)
-    outside[-1] = inst["n"]
-    corruptions = {
