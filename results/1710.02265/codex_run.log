-        "base_answer_elements": len(inst["answer"]),
-        "doubled_answer_elements": len(doubled["answer"]),
-        "doubled_verification": doubled_reason,
-        "escalation_axes": ["n", "field_slack"],
-    }
-
-    invariant_checks = 0
-    carried_checks = 0
-    unrelated_keys = []
-    for seed in range(20):
