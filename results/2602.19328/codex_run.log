+        "distinct_reasons": len(set(g2_reasons)),
+    }
+
+    response = (
+        "I used the repeated incidence pattern.\n```json\n<answer>\n"
+        + json.dumps(shipping["answer"])
+        + "\n</answer>\n```\n"
+    )
+    parsed = parse_answer(response)
