+    # supported prime would exceed the cap, so this is genuinely cap-bound.
+    if q >= 83:
+        return "cap_bound"
+    for candidate in range(q + 2, 84):
+        if _is_prime(candidate):
+            p["q"] = candidate
+            p["n"] = min(candidate * candidate, max(n, 4 * candidate))
+            return p
+    return "cap_bound"
