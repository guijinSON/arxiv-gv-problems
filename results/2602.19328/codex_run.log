+    ),
+    "hardness_basis": (
+        "Track B: although Theorem 1(ii) places weighted restricted insertion "
+        "with weights {1,2,3} and b=1 in an NP-complete regime, this affine "
+        "subdistribution has an O(n+q^3) exhaustive affine-line scan; at the "
+        "shipping medium preset (q=73,n=1400) it uses about 3,500 hash probes "
+        "and under 0.002 s on this machine, while a solver that spots the "
+        "parallel-line symmetry needs at most 2q=146 modular arithmetic steps."
+    ),
+    "max_answer_tokens": 360,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
