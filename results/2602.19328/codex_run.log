+def _reference_affine_scan(inst):
+    """Successful O(n+q^3) algorithm disclosed by the Track B claim."""
+    q = inst["q"]
+    lookup = {tuple(pair): i for i, pair in enumerate(inst["triples"])}
+    probes = 0
+    for slope in range(q):
