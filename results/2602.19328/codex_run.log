+def _relabel_instance(inst, order, unit, tx, ty, swap_xy=False):
+    """Apply a genuine graph relabelling and carry the certificate through it."""
+    q = inst["q"]
+    transformed = []
+    for old_index in order:
+        x, y = inst["triples"][old_index]
+        x2 = (unit * x + tx) % q
+        y2 = (unit * y + ty) % q
+        if swap_xy:
+            x2, y2 = y2, x2
+        transformed.append([x2, y2])
