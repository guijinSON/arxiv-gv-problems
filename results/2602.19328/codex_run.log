+    if planted is None:
+        raise AssertionError(why)
+    result = {k: v for k, v in inst.items() if k not in ("triples", "answer")}
+    result["triples"] = transformed
+    result["answer"] = _answer_from_indices(old_to_new[i] for i in planted)
+    return result
