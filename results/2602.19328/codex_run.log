+        ),
+        "strongest_attack_candidate_scans_8_seeds": attack_stats["random_restart_256_disjoint"]["operations"],
+        "reference_wall_clock_sec_8_seeds": round(ref_seconds, 6),
+        "reference_membership_probes_8_seeds": ref_probes,
