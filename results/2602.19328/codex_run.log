 return pts,a,b

def good(sel,P,q):
 if len(set(sel))<q:return False
 X=set();Y=set();Z=set()
 for i in sel:
  x,y=P[i];X.add(x);Y.add(y);Z.add((x+y)%q)
 return len(X)==len(Y)==len(Z)==q

def greedy(P,q):
 cov=[set(),set(),set()];rem=set(range(len(P)));out=[]
 for _ in range(q):
  def sc(i):
   x,y=P[i];z=(x+y)%q
   return ((x not in cov[0])+(y not in cov[1])+(z not in cov[2]),-i)
  i=max(rem,key=sc);out.append(i);rem.remove(i);x,y=P[i];cov[0].add(x);cov[1].add(y);cov[2].add((x+y)%q)
 return out

def outlier(P,q):
 dx=[0]*q;dy=[0]*q;dz=[0]*q
 for x,y in P:dx[x]+=1;dy[y]+=1;dz[(x+y)%q]+=1
 mean=3*len(P)/q
 z=sorted(range(len(P)),key=lambda i:(abs(dx[P[i][0]]+dy[P[i][1]]+dz[sum(P[i])%q]-mean),i))[:q]
 return z

def rr(P,q,r,R=256):
 best=[]
 for _ in range(R):
  ids=list(range(len(P)));r.shuffle(ids); usedx=set();usedy=set();usedz=set();out=[]
  for i in ids:
   x,y=P[i];z=(x+y)%q
   if x not in usedx and y not in usedy and z not in usedz:
    out.append(i);usedx.add(x);usedy.add(y);usedz.add(z)
    if len(out)==q:return out
  if len(out)>len(best):best=out
 return best+ [i for i in range(len(P)) if i not in best][:q-len(best)]
def ansatz(P,q,a=1):
