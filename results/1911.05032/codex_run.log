+                codegree[i][j] += 1
+                codegree[j][i] += 1
+    link_signatures = sorted(
+        (degree[i], tuple(sorted(codegree[i][j] for j in range(size) if j != i)))
+        for i in range(size)
+    )
+    pair_codegrees = sorted(
+        codegree[i][j] for i in range(size) for j in range(i + 1, size)
