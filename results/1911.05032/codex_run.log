+    def propagate(colors: list[int]) -> bool:
+        nonlocal operations
+        while True:
+            changed = False
+            ones = sum(value == 1 for value in colors)
+            zeros = sum(value == 0 for value in colors)
+            operations += size
+            undecided = size - ones - zeros
+            if ones > k or zeros > k or ones + undecided < k or zeros + undecided < k:
+                return False
+            if ones == k:
