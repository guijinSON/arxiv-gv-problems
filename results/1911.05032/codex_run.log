+        residue = internal % 3
+        public_h1[public] = (1, 0, 1)[residue]
+        public_h2[public] = (0, 1, 1)[residue]
+    assignments = [
+        public_base,
+        [public_base[v] ^ public_h1[v] for v in range(n)],
+        [public_base[v] ^ public_h2[v] for v in range(n)],
+    ]
+
+    constraints = _constraints_from(variable_pairs, equations)
+    answer_stub = {
+        "n": n,
+        "variable_pairs": variable_pairs,
+    }
+    answer = _bits_to_answer(answer_stub, assignments)
+    return {
+        "family": "Diverse 3-Hitting Set with total Hamming diversity",
+        "n": n,
+        "d": 3,
+        "r": 3,
+        "k": n,
+        "threshold": 4 * n,
+        "universe_size": 2 * n,
+        "variable_pairs": variable_pairs,
+        "equation_layers": equation_layers,
+        "equations": equations,
+        "constraints": constraints,
+        "answer": answer,
+    }
+
+
+def render(inst):
+    n = inst["n"]
+    pair_lines = "\n".join(
+        f"  {v}: {pair[0]} {pair[1]}"
+        for v, pair in enumerate(inst["variable_pairs"])
+    )
+    layer_chunks = []
+    for layer_index, layer in enumerate(inst["equation_layers"]):
+        rows = "\n".join(
+            f"  {a} {b} {c} : {parity}" for a, b, c, parity in layer
+        )
+        layer_chunks.append(f"Block {layer_index}:\n{rows}")
+    layers = "\n\n".join(layer_chunks)
+
+    statement = f"""Find a diverse collection of hitting sets.
+
+The universe is the integer IDs 0 through {2 * n - 1}.  A hitting set is a
+subset of these IDs that intersects every member of the family F described
+below.  You must return exactly three hitting sets T0,T1,T2, each of size at
+most k={n}.  Repeated IDs inside one set are not allowed; the order of IDs and
+the order of the three sets do not matter.
+
+For finite sets A and B, their Hamming distance is their symmetric-difference
+size |(A\\B) union (B\\A)|.  The required total diversity is
+
+  d(T0,T1) + d(T0,T2) + d(T1,T2) >= {inst['threshold']}.
+
+The family F is a 3-Hitting Set instance.  It is specified exactly by the next
+two rules.
+
+1. Variable-pair constraints.  For every variable v, F contains the displayed
+   two-element set.  The first ID on its line represents bit 0 and the second
+   represents bit 1.
+
+{pair_lines}
+
+2. Parity-gadget constraints.  A displayed row "a b c : p" denotes four
+   three-element members of F.  For each bit triple (A,B,C) with
+   A XOR B XOR C != p, F contains
+
+     {{ opposite(a,A), opposite(b,B), opposite(c,C) }},
+
+   where opposite(v,0) is v's bit-1 ID and opposite(v,1) is v's bit-0 ID from
+   the table above.  Thus the row is only exact shorthand for four ordinary
+   members of F; XOR is addition modulo 2.  Every row in every block contributes
+   its four members.  Block boundaries and row order do not add constraints.
+
+{layers}
+
+Return the three sets as one JSON array of three JSON arrays of decimal universe
+IDs.  All three inner arrays must have exactly {n} distinct IDs.  No ellipses or
+comments are permitted.  A format-only example for a hypothetical two-variable
+instance is [[0,3],[1,2],[0,2]].
+
+Give your final answer inside <answer></answer> tags, as the JSON array just
+specified.
+Example: <answer>[[0,3],[1,2],[0,2]]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def _json_candidate(text):
+    try:
+        value = json.loads(text.strip())
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, list) else None
+
+
+def parse_answer(text):
+    """Parse a JSON witness from tags, a Markdown fence, or surrounding prose."""
+    if not isinstance(text, str):
+        return None
+    tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
+                        flags=re.IGNORECASE | re.DOTALL)
+    for body in reversed(tagged):
+        value = _json_candidate(body)
+        if value is not None:
+            return value
+    fenced = re.findall(r"```(?:json)?\s*(.*?)```", text,
+                        flags=re.IGNORECASE | re.DOTALL)
+    for body in reversed(fenced):
+        value = _json_candidate(body)
+        if value is not None:
+            return value
+    value = _json_candidate(text)
+    if value is not None:
+        return value
+    decoder = json.JSONDecoder()
+    starts = [i for i, char in enumerate(text) if char == "["]
+    for start in reversed(starts):
+        try:
+            value, _ = decoder.raw_decode(text[start:])
+        except ValueError:
+            continue
+        if isinstance(value, list):
+            return value
+    return None
+
+
+def verify(inst, answer):
+    """Check any valid diverse hitting-set witness, never the planted answer."""
+    if not isinstance(answer, list) or len(answer) != inst["r"]:
+        return False, "answer must be a JSON list of exactly three hitting sets"
+    normalized = []
+    for index, candidate in enumerate(answer):
+        if not isinstance(candidate, list) or len(candidate) != inst["k"]:
+            return False, f"hitting set {index} must contain exactly k={inst['k']} IDs"
+        if any(isinstance(value, bool) or not isinstance(value, int)
+               for value in candidate):
+            return False, f"hitting set {index} contains a non-integer ID"
+        if any(value < 0 or value >= inst["universe_size"] for value in candidate):
+            return False, f"hitting set {index} contains an out-of-range universe ID"
+        chosen = set(candidate)
+        if len(chosen) != len(candidate):
+            return False, f"hitting set {index} repeats an ID"
+        for constraint_index, constraint in enumerate(inst["constraints"]):
+            if chosen.isdisjoint(constraint):
+                return False, (
+                    f"hitting set {index} misses family constraint "
+                    f"{constraint_index}"
+                )
+        normalized.append(chosen)
+    diversity = sum(
+        len(normalized[i] ^ normalized[j])
+        for i in range(inst["r"])
+        for j in range(i + 1, inst["r"])
+    )
+    if diversity < inst["threshold"]:
+        return False, (
+            f"total Hamming diversity is {diversity}, below "
+            f"{inst['threshold']}"
+        )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample uniformly after enforcing pair shape and maximum diversity."""
+    assignments = [[0] * inst["n"] for _ in range(3)]
+    for variable in range(inst["n"]):
+        pattern = _PATTERNS[rng.randrange(len(_PATTERNS))]
+        for solution in range(3):
+            assignments[solution][variable] = pattern[solution]
+    return _bits_to_answer(inst, assignments)
+
+
+def search_space(inst):
+    return 6 ** inst["n"]
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    total = 0
+    for choices in itertools.product(range(6), repeat=inst["n"]):
+        assignments = [[0] * inst["n"] for _ in range(3)]
+        for variable, choice in enumerate(choices):
+            pattern = _PATTERNS[choice]
+            for solution in range(3):
+                assignments[solution][variable] = pattern[solution]
+        total += int(verify(inst, _bits_to_answer(inst, assignments))[0])
+    return total
+
+
+def _cycle_from_layer(layer, n):
+    """Recover either cyclic variable order from an unordered row set."""
+    scopes = [frozenset(row[:3]) for row in layer]
+    if n == 3:
+        return list(scopes[0])
+    neighbors = [[] for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            if len(scopes[i] & scopes[j]) == 2:
+                neighbors[i].append(j)
+                neighbors[j].append(i)
+    if any(len(items) != 2 for items in neighbors):
+        raise ValueError("layer is not a cyclic recurrence")
+    start = min(range(n), key=lambda i: tuple(sorted(scopes[i])))
+    first_neighbor = min(neighbors[start], key=lambda i: tuple(sorted(scopes[i])))
+    scope_order = [start, first_neighbor]
+    while len(scope_order) < n:
+        previous, current = scope_order[-2], scope_order[-1]
+        nxt = neighbors[current][0]
+        if nxt == previous:
+            nxt = neighbors[current][1]
+        if nxt == start:
+            break
+        scope_order.append(nxt)
+    if len(scope_order) != n:
+        raise ValueError("layer cycle closed at the wrong length")
+    sequence = []
+    for position in range(n):
+        current = scopes[scope_order[position]]
+        previous = scopes[scope_order[(position - 1) % n]]
+        difference = current - previous
+        if len(difference) != 1:
+            raise ValueError("cannot recover layer variable cycle")
+        sequence.append(next(iter(difference)))
+    if len(set(sequence)) != n:
+        raise ValueError("layer cycle does not cover every variable")
+    return sequence
+
+
+def canonical_key(inst):
+    """Canonicalize recurrence incidence under relabelling and input order.
+
+    Every layer is itself a cycle hypergraph.  Each possible layer is used as a
+    coordinate frame, both orientations are tried, and the lexicographically
+    least multiset of all ternary scopes is retained.  Literal names, variable
+    names, RHS bits, row order, and layer order therefore disappear.
+    """
+    n = inst["n"]
+    if n == 3:
+        payload = [n, len(inst["equation_layers"]), 1]
+        return hashlib.sha256(json.dumps(payload).encode()).hexdigest()
+    all_scopes = [frozenset(row[:3]) for layer in inst["equation_layers"]
+                  for row in layer]
+    encodings = []
+    for layer in inst["equation_layers"]:
+        sequence = _cycle_from_layer(layer, n)
+        for oriented in (sequence, list(reversed(sequence))):
+            # The input contains every cyclic shift of every layer scope, so a
+            # rotation of this coordinate frame only permutes encoded_scopes.
+            # Trying both orientations is sufficient and avoids n redundant
+            # sorts during the 140-case relabelling audit.
+            coordinate = {variable: i for i, variable in enumerate(oriented)}
+            encoded_scopes = sorted(
+                tuple(sorted(coordinate[v] for v in scope))
+                for scope in all_scopes
+            )
+            encodings.append(encoded_scopes)
+    payload = [n, len(inst["equation_layers"]), min(encodings)]
+    blob = json.dumps(payload, separators=(",", ":"))
+    return hashlib.sha256(blob.encode()).hexdigest()
+
+
+def escalate(params):
+    current = dict(params)
+    n = int(current.get("n", 3))
+    layers = int(current.get("layers", 1))
+    # First crowd the same answer length with another independent recurrence
+    # layer.  Once that axis reaches ten, increase n while respecting both caps.
+    available = sum(
+        1 for u in range(1, n)
+        if math.gcd(u, n) == 1 and u < (-u) % n
+    )
+    if layers < min(10, available):
+        current["layers"] = layers + 1
+        return current
+    next_n = n + 3
+    if 3 * next_n > 256 or (10 * next_n) // 3 - 4 > 300:
+        return "cap_bound"
+    current["n"] = next_n
+    next_available = sum(
+        1 for u in range(1, next_n)
+        if math.gcd(u, next_n) == 1 and u < (-u) % next_n
+    )
+    current["layers"] = min(layers, next_available)
+    return current
+
+
+def _compact_solve(inst):
+    """Solve using one ordered recurrence block; never consult answer."""
+    n = inst["n"]
+    layer = inst["equation_layers"][0]
+    if n == 3:
+        sequence = list(layer[0][:3])
+    else:
+        scopes = [set(row[:3]) for row in layer]
+        sequence = []
+        for index in range(n):
+            difference = scopes[index] - scopes[(index - 1) % n]
+            if len(difference) != 1:
+                # Row order is part of the compact presentation, but transformed
+                # selftests may shuffle it; fall back to structural recovery.
+                sequence = _cycle_from_layer(layer, n)
+                break
+            sequence.append(next(iter(difference)))
+    rhs_by_scope = {frozenset(row[:3]): row[3] for row in layer}
+    base = [0] * n
+    base[sequence[0]] = 0
+    base[sequence[1]] = 0
+    for index in range(n - 2):
+        a, b, c = sequence[index:index + 3]
+        base[c] = base[a] ^ base[b] ^ rhs_by_scope[frozenset((a, b, c))]
+    h1 = [0] * n
+    h2 = [0] * n
+    for index, variable in enumerate(sequence):
+        h1[variable] = (1, 0, 1)[index % 3]
+        h2[variable] = (0, 1, 1)[index % 3]
+    assignments = [
+        base,
+        [base[v] ^ h1[v] for v in range(n)],
+        [base[v] ^ h2[v] for v in range(n)],
+    ]
+    return _bits_to_answer(inst, assignments)
+
+
+def _gaussian_reference(inst):
+    """Exact RREF over GF(2), with primitive-operation accounting."""
+    n = inst["n"]
+    matrix = []
+    for a, b, c, parity in inst["equations"]:
+        row = [0] * (n + 1)
+        row[a] = row[b] = row[c] = 1
+        row[n] = parity
+        matrix.append(row)
+    counts = {
+        "pivot_tests": 0,
+        "row_bit_tests": 0,
+        "bit_xors": 0,
+        "swaps": 0,
+    }
+    pivot_columns = []
+    rank = 0
+    for column in range(n):
+        pivot = None
+        for row_index in range(rank, len(matrix)):
+            counts["pivot_tests"] += 1
+            if matrix[row_index][column]:
+                pivot = row_index
+                break
+        if pivot is None:
+            continue
+        if pivot != rank:
+            matrix[rank], matrix[pivot] = matrix[pivot], matrix[rank]
+            counts["swaps"] += 1
+        for row_index in range(len(matrix)):
+            if row_index == rank:
+                continue
+            counts["row_bit_tests"] += 1
+            if matrix[row_index][column]:
+                for j in range(column, n + 1):
+                    matrix[row_index][j] ^= matrix[rank][j]
+                    counts["bit_xors"] += 1
+        pivot_columns.append(column)
+        rank += 1
+    for row in matrix:
+        if not any(row[:n]) and row[n]:
+            return None, counts
+    free_columns = [column for column in range(n)
+                    if column not in set(pivot_columns)]
+    if len(free_columns) != 2:
+        return None, counts
+    particular = [0] * n
+    for row_index, column in enumerate(pivot_columns):
+        particular[column] = matrix[row_index][n]
+    null_basis = []
+    for free in free_columns:
+        vector = [0] * n
+        vector[free] = 1
+        for row_index, column in enumerate(pivot_columns):
+            vector[column] = matrix[row_index][free]
+        null_basis.append(vector)
+    assignments = [
+        particular,
+        [particular[v] ^ null_basis[0][v] for v in range(n)],
+        [particular[v] ^ null_basis[1][v] for v in range(n)],
+    ]
+    counts["operations"] = sum(counts.values())
+    return _bits_to_answer(inst, assignments), counts
+
+
+def _greedy_candidate(inst):
+    n = inst["n"]
+    equations_by_max = [[] for _ in range(n)]
+    for equation in inst["equations"]:
+        equations_by_max[max(equation[:3])].append(equation)
+    assignments = [[None] * n for _ in range(3)]
+    for variable in range(n):
+        best_pattern = None
+        best_score = -1
+        for pattern in _PATTERNS:
+            for solution in range(3):
+                assignments[solution][variable] = pattern[solution]
+            score = 0
+            for a, b, c, parity in equations_by_max[variable]:
+                for solution in range(3):
+                    values = (assignments[solution][a], assignments[solution][b],
+                              assignments[solution][c])
+                    if None not in values and (values[0] ^ values[1] ^ values[2]) == parity:
+                        score += 1
+            if score > best_score:
+                best_score = score
+                best_pattern = pattern
+        for solution in range(3):
+            assignments[solution][variable] = best_pattern[solution]
+    return _bits_to_answer(inst, assignments)
+
+
+def _attack_candidates(inst, seed):
+    n = inst["n"]
+    frequencies = [0] * inst["universe_size"]
+    for constraint in inst["constraints"]:
+        for element in constraint:
+            frequencies[element] += 1
+    outlier_assignments = [[0] * n for _ in range(3)]
+    for variable, pair in enumerate(inst["variable_pairs"]):
+        preferred = min((0, 1), key=lambda bit: (-frequencies[pair[bit]], pair[bit]))
+        pattern = (preferred, preferred, 1 - preferred)
+        for solution in range(3):
+            outlier_assignments[solution][variable] = pattern[solution]
+
+    public_period = [[0] * n for _ in range(3)]
+    for variable in range(n):
+        h1 = (1, 0, 1)[variable % 3]
+        h2 = (0, 1, 1)[variable % 3]
+        public_period[0][variable] = 0
+        public_period[1][variable] = h1
+        public_period[2][variable] = h2
+
+    majority = [0] * n
+    for variable in range(n):
+        parities = [row[3] for row in inst["equations"] if variable in row[:3]]
+        majority[variable] = int(sum(parities) * 2 > len(parities))
+    majority_assignments = [
+        majority,
+        [majority[v] ^ (1, 0, 1)[v % 3] for v in range(n)],
+        [majority[v] ^ (0, 1, 1)[v % 3] for v in range(n)],
+    ]
+
+    rng = random.Random(seed ^ 0x191105032)
+    restarts = [random_candidate(inst, rng) for _ in range(256)]
+    return {
+        "outlier_literal_frequency": [_bits_to_answer(inst, outlier_assignments)],
+        "greedy_coordinate_patterns": [_greedy_candidate(inst)],
+        "random_restart_256": restarts,
+        "public_index_period_three": [_bits_to_answer(inst, public_period)],
+        "local_rhs_majority": [_bits_to_answer(inst, majority_assignments)],
+    }
+
+
+def _relabel_variants(inst, seed):
+    rng = random.Random(seed)
+    n = inst["n"]
+    literal_perm = list(range(2 * n))
+    variable_perm = list(range(n))
+    rng.shuffle(literal_perm)
+    rng.shuffle(variable_perm)
+
+    variants = []
+    for mask in range(1, 8):
+        out = copy.deepcopy(inst)
+        carried = copy.deepcopy(inst["answer"])
+        if mask & 1:
+            out["variable_pairs"] = [
+                [literal_perm[value] for value in pair]
+                for pair in out["variable_pairs"]
+            ]
+            out["constraints"] = [
+                sorted(literal_perm[value] for value in constraint)
+                for constraint in out["constraints"]
+            ]
+            carried = [sorted(literal_perm[value] for value in solution)
+                       for solution in carried]
+        if mask & 2:
+            new_pairs = [None] * n
+            for old, pair in enumerate(out["variable_pairs"]):
+                new_pairs[variable_perm[old]] = pair
+            out["variable_pairs"] = new_pairs
+            for layer in out["equation_layers"]:
+                for row in layer:
+                    row[:3] = [variable_perm[value] for value in row[:3]]
+            out["equations"] = [row for layer in out["equation_layers"] for row in layer]
+        if mask & 4:
+            rng.shuffle(out["equation_layers"])
+            for layer in out["equation_layers"]:
+                rng.shuffle(layer)
+            out["equations"] = [row for layer in out["equation_layers"] for row in layer]
+        out["constraints"] = _constraints_from(out["variable_pairs"], out["equations"])
+        out["answer"] = carried
+        variants.append(out)
+    return variants
+
+
+def _answer_atom_count(value):
+    if isinstance(value, dict):
+        return sum(_answer_atom_count(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atom_count(item) for item in value)
+    return 1
+
+
+def selftest():
+    report = {}
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+
+    g1_failures = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append([preset, seed, why])
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append([preset, seed, "answer is not JSON-native"])
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+        "construction": "inverse generation plus composition of XOR identities",
+    }
+
+    inst = make_instance(seed=19, **shipping)
+    answer = copy.deepcopy(inst["answer"])
+    drop = copy.deepcopy(answer)
+    drop[0].pop()
+    flip = copy.deepcopy(answer)
+    selected = flip[0][0]
+    variable = next(v for v, pair in enumerate(inst["variable_pairs"])
+                    if selected in pair)
+    replacement = next(value for value in inst["variable_pairs"][variable]
+                       if value != selected)
+    flip[0][0] = replacement
+    duplicate = copy.deepcopy(answer)
+    duplicate[0][1] = duplicate[0][0]
+    out_of_range = copy.deepcopy(answer)
+    out_of_range[0][0] = inst["universe_size"]
+    corruptions = {
+        "drop": drop,
+        "swap_one_literal": flip,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    rejected = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        rejected[name] = {"rejected": not ok, "reason": why}
+    reasons = [entry["reason"] for entry in rejected.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(entry["rejected"] for entry in rejected.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": rejected,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    response = (
+        "The cyclic parity recurrence gives these sets.\n```json\n<answer>"
+        + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```\nEach row is in increasing order."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_equals_answer": parsed == answer,
+    }
+
+    guess_rng = random.Random(0x191105032)
+    guess_total = 200_000
+    guess_hits = 0
+    start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
+    guess_seconds = time.perf_counter() - start
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_fraction,
+        "structure_aware_space": str(search_space(inst)),
+        "space_bits": search_space(inst).bit_length(),
+        "sampler_enforces": [
+            "one literal per variable in each hitting set",
+            "maximum possible total diversity 4n",
+        ],
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    attack_names = [
+        "outlier_literal_frequency",
+        "greedy_coordinate_patterns",
+        "random_restart_256",
+        "public_index_period_three",
+        "local_rhs_majority",
+    ]
+    successes = {name: 0 for name in attack_names}
+    attack_seconds = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    compact_successes = 0
+    reference_seconds = 0.0
+    reference_operations = 0
+    reference_breakdown = {key: 0 for key in
+                           ("pivot_tests", "row_bit_tests", "bit_xors", "swaps")}
+    for seed in range(101, 109):
+        trial = make_instance(seed=seed, **shipping)
+        candidates = _attack_candidates(trial, seed)
+        for name in attack_names:
+            started = time.perf_counter()
+            won = any(verify(trial, candidate)[0] for candidate in candidates[name])
+            attack_seconds[name] += time.perf_counter() - started
+            successes[name] += int(won)
+        started = time.perf_counter()
+        recovered, counts = _gaussian_reference(trial)
+        reference_seconds += time.perf_counter() - started
+        reference_successes += int(
+            recovered is not None and verify(trial, recovered)[0]
+        )
+        reference_operations += counts.get("operations", sum(counts.values()))
+        for key in reference_breakdown:
+            reference_breakdown[key] += counts[key]
+        compact_successes += int(verify(trial, _compact_solve(trial))[0])
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_seconds[name], 6),
+        }
+        for name in attack_names
+    }
+    reference = {
+        "name": "recognize parity gadgets and run exact GF(2) Gaussian elimination",
+        "complexity": "O(m*n^2+n^3) primitive bit operations",
+        "wall_clock_sec": round(reference_seconds / 8, 6),
+        "operations": reference_operations // 8,
+        "operation_breakdown": {
+            key: value // 8 for key, value in reference_breakdown.items()
+        },
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    all_failed = all(value == 0 for value in successes.values())
+    intended_operations = (10 * inst["n"]) // 3 - 4
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8 and compact_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": reference,
+        "intended_compact_route": {
+            "name": "one-block cyclic propagation plus two period-three masks",
+            "operations_upper_bound": intended_operations,
+            "solves": f"{compact_successes}/8",
+        },
+    }
+
+    demo_count = enumerate_all(make_instance(seed=3, **DIFFICULTY["demo"]))
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_fraction < 1e-6
+        and demo_count == 24
+        and all_failed
+        and reference_successes == 8,
+        "shipping_sample_hits": guess_hits,
+        "shipping_sample_total": guess_total,
+        "shipping_sample_density": guess_fraction,
+        "shipping_exact_valid_count": 24,
+        "shipping_exact_density": f"24/6^{inst['n']}",
+        "exact_count_reason": (
+            "one recurrence layer has rank n-2; its four affine solutions "
+            "yield exactly 4P3=24 maximum-diversity ordered triples"
+        ),
+        "demo_exact_solution_count": demo_count,
+        "baseline_attack": "random_restart_256",
+        "baseline_attack_wall_clock_sec": round(
+            attack_seconds["random_restart_256"] / 8, 6
+        ),
+        "baseline_attack_iterations": 256,
+        "reference_wall_clock_sec": reference["wall_clock_sec"],
+        "reference_operation_count": reference["operations"],
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] *= 2
+    doubled_params["layers"] = min(
+        doubled_params["layers"],
+        sum(1 for u in range(1, doubled_params["n"])
+            if math.gcd(u, doubled_params["n"]) == 1
+            and u < (-u) % doubled_params["n"]),
+    )
+    started = time.perf_counter()
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_build = time.perf_counter() - started
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    ladder = [DIFFICULTY[name]["n"] for name in DIFFICULTY]
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["n"] == 2 * inst["n"]
+        and len(render(doubled)) > len(render(inst))
+        and ladder == sorted(ladder)
+        and len(set(ladder)) == len(ladder),
+        "shipping_n": inst["n"],
+        "shipping_layers": len(inst["equation_layers"]),
+        "doubled_n": doubled["n"],
+        "doubled_layers": len(doubled["equation_layers"]),
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_why,
+        "candidate_space_bits_shipping": search_space(inst).bit_length(),
+        "candidate_space_bits_doubled": search_space(doubled).bit_length(),
+    }
+
+    invariant_count = 0
+    real_transform_count = 0
+    unrelated_keys = []
+    for seed in range(201, 221):
+        original = make_instance(seed=seed, **shipping)
+        key = canonical_key(original)
+        for transformed in _relabel_variants(original, seed ^ 0x5A5A):
+            invariant_count += int(key == canonical_key(transformed))
+            real_transform_count += int(verify(transformed, transformed["answer"])[0])
+        unrelated_keys.append(key)
+    distinct_count = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant_count == 140
+        and real_transform_count == 140
+        and distinct_count == 20,
+        "invariant_relabellings": invariant_count,
+        "invariance_attempts": 140,
+        "real_transformations_verified": real_transform_count,
+        "unrelated_distinct_keys": distinct_count,
+        "unrelated_attempts": 20,
+        "transformations": [
+            "arbitrary universe-ID permutation with carried witness",
+            "arbitrary variable renumbering",
+            "layer and equation-row reordering",
+            "all nonempty compositions of those three",
+        ],
+    }
+
+    encoded_answer = json.dumps(inst["answer"], separators=(",", ":"))
+    answer_chars = len(encoded_answer)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atom_count(inst["answer"])
+    width = len(str(inst["universe_size"] - 1))
+    worst_case_answer_chars = 7 + 3 * inst["n"] * (width + 1)
+    worst_case_answer_tokens = math.ceil(worst_case_answer_chars / 4)
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
+        for name in ("bare", "hinted", "placebo")
+    }
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = (hinted["solved"] / hinted["attempts"]
+                   if hinted["attempts"] and hinted["solved"] is not None else None)
+    placebo_rate = (placebo["solved"] / placebo["attempts"]
+                    if placebo["attempts"] and placebo["solved"] is not None else None)
+    hinted_delta = (hinted_rate - placebo_rate
+                    if hinted_rate is not None and placebo_rate is not None else None)
+    within_caps = (
+        answer_chars <= 2_000
+        and answer_elements <= 256
+        and intended_operations <= 300
+        and PROBLEM_PROFILE["max_answer_tokens"] == worst_case_answer_tokens
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_delta,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "worst_case_answer_chars": worst_case_answer_chars,
+        "worst_case_answer_tokens": worst_case_answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(shipping)
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(value.get("pass") is True for value in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

