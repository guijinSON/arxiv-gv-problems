import random,itertools

def make(p,seed,b):
 R={x*x%p for x in range(1,p)}; U=list(range(1,p))
 mixed=[t for t in itertools.combinations(U,3) if 0<sum(x in R for x in t)<3]
 rng=random.Random(seed);reps=rng.sample(mixed,b);E=set()
 for t in reps:
  for a in U:E.add(tuple(sorted(a*x%p for x in t)))
 E=list(E);rng.shuffle(E);return E,R

def valid(p,E,A):
 A=set(A);B=set(range(1,p))-A;k=(p-1)//2
 return len(A)==k and all(A&set(e) and B&set(e) for e in E)

def greedy(p,E):
 n=p-1;k=n//2;inc={x:[] for x in range(1,p)}
 for e in E:
  for x in e:inc[x].append(e)
 assign={};cnt=[0,0]
 # labels order; for each color count edges made mono now, then capacity, tie balance
 for x in range(1,p):
  choices=[]
  for c in (0,1):
   if cnt[c]>=k:continue
   bad=0
   for e in inc[x]:
    others=[y for y in e if y"'!=x]
    if all(y in assign and assign[y]==c for y in others):bad+=1
   choices.append((bad,cnt[c],c))
  c=min(choices)[2];assign[x]=c;cnt[c]+=1
 return [x for x,c in assign.items() if c==0]
for p,b in [(31,12),(59,16),(83,20),(127,24)]:
 stats={'"'degree':0,'greedy':0,'parity':0,'interval':0}
 for s in range(100):
  E,R=make(p,s,b);k=(p-1)//2
  deg={x:0 for x in range(1,p)}
  for e in E:
   for x in e:deg[x]+=1
  A=[x for x in sorted(deg,key=lambda x:(-deg[x],x))[:k]]
  stats['degree']+=valid(p,E,A)
  stats['greedy']+=valid(p,E,greedy(p,E))
  stats['parity']+=valid(p,E,[x for x in range(1,p) if x%2])
  stats['interval']+=valid(p,E,range(1,k+1))
 print(p,b,stats)
