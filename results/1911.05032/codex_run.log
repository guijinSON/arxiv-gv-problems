+    # order the two masks have period 101 and 011; every coordinate sees a
+    # nonzero functional of the two free bits.
+    public_base = [0] * n
+    public_h1 = [0] * n
+    public_h2 = [0] * n
+    for internal in range(n):
+        public = public_of_internal[internal]
+        public_base[public] = base_internal[internal]
+        residue = internal % 3
+        public_h1[public] = (1, 0, 1)[residue]
+        public_h2[public] = (0, 1, 1)[residue]
