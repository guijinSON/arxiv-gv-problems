+        "n": size,
+        "k": inst["k"],
+        "r": inst["r"],
+        "t": inst["diversity_target"],
+        "edge_sizes": sorted(edge_sizes.items()),
+        "links": link_signatures,
+        "pairs": pair_codegrees,
+    }
