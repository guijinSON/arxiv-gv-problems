+    diversity = sum(
+        len(normalized[i] ^ normalized[j])
+        for i in range(inst["r"])
+        for j in range(i + 1, inst["r"])
+    )
+    if diversity < inst["threshold"]:
+        return False, (
+            f"total Hamming diversity is {diversity}, below "
+            f"{inst['threshold']}"
+        )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample uniformly after enforcing pair shape and maximum diversity."""
+    assignments = [[0] * inst["n"] for _ in range(3)]
+    for variable in range(inst["n"]):
+        pattern = _PATTERNS[rng.randrange(len(_PATTERNS))]
+        for solution in range(3):
+            assignments[solution][variable] = pattern[solution]
+    return _bits_to_answer(inst, assignments)
+
+
+def search_space(inst):
+    return 6 ** inst["n"]
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    total = 0
+    for choices in itertools.product(range(6), repeat=inst["n"]):
+        assignments = [[0] * inst["n"] for _ in range(3)]
+        for variable, choice in enumerate(choices):
+            pattern = _PATTERNS[choice]
+            for solution in range(3):
+                assignments[solution][variable] = pattern[solution]
+        total += int(verify(inst, _bits_to_answer(inst, assignments))[0])
+    return total
+
+
+def _cycle_from_layer(layer, n):
+    """Recover either cyclic variable order from an unordered row set."""
+    scopes = [frozenset(row[:3]) for row in layer]
+    if n == 3:
+        return list(scopes[0])
+    neighbors = [[] for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            if len(scopes[i] & scopes[j]) == 2:
+                neighbors[i].append(j)
+                neighbors[j].append(i)
+    if any(len(items) != 2 for items in neighbors):
+        raise ValueError("layer is not a cyclic recurrence")
+    start = min(range(n), key=lambda i: tuple(sorted(scopes[i])))
+    first_neighbor = min(neighbors[start], key=lambda i: tuple(sorted(scopes[i])))
+    scope_order = [start, first_neighbor]
+    while len(scope_order) < n:
+        previous, current = scope_order[-2], scope_order[-1]
+        nxt = neighbors[current][0]
+        if nxt == previous:
+            nxt = neighbors[current][1]
+        if nxt == start:
+            break
+        scope_order.append(nxt)
+    if len(scope_order) != n:
+        raise ValueError("layer cycle closed at the wrong length")
+    sequence = []
+    for position in range(n):
+        current = scopes[scope_order[position]]
+        previous = scopes[scope_order[(position - 1) % n]]
+        difference = current - previous
+        if len(difference) != 1:
+            raise ValueError("cannot recover layer variable cycle")
+        sequence.append(next(iter(difference)))
+    if len(set(sequence)) != n:
+        raise ValueError("layer cycle does not cover every variable")
+    return sequence
+
+
+def canonical_key(inst):
+    """Canonicalize recurrence incidence under relabelling and input order.
+
+    Every layer is itself a cycle hypergraph.  Each possible layer is used as a
+    coordinate frame, both orientations are tried, and the lexicographically
+    least multiset of all ternary scopes is retained.  Literal names, variable
+    names, RHS bits, row order, and layer order therefore disappear.
+    """
+    n = inst["n"]
+    if n == 3:
+        payload = [n, len(inst["equation_layers"]), 1]
+        return hashlib.sha256(json.dumps(payload).encode()).hexdigest()
+    all_scopes = [frozenset(row[:3]) for layer in inst["equation_layers"]
+                  for row in layer]
+    encodings = []
+    for layer in inst["equation_layers"]:
+        sequence = _cycle_from_layer(layer, n)
+        for oriented in (sequence, list(reversed(sequence))):
+            # The input contains every cyclic shift of every layer scope, so a
+            # rotation of this coordinate frame only permutes encoded_scopes.
+            # Trying both orientations is sufficient and avoids n redundant
+            # sorts during the 140-case relabelling audit.
+            coordinate = {variable: i for i, variable in enumerate(oriented)}
+            encoded_scopes = sorted(
+                tuple(sorted(coordinate[v] for v in scope))
+                for scope in all_scopes
+            )
+            encodings.append(encoded_scopes)
+    payload = [n, len(inst["equation_layers"]), min(encodings)]
+    blob = json.dumps(payload, separators=(",", ":"))
+    return hashlib.sha256(blob.encode()).hexdigest()
+
+
+def escalate(params):
+    current = dict(params)
+    n = int(current.get("n", 3))
+    layers = int(current.get("layers", 1))
+    # First crowd the same answer length with another independent recurrence
+    # layer.  Once that axis reaches ten, increase n while respecting both caps.
+    available = sum(
+        1 for u in range(1, n)
+        if math.gcd(u, n) == 1 and u < (-u) % n
+    )
+    if layers < min(10, available):
+        current["layers"] = layers + 1
+        return current
+    next_n = n + 3
+    if 3 * next_n > 256 or (10 * next_n) // 3 - 4 > 300:
+        return "cap_bound"
+    current["n"] = next_n
+    next_available = sum(
+        1 for u in range(1, next_n)
+        if math.gcd(u, next_n) == 1 and u < (-u) % next_n
+    )
+    current["layers"] = min(layers, next_available)
+    return current
+
+
+def _compact_solve(inst):
+    """Solve using one ordered recurrence block; never consult answer."""
+    n = inst["n"]
+    layer = inst["equation_layers"][0]
+    if n == 3:
+        sequence = list(layer[0][:3])
+    else:
+        scopes = [set(row[:3]) for row in layer]
+        sequence = []
+        for index in range(n):
+            difference = scopes[index] - scopes[(index - 1) % n]
+            if len(difference) != 1:
+                # Row order is part of the compact presentation, but transformed
+                # selftests may shuffle it; fall back to structural recovery.
+                sequence = _cycle_from_layer(layer, n)
+                break
+            sequence.append(next(iter(difference)))
+    rhs_by_scope = {frozenset(row[:3]): row[3] for row in layer}
+    base = [0] * n
+    base[sequence[0]] = 0
+    base[sequence[1]] = 0
+    for index in range(n - 2):
+        a, b, c = sequence[index:index + 3]
+        base[c] = base[a] ^ base[b] ^ rhs_by_scope[frozenset((a, b, c))]
+    h1 = [0] * n
+    h2 = [0] * n
+    for index, variable in enumerate(sequence):
+        h1[variable] = (1, 0, 1)[index % 3]
+        h2[variable] = (0, 1, 1)[index % 3]
+    assignments = [
+        base,
+        [base[v] ^ h1[v] for v in range(n)],
+        [base[v] ^ h2[v] for v in range(n)],
+    ]
+    return _bits_to_answer(inst, assignments)
+
+
+def _gaussian_reference(inst):
+    """Exact RREF over GF(2), with primitive-operation accounting."""
+    n = inst["n"]
+    matrix = []
+    for a, b, c, parity in inst["equations"]:
+        row = [0] * (n + 1)
+        row[a] = row[b] = row[c] = 1
+        row[n] = parity
+        matrix.append(row)
+    counts = {
+        "pivot_tests": 0,
+        "row_bit_tests": 0,
+        "bit_xors": 0,
+        "swaps": 0,
+    }
+    pivot_columns = []
+    rank = 0
+    for column in range(n):
+        pivot = None
+        for row_index in range(rank, len(matrix)):
+            counts["pivot_tests"] += 1
+            if matrix[row_index][column]:
+                pivot = row_index
+                break
+        if pivot is None:
+            continue
+        if pivot != rank:
+            matrix[rank], matrix[pivot] = matrix[pivot], matrix[rank]
+            counts["swaps"] += 1
+        for row_index in range(len(matrix)):
+            if row_index == rank:
+                continue
+            counts["row_bit_tests"] += 1
+            if matrix[row_index][column]:
+                for j in range(column, n + 1):
+                    matrix[row_index][j] ^= matrix[rank][j]
+                    counts["bit_xors"] += 1
+        pivot_columns.append(column)
+        rank += 1
+    for row in matrix:
+        if not any(row[:n]) and row[n]:
+            return None, counts
+    free_columns = [column for column in range(n)
+                    if column not in set(pivot_columns)]
+    if len(free_columns) != 2:
+        return None, counts
+    particular = [0] * n
+    for row_index, column in enumerate(pivot_columns):
+        particular[column] = matrix[row_index][n]
+    null_basis = []
+    for free in free_columns:
+        vector = [0] * n
+        vector[free] = 1
+        for row_index, column in enumerate(pivot_columns):
+            vector[column] = matrix[row_index][free]
+        null_basis.append(vector)
+    assignments = [
+        particular,
+        [particular[v] ^ null_basis[0][v] for v in range(n)],
+        [particular[v] ^ null_basis[1][v] for v in range(n)],
+    ]
+    counts["operations"] = sum(counts.values())
+    return _bits_to_answer(inst, assignments), counts
+
+
+def _greedy_candidate(inst):
+    n = inst["n"]
+    equations_by_max = [[] for _ in range(n)]
+    for equation in inst["equations"]:
+        equations_by_max[max(equation[:3])].append(equation)
+    assignments = [[None] * n for _ in range(3)]
+    for variable in range(n):
+        best_pattern = None
+        best_score = -1
+        for pattern in _PATTERNS:
+            for solution in range(3):
+                assignments[solution][variable] = pattern[solution]
+            score = 0
+            for a, b, c, parity in equations_by_max[variable]:
+                for solution in range(3):
+                    values = (assignments[solution][a], assignments[solution][b],
+                              assignments[solution][c])
+                    if None not in values and (values[0] ^ values[1] ^ values[2]) == parity:
+                        score += 1
+            if score > best_score:
+                best_score = score
+                best_pattern = pattern
+        for solution in range(3):
+            assignments[solution][variable] = best_pattern[solution]
+    return _bits_to_answer(inst, assignments)
+
+
+def _attack_candidates(inst, seed):
+    n = inst["n"]
+    frequencies = [0] * inst["universe_size"]
+    for constraint in inst["constraints"]:
+        for element in constraint:
+            frequencies[element] += 1
+    outlier_assignments = [[0] * n for _ in range(3)]
+    for variable, pair in enumerate(inst["variable_pairs"]):
+        preferred = min((0, 1), key=lambda bit: (-frequencies[pair[bit]], pair[bit]))
+        pattern = (preferred, preferred, 1 - preferred)
+        for solution in range(3):
+            outlier_assignments[solution][variable] = pattern[solution]
+
+    public_period = [[0] * n for _ in range(3)]
+    for variable in range(n):
+        h1 = (1, 0, 1)[variable % 3]
+        h2 = (0, 1, 1)[variable % 3]
+        public_period[0][variable] = 0
+        public_period[1][variable] = h1
+        public_period[2][variable] = h2
+
+    majority = [0] * n
+    for variable in range(n):
+        parities = [row[3] for row in inst["equations"] if variable in row[:3]]
+        majority[variable] = int(sum(parities) * 2 > len(parities))
+    majority_assignments = [
+        majority,
+        [majority[v] ^ (1, 0, 1)[v % 3] for v in range(n)],
+        [majority[v] ^ (0, 1, 1)[v % 3] for v in range(n)],
+    ]
+
+    rng = random.Random(seed ^ 0x191105032)
+    restarts = [random_candidate(inst, rng) for _ in range(256)]
+    return {
+        "outlier_literal_frequency": [_bits_to_answer(inst, outlier_assignments)],
+        "greedy_coordinate_patterns": [_greedy_candidate(inst)],
+        "random_restart_256": restarts,
+        "public_index_period_three": [_bits_to_answer(inst, public_period)],
+        "local_rhs_majority": [_bits_to_answer(inst, majority_assignments)],
+    }
+
+
+def _relabel_variants(inst, seed):
+    rng = random.Random(seed)
+    n = inst["n"]
+    literal_perm = list(range(2 * n))
+    variable_perm = list(range(n))
+    rng.shuffle(literal_perm)
+    rng.shuffle(variable_perm)
+
+    variants = []
+    for mask in range(1, 8):
+        out = copy.deepcopy(inst)
+        carried = copy.deepcopy(inst["answer"])
+        if mask & 1:
+            out["variable_pairs"] = [
+                [literal_perm[value] for value in pair]
+                for pair in out["variable_pairs"]
+            ]
+            out["constraints"] = [
+                sorted(literal_perm[value] for value in constraint)
+                for constraint in out["constraints"]
+            ]
+            carried = [sorted(literal_perm[value] for value in solution)
+                       for solution in carried]
+        if mask & 2:
+            new_pairs = [None] * n
+            for old, pair in enumerate(out["variable_pairs"]):
+                new_pairs[variable_perm[old]] = pair
+            out["variable_pairs"] = new_pairs
+            for layer in out["equation_layers"]:
+                for row in layer:
+                    row[:3] = [variable_perm[value] for value in row[:3]]
+            out["equations"] = [row for layer in out["equation_layers"] for row in layer]
+        if mask & 4:
+            rng.shuffle(out["equation_layers"])
+            for layer in out["equation_layers"]:
+                rng.shuffle(layer)
+            out["equations"] = [row for layer in out["equation_layers"] for row in layer]
+        out["constraints"] = _constraints_from(out["variable_pairs"], out["equations"])
+        out["answer"] = carried
+        variants.append(out)
+    return variants
+
+
+def _answer_atom_count(value):
+    if isinstance(value, dict):
+        return sum(_answer_atom_count(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atom_count(item) for item in value)
+    return 1
+
+
+def selftest():
+    report = {}
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+
+    g1_failures = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append([preset, seed, why])
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append([preset, seed, "answer is not JSON-native"])
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+        "construction": "inverse generation plus composition of XOR identities",
+    }
+
+    inst = make_instance(seed=19, **shipping)
+    answer = copy.deepcopy(inst["answer"])
+    drop = copy.deepcopy(answer)
+    drop[0].pop()
+    flip = copy.deepcopy(answer)
+    selected = flip[0][0]
+    variable = next(v for v, pair in enumerate(inst["variable_pairs"])
+                    if selected in pair)
+    replacement = next(value for value in inst["variable_pairs"][variable]
+                       if value != selected)
+    flip[0][0] = replacement
+    duplicate = copy.deepcopy(answer)
+    duplicate[0][1] = duplicate[0][0]
+    out_of_range = copy.deepcopy(answer)
+    out_of_range[0][0] = inst["universe_size"]
+    corruptions = {
+        "drop": drop,
+        "swap_one_literal": flip,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    rejected = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        rejected[name] = {"rejected": not ok, "reason": why}
+    reasons = [entry["reason"] for entry in rejected.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(entry["rejected"] for entry in rejected.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": rejected,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    response = (
+        "The cyclic parity recurrence gives these sets.\n```json\n<answer>"
+        + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```\nEach row is in increasing order."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_equals_answer": parsed == answer,
+    }
+
+    guess_rng = random.Random(0x191105032)
+    guess_total = 200_000
+    guess_hits = 0
+    start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
+    guess_seconds = time.perf_counter() - start
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_fraction,
+        "structure_aware_space": str(search_space(inst)),
+        "space_bits": search_space(inst).bit_length(),
+        "sampler_enforces": [
+            "one literal per variable in each hitting set",
+            "maximum possible total diversity 4n",
+        ],
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    attack_names = [
+        "outlier_literal_frequency",
+        "greedy_coordinate_patterns",
+        "random_restart_256",
+        "public_index_period_three",
+        "local_rhs_majority",
+    ]
+    successes = {name: 0 for name in attack_names}
+    attack_seconds = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    compact_successes = 0
+    reference_seconds = 0.0
+    reference_operations = 0
+    reference_breakdown = {key: 0 for key in
+                           ("pivot_tests", "row_bit_tests", "bit_xors", "swaps")}
+    for seed in range(101, 109):
+        trial = make_instance(seed=seed, **shipping)
+        candidates = _attack_candidates(trial, seed)
+        for name in attack_names:
+            started = time.perf_counter()
+            won = any(verify(trial, candidate)[0] for candidate in candidates[name])
+            attack_seconds[name] += time.perf_counter() - started
+            successes[name] += int(won)
+        started = time.perf_counter()
+        recovered, counts = _gaussian_reference(trial)
+        reference_seconds += time.perf_counter() - started
+        reference_successes += int(
+            recovered is not None and verify(trial, recovered)[0]
+        )
+        reference_operations += counts.get("operations", sum(counts.values()))
+        for key in reference_breakdown:
+            reference_breakdown[key] += counts[key]
+        compact_successes += int(verify(trial, _compact_solve(trial))[0])
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_seconds[name], 6),
+        }
+        for name in attack_names
