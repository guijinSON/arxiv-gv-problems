+    def propagate(colors: list[int]) -> bool:
+        nonlocal operations
+        while True:
+            changed = False
+            ones = sum(value == 1 for value in colors)
+            zeros = sum(value == 0 for value in colors)
+            operations += size
+            undecided = size - ones - zeros
