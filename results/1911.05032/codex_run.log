+                    operations += 1
+                    if colors[index] < 0:
+                        unassigned = index
+                    else:
+                        assigned.append(colors[index])
+                if len(assigned) == 3 and assigned[0] == assigned[1] == assigned[2]:
+                    return False
+                if (
+                    len(assigned) == 2
+                    and assigned[0] == assigned[1]
+                    and colors[unassigned] < 0
+                ):
+                    colors[unassigned] = 1 - assigned[0]
+                    changed = True
+            if not changed:
+                return True
 
