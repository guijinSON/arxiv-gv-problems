 rng=random.Random(seed); reps=rng.sample(mixed,min(b,len(mixed)))
 E=set()
 for t in reps:
  for a in U: E.add(tuple(sorted((a*t[0]%p,a*t[1]%p,a*t[2]%p))))
 return sorted(E),R

def solve(p,E,limit=5_000_000):
 n=p-1;k=n//2; idx={x:x-1 for x in range(1,p)}; EE=[tuple(idx[x] for x in e) for e in E]
 deg=[0]*n
 for e in EE:
  for x in e:deg[x]+=1
 ops=0; nodes=0
 def prop(a):
  nonlocal ops
  while True:
   changed=False; ones=sum(x==1 for x in a); zeros=sum(x==0 for x in a); un=n-ones-zeros
   if ones>k or zeros>k or ones+un<k or zeros+un<k:return False
   if ones==k:
