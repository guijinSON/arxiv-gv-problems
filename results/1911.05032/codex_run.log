+
+# Populated from the three script-owned harden.py runs after local gates pass.
+# These values are diagnostic only; current G9 gates only the size/effort caps.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": None, "attempts": 0},
+    "hinted": {"solved": None, "attempts": 0},
+    "placebo": {"solved": None, "attempts": 0},
+    "hinted_verdict": "pending",
+}
+
+
+NOTES = r"""
+Section 1.1 fixes the native definition: a hitting set intersects every member
+of the input family, each returned set has size at most k, Hamming distance is
+symmetric-difference size, and Diverse d-Hitting Set uses the sum over all
+pairs.  Section 3 states the upward-closed framework.  Lemma 1 enumerates at
+most d^k minimal hitting sets, and Theorem 1 gives the complete FPT algorithm in
+time r^2 d^(kr) |U|^O(1).  Section 3.1 also makes optimal augmentation a
+polynomial maximum-cost-flow problem.  These results rule out an honest Track A
+claim for a small fixed k+r and require the existing algorithm to be disclosed.
+
+This module uses the paper's own d=3 set systems, r=3 solutions, k=n, and total
+Hamming diversity.  A row (a,b,c,p) is merely a compact display of four actual
+3-element family members: the four clauses that reject the bit triples of
+parity different from p.  Together with the n two-element variable pairs, a
+size-n hitting set is exactly a satisfying binary assignment.  No graph,
+finite-field, or continuous surrogate replaces the paper's object, and verify
+checks the resulting family by literal set intersection.
+
+Generation samples the base assignment before building any constraint.  Every
+layer is a relabelled cyclic family x_i XOR x_(i+u) XOR x_(i+2u)=p_i, with n a
+multiple of three and gcd(u,n)=1.  Its homogeneous solutions are exactly the
+four period-three words (a,b,a XOR b).  Adding two nonzero such words to the
+sampled assignment gives three valid solutions; at each variable their three
+bits are not all equal, so their total set-Hamming diversity is the maximum 4n.
+
+Step 0 therefore selects Track B.  Recognizing the displayed parity gadgets and
+running Gaussian elimination is a polynomial reference algorithm and is
+reported as successful.  The compact route instead follows one ordered layer,
+propagates from two arbitrary bits, and adds the two period-three homogeneous
+patterns.  Literal-frequency outliers are removed exactly: every literal has
+the same family frequency.  The audited failures are frequency ranking, a
+coordinate-wise greedy choice, uniform structure-aware restarts, a public-index
+period-three ansatz, and a local-majority ansatz.  Random layer units diversify
+the incidence geometry without changing the certificate identity.
+""".strip()
+
+
+_PATTERNS = tuple(
+    bits for bits in itertools.product((0, 1), repeat=3)
+    if bits not in ((0, 0, 0), (1, 1, 1))
+)
+
+
+def _validate_parameters(n, layers):
+    if isinstance(n, bool) or not isinstance(n, int) or n < 3 or n % 3:
+        raise ValueError("n must be an integer multiple of 3 and at least 3")
+    if isinstance(layers, bool) or not isinstance(layers, int) or layers < 1:
+        raise ValueError("layers must be a positive integer")
+    available = sum(
+        1 for u in range(1, n)
+        if math.gcd(u, n) == 1 and u < (-u) % n
+    )
+    if layers > available:
+        raise ValueError("layers exceeds the number of distinct cyclic step classes")
+
+
+def _constraints_from(pairs, equations):
+    """Expand the exact hitting-set family represented by the parity rows."""
+    family = [sorted(pair) for pair in pairs]
+    for a, b, c, parity in equations:
+        for bits in itertools.product((0, 1), repeat=3):
+            if (bits[0] ^ bits[1] ^ bits[2]) == parity:
+                continue
+            family.append(sorted([
+                pairs[a][1 - bits[0]],
+                pairs[b][1 - bits[1]],
+                pairs[c][1 - bits[2]],
+            ]))
+    return family
+
+
+def _bits_to_answer(inst, assignments):
+    pairs = inst["variable_pairs"]
+    return [sorted(pairs[v][bits[v]] for v in range(inst["n"]))
+            for bits in assignments]
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a Diverse 3-Hitting Set certificate and its instance."""
+    layers = params.pop("layers", 1)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_parameters(n, layers)
+    rng = random.Random(seed)
+
+    # The certificate source is sampled first.  All later constraints are exact
+    # identities that it satisfies; no emitted instance is solved here.
+    base_internal = [rng.randrange(2) for _ in range(n)]
+
+    public_of_internal = list(range(n))
+    rng.shuffle(public_of_internal)
+
+    literal_ids = list(range(2 * n))
+    rng.shuffle(literal_ids)
+    variable_pairs = []
+    for public_var in range(n):
+        pair = [literal_ids[2 * public_var], literal_ids[2 * public_var + 1]]
+        if rng.randrange(2):
+            pair.reverse()
+        variable_pairs.append(pair)
+
+    step_classes = [
+        u for u in range(1, n)
+        if math.gcd(u, n) == 1 and u < (-u) % n
+    ]
+    chosen_steps = rng.sample(step_classes, layers)
+
+    equation_layers = []
+    for step in chosen_steps:
+        direction = step if rng.randrange(2) == 0 else (-step) % n
+        start = rng.randrange(n)
+        internal_cycle = [(start + t * direction) % n for t in range(n)]
+        rows = []
+        for t in range(n):
+            triple_internal = [
+                internal_cycle[t],
+                internal_cycle[(t + 1) % n],
+                internal_cycle[(t + 2) % n],
+            ]
+            parity = 0
+            for v in triple_internal:
+                parity ^= base_internal[v]
+            triple_public = [public_of_internal[v] for v in triple_internal]
+            rng.shuffle(triple_public)
+            rows.append(triple_public + [parity])
+        equation_layers.append(rows)
+    rng.shuffle(equation_layers)
+    equations = [row for layer in equation_layers for row in layer]
+
+    # Three points of the known affine plane.  Along the first generated cyclic
+    # order the two masks have period 101 and 011; every coordinate sees a
+    # nonzero functional of the two free bits.
+    public_base = [0] * n
+    public_h1 = [0] * n
+    public_h2 = [0] * n
+    for internal in range(n):
+        public = public_of_internal[internal]
+        public_base[public] = base_internal[internal]
+        residue = internal % 3
+        public_h1[public] = (1, 0, 1)[residue]
+        public_h2[public] = (0, 1, 1)[residue]
+    assignments = [
+        public_base,
+        [public_base[v] ^ public_h1[v] for v in range(n)],
+        [public_base[v] ^ public_h2[v] for v in range(n)],
+    ]
+
+    constraints = _constraints_from(variable_pairs, equations)
+    answer_stub = {
+        "n": n,
+        "variable_pairs": variable_pairs,
+    }
+    answer = _bits_to_answer(answer_stub, assignments)
+    return {
+        "family": "Diverse 3-Hitting Set with total Hamming diversity",
+        "n": n,
+        "d": 3,
+        "r": 3,
+        "k": n,
+        "threshold": 4 * n,
+        "universe_size": 2 * n,
+        "variable_pairs": variable_pairs,
+        "equation_layers": equation_layers,
+        "equations": equations,
+        "constraints": constraints,
+        "answer": answer,
+    }
+
+
+def render(inst):
+    n = inst["n"]
+    pair_lines = "\n".join(
+        f"  {v}: {pair[0]} {pair[1]}"
+        for v, pair in enumerate(inst["variable_pairs"])
+    )
+    layer_chunks = []
+    for layer_index, layer in enumerate(inst["equation_layers"]):
+        rows = "\n".join(
+            f"  {a} {b} {c} : {parity}" for a, b, c, parity in layer
+        )
+        layer_chunks.append(f"Block {layer_index}:\n{rows}")
+    layers = "\n\n".join(layer_chunks)
+
+    statement = f"""Find a diverse collection of hitting sets.
+
+The universe is the integer IDs 0 through {2 * n - 1}.  A hitting set is a
+subset of these IDs that intersects every member of the family F described
+below.  You must return exactly three hitting sets T0,T1,T2, each of size at
+most k={n}.  Repeated IDs inside one set are not allowed; the order of IDs and
+the order of the three sets do not matter.
+
+For finite sets A and B, their Hamming distance is their symmetric-difference
+size |(A\\B) union (B\\A)|.  The required total diversity is
+
+  d(T0,T1) + d(T0,T2) + d(T1,T2) >= {inst['threshold']}.
+
+The family F is a 3-Hitting Set instance.  It is specified exactly by the next
+two rules.
+
+1. Variable-pair constraints.  For every variable v, F contains the displayed
+   two-element set.  The first ID on its line represents bit 0 and the second
+   represents bit 1.
+
+{pair_lines}
+
+2. Parity-gadget constraints.  A displayed row "a b c : p" denotes four
+   three-element members of F.  For each bit triple (A,B,C) with
+   A XOR B XOR C != p, F contains
+
+     {{ opposite(a,A), opposite(b,B), opposite(c,C) }},
+
+   where opposite(v,0) is v's bit-1 ID and opposite(v,1) is v's bit-0 ID from
+   the table above.  Thus the row is only exact shorthand for four ordinary
+   members of F; XOR is addition modulo 2.  Every row in every block contributes
+   its four members.  Block boundaries and row order do not add constraints.
+
+{layers}
+
+Return the three sets as one JSON array of three JSON arrays of decimal universe
+IDs.  All three inner arrays must have exactly {n} distinct IDs.  No ellipses or
+comments are permitted.  A format-only example for a hypothetical two-variable
+instance is [[0,3],[1,2],[0,2]].
+
+Give your final answer inside <answer></answer> tags, as the JSON array just
+specified.
+Example: <answer>[[0,3],[1,2],[0,2]]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def _json_candidate(text):
+    try:
+        value = json.loads(text.strip())
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, list) else None
+
+
+def parse_answer(text):
+    """Parse a JSON witness from tags, a Markdown fence, or surrounding prose."""
+    if not isinstance(text, str):
+        return None
+    tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
+                        flags=re.IGNORECASE | re.DOTALL)
+    for body in reversed(tagged):
+        value = _json_candidate(body)
+        if value is not None:
+            return value
+    fenced = re.findall(r"```(?:json)?\s*(.*?)```", text,
+                        flags=re.IGNORECASE | re.DOTALL)
+    for body in reversed(fenced):
+        value = _json_candidate(body)
+        if value is not None:
+            return value
+    value = _json_candidate(text)
+    if value is not None:
+        return value
+    decoder = json.JSONDecoder()
+    starts = [i for i, char in enumerate(text) if char == "["]
+    for start in reversed(starts):
+        try:
+            value, _ = decoder.raw_decode(text[start:])
+        except ValueError:
+            continue
+        if isinstance(value, list):
+            return value
+    return None
+
+
+def verify(inst, answer):
+    """Check any valid diverse hitting-set witness, never the planted answer."""
+    if not isinstance(answer, list) or len(answer) != inst["r"]:
+        return False, "answer must be a JSON list of exactly three hitting sets"
+    normalized = []
+    for index, candidate in enumerate(answer):
+        if not isinstance(candidate, list) or len(candidate) != inst["k"]:
+            return False, f"hitting set {index} must contain exactly k={inst['k']} IDs"
+        if any(isinstance(value, bool) or not isinstance(value, int)
+               for value in candidate):
+            return False, f"hitting set {index} contains a non-integer ID"
+        if any(value < 0 or value >= inst["universe_size"] for value in candidate):
+            return False, f"hitting set {index} contains an out-of-range universe ID"
+        chosen = set(candidate)
+        if len(chosen) != len(candidate):
+            return False, f"hitting set {index} repeats an ID"
+        for constraint_index, constraint in enumerate(inst["constraints"]):
+            if chosen.isdisjoint(constraint):
+                return False, (
+                    f"hitting set {index} misses family constraint "
+                    f"{constraint_index}"
+                )
+        normalized.append(chosen)
+    diversity = sum(
+        len(normalized[i] ^ normalized[j])
+        for i in range(inst["r"])
+        for j in range(i + 1, inst["r"])
+    )
+    if diversity < inst["threshold"]:
+        return False, (
+            f"total Hamming diversity is {diversity}, below "
+            f"{inst['threshold']}"
+        )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Sample uniformly after enforcing pair shape and maximum diversity."""
+    assignments = [[0] * inst["n"] for _ in range(3)]
+    for variable in range(inst["n"]):
+        pattern = _PATTERNS[rng.randrange(len(_PATTERNS))]
+        for solution in range(3):
+            assignments[solution][variable] = pattern[solution]
+    return _bits_to_answer(inst, assignments)
+
+
+def search_space(inst):
+    return 6 ** inst["n"]
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    total = 0
+    for choices in itertools.product(range(6), repeat=inst["n"]):
+        assignments = [[0] * inst["n"] for _ in range(3)]
+        for variable, choice in enumerate(choices):
+            pattern = _PATTERNS[choice]
+            for solution in range(3):
+                assignments[solution][variable] = pattern[solution]
+        total += int(verify(inst, _bits_to_answer(inst, assignments))[0])
+    return total
+
+
+def _cycle_from_layer(layer, n):
+    """Recover either cyclic variable order from an unordered row set."""
+    scopes = [frozenset(row[:3]) for row in layer]
+    if n == 3:
+        return list(scopes[0])
+    neighbors = [[] for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            if len(scopes[i] & scopes[j]) == 2:
+                neighbors[i].append(j)
+                neighbors[j].append(i)
+    if any(len(items) != 2 for items in neighbors):
+        raise ValueError("layer is not a cyclic recurrence")
+    start = min(range(n), key=lambda i: tuple(sorted(scopes[i])))
+    first_neighbor = min(neighbors[start], key=lambda i: tuple(sorted(scopes[i])))
+    scope_order = [start, first_neighbor]
+    while len(scope_order) < n:
+        previous, current = scope_order[-2], scope_order[-1]
+        nxt = neighbors[current][0]
+        if nxt == previous:
+            nxt = neighbors[current][1]
+        if nxt == start:
+            break
+        scope_order.append(nxt)
+    if len(scope_order) != n:
+        raise ValueError("layer cycle closed at the wrong length")
+    sequence = []
+    for position in range(n):
+        current = scopes[scope_order[position]]
+        previous = scopes[scope_order[(position - 1) % n]]
+        difference = current - previous
+        if len(difference) != 1:
+            raise ValueError("cannot recover layer variable cycle")
+        sequence.append(next(iter(difference)))
+    if len(set(sequence)) != n:
+        raise ValueError("layer cycle does not cover every variable")
+    return sequence
+
+
+def canonical_key(inst):
+    """Canonicalize recurrence incidence under relabelling and input order.
+
+    Every layer is itself a cycle hypergraph.  Each possible layer is used as a
+    coordinate frame, both orientations are tried, and the lexicographically
+    least multiset of all ternary scopes is retained.  Literal names, variable
+    names, RHS bits, row order, and layer order therefore disappear.
+    """
+    n = inst["n"]
+    if n == 3:
+        payload = [n, len(inst["equation_layers"]), 1]
+        return hashlib.sha256(json.dumps(payload).encode()).hexdigest()
+    all_scopes = [frozenset(row[:3]) for layer in inst["equation_layers"]
+                  for row in layer]
+    encodings = []
+    for layer in inst["equation_layers"]:
+        sequence = _cycle_from_layer(layer, n)
+        for oriented in (sequence, list(reversed(sequence))):
+            for shift in range(n):
+                rotated = oriented[shift:] + oriented[:shift]
+                coordinate = {variable: i for i, variable in enumerate(rotated)}
+                encoded_scopes = sorted(
+                    tuple(sorted(coordinate[v] for v in scope))
+                    for scope in all_scopes
+                )
+                encodings.append(encoded_scopes)
+    payload = [n, len(inst["equation_layers"]), min(encodings)]
+    blob = json.dumps(payload, separators=(",", ":"))
+    return hashlib.sha256(blob.encode()).hexdigest()
+
+
+def escalate(params):
+    current = dict(params)
+    n = int(current.get("n", 3))
+    layers = int(current.get("layers", 1))
+    # First crowd the same answer length with another independent recurrence
+    # layer.  Once that axis reaches ten, increase n while respecting both caps.
+    available = sum(
+        1 for u in range(1, n)
+        if math.gcd(u, n) == 1 and u < (-u) % n
+    )
+    if layers < min(10, available):
+        current["layers"] = layers + 1
+        return current
+    next_n = n + 3
+    if 3 * next_n > 256 or (10 * next_n) // 3 - 4 > 300:
+        return "cap_bound"
+    current["n"] = next_n
+    next_available = sum(
+        1 for u in range(1, next_n)
+        if math.gcd(u, next_n) == 1 and u < (-u) % next_n
+    )
+    current["layers"] = min(layers, next_available)
+    return current
+
+
+def _compact_solve(inst):
+    """Solve using one ordered recurrence block; never consult answer."""
+    n = inst["n"]
+    layer = inst["equation_layers"][0]
+    if n == 3:
+        sequence = list(layer[0][:3])
+    else:
+        scopes = [set(row[:3]) for row in layer]
+        sequence = []
+        for index in range(n):
+            difference = scopes[index] - scopes[(index - 1) % n]
+            if len(difference) != 1:
+                # Row order is part of the compact presentation, but transformed
+                # selftests may shuffle it; fall back to structural recovery.
+                sequence = _cycle_from_layer(layer, n)
+                break
+            sequence.append(next(iter(difference)))
+    rhs_by_scope = {frozenset(row[:3]): row[3] for row in layer}
+    base = [0] * n
+    base[sequence[0]] = 0
+    base[sequence[1]] = 0
+    for index in range(n - 2):
+        a, b, c = sequence[index:index + 3]
+        base[c] = base[a] ^ base[b] ^ rhs_by_scope[frozenset((a, b, c))]
+    h1 = [0] * n
+    h2 = [0] * n
+    for index, variable in enumerate(sequence):
+        h1[variable] = (1, 0, 1)[index % 3]
+        h2[variable] = (0, 1, 1)[index % 3]
+    assignments = [
+        base,
+        [base[v] ^ h1[v] for v in range(n)],
+        [base[v] ^ h2[v] for v in range(n)],
+    ]
+    return _bits_to_answer(inst, assignments)
+
+
+def _gaussian_reference(inst):
+    """Exact RREF over GF(2), with primitive-operation accounting."""
+    n = inst["n"]
+    matrix = []
+    for a, b, c, parity in inst["equations"]:
+        row = [0] * (n + 1)
+        row[a] = row[b] = row[c] = 1
+        row[n] = parity
+        matrix.append(row)
+    counts = {
+        "pivot_tests": 0,
+        "row_bit_tests": 0,
+        "bit_xors": 0,
+        "swaps": 0,
+    }
+    pivot_columns = []
+    rank = 0
+    for column in range(n):
+        pivot = None
+        for row_index in range(rank, len(matrix)):
+            counts["pivot_tests"] += 1
+            if matrix[row_index][column]:
+                pivot = row_index
+                break
+        if pivot is None:
+            continue
+        if pivot != rank:
+            matrix[rank], matrix[pivot] = matrix[pivot], matrix[rank]
+            counts["swaps"] += 1
+        for row_index in range(len(matrix)):
+            if row_index == rank:
+                continue
+            counts["row_bit_tests"] += 1
+            if matrix[row_index][column]:
+                for j in range(column, n + 1):
+                    matrix[row_index][j] ^= matrix[rank][j]
+                    counts["bit_xors"] += 1
+        pivot_columns.append(column)
+        rank += 1
+    for row in matrix:
+        if not any(row[:n]) and row[n]:
+            return None, counts
+    free_columns = [column for column in range(n)
+                    if column not in set(pivot_columns)]
+    if len(free_columns) != 2:
+        return None, counts
+    particular = [0] * n
+    for row_index, column in enumerate(pivot_columns):
+        particular[column] = matrix[row_index][n]
+    null_basis = []
+    for free in free_columns:
+        vector = [0] * n
+        vector[free] = 1
+        for row_index, column in enumerate(pivot_columns):
+            vector[column] = matrix[row_index][free]
+        null_basis.append(vector)
+    assignments = [
+        particular,
+        [particular[v] ^ null_basis[0][v] for v in range(n)],
+        [particular[v] ^ null_basis[1][v] for v in range(n)],
+    ]
+    counts["operations"] = sum(counts.values())
+    return _bits_to_answer(inst, assignments), counts
+
+
+def _greedy_candidate(inst):
+    n = inst["n"]
+    equations_by_max = [[] for _ in range(n)]
+    for equation in inst["equations"]:
+        equations_by_max[max(equation[:3])].append(equation)
+    assignments = [[None] * n for _ in range(3)]
+    for variable in range(n):
+        best_pattern = None
+        best_score = -1
+        for pattern in _PATTERNS:
+            for solution in range(3):
+                assignments[solution][variable] = pattern[solution]
+            score = 0
+            for a, b, c, parity in equations_by_max[variable]:
+                for solution in range(3):
+                    values = (assignments[solution][a], assignments[solution][b],
+                              assignments[solution][c])
+                    if None not in values and (values[0] ^ values[1] ^ values[2]) == parity:
+                        score += 1
+            if score > best_score:
+                best_score = score
+                best_pattern = pattern
+        for solution in range(3):
+            assignments[solution][variable] = best_pattern[solution]
+    return _bits_to_answer(inst, assignments)
+
+
+def _attack_candidates(inst, seed):
+    n = inst["n"]
+    frequencies = [0] * inst["universe_size"]
+    for constraint in inst["constraints"]:
+        for element in constraint:
+            frequencies[element] += 1
+    outlier_assignments = [[0] * n for _ in range(3)]
+    for variable, pair in enumerate(inst["variable_pairs"]):
+        preferred = min((0, 1), key=lambda bit: (-frequencies[pair[bit]], pair[bit]))
+        pattern = (preferred, preferred, 1 - preferred)
+        for solution in range(3):
+            outlier_assignments[solution][variable] = pattern[solution]
+
+    public_period = [[0] * n for _ in range(3)]
+    for variable in range(n):
+        h1 = (1, 0, 1)[variable % 3]
+        h2 = (0, 1, 1)[variable % 3]
+        public_period[0][variable] = 0
+        public_period[1][variable] = h1
+        public_period[2][variable] = h2
+
+    majority = [0] * n
+    for variable in range(n):
+        parities = [row[3] for row in inst["equations"] if variable in row[:3]]
+        majority[variable] = int(sum(parities) * 2 > len(parities))
+    majority_assignments = [
+        majority,
+        [majority[v] ^ (1, 0, 1)[v % 3] for v in range(n)],
+        [majority[v] ^ (0, 1, 1)[v % 3] for v in range(n)],
+    ]
+
