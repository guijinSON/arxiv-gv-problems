import random, time, statistics

def instance(side, seed):
    r=random.Random(seed); N=side*side
    plant=[r.randrange(4) for _ in range(N)]
    edges=[]
    for x in range(side):
      for y in range(side):
        u=x*side+y
        for dx,dy in ((1,0),(0,1)):
          xx,yy=x+dx,y+dy
          if xx<side and yy<side:
            v=xx*side+yy
            while True:
              p=list(range(4)); r.shuffle(p)
              if p[plant[u]] "'!= plant[v]: break
            edges.append((u,v,p))
    return N,edges,plant

def solve(N, edges):
    adj=[[] for _ in range(N)]
    for ei,(u,v,p) in enumerate(edges):
      adj[u].append((v,ei)); adj[v].append((u,ei))
    deg=[len(a) for a in adj]; alive=[True]*N; stack=[]; ops=0
    buckets=[set() for _ in range(5)]
    for v,d in enumerate(deg): buckets[d].add(v)
    for _ in range(N):
      d=next(i for i,b in enumerate(buckets) if b)
      v=buckets[d].pop(); alive[v]=False; stack.append(v)
      for w,_ in adj[v]:
        ops+=1
        if alive[w]:
          buckets[deg[w]].remove(w); deg[w]-=1; buckets[deg[w]].add(w)
    color=[None]*N
    for v in reversed(stack):
