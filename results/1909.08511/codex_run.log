          u0,v0,p=edges[ei]; ops+=1
          if (v==u0 and p[c]==color[w]) or (v==v0 and p[color[w]]==c):
            good=False; break
        if good: color[v]=c; break
      if color[v] is None: return None,ops
    return color,ops

for side in (6,8,12,15):
