/bin/bash -lc "python3 - <<'PY'
import random, statistics, time
N=4096
K=16
TIMES=[]
for seed in range(1000):
    rng=random.Random(seed)
    labels=list(range(N)); rng.shuffle(labels)
    c=labels[0]
    sources=set(labels[1:K+1])
    arcs=[(leaf,c) if leaf in sources else (c,leaf) for leaf in labels[1:]]
    rng.shuffle(arcs)
    t0=time.perf_counter()
    deg={}
    for u,v in arcs:
        deg[u]=deg.get(u,0)+1
        deg[v]=deg.get(v,0)+1
    center=max(deg,key=deg.get)
    answer=[]
    for u,v in arcs:
        if v==center: answer.append(u)
    TIMES.append(time.perf_counter()-t0)
    assert set(answer)==sources
print('attempts',len(TIMES))
print('edges',N-1)
print('direction_checks',N-1)
print('degree_endpoint_updates',2*(N-1))
print('answer_atoms',K)
print('median_seconds',statistics.median(TIMES))
print('min_seconds',min(TIMES))
print('max_seconds',max(TIMES))
