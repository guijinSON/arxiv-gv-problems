+    """Canonicalize input order, encoder labels, and known graph symmetries."""
+    canonical = _canonical_decoded(inst)
+    blob = json.dumps(canonical, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("ascii")).hexdigest()
