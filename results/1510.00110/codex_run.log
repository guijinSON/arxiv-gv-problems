+    }
+
+    attack_names = (
+        "raw_coordinate_magnitude_outlier",
+        "constant_nonedge_mode",
+        "raw_coordinate_greedy",
+        "one_step_decoder_ansatz",
+        "diagonal_only_ansatz",
+        "random_restart_256",
