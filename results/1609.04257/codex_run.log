+        ):
+            successes[name] += bool(verify(probe, candidate)[0])
+        rrng = random.Random(91_000 + trial)
+        restart_hit = False
+        for _ in range(256):
+            if verify(probe, random_candidate(probe, rrng))[0]:
+                restart_hit = True
+                break
+        successes[attack_names[2]] += restart_hit
