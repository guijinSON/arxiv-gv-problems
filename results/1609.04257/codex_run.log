+
+    # G8: reverse, rotate, random permutation, and a composition over 20 seeds.
+    invariant_checks = 0
+    carried_checks = 0
+    keys = []
+    for seed in range(20):
+        original = make_instance(seed=70_000 + seed,
+                                 **DIFFICULTY[SHIPPING_DIFFICULTY])
+        keys.append(canonical_key(original))
+        n = original["n"]
