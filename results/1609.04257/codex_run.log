+        "garbage_returns_none": garbage is None,
+    }
+
+    # G4/G5 share the mandated 200k shipping-preset structure-aware sample.
+    density_inst = make_instance(seed=20260905, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    samples = 200_000
