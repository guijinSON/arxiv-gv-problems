+        "structure_aware_space": space,
+        "theoretical_probability_unique_answer": 1 / space,
+        "sampling_wall_clock_sec": round(density_seconds, 6),
+    }
+
+    demo = make_instance(seed=11, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
