+def search_space(inst) -> int | None:
+    """Size of the exact structure-aware bounded certificate language."""
+    n = inst["n"]
+    k = inst["support_size"]
+    p = inst["positive_count"]
+    return math.comb(n, k) * math.comb(k, p)
+
