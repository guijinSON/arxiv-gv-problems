+        pset = set(pos)
+        value = sum(inst["nodes"][i] if i in pset else -inst["nodes"][i]
+                    for i in support)
+        score = abs(value - target1)
+        if best is None or score < best[0]:
+            best = (score, pos)
+    positive = set(best[1])
+    return _certificate(sorted(positive), [i for i in support if i not in positive])
