+    return {
+        "n": n,
+        "moment_count": moment_count,
+        "nodes": nodes,
+        "target_coefficients": target,
+        "multiplier": _poly_json(1),
+        "support_size": _SUPPORT,
+        "positive_count": _POSITIVE,
+        "answer": _certificate(sorted(positive), negative),
+    }
