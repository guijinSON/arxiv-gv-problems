+            (attack_names[1], _attack_greedy(probe)),
+            (attack_names[3], _attack_first_five(probe)),
+        ):
+            successes[name] += bool(verify(probe, candidate)[0])
+        rrng = random.Random(91_000 + trial)
+        restart_hit = False
