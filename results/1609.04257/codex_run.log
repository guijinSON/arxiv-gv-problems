+        successes[attack_names[2]] += restart_hit
+
+        t0 = time.perf_counter()
+        ref, ops, triples = _reference_meet_in_middle(probe, with_count=True)
+        reference_times.append(time.perf_counter() - t0)
+        reference_ops.append(ops)
