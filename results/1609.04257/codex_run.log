+    planted = json.loads(json.dumps(inst["answer"]))
+    corruptions = {}
+    corruptions["empty"] = []
+    corruptions["drop_one"] = planted[:-1]
+    swapped = json.loads(json.dumps(planted))
+    swapped[0], swapped[1] = swapped[1], swapped[0]
+    corruptions["swap_order"] = swapped
