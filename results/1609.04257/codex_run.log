+
+def _moments(nodes, signed_indices, count: int) -> list[int]:
+    values = [0] * count
+    for idx, sign in signed_indices:
+        power = 1
+        a = nodes[idx]
+        for r in range(count):
+            values[r] += sign * power
+            power *= a
+    return values
