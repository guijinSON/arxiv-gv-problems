+    spoke_length = m // 4
+
+    # Three closed cyclic arcs of radii d_i have total cardinality M-1.
+    total_radius = m // 2 - 2
+    base = total_radius // 3
+    jitter = base // 8
+    if jitter:
+        d1 = base - jitter + rng.randrange(jitter + 1)
+        d2 = base - jitter + rng.randrange(jitter + 1)
+    else:
+        d1 = base
+        d2 = base
+    d3 = total_radius - d1 - d2
