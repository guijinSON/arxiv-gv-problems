+    rng.shuffle(depths)
+    if not all(1 <= d <= spoke_length for d in depths):
+        raise AssertionError("constructed cop depth is outside its spoke")
+
+    target_position = rng.randrange(m)
+    cursor = (target_position + 1) % m
