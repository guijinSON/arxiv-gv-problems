+def _rotl(x: int, amount: int, n: int) -> int:
+    amount %= n
+    mask = (1 << n) - 1
+    if amount == 0:
+        return x & mask
+    return ((x << amount) | (x >> (n - amount))) & mask
+
+
+def _rotr(x: int, amount: int, n: int) -> int:
+    return _rotl(x, -amount, n)
