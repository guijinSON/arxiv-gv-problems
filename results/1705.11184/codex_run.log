+        "compressed robber spoke path",
+    ],
+    "verification_operations": [
+        "exact inverse bit relabelling",
+        "exact shortest-path distance in a subdivided wheel",
+        "three exact path-safety inequalities",
+    ],
+    "domain_essentiality": "native",
