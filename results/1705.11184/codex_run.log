+def _inverse_permute_bits(x: int, permutation: list[int]) -> int:
+    out = 0
+    for source, target in enumerate(permutation):
+        out |= ((x >> target) & 1) << source
+    return out
+
+
+def _gray(x: int) -> int:
+    return x ^ (x >> 1)
+
