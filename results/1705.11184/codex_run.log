+    twists = []
+    for _ in range(encoding_rounds):
+        twists.append([rng.randrange(1, n), rng.randrange(m)])
+
+    inst = {
+        "family": "one-cop-moves safe spoke path",
+        "paper": "arXiv:1705.11184",
+        "n": n,
+        "boundary_size": m,
