    "math.OC","math.DS","math.NA","math.AP","math.CA","math.FA",    # analytic/dynamic
    "math.PR","math-ph","math.SP","eess.SY","cs.SY",
}
_pid = os.path.basename(os.path.dirname(os.path.abspath(p)))
_cats = set()
try:
