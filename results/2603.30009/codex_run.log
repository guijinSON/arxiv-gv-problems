import random, time

def instance(m, seed):
    # abstract ids before a relabeling: center=0, negative leaf=1, positive leaves 2..
    rng=random.Random(seed)
    p=m+2
    perm=list(range(p)); rng.shuffle(perm)
    edges=[(perm[0],perm[1],'-')]+[(perm[0],perm[i],'+') for i in range(2,p)]
    rng.shuffle(edges)
    return p,edges

def recover(p, edges):
    deg=[0]*p; pos=[[] for _ in range(p)]; neg=[]
    for a,b,s in edges:
        deg[a]+=1; deg[b]+=1
        if s=='+': pos[a].append(b); pos[b].append(a)
        else: neg.append((a,b))
    center=max(range(p), key=deg.__getitem__)
    a,b=neg[0]; leaf=b if a==center else a
    ans=[None]*p; ans[center]=1; ans[leaf]=0
    k=2
    for v in pos[center]: ans[v]=k; k+=1
    return ans

