+
+    # G1: all presets, multiple seeds, and JSON-native answers.
+    g1_failures: list[str] = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7, 29):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
