   816	\begin{construction}
   817	  \label{con:diamond}
   818	  Let $(G',k)$ be an input to the construction.
   819	  For every edge $\{u,v\}$ in $G'$, introduced a clique $C_{\{u,v\}}$ of $k+1$
   820	  vertices such that every vertex in $C_{\{u,v\}}$ is adjacent to both $u$ and $v$.
   821	  This completes the construction. Let $G$ be the resultant graph.
   822	\end{construction}
