   687	\section{\HED}
   688	\label{sec:deletion}
   689	
   690	In this section, we prove that
   691	\HED\ is \NPC\ if and only if $H$ is a graph with 
   692	at least two edges. We also prove that
   693	these \NPC\ problems cannot be solved in parameterized subexponential time,
   694	unless ETH fails. Then, from Proposition~\ref{pro:equivalence}(\ref{item:dc-equivalence}), we
   695	obtain a dichotomy result for \HEC. We apply a technique similar to that we 
   696	applied for \textsc{Editing} in the last section. 
   697	%We use the following results 
   698	%we obtained in our recent paper \cite{DBLP:conf/cocoa/AravindSS15}.
   699	
   700	\begin{proposition}
   701	  \label{pro:deletion-base}
   702	  The following problems are \NPC. Furthermore, they cannot be 
   703	  solved in time $2^{o(k)}\cdot |G|^{O(1)}$, unless ETH fails.
   704	  \begin{enumerate}[(i)]
   705	  \item\label{item:deletion-p3} \PTED~\cite{komusiewicz2012cluster}.
   706	  \item\label{item:deletion-diamond} \DED~\cite{DBLP:journals/disopt/FellowsGKNU11,DBLP:conf/ipec/SandeepS15}.
   707	  \item\label{item:deletion-tree-reg} \HED, if $H$ is a graph with at least two edges and
   708	    has a largest component which is a regular graph or a tree~\cite{DBLP:conf/cocoa/AravindSS15}.
   709	  \end{enumerate}
   710	\end{proposition}
   711	
   712	The following Lemma is a consequence of Lemma~\ref{lem:degree} and Proposition~\ref{pro:equivalence}(\ref{item:dc-equivalence}).
   713	
   714	\begin{lemma}
   715	  \label{lem:rotate}
   716	  Let $H$ be any graph. Then the following hold true:
   717	  \begin{enumerate}[(i)]
   718	  \item Let $H'$ be the subgraph of $H$ obtained by removing all
   719	    vertices with degree $\delta(H)$.
   720	    Then there is a linear parameterized reduction from \HDED\ to \HED.
   721	  \item Let $H'$ be the subgraph of $H$ obtained by removing all
   722	    vertices with degree $\Delta(H)$.
   723	    Then there is a linear parameterized reduction from \HDED\ to \HED. 
   724	  \end{enumerate}
   725	\end{lemma}
   726	\begin{proof}
   727	  The first part directly follows from Lemma~\ref{lem:degree} by setting $d=\delta(H)$.
   728	  To prove the second part, consider the problem \HBEC. 
   729	  Let $H''$ be the graph obtained by removing all vertices with degree $\delta(\overline{H})$ from $\overline{H}$. 
   730	  Now, by Lemma~\ref{lem:degree},
   731	  there is a linear parameterized reduction from \textsc{$H''$-free Edge Completion} to \HBEC.
   732	  We observe that $H''$ is $\overline{H'}$. Hence, by Proposition~\ref{pro:equivalence}(\ref{item:dc-equivalence}),
   733	  there is a linear parameterized reduction from \HDED\ to \HED.\qed
   734	\end{proof}
   735	
   736	Given a graph $H$, we keep on deleting either the minimum degree vertices or the 
   737	maximum degree vertices by making sure that the resultant graph has at least 
   738	two edges. We do this process until we obtain a graph
   739	in which vertices with degree more than $\delta(H)$ induces a graph with 
   740	at most one edge and vertices with degree less than $\Delta(H)$ induces
   741	a graph with at most one edge. We call this method Deletion-Churn.
   742	
   743	\defstage{Deletion-Churn($H$)}
   744	% 
   745	{ $H$ is a graph with at least two edges.
   746	  \begin{enumerate}[Step 1:]
   747	    \item\label{item:churn-del1} If $H$ is a graph in which the vertices with degree more than $\delta(H)$
   748	      induces a subgraph with at most one edge and the vertices with degree less than $\Delta(H)$ induces
   749	      a subgraph with at most one edge, then return $H$.
   750	    \item\label{item:churn-del2} If $H$ is a graph in which the vertices with degree more than $\delta(H)$
   751	      induces a subgraph with at least two edges, then delete all vertices with degree $\delta(H)$ from $H$ and goto Step 1.
   752	    \item\label{item:churn-compl3} If $H$ is a graph in which the vertices with degree less than $\Delta(H)$
   753	      induces a subgraph with at least two edges, then delete all vertices with degree $\Delta(H)$ from $H$. Goto Step 1.
   754	  \end{enumerate}
   755	}
   756	
   757	\begin{observation}
   758	  \label{obs:deletion-churn}
   759	  Let $H$ be a graph with at least two edges. If the vertices with degree more than $\delta(H)$ 
   760	  induces a graph with at most one edge and the vertices with degree less than $\Delta(H)$ induces
   761	  a graph with at most one edge, then $H$ is either regular graph or a forest or a sparse $(\ell,h)$-degree graph.
   762	\end{observation}
   763	\begin{proof}
   764	  Assume that $H$ is not a regular graph.
   765	  Since $H$ has at least two edges and it satisfies the premises, $\delta(H)\geq 1$.
   766	  If $\delta(H)=1$, the premises imply that $H$ is a forest. Assume that $\delta(H)\geq 2$.
   767	  Then we prove that $H$ is a sparse $(\ell,h)$-degree graph.
   768	  For a contradiction, assume that there exists a vertex $v\in V(H)$ such that $\delta(H)<deg(v)<\Delta(H)$.
   769	  The premises imply that $v$ has degree at most two, which is a contradiction.\qed
   770	\end{proof}
   771	
   772	\begin{lemma}
   773	  \label{lem:deletion-churn}
   774	  Let $H$ be a graph with at least two edges. Then Deletion-Churn($H$)
   775	  returns a graph $H'$ such that:
   776	  \begin{enumerate}[(i)]
   777	  \item\label{item:deletion-churn-red} There is a linear parameterized reduction from \HDED\ to \HED.
   778	  \item\label{item:deletion-churn-output} $H'$ has at least two edges and is either a regular graph
   779	    or a forest or a sparse $(\ell, h)$-degree graph.
   780	  \end{enumerate}
   781	\end{lemma}
   782	\begin{proof}
   783	  In every step, we make sure that there are at least two edges in the resultant graph.
   784	  Now, the first part follows from Lemma~\ref{lem:rotate} and the second part follows
   785	  from Observation~\ref{obs:deletion-churn}.\qed
   786	\end{proof}
   787	
   788	If the output of Deletion-Churn($H$), $H'$ is a regular graph or a forest,
   789	we obtain from Proposition~\ref{pro:deletion-base}(\ref{item:deletion-tree-reg}) that
   790	\HED\ is \NPC\ and cannot be solved in parameterized subexponential
   791	time, unless ETH fails.
   792	Therefore, the only graphs to be handled now is the sparse $(\ell,h)$-degree graphs with 
   793	at least two edges. We do that in the next two subsections.
