+
+def _transform(inst, pc, pl, pr, coordinate_order=(0, 1, 2),
+               reorder=False):
+    n = inst["n"]
+    if any(sorted(p) != list(range(n)) for p in (pc, pl, pr)):
+        raise ValueError("each relabelling must be a permutation")
