--- /dev/null
+++ b/selftest_report.json
@@ -0,0 +1,111 @@
+{
+  "G1_planted_verifies": {
+    "checked": 15,
+    "failures": [],
+    "pass": true
+  },
+  "G2_rejects_corruption": {
