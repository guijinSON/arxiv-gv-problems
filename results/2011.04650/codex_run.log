  rm -f "$D/.orkey" "$D/.task.md" "$D/.runner.sh"; rm -rf "$D/__pycache__"
  bash scripts/status.sh --write >/dev/null
  git add "$D" "claims/$ID.json" STATUS.md
  git commit -q -m "reject $ID"
