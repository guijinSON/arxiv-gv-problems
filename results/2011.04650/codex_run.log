   365	Now construct a linear forest $L$ consisting of $284n=|E(H)|$ paths of length $3$, 
   366	where every edge in $H$ corresponds to one path component in $L$. For an edge 
   367	$vw\in E(H)$ with color $\phi(vw)$, color the three edges of the corresponding path 
   368	with the colors $v$, $\phi(vw)$ and $w$ in this order. We claim that a maximum rainbow 
   369	matching in $L$ is exactly $284n$ greater than a maximum rainbow matching in $H$. 
   370	Note that this claim implies the theorem. To see the claim, consider first a rainbow 
   371	matching $M$ in $H$. Note that for every vertex $v\in V(H)$, $M$ can contain at most 
   372	one edge incident to $v$, so in $L$ we can add one of the two edges labeled $v$ to 
   373	the matching induced by $M$. This can be done for every vertex in $V(H)$, so the 
   374	largest rainbow matching in $L$ is at least $284n$ larger than $M$. On the other 
   375	hand, every rainbow matching $M'$ in $L$ contains at most two edges either colored 
   376	$v$ or incident to an edge colored $v$, and at most one of them is colored $v$. 
   377	Thus, by deleting at most $284n$ edges from $M'$ we can create a rainbow matching 
   378	in $H$. 
   379	Therefore, it is NP-hard to decide if the maximal size of a rainbow matching in 
   380	$L$ is above $(140+284-\eps)n$ or below $(139+284+\eps)n$.
   381	\end{proof}
   382	
   383	\begin{theorem}\label{thm:apxp4}
   384	\mrbm\ is APX-complete, even when restricted to properly edge-colored $P_4$-free bipartite 
   385	graphs in which every color is used at most twice. Unless P=NP, no polynomial algorithm can 
   386	guarantee an approximation ratio greater than $\frac{423}{424}$.
   387	\end{theorem}
   388	\begin{proof}%[Proof of Theorem~\ref{thm:apxp4}]
   389	 Take the linear forest $L$ from the proof of Theorem~\ref{thm:apxlf}, add an edge 
   390	to every $P_4$ to make it a $C_4$, and color the new edge with the same color as 
   391	the middle edge of the $P_4$. This graph $G$ is $P_4$-free, and every rainbow 
   392	matching in $G$ corresponds to a rainbow matching in $L$ of the same size.
   393	\end{proof}
   394	
   395	\begin{theorem}\label{thm:apxlf6}
   396	\mrbm\ is APX-complete, even when restricted to properly edge-colored $P_6$-free linear 
   397	forests in which every color is used at most twice. Unless P=NP, no polynomial algorithm 
   398	can guarantee an approximation ratio greater than $\frac{1689}{1694}$.
   399	\end{theorem}
   400	\begin{proof}%[Proof of Theorem~\ref{thm:apxlf6}]
   401	Similarly to above, we start with the $2$-regular graph $H$ from the proof of 
   402	Theorem~\ref{thm:2fac}, and transform it into a linear forest $L$ similarly to 
   403	the last two proofs. This time, we try to produce paths of length $4$ by splitting 
   404	the cycles in $H$ only at every other vertex if possible. As $H$ may contain odd 
   405	cycles, we have to use one path of length only $3$ for every one of the $o$ odd 
   406	cycles in $H$. Thus, $L$ has exactly $(284n+o)/2$ component paths, and a maximum 
   407	rainbow matching in $L$ is exactly $(284n+o)/2$ greater than a maximum rainbow 
   408	matching in $H$. As $H$ is triangle-free, we know that $o\le 284n/5$, so it is 
   409	NP-hard to decide if the maximal size of a rainbow matching in $L$ is above 
   410	$(140+0.7\times 284-\eps)n$ or below $(139+0.7\times 284+\eps)n$.
   411	\end{proof}
   412	
   413	%This implies the following corollary.
   414	\begin{theorem}\label{thm:apxtree}
   415	\mrbm\ is APX-complete, even when restricted to properly edge-colored $P_8$-free trees 
   416	in which every color is used at most twice. Unless P=NP, no polynomial algorithm can 
   417	guarantee an approximation ratio greater than $\frac{1689}{1694}$.
   418	\end{theorem}
   419	\begin{proof}%[Proof of Theorem~\ref{thm:apxtree}]
   420	 Start with an edge-colored linear forest $L$ as in the proof of 
   421	Theorem~\ref{thm:apxlf6}. Add an extra vertex $v$, and connect it to a central 
   422	vertex (i.e., a vertex with maximum distance to the ends) in every path in $L$. 
   423	Further, add one pending edge to $v$. Color the added edges with colors not 
   424	appearing on $L$. Then the resulting tree $T$ is $P_8$-free, and a maximum 
   425	rainbow matching in $T$ is exactly one edge larger than a maximum rainbow 
   426	matching in $L$.
   427	\end{proof}
   428	
   429	All these theorems imply the following complexity result on \rbm.
   430	\begin{corollary}
   431	 \rbm\ is NP-complete, even when restricted to one of the following classes of 
   432	edge-colored graphs.
   433	\begin{enumerate}
   434	 \item Complete graphs.
   435	 \item Properly edge-colored paths.
   436	\item Properly edge-colored $P_5$-free linear forests in which every color is used at 
   437	      most twice.
   438	\item Properly edge-colored $P_4$-free bipartite graphs in which every color is used at 
   439	      most twice.
   440	\item Properly edge-colored $P_8$-free trees in which every color is used at most twice.
   441	\end{enumerate}
   442	\end{corollary}
   443	
   444	
   445	
   445	
   446	\section{Polynomial-time Solvable Cases}\label{sec:poly}
   447	%In this section, we proof Theorems~\ref{thm:sfor}-\ref{thm:apx}.
   448	
   449	In contrast to Theorem~\ref{thm:apxp4}, saying that \mrbm\ is hard even for $P_4$-free 
   450	bipartite graphs, we have:
   451	
   452	\begin{theorem}\label{thm:sfor}
   453	In every graph $G$ which does not contain $P_4$ as a not necessarily induced subgraph, 
   454	\mrbm\ is solvable in time $O(m^{3/2})$, where $m$ is the number of edges in $G$.
   455	\end{theorem}
   456	\begin{proof}%[Proof of Theorem~\ref{thm:sfor}]
   457	As $G$ does not contain a $P_4$, every component of $G$ is either a star or a triangle. 
   458	Now construct a bipartite graph $H$ with partite sets being the components of $G$ and 
   459	the colors used in $G$. The graph $H$ has an edge between a component and a color if 
   460	in $G$, the color appears in the component. The graph $H$ has at most as many edges 
   461	as $G$, and rainbow matchings in $G$ correspond to matchings in $H$ of the same size. 
   462	As we can find a maximum matching in the bipartite graph in time $O(m^{3/2})$ 
   463	(\cite{HopKar,MicVaz,Vaz}), the same is true for $G$.
   464	\end{proof}
   465	
   466	Since in a forest, every $P_4$ is an induced subgraph, we have the following positive result 
   467	complementing Theorem~\ref{thm:apxlf}:
   468	 
   469	\begin{corollary}
   470	In every $P_4$-free forest $F$, \mrbm\ is solvable in time 
   471	$O(n^{3/2})$, where $n$ is the number of vertices in $F$.
   472	\end{corollary}
   473	
   474	In contrast to Theorem~\ref{thm:apxtree}, saying that \mrbm\ is hard even for $P_8$-free 
   475	trees, we have:
   476	
   477	\begin{theorem}\label{thm:stree}
   478	In every tree $T$ which does not contain $P_7$ as a subgraph, \mrbm\ is solvable in time 
   479	$O(n^{7/2})$, where $n$ is the number of vertices in $T$.
   480	\end{theorem}
   481	\begin{proof}%[Proof of Theorem~\ref{thm:stree}]
   482	As $T$ is $P_7$-free, we can find an edge $xy$ in $T$ such that $G-\{x,y\}$ is a forest 
   483	consisting of stars; all we have to do is to pick the two most central vertices in a 
   484	longest path in $T$ and note that every vertex of $T$ must have distance at most $2$ 
   485	to $\{ x,y\}$. Every matching $M$ can contain at most $2$ edges incident to $\{x,y\}$. 
   486	Once we have decided on these at most two edges (less than $n^2$ choices), we are left 
   487	with the task of finding a rainbow matching in a $P_4$-free forest, which can be done 
   488	in time $O(n^{3/2})$ by Theorem~\ref{thm:sfor}. This gives a total time of $O(n^{7/2})$.
   489	\end{proof}
   490	
   491	The following theorem describes a more general setting of Theorem~\ref{thm:stree}:
   492	
   493	\begin{theorem}\label{thm:sfor7}
   494	In every forest $F$ which does not contain $P_7$ as a subgraph, \mrbm\ is solvable in time 
   495	$O\left(\frac{1}{2^kk^{2k}}n^{(4k+3)/2}\right)$, where $n$ is the number of vertices in 
   496	$F$ and $k$ is the number of components in $F$.
   497	\end{theorem}
   498	\begin{proof}%[Proof of Theorem~\ref{thm:sfor7}]
   499	 As in proof of Theorem~\ref{thm:stree}, find a central edge $x_Ty_T$ in every component 
   500	$T\subseteq F$, such that $\bigcup\big(T-\{x_T,y_T\}\big)$ is a forest consisting of stars. 
   501	Once we have decided on the at most $2k$ edges in a matching incident to the $x_Ty_T$---a 
   502	total of at most ${n/k\choose 2}^k<\frac{n^{2k}}{2^kk^{2k}}$ choices---we are left with 
   503	the task of finding a rainbow matching in a $P_4$-free forest, which can be done in 
   504	$O(n^{3/2})$ by Theorem~\ref{thm:sfor}. This gives a total time of 
   505	$O\left(\frac{1}{2^kk^{2k}}n^{(4k+3)/2}\right)$.
   506	\end{proof}
   507	
   508	\begin{corollary}
   509	\mrbm\ is solvable in polynomial time for $P_7$-free forests with bounded number of components.
   510	\end{corollary}
   511	
   512	
   513	
   514	\section{Fixed Parameter Aspects}\label{sec:fixed}
   515	
   516	An approach to deal with NP-hard problems is to fix a parameter when solving the problems. 
   517	A problem parameterized by $k$ is {\it fixed parameter tractable}, {\it fpt} for short, 
   518	if it can be solved in time $f(k)\cdot n^{O(1)}$, or, equivalently, in time 
   519	$O\left(n^{O(1)}+f(k)\right)$, where $f(k)$ is a computable function, depending only on 
   520	the parameter $k$. 
   521	For an introduction to parameterized complexity theory, see for instance~\cite{DF,FG,Nie}.
   522	
   523	Observe that \mrbm\ is fpt, when parameterized by the size of the problem solution. 
   524	In case of properly edge-colored inputs, this is a consequence of Lemma~\ref{lemma:CL}, 
   525	and of the fact that {\sc MIS} is fpt for $(K_7-e)$-free graphs (\cite{DLMR}). 
   526	In the general case, rainbow matchings can be seen as matching (set packing) in certain 
   527	$3$-uniform hypergraphs, hence \mrbm\ is fpt by a result of Fellows et~al.~\cite{FKNRRSTW}.
   528	
   529	Recall that \mrbm\ is already hard for $P_8$-free trees. In view of Theorem~\ref{thm:sfor7}, 
   530	we now consider \mrbm\ for $P_7$-free forests, parametri\-zed by $k$, the number of components 
   531	in the inputs. Formally, we want to address the following parameterized problem:
   532	
   533	\medskip
   534	\noindent
   535	$k$-{\sc forest rainbow matching}\\[1ex] 
   536	\begin{tabular}{lp{0.8\textwidth}}
   537	Instance: & A $P_7$-free forest $F$ with $k$ components containing a $P_4$.\\% of maximal degree $d$/{\bf is $d$-regular??}\\
   538	Parameter: & $k$.\\
   539	Output: & A maximum rainbow matching in $F$.%\\
   540	   %       & 
   541	\end{tabular}
   542	
   543	\bigskip
   544	\noindent
   545	Theorem~\ref{thm:sfor5} below shows that $k$-{\sc forest rainbow matching} is fpt for $P_5$-free 
   546	forests.
   547	
   548	\begin{theorem}\label{thm:sfor5}
   549	In every forest $F$ which does not contain $P_5$ as a subgraph, \mrbm\ is solvable in time 
   550	$O(n+2^kk^{3})$, where $n$ is the number of vertices in $F$ and 
   551	$k$ is the number of components in $F$ containing a $P_4$.
   552	\end{theorem}
   553	\begin{proof}%[Proof of Theorem~\ref{thm:sfor5}]
   554	Let $E'\subset E(F)$ be the set of edges between vertices of degree greater than 
   555	$1$, and observe that $|E'|\le k$. Then, $F'=F-E'$ is a forest consisting of at 
   556	most $2k$ stars.
   557	Delete edges in $F'$ until each star is rainbow colored and has at most $2k$ edges. 
   558	Notice that this does not change the size of a maximum rainbow matching. Call this 
   559	new graph $F''$, and observe that $|E(F'')|\le 4k^2$. 
   560	
   561	Now for every rainbow choice of edges in $E'$, we can solve \mrbm\ on a subgraph 
   562	of $F''$. There are at most $2^k$ rainbow choices in $E'$, and solving \mrbm\ on 
   563	$F''$ takes time $O(k^3)$ as in Theorem~\ref{thm:sfor}. Creating $F''$ from $F$ 
   564	takes time $O(n)$, so the result follows.
   565	\end{proof}
   566	
   567	We do not know if $k$-{\sc forest rainbow matching} is fpt for $P_6$-free forests or 
   568	$W[1]$-hard.  
   569	Note that $k$-{\sc forest rainbow matching} is in XP by Theorem~\ref{thm:sfor7}. 
   570	
   571	\begin{remark}\label{thm:sfor67}
   572	If $k$-{\sc forest rainbow matching} for $P_6$-free forests is in $W[i]$, then 
   573	so is $k$-{\sc forest rainbow matching} for $P_7$-free forests.
   574	\end{remark}
   575	\begin{proof}%[Proof of Theorem~\ref{thm:sfor67}]
   576	Let $F$ be a $P_7$-free forest with $k$ components containing a $P_4$.
   577	 For every tree $T\subseteq F$ containing a $P_6$, find the central edge $x_Ty_T$. 
   578	Once you choose one of the $2^k$ possibilities to include these central edges in a 
   579	rainbow matching, delete the not-chosen edges, and delete the chosen edges together 
   580	with their neighborhood, the remaining graph contains at most $2k$ components 
   581	containing a $P_4$, and no components containing a $P_6$.
   582	\end{proof}
   583	
   584	
   585	\section{Concluding Remarks}\label{sec:conclusion}
   586	We have shown that it is NP-hard to approximate \mrbm\ within certain ratio bounds 
   587	for very restricted graph classes. Implicit in our results is the following dichotomy 
   588	theorem for forests and trees in terms of forbidding paths: \rbm\ is NP-complete for 
   589	$P_5$-free forests ($P_8$-free trees), and is polynomially solvable for $P_4$-free forests ($P_7$-free trees). 
   590	
   591	We have also proved that $k$-{\sc forest rainbow matching} is fixed parameter tracta\-ble 
   592	for $P_5$-free forests. What can we find out about the parameterized complexity in the only open case of $P_6$-free 
   593	(and equivalently, $P_7$-free) forests? 
   594	
   595	Another open problem of independent interest is the computational complexity of recognizing color-line graphs: Given a graph $G$, does there exist an edge-colored graph 
   596	$H$ such that $G=C\!L(H)$? 
   597	Note that it is well-known that line graphs can be recognized in linear time. 
   598	
   599	
