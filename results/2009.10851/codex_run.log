+    Chain positions have semantic meaning: position zero anchors the triangular
+    basis and the normal coordinates have a directed Frobenius cycle.  The only
+    free relabelling in the emitted representation is therefore the ordering of
+    displayed slots, which is removed here.
+    """
+    target_chain = _to_chain(inst["target"], inst["slot_to_chain"])
+    normal = {
+        "q": inst["q"],
+        "e": inst["e"],
+        "a": inst["a"],
+        "basis_multipliers": list(inst["basis_multipliers"]),
+        "target_in_chain_order": target_chain,
+    }
