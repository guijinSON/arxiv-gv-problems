   436	def _canonical_normal_orbit(vector: list[int], q: int) -> list[int]:
   437	    """Quotient cyclic normal-basis rotation and base-field rescaling.
   438	
   439	    Replacing eta_i by u*eta_(i+t), with u in F_q^*, is a presentation change:
   440	    it preserves eta_i^q=eta_(i+1) and conjugates neither x^q+x nor the target
   441	    equation.  Normalize the first nonzero coordinate of every rotation and
   442	    choose the lexicographically least representative.
   443	    """
   444	    e = len(vector)
   445	    representatives = []
   446	    for shift in range(e):
   447	        rotated = [vector[(i + shift) % e] % q for i in range(e)]
   448	        first = next(value for value in rotated if value)
   449	        scale = pow(first, q - 2, q)
   450	        representatives.append([(value * scale) % q for value in rotated])
   451	    return min(representatives)
   452	
   453	
   454	def canonical_key(inst):
   455	    """Canonicalize every coordinate disguise deliberately generated here.
   456	
   457	    The random triangular displayed basis and slot ordering carry no abstract
   458	    information, so the target is first returned to normal coordinates.  The
   459	    remaining inexpensive normal-basis presentation symmetries (cyclic rotation
   460	    and common nonzero F_q scaling) are removed as well.
   461	    """
   462	    target_normal = _display_to_normal(inst, inst["target"])
   463	    normal = {
   464	        "q": inst["q"],
   465	        "e": inst["e"],
   466	        "a": inst["a"],
   467	        "target_normal_orbit": _canonical_normal_orbit(target_normal, inst["q"]),
   468	    }
   469	    blob = json.dumps(normal, sort_keys=True, separators=(",", ":"))
   470	    return hashlib.sha256(blob.encode()).hexdigest()
