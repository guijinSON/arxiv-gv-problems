os.environ['GV_HINT_MODE']='placebo'; placebo=g.render(a)
assert 'Hint:' not in bare and g.STRUCTURAL_HINT in structural and g.PLACEBO_HINT in placebo
assert len(g.STRUCTURAL_HINT.split()) == len(g.PLACEBO_HINT.split())
