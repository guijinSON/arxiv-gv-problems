+def _triangular_forward(chain: list[int], b: list[int], q: int) -> list[int]:
+    """T: displayed-chain coordinates -> normal-basis coordinates."""
+    normal = [chain[0] % q]
+    for i in range(1, len(chain)):
+        normal.append((chain[i] + b[i - 1] * normal[i - 1]) % q)
+    return normal
