\title{Permutation binomials of the form  $x^r(x^{q-1}+a)$ over $\mathbb F_{q^e}$}
\author{Ariane M. Masuda, Ivelisse  Rubio, and Javier Santiago}


\address{Department of Mathematics, New York City College of Technology, The City University of New York (CUNY), 300 Jay Street, Brooklyn, NY 11201 USA}

