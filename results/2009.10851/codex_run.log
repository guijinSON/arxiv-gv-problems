+    target_chain = _to_chain(inst["target"], inst["slot_to_chain"])
+    normal = {
+        "q": inst["q"],
+        "e": inst["e"],
+        "a": inst["a"],
+        "basis_multipliers": list(inst["basis_multipliers"]),
+        "target_in_chain_order": target_chain,
+    }
