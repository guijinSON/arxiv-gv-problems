+def escalate(params):
+    """Grow base-field entropy while keeping the answer at 29 coordinates."""
+    p = dict(params)
+    e = int(p.get("n", 29))
+    q = int(p.get("q", 101))
+    new_q = _next_prime(2 * q + 1)
+    estimated_chars = e * (len(str(new_q - 1)) + 2) + 2
+    if estimated_chars > 1900:
+        return "cap_bound"
+    p["q"] = new_q
+    return p
