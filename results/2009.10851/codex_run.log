   384	def verify(inst, answer):
   385	    """Verify any valid preimage exactly, without consulting planted data."""
   386	    if not isinstance(answer, list):
   387	        return False, "answer must be a JSON list"
   388	    if not answer:
   389	        return False, "answer is empty"
   390	    e, q = inst["e"], inst["q"]
   391	    if len(answer) < e:
   392	        return False, f"too few coordinates: expected {e}"
   393	    if len(answer) > e:
   394	        return False, f"too many coordinates: expected {e}"
   395	    if any(isinstance(v, bool) or not isinstance(v, int) for v in answer):
   396	        return False, "every coordinate must be an integer"
   397	    if any(v < 0 or v >= q for v in answer):
   398	        return False, f"coordinate outside the required range 0..{q-1}"
   399	    if not any(answer):
   400	        return False, "the requested nonzero preimage cannot be the zero vector"
   401	    image = _apply_binomial(inst, answer)
   402	    for i, (got, wanted) in enumerate(zip(image, inst["target"])):
   403	        if got != wanted:
   404	            return False, (
   405	                f"image mismatch at displayed coordinate {i}: got {got}, "
   406	                f"expected {wanted}"
   407	            )
   408	    return True, "ok"
   409	
