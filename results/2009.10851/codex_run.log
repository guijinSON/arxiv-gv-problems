   411	def random_candidate(inst, rng):
   412	    """Uniformly sample the obvious, structure-aware nonzero field elements."""
   413	    e, q = inst["e"], inst["q"]
   414	    while True:
   415	        candidate = [rng.randrange(q) for _ in range(e)]
   416	        if any(candidate):
   417	            return candidate
   418	
   419	
   420	def search_space(inst):
   421	    return pow(inst["q"], inst["e"]) - 1
   422	
   423	
   424	def enumerate_all(inst):
   425	    size = search_space(inst)
   426	    if size > 200_000:
   427	        return None
   428	    hits = 0
   429	    for values in itertools.product(range(inst["q"]), repeat=inst["e"]):
   430	        if not any(values):
   431	            continue
   432	        hits += int(verify(inst, list(values))[0])
   433	    return hits
