+    cyclic_without_basis = _cycle_inverse(target, q)
+
+    # Recognize the basis metadata but omit the Frobenius-plus-identity inverse.
+    normal_target = _display_to_normal(inst, target)
+    basis_only = _normal_to_display(inst, normal_target)
