   374	        answer = json.loads(body)
   375	    except (TypeError, ValueError):
   376	        return None
   377	    if not isinstance(answer, list):
   378	        return None
   379	    if any(isinstance(v, bool) or not isinstance(v, int) for v in answer):
   380	        return None
   381	    return answer
