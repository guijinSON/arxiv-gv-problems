   495	def _materialize_matrix(inst: dict):
   496	    e = inst["e"]
   497	    matrix = [[0] * e for _ in range(e)]
   498	    # Applying T, I+S, and T^-1 to one vector costs
   499	    # 2(e-1) + e + 2(e-1) primitive field operations.
   500	    operations = 0
   501	    for col in range(e):
   502	        unit = [0] * e
   503	        unit[col] = 1
   504	        image = _apply_binomial(inst, unit)
   505	        operations += 5 * e - 4
   506	        for row, value in enumerate(image):
   507	            matrix[row][col] = value
   508	    return matrix, operations
   509	
   510	
   511	def _gaussian_solve(matrix: list[list[int]], rhs: list[int], q: int):
   512	    """Generic dense Gauss-Jordan elimination with an operation count."""
   513	    n = len(matrix)
   514	    aug = [row[:] + [rhs[i] % q] for i, row in enumerate(matrix)]
   515	    operations = 0
   516	    pivot_row = 0
   517	    pivots = []
   518	    for col in range(n):
   519	        pivot = next((r for r in range(pivot_row, n) if aug[r][col] % q), None)
   520	        if pivot is None:
   521	            continue
   522	        aug[pivot_row], aug[pivot] = aug[pivot], aug[pivot_row]
   523	        inv = pow(aug[pivot_row][col], q - 2, q)
   524	        operations += 1
   525	        for j in range(col, n + 1):
   526	            aug[pivot_row][j] = aug[pivot_row][j] * inv % q
   527	            operations += 1
   528	        for r in range(n):
   529	            if r == pivot_row or aug[r][col] == 0:
   530	                continue
   531	            factor = aug[r][col]
   532	            for j in range(col, n + 1):
   533	                aug[r][j] = (aug[r][j] - factor * aug[pivot_row][j]) % q
   534	                operations += 2
   535	        pivots.append(col)
   536	        pivot_row += 1
   537	        if pivot_row == n:
   538	            break
   539	    if len(pivots) != n:
   540	        return None, operations
   541	    solution = [0] * n
   542	    for row, col in enumerate(pivots):
   543	        solution[col] = aug[row][n]
   544	    return solution, operations
   545	
   546	
   547	def _reference_algorithm(inst: dict):
   548	    start = time.perf_counter()
   549	    matrix, materialize_ops = _materialize_matrix(inst)
   550	    solution, eliminate_ops = _gaussian_solve(matrix, inst["target"], inst["q"])
   551	    return solution, time.perf_counter() - start, materialize_ops + eliminate_ops
   552	
