+    reference_wall = sum(ref_times) / len(ref_times)
+    reference_ops = sum(ref_ops) // len(ref_ops)
+    all_attacks_failed = all(v["successes"] == 0 for v in attacks.values())
+    report["G6_adversary_panel"] = {
