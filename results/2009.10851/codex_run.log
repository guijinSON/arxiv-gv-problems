+    # eta'_i = unit * eta_(i+shift), so coordinates transform by the inverse
+    # unit and the corresponding cyclic rotation.
+    shift = rng.randrange(e)
+    unit = rng.randrange(1, q)
+    inverse_unit = pow(unit, q - 2, q)
