+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_minus_placebo,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": len(worst_case_blob),
+        "sample_answer_chars": len(blob),
