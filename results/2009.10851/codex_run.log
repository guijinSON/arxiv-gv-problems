   473	def escalate(params):
   474	    """Grow base-field entropy while keeping the answer at 29 coordinates."""
   475	    p = dict(params)
   476	    e = int(p.get("n", 29))
   477	    q = int(p.get("q", 101))
   478	    mersenne_61 = (1 << 61) - 1
   479	    mersenne_127 = (1 << 127) - 1
   480	    if q < mersenne_61:
   481	        new_q = _next_prime(min(2 * q + 1, mersenne_61))
   482	    elif q < mersenne_127:
   483	        new_q = mersenne_127
   484	    else:
   485	        return "cap_bound"
   486	    estimated_chars = e * (len(str(new_q - 1)) + 2) + 2
   487	    if estimated_chars > 1900:
   488	        return "cap_bound"
   489	    p["q"] = new_q
   490	    return p
