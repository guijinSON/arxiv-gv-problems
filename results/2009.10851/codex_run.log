   554	def _attack_candidates(inst: dict, rng: random.Random):
   555	    q, e = inst["q"], inst["e"]
   556	    target = inst["target"]
   557	
   558	    # Per-coordinate outlier: keep only the largest displayed target entry.
   559	    outlier = [0] * e
   560	    outlier[max(range(e), key=lambda i: (target[i], -i))] = max(target)
   561	    if not any(outlier):
   562	        outlier[0] = 1
   563	
   564	    direct = target[:]
   565	    inv_two = (q + 1) // 2
   566	    coordinatewise_half = [v * inv_two % q for v in target]
   567	
   568	    # Recognize the cyclic map but ignore the nontrivial displayed basis.
   569	    cyclic_without_basis = _cycle_inverse(target, q)
   570	
   571	    # Do the normal-coordinate solve but forget to convert its result back to
   572	    # the displayed basis.  This is a realistic partial-recognition failure.
   573	    normal_target = _display_to_normal(inst, target)
   574	    normal_answer_misread_as_display = _cycle_inverse(normal_target, q)
   575	
   576	    return {
   577	        "outlier_largest_target_coordinate": [outlier],
   578	        "direct_target_as_preimage": [direct],
   579	        "greedy_coordinatewise_divide_by_two": [coordinatewise_half],
   580	        "cyclic_inverse_without_basis_change": [cyclic_without_basis],
   581	        "omit_inverse_basis_change": [normal_answer_misread_as_display],
   582	        "random_restart_256": [random_candidate(inst, rng) for _ in range(256)],
   583	    }
   584	
   585	
   586	def _reorder_display_slots(inst: dict, rng: random.Random) -> dict:
   587	    """Apply a real representation relabelling and carry the witness through."""
   588	    old_for_new = list(range(inst["e"]))
   589	    rng.shuffle(old_for_new)
   590	    out = {k: v for k, v in inst.items() if k not in (
   591	        "slot_to_chain", "target", "answer"
   592	    )}
   593	    out["slot_to_chain"] = [inst["slot_to_chain"][i] for i in old_for_new]
   594	    out["target"] = [inst["target"][i] for i in old_for_new]
   595	    out["answer"] = [inst["answer"][i] for i in old_for_new]
   596	    return out
   597	
   598	
   599	def _change_coordinate_presentation(inst: dict, rng: random.Random) -> dict:
   600	    """Change basis/slots and carry target and answer through the isomorphism."""
   601	    e, q = inst["e"], inst["q"]
   602	    answer_normal = _display_to_normal(inst, inst["answer"])
   603	    target_normal = _display_to_normal(inst, inst["target"])
   604	
   605	    # eta'_i = unit * eta_(i+shift), so coordinates transform by the inverse
   606	    # unit and the corresponding cyclic rotation.
   607	    shift = rng.randrange(e)
   608	    unit = rng.randrange(1, q)
   609	    inverse_unit = pow(unit, q - 2, q)
   610	
   611	    def changed_normal(vector):
   612	        return [
   613	            vector[(i + shift) % e] * inverse_unit % q
   614	            for i in range(e)
   615	        ]
   616	
   617	    out = {k: v for k, v in inst.items() if k not in (
   618	        "basis_multipliers", "slot_to_chain", "target", "answer"
   619	    )}
   620	    out["basis_multipliers"] = [rng.randrange(1, q) for _ in range(e - 1)]
   621	    out["slot_to_chain"] = list(range(e))
   622	    rng.shuffle(out["slot_to_chain"])
   623	    out["answer"] = _normal_to_display(out, changed_normal(answer_normal))
   624	    out["target"] = _normal_to_display(out, changed_normal(target_normal))
   625	    return out
