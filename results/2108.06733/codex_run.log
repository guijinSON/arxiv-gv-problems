+        offsets = (0, 1, 3, 5, 7, 9, 12, 15, 17, 19, 21, 23)
+    else:  # The explicit symmetric masks are part of the construction.
+        raise ValueError("code_size must be 6 or 24")
+    return sum(1 << value for value in offsets)
