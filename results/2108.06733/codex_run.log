+
+def _attack_ordinary_gap(inst: dict):
+    markers = sorted(inst["markers"])
+    ordinary_counts: dict[int, int] = {}
+    for i, left in enumerate(markers):
+        for right in markers[i + 1 :]:
+            gap = right - left
+            ordinary_counts[gap] = ordinary_counts.get(gap, 0) + 1
+    gap = max(ordinary_counts, key=lambda value: (ordinary_counts[value], -value))
+    start = markers[0]
+    proposed = {
+        (start + offset * gap) % inst["n"]
+        for offset in range(inst["code_size"])
+    }
+    pool = set(inst["pool"])
+    marker_set = set(markers)
+    selected = set(value for value in proposed if value in pool)
+    # Repair only the explicit shape constraints, not the graph predicate.
+    for value in markers:
+        if len(selected & marker_set) >= inst["marker_required"]:
+            break
+        selected.add(value)
+    if len(selected & marker_set) > inst["marker_required"]:
+        for value in sorted(selected & marker_set, reverse=True):
+            if len(selected & marker_set) <= inst["marker_required"]:
+                break
+            selected.remove(value)
+    for value in inst["pool"]:
+        if len(selected) >= inst["code_size"]:
+            break
+        if value in selected:
+            continue
+        if value in marker_set and len(selected & marker_set) >= inst["marker_required"]:
+            continue
+        selected.add(value)
+    if len(selected) > inst["code_size"]:
+        # Preserve exactly the marker quota while truncating deterministically.
+        keep_marked = sorted(selected & marker_set)[: inst["marker_required"]]
+        keep_unmarked = sorted(selected - marker_set)[
+            : inst["code_size"] - inst["marker_required"]
+        ]
+        selected = set(keep_marked + keep_unmarked)
+    return sorted(selected)
+
+
+def _permuted_instance(inst: dict, permutation: list[int]) -> dict:
+    n = inst["n"]
+    new_rows = [0] * n
+    for old_vertex, old_row in enumerate(inst["closed_rows"]):
+        new_row = 0
+        for old_neighbor in _iter_bits(old_row):
+            new_row |= 1 << permutation[old_neighbor]
+        new_rows[permutation[old_vertex]] = new_row
+    return {
+        "n": n,
+        "index": inst["index"],
+        "code_size": inst["code_size"],
+        "pool": [permutation[value] for value in reversed(inst["pool"])],
+        "markers": [permutation[value] for value in reversed(inst["markers"])],
+        "marker_required": inst["marker_required"],
+        "closed_rows": new_rows,
+        "check_pairs": [
+            [permutation[left], permutation[right]]
+            for left, right in inst.get("check_pairs", ())
+        ],
+        "answer": sorted(permutation[value] for value in inst["answer"]),
+    }
+
+
+def _answer_size(answer: list[int]) -> tuple[int, int, int]:
+    serialised = json.dumps(answer, separators=(",", ":"))
+    chars = len(serialised)
+    tokens = math.ceil(chars / 4)
+    return chars, tokens, len(answer)
