+                "wide_bit_operations": wide_operations,
+                "estimated_64bit_word_operations": wide_operations * word_width,
+                "greedy_evaluations": greedy_evaluations,
+                "swap_evaluations": 0,
+                "repair_passes": 0,
+            }
+        vertex = max(
+            eligible,
+            key=lambda value: (
+                (coverage[value] & ~covered_twice).bit_count(),
+                -value,
