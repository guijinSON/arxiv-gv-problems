+    word_width = (n * n + 63) // 64
+    wide_operations = 0
+
+    coverage: dict[int, int] = {}
+    for vertex in pool:
+        neighborhood = rows[vertex]
+        complement = full_vertices ^ neighborhood
+        packed = 0
