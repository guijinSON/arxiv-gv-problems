+        "attacks": attack_results,
+        "reference_algorithm": reference_algorithm,
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] = _next_prime(2 * shipping["n"] + 1)
+    doubled_params["pool_size"] = min(
