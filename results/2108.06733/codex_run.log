+def _difference_counts(values: set[int], modulus: int) -> dict[int, int]:
+    counts: dict[int, int] = {}
+    for left in values:
+        for right in values:
+            if left != right:
+                difference = (right - left) % modulus
+                counts[difference] = counts.get(difference, 0) + 1
