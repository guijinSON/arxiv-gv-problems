+        covered_twice = 0
+        for vertex in selected:
+            bits = coverage[vertex]
+            covered_twice |= covered_once & bits
+            covered_once |= bits
+            wide_operations += 3
+        wide_operations += 1  # population count
+        return covered_twice.bit_count()
