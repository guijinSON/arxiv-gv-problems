+        reordered["pool"] = list(reversed(inst["pool"]))
+        reordered["markers"] = list(reversed(inst["markers"]))
+        if canonical_key(reordered) == key:
+            invariance_checks += 1
+        rng = random.Random(8000 + seed)
+        permutation = list(range(inst["n"]))
+        rng.shuffle(permutation)
