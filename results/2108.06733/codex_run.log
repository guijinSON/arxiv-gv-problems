+def _is_prime(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    limit = math.isqrt(value)
+    factor = 3
+    while factor <= limit:
+        if value % factor == 0:
+            return False
+        factor += 2
+    return True
+
+
+def _next_prime(value: int) -> int:
+    candidate = max(3, value | 1)
+    while not _is_prime(candidate):
+        candidate += 2
+    return candidate
