+
+def _iter_bits(mask: int):
+    while mask:
+        low = mask & -mask
+        yield low.bit_length() - 1
+        mask ^= low
+
+
+def _rotate_mask(mask: int, shift: int, width: int) -> int:
+    result = 0
+    for bit in _iter_bits(mask):
+        result |= 1 << ((bit + shift) % width)
+    return result
+
+
+def _base_code_mask(code_size: int) -> int:
+    if code_size == 6:
