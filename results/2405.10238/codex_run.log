+    variables = inst["label_bits"] + 1  # support bits, then affine constant
+    rows = []
+    for label, rhs in zip(inst["labels"], color):
+        coeff = label | (1 << inst["label_bits"])
+        rows.append(coeff | (rhs << variables))
