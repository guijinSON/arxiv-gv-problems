+    for column in range(variables):
+        pivot = None
+        for i in range(rank, len(rows)):
+            operations += 1
+            if (rows[i] >> column) & 1:
+                pivot = i
+                break
+        if pivot is None:
+            continue
+        rows[rank], rows[pivot] = rows[pivot], rows[rank]
+        for i in range(len(rows)):
+            if i == rank:
+                continue
+            operations += 1
+            if (rows[i] >> column) & 1:
+                rows[i] ^= rows[rank]
