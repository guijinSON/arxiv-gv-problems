+    answer = {"constant": 0, "support": support}
+    inst = {
+        "n": n,
+        "cube_dimension": cube_dim,
+        "label_bits": label_bits,
+        "weight": weight,
+        "target_size": n // 2,
+        "labels": labels,
+        "edges": edges,
+        "answer": answer,
+    }
