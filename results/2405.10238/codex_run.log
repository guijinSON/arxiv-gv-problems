+    # polynomial support size fixed.  This grows C(d,w) without transcription.
+    maximum = harder["n"] // 2 - 1 + harder["weight"]
+    if harder["label_bits"] + 8 > maximum:
+        return "cap_bound"
+    harder["label_bits"] += 8
+    return harder
