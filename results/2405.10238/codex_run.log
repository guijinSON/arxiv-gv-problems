+        inst, {"constant": 1, "support": wrong_support}
+    )[0]:
+        raise AssertionError("shape-correct corruption accepted")
+    report["G2_rejects_corruption"] = {
+        "pass": True,
+        "rejected": len(corruptions) + 2,
+        "distinct_reasons": len(set(reasons.values())),
