+    report["G8_canonical_key"] = {
+        "pass": invariant_checks == 80 and carried_checks == 80 and distinct == 20,
+        "invariance_checks": invariant_checks,
+        "carried_witness_checks": carried_checks,
+        "unrelated_distinct": distinct,
+        "unrelated_total": 20,
