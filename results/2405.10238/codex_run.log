+
+def _adjacency(inst):
+    adj = [[] for _ in range(inst["n"])]
+    for u, v in inst["edges"]:
+        adj[u].append(v)
+        adj[v].append(u)
+    return adj
+
+
+def _reference_solve(inst):
+    """BFS bipartition, then exact GF(2) Gauss-Jordan elimination."""
+    started = time.perf_counter()
+    adj = _adjacency(inst)
+    color = [-1] * inst["n"]
+    operations = 0
+    for start in range(inst["n"]):
+        if color[start] != -1:
+            continue
+        color[start] = 0
+        queue = deque([start])
+        while queue:
+            u = queue.popleft()
+            for v in adj[u]:
+                operations += 1
+                if color[v] == -1:
+                    color[v] = color[u] ^ 1
+                    queue.append(v)
+                elif color[v] == color[u]:
