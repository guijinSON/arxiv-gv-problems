+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "Affine polynomials P(x)=constant XOR the selected coordinates over "
+        "GF(2), with constant in {0,1} and exactly weight distinct support "
+        "indices from 0..label_bits-1."
+    ),
+    "bounds": {
