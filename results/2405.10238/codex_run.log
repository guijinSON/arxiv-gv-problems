+    for row in rows[:rank]:
+        coeff = row & ((1 << variables) - 1)
+        pivot_column = (coeff & -coeff).bit_length() - 1
+        rhs = (row >> variables) & 1
+        if rhs:
+            solution |= 1 << pivot_column
