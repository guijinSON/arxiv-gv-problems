+TRACK = "B"
+
+STRUCTURAL_HINT = (
+    "An XOR invariant links the binary labels to one vertex's graph neighborhood."
+)
+PLACEBO_HINT = (
+    "Careful bookkeeping links the binary labels to the requested polynomial coefficients."
+)
+
