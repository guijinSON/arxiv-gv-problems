+    larger = make_instance(seed=777, **doubled)
+    larger_ok, larger_reason = verify(larger, larger["answer"])
+    report["G7_scales"] = {
+        "pass": larger_ok and search_space(larger) >= search_space(inst),
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "doubled_verifies": larger_ok,
