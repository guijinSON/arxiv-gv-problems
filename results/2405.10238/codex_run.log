+            if canonical_key(variant) != key:
+                raise AssertionError("canonical key changed under a valid relabelling")
+            invariant_checks += 1
+            if not verify(variant, variant["answer"])[0]:
+                raise AssertionError("relabelling did not carry the witness")
+            carried_checks += 1
