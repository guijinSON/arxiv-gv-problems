+def _sample_with_parity(rng, bits, mask, wanted, used):
+    while True:
+        x = rng.getrandbits(bits)
+        if x not in used and _parity(x & mask) == wanted:
+            return x
+
+
+def _make_labels(rng, n, cube_dim, label_bits, support):
+    mask = sum(1 << j for j in support)
