+DIFFICULTY = {
+    "demo": {"n": 16, "label_bits": 10, "weight": 4},
+    "easy": {"n": 64, "label_bits": 36, "weight": 6},
+    "medium": {"n": 128, "label_bits": 48, "weight": 7},
+    "hard": {"n": 256, "label_bits": 64, "weight": 8},
+}
