import importlib.util
import json
import math
from pathlib import Path

module_path = Path('gen_2604_25734.py')
spec = importlib.util.spec_from_file_location('final_check', module_path)
gen = importlib.util.module_from_spec(spec)
spec.loader.exec_module(gen)
report = json.loads(Path('selftest_report.json').read_text())
params = gen.DIFFICULTY[gen.SHIPPING_DIFFICULTY]
inst = gen.make_instance(seed=0, **params)
checks = {
    'module_import': True,
    'native_declared': set(gen.NATIVE) == {'domain', 'core', 'objects', 'intuition', 'reduction'},
    'certificate_declared': set(gen.CERTIFICATE_LANGUAGE) == {'description', 'bounds'},
    'certificate_space_exact': gen.search_space(inst) == math.comb(len(inst['triples']), inst['n']),
    'planted_verifies': gen.verify(inst, inst['answer']) == (True, 'ok'),
    'all_reported_gates_pass': report.get('all_passed') is True and all(
        value.get('pass') is True for key, value in report.items() if key.startswith('G')
    ),
    'shipping_unchanged': gen.SHIPPING_DIFFICULTY == 'standard' and params == {'n': 80, 'set_ratio': 6},
    'report_matches_shipping': report['shipping_difficulty'] == gen.SHIPPING_DIFFICULTY
        and report['G5_density_and_baseline']['shipping_n'] == params['n'],
}
for name, ok in checks.items():
    print(f'{name}={\"ok\" if ok else \"FAIL\"}')
if not all(checks.values()):
    raise SystemExit(1)
g5 = report['G5_density_and_baseline']
print(f\"final_g5={g5['density_hits']}/{g5['density_samples']} valid; \"
      f\"{g5['baseline_nodes']} nodes; {g5['baseline_wall_seconds']} seconds; \"
      f\"solved={g5['baseline_solved']}\")
