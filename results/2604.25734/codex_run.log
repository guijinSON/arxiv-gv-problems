      "triple reordering",
      "within-triple reordering",
      "all composed"
    ],
    "unrelated_keys_distinct": 20,
    "unrelated_keys_tested": 20
  },
  "all_passed": true,
  "paper": "2604.25734",
  "shipping_difficulty": "standard"
}

