+def _attack_spectral(inst: dict, seed: int = 0) -> object | None:
+    _, _, conflicts = _structures(inst)
+    size = len(conflicts)
+    degrees = [mask.bit_count() - 1 for mask in conflicts]
+    rng = random.Random(seed)
+    vector = [rng.random() - 0.5 for _ in range(size)]
