  v=max((i for i,x in enumerate(a) if x<0),key=lambda q:sum(q==abs(l)-1 for c in cs for l in c))
  for w in (0,1):
   b=a[:];b[v]=w;res=rec(b)
   if res:return res
  return None
 return rec([-1]*n),nodes

for ratio in (2.5,3,4,5,6):
 print('"'ratio',ratio)
 for n in (80,120,160):
