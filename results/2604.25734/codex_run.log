+    triples = []
+    for old in order:
+        triple = [ground_perm[x] for x in inst["triples"][old]]
+        rng.shuffle(triple)
+        triples.append(triple)
+    out = {**inst, "triples": triples,
+           "answer": sorted(inverse_order[i] for i in inst["answer"])}
+    out.pop("_structures", None)
+    return out
