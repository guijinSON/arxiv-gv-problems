+"""Verified restricted Ulam 1-center instances from arXiv:2604.25734.
+
+The paper's pair-scheme embedding turns a binary closest-string instance into
+permutations without changing distances.  This module plants one pair-scheme
+center first, samples input permutations on a tight Ulam sphere around it, and
+asks for any pair-scheme center within the stated inclusive radius.
+"""
+
+from __future__ import annotations
+
+import bisect
+import hashlib
+import itertools
+import json
+import math
+import random
+import re
+
+
+DIFFICULTY = {
+    "standard": {"n": 96, "rows": 36, "gap": 2},
+    "hard": {"n": 128, "rows": 48, "gap": 2},
+    "extreme": {"n": 160, "rows": 60, "gap": 2},
+}
+SHIPPING_DIFFICULTY = "standard"
+
+NOTES = r"""
+Definition.  Section 2 of Bai, Fomin, Golovach, More, and Wietheger,
+"Clustering Permutations under the Ulam Metric: A Parameterized Complexity
+Study" (arXiv:2604.25734), defines Ulam distance as permutation length minus
+the length of a longest common subsequence.  Section 1.1 defines continuous
+Ulam k-Center: k center permutations need not be inputs, and every input must
+be within the inclusive radius d of some center.  We use k=1 and explicitly
+ask for the pair-scheme normal form from Section 3.3: each consecutive symbol
+pair is kept as a block and only its orientation is chosen.  Lemma 3.13
+(the pair-scheme distance lemma in the arXiv source) proves that Ulam distance
+between two such permutations is exactly the Hamming distance between their
+orientation strings.  The subsequent reduction proves that every unrestricted
+center can be normalized this way without increasing any input distance.
+
+Hard and easy regimes.  Section 1.1 records NP-hardness already for k=1, while
+Theorem 3.2 gives an FPT algorithm for the combined parameter k+d, with running
+time 2^{O(d^2 k(d+k))} m n^{1+o(1)}.  Therefore a generator with both k and d
+small would be misleading.  Here k=1 but d=n/2-2 grows linearly with the size
+parameter.  Theorem 3.1 also shows para-NP-hardness for fixed d when k grows,
+but that is a different regime and is not the claim used by this generator.
+
+Inverse generation.  A uniformly random center orientation is sampled before
+any input.  Every input then independently chooses exactly d coordinates to
+reverse, conditioned only on being distinct.  Thus all coordinates and all
+rows have the same construction distribution; there are no specially shaped
+plant symbols or decoy symbols.  Symbol labels, pair identities, and input-row
+order are randomized presentation data.  The radius sits only two below half
+the coordinates: each input is tight, but one-coordinate frequencies reveal
+only a weak bias toward the plant.
+
+Attacks.  The panel tests (1) the coordinate-frequency/majority outlier signal,
+(2) deterministic farthest-row greedy repair, (3) 256 randomized repair
+restarts beginning inside the obvious ball around the first input, and (4) a
+capped exact DPLL-style CSP search with cardinality lower bounds and unit
+propagation.  The last is the standard exact attack after applying the paper's
+pair normal form.  Shipping is allowed only when all four attacks fail on eight
+seeds.  The structure-aware guess prior is also uniform over the entire
+Hamming ball of radius d around the first input, rather than over arbitrary
+permutations or arbitrary bit strings.
+
+Canonicalization.  Alphabet names, pair-coordinate order, orientation names
+inside a pair, and input order are presentation symmetries.  Canonicalizing the
+entire binary matrix under simultaneous row/column permutations is a bipartite
+graph-isomorphism problem, so the key uses a strong cheap invariant: dimensions,
+radius, the complete sorted multiset of pairwise row distances, and the sorted
+multiset of distance triples.  It is invariant under every listed symmetry and
+their compositions, but can theoretically collide on nonisomorphic matrices;
+README.md records this limitation.
+""".strip()
+
+
+_ANSWER_RE = re.compile(
+    r"<answer\b[^>]*>(.*?)</answer\s*>", re.IGNORECASE | re.DOTALL
+)
+
+
+def _validate_params(n: int, rows: int, gap: int) -> tuple[int, int, int]:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 8:
+        raise ValueError("n must be an integer at least 8")
+    if n % 2:
+        raise ValueError("n must be even")
+    if isinstance(rows, bool) or not isinstance(rows, int) or rows < 3:
+        raise ValueError("rows must be an integer at least 3")
+    if isinstance(gap, bool) or not isinstance(gap, int) or not 1 <= gap < n // 2:
+        raise ValueError("gap must be an integer in 1..n/2-1")
+    return n, rows, gap
+
+
+def _bits_to_center(pairs: list[list[int]], bits: list[int]) -> list[int]:
+    out: list[int] = []
+    for pair, bit in zip(pairs, bits):
+        out.extend(pair if bit == 0 else reversed(pair))
+    return out
+
+
+def _decode_center(inst: dict, center: list[int]) -> list[int] | None:
+    bits = []
+    for i, pair in enumerate(inst["pairs"]):
+        block = center[2 * i:2 * i + 2]
+        if block == pair:
+            bits.append(0)
+        elif block == pair[::-1]:
+            bits.append(1)
+        else:
+            return None
+    return bits
+
+
+def _public_rows(inst: dict) -> list[list[int]]:
+    cached = inst.get("_decoded_rows")
+    if cached is not None:
+        return cached
+    n = inst["n"]
+    decoded: list[list[int]] = []
+    for row in inst["orientations"]:
+        if not isinstance(row, str) or len(row) != n or any(c not in "01" for c in row):
+            raise ValueError("instance contains a malformed orientation row")
+        decoded.append([int(c) for c in row])
+    return decoded
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Sample a center first, then build tight Ulam-sphere inputs around it.
+
+    ``n`` is the number of symbol pairs, so every actual permutation has length
+    ``2*n``.  The radius is ``n/2-gap`` and therefore grows with ``n``; ``rows``
+    is the number of distinct input permutations.  Increasing n with the other
+    ratios fixed enlarges the witness space and the exact-search depth.
+    """
+    rows = params.pop("rows", max(3, 3 * n // 8))
+    gap = params.pop("gap", 2)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    n, rows, gap = _validate_params(n, rows, gap)
+    radius = n // 2 - gap
+    if rows > math.comb(n, radius):
+        raise ValueError("rows exceeds the number of distinct sphere points")
+
+    rng = random.Random(seed)
+
+    # G: the witness exists before symbols or input permutations are sampled.
+    planted_bits = [rng.randrange(2) for _ in range(n)]
+
+    error_sets: set[tuple[int, ...]] = set()
+    while len(error_sets) < rows:
+        error_sets.add(tuple(sorted(rng.sample(range(n), radius))))
+    decoded_rows = []
+    for errors in error_sets:
+        bits = planted_bits[:]
+        for i in errors:
+            bits[i] ^= 1
+        decoded_rows.append(bits)
+    rng.shuffle(decoded_rows)
+
+    symbols = list(range(1, 2 * n + 1))
+    rng.shuffle(symbols)
+    pairs = [[symbols[2 * i], symbols[2 * i + 1]] for i in range(n)]
+    answer = _bits_to_center(pairs, planted_bits)
+    orientations = ["".join(map(str, bits)) for bits in decoded_rows]
+
+    # Cumulative exact weights for uniform sampling from the first Hamming ball.
+    cumulative = []
+    total = 0
+    for t in range(radius + 1):
+        total += math.comb(n, t)
+        cumulative.append(total)
+
+    return {
+        "family": "pair-scheme Ulam 1-center",
+        "n": n,
+        "rows": rows,
+        "gap": gap,
+        "radius": radius,
+        "pairs": pairs,
+        "orientations": orientations,
+        "_decoded_rows": decoded_rows,
+        "_ball_cumulative": cumulative,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Return the complete solver-facing Ulam-center problem."""
+    n = inst["n"]
+    pair_text = " ".join(f"({a},{b})" for a, b in inst["pairs"])
+    row_text = "\n".join(
+        f"P{i}: {bits}" for i, bits in enumerate(inst["orientations"])
+    )
+    example = _bits_to_center(inst["pairs"][:3], [0, 1, 0])
+    return f"""Restricted Ulam 1-Center
+
+There are {inst['rows']} input permutations, each of length {2 * n}, over the
+integer alphabet 1,...,{2 * n}.  A subsequence is obtained by deleting symbols
+without changing the order of those retained.  The Ulam distance between two
+permutations is their common length minus the length of a longest common
+subsequence.  Equivalently, it is the minimum number of symbols that must be
+removed and reinserted elsewhere to transform one permutation into the other.
+
+The ordered symbol pairs are:
+{pair_text}
+
+Each input below is encoded by a {n}-bit orientation string.  To expand a bit
+string into its permutation, scan bits and ordered pairs together from left to
+right.  Bit 0 emits the pair (a,b) as "a b"; bit 1 emits it as "b a".  Concatenate
+all {n} emitted blocks.  Bit positions are 0-based.  Every symbol occurs exactly
+once in every expanded input.
+
+{row_text}
+
+Find ONE center permutation whose Ulam distance from every input permutation is
+at most the inclusive radius d={inst['radius']}.  Your center is required to use
+the same pair-block scheme: it must contain the listed pairs in the listed block
+order, choosing either orientation independently in each block.  This normal-form
+restriction does not disclose the answer: it leaves 2^{n} candidate centers.
+
+Output the center as one JSON array of exactly {2 * n} integers.  It must be a
+permutation of 1,...,{2 * n}; order matters, repeats are forbidden, and the pair
+blocks must have the form just specified.
+
+Give your final answer inside <answer></answer> tags, as the JSON array.
+Example format using only three illustrative blocks: <answer>{json.dumps(example)}</answer>
+The real answer must contain exactly {2 * n} integers.  Output nothing else inside the tags."""
+
+
+def parse_answer(text: str) -> object | None:
+    """Parse the last tagged JSON array, tolerating prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```") and body.endswith("```"):
+        body = re.sub(r"^```(?:json|python)?\s*", "", body, flags=re.IGNORECASE)
+        body = re.sub(r"\s*```$", "", body).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any pair-normal-form center; never inspect ``inst['answer']``."""
+    n = inst["n"]
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) != 2 * n:
+        return False, f"wrong length: expected {2 * n}, got {len(answer)}"
+    for i, symbol in enumerate(answer):
+        if isinstance(symbol, bool) or not isinstance(symbol, int):
+            return False, f"entry {i} is not an integer"
+    alphabet = {x for pair in inst["pairs"] for x in pair}
+    for i, symbol in enumerate(answer):
+        if symbol not in alphabet:
+            return False, f"symbol {symbol} at entry {i} is outside the alphabet"
+    if len(set(answer)) != 2 * n:
+        return False, "a symbol is repeated"
+    bits = _decode_center(inst, answer)
+    if bits is None:
+        return False, "center violates the required pair-block scheme"
+
+    radius = inst["radius"]
+    try:
+        rows = _public_rows(inst)
+    except (TypeError, ValueError) as exc:
+        return False, f"malformed instance: {exc}"
+    for i, row in enumerate(rows):
+        distance = sum(a != b for a, b in zip(bits, row))
+        if distance > radius:
+            return False, (
+                f"input P{i} has Ulam distance {distance}, exceeding radius {radius}"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the obvious search ball around the first input.
+
+    The candidate already has the exact permutation/pair structure and satisfies
+    the first radius constraint.  Sampling arbitrary permutations or arbitrary
+    orientation strings would substantially exaggerate guess resistance.
+    """
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    n = inst["n"]
+    radius = inst["radius"]
+    rows = _public_rows(inst)
+    cumulative = inst.get("_ball_cumulative")
+    if cumulative is None:
+        cumulative = []
+        total = 0
+        for t in range(radius + 1):
+            total += math.comb(n, t)
+            cumulative.append(total)
+    draw = rng.randrange(cumulative[-1])
+    flips = bisect.bisect_right(cumulative, draw)
+    bits = rows[0][:]
+    for i in rng.sample(range(n), flips):
+        bits[i] ^= 1
+    return _bits_to_center(inst["pairs"], bits)
+
+
+def search_space(inst: dict) -> int | None:
+    """Number of statement-valid pair-scheme candidate centers."""
+    return 1 << inst["n"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Exactly count centers for n<=22; decline larger exponential work."""
+    n = inst["n"]
+    if n > 22:
+        return None
+    rows = _public_rows(inst)
+    radius = inst["radius"]
+    masks = []
+    for row in rows:
+        mask = sum(bit << i for i, bit in enumerate(row))
+        masks.append(mask)
+    return sum(
+        all((candidate ^ row).bit_count() <= radius for row in masks)
+        for candidate in range(1 << n)
+    )
+
+
+def canonical_key(inst: dict) -> str:
+    """Strong invariant under labels, row order, coordinate order, and flips.
+
+    Full binary-matrix isomorphism is not attempted; see NOTES/README caveat.
+    """
+    rows = _public_rows(inst)
+    m = len(rows)
+    distances = [[0] * m for _ in range(m)]
+    pairs = []
+    for i in range(m):
+        for j in range(i + 1, m):
+            d = sum(a != b for a, b in zip(rows[i], rows[j]))
+            distances[i][j] = distances[j][i] = d
+            pairs.append(d)
+    triples = []
+    for i, j, k in itertools.combinations(range(m), 3):
+        triples.append(tuple(sorted((distances[i][j], distances[i][k], distances[j][k]))))
+    payload = [inst["n"], m, inst["radius"], sorted(pairs), sorted(triples)]
+    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
+
+
+def escalate(params: dict) -> dict | None:
+    """Increase the CSP dimension and constraints while keeping the tight regime."""
+    if "n" not in params:
+        return None
+    out = dict(params)
+    old_n = int(params["n"])
+    new_n = 2 * math.ceil((old_n * 4 / 3) / 2)
+    out["n"] = new_n
+    out["rows"] = max(int(params.get("rows", 3 * old_n // 8) * 4 / 3), 3)
+    return out
+
+
+def _candidate_bits(inst: dict, bits: list[int]) -> list[int]:
+    return _bits_to_center(inst["pairs"], bits)
+
+
+def _attack_frequency_majority(inst: dict) -> object:
+    rows = _public_rows(inst)
+    m = len(rows)
+    bits = [int(sum(row[i] for row in rows) * 2 > m) for i in range(inst["n"])]
+    return _candidate_bits(inst, bits)
+
+
+def _attack_greedy_farthest(inst: dict, start: list[int] | None = None,
+                            step_limit: int | None = None) -> object | None:
+    """Farthest-constraint one-flip descent with cycle detection."""
+    rows = _public_rows(inst)
+    n = inst["n"]
+    radius = inst["radius"]
+    bits = (start[:] if start is not None else rows[0][:])
+    seen = set()
+    for _ in range(step_limit or 4 * n):
+        distances = [sum(a != b for a, b in zip(bits, row)) for row in rows]
+        if max(distances) <= radius:
+            return _candidate_bits(inst, bits)
+        state = tuple(bits)
+        if state in seen:
+            return None
+        seen.add(state)
+        worst = max(range(len(rows)), key=lambda r: (distances[r], r))
+        options = [i for i in range(n) if bits[i] != rows[worst][i]]
+        if not options:
+            return None
+        best = None
+        best_key = None
+        for coordinate in options:
+            trial_distances = [d + (1 if bits[coordinate] == row[coordinate] else -1)
+                               for d, row in zip(distances, rows)]
+            key = (max(trial_distances), sum(x * x for x in trial_distances), coordinate)
+            if best_key is None or key < best_key:
+                best_key = key
+                best = coordinate
+        assert best is not None
+        bits[best] ^= 1
+    return None
+
+
+def _attack_random_restarts(inst: dict, rng: random.Random,
+                            restarts: int = 256) -> object | None:
+    rows = _public_rows(inst)
+    n = inst["n"]
+    radius = inst["radius"]
+    for _ in range(restarts):
+        # Begin from a uniformly sized random perturbation inside P0's ball.
+        t = rng.randrange(radius + 1)
+        bits = rows[0][:]
+        for i in rng.sample(range(n), t):
+            bits[i] ^= 1
+        seen = set()
+        for _step in range(2 * n):
+            distances = [sum(a != b for a, b in zip(bits, row)) for row in rows]
+            if max(distances) <= radius:
+                return _candidate_bits(inst, bits)
+            state = tuple(bits)
+            if state in seen:
+                break
+            seen.add(state)
+            maximum = max(distances)
+            bad = [r for r, d in enumerate(distances) if d == maximum]
+            worst = rng.choice(bad)
+            options = [i for i in range(n) if bits[i] != rows[worst][i]]
+            if not options:
+                break
+            rng.shuffle(options)
+            sample = options[:min(12, len(options))]
+            scored = []
+            for coordinate in sample:
+                ds = [d + (1 if bits[coordinate] == row[coordinate] else -1)
+                      for d, row in zip(distances, rows)]
+                scored.append(((max(ds), sum(x * x for x in ds)), coordinate))
+            best_score = min(score for score, _ in scored)
+            choices = [coordinate for score, coordinate in scored if score == best_score]
+            bits[rng.choice(choices)] ^= 1
+    return None
+
+
+def _attack_dpll(inst: dict, node_limit: int = 50_000) -> tuple[object | None, int]:
+    """Capped exact CSP search with cardinality pruning and unit propagation."""
+    rows = _public_rows(inst)
+    n = inst["n"]
+    m = len(rows)
+    radius = inst["radius"]
+    column_majority = [int(sum(row[i] for row in rows) * 2 > m) for i in range(n)]
+    nodes = 0
+
+    def search(values: list[int], mismatches: list[int]) -> list[int] | None:
+        nonlocal nodes
+        if nodes >= node_limit:
+            return None
+        nodes += 1
+        if any(x > radius for x in mismatches):
+            return None
+
+        values = values[:]
+        mismatches = mismatches[:]
+        while True:
+            forced: dict[int, int] = {}
+            for r, mismatch in enumerate(mismatches):
+                if mismatch == radius:
+                    for i, value in enumerate(values):
+                        if value == -1:
+                            want = rows[r][i]
+                            if i in forced and forced[i] != want:
+                                return None
+                            forced[i] = want
+            if not forced:
+                break
+            for i, value in forced.items():
+                if values[i] != -1:
+                    continue
+                values[i] = value
+                for r in range(m):
+                    mismatches[r] += value != rows[r][i]
+            if any(x > radius for x in mismatches):
+                return None
+
+        if all(value != -1 for value in values):
+            return values
+
+        # Branch where the tightest constraints disagree most strongly.
+        best_i = -1
+        best_score = -1.0
+        best_vote = 0.0
+        for i, value in enumerate(values):
+            if value != -1:
+                continue
+            vote = 0.0
+            for r in range(m):
+                weight = 1.0 / (radius - mismatches[r] + 1)
+                vote += weight if rows[r][i] else -weight
+            score = abs(vote)
+            if score > best_score:
+                best_i, best_score, best_vote = i, score, vote
+        first = int(best_vote > 0) if best_vote else column_majority[best_i]
+        for value in (first, 1 - first):
+            child = values[:]
+            child[best_i] = value
+            child_mismatch = [x + (value != rows[r][best_i])
+                              for r, x in enumerate(mismatches)]
+            found = search(child, child_mismatch)
+            if found is not None:
+                return found
+            if nodes >= node_limit:
+                break
+        return None
+
+    found = search([-1] * n, [0] * m)
+    return (_candidate_bits(inst, found) if found is not None else None), nodes
+
+
+def _transformed_instance(inst: dict, rng: random.Random) -> dict:
+    """Compose all declared presentation symmetries and carry the answer."""
+    n = inst["n"]
+    order = list(range(n))
+    rng.shuffle(order)
+    swap = [rng.randrange(2) for _ in range(n)]
+    labels = [x for pair in inst["pairs"] for x in pair]
+    shuffled = labels[:]
+    rng.shuffle(shuffled)
+    rename = dict(zip(labels, shuffled))
+
+    new_pairs = []
+    for old in order:
+        pair = inst["pairs"][old][::-1] if swap[old] else inst["pairs"][old]
+        new_pairs.append([rename[x] for x in pair])
+
+    old_rows = _public_rows(inst)
+    new_rows = [[old_row[old] ^ swap[old] for old in order] for old_row in old_rows]
+    rng.shuffle(new_rows)
+    planted = _decode_center(inst, inst["answer"])
+    assert planted is not None
+    new_planted = [planted[old] ^ swap[old] for old in order]
+    out = {
+        **inst,
+        "pairs": new_pairs,
+        "orientations": ["".join(map(str, row)) for row in new_rows],
+        "_decoded_rows": new_rows,
+        "answer": _bits_to_center(new_pairs, new_planted),
+    }
+    return out
+
+
+def _find_invalid_one_pair_flip(inst: dict) -> list[int]:
+    planted = _decode_center(inst, inst["answer"])
+    assert planted is not None
+    for i in range(inst["n"]):
+        trial = planted[:]
+        trial[i] ^= 1
+        candidate = _candidate_bits(inst, trial)
+        if not verify(inst, candidate)[0]:
+            return candidate
+    raise AssertionError("every one-pair flip unexpectedly remained feasible")
+
+
+def selftest() -> dict:
+    """Run mandatory gates G1--G8 and return JSON-serializable evidence."""
+    report: dict[str, object] = {
+        "paper": "2604.25734",
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    verified = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 2):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            if not ok:
+                raise AssertionError(f"G1 {preset}/{seed}: {why}")
+            verified += 1
+    report["G1_planted_verifies"] = {
+        "pass": True, "verified": verified, "attempted": verified
+    }
+
+    base = make_instance(seed=19, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    duplicate = base["answer"][:]
+    duplicate[1] = duplicate[0]
+    cross_swap = base["answer"][:]
+    cross_swap[1], cross_swap[2] = cross_swap[2], cross_swap[1]
+    out_of_range = base["answer"][:]
+    out_of_range[0] = 2 * base["n"] + 1
+    corruptions = {
+        "drop_one": base["answer"][:-1],
+        "swap_two": cross_swap,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    reasons = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(base, candidate)
+        if ok:
+            raise AssertionError(f"G2 accepted {name}")
+        reasons[name] = why
+    if len(set(reasons.values())) != len(reasons):
+        raise AssertionError(f"G2 reasons are not distinct: {reasons}")
+    report["G2_rejects_corruption"] = {
+        "pass": True, "rejected": len(reasons), "attempted": len(reasons),
+        "reasons": reasons,
+    }
+
+    realistic = (
+        "I normalized each pair and checked all radii.\n```json\n<answer>\n"
+        + json.dumps(base["answer"])
+        + "\n</answer>\n```\nThis is my final center."
+    )
+    parsed = parse_answer(realistic)
+    if parsed != base["answer"]:
+        raise AssertionError("G3 realistic response failed to round-trip")
+    report["G3_round_trip"] = {
+        "pass": True, "entries_recovered": len(parsed),
+        "prose": True, "markdown_fence": True,
+    }
+
+    guess_inst = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    guess_rng = random.Random(271828)
+    samples = 200_000
+    hits = 0
+    for _ in range(samples):
+        hits += bool(verify(guess_inst, random_candidate(guess_inst, guess_rng))[0])
+    probability = hits / samples
+    if probability >= 1e-6:
+        raise AssertionError(f"G4 guess rate {hits}/{samples} is too high")
+    report["G4_guess_resistance"] = {
+        "pass": True, "hits": hits, "samples": samples,
+        "measured_probability": probability,
+        "prior": "uniform over the full radius-d Hamming ball around public input P0",
+        "structured_prior_size": str(guess_inst["_ball_cumulative"][-1]),
+        "naive_pair_scheme_space": str(search_space(guess_inst)),
+    }
+
+    sparse_instances = []
+    for seed in (5, 6, 7):
+        small = make_instance(n=18, rows=10, gap=2, seed=seed)
+        count = enumerate_all(small)
+        space = search_space(small)
+        if count is None:
+            raise AssertionError("G5 declined its small exact instance")
+        fraction = count / space
+        if fraction >= 1e-3:
+            raise AssertionError(f"G5 solution fraction {fraction} is not tiny")
+        sparse_instances.append({
+            "seed": seed, "solutions": count, "space": space,
+            "fraction": fraction,
+        })
+    report["G5_sparse"] = {"pass": True, "instances": sparse_instances}
+
+    attack_names = (
+        "outlier_coordinate_majority",
+        "greedy_farthest_repair",
+        "random_restart_256",
+        "dpll_cardinality_50000_nodes",
+    )
+    successes = {name: 0 for name in attack_names}
+    dpll_nodes = []
+    attack_seeds = list(range(800, 808))
+    for seed in attack_seeds:
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        dpll_candidate, nodes = _attack_dpll(inst, 50_000)
+        dpll_nodes.append(nodes)
+        candidates = {
+            "outlier_coordinate_majority": _attack_frequency_majority(inst),
+            "greedy_farthest_repair": _attack_greedy_farthest(inst),
+            "random_restart_256": _attack_random_restarts(
+                inst, random.Random(90_000 + seed), 256
+            ),
+            "dpll_cardinality_50000_nodes": dpll_candidate,
+        }
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(inst, candidate)[0]:
+                successes[name] += 1
+    attacks = {
+        name: {"successes": successes[name], "attempts": len(attack_seeds)}
+        for name in attack_names
+    }
+    all_failed = all(value == 0 for value in successes.values())
+    if not all_failed:
+        raise AssertionError(f"G6 attack succeeded: {successes}")
+    report["G6_adversary_panel"] = {
+        "pass": True, "attacks": attacks,
+        "domain_attack": "dpll_cardinality_50000_nodes",
+        "dpll_nodes": dpll_nodes,
+    }
+
+    scale_base = make_instance(seed=77, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled = make_instance(
+        n=2 * scale_base["n"], rows=2 * scale_base["rows"],
+        gap=scale_base["gap"], seed=77,
+    )
+    ok, why = verify(doubled, doubled["answer"])
+    if not ok:
+        raise AssertionError(f"G7 doubled instance failed: {why}")
+    if search_space(doubled) <= search_space(scale_base):
+        raise AssertionError("G7 candidate space did not grow")
+    report["G7_scales"] = {
+        "pass": True, "base_n": scale_base["n"], "doubled_n": doubled["n"],
+        "base_rows": scale_base["rows"], "doubled_rows": doubled["rows"],
+        "base_space": str(search_space(scale_base)),
+        "doubled_space": str(search_space(doubled)),
+        "doubled_planted_verifies": True,
+    }
+
+    invariance = 0
+    carried = 0
+    keys = []
+    for seed in range(20):
+        small = make_instance(n=24, rows=12, gap=2, seed=10_000 + seed)
+        transformed = _transformed_instance(small, random.Random(20_000 + seed))
+        if canonical_key(small) != canonical_key(transformed):
+            raise AssertionError(f"G8 invariant changed at seed {seed}")
+        invariance += 1
+        ok, why = verify(transformed, transformed["answer"])
+        if not ok:
+            raise AssertionError(f"G8 carried witness failed at seed {seed}: {why}")
+        carried += 1
+        keys.append(canonical_key(small))
+    distinct = len(set(keys))
+    if distinct != len(keys):
+        raise AssertionError(f"G8 only {distinct}/{len(keys)} unrelated keys distinct")
+    report["G8_canonical_key"] = {
+        "pass": True,
+        "invariance_transformations": invariance,
+        "carried_witnesses_verified": carried,
+        "unrelated_keys_distinct": distinct,
+        "unrelated_keys_tested": len(keys),
+        "symmetries": [
+            "alphabet relabelling", "input-row permutation",
+            "pair-coordinate permutation", "within-pair orientation relabelling",
+            "all composed",
+        ],
+        "limitation": "strong invariant, not a complete binary-matrix isomorphism canon",
+    }
+
+    report["all_passed"] = all(
+        value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

diff --git a/gen_2604_25734.py b/gen_2604_25734.py
new file mode 100644
index 0000000000000000000000000000000000000000..ccd9378b1981b802913051bbe810331525b8e5fe
--- /dev/null
+++ b/gen_2604_25734.py
@@ -0,0 +1,756 @@
+"""Verified restricted Ulam 1-center instances from arXiv:2604.25734.
+
+The paper's pair-scheme embedding turns a binary closest-string instance into
+permutations without changing distances.  This module plants one pair-scheme
+center first, samples input permutations on a tight Ulam sphere around it, and
+asks for any pair-scheme center within the stated inclusive radius.
+"""
+
+from __future__ import annotations
+
+import bisect
+import hashlib
+import itertools
+import json
+import math
+import random
+import re
+
+
+DIFFICULTY = {
+    "standard": {"n": 96, "rows": 36, "gap": 2},
+    "hard": {"n": 128, "rows": 48, "gap": 2},
+    "extreme": {"n": 160, "rows": 60, "gap": 2},
+}
+SHIPPING_DIFFICULTY = "standard"
+
+NOTES = r"""
+Definition.  Section 2 of Bai, Fomin, Golovach, More, and Wietheger,
+"Clustering Permutations under the Ulam Metric: A Parameterized Complexity
+Study" (arXiv:2604.25734), defines Ulam distance as permutation length minus
+the length of a longest common subsequence.  Section 1.1 defines continuous
+Ulam k-Center: k center permutations need not be inputs, and every input must
+be within the inclusive radius d of some center.  We use k=1 and explicitly
+ask for the pair-scheme normal form from Section 3.3: each consecutive symbol
+pair is kept as a block and only its orientation is chosen.  Lemma 3.13
+(the pair-scheme distance lemma in the arXiv source) proves that Ulam distance
+between two such permutations is exactly the Hamming distance between their
+orientation strings.  The subsequent reduction proves that every unrestricted
+center can be normalized this way without increasing any input distance.
+
+Hard and easy regimes.  Section 1.1 records NP-hardness already for k=1, while
+Theorem 3.2 gives an FPT algorithm for the combined parameter k+d, with running
+time 2^{O(d^2 k(d+k))} m n^{1+o(1)}.  Therefore a generator with both k and d
+small would be misleading.  Here k=1 but d=n/2-2 grows linearly with the size
+parameter.  Theorem 3.1 also shows para-NP-hardness for fixed d when k grows,
+but that is a different regime and is not the claim used by this generator.
+
+Inverse generation.  A uniformly random center orientation is sampled before
+any input.  Every input then independently chooses exactly d coordinates to
+reverse, conditioned only on being distinct.  Thus all coordinates and all
+rows have the same construction distribution; there are no specially shaped
+plant symbols or decoy symbols.  Symbol labels, pair identities, and input-row
+order are randomized presentation data.  The radius sits only two below half
+the coordinates: each input is tight, but one-coordinate frequencies reveal
+only a weak bias toward the plant.
+
+Attacks.  The panel tests (1) the coordinate-frequency/majority outlier signal,
+(2) deterministic farthest-row greedy repair, (3) 256 randomized repair
+restarts beginning inside the obvious ball around the first input, and (4) a
+capped exact DPLL-style CSP search with cardinality lower bounds and unit
+propagation.  The last is the standard exact attack after applying the paper's
+pair normal form.  Shipping is allowed only when all four attacks fail on eight
+seeds.  The structure-aware guess prior is also uniform over the entire
+Hamming ball of radius d around the first input, rather than over arbitrary
+permutations or arbitrary bit strings.
+
+Canonicalization.  Alphabet names, pair-coordinate order, orientation names
+inside a pair, and input order are presentation symmetries.  Canonicalizing the
+entire binary matrix under simultaneous row/column permutations is a bipartite
+graph-isomorphism problem, so the key uses a strong cheap invariant: dimensions,
+radius, the complete sorted multiset of pairwise row distances, and the sorted
+multiset of distance triples.  It is invariant under every listed symmetry and
+their compositions, but can theoretically collide on nonisomorphic matrices;
+README.md records this limitation.
+""".strip()
+
+
+_ANSWER_RE = re.compile(
+    r"<answer\b[^>]*>(.*?)</answer\s*>", re.IGNORECASE | re.DOTALL
+)
+
+
+def _validate_params(n: int, rows: int, gap: int) -> tuple[int, int, int]:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 8:
+        raise ValueError("n must be an integer at least 8")
+    if n % 2:
+        raise ValueError("n must be even")
+    if isinstance(rows, bool) or not isinstance(rows, int) or rows < 3:
+        raise ValueError("rows must be an integer at least 3")
+    if isinstance(gap, bool) or not isinstance(gap, int) or not 1 <= gap < n // 2:
+        raise ValueError("gap must be an integer in 1..n/2-1")
+    return n, rows, gap
+
+
+def _bits_to_center(pairs: list[list[int]], bits: list[int]) -> list[int]:
+    out: list[int] = []
+    for pair, bit in zip(pairs, bits):
+        out.extend(pair if bit == 0 else reversed(pair))
+    return out
+
+
+def _decode_center(inst: dict, center: list[int]) -> list[int] | None:
+    bits = []
+    for i, pair in enumerate(inst["pairs"]):
+        block = center[2 * i:2 * i + 2]
+        if block == pair:
+            bits.append(0)
+        elif block == pair[::-1]:
+            bits.append(1)
+        else:
+            return None
+    return bits
+
+
+def _public_rows(inst: dict) -> list[list[int]]:
+    cached = inst.get("_decoded_rows")
+    if cached is not None:
+        return cached
+    n = inst["n"]
+    decoded: list[list[int]] = []
+    for row in inst["orientations"]:
+        if not isinstance(row, str) or len(row) != n or any(c not in "01" for c in row):
+            raise ValueError("instance contains a malformed orientation row")
+        decoded.append([int(c) for c in row])
+    return decoded
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Sample a center first, then build tight Ulam-sphere inputs around it.
+
+    ``n`` is the number of symbol pairs, so every actual permutation has length
+    ``2*n``.  The radius is ``n/2-gap`` and therefore grows with ``n``; ``rows``
+    is the number of distinct input permutations.  Increasing n with the other
+    ratios fixed enlarges the witness space and the exact-search depth.
+    """
+    rows = params.pop("rows", max(3, 3 * n // 8))
+    gap = params.pop("gap", 2)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    n, rows, gap = _validate_params(n, rows, gap)
+    radius = n // 2 - gap
+    if rows > math.comb(n, radius):
+        raise ValueError("rows exceeds the number of distinct sphere points")
+
+    rng = random.Random(seed)
+
+    # G: the witness exists before symbols or input permutations are sampled.
+    planted_bits = [rng.randrange(2) for _ in range(n)]
+
+    error_sets: set[tuple[int, ...]] = set()
+    while len(error_sets) < rows:
+        error_sets.add(tuple(sorted(rng.sample(range(n), radius))))
+    decoded_rows = []
+    for errors in error_sets:
+        bits = planted_bits[:]
+        for i in errors:
+            bits[i] ^= 1
+        decoded_rows.append(bits)
+    rng.shuffle(decoded_rows)
+
+    symbols = list(range(1, 2 * n + 1))
+    rng.shuffle(symbols)
+    pairs = [[symbols[2 * i], symbols[2 * i + 1]] for i in range(n)]
+    answer = _bits_to_center(pairs, planted_bits)
+    orientations = ["".join(map(str, bits)) for bits in decoded_rows]
+
+    # Cumulative exact weights for uniform sampling from the first Hamming ball.
+    cumulative = []
+    total = 0
+    for t in range(radius + 1):
+        total += math.comb(n, t)
+        cumulative.append(total)
+
+    return {
+        "family": "pair-scheme Ulam 1-center",
+        "n": n,
+        "rows": rows,
+        "gap": gap,
+        "radius": radius,
+        "pairs": pairs,
+        "orientations": orientations,
+        "_decoded_rows": decoded_rows,
+        "_ball_cumulative": cumulative,
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    """Return the complete solver-facing Ulam-center problem."""
+    n = inst["n"]
+    pair_text = " ".join(f"({a},{b})" for a, b in inst["pairs"])
+    row_text = "\n".join(
+        f"P{i}: {bits}" for i, bits in enumerate(inst["orientations"])
+    )
+    example = _bits_to_center(inst["pairs"][:3], [0, 1, 0])
+    return f"""Restricted Ulam 1-Center
+
+There are {inst['rows']} input permutations, each of length {2 * n}, over the
+integer alphabet 1,...,{2 * n}.  A subsequence is obtained by deleting symbols
+without changing the order of those retained.  The Ulam distance between two
+permutations is their common length minus the length of a longest common
+subsequence.  Equivalently, it is the minimum number of symbols that must be
+removed and reinserted elsewhere to transform one permutation into the other.
+
+The ordered symbol pairs are:
+{pair_text}
+
+Each input below is encoded by a {n}-bit orientation string.  To expand a bit
+string into its permutation, scan bits and ordered pairs together from left to
+right.  Bit 0 emits the pair (a,b) as "a b"; bit 1 emits it as "b a".  Concatenate
+all {n} emitted blocks.  Bit positions are 0-based.  Every symbol occurs exactly
+once in every expanded input.
+
+{row_text}
+
+Find ONE center permutation whose Ulam distance from every input permutation is
+at most the inclusive radius d={inst['radius']}.  Your center is required to use
+the same pair-block scheme: it must contain the listed pairs in the listed block
+order, choosing either orientation independently in each block.  This normal-form
+restriction does not disclose the answer: it leaves 2^{n} candidate centers.
+
+Output the center as one JSON array of exactly {2 * n} integers.  It must be a
+permutation of 1,...,{2 * n}; order matters, repeats are forbidden, and the pair
+blocks must have the form just specified.
+
+Give your final answer inside <answer></answer> tags, as the JSON array.
+Example format using only three illustrative blocks: <answer>{json.dumps(example)}</answer>
+The real answer must contain exactly {2 * n} integers.  Output nothing else inside the tags."""
+
+
+def parse_answer(text: str) -> object | None:
+    """Parse the last tagged JSON array, tolerating prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```") and body.endswith("```"):
+        body = re.sub(r"^```(?:json|python)?\s*", "", body, flags=re.IGNORECASE)
+        body = re.sub(r"\s*```$", "", body).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return value
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any pair-normal-form center; never inspect ``inst['answer']``."""
+    n = inst["n"]
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) != 2 * n:
+        return False, f"wrong length: expected {2 * n}, got {len(answer)}"
+    for i, symbol in enumerate(answer):
+        if isinstance(symbol, bool) or not isinstance(symbol, int):
+            return False, f"entry {i} is not an integer"
+    alphabet = {x for pair in inst["pairs"] for x in pair}
+    for i, symbol in enumerate(answer):
+        if symbol not in alphabet:
+            return False, f"symbol {symbol} at entry {i} is outside the alphabet"
+    if len(set(answer)) != 2 * n:
+        return False, "a symbol is repeated"
+    bits = _decode_center(inst, answer)
+    if bits is None:
+        return False, "center violates the required pair-block scheme"
+
+    radius = inst["radius"]
+    try:
+        rows = _public_rows(inst)
+    except (TypeError, ValueError) as exc:
+        return False, f"malformed instance: {exc}"
+    for i, row in enumerate(rows):
+        distance = sum(a != b for a, b in zip(bits, row))
+        if distance > radius:
+            return False, (
+                f"input P{i} has Ulam distance {distance}, exceeding radius {radius}"
+            )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample the obvious search ball around the first input.
+
+    The candidate already has the exact permutation/pair structure and satisfies
+    the first radius constraint.  Sampling arbitrary permutations or arbitrary
+    orientation strings would substantially exaggerate guess resistance.
+    """
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    n = inst["n"]
+    radius = inst["radius"]
+    rows = _public_rows(inst)
+    cumulative = inst.get("_ball_cumulative")
+    if cumulative is None:
+        cumulative = []
+        total = 0
+        for t in range(radius + 1):
+            total += math.comb(n, t)
+            cumulative.append(total)
+    draw = rng.randrange(cumulative[-1])
+    flips = bisect.bisect_right(cumulative, draw)
+    bits = rows[0][:]
+    for i in rng.sample(range(n), flips):
+        bits[i] ^= 1
+    return _bits_to_center(inst["pairs"], bits)
+
+
+def search_space(inst: dict) -> int | None:
+    """Number of statement-valid pair-scheme candidate centers."""
+    return 1 << inst["n"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Exactly count centers for n<=22; decline larger exponential work."""
+    n = inst["n"]
+    if n > 22:
+        return None
+    rows = _public_rows(inst)
+    radius = inst["radius"]
+    masks = []
+    for row in rows:
+        mask = sum(bit << i for i, bit in enumerate(row))
+        masks.append(mask)
+    return sum(
+        all((candidate ^ row).bit_count() <= radius for row in masks)
+        for candidate in range(1 << n)
+    )
+
+
+def canonical_key(inst: dict) -> str:
+    """Strong invariant under labels, row order, coordinate order, and flips.
+
+    Full binary-matrix isomorphism is not attempted; see NOTES/README caveat.
+    """
+    rows = _public_rows(inst)
+    m = len(rows)
+    distances = [[0] * m for _ in range(m)]
+    pairs = []
+    for i in range(m):
+        for j in range(i + 1, m):
+            d = sum(a != b for a, b in zip(rows[i], rows[j]))
+            distances[i][j] = distances[j][i] = d
+            pairs.append(d)
+    triples = []
+    for i, j, k in itertools.combinations(range(m), 3):
+        triples.append(tuple(sorted((distances[i][j], distances[i][k], distances[j][k]))))
+    payload = [inst["n"], m, inst["radius"], sorted(pairs), sorted(triples)]
+    return hashlib.sha256(json.dumps(payload, separators=(",", ":")).encode()).hexdigest()
+
+
+def escalate(params: dict) -> dict | None:
+    """Increase the CSP dimension and constraints while keeping the tight regime."""
+    if "n" not in params:
+        return None
+    out = dict(params)
+    old_n = int(params["n"])
+    new_n = 2 * math.ceil((old_n * 4 / 3) / 2)
+    out["n"] = new_n
+    out["rows"] = max(int(params.get("rows", 3 * old_n // 8) * 4 / 3), 3)
+    return out
+
+
+def _candidate_bits(inst: dict, bits: list[int]) -> list[int]:
+    return _bits_to_center(inst["pairs"], bits)
+
+
+def _attack_frequency_majority(inst: dict) -> object:
+    rows = _public_rows(inst)
+    m = len(rows)
+    bits = [int(sum(row[i] for row in rows) * 2 > m) for i in range(inst["n"])]
+    return _candidate_bits(inst, bits)
+
+
+def _attack_greedy_farthest(inst: dict, start: list[int] | None = None,
+                            step_limit: int | None = None) -> object | None:
+    """Farthest-constraint one-flip descent with cycle detection."""
+    rows = _public_rows(inst)
+    n = inst["n"]
+    radius = inst["radius"]
+    bits = (start[:] if start is not None else rows[0][:])
+    seen = set()
+    for _ in range(step_limit or 4 * n):
+        distances = [sum(a != b for a, b in zip(bits, row)) for row in rows]
+        if max(distances) <= radius:
+            return _candidate_bits(inst, bits)
+        state = tuple(bits)
+        if state in seen:
+            return None
+        seen.add(state)
+        worst = max(range(len(rows)), key=lambda r: (distances[r], r))
+        options = [i for i in range(n) if bits[i] != rows[worst][i]]
+        if not options:
+            return None
+        best = None
+        best_key = None
+        for coordinate in options:
+            trial_distances = [d + (1 if bits[coordinate] == row[coordinate] else -1)
+                               for d, row in zip(distances, rows)]
+            key = (max(trial_distances), sum(x * x for x in trial_distances), coordinate)
+            if best_key is None or key < best_key:
+                best_key = key
+                best = coordinate
+        assert best is not None
+        bits[best] ^= 1
+    return None
+
+
+def _attack_random_restarts(inst: dict, rng: random.Random,
+                            restarts: int = 256) -> object | None:
+    rows = _public_rows(inst)
+    n = inst["n"]
+    radius = inst["radius"]
+    for _ in range(restarts):
+        # Begin from a uniformly sized random perturbation inside P0's ball.
+        t = rng.randrange(radius + 1)
+        bits = rows[0][:]
+        for i in rng.sample(range(n), t):
+            bits[i] ^= 1
+        seen = set()
+        for _step in range(2 * n):
+            distances = [sum(a != b for a, b in zip(bits, row)) for row in rows]
+            if max(distances) <= radius:
+                return _candidate_bits(inst, bits)
+            state = tuple(bits)
+            if state in seen:
+                break
+            seen.add(state)
+            maximum = max(distances)
+            bad = [r for r, d in enumerate(distances) if d == maximum]
+            worst = rng.choice(bad)
+            options = [i for i in range(n) if bits[i] != rows[worst][i]]
+            if not options:
+                break
+            rng.shuffle(options)
+            sample = options[:min(12, len(options))]
+            scored = []
+            for coordinate in sample:
+                ds = [d + (1 if bits[coordinate] == row[coordinate] else -1)
+                      for d, row in zip(distances, rows)]
+                scored.append(((max(ds), sum(x * x for x in ds)), coordinate))
+            best_score = min(score for score, _ in scored)
+            choices = [coordinate for score, coordinate in scored if score == best_score]
+            bits[rng.choice(choices)] ^= 1
+    return None
+
+
+def _attack_dpll(inst: dict, node_limit: int = 50_000) -> tuple[object | None, int]:
+    """Capped exact CSP search with cardinality pruning and unit propagation."""
+    rows = _public_rows(inst)
+    n = inst["n"]
+    m = len(rows)
+    radius = inst["radius"]
+    column_majority = [int(sum(row[i] for row in rows) * 2 > m) for i in range(n)]
+    nodes = 0
+
+    def search(values: list[int], mismatches: list[int]) -> list[int] | None:
+        nonlocal nodes
+        if nodes >= node_limit:
+            return None
+        nodes += 1
+        if any(x > radius for x in mismatches):
+            return None
+
+        values = values[:]
+        mismatches = mismatches[:]
+        while True:
+            forced: dict[int, int] = {}
+            for r, mismatch in enumerate(mismatches):
+                if mismatch == radius:
+                    for i, value in enumerate(values):
+                        if value == -1:
+                            want = rows[r][i]
+                            if i in forced and forced[i] != want:
+                                return None
+                            forced[i] = want
+            if not forced:
+                break
+            for i, value in forced.items():
+                if values[i] != -1:
+                    continue
+                values[i] = value
+                for r in range(m):
+                    mismatches[r] += value != rows[r][i]
+            if any(x > radius for x in mismatches):
+                return None
+
+        if all(value != -1 for value in values):
+            return values
+
+        # Branch where the tightest constraints disagree most strongly.
+        best_i = -1
+        best_score = -1.0
+        best_vote = 0.0
+        for i, value in enumerate(values):
+            if value != -1:
+                continue
+            vote = 0.0
+            for r in range(m):
+                weight = 1.0 / (radius - mismatches[r] + 1)
+                vote += weight if rows[r][i] else -weight
+            score = abs(vote)
+            if score > best_score:
+                best_i, best_score, best_vote = i, score, vote
+        first = int(best_vote > 0) if best_vote else column_majority[best_i]
+        for value in (first, 1 - first):
+            child = values[:]
+            child[best_i] = value
+            child_mismatch = [x + (value != rows[r][best_i])
+                              for r, x in enumerate(mismatches)]
+            found = search(child, child_mismatch)
+            if found is not None:
+                return found
+            if nodes >= node_limit:
+                break
+        return None
+
+    found = search([-1] * n, [0] * m)
+    return (_candidate_bits(inst, found) if found is not None else None), nodes
+
+
+def _transformed_instance(inst: dict, rng: random.Random) -> dict:
+    """Compose all declared presentation symmetries and carry the answer."""
+    n = inst["n"]
+    order = list(range(n))
+    rng.shuffle(order)
+    swap = [rng.randrange(2) for _ in range(n)]
+    labels = [x for pair in inst["pairs"] for x in pair]
+    shuffled = labels[:]
+    rng.shuffle(shuffled)
+    rename = dict(zip(labels, shuffled))
+
+    new_pairs = []
+    for old in order:
+        pair = inst["pairs"][old][::-1] if swap[old] else inst["pairs"][old]
+        new_pairs.append([rename[x] for x in pair])
+
+    old_rows = _public_rows(inst)
+    new_rows = [[old_row[old] ^ swap[old] for old in order] for old_row in old_rows]
+    rng.shuffle(new_rows)
+    planted = _decode_center(inst, inst["answer"])
+    assert planted is not None
+    new_planted = [planted[old] ^ swap[old] for old in order]
+    out = {
+        **inst,
+        "pairs": new_pairs,
+        "orientations": ["".join(map(str, row)) for row in new_rows],
+        "_decoded_rows": new_rows,
+        "answer": _bits_to_center(new_pairs, new_planted),
+    }
+    return out
+
+
+def _find_invalid_one_pair_flip(inst: dict) -> list[int]:
+    planted = _decode_center(inst, inst["answer"])
+    assert planted is not None
+    for i in range(inst["n"]):
+        trial = planted[:]
+        trial[i] ^= 1
+        candidate = _candidate_bits(inst, trial)
+        if not verify(inst, candidate)[0]:
+            return candidate
+    raise AssertionError("every one-pair flip unexpectedly remained feasible")
+
+
+def selftest() -> dict:
+    """Run mandatory gates G1--G8 and return JSON-serializable evidence."""
+    report: dict[str, object] = {
+        "paper": "2604.25734",
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    verified = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 2):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            if not ok:
+                raise AssertionError(f"G1 {preset}/{seed}: {why}")
+            verified += 1
+    report["G1_planted_verifies"] = {
+        "pass": True, "verified": verified, "attempted": verified
+    }
+
+    base = make_instance(seed=19, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    duplicate = base["answer"][:]
+    duplicate[1] = duplicate[0]
+    cross_swap = base["answer"][:]
+    cross_swap[1], cross_swap[2] = cross_swap[2], cross_swap[1]
+    out_of_range = base["answer"][:]
+    out_of_range[0] = 2 * base["n"] + 1
+    corruptions = {
+        "drop_one": base["answer"][:-1],
+        "swap_two": cross_swap,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    reasons = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(base, candidate)
+        if ok:
+            raise AssertionError(f"G2 accepted {name}")
+        reasons[name] = why
+    if len(set(reasons.values())) != len(reasons):
+        raise AssertionError(f"G2 reasons are not distinct: {reasons}")
+    report["G2_rejects_corruption"] = {
+        "pass": True, "rejected": len(reasons), "attempted": len(reasons),
+        "reasons": reasons,
+    }
+
+    realistic = (
+        "I normalized each pair and checked all radii.\n```json\n<answer>\n"
+        + json.dumps(base["answer"])
+        + "\n</answer>\n```\nThis is my final center."
+    )
+    parsed = parse_answer(realistic)
+    if parsed != base["answer"]:
+        raise AssertionError("G3 realistic response failed to round-trip")
+    report["G3_round_trip"] = {
+        "pass": True, "entries_recovered": len(parsed),
+        "prose": True, "markdown_fence": True,
+    }
+
+    guess_inst = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    guess_rng = random.Random(271828)
+    samples = 200_000
+    hits = 0
+    for _ in range(samples):
+        hits += bool(verify(guess_inst, random_candidate(guess_inst, guess_rng))[0])
+    probability = hits / samples
+    if probability >= 1e-6:
+        raise AssertionError(f"G4 guess rate {hits}/{samples} is too high")
+    report["G4_guess_resistance"] = {
+        "pass": True, "hits": hits, "samples": samples,
+        "measured_probability": probability,
+        "prior": "uniform over the full radius-d Hamming ball around public input P0",
+        "structured_prior_size": str(guess_inst["_ball_cumulative"][-1]),
+        "naive_pair_scheme_space": str(search_space(guess_inst)),
+    }
+
+    sparse_instances = []
+    for seed in (5, 6, 7):
+        small = make_instance(n=18, rows=10, gap=2, seed=seed)
+        count = enumerate_all(small)
+        space = search_space(small)
+        if count is None:
+            raise AssertionError("G5 declined its small exact instance")
+        fraction = count / space
+        if fraction >= 1e-3:
+            raise AssertionError(f"G5 solution fraction {fraction} is not tiny")
+        sparse_instances.append({
+            "seed": seed, "solutions": count, "space": space,
+            "fraction": fraction,
+        })
+    report["G5_sparse"] = {"pass": True, "instances": sparse_instances}
+
+    attack_names = (
+        "outlier_coordinate_majority",
+        "greedy_farthest_repair",
+        "random_restart_256",
+        "dpll_cardinality_50000_nodes",
+    )
+    successes = {name: 0 for name in attack_names}
+    dpll_nodes = []
+    attack_seeds = list(range(800, 808))
+    for seed in attack_seeds:
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        dpll_candidate, nodes = _attack_dpll(inst, 50_000)
+        dpll_nodes.append(nodes)
+        candidates = {
+            "outlier_coordinate_majority": _attack_frequency_majority(inst),
+            "greedy_farthest_repair": _attack_greedy_farthest(inst),
+            "random_restart_256": _attack_random_restarts(
+                inst, random.Random(90_000 + seed), 256
+            ),
+            "dpll_cardinality_50000_nodes": dpll_candidate,
+        }
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(inst, candidate)[0]:
+                successes[name] += 1
+    attacks = {
+        name: {"successes": successes[name], "attempts": len(attack_seeds)}
+        for name in attack_names
+    }
+    all_failed = all(value == 0 for value in successes.values())
+    if not all_failed:
+        raise AssertionError(f"G6 attack succeeded: {successes}")
+    report["G6_adversary_panel"] = {
+        "pass": True, "attacks": attacks,
+        "domain_attack": "dpll_cardinality_50000_nodes",
+        "dpll_nodes": dpll_nodes,
+    }
+
+    scale_base = make_instance(seed=77, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled = make_instance(
+        n=2 * scale_base["n"], rows=2 * scale_base["rows"],
+        gap=scale_base["gap"], seed=77,
+    )
+    ok, why = verify(doubled, doubled["answer"])
+    if not ok:
+        raise AssertionError(f"G7 doubled instance failed: {why}")
+    if search_space(doubled) <= search_space(scale_base):
+        raise AssertionError("G7 candidate space did not grow")
+    report["G7_scales"] = {
+        "pass": True, "base_n": scale_base["n"], "doubled_n": doubled["n"],
+        "base_rows": scale_base["rows"], "doubled_rows": doubled["rows"],
+        "base_space": str(search_space(scale_base)),
+        "doubled_space": str(search_space(doubled)),
+        "doubled_planted_verifies": True,
+    }
+
+    invariance = 0
+    carried = 0
+    keys = []
+    for seed in range(20):
+        small = make_instance(n=24, rows=12, gap=2, seed=10_000 + seed)
+        transformed = _transformed_instance(small, random.Random(20_000 + seed))
+        if canonical_key(small) != canonical_key(transformed):
+            raise AssertionError(f"G8 invariant changed at seed {seed}")
+        invariance += 1
+        ok, why = verify(transformed, transformed["answer"])
+        if not ok:
+            raise AssertionError(f"G8 carried witness failed at seed {seed}: {why}")
