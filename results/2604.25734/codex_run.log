+    def search(candidates: int, selected: list[int]):
+        nonlocal nodes
+        if nodes >= node_limit:
+            return None
+        nodes += 1
+        if len(selected) >= target:
+            return selected[:target]
+        if len(selected) + candidates.bit_count() < target:
+            return None
