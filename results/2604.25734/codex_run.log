+def enumerate_all(inst: dict) -> int | None:
+    n, size = inst["n"], inst["independent"]
+    if n > 24 or math.comb(n, size) > 2_000_000:
+        return None
+    adjacency = _adjacency(inst)
+    count = 0
+    for subset in itertools.combinations(range(n), size):
+        mask = sum(1 << v for v in subset)
+        if all(not (adjacency[v] & mask) for v in subset):
+            count += 1
+    return count
