+"""Verified radius-one Ulam k-center witnesses from arXiv:2604.25734.
+
+Section 3.1 maps Vertex Cover on a triangle-free graph to Ulam k-Center at
+radius one. We plant a cover, construct a regular graph around its independent
+complement, and 2-subdivide it into the theorem's triangle-free regime.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import random
+import re
