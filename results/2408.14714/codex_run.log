+    # If x0=t+s*z0, conjugating z -> z0^2/z gives
+    # x -> t + (x0-t)^2/(x-t), represented in the c=1 chart below.
+    delta = (block[0] - translation) % p
+    alpha = (delta * delta) % p
+    answer = [
+        [translation, (alpha - translation * translation) % p],
+        [1, (-translation) % p],
+    ]
