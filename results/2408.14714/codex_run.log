+    return {
+        "paper": "2408.14714",
+        "p": p,
+        "k": k,
+        "block": block,
+        "answer": answer,
+    }
+
+
+def render(inst) -> str:
+    """Return the complete, self-contained solver prompt."""
+    p = inst["p"]
+    k = inst["k"]
