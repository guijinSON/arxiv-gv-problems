+    ),
+    "hardness_basis": (
+        "Track B: a projective map is determined by three points, so the standard "
+        "exact stabilizer algorithm tests O(k^3) image triples and O(k^4) field "
+        "operations in the worst case; shipping-preset measured cost is filled "
+        "by selftest(), while the barycenter/conjugated-inversion route uses at "
+        "most k+5 exact field operations and must be recognized and executed "
+        "without a finite-field tool."
+    ),
+    "max_answer_tokens": 16,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
