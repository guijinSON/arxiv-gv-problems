+def _transform_instance(inst, change: Matrix, answer: Matrix) -> tuple[dict, Matrix] | None:
+    p = inst["p"]
+    if _det(change, p) == 0:
+        return None
+    carried = _conjugate(answer, change, p)
+    if carried is None:
+        return None
