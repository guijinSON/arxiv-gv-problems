+    "easy": {"n": 23, "modulus_min": 100_003, "prime_spread": 20_000},
+    "medium": {"n": 61, "modulus_min": 10_000_019, "prime_spread": 100_000},
+    "hard": {"n": 127, "modulus_min": 1_000_000_007, "prime_spread": 1_000_000},
