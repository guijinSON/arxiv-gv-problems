+    total_reference_wall = sum(x["wall_clock_sec"] for x in reference_runs)
+    total_reference_ops = sum(x["field_operations"] for x in reference_runs)
+    total_reference_candidates = sum(x["candidates"] for x in reference_runs)
+    reference_record = {
