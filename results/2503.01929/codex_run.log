+        "shipping_n": hard["n"],
+        "doubled_n": doubled["n"],
+        "shipping_items": len(hard["lengths"]),
+        "doubled_items": len(doubled["lengths"]),
+        "shipping_search_bits": hard_space.bit_length(),
+        "doubled_search_bits": doubled_space.bit_length(),
+        "doubled_verify": [doubled_ok, doubled_reason],
