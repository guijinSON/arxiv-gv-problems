import random,itertools,statistics

def gen(k,seed,c=.4):
 r=random.Random(seed); q=max(12,round(c*k*k)); T=4*q;m=3*k
 layout=list(range(m));r.shuffle(layout); vals=[0]*m
 for b in range(k):
  while 1:
   a=r.randrange(q+1,2*q);bb=r.randrange(q+1,2*q);cc=T-a-bb
   if q<cc<2*q:break
  for i,v in zip(layout[3*b:3*b+3],(a,bb,cc)):vals[i]=v
 return vals,T

def edges(vals,T):
 n=len(vals); es=[]; by=[[] for _ in vals]
 for a in range(n-2):
  for b in range(a+1,n-1):
   need=T-vals[a]-vals[b]
   for c in range(b+1,n):
    if vals[c]==need:
     e=(a,b,c);j=len(es);es.append(e)
     for x in e:by[x].append(j)
 return es,by

def greedy(vals,T):
 rem=set(range(len(vals))); groups=[]
 while rem:
  i=max(rem,key=lambda x:(vals[x],-x)); found=None
  rr=sorted(rem-{i},key=lambda x:(vals[x],x))
  for ai,j in enumerate(rr):
   for l in rr[ai+1:]:
    if vals[i]+vals[j]+vals[l]==T:found=(i,j,l);break
   if found:break
  if not found:return False
  groups.append(found);rem.difference_update(found)
 return True

def det(vals,T,es,by):
 rem=set(range(len(vals)))
 while rem:
  opts=[]
  for v in rem:
   eopts=[ei for ei in by[v] if all(x in rem for x in es[ei])]
   if not eopts:return False
   opts.append((len(eopts),v,eopts))
  _,v,eopts=min(opts)
  # edge whose other vertices have smallest total current degrees
  def score(ei):
   return sum(sum(1 for jj in by[x] if all(y in rem for y in es[jj])) for x in es[ei])
  ei=min(eopts,key=lambda z:(score(z),es[z]))
  rem.difference_update(es[ei])
 return True

def rr(vals,T,es,by,seed,R=256):
 r=random.Random(seed"'^0x1234)
 for _ in range(R):
  rem=set(range(len(vals)))
  while rem:
   info=[]; md=999
   for v in rem:
    opts=[ei for ei in by[v] if all(x in rem for x in es[ei])]
    if len(opts)<md:md=len(opts);info=[(v,opts)]
    elif len(opts)==md:info.append((v,opts))
   if md==0:break
   v,opts=r.choice(info);ei=r.choice(opts);rem.difference_update(es[ei])
  if not rem:return True
 return False
for c in [.25,.35,.5,.7,1.0]:
 for k in [12,18,24]:
  rows=[]
  for seed in range(8):
