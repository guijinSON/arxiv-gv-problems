+    g2_reasons = {name: result[1] for name, result in g2_results.items()}
+    g2_pass = all(not result[0] for result in g2_results.values()) and len(
+        set(g2_reasons.values())
+    ) == len(corruptions)
+    report["G2_rejects_corruption"] = {
+        "pass": g2_pass,
+        "reasons": g2_reasons,
