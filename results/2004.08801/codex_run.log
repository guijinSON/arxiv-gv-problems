+        bit = remaining & -remaining
+        state = bit.bit_length() - 1
+        remaining ^= bit
+        if counter is not None:
+            counter["transition_lookups"] += 1
+        target = inst["transitions"][state][letter_index]
+        if target < 0:
+            return None
+        image |= 1 << target
+    return image
