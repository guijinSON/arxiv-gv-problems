+    radix = current.get("radix", 3)
+    if not isinstance(n, int) or not isinstance(radix, int):
+        return None
+    # Intended-route operations are 2*d*n + 2*n^2 + 2*n.  Stay under G9(c).
+    if 2 * (radix + 1) * n + 2 * n * n + 2 * n <= 300:
+        current["radix"] = radix + 1
