+}
+
+
+# n is the number of counter blocks.  The automaton has 2*radix*n states.
+DIFFICULTY = {
+    "demo": {"n": 3, "radix": 3},
+    "easy": {"n": 7, "radix": 3},
+    "medium": {"n": 8, "radix": 3},
+    "hard": {"n": 9, "radix": 4},
