+
+def _permute_state_map(mapping, old_to_new):
+    result = [-1] * len(mapping)
+    for old_source, old_target in enumerate(mapping):
+        if old_target >= 0:
+            result[old_to_new[old_source]] = old_to_new[old_target]
+    return result
