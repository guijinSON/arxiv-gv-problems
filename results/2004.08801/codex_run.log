+def _intended_route_operations(inst):
+    # Read the start image, inspect every digit candidate on its n image states,
+    # and make one second-step test per candidate.
+    return (
+        len(inst["states"])
+        + 2 * inst["n"] * inst["n"]
+        + 2 * inst["n"]
+    )
