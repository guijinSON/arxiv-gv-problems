+    for old_state in range(n_states):
+        for old_letter in range(n_letters):
+            old_target = inst["transitions"][old_state][old_letter]
+            if old_target >= 0:
+                table[state_new[old_state]][letter_new[old_letter]] = state_new[old_target]
