+
+
+STRUCTURAL_HINT = (
+    "The total letter's image is a transversal on which digit letters have "
+    "both a fixed-point count and a two-step path signature."
+)
+PLACEBO_HINT = (
+    "The transition vectors use the displayed state order and a dash always "
