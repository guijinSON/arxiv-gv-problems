+            "complexity": "O(|Sigma|*|Q|*2^|Q|) worst-case exact",
+            "wall_clock_sec_mean": mean_wall,
+            "wall_clock_sec_max": max(run["wall_clock_sec"] for run in reference_runs),
+            "nodes_mean": mean_nodes,
