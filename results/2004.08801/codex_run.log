+        ),
+        "reference_nodes_mean": mean_nodes,
+        "reference_transition_lookups_mean": mean_lookups,
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(result["successes"] == 0 for result in attacks.values()),
+        "attacks": attacks,
+        "reference_algorithm": {
