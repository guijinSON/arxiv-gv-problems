+    initial = (1 << state_count) - 1
+    queue = collections.deque([(initial, 0)])
+    seen = {initial}
+    stats = {
+        "nodes": 0,
+        "transition_attempts": 0,
+        "transition_lookups": 0,
+        "max_frontier": 1,
+        "word_length": None,
+    }
