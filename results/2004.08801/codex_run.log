+        if len(selected) == inst["n"]:
+            break
+        selected.append(letter)
+    return {
+        "start": inst["alphabet"][starts[0]],
+        "digits": [inst["alphabet"][i] for i in selected],
+        "finish": inst["alphabet"][finishes[0]],
+    }
