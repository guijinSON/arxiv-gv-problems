+                restart_solved = True
+                break
+        attack_success["random_restart_256"] += int(restart_solved)
+        attack_success["one_tick_transversal_greedy"] += int(
+            verify(candidate_inst, _one_tick_greedy_attack(candidate_inst))[0]
