+    width_l = max(2, len(str(n_letters - 1)))
+    alphabet = ["r" + str(i).zfill(width_l) for i in range(n_letters)]
+    old_label_to_new = {}
+    for old_letter, old_label in enumerate(inst["alphabet"]):
