  1179	  \hline
  1180	{\color{green!60!black}\boldsymbol\alpha{ }\boldsymbol{A}} & {\color{blue}\boldsymbol\beta{ }\boldsymbol{C}} & {\gamma{ }D} & {\delta{ }B} \\
