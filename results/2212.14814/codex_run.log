+            "complexity": "O(n^3 + r^3 n) on memoized pair signatures; O(n^6) worst case",
+            "wall_clock_sec_mean": mean_wall,
+            "wall_clock_sec_max": max_wall,
+            "operations_mean": mean_ops,
