+        },
+    }
+
+    doubled_params = dict(params)
+    doubled_params["n"] = 2 * params["n"]
+    doubled = make_instance(seed=4321, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
