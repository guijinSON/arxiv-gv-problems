+        "by guessing six vertices in O(n^6) time; at the initial shipping preset "
+        "n=52, the memoized form of that search is measured by selftest over eight "
+        "seeds, while the compact route uses three neighborhood contrasts and at "
+        "most 168 exact adjacency/set operations."
+    ),
+    "max_answer_tokens": 8,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
