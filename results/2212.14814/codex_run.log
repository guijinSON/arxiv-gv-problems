+def _pick_disjoint_representatives(groups: list[list[tuple[int, int]]]) -> list[tuple[int, int]] | None:
+    for p0 in groups[0]:
+        used0 = set(p0)
+        for p1 in groups[1]:
+            if used0.intersection(p1):
+                continue
+            used1 = used0 | set(p1)
+            for p2 in groups[2]:
+                if not used1.intersection(p2):
+                    return [p0, p1, p2]
+    return None
