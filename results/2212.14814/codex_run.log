+    "easy": {"n": 52, "t": 2, "scramble": True},
+    "medium": {"n": 68, "t": 2, "scramble": True},
+    "hard": {"n": 84, "t": 2, "scramble": True},
+}
+SHIPPING_DIFFICULTY = "easy"
