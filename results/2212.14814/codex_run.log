+G9_MEASUREMENTS = {
+    "bare": {"solved": 0, "attempts": 0, "error_calls": 0},
+    "hinted": {"solved": 0, "attempts": 0, "error_calls": 0},
+    "placebo": {"solved": 0, "attempts": 0, "error_calls": 0},
