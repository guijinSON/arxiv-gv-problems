+        "each pair is written in increasing vertex order and all six 0-based vertex "
+        "indices are distinct."
+    ),
+    "bounds": {
+        "pairs": 3,
+        "vertices": 6,
+        "index_min": 0,
+        "index_max": "n-1",
+        "pair_order": "increasing",
