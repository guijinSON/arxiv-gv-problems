+def _pairs_for_cut(rows: list[int], target: int) -> list[tuple[int, int]]:
+    return [(u, v) for u in range(len(rows)) for v in range(u + 1, len(rows))
+            if _contrast(rows, u, v) == target]
+
+
+def _canonical_pair_for_cut(rows: list[int], target: int) -> list[int]:
+    pairs = _pairs_for_cut(rows, target)
+    if not pairs:
+        raise ValueError("contrast cut has no realizing pair")
+    return list(pairs[0])
+
+
 def _module_distance(rows: list[int], subset: int, limit: int | None = None) -> int:
     n = len(rows)
     outside = ((1 << n) - 1) ^ subset

