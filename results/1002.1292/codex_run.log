        and doubled["m"] >= 2 * inst["m"]
        and len(render(doubled)) > len(render(inst))
        and ladder_m == sorted(ladder_m)
        and len(set(ladder_m)) == len(ladder_m),
        "shipping_m": inst["m"],
        "doubled_requested_n": doubled_params["n"],
        "doubled_actual_m": doubled["m"],
