+        # an affine relabelling that preserves that explicitly stated rule.
+        while old["a"] * pow(ur, -1, p) % p == old["c"] * pow(uc, -1, p) % p:
+            uc = (uc + 1) % p or 1
+        for row in transformed["rows"]:
+            if row["block"] == block_id:
