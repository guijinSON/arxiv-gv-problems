  Bc=allr;w=Ac
  while w:q=w&-w;i=q.bit_length()-1;Bc&=C[i];w-=q;ops+=1
  d[Ac,Bc]=None
 co=list(d);idx={};bit=0;full=0
 for i,row in enumerate(C):
  for j in range(m):
   if row>>j&1:idx[i,j]=bit;full|=1<<bit;bit+=1
 em=[]
