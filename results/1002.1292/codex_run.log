   486	def _verify_fooling_set(inst: dict, certificates: list[dict]) -> tuple[bool, str]:
   487	    """Execute the parsimonious lower bound as a finite exact check.
   488	
   489	    Each (block,gene) supplies one displayed 1-entry.  If every two selected
   490	    entries have a zero in at least one cross-position, no biclique can cover
   491	    both, so any factorization needs at least as many columns as this set.
   492	    """
   493	    p = inst["p"]
   494	    row_index = {
   495	        (row["block"], row["x"]): index
   496	        for index, row in enumerate(inst["rows"])
   497	    }
   498	    column_index = {
   499	        (column["block"], column["y"]): index
   500	        for index, column in enumerate(inst["columns"])
   501	    }
   502	    selected = []
   503	    for block_id, certificate in enumerate(certificates):
   504	        inv_a = pow(certificate["a"], -1, p)
   505	        inv_c = pow(certificate["c"], -1, p)
   506	        for gene in range(p):
   507	            ri = row_index[(block_id, inv_a * gene % p)]
   508	            ci = column_index[
   509	                (block_id, inv_c * (gene - certificate["delta"]) % p)
   510	            ]
   511	            if inst["rows"][ri]["bits"][ci] != "1":
   512	                return False, "fooling-set diagonal entry is not 1"
   513	            selected.append((ri, ci))
   514	    for first, (row_a, column_a) in enumerate(selected):
   515	        for row_b, column_b in selected[first + 1:]:
   516	            cross_ab = inst["rows"][row_a]["bits"][column_b] == "1"
   517	            cross_ba = inst["rows"][row_b]["bits"][column_a] == "1"
   518	            if cross_ab and cross_ba:
   519	                return False, "two fooling-set entries lie in one biclique"
   520	    return True, "ok"
