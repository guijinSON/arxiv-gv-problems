+            "wall_clock_sec": round(reference_seconds, 6),
+            "operations": reference_operations,
+            "operation_unit": "predicted-versus-displayed Boolean membership test",
+            "solves": f"{reference_successes}/{attack_attempts}, as expected",
+        },
+    }
