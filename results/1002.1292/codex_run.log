   661	def escalate(params) -> dict | str | None:
   662	    """Raise affine entropy/ambient size without lengthening each block witness."""
   663	    current = dict(params)
   664	    p = current["n"]
   665	    blocks = current["blocks"]
   666	    if blocks < 3:
   667	        current["blocks"] = blocks + 1
   668	        return current
   669	    next_p = _next_supported_prime(p + max(12, p // 2))
   670	    if next_p * blocks > 900:
   671	        return "cap_bound"
   672	    current["n"] = next_p
   673	    return current
   674	
   675	
   676	def _recover_by_moments(inst) -> dict:
   677	    """The compact Track-B route, using only the displayed audit residues."""
   678	    p = inst["p"]
   679	    width = (p + 1) // 2
   680	    inv_width = pow(width, -1, p)
   681	    cube_root_exponent = pow(3, -1, p - 1)
   682	    answer = []
   683	    for block in sorted(inst["blocks"], key=lambda item: item["id"]):
   684	        ratio = block["row0_third"] * pow(block["third_D"], -1, p) % p
   685	        q = pow(ratio, cube_root_exponent, p)
   686	        c = pow(q, -1, p)
   687	        a = (block["row1_sum"] - block["row0_sum"]) * c * inv_width % p
   688	        delta = (block["sum_D"] - c * block["row0_sum"]) * inv_width % p
   689	        answer.append({"a": a, "c": c, "delta": delta})
   690	    return {"blocks": answer}
   691	
