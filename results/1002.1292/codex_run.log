   431	def parse_answer(text):
   432	    """Extract the tagged JSON certificate from arbitrary surrounding prose."""
   433	    if not isinstance(text, str):
   434	        return None
   435	    matches = _ANSWER_RE.findall(text)
   436	    if not matches:
   437	        return None
   438	    body = matches[-1].strip()
   439	    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
   440	    if fence:
   441	        body = fence.group(1).strip()
   442	    try:
   443	        answer = json.loads(body)
   444	    except (TypeError, ValueError):
   445	        return None
   446	    return answer if isinstance(answer, dict) else None
