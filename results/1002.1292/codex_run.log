+        "shipping_modulus": shipping["p"],
+        "doubled_modulus": doubled_p,
+        "shipping_matrix_side": len(shipping["rows"]),
+        "doubled_matrix_side": len(doubled["rows"]),
+        "verify_reason": doubled_reason,
