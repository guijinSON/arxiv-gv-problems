+def escalate(params) -> dict | str | None:
+    """Raise affine entropy/ambient size without lengthening each block witness."""
+    current = dict(params)
+    p = current["n"]
+    blocks = current["blocks"]
+    if blocks < 3:
+        current["blocks"] = blocks + 1
