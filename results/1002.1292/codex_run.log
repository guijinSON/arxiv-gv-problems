   763	def _refresh_summaries(inst: dict) -> None:
   764	    p = inst["p"]
   765	    width = (p + 1) // 2
   766	    inv_width = pow(width, -1, p)
   767	    by_id = {block["id"]: block for block in inst["blocks"]}
   768	    for block_id in range(inst["blocks_count"]):
   769	        matrix = _local_matrix(inst, block_id)
   770	        sums = [sum(y for y, bit in enumerate(matrix[x]) if bit) % p for x in (0, 1)]
   771	        mean = sums[0] * inv_width % p
   772	        third = sum(
