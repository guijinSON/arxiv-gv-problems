   343	def render(inst: dict) -> str:
   344	    """Render a self-contained exact Boolean-factorization problem."""
   345	    p = inst["p"]
   346	    block_lines = []
   347	    for data in sorted(inst["blocks"], key=lambda item: item["id"]):
   348	        block_lines.append(
   349	            "Block {id}: D={D}; sum_D={sum_D}; third_D={third_D}; "
   350	            "row0_sum={row0_sum}; row1_sum={row1_sum}; "
   351	            "row0_third={row0_third}".format(**data)
   352	        )
   353	    column_lines = []
   354	    chunk = []
   355	    for index, column in enumerate(inst["columns"]):
   356	        chunk.append(f"{index}=(b{column['block']},y{column['y']})")
   357	        if len(chunk) == 8:
   358	            column_lines.append("  " + "  ".join(chunk))
   359	            chunk = []
   360	    if chunk:
   361	        column_lines.append("  " + "  ".join(chunk))
   362	    row_lines = [
   363	        f"  {index}: (b{row['block']},x{row['x']}) {row['bits']}"
   364	        for index, row in enumerate(inst["rows"])
   365	    ]
   366	
   367	    example_blocks = [
   368	        {"a": 1, "c": 2, "delta": 0}
   369	        for _ in range(inst["blocks_count"])
   370	    ]
   371	    example = json.dumps({"blocks": example_blocks}, separators=(",", ":"))
   372	    hint = ""
   373	    mode = os.environ.get("GV_HINT_MODE")
   374	    if mode == "structural":
   375	        hint = "\n\nHint: " + STRUCTURAL_HINT
   376	    elif mode == "placebo":
   377	        hint = "\n\nHint: " + PLACEBO_HINT
   378	
   379	    return f"""MOD/RESC PARSIMONY INFERENCE — AFFINE CERTIFICATE
   380	
   381	All arithmetic on labels in this problem is modulo the prime p={p}. There are
   382	{inst['blocks_count']} blocks and k={inst['factor_width']} genes, labelled
   383	(block,g) with g in 0,...,{p - 1}. Rows represent Mod strains and columns
   384	represent rescue strains. The displayed Boolean compatibility matrix C has
   385	{len(inst['rows'])} rows and {len(inst['columns'])} columns. Matrix rows and
   386	columns are deliberately shown in unrelated orders; their block and local
   387	labels are given below. Bit 1 means incompatible and bit 0 means compatible.
   388	
   389	For Boolean length-k rows U,V define U tensor V to be 1 exactly when at least
   390	one coordinate has U[g]=1 and V[g]=0; otherwise it is 0. Applied row-by-row,
   391	this is the paper's Mod/Resc matrix product C=M tensor R.
   392	
   393	Your certificate contains one affine triple (a,c,delta) for each block, in
   394	block index order. Both a and c must lie in 1,...,{p - 1}, they must be
   395	different, and delta lies in 0,...,{p - 1}. The triple defines full Boolean
   396	factor matrices of common width k as follows.
   397	
   398	* Mod row (block b,label x) has its only 1 at gene (b,a*x).
   399	* Rescue row (block b,label y) has 0 at gene (b,g) exactly when
   400	  c*y+delta-g modulo p belongs to that block's displayed set D. It has 1 at
   401	  all other genes, including genes of other blocks.
   402	
   403	The certificate is valid when these exact matrices satisfy every displayed
   404	bit of C=M tensor R. It is then automatically parsimonious: each D contains 0
   405	and exactly one of z and -z for every nonzero z. Pairing each gene g with Mod
   406	row a^(-1)g and rescue column c^(-1)(g-delta) gives k 1-entries such that no
   407	one factor coordinate can cover two of them. Thus k factors are necessary as
   408	well as sufficient; this is an exactly checkable fooling-set lower bound.
   409	
   410	For audit, each block also gives exact residues useful for checking structure.
   411	sum_D is the sum of D. third_D is sum((d-mean_D)^3 for d in D), where
   412	mean_D=sum_D/|D| in F_p. row0_sum and row1_sum are the sums of local column
   413	labels y at 1-bits in local rows x=0 and x=1. row0_third is the analogous
   414	centered third moment for row x=0. All six quantities are residues modulo p.
   415	
   416	BLOCK DATA
   417	{chr(10).join(block_lines)}
   418	
   419	DISPLAYED COLUMN ORDER
   420	{chr(10).join(column_lines)}
   421	
   422	DISPLAYED MATRIX ROWS: displayed-index: (block,local-x) bitstring
   423	{chr(10).join(row_lines)}{hint}
   424	
   425	Give your final answer inside <answer></answer> tags as one compact JSON object
   426	with exactly the key \"blocks\" and entries {{\"a\":int,\"c\":int,\"delta\":int}}.
   427	Example format: <answer>{example}</answer>
   428	Output nothing else inside the tags."""
   429	
   430	
   431	def parse_answer(text):
   432	    """Extract the tagged JSON certificate from arbitrary surrounding prose."""
   433	    if not isinstance(text, str):
   434	        return None
   435	    matches = _ANSWER_RE.findall(text)
   436	    if not matches:
   437	        return None
   438	    body = matches[-1].strip()
   439	    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
   440	    if fence:
   441	        body = fence.group(1).strip()
   442	    try:
   443	        answer = json.loads(body)
   444	    except (TypeError, ValueError):
   445	        return None
   446	    return answer if isinstance(answer, dict) else None
   447	
   448	
   449	def _validate_instance_math(inst: dict) -> tuple[bool, str]:
   450	    p = inst.get("p")
   451	    count = inst.get("blocks_count")
   452	    if not _is_int(p) or not _is_prime(p) or p % 3 != 2:
   453	        return False, "instance modulus is not a supported prime"
   454	    if not _is_int(count) or count != len(inst.get("blocks", [])):
   455	        return False, "instance block metadata is inconsistent"
   456	    if len(inst.get("rows", [])) != count * p or len(inst.get("columns", [])) != count * p:
   457	        return False, "instance matrix dimensions are inconsistent"
   458	    if inst.get("factor_width") != count * p:
   459	        return False, "instance factor width is inconsistent"
   460	    width = (p + 1) // 2
   461	    for expected_id, block in enumerate(sorted(inst["blocks"], key=lambda item: item.get("id", -1))):
   462	        if block.get("id") != expected_id:
   463	            return False, "instance block identifiers are inconsistent"
   464	        values = block.get("D")
   465	        if not isinstance(values, list) or len(values) != width or len(set(values)) != width:
   466	            return False, f"block {expected_id} difference-set size is invalid"
   467	        if any(not _is_int(x) or not 0 <= x < p for x in values) or 0 not in values:
   468	            return False, f"block {expected_id} difference-set entries are invalid"
   469	        dset = set(values)
   470	        for x in range(1, p):
   471	            if ((x in dset) + ((-x) % p in dset)) != 1:
   472	                return False, f"block {expected_id} is not skew"
   473	    expected_labels = {(block, value) for block in range(count) for value in range(p)}
   474	    row_labels = {(row.get("block"), row.get("x")) for row in inst.get("rows", [])}
   475	    column_labels = {
   476	        (column.get("block"), column.get("y"))
   477	        for column in inst.get("columns", [])
   478	    }
   479	    if row_labels != expected_labels or len(row_labels) != len(inst["rows"]):
   480	        return False, "instance row labels are inconsistent"
   481	    if column_labels != expected_labels or len(column_labels) != len(inst["columns"]):
   482	        return False, "instance column labels are inconsistent"
   483	    return True, "ok"
   484	
   485	
   486	def _verify_fooling_set(inst: dict, certificates: list[dict]) -> tuple[bool, str]:
   487	    """Execute the parsimonious lower bound as a finite exact check.
   488	
   489	    Each (block,gene) supplies one displayed 1-entry.  If every two selected
   490	    entries have a zero in at least one cross-position, no biclique can cover
   491	    both, so any factorization needs at least as many columns as this set.
   492	    """
   493	    p = inst["p"]
   494	    row_index = {
   495	        (row["block"], row["x"]): index
   496	        for index, row in enumerate(inst["rows"])
   497	    }
   498	    column_index = {
   499	        (column["block"], column["y"]): index
   500	        for index, column in enumerate(inst["columns"])
   501	    }
   502	    selected = []
   503	    for block_id, certificate in enumerate(certificates):
   504	        inv_a = pow(certificate["a"], -1, p)
   505	        inv_c = pow(certificate["c"], -1, p)
   506	        for gene in range(p):
   507	            ri = row_index[(block_id, inv_a * gene % p)]
   508	            ci = column_index[
   509	                (block_id, inv_c * (gene - certificate["delta"]) % p)
   510	            ]
   511	            if inst["rows"][ri]["bits"][ci] != "1":
   512	                return False, "fooling-set diagonal entry is not 1"
   513	            selected.append((ri, ci))
   514	    for first, (row_a, column_a) in enumerate(selected):
   515	        for row_b, column_b in selected[first + 1:]:
   516	            cross_ab = inst["rows"][row_a]["bits"][column_b] == "1"
   517	            cross_ba = inst["rows"][row_b]["bits"][column_a] == "1"
   518	            if cross_ab and cross_ba:
   519	                return False, "two fooling-set entries lie in one biclique"
   520	    return True, "ok"
   521	
   522	
   523	def verify(inst, answer) -> tuple[bool, str]:
   524	    """Verify any certificate in the declared affine matrix language."""
   525	    instance_ok, reason = _validate_instance_math(inst)
   526	    if not instance_ok:
   527	        return False, reason
   528	    if not isinstance(answer, dict) or set(answer) != {"blocks"}:
   529	        return False, "answer must be an object with exactly the key blocks"
   530	    certificates = answer["blocks"]
   531	    if not isinstance(certificates, list):
   532	        return False, "blocks must be a list"
   533	    if len(certificates) != inst["blocks_count"]:
   534	        return False, "block count mismatch"
   535	    p = inst["p"]
   536	    dsets = {block["id"]: set(block["D"]) for block in inst["blocks"]}
   537	    for block_id, certificate in enumerate(certificates):
   538	        if not isinstance(certificate, dict) or set(certificate) != {"a", "c", "delta"}:
   539	            return False, f"block {block_id} must have exactly a, c, and delta"
   540	        a, c, delta = certificate["a"], certificate["c"], certificate["delta"]
   541	        if any(not _is_int(value) for value in (a, c, delta)):
   542	            return False, f"block {block_id} entries must be integers"
   543	        if not (1 <= a < p and 1 <= c < p and 0 <= delta < p):
   544	            return False, f"block {block_id} field element out of range"
   545	        if a == c:
   546	            return False, f"block {block_id} row and column multipliers must differ"
   547	
   548	    for row_index, row in enumerate(inst["rows"]):
   549	        if (
   550	            not isinstance(row.get("bits"), str)
   551	            or len(row["bits"]) != inst["blocks_count"] * p
   552	            or set(row["bits"]) - {"0", "1"}
   553	        ):
   554	            return False, f"instance contains a malformed matrix row {row_index}"
   555	        rb, x = row["block"], row["x"]
   556	        certificate = certificates[rb]
   557	        a, c, delta = certificate["a"], certificate["c"], certificate["delta"]
   558	        for column_index, column in enumerate(inst["columns"]):
   559	            if rb != column["block"]:
   560	                predicted = 0
   561	            else:
   562	                predicted = int(
   563	                    (c * column["y"] + delta - a * x) % p in dsets[rb]
   564	                )
   565	            if predicted != (row["bits"][column_index] == "1"):
   566	                return False, (
   567	                    f"product mismatch at displayed row {row_index}, "
   568	                    f"column {column_index}"
   569	                )
   570	    lower_bound_ok, lower_bound_reason = _verify_fooling_set(inst, certificates)
   571	    if not lower_bound_ok:
   572	        return False, lower_bound_reason
   573	    return True, "ok"
   574	
   575	
   576	def random_candidate(inst, rng) -> object:
   577	    """Sample uniformly from the normalized affine certificate language."""
   578	    p = inst["p"]
   579	    blocks = []
   580	    for _ in range(inst["blocks_count"]):
   581	        a = rng.randrange(1, p)
   582	        c_index = rng.randrange(p - 2)
   583	        choices = [value for value in range(1, p) if value != a]
   584	        c = choices[c_index]
   585	        blocks.append({"a": a, "c": c, "delta": rng.randrange(p)})
   586	    return {"blocks": blocks}
   587	
   588	
   589	def search_space(inst) -> int:
   590	    """Return the exact cardinality of the declared certificate language."""
   591	    p = inst["p"]
   592	    return (p * (p - 1) * (p - 2)) ** inst["blocks_count"]
   593	
   594	
   595	def _local_matrix(inst, block_id: int) -> list[list[int]]:
   596	    p = inst["p"]
   597	    columns = {
   598	        (column["block"], column["y"]): index
   599	        for index, column in enumerate(inst["columns"])
   600	    }
   601	    rows = {row["x"]: row for row in inst["rows"] if row["block"] == block_id}
   602	    return [
   603	        [int(rows[x]["bits"][columns[(block_id, y)]]) for y in range(p)]
   604	        for x in range(p)
   605	    ]
   606	
   607	
   608	def _enumerate_block(inst, block_id: int, stop_after_first: bool) -> tuple[list[dict], int]:
   609	    p = inst["p"]
   610	    matrix = _local_matrix(inst, block_id)
   611	    dset = set(next(block["D"] for block in inst["blocks"] if block["id"] == block_id))
   612	    # The mixed probe order makes early rejection representative of the full
   613	    # matrix rather than accidentally privileging the first displayed row.
   614	    probes = [(x, y, matrix[x][y]) for x in range(p) for y in range(p)]
   615	    probe_rng = random.Random(0x10021292 + block_id)
   616	    probe_rng.shuffle(probes)
   617	    found = []
   618	    operations = 0
   619	    for a in range(1, p):
   620	        for c in range(1, p):
   620	        for c in range(1, p):
   621	            if a == c:
   622	                continue
   623	            for delta in range(p):
   624	                for x, y, expected in probes:
   625	                    operations += 1
   626	                    got = (c * y + delta - a * x) % p in dset
   627	                    if got != bool(expected):
   628	                        break
   629	                else:
   630	                    found.append({"a": a, "c": c, "delta": delta})
   631	                    if stop_after_first:
   632	                        return found, operations
   633	    return found, operations
   634	
   635	
   636	def enumerate_all(inst) -> int | None:
   637	    """Count all valid certificates exactly when the affine scan is capped."""
   638	    p = inst["p"]
   639	    work_bound = inst["blocks_count"] * p * (p - 1) * (p - 2)
   640	    if work_bound > 2_100_000:
   641	        return None
   642	    count = 1
   643	    for block_id in range(inst["blocks_count"]):
   644	        solutions, _operations = _enumerate_block(inst, block_id, False)
   645	        count *= len(solutions)
   646	    return count
   647	
   648	
   649	def canonical_key(inst) -> str:
   650	    """Key on affine-normalized block shapes, ignoring all presentation labels."""
   651	    p = inst["p"]
   652	    shapes = sorted(_canonical_difference_set(block["D"], p) for block in inst["blocks"])
   653	    payload = json.dumps(
   654	        {"p": p, "blocks": inst["blocks_count"], "shapes": shapes},
   655	        sort_keys=True,
   656	        separators=(",", ":"),
   657	    )
   658	    return hashlib.sha256(payload.encode("ascii")).hexdigest()
   659	
