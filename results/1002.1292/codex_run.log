   803	    new_answers = [None] * count
   804	    for old_block, old_answer in zip(transformed["blocks"], inst["answer"]["blocks"]):
   805	        new_id = mapping[old_block["id"]]
   806	        block = copy.deepcopy(old_block)
   807	        block["id"] = new_id
   808	        new_blocks.append(block)
   809	        new_answers[new_id] = copy.deepcopy(old_answer)
   810	    transformed["blocks"] = sorted(new_blocks, key=lambda item: item["id"])
   811	    transformed["answer"] = {"blocks": new_answers}
   812	    return transformed, copy.deepcopy(transformed["answer"])
