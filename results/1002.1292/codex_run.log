   588	
   589	def search_space(inst) -> int:
   590	    """Return the exact cardinality of the declared certificate language."""
   591	    p = inst["p"]
   592	    return (p * (p - 1) * (p - 2)) ** inst["blocks_count"]
   593	
   594	
   595	def _local_matrix(inst, block_id: int) -> list[list[int]]:
   596	    p = inst["p"]
   597	    columns = {
   598	        (column["block"], column["y"]): index
   599	        for index, column in enumerate(inst["columns"])
   600	    }
   601	    rows = {row["x"]: row for row in inst["rows"] if row["block"] == block_id}
   602	    return [
   603	        [int(rows[x]["bits"][columns[(block_id, y)]]) for y in range(p)]
   604	        for x in range(p)
   605	    ]
   606	
   607	
   608	def _enumerate_block(inst, block_id: int, stop_after_first: bool) -> tuple[list[dict], int]:
   609	    p = inst["p"]
   610	    matrix = _local_matrix(inst, block_id)
   611	    dset = set(next(block["D"] for block in inst["blocks"] if block["id"] == block_id))
   612	    # The mixed probe order makes early rejection representative of the full
   613	    # matrix rather than accidentally privileging the first displayed row.
   614	    probes = [(x, y, matrix[x][y]) for x in range(p) for y in range(p)]
   615	    probe_rng = random.Random(0x10021292 + block_id)
   616	    probe_rng.shuffle(probes)
   617	    found = []
   618	    operations = 0
   619	    for a in range(1, p):
   620	        for c in range(1, p):
   621	            if a == c:
   622	                continue
   623	            for delta in range(p):
   624	                for x, y, expected in probes:
   625	                    operations += 1
   626	                    got = (c * y + delta - a * x) % p in dset
   627	                    if got != bool(expected):
   628	                        break
   629	                else:
   630	                    found.append({"a": a, "c": c, "delta": delta})
   631	                    if stop_after_first:
   632	                        return found, operations
   633	    return found, operations
   634	
   635	
   636	def enumerate_all(inst) -> int | None:
   637	    """Count all valid certificates exactly when the affine scan is capped."""
   638	    p = inst["p"]
   639	    work_bound = inst["blocks_count"] * p * (p - 1) * (p - 2)
   640	    if work_bound > 2_100_000:
   641	        return None
   642	    count = 1
   643	    for block_id in range(inst["blocks_count"]):
   644	        solutions, _operations = _enumerate_block(inst, block_id, False)
   645	        count *= len(solutions)
   646	    return count
   647	
   648	
   649	def canonical_key(inst) -> str:
   650	    """Key on affine-normalized block shapes, ignoring all presentation labels."""
   651	    p = inst["p"]
   652	    shapes = sorted(_canonical_difference_set(block["D"], p) for block in inst["blocks"])
   653	    payload = json.dumps(
   654	        {"p": p, "blocks": inst["blocks_count"], "shapes": shapes},
   655	        sort_keys=True,
   656	        separators=(",", ":"),
   657	    )
   658	    return hashlib.sha256(payload.encode("ascii")).hexdigest()
   659	
