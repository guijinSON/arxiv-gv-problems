   815	def _affine_relabel(inst: dict) -> tuple[dict, dict]:
   816	    transformed = copy.deepcopy(inst)
   817	    p = transformed["p"]
   818	    answer = copy.deepcopy(inst["answer"])
   819	    for block_id in range(transformed["blocks_count"]):
   820	        ur = (2 + 2 * block_id) % p
   821	        uc = (3 + 2 * block_id) % p
   822	        if ur == 0:
   823	            ur = 1
   824	        if uc == 0:
   825	            uc = 1
   826	        vr = (5 + block_id) % p
   827	        vc = (7 + block_id) % p
   828	        old = answer["blocks"][block_id]
   829	        # The bounded certificate language requires unequal multipliers.  Choose
   830	        # an affine relabelling that preserves that explicitly stated rule.
   831	        while old["a"] * pow(ur, -1, p) % p == old["c"] * pow(uc, -1, p) % p:
   832	            uc = (uc + 1) % p or 1
   833	        for row in transformed["rows"]:
   834	            if row["block"] == block_id:
   835	                row["x"] = (ur * row["x"] + vr) % p
   836	        for column in transformed["columns"]:
   837	            if column["block"] == block_id:
   838	                column["y"] = (uc * column["y"] + vc) % p
   839	        new_a = old["a"] * pow(ur, -1, p) % p
   840	        new_c = old["c"] * pow(uc, -1, p) % p
   841	        new_delta = (old["delta"] - new_c * vc + new_a * vr) % p
   842	        answer["blocks"][block_id] = {"a": new_a, "c": new_c, "delta": new_delta}
   843	    transformed["answer"] = copy.deepcopy(answer)
   844	    _refresh_summaries(transformed)
   845	    return transformed, answer
