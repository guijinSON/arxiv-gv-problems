+"""Verified generator for Mod/Resc Boolean-matrix factorizations.
+
+The source is arXiv:1002.1292.  Section 2 defines the asymmetric Boolean
+product C = M tensor R, and Theorem 1 identifies a k-column factorization
+with a k-biclique edge cover of the bipartite graph whose bi-adjacency
+matrix is C.
+
+This generator samples two collections of circular intervals on a hidden
+cycle.  Their incidence vectors are the rows of M and R, so C is computed
+directly and the factor pair is known without solving C.  The row and column
+orders are random and only C is shown.  A generic implementation of the
+paper's maximal-biclique algorithm is measured separately from several
+in-context attacks.
+"""
+
+from __future__ import annotations
+
+import bisect
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "matrix_certificate",
+    "native_objects": [
+        "Boolean compatibility matrix",
+        "Boolean mod matrix",
+        "Boolean resc matrix",
+    ],
+    "verification_operations": [
+        "exact Boolean comparison",
+        "exact asymmetric row-by-row Boolean matrix product",
+        "exact matrix equality",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "symmetry",
+    "intuition_description": (
+        "The zero pattern is containment incidence among circular intervals "
+        "on one hidden cycle; without recovering that cycle, a solver faces "
+        "generic biclique-cover search."
+    ),
+    "hardness_basis": (
+        "Track B: Section 4.3's maximal-biclique enumeration followed by "
+        "k-set cover has worst-case time O(2^(k*2^(k-1)+3k)+v^3); the "
+        "shipping-preset implementation's measured wall time and scalar "
+        "Boolean-operation count are recorded by selftest, whereas the hidden-"
+        "cycle route needs at most 252 interval-membership placements."
+    ),
+    "max_answer_tokens": 148,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+# n is both the hidden-cycle length and the requested number k of factor
+# columns.  rows controls the number of strains on each side.  The hard rung
+# uses 252 atomic Boolean entries; escalation first raises the latent dimension
+# while lowering rows, keeping the answer within the 256-atom cap, and then
+# increases crowding at fixed answer length.
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "rows": 3, "crowding": 0},
+    "easy": {"n": 7, "rows": 16, "crowding": 0},
+    "medium": {"n": 7, "rows": 17, "crowding": 1},
+    "hard": {"n": 7, "rows": 18, "crowding": 2},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+
+STRUCTURAL_HINT: str = (
+    "The zero entries are containment incidences among nonempty proper "
+    "circular intervals on one hidden cycle."
+)
+PLACEBO_HINT: str = (
+    "The binary entries are easiest to handle after recording all row and "
+    "column indices with consistent notation."
+)
+
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "An object {M,R} containing two rows-by-k Boolean matrices.  Each of "
+        "the k ordered factor columns must encode a distinct nonempty biclique "
+        "of the displayed 1-entries: its left set is where M has 1 and its "
+        "right set is where R has 0.  Thus candidates are ordered k-tuples "
+        "without replacement from all nonempty bicliques of C."
+    ),
+    "bounds": {
+        "matrices": 2,
+        "entries": "2*rows*k",
+        "entry_alphabet": [0, 1],
+        "factor_columns": "k=n",
+        "column_rule": "distinct active bicliques contained in C",
+    },
+}
+
+
+NOTES: str = (
+    "Section 2, Definitions 1-3 fix the exact asymmetric product: C[i,j]=1 "
+    "iff some coordinate has M[i,l]=1 and R[j,l]=0.  Theorem 1 makes this "
+    "exactly Bipartite Biclique Edge Cover, and Theorem 2 supplies the general "
+    "NP-completeness result.  Track A is not claimed: Section 4 gives an "
+    "O(v^3) kernel and an FPT maximal-biclique algorithm parameterized by k; "
+    "Corollary 1 also identifies graph classes with fewer maximal bicliques.  "
+    "The shipping instances avoid all four Section 4.1 reductions: they have "
+    "no isolated, duplicate-neighborhood, degree-one, or universal vertices.  "
+    "The certificate is inverse-generated from circular-interval incidence "
+    "vectors, then independently permuted on the two strain sets.  Degree-only, "
+    "row-star greedy, degree-sorted circular, truncated-identity, and random-"
+    "restart attacks are measured and fail.  The domain-standard maximal-"
+    "biclique/set-cover algorithm is reported separately and succeeds, as "
+    "Track B requires."
+)
+
+
+# Filled from the three isolated hardening runs before final delivery.
+G9_ORACLE_RESULTS: dict = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+
+def _interval_mask(n: int, start: int, length: int) -> int:
+    mask = 0
+    for offset in range(length):
+        mask |= 1 << ((start + offset) % n)
+    return mask
+
+
+def _interval_pool(n: int, low_side: bool) -> list[tuple[int, int, int]]:
+    if low_side:
+        lengths = range(1, n // 2 + 1)
+    else:
+        lengths = range(n // 2 + 1, n)
+    return [
+        (_interval_mask(n, start, length), start, length)
+        for length in lengths
+        for start in range(n)
+    ]
+
+
+def _weighted_sample_without_replacement(
+    rng: random.Random,
+    pool: list[tuple[int, int, int]],
+    count: int,
+    n: int,
+    crowding: int,
+    low_side: bool,
+) -> list[tuple[int, int, int]]:
+    remaining = list(pool)
+    chosen = []
+    for _ in range(count):
+        weights = []
+        for _mask, _start, length in remaining:
+            # Larger M intervals and smaller R intervals create more near-
+            # containments and denser 1-patterns as crowding grows.
+            bias = length - 1 if low_side else (n - 1 - length)
+            weights.append(1 + crowding * max(0, bias))
+        target = rng.randrange(sum(weights))
+        upto = 0
+        index = 0
+        for index, weight in enumerate(weights):
+            upto += weight
+            if target < upto:
+                break
+        chosen.append(remaining.pop(index))
+    return chosen
+
+
+def _masks_to_matrix(masks: list[int], width: int) -> list[list[int]]:
+    return [[(mask >> column) & 1 for column in range(width)] for mask in masks]
+
+
+def _product_rows(m_masks: list[int], r_masks: list[int]) -> list[int]:
+    rows = []
+    for left in m_masks:
+        row = 0
+        for j, right in enumerate(r_masks):
+            if left & ~right:
+                row |= 1 << j
+        rows.append(row)
+    return rows
+
+
+def _column_masks_from_factors(
+    m_masks: list[int], r_masks: list[int], width: int
+) -> list[tuple[int, int]]:
+    columns = []
+    for coordinate in range(width):
+        left = sum(
+            1 << i for i, mask in enumerate(m_masks) if (mask >> coordinate) & 1
+        )
+        right = sum(
+            1 << j for j, mask in enumerate(r_masks) if not ((mask >> coordinate) & 1)
+        )
+        columns.append((left, right))
+    return columns
+
+
+def make_instance(n: int, seed: int = 0, rows: int | None = None,
+                  crowding: int = 0, **params) -> dict:
+    """Inverse-generate C from known circular-interval Boolean factors."""
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(n, bool) or not isinstance(n, int) or n < 3:
+        raise ValueError("n must be an integer at least 3")
+    if rows is None:
+        rows = min(2 * n, len(_interval_pool(n, True)), len(_interval_pool(n, False)))
+    if isinstance(rows, bool) or not isinstance(rows, int) or rows < n:
+        raise ValueError("rows must be an integer at least n")
+    if isinstance(crowding, bool) or not isinstance(crowding, int) or crowding < 0:
+        raise ValueError("crowding must be a nonnegative integer")
+
+    m_pool = _interval_pool(n, True)
+    r_pool = _interval_pool(n, False)
+    if rows > len(m_pool) or rows > len(r_pool):
+        raise ValueError("rows exceeds the available distinct circular intervals")
+
+    rng = random.Random(seed)
+    for construction_attempt in range(20_000):
+        m_items = _weighted_sample_without_replacement(
+            rng, m_pool, rows, n, crowding, True
+        )
+        r_items = _weighted_sample_without_replacement(
+            rng, r_pool, rows, n, crowding, False
+        )
+        rng.shuffle(m_items)
+        rng.shuffle(r_items)
+        m_masks = [item[0] for item in m_items]
+        r_masks = [item[0] for item in r_items]
+        c_rows = _product_rows(m_masks, r_masks)
+        c_columns = [
+            sum(1 << i for i, row_mask in enumerate(c_rows) if (row_mask >> j) & 1)
+            for j in range(rows)
+        ]
+        factor_columns = _column_masks_from_factors(m_masks, r_masks, n)
+
+        # These are construction guards, not a search for the certificate.  They
+        # keep the paper's four polynomial kernel rules from trivializing the
+        # non-demo instances and ensure every factor coordinate is active.
+        active = all(left and right for left, right in factor_columns)
+        distinct_factors = len(set(factor_columns)) == n
+        if n == 3 and rows == 3:
+            acceptable = active and distinct_factors
+        else:
+            degrees = [mask.bit_count() for mask in c_rows + c_columns]
+            acceptable = (
+                active
+                and distinct_factors
+                and len(set(c_rows)) == rows
+                and len(set(c_columns)) == rows
+                and min(degrees) >= 2
+                and max(degrees) <= rows - 2
+            )
+        if acceptable:
+            break
+    else:
+        raise RuntimeError("could not sample a nontrivial interval instance")
+
+    answer = {
+        "M": _masks_to_matrix(m_masks, n),
+        "R": _masks_to_matrix(r_masks, n),
+    }
+    return {
+        "family": "Mod/Resc circular-interval factorization",
+        "n": n,
+        "rows": rows,
+        "k": n,
+        "crowding": crowding,
+        "C": _masks_to_matrix(c_rows, rows),
+        "answer": answer,
+    }
+
+
+def render(inst: dict) -> str:
+    matrix_lines = "\n".join("".join(map(str, row)) for row in inst["C"])
+    statement = f"""Find a Mod/Resc factorization of this Boolean compatibility matrix.
+
+For Boolean row vectors U,V of length k, define the asymmetric product
+
+    U tensor V = 1  iff  U[l]=1 and V[l]=0 for at least one l,
+    U tensor V = 0  otherwise.
+
+For matrices M and R, M tensor R is computed row by row:
+(M tensor R)[i,j] is row i of M tensor row j of R.
+
+Here C has {inst['rows']} rows and {inst['rows']} columns, and k={inst['k']}:
+
+{matrix_lines}
+
+Find Boolean matrices M and R, each with exactly {inst['rows']} rows and
+exactly {inst['k']} columns, such that C=M tensor R.  Entries must be the
+integers 0 or 1.  Every factor column must be active: it must contain at least
+one 1 in M and at least one 0 in R.  No two factor columns may be identical as
+pairs (M-column, R-column).  Factor-column order is arbitrary, and any valid
+factorization is accepted.
+
+Return one JSON object with exactly the keys "M" and "R"; each value is a
+rectangular JSON array of rows.  Row and column indexing is 0-based in the
+description, but indices are not part of the answer.
+
+Give your final answer inside <answer></answer> tags, as that JSON object.
+Example format: <answer>{{"M":[[1,0],[0,1]],"R":[[0,1],[1,0]]}}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Parse a tagged JSON matrix pair, tolerating prose and Markdown fences."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\s*>(.*?)</answer\s*>", text, re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if body.startswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(value, dict) or set(value) != {"M", "R"}:
+        return None
+    return value
+
+
+def _matrix_to_row_masks(matrix: object, height: int, width: int,
+                         name: str) -> tuple[list[int] | None, str | None]:
+    if not isinstance(matrix, list):
+        return None, f"{name} must be a JSON array"
+    if len(matrix) != height:
+        return None, f"{name} must have exactly {height} rows"
+    masks = []
+    for row_index, row in enumerate(matrix):
+        if not isinstance(row, list) or len(row) != width:
+            return None, f"row {row_index} of {name} must have exactly {width} entries"
+        mask = 0
+        for column, value in enumerate(row):
+            if type(value) is not int or value not in (0, 1):
+                return None, f"entries of {name} must be the integers 0 or 1"
+            mask |= value << column
+        masks.append(mask)
+    return masks, None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any valid factor pair exactly; never consult inst['answer']."""
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if set(answer) != {"M", "R"}:
+        return False, "answer object must have exactly the keys M and R"
+    height = inst["rows"]
+    width = inst["k"]
+    m_masks, error = _matrix_to_row_masks(answer["M"], height, width, "M")
+    if error:
+        return False, error
+    r_masks, error = _matrix_to_row_masks(answer["R"], height, width, "R")
+    if error:
+        return False, error
+
+    c_rows = [sum(value << j for j, value in enumerate(row)) for row in inst["C"]]
+    factor_columns = _column_masks_from_factors(m_masks, r_masks, width)
+    if any(not left or not right for left, right in factor_columns):
+        return False, "every factor column must be active on both sides"
+    if len(set(factor_columns)) != width:
+        return False, "factor columns must be distinct"
+
+    covered = [0] * height
+    for column, (left, right) in enumerate(factor_columns):
+        work = left
+        while work:
+            bit = work & -work
+            i = bit.bit_length() - 1
+            if right & ~c_rows[i]:
+                return False, f"factor column {column} creates a 1 where C has 0"
+            covered[i] |= right
+            work ^= bit
+    for i, (got, wanted) in enumerate(zip(covered, c_rows)):
+        if got != wanted:
+            return False, f"factorization misses a 1 in row {i}"
+    return True, "ok"
+
+
+# The table is intentionally a one-instance cache.  It makes the 200,000-draw
+# gate cheap without retaining a 2^rows table for every emitted instance.
+_SAMPLING_CACHE_KEY: tuple[int, ...] | None = None
+_SAMPLING_CACHE_VALUE: tuple[list[int], int, tuple[int, ...]] | None = None
+_SAMPLING_CACHE_INSTANCE: dict | None = None
+
+
+def _c_row_masks(inst: dict) -> tuple[int, ...]:
+    return tuple(sum(value << j for j, value in enumerate(row)) for row in inst["C"])
+
+
+def _sampling_table(inst: dict) -> tuple[list[int], int, tuple[int, ...]]:
+    global _SAMPLING_CACHE_KEY, _SAMPLING_CACHE_VALUE, _SAMPLING_CACHE_INSTANCE
+    if _SAMPLING_CACHE_INSTANCE is inst and _SAMPLING_CACHE_VALUE is not None:
+        return _SAMPLING_CACHE_VALUE
+    c_rows = _c_row_masks(inst)
+    if _SAMPLING_CACHE_KEY == c_rows and _SAMPLING_CACHE_VALUE is not None:
+        _SAMPLING_CACHE_INSTANCE = inst
+        return _SAMPLING_CACHE_VALUE
+    all_right = (1 << inst["rows"]) - 1
+    prefix = []
+    total = 0
+    for left in range(1, 1 << inst["rows"]):
+        common = all_right
+        work = left
+        while work and common:
+            bit = work & -work
+            common &= c_rows[bit.bit_length() - 1]
+            work ^= bit
+        if common:
+            total += (1 << common.bit_count()) - 1
+        prefix.append(total)
+    _SAMPLING_CACHE_KEY = c_rows
+    _SAMPLING_CACHE_VALUE = (prefix, total, c_rows)
+    _SAMPLING_CACHE_INSTANCE = inst
+    return _SAMPLING_CACHE_VALUE
+
+
+def _expand_subset(pattern: int, available: int) -> int:
+    result = 0
+    position = 0
+    while available:
+        bit = available & -available
+        if (pattern >> position) & 1:
+            result |= bit
+        position += 1
+        available ^= bit
+    return result
+
+
+def _sample_one_biclique(
+    inst: dict,
+    rng: random.Random,
+    table: tuple[list[int], int, tuple[int, ...]] | None = None,
+) -> tuple[int, int]:
+    prefix, total, c_rows = table if table is not None else _sampling_table(inst)
+    target = rng.randrange(total)
+    index = bisect.bisect_right(prefix, target)
+    left = index + 1
+    common = (1 << inst["rows"]) - 1
+    work = left
+    while work:
+        bit = work & -work
+        common &= c_rows[bit.bit_length() - 1]
+        work ^= bit
+    pattern = rng.randrange(1, 1 << common.bit_count())
+    return left, _expand_subset(pattern, common)
+
+
+def _columns_to_answer(inst: dict, columns: list[tuple[int, int]]) -> dict:
+    height = inst["rows"]
+    width = inst["k"]
+    m_matrix = [[0] * width for _ in range(height)]
+    r_matrix = [[1] * width for _ in range(height)]
+    for column, (left, right) in enumerate(columns):
+        for i in range(height):
+            m_matrix[i][column] = (left >> i) & 1
+            r_matrix[i][column] = 0 if ((right >> i) & 1) else 1
+    return {"M": m_matrix, "R": r_matrix}
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample ordered distinct, active bicliques already inside C."""
+    columns = []
+    seen = set()
+    table = _sampling_table(inst)
+    while len(columns) < inst["k"]:
+        biclique = _sample_one_biclique(inst, rng, table)
+        if biclique not in seen:
+            seen.add(biclique)
+            columns.append(biclique)
+    return _columns_to_answer(inst, columns)
+
+
+def search_space(inst: dict) -> int | None:
+    """Number of ordered k-tuples without replacement from all bicliques."""
+    _prefix, bicliques, _c_rows = _sampling_table(inst)
+    k = inst["k"]
+    if bicliques < k:
+        return 0
+    return math.prod(range(bicliques - k + 1, bicliques + 1))
+
+
+def _all_bicliques(inst: dict) -> list[tuple[int, int]]:
+    c_rows = _c_row_masks(inst)
+    all_right = (1 << inst["rows"]) - 1
+    out = []
+    for left in range(1, 1 << inst["rows"]):
+        common = all_right
+        work = left
+        while work and common:
+            bit = work & -work
+            common &= c_rows[bit.bit_length() - 1]
+            work ^= bit
+        sub = common
+        while sub:
+            out.append((left, sub))
+            sub = (sub - 1) & common
+    return out
+
+
+def enumerate_all(inst: dict) -> int | None:
+    total = search_space(inst)
+    if total is None or total > 100_000:
+        return None
+    bicliques = _all_bicliques(inst)
+    valid = 0
+    for columns in itertools.permutations(bicliques, inst["k"]):
+        valid += int(verify(inst, _columns_to_answer(inst, list(columns)))[0])
+    return valid
+
+
+def _side_invariant(row_masks: list[int], opposite_size: int) -> list:
+    degrees = sorted(mask.bit_count() for mask in row_masks)
+    local = []
+    for i, mask in enumerate(row_masks):
+        common = sorted(
+            (mask & other).bit_count()
+            for j, other in enumerate(row_masks)
+            if i != j
+        )
+        local.append([mask.bit_count(), common])
+    local.sort()
+    triples = sorted(
+        (row_masks[i] & row_masks[j] & row_masks[k]).bit_count()
+        for i in range(len(row_masks))
+        for j in range(i + 1, len(row_masks))
+        for k in range(j + 1, len(row_masks))
+    )
+    return [len(row_masks), opposite_size, degrees, local, triples]
+
+
+def canonical_key(inst: dict) -> str:
+    """A strong permutation invariant of the bipartite compatibility graph.
+
+    Exact bipartite graph canonization is itself a nontrivial problem.  This key
+    uses all one-, two-, and three-row common-neighborhood counts on both sides,
+    plus edge endpoint degree pairs.  It is invariant under independent strain
+    relabellings and under transposition; it is not claimed complete for all
+    nonisomorphic bipartite graphs.
+    """
+    rows = list(_c_row_masks(inst))
+    height = inst["rows"]
+    columns = [
+        sum(1 << i for i, row in enumerate(rows) if (row >> j) & 1)
+        for j in range(height)
+    ]
+    left = _side_invariant(rows, height)
+    right = _side_invariant(columns, height)
+    sides = sorted([left, right], key=lambda item: json.dumps(item, separators=(",", ":")))
+    row_degrees = [mask.bit_count() for mask in rows]
+    col_degrees = [mask.bit_count() for mask in columns]
+    endpoints = sorted(
+        [row_degrees[i], col_degrees[j]]
+        for i, row in enumerate(rows)
+        for j in range(height)
+        if (row >> j) & 1
+    )
+    payload = json.dumps([sides, endpoints], separators=(",", ":")).encode()
+    return hashlib.sha256(payload).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Increase latent dimension and then crowding without lengthening output."""
+    n = params.get("n")
+    rows = params.get("rows")
+    crowding = params.get("crowding", 0)
+    if not all(isinstance(value, int) and not isinstance(value, bool)
+               for value in (n, rows, crowding)):
+        return None
+    if n < 8:
+        # 2*16*8 = 256 atoms: a larger latent space at essentially fixed output.
+        return {"n": 8, "rows": 16, "crowding": max(3, crowding + 1)}
+    if n == 8 and rows == 16 and crowding < 6:
+        return {"n": 8, "rows": 16, "crowding": crowding + 1}
+    return "cap_bound"
+
+
+def _maximal_bicliques(inst: dict) -> tuple[list[tuple[int, int]], dict]:
+    """Enumerate formal concepts, a generic maximal-biclique procedure."""
+    c_rows = _c_row_masks(inst)
+    height = inst["rows"]
+    all_right = (1 << height) - 1
+    concepts = set()
+    counts = {
+        "left_subsets": 0,
+        "bitset_intersections": 0,
+        "closure_tests": 0,
+        "scalar_boolean_operations": 0,
+    }
+    for seed_left in range(1, 1 << height):
+        counts["left_subsets"] += 1
+        right = all_right
+        work = seed_left
+        while work and right:
+            bit = work & -work
+            right &= c_rows[bit.bit_length() - 1]
+            counts["bitset_intersections"] += 1
+            counts["scalar_boolean_operations"] += height
+            work ^= bit
+        if not right:
+            continue
+        closed_left = 0
+        for i, neighbors in enumerate(c_rows):
+            counts["closure_tests"] += 1
+            counts["scalar_boolean_operations"] += height
+            if not (right & ~neighbors):
+                closed_left |= 1 << i
+        closed_right = all_right
+        work = closed_left
+        while work:
+            bit = work & -work
+            closed_right &= c_rows[bit.bit_length() - 1]
+            counts["bitset_intersections"] += 1
+            counts["scalar_boolean_operations"] += height
+            work ^= bit
+        if closed_left and closed_right:
+            concepts.add((closed_left, closed_right))
+    return sorted(concepts), counts
+
+
+def _edge_masks(inst: dict, bicliques: list[tuple[int, int]]) -> tuple[list[int], int]:
+    c_rows = _c_row_masks(inst)
+    edge_number = {}
+    full = 0
+    next_edge = 0
+    for i, row in enumerate(c_rows):
+        for j in range(inst["rows"]):
+            if (row >> j) & 1:
+                edge_number[i, j] = next_edge
+                full |= 1 << next_edge
+                next_edge += 1
+    masks = []
+    for left, right in bicliques:
+        mask = 0
+        left_work = left
+        while left_work:
+            left_bit = left_work & -left_work
+            i = left_bit.bit_length() - 1
+            right_work = right
+            while right_work:
+                right_bit = right_work & -right_work
+                j = right_bit.bit_length() - 1
+                mask |= 1 << edge_number[i, j]
+                right_work ^= right_bit
+            left_work ^= left_bit
+        masks.append(mask)
+    return masks, full
+
+
+def _cover_search(edge_masks: list[int], full: int, limit: int) -> tuple[list[int] | None, dict]:
+    edge_count = full.bit_count()
+    by_edge = [
+        [index for index, mask in enumerate(edge_masks) if (mask >> edge) & 1]
+        for edge in range(edge_count)
+    ]
+    memo = set()
+    nodes = 0
+    gain_evaluations = 0
+
+    def dfs(uncovered: int, remaining: int) -> list[int] | None:
+        nonlocal nodes, gain_evaluations
+        nodes += 1
+        if not uncovered:
+            return []
+        if remaining == 0:
+            return None
+        maximum = 0
+        for mask in edge_masks:
+            gain_evaluations += 1
+            maximum = max(maximum, (mask & uncovered).bit_count())
+        if maximum == 0 or (uncovered.bit_count() + maximum - 1) // maximum > remaining:
+            return None
+
+        work = uncovered
+        best_candidates = None
+        while work:
+            bit = work & -work
+            edge = bit.bit_length() - 1
+            candidates = by_edge[edge]
+            if best_candidates is None or len(candidates) < len(best_candidates):
+                best_candidates = candidates
+            work ^= bit
+        ordered = sorted(
+            best_candidates,
+            key=lambda index: (edge_masks[index] & uncovered).bit_count(),
+            reverse=True,
+        )
+        for index in ordered:
+            new_uncovered = uncovered & ~edge_masks[index]
+            state = (new_uncovered, remaining - 1)
+            if state in memo:
+                continue
+            result = dfs(new_uncovered, remaining - 1)
+            if result is not None:
+                return [index] + result
+            memo.add(state)
+        return None
+
+    solution = dfs(full, limit)
+    return solution, {
+        "cover_search_nodes": nodes,
+        "gain_evaluations": gain_evaluations,
+        "memo_states": len(memo),
+    }
+
+
+def _reference_algorithm(inst: dict) -> tuple[object | None, dict]:
+    start = time.perf_counter()
+    bicliques, counts = _maximal_bicliques(inst)
+    edge_masks, full = _edge_masks(inst, bicliques)
+    indices, search_counts = _cover_search(edge_masks, full, inst["k"])
+    counts.update(search_counts)
+    counts["maximal_bicliques"] = len(bicliques)
+    counts["edges"] = full.bit_count()
+    if indices is None:
+        counts["wall_clock_sec"] = time.perf_counter() - start
+        return None, counts
+    columns = [bicliques[index] for index in indices]
+    for biclique in bicliques:
+        if len(columns) >= inst["k"]:
+            break
+        if biclique not in columns:
+            columns.append(biclique)
+    answer = _columns_to_answer(inst, columns)
+    counts["scalar_boolean_operations"] += counts["gain_evaluations"] * max(1, counts["edges"])
+    counts["wall_clock_sec"] = time.perf_counter() - start
+    return answer, counts
+
+
+def _fill_columns(inst: dict, columns: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    chosen = []
+    seen = set()
+    for column in columns:
+        if column[0] and column[1] and column not in seen:
+            chosen.append(column)
+            seen.add(column)
+        if len(chosen) == inst["k"]:
+            return chosen
+    for i, row in enumerate(_c_row_masks(inst)):
+        work = row
+        while work:
+            bit = work & -work
+            column = (1 << i, bit)
+            if column not in seen:
+                chosen.append(column)
+                seen.add(column)
+                if len(chosen) == inst["k"]:
+                    return chosen
+            work ^= bit
+    return chosen
+
+
+def _row_star_greedy(inst: dict) -> object:
+    rows = _c_row_masks(inst)
+    order = sorted(range(inst["rows"]), key=lambda i: (-rows[i].bit_count(), i))
+    columns = [(1 << i, rows[i]) for i in order[: inst["k"]]]
+    return _columns_to_answer(inst, _fill_columns(inst, columns))
+
+
+def _degree_only_ansatz(inst: dict) -> object:
+    rows = _c_row_masks(inst)
+    height = inst["rows"]
+    columns = [
+        sum(1 << i for i, row in enumerate(rows) if (row >> j) & 1)
+        for j in range(height)
+    ]
+    row_order = sorted(range(height), key=lambda i: (rows[i].bit_count(), i))
+    col_order = sorted(range(height), key=lambda j: (columns[j].bit_count(), j))
+    m_masks = [0] * height
+    r_masks = [0] * height
+    max_low = max(1, inst["n"] // 2)
+    for rank, i in enumerate(row_order):
+        length = 1 + rows[i].bit_count() % max_low
+        m_masks[i] = _interval_mask(inst["n"], rank % inst["n"], length)
+    for rank, j in enumerate(col_order):
+        missing = 1 + columns[j].bit_count() % max_low
+        absent = _interval_mask(inst["n"], rank % inst["n"], missing)
+        r_masks[j] = ((1 << inst["n"]) - 1) ^ absent
+    return {"M": _masks_to_matrix(m_masks, inst["n"]),
+            "R": _masks_to_matrix(r_masks, inst["n"])}
+
+
+def _degree_sorted_circular_ansatz(inst: dict) -> object:
+    rows = _c_row_masks(inst)
+    height = inst["rows"]
+    columns = [
+        sum(1 << i for i, row in enumerate(rows) if (row >> j) & 1)
+        for j in range(height)
+    ]
+    row_order = sorted(range(height), key=lambda i: (rows[i].bit_count(), i))
+    col_order = sorted(range(height), key=lambda j: (columns[j].bit_count(), j))
+    m_masks = [0] * height
+    r_masks = [0] * height
+    low_lengths = list(range(1, inst["n"] // 2 + 1))
+    high_lengths = list(range(inst["n"] // 2 + 1, inst["n"]))
+    for rank, i in enumerate(row_order):
+        length = low_lengths[rank % len(low_lengths)]
+        m_masks[i] = _interval_mask(inst["n"], rank % inst["n"], length)
+    for rank, j in enumerate(col_order):
+        length = high_lengths[rank % len(high_lengths)]
+        r_masks[j] = _interval_mask(inst["n"], rank % inst["n"], length)
+    return {"M": _masks_to_matrix(m_masks, inst["n"]),
+            "R": _masks_to_matrix(r_masks, inst["n"])}
+
+
+def _truncated_identity_ansatz(inst: dict) -> object:
+    height = inst["rows"]
+    width = inst["k"]
+    c_rows = _c_row_masks(inst)
+    columns = []
+    for i in range(width):
+        columns.append((1 << i, c_rows[i]))
+    return _columns_to_answer(inst, _fill_columns(inst, columns))
+
+
+def _permuted_instance(inst: dict, row_order: list[int], col_order: list[int]) -> dict:
+    moved = dict(inst)
+    moved["C"] = [[inst["C"][i][j] for j in col_order] for i in row_order]
+    moved["answer"] = {
+        "M": [list(inst["answer"]["M"][i]) for i in row_order],
+        "R": [list(inst["answer"]["R"][j]) for j in col_order],
+    }
+    return moved
+
+
+def _transposed_instance(inst: dict) -> dict:
+    moved = dict(inst)
+    height = inst["rows"]
+    moved["C"] = [[inst["C"][j][i] for j in range(height)] for i in range(height)]
+    moved["answer"] = {
+        "M": [[1 - value for value in row] for row in inst["answer"]["R"]],
+        "R": [[1 - value for value in row] for row in inst["answer"]["M"]],
+    }
+    return moved
+
+
+def selftest() -> dict:
+    report = {
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+
+    failures = []
+    attempts = 0
+    kernel_checks = {}
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7, 19):
+            instance = make_instance(seed=seed, **params)
+            ok, why = verify(instance, instance["answer"])
+            attempts += 1
+            if not ok:
+                failures.append([preset, seed, why])
+            if json.loads(json.dumps(instance["answer"])) != instance["answer"]:
+                failures.append([preset, seed, "answer is not JSON-native"])
+        probe = make_instance(seed=31, **params)
+        row_masks = _c_row_masks(probe)
+        col_masks = [
+            sum(1 << i for i, row in enumerate(row_masks) if (row >> j) & 1)
+            for j in range(probe["rows"])
+        ]
+        degrees = [mask.bit_count() for mask in list(row_masks) + col_masks]
+        kernel_checks[preset] = {
+            "no_isolated": min(degrees) > 0,
+            "distinct_neighborhoods": (
+                len(set(row_masks)) == probe["rows"]
+                and len(set(col_masks)) == probe["rows"]
+            ) if preset != "demo" else True,
+            "no_degree_one": min(degrees) > 1 if preset != "demo" else True,
+            "no_universal": max(degrees) < probe["rows"] if preset != "demo" else True,
+        }
+    report["G1_planted_verifies"] = {
+        "pass": not failures and all(all(values.values()) for values in kernel_checks.values()),
+        "attempts": attempts,
+        "failures": failures,
+        "section_4_1_kernel_checks": kernel_checks,
+    }
+
+    inst = make_instance(seed=101, **shipping)
+    answer = inst["answer"]
+    dropped = {"M": answer["M"][:-1], "R": answer["R"]}
+    swapped = None
+    for row in range(inst["rows"]):
+        ones = [j for j, value in enumerate(answer["M"][row]) if value == 1]
+        zeros = [j for j, value in enumerate(answer["M"][row]) if value == 0]
+        for one in ones:
+            for zero in zeros:
+                candidate = json.loads(json.dumps(answer))
+                candidate["M"][row][one], candidate["M"][row][zero] = 0, 1
+                if "creates a 1" in verify(inst, candidate)[1]:
+                    swapped = candidate
+                    break
+            if swapped is not None:
+                break
+        if swapped is not None:
+            break
+    if swapped is None:
+        swapped = json.loads(json.dumps(answer))
+        swapped["M"][0][0] ^= 1
+
+    duplicated = json.loads(json.dumps(answer))
+    for row in range(inst["rows"]):
+        duplicated["M"][row][1] = duplicated["M"][row][0]
+        duplicated["R"][row][1] = duplicated["R"][row][0]
+    corruptions = {
+        "drop_one_row": dropped,
+        "swap_one_zero_and_one": swapped,
+        "duplicate_factor_column": duplicated,
+        "empty": [],
+        "out_of_range": {
+            "M": [[2] + row[1:] if index == 0 else list(row)
+                  for index, row in enumerate(answer["M"])],
+            "R": answer["R"],
+        },
+    }
+    rejected = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        rejected[name] = {"rejected": not ok, "reason": why}
+    reasons = [value["reason"] for value in rejected.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(value["rejected"] for value in rejected.values())
+        and len(set(reasons)) == len(reasons),
+        "cases": rejected,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    response = (
+        "I used the hidden containment structure.\n```json\n<answer>"
+        + json.dumps(answer, separators=(",", ":"))
+        + "</answer>\n```\nThe matrices have the requested dimensions."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0],
+        "parsed_equals_answer": parsed == answer,
+    }
+
+    guess_rng = random.Random(0x10021292)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_start = time.perf_counter()
+    for _ in range(guess_total):
+        guess_hits += int(verify(inst, random_candidate(inst, guess_rng))[0])
+    guess_seconds = time.perf_counter() - guess_start
+    candidate_count = search_space(inst)
+    report["G4_guess_resistance"] = {
+        "pass": guess_hits / guess_total < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "fraction": guess_hits / guess_total,
+        "candidate_space": candidate_count,
+        "candidate_space_bits": candidate_count.bit_length(),
+        "sampling_prior": "uniform ordered distinct active bicliques contained in C",
+        "wall_clock_sec": round(guess_seconds, 6),
+    }
+
+    attack_names = [
+        "outlier_degree_only",
+        "greedy_largest_row_stars",
+        "by_hand_degree_sorted_circular_ansatz",
+        "obvious_truncated_identity",
+        "random_restart_256",
+    ]
+    successes = {name: 0 for name in attack_names}
+    attack_wall = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    reference_wall = 0.0
+    reference_scalar_ops = 0
+    reference_nodes = 0
+    reference_bicliques = 0
+    for seed in range(201, 209):
+        trial = make_instance(seed=seed, **shipping)
+        candidates = {
+            "outlier_degree_only": [_degree_only_ansatz(trial)],
+            "greedy_largest_row_stars": [_row_star_greedy(trial)],
+            "by_hand_degree_sorted_circular_ansatz": [
+                _degree_sorted_circular_ansatz(trial)
+            ],
+            "obvious_truncated_identity": [_truncated_identity_ansatz(trial)],
+        }
+        rrng = random.Random(seed ^ 0x5A17C0DE)
+        candidates["random_restart_256"] = [
+            random_candidate(trial, rrng) for _ in range(256)
+        ]
+        for name in attack_names:
+            start = time.perf_counter()
+            won = any(verify(trial, candidate)[0] for candidate in candidates[name])
+            attack_wall[name] += time.perf_counter() - start
+            successes[name] += int(won)
+
+        reference, counts = _reference_algorithm(trial)
+        reference_wall += counts["wall_clock_sec"]
+        reference_scalar_ops += counts["scalar_boolean_operations"]
+        reference_nodes += counts["cover_search_nodes"]
+        reference_bicliques += counts["maximal_bicliques"]
+        reference_successes += int(
+            reference is not None and verify(trial, reference)[0]
+        )
+
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_wall[name] / 8, 6),
+        }
+        for name in attack_names
+    }
+    avg_reference_wall = reference_wall / 8
+    avg_reference_ops = reference_scalar_ops // 8
+    avg_reference_nodes = reference_nodes // 8
+    avg_reference_bicliques = reference_bicliques // 8
+    all_failed = all(value == 0 for value in successes.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "Section 4.3 maximal-biclique enumeration plus k-set-cover search",
+            "complexity": "O(2^(k*2^(k-1)+3k)+v^3) after kernelization (paper Theorem 4)",
+            "wall_clock_sec": round(avg_reference_wall, 6),
+            "operations": avg_reference_ops,
+            "average_cover_search_nodes": avg_reference_nodes,
+            "average_maximal_bicliques": avg_reference_bicliques,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    demo = make_instance(seed=3, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_hits / guess_total < 1e-6
+        and demo_count is not None
+        and all_failed
+        and reference_successes == 8,
+        "shipping_sample_hits": guess_hits,
+        "shipping_sample_total": guess_total,
+        "shipping_sample_density": guess_hits / guess_total,
+        "shipping_candidate_count": candidate_count,
+        "demo_exact_valid_answer_count": demo_count,
+        "demo_exact_candidate_count": search_space(demo),
+        "strongest_failing_attack": "random_restart_256",
+        "strongest_failing_attack_iterations": 256,
