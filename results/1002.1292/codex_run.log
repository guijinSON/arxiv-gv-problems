+
+    attack_names = (
+        "outlier_equal_degree_identity",
+        "greedy_sorted_boundary_pair",
+        "random_restart_256",
+        "in_context_linear_moment_c_equals_one",
+    )
+    attack_successes = {name: 0 for name in attack_names}
+    attack_attempts = 8
+    reference_successes = 0
+    reference_operations = 0
