+def _affine_relabel(inst: dict) -> tuple[dict, dict]:
+    transformed = copy.deepcopy(inst)
+    p = transformed["p"]
+    answer = copy.deepcopy(inst["answer"])
+    for block_id in range(transformed["blocks_count"]):
+        ur = (2 + 2 * block_id) % p
+        uc = (3 + 2 * block_id) % p
+        if ur == 0:
+            ur = 1
+        if uc == 0:
+            uc = 1
+        vr = (5 + block_id) % p
+        vc = (7 + block_id) % p
