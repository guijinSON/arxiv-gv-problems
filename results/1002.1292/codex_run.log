import random,time

def inv(a,p): return pow(a,-1,p)
def make_D(p,rng):
 h=(p-1)//2;w=h+1
 while 1:
  D={0}
  for x in range(1,h+1):D.add(x if rng.getrandbits(1) else (-x)%p)
  sd=sum(D)%p;mu=sd*inv(w,p)%p;td=sum(pow((d-mu)%p,3,p) for d in D)%p
  if not td:continue
  autos=[(u,v) for u in range(1,p) for v in range(p) if {(u*d+v)%p for d in D}==D]
  if autos==[(1,0)]:return sorted(D),sd,td

def matrix(p,D,a,c,delta):
 ds=set(D);return [[int((c*j+delta-a*i)%p in ds) for j in range(p)] for i in range(p)]
def moments(p,D,C):
 w=len(D);wi=inv(w,p);ss=[sum(j for j,v in enumerate(C[i]) if v)%p for i in (0,1)];mu=ss[0]*wi%p;t=sum(pow((j-mu)%p,3,p) for j,v in enumerate(C[0]) if v)%p;sd=sum(D)%p;mud=sd*wi%p;td=sum(pow((d-mud)%p,3,p) for d in D)%p;e=inv(3,p-1);q=pow(t*inv(td,p)%p,e,p);cc=inv(q,p);aa=(ss[1]-ss[0])*cc*wi%p;dd=(sd-cc*ss[0])*wi%p;return ss,t,(aa,cc,dd)
def enum(p,D,C):
 ds=set(D);probes=[(i,j,C[i][j]) for i in range(p) for j in range(p)];ops=0;st=time.perf_counter()
 for a in range(1,p):
  for c in range(1,p):
   if a==c:continue
   for delta in range(p):
    for i,j,v in probes:
     ops+=1
     if ((c*j+delta-a*i)%p in ds)"'!=bool(v):break
    else:return (a,c,delta),ops,time.perf_counter()-st
for p in (11,41,71,101):
 rng=random.Random(123);D,sd,td=make_D(p,rng);a=rng.randrange(2,p);c=rng.randrange(2,p)
 while c==a:c=rng.randrange(2,p)
 de=rng.randrange(p);C=matrix(p,D,a,c,de)
 print(p,'"'truth',(a,c,de),'mom',moments(p,D,C)[2],flush=True)
 if p in (41,101):print('enum',enum(p,D,C),flush=True)
