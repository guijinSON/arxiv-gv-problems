+        guess_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
+    guess_seconds = time.perf_counter() - guess_started
+    observed = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6,
+        "hits": guess_hits,
