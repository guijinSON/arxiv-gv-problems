import random,time

def inv(a,p): return pow(a,-1,p)
def make_D(p,rng,need_trivial=True):
    h=(p-1)//2; w=h+1
    for tries in range(10000):
        D={0}
        for x in range(1,h+1): D.add(x if rng.getrandbits(1) else (-x)%p)
        sd=sum(D)%p; mu=sd*inv(w,p)%p
        td=sum(pow((d-mu)%p,3,p) for d in D)%p
        if not td: continue
        if need_trivial:
            autos=[]
            for u in range(1,p):
                for v in range(p):
                    if {(u*d+v)%p for d in D}==D: autos.append((u,v))
            if autos"'!=[(1,0)]: continue
        return sorted(D),sd,td,tries
    raise RuntimeError

def matrix(p,D,a,c,delta):
    ds=set(D)
    return [[int((c*j+delta-a*i)%p in ds) for j in range(p)] for i in range(p)]

def moments(p,D,C):
    w=len(D); wi=inv(w,p)
    ss=[sum(j for j,v in enumerate(C[i]) if v)%p for i in (0,1)]
    mu=ss[0]*wi%p
    t=sum(pow((j-mu)%p,3,p) for j,v in enumerate(C[0]) if v)%p
    sd=sum(D)%p; mud=sd*wi%p; td=sum(pow((d-mud)%p,3,p) for d in D)%p
    e=inv(3,p-1); q=pow(t*inv(td,p)%p,e,p); cc=inv(q,p)
    aa=(ss[1]-ss[0])*cc*wi%p; dd=(sd-cc*ss[0])*wi%p
    return ss,t,(aa,cc,dd)

def enum(p,D,C):
    ds=set(D); probes=[(i,j,C[i][j]) for i in range(p) for j in range(p)]
