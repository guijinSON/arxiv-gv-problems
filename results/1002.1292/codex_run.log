def ints(k,l):return [sum(1<<((s+d)%k) for d in range(l)) for s in range(k)]
def gen(k,rows,seed):
 rng=random.Random(seed); mp=[x for l in range(1,(k+1)//2) for x in ints(k,l)];rp=[x for l in range((k+1)//2,k) for x in ints(k,l)]
