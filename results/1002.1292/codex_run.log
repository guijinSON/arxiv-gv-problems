+    if not _is_int(seed):
+        raise TypeError("seed must be an integer")
+
+    rng = random.Random(seed)
+    used_shapes: set[str] = set()
+    raw_blocks = []
+    answers = []
+    for block_id in range(blocks):
+        block, answer = _make_block(n, rng, used_shapes)
