  e=0;w=A
  while w:q=w&-w;i=q.bit_length()-1;ww=B
  # oops
  for i in range(len(C)):
   if A>>i&1:
    for j in range(m):
     if B>>j&1:e|=1<<idx[i,j]
  em.append(e)
 return co,em,full,ops

def greedy(em,full):
 u=full;c=0
 while u:
  e=max(em,key=lambda z:((z&u).bit_count(),z.bit_count()));g=e&u
  if not g:return 999
  u&=~e;c+=1
 return c

def exact(em,full,k):
 E=full.bit_count();by=[[q for q,e in enumerate(em) if e>>b&1] for b in range(E)];nodes=0;memo=set()
 def dfs(u,left):
  nonlocal nodes;nodes+=1
  if not u:return []
  if left==0:return None
  mx=max((e&u).bit_count() for e in em)
  if (u.bit_count()+mx-1)//mx>left:return None
  w=u;best=None
  while w:
   q=w&-w;b=q.bit_length()-1;c=by[b]
   if best is None or len(c)<len(best[1]):best=(b,c)
   w-=q
  c=sorted(best[1],key=lambda z:(em[z]&u).bit_count(),reverse=True)
  for z in c:
   nu=u&~em[z];key=(nu,left-1)
   if key in memo:continue
   g=dfs(nu,left-1)
   if g is not None:return[z]+g
   memo.add(key)
  return None
 for lim in range(1,k+1):
  g=dfs(full,lim)
  if g is not None:return g,nodes
 return None,nodes
for seed in list(range(8))+list(range(101,109)):
 ms,rs,C,tr=gen(7,18,seed);t=time.time();co,em,full,ops=concepts(C,18);dt=time.time()-t;g=greedy(em,full);t=time.time();sol,nodes=exact(em,full,7);edt=time.time()-t
 print(seed,'tr',tr,'edges',full.bit_count(),'con',len(co),'ops',ops,'enumsec',round(dt,2),'greedy',g,'exact',len(sol) if sol else None,'nodes',nodes,'dt',round(edt,3))
