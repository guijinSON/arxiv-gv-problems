   754	def _random_restart_attack(inst, seed: int, restarts: int = 256) -> object | None:
   755	    rng = random.Random(seed)
   756	    for _ in range(restarts):
   757	        candidate = random_candidate(inst, rng)
   758	        if verify(inst, candidate)[0]:
   759	            return candidate
   760	    return None
