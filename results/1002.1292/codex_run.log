+        )
+        col_only = _permuted_instance(
+            original, list(range(original["rows"])), col_order
+        )
+        both = _permuted_instance(original, row_order, col_order)
+        transposed = _transposed_instance(original)
+        transposed_both = _transposed_instance(both)
+
+        coordinate_order = list(range(original["k"]))
+        rng.shuffle(coordinate_order)
+        coordinate_moved = dict(original)
+        coordinate_moved["answer"] = {
+            name: [[row[j] for j in coordinate_order] for row in original["answer"][name]]
+            for name in ("M", "R")
+        }
+        variants = [row_only, col_only, both, transposed, transposed_both,
+                    coordinate_moved]
+        for variant in variants:
+            attempts_g8 += 1
+            invariant += int(canonical_key(variant) == key)
+            real += int(verify(variant, variant["answer"])[0])
+        unrelated.append(key)
+    distinct = len(set(unrelated))
+    report["G8_canonical_key"] = {
+        "pass": invariant == attempts_g8 and real == attempts_g8 and distinct == 20,
+        "invariant_relabellings": invariant,
+        "invariant_attempts": attempts_g8,
+        "real_transformations_verified": real,
+        "unrelated_distinct_keys": distinct,
