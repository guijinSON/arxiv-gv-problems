+    doubled_p = _next_supported_prime(2 * shipping["p"])
+    doubled = make_instance(n=doubled_p, blocks=shipping["blocks_count"], seed=314159)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
