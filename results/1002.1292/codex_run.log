+def _central_third(values, p: int) -> tuple[int, int]:
+    values = list(values)
+    width = len(values)
+    total = sum(values) % p
+    mean = total * pow(width, -1, p) % p
+    third = sum(pow((value - mean) % p, 3, p) for value in values) % p
