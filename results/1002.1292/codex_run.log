   720	
   721	def _linear_moment_attack(inst) -> dict:
   722	    p = inst["p"]
   723	    width_inverse = pow((p + 1) // 2, -1, p)
   724	    blocks = []
   725	    for data in sorted(inst["blocks"], key=lambda item: item["id"]):
   726	        c = 1
   727	        a = (data["row1_sum"] - data["row0_sum"]) * width_inverse % p
   728	        if a in (0, c):
   729	            a = 2
   730	        delta = (data["sum_D"] - data["row0_sum"]) * width_inverse % p
   731	        blocks.append({"a": a, "c": c, "delta": delta})
   732	    return {"blocks": blocks}
   733	
   734	
   735	def _boundary_greedy_attack(inst) -> dict:
   736	    p = inst["p"]
   737	    width_inverse = pow((p + 1) // 2, -1, p)
   738	    matrices = [_local_matrix(inst, block_id) for block_id in range(inst["blocks_count"])]
   739	    blocks = []
   740	    for block_id, data in enumerate(sorted(inst["blocks"], key=lambda item: item["id"])):
   741	        ones = [y for y, bit in enumerate(matrices[block_id][0]) if bit]
   742	        ds = sorted(data["D"])
   743	        c = (ds[1] - ds[0]) * pow((ones[1] - ones[0]) % p, -1, p) % p
   744	        if c == 0:
   745	            c = 1
   746	        a = (data["row1_sum"] - data["row0_sum"]) * c * width_inverse % p
   747	        if a in (0, c):
   748	            a = 1 if c != 1 else 2
   749	        delta = (data["sum_D"] - c * data["row0_sum"]) * width_inverse % p
   750	        blocks.append({"a": a, "c": c, "delta": delta})
   751	    return {"blocks": blocks}
