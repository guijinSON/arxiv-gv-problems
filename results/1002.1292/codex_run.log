+def _boundary_greedy_attack(inst) -> dict:
+    p = inst["p"]
+    width_inverse = pow((p + 1) // 2, -1, p)
+    matrices = [_local_matrix(inst, block_id) for block_id in range(inst["blocks_count"])]
