+        "doubled_matrix_side": len(doubled["rows"]),
+        "verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    carried_verifications = 0
+    invariant_failures = []
+    unrelated_keys = []
+    for seed in range(20):
