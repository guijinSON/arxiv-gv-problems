def inv(a,p): return pow(a,-1,p)
def make_D(p,rng):
    h=(p-1)//2; w=h+1
    while 1:
        D={0}
        for x in range(1,h+1): D.add(x if rng.getrandbits(1) else (-x)%p)
        sd=sum(D)%p; mu=sd*inv(w,p)%p
        td=sum(pow((d-mu)%p,3,p) for d in D)%p
