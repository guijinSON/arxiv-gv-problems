+        for column in transformed["columns"]:
+            if column["block"] == block_id:
+                column["y"] = (uc * column["y"] + vc) % p
+        new_a = old["a"] * pow(ur, -1, p) % p
+        new_c = old["c"] * pow(uc, -1, p) % p
