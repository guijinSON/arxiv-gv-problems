   712	def _fixed_degree_attack(inst) -> dict:
   713	    return {
   714	        "blocks": [
   715	            {"a": 1, "c": 2, "delta": 0}
   716	            for _ in range(inst["blocks_count"])
   717	        ]
   718	    }
