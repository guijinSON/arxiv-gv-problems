   449	def _validate_instance_math(inst: dict) -> tuple[bool, str]:
   450	    p = inst.get("p")
   451	    count = inst.get("blocks_count")
   452	    if not _is_int(p) or not _is_prime(p) or p % 3 != 2:
   453	        return False, "instance modulus is not a supported prime"
   454	    if not _is_int(count) or count != len(inst.get("blocks", [])):
   455	        return False, "instance block metadata is inconsistent"
   456	    if len(inst.get("rows", [])) != count * p or len(inst.get("columns", [])) != count * p:
   457	        return False, "instance matrix dimensions are inconsistent"
   458	    if inst.get("factor_width") != count * p:
   459	        return False, "instance factor width is inconsistent"
   460	    width = (p + 1) // 2
   461	    for expected_id, block in enumerate(sorted(inst["blocks"], key=lambda item: item.get("id", -1))):
   462	        if block.get("id") != expected_id:
   463	            return False, "instance block identifiers are inconsistent"
   464	        values = block.get("D")
   465	        if not isinstance(values, list) or len(values) != width or len(set(values)) != width:
   466	            return False, f"block {expected_id} difference-set size is invalid"
   467	        if any(not _is_int(x) or not 0 <= x < p for x in values) or 0 not in values:
   468	            return False, f"block {expected_id} difference-set entries are invalid"
   469	        dset = set(values)
   470	        for x in range(1, p):
   471	            if ((x in dset) + ((-x) % p in dset)) != 1:
   472	                return False, f"block {expected_id} is not skew"
   473	    expected_labels = {(block, value) for block in range(count) for value in range(p)}
   474	    row_labels = {(row.get("block"), row.get("x")) for row in inst.get("rows", [])}
   475	    column_labels = {
   476	        (column.get("block"), column.get("y"))
   477	        for column in inst.get("columns", [])
   478	    }
   479	    if row_labels != expected_labels or len(row_labels) != len(inst["rows"]):
   480	        return False, "instance row labels are inconsistent"
   481	    if column_labels != expected_labels or len(column_labels) != len(inst["columns"]):
   482	        return False, "instance column labels are inconsistent"
   483	    return True, "ok"
