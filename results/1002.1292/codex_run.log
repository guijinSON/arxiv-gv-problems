   782	def _reorder_presentation(inst: dict) -> tuple[dict, dict]:
   783	    transformed = copy.deepcopy(inst)
   784	    row_order = list(reversed(range(len(transformed["rows"]))))
   785	    column_order = list(range(len(transformed["columns"])))
   786	    column_order = column_order[3:] + column_order[:3]
   787	    transformed["rows"] = [transformed["rows"][index] for index in row_order]
   788	    transformed["columns"] = [transformed["columns"][index] for index in column_order]
