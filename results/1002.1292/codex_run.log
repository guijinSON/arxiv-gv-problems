     next_p = _next_supported_prime(p + max(12, p // 2))
     if next_p * blocks > 900:
-        return "cap_bound"
+        # The answer is still tiny here, so this is not an answer-cap boundary.
+        # Beyond this point a larger p merely pads the already-recognised moment
+        # calculation with an even larger displayed matrix; adding more independent
+        # blocks only repeats the same calculation and lengthens the answer.  Neither
+        # is a new hardness axis for this family.
+        return None
     current["n"] = next_p
     return current
 

