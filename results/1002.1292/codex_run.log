   794	def _rename_blocks(inst: dict) -> tuple[dict, dict]:
   795	    transformed = copy.deepcopy(inst)
   796	    count = transformed["blocks_count"]
   797	    mapping = {old: count - 1 - old for old in range(count)}
   798	    for row in transformed["rows"]:
   799	        row["block"] = mapping[row["block"]]
   800	    for column in transformed["columns"]:
   801	        column["block"] = mapping[column["block"]]
