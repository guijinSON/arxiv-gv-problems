+        block["id"] = new_id
+        new_blocks.append(block)
+        new_answers[new_id] = copy.deepcopy(old_answer)
+    transformed["blocks"] = sorted(new_blocks, key=lambda item: item["id"])
+    transformed["answer"] = {"blocks": new_answers}
