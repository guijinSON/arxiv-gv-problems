+        a = (data["row1_sum"] - data["row0_sum"]) * c * width_inverse % p
+        if a in (0, c):
+            a = 1 if c != 1 else 2
+        delta = (data["sum_D"] - c * data["row0_sum"]) * width_inverse % p
+        blocks.append({"a": a, "c": c, "delta": delta})
