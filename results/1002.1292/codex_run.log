+    metadata = {
+        "D": difference_set,
+        "sum_D": sum_d,
+        "third_D": third_d,
+        "row0_sum": row_sums[0],
+        "row1_sum": row_sums[1],
+        "row0_third": third0,
+    }
+    answer = {"a": a, "c": c, "delta": delta}
+    return {"metadata": metadata, "rows": local_rows}, answer
