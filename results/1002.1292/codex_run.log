   274	        sum(y for y, bit in enumerate(local_rows[x]) if bit) % p
   275	        for x in (0, 1)
   276	    ]
   277	    mean0 = row_sums[0] * pow(width, -1, p) % p
   278	    third0 = sum(
   279	        pow((y - mean0) % p, 3, p)
   280	        for y, bit in enumerate(local_rows[0])
   281	        if bit
   282	    ) % p
   283	    metadata = {
   284	        "D": difference_set,
   285	        "sum_D": sum_d,
   286	        "third_D": third_d,
   287	        "row0_sum": row_sums[0],
   288	        "row1_sum": row_sums[1],
   289	        "row0_third": third0,
   290	    }
   291	    answer = {"a": a, "c": c, "delta": delta}
   292	    return {"metadata": metadata, "rows": local_rows}, answer
   293	
   294	
   295	def make_instance(n: int, seed: int = 0, **params) -> dict:
   296	    """Inverse-generate a native minimum-width Mod/Resc factorization."""
   297	    if set(params) != {"blocks"}:
   298	        unknown = sorted(set(params) - {"blocks"})
   299	        detail = "missing blocks" if "blocks" not in params else "unknown parameters: " + ", ".join(unknown)
   300	        raise TypeError(detail)
   301	    blocks = params["blocks"]
   302	    _validate_parameters(n, blocks)
   303	    if not _is_int(seed):
   304	        raise TypeError("seed must be an integer")
   305	
   306	    rng = random.Random(seed)
   307	    used_shapes: set[str] = set()
   308	    raw_blocks = []
   309	    answers = []
   310	    for block_id in range(blocks):
   311	        block, answer = _make_block(n, rng, used_shapes)
   312	        metadata = dict(block["metadata"])
   313	        metadata["id"] = block_id
   314	        raw_blocks.append({"metadata": metadata, "rows": block["rows"]})
   315	        answers.append(answer)
   316	
   317	    row_labels = [(b, x) for b in range(blocks) for x in range(n)]
   318	    column_labels = [(b, y) for b in range(blocks) for y in range(n)]
   319	    rng.shuffle(row_labels)
   320	    rng.shuffle(column_labels)
   321	
   322	    rows = []
   323	    for b, x in row_labels:
   324	        bits = []
   325	        for cb, y in column_labels:
   326	            bits.append(str(raw_blocks[b]["rows"][x][y]) if cb == b else "0")
   327	        rows.append({"block": b, "x": x, "bits": "".join(bits)})
   328	
   329	    return {
   330	        "family": "Affine Mod/Resc Parsimony Inference",
   331	        "p": n,
   332	        "blocks_count": blocks,
   333	        "factor_width": blocks * n,
   334	        "blocks": [block["metadata"] for block in raw_blocks],
   335	        "columns": [
   336	            {"block": b, "y": y} for b, y in column_labels
   337	        ],
   338	        "rows": rows,
   339	        "answer": {"blocks": answers},
   340	    }
   341	
