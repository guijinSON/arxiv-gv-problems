+    attack_attempts = {name: 0 for name in attack_names}
+    for seed in range(100, 108):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        reference_answer, stats = _reference_csp(inst)
