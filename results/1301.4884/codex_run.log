+_TEMPLATES = (
+    (_F(-1), _F(0), _F(0), _F(0)),
+    (_F(0), _F(0), _F(-1), _F(0)),
+    (_HALF * -1, _HALF * -1, _HALF * -1, _HALF * -1),
+    (_HALF * -1, _HALF * -1, _HALF * -1, _HALF),
