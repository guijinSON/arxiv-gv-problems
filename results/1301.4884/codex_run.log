+def _j(v: tuple[Fraction, ...]) -> tuple[Fraction, ...]:
+    """Quarter turn: simultaneous multiplication of both complex coordinates by i."""
+
+    x, y, z, w = v
+    return -y, x, -w, z
+
+
+def _j_power(v: tuple[Fraction, ...], power: int) -> tuple[Fraction, ...]:
+    for _ in range(power % 4):
+        v = _j(v)
+    return v
+
+
