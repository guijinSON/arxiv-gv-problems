+
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Relative to the six 24-cell fiber templates, the selected quarter-turn "
+    "orbits have one common Hopf phase."
+)
+PLACEBO_HINT = (
+    "Careful organization of the six rational candidate lists can help avoid "
