/bin/bash -lc "python3 - <<'PY'
from fractions import Fraction as F
from itertools import product

def I(v):
    x,y,z,w=v
    return (-y,x,-w,z)
def orbit(v):
    out=[]
    for _ in range(4): out.append(v); v=I(v)
    return out

def hopf(v):
    x,y,z,t=v
    # w=x+iy, z=z+it; 2*w*conj(z)=(2(xz+yt),2(yz-xt)), |z|2-|w|2
    return (2*(x*z+y*t),2*(y*z-x*t),z*z+t*t-x*x-y*y)
pts=[]
for i in range(4):
  for s in (-1,1):
    v=[F(0)]*4;v[i]=F(s);pts.append(tuple(v))
for ss in product((-1,1), repeat=4):pts.append(tuple(F(s,2) for s in ss))
seen=set(); groups=[]
for v in pts:
  if v in seen:continue
  o=orbit(v); seen.update(o); groups.append((v,hopf(v),o))
print('groups',len(groups))
for i,(v,h,o) in enumerate(groups):print(i,v,h,o)
# check union dot max
allp=[p for _,_,o in groups for p in o]
print(len(allp),len(set(allp)),max(sum(a*b for a,b in zip(allp[i],allp[j])) for i in range(24) for j in range(i)))
# compatibility phase equal vs unequal rational pythagorean
def phase(t):return ((1-t*t)/(1+t*t),2*t/(1+t*t))
def mul(v,d):
 a,b=d;x,y,z,w=v
 return (a*x-b*y,b*x+a*y,a*z-b*w,b*z+a*w)
def compatible(v,w):
 return all(sum(a*b for a,b in zip(p,q))<=F(1,2) for p in orbit(v) for q in orbit(w))
for ti in [F(1,10),F(2,10),F(3,10)]:
 for tj in [F(1,10),F(2,10),F(3,10)]:
  good=[]
  for i in range(6):
   for j in range(i):
    if hopf(groups[i][0])==tuple(-x for x in hopf(groups[j][0])):continue
    good.append(compatible(mul(groups[i][0],phase(ti)),mul(groups[j][0],phase(tj))))
  print(ti,tj,all(good),sum(good),len(good))
