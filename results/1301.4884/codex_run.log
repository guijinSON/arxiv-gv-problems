+def _compatible_counted(
+    a: tuple[Fraction, ...], b: tuple[Fraction, ...], counter: list[int]
+) -> bool:
+    for x in _orbit(a):
+        for y in _orbit(b):
+            counter[0] += 7  # four products and three additions
+            if _dot(x, y) > _HALF:
+                return False
