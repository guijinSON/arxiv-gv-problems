index 9eca9d7728f91b432ed0ab1ecc43f5ed6012c6ff..641f2313885d0ad111a0bb6af6c052b7bfd883f2
--- a/g9_hinted/gen_2004_10596.py
+++ b/g9_hinted/gen_2004_10596.py
@@ -81,20 +81,8 @@
 # haystack grows; marker_count + witness_count additional graph vertices form
 # the invariant gadget.
