+        ),
+    }
+
+    doubled_parameters = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_parameters["n"] *= 2
+    doubled = make_instance(seed=707, **doubled_parameters)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
