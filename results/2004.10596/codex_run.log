+        "Track B: the paper's Sections 4.2, 5, and 7 enumerate C(n,k) vertex "
+        "sets to synthesize the oracle and use O(sqrt(C(n,k)/m)) Grover "
+        "iterations, while exact branch-and-bound is the disclosed classical "
+        "reference algorithm; selftest records its measured nodes, edge "
+        "intersections, and wall time at the shipping preset, whereas the "
+        "parity invariant needs fewer than 300 exact word operations."
+    ),
+    "max_answer_tokens": 10,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
