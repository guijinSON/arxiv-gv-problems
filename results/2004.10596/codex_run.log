p='gen_2004_10596.py'; s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s);s.loader.exec_module(g)
for n in (128,160,192,256,384,512):
 par=dict(n=n,k=8,marker_count=8,witness_count=4,edge_num=1,edge_den=4)
 sums={x:0 for x in ('degree','greedy','restart','spectral','marker')}; nodes=[]; times=[]
 for seed in range(6100,6108):
  inst=g.make_instance(seed=seed,**par)
  fs={'degree':g._attack_degree(inst),'greedy':g._attack_greedy(inst),'restart':g._attack_random_restart(inst,random.Random(seed),256),'spectral':g._attack_spectral(inst,random.Random(seed+2)),'marker':g._attack_marker_common(inst)}
  for name,a in fs.items(): sums[name]+=g.verify(inst,a)[0]
  t=time.perf_counter(); a,st=g._reference_branch_and_bound(inst);times.append(time.perf_counter()-t);nodes.append(st['nodes'])
 print(n,sums,'nodes',sum(nodes)//8,min(nodes),max(nodes),'sec',round(sum(times)/8,4))
