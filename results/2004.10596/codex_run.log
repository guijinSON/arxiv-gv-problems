+    # Read one exact degree per vertex, identify the repeated row, then XOR the
+    # marker rows in 64-bit words and enumerate the k set bits.
+    words = (inst["vertex_count"] + 63) // 64
+    return (
+        inst["vertex_count"]
+        + inst["witness_count"]
+        + (inst["marker_count"] - 1) * words
+        + inst["k"]
+    )
+
