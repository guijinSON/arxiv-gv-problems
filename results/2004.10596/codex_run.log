414:i=m.make_instance(**D[m.SHIPPING_DIFFICULTY], seed=0)
558:          "       PROBLEM_PROFILE['reduction']['citation']).  See STEP 0.")
569:params = m.DIFFICULTY[m.SHIPPING_DIFFICULTY]

