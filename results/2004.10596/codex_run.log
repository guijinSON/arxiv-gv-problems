+
+def _validate(n, k, marker_count, witness_count, edge_num, edge_den):
+    values = {
+        "n": n, "k": k, "marker_count": marker_count,
+        "witness_count": witness_count, "edge_num": edge_num,
+        "edge_den": edge_den,
+    }
+    for name, value in values.items():
+        if not _is_int(value):
