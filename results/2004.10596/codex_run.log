+    transformed["adjacency_hex"] = encoded
+    transformed["hex_width"] = width
+    transformed["degrees"] = [row.bit_count() for row in new_rows]
+    transformed["answer"] = sorted(old_to_new[v] for v in inst["answer"])
+    return transformed
+
