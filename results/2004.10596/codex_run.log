+    },
+    "easy": {
+        "n": 96, "k": 8, "marker_count": 8, "witness_count": 4,
+        "edge_num": 1, "edge_den": 4,
+    },
+    "medium": {
+        "n": 128, "k": 8, "marker_count": 8, "witness_count": 4,
+        "edge_num": 1, "edge_den": 4,
+    },
+    "hard": {
+        "n": 192, "k": 8, "marker_count": 8, "witness_count": 4,
+        "edge_num": 1, "edge_den": 4,
+    },
+}
+
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The repeated low-degree neighborhood is a GF(2) parity probe on the "
+    "adjacency rows."
+)
+PLACEBO_HINT = (
+    "The fixed-width hexadecimal rows reward careful use of the stated bit "
