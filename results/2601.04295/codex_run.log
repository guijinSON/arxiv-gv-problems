+        "at the shipping preset, while binary location of the exceptional 60-point "
+        "cell followed by Theorem 1 uses at most 5*ceil(log2(n))+48 exact operations."
+    ),
+    "max_answer_tokens": 24,
+}
+
+NATIVE = {
