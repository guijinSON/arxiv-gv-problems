/bin/bash -lc "python3 - <<'PY'
import ast, importlib.util, inspect, json, os, re
module_path='rejected_gen_2601_04295.py'
spec=importlib.util.spec_from_file_location('rejected',module_path)
m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
assert m.TRACK in {'A','B'}
assert list(m.DIFFICULTY)==['demo','easy','medium','hard']
assert m.SHIPPING_DIFFICULTY"'!='"'demo'
for preset,p in m.DIFFICULTY.items():
 for seed in (0,1,7,99991):
  i=m.make_instance(seed=seed,**p)
  assert m.verify(i,i['answer'])==(True,'ok')
  assert json.loads(json.dumps(i['answer']))==i['answer']
  tagged='<answer>'+json.dumps(i['answer'],separators=(',',':'))+'</answer>'
  assert m.parse_answer('prose\\n"'```'"\\n'+tagged+'\\n"'```'"')==i['answer']
assert 'inst[\"answer\"]' not in inspect.getsource(m.verify)
report=json.load(open('selftest_report.json'))
