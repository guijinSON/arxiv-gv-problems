+    operations = 0
+    for first in block:
+        for second in block:
+            if first != second:
+                counts[(second - first) % modulus] += 1
+                operations += 1
+    peak = max(counts.values())
+    operations += len(counts)
+    candidates = sorted(step for step, count in counts.items() if count == peak)
+    if len(candidates) == 2 and sum(candidates) == modulus:
