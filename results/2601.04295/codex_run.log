The closed-axis rerun returned the definitive result: all 9 oracle calls solved—3/3 at each of `easy`, `medium`, and `hard`—so the modular family fails H on Track B despite passing every local gate. Track A was already unavailable from the paper itself. I’m now preserving the attempted generator under the required `rejected_gen_…` name and writing a quantitative rejection with the theorem, mechanical costs, compact-route costs, and oracle evidence.
exec
/bin/bash -lc "python3 - <<'PY'
import json, time
import gen_2601_04295 as g
for name in ('easy','medium','hard'):
    ops=[]; compact=[]; wall=[]
    for seed in range(8100,8108):
        i=g.make_instance(seed=seed,**g.DIFFICULTY[name])
        t=time.perf_counter(); a,o=g._direct_scan_reference(i); wall.append(time.perf_counter()-t); ops.append(o)
        ca,co=g._compact_reference(i); compact.append(co)
        assert g.verify(i,a)[0] and g.verify(i,ca)[0]
    print(name,'blocks',len(i['blocks']),'direct_ops',min(ops),sum(ops)/8,max(ops),'wall_mean',sum(wall)/8,'compact',min(compact),sum(compact)/8,max(compact),'bound',g._compact_operation_bound(i))
rows=[json.loads(x) for x in open('llm_loop_transcript.jsonl') if x.strip()]
print('oracle')
for r in rows:
    print(r['preset'],r['model'],r['seed'],r['solved'],r['elapsed_sec'],r['verify_reason'],(r.get('reply') or '')[:140])
print('meta',json.load(open('.meta.json'))['harden_verdict'])
