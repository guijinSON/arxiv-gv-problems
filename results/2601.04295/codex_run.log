+    answer_chars, answer_tokens, answer_elements = _json_answer_size(shipping["answer"])
+    arms = {name: dict(G9_ORACLE_RESULTS[name]) for name in ("bare", "hinted", "placebo")}
+    hinted_rate = (arms["hinted"]["solved"] / arms["hinted"]["attempts"]
