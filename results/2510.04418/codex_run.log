+
+DIFFICULTY = {
+    "demo": {"n": 5, "masks_per_weight": 2},
+    "easy": {"n": 13, "masks_per_weight": 12},
+    "medium": {"n": 23, "masks_per_weight": 32},
+    "hard": {"n": 31, "masks_per_weight": 64},
+}
+
+SHIPPING_DIFFICULTY = "hard"
