+    answer_elements = max(_answer_atoms(json.loads(blob)) for blob in answer_blobs)
+    route_operations = max(route_costs)
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and route_operations <= 1000
