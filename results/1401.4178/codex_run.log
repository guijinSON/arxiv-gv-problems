from time import perf_counter

def walecki(n):
    q=n-1; r=q//2; out=[]
    for s in range(r):
        c=[q,s%q]
        for d in range(1,r+1):
            c.append((s-d)%q)
            if d<r:
                c.append((s+d)%q)
        out.append(c)
    return out

def check(n,cs):
    es=[]
    for c in cs:
        es += [tuple(sorted((c[i],c[(i+1)%n]))) for i in range(n)]
    return len(es),len(set(es)),len(cs)*n
for n in (5,7,23):
    cs=walecki(n)
    print(n,check(n,cs),len(cs),sum(map(len,cs)))
loops=200_000
st=perf_counter()
for _ in range(loops): walecki(23)
el=perf_counter()-st
print('loops',loops,'sec',el,'us_each',el/loops*1e6)
