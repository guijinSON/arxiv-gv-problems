+        elif missing == 1:
+            values[1] = values[2] + values[3] - values[0]  # type: ignore[operator]
+        elif missing == 2:
+            values[2] = values[0] + values[1] - values[3]  # type: ignore[operator]
+        else:
+            values[3] = values[0] + values[1] - values[2]  # type: ignore[operator]
