+def _lll_embedding_attack(inst: dict) -> tuple[list[int], int, int]:
+    """Run a fixed-cardinality Lagarias-Odlyzko lattice embedding."""
+    n, dimension = inst["n"], inst["n"] + 2
+    multiplier = 1 << math.ceil(math.log2(n + 1))
+    basis: list[list[int]] = []
+    for i, value in enumerate(inst["encoded_weights"]):
+        row = [0] * dimension
+        row[i], row[-2], row[-1] = 2, multiplier * value, multiplier
+        basis.append(row)
+    basis.append([1] * n + [multiplier * inst["encoded_target"],
+                            multiplier * inst["k"]])
+    precision = max(80, int(inst["weight_bits"] * 0.61) + 55)
+    reduced, swaps, operations = _bounded_lll(basis, precision)
+    for vector in reduced:
+        decoded = _decode_lattice_vector(vector, inst)
+        if decoded is not None:
+            return decoded, swaps, operations
+    fallback, extra = _outlier_mean_attack(inst)
+    return fallback, swaps, operations + extra
 
