-    return random_candidate(inst, random.Random(0x11A + sum(weights) % 1009)), loops
+            old_mu, old_previous, old_current = (
+                mu[k][k - 1], norms[k - 1], norms[k])
+            new_previous = old_current + old_mu * old_mu * old_previous
+            if not new_previous:
+                break
+            new_mu = old_mu * old_previous / new_previous
+            new_current = old_current * old_previous / new_previous
+            reduced[k], reduced[k - 1] = reduced[k - 1], reduced[k]
+            for j in range(k - 1):
+                mu[k][j], mu[k - 1][j] = mu[k - 1][j], mu[k][j]
+            mu[k][k - 1] = new_mu
+            for i in range(k + 1, m):
+                old_i_previous, old_i_current = mu[i][k - 1], mu[i][k]
+                new_i_current = old_i_previous - old_mu * old_i_current
+                mu[i][k] = new_i_current
+                mu[i][k - 1] = old_i_current + new_mu * new_i_current
+            norms[k - 1], norms[k] = new_previous, new_current
+            swaps += 1
+            operations += dimension + m
+            k = max(1, k - 1)
+    return reduced, swaps, operations
 
 
