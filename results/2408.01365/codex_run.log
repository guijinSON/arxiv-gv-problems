    def _num(d, k):
        v = d.get(k)
        return v if isinstance(v, (int, float)) and not isinstance(v, bool) else None
    over = []
    for field, capkey, default in (("answer_chars", "chars", 2000),
                                   ("answer_elements", "elements", 256),
                                   ("intended_route_operations", "operations", 300)):
        got = _num(g9, field)
