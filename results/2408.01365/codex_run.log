+def _permute_instance(inst: dict, order: list[int]) -> dict:
+    """Reorder ordinary rows and carry the known witness through the symmetry."""
+    n = inst["n"]
+    if sorted(order) != list(range(n)):
+        raise ValueError("order is not a permutation")
+    old_to_new = [0] * n
+    for new, old in enumerate(order):
+        old_to_new[old] = new
+    old_items = set(inst["answer"][:-1])
+    new_items = sorted(old_to_new[old] for old in old_items)
+    moved = _assemble_instance(
+        [inst["encoded_weights"][old] for old in order],
+        inst["encoded_target"], inst["k"], new_items, inst["seed"])
+    moved["weight_bits"] = inst["weight_bits"]
+    return moved
 
 
