+def _initial_gso(basis: list[list[int]], precision: int
+                 ) -> tuple[list[list[Decimal]], list[Decimal]]:
+    """Decimal Gram-Schmidt; precision exceeds twice the input bit length."""
+    m, dimension = len(basis), len(basis[0])
+    mu = [[Decimal(0) for _ in range(m)] for _ in range(m)]
+    orthogonal: list[list[Decimal]] = []
+    norms: list[Decimal] = []
+    with localcontext() as context:
+        context.prec = precision
+        for i in range(m):
+            original = [Decimal(value) for value in basis[i]]
+            vector = list(original)
+            for j in range(i):
+                dot = sum(original[p] * orthogonal[j][p]
+                          for p in range(dimension))
+                coefficient = dot / norms[j]
+                mu[i][j] = coefficient
+                vector = [vector[p] - coefficient * orthogonal[j][p]
+                          for p in range(dimension)]
+            norm = sum(value * value for value in vector)
+            if not norm:
+                raise ArithmeticError("dependent lattice basis")
+            orthogonal.append(vector)
+            norms.append(norm)
     return mu, norms
 
 
