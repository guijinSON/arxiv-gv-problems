NOTES: str = r"""
Definition. Section 2 fixes the classifier sign convention, strict hinge
activation y*w*x<beta, and Debuggable-Lin as deletion followed by SGD
retraining. Section 4 fixes one epoch and an input order. Theorem 4.4, proved in
Appendix B.1, gives the one-dimensional beta<0 reduction used here. Answers
list retained rows; this is equivalent to listing their deleted complement.

Step-0 algorithm check. Theorem 4.1 gives the linear-time GTA algorithm for
linear loss, and Theorem 4.2 extends it to d=1 hinge losses when beta>=0. This
module instead fixes beta=-1, d=1, alpha=eta=1 and the adversarial order of
Theorem 4.4. Its source problem is fixed-size SUBSET SUM: meet-in-the-middle is
exponential and target-indexed dynamic programming is pseudopolynomial. Lattice
reduction is a polynomial heuristic, not a certificate-producing algorithm
guaranteed on this distribution. Selftest runs a bounded LLL embedding and a
bounded exact branch-and-bound recurrence. The theorem is worst-case, so their
distribution-specific failures are empirical evidence, not an average-case
theorem.

Certificate production. make_instance samples n distinct uniform positive
integers, samples k row positions uniformly, and takes their sum as the target
before constructing any SGD data. Planted and non-planted ordinary rows thus
have the same marginal distribution. Appendix B.1 maps them to
x_i=2/3+a_i/(3A), control x_a=1+1/(6A), and
w0=-1-2k/3-t/(3A). The planted rows and control finish at 1/(6A)>0. The
stored witness is never found by solving the generated instance.

Verification. The problem restricts answers to k ordinary rows plus the
control, a witness form guaranteed by Appendix B.1. verify performs the exact
integer equality check and independently replays all retained hinge-SGD steps
with Fraction. It never reads inst['answer'] and accepts every valid witness in
the declared language.

Attacks. The panel includes mean-closeness outliers, largest-fit greedy,
uniform restarts, a nearest-average single-swap ansatz, a Lagarias-Odlyzko-style
fixed-cardinality lattice embedding with bounded LLL, and exact cardinality
branch-and-bound. Difficulty grows by adding ordinary rows while k and the
answer length stay fixed.

Canonicalization. Any permutation of ordinary rows, with the witness carried
through it and the control kept last, preserves Appendix B.1's problem.
canonical_key sorts the distinct encoded weights and keeps the target, k and
hyperparameters. It is complete for that row-permutation symmetry, but not for
more general affine equivalences between unrelated subset-sum encodings.
""".strip()

_ANSWER_RE = re.compile(
    r"<answer\b[^>]*>(.*?)</answer\s*>", re.IGNORECASE | re.DOTALL)


def _validate_parameters(n: int, weight_bits: int, k: int) -> None:
    for name, value in (("n", n), ("weight_bits", weight_bits), ("k", k)):
        if isinstance(value, bool) or not isinstance(value, int):
            raise TypeError(f"{name} must be an integer")
    if n < 5 or weight_bits < 5:
        raise ValueError("n and weight_bits must each be at least 5")
    if k < 1 or k >= n:
        raise ValueError("k must satisfy 1 <= k < n")
    if k + 1 > 256:
        raise ValueError("k+1 exceeds the 256-atom answer cap")


def _fraction(pair: list[int]) -> Fraction:
    return Fraction(pair[0], pair[1])


def _assemble_instance(weights: list[int], target: int, k: int,
                       answer_items: list[int], seed: int) -> dict:
    n = len(weights)
    total = sum(weights)
    denominator = 6 * total
    item_numerators = [4 * total + 2 * value for value in weights]
    rows = [
        {"id": i, "x": [item_numerators[i], denominator], "y": 1,
         "kind": "ordinary"}
        for i in range(n)
    ]
    rows.append({"id": n, "x": [denominator + 1, denominator], "y": 1,
                 "kind": "control"})
    w0_numerator = -((4 * k + 6) * total + 2 * target)
    return {
        "family": "fixed_cardinality_hinge_sgd_debugging",
        "paper": "arXiv:2408.01365",
        "theorem": "Theorem 4.4 / Appendix B.1",
        "n": n,
        "k": k,
        "seed": seed,
        "dimension": 1,
        "epochs": 1,
        "loss": "hinge-like",
        "alpha": [1, 1],
        "beta": [-1, 1],
        "learning_rate": [1, 1],
        "w0": [w0_numerator, denominator],
        "test_x": [1, 1],
        "test_y": 1,
        "training_rows": rows,
        "common_denominator": denominator,
        "encoded_weights": list(weights),
        "encoded_target": target,
        "answer": sorted(answer_items) + [n],
    }


def make_instance(n: int, seed: int = 0, **params) -> dict:
    """Inverse-generate a fixed-size subset, then apply Appendix B.1's map."""
    weight_bits = params.pop("weight_bits", None)
    k = params.pop("k", None)
    if params:
        raise TypeError(f"unexpected parameters: {sorted(params)}")
    _validate_parameters(n, weight_bits, k)
    if isinstance(seed, bool) or not isinstance(seed, int):
        raise TypeError("seed must be an integer")

    rng = random.Random(seed)
    lower, upper = 1 << (weight_bits - 1), 1 << weight_bits
    weights: list[int] = []
    seen: set[int] = set()
    while len(weights) < n:
        value = rng.randrange(lower, upper)
        if value not in seen:
            seen.add(value)
            weights.append(value)
    answer_items = sorted(rng.sample(range(n), k))
    target = sum(weights[i] for i in answer_items)
    inst = _assemble_instance(weights, target, k, answer_items, seed)
    inst["weight_bits"] = weight_bits
    full_final, _ = _replay(inst, list(range(n + 1)))
    if full_final >= 0:
        raise AssertionError("the full model unexpectedly predicts +1")
    return inst


def _format_rational(pair: list[int]) -> str:
    return f"{pair[0]}/{pair[1]}"


def render(inst: dict) -> str:
    """Render the full exact SGD problem and parseable output contract."""
    n, k = inst["n"], inst["k"]
    lines = [
        "ONE-EPOCH HINGE-SGD DATA DEBUGGING", "",
        "A one-dimensional binary linear classifier has rational parameter w.",
        "On input x it predicts +1 when w*x >= 0 and predicts -1 otherwise.",
        "Every training row below has label y=+1. Training uses exactly one",
        "epoch, learning rate eta=1, and hinge-like loss with alpha=1 and",
        "intercept beta=-1. Start from w0. Visit retained rows once in increasing",
        "row-ID order, skipping rows not retained. A retained row is active",
        "exactly when w*x < -1 (strict inequality). If active, update w := w+x;",
        "otherwise leave w unchanged. Use exact rational arithmetic throughout.", "",
        f"Initial parameter w0 = {_format_rational(inst['w0'])}",
        "Test instance: x_test=1 with desired label +1.",
        "The model trained on all displayed rows predicts -1 on the test point.", "",
        f"There are {n} ordinary rows (IDs 0 through {n - 1}) and one control",
        f"row (ID {n}). Fractions use numerator/denominator; use their exact",
        "values even when not reduced. Training rows in their fixed order:",
    ]
    for row in inst["training_rows"]:
        lines.append(f"  {row['id']}: x={_format_rational(row['x'])}  "
                     f"y=+1  type={row['kind']}")
    lines += [
        "", f"Find a retained subset of exactly {k + 1} rows for which the",
        "retrained classifier predicts +1 on x_test=1. It must contain exactly",
        f"{k} ordinary rows and control row {n}. IDs must be distinct and strictly",
        "increasing. IDs are zero-based; answer order does not alter training order.",
        "", "Give your final answer inside <answer></answer> tags as exactly",
        f"{k + 1} comma-separated base-10 row IDs, with no brackets.",
        f"Example syntax only: <answer>{', '.join(map(str, list(range(k)) + [n]))}</answer>",
        "Output nothing else inside the tags.",
    ]
    statement = "\n".join(lines)
    if os.environ.get("GV_HINT_MODE") == "structural":
        statement += "\n\nHint: " + STRUCTURAL_HINT
    elif os.environ.get("GV_HINT_MODE") == "placebo":
        statement += "\n\nHint: " + PLACEBO_HINT
    return statement


def parse_answer(text: str) -> object | None:
    """Extract a tagged comma-separated integer list; return None on garbage."""
    if not isinstance(text, str):
        return None
    match = _ANSWER_RE.search(text)
    if not match:
        return None
    body = match.group(1).strip()
    if body.startswith("```") and body.endswith("```"):
        pieces = body.splitlines()
        if len(pieces) >= 3:
            body = "\n".join(pieces[1:-1]).strip()
    if body.startswith("[") and body.endswith("]"):
        body = body[1:-1].strip()
    if not body:
        return []
    fields = [field.strip() for field in body.split(",")]
    if any(not re.fullmatch(r"[+-]?\d+", field) for field in fields):
        return None
    try:
        return [int(field, 10) for field in fields]
    except (TypeError, ValueError):
        return None


def _replay(inst: dict, retained: list[int]) -> tuple[Fraction, int]:
    keep = set(retained)
    w, beta = _fraction(inst["w0"]), _fraction(inst["beta"])
    active = 0
    for row in inst["training_rows"]:
        if row["id"] not in keep:
            continue
        x, y = _fraction(row["x"]), row["y"]
        if y * w * x < beta:
            w += (_fraction(inst["learning_rate"])
                  * _fraction(inst["alpha"]) * y * x)
            active += 1
    return w, active


def verify(inst: dict, answer: object) -> tuple[bool, str]:
    """Accept any valid retained-row witness; never inspect inst['answer']."""
    n, k = inst["n"], inst["k"]
    if not isinstance(answer, list):
        return False, "answer must be a list of row IDs"
    if not answer:
        return False, "answer is empty"
    if len(answer) != k + 1:
        return False, f"wrong length: expected {k + 1}, got {len(answer)}"
    for position, value in enumerate(answer):
        if isinstance(value, bool) or not isinstance(value, int):
            return False, f"entry {position} is not an integer row ID"
        if value < 0 or value > n:
            return False, f"row ID {value} is outside 0..{n}"
    if len(set(answer)) != len(answer):
        return False, "a row ID is repeated"
    if any(answer[i] >= answer[i + 1] for i in range(len(answer) - 1)):
        return False, "row IDs are not in strictly increasing order"
    if answer[-1] != n:
        return False, f"mandatory control row {n} is missing"
    encoded_sum = sum(inst["encoded_weights"][i] for i in answer[:-1])
    if encoded_sum != inst["encoded_target"]:
        return False, "selected ordinary rows violate the encoded target equality"
    final_w, active = _replay(inst, answer)
    if final_w * _fraction(inst["test_x"]) < 0:
        return False, "exact SGD replay still predicts -1 on the test point"
    if active != k + 1:
        return False, f"exact replay activated {active} rows instead of {k + 1}"
    return True, "ok"


def random_candidate(inst: dict, rng: random.Random) -> object:
    """Uniformly sample the statement-implied fixed-size candidate language."""
    if not isinstance(rng, random.Random):
        raise TypeError("rng must be random.Random")
    return sorted(rng.sample(range(inst["n"]), inst["k"])) + [inst["n"]]


def search_space(inst: dict) -> int | None:
    return math.comb(inst["n"], inst["k"])


def enumerate_all(inst: dict) -> int | None:
    """Count all witnesses exactly when at most two million candidates exist."""
    if search_space(inst) > 2_000_000:
        return None
    target, weights, count = inst["encoded_target"], inst["encoded_weights"], 0
    for chosen in itertools.combinations(range(inst["n"]), inst["k"]):
        count += int(sum(weights[i] for i in chosen) == target)
    return count


def canonical_key(inst: dict) -> str:
    """Canonical under arbitrary permutations of the ordinary training rows."""
    payload = {
        "family": inst["family"], "n": inst["n"], "k": inst["k"],
        "weights": sorted(inst["encoded_weights"]),
        "target": inst["encoded_target"], "alpha": inst["alpha"],
        "beta": inst["beta"], "eta": inst["learning_rate"],
        "epochs": inst["epochs"],
    }
    blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(blob).hexdigest()


def escalate(params: dict) -> dict | str | None:
    """Grow the row haystack and coefficient entropy at fixed answer length."""
    if not isinstance(params, dict) or set(params) != {"n", "weight_bits", "k"}:
        return None
    _validate_parameters(params["n"], params["weight_bits"], params["k"])
    return {"n": params["n"] + 24,
            "weight_bits": params["weight_bits"] + 16, "k": params["k"]}

