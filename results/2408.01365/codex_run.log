_REDUCTION_CITATION = (
    "Section 4, Lemma 4.1 (I maps to (sum(I)/2, sum(I)/2, "
    "-i_n, ..., -i_1)); Section 5, Theorem 5.4 (an SP partition is an "
    "NP certificate)"
)

