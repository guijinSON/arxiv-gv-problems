def random_candidate(inst: dict, rng: random.Random) -> object:
    """Uniformly sample the statement-implied fixed-size candidate language."""
    if not isinstance(rng, random.Random):
        raise TypeError("rng must be random.Random")
    return sorted(rng.sample(range(inst["n"]), inst["k"])) + [inst["n"]]


def search_space(inst: dict) -> int | None:
    return math.comb(inst["n"], inst["k"])


def enumerate_all(inst: dict) -> int | None:
    """Count all witnesses exactly when at most two million candidates exist."""
    if search_space(inst) > 2_000_000:
        return None
    target, weights, count = inst["encoded_target"], inst["encoded_weights"], 0
    for chosen in itertools.combinations(range(inst["n"]), inst["k"]):
        count += int(sum(weights[i] for i in chosen) == target)
    return count


def canonical_key(inst: dict) -> str:
    """Canonical under arbitrary permutations of the ordinary training rows."""
    payload = {
        "family": inst["family"], "n": inst["n"], "k": inst["k"],
        "weights": sorted(inst["encoded_weights"]),
        "target": inst["encoded_target"], "alpha": inst["alpha"],
        "beta": inst["beta"], "eta": inst["learning_rate"],
        "epochs": inst["epochs"],
    }
    blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(blob).hexdigest()


def escalate(params: dict) -> dict | str | None:
    """Grow the row haystack and coefficient entropy at fixed answer length."""
    if not isinstance(params, dict) or set(params) != {"n", "weight_bits", "k"}:
        return None
    _validate_parameters(params["n"], params["weight_bits"], params["k"])
    return {"n": params["n"] + 24,
            "weight_bits": params["weight_bits"] + 16, "k": params["k"]}

