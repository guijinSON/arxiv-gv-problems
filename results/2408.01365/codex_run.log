def enumerate_all(inst: dict) -> int | None:
    """Count all witnesses exactly when at most two million candidates exist."""
    if search_space(inst) > 2_000_000:
        return None
    target, weights, count = inst["encoded_target"], inst["encoded_weights"], 0
    for chosen in itertools.combinations(range(inst["n"]), inst["k"]):
        count += int(sum(weights[i] for i in chosen) == target)
    return count


def canonical_key(inst: dict) -> str:
    """Canonical under arbitrary permutations of the ordinary training rows."""
    payload = {
        "family": inst["family"], "n": inst["n"], "k": inst["k"],
        "weights": sorted(inst["encoded_weights"]),
        "target": inst["encoded_target"], "alpha": inst["alpha"],
        "beta": inst["beta"], "eta": inst["learning_rate"],
        "epochs": inst["epochs"],
