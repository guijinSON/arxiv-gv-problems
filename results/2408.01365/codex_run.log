   271	\section{Preliminaries and Problem Definition}
   272	\textbf{Linear classifiers.} Formally, a (binary) linear classifier is a function $\lambda_\mathbf{w}:\mathbb{R}^d\rightarrow\{-1,1\}$, where $d$ is called its \emph{dimension} and $\mathbf{w}\in \mathbb{R}^{d}$ its parameter. Without loss of generality, the bias term of a linear classifier is set as zero in this paper. All vectors in this paper are assumed to be \emph{column} vectors. For an input $\mathbf{x}$, the value of $\lambda_\mathbf{w}$ is defined as
   273	\begin{equation*}
   274	\lambda_\mathbf{w}(\mathbf{x})=\begin{cases}
   275	    1 ~&\text{if} ~ \mathbf{w}^\top \mathbf{x} \ge 0\\
   276	   -1 ~&\text{otherwise.}
   277	\end{cases}
   278	\end{equation*}
   279	We denote the class of linear models as $\Lambda$.
   280	
   281	\textbf{Training data.} 
   282	A \textit{training sample} is a pair $(\mathbf{x},y)$ in which $\mathbf{x}\in \mathbb{R}^d$ is the input and $y\in \{-1,1\}$ is the label of $\mathbf{x}$. 
   283	The \textit{training data} is a multiset of training samples.
   284	\warning{We employ $\textbf{w}\xrightarrow{T}\textbf{w}'$ to denote that the parameter $\textbf{w}'$ is obtained by training the parameter $\textbf{w}$ on the training data $T$, and employ $\textbf{w}\xrightarrow{(\textbf{x},y)}\textbf{w}'$ to denote that $\textbf{w}'$ is obtained by training $\textbf{w}$ on the training sample $(\textbf{x},y)$.}
   285	% The class of all training data $T$ is denoted as $\mathcal{T}$.
   286	
   287	\textbf{Loss functions and learning rates.} 
   288	Binary linear classifiers typically use unary functions on $y\mathbf{w}^\top\mathbf{x}$ as their loss functions \cite{loss-survey}.
   289	Therefore we only consider loss functions of the form $\mathcal{L}: y\mathbf{w}^\top\mathbf{x} \mapsto \mathbb{R}$ for the rest of the paper. 
   290	
   291	The \textit{linear} loss is in the form of 
   292	\begin{equation*}
   293	    \mathcal{L}_\texttt{lin}(y\mathbf{w}^\top\mathbf{x})=-\alpha (y\mathbf{w}^\top \mathbf{x} + \beta).
   294	\end{equation*}
   295	
   296	The \textit{hinge-like} loss function is defined as the following form
   297	\begin{equation*}
   298	    \mathcal{L}_\texttt{hinge}(y\mathbf{w}^\top\mathbf{x}) = \begin{cases}
   299	        -\alpha (y\mathbf{w}^\top\mathbf{x} - \beta), & y\mathbf{w}^\top\mathbf{x}<\beta\\
   300	        0, & \text{otherwise.}
   301	    \end{cases}
   302	\end{equation*}
   303	We call $\beta$ as the \emph{interception} of $\mathcal{L}_\texttt{hinge}$.
   304	We represent the learning rate of a model using a vector $\boldsymbol{\eta}=(\eta_1,\dots,\eta_{d})$, where $\eta_i \ge 0$ and each parameter $w_i$ can be updated with the corresponding learning rate $\eta_i$.
   305	
   306	\textbf{Stochastic gradient descent.}
   307	The stochastic gradient descent (SGD) method updates parameter $\mathbf{w}$ from its initial value $\mathbf{w}^{(0)}$ through several epochs.
   308	During each epoch, the SGD goes through the entire set of training samples in some training order through several iterations. 
   309	The training order is defined as a sequence of training samples, in the form of $(\mathbf{x}_1,y_1)\dots (\mathbf{x}_n,y_n)$. For $1\le i<j\le n$, $(\mathbf{x}_i,y_i)$ is considered before $(\mathbf{x}_j,y_j)$ during the SGD.
   310	We use $w_i$ to denote the $i$-th coordinate of $\mathbf{w}$.
   311	We also use $\mathbf{w}^{(e,k)}$ to denote the value of $\mathbf{w}$ at the end of $k$-th iteration of epoch $e$ and use $\mathbf{w}^{(e)}$ to denote the value of $\mathbf{w}$ after the end of epoch $e$.
   312	Assuming $(\mathbf{x},y)$ to be the training sample considered at iteration $k$, the stochastic gradient descent (SGD) method updates parameter $w_i$ for each $i$ by
   313	\begin{equation}\label{sgd-update}
   314	    w_i^{(e,k)} \leftarrow w_i^{(e,k-1)} - \eta_i \cdot \frac{\partial \mathcal{L}(y(\mathbf{w}^{(e,k-1)})^\top\mathbf{x})}{\partial w_i}
   315	\end{equation}
   316	In other words, we have
   317	\begin{equation*}
   318	    \mathbf{w}^{(e,k)}\leftarrow \mathbf{w}^{(e,k-1)}-\boldsymbol{\eta}\otimes \nabla \mathcal{L}(y(\mathbf{w}^{(e,k-1)})^\top\mathbf{x})
   319	\end{equation*}
   320	 where $\boldsymbol{\eta} \otimes  \nabla\mathcal{L}=(\eta_1 \frac{\partial \mathcal{L}}{\partial w_1},\dots,\eta_d \frac{\partial \mathcal{L}}{\partial w_d})$ is the Hadamard product.
   321	We say a training sample $\mathbf{x}$ is \emph{activated} at iteration $k$ during epoch $e$ if $\nabla\mathcal{L}(y(\mathbf{w}^{(e,k-1)})^\top\mathbf{x})\neq 0$.
   322	The SGD terminates at the end of epoch $e$ if $\| \mathbf{w}^{(e-1)}-\mathbf{w}^{(e)}\|< \varepsilon$ for threshold $\varepsilon$ or $e$ reached some predetermined value. We denote $\mathbf{w}^*=\mathbf{w}^{(e)}$.
   323	A linear classifier trained by SGD with the meta-parameters mentioned above is denoted as
   324	$\texttt{SGD}_\Lambda(\mathcal{L},\boldsymbol{\eta},\varepsilon,T)=\lambda_{\mathbf{w}^*}$. 
   325	With a slight abuse of notation, we define $\texttt{SGD}_\Lambda(\mathcal{L},\boldsymbol{\eta},\varepsilon,T,\mathbf{x})=\lambda_{\mathbf{w}^*}(\mathbf{x})$. We also use $\texttt{SGD}_\Lambda(T,\mathbf{x})$ to avoid cluttering when the context is clear.
   326	
   327	
   328	\textbf{Problem definition.} With the above definitions, \textsc{Debuggable} for SGD-trained linear classifiers can be formalized as follows:
   329	
   330	    \begin{center}
   331	    \begin{minipage}{0.8\textwidth}
   332	    \begin{mdframed}[
   333	        linewidth=1pt,
   334	        roundcorner=5pt
   335	    ]
   336	    \textsc{Debuggable-Lin}
   337	    
   338	    \textbf{Input:} Training data $T$, loss function 
   339	    $\mathcal{L}$, initial parameter $\mathbf{w}^{(0)}$, learning rate $\boldsymbol{\eta}$, threshold $\varepsilon$ and instance $(\mathbf{x}_\text{test},y_\text{test})$.
   340	
   341	    \textbf{Output:}
   342	        ``Yes'': if $\exists\Delta\subseteq T$ such that $\texttt{SGD}_\Lambda(\mathcal{L},\boldsymbol{\eta},\varepsilon,T\setminus\Delta,\mathbf{x}_\text{test})=y_\text{test}$;\\
   343	    \hspace*{3.8em}``No'': otherwise.
   344	    \end{mdframed}
   345	    \end{minipage}
   346	    \end{center}    
   347	   
   348	    % We use $(\mathcal{L}, \mathbf{w}^{(0)},\boldsymbol{\eta},\varepsilon,T,\mathbf{x}_\text{test},y_\text{test})$ to denote an instance of \textsc{Debuggable-Lin}. 
   349	    We say $\texttt{SGD}_\Lambda(\mathcal{L},\boldsymbol{\eta},\varepsilon,T)$
   350	    is \emph{debuggable} on $(\mathbf{x}_\text{test},y_\text{test})$ if $(\mathcal{L}, \mathbf{w}^{(0)},\boldsymbol{\eta},\varepsilon,T,\mathbf{x}_\text{test},y_\text{test})$
   351	    is a yes-instance of \textsc{Debuggable-Lin}, and not \emph{debuggable} on $(\mathbf{x}_\text{test},y_\text{test})$ otherwise.
   352	
   353	\section{Results for Unfixed Loss Functions}\label{gd-hardness}
   354	    In this section, we prove the NP-hardness of \textsc{Debuggable-Lin}. Intuitively, \textsc{Debuggable-Lin} is to determine whether there exists a subset $T'\subseteq T$ where activated training samples within $T'$ drive the parameter $\mathbf{w}$ toward the region defined by $y_\text{test}\mathbf{w}^\top\mathbf{x}_\text{test}>0$. 
   355	    % Then deleting $T\setminus T^\prime$ can be seen as a solution of data debugging.
   356	    The activation of training samples depends on the complex interaction between the training data and the model.
   357	    % The following theorem indicates that such interaction can be complex.
   358	    
   359	    \begin{theorem}\label{GD-NPC}
   360	        \textsc{Debuggable-Lin} is NP-hard for all training orders.
   361	    \end{theorem}
   362	    
   363	    We only show the proof sketch and leave the details in the appendix. 
   364	
   365	    \begin{proof}[Proof Sketch]
   366	         We build a reduction from an NP-hard problem \textsc{Monotone 1-in-3 SAT} \cite{Computability-book}:
   367	   
   368	    \begin{center}
   369	    \begin{minipage}{0.8\textwidth}
   370	    \begin{mdframed}[
   371	        linewidth=1pt,
   372	        roundcorner=5pt
   373	    ]
   374	    \textsc{Monotone 1-in-3 SAT}
   375	    
   376	    \textbf{Input:} A 3-CNF formula $\varphi$ with no negation signs.
   377	
   378	    \textbf{Output:}``Yes'': if $\varphi$ has a 1-in-3 assignment, under which each clause contains exactly one true literal;\\
   379	    \hspace*{3.7em}``No'': otherwise.
   380	    \end{mdframed}
   381	    \end{minipage}
   382	    \end{center}
   383	    
   384	    For example, $\varphi_1=(x_1 \vee x_2 \vee x_3) \wedge (x_2 \vee x_3 \vee x_4)$ is a yes-instance because $(x_1,x_2,x_3,x_4)=(\text{T,F,F,T})$ is an 1-in-3 assignment; $\varphi_2 = (x_1 \vee x_2 \vee x_3) \wedge (x_2 \vee x_3 \vee x_4) \wedge (x_1 \vee x_2 \vee x_4) \wedge (x_1 \vee x_3 \vee x_4)$ is a no-instance. 
   385	    % We write $\varphi\in$\textsc{Monotone 1-in-3 SAT} if $\varphi$ is a yes-instance.
   386	
   387	    Given a 3-CNF formula $\varphi$, our goal is to construct a configuration of the training process, such that the resulting model outputs the correct answer if and only if its training data $T^\prime$ encodes an 1-in-3 assignment $\nu$ of $\varphi$. This can be done by carefully designing the encoding so that for each $x_i\in\varphi$, $\nu(x_i)=\textsc{True}$ if and only if $\mathbf{t}_{x_i}\in T^\prime$. Finally, we can construct some $T$ with $T\supseteq T^\prime\cup \{\mathbf{t}_{x_i}|x_i\in \varphi\}$, such that some classifier trained on $T$ is a yes-instance of \textsc{Debuggable-Lin} if and only if $\varphi$ is a yes-instance of \textsc{Monotone 1-in-3 SAT}, thereby finishing our proof.
   388	
   389	    \textbf{The reduction.} Suppose $\varphi$ has $m$ clauses and $n$ variables, let $N=n+2m+1$. We set the dimension of the linear classifier to $N$.
   390	
   391	    \underline{The input.} Each coordinate of the input is named as
   392	    \begin{equation*}
   393	        \mathbf{x}=(x_{c_1},\dots,x_{c_m},x_{x_1},\dots,x_{x_n},x_{b_1},\dots,x_{b_m},x_{\text{dummy}})^\top
   394	    \end{equation*}
   395	    We also use $x_i$ to denote the $i$-th coordinate of $\mathbf{x}$.
   396	
   397	    \underline{The parameters.} Each coordinate of the parameter is named as
   398	    \begin{equation*}
   399	        \mathbf{w}=(w_{c_1},\dots,w_{c_m},w_{x_1},\dots,w_{x_n},w_{b_1},\dots,w_{b_m},w_{\text{dummy}})^\top
   400	    \end{equation*} 
   401	    We also use $w_i$ to denote the $i$-th coordinate of $\mathbf{w}$.
   402	    Each $w_{x_j}$ represents the truth value of variable $x_j$, where 1 represents \textsc{True} and -1 represents \textsc{False}. 
   403	    Similarly, each $w_{c_j}$ represents the truth value of clause $c_j$ based on the value of its variables. 
   404	    $w_{b_j}$ and $w_\texttt{dummy}$ are used for convenience of proof.
   405	    
   406	    % $w_{c_j}$ will be updated to $\frac{11}{2}$ during the training process if $c_j$ is satisfied and will remain $\frac{1}{2}$ otherwise.    
   407	    The initial value of the parameter is set to 
   408	    \begin{equation*}
   409	        \mathbf{w}^{(0)} = (\overbrace{\frac{1}{2},\dots,\frac{1}{2}}^{m},\overbrace{-1,\dots,-1}^{n},\overbrace{-1,\dots,-1}^{m},1)^\top
   410	    \end{equation*}
   411	    
   412	    \underline{Loss function.} We denote $U(x_0,\delta):=\{x|x_0-\delta < x < x_0+\delta\}$ as the $\delta$-neighborhood of $x_0$ and define $U(\pm x_0,\delta)=U(x_0,\delta)\cup U(-x_0,\delta)$. We define the \textit{local ramp function} as 
   413	    \begin{equation*}
   414	        r_{x_0,\delta}(x)=
   415	        \begin{cases}
   416	            0 &, x\le x_0 - \delta;\\
   417	            x-x_0 + \delta &, x\in U(x_0,\delta);\\
   418	            2\delta &, x\ge x_0 + \delta.
   419	        \end{cases}
   420	    \end{equation*}
   421	    
   422	    The loss function is defined as
   423	    \begin{equation*}
   424	        \mathcal{L}= -\frac{12N}{5} r_{-5,0.01}(y\mathbf{w}^\top\mathbf{x}) - 
   425	        r_{-\frac{1}{2},0.26}(y\mathbf{w}^\top\mathbf{x}) -
   426	        \frac{1}{1000N}\sum_{x_0\in\{\pm 1,\pm 3\}}r_{x_0,0.01}(y\mathbf{w}^\top\mathbf{x}).
   427	    \end{equation*}
   428	    $\mathcal{L}$ is monotonically decreasing with derivatives
   429	    \begin{equation}\label{gd-loss-derivative}
   430	        \frac{\partial \mathcal{L}}{\partial w_i} =
   431	        \begin{cases}
   432	        -\frac{12N}{5}\cdot yx_i ~&, y\mathbf{w}^\top\mathbf{x}\in U(-5,0.01); \\
   433	        -yx_i ~&, y\mathbf{w}^\top\mathbf{x}\in U(-\frac{1}{2},0.26);\\
   434	        -\frac{1}{1000N}yx_i ~&, y\mathbf{w}^\top\mathbf{x} \in 
   435	        \bigcup_{x_0\in\{\pm 1,\pm 3\}} U(x_0,0.01);\\
   436	        0 ~&, \text{otherwise.}
   437	        \end{cases}
   438	    \end{equation}
   439	
   440	    \underline{Learning rate.} The learning rate for SGD is set to be
   441	    \begin{equation*}
   442	        \boldsymbol{\eta}=(\overbrace{5,\dots,5}^{m},\overbrace{\frac{1}{6N},\dots,\frac{1}{6N}}^{n},\overbrace{2000N,\dots,2000N}^{m},1)^\top.
   443	    \end{equation*}
   444	
   445	    \underline{Training data.} We define two gadgets, \texttt{var($i$)} and \texttt{clause($i,i_1,i_2,i_3$)}, as illustrated in Table \ref{gadget_var} and \ref{gadget_clause}. All the unspecified coordinates are set to zero. We use $T_0$ to denote the training data.
   446	    \texttt{var($i$)} is contained in $T_0$ if and only if $x_i \in \varphi$, and \texttt{clause($i,i_1,i_2,i_3$)} is contained in $T_0$ if and only if $c_i = (x_{i_1}\vee x_{i_2}\vee x_{i_3})\in\varphi$.
