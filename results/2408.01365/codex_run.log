+        mu, norms = _initial_gso(reduced, precision)
+        delta, k, swaps = Decimal(3) / Decimal(4), 1, 0
+        operations = m * m * dimension
+        while k < m and swaps < swap_cap:
+            for j in range(k - 1, -1, -1):
+                q = int(mu[k][j].to_integral_value(rounding=ROUND_HALF_EVEN))
+                if q:
+                    reduced[k] = [reduced[k][p] - q * reduced[j][p]
+                                  for p in range(dimension)]
+                    qd = Decimal(q)
+                    for ell in range(j):
+                        mu[k][ell] -= qd * mu[j][ell]
+                    mu[k][j] -= qd
+                    operations += dimension + j + 1
