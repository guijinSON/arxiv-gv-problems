+    def visit(position: int, slots: int, remaining: int,
+              chosen: list[int]) -> None:
+        nonlocal nodes, found
+        if found is not None or nodes >= node_cap:
+            return
+        nodes += 1
+        left = len(values) - position
+        if slots == 0:
+            if remaining == 0:
+                found = list(chosen)
+            return
+        if slots > left or remaining <= 0:
+            return
+        largest = prefix[position + slots] - prefix[position]
+        smallest = prefix[len(values)] - prefix[len(values) - slots]
+        if remaining > largest or remaining < smallest:
+            return
+        chosen.append(ordered[position])
+        visit(position + 1, slots - 1, remaining - values[position], chosen)
+        chosen.pop()
+        visit(position + 1, slots, remaining, chosen)
 
