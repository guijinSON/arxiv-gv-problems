+def _bounded_lll(basis: list[list[int]], precision: int,
+                 swap_cap: int = 3000) -> tuple[list[list[int]], int, int]:
+    """LLL with exact integer row operations, decimal GSO, and a swap cap."""
+    reduced = [list(row) for row in basis]
+    m, dimension = len(reduced), len(reduced[0])
+    with localcontext() as context:
+        context.prec = precision
+        mu, norms = _initial_gso(reduced, precision)
+        delta, k, swaps = Decimal(3) / Decimal(4), 1, 0
+        operations = m * m * dimension
+        while k < m and swaps < swap_cap:
+            for j in range(k - 1, -1, -1):
+                q = int(mu[k][j].to_integral_value(rounding=ROUND_HALF_EVEN))
+                if q:
+                    reduced[k] = [reduced[k][p] - q * reduced[j][p]
+                                  for p in range(dimension)]
+                    qd = Decimal(q)
+                    for ell in range(j):
+                        mu[k][ell] -= qd * mu[j][ell]
+                    mu[k][j] -= qd
+                    operations += dimension + j + 1
+            if norms[k] >= (delta - mu[k][k - 1] ** 2) * norms[k - 1]:
+                k += 1
+                continue
 
