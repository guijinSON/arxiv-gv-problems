    \begin{equation*}
        \mathbf{w}_c\xrightarrow{(\mathbf{x}_c,y_c)}\mathbf{w}_b=\mathbf{w}_c + \mathbf{x}_cy_c = (\frac{|T^*|}{n+1}+\frac{3}{2}\beta-1,-3\beta(t^\prime-t)-\frac{1}{2}\beta)
