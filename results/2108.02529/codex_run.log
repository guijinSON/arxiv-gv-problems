+)
+
+# Filled from script-owned transcripts after the three oracle arms run.
+G9_MEASUREMENTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
