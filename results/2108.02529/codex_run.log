+            "complexity": "O(v^3/w) bit-word work and O(v^2) stored pairs",
+            "wall_clock_sec_mean": sum(reference_times) / len(reference_times),
+            "wall_clock_sec_max": max(reference_times),
+            "operations": operation_count,
+            "pairs": pair_count,
