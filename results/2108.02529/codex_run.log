+def _attack_spectral_gram(inst: dict) -> list[int]:
+    """Exact counterpart of a top-eigenspace block-leverage attack.
+
+    In a symmetric 2-design the block Gram matrix has k on its diagonal and
+    lambda everywhere else.  Its principal eigenvector is all-ones and the
+    remaining eigenspace is completely degenerate, so every block receives
+    the same leverage score.  Lexicographic tie-breaking is therefore the
+    only deterministic output available to this standard spectral probe.
+    """
+    return list(range(inst["q"]))
+
