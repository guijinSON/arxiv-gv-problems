+        "candidate switching set."
+    ),
+    "bounds": {
+        "length": "q (the instance field order)",
+        "label_min": 0,
+        "label_max": "q^2-1",
+        "distinct": True,
+        "maximum_supported_length": 32,
+    },
+}
+
