+        "doubled_n": doubled_params["n"],
+        "shipping_v": inst["v"],
+        "doubled_v": doubled["v"],
+        "shipping_space": search_space(inst),
+        "doubled_space": search_space(doubled),
+        "doubled_verify_reason": doubled_reason,
+    }
