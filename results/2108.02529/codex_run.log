+def _intersection_profile(rows: list[int], anchor: int) -> tuple[int, ...]:
+    """Relabelling-invariant local histogram of triple intersections."""
+    others = [x for x in range(len(rows)) if x != anchor]
+    counts: dict[int, int] = {}
+    anchored = rows[anchor]
+    for pos, left in enumerate(others):
+        pair = anchored & rows[left]
+        for right in others[pos + 1:]:
+            value = (pair & rows[right]).bit_count()
+            counts[value] = counts.get(value, 0) + 1
+    maximum = max(counts, default=0)
+    return tuple(counts.get(value, 0) for value in range(maximum + 1))
