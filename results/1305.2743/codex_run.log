def gen(n,seed):
 r=random.Random(seed);h=n//2;k=n//4;L=list(range(h));R=list(range(h,n));a=set(r.sample(L,h//2));b=set(r.sample(R,h//2))
 def pair(S):z=list(S);r.shuffle(z);return [(z[i],z[i+1])for i in range(0,len(z),2)]
 ins=pair(a)+pair(b);sl=[x for x in L if x not in a];sr=[x for x in R if x not in b]
 while True:
  cross=[];seen=set();ok=True
  for _ in range(3):
   z=R[:];r.shuffle(z)
   for u,v in zip(L,z):
    if (u,v) in seen:ok=False;break
    seen.add((u,v));cross.append((u,v))
   if not ok:break
  if not ok:continue
  z=sr[:];r.shuffle(z)
