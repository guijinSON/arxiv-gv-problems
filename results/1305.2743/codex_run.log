def random_candidate(inst: dict, rng: random.Random) -> object:
    d = inst["label_bits"]
    source, target = inst["X"][0], inst["Y"][0]
    delta = inst["labels"][source] ^ inst["labels"][target]
    pivot = (delta & -delta).bit_length() - 1
