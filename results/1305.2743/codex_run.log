+    baseline_seconds = time.perf_counter() - baseline_start
+    demo_count = enumerate_all(make_instance(seed=3, **DIFFICULTY["demo"]))
+    report["G5_density_and_baseline"] = {
+        "pass": hits / samples < 1e-6 and demo_count is not None,
