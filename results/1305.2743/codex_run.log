+def _block_order(blocks: list[list[int]], rng: random.Random) -> list[int]:
+    blocks = [list(block) for block in blocks]
+    rng.shuffle(blocks)
+    return [vertex for block in blocks for vertex in block]
+
+
+def make_instance(
+    n: int,
