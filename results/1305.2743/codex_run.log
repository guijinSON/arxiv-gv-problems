            if row_index != rank and ((rows[row_index] >> column) & 1):
                rows[row_index] ^= rows[rank]
                row_xors += 1
        rank += 1
    stats = {
        "flow": flow,
        "bfs_rounds": bfs_rounds,
        "edge_scans": edge_scans,
        "pivot_tests": pivot_tests,
        "row_xors": row_xors,
