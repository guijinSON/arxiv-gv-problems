+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(
+        r"<answer>\s*([01](?:[01\s]*[01])?)\s*\|\s*([01])\s*</answer>",
+        text,
