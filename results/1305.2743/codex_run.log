+        pv = _parity(mask & inst["labels"][v]) ^ constant
+        if pu == pv:
+            continue
+        cut.append([u, v])
+        ru, rv = find(u), find(v)
+        if ru != rv:
+            if size[ru] < size[rv]:
+                ru, rv = rv, ru
+            parent[rv] = ru
+            size[ru] += size[rv]
+            rank += 1
