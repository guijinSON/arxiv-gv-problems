+def _far_cross_matching(
+    left: list[int], right: list[int], rng: random.Random
+) -> list[int] | None:
+    """Match each left label to a right label at Hamming distance at least 3."""
+
+    candidates = []
+    for left_label in left:
+        row = [
+            j
+            for j, right_label in enumerate(right)
