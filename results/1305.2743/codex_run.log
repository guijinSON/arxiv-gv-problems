+
+    d = inst["label_bits"]
+    parent = list(range(d))
+
+    def find(bit: int) -> int:
+        while parent[bit] != bit:
+            parent[bit] = parent[parent[bit]]
+            bit = parent[bit]
+        return bit
+
+    def union(first: int, second: int) -> None:
+        first, second = find(first), find(second)
