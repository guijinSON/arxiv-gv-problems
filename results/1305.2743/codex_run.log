+        "shipping_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "shipping_edges": len(inst["edges"]),
+        "doubled_edges": len(doubled["edges"]),
+        "answer_elements_unchanged": len(doubled["answer"]) == len(answer),
+        "doubled_verify_reason": doubled_reason,
+    }
+
