 p=list(range(n));r.shuffle(p);T=[((p[u],p[v]),1)for u,v in ins]+[((p[u],p[v]),0)for u,v in cross];r.shuffle(T)
 return [tuple(sorted(x))for x,_ in T],[i for i,(_,z)in enumerate(T)if z],k

def maxcut(E,n,k,seed,restarts=64):
