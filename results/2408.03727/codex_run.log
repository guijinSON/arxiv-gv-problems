+            control, first, second = rng.sample(range(n), 3)
+            gates.append(["F", control, first, second])
+        else:
+            first, second = rng.sample(range(n), 2)
+            gates.append(["S", first, second])
+    return gates
+
+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    outer_steps: int = 196,
+    round_steps: int = 64,
+    repeat_bits: int = 20,
