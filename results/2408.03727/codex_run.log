+        "base_vertices": inst["vertex_count"],
+        "doubled_n_bits": doubled["n"],
+        "doubled_vertices": doubled["vertex_count"],
+        "search_space_ratio": search_space(doubled) // search_space(inst),
+        "verify_reason": doubled_reason,
+    }
+
