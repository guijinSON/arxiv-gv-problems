+        "O(n^3 log E) and is measured by selftest at the shipping preset; the "
+        "compact parity-invariant route uses 196 mask updates, while expanding "
+        "the two cycles would expose 2^28 vertices."
+    ),
+    "max_answer_tokens": 16,
+}
+
+NATIVE = {
