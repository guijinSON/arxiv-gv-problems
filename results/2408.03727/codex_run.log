+        "O(n^3 log E) and its measured shipping cost is reported by selftest; "
+        "the compact parity-invariant route uses 299 mask updates, while "
+        "expanding the two cycles would expose 2^40 vertices."
+    ),
+    "max_answer_tokens": 16,
+}
+
+NATIVE = {
