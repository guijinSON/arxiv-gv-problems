+        carried = _inverse_pullback(all_ones, trial)
+        weight = carried.bit_count()
+        if max(2, n // 3) <= weight <= min(n - 2, (2 * n) // 3 + 1):
+            outer = trial
+            answer_mask = carried
+            break
