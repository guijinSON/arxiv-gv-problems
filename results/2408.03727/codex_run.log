import random, math, time

def comp_seq(blocks,total,allow,rng):
    dp=[[0]*(total+1) for _ in range(blocks+1)];dp[0][0]=1
    for b in range(1,blocks+1):
      for s in range(total+1):
       dp[b][s]=sum(math.comb(4,a)*dp[b-1][s-a] for a in allow if s>=a)
    out=[]; rem=total
    for b in range(blocks,0,-1):
      opts=[]; tot=0
      for a in allow:
