  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  v=next((v for v in order if assign[v]<0),-1)
  if v<0:return assign[:]
  for val in (0,1):
   vm=len(vtrail);em=len(etrail)
   if propagate(v,val):
    z=rec()
    if z is None:return None
    if z is not False:return z
   undo(vm,em)
  return False
 propagate(order[0],0);z=rec();return isinstance(z,list),nodes,props
