Correction: the configured hard deadline is 900 seconds (15 minutes), not nine minutes. This second `hard` response is around ten minutes in, still inside that limit.
diff --git a/gen_2408_03727.py b/gen_2408_03727.py
new file mode 100644
index 0000000000000000000000000000000000000000..1db6f7653117785551b9c9041fbc403f8cd5bfa2
--- /dev/null
+++ b/gen_2408_03727.py
@@ -0,0 +1,1064 @@
+"""Verified cooperative-coloring generator for arXiv:2408.03727.
+
+The instance is a pair of succinct 2-uniform chain-structured hypergraphs
+(cycles).  A witness is an affine parity formula over GF(2) defining the two
+parts of a cooperative coloring.  Generation transports the alternating Gray
+cycle coloring through a reversible outer mixer, so no generated instance is
+solved in order to obtain its certificate.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import random
+import re
