def gen(n,seed,k=5,density=12.5):
 r=random.Random(seed);p=[0]*(n//2)+[1]*(n-n//2);r.shuffle(p);es=set()
 while len(es)<round(density*n):
  e=tuple(sorted(r.sample(range(n),k)))
  if len({p[i]for i in e})>1:es.add(e)
 return sorted(es)

def dpll(n,edges,cap=100000):
 inc=[[]for _ in range(n)]
 for j,e in enumerate(edges):
  for v in e:inc[v].append(j)
 assign=[-1]*n;c0=[0]*len(edges);c1=[0]*len(edges);un=[len(e)for e in edges]
 vtrail=[];etrail=[];nodes=0;props=0
 order=sorted(range(n),key=lambda v:(-len(inc[v]),v))
 def apply(v,val,queue):
  nonlocal props
  if assign[v]>=0:return assign[v]==val
  assign[v]=val;vtrail.append(v)
  for j in inc[v]:
   etrail.append((j,c0[j],c1[j],un[j]));un[j]-=1
   if val:c1[j]+=1
   else:c0[j]+=1
   props+=1
   if c0[j] and c1[j]:continue
   if un[j]==0:return False
   if un[j]==1:
    want=1 if c0[j] else 0
    u=next(x for x in edges[j] if assign[x]<0)
    queue.append((u,want))
  return True
 def propagate(v,val):
  q=[(v,val)]
  while q:
   x,z=q.pop()
   if not apply(x,z,q):return False
  return True
 def undo(vm,em):
  while len(etrail)>em:
   j,a,b,c=etrail.pop();c0[j]=a;c1[j]=b;un[j]=c
  while len(vtrail)>vm:assign[vtrail.pop()]=-1
