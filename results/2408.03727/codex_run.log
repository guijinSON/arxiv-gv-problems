+        "mask is an integer in [0,2^n-1] and offset is 0 or 1; the language "
+        "contains exactly 2^(n+1) formulas."
+    ),
+    "bounds": {
+        "mask_min": 0,
+        "mask_max": "2^inst['n'] - 1",
+        "offset_values": [0, 1],
+        "formula_terms": 2,
+    },
+}
+
