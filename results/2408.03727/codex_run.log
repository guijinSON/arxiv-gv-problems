+        "mask_max": "2^inst['n'] - 1",
+        "offset_values": [0, 1],
+        "formula_terms": 2,
+    },
+}
+
+DIFFICULTY = {
+    "demo": {
+        "n": 4,
+        "outer_steps": 8,
+        "round_steps": 6,
+        "repeat_bits": 5,
+    },
+    "easy": {
+        "n": 28,
