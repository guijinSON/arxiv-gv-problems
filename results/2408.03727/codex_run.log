+            "max_wall_clock_sec": max(r["wall_clock_sec"] for r in reference_rows),
+            "mean_bit_operations": sum(r["bit_operations"] for r in reference_rows) / 8,
+            "rows": reference_rows,
+        },
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] *= 2
