+def _truncated_mixer_attack(inst: dict) -> dict:
+    target = (1 << inst["n"]) - 1
+    prefix = inst["outer_mixer"][: max(1, len(inst["outer_mixer"]) // 4)]
+    return {"mask": _inverse_pullback(target, prefix), "offset": 0}
+
