+        _random_parity_round(rng, n, round_steps),
+        _random_parity_round(rng, n, round_steps),
+    ]
+    low = 1 << (repeat_bits - 1)
+    high = (1 << repeat_bits) - 1
+    repetitions = [rng.randrange(low, high + 1) | 1, rng.randrange(low, high + 1) | 1]
+    offset = rng.randrange(2)
