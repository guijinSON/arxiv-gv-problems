+
+STRUCTURAL_HINT = (
+    "Every repeated FANOUT2/SWAP round preserves the XOR of all coordinate bits."
+)
+PLACEBO_HINT = (
+    "Careful bookkeeping of the gate indices helps avoid small transcription errors."
+)
