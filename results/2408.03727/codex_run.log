+            "wall_clock_sec": cost["wall_clock_sec"],
+            "bit_operations": cost["bit_operations"],
+        })
+
+    attacks = {
+        name: {
+            "successes": sum(int(row["solved"]) for row in results),
+            "attempts": len(results),
