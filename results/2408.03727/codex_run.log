+        "invariance_passed": invariant_checks,
+        "invariance_total": 60,
+        "real_transform_answers_verified": real_checks,
+        "real_transform_total": 60,
+        "unrelated_distinct": distinct,
+        "unrelated_total": 20,
+        "transformations": [
