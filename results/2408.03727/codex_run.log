+        "swap_fields": {"mask": planted["offset"], "offset": planted["mask"]},
+        "duplicate_field": {**planted, "mask_copy": planted["mask"]},
+        "empty": {},
+        "out_of_range": {"mask": inst["vertex_count"], "offset": planted["offset"]},
+        "flip_one_coefficient": {
