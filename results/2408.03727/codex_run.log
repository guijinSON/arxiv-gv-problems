+        "hinted_minus_placebo": hinted_minus_placebo,
+        "hinted_verdict": G9_HINTED_VERDICT,
+        "answer_chars": len(compact),
+        "answer_tokens": token_estimate,
+        "answer_elements": 2,
+        "intended_route_operations": shipping["outer_steps"],
+        "caps_pass": within_caps,
