+    Nonzero points occur in opposite pairs.  Projectivise those pairs and
+    record, for each small subset size, how many subsets have every possible
+    rank.  Ambient invertible linear maps, arbitrary reparameterisations of
+    the connection set, and nonzero changes of projective representatives all
+    preserve this profile.
+
+    Full finite-field point-configuration isomorphism is not attempted.  This
+    is a deliberately strong inexpensive invariant for duplicate detection,
+    not a claim to be a complete canonical form.
+    """
+    dimension = len(factor["points"][0])
+    projective_points = sorted({
+        tuple(_normalize_projective(point, p))
+        for point in factor["points"]
+        if any(point)
+    })
+    profile = []
+    max_subset = min(len(projective_points), dimension)
+    while (
+        max_subset >= 2
+        and math.comb(len(projective_points), max_subset) > 250_000
+    ):
+        max_subset -= 1
+    for subset_size in range(2, max_subset + 1):
+        rank_counts = [0] * (dimension + 1)
+        for subset in itertools.combinations(projective_points, subset_size):
+            rank_counts[_rank_mod(subset, p)] += 1
+        profile.append(rank_counts)
+    return [len(projective_points), profile]
 
 
