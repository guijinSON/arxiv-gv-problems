import json
rows=[json.loads(x) for x in open('llm_loop_transcript.jsonl')]
scored=[r for r in rows if r['solved']"'!='"'error']
from collections import defaultdict
x=defaultdict(lambda:[0,0])
for r in scored:
 x[(r['preset'],r['params']['n'])][1]+=1
 x[(r['preset'],r['params']['n'])][0]+=int(r['verify_ok'] is True)
print('scored',len(scored),'solved',sum(r['verify_ok'] is True for r in scored),'errors',len(rows)-len(scored))
print(dict(x))
print('elapsed',[(r['params']['n'],r['model'],r['verify_ok'],r['elapsed_sec']) for r in scored])
