+    "attempts": 12,
+    "pass": true,
+    "transversal_identity_attempts": 24,
+    "transversal_identity_checks": 24,
+    "verified": 12
+  },
+  "G2_rejects_corruption": {
+    "corruptions": {
+      "drop": {
