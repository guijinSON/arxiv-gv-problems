+    seconds = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    reference_seconds = 0.0
+    reference_operations = []
+    compact_successes = 0
+    compact_seconds = 0.0
+    compact_operations = []
+    for seed in range(80, 88):
