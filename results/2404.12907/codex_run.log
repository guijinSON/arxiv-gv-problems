+def escalate(params: dict) -> dict | str | None:
+    """Grow the tournament while holding the 64-entry witness fixed."""
+    out = {key: value for key, value in params.items() if key != "_preset"}
+    n = int(out.get("n", 320))
+    if n >= 4096:
+        return None
+    out["n"] = min(4096, 2 * n)
+    if out["n"] % 2:
+        out["n"] += 1
+    return out
 
 
