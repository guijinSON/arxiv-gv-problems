import gen_2404_12907 as g

def full_ok(i, ans):
    n=i['n']; order=g._order_list(i); pos={v:p for p,v in enumerate(order)}
    toggles=set(g._derive_toggle_residues(i)); removed={tuple(x) for x in ans}
    out=[set() for _ in range(n)]; indeg=[0]*n
    for a in range(n):
      for b in range(a+1,n):
        r=None
        if (a+i['gap'])%n==b: r=a
        elif (b+i['gap'])%n==a: r=b
        u,v=order[a],order[b]
        if r in toggles: u,v=v,u
        if (u,v) not in removed: out[u].add(v); indeg[v]+=1
    stack=[v for v,d in enumerate(indeg) if d==0]; seen=0
    while stack:
