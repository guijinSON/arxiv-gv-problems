+def _find_required_triangles(inst: dict) -> list[list[list[int]]]:
+    """Find several actual directed triangles for fast necessary checks."""
+    out = inst["_final_out"]
+    n = inst["n"]
+    triangles = []
+    used_arcs = set()
+    for residue in inst["_toggle_residues"]:
+        tail, head = _backward_arc_for_residue(inst, residue)
+        for w in range(n):
+            if w in (tail, head):
+                continue
+            if ((out[head] >> w) & 1) and ((out[w] >> tail) & 1):
+                tri = [(tail, head), (head, w), (w, tail)]
+                if all(edge not in used_arcs for edge in tri):
+                    triangles.append([[a, b] for a, b in tri])
+                    used_arcs.update(tri)
