    start_time = time.perf_counter()
    n = inst["n"]
    difference = bytearray(n + 1)
    global_bit = 0
    operations = 0

    def toggle_linear(left: int, right: int):
        nonlocal operations
        difference[left] ^= 1
        difference[right + 1] ^= 1
        operations += 2

    for batch in inst["batches"]:
        full, rem = divmod(batch["count"], n)
        global_bit ^= full & 1
        start = batch["start"] % n
        operations += 3  # divmod, full-turn XOR, start reduction
        if rem:
            if batch["step"] == 1:
                left = start
                right = (start + rem - 1) % n
            else:
                left = (start - rem + 1) % n
                right = start
            operations += 3  # endpoint arithmetic and reduction
            if left <= right:
                toggle_linear(left, right)
            else:
                toggle_linear(left, n - 1)
                toggle_linear(0, right)

    parity = bytearray(n)
    running = global_bit
    for residue in range(n):
        running ^= difference[residue]
        parity[residue] = running
        operations += 1
    answer = sorted(
        _backward_arc_for_residue(inst, r)
        for r, bit in enumerate(parity) if bit
    )
    operations += 3 * len(answer)
    elapsed = time.perf_counter() - start_time
    return answer, elapsed, operations


def _candidate_from_residues(inst: dict, residues) -> list[list[int]]:
    """Turn heuristic residues into a legal K-arc candidate, padding neutrally."""
    chosen = []
    seen = set()
    for residue in residues:
        arc = tuple(_backward_arc_for_residue(inst, residue % inst["n"]))
        # A heuristic arc might point the other way in the final tournament.
        tail, head = arc
        if not ((inst["_final_out"][tail] >> head) & 1):
            arc = (head, tail)

