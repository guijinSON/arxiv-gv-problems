+def _literal_replay_reference(inst: dict):
+    """Successful Track-B reference: expand and apply every listed update."""
+    start_time = time.perf_counter()
+    n = inst["n"]
+    parity = bytearray(n)
+    updates = 0
+    for batch in inst["batches"]:
+        r = batch["start"] % n
+        step = batch["step"]
+        for _ in range(batch["count"]):
+            parity[r] ^= 1
+            updates += 1
+            r += step
+            if r == n:
+                r = 0
+            elif r < 0:
+                r = n - 1
+    answer = sorted(
+        _backward_arc_for_residue(inst, r)
+        for r, bit in enumerate(parity) if bit
+    )
+    elapsed = time.perf_counter() - start_time
+    return answer, elapsed, updates
