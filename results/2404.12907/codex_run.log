+    mean_updates = sum(ref_updates) // len(ref_updates)
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and ref_successes == attempts,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": (
+                "literal expansion/replay of every batch update, then comparison "
+                "with the displayed initial transitive order"
+            ),
+            "complexity": "O(U+n^2) exact operations",
+            "wall_clock_sec": round(mean_wall, 6),
+            "operations": mean_updates,
