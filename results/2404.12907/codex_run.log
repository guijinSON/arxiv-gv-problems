+STRUCTURAL_HINT = (
+    "Arc reversal is an involution, so the final orientation of each arc "
+    "depends only on the parity of its total update multiplicity."
+)
+PLACEBO_HINT = (
+    "Careful tracking of the position order and directed-arc convention "
+    "prevents subtle endpoint and indexing mistakes."
+)
