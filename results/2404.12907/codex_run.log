+        "k": 2,
+        "gap": 2,
+        "decoy_groups": 1,
+        "replay_span": 5,
+    },
+    "easy": {
+        "n": 61,
+        "k": 4,
+        "gap": 2,
+        "decoy_groups": 4,
+        "replay_span": 2_500,
+    },
+    "medium": {
+        "n": 127,
+        "k": 6,
+        "gap": 2,
+        "decoy_groups": 8,
+        "replay_span": 10_000,
+    },
+    "hard": {
+        "n": 257,
+        "k": 8,
+        "gap": 2,
+        "decoy_groups": 12,
+        "replay_span": 25_000,
+    },
+}
+SHIPPING_DIFFICULTY = "hard"
