+        "k": 2,
+        "gap": 2,
+        "decoy_groups": 1,
+        "replay_span": 5,
+    },
+    "easy": {
+        "n": 61,
+        "k": 4,
+        "gap": 2,
+        "decoy_groups": 4,
+        "replay_span": 2_500,
+    },
+    "medium": {
+        "n": 127,
+        "k": 6,
+        "gap": 2,
