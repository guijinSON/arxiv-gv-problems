def escalate(params: dict):
    """Grow replay work, batch crowding, and ambient tournament at fixed K."""
    harder = dict(params)
    harder.pop("_preset", None)
    harder["n"] = 2 * int(harder["n"]) - 1
    harder["gap"] = 2
    harder["decoy_groups"] = min(20, int(harder["decoy_groups"]) + 4)
    harder["replay_span"] = 2 * int(harder["replay_span"])
    return harder


def _range_xor_reference(inst: dict):
    """Successful Track-B reference on the compressed batch representation.

    A unit-step batch consists of full turns around Z/nZ plus one circular
    interval.  Full turns contribute one global parity bit; every residual
    interval is accumulated with two XOR-difference boundaries.  This is the
    strongest implemented generic route for these compressed updates.
