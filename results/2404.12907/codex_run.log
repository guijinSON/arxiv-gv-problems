def _range_xor_reference(inst: dict):
    """Successful Track-B reference on the compressed batch representation.

    A unit-step batch consists of full turns around Z/nZ plus one circular
    interval.  Full turns contribute one global parity bit; every residual
    interval is accumulated with two XOR-difference boundaries.  This is the
    strongest implemented generic route for these compressed updates.
    """
    start_time = time.perf_counter()
    n = inst["n"]
    difference = bytearray(n + 1)
    global_bit = 0
    operations = 0

    def toggle_linear(left: int, right: int):
        nonlocal operations
        difference[left] ^= 1
        difference[right + 1] ^= 1
        operations += 2

    for batch in inst["batches"]:
        full, rem = divmod(batch["count"], n)
        global_bit ^= full & 1
        start = batch["start"] % n
        operations += 3  # divmod, full-turn XOR, start reduction
        if rem:
            if batch["step"] == 1:
                left = start
                right = (start + rem - 1) % n
            else:
                left = (start - rem + 1) % n
                right = start
            operations += 3  # endpoint arithmetic and reduction
            if left <= right:
                toggle_linear(left, right)
            else:
                toggle_linear(left, n - 1)
                toggle_linear(0, right)

    parity = bytearray(n)
    running = global_bit

    for residue in range(n):
        running ^= difference[residue]
        parity[residue] = running
        operations += 1
    answer = sorted(
        _backward_arc_for_residue(inst, r)
        for r, bit in enumerate(parity) if bit
    )
    operations += 3 * len(answer)
    elapsed = time.perf_counter() - start_time
    return answer, elapsed, operations
