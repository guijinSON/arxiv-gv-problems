+        if removed.isdisjoint(tuple(arc) for arc in triangle):
+            return False, "a directed cycle remains after deleting the listed arcs"
+    if not _acyclic_after_deleting(inst, removed):
+        return False, "a directed cycle remains after deleting the listed arcs"
+    return True, "ok"
