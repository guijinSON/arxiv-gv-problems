+def _primitive_batches(start: int, length: int, rng: random.Random) -> list[dict]:
+    """Two same-distribution batches whose parity leaves only index start."""
+    outer = {"start": start, "count": length + 1, "step": 1}
+    inner = {"start": start + 1, "count": length, "step": 1}
+    if rng.randrange(2):
+        outer = _reverse_batch(outer)
+    if rng.randrange(2):
+        inner = _reverse_batch(inner)
+    return [outer, inner]
