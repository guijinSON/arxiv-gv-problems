+def _canonical_coloring(inst: dict) -> tuple[list[int], list[int]]:
+    """Canonical color refinement of the L/R-colored tournament."""
+    n = inst["n"]
+    roles = [0] * n
+    for vertex in inst["left"]:
+        roles[vertex] = 1
+    for vertex in inst["right"]:
+        roles[vertex] = 2
+    initial = [(roles[v], inst["indegrees"][v]) for v in range(n)]
+    palette = {sig: i for i, sig in enumerate(sorted(set(initial)))}
+    colors = [palette[sig] for sig in initial]
+    for _ in range(4):
+        color_count = max(colors) + 1
+        signatures = []
+        for u in range(n):
+            counts = [0] * color_count
+            bits = inst["out_bits"][u]
+            while bits:
+                low = bits & -bits
+                v = low.bit_length() - 1
+                bits ^= low
+                counts[colors[v]] += 1
+            signatures.append((colors[u], tuple(counts)))
+        palette = {sig: i for i, sig in enumerate(sorted(set(signatures)))}
+        new_colors = [palette[sig] for sig in signatures]
+        if new_colors == colors:
+            break
+        colors = new_colors
+    return roles, colors
+
