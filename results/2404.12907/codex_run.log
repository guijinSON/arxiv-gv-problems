+def _validate_permutation(k: int, answer: object) -> tuple[bool, str]:
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if not answer:
+        return False, f"empty answer: expected {k} permutation entries"
+    if len(answer) < k:
+        return False, f"too few entries: expected {k}, got {len(answer)}"
+    if len(answer) > k:
+        return False, f"too many entries: expected {k}, got {len(answer)}"
+    for pos, value in enumerate(answer):
+        if not isinstance(value, int) or isinstance(value, bool):
+            return False, f"entry {pos} is not an integer"
+        if not 0 <= value < k:
+            return False, f"entry {pos}={value} is outside 0..{k - 1}"
+    if len(set(answer)) != k:
