+def _reverse_batch(batch: dict) -> dict:
+    """Return the same finite progression written in reverse order."""
+    return {
+        "start": batch["start"] + batch["step"] * (batch["count"] - 1),
+        "count": batch["count"],
+        "step": -batch["step"],
+    }
