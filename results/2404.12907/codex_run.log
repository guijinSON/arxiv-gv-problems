+        "k": 6,
+        "gap": 2,
+        "decoy_groups": 8,
+        "replay_span": 10_000,
+    },
+    "hard": {
+        "n": 257,
+        "k": 8,
+        "gap": 2,
+        "decoy_groups": 12,
+        "replay_span": 25_000,
+    },
+}
