+    if search_space(inst) > 200_000:
+        return None
+    count = 0
+    for indices in itertools.combinations(range(len(inst["_oriented_chords"])),
+                                          inst["k"]):
+        candidate = sorted(inst["_oriented_chords"][i][:] for i in indices)
+        count += int(verify(inst, candidate)[0])
+    return count
