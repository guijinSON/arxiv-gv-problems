+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list of exactly K distinct directed arcs [tail,head] of the "
+        "final n-vertex tournament, sorted lexicographically, with endpoints "
+        "in 0..n-1; deleting all listed arcs must leave an acyclic digraph."
+    ),
+    "bounds": {
+        "arc_count": "instance K (8 at the shipping preset)",
+        "endpoint_min": 0,
+        "endpoint_max": "n-1 (256 at the shipping preset)",
+        "distinct": True,
+        "ordering": "lexicographically increasing",
+    },
+}
