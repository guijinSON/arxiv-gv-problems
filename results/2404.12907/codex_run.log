+def _acyclic_after_deleting(inst: dict, removed: set[tuple[int, int]]) -> bool:
+    n = inst["n"]
+    indegree = inst["_final_indegree"][:]
+    removed_masks = [0] * n
+    for tail, head in removed:
+        indegree[head] -= 1
+        removed_masks[tail] |= 1 << head
+    stack = [v for v, degree in enumerate(indegree) if degree == 0]
+    active = (1 << n) - 1
+    seen = 0
+    out = inst["_final_out"]
+    while stack:
+        v = stack.pop()
+        bit_v = 1 << v
+        if not active & bit_v:
+            continue
+        active ^= bit_v
+        seen += 1
+        neighbours = out[v] & active & ~removed_masks[v]
+        while neighbours:
+            bit = neighbours & -neighbours
+            w = bit.bit_length() - 1
+            indegree[w] -= 1
+            if indegree[w] == 0:
+                stack.append(w)
+            neighbours ^= bit
