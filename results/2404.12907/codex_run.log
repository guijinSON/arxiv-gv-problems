+    blob = json.dumps(answer, separators=(",", ":"))
+    answer_elements = 2 * len(answer)
+    # For B batches: compute two endpoints (<=2 ops each), reduce the B/2
+    # unmatched boundaries modulo n, then compute/map K gap endpoints (<=3 each).
+    intended_ops = 2 * len(ship["batches"]) \
+        + len(ship["batches"]) // 2 + 3 * ship["k"]
+    arms = G9_RESULTS["arms"]
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = len(blob) <= 2_000 and answer_elements <= 256 \
