+        r = batch["start"] % n
+        step = batch["step"]
+        for _ in range(rem):
+            parity[r] ^= 1
+            r += step
+            if r == n:
+                r = 0
+            elif r < 0:
+                r = n - 1
+    return [r for r, bit in enumerate(parity) if bit]
