   305	  \section{Universal sums via the theory of quadratic forms} \label{AlmostSec}
   306	
   307	  \setcounter{equation}{0}
   308	 \setcounter{conjecture}{0}
   309	%\setcounter{lemma}{0}
   310	 \setcounter{theorem}{0}
   311	 \setcounter{proposition}{0}
   312	
   313	  For two integer-valued polynomials $P(x_1,\ldots,x_n)$ and $Q(x_1,\ldots,x_n)$,
   314	  if $$\{P(x_1,\ldots,x_n):\ x_1,\ldots,x_n\in\Z\}=\{Q(x_1,\ldots,x_n):\ x_1,\ldots,x_n\in\Z\}$$
   315	  then we say that $P$ and $Q$ are equivalent and denote this by $P(x_1,\ldots,x_n)\sim Q(x_1,\ldots,x_n)$. For $a_1,b_1,c_1,a_1',b_1',c_1'\in\Z^+$ and $a_2,b_2,c_2,a_2',b_2',c_2'\in\Z$ with $a_1-a_2,b_1-b_2,c_1-c_2,a_1'-a_2',b_1'-b_2',c_1'-c_2'$
   316	 all even, if
   317	 $$\f{x(a_1x+a_2)}2+\f{y(b_1y+b_2)}2+\f{z(c_1z+c_2)}2\sim \f{x(a_1'x+a_2')}2+\f{y(b_1'y+b_2')}2+\f{z(c_1'z+c_2')}2,
   318	$$ then we say that the two tuples $(a_1,a_2,b_1,b_2,c_1,c_2)$ and $(a_1',a_2',b_1',b_2',c_1',c_2')$
   319	are equivalent, and denote this by
   320	  $$(a_1,a_2,b_1,b_2,c_1,c_2)\sim(a_1',a_2',b_1',b_2',c_1',c_2').$$
   321	
   322	  As Euler observed,
   323	  \begin{equation}\label{p33}
   324	  p_3(x)+p_3(y) \sim x^2+2p_3(y)
   325	  \end{equation}
   326	  (cf. \cite[p.\,11]{Dickson}). H.-L. Wu and Z.-W. Sun \cite[(1)]{WuSun} proved that
   327	\begin{equation}\label{WuSunequiv}
   328	  p_3(x)+p_5(y)\sim p_5(x)+3p_5(y).
   329	\end{equation}
   330	
   331	  \begin{lemma}\label{Lem2.1} {\rm (Sun \cite[Theorem 1.9]{Sun3})} {\rm (i)}
   332	  For any $a\in\Z^+$ and $b\in\N$ with $b\ls a/2$, we have
   333	  \begin{equation}x(ax+b)+y(ay+a-b)\sim ap_3(x)+\f{y(ay+a-2b)}2.
   334	  \end{equation} In particular,
   335	  \begin{equation}\label{2p58}
   336	  2p_5(x)+p_8(y)  \sim 3p_3(x)+p_5(y).
   337	\end{equation}
   338	
   339	{\rm (ii)} We have
   340	\begin{align}
   341	x^2+p_3(y) & \sim p_5(x) + 2p_5(y), \label{SunLemma1}\\
   342	p_3(x)+2p_3(y) &\sim p_5(x)+p_8(y),\label{SunLemma2}\\
   343	x^2+4p_3(y) &\sim 4p_5(x)+p_8(y),\label{SunLemma3}
   344	\\p_3(x)+p_3(y)&\sim\f{x(5x+1)}2+\f{y(5y+3)}2.\label{513}
   345	\end{align}
   346	\end{lemma}
   347	\begin{remark} We can also deduce Lemma \ref{Lem2.1}(i) by using the identity
   348	\begin{align}  \label{2.10P}
   349		f(a, ab^2) f(b, a^2b) =& f(a, b) \psi(ab)
   350	\end{align}
   351	appeared in  \cite[Entry 30 (i)]{Adiga3}.
   352	\end{remark}
   353	
   354	
   355	  For convenience, for $a,b,c\in\Z^+$ we define
   356	  $$E(a,b,c)=\N\sm\{ax^2+by^2+cz^2:\ x,y,z\in\Z\}.$$
   357	  Dickson \cite[pp.\,112-113]{D39} listed $102$ regular ternary quadratic forms $ax^2+by^2+cz^2$
   358	  for which the structure of $E(a,b,c)$ is known explicitly.
   359	
   360	
   361	  \begin{theorem}\label{Th2.1} All the tuples
   362	\begin{align*}&(8,2,3,1,2,0),\, (8,2,3,1,3,1),\,(8,2,4,2,2,0),\, (8,2,4,2,4,0),\, (8,2,5,1,4,2),
   363	\\&(8,2,5,3,5,1),\,(8,4,6,4,6,2), \,(8,4,8,2,3,1),\,(8,4,8,4,6,4),\,(8,6,3,1,2,0),
   364	\\&(8,6,4,2,4,0),\, (8,6,4,2,4,2),\,(8,6,5,1,4,2),\,(8,6,8,4,3,1)
   365	\end{align*}
   366	are universal.
   367	\end{theorem}
   368	\Proof.  (a) To prove the universality of $(8,6,4,2,4,2)$
   369	(or the sum $x(4x+3)+y(y+1)/2+z(z+1)/2$), we observe that
   370	\begin{align*} &\ n=x(4x+3)+\f{y(y+1)}2+\f{z(z+1)}2
   371	\\\iff&\ 16n+13=(8x+3)^2+2(2y+1)^2+2(2z+1)^2.
   372	\end{align*}
   373	As $E(1,2,2)=\{4^s(8t+7):\ s,t\in\N\}$ by Dickson \cite[pp.\,112-113]{D39},
   374	for each $n\in\N$ we can write $16n+13=w^2+2u^2+2v^2$ with $w,u,v\in\Z$.
   375	As $2\nmid w$, we have $2(u^2+v^2)\eq13-w^2\eq13-1\eq4\pmod 8$ and hence $2\nmid uv$.
   376	Thus $u=2y+1$ and $v=2z+1$ for some $y,z\in\Z$. Since
   377	$$w^2\eq 13-2(u^2+v^2)\eq 13-2(1+1)=3^2\pmod {16},$$
   378	we have $w\not\eq\pm1\pmod{8}$  and hence we can write $w$ or $-w$ as $8x+3$ with $x\in\Z$.
   379	Thus $16n+13=(8x+3)^2+2(2y+1)^2+2(2z+1)^2$ as desired.
   380	
   381	Similarly, $(8,2,4,2,4,2)$ (or $x(2x+1)+y(2y+1)+z(4z+1)$) is universal,
   382	as pointed out in \cite{Sun1}. Since $(8,2,5,3,5,1)\sim (8,2,4,2,4,2)$
   383	by \eqref{513}, the tuple $(8,2,5,3,5,1)$ is also universal.
   384	
   385	(b) To prove the universality of $(8,2,3,1,2,0)$
   386	(or the sum $x^2+y(4y+1)+z(3z+1)/2$), we note that
   387	\begin{align*} &\ n=x^2+y(4y+1)+\f{z(3z+1)}2
   388	\\\iff&\ 48n+5=48x^2+3(8y+1)^2+2(6z+1)^2.
   389	\end{align*}
   390	As
   391	$$E(2,3,48)=\bigcup_{k\in\N}\{8k+1,8k+7,16k+6,16k+10,64k+24\}\cup\{9^s(3t+1):\ s,t\in\N\}$$
   392	by Dickson \cite[pp.\,112-113]{D39}, for each $n\in\N$ we can write $48n+5=48x^2+3u^2+2v^2$ with $x,u,v\in\Z$. Clearly, $2\nmid u$ and $2v^2\eq5 -3u^2\eq2\pmod 8$, thus $2\nmid uv$.
   393	As $3u^2\eq 5-2v^2\eq5-2=3\pmod{16}$, we can write $u$ or $-u$ as $8y+1$ with $y\in\Z$.
   394	Since $\gcd(v,6)=1$, we can write $v$ or $-v$ as $6z+1$ with $z\in\Z$. Hence
   395	$48n+5=48x^2+3(8y+1)^2+2(6z+1)^2$ as desired.
   396	
   397	Similarly, by using $E(2,3,48)$ we can prove the universality of $(8,6,3,1,2,0)$.
   398	
   399	(c) By Dickson \cite[pp.\,112-113]{D39}, we have
   400	\begin{align*} E(2,2,3)&=\{8k+1:\ k\in\N\}\cup\{9^s(9t+6):\ s,t\in\N\},
   401	\\E(1,2,16)&=\bigcup_{k\in\N}\{8k+5,8k+7,16k+10\}\cup\{4^s(16t+14):\ s,t\in\N\},
   402	\\E(1,2,32)&=\bigcup_{k\in\N}\{16k+14,8k+5,2(8k+5),4(8k+5)\}\cup\{4^s(8t+7):\ s,t\in\N\},
   403	\\E(2,3,12)&=\{16k+6:\ k\in\N\}\cup\{9^s(3t+1):\ s,t\in\N\},
   404	\\E(2,3,8)&=\bigcup_{k\in\N}\{8k+1,8k+7,32k+4\}\cup\{9^s(9t+6):\ s,t\in\N\},
   405	\\E(2,5,10)&=\{8k+3:\ k\in\N\}\cup\bigcup_{s,t\in\N}\{25^s(5t+1),25^s(5t+4)\},
   406	\\E(3,3,4)&=\{4k+1:\ k\in\N\}\cup\{9^s(3t+2):\ s,t\in\N\}.
   407	\end{align*}
   408	In view of this, we can easily prove that all the tuples
   409	\begin{align*}&(8,2,3,1,3,1),(8,6,3,1,3,1),(8,2,4,2,2,0),(8,2,4,2,4,0),
   410	(8,6,4,2,4,0),
   411	\\&(8,2,5,1,4,2),(8,6,5,1,4,2),(8,4,6,4,6,2),(8,4,8,2,3,1),(8,4,8,4,6,4),
   412	\\&(8,6,8,4,3,1)
   413	\end{align*}
   414	are universal.
   415	This concludes the proof. \qed
