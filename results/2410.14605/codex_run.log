def _validate_params(n: int, degree: int) -> None:
    if isinstance(n, bool) or not isinstance(n, int):
        raise ValueError("n must be an integer")
    if n < 5 or n > 1000:
        raise ValueError("n must lie in 5..1000")
    if isinstance(degree, bool) or not isinstance(degree, int):
        raise ValueError("degree must be an integer")
    if degree < 2 or degree >= n:
        raise ValueError("degree must lie in 2..n-1")


def _successor(cycle: list[int]) -> list[int]:
    out = [-1] * len(cycle)
    for i, vertex in enumerate(cycle):
        out[vertex] = cycle[(i + 1) % len(cycle)]
    return out


def _cycle_from_zero(successor: list[int]) -> list[int] | None:
    n = len(successor)
    if n == 0:
        return None
    seen: set[int] = set()
    cycle: list[int] = []
    vertex = 0
    for _ in range(n):
        if vertex in seen or not 0 <= vertex < n:
            return None
        seen.add(vertex)
        cycle.append(vertex)
        vertex = successor[vertex]
    if vertex != 0 or len(seen) != n:
        return None
    return cycle


def _contains_sorted(row: list[int], value: int) -> bool:
    i = bisect.bisect_left(row, value)
    return i < len(row) and row[i] == value


