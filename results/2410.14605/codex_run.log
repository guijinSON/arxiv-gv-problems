   418	   \begin{lemma}\label{Lem-3} {\rm (Sun \cite[Lemma 3.2]{Sun2015})} Let $w=x^2+3y^2\eq 4\ (\mo\ 8)$ with $x,y\in\Z$.
   419	Then there are odd integers $u$ and $v$ such that $w=u^2+3v^2$.
   420	\end{lemma}
   421	
   422	\begin{lemma} \label{Lem-GS} {\rm (F. Ge and Sun \cite[Lemma 2.2]{GeSun1})} Let $w=x^2+3y^2$ with $x,y$ odd and $3\nmid x$.
   423	Then there are integers $u$ and $v$ relatively prime to $6$ such
   424	that $w=u^2+3v^2$.
   425	   \end{lemma}
   426	
   427	\begin{theorem}\label{Th2.2} All the tuples
   428	\begin{align*}&(9,1,4,2,3,1),\,(9,3,9,1,3,1),\, (9,5,4,2,4,2),\ (9,5,5,3,5,1),
   429	\\&\,(9,5,8,4,2,0),\,(9,5,9,3,3,1),\,(9,7,4,2,4,2),\, (9,7,5,3,5,1),
   430	\\&  (9,7,8,4,2,0),\ (9,c,3,1,3,1)\, (c=1,5,7),\ (10,6,10,2,6,4)
   431	\end{align*}
   432	are universal.
   433	\end{theorem}
   434	\Proof. In view of \eqref{513} and the universality of $(8,4,8,4,6,4)$ mentioned in Theorem \ref{Th2.1}, we have the universality
   435	of $(10,6,10,2,6,4)$.
   436	
   437	To prove the university of $(9,1,3,1,3,1)$ (or $x(3x+1)/2+y(3y+1)/2+z(9z+1)/2$), we note that
   438	\begin{align*}&n=\f{x(3x+1)}2+\f{y(3y+1)}2+\f{z(9z+1)}2
   439	\\\iff&72n+7=3(6x+1)^2+3(6y+1)^2+(18z+1)^2.
   440	\end{align*}
   441	As $E(1,3,3)=\{9^s(3t+2):\ s,t\in\N\}$ by \cite[pp.\,112-113]{D39}, for each $n\in\N$ we can write
   442	$72n+7=w^2+3u^2+3v^2$ with $w,u,v\in\Z$. As $w^2\not\eq 7\pmod4$, $u$ or $v$ is odd.
   443	Without loss of generality, we assume that $v$ is odd. Since $w^2+3u^2\eq 7-3v^2\eq4\pmod8$, by Lemma
   444	\ref{Lem-3} we can write $w^2+3u^2$ as $w_0^2+3u_0^2$ with $w_0$ and $u_0$ odd integers.
   445	Note that $72n+7=w_0^2+3u_0^2+3v^2$. As $3\nmid w_0$, by Lemma \ref{Lem-GS} we can write $w_0^2+3u_0^2$
   446	as $w_1^2+3u_1^2$ with $w_1,u_1\in\Z$ and $\gcd(w_1u_1,6)=1$. As $2\nmid w_1v$ and $3\nmid w_1$,
   447	by Lemma \ref{Lem-GS} we can write $w_1^2+3v^2$ as $w_2^2+3v_1^2$ with $w_2,v_1\in\Z$ and $\gcd(w_2v_1,6)=1$. Write $u_1$ or $-u_1$ as $6x+1$ with $x\in\Z$, and write $v_1$ or $-v_1$
   448	as $6y+1$ with $y\in\Z$. Then $72n+7=w_2^2+3(6x+1)^2+3(6y+1)^2$. As $w_2^2\eq 7-3-3=1\pmod{36}$,
   449	we can write $w_2$ or $-w_2$ as $18z+1$. Thus $72n+1=3(6x+1)^2+3(6y+1)^2+(18z+1)^2$ as desired.
   450	
   451	By similar arguments, we can show that both $(9,5,3,1,3,1)$ and $(9,7,3,1,3,1)$ are also universal.
   452	
   453	To prove the universality of $(9,1,4,2,3,1)$ (or $x(x+1)/2+y(3y+1)/2+z(9z+1)/2$), we note that
   454	\begin{align*}&n=\f{x(x+1)}2+\f{y(3y+1)}2+\f{z(9z+1)}2
   455	\\\iff&72n+13=9(2x+1)^2+3(6y+1)^2+(18z+1)^2.
   456	\end{align*}
   457	As $E(1,1,3)=\{9^s(9t+6):\ s,t\in\N\}$ by \cite[pp.\,112-113]{D39},
   458	for each $n\in\N$ we can write $72n+13=u^2+v^2+3w^2$ with $u,v,w\in\Z$. As  $3w^2\not\eq13\pmod 4$,
   459	$u$ or $v$ is odd. Without loss of generality, we assume that $2\nmid u$.
   460	As $v^2+3w^2\eq13-u^2\eq4\pmod8$, by Lemma \ref{Lem-3} we may write $v^2+3w^2=v_1^2+3w_1^2$
   461	with $v_1$ and $w_1$ odd integers. Thus $72n+13=u^2+v_1^2+3w_1^2$ and $2\nmid uv_1w_1$.
   462	As $u^2+v_1^2\eq13\eq1\pmod3$, $u$ or $v_1$ is divisible by $3$. Without loss of generality, we assume that $u=3(2x+1)$ with $x\in\Z$. Since $2\nmid v_1w_1$ and $3\nmid v_1$, by Lemma \ref{Lem-GS} we can write
   463	$v_1^2+3w_1^2$ as $v_2^2+3w_2^2$ with $v_2,w_2\in\Z$ and $\gcd(v_2w_2,6)=1$.
   464	We may write $w_2$ or $-w_2$ as $6y+1$ with $y\in\Z$. Thus
   465	$72n+13=9(2x+1)^2+3(6y+1)^2+v_2^2$. As $v_2^2\eq 13-9-3=1\pmod{36}$, we may write $v_2$ or $-v_2$
   466	as $18z+1$ with $z\in\Z$. So $72n+13=9(2x+1)^2+3(6y+1)^2+(18z+1)^2$ as desired.
   467	
   468	In view of \eqref{WuSunequiv}, from the universality of
   469	$(9,1,4,2,3,1)$, we deduce that the tuple $(9,3,9,1,3,1)$ is universal.
   470	The tuple $(9,5,4,2,3,1)$ is known to be universal (cf. \cite[Theorem 1.2(ii)]{Sun2}),
   471	so $(9,5,9,3,3,1)$ is also universal with the aid of \eqref{WuSunequiv}.
   472	
   473	To prove the universality of $(9,5,4,2,4,2)$ (or $x(x+1)/2+y(y+1)/2+z(9z+5)/2$), we note that
   474	\begin{align*}&n=\f{x(x+1)}2+\f{y(y+1)}2+\f{z(9z+5)}2
   475	\\\iff& 72n+43=9(2x+1)^2+9(2y+1)^2+(18z+5)^2.
   476	\end{align*}
   477	As $E(1,1,1)=\{4^s(8t+7):\ s,t\in\N\}$ (cf. \cite[pp.\,112-113]{D39}, for each $n\in\N$ we can write
   478	$72n+43=u^2+v^2+w^2$ with $u,v,w\in\Z$. As $u^2+v^2+w^2\eq43\eq3\pmod8$, we have $2\nmid uvw$.
   479	Since $u^2+v^2+w^2\eq1\pmod3$, without loss of generality we may assume that both $u$ and $v$
   480	are divisible by $3$. Thus  $u=3(2x+1)$ and $v=3(2y+1)$ for some $x,y\in\Z$.
   481	As $w^2\eq43-9-9=5^2\pmod{36}$, we may write $w$ or $-w$ as $18z+5$ with $z\in\Z$.
   482	So $72n+43=9(2x+1)^2+9(2y+1)^2+(18z+5)^2$ as desired.
   483	
   484	Similarly, we can prove that $(9,7,4,2,4,2)$ is universal.
   485	
   486	For $c=5,7$ we have
   487	$$ (9,c,5,3,5,1)\sim(9,c,4,2,4,2)\sim(9,c,8,4,2,0)$$
   488	by \eqref{513} and \eqref{p33}. Since $(9,5,4,2,4,2)$ and $(9,7,4,2,4,2)$ are universal, the tuples
   489	$$(9,5,5,3,5,1),\ (9,5,8,4,2,0),\ (9,7,5,3,5,1),\ (9,7,8,4,2,0)$$
   490	are also universal.
   491	
   492	In view of the above, we have completed the proof of Theorem \ref{Th2.2}. \qed
   493	
   494	The following known lemma can be found in \cite[Lemma 2.1]{Sun2015}.
   495	
   496	  \begin{lemma}\label{Lem-m}  Let $w=x^2+my^2$ be a positive integer
   497	with $m\in\{2,5,8\}$ and $x,y\in\Z$. Then we can write $w$ in the form $u^2+mv^2$ with $u,v\in\Z$
   498	such that $u$ or $v$ is not divisible by $3$.
   499	  \end{lemma}
   500	
   501	  The following lemma follows from \cite[Lemma 2.2(i)]{S16} (or the comments around \cite[(1.4)]{Sun2015}).
   502	
   503	  \begin{lemma}\label{Lem-9} If $x,y,z\in\Z$ are not all divisible by $3$, then
   504	  $9(x^2+y^2+z^2)=u^2+v^2+w^2$ for some $u,v,w\in\Z$ not all divisible by $3$.
   505	  \end{lemma}
   506	
   507	 \begin{theorem}\label{Th2.3} All the tuples
   508	\begin{align*}&(12,4,3,1,2,0),\,(12,4,6,4,6,2), \,(12,8,3,1,3,1),
   509	\\&(12,6,8,2,3,1),\, (12,6,8,6,3,1),\,(12,8,3,1,2,0),\,(12,8,5,3,5,1),
   510	\\&(12,8,4,2,4,2),\,(12,8,8,4,2,0),\,(12,8,8,4,3,1),\,(12,8,12,4,2,0)
   511	\end{align*}
   512	are universal.
   513	\end{theorem}
   514	\Proof. To prove the universality of $(12,4,3,1,2,0)$ (or $x^2+2y(3y+1)+z(3z+1)/2$), we observe that
   515	\begin{align*}&n=x^2+2y(3y+1)+\f{z(3z+1)}2
   516	\\\iff&24n+5=24x^2+4(6y+1)^2+(6z+1)^2.
   517	\end{align*}
   518	By Dickson \cite[pp.\,112-113]{D39},
   519	$$E(1,4,24)=\bigcup_{k\in\N}\{4k+2,4k+3\}\cup\{9^s(9t+3):\ s,t\in\N\}.$$
   520	Thus, for each $n\in\N$ we can write $24n+5=24x^2+4u^2+v^2$ with $x,u,v\in\Z$.
   521	Clearly, $2\nmid v$. As $4u^2\eq5-v^2\eq4\pmod8$, $u$ is also odd. Since
   522	$u^2+v^2\eq 4u^2+v^2\eq5\eq2\pmod3$, we have $3\nmid uv$. As $uv$ is relatively prime to $6$,
   523	we can write $u$ or $-u$ as $6y+1$, and write $v$ or $-v$ as $6z+1$, where $y$ and $z$ are integers.
   524	Now, $n=24x^2+4(6y+1)^2+(6z+1)^2$ as desired.
   525	
   526	To prove the universality of $(12,6,8,2,3,1)$ (or $3x(x+1)/2+y(3y+1)/2+z(4z+1)$), we note that
   527	\begin{align*}&n=3\f{x(x+1)}2+\f{y(3y+1)}2+z(4z+1)
   528	\\\iff&48n+23=18(2x+1)^2+2(6y+1)^2+3(8z+1)^2.
   529	\end{align*}
   530	By Dickson \cite[pp.\,112-113]{D39},
   531	$$E(2,3,18)=\bigcup_{k\in\N}\{3k+1,8k+1\}\cup\{9^s(9t+3):\ s,t\in\N\}.$$
   532	Thus, for each $n\in\N$ we can write $48n+23=18u^2+2v^2+3w^2$ with $u,v,w\in\Z$.
   533	Clearly, $2\nmid w$. Since $2(u^2+v^2)\eq 23-3w^2\eq4\pmod{8}$, we have $2\nmid uv$.
   534	Note also that $3\nmid v$. So we may write $u=2x+1$ with $x\in\Z$, and $v$ or $-v$ as $6y+1$
   535	with $y\in\Z$. As $3w^2\eq 23-2u^2-2v^2\eq 23-2-2\eq3\pmod{16}$, we may write $w$ or $-w$ as
   536	$8z+1$ with $z\in\Z$. Thus $48n+23=18(2x+1)^2+2(6y+1)^2+3(8z+1)^2$ as desired.
   537	Similarly, $(12,6,8,6,3,1)$ is universal.
   538	
   539	By similar arguments, we can prove that $(12,8,3,1,2,0)$ is universal by using
   540	$$E(1,16,24)=\bigcup_{k\in\N}\{4k+2,4k+3,8k+5,64k+8\}\cup\{9^s(9t+3):\ s,t\in\N\}$$
   541	(cf. \cite[pp.\,112-113]{D39}).
   542	We can also prove that $(12,8,8,4,3,1)$ is universal by using
   543	$$E(1,6,16)=\bigcup_{k\in\N}\{8k+3,8k+5,16k+2,16k+14,64k+8\}\cup\{9^s(9t+3):\ s,t\in\N\}$$
   544	(cf. \cite[pp.\,112-113]{D39}), and that the three tuples
   545	$$(12,8,5,3,5,1),\ (12,8,4,2,4,2) \ \t{and}\ (12,8,8,4,2,0)$$
   546	(which are equivalent in view of \eqref{p33} and \eqref{513})
   547	are universal by using
   548	$$E(3,8,12)=\bigcup_{k\in\N}\{4k+1,4k+2\}\cup\{9^s(3t+1):\ s,t\in\Z\}$$
   549	(cf. \cite[pp.\,112-113]{D39}).
   550	Also, we can prove that $(12,8,12,4,2,0)$ is universal by using
   551	$$E(1,4,6)=\{16k+2:\ k\in\N\}\cup\{9^s(9t+3):\ s,t\in\N\}$$
   552	(cf. \cite[pp.\,112-113]{D39}).
   553	
   554	To prove the universality of $(12,4,6,4,6,2)$ (or $2x(3x+1)+y(3y+1)+z(3z+2)$), we note that
   555	\begin{align*}&n=2x(3x+1)+y(3y+1)+z(3z+2)
   556	\\\iff&12n+7=2(6x+1)^2+(6y+1)^2+4(3z+1)^2.
   557	\end{align*}
   558	As $E(1,2,4)=\{4^s(16t+14):\ s,t\in\N\}$ (cf. \cite[pp.\,112-113]{D39}),
   559	for each $n\in\N$ we can write $12n+7$ as $u^2+2v^2+4w^2=u^2+2(v^2+2w^2)$ with $u,v,w\in\Z$.
   560	By Lemma \ref{Lem-m}, without loss of generality, we may assume that $u$ or $v$ is not divisible by $3$, and also $v$ or $w$ is not divisible by $3$. If $3\mid v$, then $3\nmid uw$ and also

