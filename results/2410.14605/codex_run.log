   941	\begin{equation}\label{almThm2.3}\begin{aligned}
   942	 &\ f(q^{12},q^{36})f(q,q^2)f(q^2,q^4)
   943	 \\=&\ f(q^9,q^9)f(q^{12},q^{36})f(q^{3},q^{6})+qf(q^{12},q^{36})f(q^3,q^6)f(q^3,q^{15})
