   818	 &&&&$(12,6,9,7,3,1)$ \\ \hline
   819	  \end{tabular}
   820	\end{center}
   821	\medskip
   822	
   823	The universality of $(36,18,9,3,3,1)$ in the above table follows from
   824	 the universality of the tuple $(36,18,4,2,3,1)$ (or the sum $p_3+9p_3+p_5$)
   825	 (which was conjectured by \cite[Conjecture 1.13]{Sun2015} and confirmed by Ju, Oh and Seo \cite{JuOhSeo}, since $(36,18,4,2,3,1) \sim (36,18,9,3,3,1)$ by \eqref{WuSunequiv}.
   826	
   827	
   828	Using \eqref{aAthm13u1}, we have
   829	\begin{equation}\label{aAthm13u2}
   830	 \varphi(q^3) X(q)X(q^2)=\varphi(q^3)\varphi(q^9)X(q^3)+q\varphi(q^3)X(q^3)Y(q^3)+2q^2\varphi(q^3)\psi(q^9)Y(q^3).
   831	\end{equation}
   832	Sun \cite[Section 3]{Sun2} showed  the universality of  the tuple $(6, 2, 6, 0, 3, 1)$ over $\mathbb{Z}$. Combining this with the third term of \eqref{aAthm13u2} and Theorem \ref{Th1.1}(i), we get the universality of the tuple $(12,6,6,4,2,0)$.
   833	
   834	Again, using \eqref{aAthm13u1}, we find that
   835	\begin{equation}\label{aAthm13u3}
   836	 \psi(q^3) X(q)X(q^2)=\varphi(q^9)\psi(q^3)X(q^3)+q\psi(q^3)X(q^3)Y(q^3)+2q^2\psi(q^3)\psi(q^9)Y(q^3).
   837	\end{equation}
   838	By \cite{GPS}, $x^2+p_3(y)+3p_3(z)$ is universal.
   839	So the tuple $(12, 6, 6, 2, 3, 1)$ is universal over $\mathbb{Z}$ with the aid of \eqref{SunLemma1}.
   840	Combining this with the third term of the identity  \eqref{aAthm13u3} and Theorem \ref{Th1.1}(i), we obtain the universality of the tuple $(12,6,6,4,4,2)$.
   841	
   842	 From \eqref{aAthm13u1}, we obtain
   843	\begin{equation}\label{aAthm13u4}
   844	 \psi(q^6) X(q)X(q^2)=\varphi(q^9)\psi(q^6)X(q^3)+q\psi(q^6)X(q^3)Y(q^3)+2q^2\psi(q^6)\psi(q^9)Y(q^3).
   845	\end{equation}
   846	As $x^2+p_3(y)+6p_3(z)$ is universal by \cite{GPS}, the tuple $(24, 12, 6, 2, 3, 1)$ is universal
   847	in view of \eqref{SunLemma1}.
   848	This, together with the third term of the identity  \eqref{aAthm13u4} and Theorem \ref{Th1.1}(i), yields the universality of the tuple $(12,6,8,4,6,4)$.
   849	
   850	Using \eqref{Athm20u1}, we find that
   851	 \begin{equation}\label{Athm23u8}
   852	 \psi\left(q^{2}\right) X\left(q^{2}\right) Y(q)= \psi\left(q^{2}\right) X\left(q^{2}\right) X\left(q^8\right)+q  \psi\left(q^{2}\right) X\left(q^{2}\right) Y\left(q^4\right).
   853	\end{equation}
   854	By \cite[Theorem 1.11]{Sun2015}, the tuple $(12, 6, 8, 4, 3, 1)$ is universal over $\mathbb{Z}$.
   855	In view of \eqref{2p58}, this is equivalent to the university of
   856	  $(8,4,6,4,6,2)$. Combining this with the second term of \eqref{Athm23u8} and Theorem \ref{Th1.1}(i), we see that the tuple $(12,8,4,2,3,1)$ is universal.
   857	
   858	From \eqref{Athm20u1}, we obtain
   859	  \begin{equation}\label{Athm21u3}
   860	     X\left(q^4\right)Y(q)Y\left(q^2\right)= X\left(q^4\right)X\left(q^8\right)Y\left(q^2\right)+q X\left(q^4\right)Y\left(q^2\right)Y\left(q^4\right).
   861	  \end{equation}
   862	  Since $(24,12,6,4,6,2)$ is universal by Sun \cite{Sun1}, with the aid of
   863	  \eqref{2p58} we see that the tuple $(12,8,12,4,6,4)$ is also universal. Combining this with the second term of the identity  \eqref{Athm21u3} and Theorem \ref{Th1.1}(i), we obtain the universality of the tuple $(12,8,6,4,6,2)$. Hence $(16,8,8,4,6,4)$ is also universal in light of \eqref{SunLemma2}.
   864	
   865	In view of \eqref{Athm20u1}, we have
   866	\begin{equation}\label{Athm21u5}
   867	  X\left(q^2\right)X\left(q^6\right)Y\left(q\right)= X\left(q^2\right)X\left(q^6\right)X\left(q^8\right)  +qX\left(q^2\right)X\left(q^6\right)Y\left(q^4\right).
   868	\end{equation}
   869	Since  the tuple $(18,6,6,4,6,2)$  is universal by Theorem \ref{Th2.4},
   870	  applying Theorem \ref{Th1.1}(i) to the second term of \eqref{Athm21u5} we get the universality of the tuple $(12,8,9,3,3,1)$.
   871	
   872	To determine the universality of the tuple $(12,8,12,6,3,1)$, using \eqref{Athm20u1} we have
   873	  \begin{equation}\label{Athm20u5}
   874	 \psi(q^6)X(q^2) Y(q)=\psi(q^6)X(q^2)X(q^8)+q\psi(q^6)X(q^2)Y(q^4).
   875	  \end{equation}
   876	  Sun \cite{Sun1} proved that the sum $x(3x+1)+y(3y+2)+z(3z+3)$ (or $(24,12,6,4,6,2)$) is universal. Thus, in light of
   877	  the second term of  \eqref{Athm20u5} and Theorem \ref{Th1.1}(i), we obtain the universality of
   878	$(12,8,12,6,3,1)$.
   879	
   880	Using \eqref{appli12}, we have
   881	\begin{equation}\label{univ2}
   882	  \varphi(q)\psi\left(q^{4}\right) X\left(q^{2}\right)=\varphi\left(q^4\right)\psi\left(q^{4}\right) X\left(q^{2}\right)+2q\psi\left(q^{4}\right) \psi\left(q^8\right)X\left(q^{2}\right).
   883	\end{equation}
   884	By the paragraph containing \eqref{Athm23u6}, the tuples $(8,4,4,0,3,1)$ and $(16,8,8,4,3,1)$ are both universal. Thus, applying Theorem \ref{Th1.1}(i) to the identity
   885	 \eqref{univ2} we get the universality of the tuple $(16,8,6,2,2,0)$.
   886	
   887	 In view of the above, we have completed the proof of Theorem \ref{Th1.2}. \qed
   888	\medskip
   889	
   890	As mentioned in Section 2, the tuples $(20,10,5,1,3,1)$ and $(20,10,5,3,3,1)$
   891	were proved to be universal in \cite[Theorem 1.1(iv)]{Sun3} via the theory of ternary quadratic forms.
   892	Now we give a new proof by using our approach via theta functions.
   893	 Using \cite[Corollary 2.11]{Cao} with $a=q$, $b=q^4$, $c=q^2$ and $d=q^3$, we obtain
   894	\begin{align*}
   895	f(q,q^4) f(q^2,q^3)= &f^2(q^{10},q^{15}) +q f(q^{15},q^{10}) f(q^{20},q^{5})+q^2 f^2(q^{20},q^{5}) \nonumber \\  &+2q^3 \psi (q^{25} ) f(q^{15},q^{10})+2q^4 \psi (q^{25})  f(q^{20},q^{5}),
   896	\end{align*}
   897	and hence
   898	\begin{align}\label{Athm25u1}
   899	X(q^{5}) f(q,q^4) f(q^2,q^3)= &X(q^{5}) f^2(q^{10},q^{15}) +qX(q^{5})  f(q^{15},q^{10}) f(q^{20},q^{5})\nonumber \\  &+q^2 X(q^{5}) f^2(q^{20},q^{5})   +2q^3\psi (q^{5})  X(q^{25} ) f(q^{15},q^{10})\nonumber \\  &+2q^4 X(q^{5}) \psi (q^{25})  f(q^{20},q^{5}),
   900	\end{align}

