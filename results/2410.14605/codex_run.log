   573	for each $n\in\N$ we can write $24n+18$ as a sum of three squares.
   574	In view of Lemma \ref{Lem-9}, we may write $24n+18=u^2+v^2+w^2$ with $u,v,w\in\Z$ not all divisible by $3$. As $u^2+v^2+w^2\eq0\pmod3$, we must have $3\nmid uvw$. Without loss of generality, we may assume that $w$ is even. As $u^2+v^2\eq 18\eq2\pmod4$, we have $2\nmid uv$. Note that $w^2\eq 18-u^2-v^2\eq0\pmod 8$
   575	and hence $w\eq0\pmod4$. We may write $w$ or $-w$ as $4(3x+1)$ with $x\in\Z$. Also, we may write $u$ or $-u$ as $6y+1$ with $y\in\Z$, and write $v$ or $-v$ as $6z+1$ with $z\in\Z$. Thus
   576	$24n+18=16(3x+1)^2+(6y+1)^2+(6z+1)^2$ as desired.
   577	This ends the proof. \qed
   578	
   579	\begin{theorem}\label{Th2.4} All the tuples
   580	\begin{align*}&(16,8,6,4,4,0),\,(16,8,6,4,4,2),\,(18,6,6,4,6,2),
   581	\\&(20,10,5,1,4,2),\,(20,10,5,3,4,2),\,(24,12,6,2,2,0)
   582	\end{align*} are universal.
   583	\end{theorem}
   584	\Proof. In view of \eqref{p33}, we have $(16,8,6,4,4,0)\sim(8,4,8,4,6,4)$. As $(8,4,8,4,6,4)$
   585	is universal by Theorem \ref{Th2.1}, the tuple $(16,8,6,4,4,0)$ is also universal.
   586	
   587	To prove the universality of $(16,8,6,4,4,2)$ (or $x(x+1)/2+2y(y+1)+z(3z+2)$), we note that
   588	\begin{align*}&n=\f{x(x+1)}2+2y(y+1)+z(3z+2)
   589	\\\iff&24n+23=3(2x+1)^2+12(2y+1)^2+8(3z+1)^2.
   590	\end{align*}
   591	As
   592	$$E(3,8,12)=\bigcup_{k\in\N}\{4k+1,4k+2\}\cup\{9^s(3t+1):\ s,t\in\N\}$$
   593	by \cite[pp.\,112-113]{D39}, for each $n\in\N$ we can write $24n+23$
   594	as $3u^2+12v^2+8w^2$ with $u,v,w\in\Z$. Clearly $u$ is odd.
   595	As $12v^2\eq23-3u^2\eq 20\not\eq0\pmod{8}$, $v$ is odd. So $u=2x+1$ and $v=2y+1$ for some $x,y\in\Z$.
   596	Since $8w^2\eq 23\pmod3$, we can write $w$ or $-w$ as $3z+1$ with $z\in\Z$.
   597	Therefore $24n+23=3(2x+1)^2+12(2y+1)^2+8(3z+1)^2$ as desired.
   598	
   599	By \eqref{WuSunequiv}, we have $(18,6,6,4,6,2)\sim(8,4,6,4,6,2)$. Since $(8,4,6,4,6,2)$
   600	is universal by Theorem \ref{Th2.1}, the tuple $(18,6,6,4,6,2)$ is also universal.
   601	
   602	 To prove the universality of $(20,10,5,1,4,2)$ (or the sum $x(x+1)/2+5y(y+1)/2+z(5z+1)/2$), we note that
   603	\begin{align*}&\ n=\f{x(x+1)}2+5\f{y(y+1)}2+\f{z(5z+1)}2
   604	\\\iff&\ 40n+31=5(2x+1)^2+25(2y+1)^2+(10z+1)^2.
   605	\end{align*}
   606	By Dickson \cite[pp.\,112-113]{D39},
   607	$$E(1,5,25)=\bigcup_{k\in\N}\{5k+2,5k+3,25k+10,25k+15\}\cup\{4^s(8t+3):\ s,t\in\N\}.$$
   608	Thus, for any $n\in\N$ we can write $40n+31$ as $w^2+5u^2+25v^2$ with $w,u,v\in\Z$.
   609	If $w$ is even, then
   610	$$u^2+v^2\eq 5u^2+25v^2\eq 31-w^2\eq3\pmod 4$$
   611	which is impossible. Note also that $w^2\eq31\eq1\pmod5$ and hence $w\eq\pm1\pmod5$.
   612	Thus, $w$ or $-w$ can be written as $10z+1$ with $z\in\Z$. As $u^2+v^2\eq 31-w^2\eq2\pmod4$,
   613	we have $2\nmid uv$. Thus $u=2x+1$ and $v=2y+1$ for some $x,y\in\Z$. Therefore
   614	$$40n+31=w^2+5u^2+25v^2=5(2x+1)^2+25(2y+1)^2+(10z+1)^2$$
   615	as desired.
   616	
   617	Similarly, we can prove that the tuple $(20,10,5,3,4,2)$ is universal.
   618	
   619	In view of \eqref{2p58}, we have $(24,12,6,2,2,0)\sim(12,8,12,4,2,0)$.
   620	As $(12,8,12,4,2,0)$ is universal by Theorem \ref{Th2.3}, the tuple $(24,12,6,2,2,0)$
   621	is also universal.
   622	
   623	In view of the above, we have completed the proof of Theorem \ref{Th2.4}. \qed
   624	
   625	For a  tuple $(a_1,a_2,b_1,b_2,c_1,c_2)$ with related ternary quadratic form having class number $2$, occasionally we may employ the following lemma to prove its universality.
   626	
   627	\begin{lemma}\label{Lem-genus} {\rm (\cite[Theorem 1.3]{C})} Let $f$ be an integral quadratic form with nonzero discriminant. If an integer $m$ is represented by $f$ over the field of real numbers
   628	as well as the ring $\Z_p$ of $p$-adic integers for each prime $p$, then $m$ is represented over $\Z$ by some form $f^*$ in the same genus as $f$.
   629	\end{lemma}
   630	
   631	For example, the tuples $(20,10,5,1,3,1)$ and $(20,10,5,3,3,1)$
   632	were proved to be universal in \cite[Theorem 1.1(iv)]{Sun3} with the aid of Lemma \ref{Lem-genus}.
   633	There are two classes in the genus of the related quadratic form $3x^2+3y^2+5z^2$, the one not containing $3x^2+3y^2+5z^2$ has the representative
   634	$3x^2+2y^2+8z^2-2yz$.
   635	
   636	
   637	
   638	\section{An approach via Ramanujan's theta functions}\label{UnivSec}
   639	
   640	Now we turn to a new approach to universal sums via Ramanujan's theta fundtions.
   641	
   642	\medskip
   643	\noindent{\tt Proof of Theorem \ref{Th1.1}}. Let $|q|<1$. For $a,b\in\Z$ with $a+b>0$, clearly
   644	$|q^aq^b|<1$ and
   645	$$f(q^a,q^b)=\sum_{x=-\infty}^\infty q^{ax(x+1)/2+bx(x-1)/2}=\sum_{x=-\infty}^\infty q^{x((a+b)x+a-b)/2}.$$
   646	
   647	For any $n\in\N$, let $R(n)$ denote the number of triples $(x,y,z)\in\Z^3$ satisfying the equation
   648	$$\f{x((i+j)x+i-j)}2+\f{y((s+t)y+s-t)}2+\f{z((u+v)z+u-v)}2=n,$$
   649	and let $R_r(n)$ (with $1\ls r\ls k$) denote the number of ways to write $n$ as
   650	$$ \f{x((a_{1r}+a_{2r})x+a_{1r}-a_{2r})}2+\f{y((b_{1r}+b_{2r})y+b_{1r}-b_{2r})}2
   651	+\f{z((c_{1r}+c_{2r})z+c_{1r}-c_{2r})}2$$
   652	with $(x,y,z)\in\Z^3$.
   653	
   654	For any fixed $n\in\N$ and $r\in\{1,\ldots,k\}$, by comparing coefficients of $q^{kn+r-1}$
   655	on both sides of \eqref{=}, we obtain
   656	\begin{equation}\label{kn+r}R(kn+r-1)=m_rR_r(n).
   657	\end{equation}
   658	Thus, for any $n_0\in\N$, we have
   659	\begin{equation}\label{n0}\begin{aligned} & R_r(n)>0\ \t{for all}\ r=1,\ldots,k\ \t{and}\ n=n_0,n_0+1,\ldots
   660	\\ &\ \ \iff  R(n)>0\ \t{for every integer}\ n\gs kn_0.
   661	\end{aligned}
   662	\end{equation}
   663	When $n_0=0$, this yields part (i) of Theorem \ref{Th1.1}.
   664	As \eqref{n0} holds for any $n_0\in\N$, we also have part (ii) of Theorem \ref{Th1.1}.
   665	This concludes the proof. \qed
   666	
   667	\begin{remark} In view of \eqref{kn+r}, $|\{n\in\N:\ R(n)=0\}|=1$, if and only if for certain $1\ls r_0\ls k$ we have
   668	$|\{n\in\N:\ R_{r_0}(n)=0\}|=1$ and $R_r(n)>0$ for all $r\in\{1,\ldots,k\}\sm\{r_0\}$ and $n\in\N$.
   669	\end{remark}
   670	
   671	In $2023$, Ju \cite{Ju} classified  all almost universal sums of triangular numbers with one exception.
   672	Furthermore, he provided an effective criterion for almost universality
   673	with one exception of an arbitrary sum of triangular numbers, which might be considered as a
   674	natural generalization of the 15-theorem of Conway, Miller and Schneeberger (cf. \cite{CGSS}).
   675	
   676	To apply Theorem \ref{Th1.1}, we need to make certain preparation.
   677	
   678	Let $a$ and $b$ be complex numbers with $|ab|<1$. The Ramanujan theta function $f(a,b)$ satisfies the following
   679	basic properties \cite{Adiga3}:
   680	\begin{align}\label{2.3}f(a,b)& = f(b,a)\\
   681	\intertext{and}
   682	\label{2.4}f(1,a)& = 2f(a,a^{3}).
   683	\end{align}
   684	The functions $\varphi(q)$ given by \eqref{2.7}, $\psi(q)$ given by \eqref{2.8},
   685	\begin{equation}\label{X(q)}
   686	 X(q):= f(q,q^2) =  \sum_{x=-\infty}^{\infty} {q^{x(3x+1)/2}}
   687	 \end{equation}
   688	 and
   689	\begin{equation}\label{Y(q)} Y(q):= f(q,q^5) =  \sum_{x=-\infty}^{\infty} {q^{x(3x+2)}}
   690	\end{equation}
   691	are related to the squares, the triangular numbers, the generalized  pentagonal numbers and the generalized octagonal  numbers, respectively.
   692	In general, the  theta function $f(q, q^{m-3})$ with $m\gs3$
   693	is related to the generalized $m$-gonal numbers  $p_m(x)$ $(x\in\Z)$.
   694	
   695	Let $|ab|<1$. The following general formula is due to  Ramanujan (cf. \cite[ Entry 31]{Adiga3}:
   696	\begin{equation}\label{RamIden}
   697	  f(U_1,V_1)=\sum_{r=0}^{n-1}U_r f \left( \frac{U_{n+r}}{U_r},\frac{V_{n-r}}{U_r}  \right),
   698	\end{equation}
   699	where
   700	$$U_k=a^{k(k+1)/2}b^{k(k-1)/2}\ \ \t{and}\ \ V_k=a^{k(k-1)/2}b^{k(k+1)/2}.$$
   701	This result implies the following lemma.
   702	
   703	\begin{lemma} \label{Lem-3.1} For $|q|<1$, we have
   704	\begin{align}\label{appli12}
   705	  \varphi(q)&=\varphi\left(q^4\right)+2q\psi\left(q^8\right),\\
   706	  \label{AAthm16.3}  \psi(q)&=f\left(q^6,q^{10}\right)+qf\left(q^2,q^{14}\right),\\
   707	  \label{Athm20u1}  Y(q)&=X\left(q^8\right)+qY\left(q^4\right),\\
   708	  \label{AAthm216aa} X(q)&= f\left(q^{12},q^{15}\right)+qf\left(q^{6},q^{21}\right)+q^2f\left(q^{3},q^{24}\right).
   709	\end{align}
   710	\end{lemma}
   711	
   712	Let $|q|<1$. In \cite[(50)]{Adiga2}, setting $k=3$, $l=2$ and $\varepsilon_1=\varepsilon_2=1$,  we obtain
   713	\begin{equation}\label{aAthm13u1}
   714	  X(q)X(q^2)=\varphi(q^9)X(q^3)+qX(q^3)Y(q^3)+2q^2\psi(q^9)Y(q^3).
   715	\end{equation}
   716	 In \cite[(15)]{Adiga2}, setting $k=3$,  $l=2$, $g=5$, $h=1$, $u=2$, $v=1$ and $\varepsilon_1=\varepsilon_2=1$,  we obtain
   717	\begin{equation}\label{aAthm13u6}
   718	  X(q)Y(q)=X(q^3)X(q^6)+2q\psi(q^9)X(q^6)+2q^2\psi(q^{18})X(q^3).
   719	\end{equation}
   720	
   721	Lemma \ref{Lem-3.1} and the identities \ref{aAthm13u1} and \ref{aAthm13u6} will be used in the next two sections.
   722	
   723	\section{Proof of Theorem \ref{Th1.2}}\label{Sec4}
   724	
   725	\medskip
   726	\noindent{\tt Proof of Theorem \ref{Th1.2}}.
   727	Let $|q|<1$. Multiplying both sides of the identity \eqref{AAthm16.3} by $f(q^6,q^4)f(q^4,q^2)$, we get
   728	  \begin{equation}\label{Athm22u2}
   729	     f(q^6,q^4)f(q^4,q^2)f(q^3,q)=f(q^{10},q^6)f(q^6,q^4)f(q^4,q^2)+qf(q^{14},q^2)f(q^6,q^4)f(q^4,q^2).
   730	  \end{equation}
   731	Recall that the tuple  $(10,2,6,2,4,2)$ (or the sum  $x(2x+1)+y(3y+1)+z(5z+1)$) is universal as
   732	conjectured by Sun \cite{Sun1} and confirmed by
   733	  Ju and Oh \cite{JuOh}. Thus, by applying  Theorem \ref{Th1.1}(i) to the identity
   734	  \eqref{Athm22u2}, we find that
   735	the tuples $(8,2,5,1,3,1)$ and $(8,6,5,1,3,1)$ are universal.
   736	
   737	
   738	Using \eqref{AAthm16.3}, we find that
   739	  \begin{equation}\label{Athm22u21}
   740	 \psi(q)\psi(q^2)f(q^2,q^8)=f\left(q^6,q^{10}\right)\psi(q^2)f(q^2,q^8)+qf\left(q^2,q^{14}\right)\psi(q^2)f(q^2,q^8).
   741	\end{equation}
   742	Sun \cite{Sun2015} determined the universality of the tuple $(10,6,8,4,4,2)$ (or the sum $p_3+2p_3+2p_7$). Thus, using the first term of the identity
   743	  \eqref{Athm22u21} with the help of Theorem \ref{Th1.1}(i), we see that the tuple $(8,2,5,3,4,2)$ is universal.
   744	  From \eqref{AAthm16.3}, we obtain
   745	  \begin{equation}\label{Athm22u3}
   746	     \psi(q)X\left(q^2\right)f\left(q^6,q^{8}\right)=X\left(q^2\right)f\left(q^6,q^{10}\right)f\left(q^6,q^{8}\right)+qX\left(q^2\right)f\left(q^2,q^{14}\right)f\left(q^6,q^{8}\right).
   747	  \end{equation}
   748	   Ju and Oh \cite{JuOh} proved that the sum $x(2x+1)+y(3y+1)+z(7z+1)$ (or the tuple $(14,2,6,2,4,2)$) is universal as conjectured by Sun \cite{Sun1}.
   749	  Thus the identity  \eqref{Athm22u3} with the help of Theorem \ref{Th1.1}(i), yields the universality of the tuples $(8,2,7,1,3,1)$ and $(8,6,7,1,3,1)$.
   750	
   751	  By \eqref{AAthm16.3}, we have
   752	  \begin{equation}\label{univ1}
   753	   \psi(q)X(q^2)X(q^4)=X(q^2)X(q^4)f\left(q^6,q^{10}\right)+qX(q^2)X(q^4)f\left(q^2,q^{14}\right).
   754	  \end{equation}
   755	  Sun \cite{Sun} proved that the tuple $(8,4,4,2,4,0)$ is  universal. As $(8,4,4,2,4,0) \sim (12,4,6,2,4,2)$ by \eqref{SunLemma1}, the tuple  $(12,4,6,2,4,2)$ is universal.
   756	  Combining this with the first term of \eqref{univ1} and Theorem \ref{Th1.1}(i), we obtain the universality of the tuple $(8,2,6,2,3,1)$.
   757	
   758	  Using \eqref{AAthm16.3}, we find that
   759	 \begin{equation}\label{Athm16.8au}
   760	   \psi(q)\psi\left(q^2\right)Y\left(q^2\right)=\psi\left(q^2\right)Y\left(q^2\right)f\left(q^{6},q^{10}\right)+q\psi\left(q^2\right)Y\left(q^2\right)f\left(q^2,q^{14}\right).
   761	 \end{equation}
   762	As conjectured by Sun \cite[Conjecture 1.13]{Sun2015} and confirmed by
   763	Ju, Oh and Seo \cite{JuOhSeo}, the tuple $(12,8,8,4,4,2)$  is universal.
   764	Combining this with the identity  \eqref{Athm16.8au} and Theorem \ref{Th1.1}(i), we get the universality of the tuples $(8,2,6,4,4,2)$ and $(8,6,6,4,4,2)$.
   765	
   766	  In view of \eqref{AAthm16.3},
   767	\begin{equation}\label{Athm16.10au}
   768	  \psi(q)X\left(q^4\right)Y\left(q^2\right)=X\left(q^4\right)Y\left(q^2\right)f\left(q^{6},q^{10}\right)+qX\left(q^4\right)Y\left(q^2\right)f\left(q^2,q^{14}\right).
   769	 \end{equation}
   770	  It is known (cf. \cite{Sun2}) that the tuple $(24, 12, 6, 2, 4, 2)$ is universal.
   771	   By \eqref{2p58}, $(24, 12, 6, 2, 4, 2) \sim (12,8,12,4,4,2)$. Thus the tuple $(12,8,12,4,4,2)$ is also universal.
   772	  Combining this with \eqref{Athm16.10au} and Theorem \ref{Th1.1}(i), we obtain the universality of the tuples $(8,2,6,4,6,2)$ and $(8,6,6,4,6,2)$.
   773	
   774	Using \eqref{appli12}, we find that
   775	\begin{equation}\label{Athm23u6} \begin{aligned}
   776	 \varphi\left(q\right) \varphi\left(q^{2}\right) X\left(q^{4}\right)=&\ \varphi\left(q^4\right) \varphi\left(q^{8}\right) X\left(q^{4}\right)+2q \varphi\left(q^8\right) \psi\left(q^{8}\right) X\left(q^{4}\right) \\
   777	 &\ +2q^2\varphi\left(q^4\right) \psi\left(q^{16}\right) X\left(q^{4}\right)+4q^3\psi\left(q^8\right) \psi\left(q^{16}\right) X\left(q^{4}\right).
   778	 \end{aligned}
   779	 \end{equation}
   780	By Sun \cite[Theorem 1.2(i)]{Sun2}, the tuple $(12,4,4,0,2,0)$ is universal. Thus, by
   781	 applying Theorem \ref{Th1.1}(i) on the identity \eqref{Athm23u6}, we see that the second term and the fourth term yield the universality of the tuples
   782	  $(8,4,4,0,3,1)$ and $(16,8,8,4,3,1)$.
   783	
   784	From  \eqref{Athm20u1}, we have
   785	\begin{equation}\label{univ3}
   786	   \varphi\left(q^2\right) \psi\left(q^{2}\right) Y(q)= \varphi\left(q^2\right) \psi\left(q^{2}\right)X\left(q^8\right)+q \varphi\left(q^2\right) \psi\left(q^{2}\right)Y\left(q^4\right).
   787	\end{equation}
   788	Since the tuples $(12,4,4,2,2,0)$ and $(12,8,4,2,2,0)$ are universal (cf. \cite{Sun2}),
   789	by applying Theorem \ref{Th1.1}(i) to the identity  \eqref{univ3}, we obtain the universality of the
   790	  tuple $(8,4,6,4,4,0)$.
   791	
   792	 From \eqref{AAthm216aa}, we obtain
   793	    \begin{align}\label{Athm19u3}
   794	  \varphi \left(q^3\right) \psi \left(q^3\right)  X(q)=&\ \varphi \left(q^3\right) \psi \left(q^3\right)f\left(q^{12},q^{15}\right)+q\varphi \left(q^3\right) \psi \left(q^3\right)f\left(q^{6},q^{21}\right) \nonumber \\&\ +q^2\varphi \left(q^3\right) \psi \left(q^3\right)f\left(q^{3},q^{24}\right).
   795	  \end{align}
   796	   As the sum $3x^2+y(3y+1)+z(3z+2)$  (or the tuple $(6,4,6,2,6,0)$) is universal by Sun  \cite{Sun1}, with the aid of \eqref{2p58} the tuple $(12,6,6,0,3,1)$ is also universal. Thus, using the second term of \eqref{Athm19u3} with the help of Theorem \ref{Th1.1}(i), we get the universality of the tuple $(9,5,4,2,2,0)$.
