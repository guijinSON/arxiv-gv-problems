gen_2201_03220.py:604:def _exact_line_square_attack(inst: dict, node_cap: int) -> dict:
gen_2201_03220.py:605:    """Target-size MIS branch-and-bound on the edge-conflict graph."""
gen_2201_03220.py:606:    masks = _conflict_masks(inst)
gen_2201_03220.py:607:    target = inst["matching_edges"]
gen_2201_03220.py:608:    nodes = 0
gen_2201_03220.py:609:    capped = False
gen_2201_03220.py:610:
gen_2201_03220.py:611:    def visit(available: int, remaining: int):
gen_2201_03220.py:612:        nonlocal nodes, capped
gen_2201_03220.py:613:        nodes += 1
gen_2201_03220.py:614:        if nodes > node_cap:
gen_2201_03220.py:615:            capped = True
gen_2201_03220.py:616:            return None
gen_2201_03220.py:617:        if remaining == 0:
gen_2201_03220.py:618:            return []
gen_2201_03220.py:619:        if available.bit_count() < remaining:
gen_2201_03220.py:620:            return None
gen_2201_03220.py:621:
gen_2201_03220.py:622:        scan = available
gen_2201_03220.py:623:        vertex = -1
gen_2201_03220.py:624:        best_degree = -1
gen_2201_03220.py:625:        while scan:
gen_2201_03220.py:626:            bit = scan & -scan
gen_2201_03220.py:627:            index = bit.bit_length() - 1
gen_2201_03220.py:628:            degree = (masks[index] & available).bit_count()
gen_2201_03220.py:629:            if degree > best_degree:
gen_2201_03220.py:630:                best_degree = degree
gen_2201_03220.py:631:                vertex = index
gen_2201_03220.py:632:            scan -= bit
gen_2201_03220.py:633:
gen_2201_03220.py:634:        included = visit(available & ~masks[vertex], remaining - 1)
gen_2201_03220.py:635:        if included is not None:
gen_2201_03220.py:636:            return [vertex] + included
gen_2201_03220.py:637:        if capped:
gen_2201_03220.py:638:            return None
gen_2201_03220.py:639:        return visit(available & ~(1 << vertex), remaining)
gen_2201_03220.py:640:
gen_2201_03220.py:641:    started = time.perf_counter()
gen_2201_03220.py:642:    indices = visit((1 << len(masks)) - 1, target)
gen_2201_03220.py:643:    elapsed = time.perf_counter() - started
gen_2201_03220.py:644:    candidate = None if indices is None else _indices_to_answer(inst, indices)
gen_2201_03220.py:645:    solved = bool(candidate is not None and verify(inst, candidate)[0])
gen_2201_03220.py:646:    return {
gen_2201_03220.py:647:        "solved": solved,
gen_2201_03220.py:648:        "nodes": nodes,
gen_2201_03220.py:649:        "wall_clock_sec": elapsed,
gen_2201_03220.py:650:        "capped": capped,
gen_2201_03220.py:651:    }
