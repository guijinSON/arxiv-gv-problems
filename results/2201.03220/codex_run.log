gen_2201_03220.py:437:def canonical_key(inst: dict) -> str:
gen_2201_03220.py:438:    """A strong relabeling-invariant fingerprint for the cubic graph."""
gen_2201_03220.py:439:    n = inst["n"]
gen_2201_03220.py:440:    adjacency = _adjacency_from_edges(n, inst["edges"])
gen_2201_03220.py:441:    initial = [_distance_histogram(adjacency, vertex) for vertex in range(n)]
gen_2201_03220.py:442:    palette = {signature: i for i, signature in enumerate(sorted(set(initial)))}
gen_2201_03220.py:443:    colors = [palette[signature] for signature in initial]
gen_2201_03220.py:444:
gen_2201_03220.py:445:    for _ in range(n):
gen_2201_03220.py:446:        signatures = [
gen_2201_03220.py:447:            (colors[vertex], tuple(sorted(colors[w] for w in adjacency[vertex])))
gen_2201_03220.py:448:            for vertex in range(n)
gen_2201_03220.py:449:        ]
gen_2201_03220.py:450:        palette = {
gen_2201_03220.py:451:            signature: i for i, signature in enumerate(sorted(set(signatures)))
gen_2201_03220.py:452:        }
gen_2201_03220.py:453:        refined = [palette[signature] for signature in signatures]
gen_2201_03220.py:454:        if refined == colors:
gen_2201_03220.py:455:            break
gen_2201_03220.py:456:        colors = refined
gen_2201_03220.py:457:
gen_2201_03220.py:458:    vertex_records = sorted(
gen_2201_03220.py:459:        (
gen_2201_03220.py:460:            colors[vertex],
gen_2201_03220.py:461:            initial[vertex],
gen_2201_03220.py:462:            tuple(sorted(colors[w] for w in adjacency[vertex])),
gen_2201_03220.py:463:        )
gen_2201_03220.py:464:        for vertex in range(n)
gen_2201_03220.py:465:    )
gen_2201_03220.py:466:    edge_records = sorted(
gen_2201_03220.py:467:        tuple(sorted((colors[u], colors[v]))) for u, v in inst["edges"]
gen_2201_03220.py:468:    )
gen_2201_03220.py:469:    payload = {
gen_2201_03220.py:470:        "n": n,
gen_2201_03220.py:471:        "m": len(inst["edges"]),
gen_2201_03220.py:472:        "vertices": vertex_records,
gen_2201_03220.py:473:        "edges": edge_records,
gen_2201_03220.py:474:    }
gen_2201_03220.py:475:    return hashlib.sha256(
gen_2201_03220.py:476:        json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
gen_2201_03220.py:477:    ).hexdigest()
gen_2201_03220.py:478:
gen_2201_03220.py:479:
gen_2201_03220.py:480:def escalate(params: dict) -> dict | str | None:
gen_2201_03220.py:481:    """Raise ambient size and boundary crowding until the answer cap binds."""
gen_2201_03220.py:482:    n = params.get("n")
gen_2201_03220.py:483:    selected_vertices = params.get("selected_vertices")
gen_2201_03220.py:484:    if not isinstance(n, int) or not isinstance(selected_vertices, int):
gen_2201_03220.py:485:        return None
gen_2201_03220.py:486:    if n >= 220 or selected_vertices >= 124:
gen_2201_03220.py:487:        return "cap_bound"
gen_2201_03220.py:488:    harder_n = n + 40
gen_2201_03220.py:489:    # Move closer to the cubic stub-capacity boundary s <= 3n/5 while keeping
gen_2201_03220.py:490:    # the value even. This is a second difficulty axis, not merely more output.
gen_2201_03220.py:491:    harder_selected = min(3 * harder_n // 5, selected_vertices + 24)
gen_2201_03220.py:492:    harder_selected -= harder_selected % 2
gen_2201_03220.py:493:    if harder_selected > 124:
gen_2201_03220.py:494:        return "cap_bound"
gen_2201_03220.py:495:    return {"n": harder_n, "selected_vertices": harder_selected}
