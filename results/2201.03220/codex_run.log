+    "easy": {"n": 120, "selected_vertices": 68},
+    "medium": {"n": 160, "selected_vertices": 92},
+    "hard": {"n": 200, "selected_vertices": 116},
+}
+SHIPPING_DIFFICULTY: str = "easy"
+
+STRUCTURAL_HINT: str = (
+    "At girth five every edge has the same radius-two conflict count, so useful "
