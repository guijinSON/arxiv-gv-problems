gen_2201_03220.py:184:
gen_2201_03220.py:185:def _adjacency_from_edges(n: int, edges: list[list[int]] | list[tuple[int, int]]):
gen_2201_03220.py:186:    adjacency = [[] for _ in range(n)]
gen_2201_03220.py:187:    for edge in edges:
gen_2201_03220.py:188:        if not isinstance(edge, (list, tuple)) or len(edge) != 2:
gen_2201_03220.py:189:            raise ValueError("each edge must have two endpoints")
gen_2201_03220.py:190:        u, v = edge
gen_2201_03220.py:191:        if not isinstance(u, int) or not isinstance(v, int) or u == v:
gen_2201_03220.py:192:            raise ValueError("invalid edge endpoint")
gen_2201_03220.py:193:        if not (0 <= u < n and 0 <= v < n):
gen_2201_03220.py:194:            raise ValueError("edge endpoint out of range")
gen_2201_03220.py:195:        adjacency[u].append(v)
gen_2201_03220.py:196:        adjacency[v].append(u)
gen_2201_03220.py:197:    return [sorted(row) for row in adjacency]
gen_2201_03220.py:198:
gen_2201_03220.py:199:
gen_2201_03220.py:200:def _connected(adjacency: list[list[int]]) -> bool:
gen_2201_03220.py:201:    seen = {0}
gen_2201_03220.py:202:    queue = [0]
gen_2201_03220.py:203:    for vertex in queue:
gen_2201_03220.py:204:        for neighbor in adjacency[vertex]:
gen_2201_03220.py:205:            if neighbor not in seen:
gen_2201_03220.py:206:                seen.add(neighbor)
gen_2201_03220.py:207:                queue.append(neighbor)
gen_2201_03220.py:208:    return len(seen) == len(adjacency)
gen_2201_03220.py:209:
gen_2201_03220.py:210:
gen_2201_03220.py:211:def _girth_at_least_five(adjacency: list[list[int]]) -> bool:
gen_2201_03220.py:212:    """Detect triangles and four-cycles through radius-two collisions."""
gen_2201_03220.py:213:    for vertex, neighbors in enumerate(adjacency):
gen_2201_03220.py:214:        radius_two = set()
gen_2201_03220.py:215:        for neighbor in neighbors:
gen_2201_03220.py:216:            for other in adjacency[neighbor]:
gen_2201_03220.py:217:                if other == vertex:
gen_2201_03220.py:218:                    continue
gen_2201_03220.py:219:                if other in radius_two:
gen_2201_03220.py:220:                    return False
gen_2201_03220.py:221:                radius_two.add(other)
gen_2201_03220.py:222:    return True
