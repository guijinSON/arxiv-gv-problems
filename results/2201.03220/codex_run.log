-    for vertex, neighbors in enumerate(adjacency):
-        radius_two = set()
-        for neighbor in neighbors:
-            for other in adjacency[neighbor]:
-                if other == vertex:
-                    continue
-                if other in radius_two:
-                    return False
-                radius_two.add(other)
-    return True
-
