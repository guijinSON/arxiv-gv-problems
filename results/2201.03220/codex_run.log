-    # G6: all attacks are run on the same eight held construction seeds.
-    attack_names = (
-        "radius_three_outlier",
-        "greedy_left_to_right",
-        "random_restart_min_conflict_256",
-        "spectral_smallest_adjacency",
-        "cameron_line_square_branch_and_bound",
