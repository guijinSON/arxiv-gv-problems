2691164 Ss         00:37 /bin/bash -c python3 -u - <<'PY' import random,time,statistics  def gen(m,B,seed):  r=random.Random(seed); vals=[]; lo=B//4+1; hi=(B-1)//2; spread=B//12  for _ in range(m):   while 1:    x=r.randint(-spread,spread); y=r.randint(-spread,spread)    tri=[B//3+x,B//3+y,B-2*(B//3)-x-y]    if all(lo<=v<=hi for v in tri): break   vals += tri  r.shuffle(vals); return vals  def edges(a,B):  n=len(a); by={}  for i,x in enumerate(a): by.setdefault(x,[]).append(i)  out=[]  for i in range(n):   for j in range(i+1,n):    for k in by.get(B-a[i]-a[j],()):     if k>j: out.append((i,j,k))  return out  def dlx(a,B,cap=10000):  es=edges(a,B); n=len(a); inc=[[] for _ in range(n)]  masks=[]  for t,e in enumerate(es):   mask=sum(1<<x for x in e);masks.append(mask)   for x in e: inc[x].append(t)  nodes=0; full=(1<<n)-1  def go(used):   nonlocal nodes   nodes+=1   if nodes>cap:return None   if used==full:return True   opts=None   u=(~used)&full   while u:    bit=u&-u; x=bit.bit_length()-1;u-=bit    os=[t for t in inc[x] if not masks[t]&used]    if not os:return False    if opts is None or len(os)<len(opts):opts=os   for t in opts:    z=go(used|masks[t])    if z is not False:return z   return False  st=time.perf_counter(); ans=go(0); return ans,nodes,len(es),time.perf_counter()-st for m in [12,16,20,24,30,36]:  for B in [60,120,240,480,960,1920,3840]:   rows=[]   for s in range(4):    a=gen(m,B,100+s)    ans,n,e,t=dlx(a,B,10000)    rows.append((ans,n,e,t))   print('m',m,'B',B,'capped',sum(x[0] is None for x in rows),'nodes',[x[1] for x in rows],'edges',[x[2] for x in rows],flush=True) PY
