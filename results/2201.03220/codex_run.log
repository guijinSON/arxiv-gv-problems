gen_2201_03220.py:361:
gen_2201_03220.py:362:def verify(inst: dict, answer: object) -> tuple[bool, str]:
gen_2201_03220.py:363:    """Check any submitted induced vertex set; never inspect inst['answer']."""
gen_2201_03220.py:364:    if not isinstance(answer, list):
gen_2201_03220.py:365:        return False, "answer must be a JSON list"
gen_2201_03220.py:366:    if not answer:
gen_2201_03220.py:367:        return False, "answer is empty"
gen_2201_03220.py:368:    expected = inst["selected_vertices"]
gen_2201_03220.py:369:    if len(answer) != expected:
gen_2201_03220.py:370:        return False, f"wrong number of vertices: expected {expected}, got {len(answer)}"
gen_2201_03220.py:371:    if any(isinstance(vertex, bool) or not isinstance(vertex, int) for vertex in answer):
gen_2201_03220.py:372:        return False, "every vertex label must be an integer"
gen_2201_03220.py:373:    if len(set(answer)) != len(answer):
gen_2201_03220.py:374:        return False, "vertex labels must be distinct"
gen_2201_03220.py:375:    n = inst["n"]
gen_2201_03220.py:376:    if any(vertex < 0 or vertex >= n for vertex in answer):
gen_2201_03220.py:377:        return False, f"vertex label outside the inclusive range 0..{n - 1}"
gen_2201_03220.py:378:    if any(answer[i] >= answer[i + 1] for i in range(len(answer) - 1)):
gen_2201_03220.py:379:        return False, "vertex labels must be in strictly increasing order"
gen_2201_03220.py:380:
gen_2201_03220.py:381:    chosen = set(answer)
gen_2201_03220.py:382:    adjacency = inst.get("adjacency")
gen_2201_03220.py:383:    if not isinstance(adjacency, list) or len(adjacency) != n:
gen_2201_03220.py:384:        try:
gen_2201_03220.py:385:            adjacency = _adjacency_from_edges(n, inst["edges"])
gen_2201_03220.py:386:        except (KeyError, TypeError, ValueError) as exc:
gen_2201_03220.py:387:            return False, f"malformed instance graph: {exc}"
gen_2201_03220.py:388:    for vertex in answer:
gen_2201_03220.py:389:        degree = sum(neighbor in chosen for neighbor in adjacency[vertex])
gen_2201_03220.py:390:        if degree != 1:
gen_2201_03220.py:391:            return False, f"selected vertex {vertex} has induced degree {degree}, not 1"
gen_2201_03220.py:392:    return True, "ok"
