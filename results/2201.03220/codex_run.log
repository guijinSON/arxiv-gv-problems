gen_2201_03220.py:559:def _radius_three_outlier_candidates(inst: dict) -> list[list[int]]:
gen_2201_03220.py:560:    adjacency = inst["adjacency"]
gen_2201_03220.py:561:    records = []
gen_2201_03220.py:562:    for start in range(inst["n"]):
gen_2201_03220.py:563:        seen = {start}
gen_2201_03220.py:564:        frontier = {start}
gen_2201_03220.py:565:        layers = []
gen_2201_03220.py:566:        for _ in range(3):
gen_2201_03220.py:567:            nxt = {
gen_2201_03220.py:568:                neighbor
gen_2201_03220.py:569:                for vertex in frontier
gen_2201_03220.py:570:                for neighbor in adjacency[vertex]
gen_2201_03220.py:571:                if neighbor not in seen
gen_2201_03220.py:572:            }
gen_2201_03220.py:573:            layers.append(len(nxt))
gen_2201_03220.py:574:            seen.update(nxt)
gen_2201_03220.py:575:            frontier = nxt
gen_2201_03220.py:576:        records.append((tuple(layers), start))
gen_2201_03220.py:577:    records.sort()
gen_2201_03220.py:578:    size = inst["selected_vertices"]
gen_2201_03220.py:579:    return [
gen_2201_03220.py:580:        sorted(vertex for _, vertex in records[:size]),
gen_2201_03220.py:581:        sorted(vertex for _, vertex in records[-size:]),
gen_2201_03220.py:582:    ]
