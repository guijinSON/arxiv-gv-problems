gen_2201_03220.py:498:def _conflict_masks(inst: dict) -> list[int]:
gen_2201_03220.py:499:    """Closed neighborhoods in Cameron's line-graph-square formulation."""
gen_2201_03220.py:500:    edges = [tuple(edge) for edge in inst["edges"]]
gen_2201_03220.py:501:    incidence = [[] for _ in range(inst["n"])]
gen_2201_03220.py:502:    for index, (u, v) in enumerate(edges):
gen_2201_03220.py:503:        incidence[u].append(index)
gen_2201_03220.py:504:        incidence[v].append(index)
gen_2201_03220.py:505:    masks = []
gen_2201_03220.py:506:    for index, (u, v) in enumerate(edges):
gen_2201_03220.py:507:        conflict = 1 << index
gen_2201_03220.py:508:        for endpoint in (u, v):
gen_2201_03220.py:509:            for adjacent_edge in incidence[endpoint]:
gen_2201_03220.py:510:                for neighbor in edges[adjacent_edge]:
gen_2201_03220.py:511:                    for other_edge in incidence[neighbor]:
gen_2201_03220.py:512:                        conflict |= 1 << other_edge
gen_2201_03220.py:513:        masks.append(conflict)
gen_2201_03220.py:514:    return masks
