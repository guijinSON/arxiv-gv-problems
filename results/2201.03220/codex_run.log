+        attacks[name] = entry
+    all_attacks_failed = all(row["successes"] == 0 for row in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed,
+        "attacks": attacks,
+        "construction_seeds": list(_ATTACK_SEEDS),
+    }
+
+    report["G5_density_and_baseline"] = {
+        "pass": (
