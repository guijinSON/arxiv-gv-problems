gen_2201_03220.py:516:
gen_2201_03220.py:517:def _indices_to_answer(inst: dict, indices: list[int]) -> list[int] | None:
gen_2201_03220.py:518:    if len(indices) < inst["matching_edges"]:
gen_2201_03220.py:519:        return None
gen_2201_03220.py:520:    vertices = set()
gen_2201_03220.py:521:    for index in indices[: inst["matching_edges"]]:
gen_2201_03220.py:522:        vertices.update(inst["edges"][index])
gen_2201_03220.py:523:    if len(vertices) != inst["selected_vertices"]:
gen_2201_03220.py:524:        return None
gen_2201_03220.py:525:    return sorted(vertices)
gen_2201_03220.py:526:
gen_2201_03220.py:527:
gen_2201_03220.py:528:def _greedy_edge_pack(
gen_2201_03220.py:529:    inst: dict,
gen_2201_03220.py:530:    rng: random.Random | None = None,
gen_2201_03220.py:531:    randomized: bool = False,
gen_2201_03220.py:532:) -> list[int]:
gen_2201_03220.py:533:    masks = _conflict_masks(inst)
gen_2201_03220.py:534:    available = (1 << len(masks)) - 1
gen_2201_03220.py:535:    solution = []
gen_2201_03220.py:536:    while available:
gen_2201_03220.py:537:        choices = []
gen_2201_03220.py:538:        minimum = None
gen_2201_03220.py:539:        scan = available
gen_2201_03220.py:540:        while scan:
gen_2201_03220.py:541:            bit = scan & -scan
gen_2201_03220.py:542:            index = bit.bit_length() - 1
gen_2201_03220.py:543:            degree = (masks[index] & available).bit_count()
gen_2201_03220.py:544:            if minimum is None or degree < minimum:
gen_2201_03220.py:545:                minimum = degree
gen_2201_03220.py:546:                choices = [index]
gen_2201_03220.py:547:            elif degree <= minimum + (2 if randomized else 0):
gen_2201_03220.py:548:                choices.append(index)
gen_2201_03220.py:549:            scan -= bit
gen_2201_03220.py:550:        if randomized and rng is not None:
gen_2201_03220.py:551:            index = rng.choice(choices)
gen_2201_03220.py:552:        else:
gen_2201_03220.py:553:            index = min(choices)
gen_2201_03220.py:554:        solution.append(index)
gen_2201_03220.py:555:        available &= ~masks[index]
gen_2201_03220.py:556:    return solution
