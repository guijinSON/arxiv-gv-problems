gen_2201_03220.py:417:
gen_2201_03220.py:418:def _distance_histogram(adjacency: list[list[int]], start: int) -> tuple[int, ...]:
gen_2201_03220.py:419:    distances = [-1] * len(adjacency)
gen_2201_03220.py:420:    distances[start] = 0
gen_2201_03220.py:421:    queue = [start]
gen_2201_03220.py:422:    for vertex in queue:
gen_2201_03220.py:423:        for neighbor in adjacency[vertex]:
gen_2201_03220.py:424:            if distances[neighbor] < 0:
gen_2201_03220.py:425:                distances[neighbor] = distances[vertex] + 1
gen_2201_03220.py:426:                queue.append(neighbor)
gen_2201_03220.py:427:    if any(distance < 0 for distance in distances):
gen_2201_03220.py:428:        # Components are still represented canonically if an externally built
gen_2201_03220.py:429:        # instance reaches here, though generated instances are connected.
gen_2201_03220.py:430:        distances = [len(adjacency) + 1 if d < 0 else d for d in distances]
gen_2201_03220.py:431:    histogram = [0] * (max(distances) + 1)
gen_2201_03220.py:432:    for distance in distances:
gen_2201_03220.py:433:        histogram[distance] += 1
gen_2201_03220.py:434:    return tuple(histogram)
