gen_2201_03220.py:584:
gen_2201_03220.py:585:def _spectral_candidates(inst: dict, seed: int) -> list[list[int]]:
gen_2201_03220.py:586:    """Float-only adversary: round the most-negative adjacency direction."""
gen_2201_03220.py:587:    rng = random.Random(seed ^ 0x5EEC7A1)
gen_2201_03220.py:588:    n = inst["n"]
gen_2201_03220.py:589:    adjacency = inst["adjacency"]
gen_2201_03220.py:590:    vector = [rng.uniform(-1.0, 1.0) for _ in range(n)]
gen_2201_03220.py:591:    mean = sum(vector) / n
gen_2201_03220.py:592:    vector = [value - mean for value in vector]
gen_2201_03220.py:593:    for _ in range(100):
gen_2201_03220.py:594:        nxt = [-sum(vector[w] for w in adjacency[v]) for v in range(n)]
gen_2201_03220.py:595:        mean = sum(nxt) / n
gen_2201_03220.py:596:        nxt = [value - mean for value in nxt]
gen_2201_03220.py:597:        norm = math.sqrt(sum(value * value for value in nxt)) or 1.0
gen_2201_03220.py:598:        vector = [value / norm for value in nxt]
gen_2201_03220.py:599:    order = sorted(range(n), key=lambda vertex: (vector[vertex], vertex))
gen_2201_03220.py:600:    size = inst["selected_vertices"]
gen_2201_03220.py:601:    return [sorted(order[:size]), sorted(order[-size:])]
