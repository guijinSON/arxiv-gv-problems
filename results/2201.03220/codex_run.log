gen_2201_03220.py:165:
gen_2201_03220.py:166:def _validate_parameters(n: int, selected_vertices: int) -> None:
gen_2201_03220.py:167:    if isinstance(n, bool) or not isinstance(n, int) or n < 10 or n % 2:
gen_2201_03220.py:168:        raise ValueError("n must be an even integer at least 10")
gen_2201_03220.py:169:    if (
gen_2201_03220.py:170:        isinstance(selected_vertices, bool)
gen_2201_03220.py:171:        or not isinstance(selected_vertices, int)
gen_2201_03220.py:172:        or selected_vertices < 2
gen_2201_03220.py:173:        or selected_vertices % 2
gen_2201_03220.py:174:    ):
gen_2201_03220.py:175:        raise ValueError("selected_vertices must be a positive even integer")
gen_2201_03220.py:176:    if selected_vertices >= n:
gen_2201_03220.py:177:        raise ValueError("selected_vertices must be smaller than n")
gen_2201_03220.py:178:    # Selected vertices need two outside stubs apiece. The outside class has
gen_2201_03220.py:179:    # three stubs per vertex, and its unused number of stubs must be pairable.
gen_2201_03220.py:180:    leftover = 3 * (n - selected_vertices) - 2 * selected_vertices
gen_2201_03220.py:181:    if leftover < 0 or leftover % 2:
gen_2201_03220.py:182:        raise ValueError("the requested class does not satisfy the cubic stub balance")
