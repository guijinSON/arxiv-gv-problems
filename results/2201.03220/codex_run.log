-    attack_successes = {name: 0 for name in attack_names}
-    attack_costs = {name: {"wall_clock_sec": 0.0} for name in attack_names}
-    exact_nodes = []
-    exact_times = []
-
-    for seed in _ATTACK_SEEDS:
-        attacked = make_instance(seed=seed, **shipping_params)
