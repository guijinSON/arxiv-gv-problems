+        reordered = _reorder_instance(base, 13000 + offset)
+        composed = _reorder_instance(relabeled, 14000 + offset)
+        for name, transformed in (
+            ("vertex_relabel", relabeled),
+            ("edge_reorder_and_reverse", reordered),
+            ("composed", composed),
