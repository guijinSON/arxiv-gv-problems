gen_2201_03220.py:225:def make_instance(n: int, seed: int = 0, **params) -> dict:
gen_2201_03220.py:226:    """Inverse-generate a cubic graph and a large induced matching."""
gen_2201_03220.py:227:    if set(params) != {"selected_vertices"}:
gen_2201_03220.py:228:        missing = "selected_vertices" not in params
gen_2201_03220.py:229:        unknown = sorted(set(params) - {"selected_vertices"})
gen_2201_03220.py:230:        if missing:
gen_2201_03220.py:231:            raise TypeError("missing selected_vertices")
gen_2201_03220.py:232:        raise TypeError("unknown parameters: " + ", ".join(unknown))
gen_2201_03220.py:233:    selected_vertices = params["selected_vertices"]
gen_2201_03220.py:234:    _validate_parameters(n, selected_vertices)
gen_2201_03220.py:235:    if isinstance(seed, bool) or not isinstance(seed, int):
gen_2201_03220.py:236:        raise TypeError("seed must be an integer")
gen_2201_03220.py:237:
gen_2201_03220.py:238:    rng = random.Random(seed)
gen_2201_03220.py:239:    selected = list(range(selected_vertices))
gen_2201_03220.py:240:    outside = list(range(selected_vertices, n))
gen_2201_03220.py:241:
gen_2201_03220.py:242:    accepted_edges = None
gen_2201_03220.py:243:    for _attempt in range(100_000):
gen_2201_03220.py:244:        selected_order = list(selected)
gen_2201_03220.py:245:        rng.shuffle(selected_order)
gen_2201_03220.py:246:        planted_edges = [
gen_2201_03220.py:247:            tuple(sorted((selected_order[i], selected_order[i + 1])))
gen_2201_03220.py:248:            for i in range(0, selected_vertices, 2)
gen_2201_03220.py:249:        ]
gen_2201_03220.py:250:
gen_2201_03220.py:251:        selected_stubs = [vertex for vertex in selected for _ in range(2)]
gen_2201_03220.py:252:        outside_stubs = [vertex for vertex in outside for _ in range(3)]
gen_2201_03220.py:253:        rng.shuffle(selected_stubs)
gen_2201_03220.py:254:        rng.shuffle(outside_stubs)
gen_2201_03220.py:255:
gen_2201_03220.py:256:        cross_count = len(selected_stubs)
gen_2201_03220.py:257:        cross_edges = [
gen_2201_03220.py:258:            tuple(sorted(pair))
gen_2201_03220.py:259:            for pair in zip(selected_stubs, outside_stubs[:cross_count])
gen_2201_03220.py:260:        ]
gen_2201_03220.py:261:        remainder = outside_stubs[cross_count:]
gen_2201_03220.py:262:        rng.shuffle(remainder)
gen_2201_03220.py:263:        outside_edges = [
gen_2201_03220.py:264:            tuple(sorted((remainder[i], remainder[i + 1])))
gen_2201_03220.py:265:            for i in range(0, len(remainder), 2)
gen_2201_03220.py:266:        ]
gen_2201_03220.py:267:        edges = planted_edges + cross_edges + outside_edges
gen_2201_03220.py:268:
gen_2201_03220.py:269:        if any(u == v for u, v in edges) or len(set(edges)) != len(edges):
gen_2201_03220.py:270:            continue
gen_2201_03220.py:271:        adjacency = _adjacency_from_edges(n, edges)
gen_2201_03220.py:272:        if any(len(row) != 3 for row in adjacency):
gen_2201_03220.py:273:            continue
gen_2201_03220.py:274:        if not _girth_at_least_five(adjacency) or not _connected(adjacency):
gen_2201_03220.py:275:            continue
gen_2201_03220.py:276:        accepted_edges = edges
gen_2201_03220.py:277:        break
gen_2201_03220.py:278:    if accepted_edges is None:
gen_2201_03220.py:279:        raise RuntimeError("could not draw a simple connected girth-five configuration")
gen_2201_03220.py:280:
gen_2201_03220.py:281:    permutation = list(range(n))
gen_2201_03220.py:282:    rng.shuffle(permutation)
gen_2201_03220.py:283:    relabeled_edges = [
gen_2201_03220.py:284:        tuple(sorted((permutation[u], permutation[v])))
gen_2201_03220.py:285:        for u, v in accepted_edges
gen_2201_03220.py:286:    ]
gen_2201_03220.py:287:    rng.shuffle(relabeled_edges)
gen_2201_03220.py:288:    answer = sorted(permutation[vertex] for vertex in selected)
gen_2201_03220.py:289:    adjacency = _adjacency_from_edges(n, relabeled_edges)
gen_2201_03220.py:290:
gen_2201_03220.py:291:    return {
gen_2201_03220.py:292:        "family": "large induced matching in a subcubic graph",
gen_2201_03220.py:293:        "n": n,
gen_2201_03220.py:294:        "selected_vertices": selected_vertices,
gen_2201_03220.py:295:        "matching_edges": selected_vertices // 2,
gen_2201_03220.py:296:        "maximum_degree": 3,
gen_2201_03220.py:297:        "girth_lower_bound": 5,
gen_2201_03220.py:298:        "edges": [[u, v] for u, v in relabeled_edges],
gen_2201_03220.py:299:        "adjacency": adjacency,
gen_2201_03220.py:300:        "answer": answer,
gen_2201_03220.py:301:    }
gen_2201_03220.py:302:
gen_2201_03220.py:303:
gen_2201_03220.py:304:def render(inst: dict) -> str:
gen_2201_03220.py:305:    """Render a complete native induced-matching search problem."""
gen_2201_03220.py:306:    edge_rows = "\n".join(f"  {u} {v}" for u, v in inst["edges"])
gen_2201_03220.py:307:    mode = os.environ.get("GV_HINT_MODE")
gen_2201_03220.py:308:    hint = ""
gen_2201_03220.py:309:    if mode == "structural":
gen_2201_03220.py:310:        hint = "\n\nStructural hint: " + STRUCTURAL_HINT
gen_2201_03220.py:311:    elif mode == "placebo":
gen_2201_03220.py:312:        hint = "\n\nHint: " + PLACEBO_HINT
gen_2201_03220.py:313:
gen_2201_03220.py:314:    return f"""LARGE INDUCED MATCHING IN A SUBCUBIC GRAPH
gen_2201_03220.py:315:
gen_2201_03220.py:316:The graph is finite, simple, and undirected. Its vertices are the integers
gen_2201_03220.py:317:0 through {inst['n'] - 1}. An edge row "u v" means that u and v are adjacent;
gen_2201_03220.py:318:there are no other edges. The graph is cubic (every vertex has degree 3) and
gen_2201_03220.py:319:has no cycle of length 3 or 4.
gen_2201_03220.py:320:
gen_2201_03220.py:321:Choose exactly {inst['selected_vertices']} distinct vertices. In the subgraph
gen_2201_03220.py:322:induced by the chosen vertices, every chosen vertex must have degree exactly
gen_2201_03220.py:323:1. Equivalently, the chosen vertices must be the endpoints of exactly
gen_2201_03220.py:324:{inst['matching_edges']} pairwise induced edges: selected edges share no
gen_2201_03220.py:325:endpoint, and no graph edge joins endpoints of two different selected edges.
gen_2201_03220.py:326:
gen_2201_03220.py:327:Edges ({len(inst['edges'])} rows, in arbitrary order):
gen_2201_03220.py:328:{edge_rows}{hint}
gen_2201_03220.py:329:
gen_2201_03220.py:330:Give your final answer inside <answer></answer> tags as one JSON array of
gen_2201_03220.py:331:exactly {inst['selected_vertices']} zero-based vertex labels in strictly
gen_2201_03220.py:332:increasing order. Repeats are forbidden and order is otherwise semantically
gen_2201_03220.py:333:irrelevant; increasing order is the required canonical serialization.
gen_2201_03220.py:334:Example format: <answer>[0, 3, 8]</answer>
gen_2201_03220.py:335:Output nothing else inside the tags."""
gen_2201_03220.py:336:
gen_2201_03220.py:337:
gen_2201_03220.py:338:def parse_answer(text: object) -> object | None:
gen_2201_03220.py:339:    """Extract the last tagged JSON list, tolerating prose and code fences."""
gen_2201_03220.py:340:    if not isinstance(text, str):
gen_2201_03220.py:341:        return None
gen_2201_03220.py:342:    matches = _ANSWER_RE.findall(text)
gen_2201_03220.py:343:    if not matches:
gen_2201_03220.py:344:        return None
gen_2201_03220.py:345:    body = matches[-1].strip()
gen_2201_03220.py:346:    if body.startswith("```") and body.endswith("```"):
gen_2201_03220.py:347:        lines = body.splitlines()
gen_2201_03220.py:348:        if len(lines) >= 2:
gen_2201_03220.py:349:            lines = lines[1:-1]
gen_2201_03220.py:350:            body = "\n".join(lines).strip()
gen_2201_03220.py:351:    try:
gen_2201_03220.py:352:        value = json.loads(body)
gen_2201_03220.py:353:    except (TypeError, ValueError):
gen_2201_03220.py:354:        return None
gen_2201_03220.py:355:    if not isinstance(value, list):
gen_2201_03220.py:356:        return None
gen_2201_03220.py:357:    if any(isinstance(item, bool) or not isinstance(item, int) for item in value):
gen_2201_03220.py:358:        return None
gen_2201_03220.py:359:    return value
