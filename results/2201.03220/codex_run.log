gen_2201_03220.py:394:
gen_2201_03220.py:395:def random_candidate(inst: dict, rng: random.Random) -> object:
gen_2201_03220.py:396:    """Sample uniformly from the stated fixed-cardinality subset language."""
gen_2201_03220.py:397:    return sorted(rng.sample(range(inst["n"]), inst["selected_vertices"]))
gen_2201_03220.py:398:
gen_2201_03220.py:399:
gen_2201_03220.py:400:def search_space(inst: dict) -> int | None:
gen_2201_03220.py:401:    """Count all canonical fixed-cardinality vertex subsets exactly."""
gen_2201_03220.py:402:    return math.comb(inst["n"], inst["selected_vertices"])
gen_2201_03220.py:403:
gen_2201_03220.py:404:
gen_2201_03220.py:405:def enumerate_all(inst: dict) -> int | None:
gen_2201_03220.py:406:    """Count valid answers exactly when the declared language is small."""
gen_2201_03220.py:407:    if search_space(inst) > _ENUMERATION_CAP:
gen_2201_03220.py:408:        return None
gen_2201_03220.py:409:    count = 0
gen_2201_03220.py:410:    for candidate in itertools.combinations(
gen_2201_03220.py:411:        range(inst["n"]), inst["selected_vertices"]
gen_2201_03220.py:412:    ):
gen_2201_03220.py:413:        ok, _ = verify(inst, list(candidate))
gen_2201_03220.py:414:        count += int(ok)
gen_2201_03220.py:415:    return count
