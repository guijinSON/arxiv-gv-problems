+    # Coefficient of x_0*...*x_(m-1) in q^2, q=product(z_i), via a
+    # two-state path recurrence.  State 1 says the next variable was already
+    # selected by the preceding squared linear factor.
+    state = [Fraction(1), Fraction(0)]
