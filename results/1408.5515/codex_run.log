+
+    demo = make_instance(seed=11, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+
+    attack_seeds = list(range(800, 808))
+    attacks = {
+        "outlier_term_frequency": {"successes": 0, "attempts": len(attack_seeds)},
