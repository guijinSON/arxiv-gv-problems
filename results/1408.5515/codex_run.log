+        "greedy_coefficient_magnitude": {"successes": 0, "attempts": len(attack_seeds)},
+        "random_restart_256": {"successes": 0, "attempts": len(attack_seeds)},
+        "diagonal_coordinate_ansatz": {"successes": 0, "attempts": len(attack_seeds)},
