        raise ValueError("nvars must be a positive int, got %r" % (nvars,))
    if isinstance(index, bool) or not isinstance(index, int) or not 0 <= index < nvars:
        raise ValueError("index %r out of range for %d variables" % (index, nvars))
    exps = [0] * nvars
    exps[index] = 1
