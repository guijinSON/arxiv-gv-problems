+        "complexity": "O(T^2 + n*m^2*T^2) exact coefficient operations",
+        "wall_clock_sec": round(sum(reference_seconds) / len(reference_seconds), 6),
+        "operations": round(sum(reference_operations) / len(reference_operations)),
