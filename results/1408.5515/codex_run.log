+        attacks["random_restart_256"]["successes"] += int(_attack_random_restart(trial, seed))
+        attacks["diagonal_coordinate_ansatz"]["successes"] += int(_attack_diagonal_ansatz(trial))
+        t0 = time.perf_counter()
