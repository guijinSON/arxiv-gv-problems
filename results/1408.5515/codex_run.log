+                    quotient = _divide_by_monic_linear(poly, variable, tail, counter)
+                    if quotient is None:
+                        continue
+                    result = recurse(
+                        quotient,
+                        variable,
+                        remaining - {variable},
+                        reversed_nodes + [(variable, link, offset)],
+                    )
+                    if result is not None:
+                        return result
