+    # F=(q+c)^2-p^2.  The squarefree degree-m coefficient is the q^2
+    # coefficient above plus 2c; the constant coefficient then determines p.
+    center = (Fraction(poly.get((1,) * variables, 0)) - squarefree_coefficient) / 2
+    operations += 2
