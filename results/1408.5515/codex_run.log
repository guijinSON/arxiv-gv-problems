+  z_i = x_(v_i) + a_i*x_(v_(i+1)) + b_i   for 0 <= i < {variables - 1},
+  z_{variables - 1} = x_(v_{variables - 1}) + b_{variables - 1},
+  g = z_0*z_1*...*z_{variables - 1} + c.
+
