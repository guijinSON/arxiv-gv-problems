+def escalate(params):
+    harder = dict(params)
+    current = harder.get("n")
+    if isinstance(current, bool) or not isinstance(current, int):
+        return None
+    if current >= 10_000:
+        return "cap_bound"
+    harder["n"] = min(10_000, current * 2)
+    return harder
