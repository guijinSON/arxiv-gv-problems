+    worst_chars = len(json.dumps(worst_answer, separators=(",", ":")))
+    worst_tokens = math.ceil(worst_chars / 4)
+    answer_elements = _atomic_elements(inst["answer"])
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name])
