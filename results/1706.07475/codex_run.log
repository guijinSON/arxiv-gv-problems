+    "demo": {"n": 37, "witness_size": 5, "encoding_layers": 1},
+    "easy": {"n": 1_200_007, "witness_size": 16, "encoding_layers": 3},
+    "medium": {"n": 3_000_017, "witness_size": 16, "encoding_layers": 4},
+    "hard": {"n": 7_000_003, "witness_size": 16, "encoding_layers": 4},
+}
