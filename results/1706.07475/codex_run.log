+        return False, "left_boundary_not_dominated"
+    if coordinates[-1] < right_bound:
+        return False, "right_boundary_not_dominated"
+    if right_bound - left_bound + 1 != inst["k"]:
+        return False, "minimum_size_promise_inconsistent"
