+    transformed["path_start"] = (
+        multiplier * inst["path_start"] + shift
+    ) % modulus
+    transformed["path_step"] = multiplier * inst["path_step"] % modulus
+    transformed["answer"] = [
+        (multiplier * label + shift) % modulus for label in inst["answer"]
+    ]
+    return transformed
