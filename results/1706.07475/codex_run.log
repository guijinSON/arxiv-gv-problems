+
+def _euclid_steps(value, modulus):
+    steps = 0
+    a, b = modulus, value % modulus
+    while b:
+        a, b = b, a % b
+        steps += 1
+    return steps
+
+
+def _compact_operation_count(inst):
+    inverse_steps = sum(
+        _euclid_steps(multiplier, inst["n"])
+        for multiplier, _ in inst["radius_layers"]
+    )
+    return (
+        inverse_steps
+        + 6 * len(inst["radius_layers"])
+        + 3 * inst["k"]
+        + 5
+    )
