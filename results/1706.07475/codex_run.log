+def parse_answer(text):
+    """Extract a list of integer labels from tagged model output."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    if not matches:
+        return None
+    for body in reversed(matches):
