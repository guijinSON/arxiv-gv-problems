+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "On a path, a connected set is an interval whose forced endpoints are the "
+    "extremal values of t+r(t) and t-r(t)."
+)
+
+PLACEBO_HINT = (
+    "The least-nonnegative-residue convention matters throughout, and every "
