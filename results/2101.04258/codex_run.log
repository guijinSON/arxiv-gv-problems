+        "preset_block_count": dict(zip(DIFFICULTY, ladder_blocks)),
+        "doubled_n": doubled["n"],
+        "doubled_q": doubled["q"],
+        "doubled_vertices": doubled["vertex_count"],
+        "doubled_verifies": doubled_ok,
+        "doubled_reason": doubled_reason,
