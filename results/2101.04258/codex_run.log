+
+    ladder_n = [parameters["n"] for parameters in DIFFICULTY.values()]
+    ladder_blocks = [parameters["block_count"] for parameters in DIFFICULTY.values()]
+    doubled = make_instance(
+        n=2 * ship["n"],
+        fiber_size=ship["fiber_size"],
