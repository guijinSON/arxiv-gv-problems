+        new_basis = [0] * (len(basis) + 1)
+        for power, value in enumerate(basis):
+            new_basis[power] = (new_basis[power] - index * value) % q
+            new_basis[power + 1] = (new_basis[power + 1] + value) % q
+            operations += 3
+        basis = new_basis
+    return result, operations
