+    counts = [[0] * q for _ in range(q)]
+    for x, ys in enumerate(fiber_sets):
+        for y in ys:
+            for slope in range(q):
+                counts[slope][(y - slope * x) % q] += 1
+
+    eligible = [
+        (slope, intercept)
+        for slope in range(q)
+        for intercept in range(q)
+        if counts[slope][intercept] >= 6
+    ]
+    rng.shuffle(eligible)
