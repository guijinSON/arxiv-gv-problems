+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": (
+            ladder_n == sorted(set(ladder_n))
+            and ladder_blocks == sorted(set(ladder_blocks))
