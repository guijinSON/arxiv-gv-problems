+        stat["steps"] += steps
+        stat["wall_clock_sec"] += elapsed
+
+        t0 = time.perf_counter()
+        reference, operations, trials = _reference_interpolation(instance)
+        reference_wall += time.perf_counter() - t0
+        reference_operations += operations
