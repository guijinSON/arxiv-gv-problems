  \def\a#1#2{$\substack{#1 \; #2}$}
  \input pic/gurth.pgf
  \caption{Application of Gurth’s Symmetrical Placement Theorem to eliminate 9 from $r_9c_9$}
  \label{sudoku.fig.gurth-ex}
