+def _frontier_from_target(
+    roots: tuple[tuple[int, int], ...], depth: int, p: int, budget: int
+) -> tuple[dict[tuple[int, int], list[list[tuple[int, int]]]], int, bool]:
+    start_j = _curve_j(roots, p)
