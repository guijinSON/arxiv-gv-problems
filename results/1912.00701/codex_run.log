+    for symbol in word:
+        roots, forbidden_root = _transition(roots, forbidden_root, ord(symbol) - 48, p)
+    return roots, forbidden_root
+
+
+def _random_nonzero(rng: random.Random, p: int) -> tuple[int, int]:
+    while True:
+        value = rng.randrange(p), rng.randrange(p)
+        if value != (0, 0):
+            return value
