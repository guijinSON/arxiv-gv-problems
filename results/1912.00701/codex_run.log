-    alternate = [_tuple_curve(c) for c in inst["target_alternate"]]
-    z0 = _div(primary[0][0], alternate[0][0], p)
-    z1 = _div(primary[1][0], alternate[1][0], p)
-    if z0 != z1:
-        return None
-    return _decode_scale(z0, inst["n"], inst["split"])
