+def _guess_worker(payload: tuple[dict, int, int]) -> tuple[int, int]:
+    inst, samples, worker_seed = payload
+    rng = random.Random(worker_seed)
+    hits = 0
+    for _ in range(samples):
+        hits += int(verify(inst, random_candidate(inst, rng))[0])
+    return hits, samples
