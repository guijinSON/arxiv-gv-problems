+def _transition(
+    roots: tuple[tuple[int, int], ...],
+    forbidden_root: tuple[int, int],
+    bit: int,
+    p: int,
+) -> tuple[tuple[tuple[int, int], ...], tuple[int, int]]:
+    if forbidden_root not in roots:
+        raise ValueError("marked dual kernel is not a branch point")
