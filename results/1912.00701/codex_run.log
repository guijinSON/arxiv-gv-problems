+    current = _curve_j(source, p)
+    target = _curve_j(_read_roots(inst["target_roots"], p), p)
+    if conjugate:
+        previous, current, target = (
+            _conj(previous, p),
+            _conj(current, p),
+            _conj(target, p),
+        )
+    return (
+        p,
+        inst["walk_length"],
+        previous,
+        current,
+        target,
+    )
