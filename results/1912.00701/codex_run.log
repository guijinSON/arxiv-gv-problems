+
+    # G6: three construction-aware probes and the domain-standard collision attack.
+    attack_names = (
+        "endpoint_coordinate_low_bits",
+        "greedy_j_coordinate_distance",
+        "random_restart_64",
+        "bidirectional_meet_in_middle_65536_cap",
