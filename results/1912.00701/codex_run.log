+        "prose_and_fence": parsed == planted,
+        "garbage_is_none": parse_answer("<answer>{bad</answer>") is None,
+    }
+
+    t0 = time.perf_counter()
+    guess_hits, workers = _sample_guessing(inst, 200000)
