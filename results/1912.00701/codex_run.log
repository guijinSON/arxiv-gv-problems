+def _attack_beam(inst, width=4):
+    p, n = inst["p"], inst["n"]
+    targets = [_j(_tuple_curve(c), p) for c in inst["target_primary"]]
+    words = []
+    for target in targets:
+        beam = [(((0, 0), (1, 0)), [])]
+        for i in range(n):
+            nxt_beam = []
+            for curve, word in beam:
+                for label in range(3 if i == 0 else 2):
+                    nxt = _step(curve, label, i == 0, p)
+                    jj = _j(nxt, p)
+                    score = ((jj[0] - target[0]) % p) ^ ((jj[1] - target[1]) % p)
+                    nxt_beam.append((score, nxt, word + [label]))
+            nxt_beam.sort(key=lambda x: x[0])
+            beam = [(c, w) for _, c, w in nxt_beam[:width]]
+        words.append(beam[0][1])
+    return [[words[0][i], words[1][i]] for i in range(n)]
+
