+    roots: tuple[tuple[int, int], ...], kernel_root: tuple[int, int], p: int
+) -> tuple[tuple[int, int], ...]:
+    if kernel_root not in roots:
+        raise ValueError("kernel root is not a branch point")
+    others = list(roots)
