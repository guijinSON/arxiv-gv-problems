+def _sqrt2(x, p):
+    """Return a deterministic square root in F_(p^2), or None."""
+    a, b = x[0] % p, x[1] % p
+    inv2 = (p + 1) // 2
+    if a == 0 and b == 0:
+        return (0, 0)
+    if b == 0:
