+def _carry_word_under_affine(
+    roots: tuple[tuple[int, int], ...],
+    forbidden: tuple[int, int],
+    word: str,
+    multiplier: tuple[int, int],
+    translation: tuple[int, int],
+    p: int,
+    conjugate: bool,
