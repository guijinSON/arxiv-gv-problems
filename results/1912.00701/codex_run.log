+# F_(p^2) elements are tuples (a,b), meaning a+b*i with i^2=-1.  Every preset
+# uses p == 3 mod 4, so this is a field and square roots reduce to F_p roots.
+def _f(x):
+    return (int(x[0]), int(x[1]))
+
+
+def _add(x, y, p):
+    return ((x[0] + y[0]) % p, (x[1] + y[1]) % p)
+
+
+def _neg(x, p):
+    return ((-x[0]) % p, (-x[1]) % p)
+
+
+def _sub(x, y, p):
+    return ((x[0] - y[0]) % p, (x[1] - y[1]) % p)
+
+
+def _mul(x, y, p):
+    return (
+        (x[0] * y[0] - x[1] * y[1]) % p,
+        (x[0] * y[1] + x[1] * y[0]) % p,
+    )
+
+
+def _scale(x, k, p):
+    return (x[0] * k % p, x[1] * k % p)
+
+
+def _inv(x, p):
+    norm = (x[0] * x[0] + x[1] * x[1]) % p
+    if norm == 0:
+        raise ZeroDivisionError("zero in F_(p^2)")
+    ni = pow(norm, p - 2, p)
+    return (x[0] * ni % p, -x[1] * ni % p)
+
+
+def _div(x, y, p):
+    return _mul(x, _inv(y, p), p)
+
+
+def _pow(x, e, p):
+    out = (1, 0)
+    base = x
+    while e:
+        if e & 1:
+            out = _mul(out, base, p)
+        base = _mul(base, base, p)
+        e >>= 1
+    return out
+
+
+def _sqrt_fp(a, p):
+    a %= p
+    r = pow(a, (p + 1) // 4, p)
+    return r if r * r % p == a else None
+
+
+def _sqrt2(x, p):
+    """Return a deterministic square root in F_(p^2), or None."""
+    a, b = x[0] % p, x[1] % p
+    inv2 = (p + 1) // 2
+    if a == 0 and b == 0:
+        return (0, 0)
+    if b == 0:
+        r = _sqrt_fp(a, p)
+        if r is not None:
+            q = (r, 0)
+        else:
+            r = _sqrt_fp(-a, p)
+            if r is None:
+                return None
+            q = (0, r)
+    else:
+        s = _sqrt_fp((a * a + b * b) % p, p)
+        if s is None:
+            return None
+        u = _sqrt_fp((a + s) * inv2 % p, p)
+        if u is None:
+            s = (-s) % p
+            u = _sqrt_fp((a + s) * inv2 % p, p)
+        if u is None or u == 0:
+            return None
+        v = b * pow(2 * u % p, p - 2, p) % p
+        q = (u, v)
+    if _mul(q, q, p) != (a, b):
+        return None
+    nq = _neg(q, p)
+    return min(q, nq)
+
+
+def _curve_roots(curve, p):
+    a2, a4 = curve
+    disc = _sub(_mul(a2, a2, p), _scale(a4, 4, p), p)
+    s = _sqrt2(disc, p)
+    if s is None:
+        raise ArithmeticError("2-torsion did not split over F_(p^2)")
+    inv2 = (p + 1) // 2
+    r1 = _scale(_add(_neg(a2, p), s, p), inv2, p)
+    r2 = _scale(_sub(_neg(a2, p), s, p), inv2, p)
+    return [(0, 0), r1, r2]
+
+
+def _step(curve, label, first, p):
+    """Velu quotient by the order-2 point (r,0), in a normalized model."""
+    a2, a4 = curve
+    roots = _curve_roots(curve, p)
+    if first:
+        choices = sorted(roots)
+    else:
+        # In this normalization x=0 is the kernel of the dual of the preceding
+        # isogeny.  Discarding it is precisely non-backtracking.
+        choices = sorted(r for r in roots if r != (0, 0))
+    r = choices[label]
+    aa = _add(a2, _scale(r, 3, p), p)
+    bb = _add(
+        a4,
+        _add(_scale(_mul(a2, r, p), 2, p), _scale(_mul(r, r, p), 3, p), p),
+        p,
+    )
+    return (_scale(aa, -2, p), _sub(_mul(aa, aa, p), _scale(bb, 4, p), p))
+
+
+def _walk(word, p, want_vertices=False):
+    curve = ((0, 0), (1, 0))
+    vertices = [_j(curve, p)] if want_vertices else None
+    for i, label in enumerate(word):
+        curve = _step(curve, label, i == 0, p)
+        if want_vertices:
+            vertices.append(_j(curve, p))
+    return (curve, vertices) if want_vertices else curve
+
+
+def _j(curve, p):
+    a2, a4 = curve
+    u = _sub(_mul(a2, a2, p), _scale(a4, 3, p), p)
+    num = _scale(_mul(_mul(u, u, p), u, p), 256, p)
+    den = _mul(
+        _mul(a4, a4, p),
+        _sub(_mul(a2, a2, p), _scale(a4, 4, p), p),
+        p,
+    )
+    return _div(num, den, p)
+
+
+def _encode_word(answer, split):
+    first = 3 * answer[0][0] + answer[0][1]
+    lo = first
+    place = 9
+    for a, b in answer[1:split]:
+        lo += place * (2 * a + b)
+        place *= 4
+    hi = 0
+    place = 1
+    for a, b in answer[split:]:
+        hi += place * (2 * a + b)
+        place *= 4
+    return (lo, hi)
+
+
+def _decode_scale(z, n, split):
+    lo, hi = z
+    d0 = lo % 9
+    lo //= 9
+    answer = [[d0 // 3, d0 % 3]]
+    for _ in range(1, split):
+        d = lo % 4
+        lo //= 4
+        answer.append([d // 2, d % 2])
+    for _ in range(split, n):
+        d = hi % 4
+        hi //= 4
+        answer.append([d // 2, d % 2])
+    if lo or hi:
+        return None
+    return answer
+
+
+def _public_model(curve, z, p):
+    """Scale curve so its a2 is z, then make a second model with a2=1."""
+    a2, a4 = curve
+    t = _div(a2, z, p)
+    # x=s^2 X with s^2=t sends (a2,a4) to (a2/t,a4/t^2).
+    primary = (_div(a2, t, p), _div(a4, _mul(t, t, p), p))
+    alternate = (_div(primary[0], z, p), _div(primary[1], _mul(z, z, p), p))
+    if primary[0] != z or alternate[0] != (1, 0):
+        raise AssertionError("bad curve scaling")
+    return primary, alternate
+
+
+def _json_curve(curve):
+    return [[curve[0][0], curve[0][1]], [curve[1][0], curve[1][1]]]
+
+
+def _tuple_curve(curve):
+    return (_f(curve[0]), _f(curve[1]))
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a product (2,2)-isogeny path and its kernel word."""
+    p = int(params.get("p", 2147483647))
+    n = int(n)
+    if n < 1:
+        raise ValueError("n must be positive")
+    if p <= 3 or p % 4 != 3:
+        raise ValueError("p must be a prime congruent to 3 modulo 4")
+    split = (n + 1) // 2
+    if 9 * 4 ** (split - 1) >= p or 4 ** (n - split) >= p:
+        raise ValueError("p is too small for the two-limb path encoding")
+    rng = random.Random(seed)
+    for construction_attempt in range(10000):
+        answer = [[rng.randrange(3), rng.randrange(3)]]
+        answer += [[rng.randrange(2), rng.randrange(2)] for _ in range(n - 1)]
+        words = [[row[k] for row in answer] for k in range(2)]
+        endpoint_curves = [_walk(word, p) for word in words]
+        z = _encode_word(answer, split)
+        # These square conditions make every advertised coordinate change
+        # defined over F_(p^2), not merely over its algebraic closure.
+        if z == (0, 0) or _sqrt2(z, p) is None:
+            continue
+        if any(c[0] == (0, 0) or _sqrt2(c[0], p) is None for c in endpoint_curves):
+            continue
+        models = [_public_model(c, z, p) for c in endpoint_curves]
+        primary = [_json_curve(m[0]) for m in models]
+        alternate = [_json_curve(m[1]) for m in models]
+        inst = {
+            "family": "product_2_isogeny_path_with_scaled_presentations",
+            "n": n,
+            "p": p,
+            "split": split,
+            "source": [_json_curve(((0, 0), (1, 0)))] * 2,
+            "target_primary": primary,
+            "target_alternate": alternate,
+            "answer": answer,
+            "construction_attempt": construction_attempt,
+        }
+        ok, reason = verify(inst, answer)
+        if not ok:
+            raise AssertionError("constructed witness failed: " + reason)
+        return inst
+    raise RuntimeError("could not satisfy square-scaling conditions")
+
+
+def _fmt_fe(x):
+    return f"[{x[0]},{x[1]}]"
+
+
+def _fmt_curve(c):
+    return f"a2={_fmt_fe(c[0])}, a4={_fmt_fe(c[1])}"
+
+
+def render(inst):
+    p, n = inst["p"], inst["n"]
+    prim = [_tuple_curve(c) for c in inst["target_primary"]]
+    alt = [_tuple_curve(c) for c in inst["target_alternate"]]
+    lines = [
+        "Find a non-backtracking product (2,2)-isogeny path.",
+        "",
+        f"Work in F_(p^2)=F_p[i]/(i^2+1), with p={p}. Represent a+b*i as [a,b],",
+        "where both coordinates are the least residues in {0,...,p-1}.",
+        "Write E(a2,a4) for y^2=x^3+a2*x^2+a4*x. Both ordered source factors",
+        "start at E([0,0],[1,0]). The target is the product of the two factors",
+        "below; swapping the two target factors is allowed.",
+        "",
+        "Primary target presentations:",
+        f"  factor 0: {_fmt_curve(prim[0])}",
+        f"  factor 1: {_fmt_curve(prim[1])}",
+        "Alternate presentations of the same respective target factors:",
+        f"  factor 0: {_fmt_curve(alt[0])}",
+        f"  factor 1: {_fmt_curve(alt[1])}",
+        "For each factor, primary and alternate are related by x=s^2*X,",
+        "y=s^3*Y for one common nonzero s in F_(p^2).",
+        "",
+        f"Your answer must contain exactly {n} ordered pairs [u_k,v_k]. At k=0,",
+        "u_0 and v_0 are in {0,1,2}; at every k>0 they are in {0,1}.",
+        "To apply one label to a current E(a2,a4), find the three roots of",
+        "x*(x^2+a2*x+a4). At k=0 sort all roots lexicographically by their",
+        "[real,imaginary] pairs and select the root with the stated label. At k>0",
+        "discard root [0,0] (the dual/backtracking kernel), sort the other two,",
+        "and select the root with the stated label. If r is selected, set",
+        "A=a2+3r and B=a4+2*a2*r+3*r^2; the next curve is E(-2A,A^2-4B).",
+        "Use u_k for source factor 0 and v_k for source factor 1.",
+        "",
+        "After all steps, each resulting curve must have the j-invariant of its",
+        "target factor, directly or after swapping factors. For E(a2,a4),",
+        "j=256*(a2^2-3*a4)^3/(a4^2*(a2^2-4*a4)) in F_(p^2).",
+        "All equalities and divisions are exact in F_(p^2); indexing is 0-based.",
+        "Repeated labels are allowed. The path has exactly the stated length.",
+        "",
+        "Give your final answer inside <answer></answer> tags, as a JSON list of",
+        f"exactly {n} integer pairs. Example: <answer>[[0,2],[1,0],[0,1]]</answer>",
+        "Output nothing else inside the tags.",
+    ]
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines += ["", "Hint: " + STRUCTURAL_HINT]
+    elif mode == "placebo":
+        lines += ["", "Hint: " + PLACEBO_HINT]
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    match = re.search(r"<answer>\s*(.*?)\s*</answer>", text, re.I | re.S)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    if payload.startswith("```"):
+        payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
+        payload = re.sub(r"\s*```$", "", payload)
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, list) else None
+
+
+def _validate_shape(inst, answer):
+    n = inst["n"]
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) < n:
+        return False, f"too few steps: expected {n}"
+    if len(answer) > n:
+        return False, f"too many steps: expected {n}"
+    for i, pair in enumerate(answer):
+        if not isinstance(pair, list) or len(pair) != 2:
+            return False, f"step {i} is not an integer pair"
+        if any(type(x) is not int for x in pair):
+            return False, f"step {i} contains a non-integer label"
+        upper = 2 if i == 0 else 1
+        if any(x < 0 or x > upper for x in pair):
+            return False, f"step {i} label is out of range 0..{upper}"
+    return True, "ok"
+
+
+def verify(inst, answer):
+    ok, reason = _validate_shape(inst, answer)
+    if not ok:
+        return False, reason
+    try:
+        p = int(inst["p"])
+        words = [[row[k] for row in answer] for k in range(2)]
+        got = [_j(_walk(word, p), p) for word in words]
+        targets = [_j(_tuple_curve(c), p) for c in inst["target_primary"]]
+    except (ArithmeticError, IndexError, KeyError, TypeError, ValueError, ZeroDivisionError):
+        return False, "finite-field isogeny computation failed"
+    if got == targets or got == list(reversed(targets)):
+        return True, "ok"
+    return False, "endpoint j-invariants do not match the target product"
+
+
+def random_candidate(inst, rng):
+    n = inst["n"]
+    out = [[rng.randrange(3), rng.randrange(3)]]
+    out += [[rng.randrange(2), rng.randrange(2)] for _ in range(n - 1)]
+    return out
+
+
+def search_space(inst):
+    return 9 * 4 ** (inst["n"] - 1)
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 250000:
+        return None
+    n = inst["n"]
+    valid = 0
+    for code in range(space):
+        d0 = code % 9
+        code //= 9
+        candidate = [[d0 // 3, d0 % 3]]
+        for _ in range(1, n):
+            d = code % 4
+            code //= 4
+            candidate.append([d // 2, d % 2])
+        valid += int(verify(inst, candidate)[0])
+    return valid
+
+
+def canonical_key(inst):
+    p = int(inst["p"])
+    js = sorted(_j(_tuple_curve(c), p) for c in inst["target_primary"])
+    payload = {"p": p, "n": int(inst["n"]), "source_j": _j(((0, 0), (1, 0)), p), "target_j": js}
+    return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def escalate(params):
+    params = {k: v for k, v in dict(params).items() if k != "_preset"}
+    n = int(params["n"])
+    p = int(params.get("p", 2147483647))
+    if p == 2147483647:
+        if n < 28:
+            return {"n": n + 1, "p": p}
+        return {"n": 36, "p": 2305843009213693951}
+    if p == 2305843009213693951:
+        if n < 58:
+            return {"n": min(58, n + 6), "p": p}
+        return {"n": 72, "p": 170141183460469231731687303715884105727}
+    if n < 120:
+        return {"n": min(120, n + 12), "p": p}
+    return "cap_bound"
+
+
+def _side_channel_decode(inst):
+    p = inst["p"]
+    primary = [_tuple_curve(c) for c in inst["target_primary"]]
+    alternate = [_tuple_curve(c) for c in inst["target_alternate"]]
+    z0 = _div(primary[0][0], alternate[0][0], p)
+    z1 = _div(primary[1][0], alternate[1][0], p)
+    if z0 != z1:
+        return None
+    return _decode_scale(z0, inst["n"], inst["split"])
+
+
+def _expand_level(frontier, first, p):
+    out = []
+    labels = range(3) if first else range(2)
+    for curve, prev_j, word in frontier:
+        cur_j = _j(curve, p)
+        for label in labels:
+            nxt = _step(curve, label, first, p)
+            nxt_j = _j(nxt, p)
+            out.append((nxt, cur_j, word + (label,)))
+    return out
+
+
+def _mitm_factor(target_curve, n, p):
+    """Exact bidirectional search for one factor; returns a valid label word."""
+    left_depth = n // 2
+    right_depth = n - left_depth
+    source = ((0, 0), (1, 0))
+    forward = [(source, None, ())]
+    for depth in range(left_depth):
+        forward = _expand_level(forward, depth == 0, p)
+    by_j = {}
+    for state in forward:
+        by_j.setdefault(_j(state[0], p), []).append(state)
+
+    reverse = [(target_curve, None, ())]
+    for depth in range(right_depth):
+        reverse = _expand_level(reverse, depth == 0, p)
+    for rcurve, rprev, rword in reverse:
+        meet_j = _j(rcurve, p)
+        for fcurve, fprev, fword in by_j.get(meet_j, ()):
+            if fprev is not None and rprev is not None and fprev == rprev:
+                continue
+            # Recreate the target-to-meet vertex list, reverse it, then translate
+            # that intrinsic j-path back into the forward model's canonical labels.
+            _, rev_vertices = _walk_from(target_curve, rword, p)
+            toward_target = list(reversed(rev_vertices[:-1]))
+            curve = fcurve
+            suffix = []
+            possible = True
+            for wanted_j in toward_target:
+                matches = []
+                for label in range(2):
+                    nxt = _step(curve, label, False, p)
+                    if _j(nxt, p) == wanted_j:
+                        matches.append((label, nxt))
+                if not matches:
+                    possible = False
+                    break
+                label, curve = matches[0]
+                suffix.append(label)
+            if possible and _j(curve, p) == _j(target_curve, p):
+                word = list(fword) + suffix
+                if len(word) == n and _j(_walk(word, p), p) == _j(target_curve, p):
+                    return word
+    return None
+
+
+def _walk_from(curve, word, p):
+    vertices = [_j(curve, p)]
+    for i, label in enumerate(word):
+        curve = _step(curve, label, i == 0, p)
+        vertices.append(_j(curve, p))
+    return curve, vertices
+
+
+def _reference_algorithm(inst):
+    p, n = inst["p"], inst["n"]
+    targets = [_tuple_curve(c) for c in inst["target_primary"]]
+    words = [_mitm_factor(target, n, p) for target in targets]
+    if any(w is None for w in words):
+        return None
+    answer = [[words[0][i], words[1][i]] for i in range(n)]
+    return answer if verify(inst, answer)[0] else None
+
+
+def _attack_outlier(inst):
+    p, n = inst["p"], inst["n"]
+    prim = [_tuple_curve(c) for c in inst["target_primary"]]
+    first = [((c[1][0] + c[1][1]) % 3) for c in prim]
+    out = [first]
+    state = [c[1][0] ^ c[1][1] for c in prim]
+    for i in range(1, n):
+        out.append([(state[k] >> (i % 29)) & 1 for k in range(2)])
+    return out
+
+
+def _attack_greedy(inst):
+    p, n = inst["p"], inst["n"]
+    targets = [_j(_tuple_curve(c), p) for c in inst["target_primary"]]
+    words = []
+    for target in targets:
+        curve = ((0, 0), (1, 0))
+        word = []
+        for i in range(n):
+            candidates = []
+            for label in range(3 if i == 0 else 2):
+                nxt = _step(curve, label, i == 0, p)
+                jj = _j(nxt, p)
+                distance = min((jj[0] - target[0]) % p, (target[0] - jj[0]) % p)
+                distance += min((jj[1] - target[1]) % p, (target[1] - jj[1]) % p)
+                candidates.append((distance, label, nxt))
+            _, label, curve = min(candidates)
+            word.append(label)
+        words.append(word)
+    return [[words[0][i], words[1][i]] for i in range(n)]
+
+
+def _attack_random_restart(inst, seed, restarts=32):
+    rng = random.Random(seed)
+    for _ in range(restarts):
+        answer = random_candidate(inst, rng)
+        if verify(inst, answer)[0]:
+            return answer
+    return None
+
+
+def _attack_raw_coefficients(inst):
+    n = inst["n"]
+    vals = []
+    for curve in inst["target_primary"]:
+        vals.extend(curve[1])
+    out = []
+    for i in range(n):
+        if i == 0:
+            out.append([vals[0] % 3, vals[1] % 3])
+        else:
+            out.append([(vals[i % len(vals)] >> (i % 17)) & 1,
+                        (vals[(i + 1) % len(vals)] >> ((i + 3) % 17)) & 1])
+    return out
+
+
+def _attack_beam(inst, width=4):
+    p, n = inst["p"], inst["n"]
+    targets = [_j(_tuple_curve(c), p) for c in inst["target_primary"]]
+    words = []
+    for target in targets:
+        beam = [(((0, 0), (1, 0)), [])]
+        for i in range(n):
+            nxt_beam = []
+            for curve, word in beam:
+                for label in range(3 if i == 0 else 2):
+                    nxt = _step(curve, label, i == 0, p)
+                    jj = _j(nxt, p)
+                    score = ((jj[0] - target[0]) % p) ^ ((jj[1] - target[1]) % p)
+                    nxt_beam.append((score, nxt, word + [label]))
+            nxt_beam.sort(key=lambda x: x[0])
+            beam = [(c, w) for _, c, w in nxt_beam[:width]]
+        words.append(beam[0][1])
+    return [[words[0][i], words[1][i]] for i in range(n)]
+
+
+def _guess_chunk(payload):
+    inst, seed, count = payload
+    rng = random.Random(seed)
+    hits = 0
+    for _ in range(count):
+        hits += int(verify(inst, random_candidate(inst, rng))[0])
+    return hits
+
+
+def _sample_guessing(inst, total=200000):
+    workers = max(1, min(32, os.cpu_count() or 1))
+    if total < workers * 20:
+        workers = 1
+    chunks = [total // workers] * workers
+    for i in range(total % workers):
+        chunks[i] += 1
+    payloads = [(inst, 0x191200701 + i * 1000003, chunks[i]) for i in range(workers)]
+    if workers == 1:
+        return _guess_chunk(payloads[0]), 1
+    try:
+        with ProcessPoolExecutor(max_workers=workers) as pool:
+            return sum(pool.map(_guess_chunk, payloads)), workers
+    except Exception:
+        # Some embedded Python hosts cannot spawn an importable worker module.
+        return sum(_guess_chunk(x) for x in payloads), 1
