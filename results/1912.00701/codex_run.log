+def _div(x, y, p):
+    return _mul(x, _inv(y, p), p)
+
+
+def _pow(x, e, p):
+    out = (1, 0)
+    base = x
+    while e:
+        if e & 1:
+            out = _mul(out, base, p)
+        base = _mul(base, base, p)
+        e >>= 1
+    return out
+
+
+def _sqrt_fp(a, p):
+    a %= p
+    r = pow(a, (p + 1) // 4, p)
+    return r if r * r % p == a else None
+
+
+def _sqrt2(x, p):
+    """Return a deterministic square root in F_(p^2), or None."""
+    a, b = x[0] % p, x[1] % p
+    inv2 = (p + 1) // 2
+    if a == 0 and b == 0:
+        return (0, 0)
+    if b == 0:
+        r = _sqrt_fp(a, p)
+        if r is not None:
+            q = (r, 0)
+        else:
+            r = _sqrt_fp(-a, p)
+            if r is None:
+                return None
+            q = (0, r)
+    else:
+        s = _sqrt_fp((a * a + b * b) % p, p)
+        if s is None:
+            return None
+        u = _sqrt_fp((a + s) * inv2 % p, p)
+        if u is None:
+            s = (-s) % p
+            u = _sqrt_fp((a + s) * inv2 % p, p)
+        if u is None or u == 0:
+            return None
