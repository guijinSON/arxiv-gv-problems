+    start_j = _curve_j(roots, p)
+    # The target is un-oriented: its first reverse step may use any of 3 roots.
+    frontier: list[tuple[tuple[tuple[int, int], ...], tuple[int, int] | None, list[tuple[int, int]]]] = [
