+def _sqrt_fp(a, p):
+    a %= p
+    r = pow(a, (p + 1) // 4, p)
+    return r if r * r % p == a else None
+
+
+def _sqrt2(x, p):
+    """Return a deterministic square root in F_(p^2), or None."""
+    a, b = x[0] % p, x[1] % p
+    inv2 = (p + 1) // 2
+    if a == 0 and b == 0:
+        return (0, 0)
+    if b == 0:
+        r = _sqrt_fp(a, p)
+        if r is not None:
+            q = (r, 0)
+        else:
+            r = _sqrt_fp(-a, p)
+            if r is None:
+                return None
+            q = (0, r)
+    else:
+        s = _sqrt_fp((a * a + b * b) % p, p)
+        if s is None:
+            return None
+        u = _sqrt_fp((a + s) * inv2 % p, p)
+        if u is None:
+            s = (-s) % p
+            u = _sqrt_fp((a + s) * inv2 % p, p)
+        if u is None or u == 0:
+            return None
+        v = b * pow(2 * u % p, p - 2, p) % p
+        q = (u, v)
+    if _mul(q, q, p) != (a, b):
+        return None
+    nq = _neg(q, p)
+    return min(q, nq)
+
+
+def _curve_roots(curve, p):
+    a2, a4 = curve
+    disc = _sub(_mul(a2, a2, p), _scale(a4, 4, p), p)
+    s = _sqrt2(disc, p)
+    if s is None:
+        raise ArithmeticError("2-torsion did not split over F_(p^2)")
+    inv2 = (p + 1) // 2
+    r1 = _scale(_add(_neg(a2, p), s, p), inv2, p)
+    r2 = _scale(_sub(_neg(a2, p), s, p), inv2, p)
+    return [(0, 0), r1, r2]
