+        answer = [[rng.randrange(3), rng.randrange(3)]]
+        answer += [[rng.randrange(2), rng.randrange(2)] for _ in range(n - 1)]
+        words = [[row[k] for row in answer] for k in range(2)]
+        endpoint_curves = [_walk(word, p) for word in words]
+        z = _encode_word(answer, split)
