+++ b/gen_1912_00701.py
@@ -0,0 +1,920 @@
+"""Verified generator inspired by arXiv:1912.00701.
+
+The instances are product (2,2)-isogeny path problems.  Each factor starts at
+the supersingular curve y^2=x^3+x over F_(p^2), p == 3 (mod 4).  A witness is
+the pair of kernel choices at every step.  The planted witness is sampled
+before the endpoint is constructed.
+
+Only the Python standard library is required.  The repository gvlib package
+does not currently provide finite-field or isogeny arithmetic, so this module
+implements the small exact layer it needs.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+from concurrent.futures import ProcessPoolExecutor
+
+
+TRACK = "B"
+SHIPPING_DIFFICULTY = "easy"
+
+PROBLEM_PROFILE = {
+    "native_domain": "number_theory",
+    "object_regime": "finite_field",
+    "computational_core": "other",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "supersingular elliptic curves over F_(p^2)",
+        "product principally polarized abelian surface",
+        "kernels of product (2,2)-isogenies",
+    ],
+    "verification_operations": [
+        "exact quadratic-extension finite-field arithmetic",
+        "exact Velu 2-isogeny composition",
+        "exact j-invariant comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "A common coordinate scaling between redundant target curve models "
+        "encodes the paired kernel choices; without noticing it, one must "
+        "search two non-backtracking elliptic 2-isogeny trees."
+    ),
+    "hardness_basis": (
+        "Track B: Section 2's fixed-length elliptic isogeny search, applied "
+        "factorwise through Lemma 1, has a bidirectional complexity "
+        "O(2^(n/2)); at the shipping preset the bundled exact "
+        "meet-in-the-middle reference search is measured by selftest, while "
+        "the coordinate-scale decoder uses fewer than 40 field/integer operations."
+    ),
+    "max_answer_tokens": 40,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 3, "p": 127},
+    "easy": {"n": 26, "p": 2147483647},
+    "medium": {"n": 27, "p": 2147483647},
+    "hard": {"n": 28, "p": 2147483647},
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "Exactly n ordered pairs of kernel labels.  At step 0 each label is "
+        "in {0,1,2}; at every later step each is in {0,1}."
+    ),
+    "bounds": {"steps": "instance n", "first_step_radix": 3, "later_radix": 2},
+}
+
+STRUCTURAL_HINT = (
+    "The common coordinate scaling between the paired target models is aligned with the mixed-radix kernel labels."
+)
+PLACEBO_HINT = (
+    "The repeated curve data is supplied to make all endpoint conventions explicit and independently checkable."
+)
+
+NOTES = """
+Section 4 supplies the PPAV, Lagrangian-kernel, and (ell,...,ell)-isogeny
+definitions.  Section 5 identifies a genus-2 PPAV as either a genus-2 Jacobian
+or a product of elliptic curves.  Lemma 1 proves that equal-parity factor paths
+compose to a product path.  Section 2 defines fixed-length path finding and
+states the best generic elliptic costs; Theorem 1 and its proof show that the
+general genus-2 problem has a ~O(p) attack and that product nodes recurse to
+elliptic path finding.  Thus this is Track B: an algorithm exists and is
+reported, rather than hidden as a Track-A claim.
+
+Generation is inverse: sample both non-backtracking factor words, compose
+their exact Velu quotients, then publish the endpoint product.  The same secret
+word is also carried by a common change of variables between two legitimate
+Weierstrass presentations of the target factors.  This is the compact route.
+Plants and random candidates use exactly the same 9*4^(n-1) word distribution.
+Endpoint-coefficient, greedy, random-restart, and raw-coefficient attacks were
+included because earlier versions exposed the planted word through position or
+coefficient size.  The primary target models now have a common uniformly
+conditioned square scale and the decoders tested in those attacks do not use
+the mixed-radix invariant.
+""".strip()
+
+
+# F_(p^2) elements are tuples (a,b), meaning a+b*i with i^2=-1.  Every preset
+# uses p == 3 mod 4, so this is a field and square roots reduce to F_p roots.
+def _f(x):
+    return (int(x[0]), int(x[1]))
+
+
+def _add(x, y, p):
+    return ((x[0] + y[0]) % p, (x[1] + y[1]) % p)
+
+
+def _neg(x, p):
+    return ((-x[0]) % p, (-x[1]) % p)
+
+
+def _sub(x, y, p):
+    return ((x[0] - y[0]) % p, (x[1] - y[1]) % p)
+
+
+def _mul(x, y, p):
+    return (
+        (x[0] * y[0] - x[1] * y[1]) % p,
+        (x[0] * y[1] + x[1] * y[0]) % p,
+    )
+
+
+def _scale(x, k, p):
+    return (x[0] * k % p, x[1] * k % p)
+
+
+def _inv(x, p):
+    norm = (x[0] * x[0] + x[1] * x[1]) % p
+    if norm == 0:
+        raise ZeroDivisionError("zero in F_(p^2)")
+    ni = pow(norm, p - 2, p)
+    return (x[0] * ni % p, -x[1] * ni % p)
+
+
+def _div(x, y, p):
+    return _mul(x, _inv(y, p), p)
+
+
+def _pow(x, e, p):
+    out = (1, 0)
+    base = x
+    while e:
+        if e & 1:
+            out = _mul(out, base, p)
+        base = _mul(base, base, p)
+        e >>= 1
+    return out
+
+
+def _sqrt_fp(a, p):
+    a %= p
+    r = pow(a, (p + 1) // 4, p)
+    return r if r * r % p == a else None
+
+
+def _sqrt2(x, p):
+    """Return a deterministic square root in F_(p^2), or None."""
+    a, b = x[0] % p, x[1] % p
+    inv2 = (p + 1) // 2
+    if a == 0 and b == 0:
+        return (0, 0)
+    if b == 0:
+        r = _sqrt_fp(a, p)
+        if r is not None:
+            q = (r, 0)
+        else:
+            r = _sqrt_fp(-a, p)
+            if r is None:
+                return None
+            q = (0, r)
+    else:
+        s = _sqrt_fp((a * a + b * b) % p, p)
+        if s is None:
+            return None
+        u = _sqrt_fp((a + s) * inv2 % p, p)
+        if u is None:
+            s = (-s) % p
+            u = _sqrt_fp((a + s) * inv2 % p, p)
+        if u is None or u == 0:
+            return None
+        v = b * pow(2 * u % p, p - 2, p) % p
+        q = (u, v)
+    if _mul(q, q, p) != (a, b):
+        return None
+    nq = _neg(q, p)
+    return min(q, nq)
+
+
+def _curve_roots(curve, p):
+    a2, a4 = curve
+    disc = _sub(_mul(a2, a2, p), _scale(a4, 4, p), p)
+    s = _sqrt2(disc, p)
+    if s is None:
+        raise ArithmeticError("2-torsion did not split over F_(p^2)")
+    inv2 = (p + 1) // 2
+    r1 = _scale(_add(_neg(a2, p), s, p), inv2, p)
+    r2 = _scale(_sub(_neg(a2, p), s, p), inv2, p)
+    return [(0, 0), r1, r2]
+
+
+def _step(curve, label, first, p):
+    """Velu quotient by the order-2 point (r,0), in a normalized model."""
+    a2, a4 = curve
+    roots = _curve_roots(curve, p)
+    if first:
+        choices = sorted(roots)
+    else:
+        # In this normalization x=0 is the kernel of the dual of the preceding
+        # isogeny.  Discarding it is precisely non-backtracking.
+        choices = sorted(r for r in roots if r != (0, 0))
+    r = choices[label]
+    aa = _add(a2, _scale(r, 3, p), p)
+    bb = _add(
+        a4,
+        _add(_scale(_mul(a2, r, p), 2, p), _scale(_mul(r, r, p), 3, p), p),
+        p,
+    )
+    return (_scale(aa, -2, p), _sub(_mul(aa, aa, p), _scale(bb, 4, p), p))
+
+
+def _walk(word, p, want_vertices=False):
+    curve = ((0, 0), (1, 0))
+    vertices = [_j(curve, p)] if want_vertices else None
+    for i, label in enumerate(word):
+        curve = _step(curve, label, i == 0, p)
+        if want_vertices:
+            vertices.append(_j(curve, p))
+    return (curve, vertices) if want_vertices else curve
+
+
+def _j(curve, p):
+    a2, a4 = curve
+    u = _sub(_mul(a2, a2, p), _scale(a4, 3, p), p)
+    num = _scale(_mul(_mul(u, u, p), u, p), 256, p)
+    den = _mul(
+        _mul(a4, a4, p),
+        _sub(_mul(a2, a2, p), _scale(a4, 4, p), p),
+        p,
+    )
+    return _div(num, den, p)
+
+
+def _encode_word(answer, split):
+    first = 3 * answer[0][0] + answer[0][1]
+    lo = first
+    place = 9
+    for a, b in answer[1:split]:
+        lo += place * (2 * a + b)
+        place *= 4
+    hi = 0
+    place = 1
+    for a, b in answer[split:]:
+        hi += place * (2 * a + b)
+        place *= 4
+    return (lo, hi)
+
+
+def _decode_scale(z, n, split):
+    lo, hi = z
+    d0 = lo % 9
+    lo //= 9
+    answer = [[d0 // 3, d0 % 3]]
+    for _ in range(1, split):
+        d = lo % 4
+        lo //= 4
+        answer.append([d // 2, d % 2])
+    for _ in range(split, n):
+        d = hi % 4
+        hi //= 4
+        answer.append([d // 2, d % 2])
+    if lo or hi:
+        return None
+    return answer
+
+
+def _public_model(curve, z, p):
+    """Scale curve so its a2 is z, then make a second model with a2=1."""
+    a2, a4 = curve
+    t = _div(a2, z, p)
+    # x=s^2 X with s^2=t sends (a2,a4) to (a2/t,a4/t^2).
+    primary = (_div(a2, t, p), _div(a4, _mul(t, t, p), p))
+    alternate = (_div(primary[0], z, p), _div(primary[1], _mul(z, z, p), p))
+    if primary[0] != z or alternate[0] != (1, 0):
+        raise AssertionError("bad curve scaling")
+    return primary, alternate
+
+
+def _json_curve(curve):
+    return [[curve[0][0], curve[0][1]], [curve[1][0], curve[1][1]]]
+
+
+def _tuple_curve(curve):
+    return (_f(curve[0]), _f(curve[1]))
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a product (2,2)-isogeny path and its kernel word."""
+    p = int(params.get("p", 2147483647))
+    n = int(n)
+    if n < 1:
+        raise ValueError("n must be positive")
+    if p <= 3 or p % 4 != 3:
+        raise ValueError("p must be a prime congruent to 3 modulo 4")
+    split = (n + 1) // 2
+    if 9 * 4 ** (split - 1) >= p or 4 ** (n - split) >= p:
+        raise ValueError("p is too small for the two-limb path encoding")
+    rng = random.Random(seed)
+    for construction_attempt in range(10000):
+        answer = [[rng.randrange(3), rng.randrange(3)]]
+        answer += [[rng.randrange(2), rng.randrange(2)] for _ in range(n - 1)]
+        words = [[row[k] for row in answer] for k in range(2)]
+        endpoint_curves = [_walk(word, p) for word in words]
+        z = _encode_word(answer, split)
+        # These square conditions make every advertised coordinate change
+        # defined over F_(p^2), not merely over its algebraic closure.
+        if z == (0, 0) or _sqrt2(z, p) is None:
+            continue
+        if any(c[0] == (0, 0) or _sqrt2(c[0], p) is None for c in endpoint_curves):
+            continue
+        models = [_public_model(c, z, p) for c in endpoint_curves]
+        primary = [_json_curve(m[0]) for m in models]
+        alternate = [_json_curve(m[1]) for m in models]
+        inst = {
+            "family": "product_2_isogeny_path_with_scaled_presentations",
+            "n": n,
+            "p": p,
+            "split": split,
+            "source": [_json_curve(((0, 0), (1, 0)))] * 2,
+            "target_primary": primary,
+            "target_alternate": alternate,
+            "answer": answer,
+            "construction_attempt": construction_attempt,
+        }
+        ok, reason = verify(inst, answer)
+        if not ok:
+            raise AssertionError("constructed witness failed: " + reason)
+        return inst
+    raise RuntimeError("could not satisfy square-scaling conditions")
+
+
+def _fmt_fe(x):
+    return f"[{x[0]},{x[1]}]"
+
+
+def _fmt_curve(c):
+    return f"a2={_fmt_fe(c[0])}, a4={_fmt_fe(c[1])}"
+
+
+def render(inst):
+    p, n = inst["p"], inst["n"]
+    prim = [_tuple_curve(c) for c in inst["target_primary"]]
+    alt = [_tuple_curve(c) for c in inst["target_alternate"]]
+    lines = [
+        "Find a non-backtracking product (2,2)-isogeny path.",
+        "",
+        f"Work in F_(p^2)=F_p[i]/(i^2+1), with p={p}. Represent a+b*i as [a,b],",
+        "where both coordinates are the least residues in {0,...,p-1}.",
+        "Write E(a2,a4) for y^2=x^3+a2*x^2+a4*x. Both ordered source factors",
+        "start at E([0,0],[1,0]). The target is the product of the two factors",
+        "below; swapping the two target factors is allowed.",
+        "",
+        "Primary target presentations:",
+        f"  factor 0: {_fmt_curve(prim[0])}",
+        f"  factor 1: {_fmt_curve(prim[1])}",
+        "Alternate presentations of the same respective target factors:",
+        f"  factor 0: {_fmt_curve(alt[0])}",
+        f"  factor 1: {_fmt_curve(alt[1])}",
+        "For each factor, primary and alternate are related by x=s^2*X,",
+        "y=s^3*Y for one common nonzero s in F_(p^2).",
+        "",
+        f"Your answer must contain exactly {n} ordered pairs [u_k,v_k]. At k=0,",
+        "u_0 and v_0 are in {0,1,2}; at every k>0 they are in {0,1}.",
+        "To apply one label to a current E(a2,a4), find the three roots of",
+        "x*(x^2+a2*x+a4). At k=0 sort all roots lexicographically by their",
+        "[real,imaginary] pairs and select the root with the stated label. At k>0",
+        "discard root [0,0] (the dual/backtracking kernel), sort the other two,",
+        "and select the root with the stated label. If r is selected, set",
+        "A=a2+3r and B=a4+2*a2*r+3*r^2; the next curve is E(-2A,A^2-4B).",
+        "Use u_k for source factor 0 and v_k for source factor 1.",
+        "",
+        "After all steps, each resulting curve must have the j-invariant of its",
+        "target factor, directly or after swapping factors. For E(a2,a4),",
+        "j=256*(a2^2-3*a4)^3/(a4^2*(a2^2-4*a4)) in F_(p^2).",
+        "All equalities and divisions are exact in F_(p^2); indexing is 0-based.",
+        "Repeated labels are allowed. The path has exactly the stated length.",
+        "",
+        "Give your final answer inside <answer></answer> tags, as a JSON list of",
+        f"exactly {n} integer pairs. Example: <answer>[[0,2],[1,0],[0,1]]</answer>",
+        "Output nothing else inside the tags.",
+    ]
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines += ["", "Hint: " + STRUCTURAL_HINT]
+    elif mode == "placebo":
+        lines += ["", "Hint: " + PLACEBO_HINT]
+    return "\n".join(lines)
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    match = re.search(r"<answer>\s*(.*?)\s*</answer>", text, re.I | re.S)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    if payload.startswith("```"):
+        payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
+        payload = re.sub(r"\s*```$", "", payload)
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError):
+        return None
+    return value if isinstance(value, list) else None
+
+
+def _validate_shape(inst, answer):
+    n = inst["n"]
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    if len(answer) < n:
+        return False, f"too few steps: expected {n}"
+    if len(answer) > n:
+        return False, f"too many steps: expected {n}"
+    for i, pair in enumerate(answer):
+        if not isinstance(pair, list) or len(pair) != 2:
+            return False, f"step {i} is not an integer pair"
+        if any(type(x) is not int for x in pair):
+            return False, f"step {i} contains a non-integer label"
+        upper = 2 if i == 0 else 1
+        if any(x < 0 or x > upper for x in pair):
+            return False, f"step {i} label is out of range 0..{upper}"
+    return True, "ok"
+
+
+def verify(inst, answer):
+    ok, reason = _validate_shape(inst, answer)
+    if not ok:
+        return False, reason
+    try:
+        p = int(inst["p"])
+        words = [[row[k] for row in answer] for k in range(2)]
+        got = [_j(_walk(word, p), p) for word in words]
+        targets = [_j(_tuple_curve(c), p) for c in inst["target_primary"]]
+    except (ArithmeticError, IndexError, KeyError, TypeError, ValueError, ZeroDivisionError):
+        return False, "finite-field isogeny computation failed"
+    if got == targets or got == list(reversed(targets)):
+        return True, "ok"
+    return False, "endpoint j-invariants do not match the target product"
+
+
+def random_candidate(inst, rng):
+    n = inst["n"]
+    out = [[rng.randrange(3), rng.randrange(3)]]
+    out += [[rng.randrange(2), rng.randrange(2)] for _ in range(n - 1)]
+    return out
+
+
+def search_space(inst):
+    return 9 * 4 ** (inst["n"] - 1)
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 250000:
+        return None
+    n = inst["n"]
+    valid = 0
+    for code in range(space):
+        d0 = code % 9
+        code //= 9
+        candidate = [[d0 // 3, d0 % 3]]
+        for _ in range(1, n):
+            d = code % 4
+            code //= 4
+            candidate.append([d // 2, d % 2])
+        valid += int(verify(inst, candidate)[0])
+    return valid
+
+
+def canonical_key(inst):
+    p = int(inst["p"])
+    js = sorted(_j(_tuple_curve(c), p) for c in inst["target_primary"])
+    payload = {"p": p, "n": int(inst["n"]), "source_j": _j(((0, 0), (1, 0)), p), "target_j": js}
+    return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def escalate(params):
+    params = {k: v for k, v in dict(params).items() if k != "_preset"}
+    n = int(params["n"])
+    p = int(params.get("p", 2147483647))
+    if p == 2147483647:
+        if n < 28:
+            return {"n": n + 1, "p": p}
+        return {"n": 36, "p": 2305843009213693951}
+    if p == 2305843009213693951:
+        if n < 58:
+            return {"n": min(58, n + 6), "p": p}
+        return {"n": 72, "p": 170141183460469231731687303715884105727}
+    if n < 120:
+        return {"n": min(120, n + 12), "p": p}
+    return "cap_bound"
+
+
+def _side_channel_decode(inst):
+    p = inst["p"]
+    primary = [_tuple_curve(c) for c in inst["target_primary"]]
+    alternate = [_tuple_curve(c) for c in inst["target_alternate"]]
+    z0 = _div(primary[0][0], alternate[0][0], p)
+    z1 = _div(primary[1][0], alternate[1][0], p)
+    if z0 != z1:
+        return None
+    return _decode_scale(z0, inst["n"], inst["split"])
+
+
+def _expand_level(frontier, first, p):
+    out = []
+    labels = range(3) if first else range(2)
+    for curve, prev_j, word in frontier:
+        cur_j = _j(curve, p)
+        for label in labels:
+            nxt = _step(curve, label, first, p)
+            nxt_j = _j(nxt, p)
+            out.append((nxt, cur_j, word + (label,)))
+    return out
+
+
+def _mitm_factor(target_curve, n, p):
+    """Exact bidirectional search for one factor; returns a valid label word."""
+    left_depth = n // 2
+    right_depth = n - left_depth
+    source = ((0, 0), (1, 0))
+    forward = [(source, None, ())]
+    for depth in range(left_depth):
+        forward = _expand_level(forward, depth == 0, p)
+    by_j = {}
+    for state in forward:
+        by_j.setdefault(_j(state[0], p), []).append(state)
+
+    reverse = [(target_curve, None, ())]
+    for depth in range(right_depth):
+        reverse = _expand_level(reverse, depth == 0, p)
+    for rcurve, rprev, rword in reverse:
+        meet_j = _j(rcurve, p)
+        for fcurve, fprev, fword in by_j.get(meet_j, ()):
+            if fprev is not None and rprev is not None and fprev == rprev:
+                continue
+            # Recreate the target-to-meet vertex list, reverse it, then translate
+            # that intrinsic j-path back into the forward model's canonical labels.
+            _, rev_vertices = _walk_from(target_curve, rword, p)
+            toward_target = list(reversed(rev_vertices[:-1]))
+            curve = fcurve
+            suffix = []
+            possible = True
+            for wanted_j in toward_target:
+                matches = []
+                for label in range(2):
+                    nxt = _step(curve, label, False, p)
+                    if _j(nxt, p) == wanted_j:
+                        matches.append((label, nxt))
+                if not matches:
+                    possible = False
+                    break
+                label, curve = matches[0]
+                suffix.append(label)
+            if possible and _j(curve, p) == _j(target_curve, p):
+                word = list(fword) + suffix
+                if len(word) == n and _j(_walk(word, p), p) == _j(target_curve, p):
+                    return word
+    return None
+
+
+def _walk_from(curve, word, p):
+    vertices = [_j(curve, p)]
+    for i, label in enumerate(word):
+        curve = _step(curve, label, i == 0, p)
+        vertices.append(_j(curve, p))
+    return curve, vertices
+
+
+def _reference_algorithm(inst):
+    p, n = inst["p"], inst["n"]
+    targets = [_tuple_curve(c) for c in inst["target_primary"]]
+    words = [_mitm_factor(target, n, p) for target in targets]
+    if any(w is None for w in words):
+        return None
+    answer = [[words[0][i], words[1][i]] for i in range(n)]
+    return answer if verify(inst, answer)[0] else None
+
+
+def _attack_outlier(inst):
+    p, n = inst["p"], inst["n"]
+    prim = [_tuple_curve(c) for c in inst["target_primary"]]
+    first = [((c[1][0] + c[1][1]) % 3) for c in prim]
+    out = [first]
+    state = [c[1][0] ^ c[1][1] for c in prim]
+    for i in range(1, n):
+        out.append([(state[k] >> (i % 29)) & 1 for k in range(2)])
+    return out
+
+
+def _attack_greedy(inst):
+    p, n = inst["p"], inst["n"]
+    targets = [_j(_tuple_curve(c), p) for c in inst["target_primary"]]
+    words = []
+    for target in targets:
+        curve = ((0, 0), (1, 0))
+        word = []
+        for i in range(n):
+            candidates = []
+            for label in range(3 if i == 0 else 2):
+                nxt = _step(curve, label, i == 0, p)
+                jj = _j(nxt, p)
+                distance = min((jj[0] - target[0]) % p, (target[0] - jj[0]) % p)
+                distance += min((jj[1] - target[1]) % p, (target[1] - jj[1]) % p)
+                candidates.append((distance, label, nxt))
+            _, label, curve = min(candidates)
+            word.append(label)
+        words.append(word)
+    return [[words[0][i], words[1][i]] for i in range(n)]
+
+
+def _attack_random_restart(inst, seed, restarts=32):
+    rng = random.Random(seed)
+    for _ in range(restarts):
+        answer = random_candidate(inst, rng)
+        if verify(inst, answer)[0]:
+            return answer
+    return None
+
+
+def _attack_raw_coefficients(inst):
+    n = inst["n"]
+    vals = []
+    for curve in inst["target_primary"]:
+        vals.extend(curve[1])
+    out = []
+    for i in range(n):
+        if i == 0:
+            out.append([vals[0] % 3, vals[1] % 3])
+        else:
+            out.append([(vals[i % len(vals)] >> (i % 17)) & 1,
+                        (vals[(i + 1) % len(vals)] >> ((i + 3) % 17)) & 1])
+    return out
+
+
+def _attack_beam(inst, width=4):
+    p, n = inst["p"], inst["n"]
+    targets = [_j(_tuple_curve(c), p) for c in inst["target_primary"]]
+    words = []
+    for target in targets:
+        beam = [(((0, 0), (1, 0)), [])]
+        for i in range(n):
+            nxt_beam = []
+            for curve, word in beam:
+                for label in range(3 if i == 0 else 2):
+                    nxt = _step(curve, label, i == 0, p)
+                    jj = _j(nxt, p)
+                    score = ((jj[0] - target[0]) % p) ^ ((jj[1] - target[1]) % p)
+                    nxt_beam.append((score, nxt, word + [label]))
+            nxt_beam.sort(key=lambda x: x[0])
+            beam = [(c, w) for _, c, w in nxt_beam[:width]]
+        words.append(beam[0][1])
+    return [[words[0][i], words[1][i]] for i in range(n)]
+
+
+def _guess_chunk(payload):
+    inst, seed, count = payload
+    rng = random.Random(seed)
+    hits = 0
+    for _ in range(count):
+        hits += int(verify(inst, random_candidate(inst, rng))[0])
+    return hits
+
+
+def _sample_guessing(inst, total=200000):
+    workers = max(1, min(32, os.cpu_count() or 1))
+    if total < workers * 20:
+        workers = 1
+    chunks = [total // workers] * workers
+    for i in range(total % workers):
+        chunks[i] += 1
+    payloads = [(inst, 0x191200701 + i * 1000003, chunks[i]) for i in range(workers)]
+    if workers == 1:
+        return _guess_chunk(payloads[0]), 1
+    try:
+        with ProcessPoolExecutor(max_workers=workers) as pool:
+            return sum(pool.map(_guess_chunk, payloads)), workers
+    except Exception:
+        # Some embedded Python hosts cannot spawn an importable worker module.
+        return sum(_guess_chunk(x) for x in payloads), 1
+
+
+def _answer_atoms(value):
+    if isinstance(value, dict):
+        return sum(_answer_atoms(v) for v in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(v) for v in value)
+    return 1
+
+
+def selftest():
+    report = {"track": TRACK, "shipping_difficulty": SHIPPING_DIFFICULTY}
+    g1_attempts = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 29):
+            inst = make_instance(seed=seed, **params)
+            g1_attempts += 1
+            ok, reason = verify(inst, inst["answer"])
+            if not ok:
+                g1_failures.append([preset, seed, reason])
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append([preset, seed, "answer is not JSON-native"])
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures, "attempts": g1_attempts, "failures": g1_failures
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=314159, **ship_params)
+    planted = inst["answer"]
+    corruptions = {}
+    tests = {
+        "empty": [],
+        "drop_one": planted[:-1],
+        "duplicate_one": planted + [planted[-1]],
+        "out_of_range": [[3, planted[0][1]]] + planted[1:],
+    }
+    swapped = None
+    for i in range(len(planted)):
+        for j in range(i + 1, len(planted)):
+            if planted[i] != planted[j]:
+                trial = [x[:] for x in planted]
+                trial[i], trial[j] = trial[j], trial[i]
+                if not verify(inst, trial)[0]:
+                    swapped = trial
+                    break
+        if swapped is not None:
+            break
+    tests["swap_two"] = swapped if swapped is not None else list(reversed(planted))
+    for name, candidate in tests.items():
+        ok, reason = verify(inst, candidate)
+        corruptions[name] = {"rejected": not ok, "reason": reason}
+    reasons = [v["reason"] for v in corruptions.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(v["rejected"] for v in corruptions.values()) and len(set(reasons)) == len(reasons),
+        "cases": corruptions,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    wrapped = "I used the kernel ordering in the statement.\n```text\n<answer>" + json.dumps(planted) + "</answer>\n```"
+    parsed = parse_answer(wrapped)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("no tagged answer") is None,
+        "prose_and_fence": parsed == planted,
+        "garbage_is_none": parse_answer("<answer>{bad</answer>") is None,
+    }
+
+    t0 = time.perf_counter()
+    guess_hits, workers = _sample_guessing(inst, 200000)
+    guess_sec = time.perf_counter() - t0
+    report["G4_guess_resistance"] = {
+        "pass": guess_hits / 200000 < 1e-6,
+        "hits": guess_hits,
+        "total": 200000,
+        "observed_probability": guess_hits / 200000,
+        "structure_aware_space": search_space(inst),
+        "sampler": "uniform valid-shape non-backtracking kernel words",
+        "workers": workers,
+        "wall_clock_sec": round(guess_sec, 6),
+    }
+
+    demo_inst = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo_inst)
+    t0 = time.perf_counter()
+    ref_answer = _reference_algorithm(inst)
+    ref_sec = time.perf_counter() - t0
+    ref_ok = ref_answer is not None and verify(inst, ref_answer)[0]
+    per_factor_states = 2 * (3 * (2 ** (math.ceil(inst["n"] / 2)) - 1))
+    report["G5_density_and_baseline"] = {
+        "pass": guess_hits / 200000 < 1e-6 and ref_ok,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_total": 200000,
+        "shipping_density": guess_hits / 200000,
+        "demo_exact_valid_count": demo_count,
+        "demo_search_space": search_space(demo_inst),
+        "baseline_wall_clock_sec": round(ref_sec, 6),
+        "baseline_state_bound": per_factor_states,
+        "baseline_solved": ref_ok,
+        "baseline_name": "exact bidirectional non-backtracking 2-isogeny search",
+    }
+
+    attacks = {
+        "endpoint_coefficient_outlier": {"successes": 0, "attempts": 8},
+        "greedy_nearest_j": {"successes": 0, "attempts": 8},
+        "random_restart_32": {"successes": 0, "attempts": 8},
+        "raw_coefficient_bit_ansatz": {"successes": 0, "attempts": 8},
+        "by_hand_beam_width_4": {"successes": 0, "attempts": 8},
+    }
+    reference_successes = 0
+    reference_times = []
+    for seed in range(8):
+        attack_inst = make_instance(seed=9000 + seed, **ship_params)
+        candidates = {
+            "endpoint_coefficient_outlier": _attack_outlier(attack_inst),
+            "greedy_nearest_j": _attack_greedy(attack_inst),
+            "random_restart_32": _attack_random_restart(attack_inst, 800 + seed),
+            "raw_coefficient_bit_ansatz": _attack_raw_coefficients(attack_inst),
+            "by_hand_beam_width_4": _attack_beam(attack_inst, 4),
+        }
+        for name, candidate in candidates.items():
+            if candidate is not None and verify(attack_inst, candidate)[0]:
+                attacks[name]["successes"] += 1
+        rt = time.perf_counter()
+        found = _reference_algorithm(attack_inst)
+        reference_times.append(time.perf_counter() - rt)
+        reference_successes += int(found is not None and verify(attack_inst, found)[0])
+    all_failed = len(attacks) >= 4 and all(v["successes"] == 0 for v in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "exact bidirectional non-backtracking elliptic 2-isogeny search, factorwise",
+            "complexity": "O(2^(n/2)) time and space for fixed length n",
+            "wall_clock_sec_mean": round(sum(reference_times) / len(reference_times), 6),
+            "wall_clock_sec_max": round(max(reference_times), 6),
+            "operations": per_factor_states,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    doubled = make_instance(n=2 * DIFFICULTY["demo"]["n"], p=8191, seed=22)
+    report["G7_scales"] = {
+        "pass": verify(doubled, doubled["answer"])[0]
+        and search_space(doubled) > search_space(demo_inst),
+        "small_n": demo_inst["n"],
+        "doubled_n": doubled["n"],
+        "small_space": search_space(demo_inst),
+        "doubled_space": search_space(doubled),
+    }
+
+    invariant = 0
+    carried = 0
+    keys = []
+    for seed in range(20):
+        x = make_instance(seed=12000 + seed, **DIFFICULTY["demo"])
+        keys.append(canonical_key(x))
+        y = json.loads(json.dumps(x))
+        y["target_primary"].reverse()
+        y["target_alternate"].reverse()
+        carried_answer = [[b, a] for a, b in x["answer"]]
+        invariant += int(canonical_key(x) == canonical_key(y))
+        carried += int(verify(y, carried_answer)[0])
+    distinct = len(set(keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant == 20 and carried == 20 and distinct == 20,
+        "invariance_checks": invariant,
+        "real_transformation_checks": carried,
+        "distinct_unrelated_keys": distinct,
+        "unrelated_instances": 20,
+        "symmetry_tested": "swap the two elliptic factors, carrying the witness columns",
+    }
+
+    compact = _side_channel_decode(inst)
+    compact_ok = compact is not None and verify(inst, compact)[0]
+    answer_blob = json.dumps(planted, separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(planted)
+    intended_ops = inst["n"] + 6
+    report["G9_no_tool_suitability"] = {
+        "pass": compact_ok and answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300,
+        "arms": {
+            "bare": {"solved": 0, "attempts": 0},
+            "hinted": {"solved": 0, "attempts": 0},
+            "placebo": {"solved": 0, "attempts": 0},
+        },
+        "hinted_minus_placebo": 0.0,
+        "hinted_verdict": "not yet measured",
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "compact_route_verifies": compact_ok,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+    PROBLEM_PROFILE["max_answer_tokens"] = answer_tokens
+    report["all_passed"] = all(
+        isinstance(v, dict) and v.get("pass")
+        for k, v in report.items()
+        if k.startswith("G") and k[1:2].isdigit()
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

