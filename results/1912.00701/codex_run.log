+"""Verified generator inspired by arXiv:1912.00701.
+
+The instances are product (2,2)-isogeny path problems.  Each factor starts at
+the supersingular curve y^2=x^3+x over F_(p^2), p == 3 (mod 4).  A witness is
+the pair of kernel choices at every step.  The planted witness is sampled
+before the endpoint is constructed.
+
+Only the Python standard library is required.  The repository gvlib package
+does not currently provide finite-field or isogeny arithmetic, so this module
+implements the small exact layer it needs.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+from concurrent.futures import ProcessPoolExecutor
+
+
+TRACK = "B"
+SHIPPING_DIFFICULTY = "easy"
+
+PROBLEM_PROFILE = {
+    "native_domain": "number_theory",
+    "object_regime": "finite_field",
+    "computational_core": "other",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "supersingular elliptic curves over F_(p^2)",
+        "product principally polarized abelian surface",
+        "kernels of product (2,2)-isogenies",
+    ],
+    "verification_operations": [
+        "exact quadratic-extension finite-field arithmetic",
+        "exact Velu 2-isogeny composition",
+        "exact j-invariant comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "A common coordinate scaling between redundant target curve models "
+        "encodes the paired kernel choices; without noticing it, one must "
+        "search two non-backtracking elliptic 2-isogeny trees."
+    ),
+    "hardness_basis": (
+        "Track B: Section 2's fixed-length elliptic isogeny search, applied "
+        "factorwise through Lemma 1, has a bidirectional complexity "
+        "O(2^(n/2)); at the shipping preset the bundled exact "
+        "meet-in-the-middle reference search is measured by selftest, while "
+        "the coordinate-scale decoder uses fewer than 40 field/integer operations."
+    ),
+    "max_answer_tokens": 40,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
