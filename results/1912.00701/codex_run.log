+def _endpoint_low_bits(inst: dict) -> tuple[str, int]:
+    values = [
+        *inst["source_j"],
+        *inst["target_j"],
+        *inst["source_forbidden_root"],
+    ]
+    word = "".join(str(values[i % len(values)] & 1) for i in range(inst["walk_length"]))
+    return word, len(word)
