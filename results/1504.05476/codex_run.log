   269	    outgoing_start = _boundary_index(n, group, 0)
   270	    outgoing_end = outgoing_start + n - 1
   271	    omitted = outgoing_start + residue
   272	    if outgoing_start <= point_index <= outgoing_end and point_index != omitted:
   273	        return True
   274	
   275	    _, predecessor = _cycle_links(k)
   276	    previous = predecessor[group]
   277	    incoming = _boundary_index(
   278	        n, previous, inst["maps"][previous][residue]
   279	    )
   280	    if point_index == incoming:
   281	        return True
   282	
   283	    # Find the neighboring included parabola vertices without materializing
   284	    # the n-1 consecutive outgoing vertices.
