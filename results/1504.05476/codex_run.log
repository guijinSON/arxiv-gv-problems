   469	def verify(inst, answer):
   470	    """Check any proposed polygon cover, never consulting inst['answer']."""
   471	    k = inst["k"]
   472	    n = inst["n"]
   473	    if not isinstance(answer, list):
   474	        return False, "answer must be a list of polygon identifiers"
   475	    if not answer:
   476	        return False, "answer is empty"
   477	    if len(answer) != k:
   478	        return False, f"expected exactly k={k} polygons"
   479	    for pair in answer:
   480	        if not (
   481	            isinstance(pair, list)
   482	            and len(pair) == 2
   483	            and _is_int(pair[0])
   484	            and _is_int(pair[1])
   485	        ):
   486	            return False, "each polygon identifier must have form [i,x]"
   487	    if len({tuple(pair) for pair in answer}) != k:
   488	        return False, "duplicate polygon identifier"
   489	    for group, residue in answer:
   490	        if not 0 <= group < k:
   491	            return False, "polygon group out of range"
   492	        if not 0 <= residue < n:
   493	            return False, "polygon label out of range"
   494	    chosen = {}
   495	    for group, residue in answer:
   496	        if group in chosen:
   497	            return False, "two polygons were selected from one group"
   498	        chosen[group] = residue
   499	    if len(chosen) != k:
   500	        return False, "a polygon group is missing"
   501	
   502	    # G_i forces one selected polygon per group.  C(i,x_i) covers every
   503	    # outgoing B_i,z except B_i,x_i.  Check that the next selected polygon
   504	    # geometrically contains precisely this remaining client.
   505	    successor, _ = _cycle_links(k)
   506	    for i in range(k):
   507	        missing = _boundary_index(n, i, chosen[i])
   508	        next_group = successor[i]
   509	        if not _polygon_covers_index(
   510	            inst, next_group, chosen[next_group], missing
   511	        ):
   512	            return False, f"boundary {i} client B_{i},{chosen[i]} is uncovered"
   513	    return True, "ok"
