   450	def parse_answer(text):
   451	    if not isinstance(text, str):
   452	        return None
   453	    matches = list(_ANSWER_RE.finditer(text))
   454	    if not matches:
   455	        return None
   456	    body = matches[-1].group(1).strip()
   457	    if not body:
   458	        return []
   459	    pieces = body.split(",")
   460	    answer = []
   461	    for piece in pieces:
   462	        match = _PAIR_RE.fullmatch(piece.strip())
   463	        if match is None:
   464	            return None
   465	        answer.append([int(match.group(1)), int(match.group(2))])
   466	    return answer
