   706	def _compose_coordinate_map(first, second):
   707	    """Return second(first(point)) for two six-integer affine maps."""
   708	    a, b, c, d, tx, ty = first
   709	    e, f, g, h, ux, uy = second
   710	    return [
   711	        e * a + f * c,
   712	        e * b + f * d,
   713	        g * a + h * c,
   714	        g * b + h * d,
   715	        e * tx + f * ty + ux,
   716	        g * tx + h * ty + uy,
   717	    ]
