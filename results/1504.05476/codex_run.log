   315	
   316	    # Sample the answer before any map is constructed.  Excluding the three
   317	    # elementary ansatzes only keeps the adversary checks deterministic; it
   318	    # does not solve or search the resulting instance.
   319	    while True:
   320	        selected = [rng.randrange(n) for _ in range(k)]
   321	        if selected[0] == 0:
   322	            continue
   323	        if len(set(selected)) == 1:
   324	            continue
   325	        if all(selected[i] == i % n for i in range(k)):
   326	            continue
   327	        break
   328	
   329	    cycles = _cycles(k)
   330	    successor, _ = _cycle_links(k)
   331	    slopes = [rng.randrange(1, n) for _ in range(k)]
   332	    for cycle in cycles:
   333	        product = math.prod(slopes[i] for i in cycle) % n
   334	        if product == 1:
   335	            last = cycle[-1]
   336	            others = math.prod(slopes[i] for i in cycle[:-1]) % n
   337	            forbidden = pow(others, n - 2, n)
   338	            choices = [value for value in range(1, n) if value != forbidden]
   339	            slopes[last] = choices[rng.randrange(len(choices))]
   340	
   341	    maps = []
   342	    for i, slope in enumerate(slopes):
   343	        nxt = selected[successor[i]]
   344	        intercept = (selected[i] - slope * nxt) % n
   345	        maps.append([(slope * value + intercept) % n for value in range(n)])
