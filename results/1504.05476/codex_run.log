import gen_1504_05476 as g

def full_contains(inst, group, residue, point_index):
    idx=g._polygon_vertex_indices(inst,group,residue)
    poly=[g._point(inst,j) for j in idx]+[g._point(inst,-1)]
    q=g._point(inst,point_index)
    signs=[]
    for a,b in zip(poly,poly[1:]+poly[:1]):
        c=g._cross(a,b,q)
        if c: signs.append(1 if c>0 else -1)
    return not signs or min(signs)==max(signs)

checks=0
for n,k,seeds in [(9,3,range(20)),(27,6,range(5))]:
  for seed in seeds:
    inst=g.make_instance(n=n,k=k,seed=seed)
    for group in range(k):
      for residue in range(n):
        for j in range(inst['last_point']+1):
          fast=g._polygon_covers_index(inst,group,residue,j)
          full=full_contains(inst,group,residue,j)
          checks+=1
          if fast"'!=full:
            raise SystemExit((n,k,seed,group,residue,j,fast,full))
print('"'exact_geometry_agreements',checks)
