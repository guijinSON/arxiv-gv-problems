+def _polygon_vertex_indices(inst, group, residue):
+    """Parabola-vertex indices of C(group,residue), in increasing order."""
+    n = inst["n"]
+    k = inst["k"]
+    previous = (group - 1) % k
+    incoming_residue = inst["maps"][previous][residue]
