            and _is_int(pair[0])
            and _is_int(pair[1])
        ):
            return False, "each polygon identifier must have form [i,x]"
    if len({tuple(pair) for pair in answer}) != k:
        return False, "duplicate polygon identifier"
    for group, residue in answer:
