diff --git a/gen_1504_05476.py b/gen_1504_05476.py
new file mode 100644
index 0000000000000000000000000000000000000000..740376cb193e8edd461f79635f5b80786db861dc
--- /dev/null
+++ b/gen_1504_05476.py
@@ -0,0 +1,871 @@
+"""Verified generator for covering parabola points by convex polygons.
+
+The construction is the one used in Section 6.1 and Theorem 1.8 of
+arXiv:1504.05476: points on a parabola are in convex position, so the convex
+polygon through any chosen subset covers exactly that subset of parabola
+points.  Here those subsets form a cyclic covering instance.
+
+For boundary i, polygon C(i, x) omits one outgoing point B(i, x), while
+polygon C(i+1, y) contains one incoming point B(i, g_i(y)).  Thus a cover
+choosing one polygon from every group exists exactly when
+    x_i = g_i(x_{i+1})  (indices cyclic).
+The g_i are affine permutations of a prime field.  The answer is sampled
+first and the affine maps are built around it; generation never solves the
+emitted covering instance.
+"""
+
+from __future__ import annotations
+
+import bisect
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "geometry",
+    "object_regime": "rational_exact",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "integer-coordinate points on a parabola",
+        "closed convex polygons specified by exact parabola vertices",
+    ],
+    "verification_operations": [
+        "exact integer orientation",
+        "exact convex-polygon point containment",
+        "cardinality and range checks",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Recognize that the one-incoming/one-omitted boundary incidences are "
+        "affine permutations modulo n; otherwise one must propagate every "
+        "possible starting polygon around the cycle."
+    ),
+    "hardness_basis": (
+        "Track B: Section 6.1 and Theorem 1.8 encode covering incidences by "
+        "convex polygons on a parabola; the distribution-specific reference "
+        "algorithm builds inverse boundary tables and propagates all n starts "
+        "in O(kn) time, using 32,346 indexed operations (36,324 worst case) "
+        "and about 0.002 seconds on the measured shipping instance n=1009,k=18, "
+        "while the affine change of "
+        "variables takes at most 154 exact arithmetic operations but is not "
