import random, time

def pattern(k,rng):
 m=k//2
 for trial in range(1000):
  es=[]; used=set()
  for c in range(3):
   p=list(range(m)); rng.shuffle(p)
   if any((a,p[a]) in used for a in range(m)): break
   es += [(a,m+p[a],c) for a in range(m)]
   used.update((a,p[a]) for a in range(m))
  else:
   adj=[set() for _ in range(k)]
   for a,b,c in es: adj[a].add(b);adj[b].add(a)
   seen={0}; st=[0]
   while st:
    for v in adj[st.pop()]:
     if v not in seen: seen.add(v);st.append(v)
   if len(seen)==k:return es
 raise Exception

def rel(n,d,sa,sb,rng):
 used=set(); out=[]
 for q in range(d):
  for z in range(1000):
   p=list(range(n));rng.shuffle(p)
   if q==0:
    j=p.index(sb);p[sa],p[j]=p[j],p[sa]
   if ok=all((a,p[a]) not in used for a in range(n))
   if ok: break
  else: raise Exception
  used.update((a,p[a]) for a in range(n)); out.extend((a,p[a]) for a in range(n))
 return set(out)

def inst(n,k,d,seed):
 rng=random.Random(seed); es=pattern(k,rng); s=[rng.randrange(n) for _ in range(k)]
 rs=[]
 for a,b,c in es: rs.append(rel(n,d,s[a],s[b],rng))
 return es,rs,s

def ac3(k,n,es,rs,domains,queue=None):
 nbr=[[] for _ in range(k)]
 for ei,(a,b,c) in enumerate(es):nbr[a].append((b,ei,0));nbr[b].append((a,ei,1))
 q=list(queue) if queue is not None else [(x,y,ei,side) for x in range(k) for y,ei,side in nbr[x]]
 while q:
  x,y,ei,side=q.pop()
  R=rs[ei]
  if side==0: nd={u for u in domains[x] if any((u,v) in R for v in domains[y])}
  else: nd={u for u in domains[x] if any((v,u) in R for v in domains[y])}
  if nd "'!= domains[x]:
   if not nd:return False
   domains[x]=nd
   for z,ej,sj in nbr[x]:
    if z!=y:q.append((z,x,ej,sj))
 return True

def solve(k,n,es,rs,cap):
 nodes=0
 dom=[set(range(n)) for _ in range(k)]
 if not ac3(k,n,es,rs,dom):return None,nodes
 def dfs(D):
  nonlocal nodes
  if nodes>=cap:return None
  nodes+=1
  if all(len(x)==1 for x in D):return [next(iter(x)) for x in D]
  x=min((i for i in range(k) if len(D[i])>1),key=lambda i:len(D[i]))
  # least constraining-ish deterministic
  for v in sorted(D[x]):
   if nodes>=cap:return None
   E=[set(z) for z in D];E[x]={v}
   if ac3(k,n,es,rs,E):
    q=dfs(E)
    if q is not None:return q
  return None
 return dfs(dom),nodes

for n,k,d in [(32,12,3),(64,12,4),(64,16,4),(96,16,5),(125,16,5),(128,20,5)]:
 vals=[];success=0;t0=time.perf_counter()
 for seed in range(8):
  es,rs,s=inst(n,k,d,seed)
  sol,nodes=solve(k,n,es,rs,50000)
  vals.append(nodes);success+=sol is not None
 print((n,k,d),'"'success',success,'nodes',vals,'sec',round(time.perf_counter()-t0,3))
