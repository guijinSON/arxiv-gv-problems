import random,time,math

def make(n,k,p,seed):
 r=random.Random(seed); s=[r.randrange(n) for _ in range(2*k)]; R=[]
 for i in range(k):
  for j in range(k):
   rows=[]
   for a in range(n):
    bits=0
    for b in range(n):
     if r.random()<p or (a==s[i] and b==s[k+j]):bits|=1<<b
    rows.append(bits)
   R.append(rows)
 return s,R

def solve(n,k,R,cap):
 full=(1<<n)-1;nodes=checks=0
 def vals(mask):
  while mask:
   b=mask&-mask;yield b.bit_length()-1;mask-=b
 def propagate(D):
  nonlocal checks
  changed=True
  while changed:
   changed=False
   for i in range(k):
    for j in range(k):
     z=i*k+j; rows=R[z]
     ai=D[i];bj=D[k+j]; na=0;nb=0
     for a in vals(ai):
      checks+=1
      support=rows[a]&bj
      if support: na|=1<<a;nb|=support
     if not na:return False
     # revise B must have support from A (nb exact union)
     nb &= bj
     if not nb:return False
     if na"'!=ai:D[i]=na;changed=True
     if nb!=bj:D[k+j]=nb;changed=True
  return True
 D=[full]*(2*k);propagate(D)
 def dfs(D):
  nonlocal nodes
  if nodes>=cap:return False
  nodes+=1
  if all(x&(x-1)==0 for x in D):return True
  v=min((i for i,x in enumerate(D)if x&(x-1)),key=lambda i:D[i].bit_count())
  for a in vals(D[v]):
   E=D.copy();E[v]=1<<a
   if propagate(E)and dfs(E):return True
   if nodes>=cap:return False
  return False
 ok=dfs(D);return ok,nodes,checks
for n,k in [(12,8),(16,10),(24,12),(32,12),(32,14),(48,16)]:
 p=n**(-2/k)
 allv=[];ss=0;t=time.perf_counter()
 for seed in range(8):
  s,R=make(n,k,p,seed);ok,no,ch=solve(n,k,R,100000);ss+=ok;allv.append((no,ch))
 print('"'n,k,p',n,k,round(p,3),'success',ss,'stats',allv,'sec',round(time.perf_counter()-t,2))
