+        "n": n,
+        "k": k,
+        "last_point": last,
+        "maps": maps,
+        "affine_transform": affine,
+        "map_declaration_order": map_order,
+        "answer": [[i, selected[i]] for i in range(k)],
+    }
+
+
+def _format_table(values, width=28):
+    lines = []
+    for start in range(0, len(values), width):
+        lines.append(" ".join(str(x) for x in values[start:start + width]))
+    return "\n      ".join(lines)
+
+
+def render(inst) -> str:
+    n = inst["n"]
+    k = inst["k"]
+    last = inst["last_point"]
+    a, b, c, d, tx, ty = inst["affine_transform"]
