    for _name, _res in atk.items():
        _s = _res.get("successes") if isinstance(_res, dict) else None
        _a = _res.get("attempts") if isinstance(_res, dict) else None
        if isinstance(_s, (int, float)) and _s > 0:
            _wins.append(f"{_name} {_s}/{_a}")
