   681	def _attack_random_propagated_starts(inst, rng, restarts=8):
   682	    """Try random starts while enforcing every locally forced boundary choice.
   683	
   684	    This is the structure-aware random-restart attack: unlike independent full
   685	    tuples, every attempted candidate already satisfies the k-1 propagation
   686	    equations that become free once a starting residue is chosen.
   687	    """
   688	    last_candidate = None
   689	    for _ in range(restarts):
   690	        starts = [rng.randrange(inst["n"]) for _ in inst["cycles"]]
   691	        values = _propagate_cycle_starts(inst, starts)
   692	        last_candidate = [[i, values[i]] for i in range(inst["k"])]
   693	        if verify(inst, last_candidate)[0]:
   694	            return last_candidate
   695	    return last_candidate
