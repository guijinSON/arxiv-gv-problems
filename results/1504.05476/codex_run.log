   542	def canonical_key(inst):
   543	    """Hash canonical labelled incidence data, never seed or rendering.
   544	
   545	    The table index i and residue input are intrinsic polygon/client labels in
   546	    the formula.  Declaration order and every global invertible affine change
   547	    of coordinates are normalized away because neither changes containment.
   548	    """
