   254	def _polygon_covers_index(inst, group, residue, point_index):
   255	    """Exact containment for a generated client in a generated polygon.
   256	
   257	    Included parabola points are polygon vertices.  For an omitted point, its
   258	    adjacent included parabola vertices form a lower-hull edge and the apex is
   259	    strictly on the other side of that edge.  The exact orientation comparison
   260	    is an executable separation certificate, including after any invertible
   261	    affine transformation.
   262	    """
