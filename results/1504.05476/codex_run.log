   550	        "n": inst["n"],
   551	        "k": inst["k"],
   552	        "cycles": inst["cycles"],
   553	        "maps": inst["maps"],
   554	    }
   555	    raw = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
   556	    return hashlib.sha256(raw).hexdigest()
