   601	def _egcd_inverse_counted(value, modulus):
   602	    old_r, r = value, modulus
   603	    old_s, s = 1, 0
   604	    operations = 0
   605	    while r:
   606	        quotient = old_r // r
   607	        old_r, r = r, old_r - quotient * r
   608	        old_s, s = s, old_s - quotient * s
   609	        operations += 5  # division, two multiplications, two subtractions
   610	    if old_r != 1:
   611	        raise ValueError("value has no inverse")
   612	    return old_s % modulus, operations
   613	
   614	
   615	def _compact_solve(inst):
   616	    """Affine change-of-variables route and an exact operation count."""
   617	    n = inst["n"]
   618	    k = inst["k"]
   619	    coefficients = []
   620	    operations = 0
   621	    for table in inst["maps"]:
   622	        coefficients.append(((table[1] - table[0]) % n, table[0]))
   623	        operations += 1
   624	
   625	    values = [None] * k
   626	    for cycle in inst["cycles"]:
   627	        # Compose the boundary maps around this cycle: H(x)=A*x+B.
   628	        A, B = 1, 0
   629	        for edge in reversed(cycle):
   630	            slope, intercept = coefficients[edge]
   631	            A, B = slope * A % n, (slope * B + intercept) % n
   632	            operations += 3
   633	        denominator = (1 - A) % n
   634	        operations += 1
   635	        inverse, inverse_operations = _egcd_inverse_counted(denominator, n)
   636	        operations += inverse_operations
   637	        start = B * inverse % n
   638	        operations += 1
   639	
   640	        values[cycle[0]] = start
   641	        current = start
   642	        for edge in reversed(cycle[1:]):
   643	            slope, intercept = coefficients[edge]
   644	            current = (slope * current + intercept) % n
   645	            values[edge] = current
   646	            operations += 2
   647	    return [[i, values[i]] for i in range(k)], operations
   648	
