+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=20260421, **shipping)
+    planted = [pair[:] for pair in inst["answer"]]
+    corruptions = {}
+    tests = {
+        "drop_one": planted[:-1],
+        "swap_one_value": [
+            pair[:] if pair[0] else [0, (pair[1] + 1) % inst["n"]]
+            for pair in planted
