+PLACEBO_HINT = (
+    "Across each boundary, the polygon and parabola indices use zero-based "
+    "residues modulo n and should be copied exactly."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "Exactly k distinct polygon identifiers i:x, one for every group "
+        "i=0,...,k-1, with residue x in 0,...,n-1; order is irrelevant."
+    ),
+    "bounds": {
+        "pairs": "k",
+        "group_min": 0,
