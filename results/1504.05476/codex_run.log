import random
import gen_1504_05476 as g

def hull(points):
    pts=sorted(set(map(tuple,points)))
    def cross(o,a,b):return (a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0])
    lo=[]
    for p in pts:
        while len(lo)>=2 and cross(lo[-2],lo[-1],p)<=0:lo.pop()
        lo.append(p)
    hi=[]
    for p in reversed(pts):
        while len(hi)>=2 and cross(hi[-2],hi[-1],p)<=0:hi.pop()
        hi.append(p)
    return lo[:-1]+hi[:-1]

def inside(poly,q):
    sign=0
    for a,b in zip(poly,poly[1:]+poly[:1]):
        c=(b[0]-a[0])*(q[1]-a[1])-(b[1]-a[1])*(q[0]-a[0])
        if c:
            s=1 if c>0 else -1
            if sign and s"'!=sign:return False
            sign=s
    return True

checks=0
for seed in range(50):
    inst=g.make_instance(n=5,k=3,seed=seed)
    for i in range(inst['"'k']):
        for x in range(inst['n']):
            pts=[g._point(inst,-1)]+[g._point(inst,z) for z in g._polygon_vertex_indices(inst,i,x)]
            poly=hull(pts)
            for qidx in range(inst['last_point']+1):
                fast=g._polygon_covers_index(inst,i,x,qidx)
                full=inside(poly,g._point(inst,qidx))
                if fast"'!=full:raise AssertionError((seed,i,x,qidx,fast,full))
                checks+=1
print({'"'full_hull_containment_checks':checks,'mismatches':0})
