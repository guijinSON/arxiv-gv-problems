   576	def _reference_solve(inst):
   577	    """O(kn) orbit propagation; intentionally never called by generation."""
   578	    n = inst["n"]
   579	    k = inst["k"]
   580	    inverses = inst["inverse_maps"]
   581	    operations = k * n
   582	    values = [None] * k
   583	    for cycle in inst["cycles"]:
   584	        found = False
   585	        for start in range(n):
   586	            current = start
   587	            values[cycle[0]] = start
   588	            for edge in cycle[:-1]:
   589	                current = inverses[edge][current]
   590	                values[_cycle_links(k)[0][edge]] = current
   591	                operations += 1
   592	            operations += 1
   593	            if current == inst["maps"][cycle[-1]][start]:
   594	                found = True
   595	                break
   596	        if not found:
   597	            return None, operations
   598	    return [[i, values[i]] for i in range(k)], operations
