   656	def _attack_greedy_start_zero(inst):
   657	    # Greedy covers the sole point left by the previous group, but its initial
   658	    # tie is unresolved.  Taking zero propagates consistently until closure.
   659	    values = _propagate_cycle_starts(inst, [0] * len(inst["cycles"]))
   660	    return [[i, values[i]] for i in range(inst["k"])]
