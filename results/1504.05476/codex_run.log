   650	def _attack_outlier_equal_size(inst):
   651	    # Every polygon has exactly n+4 parabola vertices plus the apex, so the
   652	    # usual smallest/largest-object outlier rule ties at residue zero.
   653	    return [[i, 0] for i in range(inst["k"])]
