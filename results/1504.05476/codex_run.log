+    "native_domain": "geometry",
+    "object_regime": "rational_exact",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "integer-coordinate points on a parabola",
+        "closed convex polygons specified by exact parabola vertices",
+    ],
+    "verification_operations": [
+        "exact integer orientation",
+        "exact convex-polygon point containment",
+        "cardinality and range checks",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Recognize that the one-incoming/one-omitted boundary incidences are "
+        "affine permutations modulo n; otherwise one must propagate every "
+        "possible starting polygon around the cycle."
+    ),
+    "hardness_basis": (
+        "Track B: Section 6.1 and Theorem 1.8 encode covering incidences by "
+        "convex polygons on a parabola; the distribution-specific reference "
+        "algorithm builds inverse boundary tables and propagates all n starts "
+        "in O(kn) time, using 36,324 indexed operations and about 0.002 seconds "
+        "at the shipping preset n=1009,k=18, while the affine change of "
+        "variables takes at most 154 exact arithmetic operations but is not "
+        "mechanically executable from 18,162 displayed table entries without "
