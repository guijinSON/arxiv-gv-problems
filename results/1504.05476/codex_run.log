   290	    if outgoing_start <= below <= outgoing_end:
   291	        candidates.append(below)
   292	    above = max(outgoing_start, point_index + 1)
   293	    if above == omitted:
   294	        above += 1
   295	    if outgoing_start <= above <= outgoing_end:
