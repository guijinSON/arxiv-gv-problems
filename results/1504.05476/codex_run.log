   667	def _propagate_cycle_starts(inst, starts):
   668	    """Enforce every cycle equation except the three closing equations."""
   669	    inverses = inst["inverse_maps"]
   670	    successor, _ = _cycle_links(inst["k"])
   671	    values = [None] * inst["k"]
   672	    for cycle, start in zip(inst["cycles"], starts):
   673	        current = start
   674	        values[cycle[0]] = current
   675	        for edge in cycle[:-1]:
   676	            current = inverses[edge][current]
   677	            values[successor[edge]] = current
   678	    return values
