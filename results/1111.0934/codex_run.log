+    for seed in range(8):
+        trial = make_instance(
+            seed=50_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        for name, candidate in _attack_answers(trial).items():
+            attack_stats[name]["attempts"] += 1
+            attack_stats[name]["successes"] += int(verify(trial, candidate)[0])
