+                 and parse_answer("unrelated prose") is None),
+        "prose_fence_tags_round_trip": parse_answer(wrapped) == answer,
+        "garbage_returns_none": parse_answer("unrelated prose") is None,
+    }
+
+    sample_total = 200_000
