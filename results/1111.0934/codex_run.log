+
+    attack_stats = {
+        "outlier_smallest_half": {"successes": 0, "attempts": 0},
+        "greedy_lpt_balance": {"successes": 0, "attempts": 0},
+        "sorted_alternating": {"successes": 0, "attempts": 0},
+        "extreme_pairing_ansatz": {"successes": 0, "attempts": 0},
+        "random_restart_256": {
