+    corruptions = {
+        "empty": [],
+        "drop_one": answer[:-1],
+        "duplicate_one": answer + [answer[-1]],
+        "out_of_range": [2] + answer[1:],
+        "swap_two_labels": swapped,
+    }
+    rejection_reasons = {}
+    for name, candidate in corruptions.items():
