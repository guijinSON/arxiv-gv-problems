+        # only the intended n/4 disjoint identities makes the reference cost and
+        # the compact explanation reproducible across seeds.
+        if len(collisions) != group_count:
+            continue
+        covered = set()
+        for left, right in collisions:
+            covered.update(left)
+            covered.update(right)
+        if len(covered) != n:
+            continue
