+    }
+
+    answer_json = json.dumps(answer, separators=(",", ":"))
+    wrapped = (
+        "I balanced the hidden groups before checking both loads.\n```json\n"
+        f"<answer>{answer_json}</answer>\n```\nThe loads agree exactly."
+    )
