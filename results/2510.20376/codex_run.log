import itertools, random, statistics, time

def build(seed,d=14):
    n=1<<d
    rng=random.Random(seed)
    tail=list(itertools.combinations(range(2,d),3))[seed % len(list(itertools.combinations(range(2,d),3)))]
    a_bits={0,*tail}
    s_mask=sum(1<<i for i in range(d) if i not in a_bits)
    gap=n-2-s_mask
    delta=2*rng.randrange(gap//2+1)
    s=[]; sub=s_mask
    while True:
        s.append(1+sub+delta)
        if sub==0: break
        sub=(sub-1)&s_mask
    rng.shuffle(s)
    return n,s

def exact_cover(n,s,limit=100000):
    full=(1<<n)-1
    base=sum(1<<x for x in s)
    cache={}
    nodes=tests=0
    def mask(c):
        if c not in cache:
            cache[c]=(((base>>c)|(base<<(n-c)))&full) if c else base
        return cache[c]
    def dfs(covered):
        nonlocal nodes,tests
        nodes+=1
        if nodes>limit: return False
        if covered==full: return True
        remaining=full"'^covered
        v=(remaining&-remaining).bit_length()-1
        for x in s:
            tests+=1
            c=(x-v)%n
            m=mask(c)
            if not (m&covered) and dfs(covered|m): return True
        return False
    t=time.perf_counter(); ok=dfs(0); elapsed=time.perf_counter()-t
    return ok,nodes,tests,len(cache),elapsed
rows=[]
for seed in range(8):
    row=exact_cover(*build(seed)); rows.append(row)
    print(seed,*row)
print('"'median_seconds',statistics.median(x[4] for x in rows))
print('median_tests',statistics.median(x[2] for x in rows))
print('max_tests',max(x[2] for x in rows))
