def build(d,seed):
 n=1<<d; rng=random.Random(seed)
 Aidx={0,d-1}
 Aidx.update(rng.sample(range(1,d-1),2))
 Sidx=[i for i in range(d) if i not in Aidx]
 A=[0]
 for i in sorted(Aidx): A += [x+(1<<i) for x in A]
 S=[0]
 for i in Sidx: S += [x+(1<<i) for x in S]
 u=rng.randrange(1,n,2); alpha=rng.randrange(n); beta=rng.randrange(1,n,2)
 A2=[(u*x+alpha)%n for x in A]
 S2=sorted((u*x+beta)%n for x in S)
 C=sorted((-x)%n for x in A2)
 return n,S2,C,Aidx,u

def solve(n,S,limit=1000000):
 sm=set(S); masks=[]
 for c in range(n):
  m=0
  for s in S: m |= 1<<((s-c)%n)
  masks.append(m)
 byv=[]
 for v in range(n): byv.append([(s-v)%n for s in S])
 full=(1<<n)-1; nodes=0; sol=None
 def dfs(cov,chosen):
  nonlocal nodes,sol
  nodes+=1
  if nodes>limit:return False
  if cov==full: sol=chosen[:]; return True
  rem=full"'^cov
  # test first few uncovered and select min feasible candidates
  best=None
  # all symmetric but after coverage varies; scan uncovered vertices until min low
  rr=rem
