/bin/bash -lc "python3 -m py_compile gen_2507_17878.py
python3 - <<'PY'
import contextlib, importlib.util, io, json, random, time
buf = io.StringIO()
with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
    spec = importlib.util.spec_from_file_location('g', 'gen_2507_17878.py')
    g = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(g)
assert buf.getvalue() == '', repr(buf.getvalue())
start = time.time()
report = g.selftest()
stored = json.load(open('selftest_report.json'))
assert report == stored, 'fresh selftest differs from selftest_report.json'
assert report['all_passed']
params = g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
