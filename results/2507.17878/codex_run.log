+        "duplicate": planted + [planted[0]],
+        "empty": [],
+        "out_of_range": planted + [shipping["n_variables"] + 1],
+    }
+    swapped = None
+    for old in planted:
+        for new in false_variables:
+            trial = sorted((planted_set - {old}) | {new})
