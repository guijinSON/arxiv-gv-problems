+def escalate(params):
+    """Increase both scale and exact-cover crowding while preserving nullity."""
+    current = dict(params)
+    n = int(current.get("n", 32))
+    if n >= 192:
+        return None
+    current["n"] = max(n + 1, math.ceil(1.5 * n))
+    current["degree3_pct"] = min(45, int(current.get("degree3_pct", 35)) + 3)
+    return current
