+def _directed_cycle(inst):
+    """Recover the generator's directed cycle (the shipping family invariant)."""
+    n = inst["n"]
+    cycle, _ = _cycle_nodes(n, inst["constraints"])
+    outgoing = {}
+    for edge in inst["constraints"]:
