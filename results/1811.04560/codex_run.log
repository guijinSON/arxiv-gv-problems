+        "unrelated_distinct_keys": len(set(unrelated_keys)),
+        "unrelated_instances": len(unrelated_keys),
+        "symmetries": ["arbitrary original-vertex relabelling", "base-edge reordering"],
+        "key_kind": "degree/common-neighbor profile invariant; not complete GI",
