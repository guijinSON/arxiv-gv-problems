+except ImportError:                 # pragma: no cover - no helper is needed here
+    exact_matrices = rationals = None
+
+
+TRACK = "A"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "undirected graph with original, private, and universal-independent vertex classes",
+        "Konig edge-deletion set",
+        "equal-cardinality vertex cover and matching",
+    ],
+    "verification_operations": [
+        "edge deletion",
+        "edge-set membership",
+        "vertex-cover incidence check",
+        "matching disjointness and cardinality comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 3, Claims 3.1--3.4 and Theorems 2--3: the parameter-preserving "
+        "reduction from Independent Set to Konig Edge Deletion"
+    ),
+    "reduction_source": "paper_central",
+    "intuition_type": "reduction recognition",
+    "intuition_description": (
+        "The only k-edge deletion certificates in the Section 3 construction "
+        "encode k original vertices with no base edge between them; without "
+        "recognizing that correspondence one must reason about covers and "
+        "matchings in the much larger displayed graph."
+    ),
+    "hardness_basis": (
+        "Track A: Theorem 2 is a parameter-preserving W[1]-hardness reduction "
+        "for k<n/2, instantiated here with a degree-balanced dense planted-"
+        "independent-set distribution whose complement has k below sqrt(n) (the usual spectral "
+        "recovery scale); at the shipping preset the exact bitset "
+        "branch-and-color attack exhausts its measured node cap without a "
+        "certificate on all eight audit seeds."
+    ),
+    "max_answer_tokens": 18,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON list of exactly k distinct original-vertex indices from "
+        "0 through n-1, in strictly increasing order.  Index i denotes "
+        "deletion of the private edge {V_i,P_i}."
