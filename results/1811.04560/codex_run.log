+def _oriented_affine(edge, source, target, q):
+    u, v, slope, offset = edge
+    if u == source and v == target:
+        return slope % q, offset % q
+    if u == target and v == source:
+        inv = _inv(slope, q)
+        return inv, (-inv * offset) % q
