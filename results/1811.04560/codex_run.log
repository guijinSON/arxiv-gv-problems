+        color += 1
+        available = uncolored
+        while available:
+            bit = available & -available
+            v = bit.bit_length() - 1
+            order.append(v)
+            bounds.append(color)
+            uncolored ^= bit
+            available ^= bit
+            available &= ~adjacency[v]
+    return order, bounds
