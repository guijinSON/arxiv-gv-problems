+        "entries": "distinct integers in [0,n-1]",
+        "order": "strictly increasing",
+        "shipping_max_length": 16,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 9, "k": 3, "background_num": 1, "background_den": 2},
+    "easy": {"n": 160, "k": 12, "background_num": 1, "background_den": 2},
+    "medium": {"n": 240, "k": 14, "background_num": 1, "background_den": 2},
+    "hard": {"n": 320, "k": 16, "background_num": 1, "background_den": 2},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The private-edge indices of every size-k certificate form an independent "
