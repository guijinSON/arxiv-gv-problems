+def _base_adjacency(inst: dict) -> list[int]:
+    n = inst["n"]
+    adjacency = [0] * n
+    for a, b in inst["base_edges"]:
+        adjacency[a] |= 1 << b
+        adjacency[b] |= 1 << a
+    return adjacency
+
