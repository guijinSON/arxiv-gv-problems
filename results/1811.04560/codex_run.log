+def _affine_values_relabelled(inst, rng):
+    n, q = inst["n"], inst["q"]
+    scales = [rng.randrange(1, q) for _ in range(n)]
+    shifts = [rng.randrange(q) for _ in range(n)]
+    out = {k: v for k, v in inst.items() if k not in ("answer", "constraints")}
+    changed = []
