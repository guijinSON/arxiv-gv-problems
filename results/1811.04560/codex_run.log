+        "order": "strictly increasing",
+        "shipping_max_length": 96,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "clauses": 4},
+    "easy": {"n": 12, "clauses": 72},
+    "medium": {"n": 14, "clauses": 84},
+    "hard": {"n": 16, "clauses": 96},
+}
