+    chars, tokens, elements = _answer_metrics(answer)
+    # Once the reduction is recognized, checking all pairs in the proposed I
+    # and mapping its k indices to private edges is the complete compact route.
+    intended_operations = math.comb(inst["k"], 2) + 3 * inst["k"]
+    arms = {name: dict(G9_EVIDENCE[name]) for name in ("bare", "hinted", "placebo")}
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
