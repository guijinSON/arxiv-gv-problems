+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    strongest_name, strongest = max(
+        attack_results.items(), key=lambda item: item[1]["wall_clock_sec"])
+    report["G5_density_and_baseline"] = {
+        "pass": density < 1e-6 and all_failed and demo_count is not None,
+        "shipping_density_hits": sample_hits,
+        "shipping_density_samples": sample_total,
+        "shipping_density_fraction": density,
+        "shipping_exact_solution_count": None,
+        "demo_exact_solution_count": demo_count,
+        "strongest_attack": strongest_name,
+        "baseline_wall_clock_sec": strongest["wall_clock_sec"],
+        "baseline_nodes": sum(exact_nodes),
+        "baseline_attempts": strongest["attempts"],
+    }
+
+    doubled = dict(shipping)
+    doubled["n"] = 2 * shipping["n"]
+    doubled["clauses"] = 2 * shipping["clauses"]
+    big = make_instance(seed=271828, **doubled)
+    big_ok, big_reason = verify(big, big["answer"])
+    spaces = [search_space(make_instance(seed=7, **params))
+              for name, params in DIFFICULTY.items() if name != "demo"]
+    report["G7_scales"] = {
+        "pass": big_ok and spaces == sorted(spaces)
+                and len(set(spaces)) == len(spaces)
+                and search_space(big) > search_space(inst),
