+        ) % q
+        changed.append([u, v, new_slope, new_offset])
+    out["constraints"] = changed
+    out["answer"] = [
+        (scales[i] * inst["answer"][i] + shifts[i]) % q for i in range(n)
+    ]
+    return out
 
