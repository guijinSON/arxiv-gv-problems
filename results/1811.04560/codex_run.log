+    if not _is_prime(q):
+        raise ValueError("q must be prime")
+    if q <= 3:
+        raise ValueError("q must exceed 3")
+    if not 3 <= cycle_length <= n:
+        raise ValueError("cycle_length must lie between 3 and n")
 
