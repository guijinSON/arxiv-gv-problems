+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A JSON list of exactly k distinct original-vertex indices from "
+        "0 through n-1, in strictly increasing order.  Index i denotes "
+        "deletion of the private edge {V_i,P_i}."
+    ),
+    "bounds": {
+        "length": "instance k",
+        "entries": "distinct integers in [0,n-1]",
+        "order": "strictly increasing",
+        "shipping_max_length": 96,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "clauses": 4},
