+        "drop": answer[:-1],
+        "swap": swapped,
+        "duplicate": answer + [answer[-1]],
+        "empty": [],
+        "out_of_range": [ship["q"], *answer[1:]],
+    }
+    rejected = {}
+    for name, bad in corruptions.items():
