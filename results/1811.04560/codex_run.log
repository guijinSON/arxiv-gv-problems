+def _ordered_cycle(n, constraints):
+    cycle, adjacency = _cycle_nodes(n, constraints)
+    start = min(cycle)
+    first = min(adjacency[start] & cycle)
+    order = [start, first]
+    prev, cur = start, first
+    while True:
+        choices = (adjacency[cur] & cycle) - {prev}
+        nxt = next(iter(choices))
+        if nxt == start:
+            break
+        order.append(nxt)
+        prev, cur = cur, nxt
+    return order
 
