-    }
-
-    # G8: all representation-preserving relabellings and a composition, over 20
-    # seeds.  The carried witness proves each tested map is a real symmetry.
-    invariant_passed = 0
-    transformed_verified = 0
-    keys = []
-    per_seed = 5
-    for seed in range(40, 60):
