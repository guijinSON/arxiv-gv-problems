-def _is_prime(q: int) -> bool:
-    if q < 2:
-        return False
-    if q % 2 == 0:
-        return q == 2
-    d = 3
-    while d * d <= q:
-        if q % d == 0:
-            return False
-        d += 2
-    return True
-
-
-def _inv(a: int, q: int) -> int:
-    """Multiplicative inverse modulo the prime q."""
-    a %= q
-    if not a:
-        raise ValueError("zero has no modular inverse")
-    return pow(a, q - 2, q)
-
-
-def _next_prime(x: int) -> int:
-    q = max(3, int(x) | 1)
-    while not _is_prime(q):
-        q += 2
-    return q
