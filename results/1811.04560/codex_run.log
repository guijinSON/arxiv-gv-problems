+            transformed_checks += 1
+            transformed_passed += int(verify(moved, moved["answer"])[0])
+    report["G8_canonical_key"] = {
+        "pass": invariance_passed == invariant_checks
+                and transformed_passed == transformed_checks
+                and len(set(unrelated_keys)) == len(unrelated_keys),
+        "invariance_checks_passed": invariance_passed,
+        "invariance_checks_attempted": invariant_checks,
+        "transformed_witnesses_verified": transformed_passed,
+        "transformed_witnesses_attempted": transformed_checks,
+        "unrelated_distinct_keys": len(set(unrelated_keys)),
+        "unrelated_instances": len(unrelated_keys),
