def gen(c,d,m,seed):
 rng=random.Random(seed);k=c*m;r=d*m;n=k+r;adj=[0]*n;sh=[[rng.randrange(m) for _ in range(d)] for _ in range(c)]
 for a in range(m):
  for i in range(c):
   u=c*a+i
   for t in range(d):
    v=k+d*((a+sh[i][t])%m)+(i+t)%d;adj[u]|=1<<v;adj[v]|=1<<u
 pp=list(range(k,n));rng.shuffle(pp)
 for s in rng.sample(range(r-1),d-c):
  q=r-1
  for x,y in [(r-1,s)]+[((s+z)%q,(s-z)%q) for z in range(1,r//2)]:
   u=pp[x];v=pp[y];adj[u]|=1<<v;adj[v]|=1<<u
 p=list(range(n));rng.shuffle(p);a2=[0]*n
 for x in range(n):
  z=adj[x]
  while z:
   b=z&-z;y=b.bit_length()-1;z-=b;a2[p[x]]|=1<<p[y]
 return {p[x] for x in range(k)},a2

def valid(adj,S):
 z=0
 for v in S:
  if adj[v]&z:return False
  z|=1<<v
 return True

def tri(adj,v):
 z=adj[v];s=0
 while z:
  b=z&-z;u=b.bit_length()-1;z-=b;s+=(adj[u]&adj[v]).bit_count()
 return s//2

def greedy(adj,k,rng,score=None):
 n=len(adj);A=(1<<n)-1;S=[]
 while A and len(S)<k:
  vs=[];best=10**9
  z=A
  while z:
   b=z&-z;v=b.bit_length()-1;z-=b;dv=(adj[v]&A).bit_count()
   if dv<best:best=dv;vs=[v]
   elif dv==best:vs.append(v)
  if score is None:v=rng.choice(vs)
  else:v=min(vs,key=lambda x:(score[x],rng.random()))
  S.append(v);A &= ~(adj[v]|(1<<v))
 return S

def bottom(adj,seed):
 n=len(adj);d=adj[0].bit_count();r=random.Random(seed);x=[r.uniform(-1,1) for _ in range(n)];mu=sum(x)/n;x=[z-mu for z in x]
 for _ in range(100):
  y=[]
  for v in range(n):
   s=d*x[v];z=adj[v]
   while z:
    b=z&-z;u=b.bit_length()-1;z-=b;s-=x[u]
   y.append(s)
  mu=sum(y)/n;y=[z-mu for z in y];norm=math.sqrt(sum(z*z for z in y));x=[z/norm for z in y]
 return x
for seed in range(8):
