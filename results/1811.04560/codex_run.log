+        "baseline_nodes": sum(exact_nodes),
+        "baseline_attempts": strongest["attempts"],
+    }
+
+    doubled = dict(shipping)
+    doubled["n"] = 2 * shipping["n"]
+    big = make_instance(seed=271828, **doubled)
+    big_ok, big_reason = verify(big, big["answer"])
+    spaces = [search_space(make_instance(seed=7, **params))
+              for name, params in DIFFICULTY.items() if name != "demo"]
+    report["G7_scales"] = {
+        "pass": big_ok and spaces == sorted(spaces)
+                and len(set(spaces)) == len(spaces)
+                and search_space(big) > search_space(inst),
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "doubled_verifies": big_ok,
+        "doubled_reason": big_reason,
+        "named_candidate_spaces": spaces,
+        "shipping_answer_length": len(answer),
+        "doubled_answer_length": len(big["answer"]),
+    }
+
+    invariant_checks = 0
+    transformed_checks = 0
+    invariance_passed = 0
+    transformed_passed = 0
+    unrelated_keys = []
+    for seed in range(20):
+        trial = make_instance(seed=20_000 + seed, **shipping)
+        key = canonical_key(trial)
+        unrelated_keys.append(key)
+        moved1 = _relabel_instance(trial, 30_000 + seed, reorder=True)
+        moved2 = _relabel_instance(trial, 40_000 + seed, reorder=False)
+        moved3 = _relabel_instance(moved1, 50_000 + seed, reorder=True)
+        for moved in (moved1, moved2, moved3):
+            invariant_checks += 1
