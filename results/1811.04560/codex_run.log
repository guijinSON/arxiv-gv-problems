+        "undirected graph with original, private, and universal-independent vertex classes",
+        "Konig edge-deletion set",
+        "equal-cardinality vertex cover and matching",
+    ],
+    "verification_operations": [
+        "edge deletion",
+        "edge-set membership",
+        "vertex-cover incidence check",
+        "matching disjointness and cardinality comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 3, Claims 3.1--3.4 and Theorems 2--3: the parameter-preserving "
+        "reduction from Independent Set to Konig Edge Deletion"
+    ),
+    "reduction_source": "paper_central",
+    "intuition_type": "reduction recognition",
+    "intuition_description": (
+        "The only k-edge deletion certificates in the Section 3 construction "
+        "encode k original vertices with no base edge between them; without "
+        "recognizing that correspondence one must reason about covers and "
+        "matchings in the much larger displayed graph."
