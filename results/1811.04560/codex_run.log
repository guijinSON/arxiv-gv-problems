+and consists of private edges.  Therefore report only their distinct indices:
+listing i means delete {{V_i,P_i}}.  Indices are 0-based, must lie in
+0..{inst['n'] - 1}, may not repeat, and must be in strictly increasing order.
+
+BASE EDGES ({len(inst['base_edges'])} pairs)
+{edges}
+
+Give your final answer inside <answer></answer> tags, as one JSON list of exactly
+{inst['k']} integers.
+Example of syntax only: <answer>{json.dumps(list(range(inst['k'])))}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        text += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        text += "\n\nHint: " + PLACEBO_HINT
+    return text
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the final tagged JSON list, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\s*>(.*?)</answer\s*>", text,
+                         flags=re.IGNORECASE | re.DOTALL)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json|text|python)?\s*", "", body,
+                  flags=re.IGNORECASE)
+    body = re.sub(r"\s*```$", "", body).strip()
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        # Also accept the natural comma-separated rendering inside the tags.
+        if not re.fullmatch(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*", body):
+            return None
+        try:
+            value = [int(piece.strip()) for piece in body.split(",")]
+        except ValueError:
+            return None
+    return value if isinstance(value, list) else None
+
+
+def _validated_base(inst: dict) -> tuple[bool, str, set[tuple[int, int]]]:
+    n = inst.get("n")
+    k = inst.get("k")
+    raw = inst.get("base_edges")
+    if (not isinstance(n, int) or isinstance(n, bool) or n < 1
+            or not isinstance(k, int) or isinstance(k, bool)
+            or k < 1 or k >= n / 2):
+        return False, "instance has invalid n or k", set()
+    if not isinstance(raw, list):
+        return False, "instance base-edge list is malformed", set()
+    edges: set[tuple[int, int]] = set()
+    for item in raw:
+        if (not isinstance(item, (list, tuple)) or len(item) != 2
+                or any(not isinstance(x, int) or isinstance(x, bool) for x in item)):
+            return False, "instance base-edge list is malformed", set()
+        a, b = item
+        if a < 0 or b < 0 or a >= n or b >= n or a == b:
+            return False, "instance contains an invalid base edge", set()
+        e = _edge(a, b)
+        if e in edges:
+            return False, "instance contains a repeated base edge", set()
+        edges.add(e)
+    return True, "ok", edges
+
+
+def _derived_certificate_checks(n: int, k: int,
+                                base_edges: set[tuple[int, int]],
+                                chosen: set[int]) -> tuple[bool, str]:
+    """Execute Claim 3.3's cover/matching proof on the expanded graph."""
+    # Integer vertex encoding is internal only: V_i=i, P_i=n+i,
+    # C_r=2n+r.  The checker materializes H-F rather than trusting the theorem.
+    deleted = {_edge(i, n + i) for i in chosen}
+    remaining = set(base_edges)
+    remaining.update(_edge(i, n + i) for i in range(n))
+    for r in range(2 * k):
+        c = 2 * n + r
+        remaining.update(_edge(c, i) for i in range(n))
+        remaining.update(_edge(c, n + i) for i in range(n))
+    remaining.difference_update(deleted)
+
+    cover = (set(range(n)) - chosen) | set(range(2 * n, 2 * n + 2 * k))
+    for a, b in remaining:
+        if a not in cover and b not in cover:
+            return False, "deletion leaves an edge uncovered by the Claim 3.3 cover"
+
+    ordered = sorted(chosen)
+    matching = [_edge(i, n + i) for i in range(n) if i not in chosen]
+    matching.extend(_edge(2 * n + r, ordered[r]) for r in range(k))
+    matching.extend(_edge(2 * n + k + r, n + ordered[r]) for r in range(k))
+    endpoints: set[int] = set()
+    for e in matching:
+        if e not in remaining:
+            return False, "Claim 3.3 matching uses a missing or deleted edge"
+        if e[0] in endpoints or e[1] in endpoints:
+            return False, "Claim 3.3 matching repeats an endpoint"
+        endpoints.update(e)
+    if len(matching) != len(cover):
+        return False, "matching and vertex-cover cardinalities differ"
+    if not cover <= endpoints:
+        return False, "matching does not saturate the constructed vertex cover"
+    return True, "ok"
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any allowed deletion witness without consulting inst['answer']."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer list must not be empty"
+    if len(answer) != inst.get("k"):
+        return False, f"answer must contain exactly k={inst.get('k')} indices"
+    if any(not isinstance(v, int) or isinstance(v, bool) for v in answer):
+        return False, "every deletion index must be an integer"
+    if len(set(answer)) != len(answer):
+        return False, "deletion indices must be distinct"
+    if answer != sorted(answer):
+        return False, "deletion indices must be strictly increasing"
+    n = inst.get("n")
+    if not isinstance(n, int) or any(v < 0 or v >= n for v in answer):
+        return False, "a deletion index is outside the original-vertex range"
+    valid, reason, base_edges = _validated_base(inst)
+    if not valid:
+        return False, reason
+    chosen = set(answer)
+    if any(_edge(a, b) in base_edges for a, b in itertools.combinations(answer, 2)):
+        return False, "the indexed original vertices are not independent"
+    return _derived_certificate_checks(inst["n"], inst["k"], base_edges, chosen)
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniform sample from the stated, structure-aware k-subset language."""
+    return sorted(rng.sample(range(inst["n"]), inst["k"]))
+
+
+def search_space(inst: dict) -> int:
+    return math.comb(inst["n"], inst["k"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space > 500_000:
+        return None
+    return sum(
+        int(verify(inst, list(candidate))[0])
+        for candidate in itertools.combinations(range(inst["n"]), inst["k"])
+    )
+
+
+def _base_adjacency(inst: dict) -> list[int]:
+    n = inst["n"]
+    adjacency = [0] * n
+    for a, b in inst["base_edges"]:
+        adjacency[a] |= 1 << b
+        adjacency[b] |= 1 << a
+    return adjacency
+
+
+def canonical_key(inst: dict) -> str:
+    """Strong cheap relabelling invariant of the base graph, never the seed."""
+    adjacency = _base_adjacency(inst)
+    n = len(adjacency)
+    degrees = [mask.bit_count() for mask in adjacency]
+    degree_hist = sorted(collections.Counter(degrees).items())
+    edge_common: collections.Counter[int] = collections.Counter()
+    nonedge_common: collections.Counter[int] = collections.Counter()
+    vertex_profiles = []
+    for i in range(n):
+        profile: collections.Counter[tuple[int, int, int]] = collections.Counter()
+        for j in range(n):
+            if i == j:
+                continue
+            linked = (adjacency[i] >> j) & 1
+            common = (adjacency[i] & adjacency[j]).bit_count()
+            profile[(linked, degrees[j], common)] += 1
+            if i < j:
+                (edge_common if linked else nonedge_common)[common] += 1
+        vertex_profiles.append(tuple(sorted((list(key), value)
+                                            for key, value in profile.items())))
+    payload = {
+        "n": n,
+        "k": inst["k"],
+        "degrees": degree_hist,
+        "edge_common": sorted(edge_common.items()),
+        "nonedge_common": sorted(nonedge_common.items()),
+        "vertex_profiles": sorted(vertex_profiles),
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow the ambient graph first and k only enough to suppress natural sets."""
+    nxt = dict(params)
+    n = int(nxt.get("n", 160))
+    k = int(nxt.get("k", 12))
+    if n >= 960 or k >= 20:
+        return None
+    nxt["n"] = min(960, n + max(80, n // 3))
+    nxt["k"] = min(20, k + 1)
+    # Increasing density is a second, fixed-answer-scale hardness axis: it
+    # removes accidental independent sets while the ambient haystack grows.
+    if nxt["n"] >= 600:
+        nxt["background_num"], nxt["background_den"] = 3, 5
+    return nxt
+
+
+def _candidate_from_vertices(inst: dict, vertices: list[int]) -> bool:
+    if len(vertices) < inst["k"]:
+        return False
+    return verify(inst, sorted(vertices[:inst["k"]]))[0]
+
+
+def _attack_degree_outliers(inst: dict) -> bool:
+    adjacency = _base_adjacency(inst)
+    vertices = list(range(inst["n"]))
+    degree = [mask.bit_count() for mask in adjacency]
+    median = sorted(degree)[len(degree) // 2]
+    orders = [
+        sorted(vertices, key=lambda v: (degree[v], v)),
+        sorted(vertices, key=lambda v: (-degree[v], v)),
+        sorted(vertices, key=lambda v: (abs(degree[v] - median), v)),
+    ]
+    return any(_candidate_from_vertices(inst, order) for order in orders)
+
+
+def _greedy_independent(inst: dict, rng: random.Random | None = None) -> list[int]:
+    adjacency = _base_adjacency(inst)
+    available = (1 << inst["n"]) - 1
+    chosen: list[int] = []
+    while available and len(chosen) < inst["k"]:
+        options = []
+        scan = available
+        while scan:
+            bit = scan & -scan
+            v = bit.bit_length() - 1
+            score = (adjacency[v] & available).bit_count()
+            options.append((score, v))
+            scan ^= bit
+        options.sort()
+        if rng is None:
+            v = options[0][1]
+        else:
+            width = min(8, len(options))
+            weights = list(range(width, 0, -1))
+            v = rng.choices([row[1] for row in options[:width]], weights=weights, k=1)[0]
+        chosen.append(v)
+        available &= ~(1 << v)
+        available &= ~adjacency[v]
+    return sorted(chosen)
+
+
+def _attack_greedy(inst: dict) -> bool:
+    candidate = _greedy_independent(inst)
+    return len(candidate) == inst["k"] and verify(inst, candidate)[0]
+
+
+def _attack_random_restart(inst: dict, seed: int, restarts: int = 256) -> bool:
+    rng = random.Random(seed)
+    for _ in range(restarts):
+        candidate = _greedy_independent(inst, rng)
+        if len(candidate) == inst["k"] and verify(inst, candidate)[0]:
+            return True
+    return False
+
+
+def _complement_adjacency(inst: dict) -> list[int]:
+    base = _base_adjacency(inst)
+    all_bits = (1 << inst["n"]) - 1
+    return [all_bits & ~(base[v] | (1 << v)) for v in range(inst["n"])]
+
+
+def _attack_spectral(inst: dict, seed: int) -> bool:
+    """Centered-complement power iteration plus a small top-window search."""
+    n, k = inst["n"], inst["k"]
+    complement = _complement_adjacency(inst)
+    q = 1.0 - inst["background_num"] / inst["background_den"]
+    rng = random.Random(seed)
+    x = [rng.uniform(-1.0, 1.0) for _ in range(n)]
+    mean = sum(x) / n
+    x = [v - mean for v in x]
+    for _ in range(55):
+        total = sum(x)
+        y = []
+        for i in range(n):
+            s = 0.0
+            bits = complement[i]
+            while bits:
+                bit = bits & -bits
+                s += x[bit.bit_length() - 1]
+                bits ^= bit
+            # Center off-diagonal adjacency at its background expectation.
+            s -= q * (total - x[i])
+            y.append(s)
+        mean = sum(y) / n
+        y = [v - mean for v in y]
+        norm = math.sqrt(sum(v * v for v in y))
+        if not norm:
+            break
+        x = [v / norm for v in y]
+    orders = [
+        sorted(range(n), key=lambda i: x[i], reverse=True),
+        sorted(range(n), key=lambda i: x[i]),
+        sorted(range(n), key=lambda i: abs(x[i]), reverse=True),
+    ]
+    for order in orders:
+        if _candidate_from_vertices(inst, order):
+            return True
+        window = order[:min(n, 3 * k)]
+        submask = sum(1 << v for v in window)
+        result = _exact_clique_search(complement, k, node_cap=20_000,
+                                      initial_candidates=submask)
+        if result["success"]:
+            return True
+    return False
+
+
+def _greedy_color_order(candidates: int, adjacency: list[int]) -> tuple[list[int], list[int]]:
+    """Sequential coloring upper bounds for maximum-clique branch and bound."""
+    order: list[int] = []
+    bounds: list[int] = []
+    uncolored = candidates
+    color = 0
+    while uncolored:
+        color += 1
+        available = uncolored
+        while available:
+            bit = available & -available
+            v = bit.bit_length() - 1
+            order.append(v)
+            bounds.append(color)
+            uncolored ^= bit
+            available ^= bit
+            available &= ~adjacency[v]
+    return order, bounds
+
+
+def _exact_clique_search(adjacency: list[int], target: int, node_cap: int,
+                         initial_candidates: int | None = None) -> dict:
+    """Capped MCQ-style bitset search; clique means independent set in G."""
+    n = len(adjacency)
+    root = ((1 << n) - 1 if initial_candidates is None else initial_candidates)
+    nodes = 0
+    cap_reached = False
+    found: list[int] | None = None
+
+    def expand(candidates: int, clique: list[int]) -> bool:
+        nonlocal nodes, cap_reached, found
+        if len(clique) >= target:
+            found = list(clique)
+            return True
+        if len(clique) + candidates.bit_count() < target:
+            return False
+        if nodes >= node_cap:
+            cap_reached = True
+            return False
+        order, bounds = _greedy_color_order(candidates, adjacency)
+        for index in range(len(order) - 1, -1, -1):
+            if len(clique) + bounds[index] < target:
+                return False
+            v = order[index]
+            bit = 1 << v
+            if not candidates & bit:
+                continue
+            nodes += 1
+            if nodes > node_cap:
+                cap_reached = True
+                return False
+            if expand(candidates & adjacency[v], clique + [v]):
+                return True
+            candidates &= ~bit
+        return False
+
+    success = expand(root, [])
+    return {
+        "success": success,
+        "vertices": sorted(found) if found else None,
+        "nodes": min(nodes, node_cap),
+        "node_cap": node_cap,
+        "cap_reached": cap_reached,
+    }
+
+
+def _attack_exact(inst: dict, node_cap: int = 300_000) -> dict:
+    started = time.perf_counter()
+    result = _exact_clique_search(_complement_adjacency(inst), inst["k"], node_cap)
+    result["wall_clock_sec"] = time.perf_counter() - started
+    if result["success"]:
+        result["verified"] = verify(inst, result["vertices"])[0]
+        result["success"] = bool(result["verified"])
+    else:
+        result["verified"] = False
+    return result
+
+
+def _relabel_instance(inst: dict, seed: int, reorder: bool = True) -> dict:
+    rng = random.Random(seed)
+    permutation = list(range(inst["n"]))
+    rng.shuffle(permutation)
+    edges = [_edge(permutation[a], permutation[b]) for a, b in inst["base_edges"]]
+    if reorder:
+        rng.shuffle(edges)
+    out = {key: value for key, value in inst.items()
+           if key not in ("base_edges", "answer")}
+    out["base_edges"] = [list(e) for e in edges]
+    out["answer"] = sorted(permutation[v] for v in inst["answer"])
+    return out
+
+
+def _answer_metrics(answer: object) -> tuple[int, int, int]:
+    blob = json.dumps(answer, separators=(",", ":"))
+
+    def atoms(value: object) -> int:
+        if isinstance(value, dict):
+            return sum(atoms(v) for v in value.values())
+        if isinstance(value, (list, tuple)):
+            return sum(atoms(v) for v in value)
+        return 1
+
+    return len(blob), math.ceil(len(blob) / 4), atoms(answer)
+
+
+def selftest() -> dict:
+    """Run every mandatory construction, density, attack, and symmetry gate."""
+    report: dict = {
+        "paper": "1811.04560",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    failures = []
+    attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 1811):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            json_ok = json.loads(json.dumps(inst["answer"])) == inst["answer"]
+            attempts += 1
+            if not ok or not json_ok:
+                failures.append({"preset": preset, "seed": seed,
+                                 "reason": reason, "json_native": json_ok})
+    report["G1_planted_verifies"] = {
+        "pass": not failures,
+        "verified": attempts - len(failures),
+        "attempts": attempts,
+        "failures": failures,
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=314159, **shipping)
+    answer = list(inst["answer"])
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": [answer[1], answer[0]] + answer[2:],
+        "duplicate": answer[:-1] + [answer[-2]],
+        "empty": [],
+        "out_of_range": answer[:-1] + [inst["n"]],
+    }
+    cases = {}
+    for name, bad in corruptions.items():
+        ok, reason = verify(inst, bad)
+        cases[name] = {"rejected": not ok, "reason": reason}
+    reasons = [row["reason"] for row in cases.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(row["rejected"] for row in cases.values())
+                and len(set(reasons)) == len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "cases": cases,
+    }
+
+    realistic = (
+        "I used the correspondence with independent sets.\n"
+        "<answer>```json\n" + json.dumps(answer) + "\n```</answer>\n"
+        "Those indices specify the private edges."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and verify(inst, parsed)[0]
+                and parse_answer("no tagged answer") is None,
+        "parsed_matches": parsed == answer,
+        "garbage_returns_none": parse_answer("no tagged answer") is None,
+        "json_native": json.loads(json.dumps(answer)) == answer,
+    }
+
+    # Uniform k-subsets already enforce every syntactic and cardinality promise.
+    rng = random.Random(0x181104560)
+    sample_total = 200_000
+    sample_hits = 0
+    adjacency = _base_adjacency(inst)
+    started = time.perf_counter()
+    for _ in range(sample_total):
+        candidate = random_candidate(inst, rng)
+        mask = 0
+        independent = True
+        for v in candidate:
+            if adjacency[v] & mask:
+                independent = False
+                break
+            mask |= 1 << v
+        sample_hits += int(independent)
+    density_wall = time.perf_counter() - started
+    density = sample_hits / sample_total
+    report["G4_guess_resistance"] = {
+        "pass": density < 1e-6,
+        "hits": sample_hits,
+        "total": sample_total,
+        "observed_probability": density,
+        "candidate_space": search_space(inst),
+        "prior": "uniform over strictly increasing k-subsets of original indices",
+        "sampling_wall_clock_sec": round(density_wall, 6),
+    }
+
+    attack_names = (
+        "degree_outlier_three_orders",
+        "greedy_minimum_induced_degree",
+        "random_restart_256_greedy",
+        "spectral_centered_complement",
+        "exact_bitset_branch_color_300k",
+    )
+    attack_results = {
+        name: {"successes": 0, "attempts": 8, "wall_clock_sec": 0.0}
+        for name in attack_names
+    }
+    exact_nodes = []
+    exact_caps = 0
+    for seed in range(1000, 1008):
+        trial = make_instance(seed=seed, **shipping)
+
+        started = time.perf_counter()
+        success = _attack_degree_outliers(trial)
+        attack_results["degree_outlier_three_orders"]["wall_clock_sec"] += (
+            time.perf_counter() - started)
+        attack_results["degree_outlier_three_orders"]["successes"] += int(success)
+
+        started = time.perf_counter()
+        success = _attack_greedy(trial)
+        attack_results["greedy_minimum_induced_degree"]["wall_clock_sec"] += (
+            time.perf_counter() - started)
+        attack_results["greedy_minimum_induced_degree"]["successes"] += int(success)
+
+        started = time.perf_counter()
+        success = _attack_random_restart(trial, seed ^ 0x5EED, 256)
+        attack_results["random_restart_256_greedy"]["wall_clock_sec"] += (
+            time.perf_counter() - started)
+        attack_results["random_restart_256_greedy"]["successes"] += int(success)
+
+        started = time.perf_counter()
+        success = _attack_spectral(trial, seed ^ 0x51EC7)
+        attack_results["spectral_centered_complement"]["wall_clock_sec"] += (
+            time.perf_counter() - started)
+        attack_results["spectral_centered_complement"]["successes"] += int(success)
+
+        exact = _attack_exact(trial, 300_000)
+        attack_results["exact_bitset_branch_color_300k"]["wall_clock_sec"] += (
+            exact["wall_clock_sec"])
+        attack_results["exact_bitset_branch_color_300k"]["successes"] += int(exact["success"])
+        exact_nodes.append(exact["nodes"])
+        exact_caps += int(exact["cap_reached"])
+
+    for row in attack_results.values():
+        row["wall_clock_sec"] = round(row["wall_clock_sec"], 6)
+    all_failed = all(row["successes"] == 0 for row in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed,
+        "attacks": attack_results,
+        "standard_attack_cost": {
+            "name": "maximum clique in the complement by bitset branch-and-color",
+            "complexity": "exponential worst case",
+            "node_cap_per_instance": 300_000,
+            "nodes_total": sum(exact_nodes),
+            "nodes_mean": sum(exact_nodes) / len(exact_nodes),
+            "caps_reached": exact_caps,
+        },
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    strongest_name, strongest = max(
+        attack_results.items(), key=lambda item: item[1]["wall_clock_sec"])
+    report["G5_density_and_baseline"] = {
+        "pass": density < 1e-6 and all_failed and demo_count is not None,
+        "shipping_density_hits": sample_hits,
+        "shipping_density_samples": sample_total,
+        "shipping_density_fraction": density,
+        "shipping_exact_solution_count": None,
+        "demo_exact_solution_count": demo_count,
