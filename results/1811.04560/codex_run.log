\section{W[1]-hardness of {\Konig} Edge Deletion}

% \begin{lemma} \label{obs:ked}
% A graph $G=(V,E)$ has a {\Konig} edge deletion set of size $k$ if and only if $V(G)$ can be partitioned into two parts $V_1$ and $V_2$ such that $|(V_2,V_2)| = k$ and there is a matching $M$ across the cut $(V_1,V_2)$ that saturates $V_1$.
% \end{lemma}
