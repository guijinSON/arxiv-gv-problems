+        for variable, evaluates_true in zip(variables, relative):
+            # sign=1 denotes x, sign=0 denotes not-x.
+            sign = (planted_assignment[variable] if evaluates_true
+                    else 1 - planted_assignment[variable])
+            literal_clause.append((variable, sign))
+        formula.append(literal_clause)
+
+    base_edges_old: set[tuple[int, int]] = set()
+    for clause_index in range(clauses):
+        occurrence = [3 * clause_index + offset for offset in range(3)]
+        base_edges_old.update(itertools.combinations(occurrence, 2))
+    occurrences: dict[tuple[int, int], list[int]] = collections.defaultdict(list)
+    for clause_index, literal_clause in enumerate(formula):
+        for offset, literal in enumerate(literal_clause):
