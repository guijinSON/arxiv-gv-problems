+    mean_wall = sum(ref_times) / attempts
+    mean_trials = sum(ref_trials) // attempts
+    mean_ops = sum(ref_ops) // attempts
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and ref_success == attempts,
+        "attacks": attacks,
