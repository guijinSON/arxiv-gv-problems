+    swapped = answer[:]
+    swapped[pair[0]], swapped[pair[1]] = swapped[pair[1]], swapped[pair[0]]
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": swapped,
+        "duplicate": answer + [answer[-1]],
+        "empty": [],
