+
+def _add(state, delta, q, r):
+    return ((state[0] + delta[0]) % q, (state[1] + delta[1]) % r)
+
+
+def _sub(state, delta, q, r):
+    return ((state[0] - delta[0]) % q, (state[1] - delta[1]) % r)
+
