+def _selected_chain_clauses(n):
+    """Return the concrete n+1 clauses selected by an endpoint-valid path.
+
+    Literal ``v`` is the positive occurrence of variable v and ``-v`` its
+    negation.  Variable 1 is X; variable i+1 is the selected state at internal
+    layer i.  Distinct layer numbers make these state variables distinct even
+    if two modular coordinates happen to agree.
+    """
+
+    clauses = [(1,), (-1, 2)]  # (X), then X -> V(1)
+    for layer in range(2, n):
+        clauses.append((-layer, layer + 1))
+    clauses.append((-n, -1))  # V(n-1) -> not X
+    return clauses
+
+
+def _satisfiable_2cnf(clauses, variable_count):
+    """Exact 2-SAT by iterative Kosaraju SCC; clauses have length one or two."""
+
+    size = 2 * variable_count
+    graph = [[] for _ in range(size)]
+    reverse = [[] for _ in range(size)]
+
+    def node(literal):
+        base = 2 * (abs(literal) - 1)
+        return base if literal > 0 else base ^ 1
+
+    def add_arc(source, target):
+        graph[source].append(target)
+        reverse[target].append(source)
+
+    for clause in clauses:
+        if len(clause) == 1:
+            a = node(clause[0])
+            add_arc(a ^ 1, a)
+        else:
+            a, b = node(clause[0]), node(clause[1])
+            add_arc(a ^ 1, b)
+            add_arc(b ^ 1, a)
+
+    seen = [False] * size
+    order = []
+    for root in range(size):
+        if seen[root]:
+            continue
+        seen[root] = True
+        stack = [(root, 0)]
+        while stack:
+            vertex, edge_index = stack[-1]
+            if edge_index < len(graph[vertex]):
+                nxt = graph[vertex][edge_index]
+                stack[-1] = (vertex, edge_index + 1)
+                if not seen[nxt]:
+                    seen[nxt] = True
+                    stack.append((nxt, 0))
+            else:
+                order.append(vertex)
+                stack.pop()
+
+    component = [-1] * size
+    component_id = 0
+    for root in reversed(order):
+        if component[root] != -1:
+            continue
+        component[root] = component_id
+        stack = [root]
+        while stack:
+            vertex = stack.pop()
+            for nxt in reverse[vertex]:
+                if component[nxt] == -1:
+                    component[nxt] = component_id
+                    stack.append(nxt)
+        component_id += 1
+
+    return all(
+        component[2 * variable] != component[2 * variable + 1]
+        for variable in range(variable_count)
+    )
+
+
