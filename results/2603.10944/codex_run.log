+def _attack_random_restarts(inst, seed, restarts=256):
+    rng = random.Random(seed)
+    operations = 0
+    last = None
+    for _ in range(restarts):
+        last = random_candidate(inst, rng)
+        operations += inst["n"]
+        if verify(inst, last)[0]:
+            return last, operations
+    return last, operations
