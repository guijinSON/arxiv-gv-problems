+def _attack_constant_column(inst):
+    operations = 0
+    last = None
+    for choice in range(1, inst["branching"] + 1):
+        last = [[layer, choice] for layer in range(1, inst["n"] + 1)]
+        operations += inst["n"]
+        if verify(inst, last)[0]:
+            return last, operations
+    return last, operations
