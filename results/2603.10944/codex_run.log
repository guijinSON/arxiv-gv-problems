+    order = []
+    for root in range(size):
+        if seen[root]:
+            continue
+        seen[root] = True
+        stack = [(root, 0)]
+        while stack:
+            vertex, edge_index = stack[-1]
+            if edge_index < len(graph[vertex]):
+                nxt = graph[vertex][edge_index]
+                stack[-1] = (vertex, edge_index + 1)
+                if not seen[nxt]:
+                    seen[nxt] = True
+                    stack.append((nxt, 0))
+            else:
+                order.append(vertex)
+                stack.pop()
+
+    component = [-1] * size
+    component_id = 0
+    for root in reversed(order):
