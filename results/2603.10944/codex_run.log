+        "q": 31,
+        "payload_modulus": 7,
+        "landmarks": 4,
+    },
+    "easy": {
+        "n": 10,
+        "branching": 3,
+        "q": 8191,
+        "payload_modulus": 1009,
+        "landmarks": 12,
+    },
+    "medium": {
+        "n": 14,
+        "branching": 4,
+        "q": 8191,
+        "payload_modulus": 1009,
+        "landmarks": 12,
+    },
