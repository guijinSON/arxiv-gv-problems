+    doubled["jitter"] = 2 * shipping["jitter"] + 1
+    doubled_inst = make_instance(seed=271828, **doubled)
+    doubled_ok, doubled_reason = verify(doubled_inst, doubled_inst["answer"])
+    shipping_work = sum(graph["generators"] for graph in inst["graphs"])
+    doubled_work = sum(graph["generators"] for graph in doubled_inst["graphs"])
+    report["G7_scales"] = {
