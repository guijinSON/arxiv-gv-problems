        colors = new_colors

    vertex_profiles = []
    for v in range(vertex_count):
        vertex_profiles.append([
            colors[v],
            sorted(colors[w] for w in matching_neighbors[v]),
            sorted(
                colors[w]
                for w in graph_neighbors[v]
                if _edge(v, w) not in matching_set
            ),
        ])
