+            "operations": sum(reference_operations),
+            "operation_unit": "complement-edge merge attempts across eight instances",
+            "per_instance_operations": reference_operations,
+        },
+        "intended_compact_route": {
+            "name": "cyclic gcd counts plus sparse consecutive-node interpolation",
+            "solves": f"{compact_successes}/8",
+            "exact_operations": compact_operations,
