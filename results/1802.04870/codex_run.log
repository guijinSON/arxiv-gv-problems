+    else:
+        presentations = []
+        for graph in inst["graphs"]:
+            generators = graph["generators"]
+            components = math.gcd(generators, graph["noncommuting_step"])
+            presentations.append([
+                graph["point"],
+                generators,
+                components,
+                generators // components,
+            ])
+        payload = {
