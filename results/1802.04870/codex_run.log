+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "shipping_reference_edge_iterations": shipping_work,
+        "doubled_reference_edge_iterations": doubled_work,
+        "answer_atoms_shipping": _answer_atoms(inst["answer"]),
+        "answer_atoms_doubled": _answer_atoms(doubled_inst["answer"]),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariant_failures = []
+    invariant_checks = 0
+    real_transformations = 0
+    for seed in range(20):
