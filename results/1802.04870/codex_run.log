+
+def _factorial(n):
+    value = 1
+    for k in range(2, n + 1):
+        value *= k
+    return value
+
+
+def _language_bound(degree):
+    # |sum (-1)^(i-1) C(d,i)m_i| <= M(2^d-1).
+    return _factorial(degree) + _COUNT_BOUND * ((1 << degree) - 1)
+
