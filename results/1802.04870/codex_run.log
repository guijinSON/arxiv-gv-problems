        for v in range(vertex_count)
    ]

    def compress(items):
        ordered = sorted(set(items))
        table = {item: index for index, item in enumerate(ordered)}
        return [table[item] for item in items]

    colors = compress(signatures)
    for _ in range(vertex_count):
        refined = []
        for v in range(vertex_count):
