+        "union-find; at easy seed 271828 it executes 2,136,676 complement-edge "
+        "iterations in 3.43 seconds, whereas the cyclic-gcd and sparse "
+        "finite-difference route takes 178 exact operations."
+    ),
+    "max_answer_tokens": 8,
+}
