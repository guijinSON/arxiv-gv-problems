+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > 100_000:
+        return None
+    valid = 0
+    bound = inst["answer_bound"]
+    for numerator in range(-bound, bound + 1):
+        if verify(inst, [numerator, 1])[0]:
+            valid += 1
+    return valid
