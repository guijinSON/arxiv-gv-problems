+    if abs(numerator) > inst["answer_bound"]:
+        return False, "numerator is outside the declared inclusive bound"
+    expected = _secret_from_values(values)
+    if numerator != expected:
+        return False, "incorrect polynomial secret"
+    return True, "ok"
