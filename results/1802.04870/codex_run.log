+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    try:
+        tagged = re.findall(r"<answer\b[^>]*>(.*?)</answer\s*>", text, re.I | re.S)
+        payload = tagged[-1].strip() if tagged else text.strip()
+        fences = re.findall(r"```(?:json|text)?\s*([\s\S]*?)\s*```", payload, re.I)
