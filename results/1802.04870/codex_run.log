+def _reference_component_count(generators, step):
+    """Proposition 4.2 literally: merge every edge of the complement graph."""
+
+    parent = list(range(generators))
+    size = [1] * generators
+    links = 0
+
+    def find(vertex):
+        while parent[vertex] != vertex:
+            parent[vertex] = parent[parent[vertex]]
+            vertex = parent[vertex]
+        return vertex
+
+    for vertex in range(generators):
+        left = find(vertex)
+        right = find((vertex + step) % generators)
+        if left != right:
+            if size[left] < size[right]:
+                left, right = right, left
+            parent[right] = left
+            size[left] += size[right]
+            links += 1
+    return generators - links, generators
