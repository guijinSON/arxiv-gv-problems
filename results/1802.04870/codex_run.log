+def escalate(params):
+    """Grow the implicit RAAGs while preserving the two-atom certificate."""
+
+    harder = dict(params)
+    n = int(harder.get("n", 8191))
+    jitter = int(harder.get("jitter", 31))
+    # Both axes enlarge/obscure the ambient presentations.  Degree and answer
+    # shape stay fixed, so escalation grows the haystack rather than the needle.
+    harder["n"] = 2 * n + 1
+    harder["jitter"] = 2 * jitter + 1
+    return harder
