    b=m.make_instance(seed=seed, **m.DIFFICULTY[m.SHIPPING_DIFFICULTY])
    assert a==b
    assert m.canonical_key(a)==m.canonical_key(b)
    assert m.verify(a,a['answer'])==(True,'ok')
    wire=f\"prose <answer>{a['answer'][0]}/{a['answer'][1]}</answer> prose\"
