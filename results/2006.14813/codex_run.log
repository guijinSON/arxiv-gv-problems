+    }
+
+    attack_counts = {
+        "outlier_row_norm_order": 0,
+        "greedy_unsigned_xor_coordinates": 0,
+        "random_restart_256": 0,
+        "separable_character_sign_ansatz": 0,
+    }
+    reference_runs = []
+    for seed in range(310, 318):
+        attacked = make_instance(seed=seed, **shipping_params)
