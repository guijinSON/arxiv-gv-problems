+        for name, successes in attack_counts.items()
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(result["successes"] == 0 for result in attacks.values())
+        and all(run["solved"] for run in reference_runs),
+        "attacks": attacks,
+        "reference_algorithm": {
