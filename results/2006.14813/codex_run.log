+    doubled = make_instance(seed=991, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    doubled_compact, doubled_stats = _compact_route(doubled)
+    report["G7_scales"] = {
+        "pass": doubled_ok
