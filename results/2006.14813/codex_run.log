+        rng = random.Random(9000 + seed)
+        permutation = list(range(instance["n"]))
+        rng.shuffle(permutation)
+        basis_signs = [rng.choice((-1, 1)) for _ in range(instance["n"])]
+        identity = list(range(instance["n"]))
+        all_positive = [1] * instance["n"]
+        variants = [
