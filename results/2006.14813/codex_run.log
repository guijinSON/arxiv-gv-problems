+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _answer_atoms(shipping["answer"])
+    arms = copy.deepcopy(G9_ORACLE_RESULTS)
+    hinted_verdict = arms.pop("hinted_verdict", "not_run")
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
