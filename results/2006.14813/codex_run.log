+def _dense_projected_matrix(inst):
+    n = inst["n"]
+    dense = [[0] * n for _ in range(n)]
+    operations = 0
+    for row, column, value in inst["quaternion_slice_entries"]:
+        total = 0
+        for coefficient, coordinate in zip(inst["projection"], value):
+            total += coefficient * coordinate
+            operations += 2
+        dense[row][column] = total
+    return dense, operations
+
+
+def _nullvector(matrix, eigenvalue):
+    """One exact nullvector of matrix-eigenvalue*I, plus arithmetic count."""
+    n = len(matrix)
+    work = [
+        [Fraction(matrix[row][column] - (eigenvalue if row == column else 0)) for column in range(n)]
+        for row in range(n)
+    ]
+    operations = n
+    pivot_columns = []
+    pivot_row = 0
+    for column in range(n):
+        selected = next((row for row in range(pivot_row, n) if work[row][column]), None)
+        if selected is None:
+            continue
+        if selected != pivot_row:
+            work[pivot_row], work[selected] = work[selected], work[pivot_row]
+        pivot = work[pivot_row][column]
+        for cursor in range(column, n):
+            work[pivot_row][cursor] /= pivot
+            operations += 1
+        for row in range(n):
+            if row == pivot_row or not work[row][column]:
+                continue
+            factor = work[row][column]
+            for cursor in range(column, n):
+                work[row][cursor] -= factor * work[pivot_row][cursor]
+                operations += 2
+        pivot_columns.append(column)
+        pivot_row += 1
+        if pivot_row == n:
+            break
+    free = [column for column in range(n) if column not in pivot_columns]
+    if len(free) != 1:
+        return None, operations
+    free_column = free[0]
+    vector = [Fraction(0) for _ in range(n)]
+    vector[free_column] = Fraction(1)
+    for row, column in reversed(list(enumerate(pivot_columns))):
+        vector[column] = -work[row][free_column]
+        operations += 1
+    return vector, operations
+
+
+def _reference_algorithm(inst):
+    """Exact projected eigensolve, followed by lossless Walsh compression."""
+    started = time.perf_counter()
+    dense, operations = _dense_projected_matrix(inst)
+    spectrum = sorted(inst["projected_spectrum"])
+    columns = []
+    for eigenvalue in spectrum:
+        vector, used = _nullvector(dense, eigenvalue)
+        operations += used
+        if vector is None or not vector[0]:
+            return None, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+        normalized = [entry / vector[0] for entry in vector]
+        operations += len(vector)
+        if any(entry not in (Fraction(-1), Fraction(1)) for entry in normalized):
+            return None, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+        columns.append([int(entry) for entry in normalized])
+
+    n = inst["n"]
+    log_n = inst["log_n"]
+    order = [-1] * n
+    signs = [0] * n
+    for physical in range(n):
+        row = [columns[column][physical] for column in range(n)]
+        sign = row[0]
+        word = 0
+        for bit in range(log_n):
+            value = row[1 << bit] * sign
+            operations += 1
+            if value == -1:
+                word |= 1 << bit
+            elif value != 1:
+                return None, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+        if order[word] != -1:
+            return None, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+        order[word] = physical
+        signs[word] = sign
+    answer = {"row_for_word": order, "row_signs": signs}
+    return answer, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+
+
+def _compact_route(inst):
+    """Recover the signed XOR coordinates from repeated quaternion classes."""
+    started = time.perf_counter()
+    n = inst["n"]
+    matrix = _matrix_lookup(inst)
+    class_at = {}
+    transitions = [dict() for _ in range(n)]
+    operations = 0
+    for (row, column), value in matrix.items():
+        if row >= column:
+            continue
+        key, _ = _q_pm_key(value)
+        class_at[key] = None
+        transitions[row][key] = column
+        transitions[column][key] = row
+        operations += 1
+    classes = sorted(class_at)
+    if len(classes) != inst["log_n"]:
+        return None, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+
+    root = 0
+    kernels = {}
+    for key in classes:
+        other = transitions[root].get(key)
+        if other is None:
+            return None, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+        kernels[key] = matrix[(root, other)]
+
+    order = [-1] * n
+    signs = [0] * n
+    order[0] = root
+    signs[0] = 1
+    for word in range(1, n):
+        lowest = word & -word
+        bit = lowest.bit_length() - 1
+        parent = word ^ lowest
+        key = classes[bit]
+        physical_parent = order[parent]
+        physical = transitions[physical_parent].get(key)
+        if physical is None:
+            return None, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+        value = matrix[(physical_parent, physical)]
+        if value == kernels[key]:
+            relative = 1
+        elif value == _q_neg(kernels[key]):
+            relative = -1
+        else:
+            return None, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+        order[word] = physical
+        signs[word] = signs[parent] * relative
+        operations += 1
+    if len(set(order)) != n:
+        return None, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+    answer = {"row_for_word": order, "row_signs": signs}
+    return answer, {"operations": operations, "wall_clock_sec": time.perf_counter() - started}
+
