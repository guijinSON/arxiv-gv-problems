+
+def _q_neg(value):
+    return tuple(-x for x in value)
+
+
+def _q_scale(value, sign):
+    return value if sign == 1 else _q_neg(value)
+
+
+def _q_dot(value, coefficients=_PROJECTION):
+    return sum(value[i] * coefficients[i] for i in range(4))
