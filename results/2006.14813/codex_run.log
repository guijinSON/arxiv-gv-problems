+def _attack_separable_sign_ansatz(inst):
+    answer, _ = _compact_route(inst)
+    if answer is None:
+        return False
+    n = inst["n"]
+    for mask in range(n):
+        trial = {
+            "row_for_word": list(answer["row_for_word"]),
+            "row_signs": [1 if (mask & word).bit_count() % 2 == 0 else -1 for word in range(n)],
+        }
+        if verify(inst, trial)[0]:
+            return True
+    return False
