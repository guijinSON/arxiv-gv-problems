+            "real diagonal sign conjugation",
+            "their composition plus sparse-entry reordering",
+        ],
+        "failures": key_failures,
+    }
+
+    answer_blobs = [
+        json.dumps(make_instance(seed=seed, **shipping_params)["answer"], separators=(",", ":"))
+        for seed in range(100)
