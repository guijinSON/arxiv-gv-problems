+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+DIFFICULTY = {
+    "demo": {"n": 2, "height": 3},
+    "easy": {"n": 32, "height": 136},
+    "medium": {"n": 64, "height": 273},
+    "hard": {"n": 128, "height": 546},
+}
