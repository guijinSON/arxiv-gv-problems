+    "easy": {"n": 8, "height": 5},
+    "medium": {"n": 16, "height": 9},
+    "hard": {"n": 32, "height": 17},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
