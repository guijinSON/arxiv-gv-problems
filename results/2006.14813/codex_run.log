+        "hits": sample_hits,
+        "total": sample_total,
+        "observed_probability": sample_hits / sample_total,
+        "construction_exact_probability": shipping["n"] / (1 << (shipping["n"] - 1)),
+        "certificate_space": search_space(shipping),
