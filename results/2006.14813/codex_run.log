from fractions import Fraction as F
from random import Random
from time import perf_counter

def add(a,b): return tuple(x+y for x,y in zip(a,b))
def sub(a,b): return tuple(x-y for x,y in zip(a,b))
def mul(a,b):
    w,x,y,z=a; W,X,Y,Z=b
    return (w*W-x*X-y*Y-z*Z,
            w*X+x*W+y*Z-z*Y,
            w*Y-x*Z+y*W+z*X,
            w*Z+x*Y-y*X+z*W)
def inv(a):
    w,x,y,z=a; d=w*w+x*x+y*y+z*z
    return (w/d,-x/d,-y/d,-z/d)
def formula(vals):
    A11,A12,A21,A22,B11,B12,B21,B22=vals
    u=mul(inv(A11),A12); v=mul(inv(B11),B12)
    da=sub(A22,mul(A21,u)); db=sub(B22,mul(B21,v))
    return u,v,da,db
