+def _joint_eigenvalues(weights, n):
+    values = []
+    for word in range(n):
+        total = _ZERO
+        for bit, weight in enumerate(weights):
+            if word & (1 << bit):
+                total = _q_add(total, weight)
+        values.append(tuple(2 * coordinate for coordinate in total))
