+        inst = make_instance(seed=20_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        rng_local = random.Random(30_000 + seed)
+        variable_map = list(range(inst["m"]))
+        row_order = list(range(inst["m"]))
+        rng_local.shuffle(variable_map)
