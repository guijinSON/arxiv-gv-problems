+    attack_results = {
+        "outlier_row_norm": {"successes": 0, "attempts": 0},
+        "greedy_chain_unmixed_walsh": {"successes": 0, "attempts": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0},
+        "direct_unmixed_ansatz": {"successes": 0, "attempts": 0},
