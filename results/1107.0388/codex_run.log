+# Filled after the three harness runs.  The arms are diagnostic; only the size
+# and intended-operation caps gate G9 under the current protocol.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
