+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _atoms(shipping["answer"])
+    intended_operations = 148
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300
