+    }
+    if not within_caps:
+        raise AssertionError("G9(c) failed")
+
+    report["all_pass"] = all(
+        gate.get("pass", False)
+        for name, gate in report.items()
+        if name.startswith("G")
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

