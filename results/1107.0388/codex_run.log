+        "pass": doubled_ok and doubled["m"] > shipping["m"],
+        "shipping_m": shipping["m"],
+        "doubled_m": doubled["m"],
+        "doubled_verification": doubled_reason,
+        "shipping_reference_operations": reference_cost["operations"],
+        "doubled_reference_operations": 2
