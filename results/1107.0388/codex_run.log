+
+    blob = json.dumps(shipping["answer"], separators=(",", ":"))
+    realistic = "I used the Walsh orthogonality.\n```text\nFinal:\n```\n<answer>\n" + blob + "\n</answer>\n"
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
