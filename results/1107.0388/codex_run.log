+        "shipping_density_hits": hits,
+        "shipping_density_total": samples,
+        "reference_wall_clock_sec": reference_cost["wall_clock_sec"],
+        "reference_operations": reference_cost["operations"],
+        "shipping_density": {
+            "kind": "sampled",
+            "hits": hits,
+            "total": samples,
+            "observed_fraction": probability,
