+def _affine_relabel(inst, answer, rng):
+    """Carry a witness through split-preserving affine coordinate relabellings."""
+    n = inst["n"]
+    m = n // 2
+    q = 1 << m
+    pi_old = answer["permutation"]
+    bits_old = [int(c) for c in answer["offset_bits"]]
+    px = list(range(m))
+    py = list(range(m))
+    rng.shuffle(px)
+    rng.shuffle(py)
+    tx = rng.randrange(q)
+    ty = rng.randrange(q)
+    complement = rng.randrange(2)
+    pi_new = [0] * q
+    bits_new = [0] * q
+    for y_new in range(q):
+        y_old = _permute_bits(y_new, py) ^ ty
+        old_value = pi_old[y_old]
+        new_value = 0
+        for j in range(m):
+            if _parity(_permute_bits(1 << j, px) & old_value):
+                new_value |= 1 << j
+        pi_new[y_new] = new_value
+        bits_new[y_new] = bits_old[y_old] ^ _parity(tx & old_value) ^ complement
+    transformed = _instance_from_representation(n, pi_new, bits_new, rng.randrange(1 << 30))
+    transformed["row_order"].reverse()  # compose with a pure presentation reordering
+    return transformed, transformed["answer"]
