+
+def _parity(x):
+    return x.bit_count() & 1
+
+
+def _is_affine_permutation(pi, m):
+    """Whether pi(y) is affine over F_2^m (pi is already a permutation)."""
+    base = pi[0]
+    columns = [pi[1 << j] ^ base for j in range(m)]
+    for y, value in enumerate(pi):
+        predicted = base
+        for j in range(m):
+            if (y >> j) & 1:
+                predicted ^= columns[j]
+        if predicted != value:
+            return False
+    return True
+
+
+def _answer_object(pi, bits):
+    return {"permutation": list(pi), "offset_bits": "".join(str(int(b)) for b in bits)}
+
+
+def _spectrum_from_representation(pi, bits):
+    q = len(pi)
+    m = q.bit_length() - 1
+    if 1 << m != q:
+        raise ValueError("permutation length must be a power of two")
+    inverse = [0] * q
+    for y, a in enumerate(pi):
+        inverse[a] = y
+    scale = q
+    spectrum = []
+    for a in range(q):
+        y = inverse[a]
+        gy = int(bits[y])
+        for b in range(q):
+            spectrum.append(-scale if gy ^ _parity(b & y) else scale)
+    return spectrum
+
+
+def _instance_from_representation(n, pi, bits, row_seed):
+    q = 1 << (n // 2)
+    if len(pi) != q or len(bits) != q:
+        raise ValueError("representation has the wrong size")
+    order = list(range(q))
+    random.Random(row_seed).shuffle(order)
+    return {
+        "n": n,
+        "half_variables": n // 2,
+        "spectrum": _spectrum_from_representation(pi, bits),
+        "row_order": order,
+        "answer": _answer_object(pi, bits),
+    }
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a Walsh spectrum from sampled compact function parameters."""
+    if params:
+        unknown = ", ".join(sorted(params))
+        raise TypeError(f"unknown make_instance parameter(s): {unknown}")
+    if type(n) is not int or n < 2 or n % 2:
+        raise ValueError("n must be an even integer at least 2")
+    m = n // 2
+    q = 1 << m
+    rng = random.Random(seed)
+    pi = list(range(q))
+    # The affine ansatz is one of the explicit in-context attacks.  Conditioning
+    # the planted distribution to avoid it is public and deterministic.
+    while True:
+        rng.shuffle(pi)
+        if m < 3 or not _is_affine_permutation(pi, m):
+            break
+    bits = [rng.randrange(2) for _ in range(q)]
+    order = list(range(q))
+    rng.shuffle(order)
+    return {
+        "n": n,
+        "half_variables": m,
+        "spectrum": _spectrum_from_representation(pi, bits),
+        "row_order": order,
+        "answer": _answer_object(pi, bits),
+    }
+
+
+def _answer_json(answer):
+    return json.dumps(answer, separators=(",", ":"), sort_keys=True)
+
+
+def render(inst):
+    """Render a complete statement; the default includes no hint."""
+    n = inst["n"]
+    m = inst["half_variables"]
+    q = 1 << m
+    spectrum = inst["spectrum"]
+    order = inst.get("row_order", list(range(q)))
+    lines = []
+    for a in order:
+        row = spectrum[a * q : (a + 1) * q]
+        lines.append(f"a={a}: " + " ".join(str(v) for v in row))
+
+    example = _answer_json(
+        {"permutation": list(range(q)), "offset_bits": "0" * q}
+    )
+    statement = f"""Recover a cryptographic Boolean function from its Walsh spectrum.
+
+All arithmetic inside the function is over F_2={{0,1}}: XOR is addition, AND is
+multiplication, and <r,s> is the XOR of the bitwise products of equally sized bit
+vectors.  There are n={n}=2m variables with m={m}.  Identify each m-bit vector
+with its integer in 0..{q - 1}, least-significant coordinate first.
+
+The unknown function has the promised Maiorana--McFarland form
+
+    f(x,y) = <x, pi(y)> XOR g(y),
+
+where x,y are m-bit vectors, pi is a permutation of the integers 0..{q - 1}, and
+g(y) is one bit for each y.  Its Walsh coefficient at frequency (a,b) is
+
+    W_f(a,b) = sum over all x,y of (-1)^(f(x,y) XOR <a,x> XOR <b,y>).
+
+The complete exact spectrum is below.  Rows may be presented in any order.  A
+row labelled a contains b=0,1,...,{q - 1} from left to right; all bounds are
+inclusive, and no value is omitted.
+
+{chr(10).join(lines)}
+
+Recover pi and g.  The permutation must contain every integer 0..{q - 1}
+exactly once, in y=0,1,...,{q - 1} order.  Encode g in the same y order as one
+{q}-character binary string.  Order matters and repeats in the permutation are
+forbidden.
+
+Give your final answer inside <answer></answer> tags, as one JSON object with
+exactly the keys "permutation" and "offset_bits".  Example of the format only:
+<answer>{example}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def _normalise_parsed_object(value):
+    if not isinstance(value, dict):
+        return None
+    if set(value) != {"permutation", "offset_bits"}:
+        return None
+    pi = value.get("permutation")
+    bits = value.get("offset_bits")
+    if not isinstance(pi, list) or not all(type(x) is int for x in pi):
+        return None
+    if not isinstance(bits, str) or any(c not in "01" for c in bits):
+        return None
+    return {"permutation": pi, "offset_bits": bits}
+
+
+def parse_answer(text):
+    """Extract the last tagged JSON answer, tolerating prose and markdown fences."""
+    if not isinstance(text, str):
+        return None
+    bodies = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    if bodies:
+        body = bodies[-1].strip()
+    else:
+        fences = re.findall(r"```(?:json)?\s*(\{.*?\})\s*```", text, flags=re.I | re.S)
+        if fences:
+            body = fences[-1]
+        else:
+            stripped = text.strip()
+            if not (stripped.startswith("{") and stripped.endswith("}")):
+                return None
+            body = stripped
+    if body.startswith("```") and body.endswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return _normalise_parsed_object(value)
+
+
+def verify(inst, answer):
+    """Verify any valid compact representation without consulting inst['answer']."""
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer object is empty"
+    if set(answer) != {"permutation", "offset_bits"}:
+        return False, "answer must have exactly permutation and offset_bits keys"
+
+    n = inst["n"]
+    m = n // 2
+    q = 1 << m
+    pi = answer["permutation"]
+    bits_text = answer["offset_bits"]
+    if not isinstance(pi, list):
+        return False, "permutation must be a JSON list"
+    if len(pi) < q:
+        return False, f"permutation is too short: expected {q}, got {len(pi)}"
+    if len(pi) > q:
+        return False, f"permutation is too long: expected {q}, got {len(pi)}"
+    for y, value in enumerate(pi):
+        if type(value) is not int:
+            return False, f"permutation entry {y} is not an integer"
+        if not 0 <= value < q:
+            return False, f"permutation entry {y} is outside 0..{q - 1}"
+    if len(set(pi)) != q:
+        return False, "permutation contains duplicate values"
+    if not isinstance(bits_text, str):
+        return False, "offset_bits must be a string"
+    if len(bits_text) != q:
+        return False, f"offset_bits has wrong length: expected {q}, got {len(bits_text)}"
+    if any(c not in "01" for c in bits_text):
+        return False, "offset_bits contains a character other than 0 or 1"
+
+    spectrum = inst.get("spectrum")
+    if not isinstance(spectrum, list) or len(spectrum) != q * q:
+        return False, "instance spectrum has the wrong shape"
+    inverse = [0] * q
+    for y, a in enumerate(pi):
+        inverse[a] = y
+    for a in range(q):
+        y = inverse[a]
+        gy = ord(bits_text[y]) - ord("0")
+        for b in range(q):
+            expected = -q if gy ^ _parity(b & y) else q
+            got = spectrum[a * q + b]
+            if type(got) is not int:
+                return False, f"instance coefficient (a={a}, b={b}) is not an integer"
+            if got != expected:
+                return False, (
+                    f"Walsh mismatch at (a={a}, b={b}): expected {expected}, got {got}"
+                )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the exact promised representation language."""
+    q = 1 << (inst["n"] // 2)
+    pi = list(range(q))
+    rng.shuffle(pi)
+    bits = [rng.randrange(2) for _ in range(q)]
+    return _answer_object(pi, bits)
+
+
+def search_space(inst):
+    q = 1 << (inst["n"] // 2)
+    return math.factorial(q) * (1 << q)
+
+
+def enumerate_all(inst):
+    """Brute-force tiny languages only; larger exact counts deliberately return None."""
+    q = 1 << (inst["n"] // 2)
+    space = search_space(inst)
+    if space > 100_000:
+        return None
+    count = 0
+    for pi in itertools.permutations(range(q)):
+        for bitmask in range(1 << q):
+            bits = [(bitmask >> y) & 1 for y in range(q)]
+            if verify(inst, _answer_object(pi, bits))[0]:
+                count += 1
+    return count
+
+
+def _translated_bitmask(mask, delta, size):
+    out = 0
+    for x in range(size):
+        if (mask >> x) & 1:
+            out |= 1 << (x ^ delta)
+    return out
+
+
+def canonical_key(inst):
+    """A strong affine-invariant signature of the spectrum's sign function.
+
+    Second derivatives are unchanged by affine output terms, while an invertible
+    affine relabelling merely permutes their directions.  Per-direction weight
+    histograms are sorted before hashing.  This is a strong cheap invariant, not a
+    complete affine-isomorphism algorithm.
+    """
+    spectrum = inst["spectrum"]
+    size = len(spectrum)
+    if size == 0 or size & (size - 1):
+        raise ValueError("spectrum length must be a nonzero power of two")
+    mask = 0
+    for u, value in enumerate(spectrum):
+        if value < 0:
+            mask |= 1 << u
+    translated = [_translated_bitmask(mask, d, size) for d in range(size)]
+    base = translated[0]
+    row_digests = []
+    for a in range(1, size):
+        ta = translated[a]
+        hist = Counter(
+            (base ^ ta ^ translated[b] ^ translated[a ^ b]).bit_count()
+            for b in range(size)
+        )
+        payload = repr(sorted(hist.items())).encode("ascii")
+        row_digests.append(hashlib.sha256(payload).digest())
+    row_digests.sort()
+    digest = hashlib.sha256(
+        str(inst["n"]).encode("ascii") + b"|" + b"".join(row_digests)
+    ).hexdigest()
+    return f"affine-d2-v1:{inst['n']}:{digest}"
+
+
+def escalate(params):
+    n = int(params.get("n", 0))
+    if n >= 10:
+        return None
+    return {"n": n + 2}
+
+
+def _fwht_in_place(values):
+    length = 1
+    operations = 0
+    while length < len(values):
+        for start in range(0, len(values), 2 * length):
+            for j in range(start, start + length):
+                left, right = values[j], values[j + length]
+                values[j] = left + right
+                values[j + length] = left - right
+                operations += 2
+        length *= 2
+    return operations
+
+
+def _reference_recover(inst):
+    """Domain-standard full inverse transform, with an exact operation count."""
+    n = inst["n"]
+    m = n // 2
+    q = 1 << m
+    size = 1 << n
+    values = list(inst["spectrum"])
+    operations = _fwht_in_place(values)
+    truth = []
+    for value in values:
+        if value not in (-size, size):
+            return None, operations
+        truth.append(0 if value == size else 1)
+        operations += 1  # exact normalization/sign decision
+    pi = [0] * q
+    bits = [0] * q
+    for y in range(q):
+        bits[y] = truth[y]
+        for j in range(m):
+            pi[y] |= (truth[((1 << j) << m) | y] ^ bits[y]) << j
+            operations += 1
+    return _answer_object(pi, bits), operations
+
+
+def _compact_recover(inst):
+    """The intended row-character route (not an adversary: it should succeed)."""
+    m = inst["n"] // 2
+    q = 1 << m
+    spectrum = inst["spectrum"]
+    pi = [-1] * q
+    bits = [0] * q
+    operations = 0
+    for a in range(q):
+        base = spectrum[a * q]
+        y = 0
+        for j in range(m):
+            if spectrum[a * q + (1 << j)] != base:
+                y |= 1 << j
+            operations += 1
+        pi[y] = a
+        bits[y] = 1 if base < 0 else 0
+        operations += 1
+    return _answer_object(pi, bits), operations
+
+
+def _offset_for_candidate_pi(inst, pi):
+    q = len(pi)
+    spectrum = inst["spectrum"]
+    bits = [1 if spectrum[a * q] < 0 else 0 for a in pi]
+    return _answer_object(pi, bits)
+
+
+def _attack_identity(inst):
+    q = 1 << (inst["n"] // 2)
+    return _offset_for_candidate_pi(inst, list(range(q)))
+
+
+def _attack_outlier_row_counts(inst):
+    """Use only row sign counts; these reveal y=0 but no other hidden labels."""
+    q = 1 << (inst["n"] // 2)
+    spectrum = inst["spectrum"]
+    constant_rows = []
+    for a in range(q):
+        row = spectrum[a * q : (a + 1) * q]
+        positives = sum(value > 0 for value in row)
+        if positives in (0, q):
+            constant_rows.append(a)
+    a_zero = constant_rows[0] if len(constant_rows) == 1 else 0
+    remaining = [a for a in range(q) if a != a_zero]
+    pi = [a_zero] + remaining
+    return _offset_for_candidate_pi(inst, pi)
+
+
+def _attack_greedy_row_order(inst):
+    """Assign rows greedily by public order and use b=0 to choose each offset."""
+    q = 1 << (inst["n"] // 2)
+    order = list(inst.get("row_order", range(q)))
+    pi = order[:q]
+    return _offset_for_candidate_pi(inst, pi)
+
+
+def _attack_affine_ansatz(inst):
+    """Recover basis values, then extrapolate the obvious affine permutation ansatz."""
+    recovered, _ = _compact_recover(inst)
+    actual = recovered["permutation"]
+    m = inst["n"] // 2
+    q = 1 << m
+    base = actual[0]
+    columns = [actual[1 << j] ^ base for j in range(m)]
+    pi = []
+    for y in range(q):
+        value = base
+        for j in range(m):
+            if (y >> j) & 1:
+                value ^= columns[j]
+        pi.append(value)
+    if len(set(pi)) != q:
+        pi = list(range(q))
+    return _offset_for_candidate_pi(inst, pi)
+
+
+def _random_restart_attack(inst, restarts, rng):
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate
+    return None
+
+
+def _permute_bits(value, permutation):
+    out = 0
+    for target, source in enumerate(permutation):
+        if (value >> source) & 1:
+            out |= 1 << target
+    return out
+
+
+def _affine_relabel(inst, answer, rng):
+    """Carry a witness through split-preserving affine coordinate relabellings."""
+    n = inst["n"]
+    m = n // 2
+    q = 1 << m
+    pi_old = answer["permutation"]
+    bits_old = [int(c) for c in answer["offset_bits"]]
+    px = list(range(m))
+    py = list(range(m))
+    rng.shuffle(px)
+    rng.shuffle(py)
+    tx = rng.randrange(q)
+    ty = rng.randrange(q)
+    complement = rng.randrange(2)
+    pi_new = [0] * q
+    bits_new = [0] * q
+    for y_new in range(q):
+        y_old = _permute_bits(y_new, py) ^ ty
+        old_value = pi_old[y_old]
+        new_value = 0
+        for j in range(m):
+            if _parity(_permute_bits(1 << j, px) & old_value):
+                new_value |= 1 << j
+        pi_new[y_new] = new_value
+        bits_new[y_new] = bits_old[y_old] ^ _parity(tx & old_value) ^ complement
+    transformed = _instance_from_representation(n, pi_new, bits_new, rng.randrange(1 << 30))
+    transformed["row_order"].reverse()  # compose with a pure presentation reordering
+    return transformed, transformed["answer"]
+
+
+def _measure_reference(inst, repeats=5):
+    elapsed = []
+    answer = None
+    operations = 0
+    for _ in range(repeats):
+        start = time.perf_counter()
+        answer, operations = _reference_recover(inst)
+        elapsed.append(time.perf_counter() - start)
+    return answer, operations, sum(elapsed) / len(elapsed)
+
