+    m = inst["n"] // 2
+    q = 1 << m
+    base = actual[0]
+    columns = [actual[1 << j] ^ base for j in range(m)]
+    pi = []
+    for y in range(q):
+        value = base
+        for j in range(m):
+            if (y >> j) & 1:
+                value ^= columns[j]
+        pi.append(value)
+    if len(set(pi)) != q:
+        pi = list(range(q))
+    return _offset_for_candidate_pi(inst, pi)
