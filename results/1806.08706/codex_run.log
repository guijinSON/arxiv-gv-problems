+"""Verified Walsh-spectrum reconstruction instances from arXiv:1806.08706.
+
+The paper represents Boolean functions by truth tables and exact Walsh spectra.
+This Track-B family inverse-generates a promised Maiorana--McFarland function,
+publishes its complete spectrum, and asks for the compact permutation/offset
+representation.  The standard inverse Walsh--Hadamard route is deliberately
+available and is reported rather than hidden.
+
+Only the Python standard library is used.  Importing this module performs no I/O
+and prints nothing.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import Counter
+
+
+TRACK = "B"
+
+DIFFICULTY = {
+    "demo": {"n": 2},
+    "easy": {"n": 6},
+    "medium": {"n": 8},
+    "hard": {"n": 10},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "Treat each spectrum row as a signed Walsh character: its unit-coordinate "
+    "signs reveal the hidden preimage under the permutation."
+)
+PLACEBO_HINT = (
+    "Treat each displayed row carefully and track every index: small transcription "
+    "mistakes can invalidate the entire final symbolic certificate."
+)
+
+# Filled from the separately owned hardening transcripts after those runs.  Keeping
+# these values explicit makes selftest_report.json reproducible from this module.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
+}
+
+PROBLEM_PROFILE = {
+    "native_domain": "algebra",
+    "object_regime": "finite_field",
+    "computational_core": "linear_algebra",
+    "certificate_form": "exact_symbolic",
+    "native_objects": [
+        "Walsh spectrum over the integers of a Boolean function on F_2^n",
+        "Maiorana-McFarland permutation-and-offset representation",
+    ],
+    "verification_operations": [
+        "permutation validation",
+        "exact parity evaluation over F_2",
+        "exact integer Walsh-spectrum comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
