+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON object containing a permutation of 0..2^(n/2)-1 and exactly "
+        "2^(n/2) offset bits; it denotes f(x,y)=<x,permutation[y]> XOR offset[y] "
+        "over F_2."
+    ),
+    "bounds": {
+        "max_shipping_n": 10,
+        "max_permutation_length": 32,
+        "max_offset_bits": 32,
+        "permutation_entry_bits": 5,
+    },
+}
+
+NOTES = """
+Paper basis: Section II.A defines an n-variable Boolean function on F_2^n, its
+truth-table ordering, Walsh transform (Eq. 3), nonlinearity (Eq. 4), and bentness.
+The same section explicitly separates deterministic algebraic constructions from
+random and heuristic search.  Section II.B writes Walsh evaluation as a Hadamard
+matrix multiplication (Eq. 5) and states that bentness is exactly flat absolute
+Walsh spectrum.  Those are the native objects used here.
+
+Step-0 choice: asking merely for any bent function was rejected.  A direct
+Maiorana--McFarland formula would solve that request, and the paper's own n=4
+experiment reports 95.86 percent bent outputs at its best coupling; Section VI
+then improves near-optima by greedy hill climbing.  Such a family could not make
+an honest Track-A claim.  This module instead declares Track B and asks for the
+compact parameters of a promised function from its complete exact spectrum.
+
+Certificate production: sample the permutation and offset first.  For
+f(x,y)=x dot pi(y) XOR g(y), summing over x proves directly that
+W_f(a,b)=2^m*(-1)^(g(y)+b dot y), where y=pi^{-1}(a).  make_instance uses this
+identity and never solves the emitted instance.
+
+What makes it easy: a fast Walsh--Hadamard transform is self-inverse up to the
+factor 2^n, so it reconstructs the truth table in O(n*2^n); m+1 probes per y then
+extract pi and g.  The family is hard only in the declared no-tool-compression
+sense.  The compact route notices that every normalized row is a signed Walsh
+character and reads y from the base and unit-coordinate signs.
+
+Attack controls: permutations are uniform subject only to being non-affine for
+m>=3, so identity, row-order greedy, and an affine extrapolation from basis
+points fail.  Random restart samples the exact stated certificate language.
+Plants and random candidates use the same permutation/offset marginals except
+for the disclosed non-affine conditioning; no magnitude or position outlier is
+inserted.  The successful inverse-FWHT algorithm is reported separately as the
+Track-B reference algorithm, never disguised as a failed attack.
+""".strip()
+
+
+def _parity(x):
+    return x.bit_count() & 1
+
+
+def _is_affine_permutation(pi, m):
+    """Whether pi(y) is affine over F_2^m (pi is already a permutation)."""
+    base = pi[0]
+    columns = [pi[1 << j] ^ base for j in range(m)]
+    for y, value in enumerate(pi):
+        predicted = base
+        for j in range(m):
+            if (y >> j) & 1:
+                predicted ^= columns[j]
+        if predicted != value:
+            return False
+    return True
+
+
+def _answer_object(pi, bits):
+    return {"permutation": list(pi), "offset_bits": "".join(str(int(b)) for b in bits)}
+
+
+def _spectrum_from_representation(pi, bits):
+    q = len(pi)
+    m = q.bit_length() - 1
+    if 1 << m != q:
+        raise ValueError("permutation length must be a power of two")
+    inverse = [0] * q
+    for y, a in enumerate(pi):
+        inverse[a] = y
+    scale = q
+    spectrum = []
+    for a in range(q):
+        y = inverse[a]
+        gy = int(bits[y])
+        for b in range(q):
+            spectrum.append(-scale if gy ^ _parity(b & y) else scale)
+    return spectrum
+
+
+def _instance_from_representation(n, pi, bits, row_seed):
+    q = 1 << (n // 2)
+    if len(pi) != q or len(bits) != q:
+        raise ValueError("representation has the wrong size")
+    order = list(range(q))
+    random.Random(row_seed).shuffle(order)
+    return {
+        "n": n,
+        "half_variables": n // 2,
+        "spectrum": _spectrum_from_representation(pi, bits),
+        "row_order": order,
+        "answer": _answer_object(pi, bits),
+    }
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a Walsh spectrum from sampled compact function parameters."""
+    if params:
+        unknown = ", ".join(sorted(params))
+        raise TypeError(f"unknown make_instance parameter(s): {unknown}")
+    if type(n) is not int or n < 2 or n % 2:
+        raise ValueError("n must be an even integer at least 2")
+    m = n // 2
+    q = 1 << m
+    rng = random.Random(seed)
+    pi = list(range(q))
+    # The affine ansatz is one of the explicit in-context attacks.  Conditioning
+    # the planted distribution to avoid it is public and deterministic.
+    while True:
+        rng.shuffle(pi)
+        if m < 3 or not _is_affine_permutation(pi, m):
+            break
+    bits = [rng.randrange(2) for _ in range(q)]
+    order = list(range(q))
+    rng.shuffle(order)
+    return {
+        "n": n,
+        "half_variables": m,
+        "spectrum": _spectrum_from_representation(pi, bits),
+        "row_order": order,
+        "answer": _answer_object(pi, bits),
+    }
+
+
+def _answer_json(answer):
+    return json.dumps(answer, separators=(",", ":"), sort_keys=True)
+
+
+def render(inst):
+    """Render a complete statement; the default includes no hint."""
+    n = inst["n"]
+    m = inst["half_variables"]
+    q = 1 << m
+    spectrum = inst["spectrum"]
+    order = inst.get("row_order", list(range(q)))
+    lines = []
+    for a in order:
+        row = spectrum[a * q : (a + 1) * q]
+        lines.append(f"a={a}: " + " ".join(str(v) for v in row))
+
+    example = _answer_json(
+        {"permutation": list(range(q)), "offset_bits": "0" * q}
+    )
+    statement = f"""Recover a cryptographic Boolean function from its Walsh spectrum.
+
+All arithmetic inside the function is over F_2={{0,1}}: XOR is addition, AND is
+multiplication, and <r,s> is the XOR of the bitwise products of equally sized bit
+vectors.  There are n={n}=2m variables with m={m}.  Identify each m-bit vector
+with its integer in 0..{q - 1}, least-significant coordinate first.
+
+The unknown function has the promised Maiorana--McFarland form
+
+    f(x,y) = <x, pi(y)> XOR g(y),
+
+where x,y are m-bit vectors, pi is a permutation of the integers 0..{q - 1}, and
+g(y) is one bit for each y.  Its Walsh coefficient at frequency (a,b) is
+
+    W_f(a,b) = sum over all x,y of (-1)^(f(x,y) XOR <a,x> XOR <b,y>).
+
+The complete exact spectrum is below.  Rows may be presented in any order.  A
+row labelled a contains b=0,1,...,{q - 1} from left to right; all bounds are
+inclusive, and no value is omitted.
+
+{chr(10).join(lines)}
+
+Recover pi and g.  The permutation must contain every integer 0..{q - 1}
+exactly once, in y=0,1,...,{q - 1} order.  Encode g in the same y order as one
+{q}-character binary string.  Order matters and repeats in the permutation are
+forbidden.
+
+Give your final answer inside <answer></answer> tags, as one JSON object with
+exactly the keys "permutation" and "offset_bits".  Example of the format only:
+<answer>{example}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def _normalise_parsed_object(value):
+    if not isinstance(value, dict):
+        return None
+    if set(value) != {"permutation", "offset_bits"}:
+        return None
+    pi = value.get("permutation")
+    bits = value.get("offset_bits")
+    if not isinstance(pi, list) or not all(type(x) is int for x in pi):
+        return None
+    if not isinstance(bits, str) or any(c not in "01" for c in bits):
+        return None
+    return {"permutation": pi, "offset_bits": bits}
+
+
+def parse_answer(text):
+    """Extract the last tagged JSON answer, tolerating prose and markdown fences."""
+    if not isinstance(text, str):
+        return None
+    bodies = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    if bodies:
+        body = bodies[-1].strip()
+    else:
+        fences = re.findall(r"```(?:json)?\s*(\{.*?\})\s*```", text, flags=re.I | re.S)
+        if fences:
+            body = fences[-1]
+        else:
+            stripped = text.strip()
+            if not (stripped.startswith("{") and stripped.endswith("}")):
+                return None
+            body = stripped
+    if body.startswith("```") and body.endswith("```"):
+        body = re.sub(r"^```(?:json)?\s*", "", body, flags=re.I)
+        body = re.sub(r"\s*```$", "", body)
+    try:
+        value = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    return _normalise_parsed_object(value)
+
+
+def verify(inst, answer):
+    """Verify any valid compact representation without consulting inst['answer']."""
+    if not isinstance(answer, dict):
+        return False, "answer must be a JSON object"
+    if not answer:
+        return False, "answer object is empty"
+    if set(answer) != {"permutation", "offset_bits"}:
+        return False, "answer must have exactly permutation and offset_bits keys"
+
+    n = inst["n"]
+    m = n // 2
+    q = 1 << m
+    pi = answer["permutation"]
+    bits_text = answer["offset_bits"]
+    if not isinstance(pi, list):
+        return False, "permutation must be a JSON list"
+    if len(pi) < q:
+        return False, f"permutation is too short: expected {q}, got {len(pi)}"
+    if len(pi) > q:
+        return False, f"permutation is too long: expected {q}, got {len(pi)}"
+    for y, value in enumerate(pi):
+        if type(value) is not int:
+            return False, f"permutation entry {y} is not an integer"
+        if not 0 <= value < q:
+            return False, f"permutation entry {y} is outside 0..{q - 1}"
+    if len(set(pi)) != q:
+        return False, "permutation contains duplicate values"
+    if not isinstance(bits_text, str):
+        return False, "offset_bits must be a string"
+    if len(bits_text) != q:
+        return False, f"offset_bits has wrong length: expected {q}, got {len(bits_text)}"
+    if any(c not in "01" for c in bits_text):
+        return False, "offset_bits contains a character other than 0 or 1"
+
+    spectrum = inst.get("spectrum")
+    if not isinstance(spectrum, list) or len(spectrum) != q * q:
+        return False, "instance spectrum has the wrong shape"
+    inverse = [0] * q
+    for y, a in enumerate(pi):
+        inverse[a] = y
+    for a in range(q):
+        y = inverse[a]
+        gy = ord(bits_text[y]) - ord("0")
+        for b in range(q):
+            expected = -q if gy ^ _parity(b & y) else q
+            got = spectrum[a * q + b]
+            if type(got) is not int:
+                return False, f"instance coefficient (a={a}, b={b}) is not an integer"
+            if got != expected:
+                return False, (
+                    f"Walsh mismatch at (a={a}, b={b}): expected {expected}, got {got}"
+                )
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the exact promised representation language."""
+    q = 1 << (inst["n"] // 2)
+    pi = list(range(q))
+    rng.shuffle(pi)
+    bits = [rng.randrange(2) for _ in range(q)]
+    return _answer_object(pi, bits)
+
+
+def search_space(inst):
+    q = 1 << (inst["n"] // 2)
+    return math.factorial(q) * (1 << q)
+
+
+def enumerate_all(inst):
+    """Brute-force tiny languages only; larger exact counts deliberately return None."""
+    q = 1 << (inst["n"] // 2)
+    space = search_space(inst)
+    if space > 100_000:
+        return None
+    count = 0
+    for pi in itertools.permutations(range(q)):
+        for bitmask in range(1 << q):
+            bits = [(bitmask >> y) & 1 for y in range(q)]
+            if verify(inst, _answer_object(pi, bits))[0]:
+                count += 1
+    return count
+
+
+def _translated_bitmask(mask, delta, size):
+    out = 0
+    for x in range(size):
+        if (mask >> x) & 1:
+            out |= 1 << (x ^ delta)
+    return out
+
+
+def canonical_key(inst):
+    """A strong affine-invariant signature of the spectrum's sign function.
+
+    Second derivatives are unchanged by affine output terms, while an invertible
+    affine relabelling merely permutes their directions.  Per-direction weight
+    histograms are sorted before hashing.  This is a strong cheap invariant, not a
+    complete affine-isomorphism algorithm.
+    """
+    spectrum = inst["spectrum"]
+    size = len(spectrum)
+    if size == 0 or size & (size - 1):
+        raise ValueError("spectrum length must be a nonzero power of two")
+    mask = 0
+    for u, value in enumerate(spectrum):
+        if value < 0:
+            mask |= 1 << u
+    translated = [_translated_bitmask(mask, d, size) for d in range(size)]
+    base = translated[0]
+    row_digests = []
+    for a in range(1, size):
+        ta = translated[a]
+        hist = Counter(
+            (base ^ ta ^ translated[b] ^ translated[a ^ b]).bit_count()
+            for b in range(size)
+        )
+        payload = repr(sorted(hist.items())).encode("ascii")
+        row_digests.append(hashlib.sha256(payload).digest())
+    row_digests.sort()
+    digest = hashlib.sha256(
+        str(inst["n"]).encode("ascii") + b"|" + b"".join(row_digests)
+    ).hexdigest()
+    return f"affine-d2-v1:{inst['n']}:{digest}"
+
+
+def escalate(params):
+    n = int(params.get("n", 0))
+    if n >= 10:
+        return None
+    return {"n": n + 2}
+
+
+def _fwht_in_place(values):
+    length = 1
+    operations = 0
+    while length < len(values):
+        for start in range(0, len(values), 2 * length):
+            for j in range(start, start + length):
+                left, right = values[j], values[j + length]
+                values[j] = left + right
+                values[j + length] = left - right
+                operations += 2
+        length *= 2
+    return operations
+
+
+def _reference_recover(inst):
+    """Domain-standard full inverse transform, with an exact operation count."""
+    n = inst["n"]
+    m = n // 2
+    q = 1 << m
+    size = 1 << n
+    values = list(inst["spectrum"])
+    operations = _fwht_in_place(values)
+    truth = []
+    for value in values:
+        if value not in (-size, size):
+            return None, operations
+        truth.append(0 if value == size else 1)
+        operations += 1  # exact normalization/sign decision
+    pi = [0] * q
+    bits = [0] * q
+    for y in range(q):
+        bits[y] = truth[y]
+        for j in range(m):
+            pi[y] |= (truth[((1 << j) << m) | y] ^ bits[y]) << j
+            operations += 1
+    return _answer_object(pi, bits), operations
+
+
+def _compact_recover(inst):
+    """The intended row-character route (not an adversary: it should succeed)."""
+    m = inst["n"] // 2
+    q = 1 << m
+    spectrum = inst["spectrum"]
+    pi = [-1] * q
+    bits = [0] * q
+    operations = 0
+    for a in range(q):
+        base = spectrum[a * q]
+        y = 0
+        for j in range(m):
+            if spectrum[a * q + (1 << j)] != base:
+                y |= 1 << j
+            operations += 1
+        pi[y] = a
+        bits[y] = 1 if base < 0 else 0
+        operations += 1
+    return _answer_object(pi, bits), operations
+
+
+def _offset_for_candidate_pi(inst, pi):
+    q = len(pi)
+    spectrum = inst["spectrum"]
+    bits = [1 if spectrum[a * q] < 0 else 0 for a in pi]
+    return _answer_object(pi, bits)
+
+
+def _attack_identity(inst):
+    q = 1 << (inst["n"] // 2)
+    return _offset_for_candidate_pi(inst, list(range(q)))
+
+
+def _attack_outlier_row_counts(inst):
+    """Use only row sign counts; these reveal y=0 but no other hidden labels."""
+    q = 1 << (inst["n"] // 2)
+    spectrum = inst["spectrum"]
+    constant_rows = []
+    for a in range(q):
+        row = spectrum[a * q : (a + 1) * q]
+        positives = sum(value > 0 for value in row)
+        if positives in (0, q):
+            constant_rows.append(a)
+    a_zero = constant_rows[0] if len(constant_rows) == 1 else 0
+    remaining = [a for a in range(q) if a != a_zero]
+    pi = [a_zero] + remaining
+    return _offset_for_candidate_pi(inst, pi)
+
+
+def _attack_greedy_row_order(inst):
+    """Assign rows greedily by public order and use b=0 to choose each offset."""
+    q = 1 << (inst["n"] // 2)
+    order = list(inst.get("row_order", range(q)))
+    pi = order[:q]
+    return _offset_for_candidate_pi(inst, pi)
+
+
+def _attack_affine_ansatz(inst):
+    """Recover basis values, then extrapolate the obvious affine permutation ansatz."""
+    recovered, _ = _compact_recover(inst)
+    actual = recovered["permutation"]
+    m = inst["n"] // 2
+    q = 1 << m
+    base = actual[0]
+    columns = [actual[1 << j] ^ base for j in range(m)]
+    pi = []
+    for y in range(q):
+        value = base
+        for j in range(m):
+            if (y >> j) & 1:
+                value ^= columns[j]
+        pi.append(value)
+    if len(set(pi)) != q:
+        pi = list(range(q))
+    return _offset_for_candidate_pi(inst, pi)
+
+
+def _random_restart_attack(inst, restarts, rng):
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate
+    return None
+
+
+def _permute_bits(value, permutation):
+    out = 0
+    for target, source in enumerate(permutation):
+        if (value >> source) & 1:
+            out |= 1 << target
+    return out
+
+
+def _affine_relabel(inst, answer, rng):
+    """Carry a witness through split-preserving affine coordinate relabellings."""
+    n = inst["n"]
+    m = n // 2
+    q = 1 << m
+    pi_old = answer["permutation"]
+    bits_old = [int(c) for c in answer["offset_bits"]]
+    px = list(range(m))
+    py = list(range(m))
+    rng.shuffle(px)
+    rng.shuffle(py)
+    tx = rng.randrange(q)
+    ty = rng.randrange(q)
+    complement = rng.randrange(2)
+    pi_new = [0] * q
+    bits_new = [0] * q
+    for y_new in range(q):
+        y_old = _permute_bits(y_new, py) ^ ty
+        old_value = pi_old[y_old]
+        new_value = 0
+        for j in range(m):
+            if _parity(_permute_bits(1 << j, px) & old_value):
+                new_value |= 1 << j
+        pi_new[y_new] = new_value
+        bits_new[y_new] = bits_old[y_old] ^ _parity(tx & old_value) ^ complement
+    transformed = _instance_from_representation(n, pi_new, bits_new, rng.randrange(1 << 30))
+    transformed["row_order"].reverse()  # compose with a pure presentation reordering
+    return transformed, transformed["answer"]
+
+
+def _measure_reference(inst, repeats=5):
+    elapsed = []
+    answer = None
+    operations = 0
+    for _ in range(repeats):
+        start = time.perf_counter()
+        answer, operations = _reference_recover(inst)
+        elapsed.append(time.perf_counter() - start)
+    return answer, operations, sum(elapsed) / len(elapsed)
+
+
+def selftest():
+    report = {}
+    preset_checks = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            preset_checks += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": why})
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append(
+                    {"preset": preset, "seed": seed, "reason": "answer is not JSON-native"}
+                )
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "instances_checked": preset_checks,
+        "failures": g1_failures,
+    }
+
+    ship = make_instance(seed=20260904, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = ship["answer"]
+    pi = planted["permutation"]
+    corruptions = {}
+    candidates = {
+        "drop_one": {**planted, "permutation": pi[:-1]},
+        "swap_two": {**planted, "permutation": [pi[1], pi[0]] + pi[2:]},
+        "duplicate_one": {**planted, "permutation": [pi[1], pi[1]] + pi[2:]},
+        "empty": {},
+        "out_of_range": {**planted, "permutation": [len(pi)] + pi[1:]},
+    }
+    for name, candidate in candidates.items():
+        ok, why = verify(ship, candidate)
+        corruptions[name] = {"rejected": not ok, "reason": why}
+    reasons = [entry["reason"] for entry in corruptions.values()]
+    report["G2_rejects_corruption"] = {
+        "pass": all(entry["rejected"] for entry in corruptions.values())
+        and len(set(reasons)) == len(reasons),
+        "corruptions": corruptions,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    response = (
+        "I used the row signs to identify the characters.\n```json\n<answer>"
+        + _answer_json(planted)
+        + "</answer>\n```\nThe object above is my final answer."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("not an answer") is None,
+        "model_style_response_parsed": parsed == planted,
+        "garbage_returns_none": parse_answer("not an answer") is None,
+    }
+
+    guess_rng = random.Random(7102026)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        if verify(ship, random_candidate(ship, guess_rng))[0]:
+            guess_hits += 1
+    exact_probability = 1.0 / search_space(ship)
+    report["G4_guess_resistance"] = {
+        "pass": guess_total >= 200_000
+        and guess_hits / guess_total < 1e-6
+        and exact_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_hits / guess_total,
+        "exact_probability_from_invertibility": exact_probability,
+        "candidate_space": search_space(ship),
+    }
+
+    attack_rng = random.Random(991827)
+    start = time.perf_counter()
+    restart_answer = _random_restart_attack(ship, 256, attack_rng)
+    restart_wall = time.perf_counter() - start
+    reference_answer, reference_operations, reference_wall = _measure_reference(ship)
+    reference_ok = reference_answer is not None and verify(ship, reference_answer)[0]
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_total >= 200_000
+        and guess_hits / guess_total < 1e-6
+        and restart_answer is None
+        and reference_ok,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_density_fraction": guess_hits / guess_total,
+        "demo_exact_valid_answer_count": enumerate_all(
+            make_instance(seed=0, **DIFFICULTY["demo"])
+        ),
+        "baseline_random_restart_wall_seconds": restart_wall,
+        "baseline_random_restart_steps": 256,
+        "reference_wall_seconds": reference_wall,
+        "reference_operations": reference_operations,
+    }
+
+    attack_functions = {
+        "outlier_row_sign_count": _attack_outlier_row_counts,
+        "greedy_public_row_order": _attack_greedy_row_order,
+        "random_restart_256": None,
+        "affine_ansatz_from_basis": _attack_affine_ansatz,
+    }
+    attack_results = {
+        name: {"successes": 0, "attempts": 8} for name in attack_functions
+    }
+    reference_successes = 0
+    reference_walls = []
+    for seed in range(8100, 8108):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        for name, function in attack_functions.items():
+            if function is None:
+                answer = _random_restart_attack(
+                    inst, 256, random.Random(900_000 + seed)
+                )
+            else:
+                answer = function(inst)
+            if answer is not None and verify(inst, answer)[0]:
+                attack_results[name]["successes"] += 1
+        ref, ops, wall = _measure_reference(inst, repeats=1)
+        reference_walls.append(wall)
+        if ref is not None and verify(inst, ref)[0]:
+            reference_successes += 1
+    all_attacks_failed = all(v["successes"] == 0 for v in attack_results.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and reference_successes == 8,
+        "attacks": attack_results,
+        "reference_algorithm": {
+            "name": "inverse fast Walsh-Hadamard transform plus MM parameter extraction",
+            "complexity": "O(n*2^n) exact",
+            "wall_clock_sec": sum(reference_walls) / len(reference_walls),
+            "operations": reference_operations,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    doubled_n = 2 * DIFFICULTY[SHIPPING_DIFFICULTY]["n"]
+    doubled = make_instance(n=doubled_n, seed=333)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    spectrum_sizes = [1 << params["n"] for params in DIFFICULTY.values()]
+    report["G7_scales"] = {
+        "pass": spectrum_sizes == sorted(spectrum_sizes)
+        and len(set(spectrum_sizes)) == len(spectrum_sizes)
+        and doubled_ok,
+        "preset_spectrum_sizes": spectrum_sizes,
+        "doubled_n": doubled_n,
+        "doubled_spectrum_size": len(doubled["spectrum"]),
+        "doubled_verification": doubled_why,
+    }
+
+    invariance = 0
+    carried_valid = 0
+    keys = []
+    for seed in range(20):
+        inst = make_instance(seed=12_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(inst)
+        keys.append(key)
+        transformed, carried = _affine_relabel(
+            inst, inst["answer"], random.Random(44_000 + seed)
+        )
+        if canonical_key(transformed) == key:
+            invariance += 1
+        if verify(transformed, carried)[0]:
+            carried_valid += 1
+    distinct = len(set(keys))
+    report["G8_canonical_key"] = {
+        "pass": invariance == 20 and carried_valid == 20 and distinct == 20,
+        "invariant_relabellings": invariance,
+        "relabelled_witnesses_valid": carried_valid,
+        "distinct_unrelated_keys": distinct,
+        "unrelated_instances": 20,
+        "invariant_type": "sorted per-direction second-derivative weight histograms",
+    }
+
+    answer_text = _answer_json(planted)
+    answer_chars = len(answer_text)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = len(pi) + len(planted["offset_bits"])
+    _, compact_operations = _compact_recover(ship)
+    bare = G9_EVIDENCE["bare"]
+    hinted = G9_EVIDENCE["hinted"]
+    placebo = G9_EVIDENCE["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = (
+        placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    )
+    evidence_complete = all(
+        G9_EVIDENCE[arm]["attempts"] >= 3 for arm in ("bare", "hinted", "placebo")
+    )
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and compact_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": evidence_complete
+        and G9_EVIDENCE["hinted_verdict"] == "hardened"
+        and within_caps,
+        "arms": {
+            "bare": dict(bare),
+            "hinted": dict(hinted),
+            "placebo": dict(placebo),
+        },
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_EVIDENCE["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": compact_operations,
+        "within_caps": within_caps,
+        "evidence_complete": evidence_complete,
+    }
+
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    report["all_passed"] = all(
+        value.get("pass", False)
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

