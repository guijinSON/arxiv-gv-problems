+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 2, "degree": 7},
+    "easy": {"n": 7, "degree": 97},
+    "medium": {"n": 11, "degree": 97},
+    "hard": {"n": 15, "degree": 97},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "One 1-by-d normalized homogeneous-coordinate matrix over GF(q): "
+        "all d entries are integers in [0,q-1], the row is nonzero, and its "
