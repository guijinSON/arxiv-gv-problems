    # Theorem-2.3 chain start is e_2.  Apply A=B^{-1}, using the displayed
    # finite geometric identity rather than solving the resulting equations.
    point = _inverse_binomial_on_basis(degree, q, a, step, 2)
    point = _normalize(point, q)
    assert point is not None

    return {
        "schema": "zz-lp-vertex-chain-v1",
        "size_bits": n,
        "q": q,
        "extension_degree": degree,
        "delta": delta,
        "delta_norm": delta_norm,
        "equations": [row_zero, equation_two],
        "answer": {"point": [point]},
    }


