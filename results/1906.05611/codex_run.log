from random import Random

def prime(v):
 def isp(n):
  if n<2:return False
  i=2
  while i*i<=n:
   if n%i==0:return False
   i+=1
  return True
 while not isp(v): v+=1
 return v

def findq(bits,d):
 k=max(1,((1<<bits)-1+d-1)//d)
 while True:
  q=1+k*d
  if prime(q):return q
  k+=1

def inst(bits,d,seed):
 q=findq(bits,d); rng=Random(seed)
 exp=(q-1)//d
 while True:
  h=rng.randrange(2,q)
