+def _complete_gamma_point(
+        inst: dict, free: list[int], pivots: tuple[int, int],
+        values: list[int]) -> list[int]:
+    """Complete free coordinates to the unique vector in Gamma."""
+    q = inst["q"]
+    equations = inst["equations"]
+    first, second = pivots
