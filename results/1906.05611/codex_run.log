echo "== emitting sample instances =="
bash scripts/emit.sh "$ID" "${EMIT_N:-20}" || { echo "SUBMIT BLOCKED — emit failed."; exit 5; }

# emit.sh already resamples past duplicates; this re-checks the file it produced,
