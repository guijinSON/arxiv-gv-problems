    r"\bvert(?:ex|ices)\b", r"\bconflict", r"\bcliques?\b",
    r"\b(?:sub|multi|di|hyper)?graphs?\b", r"\binciden(?:t|ce)\b",
    r"\bdegree of (?:a |the )?(?:vertex|vertices|node|nodes)\b",
)
try:
