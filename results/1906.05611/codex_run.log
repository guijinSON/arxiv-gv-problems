+        "pass": (invariant_checks == 60 and carried_verifications == 60 and
+                 len(set(distinct_keys)) == 20),
+        "invariance_checks": invariant_checks,
+        "invariance_passed": 60 if invariant_checks == 60 else None,
+        "carried_witness_verifications": carried_verifications,
+        "unrelated_instances": 20,
+        "distinct_keys": len(set(distinct_keys)),
+        "transformations": [
+            "cyclic coordinate relabelling",
+            "invertible equation-basis change with row reordering/scaling",
+            "composition of both",
+        ],
