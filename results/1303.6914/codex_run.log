+
+NOTES: str = r"""
+Definition 2.1 fixes identifiability as uniqueness of a sum of k simple
+tensors.  Lemma 3.2 places eight general Segre points on a (3,1,1)
+Segre-Veronese fourfold, Lemma 3.3 uses an ancillary Macaulay2 calculation to
+show that its tangential projection has a six-point reduced fibre, and Theorem
+3.5 concludes that a general rank-eight tensor in C^3 tensor C^6 tensor C^6 has
+at least six decompositions.  Remark 3.7 explicitly says the paper cannot prove
+that six is the exact number.  Corollary 3.8 restates the phenomenon as multiple
+rank-one spanning sets for a matrix space.
+
+That theorem is existential and does not hand a generator alternate
+decompositions.  Merely summing eight sampled simple tensors would know only
+one witness.  This module instead composes a finite-difference identity.  At
+n=6 it takes sixteen synchronized polynomial-curve points in exactly the
+paper's tensor space.  Every coordinate has degree at most 14, so the signed
+15th-difference coefficients give an exact dependence.  Its two sign classes
+contain eight terms each.  Random unimodular changes of basis obscure the
+coordinate curves without changing the certificate; the certificate is never
+obtained by solving the constructed instance.
+
+The Step-0 algorithm warning makes this Track B.  Flattening the displayed
+simple tensors and computing a nullspace by modular Gaussian elimination is a
+polynomial O(n^4) algorithm and succeeds on every generated instance.  The
+module runs and measures it under reference_algorithm.  The compact route only
+sorts the integer parameters and generates one binomial row by its recurrence.
+Outlier height, one-moment greedy cancellation, bounded random restarts, and the
+obvious alternating-linear ansatz are all tested separately and fail.  The
+matrices are changes of basis, so canonical_key deliberately ignores them and
+keys the exponent configuration and scale-normalized parameter set.
+""".strip()
+
+
+_REFERENCE_PRIME = 2_305_843_009_213_693_951  # 2^61-1
+_DENOMINATOR_BOUND = 7
+
+
+def _validate_params(n: int, mix_bound: int, mix_rounds: int) -> None:
+    for name, value in (("n", n), ("mix_bound", mix_bound), ("mix_rounds", mix_rounds)):
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise ValueError(f"{name} must be an integer")
+    if n < 3:
+        raise ValueError("n must be at least 3")
+    if mix_bound < 1:
+        raise ValueError("mix_bound must be positive")
+    if mix_rounds < 0:
+        raise ValueError("mix_rounds must be nonnegative")
+
+
+def _identity(size: int) -> list[list[int]]:
+    return [[int(i == j) for j in range(size)] for i in range(size)]
+
+
+def _unimodular_matrix(
+    size: int, rng: random.Random, bound: int, rounds: int
+) -> list[list[int]]:
+    """A deterministic-by-rng integer matrix of determinant +/-1."""
+    matrix = _identity(size)
+    if rounds == 0:
+        return matrix
+    for _ in range(rounds):
+        source = rng.randrange(size)
+        target = rng.randrange(size - 1)
+        if target >= source:
+            target += 1
+        coefficient = rng.randint(1, bound)
+        if rng.randrange(2):
+            coefficient = -coefficient
+        matrix[target] = [
+            x + coefficient * y
+            for x, y in zip(matrix[target], matrix[source])
+        ]
+    rng.shuffle(matrix)
+    for row in matrix:
+        if rng.randrange(2):
+            for j in range(size):
+                row[j] = -row[j]
+    return matrix
+
+
+def _left_multiply(first: list[list[int]], second: list[list[int]]) -> list[list[int]]:
+    return [
+        [sum(first[i][k] * second[k][j] for k in range(len(second)))
+         for j in range(len(second[0]))]
+        for i in range(len(first))
+    ]
+
+
+def _omission_orbits(n: int) -> list[tuple[int, int]]:
+    """Represent exponent-pair choices modulo reversal e -> n+1-e."""
+    limit = n + 1
+    representatives = set()
+    for first in range(1, n + 1):
+        for second in range(first + 1, n + 1):
+            pair = (first, second)
+            reverse = (limit - second, limit - first)
+            representatives.add(min(pair, reverse))
+    return sorted(representatives)
+
+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    mix_bound: int = 2,
+    mix_rounds: int | None = None,
+    **params,
+) -> dict:
+    """Construct a tensor dependence first, then disguise it by basis changes."""
+    if params:
+        raise ValueError("unknown parameters: " + ", ".join(sorted(params)))
+    if mix_rounds is None:
+        mix_rounds = 4 * n
+    _validate_params(n, mix_bound, mix_rounds)
+    rng = random.Random(seed)
+
+    term_count = 2 * n + 4
+    top_degree = term_count - 2
+    orbits = _omission_orbits(n)
+    omitted = orbits[seed % len(orbits)]
+    a_exponents = [0, 1, 2]
+    b_exponents = list(range(n))
+    c_exponents = [e for e in range(n + 2) if e not in omitted]
+
+    # Keep the smallest parameter first so the modular reference null vector can
+    # be normalized to an integer vector; shuffle every other tensor.
+    order = list(range(1, term_count))
+    rng.shuffle(order)
+    order.insert(0, 0)
+    nodes = [position + 1 for position in order]
+
+    maps = {
+        "a": _unimodular_matrix(3, rng, mix_bound, min(mix_rounds, 12)),
+        "b": _unimodular_matrix(n, rng, mix_bound, mix_rounds),
+        "c": _unimodular_matrix(n, rng, mix_bound, mix_rounds),
+    }
+    raw = [((-1) ** position) * math.comb(term_count - 1, position)
+           for position in order]
+    answer = [[coefficient, 1] for coefficient in raw]
+    height = math.comb(term_count - 1, (term_count - 1) // 2)
+    return {
+        "n": n,
+        "term_count": term_count,
+        "top_degree": top_degree,
+        "a_exponents": a_exponents,
+        "b_exponents": b_exponents,
+        "c_exponents": c_exponents,
+        "nodes": nodes,
+        "maps": maps,
+        "coefficient_bound": height,
+        "denominator_bound": _DENOMINATOR_BOUND,
+        "answer": answer,
+    }
+
+
+def _compact_json(value: object) -> str:
+    return json.dumps(value, separators=(",", ":"))
+
+
+def render(inst: dict) -> str:
+    n = inst["n"]
+    m = inst["term_count"]
+    statement = f"""Exact dependence among simple tensors
+
+All arithmetic is over the rational numbers Q.  For a list of exponents E and
+an integer t, define phi_E(t) to be the column vector [t^e for e in E], in the
+displayed exponent order.  Ordinary matrix-vector multiplication is used.
+
+Let
+  E_A = {_compact_json(inst['a_exponents'])}
+  E_B = {_compact_json(inst['b_exponents'])}
+  E_C = {_compact_json(inst['c_exponents'])}
+and let the three integer matrices be
+  M_A = {_compact_json(inst['maps']['a'])}
+  M_B = {_compact_json(inst['maps']['b'])}
+  M_C = {_compact_json(inst['maps']['c'])}
+
+For each displayed parameter t_i below, form
+  a_i = M_A phi_E_A(t_i) in Q^3,
+  b_i = M_B phi_E_B(t_i) in Q^{n},
+  c_i = M_C phi_E_C(t_i) in Q^{n},
+and the simple tensor T_i = a_i tensor b_i tensor c_i.  Its (r,s,u)
+coordinate is exactly a_i[r]*b_i[s]*c_i[u].  Indices i,r,s,u are all 0-based.
+
+The {m} parameters, in tensor-index order i=0,...,{m - 1}, are
+  t = {_compact_json(inst['nodes'])}
+
+Find exactly {m} pairwise-distinct nonzero rational coefficients lambda_i such
+that
+  sum_i lambda_i T_i = 0
+in Q^3 tensor Q^{n} tensor Q^{n}.  A rational is encoded as [p,q], meaning the
+reduced fraction p/q, with q>0.  Every coefficient must satisfy
+|p| <= {inst['coefficient_bound']} and 1 <= q <= {inst['denominator_bound']}.
+Order matters: coefficient i multiplies the displayed tensor T_i.  Repeated or
+zero coefficients are forbidden.  Any vector satisfying these conditions is
+accepted.  Positive and negative terms may equivalently be moved to opposite
+sides, giving two decompositions of one tensor into simple tensors.
+
+Give your final answer inside <answer></answer> tags as one JSON list of exactly
+{m} rational pairs [[p_0,q_0],...,[p_{m - 1},q_{m - 1}]].
+Example format: <answer>[[1,1],[-3,1],[3,1],[-1,1]]</answer>
+Whitespace inside the tags is allowed. Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: object) -> object | None:
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
+    candidates = list(reversed(matches))
+    candidates.append(text)
+    decoder = json.JSONDecoder()
+    for candidate in candidates:
+        cleaned = candidate.strip()
+        cleaned = re.sub(r"^```(?:json)?\s*", "", cleaned, flags=re.I)
+        cleaned = re.sub(r"\s*```$", "", cleaned)
+        try:
+            value = json.loads(cleaned)
+            if isinstance(value, list):
+                return value
+        except (TypeError, ValueError):
+            pass
+        for position, character in enumerate(cleaned):
+            if character != "[":
+                continue
+            try:
+                value, _end = decoder.raw_decode(cleaned[position:])
+            except ValueError:
+                continue
+            if isinstance(value, list):
+                return value
+    return None
+
+
+def _coefficient_data(inst: dict, answer: object) -> tuple[list[tuple[int, int]] | None, str]:
+    if not isinstance(answer, list):
+        return None, "answer must be a list"
+    if not answer:
+        return None, "answer must be a nonempty list"
+    if len(answer) != inst["term_count"]:
+        return None, f"expected {inst['term_count']} coefficients, received {len(answer)}"
+    coefficients: list[tuple[int, int]] = []
+    for index, item in enumerate(answer):
+        if not (isinstance(item, list) and len(item) == 2):
+            return None, f"coefficient {index} is not a [numerator,denominator] pair"
+        numerator, denominator = item
+        if (isinstance(numerator, bool) or isinstance(denominator, bool)
+                or not isinstance(numerator, int) or not isinstance(denominator, int)):
+            return None, f"coefficient {index} does not contain two integers"
+        if denominator <= 0:
+            return None, f"coefficient {index} has a nonpositive denominator"
+        if numerator == 0:
+            return None, f"coefficient {index} is zero"
+        if math.gcd(abs(numerator), denominator) != 1:
+            return None, f"coefficient {index} is not reduced"
+        if abs(numerator) > inst["coefficient_bound"]:
+            return None, f"coefficient {index} exceeds the numerator bound"
+        if denominator > inst["denominator_bound"]:
+            return None, f"coefficient {index} exceeds the denominator bound"
+        coefficients.append((numerator, denominator))
+    if len(set(coefficients)) != len(coefficients):
+        return None, "coefficients must be pairwise distinct"
+    return coefficients, "ok"
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    coefficients, reason = _coefficient_data(inst, answer)
+    if coefficients is None:
+        return False, reason
+    common = math.lcm(*range(1, inst["denominator_bound"] + 1))
+    nodes = inst["nodes"]
+    degrees = sorted({
+        ea + eb + ec
+        for ea in inst["a_exponents"]
+        for eb in inst["b_exponents"]
+        for ec in inst["c_exponents"]
+    })
+    for degree in degrees:
+        total = sum(
+            numerator * (common // denominator) * (node ** degree)
+            for (numerator, denominator), node in zip(coefficients, nodes)
+        )
+        if total:
+            return False, f"tensor-coordinate moment of degree {degree} is nonzero"
+    return True, "ok"
+
+
+def _coprime_numerators(height: int, denominator: int) -> int:
+    full, remainder = divmod(height, denominator)
+    residues = [r for r in range(1, denominator + 1) if math.gcd(r, denominator) == 1]
+    return full * len(residues) + sum(r <= remainder for r in residues)
+
+
+def _rational_population(inst: dict) -> int:
+    height = inst["coefficient_bound"]
+    positive = sum(
+        _coprime_numerators(height, denominator)
+        for denominator in range(1, inst["denominator_bound"] + 1)
+    )
+    return 2 * positive
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    height = inst["coefficient_bound"]
+    denominator_bound = inst["denominator_bound"]
+    used: set[tuple[int, int]] = set()
+    result = []
+    while len(result) < inst["term_count"]:
+        numerator = rng.randint(1, height)
+        denominator = rng.randint(1, denominator_bound)
+        if math.gcd(numerator, denominator) != 1:
+            continue
+        if rng.randrange(2):
+            numerator = -numerator
+        pair = (numerator, denominator)
+        if pair in used:
+            continue
+        used.add(pair)
+        result.append([numerator, denominator])
+    return result
+
+
+def search_space(inst: dict) -> int | None:
+    population = _rational_population(inst)
+    count = 1
+    for offset in range(inst["term_count"]):
+        count *= population - offset
+    return count
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space is None or space > 200_000:
+        return None
+    # No supported preset reaches this branch, but retain a hard cap by contract.
+    return None
+
+
+def _normalized_nodes(nodes: list[int]) -> list[list[int]]:
+    ordered = sorted(nodes)
+    scale = 0
+    for value in ordered:
+        scale = math.gcd(scale, abs(value))
+    if scale == 0:
+        scale = 1
+    return [[value // scale, 1] for value in ordered]
+
+
+def canonical_key(inst: dict) -> str:
+    """Invariant under column order, mode bases, and common node scaling."""
+    payload = {
+        "dimensions": [3, inst["n"], inst["n"]],
+        "a_exponents": sorted(inst["a_exponents"]),
+        "equal_mode_exponents": sorted([
+            sorted(inst["b_exponents"]),
+            sorted(inst["c_exponents"]),
+        ]),
+        "normalized_nodes": _normalized_nodes(inst["nodes"]),
+    }
+    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("ascii")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _predicted_answer_size(n: int) -> tuple[int, int]:
+    m = 2 * n + 4
+    answer = [[((-1) ** i) * math.comb(m - 1, i), 1] for i in range(m)]
+    return 2 * m, len(_compact_json(answer))
+
+
+def escalate(params: dict) -> dict | str | None:
+    values = {key: value for key, value in params.items() if key != "_preset"}
+    n = int(values["n"])
+    mix_bound = int(values.get("mix_bound", 2))
+    mix_rounds = int(values.get("mix_rounds", 4 * n))
+    # First increase disguise density and coefficient height at fixed answer length.
+    if mix_rounds < 8 * n:
+        values["mix_rounds"] = min(8 * n, max(mix_rounds + n, 2 * mix_rounds))
+        return values
+    if mix_bound < 8:
+        values["mix_bound"] = min(8, 2 * mix_bound)
+        return values
+    next_n = n + 2
+    atoms, chars = _predicted_answer_size(next_n)
+    operations = 2 * (2 * next_n + 3)
+    if atoms > 256 or chars > 2_000 or operations > 300:
+        return "cap_bound"
+    values.update({"n": next_n, "mix_rounds": 8 * next_n})
+    return values
+
+
+def _mode_values_mod(
+    matrix: list[list[int]], exponents: list[int], node: int, prime: int
+) -> tuple[list[int], int]:
+    powers = [1]
+    multiplications = 0
+    for _ in range(max(exponents)):
+        powers.append((powers[-1] * node) % prime)
+        multiplications += 1
+    basis = [powers[e] for e in exponents]
+    result = []
+    operations = multiplications
+    for row in matrix:
+        total = 0
+        for coefficient, value in zip(row, basis):
+            total = (total + coefficient * value) % prime
+            operations += 2
+        result.append(total)
+    return result, operations
+
+
+def _reference_nullspace(inst: dict) -> tuple[object | None, dict]:
+    """Flatten every tensor and perform row-streaming elimination modulo 2^61-1."""
+    started = time.perf_counter()
+    prime = _REFERENCE_PRIME
+    m = inst["term_count"]
+    factor_a, factor_b, factor_c = [], [], []
+    operations = 0
+    for node in inst["nodes"]:
+        a, count = _mode_values_mod(inst["maps"]["a"], inst["a_exponents"], node, prime)
+        operations += count
+        b, count = _mode_values_mod(inst["maps"]["b"], inst["b_exponents"], node, prime)
+        operations += count
+        c, count = _mode_values_mod(inst["maps"]["c"], inst["c_exponents"], node, prime)
+        operations += count
+        factor_a.append(a)
+        factor_b.append(b)
+        factor_c.append(c)
+
+    basis: dict[int, list[int]] = {}
+    rows_processed = 0
+    complete = False
+    for ia in range(3):
+        for ib in range(inst["n"]):
+            for ic in range(inst["n"]):
+                row = []
+                for column in range(m):
+                    value = factor_a[column][ia] * factor_b[column][ib] % prime
+                    value = value * factor_c[column][ic] % prime
+                    row.append(value)
+                    operations += 2
+                rows_processed += 1
+                for pivot in sorted(basis):
+                    factor = row[pivot]
+                    if not factor:
+                        continue
+                    pivot_row = basis[pivot]
+                    for j in range(pivot, m):
+                        row[j] = (row[j] - factor * pivot_row[j]) % prime
+                        operations += 2
+                pivot = next((j for j, value in enumerate(row) if value), None)
+                if pivot is None:
+                    continue
+                inverse = pow(row[pivot], prime - 2, prime)
+                for j in range(pivot, m):
+                    row[j] = row[j] * inverse % prime
+                    operations += 1
+                basis[pivot] = row
+                # A nonzero dependence is already unique when the row rank is
+                # m-1. A rank-revealing implementation need not reduce the
+                # remaining rows merely to rediscover that they are dependent.
+                if len(basis) == m - 1:
+                    complete = True
+                    break
+            if complete:
+                break
+        if complete:
+            break
+
+    if len(basis) != m - 1:
+        return None, {
+            "wall_clock_sec": time.perf_counter() - started,
+            "operations": operations,
+            "rows_processed": rows_processed,
+            "rank": len(basis),
+        }
+    free_columns = [j for j in range(m) if j not in basis]
+    if len(free_columns) != 1:
+        return None, {
+            "wall_clock_sec": time.perf_counter() - started,
+            "operations": operations,
+            "rows_processed": rows_processed,
+            "rank": len(basis),
+        }
+    vector = [0] * m
+    vector[free_columns[0]] = 1
+    for pivot in sorted(basis, reverse=True):
+        row = basis[pivot]
+        total = 0
+        for j in range(pivot + 1, m):
+            total = (total + row[j] * vector[j]) % prime
+            operations += 2
+        vector[pivot] = (-total) % prime
+    if vector[0] == 0:
+        return None, {
+            "wall_clock_sec": time.perf_counter() - started,
+            "operations": operations,
+            "rows_processed": rows_processed,
+            "rank": len(basis),
+        }
+    scale = pow(vector[0], prime - 2, prime)
+    vector = [(value * scale) % prime for value in vector]
+    operations += m
+    signed = [value - prime if value > prime // 2 else value for value in vector]
+    candidate = [[value, 1] for value in signed]
+    return candidate, {
+        "wall_clock_sec": time.perf_counter() - started,
+        "operations": operations,
+        "rows_processed": rows_processed,
+        "rank": len(basis),
+    }
+
+
+def _compact_finite_difference(inst: dict) -> tuple[object, dict]:
+    ordered = sorted(range(inst["term_count"]), key=lambda i: inst["nodes"][i])
+    top = inst["term_count"] - 1
+    coefficients = [1]
+    operations = 0
+    for index in range(top):
+        coefficients.append(-(coefficients[-1] * (top - index) // (index + 1)))
+        operations += 2
+    answer = [None] * inst["term_count"]
+    for rank, column in enumerate(ordered):
+        answer[column] = [coefficients[rank], 1]
+    return answer, {"operations": operations, "comparisons_not_counted": True}
+
+
+def _factor_height(inst: dict, column: int) -> int:
+    node = inst["nodes"][column]
+    height = 0
+    for name, exponents in (("a", inst["a_exponents"]),
+                            ("b", inst["b_exponents"]),
+                            ("c", inst["c_exponents"])):
+        basis = [node ** exponent for exponent in exponents]
+        values = [sum(x * y for x, y in zip(row, basis)) for row in inst["maps"][name]]
+        height += sum(abs(value) for value in values)
+    return height
+
+
+def _attack_outlier_height(inst: dict) -> object:
+    order = sorted(range(inst["term_count"]), key=lambda i: (_factor_height(inst, i), i))
+    coefficients = [None] * inst["term_count"]
+    for rank, column in enumerate(order):
+        value = rank + 1
+        if rank % 2:
+            value = -value
+        coefficients[column] = [value, 1]
+    return coefficients
+
+
+def _attack_greedy_first_moment(inst: dict) -> object:
+    values = list(range(1, inst["term_count"]))
+    values.append(-sum(values))
+    return [[value, 1] for value in values]
+
+
+def _attack_alternating_linear(inst: dict) -> object:
+    order = sorted(range(inst["term_count"]), key=lambda i: inst["nodes"][i])
+    coefficients = [None] * inst["term_count"]
+    for rank, column in enumerate(order):
+        value = rank + 1
+        if rank % 2:
+            value = -value
+        coefficients[column] = [value, 1]
+    return coefficients
+
+
+def _attack_random_restart(inst: dict, rng: random.Random, restarts: int = 256) -> object | None:
+    m = inst["term_count"]
+    for _ in range(restarts):
+        magnitudes = list(range(1, m + 1))
+        rng.shuffle(magnitudes)
+        candidate = [[value if rng.randrange(2) else -value, 1] for value in magnitudes]
+        if verify(inst, candidate)[0]:
+            return candidate
+    return None
+
+
+def _permute_columns(inst: dict, permutation: list[int]) -> dict:
+    transformed = copy.deepcopy(inst)
+    transformed["nodes"] = [inst["nodes"][i] for i in permutation]
+    transformed["answer"] = [inst["answer"][i] for i in permutation]
+    return transformed
+
+
+def _change_mode_bases(inst: dict, seed: int) -> dict:
+    transformed = copy.deepcopy(inst)
+    rng = random.Random(seed)
+    for name, size in (("a", 3), ("b", inst["n"]), ("c", inst["n"])):
+        change = _unimodular_matrix(size, rng, 2, 2 * size)
+        transformed["maps"][name] = _left_multiply(change, transformed["maps"][name])
+    return transformed
+
+
+def _scale_nodes(inst: dict, factor: int) -> dict:
+    transformed = copy.deepcopy(inst)
+    transformed["nodes"] = [factor * node for node in transformed["nodes"]]
+    return transformed
+
+
+def _swap_equal_modes(inst: dict) -> dict:
+    transformed = copy.deepcopy(inst)
+    transformed["b_exponents"], transformed["c_exponents"] = (
+        transformed["c_exponents"],
+        transformed["b_exponents"],
+    )
+    transformed["maps"]["b"], transformed["maps"]["c"] = (
+        transformed["maps"]["c"],
+        transformed["maps"]["b"],
+    )
+    return transformed
+
+
+def _answer_atoms(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def selftest() -> dict:
+    report: dict = {
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": DIFFICULTY[SHIPPING_DIFFICULTY],
+    }
+
+    planted_attempts = 0
+    json_attempts = 0
+    planted_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7):
+            inst = make_instance(seed=seed, **params)
+            planted_attempts += 1
+            ok, reason = verify(inst, inst["answer"])
+            if not ok:
+                planted_failures.append([preset, seed, reason])
+            json_attempts += 1
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                planted_failures.append([preset, seed, "answer is not JSON-native"])
+    report["G1_planted_verifies"] = {
+        "pass": not planted_failures,
+        "verified": planted_attempts - len(planted_failures),
+        "attempts": planted_attempts,
+        "json_roundtrips": json_attempts,
+        "failures": planted_failures,
+    }
+
+    shipping = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    corruptions = {}
+    empty = []
+    corruptions["empty"] = verify(shipping, empty)[1]
+    dropped = copy.deepcopy(shipping["answer"][:-1])
+    corruptions["dropped"] = verify(shipping, dropped)[1]
+    swapped = copy.deepcopy(shipping["answer"])
+    swapped[1], swapped[2] = swapped[2], swapped[1]
+    corruptions["swapped"] = verify(shipping, swapped)[1]
+    duplicated = copy.deepcopy(shipping["answer"])
+    duplicated[1] = duplicated[0]
+    corruptions["duplicated"] = verify(shipping, duplicated)[1]
+    out_of_range = copy.deepcopy(shipping["answer"])
+    out_of_range[0] = [shipping["coefficient_bound"] + 1, 1]
+    corruptions["out_of_range"] = verify(shipping, out_of_range)[1]
+    distinct_reasons = len(set(corruptions.values())) == len(corruptions)
+    all_rejected = all(not verify(
+        shipping,
+        {
+            "empty": empty,
+            "dropped": dropped,
+            "swapped": swapped,
+            "duplicated": duplicated,
+            "out_of_range": out_of_range,
+        }[name],
+    )[0] for name in corruptions)
+    report["G2_rejects_corruption"] = {
+        "pass": all_rejected and distinct_reasons,
+        "reasons": corruptions,
+        "distinct_reasons": len(set(corruptions.values())),
+    }
+
+    model_style = (
+        "The dependence is the following.\n```json\n<answer>\n"
+        + json.dumps(shipping["answer"])
+        + "\n</answer>\n```\nI used exact arithmetic."
+    )
+    parsed = parse_answer(model_style)
+    report["G3_round_trip"] = {
+        "pass": parsed == shipping["answer"] and parse_answer("not an answer") is None,
+        "model_style_roundtrip": parsed == shipping["answer"],
+        "garbage_returns_none": parse_answer("not an answer") is None,
+    }
+
+    guess_rng = random.Random(20260905)
+    guess_total = 200_000
+    guess_hits = 0
+    guess_started = time.perf_counter()
+    for _ in range(guess_total):
+        if verify(shipping, random_candidate(shipping, guess_rng))[0]:
+            guess_hits += 1
+    guess_elapsed = time.perf_counter() - guess_started
+    guess_probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "empirical_probability": guess_probability,
+        "structure_aware": True,
+        "candidate_space": search_space(shipping),
+        "wall_clock_sec": guess_elapsed,
+    }
+
+    reference_results = []
+    compact_results = []
+    attack_successes = {
+        "outlier_factor_height": 0,
+        "greedy_cancel_degree_zero": 0,
+        "random_restart_256": 0,
+        "in_context_alternating_linear": 0,
+    }
+    adversary_attempts = 8
+    for seed in range(adversary_attempts):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        reference_answer, reference_stats = _reference_nullspace(inst)
+        reference_ok = reference_answer is not None and verify(inst, reference_answer)[0]
+        reference_stats["verified"] = reference_ok
+        reference_results.append(reference_stats)
+        compact_answer, compact_stats = _compact_finite_difference(inst)
+        compact_ok = verify(inst, compact_answer)[0]
+        compact_stats["verified"] = compact_ok
+        compact_results.append(compact_stats)
+
+        if verify(inst, _attack_outlier_height(inst))[0]:
+            attack_successes["outlier_factor_height"] += 1
+        if verify(inst, _attack_greedy_first_moment(inst))[0]:
+            attack_successes["greedy_cancel_degree_zero"] += 1
+        if _attack_random_restart(inst, random.Random(9000 + seed)) is not None:
+            attack_successes["random_restart_256"] += 1
+        if verify(inst, _attack_alternating_linear(inst))[0]:
+            attack_successes["in_context_alternating_linear"] += 1
+
+    median_reference_wall = statistics.median(
+        result["wall_clock_sec"] for result in reference_results
+    )
+    median_reference_operations = int(statistics.median(
+        result["operations"] for result in reference_results
+    ))
+    report["G5_density_and_baseline"] = {
+        "pass": guess_hits == 0 and all(result["verified"] for result in reference_results),
+        "shipping_valid_hits": guess_hits,
+        "shipping_density_samples": guess_total,
+        "shipping_density_estimate": guess_probability,
+        "baseline_wall_clock_sec": median_reference_wall,
+        "baseline_operations": median_reference_operations,
+        "baseline_rows": int(statistics.median(
+            result["rows_processed"] for result in reference_results
+        )),
+    }
+
+    attacks = {
+        name: {"successes": successes, "attempts": adversary_attempts}
+        for name, successes in attack_successes.items()
+    }
+    report["G6_adversary_panel"] = {
+        "pass": (
+            all(result["successes"] == 0 for result in attacks.values())
+            and all(result["verified"] for result in reference_results)
+            and all(result["verified"] for result in compact_results)
+        ),
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "dense tensor flattening plus modular Gaussian elimination",
+            "complexity": "O(n^4) field operations for 3*n^2 rows and 2*n+4 columns",
+            "wall_clock_sec_median": median_reference_wall,
+            "operations_median": median_reference_operations,
+            "solves": f"{sum(result['verified'] for result in reference_results)}/{adversary_attempts}, as expected",
+        },
+        "compact_route": {
+            "name": "finite-difference binomial recurrence",
+            "operations": int(statistics.median(
+                result["operations"] for result in compact_results
+            )),
+            "solves": f"{sum(result['verified'] for result in compact_results)}/{adversary_attempts}",
+        },
+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=2718, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["term_count"] > shipping["term_count"],
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "shipping_flatten_rows": 3 * shipping["n"] ** 2,
+        "doubled_flatten_rows": 3 * doubled["n"] ** 2,
+        "shipping_terms": shipping["term_count"],
+        "doubled_terms": doubled["term_count"],
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    witness_checks = 0
+    invariant_failures = []
+    for seed in range(20):
+        inst = make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        original_key = canonical_key(inst)
+        permutation = list(reversed(range(inst["term_count"])))
+        reordered = _permute_columns(inst, permutation)
+        changed = _change_mode_bases(inst, 100_000 + seed)
+        scaled = _scale_nodes(inst, 3)
+        swapped = _swap_equal_modes(inst)
+        composed = _swap_equal_modes(
+            _scale_nodes(_change_mode_bases(reordered, 200_000 + seed), 3)
+        )
+        for label, transformed in (
+            ("reordered", reordered),
+            ("basis", changed),
+            ("scaled", scaled),
+            ("equal_mode_swap", swapped),
+            ("composed", composed),
+        ):
+            invariance_checks += 1
+            if canonical_key(transformed) != original_key:
+                invariant_failures.append([seed, label, "key changed"])
+            witness_checks += 1
+            ok, reason = verify(transformed, transformed["answer"])
+            if not ok:
+                invariant_failures.append([seed, label, reason])
+    unrelated_keys = {
+        canonical_key(make_instance(seed=1000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY]))
+        for seed in range(20)
+    }
+    report["G8_canonical_key"] = {
+        "pass": not invariant_failures and len(unrelated_keys) == 20,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": witness_checks,
+        "distinct_unrelated_keys": len(unrelated_keys),
+        "unrelated_attempts": 20,
+        "failures": invariant_failures,
+    }
+
+    answer_blob = _compact_json(shipping["answer"])
+    answer_chars = len(answer_blob)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = _answer_atoms(shipping["answer"])
+    intended_operations = 2 * (shipping["term_count"] - 1)
+    within_caps = (
+        answer_chars <= 2_000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    arms = copy.deepcopy(G9_EVIDENCE["arms"])
+    hinted_attempts = arms["hinted"]["attempts"]
+    placebo_attempts = arms["placebo"]["attempts"]
+    if hinted_attempts and placebo_attempts:
+        hinted_minus_placebo = (
+            arms["hinted"]["solved"] / hinted_attempts
+            - arms["placebo"]["solved"] / placebo_attempts
+        )
+    else:
+        hinted_minus_placebo = None
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_minus_placebo,
+        "hinted_verdict": G9_EVIDENCE["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2_000, "elements": 256, "operations": 300},
+    }
+
+    report["all_passed"] = all(
+        value.get("pass") is True
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2))

