+def _attack_greedy_first_moment(inst):
+    columns = sorted(range(inst["term_count"]), key=lambda i: (-abs(inst["nodes"][i]), i))
+    available = [(sign, q) for q in range(1, inst["rank"] + 1) for sign in (1, -1)]
