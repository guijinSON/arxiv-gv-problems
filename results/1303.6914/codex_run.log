+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Every coordinate of the indexed simple tensors is a polynomial of "
+        "bounded degree, so one finite-difference functional annihilates all "
+        "coordinates at once; without that invariant one flattens a large dense "
+        "tensor matrix and computes its exact nullspace."
+    ),
+    "hardness_basis": (
+        "Track B: dense tensor flattening followed by modular Gaussian elimination "
+        "is an O(n^4) exact reference algorithm; at the shipping n=24 preset the "
+        "measured median is 1,719,617 field operations and 0.401 seconds over "
+        "eight seeds, whereas the finite-difference route uses 102 exact "
+        "arithmetic operations."
+    ),
+    "max_answer_tokens": 211,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "An ordered vector of m=2n+4 pairwise-distinct, nonzero reduced rationals "
+        "lambda_i=[numerator,denominator]. Each numerator has absolute value at "
+        "most H=binomial(2n+3,n+1), and each positive denominator is at most 7."
+    ),
+    "bounds": {
+        "length": "2*n+4",
+        "max_abs_numerator": "binomial(2*n+3,n+1)",
+        "max_denominator": 7,
+        "nonzero": True,
+        "pairwise_distinct": True,
+        "reduced": True,
+    },
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "mix_bound": 1, "mix_rounds": 0},
+    "easy": {"n": 6, "mix_bound": 1, "mix_rounds": 12},
+    "medium": {"n": 14, "mix_bound": 2, "mix_rounds": 42},
+    "hard": {"n": 24, "mix_bound": 2, "mix_rounds": 96},
+}
+
+SHIPPING_DIFFICULTY: str = "hard"
+
+STRUCTURAL_HINT: str = (
+    "A common finite-difference functional annihilates every tensor-coordinate polynomial below its degree threshold."
+)
+PLACEBO_HINT: str = (
+    "Careful tracking of the displayed order and rational signs helps avoid routine transcription errors."
+)
