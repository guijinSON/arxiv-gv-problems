os.environ['GV_HINT_MODE']='placebo'; placebo=g.render(i)
assert 'Hint:' not in plain and g.STRUCTURAL_HINT in structural and g.PLACEBO_HINT in placebo
print('independent tensor expansion, determinism, round-trip, hint modes: ok')
print('module bytes',os.path.getsize('gen_1303_6914.py'),'render chars',len(plain))
