for seed in (0,1,42,4242,4243):
 p=g.DIFFICULTY['hard']; a=g.make_instance(seed=seed,**p); b=g.make_instance(seed=seed,**p)
 assert a==b and g.canonical_key(a)==g.canonical_key(b)
 assert json.loads(json.dumps(a['answer']))==a['answer']
 assert g.parse_answer('prose <answer>'+json.dumps(a['answer'])+'</answer> tail')==a['answer']
assert g.canonical_key(g.make_instance(seed=4242,**g.DIFFICULTY['hard'])) "'!= g.canonical_key(g.make_instance(seed=4243,**g.DIFFICULTY['"'hard']))
