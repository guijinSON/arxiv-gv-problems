i=g.make_instance(seed=17,**g.DIFFICULTY['hard'])
f={name:[] for name in 'abc'}
for t in i['nodes']:
 for name in 'abc': f[name].append(g._mode_values(i['maps'][name],i[name+'_exponents'],t)[0])
for ia in range(3):
 for ib in range(i['dimension']):
  for ic in range(i['dimension']):
   total=sum(Fraction(s,q)*f['a'][j][ia]*f['b'][j][ib]*f['c'][j][ic] for j,(s,q) in enumerate(i['answer']))
   assert total==0
