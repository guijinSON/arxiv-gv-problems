from fractions import Fraction
import gen_1303_6914 as g

def direct(inst, answer):
    vals = {k: [] for k in 'abc'}
    for t in inst['nodes']:
        for k in 'abc':
            basis=[t**e for e in inst[k+'_exponents']]
            vals[k].append([sum(x*y for x,y in zip(row,basis)) for row in inst['maps'][k]])
    coeff=[Fraction(s,q) for s,q in answer]
    for i in range(3):
      for j in range(inst['dimension']):
       for k in range(inst['dimension']):
        z=sum(coeff[c]*vals['a'][c][i]*vals['b'][c][j]*vals['c'][c][k] for c in range(inst['term_count']))
        if z: return False,(i,j,k,z)
    return True,None

for preset,params in g.DIFFICULTY.items():
  for seed in (0,1,7,314159):
    a=g.make_instance(seed=seed,**params)
    b=g.make_instance(seed=seed,**params)
    assert a==b
    ok,why=direct(a,a['answer'])
    assert ok,(preset,seed,why)
    ref,stats=g._reference_nullspace(a)
    assert ref is not None and g.verify(a,ref)[0]
print('direct tensor coordinates: 16/16 valid')
print('deterministic generation: 16/16 byte-equivalent objects')
print('reference nullspace: 16/16 valid')
