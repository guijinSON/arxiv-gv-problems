+        "exact coefficient comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Every coordinate of the indexed simple tensors is a polynomial of "
+        "bounded degree, so one finite-difference functional annihilates all "
+        "coordinates at once; without that invariant one flattens a large dense "
+        "tensor matrix and computes its exact nullspace."
+    ),
+    "hardness_basis": (
+        "Track B: dense tensor flattening followed by modular Gaussian elimination "
+        "is an O(n^4) exact reference algorithm; at the shipping n=24 preset the "
+        "measured median is 1,719,617 field operations and 0.193 seconds over "
+        "eight seeds, whereas the finite-difference route uses 102 exact "
+        "arithmetic operations."
+    ),
+    "max_answer_tokens": 211,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE: dict = {
