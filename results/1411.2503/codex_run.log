    c & = &[(aa^2)\alpha]\alpha - (aa^2)\beta +a(ab) +a(ba) + ab^2 -(ba^2)\alpha \\
    d & = &[(aa^2)\alpha]\beta -(ba^2)\beta +b(ab) +b(ba) + bb^2. 
