+
+def search_space(inst) -> int | None:
+    n = inst["n"]
+    h = inst["coefficient_height_bound"]
+    encodings_per_entry = (2 * h + 1) * h
+    # Exclude matrices whose every numerator is zero (denominators still vary).
+    return encodings_per_entry ** (n * n) - h ** (n * n)
