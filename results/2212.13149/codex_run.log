+    n0 = [[_ZERO for _ in range(n)] for _ in range(n)]
+    x0 = [[_ZERO for _ in range(n)] for _ in range(n)]
+    for k, sign in enumerate(signs):
+        i = 2 * k
+        a = sign * q
