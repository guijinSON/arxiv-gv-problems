+                return False, f"first identity fails at ({i},{j})"
+    for i in range(n):
+        for j in range(n):
+            if _triple_entry(x, b, x, i, j) != _triple_entry(a, x, a, i, j):
+                return False, f"second identity fails at ({i},{j})"
