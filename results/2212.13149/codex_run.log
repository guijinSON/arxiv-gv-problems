/bin/bash -lc "python3 - <<'PY'
import random,time,statistics

def eye(n): return [[int(i==j) for j in range(n)] for i in range(n)]
def mm(a,b):
    n=len(a); return [[sum(a[i][k]*b[k][j] for k in range(n)) for j in range(n)] for i in range(n)]
def add_conj(M,p,q,c):
    # E M E"'^-1, E=I+c e_pq. Row p += c row q; col q -= c col p (after row op).
    N=[r[:] for r in M]
    for j in range(len(M)): N[p][j] += c*N[q][j]
    for i in range(len(M)): N[i][q] -= c*N[i][p]
    return N

def instance(n,seed):
    m=n//2
    A=[[int(i==j and i<m) for j in range(n)] for i in range(n)]
    B=[[int(i==j and i>=m) for j in range(n)] for i in range(n)]
    rng=random.Random(seed)
    for _ in range(5*n):
        p,q=rng.sample(range(n),2); c=rng.choice((-2,-1,1,2))
        A=add_conj(A,p,q,c); B=add_conj(B,p,q,c)
    return A,B

def attack(A,B):
    n=len(A); comps=0
    ci=None
    for j in range(n):
        comps+=n
        if any(A[i][j] for i in range(n)):
            ci=j; break
    rj=None
    for i in range(n):
        comps+=n
        if any(B[i][j] for j in range(n)):
