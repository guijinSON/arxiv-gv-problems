+    report["G1_planted_verifies"] = {
+        "pass": planted == total, "verified": planted, "attempts": total,
+    }
+
+    shipping = make_instance(seed=314159, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    base = json.loads(json.dumps(shipping["answer"]))
