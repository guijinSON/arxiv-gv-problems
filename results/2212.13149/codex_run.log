+        "numerator_height_bound": _HEIGHT_BOUND,
+        "denominator_bound": _DENOMINATOR_BOUND,
+        "A": _to_json_matrix(a),
+        "B": _to_json_matrix(b),
+        "answer": answer,
+    }
