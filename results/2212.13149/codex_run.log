+def _attack_linear_combo(inst, rng, attempts=256):
+    n = inst["n"]
+    a = _from_json_matrix(inst["A"], n, _HEIGHT_BOUND, "A")
+    b = _from_json_matrix(inst["B"], n, _HEIGHT_BOUND, "B")
+    best = None
+    best_score = None
+    for _ in range(attempts):
