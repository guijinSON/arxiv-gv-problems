+def _householder(n, rng):
+    """A dense exact rational orthogonal involution."""
+    while True:
+        v = [rng.choice((-3, -2, -1, 1, 2, 3)) for _ in range(n)]
+        s = sum(x * x for x in v)
+        p = [[Fraction(int(i == j)) - Fraction(2 * v[i] * v[j], s)
