        if not any(values):
            continue
        g = 0
        for value in values:
            g = math.gcd(g, abs(value))
        if g != 1:
            continue
        if next(value for value in values if value) < 0:
            values = [-value for value in values]
        return {"coefficients": values}


def _mobius(k):
    if k == 1:
        return 1
