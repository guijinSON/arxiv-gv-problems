+    found = False
+    for i in range(shipping["n"]):
+        for j in range(shipping["n"] - 1):
+            if swapped[i][j] != swapped[i][j + 1]:
+                swapped[i][j], swapped[i][j + 1] = swapped[i][j + 1], swapped[i][j]
+                found = True
+                break
+        if found:
+            break
+    duplicate = json.loads(json.dumps(base))
+    duplicate[0].append(duplicate[0][-1])
