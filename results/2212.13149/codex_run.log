+def _matmul_counted(a, b, counter):
+    bt = _transpose(b)
+    out = []
+    for row in a:
+        new = []
+        for col in bt:
+            total = _ZERO
+            for x, y in zip(row, col):
+                total += x * y
+                counter[0] += 2
+            new.append(total)
+        out.append(new)
+    return out
