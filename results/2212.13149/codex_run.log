+    unrelated_keys = set()
+    seed = 2000
+    while len(unrelated_keys) < 20 and seed < 10000:
+        key = canonical_key(make_instance(seed=seed, **DIFFICULTY[SHIPPING_DIFFICULTY]))
+        if key not in unrelated_keys:
+            unrelated_keys.add(key)
+            unrelated_seeds.append(seed)
+        seed += 1
+    report["G8_canonical_key"] = {
+        "pass": invariant == 20 and carried == 20 and len(unrelated_keys) == 20,
+        "composed_relabellings_invariant": invariant,
+        "carried_witnesses_valid": carried,
+        "unrelated_distinct_keys": len(unrelated_keys),
+        "attempts_each": 20,
+        "unrelated_seeds": unrelated_seeds,
+    }
