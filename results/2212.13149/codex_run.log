+
+def _attack_wrong_scale_transpose(inst):
+    nil, d = _sum_difference(inst)
+    d2 = _matmul(d, d)
+    q = math.isqrt(d2[0][0].numerator)
+    return _to_json_matrix(_add(_scale(_transpose(nil), q), _scale(nil, -1)))
