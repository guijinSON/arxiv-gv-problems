+
+def _format_rational(pair):
+    num, den = pair
+    return str(num) if den == 1 else f"{num}/{den}"
+
+
+def _format_matrix(matrix):
+    return "\n".join(" ".join(_format_rational(x) for x in row) for row in matrix)
+
+
