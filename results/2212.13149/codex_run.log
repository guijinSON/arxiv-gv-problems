+    out["A"], out["B"] = (bb, aa) if swap_ab else (aa, bb)
+    out["answer"] = relabel(inst["answer"])
+    return out
+
+
+def _answer_atoms(answer):
+    return 2 * sum(len(row) for row in answer) if isinstance(answer, list) else 0
