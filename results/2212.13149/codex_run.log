+    b = _from_json_matrix(inst["B"], n, _HEIGHT_BOUND, "B")
+    i, j = max(((i, j) for i in range(n) for j in range(n)),
+               key=lambda ij: abs(a[ij[0]][ij[1]]) + abs(b[ij[0]][ij[1]]))
+    x = [[_ZERO for _ in range(n)] for _ in range(n)]
+    x[i][j] = _ONE
