+_ZERO = Fraction(0)
+_ONE = Fraction(1)
+
+
+def _identity(n):
+    return [[_ONE if i == j else _ZERO for j in range(n)] for i in range(n)]
+
+
+def _transpose(a):
+    return [list(row) for row in zip(*a)]
