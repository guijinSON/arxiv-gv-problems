+def _sum_difference(inst):
+    n = inst["n"]
+    a = _from_json_matrix(inst["A"], n, _HEIGHT_BOUND, "A")
+    b = _from_json_matrix(inst["B"], n, _HEIGHT_BOUND, "B")
+    return _scale(_add(a, b), Fraction(1, 2)), _scale(_sub(a, b), Fraction(1, 2))
