+
+def _line_transform(line: list[int], inverse: list[list[int]],
+                    modulus: int, n: int) -> list[int]:
+    return [
+        _gf_mul(line[0], inverse[0][j], modulus, n)
+        ^ _gf_mul(line[1], inverse[1][j], modulus, n)
+        ^ _gf_mul(line[2], inverse[2][j], modulus, n)
+        for j in range(3)
+    ]
