    while b!=[0]:a,b=b,divmodp(a,b,p)[1]
    inv=pow(a[-1],-1,p);return [(x*inv)%p for x in a]
def mul(a,b,m,p):
    z=[0]*(len(a)+len(b)-1)
    for i,x in enumerate(a):
      for j,y in enumerate(b):z[i+j]=(z[i+j]+x*y)%p
    while len(z)>=len(m):
      d=len(z)-len(m); c=z[-1]
      for i,x in enumerate(m):z[i+d]=(z[i+d]-c*x)%p
