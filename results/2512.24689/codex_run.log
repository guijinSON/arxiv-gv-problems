+
+def escalate(params: dict) -> dict | str | None:
+    n = params.get("n")
+    if isinstance(n, bool) or not isinstance(n, int):
+        return None
+    if n < 61:
+        return {"n": 61}
+    if n < 127:
+        return {"n": 127}
+    if n < 191:
+        return {"n": 191}
+    if n < 255:
+        return {"n": 255}
+    return "cap_bound"
