+def _rank_bits(values: list[int]) -> int:
+    pivots: dict[int, int] = {}
+    for value in values:
+        while value:
+            pivot = value.bit_length() - 1
+            if pivot in pivots:
+                value ^= pivots[pivot]
+            else:
