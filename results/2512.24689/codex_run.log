+)
+
+# Script-owned oracle evidence is copied here after STEP 4 and the two G9 runs.
+G9_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
