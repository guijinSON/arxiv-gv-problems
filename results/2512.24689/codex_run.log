+    chosen = 1 << first
+    value = syndromes[first]
+    remaining.remove(first)
+    while remaining and value:
+        best = min(remaining,
+                   key=lambda j: ((value ^ syndromes[j]).bit_count(), j))
+        new_value = value ^ syndromes[best]
+        if new_value.bit_count() >= value.bit_count():
+            break
+        chosen |= 1 << best
+        value = new_value
+        remaining.remove(best)
