+
+def _functional_t(modulus: int, n: int) -> int:
+    """Choose f(alpha^(n-1)) so Theorem 4.1 holds when q=2."""
+    # Irreducibility and n>1 imply m(1)=1.  Therefore
+    # 1/(alpha+1) = (m(alpha)+m(1))/(alpha+1).
