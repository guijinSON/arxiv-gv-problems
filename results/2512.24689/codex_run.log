+    "easy": {"n": 31},
+    "medium": {"n": 61},
+    "hard": {"n": 127},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "The displayed line-evaluation columns are scaled cyclic orderings of one "
