+            stat["successes"] += int(verify(inst, candidate)[0])
+            stat["steps"] += steps
+            stat["wall_clock_sec"] += elapsed
+
+        t0 = time.perf_counter()
+        _, steps, success = _attack_random_restart(
+            inst, random.Random(seed ^ 0xB15EC710), 256
+        )
+        elapsed = time.perf_counter() - t0
