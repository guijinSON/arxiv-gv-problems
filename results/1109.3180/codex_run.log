+
+    attack_names = (
+        "outlier_largest_orders",
+        "outlier_smallest_orders",
+        "greedy_cardinality_fill",
+        "alternating_input_indices",
+        "residue_two_smallest",
+        "random_restart_256",
+    )
+    attacks = {
+        name: {"successes": 0, "attempts": 0, "steps": 0, "wall_clock_sec": 0.0}
+        for name in attack_names
