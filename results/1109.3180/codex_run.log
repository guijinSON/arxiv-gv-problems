+            "solves": f"{compact_successes}/{len(attack_seeds)}, as expected",
+        },
+    }
+
+    strongest_failing = max(attacks.items(), key=lambda item: item[1]["wall_clock_sec"])
+    report["G5_density_and_baseline"] = {
+        "pass": (
+            guess_fraction < 1e-6
+            and reference_successes == len(attack_seeds)
