+            witness_checks += 1
+            if not verify(moved, moved["answer"])[0]:
+                key_failures.append(f"witness/{seed}/{number}")
+        # The length-only representation has already quotiented out every local
+        # rotation and reflection of a missing cycle.  Check the edge map
+        # algebraically on boundary and random coordinates; a whole-cycle
