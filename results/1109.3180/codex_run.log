+
+    invariant_checks = 0
+    witness_checks = 0
+    internal_dihedral_checks = 0
+    side_exchange_checks = 0
+    key_failures = []
+    unrelated_keys = []
+    for seed in range(20):
+        inst = make_instance(seed=20_000 + seed, **shipping)
+        base_key = canonical_key(inst)
