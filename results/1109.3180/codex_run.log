+
+    invariant_checks = 0
+    witness_checks = 0
+    key_failures = []
+    unrelated_keys = []
+    for seed in range(20):
+        inst = make_instance(seed=20_000 + seed, **shipping)
+        base_key = canonical_key(inst)
+        unrelated_keys.append(base_key)
+        rng = random.Random(30_000 + seed)
+        forward = list(range(inst["cycle_count"]))
