+        cycle = rng.randrange(inst["cycle_count"])
+        length = inst["cycle_lengths"][cycle]
+        offset = rng.randrange(length)
+        direction = -1 if rng.getrandbits(1) else 1
+        for j in (0, 1, length // 2, length - 1):
+            left = (offset + direction * j) % length
+            right = (offset + direction * ((j + 1) % length)) % length
+            if (right - left) % length not in (1, length - 1):
+                key_failures.append(f"dihedral/{seed}/{j}")
+            internal_dihedral_checks += 1
+        witness_checks += 1
+        if not verify(inst, inst["answer"])[0]:
+            key_failures.append(f"dihedral-witness/{seed}")
+
+        # Exchanging the two unnamed sides is the remaining bisection symmetry.
+        complement = sorted(set(range(inst["cycle_count"])) - set(inst["answer"]))
+        side_exchange_checks += 1
+        witness_checks += 1
+        if not verify(inst, complement)[0]:
+            key_failures.append(f"side-exchange/{seed}")
