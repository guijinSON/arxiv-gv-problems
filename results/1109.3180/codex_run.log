+            "name": "global pair-sum collision table",
+            "complexity": "O(c^2 log c) exact integer operations for c cycles",
+            "wall_clock_sec": round(reference_wall, 6),
+            "pair_sums": reference_pair_sums,
+            "operations": reference_operations,
