+def escalate(params):
+    """Increase coefficient entropy first, keeping the witness length fixed."""
+    clean = {k: v for k, v in params.items() if k != "_preset"}
+    bits = int(clean.get("quotient_bits", 32))
+    clean["quotient_bits"] = bits + 12
+    return clean
