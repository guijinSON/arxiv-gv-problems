+def _attack_random_restart(inst, rng, restarts=256):
+    for attempt in range(1, restarts + 1):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate, attempt, True
+    return None, restarts, False
