+            g8_failures.append({"seed": seed, "transform": "input reorder"})
+        invariance_checks += 1
+        if not verify(reordered, original["answer"])[0]:
+            g8_failures.append({"seed": seed, "transform": "reorder witness"})
+        witness_checks += 1
