+               "failed": len(values) - sum(values), "pass": not any(values)}
+        for name, values in attacks.items()
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(item["pass"] for item in attack_summary.values()),
+        "attacks": attack_summary,
+    }
