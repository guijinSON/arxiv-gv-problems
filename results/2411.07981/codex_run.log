+        "base_order": inst["n"], "doubled_order": doubled["n"],
+        "base_required_triples": inst["n"] * (inst["n"] - 1) // 6,
+        "doubled_required_triples": doubled["n"] * (doubled["n"] - 1) // 6,
+        "doubled_allowed_triples": len(doubled["edges"]),
