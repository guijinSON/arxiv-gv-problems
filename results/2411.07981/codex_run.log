                       "reason": f"the oracle pool solved every level through "
                                 f"{MAX_ESCALATIONS} escalations"}

    update_meta(harden_verdict=verdict)
    print(json.dumps(verdict, indent=1))
    return 0 if verdict["verdict"] == "hardened" else 9


