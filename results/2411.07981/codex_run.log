+        "n": inst["n"],
+        "requested_n": inst.get("requested_n", inst["n"]),
+        "layers": inst.get("layers"),
+        "edges": edges,
+        "answer": answer,
+    }
+
+
+def selftest() -> dict:
+    """Run gates G1--G8 and return their measured, JSON-serialisable report."""
+    report: dict[str, object] = {}
+
+    # G1: every named preset, several independent seeds.
