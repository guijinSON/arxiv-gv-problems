+            pick = min(viable, key=lambda ei: edges[ei])
+        elif mode == "outlier":
+            pick = min(viable, key=lambda ei: (
+                sum(pair_degree[p] for p in edge_pairs[ei]), edges[ei]))
+        elif mode == "random_restart":
+            assert rng is not None
+            scored = []
+            for ei in viable:
+                newly_used = used.union(edge_pairs[ei])
