+)
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "A canonical JSON list [[0,x_0],...,[n-1,x_{n-1}]] containing exactly "
+        "one vertex label x_c in {0,...,p-1} for every color c; it denotes the "
