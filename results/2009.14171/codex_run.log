+"""Verified Track-B stable HR-LQ matching generator for arXiv:2009.14171.
+
+Theorem 2 of Boehmer--Heeger reduces regular Multicolored Independent Set
+to Hospital Residents with lower quotas (HR-LQ).  This module inverse-generates
+a regular prime-field graph together with an independent transversal, then
+carries that transversal through the theorem's explicit matching map.
+
+The generated distribution has an honest polynomial reference algorithm: the
+unique, specially excluded pair in every bipartite relation forms a sparse
+graph whose connected components reveal the planted transversal.  A solver
+without tools can avoid that mechanical scan only by noticing the affine
+three-cycle consistency and doing a short exact calculation.  This is why the
+module declares Track B rather than claiming average-case NP-hardness.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import Counter, deque
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_field",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
