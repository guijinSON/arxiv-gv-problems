+# Filled from script-owned oracle runs after hardening.  ``pending`` makes G9
+# fail closed until transcript evidence exists.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
