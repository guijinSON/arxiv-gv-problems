+    "medium": {"n": 32, "prime": 59},
+    "hard": {"n": 60, "prime": 101},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT: str = (
+    "The uniquely excluded pairs across all color relations belong to one "
+    "shared affine-consistency component."
+)
