+    "easy": {"n": 16, "prime": 29},
+    "medium": {"n": 32, "prime": 59},
+    "hard": {"n": 60, "prime": 101},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT: str = (
