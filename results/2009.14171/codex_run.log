+"""Verified Track-B stable HR-LQ matching generator for arXiv:2009.14171.
+
+Theorem 2 of Boehmer--Heeger reduces regular Multicolored Independent Set
+to Hospital Residents with lower quotas (HR-LQ).  This module inverse-generates
+a regular prime-field graph together with an independent transversal, then
+carries that transversal through the theorem's explicit matching map.
+
+The generated distribution has an honest polynomial reference algorithm: the
+unique, specially excluded pair in every bipartite relation forms a sparse
+graph whose connected components reveal the planted transversal.  A solver
+without tools can avoid that mechanical scan only by noticing the affine
+three-cycle consistency and doing a short exact calculation.  This is why the
+module declares Track B rather than claiming average-case NP-hardness.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from collections import Counter, deque
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_field",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "HR-LQ residents, hospitals, lower quotas, and strict preferences",
+        "regular multicolored graph encoded by prime-field predicates",
+        "stable matching represented by its open vertex hospital in each color",
+    ],
+    "verification_operations": [
+        "exact arithmetic in GF(p)",
+        "Euler-criterion quadratic-residue test",
+        "exact blocking-coalition check",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 3.2, Theorem 2: parameterized reduction from regular "
+        "Multicolored Independent Set to HR-LQ"
+    ),
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The uniquely excluded pair in every color-pair predicate is governed "
+        "by one affine consistency component; without recognizing it, the "
+        "solver faces a dense multicolored binary CSP."
+    ),
+    "hardness_basis": (
+        "Track B: Theorem 2 places generic regular instances in the W[1]-hard "
+        "parameter regime, but this generated promise is solved by connected "
+        "components of the marked-exclusion graph in O(n^2 p) time; at the hard "
+        "preset that scan visits about 715,000 vertices/edge incidences, while "
