+        "hits": hits,
+        "total": samples,
+        "empirical_probability": hits / samples,
+        "candidate_space": search_space(inst),
+        "prior": "uniform over one GF(p) label for each already-fixed color",
+        "sampling_wall_seconds": sample_wall,
+    }
