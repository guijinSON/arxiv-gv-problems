+    "object_regime": "finite_discrete",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "IPDS-Extension graph",
+        "propagating vertices",
+        "implication arcs",
+        "selectable and excluded vertices",
