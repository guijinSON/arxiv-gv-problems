+        reference_operations += len(inst["set"]) ** 2
+        reference_successes += int(ok)
+        truth = list(_pair_cardinalities(_normal_form(inst["set"])))
+        for name, candidate in _attack_answers(inst).items():
+            attempts[name] += 1
+            if candidate == truth:
