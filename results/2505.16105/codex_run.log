+@functools.lru_cache(maxsize=None)
+def _w_size(m, limit, cap):
+    """Equation (4), with the paper's degenerate cases made explicit."""
+    if m == 0 or limit == 0 or cap == 0:
+        return 1
+    return sum(
+        (-1 if k & 1 else 1)
+        * math.comb(m, k)
+        * math.comb(m + limit - k * (cap + 1), m)
+        for k in range(limit // (cap + 1) + 1)
+    )
