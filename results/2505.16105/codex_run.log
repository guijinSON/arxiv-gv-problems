+    for gap in gaps[1:]:
+        divisor = math.gcd(divisor, gap)
+    if divisor == 0:
+        return None
+    forward = tuple(gap // divisor for gap in gaps)
+    top = forward[-1]
+    reflected = tuple(sorted(top - value for value in forward))
+    return min(forward, reflected)
