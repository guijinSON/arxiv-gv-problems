+        "drop_one": [shipping["answer"][0]],
+        "duplicate_field": shipping["answer"] + [shipping["answer"][1]],
+        "swap": list(reversed(shipping["answer"])),
+        "out_of_range": [-1, shipping["answer"][1]],
