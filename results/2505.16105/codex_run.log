+        transforms = [
+            _affine_copy(inst, 1, 0, reverse_order=True),
+            _affine_copy(inst, 3, 17),
+            _affine_copy(inst, -5, 29),
+            _affine_copy(inst, -7, -41, reverse_order=True),
+        ]
