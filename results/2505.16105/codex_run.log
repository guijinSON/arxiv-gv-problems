+        "pass": all(a < b for a, b in zip(ladder_sizes, ladder_sizes[1:]))
+        and doubled_ok
+        and len(doubled["set"]) >= 2 * DIFFICULTY[SHIPPING_DIFFICULTY]["n"],
+        "named_set_sizes": ladder_sizes,
