+        return "invalid"
+    normalized = _normal_form(values)
+    if normalized is None:
+        return "invalid"
+    payload = ",".join(str(value) for value in normalized).encode("ascii")
+    return f"sumdiff:{len(normalized)}:" + hashlib.sha256(payload).hexdigest()
