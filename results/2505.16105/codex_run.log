+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An ordered JSON list [S,D] of exactly two positive integers, where S is "
+        "restricted to 2|A|-1 <= S <= |A|(|A|+1)/2 and D is restricted to the "
+        "odd integers 2|A|-1 <= D <= |A|(|A|-1)+1."
