+import functools
+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "number_theory",
+    "object_regime": "integer_lattice",
