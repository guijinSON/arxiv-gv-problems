+        "set": values,
+        "set_size": set_size,
+        "dimension": m,
+        "coordinate_sum_limit": limit,
+        "coordinate_cap": cap,
+        "radix": radix,
+        "affine_scale": scale,
+        "affine_translation": translation,
+        "route_operations": route_operations,
+        "answer": answer,
