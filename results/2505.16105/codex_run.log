+    if rng.randrange(2):
+        scale = -scale
+    translation = rng.randrange(-100000, 100001)
+    values = [scale * value + translation for value in raw]
+    rng.shuffle(values)
+
+    answer = [
+        _w_size(m, 2 * limit, 2 * cap),
+        _difference_size(m, limit, cap),
