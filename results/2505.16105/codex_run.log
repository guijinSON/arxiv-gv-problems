+        answer = json.loads(payload)
+    except (TypeError, ValueError):
+        # Tolerate prose around an otherwise unambiguous two-integer JSON list.
+        fallback = re.search(r"\[\s*-?\d+\s*,\s*-?\d+\s*\]", payload)
