+def _candidate_ranges(inst):
+    size = len(inst["set"])
+    sum_low = 2 * size - 1
+    sum_high = size * (size + 1) // 2
+    difference_low = 2 * size - 1
+    difference_high = size * (size - 1) + 1
+    return sum_low, sum_high, difference_low, difference_high
