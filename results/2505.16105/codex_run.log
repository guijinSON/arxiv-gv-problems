+        "greedy_arithmetic_progression": [2 * size - 1, 2 * size - 1],
+        "uncapped_simplex_ansatz": [uncapped_sum, uncapped_difference],
+        "obvious_sidon_ansatz": [size * (size + 1) // 2, size * (size - 1) + 1],
