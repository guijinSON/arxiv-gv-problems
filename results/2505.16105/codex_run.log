+    m = inst["dimension"]
+    limit = inst["coordinate_sum_limit"]
+
+    uncapped_sum = math.comb(m + 2 * limit, m)
+    uncapped_difference = sum(
+        math.comb(m, k)
+        * math.comb(limit, k)
+        * math.comb(m - k + limit, m - k)
+        for k in range(min(m, limit) + 1)
+    )
