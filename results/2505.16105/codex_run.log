+                    continue
+                route = _route_operation_count(m, limit, cap)
+                if not min_route_operations <= route <= 300:
+                    continue
+                sum_size = _w_size(m, 2 * limit, 2 * cap)
+                difference_size = _difference_size(m, limit, cap)
+                if difference_size <= sum_size:
