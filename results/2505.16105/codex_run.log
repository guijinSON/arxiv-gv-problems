+def _validate_parameters(n, min_route_operations):
+    return (
+        isinstance(n, int)
+        and not isinstance(n, bool)
+        and 6 <= n <= 200000
+        and isinstance(min_route_operations, int)
+        and not isinstance(min_route_operations, bool)
+        and 0 <= min_route_operations <= 300
