+# n is a lower bound on |A|.  min_route_operations prevents larger rungs from
+# accidentally choosing a numerically trivial parameter triple.
+DIFFICULTY = {
+    "demo": {"n": 8, "min_route_operations": 0},
+    "easy": {"n": 80, "min_route_operations": 80},
