+        "pass": guess_hits / guess_total < 1e-6 and exact_guess_probability < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "sampled_probability": guess_hits / guess_total,
+        "exact_probability": exact_guess_probability,
