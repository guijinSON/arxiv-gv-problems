+    # G5: exact density and measured strongest mechanical baseline at shipping.
+    baseline_inst = make_instance(seed=8675309, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    _pair_cardinalities.cache_clear()
+    started = time.perf_counter()
