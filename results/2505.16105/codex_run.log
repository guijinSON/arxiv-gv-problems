+    for k in range(limit // (cap + 1) + 1):
+        total += _comb_operation_count(m, k)
+        total += _comb_operation_count(m + limit - k * (cap + 1), m)
+        total += 2  # multiply the binomials, add/subtract the term
+    return total
+
