+    differences = {0}
+    for i in range(size):
+        left = normalized[i]
+        for j in range(i, size):
+            sums.add(left + normalized[j])
+        for j in range(i + 1, size):
+            delta = normalized[j] - left
+            differences.add(delta)
+            differences.add(-delta)
