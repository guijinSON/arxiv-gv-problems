+        attempts["random_restart_256"] += 1
+        attack_rng = random.Random(seed ^ 0x5A17)
+        if any(random_candidate(inst, attack_rng) == truth for _ in range(256)):
+            successes["random_restart_256"] += 1
+    attack_report = {
