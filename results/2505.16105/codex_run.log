+    """Parameter triples of comparable explicit size and sub-300 compact cost."""
+    upper = (3 * n + 1) // 2
+    candidates = []
+    # These bounds comfortably support the named ladder and several escalations.
+    max_m = max(24, min(90, int((6 * max(n, 8)) ** (1 / 3)) * 8 + 8))
