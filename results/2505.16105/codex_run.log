+def _encoded_set(m, limit, cap, radix):
+    values = []
+
+    def visit(position, remaining, value, place):
+        if position == m:
+            values.append(value)
+            return
+        for digit in range(min(cap, remaining) + 1):
+            visit(position + 1, remaining - digit, value + digit * place, place * radix)
