  for x in range(3):
   for y in range(x+1,3):owner[tuple(sorted((c[x],c[y])))]=i
 for _ in range(200*len(C)):
  i,j=rng.sample(range(len(C)),2); pi=rng.randrange(1,3); pj=rng.randrange(1,3)
  if C[i][pi]==C[j][pj]:continue
  ni=C[i][:];nj=C[j][:];ni[pi],nj[pj]=nj[pj],ni[pi]
  if len(set(ni))<3 or len(set(nj))<3:continue
  old={tuple(sorted((c[x],c[y]))) for c in (C[i],C[j]) for x in range(3) for y in range(x+1,3)}
  new=[];bad=False
  for c in (ni,nj):
   for x in range(3):
    for y in range(x+1,3):
     p=tuple(sorted((c[x],c[y])))
     if p in new or (p in owner and p not in old):bad=True
     new.append(p)
  if bad:continue
  for p in old: owner.pop(p,None)
  C[i],C[j]=ni,nj
  for p in new:owner[p]=i if p in [tuple(sorted((ni[x],ni[y]))) for x in range(3) for y in range(x+1,3)] else j
 p=list(range(v));rng.shuffle(p)
 C=[tuple(p[x] for x in c) for c in C];rng.shuffle(C)
 return C,{p[x] for x in range(q)}

def solve(C,v,limit=100000):
 occ=[[] for _ in range(v)]
 for j,c in enumerate(C):
  for x in c:occ[x].append(j)
 nodes=0
 def dfs(a):
  nonlocal nodes
  nodes+=1
  if nodes>limit:return None
  while True:
   forced={}
   for c in C:
    vals=[a[x] for x in c]; nt=vals.count(1);nu=vals.count(-1)
    if nt>1 or nt+nu<1:return False
    if nt==1:
     for x in c:
      if a[x]<0:forced[x]=0
    elif nu==1:
     for x in c:
      if a[x]<0:forced[x]=1
