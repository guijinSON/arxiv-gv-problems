\title{\textsc{Square-Root Finding Problem In Graphs, A~Complete Dichotomy Theorem.}}


\author{Babak Farzad$^{1}$ and Majid Karimi$^{2}$\\ 
\\\vspace{6pt} Department of Mathematics\\
Brock University, St. Catharines, ON., Canada\\
