   if a==b or tuple(sorted((a,b))) in pairs or (t,a) in tf or (t,b) in tf:ok=False;break
   pairs.add(tuple(sorted((a,b))));tf.add((t,a));tf.add((t,b));clauses.append((t,a,b))
  if ok:
   p=list(range(v));rng.shuffle(p)
   C=[tuple(sorted(p[x] for x in c)) for c in clauses];rng.shuffle(C)
   return C,{p[x] for x in T},outer
 raise RuntimeError

