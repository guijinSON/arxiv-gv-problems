import random,time

def graph(N,r,seed):
 q=N//3;R=random.Random(seed); E=set()
 for a,b in ((0,1),(0,2),(1,2)):
  for _ in range(r):
   for tries in range(100):
    p=list(range(q));R.shuffle(p)
    cand={(a*q+i,b*q+p[i]) for i in range(q)}
    if not E&cand:E|=cand;break
 p=list(range(N));R.shuffle(p); E={tuple(sorted((p[u],p[v]))) for u,v in E}
 return E

def dsatur(N,E,cap=1000000):
 adj=[set() for _ in range(N)]
 for u,v in E:adj[u].add(v);adj[v].add(u)
 col=[-1]*N;nodes=0
 def go(done):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  if done==N:return col[:]
  u=max((x for x in range(N) if col[x]<0),key=lambda x:(len({col[y] for y in adj[x] if col[y]>=0}),len(adj[x])))
  used={col[y] for y in adj[x] if col[y]>=0}
