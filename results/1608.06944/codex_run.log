    if rough is None: return None,0,0
    types=[]
    for v in d3:
        vals=[rough[e] for e in inc[v]]
        types.append(0 if -2 in vals else 1)
    L=[i for i,x in enumerate(types) if x==0]
    R=set(i for i,x in enumerate(types) if x==1)
    adj={u:[] for u in L}; witness={}
    for ci,row in enumerate(cons):
        ls=[v for v,s in row if types[v]==0]
        rs=[v for v,s in row if types[v]==1]
        if len(ls)"'!=2 or len(rs)!=2: return None,0,0
        for u in ls:
            for v in rs:
                if v not in adj[u]: adj[u].append(v)
                witness[(u,v)]=ci
    # Hopcroft-Karp
    pu={u:None for u in L}; pv={v:None for v in R}; dist={}
    phases=0; scans=0
    while True:
        q=deque()
        for u in L:
            if pu[u] is None: dist[u]=0; q.append(u)
            else: dist[u]=-1
        found=False
        while q:
            u=q.popleft()
            for v in adj[u]:
                scans+=1
                u2=pv[v]
                if u2 is None: found=True
                elif dist[u2]<0: dist[u2]=dist[u]+1; q.append(u2)
        if not found: break
        phases+=1
        def dfs(u):
            for v in adj[u]:
                u2=pv[v]
                if u2 is None or (dist.get(u2,-1)==dist[u]+1 and dfs(u2)):
                    pu[u]=v; pv[v]=u; return True
            dist[u]=-1; return False
        progress=0
        for u in L:
            if pu[u] is None: progress+=dfs(u)
        if not progress: break
    if any(v is None for v in pu.values()): return None,phases,scans
    chosen=[None]*len(d3)
    for u,v in pu.items():
        ci=witness[(u,v)]
        for vv,slot in cons[ci]:
            if vv==u: chosen[u]=slot
            if vv==v: chosen[v]=slot
    if any(x is None for x in chosen): return None,phases,scans
    states=[3*types[v]+chosen[v] for v in range(len(d3))]
    return g._states_to_flow(inst,d3,inc,states),phases,scans

