import random,itertools,time,collections
D=(-2,-1,1,2)
valid={d:[x for x in itertools.product(D,repeat=d) if sum(x)==0] for d in (3,4)}

def gen(n,frac,seed):
 r=random.Random(seed); n4=int(round(n*frac/2))*2; types=[]
 for d,c in ((4,n4),(3,n-n4)):
  for _ in range(c//2):
   pat=list(r.choice(valid[d])); types += [pat[:],pat[:]]
 r.shuffle(types)
 while 1:
  st={x:[] for x in D}
  for v,p in enumerate(types):
   for x in p:st[x].append(v)
  edges=[]; okay=1
  for x,vs0 in st.items():
   for rep in range(1000):
    vs=vs0[:];r.shuffle(vs)
    if all(vs[i]"'!=vs[i+1] for i in range(0,len(vs),2)):break
   else: okay=0;break
   edges += [(vs[i],vs[i+1],x) for i in range(0,len(vs),2)]
  if okay:break
 inc=[[] for _ in range(n)];ans=[]
 for ei,(u,v,x) in enumerate(edges):
  s=r.choice((-1,1)); ans.append(s*x)
  tu=1;tv=1
  inc[u].append((ei,s));inc[v].append((ei,s))
 # row switches
 for v in range(n):
  if r.randrange(2):inc[v]=[(e,-a) for e,a in inc[v]]
 return inc,ans

def solve(inc,cap=200000):
 n=len(inc);m=sum(map(len,inc))//2
 edv=[[]for _ in range(m)]
 for v,row in enumerate(inc):
  for e,a in row:edv[e].append(v)
 dom=[set(D) for _ in range(m)];nodes=0
 def prop(dom,queue):
  queue=collections.deque(queue);inq=set(queue)
  while queue:
   v=queue.popleft();inq.discard(v);row=inc[v]
   for e,a in row:
    nd=set()
    others=[(f,b) for f,b in row if f!=e]
    sums={sum(b*x for (f,b),x in zip(others,vals)) for vals in itertools.product(*(dom[f] for f,b in others))}
    for x in dom[e]:
     if -a*x in sums:nd.add(x)
    if not nd:return False
    if nd!=dom[e]:
     dom[e]=nd
     for w in edv[e]:
      if w not in inq:queue.append(w);inq.add(w)
  return True
 def rec(dom):
  nonlocal nodes
  nodes+=1
  if nodes>cap: return None
  if not prop(dom,range(n)):return False
  e=min((e for e in range(m) if len(dom[e])>1),key=lambda e:len(dom[e]),default=None)
  if e is None:return [next(iter(x)) for x in dom]
  # try values
  for x in sorted(dom[e],key=abs):
   d2=[s.copy() for s in dom];d2[e]={x}
   z=rec(d2)
   if z is not False and z is not None:return z
   if z is None:return None
  return False
 t=time.perf_counter();z=rec(dom);return z,nodes,time.perf_counter()-t
for frac in (.1,.2,.3,.4,.5,.7,.9):
 print('"'frac',frac)
 for seed in range(4):
  inc,a=gen(128,frac,seed);z,no,dt=solve(inc,100000);print(seed,len(a),no,round(dt,3),bool(z))
