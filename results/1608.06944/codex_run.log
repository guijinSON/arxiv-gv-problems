+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A length-m integer edge vector.  Candidates in the measured language "
+        "already satisfy every degree-3 conservation equation: independently "
+        "choose one of its six signed (1,1,-2) states; each edge joining two "
+        "degree-4 vertices then independently takes one of -2,-1,1,2."
+    ),
+    "bounds": {
+        "edge_values": [-2, -1, 1, 2],
+        "degree_3_local_states": 6,
+        "degree_4_to_degree_4_states": 4,
+        "length": "m = 14*n",
+    },
+}
+
+NOTES = (
+    "Step 0: Section 1 defines switching and bidirected orientations; Section "
+    "2.1 defines an integer k-flow by exact conservation with 0<|f(e)|<k. "
+    "Section 2.7 says that a zero-sum k-flow is exactly a nowhere-zero k-flow "
+    "on the all-negative signed graph, and its displayed complexity theorem "
+    "makes zero-sum 3-flow NP-complete on (3,4)-graphs.  The same theorem makes "
+    "(2,4)-graphs with only O(log n) degree-4 vertices polynomial, while the "
+    "regular-graph discussion gives further easy structured cases; every hard "
+    "preset here therefore has equally many degree-3 and degree-4 vertices. "
+    "The certificate-producing general method is finite-domain CSP/SAT search, "
+    "exponential in the worst case; it is not the generator.  Generation first "
+    "chooses local zero-sum triples and quadruples, matches equal-valued stubs, "
+    "then applies independent edge reorientations and vertex switchings, carrying "
+    "the flow through both maps.  Degree and position outliers are suppressed by "
+    "shuffling all vertices, stubs, and edges; plus/minus local types are exactly "
+    "balanced; degree-4 patterns balance unit, double, and mixed magnitudes.  The "
+    "audit attacks degree statistics, greedy residual minimization, uniform "
+    "structure-aware restarts, local repair, and generalized-arc-consistency DPLL."
+)
+
+_VALUES = (-2, -1, 1, 2)
+_VALUE_BITS = {-2: 1, -1: 2, 1: 4, 2: 8}
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 2_000_000
+_DPLL_NODE_CAP = 2_500
+
+# Filled from the three independent harden.py runs after external evaluation.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
+    "placebo": {"solved": 0, "attempts": 3},
+    "hinted_verdict": "hardened",
+}
+
+
+def _validate_params(n, pattern_mix):
+    if isinstance(n, bool) or not isinstance(n, int) or n < 1:
+        raise ValueError("n must be a positive integer")
+    if pattern_mix not in ("illustrative", "balanced"):
+        raise ValueError("pattern_mix must be 'illustrative' or 'balanced'")
+    if n != 1 and n % 2:
+        raise ValueError("non-demo n must be even")
+    if n != 1 and pattern_mix != "balanced":
+        raise ValueError("non-demo instances require pattern_mix='balanced'")
+
+
+def _connected(vertex_count, triples):
+    adj = [[] for _ in range(vertex_count)]
+    for u, v, _ in triples:
+        adj[u].append(v)
+        adj[v].append(u)
+    seen = {0}
+    stack = [0]
+    while stack:
+        u = stack.pop()
+        for v in adj[u]:
+            if v not in seen:
+                seen.add(v)
+                stack.append(v)
+    return len(seen) == vertex_count
+
+
+def _pair_category(rng, left_stubs, right_stubs, planted_value):
+    """Pair every left stub to a right stub, then pair remaining right stubs."""
+    if len(right_stubs) < len(left_stubs):
+        raise RuntimeError("construction has too few degree-4 stubs")
+    if (len(right_stubs) - len(left_stubs)) % 2:
+        raise RuntimeError("construction left an odd stub count")
+    for _ in range(2_000):
+        left = list(left_stubs)
+        right = list(right_stubs)
+        rng.shuffle(left)
+        rng.shuffle(right)
+        take = len(left)
+        pairs = [(u, v, planted_value) for u, v in zip(left, right[:take])]
+        remaining = right[take:]
+        extra = []
+        possible = True
+        while remaining:
+            u = remaining.pop()
+            choices = [i for i, v in enumerate(remaining) if v != u]
+            if not choices:
+                possible = False
+                break
+            j = rng.choice(choices)
+            v = remaining.pop(j)
+            extra.append((u, v, planted_value))
+        if possible:
+            return pairs + extra
+    raise RuntimeError("could not pair stubs without a loop")
+
+
+def _base_patterns(n, pattern_mix):
+    """Return locally zero-sum patterns with matching global stub counts."""
+    degree3 = [[1, 1, -2] for _ in range(2 * n)]
+    degree3 += [[-1, -1, 2] for _ in range(2 * n)]
+    if pattern_mix == "balanced":
+        # q mixed, 2q unit-only, q double-only patterns.  Relative to the
+        # degree-3 side this leaves q stubs of each signed magnitude, hence
+        # 2q degree-4--degree-4 edges split evenly across magnitudes.
+        degree4 = [[-2, -1, 1, 2] for _ in range(n)]
+        degree4 += [[-1, -1, 1, 1] for _ in range(2 * n)]
+        degree4 += [[-2, -2, 2, 2] for _ in range(n)]
+    else:
+        # The n=1 illustration needs even leftover counts in each value class.
+        degree4 = [[-2, -1, 1, 2] for _ in range(2 * n)]
+        degree4 += [[-1, -1, 1, 1] for _ in range(n)]
+        degree4 += [[-2, -2, 2, 2] for _ in range(n)]
+    return degree3, degree4
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a signed (3,4)-graph and a nowhere-zero 3-flow."""
+    pattern_mix = params.pop("pattern_mix", "balanced" if n != 1 else "illustrative")
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_params(n, pattern_mix)
+    rng = random.Random(seed)
+    degree3, degree4 = _base_patterns(n, pattern_mix)
+    vertex_count = len(degree3) + len(degree4)
+    split = len(degree3)
+
+    # The patterns—and thus the answer—are fixed before any graph is formed.
+    # Pairing is resampled only to avoid a disconnected presentation.
+    for _ in range(500):
+        rng.shuffle(degree3)
+        rng.shuffle(degree4)
+        left = {x: [] for x in _VALUES}
+        right = {x: [] for x in _VALUES}
+        for u, pattern in enumerate(degree3):
+            shuffled = list(pattern)
+            rng.shuffle(shuffled)
+            for value in shuffled:
+                left[value].append(u)
+        for j, pattern in enumerate(degree4):
+            shuffled = list(pattern)
+            rng.shuffle(shuffled)
+            for value in shuffled:
+                right[value].append(split + j)
+        planted_edges = []
+        for value in _VALUES:
+            planted_edges.extend(
+                _pair_category(rng, left[value], right[value], value)
+            )
+        if _connected(vertex_count, planted_edges):
+            break
+    else:
+        raise RuntimeError("could not construct a connected instance")
+
+    # Relabel vertices, reorder edges, independently reverse each bidirected
+    # edge, and switch at every vertex independently.  Starting coefficients
+    # are (+1,+1), i.e. an extroverted all-negative edge.  Reorientation
+    # multiplies its column and its flow value by the same sign; switching
+    # multiplies a row only.  Both preserve Bf=0 exactly.
+    permutation = list(range(vertex_count))
+    rng.shuffle(permutation)
+    relabelled = [(permutation[u], permutation[v], x) for u, v, x in planted_edges]
+    rng.shuffle(relabelled)
+    switches = [rng.choice((-1, 1)) for _ in range(vertex_count)]
+    edges = []
+    answer = []
+    for u, v, base_value in relabelled:
+        orientation = rng.choice((-1, 1))
+        answer.append(orientation * base_value)
+        edges.append([u, v, switches[u] * orientation, switches[v] * orientation])
+
+    return {
+        "family": "nowhere-zero integer 3-flow in a bidirected signed graph",
+        "n": n,
+        "pattern_mix": pattern_mix,
+        "vertex_count": vertex_count,
+        "edge_count": len(edges),
+        "edges": edges,
+        "answer": answer,
+    }
+
+
+def _degrees(inst):
+    degrees = [0] * inst["vertex_count"]
+    for u, v, _, _ in inst["edges"]:
+        degrees[u] += 1
+        degrees[v] += 1
+    return degrees
+
+
+def _incidence(inst):
+    inc = [[] for _ in range(inst["vertex_count"])]
+    for edge_index, (u, v, a, b) in enumerate(inst["edges"]):
+        inc[u].append((edge_index, a))
+        inc[v].append((edge_index, b))
+    return inc
+
+
+def render(inst):
+    edge_lines = []
+    for i, (u, v, a, b) in enumerate(inst["edges"], 1):
+        sign = "negative" if a == b else "positive"
+        edge_lines.append(
+            f"  {i}: ({u + 1}, {a:+d}) ({v + 1}, {b:+d}) [{sign}]"
+        )
+    statement = f"""Find a nowhere-zero integer 3-flow in a bidirected signed graph.
+
+There are {inst['vertex_count']} vertices, numbered 1 through {inst['vertex_count']},
+and {inst['edge_count']} edges, numbered in the displayed order.  Parallel edges
+are distinct; there are no loops.  Each endpoint is written (vertex, coefficient).
+A coefficient +1 means that half-edge is incoming at its vertex, and -1 means it
+is outgoing.  An edge is positive exactly when its two endpoint coefficients are
+opposite, and negative exactly when they are equal; this is the definition of the
+displayed bidirected signed graph.
+
+For edge e choose one integer x_e from the four-element set {{-2,-1,1,2}}.  The
+conservation law at every vertex v is the exact integer equation
+
+    sum of coefficient(v,e) * x_e over all incident edge-ends = 0.
+
+Thus negative flow values are allowed, zero is forbidden, and the magnitude bound
+is strict: 0 < |x_e| < 3.  Vertex and edge numbering is 1-based in this statement.
+The answer list is in edge order and contains no edge indices.
+
+Edges:
+{chr(10).join(edge_lines)}
+
+Return a JSON list of exactly {inst['edge_count']} decimal integers, one for each
+edge in order, with every entry in [-2,-1,1,2].
+
+Give your final answer inside <answer></answer> tags, as the JSON list just specified.
+Example: <answer>{json.dumps(([1, -1] * ((inst['edge_count'] + 1) // 2))[:inst['edge_count']], separators=(',', ':'))}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    candidates = [match.group(1)] if match else []
+    candidates.append(text)
+    decoder = json.JSONDecoder()
+    for candidate in candidates:
+        candidate = candidate.strip()
+        # First try the whole delimited payload, including markdown-fenced JSON.
+        cleaned = re.sub(r"^```(?:json)?\s*|\s*```$", "", candidate, flags=re.I | re.S)
+        try:
+            value = json.loads(cleaned)
+            if isinstance(value, list):
+                return value
+        except (TypeError, ValueError):
+            pass
+        # Then scan prose for the first JSON list.
+        for pos, char in enumerate(candidate):
+            if char != "[":
+                continue
+            try:
+                value, _ = decoder.raw_decode(candidate[pos:])
+            except ValueError:
+                continue
+            if isinstance(value, list):
+                return value
+    return None
+
+
+def verify(inst, answer):
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer list is empty"
+    m = inst["edge_count"]
+    if len(answer) != m:
+        return False, f"expected exactly {m} edge values, got {len(answer)}"
+    for i, value in enumerate(answer):
+        if isinstance(value, bool) or not isinstance(value, int):
+            return False, f"entry {i + 1} is not an integer"
+        if value == 0 or abs(value) >= 3:
+            return False, f"entry {i + 1} is not in [-2,-1,1,2]"
+    residual = [0] * inst["vertex_count"]
+    for value, (u, v, a, b) in zip(answer, inst["edges"]):
+        residual[u] += a * value
+        residual[v] += b * value
+    for vertex, value in enumerate(residual):
+        if value:
+            return False, (
+                f"conservation fails at vertex {vertex + 1}: signed sum is {value}"
+            )
+    return True, "ok"
+
+
+def _candidate_coordinates(inst):
+    inc = _incidence(inst)
+    degree3 = [v for v, row in enumerate(inc) if len(row) == 3]
+    degree4_edges = []
+    degrees = _degrees(inst)
+    for e, (u, v, _, _) in enumerate(inst["edges"]):
+        if degrees[u] == degrees[v] == 4:
+            degree4_edges.append(e)
+    return inc, degree3, degree4_edges
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the language after enforcing all cubic equations."""
+    inc, degree3, degree4_edges = _candidate_coordinates(inst)
+    return _random_candidate_from_coordinates(inst, rng, inc, degree3, degree4_edges)
+
+
+def _random_candidate_from_coordinates(inst, rng, inc, degree3, degree4_edges):
+    """The same sampler with its instance-only coordinate scan precomputed."""
+    answer = [None] * inst["edge_count"]
+    for vertex in degree3:
+        row = inc[vertex]
+        special = rng.randrange(3)
+        overall_sign = rng.choice((-1, 1))
+        for j, (edge, coefficient) in enumerate(row):
+            contribution = (-2 if j == special else 1) * overall_sign
+            answer[edge] = coefficient * contribution
+    for edge in degree4_edges:
+        answer[edge] = rng.choice(_VALUES)
+    if any(x is None for x in answer):
+        raise ValueError("candidate language requires no degree-3--degree-3 edge")
+    return answer
+
+
+def search_space(inst):
+    _, degree3, degree4_edges = _candidate_coordinates(inst)
+    return pow(6, len(degree3)) * pow(4, len(degree4_edges))
+
+
+def enumerate_all(inst):
+    space = search_space(inst)
+    if space > _ENUMERATION_CAP:
+        return None
+    inc, degree3, degree4_edges = _candidate_coordinates(inst)
+    count = 0
+    for local_states in itertools.product(range(6), repeat=len(degree3)):
+        base = [None] * inst["edge_count"]
+        for vertex, state in zip(degree3, local_states):
+            special = state // 2
+            overall_sign = -1 if state % 2 else 1
+            for j, (edge, coefficient) in enumerate(inc[vertex]):
+                contribution = (-2 if j == special else 1) * overall_sign
+                base[edge] = coefficient * contribution
+        for free_values in itertools.product(_VALUES, repeat=len(degree4_edges)):
+            candidate = list(base)
+            for edge, value in zip(degree4_edges, free_values):
+                candidate[edge] = value
+            if verify(inst, candidate)[0]:
+                count += 1
+    return count
+
+
+def _wl_invariant(inst):
+    """A strong cheap isomorphism invariant of the underlying multigraph."""
+    n = inst["vertex_count"]
+    adj = [[] for _ in range(n)]
+    for u, v, _, _ in inst["edges"]:
+        adj[u].append(v)
+        adj[v].append(u)
+    colors = [len(row) for row in adj]
+    history = []
+    for _ in range(n + 1):
+        signatures = [(colors[v], tuple(sorted(colors[w] for w in adj[v]))) for v in range(n)]
+        palette = {sig: i for i, sig in enumerate(sorted(set(signatures)))}
+        new_colors = [palette[sig] for sig in signatures]
+        histogram = tuple(sorted(Counter(new_colors).items()))
+        history.append(histogram)
+        if new_colors == colors:
+            break
+        colors = new_colors
+    # All generated signatures arise from all-negative graphs by switching, so
+    # the switching class is fixed by the underlying graph.  Ignoring the
+    # particular switch and arbitrary bidirection is therefore intentional.
+    return (n, inst["edge_count"], tuple(history))
+
+
+def canonical_key(inst):
+    payload = json.dumps(_wl_invariant(inst), separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
+
+
+def escalate(params):
+    n = params.get("n")
+    if isinstance(n, int) and n < 18:
+        harder = dict(params)
+        harder["n"] = min(18, n + (2 if n >= 8 else 7))
+        harder["pattern_mix"] = "balanced"
+        if harder["n"] % 2:
+            harder["n"] += 1
+        return harder
+    # n=18 already has 252 answer atoms.  The degree-4 pattern mixture is
+    # balanced across unit, double, and mixed states; further n-growth crosses
+    # the published 256-atom cap, and no additional fixed-length axis remains.
+    return "cap_bound"
+
+
+def _residuals(inst, answer):
+    residual = [0] * inst["vertex_count"]
+    for value, (u, v, a, b) in zip(answer, inst["edges"]):
+        residual[u] += a * value
+        residual[v] += b * value
+    return residual
+
+
+def _outlier_attack(inst):
+    inc, degree3, degree4_edges = _candidate_coordinates(inst)
+    degrees = _degrees(inst)
+    internal_degree = [0] * inst["vertex_count"]
+    for u, v, _, _ in inst["edges"]:
+        if degrees[u] == degrees[v] == 4:
+            internal_degree[u] += 1
+            internal_degree[v] += 1
+    answer = [None] * inst["edge_count"]
+    for vertex in degree3:
+        row = inc[vertex]
+        def score(item):
+            edge, _ = item
+            u, v, _, _ = inst["edges"][edge]
+            other = v if u == vertex else u
+            return (-internal_degree[other], edge)
+        special_edge = min(row, key=score)[0]
+        for edge, coefficient in row:
+            contribution = -2 if edge == special_edge else 1
+            answer[edge] = coefficient * contribution
+    for edge in degree4_edges:
+        u, _, a, _ = inst["edges"][edge]
+        answer[edge] = a * (-2 if internal_degree[u] else 1)
+    return answer
+
+
+def _greedy_attack(inst):
+    inc, degree3, degree4_edges = _candidate_coordinates(inst)
+    answer = [None] * inst["edge_count"]
+    residual = [0] * inst["vertex_count"]
+    # High-overlap cubic vertices first; greedily minimize squared residuals at
+    # their degree-4 neighbours.
+    degree3.sort(key=lambda v: tuple(sorted(e for e, _ in inc[v])))
+    for vertex in degree3:
+        best = None
+        for special in range(3):
+            for overall_sign in (-1, 1):
+                proposal = []
+                score = 0
+                for j, (edge, coefficient) in enumerate(inc[vertex]):
+                    contribution = (-2 if j == special else 1) * overall_sign
+                    value = coefficient * contribution
+                    u, v, a, b = inst["edges"][edge]
+                    other = v if u == vertex else u
+                    other_coefficient = b if u == vertex else a
+                    next_residual = residual[other] + other_coefficient * value
+                    score += next_residual * next_residual
+                    proposal.append((edge, value, other, other_coefficient))
+                key = (score, special, overall_sign)
+                if best is None or key < best[0]:
+                    best = (key, proposal)
+        for edge, value, other, other_coefficient in best[1]:
+            answer[edge] = value
+            residual[other] += other_coefficient * value
+    for edge in sorted(degree4_edges):
+        u, v, a, b = inst["edges"][edge]
+        value = min(
+            _VALUES,
+            key=lambda x: ((residual[u] + a * x) ** 2 + (residual[v] + b * x) ** 2, x),
+        )
+        answer[edge] = value
+        residual[u] += a * value
+        residual[v] += b * value
+    return answer
+
+
+def _local_repair_attack(inst, seed, restarts=6, steps=96):
+    rng = random.Random(seed)
+    inc, degree3, degree4_edges = _candidate_coordinates(inst)
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate
+        for _ in range(steps):
+            old_score = sum(x * x for x in _residuals(inst, candidate))
+            best_score = old_score
+            best_candidate = None
+            # Sample local moves; exhaustive steepest descent would itself be a
+            # much larger solver rather than an in-context repair heuristic.
+            for _ in range(12):
+                trial = list(candidate)
+                if rng.randrange(3) and degree3:
+                    vertex = rng.choice(degree3)
+                    row = inc[vertex]
+                    special = rng.randrange(3)
+                    overall_sign = rng.choice((-1, 1))
+                    for j, (edge, coefficient) in enumerate(row):
+                        contribution = (-2 if j == special else 1) * overall_sign
+                        trial[edge] = coefficient * contribution
+                else:
+                    edge = rng.choice(degree4_edges)
+                    trial[edge] = rng.choice(_VALUES)
+                score = sum(x * x for x in _residuals(inst, trial))
+                if score < best_score:
+                    best_score = score
+                    best_candidate = trial
+            if best_candidate is None:
+                break
+            candidate = best_candidate
+            if verify(inst, candidate)[0]:
+                return candidate
+    return None
+
+
+def _dpll_attack(inst, node_cap=_DPLL_NODE_CAP):
+    """Exact finite-domain DPLL with generalized arc consistency, under a cap."""
+    inc = _incidence(inst)
+    m = inst["edge_count"]
+    edge_vertices = [[] for _ in range(m)]
+    constraints = []
+    for vertex, row in enumerate(inc):
+        for edge, _ in row:
+            edge_vertices[edge].append(vertex)
+        allowed = []
+        for values in itertools.product(_VALUES, repeat=len(row)):
+            if sum(a * x for (_, a), x in zip(row, values)) == 0:
+                allowed.append(tuple(_VALUE_BITS[x] for x in values))
+        constraints.append((row, allowed))
+
+    stats = {"nodes": 0, "propagations": 0, "tuple_checks": 0, "capped": False}
+
+    def propagate(domains, initial_queue):
+        queue = deque(initial_queue)
+        queued = set(initial_queue)
+        while queue:
+            vertex = queue.popleft()
+            queued.discard(vertex)
+            row, allowed = constraints[vertex]
+            support = [0] * len(row)
+            found = False
+            for allowed_tuple in allowed:
+                stats["tuple_checks"] += 1
+                if all(domains[e] & bit for (e, _), bit in zip(row, allowed_tuple)):
+                    found = True
+                    for i, bit in enumerate(allowed_tuple):
+                        support[i] |= bit
+            if not found:
+                return False
+            for i, (edge, _) in enumerate(row):
+                reduced = domains[edge] & support[i]
+                if not reduced:
+                    return False
+                if reduced != domains[edge]:
+                    domains[edge] = reduced
+                    stats["propagations"] += 1
+                    for neighbour in edge_vertices[edge]:
+                        if neighbour not in queued:
+                            queue.append(neighbour)
+                            queued.add(neighbour)
+        return True
+
+    bit_order = (2, 4, 1, 8)  # -1,+1,-2,+2; independent of the plant.
+
+    def recurse(domains, queue):
+        stats["nodes"] += 1
+        if stats["nodes"] > node_cap:
+            stats["capped"] = True
+            return None
+        if not propagate(domains, queue):
+            return False
+        edge = min(
+            (i for i, mask in enumerate(domains) if mask & (mask - 1)),
+            key=lambda i: (domains[i].bit_count(), -sum(len(constraints[v][1]) for v in edge_vertices[i])),
+            default=None,
+        )
+        if edge is None:
+            return domains
+        for bit in bit_order:
+            if domains[edge] & bit:
+                child = list(domains)
+                child[edge] = bit
+                result = recurse(child, edge_vertices[edge])
+                if isinstance(result, list):
+                    return result
+                if result is None and stats["capped"]:
+                    return None
+        return False
+
+    domains = [15] * m
+    # Break the unavoidable global-negation symmetry without excluding all
+    # solutions: require the first edge to be positive.
+    domains[0] = _VALUE_BITS[1] | _VALUE_BITS[2]
+    started = time.perf_counter()
+    result = recurse(domains, range(inst["vertex_count"]))
+    stats["wall_clock_sec"] = time.perf_counter() - started
