+        count0 = sum(selected[i] for i in range(4) if types[i] == 0)
+        count1 = sum(selected[i] for i in range(4) if types[i] == 1)
+        if count0 == count1:
+            patterns.append(states)
+    cached = tuple(patterns)
+    _ALLOWED_CACHE[key] = cached
+    return cached
