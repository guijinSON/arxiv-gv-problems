import random,time,collections,itertools
D=(-2,-1,1,2)
def gen(t,seed):
 r=random.Random(seed)
 while True:
  V=[];U=[]
  p3=[[1,1,-2] for _ in range(2*t)]+[[-1,-1,2] for _ in range(2*t)];r.shuffle(p3)
  for p in p3:q=list(p);r.shuffle(q);V.append(q)
  p4=[[1,1,-1,-1] for _ in range(t)]+[[1,-1,2,-2] for _ in range(2*t)];r.shuffle(p4)
  for p in p4:q=list(p);r.shuffle(q);U.append(q)
  used=set();edges=[];ans=[];allok=True
  for val in D:
   a=[(i,j) for i,p in enumerate(V) for j,x in enumerate(p) if x==val];b=[(i,j) for i,p in enumerate(U) for j,x in enumerate(p) if x==val]
   ok=False
   for _ in range(200):
    aa=list(a);rem=list(b);r.shuffle(aa);r.shuffle(rem);pairs=[]
    for sa in aa:
     choices=[k for k,sb in enumerate(rem) if (sa[0],sb[0]) not in used and all((sa[0],sb[0])"'!=(x[0][0],x[1][0]) for x in pairs)]
     if not choices:break
     pairs.append((sa,rem.pop(r.choice(choices))))
