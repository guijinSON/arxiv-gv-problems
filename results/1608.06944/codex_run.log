+            values = [assignment[variable] for variable in variables]
+            zeros = values.count(0)
+            ones = values.count(1)
+            unknown = [variable for variable in variables if assignment[variable] < 0]
+            if zeros > 2 or ones > 2:
+                return False
+            forced = None
+            if zeros == 2:
