+def _type_then_matching_attack(inst, rng):
+    """Decisive attack: exact sign types, then a bipartite perfect matching.
+
+    The first stage deliberately reuses the planted-blind exact-2-in-4 search
+    from ``_two_stage_attack``.  Its candidate always satisfies every degree-3
+    equation, so it exposes the sign type even when its greedy selector fails.
+
+    For fixed sign types, selecting one magnitude-two edge at every degree-3
+    vertex is equivalent to a perfect matching: put the two sign types on
+    opposite sides, and join two variables when they meet at a degree-4 vertex.
+    A matched pair chooses that common degree-4 vertex.  Equality of the two
+    selected counts at every degree-4 vertex is then automatic.
+    """
+    incident, degree3, constraints, _ = _flow_csp(inst)
+    rough = _two_stage_attack(inst, rng)
+    stats = {"matching_phases": 0, "matching_edge_scans": 0}
+    if rough is None:
+        return None, stats
+
+    types = []
+    for vertex in degree3:
+        local = [rough[edge] for edge in incident[vertex]]
+        types.append(0 if -2 in local else 1)
+
+    left = [variable for variable, sign_type in enumerate(types) if sign_type == 0]
+    right = {variable for variable, sign_type in enumerate(types) if sign_type == 1}
+    neighbors = {variable: [] for variable in left}
+    common_constraint = {}
+    for constraint_index, row in enumerate(constraints):
+        left_here = [variable for variable, _ in row if types[variable] == 0]
+        right_here = [variable for variable, _ in row if types[variable] == 1]
+        if len(left_here) != 2 or len(right_here) != 2:
+            return None, stats
+        for first in left_here:
+            for second in right_here:
+                if second not in neighbors[first]:
+                    neighbors[first].append(second)
+                common_constraint[(first, second)] = constraint_index
+
+    # Hopcroft--Karp.  This is the domain-standard polynomial completion that
+    # the earlier greedy two-stage audit omitted.
+    pair_left = {variable: None for variable in left}
+    pair_right = {variable: None for variable in right}
+    while True:
+        distance = {variable: -1 for variable in left}
+        queue = deque()
+        for variable in left:
+            if pair_left[variable] is None:
+                distance[variable] = 0
+                queue.append(variable)
+        augmenting = False
+        while queue:
+            variable = queue.popleft()
+            for other in neighbors[variable]:
+                stats["matching_edge_scans"] += 1
+                mate = pair_right[other]
+                if mate is None:
+                    augmenting = True
+                elif distance[mate] < 0:
+                    distance[mate] = distance[variable] + 1
+                    queue.append(mate)
+        if not augmenting:
+            break
+        stats["matching_phases"] += 1
+
+        def augment(variable):
+            for other in neighbors[variable]:
+                mate = pair_right[other]
+                if mate is None or (
+                    distance.get(mate, -1) == distance[variable] + 1
+                    and augment(mate)
+                ):
+                    pair_left[variable] = other
+                    pair_right[other] = variable
+                    return True
+            distance[variable] = -1
+            return False
+
+        progress = False
+        for variable in left:
+            if pair_left[variable] is None:
+                progress |= augment(variable)
+        if not progress:
+            break
+
+    if any(mate is None for mate in pair_left.values()):
+        return None, stats
+
+    selected_slots = [None] * len(degree3)
+    for first, second in pair_left.items():
+        constraint_index = common_constraint[(first, second)]
+        for variable, slot in constraints[constraint_index]:
+            if variable in (first, second):
+                selected_slots[variable] = slot
+    if any(slot is None for slot in selected_slots):
+        return None, stats
+    states = [3 * types[v] + selected_slots[v] for v in range(len(degree3))]
+    return _states_to_flow(inst, degree3, incident, states), stats
+
+
 def _gac_dpll_attack(inst, rng, node_budget=_DPLL_NODE_BUDGET):
     """Specialized exact CSP search with generalized arc consistency."""
     incident, degree3, constraints, variable_constraints = _flow_csp(inst)

