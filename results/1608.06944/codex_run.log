+                value = -2 if slot == selected_slot else 1
+            else:
+                value = 2 if slot == selected_slot else -1
+            if answer[edge] not in (0, value):
+                raise AssertionError("inconsistent state conversion")
+            answer[edge] = value
+    return answer
