import importlib.util, time
import numpy as np
from scipy.optimize import milp, LinearConstraint, Bounds
from scipy.sparse import lil_matrix
spec=importlib.util.spec_from_file_location('g','gen_1608_06944.py')
g=importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
params=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
for seed in range(8):
    inst=g.make_instance(seed=seed,**params)
    inc, d3, cons, vc = g._flow_csp(inst)
    nv=len(d3)*6
    A=lil_matrix((len(d3)+len(cons),nv),dtype=float)
    b=np.zeros(len(d3)+len(cons))
    for v in range(len(d3)):
        A[v,6*v:6*v+6]=1
        b[v]=1
    for ci,row in enumerate(cons):
        for var,slot in row:
            for state in range(6):
                typ,sel=divmod(state,3)
                val=(-2 if sel==slot else 1) if typ==0 else (2 if sel==slot else -1)
                A[len(d3)+ci,6*var+state]=val
    t=time.perf_counter()
    res=milp(c=np.zeros(nv), integrality=np.ones(nv), bounds=Bounds(0,1), constraints=LinearConstraint(A.tocsr(),b,b), options={'time_limit':30})
    wall=time.perf_counter()-t
    ok=False
    if res.x is not None:
        states=[]
        for v in range(len(d3)):
            states.append(int(np.argmax(res.x[6*v:6*v+6])))
        ans=g._states_to_flow(inst,d3,inc,states)
        ok=g.verify(inst,ans)[0]
    print(seed,res.status,res.message,'wall',round(wall,4),'nodes',getattr(res,'mip_node_count',None),'ok',ok)
