+
+def _validate_params(n, pattern_mix):
+    if isinstance(n, bool) or not isinstance(n, int) or n < 1:
+        raise ValueError("n must be a positive integer")
+    if pattern_mix not in ("illustrative", "balanced"):
+        raise ValueError("pattern_mix must be 'illustrative' or 'balanced'")
+    if n != 1 and n % 2:
+        raise ValueError("non-demo n must be even")
+    if n != 1 and pattern_mix != "balanced":
+        raise ValueError("non-demo instances require pattern_mix='balanced'")
+
+
+def _connected(vertex_count, triples):
+    adj = [[] for _ in range(vertex_count)]
+    for u, v, _ in triples:
+        adj[u].append(v)
+        adj[v].append(u)
+    seen = {0}
+    stack = [0]
+    while stack:
+        u = stack.pop()
+        for v in adj[u]:
+            if v not in seen:
+                seen.add(v)
+                stack.append(v)
+    return len(seen) == vertex_count
+
+
+def _pair_category(rng, left_stubs, right_stubs, planted_value):
+    """Pair every left stub to a right stub, then pair remaining right stubs."""
+    if len(right_stubs) < len(left_stubs):
+        raise RuntimeError("construction has too few degree-4 stubs")
+    if (len(right_stubs) - len(left_stubs)) % 2:
+        raise RuntimeError("construction left an odd stub count")
+    for _ in range(2_000):
+        left = list(left_stubs)
+        right = list(right_stubs)
+        rng.shuffle(left)
+        rng.shuffle(right)
+        take = len(left)
+        pairs = [(u, v, planted_value) for u, v in zip(left, right[:take])]
+        remaining = right[take:]
+        extra = []
+        possible = True
+        while remaining:
+            u = remaining.pop()
+            choices = [i for i, v in enumerate(remaining) if v != u]
+            if not choices:
+                possible = False
+                break
+            j = rng.choice(choices)
+            v = remaining.pop(j)
+            extra.append((u, v, planted_value))
+        if possible:
+            return pairs + extra
+    raise RuntimeError("could not pair stubs without a loop")
+
+
+def _base_patterns(n, pattern_mix):
+    """Return locally zero-sum patterns with matching global stub counts."""
+    degree3 = [[1, 1, -2] for _ in range(2 * n)]
+    degree3 += [[-1, -1, 2] for _ in range(2 * n)]
+    if pattern_mix == "balanced":
+        # q mixed, 2q unit-only, q double-only patterns.  Relative to the
+        # degree-3 side this leaves q stubs of each signed magnitude, hence
+        # 2q degree-4--degree-4 edges split evenly across magnitudes.
+        degree4 = [[-2, -1, 1, 2] for _ in range(n)]
+        degree4 += [[-1, -1, 1, 1] for _ in range(2 * n)]
+        degree4 += [[-2, -2, 2, 2] for _ in range(n)]
+    else:
+        # The n=1 illustration needs even leftover counts in each value class.
+        degree4 = [[-2, -1, 1, 2] for _ in range(2 * n)]
+        degree4 += [[-1, -1, 1, 1] for _ in range(n)]
+        degree4 += [[-2, -2, 2, 2] for _ in range(n)]
+    return degree3, degree4
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a signed (3,4)-graph and a nowhere-zero 3-flow."""
+    pattern_mix = params.pop("pattern_mix", "balanced" if n != 1 else "illustrative")
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    _validate_params(n, pattern_mix)
+    rng = random.Random(seed)
+    degree3, degree4 = _base_patterns(n, pattern_mix)
+    vertex_count = len(degree3) + len(degree4)
+    split = len(degree3)
+
+    # The patterns—and thus the answer—are fixed before any graph is formed.
+    # Pairing is resampled only to avoid a disconnected presentation.
+    for _ in range(500):
+        rng.shuffle(degree3)
+        rng.shuffle(degree4)
+        left = {x: [] for x in _VALUES}
+        right = {x: [] for x in _VALUES}
+        for u, pattern in enumerate(degree3):
+            shuffled = list(pattern)
+            rng.shuffle(shuffled)
+            for value in shuffled:
+                left[value].append(u)
+        for j, pattern in enumerate(degree4):
+            shuffled = list(pattern)
+            rng.shuffle(shuffled)
+            for value in shuffled:
+                right[value].append(split + j)
+        planted_edges = []
+        for value in _VALUES:
+            planted_edges.extend(
+                _pair_category(rng, left[value], right[value], value)
+            )
+        if _connected(vertex_count, planted_edges):
+            break
+    else:
+        raise RuntimeError("could not construct a connected instance")
+
+    # Relabel vertices, reorder edges, independently reverse each bidirected
+    # edge, and switch at every vertex independently.  Starting coefficients
+    # are (+1,+1), i.e. an extroverted all-negative edge.  Reorientation
+    # multiplies its column and its flow value by the same sign; switching
+    # multiplies a row only.  Both preserve Bf=0 exactly.
+    permutation = list(range(vertex_count))
+    rng.shuffle(permutation)
+    relabelled = [(permutation[u], permutation[v], x) for u, v, x in planted_edges]
+    rng.shuffle(relabelled)
