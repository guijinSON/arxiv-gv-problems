    nd=ds[v]&sup[i]
    if not nd:return False
    if nd!=ds[v]:
     ds[v]=nd
     for w in varc[v]:
      if w not in inq:q.append(w);inq.add(w)
  return True
 if not prop(domains,range(nu)):return False,0,checks,0
 def rec(ds):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return None
  cand=[(m.bit_count(),v) for v,m in enumerate(ds) if m.bit_count()>1]
  if not cand:return [m.bit_length()-1 for m in ds]
  v=min(cand)[1];m=ds[v]
  for s in range(6):
   if m>>s&1:
    ns=ds.copy();ns[v]=1<<s
    if prop(ns,varc[v]):
     out=rec(ns)
     if out is None:return None
     if out is not False:return out
  return False
 t0=time.perf_counter();out=rec(domains);return out,nodes,checks,time.perf_counter()-t0
for t in [4,6,8,10,12,16,20,21]:
