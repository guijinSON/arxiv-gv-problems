+| 18 | 126 | 216 | 8/8 | 0.0093 s | 0.0156 s |
+| 20 | 140 | 240 | 8/8 | 0.0129 s | 0.0200 s |
+| 21 | 147 | 252 | 8/8 | 0.0249 s | 0.0666 s |
 
