def _corruptions_with_distinct_reasons(inst):
    answer = list(inst["answer"])
    cases = {
        "empty": [],
        "drop_one": answer[:-1],
        "out_of_range": [3] + answer[1:],
    }
    used = {verify(inst, candidate)[1] for candidate in cases.values()}

    swapped = None
    for i in range(len(answer)):
        for j in range(i + 1, len(answer)):
            if answer[i] == answer[j]:
                continue
            candidate = list(answer)
            candidate[i], candidate[j] = candidate[j], candidate[i]
            ok, reason = verify(inst, candidate)
            if not ok and reason not in used:
                swapped = candidate
                used.add(reason)
                break
        if swapped is not None:
            break
    if swapped is None:
        raise AssertionError("could not make a distinct swap corruption")
    cases["swap_two"] = swapped

    duplicate = None
    for i in range(len(answer)):
        for j in range(len(answer)):
            if answer[i] == answer[j]:
                continue
            candidate = list(answer)
            candidate[i] = answer[j]
            ok, reason = verify(inst, candidate)
            if not ok and reason not in used:
                duplicate = candidate
                used.add(reason)
                break
        if duplicate is not None:
            break
    if duplicate is None:
        raise AssertionError("could not make a distinct duplicate corruption")
    cases["duplicate_value"] = duplicate
    return cases


def _answer_atoms(answer):
    if isinstance(answer, dict):
        return sum(_answer_atoms(x) for x in answer.values())
    if isinstance(answer, list):
        return sum(_answer_atoms(x) for x in answer)
    return 1


