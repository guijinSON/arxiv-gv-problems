+        "integer nowhere-zero 3-flow on its edges",
+    ],
+    "verification_operations": [
+        "exact signed integer incidence sum at each vertex",
+        "exact nonzero magnitude bound on every edge",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "constraint propagation",
+    "intuition_description": (
+        "At every degree-3 vertex the incident contributions must be a signed "
+        "permutation of (1,1,-2); propagating those six local states into the "
+        "degree-4 core replaces blind four-way guessing on every edge."
+    ),
+    "hardness_basis": (
+        "Track A: the theorem in Section 2.7 states that zero-sum 3-flow is "
+        "NP-complete on (3,4)-graphs; shipping uses 72 degree-3 and 72 degree-4 "
+        "vertices (the latter is linear, avoiding the same theorem's polynomial "
+        "O(log n)-many-degree-4 regime), while the measured generalized-arc-"
+        "consistency DPLL baseline is recorded by selftest at a 2,500-node cap."
+    ),
+    "max_answer_tokens": 190,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
