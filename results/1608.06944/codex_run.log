     for sa,sb in pairs:used.add((sa[0],sb[0]));edges.append((sa[0],sb[0],sa[1]));ans.append(val)
     ok=True;break
   if not ok:allok=False;break
  if allok:return edges,ans

def solve(t,edges,cap=200000):
 nv=4*t;nu=3*t;cons=[[] for _ in range(nu)];varc=[[] for _ in range(nv)]
 for v,u,slot in edges:cons[u].append((v,slot))
 for u,row in enumerate(cons):
  for v,slot in row:varc[v].append(u)
 allowed=[]
 for row in cons:
  pats=[]
  for ss in itertools.product(range(6),repeat=4):
   xs=[s//3 for s in ss]
   if sum(xs)!=2:continue
   sa=sb=0
   for i,s in enumerate(ss):
    if s%3==row[i][1]:
     if xs[i]:sb+=1
     else:sa+=1
   if sa==sb:pats.append(ss)
  allowed.append(pats)
 domains=[63]*nv;domains[0]=7;nodes=checks=0
 def prop(ds,initial):
  nonlocal checks
  q=collections.deque(initial);inq=set(q)
  while q:
   u=q.popleft();inq.discard(u);row=cons[u];sup=[0,0,0,0];anyok=False
   for p in allowed[u]:
    checks+=1
