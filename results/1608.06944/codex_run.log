+def _two_stage_attack(inst, rng):
+    """Solve sign types as exact-2-in-4, then greedily choose magnitude-two edges."""
+    incident, degree3, constraints, variable_constraints = _flow_csp(inst)
+    assignment = [-1] * len(degree3)
