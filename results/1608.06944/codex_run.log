+        "shipping_instances": len(seeds),
+        "node_cap_per_instance": _DPLL_NODE_CAP,
+        "total_nodes": dpll_nodes,
+        "total_tuple_checks": dpll_tuple_checks,
+        "wall_clock_sec": dpll_seconds,
+        "solved": attack_success["gac_dpll_2500_nodes"],
+    }
+    report["G5_density_and_baseline"]["pass"] = (
+        report["G5_density_and_baseline"]["pass"] and all_failed
+    )
