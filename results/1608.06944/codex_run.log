+    def search():
+        remaining = [v for v, value in enumerate(assignment) if value < 0]
+        if not remaining:
+            return list(assignment)
+        variable = max(
+            remaining,
+            key=lambda v: sum(
+                sum(assignment[w] >= 0 for w, _ in constraints[c])
+                for c in variable_constraints[v]
+            ),
+        )
+        order = [0, 1]
+        rng.shuffle(order)
+        for value in order:
