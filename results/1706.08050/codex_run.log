+                        assignment[variable] = truth
+                        stats["unit_propagations"] += 1
+                        changed = True
+                    elif assignment[variable] != truth:
+                        return None
+            if not changed:
+                break
+        if all(value is not None for value in assignment):
+            return assignment
 
