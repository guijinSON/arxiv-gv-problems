-def _attack_outlier_degree(inst: dict) -> list[int]:
-    connector = inst["connector"]
-    degrees = {x: 0 for x in inst["field_labels"]}
-    for u, v in inst["source_edges"]:
-        if u != connector and v != connector:
-            degrees[u] += 1
-            degrees[v] += 1
-    ranked = sorted(degrees, key=lambda x: (-degrees[x], x))[:inst["n"]]
-    return sorted(ranked) + [connector]
-
-
-def _attack_greedy_cover(inst: dict) -> list[int]:
-    connector = inst["connector"]
-    uncovered = [
-        (u, v) for u, v in inst["source_edges"]
-        if u != connector and v != connector
-    ]
-    selected: set[int] = set()
-    while uncovered and len(selected) < inst["n"]:
-        counts: dict[int, int] = {}
-        for u, v in uncovered:
-            counts[u] = counts.get(u, 0) + 1
-            counts[v] = counts.get(v, 0) + 1
-        pick = min(counts, key=lambda x: (-counts[x], x))
-        selected.add(pick)
-        uncovered = [(u, v) for u, v in uncovered if pick not in (u, v)]
-    for value in sorted(inst["field_labels"]):
-        if len(selected) == inst["n"]:
-            break
-        selected.add(value)
-    return sorted(selected) + [connector]
-
