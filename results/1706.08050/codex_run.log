+        )
+        exact_xors += 2
+    bits = [solution[v] for v in range(inst["n"])]
+    return _answer_from_assignment(inst, bits), {
+        "decoded_equations": len(equations),
+        "scalar_gf2_xors": exact_xors,
+        "peeled_variables": len(peeled),
