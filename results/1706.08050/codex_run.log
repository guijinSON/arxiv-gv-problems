+    os.path.abspath(__file__)))))
+try:
+    from gvlib import exact_matrices, rationals
+except ImportError:  # The construction is deliberately standard-library-only.
+    exact_matrices = rationals = None
+
+
+TRACK: str = "B"
+
+FIELD_PRIME = 998244353
+PRIMITIVE_ROOT = 3
+
