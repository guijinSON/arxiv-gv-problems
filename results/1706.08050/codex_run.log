+             if attachment in selected),
+            None,
+        )
+        if omitted is None:
+            # Keep the right shape; verify will report the semantic failure.
+            omitted = 0
+        selected.update(
+            node for i, node in enumerate(clause["nodes"]) if i != omitted
+        )
+    return sorted(selected)
