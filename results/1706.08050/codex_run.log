+        "provisional shipping preset d=64 it uses 16,640 counted modular "
+        "multiplications/additions and about 0.0007 seconds on local CPython, "
+        "while the translated-binomial route uses 212 exact operations and "
+        "must first be recognized without a CAS."
+    ),
+    "max_answer_tokens": 179,
+}
+
+NATIVE: dict = {
