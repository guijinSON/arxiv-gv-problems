+def _equation_supports(n: int, rng: random.Random) -> list[list[int]]:
+    """Construct an invertible n-by-n GF(2) matrix with row weight three."""
+    order = list(range(n))
+    rng.shuffle(order)
+    supports = []
+    core = order[:4]
