+            for clause in block
+        ]
+        for block in inst["parity_blocks"]
+    ]
+    out["source_edges"] = [
+        list(_edge(mapping[u], mapping[v])) for u, v in inst["source_edges"]
+    ]
+    out["answer"] = sorted(mapping[vertex] for vertex in inst["answer"])
     return out
 
 
