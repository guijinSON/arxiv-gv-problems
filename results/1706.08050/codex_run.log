+
+
+def _require_parameters(n: int, clutter: int) -> None:
+    if not isinstance(n, int) or isinstance(n, bool) or n < 2:
+        raise ValueError("n must be an integer at least 2")
+    if n & (n - 1):
+        raise ValueError("n must be a power of two")
+    if (FIELD_PRIME - 1) % n:
+        raise ValueError("n must divide FIELD_PRIME-1")
+    if not isinstance(clutter, int) or isinstance(clutter, bool) or clutter < 0:
+        raise ValueError("clutter must be a nonnegative integer")
+    if clutter > n * n - 2 * n:
+        raise ValueError("clutter exceeds the available non-cycle cross edges")
+
+
+def _poly_for_center(center: int, degree: int) -> list[int]:
+    """Low-to-high coefficients of (x-center)^degree - 1 over GF(p)."""
+    p = FIELD_PRIME
+    coeffs = [
+        (math.comb(degree, k) * pow((-center) % p, degree - k, p)) % p
+        for k in range(degree + 1)
+    ]
+    coeffs[0] = (coeffs[0] - 1) % p
+    return coeffs
+
+
+def _poly_eval(coeffs: list[int], x: int, p: int = FIELD_PRIME) -> int:
+    value = 0
+    for coefficient in reversed(coeffs):
+        value = (value * x + coefficient) % p
+    return value
+
+
+def _root_coset(center: int, degree: int) -> list[int]:
+    p = FIELD_PRIME
+    omega = pow(PRIMITIVE_ROOT, (p - 1) // degree, p)
+    roots = []
+    value = 1
+    for _ in range(degree):
+        roots.append((center + value) % p)
+        value = (value * omega) % p
+    if len(set(roots)) != degree:
+        raise AssertionError("root of unity did not have the requested order")
+    return roots
+
+
+def _edge(u: int, v: int) -> tuple[int, int]:
+    return (u, v) if u < v else (v, u)
+
+
+def make_instance(n: int, seed: int = 0, clutter: int = 0, **params) -> dict:
+    """Inverse-generate and triangle-expand a connected vertex-cover instance.
+
+    ``n`` is both the number of roots and the number of decoy field vertices.
+    The answer length is n+1; ``clutter`` adds cross-part edges without changing
+    the witness.  Generation never searches for a transversal.
+    """
+    del params
+    _require_parameters(n, clutter)
+    rng = random.Random(seed)
+    p = FIELD_PRIME
+
+    center = rng.randrange(p)
+    roots = _root_coset(center, n)
+    root_set = set(roots)
+
+    decoys: list[int] = []
+    decoy_set: set[int] = set()
+    while len(decoys) < n:
+        value = rng.randrange(p)
+        if value not in root_set and value not in decoy_set:
+            decoy_set.add(value)
+            decoys.append(value)
+
+    root_order = list(roots)
+    decoy_order = list(decoys)
+    rng.shuffle(root_order)
+    rng.shuffle(decoy_order)
+
+    # An alternating Hamiltonian cycle has precisely the two color classes as
+    # its size-n vertex covers.  One extra root-root edge rules out the decoy
+    # class, so ``roots`` is the unique size-n cover of the field subgraph.
+    field_edges: set[tuple[int, int]] = set()
+    for i in range(n):
+        field_edges.add(_edge(root_order[i], decoy_order[i]))
+        field_edges.add(_edge(decoy_order[i], root_order[(i + 1) % n]))
+
+    while len(field_edges) < 2 * n + clutter:
+        field_edges.add(_edge(rng.choice(roots), rng.choice(decoys)))
+
+    a, b = rng.sample(roots, 2)
+    defect_edge = _edge(a, b)
+    field_edges.add(defect_edge)
+
+    connector = p  # outside GF(p), and larger than every field label
+    source_edges = set(field_edges)
+    for value in itertools.chain(roots, decoys):
+        source_edges.add(_edge(connector, value))
+
+    labels = roots + decoys
+    rng.shuffle(labels)
+    edge_list = [list(e) for e in source_edges]
+    rng.shuffle(edge_list)
+
+    answer = sorted(roots) + [connector]
+    return {
+        "paper": "arXiv:1706.08050",
+        "construction": "Theorem 4 at p=3 (triangle expansion)",
+        "field_prime": p,
+        "primitive_root": PRIMITIVE_ROOT,
+        "n": n,
+        "clutter": clutter,
+        "field_labels": labels,
+        "poly_coefficients_low_to_high": _poly_for_center(center, n),
+        "connector": connector,
+        "source_edges": edge_list,
+        "expanded_vertex_count": len(labels) + 1 + len(source_edges),
+        "answer": answer,
+    }
+
+
+def _answer_text(answer: list[int]) -> str:
+    return ", ".join(str(x) for x in answer)
+
+
+def render(inst: dict) -> str:
+    p = inst["field_prime"]
+    d = inst["n"]
+    labels = ", ".join(str(x) for x in inst["field_labels"])
+    coeffs = ", ".join(str(x) for x in inst["poly_coefficients_low_to_high"])
+    edges = "\n".join(
+        f"  ({'C' if u == p else u}, {'C' if v == p else v})"
+        for u, v in inst["source_edges"]
+    )
+    statement = f"""Connected odd-cycle transversal in a triangle-expanded graph
+
+All graphs here are finite, simple, undirected graphs.  A vertex set T is an
+odd-cycle transversal if deleting T leaves a bipartite graph (equivalently, a
+graph with no odd cycle).  T is connected if the subgraph induced by T is
+connected.
+
+The source graph H has one connector vertex C and the following {2*d} vertices,
+whose names are distinct elements of the finite field GF({p}):
+  {labels}
+
+Its complete source-edge list is:
+{edges}
+
+Construct the graph G as follows.  Start with every vertex and every edge of H.
+For each source edge e={{u,v}}, add one new vertex q_e and the two edges
+{{u,q_e}} and {{q_e,v}}.  There are no other vertices or edges.  Thus each
+source edge of H is the base of one triangle in G.  The subdivision vertices
+q_e are all distinct.
+
+The field labels also carry this exact public annotation.  Let
+  F(x) = c[0] + c[1]x + ... + c[{d}]x^{d}  over GF({p}),
+where all arithmetic, including coefficient reduction, is modulo {p}, and the
+coefficients c[0],...,c[{d}] in LOW-TO-HIGH order are:
+  {coeffs}
+The integer {inst['primitive_root']} is a primitive root modulo {p}.  This
+annotation is instance data; the validity definition remains the graph
+definition above.
+
+Find exactly {d+1} SOURCE vertices that form a connected odd-cycle transversal
+of G.  Your set must include C and exactly {d} of the displayed field-labelled
+vertices.  Do not output any q_e.  Encode C by the integer {p}.  Output the
+{d+1} distinct integers in strictly increasing order; order otherwise carries
+no meaning, and repetitions are forbidden.
+
+Give your final answer inside <answer></answer> tags, as comma-separated base-10
+integers.  Example: <answer>3, 17, 42</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    if not body:
+        return []
+    if body.startswith("[") and body.endswith("]"):
+        try:
+            value = json.loads(body)
+        except (TypeError, ValueError):
+            return None
+        if isinstance(value, list) and all(
+            isinstance(x, int) and not isinstance(x, bool) for x in value
+        ):
+            return value
+        return None
+    parts = [part.strip() for part in body.split(",")]
+    if not parts or any(not re.fullmatch(r"-?\d+", part) for part in parts):
+        return None
+    try:
+        return [int(part) for part in parts]
+    except ValueError:
+        return None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    if not isinstance(answer, list):
+        return False, "answer_not_a_list"
+    if not answer:
+        return False, "empty_answer"
+    expected = inst["n"] + 1
+    if len(answer) != expected:
+        return False, f"wrong_length_expected_{expected}"
+    if any(not isinstance(x, int) or isinstance(x, bool) for x in answer):
+        return False, "non_integer_label"
+    if len(set(answer)) != len(answer):
+        return False, "duplicate_label"
+
+    allowed = set(inst["field_labels"])
+    allowed.add(inst["connector"])
+    if any(x not in allowed for x in answer):
+        return False, "unknown_or_subdivision_vertex"
+    if answer != sorted(answer):
+        return False, "labels_not_strictly_increasing"
+    if answer[-1] != inst["connector"]:
+        return False, "mandatory_connector_missing"
+
+    chosen = set(answer)
+    for u, v in inst["source_edges"]:
+        if u not in chosen and v not in chosen:
+            return False, f"uncovered_source_edge_{u}_{v}"
+
+    # Every chosen field vertex is adjacent to the chosen connector in H, and
+    # all H edges remain in G, so G[answer] is connected.  Covering every source
+    # edge also means that after deletion every q_e has at most one remaining
+    # neighbor and no H edge remains: G-answer is a forest, hence bipartite.
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    chosen = rng.sample(inst["field_labels"], inst["n"])
+    return sorted(chosen) + [inst["connector"]]
+
+
+def search_space(inst: dict) -> int | None:
+    return math.comb(2 * inst["n"], inst["n"])
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space is None or space > 200_000:
+        return None
+    count = 0
+    connector = inst["connector"]
+    for subset in itertools.combinations(sorted(inst["field_labels"]), inst["n"]):
+        if verify(inst, list(subset) + [connector])[0]:
+            count += 1
+    return count
+
+
+def _center_from_coefficients(inst: dict) -> int:
+    # Coefficient of x^(d-1) in (x-a)^d-1 is -d*a.
+    p = inst["field_prime"]
+    d = inst["n"]
+    penultimate = inst["poly_coefficients_low_to_high"][-2]
+    return (-penultimate * pow(d, p - 2, p)) % p
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonical for input order, vertex numbering, and field translations.
+
+    Field values are semantic vertex tags, so arbitrary index renumbering merely
+    reorders ``field_labels`` and ``source_edges``.  The family's additional
+    coordinate symmetry x -> x+t is removed by translating the polynomial's
+    center to zero before serialising the tagged graph.
+    """
+    p = inst["field_prime"]
+    center = _center_from_coefficients(inst)
+
+    def norm(value: int) -> int:
+        return p if value == inst["connector"] else (value - center) % p
+
+    normalized_edges = sorted(
+        _edge(norm(u), norm(v)) for u, v in inst["source_edges"]
+    )
+    payload = {
+        "p": p,
+        "d": inst["n"],
+        "labels": sorted(norm(x) for x in inst["field_labels"]),
+        "edges": normalized_edges,
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(raw).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    n = int(params.get("n", 32))
+    clutter = int(params.get("clutter", 0))
+    maximum = n * n - 2 * n
+    if clutter < maximum:
+        # Grow misleading cross-part structure while the witness length stays
+        # fixed.  This is the preferred post-ladder axis.
+        return {"n": n, "clutter": min(maximum, clutter + max(128, n * 4))}
+    if n * 2 + 1 <= 256 and (FIELD_PRIME - 1) % (n * 2) == 0:
+        # Only after exhausting clutter do we lengthen the witness.
+        next_n = n * 2
+        return {"n": next_n, "clutter": min(next_n * 8, next_n * next_n - 2 * next_n)}
+    return "cap_bound"
+
+
+def _reference_polynomial_scan(inst: dict) -> tuple[list[int], dict[str, int]]:
+    coeffs = inst["poly_coefficients_low_to_high"]
+    p = inst["field_prime"]
+    roots = []
+    mul_add_operations = 0
+    evaluations = 0
+    for value in inst["field_labels"]:
+        acc = 0
+        for coefficient in reversed(coeffs):
+            acc = (acc * value + coefficient) % p
+            mul_add_operations += 2
+        evaluations += 1
+        if acc == 0:
+            roots.append(value)
+    return sorted(roots) + [inst["connector"]], {
+        "evaluations": evaluations,
+        "field_mul_add_operations": mul_add_operations,
+    }
+
+
+def _attack_outlier_degree(inst: dict) -> list[int]:
+    connector = inst["connector"]
+    degrees = {x: 0 for x in inst["field_labels"]}
+    for u, v in inst["source_edges"]:
+        if u != connector and v != connector:
+            degrees[u] += 1
+            degrees[v] += 1
+    ranked = sorted(degrees, key=lambda x: (-degrees[x], x))[:inst["n"]]
+    return sorted(ranked) + [connector]
+
+
+def _attack_greedy_cover(inst: dict) -> list[int]:
+    connector = inst["connector"]
+    uncovered = [
+        (u, v) for u, v in inst["source_edges"]
+        if u != connector and v != connector
+    ]
+    selected: set[int] = set()
+    while uncovered and len(selected) < inst["n"]:
+        counts: dict[int, int] = {}
+        for u, v in uncovered:
+            counts[u] = counts.get(u, 0) + 1
+            counts[v] = counts.get(v, 0) + 1
+        pick = min(counts, key=lambda x: (-counts[x], x))
+        selected.add(pick)
+        uncovered = [(u, v) for u, v in uncovered if pick not in (u, v)]
+    for value in sorted(inst["field_labels"]):
+        if len(selected) == inst["n"]:
+            break
+        selected.add(value)
+    return sorted(selected) + [connector]
+
+
+def _attack_random_restart(inst: dict, rng: random.Random, restarts: int = 256) -> list[int]:
+    candidate = random_candidate(inst, rng)
+    for _ in range(restarts):
+        candidate = random_candidate(inst, rng)
+        if verify(inst, candidate)[0]:
+            return candidate
+    return candidate
+
+
+def _attack_unshifted_binomial(inst: dict) -> list[int]:
+    p = inst["field_prime"]
+    d = inst["n"]
+    chosen = [x for x in inst["field_labels"] if pow(x, d, p) == 1]
+    chosen = sorted(chosen[:d])
+    for value in sorted(inst["field_labels"]):
+        if len(chosen) == d:
+            break
+        if value not in chosen:
+            chosen.append(value)
+    return sorted(chosen) + [inst["connector"]]
+
+
+def _pow_multiplications(exponent: int) -> int:
+    if exponent <= 0:
+        return 0
+    return max(0, exponent.bit_length() - 1) + max(0, exponent.bit_count() - 1)
+
+
+def _compact_route_operations(inst: dict) -> int:
+    p = inst["field_prime"]
+    d = inst["n"]
+    # Invert d by binary exponentiation, derive the center, exponentiate the
+    # primitive root once, then multiply around the d-element coset and translate.
+    return (
+        _pow_multiplications(p - 2)
+        + 1
+        + _pow_multiplications((p - 1) // d)
+        + (d - 1)
+        + d
+    )
+
+
+def _translated_instance(inst: dict, shift: int) -> dict:
+    p = inst["field_prime"]
+    out = {k: v for k, v in inst.items() if k != "answer"}
+    out["field_labels"] = [((x + shift) % p) for x in inst["field_labels"]]
+    translated_edges = []
+    for u, v in inst["source_edges"]:
+        uu = u if u == inst["connector"] else (u + shift) % p
+        vv = v if v == inst["connector"] else (v + shift) % p
+        translated_edges.append(list(_edge(uu, vv)))
+    out["source_edges"] = translated_edges
+    center = (_center_from_coefficients(inst) + shift) % p
+    out["poly_coefficients_low_to_high"] = _poly_for_center(center, inst["n"])
+    out["answer"] = sorted(
+        (x + shift) % p for x in inst["answer"] if x != inst["connector"]
+    ) + [inst["connector"]]
+    return out
+
+
+def _reordered_instance(inst: dict, seed: int) -> dict:
+    rng = random.Random(seed)
+    out = {k: v for k, v in inst.items()}
+    out["field_labels"] = list(inst["field_labels"])
+    out["source_edges"] = [list(edge) for edge in inst["source_edges"]]
+    rng.shuffle(out["field_labels"])
+    rng.shuffle(out["source_edges"])
+    return out
+
+
+def selftest() -> dict:
+    report: dict = {
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    g1_checks = 0
+    g1_failures = []
+    json_checks = 0
+    for preset, parameters in DIFFICULTY.items():
+        for seed in range(5):
+            inst = make_instance(seed=seed, **parameters)
+            ok, reason = verify(inst, inst["answer"])
+            g1_checks += 1
+            if not ok:
+                g1_failures.append(f"{preset}:{seed}:{reason}")
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_checks += 1
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures and json_checks == g1_checks,
+        "checks": g1_checks,
+        "json_native_checks": json_checks,
+        "failures": g1_failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=424242, **ship_params)
+    answer = list(inst["answer"])
+    corruptions = {
+        "drop_one": answer[:-1],
+        "swap_two": answer[:1] + [answer[2], answer[1]] + answer[3:],
+        "duplicate": answer[:-2] + [answer[-2], answer[-2]],
+        "empty": [],
+        "out_of_range": [-1] + answer[1:],
+    }
+    corruption_results = {
+        name: verify(inst, value) for name, value in corruptions.items()
+    }
+    reasons = [reason for ok, reason in corruption_results.values() if not ok]
+    report["G2_rejects_corruption"] = {
+        "pass": (
+            all(not ok for ok, _ in corruption_results.values())
+            and len(set(reasons)) == len(corruptions)
+        ),
+        "cases": {
+            name: {"accepted": ok, "reason": reason}
+            for name, (ok, reason) in corruption_results.items()
+        },
+    }
+
+    model_style = (
+        "I used the triangle bases as the source constraints.\n```text\n"
+        f"<answer>{_answer_text(answer)}</answer>\n```\n"
+        "The connector makes the selected source vertices connected."
+    )
+    parsed = parse_answer(model_style)
+    render_example = parse_answer(render(inst))
+    report["G3_round_trip"] = {
+        "pass": parsed == answer and render_example is not None,
+        "realistic_response_round_trips": parsed == answer,
+        "renderer_example_parses": render_example is not None,
+        "garbage_returns_none": parse_answer("not an answer") is None,
+    }
+
+    samples = 200_000
+    guess_rng = random.Random(0x170608050)
+    hits = 0
+    for _ in range(samples):
+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            hits += 1
+    space = search_space(inst)
+    report["G4_guess_resistance"] = {
+        "pass": hits / samples < 1e-6,
+        "hits": hits,
+        "total": samples,
+        "observed_probability": hits / samples,
+        "structure_aware_space": space,
+        "sampling_prior": (
+            "uniform size-d subsets of the displayed 2d source vertices, with "
+            "the mandatory connector, strict ordering, and distinctness enforced"
+        ),
+    }
+
+    start = time.perf_counter()
+    reference, reference_stats = _reference_polynomial_scan(inst)
+    reference_wall = time.perf_counter() - start
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    exact_solution_count = 1  # alternating-cycle proof in make_instance
+    exact_fraction = exact_solution_count / space
+    report["G5_density_and_baseline"] = {
+        "pass": (
+            verify(inst, reference)[0]
+            and demo_count == 1
+            and exact_fraction < 1e-6
+        ),
+        "shipping_exact_solution_count": exact_solution_count,
+        "shipping_exact_solution_fraction": exact_fraction,
+        "shipping_sampled_valid_hits": hits,
+        "shipping_density_samples": samples,
+        "demo_exact_solution_count": demo_count,
+        "baseline_wall_seconds": round(reference_wall, 6),
+        "baseline_field_operations": reference_stats["field_mul_add_operations"],
+        "baseline_vertex_evaluations": reference_stats["evaluations"],
+    }
+
+    attacks = {
+        "outlier_degree": {"successes": 0, "attempts": 0},
+        "greedy_highest_uncovered_degree": {"successes": 0, "attempts": 0},
+        "random_restart_256": {"successes": 0, "attempts": 0},
+        "in_context_unshifted_binomial": {"successes": 0, "attempts": 0},
+    }
+    ref_successes = 0
+    ref_times = []
+    ref_operations = []
+    for seed in range(8100, 8108):
+        attacked = make_instance(seed=seed, **ship_params)
+        candidates = {
+            "outlier_degree": _attack_outlier_degree(attacked),
+            "greedy_highest_uncovered_degree": _attack_greedy_cover(attacked),
+            "random_restart_256": _attack_random_restart(
+                attacked, random.Random(seed ^ 0xC0FFEE), 256
+            ),
+            "in_context_unshifted_binomial": _attack_unshifted_binomial(attacked),
+        }
+        for name, candidate in candidates.items():
+            attacks[name]["attempts"] += 1
+            if verify(attacked, candidate)[0]:
+                attacks[name]["successes"] += 1
+        t0 = time.perf_counter()
+        candidate, stats = _reference_polynomial_scan(attacked)
+        ref_times.append(time.perf_counter() - t0)
+        ref_operations.append(stats["field_mul_add_operations"])
+        if verify(attacked, candidate)[0]:
+            ref_successes += 1
+    all_failed = all(result["successes"] == 0 for result in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and ref_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": {
+            "name": "generic Horner evaluation at every labelled field vertex",
+            "complexity": "O(d^2) exact GF(p) operations on 2d labels",
+            "median_wall_clock_sec": round(statistics.median(ref_times), 6),
+            "median_operations": int(statistics.median(ref_operations)),
+            "operation_definition": "one modular multiplication or addition",
+            "solves": f"{ref_successes}/8, as expected",
+        },
+    }
+
+    doubled_params = {
+        "n": ship_params["n"] * 2,
+        "clutter": min(
+            ship_params["clutter"] * 2,
+            (ship_params["n"] * 2) ** 2 - 4 * ship_params["n"],
+        ),
+    }
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and search_space(doubled) > space,
+        "shipping_n": ship_params["n"],
+        "shipping_clutter": ship_params["clutter"],
+        "doubled_n": doubled_params["n"],
+        "doubled_clutter": doubled_params["clutter"],
+        "shipping_space_bits": space.bit_length() - 1,
+        "doubled_space_bits": search_space(doubled).bit_length() - 1,
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariant_checks = 0
+    carried_checks = 0
+    keys = []
+    for seed in range(9200, 9220):
+        original = make_instance(seed=seed, **ship_params)
+        key = canonical_key(original)
+        keys.append(key)
+        reordered = _reordered_instance(original, seed ^ 0xABC)
+        translated = _translated_instance(original, (seed * 7919 + 17) % FIELD_PRIME)
+        composed = _reordered_instance(translated, seed ^ 0xDEF)
+        for transformed in (reordered, translated, composed):
+            invariant_checks += 1
+            if canonical_key(transformed) != key:
+                break
+        else:
+            ok_reordered = verify(reordered, reordered["answer"])[0]
+            ok_translated = verify(translated, translated["answer"])[0]
+            ok_composed = verify(composed, composed["answer"])[0]
+            carried_checks += int(ok_reordered) + int(ok_translated) + int(ok_composed)
+    report["G8_canonical_key"] = {
+        "pass": (
+            invariant_checks == 60
+            and carried_checks == 60
+            and len(set(keys)) == 20
+        ),
+        "invariance_checks": invariant_checks,
+        "carried_witness_checks": carried_checks,
+        "unrelated_distinct_keys": len(set(keys)),
+        "unrelated_instances": 20,
+        "transformations": [
+            "input vertex/edge reorder",
+            "global GF(p) translation with carried polynomial and witness",
+            "translation composed with input reorder",
+        ],
+    }
+
+    answer_blob = json.dumps(inst["answer"])
+    answer_chars = len(answer_blob)
+    answer_atoms = len(inst["answer"])
+    answer_tokens = math.ceil(answer_chars / 4)
+    intended_ops = _compact_route_operations(inst)
+    arms = G9_RESULTS["arms"]
+    hinted = arms["hinted"]
+    placebo = arms["placebo"]
+    hinted_rate = hinted["solved"] / max(1, hinted["attempts"])
+    placebo_rate = placebo["solved"] / max(1, placebo["attempts"])
+    hinted_hardened = G9_RESULTS.get("hinted_verdict") == "hardened"
+    within_caps = answer_chars <= 2000 and answer_atoms <= 256 and intended_ops <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_hardened and within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_RESULTS.get("hinted_verdict", "pending"),
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_atoms,
+        "intended_route_operations": intended_ops,
+        "caps_pass": within_caps,
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(gate.get("pass") for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
