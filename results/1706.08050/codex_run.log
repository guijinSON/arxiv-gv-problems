+    "The field polynomial is a translated binomial whose zero set is a "
+    "multiplicative coset."
+)
+PLACEBO_HINT: str = (
+    "The field labels and edge list reward consistent use of the stated "
+    "conventions."
+)
+
+PROBLEM_PROFILE: dict = {
