+        "observed_probability": fraction,
+        "candidate_space": search_space(ship),
+        "sampler": "uniform over parity-constrained cubic certificates",
+    }
+
+    demo = make_instance(seed=17, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    baseline_times = []
+    baseline_counts = []
+    baseline_ok = True
+    for seed in range(8):
