                    \Edges(y_2,y_1)
                    
                    \draw (-1.7,1.3) rectangle (1.7,1.7);
                    \draw (0,0) circle [x radius=3.7cm, y radius=0.4cm];
            \end{tikzpicture}
            \caption{To reconfigure $A = \{x_2,y_2\}$ into $M(s,t) = \{a, b\}$, we need to swap $x_2$ with $x_1$, $y_2$ with $y_1$, $x_1$ with $a$, and finally $y_1$ with $b$.\label{fig:parallel_pair}}
