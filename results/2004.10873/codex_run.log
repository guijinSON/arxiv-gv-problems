+        "P(x)=D*x^3+B*x^2+A*x+C modulo q, where q is the displayed power "
+        "of two, D and B are even, and A is odd."
+    ),
+    "bounds": {
+        "coefficient_count": 4,
+        "coefficient_minimum": 0,
+        "coefficient_maximum": "q-1",
+        "D_parity": "even",
+        "B_parity": "even",
+        "A_parity": "odd",
