   378	\begin{lemma}
   379	    \label{lem:serial_pair}
   380	    If $s,t$ form a serial pair on $G$, then, under TJ, any minimal $st$-separator $A$ can be reconfigured into a separator that contains $M(s,t)$.
   381	\end{lemma}
   382	
   383	\begin{proof}
   384	    Let $\{a,z\} = M(s,t)$ such that $e_i = ab$, $z \in V(G)$, $\supp(z) = e_i$, $\supp(t)$ is either $az$ or a descendant of $az$, $\supp(s)$ is either $zb$ or a descendant of it, and $F = \angled{f_\ell, \dots, f_p}$ be the suffix of $\espan(t)$ beginning at $f_\ell = az$; moreover, $A$ does not intersect any $f_i$ of the suffix, otherwise we could reconfigure it to $\{a, z\}$ as done in Lemma~\ref{lem:span_separator}, and $A$ does not contain a piece of an edge that is a descendant of $\supp(t)$, otherwise we could move this piece to the suitable endpoint of $\supp(t)$.
   385	    
   386	    
   387	    Suppose that neither $a$ nor $z$ are reachable from $t$ on $G \setminus A$, implying that $A$ is a subset of the pieces of $f_\ell$.
   388	    Note that, because of our last observation on the previous paragraph, neither $a$ nor $z$ are endpoints of $\supp(t)$.
   389	    By Lemma~\ref{lem:span_separator}, we can reconfigure $A$ to contain $\{a,z\}$.
   390	    
   391	    If exactly one of $\{a,z\}$ is reachable from $t$, there is at least one piece of $f_\ell = az$ in $A$ that destroys the paths to one of the endpoints of $f_\ell$, \textit{but not to the other}. Thus, we can freely move any piece of $az$ to the unreachable endpoint of $f_\ell$ without creating any $s-t$ paths.
   392	    
   393	    The only case left, is if both $a$ and $z$ are reachable from $t$.
   394	    If $b$ is not reachable, then $A$ contains a piece $w$ of edges other than $e_i$; thus, if we pick any of these pieces and move to $a$, vertex $b$ remains unreachable and so does $s$: any $z-b$ path that does not use pieces of $az$ is internally vertex disjoint with any $a-b$ path that does not uses pieces of $az$, and moving a piece of such an $a-b$ path does not create a $z-b$ path on $G \setminus (A \cup \{a\} \setminus \{w\})$.
   395	    If, on the other hand, $b$ is reachable, then $A$ is a subset of the pieces of $zb$, and, moreover, neither $b$ nor $z$ are reachable from $s$ on $G \setminus A$.
   396	    By the second paragraph, we can reconfigure $A$ to contain $\{b,z\}$, but in this case the reconfigured separator would intersect $F$, and we can move the token on $b$ to $a$ and obtain $M(s,t)$.
   397	\end{proof}
   398	
   399	\begin{lemma}
   400	    \label{lem:sequential_pair}
   401	    If $s,t$ form a sequential pair on $G$, then, under TJ, any minimal $st$-separator $A$ can be reconfigured into a separator that contains $M(s,t)$.
   402	\end{lemma}
   403	
   404	\begin{proof}
   405	    Let $e_i = sa$ be the support of $t$ and $V(s,t)$ be the set of vertices $z_j$ that have an $st$-edge as their support.
   406	    Let $A_s$ be the set of pieces of $st$-edges in $A$, and $A_a$ the set of pieces of $ta$-edges in $A$.
   407	    Since $s$ cannot be adjacent to any piece $w$ of $ta$, any $s-w$ path between either contains $t$ or $a$; since no $s-t$ paths exist in $G \setminus A$, if $w \in A_a$, we can move the token on $w$ to $a$ without creating any $s-t$ path.
   408	    Now, for each edge $e_j = st$, since the $s-t$ paths that contain a piece of $e_j$ are internally vertex disjoint, there must be at least one $w_j \in A_s$, but we can move the token on $w_j$ to $z_j$ without creating any $s-t$ path since no piece of $sz_j$ can be adjacent to a piece of $z_jt$.
   409	    After placing tokens on all $z_j$'s, any other token can be moved to $a$, thus obtaining $M(s,t)$.
   410	\end{proof}
