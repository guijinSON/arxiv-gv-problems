+            candidate = _candidate_from_order(guessed_order, n)
+            attack_results[name]["successes"] += int(verify(inst, candidate)[0])
+        restart_rng = random.Random(700_000 + seed)
+        restart_hit = False
+        fast_prereq, _ = _prerequisites(inst)
+        for _ in range(256):
