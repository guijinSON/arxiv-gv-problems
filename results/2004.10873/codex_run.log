"""Verified generator for Eppstein's integer-coordinate "flaps and flips".

The construction composes disjoint copies of the edge gadget in Section 5.2
of arXiv:2410.07666.  In each copy, consecutive hinged squares block one
another, so reversing the copy requires its flaps to be flipped in path order.
The certificate is sampled first as an affine orbit of the flap labels; the
geometric gadgets are then assembled around consecutive orbit segments.

Only the Python standard library is used.  Importing this module performs no
I/O, network access, random sampling, or printing.
"""

from __future__ import annotations

import hashlib
import itertools
import json
import math
import os
import random
import re
import time
from collections import defaultdict
from typing import Any


TRACK = "B"

PROBLEM_PROFILE = {
    "native_domain": "geometry",
    "object_regime": "integer_lattice",
    "computational_core": "permutation",
    "certificate_form": "integer_tuple",
    "native_objects": [
        "equal square flaps with integer-coordinate hinges",
        "two flat-folded flap states",
    ],
    "verification_operations": [
        "exact integer rectangle-hinge intersection",
        "blocking-precedence extraction",
        "exact sequence replay as a topological order",
    ],
    "domain_essentiality": "native",
    "reduction_kind": "none",
    "reduction": None,
    "reduction_source": "paper_central",
    "intuition_type": "invariant",
    "intuition_description": (
        "The labels encountered along the independently flippable edge gadgets "
        "are consecutive points of one hidden affine orbit modulo n; without "
        "that invariant one must reconstruct blocking from all hinge pairs."
    ),
    "hardness_basis": (
        "Track B: exact all-pairs hinge-incidence extraction followed by Kahn "
        "topological sorting is O(n^2); the final shipping measurement is "
        "recorded by selftest(), while the affine-orbit route uses n+4 exact "
        "modular operations."
    ),
    "max_answer_tokens": 220,
}

NATIVE = {
    "domain": PROBLEM_PROFILE["native_domain"],
    "core": PROBLEM_PROFILE["computational_core"],
    "objects": PROBLEM_PROFILE["native_objects"],
    "intuition": (
