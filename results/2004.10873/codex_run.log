   323	
   324	\begin{lemma}
   325	    \label{lem:parallel_pathway}
   326	    For any $s,t \in V(G)$ and minimal $st$-separator $A$, if there is some $w \in A$ such that $w,t$ form a parallel pair with respect to $x,y$, $x,y \notin A$, and $s$ is not a piece of the same $xy$-edge as $w$, then, on $G \setminus A$, $x$ is reachable from $t$, $y$ is not, and, on $G \setminus (A \setminus \{w\})$, every $t-s$ path contains $x$, $w$, and $y$, in this order.
   327	\end{lemma}
   328	
   329	\begin{proof}
   330	    Suppose $x$ is reachable from $t$ on $G \setminus A$; if none were reachable, then there would not be any need for $w$, since any $t-w$ path contains at least one of $x,y$, contradicting the minimality of $A$.
   331	    On the other hand, if both $x,y$ were reachable, then $A \setminus \{w\}$ would also be an $st$-separator since $s$ is not a piece of the same $xy$-edge as $w$, any $s-t$ path that passes through $w$ must pass through \emph{both} $x$ and $y$.
   332	    As such, only $x$ is reachable from $t$.
   333	    Now, for the second statement, there is no $x-s$ path on $G \setminus A$ but, because $A$ is minimal, every $s-t$ path on $G \setminus (A \setminus \{w\})$ must contain $w$ and, since $s$ is not a piece of the same $xy$-edge as $w$, every $s-t$ path on $G \setminus (A \setminus \{w\})$ is of the form $t-x-w-y-s$.
   334	\end{proof}
   335	
   336	\begin{lemma}
   337	    \label{lem:span_separator}
   338	    For any $s,t \in V(G)$, let $e_j = az$ be any edge such that $t$ is a piece of $e_j$ but $s$ is not a piece nor an endpoint of $e_j$, and $F = \angled{f_\ell, \dots, f_p}$ be the suffix of $\espan(t)$ where $f_\ell = e_j$.
   339	    If $A$ is a minimal $st$-separator contained in the set of pieces of $e_j$, then $A$ can be reconfigured to a separator that contains one vertex that is an endpoint of some $f_i \in F$ and, consequently, $A$ can be reconfigured to a separator that contains $\{a,z\}$.
   340	\end{lemma}
   341	
   342	\begin{proof}
   343	    Let us first show that if $A$ contains one endpoint of edge $f_i \in F$, then we can reconfigure $A$ into a separator that contains $a,z$.
   344	    If this is the case, we can move any other token to the other endpoint of $f_i$; by Observation~\ref{obs:edge_sep}, the new set is still an $st$-separator.
   345	    At this point, since $f_i \cap f_{i-1} = x_i$ for all $i$, we can iteratively move the token in $f_{i-1} \setminus \{x_i\}$ to $f_i \setminus \{x_i\}$ until we obtain $f_\ell = az$.
   346	    For the remainder of this proof, we assume that $A$ does not intersect any of the endpoints of the edges in $F$.
   347	    
   348	    If $\supp(t) = \{x,y\}$ and there is some $w \in A$ that is a piece of an $xt$-edge, simply move the token on $w$ to $x$: the resulting set is still a separator since every $s-t$ path that contains $w$ necessarily contains $x$.
   349	    We may now assume that $A$ contains no piece of the support of $t$.
   350	    
   351	    Suppose now that there is some $w \in A$ such that $t,w$ are parallel with respect to $x,y$ and let $f_i \in F$ be an $xy$-edge.
   352	    By Lemma~\ref{lem:parallel_pathway}, which has its conditions satisfied, every $s-t$ path in $G \setminus (A \setminus \{w\})$ is of the form $t-x-w-y-s$ and we conclude that $A \cup \{x\} \setminus \{w\}$ is an $st$-separator.
   353	    
   354	    If there is no vertex of $A$ forming a parallel pair with $t$, let $f_i = xy$ be the edge of largest index in $F$ such that $x$ is unreachable from $t$ but $y$ is; note that there must be one such edge since $\supp(t)$ is reachable but neither $a$ nor $z$ are and $f_i \cap f_{i+1} \neq \emptyset$.
   355	    By this argument, it must be that $f_{i+1} = wy$, that $w$ is reachable from $t$ on $G \setminus A$ and that edge $xw$ has at least one piece, otherwise $x$ would be reachable.
   356	    Furthermore, there is no $xy \in E(G)$ nor any other $xy$-edge in $(G_1, \dots, G_k)$: if there was such an edge it would have to be the target of an $S$ operation, but in this case pieces of this edge would have been required to block any $y-x$ path in $G \setminus A$, thus there would be some piece forming a parallel pair with $t$.
   357	    As such, for $x$ to be unreachable, there must be at least one piece of $xw$ in $A$.
   358	    Moving this piece to $x$ does not create any $s-t$ path and the new separator now contains a vertex of $f_i$.
   359	\end{proof}
   360	
   361	\begin{lemma}
   362	    \label{lem:parallel_pair}
   363	    If $s,t$ form a parallel pair on $G$, then, under TJ, any minimal $st$-separator $A$ can be reconfigured into a separator that contains $M(s,t)$.
   364	\end{lemma}
   365	
   366	\begin{proof}
   367	    Let $s,t$ be a parallel pair with respect to $a,b$ such that $s$ is a piece of $e_s = ab$ and $t$ a piece of $e_t = ab$.
   368	    At first, $A$ can intersect pieces of any edge of the graph, but we can partition $A$ in $\{A_s, A_t, A^*\}$, where $A_s$ are the pieces of $e_s$ in $A$, $A_t$ the pieces of $e_t$, and $A^* = A \setminus A_s \setminus A_t$.
   369	        
   370	    If $A = A_t$ or $A = A_s$, i.e. $A$ is a subset of the pieces of $e_t$ or $e_s$, we can apply Lemma~\ref{lem:span_separator} and, noting that, in both cases the suffix of both spans begin at an $ab$-edge, we are done.
   371	    On the other hand, if $A^* \neq \emptyset$, then there must be, say, $s-a$ paths on $G \setminus A$, but no $s-b$ path, and $t-b$ paths but no $t-a$ path on $G \setminus A$, implying that $A_s, A_t \neq \emptyset$.
   372	    In this case, we can move any token from $A_s$ to $b$ without creating any $s-t$ path, then move any other token to $a$ to obtain $M(s,t)$.
   373	    The case $A^* = \emptyset$ but $A_s, A_t \neq \emptyset$ is only possible if the only $a-b$ paths on $G$ pass through $e_s$ or $e_t$; i.e., $a,b \in V(G_1)$.
   374	    The argument, however, is the same as in the previous case: $A$ destroys every $s-b$ and $t-a$ paths, but since the only $s-t$ paths are precisely $s-a-t$ and $s-b-t$, moving a token in $A_s$ to $b$ and then another to $a$ suffices to construct $M(s,t)$.
   375	\end{proof}
