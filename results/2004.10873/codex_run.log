+    }
+
+    attack_names = list(_attack_orders(ship)) + ["random_polynomial_restart_256"]
+    attack_results = {name: {"successes": 0, "attempts": 8} for name in attack_names}
+    ref_successes = 0
+    ref_times = []
+    ref_operations = []
+    for seed in range(8):
