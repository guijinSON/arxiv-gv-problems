\title{Some results on Vertex Separator Reconfiguration}
\author{Guilherme C. M. Gomes$^{2}$, S\'{e}rgio H. Nogueira$^{1,3}$, Vinicius F. dos Santos$^{1,2}$}
\affil{\small \textsuperscript{1}Centro Federal de Educação Tecnológica de Minas Gerais - Belo Horizonte, Brazil\\
\textsuperscript{2}Departamento de Ci\^{e}ncia da Computa\c{c}\~{a}o, Universidade Federal de Minas Gerais - Belo Horizonte, Brazil\\
