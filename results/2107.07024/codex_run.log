        json.dumps(make_instance(seed=seed, **shipping_params)["answer"])
        for seed in range(100)
    ]
    answer_chars = max(map(len, answer_blobs))
    answer_tokens = math.ceil(answer_chars / 4)
    answer_elements = _answer_atoms(shipping["answer"])

