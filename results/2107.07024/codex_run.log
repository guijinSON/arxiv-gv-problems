+        counts["greedy_left_to_right_no_backtracking"] += int(_attack_greedy_left_to_right(instance))
+        counts["random_restart_256"] += int(_attack_random_restart(instance, seed))
+        counts["consecutive_midpoint_shift_ansatz"] += int(
