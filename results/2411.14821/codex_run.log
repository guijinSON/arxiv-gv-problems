+        "doubled_n": doubled_params["n"],
+        "base_search_space": base_space,
+        "doubled_search_space": doubled_space,
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    real_transform_checks = 0
+    unrelated_keys = []
+    g8_failures = []
+    for seed in range(20):
