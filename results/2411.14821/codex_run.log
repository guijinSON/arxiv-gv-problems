+            transformed = _transform_instance(instance, element_perm, set_perm)
+            invariance_checks += 1
+            if canonical_key(transformed) != base_key:
+                g8_failures.append({"seed": seed, "kind": "key_changed"})
+            ok, reason = verify(transformed, transformed["answer"])
