+        "hits": hits,
+        "total": total,
+        "hits_over_total": f"{hits}/{total}",
+        "measured_probability": hits / total,
+        "sampler": "uniform n-subset of in-range gadget indices",
+        "naive_space": search_space(shipping),
+    }
+
+    small_params = DIFFICULTY["small"]
+    sparse_rows = []
+    sparse_pass = True
+    for seed in range(3):
