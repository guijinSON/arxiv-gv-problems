+        "n": n,
+        "degree": degree,
+        "element_count": element_count,
+        "sets": [list(t) for t in triples],
+        "answer": planted,
+    }
+
+
+def render(inst: dict) -> str:
+    n = int(inst["n"])
+    degree = int(inst["degree"])
+    element_count = int(inst["element_count"])
+    triples = inst["sets"]
