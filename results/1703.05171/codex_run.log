+    eligible = _eligible_ids(inst)
+    steps = 0
+    for _ in range(restarts):
+        order = list(eligible)
+        rng.shuffle(order)
+        candidate, used = _greedy_from_order(inst, order)
+        steps += used
+        if candidate is not None and verify(inst, candidate)[0]:
+            return True, steps
+    return False, steps
