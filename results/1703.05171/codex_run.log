+            if canonical_key(moved) != base_key:
+                failures.append(f"key/{seed}/{number}")
+            witness_checks += 1
+            if not verify(moved, moved["answer"])[0]:
+                failures.append(f"witness/{seed}/{number}")
+    distinct_keys = len(set(unrelated_keys))
