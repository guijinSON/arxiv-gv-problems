+    return {
+        "n": block_count,
+        "length": length,
+        "code_size": k,
+        "word_weight": block_count,
+        "min_distance": 2 * block_count,
+        "decoy_orbits": decoys,
+        "candidate_count": len(all_words),
+        "hex_width": width,
+        "permutation": permutation,
+        "words": [format(word, f"0{width}x") for word in all_words],
+        "anchor": anchor_id,
