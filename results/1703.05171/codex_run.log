+}
+
+DIFFICULTY = {
+    "demo": {"n": 3, "code_size": 3, "decoy_orbits": 2},
+    "easy": {"n": 8, "code_size": 5, "decoy_orbits": 12},
+    "medium": {"n": 16, "code_size": 7, "decoy_orbits": 60},
+    "hard": {"n": 38, "code_size": 7, "decoy_orbits": 220},
+}
+SHIPPING_DIFFICULTY = "hard"
