+
+        t0 = time.perf_counter()
+        success, steps = _random_restart_greedy(inst, random.Random(seed ^ 0xC0DE), 256)
+        elapsed = time.perf_counter() - t0
+        stat = attacks["random_restart_greedy_256"]
+        stat["attempts"] += 1
+        stat["successes"] += int(success)
+        stat["steps"] += steps
