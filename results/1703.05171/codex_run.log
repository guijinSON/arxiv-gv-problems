+        stat["steps"] += steps
+        stat["wall_clock_sec"] += elapsed
+
+        t0 = time.perf_counter()
+        candidate, steps = _greedy_from_order(inst, list(range(inst["candidate_count"])))
+        elapsed = time.perf_counter() - t0
