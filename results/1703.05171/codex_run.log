/bin/bash -lc "python3 - <<'PY'
import importlib.util, json, os, random
p='gen_1703_05171.py'
s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.TRACK in {'A','B'}
params=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
a=g.make_instance(seed=4242,**params); b=g.make_instance(seed=4242,**params)
assert a==b
assert json.loads(json.dumps(a['answer']))==a['answer']
assert g.verify(a,a['answer'])==(True,'ok')
assert g.parse_answer('<answer>'+json.dumps(a['answer'])+'</answer>')==a['answer']
assert g.canonical_key(a)==g.canonical_key(b)
r=g.selftest(); assert r['all_passed']
print('interface/determinism/json/selftest: PASS')
print('shipping',g.SHIPPING_DIFFICULTY,params)
print('answer',len(json.dumps(a['answer'],separators=(',',':'))),'chars',len(a['answer']),'atoms')
print('render',len(g.render(a)),'chars')
print('escalate',g.escalate(dict(params)))
