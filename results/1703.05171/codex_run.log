+        "tagged_matches": parsed == answer,
+        "fenced_matches": fenced == answer,
+        "garbage_returns_none": parse_answer("no answer here") is None,
+    }
+
+    guess_rng = random.Random(0x170305171)
+    guess_total = 200_000
