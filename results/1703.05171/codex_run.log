+                (plant_offsets[column] + deltas[column]) % k
+                for column in range(block_count)
+            )
+            origin = offsets[0]
+            key = tuple((value - origin) % k for value in offsets)
+            if key not in orbit_keys:
+                orbit_keys.add(key)
