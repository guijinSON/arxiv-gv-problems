+    duplicated = list(answer)
+    duplicated[1] = duplicated[0]
+    out_of_range = list(answer)
+    out_of_range[-1] = ship["candidate_count"]
+    corruptions = {
+        "drop": answer[:-1],
+        "swap": swapped,
+        "duplicate": duplicated,
+        "empty": [],
