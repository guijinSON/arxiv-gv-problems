+    """Plausible visual ansatz: inspect anchor-near IDs before distant lines."""
+    anchor = inst["anchor"]
+    eligible = _eligible_ids(inst)
+    order = sorted(eligible, key=lambda index: (abs(index - anchor), index))
+    return _greedy_from_order(inst, order)
