import random, time, statistics

def triangular(q, seed):
    root_edges=[(i,j) for i in range(q) for j in range(i+1,q)]
    rng=random.Random(seed)
    perm=list(range(len(root_edges))); rng.shuffle(perm)
    rel=[None]*len(root_edges)
    for old,new in enumerate(perm): rel[new]=root_edges[old]
    adj=[set() for _ in rel]
    for a in range(len(rel)):
        x,y=rel[a]
        for b in range(a):
            u,v=rel[b]
            if x==u or x==v or y==u or y==v:
                adj[a].add(b); adj[b].add(a)
    return adj, rel

def verify_path(adj,p):
    return len(p)==len(adj) and len(set(p))==len(p) and all(p[i+1] in adj[p[i]] for i in range(len(p)-1))

def greedy(adj, mode, seed=0):
    n=len(adj); rng=random.Random(seed)
    starts=list(range(n))
    if mode=='random': rng.shuffle(starts)
    else: starts.sort(key=lambda v:(len(adj[v]),v))
    for s in starts[:min(n,32)]:
        path=[s]; used={s}
        while len(path)<n:
            cand=[v for v in adj[path[-1]] if v not in used]
            if not cand: break
            if mode=='first': v=min(cand)
            elif mode=='warnsdorff': v=min(cand,key=lambda x:(sum(y not in used for y in adj[x]),x))
            else:
                m=min(sum(y not in used for y in adj[x]) for x in cand)
                near=[x for x in cand if sum(y not in used for y in adj[x])==m]
                v=rng.choice(near)
            path.append(v); used.add(v)
        if verify_path(adj,path): return path
    return None
for q in [7,11,15,21]:
    n=q*(q-1)//2
    print('q,n',q,n)
    for mode in ['first','warnsdorff','random']:
        ok=0; ts=[]
        for seed in range(20):
            adj,_=triangular(q,seed)
            t=time.perf_counter(); p=greedy(adj,mode,seed+1000); ts.append(time.perf_counter()-t)
            ok+=bool(p)
        print(mode,ok,'/20', 'med',statistics.median(ts))
