import random,time,statistics,json

def instance(q,seed):
    root=[(i,j) for i in range(q) for j in range(i+1,q)]
    rng=random.Random(seed); rng.shuffle(root)
    inc=[[] for _ in range(q)]
    for i,(u,v) in enumerate(root):inc[u].append(i);inc[v].append(i)
    adj=[set() for _ in root]
    for xs in inc:
        for a,x in enumerate(xs):
            for y in xs[:a]:adj[x].add(y);adj[y].add(x)
    return adj

def attack(adj,seed):
    rng=random.Random(seed); n=len(adj); starts=list(range(n));rng.shuffle(starts)
    probes=0; decisions=0
    for s in starts[:32]:
        path=[s]; used={s}
        while len(path)<n:
            cand=[]
            for v in adj[path[-1]]:
                probes+=1
                if v not in used:cand.append(v)
            if not cand:break
            scored=[]
            for v in cand:
                rem=0
                for w in adj[v]:
