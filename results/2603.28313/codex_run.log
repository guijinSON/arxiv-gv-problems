+    sessions = []
+    for session in inst["sessions"]:
+        matrix = session["matrix"]
+        ciphertext = session["ciphertext"]
+        sessions.append(
+            {
+                "matrix": [
+                    [matrix[1][1], matrix[1][0]],
+                    [matrix[0][1], matrix[0][0]],
+                ],
+                "ciphertext": [ciphertext[1], ciphertext[0]],
+            }
+        )
+    transformed["sessions"] = sessions
+    transformed["answer"] = [
+        inst["answer"][0],
+        inst["answer"][2],
+        inst["answer"][1],
+    ]
+    return transformed
