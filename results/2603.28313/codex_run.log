+    all_failed = all(
+        result["successes"] == 0 and result["attempts"] >= 8
+        for result in attack_counts.values()
+    )
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_solves == 8,
+        "attacks": attack_counts,
