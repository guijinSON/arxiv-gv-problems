+        "cases": corruption_results,
+        "distinct_reasons": len(set(reasons)),
+    }
+
+    # G3: a realistic response with prose and a Markdown block around the tags.
+    encoded = json.dumps(shipping["answer"], separators=(",", ":"))
+    realistic = (
