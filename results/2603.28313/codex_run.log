+        "pass": not g1_failures,
+        "checks": checks,
+        "inverse_generation": "sample [q,s1,s2] first, then encrypt",
+        "public_uniqueness_certificate": "gcd of all four augmented 3x3 minors equals q",
+        "failures": g1_failures,
+    }
