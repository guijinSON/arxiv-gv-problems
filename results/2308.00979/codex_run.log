+    dx = s1["X"] * d2 - s2["X"] * d1
+    dy = s1["Y"] * d2 - s2["Y"] * d1
+    den = d1 * d2
+    return dx * dx + dy * dy > 4 * den * den
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
