+    answer_elements = _answer_atoms(ship["answer"])
+    intended_ops = _compact_route_operations(ship)
+    arms = {name: dict(_ORACLE_EVIDENCE[name]) for name in ("bare", "hinted", "placebo")}
+    hinted_minus_placebo = (
