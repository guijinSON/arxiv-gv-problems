+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 300_000
+_G4_SAMPLES = 200_000
+_ATTACK_SEEDS = 8
+_SCALAR = 4096
+
+# Filled from the three script-owned hardening runs after the family holds.
+_ORACLE_EVIDENCE = {
+    "bare": {"solved": 0, "attempts": 3},
+    "hinted": {"solved": 0, "attempts": 3},
