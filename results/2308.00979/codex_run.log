+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    # G1: all presets, several seeds, plus JSON-native answers.
+    g1_ok = 0
+    g1_total = 0
+    json_ok = 0
