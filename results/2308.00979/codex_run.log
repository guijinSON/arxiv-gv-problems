+            + reference_total_scans // _ATTACK_SEEDS,
+            "distance_tests": reference_total_tests // _ATTACK_SEEDS,
+            "edge_scans": reference_total_scans // _ATTACK_SEEDS,
+            "solves": f"{reference_successes}/{_ATTACK_SEEDS}, as expected",
