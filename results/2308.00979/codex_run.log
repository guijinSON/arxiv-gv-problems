+    "easy": {"n": 13, "panels": 4, "coord_bits": 16},
+    "medium": {"n": 17, "panels": 6, "coord_bits": 24},
+    "hard": {"n": 21, "panels": 8, "coord_bits": 32},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Each panel's distinct centers carry the two-color invariant of a hidden "
