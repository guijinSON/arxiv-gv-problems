+"""Verified lattice-solubility generator for arXiv:2507.11359.
+
+Section 8 of Han--Zhao reduces the random-sparsification decision procedure to
+finding a bounded matching that covers the exceptional set V_0 and leaves an
+index vector in a supplied robust lattice.  This module isolates that native
+search problem.  It inverse-generates a single-edge (V_0,0)-solution in a
+succinct k-uniform hypergraph; the edge is identified by the unique fixed point
+of a cyclic product of projective maps.  The certificate is sampled first and
+the final map is built around it.  No generated instance is solved to obtain
+``inst["answer"]``.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from typing import Any
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_field",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "succinct finite k-uniform hypergraph",
+        "ordered vertex partition and index-vector lattice",
+        "bounded matching covering the exceptional set V_0",
+    ],
+    "verification_operations": [
+        "exact finite-field projective-map evaluation",
+        "exact hyperedge-membership test",
+        "integer index-vector congruence test",
+        "finite matching coverage check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The cyclic product of the projective transition maps is parabolic, so "
+        "its sole projective fixed point names the lattice-correcting edge; "
+        "without that invariant one tests every possible initial label."
+    ),
+    "hardness_basis": (
+        "Track B: Section 8, Procedure 1 and its running-time analysis give a "
+        "polynomial exhaustive search for a bounded solution; on this succinct "
+        "subfamily the stronger fixed-point scan is O(g+p), performs 1,000,100 "
+        "exact matrix/map operations at the shipping preset, and is timed in G5, "
+        "whereas the parabolic fixed-point route uses at most 148 field operations."
+    ),
+    "max_answer_tokens": 43,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+# n is the field prime.  The witness always has g+1 displayed vertices; raising
+# n grows the projective-label haystack, not the answer.
+DIFFICULTY = {
+    "demo": {"n": 7, "groups": 3, "padding_span": 5},
+    "easy": {"n": 1000003, "groups": 8, "padding_span": 1000003},
+    "medium": {"n": 2000003, "groups": 8, "padding_span": 2000003},
+    "hard": {"n": 4000037, "groups": 8, "padding_span": 4000037},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Projective conjugacy type is preserved when the transition maps are composed around the cycle."
+)
+PLACEBO_HINT = (
+    "Careful attention to the stated label conventions is useful when checking the proposed edge."
+)
+
+CERTIFICATE_LANGUAGE = {
