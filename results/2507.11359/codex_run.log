+def _wrong_first_pair_progression(inst: dict) -> list[int]:
+    start = inst["hyperedges"][0]["label"]
+    second = inst["hyperedges"][1]["label"]
+    step = (second - start) % inst["prime"]
+    return [(start + i * step) % inst["prime"] for i in range(inst["n"])]
