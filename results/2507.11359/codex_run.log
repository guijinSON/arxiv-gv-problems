+_PRIME = 1_000_003
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_SELFTEST_SEEDS = tuple(range(8))
+_G4_SAMPLES = 200_000
+_ENUMERATION_CAP = 1_000_000
+_ALGORITHM_X_CAP = 2_000_000
