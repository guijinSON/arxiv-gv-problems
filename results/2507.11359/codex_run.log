def _parabolic_with_fixed_point(value: int, p: int) -> tuple[int, int, int, int]:
    """A conjugate of y -> y+1 whose sole P^1 fixed point is value."""
    translation = (1, 1, 0, 1)
    if value == p:
        conjugator = (1, 0, 0, 1)
    else:
        conjugator = (value % p, -1 % p, 1, 0)
    return _mat_mul(
        _mat_mul(conjugator, translation, p),
        _mat_inv(conjugator, p),
        p,
    )


def _valid_vector(inst: dict, vector: list[int]) -> bool:
    groups = inst["groups"]
    return all(
        vector[(i + 1) % groups]
        == _mobius(tuple(inst["matrices"][i]), vector[i], inst["p"])
        for i in range(groups)
    )


def _affine_ansatz(inst: dict) -> list[int]:
    """Misread every projective map as x -> slope*x+intercept."""
    p = inst["p"]
    affine: list[tuple[int, int]] = []
    for matrix_data in inst["matrices"]:
        matrix = tuple(matrix_data)
        intercept = _mobius(matrix, 0, p)
        at_one = _mobius(matrix, 1, p)
        slope = (at_one - intercept) % p
        affine.append((slope, intercept))

    total_slope, total_intercept = 1, 0
    for slope, intercept in affine:
        total_slope = slope * total_slope % p
        total_intercept = (slope * total_intercept + intercept) % p
    if total_slope != 1:
        start = total_intercept * pow((1 - total_slope) % p, -1, p) % p
    elif total_intercept == 0:
        start = 0
    else:
        start = p

    candidate = [start]
    for slope, intercept in affine[:-1]:
        current = candidate[-1]
        candidate.append(p if current == p else (slope * current + intercept) % p)
    return candidate


def _weighted_degree_attack(inst: dict) -> list[int]:
    """Choose the maximum expanded weighted-degree white vertex per group."""
    # Every value in group i has the same expanded degree:
    # group_mult[i] + p*compat_mult[i] + compat_mult[i-1].  The conventional
    # lowest-label tie break therefore chooses zero everywhere.
    return [0] * inst["groups"]


def _zero_start_attack(inst: dict) -> list[int]:
    candidate = [0]
    for matrix_data in inst["matrices"][:-1]:
        candidate.append(_mobius(tuple(matrix_data), candidate[-1], inst["p"]))
    return candidate


def _uniform_restart_attack(inst: dict, rng: random.Random, restarts: int = 256) -> list[int]:
    last = [0] * inst["groups"]
    for _ in range(restarts):
        last = random_candidate(inst, rng)
        if _valid_vector(inst, last):
            return last
    return last


def _reference_all_starts(inst: dict) -> tuple[list[int] | None, int, int]:
    """Enumerate every initial state, returning first solution and exact counts."""
    p, groups = inst["p"], inst["groups"]
    first = None
    solutions = 0
    operations = 0
    for start in range(p + 1):
        candidate = [start]
        for matrix_data in inst["matrices"][:-1]:
            candidate.append(_mobius(tuple(matrix_data), candidate[-1], p))
            operations += 1
        operations += 1
        if _mobius(tuple(inst["matrices"][-1]), candidate[-1], p) == start:
            solutions += 1
            if first is None:
                first = candidate
    return first, solutions, operations


def _compact_projective_solution(inst: dict) -> list[int]:
    """Compose the displayed PGL matrices and recover their unique fixed point."""
    p = inst["p"]
    product = (1, 0, 0, 1)
    for matrix_data in inst["matrices"]:
        product = _mat_mul(tuple(matrix_data), product, p)
    a, b, c, d = product
    if c == 0:
        start = p
    else:
        # The product is parabolic, so c*x^2+(d-a)*x-b has one double root.
        start = (a - d) * pow((2 * c) % p, -1, p) % p
    candidate = [start]
    for matrix_data in inst["matrices"][:-1]:
        candidate.append(_mobius(tuple(matrix_data), candidate[-1], p))
    return candidate


def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
    """Inverse-generate a bundle-compressed native RWB-Dominating Set instance."""
    unknown = set(params) - {"groups", "multiplicity_span"}
    if unknown:
        raise TypeError("unknown parameter(s): " + ", ".join(sorted(unknown)))
    groups = params.get("groups", 8)
    multiplicity_span = params.get("multiplicity_span", 67)
    _validate_params(n, groups, multiplicity_span)
    if isinstance(seed, bool) or not isinstance(seed, int):
        raise ValueError("seed must be an integer")

    p = n
    rng = random.Random(seed)
    for _attempt in range(10_000):
        # Sampling the witness first is the inverse-generation step.
        start = rng.randrange(1, p + 1)  # keep it distinct from the zero-start probe
        matrices = [_random_matrix(rng, p) for _ in range(groups - 1)]
        prefix = (1, 0, 0, 1)
        answer = [start]
        for matrix in matrices:
            prefix = _mat_mul(matrix, prefix, p)
            answer.append(_mobius(matrix, answer[-1], p))

        target_product = _parabolic_with_fixed_point(start, p)
        last = _mat_mul(target_product, _mat_inv(prefix, p), p)
        a, _b, c, d = last
        if not (_det(last, p) and c and d and (c + d) % p and a < p):
            continue
        matrices.append(last)
        if _mobius(matrices[-1], answer[-1], p) != answer[0] or len(set(answer)) < 2:
            continue

        minimum_twins = groups + 1
        group_multiplicities = [
            minimum_twins + rng.randrange(multiplicity_span)
            for _ in range(groups)
        ]
        compatibility_multiplicities = [
            minimum_twins + rng.randrange(multiplicity_span)
            for _ in range(groups)
        ]
        inst = {
            "family": "projective_cycle_rwb_dominating_set",
            "p": p,
            "groups": groups,
            "multiplicity_span": multiplicity_span,
            "group_multiplicities": group_multiplicities,
            "compatibility_multiplicities": compatibility_multiplicities,
            "matrices": [list(matrix) for matrix in matrices],
            "answer": answer,
        }
        # These are filters against known cheap probes, not solvers used to find
        # the already sampled certificate.
        if _valid_vector(inst, _weighted_degree_attack(inst)):
            continue
        if _valid_vector(inst, _affine_ansatz(inst)):
            continue
        return inst
    raise RuntimeError("could not construct a conditioned instance")


def _expanded_counts(inst: dict) -> tuple[int, int, int]:
    r = inst["p"] + 1
    white = inst["groups"] * r
    black = sum(inst["group_multiplicities"]) + r * sum(
        inst["compatibility_multiplicities"]
    )
    return white + black, black * r, black


def render(inst: dict) -> str:
    """Render a complete, exact problem statement with an explicit answer contract."""
    p, groups = inst["p"], inst["groups"]
    vertices, edges, black = _expanded_counts(inst)
    lines = [
        "RWB-DOMINATING SET IN A FALSE-TWIN-BUNDLE GRAPH",
        "",
        "An RWB graph is a finite simple undirected graph whose vertices are red,",
        "white, or black. A set S is an RWB-dominating set if it contains every",
        "red vertex and every black vertex outside S has a neighbor in S. White",
        "vertices need not be dominated. Here there are no red vertices.",
        "",
        "The graph below is represented exactly by black false-twin bundles. A",
        "bundle of multiplicity t means t distinct pairwise nonadjacent black",
        "vertices with exactly the stated common white neighborhood. There are no",
        "edges other than bundle-to-white edges described below.",
        "",
        f"Field prime p = {p}. Labels are 0,...,{p}; label {p} is a formal infinity",
        f"symbol. There are g = {groups} white groups W(i,x), with 0 <= i < {groups}",
        f"and 0 <= x <= {p}. Group indices are cyclic modulo {groups}.",
        f"The expanded graph has {vertices} vertices, {edges} edges, and {black}",
        "black vertices; the bundle description below is the exact input.",
        "",
        "For each group i, a group bundle has the listed multiplicity and is",
        "adjacent to every W(i,x):",
        "group_multiplicities: " + json.dumps(inst["group_multiplicities"]),
        "",
        "For each i and each a in 0..p, compatibility bundle C(i,a) has",
        "multiplicity compat_mult[i]. Its neighborhood contains",
        "every W(i,x) with x != a, plus W((i+1) mod g, maps[i][a]). The maps are",
        "specified by four coefficients [A,B,C,D]",
        "modulo p with nonzero A*D-B*C. For finite a, maps[i][a] is infinity when",
        "C*a+D = 0 mod p, and otherwise is (A*a+B)/(C*a+D) mod p. For infinity,",
        "maps[i][p] is A/C mod p when C != 0, and infinity otherwise. Division",
        "means multiplication by the unique modular inverse. Exact data follow:",
    ]
    for i in range(groups):
        lines.append(f"map_matrix[{i}]: " + json.dumps(inst["matrices"][i]))
        lines.append(f"compat_mult[{i}]: {inst['compatibility_multiplicities'][i]}")
    lines.extend(
        [
            "",
            f"Find an RWB-dominating set of size at most {groups}. Since every group",
            f"bundle has more than {groups} black twins, every feasible set must choose",
            "exactly one white vertex from every group and no black vertices.",
            "",
            "Give your final answer inside <answer></answer> tags as a JSON list",
            f"[x_0,...,x_{groups - 1}] of exactly {groups} integers. Entry x_i means",
            f"choose W(i,x_i), and must lie in the inclusive range 0..{p}. The order",
            "is group order; values may repeat between groups.",
            f"Example format: <answer>{json.dumps([0] * groups)}</answer>",
            "Output nothing else inside the tags.",
        ]
    )
    mode = os.environ.get("GV_HINT_MODE")
    if mode == "structural":
        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
    elif mode == "placebo":
        lines.extend(["", "Hint: " + PLACEBO_HINT])
    return "\n".join(lines)


def parse_answer(text: Any) -> object | None:
    """Extract a tagged JSON list while tolerating prose and Markdown fences."""
    if not isinstance(text, str):
        return None
    match = _ANSWER_RE.search(text)
    if not match:
        return None
    payload = match.group(1).strip()
    fence = _FENCE_RE.fullmatch(payload)
    if fence:
        payload = fence.group(1).strip()
    try:
        answer = json.loads(payload)
    except (TypeError, ValueError):
        return None
    return answer if isinstance(answer, list) else None


def verify(inst: dict, answer: object) -> tuple[bool, str]:
    """Check any valid certificate from instance data only; never read inst['answer']."""
    groups, p = inst["groups"], inst["p"]
    if not isinstance(answer, list):
        return False, "answer must be a JSON list"
    if not answer:
        return False, "answer list is empty"
    if len(answer) < groups:
        return False, f"too few group choices: expected {groups}, got {len(answer)}"
    if len(answer) > groups:
        return False, f"too many group choices: expected {groups}, got {len(answer)}"
    if any(isinstance(value, bool) or not isinstance(value, int) for value in answer):
        return False, "every group choice must be an integer"
    if any(value < 0 or value > p for value in answer):
        return False, f"group choice out of range: every value must be in 0..{p}"

    # Group bundles are dominated because exactly one white vertex was selected
    # in every group.  For C(i,a), all a != answer[i] are dominated by the group-i
    # choice; the sole remaining bundle is dominated exactly by this equality.
    for i in range(groups):
        expected = _mobius(tuple(inst["matrices"][i]), answer[i], p)
        actual = answer[(i + 1) % groups]
        if actual != expected:
            return (
                False,
                f"compatibility bundle C({i},{answer[i]}) is undominated: "
                f"group {(i + 1) % groups} must choose {expected}, got {actual}",
            )
    return True, "ok"


def random_candidate(inst: dict, rng: random.Random) -> object:
    """Sample a trajectory satisfying every relation except cyclic closure."""
    candidate = [rng.randrange(inst["p"] + 1)]
    for matrix_data in inst["matrices"][:-1]:
        candidate.append(_mobius(tuple(matrix_data), candidate[-1], inst["p"]))
    return candidate


def search_space(inst: dict) -> int | None:
    return inst["p"] + 1


def enumerate_all(inst: dict) -> int | None:
    space = search_space(inst)
    if space is None or space > _ENUMERATION_CAP:
        return None
    count = 0
    for start in range(inst["p"] + 1):
        candidate = [start]
        for matrix_data in inst["matrices"][:-1]:
            candidate.append(_mobius(tuple(matrix_data), candidate[-1], inst["p"]))
        if verify(inst, candidate)[0]:
            count += 1
    return count


def canonical_key(inst: dict) -> str:
    """A relabelling-invariant key based on exact structural multiplicities."""
    multiplicities = sorted(
        list(inst["group_multiplicities"])
        + list(inst["compatibility_multiplicities"])
    )
    payload = json.dumps(
        [inst["p"], inst["groups"], multiplicities],
        separators=(",", ":"),
    ).encode()
    return hashlib.sha256(payload).hexdigest()


def _rotate_groups(inst: dict, shift: int) -> dict:
    groups = inst["groups"]
    shift %= groups
    order = [(i + shift) % groups for i in range(groups)]
    out = dict(inst)
    out["matrices"] = [list(inst["matrices"][i]) for i in order]
    out["group_multiplicities"] = [inst["group_multiplicities"][i] for i in order]
    out["compatibility_multiplicities"] = [
        inst["compatibility_multiplicities"][i] for i in order
    ]
    out["answer"] = [inst["answer"][i] for i in order]
    return out


def _relabel_values(inst: dict, rng: random.Random) -> dict:
    groups, p = inst["groups"], inst["p"]
    relabellings = [_random_matrix(rng, p) for _ in range(groups)]
    matrices = []
    for i in range(groups):
        old = tuple(inst["matrices"][i])
        conjugated = _mat_mul(
            _mat_mul(relabellings[(i + 1) % groups], old, p),
            _mat_inv(relabellings[i], p),
            p,
        )
        matrices.append(list(conjugated))

    out = dict(inst)
    out["matrices"] = matrices
    out["compatibility_multiplicities"] = list(inst["compatibility_multiplicities"])
    out["group_multiplicities"] = list(inst["group_multiplicities"])
    out["answer"] = [
        _mobius(relabellings[i], inst["answer"][i], p) for i in range(groups)
    ]
    return out


def escalate(params: dict) -> dict | str | None:
    """Grow the value ground set and bundle crowding at fixed witness length."""
    if not isinstance(params, dict):
        return None
    try:
        n = int(params["n"])
        groups = int(params.get("groups", 8))
        span = int(params.get("multiplicity_span", 67))
    except (KeyError, TypeError, ValueError):
        return None
    if n >= 24_000_000:
        return None
    return {
        "n": _next_prime(2 * n + 1),
        "groups": groups,
        "multiplicity_span": min(1_000_000, 2 * span + 1),
    }


def _attack_panel(instances: list[dict]) -> tuple[dict, dict]:
    attacks = {
        "outlier_weighted_degree": {"successes": 0, "attempts": 0, "wall_clock_sec": 0.0},
        "greedy_zero_start_propagation": {"successes": 0, "attempts": 0, "wall_clock_sec": 0.0},
        "random_restart_256": {"successes": 0, "attempts": 0, "wall_clock_sec": 0.0},
        "affine_map_ansatz": {"successes": 0, "attempts": 0, "wall_clock_sec": 0.0},
    }
    references = []
    reference_operations = []
    reference_solutions = []
    for index, inst in enumerate(instances):
        candidates = {
            "outlier_weighted_degree": lambda: _weighted_degree_attack(inst),
            "greedy_zero_start_propagation": lambda: _zero_start_attack(inst),
            "random_restart_256": lambda: _uniform_restart_attack(
                inst, random.Random(900_000 + index), 256
            ),
            "affine_map_ansatz": lambda: _affine_ansatz(inst),
        }
        for name, build in candidates.items():
            start = time.perf_counter()
            candidate = build()
            elapsed = time.perf_counter() - start
            ok, _ = verify(inst, candidate)
            attacks[name]["attempts"] += 1
            attacks[name]["successes"] += int(ok)
            attacks[name]["wall_clock_sec"] += elapsed

        start = time.perf_counter()
        candidate, solution_count, operations = _reference_all_starts(inst)
        references.append(time.perf_counter() - start)
        reference_operations.append(operations)
        reference_solutions.append(solution_count)
        if candidate is None or not verify(inst, candidate)[0]:
            raise AssertionError("reference algorithm failed")

    for result in attacks.values():
        result["wall_clock_sec"] = round(result["wall_clock_sec"], 6)
    reference = {
        "name": "all-start functional-cycle propagation",
        "complexity": "O(g*p) exact projective-map evaluations and O(g) working memory",
        "wall_clock_sec": round(sum(references) / len(references), 6),
        "operations": int(sum(reference_operations) / len(reference_operations)),
        "solution_counts": sorted(set(reference_solutions)),
        "solves": f"{len(references)}/{len(references)}, as expected",
    }
    return attacks, reference


def selftest() -> dict:
    """Run all mandatory gates and return their measured, JSON-native report."""
    report: dict[str, Any] = {
        "paper": "arXiv:0903.4521",
        "track": TRACK,
        "shipping_difficulty": SHIPPING_DIFFICULTY,
        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
    }

    g1_failures = []
    verified = 0
    json_native = 0
    for preset, params in DIFFICULTY.items():
        for seed in (0, 1, 2):
            inst = make_instance(seed=seed, **params)
            ok, reason = verify(inst, inst["answer"])
            if ok:
                verified += 1
