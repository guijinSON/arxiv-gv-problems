+
+def _validate_params(n: int, groups: int, padding_span: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int) or not _is_prime(n) or n == 2:
+        raise ValueError("n must be an odd prime")
+    if not 3 <= n < 2**63:
+        raise ValueError("n must be an odd prime in 3..2^63-1")
+    if isinstance(groups, bool) or not isinstance(groups, int) or not 3 <= groups <= 30:
