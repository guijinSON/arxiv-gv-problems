+    "medium": {"n": 40, "degree": 5, "mixing": 32},
+    "hard": {"n": 40, "degree": 5, "mixing": 40},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT: str = (
+    "The first two displayed labels and one perfect matching are linked by an "
