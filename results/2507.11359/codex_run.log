+        "total": _G4_SAMPLES,
+        "observed_probability": guess_probability,
+        "structure_aware_space": search_space(inst),
+        "prior": "uniform over all n-subsets of the displayed hyperedge labels",
+    }
+
+    start_time = time.perf_counter()
