+    "verification_operations": [
+        "exact finite-field projective-map evaluation",
+        "exact hyperedge-membership test",
+        "integer index-vector congruence test",
+        "finite matching coverage check",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "The cyclic product of the projective transition maps is parabolic, so "
+        "its sole projective fixed point names the lattice-correcting edge; "
+        "without that invariant one tests every possible initial label."
+    ),
+    "hardness_basis": (
+        "Track B: Section 8, Procedure 1 and its running-time analysis give a "
+        "polynomial exhaustive search for a bounded solution; on this succinct "
+        "subfamily the stronger fixed-point scan is O(g+p), performs 1,000,100 "
+        "exact matrix/map operations at the shipping preset, and is timed in G5, "
+        "whereas the parabolic fixed-point route uses at most 148 field operations."
+    ),
+    "max_answer_tokens": 43,
+}
+
+NATIVE = {
