+        "doubled_n": doubled["n"],
+        "doubled_reason": doubled_reason,
+        "escalated_params": escalated_params,
+        "escalated_verifies": escalated_ok,
+        "fixed_answer_axis": "mixing, then degree",
+    }
+
+    invariance_checks = 0
+    transformation_checks = 0
+    distinct_keys = []
+    g8_failures = []
+    for seed in range(20):
