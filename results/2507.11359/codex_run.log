+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "One prospective lattice-correcting exceptional edge: a G-tag vertex "
+        "and exactly one coordinate vertex from each of g ordered groups. The "
+        "first g-1 transition constraints and the forced tag label leave one "
+        "free projective start in 0..p; the closing transition is checked."
+    ),
+    "bounds": {
+        "tag_vertices": 1,
