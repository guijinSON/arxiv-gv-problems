"""Verified witness generator for arXiv:2508.18162.

The paper's Theorem 13 turns a zero-one integer system ``A v = b`` into a
one-layer bounded-context SSM whose accepting word is ``supp(v)``.  Here ``A``
is a 0/1 incidence matrix, ``b`` is all ones, and every column has three ones.
Thus an accepting word is exactly an exact cover by 3-sets.

Only the Python standard library is used.  Generation is deterministic in all
arguments, and importing the module performs no I/O.
"""

from __future__ import annotations

import hashlib
import itertools
import json
import math
import random
import re
from collections import Counter


DIFFICULTY = {
    "standard": {"n": 50, "degree": 6},
    "hard": {"n": 80, "degree": 6},
    "extreme": {"n": 120, "degree": 6},
}

SHIPPING_DIFFICULTY = "standard"

NOTES = r"""
Definition and paper connection.  Section 2 defines an SSM layer by the
recurrence h_t = gate(x_t) h_{t-1} + inc(x_t), and says that evaluating a
given word is polynomial-time.  Section 5.2, Theorem 13, gives the exact
lower-bound construction used here: a word lists the support of a binary
vector v, a time-invariant identity recurrence accumulates columns of A, a
second block counts repeated symbols, and the output FNN tests A v = b and
all symbol counts <= 1.  Corollary 14 makes unary bounded-context
satisfiability NP-complete for both time-invariant and diagonal SSMs.

Regime choices.  The unrestricted problem in Section 4 is undecidable and so
does not provide a bounded witness generator.  Binary context length has only
a NEXPTIME upper bound and a weaker class-dependent lower-bound picture.  The
fixed-width results use an exponential-model property and PSPACE search; the
time-invariant lower bound there is only NP-hard.  This module stays in the
tight unary bounded-context regime and makes the context length grow with n.
It specializes A to a 3-set incidence matrix and b to the all-one vector, so
substitution is exact integer arithmetic.

Inverse generation and planting hygiene.  The witness partition is sampled
first.  Decoy triples are then drawn from a random regular configuration with
the same uniform three-element marginal as a planted triple.  Every element
has exactly `degree` public incidences, every symbol has arity three, and the
symbols are shuffled.  Thus degree, width, position, and input frequency do
not separate plants from decoys; difficulty comes from global crowding and n.

Attacks.  The panel ranks symbols by a local-overlap statistic (outlier), tries
one deterministic minimum-remaining-values greedy path, performs 256 random
MRV restarts, and runs the standard Algorithm X exact-cover backtracker with
MRV for 50,000 search nodes.  The shipping preset is accepted only when all
four attacks fail on eight seeds.  The canonical key ignores the planted
answer and hashes an isomorphism-invariant edge-weighted color refinement of
the triple-intersection graph.  It is a strong cheap invariant, not a complete
hypergraph-isomorphism canonical form.
""".strip()


_ANSWER_RE = re.compile(
    r"<answer\b[^>]*>(.*?)</answer\s*>", re.IGNORECASE | re.DOTALL
)
_INT_LIST_RE = re.compile(r"[+-]?\d+(?:\s*,\s*[+-]?\d+)*")


def _random_partition(element_count: int, rng: random.Random) -> list[tuple[int, int, int]]:
    elements = list(range(element_count))
    rng.shuffle(elements)
    return [
        tuple(sorted(elements[i : i + 3]))
        for i in range(0, element_count, 3)
    ]


def _regular_decoys(
    element_count: int, residual_degree: int, rng: random.Random
) -> list[tuple[int, int, int]]:
    """Sample a loop-free regular 3-uniform configuration.

    Conditioning a shuffled stub configuration on having no repeated element
    inside a triple preserves symmetry among element labels and among triples.
    The expected number of retries is small for the shipped residual degree.
    """

    stubs = [x for x in range(element_count) for _ in range(residual_degree)]
    for _ in range(20_000):
        rng.shuffle(stubs)
        triples = [
            tuple(sorted(stubs[i : i + 3])) for i in range(0, len(stubs), 3)
        ]
        if all(a != b and b != c for a, b, c in triples):
            return triples
    raise RuntimeError("could not sample a loop-free regular decoy configuration")


def make_instance(n: int, seed: int = 0, **params) -> dict:
    """Sample an exact-cover witness first, then build its bounded SSM.

    ``n`` is the required word length and the number of chosen 3-sets.  There
    are ``3*n`` ground elements and ``degree*n`` alphabet symbols.  Increasing
    n increases the witness length and the exact-cover search depth.
    """

    degree = params.pop("degree", 6)
    if params:
        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
    if isinstance(n, bool) or not isinstance(n, int) or n < 2:
        raise ValueError("n must be an integer at least 2")
    if isinstance(degree, bool) or not isinstance(degree, int) or degree < 2:
        raise ValueError("degree must be an integer at least 2")
    if (degree - 1) * (3 * n) % 3:
        raise ValueError("residual incidence count must be divisible by 3")

    rng = random.Random(seed)
    element_count = 3 * n

    # G: sample the accepted support before any decoy data.
    planted = _random_partition(element_count, rng)
    decoys = _regular_decoys(element_count, degree - 1, rng)

    tagged = [(triple, True) for triple in planted]
    tagged.extend((triple, False) for triple in decoys)
    rng.shuffle(tagged)
    triples = [triple for triple, _ in tagged]
    answer = [i for i, (_, is_plant) in enumerate(tagged) if is_plant]

    return {
        "family": "bounded-context support-word SSM / exact 3-cover",
        "n": n,
        "degree": degree,
        "elements": element_count,
        "triples": triples,
        "answer": answer,
    }


def render(inst: dict) -> str:
    """Render a complete, standalone witness problem."""

    n = inst["n"]
    m = inst["elements"]
    triples = inst["triples"]
    q = len(triples)
    lines = [
        "Bounded-context state-space-model satisfiability witness",
        "",
        "A state-space model (SSM) reads a finite word of alphabet-symbol IDs",
        "and updates an integer hidden state.  This instance has one layer.",
        f"Its alphabet is the {q} symbols numbered 0 through {q - 1}.",
        f"Its ground elements are numbered 0 through {m - 1}.",
        "Each symbol j is assigned the three ground elements listed below.",
        "",
        "The hidden state consists of one coverage counter c[x] per ground",
        "element x and one use counter u[j] per symbol j.  Every counter starts",
        "at 0.  Reading symbol j adds 1 to u[j] and adds 1 to c[x] for each of",
        "j's three listed elements; all other counters are unchanged.  Equivalently,",
        "the time-invariant diagonal recurrence has identity gate and adds the",
        "0/1 incidence column of j.",
        "",
        f"Find a word of exactly {n} symbols that is accepted.  Acceptance means",
        f"that every one of the {m} coverage counters is exactly 1 and every use",
        "counter is at most 1.  Therefore no symbol may repeat, the chosen triples",
        "must be pairwise disjoint, and together they must cover every element.",
        "Word order does not affect these additive counters.  To give one unique",
        "representation of a chosen set, output the symbol IDs in strictly increasing",
        f"order: exactly {n} distinct integers in the inclusive range 0..{q - 1}.",
        "Different symbol IDs remain distinct choices even if their listed triples",
        "happen to be identical.",
        "",
        "Symbol data, one line per symbol in the format `ID: element element element`:",
    ]
    lines.extend(f"{j}: {a} {b} {c}" for j, (a, b, c) in enumerate(triples))
    triples: list[tuple[int, int, int]] | list[list[int]],
) -> tuple[list[set[int]], dict[tuple[int, int], int]]:
    sets = [set(triple) for triple in triples]
    adjacency = [set() for _ in triples]
    weights: dict[tuple[int, int], int] = {}
    for i in range(len(triples)):
        for j in range(i + 1, len(triples)):
            weight = len(sets[i] & sets[j])
            if weight:
                adjacency[i].add(j)
                adjacency[j].add(i)
                weights[(i, j)] = weight
    return adjacency, weights


def _local_overlap_scores(inst: dict) -> list[int]:
    """Per-symbol triangle counts in the public triple-intersection graph."""

    adjacency, _ = _intersection_graph(inst["triples"])
    scores = []
    for neighbors in adjacency:
        ordered = sorted(neighbors)
        score = 0
        for p, a in enumerate(ordered):
            score += sum(b in adjacency[a] for b in ordered[p + 1 :])
        scores.append(score)
    return scores


def canonical_key(inst: dict) -> str:
    """Return a strong cheap hypergraph-isomorphism invariant.

    Exact canonical labeling of a 3-uniform hypergraph is not known to be cheap.
    This key starts from label-free local-cycle/intersection features, performs
    edge-weighted color refinement, and hashes color/edge multiplicities.  It is
    invariant under arbitrary ground-element relabeling, symbol reordering, and
    reordering of the three entries within every symbol.
    """

    triples = [tuple(sorted(triple)) for triple in inst["triples"]]
    adjacency, weights = _intersection_graph(triples)
    local_triangles = []
    initial = []
    multiplicity = Counter(triples)
    for i, neighbors in enumerate(adjacency):
        ordered = sorted(neighbors)
        triangles = 0
        for p, a in enumerate(ordered):
            triangles += sum(b in adjacency[a] for b in ordered[p + 1 :])
        local_triangles.append(triangles)
        whist = Counter(
            weights[(min(i, j), max(i, j))] for j in neighbors
        )
        initial.append(
            (
                multiplicity[triples[i]],
                tuple(sorted(whist.items())),
                triangles,
            )
        )

    palette = {signature: c for c, signature in enumerate(sorted(set(initial)))}
    colors = [palette[signature] for signature in initial]
    for _ in range(len(triples) + 1):
        signatures = []
        for i, neighbors in enumerate(adjacency):
            neighborhood = sorted(
                (weights[(min(i, j), max(i, j))], colors[j]) for j in neighbors
            )
            signatures.append((colors[i], tuple(neighborhood)))
        palette = {
            signature: c for c, signature in enumerate(sorted(set(signatures)))
        }
        refined = [palette[signature] for signature in signatures]
        if refined == colors:
            break
        colors = refined

    color_counts = sorted(Counter(colors).items())
    edge_counts = Counter()
    for (i, j), weight in weights.items():
        a, b = sorted((colors[i], colors[j]))
        edge_counts[(a, b, weight)] += 1
    profiles = sorted(
        (
            colors[i],
            local_triangles[i],
            tuple(
                sorted(
                    (weights[(min(i, j), max(i, j))], colors[j])
                    for j in adjacency[i]
                )
            ),
        )
        for i in range(len(triples))
    )
    payload = {
        "elements": inst["elements"],
        "symbols": len(triples),
        "color_counts": color_counts,
        "edge_counts": sorted((list(k), v) for k, v in edge_counts.items()),
        "profiles": profiles,
    }
    raw = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
    return hashlib.sha256(raw).hexdigest()


def escalate(params: dict) -> dict | None:
    """Increase exact-cover depth while preserving the regular hard regime."""

    if "n" not in params:
        return None
    n = params["n"]
    degree = params.get("degree", 6)
    if isinstance(n, bool) or not isinstance(n, int) or n >= 400:
        return None
    return {"n": max(n + 1, (3 * n + 1) // 2), "degree": degree}


def _incidence_lists(inst: dict) -> tuple[list[int], list[list[int]], int]:
    masks = _triple_masks(inst)
    incident = [[] for _ in range(inst["elements"])]
    for symbol, triple in enumerate(inst["triples"]):
        for element in triple:
            incident[element].append(symbol)
    return masks, incident, (1 << inst["elements"]) - 1


def _mrv_options(
    covered: int, incident: list[list[int]], masks: list[int], full: int
) -> list[int]:
    remaining = full ^ covered
    best: list[int] | None = None
    while remaining:
        bit = remaining & -remaining
        element = bit.bit_length() - 1
        remaining -= bit
        options = [symbol for symbol in incident[element] if not masks[symbol] & covered]
        if not options:
            return []
        if best is None or len(options) < len(best):
            best = options
            if len(best) == 1:
                break
    return best or []


def _attack_outlier_local_overlap(inst: dict) -> list[int]:
    scores = _local_overlap_scores(inst)
    return sorted(sorted(range(len(scores)), key=lambda j: (scores[j], j))[: inst["n"]])


def _attack_greedy(inst: dict) -> list[int] | None:
    masks, incident, full = _incidence_lists(inst)
    covered = 0
    chosen = []
    for _ in range(inst["n"]):
        options = _mrv_options(covered, incident, masks, full)
        if not options:
            return None

        def damage(symbol: int) -> tuple[int, int]:
            mask = masks[symbol]
            conflicts = sum(
                bool(mask & masks[other])
                for other in range(len(masks))
                if not masks[other] & covered
            )
            return conflicts, symbol

        symbol = min(options, key=damage)
        chosen.append(symbol)
        covered |= masks[symbol]
    return sorted(chosen) if covered == full else None


def _attack_random_restart(
    inst: dict, rng: random.Random, restarts: int = 256
) -> list[int] | None:
    masks, incident, full = _incidence_lists(inst)
    for _ in range(restarts):
        covered = 0
        chosen = []
        for _ in range(inst["n"]):
            options = _mrv_options(covered, incident, masks, full)
            if not options:
                break
            symbol = rng.choice(options)
            chosen.append(symbol)
            covered |= masks[symbol]
        if covered == full:
            return sorted(chosen)
    return None


def _attack_algorithm_x(
    inst: dict, node_cap: int = 50_000
) -> tuple[list[int] | None, int]:
    """Standard exact-cover backtracking (Algorithm X with MRV), node-capped."""

    masks, incident, full = _incidence_lists(inst)
    nodes = 0
    aborted = False

    def search(covered: int, chosen: list[int]) -> list[int] | None:
        nonlocal nodes, aborted
        if nodes >= node_cap:
            aborted = True
            return None
        nodes += 1
        if covered == full:
            return sorted(chosen)
        options = _mrv_options(covered, incident, masks, full)
        if not options:
            return None
        for symbol in options:
            result = search(covered | masks[symbol], chosen + [symbol])
            if result is not None:
                return result
            if aborted:
                return None
        return None

    return search(0, []), nodes


def _corruption_results(inst: dict) -> dict[str, dict[str, object]]:
    answer = list(inst["answer"])
    corruptions: dict[str, object] = {
        "drop_one": answer[:-1],
        "swap_two": [answer[1], answer[0], *answer[2:]],
        "duplicate": [answer[0], answer[0], *answer[2:]],
        "empty": [],
        "out_of_range": [len(inst["triples"]), *answer[1:]],
    }
    rows = {}
    for name, candidate in corruptions.items():
        ok, reason = verify(inst, candidate)
        rows[name] = {"accepted": ok, "reason": reason}
    return rows


def _transformed_instance(
    inst: dict,
    rng: random.Random,
    permute_elements: bool,
    permute_symbols: bool,
    reorder_entries: bool,
) -> dict:
    m = inst["elements"]
    element_map = list(range(m))
    if permute_elements:
        rng.shuffle(element_map)

    triples = []
    for original in inst["triples"]:
        triple = [element_map[x] for x in original]
        if reorder_entries:
            rng.shuffle(triple)
        triples.append(tuple(triple))

    answer = list(inst["answer"])
    if permute_symbols:
        order = list(range(len(triples)))
        rng.shuffle(order)
        inverse = [0] * len(order)
        for new, old in enumerate(order):
            inverse[old] = new
        triples = [triples[old] for old in order]
        answer = sorted(inverse[old] for old in answer)

    return {
        "family": inst["family"],
        "n": inst["n"],
        "degree": inst["degree"],
        "elements": m,
        "triples": triples,
        "answer": answer,
    }


def _run_attack_panel(params: dict, seeds: list[int]) -> dict:
    attacks = {
        "outlier_local_overlap": {"successes": 0, "attempts": len(seeds)},
        "greedy_mrv_min_damage": {"successes": 0, "attempts": len(seeds)},
        "random_restart_mrv_256": {"successes": 0, "attempts": len(seeds)},
        "algorithm_x_mrv_50000": {
            "successes": 0,
            "attempts": len(seeds),
            "nodes": [],
        },
    }
    for seed in seeds:
        inst = make_instance(seed=seed, **params)
        candidates = {
            "outlier_local_overlap": _attack_outlier_local_overlap(inst),
            "greedy_mrv_min_damage": _attack_greedy(inst),
            "random_restart_mrv_256": _attack_random_restart(
                inst, random.Random(0x5EED_0000 + seed), 256
            ),
        }

