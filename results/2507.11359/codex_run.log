+    a, b, c, d = matrix
+    if value == p:
+        return p if c == 0 else a * pow(c, -1, p) % p
+    denominator = (c * value + d) % p
+    if denominator == 0:
+        return p
+    return (a * value + b) * pow(denominator, -1, p) % p
+
+
+def _random_matrix(rng: random.Random, p: int) -> tuple[int, int, int, int]:
+    """Choose a non-affine map with finite images at 0 and 1."""
+    while True:
+        matrix = tuple(rng.randrange(p) for _ in range(4))
+        a, _b, c, d = matrix
+        if _det(matrix, p) and c and d and (c + d) % p and a < p:
+            return matrix
+
+
+def _parabolic_with_fixed_point(value: int, p: int) -> tuple[int, int, int, int]:
+    """Conjugate x -> x+1 so that its sole P^1 fixed point is value."""
+    translation = (1, 1, 0, 1)
+    if value == p:
+        conjugator = (1, 0, 0, 1)
+    else:
+        conjugator = (value % p, -1 % p, 1, 0)
+    return _mat_mul(
+        _mat_mul(conjugator, translation, p),
+        _mat_inv(conjugator, p),
+        p,
+    )
+
+
+def _product(inst: dict) -> tuple[int, int, int, int]:
+    result = (1, 0, 0, 1)
+    for matrix_data in inst["matrices"]:
+        result = _mat_mul(tuple(matrix_data), result, inst["p"])
+    return result
+
+
+def _trajectory(inst: dict, start: int) -> list[int]:
+    values = [start]
+    for matrix_data in inst["matrices"][:-1]:
+        values.append(_mobius(tuple(matrix_data), values[-1], inst["p"]))
+    return values
+
+
+def _candidate_from_start(inst: dict, start: int, tag_class: str = "G") -> list[list[Any]]:
+    values = _trajectory(inst, start)
+    return [[tag_class, start]] + [[index, value] for index, value in enumerate(values)]
+
+
+def _closes(inst: dict, values: list[int]) -> bool:
+    return _mobius(tuple(inst["matrices"][-1]), values[-1], inst["p"]) == values[0]
+
+
+def _affine_ansatz(inst: dict) -> list[list[Any]]:
+    """Fit each projective map at 0 and 1, then solve the false affine cycle."""
+    p = inst["p"]
+    affine: list[tuple[int, int]] = []
+    for matrix_data in inst["matrices"]:
+        matrix = tuple(matrix_data)
+        intercept = _mobius(matrix, 0, p)
+        at_one = _mobius(matrix, 1, p)
+        slope = (at_one - intercept) % p
+        affine.append((slope, intercept))
+
+    total_slope, total_intercept = 1, 0
+    for slope, intercept in affine:
+        total_slope = slope * total_slope % p
+        total_intercept = (slope * total_intercept + intercept) % p
+    if total_slope != 1:
+        start = total_intercept * pow((1 - total_slope) % p, -1, p) % p
+    elif total_intercept == 0:
+        start = 0
+    else:
+        start = p
+    return _candidate_from_start(inst, start)
+
+
+def _compact_projective_solution(inst: dict) -> list[list[Any]]:
+    """Use the parabolic cyclic product and its unique double fixed point."""
+    p = inst["p"]
+    a, _b, c, d = _product(inst)
+    if c == 0:
+        start = p
+    else:
+        start = (a - d) * pow((2 * c) % p, -1, p) % p
+    return _candidate_from_start(inst, start)
+
+
+def _reference_fixed_point_scan(inst: dict) -> tuple[list[list[Any]] | None, int, int]:
+    """Compose once, then test every projective label for cyclic closure."""
+    p = inst["p"]
+    product = _product(inst)
+    first = None
+    solutions = 0
+    for start in range(p + 1):
+        if _mobius(product, start, p) == start:
+            solutions += 1
+            if first is None:
+                first = _candidate_from_start(inst, start)
+    operations = (p + 1) + 12 * inst["groups"]
+    return first, solutions, operations
+
+
+def make_instance(n: int, seed: int = 0, **params: Any) -> dict:
+    """Inverse-generate a native bounded lattice-solubility instance."""
+    unknown = set(params) - {"groups", "padding_span"}
+    if unknown:
+        raise TypeError("unknown parameter(s): " + ", ".join(sorted(unknown)))
+    groups = params.get("groups", 8)
+    padding_span = params.get("padding_span", max(3, n))
+    _validate_params(n, groups, padding_span)
+    if isinstance(seed, bool) or not isinstance(seed, int):
+        raise ValueError("seed must be an integer")
+
+    p = n
+    rng = random.Random(seed)
+    for _attempt in range(10_000):
+        # The certificate is sampled before the last constraint is constructed.
+        planted_start = rng.randrange(p + 1)
+        matrices = [_random_matrix(rng, p) for _ in range(groups - 1)]
+        prefix = (1, 0, 0, 1)
+        for matrix in matrices:
+            prefix = _mat_mul(matrix, prefix, p)
+        target = _parabolic_with_fixed_point(planted_start, p)
+        last = _mat_mul(target, _mat_inv(prefix, p), p)
+        a, _b, c, d = last
+        if not (_det(last, p) and c and d and (c + d) % p and a < p):
+            continue
+        matrices.append(last)
+
+        group_padding = [rng.randrange(padding_span + 1) for _ in range(groups)]
+        if len(set(group_padding)) < 2:
+            continue
+        uniformity = groups + 2
+        good_tag_vertices = p + 2  # odd; deleting G(x) makes this coordinate even
+        bad_tag_vertices = p + 1
+        base_total = (
+            1
+            + sum(p + 1 + amount for amount in group_padding)
+            + good_tag_vertices
+            + bad_tag_vertices
+        )
+        neutral_vertices = (-base_total) % uniformity
+        total_vertices = base_total + neutral_vertices
+        inst = {
+            "family": "projective_exceptional_edge_lattice_solution",
+            "p": p,
+            "groups": groups,
+            "uniformity": uniformity,
+            "padding_span": padding_span,
+            "group_padding": group_padding,
+            "good_tag_vertices": good_tag_vertices,
+            "bad_tag_vertices": bad_tag_vertices,
+            "neutral_vertices": neutral_vertices,
+            "total_vertices": total_vertices,
+            "matrices": [list(matrix) for matrix in matrices],
+            "lattice": {
+                "total_modulus": uniformity,
+                "good_tag_parity": 0,
+            },
+        }
+        answer = _candidate_from_start(inst, planted_start)
+        inst["answer"] = answer
+
+        # Conditioning defeats declared cheap probes but never finds the answer:
+        # the answer was fixed before the instance and carried through the maps.
+        if verify(inst, _candidate_from_start(inst, 0))[0]:
+            continue
+        if verify(inst, _affine_ansatz(inst))[0]:
+            continue
+        if not verify(inst, answer)[0]:
+            continue
+        return inst
+    raise RuntimeError("could not construct a conditioned instance")
+
+
+def render(inst: dict) -> str:
+    """Render the exact decorated hypergraph and its answer contract."""
+    p = inst["p"]
+    groups = inst["groups"]
+    uniformity = inst["uniformity"]
+    coordinate_sizes = [p + 1 + amount for amount in inst["group_padding"]]
+    lines = [
+        "BOUNDED LATTICE-SOLUBILITY IN A SUCCINCT UNIFORM HYPERGRAPH",
+        "",
+        f"A {uniformity}-uniform hypergraph is a finite vertex set together with",
+        f"hyperedges containing exactly {uniformity} distinct vertices. A matching is",
+        "a collection of pairwise vertex-disjoint hyperedges. A matching covers a",
+        "vertex when one of its edges contains that vertex.",
+        "",
+        "The vertex partition below is ordered. The special part V0 consists of the",
+        "single vertex s and is omitted from index vectors. The remaining parts are",
+        f"C0,...,C{groups - 1}, G, B, N. For a vertex set X, its index vector records",
+        "how many vertices of X lie in each of these remaining parts, in that order.",
+        f"Coordinate part Ci contains the p+1 labelled vertices C(i,x), 0 <= x <= {p},",
+        "plus the stated number of padding vertices D(i,j), which never occur in an",
+        "exceptional edge. G contains labelled G(x), 0 <= x <= p, plus one padding",
+        "vertex; B contains B(x), 0 <= x <= p; N contains neutral padding vertices.",
+        "",
+        f"Field prime p = {p}. Labels 0,...,{p - 1} are elements of F_p and label",
+        f"{p} is a formal infinity symbol. Exact part sizes are:",
+        "coordinate_sizes: " + json.dumps(coordinate_sizes),
+        "coordinate_padding: " + json.dumps(inst["group_padding"]),
+        f"G_size: {inst['good_tag_vertices']}",
+        f"B_size: {inst['bad_tag_vertices']}",
+        f"N_size: {inst['neutral_vertices']}",
+        f"total_vertices: {inst['total_vertices']} (a multiple of {uniformity})",
+        "",
+        "The lattice L consists exactly of integer index vectors z satisfying both",
+        f"sum(z) = 0 modulo {uniformity} and z_G = 0 modulo 2. It is generated by",
+        "the index vectors of the dense core edges described next.",
+        "",
+        "The hyperedge set is specified exactly by these two rules; there are no",
+        "other hyperedges:",
+        f"(1) Every {uniformity}-set not containing s whose number of G vertices is",
+        "    even is a dense core hyperedge.",
+        "(2) For every projective label x in 0..p there is one exceptional edge E(x).",
+        "    It contains s, one coordinate vertex from every Ci, and one tag vertex.",
+        "    Put x_0=x and x_(i+1)=map_i(x_i) for i=0,...,g-2. If",
+        "    map_(g-1)(x_(g-1))=x_0, its tag is G(x_0); otherwise its tag is B(x_0).",
+        "",
+        "Each map is a projective (Mobius) permutation represented by [A,B,C,D]",
+        "modulo p with A*D-B*C nonzero. For finite x, map(x) is infinity when",
+        "C*x+D=0 modulo p, and otherwise (A*x+B)/(C*x+D) modulo p. For infinity,",
+        "map(infinity)=A/C when C is nonzero, and infinity otherwise. Division means",
+        "multiplication by the unique nonzero modular inverse. The exact maps are:",
+    ]
+    for index, matrix in enumerate(inst["matrices"]):
+        lines.append(f"map_matrix[{index}]: " + json.dumps(matrix))
+    lines.extend(
+        [
+            "",
+            "A q-solution for a partition and lattice is a matching of at most q",
+            "edges whose deletion leaves the index vector of all remaining vertices",
+            "in the lattice. A (U,q)-solution must also cover every vertex of U and",
+            "may contain at most |U|+q edges.",
+            "",
+            "Find a (V0,0)-solution. Since V0={s}, this is exactly one exceptional",
+            "edge containing s whose deletion leaves the residual index vector in L.",
+            "",
+            "Write that edge without the mandatory vertex s. A coordinate vertex is",
+            "encoded [i,x] and a tag vertex is encoded [\"G\",x] or [\"B\",x].",
+            f"Give exactly {groups + 1} such descriptors: one tag and one coordinate",
+            f"from each group i=0,...,{groups - 1}. Descriptor order does not matter;",
+            "labels are inclusive in 0..p, labels may repeat across different parts,",
+            "and the same part or vertex may not be repeated.",
+            "",
+            "Give your final answer inside <answer></answer> tags as one JSON list.",
+            "Example: <answer>"
+            + json.dumps([["G", 0]] + [[i, 0] for i in range(groups)])
+            + "</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
+    elif mode == "placebo":
+        lines.extend(["", "Hint: " + PLACEBO_HINT])
+    return "\n".join(lines)
+
+
+def parse_answer(text: Any) -> object | None:
+    """Extract the tagged JSON certificate while tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    match = _ANSWER_RE.search(text)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    fence = _FENCE_RE.fullmatch(payload)
+    if fence:
+        payload = fence.group(1).strip()
+    try:
+        answer = json.loads(payload)
+    except (TypeError, ValueError):
+        return None
+    return answer if isinstance(answer, list) else None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any valid (V0,0)-solution from instance data; never read the plant."""
+    groups = inst["groups"]
+    p = inst["p"]
+    expected_entries = groups + 1
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list of vertex descriptors"
+    if not answer:
+        return False, "answer list is empty"
+    if len(answer) < expected_entries:
+        return False, f"too few edge vertices: expected {expected_entries}, got {len(answer)}"
+    if len(answer) > expected_entries:
+        return False, f"too many edge vertices: expected {expected_entries}, got {len(answer)}"
+    if any(not isinstance(item, list) or len(item) != 2 for item in answer):
+        return False, "every vertex descriptor must be a two-entry JSON list"
+
+    tag_entries = [item for item in answer if isinstance(item[0], str)]
+    coordinate_entries = [item for item in answer if not isinstance(item[0], str)]
+    if len(tag_entries) != 1:
+        return False, "the edge must contain exactly one tag vertex"
+    if len(coordinate_entries) != groups:
+        return False, f"the edge must contain exactly {groups} coordinate vertices"
+
+    tag_class, tag_label = tag_entries[0]
+    if tag_class not in ("G", "B"):
+        return False, "tag class must be exactly G or B"
+    if isinstance(tag_label, bool) or not isinstance(tag_label, int):
+        return False, "tag label must be an integer"
+    if tag_label < 0 or tag_label > p:
+        return False, f"tag label out of range: expected 0..{p} inclusive"
+
+    values: dict[int, int] = {}
+    for group, label in coordinate_entries:
+        if isinstance(group, bool) or not isinstance(group, int):
+            return False, "coordinate group identifiers must be integers"
+        if group < 0 or group >= groups:
+            return False, f"coordinate group out of range: expected 0..{groups - 1}"
+        if group in values:
+            return False, "coordinate groups must occur exactly once; a group was duplicated"
+        if isinstance(label, bool) or not isinstance(label, int):
+            return False, "coordinate labels must be integers"
+        if label < 0 or label > p:
+            return False, f"coordinate label out of range: expected 0..{p} inclusive"
+        values[group] = label
+    if set(values) != set(range(groups)):
+        return False, "coordinate groups must occur exactly once; at least one is missing"
+
+    trajectory = [values[index] for index in range(groups)]
+    if tag_label != trajectory[0]:
+        return False, "tag label must equal the label in coordinate group 0"
+    for index in range(groups - 1):
+        expected = _mobius(tuple(inst["matrices"][index]), trajectory[index], p)
+        if trajectory[index + 1] != expected:
+            return (
+                False,
+                f"trajectory relation {index} fails: expected group {index + 1} "
+                f"label {expected}, got {trajectory[index + 1]}",
+            )
+
+    closes = _closes(inst, trajectory)
+    expected_tag = "G" if closes else "B"
+    if tag_class != expected_tag:
+        return (
+            False,
+            f"these descriptors are not an exceptional hyperedge: closure requires tag {expected_tag}",
+        )
+
+    residual_total = inst["total_vertices"] - inst["uniformity"]
+    if residual_total % inst["lattice"]["total_modulus"] != 0:
+        return False, "residual index vector is outside L: its coordinate sum is not divisible by k"
+    residual_good = inst["good_tag_vertices"] - int(tag_class == "G")
+    if residual_good % 2 != inst["lattice"]["good_tag_parity"]:
+        return False, "residual index vector is outside L: its G coordinate is odd"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample the exact structure-aware language, leaving only cyclic closure."""
+    start = rng.randrange(inst["p"] + 1)
+    return _candidate_from_start(inst, start, "G")
+
+
+def search_space(inst: dict) -> int | None:
+    return inst["p"] + 1
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space is None or space > _ENUMERATION_CAP:
+        return None
+    return sum(
+        verify(inst, _candidate_from_start(inst, start))[0]
+        for start in range(inst["p"] + 1)
+    )
+
+
+def canonical_key(inst: dict) -> str:
+    """Invariant under supported value relabellings and coordinate-part reorderings."""
+    payload = json.dumps(
+        [
+            inst["p"],
+            inst["groups"],
+            inst["uniformity"],
+            sorted(inst["group_padding"]),
+            inst["good_tag_vertices"],
+            inst["bad_tag_vertices"],
+            inst["neutral_vertices"],
+        ],
+        separators=(",", ":"),
+    ).encode()
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _answer_values(answer: list[list[Any]], groups: int) -> list[int]:
+    coordinates = {
+        item[0]: item[1]
+        for item in answer
+        if isinstance(item, list) and len(item) == 2 and isinstance(item[0], int)
+    }
+    return [coordinates[index] for index in range(groups)]
+
+
+def _with_answer_values(inst: dict, values: list[int]) -> list[list[Any]]:
+    return [["G", values[0]]] + [[index, value] for index, value in enumerate(values)]
+
+
+def _relabel_values(inst: dict, rng: random.Random) -> dict:
+    groups = inst["groups"]
+    p = inst["p"]
+    relabellings = [_random_matrix(rng, p) for _ in range(groups)]
+    matrices = []
+    for index in range(groups):
+        changed = _mat_mul(
+            _mat_mul(relabellings[(index + 1) % groups], tuple(inst["matrices"][index]), p),
+            _mat_inv(relabellings[index], p),
+            p,
+        )
+        matrices.append(list(changed))
+    old_values = _answer_values(inst["answer"], groups)
+    new_values = [
+        _mobius(relabellings[index], old_values[index], p)
+        for index in range(groups)
+    ]
+    out = dict(inst)
+    out["matrices"] = matrices
+    out["group_padding"] = list(inst["group_padding"])
+    out["lattice"] = dict(inst["lattice"])
+    out["answer"] = _with_answer_values(out, new_values)
+    return out
+
+
+def _rotate_groups(inst: dict, shift: int) -> dict:
+    groups = inst["groups"]
+    shift %= groups
+    order = [(index + shift) % groups for index in range(groups)]
+    old_values = _answer_values(inst["answer"], groups)
+    new_values = [old_values[index] for index in order]
+    out = dict(inst)
+    out["matrices"] = [list(inst["matrices"][index]) for index in order]
+    out["group_padding"] = [inst["group_padding"][index] for index in order]
+    out["lattice"] = dict(inst["lattice"])
+    out["answer"] = _with_answer_values(out, new_values)
+    return out
+
+
+def _reverse_groups(inst: dict) -> dict:
+    groups = inst["groups"]
+    p = inst["p"]
+    order = [(-index) % groups for index in range(groups)]
+    old_values = _answer_values(inst["answer"], groups)
+    new_values = [old_values[index] for index in order]
+    matrices = []
+    for new_index in range(groups):
+        old_edge_index = (-new_index - 1) % groups
+        matrices.append(list(_mat_inv(tuple(inst["matrices"][old_edge_index]), p)))
+    out = dict(inst)
+    out["matrices"] = matrices
+    out["group_padding"] = [inst["group_padding"][index] for index in order]
+    out["lattice"] = dict(inst["lattice"])
+    out["answer"] = _with_answer_values(out, new_values)
+    return out
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Grow the projective ground set and independent structural padding."""
+    if not isinstance(params, dict):
+        return None
+    try:
+        current_n = int(params["n"])
+        current_groups = int(params.get("groups", 8))
+        current_span = int(params.get("padding_span", current_n))
+    except (KeyError, TypeError, ValueError):
+        return None
+    if current_n >= 2**62:
+        return None
+    harder = dict(params)
+    harder["n"] = _next_prime(2 * current_n + 1)
+    harder["groups"] = current_groups
+    harder["padding_span"] = min(2**31 - 1, 2 * current_span + 1)
+    return harder
+
+
+def _outlier_incidence_attack(inst: dict) -> list[list[Any]]:
+    """All coordinate labels have one exceptional incidence; tie-break at zero."""
+    return _candidate_from_start(inst, 0)
+
+
+def _zero_start_attack(inst: dict) -> list[list[Any]]:
+    return _candidate_from_start(inst, 0)
+
+
+def _uniform_restart_attack(inst: dict, rng: random.Random, restarts: int = 256) -> list[list[Any]]:
+    last = _candidate_from_start(inst, 0)
+    for _ in range(restarts):
+        last = random_candidate(inst, rng)
+        if verify(inst, last)[0]:
+            return last
+    return last
+
+
+def _attack_panel(instances: list[dict]) -> tuple[dict, dict]:
+    attacks = {
+        "outlier_equal_exceptional_incidence": {
+            "successes": 0,
+            "attempts": 0,
+            "wall_clock_sec": 0.0,
+        },
+        "greedy_zero_start_propagation": {
+            "successes": 0,
+            "attempts": 0,
+            "wall_clock_sec": 0.0,
+        },
+        "random_restart_256": {"successes": 0, "attempts": 0, "wall_clock_sec": 0.0},
+        "in_context_affine_ansatz": {
+            "successes": 0,
+            "attempts": 0,
+            "wall_clock_sec": 0.0,
+        },
+    }
+    reference_times = []
+    reference_operations = []
+    reference_counts = []
+    for index, inst in enumerate(instances):
+        builders = {
+            "outlier_equal_exceptional_incidence": lambda: _outlier_incidence_attack(inst),
+            "greedy_zero_start_propagation": lambda: _zero_start_attack(inst),
+            "random_restart_256": lambda: _uniform_restart_attack(
+                inst, random.Random(900_000 + index), 256
+            ),
+            "in_context_affine_ansatz": lambda: _affine_ansatz(inst),
+        }
+        for name, builder in builders.items():
+            started = time.perf_counter()
+            candidate = builder()
+            elapsed = time.perf_counter() - started
+            ok, _reason = verify(inst, candidate)
+            attacks[name]["attempts"] += 1
+            attacks[name]["successes"] += int(ok)
+            attacks[name]["wall_clock_sec"] += elapsed
+
+        started = time.perf_counter()
+        candidate, solution_count, operations = _reference_fixed_point_scan(inst)
+        reference_times.append(time.perf_counter() - started)
+        reference_operations.append(operations)
+        reference_counts.append(solution_count)
+        if candidate is None or not verify(inst, candidate)[0]:
+            raise AssertionError("reference fixed-point scan failed")
+
+    for result in attacks.values():
+        result["wall_clock_sec"] = round(result["wall_clock_sec"], 6)
+    reference = {
+        "name": "compose the cycle, then scan every projective start",
+        "complexity": "O(g+p) exact field operations and O(1) extra space",
+        "wall_clock_sec": round(sum(reference_times) / len(reference_times), 6),
+        "operations": int(sum(reference_operations) / len(reference_operations)),
+        "fixed_point_tests": instances[0]["p"] + 1,
+        "solution_counts": sorted(set(reference_counts)),
+        "solves": f"{len(instances)}/{len(instances)}, as expected",
+    }
+    return attacks, reference
+
+
+def selftest() -> dict:
+    """Run every mandatory gate and return a JSON-native measured report."""
+    report: dict[str, Any] = {
+        "paper": "arXiv:2507.11359",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": dict(DIFFICULTY[SHIPPING_DIFFICULTY]),
+    }
+
+    failures = []
+    verified = 0
+    json_native = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 2):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            if ok:
+                verified += 1
+            else:
+                failures.append([preset, seed, reason])
+            if json.loads(json.dumps(inst["answer"])) == inst["answer"]:
+                json_native += 1
+    report["G1_planted_verifies"] = {
+        "pass": not failures and verified == 12 and json_native == 12,
+        "verified": verified,
+        "attempts": 12,
+        "json_native": json_native,
+        "failures": failures,
+    }
+
+    shipping = make_instance(seed=12345, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    answer = json.loads(json.dumps(shipping["answer"]))
+    coordinates = [item for item in answer if isinstance(item[0], int)]
+    differing = next(
+        pair
+        for pair in itertools.combinations(range(len(coordinates)), 2)
+        if coordinates[pair[0]][1] != coordinates[pair[1]][1]
+    )
+    swapped = json.loads(json.dumps(answer))
+    coordinate_positions = [index for index, item in enumerate(swapped) if isinstance(item[0], int)]
+    left = coordinate_positions[differing[0]]
+    right = coordinate_positions[differing[1]]
+    swapped[left][1], swapped[right][1] = swapped[right][1], swapped[left][1]
+    duplicated = json.loads(json.dumps(answer))
+    duplicated[2] = list(duplicated[1])
+    out_of_range = json.loads(json.dumps(answer))
+    out_of_range[1][1] = shipping["p"] + 1
+    corruptions = {
+        "drop_one": answer[:-1],
