+def _numeric_gap_outlier(inst: dict) -> list[int]:
+    labels = sorted(edge["label"] for edge in inst["hyperedges"])
+    scored = []
+    for i, label in enumerate(labels):
+        left = (label - labels[i - 1]) % inst["prime"]
