+    algorithm_x_times: list[float] = []
+    scan_successes = 0
+    scan_ops_all: list[int] = []
+    scan_times: list[float] = []
+    compact_successes = 0
+    compact_ops_all: list[int] = []
+    for offset, seed in enumerate(_SELFTEST_SEEDS):
