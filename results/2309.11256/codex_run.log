+            "candidate_attempts": outlier_attempts,
+        },
+        "greedy_first_mismatch_repair": {
+            "seed_successes": greedy_successes, "seeds": len(attack_seeds),
+            "candidate_attempts": greedy_attempts,
+        },
+        "structure_aware_random_restart_64": {
