+        "invariance_checks": invariance_checks,
+        "mapped_witness_checks": witness_checks,
+        "distinct_unrelated_keys": distinct,
+        "unrelated_instances": len(g8_seeds),
+        "transformations": ["input-term permutation", "degree reversal",
