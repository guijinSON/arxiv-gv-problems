+        "base_n": shipping_params["n"], "doubled_n": doubled_params["n"],
+        "doubled_planted_verifies": doubled_ok,
+        "verify_reason": doubled_why,
+        "search_space_increased": search_space(doubled) > search_space(guess_inst),
+    }
