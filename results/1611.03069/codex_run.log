+        "dimension": dimension,
+        "radius": radius,
+        "points": points,
+        "q_degree": q_degree,
+        "answer": {"coefficients": coefficients},
+    }
+
+
+def render(inst):
+    prime = inst["prime"]
+    dimension = inst["dimension"]
+    radius = inst["radius"]
+    rows = "\n".join(
+        f"{index}: {x} {y}" for index, (x, y) in enumerate(inst["points"])
