+        "construction": "inverse generation of p(X)=X*q(X^3)",
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=19, **shipping)
+    planted = inst["answer"]["coefficients"]
+    corruptions = {}
+    variants = {
