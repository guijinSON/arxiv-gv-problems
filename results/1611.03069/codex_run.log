+        },
+        "duplicate_one_coefficient": {"coefficients": planted + [planted[-1]]},
+        "empty_coefficients": {"coefficients": []},
+        "out_of_range_coefficient": {
+            "coefficients": [inst["prime"]] + planted[1:]
+        },
+    }
