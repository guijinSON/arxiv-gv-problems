+
+def make_instance(n, seed=0, q_degree=4, prime=1009):
+    """Inverse-generate an exact RS-BDD instance and its polynomial witness."""
+    if not all(isinstance(v, int) and not isinstance(v, bool)
+               for v in (n, seed, q_degree, prime)):
