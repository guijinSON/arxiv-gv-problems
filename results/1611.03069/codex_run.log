+        random.Random(20_000 + seed).shuffle(reordered["points"])
+        for label, transformed in (
+            ("row permutation", reordered),
+            ("affine x relabelling", _affine_transform(
+                base, 2 + seed, 17 + 3 * seed
+            )),
