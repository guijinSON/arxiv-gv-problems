+    for result in attack_results.values():
+        result["wall_clock_sec"] = round(result["wall_clock_sec"], 6)
+
+    report["G5_density_and_baseline_cost"] = {
+        "pass": not baseline_success,
+        "shipping_sample_hits": guess_hits,
