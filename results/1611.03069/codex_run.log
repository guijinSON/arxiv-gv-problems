+def _is_prime(value):
+    if not isinstance(value, int) or isinstance(value, bool) or value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    limit = math.isqrt(value)
+    divisor = 3
+    while divisor <= limit:
+        if value % divisor == 0:
