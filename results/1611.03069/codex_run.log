+if os.environ.get("GV_G9_SINGLE") == "1":
+    DIFFICULTY = {
+        SHIPPING_DIFFICULTY: dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    }
+
+STRUCTURAL_HINT = (
