import json, time

def plane_lines(q):
    def affine(x,y): return x*q+y
    def inf(m): return q*q+m
    iv=q*q+q
    lines=[]
    mul=add=0
    for m in range(q):
        for b in range(q):
            row=[]
            for x in range(q):
                y=(m*x+b)%q; mul+=1; add+=1
                row.append(affine(x,y))
            row.append(inf(m)); lines.append(row)
    for a in range(q):
        lines.append([affine(a,y) for y in range(q)]+[iv])
    lines.append([inf(m) for m in range(q)]+[iv])
    return lines,mul+add

def colouring(q,s):
    lines,ops=plane_lines(q)
    p=q*q+q+1
    seen=[0]*p
    tagged=[]
    for row in lines:
        tr=[]
        for point in row:
            tr.append((point,seen[point])); seen[point]+=1
        tagged.append(tr)
    mat=[]
    for row in tagged:
        out=[]
        for point,rank in row:
            for j in range(s):
                out.append(point*s+((rank+j)%s))
        mat.append(out)
    return lines,mat,ops+p*(q+1)*s

def check(q,s,lines,mat):
    p=q*q+q+1; c=p*s; cols=(q+1)*s
    assert len(lines)==p and all(len(x)==q+1 for x in lines)
    pairs=set()
    for row in lines:
