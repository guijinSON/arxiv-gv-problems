def score(order,masks):
    n=len(order)
    return sum((masks[order[i]]>>order[(i+j)%n])&1 for i in range(n) for j in (1,2))

def anneal(inst,seed,restarts=6,steps=150000):
    rng=random.Random(seed); n=inst['n']; masks=inst['adjacency_masks']; bestall=0
    for r in range(restarts):
        a=list(range(n)); rng.shuffle(a); s=score(a,masks); bestall=max(bestall,s)
        T=3.0
        for t in range(steps):
            i,j=rng.sample(range(n),2)
            a[i],a[j]=a[j],a[i]
            ns=score(a,masks)
            d=ns-s
            temp=max(.03,T*(1-t/steps))
            if d>=0 or rng.random()<math.exp(d/temp): s=ns
            else: a[i],a[j]=a[j],a[i]
            if s>bestall: bestall=s
            if s==2*n:
                c=g._normalize_cycle(a)
                return c,bestall,(r*steps+t+1)
    return None,bestall,restarts*steps

for seed in range(9100,9104):
    inst=g.make_instance(seed=seed,**g.DIFFICULTY['hard'])
