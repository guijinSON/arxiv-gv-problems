+def _attack_edge_common_outlier(inst: dict) -> tuple[list[int] | None, int]:
+    """Greedily prefer locally extreme edge common-neighbor counts.
+
+    The witness spans every vertex, so a vertex-only outlier probe is weak: the
+    possible construction leak is that planted distance-one/distance-two edges
+    have atypical triangle counts compared with decoy edges.  Try both tails of
+    that statistic while maintaining the freely deducible two-predecessor rule.
+    """
+    n = inst["n"]
+    adjacency = inst["adjacency"]
+    masks = inst["adjacency_masks"]
+    operations = 0
+
+    def common(u: int, v: int) -> int:
+        return (masks[u] & masks[v]).bit_count()
+
+    for direction in (1, -1):
+        seconds = sorted(
+            adjacency[0], key=lambda v: (direction * common(0, v), v)
+        )
+        for second in seconds:
+            path = [0, second]
+            used = (1 << 0) | (1 << second)
+            while len(path) < n:
+                candidate_mask = masks[path[-2]] & masks[path[-1]] & ~used
+                choices = [u for u in range(n) if (candidate_mask >> u) & 1]
+                operations += n
+                if not choices:
+                    break
+                nxt = min(
+                    choices,
+                    key=lambda u: (
+                        direction
+                        * (common(path[-2], u) + common(path[-1], u)),
+                        _onward_count(
+                            masks, used | (1 << u), path[-1], u
+                        ),
+                        u,
+                    ),
+                )
+                path.append(nxt)
+                used |= 1 << nxt
+            if len(path) == n and _candidate_ok(inst, path):
+                return _normalize_cycle(path), operations
+    return None, operations
+
+
