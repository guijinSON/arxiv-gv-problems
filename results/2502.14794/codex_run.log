+                        _onward_count(
+                            masks, used | (1 << u), path[-1], u
+                        ),
+                        u,
+                    ),
+                )
+                path.append(nxt)
+                used |= 1 << nxt
+            if len(path) == n and _candidate_ok(inst, path):
+                return _normalize_cycle(path), operations
+    return None, operations
