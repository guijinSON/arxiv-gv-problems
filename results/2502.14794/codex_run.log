/bin/bash -lc "python3 - <<'PY'
import importlib.util, json, os, random
path='gen_2502_14794.py'
s=importlib.util.spec_from_file_location('g',path); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
assert list(g.DIFFICULTY)==['demo','easy','medium','hard']
assert g.TRACK in ('A','B')
for name,p in g.DIFFICULTY.items():
    for seed in range(25):
        a=g.make_instance(seed=seed,**p)
        b=g.make_instance(seed=seed,**p)
        assert a==b,(name,seed,'nondeterministic')
        assert json.loads(json.dumps(a['answer']))==a['answer']
        assert g.verify(a,a['answer'])==(True,'ok')
        wrapped='prose\\n"'```json'"\\n<answer>'+json.dumps(a['answer'])+'</answer>\\n"'```'"\\nmore'
        assert g.parse_answer(wrapped)==a['answer']
ship=g.make_instance(seed=0,**g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
assert '<answer>' in g.render(ship) and '</answer>' in g.render(ship)
os.environ['GV_HINT_MODE']='structural'; assert g.STRUCTURAL_HINT in g.render(ship)
os.environ['GV_HINT_MODE']='placebo'; assert g.PLACEBO_HINT in g.render(ship)
os.environ.pop('GV_HINT_MODE'); assert g.STRUCTURAL_HINT not in g.render(ship) and g.PLACEBO_HINT not in g.render(ship)
print('determinism_g1_roundtrip=100/100')
print('default_render_has_no_hint=true')
print('shipping_search_space_digits='+str(len(str(g.search_space(ship)))))
