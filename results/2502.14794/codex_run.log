+        sorted((permutation[u], permutation[v])) for u, v in inst["edges"]
+    ]
+    random.Random(reorder_seed).shuffle(edges)
+    adjacency, masks = _make_adjacency(n, edges)
+    return {
+        **inst,
+        "vertices": list(range(n)),
+        "edges": edges,
+        "adjacency": adjacency,
+        "adjacency_masks": masks,
+        "answer": _normalize_cycle([permutation[v] for v in inst["answer"]]),
+    }
