+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A canonical cyclic ordering: one JSON list of length n containing "
+        "each vertex 0,...,n-1 once, with vertex 0 first and the second entry "
+        "smaller than the last entry.  Reversal and rotation therefore do not "
+        "create additional encodings."
