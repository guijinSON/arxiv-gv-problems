+    "bounds": {
+        "length": "n",
+        "entry_min": 0,
+        "entry_max": "n-1",
+        "distinct": True,
+        "first_entry": 0,
+        "orientation_rule": "second entry < last entry",
+        "shipping_max_n": 96,
+    },
+}
+
+STRUCTURAL_HINT = (
+    "Every new vertex of a square-Hamilton ordering lies in the common "
+    "neighborhood of the preceding two vertices."
+)
