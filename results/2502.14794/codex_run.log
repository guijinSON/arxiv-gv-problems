+}
+
+STRUCTURAL_HINT = (
+    "Every new vertex of a square-Hamilton ordering lies in the common "
+    "neighborhood of the preceding two vertices."
+)
+
+PLACEBO_HINT = (
+    "Every vertex of the requested cyclic ordering must be tracked carefully "
+    "under the stated indexing conventions."
+)
+
+NOTES = """\
+Section 1.2 fixes the native problem: Q_F is generated by all unlabelled
+isomorphic copies of a fixed d-regular spanning graph F.  Section 1.4 and
+Theorem 1.7 specialise F to the square of an n-cycle and prove the sharp
+threshold p=(1+o(1))*sqrt(e/n).  The exact object is therefore a host graph and
+a spanning 4-regular square-cycle copy, not a surrogate CSP.
+
+Step-0 algorithm audit: the paper is probabilistic and does not give an
+efficient recovery algorithm.  Sections 1.5 and 6 use fragmentation, sampling
+from families of copies, and counting/reconstruction arguments; the word
+"algorithm" there describes a proof distribution, not a polynomial-time
+finder from a presented host graph.  The related Nenadov--Skoric result cited
+in Section 1.2 gives a randomized quasi-polynomial finder only in the denser
+p^2 >= C log^8(n)/n regime.  This generator stays at factor 1.02 above the
+paper's sharp scale, where that guarantee does not apply.  Thus this is Track
+A, with an explicitly empirical distributional claim.
+
+Generation is inverse: choose and randomly relabel a cyclic ordering, insert
+all 2n edges joining positions one or two apart, and sample every remaining
+edge without replacement until the G(n,m)-scale budget is reached.  Random
+relabeling makes every host edge have the same marginal; plants and decoys are
+not assigned different label or degree distributions.  Near-threshold noise
+avoids the easy plant-only regime while keeping common-neighborhood branching
+close to constant.  Degree/triangle ordering, greedy propagation, randomized
+propagation, centered spectral seriation, and bounded exact DFS are all tested.
+"""
+
+
+def _normalize_cycle(order: list[int]) -> list[int]:
+    """Choose the unique rotation/reversal with 0 first and forward < backward."""
+    at = order.index(0)
+    rotated = order[at:] + order[:at]
+    reversed_order = [rotated[0]] + list(reversed(rotated[1:]))
+    return min(rotated, reversed_order)
+
+
+def _make_adjacency(n: int, edges: list[list[int]]) -> tuple[list[list[int]], list[int]]:
+    adjacency = [[] for _ in range(n)]
+    masks = [0] * n
+    for u, v in edges:
+        adjacency[u].append(v)
+        adjacency[v].append(u)
+        masks[u] |= 1 << v
+        masks[v] |= 1 << u
+    for row in adjacency:
+        row.sort()
+    return adjacency, masks
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Inverse-generate a near-threshold host and its square-cycle witness."""
+    noise_factor_num = params.pop("noise_factor_num", 102)
+    if params:
+        raise ValueError(f"unknown parameters: {sorted(params)}")
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise ValueError("n must be an integer")
+    if n < 8:
+        raise ValueError("n must be at least 8")
+    if n > 256:
+        raise ValueError("n exceeds the supported 256-vertex bound")
+    if isinstance(noise_factor_num, bool) or not isinstance(noise_factor_num, int):
+        raise ValueError("noise_factor_num must be an integer percentage")
+    if not 90 <= noise_factor_num <= 120:
+        raise ValueError("noise_factor_num must lie between 90 and 120")
+
+    rng = random.Random(seed)
+    relabel = list(range(n))
+    rng.shuffle(relabel)
+
+    plant = set()
+    for i in range(n):
+        for jump in (1, 2):
+            plant.add(tuple(sorted((relabel[i], relabel[(i + jump) % n]))))
+    if len(plant) != 2 * n:
+        raise AssertionError("cycle-square construction did not have 2n edges")
+
+    possible = [
+        (u, v)
+        for u in range(n)
+        for v in range(u + 1, n)
+        if (u, v) not in plant
+    ]
+    total_pairs = n * (n - 1) // 2
+    p = noise_factor_num / 100.0 * math.sqrt(math.e / n)
+    target_edges = max(2 * n, min(total_pairs, round(p * total_pairs)))
+    extra = target_edges - 2 * n
+    decoys = rng.sample(possible, extra)
+    edge_set = plant | set(decoys)
+    edges = [list(edge) for edge in edge_set]
+    rng.shuffle(edges)
+    adjacency, adjacency_masks = _make_adjacency(n, edges)
+
+    return {
+        "family": "near_threshold_square_hamilton_cycle",
+        "n": n,
+        "noise_factor_num": noise_factor_num,
+        "threshold_scale": "sqrt(e/n)",
+        "target_edge_count": target_edges,
+        "actual_density": target_edges / total_pairs,
+        "vertices": list(range(n)),
+        "edges": edges,
+        "adjacency": adjacency,
+        "adjacency_masks": adjacency_masks,
+        "answer": _normalize_cycle(relabel),
+    }
+
+
+def render(inst: dict) -> str:
+    n = inst["n"]
+    edge_text = " ".join(f"{u}-{v}" for u, v in inst["edges"])
+    statement = f"""Square of a Hamilton cycle in a host graph
+
+The host is a finite simple undirected graph with vertex set 0,1,...,{n - 1}.
+Its unordered edges are listed below; a token u-v means the edge {{u,v}}.
+
+Edges ({len(inst['edges'])} total):
+{edge_text}
+
+A cyclic ordering [v0,v1,...,v{n - 1}] is square-Hamiltonian when it contains
+every vertex exactly once and, with subscripts interpreted modulo {n}, the
+host contains both edges {{vi,v(i+1)}} and {{vi,v(i+2)}} for every i.  Thus all
+vertices at cyclic distance one or two must be adjacent; no condition is
+imposed on pairs at larger cyclic distance.
+
+Find one square-Hamiltonian cyclic ordering.  Use the canonical encoding with
+exactly {n} distinct integer vertex identifiers: vertex 0 must be first, and
+the second identifier must be smaller than the last identifier.  These rules
+remove rotation and reversal ambiguity.  Vertex identifiers and list indexing
+are zero-based, order matters, and repetitions are forbidden.
+
+Give your final answer inside <answer></answer> tags, as one JSON list of
+exactly {n} integers.  Example format: <answer>[0, 3, 1, 2]</answer>
+The example illustrates syntax only and is not an answer to this instance.
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    if not isinstance(text, str):
+        return None
+    blocks = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
+    candidates = blocks if blocks else re.findall(
+        r"```(?:json)?\s*(.*?)```", text, flags=re.I | re.S
+    )
+    for raw in reversed(candidates):
+        try:
+            value = json.loads(raw.strip())
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continue
+        if isinstance(value, list) and all(type(x) is int for x in value):
+            return value
+    return None
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any canonical square-Hamilton ordering; never inspect inst['answer']."""
+    n = inst["n"]
+    if not isinstance(answer, list):
+        return False, "answer_not_list"
+    if not answer:
+        return False, "answer_empty"
+    if len(answer) != n:
+        return False, f"wrong_length:{len(answer)}_expected_{n}"
+    if any(type(v) is not int for v in answer):
+        return False, "non_integer_vertex"
+    if any(v < 0 or v >= n for v in answer):
+        return False, "vertex_out_of_range"
+    if len(set(answer)) != n:
+        return False, "duplicate_vertex"
+    if answer[0] != 0:
+        return False, "noncanonical_rotation"
+    if answer[1] >= answer[-1]:
+        return False, "noncanonical_orientation"
+
+    masks = inst["adjacency_masks"]
+    for i, u in enumerate(answer):
+        for jump in (1, 2):
+            v = answer[(i + jump) % n]
+            if not (masks[u] >> v) & 1:
+                return False, f"missing_square_edge:{u}-{v}_at_{i}+{jump}"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Uniformly sample canonical cycles, enforcing all obvious shape rules."""
+    tail = list(range(1, inst["n"]))
+    rng.shuffle(tail)
+    if tail[0] > tail[-1]:
+        tail.reverse()
+    return [0] + tail
+
+
+def search_space(inst: dict) -> int | None:
+    return math.factorial(inst["n"] - 1) // 2
+
+
+def enumerate_all(inst: dict) -> int | None:
+    if search_space(inst) > 200_000:
+        return None
+    count = 0
+    for tail in itertools.permutations(range(1, inst["n"])):
+        if tail[0] >= tail[-1]:
+            continue
+        if verify(inst, [0] + list(tail))[0]:
+            count += 1
+    return count
+
+
+def canonical_key(inst: dict) -> str:
+    """Relabelling-invariant WL/edge-profile fingerprint of the host graph."""
+    n = inst["n"]
+    adjacency = inst["adjacency"]
+    masks = inst["adjacency_masks"]
+    colors = [len(row) for row in adjacency]
+    for _ in range(4):
+        signatures = [
+            (colors[u], tuple(sorted(colors[v] for v in adjacency[u])))
+            for u in range(n)
+        ]
+        palette = {sig: i for i, sig in enumerate(sorted(set(signatures)))}
+        colors = [palette[sig] for sig in signatures]
+
+    vertex_profiles = Counter(colors)
+    edge_profiles = Counter()
+    for u in range(n):
+        for v in adjacency[u]:
+            if u < v:
+                common = (masks[u] & masks[v]).bit_count()
+                edge_profiles[(min(colors[u], colors[v]), max(colors[u], colors[v]), common)] += 1
+    payload = json.dumps(
+        [
+            n,
+            len(inst["edges"]),
+            sorted(vertex_profiles.items()),
+            sorted((list(k), value) for k, value in edge_profiles.items()),
+        ],
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    n = int(params.get("n", 0))
+    factor = int(params.get("noise_factor_num", 100))
+    if n < 24:
+        return {"n": 24, "noise_factor_num": 101}
+    if n < 96:
+        return {"n": 96, "noise_factor_num": 102}
+    # Fixed answer length: more same-distribution decoys crowd every local
+    # common-neighborhood choice before the writable-answer cap is relevant.
+    if n == 96 and factor < 104:
+        return {"n": n, "noise_factor_num": factor + 2}
+    if n < 120:
+        return {"n": 120, "noise_factor_num": 102}
+    if n < 144:
+        return {"n": 144, "noise_factor_num": 102}
+    return "cap_bound"
+
+
+def _candidate_ok(inst: dict, candidate: object) -> bool:
+    if candidate is None:
+        return False
+    if isinstance(candidate, list) and candidate and 0 in candidate:
+        candidate = _normalize_cycle(candidate)
+    return verify(inst, candidate)[0]
+
+
+def _attack_degree_triangle_order(inst: dict) -> list[int]:
+    masks = inst["adjacency_masks"]
+    adjacency = inst["adjacency"]
+    triangles = [
+        sum((masks[u] & masks[v]).bit_count() for v in adjacency[u]) // 2
+        for u in range(inst["n"])
+    ]
+    order = sorted(
+        range(inst["n"]),
+        key=lambda u: (len(adjacency[u]), triangles[u], u),
+    )
+    return _normalize_cycle(order)
+
+
+def _onward_count(masks: list[int], used: int, previous: int, current: int) -> int:
+    return (masks[previous] & masks[current] & ~used).bit_count()
+
+
+def _attack_greedy_common(inst: dict) -> tuple[list[int] | None, int]:
+    n = inst["n"]
+    adjacency = inst["adjacency"]
+    masks = inst["adjacency_masks"]
+    operations = 0
+    for second in adjacency[0]:
+        path = [0, second]
+        used = (1 << 0) | (1 << second)
+        while len(path) < n:
+            candidate_mask = masks[path[-2]] & masks[path[-1]] & ~used
+            operations += 1
+            choices = [u for u in range(n) if (candidate_mask >> u) & 1]
+            if not choices:
+                break
+            nxt = min(
+                choices,
+                key=lambda u: (_onward_count(masks, used | (1 << u), path[-1], u), u),
+            )
+            path.append(nxt)
+            used |= 1 << nxt
+        if len(path) == n and _candidate_ok(inst, path):
+            return _normalize_cycle(path), operations
+    return None, operations
+
+
+def _attack_random_restarts(
+    inst: dict, rng: random.Random, restarts: int = 256
+) -> tuple[list[int] | None, int]:
+    n = inst["n"]
+    adjacency = inst["adjacency"]
+    masks = inst["adjacency_masks"]
+    operations = 0
+    for _ in range(restarts):
+        second = rng.choice(adjacency[0])
+        path = [0, second]
+        used = (1 << 0) | (1 << second)
+        while len(path) < n:
+            candidate_mask = masks[path[-2]] & masks[path[-1]] & ~used
+            operations += 1
+            choices = [u for u in range(n) if (candidate_mask >> u) & 1]
+            if not choices:
+                break
+            scores = [
+                (_onward_count(masks, used | (1 << u), path[-1], u), u)
+                for u in choices
+            ]
+            best = min(score for score, _ in scores)
+            pool = [u for score, u in scores if score == best]
+            nxt = rng.choice(pool)
+            path.append(nxt)
+            used |= 1 << nxt
+        if len(path) == n and _candidate_ok(inst, path):
+            return _normalize_cycle(path), operations
+    return None, operations
+
+
+def _attack_centered_spectral(inst: dict) -> tuple[list[int] | None, int]:
+    """Centered adjacency power iteration followed by angular seriation."""
+    n = inst["n"]
+    adjacency = inst["adjacency"]
+    density = 2.0 * len(inst["edges"]) / (n * (n - 1))
+    operations = 0
+    constant = [1.0 / math.sqrt(n)] * n
+
+    def mode(bases: list[list[float]], seed: int) -> list[float]:
+        nonlocal operations
+        rng = random.Random(seed)
+        vector = [rng.uniform(-1.0, 1.0) for _ in range(n)]
+        for _ in range(140):
+            total = sum(vector)
+            values = [
+                sum(vector[v] for v in adjacency[u]) - density * (total - vector[u])
+                for u in range(n)
+            ]
+            operations += len(inst["edges"]) * 2 + n
+            for basis in bases:
+                dot = sum(a * b for a, b in zip(values, basis))
+                values = [a - dot * b for a, b in zip(values, basis)]
+                operations += 2 * n
+            norm = math.sqrt(sum(a * a for a in values))
+            operations += n
+            if norm == 0.0:
+                break
+            vector = [a / norm for a in values]
+        return vector
+
+    first = mode([constant], 250214794)
+    second = mode([constant, first], 250214799)
+    orders = [
+        sorted(range(n), key=lambda u: math.atan2(second[u], first[u])),
+        sorted(range(n), key=lambda u: math.atan2(first[u], second[u])),
+        sorted(range(n), key=lambda u: first[u]),
+        sorted(range(n), key=lambda u: second[u]),
+    ]
+    for order in orders:
+        candidate = _normalize_cycle(order)
+        if verify(inst, candidate)[0]:
+            return candidate, operations
+    return None, operations
+
+
+def _attack_common_neighbor_dfs(
+    inst: dict, node_budget: int = 250_000
+) -> tuple[list[int] | None, int]:
+    """Bounded exact DFS using the natural two-predecessor propagation."""
+    n = inst["n"]
+    adjacency = inst["adjacency"]
+    masks = inst["adjacency_masks"]
+    nodes = 0
+    stopped = False
+    path = [0]
+
+    def visit(used: int) -> list[int] | None:
+        nonlocal nodes, stopped
+        nodes += 1
+        if nodes > node_budget:
+            stopped = True
+            return None
+        length = len(path)
+        if length == n:
+            return _normalize_cycle(path) if _candidate_ok(inst, path) else None
+        if length == 1:
+            choices = adjacency[0]
+        else:
+            candidate_mask = masks[path[-2]] & masks[path[-1]] & ~used
+            choices = [u for u in range(n) if (candidate_mask >> u) & 1]
+            choices.sort(
+                key=lambda u: (
+                    _onward_count(masks, used | (1 << u), path[-1], u),
+                    u,
+                )
+            )
+        for nxt in choices:
+            if used >> nxt & 1:
+                continue
+            path.append(nxt)
+            result = visit(used | (1 << nxt))
+            if result is not None:
+                return result
+            path.pop()
+            if stopped:
+                return None
+        return None
+
+    return visit(1), nodes
+
+
+def _relabel_instance(inst: dict, permutation: list[int], reorder_seed: int) -> dict:
+    n = inst["n"]
+    if sorted(permutation) != list(range(n)):
+        raise ValueError("not a vertex permutation")
+    edges = [
+        sorted((permutation[u], permutation[v])) for u, v in inst["edges"]
+    ]
+    random.Random(reorder_seed).shuffle(edges)
+    adjacency, masks = _make_adjacency(n, edges)
+    return {
+        **inst,
+        "vertices": list(range(n)),
+        "edges": edges,
+        "adjacency": adjacency,
+        "adjacency_masks": masks,
+        "answer": _normalize_cycle([permutation[v] for v in inst["answer"]]),
+    }
+
+
+# Script-owned oracle diagnostics are filled after the three isolated runs.
+_G9_ARMS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+}
+_G9_HINTED_VERDICT = "not_run"
+
+
+def selftest() -> dict:
+    report: dict[str, object] = {
+        "paper": "2502.14794",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+        "shipping_params": DIFFICULTY[SHIPPING_DIFFICULTY],
+    }
+
+    g1_failures = []
+    g1_attempts = 0
+    for preset, preset_params in DIFFICULTY.items():
+        for seed in (0, 1, 2, 19):
+            instance = make_instance(seed=seed, **preset_params)
+            ok, why = verify(instance, instance["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": why})
+            if json.loads(json.dumps(instance["answer"])) != instance["answer"]:
+                g1_failures.append(
+                    {"preset": preset, "seed": seed, "reason": "answer_not_json_native"}
+                )
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    ship_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=731, **ship_params)
+    planted = inst["answer"]
+    swapped = None
+    for i in range(1, inst["n"] - 2):
+        for j in range(i + 1, inst["n"] - 1):
+            trial = planted[:]
+            trial[i], trial[j] = trial[j], trial[i]
+            ok, why = verify(inst, trial)
+            if not ok and why.startswith("missing_square_edge"):
+                swapped = trial
+                break
+        if swapped is not None:
+            break
+    if swapped is None:
+        raise AssertionError("could not construct an edge-invalid swap corruption")
+    corruptions = {
+        "drop": planted[:-1],
+        "swap": swapped,
+        "duplicate": planted[:-1] + [planted[-2]],
+        "empty": [],
+        "out_of_range": planted[:-1] + [inst["n"]],
+    }
+    corruption_results = {}
+    reason_codes = []
+    for name, bad in corruptions.items():
+        ok, why = verify(inst, bad)
+        code = why.split(":", 1)[0]
+        corruption_results[name] = {"rejected": not ok, "reason": why}
+        reason_codes.append(code)
+    report["G2_rejects_corruption"] = {
+        "pass": all(item["rejected"] for item in corruption_results.values())
+        and len(set(reason_codes)) == len(reason_codes),
+        "cases": corruption_results,
+        "distinct_reason_codes": len(set(reason_codes)),
+    }
+
+    response = (
+        "I propagated common-neighborhood constraints and checked wraparound.\n\n"
+        "```json\n<answer>\n"
+        + json.dumps(planted)
+        + "\n</answer>\n```\nThis uses the required canonical orientation."
+    )
+    parsed = parse_answer(response)
+    parsed_ok, parsed_why = verify(inst, parsed)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parsed_ok,
+        "parsed_equals_answer": parsed == planted,
+        "verify_reason": parsed_why,
+        "garbage_returns_none": parse_answer("there is no answer block") is None,
+    }
+
+    guess_rng = random.Random(20260905)
+    guess_total = 200_000
+    guess_hits = 0
+    start = time.perf_counter()
+    for _ in range(guess_total):
+        if verify(inst, random_candidate(inst, guess_rng))[0]:
+            guess_hits += 1
+    density_wall = time.perf_counter() - start
+    observed = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": observed < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": observed,
+        "candidate_prior": "uniform canonical cyclic permutations",
+        "search_space": str(search_space(inst)),
+    }
+
+    demo = make_instance(seed=731, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+
+    attack_seeds = list(range(9100, 9108))
+    successes = {
+        "degree_triangle_outlier_order": 0,
+        "greedy_common_neighborhood": 0,
+        "random_restart_256": 0,
+        "centered_spectral_seriation": 0,
+        "common_neighborhood_dfs_250k": 0,
+    }
+    greedy_operations = 0
+    random_operations = 0
+    spectral_operations = 0
+    dfs_nodes = 0
+    dfs_wall = 0.0
+    dfs_nodes_per_seed = []
+    for seed in attack_seeds:
+        attack_inst = make_instance(seed=seed, **ship_params)
+        if _candidate_ok(attack_inst, _attack_degree_triangle_order(attack_inst)):
+            successes["degree_triangle_outlier_order"] += 1
+        candidate, operations = _attack_greedy_common(attack_inst)
+        greedy_operations += operations
+        if _candidate_ok(attack_inst, candidate):
+            successes["greedy_common_neighborhood"] += 1
+        candidate, operations = _attack_random_restarts(
+            attack_inst, random.Random(seed ^ 0x5A17), restarts=256
+        )
+        random_operations += operations
+        if _candidate_ok(attack_inst, candidate):
+            successes["random_restart_256"] += 1
+        candidate, operations = _attack_centered_spectral(attack_inst)
+        spectral_operations += operations
+        if _candidate_ok(attack_inst, candidate):
+            successes["centered_spectral_seriation"] += 1
+        start = time.perf_counter()
+        candidate, nodes = _attack_common_neighbor_dfs(
+            attack_inst, node_budget=250_000
+        )
+        dfs_wall += time.perf_counter() - start
+        dfs_nodes += nodes
+        dfs_nodes_per_seed.append(nodes)
+        if _candidate_ok(attack_inst, candidate):
+            successes["common_neighborhood_dfs_250k"] += 1
+
+    attacks = {
+        name: {"successes": count, "attempts": len(attack_seeds)}
+        for name, count in successes.items()
+    }
+    attacks["greedy_common_neighborhood"]["operations"] = greedy_operations
+    attacks["random_restart_256"]["operations"] = random_operations
+    attacks["centered_spectral_seriation"]["operations"] = spectral_operations
+    attacks["common_neighborhood_dfs_250k"].update(
+        {
+            "nodes": dfs_nodes,
+            "nodes_per_seed": dfs_nodes_per_seed,
+            "wall_clock_sec": round(dfs_wall, 6),
+            "standard_algorithm": True,
+        }
+    )
+    all_failed = all(item["successes"] == 0 for item in attacks.values())
+    report["G5_density_and_baseline"] = {
+        "pass": observed < 1e-6 and all_failed and dfs_nodes > 0,
+        "shipping_density": {
+            "hits": guess_hits,
+            "samples": guess_total,
+            "observed_fraction": observed,
+            "wall_clock_sec": round(density_wall, 6),
+        },
+        "demo_exact_valid_answers": demo_count,
+        "demo_search_space": search_space(demo),
+        "strongest_attack": {
+            "name": "exact common-neighborhood DFS with wraparound checks",
+            "wall_clock_sec": round(dfs_wall, 6),
+            "nodes": dfs_nodes,
+            "nodes_per_seed": dfs_nodes_per_seed,
+            "attempts": len(attack_seeds),
+            "successes": successes["common_neighborhood_dfs_250k"],
+        },
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and len(attacks) >= 4,
+        "attacks": attacks,
+    }
+
+    doubled_params = dict(ship_params)
+    doubled_params["n"] = ship_params["n"] * 2
+    start = time.perf_counter()
+    doubled = make_instance(seed=4471, **doubled_params)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] > inst["n"],
+        "base_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "build_and_verify_sec": round(time.perf_counter() - start, 6),
+        "verify_reason": doubled_why,
+    }
+
+    invariance_checks = 0
+    transport_checks = 0
+    nontrivial = 0
+    unrelated_keys = []
+    for seed in range(20):
+        original = make_instance(seed=12000 + seed, **ship_params)
+        key = canonical_key(original)
+        unrelated_keys.append(key)
+        rng = random.Random(33000 + seed)
+        first = list(range(original["n"]))
+        second = list(range(original["n"]))
+        rng.shuffle(first)
+        rng.shuffle(second)
+        composed = [second[first[i]] for i in range(original["n"])]
+        variants = [
+            _relabel_instance(original, first, 44000 + seed),
+            _relabel_instance(original, list(range(original["n"])), 55000 + seed),
+            _relabel_instance(original, composed, 66000 + seed),
+        ]
+        for variant in variants:
+            invariance_checks += 1
+            if canonical_key(variant) != key:
+                continue
+            ok, _ = verify(variant, variant["answer"])
+            transport_checks += int(ok)
+            nontrivial += int(variant["edges"] != original["edges"])
+    report["G8_canonical_key"] = {
+        "pass": invariance_checks == 60
+        and transport_checks == 60
+        and nontrivial >= 20
+        and len(set(unrelated_keys)) == 20,
+        "invariance_checks": invariance_checks,
+        "witness_transport_checks": transport_checks,
+        "nontrivial_transformations": nontrivial,
+        "unrelated_distinct": len(set(unrelated_keys)),
+        "unrelated_attempts": len(unrelated_keys),
+        "invariant": "four-round WL colors plus colored edge common-neighbor profiles",
+    }
+
+    answer_blob = json.dumps(inst["answer"])
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    intended_operations = 2 * inst["n"]
+    hinted = _G9_ARMS["hinted"]
+    placebo = _G9_ARMS["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = (
+        placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    )
+    within_caps = (
+        answer_chars <= 2000
+        and inst["n"] <= 256
+        and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": _G9_ARMS,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": _G9_HINTED_VERDICT,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": inst["n"],
+        "intended_route_operations": intended_operations,
+        "caps_pass": within_caps,
+        "diagnostic_arms_are_not_gated": True,
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(bool(gate.get("pass")) for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))
