import random,collections

def trial(n,seed):
 q=n//2
 top=list(range(q)); bot=list(range(q,2*q))
 edges=[]
 for i in range(q):
  edges.append((i,(i+1)%q)); edges.append((q+i,q+(i+1)%q)); edges.append((i,q+i))
 order=list(range(q))+list(range(2*q-1,q-1,-1))
 pos={v:i for i,v in enumerate(order)}
 rng=random.Random(seed)
 for attempt in range(10000):
  U=set(rng.sample(range(len(edges)),len(edges)//2))
  counts={v:[0,0,0,1 if pos[v]<n//2 else 0,1 if pos[v]>=n//2 else 0] for v in range(n)}
  for j,(x,y) in enumerate(edges):
   if j in U: counts[x][2]+=1;counts[y][2]+=1
   else:
    if pos[x]>pos[y]:x,y=y,x
    counts[x][1]+=1;counts[y][0]+=1
  cc=collections.Counter(map(tuple,counts.values()))
  if min(cc.values())>1:
   # relation signature one refine
   rel={v:[] for v in range(n)}
   for j,(x,y) in enumerate(edges):
    if j in U: rel[x].append(('u',y));rel[y].append(('u',x))
    else:
     if pos[x]>pos[y]:x,y=y,x
     rel[x].append(('ao',y));rel[y].append(('ai',x))
   for i in range(n//2):
    x=order[i];y=order[i+n//2];rel[x].append(('to',y));rel[y].append(('ti',x))
   sig={v:(tuple(counts[v]),tuple(sorted((t,tuple(counts[w])) for t,w in rel[v]))) for v in range(n)}
   c2=collections.Counter(sig.values())
   return attempt, sorted(cc.values()),sum(z==1 for z in c2.values()),len(c2)
 return None
for n in [8,16,24,32,48,64,96]:
 vals=[trial(n,s) for s in range(20)]
 print(n, vals[:5], 'fails',sum(v is None for v in vals))
