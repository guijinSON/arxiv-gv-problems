+    key_mask = _sample_planted_mask(n, rng)
+    builder = _GraphBuilder()
+    components = []
+    tasks = [(missing, rep) for missing in range(n) for rep in range(copies)]
+    rng.shuffle(tasks)
+    for missing, rep in tasks:
