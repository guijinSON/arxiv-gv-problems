+def _parity(value):
+    return value.bit_count() & 1
+
+
+def _coeff_mask(bits):
+    value = 0
+    for i, bit in enumerate(bits):
+        value |= (bit & 1) << i
+    return value
+
+
+def _answer_from_mask(mask, n):
+    return [[i, (mask >> i) & 1] for i in range(n)]
