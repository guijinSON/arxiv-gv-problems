+        "invariance_checks": invariant_checks,
+        "problem_preserving_transform_checks": real_transform_checks,
+        "unrelated_distinct": distinct,
+        "unrelated_attempts": 20,
+        "symmetries_tested": [
+            "vertex renaming",
+            "arc/edge/terminal/component/constraint input reordering",
