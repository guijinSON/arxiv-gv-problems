+    "answer_chars": 663,
+    "answer_tokens": 166,
+    "answer_elements": 192,
+    "intended_route_operations": 288,
+    "caps": {
+      "chars": 2000,
+      "elements": 256,
+      "operations": 300
+    }
+  },
+  "track": "B",
+  "shipping_difficulty": "hard",
+  "all_passed": true
+}

