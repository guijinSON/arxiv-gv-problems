+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A canonical list [[0,c0],[1,c1],...,[n-1,c_(n-1)]] containing "
+        "exactly one bit ci in {0,1} for every coefficient index.  It denotes "
