+        pivot += 1
+    for mask, rhs in rows:
+        operations += 1
+        if mask == 0 and rhs:
+            return None, operations
+    solution = 0
+    for col, row_index in enumerate(where):
+        if row_index >= 0 and rows[row_index][1]:
+            solution |= 1 << col
