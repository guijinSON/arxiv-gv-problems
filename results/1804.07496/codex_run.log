+        "shipping_vertices": shipping["vertex_count"],
+        "doubled_n": doubled["n"],
+        "doubled_vertices": doubled["vertex_count"],
+    }
+
+    invariant_checks = 0
+    real_transform_checks = 0
+    keys = []
