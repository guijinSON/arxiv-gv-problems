+"""Verified generator based on Theorem 2.2 of arXiv:2005.08095.
+
+The paper reduces Maximum Clique to General d-Position by adjoining H_t.
+Here G is a compact, k-partite graph over a prime field.  Every ordinary
+colour-pair relation is the union of three translations.  One exceptional
+pair is the union of three affine maps.  A planted system of translations is
+sampled before the graph is built, so a transversal clique is known without
+solving the generated instance.
+
+The family is Track B.  Lexicographic CSP search must scan most field values,
+while a short additive-cocycle calculation recovers the relative translations
+and turns the exceptional affine relation into the answer.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "the paper's graph G' obtained by joining H_t to a compact k-partite graph G",
+        "a prescribed-size general d-position set represented by its G-vertices",
+    ],
+    "verification_operations": [
+        "exact modular affine evaluation",
+        "exact graph adjacency lookup",
+        "exact clique and cardinality checks",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 2, Proposition 2.1 and Theorem 2.2: construct H_t and join "
+        "A union B union {v_1} to G, giving gp_d(G')=gp_d(H_t)+omega(G)"
+    ),
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "One intercept from each ordinary colour-pair relation obeys an additive "
+        "cocycle, and the lone slope-2 relation fixes the remaining global translation; "
+        "without this invariant, lexicographic clique search scans most of the field."
+    ),
+    "hardness_basis": (
+        "Track B: lexicographic multicoloured-clique CSP search with forward checking "
+        "costs O(p*r^2+k*r^2) on this r=3 construction and, at shipping p=200003, "
+        "averages 1,875,091 exact operations, 48,057 field values, and 0.081 seconds "
+        "over eight audit seeds; the additive-cocycle route uses 199 exact operations."
+    ),
+    "max_answer_tokens": 43,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 17, "classes": 4, "degree": 3},
+    "easy": {"n": 200003, "classes": 22, "degree": 3},
+    "medium": {"n": 500009, "classes": 22, "degree": 3},
+    "hard": {"n": 1000003, "classes": 22, "degree": 3},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Across the slope-1 pairs, one intercept per three-element set obeys the additive "
+    "cocycle identity around every triangle."
+)
+PLACEBO_HINT = (
+    "Across the listed colour pairs, careful bookkeeping of the modular labels and "
+    "answer slots is especially important."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list containing exactly one displayed integer vertex label from each "
+        "colour class, in class order; class Ci contains labels i*p through (i+1)*p-1."
+    ),
+    "bounds": {
+        "length": "number of colour classes",
+        "entry_min": 0,
+        "entry_max": "p times number of colour classes minus 1",
+        "one_per_colour": True,
+        "candidate_count": "p^(number of colour classes)",
+    },
+}
+
+NOTES = (
+    "Section 1, equation (1), fixes the forbidden configuration as three selected "
+    "vertices on a common geodesic of length at most d. Section 2, Proposition 2.1 "
+    "gives gp_t(H_t)=4t, and Theorem 2.2 supplies the exact H_t join used here. "
+    "Propositions 3.1 and 3.3 make paths and cycles easy, while Section 6 notes "
+    "polynomial algorithms for gp_2 and ordinary general position on trees; those "
+    "regimes were avoided. The certificate-producing reference method here is a "
+    "lexicographic CSP scan, not a hidden oracle. Its mechanical cost and the compact "
+    "cocycle route are both measured. Equal pair-degrees defeat degree outliers; high "
+    "exceptional roots defeat zero-first greedy search; random restarts and the common-"
+    "coordinate ansatz are tested separately."
+)
