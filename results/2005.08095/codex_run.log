   532	def canonical_key(inst):
   533	    """Strong cheap invariant under colour, row, column, and label relabelling.
   534	
   535	    Exact canonicalisation contains coloured graph isomorphism.  The sorted pair
   536	    signatures use both row- and column-common-neighbour spectra and exact
   537	    four-cycle counts.  They are invariant but can theoretically collide on
   538	    nonisomorphic adversarial graphs; the README records that caveat.
   539	    """
   540	    cmap = _compat_map(inst)
   541	    if cmap is None:
