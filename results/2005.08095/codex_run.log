   506	def _intersection_spectrum(masks):
   507	    return sorted(
   508	        (masks[i] & masks[j]).bit_count()
   509	        for i in range(len(masks))
   510	        for j in range(i + 1, len(masks))
   511	    )
   512	
   513	
   514	def _pair_signature(rows):
   515	    n = len(rows)
   516	    row_masks = [int(row, 2) for row in rows]
   517	    col_masks = []
   518	    for j in range(n):
   519	        mask = 0
   520	        for i, row in enumerate(rows):
   521	            if row[j] == "1":
   522	                mask |= 1 << i
   523	        col_masks.append(mask)
   524	    a = _intersection_spectrum(row_masks)
   525	    b = _intersection_spectrum(col_masks)
   526	    if b < a:
   527	        a, b = b, a
   528	    four_cycles = sum(x * (x - 1) // 2 for x in a)
   529	    return [four_cycles, a, b]
