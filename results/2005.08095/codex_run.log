import random,time
import gen_2005_08095 as g
p=g.DIFFICULTY[g.SHIPPING_DIFFICULTY]

def attack(inst, seed, restarts=30, steps=3000):
    masks=g._adjacency_masks(inst); k=inst['color_count']; n=inst['n']; rng=random.Random(seed)
    def conflicts(a):
        return sum(not ((masks[i][a[i]][j]>>a[j])&1) for i in range(k) for j in range(i+1,k))
    checked=0
    for r in range(restarts):
        a=[rng.randrange(n) for _ in range(k)]
        bad=conflicts(a)
        for step in range(steps):
            checked+=1
            if bad==0: return g._local_answer(inst,a), {'restart':r,'step':step,'states':checked}
            cs=[]
            for i in range(k):
                c=sum(not ((masks[min(i,j)][a[i] if i<j else a[j]][max(i,j)] >> (a[j] if i<j else a[i]))&1) for j in range(k) if j"'!=i)
                if c: cs.append((i,c))
            i=rng.choice([i for i,c in cs if c==max(x[1] for x in cs)]) if rng.random()<.8 else rng.choice(cs)[0]
            vals=[]
            for x in range(n):
                c=0
                for j in range(k):
                    if i==j: continue
                    if i<j: ok=(masks[i][x][j]>>a[j])&1
                    else: ok=(masks[i][x][j]>>a[j])&1
                    c += not ok
                vals.append(c)
            best=min(vals)
            choices=[x for x,c in enumerate(vals) if c==best]
            old=a[i]
            # noise and tabu-lite
            a[i]=rng.choice(choices if rng.random()<.94 else list(range(n)))
            newbad=conflicts(a)
            if newbad>bad and rng.random()>.03:
                a[i]=old
            else:
                bad=newbad
    return None, {'"'states':checked,'best':bad}

for seed in range(800,808):
    t=time.perf_counter(); inst=g.make_instance(seed=seed,**p); built=time.perf_counter()-t
    t=time.perf_counter(); ans,c=attack(inst,seed"'^12345); elapsed=time.perf_counter()-t
    print(seed,'"'build',round(built,2),'attack',round(elapsed,2),bool(ans),c, g.verify(inst,ans) if ans else '')
