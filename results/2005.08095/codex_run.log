   667	def _attack_random_restart(inst, rng, restarts=64):
   668	    masks = _adjacency_masks(inst)
   669	    if masks is None:
   670	        return None
   671	    for _ in range(restarts):
   672	        candidate = _greedy_once(inst, masks, rng)
   673	        if candidate is not None and verify(inst, candidate)[0]:
   674	            return candidate
   675	    return None
