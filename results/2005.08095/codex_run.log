+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0, "service_errors": 4},
+    "hinted": {"solved": 0, "attempts": 0, "service_errors": 4},
+    "placebo": {"solved": 0, "attempts": 0, "service_errors": 4},
+    "hinted_verdict": "unreachable",
+}
