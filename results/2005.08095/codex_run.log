+
+def _relation_map(inst):
+    cached = inst.get("_relation_cache") if isinstance(inst, dict) else None
+    if isinstance(cached, dict):
+        return cached
+    try:
+        p = inst["modulus"]
+        k = inst["color_count"]
+        result = {}
+        for rec in inst["relations"]:
+            i, j = rec["left"], rec["right"]
+            slope = rec["slope"]
+            intercepts = rec["intercepts"]
+            if not (0 <= i < j < k) or (i, j) in result:
+                return None
+            if not _is_int(slope) or not 1 <= slope < p:
+                return None
+            if (
+                not isinstance(intercepts, list)
+                or len(intercepts) != 3
+                or len(set(intercepts)) != 3
+                or any(not _is_int(b) or not 0 <= b < p for b in intercepts)
+            ):
+                return None
+            result[(i, j)] = (slope, tuple(intercepts))
+        if len(result) != k * (k - 1) // 2:
+            return None
+        inst["_relation_cache"] = result
+        return result
+    except (KeyError, TypeError, ValueError):
+        return None
+
+
+def _oriented_offsets(relations, p, i, j):
+    """Offsets x_j-x_i for a slope-1 relation, in either orientation."""
+    if i < j:
+        slope, values = relations[(i, j)]
+        if slope != 1:
+            return None
+        return tuple(values)
+    slope, values = relations[(j, i)]
+    if slope != 1:
+        return None
+    return tuple((-value) % p for value in values)
+
+
+def _recover_shifts(inst, count_operations=False):
+    """Recover the unique additive cocycle using only public relation data."""
+    relations = _relation_map(inst)
+    if relations is None:
+        return None, 0
+    p, k = inst["modulus"], inst["color_count"]
+    special = [(pair, data) for pair, data in relations.items() if data[0] != 1]
+    if len(special) != 1:
+        return None, 0
+    (left, right), _ = special[0]
+    anchors = [i for i in range(k) if i not in (left, right)]
+    if len(anchors) < 2:
+        return None, 0
+    c, d = anchors[:2]
+    ac = _oriented_offsets(relations, p, left, c)
+    cd = _oriented_offsets(relations, p, c, d)
+    ad = _oriented_offsets(relations, p, left, d)
+    if ac is None or cd is None or ad is None:
+        return None, 0
+
+    operations = 0
+    anchor_solutions = []
+    ad_set = set(ad)
+    for x in ac:
