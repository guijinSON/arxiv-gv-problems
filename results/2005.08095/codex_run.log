   340	def verify(inst, answer):
   341	    """Check any valid compact target-size witness; never read ``inst['answer']``."""
   342	    if not isinstance(answer, list):
   343	        return False, "answer must be a JSON list"
   344	    if not answer:
   345	        return False, "answer is empty"
   346	    if any(not _is_int(value) for value in answer):
   347	        return False, "every representative must be an integer vertex label"
   348	
   349	    try:
   350	        k, n = inst["color_count"], inst["n"]
   351	        t = inst["G_order_t"]
   352	        if (
   353	            inst.get("recipe") != "theorem-2.2-Ht-join-v1"
   354	            or t != n * k
   355	            or inst["d"] != t
   356	            or inst["fixed_Ht_certificate_size"] != 4 * t
   357	            or inst["target_size"] != 4 * t + k
   358	            or inst["Ht_order"] != 6 * t - 3
   359	            or inst["Gprime_order"] != 7 * t - 3
   360	        ):
   361	            return False, "malformed Theorem 2.2 construction parameters"
   362	    except (KeyError, TypeError):
   363	        return False, "malformed instance"
   364	
   365	    if len(answer) != k:
   366	        return False, f"wrong length: expected {k} representatives, got {len(answer)}"
   367	    if len(set(answer)) != len(answer):
   368	        return False, "representative labels must be distinct"
   369	    maps = _local_maps(inst)
   370	    cmap = _compat_map(inst)
   371	    if maps is None or cmap is None:
   372	        return False, "malformed instance data"
   373	    owner, local = maps
   374	    for i, label in enumerate(answer):
   375	        if label not in owner:
   376	            return False, f"unknown vertex label {label}"
   377	        if owner[label] != i:
   378	            return False, (
   379	                f"slot {i + 1} requires colour {i + 1}, but label {label} "
   380	                f"belongs to colour {owner[label] + 1}"
   381	            )
   382	
   383	    # A union B is a K_{4t}, and Theorem 2.2 joins all of it to every G vertex.
   384	    # Thus its union with the submitted vertices is a clique exactly when the
   385	    # submitted G vertices are a clique.  A clique contains no geodesic triple.
   386	    for i in range(k):
   387	        for j in range(i + 1, k):
   388	            if not _compatible(cmap, local, i, answer[i], j, answer[j]):
   389	                return False, (
   390	                    f"labels {answer[i]} and {answer[j]} are incompatible "
   391	                    f"for colours {i + 1} and {j + 1}"
   392	                )
   393	    # The target asks only for feasibility at this displayed size.  The checker
   394	    # therefore needs no non-executable optimality claim: completeness of the
   395	    # expanded induced graph directly proves the geodesic condition.
   396	    return True, "ok"
   397	
