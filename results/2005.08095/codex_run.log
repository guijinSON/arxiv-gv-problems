+                colour_permutation=colour_perm,
+                translation=translation,
+                reorder_records=reorder,
+            )
+            invariant_checks += 1
+            if canonical_key(transformed) != key:
+                key_failures.append({"seed": seed, "transform": name, "kind": "key"})
