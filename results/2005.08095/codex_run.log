   127	
   128	## How to use it
   129	
   130	```python
   131	import gen_2005_08095 as g
   132	
   133	params = g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
   134	inst = g.make_instance(seed=12345, **params)
   135	question = g.render(inst)
   136	candidate = g.parse_answer("<answer>" + str(inst["answer"]) + "</answer>")
   137	assert g.verify(inst, candidate) == (True, "ok")
