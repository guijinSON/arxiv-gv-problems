codex
The stronger construction remains fully exact and now uses a complete—not heuristic—CSP reference solver. Its compact route avoids pretending that a six-digit modular inverse is “one operation”: Euclidean divisions are counted explicitly, and the measured route is 275 operations at the shipping seed. The external oracle key is currently returning a total-quota 403 from both vendors; I’m preserving the obsolete transcripts separately and recording fresh failed-service runs so they cannot be mistaken for hardness evidence for this revised module.
exec
/bin/bash -lc 'mv llm_loop_transcript.jsonl previous_v1_llm_loop_transcript.jsonl
mv g9_hinted_transcript.jsonl previous_v1_g9_hinted_transcript.jsonl
mv g9_placebo_transcript.jsonl previous_v1_g9_placebo_transcript.jsonl
cp gen_2005_08095.py g9_hinted/gen_2005_08095.py
cp gen_2005_08095.py g9_placebo/gen_2005_08095.py
(cd g9_hinted && GV_HINT_MODE=structural ORACLE_MAX_ESCALATIONS=0 python3 ../../../scripts/harden.py gen_2005_08095.py) || true
cp g9_hinted/llm_loop_transcript.jsonl g9_hinted_transcript.jsonl
(cd g9_placebo && GV_HINT_MODE=placebo ORACLE_MAX_ESCALATIONS=0 python3 ../../../scripts/harden.py gen_2005_08095.py) || true
