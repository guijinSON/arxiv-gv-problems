   543	    signatures = sorted(_pair_signature(rows) for rows in cmap.values())
   544	    payload = [inst["color_count"], inst["n"], inst["cross_degree"], signatures]
   545	    digest = hashlib.sha256(
   546	        json.dumps(payload, separators=(",", ":")).encode("utf-8")
   547	    ).hexdigest()
   548	    return "general-d-position-Ht-v1:" + digest
