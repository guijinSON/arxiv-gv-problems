+                        for j in range(1, colour):
+                            counters["edge_checks"] += 1
+                            counters["modular_operations"] += 2
+                            if not _edge(relations, p, j, values[j], colour, value):
+                                good = False
+                                break
+                        if good:
+                            chosen = value
+                            break
+                    if chosen is None:
