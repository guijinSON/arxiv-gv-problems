   464	def parse_answer(text):
   465	    """Parse a tagged JSON integer list, tolerating prose and Markdown fences."""
   466	    if not isinstance(text, str):
   467	        return None
   468	    matches = _ANSWER_RE.findall(text)
   469	    if not matches:
   470	        return None
   471	    body = matches[-1].strip()
   472	    fenced = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
   473	    if fenced:
   474	        body = fenced.group(1).strip()
   475	    try:
   476	        value = json.loads(body)
   477	    except (TypeError, ValueError):
   478	        return None
   479	    if not isinstance(value, list) or any(not _is_int(x) for x in value):
   480	        return None
   481	    return value
