   678	def _attack_spectral(inst, iterations=14):
   679	    """Centred power iteration on the multipartite compatibility graph."""
   680	    masks = _adjacency_masks(inst)
   681	    if masks is None:
   682	        return None
   683	    k, n, degree = inst["color_count"], inst["n"], inst["cross_degree"]
   684	    rng = random.Random(0x200508095)
   685	    vector = [
   686	        [rng.randrange(-1000, 1001) / 1000.0 for _ in range(n)]
   687	        for _ in range(k)
   688	    ]
   689	    for _ in range(iterations):
   690	        sums = [sum(block) for block in vector]
   691	        nxt = [[0.0] * n for _ in range(k)]
   692	        for i in range(k):
   693	            for x in range(n):
   694	                value = 0.0
   695	                for j in range(k):
   696	                    if i == j:
   697	                        continue
   698	                    bits = masks[i][x][j]
   699	                    neighbour_sum = 0.0
   700	                    while bits:
   701	                        low = bits & -bits
   702	                        y = low.bit_length() - 1
   703	                        bits -= low
   704	                        neighbour_sum += vector[j][y]
   705	                    value += neighbour_sum - (degree / n) * sums[j]
   706	                nxt[i][x] = value
   707	        norm = math.sqrt(sum(v * v for block in nxt for v in block)) or 1.0
   708	        vector = [[v / norm for v in block] for block in nxt]
   709	    for sign in (1.0, -1.0):
   710	        local_values = [
   711	            max(range(n), key=lambda x: (sign * vector[i][x], -x))
   712	            for i in range(k)
   713	        ]
   714	        candidate = _local_answer(inst, local_values)
   715	        if verify(inst, candidate)[0]:
   716	            return candidate
   717	    return None
   718	
