   841	def _corruptions(inst):
   842	    answer = list(inst["answer"])
   843	    corrupt = {
   844	        "empty": [],
   845	        "drop_one": answer[:-1],
   846	        "duplicate": [answer[1]] + answer[1:],
   847	        "out_of_range": [max(max(block) for block in inst["colors"]) + 1] + answer[1:],
   848	        "swap_slots": answer[1:2] + answer[0:1] + answer[2:],
   849	    }
   850	    replacement = None
   851	    for slot, block in enumerate(inst["colors"]):
   852	        for label in block:
   853	            if label == answer[slot]:
   854	                continue
   855	            candidate = answer[:]
   856	            candidate[slot] = label
   857	            if not verify(inst, candidate)[0]:
   858	                replacement = candidate
   859	                break
   860	        if replacement is not None:
   861	            break
   862	    corrupt["incompatible_replacement"] = replacement
   863	    return corrupt
