   600	def _attack_outlier(inst):
   601	    """Choose maximum triangle participation independently in each colour."""
   602	    masks = _adjacency_masks(inst)
   603	    if masks is None:
   604	        return None
   605	    k, n = inst["color_count"], inst["n"]
   606	    chosen = []
   607	    for i in range(k):
   608	        scores = []
   609	        for x in range(n):
   610	            score = 0
   611	            for j in range(k):
   612	                if j == i:
   613	                    continue
   614	                bits = masks[i][x][j]
   615	                while bits:
   616	                    low = bits & -bits
   617	                    y = low.bit_length() - 1
   618	                    bits -= low
   619	                    for h in range(j + 1, k):
   620	                        if h != i:
   621	                            score += (
   622	                                masks[i][x][h] & masks[j][y][h]
   623	                            ).bit_count()
   624	            scores.append((score, -inst["colors"][i][x], x))
   625	        chosen.append(max(scores)[2])
   626	    return _local_answer(inst, chosen)
