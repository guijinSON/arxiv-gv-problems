   780	def _relabel_instance(inst, rng):
   781	    """Permute colours, vertices, and labels, carrying the planted witness."""
   782	    k, n = inst["color_count"], inst["n"]
   783	    old_cmap = _compat_map(inst)
   784	    maps = _local_maps(inst)
   785	    if old_cmap is None or maps is None:
   786	        raise ValueError("malformed instance")
   787	    old_owner, _ = maps
   788	
   789	    colour_order = list(range(k))
   790	    rng.shuffle(colour_order)
   791	    old_positions_for_new = []
   792	    label_map = {}
   793	    all_new_labels = list(range(10_000_001, 10_000_001 + k * n))
   794	    rng.shuffle(all_new_labels)
   795	    cursor = 0
   796	    new_colours = []
   797	    for old_i in colour_order:
   798	        order = list(range(n))
   799	        rng.shuffle(order)
   800	        old_positions_for_new.append(order)
   801	        block = []
   802	        for old_pos in order:
   803	            old_label = inst["colors"][old_i][old_pos]
   804	            new_label = all_new_labels[cursor]
   805	            cursor += 1
   806	            label_map[old_label] = new_label
   807	            block.append(new_label)
   808	        new_colours.append(block)
   809	
   810	    new_compatibility = []
   811	    for a in range(k):
   812	        old_a = colour_order[a]
   813	        for b in range(a + 1, k):
   814	            old_b = colour_order[b]
   815	            rows = []
   816	            for old_x in old_positions_for_new[a]:
   817	                bits = []
   818	                for old_y in old_positions_for_new[b]:
   819	                    if old_a < old_b:
   820	                        bit = old_cmap[(old_a, old_b)][old_x][old_y]
   821	                    else:
   822	                        bit = old_cmap[(old_b, old_a)][old_y][old_x]
   823	                    bits.append(bit)
   824	                rows.append("".join(bits))
   825	            new_compatibility.append({"left": a, "right": b, "rows": rows})
   826	
   827	    old_answer_by_colour = {old_owner[label]: label for label in inst["answer"]}
   828	    new_answer = [label_map[old_answer_by_colour[old_i]] for old_i in colour_order]
   829	    transformed = {
   830	        key: value
   831	        for key, value in inst.items()
   832	        if key not in {"colors", "compatibility", "answer"}
   833	        and not key.startswith("_")
   834	    }
   835	    transformed["colors"] = new_colours
   836	    transformed["compatibility"] = new_compatibility
   837	    transformed["answer"] = new_answer
   838	    return transformed
   839	
