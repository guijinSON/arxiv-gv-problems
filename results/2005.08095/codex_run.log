   551	def escalate(params):
   552	    """Grow the colour classes while keeping the answer length fixed."""
   553	    if not isinstance(params, dict) or "n" not in params:
   554	        return None
   555	    n = int(params["n"])
   556	    classes = int(params.get("classes", 22))
   557	    new_n = n + 8
   558	    return {
   559	        "n": new_n,
   560	        "classes": classes,
   561	        "degree": max(
   562	            1,
   563	            min(new_n - 1, round(new_n ** (1.0 - 2.0 / (classes - 1)))),
   564	        ),
   565	    }
