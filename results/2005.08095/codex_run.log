   571	
   572	def _adjacency_masks(inst):
   573	    cached = inst.get("_mask_cache") if isinstance(inst, dict) else None
   574	    if isinstance(cached, list):
   575	        return cached
   576	    cmap = _compat_map(inst)
   577	    if cmap is None:
   578	        return None
   579	    k, n = inst["color_count"], inst["n"]
   580	    masks = [[[0] * k for _ in range(n)] for _ in range(k)]
   581	    for (i, j), rows in cmap.items():
   582	        for x, bits in enumerate(rows):
   583	            masks[i][x][j] = int(bits[::-1], 2)
   584	        for y in range(n):
   585	            reverse = 0
   586	            for x, bits in enumerate(rows):
   587	                if bits[y] == "1":
   588	                    reverse |= 1 << x
   589	            masks[j][y][i] = reverse
   590	    inst["_mask_cache"] = masks
   591	    return masks
