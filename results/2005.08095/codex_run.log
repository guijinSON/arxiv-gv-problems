+    for x0 in range(p):
+        counters["field_values"] += 1
+        first = _neighbours(relations, p, 0, x0, 1)
+        second = _neighbours(relations, p, 0, x0, 2)
+        counters["modular_operations"] += 12
+        for x1 in first:
+            for x2 in second:
+                counters["edge_checks"] += 1
+                counters["modular_operations"] += 2
+                if not _edge(relations, p, 1, x1, 2, x2):
+                    continue
+                values = [x0, x1, x2]
+                feasible = True
+                for colour in range(3, k):
+                    candidates = _neighbours(relations, p, 0, x0, colour)
+                    counters["modular_operations"] += 6
+                    chosen = None
+                    for value in candidates:
