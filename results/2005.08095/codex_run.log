   629	def _greedy_once(inst, masks, rng=None):
   630	    k, n = inst["color_count"], inst["n"]
   631	    domains = [(1 << n) - 1 for _ in range(k)]
   632	    assigned = [-1] * k
   633	    for _ in range(k):
   634	        colour = min(
   635	            (i for i in range(k) if assigned[i] < 0),
   636	            key=lambda i: (domains[i].bit_count(), i),
   637	        )
   638	        bits = domains[colour]
   639	        if not bits:
   640	            return None
   641	        candidates = []
   642	        while bits:
   643	            low = bits & -bits
   644	            value = low.bit_length() - 1
   645	            bits -= low
   646	            score = sum(
   647	                (domains[j] & masks[colour][value][j]).bit_count()
   648	                for j in range(k)
   649	                if assigned[j] < 0 and j != colour
   650	            )
   651	            candidates.append((score, value))
   652	        best_score = max(score for score, _ in candidates)
   653	        best = [value for score, value in candidates if score == best_score]
   654	        value = rng.choice(best) if rng is not None else min(best)
   655	        assigned[colour] = value
   656	        for j in range(k):
   657	            if assigned[j] < 0:
   658	                domains[j] &= masks[colour][value][j]
   659	    return _local_answer(inst, assigned)
   660	
   661	
   662	def _attack_greedy(inst):
   663	    masks = _adjacency_masks(inst)
   664	    return None if masks is None else _greedy_once(inst, masks)
   665	
