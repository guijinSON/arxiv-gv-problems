+    operations = 0
+    anchor_solutions = []
+    ad_set = set(ad)
+    for x in ac:
+        for y in cd:
+            operations += 1
+            if (x + y) % p in ad_set:
+                anchor_solutions.append((x, y, (x + y) % p))
+    if len(anchor_solutions) != 1:
