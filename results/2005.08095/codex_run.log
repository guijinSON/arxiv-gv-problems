   720	def _attack_exact(inst, node_budget=_EXACT_NODE_BUDGET):
   721	    """Exact MRV clique search with forward checking and measured counters."""
   722	    masks = _adjacency_masks(inst)
   723	    if masks is None:
   724	        return None, {"nodes": 0, "updates": 0, "exhausted": False}
   725	    k, n = inst["color_count"], inst["n"]
   726	    domains = [(1 << n) - 1 for _ in range(k)]
   727	    assigned = [-1] * k
   728	    nodes = 0
   729	    updates = 0
   730	    exhausted = False
   731	
   732	    def dfs(depth):
   733	        nonlocal nodes, updates, exhausted
   734	        nodes += 1
   735	        if nodes > node_budget:
   736	            exhausted = True
   737	            return None
   738	        if depth == k:
   739	            return assigned[:]
   740	        colour = min(
   741	            (i for i in range(k) if assigned[i] < 0),
   742	            key=lambda i: (domains[i].bit_count(), i),
   743	        )
   744	        bits = domains[colour]
   745	        while bits and not exhausted:
   746	            low = bits & -bits
   747	            value = low.bit_length() - 1
   748	            bits -= low
   749	            assigned[colour] = value
   750	            changes = []
   751	            feasible = True
   752	            for j in range(k):
   753	                if assigned[j] >= 0:
   754	                    continue
   755	                new_domain = domains[j] & masks[colour][value][j]
   756	                updates += 1
   757	                if new_domain != domains[j]:
   758	                    changes.append((j, domains[j]))
   759	                    domains[j] = new_domain
   760	                if not new_domain:
   761	                    feasible = False
   762	                    break
   763	            if feasible:
   764	                found = dfs(depth + 1)
   765	                if found is not None:
   766	                    return found
   767	            for j, old_domain in reversed(changes):
   768	                domains[j] = old_domain
   769	            assigned[colour] = -1
   770	        return None
   771	
   772	    found = dfs(0)
   773	    return _local_answer(inst, found), {
   774	        "nodes": nodes,
   775	        "updates": updates,
   776	        "exhausted": exhausted,
   777	    }
   778	
