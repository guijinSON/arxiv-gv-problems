   866	def selftest():
   867	    report = {}
   868	
   869	    failures = []
   870	    checks = 0
   871	    for preset, params in DIFFICULTY.items():
   872	        for seed in (0, 1, 2):
   873	            inst = make_instance(seed=seed, **params)
   874	            ok, why = verify(inst, inst["answer"])
