+    for vertex in range(k):
+        if vertex in (left, right, c, d):
+            continue
+        av = _oriented_offsets(relations, p, left, vertex)
+        cv = set(_oriented_offsets(relations, p, c, vertex) or ())
+        dv = set(_oriented_offsets(relations, p, d, vertex) or ())
+        choices = []
