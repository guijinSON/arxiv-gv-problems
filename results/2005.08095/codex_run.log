def make_instance(n, seed=0, **params):
    """Inverse-generate a paper-exact MWACT gadget instance.

    The answer (one local representative per colour) is sampled first.  Every
    pairwise compatibility graph is then built around the corresponding forced
    edge.  No ACT assignment, clique, or reconciliation is solved during
    generation.
    """
    classes = params.pop("classes", 18)
    degree = params.pop("degree", max(1, min(n - 1, round(3 * n / 5))))
    if params:
        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
    _validate_params(n, classes, degree, seed)
    rng = random.Random(seed)

    planted_local = [rng.randrange(n) for _ in range(classes)]

    labels = list(range(1, n * classes + 1))
    rng.shuffle(labels)
    colour_lists = []
    cursor = 0
    for _ in range(classes):
        block = labels[cursor:cursor + n]
        cursor += n
        rng.shuffle(block)
        colour_lists.append(block)

    compatibility = []
    for left in range(classes):
        for right in range(left + 1, classes):
            rows = _regular_pair(
                n,
                degree,
                planted_local[left],
                planted_local[right],
                rng,
            )
            compatibility.append({"left": left, "right": right, "rows": rows})

    answer = [
        colour_lists[colour][planted_local[colour]]
        for colour in range(classes)
    ]
    instance = {
        "paper": "arXiv:1705.01240",
        "family": "paper Lemma 3 multicolored-clique to MWACT gadgets",
        "n": n,
        "color_count": classes,
        "cross_degree": degree,
        "colors": colour_lists,
        "compatibility": compatibility,
        "weight_bound": classes * classes + 2 * classes,
        "answer": answer,
    }
    # Derived read-only indexes keep repeated grading and the 200k density audit
    # linear in the number of candidates rather than in the input size.  They are
    # never rendered and carry no information absent from the portable fields.
    instance["_compat_cache"] = {
        (rec["left"], rec["right"]): rec["rows"] for rec in compatibility
    }
    owner = {}
    local = {}
    for colour, block in enumerate(colour_lists):
        for position, label in enumerate(block):
            owner[label] = colour
            local[label] = position
    instance["_local_cache"] = (owner, local)
    return instance


def _compat_map(inst):
    cached = inst.get("_compat_cache") if isinstance(inst, dict) else None
    if isinstance(cached, dict):
        return cached
    try:
        k = inst["color_count"]
        n = inst["n"]
        records = inst["compatibility"]
        result = {}
        for rec in records:
            i, j = rec["left"], rec["right"]
            rows = rec["rows"]
            if not (0 <= i < j < k) or len(rows) != n:
                return None
            if any(not isinstance(row, str) or len(row) != n
                   or set(row) - {"0", "1"} for row in rows):
                return None
            result[(i, j)] = rows
        if len(result) != k * (k - 1) // 2:
            return None
        inst["_compat_cache"] = result
        return result
    except (KeyError, TypeError, ValueError):
        return None


def _local_maps(inst):
    cached = inst.get("_local_cache") if isinstance(inst, dict) else None
    if isinstance(cached, tuple) and len(cached) == 2:
        return cached
    try:
        colours = inst["colors"]
        k, n = inst["color_count"], inst["n"]
        if len(colours) != k or any(len(block) != n for block in colours):
            return None
        owner = {}
        local = {}
        for colour, block in enumerate(colours):
            for position, label in enumerate(block):
                if not _is_int(label) or label in owner:
                    return None
                owner[label] = colour
                local[label] = position
        inst["_local_cache"] = (owner, local)
        return owner, local
    except (KeyError, TypeError):
        return None


def _compatible(inst, cmap, local, i, u, j, v):
    if i > j:
        i, j, u, v = j, i, v, u
    return cmap[(i, j)][local[u]][local[v]] == "1"


def _expanded_assignment(inst, representatives, owner, local, cmap):
    """Expand Lemma 3's compact clique witness into all ACT placements.

    A tree node is ``(gadget, root_or_leaf, name...)``.  All gadget roots are
    children of one unselectable global root.  Comparability is therefore node
    equality or a root/leaf pair inside the same named gadget.
    """
    colours = inst["colors"]
    k = inst["color_count"]
    selected = set(representatives)
    placements = []

    # (element, node, weight)
    placements.append(("START", ("START", "root", "S_IN"), 0))
    for i, chosen in enumerate(representatives):
        placements.append((
            ("CLASS", i),
            (("CHOOSE", chosen), "leaf", "CLASS_OUT", i),
            1,
        ))

    for i, block in enumerate(colours):
        chosen = representatives[i]
        for vertex in block:
            if vertex == chosen:
                placements.append((
                    ("VERTEX", vertex),
                    (("COVER", vertex), "root", "VERTEX_OUT"),
                    1,
                ))
                placements.append((
                    ("COUNT", vertex),
                    (("COUNT_SINGLETON", i), "root", "COUNT_OUT"),
                    1,
                ))
            else:
                placements.append((
                    ("VERTEX", vertex),
                    (("CHOOSE", vertex), "root", "VERTEX_IN"),
                    0,
                ))
                placements.append((
                    ("COUNT", vertex),
                    (("COVER", vertex), "leaf", "COUNT_IN"),
                    0,
                ))

            for j in range(k):
                if j == i:
                    continue
                if vertex == chosen:
                    target = representatives[j]
                    if not _compatible(inst, cmap, local, i, vertex, j, target):
                        return None, f"representatives {vertex} and {target} are incompatible"
                    placements.append((
                        ("TO", vertex, j),
                        (("CHOOSE", target), "leaf", "TO_OUT", vertex, j),
                        1,
                    ))
                else:
                    placements.append((
                        ("TO", vertex, j),
                        (("COVER", vertex), "leaf", "TO_IN", j),
                        0,
                    ))
    return placements, "ok"


def _check_expanded(inst, placements):
    seen_elements = set()
    occupied_nodes = set()
    gadget_roots = set()
    gadget_leaves = set()
    total_weight = 0

    for element, node, weight in placements:
        if element in seen_elements:
            return False, f"expanded element {element!r} was assigned twice"
        seen_elements.add(element)
        if node in occupied_nodes:
            return False, f"two expanded elements occupy the same tree node {node!r}"
        occupied_nodes.add(node)
        if weight not in (0, 1):
            return False, "expanded assignment uses a non-finite gadget weight"
        total_weight += weight

        gadget, level = node[0], node[1]
        if level == "root":
            if gadget in gadget_leaves:
                return False, f"a root and descendant are both chosen in gadget {gadget!r}"
            gadget_roots.add(gadget)
        elif level == "leaf":
            if gadget in gadget_roots:
                return False, f"a root and descendant are both chosen in gadget {gadget!r}"
            gadget_leaves.add(gadget)
        else:
            return False, "expanded tree node has no root/leaf level"

    if total_weight > inst["weight_bound"]:
        return False, (
            f"expanded weight {total_weight} exceeds bound {inst['weight_bound']}"
        )
    return True, "ok"


def verify(inst, answer):
    """Check any compact MWACT witness exactly; never read ``inst['answer']``."""
    if not isinstance(answer, list):
        return False, "answer must be a JSON list"
    if not answer:
        return False, "answer is empty"
    if any(not _is_int(value) for value in answer):
        return False, "every representative must be an integer vertex label"

    try:
        k = inst["color_count"]
    except (KeyError, TypeError):
        return False, "malformed instance"
    if len(answer) != k:
        return False, f"wrong length: expected {k} representatives, got {len(answer)}"
    if len(set(answer)) != len(answer):
        return False, "representative labels must be distinct"

    maps = _local_maps(inst)
    cmap = _compat_map(inst)
    if maps is None or cmap is None:
        return False, "malformed instance data"
    owner, local = maps
    for i, label in enumerate(answer):
        if label not in owner:
            return False, f"unknown vertex label {label}"
        if owner[label] != i:
            return False, (
                f"slot {i + 1} requires a vertex from colour {i + 1}, "
                f"but label {label} belongs to colour {owner[label] + 1}"
            )

    placements, why = _expanded_assignment(inst, answer, owner, local, cmap)
    if placements is None:
        return False, why
    return _check_expanded(inst, placements)


def render(inst):
    k, n = inst["color_count"], inst["n"]
    lines = [
        "Find a bounded-weight incomparable assignment in an Antichain on Trees instance.",
        "",
        "Definitions.",
        "A rooted-tree node a is an ancestor of b when a lies on the path from the",
        "root to b; a node is its own ancestor. Two nodes are incomparable when",
        "neither is an ancestor of the other. An MWACT assignment maps every named",
        "element to one finite-cost tree node, all mapped nodes are pairwise",
        "incomparable, and the integer costs sum to at most the stated bound.",
        "",
        "This instance uses exactly the following finite gadget grammar. Every gadget",
        "root and every COUNT_SINGLETON node is a child of one global root. Leaves",
        "listed for a gadget are its direct children. Distinct gadgets have no other",
        "ancestor relation.",
        "",
        "  START has root S_IN and leaves CLASS_IN(i).",
        "  CHOOSE(v) has root V_IN(v), leaf CLASS_OUT(i,v) for v in colour i,",
        "    and leaf TO_OUT(u,i,v) whenever u in another colour is compatible with v.",
        "  COVER(v), for v in colour i, has root V_OUT(v), leaf COUNT_IN(v),",
        "    and leaves TO_IN(v,j) for every j different from i.",
        "  COUNT_SINGLETON(i) is a one-node gadget COUNT_OUT(i).",
        "",
        "The elements and all their finite placements are:",
        "  START -> S_IN at cost 0.",
        "  CLASS(i) -> CLASS_IN(i) at cost 0, or CLASS_OUT(i,v) at cost 1.",
        "  VERTEX(v) -> V_IN(v) at cost 0, or V_OUT(v) at cost 1.",
        "  COUNT(v), v in colour i -> COUNT_IN(v) at cost 0, or COUNT_OUT(i) at cost 1.",
        "  TO(v,j) -> TO_IN(v,j) at cost 0, or TO_OUT(v,j,u) at cost 1 for a",
        "    compatible u in colour j. All unlisted placements have infinite cost.",
        "",
        f"There are {k} colours, each with {n} graph-vertex labels. The weight bound",
        f"is K={inst['weight_bound']}. Colour indices below are 1-based.",
        "",
        "A short witness is required. Give one representative v_i from each colour i.",
        "It expands deterministically as follows: START uses S_IN; CLASS(i) uses",
        "CLASS_OUT(i,v_i); VERTEX(v_i) uses V_OUT(v_i), COUNT(v_i) uses COUNT_OUT(i),",
        "and TO(v_i,j) uses TO_OUT(v_i,j,v_j). Every corresponding element for an",
        "unchosen v uses its cost-0 IN node. The checker performs this full expansion",
        "and checks every finite placement, tree incomparability, and the weight bound.",
        "",
        "Compatibility matrices are given for each colour pair i<j. Rows follow the",
        "printed order of colour i and bit positions follow the printed order of",
        "colour j. A 1 means compatible and a 0 means incompatible. Positions are",
        "1-based in this explanation. After each PAIR label, slash-separated bit",
        "strings are consecutive rows; decimal vertex labels themselves are arbitrary.",
        "",
        "Colour classes (in answer-slot order):",
    ]
    for i, block in enumerate(inst["colors"], 1):
        lines.append(f"  C{i}: " + " ".join(map(str, block)))
    lines.extend(["", "Compatibility matrices:"])
    for rec in inst["compatibility"]:
        i, j = rec["left"] + 1, rec["right"] + 1
        lines.append(f"  PAIR C{i} C{j}: " + "/".join(rec["rows"]))

    example = [block[0] for block in inst["colors"]]
    lines.extend([
        "",
        f"Output exactly {k} distinct decimal labels as a JSON list. Entry i must",
        "belong to colour i in the printed order. No repeats are allowed; list order",
        "is significant; all label and index bounds are inclusive.",
        "",
        "Give your final answer inside <answer></answer> tags, as that JSON list.",
        f"Example syntax: <answer>{json.dumps(example, separators=(',', ':'))}</answer>",
        "Output nothing else inside the tags.",
    ])
    mode = os.environ.get("GV_HINT_MODE")
    if mode == "structural":
        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
    elif mode == "placebo":
        lines.extend(["", "Hint: " + PLACEBO_HINT])
    return "\n".join(lines)


def parse_answer(text):
    """Parse a tagged JSON integer list, tolerating prose and Markdown fences."""
    if not isinstance(text, str):
        return None
    matches = _ANSWER_RE.findall(text)
    if not matches:
        return None
    body = matches[-1].strip()
    fenced = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
    if fenced:
        body = fenced.group(1).strip()
    try:
        value = json.loads(body)
    except (TypeError, ValueError):
        return None
    if not isinstance(value, list) or any(not _is_int(x) for x in value):
        return None
    return value


def random_candidate(inst, rng):
    """Sample uniformly after enforcing shape and one-representative-per-colour."""
    return [rng.choice(block) for block in inst["colors"]]


def search_space(inst):
    try:
        return inst["n"] ** inst["color_count"]
    except (KeyError, TypeError, ValueError):
        return None


def enumerate_all(inst):
    space = search_space(inst)
    if space is None or space > 1_000_000:
        return None
    count = 0
    for candidate in itertools.product(*inst["colors"]):
        count += int(verify(inst, list(candidate))[0])
    return count


def _pair_four_cycles(rows):
    masks = [int(row, 2) for row in rows]
    total = 0
    for i in range(len(masks)):
        for j in range(i + 1, len(masks)):
            common = (masks[i] & masks[j]).bit_count()
            total += common * (common - 1) // 2
    return total


def canonical_key(inst):
    """Relabelling invariant based on every colour-pair four-cycle count.

    Exact canonicalisation of the coloured compatibility graph contains graph
    isomorphism.  The sorted vector of exact bipartite four-cycle counts is a
    strong inexpensive invariant for this random-regular distribution; it may
    theoretically over-collapse nonisomorphic adversarial inputs.
    """
    cmap = _compat_map(inst)
    if cmap is None:
        return "mwact-lemma3:malformed"
    cycle_counts = sorted(_pair_four_cycles(rows) for rows in cmap.values())
    payload = [
        inst["color_count"],
        inst["n"],
        inst["cross_degree"],
        cycle_counts,
    ]
    digest = hashlib.sha256(
        json.dumps(payload, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    return "mwact-lemma3-v1:" + digest


def escalate(params):
    """Grow each colour class while keeping the 24-entry witness fixed."""
    if not isinstance(params, dict) or "n" not in params:
        return None
    n = int(params["n"])
    classes = int(params.get("classes", 18))
    new_n = n + 8
    return {
        "n": new_n,
        "classes": classes,
        # Keep n^k (degree/n)^(k choose 2), the expected number of
        # unconditioned multicoloured cliques, close to one.
        "degree": max(
            1,
            min(new_n - 1, round(new_n ** (1.0 - 2.0 / (classes - 1)))),
        ),
    }


# ---------------------------------------------------------------------------
# Construction-aware attacks.  They use only rendered instance data.

def _adjacency_masks(inst):
    cached = inst.get("_mask_cache") if isinstance(inst, dict) else None
    if isinstance(cached, list):
        return cached
    cmap = _compat_map(inst)
    if cmap is None:
        return None
    k, n = inst["color_count"], inst["n"]
    masks = [[[0] * k for _ in range(n)] for _ in range(k)]
    for (i, j), rows in cmap.items():
        row_masks = [int(bits[::-1], 2) for bits in rows]
        # int(bits[::-1],2) makes bit position y correspond to printed position y.
        for x, mask in enumerate(row_masks):
            masks[i][x][j] = mask
        for y in range(n):
            reverse = 0
            for x, bits in enumerate(rows):
                if bits[y] == "1":
                    reverse |= 1 << x
            masks[j][y][i] = reverse
    inst["_mask_cache"] = masks
    return masks


def _local_answer(inst, local_values):
    if local_values is None:
        return None
    return [inst["colors"][i][x] for i, x in enumerate(local_values)]


def _attack_outlier(inst):
    """Triangle-participation outlier: strongest natural per-vertex statistic."""
    masks = _adjacency_masks(inst)
    if masks is None:
        return None
    k, n = inst["color_count"], inst["n"]
    chosen = []
    for i in range(k):
        scores = []
        for x in range(n):
            score = 0
            for j in range(k):
                if j == i:
                    continue
                bits = masks[i][x][j]
                while bits:
                    low = bits & -bits
                    y = low.bit_length() - 1
                    bits -= low
                    for h in range(j + 1, k):
                        if h == i:
                            continue
                        score += (masks[i][x][h] & masks[j][y][h]).bit_count()
            scores.append((score, -inst["colors"][i][x], x))
        chosen.append(max(scores)[2])
    return _local_answer(inst, chosen)


def _greedy_once(inst, masks, rng=None):
    k, n = inst["color_count"], inst["n"]
    domains = [(1 << n) - 1 for _ in range(k)]
    assigned = [-1] * k
    for _ in range(k):
        colour = min(
            (i for i in range(k) if assigned[i] < 0),
            key=lambda i: (domains[i].bit_count(), i),
        )
        bits = domains[colour]
        if not bits:
            return None
        candidates = []
        while bits:
            low = bits & -bits
            value = low.bit_length() - 1
            bits -= low
            score = sum(
                (domains[j] & masks[colour][value][j]).bit_count()
                for j in range(k) if assigned[j] < 0 and j != colour
            )
            candidates.append((score, value))
        best_score = max(score for score, _ in candidates)
        best = [value for score, value in candidates if score == best_score]
        value = (rng.choice(best) if rng is not None else min(best))
        assigned[colour] = value
        for j in range(k):
            if assigned[j] < 0:
                domains[j] &= masks[colour][value][j]
    return _local_answer(inst, assigned)


def _attack_greedy(inst):
    masks = _adjacency_masks(inst)
    return None if masks is None else _greedy_once(inst, masks)


def _attack_random_restart(inst, rng, restarts=64):
    masks = _adjacency_masks(inst)
    if masks is None:
        return None
    for _ in range(restarts):
        candidate = _greedy_once(inst, masks, rng)
        if candidate is not None and verify(inst, candidate)[0]:
            return candidate
    return None


def _attack_spectral(inst, iterations=14):
    """Centred power iteration followed by one maximum-score vertex per colour."""
    masks = _adjacency_masks(inst)
    if masks is None:
        return None
    k, n, degree = inst["color_count"], inst["n"], inst["cross_degree"]
    rng = random.Random(0x170501240)
    vector = [[rng.randrange(-1000, 1001) / 1000.0 for _ in range(n)] for _ in range(k)]
    for _ in range(iterations):
        sums = [sum(block) for block in vector]
        nxt = [[0.0] * n for _ in range(k)]
        for i in range(k):
            for x in range(n):
                value = 0.0
                for j in range(k):
                    if i == j:
                        continue
                    bits = masks[i][x][j]
                    neighbour_sum = 0.0
                    while bits:
                        low = bits & -bits
                        y = low.bit_length() - 1
                        bits -= low
                        neighbour_sum += vector[j][y]
                    value += neighbour_sum - (degree / n) * sums[j]
                nxt[i][x] = value
        norm = math.sqrt(sum(value * value for block in nxt for value in block)) or 1.0
        vector = [[value / norm for value in block] for block in nxt]
    for sign in (1.0, -1.0):
        local_values = [
            max(range(n), key=lambda x: (sign * vector[i][x], -x))
            for i in range(k)
        ]
        candidate = _local_answer(inst, local_values)
        if verify(inst, candidate)[0]:
            return candidate
    return None


def _attack_exact(inst, node_budget=_EXACT_NODE_BUDGET):
    """MRV backtracking with forward checking; return candidate and counters."""
    masks = _adjacency_masks(inst)
    if masks is None:
        return None, {"nodes": 0, "updates": 0, "exhausted": False}
    k, n = inst["color_count"], inst["n"]
    domains = [(1 << n) - 1 for _ in range(k)]
    assigned = [-1] * k
    nodes = 0
    updates = 0
    exhausted = False

    def dfs(depth):
        nonlocal nodes, updates, exhausted
        nodes += 1
        if nodes > node_budget:
            exhausted = True
            return None
        if depth == k:
            return assigned[:]
        colour = min(
            (i for i in range(k) if assigned[i] < 0),
            key=lambda i: (domains[i].bit_count(), i),
        )
        bits = domains[colour]
        while bits and not exhausted:
            low = bits & -bits
            value = low.bit_length() - 1
            bits -= low
            assigned[colour] = value
            changes = []
            feasible = True
            for j in range(k):
                if assigned[j] >= 0:
                    continue
                new_domain = domains[j] & masks[colour][value][j]
                updates += 1
                if new_domain != domains[j]:
                    changes.append((j, domains[j]))
                    domains[j] = new_domain
                if not new_domain:
                    feasible = False
                    break
            if feasible:
                found = dfs(depth + 1)
                if found is not None:
                    return found
            for j, old_domain in reversed(changes):
                domains[j] = old_domain
            assigned[colour] = -1
        return None

    found = dfs(0)
    return _local_answer(inst, found), {
        "nodes": nodes,
        "updates": updates,
        "exhausted": exhausted,
    }


def _relabel_instance(inst, rng):
    """Permute colours, labels, row orders, and column orders; carry the answer."""
    k, n = inst["color_count"], inst["n"]
    old_cmap = _compat_map(inst)
    old_owner, old_local = _local_maps(inst)

    colour_order = list(range(k))
    rng.shuffle(colour_order)
    position_maps = []
    label_map = {}
    all_new_labels = list(range(10_000_001, 10_000_001 + k * n))
    rng.shuffle(all_new_labels)
    cursor = 0
    new_colours = []
    for new_i, old_i in enumerate(colour_order):
        order = list(range(n))
        rng.shuffle(order)
        position_maps.append((old_i, order))
        block = []
        for old_pos in order:
            old_label = inst["colors"][old_i][old_pos]
            new_label = all_new_labels[cursor]
            cursor += 1
            label_map[old_label] = new_label
            block.append(new_label)
        new_colours.append(block)

    old_position_for_new = [order for _, order in position_maps]
    new_compat = []
    for a in range(k):
        old_a = colour_order[a]
        for b in range(a + 1, k):
            old_b = colour_order[b]
            rows = []
            for old_x in old_position_for_new[a]:
                bits = []
                for old_y in old_position_for_new[b]:
                    if old_a < old_b:
                        bit = old_cmap[(old_a, old_b)][old_x][old_y]
                    else:
                        bit = old_cmap[(old_b, old_a)][old_y][old_x]
                    bits.append(bit)
                rows.append("".join(bits))
            new_compat.append({"left": a, "right": b, "rows": rows})

    old_answer_by_colour = {
        old_owner[label]: label for label in inst["answer"]
    }
    new_answer = [label_map[old_answer_by_colour[old_i]] for old_i in colour_order]
    transformed = {
        key: value for key, value in inst.items()
        if key not in {"colors", "compatibility", "answer"} and not key.startswith("_")
    }
    transformed["colors"] = new_colours
    transformed["compatibility"] = new_compat
    transformed["answer"] = new_answer
    return transformed


def _corruptions(inst):
    answer = list(inst["answer"])
    corrupt = {
        "empty": [],
        "drop_one": answer[:-1],
        "duplicate": [answer[1]] + answer[1:],
        "out_of_range": [max(max(block) for block in inst["colors"]) + 1] + answer[1:],
        "swap_slots": answer[1:2] + answer[0:1] + answer[2:],
    }
    # Same-colour replacement that breaks at least one compatibility edge.
    replacement = None
    for slot, block in enumerate(inst["colors"]):
        for label in block:
            if label == answer[slot]:
                continue
            candidate = answer[:]
            candidate[slot] = label
            if not verify(inst, candidate)[0]:
                replacement = candidate
                break
        if replacement is not None:
            break
    corrupt["incompatible_replacement"] = replacement
    return corrupt


def selftest():
    report = {}

    # G1: every named preset, several independent seeds.
    failures = []
    checks = 0
    for preset, params in DIFFICULTY.items():
        for seed in (0, 1, 2):
            inst = make_instance(seed=seed, **params)
            ok, why = verify(inst, inst["answer"])
            checks += 1
            if not ok:
                failures.append({"preset": preset, "seed": seed, "reason": why})
            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
                failures.append({"preset": preset, "seed": seed, "reason": "answer not JSON-native"})
    report["G1_planted_verifies"] = {
        "pass": not failures,
        "checked": checks,
        "failures": failures,
    }

    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
    shipping = make_instance(seed=314159, **shipping_params)

    # G2: deliberately arrange validation order so every corruption has a distinct reason.
    corruption_results = {}
    reasons = []
    for name, candidate in _corruptions(shipping).items():
        if candidate is None:
            corruption_results[name] = {"rejected": False, "reason": "not constructed"}
            continue
        ok, why = verify(shipping, candidate)
        corruption_results[name] = {"rejected": not ok, "reason": why}
        if not ok:
            reasons.append(why)
    report["G2_rejects_corruption"] = {
        "pass": (
            all(item["rejected"] for item in corruption_results.values())
            and len(set(reasons)) == len(reasons)
        ),
        "distinct_reasons": len(set(reasons)),
        "cases": corruption_results,
    }

    # G3: realistic prose and a fenced tagged JSON answer.
    response = (

exec
/bin/bash -lc "sed -n '1000,1500p' ../1705.01240/gen_1705_01240.py" in /home/gson/gvrepo/results/2005.08095
 succeeded in 0ms:
    response = (
        "I used the incompatibility gadgets.\n\n<answer>```json\n"
        + json.dumps(shipping["answer"])
        + "\n```</answer>\n"
    )
    parsed = parse_answer(response)
    parsed_ok, parsed_why = verify(shipping, parsed)
    report["G3_round_trip"] = {
        "pass": parsed == shipping["answer"] and parsed_ok,
        "verify_reason": parsed_why,
    }

    # G4: the sampler already enforces arity, range, and one representative per colour.
    guess_rng = random.Random(271828)
    guess_hits = 0
    for _ in range(_GUESS_SAMPLES):
        guess_hits += int(verify(shipping, random_candidate(shipping, guess_rng))[0])
    report["G4_guess_resistance"] = {
        "pass": guess_hits / _GUESS_SAMPLES < 1e-6,
        "hits": guess_hits,
        "total": _GUESS_SAMPLES,
        "measured_probability": guess_hits / _GUESS_SAMPLES,
        "candidate_space": search_space(shipping),
        "sampler": "uniform one-listed-vertex-per-colour assignments",
    }

    # G5 and G6 share the measured shipping attack runs.
    attack_seeds = list(range(800, 808))
    attack_results = {
        "outlier_triangle_participation": {"successes": 0, "attempts": len(attack_seeds)},
        "greedy_max_future_compatibility": {"successes": 0, "attempts": len(attack_seeds)},
        "random_restart_64": {"successes": 0, "attempts": len(attack_seeds)},
        "spectral_centered_power_iteration": {"successes": 0, "attempts": len(attack_seeds)},
        "exact_mrv_forward_check_2m": {"successes": 0, "attempts": len(attack_seeds)},
    }
    exact_nodes = []
    exact_updates = []
    exact_walls = []
    exact_exhaustions = 0
    for seed in attack_seeds:
        inst = make_instance(seed=seed, **shipping_params)
        candidates = {
            "outlier_triangle_participation": _attack_outlier(inst),
            "greedy_max_future_compatibility": _attack_greedy(inst),
            "random_restart_64": _attack_random_restart(
                inst, random.Random(seed ^ 0xA17C), 64
            ),
            "spectral_centered_power_iteration": _attack_spectral(inst),
        }
        start = time.perf_counter()
        exact_candidate, counters = _attack_exact(inst)
        exact_walls.append(time.perf_counter() - start)
        exact_nodes.append(counters["nodes"])
        exact_updates.append(counters["updates"])
        exact_exhaustions += int(counters["exhausted"])
        candidates["exact_mrv_forward_check_2m"] = exact_candidate
        for name, candidate in candidates.items():
            if candidate is not None and verify(inst, candidate)[0]:
                attack_results[name]["successes"] += 1

    all_attacks_failed = all(item["successes"] == 0 for item in attack_results.values())
    report["G5_density_and_baseline"] = {
        "pass": guess_hits / _GUESS_SAMPLES < 1e-6 and exact_exhaustions == len(attack_seeds),
        "shipping_density_hits": guess_hits,
        "shipping_density_samples": _GUESS_SAMPLES,
        "shipping_solution_fraction_estimate": guess_hits / _GUESS_SAMPLES,
        "baseline_wall_clock_sec_mean": sum(exact_walls) / len(exact_walls),
        "baseline_wall_clock_sec_max": max(exact_walls),
        "baseline_nodes_mean": sum(exact_nodes) / len(exact_nodes),
        "baseline_nodes_max": max(exact_nodes),
        "baseline_compatibility_updates_mean": sum(exact_updates) / len(exact_updates),
        "baseline_budget_exhaustions": exact_exhaustions,
        "demo_exact_valid_answers": enumerate_all(make_instance(seed=5, **DIFFICULTY["demo"])),
        "demo_candidate_space": search_space(make_instance(seed=5, **DIFFICULTY["demo"])),
    }
    report["G6_adversary_panel"] = {
        "pass": all_attacks_failed,
        "attacks": attack_results,
        "seeds": attack_seeds,
        "standard_algorithm": (
            "exact multicoloured-CSP backtracking with MRV and forward checking; "
            "the paper's Algorithm 1 is still larger on the corresponding high-degree DS-tree"
        ),
    }

    # G7: double the ambient colour-class size without lengthening the witness.
    doubled_params = dict(shipping_params)
    doubled_params["n"] *= 2
    doubled_params["degree"] = round(
        doubled_params["n"]
        ** (1.0 - 2.0 / (doubled_params["classes"] - 1))
    )
    start = time.perf_counter()
    doubled = make_instance(seed=1234, **doubled_params)
    doubled_build = time.perf_counter() - start
    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
    report["G7_scales"] = {
        "pass": doubled_ok and search_space(doubled) > search_space(shipping),
        "base_n": shipping["n"],
        "doubled_n": doubled["n"],
        "answer_length_base": len(shipping["answer"]),
        "answer_length_doubled": len(doubled["answer"]),
        "base_candidate_space": search_space(shipping),
        "doubled_candidate_space": search_space(doubled),
        "doubled_build_sec": doubled_build,
        "verify_reason": doubled_why,
    }

    # G8: real relabellings and unrelated-instance separation.
    invariant_checks = 0
    witness_checks = 0
    key_failures = []
    unrelated_keys = []
    for seed in range(20):
        inst = make_instance(seed=20_000 + seed, **shipping_params)
        key = canonical_key(inst)
        unrelated_keys.append(key)
        for turn in range(2):
            transformed = _relabel_instance(
                inst, random.Random(30_000 + 17 * seed + turn)
            )
            invariant_checks += 1
            if canonical_key(transformed) != key:
                key_failures.append({"seed": seed, "turn": turn, "kind": "key"})
            ok, why = verify(transformed, transformed["answer"])
            witness_checks += 1
            if not ok:
                key_failures.append({
                    "seed": seed, "turn": turn, "kind": "witness", "reason": why
                })
    distinct = len(set(unrelated_keys))
    report["G8_canonical_key"] = {
        "pass": not key_failures and distinct == 20,
        "invariance_checks": invariant_checks,
        "real_transformation_witness_checks": witness_checks,
        "unrelated_instances": 20,
        "unrelated_distinct_keys": distinct,
        "failures": key_failures,
        "invariant": "sorted exact four-cycle counts of every colour-pair graph",
    }

    answer_blob = json.dumps(shipping["answer"], separators=(",", ":"))
    answer_chars = len(answer_blob)
    answer_tokens = math.ceil(answer_chars / 4)
    answer_elements = len(shipping["answer"])
    intended_ops = shipping["color_count"] * (shipping["color_count"] - 1) // 2
    arms = {
        name: dict(G9_ORACLE_RESULTS[name])
        for name in ("bare", "hinted", "placebo")
    }
    placebo_rate = (
        arms["placebo"]["solved"] / arms["placebo"]["attempts"]
        if arms["placebo"]["attempts"] else None
    )
    hinted_rate = (
        arms["hinted"]["solved"] / arms["hinted"]["attempts"]
        if arms["hinted"]["attempts"] else None
    )
    hinted_minus_placebo = (
        hinted_rate - placebo_rate
        if hinted_rate is not None and placebo_rate is not None
        else None
    )
    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_ops <= 300
    report["G9_no_tool_suitability"] = {
        # All three arms are diagnostics.  Since 2026-09-05, only these caps
        # gate G9.
        "pass": within_caps,
        "arms": arms,
        "hinted_minus_placebo": hinted_minus_placebo,
        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
        "answer_chars": answer_chars,
        "answer_tokens": answer_tokens,
        "answer_elements": answer_elements,
        "intended_route_operations": intended_ops,
        "caps_pass": within_caps,
    }

    report["track"] = TRACK
    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
    report["shipping_params"] = shipping_params
    report["all_passed"] = all(
        value.get("pass", False)
        for key, value in report.items()
        if key.startswith("G") and isinstance(value, dict)
    )
    return report


if __name__ == "__main__":
    print(json.dumps(selftest(), indent=2, sort_keys=True))

