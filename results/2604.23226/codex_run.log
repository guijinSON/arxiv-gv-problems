+    distinct = {value["reason"] for value in cases.values()}
+    report["G2_rejects_corruption"] = {
+        "pass": all(v["rejected"] for v in cases.values()) and len(distinct) == 5,
+        "cases": cases,
+        "distinct_reasons": len(distinct),
+    }
+
+    wire = json.dumps(base, separators=(",", ":"))
