+        "hinted": {"solved": 0, "attempts": 0},
+        "placebo": {"solved": 0, "attempts": 0},
+    },
+    "error_calls": {"bare": 4, "hinted": 4, "placebo": 4},
+    "hinted_verdict": "unavailable: OpenRouter key total limit exceeded",
