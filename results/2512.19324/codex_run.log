+    "medium": {"n": 19},
+    "hard": {"n": 29},
+}
+SHIPPING_DIFFICULTY = "easy"
+
+STRUCTURAL_HINT = (
+    "Hint: Inspect the minus-one and fixed eigenspaces of the displayed "
