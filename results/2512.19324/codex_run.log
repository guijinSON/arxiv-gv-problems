+def _best_unit_attack(inst):
+    p = inst["p"]
+    best = None
+    best_score = None
+    for i in range(16):
+        candidate = [0] * 16
+        candidate[i] = 1
+        score = sum(bool(sum(x * y for x, y in zip(row, candidate)) % p)
+                    for row in inst["kernel_constraints"])
+        if best_score is None or score < best_score:
+            best, best_score = candidate, score
