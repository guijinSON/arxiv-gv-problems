+def _gaussian_nullspace(inst: dict):
+    """Exact RREF nullspace and a transparent modular-operation count."""
+    p = inst["field_prime"]
+    matrix = [row[:] for row in inst["matrix"]]
+    rows = len(matrix)
+    columns = len(matrix[0])
+    pivot_columns = []
+    pivot_row = 0
+    operations = 0
+    for column in range(columns):
+        selected = next((r for r in range(pivot_row, rows)
+                         if matrix[r][column] % p), None)
+        if selected is None:
+            continue
+        if selected != pivot_row:
+            matrix[pivot_row], matrix[selected] = (
+                matrix[selected], matrix[pivot_row]
+            )
+        inverse = pow(matrix[pivot_row][column], -1, p)
+        operations += 1
+        for j in range(column, columns):
+            matrix[pivot_row][j] = matrix[pivot_row][j] * inverse % p
+            operations += 1
+        for i in range(rows):
+            if i == pivot_row:
+                continue
+            factor = matrix[i][column]
+            if factor:
+                for j in range(column, columns):
+                    matrix[i][j] = (
+                        matrix[i][j] - factor * matrix[pivot_row][j]
+                    ) % p
+                    operations += 2
+        pivot_columns.append(column)
+        pivot_row += 1
+        if pivot_row == rows:
+            break
+    free = [j for j in range(columns) if j not in set(pivot_columns)]
+    vectors = []
+    for free_column in free:
+        vector = [0] * columns
+        vector[free_column] = 1
+        for row, column in enumerate(pivot_columns):
+            vector[column] = (-matrix[row][free_column]) % p
+        vectors.append(vector)
+    basis = None
+    if len(vectors) == 2:
+        basis = {"kernel_basis": [
+            [vectors[0][i], vectors[1][i]] for i in range(columns)
+        ]}
+    return basis, operations, len(vectors)
 
 
