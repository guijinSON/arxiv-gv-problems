+# ---------------------------------------------------------------------------
+# Prime-field polynomial and extension-field arithmetic
+
+def _trim(poly):
+    poly = [int(x) for x in poly]
+    while len(poly) > 1 and poly[-1] == 0:
+        poly.pop()
+    return poly
+
+
+def _poly_sub(a, b, p):
+    out = [0] * max(len(a), len(b))
+    for i in range(len(out)):
+        out[i] = ((a[i] if i < len(a) else 0)
+                  - (b[i] if i < len(b) else 0)) % p
+    return _trim(out)
