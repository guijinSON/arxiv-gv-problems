		\[\tilde{g}_1=b_0X^{q^{s_1k}}+b_1X^{q^{s_1(k-1)}}+(b_1X)^{q^{s_1(k+1)}}+\eta_1^\sigma b_2X^{q^{s_1(k-2)}}+(\eta_1^\sigma b_2X)^{q^{s_1(k+2)}}.\]
		
