+def _poly_divmod(a, b, p):
+    a = _trim([x % p for x in a])
+    b = _trim([x % p for x in b])
+    if b == [0]:
+        raise ZeroDivisionError
+    if len(a) < len(b):
+        return [0], a
+    q = [0] * (len(a) - len(b) + 1)
+    inv = pow(b[-1], -1, p)
+    while a != [0] and len(a) >= len(b):
+        d = len(a) - len(b)
+        c = a[-1] * inv % p
+        q[d] = c
+        for j, value in enumerate(b):
+            a[d + j] = (a[d + j] - c * value) % p
+        a = _trim(a)
+    return _trim(q), a
