+def _poly_divmod(a, b, p):
+    a = _trim([x % p for x in a])
+    b = _trim([x % p for x in b])
+    if b == [0]:
+        raise ZeroDivisionError
+    if len(a) < len(b):
+        return [0], a
+    q = [0] * (len(a) - len(b) + 1)
