+
+def _ff_zero():
+    return [0] * 8
+
+
+def _ff_one():
+    return [1] + [0] * 7
+
+
+def _ff_add(a, b, p):
+    return [(x + y) % p for x, y in zip(a, b)]
+
+
+def _ff_scale(a, c, p):
+    return [(c * x) % p for x in a]
