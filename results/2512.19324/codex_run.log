+            if not ok:
+                failures.append(f"{preset}/seed={seed}: {reason}")
+            # Independently execute the compact invariant relation.
+            f2 = _mat_mul(inst["frobenius"], inst["frobenius"], inst["p"])
+            f3 = _mat_mul(f2, inst["frobenius"], inst["p"])
