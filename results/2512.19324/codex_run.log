+        ):
+            changed, carried = _transform_instance(trial, **kwargs)
+            invariance_checks += 1
+            if canonical_key(changed) != original_key:
+                key_failures.append(f"seed {seed}/{label}: key changed")
+            carried_checks += 1
+            ok, reason = verify(changed, carried)
+            if not ok:
