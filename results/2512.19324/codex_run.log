+            carried_checks += 1
+            ok, reason = verify(changed, carried)
+            if not ok:
+                key_failures.append(
+                    f"seed {seed}/{label}: carried witness failed: {reason}")
+    distinct_keys = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
