+def _transform_for_g8(inst: dict, seed: int):
+    """Compose coordinate relabeling, ledger reorder, and orbit rotations."""
+    rng = random.Random(seed)
+    n = inst["dimension"]
+    perm = list(range(n))
+    rng.shuffle(perm)  # old coordinate -> new coordinate
+    out = copy.deepcopy(inst)
+    new_matrix = [[0] * n for _ in range(n)]
+    for old_i in range(n):
+        for old_j in range(n):
+            new_matrix[perm[old_i]][perm[old_j]] = inst["matrix"][old_i][old_j]
+    out["matrix"] = new_matrix
+    out["auxiliary_u"] = [0] * n
+    out["auxiliary_v"] = [0] * n
+    for old in range(n):
+        out["auxiliary_u"][perm[old]] = inst["auxiliary_u"][old]
+        out["auxiliary_v"][perm[old]] = inst["auxiliary_v"][old]
+    for block in out["block_ledger"]:
+        cycle = [perm[old] for old in block["cycle"]]
+        rotation = rng.randrange(8)
+        cycle = cycle[rotation:] + cycle[:rotation]
+        if rng.randrange(2):
+            cycle = [cycle[0]] + list(reversed(cycle[1:]))
+        block["cycle"] = cycle
+    rng.shuffle(out["block_ledger"])
+    carried = {"kernel_basis": [[0, 0] for _ in range(n)]}
+    for old, row in enumerate(inst["answer"]["kernel_basis"]):
+        carried["kernel_basis"][perm[old]] = row[:]
+    out["answer"] = carried
+    return out, carried
 
 
