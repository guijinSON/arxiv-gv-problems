+
+
+def _ff_add(a, b, p):
+    return [(x + y) % p for x, y in zip(a, b)]
+
+
+def _ff_scale(a, c, p):
+    return [(c * x) % p for x in a]
+
+
+def _ff_mul(a, b, p, modulus):
