def _compact_route_operations(inst: dict) -> int:
    """Count the advertised lexicographic lattice-recovery arithmetic."""
    operations = 0
    for panel in inst["panels"]:
        sites = panel["sites"]
        x0, y0 = sites[0]["X"], sites[0]["Y"]
        d1 = (sites[1]["X"] - x0, sites[1]["Y"] - y0)
        operations += 2
        found = False
