+        "shipping_answer_atoms": _answer_atoms(shipping["answer"]),
+        "doubled_answer_atoms": _answer_atoms(doubled["answer"]),
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    key_failures = []
+    unrelated_keys = []
+    for seed in range(20):
