+def escalate(params):
+    """Grow the field (the haystack) while the 16-entry witness stays fixed."""
+    current = int(params.get("n", 0))
+    if current >= 896:
+        return "cap_bound"
+    harder = {k: v for k, v in params.items() if k != "prime"}
+    harder["n"] = min(896, current + max(8, current // 3))
