+def _sparse_sign_attack(inst):
+    p = inst["p"]
+    constraints = inst["kernel_constraints"]
+    for i in range(16):
+        for j in range(i, 16):
+            for sign in (1, p - 1):
+                candidate = [0] * 16
+                candidate[i] = 1
+                if j != i:
+                    candidate[j] = sign
+                if all(sum(x * y for x, y in zip(row, candidate)) % p == 0
+                       for row in constraints):
+                    return candidate
+    fallback = [0] * 16
+    fallback[4] = 1
+    return fallback
+
+
+def _constant_b1_attack(inst):
+    candidate = [0] * 16
+    candidate[4:12] = [1] * 8
+    return candidate
+
