+        "shipping_dimension": shipping["dimension"],
+        "doubled_dimension": doubled["dimension"],
+        "doubled_planted_verifies": doubled_ok,
+        "fixed_shape_escalation": escalated_params,
+        "escalated_planted_verifies": escalated_ok,
+    }
+
+    invariance = 0
+    carried_valid = 0
+    unrelated_keys = []
+    for offset in range(20):
+        inst = make_instance(seed=12000 + offset, **shipping_params)
+        unrelated_keys.append(canonical_key(inst))
+        transformed, carried = _transform_for_g8(inst, 13000 + offset)
+        invariance += int(canonical_key(inst) == canonical_key(transformed))
+        carried_valid += int(verify(transformed, carried)[0])
+    distinct = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariance == 20 and carried_valid == 20 and distinct == 20,
+        "composed_relabellings_invariant": invariance,
+        "carried_witnesses_valid": carried_valid,
+        "unrelated_distinct_keys": distinct,
+        "attempts_each": 20,
+        "normalized_transformations": [
