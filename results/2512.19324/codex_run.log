+            "greedy_low_residual_unit_columns": _greedy_low_residual_attack(inst),
+            "raw_alternating_frobenius_ansatz": _raw_frobenius_attack(inst),
+            "auxiliary_vectors_as_kernel": _auxiliary_pair_attack(inst),
+        }
+        for name, candidate in candidates.items():
+            attack_results[name]["successes"] += int(verify(inst, candidate)[0])
+        restart_rng = random.Random(9000 + offset)
+        restart_success = False
+        for _ in range(256):
+            if verify(inst, random_candidate(inst, restart_rng))[0]:
+                restart_success = True
+                break
+        attack_results["random_restart_256"]["successes"] += int(
+            restart_success
+        )
+        start = time.perf_counter()
+        candidate, operations, nullity = _gaussian_nullspace(inst)
+        reference_times.append(time.perf_counter() - start)
+        reference_operations.append(operations)
+        reference_successes += int(
+            nullity == 2 and candidate is not None and verify(inst, candidate)[0]
