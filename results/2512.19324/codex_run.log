+    invariance_checks = 0
+    carried_checks = 0
+    key_failures = []
+    unrelated_keys = []
+    for seed in range(20):
+        trial = make_instance(
+            seed=50_000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        original_key = canonical_key(trial)
+        unrelated_keys.append(original_key)
