+            [vector[perm[i]] for i in range(8)]
+            for vector in transformed["target_basis"]
+        ]
+        transformed["frobenius"] = [
+            [transformed["frobenius"][perm[i]][perm[j]] for j in range(8)]
+            for i in range(8)
+        ]
