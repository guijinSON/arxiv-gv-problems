+def random_candidate(inst, rng):
+    """Sample uniformly from normalized nonzero projective coefficient space."""
+    p = inst["p"]
+    while True:
+        vector = [rng.randrange(p) for _ in range(16)]
+        if any(vector):
+            return _normalize_projective(vector, p)
