+            "operations_upper_bound": 40,
+            "invariant_checks": f"{compact_checks}/{checks}",
+        },
+    }
+
+    report["G5_density_and_baseline"] = {
+        "pass": exact_fraction < 1e-6 and reference_successes == 8,
