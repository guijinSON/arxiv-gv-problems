+        "shipping_exact_valid_answer_count_from_nullity": exact_valid,
+        "shipping_exact_solution_fraction": {
+            "numerator": exact_valid, "denominator": exact_space},
+        "shipping_exact_enumeration": enumerate_all(shipping),
+        "demo_exact_enumerated_valid_answers": enumerate_all(
+            make_instance(seed=4, **DIFFICULTY["demo"])
+        ),
+        "baseline_algorithm": "exact modular Gaussian elimination to RREF",
+        "baseline_wall_clock_seconds": round(reference_seconds, 6),
+        "baseline_modular_scalar_operations": reference_ops,
+        "baseline_nullity": reference_nullity,
+        "baseline_verified": reference_ok,
+    }
+
+    attack_results = {
+        "outlier_coordinate_zero_pattern": {"successes": 0, "attempts": 8},
+        "greedy_low_residual_unit_columns": {"successes": 0, "attempts": 8},
+        "random_restart_256": {
+            "successes": 0, "attempts": 8, "candidates": 2048},
+        "raw_alternating_frobenius_ansatz": {"successes": 0, "attempts": 8},
+        "auxiliary_vectors_as_kernel": {"successes": 0, "attempts": 8},
+    }
+    reference_successes = 0
+    reference_times = []
+    reference_operations = []
+    for offset in range(_ATTACK_SEEDS):
+        inst = make_instance(seed=8000 + offset, **shipping_params)
+        candidates = {
