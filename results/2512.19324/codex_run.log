+def _find_bad_swap(inst: dict) -> dict:
+    candidate = copy.deepcopy(inst["answer"])
+    basis = candidate["kernel_basis"]
+    positions = [(i, j) for i in range(len(basis)) for j in range(2)]
+    for left_index, left in enumerate(positions):
+        for right in positions[left_index + 1:]:
+            if basis[left[0]][left[1]] == basis[right[0]][right[1]]:
+                continue
+            basis[left[0]][left[1]], basis[right[0]][right[1]] = (
+                basis[right[0]][right[1]], basis[left[0]][left[1]]
+            )
+            if not verify(inst, candidate)[0]:
+                return candidate
+            basis[left[0]][left[1]], basis[right[0]][right[1]] = (
+                basis[right[0]][right[1]], basis[left[0]][left[1]]
+            )
+    raise AssertionError("could not construct a rejected swap corruption")
