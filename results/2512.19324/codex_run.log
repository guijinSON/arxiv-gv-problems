+        json.dumps(inst["auxiliary_v"], separators=(",", ":")),
+        "",
+        f"Matrix M ({n} rows, each with {n} entries):",
+    ])
+    lines.extend(json.dumps(row, separators=(",", ":"))
+                 for row in inst["matrix"])
+    lines.extend([
+        "",
+        f"Find an {n}-by-2 matrix K over GF({p}) such that M*K is the all-zero",
+        "matrix and K has column rank exactly 2. The two columns are ordered;",
+        "either order is accepted, repetitions are forbidden by the rank condition,",
+        "and any valid kernel basis is accepted.",
+        "",
+        "Give your final answer inside <answer></answer> tags as one JSON object",
+        f"of the exact form {{\"kernel_basis\":[[a0,b0],...,[a{n-1},b{n-1}]]}}",
+        f"with exactly {n} two-entry rows and canonical residues only.",
+        "Example format: <answer>{\"kernel_basis\":[[1,0],[0,1]]}</answer>",
+        "(The example shows syntax only, not the required row count.)",
+        "Output nothing else inside the tags.",
+    ])
+    statement = "\n".join(lines)
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\n" + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\n" + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: object) -> object | None:
+    """Parse the tagged JSON certificate, tolerating prose and fences."""
+    if not isinstance(text, str):
+        return None
+    matches = list(_ANSWER_RE.finditer(text))
+    if not matches:
+        return None
+    payload = matches[-1].group(1).strip()
+    if payload.startswith("```"):
+        payload = re.sub(r"^```(?:json)?\s*", "", payload, flags=re.I)
+        payload = re.sub(r"\s*```$", "", payload)
+    try:
+        value = json.loads(payload)
+    except (json.JSONDecodeError, TypeError, ValueError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _independent_columns(basis: list[list[int]], p: int) -> bool:
+    first = [row[0] for row in basis]
+    second = [row[1] for row in basis]
+    pivot = next((i for i, value in enumerate(first) if value % p), None)
+    if pivot is None:
+        return False
+    ratio = second[pivot] * pow(first[pivot], -1, p) % p
+    return any((b - ratio * a) % p for a, b in zip(first, second))
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any exact ordered two-column kernel basis; never read the plant."""
+    if not isinstance(answer, dict) or set(answer) != {"kernel_basis"}:
+        return False, "answer must be an object with only kernel_basis"
+    basis = answer["kernel_basis"]
+    n = inst["dimension"]
+    p = inst["field_prime"]
+    if not isinstance(basis, list) or len(basis) != n:
+        return False, f"kernel_basis must have exactly {n} rows"
+    for row in basis:
+        if not isinstance(row, list) or len(row) != 2:
+            return False, "every kernel_basis row must contain exactly two entries"
+        for entry in row:
+            if isinstance(entry, bool) or not isinstance(entry, int):
+                return False, "every entry must be an integer"
+            if entry < 0 or entry >= p:
+                return False, f"entry outside canonical GF({p}) range"
+    if not _independent_columns(basis, p):
+        return False, "kernel_basis columns must be linearly independent"
+    matrix = inst["matrix"]
+    for column in range(2):
+        vector = [row[column] for row in basis]
+        for matrix_row in matrix:
+            total = 0
+            for coefficient, value in zip(matrix_row, vector):
+                total += coefficient * value
+            if total % p:
+                return False, "columns do not lie in the kernel of M"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from all ordered independent column pairs."""
+    n = inst["dimension"]
+    p = inst["field_prime"]
+    while True:
+        first = [rng.randrange(p) for _ in range(n)]
+        if any(first):
+            break
+    while True:
+        second = [rng.randrange(p) for _ in range(n)]
+        basis = [[first[i], second[i]] for i in range(n)]
+        if _independent_columns(basis, p):
+            return {"kernel_basis": basis}
+
+
+def search_space(inst: dict) -> int:
+    """Number of ordered independent pairs in GF(p)^N."""
+    p = inst["field_prime"]
+    n = inst["dimension"]
+    return (p ** n - 1) * (p ** n - p)
+
+
+def _gaussian_nullspace(inst: dict):
+    """Exact RREF nullspace and a transparent modular-operation count."""
+    p = inst["field_prime"]
+    matrix = [row[:] for row in inst["matrix"]]
+    rows = len(matrix)
+    columns = len(matrix[0])
+    pivot_columns = []
+    pivot_row = 0
+    operations = 0
+    for column in range(columns):
+        selected = next((r for r in range(pivot_row, rows)
+                         if matrix[r][column] % p), None)
+        if selected is None:
+            continue
+        if selected != pivot_row:
+            matrix[pivot_row], matrix[selected] = (
+                matrix[selected], matrix[pivot_row]
+            )
+        inverse = pow(matrix[pivot_row][column], -1, p)
+        operations += 1
+        for j in range(column, columns):
+            matrix[pivot_row][j] = matrix[pivot_row][j] * inverse % p
+            operations += 1
+        for i in range(rows):
+            if i == pivot_row:
+                continue
+            factor = matrix[i][column]
+            if factor:
+                for j in range(column, columns):
+                    matrix[i][j] = (
+                        matrix[i][j] - factor * matrix[pivot_row][j]
+                    ) % p
+                    operations += 2
+        pivot_columns.append(column)
+        pivot_row += 1
+        if pivot_row == rows:
+            break
+    free = [j for j in range(columns) if j not in set(pivot_columns)]
+    vectors = []
+    for free_column in free:
+        vector = [0] * columns
+        vector[free_column] = 1
+        for row, column in enumerate(pivot_columns):
+            vector[column] = (-matrix[row][free_column]) % p
+        vectors.append(vector)
+    basis = None
+    if len(vectors) == 2:
+        basis = {"kernel_basis": [
+            [vectors[0][i], vectors[1][i]] for i in range(columns)
+        ]}
+    return basis, operations, len(vectors)
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Exactly enumerate demo kernel bases; cap all larger instances."""
+    p = inst["field_prime"]
+    n = inst["dimension"]
+    if p > 3 or n > 8:
+        return None
+    basis, _, nullity = _gaussian_nullspace(inst)
+    if basis is None or nullity != 2:
+        return 0
+    count = 0
+    for a in range(p):
+        for b in range(p):
+            for c in range(p):
+                for d in range(p):
+                    if (a * d - b * c) % p:
+                        count += 1
+    return count
+
+
+def canonical_key(inst: dict) -> str:
+    """Normalize coordinate labels, orbit order, and presentation basis."""
+    blocks = sorted(
+        (block["kind"], block["scalar"] % inst["field_prime"])
+        for block in inst["block_ledger"]
+    )
+    payload = {
+        "p": inst["field_prime"],
+        "extension_degree": inst["extension_degree"],
+        "dimension": inst["dimension"],
+        "blocks": blocks,
+    }
+    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(encoded.encode("ascii")).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Raise field entropy at fixed answer shape until characters bind."""
+    out = {key: value for key, value in params.items() if key != "_preset"}
+    n = int(out.get("n", 88))
+    current = int(out.get("p", 1000003))
+    candidate = _next_prime_3mod4(current * 10 + 3)
+    digits = len(str(candidate - 1))
+    conservative_chars = 2 * n * digits + 4 * n + 64
+    if conservative_chars > 2000:
+        return "cap_bound"
+    out["p"] = candidate
+    return out
+
+
+def _standard_pair(inst: dict, first_index: int, second_index: int) -> dict:
+    n = inst["dimension"]
+    basis = [[0, 0] for _ in range(n)]
+    basis[first_index][0] = 1
+    basis[second_index][1] = 1
+    return {"kernel_basis": basis}
+
+
+def _raw_frobenius_attack(inst: dict) -> dict:
+    p = inst["field_prime"]
+    n = inst["dimension"]
+    block = next(b for b in inst["block_ledger"]
+                 if b["kind"] == "paired_F3_F5")
+    cycle = block["cycle"]
+    basis = [[0, 0] for _ in range(n)]
+    for pos, value in zip((0, 2, 4, 6), (1, p - 1, 1, p - 1)):
+        basis[cycle[pos]][0] = value
+    for pos, value in zip((1, 3, 5, 7), (1, p - 1, 1, p - 1)):
+        basis[cycle[pos]][1] = value
+    return {"kernel_basis": basis}
+
+
+def _outlier_coordinate_attack(inst: dict) -> dict:
+    matrix = inst["matrix"]
+    scores = []
+    for column in range(inst["dimension"]):
+        zero_count = sum(row[column] == 0 for row in matrix)
+        diagonal_zero = int(matrix[column][column] == 0)
+        scores.append((-(zero_count + diagonal_zero), column))
+    chosen = [column for _, column in sorted(scores)[:2]]
+    return _standard_pair(inst, chosen[0], chosen[1])
+
+
+def _greedy_low_residual_attack(inst: dict) -> dict:
+    p = inst["field_prime"]
+    matrix = inst["matrix"]
+    scores = []
+    for column in range(inst["dimension"]):
+        score = sum(min(row[column], p - row[column]) for row in matrix)
+        scores.append((score, column))
+    chosen = [column for _, column in sorted(scores)[:2]]
+    return _standard_pair(inst, chosen[0], chosen[1])
+
+
+def _auxiliary_pair_attack(inst: dict) -> dict:
+    n = inst["dimension"]
+    p = inst["field_prime"]
+    u = inst["auxiliary_u"]
+    v = inst["auxiliary_v"]
+    basis = [[u[i] % p, v[i] % p] for i in range(n)]
+    if not _independent_columns(basis, p):
+        return _standard_pair(inst, 0, 1)
+    return {"kernel_basis": basis}
+
+
+def _transform_for_g8(inst: dict, seed: int):
+    """Compose coordinate relabeling, ledger reorder, and orbit rotations."""
+    rng = random.Random(seed)
+    n = inst["dimension"]
+    perm = list(range(n))
+    rng.shuffle(perm)  # old coordinate -> new coordinate
+    out = copy.deepcopy(inst)
+    new_matrix = [[0] * n for _ in range(n)]
+    for old_i in range(n):
+        for old_j in range(n):
+            new_matrix[perm[old_i]][perm[old_j]] = inst["matrix"][old_i][old_j]
+    out["matrix"] = new_matrix
+    out["auxiliary_u"] = [0] * n
+    out["auxiliary_v"] = [0] * n
+    for old in range(n):
+        out["auxiliary_u"][perm[old]] = inst["auxiliary_u"][old]
+        out["auxiliary_v"][perm[old]] = inst["auxiliary_v"][old]
+    for block in out["block_ledger"]:
+        cycle = [perm[old] for old in block["cycle"]]
+        rotation = rng.randrange(8)
+        cycle = cycle[rotation:] + cycle[:rotation]
+        if rng.randrange(2):
+            cycle = [cycle[0]] + list(reversed(cycle[1:]))
+        block["cycle"] = cycle
+    rng.shuffle(out["block_ledger"])
+    carried = {"kernel_basis": [[0, 0] for _ in range(n)]}
+    for old, row in enumerate(inst["answer"]["kernel_basis"]):
+        carried["kernel_basis"][perm[old]] = row[:]
+    out["answer"] = carried
+    return out, carried
+
+
+def _answer_atoms(value: object) -> int:
+    if isinstance(value, dict):
+        return sum(_answer_atoms(item) for item in value.values())
+    if isinstance(value, list):
+        return sum(_answer_atoms(item) for item in value)
+    return 1
+
+
+def _find_bad_swap(inst: dict) -> dict:
+    candidate = copy.deepcopy(inst["answer"])
+    basis = candidate["kernel_basis"]
+    positions = [(i, j) for i in range(len(basis)) for j in range(2)]
+    for left_index, left in enumerate(positions):
+        for right in positions[left_index + 1:]:
+            if basis[left[0]][left[1]] == basis[right[0]][right[1]]:
+                continue
+            basis[left[0]][left[1]], basis[right[0]][right[1]] = (
+                basis[right[0]][right[1]], basis[left[0]][left[1]]
+            )
+            if not verify(inst, candidate)[0]:
+                return candidate
+            basis[left[0]][left[1]], basis[right[0]][right[1]] = (
+                basis[right[0]][right[1]], basis[left[0]][left[1]]
+            )
+    raise AssertionError("could not construct a rejected swap corruption")
+
+
+def selftest() -> dict:
+    """Run every mandatory correctness, hardness, and diversity gate."""
+    report: dict = {}
+    preset_checks = 0
+    json_checks = 0
+    failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 7, 29):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            preset_checks += int(ok)
+            if not ok:
+                failures.append(f"{preset}/{seed}: {reason}")
+            encoded = json.dumps(inst["answer"])
+            json_checks += int(json.loads(encoded) == inst["answer"])
+    report["G1_planted_verifies"] = {
+        "pass": preset_checks == 16 and json_checks == 16,
+        "verified": preset_checks,
+        "attempts": 16,
+        "json_native_round_trips": json_checks,
+        "failures": failures,
+    }
+
+    shipping_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    shipping = make_instance(seed=424242, **shipping_params)
+    corruptions = {}
+    empty = {}
+    corruptions["empty"] = verify(shipping, empty)
+    dropped = copy.deepcopy(shipping["answer"])
+    dropped["kernel_basis"].pop()
+    corruptions["dropped_row"] = verify(shipping, dropped)
+    swapped = _find_bad_swap(shipping)
+    corruptions["swapped_entries"] = verify(shipping, swapped)
+    duplicate = copy.deepcopy(shipping["answer"])
+    for row in duplicate["kernel_basis"]:
+        row[1] = row[0]
+    corruptions["duplicate_column"] = verify(shipping, duplicate)
+    out_of_range = copy.deepcopy(shipping["answer"])
+    out_of_range["kernel_basis"][0][0] = shipping["field_prime"]
+    corruptions["out_of_range"] = verify(shipping, out_of_range)
+    distinct_reasons = {result[1] for result in corruptions.values()}
+    report["G2_rejects_corruption"] = {
+        "pass": (all(not result[0] for result in corruptions.values())
+                 and len(distinct_reasons) == len(corruptions)),
+        "corruptions": {
+            name: {"accepted": result[0], "reason": result[1]}
+            for name, result in corruptions.items()
+        },
+        "distinct_reasons": len(distinct_reasons),
+    }
+
+    answer_json = json.dumps(shipping["answer"], separators=(",", ":"))
+    replies = [
+        "I used exact elimination.\n<answer>" + answer_json + "</answer>",
+        "Result:\n```json\n<answer>" + answer_json + "</answer>\n```",
+        "Final certificate follows. <answer>\n" + answer_json + "\n</answer>",
+    ]
+    parsed = sum(parse_answer(reply) == shipping["answer"] for reply in replies)
+    malformed = (
+        parse_answer("no tagged answer") is None
+        and parse_answer("<answer>{bad json}</answer>") is None
+    )
+    report["G3_round_trip"] = {
+        "pass": parsed == len(replies) and malformed,
+        "parsed": parsed,
+        "attempts": len(replies),
+        "malformed_rejected": malformed,
+    }
+
+    guess_rng = random.Random(0x251219324)
+    hits = 0
+    guess_start = time.perf_counter()
+    for _ in range(_G4_SAMPLES):
+        if verify(shipping, random_candidate(shipping, guess_rng))[0]:
+            hits += 1
+    guess_seconds = time.perf_counter() - guess_start
+    probability = hits / _G4_SAMPLES
+    report["G4_guess_resistance"] = {
+        "pass": probability < 1e-6 and _G4_SAMPLES >= 200_000,
+        "hits": hits,
+        "total": _G4_SAMPLES,
+        "observed_probability": probability,
+        "search_space": search_space(shipping),
+        "sampling_seconds": round(guess_seconds, 6),
