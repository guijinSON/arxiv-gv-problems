+def _validate_parameters(n: object, p: object, scramble: object) -> tuple[int, int, int]:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 8 or n % 8:
+        raise ValueError("n must be an integer multiple of 8 and at least 8")
+    if isinstance(p, bool) or not isinstance(p, int) or p < 3:
+        raise ValueError("p must be an odd prime congruent to 3 modulo 4")
+    if p % 4 != 3 or not _is_prime(p):
+        raise ValueError("p must be an odd prime congruent to 3 modulo 4")
+    if isinstance(scramble, bool) or scramble not in (0, 1):
+        raise ValueError("scramble must be 0 or 1")
+    return n, p, int(scramble)
 
 
