+def _poly_sub(a, b, p):
+    out = [0] * max(len(a), len(b))
+    for i in range(len(out)):
+        out[i] = ((a[i] if i < len(a) else 0)
+                  - (b[i] if i < len(b) else 0)) % p
+    return _trim(out)
+
+
+def _poly_mul(a, b, p):
+    out = [0] * (len(a) + len(b) - 1)
+    for i, x in enumerate(a):
+        if x:
+            for j, y in enumerate(b):
+                out[i + j] = (out[i + j] + x * y) % p
+    return _trim(out)
