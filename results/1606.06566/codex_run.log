+            # diagonal is retained so the advertised width is not vacuous.
+            keep = (
+                distance in (1, width)
+                or rng.randrange(density_den) < density_num
+            )
+            if keep:
+                u = hidden_labels[left_position]
+                v = hidden_labels[left_position + distance]
+                edges.add((min(u, v), max(u, v)))
