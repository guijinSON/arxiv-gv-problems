+    mask = full
+    while mask:
+        vertex = parent[mask]
+        if vertex == 255:
+            return None, {
+                "transitions": transitions,
+                "reachable_states": valid_states,
+                "boundary_checks": boundary_checks,
+            }
+        reverse_order.append(vertex)
+        mask ^= 1 << vertex
+    order = list(reversed(reverse_order))
+    answer = _decomposition_from_order(inst, order)
+    return answer, {
+        "transitions": transitions,
+        "reachable_states": valid_states,
+        "boundary_checks": boundary_checks,
+    }
