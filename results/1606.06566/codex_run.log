+        remaining = outside
+        while remaining:
+            bit = remaining & -remaining
+            new_mask = mask | bit
+            transitions += 1
+            if not reachable[new_mask]:
+                reachable[new_mask] = 1
+                parent[new_mask] = bit.bit_length() - 1
+            remaining ^= bit
