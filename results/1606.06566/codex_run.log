+    answer = _fifo_endpoints(hidden_order, width, n)
+    return {
+        "family": "affinely relabelled band graph path decomposition",
+        "n": n,
+        "width": width,
+        "density_num": density_num,
+        "density_den": density_den,
+        "modulus": modulus,
+        "vertices": vertices,
+        "edges": [list(edge) for edge in sorted(edges)],
+        "answer": answer,
+    }
