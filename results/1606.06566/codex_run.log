+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = _atomic_elements(answer)
+    digits = len(str(2 * inst["n"] - 1))
+    worst_chars = inst["n"] * (2 * digits + 4) + 1
+    worst_tokens = math.ceil(worst_chars / 4)
+    max_edges = sum(
