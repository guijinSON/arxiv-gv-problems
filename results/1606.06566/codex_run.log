+    active = []
+    rank = 0
+    for i, vertex in enumerate(order):
+        endpoints[vertex][0] = rank
+        rank += 1
+        active.append(vertex)
+        keep = []
+        for old in active:
+            if last_neighbor[old] <= i:
+                endpoints[old][1] = rank
+                rank += 1
+            else:
