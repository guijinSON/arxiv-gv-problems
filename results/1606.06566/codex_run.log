+        "density_num": 3,
+        "density_den": 4,
+        "modulus": 1009,
+    },
+    "medium": {
+        "n": 20,
+        "width": 6,
+        "density_num": 4,
+        "density_den": 5,
+        "modulus": 1009,
+    },
+    "hard": {
