    answer_elements = len(inst["answer"])
    worst_case_answer_chars = inst["n"] * len(str(inst["q"] - 1)) + inst["n"] + 1
    worst_case_answer_tokens = math.ceil(worst_case_answer_chars / 4)
    intended_operations = 7 * inst["n"] + 2
