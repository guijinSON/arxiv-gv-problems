+def _sign_for_box(sides: list[int]) -> int:
+    """Theorem 2: (-1)^(product_i ceil(sides[i]/2))."""
+    # ceil(s/2) is odd exactly when s is 1 or 2 modulo 4.
+    return -1 if all(s % 4 in (1, 2) for s in sides) else 1
