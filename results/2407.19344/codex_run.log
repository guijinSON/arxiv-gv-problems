    echo "ERROR: $WANT was claimed by someone else while we were pushing."; exit 4
  fi
  CONTESTED="${CONTESTED:+$CONTESTED,}$pick"
  git reset --hard -q origin/main
  sleep "0.$(( (RANDOM % 7) + 2 ))"
  echo "  (race lost on $pick, redrawing...)"
