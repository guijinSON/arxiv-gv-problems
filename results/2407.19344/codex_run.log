diff --git a/g9_hinted/gen_2407_19344.py b/g9_hinted/gen_2407_19344.py
index f0a25bdb261eeb2dcd5ca866d33305f7fa204cef..ba44487d458b6bde0fbae46a6b053421e33023f4
--- a/g9_hinted/gen_2407_19344.py
+++ b/g9_hinted/gen_2407_19344.py
@@ -83,9 +83,6 @@
 }
 
 DIFFICULTY = {
