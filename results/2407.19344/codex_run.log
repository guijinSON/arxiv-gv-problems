import contextlib, importlib, io, json, os, random
buf = io.StringIO()
with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
    g = importlib.import_module('gen_2407_19344')
assert buf.getvalue() == ''
assert g.TRACK in {'A', 'B'}
assert list(g.DIFFICULTY) == ['demo', 'easy', 'medium', 'hard']
assert g.SHIPPING_DIFFICULTY "'!= '"'demo'
for name, params in g.DIFFICULTY.items():
    a = g.make_instance(seed=12345, **params)
    b = g.make_instance(seed=12345, **params)
    assert a == b, name
    assert json.loads(json.dumps(a['answer'])) == a['answer']
    assert g.verify(a, a['answer']) == (True, 'ok')
    wire = '<answer>' + json.dumps(a['answer'], separators=(',', ':')) + '</answer>'
    assert g.parse_answer('prose\\n"'```text'"\\nwork\\n"'```'"\\n' + wire + '\\nmore prose') == a['answer']
    assert g.canonical_key(a) == g.canonical_key(b)
demo = g.make_instance(seed=7, **g.DIFFICULTY['demo'])
assert g.enumerate_all(demo) == 1
ship = g.make_instance(seed=20260905, **g.DIFFICY[g.SHIPPING_DIFFICULTY]) if False else g.make_instance(seed=20260905, **g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
assert g.search_space(ship) == 32247603683100
base = g.render(ship)
os.environ['GV_HINT_MODE'] = 'structural'
struct = g.render(ship)
os.environ['GV_HINT_MODE'] = 'placebo'
placebo = g.render(ship)
os.environ.pop('GV_HINT_MODE', None)
assert g.STRUCTURAL_HINT not in base and g.PLACEBO_HINT not in base
assert g.STRUCTURAL_HINT in struct and g.PLACEBO_HINT in placebo
report = g.selftest()
assert report['all_passed'] is True
assert report['G1_planted_verifies']['theorem_cross_checks'] == 13
assert report['G4_guess_resistance']['total'] >= 200000
assert all(v['successes'] == 0 and v['attempts'] >= 8 for v in report['G6_adversary_panel']['attacks'].values())
assert report['G9_no_tool_suitability']['answer_chars'] <= 2000
assert report['G9_no_tool_suitability']['answer_elements'] <= 256
assert report['G9_no_tool_suitability']['intended_route_operations'] <= 300
json.load(open('selftest_report.json'))
for path in ('llm_loop_transcript.jsonl', 'g9_hinted_transcript.jsonl', 'g9_placebo_transcript.jsonl'):
    rows=[json.loads(line) for line in open(path) if line.strip()]
    assert rows and all(r['solved'] == 'error' and r['http_status'] == 403 for r in rows)
print('module contract and local gates passed')
