+        rr_rng = random.Random(seed ^ 0x5A17)
+        rr_t0 = time.perf_counter()
+        solved = False
+        for _restart in range(1024):
+            ok, _ = verify(inst, random_candidate(inst, rr_rng))
+            if ok:
