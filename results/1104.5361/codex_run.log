+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An unordered set of exactly k distinct allowed nonterminal integer labels, "
+        "necessarily containing the marked label; labels are below q*C and every "
+        "supported preset has k <= 64 and q*C < 2^31."
