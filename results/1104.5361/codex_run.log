+
+def _coprime_multiplier(rng: random.Random, modulus: int) -> int:
+    """Choose a nontrivial unit modulo modulus without global randomness."""
+    while True:
+        value = rng.randrange(2, modulus - 1)
+        if math.gcd(value, modulus) == 1:
+            return value
+
+
+def _edge_length(j: int, ell_a: int, ell_b: int, ell_mod: int, q: int) -> int:
+    return 1 + ((ell_a * j + ell_b) % ell_mod) % q
+
+
+def make_instance(n: int, seed: int = 0, **params) -> dict:
+    """Construct a promised X--Y separator instance and its frontier witness.
+
+    ``n`` is the height of every complete binary tree.  Randomness changes the
+    affine vertex relabelling, the marked root-to-leaf branch, and every edge's
+    subdivision length.  The separator is composed directly from the marked
+    branch's off-path siblings and the roots of the other trees.
+    """
+    height = int(n)
+    r = int(params.get("r", 4))
+    depth = int(params.get("depth", min(6, height)))
+    q = int(params.get("q", 5))
+    if height < 1 or r < 2 or q < 1 or not (1 <= depth <= height):
+        raise ValueError("require n>=1, r>=2, q>=1, and 1<=depth<=n")
+
+    rng = random.Random(seed)
+    tree_size = (1 << (height + 1)) - 1
+    base_count = r * tree_size
+    a = _coprime_multiplier(rng, base_count)
+    b = rng.randrange(base_count)
+    a_inv = pow(a, -1, base_count)
+    ell_mod = 2 * base_count + 1
+    ell_a = rng.randrange(1, ell_mod)
+    ell_b = rng.randrange(ell_mod)
+
+    def enc(j: int) -> int:
+        return (a * j + b) % base_count
+
+    def branch(j: int) -> int:
+        return q * enc(j)
+
+    source, sink = -1, -2
+    nonterminals = []
+    edges = []
+
+    for tree in range(r):
+        offset = tree * tree_size
+        root = offset
+        nonterminals.append(branch(root))
+        edges.append([source, branch(root)])
+        for local in range(1, tree_size):
+            j = offset + local
+            parent = offset + (local - 1) // 2
+            length = _edge_length(j, ell_a, ell_b, ell_mod, q)
+            chain = [branch(parent)]
+            for pos in range(length - 1, 0, -1):
+                label = q * enc(j) + pos
+                nonterminals.append(label)
+                chain.append(label)
+            nonterminals.append(branch(j))
+            chain.append(branch(j))
+            edges.extend([[chain[i], chain[i + 1]] for i in range(len(chain) - 1)])
+        first_leaf = (1 << height) - 1
+        for local in range(first_leaf, tree_size):
+            edges.append([branch(offset + local), sink])
+
+    marked_tree = rng.randrange(r)
+    marked_local = (1 << depth) - 1 + rng.randrange(1 << depth)
+    marked_j = marked_tree * tree_size + marked_local
+    marked = branch(marked_j)
+
+    # X protects the strict marked-path ancestors.  Consequently every off-path
+    # sibling branch needs its own separator vertex, and the marked vertex itself
+    # is needed for the remaining branch.
+    ancestors_local = []
+    cursor = marked_local
+    while cursor:
+        cursor = (cursor - 1) // 2
+        ancestors_local.append(cursor)
+    ancestors_local.reverse()
+    x_vertices = [source] + [branch(marked_tree * tree_size + u)
+                             for u in ancestors_local]
+
+    answer = [marked]
+    for tree in range(r):
+        if tree != marked_tree:
+            answer.append(branch(tree * tree_size))
+    cursor = marked_local
+    for _ in range(depth):
+        sibling = cursor + 1 if cursor % 2 == 1 else cursor - 1
+        answer.append(branch(marked_tree * tree_size + sibling))
+        cursor = (cursor - 1) // 2
+    answer.sort()
+
+    # All lists are deterministic; sorting vertices also makes attack tie-breaking
+    # independent of construction order.
+    nonterminals = sorted(set(nonterminals))
+    allowed_vertices = [v for v in nonterminals if v not in set(x_vertices)]
+    inst = {
+        "n": height,
+        "r": r,
+        "depth": depth,
+        "q": q,
+        "tree_size": tree_size,
+        "base_count": base_count,
+        "a": a,
+        "b": b,
+        "a_inv": a_inv,
+        "ell_a": ell_a,
+        "ell_b": ell_b,
+        "ell_mod": ell_mod,
+        "source": source,
+        "sink": sink,
+        "X": sorted(x_vertices),
+        "Y": [sink],
+        "marked": marked,
+        "required_size": r + depth,
+        "nonterminals": nonterminals,
+        "allowed_vertices": allowed_vertices,
+        "candidate_pool": [v for v in allowed_vertices if v != marked],
+        "edges": edges,
+        "answer": answer,
+    }
+    return inst
+
+
+def render(inst: dict) -> str:
+    """Render the complete implicit graph definition and output contract."""
+    statement = f"""Exact X-Y vertex separator in an implicitly specified graph
+
+An X-Y vertex separator in an undirected graph is a set K of vertices outside
+X union Y such that, after deleting K and all incident edges, no vertex of X is
+connected by a path to any vertex of Y.
+
+This graph has terminals s and t and the following integer-labelled nonterminals.
+All arithmetic below is exact integer arithmetic.
+
+Parameters:
+  h = {inst['n']}                 (binary-tree height; roots have depth 0)
+  r = {inst['r']}                 (number of trees)
+  q = {inst['q']}
+  C = {inst['base_count']}
+  m = {inst['tree_size']}         (base vertices per tree)
+  a = {inst['a']}, b = {inst['b']}
+  A = {inst['ell_a']}, B = {inst['ell_b']}, M = {inst['ell_mod']}
+
+Logical base indices are j=0,...,C-1.  Tree z uses j=z*m+u, where
+z=0,...,r-1 and u=0,...,m-1 is the usual breadth-first binary-heap index:
+u=0 is its root; children of u are 2u+1 and 2u+2 when those indices are <m.
+Define E(j)=(a*j+b) mod C.  The branch vertex for j has visible label q*E(j).
+
+For every non-root base index j, define
+  L(j) = 1 + (((A*j+B) mod M) mod q).
+The edge from j's logical parent to j is replaced by the path whose visible
+labels are
+  q*E(parent), q*E(j)+L(j)-1, ..., q*E(j)+1, q*E(j).
+When L(j)=1 this is just the edge q*E(parent)--q*E(j).  Terminal s is adjacent
+to every tree root q*E(z*m).  Terminal t is adjacent to every branch vertex at
+depth h.  These and only these are the graph edges and vertices.
+
+The terminal sets are
+  X = {json.dumps(inst['X'])}
+  Y = [t]
+where the symbol s in X is printed as -1 in the displayed list; -2 denotes t.
+The required separator must contain marked vertex {inst['marked']}.
+
+Find exactly k={inst['required_size']} DISTINCT integer-labelled nonterminals
+that form an X-Y separator and contain {inst['marked']}.  The order of labels is
+irrelevant, repetitions are forbidden, and neither -1 nor -2 may be output.
+
+Give your final answer inside <answer></answer> tags as comma-separated integers.
+Example: <answer>3, 17, 42</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str):
+    """Parse a tagged comma-separated integer set, tolerating surrounding prose."""
+    if not isinstance(text, str):
+        return None
+    matches = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text,
+                         flags=re.IGNORECASE | re.DOTALL)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    body = re.sub(r"^```(?:json|text)?\s*|\s*```$", "", body,
+                  flags=re.IGNORECASE | re.DOTALL).strip()
+    if body.startswith("[") and body.endswith("]"):
+        body = body[1:-1].strip()
+    if not body:
+        return []
+    pieces = [p.strip() for p in body.split(",")]
+    if any(not re.fullmatch(r"[+-]?\d+", p) for p in pieces):
+        return None
+    try:
+        return [int(p) for p in pieces]
+    except (TypeError, ValueError, OverflowError):
+        return None
+
+
+def _decode_vertex(inst: dict, label: int):
+    """Return (logical base index, subdivision position), or None."""
+    if not isinstance(label, int) or isinstance(label, bool) or label < 0:
+        return None
+    q = inst["q"]
+    encoded, pos = divmod(label, q)
+    if encoded >= inst["base_count"]:
+        return None
+    j = (inst["a_inv"] * (encoded - inst["b"])) % inst["base_count"]
+    local = j % inst["tree_size"]
+    if pos == 0:
+        return j, pos
+    if local == 0:
+        return None
+    length = _edge_length(j, inst["ell_a"], inst["ell_b"],
+                          inst["ell_mod"], q)
+    if pos >= length:
+        return None
+    return j, pos
+
+
+def _formula_separates(inst: dict, cut: set[int]) -> bool:
+    """Exact reachability test on the promised subdivided binary-tree graph."""
+    selected = set()
+    for label in cut:
+        decoded = _decode_vertex(inst, label)
+        if decoded is None:
+            return False
+        selected.add(decoded[0])
+
+    height = inst["n"]
+    tree_size = inst["tree_size"]
+    first_leaf = (1 << height) - 1
+
+    def covered(offset: int, local: int) -> bool:
+        if offset + local in selected:
+            return True
+        if local >= first_leaf:
+            return False
+        return (covered(offset, 2 * local + 1)
+                and covered(offset, 2 * local + 2))
+
+    for tree in range(inst["r"]):
+        if not covered(tree * tree_size, 0):
+            return False
+    return True
+
+
+def _explicit_separates(inst: dict, cut: set[int]) -> bool:
+    adjacency = {}
+    for u, v in inst["edges"]:
+        adjacency.setdefault(u, []).append(v)
+        adjacency.setdefault(v, []).append(u)
+    targets = set(inst["Y"])
+    stack = [x for x in inst["X"] if x not in cut]
+    seen = set(stack)
+    while stack:
+        u = stack.pop()
+        if u in targets:
+            return False
+        for v in adjacency.get(u, ()):
+            if v not in cut and v not in seen:
+                seen.add(v)
+                stack.append(v)
+    return True
+
+
+def verify(inst: dict, answer) -> tuple[bool, str]:
+    """Check any valid separator; the planted answer is never consulted."""
+    if not isinstance(answer, list):
+        return False, "answer must be a list of integer vertex labels"
+    if not answer:
+        return False, "answer must be a nonempty list"
+    if len(answer) != inst["required_size"]:
+        return False, f"wrong number of labels: expected {inst['required_size']}"
+    if any(not isinstance(v, int) or isinstance(v, bool) for v in answer):
+        return False, "every vertex label must be an integer"
+    if len(set(answer)) != len(answer):
+        return False, "duplicate vertex labels are forbidden"
+    if inst["marked"] not in answer:
+        return False, "the marked vertex is missing"
+    forbidden = set(inst["X"]) | set(inst["Y"])
+    if any(v in forbidden for v in answer):
+        return False, "a separator may not contain a vertex of X or Y"
+
+    if inst.get("_explicit_only"):
+        allowed = set(inst["nonterminals"])
+        if any(v not in allowed for v in answer):
+            return False, "unknown nonterminal vertex label"
+        separates = _explicit_separates(inst, set(answer))
+    else:
+        if any(_decode_vertex(inst, v) is None for v in answer):
+            return False, "unknown nonterminal vertex label"
+        separates = _formula_separates(inst, set(answer))
+    if not separates:
+        return False, "deleting these vertices leaves an X-Y path"
+    return True, "ok"
+
+
+def _allowed_vertices(inst: dict) -> list[int]:
+    if "allowed_vertices" in inst:
+        return inst["allowed_vertices"]
+    forbidden = set(inst["X"]) | set(inst["Y"])
+    return [v for v in inst["nonterminals"] if v not in forbidden]
+
+
+def random_candidate(inst: dict, rng: random.Random):
+    """Sample uniformly from the structure-aware bounded certificate language."""
+    marked = inst["marked"]
+    pool = inst.get("candidate_pool")
+    if pool is None:
+        pool = [v for v in _allowed_vertices(inst) if v != marked]
+    chosen = rng.sample(pool, inst["required_size"] - 1)
+    return sorted([marked] + chosen)
+
+
+def search_space(inst: dict):
+    allowed_count = len(_allowed_vertices(inst))
+    return math.comb(allowed_count - 1, inst["required_size"] - 1)
+
+
+def enumerate_all(inst: dict):
+    space = search_space(inst)
+    if space > 100_000:
+        return None
+    allowed = [v for v in _allowed_vertices(inst) if v != inst["marked"]]
+    count = 0
+    for tail in itertools.combinations(allowed, inst["required_size"] - 1):
+        ok, _ = verify(inst, [inst["marked"], *tail])
+        count += int(ok)
+    return count
+
+
+def _exact_solution_count(inst: dict) -> int:
+    """Count minimum frontiers containing marked, using the construction proof."""
+    e_marked = inst["marked"] // inst["q"]
+    marked_j = (inst["a_inv"] * (e_marked - inst["b"])) % inst["base_count"]
+    local = marked_j % inst["tree_size"]
+    offset = marked_j - local
+    count = 1
+    for _ in range(inst["depth"]):
+        sibling_local = local + 1 if local % 2 == 1 else local - 1
+        sibling_j = offset + sibling_local
+        count *= _edge_length(sibling_j, inst["ell_a"], inst["ell_b"],
+                              inst["ell_mod"], inst["q"])
+        local = (local - 1) // 2
+    return count
+
+
+def _tree_component_digest(nodes, adjacency, colors) -> bytes:
+    """AHU-style canonical digest of one unrooted colored tree."""
+    if len(nodes) == 1:
+        centers = list(nodes)
+    else:
+        degree = {v: sum(w in nodes for w in adjacency.get(v, ())) for v in nodes}
+        leaves = deque(v for v in nodes if degree[v] <= 1)
+        remaining = len(nodes)
+        while remaining > 2:
+            batch = len(leaves)
+            remaining -= batch
+            for _ in range(batch):
+                v = leaves.popleft()
+                for w in adjacency.get(v, ()):
+                    if w in degree and degree[w] > 0:
+                        degree[w] -= 1
+                        if degree[w] == 1:
+                            leaves.append(w)
+                degree[v] = 0
+        centers = list(leaves) if leaves else [next(iter(nodes))]
+
+    def rooted(v, parent):
+        child_hashes = [rooted(w, v) for w in adjacency.get(v, ())
+                        if w != parent and w in nodes]
+        child_hashes.sort()
+        payload = bytes(colors[v]) + b"(" + b"".join(child_hashes) + b")"
+        return hashlib.sha256(payload).digest()
+
+    if len(centers) == 1:
+        return hashlib.sha256(b"one" + rooted(centers[0], None)).digest()
+    c1, c2 = centers[:2]
+    halves = sorted([rooted(c1, c2), rooted(c2, c1)])
+    return hashlib.sha256(b"two" + halves[0] + halves[1]).digest()
+
+
+def _canonical_orientation(inst: dict, swap_xy: bool) -> str:
+    source, sink = inst["source"], inst["sink"]
+    removed = {source, sink}
+    adjacency = {v: [] for v in inst["nonterminals"]}
+    near_source, near_sink = set(), set()
+    for u, v in inst["edges"]:
+        if u == source and v not in removed:
+            near_source.add(v)
+        elif v == source and u not in removed:
+            near_source.add(u)
+        if u == sink and v not in removed:
+            near_sink.add(v)
+        elif v == sink and u not in removed:
+            near_sink.add(u)
+        if u not in removed and v not in removed:
+            adjacency.setdefault(u, []).append(v)
+            adjacency.setdefault(v, []).append(u)
+
+    xset, yset = set(inst["X"]), set(inst["Y"])
+    if swap_xy:
+        xset, yset = yset, xset
+    colors = {
+        v: (int(v == inst["marked"]), int(v in xset), int(v in yset),
+            int(v in near_source), int(v in near_sink))
+        for v in inst["nonterminals"]
+    }
+    unseen = set(inst["nonterminals"])
+    parts = []
+    while unseen:
+        start = next(iter(unseen))
+        stack = [start]
+        component = {start}
+        unseen.remove(start)
+        while stack:
+            u = stack.pop()
+            for v in adjacency.get(u, ()):
+                if v in unseen:
+                    unseen.remove(v)
+                    component.add(v)
+                    stack.append(v)
+        parts.append(_tree_component_digest(component, adjacency, colors))
+    parts.sort()
+    head = json.dumps({"k": inst["required_size"], "parts": len(parts)},
+                      sort_keys=True).encode()
+    return hashlib.sha256(head + b"".join(parts)).hexdigest()
+
+
+def canonical_key(inst: dict) -> str:
+    """Canonical colored-tree-forest key, independent of all vertex labels."""
+    return min(_canonical_orientation(inst, False),
+               _canonical_orientation(inst, True))
+
+
+def escalate(params: dict):
+    """Double the implicit forest and increase subdivision crowding at fixed k."""
+    harder = dict(params)
+    harder.pop("_preset", None)
+    harder["n"] = int(params["n"]) + 1
+    harder["q"] = int(params.get("q", 5)) + 1
+    # r and depth, hence the answer length, deliberately remain fixed.
+    return harder
+
+
+# ------------------------ adversarial/reference methods --------------------
+
+def _candidate_from_ranked(inst: dict, ranked) -> list[int]:
+    allowed = set(_allowed_vertices(inst))
+    result = [inst["marked"]]
+    for v in ranked:
+        if v in allowed and v not in result:
+            result.append(v)
+            if len(result) == inst["required_size"]:
+                break
+    if len(result) < inst["required_size"]:
+        for v in sorted(allowed):
+            if v not in result:
+                result.append(v)
+                if len(result) == inst["required_size"]:
+                    break
+    return sorted(result)
+
+
+def _attack_degree(inst: dict):
+    degree = {v: 0 for v in inst["nonterminals"]}
+    for u, v in inst["edges"]:
+        if u in degree:
+            degree[u] += 1
+        if v in degree:
+            degree[v] += 1
+    target_degree = degree[inst["marked"]]
+    ranked = sorted(degree, key=lambda v: (abs(degree[v] - target_degree),
+                                            -degree[v], v))
+    return _candidate_from_ranked(inst, ranked)
+
+
+def _attack_terminal_distance(inst: dict):
+    adjacency = {}
+    for u, v in inst["edges"]:
+        adjacency.setdefault(u, []).append(v)
+        adjacency.setdefault(v, []).append(u)
+    dist = {inst["sink"]: 0}
+    queue = deque([inst["sink"]])
+    while queue:
+        u = queue.popleft()
+        for v in adjacency.get(u, ()):
+            if v not in dist:
+                dist[v] = dist[u] + 1
+                queue.append(v)
+    ranked = sorted(inst["nonterminals"], key=lambda v: (dist.get(v, 10**9), v))
+    return _candidate_from_ranked(inst, ranked)
+
+
+def _attack_local(inst: dict):
+    adjacency = {}
+    for u, v in inst["edges"]:
+        adjacency.setdefault(u, []).append(v)
+        adjacency.setdefault(v, []).append(u)
+    dist = {inst["marked"]: 0}
+    queue = deque([inst["marked"]])
+    while queue:
+        u = queue.popleft()
+        for v in adjacency.get(u, ()):
+            if v not in dist:
+                dist[v] = dist[u] + 1
+                queue.append(v)
+    ranked = sorted(inst["nonterminals"], key=lambda v: (dist.get(v, 10**9), v))
+    return _candidate_from_ranked(inst, ranked)
+
+
+def _attack_cipher_blind(inst: dict):
+    q, m, r = inst["q"], inst["tree_size"], inst["r"]
+    visible_block = inst["marked"] // q
+    apparent_tree, local = divmod(visible_block, m)
+    ranked = []
+    for tree in range(r):
+        if tree != apparent_tree:
+            ranked.append(q * (tree * m))
+    for _ in range(inst["depth"]):
+        if local == 0:
+            break
+        sibling = local + 1 if local % 2 == 1 else local - 1
+        ranked.append(q * (apparent_tree * m + sibling))
+        local = (local - 1) // 2
+    return _candidate_from_ranked(inst, ranked)
+
+
+def _dinic_reference(inst: dict):
+    """Solve via vertex splitting and Dinic; return (answer, statistics)."""
+    marked = inst["marked"]
+    original_vertices = [inst["source"], inst["sink"], *inst["nonterminals"]]
+    original_vertices = [v for v in original_vertices if v != marked]
+    index = {v: i for i, v in enumerate(original_vertices)}
+    network_n = 2 * len(original_vertices) + 2
+    super_source = network_n - 2
+    super_sink = network_n - 1
+    graph = [[] for _ in range(network_n)]
+    operations = 0
+
+    def add_edge(u, v, cap):
+        graph[u].append([v, len(graph[v]), cap])
+        graph[v].append([u, len(graph[u]) - 1, 0])
+
+    inf = len(original_vertices) + 1
+    protected = set(inst["X"]) | set(inst["Y"])
+    for v, i in index.items():
+        add_edge(2 * i, 2 * i + 1, inf if v in protected else 1)
+    for u, v in inst["edges"]:
+        if u == marked or v == marked:
+            continue
+        add_edge(2 * index[u] + 1, 2 * index[v], inf)
+        add_edge(2 * index[v] + 1, 2 * index[u], inf)
+    for x in inst["X"]:
+        if x != marked:
+            add_edge(super_source, 2 * index[x], inf)
+    for y in inst["Y"]:
+        if y != marked:
+            add_edge(2 * index[y] + 1, super_sink, inf)
+
+    flow = 0
+    target_limit = inst["required_size"]
+    bfs_rounds = 0
+    augmentations = 0
+    while flow < target_limit:
+        bfs_rounds += 1
+        level = [-1] * network_n
+        level[super_source] = 0
+        queue = deque([super_source])
+        while queue:
+            u = queue.popleft()
+            for edge in graph[u]:
+                operations += 1
+                if edge[2] and level[edge[0]] < 0:
+                    level[edge[0]] = level[u] + 1
+                    queue.append(edge[0])
+        if level[super_sink] < 0:
+            break
+        ptr = [0] * network_n
+
+        def dfs(u, pushed):
+            nonlocal operations
+            if u == super_sink:
+                return pushed
+            while ptr[u] < len(graph[u]):
+                edge = graph[u][ptr[u]]
+                operations += 1
+                if edge[2] and level[edge[0]] == level[u] + 1:
+                    sent = dfs(edge[0], min(pushed, edge[2]))
+                    if sent:
+                        edge[2] -= sent
+                        graph[edge[0]][edge[1]][2] += sent
+                        return sent
+                ptr[u] += 1
+            return 0
+
+        while flow < target_limit:
+            sent = dfs(super_source, target_limit - flow)
+            if not sent:
+                break
+            flow += sent
+            augmentations += 1
+
+    # The final failed BFS leaves the residual reachable side in ``level``.
+    cut = []
+    if flow == inst["required_size"] - 1 and level[super_sink] < 0:
+        for v, i in index.items():
+            if v not in protected and level[2 * i] >= 0 and level[2 * i + 1] < 0:
+                cut.append(v)
+    candidate = sorted([marked] + cut)
+    return candidate, {
+        "flow": flow,
+        "edge_scan_operations": operations,
+        "bfs_rounds": bfs_rounds,
+        "augmentations": augmentations,
+        "network_vertices": network_n,
+    }
+
+
+def _relabel_instance(inst: dict, rng: random.Random) -> dict:
+    vertices = [inst["source"], inst["sink"], *inst["nonterminals"]]
+    shuffled = list(vertices)
+    rng.shuffle(shuffled)
+    mapping = dict(zip(vertices, shuffled))
+    out = dict(inst)
+    out["source"] = mapping[inst["source"]]
+    out["sink"] = mapping[inst["sink"]]
+    out["X"] = [mapping[v] for v in inst["X"]]
+    out["Y"] = [mapping[v] for v in inst["Y"]]
+    out["marked"] = mapping[inst["marked"]]
+    out["nonterminals"] = [mapping[v] for v in inst["nonterminals"]]
+    out["allowed_vertices"] = [mapping[v] for v in inst["allowed_vertices"]]
+    out["candidate_pool"] = [mapping[v] for v in inst["candidate_pool"]]
+    out["edges"] = [[mapping[u], mapping[v]] for u, v in inst["edges"]]
+    rng.shuffle(out["edges"])
+    out["answer"] = [mapping[v] for v in inst["answer"]]
+    out["_explicit_only"] = True
+    return out
+
+
+def _answer_text(answer) -> str:
+    return "<answer>" + ", ".join(map(str, answer)) + "</answer>"
+
+
+def selftest() -> dict:
+    """Run G1--G9 and return a fully JSON-serialisable measurement report."""
+    report = {"paper": "1104.5361", "track": TRACK,
+              "shipping_difficulty": SHIPPING_DIFFICULTY}
+
+    # G1: all named presets and several independent seeds.
+    g1_ok = 0
+    g1_total = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in range(3):
+            inst = make_instance(seed=seed, **params)
+            ok, why = verify(inst, inst["answer"])
+            g1_total += 1
+            if ok:
+                g1_ok += 1
+            else:
+                raise AssertionError((preset, seed, why))
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                raise AssertionError("answer is not JSON-native")
+    report["G1_planted_verifies"] = {
+        "pass": g1_ok == g1_total, "verified": g1_ok, "attempts": g1_total}
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=101, **shipping)
+    planted = list(inst["answer"])
+    corruptions = {}
+    corruptions["empty"] = []
+    corruptions["drop_one"] = planted[:-1]
+    corruptions["duplicate_one"] = planted[:-1] + [planted[0]]
+    corruptions["out_of_range"] = planted[:-1] + [inst["q"] * inst["base_count"] + 7]
+    replacement = next(v for v in _allowed_vertices(inst)
+                       if v not in planted and v != inst["marked"])
+    replace_at = next(i for i, v in enumerate(planted) if v != inst["marked"])
+    swapped = list(planted)
+    swapped[replace_at] = replacement
+    corruptions["replace_one"] = swapped
+    reasons = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
+        if ok:
+            raise AssertionError(f"corruption {name} verified")
+        reasons[name] = why
+    distinct_reasons = len(set(reasons.values()))
+    report["G2_rejects_corruption"] = {
+        "pass": distinct_reasons == len(corruptions),
+        "rejected": len(corruptions), "distinct_reasons": distinct_reasons,
+        "reasons": reasons,
+    }
+
+    model_style = ("I used the tree frontier.\n```text\n"
+                   + _answer_text(inst["answer"])
+                   + "\n```\nThose are the requested labels.")
+    parsed = parse_answer(model_style)
+    roundtrip_ok = parsed == inst["answer"] and verify(inst, parsed)[0]
+    report["G3_round_trip"] = {
+        "pass": roundtrip_ok, "parsed_elements": len(parsed or [])}
+
+    # G4: samples are already exact-size, distinct, allowed, and marked-containing.
+    guess_rng = random.Random(730_041)
+    guess_total = 200_000
+    guess_hits = 0
+    for _ in range(guess_total):
+        candidate = random_candidate(inst, guess_rng)
+        guess_hits += int(verify(inst, candidate)[0])
+    guess_probability = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_probability < 1e-6,
+        "hits": guess_hits, "total": guess_total,
+        "observed_probability": guess_probability,
+        "candidate_space": search_space(inst),
+        "sampling_prior": "uniform exact-size allowed sets containing marked",
+    }
+
+    # G6 and Track-B reference algorithm, all at the shipping preset.
+    attack_names = [
+        "outlier_same_degree",
+        "greedy_closest_to_Y",
+        "random_restart_256",
+        "cipher_blind_heap_ansatz",
+        "local_neighbourhood_ansatz",
+    ]
+    attack_success = {name: 0 for name in attack_names}
+    reference_success = 0
+    reference_seconds = []
+    reference_ops = []
+    reference_rounds = []
+    for seed in range(8):
+        test_inst = make_instance(seed=20_000 + seed, **shipping)
+        candidates = {
+            "outlier_same_degree": _attack_degree(test_inst),
+            "greedy_closest_to_Y": _attack_terminal_distance(test_inst),
+            "cipher_blind_heap_ansatz": _attack_cipher_blind(test_inst),
+            "local_neighbourhood_ansatz": _attack_local(test_inst),
+        }
+        rr_rng = random.Random(90_000 + seed)
+        rr_solved = False
+        for _ in range(256):
+            if verify(test_inst, random_candidate(test_inst, rr_rng))[0]:
+                rr_solved = True
+                break
+        attack_success["random_restart_256"] += int(rr_solved)
+        for name, candidate in candidates.items():
+            attack_success[name] += int(verify(test_inst, candidate)[0])
+
+        t0 = time.perf_counter()
+        reference_answer, stats = _dinic_reference(test_inst)
+        elapsed = time.perf_counter() - t0
+        reference_success += int(verify(test_inst, reference_answer)[0])
+        reference_seconds.append(elapsed)
+        reference_ops.append(stats["edge_scan_operations"])
+        reference_rounds.append(stats["bfs_rounds"])
+
+    attacks = {name: {"successes": attack_success[name], "attempts": 8}
+               for name in attack_names}
+    reference = {
+        "name": "vertex splitting plus Dinic max flow after deleting marked",
+        "complexity": "O(V^2 E) worst-case",
+        "wall_clock_sec": round(sum(reference_seconds) / len(reference_seconds), 6),
+        "max_wall_clock_sec": round(max(reference_seconds), 6),
+        "operations": round(sum(reference_ops) / len(reference_ops)),
+        "max_operations": max(reference_ops),
+        "bfs_rounds": round(sum(reference_rounds) / len(reference_rounds), 3),
+        "successes": reference_success,
+        "attempts": 8,
+        "solves": f"{reference_success}/8, as expected",
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(v["successes"] == 0 for v in attacks.values()),
+        "attacks": attacks,
+        "reference_algorithm": reference,
+    }
+
+    exact_valid = _exact_solution_count(inst)
+    candidate_space = search_space(inst)
+    report["G5_density_and_baseline"] = {
+        "pass": exact_valid > 0 and reference_success == 8,
+        "shipping_exact_valid_count": exact_valid,
+        "shipping_candidate_space": candidate_space,
+        "shipping_solution_density": exact_valid / candidate_space,
+        "sample_hits": guess_hits,
+        "sample_total": guess_total,
+        "sampled_density": guess_probability,
+        "baseline_wall_clock_sec": reference["wall_clock_sec"],
+        "baseline_edge_scan_operations": reference["operations"],
+        "baseline_bfs_rounds": reference["bfs_rounds"],
+    }
+
+    doubled_params = dict(shipping)
+    doubled_params["n"] += 1
+    doubled_params["q"] += 1
+    doubled = make_instance(seed=303, **doubled_params)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and len(doubled["nonterminals"]) > 1.9 * len(inst["nonterminals"]),
+        "shipping_vertices": len(inst["nonterminals"]) + 2,
+        "larger_vertices": len(doubled["nonterminals"]) + 2,
+        "size_ratio": len(doubled["nonterminals"]) / len(inst["nonterminals"]),
+        "answer_elements_before": len(inst["answer"]),
+        "answer_elements_after": len(doubled["answer"]),
+        "verify_reason": doubled_why,
+    }
+
+    invariant_checks = 0
+    transformed_verify = 0
+    original_keys = []
+    for seed in range(20):
+        base = make_instance(seed=40_000 + seed, **DIFFICULTY["easy"])
+        key = canonical_key(base)
+        original_keys.append(key)
+        transformed = _relabel_instance(base, random.Random(50_000 + seed))
+        tok, _ = verify(transformed, transformed["answer"])
+        transformed_verify += int(tok)
+        invariant_checks += int(canonical_key(transformed) == key)
+        swapped_xy = dict(transformed)
+        swapped_xy["X"], swapped_xy["Y"] = list(transformed["Y"]), list(transformed["X"])
+        sok, _ = verify(swapped_xy, swapped_xy["answer"])
+        transformed_verify += int(sok)
+        invariant_checks += int(canonical_key(swapped_xy) == key)
+    distinct_keys = len(set(original_keys))
+    report["G8_canonical_key"] = {
+        "pass": invariant_checks == 40 and transformed_verify == 40
+                and distinct_keys == 20,
+        "invariance_passed": invariant_checks,
+        "invariance_attempts": 40,
+        "transformed_witnesses_verified": transformed_verify,
+        "transformed_witness_attempts": 40,
+        "distinct_unrelated_keys": distinct_keys,
+        "distinctness_attempts": 20,
+        "transformations": ["vertex relabelling", "edge reordering", "X-Y swap",
+                            "their composition"],
+    }
+
+    size_samples = [make_instance(seed=s, **shipping)["answer"] for s in range(20)]
+    answer_chars = max(len(json.dumps(a)) for a in size_samples)
+    answer_elements = max(len(a) for a in size_samples)
+    answer_tokens = (answer_chars + 3) // 4
+    intended_operations = 96
+    hinted = G9_ARMS["hinted"]
+    placebo = G9_ARMS["placebo"]
+    h_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    p_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_operations <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": G9_ARMS,
+        "hinted_minus_placebo": h_rate - p_rate,
+        "hinted_verdict": ("too_easy" if hinted["solved"] else "hardened")
+                           if hinted["attempts"] else "not_yet_run",
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [v for k, v in report.items() if k.startswith("G")]
+    report["all_passed"] = all(g.get("pass") for g in gates)
+    return report
+
+
+if __name__ == "__main__":
+    # Printing is deliberately confined to explicit execution, never import.
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

