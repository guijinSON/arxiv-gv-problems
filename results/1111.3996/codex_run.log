+def _attack_public_order_recurrence(inst):
+    """Tempting in-context ansatz: take public variable order as cycle order."""
+    checks = _extract_checks(inst)
+    rhs_by_triple = {
+        tuple(sorted(check["vars"])): check["rhs"] for check in checks
+    }
+    candidates = []
+    for first in (0, 1):
