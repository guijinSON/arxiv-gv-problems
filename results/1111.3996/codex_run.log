python3 - <<'PY'
import copy, importlib.util, json, random, sys
s=importlib.util.spec_from_file_location('g','gen_1111_3996.py'); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
# Determinism and whole-instance JSON encoding.
for preset, params in g.DIFFICULTY.items():
    for seed in range(5):
        a=g.make_instance(seed=seed,**params); b=g.make_instance(seed=seed,**params)
        assert a == b
        assert json.loads(json.dumps(a)) == a
        witness=a['answer']
        no_answer=copy.deepcopy(a); del no_answer['answer']
        assert g.verify(no_answer,witness)==(True,'ok')
        poisoned=copy.deepcopy(a); poisoned['answer']='definitely-not-the-witness'
        assert g.verify(poisoned,witness)==(True,'ok')
        assert g.parse_answer('prose\\n<answer>'+witness+'</answer>\\nmore')==witness
# Exact uniqueness for all 32 masks on several demo instances.
for seed in range(20):
    i=g.make_instance(seed=seed,**g.DIFFICULTY['demo'])
    assert g.enumerate_all(i)==1
# Every parity block is contiguous, labels are pure names, shortcut/reference solve.
for n in (5,127,163,191,254):
    for seed in (0,1,9):
        i=g.make_instance(n=n,seed=seed,copies=1)
        seen=[]
        for c in i['clauses']:
            if not seen or seen[-1]"'!=c['"'block']: seen.append(c['block'])
        assert len(seen)==n and len(set(seen))==n
        short=g._cyclic_prefix_shortcut(i)
        gauss,stats=g._gaussian_reference(i)
        assert g.verify(i,g._encode_bits(n,short))[0]
        assert g.verify(i,g._encode_bits(n,gauss))[0]
print('extended_audit=ok')
