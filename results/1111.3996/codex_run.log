+            "nodes_mean": sum(dpll_nodes) / len(dpll_nodes),
+            "decisions_mean": sum(dpll_decisions) / len(dpll_decisions),
+            "solves": f"{dpll_successes}/{len(attack_seeds)}, as expected",
+        },
