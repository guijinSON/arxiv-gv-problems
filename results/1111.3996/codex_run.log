+            best[0][0]
+            if best is not None
+            else next(i for i, bit in enumerate(assignment) if bit < 0)
+        )
+        for bit in (0, 1):
+            stats["decisions"] += 1
+            child = list(assignment)
+            child[variable] = bit
+            solution = recurse(child)
+            if solution is not None:
+                return solution
+        stats["backtracks"] += 1
+        return None
