+            attack_results[name]["successes"] += int(verify(inst, candidate)[0])
+            attack_results[name]["attempts"] += 1
+
+    reference_successes = 0
+    dpll_successes = 0
+    shortcut_successes = 0
+    reference_elapsed = 0.0
+    dpll_elapsed = 0.0
+    reference_operations = []
+    reference_row_xors = []
+    dpll_literal_evaluations = []
