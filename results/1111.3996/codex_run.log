+# Filled from script-owned oracle runs before shipping.  "unrun" deliberately
+# makes G9 fail until the required hinted arm has actually been executed.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "unrun",
