+    out["decoys"] = max(decoys, 2 * next_n)
+    out["extra_precedence"] = min(extra, max(0, 300 - (4 * next_n - 1)))
+    out["noise_edges"] = min(
+        out["decoys"] * (out["decoys"] - 1) // 2,
+        max(noise, out["decoys"]),
