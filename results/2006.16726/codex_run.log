    \draw ({cos(360-45)*7}, {sin(360-45)*7}) -- ({20+cos(90+45)*7}, {-20+sin(90+45)*7});
    \draw ({cos(45)*7}, {-40+sin(45)*7}) -- ({20+cos(180+45)*7}, {-20+sin(180+45)*7});
