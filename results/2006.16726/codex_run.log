+
+def _reference_legal_pair_scan(inst):
+    """Polynomial endpoint-directed scan, intentionally structure-agnostic."""
+    adj = _adjacency(inst)
+    state = set(inst["source"])
+    additions = set(inst["target"]) - state
+    removals = state - set(inst["target"])
