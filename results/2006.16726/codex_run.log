+    "easy": {"n": 32, "decoys": 48, "extra_precedence": 16, "noise_edges": 36},
+    "medium": {"n": 44, "decoys": 66, "extra_precedence": 22, "noise_edges": 66},
+    "hard": {"n": 60, "decoys": 90, "extra_precedence": 30, "noise_edges": 100},
