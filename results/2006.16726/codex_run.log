+        "vertices": inst["vertex_count"],
+        "limit": inst["limit"],
+        "moves": inst["required_moves"],
+        "color_counts": sorted(color_counts.items()),
+        "edge_colors": sorted((list(pair), count) for pair, count in edge_colors.items()),
