+    max_extra = min((n - 1) * (n - 2) // 2, max(0, operation_room))
+    if extra < max_extra:
+        out["extra_precedence"] = min(max_extra, extra + max(1, n // 4))
+        out["noise_edges"] = min(
+            out["decoys"] * (out["decoys"] - 1) // 2,
+            noise + max(1, n // 2),
+        )
+        return out
