+def canonical_key(inst):
+    """A strong cheap colored-graph invariant, independent of labels and order."""
+    encoded = json.dumps(_wl_payload(inst), sort_keys=True, separators=(",", ":")).encode()
+    return hashlib.sha256(encoded).hexdigest()
