import copy, json, os
import gen_2006_16726 as g
import corpus_report

checks = {}
# Determinism and planted validity across a broader seed sweep.
for preset, params in g.DIFFICULTY.items():
    for seed in range(25):
        a = g.make_instance(seed=seed, **params)
        b = g.make_instance(seed=seed, **params)
        assert a == b
        assert g.verify(a, a['answer']) == (True, 'ok')
checks['deterministic_and_valid'] = '100/100'

# The verifier must not trust inst['answer'].
i = g.make_instance(seed=991, **g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
witness = list(i['answer'])
tampered = copy.deepcopy(i)
tampered['answer'] = []
assert g.verify(tampered, witness) == (True, 'ok')
checks['verify_ignores_planted_answer'] = True

# Default rendering has no hint; modes append only their own sentence.
os.environ.pop('GV_HINT_MODE', None)
bare = g.render(i)
os.environ['GV_HINT_MODE'] = 'structural'
structural = g.render(i)
os.environ['GV_HINT_MODE'] = 'placebo'
placebo = g.render(i)
os.environ.pop('GV_HINT_MODE', None)
assert g.STRUCTURAL_HINT not in bare and g.PLACEBO_HINT not in bare
assert structural.endswith(g.STRUCTURAL_HINT)
assert placebo.endswith(g.PLACEBO_HINT)
checks['hint_modes'] = True

# Reporter classification and bounded-language properties.
profile = corpus_report.profile_for_module(g, i, family={})
for key in ('native_domain','object_regime','computational_core','certificate_form','domain_essentiality','reduction_kind','track'):
    assert profile[key] == ({
        'track': g.TRACK,
        'native_domain': g.PROBLEM_PROFILE['native_domain'],
        'object_regime': g.PROBLEM_PROFILE['object_regime'],
        'computational_core': g.PROBLEM_PROFILE['computational_core'],
        'certificate_form': g.PROBLEM_PROFILE['certificate_form'],
        'domain_essentiality': g.PROBLEM_PROFILE['domain_essentiality'],
        'reduction_kind': g.PROBLEM_PROFILE['reduction_kind'],
    })[key]
checks['reported_profile'] = {k: profile[k] for k in ('native_domain','computational_core','certificate_form','track','core_provenance')}

# Stronger cheap diversity check.
keys = [g.canonical_key(g.make_instance(seed=s, **g.DIFFICULTY[g.SHIPPING_DIFFICULTY])) for s in range(1000,1100)]
assert len(keys) == len(set(keys))
checks['distinct_keys'] = '100/100'

# Escalation first expands fixed-length haystacks.
p = dict(g.DIFFICULTY['hard'])
q = g.escalate(p)
assert isinstance(q, dict) and q['n'] == p['n'] and q['decoys'] > p['decoys']
checks['fixed_length_escalation'] = {'before': p, 'after': q}
print(json.dumps(checks, indent=2, sort_keys=True))
