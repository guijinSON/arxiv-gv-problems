+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list of exactly 2n nonzero signed vertex labels, alternating add "
+        "then remove, that adds every target-only vertex once and removes every "
+        "source-only vertex once; the two endpoint-difference orders are otherwise "
+        "independent."
+    ),
+    "bounds": {
+        "length": "2n",
+        "positive_entries": "a permutation of target minus source",
+        "negative_entries": "the negation of a permutation of source minus target",
+        "candidate_count": "(n!)^2",
+    },
+}
+
+# Filled from the three script-owned harness runs before shipping.  The counts
+# are diagnostics; only the size/effort caps in G9 are gates.
+G9_ORACLE_RESULTS = {
