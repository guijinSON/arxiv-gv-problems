+    for pair in edge_faces.values():
+        a, b = pair
+        adjacency[a].add(b)
+        adjacency[b].add(a)
+    if any(len(neighbors) != 4 for neighbors in adjacency.values()):
+        raise ValueError("every square panel must have four edge-neighbors")
+    return adjacency
+
