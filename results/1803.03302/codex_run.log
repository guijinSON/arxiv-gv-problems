import random,time,statistics

def box_graph(A,B,C,seed):
    faces=[]
    # face tuple axis, coord, u, v; corners explicit
    for x in (0,A):
      for y in range(B):
       for z in range(C): faces.append(((x,y,z),(x,y+1,z),(x,y+1,z+1),(x,y,z+1)))
    for y in (0,B):
      for x in range(A):
       for z in range(C): faces.append(((x,y,z),(x+1,y,z),(x+1,y,z+1),(x,y,z+1)))
    for z in (0,C):
      for x in range(A):
       for y in range(B): faces.append(((x,y,z),(x+1,y,z),(x+1,y+1,z),(x,y+1,z)))
    edge_faces={}
    for i,cs in enumerate(faces):
      for j in range(4):
       e=tuple(sorted((cs[j],cs[(j+1)%4])))
       edge_faces.setdefault(e,[]).append(i)
    adj=[set() for _ in faces]
    for fs in edge_faces.values():
      assert len(fs)==2, fs
      u,v=fs;adj[u].add(v);adj[v].add(u)
    rr=random.Random(seed); p=list(range(len(faces)));rr.shuffle(p)
    new=[set() for _ in faces]
    for u in range(len(faces)):
      for v in adj[u]:new[p[u]].add(p[v])
    return [sorted(x) for x in new]

def solve(adj,limit=2_000_000):
  n=len(adj); start=min(range(n),key=lambda x: min(adj[x]))
  seen=[False]*n;seen[start]=True;path=[start];nodes=0
  def rec(v):
    nonlocal nodes
    nodes+=1
    if nodes>limit:return False
    if len(path)==n:return start in adj[v]
    # fail if any unvisited vertex has no available neighbors (including start only at end)
    cand=[w for w in adj[v] if not seen[w]]
    cand.sort(key=lambda w:(sum(not seen[x] for x in adj[w]),w))
    for w in cand:
      seen[w]=True;path.append(w)
      # connectivity/degree cheap checks every 16 levels
      okay=True
      if len(path)%16==0:
        rem=[u for u in range(n) if not seen[u]]
        for u in rem:
          avail=sum((not seen[x]) or x==start or x==w for x in adj[u])
          if avail<2:
            okay=False;break
      if okay and rec(w):return True
      path.pop();seen[w]=False
    return False
  t=time.perf_counter();ok=rec(start);return ok,nodes,time.perf_counter()-t
for dims in [(2,6,10),(4,8,8),(3,7,9)]:
 print('dims',dims)
 vals=[]
 for s in range(8):
  a=box_graph(*dims,s);ok,nodes,dt=solve(a);vals.append((nodes,dt));print(s,len(a),ok,nodes,round(dt,6))
 print('med',statistics.median(x for x,y in vals),statistics.median(y for x,y in vals))
