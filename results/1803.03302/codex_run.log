+        "cube_count": n,
+        "panel_count": len(panels),
+        "cubes": [list(cube) for cube in cubes],
+        "panels": panels,
+        "answer": answer,
+    }
+
+
+def _adjacency_from_instance(inst):
+    panels = inst.get("panels")
+    if not isinstance(panels, list):
+        return None, "panels must be a list"
+    count = inst.get("panel_count")
