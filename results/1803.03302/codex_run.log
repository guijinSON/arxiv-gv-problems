+    "demo": {"n": 2},
+    "easy": {"n": 15},
+    "medium": {"n": 31},
+    "hard": {"n": 63},
+}
+SHIPPING_DIFFICULTY = "hard"
+STRUCTURAL_HINT = "The voxel centers form an attachment chain whose covered face is replaced by a five-face surface patch."
+PLACEBO_HINT = "Careful bookkeeping of panel labels and hinge endpoints helps avoid transcription mistakes in the final cycle."
