+    middle = sorted(set(new_faces) - {entry, exit_})
+    paths = []
+    for order in itertools.permutations(middle):
+        path = (entry,) + order + (exit_,)
+        if all(path[i + 1] in adjacency[path[i]]
+               for i in range(len(path) - 1)):
