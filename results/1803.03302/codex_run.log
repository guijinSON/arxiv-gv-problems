+    """Four integer corners of (cube_x,cube_y,cube_z,direction)."""
+    x, y, z, d = face
+    if d == 0:
+        return ((x + 1, y, z), (x + 1, y + 1, z),
+                (x + 1, y + 1, z + 1), (x + 1, y, z + 1))
+    if d == 1:
+        return ((x, y, z), (x, y, z + 1),
+                (x, y + 1, z + 1), (x, y + 1, z))
+    if d == 2:
+        return ((x, y + 1, z), (x, y + 1, z + 1),
+                (x + 1, y + 1, z + 1), (x + 1, y + 1, z))
+    if d == 3:
