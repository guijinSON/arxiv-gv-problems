+
+    response = (
+        "The cyclic ordering closes at panel 0.\n\n```text\n<answer>\n"
+        + json.dumps(answer, separators=(",", ":"))
+        + "\n</answer>\n```\nAll ids are zero-based."
+    )
+    parsed = parse_answer(response)
