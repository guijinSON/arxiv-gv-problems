+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Mesh Stripification, Section (B), page 9: a one-strip quadrilateral "
+        "mesh is represented as a Hamiltonian cycle of its face-adjacency graph."
+    ),
