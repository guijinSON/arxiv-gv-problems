+STRUCTURAL_HINT = (
+    "Regroup rows by their displayed coordinate tuples and invert the repeated "
+    "three-way tensor transform one axis at a time."
+)
+PLACEBO_HINT = (
+    "Organize every displayed rational carefully and check the selected "
