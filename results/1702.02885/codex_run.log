+        ref_success += int(candidate is not None and verify(inst, candidate)[0])
+    all_failed = all(v["successes"] == 0 and v["attempts"] >= 8
+                     for v in attacks.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and ref_success == 8,
