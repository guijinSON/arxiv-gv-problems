+        not isinstance(n, int)
+        or not isinstance(delta, int)
+        or not isinstance(degree, int)
+        or degree != n * delta
+        or len(points) != n
+        or modulus.bit_length() - 1 != degree
+        or any(not (0 < a < (1 << degree)) for a in points)
+    ):
