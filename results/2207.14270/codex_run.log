+    for start in range(0, degree, 8):
+        atoms = shifts[start : start + 8]
+        table = [0] * 256
+        for v in range(1, 256):
+            low = v & -v
+            bit = low.bit_length() - 1
+            table[v] = table[v ^ low] ^ (atoms[bit] if bit < len(atoms) else 0)
+        chunks.append(tuple(table))
+    return tuple(chunks)
