+    if len(set(exponents)) != len(exponents):
+        return None, "exponents must be distinct"
+    if exponents != sorted(exponents):
+        return None, "terms must be strictly increasing"
+    if pairs[-1] != (n, 1):
+        return None, "leading term must be monic of degree n"
