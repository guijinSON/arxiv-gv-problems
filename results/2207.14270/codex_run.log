+    # A genuinely in-context partial-norm ansatz that stops after two factors.
+    partial = _gf_mul(
+        points[0], _sigma(points[0], delta, degree, modulus), degree, modulus
+    )
+    attacks["by_hand_two_factor_norm"] = [_binomial(inst, partial)]
