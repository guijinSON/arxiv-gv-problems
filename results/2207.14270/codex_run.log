+
+
+def _fixed_multiplier_tables(value, degree, modulus):
+    shifts = []
+    current = value
+    mask = (1 << degree) - 1
+    low_modulus = modulus & mask
+    for _ in range(degree):
+        shifts.append(current)
+        carry = current >> (degree - 1)
+        current = (current << 1) & mask
+        if carry:
+            current ^= low_modulus
