+@functools.lru_cache(maxsize=64)
+def _p_independent_rank(points, n, delta, degree, modulus):
+    columns = []
+    for point in points:
+        col = [1]
+        partial_norm = 1
+        conjugate = point
+        for j in range(1, n):
