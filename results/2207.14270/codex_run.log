+        _sigma(c, delta, degree, modulus),
+        _gf_inv(c, degree, modulus),
+        degree,
+        modulus,
+    )
+    transformed = [
+        _sigma(_gf_mul(norm_one_multiplier, p, degree, modulus), delta, degree, modulus)
+        for p in points
+    ]
+    rng.shuffle(transformed)
+    out = dict(inst)
+    out["points"] = [_field_hex(p, degree) for p in transformed]
+    return out
