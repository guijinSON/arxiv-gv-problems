import json
import gen_2505_00298 as g
checks=[]
for name,p in g.DIFFICULTY.items():
    for seed in (0,1,2):
        x=g.make_instance(seed=seed,**p)
        ok,why=g.verify(x,x['answer'])
        native=json.loads(json.dumps(x['answer']))==x['answer']
        checks.append((name,seed,ok,native,why))
print('G1_recheck',sum(ok and native for _,_,ok,native,_ in checks),'/',len(checks))
print('escalated',g.verify((y:=g.make_instance(seed=9,**g.escalate(g.DIFFICULTY['hard']))),y['answer']))
