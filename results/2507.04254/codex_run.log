+def _is_prime(value):
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    limit = math.isqrt(value)
+    divisor = 3
+    while divisor <= limit:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(value):
+    candidate = max(2, int(value))
+    while not _is_prime(candidate):
+        candidate += 1
+    return candidate
+
+
+def _normalise_residue_set(values, p):
+    """Affine normal form of a subset of F_p, for generated-family keys."""
+    base = tuple(sorted(set(int(x) % p for x in values)))
+    if not base:
+        return ()
+    best = None
+    for scale in range(1, p):
+        for shift in range(p):
+            image = tuple(sorted((scale * x + shift) % p for x in base))
+            if best is None or image < best:
+                best = image
+    return best
+
+
+def _coordinate_adjacency(component, p):
+    left = component["left_coords"]
+    right = component["right_coords"]
+    adjacency = {u: [] for u in range(p)}
+    for left_id, right_id in component["edges"]:
+        adjacency[left[left_id]].append(right[right_id])
+    return adjacency
+
+
+def _recover_component_slope(component, p):
+    """Recover the translation N(1)-N(0), without consulting an answer."""
+    adjacency = _coordinate_adjacency(component, p)
+    n0 = adjacency[0]
+    n1 = adjacency[1]
+    if not n0 or len(n0) != len(n1):
+        return None, 0
+    counts = Counter((b - a) % p for a in n0 for b in n1)
+    best_count = max(counts.values(), default=0)
+    winners = [shift for shift, count in counts.items() if count == best_count]
+    if len(winners) != 1 or best_count != len(n0):
+        return None, len(n0) * len(n1)
+    return winners[0], len(n0) * len(n1)
