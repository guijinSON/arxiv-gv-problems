+        "parsed_equals_answer": parsed == inst["answer"],
+        "garbage_returns_none": parse_answer("not an answer") is None,
+    }
+
+    # G4/G5 shipping density sample, uniformly over the constrained language.
+    guess_rng = random.Random(20260905)
