+# three arms are diagnostics; G9(c)'s size/operation caps are the only gate.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 3, "service_errors": 0},
+    "hinted": {"solved": 0, "attempts": 3, "service_errors": 0},
