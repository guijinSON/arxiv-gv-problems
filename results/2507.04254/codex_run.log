def _edge(a, b):
    if a == b:
        raise ValueError("a tree edge cannot be a loop")
    return [a, b] if a < b else [b, a]


def _sorted_edges(edges):
    return sorted((_edge(int(a), int(b)) for a, b in edges), key=lambda e: (e[0], e[1]))


def _caterpillar_edges(order):
    """Return the binary caterpillar whose leaf order is ``order``."""
    n = len(order)
    if n < 4:
        raise ValueError("a nontrivial binary caterpillar needs at least 4 leaves")
    spine = list(range(n, 2 * n - 2))
    edges = [
        _edge(order[0], spine[0]),
        _edge(order[1], spine[0]),
        _edge(order[-2], spine[-1]),
        _edge(order[-1], spine[-1]),
    ]
    for i in range(len(spine) - 1):
        edges.append(_edge(spine[i], spine[i + 1]))
    for leaf_index in range(2, n - 2):
        edges.append(_edge(order[leaf_index], spine[leaf_index - 1]))
    return _sorted_edges(edges)


def _caterpillar_newick(order):
    """Encode the binary caterpillar in unrooted Newick notation."""
    if len(order) < 4:
        raise ValueError("a nontrivial binary caterpillar needs at least 4 leaves")
    tail = f"({order[-2]},{order[-1]})"
    for leaf in reversed(order[2:-2]):
        tail = f"({leaf},{tail})"
    return f"({order[0]},{order[1]},{tail});"


def _adjacency_to_newick(adjacency, n, root=None, rng=None):
    """Serialize an unrooted binary adjacency structure, without branch lengths."""
    internal = [v for v in range(n, len(adjacency)) if adjacency[v]]
    if not internal:
        raise ValueError("tree has no internal vertex")
    root = internal[0] if root is None else root
    if root not in internal:
        raise ValueError("Newick root must be an internal vertex")

    def visit(vertex, parent):
        if vertex < n:
            return str(vertex)
        parts = [visit(child, vertex) for child in adjacency[vertex]
                 if child != parent]
        if rng is None:
            parts.sort()
        else:
            rng.shuffle(parts)
        return "(" + ",".join(parts) + ")"

    return visit(root, -1) + ";"


def _parse_newick(answer, n):
    """Parse the module's exact, branch-length-free unrooted Newick grammar."""
    if not isinstance(answer, str):
        return False, "answer must be a Newick string", None
    if not answer.strip():
        return False, "answer is empty", None

    class NewickFailure(Exception):
        pass

    text = answer
    position = 0
    next_internal = n
    adjacency = {leaf: set() for leaf in range(n)}
    seen_taxa = set()
    arities = {}

    def skip_space():
        nonlocal position
        while position < len(text) and text[position].isspace():
            position += 1

    def connect(a, b):
        adjacency.setdefault(a, set()).add(b)
        adjacency.setdefault(b, set()).add(a)

    def parse_node():
        nonlocal position, next_internal
        skip_space()
        if position >= len(text):
            raise NewickFailure("malformed Newick: unexpected end of input")
        if text[position] == "(":
            position += 1
            children = [parse_node()]
            while True:
                skip_space()
                if position >= len(text):
                    raise NewickFailure("malformed Newick: missing ')'")
                if text[position] == ",":
                    position += 1
                    children.append(parse_node())
                    continue
                if text[position] == ")":
                    position += 1
                    break
                raise NewickFailure(
                    f"malformed Newick: expected ',' or ')' at character {position}"
                )
            vertex = next_internal
            next_internal += 1
            adjacency[vertex] = set()
            arities[vertex] = len(children)
            for child in children:
                connect(vertex, child)
            return vertex
        if not text[position].isdigit():
            raise NewickFailure(
                f"malformed Newick: expected a taxon at character {position}"
            )
        end = position + 1
        while end < len(text) and text[end].isdigit():
            end += 1
        taxon = int(text[position:end])
        position = end
        if not 0 <= taxon < n:
            raise NewickFailure(f"taxon {taxon} is outside 0..{n - 1}")
        if taxon in seen_taxa:
            raise NewickFailure(f"taxon {taxon} appears more than once")
        seen_taxa.add(taxon)
        return taxon

    try:
        root = parse_node()
        skip_space()
        if position >= len(text) or text[position] != ";":
            raise NewickFailure("malformed Newick: missing final semicolon")
        position += 1
        skip_space()
        if position != len(text):
            raise NewickFailure(
                f"malformed Newick: trailing text at character {position}"
            )
        if root < n:
            raise NewickFailure("the Newick root must be an internal group")
        if len(seen_taxa) != n:
            raise NewickFailure(
                f"wrong taxon count: expected {n}, got {len(seen_taxa)}"
            )
        if arities.get(root) != 3:
            raise NewickFailure(
                f"outer Newick group has arity {arities.get(root)}, not 3"
            )
        for vertex, arity in arities.items():
            if vertex != root and arity != 2:
                raise NewickFailure(
                    f"an inner Newick group has arity {arity}, not 2"
                )
        if len(arities) != n - 2:
            raise NewickFailure(
                f"wrong internal-group count: expected {n - 2}, got {len(arities)}"
            )
    except NewickFailure as exc:
        return False, str(exc), None

    packed = [sorted(adjacency.get(v, ())) for v in range(next_internal)]
    for leaf in range(n):
        if len(packed[leaf]) != 1:
            return False, f"taxon {leaf} has degree {len(packed[leaf])}, not 1", None
    for vertex in range(n, next_internal):
        if len(packed[vertex]) != 3:
            return False, (
                f"internal vertex {vertex - n + 1} has degree "
                f"{len(packed[vertex])}, not 3"
            ), None
    return True, "ok", packed


def _normalize_mask(mask, n):
    full = (1 << n) - 1
    other = full ^ mask
    left_size = mask.bit_count()
    right_size = n - left_size
    if left_size < right_size:
        return mask
    if right_size < left_size:
        return other
    return min(mask, other)



def _mask_to_side(mask, n):
    return [i for i in range(n) if (mask >> i) & 1]


def _side_to_mask(side, n):
    mask = 0
    for value in side:
        mask |= 1 << value
    return _normalize_mask(mask, n)


def _plant_splits(order):
    n = len(order)
    prefix = 0
    out = []
    for i, leaf in enumerate(order):
        prefix |= 1 << leaf
        if 1 <= i <= n - 3:
            out.append(_normalize_mask(prefix, n))
    if len(out) != n - 3 or len(set(out)) != n - 3:
        raise AssertionError("caterpillar split construction failed")
    return out


def _regular_masks(m, keep, rng):
    """Balanced incidence: each row and column has exactly ``keep`` ones."""
    # Randomly conjugated cyclic matchings give a simple regular bipartite
    # design without rejection sampling or a rare fallback path.
    columns = list(range(m))
    rng.shuffle(columns)
    shifts = rng.sample(range(m), keep)
    rows = [
        {columns[(row + shift) % m] for shift in shifts}
        for row in range(m)
    ]
    return [sorted(row) for row in rows]


def _choose_affine_order(n, rng):
    units = [a for a in range(2, n - 1) if math.gcd(a, n) == 1]
    if not units:
        raise ValueError("n must admit a nontrivial unit modulo n")
    step = rng.choice(units)
    origin = rng.randrange(n)
    return [(origin + step * i) % n for i in range(n)]


def make_instance(n, seed=0, **params):
    """Inverse-generate a compatible profile and its supertree certificate."""
    if type(n) is not int or n < 7:
        raise ValueError("n must be an integer at least 7")
    groups = int(params.get("groups", 1))
    keep = int(params.get("keep", 3))
    m = n - 3
    if groups < 1:
        raise ValueError("groups must be positive")
    if keep < 1 or keep > m:
        raise ValueError("keep must lie between 1 and n-3")

    rng = random.Random(seed)
    order = _choose_affine_order(n, rng)
    split_masks = _plant_splits(order)

    trees = []
    for _ in range(groups):
        for columns in _regular_masks(m, keep, rng):
            sides = [_mask_to_side(split_masks[column], n) for column in columns]
            rng.shuffle(sides)
            trees.append(sides)
    rng.shuffle(trees)

    return {
        "paper": "1210.3762",
        "n": n,
        "groups": groups,
        "keep": keep,
        "trees": trees,
        "answer": _caterpillar_newick(order),
    }


def _shape_and_adjacency(answer, n):
    return _parse_newick(answer, n)


def _edges_to_adjacency(edges, n):
    adjacency = [[] for _ in range(2 * n - 2)]
    for a, b in edges:
        adjacency[a].append(b)
        adjacency[b].append(a)
    return adjacency


def _splits_from_adjacency(adjacency, n):
    """Extract all nontrivial edge splits in one rooted postorder traversal."""
    parent = [-1] * len(adjacency)
    parent[0] = 0
    order = [0]
    for here in order:
        for there in adjacency[here]:
            if parent[there] == -1:
                parent[there] = here
                order.append(there)
    masks = [0] * len(adjacency)
    for vertex in reversed(order):
        mask = (1 << vertex) if vertex < n else 0
        for there in adjacency[vertex]:
            if parent[there] == vertex:
                mask |= masks[there]
        masks[vertex] = mask
    splits = set()
    for vertex in order[1:]:
        mask = masks[vertex]
        size = mask.bit_count()
        if 2 <= size <= n - 2:
            splits.add(_normalize_mask(mask, n))
    return splits


def _required_masks(inst):
    n = inst["n"]
    return {
        _side_to_mask(side, n)
        for tree in inst["trees"]
        for side in tree
    }


def verify(inst, answer):
    """Accept any binary supertree displaying the whole profile."""
    n = inst.get("n")
    if type(n) is not int or n < 4:
        return False, "malformed instance taxon count"
    ok, reason, adjacency = _shape_and_adjacency(answer, n)
    if not ok:
        return False, reason
    candidate_splits = _splits_from_adjacency(adjacency, n)
    for tree_index, tree in enumerate(inst["trees"], 1):
        for side in tree:
            split = _side_to_mask(side, n)
            if split not in candidate_splits:
                return False, (
                    f"candidate does not display T{tree_index}'s split "
                    f"{json.dumps(side, separators=(',', ':'))}"
                )
    return True, "ok"


def render(inst):
    n = inst["n"]
    split_word = "split" if inst["keep"] == 1 else "splits"
    lines = [
        "SUPERTREE COMPATIBILITY (unrooted phylogenetic trees)",
        "",
        f"The taxon set is X = {{0,1,...,{n - 1}}}.",
        "An unrooted phylogenetic tree is a connected acyclic graph whose taxa "
        "are exactly its degree-1 vertices; unlabeled internal vertices have "
        "degree at least 3.",
        "Removing an edge partitions X into two nonempty sides; this unordered "
        "bipartition is the edge's split.  Singleton splits are trivial.",
        "Each input tree below has the full taxon set X and is specified exactly "
        "by all of its nontrivial edge splits.  For compactness only one side A "
        "is listed as a JSON integer list; its other side is X\\A.  The order of "
        "splits and of taxa inside a side has no meaning.",
        "A candidate tree displays an input tree precisely when it contains every "
        "listed split of that input tree (extra splits are allowed).",
        "",
        f"Profile: {len(inst['trees'])} trees; each line has "
        f"{inst['keep']} {split_word}.",
    ]
    for index, tree in enumerate(inst["trees"], 1):
        encoded = " ; ".join(json.dumps(side, separators=(",", ":")) for side in tree)
        lines.append(f"T{index}: {encoded}")
    lines.extend([
        "",
        "Find any unrooted binary phylogenetic tree that displays every input "
        "tree.  Write it in branch-length-free Newick notation, rooted for "
        "notation at any internal vertex.  The outer parenthesized group must "
        "have exactly three comma-separated children and every other group "
        "exactly two.  Each taxon 0 through " + str(n - 1) + " must occur exactly "
        "once, no other labels are allowed, child order is irrelevant, and a "
        "semicolon must terminate the expression.",
        "",
        "Give your final answer inside <answer></answer> tags as one Newick expression.",
        "Four-taxon syntax example: <answer>(0,1,(2,3));</answer>",
        "That example only illustrates the grammar; your answer must contain "
        f"all {n} taxa for this instance.",
        "Output nothing else inside the tags.",
    ])
    mode = os.environ.get("GV_HINT_MODE")
    if mode == "structural":
        lines.extend(["", "Hint: " + STRUCTURAL_HINT])
    elif mode == "placebo":
        lines.extend(["", "Hint: " + PLACEBO_HINT])
    return "\n".join(lines)


def parse_answer(text):
    if not isinstance(text, str):
        return None
    match = re.search(r"<answer\b[^>]*>(.*?)</answer>", text, re.I | re.S)
    if not match:
        return None
    payload = match.group(1).strip()
    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", payload, re.I | re.S)
    if fence:
        payload = fence.group(1).strip()
    # Also accept a JSON-quoted Newick string; emitters often use json.dumps for
    # realistic round-trip tests even though the advertised format is raw Newick.
    if payload.startswith('"'):
        try:
            payload = json.loads(payload)
        except (TypeError, ValueError):
            return None
        if not isinstance(payload, str):
            return None
        payload = payload.strip()
    if not (payload.startswith("(") and payload.endswith(";")):
        return None
    if re.search(r"[^0-9(),;\s]", payload):
        return None
    return payload


def _double_factorial_odd(value):
    result = 1
    for factor in range(value, 0, -2):
        result *= factor
    return result


def search_space(inst):
    return _double_factorial_odd(2 * inst["n"] - 5)


def random_candidate(inst, rng):
    """Uniformly sample an unrooted binary leaf-labeled topology."""
    n = inst["n"]
    center = n
    edges = [[0, center], [1, center], [2, center]]
    for leaf in range(3, n):
        chosen = rng.randrange(len(edges))
        a, b = edges.pop(chosen)
        internal = n + leaf - 2
        # Endpoint order is explicitly irrelevant to the certificate language.
        edges.extend(([a, internal], [b, internal], [leaf, internal]))
    adjacency = _edges_to_adjacency(edges, n)
    # Root where at most one incident branch is a taxon.  Then every cherry is
    # serialized literally as ``(a,b)``, which permits an exact cheap necessary
    # filter in the 200,000-sample G4 run without changing the distribution.
    root = min(v for v in range(n, 2 * n - 2)
               if sum(child < n for child in adjacency[v]) <= 1)
    return _adjacency_to_newick(adjacency, n, root=root)


def _enumerated_topologies(n):
    def extend(leaf, edges):
        if leaf == n:
            adjacency = _edges_to_adjacency(edges, n)
            yield _adjacency_to_newick(adjacency, n)
            return
        internal = n + leaf - 2
        for index, (a, b) in enumerate(edges):
            nxt = edges[:index] + edges[index + 1:]
            nxt = nxt + [_edge(a, internal), _edge(b, internal), _edge(leaf, internal)]
            yield from extend(leaf + 1, nxt)

    start = [_edge(0, n), _edge(1, n), _edge(2, n)]
    yield from extend(3, start)


def enumerate_all(inst):
    if inst["n"] > 8:
        return None
    return sum(1 for candidate in _enumerated_topologies(inst["n"])
               if verify(inst, candidate)[0])


def canonical_key(inst):
    """Canonicalize the split-incidence path up to relabeling and reversal."""
    n = inst["n"]
    masks = sorted(_required_masks(inst))
    if len(masks) != n - 3:
        # Outside the generated family, retain a deterministic strong invariant.
        fallback = sorted(
            tuple(sorted((_side_to_mask(side, n).bit_count() for side in tree)))
            for tree in inst["trees"]
        )
        blob = json.dumps({"n": n, "fallback": fallback}, separators=(",", ":"))
        return hashlib.sha256(blob.encode("utf-8")).hexdigest()

    full = (1 << n) - 1

    def middle_size(a, b):
        ac, bc = full ^ a, full ^ b
        opposite_blocks = (
            (a & b, ac & bc),
            (a & bc, ac & b),
        )
        for first, opposite in opposite_blocks:
            if not first:
                return opposite.bit_count()
            if not opposite:
                return first.bit_count()
        return None

    neighbors = {mask: [] for mask in masks}
    for i, first in enumerate(masks):
        for second in masks[i + 1:]:
            if middle_size(first, second) == 1:
                neighbors[first].append(second)
                neighbors[second].append(first)
    endpoints = sorted(mask for mask in masks if len(neighbors[mask]) == 1)
    if len(endpoints) != 2 or any(len(neighbors[mask]) not in (1, 2) for mask in masks):
        fallback = sorted(
            tuple(sorted((_side_to_mask(side, n).bit_count() for side in tree)))
            for tree in inst["trees"]
        )
        blob = json.dumps({"n": n, "fallback": fallback}, separators=(",", ":"))
        return hashlib.sha256(blob.encode("utf-8")).hexdigest()

    path = []
    previous = None
    current = endpoints[0]
    while current is not None:
        path.append(current)
        following = [mask for mask in neighbors[current] if mask != previous]
        previous, current = current, (following[0] if following else None)
    if len(path) != len(masks):
        raise ValueError("generated split-adjacency structure is not a path")

    def incidence(order):
        position = {mask: index for index, mask in enumerate(order)}
        return sorted(
            tuple(sorted(position[_side_to_mask(side, n)] for side in tree))
            for tree in inst["trees"]
        )

    forward = incidence(path)
    backward = incidence(list(reversed(path)))
    structural = {
        "n": n,
        "split_path_incidence": min(forward, backward),
    }
    blob = json.dumps(structural, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def escalate(params):
    """Increase profile crowding while leaving the 128-taxon witness fixed."""
    n = int(params["n"])
    groups = int(params.get("groups", 1))
    keep = int(params.get("keep", 4))
    return {"n": n, "groups": groups * 2, "keep": keep}


def _compatible(a, b, n):
    full = (1 << n) - 1
    ac = full ^ a
    bc = full ^ b
    return not (a & b) or not (a & bc) or not (ac & b) or not (ac & bc)


def _component_leaf_mask(adjacency, start, blocked, n):
    mask = 0
    stack = [start]
    seen = {blocked}
    while stack:
        here = stack.pop()
        if here in seen:
            continue
        seen.add(here)
        if here < n:
            mask |= 1 << here
        stack.extend(adjacency[here])
    return mask


def _tree_from_splits(split_masks, n, refine=False):
    """Splits-Equivalence reconstruction, optionally resolving all polytomies."""
    full = (1 << n) - 1
    root_bit = 1
    universe = full ^ root_bit
    clusters = set()
    for split in split_masks:
        cluster = (full ^ split) if (split & root_bit) else split
        clusters.add(cluster)
    clusters.add(universe)
    ordered = sorted(clusters, key=lambda x: (x.bit_count(), x))
    ids = {cluster: n + i for i, cluster in enumerate(ordered)}
    adjacency = {i: set() for i in range(n + len(ordered))}

    def connect(a, b):
        adjacency.setdefault(a, set()).add(b)
        adjacency.setdefault(b, set()).add(a)

    connect(0, ids[universe])
    for leaf in range(1, n):
        bit = 1 << leaf
        parent = min((c for c in ordered if c & bit), key=lambda c: c.bit_count())
