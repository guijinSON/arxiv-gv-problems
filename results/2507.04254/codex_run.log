+    degree_inverse = pow(inst["degree"], -1, p)
+    guesses = []
+    for component in inst["components"]:
+        adjacency = _coordinate_adjacency(component, p)
+        slope = (sum(adjacency[1]) - sum(adjacency[0])) * degree_inverse % p
+        guesses.append([slope or 1, 0])
+    return guesses
