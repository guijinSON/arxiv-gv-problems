+    return {
+        "paper": "2507.04254",
+        "requested_n": n,
+        "p": p,
+        "modulus": modulus,
+        "colours": colours,
+        "degree": degree,
+        "components": built,
+        "answer": parameters,
+    }
+
+
+def _validate_instance_shape(inst):
+    try:
+        p = inst["p"]
+        modulus = inst["modulus"]
