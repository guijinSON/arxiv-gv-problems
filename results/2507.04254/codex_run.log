+        compact_operations.append(operations)
+        compact_successes += int(verify(sample, recovered)[0])
+
+    attacks = {
+        name: {
+            "successes": attack_totals[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_times[name], 6),
