+        "swap_two": [answer[1], answer[0]] + answer[2:],
+        "duplicate_one": answer[:-1] + [answer[0]],
+        "empty": [],
+        "out_of_range": [0] + answer[1:],
+    }
+    cases = {}
+    reasons = set()
+    for name, candidate in corruptions.items():
