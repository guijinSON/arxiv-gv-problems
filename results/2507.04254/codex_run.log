+        right_degrees = [0] * p
+        for edge in edges:
+            if (not isinstance(edge, list) or len(edge) != 2
+                    or type(edge[0]) is not int or type(edge[1]) is not int
+                    or not 0 <= edge[0] < p or not 0 <= edge[1] < p):
+                return False, f"component {index} contains a malformed edge"
