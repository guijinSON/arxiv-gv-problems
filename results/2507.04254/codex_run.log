+        "diagnostic_evidence_ready": diagnostic_ready,
+        "hinted_minus_placebo": hinted_minus_placebo,
+        "hinted_verdict": G9_ORACLE_RESULTS.get("hinted_verdict", "not run"),
+        "answer_chars": answer_chars,
