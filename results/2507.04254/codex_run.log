+            if type(colour) is not int or not 0 <= colour < colours:
+                return False, f"edge color at position {cursor} is outside 0..{colours - 1}"
+            used.add(colour)
+            left_degrees[colour][left_id] += 1
+            right_degrees[colour][right_id] += 1
