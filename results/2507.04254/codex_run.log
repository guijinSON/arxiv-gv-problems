+        "pass": not failures,
+        "attempts": attempts,
+        "failures": failures,
+        "construction": "inverse-generated affine perfect matchings bundled k+1 at a time",
+    }
+
+    shipping_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    inst = make_instance(seed=314159, **shipping_params)
+
+    # G2: five materially different corruptions and five distinct diagnostics.
+    answer = list(inst["answer"])
+    corruptions = {
