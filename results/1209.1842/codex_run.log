+
+TRACK: str = "B"
+
+STRUCTURAL_HINT: str = (
+    "The audit-word XOR is the invariant linking the exclusive alternatives "
+    "at all root matrices."
+)
+PLACEBO_HINT: str = (
+    "The hexadecimal row order is the notation linking the displayed entries "
+    "at all root matrices."
+)
+
