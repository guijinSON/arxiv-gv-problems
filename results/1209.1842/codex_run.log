+        "B" if (mask >> j) & 1 else "A" for j in range(len(inst["roots"]))
+    ]
+    answer = _propagate_from_roots(inst, root_letters)
+    operations = (
+        len(inst["audit_words"]) - 1
+        + len(inst["roots"])
+        + len(inst["relations"])
