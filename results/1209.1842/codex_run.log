+    doubled["matrix_size"] = ship_params["matrix_size"] * 2
+    doubled_inst = make_instance(seed=44, **doubled)
+    doubled_ok, doubled_reason = verify(doubled_inst, doubled_inst["answer"])
+    report["G7_scales"] = {
