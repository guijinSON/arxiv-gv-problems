+    ids = list(range(n))
+    rng.shuffle(ids)
+    root_ids = ids[:roots_count]
+    roots = []
+    for j, root_id in enumerate(root_ids):
+        roots.append(
+            {
+                "id": root_id,
+                "rows": _exclusive_root(matrix_size, root_letters[j], rng),
+            }
+        )
