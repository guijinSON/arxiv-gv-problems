+def render(inst) -> str:
+    matrix_size = inst["matrix_size"]
+    width = matrix_size // 4
+    lines = [
+        "BINARY-MATRIX ALTERNATIVE CERTIFICATE",
+        "",
+        "A binary matrix has entries only in {0,1}.  For every matrix M, label:",
