+
+def _rotate_bits(value, shift, width):
+    shift %= width
+    mask = (1 << width) - 1
+    if shift == 0:
+        return value & mask
+    return ((value << shift) | (value >> (width - shift))) & mask
+
+
+def _transform_instance(inst, block_permutation=None, row_shift=0, col_shift=0):
+    """Relabel blocks and cyclically relabel every explicit root's rows/columns."""
+    out = copy.deepcopy(inst)
+    n = inst["n"]
+    if block_permutation is None:
+        block_permutation = list(range(n))
+    if sorted(block_permutation) != list(range(n)):
+        raise ValueError("block_permutation is not a permutation")
