+        pending = dict(by_child)
+        while pending:
+            progress = False
+            for child, relation in list(pending.items()):
+                if relation["parent"] not in location:
+                    continue
+                root_id, parity = location[relation["parent"]]
+                location[child] = (root_id, parity ^ (relation["kind"] == "F"))
+                del pending[child]
+                progress = True
+            if not progress:
+                return "malformed"
