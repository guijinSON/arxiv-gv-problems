import random, math, statistics, time

def add_edge(adj,u,v):
    if u==v or v in adj[u]: return False
    adj[u].add(v);adj[v].add(u);return True

def regular_graph(n,d,rng,switch_factor=20):
    assert d<n and n*d%2==0
    adj=[set() for _ in range(n)]
    h=d//2
    for u in range(n):
        for delta in range(1,h+1): add_edge(adj,u,(u+delta)%n)
    if d%2: 
        for u in range(n//2): add_edge(adj,u,u+n//2)
    edges=[(u,v) for u in range(n) for v in adj[u] if u<v]
    for _ in range(switch_factor*len(edges)):
        i,j=rng.randrange(len(edges)),rng.randrange(len(edges))
        if i==j:continue
        a,b=edges[i];c,e=edges[j]
        if len({a,b,c,e})<4: continue
        if rng.randrange(2): c,e=e,c
        if e in adj[a] or b in adj[c]: continue
        adj[a].remove(b);adj[b].remove(a);adj[c].remove(e);adj[e].remove(c)
        adj[a].add(e);adj[e].add(a);adj[c].add(b);adj[b].add(c)
        edges[i]=(min(a,e),max(a,e));edges[j]=(min(c,b),max(c,b))
    return adj

def make(seed,w=24,d=30,cross_o=2):
    rng=random.Random(seed); cross_d=d-5
    no=w*cross_d//cross_o; assert no*cross_o==w*cross_d
    D=regular_graph(w,d-cross_d,rng)
    O=regular_graph(no,d-cross_o,rng)
    adj=[set() for _ in range(w+no)]
    for u in range(w):
        for v in D[u]: adj[u].add(v)
    for u in range(no):
        for v in O[u]: adj[w+u].add(w+v)
    os=list(range(no));rng.shuffle(os);pos=0
    for rr in range(cross_d):
        ds=list(range(w));rng.shuffle(ds)
        for j in range(0,w,2):
            o=os[pos];pos+=1
            a,b=ds[j],ds[j+1]
            adj[a].add(w+o);adj[b].add(w+o);adj[w+o].add(a);adj[w+o].add(b)
    perm=list(range(w+no));rng.shuffle(perm)
    A=[set() for _ in perm]
    for u in range(len(adj)):
        for v in adj[u]:A[perm[u]].add(perm[v])
    ans=sorted(perm[:w])
    return A,ans

def verify(A,S):
    cov=set(S)
    for x in S: cov |= A[x]
    return len(cov)==len(A)

def greedy(A,k):
    n=len(A);unc=set(range(n));sel=[]
    closed=[a|{i} for i,a in enumerate(A)]
    while unc and len(sel)<k:
        v=max((i for i in range(n) if i not in sel),key=lambda i:(len(closed[i]&unc),-i))
        sel.append(v);unc-=closed[v]
    return sel,not unc

def local(A,k,mode):
    def triangles(u): return sum(v in A[x] for i,x in enumerate(A[u]) for v in list(A[u])[i+1:])
    def neigh_edges(u):
        ns=A[u];return sum(v in A[x] for x in ns for v in ns)//2
    score=[neigh_edges(i) for i in range(len(A))]
    order=sorted(range(len(A)),key=lambda i: score[i], reverse=(mode=='high'))
    return order[:k],score

for seed in range(8):
    A,ans=make(seed)
    g,ok=greedy(A,24)
    lo,sc=local(A,24,'low');hi,_=local(A,24,'high')
    # plant score rank stats
    ranks={v:i for i,v in enumerate(sorted(range(len(A)),key=lambda i:sc[i]))}
    print(seed,len(A),verify(A,ans),ok,len(g),verify(A,lo),verify(A,hi),statistics.mean(ranks[v] for v in ans),min(sc[v] for v in ans),max(sc[v] for v in ans),statistics.mean(sc))
