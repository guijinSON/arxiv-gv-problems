+        relation["child"] = mapping[relation["child"]]
+        relation["parent"] = mapping[relation["parent"]]
+    carried = [None] * n
+    for old, letter in enumerate(inst["answer"]):
+        carried[mapping[old]] = letter
+    out["answer"] = "".join(carried)
+    return out
