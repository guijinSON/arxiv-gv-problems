+    + PROBLEM_PROFILE["intuition_description"],
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+
+DIFFICULTY: dict = {
+    "demo": {"n": 8, "roots": 3, "matrix_size": 8, "audit_count": 4},
+    "easy": {"n": 96, "roots": 20, "matrix_size": 32, "audit_count": 32},
+    "medium": {"n": 160, "roots": 24, "matrix_size": 40, "audit_count": 32},
+    "hard": {"n": 240, "roots": 32, "matrix_size": 48, "audit_count": 32},
