+    "easy": {"n": 96, "roots": 16, "matrix_size": 32, "audit_count": 32},
+    "medium": {"n": 160, "roots": 24, "matrix_size": 40, "audit_count": 32},
+    "hard": {"n": 240, "roots": 32, "matrix_size": 48, "audit_count": 32},
+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
