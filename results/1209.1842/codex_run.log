+        and doubled["matrix_size"] > ship_params["matrix_size"],
+        "shipping_n": ship_params["n"],
+        "shipping_matrix_size": ship_params["matrix_size"],
+        "shipping_defined_matrix_bits": ship_params["n"] * ship_params["matrix_size"] ** 2,
+        "doubled_n": doubled["n"],
