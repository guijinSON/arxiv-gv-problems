+def _attack_low_nibble_checksum(inst):
+    low = 0
+    for word in inst["audit_words"]:
+        low ^= word & 0xF
+    guesses = []
+    for j in range(len(inst["roots"])):
+        if j < 4:
+            guesses.append("B" if (low >> j) & 1 else "A")
+        else:
+            guesses.append("B" if j % 2 else "A")
+    return _propagate_from_roots(inst, guesses)
