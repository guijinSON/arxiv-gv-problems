+        for offset, (name, attack) in enumerate(attack_names.items()):
+            candidate = attack(trial, random.Random(seed * 101 + offset))
+            attack_results[name]["successes"] += int(verify(trial, candidate)[0])
+        t0 = time.perf_counter()
