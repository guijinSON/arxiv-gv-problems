\section{Distance Between Vertices of Degree $>3$}



\begin{theorem}\label{distance5}
Suppose a combinatorial pentagonal tiling of the sphere has a vertex $\nu$ of degree $>3$, such that all vertices within distance $4$ of $\nu$ have degree $3$. Then the tiling is the earth map tiling in Figure \ref{map5}.
\end{theorem}



