/bin/bash -lc "python3 - <<'PY'
import random

def inst(n,seed,q):
 r=random.Random(seed); x=[0,r.randrange(1,q)]; y=r.sample(range(q),n); S=set(r.sample(range(q),n)); S.discard(0)
 while len(S)<n: S.add(r.randrange(1,q))
 edges=[]
 for i in range(2):
  for j in range(n):
   L=sorted((x[i]+y[j]+s)%q for s in S)
   edges.append((i,j,L))
 r.shuffle(edges)
 return x,y,S,edges

def verify(A,ans):
 usedu=[set(),set()]; usedw={}
 for c,(i,j,L) in zip(ans,A[3]):
  if c not in L or c in usedu[i] or c in usedw.setdefault(j,set()): return False
  usedu[i].add(c);usedw[j].add(c)
 return True

def greedy(A):
 usedu=[set(),set()];usedw={};ans=[]
 for i,j,L in A[3]:
  c=next((z for z in L if z not in usedu[i] and z not in usedw.setdefault(j,set())),None)
  if c is None:return None
  ans.append(c);usedu[i].add(c);usedw[j].add(c)
 return ans
for n,q in [(32,131),(64,521),(80,1009)]:
 ok=0
 for seed in range(100):
  A=inst(n,seed,q); g=greedy(A);ok+=g is not None and verify(A,g)
 print(n,ok)
