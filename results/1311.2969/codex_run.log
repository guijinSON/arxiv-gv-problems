import random

def make(seed,n=16,q=17,delete=4):
 r=random.Random(seed); xs=r.sample(range(q),n); ys=r.sample(range(q),n); S=set(r.sample(range(q),n)); pairs=[(i,j) for i in range(n) for j in range(n)]
 rem=set(r.sample(pairs,delete)); pairs=[z for z in pairs if z not in rem]; r.shuffle(pairs)
 edges=[]
 for i,j in pairs:
  L=set((xs[i]+ys[j]+s)%q for s in S)
  h=(i+j)%n
  edges.append((i,j,L,h))
 return edges

def kernel(edges, eligible, n, ops):
 # U rows propose, prefer higher h; W cols prefer lower h
 prefs={u:[] for u in range(n)}
 for ei in eligible:prefs[edges[ei][0]].append(ei)
 for u in prefs:prefs[u].sort(key=lambda e:edges[e][3],reverse=True)
 nexti={u:0 for u in prefs};free=[u for u in prefs if prefs[u]]; matchw={};matche={}
 while free:
  u=free.pop();
  while nexti[u]<len(prefs[u]):
   ei=prefs[u][nexti[u]];nexti[u]+=1;ops[0]+=1;w=edges[ei][1]
   if w not in matchw:
    matchw[w]=ei;matche[u]=ei;break
   old=matchw[w]
   # W prefers lower h
   if edges[ei][3] < edges[old][3]:
    old_u=edges[old][0];del matche[old_u];free.append(old_u);matchw[w]=ei;matche[u]=ei;break
  # if exhausted unmatched no readd
 return set(matche.values())

def solve(edges,n,q):
 un=set(range(len(edges)));ans=[None]*len(edges);ops=[0]
 for c in range(q):
  elig=[e for e in un if c in edges[e][2]];ops[0]+=len(un)
  K=kernel(edges,elig,n,ops)
  for e in K:ans[e]=c;un.remove(e);ops[0]+=1
 if un:return None,ops[0]
 return ans,ops[0]
def ver(edges,a,n):
 ur=[set() for _ in range(n)];uc=[set() for _ in range(n)]
 for c,e in zip(a,edges):
  i,j,L,h=e
  if c not in L or c in ur[i] or c in uc[j]:return False
  ur[i].add(c);uc[j].add(c)
 return True
for seed in range(100):
 E=make(seed);a,o=solve(E,16,17)
 if a is None or not ver(E,a,16):print('FAIL',seed,len(E),o);break
else: print('all ok',o,min(solve(make(s),16,17)[1] for s in range(100)),max(solve(make(s),16,17)[1] for s in range(100)))
