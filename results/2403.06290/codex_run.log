   266	%\begin{multline*}
   267	%\calA_{a}(S_X, W) = \{A\subseteq V(G) \setminus S_X \mid G[A] \mbox{ is connected, } N(S_X) \subseteq A, |A| = a,\\ \mbox{and}\ |(N(W) \cap S_X) \setminus X| + |W| + |A| + |N(A) \setminus S_X| \le k + 6 - |X| - |Y|\}.
