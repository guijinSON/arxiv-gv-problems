+    target_count = int(params.get("target_count", 8))
+    n = int(n)
+    if n < 3 or target_count < 1 or target_count >= n:
+        raise ValueError("require n >= 3 and 1 <= target_count < n")
+    if d < 4 or d % 2:
+        raise ValueError("d must be an even integer at least 4")
+    weight = d // 2
+    universe = math.comb(d, weight)
+    if universe < 4 * n:
+        raise ValueError("Hamming layer is too small for unbiased decoys")
+
+    rng = random.Random(seed)
+    x_masks = _draw_distinct_masks(rng, n, d, weight)
+    planted_x = rng.sample(range(n), target_count)
+    full = (1 << d) - 1
+    planted_y = [full ^ x_masks[i] for i in planted_x]
+
+    # A constant-weight y is orthogonal to a constant-weight x precisely when it
+    # is x's full complement.  Excluding all other complements therefore creates
+    # exactly the pairs sampled above, without solving the completed instance.
+    forbidden_y = {full ^ x for x in x_masks}
+    decoys = _draw_distinct_masks(
+        rng, n - target_count, d, weight, forbidden=forbidden_y
+    )
+    tagged_y = [(mask, None) for mask in decoys]
+    tagged_y += [(mask, x_index) for mask, x_index in zip(planted_y, planted_x)]
+    rng.shuffle(tagged_y)
+    y_masks = [item[0] for item in tagged_y]
+    answer = sorted(
+        [[x_index, j] for j, (_, x_index) in enumerate(tagged_y) if x_index is not None]
+    )
+
+    return {
+        "n": n,
+        "d": d,
+        "weight": weight,
+        "target_count": target_count,
+        "k": 2 * n + d - 2,
+        "X": x_masks,
+        "Y": y_masks,
+        "answer": answer,
+    }
+
+
+def _bits(mask: int, d: int) -> str:
+    # Coordinate z_0 is the leftmost displayed bit, even though it is bit 0 in
+    # the internal integer.  This makes the display agree literally with labels.
+    return "".join("1" if mask & (1 << c) else "0" for c in range(d))
+
