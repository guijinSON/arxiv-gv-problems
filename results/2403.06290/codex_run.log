    47	\begin{restatable}[]{thm}{fptalgocycle}
    48	\label{thm:fpt-algo-cycle}
    49	\textsc{Cycle Contraction} admits an algorithm running in time
    50	$\mathcal{O}^*((2 + \epsilon_{\ell})^k)$ where 
    51	$0 < \epsilon_{\ell}  \leq  0.5509$ and $\epsilon_\ell$ is inversely
    52	proportional to $\ell = n - k$. 
    53	\end{restatable}
    54	
    55	
    56	\noindent This also implies an exact exponential-time algorithm for \textsc{Cycle Contraction} that runs in $\mathcal{O}^*(2.5509^n)$ time. We further improve the running time to $\mathcal{O}^*(2.5191^n)$ (Theorem \ref{thm:exact-algo-cycle}). 
