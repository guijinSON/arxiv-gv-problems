   316	def parse_answer(text: str) -> object | None:
   317	    """Parse tagged JSON, with a conservative fenced/embedded JSON fallback."""
   318	    if not isinstance(text, str):
   319	        return None
   320	    bodies = re.findall(r"<answer\b[^>]*>(.*?)</answer>", text, flags=re.I | re.S)
   321	    candidates = list(reversed(bodies))
   322	    if not candidates:
   323	        candidates = [text]
   324	    decoder = json.JSONDecoder()
   325	    for body in candidates:
   326	        cleaned = re.sub(r"^\s*```(?:json)?\s*|\s*```\s*$", "", body.strip(), flags=re.I)
   327	        try:
   328	            return json.loads(cleaned)
   329	        except (TypeError, ValueError):
   330	            pass
   331	        for match in re.finditer(r"\[", cleaned):
   332	            try:
   333	                value, _ = decoder.raw_decode(cleaned[match.start() :])
   334	                return value
   335	            except ValueError:
   336	                continue
   337	    return None
