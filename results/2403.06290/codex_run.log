+    "answer_chars": 77,
+    "answer_elements": 16,
+    "answer_tokens": 20,
+    "arms": {
+      "bare": {
+        "attempts": 0,
+        "solved": 0
+      },
+      "hinted": {
+        "attempts": 0,
