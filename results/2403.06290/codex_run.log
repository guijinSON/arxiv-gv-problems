   477	def enumerate_all(inst: dict) -> int | None:
   478	    """Brute-force tiny presets only; never let diagnostic enumeration hang."""
   479	    space = search_space(inst)
   480	    if space > 200_000:
   481	        return None
   482	    n, t = inst["n"], inst["target_count"]
   483	    total = 0
   484	    for values in itertools.combinations(range(n * n), t):
   485	        candidate = [[value // n, value % n] for value in values]
   486	        if verify(inst, candidate)[0]:
   487	            total += 1
   488	    return total
