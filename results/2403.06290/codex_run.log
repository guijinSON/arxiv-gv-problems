   247	%\centering
   248	%\includegraphics[scale=.65]{images/path-contraction-fpt-solution-size.pdf}
   249	%\caption{(Left) $G$ is $k$-contractible to a path with witness structure $(W_1,W_2,\ldots,W_q)$. (Right) A potential $k'$-prefix set $S$, a potential $k'$-witness set $W$ and a new witness set $A$ that can be appended to a path witness structure of $G[S]$. \pt{Change $S$ to $S_X$.}}
   250	%\label{fig:path}
   251	%\end{figure}
   252	This brings us to the following notion of {\em potential $(S_X,W)$-attachments}. 
   253	%Informally, we call a set $A$ as an $(S_X,W)$-attachment if $A$ can be appended as a new witness set to the path witness structure of $G[S_X]$ 
   254	%that contains $W$ as the last witness set to obtain a path witness structure of $G[S_X \cup A]$.
   255	%For technical reasons, we introduce these potential attachments
   256	%for potential penultimate $k$-witness set and
   257	%internal $k$-witness set differently.
   258	
   259	%\begin{definition}[Potential $(S_X,W)$-penultimate-attachment]
   260	%\label{def:a-b}

