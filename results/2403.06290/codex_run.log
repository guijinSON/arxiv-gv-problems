   405	%\begin{itemize}
   406	%    \item $\Gamma[S_1, W, k_1]=\true$ and $\Gamma[S_2, W, k_2]=\true$. 
   407	%    \item $S_1 \setminus W$ and $S_2 \setminus W$ are the connected components of $G-W$ such that $X \subseteq S_1 \setminus W$ and $Y \subseteq S_2 \setminus W$.
