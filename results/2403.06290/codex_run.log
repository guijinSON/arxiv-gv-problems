%\begin{itemize}
%    \item $\Gamma[S_1, W, k_1]=\true$ and $\Gamma[S_2, W, k_2]=\true$. 
%    \item $S_1 \setminus W$ and $S_2 \setminus W$ are the connected components of $G-W$ such that $X \subseteq S_1 \setminus W$ and $Y \subseteq S_2 \setminus W$.
%    \item $k_1+k_2-(|W|-1)\leq k$.
%\end{itemize}
%$(G,X,Y,k)$ is a \yes-instance of \textsc{Path Contraction With Constrained Ends} if and only if there is a potential $k$-witness set $W$ such that $G[S_1 \cup W]$ is $k_1$-contractible to a path with witness structure $(W_1,\ldots,W_q=W)$ and $G[S_2 \cup W]$ is $k_2$-contractible to a path with witness structure $(W'_1,\ldots,W'_p=W)$ such that $p,q \geq 2$, $X \subseteq W_1$, $Y \subseteq W'_1$ and $k_1+k_2-(|W|+1)\leq k$ where $S_1$ and $S_2$ are the connected components of $G-W$. 
