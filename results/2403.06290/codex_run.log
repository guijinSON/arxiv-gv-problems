   429	def verify(inst: dict, answer: object) -> tuple[bool, str]:
   430	    """Accept every sorted set of the required number of valid endpoint pairs."""
   431	    if not isinstance(answer, list):
   432	        return False, "answer must be a JSON list"
   433	    if not answer:
   434	        return False, "answer is empty"
   435	    t, n = inst["target_count"], inst["n"]
   436	    if len(answer) != t:
   437	        return False, f"expected exactly {t} pairs"
   438	    pairs: list[tuple[int, int]] = []
   439	    for pos, pair in enumerate(answer):
   440	        if not isinstance(pair, list) or len(pair) != 2:
   441	            return False, f"entry {pos} is not a two-integer pair"
   442	        i, j = pair
   443	        if isinstance(i, bool) or isinstance(j, bool) or not isinstance(i, int) or not isinstance(j, int):
   444	            return False, f"entry {pos} contains a non-integer index"
   445	        if not (0 <= i < n and 0 <= j < n):
   446	            return False, f"entry {pos} has an index out of range"
   447	        pairs.append((i, j))
   448	    if len(set(pairs)) != len(pairs):
   449	        return False, "pairs must be distinct"
   450	    if pairs != sorted(pairs):
   451	        return False, "pairs must be lexicographically sorted"
   452	
   453	    graph = None
   454	    for i, j in pairs:
   455	        if inst["X"][i] & inst["Y"][j]:
   456	            return False, f"pair [{i},{j}] has intersecting coordinate neighborhoods"
   457	        if graph is None:
   458	            graph = _graph_adjacency(inst)
   459	            if len(graph) - 4 > inst["k"]:
   460	                return False, "the four-bag witness exceeds the contraction budget"
   461	        if not _is_p4_witness_pair(inst, i, j, graph):
   462	            return False, f"pair [{i},{j}] does not induce the required P4 quotient"
   463	    return True, "ok"
