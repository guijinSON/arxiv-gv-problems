    25	\begin{restatable}[]{thm}{pathEndsfptalgo}
    26	\label{thm:path-ends-fpt-algo}
    27	\textsc{Path Contraction With Constrained Ends} admits an algorithm
    28	running in time $\mathcal{O}^*(2^{k-|X|-|Y|})$.
    29	\end{restatable}
    30	
    31	
    32	\noindent Observe that \textsc{Path Contraction With Constrained Ends} when $X=\emptyset$ and $Y=\emptyset$ is \textsc{Path Contraction}. Therefore, we obtain an algorithm for \textsc{Path Contraction}.
