import importlib.util, random, time
p='gen_2403_06290.py'
s=importlib.util.spec_from_file_location('g',p); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
t0=time.perf_counter(); checked=0
for name,params in g.DIFFICULTY.items():
    for seed in range(50):
        inst=g.make_instance(seed=1000000+seed, **params)
        valid=sorted([i,j] for i,x in enumerate(inst['X']) for j,y in enumerate(inst['Y']) if not (x&y))
        compact,_=g._compact_pairs(inst)
        assert valid==compact==inst['answer'], (name,seed,valid,compact,inst['answer'])
        assert g.verify(inst,valid)==(True,'ok')
        checked+=1
