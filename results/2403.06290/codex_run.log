   406	def _is_p4_witness_pair(
   407	    inst: dict, i: int, j: int, adj: list[set[int]] | None = None
   408	) -> bool:
   409	    if inst["X"][i] & inst["Y"][j]:
   410	        return False
   411	    if adj is None:
   412	        adj = _graph_adjacency(inst)
   413	    bags = _bags_for_pair(inst, i, j)
   414	    universe = set(range(len(adj)))
   415	    if any(not bag for bag in bags):
   416	        return False
   417	    if set().union(*bags) != universe or sum(map(len, bags)) != len(universe):
   418	        return False
   419	    if any(not _connected(bag, adj) for bag in bags):
   420	        return False
   421	    for a in range(4):
   422	        for b in range(a + 1, 4):
   423	            adjacent = any(adj[v] & bags[b] for v in bags[a])
   424	            if adjacent != (b == a + 1):
   425	                return False
   426	    return True
