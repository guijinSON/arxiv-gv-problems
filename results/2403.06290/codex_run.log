   340	def _graph_adjacency(inst: dict) -> list[set[int]]:
   341	    n, d = inst["n"], inst["d"]
   342	    size = 2 * n + d + 2
   343	    z_x = 2 * n
   344	    z_first = z_x + 1
   345	    z_y = z_first + d
   346	    z_vertices = list(range(z_x, z_y + 1))
   347	    adj = [set() for _ in range(size)]
   348	
   349	    def add(a: int, b: int) -> None:
   350	        adj[a].add(b)
   351	        adj[b].add(a)
   352	
   353	    for a_pos, a in enumerate(z_vertices):
   354	        for b in z_vertices[a_pos + 1 :]:
   355	            add(a, b)
   356	    for i, mask in enumerate(inst["X"]):
   357	        add(i, z_x)
   358	        for c in range(d):
   359	            if mask & (1 << c):
   360	                add(i, z_first + c)
   400	            if u in vertices and u not in seen:
   401	                seen.add(u)
   402	                stack.append(u)
   403	    return seen == vertices
