def _bits(mask: int, d: int) -> str:
    # Coordinate z_0 is the leftmost displayed bit, even though it is bit 0 in
    # the internal integer.  This makes the display agree literally with labels.
    return "".join("1" if mask & (1 << c) else "0" for c in range(d))


def render(inst: dict) -> str:
    n, d, t = inst["n"], inst["d"], inst["target_count"]
