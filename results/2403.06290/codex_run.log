+        for seed in range(4):
+            inst = make_instance(seed=seed, **params)
+            ok, _ = verify(inst, inst["answer"])
+            graph_ok = all(_is_p4_witness_pair(inst, i, j) for i, j in inst["answer"])
+            g1_ok &= ok and graph_ok
