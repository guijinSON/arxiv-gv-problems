   466	def random_candidate(inst: dict, rng: random.Random) -> object:
   467	    """Sample uniformly from the stated language of sorted distinct pairs."""
   468	    n, t = inst["n"], inst["target_count"]
   469	    chosen = sorted(rng.sample(range(n * n), t))
   470	    return [[value // n, value % n] for value in chosen]
