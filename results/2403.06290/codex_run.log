%\begin{definition}[Potential $(S_X,W)$-penultimate-attachment]
%\label{def:a-b}
%For a penultimate potential $k$-witness set $W$ and 
%the potential $k$-prefix set 
%$S_X$ associated with $W$, 
%the set $\calA(S_X, W)$ of all potential $(S_X, W)$-attachments 
%is defined as $\bigcup_{a=1}^{k+1} \calA_{a}(S_X, W)$ where 
%\begin{multline*}
