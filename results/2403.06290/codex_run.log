   491	def _wl_invariant(inst: dict) -> object:
   492	    """A graph-isomorphism invariant (not claimed to be a complete canonical form)."""
   493	    adj = _graph_adjacency(inst)
   494	    colors = [0] * len(adj)
   495	    signatures: list[tuple] = []
   496	    for _ in range(len(adj)):
   497	        signatures = [(colors[v], tuple(sorted(colors[u] for u in adj[v]))) for v in range(len(adj))]
   498	        palette = {sig: c for c, sig in enumerate(sorted(set(signatures)))}
   499	        new_colors = [palette[sig] for sig in signatures]
   500	        if new_colors == colors:
   501	            break
   502	        colors = new_colors
   503	    class_sizes = [colors.count(c) for c in range(max(colors) + 1)]
   504	    quotient_rows = []
   505	    for c in range(max(colors) + 1):
   506	        v = colors.index(c)
   507	        counts = [0] * (max(colors) + 1)
   508	        for u in adj[v]:
   509	            counts[colors[u]] += 1
   510	        quotient_rows.append([class_sizes[c], counts])
   511	    # Pairwise common-neighbor counts strengthen the invariant while remaining
   512	    # unchanged by every vertex relabelling.
   513	    adj_bits = [sum(1 << u for u in neighbors) for neighbors in adj]
   514	    common = sorted(
   515	        (adj_bits[a] & adj_bits[b]).bit_count()
   516	        for a in range(len(adj))
   517	        for b in range(a + 1, len(adj))
   518	    )
   519	    return [sorted(len(ns) for ns in adj), quotient_rows, common]
   520	
   521	
   522	def canonical_key(inst: dict) -> str:
   523	    raw = json.dumps(
   524	        [inst["target_count"], _wl_invariant(inst)],
   525	        separators=(",", ":"),
   526	        sort_keys=True,
   527	    )
   528	    return hashlib.sha256(raw.encode("ascii")).hexdigest()
