    97	\subsection{Potential Witness Sets and Potential Prefix Sets}
    98	
    99	Intuitively, if $G$ is $k$-contractible to $P_\ell$ with the witness structure 
   100	$(W_1,W_2,\ldots,W_\ell)$ satisfying the required properties, 
   101	a potential $k$-witness set is a candidate for $W_i$ with 
   102	$2 \leq i \leq \ell-1$ and a potential $k$-prefix set is a 
   103	candidate for the set of vertices in a `prefix witness set'.  See Figure~\ref{fig:path} for an illustration. 
   104	
   105	\begin{definition}[Potential $k$-witness Set]
   106	\label{def:k-potential-witness-set} 
   107	%A connected set $W \subseteq V(G) \setminus (X \cup Y)$ is called a potential $k$-witness set of $G$ if |(N(W_i) \cap W_{i-1}) \setminus X | +  |W_i| + |(N(W_i) \cap W_{i+1}) \setminus Y| \le k + 3 - |X|-|Y|$ and $G - W$ has two connected components $C_X, C_Y$ containing $X$ and $Y$, respectively.
   108	A connected set $W \subseteq V(G) \setminus (X \cup Y)$ is called a potential $k$-witness set of $G$ if 
   109	$|(N(W) \setminus (X \cup Y) | +  |W|  \le k + 5 - |X|-|Y|$ and $G - W$ has two connected components
   110	$C_X, C_Y$ containing $X$ and $Y$, respectively.
   111	\end{definition}
   112	
   113	Note that every non-terminal witness set in a $P_\ell$-witness structure of $G$ is a potential $k$-witness set. Next, we define the notion of a \emph{potential $k$-prefix set}. 
   114	
   115	\begin{definition}[Potential $k$-prefix set]
   116	\label{def:k-nice-subset}
   117	For a potential $k$-witness set $W \subseteq V(G) \setminus (X \cup Y)$ with $C_X$ and $C_Y$ being the two connected components of $G - W$ containing $X$ and $Y$, respectively, the sets $S_X := C_X \cup W$ and $S_Y := C_Y \cup W$ are called the \emph{potential $k$-prefix sets} associated with $W$.
   118	\end{definition}
   119	
   120	Note that a potential $k$-prefix set is a non-empty connected set $S \subseteq V(G)$ that contains a potential $k$-witness set $W$ such that $G[S]- W$ is one of the connected components of $G - W$. 
