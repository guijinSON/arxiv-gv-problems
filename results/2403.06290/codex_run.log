+        [i, j]
+        for i in unmatched_x
+        for j in unmatched_y
+        if (inst["X"][i] & inst["Y"][j]) == 0
+    )
+    operations = 2 * inst["n"] + len(unmatched_x) * len(unmatched_y)
+    return pairs, operations
