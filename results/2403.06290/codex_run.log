   270	
   271	\begin{definition}[Potential $(S_X,W)$-attachment]
   272	\label{def:pot-att}
   273	For a potential $k$-witness set $W$ and the potential $k$-prefix set 
   274	$S_X$ associated with $W$, 
   275	the set $\calA(S_X, W)$ of all potential $(S_X, W)$-attachments is defined as $\bigcup_{a=|N(S_X)|}^{k+1} \calA_{a}(S_X, W)$ where 
   276	\begin{align*}
   277	\calA_{a}(S_X, W) = & \{ A\subseteq V(G) \setminus S_X \mid G[A] 
   278	\text{ is connected, } N(S_X) \subseteq A, |A| = a, \text{ and } \\
   279	& |(N(W) \cap S_X) \setminus X| + |W| + |A| + |(N(A) \setminus S_X)\setminus Y| \\
   280	& \hspace{1cm} \le k + 6-|X|-|Y| \}
   281	\end{align*}
   282	\end{definition}
   283	
   284	%We note that these two definitions differs only 
   285	%on condition regarding $N(W)$.
   286	%The second definition consider all the vertices in $N(X) \cap S_X$,
   287	%whereas the first definition consider vertices in $N(X) \cap S_X$
   288	%that are outside $X$.
   289	%We remark that since no internal potential $k$-witness set is 
   290	%adjacent with $X$, these two definitions are identical.
   291	%However, keeping these two things separate allows us to 
   292	%present a cleaner running time analysis of the algorithm.
   293	
   294	%We justify the upper bound on the cardinality of sets mentioned in the second definition and then mention the need of the first definition.
   295	We now justify the upper bound on the cardinality of sets mentioned in the definition. Suppose $G$ is $k$-contractible to $P_\ell$ with witness structure \sloppy $(W_1,\dots, W_{i-1}, W_i,
   296	W_{i+1}, W_{i+2}, \dots, W_{\ell})$ where 
   297	$X \subseteq W_1$ and $Y \subseteq W_{\ell}$.
   298	In the initialization phase, the algorithm identifies sets $W_1, W_2$
   299	and $W_{\ell - 1}, W_{\ell}$. 
   300	Hence, a set $A$ in the potential $(S_X,W)$-attachment 
   301	$\calA_{a}(S_X, W)$ corresponds to the case
   302	when $W$ is some internal witness set $W_i$ 
   303	where $2 \le i \le \ell - 2$.
   304	In fact, we can improve the upper bound to $\ell - 3$ and our algorithm tries to expand 
   305	$S_X$ only till $W = W_{\ell - 3}$ to find 
   306	$A$ which is a potential candidate for $W_{\ell - 2}$.
   307	This implies that $W_1, W_{i-1}, W_{i}, W_{i+1}, W_{i+2}, W_{\ell}$
   308	are six different witness sets when $2 < i \le \ell - 3$ and
   309	are five different sets when $i = 2$ since $6 \le\ell$.
   310	
   311	By the definitions of the relevant sets, when $W = W_i$
   312	we have $S_X = W_1 \cup W_2 \cup \cdots \cup W_{i}$.
   313	Hence, $N(W) \cap S_X$ is part of $W_{i-1}$,
   314	$A$ is a potential candidate for $W_{i+1}$  and $N(A) \setminus S_X$
   315	is part of $W_{i+2}$.
   316	As $X$ and $Y$ are part of $W_1$ and $W_\ell$, respectively,
   317	for $2 < i \le \ell - 3$ we have
   318	\begin{align}
   319	|W_1| + |W_{i-1}| + |W_{i}| + |W_{i+1}| + |W_{i+2}| + |W_{\ell}| & \le k + 6
   320	\nonumber \\ 
   321	|X| + |N(W) \cap S_X| + |W| + |A| + |N(A) \setminus S_X| + |Y| & \le k + 6 \nonumber\\
   322	|N(W) \cap S_X| + |W| + |A| + |N(A) \setminus S_X| & \le k + 6 - |X| - |Y|
   323	\label{eq:expand-cardinality-bound}
   324	\end{align}
   325	For $i = 2$, we have $W_1 = W_{i-1}$ and hence
   326	\begin{align}
   327	|(N(W) \cap S_X)\setminus X| + |W| + |A| + |N(A) \setminus S_X| & \le k + 5 - |X| - |Y|
   328	\label{eq:expand-cardinality-bound-2}
   329	\end{align}
   330	
   331	Note that Equation \ref{eq:expand-cardinality-bound} subsumes Equation \ref{eq:expand-cardinality-bound-2}. Coming back to the updating phase of the algorithm,
   332	it processes each entry $\Gamma[S_X,W,k']$ in the increasing order of $|S_X|$, $|W|$ and $k'$.
   333	If $\Gamma[S_X,W,k']=\false$, then it skips to the next entry.
   334	Otherwise, it compute $\calA(S_X, W)$ 
   335	(we specify the steps in this computation later).
   336	Then, for every set $A$ in $\calA(S_X, W)$ and
   337	every $k' + (|A| - 1) \le k^{\circ}  \le k - |N_{G-S_X}(A)|+1$,
   338	it sets $\Gamma[S_X \cup A, A, k^{\circ}] =\true$.
   339	This completes the updating phase of the algorithm.
   340	
   341	In the final phase, the algorithm iterates over all
   342	potential $k$-witness sets $W$ and the corresponding
   343	valid entries.
   344	Suppose $S_X$ and $S_Y$ are the two potential $k$-prefix sets
   345	associated with $W$.
   346	If there is pair of integers $k_1, k_2$ such that
   347	$k_1 + k_2 - (|W| - 1) \le k$, and
   348	$\Gamma[S_X, W, k_1] = \true$ and
   349	$\Gamma[S_Y, W, k_2] = \true$,
   350	then the algorithm concludes that $G$ is $k$-contractible
   351	to a path with desired properties.
   352	This concludes the description of the algorithm
   353	which we summarize as Algorithm~\ref{alg:path-conn}. 
   354	
   355	
   356	
   357	\begin{algorithm}[t]
   358		\caption{\textsf{PC-DP$(G, X, Y, k)$}}
   359		\label{alg:path-conn}
   360		\begin{algorithmic}[1]
   361			\Require An undirected graph $G$ on $n$ vertices, disjoint subsets $X, Y \subseteq V(G)$ and a positive integer $k$ such that $n> k+5$.
   362			\Ensure Determine if $G$ is $k$-contractible to a path such that $X$ is contained in one of the end witness sets and $Y$ is contained in the other end witness set	
   363			\blueLcomment{Phase 1: Initializing $\Gamma$}
   364			\State Construct a table $\Gamma$ whose entries are index by valid indices %\label{line-init-indices}
   365	        \State Initialize all entries in $\Gamma$ to \false 
   366			\State Enumerate the set $\mathcal{W}$ of all potential $k$-witness sets using Corollary~\ref{cor:pot-int-sets}    
   367			\For {each $W \in \mathcal{W}$}
   368			\State Let $S_X$ and $S_Y$ be the $k$-prefix sets associated with $W$
   369			%\State Let $C_X$ and $C_Y$ be the components of $G - W$ with $X \subseteq C_X$ and $Y \subseteq C_Y$
   370			%\State Let $S_X := C_X \cup W$ and $S_Y := C_Y \cup W$
   371			\State Set $\Gamma[S_X, W, k'] = \true$ for every $|S_X|-2\leq k' \leq k-|N(S_X)|+1$
   372			\State Set $\Gamma[S_Y, W, k'] = \true$ for every $|S_Y|-2\leq k' \leq k-|N(S_Y)|+1$
   373	        \EndFor		
   374	        \blueLcomment{Phase 2: Updating $\Gamma$}
   375	        \For {each entry $\Gamma[S,W,k']$ in the increasing order of $|S|$, $|W|$, $k'$}
   376	        	\If{$\Gamma[S,W,k']=\false$}
   377	        		\State Skip to the next entry in $\Gamma$
   378	        	\Else 
   379	        		\State Let $|W|=\alpha$, $|(N(W) \cap S) \setminus (X \cup Y)| = \beta_1$ and $|N(W) \setminus S|=\beta_2$.
   380	        		\For{every integer $\beta_2 \leq a \leq k+1$}
   381	        			\State Compute $\calA_{a}(S, W)$ using Proposition~\ref{prop:ab-conn-sets}
   382	        		\EndFor
   383	        		\State Compute $\calA(S, W)=\bigcup_{a=|N(S|}^{k+1} \calA_{a}(S, W)$ 
   384	                \For{every set $A$ in $\calA(S, W)$}
   385						\For{every $k' + |A| - 1 \leq k^{\circ} \leq k-|N_{G-S}(A)|+1$ }       			
   386	        				\State Set $\Gamma[S \cup A, A, k^{\circ}] =\true$ 
   387	        			\EndFor
   388	        		\EndFor
   389				\EndIf
   390			\EndFor
   391		\blueLcomment{Phase 3: Returning the output}
   392		\For {each $W \in \mathcal{W}$}
   393			\State Let $S_X$ and $S_Y$ be the $k$-prefix sets associated with $W$
   394			\If{$\Gamma[S_X, W, k_1] = \Gamma[S_Y, W, k_2]=\true$ for some $k_1+k_2-|W|+1 \leq k$}
   395				\State \Return $(G,X,Y,k)$ is a \yes-instance
   396			\EndIf
   397		\EndFor
   398		\State \Return $(G,X,Y,k)$ is a \no-instance
   399		\end{algorithmic}
   400	\end{algorithm}
   401	
