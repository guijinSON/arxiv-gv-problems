import importlib.util,json
s=importlib.util.spec_from_file_location('g','gen_0902_4670.py'); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
for path,mode in [('llm_loop_transcript.jsonl','bare'),('g9_hinted_transcript.jsonl','hinted'),('g9_placebo_transcript.jsonl','placebo')]:
  rows=[json.loads(x) for x in open(path) if x.strip()]
  checks=[]
  for r in rows:
    inst=g.make_instance(seed=r['seed'],**r['params'])
    ans=g.parse_answer(r.get('reply') or '')
    got=(None if ans is None else g.verify(inst,ans)[0])
    checks.append((r['solved'],bool(r['parsed']),got,r['verify_reason']))
  print(mode,len(rows),checks)
# Confirm restored bare lines are byte-for-byte the earlier script output captured in the run log.
log=open('codex_run.log',errors='replace').read().splitlines()
recovered=[log[i-1] for i in (107186,107187,107188)]
current=open('llm_loop_transcript.jsonl').read().splitlines()
print('bare_recovery_matches_logged_harden_output',current==recovered)
