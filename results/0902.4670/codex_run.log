codex
The temporary G9 working directories have been moved to trash after their transcripts were copied back; they are recoverable, and the required deliverables remain. I’m doing the final read-only packaging audit now: import silence, JSON round-trips, transcript schema, metadata/verdict consistency, canonical diversity, and README/example synchronization.
exec
/bin/bash -lc "python3 - <<'PY'
import ast,contextlib,hashlib,importlib.util,io,json,os,re,subprocess,sys
required_files=['gen_0902_4670.py','selftest_report.json','llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl','README.md','.meta.json']
assert all(os.path.isfile(p) and os.path.getsize(p)>0 for p in required_files)
# Import must be silent.
buf=io.StringIO()
with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
 s=importlib.util.spec_from_file_location('g','gen_0902_4670.py'); g=importlib.util.module_from_spec(s); s.loader.exec_module(g)
assert buf.getvalue()==''
assert g.TRACK=='B' and list(g.DIFFICULTY)==['demo','easy','medium','hard'] and g.SHIPPING_DIFFICULTY=='easy'
for fn in ('make_instance','render','parse_answer','verify','random_candidate','search_space','enumerate_all','canonical_key','escalate','selftest'):
 assert callable(getattr(g,fn,None)),fn
# Verify and serialize a diverse shipping batch.
keys=[]
for seed in range(100,120):
 inst=g.make_instance(seed=seed,**g.DIFFICULTY[g.SHIPPING_DIFFICULTY])
 assert g.verify(inst,inst['answer'])==(True,'ok')
 assert json.loads(json.dumps(inst['answer']))==inst['answer']
 assert g.parse_answer('<answer>'+json.dumps(inst['answer'])+'</answer>')==inst['answer']
 keys.append(g.canonical_key(inst))
assert len(set(keys))==20
# Current report is exactly the most recent full selftest output.
report=json.load(open('selftest_report.json'))
latest=json.load(open('/tmp/0902_selftest_postfix.json'))
assert report==latest and report['all_passed']
# Transcript schema and exact rescoring.
need={'schema_version','model','effort','preset','params','seed','escalation_round','solved','parsed','verify_ok','verify_reason','reply','error','elapsed_sec','http_status','finish_reason'}
summary={}
for path in ('llm_loop_transcript.jsonl','g9_hinted_transcript.jsonl','g9_placebo_transcript.jsonl'):
 rows=[json.loads(x) for x in open(path) if x.strip()]
 assert len(rows)==3
 for row in rows:
  assert need<=set(row)
  inst=g.make_instance(seed=row['seed'],**row['params'])
  ans=g.parse_answer(row.get('reply') or '')
  if row['parsed']:
   assert ans is not None and g.verify(inst,ans)[0] is bool(row['verify_ok'])
  else:
   assert ans is None
 summary[path]={'calls':len(rows),'solved':sum(r['solved']=='solved' for r in rows),'parsed':sum(bool(r['parsed']) for r in rows)}
meta=json.load(open('.meta.json'))
assert meta['harden_verdict']['verdict']=='hardened'
assert meta['harden_verdict']['shipping_params']==g.DIFFICULTY[g.SHIPPING_DIFFICULTY]
# README demo stays byte-for-byte synchronized with render().
demo=g.make_instance(seed=0,**g.DIFFICULTY['demo'])
