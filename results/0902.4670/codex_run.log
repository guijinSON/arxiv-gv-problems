python3 - <<'PY'
import ast, importlib.util, json, pathlib
p=pathlib.Path('gen_0902_4670.py'); source=p.read_text(); t=ast.parse(source)
verify_node=next(n for n in t.body if isinstance(n,ast.FunctionDef) and n.name=='verify')
reads=[]
for n in ast.walk(verify_node):
    if isinstance(n,ast.Subscript) and isinstance(n.value,ast.Name) and n.value.id=='inst':
        sl=n.slice
        if isinstance(sl,ast.Constant) and sl.value=='answer': reads.append(n.lineno)
print('verify_answer_key_subscripts', reads)
s=importlib.util.spec_from_file_location('m',p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
count=0
for name,params in m.DIFFICULTY.items():
  for seed in range(4):
    inst=m.make_instance(seed=seed,**params)
    assert m.verify(inst,inst['answer'])==(True,'ok')
    assert json.loads(json.dumps(inst['answer']))==inst['answer']
    count+=1
print('G1_recheck_ok',count)
