import importlib.util, json
p='gen_0902_4670.py'; s=importlib.util.spec_from_file_location('m',p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
count=0
for name,params in m.DIFFICULTY.items():
    for seed in range(4):
        inst=m.make_instance(seed=seed, **params)
        assert m.verify(inst,inst['answer']) == (True,'ok'), (name,seed)
        assert json.loads(json.dumps(inst['answer'])) == inst['answer']
        count += 1
print('G1_recheck_ok', count)
