block=re.search(r'For "'`make_instance'"\\(seed=0, n=5, prime_bits=7\\)"'`, `render'"\\(inst\\)"'` is:'"\\n\\n"'```text'"\\n(.*?)\\n"'```'"',readme,re.S).group(1)
