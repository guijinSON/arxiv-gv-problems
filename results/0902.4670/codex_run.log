+def _is_prime(value: int) -> bool:
+    """Deterministic primality test for all values used by this module."""
+    if isinstance(value, bool) or not isinstance(value, int) or value < 2:
+        return False
+    for prime in _SMALL_PRIMES:
+        if value % prime == 0:
+            return value == prime
+    if value >= 1 << 64:
