+    low = math.isqrt(total_norm) + 1  # total_norm is squarefree, hence nonsquare
+    high = math.isqrt(3 * total_norm - 1)
+    while True:
+        hidden_root = norm_rng.randrange(low, high + 1) | 1
+        if hidden_root <= high and math.gcd(hidden_root, total_norm) == 1:
+            break
