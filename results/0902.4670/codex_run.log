+def render(inst: dict) -> str:
+    """Render a self-contained signed binary-quadratic-form relation problem."""
+    rows = "\n".join(
+        f"  {index}: ell={form['ell']}, b={form['b']}, c={form['c']}"
+        for index, form in enumerate(inst["forms"])
