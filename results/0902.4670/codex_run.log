+        divisor = 41
+        limit = math.isqrt(value)
+        while divisor <= limit:
+            if value % divisor == 0:
+                return False
+            divisor += 2
+        return True
+    odd = value - 1
+    twos = 0
+    while odd % 2 == 0:
+        odd //= 2
+        twos += 1
+    for base in _MR_BASES_64:
+        if base % value == 0:
