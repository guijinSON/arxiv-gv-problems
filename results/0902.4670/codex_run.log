+        transformed, carried = _permuted_and_inverted(original, 30_000 + seed)
+        if canonical_key(transformed) == key:
+            invariance += 1
+        else:
+            g8_failures.append(f"permutation/inversion changed key at seed {seed}")
+        if verify(transformed, carried)[0]:
