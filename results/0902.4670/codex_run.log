   c=c+b*m+a*m*m; b=b+2*a*m; steps+=1
  if a>c:
   a,b,c=c,-b,a; steps+=1; continue
  if abs(b)<=a<=c:
   if (abs(b)==a or a==c) and b<0:b=-b
   return (a,b,c),steps
  print('bad',a,b,c); raise SystemExit
N=100000;t=time.perf_counter(); st=0
rng=random.Random(1)
for _ in range(N):
