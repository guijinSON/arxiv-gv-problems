+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_why,
+        "candidate_space_bits_shipping": inst["n_variables"],
+        "candidate_space_bits_doubled": doubled["n_variables"],
+    }
