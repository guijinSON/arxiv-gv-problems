+                "coefficient_xors": coefficient_xors,
+                "row_xors": row_xors,
+                "pivots": rank,
+            }
+    bits = [0] * n_variables
+    for row_index, column in enumerate(pivots):
+        bits[column] = matrix[row_index][-1]
+    answer = [-1 if bit else 1 for bit in bits]
+    return answer, {
+        "coefficient_xors": coefficient_xors,
+        "row_xors": row_xors,
+        "pivots": rank,
