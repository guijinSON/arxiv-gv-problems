+        # Pair opposite points of the known Hamiltonian order.  For even n >= 4
+        # these are not cycle edges (at n=4 they are the two diagonals).
+        half = vertex_count // 2
+        matching = [
+            (min(order[i], order[i + half]), max(order[i], order[i + half]))
+            for i in range(half)
+        ]
+    edges = cycle + matching
+    rng.shuffle(edges)
+    return edges
