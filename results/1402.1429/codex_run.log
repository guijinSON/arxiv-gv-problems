+        for old, value in enumerate(inst["answer"]):
+            new = permutation[old] if mask & 1 else old
+            answer[new] = value * flips[old] if mask & 2 else value
+        variants.append(
+            {
+                "n_variables": count,
+                "n_equations": len(clauses),
+                "clauses": clauses,
+                "answer": answer,
+            }
