+def _literal_balance_candidate(inst):
+    score = [0] * inst["n_variables"]
+    for clause in inst["clauses"]:
+        for variable, coefficient in clause:
+            score[variable - 1] += coefficient
+    return [1 if value >= 0 else -1 for value in score]
