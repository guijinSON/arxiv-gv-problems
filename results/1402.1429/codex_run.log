+def _random_cubic_graph(vertex_count, rng):
+    """A connected simple cubic graph: Hamiltonian cycle plus a matching."""
+    order = list(range(vertex_count))
+    rng.shuffle(order)
+    cycle = []
+    cycle_set = set()
+    for i, u in enumerate(order):
