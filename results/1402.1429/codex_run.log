+def _greedy_clause_candidate(inst):
+    answer = [1] * inst["n_variables"]
+    for clause in inst["clauses"]:
+        value = math.prod(1 + coefficient * answer[variable - 1] for variable, coefficient in clause)
+        if value != 0:
+            variable, _coefficient = clause[0]
+            answer[variable - 1] *= -1
+    return answer
