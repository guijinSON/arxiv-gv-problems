+        "solves": f"{reference_successes}/8, as expected",
+        "compact_route": "incidence spanning-tree leaf elimination",
+        "compact_route_wall_clock_sec": round(compact_seconds / 8, 6),
+        "compact_route_operations": compact_operations // 8,
