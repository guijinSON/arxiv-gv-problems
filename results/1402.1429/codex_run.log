+        "n_equations": len(clauses),
+        "clauses": clauses,
+        "answer": answer,
+    }
+
+
+def _factor(variable, coefficient):
+    sign = "+" if coefficient == 1 else "-"
+    return f"(1 {sign} x{variable})"
+
+
