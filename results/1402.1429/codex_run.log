+    os.path.dirname(
+        os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    ),
+)
+try:
+    from gvlib import exact_matrices, rationals
+except ImportError:  # pragma: no cover - the generator is standard-library-only
