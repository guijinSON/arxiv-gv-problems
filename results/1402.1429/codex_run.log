+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    ladder_sizes = [DIFFICULTY[name]["n"] for name in DIFFICULTY]
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["n_variables"] == 2 * inst["n_variables"]
+        and len(render(doubled)) > len(render(inst))
