+    "native_domain": "algebra",
+    "object_regime": "rational_exact",
+    "computational_core": "csp_sat",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "factored cubic polynomials over Q",
+        "sign-constrained complex variables",
+    ],
+    "verification_operations": [
