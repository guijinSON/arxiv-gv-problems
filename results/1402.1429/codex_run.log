+        "drop": answer[:-1],
+        "swap": swap if swap is not None else list(reversed(answer)),
+        "duplicate": [answer[0]] + list(answer),
+        "empty": [],
+        "out_of_range": [0] + answer[1:],
+    }
+    rejected = {}
+    for name, candidate in corruptions.items():
+        ok, why = verify(inst, candidate)
