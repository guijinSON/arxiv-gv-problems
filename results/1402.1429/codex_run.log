+def _single_sweep_repair_candidate(inst):
+    groups = _extract_groups(inst)
+    answer = [1] * inst["n_variables"]
+    for support, target in groups or []:
+        if math.prod(answer[v - 1] for v in support) != target:
+            answer[min(support) - 1] *= -1
+    return answer
