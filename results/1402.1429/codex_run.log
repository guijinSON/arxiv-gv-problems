+                new_coefficient = coefficient * flips[old] if mask & 2 else coefficient
+                transformed.append([new + 1, new_coefficient])
+            if mask & 4:
+                rng.shuffle(transformed)
+            clauses.append(transformed)
+        if mask & 4:
+            rng.shuffle(clauses)
