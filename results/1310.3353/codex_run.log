+    if any(s % 2 for s in sizes):
+        raise RuntimeError("could not construct even cluster populations")
+    return sizes
+
+
+def _latent_coordinates(
+    n: int,
+    q: int,
+    modulus: int,
+    outlier_milli: int,
+    rng: random.Random,
