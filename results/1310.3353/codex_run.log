+        "random_restart_4096",
+        "agglomerative_positive_gain",
+        "equal_size_ansatz",
+    )
+    attack_results = {
+        name: {"successes": 0, "attempts": len(attack_seeds), "wall_clock_sec": 0.0}
+        for name in attack_names
+    }
+    random_iterations = 0
+    reference_successes = 0
+    reference_operations = 0
+    reference_wall = 0.0
