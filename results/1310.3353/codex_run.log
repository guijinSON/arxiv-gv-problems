+            invariant_checks += 1
+            if canonical_key(transformed) != key:
+                g8_failures.append(f"seed {seed}: key changed under {name}")
+            ok, why = verify(transformed, carried_answer)
+            preserved_witness_checks += 1
+            if not ok:
