+    }
+
+    invariant_checks = 0
+    preserved_witness_checks = 0
+    distinct_keys: list[str] = []
+    g8_failures: list[str] = []
+    for seed in range(20):
+        inst = make_instance(seed=10_000 + seed, **shipping_params)
+        key = canonical_key(inst)
+        distinct_keys.append(key)
