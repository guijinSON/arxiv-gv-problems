+
+
+# Known Mersenne primes.  They make every nonzero affine multiplier invertible.
+_PRIMES = {
+    13: (1 << 13) - 1,
+    19: (1 << 19) - 1,
+    31: (1 << 31) - 1,
+    61: (1 << 61) - 1,
+    89: (1 << 89) - 1,
+    107: (1 << 107) - 1,
+    127: (1 << 127) - 1,
+}
