+    placebo_rate = (
+        G9_ARM_RESULTS["placebo"]["solved"] / G9_ARM_RESULTS["placebo"]["attempts"]
+        if G9_ARM_RESULTS["placebo"]["attempts"]
+        else 0.0
+    )
+    within_caps = (
