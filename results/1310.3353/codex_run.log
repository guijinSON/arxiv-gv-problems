+        ]
+
+        a2 = rng.randrange(2, inst["modulus"] - 1)
+        b2 = rng.randrange(inst["modulus"])
+        transforms.append(("affine_reencoding", _reencode(inst, xs, a2, b2), inst["answer"]))
+
+        room = inst["modulus"] - 1 - max(xs)
