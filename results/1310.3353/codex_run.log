+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] = 2 * shipping_params["n"]
+    doubled = make_instance(seed=271828, **doubled_params)
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
