+    inverse = pow(multiplier, -1, p)
+    transformed["multiplier"] = multiplier
+    transformed["offset"] = offset
+    transformed["encoded_points"] = [
+        (inverse * (x - offset)) % p for x in xs
+    ]
+    return transformed
