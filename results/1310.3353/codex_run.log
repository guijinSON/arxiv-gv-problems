def build(n=64,q=6,seed=0,T=900001,P=1000003):
 r=random.Random(seed)
 # random even parts >=6
 units=n//2; base=3
 while True:
  cuts=sorted(r.sample(range(1,units-q*base+q),q-1)) if False else None
  rem=units-q*base
  alloc=[0]*q
  for _ in range(rem): alloc[r.randrange(q)]+=1
  sizes=[2*(base+a) for a in alloc]
  if max(sizes)-min(sizes)>=4 and all(sum(sizes[:j]) "'!= round(j*n/q) for j in range(1,q)):
   break
 ys=[]
 for c,s in enumerate(sizes):
  center=(c+1)*P
  vals=[center-int(.40*T),center+int(.40*T)]
  # bulk symmetric, remaining s-2; deviations unique small
  ds=r.sample(range(1000,int(.025*T)),(s-2)//2)
  for d in ds: vals += [center-d,center+d]
  ys += vals
 ys.sort()
 cuts=[]; z=0
 for s in sizes[:-1]: z+=s; cuts.append(z)
 def w(a,b): return T-abs(ys[a]-ys[b])
 def cost(cs):
