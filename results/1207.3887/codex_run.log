+
+    # G5/G6 executable full-table reference and compact route at shipping.
+    reference_rows = []
+    compact_rows = []
+    reference_successes = 0
+    compact_successes = 0
+    for seed in range(8):
+        inst = make_instance(seed=8000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        start = time.perf_counter()
