+        "carried_witness_checks_passed": carried_passed,
+        "carried_witness_checks_total": carried_total,
+        "distinct_unrelated_keys": distinct,
+        "unrelated_instances": 20,
+    }
+
+    answer_blob = json.dumps(shipping["answer"])
+    worst_scalars = list(
