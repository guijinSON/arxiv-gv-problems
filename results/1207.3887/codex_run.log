+_PRIMITIVE_ROOT = {17: 3, 65537: 3, 2013265921: 31}
+_SUPPORTED_ORDERS = {
+    p: tuple(r for r in range(2, 65) if (p - 1) % r == 0)
+    for p in _PRIMITIVE_ROOT
+}
