+STRUCTURAL_HINT = (
+    "The sum of each next-coordinate projection fiber reveals its hidden triangular linear form."
+)
+PLACEBO_HINT = (
+    "The consistency of each displayed coordinate should be checked with careful finite-field arithmetic."
+)
