+        "field_prime": prime,
+        "fiber_order": n,
+        "variables": variables,
+        "coefficient_bound": coeff_bound,
+        "weights": weights,
+        "points": points,
+        "answer": _circuits(scalars, weights, n, prime),
+    }
+
+
