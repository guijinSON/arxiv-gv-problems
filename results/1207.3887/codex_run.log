Let us fix $i_3=2$.  Then Figure~\ref{fig:dec3} illustrates the
decomposition $V=V^{i_3,0} \cup V^{i_3,1}\cup V^{i_3,2}\cup V^{i_3,3}$
defined in Equation~\eqref{eq:decV3}.



\subsection{Interpolation\label{ssec:interp3}}
\paragraph{Lagrange interpolation}
The decomposition above permits to set up Lagrange interpolation formulas.
We recall the basics along with setting notations.

Given a finite set $U$ of points in $\con{k}$, Zariski-closed over $k$
and of cardinal $|U|=u$,
the {\em Lagrange basis on $U$} of the $u$-dimensional $k$-vector space $k[x]_{<u}$
is defined as:
\begin{equation}
\{ \ell_\alpha(x)\}_{\alpha\in U}\quad \text{where}\quad \ell_{\alpha}(x):=\prod_{\beta\in U\atop \beta\not= \alpha} \frac{x-\beta}{\alpha -\beta}.
\end{equation}
An element $P\in k[x]_{<u}$ is written in this basis
$P(x)=\sum_{\alpha\in U} P(\alpha) \ell_{\alpha}(x)$, in particular:
\begin{equation}\label{eq:1=}
1=\sum_{\alpha\in U} \ell_\alpha(x).
\end{equation}

\paragraph{Formula} With the notations of the~\S~\ref{ssec:setup}, given $\ii=(i_2,i_3)$
such that $\wtv^{i_3,i_2}\not= \emptyset$
define:
\begin{multline}\label{eq:interp3}
g_\ii:= \left(\prod_{\alpha'\in S_1'} X_1 -\alpha'\right)
\left\{ \sum_{\alpha\in S_1} \ell_\alpha(X_1) X_2^{i_2 -|S'_2[\alpha]|}
\left(\prod_{\beta'\in S_2'[\alpha]} X_2 -\beta_2'\right)
\left[ \sum_{\beta\in S_2[\alpha]} \ell_{\beta_2}(X_2) 
X_3^{i_3-|V[\beta]|}\right.\right.\\
\left.\left. \left(\prod_{\gamma\in V[\beta]} X_3
-\gamma_3\right)
\right]\right\}
\end{multline}
The following Proposition contains the conclusion of Theorem (structure) of the introduction.
\begin{Prop}\label{prop:LM3}
Defining $i_1:=|S_1'|$,
the leading monomial of $g_\ii$ is $\XXX{i}$.

\noindent Moreover, define $g_1$ as the unique monic polynomial
such that $I_1:=I\cap k[X_1]=\l g_1\r$. Then,
$\LC_1(g_\ii)$ divides $g_\ii$ and $g_\ii \in \l \LC_2(g_\ii), g_1\r = \l g_1\r=\l \LC_2(g_\ii) +I_1$.
\end{Prop}

\begin{pf} The degree in $X_3$ of the
polynomials $X_3^{i_3-|V[\beta]|}
\left(\prod_{\gamma\in V[\beta]} X_3
-\gamma_3\right)$ are equal to $i_3$ for all $\beta\in S_2[\alpha]$
and for all $\alpha\in S_1$.
Because $1=\sum_{\beta \in S_2[\alpha]} \ell_{\beta_2}(X_2)$, and
hence $X_3^{i_3} = \sum_{\beta \in S_2[\alpha]} \ell_{\beta_2}(X_2)
X_3^{i_3}$, it follows that the leading monomial of the polynomial
\begin{equation}\label{eq:fa}
f_\alpha(X_2,X_3):=\sum_{\beta\in S_2[\alpha]} \ell_{\beta_2}(X_2) 
X_3^{i_3-|V[\beta]|}
\left(\prod_{\gamma\in V[\beta]} X_3
-\gamma_3\right),
\end{equation}
is $X_3^{i_3}=\LM(f_\alpha)$, for all $\alpha\in S_1$. 

Similarly, the degree in $X_2$ of all the polynomials
$X_2^{i_2 -|S'_2[\alpha]|}
\left(\prod_{\beta'\in S_2'[\alpha]} X_2 -\beta_2'\right)$
is $i_2$, yielding:
\begin{equation}\label{eq:alpha}
\LM\left(X_2^{i_2 -|S_2'[\alpha]|}
\left(\prod_{\beta'\in S_2'[\alpha]} X_2
-\beta_2'\right)f_\alpha(X_2,X_3)\right) = X_2^{i_2} X_3^{i_3}.
\end{equation}
It follows that
$g_\ii=\left(\prod_{\alpha'\in S_1'} X_1 -\alpha\right)
\left(\sum_{\alpha\in S_1} \ell_\alpha(X_1)
(X_2^{i_2}X_3^{i_3}+\cdots)\right)$.
By Equation~\eqref{eq:1=}, because
$X_2^{i_2}X_3^{i_3} = \sum_{\alpha\in S_1} \ell_\alpha (X_1)
X_2^{i_2}X_3^{i_3}$, $g_\ii$ verifies $g_\ii=\left(\prod_{\alpha'\in
  S_1'} X_1 -\alpha\right)
(X_2^{i_2}X_3^{i_3} + \cdots)$.
By definition of $i_1$ equal to  the cardinal of $S_1'$,
one gets $\LM(g_\ii)=\XXX{i}$.

Equation~\eqref{eq:interp3} clearly shows that
$\LC_1(g_\ii)=\prod_{\alpha\in S_1'} X_1 - \alpha$ divides
$g_\ii$.
Let $\alpha\in S_1$. Then $\frac{g_\ii}{\LC_1(g_\ii)}(\alpha,X_2,X_3)
= X_2^{i_2 -|S_2'[\alpha]|}
\left(\prod_{\beta'\in S_2'[\alpha]} X_2
-\beta_2'\right) f_\alpha( X_2 , X_3 )$
and one sees that
$$
\LC_2(\frac{g_\ii}{\LC_1(g_\ii)}(\alpha,X_2,X_3))
\quad \text{divides} \quad \frac{g_\ii}{\LC_1(g_\ii)}(\alpha,X_2,X_3).
$$
The Chinese Remaindering Theorem implies
that $\LC_2(\frac{g_\ii}{\LC_1(g_\ii)})$
divides $\frac{g_\ii}{\LC_1(g_\ii)}$ modulo
$\frac{g_1}{\LC_1(g_\ii)}$,
hence that $g_\ii \in \l \LC_2(g_\ii),g_1\r$.
\end{pf}

\begin{Lem}\label{lem:vanish3}
The polynomial $g_\ii$ vanishes on $V$.
\end{Lem}
\begin{pf}
First, the factor $\LC_1(g_\ii) = \prod_{\alpha\in S_1'} X_1-\alpha'$ implies that $g_\ii$
vanishes on $V^{i_3,>i_2}$, since $S_1' = \pi_1(V^{i_3,>i_2})$. Because
$V=V^{i_3,>i_2} \cup V^{i_3,\le i_2}$, it remains to show that $\wt{g_\ii}:=\frac{g_\ii}{\LC_1(g_\ii)}$
vanishes on $V^{i_3,\le i_2}$.

For $\alpha \in S_1$, $\wt{g_\ii} (\alpha, X_2,X_3) = X_2^{i_2 - |S'_2[\alpha]|}
(\prod_{\beta' \in S_2 '[\alpha]} X_2 - \beta ')  f_\alpha(X_2,X_3)$ by Equations~\eqref{eq:interp3}~
\eqref{eq:fa}, thus
$g_\ii$ vanishes on $\pi_{3,2}^{-1}(S_2 '[\alpha])$. It follows that $g_\ii$ vanishes
on $\{X_1=\alpha\} \cap V^{>i_3}$, hence on $V^{> i_3} \cap V^{i_3, \le i_2},\ (\dagger)$.
For $\beta\in S_2[\alpha]$, $\wt{g_\ii}(\beta,X_3)={\rm~C~}f_\alpha(\beta_2,X_3)$ where
${\rm~C~}\in\bar{k}$ ,
which by Equation~\eqref{eq:fa} vanishes on $V[\beta]$. Hence, $g_\ii$ vanishes
on $V \cap \pi_{3,2}^{-1}(S_2) \cap \pi_{3,1}^{-1}(S_1)=
V^{\le i_3} \cap V^{i_3,\le i_2}$. 
With $(\dagger)$, $g_\ii$ vanishes on
\begin{equation*}\label{eq:V3}
(V^{\le i_3} \cap V^{i_3,\le i_2})
 \cup (V^{> i_3} \cap V^{i_3, \le i_2}) = (V^{\le i_3} \cup V^{>i_3}) \cap
V^{ i_3 , \le i_2} = V \cap V^{i_3,\le i_2} = V^{i_3,\le i_2}.
\end{equation*}
\end{pf}


\subsection{Concluding proof\label{ssec:proof3}}
Looking at Equation~\eqref{eq:L(V)3}
and Equation~\eqref{eq:interp3}, let $$G:=\{ g_\ii \ \st \ \ii \in \LL(\wtv)\}.$$ 
%% From the case $n=2$ of \S~\ref{ssec:setup},
Let also $\G_2$ be a minimal Gr\"obner basis  of $I_2:=I\cap k[X_2,X_2]$.
Lemma~\ref{lem:vanish3} shows that $G \cup \G_2 \subset I$.
In this subsection, we show that $G \cup \G_2$ is a minimal
Gr\"obner basis of $I$. 
It is sufficient to prove that $\l \LM(I)\r = \l \LM(G\cup \G_2)\r$,
or with the notation of Definition~\ref{def:min(I)},
that $\min(I) = \min(G) \cup \min(\G_2)$.
This is done by induction on $|G|=|\LL(\wtv)|$.

\begin{Lem}\label{lem:base3}
Assume that $|G|=1$. Then $ \min(I)=\min (\l G \r ) \cup \min(\l \G_2\r)$.
\end{Lem}
\begin{pf}
The proof for the general case $n>3$ is no more complicated
than the case $n=3$, it suffices essentially to replace $n$ by 3
in the proof of Lemma~\ref{lem:|G|=1}.\end{pf}

%% If $|G|=1$, then only one $V^{\ell}$ %% in Equation~\eqref{eq:33}
%% is not empty, say $\ell = i_3$. In particular $V^{>i_3}$ is empty
%% which implies that only $V^{i_3,0}$ is not empty inside the family
%% $(V^{i_3,\ell})_{\ell \in \N}$ and that $V^{i_3,0}=V=V^{i_3}=\wtv^{i_3,0}$.
%% Moreover $S'_1=\pi_1(V^{i_3,>0})=\emptyset$ hence $i_1=0$,
%% meaning that $\LL'(\wtv)=\{(0,0,i_3)\}$. 
%% %% (see definition of $\LL'(\wtv)$ at
%% %% Equation~\eqref{eq:L'(V)}).
