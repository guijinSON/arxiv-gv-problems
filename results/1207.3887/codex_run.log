\section{Interpolation formula\label{sec:interp}}
The goal is to generalize Equation~\eqref{eq:interp3} to $n>3$ variables.
Have in mind the notations of the first paragraph of~\S~\ref{ssec:interp3}.
\subsection{Iterated Lagrange interpolation polynomials}
Let $A$ be a $k$-algebra such that $A\cap k[x]=k$,
and $f:\con{k}\to A$. The {\em Lagrange interpolation polynomial}
of $f$ along $U$ is:
\begin{equation}
L_U(f)(x):=\sum_{\alpha\in U} f(\alpha) \ell_\alpha(x) \in A[x].
\end{equation}
To fit the needs of this work, a modification of this polynomial is in order:
Let $U'\subset \con{k}$  be 
% a finite Zariski-closed set over $k$
such that $U\cap U'=\emptyset$.
Then define:
\begin{equation}\label{eq:t=1}
L_{(U,U')}(f)(x):=\left(\prod_{\alpha' \in U'} x-\alpha' \right)  L_U(f)(x)= (\prod_{\alpha' \in U'} x-\alpha' ) \left\{ \sum_{\alpha\in U} \ell_\alpha(x) f(\alpha)\right\}.
\end{equation}

\paragraph{Iteration}
Given two families of $t$ couples of sets $\U:=(U_i)_{i=1,\ldots,t},\ \U':=(U_i')_{i=1,\ldots,t}$ verifying
$U_i,U_i'\subset \con{k}^i$ Zariski-closed over $k$, $U_i\cap U_i'=\emptyset$,
define 
\begin{equation}\label{eq:Ut}
{\cal U}_t := \{ (\alpha_1 , \ldots , \alpha_t) \in \con{k}^t \ | \ \alpha_1\in U_1,\ (\alpha_1,\alpha_2)\in U_2,\ldots,\ (\alpha_1,\ldots,\alpha_t)\in U_t\}.
\end{equation}
We aim at defining for each function $f_t:{\cal U}_t \to A_t$
where $A_t:=\con{k}[\XX{t+1}{n}]$ ,
%% is a $k$-algebra
%% verifying $A_t\cap k[\XX{1}{t}]=k$ (like {\em e.g.} $\con{k}[X_{t+1}]$),
%% 
a polynomial:
\begin{eqnarray*}
\nonumber
L_{\U,\U'}(  \, \cdot \, )(\XX{1}{t}): A_t^{{\cal U}_t} &
\longrightarrow & 
A_t[\XX{1}{t}]\\
f_t & \longmapsto & L_{\U,\U'} (f_t )(\XX{1}{t})
\end{eqnarray*}
Equality~\eqref{eq:t=1} provides the case $t=1$.
Else, we proceed by induction. 

Let $\alpha\in {\cal U}_{t-1}$.
We use the coordinate functions $p_i$ and $p_{ij}$ defined in~\S~\ref{ssec:setup}.
Using Equation~\eqref{eq:S[a]} define $T_t^\alpha:=p_t(U_t[\alpha]),\ T_t'^\alpha:=p_t(U_t'[\alpha])
\subset \bar{k}$. Since $U_t\cap U_t' = \emptyset$, is verified
$T_t^\alpha \cap T_t'^\alpha  = \emptyset$ as well. Let $d_t:=\max_{\beta\in
  {\cal U}_{t-1}} |T_t'^\beta|$. Define:
\begin{eqnarray}
\nonumber
g : {\cal U}_{t-1} & \longrightarrow &  A_t[X_t]=A_{t-1}\\
\label{eq:g} \alpha & \longmapsto & X_t^{d_t -|T_t'^\alpha|} L_{(T_t^\alpha ,T_t'^\alpha)}(f_t)(X_t)
\end{eqnarray}
Let $\U_{\le t-1}:=(U_1,\ldots,U_{t-1})$ and $\U_{\le
  t-1}':=(U_1',\ldots,U_{t-1}')$.
Assume defined inductively
$$
L_{\U_{\le t-1} , \U_{\le    t-1}'}(f_{t-1})(\XX{1}{t-1})\in A_{t-1}[\XX{1}{t-1}]
$$
for any function $f_{t-1}:{\cal U}_{t-1} \rightarrow A_{t-1}$. Then let:
\begin{eqnarray}\label{eq:Lrecurs}
L_{\U,\U'}(f_t)(\XX{1}{t}):= L_{\U_{\le t-1},\U_{\le t-1}'}(g)(\XX{1}{t-1}).
\end{eqnarray}

\paragraph{Explicit form}
While this definition is simple and convenient,
it is quite obscure. It is possible to give an explicit non-recursive formula.
Consider to this end the following:
\begin{Lem}\label{lem:interp}
Let $1\le s < t$ and for each $\alpha\in{\cal U}_s$ define
the two sequences $\TT_s^\alpha = (T_1^\alpha,\ldots,T_{t-s}^\alpha)$
and $\TT_s'^\alpha = (T_1'^\alpha , \ldots , T_{t-s}'^\alpha)$ as follows;
%% let $p_i$ be the $i$th coordinate function that is $p_i(x_1,\ldots,x_i,\ldots,x_n):=x_i$,
%% and for $1\le i \le j \le n$ let $p_{ij}(x_1,\ldots,x_i,\ldots,x_j,\ldots,x_n):=(x_i,\ldots,x_j)$.
$$
T_1^\alpha := p_{s+1}(U_{s+1}[\alpha])\ ,\ T_2^\alpha:=p_{s+2,s+1}(\pi_{s+2,s}^{-1}(\alpha)\cap U_{s+2})\ ,\
\ldots \  ,\ T_{t-s}^\alpha  := p_{t,s+1}(\pi_{t,s+1}^{-1}(\alpha)\cap U_{t}).
$$
(Similarly are defined the $T_j'^\alpha$, equal to $p_{j,s+1}(\pi_{j,s}^{-1}(\alpha)\cap U'_j)
\subset \con{k}^{j-s}$ for $j\ge s+1$). Let:
\begin{eqnarray}
\nonumber h:{\cal U}_s & \rightarrow &  A_t[\XX{s+1}{t}]\\
\label{eq:h}\alpha & \mapsto & L_{\TT_s^\alpha,\TT_s'^\alpha}(f_t)(\XX{s+1}{t})
\end{eqnarray}
Then the following equality holds:
$$
L_{\U,\U'}(f_t)(\XX{1}{t})=L_{\U_{\le s},\U'_{\le s}}(h)(\XX{1}{s}).
$$
\end{Lem}
\begin{pf}
It is easily done by decreasing induction on $s$ starting from $s=t-1$. 
This latter case is treated in Equation~\eqref{eq:Lrecurs}.
\end{pf}
\begin{Cor}[Explicit interpolation formula]\label{cor:interp}
With the notations above, and the new following one\footnote{$\alpha^i$
does NOT denote the $i$-th power of $\alpha$. This is a mere shorthand notation.},
$\alpha^{i}:=(\uplet{\alpha}{1}{i}{i})\in U_i$,
$\alpha'^{i}:=(\uplet{\alpha'}{1}{i}{i})\in U_i'$,
the polynomial $L_{\U,\U'}(f_t)(\XX{1}{t})$ can be written
explicitly as follows, generalizing the case of 3 unknowns
in~\eqref{eq:interp3}
\begin{align*}
\left( \prod_{\alpha'^{1}\in U_1'} X_1 -\alpha'^{1}_1 \right)
\left( \sum_{\alpha^{1} \in U_1} \ell_{\alpha^{1}_1}(X_1) X_2^{d_2-|U_2'[\alpha^{1}]|}
\prod_{\alpha'^{2}\in U_2'[\alpha^1]}(X_2 - \alpha'^{2}_2)
\left(\sum_{\alpha^{2}\in U_2[\alpha^1]} \ell_{\alpha^{2}_2}(X_2) X_3^{d_3-|U_3'[\alpha^{2}]|}
 \right.\right.\\
 \left. \left. \cdots X_t^{d_t - | U_t'[\alpha^{t-1}]|}
\prod_{\alpha'^{t}\in U'_t[\alpha^{t-1}]} (X_t - \alpha'^{t}_t)
\left(\sum_{\alpha^{t}\in U_t[\alpha^{t-1}]} \ell_{\alpha^{t}_t}(X_t)
f_t(\alpha^{t})\right) \cdots \right)\right).
\end{align*}
\end{Cor}
\begin{pf}
Again, this is easily seen by induction on $t$, using Lemma~\ref{lem:interp}
or Equation~\eqref{eq:Lrecurs}.
\end{pf}
More in the spirit of interpolation formulas,
it is convenient to provide an expanded version of the formula.
Let 
${\bf a}:=(\alpha_1,\alpha_2^2,\ldots,\alpha_t^t)$ as in Corollary~\ref{cor:interp}
and define:
\begin{equation}
\LLL_{\bf a}(\X{n}) := \prod_{i=1}^t \ell_{\alpha_i^i}(X_i)
\end{equation}
%% The family $\{\LLL_{\bf a}}\{{\bf a}}$ with the conditions
%% on ${\bf a}$ defined as above is a basis of the vector space
%% of polynomials in $k[\X{t}]$ with degree in each variable
%% $X_i$ bounded by $$ 
Thus, given another point\footnote{Again, $\beta^t$ is not a power of $\beta$}
${\bf b}=(\beta^1,\beta^2,\ldots,\beta^t)$
such that $\beta^1\in U_1$ and $\beta^i\in U_i[\beta^{i-1}]$ for $2\le i \le t-1$
comes:
$$
\LLL_{\bf a}(\beta^1,\beta^2_2,\ldots,\beta^t_t) = \begin{cases} 1 & \text{~if~} {\bf a}={\bf b}\\
  0 & \text{else}\end{cases}.
$$
Define the {\em expanded explicit form} of $L_{\U,\U'}(f_t)$
as:
\begin{equation}\label{eq:expandExplicit}
L_{\U,\U'}(f_t)= \hspace{-1.2cm}\sum_{\alpha^1\in U_1,\alpha^2\in U_2[\alpha^1],\ldots,\alpha^t \in U_t[\alpha^{t-1}]}
\hspace{-1.2cm} \LLL_{\bf a} (\X{t})\left(\prod_{i=1}^t X_i^{d_i - |U_i'[\alpha^{i-1}]|}  
\prod_{\alpha' \in U_i'[\alpha^{i-1}]} (X_i -\alpha_i') \right)f_t(\alpha)
\end{equation}
Let us investigate a natural property held by these
iterated Lagrange interpolation polynomials.
\begin{Cor}\label{cor:LM}
Assume that $f_t:{\cal U}_t \to A_t$ verifies
$\LM(f_t(\beta))=m$ for all $\beta\in {\cal U}_t$.
Then
$$
\LM(L_{\U,\U'}(f_t)(\XX{1}{t}))=X_1^{d_1}\cdots X_t^{d_t} m.
$$
\end{Cor}
\begin{pf}
Assume that $t=1$. Then $A_1:=\bar{k}[\XX{2}{n}]$,
and $L_{\U,\U'}(f_1)(X_1)$ is given by 
Equation~\eqref{eq:t=1}. From this equation and Equation~\eqref{eq:1=},
we deduce that  $ \LM(\sum_{\gamma\in U_1} \ell_\gamma(X_1) f_1(\gamma)) = m$,
and a look at the explicit form of $g_\ii$
in Corollary~\ref{cor:interp} shows that $\LM(L_{\U,\U'}(f_1)(X_1))=X_1^{d_1}m$, as expected.

Assume the corollary true for any function $f_i:{\cal U}_i \to A_i$,
for $i\le t-1$,
and verifying $\LM(f_i(\beta))=m'$, for all $\beta \in {\cal U}_i$.
Let the function $g:{\cal U}_{t-1}\to A_{t-1}$ as defined in Equation~\eqref{eq:g}.
For $\alpha\in {\cal U}_{t-1}$
%% , defined as $\alpha_1=\beta_1,\ldots,\alpha_{t-1}=\beta_{t-1}$.
holds $g(\alpha)=
X_t^{d_t - |T_t'^\alpha|} L_{(T_t^\alpha,T_t'^\alpha)}(f_t)(X_t)$.
By definition,
$$
L_{(T_t^\alpha,T_t'^\alpha)}(f_t)(X_t)= \left( \prod_{\gamma'\in T_t'^\alpha} X_t - \gamma_t'\right)
\left(\sum_{\gamma\in T_t^\alpha} \ell_{\gamma_t}(X_t) f_t(\gamma)\right).
$$
and $d_t:=\max_{\alpha\in{\cal U}_{t-1}} |T_t'^\alpha|$.
Now, by Equation~\eqref{eq:1=}, $\LM(\sum_{\gamma\in T_t^\alpha} \ell_{\gamma_t}(X_t) f_t(\gamma))=m$.
It follows that $$
\LM(g(\alpha))=\LM (X_t^{d_t-|T_t'^\alpha|} L_{T_t^\alpha,T_t'^\alpha}(f_t)(X_t)) = X_t^{d_t}m,
$$
for all $\alpha\in{\cal U}_{t-1}$.
The induction hypothesis applied to $g$ in Equation~\eqref{eq:Lrecurs}
permits to conclude.
\end{pf}

