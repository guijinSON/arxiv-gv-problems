With the base case treated, the induction can be carried through to prove that:
\begin{Theo}\label{th:LM3}
In general, 
the equality $ \min (\l G \cup \G_2\r) = \min (I)$ also holds.
\end{Theo}
The proof occupies  the remaining of the section. 
It goes by induction on $|G|=|\LL(\wtv)|$. The previous
lemma treats the base case $|G|=1$.
Assume that $|G|>1$, and let $\ii:=\min_{\precc} \LL(\wtv)$.
Define $f:=\LC_2(g_\ii)$. Note that $f\not =1$.
%%  which happens only
%% for $g_\jj$ where $\jj$ is the largest multi-integer in $\LL(V)$.
Since $\ii=(i_2,i_3)\in \LL(\wtv)$, then $W:=\wtv^{i_3,i_2}$ is not empty,
and since $|G|>1$, neither is $W'=V\setminus W$.
Let $J:=I(W)$ and $J'=I(W'$.

We summarize hereunder the next steps heading to the proof
of Theorem~\ref{th:LM3}.
\begin{enumerate}
\item $\min(I)= \min(J') \setminus \{\LM(f)\} \cup \{ \LM(f) m \ | \ m\in \min(J)\}$. 
\item The same equality holds for the $X_3$-elimination ideals
$I_2,J_2,J'_2$ which denotes the intersection with $k[X_1,X_2]$.
$\min(I_2)= \min(J'_2) \setminus \{\LM(f)\} \cup \{ \LM(f) m \ | \ m\in \min(J_2)\}$
\item By construction $\LL(\wt{W}') = \LL(\wtv) \setminus \{(i_2,\ldots,i_n)\}$
therefore the induction hypothesis supplies the equality: $\min(J') = \{ \XXX{j}
\ |\ (j_1,j_2,j_3)\in \LL'(\wt{W}') \} \cup \min(J_{n-1}')$.
\item The set $W$ verifies by construction $\LL(\wt{W})=\{(i_2,i_3)\}$
hence falls into the case of Lemma~\ref{lem:base3} which gives:
$\min(J) = \{ X_3^{i_3} \} \cup \min(J_{n-2}\}$.
\item Putting this in the equality 1. shows that: 
$\min(I) = \{ \XXX{j}
\ |\ (j_1,j_2,j_3)\in \LL'(\wt{W}') \} \cup \min(J_{n-1}')
\setminus\{\LM(f)\} \cup  \{ X_3^{i_3}\LM(f)  \} \cup \{ \LM(f) m\ |\ m\in \min(J_{n-2}) \}$.
\item and using the equalities in 2. and $\LM(f)=X_1^{i_1} X_2^{i_2}$
yeilds the equality:  $\min(I) = \{ \XXX{j} \ |\ (j_1,j_2,j_3)\in
\LL(\wtv)\} \cup \min(I_2)$. This is equivalent to the statement of Theorem~\ref{th:LM3}.
\end{enumerate}
In the strategy outlined in points 1.-6. above, only the two ones require a proof.
The point 2. can be deduced from the point 1., therefore we focus on
proving 1. in the following. This occupies the remaining of this section.

\begin{Lem}\label{lem:dec3}
Let $J:=I(W)$ and $J':=I(W')$.
 These ideals  satisfy the equalities
  $J'= I + \l f\r$,
and  $J = I:\l f\r$.

Consequently, letting $J'_2 := J'\cap k[X_1,X_2]$  and $J_2:=J \cap k[X_1,X_2]$,
also hold  $J'_2= I_2 + \l f\r$ and  $J_2 = I_2:\l f\r$.
\end{Lem}
\begin{pf} 
All ideals are radical here and thanks to the separability assumptions (H),
the Nullstellensatz is satisfied. It  suffices thus to prove that
$W = V \setminus (V\cap V(f))$ and that $W'= V \cap V(f)$.

To start with, the fact that $(i_2,i_3)$ is minimal in $\LL(V)$
implies that $V^{\le i_3} = V^{i_3}$ and $V^{i_3,\le i_2} = V^{i_3,i_2}$.
In the course of lemma~\ref{lem:vanish3}, it was shown that given
$\alpha_1'\in S_1'$, $f(\alpha_1',X_2)=0$ thereby
$\pi_{31}^{-1}(S_1')\cap V = \pi_{31}^{-1}(\pi_1(V^{i_3,>i_2})) \cap V = V^{i_3,>i_2}\subset V(f)$.
And moreover that for $\alpha_1\in S_1$ and $(\alpha_1,\alpha_2')\in S_2'[\alpha_1]$
$f(\alpha_1,\alpha_2')= 0$, implying that $\pi_{32}^{-1}(S_2' \cap \pi_{21}^{-1}(S_1))
= V^{>i_3} \cap V^{i_3,i_2} \subset V(f)$. 
Thus, $f$ vanishes on $(V^{>i_3} \cap V^{i_3,i_2}) \cup V^{i_3 , >i_2} =
V^{>i_3} \cap (V^{i_3,i_2} \cup V^{i_3,>i_2}) \cup V^{i_3,>i_2} 
= 
(V^{>i_3} \cap V^{i_3}) \cup V^{i_3,>i_2}$. By construction, $V^{>i_3}$
and $V^{i_3}$ are disjoint, thus $f$ vanishes  on $V^{i_3,>i_2}$
yielding $V\setminus V^{i_3,i_2} \subset V(f)$,
according to $V= V^{i_3,i_2} \cap V^{i_3,>i_2}$.

Reciprocally, given $(\alpha_1,\alpha_2) \in V^{i_3,i_2}$,
the proof of Lemma~\ref{lem:vanish3} shows that $f(\alpha_1,alpha_2)\not=0$,
yielding $ V \cap V(f) = \emptyset$. It follows that $W' = V \setminus W = V\cap V(f)$,
and hence that $W= V\setminus (V\cap V(f))$.

The proof for the  ideals in $k[X_1,X_2]$
is similar.
\end{pf}


The ideals $J$ and $J'$ are thereby co-maximal in $k[X_1,X_2,X_3]$, as
are the ideals $J_2$ and $J_2'$ in $k[X_1,X_2]$.
The following canonical map below is thus an isomorphism
{\small
\begin{eqnarray}
\nonumber \phi : k[X_1,X_2,X_3]/I  & \longrightarrow &   k[X_1,X_2,X_3]/J ' \times k[X_1,X_2,X_3]/J\\
\label{eq:phi3}p \bmod I & \longmapsto & \ \ p \bmod J ' \ \ \  \ ,\ \  p \bmod J
\end{eqnarray}
}
Taking leading monomials defines an isomorphism of $k$-vector spaces,
described below on the monomial bases:
{\small
\begin{eqnarray}
\nonumber \psi : k[X_1,X_2,X_3]/\l \LM(I)\r  & \longrightarrow & 
k[X_1,X_2,X_3]/\l \LM(J ')\r \times k[X_1,X_2,X_3]/\l \LM(J)\r \\
\label{eq:psi3}m \bmod \l \LM(I)\r & \longmapsto &  \ \ m \bmod \l \LM(J')\r \ \ \ ,\ \  m \bmod \l \LM(J)\r
\end{eqnarray}
}
In the same way, thanks to Lemma~\ref{lem:dec3} the following isomorphism holds:
{\small
\begin{eqnarray}
\nonumber \psi : k[X_1,X_2]/\l \LM(I_2)\r  & \longrightarrow & 
k[X_1,X_2]/\l \LM(J_2 ')\r \times k[X_1,X_2]/\l \LM(J_2)\r \\
\label{eq:psiII}m \bmod \l \LM(I_2)\r & \longmapsto &  \ \ m \bmod \l \LM(J_2
')\r \ \ \ ,\ \  m \bmod \l \LM(J_2)\r
\end{eqnarray}
}

In order to prove the points 1. and 2. above, we make explicit
the maps~\eqref{eq:psi3} and~\eqref{eq:psiII}.
To this end,
consider $Y':=\pi_2(W')$ and $Y:=\pi_2(W)$, so that
$J'_2 = I(Y')$ and $J_2=I(Y)$.
\begin{Lem}\label{lem:Y'3}
$Y'$ is the disjoint union of $\pi_2(V^{>i_3})$ and of
$\pi_2(\wtv^{i_3,>i_2})$.
\end{Lem}
\begin{pf}
The fact that the two right-hand sets are disjoint
comes from $\wtv^{i_3,>i_2}\subset \wtv^{i_3}$ and that
$\wtv^{i_3}=V^{i_3}$ which is disjoint from $V^{>i_3}$.

An element $(x_1,x_2)$ of $\pi_2(V)$ is in $Y'$ if 
and only if it is not in $Y=\pi_2(\wtv^{i_3,i_2})$.
Therefore $(x_1,x_2)$ does not verify $|\pi_{32}^{-1}(x_1,x_2)\cap
V|=i_3$ or does not verify $|\pi_{21}^{-1}(x_1) \cap \pi_1(V^{>i_3})|=i_2$.
Suppose it does not verify the former.
Then by minimality of $(i_2,i_3)$ for $\precc$, necessarily
$(x_1,x_2)\in \pi_2(V^{>i_3})$. If it does, then $(x_1,x_2)$
does not verify the latter, and $(x_1,x_2)\in \pi_2(\wtv^{i_3,>i_2})$.
This shows that any element of $Y'$ is either is one set or another and reciprocally.
\end{pf} 
\begin{Prop}\label{prop:f3}
$\LM(f)$ is in the minimal monomial basis of $\l \LM(J'_2)\r$.
%% Equivalently $\LM(I')  = \LM(I) \cup \{  \LM(f)\}$.
\end{Prop}
\begin{pf}
From the case $n = 2$ in \S~\ref{ssec:setup}, $\LM(f)=X_1^{i_1}X_2^{i_2}$
is a minimal monomial of $\l \LM(I'_2)\r$
if and only if $i_1:=|\pi_1(Y'^{>i_2})|$ as well as if $i_2\not=0$
the extra condition
$(\wtv^{i_3,i_2}\not= \emptyset \stackrel{(\star)}{\Rightarrow} Y'^{i_2}\not=\emptyset)$.
Let us prove  the latter implication first.

Given $(x_1,x_2,x_3)\in \wtv^{i_3,i_2}$, by equation~\eqref{eq:decWTV3}
$|\pi_{21}^{-1}(x_1) \cap S_2'|=i_2$, equivalently
$|\pi_{21}^{-1}(x_1) \cap \pi_2(V^{>i_3})| \stackrel{\small (\times)}{=} i_2$.
Because $\pi_2(V^{>i_3})\subset Y'$, holds
$|\pi_{21}^{-1}(x_1) \cap Y'| \ge i_2$.
Suppose the inequality is strict.
There is then a $y=(x_1,y_2)\in Y'\setminus \pi_2(V^{>i_3}) $,
and by Lemma~\ref{lem:Y'3}  $y\in \pi_2(\wtv^{i_3,>i_2})$.
Thus, $|\pi_{21}^{-1}(x_1) \cap S_2'|>i_2$,  in contradiction
with equality ${\scriptstyle (\times)}$.
Therefore, $|\pi_{21}^{-1}(x_1)\cap  Y'|=i_2$, and since $i_2\not=0$ it suffices
to pick up an element in $\pi_{21}^{-1}(x_1)\cap Y'$ to prove that
$Y'^{i_2}\not= \emptyset$, showing ${\scriptstyle (\star)}$.
The other necessary condition concerning $i_1$ is worked out
in the following lemma, which henceforth achieves the proof of Proposition~\ref{prop:f3}.

% $Y'^{i_2}\not = \emptyset$ or $i_2=0$, {\em and} $|\pi_1(Y'^{>i_2})|=i_1$.
% Recall some definitions:
% \begin{eqnarray}
% \label{eq:Y'1}
% Y' = \{ (y_1,y_2)\in \pi_2(V) \ \st\ \exists \, y_3 & {\rm with}& (y_1,y_2,y_3)\in V^{>i_3}\\
%  \label{eq:Y'2}&{\rm or} & (y_1,y_2,y_3)\in V^{i_3}\ \&\ |\pi_{21}^{-1}(y_1) \cap \pi_2(V^{>i_3})| > i_2\}.  
% \end{eqnarray}
% Thus,
% $Y'^{>i_2}  =  \{ (y_1,y_2) \in \pi_2(V) \ \st\ |\{\pi_{21}^{-1} (y_1) \cap Y'|>i_2\}$
% and since $\pi_2(V^{>i_3}) \subset Y'$ by~\eqref{eq:Y'1}, holds:
% \begin{equation}
% \label{eq:ineq}
% |\pi_{21}^{-1}(y_1) \cap \pi_2(V^{>i_3}) | \le |\pi_{21}^{-1} (y_1) \cap Y' |.
% \end{equation}
% The statement of Proposition~\ref{prop:f3} is henceforth contained in the following: 
\begin{Lem}\label{lem:i1}
$\pi_1(\wtv^{i_3,>i_2}) = \pi_1(Y'^{>i_2})$, in particular $i_1 := |\pi_1(\wtv^{i_3,>i_2})| =|\pi_1(Y'^{>i_2})|$.
\end{Lem}
\begin{pf}
Given $x_1\in \pi_1(\wtv^{i_3,>i_2})$, it verifies by definition
$|\pi_{21}^{-1}(x_1) \cap \pi_2(V^{>i_3})|>i_2$.
Since $\pi_2(V^{>i_3})\subset Y'$, this implies that
$|\pi_{21}^{-1}(x_1)\cap Y'|>i_2$, equivalently
$x_1\in \pi_1(Y'^{>i_2})$.

Reciprocally, given $y_1\in \pi_1(Y'^{>i_2})$ it verifies
$|\pi_{21}^{-1}(y_1)\cap Y'|\stackrel{(\cdot)}{>}i_2$.  
Suppose there is a $y_2$ such that $(y_1,y_2)\in \pi_2(V^{i_3})\cap Y'$.
Then $(y_1,y_2)\notin \pi_2(\wtv^{>i_3})$ 
and thus by Lemma~\ref{lem:Y'3} $(y_1,y_2)\in \pi_2(\wtv^{i_3,>i_2})$ as wanted.
If there is no such $y_2$, then  $\pi_{21}^{-1}(y_1)\cap Y'
=\pi_{21}^{-1}(y_1) \cap \pi_2(V^{>i_3})$. The inequality ${\scriptstyle (\cdot)}$ 
gives $|\pi_{21}^{-1}(y_1)\cap \pi_2(V^{>i_3})|>i_2$,
which by definition means $y_1\in \pi_1(\wtv^{i_3,>i_2})$.
\end{pf}
