+        "variables": 4,
+        "prime": 2013265921,
+        "coeff_bound": 2013265920,
+    },
+    "medium": {
+        "n": 8,
+        "variables": 4,
+        "prime": 2013265921,
+        "coeff_bound": 2013265920,
+    },
+    "hard": {
+        "n": 10,
+        "variables": 4,
+        "prime": 2013265921,
+        "coeff_bound": 2013265920,
+    },
+}
