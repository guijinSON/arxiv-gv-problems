\section{Concluding proof: leading monomial\label{sec:conclu}}
This last section is devoted to prove
that the polynomials $g_\ii$ of Definition~\ref{def:gi}
form a minimal Gr\"obner basis of $I$.
To achieve this, we follow  the gist of the strategy
of the case $n=3$ of \S~\ref{ssec:proof3}.
%% 
%% has been 
%% As a matter of fact, comparing to the case  $n=3$
%% treated in \S~\ref{ssec:proof3}
%% no serious additional difficulty
%% is brought by the general case $n>3$. 
%% %% It generalizes the proof of the case $n=3$
%% %% in~\S~\ref{sec:3}.
%% %% 
 
Let $G:=\{g_\ii\ \st \ \ii \in \LL(\wtv)\}$.
By induction on the number of variables $n$,
we can suppose that a minimal Gr\"obner basis $\G_{n-1}$
of $I_{n-1}$ is given by the polynomials constructed
in Definition~\ref{def:gi}.
The first step is to show that each polynomial $g_\ii$
vanishes on $V$. The second step consists in proving the
equality of leading monomial ideals:
$\l \LM(I)\r = \l \LM(\l G\cup \G_{n-1}\r)\r$.
\begin{Theo}
Each polynomial $g_\ii\in G$ vanishes on $V$.
\end{Theo}
\begin{pf}
Let $\beta\in V$ and $\alpha:=\pi_{n-1}(V)$.
The analysis done for the proof of
Proposition~\ref{prop:structure}
shows that if $\alpha\not\in {\cal U}_{n-1}$ then
$g_\ii(\alpha,X_n)=0$,
henceforth $g_\ii(\beta)=0$ as well.
Suppose that $\alpha\in {\cal U}_{n-1}$. By Proposition~\ref{prop:Ct}
$g_\ii(\alpha,X_n)\stackrel{(*)}{=}C_{n-1}(\alpha)h_{n-1}(\alpha)$, where $h_{n-1}=f_V$ 
(see definition of the function $f_V$ in Definition~\ref{def:gi}).
In particular $h_{n-1}(\alpha) = X_n^{i_n - |V[\alpha]|}
\prod_{\gamma\in V[\alpha]} X_n-\gamma_n$.
Now $\beta$ being in $V[\alpha]$,
it comes $h_{n-1}(\alpha)=0$, implying by $(*)$ that $g_\ii(\beta)=0$.
\end{pf}

\begin{Lem}\label{lem:|G|=1}
If $|G|=1$ then $\min(I)=\min(\l G\r) \cup \min(\l \G_{n-1}\r)$.
\end{Lem}
\begin{pf}
If $|G|=1$, then only one $V^{\ell}$ %% in Equation~\eqref{eq:33}
is not empty, say $\ell = i_n$. In particular $V^{>i_n}$ is empty
which implies that only $V^{i_n,0}$ is not empty inside the family
$(V^{i_n,\ell})_{\ell \in \N}$ and that $V^{i_n,0} = V = V^{i_n}=\wtv^{i_n}$.
If $n>2$, similarly $V^{i_n,>0}$ is empty, and the only non-empty
set in the family $(V^{i_n,0,\ell})_{\ell \in \N}$ is $V^{i_n,0,0}=V=\wtv^{i_n,0,0}$.
By repeating this, it is clear that $V^{i_n,0,\ldots,0}=V=\wtv^{i_n,0,\ldots,0}$,
where the number of 0s after $i_n$ may vary from 1 to $n-2$.
With exactly $n-2$ 0s, then  $S_1'=\pi_1(V^{i_n,0,\ldots,0,>0})=\emptyset$,
hence $i_1=|S_1'|=0$,
meaning that $\LL'(\wtv)=\{(0,\ldots,i_n)\}$.
In particular, the unique
element $g \in G$ verifies $\LM(g)=X_n^{i_n}$,
and therefore $\min(\l G\r) = \{ X_n^{i_n}\}$.

Because the ideal $I$ of vanishing polynomials on $V$ is of dimension zero,
there is a polynomial $f$ in a Gr\"obner basis $\G_n$
of $I$ such that $\LM(f)=X_n^\ell$ for some
$\ell>0$. Given $\beta=(\beta_1,\ldots,\beta_{n-1})\in \pi_{n-1}(V)$, the fiber $V[\beta]$
has cardinal $i_n$, and because $f(\beta,X_n)=X_n^\ell +\cdots$ must vanish
on $V[\beta]$, necessarily $\ell \ge i_n$. But since
$g\in I$, there exists a polynomial $h$ in $\G_n$ such that $\LM(h)|\LM(g)$,
and since $\G_n$ is minimal, necessarily $\LM(h)=\LM(f)$ implying that
$\ell \le i_n$, and henceforth $i_n = \ell$.

It remains to prove that $\min(I)=\{X_n^{i_n}\} \cup
\min(\l \G_{n-1}\r)$, more precisely that the inclusion $\subset$
holds, since the inclusion $\supset$ has been proved above.
Let $f\in\G_n$ satisfying  $\LM(f)\in \min(I)$.
Write $\LM(f)=\Xab{1}{n}{a}$ and let $\alpha\in \pi_{n-1}(V)$.
If $a_n\ge i_n$, then necessarily $a_n=i_n$ and $a_j=0$
for $j<n$, because $\LM(f)$ is assumed to be in the minimal
monomial basis $\min(I)$ of $\l \LM(I)\r$.
Assume $a_n<i_n$.
From the above, in this special case $\pi_{n-1}(V)=S_{n-1}$
and $|V[\alpha]|$ is constant equal to $i_n$ for
all $\alpha\in\pi_{n-1}(V)$.
Thus if $f(\alpha,X_n)\not =0$ then
$f(\alpha,X_n)=c X_n^{a_n}+\cdots$ must vanish
on $V[\alpha]$ which is not possible. Therefore
$f(\alpha,X_n)=0$ and $f\in I_{n-1}\, k[\XX{1}{n}]$.
But $\G_{n-1}$ being a Gr\"obner basis of this latter ideal,
it follows that $\LM(f) \in \min(\l\G_{n-1}\r)$.
This proves that $\min(I)\subset \{X_n^{i_n}\} \cup
\min(\l \G_{n-1}\r)$.
\end{pf}
With the base case treated, the induction on $|G|=|\LL(\wtv)|c$ an be initiated to prove:
\begin{Theo}\label{th:min(I)}
The equality $\min(I)=\min(\l G\r) \cup \min(\l \G_{n-1}\r)$ holds.
\end{Theo}

The proof occupies the remaining of the section.
\begin{Def}\label{def:f}
Assume $|G|>1$, and let $\ii:=\min_{\precc} \LL(\wtv)$.
Define $f:=\LC_{n-1}(g_\ii)$,
$W:=\wtv^{i_n,\ldots,i_3,i_2}$
and $W'=V\setminus W$.

Note that $f\not =1$, else $|G|=1$.
Since $\ii=(i_2,i_3,\ldots,i_n)\in \LL(\wtv)$,
$W:=\wtv^{i_n,\ldots,i_3,i_2}$ is not empty,
and since $|G|>1$, neither is $W'=V\setminus W$.
\end{Def}
\begin{Lem}\label{lem:dec}
Let $J:=I(W)$ and $J':=I(W')$. 
These ideals satisfy the equalities
$J'  = I + \l f\r$, and  $J = I :\l f\r$.
\end{Lem}
\begin{pf} 
By Lemma~\ref{lem:basicProperties} 2., $x\in W$ verifies
$\pi_k(x)\in S_k$ for all $k=1,\ldots,n-1$,
thus by Definition~\ref{def:gi}
$\pi_{n-1}(x)\in {\cal S}_{n-1}$. On the contrary, given $y\in W'$
$\pi_{n-1}(y) \notin {\cal S}_{n-1}$. Proposition~\ref{prop:Ct}
thus implies that $g_\ii(\xx{y}{1}{n-1},X_n) =0$ and more precisely
that $C_{n-1}(\xx{y}{1}{n-1})=\LC_{n-1}(g_\ii)(\xx{y}{1}{n-1}) =0$
with the notations therein.
It follows that $f(\xx{y}{1}{n-1})=0$ and $\pi_{n-1}(W')\subset V(f)$.
This proves that $I + \l f\r \subset J'$.
Moreover, we have seen that $\pi_{n-1}(x)$ for
$x\in V$ cancels $f$ if and only if $y\in W'$, proving that
the previous inclusion is actually an equality of ideals.
The same argument
shows that  $f(\xx{x}{1}{n-1})\not=0$ for all $x\in W$,
yielding $\pi_{n-1}(W) \cap V(f) =\emptyset$,
thus $V(f)\cap V \stackrel{(\bullet)}{=} V \setminus W=W'$.


For the equality concerning $J$,
recall that in general $V(I:J)=\con{V \setminus (V(J) \cap V)}$,
thus $V(I:\l f\r) = V \setminus (V(f) \cap V)$, according
that $f\in I$ and $V \setminus (V(f)\cap V)$ is finite hence equal to its
Zariski-closure, since points are taken over the algebraic closure of $k$.
Equality ${\scriptstyle {(\bullet)}}$ permits then to conclude.
\end{pf}


The Lemma above shows in particular that the ideal $J$ and $J'$
are co-maximal, yielding the following canonical isomorphism:
\begin{eqnarray}
\nonumber \phi : k[\X{n}]/I  & \longrightarrow &   k[\X{n}]/J ' \times k[\X{n}]/J\\
\label{eq:phi}p \bmod I & \longmapsto & \ \ p \bmod J ' \ \ \  \ ,\ \  p \bmod J
\end{eqnarray}
Taking leading monomials defines an isomorphism of $k$-vector spaces,
described below on the monomial bases:
\begin{eqnarray}
\nonumber \psi : k[\X{n}]/\l \LM(I)\r  & \longrightarrow & 
k[\X{n}]/\l \LM(J ')\r \times k[\X{n}]/\l \LM(J)\r \\
\label{eq:psi}m \bmod \l \LM(I)\r & \longmapsto &  \ \ m \bmod \l \LM(J
')\r \ \ \ ,\ \  m \bmod \l \LM(J)\r
\end{eqnarray}

\medskip

\noindent \textsf{Remark:}
Let $J_{n-1}:= J \cap k[\XX{1}{n-1}]$,
$J'_{n-1} := J \cap k[\XX{1}{n-1}]$ and $I_{n-1}:=I \cap k[\XX{1}{n-1}]$.
Since $f\in k[\XX{1}{n-1}]$,
it can be proved that $J'_{n-1}= I_{n-1} + \l f \r$
and that $J_{n-1} = I_{n-1} : \l f \r$.
In particular the isomorphism
$\phi$ and $\psi$ defined just above, when taking relevant intersections with
$k[\XX{1}{n-1}]$, induce the following isomorphism:
{\small
\begin{eqnarray}
\nonumber \psi' : k[\X{n-1}]/\l \LM(I_{n-1})\r  & \longrightarrow & 
k[\X{n-1}]/\l \LM(J_{n-1} ')\r \times k[\X{n-1}]/\l \LM(J_{n-1})\r \\
\label{eq:psi2}m \bmod \l \LM(I_{n-1})\r & \longmapsto &  \ \ m \bmod \l \LM(J_{n-1}
')\r \ \ \ ,\ \  m \bmod \l \LM(J_{n-1})\r
\end{eqnarray}
}
\smallskip

The zero-set $W = \wtv^{i_{n-1},\ldots,i_2}$ falls into the case of Lemma~\ref{lem:|G|=1}, hence
$\min(J) = \{ X_n^{i_n}\}\cup \min(J_{n-1})$.
As for $W'$, by construction
$\LL(\wt{W'}) = \LL(\wtv)\setminus \{(i_2,\ldots,i_n)\}$
therefore the induction hypothesis on $|\LL(\wtv)|$  gives
$\min(J') = \{ \Xab{1}{n}{j} \ \st \ \jj \in \LL'(\wt{W'})\}
\cup \min(J'_{n-1})$. In this way, $\min(J)$ and $\min(J')$ are known. 
%% 
%% Hence $\LM(I)=\LM(I_2)\cup \LM(I') \cup \l \XXX{i}\r$.
%% By induction on the number of variables, $\LM(I_2)$ is given
%% by the case $n=2$ of \S~\ref{ssec:setup}.
%% The induction on $|\LL(V)|$
%% 
The purpose of the remaining is to determine $\min(I)$
from the two known data $\min(J)$ and $\min(J')$. The
strategy consists in making explicit the map~\eqref{eq:psi}.
The following fundamental theorem plays a crucial role to this end.

\begin{Theo}\label{thm:f}
$\LM(f)$ is in the minimal monomial basis of $\l \LM(J'_{n-1}) \r$.
%% Equivalently $\LM(I')  = \LM(I) \cup \{  \LM(f)\}$.
\end{Theo}
\begin{pf}
Let $Y':=\pi_{n-1}(W')$. Then $I(Y') = J_{n-1}'$.
The proof of Lemma~\ref{lem:|G|=1} shows that $i_{n-1} = 0$ if and only
if $|G|=1$, therefore we have here $i_{n-1}\not=0$.
According to Definition~\ref{def:L(V)},
the theorem is then equivalent to $\wty'^{i_{n-1},\ldots,i_2}\not=\emptyset$
and $i_1=|\pi_1(\wty'^{i_{n-1},\ldots,i_3,>i_2})|$.
Both statements follow from Proposition~\ref{prop:delete}.
\end{pf}

\begin{Cor}\label{cor:L}
Let $L := \LM(I) + \l \LM(f) \r$ and $L_{n-1}:= L \cap k[\X{n-1}]$.
They satisfy the equalities $L=\l \LM(J')\r$ and thus
$L_{n-1}=\l \LM(J_{n-1}')\r$.
%% The canonical linear onto map in~\eqref{eq:psi} is given on the
%% monomial basis by
%% \begin{eqnarray*}
%% k[\X{n-1}]/\l \LM(I_{n-1})\r & \to &  k[\X{n-1}]/\l \LM(J'_{n-1})\r \\
%% m & \mapsto &  0\ \text{if $\LM(f)\mid m$, \ \  or }
%% \ \ m  \ \text{if $\LM(f)\nmid m$}
%% \end{eqnarray*}
%% and extended by linearity.
\end{Cor}

\begin{pf}
The inclusion $ \LM(J') \subset L$ is folklore. Let $\min(I)=\{ n_1,\ldots,n_s,m_1,\ldots,m_t\}$ where $\min(I_{n-1})
=\{ n_1,\ldots,n_s\}$  and $m_i\in k[\X{n}] \setminus k[\X{n-1}]$.
By the previous theorem, $\{ n_1,\ldots,n_s,\LM(f),m_1,\ldots,m_t\}\subset \l \LM(J')\r$, yielding:
$$
L\subseteq \l n_1,\ldots,n_s,\LM(f),m_1,\ldots,m_t\r\subseteq \l \LM(J')\r
\subseteq L.
$$
Actually, this proof works also for $\LM(J'_{n-1})$ and $L_{n-1}$ instead
of $\LM(J)$ and $L$ by 
using only the monomials $n_1,\ldots,n_s$.
\end{pf}

\begin{Cor}\label{cor:K}
The ideals  $K:=\l \LM(I)\r : \l\LM(f)\r$ and $K_{n-1}:= K\cap k[\X{n-1}]$
satisfy $K=\l \LM(J)\r$ and $K_{n-1}=\l \LM(J_{n-1})\r$.
\end{Cor}

\begin{pf}
The inclusion $\LM(J)\subset K$ is elementary. 
Consider the onto canonical linear map:
$$
\rho : k[\X{n}]/\l \LM(J)\r \to k[\X{n}]/K.
$$
On the  other hand, consider the  isomorphism of $k$-vector spaces:
\begin{eqnarray}
\nonumber \theta : k[\X{n}]/\l \LM(I)\r  & \longrightarrow & 
k[\X{n}]/L \times k[\X{n}]/ K\\
\label{eq:theta} m \bmod \l \LM(I)\r & \longmapsto & m \bmod
\LM(f) \  ,\ m \quo \LM(f)
\end{eqnarray}
Comparing with $\psi$ in~\eqref{eq:psi},
one sees that $\theta_2=\rho{\scriptstyle \circ} \psi_2$,
(where for $i=1,2$ a $\theta_i, \psi_i$ are the $i$-th component maps of $\theta$ and $\psi$).  
Morevoer, according to Corollary~\ref{cor:L} $\theta_1=\psi_1$. 
Therefore, $\rho$ must be an isomorphism and since it is defined
as the canonical projection, it is the identity map,
showing that $K=\l \LM(J)\r$.

To prove the equality concerning $K_{n-1}$ is suffices
to be convinced that $(\l \LM(I)\r :\l \LM(f)\r ) \cap k[\X{n-1}]$
is equal to $\l \LM( ( I:f) \cap k[\X{n-1}])\r$ which presents no difficulty.
\end{pf}

\paragraph{Proof of Theorem~\ref{th:min(I)}: final argument.}
The isomorphism $\theta$ in~\eqref{eq:theta} shows
that $\min(I) = \min(L)\setminus \{\LM(f)\} \cup \{ m \LM(f)\ | \ m\in \min(K)\}$.
Corollaries~\ref{cor:L} and~\ref{cor:K} show that $\min(L)=\min(J')$ and $\min(K)=\min(J)$
as well as $\min(L_{n-1})=\min(J'_{n-1})$ and $\min(K_{n-1}) = \min(L_{n-1})$.
Next, the discussion made before Theorem~\ref{thm:f} 
tells that $\min(J)=\{X_n^{i_n}\} \cup \min(J_{n-1})$
and $\min(J')= \{ \Xab{1}{n}{j} \ |\ \jj \in  \LL'(\wt{W'})\} \cup \min(J_{n-1}')$. 
Consequently, 
\begin{eqnarray}\label{eq:last}
\nonumber \min(I) = \{ \Xab{1}{n}{j} \ |\ \jj \in  \LL'(\wt{W'})\} \cup \min(J_{n-1}')
\setminus \{\LM(f)\} \cup \{\LM(f) X_n^{i_n}\} \cup \\ \cup \{ \LM(f) m' \ | \ m'\in \min(J_{n-1})\}.
\end{eqnarray}
Besides, the proof of Corollary~\ref{cor:K} also shows that the isomorphisms $\psi$ in~\eqref{eq:psi}
and $\theta$ in~\eqref{eq:theta} actually coincide.
Therefore isomorphism $\psi'$ in~\eqref{eq:psi2}
is actually equal to:
\begin{eqnarray*}
 k[\X{n-1}]/\l \LM(I_{n-1})\r  & \longrightarrow & 
k[\X{n-1}]/L_{n-1} \times k[\X{n-1}]/ K_{n-1}\\
 m \bmod \l \LM(I_{n-1})\r & \longmapsto & m \bmod
\LM(f) \  ,\ m \quo \LM(f)
\end{eqnarray*}
supplying the equality $\min(I_{n-1})=
\min(J_{n-1}')\setminus \{\LM(f)\} \cup \{ m \LM(f)\ | \ m'\in \min(J_{n-1})\}$.
When applied to  Equality~\eqref{eq:last}  this gives:
$$
\min(I) = 
  \{ \Xab{1}{n}{j} \ |\ \jj \in  \LL'(\wt{W'})\}  \cup \{\LM(f) X_n^{i_n}\} \cup \min(I_{n-1}).
$$
Finally, remember that $\LL'(\wtv) = \LL'(\wt{W'}) \cup \{ (i_1,i_2,\ldots,i_n)\}$,
and that $\LM(f) = \Xab{1}{n-1}{i}$, so that:
$$
\min(I) =    \{ \Xab{1}{n}{j} \ |\ \jj \in  \LL'(\wt{V})\} \cup \min(I_{n-1}).
$$
This is equivalent to the equality of Theorem~\ref{th:min(I)} achieving its proof.

