+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "The sums of the coordinate values in each projection fiber expose "
+        "the hidden triangular linear forms; without that change of variables "
+        "one reconstructs the point ideal by evaluation-matrix elimination."
+    ),
+    "hardness_basis": (
+        "Track B: the Buchberger-Moller evaluation-matrix algorithm reconstructs "
+        "the point ideal in polynomial time (O(d*m^3) field operations in this "
+        "implementation for m points); at the hard preset it measured about "
+        "20 million exact field operations and one second per instance, versus "
+        "at most 217 counted operations for the fiber-sum change of variables."
+    ),
+    "max_answer_tokens": 52,
+}
+
+NATIVE: dict = {
