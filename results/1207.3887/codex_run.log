%%  y & \longmapsto & | \{ \pi_{\ell,\ell-1}^{-1} (\pi_{\ell-1}(y))
%%  S\}|.
%% \end{eqnarray*}
This permits to define for each $\ell\in\N$,
$$
\wtv^\ell=V^\ell := \phi_{V,n}^{-1}(\ell)
$$ 
%% \qquad
%% \text{and}\qquad 
%% \wtv^\ell := \wt{\phi}_{V,V,\ell}^{-1}(\ell )
%% $$
%% Actually, $\wtv^\ell = V^{\ell}$.
Since $V$ is finite almost all $V^\ell$ are empty and the family
$(V^\ell)_{\ell\in \N}$ is a partition of $V$.
Let $i_n$ be the last coordinate of $\ii$ and introduce the following
notations:
$$
V^{>i_n}:=\bigcup_{\ell > i_n} V^{\ell} \quad \text{and}
\quad V^{\le i_n} :=\bigcup_{\ell\le i_n} V^{\ell}, \quad
\text{so that} \quad V=V^{\le i_n} \cup V^{>i_n}.
$$
Furthermore, let $S_{n-1}:=\pi_{n-1}(V^{\le i_n})$ and
$S_{n-1}':=\pi_{n-1}(V^{>i_n})$.

Consider next $i_{n-1}$ the next to last coordinate of $\ii$. Define:
\begin{equation}\label{eq:induct}
V^{i_n,\ell}:=\phi_{S_{n-1,n-1}}^{-1}(\ell)\qquad
\text{and}\qquad  \wtv^{i_n,\ell} := \phi_{S_{n-1},n-1}^{-1}(\ell)\cap \wtv^{i_n}=V^{i_n,\ell}\cap V^{i_n}.
\end{equation}
As before, almost all $V^{i_n,\ell}$ are empty, and
$(V^{i_n,\ell})_{\ell \in \N}$  is a partition of $V$.
Similarly almost all $\wtv^{\ell,i_3}$ are empty and
those who are not form a partition of $\wtv^{\ell}=V^\ell$.
Let
$$
V^{i_n,\le i_{n-1}}:=\bigcup_{\ell \le i_{n-1}} V^{i_n,\ell}\quad
\text{and}
\quad V^{i_n,> i_{n-1}} := \bigcup_{\ell > i_{n-1}} V^{i_n,\ell},
$$
and $S_{n-2}:=\pi_{n-2}(V^{i_n,\le i_{n-1}})$,
$S_{n-2}':=\pi_{n-2}(V^{i_n, >  i_{n-1}})$.

\subsection{Induction\label{sec:induction}}
Assume that by induction are constructed two families
$(S_{n-1},\ldots, S_j)$ and $(S_{n-1},\ldots, S_j)$,
 as well as two  families:
$$
((V^\ell)_{\ell\in \N},(V^{i_n,\ell})_{\ell \in \N},\ldots ,
(V^{i_n,i_{n-1},\ldots,i_{j+2},\ell})_{\ell \in \N}),
\quad \text{all are partitions of $V$}
$$
and $\ 
((V^\ell)_{\ell\in \N},(\wtv^{i_n,\ell})_{\ell \in \N},\ldots ,
(\wtv^{i_n,i_{n-1},\ldots,i_{j+2},\ell})_{\ell \in \N})$,
where $\ (\wtv^{i_n,i_{n-1},\ldots,i_{j+k},\ell})_{\ell \in \N}$
is a partition of $\wtv^{i_n,i_{n-1},\ldots,i_{j+k}}$,
such that $S_j'=\pi_j(V^{i_n,\ldots,i_{j+2},>i_{j+1}})$ and 
$S_j=\pi_j(V^{i_n,\ldots,i_{j+2},\le i_{j+1}})$. 
%a family:
%$$
%((\wtv^\ell)_{\ell\in \N},(\wtv^{i_n,\ell})_{\ell \in \N},\ldots ,
%(\wtv^{i_n,i_{n-1},\ldots,i_4,\ell})_{\ell \in \N}),
%$$
%having the following property for each $j=4,\ldots n$: $(\wtv^{i_n,i_{n-1},\ldots,i_j,\ell})_{\ell \in \N}$
%is a partition of $\wtv^{i_n,i_{n-1},\ldots,i_j}$.

Let $\kk:= i_n , i_{n-1} ,  \ldots,  i_j$.
%%  and let $\rev{\jj}:=i_n,\ldots,i_3$.
The aim now is to construct $S_{j-1}$, $S_{j-1}'$, a partition
$(V^{ \kk,\ell})_{\ell \in \N}$ of $V$,
and a partition  $(\wtv^{ \kk , \ell })_{\ell \in \N}$
of $\wtv^{ \kk }$.
Recall that $i_j$ is the $j$-th coordinate of $\kk$.
\begin{equation}\label{eq:induc0}
V^{\kk,\ell}:=\phi_{S_j,j}^{-1}(\ell) \qquad
\text{and}\qquad \wtv^{\kk,\ell} := \phi_{S_j,j}^{-1}(\ell)\cap \wtv^{\kk}.
\end{equation}
Again, the family $(V^{\jj,\ell})_{\ell \in\N}$ is a partition of $V$.
In a similar way as before, we introduce the following convenient notations:
\begin{equation}\label{eq:induc}
V^{\kk,\le i_j}:=\bigcup_{\ell \le i_j} V^{\kk,\ell}\quad
\text{and}\quad V^{\kk,>i_j}:=\bigcup_{\ell>i_j} V^{\kk,\ell}.
\end{equation}
Finally, we define $S_{j-1}':=\pi_{j-1}(V^{\kk,>i_j})$
and $S_{j-1}':=\pi_{j-1}(V^{\kk,\le i_j})$. 
Despite these two sets depend on $V$ and $\ii$,
the notations do not refer to this. It will not be confusing though,
since the construction above will always be applied to $V$ and $\ii$,
except in Proposition~\ref{prop:delete}, which forces to precise things and 
to make the notations heavier in the course of its proof.
This achieves the construction of the four families that we sought for.

Using this inductive construction,
it is possible to ultimately define the combinatorial
decomposition of $V$ that was mentioned in the introduction
and in \S~\ref{sec:3}:
\begin{equation}\label{eq:mainDec}
V=\bigcup_{\ell \in \N} V^{i_n,\ldots,i_3,\ell}.
\end{equation}
The 3 other by-product objects coming with it, 
 $(S_j)_{j=n-1,\ldots,1}$,
$(S_j')_{j=n-1,\ldots,1}$,
and $(\wtv^{i_n,\ldots,i_3,\ell})_{\ell\in \N}$
will reveal also crucial for the interpolation formulas
of the next section. 
Some basic properties related to these objects are also in order.

\begin{Lem}\label{lem:basicProperties}
The sets constructed in the \S~\ref{sec:induction} above
verify the following properties:
\begin{enumerate}
\item $S_j\cap S_j' = \emptyset$ and
$\pi_j(V)=S_j \cup S_j'$, for $1\le j \le n-1$.
\item $\wtv^{i_n,\ldots,i_{\ell+1}} = \{ x\in V\ | \ |\pi_{k,k-1}^{-1}(x_1,\ldots,x_{k-1}) \cap S_k'|=i_k,\ 
\ \text{for}\ k=\ell+1,\ldots,n\}$
\item $\pi_\ell(\wtv^{i_n,\ldots,i_{\ell+1}})=\pi_\ell(V^{i_n,\ldots,i_{\ell+1}})$,
and therefore $S_\ell'=\pi_\ell(\wtv^{i_n,\ldots,>i_{\ell+1}})$.
\end{enumerate}
\end{Lem}
\begin{pf}
For Point 1., the first equality is a consequence of: an element
$x=(\xx{x}{1}{j})\in S_j'=\pi_j(V^{i_n,\ldots,i_{j+2},> i_{j+1}})$ verifies $|\pi_{j+1,j}^{-1}
(x) \cap S_{j    +1}'|>i_{j+1}$ whereas an element $y=(\xx{y}{1}{j})
\in S_j=\pi_j( V^{i_n,\ldots,i_{j+2},\le i_{j+1}})$ verifies
the condition $|\pi_{j+1,j}^{-1}
(x) \cap S_{j    +1}'|\le i_{j+1}$, according to Definitions~\eqref{eq:induc}
and~\eqref{eq:induc0}.
The second equality is due to the fact that 
$V^{i_n,\ldots,i_{j+2},\le i_{j+1}}
\cup V^{i_n,\ldots,i_{j+2},> i_{j+1}} = V$ is a partition of $V$.

Point 2. is a mere  restatement of the definitions.
Indeed, 
$$
\wtv^{i_n,\ldots,i_{\ell+1}}=\{ x\in \wtv^{i_n,\ldots,i_{\ell+2}}
\ | \ |\pi_{\ell+1,\ell}^{-1}(x_1,\ldots,x_\ell) \cap S_{\ell+1}'|=i_{\ell+1}\}.
$$
Thus, since $x\in \wtv^{i_n,\ldots,i_{\ell+2}}$ it verifies
$|\pi_{\ell+2,\ell+1}^{-1}(x_1,\ldots,x_{\ell+1}) \cap S_{\ell+1}|=i_{\ell+1}$
as well as $x\in \wtv^{i_n,\ldots,i_{\ell+3}}$ which in
turn implies that it verifies $|\pi_{\ell+3,\ell+2}^{-1}(x_1,\ldots,x_{\ell+2}) \cap S_{\ell+2}'|=i_{\ell+2}$ and so on.

To prove 3. we proceed by decreasing induction on $\ell=n-1,\cdots,1$.
For the base case $\ell =n-1$, we have $\wtv^{i_n}=V^{i_n}$ and thus
$\pi_{n-1}(\wtv^{i_n})=\pi_{n-1}(V^{i_n})$.
Suppose next that $\pi_j(\wtv^{i_n,\ldots,i_{j+1}}) = \pi_j(V^{i_n,\ldots,i_{j+1}})$,
for all $j=n-1,\ldots,\ell+1$.
Given $x\in  V^{i_n,\ldots,i_{\ell+1}}$, it verifies by definition
$| \pi_{\ell+1,\ell}^{-1}(x_1,\ldots,x_\ell)\cap  S_{\ell+1} | \stackrel{{\small (o)}}{=} i_{\ell+1}$.
By induction hypothesis, $(x_1,\ldots,x_{\ell+1}) \in \pi_{\ell+1}(\wtv^{i_n,\ldots,i_{\ell+2}})$
and by Point 2. above,  verifies $|\pi_{j+1,j}^{-1}(x_1,\ldots,j)\cap S'_{j}|=i_{j}$
for $j=\ell+2,\ldots,n-1$. With the equality ${\small (o)}$ and by Point 2.,
this means that $(x_1,\ldots,x_\ell)\in \wtv^{i_n,\ldots,i_{\ell+1}}$.
Therefore $\pi_\ell(V^{i_n,\ldots,i_{\ell+1}}) \subset \pi_\ell(\wtv^{i_n,\ldots,i_{\ell+1}})$.
The other inclusion being clear, this achieves the proof by induction.
\end{pf}

The next subsection studies properties of these sets after deletion of one these blocks.
This part is crucial for the inductive nature of the proof coming afterward.

\subsection{Properties after deletion of the smallest block}
As sketched for the case $n=3$, the multi-integers
$\ii=(i_2,\ldots,i_n)$  for which $\wtv^{i_n,\ldots,i_2}$ is not empty
are related to the exponent of the minimal monomial basis.
This motivates the generalization of the sets $\LL(\wtv)$ and
$\LL'(\wtv)$ defined in Equation~\eqref{eq:L(V)3} and~\eqref{eq:L'(V)3}.

\begin{Def}\label{def:L(V)}
Let $\LL(\wtv)$ be the set
of  $\ii=(i_2,\ldots,i_n)\in \N^{n-1}$
such that $\wtv^{i_n,\ldots,i_2}\not=\emptyset$.
Define:
$$
\LL'(\wtv):=\{ (i_1,i_2,\ldots,i_n) \in \N^{n} \st\ (i_2,\ldots,i_n)\in \LL(\wtv)
\ \text{and}\ i_1=|\pi_1(V^{i_n,\ldots,i_3,>i_2})| \}.
$$
\end{Def}

In the remainder  of this subsection, is assumed that $|\LL'(\wtv)|>1$,
and we let $\ii:=\min_\precc \LL'(\wtv)$. Let $W:=\wtv^{i_n,\ldots,i_2}$,
$W':=V\setminus W$ and $Y':=\pi_{n-1}(W')$. 
\begin{Lem}\label{lem:Y'}
$Y'$ is the disjoint union of: $Y'=\pi_{n-1}(\wtv^{>i_n}) \bigcup\limits_{\ell=2}^{n-1} \pi_{n-1}(\wtv^{i_n,\ldots,>i_\ell})$.
\end{Lem}
\begin{pf}
From Lemma~\ref{lem:basicProperties} 2., $x\in V^{i_2,\ldots,i_n}$ is equivalent
to  $|\pi_{j+1,j}^{-1}(x_1,\ldots,x_j) \cap \pi_j(\wtv^{i_n,\ldots,>i_{j+1}})|\stackrel{{\small *_j}}{=}i_j$
for $j=2,\ldots,n-1$ and $|\pi_{n,n-1}^{-1}(x_1,\ldots,x_{n-1}) \cap V|\stackrel{{\small *_n}}{=}i_n$.

Now, $y\in W'$ if and only if  $y\notin V^\ii$ and therefore if and only if
there exists a maximal $2\le j \le n$
such that the equality ${\small *_j}$ is not true. Then instead of an equality,
it can only be a $>$, otherwise $\ii$ would not be minimal for $\precc$ in $\LL'(\wtv)$.
From  the definitions, it means that $y\in \wtv^{i_n,\ldots,>i_{j+1}}$
and that $y\notin \wtv^{i_n,\ldots,>i_{k}}$ for $k>j+1$.
Neither holds $y\in \wtv^{i_n,\ldots,>i_k}$ for $k<j$ because
$\wtv^{i_n,\ldots,>i_k}\subset \wtv^{i_n,\ldots,i_{k+1}}\subset \wtv^{i_n.\ldots,i_j}$
for these values of $k$. This proves
that $W'=\wtv^{>i_n} \bigcup_{\ell=2}^{n-1}  \wtv^{i_n,\ldots,>i_\ell}$
and that the union is disjoint.
Taking projections $\pi_{n-1}$ proves the equality in the lemma.
\end{pf}
\begin{Prop}\label{prop:delete} We can apply
the construction of \S~\ref{sec:decomp} to $Y':=\pi_{n-1}(V\setminus \wtv^{i_n,\ldots,i_2})$
and to the multi-integer $\jj=(i_2,\ldots,i_{n-1})$ instead of $V$ and of $\ii=(i_2,\ldots,i_n)$. This defines similarly
families of sets $Y^{i_{n-1},\ldots,i_\ell}$. They verify:
%% (the notations $S_\ell$ and $S_\ell'$ used therein and attached for $V$, should ).
\begin{enumerate}
\item $\pi_\ell(\wtv^{i_n,\ldots,>i_{\ell+1}})\subset \pi_\ell (Y'^{i_{n-1},\ldots,>i_{\ell+1}})$ for $\ell=1,\ldots,n-2$. 
\item $\wty'^{i_{n-1},\ldots,i_2}\not=\emptyset$ if $i_{n-1}\not=0$.
\item $\pi_1(\wtv^{i_n,\ldots,>i_2}) = \pi_1(\wty'^{i_{n-1},\ldots,>i_2})$.
\end{enumerate}
\end{Prop}

\noindent \textsf{Remark:} 
Locally in this proof, we overload the notations $S_\ell'$
introduced in \S~\ref{sec:decomp}. Indeed, therein it is attached
to $V$ and $\ii$, and the notations should refer to them
so that no confusion arise with the similar construction attached
to $Y'$ and $\jj$. Therefore, let $S_\ell'^{V,\ii}=\pi_\ell(\wtv^{i_n,\ldots,>i_{\ell+1}})$
and $S_\ell'^{Y',\jj}=\pi_\ell(\wty ^{i_{n-1},\ldots,>i_{\ell+1}})$.
With this, Point 1. and Point 3 can be rewritten as:
\begin{enumerate}
\item[1.] $S_\ell'^{V,\ii}\subset S_\ell'^{Y',\jj}$  for $\ell=1,\ldots,n-2$.
\item[3.] $S_1'^{V,\ii} = S_1'^{Y',\jj}$.
\end{enumerate}
\begin{pf}
The first point is proved by decreasing induction on $\ell=n-1,\ldots,1$.
The base step amounts to show that $\pi_{n-1}(V^{>i_{n}}) \subset Y'$.
This is contained in Lemma~\ref{lem:Y'}.
Next we assume the statement true for a given $\ell+1>1$
and let us prove it for $\ell$.
Let $x \in \wtv^{i_n,\ldots,>i_{\ell+1}}$, so that $(x_1,\ldots,x_\ell)\in S_\ell'^{V,\ii}$.
By definition of $S_{\ell}'^{V.\ii}$, the inequality
$|\pi_{\ell+1,\ell}^{-1}(x_1,\ldots,x_{\ell}) \cap S_{\ell+1}'^{V,\ii}| > i_{\ell+1}$ holds.
By induction hypothesis, $S_{\ell+1}'^{V,\ii}\subset S_{\ell+1}'^{Y',\jj}$
hence $|\pi_{\ell+1,\ell}^{-1}(x_1,\ldots,x_\ell) \cap S_{\ell+1}'^{Y',\jj}| > i_{\ell+1}$.
Consequently, $\phi_{S_{\ell+1}'^{Y',\jj},\ell+1} (x) > i_{\ell+1}$
and in virtue of Equality~\eqref{eq:induct}, $(x_1,\ldots,x_\ell)\in
\pi_\ell(\wty^{i_{n-1},\ldots,>i_{\ell+1}})$.
\smallskip

Let us turn out to the proof of 2. 
Remember that $\ii$ has been chosen as the minimal
element of $\LL'(V)$ and according
to Definition~\ref{def:L(V)}, $\wtv^\ii \not= \emptyset$.
Let $x\in \wtv^\ii$ fixed.
For $\ell=2,\ldots,n-1$ define $A_\ell:=\pi_{\ell,\ell-1}^{-1}(x_1,\ldots,x_{\ell-1})\cap S_\ell'^{V,\ii}$
and $A_n:=\pi_{n,n-1}^{-1}(\xx{x}{1}{n})\cap V$.
By Lemma~\ref{lem:basicProperties} point 2., $x\in \wtv^\ii$ is equivalent to
$ |A_\ell|= i_\ell$ for $\ell=2,\ldots,n$.
%% Let us prove that $\pi_{n-2}(x)\in \pi_{n-2}(\wty'^{i_{n-1},\ldots,i_2})$.
%% By Lemma~\ref{lem:basicProperties} (point 2. applied to $Y'$ and $\jj$) this amounts to prove that
Let us prove that for $\ell=1,\ldots,n-1$ holds
$|B_\ell|=i_\ell$, where $B_\ell := \pi_{\ell,\ell-1}^{-1}(x_1,\ldots,x_{\ell-1})
\cap \pi_\ell(\wty'^{i_{n-1},\ldots,>i_{\ell+1}})$ if $\ell<n-1$
(and $B_{n-1}:=\pi_{n-1,n-2}^{-1}(x_1,\ldots,x_{n-2}) \cap Y'$).
According to Point 1., $S_\ell'^{V,\ii} \subset S_\ell'^{Y',\jj}$
yielding  $|A_\ell|\le |B_\ell|$. We show that for each $\ell$
a strict inequality $|A_\ell| < |B_\ell|$ can not occur.


Assume first $\ell=n-1$. 
If the inequality $|A_\ell|\le |B_\ell|$ were strict, then there would exist $y=(x_1,\ldots,x_{n-2},y_{n-1})
\in Y'\setminus S_{n-1}'^{V,\ii}$. By Lemma~\ref{lem:Y'}
$y\in \pi_{n-1}(\wtv^{i_n,\ldots,>i_k})$ for a $2\le k \le n-1$,
%% either $y\in \pi_{n-1}(V^{>i_n})$.
Then $|\pi_{k,k-1}^{-1}(\xx{x}{1}{k-1}) \cap S_k'^{V,\ii}|> i_k$,
contradicts $|A_k|=i_k$. Therefore there is no such $y$,
and $|B_{n-1}|=|A_{n-1}|=i_{n-1}$.


Next assume that $\ell < n-1$ and suppose again that the inequality
$ |A_\ell| \le |B_\ell|$ is strict.
Thus there is a $y=(x_1,\ldots,x_{\ell-1},y_\ell)
\in S_\ell'^{Y',\jj} \setminus S_\ell'^{V,\ii}$.
By Lemma~\ref{lem:Y'}, $y$ belongs either
to $\pi_{\ell}(\wtv^{i_n,\ldots,>i_{k+1}})$ for a $1\le k \le  n-2$ distinct
from $\ell$, either to $\pi_\ell(V^{>i_n})$.
Note that $k<\ell$ can not occur since  $\pi_k(y)=\pi_k(x)
\in \pi_k(V^\ii) \subset \pi_k(\wtv^{i_n,\ldots,i_{k+1}}) = S_k^{V,\ii}$
would contradict $\pi_k(y) \in \pi_k(\wtv^{i_n,\ldots,>i_{k+1}}) = 
S_k'^{V,\ii}$, according that $S_k'^{V,\ii} \cap S_k^{V,\ii}=\emptyset$.
Thus $y\in \pi_\ell(\wtv^{i_n,\ldots,>i_{k+1}})$ for a $k>\ell$.
%% Then $\pi_k(y)=\pi_k(x) \in \pi_k(\wtv^{i_n,\ldots,>i_{k+1}}) = S_k'^{V,\ii}$.
%% By point 1. of Lemma~\ref{lem:basicProperties}, $\pi_k(x)\notin S_k^{V,\ii}$.
%% But by definition of the sequence $(\wtv^{\dots})$,
%% $\wtv^{i_n,\ldots,i_2}\subset \wtv^{i_n,\ldots,i_{k+1}}$,
%% yielding $\pi_k(x)\notin \pi_k(\wtv^{i_n,\ldots,i_2})$ in contradiction
%% with $x\in \wtv^{i_n,\ldots,i_2}$.
%% Assume now that $y\in \pi_\ell(\wtv^{i_n,\ldots,>i_{k+1}})$ for $k>\ell$.
Since $y\notin S_\ell'^{V,\ii}$, necessarily $y\in S_\ell^{V,\ii}$ by point 1.
of Lemma~\ref{lem:basicProperties} and $y$ verifies:
$|\pi_{\ell+1,\ell}^{-1} (y) \cap S_{\ell+1}'^{V,\ii} | = i_{\ell+1}$.
On the other hand, $y\in S_\ell'^{Y',\jj} $ and thus holds
$|\pi_{\ell+1,\ell}^{-1}(y) \cap S_{\ell+1}'^{Y',\jj}|> i_{\ell+1}$.
This means that there is an element $y^{(1)}=(x_1,\ldots,x_{\ell-1},y_\ell,y_{\ell+1})
\in S_{\ell+1}'^{Y',\jj} \setminus S_{\ell+1}'^{V,\ii}$.
By Lemma~\ref{lem:Y'},
$y^{(1)} \in \pi_{\ell+1} (\wtv^{i_n,\ldots,>i_{k_1 + 1}})$ for a $1\le k_1 \le n-2$
distinct from $\ell+1$, or $y^{(1)} \in \pi_{\ell+1} (V^{>i_n})$.
As shown above $k_1<\ell$ leads to a contradiction.
Similarly,  $k_1=\ell$ is not possible
since $\pi_{k_1}(y^{(1)})=\pi_{k_1}(y)\notin S_{k_1}'^{V,\ii}$,
and thus $y^{(1)} \notin \pi_{\ell+1}(\wtv^{i_n,\ldots,>i_{\ell+1}})$.
Consequently, $k_1>\ell+1$.
Since $y^{(1)}$   belongs
to $S_{\ell+1} ^{V,\ii}$, one has $|\pi_{\ell+2,\ell+1}^{-1}
(y^{(1)} ) \cap S_{\ell+2} '^{V,\ii}| = i_{\ell+2}$. On the other hand,
$y^{(1)} \in S_{\ell+1}'^{Y',\jj}$ gives 
$|\pi_{\ell+2,\ell+1}^{-1} (y^{(1)} ) \cap S_{\ell+2} '^{Y',\jj}| > i_{\ell+2}$,
proving the existence of an element $y^{(2)} \in S_{\ell+2}'^{Y',\jj}
\setminus S_{\ell+2}'^{V,\ii}$. We can repeat similar arguments
as used above, leading to the existence of $k_2 > \ell+2$ such that
$y^{(2)} \in \pi_{\ell+2}(\wtv^{i_n,\ldots,>i_{k_2+1}})$.
More generally, this repetition gives
a sequence $y=y^{(0)} , y^{(1)} , \ldots , y^{(t)}$,
with $t = n-1-\ell$, 
where each  $y^{(r)} \in S_{\ell+r}'^{Y',\jj} \setminus  S_{\ell+r}'^{V,\ii}$
for $r<t$, and $y^{(t)} \in Y' \setminus S_{n-1}'^{V,\ii}$;
as well as  $y^{(r)} \in \pi_{\ell+r}(\wtv^{i_n,\ldots,>i_{k_r+1}})$ for a $k_r > \ell +r$,
and moreover $\pi_r(y^{(r+1)}) = y^{(r)}$ for $r<t$.
The last possibility is then $y^{(t)} \in Y' \setminus S_{n-1}'^{V,\ii}$.
By Lemma~\ref{lem:Y'} this implies $y^{(t)} \in \pi_{n-1}(\wtv^{i_n,\ldots,>i_{k_t+1}})$.
As already seen, $k_t>\ell$, so that
$\pi_{k_t}(y^{(t)}) = y^{(k_t-\ell)} \in S_{k_t}'^{V,\ii}$. 
This contradicts $y^{(k_t-\ell)}\in 
S_{k_t}'^{Y',\jj} \setminus  S_{k_t}'^{V,\ii}$.
We conclude that the initial assumption $|A_\ell|< |B_\ell|$
does not hold.

Therefore, $|B_\ell|=i_\ell$ for $\ell=2,\ldots,n-1$
and by Lemma~\ref{lem:basicProperties} 3., it comes
$(x_1,\ldots,x_{n-2})\in \pi_{n-2}(Y'^{\jj})$, and moreover
$|\pi_{n-1,n-2}^{-1}(x_1,\ldots,x_{n-2})\cap Y'| = i_{n-1}$.
If $i_{n-1}\not= 0$, it suffices to pick up an element in this set
to show that $Y'^{i_{n-1},\ldots,i_2}\not= \emptyset$.
\smallskip

As for the point 3., the inclusion $\subset$ is given by the point 1. with $\ell=1$.
To prove the inclusion $\supset$, consider an element $y=(\xx{y}{1}{n-1})\in Y'^{i_{n-1},\ldots,>i_2}$.
By Lemma~\ref{lem:Y'}, there is a $1\le k \le n-2$ such that $y\in \pi_{n-1}(\wtv^{i_n,\ldots,>i_{k+1}})$,
or $y\in S_{n-1}'^{V,\ii}$.
If $k=1$, then $y_1\in \pi_1(\wtv^{i_n,\ldots,>i_2})$ as wanted.
Else $2 \le k \le n-2$ and  $|\pi_{k+1,k}^{-1}(y_1,\ldots,y_k) \cap S_{k+1}'^{V,\ii}| >  i_{k+1}$.
By the point 1., $S_{k+1}'^{V,\ii} \subset  S_{k+1}'^{Y',\jj}$ yielding 
$|\pi_{k+1,k}^{-1}(y_1,\ldots,y_k) \cap S_{k+1}'^{Y',\jj}|\stackrel{*_{k+1}}{>} i_{k+1}$
if $k\le n-3$ and else $|\pi_{n-1,n-2}^{-1}(\xx{y}{1}{n-2}) \cap Y'| \stackrel{*_{n-1}}{>} i_{n-1}$. 
But  $y\in \wty'^{i_{n-1},\ldots,>i_2}\subset
\wty'^{i_{n-1},\ldots,i_3}$ and therefore by Lemma~\ref{lem:basicProperties} 2.
the equalities $|\pi_{k+1,k}^{-1}(y_1,\ldots,y_k) \cap S_{k+1}'^{Y',\jj}|=i_{k+1}$
for $k=3,\ldots,n-3$, and additionally the equality
$|\pi_{n-1,n-2}^{-1}(y_1,\ldots,y_{n-2}) \cap Y'|=i_{n-1}$
must be satisfied. This contradicts the strict inequality $\scriptstyle{*_{k+1}}$.
%% Consequently, $(y_1,\ldots,y_k)\notin S_k'^{V,\ii}$ for $k=3,\ldots,n-1$
%% and therefore $(\xx{y}{1}{k})\in S_k^{V,\ii})$ by Lemma~\ref{lem:basicProperties} 1.
%% For such values of $k$, one has
%% $\wtv'^{i_{n},\ldots,>i_2}\subset \wty'^{i_{n},\ldots,i_k}$ showing that $$.
%% 
\end{pf}
