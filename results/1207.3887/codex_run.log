+    report["G2_rejects_corruption"] = {
+        "pass": corruption_ok,
+        "reasons": reasons,
+    }
+
+    # G3: realistic tagged/fenced prose and unparseable garbage.
+    wire = (
+        "I used the projection fibers.\n```json\n"
+        + "<answer>\n"
+        + json.dumps(planted)
+        + "\n</answer>\n```\nThe checks are exact."
+    )
