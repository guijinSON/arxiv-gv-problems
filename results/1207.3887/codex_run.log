+        "exact finite-field addition and multiplication",
+        "exact polynomial-circuit evaluation on every point",
+        "leading-monomial and quotient-dimension comparison",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
