to define $T_{j+1}'^\alpha$.
Let $h_t:{\cal U}_t \rightarrow A_t[X_{t+1},\ldots,X_n]$,
$\alpha \mapsto L_{\TT_t^\alpha,\TT_t'^\alpha}(f_V)(\XX{t+1}{n})$.
Lemma~\ref{lem:interp} gives:
\begin{eqnarray}\label{eq:grecurs}
g_\ii= L_{\SS_{\le t},\SS'_{\le t}} ( h_t)(\XX{1}{t})
\end{eqnarray}
And moreover, the expanded form gives:
\begin{equation}\label{eq:exp}
g_\ii = \hspace{-0.5cm}
\sum_{\alpha^1\in S_1,\alpha^2\in S_2[\alpha^1],\ldots,\alpha_t^t\in S_t[\alpha^{t-1}]} 
\hspace{-0.5cm}
\LLL_{\bf a}(\XX{1}{t})
\left(\prod_{j=1}^t X_j^{i_j-|S_j[\alpha^{j-1}]|}
\prod_{\alpha'^j\in S_j'[\alpha^{j-1}]} (X_j - \alpha_j'^j)\right)h_t(\alpha^t).
\end{equation} 
This recursive point of view is useful for the next Proposition:
\begin{Prop}\label{prop:Ct}
For each $t$ as above, there is a polynomial $C_t\in k[\XX{1}{t}]$
%% vanishing on $\pi_{t-1}(V) \setminus {\cal S}_{t-1}$
such that for all $\alpha\in \pi_{t}(V)$, 
$g_\ii(\alpha,\XX{t+1}{n})=C_{t}(\alpha) h_{t}(\alpha)$.

Moreover, if $\alpha\in {\cal S}_{t}$ then $C_t(\alpha)\not=0$
and if $\alpha \in \pi_{t}(V) \setminus {\cal S}_{t}$
then $C_t(\alpha)=0$.
\end{Prop}
\begin{pf}
It suffices to take $$
C_t=\sum_{\alpha^1\in S_1,\alpha^2\in S_2[\alpha^1],\ldots,\alpha_t^t\in S_t[\alpha^{t-1}]} \LLL_{\alpha}(\XX{1}{t})
\prod_{j=1}^t X_j^{i_j-|S_j[\alpha^{j-1}]|} \left(\prod_{\alpha'^j\in S_j'[\alpha^{j-1}]} X_j - \alpha_j'^j\right).
$$
Indeed,
using the expanded explicit form of $g_\ii$ above,
Equation~\eqref{eq:exp} implies that:
$$
g_\ii(\alpha,\XX{t+1}{n})= 
 \prod_{j=1}^t (\alpha_j)^{i_j - |S_j'[\pi_{j-1}(\alpha)]|}
\left(\prod_{\alpha'^j\in S_j'[\pi_{j-1}(\alpha)]} (\alpha_j - \alpha_j'^j) \right)h_t(\alpha).
 $$
Hence, $C_t(\alpha)=  \prod_{j=1}^t (\alpha_j)^{i_j - |S_j'[\pi_{j-1}(\alpha)]|}
\left(\prod_{\alpha'^j\in S_j'[\pi_{j-1}(\alpha)]} (\alpha_j - \alpha_j'^j) \right)$.
If $\alpha\in {\cal S}_t$, then by Lemma~\ref{lem:basicProperties} point~1., it arrives
$\prod_{\alpha'^j\in S_j'[\pi_{j-1}(\alpha)]} (\alpha_j - \alpha_j'^j)\not=0$.
And on the contrary, if $\alpha\not\in {\cal S}_t$,
then there exists $j$ such that $(\alpha_1,\ldots,\alpha_j)\in S_j'$,
implying that  $\prod_{\alpha'^j\in S_j'[\pi_{j-1}(\alpha)]} (\alpha_j - \alpha_j'^j)=0$
and henceforth $C_t(\alpha)=0$.
\end{pf}

Naturally, the interpolation
polynomials $g_\ii$ verify Theorem~(structure) of the introduction.

\begin{Prop}\label{prop:structure}
For $1\le t\le n-1$, the polynomial $g_\ii$ verifies:
$$
g_\ii \in \l \LC_1(g_\ii)\r,
\quad \text{and~for~}
\ \ 2\le t\le n-1,\quad 
g_\ii \in \l \LC_t(g_\ii) \r +  I_{t-1}.
$$
\end{Prop}
\begin{pf}
If $t=1$ then Corollary~\ref{cor:interp}
clearly shows that
$\LC_1(g_\ii) = \prod_{\alpha_1'\in S_1'}X_1-\alpha_1'$
divides $g_\ii$.

Assume $t\ge 2$. Let $\alpha\in {\cal S}_{t-1}$.
Then Proposition~\ref{prop:Ct}
implies that $\LC_t(g_\ii(\alpha,\XX{t}{n})) = 
C_{t-1}(\alpha) \LC_t(h_{t-1}(\alpha))$.
On the other hand, define $T^{\alpha}:=S_{t}[\alpha]$
and $T'^{\alpha}:=S_{t}'[\alpha]$. Then
by the recursive equality~\eqref{eq:Lrecurs},
$h_{t-1}(\alpha)=L_{T^\alpha,T'^\alpha}(h_{t}(\alpha,X_{t}))$,
so that
$$
h_{t-1}(\alpha)= X_{t}^{i_{t} - |S_{t}[\alpha]|}
\prod_{\beta'\in T'^\alpha} (X_{t} - \beta_{t}')
\left(\sum_{\beta\in T^\alpha} \ell_{\beta_{t}}(X_{t}) h_{t}(\beta)\right).
$$
It follows that  $\LC_t(g_\ii(\alpha,\XX{t}{n}))= C_{t-1}(\alpha)(X_{t}^{i_{t} - |S_{t}[\alpha]|}
\prod_{\beta'\in T'^\alpha} (X_{t} - \beta_{t}'))$
divides $h_{t-1}(\alpha)$ for all $\alpha\in {\cal S}_{t-1}$,
and thus divides $g_\ii(\alpha,\XX{t}{n})$.

If $\alpha\in \pi_{t-1}(V)\setminus {\cal S}_{t-1}$ then 
Proposition~\ref{prop:Ct} shows that $C_{t-1}(\alpha)=0$ hence that
$\LC_t(g_\ii(\alpha,\XX{t}{n})) = g_\ii (\alpha,\XX{t}{n})=0$.
Therefore, $g_\ii - C_{t-1} (\alpha)\LC_{t}(g_\ii)$
vanishes on $\pi_{t-1}(V)$.
This implies that $g_\ii \in \l \LC_t(g_\ii)\r + I_{t-1}$.
\end{pf}

