+        "hinted_verdict": G9_ARM_RESULTS.get("hinted_verdict", "not_run"),
+        "answer_chars": len(answer_blob),
+        "worst_case_answer_chars": len(worst_blob),
+        "answer_tokens": (len(answer_blob) + 3) // 4,
