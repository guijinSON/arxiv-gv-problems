+                params["prime"] in _PRIMITIVE_ROOT
+                and (params["prime"] - 1) % params["n"] == 0
+                and pow(params["n"], params["variables"]) < params["prime"]
+            ):
+                hypothesis_checks += 1
+            else:
+                g1_failures.append(f"{preset}/{seed}: field_hypothesis_failed")
+    report["G1_planted_verifies"] = {
