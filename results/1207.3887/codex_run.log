+        "Track B: the Buchberger-Moller evaluation-matrix algorithm reconstructs "
+        "the point ideal in polynomial time (O(d*m^3) field operations in this "
+        "implementation for m points); at the hard preset it measured "
+        "20,174,304 exact field operations and 1.25 seconds per instance "
+        "(medians), versus at most 213 counted operations for the fiber-sum "
+        "change of variables in the final gate run."
+    ),
+    "max_answer_tokens": 70,
+}
+
+NATIVE: dict = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": list(PROBLEM_PROFILE["native_objects"]),
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
