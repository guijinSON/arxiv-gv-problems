+        pool = {vertices[i] for i in order[:min(2 * h, len(order))]}
+        for start in list(pool):
+            candidate = _greedy_from_start(
+                inst, start, vertices, masks, pool=pool
+            )
+            if verify(inst, candidate)[0]:
+                return True
+    return False
