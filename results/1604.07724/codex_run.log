+        sorted(range(len(vertices)), key=lambda i: (x[i], -vertices[i]), reverse=True),
+        sorted(range(len(vertices)), key=lambda i: (x[i], vertices[i])),
+        sorted(range(len(vertices)), key=lambda i: (abs(x[i]), -vertices[i]),
+               reverse=True),
