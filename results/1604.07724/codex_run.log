+    planted_vertices = rng.sample(range(n), 2 * h)
+    left = planted_vertices[:h]
+    right = planted_vertices[h:]
+    edges, switches = _degree_preserving_plant(n, left, right, rng)
+    neighbors = _neighbors_from_edges(n, edges)
 
