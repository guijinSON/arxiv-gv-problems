+        successes[names[1]] += int(_attack_greedy(inst))
+        successes[names[2]] += int(_attack_random_restart(inst, seed))
+        successes[names[3]] += int(_attack_pair_intersection(inst))
+        successes[names[4]] += int(_attack_spectral(inst, seed))
