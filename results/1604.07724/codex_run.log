+    vertices, masks_by_label = _instance_view(inst)
+    n = inst["layer_count"]
+    col_masks = [masks_by_label[v] for v in vertices]
+    row_neighbors = [[] for _ in range(n)]
+    col_neighbors = []
+    for col, mask in enumerate(col_masks):
+        neighbors = []
+        bits = mask
+        while bits:
+            bit = bits & -bits
+            row = bit.bit_length() - 1
+            neighbors.append(row)
