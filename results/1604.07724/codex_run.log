+        row_signatures = [
+            ("R", row_colors[j], tuple(sorted(col_colors[i]
+                                              for i in row_neighbors[j])))
+            for j in range(n)
+        ]
+        universe = sorted(set(col_signatures + row_signatures), key=repr)
+        palette = {signature: color for color, signature in enumerate(universe)}
