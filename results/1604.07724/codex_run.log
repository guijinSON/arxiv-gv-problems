+    current_h = int(params.get("h", max(2, int(math.log2(current_n)) + 4)))
+    harder_n = current_n + max(64, current_n // 2)
+    harder_h = current_h + 2
+    if harder_h + 1 > 256:
+        return "cap_bound"
+    return {"n": harder_n, "h": harder_h}
 
 
