+        "pair_common_neighborhood_outlier",
+        "spectral_centered_biadjacency",
+        "exact_balanced_biclique_branch_20m",
+    ]
+    successes = {name: 0 for name in names}
+    exact_rows = []
+    for seed in range(9100, 9100 + attempts):
