index 0000000000000000000000000000000000000000..d8e221c724be9d89b724f959f520816af3366501
--- /dev/null
+++ b/gen_1604_07724.py
@@ -0,0 +1,1024 @@
+"""Verified problem generator for arXiv:1604.07724.
+
+The paper's Theorem 3 reduces Multicolored Clique to finding one vertex set
+whose induced graph has a perfect matching in each of three layers.  This
+module first samples a modular multicolored clique, then carries that witness
+through exactly the three-layer gadget used in the theorem.
+
+The three very large graph layers are specified succinctly.  Verification
+does not trust the planted answer: a submitted coordinate tuple is expanded
+to the paper's vertex set and the three perfect matchings are reconstructed
+by exact modular membership tests.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from typing import Any
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": [
+        "three succinctly specified undirected graph layers on one vertex set",
+        "a selected vertex set encoded by one residue-coordinate per color gadget",
+    ],
+    "verification_operations": [
+        "exact modular adjacency tests",
+        "explicit construction of a perfect matching in each induced layer",
+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 5, Theorem 3 (label thm:matching): the three-layer reduction "
+        "from Multicolored Clique to Matching-Multi-Layer Subgraph"
+    ),
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "Normalize each modular edge-shift by the public color tags: the normal "
+        "rows share a slope and the two exceptional rows share a translation, "
+        "whereas a generic clique search explores millions of compatibility tests."
+    ),
+    "hardness_basis": (
+        "Track B: color-by-color clique DFS on the paper's Multicolored-Clique "
+        "core has worst-case O(q*d^(h-1)*h) time; at the shipping preset "
+        "q=16381, h=8, d=14 it is measured by selftest over eight instances, "
+        "while the change-of-variables route uses at most 106 exact operations."
+    ),
+    "max_answer_tokens": 20,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 11, "h": 4, "degree": 3, "filter_attacks": False},
+    "easy": {"n": 257, "h": 6, "degree": 6, "filter_attacks": True},
+    "medium": {"n": 4093, "h": 8, "degree": 10, "filter_attacks": True},
+    "hard": {"n": 16381, "h": 8, "degree": 14, "filter_attacks": True},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+STRUCTURAL_HINT = (
+    "The modular edge shifts become shared slope and translation values after "
+    "normalization by the public color tags."
+)
+PLACEBO_HINT = (
+    "Careful bookkeeping of the modular residues and color order helps avoid "
+    "small transcription mistakes in the answer."
+)
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "Exactly h integers [x_0,...,x_(h-1)], one residue in [0,q) for each "
+        "color; the tuple encodes the h^2 vertices W_i and P_(i,x_i,j) of the "
+        "paper's matching gadget. Repeated residue values are allowed."
+    ),
+    "bounds": {
+        "coordinates": 8,
+        "coordinate_upper_exclusive": 16381,
+        "max_atomic_elements": 8,
+    },
+}
+
+# Filled from the script-owned oracle transcripts after the three arm runs.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+NOTES = (
+    "Section 1 defines Pi-Multi-Layer Subgraph using one common vertex set X "
+    "whose induced graphs have Pi in at least ell layers. Section 5 and Appendix A "
+    "fix Matching to mean existence of a perfect matching. Lemma 1 gives a "
+    "polynomial maximum-weight-matching algorithm when at most two layers are "
+    "required; Theorem 3 is the sharp transition used here, proving NP-hardness "
+    "and W[1]-hardness in k for three layers by reduction from Multicolored "
+    "Clique. The generator samples a modular clique before building the gadget. "
+    "Normal and exceptional shift decoys have the same uniform marginal law as "
+    "the planted shifts, and every candidate has exactly degree d toward every "
+    "other color. Non-demo instances are retained only when degree, greedy, "
+    "random-restart, and small linear-ansatz probes all fail; none of those probes "
+    "supplies the retained certificate. The successful reference algorithm is "
+    "reported separately because this is Track B."
+)
+
+
+def _is_prime(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    limit = math.isqrt(value)
+    divisor = 3
+    while divisor <= limit:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(value: int) -> int:
+    value = max(3, int(value))
+    if value % 2 == 0:
+        value += 1
+    while not _is_prime(value):
+        value += 2
+    return value
+
+
+def _mix_seed(seed: int, nonce: int) -> int:
+    mask = (1 << 128) - 1
+    x = (int(seed) & mask) ^ 0x160407724D17C0DE
+    x = (x + (nonce + 1) * 0x9E3779B97F4A7C15) & mask
+    x ^= x >> 30
+    x = (x * 0xBF58476D1CE4E5B9) & mask
+    x ^= x >> 27
+    return x
+
+
+def _rows_by_pair(inst: dict) -> dict[tuple[int, int], dict]:
+    return {(row["i"], row["j"]): row for row in inst["rows"]}
+
+
+def _edge_from_rows(
+    rows: dict[tuple[int, int], dict], q: int, i: int, x: int, j: int, y: int
+) -> bool:
+    if i == j:
+        return False
+    if i < j:
+        row = rows[(i, j)]
+        residue = (y - row["mul"] * x) % q
+    else:
+        row = rows[(j, i)]
+        residue = (x - row["mul"] * y) % q
+    return residue in row["shift_set"]
+
+
+def _edge(inst: dict, i: int, x: int, j: int, y: int) -> bool:
+    rows = _rows_by_pair(inst)
+    return _edge_from_rows(rows, inst["q"], i, x, j, y)
+
+
+def _raw_instance(n: int, seed: int, h: int, degree: int, nonce: int) -> dict:
+    q = int(n)
+    if not _is_prime(q) or q <= 2:
+        raise ValueError("n=q must be an odd prime")
+    if h < 4 or h % 2:
+        raise ValueError("h must be even and at least 4")
+    pair_count = h * (h - 1) // 2
+    if degree < 2:
+        raise ValueError("degree must be at least 2")
+    if q <= (pair_count - 2) * (degree - 1) + 1:
+        raise ValueError("q is too small for disjoint normalized decoys")
+    if q <= 2 * (degree - 1) + 1:
+        raise ValueError("q is too small for exceptional-row decoys")
+
+    rng = random.Random(_mix_seed(seed, nonce))
+    tags = rng.sample(range(q), h)
+    slope = rng.randrange(1, q)
+    translation = rng.randrange(q)
+    answer = [(translation + slope * tag) % q for tag in tags]
+
+    # The first two pairs are exceptional.  Their multiplier 2 breaks the global
+    # translation symmetry.  All other rows have multiplier 1.
+    exceptional = {(0, 1), (0, 2)}
+    used_normalized = {slope}
+    used_centered = {translation}
+    rows: list[dict[str, Any]] = []
+
+    for i in range(h):
+        for j in range(i + 1, h):
+            mul = 2 if (i, j) in exceptional else 1
+            planted_shift = (answer[j] - mul * answer[i]) % q
+            shifts = {planted_shift}
+
+            if mul == 1:
+                tag_delta = (tags[j] - tags[i]) % q
+                if tag_delta == 0:  # tags are distinct; retained as a guard.
+                    raise AssertionError("distinct tags unexpectedly collided")
+                while len(shifts) < degree:
+                    normalized = rng.randrange(q)
+                    if normalized in used_normalized:
+                        continue
+                    used_normalized.add(normalized)
+                    shifts.add((normalized * tag_delta) % q)
+            else:
+                tag_term = (tags[j] - mul * tags[i]) % q
+                denom = (1 - mul) % q
+                while len(shifts) < degree:
+                    centered = rng.randrange(q)
+                    if centered in used_centered:
+                        continue
+                    used_centered.add(centered)
+                    shifts.add((slope * tag_term + denom * centered) % q)
+
+            shift_list = list(shifts)
+            rng.shuffle(shift_list)
+            rows.append(
+                {
+                    "i": i,
+                    "j": j,
+                    "mul": mul,
+                    "shifts": shift_list,
+                    "shift_set": frozenset(shift_list),
+                }
+            )
+
+    rng.shuffle(rows)
+    vertex_count = h + h * q * (h - 1)
+    inst = {
+        "paper": "arXiv:1604.07724",
+        "family": "three-layer perfect-matching subgraph",
+        "q": q,
+        "h": h,
+        "degree": degree,
+        "k": h * h,
+        "ell": 3,
+        "t": 3,
+        "vertex_count": vertex_count,
+        "tags": tags,
+        "rows": rows,
+        "layer_order": [0, 1, 2],
+        "answer": answer,
+        "construction_nonce": nonce,
+    }
+    return inst
+
+
+def _greedy_first_fit(inst: dict) -> tuple[list[int] | None, int]:
+    q, h = inst["q"], inst["h"]
+    rows = _rows_by_pair(inst)
+    chosen = [0]
+    operations = 1
+    for color in range(1, h):
+        found = None
+        for value in range(q):
+            compatible = True
+            for old_color, old_value in enumerate(chosen):
+                operations += 1
+                if not _edge_from_rows(rows, q, old_color, old_value, color, value):
+                    compatible = False
+                    break
+            if compatible:
+                found = value
+                break
+        if found is None:
+            return None, operations
+        chosen.append(found)
+    return chosen, operations
+
+
+def _neighbors(
+    rows: dict[tuple[int, int], dict], q: int, i: int, x: int, j: int
+) -> list[int]:
+    if i < j:
+        row = rows[(i, j)]
+        return sorted({(row["mul"] * x + shift) % q for shift in row["shifts"]})
+    row = rows[(j, i)]
+    inv = pow(row["mul"], -1, q)
+    return sorted({(inv * (x - shift)) % q for shift in row["shifts"]})
+
+
+def _random_restart(inst: dict, restarts: int = 64) -> tuple[list[int] | None, int]:
+    q, h = inst["q"], inst["h"]
+    rows = _rows_by_pair(inst)
+    fingerprint = sum(sum(row["shifts"]) for row in inst["rows"])
+    rng = random.Random(_mix_seed(fingerprint, restarts))
+    operations = 0
+    for _ in range(restarts):
+        chosen = [rng.randrange(q)]
+        for color in range(1, h):
+            candidates = _neighbors(rows, q, 0, chosen[0], color)
+            rng.shuffle(candidates)
+            picked = None
+            for value in candidates:
+                okay = True
+                for old_color, old_value in enumerate(chosen):
+                    operations += 1
+                    if not _edge_from_rows(
+                        rows, q, old_color, old_value, color, value
+                    ):
+                        okay = False
+                        break
+                if okay:
+                    picked = value
+                    break
+            if picked is None:
+                break
+            chosen.append(picked)
+        if len(chosen) == h:
+            return chosen, operations
+    return None, operations
+
+
+def _linear_ansatz(inst: dict) -> tuple[list[int] | None, int]:
+    q, h, tags = inst["q"], inst["h"], inst["tags"]
+    operations = 0
+    for small_slope in (-2, -1, 0, 1, 2):
+        for small_translation in range(16):
+            candidate = [
+                (small_translation + small_slope * tag) % q for tag in tags
+            ]
+            operations += h
+            if verify(inst, candidate)[0]:
+                return candidate, operations
+    return None, operations
+
+
+def _cheap_attack_candidates(inst: dict) -> dict[str, tuple[object, int]]:
+    h, q = inst["h"], inst["q"]
+    greedy, greedy_ops = _greedy_first_fit(inst)
+    restart, restart_ops = _random_restart(inst, 64)
+    ansatz, ansatz_ops = _linear_ansatz(inst)
+    return {
+        "outlier_equal_degree": ([0] * h, h * q),
+        "greedy_first_compatible": (greedy, greedy_ops),
+        "random_restart_64": (restart, restart_ops),
+        "small_linear_ansatz": (ansatz, ansatz_ops),
+    }
+
+
+def make_instance(
+    n: int,
+    seed: int = 0,
+    h: int = 8,
+    degree: int = 10,
+    filter_attacks: bool = True,
+    **params: Any,
+) -> dict:
+    """Construct an instance by sampling its modular clique first.
+
+    The optional filtering only discards instances solved by four bounded cheap
+    probes.  It never replaces, repairs, or searches for the sampled witness.
+    """
+
+    del params
+    for nonce in range(128):
+        inst = _raw_instance(n, seed, h, degree, nonce)
+        if not filter_attacks:
+            return inst
+        outcomes = _cheap_attack_candidates(inst)
+        if all(not verify(inst, candidate)[0] for candidate, _ in outcomes.values()):
+            return inst
+    raise RuntimeError("could not obtain an instance defeating the cheap attack panel")
+
+
+def render(inst: dict) -> str:
+    """Render the complete succinct three-layer matching instance."""
+
+    q, h = inst["q"], inst["h"]
+    rows = []
+    for row in inst["rows"]:
+        values = ",".join(str(value) for value in row["shifts"])
+        rows.append(
+            f"  colors ({row['i']},{row['j']}): a={row['mul']}; S=[{values}]"
+        )
+    body = "\n".join(rows)
+    statement = f"""Three-layer perfect-matching subgraph (arXiv:1604.07724, Theorem 3 gadget)
+
+All residues below are computed modulo the prime q={q}. There are h={h} colors,
+numbered 0 through {h - 1}. The public tag of color i is r_i; in color order the
+tags are:
+  r = {json.dumps(inst['tags'], separators=(',', ':'))}
+
+First define an h-partite source graph. Its candidate vertices are pairs (i,x),
+where i is a color and x is a residue 0 <= x < q. For every displayed row with
+i<j, candidate (i,x) is adjacent to candidate (j,y) exactly when
+  (y - a*x) mod q is an element of S.
+There are no edges between candidates of the same color. The rows are:
+{body}
+
+These rows succinctly specify three undirected graph layers on one common vertex
+set. The common vertices are:
+  * W_i for every color i; and
+  * P_(i,x,j) for every color i, residue x, and color j != i.
+Thus there are {inst['vertex_count']} vertices. The target size is k=h^2={inst['k']},
+and all three layers are required.
+
+Base Layers 1 and 2: for every (i,x), take the h-cycle
+  W_i, P_(i,x,j_1), ..., P_(i,x,j_(h-1)), W_i,
+where j_1<...<j_(h-1) are all colors other than i. Put alternating cycle edges
+in Base Layer 1 and Base Layer 2, starting with the edge incident to W_i in
+Base Layer 1. Since h is even, either edge set is a perfect matching of a whole
+cycle.
+
+Base Layer 3: pair W_i with W_(i+h/2) for 0<=i<h/2. For each i<j, include the
+edge {{P_(i,x,j), P_(j,y,i)}} exactly when source candidates (i,x) and (j,y)
+are adjacent by the displayed row. There are no other Base-Layer-3 edges.
+
+The presented layer numbers list Base Layers in this order:
+  {json.dumps(inst['layer_order'], separators=(',', ':'))}
+(The order is immaterial because all three are required.)
+
+Your witness is exactly h residues [x_0,...,x_(h-1)], one for each color in
+color order. It denotes the k vertices consisting of every W_i and every
+P_(i,x_i,j) with j!=i. Repeated residue values are allowed because colors make
+the source candidates distinct. The witness is valid exactly when each of the
+three induced layers has a perfect matching.
+
+Give your final answer inside <answer></answer> tags, as a JSON list of exactly
+{h} integers in color order, each in [0,{q}).
+Example format: <answer>{json.dumps(list(range(h)), separators=(',', ':'))}</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text: str) -> object | None:
+    """Extract the tagged JSON list, tolerating prose and markdown fences."""
+
+    if not isinstance(text, str):
+        return None
+    match = re.search(r"<answer>\s*(.*?)\s*</answer>", text, re.I | re.S)
+    if not match:
+        return None
+    payload = match.group(1).strip()
+    payload = re.sub(r"^```(?:json|text)?\s*", "", payload, flags=re.I)
+    payload = re.sub(r"\s*```$", "", payload)
+    try:
+        value = json.loads(payload)
+    except (TypeError, ValueError):
+        stripped = payload.strip().strip("[]")
+        if not stripped:
+            return []
+        pieces = [piece.strip() for piece in stripped.split(",")]
+        if any(not re.fullmatch(r"[-+]?\d+", piece) for piece in pieces):
+            return None
+        try:
+            value = [int(piece) for piece in pieces]
+        except ValueError:
+            return None
+    if not isinstance(value, list):
+        return None
+    return value
+
+
+def verify(inst: dict, answer: object) -> tuple[bool, str]:
+    """Check any encoded witness without reading ``inst['answer']``."""
+
+    h, q = inst["h"], inst["q"]
+    if answer is None or answer == []:
+        return False, f"empty: expected {h} residue coordinates"
+    if not isinstance(answer, list):
+        return False, "wrong type: answer must be a JSON list"
+    if len(answer) != h:
+        return False, f"wrong length: expected {h} coordinates, got {len(answer)}"
+    for color, value in enumerate(answer):
+        if not isinstance(value, int) or isinstance(value, bool):
+            return False, f"wrong type: coordinate {color} is not an integer"
+        if not 0 <= value < q:
+            return False, f"out of range: coordinate {color}={value} is not in [0,{q})"
+
+    # Layers 1 and 2 have their explicit alternating perfect matchings on each
+    # selected h-cycle.  Layer 3 has the h/2 W-pairs and must also contain the
+    # one port-pair edge for every unordered pair of colors.
+    rows = _rows_by_pair(inst)
+    for i in range(h):
+        for j in range(i + 1, h):
+            row = rows[(i, j)]
+            residue = (answer[j] - row["mul"] * answer[i]) % q
+            if residue not in row["shift_set"]:
+                return (
+                    False,
+                    f"Layer 3 constraint ({i},{j}) failed: residue {residue} "
+                    f"is not in its shift set",
+                )
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from the structure-aware coordinate language."""
+
+    return [rng.randrange(inst["q"]) for _ in range(inst["h"])]
+
+
+def search_space(inst: dict) -> int:
+    return inst["q"] ** inst["h"]
+
+
+def enumerate_all(inst: dict) -> int | None:
+    space = search_space(inst)
+    if space > 200_000:
+        return None
+    count = 0
+    for candidate in itertools.product(range(inst["q"]), repeat=inst["h"]):
+        if verify(inst, list(candidate))[0]:
+            count += 1
+    return count
+
+
+def _affine_set_key(values: list[int], q: int) -> tuple[int, ...]:
+    """Canonical form of a residue set under x -> u*x+t, u nonzero."""
+
+    ordered = sorted(set(values))
+    if len(ordered) <= 1:
+        return tuple(ordered)
+    best: tuple[int, ...] | None = None
+    for zero in ordered:
+        for one in ordered:
+            if zero == one:
+                continue
+            inv = pow((one - zero) % q, -1, q)
+            form = tuple(sorted(((value - zero) * inv) % q for value in ordered))
+            if best is None or form < best:
+                best = form
+    assert best is not None
+    return best
+
+
+def canonical_key(inst: dict) -> str:
+    """Strong cheap invariant for the succinct relation structure.
+
+    Exact isomorphism of the exponentially expanded multilayer graph is not
+    attempted.  The key is invariant under row order, layer order, color
+    permutation/orientation, and a global affine relabelling of all residues.
+    """
+
+    q = inst["q"]
+    signatures = []
+    for row in inst["rows"]:
+        mul = row["mul"] % q
+        mul_class = min(mul, pow(mul, -1, q))
+        signatures.append((mul_class, _affine_set_key(row["shifts"], q)))
+    payload = {
+        "q": q,
+        "h": inst["h"],
+        "degree": inst["degree"],
+        "row_signatures": sorted(signatures),
+    }
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def _copy_with_rows(inst: dict, rows: list[dict], answer: list[int]) -> dict:
+    copied = dict(inst)
+    copied["rows"] = [
+        {
+            "i": row["i"],
+            "j": row["j"],
+            "mul": row["mul"],
+            "shifts": list(row["shifts"]),
+            "shift_set": frozenset(row["shifts"]),
+        }
+        for row in rows
+    ]
+    copied["answer"] = list(answer)
+    return copied
+
+
+def _affine_relabel(inst: dict, scale: int, translation: int) -> dict:
+    q = inst["q"]
+    scale %= q
+    if scale == 0:
+        raise ValueError("affine scale must be nonzero")
+    rows = []
+    for row in inst["rows"]:
+        shifts = [
+            (scale * value + (1 - row["mul"]) * translation) % q
+            for value in row["shifts"]
+        ]
+        rows.append({**row, "shifts": shifts})
+    answer = [(scale * value + translation) % q for value in inst["answer"]]
+    return _copy_with_rows(inst, rows, answer)
+
+
+def _permute_colors(inst: dict, permutation: list[int]) -> dict:
+    h, q = inst["h"], inst["q"]
+    if sorted(permutation) != list(range(h)):
+        raise ValueError("not a color permutation")
+    rows = []
+    for row in inst["rows"]:
+        ni, nj = permutation[row["i"]], permutation[row["j"]]
+        if ni < nj:
+            rows.append(
+                {
+                    "i": ni,
+                    "j": nj,
+                    "mul": row["mul"],
+                    "shifts": list(row["shifts"]),
+                }
+            )
+        else:
+            inv = pow(row["mul"], -1, q)
+            rows.append(
+                {
+                    "i": nj,
+                    "j": ni,
+                    "mul": inv,
+                    "shifts": [(-inv * value) % q for value in row["shifts"]],
+                }
+            )
+    answer = [0] * h
+    tags = [0] * h
+    for old in range(h):
+        answer[permutation[old]] = inst["answer"][old]
+        tags[permutation[old]] = inst["tags"][old]
+    copied = _copy_with_rows(inst, rows, answer)
+    copied["tags"] = tags
+    return copied
+
+
+def _reorder_rows(inst: dict) -> dict:
+    return _copy_with_rows(inst, list(reversed(inst["rows"])), inst["answer"])
+
+
+def _permute_layers(inst: dict, permutation: list[int]) -> dict:
+    if sorted(permutation) != [0, 1, 2]:
+        raise ValueError("not a layer permutation")
+    copied = _copy_with_rows(inst, inst["rows"], inst["answer"])
+    copied["layer_order"] = [inst["layer_order"][i] for i in permutation]
+    return copied
+
+
+def _reference_clique_dfs(
+    inst: dict, node_limit: int | None = None
+) -> tuple[list[int] | None, dict[str, int]]:
+    """Generic color-by-color DFS; deliberately does not use tag invariants."""
+
+    q, h = inst["q"], inst["h"]
+    rows = _rows_by_pair(inst)
+    operations = 0
+    nodes = 0
+    stopped = False
+
+    def extend(chosen: list[int]) -> list[int] | None:
+        nonlocal operations, nodes, stopped
+        if len(chosen) == h:
+            return list(chosen)
+        if node_limit is not None and nodes >= node_limit:
+            stopped = True
+            return None
+        color = len(chosen)
+        candidates = _neighbors(rows, q, 0, chosen[0], color)
+        operations += len(candidates)
+        for value in candidates:
+            nodes += 1
+            okay = True
+            for old_color, old_value in enumerate(chosen):
+                operations += 1
+                if not _edge_from_rows(
+                    rows, q, old_color, old_value, color, value
+                ):
+                    okay = False
+                    break
+            if okay:
+                found = extend(chosen + [value])
+                if found is not None:
+                    return found
+                if stopped:
+                    return None
+        return None
+
+    for first in range(q):
+        nodes += 1
+        if node_limit is not None and nodes >= node_limit:
+            stopped = True
+            break
+        found = extend([first])
+        if found is not None:
+            return found, {"nodes": nodes, "operations": operations, "stopped": 0}
+        if stopped:
+            break
+    return None, {"nodes": nodes, "operations": operations, "stopped": int(stopped)}
+
+
+def escalate(params: dict) -> dict:
+    """Grow the residue ground set while keeping the h-coordinate answer fixed."""
+
+    harder = dict(params)
+    harder["n"] = _next_prime(2 * int(params["n"]) + 1)
+    return harder
+
+
+def _find_corruption(
+    inst: dict,
+    candidates: list[list[int]],
+    used_reasons: set[str],
+) -> tuple[list[int], str]:
+    for candidate in candidates:
+        ok, reason = verify(inst, candidate)
+        if not ok and reason not in used_reasons:
+            return candidate, reason
+    raise AssertionError("could not find a rejected corruption with a distinct reason")
+
+
+def selftest() -> dict:
+    report: dict[str, Any] = {}
+
+    # G1: all named presets, several independent seeds.
+    g1_failures = []
+    g1_attempts = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 19):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_attempts += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": reason})
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                g1_failures.append(
+                    {"preset": preset, "seed": seed, "reason": "answer is not JSON-native"}
+                )
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "attempts": g1_attempts,
+        "failures": g1_failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    shipping = make_instance(seed=314159, **shipping_params)
+    planted = shipping["answer"]
+
+    # G2: realistic one-edit corruptions, each with a distinct diagnostic.
+    cases: dict[str, dict[str, Any]] = {}
+    used_reasons: set[str] = set()
+    fixed = {
+        "empty": [],
+        "drop": planted[:-1],
+        "out_of_range": [shipping["q"]] + planted[1:],
+    }
+    for name, candidate in fixed.items():
+        ok, reason = verify(shipping, candidate)
+        cases[name] = {"accepted": ok, "reason": reason}
+        used_reasons.add(reason)
+
+    swaps = []
+    for i in range(len(planted)):
+        for j in range(i + 1, len(planted)):
+            candidate = list(planted)
+            candidate[i], candidate[j] = candidate[j], candidate[i]
+            swaps.append(candidate)
+    swap, swap_reason = _find_corruption(shipping, swaps, used_reasons)
+    cases["swap"] = {"accepted": False, "reason": swap_reason}
+    used_reasons.add(swap_reason)
+
+    duplicates = []
+    for source in range(len(planted)):
+        for target in range(len(planted)):
+            if source == target:
+                continue
+            candidate = list(planted)
+            candidate[target] = candidate[source]
+            duplicates.append(candidate)
+    duplicate, duplicate_reason = _find_corruption(shipping, duplicates, used_reasons)
+    cases["duplicate"] = {"accepted": False, "reason": duplicate_reason}
+    used_reasons.add(duplicate_reason)
+    report["G2_rejects_corruption"] = {
+        "pass": all(not entry["accepted"] for entry in cases.values())
+        and len({entry["reason"] for entry in cases.values()}) == len(cases),
+        "cases": cases,
+        "distinct_reasons": len({entry["reason"] for entry in cases.values()}),
+    }
+
+    # G3: tagged prose, markdown, and garbage handling.
+    rendered_answer = json.dumps(planted, separators=(",", ":"))
+    realistic = (
+        "The modular constraints give the following tuple.\n"
+        "```text\n<answer>" + rendered_answer + "</answer>\n```\n"
+        "I checked every color pair."
+    )
+    parsed = parse_answer(realistic)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted and parse_answer("no tagged answer here") is None,
+        "parsed_matches": parsed == planted,
+        "garbage_returns_none": parse_answer("no tagged answer here") is None,
+    }
+
+    # G4: uniform sampling from the already structure-aware q^h language.
+    guess_rng = random.Random(0x160407724)
+    guess_total = 200_000
+    guess_hits = 0
+    start = time.perf_counter()
+    for _ in range(guess_total):
+        if verify(shipping, random_candidate(shipping, guess_rng))[0]:
+            guess_hits += 1
+    guess_elapsed = time.perf_counter() - start
+    guess_fraction = guess_hits / guess_total
+    report["G4_guess_resistance"] = {
+        "pass": guess_fraction < 1e-6,
+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_fraction": guess_fraction,
+        "candidate_space": search_space(shipping),
+        "sampling_prior": "uniform over one residue coordinate per color",
+        "wall_clock_sec": round(guess_elapsed, 6),
+    }
+
+    # G6 first, because G5 reports the measured successful reference cost.
+    attack_totals: dict[str, dict[str, Any]] = {}
+    reference_attempts = 8
+    reference_successes = 0
+    reference_nodes = 0
+    reference_operations = 0
+    reference_start = time.perf_counter()
+    for offset in range(reference_attempts):
+        inst = make_instance(seed=9000 + offset, **shipping_params)
+        for name, (candidate, operations) in _cheap_attack_candidates(inst).items():
+            slot = attack_totals.setdefault(
+                name,
+                {"successes": 0, "attempts": 0, "operations": 0},
+            )
+            slot["attempts"] += 1
+            slot["operations"] += operations
+            if verify(inst, candidate)[0]:
+                slot["successes"] += 1
+
+        found, stats = _reference_clique_dfs(inst)
+        reference_nodes += stats["nodes"]
+        reference_operations += stats["operations"]
+        if verify(inst, found)[0]:
+            reference_successes += 1
+    reference_elapsed = time.perf_counter() - reference_start
+    all_attacks_failed = all(slot["successes"] == 0 for slot in attack_totals.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_attacks_failed and len(attack_totals) >= 4 and reference_successes == 8,
+        "attacks": attack_totals,
+        "reference_algorithm": {
+            "name": "color-by-color clique DFS with modular neighbor generation",
+            "complexity": "O(q*d^(h-1)*h) worst case",
+            "wall_clock_sec": round(reference_elapsed, 6),
+            "operations": reference_operations,
+            "nodes": reference_nodes,
+            "per_instance_operations": round(reference_operations / reference_attempts, 2),
+            "solves": f"{reference_successes}/{reference_attempts}, as expected",
+        },
+    }
+
+    demo = make_instance(seed=7, **DIFFICULTY["demo"])
+    demo_start = time.perf_counter()
+    demo_solutions = enumerate_all(demo)
+    demo_elapsed = time.perf_counter() - demo_start
+    report["G5_density_and_baseline"] = {
+        "pass": True,
+        "shipping_sampled_valid_hits": guess_hits,
+        "shipping_sampled_valid_total": guess_total,
+        "shipping_sampled_density": guess_fraction,
+        "shipping_candidate_space": search_space(shipping),
+        "demo_n": demo["q"],
+        "demo_candidate_count": search_space(demo),
+        "demo_exact_solution_count": demo_solutions,
+        "demo_enumeration_wall_clock_sec": round(demo_elapsed, 6),
+        "strongest_attack": "successful Track-B reference clique DFS",
+        "reference_algorithm_wall_clock_sec": round(reference_elapsed, 6),
+        "reference_algorithm_operations": reference_operations,
+        "reference_algorithm_nodes": reference_nodes,
+    }
+
+    doubled_params = dict(shipping_params)
+    doubled_params["n"] = _next_prime(2 * shipping_params["n"] + 1)
+    doubled_params["filter_attacks"] = False
+    doubled = make_instance(seed=12345, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    ladder = []
+    for name, params in DIFFICULTY.items():
+        sample = make_instance(seed=23, **params)
+        ladder.append(
+            {
+                "preset": name,
+                "q": sample["q"],
+                "h": sample["h"],
+                "degree": sample["degree"],
+                "space": search_space(sample),
+            }
+        )
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and all(ladder[i]["space"] < ladder[i + 1]["space"] for i in range(3)),
+        "ladder": ladder,
+        "size_doubled_params": doubled_params,
+        "size_doubled_verifies": doubled_ok,
+        "size_doubled_reason": doubled_reason,
+        "fixed_answer_length_escalation": escalate(shipping_params),
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    invariance_failures = []
+    distinct_keys = set()
+    for seed in range(20):
+        inst = make_instance(seed=20000 + seed, **shipping_params)
+        original_key = canonical_key(inst)
+        distinct_keys.add(original_key)
+        rng = random.Random(70000 + seed)
+        color_perm = list(range(inst["h"]))
+        rng.shuffle(color_perm)
+        scale = rng.randrange(1, inst["q"])
+        translation = rng.randrange(inst["q"])
+        transforms = {
+            "row_reordering": _reorder_rows(inst),
+            "global_affine_residue_relabelling": _affine_relabel(
+                inst, scale, translation
+            ),
+            "color_permutation_and_edge_reorientation": _permute_colors(
+                inst, color_perm
+            ),
+            "layer_permutation": _permute_layers(inst, [2, 0, 1]),
+        }
+        composed = _permute_layers(
+            _reorder_rows(
+                _affine_relabel(
+                    _permute_colors(inst, color_perm), scale, translation
+                )
+            ),
+            [1, 2, 0],
+        )
+        transforms["composition_of_all_relabellings"] = composed
+        for name, transformed in transforms.items():
+            invariance_checks += 1
+            if canonical_key(transformed) != original_key:
+                invariance_failures.append({"seed": seed, "transform": name})
+            carried_checks += 1
+            if not verify(transformed, transformed["answer"])[0]:
+                invariance_failures.append(
+                    {"seed": seed, "transform": name, "kind": "carried witness"}
+                )
+    report["G8_canonical_key"] = {
+        "pass": not invariance_failures and len(distinct_keys) == 20,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": carried_checks,
+        "invariance_failures": invariance_failures,
+        "unrelated_instances": 20,
+        "distinct_keys": len(distinct_keys),
+        "transformations": [
+            "constraint-row reordering",
+            "global affine residue relabelling",
+            "color permutation with edge reorientation",
+            "three-layer permutation",
+            "composition of all four",
+        ],
+        "key_definition": (
+            "SHA-256 of the multiset of affine-normalized row shapes and "
+            "orientation-normalized multipliers"
+        ),
+    }
+
+    answer_blob = json.dumps(shipping["answer"], separators=(",", ":"))
+    answer_chars = len(answer_blob)
+    answer_tokens = math.ceil(answer_chars / 4)
+    answer_elements = len(shipping["answer"])
+    intended_operations = 5 * shipping["degree"] + shipping["h"] + (
+        shipping["h"] * (shipping["h"] - 1) // 2
+    )
+    arms = {
+        name: dict(G9_ORACLE_RESULTS[name]) for name in ("bare", "hinted", "placebo")
+    }
+    hinted_rate = arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+    placebo_rate = arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    within_caps = answer_chars <= 2000 and answer_elements <= 256 and intended_operations <= 300
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "within_caps": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_ORACLE_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gate_values = [
+        value
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict) and "pass" in value
+    ]
+    report["all_passed"] = all(value["pass"] for value in gate_values)
+    report["track"] = TRACK
+    report["shipping_difficulty"] = SHIPPING_DIFFICULTY
+    report["shipping_params"] = dict(shipping_params)
+    return report
+
+
+if __name__ == "__main__":
