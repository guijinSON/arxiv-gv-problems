+def _relabel_instance(inst: dict, seed: int) -> dict:
+    rng = random.Random(seed)
+    vertex_perm = _perm_old_to_new(rng, inst["vertex_count"])
+    layer_perm = _perm_old_to_new(rng, inst["layer_count"])
