+    rng: random.Random,
+) -> tuple[set[tuple[int, int]], int]:
+    """Draw G(n,1/2), then force left x right by degree-preserving switches."""
+    planted = set(left) | set(right)
+    outsiders = [v for v in range(n) if v not in planted]
+    for _attempt in range(200):
