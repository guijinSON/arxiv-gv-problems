+"""Verified problem generator for arXiv:1604.07724.
+
+The paper's Theorem 3 reduces Multicolored Clique to finding one vertex set
+whose induced graph has a perfect matching in each of three layers.  This
+module first samples a modular multicolored clique, then carries that witness
+through exactly the three-layer gadget used in the theorem.
+
+The three very large graph layers are specified succinctly.  Verification
+does not trust the planted answer: a submitted coordinate tuple is expanded
+to the paper's vertex set and the three perfect matchings are reconstructed
+by exact modular membership tests.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import time
+from typing import Any
+
+
