+        bits = mask
+        while bits:
+            bit = bits & -bits
+            row = bit.bit_length() - 1
+            neighbors.append(row)
+            row_neighbors[row].append(col)
+            bits ^= bit
+        col_neighbors.append(neighbors)
+    col_colors = [0] * n
