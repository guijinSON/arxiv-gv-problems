+def _is_prime(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    limit = math.isqrt(value)
+    divisor = 3
+    while divisor <= limit:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def _next_prime(value: int) -> int:
+    value = max(3, int(value))
+    if value % 2 == 0:
+        value += 1
+    while not _is_prime(value):
+        value += 2
+    return value
