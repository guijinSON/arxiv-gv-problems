+def _permute_mask(mask: int, permutation: list[int]) -> int:
+    moved = 0
+    bits = mask
+    while bits:
+        bit = bits & -bits
+        moved |= 1 << permutation[bit.bit_length() - 1]
+        bits ^= bit
+    return moved
