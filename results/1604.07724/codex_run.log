+    n = inst["layer_count"]
+    col_masks = [masks_by_label[v] for v in vertices]
+    row_neighbors = [[] for _ in range(n)]
+    col_neighbors = []
+    for col, mask in enumerate(col_masks):
+        neighbors = []
+        bits = mask
