from fractions import Fraction
from time import perf_counter

def euler_point(t):
    t2=t*t; t3=t2*t; t4=t2*t2; t5=t4*t; t6=t3*t3; t7=t6*t
    X=t6+3*t5-2*t4+t2+1
    Y=t7+t5-2*t3-3*t2+t
    Z=t6-3*t5-2*t4+t2+1
    W=t7+t5-2*t3+3*t2+t
    return X,Y,Z,W

def certificate(P):
    X,Y,Z,W=P
    X2=X*X; Y2=Y*Y; Z2=Z*Z; W2=W*W
    den=Z2*W2
    X4=X2*X2; Y4=Y2*Y2; W4=W2*W2
    q=[Fraction(X4-W4,den), -Fraction(W2,Z2), Fraction(Y4-W4,den), Fraction(Z2,W2)]
    roots=[Fraction(Y,Z), Fraction(X*Y,Z*W), Fraction(X,W), Fraction(X,Z), Fraction(0,1), Fraction(Y,W)]
    return q,roots

def verify(cert):
    q,roots=cert
    k=0
    for i in range(4):
        for j in range(i+1,4):
            if q[i]*q[j]+1 "'!= roots[k]**4: return False
            k+=1
    return len(set(q))==4 and all(q)

t=(1<<512)+0x1f35a7b9d
P=euler_point(t)
assert P[0]**4+P[1]**4==P[2]**4+P[3]**4
cert=certificate(P)
assert verify(cert)
loops=200
s=perf_counter()
for _ in range(loops): certificate(P)
map_sec=(perf_counter()-s)/loops
s=perf_counter()
for _ in range(loops): verify(cert)
verify_sec=(perf_counter()-s)/loops
print('"'t_bits',t.bit_length())
print('coordinate_bits', [abs(x).bit_length() for x in P])
print('answer_rational_numden_max_bits', max(max(abs(x.numerator).bit_length(),x.denominator.bit_length()) for part in cert for x in part))
print('certificate_map_mean_sec_200', format(map_sec,'.9f'))
print('exact_verify_mean_sec_200', format(verify_sec,'.9f'))
print('certificate_high_level_ops', '22 (= 8 multiplications + 2 subtractions + 4 divisions for a,b,c,d; 2 multiplications + 6 divisions for roots)')
print('compact_route_ops', '22 (the same Proposition 1.2 formulas)')
