\title{Quartic Rational Diophantine Quadruples and the Euler Surface}
\author{%
Alen Andra\v{s}ek\\
{\small University of Zagreb, Faculty of Civil Engineering, Department of Mathematics}
\and
Matija Kazalicki\\
