import gen_2509_14357 as g,time

def solve(inst,cap=2_000_000):
 E=g._compatible(inst);n=inst['n'];nodes=0;sel={}
 def dfs(rem,ub,uc):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return False
  if not rem:return True
  best=None; opts=None
  for i in rem:
   x=[(j,k) for j,k in E[i] if not (ub>>j)&1 and not (uc>>k)&1]
   if not x:return False
   if opts is None or len(x)<len(opts):best,opts=i,x
  # least-constraining static-ish
  for j,k in opts:
   sel[best]=(j,k)
   if dfs(rem-{best},ub|1<<j,uc|1<<k):return True
  sel.pop(best,None)
  return False
 t=time.time();ok=dfs(set(range(n)),0,0)
 return ok,nodes,time.time()-t
for n in (30,40,55,75):
 for seed in range(3):
  x=g.make_instance(n=n,band=2,seed=seed)
  ok,nodes,dt=solve(x)
  print(n,seed,ok,nodes,round(dt,3))
