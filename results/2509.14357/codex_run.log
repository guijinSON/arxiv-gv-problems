import random,time

def gen(n,seed,b=2):
 r=random.Random(seed);p=list(range(n));s=list(range(n));r.shuffle(p);r.shuffle(s);c=(b+1)*n;d=b*n;used=set();U=[0]*n;V=[0]*n;W=[0]*n
 for i in range(n):
  while 1:
   x=r.randint(-d,d);y=r.randint(-d,d);z=-x-y;vals=[c+x,c+y,c+z]
   if -d<=z<=d and len(set(vals))==3 and not used.intersection(vals):break
  r.shuffle(vals);U[i],V[p[i]],W[s[i]]=vals;used.update(vals)
 D={x:k for k,x in enumerate(W)}
 E=[[(j,D[3*c-u-v]) for j,v in enumerate(V) if 3*c-u-v in D] for u in U]
 return E

def cand(E,r):
 n=len(E); rem=set(range(n)); uj=set(); B=[None]*n; K=[None]*n
 while rem:
  feas={i:[x for x in E[i] if x[0] not in uj] for i in rem}
  m=min(map(len,feas.values()))
  tight=[i for i in rem if len(feas[i])==m];i=r.choice(tight)
  if not feas[i]:break
