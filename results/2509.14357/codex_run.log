+def _symmetries(x: int, y: int) -> tuple[tuple[int, int], ...]:
+    return (
+        (x, y), (x, -y), (-x, y), (-x, -y),
+        (y, x), (y, -x), (-y, x), (-y, -x),
+    )
+
+
+def canonical_key(inst: dict) -> str:
