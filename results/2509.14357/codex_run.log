+        while remaining:
+            feasible = {
+                i: [x for x in choices[i]
+                    if x[0] not in used_b and x[1] not in used_c]
+                for i in remaining
+            }
+            minimum = min(len(row) for row in feasible.values())
+            if minimum == 0:
+                break
+            tight = [i for i, row in feasible.items() if len(row) == minimum]
+            i = rng.choice(tight)
+            j, k = rng.choice(feasible[i])
+            selected[i] = (j, k)
+            remaining.remove(i)
+            used_b.add(j)
+            used_c.add(k)
