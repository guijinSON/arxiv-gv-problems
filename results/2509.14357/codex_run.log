 # repair B
 rb=[j for j in range(n) if j not in uj];r.shuffle(rb)
 for i,j in zip(list(rem),rb):
  B[i]=j
  hit=[k for jj,k in E[i] if jj==j];K[i]=hit[0] if hit else None
 # keep unique K randomized
 order=list(range(n));r.shuffle(order);seen=set();bad=[]
 for i in order:
  if K[i] is None or K[i] in seen:bad.append(i)
  else:seen.add(K[i])
 miss=[k for k in range(n) if k not in seen];r.shuffle(miss)
 for i,k in zip(bad,miss):K[i]=k
 return all((B[i],K[i]) in E[i] for i in range(n))
for n in [30,40,55]:
 E=gen(n,314159);r=random.Random(271828);h=0;N=200000;t=time.time()
