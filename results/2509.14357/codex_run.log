+        "unrelated_distinct": distinct,
+        "unrelated_attempted": len(unrelated),
+        "symmetries_per_seed": 8,
+        "composed": [
+            "within-role relabelling", "C-copy swaps", "input reordering",
+            "translation", "signed-axis permutation",
+        ],
+    }
