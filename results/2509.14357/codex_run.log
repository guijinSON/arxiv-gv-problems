/bin/bash -lc "python3 - <<'PY'
import gen_2509_14357 as g,time

def solve(inst,cap=100_000):
 E=g._compatible(inst);n=inst['n'];nodes=0
 def dfs(rem,ub,uc):
  nonlocal nodes
  nodes+=1
  if nodes>cap:return False
  if not rem:return True
  best=-1;opts=None
  for i in rem:
   x=[(j,k) for j,k in E[i] if not (ub>>j)&1 and not (uc>>k)&1]
   if not x:return False
   if opts is None or len(x)<len(opts):best,opts=i,x
  for j,k in opts:
   if dfs(rem-{best},ub|1<<j,uc|1<<k):return True
  return False
 t=time.time();ok=dfs(set(range(n)),0,0)
 return ok,nodes,time.time()-t
for n in (75,100,125,150):
 hits=0;tot=0;t=time.time()
 vals=[]
 for seed in range(800,808):
  ok,nodes,dt=solve(g.make_instance(n=n,band=2,seed=seed));hits+=ok;tot+=nodes;vals.append((ok,nodes,round(dt,2)))
 print(n,'hits',hits,'nodes',tot,'sec',round(time.time()-t,2),vals)
