+    pos = _robot_positions(inst)
+    expected = {"O", "Z"}
+    expected.update(f"A{i}" for i in range(n))
+    expected.update(f"B{i}" for i in range(n))
+    expected.update(f"C{i}.{copy}" for i in range(n) for copy in (1, 2))
