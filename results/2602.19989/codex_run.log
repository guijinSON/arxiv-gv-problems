+        "ordering of distinct group elements",
+        "modular partial sums",
+    ],
+    "verification_operations": [
+        "exact integer range and permutation checks",
+        "exact modular addition",
+        "partial-sum equality comparison",
+    ],
+    "domain_essentiality": "native",
