+}
+SHIPPING_DIFFICULTY = "hard"
+
+
+STRUCTURAL_HINT = (
+    "The few nonzero residues omitted from A form a short geometric progression; "
+    "recover its ratio, then continue that multiplicative cycle through A."
+)
+PLACEBO_HINT = (
+    "The many listed residues require careful modular bookkeeping; record each "
+    "choice, then review the completed sequence for accidental partial-sum collisions."
+)
+
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A JSON list containing each of the n distinct input residues exactly "
+        "once, in an order; every residue is an integer in [1,k-1]."
+    ),
+    "bounds": {
+        "max_shipping_elements": 256,
+        "length": "n",
+        "entry_min": 1,
+        "entry_max": "k-1",
+        "distinct": True,
+        "candidate_count": "n!",
+    },
+}
+
+
+NOTES = r"""
+Paper boundary. Section 1 fixes the definitions used here.  An ordering is
+valid when its displayed partial sums are pairwise distinct; it is a sequencing
+when, additionally, every partial sum except possibly the final one is nonzero.
+Theorems 1.3 and 1.4 are sparse-regime existence statements.  Their proof uses
+the random block construction of Section 2 and the Lovasz Local Lemma in Lemma
+2.7.  It proves positive probability, but does not output a certificate by a
+polynomial-time algorithm.  The paper also records the easy/proved regimes:
+sets of size at most 12, Kravitz's log(p)/log log(p) range, Theorem 1.2's
+exp(c(log p)^(1/4)) range, and Theorem 1.3's exp(c(log p)^(1/3)) range.  The dense
+instances here deliberately do not turn those existence bounds into a false
+Track-A distributional-hardness claim.
+
+Generation.  For prime k, choose a primitive root q and a nonzero scale u, and
+plant a_i=u(q-1)q^i for 0<=i<n<k-1.  Its j-th partial sum is exactly
+u(q^(j+1)-1), so primitivity makes all partial sums nonzero and distinct.  This
+is inverse generation plus composition of the geometric-series identity: no
+sequencing is searched for.  A random scale and shuffled storage remove numeric
+position and magnitude signatures.
+
+Track B and attacks.  The successful reference algorithm counts all pairwise
+quotients in A, finds the ratio occurring n-1 times, and walks the resulting
+cycle; it is disclosed in G6.  The compact route notices that A omits only
+k-1-n residues: those omitted residues form the much shorter complementary
+geometric run.  The failing panel checks increasing-residue/outlier order,
+smallest-feasible greedy construction, 256 randomized feasible-prefix restarts,
+and alternating low/high residues.  canonical_key quotients out all cyclic-group
+automorphisms x -> ux and all reorderings of the input set.
+""".strip()
+
+
+# Filled only from independent harden.py runs.  Pending is not a passing result.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "pending",
+}
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+@functools.lru_cache(maxsize=None)
+def _is_prime(value):
+    if isinstance(value, bool) or not isinstance(value, int) or value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    divisor = 3
+    while divisor * divisor <= value:
+        if value % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+@functools.lru_cache(maxsize=None)
+def _prime_factors(value):
+    factors = []
+    divisor = 2
+    left = value
+    while divisor * divisor <= left:
+        if left % divisor == 0:
+            factors.append(divisor)
+            while left % divisor == 0:
+                left //= divisor
+        divisor += 1 if divisor == 2 else 2
+    if left > 1:
+        factors.append(left)
+    return tuple(factors)
+
+
+@functools.lru_cache(maxsize=None)
+def _primitive_root_classes(prime):
+    """Primitive roots modulo inversion, in a deterministic order."""
+    factors = _prime_factors(prime - 1)
+    roots = [
+        value
+        for value in range(2, prime)
+        if all(pow(value, (prime - 1) // factor, prime) != 1
+               for factor in factors)
+    ]
+    return tuple(sorted({min(value, pow(value, -1, prime)) for value in roots}))
+
+
+def _next_prime(start):
+    candidate = max(3, start | 1)
+    while not _is_prime(candidate):
+        candidate += 2
+    return candidate
+
+
+def make_instance(n, seed=0, **params):
+    """Inverse-generate a cyclic-group subset and a known sequencing.
+
+    The answer is built from a primitive-root geometric progression before the
+    unordered set is exposed.  Generation never solves the public instance.
+    """
+    prime = params.pop("prime", None)
+    if params:
+        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
+    if isinstance(n, bool) or not isinstance(n, int) or n < 4:
+        raise ValueError("n must be an integer at least 4")
+    if prime is None:
+        prime = _next_prime(n + 9)
+    if (isinstance(prime, bool) or not isinstance(prime, int)
+            or not _is_prime(prime) or n >= prime - 1):
+        raise ValueError("prime must be prime and satisfy n < prime-1")
+
+    classes = _primitive_root_classes(prime)
+    if not classes:
+        raise ValueError("no primitive root class found")
+    rng = random.Random(seed)
+
+    # Consecutive seeds use different structural classes while available.  The
+    # random scale still makes their displayed numeric marginals exchangeable.
+    ratio = classes[seed % len(classes)]
+    scale = rng.randrange(1, prime)
+    first = scale * (ratio - 1) % prime
+    answer = []
+    value = first
+    for _ in range(n):
+        answer.append(value)
+        value = value * ratio % prime
+    if len(set(answer)) != n or 0 in answer:
+        raise AssertionError("primitive-root construction lost distinctness")
+
+    elements = list(answer)
+    rng.shuffle(elements)
+    return {
+        "family": "sequenceability in a cyclic group",
+        "n": n,
+        "modulus": prime,
+        "elements": elements,
+        "answer": answer,
+    }
+
+
+def render(inst):
+    """Render the complete native sequencing problem and exact wire format."""
+    n = inst["n"]
+    modulus = inst["modulus"]
+    values = sorted(inst["elements"])
+    width = 16
+    rows = [", ".join(str(value) for value in values[start:start + width])
+            for start in range(0, n, width)]
+    listing = "\n".join(rows)
+    statement = f"""Find a sequencing of a subset of the cyclic group Z_{modulus}.
+
+The cyclic group Z_{modulus} consists of the residues 0 through {modulus - 1},
+with addition reduced modulo {modulus}.  The input set A has n={n} distinct
+nonzero residues, listed below in increasing order only for readability:
+
+{listing}
+
+Choose an ORDERING a_1,...,a_{n} that uses every listed residue exactly once.
+For j=1,...,{n}, define the partial sum p_j=(a_1+...+a_j) mod {modulus}.
+Your ordering is a sequencing precisely when p_1,...,p_{n} are pairwise distinct
+and p_j is nonzero for every 1<=j<{n}.  The final sum p_{n} may be zero.  Order
+matters, repetitions are forbidden, and all residue and partial-sum comparisons
+use their canonical representatives from 0 through {modulus - 1}.
+
+Give your final answer inside <answer></answer> tags as one JSON list of exactly
+{n} base-10 integers in the required order.
+Example format: <answer>[3,17,42]</answer>
+Output nothing else inside the tags."""
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def parse_answer(text):
+    """Extract a JSON integer list from tagged prose; return None on failure."""
+    if not isinstance(text, str):
+        return None
+    matches = _ANSWER_RE.findall(text)
+    if not matches:
+        return None
+    body = matches[-1].strip()
+    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, re.I | re.S)
+    if fence:
+        body = fence.group(1).strip()
+    try:
+        answer = json.loads(body)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(answer, list):
+        return None
+    if any(isinstance(value, bool) or not isinstance(value, int)
+           for value in answer):
+        return None
+    return answer
+
+
+def verify(inst, answer):
+    """Check any submitted sequencing by exact modular partial sums."""
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON list"
+    if not answer:
+        return False, "answer is empty"
+    n = inst.get("n")
+    modulus = inst.get("modulus")
+    elements = inst.get("elements")
+    if not isinstance(n, int) or not isinstance(modulus, int) or not isinstance(elements, list):
+        return False, "malformed instance"
+    if len(answer) != n:
+        return False, f"wrong length: expected {n}, received {len(answer)}"
+    if any(isinstance(value, bool) or not isinstance(value, int) for value in answer):
+        return False, "every answer entry must be an integer"
+    if any(value < 1 or value >= modulus for value in answer):
+        return False, f"residue out of range: entries must lie in [1,{modulus - 1}]"
+    if len(set(answer)) != n:
+        return False, "answer contains a duplicate residue"
+    if set(answer) != set(elements):
+        return False, "answer is not a permutation of the input set A"
+
+    partial = 0
+    seen = set()
+    for index, value in enumerate(answer):
+        partial = (partial + value) % modulus
+        if partial in seen:
+            return False, f"partial-sum collision at position {index + 1}: {partial} was seen before"
+        if index < n - 1 and partial == 0:
+            return False, f"forbidden zero partial sum at position {index + 1}"
+        seen.add(partial)
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the statement-aware space of permutations of A."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    return rng.sample(inst["elements"], len(inst["elements"]))
+
+
+def search_space(inst):
+    """The certificate language is exactly all n! permutations of A."""
+    return math.factorial(inst["n"])
+
+
+def enumerate_all(inst):
+    """Count valid orderings exactly only when the bounded work is small."""
+    n = inst["n"]
+    if n > 9 or math.factorial(n) > 500_000:
+        return None
+    return sum(
+        1 for candidate in itertools.permutations(inst["elements"])
+        if verify(inst, list(candidate))[0]
+    )
+
+
+def canonical_key(inst):
+    """Canonicalize under set reordering and every automorphism x -> ux."""
+    modulus = inst["modulus"]
+    present = set(inst["elements"])
+    complement = sorted(set(range(1, modulus)) - present)
+    base = complement if complement else sorted(present)
+    normalized = min(
+        tuple(sorted(value * pow(anchor, -1, modulus) % modulus
+                     for value in base))
+        for anchor in base
+    )
+    side = "complement" if complement else "set"
+    return f"Z{modulus}|n{inst['n']}|{side}|" + ",".join(map(str, normalized))
+
+
+def escalate(params):
+    """Raise n while keeping the complement short and the answer under G9 caps."""
+    n = params.get("n")
+    if n < 160:
+        return {"n": 160, "prime": 167}
+    if n < 192:
+        return {"n": 192, "prime": 199}
+    if n < 224:
+        return {"n": 224, "prime": 233}
+    return None
+
+
+def _greedy_feasible(inst, choose):
+    modulus = inst["modulus"]
+    remaining = list(inst["elements"])
+    answer = []
+    seen = set()
+    partial = 0
+    while remaining:
+        choices = []
+        for value in remaining:
+            next_sum = (partial + value) % modulus
+            if next_sum not in seen and (len(remaining) == 1 or next_sum != 0):
+                choices.append(value)
+        if not choices:
+            return None
+        value = choose(choices, partial, modulus)
+        remaining.remove(value)
+        answer.append(value)
+        partial = (partial + value) % modulus
+        seen.add(partial)
+    return answer
+
+
+def _attack_candidates(inst, seed):
+    ordered = sorted(inst["elements"])
+    alternating = []
+    left, right = 0, len(ordered) - 1
+    while left <= right:
+        alternating.append(ordered[left])
+        left += 1
+        if left <= right:
+            alternating.append(ordered[right])
+            right -= 1
+
+    restart_rng = random.Random(seed ^ 0x260219989)
+    restarts = []
+    for _ in range(256):
+        candidate = _greedy_feasible(
+            inst,
+            lambda choices, _partial, _modulus: restart_rng.choice(choices),
+        )
+        restarts.append(candidate)
+        if candidate is not None and verify(inst, candidate)[0]:
+            break
+    return {
+        "outlier_increasing_residue": ordered,
+        "greedy_smallest_feasible": _greedy_feasible(
+            inst, lambda choices, _partial, _modulus: min(choices)
+        ),
+        "random_restart_256_feasible_prefix": restarts,
+        "by_hand_alternating_low_high": alternating,
+    }
+
+
+def _reference_recover(inst):
+    """O(n^2 log k) quotient-frequency recovery, with operation counts."""
+    modulus = inst["modulus"]
+    values = sorted(inst["elements"])
+    present = set(values)
+    counts = {}
+    operations = 0
+    inverses = []
+    for value in values:
+        inverses.append(pow(value, -1, modulus))
+        operations += max(1, modulus.bit_length())
+    for inverse in inverses:
+        for value in values:
+            ratio = value * inverse % modulus
+            operations += 1
+            if ratio != 1:
+                counts[ratio] = counts.get(ratio, 0) + 1
+
+    candidates = sorted(counts, key=lambda ratio: (-counts[ratio], ratio))
+    for ratio in candidates:
+        inverse_ratio = pow(ratio, -1, modulus)
+        operations += max(1, modulus.bit_length())
+        starts = [value for value in values
+                  if value * inverse_ratio % modulus not in present]
+        operations += len(values)
+        for start in starts:
+            answer = []
+            value = start
+            for _ in values:
+                if value not in present or value in answer:
+                    break
+                answer.append(value)
+                value = value * ratio % modulus
+                operations += 1
+            if verify(inst, answer)[0]:
+                return answer, operations
+    return None, operations
+
+
+def _compact_recover(inst):
+    """Recover via the short complementary geometric run."""
+    modulus = inst["modulus"]
+    present = set(inst["elements"])
+    missing = sorted(set(range(1, modulus)) - present)
+    missing_set = set(missing)
