+        "are distinct integers in 1,...,p-1 and the array length is n."
+    ),
+    "bounds": {
+        "shape": "permutation of the n displayed residues",
+        "entry_min": 1,
+        "entry_max": "p-1",
+        "maximum_supported_n": 240,
+        "candidate_count": "n!",
