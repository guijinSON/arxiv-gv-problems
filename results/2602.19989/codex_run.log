 while rem:
  choices=[]
  for a in rem:
   z=(s+a)%p
   if z not in seen and (len(rem)==1 or z): choices.append(a)
  if not choices:return None
  a=key(choices,s,p)
  rem.remove(a);out.append(a);s=(s+a)%p;seen.add(s)
 return out

