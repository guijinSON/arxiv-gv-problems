+        "swap_two": bad_swap if bad_swap is not None else list(reversed(planted)),
+        "duplicate_one": planted[:-1] + [planted[0]],
+        "empty": [],
+        "out_of_range": [ship["p"]] + planted[1:],
+    }
+    rejection_flags = {}
+    rejection_reasons = {}
