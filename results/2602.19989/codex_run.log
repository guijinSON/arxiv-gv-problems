import random
P = 2305843009213693951  # 2"'^61-1, prime
N = 32
TRIALS_PER_SEED = 25_000

def planted(seed):
    rng = random.Random(seed)
    while True:
        q = rng.sample(range(1, P), N)
        s = 0
        seen = set()
        ok = True
        for i, x in enumerate(q):
            s = (s + x) % P
            if s in seen or (i < N - 1 and s == 0):
                ok = False
                break
            seen.add(s)
        if ok:
            return q

def valid(q):
    s = 0
    seen = set()
    last = len(q)-1
    for i, x in enumerate(q):
        s = (s+x) % P
        if s in seen or (i < last and s == 0):
            return False
        seen.add(s)
    return True

hits = 0
for seed in range(8):
    a = planted(seed)
    assert valid(a)
    rng = random.Random(10_000 + seed)
    seed_hits = 0
    for _ in range(TRIALS_PER_SEED):
        q = a[:]
        rng.shuffle(q)
        seed_hits += valid(q)
    hits += seed_hits
    print(f'"'seed={seed} hits={seed_hits}/{TRIALS_PER_SEED}')
print(f'total={hits}/{8*TRIALS_PER_SEED} p={hits/(8*TRIALS_PER_SEED):.9f}')
