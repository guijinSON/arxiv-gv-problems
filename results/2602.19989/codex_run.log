+    "demo": {"n": 7, "slack": 10},
+    "easy": {"n": 48, "slack": 56},
+    "medium": {"n": 80, "slack": 40},
+    "hard": {"n": 120, "slack": 28},
+}
+SHIPPING_DIFFICULTY = "hard"
