def prime(x):
 if x<2:return False
 if x%2==0:return x==2
 d=3
 while d*d<=x:
  if x%d==0:return False
  d+=2
 return True

def make(n,seed):
 R=random.Random(seed)
 ps=[p for p in range(2*n+1,4*n) if prime(p)]
 pairs=[]
 for p in ps:
  for q in range(2,min(16,p)):
   vals=[pow(q,i,p) for i in range(n+1)]
   if len(set(vals))==n+1:
    pairs.append((p,q))
 p,q=pairs[R.randrange(len(pairs))]
 u=R.randrange(1,p)
 A=[u*(q-1)*pow(q,i,p)%p for i in range(n)]
 if len(set(A))<n: raise Exception('dup')
