+        "carried_witness_checks": carried_checks,
+        "carried_witness_passed": carried_checks if carried_ok else 0,
+        "unrelated_instances": 20,
+        "distinct_keys": distinct_count,
+        "seeds_examined_for_diversity": diversity_seed - 10_000,
