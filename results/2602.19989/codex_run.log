 ans=[u*(q-1)*pow(q,i,p)%p for i in range(n)]
 return p,q,A,ans

def ok(p,A,ord):
 if len(ord)"'!=len(A) or set(ord)!=set(A):return False
 s=0; seen=set()
 for i,a in enumerate(ord):
  s=(s+a)%p
  if s in seen or (i<len(ord)-1 and s==0):return False
  seen.add(s)
 return True

def greedy(p,A,key):
