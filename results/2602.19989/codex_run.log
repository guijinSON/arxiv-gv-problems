+    attack_names = [
+        "outlier_increasing_residue",
+        "greedy_smallest_feasible",
+        "random_restart_256_feasible_prefix",
+        "by_hand_alternating_low_high",
+    ]
+    successes = {name: 0 for name in attack_names}
+    attack_seconds = {name: 0.0 for name in attack_names}
+    reference_successes = 0
+    reference_seconds = 0.0
+    reference_operations = []
+    compact_successes = 0
+    compact_operations = []
+    for seed in range(101, 109):
+        trial = make_instance(seed=seed, **shipping)
+        candidates, restart_seconds = _attack_candidates(trial, seed)
+        attack_seconds["random_restart_256_feasible_prefix"] += restart_seconds
+        for name in attack_names:
+            pool = candidates[name]
+            if name != "random_restart_256_feasible_prefix":
+                pool = [pool]
+            attack_started = time.perf_counter()
+            won = any(candidate is not None and verify(trial, candidate)[0]
+                      for candidate in pool)
+            attack_seconds[name] += time.perf_counter() - attack_started
+            successes[name] += int(won)
+
+        reference_started = time.perf_counter()
+        recovered, operation_count = _reference_recover(trial)
+        reference_seconds += time.perf_counter() - reference_started
+        reference_operations.append(operation_count)
+        reference_successes += int(recovered is not None and verify(trial, recovered)[0])
+
+        compact, operation_count = _compact_recover(trial)
+        compact_operations.append(operation_count)
+        compact_successes += int(compact is not None and verify(trial, compact)[0])
+
+    attacks = {
+        name: {
+            "successes": successes[name],
+            "attempts": 8,
+            "wall_clock_sec": round(attack_seconds[name] / 8, 6),
+        }
+        for name in attack_names
+    }
+    reference = {
+        "name": "pairwise modular quotient-frequency recovery",
+        "complexity": "O(n^2 log k) exact modular operations",
+        "wall_clock_sec": round(reference_seconds / 8, 6),
+        "operations": max(reference_operations),
+        "solves": f"{reference_successes}/8, as expected",
+    }
+    all_failed = all(value == 0 for value in successes.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8 and compact_successes == 8,
+        "attacks": attacks,
+        "reference_algorithm": reference,
+        "compact_route": {
+            "name": "short-complement geometric decomposition",
+            "operations": max(compact_operations),
+            "solves": f"{compact_successes}/8",
+        },
+    }
+
+    demo = make_instance(seed=3, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_fraction < 1e-6
+        and all_failed
+        and reference_successes == 8
+        and isinstance(demo_count, int),
+        "shipping_sample_hits": guess_hits,
+        "shipping_sample_total": guess_total,
+        "shipping_solution_density": guess_fraction,
+        "demo_exact_solution_count": demo_count,
+        "demo_candidate_count": search_space(demo),
+        "baseline_attack_wall_clock_sec": round(
+            attack_seconds["random_restart_256_feasible_prefix"] / 8, 6
+        ),
+        "baseline_attack_restarts": 256,
+        "reference_wall_clock_sec": reference["wall_clock_sec"],
+        "reference_operation_count": reference["operations"],
+    }
+
+    doubled_params = {"n": 2 * shipping["n"]}
+    scale_started = time.perf_counter()
+    doubled = make_instance(seed=77, **doubled_params)
+    doubled_build = time.perf_counter() - scale_started
+    doubled_ok, doubled_why = verify(doubled, doubled["answer"])
+    ladder_sizes = [params["n"] for params in DIFFICULTY.values()]
+    report["G7_scales"] = {
+        "pass": doubled_ok
+        and doubled["n"] == 2 * shipping["n"]
+        and len(render(doubled)) > len(render(inst))
+        and ladder_sizes == sorted(ladder_sizes)
+        and len(set(ladder_sizes)) == len(ladder_sizes),
+        "shipping_n": shipping["n"],
+        "doubled_n": doubled["n"],
+        "doubled_modulus": doubled["modulus"],
+        "doubled_build_sec": round(doubled_build, 6),
+        "doubled_verify_reason": doubled_why,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    expected_checks = 0
+    for seed in range(20):
+        original = make_instance(seed=seed, **shipping)
+        key = canonical_key(original)
+        units = (1, 2, original["modulus"] - 1)
+        for unit in units:
+            for reorder in (False, True):
+                transformed = _scaled_instance(
+                    original, unit,
+                    5000 + seed * 10 + unit + int(reorder),
+                )
+                if not reorder:
+                    transformed["elements"].reverse()
+                expected_checks += 1
+                invariance_checks += int(canonical_key(transformed) == key)
+                carried_checks += int(verify(transformed, transformed["answer"])[0])
+    unrelated = [canonical_key(make_instance(seed=seed, **shipping))
+                 for seed in range(20)]
+    report["G8_canonical_key"] = {
+        "pass": invariance_checks == expected_checks
+        and carried_checks == expected_checks
+        and len(set(unrelated)) == 20,
+        "invariance_checks_passed": invariance_checks,
+        "invariance_checks_total": expected_checks,
+        "carried_certificate_checks_passed": carried_checks,
+        "carried_certificate_checks_total": expected_checks,
+        "unrelated_distinct": len(set(unrelated)),
+        "unrelated_total": 20,
+    }
+
+    compact_answer = json.dumps(inst["answer"], separators=(",", ":"))
+    answer_chars = len(compact_answer)
+    answer_tokens = (answer_chars + 3) // 4
+    answer_elements = len(inst["answer"])
+    intended_operations = max(compact_operations)
+    hinted = G9_ORACLE_RESULTS["hinted"]
+    placebo = G9_ORACLE_RESULTS["placebo"]
+    hinted_verdict = G9_ORACLE_RESULTS["hinted_verdict"]
+    within_caps = (
+        answer_chars <= 2000
+        and answer_elements <= 256
+        and intended_operations <= 300
+    )
+    def _rate(arm):
+        return arm["solved"] / arm["attempts"] if arm["attempts"] else 0.0
+    report["G9_no_tool_suitability"] = {
+        "pass": hinted_verdict == "hardened" and within_caps,
+        "arms": {
+            "bare": dict(G9_ORACLE_RESULTS["bare"]),
+            "hinted": dict(hinted),
+            "placebo": dict(placebo),
+        },
+        "hinted_minus_placebo": _rate(hinted) - _rate(placebo),
+        "hinted_verdict": hinted_verdict,
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "within_caps": within_caps,
+    }
+
+    report["all_passed"] = all(
+        value.get("pass")
+        for key, value in report.items()
+        if key.startswith("G") and isinstance(value, dict)
+    )
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

