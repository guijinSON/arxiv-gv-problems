-def make_instance(n, seed=0, **params):
-    """Inverse-generate a cyclic-group subset and a known sequencing.
-
-    The answer is built from a primitive-root geometric progression before the
-    unordered set is exposed.  Generation never solves the public instance.
-    """
-    prime = params.pop("prime", None)
-    if params:
-        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
-    if isinstance(n, bool) or not isinstance(n, int) or n < 4:
-        raise ValueError("n must be an integer at least 4")
-    if prime is None:
-        prime = _next_prime(n + 9)
-    if (isinstance(prime, bool) or not isinstance(prime, int)
-            or not _is_prime(prime) or n >= prime - 1):
-        raise ValueError("prime must be prime and satisfy n < prime-1")
-
-    classes = _primitive_root_classes(prime)
-    if not classes:
-        raise ValueError("no primitive root class found")
-    rng = random.Random(seed)
-
-    # Consecutive seeds use different structural classes while available.  The
-    # random scale still makes their displayed numeric marginals exchangeable.
-    ratio = classes[seed % len(classes)]
-    scale = rng.randrange(1, prime)
-    first = scale * (ratio - 1) % prime
-    answer = []
-    value = first
-    for _ in range(n):
-        answer.append(value)
-        value = value * ratio % prime
-    if len(set(answer)) != n or 0 in answer:
-        raise AssertionError("primitive-root construction lost distinctness")
-
-    elements = list(answer)
-    rng.shuffle(elements)
-    return {
-        "family": "sequenceability in a cyclic group",
-        "n": n,
-        "modulus": prime,
-        "elements": elements,
-        "answer": answer,
-    }
-
