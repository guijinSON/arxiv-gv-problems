+    transformed = dict(inst)
+    p = inst["p"]
+    transformed["elements"] = [(unit * value) % p for value in inst["elements"]]
+    transformed["answer"] = [(unit * value) % p for value in inst["answer"]]
+    if seed is not None:
+        rng = random.Random(seed)
+        rng.shuffle(transformed["elements"])
+    return transformed
