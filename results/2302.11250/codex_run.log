+        partitions, _ = _count_partitions(inst["item_values"], inst["target_sum"])
+    except OverflowError:
+        return None
+    item_orders = partitions * math.factorial(n) * (math.factorial(3) ** n)
+    return item_orders * math.factorial(3 * n)
