+        "greedy_min_degree": {"attempts": 0, "successes": 0},
+        "random_restart": {"attempts": 0, "successes": 0},
+    }
+    for seed in range(800, 808):
+        attacked = make_instance(seed=seed, **shipping_params)
+        results = _attack_results(
+            attacked["item_values"],
