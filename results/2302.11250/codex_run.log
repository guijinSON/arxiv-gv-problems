+def _build_answer_from_groups(inst, groups):
+    if not _partition_ok(groups, inst["item_values"], inst["target_sum"]):
+        return None
+    n = inst["n"]
+    d_for_stage = {}
+    for d_index in range(n - 1):
+        target = inst["target_creditors"][f"d{d_index}"]
