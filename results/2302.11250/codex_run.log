+        mapping[edge_id]: creditor
+        for edge_id, creditor in transformed["target_creditors"].items()
+    }
+    transformed["answer"] = [
+        sorted((mapping[left], mapping[right])) for left, right in transformed["answer"]
+    ]
+    return transformed
