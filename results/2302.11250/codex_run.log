+        "hits": hits,
+        "total": trials,
+        "empirical_probability": probability,
+        "sampler": "uniform item order, c-filler bijection, and d-filler bijection; fixed 3-item/pulse block shape",
+        "structure_aware_space": str(search_space(inst)),
