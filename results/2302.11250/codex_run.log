+def _relabel_nodes(inst, rng):
+    transformed = copy.deepcopy(inst)
+    old_nodes = list(transformed["nodes"])
+    new_nodes = [f"B{i}" for i in range(len(old_nodes))]
+    rng.shuffle(new_nodes)
