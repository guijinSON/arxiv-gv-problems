+    # G6: attacks must fail on at least eight unrelated production instances.
+    attack_counts = {
+        "rank_extremes": {"attempts": 0, "successes": 0},
+        "greedy_min_degree": {"attempts": 0, "successes": 0},
+        "random_restart": {"attempts": 0, "successes": 0},
+    }
