rows=[json.loads(x) for x in open('llm_loop_transcript.jsonl') if x.strip()]
for i,r in enumerate(rows,1):
 print(i,r['preset'],r['model'],r['seed'],r['solved'],'parsed=',r['parsed'],'verify=',r['verify_ok'],'reason=',r['verify_reason'],'error=',(r['error'] or '')[:90], 'reply_len=',len(r['reply'] or ''))
 if r['solved']=='failed' and not r['parsed']:
  print('  reply_tail:',repr((r['reply'] or '')[-500:]))
