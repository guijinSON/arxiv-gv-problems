+    transformed["external_assets"] = {
+        mapping[node]: value for node, value in transformed["external_assets"].items()
+    }
+    for edge in transformed["edges"]:
+        edge["debtor"] = mapping[edge["debtor"]]
+        edge["creditor"] = mapping[edge["creditor"]]
