+    items = [f"i{i}" for i in range(3 * n)]
+    c_fillers = [f"c{i}" for i in range(3 * n)]
+    d_fillers = [f"d{i}" for i in range(n - 1)]
+    rng.shuffle(items)
+    rng.shuffle(c_fillers)
+    rng.shuffle(d_fillers)
