+DIFFICULTY = {
+    "demo": {"n": 8, "q": 3},
+    "easy": {"n": 43, "q": 7},
+    "medium": {"n": 67, "q": 11},
+    "hard": {"n": 89, "q": 17},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An ordered q-tuple of nonempty integer lists whose entries partition "
+        "the fixed vertex set {0,...,n-1}; block order is significant in the "
+        "sampling language although verification accepts every ordering."
+    ),
+    "bounds": {
+        "max_vertices_at_shipping": 89,
+        "max_blocks_at_shipping": 17,
+        "vertex_min": 0,
+        "vertex_max_at_shipping": 88,
+    },
+}
