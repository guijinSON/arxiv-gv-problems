+        colors = new_colors
+    vertex_histogram = sorted(Counter(colors).items())
+    edge_histogram = sorted(Counter(
+        tuple(sorted((colors[u], colors[v]))) for u, v in inst["edges"]
+    ).items())
+    return [vertex_histogram, edge_histogram]
 
