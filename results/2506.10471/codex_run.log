+def _compact_affine_partition(inst: dict) -> tuple[list[list[int]], int]:
+    """Reconstruct the certificate from the ordered markers.
+
+    If the markers are ``b`` and ``a+b`` modulo n, successive additions of
+    ``a`` visit the relabelled construction positions 0,1,...,n-1.  Their
+    independent-set classes repeat modulo q.  This is the intended no-tool
+    route, kept executable here so its operation count and correctness are
+    tested rather than merely asserted in metadata.
+    """
+
+    n, q = inst["n"], inst["q"]
+    offset, second = inst["markers"]
+    multiplier = (second - offset) % n
+    if math.gcd(multiplier, n) != 1:
+        raise ValueError("ordered markers do not define an affine permutation")
+
+    blocks = [[] for _ in range(q)]
+    current = offset
+    operations = 1  # the subtraction defining multiplier
+    for construction_position in range(n):
+        blocks[construction_position % q].append(current)
+        operations += 1  # assign the cyclic position to its periodic class
+        if construction_position + 1 < n:
+            current = (current + multiplier) % n
+            operations += 1
+    for block in blocks:
+        block.sort()
+    return blocks, operations
+
