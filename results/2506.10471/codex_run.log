+def _tree_code_from_solution(inst, solution):
+    """AHU code of the quotient tree of the disjoint core octahedra."""
+    blocks = [set(block) for block in solution]
+    adjacency = [set() for _ in blocks]
+    edges = _edge_set(inst)
