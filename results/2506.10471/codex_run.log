+def escalate(params):
+    """First add fixed-answer decoys; only then approach the 256-atom cap."""
+    current = dict(params)
+    n = current.get("n")
+    decoys = current.get("decoys", 0)
+    if not _is_int(n) or not _is_int(decoys):
+        return None
+    face_cap = 12 * n - 4
+    if decoys < face_cap:
+        current["decoys"] = min(face_cap, decoys + max(n, decoys // 2, 1))
+        return current
+    if n < 42:
