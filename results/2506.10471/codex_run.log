+"""Verified problem generator from arXiv:2506.10471, Theorem 9.
+
+The paper proves that every k-tree has a unique partition into k+1
+independent sets (up to reordering the sets).  This module constructs a
+(q-1)-tree together with that partition, then applies a structure-preserving
+affine relabelling of the vertices.  The requested witness is the partition.
+
+Only the Python standard library is used.  Importing this module performs no
+I/O and consumes no randomness.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import math
+import os
+import random
+import re
+import statistics
+import time
+from collections import deque
+from typing import Any
+
+
+TRACK = "B"
+
+PROBLEM_PROFILE = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "graph",
+    "certificate_form": "integer_tuple",
+    "native_objects": ["(q-1)-tree adjacency list", "partition into independent sets"],
+    "verification_operations": [
+        "integer range and partition checks",
+        "edge scan for independence",
+    ],
+    "domain_essentiality": "native",
+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "change of variables",
+    "intuition_description": (
+        "The marked pair determines an affine cyclic reindexing under which the "
+        "unique independent-set classes repeat periodically; without it one must "
+        "color the chordal graph mechanically."
+    ),
+    "hardness_basis": (
+        "Track B: bucketed maximum-cardinality search followed by greedy chordal "
+        "coloring is O(n+m) and, at the hard preset n=89, q=17, performs 11,372 "
+        "counted adjacency/bucket/color operations (about 0.001 seconds); the "
+        "affine cyclic route uses 177 exact modular updates, whereas thousands of "
+        "edge operations are not executable in the no-tool evaluation context."
+    ),
+    "max_answer_tokens": 73,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"]
+        + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 8, "q": 3},
+    "easy": {"n": 43, "q": 7},
+    "medium": {"n": 67, "q": 11},
+    "hard": {"n": 89, "q": 17},
+}
+
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "An ordered q-tuple of nonempty increasing integer lists whose entries "
+        "partition the fixed vertex set {0,...,n-1}; block order is significant "
+        "in the sampling language, while verification also accepts reordered "
+        "blocks and reordered entries."
+    ),
+    "bounds": {
+        "max_vertices_at_shipping": 89,
+        "max_blocks_at_shipping": 17,
+        "vertex_min": 0,
+        "vertex_max_at_shipping": 88,
+    },
+}
+
+STRUCTURAL_HINT = (
+    "The marked pair determines an affine cyclic ordering with periodic independent-set classes."
+)
+PLACEBO_HINT = (
+    "The marked pair is included to keep the vertex notation and indexing unambiguous."
+)
+
+# Filled from the three isolated hardening runs.  The diagnostic is deliberately
+# not part of G9(c)'s pass condition.
+G9_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
+    "hinted_verdict": "not_run",
+}
+
+NOTES = r"""
+Paper basis.  Section 2 defines k-trees recursively.  Section 3, Theorem 9
+proves that every k-tree has a unique partition into k+1 independent sets and
+that the union of any t classes induces a (t-1)-tree.  Its induction gives the
+certificate used here: start with K_q and, whenever a new vertex is attached
+to a (q-1)-clique, put it in the one class missing from that clique.
+
+Step-0 algorithm audit.  This is Track B, not Track A.  A promised k-tree is
+chordal.  Maximum-cardinality search finds a perfect elimination order in
+O(n+m), and greedy coloring in the reverse elimination order returns the
+unique q-partition.  The reference implementation in selftest measures that
+successful route.  The family therefore makes no complexity-theoretic or
+average-case hardness claim.  Its narrower no-tool claim is that thousands of
+edge inspections cannot be carried out in context, while a solver who notices
+the affine cyclic relabelling fixed by the marked pair can regenerate all
+classes in 2(n-1)+1 modular updates.
+
+Easy regimes and attacks.  Supplying the k-tree construction order would make
+the paper's induction a direct one-pass coloring algorithm, so the statement
+supplies only the graph.  A completely arbitrary relabelling would remove the
+compact route, so generation instead transports the known certificate through
+an affine permutation.  The label-residue, degree-outlier, natural-order
+greedy, randomized-greedy-restart, and anchor-distance ansatz attacks are all
+measured on independent seeds.  The domain-standard MCS algorithm is expected
+to succeed and is reported separately as reference_algorithm, as Track B
+requires.
+""".strip()
+
+
+_ANSWER_RE = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+_ENUMERATION_CAP = 100_000
+_G4_SAMPLES = 200_000
+
+
+def _validate_parameters(n: int, q: int) -> None:
+    if isinstance(n, bool) or not isinstance(n, int) or n < 6:
+        raise ValueError("n must be an integer at least 6")
+    if isinstance(q, bool) or not isinstance(q, int) or q < 3:
+        raise ValueError("q must be an integer at least 3")
+    if q >= n:
+        raise ValueError("q must be smaller than n")
+
+
+def _choose_affine_multiplier(n: int, rng: random.Random) -> int:
+    """Choose a nontrivial unit modulo n without rejection on the witness."""
+
+    units = [a for a in range(2, n - 1) if math.gcd(a, n) == 1]
+    if not units:
+        # This branch is unreachable for the supported n>=6, but keeping the
+        # fallback explicit makes arbitrary caller parameters safe.
+        units = [a for a in range(1, n) if math.gcd(a, n) == 1]
+    return rng.choice(units)
+
+
+def make_instance(n: int, seed: int = 0, *, q: int = 3) -> dict:
+    """Construct a relabelled (q-1)-tree and its unique q-partition.
+
+    The witness is known by Theorem 9's induction.  No graph coloring or other
+    certificate search is run by the generator.
+    """
+
+    _validate_parameters(n, q)
+    rng = random.Random(seed)
+
+    # Construction-space colors are fixed before the graph is assembled.  The
+    # initial q vertices form K_q, one vertex in each independent-set class.
+    color = [v % q for v in range(n)]
+    edges: set[tuple[int, int]] = set()
+    initial_clique = tuple(range(q))
+    maximal_cliques: list[tuple[int, ...]] = [initial_clique]
+
+    for v in range(q):
+        for u in range(v):
+            edges.add((u, v))
+
+    # Each maximal q-clique contains exactly one vertex of every color.  To add
+    # v, omit the member of its color and join v to the remaining q-1 clique.
+    for v in range(q, n):
+        parent = rng.choice(maximal_cliques)
+        omitted = next(u for u in parent if color[u] == color[v])
+        attachment = tuple(u for u in parent if u != omitted)
+        for u in attachment:
+            edges.add((min(u, v), max(u, v)))
+        maximal_cliques.append(tuple(sorted(attachment + (v,))))
+
+    # Carry the certificate through a nontrivial affine relabelling.  The two
+    # marked vertices are the images of construction positions 0 and 1.  This
+    # fact is not required by verify; it is the solver-visible compression clue.
+    multiplier = _choose_affine_multiplier(n, rng)
+    offset = rng.randrange(n)
+
+    def relabel(v: int) -> int:
+        return (multiplier * v + offset) % n
+
+    relabelled_edges = [
+        tuple(sorted((relabel(u), relabel(v)))) for u, v in edges
+    ]
+    relabelled_edges.sort()
+
+    answer = []
+    for c in range(q):
+        answer.append(sorted(relabel(v) for v in range(n) if color[v] == c))
+
+    return {
+        "family": "unique independent-set partition of a (q-1)-tree",
+        "n": n,
+        "q": q,
+        "vertices": list(range(n)),
+        "edges": [list(e) for e in relabelled_edges],
+        "markers": [relabel(0), relabel(1)],
+        "answer": answer,
+    }
+
+
+def _compact_json(value: Any) -> str:
+    return json.dumps(value, separators=(",", ":"))
+
+
+def render(inst: dict) -> str:
+    """Return the complete solver-facing statement, with no hint by default."""
+
+    n = inst["n"]
+    q = inst["q"]
+    marker_a, marker_b = inst["markers"]
+    edge_rows = "\n".join(f"{u} {v}" for u, v in sorted(inst["edges"]))
+    example = _compact_json([[i] for i in range(q)])
+    statement = f"""UNIQUE PARTITION OF A (q-1)-TREE
+
+All graphs here are finite, simple, and undirected.  A set of vertices is
+independent when no edge has both endpoints in that set.  A (q-1)-tree starts
+as the complete graph K_q.  It is then built by repeatedly adding one new
+vertex adjacent to exactly all q-1 vertices of an existing (q-1)-clique.
+
+The graph below is promised to be a (q-1)-tree.  Such a graph has a unique
+partition into q independent sets, apart from reordering the sets.  Find that
+partition.  The two marked vertices are ordered instance data.
+
+Vertices are the integers 0 through {n - 1}, inclusive.
+q = {q}
+ordered marked pair = ({marker_a}, {marker_b})
+number of edges = {len(inst['edges'])}
+Each following row is one undirected edge "u v"; no edge is repeated:
+{edge_rows}
+
+Your answer must be a JSON array of exactly {q} nonempty JSON arrays.  Every
+vertex 0,...,{n - 1} must occur exactly once in total, and each inner array
+must be an independent set.  The order of the {q} inner arrays and the order
+inside each array do not matter.  Repeats and omitted vertices are forbidden.
+
+Give your final answer inside <answer></answer> tags, as the JSON array just
+described.  Example of the syntax only: <answer>{example}</answer>
+Output nothing else inside the tags."""
+
+    mode = os.environ.get("GV_HINT_MODE")
+    if mode == "structural":
+        statement += "\n\nHint: " + STRUCTURAL_HINT
+    elif mode == "placebo":
+        statement += "\n\nHint: " + PLACEBO_HINT
+    return statement
+
+
+def _well_shaped_parsed(value: Any) -> bool:
+    return (
+        isinstance(value, list)
+        and all(isinstance(block, list) for block in value)
+        and all(
+            isinstance(v, int) and not isinstance(v, bool)
+            for block in value
+            for v in block
+        )
+    )
+
+
+def parse_answer(text: Any) -> object | None:
+    """Parse a nested JSON answer from tags, fences, or surrounding prose."""
+
+    if not isinstance(text, str):
+        return None
+
+    candidates: list[str] = []
+    tagged = _ANSWER_RE.findall(text)
+    candidates.extend(reversed(tagged))
+    candidates.extend(
+        m.group(1)
+        for m in re.finditer(r"```(?:json)?\s*(.*?)```", text, re.I | re.S)
+    )
+
+    for body in candidates:
+        try:
+            value = json.loads(body.strip())
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continue
+        if _well_shaped_parsed(value):
+            return value
+
+    decoder = json.JSONDecoder()
+    for pos, ch in enumerate(text):
+        if ch == "[":
+            try:
+                value, _ = decoder.raw_decode(text[pos:])
+            except (TypeError, ValueError, json.JSONDecodeError):
+                continue
+            if _well_shaped_parsed(value):
+                return value
+    return None
+
+
+def _adjacency(inst: dict) -> list[set[int]]:
+    n = inst["n"]
+    adj = [set() for _ in range(n)]
+    for edge in inst["edges"]:
+        if not isinstance(edge, (list, tuple)) or len(edge) != 2:
+            raise ValueError("malformed instance edge")
+        u, v = edge
+        adj[u].add(v)
+        adj[v].add(u)
+    return adj
+
+
+def verify(inst: dict, answer: Any) -> tuple[bool, str]:
+    """Check any proposed partition directly; never consult inst['answer']."""
+
+    n = inst["n"]
+    q = inst["q"]
+    if not isinstance(answer, list):
+        return False, "answer must be a JSON array"
+    if len(answer) != q:
+        return False, f"expected exactly {q} blocks"
+    if any(not isinstance(block, list) for block in answer):
+        return False, "every block must be a JSON array"
+    if any(len(block) == 0 for block in answer):
+        return False, "every block must be nonempty"
+
+    owner: dict[int, int] = {}
+    for block_index, block in enumerate(answer):
+        for v in block:
+            if isinstance(v, bool) or not isinstance(v, int):
+                return False, "every vertex label must be an integer"
+            if not (0 <= v < n):
+                return False, f"vertex {v} is outside the allowed range 0..{n - 1}"
+            if v in owner:
+                return False, f"vertex {v} occurs more than once"
+            owner[v] = block_index
+
+    missing = [v for v in range(n) if v not in owner]
+    if missing:
+        preview = ",".join(map(str, missing[:5]))
+        return False, f"partition misses vertices: {preview}"
+
+    for u, v in inst["edges"]:
+        if owner[u] == owner[v]:
+            return False, f"block {owner[u]} is not independent: edge {u}-{v} is internal"
+    return True, "ok"
+
+
+def random_candidate(inst: dict, rng: random.Random) -> object:
+    """Sample uniformly from labeled surjective q-assignments.
+
+    Shape, exact block count, nonemptiness, and the partition constraint are
+    built into the sampling prior.  Edge-independence is the property being
+    searched for and is therefore not pre-enforced.
+    """
+
+    n, q = inst["n"], inst["q"]
+    while True:
+        labels = [rng.randrange(q) for _ in range(n)]
+        if len(set(labels)) == q:
+            break
+    blocks = [[] for _ in range(q)]
+    for v, c in enumerate(labels):
+        blocks[c].append(v)
+    return blocks
+
+
+def search_space(inst: dict) -> int:
+    """Return q! S(n,q), the number of labeled surjective assignments."""
+
+    n, q = inst["n"], inst["q"]
+    return sum((-1) ** i * math.comb(q, i) * (q - i) ** n for i in range(q + 1))
+
+
+def enumerate_all(inst: dict) -> int | None:
+    """Brute-force valid answers when q^n is below a strict work cap."""
+
+    n, q = inst["n"], inst["q"]
+    if q**n > _ENUMERATION_CAP:
+        return None
+    valid = 0
+    for labels in itertools.product(range(q), repeat=n):
+        if len(set(labels)) != q:
+            continue
+        blocks = [[] for _ in range(q)]
+        for v, c in enumerate(labels):
+            blocks[c].append(v)
+        if verify(inst, blocks)[0]:
+            valid += 1
+    return valid
+
+
+def _wl_signature(inst: dict) -> tuple[Any, ...]:
+    """A relabelling-invariant marked-graph signature via color refinement."""
+
+    n, q = inst["n"], inst["q"]
+    adj = _adjacency(inst)
+    marker_a, marker_b = inst["markers"]
+    initial = [
+        (len(adj[v]), 1 if v == marker_a else 2 if v == marker_b else 0)
+        for v in range(n)
+    ]
+    palette = {sig: i for i, sig in enumerate(sorted(set(initial)))}
+    colors = [palette[sig] for sig in initial]
+
+    for _ in range(n):
+        signatures = [
+            (colors[v], tuple(sorted(colors[u] for u in adj[v]))) for v in range(n)
+        ]
+        palette = {sig: i for i, sig in enumerate(sorted(set(signatures)))}
+        refined = [palette[sig] for sig in signatures]
+        if refined == colors:
+            break
+        colors = refined
+
+    cell_sizes: dict[int, int] = {}
+    for c in colors:
+        cell_sizes[c] = cell_sizes.get(c, 0) + 1
+    cell_edges: dict[tuple[int, int], int] = {}
+    for u, v in inst["edges"]:
+        pair = tuple(sorted((colors[u], colors[v])))
+        cell_edges[pair] = cell_edges.get(pair, 0) + 1
+    return (
+        n,
+        q,
+        tuple(sorted(cell_sizes.items())),
+        tuple(sorted((a, b, count) for (a, b), count in cell_edges.items())),
+        colors[marker_a],
+        colors[marker_b],
+    )
+
+
+def canonical_key(inst: dict) -> str:
+    """Return an isomorphism-invariant WL key for the ordered-marked graph.
+
+    Color refinement is a strong cheap invariant, not a complete graph
+    isomorphism canonizer.  Possible collisions are documented in README.md.
+    """
+
+    payload = repr(_wl_signature(inst)).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def escalate(params: dict) -> dict | str | None:
+    """Increase crowding while keeping the 89-vertex answer length fixed first."""
+
+    n = int(params.get("n", 0))
+    q = int(params.get("q", 0))
+    if n == 89 and q < 23:
+        return {"n": 89, "q": 23}
+    if n == 89 and q < 29:
+        return {"n": 89, "q": 29}
+    if n < 97:
+        return {"n": 97, "q": 23}
+    if q < 31:
+        return {"n": 97, "q": 31}
+    if q < 37:
+        return {"n": 97, "q": 37}
+    if n < 113:
+        return {"n": 113, "q": 31}
+    if n < 131:
+        return {"n": 131, "q": 37}
+    if n < 149:
+        return {"n": 149, "q": 43}
+    # Raising n past 150 would exceed the 300-update route cap.  Raising q much
+    # further at fixed n makes the initial clique dominate the instance and
+    # exposes rather than hides the partition, so no honest hardness axis is
+    # left within G9(c).
+    return "cap_bound"
+
+
+def _blocks_from_labels(labels: list[int], q: int) -> list[list[int]]:
+    blocks = [[] for _ in range(q)]
+    for v, c in enumerate(labels):
+        blocks[c].append(v)
+    return blocks
+
+
+def _attack_label_residue(inst: dict) -> tuple[bool, int, str]:
+    labels = [v % inst["q"] for v in range(inst["n"])]
+    answer = _blocks_from_labels(labels, inst["q"])
+    ok, reason = verify(inst, answer)
+    return ok, inst["n"], reason
+
+
+def _attack_degree_rank(inst: dict) -> tuple[bool, int, str]:
+    adj = _adjacency(inst)
+    order = sorted(range(inst["n"]), key=lambda v: (len(adj[v]), v))
+    labels = [0] * inst["n"]
+    for rank, v in enumerate(order):
+        labels[v] = rank % inst["q"]
+    answer = _blocks_from_labels(labels, inst["q"])
+    ok, reason = verify(inst, answer)
+    return ok, inst["n"] + 2 * len(inst["edges"]), reason
+
+
+def _greedy_attempt(
+    inst: dict, order: list[int], rng: random.Random | None = None
+) -> tuple[list[list[int]], bool, int]:
+    adj = _adjacency(inst)
+    q = inst["q"]
+    labels = [-1] * inst["n"]
+    operations = 0
+    complete = True
+    for v in order:
+        used = set()
+        for u in adj[v]:
+            operations += 1
+            if labels[u] >= 0:
+                used.add(labels[u])
+        available = [c for c in range(q) if c not in used]
+        operations += q
+        if not available:
+            complete = False
+            labels[v] = 0
+        else:
+            labels[v] = rng.choice(available) if rng is not None else available[0]
+    return _blocks_from_labels(labels, q), complete, operations
+
+
+def _attack_natural_greedy(inst: dict) -> tuple[bool, int, str]:
+    answer, complete, operations = _greedy_attempt(inst, list(range(inst["n"])))
+    ok, reason = verify(inst, answer)
+    if not complete and ok:
+        reason = "greedy reported a dead end despite producing a valid coloring"
+    return ok, operations, reason
+
+
+def _attack_random_restart(inst: dict, seed: int, restarts: int = 64) -> tuple[bool, int, str]:
+    rng = random.Random(seed)
+    total_operations = 0
+    last_reason = "no restart completed"
+    for _ in range(restarts):
+        order = list(range(inst["n"]))
+        rng.shuffle(order)
+        answer, complete, operations = _greedy_attempt(inst, order, rng)
+        total_operations += operations
+        if complete:
+            ok, reason = verify(inst, answer)
+            if ok:
+                return True, total_operations, "ok"
+            last_reason = reason
+    return False, total_operations, last_reason
+
+
+def _bfs_distances(adj: list[set[int]], source: int) -> list[int]:
+    distance = [-1] * len(adj)
+    distance[source] = 0
+    todo = deque([source])
+    while todo:
+        v = todo.popleft()
+        for u in adj[v]:
+            if distance[u] < 0:
+                distance[u] = distance[v] + 1
+                todo.append(u)
+    return distance
+
+
+def _attack_anchor_distance(inst: dict) -> tuple[bool, int, str]:
+    adj = _adjacency(inst)
+    da = _bfs_distances(adj, inst["markers"][0])
+    db = _bfs_distances(adj, inst["markers"][1])
+    order = sorted(range(inst["n"]), key=lambda v: (da[v], db[v], v))
+    labels = [0] * inst["n"]
+    for rank, v in enumerate(order):
+        labels[v] = rank % inst["q"]
+    answer = _blocks_from_labels(labels, inst["q"])
+    ok, reason = verify(inst, answer)
+    operations = 4 * len(inst["edges"]) + inst["n"]
+    return ok, operations, reason
+
+
+def _reference_mcs_coloring(inst: dict) -> tuple[list[list[int]], int]:
+    """Bucketed MCS plus greedy coloring; O(n+m) on the promised graph."""
+
+    n, q = inst["n"], inst["q"]
+    adj = _adjacency(inst)
+    weight = [0] * n
+    unnumbered = [True] * n
+    buckets = [set() for _ in range(n)]
+    buckets[0].update(range(n))
+    maximum = 0
+    selection: list[int] = []
+    operations = 0
+
+    for _ in range(n):
+        while maximum >= 0 and not buckets[maximum]:
+            maximum -= 1
+            operations += 1
+        if maximum < 0:
+            raise ValueError("MCS exhausted its buckets early")
+        v = buckets[maximum].pop()
+        unnumbered[v] = False
+        selection.append(v)
+        operations += 2
+        for u in adj[v]:
+            operations += 1
+            if unnumbered[u]:
+                buckets[weight[u]].remove(u)
+                weight[u] += 1
+                buckets[weight[u]].add(u)
+                maximum = max(maximum, weight[u])
+                operations += 4
+
+    labels = [-1] * n
+    for v in selection:
+        used = set()
+        for u in adj[v]:
+            operations += 1
+            if labels[u] >= 0:
+                used.add(labels[u])
+        chosen = None
+        for c in range(q):
+            operations += 1
+            if c not in used:
+                chosen = c
+                break
+        if chosen is None:
+            raise ValueError("MCS greedy coloring used more than q colors")
+        labels[v] = chosen
+        operations += 1
+    return _blocks_from_labels(labels, q), operations
+
+
+def _relabel_for_test(inst: dict, permutation: list[int], reverse_edges: bool = False) -> dict:
+    """Carry an instance and its held certificate through a vertex permutation."""
+
+    n = inst["n"]
+    if sorted(permutation) != list(range(n)):
+        raise ValueError("test permutation is not bijective")
+    edges = [
+        sorted((permutation[u], permutation[v])) for u, v in inst["edges"]
+    ]
+    edges.sort()
+    if reverse_edges:
+        edges.reverse()
+    return {
+        **{k: v for k, v in inst.items() if k not in {"vertices", "edges", "markers", "answer"}},
+        "vertices": list(range(n)),
+        "edges": edges,
+        "markers": [permutation[v] for v in inst["markers"]],
+        "answer": [sorted(permutation[v] for v in block) for block in inst["answer"]],
+    }
+
+
+def _answer_metrics(answer: object) -> tuple[int, int, int]:
+    blob = _compact_json(answer)
+
+    def atoms(value: object) -> int:
+        if isinstance(value, dict):
+            return sum(atoms(v) for v in value.values())
+        if isinstance(value, (list, tuple)):
+            return sum(atoms(v) for v in value)
+        return 1
+
+    count = atoms(answer)
+    return len(blob), (len(blob) + 3) // 4, count
+
+
+def selftest() -> dict:
+    """Run all mandatory local gates and return their measured report."""
+
+    report: dict[str, Any] = {
+        "paper": "2506.10471",
+        "family": "unique independent-set partition of a (q-1)-tree",
+        "track": TRACK,
+        "shipping_difficulty": SHIPPING_DIFFICULTY,
+    }
+
+    # G1: every named preset, three independent seeds.
+    g1_failures = []
+    g1_checks = 0
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 8675309):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_checks += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": reason})
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "checks": g1_checks,
+        "failures": g1_failures,
+    }
+
+    shipping_params = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=20260905, **shipping_params)
+
+    # G2: five deliberately different corruption modes and reason strings.
+    planted = json.loads(json.dumps(inst["answer"]))
+    corruptions: dict[str, object] = {}
+    drop = json.loads(json.dumps(planted))
+    drop[0].pop()
+    corruptions["drop_one"] = drop
+
+    swap = json.loads(json.dumps(planted))
+    marker_a, marker_b = inst["markers"]
+    owner_a = next(i for i, block in enumerate(swap) if marker_a in block)
+    owner_b = next(i for i, block in enumerate(swap) if marker_b in block)
+    ia, ib = swap[owner_a].index(marker_a), swap[owner_b].index(marker_b)
+    swap[owner_a][ia], swap[owner_b][ib] = marker_b, marker_a
+    corruptions["swap_one"] = swap
+
+    duplicate = json.loads(json.dumps(planted))
+    duplicate[1].append(duplicate[0][0])
+    corruptions["duplicate"] = duplicate
+    corruptions["empty"] = []
+    out_of_range = json.loads(json.dumps(planted))
+    out_of_range[0][0] = inst["n"] + 7
+    corruptions["out_of_range"] = out_of_range
+
+    corruption_results = {}
+    reasons = []
+    for name, bad in corruptions.items():
+        ok, reason = verify(inst, bad)
+        corruption_results[name] = {"accepted": ok, "reason": reason}
+        reasons.append(reason)
+    report["G2_rejects_corruption"] = {
+        "pass": all(not row["accepted"] for row in corruption_results.values())
+        and len(set(reasons)) == len(reasons),
+        "distinct_reasons": len(set(reasons)),
+        "cases": corruption_results,
+    }
+
+    # G3: realistic prose/fence wrapper, direct round trip, and malformed text.
+    answer_text = _compact_json(inst["answer"])
+    realistic = (
+        "I used the unique coloring of the promised chordal graph.\n\n"
+        "```json\n<answer>" + answer_text + "</answer>\n```\n"
+        "The block order is arbitrary."
+    )
+    malformed = ["", "no answer", "<answer>[1,2</answer>", "```json\nnull\n```"]
+    report["G3_round_trip"] = {
+        "pass": parse_answer(realistic) == inst["answer"]
+        and parse_answer("<answer>" + answer_text + "</answer>") == inst["answer"]
+        and all(parse_answer(s) is None for s in malformed),
+        "realistic_response_round_trip": parse_answer(realistic) == inst["answer"],
+        "json_native_round_trip": json.loads(json.dumps(inst["answer"])) == inst["answer"],
+        "malformed_returned_none": sum(parse_answer(s) is None for s in malformed),
+        "malformed_total": len(malformed),
+    }
+
+    # G4/G5 density at the shipping preset, sampled from the declared prior.
+    guess_rng = random.Random(4510471)
+    guess_hits = 0
+    t0 = time.perf_counter()
+    for _ in range(_G4_SAMPLES):
+        candidate = random_candidate(inst, guess_rng)
+        if verify(inst, candidate)[0]:
+            guess_hits += 1
+    density_wall = time.perf_counter() - t0
+    empirical = guess_hits / _G4_SAMPLES
+    exact_valid_orderings = math.factorial(inst["q"])
+    exact_space = search_space(inst)
+    exact_probability = exact_valid_orderings / exact_space
+    report["G4_guess_resistance"] = {
+        "pass": exact_probability < 1e-6 and empirical < 1e-6,
+        "hits": guess_hits,
+        "total": _G4_SAMPLES,
+        "empirical_probability": empirical,
+        "exact_probability": exact_probability,
+        "exact_valid_orderings_by_theorem": exact_valid_orderings,
+        "structure_aware_space": exact_space,
+        "sampling_prior": "uniform labeled surjections onto q nonempty blocks",
+        "sampling_wall_clock_sec": round(density_wall, 6),
+    }
+
+    demo = make_instance(seed=0, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+
+    # Reference timing uses multiple repetitions; operation count is exact for
+    # this implementation and graph, while wall time is a diagnostic.
+    ref_times = []
+    ref_answer: list[list[int]] | None = None
+    ref_operations = 0
+    for _ in range(25):
+        start = time.perf_counter()
+        ref_answer, ref_operations = _reference_mcs_coloring(inst)
+        ref_times.append(time.perf_counter() - start)
+    ref_ok, ref_reason = verify(inst, ref_answer)
+
+    attack_start = time.perf_counter()
+    random_ok, random_operations, random_reason = _attack_random_restart(
+        inst, seed=99173, restarts=64
+    )
+    attack_wall = time.perf_counter() - attack_start
+    report["G5_density_and_baseline_cost"] = {
+        "pass": exact_probability < 1e-6 and empirical < 1e-6 and ref_ok and not random_ok,
+        "shipping_density_hits": guess_hits,
+        "shipping_density_samples": _G4_SAMPLES,
+        "shipping_solution_fraction_estimate": empirical,
+        "shipping_enumeration_valid_answer_count": None,
+        "shipping_theorem_valid_answer_count": exact_valid_orderings,
+        "shipping_exact_solution_fraction": exact_probability,
+        "demo_exact_valid_answer_count": demo_count,
+        "demo_candidate_space": search_space(demo),
+        "reference_wall_clock_sec_median": round(statistics.median(ref_times), 9),
+        "reference_operations": ref_operations,
+        "reference_verify_reason": ref_reason,
+        "strongest_failing_attack": "random_restart_greedy_64",
+        "strongest_attack_wall_clock_sec": round(attack_wall, 6),
+        "strongest_attack_operations": random_operations,
+        "strongest_attack_reason": random_reason,
+    }
+
+    # G6: construction-aware probes plus the successful Track-B reference.
+    attack_functions = {
+        "label_residue": lambda x, s: _attack_label_residue(x),
+        "outlier_degree_rank": lambda x, s: _attack_degree_rank(x),
+        "greedy_natural_order": lambda x, s: _attack_natural_greedy(x),
+        "random_restart_greedy_64": lambda x, s: _attack_random_restart(x, s, 64),
+        "anchor_distance_ansatz": lambda x, s: _attack_anchor_distance(x),
+    }
+    attack_rows = {
+        name: {"successes": 0, "attempts": 0, "operations": 0, "reasons": []}
+        for name in attack_functions
+    }
+    reference_successes = 0
+    reference_operations_total = 0
+    reference_wall_total = 0.0
+    for seed in range(8100, 8108):
+        attack_inst = make_instance(seed=seed, **shipping_params)
+        for name, attack in attack_functions.items():
+            ok, operations, reason = attack(attack_inst, seed + 100_000)
+            row = attack_rows[name]
+            row["attempts"] += 1
+            row["successes"] += int(ok)
+            row["operations"] += operations
+            if reason not in row["reasons"] and len(row["reasons"]) < 4:
+                row["reasons"].append(reason)
+        start = time.perf_counter()
+        ref, ops = _reference_mcs_coloring(attack_inst)
+        reference_wall_total += time.perf_counter() - start
+        reference_operations_total += ops
+        reference_successes += int(verify(attack_inst, ref)[0])
+
+    all_failed = all(row["successes"] == 0 for row in attack_rows.values())
+    report["G6_adversary_panel"] = {
+        "pass": all_failed and reference_successes == 8,
+        "attacks": attack_rows,
+        "reference_algorithm": {
+            "name": "bucketed maximum-cardinality search plus greedy chordal coloring",
+            "complexity": "O(n+m)",
+            "wall_clock_sec_total": round(reference_wall_total, 6),
+            "operations_total": reference_operations_total,
+            "solves": f"{reference_successes}/8, as expected",
+        },
+    }
+
+    # G7: double n without changing q, so the witness language and reference
+    # work both grow while construction remains theorem-backed.
+    doubled = make_instance(
+        n=2 * shipping_params["n"], q=shipping_params["q"], seed=314159
+    )
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and search_space(doubled) > search_space(inst),
+        "base_n": inst["n"],
+        "doubled_n": doubled["n"],
+        "base_edges": len(inst["edges"]),
+        "doubled_edges": len(doubled["edges"]),
+        "base_space": search_space(inst),
+        "doubled_space": search_space(doubled),
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    # G8: arbitrary relabelling, input reordering, and their composition over
+    # twenty seeds, with carried-certificate checks and unrelated distinctness.
+    invariance_total = 0
+    invariance_passed = 0
+    transformation_total = 0
+    transformation_passed = 0
+    g8_failures = []
+    unrelated_keys = []
+    for seed in range(20_000, 20_020):
+        original = make_instance(seed=seed, **shipping_params)
+        base_key = canonical_key(original)
+        unrelated_keys.append(base_key)
+        perm_rng = random.Random(seed ^ 0x5A17)
+        permutation = list(range(original["n"]))
+        perm_rng.shuffle(permutation)
+
+        edge_reordered = {**original, "edges": list(reversed(original["edges"]))}
+        relabelled = _relabel_for_test(original, permutation, reverse_edges=False)
+        composed = _relabel_for_test(original, permutation, reverse_edges=True)
+        for label, transformed in (
+            ("edge_reordering", edge_reordered),
+            ("vertex_relabelling", relabelled),
+            ("composed", composed),
+        ):
+            invariance_total += 1
+            if canonical_key(transformed) == base_key:
+                invariance_passed += 1
+            else:
+                g8_failures.append({"seed": seed, "transformation": label, "kind": "key"})
+            transformation_total += 1
+            witness = original["answer"] if label == "edge_reordering" else transformed["answer"]
+            if verify(transformed, witness)[0]:
+                transformation_passed += 1
+            else:
+                g8_failures.append(
+                    {"seed": seed, "transformation": label, "kind": "certificate"}
+                )
+
+    distinct_count = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures
+        and invariance_passed == invariance_total
+        and transformation_passed == transformation_total
+        and distinct_count == len(unrelated_keys),
+        "invariance_checks_passed": invariance_passed,
+        "invariance_checks_total": invariance_total,
+        "real_transformation_verifications_passed": transformation_passed,
+        "real_transformation_verifications_total": transformation_total,
+        "distinct_unrelated_keys": distinct_count,
+        "unrelated_instances": len(unrelated_keys),
+        "transformations": [
+            "input-edge reordering",
+            "arbitrary vertex permutation carrying the ordered markers",
+            "their composition",
+        ],
+        "failures": g8_failures,
+    }
+
+    # G9(a,b) are recorded diagnostics.  Only the exact size/effort caps gate.
+    answer_chars, answer_tokens, answer_elements = _answer_metrics(inst["answer"])
+    intended_operations = 2 * (inst["n"] - 1) + 1
+    hinted = G9_RESULTS["hinted"]
+    placebo = G9_RESULTS["placebo"]
+    hinted_rate = hinted["solved"] / hinted["attempts"] if hinted["attempts"] else 0.0
+    placebo_rate = placebo["solved"] / placebo["attempts"] if placebo["attempts"] else 0.0
+    within_caps = (
+        answer_chars <= 2000 and answer_elements <= 256 and intended_operations <= 300
+    )
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": {
+            "bare": dict(G9_RESULTS["bare"]),
+            "hinted": dict(hinted),
+            "placebo": dict(placebo),
+        },
+        "hinted_minus_placebo": hinted_rate - placebo_rate,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": answer_chars,
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_operations,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(gate.get("pass") for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

