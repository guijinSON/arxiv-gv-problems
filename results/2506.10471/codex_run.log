+    """Number of unordered b-packings of unordered six-sets from N vertices."""
+    total = inst["vertex_count"]
+    blocks = inst["target_blocks"]
+    used = 6 * blocks
+    if used > total:
+        return 0
+    return math.factorial(total) // (
