+    if len(blocks) == 1:
+        return "()"
+    degrees = [len(x) for x in adjacency]
+    leaves = [i for i, degree in enumerate(degrees) if degree <= 1]
+    remaining = len(blocks)
+    while remaining > 2:
+        next_leaves = []
