+def _bfs_distances(adj: list[set[int]], source: int) -> list[int]:
+    distance = [-1] * len(adj)
+    distance[source] = 0
+    todo = deque([source])
+    while todo:
+        v = todo.popleft()
+        for u in adj[v]:
+            if distance[u] < 0:
+                distance[u] = distance[v] + 1
+                todo.append(u)
+    return distance
