+    p = _next_prime(int(n))
+    degree = int(params.get("degree", min(12, p - 1)))
+    if degree < 2 or degree % 2:
+        raise ValueError("degree must be a positive even integer")
+    if degree >= p:
+        raise ValueError("degree must be strictly smaller than the prime side size")
