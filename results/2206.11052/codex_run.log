        "ell": ell,
        "c": c,
        "base_positions": base_positions,
        "transvections": trans,
        "evaluation_origin": origin,
        "evaluation_step": step,
        "evaluation_points": points,
        "row_multipliers": multipliers,
        "answer": answer,
    }


