+        unrelated_keys.append(base_key)
+    report["G8_canonical_key"] = {
+        "pass": (invariance_passed == invariance_attempted
+                 and transformed_verified == 20
+                 and len(set(unrelated_keys)) == 20),
+        "invariance_checks_passed": invariance_passed,
+        "invariance_checks_attempted": invariance_attempted,
+        "transformed_witnesses_verified": transformed_verified,
+        "transformed_witnesses_attempted": 20,
+        "unrelated_distinct_keys": len(set(unrelated_keys)),
+        "unrelated_instances": 20,
+        "invariant_kind": (
+            "unsigned sorted rooted-distance-profile fingerprint; "
+            "not a complete graph-isomorphism canonizer"
+        ),
+    }
+
+    blob = json.dumps(ans)
+    answer_tokens = _answer_token_measure(ans)
+    answer_elements = len(ans)
+    # Cross-ratio pruning: at most 27 mixed anchor triples, one 8-operation
+    # cross-ratio/prediction test each; at most three survivors get a second
+    # 8-operation test, then one 36-operation 3x4 homogeneous solve.
+    intended_ops = 27 * 8 + 3 * 8 + 36
+    arms = G9_RESULTS["arms"]
+    hinted_minus_placebo = (
+        arms["hinted"]["solved"] / max(1, arms["hinted"]["attempts"])
+        - arms["placebo"]["solved"] / max(1, arms["placebo"]["attempts"])
+    )
+    within_caps = (len(blob) <= 2000 and answer_elements <= 256
+                   and intended_ops <= 300)
+    report["G9_no_tool_suitability"] = {
+        "pass": within_caps,
+        "arms": arms,
+        "hinted_minus_placebo": hinted_minus_placebo,
+        "hinted_verdict": G9_RESULTS["hinted_verdict"],
+        "answer_chars": len(blob),
+        "answer_tokens": answer_tokens,
+        "answer_elements": answer_elements,
+        "intended_route_operations": intended_ops,
+        "caps": {"chars": 2000, "elements": 256, "operations": 300},
+    }
+
+    gate_values = [v for k, v in report.items()
+                   if k.startswith("G") and isinstance(v, dict)]
+    report["all_passed"] = all(v.get("pass") for v in gate_values)
+    return report
