+        })
+    strongest = max(reference_runs, key=lambda x: x["wall_clock_sec"])
+    report["G5_density_and_baseline_cost"] = {
+        "pass": all(run["ok"] for run in reference_runs),
+        "shipping_density_hits": hits,
+        "shipping_density_samples": samples,
