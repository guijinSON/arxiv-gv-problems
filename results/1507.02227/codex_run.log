   654	def _restricted_monomial_kernel(inst):
   655	    """Try alpha_j=a_j*s^k+b_j*t^k, normalized with a_0=1."""
   656	    d = inst["degree"]
   657	    k = inst["syzygy_degree"]
   658	    forms = inst["forms"]
   659	    # Solve the five unknowns a1,a2,b0,b1,b2 over Q by RREF of [A|-f0].
   660	    from fractions import Fraction
   661	
   662	    equations = []
   663	    for r in range(d + k + 1):
   664	        def f(j, q):
   665	            return forms[j][q] if 0 <= q <= d else 0
   666	        equations.append([
   667	            Fraction(f(1, r)), Fraction(f(2, r)),
   668	            Fraction(f(0, r - k)), Fraction(f(1, r - k)),
   669	            Fraction(f(2, r - k)), Fraction(-f(0, r)),
   670	        ])
   671	    row = 0
   672	    pivots = []
   673	    for col in range(5):
   674	        pivot = next((r for r in range(row, len(equations)) if equations[r][col]), None)
   675	        if pivot is None:
   676	            continue
   677	        equations[row], equations[pivot] = equations[pivot], equations[row]
   678	        v = equations[row][col]
   679	        equations[row] = [x / v for x in equations[row]]
   680	        for r in range(len(equations)):
   681	            if r != row and equations[r][col]:
   682	                c = equations[r][col]
   683	                equations[r] = [x - c * y for x, y in zip(equations[r], equations[row])]
   684	        pivots.append(col)
   685	        row += 1
   686	    if any(all(x == 0 for x in eq[:5]) and eq[5] != 0 for eq in equations):
   687	        return None
   688	    if len(pivots) < 5:
   689	        return None
   690	    solution = [Fraction(0)] * 5
   691	    for r, c in enumerate(pivots):
   692	        solution[c] = equations[r][5]
   693	    if any(x.denominator != 1 for x in solution):
   694	        return None
   695	    a1, a2, b0, b1, b2 = [int(x) for x in solution]
   696	    coeffs = []
   697	    for a, b in ((1, b0), (a1, b1), (a2, b2)):
   698	        p = [0] * (k + 1)
   699	        p[0], p[k] = a, b
   700	        coeffs.append(p)
   701	    return _coeffs_to_json(coeffs, k)
