   227	
   228	def _json_to_coeffs(answer, degree, bound, normalization=(0, 0, 1)):
   229	    if not isinstance(answer, list) or len(answer) != 3:
   230	        return None, "answer must contain exactly three polynomials"
   231	    coeffs = []
   232	    for p_index, poly in enumerate(answer):
   233	        if not isinstance(poly, list):
   234	            return None, f"polynomial {p_index} must be a list of terms"
   235	        row = [0] * (degree + 1)
   236	        seen = set()
   237	        last_t = -1
   238	        for term in poly:
   239	            if (
   240	                not isinstance(term, list)
   241	                or len(term) != 2
   242	                or not isinstance(term[0], list)
   243	                or len(term[0]) != 2
   244	                or not isinstance(term[1], list)
   245	                or len(term[1]) != 2
   246	            ):
   247	                return None, "each term must be [[numerator,denominator],[s_exp,t_exp]]"
   248	            num, den = term[0]
   249	            es, et = term[1]
   250	            ints = (num, den, es, et)
   251	            if any(isinstance(x, bool) or not isinstance(x, int) for x in ints):
   252	                return None, "coefficients and exponents must be integers"
   253	            if den <= 0 or math.gcd(num, den) != 1:
   254	                return None, "rational coefficients must be reduced with positive denominator"
   255	            if den != 1:
   256	                return None, "this bounded language requires denominator 1"
   257	            if num == 0:
   258	                return None, "zero-coefficient terms must be omitted"
   259	            if abs(num) > bound:
   260	                return None, "coefficient exceeds the declared bound"
   261	            if es < 0 or et < 0 or es + et != degree:
   262	                return None, f"every monomial must have total degree {degree}"
   263	            if et in seen:
   264	                return None, "duplicate monomial"
   265	            if et <= last_t:
   266	                return None, "terms are not in canonical exponent order"
   267	            seen.add(et)
   268	            last_t = et
   269	            row[et] = num
   270	        coeffs.append(row)
   271	    norm_poly, norm_t_exp, norm_value = normalization
   272	    if (
   273	        isinstance(norm_poly, bool) or not isinstance(norm_poly, int)
   274	        or isinstance(norm_t_exp, bool) or not isinstance(norm_t_exp, int)
   275	        or isinstance(norm_value, bool) or not isinstance(norm_value, int)
   276	        or not 0 <= norm_poly < 3 or not 0 <= norm_t_exp <= degree
   277	    ):
   278	        return None, "malformed normalization convention"
   279	    if coeffs[norm_poly][norm_t_exp] != norm_value:
   280	        return None, (
   281	            f"normalization requires coefficient {norm_value} on "
   282	            f"s^{degree-norm_t_exp}t^{norm_t_exp} in polynomial {norm_poly}"
   283	        )
   284	    return coeffs, "ok"
   285	
   286	
   287	def make_instance(n, seed=0, **params):
   288	    """Construct a rational-curve parameterization and its minimal syzygy.
   289	
   290	    ``n`` is the curve degree d.  It must be a multiple of k and at least 4k.
   291	    The certificate comes from the first Hilbert--Burch row before the three
   292	    minors are mixed; no coefficient-kernel problem is solved here.
   293	    """
   294	    k = params.pop("k", None)
   295	    if params:
   296	        raise TypeError("unknown parameters: " + ", ".join(sorted(params)))
   297	    if isinstance(n, bool) or not isinstance(n, int):
   298	        raise TypeError("n must be an integer")
   299	    if isinstance(k, bool) or not isinstance(k, int):
   300	        raise TypeError("k must be an integer")
   301	    if k < 2 or n < 4 * k or n % k:
   302	        raise ValueError("require k >= 2, n >= 4k, and n divisible by k")
   303	
   304	    rng = random.Random(seed)
   305	    nmat, mmat = rng.choice(_admissible_matrices())
   306	    ratio = n // k
   307	    q_values = [rng.choice(_Q_VALUES) for _ in range(2, ratio)]
   308	
   309	    # Hilbert--Burch rows over X=s+2t, Y=t:
   310	    # alpha = (X^k, 0, Y^k)
   311	    # beta  = (Y^(d-k), X^(d-k), X^(d-k-1)Y
   312	    #          + sum_{j=2}^{d/k-1} q_j X^(d-k-jk)Y^(jk)).
   313	    m = n - k
   314	    g0 = _scale(_x_y_monomial(m, k), -1)
   315	    g2 = _x_y_monomial(n, 0)
   316	    g1 = [0] * (n + 1)
   317	    g1[n] = 1
   318	    g1 = _add(g1, _scale(_x_y_monomial(n - 1, 1), -1))
   319	    for j, q in zip(range(2, ratio), q_values):
   320	        g1 = _add(g1, _scale(_x_y_monomial(n - j * k, j * k), -q))
   321	    forms = _mix_forms(mmat, [g0, g1, g2])
   322	
   323	    xk = _x_y_monomial(k, 0)
   324	    yk = _x_y_monomial(0, k)
   325	    answer_coeffs = [
   326	        _add(_scale(xk, nmat[0][j]), _scale(yk, nmat[2][j]))
   327	        for j in range(3)
   328	    ]
   329	    bound = 4 * (3 ** k)
   330	    answer = _coeffs_to_json(answer_coeffs, k)
   331	    return {
   332	        "degree": n,
   333	        "syzygy_degree": k,
   334	        "coefficient_bound": bound,
   335	        "normalization": [0, 0, 1],
   336	        "forms": forms,
   337	        "answer": answer,
   338	    }
   339	
