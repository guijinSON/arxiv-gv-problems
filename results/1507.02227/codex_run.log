   133	full normalized coefficient language.  Each fails.  Exact modular Gaussian
   134	elimination is reported separately as the successful Track-B reference
   135	algorithm.
   136	""".strip()
   137	
   138	
   139	_PRIME = 2305843009213693951  # 2^61-1, prime.
   140	_Q_VALUES = (-5, -4, -3, -2, -1, 1, 2, 3, 4, 5)
   141	_MATRIX_CACHE = None
   142	
   143	
   144	def _det3(a):
   145	    return (
   146	        a[0][0] * (a[1][1] * a[2][2] - a[1][2] * a[2][1])
   147	        - a[0][1] * (a[1][0] * a[2][2] - a[1][2] * a[2][0])
   148	        + a[0][2] * (a[1][0] * a[2][1] - a[1][1] * a[2][0])
   149	    )
   150	
   151	
   152	def _inv3_unimodular(a):
   153	    det = _det3(a)
   154	    if abs(det) != 1:
   155	        raise ValueError("matrix is not unimodular")
   156	    # Cofactor transpose, divided by det (which is +/-1).
   157	    return [
   158	        [
   159	            (
   160	                a[(j + 1) % 3][(i + 1) % 3]
   161	                * a[(j + 2) % 3][(i + 2) % 3]
   162	                - a[(j + 1) % 3][(i + 2) % 3]
   163	                * a[(j + 2) % 3][(i + 1) % 3]
   164	            )
   165	            // det
   166	            for j in range(3)
   167	        ]
   168	        for i in range(3)
   169	    ]
   170	
   171	
   172	def _admissible_matrices():
   173	    """Small N=M^-1 with N[0][0]=1 and a fully mixed inverse M."""
   174	    global _MATRIX_CACHE
   175	    if _MATRIX_CACHE is None:
   176	        values = (-2, -1, 1, 2)
   177	        found = []
   178	        for tail in itertools.product(values, repeat=8):
   179	            nmat = [
   180	                [1, tail[0], tail[1]],
   181	                [tail[2], tail[3], tail[4]],
   182	                [tail[5], tail[6], tail[7]],
   183	            ]
   184	            if abs(_det3(nmat)) != 1:
   185	                continue
   186	            mmat = _inv3_unimodular(nmat)
   187	            if all(x != 0 for row in mmat for x in row) and max(
   188	                abs(x) for row in mmat for x in row
   189	            ) <= 16:
   190	                found.append((nmat, mmat))
   191	        _MATRIX_CACHE = tuple(found)
   192	    return _MATRIX_CACHE
