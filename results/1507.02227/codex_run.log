   625	
   626	def _attack_l1_outlier(inst):
   627	    k = inst["syzygy_degree"]
   628	    index = min(range(3), key=lambda j: sum(abs(x) for x in inst["forms"][j]))
   629	    coeffs = [[0] * (k + 1) for _ in range(3)]
   630	    coeffs[0] = _poly_xk(k)
   631	    coeffs[index] = _add(coeffs[index], _poly_tk(k))
   632	    return _coeffs_to_json(coeffs, k)
