   392	def parse_answer(text):
   393	    if not isinstance(text, str):
   394	        return None
   395	    matches = re.findall(r"<answer\s*>(.*?)</answer\s*>", text, flags=re.I | re.S)
   396	    if not matches:
   397	        return None
   398	    body = matches[-1].strip()
   399	    fence = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", body, flags=re.I | re.S)
   400	    if fence:
   401	        body = fence.group(1).strip()
   402	    try:
   403	        return json.loads(body)
   404	    except (TypeError, ValueError):
   405	        return None
