   194	
   195	def _add(p, q):
   196	    if len(p) != len(q):
   197	        raise ValueError("polynomial degree mismatch")
   198	    return [a + b for a, b in zip(p, q)]
   199	
   200	
   201	def _scale(p, c):
   202	    return [c * x for x in p]
   203	
   204	
   205	def _x_y_monomial(x_degree, y_degree):
   206	    """Coefficients of (s+2t)^x_degree * t^y_degree."""
   207	    degree = x_degree + y_degree
   208	    out = [0] * (degree + 1)
   209	    for i in range(x_degree + 1):
   210	        out[i + y_degree] = math.comb(x_degree, i) * (2 ** i)
   211	    return out
   212	
   213	
   214	def _mix_forms(matrix, forms):
   215	    return [
   216	        [sum(matrix[i][j] * forms[j][r] for j in range(3)) for r in range(len(forms[0]))]
   217	        for i in range(3)
   218	    ]
