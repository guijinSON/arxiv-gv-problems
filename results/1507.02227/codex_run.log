   534	def escalate(params):
   535	    n = int(params["n"])
   536	    k = int(params["k"])
   537	    # Keep the degree-k polynomial witness fixed in size and add four more
   538	    # k-blocks of degree-d coefficient data (more moduli and more equations).
   539	    return {"n": n + 4 * k, "k": k}
