   541	
   542	def _reference_syzygy(inst):
   543	    """Standard coefficient-kernel algorithm over a large exact prime field."""
   544	    d = inst["degree"]
   545	    k = inst["syzygy_degree"]
   546	    forms = inst["forms"]
   547	    bound = inst["coefficient_bound"]
   548	    if 2 * bound >= _PRIME:
   549	        raise ValueError("reference prime is too small for coefficient recovery")
   550	    cols = 3 * (k + 1)
   551	    rows = d + k + 1
   552	    matrix = []
   553	    for r in range(rows):
   554	        row = []
   555	        for j in range(3):
   556	            for i in range(k + 1):
   557	                q = r - i
   558	                row.append(forms[j][q] % _PRIME if 0 <= q <= d else 0)
   559	        matrix.append(row)
   560	
   561	    operations = 0
   562	    pivots = []
   563	    pivot_row = 0
   564	    for col in range(cols):
   565	        pivot = next((r for r in range(pivot_row, rows) if matrix[r][col]), None)
   566	        if pivot is None:
   567	            continue
   568	        matrix[pivot_row], matrix[pivot] = matrix[pivot], matrix[pivot_row]
   569	        inv = pow(matrix[pivot_row][col], _PRIME - 2, _PRIME)
   570	        operations += 1
   571	        for c in range(col, cols):
   572	            matrix[pivot_row][c] = (matrix[pivot_row][c] * inv) % _PRIME
   573	            operations += 1
   574	        for r in range(pivot_row + 1, rows):
   575	            factor = matrix[r][col]
   576	            if not factor:
   577	                continue
   578	            for c in range(col, cols):
   579	                matrix[r][c] = (
   580	                    matrix[r][c] - factor * matrix[pivot_row][c]
   581	                ) % _PRIME
   582	                operations += 2
   583	        pivots.append(col)
   584	        pivot_row += 1
   585	        if pivot_row == rows:
   586	            break
   587	
   588	    free = [c for c in range(cols) if c not in set(pivots)]
   589	    if len(free) != 1:
   590	        raise ValueError(f"expected a one-dimensional kernel, found {len(free)}")
   591	    vector = [0] * cols
   592	    vector[free[0]] = 1
   593	    for row_index in range(len(pivots) - 1, -1, -1):
   594	        col = pivots[row_index]
   595	        total = 0
   596	        for c in range(col + 1, cols):
   597	            if vector[c] and matrix[row_index][c]:
   598	                total = (total + matrix[row_index][c] * vector[c]) % _PRIME
   599	                operations += 2
   600	        vector[col] = (-total) % _PRIME
   601	    if vector[0] == 0:
   602	        raise ValueError("kernel cannot be normalized at the declared coefficient")
   603	    inv0 = pow(vector[0], _PRIME - 2, _PRIME)
   604	    operations += 1
   605	    vector = [(x * inv0) % _PRIME for x in vector]
   606	    operations += cols
   607	    centered = [x if x <= _PRIME // 2 else x - _PRIME for x in vector]
   608	    if any(abs(x) > bound for x in centered):
   609	        raise ValueError("modular recovery exceeded the declared coefficient bound")
   610	    coeffs = [centered[j * (k + 1):(j + 1) * (k + 1)] for j in range(3)]
   611	    answer = _coeffs_to_json(coeffs, k)
   612	    ok, reason = verify(inst, answer)
   613	    if not ok:
   614	        raise ValueError("recovered vector failed exact verification: " + reason)
   615	    return answer, {"field_operations": operations, "rows": rows, "columns": cols}
   616	
