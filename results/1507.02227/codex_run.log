+    "reduction_kind": "none",
+    "reduction": None,
+    "reduction_source": "paper_central",
+    "intuition_type": "invariant",
+    "intuition_description": (
+        "Two special directions in the span of the parameterizing forms have "
+        "high root multiplicities; recognizing them compresses a large "
+        "coefficient-nullspace calculation to two small relations."
+    ),
+    "hardness_basis": (
+        "Track B: exact modular Gaussian elimination on the degree-16 "
+        "coefficient-convolution matrix is O((d+k)k^2), measured at the hard "
+        "preset as 412,679 field operations and about 0.03 s; the invariant "
+        "route uses 242 exact operations but requires recognizing two mixed "
+        "high-multiplicity directions."
+    ),
+    "max_answer_tokens": 312,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
