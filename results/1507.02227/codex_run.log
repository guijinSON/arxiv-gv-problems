   408	def verify(inst, answer):
   409	    try:
   410	        d = inst["degree"]
   411	        k = inst["syzygy_degree"]
   412	        bound = inst["coefficient_bound"]
   413	        forms = inst["forms"]
   414	        if (
   415	            not isinstance(forms, list)
   416	            or len(forms) != 3
   417	            or any(not isinstance(f, list) or len(f) != d + 1 for f in forms)
   418	        ):
   419	            return False, "malformed instance forms"
   420	        coeffs, reason = _json_to_coeffs(
   421	            answer, k, bound, tuple(inst.get("normalization", [0, 0, 1]))
   422	        )
   423	        if coeffs is None:
   424	            return False, reason
   425	        # Compare coefficients from the s-edge inward.  Wrong random candidates
   426	        # almost always fail at the first coefficient; valid certificates still
   427	        # receive a complete exact identity check.
   428	        for r in range(d + k + 1):
   429	            total = 0
   430	            lo = max(0, r - d)
   431	            hi = min(k, r)
   432	            for j in range(3):
   433	                for i in range(lo, hi + 1):
   434	                    total += coeffs[j][i] * forms[j][r - i]
   435	            if total != 0:
   436	                return False, f"syzygy identity fails at t-exponent {r}"
   437	        # Exercise the repository's canonical sparse-polynomial arithmetic as
   438	        # an independent exact check.  The direct convolution above remains the
   439	        # standard-library fallback and gives random candidates a cheap, sound
   440	        # early rejection path.
   441	        if sparse_poly is not None:
   442	            a_polys = [
   443	                {(k - i, i): Fraction(c) for i, c in enumerate(row) if c}
   444	                for row in coeffs
   445	            ]
   446	            f_polys = [
   447	                {(d - i, i): Fraction(c) for i, c in enumerate(row) if c}
   448	                for row in forms
   449	            ]
   450	            identity = {}
   451	            for a_poly, f_poly in zip(a_polys, f_polys):
   452	                identity = sparse_poly.add(identity, sparse_poly.mul(a_poly, f_poly))
   453	            if not sparse_poly.is_zero(identity):
   454	                return False, "sparse-polynomial identity cross-check failed"
   455	        return True, "ok"
   456	    except (KeyError, TypeError, ValueError, OverflowError) as exc:
   457	        return False, f"malformed answer or instance: {exc}"
   458	
