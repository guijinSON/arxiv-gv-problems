   704	def _transform_permute(inst, order):
   705	    out = dict(inst)
   706	    out["forms"] = [inst["forms"][j][:] for j in order]
   707	    out["answer"] = [inst["answer"][j] for j in order]
   708	    norm_poly, norm_t_exp, norm_value = inst.get("normalization", [0, 0, 1])
   709	    out["normalization"] = [order.index(norm_poly), norm_t_exp, norm_value]
   710	    return out
