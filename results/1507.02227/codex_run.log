   713	def _transform_swap_variables(inst):
   714	    out = dict(inst)
   715	    out["forms"] = [list(reversed(p)) for p in inst["forms"]]
   716	    transformed = []
   717	    for poly in inst["answer"]:
   718	        terms = [[[c[0], c[1]], [e[1], e[0]]] for c, e in poly]
   719	        terms.sort(key=lambda term: term[1][1])
   720	        transformed.append(terms)
   721	    out["answer"] = transformed
   722	    norm_poly, norm_t_exp, norm_value = inst.get("normalization", [0, 0, 1])
   723	    out["normalization"] = [norm_poly, inst["syzygy_degree"] - norm_t_exp, norm_value]
   724	    return out
