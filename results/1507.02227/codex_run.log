+    "hardness_basis": (
+        "Track B: exact modular Gaussian elimination on the degree-16 "
+        "coefficient-convolution matrix is O((d+k)k^2), measured at the hard "
+        "preset as 412,679 field operations and about 0.04 s; the invariant "
+        "route uses 242 exact operations but requires recognizing two mixed "
+        "high-multiplicity directions."
+    ),
+    "max_answer_tokens": 312,
+}
+
+NATIVE = {
+    "domain": PROBLEM_PROFILE["native_domain"],
+    "core": PROBLEM_PROFILE["computational_core"],
+    "objects": PROBLEM_PROFILE["native_objects"],
+    "intuition": (
+        PROBLEM_PROFILE["intuition_type"] + ": "
+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY = {
+    "demo": {"n": 8, "k": 2},
+    "easy": {"n": 72, "k": 8},
+    "medium": {"n": 120, "k": 12},
+    "hard": {"n": 160, "k": 16},
+}
+SHIPPING_DIFFICULTY = "hard"
+
+CERTIFICATE_LANGUAGE = {
+    "description": (
+        "A normalized triple of homogeneous degree-k polynomials over Q, "
+        "stored sparsely as [[[numerator,denominator],[s_exp,t_exp]],...]. "
