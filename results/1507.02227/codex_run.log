   727	def _transform_shear(inst):
   728	    out = dict(inst)
   729	    f0, f1, f2 = inst["forms"]
   730	    out["forms"] = [_add(f0, f1), f1[:], f2[:]]
   731	    coeffs, reason = _json_to_coeffs(
   732	        inst["answer"], inst["syzygy_degree"], inst["coefficient_bound"],
   733	        tuple(inst.get("normalization", [0, 0, 1])),
   734	    )
   735	    if coeffs is None:
   736	        raise AssertionError(reason)
   737	    carried = [coeffs[0], _add(coeffs[1], _scale(coeffs[0], -1)), coeffs[2]]
   738	    out["answer"] = _coeffs_to_json(carried, inst["syzygy_degree"])
   739	    return out
