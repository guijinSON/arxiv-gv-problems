+        for i in range(k + 1):
+            if j == norm_poly and i == norm_t_exp:
+                row.append(norm_value)
+            else:
+                row.append(rng.randint(-bound, bound))
+        coeffs.append(row)
+    return _coeffs_to_json(coeffs, k)
