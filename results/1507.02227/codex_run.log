   742	def _transform_parity(inst):
   743	    """Carry the problem through the source relabelling t -> -t."""
   744	    out = dict(inst)
   745	    out["forms"] = [
   746	        [c if i % 2 == 0 else -c for i, c in enumerate(poly)]
   747	        for poly in inst["forms"]
   748	    ]
   749	    transformed = []
   750	    for poly in inst["answer"]:
   751	        terms = json.loads(json.dumps(poly))
   752	        for term in terms:
   753	            if term[1][1] % 2:
   754	                term[0][0] = -term[0][0]
   755	        transformed.append(terms)
   756	    out["answer"] = transformed
   757	    return out
