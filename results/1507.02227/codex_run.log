+def _transform_shear(inst):
+    out = dict(inst)
+    f0, f1, f2 = inst["forms"]
+    out["forms"] = [_add(f0, f1), f1[:], f2[:]]
+    coeffs, reason = _json_to_coeffs(
+        inst["answer"], inst["syzygy_degree"], inst["coefficient_bound"],
+        tuple(inst.get("normalization", [0, 0, 1])),
