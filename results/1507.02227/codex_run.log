   635	def _small_edge_relation(inst):
   636	    k = inst["syzygy_degree"]
   637	    forms = inst["forms"]
   638	    for a in range(-2, 3):
   639	        for b in range(-2, 3):
   640	            if all(forms[0][r] + a * forms[1][r] + b * forms[2][r] == 0
