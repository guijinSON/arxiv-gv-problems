   460	def random_candidate(inst, rng):
   461	    if not hasattr(rng, "randint"):
   462	        raise TypeError("rng must provide randint")
   463	    k = inst["syzygy_degree"]
   464	    bound = inst["coefficient_bound"]
   465	    norm_poly, norm_t_exp, norm_value = inst.get("normalization", [0, 0, 1])
   466	    coeffs = []
   467	    for j in range(3):
   468	        row = []
   469	        for i in range(k + 1):
   470	            if j == norm_poly and i == norm_t_exp:
   471	                row.append(norm_value)
   472	            else:
   473	                row.append(rng.randint(-bound, bound))
   474	        coeffs.append(row)
   475	    return _coeffs_to_json(coeffs, k)
