   491	def _rref_rows(rows):
   492	    """Canonical rational row space, represented by integer pairs."""
   493	    from fractions import Fraction
   494	
   495	    a = [[Fraction(x) for x in row] for row in rows]
   496	    nr = len(a)
   497	    nc = len(a[0])
   498	    pivot_row = 0
   499	    for col in range(nc):
   500	        pivot = next((r for r in range(pivot_row, nr) if a[r][col]), None)
   501	        if pivot is None:
   502	            continue
   503	        a[pivot_row], a[pivot] = a[pivot], a[pivot_row]
   504	        v = a[pivot_row][col]
   505	        a[pivot_row] = [x / v for x in a[pivot_row]]
   506	        for r in range(nr):
   507	            if r != pivot_row and a[r][col]:
   508	                c = a[r][col]
   509	                a[r] = [x - c * y for x, y in zip(a[r], a[pivot_row])]
   510	        pivot_row += 1
   511	        if pivot_row == nr:
   512	            break
   513	    a = [row for row in a if any(row)]
   514	    return tuple(tuple((x.numerator, x.denominator) for x in row) for row in a)
   515	
   516	
   517	def _source_variants(forms):
   518	    identity = [row[:] for row in forms]
   519	    reverse = [list(reversed(row)) for row in forms]
   520	    parity = [[x if i % 2 == 0 else -x for i, x in enumerate(row)] for row in forms]
   520	    parity = [[x if i % 2 == 0 else -x for i, x in enumerate(row)] for row in forms]
   521	    reverse_parity = [list(reversed(row)) for row in parity]
   522	    return (identity, reverse, parity, reverse_parity)
   523	
   524	
   525	def canonical_key(inst):
   526	    """Hash a target-GL(3)-invariant row space and basic source relabellings."""
   527	    forms = inst["forms"]
   528	    normal_forms = [_rref_rows(v) for v in _source_variants(forms)]
   529	    best = min(normal_forms)
   530	    payload = json.dumps(best, separators=(",", ":"))
   531	    return hashlib.sha256(payload.encode("ascii")).hexdigest()
   532	
