+    ),
+    "bounds": {
+        "n_polynomials": 3,
+        "degree_parameter": "k",
+        "coefficient_bound": "4*3^k",
+        "denominator": 1,
+        "normalization": "coefficient of s^k in polynomial 0 equals 1",
+    },
+}
