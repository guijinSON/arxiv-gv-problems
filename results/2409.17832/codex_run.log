+            raise AssertionError(f"G2 accepted {name}")
+        reasons[name] = reason
+    g2_pass = len(set(reasons.values())) == len(reasons)
+    report["G2_rejects_corruption"] = {
+        "pass": g2_pass,
+        "rejected": len(reasons),
+        "distinct_reasons": len(set(reasons.values())),
+        "reasons": reasons,
+    }
