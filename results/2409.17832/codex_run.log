+    scaled_ok = verify(doubled, doubled["answer"])[0]
+    report["G7_scales"] = {
+        "pass": scaled_ok and search_space(doubled) > space,
+        "shipping_n": ship["n"],
+        "doubled_n": doubled["n"],
+        "shipping_space_bits": space.bit_length(),
