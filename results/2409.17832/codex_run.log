+    return {"n": n + max(24, n // 3), "weight_bits": min(256, bits + 4)}
+
+
+def _relabel_and_reorder(inst: dict, rng: random.Random, relabel: bool, reorder: bool) -> dict:
+    transformed = {
+        key: (list(value) if isinstance(value, list) else value)
