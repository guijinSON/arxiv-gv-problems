-def _ap_square_sum(n: int, first: int, step: int) -> int:
-    """Closed identity used by construction, not a scan of the instance."""
-    return (
-        n * first * first
-        + first * step * n * (n - 1)
-        + step * step * n * (n - 1) * (2 * n - 1) // 6
-    )
