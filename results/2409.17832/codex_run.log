+import hashlib
+import json
+import math
+import os
+import random
+import re
+import time
+
+
+TRACK: str = "B"
+
+PROBLEM_PROFILE: dict = {
+    "native_domain": "combinatorics",
+    "object_regime": "finite_discrete",
+    "computational_core": "linear_algebra",
+    "certificate_form": "rational",
+    "native_objects": [
