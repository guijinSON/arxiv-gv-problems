+    report["G6_adversary_panel"] = {
+        "pass": all_failed and len(attacks) >= 4,
+        "attacks": attacks,
+        "reference_algorithm": costs["reference_algorithm"],
+    }
+
+    doubled_params = dict(DIFFICULTY[SHIPPING_DIFFICULTY])
+    doubled_params["n"] *= 2
+    doubled_params["weight_bits"] += 1
