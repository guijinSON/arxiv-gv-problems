+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 6, "weight_bits": 5},
+    "easy": {"n": 48, "weight_bits": 12},
+    "medium": {"n": 96, "weight_bits": 18},
+    "hard": {"n": 150, "weight_bits": 24},
+}
+SHIPPING_DIFFICULTY: str = "hard"
