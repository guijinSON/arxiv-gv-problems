+            if not verify(inst, inst["answer"])[0]:
+                raise AssertionError(f"G1 failed for {preset=} {seed=}")
+            if json.loads(json.dumps(inst["answer"])) != inst["answer"]:
+                raise AssertionError("answer is not JSON-native")
+            json_roundtrips += 1
