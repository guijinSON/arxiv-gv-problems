-    forward_count = rng.randint(2, n - 2)
-    labels = list(range(1, n + 1))
-    rng.shuffle(labels)
-    edges = []
-    for i, weight in enumerate(weights):
-        left = labels[i]
-        right = labels[(i + 1) % n]
