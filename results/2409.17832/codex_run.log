\Delta_{C(3,2)}(t) =& (t-1)^5 + ( a_1^2 + a_2^2 + a_3^2 + a_4^2 + a_5^2) t (t-1)^3 \\ 
& + (a_1^2a_3^2 + a_1^2a_4^2 + a_2^2a_4^2 + a_2^2a_5^2 + a_3^2a_5^2 - a_1a_2a_3a_4a_5)  t^2(t - 1).
