+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 6, "weight_bits": 5},
+    "easy": {"n": 472, "weight_bits": 40},
+    "medium": {"n": 629, "weight_bits": 44},
+    "hard": {"n": 838, "weight_bits": 48},
+}
+SHIPPING_DIFFICULTY: str = "medium"
+
