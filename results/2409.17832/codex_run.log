+    }
+
+    invariant_checks = 0
+    witness_checks = 0
+    distinct_keys = set()
+    for seed in range(20):
+        inst = make_instance(seed=20000 + seed, **DIFFICULTY[SHIPPING_DIFFICULTY])
+        key = canonical_key(inst)
+        distinct_keys.add(key)
