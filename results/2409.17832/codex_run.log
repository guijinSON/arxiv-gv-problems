+    guess_total = 200_000
+    guess_hits = 0
+    guess_rng = random.Random(0x240917832)
+    expected = _expected_markov(ship)
+    for _ in range(guess_total):
+        if random_candidate(ship, guess_rng)[0] == expected:
+            guess_hits += 1
