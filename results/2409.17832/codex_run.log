+    ship = make_instance(seed=20240917, **DIFFICULTY[SHIPPING_DIFFICULTY])
+    planted = ship["answer"]
+    corruptions = {
+        "drop_one": planted[:1],
+        "swap": list(reversed(planted)),
+        "duplicate": planted + planted[:1],
+        "empty": [],
+        "out_of_range": [planted[0], 0],
+    }
