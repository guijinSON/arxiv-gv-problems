    return rng.choice(choices)


def _inverse_circulant(n: int, shift: int) -> list[list[int]]:
    """Return (I + 3 P_shift)^-1 over GF(257) by a geometric identity."""
    minus_c = (-_C) % _P
    denominator = (1 - pow(minus_c, n, _P)) % _P
