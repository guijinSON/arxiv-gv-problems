+        "hits": guess_hits,
+        "total": guess_total,
+        "observed_probability": guess_hits / guess_total,
+        "search_space": space,
+        "exact_unique_answer_density": theoretical_density,
+        "sampling_prior": "uniform over every reduced [p,1] allowed by the statement",
