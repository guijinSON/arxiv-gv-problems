+        "ladder_n_and_modulus_bits": named_difficulty,
+        "doubled_n": doubled_params["n"],
+        "doubled_build_seconds": doubled_build_seconds,
+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    g8_failures = []
