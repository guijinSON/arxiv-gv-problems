+        "parsed": parsed == inst["answer"],
+        "garbage_returns_none": parse_answer("not an answer") is None,
+    }
+
+    guess_rng = random.Random(0x250610717)
+    sample_total = 200_000
+    sample_hits = 0
+    start_time = time.perf_counter()
