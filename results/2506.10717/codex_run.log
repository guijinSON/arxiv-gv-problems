+        "doubled_verify_reason": doubled_reason,
+    }
+
+    invariance_checks = 0
+    carried_checks = 0
+    g8_failures = []
+    unrelated_keys = []
+    for seed in range(20):
+        base = make_instance(seed=10_000 + seed, **shipping_params)
+        key = canonical_key(base)
