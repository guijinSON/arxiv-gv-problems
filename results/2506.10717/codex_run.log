+def _cantor_code(value: int, digits: int = 7) -> int:
+    """Encode bits as base-three 0/1 digits (a 3-AP-free integer set)."""
+
+    result = 0
+    power = 1
+    for bit in range(digits):
+        if (value >> bit) & 1:
+            result += power
+        power *= 3
+    return result
+
