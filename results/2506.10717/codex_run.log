+# Filled from harness-owned transcripts after the three oracle runs.
+G9_RESULTS = {
+    "arms": {
+        "bare": {"solved": 0, "attempts": 3},
+        "hinted": {"solved": 0, "attempts": 3},
+        "placebo": {"solved": 1, "attempts": 3},
