+        "k": 1,
+        "regions": inst["n"],
+        "capacity": inst["capacity"],
+        "item_sizes": sorted(inst["item_sizes"]),
+        "first_spokes": inst["graph"]["u1_spokes_per_marker"],
+        "second_spokes": inst["graph"]["u2_spokes_per_marker"],
+    }
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
