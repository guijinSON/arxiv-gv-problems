+    demo = make_instance(seed=11, **DIFFICULTY["demo"])
+    demo_count = enumerate_all(demo)
+    report["G5_density_and_baseline_cost"] = {
+        "pass": guess_fraction < 1e-6
+        and demo_count is not None
+        and reference_successes == len(attack_seeds),
