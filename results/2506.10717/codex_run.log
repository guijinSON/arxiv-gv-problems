+            "by_hand_balanced_rank_zip": _balanced_rank_candidate(trial),
+        }
+        for name, candidate in candidates.items():
+            successes[name] += int(verify(trial, candidate)[0])
+        restart_rng = random.Random(seed ^ 0xA55A5AA5)
+        restart_won = False
+        for _ in range(256):
