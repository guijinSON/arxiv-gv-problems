+}
+SHIPPING_DIFFICULTY: str = "hard"
+
+CERTIFICATE_LANGUAGE: dict = {
+    "description": (
+        "An unordered partition of all 3n zero-based item-path IDs into exactly "
+        "n unordered triples.  It is written as a JSON list of three-integer lists."
+    ),
