+            invariance_checks += 1
+            if canonical_key(moved) != key:
+                g8_failures.append(f"seed {seed}, transform {index}: key changed")
+            ok, reason = verify(moved, moved["answer"])
+            carried_checks += 1
+            if not ok:
+                g8_failures.append(f"seed {seed}, transform {index}: {reason}")
