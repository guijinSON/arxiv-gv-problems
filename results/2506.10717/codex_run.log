+    ],
+    "domain_essentiality": "licensed_reduction",
+    "reduction_kind": "paper_licensed",
+    "reduction": (
+        "Section 3.2, Theorem 9: a Unary Bin Packing partition is equivalent "
+        "to a canonical 1-planar region layout of the constructed graph"
+    ),
