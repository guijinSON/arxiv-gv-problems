+except ImportError:  # pragma: no cover - no helper is required by this family
+    exact_matrices = rationals = None
+
+
+TRACK: str = "B"
+
+MODULUS = 10009
+
+STRUCTURAL_HINT: str = (
+    "The item-path lengths carry a repeated-residue symmetry under one common "
+    "modulus."
+)
+PLACEBO_HINT: str = (
