+    median_pair_probes = int(statistics.median(reference_pair_probes))
+    report["G6_adversary_panel"] = {
+        "pass": all(entry["successes"] == 0 for entry in attacks.values())
+        and reference_successes == len(attack_seeds),
+        "attacks": attacks,
+        "reference_algorithm": {
