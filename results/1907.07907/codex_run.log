import itertools, math, random, time, statistics

def edge(a,b): return (a,b) if a<b else (b,a)

def prufer_tree(vertices, seq, counter):
    degree={v:1 for v in vertices}
    for v in seq: degree[v]+=1; counter[0]+=1
    out=set()
    for x in seq:
        leaf=min(v for v in vertices if degree[v]==1)
        out.add(edge(leaf,x)); counter[0]+=1
        degree[leaf]-=1; degree[x]-=1
    left=[v for v in vertices if degree[v]==1]
    out.add(edge(*left)); counter[0]+=1
    return out

def parity_trees(vertices, odd, counter):
    vertices=tuple(sorted(vertices)); odd=set(odd)
    base=[v for v in vertices if v not in odd]
    pairs=(len(odd)-2)//2
    seq0=base + ([min(vertices)]*(2*pairs))
    seqs=[]
    def add(s):
        s=tuple(s)
        if s not in seqs: seqs.append(s)
    add(seq0); add(list(reversed(seq0)))
    for sh in range(1,len(seq0)+1): add(seq0[sh:]+seq0[:sh])
    for a in vertices:
        add(base+[a]*(2*pairs))
    # Deterministic adjacent swaps ensure alternatives even for repeated-heavy lists.
    for i in range(max(0,len(seq0)-1)):
        s=list(seq0); s[i],s[i+1]=s[i+1],s[i]; add(s)
    seen=[]
    for s in seqs:
        t=prufer_tree(vertices,s,counter)
        if t not in seen:
            seen.append(t); yield t

def boundary_triangles(F, counter=None):
    z=set()
    for tri in F:
        a,b,c=tri
        for e in ((a,b),(a,c),(b,c)):
            if e in z: z.remove(e)
            else: z.add(e)
            if counter is not None: counter[0]+=1
    return z

def planted(n,seed):
    rng=random.Random(seed); F=set()
