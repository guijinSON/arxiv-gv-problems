+                    at0 += 1
+                if second_kind:
+                    second = f1[at1]
+                    at1 += 1
+                else:
+                    second = f0[at0]
+                    at0 += 1
+                edge = tuple(sorted((p, first, second)))
+                if first == second or edge in seen_edges:
+                    good = False
+                    break
+                seen_edges.add(edge)
+                trial_edges.append(edge)
