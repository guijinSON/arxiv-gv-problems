+def canonical_key(inst):
+    """Switching-invariant WL fingerprint of the formula's incidence graph.
+
+    Each variable is an unlabeled edge joining its two literal nodes.  A clause
+    node (colored only by arity) joins the literal nodes it contains.  Thus input
+    order, variable names, and swapping either truth name are absent from the key.
+    """
+    n = inst["n"]
+    clauses = inst["clauses"]
+    total = 2 * n + len(clauses)
+    adjacency = [set() for _ in range(total)]
+    labels = ["L"] * (2 * n)
+    for var in range(n):
+        adjacency[2 * var].add(2 * var + 1)
+        adjacency[2 * var + 1].add(2 * var)
+    for ci, clause in enumerate(clauses):
+        node = 2 * n + ci
+        labels.append("C" + str(len(clause)))
+        for lit in clause:
+            literal_node = 2 * (abs(lit) - 1) + (0 if lit > 0 else 1)
+            adjacency[node].add(literal_node)
+            adjacency[literal_node].add(node)
