+                + [(p, 0, 1) for p in p0[p0_with_11:]]
+                + [(p, 0, 0) for p in p1[:p1_with_00]]
+                + [(p, 0, 1) for p in p1[p1_with_00:]]
+            )
+            rng.shuffle(requirements)
