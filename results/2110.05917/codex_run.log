+
+DIFFICULTY = {
+    "easy": {"n": 36, "density": 4.2, "aux_fraction": 0.14},
+    "medium": {"n": 64, "density": 4.3, "aux_fraction": 0.14},
+    "hard": {"n": 96, "density": 4.4, "aux_fraction": 0.14},
+    "extreme": {"n": 144, "density": 4.5, "aux_fraction": 0.14},
