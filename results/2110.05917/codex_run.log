+"""Verified generator for Non-Monotone 2-3Sat from arXiv:2110.05917.
+
+The public interface is intentionally standard-library-only and deterministic for
+``(n, seed, **params)``.  The hidden assignment is sampled before any clause.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import random
+import re
+from collections import Counter
+
+
+DIFFICULTY = {
+    "easy": {"n": 36, "density": 4.2, "aux_fraction": 0.14},
+    "medium": {"n": 64, "density": 4.3, "aux_fraction": 0.14},
+    "hard": {"n": 96, "density": 4.4, "aux_fraction": 0.14},
+    "extreme": {"n": 144, "density": 4.5, "aux_fraction": 0.14},
+}
+SHIPPING_DIFFICULTY = "extreme"
+
+
+NOTES = r"""
+Section 3 of Lu and Wu, arXiv:2110.05917v4, fixes the exact source problem:
+clauses have two or three distinct variables, and every three-variable clause
+contains both a positive and a negative literal.  Theorem 3.1 states that this
+Non-Monotone 2-3Sat problem is NP-complete.  This module uses that source problem
+rather than Theorem 3.2's separator target: the displayed RCTSVS definition has no
+separator-cardinality budget, but its proof silently requires |S|=n+2m+p.
+
+The syntactic restriction has a major easy corner.  If every clause has size
+three, both constant assignments satisfy every mixed-sign clause; if every clause
+has size two, the instance is ordinary 2-SAT and is polynomial-time solvable.
+Here a balanced planted 3-SAT core is converted into a growing mixture of
+mixed-sign 3-clauses and unrestricted 2-clauses.  The planted bit of each base
+variable has, in expectation, exactly the same positive/negative occurrence
+frequency as its complement.  Auxiliary variables are reused, have balanced
+polarity, and have degrees comparable to base variables.
+
+The adversary panel checks (1) a per-variable occurrence outlier guess, (2) a
+left-to-right greedy repair, and (3) bounded randomized WalkSAT restarts.  Clause
+and literal order and variable names are shuffled.  The canonical key is a
+switching-invariant Weisfeiler-Lehman fingerprint of the literal-pair/clause
+incidence graph; it is invariant under variable renaming, independent truth-value
+renaming, and input reordering, though as a polynomial fingerprint it is not a
+complete graph-isomorphism canonical form.
+""".strip()
+
+
+def _clause_key(clause):
+    return tuple(sorted(clause, key=lambda x: (abs(x), x)))
+
+
+def _lit_value(lit, bits):
+    value = bits[abs(lit) - 1]
+    return value if lit > 0 else not value
+
+
+def _answer_from_bits(bits):
+    return [i + 1 if bit else -(i + 1) for i, bit in enumerate(bits)]
+
+
+def _bits_from_answer(answer, n):
+    return [answer[i] > 0 for i in range(n)]
+
+
+def make_instance(n, seed=0, density=4.4, aux_fraction=0.14):
+    """Sample a full assignment first, then manufacture clauses it satisfies.
+
+    ``n`` is the final number of Boolean variables.  Increasing it at fixed
+    density grows both the witness space (2**n) and the constraint system.
+    """
+    if not isinstance(n, int) or isinstance(n, bool) or n < 12:
+        raise ValueError("n must be an integer at least 12")
+    if not isinstance(density, (int, float)) or not 2.0 <= density <= 8.0:
+        raise ValueError("density must be between 2.0 and 8.0")
+    if not isinstance(aux_fraction, (int, float)) or not 0.08 <= aux_fraction <= 0.30:
+        raise ValueError("aux_fraction must be between 0.08 and 0.30")
+
+    rng = random.Random(seed)
+    aux_n = max(2, int(round(n * float(aux_fraction))))
+    aux_n = min(aux_n, n - 8)
+    base_n = n - aux_n
+
+    # G: the complete answer is chosen before the first clause is constructed.
+    base_bits = [bool(rng.getrandbits(1)) for _ in range(base_n)]
+    aux_bits = [False] * (aux_n // 2) + [True] * (aux_n - aux_n // 2)
+    rng.shuffle(aux_bits)
+    planted_bits = base_bits + aux_bits
+
+    target = max(1, int(round(float(density) * base_n)))
+    final_clauses = []
+    final_seen = set()
+    base_seen = set()
+    aux_load = [0] * aux_n
+
+    # True-literal counts 1,2,3 have weights 6,3,1.  Their mean is exactly
+    # 1.5, so the planted polarity has no first-order occurrence advantage.
+    made = 0
+    attempts = 0
+    while made < target:
+        attempts += 1
+        if attempts > target * 1000:
+            raise RuntimeError("could not construct enough distinct clauses")
+        variables = rng.sample(range(base_n), 3)
+        roll = rng.randrange(10)
+        true_count = 1 if roll < 6 else (2 if roll < 9 else 3)
+        true_positions = set(rng.sample(range(3), true_count))
+        clause = []
+        for pos, var in enumerate(variables):
+            wanted = pos in true_positions
+            positive = base_bits[var] == wanted
+            clause.append(var + 1 if positive else -(var + 1))
+        base_key = _clause_key(clause)
+        if base_key in base_seen:
+            continue
+
+        if len({lit > 0 for lit in clause}) == 2:
+            key = _clause_key(clause)
+            if key in final_seen:
+                continue
+            additions = [list(clause)]
+            chosen_aux = None
+        else:
+            # Replace a monotone (a or b or c) by
+            # (a or b or q) and ((not q) or c), reusing balanced auxiliaries.
+            # Under the plant q has c's truth value, so both new clauses hold.
+            orderings = [list(clause)]
+            orderings.extend([clause[1:] + clause[:1], clause[2:] + clause[:2]])
+            rng.shuffle(orderings)
+            choice = None
+            for ordered in orderings:
+                a, b, c = ordered
+                q_positive = a < 0  # q has the opposite written sign from a,b.
+                c_value = _lit_value(c, planted_bits)
+                needed_aux_bit = c_value if q_positive else not c_value
+                candidates = [j for j, bit in enumerate(aux_bits) if bit == needed_aux_bit]
+                candidates.sort(key=lambda j: (aux_load[j], j))
+                if candidates:
+                    least = aux_load[candidates[0]]
+                    tied = [j for j in candidates if aux_load[j] == least]
+                    rng.shuffle(tied)
+                    candidates = tied + [j for j in candidates if aux_load[j] != least]
+                for aux in candidates:
+                    var_id = base_n + aux + 1
+                    q = var_id if q_positive else -var_id
+                    c3 = [a, b, q]
+                    c2 = [-q, c]
+                    keys = (_clause_key(c3), _clause_key(c2))
+                    if keys[0] not in final_seen and keys[1] not in final_seen:
+                        choice = (c3, c2, aux, keys)
+                        break
+                if choice is not None:
+                    break
+            if choice is None:
+                continue
+            c3, c2, chosen_aux, keys = choice
+            additions = [c3, c2]
+
+        base_seen.add(base_key)
+        for addition in additions:
+            final_clauses.append(addition)
+            final_seen.add(_clause_key(addition))
+        if chosen_aux is not None:
+            aux_load[chosen_aux] += 1
+        made += 1
+
+    # Hide construction order and the base/auxiliary numeric ranges.
+    new_ids = list(range(1, n + 1))
+    rng.shuffle(new_ids)
+    old_to_new = {old + 1: new_ids[old] for old in range(n)}
+    clauses = []
+    for clause in final_clauses:
+        mapped = [(1 if lit > 0 else -1) * old_to_new[abs(lit)] for lit in clause]
+        rng.shuffle(mapped)
+        clauses.append(mapped)
+    rng.shuffle(clauses)
+
+    final_bits = [False] * n
+    for old, bit in enumerate(planted_bits, 1):
+        final_bits[old_to_new[old] - 1] = bit
+    answer = _answer_from_bits(final_bits)
+
+    inst = {
+        "family": "Non-Monotone 2-3Sat",
+        "n": n,
+        "clauses": clauses,
+        "answer": answer,
+        "density": float(density),
+        "aux_fraction": float(aux_fraction),
+    }
+    ok, reason = verify(inst, answer)
+    if not ok:  # This is an internal invariant, never a satisfiability search.
+        raise AssertionError("generator produced a bad plant: " + reason)
+    return inst
+
+
+def render(inst):
+    """Return the complete, standalone problem statement."""
+    n = inst["n"]
+    lines = [
+        "Non-Monotone 2-3Sat witness problem",
+        "",
+        f"There are {n} Boolean variables, numbered 1 through {n} (1-indexed).",
+        "A positive literal +i is true exactly when variable i is true; a negative",
+        "literal -i is true exactly when variable i is false. A clause is an OR:",
+        "it is satisfied when at least one listed literal is true. Satisfy every",
+        "clause simultaneously. Each line below is one clause; literal order and",
+        "clause order have no meaning. Variables within a clause are distinct.",
+        "Every clause has two or three literals, and every three-literal clause",
+        "contains at least one positive and at least one negative literal.",
+        "",
+        f"Clauses ({len(inst['clauses'])}):",
+    ]
+    for i, clause in enumerate(inst["clauses"], 1):
+        lines.append(f"C{i}: " + " ".join(f"{lit:+d}" for lit in clause))
+    lines.extend(
+        [
+            "",
+            f"Output exactly {n} comma-separated signed integers in variable order.",
+            "At position i write +i to set variable i true or -i to set it false.",
+            "Every variable must occur exactly once; repetitions are forbidden.",
+            "Order inside the answer therefore matters and is fixed as 1,2,...,n.",
+            "",
+            "Give your final answer inside <answer></answer> tags, as signed integers.",
+            "Example: <answer>1, -2, 3</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    return "\n".join(lines)
+
+
+_ANSWER_BLOCK = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def parse_answer(text):
+    """Extract the last well-formed tagged integer list, or return None."""
+    if not isinstance(text, str):
+        return None
+    blocks = _ANSWER_BLOCK.findall(text)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    if not body or not re.fullmatch(r"[+\-]?\d+(?:\s*(?:,|\s)\s*[+\-]?\d+)*", body):
+        return None
+    try:
+        return [int(token) for token in re.findall(r"[+\-]?\d+", body)]
+    except (TypeError, ValueError, OverflowError):
+        return None
+
+
+def verify(inst, answer):
+    """Accept any satisfying assignment in the required witness encoding."""
+    n = inst.get("n")
+    if not isinstance(answer, (list, tuple)):
+        return False, "answer must be a list of signed integers"
+    if len(answer) == 0:
+        return False, "empty answer"
+    if len(answer) != n:
+        return False, f"wrong length: expected {n}, got {len(answer)}"
+    if any(not isinstance(x, int) or isinstance(x, bool) for x in answer):
+        return False, "every entry must be an integer"
+    if any(x == 0 or abs(x) > n for x in answer):
+        return False, f"literal out of range: expected absolute values 1 through {n}"
+    absolute = [abs(x) for x in answer]
+    if len(set(absolute)) != n:
+        return False, "duplicate variable"
+    if absolute != list(range(1, n + 1)):
+        return False, "literals must appear in variable order"
+
+    bits = _bits_from_answer(answer, n)
+    for index, clause in enumerate(inst.get("clauses", ()), 1):
+        if not any(_lit_value(lit, bits) for lit in clause):
+            return False, f"clause {index} is unsatisfied"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the actual structural search space: one sign per variable."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    return [i if rng.getrandbits(1) else -i for i in range(1, inst["n"] + 1)]
+
+
+def search_space(inst):
+    """There are exactly two sign choices for each of n ordered variables."""
+    return 1 << inst["n"]
+
+
+def enumerate_all(inst):
+    """Count satisfying assignments exactly for n <= 22; cap larger work."""
+    n = inst["n"]
+    if n > 22:
+        return None
+    encoded = []
+    for clause in inst["clauses"]:
+        positive = 0
+        negative = 0
+        for lit in clause:
+            if lit > 0:
+                positive |= 1 << (lit - 1)
+            else:
+                negative |= 1 << (-lit - 1)
+        encoded.append((positive, negative))
+    full = (1 << n) - 1
+    count = 0
+    for assignment in range(1 << n):
+        false_bits = full ^ assignment
+        if all((assignment & pos) or (false_bits & neg) for pos, neg in encoded):
+            count += 1
+    return count
+
+
+def canonical_key(inst):
+    """Switching-invariant WL fingerprint of the formula's incidence graph.
+
+    Each variable is an unlabeled edge joining its two literal nodes.  A clause
+    node (colored only by arity) joins the literal nodes it contains.  Thus input
+    order, variable names, and swapping either truth name are absent from the key.
+    """
+    n = inst["n"]
+    clauses = inst["clauses"]
+    total = 2 * n + len(clauses)
+    adjacency = [set() for _ in range(total)]
+    labels = ["L"] * (2 * n)
+    for var in range(n):
+        adjacency[2 * var].add(2 * var + 1)
+        adjacency[2 * var + 1].add(2 * var)
+    for ci, clause in enumerate(clauses):
+        node = 2 * n + ci
+        labels.append("C" + str(len(clause)))
+        for lit in clause:
+            literal_node = 2 * (abs(lit) - 1) + (0 if lit > 0 else 1)
+            adjacency[node].add(literal_node)
+            adjacency[literal_node].add(node)
+
+    # A fixed number of rounds is deterministic and avoids label-name oscillation.
+    for _ in range(12):
+        next_labels = []
+        for node in range(total):
+            signature = labels[node] + "|" + "|".join(
+                sorted(labels[other] for other in adjacency[node])
+            )
+            next_labels.append(hashlib.sha256(signature.encode()).hexdigest())
+        labels = next_labels
+
+    node_profile = sorted((labels[v], len(adjacency[v])) for v in range(total))
+    edge_profile = []
+    for left in range(total):
+        for right in adjacency[left]:
+            if left < right:
+                edge_profile.append(tuple(sorted((labels[left], labels[right]))))
+    material = json.dumps(
+        {"nodes": node_profile, "edges": sorted(edge_profile)},
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(material.encode()).hexdigest()
+
+
+def escalate(params):
+    """Increase the exponential dimension while keeping the planted regime stable."""
+    if not isinstance(params, dict) or "n" not in params:
+        return None
+    n = int(params["n"])
+    if n >= 512:
+        return None
+    harder = dict(params)
+    harder["n"] = max(n + 1, int(round(n * 1.5)))
+    harder["density"] = min(5.0, float(params.get("density", 4.4)) + 0.1)
+    return harder
+
+
+def _occurrence_attack(inst):
+    counts = [[0, 0] for _ in range(inst["n"])]  # negative, positive
+    for clause in inst["clauses"]:
+        for lit in clause:
+            counts[abs(lit) - 1][1 if lit > 0 else 0] += 1
+    bits = [positive > negative for negative, positive in counts]
+    return _answer_from_bits(bits)
+
+
+def _greedy_attack(inst):
+    n = inst["n"]
+    bits = [False] * n
+    frequency = Counter(abs(lit) for clause in inst["clauses"] for lit in clause)
+    for clause in inst["clauses"]:
+        if not any(_lit_value(lit, bits) for lit in clause):
+            lit = min(clause, key=lambda x: (frequency[abs(x)], abs(x)))
+            bits[abs(lit) - 1] = lit > 0
+    return _answer_from_bits(bits)
+
+
+def _random_restart_attack(inst, rng, restarts=4, flips_per_variable=8):
+    n = inst["n"]
+    clauses = inst["clauses"]
+    last = [False] * n
+    for _ in range(restarts):
+        bits = [bool(rng.getrandbits(1)) for _ in range(n)]
+        for _step in range(flips_per_variable * n):
+            unsatisfied = [
+                clause for clause in clauses
+                if not any(_lit_value(lit, bits) for lit in clause)
+            ]
+            if not unsatisfied:
+                return _answer_from_bits(bits)
+            clause = rng.choice(unsatisfied)
+            if rng.random() < 0.25:
+                chosen = rng.choice(clause)
+            else:
+                scored = []
+                for lit in clause:
+                    var = abs(lit) - 1
+                    bits[var] = not bits[var]
+                    remaining = sum(
+                        not any(_lit_value(x, bits) for x in c) for c in clauses
+                    )
+                    bits[var] = not bits[var]
+                    scored.append((remaining, rng.random(), lit))
+                chosen = min(scored)[2]
+            var = abs(chosen) - 1
+            bits[var] = not bits[var]
+        last = bits
+    return _answer_from_bits(last)
+
+
+def _transformed_instance(inst, seed, permute=False, global_flip=False, reorder=False):
+    rng = random.Random(seed)
+    n = inst["n"]
+    destinations = list(range(1, n + 1))
+    if permute:
+        rng.shuffle(destinations)
+    mapping = {old: destinations[old - 1] for old in range(1, n + 1)}
+
+    clauses = []
+    for clause in inst["clauses"]:
+        mapped = []
+        for lit in clause:
+            sign = 1 if lit > 0 else -1
+            if global_flip:
+                sign = -sign
+            mapped.append(sign * mapping[abs(lit)])
+        if reorder:
+            rng.shuffle(mapped)
+        clauses.append(mapped)
+    if reorder:
+        rng.shuffle(clauses)
+
+    old_bits = _bits_from_answer(inst["answer"], n)
+    new_bits = [False] * n
+    for old, bit in enumerate(old_bits, 1):
+        new_bits[mapping[old] - 1] = (not bit) if global_flip else bit
+    return {
+        "family": inst["family"],
+        "n": n,
+        "clauses": clauses,
+        "answer": _answer_from_bits(new_bits),
+        "density": inst.get("density"),
+        "aux_fraction": inst.get("aux_fraction"),
+    }
+
+
+def selftest():
+    """Run mandatory G1--G8 gates and return their machine-readable report."""
+    report = {"family": "Non-Monotone 2-3Sat", "shipping_difficulty": SHIPPING_DIFFICULTY}
+
+    # G1: every named preset, several independent seeds.
+    g1_total = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17, 99):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_total += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": reason})
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "checked": g1_total,
+        "failures": g1_failures,
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=123456, **shipping)
+    planted = list(inst["answer"])
+
+    # G2: five structurally different corruptions and five distinct diagnostics.
+    duplicate = list(planted)
+    duplicate[1] = (1 if planted[0] > 0 else -1) * 1
+    swapped = list(planted)
+    swapped[0], swapped[-1] = swapped[-1], swapped[0]
+    out_of_range = list(planted)
+    out_of_range[-1] = inst["n"] + 1
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_two": swapped,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    reasons = {}
+    g2_ok = True
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        g2_ok = g2_ok and not ok
+        reasons[name] = reason
+    g2_ok = g2_ok and len(set(reasons.values())) == len(reasons)
+    report["G2_rejects_corruption"] = {
+        "pass": g2_ok,
+        "rejected": sum(verify(inst, value)[0] is False for value in corruptions.values()),
+        "distinct_reasons": len(set(reasons.values())),
+        "reasons": reasons,
+    }
+
+    # G3: realistic surrounding prose and a Markdown fence.
+    response = (
+        "I checked each clause. My final assignment is:\n```text\n<answer>"
+        + ", ".join(str(x) for x in planted)
+        + "</answer>\n```\nThat is the requested witness."
+    )
+    parsed = parse_answer(response)
+    report["G3_round_trip"] = {
+        "pass": parsed == planted,
+        "parsed_length": len(parsed) if parsed is not None else None,
+    }
+
+    # G4: uniform over all structurally valid signed assignments, not junk lists.
+    guess_rng = random.Random(20260902)
+    total = 200_000
+    hits = 0
+    for _ in range(total):
+        candidate = random_candidate(inst, guess_rng)
+        if verify(inst, candidate)[0]:
+            hits += 1
+    report["G4_guess_resistance"] = {
+        "pass": hits / total < 1e-6,
+        "hits": hits,
+        "total": total,
+        "rate": hits / total,
+        "sampler": "uniform over the 2^n ordered one-sign-per-variable witnesses",
+    }
+
+    # G5: exact enumeration on a capped micro-instance.
+    tiny = make_instance(n=18, seed=314159, density=4.5, aux_fraction=0.14)
+    solutions = enumerate_all(tiny)
+    space = search_space(tiny)
+    fraction = solutions / space
+    report["G5_sparse"] = {
+        "pass": solutions is not None and fraction < 0.01,
+        "n": tiny["n"],
+        "solutions": solutions,
+        "search_space": space,
+        "fraction": fraction,
+    }
+
+    # G6: attacks know the construction but never read inst['answer'].
+    attack_rows = {
+        "occurrence_outlier": [],
+        "left_to_right_greedy": [],
+        "random_restart_walksat": [],
+    }
+    for seed in range(800, 808):
+        attacked = make_instance(seed=seed, **shipping)
+        candidates = {
+            "occurrence_outlier": _occurrence_attack(attacked),
+            "left_to_right_greedy": _greedy_attack(attacked),
+            "random_restart_walksat": _random_restart_attack(
+                attacked, random.Random(seed ^ 0x5A17)
+            ),
+        }
+        for name, candidate in candidates.items():
+            ok, reason = verify(attacked, candidate)
+            attack_rows[name].append({"seed": seed, "solved": ok, "reason": reason})
+    attack_summary = {
+        name: {
+            "successes": sum(row["solved"] for row in rows),
+            "trials": len(rows),
+            "rows": rows,
+        }
+        for name, rows in attack_rows.items()
+    }
+    report["G6_adversary_panel"] = {
+        "pass": all(item["successes"] == 0 and item["trials"] >= 8 for item in attack_summary.values()),
+        "attacks": attack_summary,
+    }
+
+    # G7: n doubles without leaving the planted satisfiable regime.
+    doubled_params = dict(shipping)
+    doubled_params["n"] *= 2
+    doubled = make_instance(seed=271828, **doubled_params)
+    doubled_ok, doubled_reason = verify(doubled, doubled["answer"])
+    report["G7_scales"] = {
+        "pass": doubled_ok and doubled["n"] == 2 * inst["n"] and len(doubled["clauses"]) > len(inst["clauses"]),
+        "base_n": inst["n"],
+        "base_clauses": len(inst["clauses"]),
+        "doubled_n": doubled["n"],
+        "doubled_clauses": len(doubled["clauses"]),
+        "verify_reason": doubled_reason,
+    }
+
+    # G8: reorder, rename variables, globally swap truth names, and compose them.
+    invariance_checks = 0
+    carried_witness_checks = 0
+    g8_failures = []
+    unrelated_keys = []
+    key_params = DIFFICULTY["easy"]
+    for seed in range(20):
+        original = make_instance(seed=10_000 + seed, **key_params)
+        key = canonical_key(original)
+        unrelated_keys.append(key)
+        variants = [
+            _transformed_instance(original, seed + 1, reorder=True),
+            _transformed_instance(original, seed + 2, permute=True),
+            _transformed_instance(original, seed + 3, global_flip=True),
+            _transformed_instance(
+                original, seed + 4, permute=True, global_flip=True, reorder=True
+            ),
+        ]
+        for variant in variants:
+            invariance_checks += 1
+            if canonical_key(variant) != key:
+                g8_failures.append({"seed": seed, "kind": "key_changed"})
+            carried_ok, reason = verify(variant, variant["answer"])
+            carried_witness_checks += 1
+            if not carried_ok:
+                g8_failures.append({"seed": seed, "kind": "map_not_real", "reason": reason})
+    distinct = len(set(unrelated_keys))
+    report["G8_canonical_key"] = {
+        "pass": not g8_failures and distinct == 20,
+        "invariance_checks": invariance_checks,
+        "carried_witness_checks": carried_witness_checks,
+        "unrelated_distinct": distinct,
+        "unrelated_total": 20,
+        "failures": g8_failures,
+        "invariant_under": [
+            "clause and literal reordering",
+            "variable permutation",
+            "global truth-name swap",
+            "their composition",
+        ],
+    }
+
+    gates = [value for key, value in report.items() if key.startswith("G")]
+    report["all_passed"] = all(gate.get("pass") for gate in gates)
+    return report
+
+
+if __name__ == "__main__":
+    print(json.dumps(selftest(), indent=2, sort_keys=True))

diff --git a/gen_2110_05917.py b/gen_2110_05917.py
new file mode 100644
index 0000000000000000000000000000000000000000..c8fcd03234fe5308ff1b27ce265764c899025ce1
--- /dev/null
+++ b/gen_2110_05917.py
@@ -0,0 +1,650 @@
+"""Verified generator for Non-Monotone 2-3Sat from arXiv:2110.05917.
+
+The public interface is intentionally standard-library-only and deterministic for
+``(n, seed, **params)``.  The hidden assignment is sampled before any clause.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import random
+import re
+from collections import Counter
+
+
+DIFFICULTY = {
+    "easy": {"n": 36, "density": 4.2, "aux_fraction": 0.14},
+    "medium": {"n": 64, "density": 4.3, "aux_fraction": 0.14},
+    "hard": {"n": 96, "density": 4.4, "aux_fraction": 0.14},
+    "extreme": {"n": 144, "density": 4.5, "aux_fraction": 0.14},
+}
+SHIPPING_DIFFICULTY = "extreme"
+
+
+NOTES = r"""
+Section 3 of Lu and Wu, arXiv:2110.05917v4, fixes the exact source problem:
+clauses have two or three distinct variables, and every three-variable clause
+contains both a positive and a negative literal.  Theorem 3.1 states that this
+Non-Monotone 2-3Sat problem is NP-complete.  This module uses that source problem
+rather than Theorem 3.2's separator target: the displayed RCTSVS definition has no
+separator-cardinality budget, but its proof silently requires |S|=n+2m+p.
+
+The syntactic restriction has a major easy corner.  If every clause has size
+three, both constant assignments satisfy every mixed-sign clause; if every clause
+has size two, the instance is ordinary 2-SAT and is polynomial-time solvable.
+Here a balanced planted 3-SAT core is converted into a growing mixture of
+mixed-sign 3-clauses and unrestricted 2-clauses.  The planted bit of each base
+variable has, in expectation, exactly the same positive/negative occurrence
+frequency as its complement.  Auxiliary variables are reused, have balanced
+polarity, and have degrees comparable to base variables.
+
+The adversary panel checks (1) a per-variable occurrence outlier guess, (2) a
+left-to-right greedy repair, and (3) bounded randomized WalkSAT restarts.  Clause
+and literal order and variable names are shuffled.  The canonical key is a
+switching-invariant Weisfeiler-Lehman fingerprint of the literal-pair/clause
+incidence graph; it is invariant under variable renaming, independent truth-value
+renaming, and input reordering, though as a polynomial fingerprint it is not a
+complete graph-isomorphism canonical form.
+""".strip()
+
+
+def _clause_key(clause):
+    return tuple(sorted(clause, key=lambda x: (abs(x), x)))
+
+
+def _lit_value(lit, bits):
+    value = bits[abs(lit) - 1]
+    return value if lit > 0 else not value
+
+
+def _answer_from_bits(bits):
+    return [i + 1 if bit else -(i + 1) for i, bit in enumerate(bits)]
+
+
+def _bits_from_answer(answer, n):
+    return [answer[i] > 0 for i in range(n)]
+
+
+def make_instance(n, seed=0, density=4.4, aux_fraction=0.14):
+    """Sample a full assignment first, then manufacture clauses it satisfies.
+
+    ``n`` is the final number of Boolean variables.  Increasing it at fixed
+    density grows both the witness space (2**n) and the constraint system.
+    """
+    if not isinstance(n, int) or isinstance(n, bool) or n < 12:
+        raise ValueError("n must be an integer at least 12")
+    if not isinstance(density, (int, float)) or not 2.0 <= density <= 8.0:
+        raise ValueError("density must be between 2.0 and 8.0")
+    if not isinstance(aux_fraction, (int, float)) or not 0.08 <= aux_fraction <= 0.30:
+        raise ValueError("aux_fraction must be between 0.08 and 0.30")
+
+    rng = random.Random(seed)
+    aux_n = max(2, int(round(n * float(aux_fraction))))
+    aux_n = min(aux_n, n - 8)
+    base_n = n - aux_n
+
+    # G: the complete answer is chosen before the first clause is constructed.
+    base_bits = [bool(rng.getrandbits(1)) for _ in range(base_n)]
+    aux_bits = [False] * (aux_n // 2) + [True] * (aux_n - aux_n // 2)
+    rng.shuffle(aux_bits)
+    planted_bits = base_bits + aux_bits
+
+    target = max(1, int(round(float(density) * base_n)))
+    final_clauses = []
+    final_seen = set()
+    base_seen = set()
+    aux_load = [0] * aux_n
+
+    # True-literal counts 1,2,3 have weights 6,3,1.  Their mean is exactly
+    # 1.5, so the planted polarity has no first-order occurrence advantage.
+    made = 0
+    attempts = 0
+    while made < target:
+        attempts += 1
+        if attempts > target * 1000:
+            raise RuntimeError("could not construct enough distinct clauses")
+        variables = rng.sample(range(base_n), 3)
+        roll = rng.randrange(10)
+        true_count = 1 if roll < 6 else (2 if roll < 9 else 3)
+        true_positions = set(rng.sample(range(3), true_count))
+        clause = []
+        for pos, var in enumerate(variables):
+            wanted = pos in true_positions
+            positive = base_bits[var] == wanted
+            clause.append(var + 1 if positive else -(var + 1))
+        base_key = _clause_key(clause)
+        if base_key in base_seen:
+            continue
+
+        if len({lit > 0 for lit in clause}) == 2:
+            key = _clause_key(clause)
+            if key in final_seen:
+                continue
+            additions = [list(clause)]
+            chosen_aux = None
+        else:
+            # Replace a monotone (a or b or c) by
+            # (a or b or q) and ((not q) or c), reusing balanced auxiliaries.
+            # Under the plant q has c's truth value, so both new clauses hold.
+            orderings = [list(clause)]
+            orderings.extend([clause[1:] + clause[:1], clause[2:] + clause[:2]])
+            rng.shuffle(orderings)
+            choice = None
+            for ordered in orderings:
+                a, b, c = ordered
+                q_positive = a < 0  # q has the opposite written sign from a,b.
+                c_value = _lit_value(c, planted_bits)
+                needed_aux_bit = c_value if q_positive else not c_value
+                candidates = [j for j, bit in enumerate(aux_bits) if bit == needed_aux_bit]
+                candidates.sort(key=lambda j: (aux_load[j], j))
+                if candidates:
+                    least = aux_load[candidates[0]]
+                    tied = [j for j in candidates if aux_load[j] == least]
+                    rng.shuffle(tied)
+                    candidates = tied + [j for j in candidates if aux_load[j] != least]
+                for aux in candidates:
+                    var_id = base_n + aux + 1
+                    q = var_id if q_positive else -var_id
+                    c3 = [a, b, q]
+                    c2 = [-q, c]
+                    keys = (_clause_key(c3), _clause_key(c2))
+                    if keys[0] not in final_seen and keys[1] not in final_seen:
+                        choice = (c3, c2, aux, keys)
+                        break
+                if choice is not None:
+                    break
+            if choice is None:
+                continue
+            c3, c2, chosen_aux, keys = choice
+            additions = [c3, c2]
+
+        base_seen.add(base_key)
+        for addition in additions:
+            final_clauses.append(addition)
+            final_seen.add(_clause_key(addition))
+        if chosen_aux is not None:
+            aux_load[chosen_aux] += 1
+        made += 1
+
+    # Hide construction order and the base/auxiliary numeric ranges.
+    new_ids = list(range(1, n + 1))
+    rng.shuffle(new_ids)
+    old_to_new = {old + 1: new_ids[old] for old in range(n)}
+    clauses = []
+    for clause in final_clauses:
+        mapped = [(1 if lit > 0 else -1) * old_to_new[abs(lit)] for lit in clause]
+        rng.shuffle(mapped)
+        clauses.append(mapped)
+    rng.shuffle(clauses)
+
+    final_bits = [False] * n
+    for old, bit in enumerate(planted_bits, 1):
+        final_bits[old_to_new[old] - 1] = bit
+    answer = _answer_from_bits(final_bits)
+
+    inst = {
+        "family": "Non-Monotone 2-3Sat",
+        "n": n,
+        "clauses": clauses,
+        "answer": answer,
+        "density": float(density),
+        "aux_fraction": float(aux_fraction),
+    }
+    ok, reason = verify(inst, answer)
+    if not ok:  # This is an internal invariant, never a satisfiability search.
+        raise AssertionError("generator produced a bad plant: " + reason)
+    return inst
+
+
+def render(inst):
+    """Return the complete, standalone problem statement."""
+    n = inst["n"]
+    lines = [
+        "Non-Monotone 2-3Sat witness problem",
+        "",
+        f"There are {n} Boolean variables, numbered 1 through {n} (1-indexed).",
+        "A positive literal +i is true exactly when variable i is true; a negative",
+        "literal -i is true exactly when variable i is false. A clause is an OR:",
+        "it is satisfied when at least one listed literal is true. Satisfy every",
+        "clause simultaneously. Each line below is one clause; literal order and",
+        "clause order have no meaning. Variables within a clause are distinct.",
+        "Every clause has two or three literals, and every three-literal clause",
+        "contains at least one positive and at least one negative literal.",
+        "",
+        f"Clauses ({len(inst['clauses'])}):",
+    ]
+    for i, clause in enumerate(inst["clauses"], 1):
+        lines.append(f"C{i}: " + " ".join(f"{lit:+d}" for lit in clause))
+    lines.extend(
+        [
+            "",
+            f"Output exactly {n} comma-separated signed integers in variable order.",
+            "At position i write +i to set variable i true or -i to set it false.",
+            "Every variable must occur exactly once; repetitions are forbidden.",
+            "Order inside the answer therefore matters and is fixed as 1,2,...,n.",
+            "",
+            "Give your final answer inside <answer></answer> tags, as signed integers.",
+            "Example: <answer>1, -2, 3</answer>",
+            "Output nothing else inside the tags.",
+        ]
+    )
+    return "\n".join(lines)
+
+
+_ANSWER_BLOCK = re.compile(r"<answer\b[^>]*>(.*?)</answer\s*>", re.I | re.S)
+
+
+def parse_answer(text):
+    """Extract the last well-formed tagged integer list, or return None."""
+    if not isinstance(text, str):
+        return None
+    blocks = _ANSWER_BLOCK.findall(text)
+    if not blocks:
+        return None
+    body = blocks[-1].strip()
+    if not body or not re.fullmatch(r"[+\-]?\d+(?:\s*(?:,|\s)\s*[+\-]?\d+)*", body):
+        return None
+    try:
+        return [int(token) for token in re.findall(r"[+\-]?\d+", body)]
+    except (TypeError, ValueError, OverflowError):
+        return None
+
+
+def verify(inst, answer):
+    """Accept any satisfying assignment in the required witness encoding."""
+    n = inst.get("n")
+    if not isinstance(answer, (list, tuple)):
+        return False, "answer must be a list of signed integers"
+    if len(answer) == 0:
+        return False, "empty answer"
+    if len(answer) != n:
+        return False, f"wrong length: expected {n}, got {len(answer)}"
+    if any(not isinstance(x, int) or isinstance(x, bool) for x in answer):
+        return False, "every entry must be an integer"
+    if any(x == 0 or abs(x) > n for x in answer):
+        return False, f"literal out of range: expected absolute values 1 through {n}"
+    absolute = [abs(x) for x in answer]
+    if len(set(absolute)) != n:
+        return False, "duplicate variable"
+    if absolute != list(range(1, n + 1)):
+        return False, "literals must appear in variable order"
+
+    bits = _bits_from_answer(answer, n)
+    for index, clause in enumerate(inst.get("clauses", ()), 1):
+        if not any(_lit_value(lit, bits) for lit in clause):
+            return False, f"clause {index} is unsatisfied"
+    return True, "ok"
+
+
+def random_candidate(inst, rng):
+    """Uniformly sample the actual structural search space: one sign per variable."""
+    if not isinstance(rng, random.Random):
+        raise TypeError("rng must be an instance of random.Random")
+    return [i if rng.getrandbits(1) else -i for i in range(1, inst["n"] + 1)]
+
+
+def search_space(inst):
+    """There are exactly two sign choices for each of n ordered variables."""
+    return 1 << inst["n"]
+
+
+def enumerate_all(inst):
+    """Count satisfying assignments exactly for n <= 22; cap larger work."""
+    n = inst["n"]
+    if n > 22:
+        return None
+    encoded = []
+    for clause in inst["clauses"]:
+        positive = 0
+        negative = 0
+        for lit in clause:
+            if lit > 0:
+                positive |= 1 << (lit - 1)
+            else:
+                negative |= 1 << (-lit - 1)
+        encoded.append((positive, negative))
+    full = (1 << n) - 1
+    count = 0
+    for assignment in range(1 << n):
+        false_bits = full ^ assignment
+        if all((assignment & pos) or (false_bits & neg) for pos, neg in encoded):
+            count += 1
+    return count
+
+
+def canonical_key(inst):
+    """Switching-invariant WL fingerprint of the formula's incidence graph.
+
+    Each variable is an unlabeled edge joining its two literal nodes.  A clause
+    node (colored only by arity) joins the literal nodes it contains.  Thus input
+    order, variable names, and swapping either truth name are absent from the key.
+    """
+    n = inst["n"]
+    clauses = inst["clauses"]
+    total = 2 * n + len(clauses)
+    adjacency = [set() for _ in range(total)]
+    labels = ["L"] * (2 * n)
+    for var in range(n):
+        adjacency[2 * var].add(2 * var + 1)
+        adjacency[2 * var + 1].add(2 * var)
+    for ci, clause in enumerate(clauses):
+        node = 2 * n + ci
+        labels.append("C" + str(len(clause)))
+        for lit in clause:
+            literal_node = 2 * (abs(lit) - 1) + (0 if lit > 0 else 1)
+            adjacency[node].add(literal_node)
+            adjacency[literal_node].add(node)
+
+    # A fixed number of rounds is deterministic and avoids label-name oscillation.
+    for _ in range(12):
+        next_labels = []
+        for node in range(total):
+            signature = labels[node] + "|" + "|".join(
+                sorted(labels[other] for other in adjacency[node])
+            )
+            next_labels.append(hashlib.sha256(signature.encode()).hexdigest())
+        labels = next_labels
+
+    node_profile = sorted((labels[v], len(adjacency[v])) for v in range(total))
+    edge_profile = []
+    for left in range(total):
+        for right in adjacency[left]:
+            if left < right:
+                edge_profile.append(tuple(sorted((labels[left], labels[right]))))
+    material = json.dumps(
+        {"nodes": node_profile, "edges": sorted(edge_profile)},
+        separators=(",", ":"),
+    )
+    return hashlib.sha256(material.encode()).hexdigest()
+
+
+def escalate(params):
+    """Increase the exponential dimension while keeping the planted regime stable."""
+    if not isinstance(params, dict) or "n" not in params:
+        return None
+    n = int(params["n"])
+    if n >= 512:
+        return None
+    harder = dict(params)
+    harder["n"] = max(n + 1, int(round(n * 1.5)))
+    harder["density"] = min(5.0, float(params.get("density", 4.4)) + 0.1)
+    return harder
+
+
+def _occurrence_attack(inst):
+    counts = [[0, 0] for _ in range(inst["n"])]  # negative, positive
+    for clause in inst["clauses"]:
+        for lit in clause:
+            counts[abs(lit) - 1][1 if lit > 0 else 0] += 1
+    bits = [positive > negative for negative, positive in counts]
+    return _answer_from_bits(bits)
+
+
+def _greedy_attack(inst):
+    n = inst["n"]
+    bits = [False] * n
+    frequency = Counter(abs(lit) for clause in inst["clauses"] for lit in clause)
+    for clause in inst["clauses"]:
+        if not any(_lit_value(lit, bits) for lit in clause):
+            lit = min(clause, key=lambda x: (frequency[abs(x)], abs(x)))
+            bits[abs(lit) - 1] = lit > 0
+    return _answer_from_bits(bits)
+
+
+def _random_restart_attack(inst, rng, restarts=4, flips_per_variable=8):
+    n = inst["n"]
+    clauses = inst["clauses"]
+    last = [False] * n
+    for _ in range(restarts):
+        bits = [bool(rng.getrandbits(1)) for _ in range(n)]
+        for _step in range(flips_per_variable * n):
+            unsatisfied = [
+                clause for clause in clauses
+                if not any(_lit_value(lit, bits) for lit in clause)
+            ]
+            if not unsatisfied:
+                return _answer_from_bits(bits)
+            clause = rng.choice(unsatisfied)
+            if rng.random() < 0.25:
+                chosen = rng.choice(clause)
+            else:
+                scored = []
+                for lit in clause:
+                    var = abs(lit) - 1
+                    bits[var] = not bits[var]
+                    remaining = sum(
+                        not any(_lit_value(x, bits) for x in c) for c in clauses
+                    )
+                    bits[var] = not bits[var]
+                    scored.append((remaining, rng.random(), lit))
+                chosen = min(scored)[2]
+            var = abs(chosen) - 1
+            bits[var] = not bits[var]
+        last = bits
+    return _answer_from_bits(last)
+
+
+def _transformed_instance(inst, seed, permute=False, global_flip=False, reorder=False):
+    rng = random.Random(seed)
+    n = inst["n"]
+    destinations = list(range(1, n + 1))
+    if permute:
+        rng.shuffle(destinations)
+    mapping = {old: destinations[old - 1] for old in range(1, n + 1)}
+
+    clauses = []
+    for clause in inst["clauses"]:
+        mapped = []
+        for lit in clause:
+            sign = 1 if lit > 0 else -1
+            if global_flip:
+                sign = -sign
+            mapped.append(sign * mapping[abs(lit)])
+        if reorder:
+            rng.shuffle(mapped)
+        clauses.append(mapped)
+    if reorder:
+        rng.shuffle(clauses)
+
+    old_bits = _bits_from_answer(inst["answer"], n)
+    new_bits = [False] * n
+    for old, bit in enumerate(old_bits, 1):
+        new_bits[mapping[old] - 1] = (not bit) if global_flip else bit
+    return {
+        "family": inst["family"],
+        "n": n,
+        "clauses": clauses,
+        "answer": _answer_from_bits(new_bits),
+        "density": inst.get("density"),
+        "aux_fraction": inst.get("aux_fraction"),
+    }
+
+
+def selftest():
+    """Run mandatory G1--G8 gates and return their machine-readable report."""
+    report = {"family": "Non-Monotone 2-3Sat", "shipping_difficulty": SHIPPING_DIFFICULTY}
+
+    # G1: every named preset, several independent seeds.
+    g1_total = 0
+    g1_failures = []
+    for preset, params in DIFFICULTY.items():
+        for seed in (0, 1, 17, 99):
+            inst = make_instance(seed=seed, **params)
+            ok, reason = verify(inst, inst["answer"])
+            g1_total += 1
+            if not ok:
+                g1_failures.append({"preset": preset, "seed": seed, "reason": reason})
+    report["G1_planted_verifies"] = {
+        "pass": not g1_failures,
+        "checked": g1_total,
+        "failures": g1_failures,
+    }
+
+    shipping = DIFFICULTY[SHIPPING_DIFFICULTY]
+    inst = make_instance(seed=123456, **shipping)
+    planted = list(inst["answer"])
+
+    # G2: five structurally different corruptions and five distinct diagnostics.
+    duplicate = list(planted)
+    duplicate[1] = (1 if planted[0] > 0 else -1) * 1
+    swapped = list(planted)
+    swapped[0], swapped[-1] = swapped[-1], swapped[0]
+    out_of_range = list(planted)
+    out_of_range[-1] = inst["n"] + 1
+    corruptions = {
+        "drop_one": planted[:-1],
+        "swap_two": swapped,
+        "duplicate": duplicate,
+        "empty": [],
+        "out_of_range": out_of_range,
+    }
+    reasons = {}
+    g2_ok = True
+    for name, candidate in corruptions.items():
+        ok, reason = verify(inst, candidate)
+        g2_ok = g2_ok and not ok
