+
+def _occurrence_attack(inst):
+    counts = [[0, 0] for _ in range(inst["n"])]  # negative, positive
+    for clause in inst["clauses"]:
+        for lit in clause:
+            counts[abs(lit) - 1][1 if lit > 0 else 0] += 1
