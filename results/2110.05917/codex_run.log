+    report["G2_rejects_corruption"] = {
+        "pass": g2_ok,
+        "rejected": sum(verify(inst, value)[0] is False for value in corruptions.values()),
+        "distinct_reasons": len(set(reasons.values())),
+        "reasons": reasons,
+    }
