+    new_ids = list(range(1, n + 1))
+    rng.shuffle(new_ids)
+    old_to_new = {old + 1: new_ids[old] for old in range(n)}
+    clauses = []
+    for clause in final_clauses:
+        mapped = [(1 if lit > 0 else -1) * old_to_new[abs(lit)] for lit in clause]
+        rng.shuffle(mapped)
+        clauses.append(mapped)
+    rng.shuffle(clauses)
+
+    final_bits = [False] * n
+    for old, bit in enumerate(planted_bits, 1):
+        final_bits[old_to_new[old] - 1] = bit
