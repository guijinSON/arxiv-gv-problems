+        p0_with_11 = rng.randint(low, high)
+        p1_with_00 = c - edge_count + p0_with_11
+
+        for _pairing_try in range(2000):
+            rng.shuffle(p0)
+            rng.shuffle(p1)
+            rng.shuffle(f0)
+            rng.shuffle(f1)
