+    restart_ok = False
+    rng = random.Random(seed ^ 0x221112813)
+    for _ in range(64):
+        order = list(range(count))
+        rng.shuffle(order)
+        candidate = _greedy_candidate(inst, order)
+        if candidate is not None and verify(inst, candidate)[0]:
+            restart_ok = True
+            break
