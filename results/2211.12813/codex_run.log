+def _relabel_instance(inst: dict, perm: list[int], reverse_edges: bool = False) -> dict:
+    out = {key: value for key, value in inst.items() if key not in ("edges", "answer")}
+    edges = [[perm[v] for v in edge] for edge in inst["edges"]]
+    if reverse_edges:
