+    # Select twenty genuinely different structural seeds, then apply vertex,
+    # edge, within-edge, and composed presentation symmetries to every one.
+    selected = []
+    distinct = {}
+    for preset_index, preset_params in enumerate(DIFFICULTY.values()):
