+            size_sums[vertex] += len(edge)
+    ordered = sorted(range(count), key=lambda v: (-incidences[v], -size_sums[v], v))
+    outlier = [0] * count
+    for rank, vertex in enumerate(ordered):
+        outlier[vertex] = rank % (bound + 1)
