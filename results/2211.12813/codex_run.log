+    corruptions: dict[str, object] = {
+        "drop_one": answer[:-1],
+        "swap_two": swapped if swapped is not None else list(reversed(answer)),
+        "duplicate": answer + [answer[-1]],
+        "empty": [],
+        "out_of_range": [inst["max_color"] + 1] + answer[1:],
+    }
+    rejection_rows = {}
+    reasons = set()
