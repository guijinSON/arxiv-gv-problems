+_ESCALATION_LEVELS = [
+    (11, 20, 23),
+    (13, 18, 19),
+    (17, 14, 15),
+    (19, 12, 13),
+    (23, 10, 11),
+    (29, 8, 8),
+    (31, 8, 8),
+    (37, 6, 6),
+    (41, 6, 6),
+]
