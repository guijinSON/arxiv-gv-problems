+        blob = json.dumps(size_inst["answer"], separators=(",", ":"))
+        n0, c0, _m0, r0 = _recover_parameters(size_inst)
+        sizes.append((len(blob), (len(blob) + 3) // 4, _answer_atoms(size_inst["answer"])))
+        route_operations.append(2 * n0 * r0)
