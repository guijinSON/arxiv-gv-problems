+        + PROBLEM_PROFILE["intuition_description"]
+    ),
+    "reduction": PROBLEM_PROFILE["reduction"],
+}
+
+DIFFICULTY: dict = {
+    "demo": {"n": 3, "min_star_size": 6, "max_star_size": 6},
+    "easy": {
+        "n": 11, "min_star_size": 20, "max_star_size": 23,
