+    star_edges = [edge for edge in edges if len(edge) != n]
+    if not star_edges or len(star_edges) % n:
+        raise ValueError("malformed product edge count")
+    r = len(star_edges[0])
+    if any(len(edge) != r for edge in star_edges):
+        raise ValueError("star-factor edges are not uniform")
+    m = len(star_edges) // n
+    incidence = [0] * vertex_count
+    for edge in star_edges:
+        for vertex in edge:
+            incidence[vertex] += 1
+            counter["operations"] += 1
+    center_vertices = sum(value == m for value in incidence)
+    if center_vertices % n:
+        raise ValueError("central incidence count is not a whole row count")
+    c = center_vertices // n
+    if c < 2 or m < 2 or r <= c:
+        raise ValueError("parameters are outside the constructed regime")
+    return n, c, m, r
+
+
+def canonical_key(inst: dict) -> str:
+    """Hash the recovered complete isomorphism invariant, never seed or render."""
+    params = _recover_parameters(inst)
+    payload = json.dumps(params, separators=(",", ":"))
+    return hashlib.sha256(payload.encode("ascii")).hexdigest()
