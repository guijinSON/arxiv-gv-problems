+def selftest() -> dict:
+    """Run all mandatory gates and return measured, machine-readable evidence."""
+    report: dict[str, object] = {}
+
+    failures = []
+    checks = 0
+    for preset, kwargs in DIFFICULTY.items():
+        for seed in (0, 1, 19):
