+    "easy": {
+        "n": 11, "min_star_size": 20, "max_star_size": 23,
+        "max_rank": 13, "min_petals": 7,
+    },
+    "medium": {
+        "n": 13, "min_star_size": 18, "max_star_size": 19,
+        "max_rank": 11, "min_petals": 7,
