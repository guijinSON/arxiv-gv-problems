+# Filled after the script-owned oracle runs.  Pending evidence deliberately
+# keeps G9 from passing until real transcripts exist.
+G9_ORACLE_RESULTS = {
+    "bare": {"solved": 0, "attempts": 0},
+    "hinted": {"solved": 0, "attempts": 0},
+    "placebo": {"solved": 0, "attempts": 0},
