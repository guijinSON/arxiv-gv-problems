+        "duplicate": answer + [answer[-1]],
+        "empty": [],
+        "out_of_range": [inst["max_color"] + 1] + answer[1:],
+    }
+    rejection_rows = {}
+    reasons = set()
+    for name, candidate in corruptions.items():
