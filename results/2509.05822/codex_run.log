+            "row_xors": row_xors,
+            "bit_operations": row_xors * (dimension + 1),
+            "pivot_tests": pivot_tests,
+        }
+    for row in rows[rank:]:
+        if (row & ((1 << dimension) - 1)) == 0 and ((row >> dimension) & 1):
