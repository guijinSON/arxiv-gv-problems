\begin{theorem}
Let $k\in \Z$ and $n, i,j \in \Z^+$ with $n\geq 2$ and $k\not\equiv 0\mod n$. For the complete bipartite graph,
$$
\chi_{(n,k)}(K_{i,j}) =
\begin{cases}
2, &\text{if } (i,n) \mid k \text{ and } (j,n) \mid k, \\
3, &\text{if } (i,n) \mid k \text{ or } (j,n) \mid k, \text{ but not both}, \\
4, &\text{otherwise.}
\end{cases}
$$
\end{theorem}
