+
+STRUCTURAL_HINT = (
+    "The generator-incidence matrix has a four-factor Kronecker symmetry in "
+    "the four-character coordinate names."
+)
+PLACEBO_HINT = (
+    "The generator-incidence data rewards careful attention to the coordinate "
