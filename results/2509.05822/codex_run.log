%-----%-----%-----%
%-----%-----%-----%
%-----%-----%-----%
\section{Examples for $\chi_{(n)}(G)$} \label{sec:8}
%-----%-----%-----%
%-----%-----%-----%
%-----%-----%-----%
%-----%-----%-----%

In the following, we evaluate $\chi_{(n)}(G)$ for a few special graph families. See Section \ref{sec:4} for the corresponding results on~$\chi_{n}(G)$.

\begin{theorem}
    Let $n,m\in\Z^+$ with $n,m\geq 2$. For the complete graph,
    $$\chi_{(n)}(K_m) =
    \begin{cases}
        m, &\text{if } n > 2 \text{ or } n=2 \text{ with } 2\mid m, \\
        \text{does not exist}, &\text{otherwise}.
    \end{cases}
    $$
\end{theorem}

\begin{proof}
    For $n>2$, labeling the vertices of $K_m$ with $1$, $n+1$, and $n, 2n, \dots, (m-2)n$ gives an open coloring with nonzero remainders $\mod n$. For $n=2$, the open colorings with nonzero remainders $\mod 2$ are identical to the open colorings with remainder $1\mod 2$. Thus, we have $\chi_{(2)}(K_m) = \chi_{(2,1)}(K_m)$, and Theorem \ref{Complete Graphs - Open Neighborhoods} applies.
