\begin{theorem}
Let $n,i,j \in \Z^+$ with $n\geq 2$. For the complete bipartite graph,
\[
\chi_{(n)}(K_{i,j}) =
\begin{cases}
2, &\text{if } n \nmid i \text{ and } n \nmid j, \\
3, &\text{if } n \nmid i \text{ or } n \nmid j, \text{ but not both}, \\
4, &\text{otherwise}.
\end{cases}
\]
\end{theorem}
\begin{proof}
    Let $V_1$ and $V_2$ with $|V_1|=i$ and $|V_2|=j$ denote the vertex sets belonging to the two parts of $K_{i,j}$. By labeling a single vertex from $V_1$ and a single vertex from $V_2$ with $1$ and the rest with $0$, Theorem \ref{thm: open nonzero remainder mod n existence criteria and upper bound by n chi} shows that $2 \leq \chi_{(n)}(K_{i,j}) \leq 4$.
