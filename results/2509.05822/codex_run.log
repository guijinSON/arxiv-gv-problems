+
+
+def random_candidate(inst, rng):
+    decoded = _decode_instance(inst)
+    if decoded is None or not hasattr(rng, "sample"):
+        return []
+    coordinates = decoded[3]
+    return sorted(rng.sample(coordinates, _SUPPORT_SIZE))
+
+
+def search_space(inst):
+    decoded = _decode_instance(inst)
+    if decoded is None:
+        return None
