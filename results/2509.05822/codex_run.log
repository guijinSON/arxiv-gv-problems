We turn now to the generalized Petersen graph $G(m,j)$. We will use the same notation as for Theorem \ref{thm: chi n gen petersen}.
%write its vertex set as $\{ v_i, u_i | 1 \leq i \leq m \}$ with the subscripts viewed as elements of $\Z_m$ when convenient. The edges will be all $v_i v_{i+1}$, $u_i, u_{i+j}$, and $v_i u_i$. The $\{v_i\}$ may be referred to as the outside vertices and the $\{u_i\}$ as the inside vertices.

\begin{theorem} \label{thm: gen pet n k}
    Let $k \in \Z$ and $n,m,j\in\Z^+$ with $n\geq 2$, $k\not\equiv 0 \mod n$, $m\geq 3$, and $1\leq j < \frac{m}{2}$. Then the following holds:
    \begin{itemize}
    \item If $(3,n)\mid k$, then
        $\chi_{(n,k)}(G(m,j)) = \chi(G(m,j))$.

    \item If $(3,n) \nmid (km)$, then $\chi_{(n,k)}(G(m,j))$ does not exist.

    \item If $(3,n)\nmid k$, $(3,n) \mid (km)$, and $3 \nmid j$, then $\chi_{(n,k)}(G(m,j))$ exists and
    \[  \chi(G(m,j)) \leq \chi_{(n,k)}(G(m,j)) \leq 2 \chi(G(m,j)). \]
    \end{itemize}
\end{theorem}

\begin{proof}
    The cases of $(3,n)\mid k$ and $(3,n) \nmid (km) \iff (3,n) \nmid (2km)$ are handled by Theorem \ref{thm: regular chi k n}. Therefore assume $(3,n)\nmid k$ and $(3,n) \mid (km)$, which is equivalent to $3\mid n$, $3\nmid k$, and $3\mid m$.

    If $3\nmid j$, labeling $v_i, u_i$ with $k$ for $3\mid i$ and with $0$ otherwise gives an open $2$-coloring with remainder $k\mod n$ of $G(m,j)$. By Theorem \ref{thm: remainder k mod n existence criteria and upper bound by n chi},
    \[ \chi(G(m,j)) \leq \chi_{(n,k)}(G(m,j)) \leq 2\chi(G(m,j)).\qedhere \]
    % When $3 | j$,
    % suppose $\ell$ is an open labeling with remainder $k\mod n$.
    % The open remainder $k\mod n$ equations are
    % \[ k \equiv \ell(v_{i-1})+ \ell(v_{i+1})+ \ell(u_i) \equiv \ell(v_i) + \ell(u_{i-j})+ \ell(u_{u+j}).\]
    % Let $V^j=\sum_{i\in\Z_m, \, 3|(i-j)} \ell(v_i)$ and $U^j=\sum_{i\in\Z_m, \, 3|(i-j)} \ell(u_i)$.
    % Summing each of the two above equations over $i$ with $3|(i-j)$ with $j\in\{0,1,2\}$, we get
    % \[ \frac{mk}{3} \equiv V^{j-1} + V^{j+1} + U^j \equiv V^j + 2 U^j.\]
    % Summing each of these over $j$ gives
    % \[ mk \equiv 2\sum_j V^j + \sum_j U^j \equiv \sum_j V^j + 2\sum_j U^j.\]
    % Looking at the difference forces $\sum_j V^j \equiv \sum_j U^j$. Plugging back in then requires
    % \[ mk \equiv 3\sum_j V^j.\]
    % Ugh... which is doable as $3|m$.
\end{proof}

\begin{remark}
Theorem \ref{thm: gen pet n k} still leaves open the case $3\mid n$, $3\nmid k$, $3\mid m$, and $3\mid j$. In this case, a more detailed analysis shows that a proper open coloring with remainder $k\mod n$  of $G(m,j)$ also exists if either $9\mid m$ or $9\nmid m$ and $9\nmid n$. However, general results remain unknown.
\end{remark}

